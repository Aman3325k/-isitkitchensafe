# Cloudflare Pages Cache Rules

# Never cache HTML pages (always fresh content)
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Cache Astro compiled JS and CSS assets for 1 year (hashed filenames)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Cache legacy JS and CSS for 1 year
/assets/*.js
  Cache-Control: public, max-age=31536000, immutable

/assets/*.css
  Cache-Control: public, max-age=31536000, immutable

# Cache fonts for 1 year
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Cache images for 1 month
/*.png
  Cache-Control: public, max-age=2592000

/*.jpg
  Cache-Control: public, max-age=2592000

/*.jpeg
  Cache-Control: public, max-age=2592000

/*.webp
  Cache-Control: public, max-age=2592000

/*.svg
  Cache-Control: public, max-age=2592000

/*.ico
  Cache-Control: public, max-age=2592000

# Cache sitemap for 1 day
/sitemap*.xml
  Cache-Control: public, max-age=86400

# Cache robots.txt for 1 day
/robots.txt
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400

# AdSense Authorized Digital Sellers
/ads.txt
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=0, must-revalidate

# Cache search index files for 1 day with stale-while-revalidate
/*search-index.json
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Security headers on all pages
# (X-Frame-Options is intentionally replaced by CSP frame-ancestors to allow Google AdSense preview/review while preventing third-party clickjacking)
/*
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
