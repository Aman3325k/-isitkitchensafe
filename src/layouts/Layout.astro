    <!-- Client-side navigation toggle and global search index load -->
    <script is:inline data-cfasync="false">
      function initMobileMenu() {
        const toggleBtn = document.getElementById('mobile-menu-toggle');
        const closeBtn = document.getElementById('mobile-menu-close');
        const mobileMenu = document.getElementById('mobile-menu');

        if (!toggleBtn || !mobileMenu) return;
        if (toggleBtn.dataset.bound === 'true') return;
        toggleBtn.dataset.bound = 'true';

        let isTransitioning = false;

        const openMenu = () => {
          if (isTransitioning) return;
          isTransitioning = true;
          mobileMenu.classList.remove('hidden');
          requestAnimationFrame(() => {
            mobileMenu.classList.remove('translate-x-full');
          });
          toggleBtn.setAttribute('aria-expanded', 'true');
          mobileMenu.setAttribute('aria-hidden', 'false');
          document.body.classList.add('overflow-hidden');
          if (closeBtn) closeBtn.focus();
          setTimeout(() => {
            isTransitioning = false;
          }, 310);
        };

        const closeMenu = () => {
          if (isTransitioning) return;
          isTransitioning = true;
          mobileMenu.classList.add('translate-x-full');
          toggleBtn.setAttribute('aria-expanded', 'false');
          mobileMenu.setAttribute('aria-hidden', 'true');
          document.body.classList.remove('overflow-hidden');
          toggleBtn.focus();
          setTimeout(() => {
            if (mobileMenu.classList.contains('translate-x-full')) {
              mobileMenu.classList.add('hidden');
            }
            isTransitioning = false;
          }, 310);
        };

        toggleBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          openMenu();
        });

        if (closeBtn) {
          closeBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            closeMenu();
          });
        }

        mobileMenu.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            closeMenu();
            return;
          }

          if (e.key === 'Tab') {
            const focusableElements = mobileMenu.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
            if (focusableElements.length === 0) return;

            const firstElement = focusableElements[0];
            const lastElement = focusableElements[focusableElements.length - 1];

            if (e.shiftKey) {
              if (document.activeElement === firstElement) {
                lastElement.focus();
                e.preventDefault();
              }
            } else {
              if (document.activeElement === lastElement) {
                firstElement.focus();
                e.preventDefault();
              }
            }
          }
        });
      }

      function initThemeToggle() {
        const themeToggleBtn = document.getElementById('theme-toggle');
        const themeToggleDarkIcon = document.getElementById('theme-toggle-dark-icon');
        const themeToggleLightIcon = document.getElementById('theme-toggle-light-icon');

        if (!themeToggleBtn) return;
        if (themeToggleBtn.dataset.bound === 'true') return;
        themeToggleBtn.dataset.bound = 'true';

        const updateIcons = () => {
          if (document.documentElement.classList.contains('dark')) {
            themeToggleDarkIcon?.classList.add('hidden');
            themeToggleLightIcon?.classList.remove('hidden');
          } else {
            themeToggleDarkIcon?.classList.remove('hidden');
            themeToggleLightIcon?.classList.add('hidden');
          }
        };

        updateIcons();

        themeToggleBtn.addEventListener('click', () => {
          if (document.documentElement.classList.contains('dark')) {
            document.documentElement.classList.remove('dark');
            localStorage.setItem('theme', 'light');
          } else {
            document.documentElement.classList.add('dark');
            localStorage.setItem('theme', 'dark');
          }
          updateIcons();
        });
      }

      function initGlobalSearch() {
        const searchForm = document.getElementById('global-search-form');
        const searchInput = document.getElementById('global-search-input');
        const dropdown = document.getElementById('global-search-dropdown');
        const searchLoading = document.getElementById('global-search-loading');

        if (!searchForm || !searchInput) return;
        if (searchForm.dataset.bound === 'true') return;
        searchForm.dataset.bound = 'true';

        const searchPath = searchForm.dataset.searchPath || '/search-index.json';
        const searchLang = searchForm.dataset.lang || 'en';
        let searchIndex = null;
        let isFetching = false;
        let activeIndex = -1;
        let currentMatches = [];

        // Responsive search placeholder for small mobile viewports
        const updateSearchPlaceholder = () => {
          if (searchInput.dataset.placeholderMobile && searchInput.dataset.placeholderDesktop) {
            searchInput.placeholder = window.innerWidth < 640 ? searchInput.dataset.placeholderMobile : searchInput.dataset.placeholderDesktop;
          }
        };
        updateSearchPlaceholder();
        window.addEventListener('resize', updateSearchPlaceholder, { passive: true });

        const closeDropdown = () => {
          if (!dropdown) return;
          dropdown.classList.add('hidden');
          dropdown.innerHTML = '';
          searchInput.setAttribute('aria-expanded', 'false');
          searchInput.removeAttribute('aria-activedescendant');
          activeIndex = -1;
          currentMatches = [];
        };

        const renderDropdown = (matches) => {
          currentMatches = matches;
          activeIndex = -1;
          if (!dropdown) return;
          if (!matches || matches.length === 0) {
            closeDropdown();
            return;
          }
          dropdown.innerHTML = matches.map((entry, idx) => `
            <div 
              role="option" 
              id="search-opt-${idx}" 
              data-index="${idx}" 
              data-url="${entry.url}" 
              aria-selected="false" 
              class="search-option px-3 py-2 text-[13px] text-ink hover:bg-surface-soft cursor-pointer flex items-center justify-between transition-colors"
            >
              <span class="font-medium text-ink truncate">${entry.name}</span>
              <span class="text-[11px] text-muted ml-2 shrink-0 capitalize">${entry.category}</span>
            </div>
          `).join('');
          dropdown.classList.remove('hidden');
          searchInput.setAttribute('aria-expanded', 'true');
        };

        const updateActiveOption = (newIndex) => {
          if (!dropdown) return;
          const options = dropdown.querySelectorAll('.search-option');
          if (options.length === 0) return;
          if (activeIndex >= 0 && options[activeIndex]) {
            options[activeIndex].classList.remove('bg-surface-soft');
            options[activeIndex].setAttribute('aria-selected', 'false');
          }
          activeIndex = newIndex;
          if (activeIndex >= 0 && options[activeIndex]) {
            options[activeIndex].classList.add('bg-surface-soft');
            options[activeIndex].setAttribute('aria-selected', 'true');
            searchInput.setAttribute('aria-activedescendant', options[activeIndex].id);
            options[activeIndex].scrollIntoView({ block: 'nearest' });
          } else {
            searchInput.removeAttribute('aria-activedescendant');
          }
        };

        const loadSearchIndex = async () => {
          if (searchIndex || isFetching) return;
          isFetching = true;
          if (searchLoading) searchLoading.classList.remove('hidden');
          try {
            const response = await fetch(searchPath);
            if (response.ok) {
              searchIndex = await response.json();
              const q = searchInput.value.trim().toLowerCase();
              if (q) {
                const matches = searchIndex.filter(entry => {
                  const name = entry.name.toLowerCase();
                  const cat = (entry.category || '').toLowerCase();
                  return name.includes(q) || cat.includes(q);
                }).slice(0, 8);
                renderDropdown(matches);
              }
            }
          } catch (e) {
            // Silently fail to maintain UX
          } finally {
            isFetching = false;
            if (searchLoading) searchLoading.classList.add('hidden');
          }
        };

        searchInput.addEventListener('focus', loadSearchIndex);
        searchInput.addEventListener('input', () => {
          loadSearchIndex();
          const searchError = document.getElementById('global-search-error');
          if (searchError) searchError.classList.add('hidden');

          const query = searchInput.value.trim().toLowerCase();
          if (!query || !searchIndex) {
            closeDropdown();
            return;
          }

          const matches = searchIndex.filter(entry => {
            const name = entry.name.toLowerCase();
            const cat = (entry.category || '').toLowerCase();
            return name.includes(query) || cat.includes(query);
          }).slice(0, 8);

          renderDropdown(matches);
        });

        searchInput.addEventListener('keydown', (e) => {
          if (!dropdown || dropdown.classList.contains('hidden') || currentMatches.length === 0) {
            return;
          }
          if (e.key === 'ArrowDown') {
            e.preventDefault();
            const nextIndex = (activeIndex + 1) % currentMatches.length;
            updateActiveOption(nextIndex);
          } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            const prevIndex = activeIndex <= 0 ? currentMatches.length - 1 : activeIndex - 1;
            updateActiveOption(prevIndex);
          } else if (e.key === 'Enter') {
            if (activeIndex >= 0 && currentMatches[activeIndex]) {
              e.preventDefault();
              closeDropdown();
              window.location.href = currentMatches[activeIndex].url;
            }
          } else if (e.key === 'Escape') {
            closeDropdown();
          }
        });

        if (dropdown) {
          dropdown.addEventListener('click', (e) => {
            const opt = e.target.closest('.search-option');
            if (opt && opt.dataset.url) {
              closeDropdown();
              window.location.href = opt.dataset.url;
            }
          });
        }

        document.addEventListener('click', (e) => {
          if (!searchForm.contains(e.target)) {
            closeDropdown();
          }
        });

        searchForm.addEventListener('submit', (e) => {
          e.preventDefault();
          const rawValue = searchInput.value.trim().toLowerCase();
          if (!rawValue || !searchIndex) return;

          let match = searchIndex.find(item => item.name.toLowerCase() === rawValue);

          if (!match) {
            match = searchIndex.find(item => {
              const displayVal = `${item.name} (${item.category})`.toLowerCase();
              return displayVal === rawValue;
            });
          }

          if (!match) {
            match = searchIndex.find(item => item.name.toLowerCase().includes(rawValue));
          }

          if (!match) {
            const categoryMapEn = {
              'dishwasher': '/dishwasher/',
              'microwave': '/microwave/',
              'freezer': '/freezer/',
              'oven': '/oven/',
              'dryer': '/dryer/',
              'air fryer': '/airfryer/',
              'airfryer': '/airfryer/',
              'refrigerator': '/refrigerator/',
              'fridge': '/refrigerator/',
              'shelf life': '/how-long/',
              'how long': '/how-long/',
              'washing machine': '/washing-machine/',
              'refreeze': '/refreeze/',
              'what happens': '/what-happens/',
              'compare': '/compare/',
              'comparison': '/compare/',
              'comparisons': '/compare/'
            };

            const categoryMapEs = {
              'lavavajillas': '/es/dishwasher/',
              'lavaplatos': '/es/dishwasher/',
              'dishwasher': '/es/dishwasher/',
              'microondas': '/es/microwave/',
              'microwave': '/es/microwave/'
            };

            const categoryMapPt = {
              'lava-louças': '/pt/dishwasher/',
              'lava louças': '/pt/dishwasher/',
              'lavaloucas': '/pt/dishwasher/',
              'dishwasher': '/pt/dishwasher/',
              'micro-ondas': '/pt/microwave/',
              'microondas': '/pt/microwave/',
              'micro ondas': '/pt/microwave/',
              'microwave': '/pt/microwave/'
            };

            const categoryMaps = {
              en: categoryMapEn,
              es: categoryMapEs,
              pt: categoryMapPt
            };

            const activeCategoryMap = categoryMaps[searchLang] || categoryMapEn;
            if (activeCategoryMap[rawValue]) {
              window.location.href = activeCategoryMap[rawValue];
              return;
            }
          }

          if (match) {
            const searchError = document.getElementById('global-search-error');
            if (searchError) searchError.classList.add('hidden');
            window.location.href = match.url;
          } else {
            const searchError = document.getElementById('global-search-error');
            if (searchError) {
              searchError.textContent = `No match found for "${searchInput.value}". Please use suggestions or check spelling.`;
              searchError.classList.remove('hidden');
            }
          }
        });
      }

      function setupLanguagePickers() {
        const containers = document.querySelectorAll('[data-language-picker]');

        containers.forEach((container) => {
          if (container.dataset.bound === 'true') return;
          container.dataset.bound = 'true';

          const btn = container.querySelector('[data-picker-button]');
          const menu = container.querySelector('[data-picker-dropdown]');
          const arrow = container.querySelector('[data-picker-arrow]');

          if (!btn || !menu) return;

          const toggleDropdown = (open) => {
            const isExpanded = btn.getAttribute('aria-expanded') === 'true';
            const shouldOpen = open !== undefined ? open : !isExpanded;
            btn.setAttribute('aria-expanded', String(shouldOpen));
            if (shouldOpen) {
              menu.classList.remove('hidden');
              if (arrow) arrow.classList.add('rotate-180');
            } else {
              menu.classList.add('hidden');
              if (arrow) arrow.classList.remove('rotate-180');
            }
          };

          let lastTouchTime = 0;
          const handleToggle = (e) => {
            if (e.type === 'touchstart') {
              lastTouchTime = Date.now();
            } else if (e.type === 'click' && Date.now() - lastTouchTime < 500) {
              e.stopPropagation();
              return;
            }
            e.stopPropagation();
            containers.forEach((other) => {
              if (other !== container) {
                const otherBtn = other.querySelector('[data-picker-button]');
                const otherMenu = other.querySelector('[data-picker-dropdown]');
                const otherArrow = other.querySelector('[data-picker-arrow]');
                if (otherBtn) otherBtn.setAttribute('aria-expanded', 'false');
                if (otherMenu) otherMenu.classList.add('hidden');
                if (otherArrow) otherArrow.classList.remove('rotate-180');
              }
            });
            toggleDropdown();
          };

          btn.addEventListener('click', handleToggle);
          btn.addEventListener('touchstart', handleToggle, { passive: true });

          document.addEventListener('click', (e) => {
            if (!container.contains(e.target)) {
              toggleDropdown(false);
            }
          });

          document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
              toggleDropdown(false);
            }
          });
        });
      }

      function initBackToTop() {
        const container = document.getElementById('back-to-top-container');
        const btn = document.getElementById('back-to-top-btn');
        const progressCircle = document.getElementById('back-to-top-progress');
        if (!container || !btn || !progressCircle) return;

        const circumference = 2 * Math.PI * 20; // 125.66
        progressCircle.style.strokeDasharray = `${circumference}`;

        function onScroll() {
          const scrollTop = window.scrollY || document.documentElement.scrollTop;
          const scrollHeight = document.documentElement.scrollHeight - window.innerHeight;

          if (scrollTop > 300) {
            container.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-3');
            container.classList.add('opacity-100', 'translate-y-0');
          } else {
            container.classList.add('opacity-0', 'pointer-events-none', 'translate-y-3');
            container.classList.remove('opacity-100', 'translate-y-0');
          }

          if (scrollHeight > 0) {
            const progress = Math.min(1, Math.max(0, scrollTop / scrollHeight));
            const offset = circumference - progress * circumference;
            progressCircle.style.strokeDashoffset = `${offset}`;
          }
        }

        window.addEventListener('scroll', onScroll, { passive: true });
        btn.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
        onScroll();
      }

      function initQuickSearchModal() {
        const modal = document.getElementById('quick-search-modal');
        const panel = document.getElementById('quick-search-panel');
        const trigger = document.getElementById('quick-search-trigger');
        const kbdHint = document.getElementById('quick-search-kbd');
        const input = document.getElementById('quick-search-input');
        const clearBtn = document.getElementById('quick-search-clear');
        const closeBtn = document.getElementById('quick-search-close');
        const loadingEl = document.getElementById('quick-search-loading');
        const defaultView = document.getElementById('quick-search-default');
        const resultsEl = document.getElementById('quick-search-results');
        const statusEl = document.getElementById('quick-search-status');

        if (!modal || !input || !resultsEl) return;

        if (kbdHint && /Mac|iPhone|iPad|iPod/i.test(navigator.platform || navigator.userAgent || '')) {
          kbdHint.textContent = '⌘K';
        }

        if (modal.dataset.bound === 'true') return;
        modal.dataset.bound = 'true';

        const searchPath = modal.dataset.searchPath || '/search-index.json';
        window.__iksQuickSearchCache = window.__iksQuickSearchCache || {};
        let isFetching = false;
        let activeIdx = -1;
        let currentItems = [];
        let lastFocused = null;

        const escapeHtml = (str) => String(str || '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');

        const getCachedIndex = () => window.__iksQuickSearchCache[searchPath] || null;

        const ensureIndexLoaded = async () => {
          if (getCachedIndex() || isFetching) return;
          isFetching = true;
          if (loadingEl) loadingEl.classList.remove('hidden');
          if (statusEl) statusEl.textContent = 'Loading safety index...';
          try {
            let res = await fetch(searchPath);
            if (!res.ok && searchPath !== '/search-index.json') {
              res = await fetch('/search-index.json');
            }
            if (res.ok) {
              const data = await res.json();
              window.__iksQuickSearchCache[searchPath] = Array.isArray(data) ? data : [];
              if (statusEl) {
                statusEl.textContent = `${window.__iksQuickSearchCache[searchPath].length.toLocaleString()} guides indexed`;
              }
              if (input.value.trim()) {
                runFilter(input.value);
              }
            } else if (statusEl) {
              statusEl.textContent = 'Search index unavailable';
            }
          } catch (_) {
            if (statusEl) statusEl.textContent = 'Unable to load search index';
          } finally {
            isFetching = false;
            if (loadingEl) loadingEl.classList.add('hidden');
          }
        };

        const setActive = (nextIdx) => {
          const rows = resultsEl.querySelectorAll('[data-qs-item]');
          if (!rows.length) {
            activeIdx = -1;
            return;
          }
          if (activeIdx >= 0 && rows[activeIdx]) {
            rows[activeIdx].classList.remove('bg-surface-soft');
            rows[activeIdx].setAttribute('aria-selected', 'false');
          }
          activeIdx = nextIdx;
          if (activeIdx >= 0 && rows[activeIdx]) {
            rows[activeIdx].classList.add('bg-surface-soft');
            rows[activeIdx].setAttribute('aria-selected', 'true');
            rows[activeIdx].scrollIntoView({ block: 'nearest' });
          }
        };

        const runFilter = (rawQuery) => {
          const q = (rawQuery || '').trim().toLowerCase();
          if (clearBtn) {
            clearBtn.classList.toggle('hidden', !q);
          }

          if (!q) {
            currentItems = [];
            activeIdx = -1;
            resultsEl.innerHTML = '';
            resultsEl.classList.add('hidden');
            if (defaultView) defaultView.classList.remove('hidden');
            const cached = getCachedIndex();
            if (statusEl) {
              statusEl.textContent = cached ? `${cached.length.toLocaleString()} guides indexed` : 'Press / or Ctrl+K anywhere';
            }
            return;
          }

          if (defaultView) defaultView.classList.add('hidden');
          resultsEl.classList.remove('hidden');

          const index = getCachedIndex();
          if (!index) {
            resultsEl.innerHTML = '<div class="px-4 py-8 text-center text-[13px] text-muted">Loading safety guides...</div>';
            ensureIndexLoaded();
            return;
          }

          const tokens = q.split(/\s+/).filter(Boolean);
          const scored = [];
          for (let i = 0; i < index.length; i++) {
            const entry = index[i];
            const nameLower = (entry.name || '').toLowerCase();
            const catLower = (entry.category || '').toLowerCase();
            const kwLower = (entry.keywords || '').toLowerCase();
            const haystack = `${nameLower} ${catLower} ${kwLower}`;

            let matched = true;
            for (let tIdx = 0; tIdx < tokens.length; tIdx++) {
              if (!haystack.includes(tokens[tIdx])) {
                matched = false;
                break;
              }
            }
            if (!matched) continue;

            let score = 1;
            if (nameLower === q) score = 100;
            else if (nameLower.startsWith(q)) score = 50;
            else if (nameLower.includes(q)) score = 25;
            else if (catLower.includes(q)) score = 10;

            scored.push({ entry, score });
          }

          scored.sort((a, b) => b.score - a.score || a.entry.name.length - b.entry.name.length);
          currentItems = scored.slice(0, 12).map((s) => s.entry);
          activeIdx = -1;

          if (statusEl) {
            statusEl.textContent = scored.length === 1 ? '1 match' : `${scored.length.toLocaleString()} matches`;
          }

          if (currentItems.length === 0) {
            resultsEl.innerHTML = `<div class="px-4 py-8 text-center text-[13px] text-muted">No safety guides matched &ldquo;${escapeHtml(rawQuery.trim())}&rdquo;. Try an item or appliance name.</div>`;
            return;
          }

          resultsEl.innerHTML = currentItems.map((item, idx) => `
            <a
              href="${escapeHtml(item.url)}"
              role="option"
              data-qs-item="${idx}"
              aria-selected="false"
              class="px-4 py-3 flex items-center justify-between gap-3 hover:bg-surface-soft focus:bg-surface-soft focus:outline-none transition-colors"
            >
              <div class="min-w-0 flex-1">
                <div class="text-[14px] font-medium text-ink truncate">${escapeHtml(item.name)}</div>
                <div class="text-[11px] text-muted truncate">${escapeHtml(item.url)}</div>
              </div>
              <div class="flex items-center gap-2 shrink-0">
                <span class="px-2 py-0.5 text-[11px] font-medium text-muted bg-surface-soft border border-hairline rounded capitalize">${escapeHtml(item.category || 'Guide')}</span>
                <svg class="w-4 h-4 text-muted" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </a>
          `).join('');
          setActive(0);
        };

        const openModal = () => {
          if (!modal.classList.contains('hidden')) return;
          lastFocused = document.activeElement;
          modal.classList.remove('hidden');
          modal.classList.add('flex');
          modal.setAttribute('aria-hidden', 'false');
          document.body.classList.add('overflow-hidden');
          ensureIndexLoaded();
          requestAnimationFrame(() => {
            input.focus();
            input.select();
          });
        };

        const closeModal = () => {
          if (modal.classList.contains('hidden')) return;
          modal.classList.add('hidden');
          modal.classList.remove('flex');
          modal.setAttribute('aria-hidden', 'true');
          document.body.classList.remove('overflow-hidden');
          if (lastFocused && typeof lastFocused.focus === 'function') {
            lastFocused.focus();
          }
        };

        if (trigger && trigger.dataset.bound !== 'true') {
          trigger.dataset.bound = 'true';
          trigger.addEventListener('click', (e) => {
            e.preventDefault();
            openModal();
          });
        }

        if (closeBtn) {
          closeBtn.addEventListener('click', closeModal);
        }

        if (clearBtn) {
          clearBtn.addEventListener('click', () => {
            input.value = '';
            runFilter('');
            input.focus();
          });
        }

        modal.addEventListener('click', (e) => {
          if (panel && !panel.contains(e.target)) {
            closeModal();
          }
        });

        input.addEventListener('input', () => {
          runFilter(input.value);
        });

        input.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            e.preventDefault();
            closeModal();
            return;
          }
          if (!currentItems.length) return;
          if (e.key === 'ArrowDown') {
            e.preventDefault();
            setActive((activeIdx + 1) % currentItems.length);
          } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            setActive(activeIdx <= 0 ? currentItems.length - 1 : activeIdx - 1);
          } else if (e.key === 'Enter' && activeIdx >= 0 && currentItems[activeIdx]) {
            e.preventDefault();
            const targetUrl = currentItems[activeIdx].url;
            closeModal();
            window.location.href = targetUrl;
          }
        });

        window.__iksQuickSearchControls = { openModal, closeModal, isOpen: () => !modal.classList.contains('hidden') };

        if (!window.__iksQuickSearchKeyBound) {
          window.__iksQuickSearchKeyBound = true;
          document.addEventListener('keydown', (e) => {
            const ctrl = window.__iksQuickSearchControls;
            if (!ctrl) return;

            if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
              e.preventDefault();
              if (ctrl.isOpen()) ctrl.closeModal();
              else ctrl.openModal();
              return;
            }

            if (e.key === '/' && !e.ctrlKey && !e.metaKey && !e.altKey) {
              const target = e.target;
              const tag = target && target.tagName ? target.tagName.toLowerCase() : '';
              const isEditable = tag === 'input' || tag === 'textarea' || tag === 'select' || (target && target.isContentEditable);
              if (!isEditable && !ctrl.isOpen()) {
                e.preventDefault();
                ctrl.openModal();
              }
              return;
            }

            if (e.key === 'Escape' && ctrl.isOpen()) {
              e.preventDefault();
              ctrl.closeModal();
            }
          });
        }
      }

      function initLayoutInteractions() {
        initMobileMenu();
        initThemeToggle();
        initGlobalSearch();
        initQuickSearchModal();
        setupLanguagePickers();
        initBackToTop();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initLayoutInteractions);
      } else {
        initLayoutInteractions();
      }
      document.addEventListener('astro:page-load', initLayoutInteractions);
    </script>

    <!-- Dynamic Back to Top Button with Circular Scroll Progress -->
    <div id="back-to-top-container" class="fixed bottom-6 right-6 z-40 transition-all duration-300 opacity-0 pointer-events-none translate-y-3 print:hidden">
      <button
        id="back-to-top-btn"
        type="button"
        aria-label={t('action.backToTop')}
        title={t('action.backToTop')}
        class="relative w-12 h-12 flex items-center justify-center rounded-full bg-canvas/95 dark:bg-surface-soft/95 text-ink shadow-lg border border-hairline hover:border-border-strong hover:scale-105 active:scale-95 transition-all cursor-pointer backdrop-blur-xs group"
      >
        <svg class="absolute inset-0 w-full h-full -rotate-90 pointer-events-none" viewBox="0 0 48 48">
          <circle
            cx="24"
            cy="24"
            r="20"
            stroke="currentColor"
            stroke-width="2.5"
            fill="none"
            class="text-hairline/40 dark:text-hairline/20"
          />
          <circle
            id="back-to-top-progress"
            cx="24"
            cy="24"
            r="20"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-dasharray="125.66"
            stroke-dashoffset="125.66"
            stroke-linecap="round"
            fill="none"
            class="text-link transition-all duration-100"
          />
        </svg>
        <svg class="w-5 h-5 text-ink group-hover:-translate-y-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7m-7-7v18" />
        </svg>
      </button>
    </div>

    <!-- Cookie Consent Banner -->
    <div id="cookie-consent-banner" class="fixed bottom-4 left-4 right-4 md:left-auto md:max-w-md bg-canvas border border-hairline shadow-lg rounded-lg p-6 z-[100] hidden transition-all duration-300 transform translate-y-4 opacity-0">
      <h3 class="text-title-sm text-ink font-semibold mb-2">{t('cookie.title')}</h3>
      <p class="text-[13px] text-body mb-4 leading-relaxed">
        {t('cookie.message')} <a href="/privacy/" class="text-link underline hover:underline">{t('footer.privacy')}</a>.
      </p>
      <div class="flex justify-end gap-3 text-xs">
        <button id="cookie-decline-btn" class="min-h-[44px] px-5 py-2.5 bg-canvas text-ink border border-hairline rounded-md hover:bg-surface-soft cursor-pointer transition-colors font-medium inline-flex items-center justify-center text-sm">
          {t('cookie.decline')}
        </button>
        <button id="cookie-accept-btn" class="min-h-[44px] px-5 py-2.5 bg-primary text-on-primary rounded-md hover:bg-primary-active cursor-pointer transition-colors font-medium inline-flex items-center justify-center text-sm">
          {t('cookie.accept')}
        </button>
      </div>
    </div>

    <script is:inline>
      (function() {
        function initCookieConsent() {
          var banner = document.getElementById('cookie-consent-banner');
          var acceptBtn = document.getElementById('cookie-accept-btn');
          var declineBtn = document.getElementById('cookie-decline-btn');

          if (!banner || !acceptBtn || !declineBtn) return;

          var consent = localStorage.getItem('cookie-consent');

          if (!consent) {
            // Show the banner with a slight delay for smooth animation
            setTimeout(function() {
              banner.classList.remove('hidden');
              requestAnimationFrame(function() {
                banner.classList.remove('translate-y-4', 'opacity-0');
                banner.classList.add('translate-y-0', 'opacity-100');
              });
            }, 800);
          }

          acceptBtn.addEventListener('click', function() {
            localStorage.setItem('cookie-consent', 'accepted');
            if (typeof window.gtag === 'function') {
              window.gtag('consent', 'update', {
                'ad_storage': 'granted',
                'ad_user_data': 'granted',
                'ad_personalization': 'granted',
                'analytics_storage': 'granted'
              });
            }
            hideBanner();
            window.dispatchEvent(new CustomEvent('cookie-consent-accepted'));
          });

          declineBtn.addEventListener('click', function() {
            localStorage.setItem('cookie-consent', 'declined');
            if (typeof window.gtag === 'function') {
              window.gtag('consent', 'update', {
                'ad_storage': 'denied',
                'ad_user_data': 'denied',
                'ad_personalization': 'denied',
                'analytics_storage': 'denied'
              });
            }
            hideBanner();
          });

          function hideBanner() {
            banner.classList.remove('translate-y-0', 'opacity-100');
            banner.classList.add('translate-y-4', 'opacity-0');
            setTimeout(function() {
              banner.classList.add('hidden');
            }, 300);
          }
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initCookieConsent);
        } else {
          initCookieConsent();
        }
      })();
    </script>
  </body>
</html>
