    <!-- Client-side navigation toggle and global search index load -->
    <script is:inline data-cfasync="false">
      function initMobileMenu() {
        const toggleBtn = document.getElementById('mobile-menu-toggle');
        const closeBtn = document.getElementById('mobile-menu-close');
        const mobileMenu = document.getElementById('mobile-menu');

        if (!toggleBtn || !mobileMenu) return;
        if (toggleBtn.dataset.bound === 'true') return;
        toggleBtn.dataset.bound = 'true';

        let isTransitioning = false;

        const openMenu = () => {
          if (isTransitioning) return;
          isTransitioning = true;
          mobileMenu.classList.remove('hidden');
          requestAnimationFrame(() => {
            mobileMenu.classList.remove('translate-x-full');
          });
          toggleBtn.setAttribute('aria-expanded', 'true');
          mobileMenu.setAttribute('aria-hidden', 'false');
          document.body.classList.add('overflow-hidden');
          if (closeBtn) closeBtn.focus();
          setTimeout(() => {
            isTransitioning = false;
          }, 310);
        };

        const closeMenu = () => {
          if (isTransitioning) return;
          isTransitioning = true;
          mobileMenu.classList.add('translate-x-full');
          toggleBtn.setAttribute('aria-expanded', 'false');
          mobileMenu.setAttribute('aria-hidden', 'true');
          document.body.classList.remove('overflow-hidden');
          toggleBtn.focus();
          setTimeout(() => {
            if (mobileMenu.classList.contains('translate-x-full')) {
              mobileMenu.classList.add('hidden');
            }
            isTransitioning = false;
          }, 310);
        };

        toggleBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          openMenu();
        });

        if (closeBtn) {
          closeBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            closeMenu();
          });
        }

        mobileMenu.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            closeMenu();
            return;
          }

          if (e.key === 'Tab') {
            const focusableElements = mobileMenu.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
            if (focusableElements.length === 0) return;

            const firstElement = focusableElements[0];
            const lastElement = focusableElements[focusableElements.length - 1];

            if (e.shiftKey) {
              if (document.activeElement === firstElement) {
                lastElement.focus();
                e.preventDefault();
              }
            } else {
              if (document.activeElement === lastElement) {
                firstElement.focus();
                e.preventDefault();
              }
            }
          }
        });
      }

      function initThemeToggle() {
        const themeToggleBtn = document.getElementById('theme-toggle');
        const themeToggleDarkIcon = document.getElementById('theme-toggle-dark-icon');
        const themeToggleLightIcon = document.getElementById('theme-toggle-light-icon');

        if (!themeToggleBtn) return;
        if (themeToggleBtn.dataset.bound === 'true') return;
        themeToggleBtn.dataset.bound = 'true';

        const updateIcons = () => {
          if (document.documentElement.classList.contains('dark')) {
            themeToggleDarkIcon?.classList.add('hidden');
            themeToggleLightIcon?.classList.remove('hidden');
          } else {
            themeToggleDarkIcon?.classList.remove('hidden');
            themeToggleLightIcon?.classList.add('hidden');
          }
        };

        updateIcons();

        themeToggleBtn.addEventListener('click', () => {
          if (document.documentElement.classList.contains('dark')) {
            document.documentElement.classList.remove('dark');
            localStorage.setItem('theme', 'light');
          } else {
            document.documentElement.classList.add('dark');
            localStorage.setItem('theme', 'dark');
          }
          updateIcons();
        });
      }

      function initGlobalSearch() {
        const searchForm = document.getElementById('global-search-form');
        const searchInput = document.getElementById('global-search-input');
        const dropdown = document.getElementById('global-search-dropdown');
        const searchLoading = document.getElementById('global-search-loading');

        if (!searchForm || !searchInput) return;
        if (searchForm.dataset.bound === 'true') return;
        searchForm.dataset.bound = 'true';

        const searchPath = searchForm.dataset.searchPath || '/search-index.json';
        const searchLang = searchForm.dataset.lang || 'en';
        let searchIndex = null;
        let isFetching = false;
        let activeIndex = -1;
        let currentMatches = [];

        const closeDropdown = () => {
          if (!dropdown) return;
          dropdown.classList.add('hidden');
          dropdown.innerHTML = '';
          searchInput.setAttribute('aria-expanded', 'false');
          searchInput.removeAttribute('aria-activedescendant');
          activeIndex = -1;
          currentMatches = [];
        };

        const renderDropdown = (matches) => {
          currentMatches = matches;
          activeIndex = -1;
          if (!dropdown) return;
          if (!matches || matches.length === 0) {
            closeDropdown();
            return;
          }
          dropdown.innerHTML = matches.map((entry, idx) => `
            <div 
              role="option" 
              id="search-opt-${idx}" 
              data-index="${idx}" 
              data-url="${entry.url}" 
              aria-selected="false" 
              class="search-option px-3 py-2 text-[13px] text-ink hover:bg-surface-soft cursor-pointer flex items-center justify-between transition-colors"
            >
              <span class="font-medium text-ink truncate">${entry.name}</span>
              <span class="text-[11px] text-muted ml-2 shrink-0 capitalize">${entry.category}</span>
            </div>
          `).join('');
          dropdown.classList.remove('hidden');
          searchInput.setAttribute('aria-expanded', 'true');
        };

        const updateActiveOption = (newIndex) => {
          if (!dropdown) return;
          const options = dropdown.querySelectorAll('.search-option');
          if (options.length === 0) return;
          if (activeIndex >= 0 && options[activeIndex]) {
            options[activeIndex].classList.remove('bg-surface-soft');
            options[activeIndex].setAttribute('aria-selected', 'false');
          }
          activeIndex = newIndex;
          if (activeIndex >= 0 && options[activeIndex]) {
            options[activeIndex].classList.add('bg-surface-soft');
            options[activeIndex].setAttribute('aria-selected', 'true');
            searchInput.setAttribute('aria-activedescendant', options[activeIndex].id);
            options[activeIndex].scrollIntoView({ block: 'nearest' });
          } else {
            searchInput.removeAttribute('aria-activedescendant');
          }
        };

        const loadSearchIndex = async () => {
          if (searchIndex || isFetching) return;
          isFetching = true;
          if (searchLoading) searchLoading.classList.remove('hidden');
          try {
            const response = await fetch(searchPath);
            if (response.ok) {
              searchIndex = await response.json();
              const q = searchInput.value.trim().toLowerCase();
              if (q) {
                const matches = searchIndex.filter(entry => {
                  const name = entry.name.toLowerCase();
                  const cat = (entry.category || '').toLowerCase();
                  return name.includes(q) || cat.includes(q);
                }).slice(0, 8);
                renderDropdown(matches);
              }
            }
          } catch (e) {
            // Silently fail to maintain UX
          } finally {
            isFetching = false;
            if (searchLoading) searchLoading.classList.add('hidden');
          }
        };

        searchInput.addEventListener('focus', loadSearchIndex);
        searchInput.addEventListener('input', () => {
          loadSearchIndex();
          const searchError = document.getElementById('global-search-error');
          if (searchError) searchError.classList.add('hidden');

          const query = searchInput.value.trim().toLowerCase();
          if (!query || !searchIndex) {
            closeDropdown();
            return;
          }

          const matches = searchIndex.filter(entry => {
            const name = entry.name.toLowerCase();
            const cat = (entry.category || '').toLowerCase();
            return name.includes(query) || cat.includes(query);
          }).slice(0, 8);

          renderDropdown(matches);
        });

        searchInput.addEventListener('keydown', (e) => {
          if (!dropdown || dropdown.classList.contains('hidden') || currentMatches.length === 0) {
            return;
          }
          if (e.key === 'ArrowDown') {
            e.preventDefault();
            const nextIndex = (activeIndex + 1) % currentMatches.length;
            updateActiveOption(nextIndex);
          } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            const prevIndex = activeIndex <= 0 ? currentMatches.length - 1 : activeIndex - 1;
            updateActiveOption(prevIndex);
          } else if (e.key === 'Enter') {
            if (activeIndex >= 0 && currentMatches[activeIndex]) {
              e.preventDefault();
              closeDropdown();
              window.location.href = currentMatches[activeIndex].url;
            }
          } else if (e.key === 'Escape') {
            closeDropdown();
          }
        });

        if (dropdown) {
          dropdown.addEventListener('click', (e) => {
            const opt = e.target.closest('.search-option');
            if (opt && opt.dataset.url) {
              closeDropdown();
              window.location.href = opt.dataset.url;
            }
          });
        }

        document.addEventListener('click', (e) => {
          if (!searchForm.contains(e.target)) {
            closeDropdown();
          }
        });

        searchForm.addEventListener('submit', (e) => {
          e.preventDefault();
          const rawValue = searchInput.value.trim().toLowerCase();
          if (!rawValue || !searchIndex) return;

          let match = searchIndex.find(item => item.name.toLowerCase() === rawValue);

          if (!match) {
            match = searchIndex.find(item => {
              const displayVal = `${item.name} (${item.category})`.toLowerCase();
              return displayVal === rawValue;
            });
          }

          if (!match) {
            match = searchIndex.find(item => item.name.toLowerCase().includes(rawValue));
          }

          if (!match) {
            const categoryMapEn = {
              'dishwasher': '/dishwasher/',
              'microwave': '/microwave/',
              'freezer': '/freezer/',
              'oven': '/oven/',
              'dryer': '/dryer/',
              'air fryer': '/airfryer/',
              'airfryer': '/airfryer/',
              'refrigerator': '/refrigerator/',
              'fridge': '/refrigerator/',
              'shelf life': '/how-long/',
              'how long': '/how-long/',
              'washing machine': '/washing-machine/',
              'refreeze': '/refreeze/',
              'what happens': '/what-happens/',
              'compare': '/compare/',
              'comparison': '/compare/',
              'comparisons': '/compare/'
            };

            const categoryMapEs = {
              'lavavajillas': '/es/dishwasher/',
              'lavaplatos': '/es/dishwasher/',
              'dishwasher': '/es/dishwasher/',
              'microondas': '/es/microwave/',
              'microwave': '/es/microwave/'
            };

            const categoryMapPt = {
              'lava-louças': '/pt/dishwasher/',
              'lava louças': '/pt/dishwasher/',
              'lavaloucas': '/pt/dishwasher/',
              'dishwasher': '/pt/dishwasher/',
              'micro-ondas': '/pt/microwave/',
              'microondas': '/pt/microwave/',
              'micro ondas': '/pt/microwave/',
              'microwave': '/pt/microwave/'
            };

            const categoryMaps = {
              en: categoryMapEn,
              es: categoryMapEs,
              pt: categoryMapPt
            };

            const activeCategoryMap = categoryMaps[searchLang] || categoryMapEn;
            if (activeCategoryMap[rawValue]) {
              window.location.href = activeCategoryMap[rawValue];
              return;
            }
          }

          if (match) {
            const searchError = document.getElementById('global-search-error');
            if (searchError) searchError.classList.add('hidden');
            window.location.href = match.url;
          } else {
            const searchError = document.getElementById('global-search-error');
            if (searchError) {
              searchError.textContent = `No match found for "${searchInput.value}". Please use suggestions or check spelling.`;
              searchError.classList.remove('hidden');
            }
          }
        });
      }

      function setupLanguagePickers() {
        const containers = document.querySelectorAll('[data-language-picker]');

        containers.forEach((container) => {
          if (container.dataset.bound === 'true') return;
          container.dataset.bound = 'true';

          const btn = container.querySelector('[data-picker-button]');
          const menu = container.querySelector('[data-picker-dropdown]');
          const arrow = container.querySelector('[data-picker-arrow]');

          if (!btn || !menu) return;

          const toggleDropdown = (open) => {
            const isExpanded = btn.getAttribute('aria-expanded') === 'true';
            const shouldOpen = open !== undefined ? open : !isExpanded;
            btn.setAttribute('aria-expanded', String(shouldOpen));
            if (shouldOpen) {
              menu.classList.remove('hidden');
              if (arrow) arrow.classList.add('rotate-180');
            } else {
              menu.classList.add('hidden');
              if (arrow) arrow.classList.remove('rotate-180');
            }
          };

          let lastTouchTime = 0;
          const handleToggle = (e) => {
            if (e.type === 'touchstart') {
              lastTouchTime = Date.now();
            } else if (e.type === 'click' && Date.now() - lastTouchTime < 500) {
              e.stopPropagation();
              return;
            }
            e.stopPropagation();
            containers.forEach((other) => {
              if (other !== container) {
                const otherBtn = other.querySelector('[data-picker-button]');
                const otherMenu = other.querySelector('[data-picker-dropdown]');
                const otherArrow = other.querySelector('[data-picker-arrow]');
                if (otherBtn) otherBtn.setAttribute('aria-expanded', 'false');
                if (otherMenu) otherMenu.classList.add('hidden');
                if (otherArrow) otherArrow.classList.remove('rotate-180');
              }
            });
            toggleDropdown();
          };

          btn.addEventListener('click', handleToggle);
          btn.addEventListener('touchstart', handleToggle, { passive: true });

          document.addEventListener('click', (e) => {
            if (!container.contains(e.target)) {
              toggleDropdown(false);
            }
          });

          document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
              toggleDropdown(false);
            }
          });
        });
      }

      function initLayoutInteractions() {
        initMobileMenu();
        initThemeToggle();
        initGlobalSearch();
        setupLanguagePickers();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initLayoutInteractions);
      } else {
        initLayoutInteractions();
      }
      document.addEventListener('astro:page-load', initLayoutInteractions);
    </script>

    <!-- Cookie Consent Banner -->
    <div id="cookie-consent-banner" class="fixed bottom-4 left-4 right-4 md:left-auto md:max-w-md bg-canvas border border-hairline shadow-lg rounded-lg p-6 z-[100] hidden transition-all duration-300 transform translate-y-4 opacity-0">
      <h3 class="text-title-sm text-ink font-semibold mb-2">{t('cookie.title')}</h3>
      <p class="text-[13px] text-body mb-4 leading-relaxed">
        {t('cookie.message')} <a href="/privacy/" class="text-link underline hover:underline">{t('footer.privacy')}</a>.
      </p>
      <div class="flex justify-end gap-3 text-xs">
        <button id="cookie-decline-btn" class="min-h-[44px] px-5 py-2.5 bg-canvas text-ink border border-hairline rounded-md hover:bg-surface-soft cursor-pointer transition-colors font-medium inline-flex items-center justify-center text-sm">
          {t('cookie.decline')}
        </button>
        <button id="cookie-accept-btn" class="min-h-[44px] px-5 py-2.5 bg-primary text-on-primary rounded-md hover:bg-primary-active cursor-pointer transition-colors font-medium inline-flex items-center justify-center text-sm">
          {t('cookie.accept')}
        </button>
      </div>
    </div>

    <script is:inline>
      (function() {
        function initCookieConsent() {
          var banner = document.getElementById('cookie-consent-banner');
          var acceptBtn = document.getElementById('cookie-accept-btn');
          var declineBtn = document.getElementById('cookie-decline-btn');

          if (!banner || !acceptBtn || !declineBtn) return;

          var consent = localStorage.getItem('cookie-consent');

          if (!consent) {
            // Show the banner with a slight delay for smooth animation
            setTimeout(function() {
              banner.classList.remove('hidden');
              requestAnimationFrame(function() {
                banner.classList.remove('translate-y-4', 'opacity-0');
                banner.classList.add('translate-y-0', 'opacity-100');
              });
            }, 800);
          }

          acceptBtn.addEventListener('click', function() {
            localStorage.setItem('cookie-consent', 'accepted');
            hideBanner();
            window.dispatchEvent(new CustomEvent('cookie-consent-accepted'));
          });

          declineBtn.addEventListener('click', function() {
            localStorage.setItem('cookie-consent', 'declined');
            hideBanner();
          });

          function hideBanner() {
            banner.classList.remove('translate-y-0', 'opacity-100');
            banner.classList.add('translate-y-4', 'opacity-0');
            setTimeout(function() {
              banner.classList.add('hidden');
            }, 300);
          }
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initCookieConsent);
        } else {
          initCookieConsent();
        }
      })();
    </script>
  </body>
</html>
