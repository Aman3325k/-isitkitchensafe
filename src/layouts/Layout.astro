---
import '../styles/global.css';
import { getLatestDataModifiedTime } from '../utils/materialCategories';
import { getLangFromUrl, useTranslations, useTranslatedPath, getPathWithoutLocale, getApplianceUrl, getDirectoryUrl, getLocalizedUrl, isApplianceTranslatedInLocale, isDirectoryTranslatedInLocale } from '../i18n/utils';
import type { SupportedLanguage } from '../i18n/ui';
import LanguagePicker from '../components/LanguagePicker.astro';

interface Props {
  title: string;
  description: string;
  faqs?: Array<{ question: string; answer: string }>;
  excludeArticleSchema?: boolean;
  excludeFaqSchema?: boolean;
  excludeBreadcrumbSchema?: boolean;
  availableLocales?: SupportedLanguage[];
  lang?: SupportedLanguage;
  is404?: boolean;
  ogType?: string;
}

const { 
  title, 
  description, 
  faqs, 
  excludeArticleSchema = false,
  excludeFaqSchema = false,
  excludeBreadcrumbSchema = false,
  availableLocales,
  lang,
  is404 = false,
  ogType = 'website'
} = Astro.props;

const currentLang = lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const translatePath = useTranslatedPath(currentLang);

const basePath = getPathWithoutLocale(Astro.url.pathname);
const canonicalUrl = new URL(Astro.url.pathname, 'https://isitkitchensafe.com').href;
const englishUrl = new URL(basePath, 'https://isitkitchensafe.com').href;

// Determine locales that exist for this page
const activeLocales: SupportedLanguage[] = availableLocales 
  ? availableLocales 
  : (currentLang === 'en' ? ['en'] : ['en', currentLang]);

// Helper to format appliance and path names
function formatAppliance(app: string) {
  if (app === 'airfryer') return t('appliance.airfryer');
  if (app === 'how-long') return t('nav.howLong');
  if (app === 'washing-machine') return t('nav.washingMachine');
  if (app === 'refreeze') return t('nav.refreeze');
  if (app === 'what-happens') return t('nav.whatHappens');
  if (app === 'compare') return t('nav.compare');
  if (app === 'blog') return 'Blog';
  if (app === 'material') return t('nav.material');
  const appKey = `appliance.${app}` as any;
  return t(appKey) || (app.charAt(0).toUpperCase() + app.slice(1));
}

// Generate FAQ JSON-LD Schema
const defaultFaqs = [
  {
    question: "How do you check if kitchenware is appliance safe?",
    answer: "Look for manufacturer stamps on the bottom of the item (such as a microwave wave symbol or dishwasher safe symbol), or consult the manufacturer manual."
  },
  {
    question: "What makes an item unsafe for kitchen appliances?",
    answer: "Unsafe materials typically react to heat, moisture, or waves, leading to warping, melting, cracking, rust, or the release of toxic chemical fumes."
  },
  {
    question: "Where can I find official appliance safety guidelines?",
    answer: "Official guidelines are published by government agencies like the USDA and FDA, as well as the appliance manufacturers themselves."
  }
];

const finalFaqs = faqs && faqs.length > 0 ? faqs : defaultFaqs;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": finalFaqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};

// Generate Article JSON-LD Schema
const lastModifiedIso = getLatestDataModifiedTime().toISOString();

// Generate BreadcrumbList JSON-LD Schema
const pathSegments = basePath.split('/').filter(Boolean);
const breadcrumbItems = [
  {
    "@type": "ListItem",
    "position": 1,
    "name": t('nav.home'),
    "item": new URL(currentLang === 'en' ? '/' : `/${currentLang}/`, 'https://isitkitchensafe.com').href
  }
];

if (pathSegments.length > 0) {
  const isAppliancePage = pathSegments.length === 1;
  const isItemPage = pathSegments.length === 2;
  
  if (isAppliancePage || isItemPage) {
    const appSlug = pathSegments[0];
    const appName = formatAppliance(appSlug);
    breadcrumbItems.push({
      "@type": "ListItem",
      "position": 2,
      "name": appName,
      "item": new URL(getApplianceUrl(appSlug, currentLang), 'https://isitkitchensafe.com').href
    });
  } else {
    const pageName = formatAppliance(pathSegments[0]);
    breadcrumbItems.push({
      "@type": "ListItem",
      "position": 2,
      "name": pageName,
      "item": new URL(`/${pathSegments[0]}/`, 'https://isitkitchensafe.com').href
    });
  }
  
  if (isItemPage) {
    const itemSlug = pathSegments[1];
    const itemName = itemSlug.split('-').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');
    breadcrumbItems.push({
      "@type": "ListItem",
      "position": 3,
      "name": itemName,
      "item": new URL(getLocalizedUrl(`/${pathSegments[0]}/${itemSlug}/`, currentLang), 'https://isitkitchensafe.com').href
    });
  }
}

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbItems
};

// Generate Article JSON-LD Schema
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title.split(' | ')[0],
  "description": description,
  "image": "https://isitkitchensafe.com/favicon.svg",
  "author": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "logo": {
      "@type": "ImageObject",
      "url": "https://isitkitchensafe.com/favicon.svg"
    }
  },
  "datePublished": "2026-06-13T12:00:00Z",
  "dateModified": lastModifiedIso,
  "mainEntityOfPage": canonicalUrl
};

const appliances = [
  { name: t('appliance.dishwasher'), slug: 'dishwasher' },
  { name: t('appliance.microwave'), slug: 'microwave' },
  { name: t('appliance.freezer'), slug: 'freezer' },
  { name: t('appliance.oven'), slug: 'oven' },
  { name: t('appliance.dryer'), slug: 'dryer' },
  { name: t('appliance.airfryer'), slug: 'airfryer' },
  { name: t('appliance.refrigerator'), slug: 'refrigerator' }
];
---

<!doctype html>
<html lang={currentLang === 'zh-cn' ? 'zh-CN' : currentLang}>
  <head>
    <script is:inline>
      (function() {
        const theme = localStorage.getItem('theme');
        if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
    <link rel="preconnect" href="https://www.google-analytics.com" crossorigin />
    <script is:inline>
      (function() {
        if (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1') return;
        
        var gaLoaded = false;
        var idleId = null;
        var timerId = null;
        var interactionEvents = ['pointerdown', 'scroll', 'touchstart', 'keydown'];

        function cleanup() {
          if (idleId && 'cancelIdleCallback' in window) {
            cancelIdleCallback(idleId);
            idleId = null;
          }
          if (timerId) {
            clearTimeout(timerId);
            timerId = null;
          }
          interactionEvents.forEach(function(evt) {
            window.removeEventListener(evt, triggerGA4);
          });
        }

        function loadGA4() {
          if (gaLoaded) return;
          gaLoaded = true;

          var scriptEl = document.createElement('script');
          scriptEl.async = true;
          scriptEl.src = 'https://www.googletagmanager.com/gtag/js?id=G-N3LZSB37ED';
          document.head.appendChild(scriptEl);

          window.dataLayer = window.dataLayer || [];
          window.gtag = window.gtag || function(){ window.dataLayer.push(arguments); };
          window.gtag('js', new Date());
          window.gtag('config', 'G-N3LZSB37ED');
        }

        function triggerGA4() {
          cleanup();
          loadGA4();
        }

        function scheduleGA4() {
          if (gaLoaded) return;

          interactionEvents.forEach(function(evt) {
            window.addEventListener(evt, triggerGA4, { passive: true, once: true });
          });

          // Fallback timer: 7000ms allows the browser's initial rendering and quiet window to complete
          // undisturbed, while capturing 100% of passive/non-scrolling readers.
          timerId = setTimeout(function() {
            if ('requestIdleCallback' in window) {
              idleId = requestIdleCallback(triggerGA4, { timeout: 2000 });
            } else {
              triggerGA4();
            }
          }, 7000);
        }

        var consent = localStorage.getItem('cookie-consent');
        var region = window.__VISITOR_REGION__;

        if (region === 'non-eu') {
          window.dataLayer = window.dataLayer || [];
          window.gtag = window.gtag || function(){ window.dataLayer.push(arguments); };
          scheduleGA4();
        } else {
          // 'eu' or undefined (fallback safe path)
          if (consent === 'accepted') {
            window.dataLayer = window.dataLayer || [];
            window.gtag = window.gtag || function(){ window.dataLayer.push(arguments); };
            scheduleGA4();
          } else if (!consent) {
            window.addEventListener('cookie-consent-accepted', function() {
              window.dataLayer = window.dataLayer || [];
              window.gtag = window.gtag || function(){ window.dataLayer.push(arguments); };
              scheduleGA4();
            });
          }
        }
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#181d26" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=2" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    {is404 || Astro.url.pathname.includes('404') ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <>
        <link rel="canonical" href={canonicalUrl} />
        {activeLocales.map((loc) => (
          <link 
            rel="alternate" 
            hreflang={loc === 'zh-cn' ? 'zh-CN' : loc} 
            href={new URL(getLocalizedUrl(basePath, loc), 'https://isitkitchensafe.com').href} 
          />
        ))}
        <link rel="alternate" hreflang="x-default" href={englishUrl} />
      </>
    )}

    <!-- Open Graph / Facebook -->
    <meta property="og:site_name" content="IsItKitchenSafe" />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://isitkitchensafe.com/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Is It Kitchen Safe - Kitchen Safety Reference Guides" />
    <meta property="og:locale" content={currentLang === 'es' ? 'es_ES' : currentLang === 'pt' ? 'pt_BR' : currentLang === 'zh-cn' ? 'zh_CN' : currentLang === 'ja' ? 'ja_JP' : 'en_US'} />
    {currentLang !== 'en' && <meta property="og:locale:alternate" content="en_US" />}
    {currentLang !== 'es' && <meta property="og:locale:alternate" content="es_ES" />}
    {currentLang !== 'pt' && <meta property="og:locale:alternate" content="pt_BR" />}
    {currentLang !== 'zh-cn' && <meta property="og:locale:alternate" content="zh_CN" />}
    {currentLang !== 'ja' && <meta property="og:locale:alternate" content="ja_JP" />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://isitkitchensafe.com/og-image.png" />

    {!excludeFaqSchema && faqSchema && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    )}
    {!excludeBreadcrumbSchema && breadcrumbSchema && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}
    {!excludeArticleSchema && articleSchema && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    )}

    <!-- Dynamic Slot for Page-Specific Head Content -->
    <slot name="head" />
  </head>
  <body class="bg-canvas text-body font-sans selection:bg-signature-cream selection:text-ink min-h-screen flex flex-col">
    <!-- Skip to Content Link -->
    <a href="#main-content" class="absolute left-0 top-0 -translate-y-full focus:translate-y-0 bg-primary text-on-primary min-h-[44px] px-4 py-2 flex items-center font-medium transition-transform z-[200] rounded-br-md">
      {t('nav.skip')}
    </a>

    <!-- Header -->
    <header class="h-[64px] border-b border-hairline bg-canvas sticky top-0 z-50">
      <div class="max-w-[1600px] w-full mx-auto px-3 sm:px-6 h-full flex items-center justify-between gap-2 sm:gap-4">
        <!-- Logo -->
        <a href={translatePath('/')} class="min-w-[44px] min-h-[44px] flex items-center gap-2 group shrink-0" id="site-logo" aria-label={t('nav.siteTitle')}>
          <span class="w-8 h-8 rounded-lg bg-primary flex items-center justify-center text-on-primary font-display font-medium text-lg transition-transform group-active:scale-95 shrink-0">✓</span>
          <span class="text-ink font-display font-medium text-[16px] md:text-[18px] tracking-tight hidden sm:inline">{t('nav.siteTitle')}</span>
        </a>

        <!-- Global Search Bar in Header -->
        <form 
          id="global-search-form" 
          class="relative flex-1 min-w-0 max-w-[200px] sm:max-w-[260px] 2xl:max-w-[300px] mx-1 sm:mx-2"
          data-search-path={currentLang === 'en' ? '/search-index.json' : `/${currentLang}/search-index.json`}
          data-lang={currentLang}
        >
          <input 
            type="text" 
            id="global-search-input" 
            placeholder={t('nav.searchPlaceholder')} 
            autocomplete="off"
            aria-label={t('nav.searchAria')}
            role="combobox"
            aria-autocomplete="list"
            aria-expanded="false"
            aria-controls="global-search-dropdown"
            class="w-full h-11 md:h-9 pl-3 pr-8 py-2.5 md:py-1.5 bg-canvas text-ink text-[16px] md:text-[13px] border border-hairline rounded-sm focus:outline-none focus:border-info-border"
          />
          <div 
            id="global-search-dropdown" 
            role="listbox" 
            aria-label="Search suggestions"
            class="hidden absolute top-full left-0 right-0 mt-1 max-h-64 overflow-y-auto bg-canvas border border-hairline rounded-md shadow-lg z-50 py-1"
          ></div>
          <div id="global-search-loading" class="hidden absolute right-2.5 top-1/2 -translate-y-1/2 pointer-events-none">
            <svg class="animate-spin h-3.5 w-3.5 text-muted" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </div>
          <div id="global-search-error" class="hidden absolute top-full left-0 w-full mt-1 bg-surface-soft border border-hairline text-[12px] text-error p-2 rounded-sm shadow-sm z-50" aria-live="polite"></div>
        </form>

        <!-- Desktop Navigation -->
        <nav class="hidden xl:flex items-center gap-3 2xl:gap-4 shrink-0" id="desktop-nav">
          <div class="flex items-center gap-2.5 2xl:gap-3.5 2xl:border-r border-hairline pr-2.5 2xl:pr-3.5">
            {appliances.map(app => (
              <a 
                href={getApplianceUrl(app.slug, currentLang)} 
                class="text-body hover:text-ink text-[13px] font-normal transition-colors inline-flex items-center gap-1 whitespace-nowrap"
              >
                <span>{app.name}</span>
                {currentLang !== 'en' && !isApplianceTranslatedInLocale(app.slug, currentLang) && (
                  <span class="text-[9px] font-semibold text-muted bg-surface-soft border border-hairline px-1 py-0.5 rounded tracking-wider uppercase" title="Available in English only">EN</span>
                )}
              </a>
            ))}
          </div>
          <!-- Secondary directories: inline on wide screens (>= 1680px) -->
          <div class="hidden min-[1680px]:flex items-center gap-2.5 2xl:gap-3 pr-2">
            <a href={getDirectoryUrl('compare', currentLang)} class="text-body hover:text-ink text-[13px] font-normal transition-colors inline-flex items-center gap-1 whitespace-nowrap">
              <span>{t('nav.compare')}</span>
              {currentLang !== 'en' && !isDirectoryTranslatedInLocale('compare', currentLang) && (
                <span class="text-[9px] font-semibold text-muted bg-surface-soft border border-hairline px-1 py-0.5 rounded tracking-wider uppercase" title="Available in English only">EN</span>
              )}
            </a>
            <a href={getDirectoryUrl('material', currentLang)} class="text-body hover:text-ink text-[13px] font-normal transition-colors inline-flex items-center gap-1 whitespace-nowrap">
              <span>{t('nav.material')}</span>
              {currentLang !== 'en' && !isDirectoryTranslatedInLocale('material', currentLang) && (
                <span class="text-[9px] font-semibold text-muted bg-surface-soft border border-hairline px-1 py-0.5 rounded tracking-wider uppercase" title="Available in English only">EN</span>
              )}
            </a>
            <a href={getDirectoryUrl('how-long', currentLang)} class="text-body hover:text-ink text-[13px] font-normal transition-colors inline-flex items-center gap-1 whitespace-nowrap">
              <span>{t('nav.howLong')}</span>
              {currentLang !== 'en' && !isDirectoryTranslatedInLocale('how-long', currentLang) && (
                <span class="text-[9px] font-semibold text-muted bg-surface-soft border border-hairline px-1 py-0.5 rounded tracking-wider uppercase" title="Available in English only">EN</span>
              )}
            </a>
            <a href={getDirectoryUrl('washing-machine', currentLang)} class="text-body hover:text-ink text-[13px] font-normal transition-colors inline-flex items-center gap-1 whitespace-nowrap">
              <span>{t('nav.washingMachine')}</span>
              {currentLang !== 'en' && !isDirectoryTranslatedInLocale('washing-machine', currentLang) && (
                <span class="text-[9px] font-semibold text-muted bg-surface-soft border border-hairline px-1 py-0.5 rounded tracking-wider uppercase" title="Available in English only">EN</span>
              )}
            </a>
            <a href={getDirectoryUrl('refreeze', currentLang)} class="text-body hover:text-ink text-[13px] font-normal transition-colors inline-flex items-center gap-1 whitespace-nowrap">
              <span>{t('nav.refreeze')}</span>
              {currentLang !== 'en' && !isDirectoryTranslatedInLocale('refreeze', currentLang) && (
                <span class="text-[9px] font-semibold text-muted bg-surface-soft border border-hairline px-1 py-0.5 rounded tracking-wider uppercase" title="Available in English only">EN</span>
              )}
            </a>
            <a href={getDirectoryUrl('what-happens', currentLang)} class="text-body hover:text-ink text-[13px] font-normal transition-colors inline-flex items-center gap-1 whitespace-nowrap">
              <span>{t('nav.whatHappens')}</span>
              {currentLang !== 'en' && !isDirectoryTranslatedInLocale('what-happens', currentLang) && (
                <span class="text-[9px] font-semibold text-muted bg-surface-soft border border-hairline px-1 py-0.5 rounded tracking-wider uppercase" title="Available in English only">EN</span>
              )}
            </a>
          </div>

          <!-- Secondary directories: "More" dropdown for intermediate desktop screens (1280px - 1679px) -->
          <div class="relative hidden xl:block min-[1680px]:hidden group" id="desktop-more-menu">
            <button 
              type="button" 
              class="text-body hover:text-ink text-[13px] font-normal transition-colors inline-flex items-center gap-1 py-2 cursor-pointer"
              aria-expanded="false"
              aria-haspopup="true"
              id="desktop-more-button"
            >
              <span>{currentLang === 'ja' ? 'その他' : currentLang === 'es' ? 'Más' : currentLang === 'pt' ? 'Mais' : currentLang === 'zh-cn' ? '更多' : 'More'}</span>
              <svg class="w-3.5 h-3.5 text-muted transition-transform group-hover:rotate-180 group-focus-within:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="absolute right-0 top-full pt-1 hidden group-hover:block group-focus-within:block z-50">
              <div class="w-48 bg-canvas border border-hairline rounded-md shadow-lg py-1.5 ring-1 ring-black/5 flex flex-col">
                <a href={getDirectoryUrl('compare', currentLang)} class="px-3.5 py-2 text-[13px] text-body hover:text-ink hover:bg-surface-soft transition-colors flex items-center justify-between">
                  <span>{t('nav.compare')}</span>
                  {currentLang !== 'en' && !isDirectoryTranslatedInLocale('compare', currentLang) && (
                    <span class="text-[9px] font-semibold text-muted bg-surface-soft border border-hairline px-1 py-0.5 rounded tracking-wider uppercase">EN</span>
                  )}
                </a>
                <a href={getDirectoryUrl('material', currentLang)} class="px-3.5 py-2 text-[13px] text-body hover:text-ink hover:bg-surface-soft transition-colors flex items-center justify-between">
                  <span>{t('nav.material')}</span>
                  {currentLang !== 'en' && !isDirectoryTranslatedInLocale('material', currentLang) && (
                    <span class="text-[9px] font-semibold text-muted bg-surface-soft border border-hairline px-1 py-0.5 rounded tracking-wider uppercase">EN</span>
                  )}
                </a>
                <a href={getDirectoryUrl('how-long', currentLang)} class="px-3.5 py-2 text-[13px] text-body hover:text-ink hover:bg-surface-soft transition-colors flex items-center justify-between">
                  <span>{t('nav.howLong')}</span>
                  {currentLang !== 'en' && !isDirectoryTranslatedInLocale('how-long', currentLang) && (
                    <span class="text-[9px] font-semibold text-muted bg-surface-soft border border-hairline px-1 py-0.5 rounded tracking-wider uppercase">EN</span>
                  )}
                </a>
                <a href={getDirectoryUrl('washing-machine', currentLang)} class="px-3.5 py-2 text-[13px] text-body hover:text-ink hover:bg-surface-soft transition-colors flex items-center justify-between">
                  <span>{t('nav.washingMachine')}</span>
                  {currentLang !== 'en' && !isDirectoryTranslatedInLocale('washing-machine', currentLang) && (
                    <span class="text-[9px] font-semibold text-muted bg-surface-soft border border-hairline px-1 py-0.5 rounded tracking-wider uppercase">EN</span>
                  )}
                </a>
                <a href={getDirectoryUrl('refreeze', currentLang)} class="px-3.5 py-2 text-[13px] text-body hover:text-ink hover:bg-surface-soft transition-colors flex items-center justify-between">
                  <span>{t('nav.refreeze')}</span>
                  {currentLang !== 'en' && !isDirectoryTranslatedInLocale('refreeze', currentLang) && (
                    <span class="text-[9px] font-semibold text-muted bg-surface-soft border border-hairline px-1 py-0.5 rounded tracking-wider uppercase">EN</span>
                  )}
                </a>
                <a href={getDirectoryUrl('what-happens', currentLang)} class="px-3.5 py-2 text-[13px] text-body hover:text-ink hover:bg-surface-soft transition-colors flex items-center justify-between">
                  <span>{t('nav.whatHappens')}</span>
                  {currentLang !== 'en' && !isDirectoryTranslatedInLocale('what-happens', currentLang) && (
                    <span class="text-[9px] font-semibold text-muted bg-surface-soft border border-hairline px-1 py-0.5 rounded tracking-wider uppercase">EN</span>
                  )}
                </a>
              </div>
