  }
};

const t = dict[lang] || dict.en;
const dataJsonString = JSON.stringify(melamineData);
---

<div class="melamine-modeler-wrapper my-8 bg-canvas border border-hairline rounded-3xl p-6 md:p-10 shadow-xs" data-lang={lang}>
  <!-- Header Bar -->
  <div class="flex flex-wrap items-center justify-between gap-4 border-b border-hairline pb-6 mb-8">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-red-100 text-red-900 mb-2 border border-red-200">
        <span>🧪</span>
        {t.badge}
      </div>
      <h2 class="text-2xl md:text-3xl font-extrabold text-ink tracking-tight">
        {t.title}
      </h2>
      <p class="text-sm md:text-base text-body mt-1 max-w-3xl leading-relaxed">
        {t.subtitle}
      </p>
    </div>
    <button 
      id="copy-melamine-report-btn" 
      class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-surface-soft hover:bg-surface-strong border border-hairline text-ink font-medium text-xs transition-colors shadow-xs cursor-pointer"
    >
      <svg class="w-4 h-4 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
      </svg>
      <span id="copy-btn-text">{t.copyReportBtn}</span>
    </button>
  </div>

  <!-- Presets Quick Bar -->
  <div class="mb-8">
    <div class="text-xs font-mono uppercase tracking-wider text-muted mb-3 font-semibold">
      ⚡ {t.presetsTitle}
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2">
      <button class="preset-btn p-2.5 rounded-xl text-left bg-surface-soft hover:bg-surface-strong border border-hairline text-xs font-medium text-ink transition-all" data-preset="ramen">
        🍜 {t.presetRamen}
      </button>
      <button class="preset-btn p-2.5 rounded-xl text-left bg-surface-soft hover:bg-surface-strong border border-hairline text-xs font-medium text-ink transition-all" data-preset="microwave">
        ⚠️ {t.presetMicrowave}
      </button>
      <button class="preset-btn p-2.5 rounded-xl text-left bg-surface-soft hover:bg-surface-strong border border-hairline text-xs font-medium text-ink transition-all" data-preset="bamboo">
        🎋 {t.presetBambooCup}
      </button>
      <button class="preset-btn p-2.5 rounded-xl text-left bg-surface-soft hover:bg-surface-strong border border-hairline text-xs font-medium text-ink transition-all" data-preset="salad">
        🥗 {t.presetColdSalad}
      </button>
      <button class="preset-btn p-2.5 rounded-xl text-left bg-surface-soft hover:bg-surface-strong border border-hairline text-xs font-medium text-ink transition-all" data-preset="baby">
        👶 {t.presetBabyBowl}
      </button>
      <button class="preset-btn p-2.5 rounded-xl text-left bg-surface-soft hover:bg-surface-strong border border-hairline text-xs font-medium text-ink transition-all" data-preset="porcelain">
        ✨ {t.presetPorcelain}
      </button>
    </div>
  </div>

  <!-- Two Column Layout: Controls & Diagnostics -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mb-10">
    <!-- Controls (7 cols) -->
    <div class="lg:col-span-7 space-y-6 bg-surface-soft/60 border border-hairline rounded-2xl p-6">
      <div class="border-b border-hairline/60 pb-3">
        <h3 class="font-bold text-ink text-base">
          {t.controlsTitle}
        </h3>
        <p class="text-xs text-muted mt-0.5">
          {t.controlsSub}
        </p>
      </div>

      <!-- 1. Tableware Material Selection -->
      <div>
        <label for="melamine-material-select" class="block font-semibold text-xs text-ink uppercase tracking-wider mb-1">
          {t.materialLabel}
        </label>
        <select id="melamine-material-select" class="w-full bg-canvas border border-hairline rounded-xl px-3 py-2 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-red-500 font-medium">
          {melamineData.tablewareTypes.map((mat) => (
            <option value={mat.id} selected={mat.id === 'pure-melamine-resin'}>
              {mat.name} ({mat.category})
            </option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1 leading-normal">
          {t.materialHelp}
        </p>
      </div>

      <!-- 2. Food Substrate / Simulant -->
      <div>
        <label for="melamine-food-select" class="block font-semibold text-xs text-ink uppercase tracking-wider mb-1">
          {t.foodLabel}
        </label>
        <select id="melamine-food-select" class="w-full bg-canvas border border-hairline rounded-xl px-3 py-2 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-red-500 font-medium">
          {melamineData.foodMatrices.map((food) => (
            <option value={food.id} selected={food.id === 'hot-chicken-bone-broth'}>
              {food.name} (pH {food.pH} - {food.acidType})
            </option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1 leading-normal">
          {t.foodHelp}
        </p>
      </div>

      <!-- 3. Food Temperature Slider -->
      <div>
        <div class="flex items-center justify-between mb-1">
          <label for="melamine-temp-slider" class="font-semibold text-xs text-ink uppercase tracking-wider">
            {t.tempLabel}
          </label>
          <span class="font-mono text-sm font-bold text-red-600" id="melamine-temp-display">90°C (194°F)</span>
        </div>
        <input 
          type="range" 
          id="melamine-temp-slider" 
          min="5" 
          max="100" 
          step="1" 
          value="90" 
          class="w-full accent-red-600 cursor-pointer"
        />
        <div class="flex justify-between text-[10px] font-mono text-muted mt-1">
          <span>5°C (Chilled)</span>
          <span class="text-amber-700 font-semibold font-sans">▲ BfR 70°C Safety Ceiling</span>
          <span>100°C (Boiling)</span>
        </div>
        <p class="text-[11px] text-muted mt-1 leading-normal">
          {t.tempHelp}
        </p>
      </div>

      <!-- 4. Microwave Heating Mode -->
      <div>
        <label class="block font-semibold text-xs text-ink uppercase tracking-wider mb-2">
          {t.microwaveLabel}
        </label>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
          {melamineData.microwaveExposureModes.map((m, idx) => (
            <label class="flex items-center gap-2 p-2.5 rounded-xl border border-hairline bg-canvas cursor-pointer hover:bg-surface-strong transition-colors text-xs text-ink">
              <input 
                type="radio" 
                name="microwaveMode" 
                value={m.mode} 
                checked={idx === 0} 
                class="accent-red-600"
              />
              <span class="font-medium">{m.name.split(' (')[0]}</span>
            </label>
          ))}
        </div>
        <p class="text-[11px] text-muted mt-1 leading-normal">
          {t.microwaveHelp}
        </p>
      </div>

      <!-- 5. Tableware Age / Surface Wear -->
      <div>
        <label for="melamine-wear-select" class="block font-semibold text-xs text-ink uppercase tracking-wider mb-1">
          {t.wearLabel}
        </label>
        <select id="melamine-wear-select" class="w-full bg-canvas border border-hairline rounded-xl px-3 py-2 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-red-500 font-medium">
          {melamineData.wearLevels.map((w, idx) => (
            <option value={w.id} selected={idx === 1}>
              {w.name} — {w.abrasionScore}
            </option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1 leading-normal">
          {t.wearHelp}
        </p>
      </div>

      <!-- 6. Consumer Weight & Cyanuric Acid Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2 border-t border-hairline/60">
        <div>
          <div class="flex items-center justify-between mb-1">
            <label for="melamine-weight-slider" class="font-semibold text-xs text-ink uppercase tracking-wider">
              {t.weightLabel}
            </label>
            <span class="font-mono text-sm font-bold text-ink" id="melamine-weight-display">65 kg (Adult)</span>
          </div>
          <input 
            type="range" 
            id="melamine-weight-slider" 
            min="5" 
            max="100" 
            step="1" 
            value="65" 
            class="w-full accent-ink cursor-pointer"
          />
          <div class="flex justify-between text-[10px] font-mono text-muted mt-0.5">
            <span>5kg (Infant)</span>
            <span>20kg (Child)</span>
            <span>70kg (Adult)</span>
          </div>
          <p class="text-[10px] text-muted mt-1">
            {t.weightHelp}
          </p>
        </div>

        <div>
          <label for="melamine-cyanuric-select" class="block font-semibold text-xs text-ink uppercase tracking-wider mb-1">
            {t.cyanuricLabel}
          </label>
          <select id="melamine-cyanuric-select" class="w-full bg-canvas border border-hairline rounded-xl px-2.5 py-1.5 text-xs text-ink focus:outline-none focus:ring-2 focus:ring-red-500 font-medium">
            {melamineData.cyanuricAcidCoExposure.map((c) => (
              <option value={c.level} selected={c.level === 'low-trace'}>
                {c.label}
              </option>
            ))}
          </select>
          <p class="text-[10px] text-muted mt-1">
            {t.cyanuricHelp}
          </p>
        </div>
      </div>
    </div>

    <!-- Diagnostics Display (5 cols) -->
    <div class="lg:col-span-5 space-y-5 bg-surface-soft border border-hairline rounded-2xl p-6 shadow-xs sticky top-4">
      <div class="border-b border-hairline/60 pb-3">
        <h3 class="font-bold text-ink text-base">
          {t.diagnosticTitle}
        </h3>
        <p class="text-xs text-muted mt-0.5">
          {t.diagnosticSub}
        </p>
      </div>

      <!-- Main Score / Status Pill -->
      <div id="safety-grade-card" class="p-4 rounded-xl border border-red-200 bg-red-50 text-red-900 transition-colors">
        <div class="text-[11px] font-mono uppercase tracking-wider font-bold opacity-80 mb-1">
          {t.overallScoreLabel}
        </div>
        <div class="text-2xl font-extrabold tracking-tight flex items-center justify-between" id="safety-grade-title">
          <span>HAZARDOUS</span>
          <span class="text-sm font-mono px-2 py-0.5 rounded-md bg-white/70" id="safety-grade-badge">EXCEEDS BfR SML</span>
        </div>
        <p class="text-xs mt-2 leading-relaxed opacity-90" id="safety-grade-desc">
          Hot contact triggers aggressive hydrolytic cleavage. Formaldehyde migration exceeds safety ceilings.
        </p>
      </div>

      <!-- Chemical Migration Metrics -->
      <div class="space-y-4 pt-1">
        <!-- Formaldehyde Migration -->
        <div>
          <div class="flex items-center justify-between text-xs mb-1">
            <span class="font-semibold text-ink">{t.formaldehydeLabel}</span>
            <span class="font-mono font-bold text-red-600" id="hcho-ppm-display">18.4 mg/kg (PPM)</span>
          </div>
          <div class="w-full bg-canvas border border-hairline rounded-full h-2.5 overflow-hidden">
            <div id="hcho-bar" class="bg-red-600 h-full rounded-full transition-all duration-300" style="width: 100%;"></div>
          </div>
          <div class="flex justify-between text-[10px] font-mono text-muted mt-1">
            <span>0 mg/kg</span>
            <span class="text-amber-800 font-semibold">BfR Limit: 15.0 mg/kg</span>
            <span id="hcho-limit-ratio" class="font-bold text-red-700">123% of Limit</span>
          </div>
        </div>

        <!-- Melamine Monomer Migration -->
        <div>
          <div class="flex items-center justify-between text-xs mb-1">
            <span class="font-semibold text-ink">{t.melamineLabel}</span>
            <span class="font-mono font-bold text-amber-700" id="melamine-ppm-display">1.85 mg/kg (PPM)</span>
          </div>
          <div class="w-full bg-canvas border border-hairline rounded-full h-2.5 overflow-hidden">
            <div id="melamine-bar" class="bg-amber-600 h-full rounded-full transition-all duration-300" style="width: 74%;"></div>
          </div>
          <div class="flex justify-between text-[10px] font-mono text-muted mt-1">
            <span>0 mg/kg</span>
