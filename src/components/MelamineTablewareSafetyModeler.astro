<!-- Embedded Raw Data & Client Logic -->
<script define:vars={{ dataJsonString, currentLang: lang }}>
  (function () {
    const data = JSON.parse(dataJsonString);

    // DOM Elements
    const materialSelect = document.getElementById('melamine-material-select');
    const foodSelect = document.getElementById('melamine-food-select');
    const tempSlider = document.getElementById('melamine-temp-slider');
    const tempDisplay = document.getElementById('melamine-temp-display');
    const wearSelect = document.getElementById('melamine-wear-select');
    const weightSlider = document.getElementById('melamine-weight-slider');
    const weightDisplay = document.getElementById('melamine-weight-display');
    const cyanuricSelect = document.getElementById('melamine-cyanuric-select');
    const microwaveRadios = document.querySelectorAll('input[name="microwaveMode"]');

    // Display Elements
    const safetyGradeCard = document.getElementById('safety-grade-card');
    const safetyGradeTitle = document.getElementById('safety-grade-title');
    const safetyGradeBadge = document.getElementById('safety-grade-badge');
    const safetyGradeDesc = document.getElementById('safety-grade-desc');
    const hchoPpmDisplay = document.getElementById('hcho-ppm-display');
    const hchoBar = document.getElementById('hcho-bar');
    const hchoLimitRatio = document.getElementById('hcho-limit-ratio');
    const melaminePpmDisplay = document.getElementById('melamine-ppm-display');
    const melamineBar = document.getElementById('melamine-bar');
    const melamineLimitRatio = document.getElementById('melamine-limit-ratio');
    const hchoTdiDisplay = document.getElementById('hcho-tdi-display');
    const melamineTdiDisplay = document.getElementById('melamine-tdi-display');
    const coreTempDisplay = document.getElementById('core-temp-display');
    const crazingDisplay = document.getElementById('crazing-display');
    const crystalRiskDisplay = document.getElementById('crystal-risk-display');
    const bfrBadge = document.getElementById('bfr-badge');
    const fdaBadge = document.getElementById('fda-badge');
    const copyBtn = document.getElementById('copy-melamine-report-btn');
    const copyBtnText = document.getElementById('copy-btn-text');

    function getSelectedMicrowaveMode() {
      for (const r of microwaveRadios) {
        if (r.checked) return r.value;
      }
      return 'no-microwave';
    }

    function calculateDiagnostics() {
      if (!materialSelect || !foodSelect || !tempSlider) return;

      const matId = materialSelect.value;
      const foodId = foodSelect.value;
      const tempC = parseFloat(tempSlider.value);
      const wearId = wearSelect.value;
      const weightKg = parseFloat(weightSlider.value);
      const cyanuricLevel = cyanuricSelect.value;
      const microwaveMode = getSelectedMicrowaveMode();

      // Find objects
      const material = data.tablewareTypes.find(m => m.id === matId) || data.tablewareTypes[0];
      const food = data.foodMatrices.find(f => f.id === foodId) || data.foodMatrices[0];
      const wear = data.wearLevels.find(w => w.id === wearId) || data.wearLevels[0];
      const mwMode = data.microwaveExposureModes.find(m => m.mode === microwaveMode) || data.microwaveExposureModes[0];
      const cyanuric = data.cyanuricAcidCoExposure.find(c => c.level === cyanuricLevel) || data.cyanuricAcidCoExposure[0];

      // Update Slider Displays
      const tempF = Math.round((tempC * 9/5) + 32);
      tempDisplay.textContent = `${tempC}°C (${tempF}°F)`;
      weightDisplay.textContent = `${weightKg} kg (${weightKg <= 12 ? 'Infant/Toddler' : weightKg <= 35 ? 'Child' : 'Adult'})`;

      // Inorganic Porcelain/Glass Check (zero leaching)
      if (material.id === 'safe-inert-porcelain-glass') {
        renderInertState();
        return;
      }

      // 1. Thermal Activation Factor (Arrhenius-style temperature dependency)
      // Reference temp: 20°C. Above 70°C, activation energy leads to exponential surge.
      let thermalMultiplier = 1.0;
      if (tempC <= 20) {
        thermalMultiplier = 0.15;
      } else if (tempC <= 50) {
        thermalMultiplier = 0.6 + ((tempC - 20) / 30) * 0.8; // 0.6 to 1.4
      } else if (tempC <= 70) {
        thermalMultiplier = 1.4 + ((tempC - 50) / 20) * 1.6; // 1.4 to 3.0
      } else {
        // Temperature > 70°C: steep acceleration
        const delta = tempC - 70;
        thermalMultiplier = 3.0 * Math.exp(delta * 0.045);
      }

      // 2. Acidity Hydrolysis Multiplier
      const acidMult = food.hydrolysisMultiplier;

      // 3. Surface Wear Multiplier
      const wearMult = wear.surfaceWearMultiplier;

      // 4. Microwave Dielectric Multiplier & Internal Temperature Surge
      const mwMult = mwMode.dielectricMultiplier;
      const estCoreTempC = Math.min(165, Math.round(tempC + mwMode.internalTemperatureSurgeC * (material.dielectricLossTangent / 0.045)));

      // Leaching Computations (mg/kg food = PPM)
      const hchoPpm = Number((material.baseFormaldehydeMigrationPpm * thermalMultiplier * acidMult * wearMult * mwMult).toFixed(2));
      const melaminePpm = Number((material.baseMelamineMigrationPpm * thermalMultiplier * acidMult * wearMult * mwMult).toFixed(2));

      // Intake Assessment based on 300g food portion
      const portionKg = 0.30;
      const hchoIntakeMg = hchoPpm * portionKg;
      const melamineIntakeMg = melaminePpm * portionKg;

      const hchoDoseMgKgBw = hchoIntakeMg / weightKg;
      const melamineDoseMgKgBw = melamineIntakeMg / weightKg;

      const hchoTdiPct = Math.round((hchoDoseMgKgBw / data.regulatoryThresholds.bfrTolerableDailyIntakeFormaldehydeMgKgBw) * 100);
      const melamineTdiPct = Math.round((melamineDoseMgKgBw / data.regulatoryThresholds.efsaTolerableDailyIntakeMelamineMgKgBw) * 100);

      // SML Threshold checks
      const bfrHchoSml = data.regulatoryThresholds.bfrSpecificMigrationLimitFormaldehydeMgKg; // 15 mg/kg
      const bfrMelamineSml = data.regulatoryThresholds.bfrSpecificMigrationLimitMelamineMgKg; // 2.5 mg/kg

      const hchoRatioPct = Math.round((hchoPpm / bfrHchoSml) * 100);
      const melamineRatioPct = Math.round((melaminePpm / bfrMelamineSml) * 100);

      // Nephrolithiasis Spherulite Risk
      let crystalRisk = 'LOW';
      let crystalColor = 'text-emerald-700';
      if (melaminePpm > 2.5 && cyanuric.level === 'high-adulterated') {
        crystalRisk = 'SEVERE';
        crystalColor = 'text-red-700';
      } else if (melaminePpm > 1.5 && (cyanuric.level === 'low-trace' || cyanuric.level === 'high-adulterated')) {
        crystalRisk = 'ELEVATED';
        crystalColor = 'text-amber-700';
      } else if (weightKg < 15 && melaminePpm > 1.0) {
        crystalRisk = 'PEDIATRIC ALERT';
        crystalColor = 'text-amber-700';
      }

      // Update DOM
      hchoPpmDisplay.textContent = `${hchoPpm} mg/kg (PPM)`;
      hchoBar.style.width = `${Math.min(100, (hchoPpm / (bfrHchoSml * 1.5)) * 100)}%`;
      hchoLimitRatio.textContent = `${hchoRatioPct}% of BfR SML`;

      melaminePpmDisplay.textContent = `${melaminePpm} mg/kg (PPM)`;
      melamineBar.style.width = `${Math.min(100, (melaminePpm / (bfrMelamineSml * 1.5)) * 100)}%`;
      melamineLimitRatio.textContent = `${melamineRatioPct}% of EU/BfR SML`;

      hchoTdiDisplay.textContent = `${hchoTdiPct}%`;
      melamineTdiDisplay.textContent = `${melamineTdiPct}%`;

      coreTempDisplay.textContent = `${estCoreTempC}°C`;
      crazingDisplay.textContent = mwMode.crazingRisk;
      crystalRiskDisplay.textContent = crystalRisk;
      crystalRiskDisplay.className = `text-base font-extrabold mt-0.5 ${crystalColor}`;

      // Regulatory Status Determination
      const isBfrCompliant = hchoPpm <= bfrHchoSml && melaminePpm <= bfrMelamineSml && tempC <= 70 && microwaveMode === 'no-microwave';
      const isFdaCompliant = tempC <= 70 && microwaveMode === 'no-microwave';

      if (isBfrCompliant) {
        bfrBadge.textContent = 'COMPLIANT';
        bfrBadge.className = 'px-2.5 py-1 rounded-md text-[11px] font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800';
      } else {
        bfrBadge.textContent = tempC > 70 ? 'FAIL: >70°C LIMIT' : microwaveMode !== 'no-microwave' ? 'FAIL: MICROWAVE BAN' : 'NON-COMPLIANT';
        bfrBadge.className = 'px-2.5 py-1 rounded-md text-[11px] font-bold uppercase tracking-wider bg-red-100 text-red-800';
      }

      if (isFdaCompliant) {
        fdaBadge.textContent = 'COMPLIANT';
        fdaBadge.className = 'px-2.5 py-1 rounded-md text-[11px] font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800';
      } else {
        fdaBadge.textContent = microwaveMode !== 'no-microwave' ? 'STRICT PROHIBITION' : 'TEMP EXCEEDS 70°C';
        fdaBadge.className = 'px-2.5 py-1 rounded-md text-[11px] font-bold uppercase tracking-wider bg-red-100 text-red-800';
      }

      // Safety Grade Card
      if (microwaveMode !== 'no-microwave' || hchoPpm > 25 || material.id === 'bamboo-melamine-composite') {
        safetyGradeCard.className = 'p-4 rounded-xl border border-red-300 bg-red-100/80 text-red-950 transition-colors';
        safetyGradeTitle.firstElementChild.textContent = 'CRITICAL TOXIC';
        safetyGradeBadge.textContent = 'EXTREME LEACHING';
        safetyGradeBadge.className = 'text-sm font-mono px-2 py-0.5 rounded-md bg-red-200 text-red-900';
        safetyGradeDesc.textContent = microwaveMode !== 'no-microwave'
          ? 'Dielectric superheating unzips melamine crosslinks, driving severe internal blistering and massive formaldehyde plumes into food.'
          : material.id === 'bamboo-melamine-composite'
          ? 'Bamboo composite tableware is banned across the EU under Regulation 10/2011. Hydrophilic fibers cause catastrophic resin breakdown.'
          : 'Chemical migration grossly exceeds regulatory ceilings, posing acute mucosal toxicity and carcinogenic formaldehyde exposure.';
      } else if (hchoPpm > bfrHchoSml || melaminePpm > bfrMelamineSml || tempC > 70) {
        safetyGradeCard.className = 'p-4 rounded-xl border border-amber-300 bg-amber-50 text-amber-950 transition-colors';
        safetyGradeTitle.firstElementChild.textContent = 'HAZARDOUS';
        safetyGradeBadge.textContent = 'EXCEEDS CEILING';
        safetyGradeBadge.className = 'text-sm font-mono px-2 py-0.5 rounded-md bg-amber-200 text-amber-900';
        safetyGradeDesc.textContent = 'High contact temperatures catalyze hydrolytic cleavage. Leaching exceeds German BfR Specific Migration Limits.';
      } else if (hchoTdiPct > 50 || weightKg < 15) {
        safetyGradeCard.className = 'p-4 rounded-xl border border-yellow-300 bg-yellow-50 text-yellow-950 transition-colors';
        safetyGradeTitle.firstElementChild.textContent = 'CAUTION';
        safetyGradeBadge.textContent = 'PEDIATRIC CONCERN';
        safetyGradeBadge.className = 'text-sm font-mono px-2 py-0.5 rounded-md bg-yellow-200 text-yellow-900';
        safetyGradeDesc.textContent = 'Within static migration limits but approaches tolerable daily intake thresholds for low body weight infants.';
      } else {
        safetyGradeCard.className = 'p-4 rounded-xl border border-emerald-300 bg-emerald-50 text-emerald-950 transition-colors';
        safetyGradeTitle.firstElementChild.textContent = 'OPTIMAL';
        safetyGradeBadge.textContent = 'SAFE COLD/WARM';
        safetyGradeBadge.className = 'text-sm font-mono px-2 py-0.5 rounded-md bg-emerald-200 text-emerald-900';
        safetyGradeDesc.textContent = 'Controlled temperature and intact surface finish maintain chemical migration well below BfR and FDA thresholds.';
      }
    }

    function renderInertState() {
      hchoPpmDisplay.textContent = '0.0 mg/kg (PPM)';
      hchoBar.style.width = '0%';
      hchoLimitRatio.textContent = '0% (Non-Polymeric)';

      melaminePpmDisplay.textContent = '0.0 mg/kg (PPM)';
      melamineBar.style.width = '0%';
      melamineLimitRatio.textContent = '0% (Non-Polymeric)';

      hchoTdiDisplay.textContent = '0%';
      melamineTdiDisplay.textContent = '0%';

      const tempC = parseFloat(tempSlider.value);
      coreTempDisplay.textContent = `${tempC}°C`;
      crazingDisplay.textContent = 'Inert Glass/Ceramic';
      crystalRiskDisplay.textContent = 'NONE (0%)';
      crystalRiskDisplay.className = 'text-base font-extrabold mt-0.5 text-emerald-700';

      bfrBadge.textContent = 'EXEMPT (VITRIFIED)';
      bfrBadge.className = 'px-2.5 py-1 rounded-md text-[11px] font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800';

      fdaBadge.textContent = '100% MICROWAVE SAFE';
      fdaBadge.className = 'px-2.5 py-1 rounded-md text-[11px] font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800';

      safetyGradeCard.className = 'p-4 rounded-xl border border-emerald-300 bg-emerald-50 text-emerald-950 transition-colors';
      safetyGradeTitle.firstElementChild.textContent = '100% INERT';
      safetyGradeBadge.textContent = 'ZERO CHEMICAL LEACHING';
      safetyGradeBadge.className = 'text-sm font-mono px-2 py-0.5 rounded-md bg-emerald-200 text-emerald-900';
      safetyGradeDesc.textContent = 'Vitrified porcelain and borosilicate glass possess zero polymer crosslinks. Completely impervious to microwave radiation, acids, and thermal breakdown.';
    }

    // Attach Event Listeners
    materialSelect.addEventListener('change', calculateDiagnostics);
    foodSelect.addEventListener('change', calculateDiagnostics);
    tempSlider.addEventListener('input', calculateDiagnostics);
    wearSelect.addEventListener('change', calculateDiagnostics);
    weightSlider.addEventListener('input', calculateDiagnostics);
    cyanuricSelect.addEventListener('change', calculateDiagnostics);
    microwaveRadios.forEach(r => r.addEventListener('change', calculateDiagnostics));

    // Preset Buttons
    const presetBtns = document.querySelectorAll('.preset-btn');
    presetBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const p = btn.getAttribute('data-preset');
        if (p === 'ramen') {
          materialSelect.value = 'pure-melamine-resin';
          foodSelect.value = 'hot-chicken-bone-broth';
          tempSlider.value = '92';
          wearSelect.value = 'moderate-cutlery-scratches';
          weightSlider.value = '65';
          cyanuricSelect.value = 'low-trace';
          document.querySelector('input[name="microwaveMode"][value="no-microwave"]').checked = true;
        } else if (p === 'microwave') {
          materialSelect.value = 'pure-melamine-resin';
          foodSelect.value = 'acidic-tomato-soup';
          tempSlider.value = '75';
          wearSelect.value = 'moderate-cutlery-scratches';
          weightSlider.value = '65';
          cyanuricSelect.value = 'low-trace';
          document.querySelector('input[name="microwaveMode"][value="microwave-reheat-1min"]').checked = true;
        } else if (p === 'bamboo') {
          materialSelect.value = 'bamboo-melamine-composite';
          foodSelect.value = 'hot-citrus-tea-coffee';
          tempSlider.value = '88';
          wearSelect.value = 'scoured-dishwasher-abused';
          weightSlider.value = '60';
          cyanuricSelect.value = 'low-trace';
          document.querySelector('input[name="microwaveMode"][value="no-microwave"]').checked = true;
        } else if (p === 'salad') {
          materialSelect.value = 'pure-melamine-resin';
          foodSelect.value = 'chilled-salad-dressing';
          tempSlider.value = '15';
          wearSelect.value = 'brand-new';
          weightSlider.value = '65';
          cyanuricSelect.value = 'undetectable';
          document.querySelector('input[name="microwaveMode"][value="no-microwave"]').checked = true;
        } else if (p === 'baby') {
          materialSelect.value = 'pure-melamine-resin';
          foodSelect.value = 'warm-infant-formula';
          tempSlider.value = '55';
          wearSelect.value = 'moderate-cutlery-scratches';
          weightSlider.value = '8';
          cyanuricSelect.value = 'low-trace';
          document.querySelector('input[name="microwaveMode"][value="no-microwave"]').checked = true;
        } else if (p === 'porcelain') {
          materialSelect.value = 'safe-inert-porcelain-glass';
          foodSelect.value = 'acidic-tomato-soup';
          tempSlider.value = '95';
          wearSelect.value = 'brand-new';
          weightSlider.value = '65';
          cyanuricSelect.value = 'undetectable';
          document.querySelector('input[name="microwaveMode"][value="microwave-cook-3min"]').checked = true;
        }
        calculateDiagnostics();
      });
    });

    // Copy Assessment Report
    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        const text = `IsItKitchenSafe Diagnostic Assessment: Melamine Tableware Leaching
Material: ${materialSelect.options[materialSelect.selectedIndex].text}
Food Matrix: ${foodSelect.options[foodSelect.selectedIndex].text}
Temperature: ${tempSlider.value}°C
Formaldehyde Leaching: ${hchoPpmDisplay.textContent} (BfR Limit: 15.0 mg/kg)
Melamine Leaching: ${melaminePpmDisplay.textContent} (EU Limit: 2.5 mg/kg)
BfR Rec. XXII Status: ${bfrBadge.textContent.trim()}
FDA 21 CFR Status: ${fdaBadge.textContent.trim()}
Renal Cyanurate Risk: ${crystalRiskDisplay.textContent.trim()}
Verdict: ${safetyGradeTitle.firstElementChild.textContent.trim()} - ${safetyGradeDesc.textContent.trim()}
Full Tool: https://isitkitchensafe.com/tools/melamine-tableware-formaldehyde-modeler/`;

        navigator.clipboard.writeText(text).then(() => {
          const original = copyBtnText.textContent;
          copyBtnText.textContent = "✓ Copied!";
          setTimeout(() => {
            copyBtnText.textContent = original;
          }, 2500);
        });
      });
    }

    // Initial calculation on load
    calculateDiagnostics();
  })();
</script>
