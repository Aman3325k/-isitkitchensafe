<!-- Reactive Client-Side Simulation Script -->
<script define:vars={{ lipidData, d }}>
  document.addEventListener('DOMContentLoaded', () => {
    const oilSelect = document.getElementById('oil-select');
    const methodSelect = document.getElementById('method-select');
    const foodSelect = document.getElementById('food-select');
    const tempSlider = document.getElementById('temp-slider');
    const tempDisplay = document.getElementById('temp-display');
    const dwellSlider = document.getElementById('dwell-slider');
    const dwellDisplay = document.getElementById('dwell-display');
    const reuseSelect = document.getElementById('reuse-select');
    const portionSlider = document.getElementById('portion-slider');
    const portionDisplay = document.getElementById('portion-display');

    // Outputs
    const scoreNumber = document.getElementById('score-number');
    const scoreBadge = document.getElementById('score-badge');
    const scoreBar = document.getElementById('score-bar');
    const carcinogenGradeText = document.getElementById('carcinogen-grade-text');
    const valHneConc = document.getElementById('val-hne-conc');
    const valTotalHne = document.getElementById('val-total-hne');
    const valTotalMda = document.getElementById('val-total-mda');
    const valOilMass = document.getElementById('val-oil-mass');
    const valCaloricLoad = document.getElementById('val-caloric-load');
    const valTpc = document.getElementById('val-tpc');
    const tpcLegalStatus = document.getElementById('tpc-legal-status');
    const alertHeading = document.getElementById('alert-heading');
    const alertText = document.getElementById('alert-text');
    const alertBox = document.getElementById('alert-box');

    // Trade-off outputs
    const afHneConc = document.getElementById('af-hne-conc');
    const afOilAbsorbed = document.getElementById('af-oil-absorbed');
    const afNetDose = document.getElementById('af-net-dose');
    const afCalories = document.getElementById('af-calories');
    const dfHneConc = document.getElementById('df-hne-conc');
    const dfOilAbsorbed = document.getElementById('df-oil-absorbed');
    const dfNetDose = document.getElementById('df-net-dose');
    const dfCalories = document.getElementById('df-calories');

    // Buttons
    const copyReportBtn = document.getElementById('copy-report-btn');
    const copyBtnText = document.getElementById('copy-btn-text');
    const presetSafe = document.getElementById('preset-safe');
    const presetAbused = document.getElementById('preset-abused-deep-fryer');
    const presetPufa = document.getElementById('preset-air-fryer-pufa');
    const presetAvocado = document.getElementById('preset-high-heat-avocado');

    function calculate() {
      const selectedOilId = oilSelect.value;
      const selectedMethodId = methodSelect.value;
      const selectedFoodId = foodSelect.value;
      const tempC = parseInt(tempSlider.value, 10);
      const dwellMin = parseInt(dwellSlider.value, 10);
      const cycleNum = parseInt(reuseSelect.value, 10);
      const portionG = parseInt(portionSlider.value, 10);

      // Update slider badges
      const tempF = Math.round((tempC * 9 / 5) + 32);
      tempDisplay.textContent = `${tempC}°C (${tempF}°F)`;
      dwellDisplay.textContent = `${dwellMin} min`;
      portionDisplay.textContent = `${portionG} g`;

      // Lookup data objects
      const oil = lipidData.cookingOils.find(o => o.id === selectedOilId) || lipidData.cookingOils[0];
      const method = lipidData.cookingMethods.find(m => m.id === selectedMethodId) || lipidData.cookingMethods[0];
      const food = lipidData.foodSubstrates.find(f => f.id === selectedFoodId) || lipidData.foodSubstrates[0];
      const reuse = lipidData.reuseCycles.find(c => c.cycle === cycleNum) || lipidData.reuseCycles[0];

      // Kinetic modeling:
      // 1. Temperature factor: exponential acceleration above baseline 160°C
      const tempDelta = Math.max(0, tempC - 160);
      const tempMultiplier = Math.pow(1.055, tempDelta);

      // 2. Exceeding smoke point penalty
      const smokePointPenalty = tempC > oil.smokePointC ? (1 + (tempC - oil.smokePointC) * 0.04) : 1.0;

      // 3. Dwell factor
      const dwellMultiplier = dwellMin / 15.0;

      // 4. Method air convection flux factor
      const methodMultiplier = method.oxidationRateMultiplier;

      // 5. Oil chemical vulnerability factor
      let oilMultiplier = oil.relative4hneYield;

      // Polyphenol scavenging buffering: EVOO has 480 mg/kg polyphenols
      if (oil.polyphenolContentMgKg > 100 && dwellMin <= 25 && cycleNum <= 2) {
        oilMultiplier *= 0.55; // Quenches 45% of radical cascade
      }

      // 6. Reuse cycle accumulation factor
      const cycleMultiplier = reuse.peroxideAccumulationFactor;

      // Calculated 4-HNE concentration in oil (µg/g oil)
      const baseHne = 2.2;
      const hneConc = Math.max(0.1, baseHne * oilMultiplier * methodMultiplier * tempMultiplier * smokePointPenalty * cycleMultiplier * (dwellMultiplier * 0.7 + 0.3));

      // Calculated MDA concentration in oil (µg/g oil)
      const baseMda = 3.0;
      const mdaConc = Math.max(0.1, baseMda * oil.relativeMdaYield * methodMultiplier * tempMultiplier * smokePointPenalty * cycleMultiplier * (dwellMultiplier * 0.7 + 0.3));

      // Ingested oil mass calculation:
      let oilAbsorbedGrams = 0;
      if (method.id === 'air-fryer-convection') {
        oilAbsorbedGrams = (portionG / food.basePortionGrams) * food.airFryOilUsedGrams;
      } else if (method.id === 'submerged-deep-fryer') {
        oilAbsorbedGrams = (portionG / food.basePortionGrams) * food.deepFryOilAbsorbedGrams * reuse.viscosityIndex;
      } else if (method.id === 'shallow-pan-frying') {
        oilAbsorbedGrams = portionG * 0.075 * reuse.viscosityIndex;
      } else {
        // Convection oven
        oilAbsorbedGrams = portionG * 0.05;
      }

      // Total ingested aldehyde doses (µg)
      const totalHneDose = hneConc * oilAbsorbedGrams;
      const totalMdaDose = mdaConc * oilAbsorbedGrams;

      // Caloric load from oil (9 kcal/g)
      const netCalories = oilAbsorbedGrams * 9.0;

      // Estimated Peroxide Value (PV, meq O2/kg)
      const estimatedPv = Math.min(85, Math.max(2.5, 3.5 * methodMultiplier * tempMultiplier * cycleMultiplier * (dwellMin / 15)));

      // Total Polar Compounds (TPC %)
      const currentTpc = Math.min(48, Math.max(2.5, reuse.tpcPercent + (tempC > 190 ? (tempC - 190) * 0.15 : 0) + (dwellMin > 20 ? (dwellMin - 20) * 0.12 : 0)));

      // Overall Score Calculation (0 to 100)
      // Benchmarks: 4-HNE dose < 15 µg is optimal; > 60 µg is high; > 120 µg is dangerous
      let score = 100;
      score -= (totalHneDose * 0.45);
      score -= (totalMdaDose * 0.3);
      if (currentTpc > 24) score -= 25; // Exceeds EU statutory limit
      if (tempC > oil.smokePointC) score -= 15;
      score = Math.max(8, Math.min(100, Math.round(score)));

      // Render Outputs
      scoreNumber.textContent = score;
      valHneConc.textContent = `${hneConc.toFixed(1)} µg/g`;
      valTotalHne.textContent = `${totalHneDose.toFixed(1)} µg`;
      valTotalMda.textContent = `${totalMdaDose.toFixed(1)} µg`;
      valOilMass.textContent = `${oilAbsorbedGrams.toFixed(1)} g`;
      valCaloricLoad.textContent = `${Math.round(netCalories)} kcal`;
      valTpc.textContent = `${currentTpc.toFixed(1)}%`;

      scoreBar.style.width = `${score}%`;

      if (score >= 85) {
        scoreBar.className = 'h-full bg-emerald-500 transition-all duration-500 rounded-full';
        scoreBadge.className = 'px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800 border border-emerald-200';
        scoreBadge.textContent = 'Optimal Safety';
        carcinogenGradeText.innerHTML = `${d.carcinogenGradeLabel}: <strong class="text-emerald-700">Minimal Cytotoxic Risk</strong>`;
      } else if (score >= 65) {
        scoreBar.className = 'h-full bg-blue-500 transition-all duration-500 rounded-full';
        scoreBadge.className = 'px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-blue-100 text-blue-800 border border-blue-200';
        scoreBadge.textContent = 'Low-Moderate Risk';
        carcinogenGradeText.innerHTML = `${d.carcinogenGradeLabel}: <strong class="text-blue-700">Acceptable Dietary Exposure</strong>`;
      } else if (score >= 40) {
        scoreBar.className = 'h-full bg-amber-500 transition-all duration-500 rounded-full';
        scoreBadge.className = 'px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-100 text-amber-800 border border-amber-200';
        scoreBadge.textContent = 'Elevated Aldehydes';
        carcinogenGradeText.innerHTML = `${d.carcinogenGradeLabel}: <strong class="text-amber-800">Moderate Atherogenic Hazard</strong>`;
      } else {
        scoreBar.className = 'h-full bg-rose-500 transition-all duration-500 rounded-full';
        scoreBadge.className = 'px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-rose-100 text-rose-800 border border-rose-200';
        scoreBadge.textContent = 'Severe Cytotoxic Hazard';
        carcinogenGradeText.innerHTML = `${d.carcinogenGradeLabel}: <strong class="text-rose-700">Severe Cellular Toxicity &amp; Atherogenic Danger</strong>`;
      }

      // Legal status
      if (currentTpc > 24) {
        tpcLegalStatus.textContent = '⚠️ EXCEEDS EU 24% DISCARD LIMIT';
        tpcLegalStatus.className = 'text-[10px] text-rose-700 font-bold';
      } else {
        tpcLegalStatus.textContent = '✅ Complies with EU statutory limit';
        tpcLegalStatus.className = 'text-[10px] text-emerald-700 font-bold';
      }

      // Side-by-side comparison values
      const afModelOilMass = (portionG / food.basePortionGrams) * food.airFryOilUsedGrams;
      const dfModelOilMass = (portionG / food.basePortionGrams) * food.deepFryOilAbsorbedGrams * reuse.viscosityIndex;
      const afModelConc = baseHne * oilMultiplier * 2.8 * tempMultiplier * smokePointPenalty * (dwellMultiplier * 0.7 + 0.3);
      const dfModelConc = baseHne * oilMultiplier * 1.0 * tempMultiplier * smokePointPenalty * cycleMultiplier * (dwellMultiplier * 0.7 + 0.3);

      afHneConc.textContent = `${afModelConc.toFixed(1)} µg/g (${(afModelConc/dfModelConc > 1.2 ? 'Higher per gram' : 'Comparable')})`;
      afOilAbsorbed.textContent = `${afModelOilMass.toFixed(1)} g (~${Math.round((1 - afModelOilMass/dfModelOilMass)*100)}% reduction)`;
      afNetDose.textContent = `${(afModelConc * afModelOilMass).toFixed(1)} µg net 4-HNE`;
      afCalories.textContent = `${Math.round(afModelOilMass * 9)} kcal`;

      dfHneConc.textContent = `${dfModelConc.toFixed(1)} µg/g`;
      dfOilAbsorbed.textContent = `${dfModelOilMass.toFixed(1)} g (High absorption)`;
      dfNetDose.textContent = `${(dfModelConc * dfModelOilMass).toFixed(1)} µg net 4-HNE`;
      dfCalories.textContent = `${Math.round(dfModelOilMass * 9)} kcal`;

      // Alert box text
      if (currentTpc > 24) {
        alertBox.className = 'p-5 rounded-2xl bg-rose-50 border border-rose-200 text-rose-950';
        alertHeading.textContent = '🚨 Critical Safety Hazard: Reused Oil Exceeds Statutory Discard Limits';
        alertText.textContent = `This oil has reached ${currentTpc.toFixed(1)}% Total Polar Compounds, exceeding the European Union legal limit (24%–25%). Repeated deep-frying cycles have decomposed triglycerides into mutagenic polymer trimers, acrolein, and cytotoxic 4-HNE. Discard this oil immediately; do not cook food in it.`;
      } else if (tempC > oil.smokePointC) {
        alertBox.className = 'p-5 rounded-2xl bg-amber-50 border border-amber-200 text-amber-950';
        alertHeading.textContent = `⚠️ Temperature Warning: Exceeding Oil Smoke Point (${oil.smokePointC}°C / ${oil.smokePointF}°F)`;
        alertText.textContent = `Cooking ${oil.name} at ${tempC}°C exceeds its thermal smoke threshold by ${tempC - oil.smokePointC}°C. Pyrolysis of glycerol into choking acrolein vapor and rapid homolytic O-O bond scission of peroxides are actively occurring. Lower temperature below ${oil.smokePointC}°C or switch to Refined Avocado Oil (271°C) or Ghee (250°C).`;
      } else if (oil.fattyAcidProfile.pufaPercent > 50 && method.id === 'air-fryer-convection' && tempC >= 200) {
        alertBox.className = 'p-5 rounded-2xl bg-amber-50 border border-amber-200 text-amber-950';
        alertHeading.textContent = '⚠️ Convective PUFA Peroxidation Alert: High-Linoleic Oil in Air Fryer';
        alertText.textContent = `${oil.name} contains ${oil.fattyAcidProfile.pufaPercent}% polyunsaturated fatty acids. In an air fryer, high convective airflow (3 m/s) forces oxygen into the thin oil film, accelerating 4-HNE generation to ${hneConc.toFixed(1)} µg/g. Switch to Extra Virgin Olive Oil or High-Oleic Sunflower Oil to suppress aldehyde formation.`;
      } else if (score >= 85) {
        alertBox.className = 'p-5 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-950';
        alertHeading.textContent = '✅ Optimal Lipid Profile: Minimal Aldehyde Generation & Low Caloric Uptake';
        alertText.textContent = `Excellent culinary combination. The high monounsaturated or saturated fraction resists oxidative cleavage, keeping 4-HNE concentration low (${hneConc.toFixed(1)} µg/g) while air frying minimizes total ingested oil mass (${oilAbsorbedGrams.toFixed(1)} g).`;
      } else {
        alertBox.className = 'p-5 rounded-2xl bg-surface-soft border border-hairline text-ink';
        alertHeading.textContent = 'ℹ️ Moderate Aldehyde Exposure: Follow Best Practices';
        alertText.textContent = `Moderate lipid oxidation detected. Total ingested 4-HNE is ${totalHneDose.toFixed(1)} µg and Total Polar Compounds are at ${currentTpc.toFixed(1)}%. Drain cooked food on paper towels immediately to minimize capillary oil uptake.`;
      }
    }

    // Attach Event Listeners
    oilSelect.addEventListener('change', calculate);
    methodSelect.addEventListener('change', calculate);
    foodSelect.addEventListener('change', calculate);
    tempSlider.addEventListener('input', calculate);
    dwellSlider.addEventListener('input', calculate);
    reuseSelect.addEventListener('change', calculate);
    portionSlider.addEventListener('input', calculate);

    // Presets Handlers
    presetSafe.addEventListener('click', () => {
      oilSelect.value = 'extra-virgin-olive-oil';
      methodSelect.value = 'air-fryer-convection';
      foodSelect.value = 'russet-potato-fries';
      tempSlider.value = '180';
      dwellSlider.value = '15';
      reuseSelect.value = '1';
      portionSlider.value = '150';
      calculate();
    });

    presetAbused.addEventListener('click', () => {
      oilSelect.value = 'soybean-oil';
      methodSelect.value = 'submerged-deep-fryer';
      foodSelect.value = 'russet-potato-fries';
      tempSlider.value = '190';
      dwellSlider.value = '12';
      reuseSelect.value = '6';
      portionSlider.value = '150';
      calculate();
    });

    presetPufa.addEventListener('click', () => {
      oilSelect.value = 'standard-sunflower-oil';
      methodSelect.value = 'air-fryer-convection';
      foodSelect.value = 'russet-potato-fries';
      tempSlider.value = '210';
      dwellSlider.value = '25';
      reuseSelect.value = '1';
      portionSlider.value = '150';
      calculate();
    });

    presetAvocado.addEventListener('click', () => {
      oilSelect.value = 'refined-avocado-oil';
      methodSelect.value = 'air-fryer-convection';
      foodSelect.value = 'battered-chicken-nuggets';
      tempSlider.value = '200';
      dwellSlider.value = '18';
      reuseSelect.value = '1';
      portionSlider.value = '150';
      calculate();
    });

    // Copy Report Handler
    copyReportBtn.addEventListener('click', () => {
      const report = `=====================================================
ISITKITCHENSAFE LIPID OXIDATION & 4-HNE DIAGNOSTIC REPORT
Timestamp: ${new Date().toISOString()}
=====================================================
Cooking Oil:       ${oilSelect.options[oilSelect.selectedIndex].text}
Appliance Method:  ${methodSelect.options[methodSelect.selectedIndex].text}
Food Substrate:    ${foodSelect.options[foodSelect.selectedIndex].text}
Temperature:       ${tempDisplay.textContent}
Dwell Time:        ${dwellDisplay.textContent}
Oil Reuse History: ${reuseSelect.options[reuseSelect.selectedIndex].text}
Portion Size:      ${portionDisplay.textContent}

DIAGNOSTIC METRICS:
- Safety Rating:         ${scoreNumber.textContent} / 100 (${scoreBadge.textContent})
- 4-HNE in Oil:          ${valHneConc.textContent}
- Ingested 4-HNE Dose:   ${valTotalHne.textContent}
- Ingested MDA Dose:     ${valTotalMda.textContent}
- Absorbed Oil Mass:     ${valOilMass.textContent}
- Net Caloric Load:      ${valCaloricLoad.textContent}
- Total Polar Compounds: ${valTpc.textContent} (${tpcLegalStatus.textContent})

ASSESSMENT:
${alertHeading.textContent}
${alertText.textContent}
=====================================================
Calculated via IsItKitchenSafe Autonomous Growth & Ops Engine`;

      navigator.clipboard.writeText(report).then(() => {
        copyBtnText.textContent = d.reportCopied;
        setTimeout(() => {
          copyBtnText.textContent = d.copyReportBtn;
        }, 3000);
      });
    });

    // Initial calculation run
    calculate();
  });
</script>
