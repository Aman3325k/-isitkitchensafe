const d = dict[lang] || dict.en;
---

<div class="space-y-10 my-8" id="lipid-oxidation-modeler-container">
  <!-- Interactive Control Panel -->
  <div class="bg-surface-soft border border-hairline rounded-3xl p-6 md:p-8 shadow-xs">
    <div class="max-w-3xl mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-amber-100 text-amber-900 mb-3 border border-amber-200">
        <span>🍟</span>
        {d.badge}
      </div>
      <h2 class="text-2xl md:text-3xl font-extrabold text-ink tracking-tight mb-2">
        {d.controlsTitle}
      </h2>
      <p class="text-sm md:text-base text-body leading-relaxed">
        {d.controlsSub}
      </p>
    </div>

    <!-- Quick Presets -->
    <div class="mb-8 p-4 rounded-2xl bg-canvas border border-hairline">
      <div class="text-xs font-bold text-muted uppercase tracking-wider mb-3">
        {d.presetsTitle}
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5">
        <button 
          type="button" 
          id="preset-safe"
          class="px-3.5 py-2.5 rounded-xl bg-surface-soft hover:bg-emerald-50 hover:border-emerald-300 border border-hairline text-left transition-all text-xs font-medium text-ink flex items-center gap-2 group cursor-pointer"
        >
          <span class="text-base group-hover:scale-110 transition-transform">🏆</span>
          <span class="line-clamp-2">{d.presetSafe}</span>
        </button>
        <button 
          type="button" 
          id="preset-abused-deep-fryer"
          class="px-3.5 py-2.5 rounded-xl bg-surface-soft hover:bg-rose-50 hover:border-rose-300 border border-hairline text-left transition-all text-xs font-medium text-ink flex items-center gap-2 group cursor-pointer"
        >
          <span class="text-base group-hover:scale-110 transition-transform">⚠️</span>
          <span class="line-clamp-2">{d.presetAbusedDeepFryer}</span>
        </button>
        <button 
          type="button" 
          id="preset-air-fryer-pufa"
          class="px-3.5 py-2.5 rounded-xl bg-surface-soft hover:bg-amber-50 hover:border-amber-300 border border-hairline text-left transition-all text-xs font-medium text-ink flex items-center gap-2 group cursor-pointer"
        >
          <span class="text-base group-hover:scale-110 transition-transform">🌪️</span>
          <span class="line-clamp-2">{d.presetAirFryerPufa}</span>
        </button>
        <button 
          type="button" 
          id="preset-high-heat-avocado"
          class="px-3.5 py-2.5 rounded-xl bg-surface-soft hover:bg-teal-50 hover:border-teal-300 border border-hairline text-left transition-all text-xs font-medium text-ink flex items-center gap-2 group cursor-pointer"
        >
          <span class="text-base group-hover:scale-110 transition-transform">🥑</span>
          <span class="line-clamp-2">{d.presetHighHeatAvocado}</span>
        </button>
      </div>
    </div>

    <!-- Parameter Controls Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- 1. Oil Type -->
      <div class="space-y-2">
        <label for="oil-select" class="block text-xs font-bold uppercase tracking-wider text-ink">
          {d.oilLabel}
        </label>
        <select 
          id="oil-select" 
          class="w-full px-3.5 py-2.5 rounded-xl bg-canvas border border-hairline text-ink text-sm font-medium focus:outline-none focus:ring-2 focus:ring-amber-500 cursor-pointer"
        >
          {lipidData.cookingOils.map((oil) => (
            <option value={oil.id}>
              {oil.name} (MUFA: {oil.fattyAcidProfile.mufaPercent}% | PUFA: {oil.fattyAcidProfile.pufaPercent}%)
            </option>
          ))}
        </select>
        <p class="text-xs text-muted leading-relaxed" id="oil-help-text">
          {d.oilHelp}
        </p>
      </div>

      <!-- 2. Cooking Method -->
      <div class="space-y-2">
        <label for="method-select" class="block text-xs font-bold uppercase tracking-wider text-ink">
          {d.methodLabel}
        </label>
        <select 
          id="method-select" 
          class="w-full px-3.5 py-2.5 rounded-xl bg-canvas border border-hairline text-ink text-sm font-medium focus:outline-none focus:ring-2 focus:ring-amber-500 cursor-pointer"
        >
          {lipidData.cookingMethods.map((m) => (
            <option value={m.id}>
              {m.name}
            </option>
          ))}
        </select>
        <p class="text-xs text-muted leading-relaxed" id="method-help-text">
          {d.methodHelp}
        </p>
      </div>

      <!-- 3. Food Substrate -->
      <div class="space-y-2">
        <label for="food-select" class="block text-xs font-bold uppercase tracking-wider text-ink">
          {d.foodLabel}
        </label>
        <select 
          id="food-select" 
          class="w-full px-3.5 py-2.5 rounded-xl bg-canvas border border-hairline text-ink text-sm font-medium focus:outline-none focus:ring-2 focus:ring-amber-500 cursor-pointer"
        >
          {lipidData.foodSubstrates.map((f) => (
            <option value={f.id}>
              {f.name}
            </option>
          ))}
        </select>
        <p class="text-xs text-muted leading-relaxed">
          {d.foodHelp}
        </p>
      </div>

      <!-- 4. Cooking Temperature -->
      <div class="space-y-2">
        <div class="flex items-center justify-between">
          <label for="temp-slider" class="text-xs font-bold uppercase tracking-wider text-ink">
            {d.tempLabel}
          </label>
          <span class="text-xs font-mono font-bold text-amber-700 bg-amber-50 px-2 py-0.5 rounded-md border border-amber-200" id="temp-display">
            180°C (356°F)
          </span>
        </div>
        <input 
          type="range" 
          id="temp-slider" 
          min="140" 
          max="220" 
          step="5" 
          value="180" 
          class="w-full accent-amber-600 cursor-pointer"
        />
        <p class="text-xs text-muted leading-relaxed">
          {d.tempHelp}
        </p>
      </div>

      <!-- 5. Dwell Time -->
      <div class="space-y-2">
        <div class="flex items-center justify-between">
          <label for="dwell-slider" class="text-xs font-bold uppercase tracking-wider text-ink">
            {d.dwellLabel}
          </label>
