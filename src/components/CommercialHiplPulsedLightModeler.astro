<!-- Reactive Modeler Script -->
<script is:inline define:vars={{ hiplData, lang }}>
  (function() {
    // DOM Elements
    const machineSelect = document.getElementById('machine-select');
    const pathogenSelect = document.getElementById('pathogen-select');
    const quartzSelect = document.getElementById('quartz-select');
    const catalystSelect = document.getElementById('catalyst-select');

    const voltageRange = document.getElementById('voltage-range');
    const voltageVal = document.getElementById('voltage-val');
    const rateRange = document.getElementById('rate-range');
    const rateVal = document.getElementById('rate-val');
    const residenceRange = document.getElementById('residence-range');
    const residenceVal = document.getElementById('residence-val');
    const distanceRange = document.getElementById('distance-range');
    const distanceVal = document.getElementById('distance-val');
    const splashRange = document.getElementById('splash-range');
    const splashVal = document.getElementById('splash-val');
    const airflowRange = document.getElementById('airflow-range');
    const airflowVal = document.getElementById('airflow-val');

    const coolingToggle = document.getElementById('cooling-toggle');
    const interlockToggle = document.getElementById('interlock-toggle');

    const presetEgg = document.getElementById('preset-egg');
    const presetBottle = document.getElementById('preset-bottle');
    const presetBelt = document.getElementById('preset-belt');
    const presetCatastrophic = document.getElementById('preset-catastrophic');

    // Telemetry Elements
    const safetyBanner = document.getElementById('safety-banner');
    const safetyStatusText = document.getElementById('safety-status-text');
    const telemetryEnergy = document.getElementById('telemetry-energy');
    const telemetryPower = document.getElementById('telemetry-power');
    const telemetryFluence = document.getElementById('telemetry-fluence');
    const telemetryReduction = document.getElementById('telemetry-reduction');
    const telemetryTemp = document.getElementById('telemetry-temp');
    const telemetryShock = document.getElementById('telemetry-shock');
    const telemetryOzone = document.getElementById('telemetry-ozone');
    const telemetryShield = document.getElementById('telemetry-shield');

    const narrativeRisk = document.getElementById('narrative-risk');
    const narrativeMech = document.getElementById('narrative-mech');
    const narrativeMitigation = document.getElementById('narrative-mitigation');

    const copyReportBtn = document.getElementById('copy-report-btn');
    const copyBtnText = document.getElementById('copy-btn-text');

    const svgQuartz = document.getElementById('svg-quartz');
    const svgArc = document.getElementById('svg-arc');
    const svgRays = document.getElementById('svg-rays');

    function calculateModel() {
      if (!machineSelect || !pathogenSelect || !quartzSelect || !catalystSelect) return;

      const currentMachine = hiplData.hiplSystems.find(m => m.id === machineSelect.value) || hiplData.hiplSystems[0];
      const currentPathogen = hiplData.targetPathogens.find(p => p.id === pathogenSelect.value) || hiplData.targetPathogens[0];
      const currentQuartz = hiplData.quartzSleeveProfiles.find(q => q.id === quartzSelect.value) || hiplData.quartzSleeveProfiles[0];
      const currentCatalyst = hiplData.ozoneCatalystProfiles.find(c => c.id === catalystSelect.value) || hiplData.ozoneCatalystProfiles[0];

      const V = parseFloat(voltageRange.value);
      const repRate = parseFloat(rateRange.value);
      const residence = parseFloat(residenceRange.value);
      const distance = parseFloat(distanceRange.value);
      const splashT = parseFloat(splashRange.value);
      const airflow = parseFloat(airflowRange.value);

      const isCoolingActive = coolingToggle.checked;
      const isInterlockActive = interlockToggle.checked;

      // 1. Electrical Discharge Energy per pulse: E = 0.5 * C * V^2
      // Using effective capacitance based on machine class (80 to 220 uF)
      let C_effective = 120e-6; // 120 uF baseline
      if (currentMachine.id === 'ultra_high_fluence_aseptic') C_effective = 220e-6;
      else if (currentMachine.id === 'pilot_hipl_conveyor') C_effective = 80e-6;
      else if (currentMachine.id === 'compromised_degraded_hipl') C_effective = 90e-6;

      const E_discharge = 0.5 * C_effective * Math.pow(V, 2); // Joules
      const tau = currentMachine.pulseDurationMicroseconds * 1e-6; // seconds
      const P_peak_mw = (E_discharge / tau) / 1e6; // Megawatts

      // 2. Optical Transmission & Fluence
      const opticalEfficiency = 0.48; // 48% total optical
      const quartzTransmission = currentQuartz.uvcTransmittancePercent / 100.0;
      const distanceFactor = Math.pow(45.0 / Math.max(distance, 15.0), 1.25); // distance scaling
      
      const singlePulseFluence = (E_discharge * opticalEfficiency * quartzTransmission * distanceFactor) / (250.0 * 25.0); // J/cm2 approx
      const totalPulses = Math.round(repRate * residence);
      const cumulativeFluence = Math.min(18.0, singlePulseFluence * totalPulses);

      // 3. Microbial Inactivation Kinetics
      // Log(N0/N) = Fluence / D-value with non-linear shoulder & tailing
      const dVal = currentPathogen.dValueJcm2;
      let logReduction = (cumulativeFluence / dVal) * (1.0 - 0.08); // accounting for tailing
      logReduction = Math.max(0.1, Math.min(8.5, logReduction));

      // 4. Quartz Tube Temperature & Thermal Shock
      // Average thermal power = E_discharge * repRate * (1 - opticalEfficiency)
      const P_thermal_watts = E_discharge * repRate * 0.55;
      const heatTransferCoeff = isCoolingActive ? 220.0 : 25.0; // W/m2K
      const quartzSurfaceArea = 0.085; // m2 approx
      const ambientT = 22.0;

      let quartzTemp = ambientT + (P_thermal_watts / (heatTransferCoeff * quartzSurfaceArea));
      if (currentMachine.id === 'compromised_degraded_hipl') quartzTemp += 45.0;
      quartzTemp = Math.round(Math.min(380.0, quartzTemp));

      const deltaTShock = quartzTemp - splashT;
      const shockTolerance = currentQuartz.thermalShockToleranceDeltaC;
      const shockMargin = shockTolerance - deltaTShock;

      // 5. Ozone Photolysis & Exhaust Abatement
      // VUV production rate vs airflow
      let vuvProductionFactor = 1.0;
      if (currentQuartz.id === 'ozone_free_doped_quartz') vuvProductionFactor = 0.05; // 95% blocked
      else if (currentQuartz.id === 'compromised_solarized_quartz') vuvProductionFactor = 0.7;

      const rawOzoneGeneratedPpm = (P_thermal_watts * 0.018 * vuvProductionFactor) / (Math.max(airflow, 30.0) / 100.0);
      const catalystEfficiency = currentCatalyst.decompositionEfficiencyPercent / 100.0;
      let exhaustOzonePpm = rawOzoneGeneratedPpm * (1.0 - catalystEfficiency);
      exhaustOzonePpm = Math.max(0.005, exhaustOzonePpm);

      // 6. Optical Shielding & Interlock
      let shieldOd = isInterlockActive ? 8.4 : 1.4;
      if (currentMachine.id === 'compromised_degraded_hipl') shieldOd = 1.8;

      // Update UI Text
      voltageVal.textContent = `${V.toLocaleString()} V`;
      rateVal.textContent = `${repRate} Hz`;
      residenceVal.textContent = `${residence.toFixed(1)} s`;
      distanceVal.textContent = `${distance} mm`;
      splashVal.textContent = `${splashT} °C`;
      airflowVal.textContent = `${airflow} CFM`;

      telemetryEnergy.textContent = `${E_discharge.toFixed(1)} J`;
      telemetryPower.textContent = `${P_peak_mw.toFixed(2)} MW`;
      telemetryFluence.textContent = `${cumulativeFluence.toFixed(2)} J/cm²`;
      telemetryReduction.textContent = `${logReduction.toFixed(1)}-Log (${(100 - Math.pow(10, -logReduction)*100).toFixed(4)}%)`;
      telemetryTemp.textContent = `${quartzTemp} °C`;

      if (shockMargin >= 0) {
        telemetryShock.textContent = `+${shockMargin.toFixed(0)} °C Margin`;
        telemetryShock.className = 'font-mono text-base sm:text-lg font-extrabold text-emerald-600 dark:text-emerald-400';
      } else {
        telemetryShock.textContent = `FRACTURE (${shockMargin.toFixed(0)} °C)`;
        telemetryShock.className = 'font-mono text-base sm:text-lg font-extrabold text-rose-600 dark:text-rose-400 animate-pulse';
      }

      telemetryOzone.textContent = `${exhaustOzonePpm.toFixed(3)} ppm`;
      if (exhaustOzonePpm > 0.10) {
        telemetryOzone.className = 'font-mono text-base sm:text-lg font-extrabold text-rose-600 dark:text-rose-400';
      } else {
        telemetryOzone.className = 'font-mono text-base sm:text-lg font-extrabold text-emerald-600 dark:text-emerald-400';
      }

      telemetryShield.textContent = `OD ${shieldOd.toFixed(1)} (${shieldOd >= 6 ? 'Compliant' : 'Breach'})`;

      // Status Assessment
      const isFluenceCompliant = cumulativeFluence <= 12.0;
      const isPathogenMet = logReduction >= currentPathogen.targetLogReduction;
      const isShockSafe = shockMargin >= 0;
      const isOzoneSafe = exhaustOzonePpm <= 0.10;
      const isOpticalSafe = shieldOd >= 6.0;

      if (!isShockSafe) {
        safetyBanner.className = 'mb-6 p-4 rounded-xl border flex items-start gap-3 bg-rose-500/10 border-rose-500/30 text-rose-800 dark:text-rose-300';
        safetyStatusText.textContent = 'CRITICAL HAZARD - CATASTROPHIC QUARTZ TUBE THERMAL SHOCK SHATTER';
        narrativeRisk.textContent = `Thermal shock differential (ΔT = ${deltaTShock.toFixed(0)}°C) exceeds quartz tensile tolerance (${shockTolerance}°C). Cold washdown or condensate droplets will violently shatter the quartz envelope over food items!`;
        narrativeMitigation.textContent = 'Immediately activate high-velocity vortex cooling air, raise quartz temperature safety limits, or install NSF-certified shatter containment mesh.';
      } else if (!isOzoneSafe) {
        safetyBanner.className = 'mb-6 p-4 rounded-xl border flex items-start gap-3 bg-rose-500/10 border-rose-500/30 text-rose-800 dark:text-rose-300';
        safetyStatusText.textContent = 'TOXIC HAZARD - EXHAUST OZONE EXCEEDS OSHA PERMISSIBLE EXPOSURE LIMIT (PEL)';
        narrativeRisk.textContent = `Exhaust ozone (${exhaustOzonePpm.toFixed(3)} ppm) violates OSHA 8-hr TWA (0.10 ppm). Saturated catalyst or insufficient ventilation poses severe occupational respiratory health hazards.`;
        narrativeMitigation.textContent = 'Replace Carulite catalyst cartridge, increase exhaust duct airflow to ≥ 350 CFM, or switch to titanium-doped ozone-free quartz sleeves.';
      } else if (!isOpticalSafe) {
        safetyBanner.className = 'mb-6 p-4 rounded-xl border flex items-start gap-3 bg-amber-500/10 border-amber-500/30 text-amber-800 dark:text-amber-300';
        safetyStatusText.textContent = 'OPTICAL SAFETY BREACH - CLASS 3B/4 FLASH RADIATION LEAKAGE';
        narrativeRisk.textContent = 'Optical labyrinth baffles warped or electrical interlocks bypassed (OD < 6). Intense microsecond UV/VIS flash presents severe photokeratitis and retinal burn risks to operators.';
        narrativeMitigation.textContent = 'Engage dual-channel safety interlocks, verify capacitor auto-dump circuits (< 50V in 2s), and inspect infeed/outfeed optical labyrinth seals.';
      } else if (!isFluenceCompliant) {
        safetyBanner.className = 'mb-6 p-4 rounded-xl border flex items-start gap-3 bg-amber-500/10 border-amber-500/30 text-amber-800 dark:text-amber-300';
        safetyStatusText.textContent = 'REGULATORY WARNING - CUMULATIVE FLUENCE EXCEEDS FDA 21 CFR § 179.41 (12.0 J/cm²)';
        narrativeRisk.textContent = `Cumulative radiant fluence (${cumulativeFluence.toFixed(2)} J/cm²) exceeds the federal statutory ceiling of 12.0 J/cm², risking sensory lipid oxidation and regulatory non-compliance.`;
        narrativeMitigation.textContent = 'Increase conveyor speed to reduce optical residence time or lower xenon flash discharge voltage.';
      } else if (!isPathogenMet) {
        safetyBanner.className = 'mb-6 p-4 rounded-xl border flex items-start gap-3 bg-amber-500/10 border-amber-500/30 text-amber-800 dark:text-amber-300';
        safetyStatusText.textContent = `SUB-LETHAL SANITIZATION - ${currentPathogen.targetLogReduction}-LOG TARGET NOT MET (${logReduction.toFixed(1)}-LOG)`;
        narrativeRisk.textContent = `Current fluence (${cumulativeFluence.toFixed(2)} J/cm²) achieves only ${logReduction.toFixed(1)}-log kill of ${currentPathogen.name}, failing process validation targets.`;
        narrativeMitigation.textContent = 'Increase flash repetition rate (Hz), increase discharge voltage, or reduce conveyor line speed.';
      } else {
        safetyBanner.className = 'mb-6 p-4 rounded-xl border flex items-start gap-3 bg-emerald-500/10 border-emerald-500/30 text-emerald-800 dark:text-emerald-300';
        safetyStatusText.textContent = 'OPTIMAL - FULLY COMPLIANT WITH FDA 21 CFR § 179.41, OSHA 1910 & NFPA 79';
        narrativeRisk.textContent = 'Zero safety violations. Excellent germicidal lethality (> 5-log kill), robust quartz thermal shock margin, exhaust ozone < 0.05 ppm, and complete optical flash containment.';
        narrativeMitigation.textContent = 'Maintain scheduled Carulite 200 catalyst replacement and periodic Suprasil quartz sleeve transmission spectrometer audits.';
      }

      // Update SVG Visuals
      if (svgQuartz) {
        if (!isShockSafe) {
          svgQuartz.setAttribute('stroke', '#f43f5e');
          svgQuartz.setAttribute('fill', 'rgba(244, 63, 94, 0.3)');
        } else {
          svgQuartz.setAttribute('stroke', '#38bdf8');
          svgQuartz.setAttribute('fill', 'rgba(56, 189, 248, 0.15)');
        }
      }

      if (svgArc) {
        const arcWidth = Math.max(3, Math.min(10, Math.round(P_peak_mw * 2)));
        svgArc.setAttribute('stroke-width', arcWidth.toString());
      }

      if (svgRays) {
        svgRays.style.opacity = Math.min(1.0, 0.4 + (cumulativeFluence / 12.0) * 0.6).toString();
      }
    }

    // Presets
    if (presetEgg) {
      presetEgg.addEventListener('click', () => {
        machineSelect.value = 'commercial_industrial_hipl';
        pathogenSelect.value = 'salmonella_enterica';
        quartzSelect.value = 'synthetic_fused_silica';
        catalystSelect.value = 'carulite_mno2_cuo';
        voltageRange.value = '2900';
        rateRange.value = '15';
        residenceRange.value = '4.5';
        distanceRange.value = '35';
        splashRange.value = '18';
        airflowRange.value = '380';
        coolingToggle.checked = true;
        interlockToggle.checked = true;
        calculateModel();
      });
    }

    if (presetBottle) {
      presetBottle.addEventListener('click', () => {
        machineSelect.value = 'ultra_high_fluence_aseptic';
        pathogenSelect.value = 'aspergillus_niger_spores';
        quartzSelect.value = 'ozone_free_doped_quartz';
        catalystSelect.value = 'carulite_mno2_cuo';
        voltageRange.value = '3400';
        rateRange.value = '18';
        residenceRange.value = '3.0';
        distanceRange.value = '25';
        splashRange.value = '20';
        airflowRange.value = '450';
        coolingToggle.checked = true;
        interlockToggle.checked = true;
        calculateModel();
      });
    }

    if (presetBelt) {
      presetBelt.addEventListener('click', () => {
        machineSelect.value = 'commercial_industrial_hipl';
        pathogenSelect.value = 'listeria_monocytogenes';
        quartzSelect.value = 'synthetic_fused_silica';
        catalystSelect.value = 'carulite_mno2_cuo';
        voltageRange.value = '2600';
        rateRange.value = '10';
        residenceRange.value = '5.0';
        distanceRange.value = '40';
        splashRange.value = '15';
        airflowRange.value = '320';
        coolingToggle.checked = true;
        interlockToggle.checked = true;
        calculateModel();
      });
    }

    if (presetCatastrophic) {
      presetCatastrophic.addEventListener('click', () => {
        machineSelect.value = 'compromised_degraded_hipl';
        pathogenSelect.value = 'bacillus_subtilis_endospores';
        quartzSelect.value = 'compromised_solarized_quartz';
        catalystSelect.value = 'exhausted_bypass_filter';
        voltageRange.value = '3800';
        rateRange.value = '20';
        residenceRange.value = '15.0';
        distanceRange.value = '90';
        splashRange.value = '10';
        airflowRange.value = '60';
        coolingToggle.checked = false;
        interlockToggle.checked = false;
        calculateModel();
      });
    }

    // Attach Event Listeners
    [machineSelect, pathogenSelect, quartzSelect, catalystSelect].forEach(el => {
      if (el) el.addEventListener('change', calculateModel);
    });

    [voltageRange, rateRange, residenceRange, distanceRange, splashRange, airflowRange].forEach(el => {
      if (el) el.addEventListener('input', calculateModel);
    });

    [coolingToggle, interlockToggle].forEach(el => {
      if (el) el.addEventListener('change', calculateModel);
    });

    // Copy Report
    if (copyReportBtn) {
      copyReportBtn.addEventListener('click', () => {
        const text = `=== ISITKITCHENSAFE HIPL PHOTONIC DECONTAMINATION TELEMETRY REPORT ===
System: ${machineSelect.options[machineSelect.selectedIndex].text}
Pathogen: ${pathogenSelect.options[pathogenSelect.selectedIndex].text}
Quartz Sleeve: ${quartzSelect.options[quartzSelect.selectedIndex].text}
Ozone Catalyst: ${catalystSelect.options[catalystSelect.selectedIndex].text}
Discharge Voltage: ${voltageRange.value} V | Rep Rate: ${rateRange.value} Hz | Residence: ${residenceRange.value} s
Single-Pulse Energy: ${telemetryEnergy.textContent} | Peak Flash Power: ${telemetryPower.textContent}
Cumulative Fluence: ${telemetryFluence.textContent} (FDA Limit: <= 12.0 J/cm²)
Pathogen Inactivation: ${telemetryReduction.textContent}
Quartz Surface Temp: ${telemetryTemp.textContent} | Thermal Shock Margin: ${telemetryShock.textContent}
Exhaust Ozone: ${telemetryOzone.textContent} (OSHA PEL: <= 0.10 ppm)
Optical Shielding: ${telemetryShield.textContent}
Status: ${safetyStatusText.textContent}
Mechanisms: ${narrativeMech.textContent}
Generated: ${new Date().toISOString()}
================================================================================`;
        navigator.clipboard.writeText(text).then(() => {
          if (copyBtnText) copyBtnText.textContent = 'Report Copied!';
          setTimeout(() => {
            if (copyBtnText) copyBtnText.textContent = 'Copy Telemetry Report';
          }, 2500);
        });
      });
    }

    // Initialize
    calculateModel();
  })();
</script>
