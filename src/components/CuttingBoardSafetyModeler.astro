<script is:inline define:vars={{ boardData, d }}>
(function() {
  function initCuttingBoardModeler() {
    const root = document.getElementById('cutting-board-modeler-app');
    if (!root) return;

    // Elements
    const materialSelect = document.getElementById('cb-material-select');
    const wearSelect = document.getElementById('cb-wear-select');
    const knifeSelect = document.getElementById('cb-knife-select');
    const techniqueSelect = document.getElementById('cb-technique-select');
    const chopsSlider = document.getElementById('cb-chops-slider');
    const chopsVal = document.getElementById('cb-chops-val');
    const foodSelect = document.getElementById('cb-food-select');
    const followUpSelect = document.getElementById('cb-followup-select');
    const haccpSelect = document.getElementById('cb-haccp-select');
    const sanitizeSelect = document.getElementById('cb-sanitize-select');

    // Outputs
    const scoreNum = document.getElementById('cb-score-num');
    const statusCard = document.getElementById('cb-status-card');
    const statusTitle = document.getElementById('cb-status-title');
    const statusDesc = document.getElementById('cb-status-desc');
    const particlesVal = document.getElementById('cb-particles-val');
    const particlesBenchmark = document.getElementById('cb-particles-benchmark');
    const massVal = document.getElementById('cb-mass-val');
    const cardEquiv = document.getElementById('cb-card-equiv');
    const depthVal = document.getElementById('cb-depth-val');
    const depthStatus = document.getElementById('cb-depth-status');
    const biofilmVal = document.getElementById('cb-biofilm-val');
    const biofilmStatus = document.getElementById('cb-biofilm-status');
    const crossRiskVal = document.getElementById('cb-cross-risk-val');
    const riskPill = document.getElementById('cb-risk-pill');
    const warningBox = document.getElementById('cb-warning-box');
    const warningText = document.getElementById('cb-warning-text');
    const copyReportBtn = document.getElementById('cb-copy-report-btn');
    const copyBtnText = document.getElementById('cb-copy-btn-text');

    // Lookup Maps
    const materialMap = {};
    boardData.boardMaterials.forEach(m => { materialMap[m.id] = m; });
    const wearMap = {};
    boardData.wearLevels.forEach(w => { wearMap[w.id] = w; });
    const knifeMap = {};
    boardData.knifeSteels.forEach(k => { knifeMap[k.id] = k; });
    const techniqueMap = {};
    boardData.cuttingTechniques.forEach(t => { techniqueMap[t.id] = t; });
    const foodMap = {};
    boardData.foodTypes.forEach(f => { foodMap[f.id] = f; });
    const sanitizeMap = {};
    boardData.sanitizationMethods.forEach(s => { sanitizeMap[s.id] = s; });
    const presetMap = {};
    boardData.presets.forEach(p => { presetMap[p.id] = p; });

    function recalculate() {
      const mat = materialMap[materialSelect?.value || 'polypropylene'] || boardData.boardMaterials[0];
      const wear = wearMap[wearSelect?.value || 'moderate-wear'] || boardData.wearLevels[1];
      const knife = knifeMap[knifeSelect?.value || 'german-forged'] || boardData.knifeSteels[0];
      const tech = techniqueMap[techniqueSelect?.value || 'up-down-chop'] || boardData.cuttingTechniques[0];
      const chops = parseInt(chopsSlider?.value || '400', 10);
      const food = foodMap[foodSelect?.value || 'raw-poultry'] || boardData.foodTypes[0];
      const followUp = foodMap[followUpSelect?.value || 'ready-to-eat-salad'] || boardData.foodTypes[4];
      const haccp = haccpSelect?.value === 'true';
      const sanitize = sanitizeMap[sanitizeSelect?.value || 'sponge-cold-water'] || boardData.sanitizationMethods[0];

      if (chopsVal) {
        chopsVal.textContent = `${chops} chops/day`;
      }

      // 1. Microplastic Release Calculations
      // Base: particle count per 100 chops * wear factor * knife shear multiplier * technique multiplier
      const basePartPer100 = mat.particleCountPer100Chops;
      const baseMassPer100 = mat.microplasticMassPer100ChopsMg;

      const dailyPart = (basePartPer100 * (chops / 100)) * wear.microplasticSheddingFactor * knife.shearingAggressivenessMultiplier * tech.microplasticGenerationMultiplier;
      const dailyMassMg = (baseMassPer100 * (chops / 100)) * wear.microplasticSheddingFactor * knife.shearingAggressivenessMultiplier * tech.microplasticGenerationMultiplier;

      const annualParticlesMillions = ((dailyPart * 365) / 1000000).toFixed(1);
      const annualMassGrams = ((dailyMassMg * 365) / 1000).toFixed(1);
      const creditCards = (parseFloat(annualMassGrams) / 5.0).toFixed(1); // Standard credit card is 5g of PVC/plastic

      // 2. Micro-groove Depth
      const effectiveDepthUm = Math.round(wear.creviceDepthUm * (knife.hardnessHRC / 56) * (tech.downwardForceN / 20));

      // 3. Biofilm Persistence After Sanitation
      // Base shelter factor of material and wear, reduced by sanitize kill efficiency
      const rawSurvival = (100 - sanitize.pathogenKillEfficiencyPct);
      let effectiveBiofilmPersistence = 0;
      if (mat.antimicrobialCapillaryAction) {
        // Hardwood capillary lysis reduces bacterial load by 99%
        effectiveBiofilmPersistence = Math.round(rawSurvival * 0.1);
      } else if (mat.id === 'tempered-glass') {
        effectiveBiofilmPersistence = Math.round(rawSurvival * 0.05);
      } else {
        effectiveBiofilmPersistence = Math.min(98, Math.round(rawSurvival * (wear.bacteriaShelterFactor / 4.0)));
      }

      // 4. Cross-Contamination Foodborne Infection Hazard
      let crossRiskGrade = 'LOW';
      let crossRiskColor = 'text-emerald-700';
      let riskPillText = 'Safe Sequence';
      let riskPillClass = 'bg-emerald-100 text-emerald-900 border-emerald-200';

      const isRawMeatInitial = (food.id === 'raw-poultry' || food.id === 'raw-beef-pork' || food.id === 'raw-seafood');
      const isReadyToEatFollowUp = (followUp.id === 'ready-to-eat-salad' || followUp.id === 'bread-cheese');

      if (haccp) {
        crossRiskGrade = 'CONTROLLED (HACCP Separated)';
        crossRiskColor = 'text-emerald-700';
        riskPillText = 'Dedicated Board Clean';
        riskPillClass = 'bg-emerald-100 text-emerald-900 border-emerald-200';
      } else if (isRawMeatInitial && isReadyToEatFollowUp) {
        if (sanitize.id === 'bleach-immersion' || sanitize.id === 'peroxide-vinegar' || (mat.antimicrobialCapillaryAction && sanitize.id === 'wood-mineral-oil-wash')) {
          crossRiskGrade = 'MODERATE (Sanitized Surface)';
          crossRiskColor = 'text-amber-700';
          riskPillText = 'Chemical Kill-Step Applied';
          riskPillClass = 'bg-amber-100 text-amber-900 border-amber-200';
        } else {
          crossRiskGrade = 'CRITICAL FOOD POISONING HAZARD';
          crossRiskColor = 'text-rose-700';
          riskPillText = '⚠️ Extreme Cross-Contamination';
          riskPillClass = 'bg-rose-100 text-rose-900 border-rose-200';
        }
      } else if (isRawMeatInitial) {
        crossRiskGrade = 'ELEVATED (Meat Residue Present)';
        crossRiskColor = 'text-amber-700';
        riskPillText = 'Cooked Heat-Step Required';
        riskPillClass = 'bg-amber-100 text-amber-900 border-amber-200';
      } else {
        crossRiskGrade = 'LOW (Non-Meat Inoculum)';
        crossRiskColor = 'text-emerald-700';
        riskPillText = 'Standard Produce Prep';
        riskPillClass = 'bg-emerald-100 text-emerald-900 border-emerald-200';
      }

      // 5. Overall Biosecurity & Safety Score (0 to 100)
      let score = 100;
      // Deductions for microplastics
      if (parseFloat(annualMassGrams) > 20) score -= 30;
      else if (parseFloat(annualMassGrams) > 5) score -= 15;
      else if (parseFloat(annualMassGrams) > 0.5) score -= 5;

      // Deductions for cross contamination
      if (crossRiskGrade.includes('CRITICAL')) score -= 45;
      else if (crossRiskGrade.includes('ELEVATED')) score -= 20;
      else if (crossRiskGrade.includes('MODERATE')) score -= 10;

      // Deductions for deep furrows & biofilm
      if (effectiveDepthUm > 500) score -= 15;
      else if (effectiveDepthUm > 200) score -= 8;

      if (effectiveBiofilmPersistence > 60) score -= 15;
      else if (effectiveBiofilmPersistence > 30) score -= 8;

      score = Math.max(5, Math.min(99, score));

      // UI Updates
      if (scoreNum) scoreNum.textContent = score.toString();
      if (particlesVal) particlesVal.textContent = mat.particleCountPer100Chops === 0 ? '0' : `${annualParticlesMillions} M`;
      if (particlesBenchmark) particlesBenchmark.textContent = mat.particleCountPer100Chops === 0 ? 'Zero Plastic' : 'particles / person / year';
      if (massVal) massVal.textContent = mat.microplasticMassPer100ChopsMg === 0 ? '0.0 g' : `${annualMassGrams} g`;
      if (cardEquiv) cardEquiv.textContent = mat.microplasticMassPer100ChopsMg === 0 ? '✓ Zero Synthetic Ingestion' : `≈ ${creditCards} Credit Cards / Year`;
      if (depthVal) depthVal.textContent = `${effectiveDepthUm} µm`;
      if (depthStatus) depthStatus.textContent = effectiveDepthUm > 250 ? 'Exceeds sponge bristle reach' : 'Shallow wash reach';
      if (biofilmVal) biofilmVal.textContent = `${effectiveBiofilmPersistence}%`;
      if (biofilmStatus) biofilmStatus.textContent = effectiveBiofilmPersistence > 50 ? 'High pathogen survival' : 'Low pathogen survival';

      if (crossRiskVal) {
        crossRiskVal.textContent = crossRiskGrade;
        crossRiskVal.className = `text-sm md:text-base font-black font-mono ${crossRiskColor}`;
      }
      if (riskPill) {
        riskPill.textContent = riskPillText;
        riskPill.className = `text-xs font-mono font-bold px-2.5 py-1 rounded border ${riskPillClass}`;
      }

      // Status Card Theme
      if (statusCard && statusTitle && statusDesc) {
        if (score >= 80) {
          statusCard.className = 'rounded-2xl p-6 border transition-all bg-emerald-50 border-emerald-300';
          statusTitle.textContent = 'EXCELLENT: MINIMAL MICROPLASTICS & COMPLETE BIOSECURITY';
          statusTitle.className = 'text-sm font-extrabold text-emerald-950 mb-1';
          statusDesc.textContent = 'Hardwood capillary desiccation or strict HACCP board separation ensures zero cross-contamination and negligible microplastic consumption.';
          if (scoreNum) scoreNum.className = 'text-4xl md:text-5xl font-black font-mono text-emerald-800';
        } else if (score >= 50) {
          statusCard.className = 'rounded-2xl p-6 border transition-all bg-amber-50 border-amber-300';
          statusTitle.textContent = 'SUBOPTIMAL: ELEVATED MICROPLASTICS OR WEAK CLEANING BARRIER';
          statusTitle.className = 'text-sm font-extrabold text-amber-950 mb-1';
          statusDesc.textContent = 'Plastic board furrows are shedding synthetic particles into food or harboring bacteria due to insufficient sanitation dwell times.';
          if (scoreNum) scoreNum.className = 'text-4xl md:text-5xl font-black font-mono text-amber-800';
        } else {
          statusCard.className = 'rounded-2xl p-6 border transition-all bg-rose-50 border-rose-300';
          statusTitle.textContent = 'CRITICAL HAZARD: HIGH PATHOGEN RETENTION & MICROPLASTIC SHEDDING';
          statusTitle.className = 'text-sm font-extrabold text-rose-950 mb-1';
          statusDesc.textContent = 'Active cross-contamination pathway detected between raw meat and ready-to-eat food on a worn polymer board. Millions of microplastics ingested annually.';
          if (scoreNum) scoreNum.className = 'text-4xl md:text-5xl font-black font-mono text-rose-800';
        }
      }

      // Warning Box Content
      if (warningBox && warningText) {
        if (!haccp && isRawMeatInitial && isReadyToEatFollowUp && sanitize.id === 'sponge-cold-water') {
          warningBox.classList.remove('hidden');
          warningBox.className = 'rounded-xl p-4 border transition-all bg-rose-50 border-rose-300 text-rose-950 text-xs leading-relaxed space-y-1 block';
          warningText.textContent = 'CRITICAL CROSS-CONTAMINATION INFECTION ALERT: Preparing ready-to-eat salad on the same scarred plastic board previously used for raw chicken—without high-temp sanitation or dedicated board separation—is the #1 cause of domestic Salmonella and Campylobacter enteritis. Cellulose sponges spread bacteria across the surface rather than cleaning crevices.';
        } else if (knife.id === 'serrated-utility' && (mat.id === 'polypropylene' || mat.id === 'hdpe' || mat.id === 'ldpe-flexible-mat')) {
          warningBox.classList.remove('hidden');
          warningBox.className = 'rounded-xl p-4 border transition-all bg-amber-50 border-amber-300 text-amber-950 text-xs leading-relaxed space-y-1 block';
          warningText.textContent = 'MICROPLASTIC SHREDDING ALERT: Using a serrated bread/utility knife on a plastic cutting board saws through polymer chains, multiplying microplastic particle shedding by 340%. Switch to a smooth-edge chef knife or a wooden cutting board.';
        } else if (wear.id === 'heavily-gouged') {
          warningBox.classList.remove('hidden');
          warningBox.className = 'rounded-xl p-4 border transition-all bg-rose-50 border-rose-300 text-rose-950 text-xs leading-relaxed space-y-1 block';
          warningText.textContent = 'BOARD RETIREMENT REQUIRED: Knife furrows exceeding 500 µm with gray/black discoloration harbor permanent extracellular polymeric biofilms that resist domestic dishwasher and bleach sanitation. This board should be discarded immediately.';
        } else {
          warningBox.classList.add('hidden');
        }
      }
    }

    // Apply Presets
    function applyPreset(presetId) {
      const preset = presetMap[presetId];
      if (!preset) return;

      if (materialSelect) materialSelect.value = preset.boardMaterial;
      if (wearSelect) wearSelect.value = preset.wearLevel;
      if (knifeSelect) knifeSelect.value = preset.knifeSteel;
      if (techniqueSelect) techniqueSelect.value = preset.cuttingTechnique;
      if (chopsSlider) chopsSlider.value = preset.dailyChopCount.toString();
      if (foodSelect) foodSelect.value = preset.foodType;
      if (followUpSelect) followUpSelect.value = preset.followUpPrep;
      if (haccpSelect) haccpSelect.value = preset.colorCodingSeparation ? 'true' : 'false';
      if (sanitizeSelect) sanitizeSelect.value = preset.sanitization;

      recalculate();
    }

    // Event Listeners
    [materialSelect, wearSelect, knifeSelect, techniqueSelect, foodSelect, followUpSelect, haccpSelect, sanitizeSelect].forEach(el => {
      if (el) el.addEventListener('change', recalculate);
    });

    if (chopsSlider) {
      chopsSlider.addEventListener('input', recalculate);
    }

    document.querySelectorAll('.cb-preset-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        const pId = this.getAttribute('data-preset');
        if (pId) applyPreset(pId);
      });
    });

    // Copy Forensic Report
    if (copyReportBtn) {
      copyReportBtn.addEventListener('click', function() {
        const mat = materialMap[materialSelect?.value]?.name || 'Board';
        const wear = wearMap[wearSelect?.value]?.name || 'Wear';
        const knife = knifeMap[knifeSelect?.value]?.name || 'Knife';
        const chops = chopsSlider?.value || '400';
        const score = scoreNum?.textContent || '0';
        const part = particlesVal?.textContent || '0';
        const mass = massVal?.textContent || '0';
        const cards = cardEquiv?.textContent || '0';
        const depth = depthVal?.textContent || '0';
        const bio = biofilmVal?.textContent || '0';
        const risk = crossRiskVal?.textContent || 'N/A';

        const report = `=====================================================
ISITKITCHENSAFE CUTTING BOARD BIOSECURITY & MICROPLASTIC DIAGNOSTIC
=====================================================
Board Material: ${mat}
Surface Wear Level: ${wear}
Knife Alloy & Grind: ${knife}
Daily Blade Strokes: ${chops} chops/day
HACCP Board Segregation: ${haccpSelect.value === 'true' ? 'YES (Dedicated Color-Coded)' : 'NO (Reused Board)'}
Sanitization Method: ${sanitizeMap[sanitizeSelect.value]?.name || 'Wash'}

POLYMER TRIBOLOGY & MICROBIOLOGY TELEMETRY:
- Biosecurity Safety Score: ${score} / 100
- Annual Microplastic Particle Ingestion: ${part}
- Annual Ingested Plastic Mass: ${mass} (${cards})
- Micro-Groove Furrow Depth: ${depth}
- Bacterial Biofilm Persistence: ${bio}
- Pathogen Cross-Contamination Risk: ${risk}

SCIENTIFIC STANDARDS: ACS ES&T 2023 (Yadav et al.) & UC Davis Food Safety (Ak & Cliver)
URL: https://isitkitchensafe.com/tools/cutting-board-microplastic-pathogen-analyzer/
=====================================================`;

        navigator.clipboard.writeText(report).then(() => {
          if (copyBtnText) copyBtnText.textContent = d.reportCopied;
          setTimeout(() => {
            if (copyBtnText) copyBtnText.textContent = d.copyReportBtn;
          }, 3000);
        });
      });
    }

    // Initial calculation
    recalculate();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCuttingBoardModeler);
  } else {
    initCuttingBoardModeler();
  }
})();
</script>
