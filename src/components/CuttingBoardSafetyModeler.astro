const d = dict[lang] || dict.en;
---

<div class="bg-surface border border-hairline rounded-2xl p-6 md:p-8 shadow-xs my-8" id="cutting-board-modeler-app">
  <!-- Component Header -->
  <div class="border-b border-hairline/60 pb-6 mb-8">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-rose-100 text-rose-900 mb-3">
      <span>🔬</span>
      {d.badge}
    </div>
    <h2 class="text-2xl md:text-3xl font-extrabold text-ink tracking-tight mb-2">
      {d.title}
    </h2>
    <p class="text-sm md:text-base text-body leading-relaxed max-w-4xl">
      {d.subtitle}
    </p>
  </div>

  <!-- Quick Presets Bar -->
  <div class="mb-8 p-4 bg-surface-soft border border-hairline rounded-xl">
    <div class="text-xs font-bold uppercase tracking-wider text-muted mb-3 flex items-center gap-2">
      <span>⚡</span>
      {d.presetsTitle}
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2">
      <button 
        type="button" 
        class="cb-preset-btn text-left p-2.5 rounded-lg border border-hairline bg-surface hover:bg-rose-50 hover:border-rose-300 transition-colors text-xs font-medium text-ink"
        data-preset="preset-cross-contamination-nightmare"
      >
        <span class="block font-bold text-rose-700 mb-0.5">⚠️ {d.presetCrossContam}</span>
        <span class="text-[11px] text-muted block leading-snug">Worn PP + Chicken + Salad</span>
      </button>

      <button 
        type="button" 
        class="cb-preset-btn text-left p-2.5 rounded-lg border border-hairline bg-surface hover:bg-amber-50 hover:border-amber-300 transition-colors text-xs font-medium text-ink"
        data-preset="preset-heavy-prep-microplastics"
      >
        <span class="block font-bold text-amber-700 mb-0.5">⚙️ {d.presetMicroplastics}</span>
        <span class="text-[11px] text-muted block leading-snug">HDPE + Serrated + Root Veg</span>
      </button>

      <button 
        type="button" 
        class="cb-preset-btn text-left p-2.5 rounded-lg border border-hairline bg-surface hover:bg-emerald-50 hover:border-emerald-300 transition-colors text-xs font-medium text-ink"
        data-preset="preset-chef-wood-haccp"
      >
        <span class="block font-bold text-emerald-700 mb-0.5">🛡️ {d.presetChefWood}</span>
        <span class="text-[11px] text-muted block leading-snug">End-Grain Maple + Forged + HACCP</span>
      </button>

      <button 
        type="button" 
        class="cb-preset-btn text-left p-2.5 rounded-lg border border-hairline bg-surface hover:bg-orange-50 hover:border-orange-300 transition-colors text-xs font-medium text-ink"
        data-preset="preset-budget-mat-shredder"
      >
        <span class="block font-bold text-orange-700 mb-0.5">📉 {d.presetBudgetMat}</span>
        <span class="text-[11px] text-muted block leading-snug">Thin LDPE Sheet + Dull Stamped</span>
      </button>
    </div>
  </div>

  <!-- Interactive Controls Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-10">
    <!-- Controls Column (7 Cols) -->
    <div class="lg:col-span-7 space-y-6">
      <div class="border-b border-hairline/60 pb-3">
        <h3 class="text-base font-bold text-ink flex items-center gap-2">
          <span>🎛️</span>
          {d.controlsTitle}
        </h3>
        <p class="text-xs text-muted mt-1">{d.controlsSub}</p>
      </div>

      <!-- Control 1: Board Material -->
      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5" for="cb-material-select">
          {d.materialLabel}
        </label>
        <select id="cb-material-select" class="w-full text-xs md:text-sm p-2.5 rounded-xl border border-hairline bg-surface-soft text-ink font-medium focus:outline-none focus:ring-2 focus:ring-rose-500">
          {boardData.boardMaterials.map(m => (
            <option value={m.id} selected={m.id === 'polypropylene'}>
              {m.name} ({m.hardnessScale})
            </option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1">{d.materialHelp}</p>
      </div>

      <!-- Control 2: Board Wear Level -->
      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5" for="cb-wear-select">
          {d.wearLabel}
        </label>
        <select id="cb-wear-select" class="w-full text-xs md:text-sm p-2.5 rounded-xl border border-hairline bg-surface-soft text-ink font-medium focus:outline-none focus:ring-2 focus:ring-rose-500">
          {boardData.wearLevels.map(w => (
            <option value={w.id} selected={w.id === 'moderate-wear'}>
              {w.name} — Crevice Depth: ~{w.creviceDepthUm} µm
            </option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1">{d.wearHelp}</p>
      </div>

      <!-- Control 3: Knife Steel & Blade Type -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5" for="cb-knife-select">
            {d.knifeLabel}
          </label>
          <select id="cb-knife-select" class="w-full text-xs md:text-sm p-2.5 rounded-xl border border-hairline bg-surface-soft text-ink font-medium focus:outline-none focus:ring-2 focus:ring-rose-500">
            {boardData.knifeSteels.map(k => (
              <option value={k.id} selected={k.id === 'german-forged'}>
                {k.name} ({k.hardnessHRC} HRC)
              </option>
            ))}
          </select>
          <p class="text-[11px] text-muted mt-1">{d.knifeHelp}</p>
        </div>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5" for="cb-technique-select">
            {d.techniqueLabel}
          </label>
          <select id="cb-technique-select" class="w-full text-xs md:text-sm p-2.5 rounded-xl border border-hairline bg-surface-soft text-ink font-medium focus:outline-none focus:ring-2 focus:ring-rose-500">
            {boardData.cuttingTechniques.map(t => (
              <option value={t.id} selected={t.id === 'up-down-chop'}>
                {t.name} ({t.downwardForceN}N Force)
              </option>
            ))}
          </select>
          <p class="text-[11px] text-muted mt-1">{d.techniqueHelp}</p>
        </div>
      </div>

      <!-- Control 4: Daily Chop Count Slider -->
      <div>
        <div class="flex items-center justify-between mb-1.5">
          <label class="text-xs font-bold uppercase tracking-wider text-ink" for="cb-chops-slider">
            {d.chopsLabel}
          </label>
          <span class="text-xs font-mono font-bold text-rose-700" id="cb-chops-val">400 chops/day</span>
        </div>
        <input 
          type="range" 
          id="cb-chops-slider" 
          min="50" 
          max="1500" 
          step="50" 
          value="400" 
          class="w-full h-2 bg-surface-strong rounded-lg appearance-none cursor-pointer accent-rose-600"
        />
        <div class="flex justify-between text-[10px] text-muted mt-1 font-mono">
          <span>50 (Minimal)</span>
          <span>400 (Standard Family)</span>
          <span>1,500 (Heavy Prep)</span>
        </div>
        <p class="text-[11px] text-muted mt-1">{d.chopsHelp}</p>
      </div>

      <!-- Control 5: Food Sequence & Cross-Contamination Path -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5" for="cb-food-select">
            {d.foodLabel}
          </label>
          <select id="cb-food-select" class="w-full text-xs md:text-sm p-2.5 rounded-xl border border-hairline bg-surface-soft text-ink font-medium focus:outline-none focus:ring-2 focus:ring-rose-500">
            {boardData.foodTypes.map(f => (
              <option value={f.id} selected={f.id === 'raw-poultry'}>
                {f.name} ({f.crossContaminationHazard})
              </option>
            ))}
          </select>
          <p class="text-[11px] text-muted mt-1">{d.foodHelp}</p>
        </div>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5" for="cb-followup-select">
            {d.followUpLabel}
          </label>
          <select id="cb-followup-select" class="w-full text-xs md:text-sm p-2.5 rounded-xl border border-hairline bg-surface-soft text-ink font-medium focus:outline-none focus:ring-2 focus:ring-rose-500">
            {boardData.foodTypes.map(f => (
              <option value={f.id} selected={f.id === 'ready-to-eat-salad'}>
                {f.name}
              </option>
            ))}
          </select>
          <p class="text-[11px] text-muted mt-1">{d.followUpHelp}</p>
        </div>
      </div>

      <!-- Control 6: HACCP Segregation & Sanitation -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5" for="cb-haccp-select">
            {d.haccpLabel}
          </label>
          <select id="cb-haccp-select" class="w-full text-xs md:text-sm p-2.5 rounded-xl border border-hairline bg-surface-soft text-ink font-medium focus:outline-none focus:ring-2 focus:ring-rose-500">
            <option value="false" selected>{d.haccpNo}</option>
            <option value="true">{d.haccpYes}</option>
          </select>
          <p class="text-[11px] text-muted mt-1">{d.haccpHelp}</p>
        </div>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5" for="cb-sanitize-select">
            {d.sanitizeLabel}
          </label>
          <select id="cb-sanitize-select" class="w-full text-xs md:text-sm p-2.5 rounded-xl border border-hairline bg-surface-soft text-ink font-medium focus:outline-none focus:ring-2 focus:ring-rose-500">
            {boardData.sanitizationMethods.map(s => (
              <option value={s.id} selected={s.id === 'sponge-cold-water'}>
                {s.name} ({s.pathogenKillEfficiencyPct}% Kill)
              </option>
            ))}
          </select>
          <p class="text-[11px] text-muted mt-1">{d.sanitizeHelp}</p>
        </div>
      </div>
    </div>

    <!-- Live Telemetry & Output Column (5 Cols) -->
    <div class="lg:col-span-5 space-y-6">
      <div class="border-b border-hairline/60 pb-3">
        <h3 class="text-base font-bold text-ink flex items-center gap-2">
          <span>📊</span>
          {d.diagnosticTitle}
        </h3>
        <p class="text-xs text-muted mt-1">{d.diagnosticSub}</p>
      </div>

      <!-- Overall Status Banner -->
      <div id="cb-status-card" class="rounded-2xl p-6 border transition-all bg-rose-50 border-rose-300">
        <div class="flex items-center justify-between gap-4 mb-2">
