const d = DICTIONARY[lang] || DICTIONARY.en;
---

<div class="bg-canvas border border-hairline rounded-3xl p-6 md:p-8 my-8 shadow-sm" id="conveyor-broiler-modeler">
  <!-- Header Badge -->
  <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-rose-900/10 text-rose-700 dark:text-rose-400 border border-rose-500/20">
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z" />
      </svg>
      {d.badge}
    </span>
    <span class="text-xs text-muted font-mono">NFPA 96 &bull; UL 197 &bull; SCAQMD 1138</span>
  </div>

  <h2 class="text-2xl md:text-3xl font-bold text-ink tracking-tight mb-3">
    {d.title}
  </h2>
  <p class="text-sm md:text-base text-muted leading-relaxed mb-8">
    {d.subtitle}
  </p>

  <!-- Presets Selection Bar -->
  <div class="bg-surface-soft border border-hairline rounded-2xl p-4 md:p-5 mb-8">
    <div class="text-xs font-bold uppercase tracking-wider text-muted mb-3">
      {d.presetsTitle}
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5">
      <button 
        type="button" 
        id="preset-btn-compliant"
        class="text-left px-3.5 py-2.5 rounded-xl border border-emerald-500/30 bg-emerald-50/50 dark:bg-emerald-950/20 hover:bg-emerald-100/50 dark:hover:bg-emerald-900/30 transition-all text-xs font-medium text-emerald-900 dark:text-emerald-300 flex flex-col gap-1 cursor-pointer"
      >
        <span class="font-bold flex items-center gap-1">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          {d.presetCompliant}
        </span>
        <span class="text-[11px] text-muted">Clean Pt/Pd Honeycomb &bull; 900 CFM Hood &bull; 0.04" Backpressure</span>
      </button>

      <button 
        type="button" 
        id="preset-btn-warning"
        class="text-left px-3.5 py-2.5 rounded-xl border border-amber-500/30 bg-amber-50/50 dark:bg-amber-950/20 hover:bg-amber-100/50 dark:hover:bg-amber-900/30 transition-all text-xs font-medium text-amber-900 dark:text-amber-300 flex flex-col gap-1 cursor-pointer"
      >
        <span class="font-bold flex items-center gap-1">
          <span class="w-2 h-2 rounded-full bg-amber-500"></span>
          {d.presetChokeWarning}
        </span>
        <span class="text-[11px] text-muted">45% Honeycomb Soot &bull; High Grease &bull; 0.22" Backpressure</span>
      </button>

      <button 
        type="button" 
        id="preset-btn-flash"
        class="text-left px-3.5 py-2.5 rounded-xl border border-rose-500/40 bg-rose-50/50 dark:bg-rose-950/20 hover:bg-rose-100/50 dark:hover:bg-rose-900/30 transition-all text-xs font-medium text-rose-900 dark:text-rose-300 flex flex-col gap-1 cursor-pointer"
      >
        <span class="font-bold flex items-center gap-1">
          <span class="w-2 h-2 rounded-full bg-rose-500 animate-pulse"></span>
          {d.presetAutoignitionFlash}
        </span>
        <span class="text-[11px] text-muted">75% Clog &bull; 350 CFM Blower Fail &bull; ΔT ≤ 0°C Flashover</span>
      </button>

      <button 
        type="button" 
        id="preset-btn-sintering"
        class="text-left px-3.5 py-2.5 rounded-xl border border-purple-500/30 bg-purple-50/50 dark:bg-purple-950/20 hover:bg-purple-100/50 dark:hover:bg-purple-900/30 transition-all text-xs font-medium text-purple-900 dark:text-purple-300 flex flex-col gap-1 cursor-pointer"
      >
        <span class="font-bold flex items-center gap-1">
          <span class="w-2 h-2 rounded-full bg-purple-500"></span>
          {d.presetThermalSintering}
        </span>
        <span class="text-[11px] text-muted">Core Temp &gt; 800°C &bull; Washcoat Nanoparticle Agglomeration</span>
      </button>
    </div>
  </div>

  <!-- Engineering Configuration Controls -->
  <div class="bg-surface-soft border border-hairline rounded-2xl p-5 md:p-6 mb-8">
    <div class="border-b border-hairline/60 pb-3 mb-5">
      <h3 class="text-base font-bold text-ink">
        {d.controlsTitle}
      </h3>
      <p class="text-xs text-muted">
        {d.controlsSub}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 mb-6">
      <!-- Broiler Architecture Dropdown -->
      <div>
        <label for="broiler-select" class="block text-xs font-bold text-ink mb-1.5">
          {d.broilerLabel}
        </label>
        <select 
          id="broiler-select" 
          class="w-full bg-canvas border border-hairline rounded-xl px-3 py-2 text-xs text-ink focus:outline-hidden focus:ring-2 focus:ring-rose-500/30 font-medium"
        >
          {broilerData.broilerModels.map((b) => (
            <option value={b.id}>{b.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1 leading-tight">{d.broilerHelp}</p>
      </div>

      <!-- Meat Patty Formulation Dropdown -->
      <div>
        <label for="patty-select" class="block text-xs font-bold text-ink mb-1.5">
          {d.pattyLabel}
        </label>
        <select 
          id="patty-select" 
          class="w-full bg-canvas border border-hairline rounded-xl px-3 py-2 text-xs text-ink focus:outline-hidden focus:ring-2 focus:ring-rose-500/30 font-medium"
        >
          {broilerData.pattyGreaseProfiles.map((p) => (
            <option value={p.id}>{p.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1 leading-tight">{d.pattyHelp}</p>
      </div>

      <!-- Catalyst Honeycomb Condition Dropdown -->
      <div>
        <label for="catalyst-select" class="block text-xs font-bold text-ink mb-1.5">
          {d.catalystLabel}
        </label>
        <select 
          id="catalyst-select" 
