<script is:inline define:vars={{ broilerData, lang }}>
  (function() {
    const root = document.getElementById('conveyor-broiler-modeler');
    if (!root) return;

    // Elements
    const broilerSelect = root.querySelector('#broiler-select');
    const pattySelect = root.querySelector('#patty-select');
    const catalystSelect = root.querySelector('#catalyst-select');
    const airflowSelect = root.querySelector('#airflow-select');
    const metallurgySelect = root.querySelector('#metallurgy-select');

    const throughputSlider = root.querySelector('#throughput-slider');
    const throughputVal = root.querySelector('#throughput-val');
    const hoursSlider = root.querySelector('#hours-slider');
    const hoursVal = root.querySelector('#hours-val');
    const backpressureSlider = root.querySelector('#backpressure-slider');
    const backpressureVal = root.querySelector('#backpressure-val');
    const burnerSlider = root.querySelector('#burner-slider');
    const burnerVal = root.querySelector('#burner-val');

    const presetCompliant = root.querySelector('#preset-btn-compliant');
    const presetWarning = root.querySelector('#preset-btn-warning');
    const presetFlash = root.querySelector('#preset-btn-flash');
    const presetSintering = root.querySelector('#preset-btn-sintering');

    const complianceBadge = root.querySelector('#compliance-badge');
    const metricCoreTemp = root.querySelector('#metric-core-temp');
    const metricCoreTempF = root.querySelector('#metric-core-temp-f');
    const metricCoreStatus = root.querySelector('#metric-core-status');
    const metricBackpressure = root.querySelector('#metric-backpressure');
    const metricBackpressurePa = root.querySelector('#metric-backpressure-pa');
    const metricBackpressureStatus = root.querySelector('#metric-backpressure-status');
    const metricDestruction = root.querySelector('#metric-destruction');
    const metricDestructionStatus = root.querySelector('#metric-destruction-status');
    const metricMargin = root.querySelector('#metric-margin');
    const metricFlueTemp = root.querySelector('#metric-flue-temp');
    const metricMarginStatus = root.querySelector('#metric-margin-status');
    const metricCo = root.querySelector('#metric-co');
    const metricCoStatus = root.querySelector('#metric-co-status');
    const metricAcrolein = root.querySelector('#metric-acrolein');
    const metricAcroleinStatus = root.querySelector('#metric-acrolein-status');

    const diagPrimaryRisk = root.querySelector('#diag-primary-risk');
    const diagPrimaryDesc = root.querySelector('#diag-primary-desc');
    const diagMechanismsTitle = root.querySelector('#diag-mechanisms-title');
    const diagMechanismsDesc = root.querySelector('#diag-mechanisms-desc');
    const diagMitigationTitle = root.querySelector('#diag-mitigation-title');
    const diagMitigationDesc = root.querySelector('#diag-mitigation-desc');

    const copyBtn = root.querySelector('#copy-telemetry-btn');
    const copyBtnText = root.querySelector('#copy-btn-text');

    function calculate() {
      const bId = broilerSelect.value;
      const pId = pattySelect.value;
      const cId = catalystSelect.value;
      const aId = airflowSelect.value;
      const mId = metallurgySelect.value;

      const broiler = broilerData.broilerModels.find(x => x.id === bId) || broilerData.broilerModels[0];
      const patty = broilerData.pattyGreaseProfiles.find(x => x.id === pId) || broilerData.pattyGreaseProfiles[0];
      const catalyst = broilerData.catalystStates.find(x => x.id === cId) || broilerData.catalystStates[0];
      const airflow = broilerData.exhaustAirflowClasses.find(x => x.id === aId) || broilerData.exhaustAirflowClasses[0];
      const metallurgy = broilerData.catalystWashcoatMetallurgies.find(x => x.id === mId) || broilerData.catalystWashcoatMetallurgies[0];

      const throughput = parseFloat(throughputSlider.value);
      const hours = parseFloat(hoursSlider.value);
      const measuredBackpressure = parseFloat(backpressureSlider.value);
      const burnerMod = parseFloat(burnerSlider.value);

      // Slider display text
      throughputVal.textContent = `${throughput} patties/hr`;
      hoursVal.textContent = `${hours.toFixed(1)} hrs`;
      backpressureVal.textContent = `${measuredBackpressure.toFixed(2)}" w.g.`;
      burnerVal.textContent = `${burnerMod}% Fire`;

      // Kinetics calculations
      // 1. Grease mass aerosolization (kg/hr)
      const lipidKgPerHour = throughput * (patty.lipidLossPerPattyG * (patty.aerosolizationRatePercent / 100)) / 1000;
      
      // 2. Combustion and catalytic heat release
      const burnerHeatKw = (broiler.burnerBtuHr * (burnerMod / 100)) * 0.000293071;
      const maxConversion = (metallurgy.vocDestructionRatePercent / 100) * catalyst.conversionEfficiencyFactor;
      const actualConversion = Math.max(0.15, Math.min(0.99, maxConversion * (1 - (hours * 0.012))));
      
      // Exothermic temperature rise in core
      // Lipid heat of combustion ~ 39.5 MJ/kg
      const exothermicKw = (lipidKgPerHour / 3600) * 39500 * actualConversion;
      const airMassFlowKgS = (airflow.effectiveCfm * 0.000471947) * 1.18; // density ~ 1.18 kg/m3
      const cpFlue = 1.05; // kJ/kg.K
      const deltaTExothermic = exothermicKw / (airMassFlowKgS * cpFlue);

      // Core Temperature (°C)
      let coreTempC = broiler.cleanCoreTempC * (burnerMod / 100) + deltaTExothermic * 0.65;
      if (catalyst.occlusionPercent > 30) {
        // heat accumulation due to flow restriction
        coreTempC += (catalyst.occlusionPercent - 30) * 2.2;
      }
      if (airflow.effectiveCfm < 800) {
        coreTempC += (800 - airflow.effectiveCfm) * 0.22;
      }
      coreTempC = Math.round(coreTempC);
      const coreTempF = Math.round(coreTempC * 9 / 5 + 32);

      // Flue static backpressure (in. w.g.)
      let computedBackpressure = measuredBackpressure * catalyst.backpressureMultiplier * Math.pow(throughput / broiler.maxPattiesPerHour, 1.2) * (1000 / airflow.effectiveCfm);
      computedBackpressure = Math.max(measuredBackpressure, Math.min(0.65, computedBackpressure));
      const backpressurePa = Math.round(computedBackpressure * 249.0889);

      // Flue gas exit temperature (downstream of catalyst)
      const flueGasTempC = Math.round(coreTempC * 0.62 + (1 - (airflow.effectiveCfm / 1600)) * 95);
      const autoignitionMargin = Math.round(patty.autoignitionTempC - flueGasTempC);

      // Destruction efficiency percentage
      const destructionPct = (actualConversion * 100).toFixed(1);

      // Carbon monoxide concentration (PPM)
      let coPpm = Math.round(15 + (1 - (metallurgy.coOxidationRatePercent / 100)) * 120);
      if (computedBackpressure > broiler.maxAllowedBackpressureInWg) {
        coPpm += Math.round((computedBackpressure - broiler.maxAllowedBackpressureInWg) * 600);
      }
      if (burnerMod > 90) coPpm += 20;

      // Acrolein concentration (PPM)
      let acroleinPpm = (0.02 + (lipidKgPerHour * 0.015) * (1 - actualConversion)).toFixed(2);

      // Update Diagnostic UI
      metricCoreTemp.textContent = `${coreTempC}°C`;
      metricCoreTempF.textContent = `${coreTempF}°F`;
      metricBackpressure.textContent = `${computedBackpressure.toFixed(2)}"`;
      metricBackpressurePa.textContent = `${backpressurePa} Pa`;
      metricDestruction.textContent = `${destructionPct}%`;
      metricMargin.textContent = autoignitionMargin >= 0 ? `+${autoignitionMargin}°C` : `${autoignitionMargin}°C`;
      metricFlueTemp.textContent = `Flue: ${flueGasTempC}°C (Ignite: ${patty.autoignitionTempC}°C)`;
      metricCo.textContent = `${coPpm} ppm`;
      metricAcrolein.textContent = `${acroleinPpm} ppm`;

      // Status colors & text
      // Autoignition margin
      if (autoignitionMargin <= 0) {
        metricMargin.className = "text-lg md:text-xl font-mono font-bold text-rose-600 dark:text-rose-400 animate-pulse";
        metricMarginStatus.textContent = "AUTOIGNITION FLASHOVER";
        metricMarginStatus.className = "text-[10px] font-bold text-rose-600 dark:text-rose-400";
      } else if (autoignitionMargin < 35) {
        metricMargin.className = "text-lg md:text-xl font-mono font-bold text-amber-600 dark:text-amber-400";
        metricMarginStatus.textContent = "Critical Proximity";
        metricMarginStatus.className = "text-[10px] font-bold text-amber-600 dark:text-amber-400";
      } else {
        metricMargin.className = "text-lg md:text-xl font-mono font-bold text-emerald-600 dark:text-emerald-400";
        metricMarginStatus.textContent = "Safe Margin";
        metricMarginStatus.className = "text-[10px] font-medium text-emerald-600 dark:text-emerald-400";
      }

      // Core temp status
      if (coreTempC >= 800) {
        metricCoreStatus.textContent = "Thermal Sintering (>800°C)";
        metricCoreStatus.className = "text-[10px] font-bold text-rose-600 dark:text-rose-400";
      } else if (coreTempC >= 650) {
        metricCoreStatus.textContent = "High Thermal Stress";
        metricCoreStatus.className = "text-[10px] font-bold text-amber-600 dark:text-amber-400";
      } else {
        metricCoreStatus.textContent = "Optimal Reaction Range";
        metricCoreStatus.className = "text-[10px] font-medium text-emerald-600 dark:text-emerald-400";
      }

      // Backpressure status
      if (computedBackpressure > broiler.maxAllowedBackpressureInWg * 1.5) {
        metricBackpressureStatus.textContent = "Severe Flame Choke";
        metricBackpressureStatus.className = "text-[10px] font-bold text-rose-600 dark:text-rose-400";
      } else if (computedBackpressure > broiler.maxAllowedBackpressureInWg) {
        metricBackpressureStatus.textContent = "Above NFPA Max Draft";
        metricBackpressureStatus.className = "text-[10px] font-bold text-amber-600 dark:text-amber-400";
      } else {
        metricBackpressureStatus.textContent = "Draft Balanced";
        metricBackpressureStatus.className = "text-[10px] font-medium text-emerald-600 dark:text-emerald-400";
      }

      // Compliance Badge & Diagnosis Texts
      if (autoignitionMargin <= 0 || computedBackpressure >= 0.35 || coreTempC >= 850) {
        complianceBadge.textContent = "EMERGENCY SHUTDOWN REQUIRED";
        complianceBadge.className = "px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-rose-500/20 text-rose-600 dark:text-rose-400 border border-rose-500/40 animate-pulse";

        diagPrimaryRisk.textContent = "Catastrophic Duct Flash Fire & Incomplete Combustion Runaway";
        diagPrimaryRisk.className = "text-sm font-bold text-rose-600 dark:text-rose-400 mb-1";
        diagPrimaryDesc.textContent = `Flue gas temperature (${flueGasTempC}°C) has reached or exceeded the grease aerosol autoignition temperature (${patty.autoignitionTempC}°C). Unburned lipid droplets entering the exhaust duct will autoignite spontaneously, creating an immediate fire hazard under NFPA 96.`;

        diagMechanismsTitle.textContent = "Thermal Choke & Vapor-Phase Deflagration";
        diagMechanismsDesc.textContent = `Choked honeycomb channels (backpressure: ${computedBackpressure.toFixed(2)}" w.g.) restrict flue gas discharge while concentrated lipid vapors undergo rapid adiabatic thermal acceleration, triggering spontaneous gas-phase deflagration.`;

        diagMitigationTitle.textContent = "Immediate Burner Lockout & Ansul Armed";
        diagMitigationDesc.textContent = "Immediately cut primary gas supply. Ensure kitchen exhaust hood remains running to purge smoke. Prepare Ansul R-102 fire suppression system and do not open broiler hoods.";
      } else if (computedBackpressure > broiler.maxAllowedBackpressureInWg || coreTempC > 650 || autoignitionMargin < 40) {
        complianceBadge.textContent = "NFPA 96 CAUTION / SERVICE REQUIRED";
        complianceBadge.className = "px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-500/20 text-amber-600 dark:text-amber-400 border border-amber-500/40";

        diagPrimaryRisk.textContent = "Flue Backpressure Thermal Choke & Soot Glaze";
        diagPrimaryRisk.className = "text-sm font-bold text-amber-600 dark:text-amber-400 mb-1";
        diagPrimaryDesc.textContent = `Static backpressure (${computedBackpressure.toFixed(2)}" w.g.) exceeds equipment limit (${broiler.maxAllowedBackpressureInWg}" w.g.). Partial honeycomb cell fouling is shifting gas flames rich, elevating CO (${coPpm} ppm) and acrolein.`;

        diagMechanismsTitle.textContent = "Darcy-Weisbach Porous Flow Boundary Decoupling";
        diagMechanismsDesc.textContent = "Cell occlusion increases channel Reynolds number, driving turbulent backpressure and reducing oxygen entrainment at the primary gas burner inspirator.";

        diagMitigationTitle.textContent = "Mandatory 20-Min Burnout & Manometer Audit";
        diagMitigationDesc.textContent = "Perform high-temperature burnout cycle at end of shift. Inspect exhaust duct grease buildup and clean baffle filters to restore nominal CFM.";
      } else {
        complianceBadge.textContent = "NFPA 96 & SCAQMD 1138 COMPLIANT";
        complianceBadge.className = "px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20";

        diagPrimaryRisk.textContent = "Normal Catalytic Operation &bull; Low Fire Risk";
        diagPrimaryRisk.className = "text-sm font-bold text-ink mb-1";
        diagPrimaryDesc.textContent = `Operating parameters within safe operating envelope. Autoignition safety margin is +${autoignitionMargin}°C, and destruction efficiency is ${destructionPct}%, meeting EPA Method 5G mandates.`;

        diagMechanismsTitle.textContent = "Optimal Heterogeneous Catalytic Oxidation";
        diagMechanismsDesc.textContent = "Platinum-palladium active crystallite sites efficiently convert volatile lipid hydrocarbons and carbon monoxide into carbon dioxide and clean steam.";

        diagMitigationTitle.textContent = "Routine Maintenance Protocol";
        diagMitigationDesc.textContent = "Maintain regular daily burnout cycle and schedule quarterly ultrasonic chemical bath immersion to prevent inorganic ash sintering.";
      }
    }

    // Event Listeners
    [broilerSelect, pattySelect, catalystSelect, airflowSelect, metallurgySelect].forEach(sel => {
      sel.addEventListener('change', calculate);
    });

    [throughputSlider, hoursSlider, backpressureSlider, burnerSlider].forEach(sld => {
      sld.addEventListener('input', calculate);
    });

    // Presets
    presetCompliant.addEventListener('click', () => {
      broilerSelect.value = 'high_volume_fast_food';
      pattySelect.value = 'standard_80_20_beef';
      catalystSelect.value = 'factory_clean';
      airflowSelect.value = 'code_compliant_nominal';
      metallurgySelect.value = 'standard_pt_pd_alumina';
      throughputSlider.value = '650';
      hoursSlider.value = '4';
      backpressureSlider.value = '0.04';
      burnerSlider.value = '80';
      calculate();
    });

    presetWarning.addEventListener('click', () => {
      broilerSelect.value = 'high_volume_fast_food';
      pattySelect.value = 'premium_75_25_chuck';
      catalystSelect.value = 'moderate_thermal_choke';
      airflowSelect.value = 'restricted_grease_coated';
      metallurgySelect.value = 'standard_pt_pd_alumina';
      throughputSlider.value = '950';
      hoursSlider.value = '14';
      backpressureSlider.value = '0.20';
      burnerSlider.value = '90';
      calculate();
    });

    presetFlash.addEventListener('click', () => {
      broilerSelect.value = 'institutional_flame_broiler';
      pattySelect.value = 'premium_75_25_chuck';
      catalystSelect.value = 'severe_sintered_clog';
      airflowSelect.value = 'severely_choked_exhaust';
      metallurgySelect.value = 'thermally_sintered_degraded';
      throughputSlider.value = '1300';
      hoursSlider.value = '22';
      backpressureSlider.value = '0.38';
      burnerSlider.value = '100';
      calculate();
    });

    presetSintering.addEventListener('click', () => {
      broilerSelect.value = 'high_volume_fast_food';
      pattySelect.value = 'pork_breakfast_sausage';
      catalystSelect.value = 'severe_sintered_clog';
      airflowSelect.value = 'code_compliant_nominal';
      metallurgySelect.value = 'standard_pt_pd_alumina';
      throughputSlider.value = '1100';
      hoursSlider.value = '18';
      backpressureSlider.value = '0.24';
      burnerSlider.value = '100';
      calculate();
    });

    // Copy Telemetry
    copyBtn.addEventListener('click', () => {
      const bName = broilerSelect.options[broilerSelect.selectedIndex].text;
      const pName = pattySelect.options[pattySelect.selectedIndex].text;
      const cName = catalystSelect.options[catalystSelect.selectedIndex].text;
      const aName = airflowSelect.options[airflowSelect.selectedIndex].text;
      const statusText = complianceBadge.textContent.trim();

      const report = [
        "=== ISITKITCHENSAFE FORENSIC BROILER CATALYTIC TELEMETRY ===",
        `Timestamp: ${new Date().toISOString()}`,
        `Equipment: ${bName}`,
        `Patty Lipid Profile: ${pName}`,
        `Catalyst Condition: ${cName}`,
        `Exhaust Ventilation: ${aName}`,
        `Throughput: ${throughputSlider.value} patties/hr`,
        `Operating Run: ${hoursSlider.value} hours`,
        `Catalyst Core Temp: ${metricCoreTemp.textContent} (${metricCoreTempF.textContent})`,
        `Flue Backpressure: ${metricBackpressure.textContent} (${metricBackpressurePa.textContent})`,
        `Grease Aerosol Destruction Efficiency: ${metricDestruction.textContent}`,
        `Autoignition Safety Margin: ${metricMargin.textContent} (${metricFlueTemp.textContent})`,
        `CO Emissions: ${metricCo.textContent} | Acrolein: ${metricAcrolein.textContent}`,
        `Compliance Rating: ${statusText}`,
        `Primary Diagnosis: ${diagPrimaryRisk.textContent.trim()}`,
        `Underlying Kinetics: ${diagMechanismsDesc.textContent.trim()}`,
        `Action Protocol: ${diagMitigationDesc.textContent.trim()}`,
        "Governing Standards: NFPA 96 Sec 5 & 10, UL 197, SCAQMD Rule 1138, EPA Method 5G"
      ].join('\n');

      navigator.clipboard.writeText(report).then(() => {
        const orig = copyBtnText.textContent;
        copyBtnText.textContent = lang === 'es' ? '¡Copiado!' : lang === 'pt' ? 'Copiado!' : lang === 'zh-cn' ? '已复制！' : lang === 'ja' ? 'コピー完了！' : 'Copied Telemetry!';
        setTimeout(() => {
          copyBtnText.textContent = orig;
        }, 2500);
      }).catch(err => {
        console.error("Failed to copy clipboard:", err);
      });
    });

    // Initial calculation
    calculate();
  })();
</script>
