---
import rawData from '../data/kitchen-safety-iq-quiz-data.json';
import type { SupportedLanguage } from '../i18n/ui';
import { useTranslatedPath } from '../i18n/utils';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;
const translatePath = useTranslatedPath(lang);

const methodologyUrl = translatePath('/methodology/');
const allToolsUrl = translatePath('/tools/');

interface LocalizedQuestion {
  id: number;
  category: string;
  icon: string;
  citation: string;
  relatedToolSlug: string;
  correctOptionId: string;
  question: string;
  options: Array<{ id: string; text: string }>;
  verdict: string;
  explanation: string;
}

interface LocalizedTier {
  minScore: number;
  maxScore: number;
  badge: string;
  icon: string;
  percentile: string;
  colorClass: string;
  title: string;
  summary: string;
  advice: string;
}

const localizedQuestions: LocalizedQuestion[] = rawData.questions.map((q) => {
  const tr = (q.i18n as Record<string, any>)[lang] || q.i18n.en;
  return {
    id: q.id,
    category: q.category,
    icon: q.icon,
    citation: q.citation,
    relatedToolSlug: q.relatedToolSlug,
    correctOptionId: q.correctOptionId,
    question: tr.question,
    options: tr.options,
    verdict: tr.verdict,
    explanation: tr.explanation
  };
});

const localizedTiers: LocalizedTier[] = rawData.tiers.map((tier) => {
  const tr = (tier.i18n as Record<string, any>)[lang] || tier.i18n.en;
  return {
    minScore: tier.minScore,
    maxScore: tier.maxScore,
    badge: tier.badge,
    icon: tier.icon,
    percentile: tier.percentile,
    colorClass: tier.colorClass,
    title: tr.title,
    summary: tr.summary,
    advice: tr.advice
  };
});

const faqs = (rawData.faqs as Record<string, any>)[lang] || rawData.faqs.en;

