const ui = UI_STRINGS[lang] || UI_STRINGS.en;
---

<div id="quiz-root" class="w-full">
  <!-- Progress Header -->
  <div id="quiz-header-bar" class="bg-surface rounded-2xl border border-hairline p-5 mb-8 shadow-sm">
    <div class="flex flex-wrap items-center justify-between gap-4 mb-3">
      <div class="flex items-center gap-3">
        <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-signature-coral/10 text-signature-coral font-bold text-sm">
          IQ
        </span>
        <span class="text-xs md:text-sm font-semibold uppercase tracking-wider text-ink" id="progress-indicator">
          {ui.progressLabel} 1 {ui.of} {localizedQuestions.length}
        </span>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-xs md:text-sm text-body">{ui.scoreLabel}:</span>
        <span id="current-score-pill" class="px-3 py-1 bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 font-bold text-sm rounded-full">
          0 / {localizedQuestions.length}
        </span>
      </div>
    </div>
    <!-- Progress Bar Track -->
    <div class="w-full bg-surface-soft h-2.5 rounded-full overflow-hidden border border-hairline">
      <div id="progress-fill" class="h-full bg-signature-coral transition-all duration-300 rounded-full" style="width: 8.33%;"></div>
    </div>
  </div>

  <!-- Interactive Question Container -->
  <div id="questions-viewport" class="space-y-6">
    {localizedQuestions.map((q, idx) => (
      <div 
        class={`question-card bg-surface rounded-3xl border border-hairline p-6 md:p-8 shadow-sm transition-all duration-300 ${idx === 0 ? 'block' : 'hidden'}`}
        data-question-idx={idx}
        data-correct-id={q.correctOptionId}
        data-related-slug={q.relatedToolSlug}
        data-category={q.category}
      >
        <!-- Top Category & Icon Bar -->
        <div class="flex items-center justify-between gap-3 mb-5 pb-4 border-b border-hairline">
          <div class="flex items-center gap-2.5">
            <span class="text-2xl" aria-hidden="true">{q.icon}</span>
            <span class="text-xs font-bold uppercase tracking-wider px-2.5 py-1 rounded-md bg-surface-soft border border-hairline text-ink">
              {q.category}
            </span>
          </div>
          <span class="text-xs text-body font-mono">
            #{q.id}
          </span>
        </div>

        <!-- Question Prompt -->
        <h2 class="text-lg md:text-xl font-bold text-ink leading-snug mb-6">
          {q.question}
        </h2>

        <!-- Interactive Options -->
        <div class="grid grid-cols-1 gap-3.5 mb-6" role="radiogroup" aria-label={q.question}>
          {q.options.map((opt) => (
            <button
              type="button"
              class="option-btn text-left p-4 md:p-5 rounded-2xl border-2 border-hairline hover:border-signature-coral/50 bg-surface-soft hover:bg-surface focus:outline-none focus:ring-2 focus:ring-signature-coral transition-all group flex items-start gap-4 cursor-pointer"
              data-opt-id={opt.id}
            >
              <span class="opt-indicator flex-shrink-0 w-7 h-7 rounded-full border border-hairline bg-surface text-ink font-bold text-xs flex items-center justify-center group-hover:border-signature-coral">
                {opt.id}
              </span>
              <span class="text-sm md:text-base text-ink font-medium leading-relaxed">
                {opt.text}
              </span>
            </button>
          ))}
        </div>

        <!-- Scientific Feedback Drawer (Hidden until answered) -->
        <div class="feedback-drawer hidden mt-6 pt-6 border-t border-hairline rounded-2xl p-5 bg-surface-soft animate-fade-in">
          <div class="flex items-center gap-3 mb-3">
            <span class="feedback-verdict-badge px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider text-white"></span>
            <span class="feedback-status-pill text-xs font-semibold"></span>
          </div>
          <p class="feedback-text text-sm md:text-[15px] text-body leading-relaxed mb-4">
            {q.explanation}
          </p>
          <div class="flex flex-wrap items-center justify-between gap-3 text-xs text-body pt-3 border-t border-hairline">
            <div class="flex items-center gap-1.5 font-medium">
              <span>{ui.citationLabel}</span>
              <strong class="text-ink">{q.citation}</strong>
            </div>
            {q.relatedToolSlug && (
              <a 
                href={translatePath(`/tools/${q.relatedToolSlug}/`)}
                class="inline-flex items-center gap-1 font-semibold text-signature-coral hover:underline"
                target="_blank"
                rel="noopener"
              >
                <span>{ui.relatedToolLabel}</span>
                <span class="underline">{q.relatedToolSlug}</span> &rarr;
              </a>
            )}
          </div>
        </div>

        <!-- Next / Finish Action Row -->
        <div class="card-action-row hidden mt-6 flex justify-end">
          <button
            type="button"
            class="next-step-btn px-6 py-3 rounded-xl bg-signature-coral text-white font-bold text-sm shadow hover:opacity-95 focus:outline-none focus:ring-2 focus:ring-signature-coral transition-all"
          >
            {idx === localizedQuestions.length - 1 ? ui.finishBtn : ui.nextBtn}
          </button>
        </div>
      </div>
    ))}
  </div>

  <!-- Final Results & Analysis Screen (Initially Hidden) -->
  <div id="results-screen" class="hidden bg-surface rounded-3xl border border-hairline p-6 md:p-10 shadow-lg animate-fade-in">
    <!-- Top Result Banner -->
    <div class="text-center max-w-2xl mx-auto mb-10">
      <div id="result-icon-container" class="inline-flex items-center justify-center w-20 h-20 rounded-3xl bg-surface-soft border border-hairline text-4xl mb-4 shadow-inner">
        🏅
      </div>
      <div class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider mb-3" id="result-tier-pill">
        Tier Pill
      </div>
      <h2 id="result-tier-title" class="text-2xl md:text-3xl font-bold text-ink tracking-tight mb-3">
        Result Title
      </h2>
      <p id="result-tier-summary" class="text-sm md:text-base text-body leading-relaxed mb-6">
        Summary description goes here.
      </p>

      <!-- Scoreboard Display -->
      <div class="grid grid-cols-2 gap-4 max-w-md mx-auto p-4 rounded-2xl bg-surface-soft border border-hairline mb-8">
        <div class="p-3">
          <div class="text-xs uppercase tracking-wider text-body font-semibold mb-1">{ui.scoreSummary}</div>
          <div class="text-3xl font-black text-ink" id="final-score-display">0 / 12</div>
        </div>
        <div class="p-3 border-l border-hairline">
          <div class="text-xs uppercase tracking-wider text-body font-semibold mb-1">{ui.percentileLabel}</div>
          <div class="text-3xl font-black text-signature-coral" id="final-percentile-display">Top 2%</div>
        </div>
      </div>

      <!-- Action Buttons Row -->
      <div class="flex flex-wrap items-center justify-center gap-3">
        <button
          type="button"
          id="copy-badge-btn"
          class="px-5 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm shadow transition-all flex items-center gap-2 cursor-pointer"
        >
          <span>{ui.copyBadgeBtn}</span>
        </button>
        <button
          type="button"
          id="print-report-btn"
          class="px-5 py-3 rounded-xl bg-surface-soft border border-hairline text-ink font-semibold text-sm hover:bg-surface transition-all flex items-center gap-2 cursor-pointer"
        >
          <span>{ui.printBtn}</span>
        </button>
        <button
          type="button"
          id="restart-quiz-btn"
          class="px-5 py-3 rounded-xl bg-surface-soft border border-hairline text-ink font-semibold text-sm hover:bg-surface transition-all cursor-pointer"
        >
          <span>{ui.restartBtn}</span>
        </button>
      </div>
      <div id="copy-toast" class="hidden mt-3 text-xs font-bold text-emerald-600 dark:text-emerald-400 animate-pulse">
        {ui.copiedText}
      </div>
    </div>

    <!-- Targeted Tool Recommendations Based on Missed Topics -->
    <div id="missed-recommendations-block" class="mb-10 p-6 rounded-2xl bg-signature-coral/5 border border-signature-coral/20">
      <h3 class="text-base font-bold text-ink mb-1 flex items-center gap-2">
        <span>💡</span> {ui.missedTitle}
      </h3>
      <p class="text-xs text-body mb-4">{ui.missedSub}</p>
      <div id="recommended-tools-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
        <!-- Injected via JavaScript -->
      </div>
    </div>

    <!-- Full 12-Question Review List -->
    <div class="border-t border-hairline pt-8">
      <h3 class="text-lg font-bold text-ink mb-6 flex items-center gap-2">
        <span>📋</span> {ui.reviewHeading}
      </h3>
      <div id="questions-review-list" class="space-y-4">
        <!-- Rendered via JavaScript -->
      </div>
    </div>
  </div>

  <!-- Trust Methodology Banner -->
  <div class="mt-10 p-5 rounded-2xl bg-surface-soft border border-hairline text-xs text-body leading-relaxed flex items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <span class="text-xl">🛡️</span>
      <p>
        {ui.methodologyNote}
        <a href={methodologyUrl} class="text-signature-coral font-semibold hover:underline">
          {ui.methodologyLink} &rarr;
        </a>
      </p>
    </div>
    <a href={allToolsUrl} class="flex-shrink-0 font-bold text-ink hover:underline">
      All 191 Tools &rarr;
    </a>
  </div>

  <!-- 5 Visible Static FAQs -->
  <section class="mt-14 pt-10 border-t border-hairline">
    <h2 class="text-xl md:text-2xl font-bold text-ink tracking-tight mb-6">
      {ui.faqHeading}
    </h2>
    <div class="space-y-4">
      {faqs.map((faq: { question: string; answer: string }) => (
        <details class="group bg-surface rounded-2xl border border-hairline p-5 transition-all">
          <summary class="font-bold text-ink text-sm md:text-base cursor-pointer list-none flex items-center justify-between gap-4">
            <span>{faq.question}</span>
            <span class="text-xs px-2 py-1 rounded bg-surface-soft text-body group-open:rotate-180 transition-transform">
              ▼
            </span>
          </summary>
          <p class="mt-3 text-body text-xs md:text-sm leading-relaxed border-t border-hairline pt-3">
            {faq.answer}
          </p>
        </details>
      ))}
    </div>
  </section>
</div>

<!-- Dynamic Client Script -->
<script define:vars={{ localizedQuestions, localizedTiers, ui, lang }}>
  (function() {
    let currentIdx = 0;
    const userAnswers = new Array(localizedQuestions.length).fill(null);
    let totalScore = 0;

    const root = document.getElementById('quiz-root');
    if (!root) return;

    const cards = root.querySelectorAll('.question-card');
    const headerBar = document.getElementById('quiz-header-bar');
    const progressIndicator = document.getElementById('progress-indicator');
    const progressFill = document.getElementById('progress-fill');
    const currentScorePill = document.getElementById('current-score-pill');
    const resultsScreen = document.getElementById('results-screen');
    const questionsViewport = document.getElementById('questions-viewport');

    function updateProgressUI() {
      if (progressIndicator) {
        progressIndicator.textContent = `${ui.progressLabel} ${currentIdx + 1} ${ui.of} ${localizedQuestions.length}`;
      }
      if (progressFill) {
        const pct = ((currentIdx + 1) / localizedQuestions.length) * 100;
        progressFill.style.width = `${pct}%`;
      }
      if (currentScorePill) {
        currentScorePill.textContent = `${totalScore} / ${localizedQuestions.length}`;
      }
    }

    cards.forEach((card, idx) => {
      const optionButtons = card.querySelectorAll('.option-btn');
      const drawer = card.querySelector('.feedback-drawer');
      const actionRow = card.querySelector('.card-action-row');
      const nextBtn = card.querySelector('.next-step-btn');
      const correctId = card.getAttribute('data-correct-id');
      const verdictBadge = card.querySelector('.feedback-verdict-badge');
      const statusPill = card.querySelector('.feedback-status-pill');

      optionButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          if (userAnswers[idx] !== null) return; // already answered

          const chosenId = btn.getAttribute('data-opt-id');
          const isCorrect = (chosenId === correctId);
          userAnswers[idx] = {
            chosenId,
            isCorrect,
            question: localizedQuestions[idx]
          };

          if (isCorrect) {
            totalScore++;
            btn.classList.add('bg-emerald-500/15', 'border-emerald-500', 'text-emerald-900');
            const ind = btn.querySelector('.opt-indicator');
            if (ind) {
              ind.classList.add('bg-emerald-600', 'text-white', 'border-emerald-600');
              ind.textContent = '✓';
            }
            if (verdictBadge) {
              verdictBadge.textContent = ui.correctBadge;
              verdictBadge.className = 'feedback-verdict-badge px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-600 text-white';
            }
          } else {
            btn.classList.add('bg-rose-500/15', 'border-rose-500', 'text-rose-900');
            const ind = btn.querySelector('.opt-indicator');
            if (ind) {
              ind.classList.add('bg-rose-600', 'text-white', 'border-rose-600');
              ind.textContent = '✗';
            }
            // Highlight the correct one
            optionButtons.forEach((otherBtn) => {
              if (otherBtn.getAttribute('data-opt-id') === correctId) {
                otherBtn.classList.add('border-emerald-500', 'bg-emerald-500/10');
                const otherInd = otherBtn.querySelector('.opt-indicator');
                if (otherInd) otherInd.classList.add('bg-emerald-500', 'text-white');
              }
            });
            if (verdictBadge) {
              verdictBadge.textContent = ui.incorrectBadge;
              verdictBadge.className = 'feedback-verdict-badge px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-rose-600 text-white';
            }
          }

          if (statusPill) {
            statusPill.textContent = localizedQuestions[idx].verdict;
          }

          if (drawer) drawer.classList.remove('hidden');
          if (actionRow) actionRow.classList.remove('hidden');
          updateProgressUI();
        });
      });

      if (nextBtn) {
        nextBtn.addEventListener('click', () => {
          if (currentIdx < localizedQuestions.length - 1) {
            card.classList.add('hidden');
            currentIdx++;
            const nextCard = cards[currentIdx];
            if (nextCard) {
              nextCard.classList.remove('hidden');
              nextCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
            updateProgressUI();
          } else {
            showFinalResults();
          }
        });
      }
    });

    function showFinalResults() {
      if (questionsViewport) questionsViewport.classList.add('hidden');
      if (headerBar) headerBar.classList.add('hidden');
      if (!resultsScreen) return;

      resultsScreen.classList.remove('hidden');
      resultsScreen.scrollIntoView({ behavior: 'smooth', block: 'start' });

      // Determine Tier
      let matchedTier = localizedTiers[localizedTiers.length - 1];
      for (const t of localizedTiers) {
        if (totalScore >= t.minScore && totalScore <= t.maxScore) {
          matchedTier = t;
          break;
        }
      }

      const iconElem = document.getElementById('result-icon-container');
      const tierPill = document.getElementById('result-tier-pill');
      const titleElem = document.getElementById('result-tier-title');
      const summaryElem = document.getElementById('result-tier-summary');
      const scoreElem = document.getElementById('final-score-display');
      const percentileElem = document.getElementById('final-percentile-display');

      if (iconElem) iconElem.textContent = matchedTier.icon;
      if (tierPill) {
        tierPill.textContent = matchedTier.badge;
        tierPill.className = `inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider mb-3 ${matchedTier.colorClass}`;
      }
      if (titleElem) titleElem.textContent = matchedTier.title;
      if (summaryElem) summaryElem.textContent = `${matchedTier.summary} ${matchedTier.advice}`;
      if (scoreElem) scoreElem.textContent = `${totalScore} / ${localizedQuestions.length}`;
      if (percentileElem) percentileElem.textContent = matchedTier.percentile;

      // Populate Recommendations
      const missedToolsContainer = document.getElementById('recommended-tools-grid');
      const missedSlugs = new Set();
      userAnswers.forEach((ans) => {
        if (ans && !ans.isCorrect && ans.question.relatedToolSlug) {
          missedSlugs.add(ans.question.relatedToolSlug);
        }
      });

      // Default to top calculators if scored high
      if (missedSlugs.size === 0) {
        missedSlugs.add('leftover-shelf-life-calculator');
        missedSlugs.add('meat-thawing-calculator');
        missedSlugs.add('cooking-oil-smoke-point-finder');
      }

      if (missedToolsContainer) {
        missedToolsContainer.innerHTML = '';
        missedSlugs.forEach((slug) => {
          const a = document.createElement('a');
          a.href = `/${lang === 'en' ? '' : lang + '/'}tools/${slug}/`;
          a.className = 'p-3 rounded-xl bg-surface border border-hairline hover:border-signature-coral text-ink font-semibold text-xs flex items-center justify-between shadow-sm transition-all';
          a.innerHTML = `<span class="truncate">${slug}</span> <span class="text-signature-coral">&rarr;</span>`;
          missedToolsContainer.appendChild(a);
        });
      }

      // Populate Review List
      const reviewList = document.getElementById('questions-review-list');
      if (reviewList) {
        reviewList.innerHTML = '';
        userAnswers.forEach((ans, i) => {
          if (!ans) return;
          const row = document.createElement('div');
          row.className = `p-4 rounded-2xl border ${ans.isCorrect ? 'border-emerald-500/30 bg-emerald-500/5' : 'border-rose-500/30 bg-rose-500/5'}`;
          row.innerHTML = `
            <div class="flex items-center justify-between gap-2 mb-1">
              <span class="text-xs font-bold text-ink">#${i + 1} · ${ans.question.category}</span>
              <span class="text-xs font-bold ${ans.isCorrect ? 'text-emerald-700' : 'text-rose-700'}">${ans.isCorrect ? '✓ ' + ui.correctBadge : '✗ ' + ui.incorrectBadge}</span>
            </div>
            <p class="text-sm font-semibold text-ink mb-1.5">${ans.question.question}</p>
            <p class="text-xs text-body leading-relaxed">${ans.question.explanation}</p>
          `;
          reviewList.appendChild(row);
        });
      }
    }

    // Share Badge Action
    const copyBadgeBtn = document.getElementById('copy-badge-btn');
    const copyToast = document.getElementById('copy-toast');
    if (copyBadgeBtn) {
      copyBadgeBtn.addEventListener('click', () => {
        let matchedTier = localizedTiers[localizedTiers.length - 1];
        for (const t of localizedTiers) {
          if (totalScore >= t.minScore && totalScore <= t.maxScore) {
            matchedTier = t;
            break;
          }
        }
        const currentUrl = window.location.href.split('?')[0];
        const shareText = `${ui.shareTextPrefix} ${totalScore}/${localizedQuestions.length} (${matchedTier.title}) ${matchedTier.icon}\n${matchedTier.summary}\nTake the official challenge: ${currentUrl}`;
        navigator.clipboard.writeText(shareText).then(() => {
          if (copyToast) {
            copyToast.classList.remove('hidden');
            setTimeout(() => copyToast.classList.add('hidden'), 3500);
          }
        });
      });
    }

    // Print Action
    const printBtn = document.getElementById('print-report-btn');
    if (printBtn) {
      printBtn.addEventListener('click', () => window.print());
    }

    // Restart Action
    const restartBtn = document.getElementById('restart-quiz-btn');
    if (restartBtn) {
      restartBtn.addEventListener('click', () => {
        window.location.reload();
      });
    }
  })();
</script>