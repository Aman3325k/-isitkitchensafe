                <span class="block text-[10px] text-muted mt-0.5">{d.gradeLabel}</span>
              </div>
            </div>

            <!-- Tags Row -->
            <div class="flex flex-wrap gap-1.5 mb-4">
              {isPfasFree ? (
                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-100 dark:bg-emerald-950/40 text-emerald-800 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-800">
                  <svg class="w-3 h-3 text-emerald-600 dark:text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                  {d.pfasFreeTag}
                </span>
              ) : (
                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-amber-100 dark:bg-amber-950/40 text-amber-900 dark:text-amber-300 border border-amber-300 dark:border-amber-800">
                  <svg class="w-3 h-3 text-amber-600 dark:text-amber-400 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path></svg>
                  {d.ptfeTag}
                </span>
              )}

              {brand.greenwashAlert && (
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-red-100 dark:bg-red-950/50 text-red-800 dark:text-red-300 border border-red-300 dark:border-red-900">
                  ⚠️ {d.greenwashTag}
                </span>
              )}
            </div>

            <!-- Material & Surface Info -->
            <div class="space-y-2 text-xs mb-4">
              <div class="flex items-start justify-between py-1.5 border-b border-hairline/60">
                <span class="text-muted">{d.surfaceLabel}:</span>
                <span class="font-medium text-ink text-right max-w-[65%]">{brand.primaryMaterial}</span>
              </div>
              <div class="flex items-center justify-between py-1.5 border-b border-hairline/60">
                <span class="text-muted">{d.maxHeatLabel}:</span>
                <span class="font-mono font-medium text-ink">{brand.maxSafeTempF}&deg;F ({brand.maxSafeTempC}&deg;C)</span>
              </div>
            </div>

            <!-- Greenwash Alert Callout Box if applicable -->
            {brand.greenwashAlert && (
              <div class="p-3 rounded-lg bg-red-50 dark:bg-red-950/30 border border-red-200 dark:border-red-900/60 mb-4 text-[12px] leading-relaxed text-red-900 dark:text-red-200">
                <strong class="font-semibold block mb-0.5">⚠️ Marketing Alert:</strong>
                {brand.greenwashAlert}
              </div>
            )}

            <!-- Summary verdict paragraph -->
            <p class="text-body text-[13px] leading-relaxed mb-4">
              {brand.verdictSummary}
            </p>
          </div>

          <!-- Bottom Button -->
          <div class="pt-3 border-t border-hairline mt-auto">
            <button 
              type="button" 
              class="open-brand-modal-btn w-full py-2 px-3 rounded-lg bg-surface-soft hover:bg-surface-strong text-ink text-xs font-medium border border-hairline transition-colors flex items-center justify-center gap-1.5 cursor-pointer"
              data-brand-id={brand.id}
            >
              <svg class="w-3.5 h-3.5 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              {d.viewAuditBtn} &rarr;
            </button>
          </div>
        </article>
      );
    })}
  </div>

  <!-- Detail Dossier Modal -->
  <div id="brand-detail-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs" role="dialog" aria-modal="true" aria-labelledby="modal-brand-title">
    <div class="bg-canvas border border-hairline rounded-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto shadow-2xl p-6 md:p-8 relative">
      <!-- Close button -->
      <button 
        type="button" 
        id="close-brand-modal"
        class="absolute top-5 right-5 w-8 h-8 rounded-full bg-surface-soft hover:bg-surface-strong text-ink flex items-center justify-center cursor-pointer transition-colors"
        aria-label={d.closeBtn}
      >
        &times;
      </button>

      <!-- Modal Content Header -->
      <div class="pr-10 mb-6">
        <span class="text-xs uppercase tracking-wider font-bold text-signature-coral block mb-1">
          {d.auditModalTitle}
        </span>
        <h3 id="modal-brand-title" class="text-title-lg font-medium text-ink"></h3>
        <p id="modal-brand-meta" class="text-xs text-muted"></p>
      </div>

      <!-- Modal Body Sections -->
      <div class="space-y-5 text-sm">
        <!-- Lab Audit Findings -->
        <div class="bg-surface-soft border border-hairline rounded-xl p-4">
          <h4 class="font-semibold text-ink text-xs uppercase tracking-wider mb-2 flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            {d.labAuditHeading}
          </h4>
          <p id="modal-lab-summary" class="text-body text-[13px] leading-relaxed mb-3"></p>
          <div id="modal-certifications" class="flex flex-wrap gap-1.5"></div>
        </div>

        <!-- Coating Chemistry -->
        <div>
          <h4 class="font-semibold text-ink text-xs uppercase tracking-wider mb-1.5">
            {d.chemistryHeading}
          </h4>
          <p id="modal-chemistry" class="text-body text-[13px] leading-relaxed bg-canvas border border-hairline rounded-lg p-3"></p>
        </div>

        <!-- Marketing vs Reality -->
        <div>
          <h4 class="font-semibold text-ink text-xs uppercase tracking-wider mb-1.5">
            {d.claimsHeading}
          </h4>
          <div id="modal-claims-container" class="space-y-1.5"></div>
        </div>

        <!-- Best Culinary Use & Avoid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="p-3 rounded-lg bg-emerald-50 dark:bg-emerald-950/20 border border-emerald-200 dark:border-emerald-900/50">
            <h5 class="font-semibold text-emerald-900 dark:text-emerald-300 text-xs mb-1">✓ {d.bestUseHeading}</h5>
            <p id="modal-best-use" class="text-[12px] text-emerald-800 dark:text-emerald-200 leading-relaxed"></p>
          </div>
          <div class="p-3 rounded-lg bg-amber-50 dark:bg-amber-950/20 border border-amber-200 dark:border-amber-900/50">
            <h5 class="font-semibold text-amber-900 dark:text-amber-300 text-xs mb-1">⚠️ {d.avoidHeading}</h5>
            <p id="modal-avoid" class="text-[12px] text-amber-800 dark:text-amber-200 leading-relaxed"></p>
          </div>
        </div>

        <!-- Tested Lines -->
        <div class="pt-2 border-t border-hairline">
          <span class="text-xs text-muted block mb-1 font-medium">{d.linesHeading}:</span>
          <p id="modal-popular-lines" class="text-xs text-body font-mono"></p>
        </div>
      </div>
    </div>
  </div>

  <!-- Educational Myth-Buster Guide Section -->
  <section class="mt-14 mb-14 bg-surface-soft border border-hairline rounded-2xl p-6 md:p-10">
    <div class="max-w-2xl mb-8">
      <span class="text-xs font-bold uppercase tracking-wider text-signature-coral block mb-2">
        Material Science Reference
      </span>
      <h3 class="text-title-lg md:text-display-sm font-medium text-ink tracking-tight mb-3">
        {d.mythBusterTitle}
      </h3>
      <p class="text-body text-[15px] leading-relaxed">
        {d.mythBusterSub}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="bg-canvas border border-hairline rounded-xl p-5 shadow-2xs">
        <h4 class="text-ink font-semibold text-sm mb-2">{d.myth1Title}</h4>
        <p class="text-body text-[13px] leading-relaxed">{d.myth1Text}</p>
      </div>

      <div class="bg-canvas border border-hairline rounded-xl p-5 shadow-2xs">
        <h4 class="text-ink font-semibold text-sm mb-2">{d.myth2Title}</h4>
        <p class="text-body text-[13px] leading-relaxed">{d.myth2Text}</p>
      </div>

      <div class="bg-canvas border border-hairline rounded-xl p-5 shadow-2xs">
        <h4 class="text-ink font-semibold text-sm mb-2">{d.myth3Title}</h4>
        <p class="text-body text-[13px] leading-relaxed">{d.myth3Text}</p>
      </div>

      <div class="bg-canvas border border-hairline rounded-xl p-5 shadow-2xs">
        <h4 class="text-ink font-semibold text-sm mb-2">{d.myth4Title}</h4>
        <p class="text-body text-[13px] leading-relaxed">{d.myth4Text}</p>
      </div>
    </div>
  </section>

  <!-- Cross-Link Banner to Tool 1 -->
  <div class="p-6 md:p-8 rounded-2xl bg-gradient-to-r from-ink to-stone-900 text-white flex flex-col md:flex-row items-center justify-between gap-6 shadow-md">
    <div class="max-w-xl">
      <span class="inline-block px-2.5 py-0.5 rounded text-[11px] font-bold uppercase tracking-wider bg-white/20 text-white mb-2">
        Companion Diagnostic Tool
      </span>
      <h3 class="text-title-md font-medium text-white mb-2">
        {d.crossLinkBanner}
      </h3>
      <p class="text-white/80 text-xs md:text-sm leading-relaxed">
        Our optical AI scanner analyzes hairline scratches, exposed aluminum reflection, and calculates microplastic shedding per Newcastle/Flinders university data.
      </p>
    </div>
    <a 
      href={lang === 'en' ? '/tools/pan-scratch-inspector/' : `/${lang}/tools/pan-scratch-inspector/`}
      class="shrink-0 px-5 py-3 rounded-full bg-signature-coral hover:bg-signature-coral/90 text-white font-medium text-sm transition-transform active:scale-95 shadow-sm"
    >
      <Fragment set:html={d.crossLinkBtn} />
    </a>
  </div>
