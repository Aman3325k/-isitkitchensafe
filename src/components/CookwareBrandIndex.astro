          data-uncoated={isUncoated ? "true" : "false"}
          data-enamel={isEnamel ? "true" : "false"}
          data-search-corpus={`${brand.name} ${brand.primaryMaterial} ${brand.country} ${brand.marketingClaims.join(' ')} ${brand.popularLines.join(' ')} ${brand.coatingType}`.toLowerCase()}
