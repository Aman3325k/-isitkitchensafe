  <div class="bg-surface-soft border border-hairline rounded-xl p-6 md:p-8 mb-8 shadow-xs">
    <div class="flex items-center gap-2 mb-3">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-signature-coral text-white">
        {d.badge}
      </span>
      <span class="text-xs text-muted font-mono">ISO 17025 Audited</span>
    </div>

    <h2 class="text-title-lg md:text-display-sm font-medium text-ink tracking-tight mb-3">
      {d.title}
    </h2>
    <p class="text-body text-[15px] leading-relaxed max-w-3xl mb-6">
      {d.subtitle}
    </p>

    <!-- Search Bar & Filters -->
    <div class="space-y-4">
      <div class="relative max-w-2xl">
        <input 
          type="text" 
          id="brand-search-input" 
          placeholder={d.searchPlaceholder} 
          class="w-full h-12 pl-11 pr-4 bg-canvas text-ink text-sm md:text-base border border-hairline rounded-lg focus:outline-none focus:border-signature-coral shadow-xs"
          autocomplete="off"
        />
        <svg class="w-5 h-5 text-muted absolute left-3.5 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>

      <!-- Filter Buttons -->
      <div class="flex flex-wrap gap-2 pt-1" id="brand-filter-container">
        <button 
          type="button" 
          class="brand-filter-btn px-3 py-1.5 rounded-full text-xs font-medium border border-ink bg-ink text-white transition-all cursor-pointer"
          data-filter="all"
        >
          {d.filterAll}
        </button>
        <button 
          type="button" 
          class="brand-filter-btn px-3 py-1.5 rounded-full text-xs font-medium border border-hairline bg-canvas text-body hover:text-ink hover:border-ink transition-all cursor-pointer"
          data-filter="pfas_free"
        >
          {d.filterPfasFree}
        </button>
        <button 
          type="button" 
          class="brand-filter-btn px-3 py-1.5 rounded-full text-xs font-medium border border-hairline bg-canvas text-body hover:text-ink hover:border-ink transition-all cursor-pointer"
          data-filter="ptfe"
        >
          {d.filterPtfe}
        </button>
        <button 
          type="button" 
          class="brand-filter-btn px-3 py-1.5 rounded-full text-xs font-medium border border-hairline bg-canvas text-body hover:text-ink hover:border-ink transition-all cursor-pointer"
          data-filter="greenwash"
        >
          {d.filterGreenwash}
        </button>
        <button 
          type="button" 
          class="brand-filter-btn px-3 py-1.5 rounded-full text-xs font-medium border border-hairline bg-canvas text-body hover:text-ink hover:border-ink transition-all cursor-pointer"
          data-filter="uncoated"
        >
          {d.filterUncoated}
        </button>
        <button 
          type="button" 
          class="brand-filter-btn px-3 py-1.5 rounded-full text-xs font-medium border border-hairline bg-canvas text-body hover:text-ink hover:border-ink transition-all cursor-pointer"
          data-filter="enamel"
        >
          {d.filterEnamel}
        </button>
      </div>
    </div>
  </div>

  <!-- Live Results Counter -->
  <div class="flex items-center justify-between mb-6 px-1">
    <p class="text-xs md:text-sm text-body" id="brand-results-count">
      {d.resultsShowing} <strong class="text-ink font-semibold" id="count-visible">25</strong> {d.resultsOf} <strong class="text-ink font-semibold">25</strong> {d.resultsBrands}
