<!-- Embedded JSON data for client-side search & modal hydration -->
<script id="cookware-brands-raw-data" type="application/json" set:html={JSON.stringify(brandsData)} />

<script is:inline>
  (function() {
    const rawDataEl = document.getElementById('cookware-brands-raw-data');
    if (!rawDataEl) return;

    let brands = [];
    try {
      brands = JSON.parse(rawDataEl.textContent);
    } catch (e) {
      console.error('Failed to parse cookware brands data:', e);
      return;
    }

    const brandMap = new Map();
    brands.forEach(b => brandMap.set(b.id, b));

    const searchInput = document.getElementById('brand-search-input');
    const filterBtns = document.querySelectorAll('.brand-filter-btn');
    const brandCards = document.querySelectorAll('.brand-card');
    const countVisibleEl = document.getElementById('count-visible');
    const noResultsEl = document.getElementById('no-brands-matched');
    const modal = document.getElementById('brand-detail-modal');
    const closeModalBtn = document.getElementById('close-brand-modal');

    let currentFilter = 'all';
    let currentQuery = '';

    function applyFilterAndSearch() {
      const q = currentQuery.trim().toLowerCase();
      let visibleCount = 0;

      brandCards.forEach(card => {
        const pfasFree = card.getAttribute('data-pfas-free') === 'true';
        const hasPtfe = card.getAttribute('data-has-ptfe') === 'true';
        const greenwash = card.getAttribute('data-greenwash') === 'true';
        const uncoated = card.getAttribute('data-uncoated') === 'true';
        const enamel = card.getAttribute('data-enamel') === 'true';
        const corpus = card.getAttribute('data-search-corpus') || '';

        // Check filter tag
        let matchesFilter = true;
        if (currentFilter === 'pfas_free') matchesFilter = pfasFree;
        else if (currentFilter === 'ptfe') matchesFilter = hasPtfe;
        else if (currentFilter === 'greenwash') matchesFilter = greenwash;
        else if (currentFilter === 'uncoated') matchesFilter = uncoated;
        else if (currentFilter === 'enamel') matchesFilter = enamel;

        // Check search query
        let matchesQuery = true;
        if (q.length > 0) {
          matchesQuery = corpus.includes(q);
        }

        if (matchesFilter && matchesQuery) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (countVisibleEl) {
        countVisibleEl.textContent = visibleCount;
      }

      if (noResultsEl) {
        if (visibleCount === 0) {
          noResultsEl.classList.remove('hidden');
        } else {
          noResultsEl.classList.add('hidden');
        }
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', function(e) {
        currentQuery = e.target.value;
        applyFilterAndSearch();
      });
    }

    filterBtns.forEach(btn => {
      btn.addEventListener('click', function() {
        filterBtns.forEach(b => {
          b.classList.remove('bg-ink', 'text-white', 'border-ink');
          b.classList.add('bg-canvas', 'text-body', 'border-hairline');
        });

        btn.classList.remove('bg-canvas', 'text-body', 'border-hairline');
        btn.classList.add('bg-ink', 'text-white', 'border-ink');

        currentFilter = btn.getAttribute('data-filter') || 'all';
        applyFilterAndSearch();
      });
    });

    // Modal Hydration & Display
    function openBrandModal(brandId) {
      const brand = brandMap.get(brandId);
      if (!brand || !modal) return;

      document.getElementById('modal-brand-title').textContent = `${brand.name} (Grade ${brand.transparencyGrade})`;
      document.getElementById('modal-brand-meta').textContent = `${brand.country} • Established ${brand.founded} • Primary Material: ${brand.primaryMaterial}`;
      document.getElementById('modal-lab-summary').textContent = brand.labSummary;

      const certsContainer = document.getElementById('modal-certifications');
      certsContainer.innerHTML = '';
      brand.certifications.forEach(cert => {
        const badge = document.createElement('span');
        badge.className = 'px-2 py-0.5 rounded text-[11px] font-mono bg-canvas border border-hairline text-ink';
        badge.textContent = cert;
        certsContainer.appendChild(badge);
      });

      document.getElementById('modal-chemistry').textContent = brand.chemistryDisclosure;

      const claimsContainer = document.getElementById('modal-claims-container');
      claimsContainer.innerHTML = '';
      brand.marketingClaims.forEach(claim => {
        const div = document.createElement('div');
        div.className = 'flex items-center gap-2 text-xs py-1 px-2.5 rounded bg-surface-soft';
        div.innerHTML = `<span class="text-signature-coral font-bold">•</span> <span class="font-medium text-ink">"${claim}"</span>`;
        claimsContainer.appendChild(div);
      });

      document.getElementById('modal-best-use').textContent = brand.bestUsedFor;
      document.getElementById('modal-avoid').textContent = brand.avoidDoing;
      document.getElementById('modal-popular-lines').textContent = brand.popularLines.join(', ');

      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeBrandModal() {
      if (!modal) return;
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }

    document.querySelectorAll('.open-brand-modal-btn').forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        const brandId = btn.getAttribute('data-brand-id');
        if (brandId) openBrandModal(brandId);
      });
    });

    if (closeModalBtn) {
      closeModalBtn.addEventListener('click', closeBrandModal);
    }

    if (modal) {
      modal.addEventListener('click', function(e) {
        if (e.target === modal) closeBrandModal();
      });
    }

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
        closeBrandModal();
      }
    });
  })();
</script>
