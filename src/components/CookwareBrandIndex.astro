    <p class="text-sm text-body">{d.noResultsSub}</p>
  </div>

  <!-- Brands Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-14" id="brands-grid">
    {brandsData.map((brand) => {
      const isPfasFree = !brand.hasPtfePfas;
      const isGreenwash = brand.greenwashScore === 'high' || brand.greenwashScore === 'moderate';
      const isUncoated = brand.coatingType === 'uncoated' || brand.coatingType === 'carbon_steel';
      const isEnamel = brand.coatingType === 'vitreous_enamel';

      return (
