              </div>
              <div class="text-center shrink-0">
                <span class={`inline-block px-3 py-1 rounded-md text-sm font-bold border shadow-2xs ${getGradeBadgeClass(brand.transparencyGrade)}`}>
                  Grade {brand.transparencyGrade}
