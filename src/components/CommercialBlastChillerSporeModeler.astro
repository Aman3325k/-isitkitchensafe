const d = DICTIONARY[lang] || DICTIONARY.en;
const architectures = blastChillerData.blastChillerArchitectures;
const foodMatrices = blastChillerData.foodMatrixProfiles;
const panOptions = blastChillerData.panDepthAndCoveringOptions;
const frostStates = blastChillerData.evaporatorFrostAndDefrostStates;
---

<div class="blast-chiller-modeler bg-surface border border-hairline rounded-3xl p-6 md:p-10 shadow-sm max-w-6xl mx-auto my-8" id="blast-chiller-engine">
  <!-- Header Badge -->
  <div class="flex flex-wrap items-center justify-between gap-3 pb-6 border-b border-hairline">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-sky-500/10 text-sky-700 dark:text-sky-300 border border-sky-500/20">
      <span>❄️</span>
      {d.badge}
    </div>
    <div class="text-xs text-muted font-mono">
      FDA Food Code § 3-501.14 &bull; UK ECFA 90-Min Rule &bull; NSF/ANSI 7
    </div>
  </div>

  <!-- Title & Subtitle -->
  <div class="mt-6 mb-8">
    <h2 class="text-2xl md:text-3xl font-extrabold text-ink tracking-tight mb-2">
      {d.title}
    </h2>
    <p class="text-sm md:text-base text-muted leading-relaxed max-w-4xl">
      {d.subtitle}
    </p>
  </div>

  <!-- Presets Bar -->
  <div class="mb-8 p-5 bg-surface-soft border border-hairline rounded-2xl">
    <div class="text-xs font-bold uppercase tracking-wider text-muted mb-3 flex items-center gap-2">
      <span>🎯</span> {d.presetsTitle}
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-2 text-xs">
      <button 
        type="button"
        id="preset-gold"
        class="text-left p-3 rounded-xl bg-surface border border-emerald-500/30 hover:border-emerald-500 hover:bg-emerald-500/5 transition text-ink font-medium flex items-start gap-2 shadow-2xs"
      >
        <span class="text-emerald-500 font-bold shrink-0">✓</span>
        <span>{d.presetGoldStandard}</span>
      </button>

      <button 
        type="button"
        id="preset-spore"
        class="text-left p-3 rounded-xl bg-surface border border-rose-500/30 hover:border-rose-500 hover:bg-rose-500/5 transition text-ink font-medium flex items-start gap-2 shadow-2xs"
      >
        <span class="text-rose-500 font-bold shrink-0">⚠️</span>
        <span>{d.presetSporeHazard}</span>
      </button>

      <button 
        type="button"
        id="preset-aerosol"
        class="text-left p-3 rounded-xl bg-surface border border-amber-500/30 hover:border-amber-500 hover:bg-amber-500/5 transition text-ink font-medium flex items-start gap-2 shadow-2xs"
      >
        <span class="text-amber-500 font-bold shrink-0">☣️</span>
        <span>{d.presetDefrostAerosol}</span>
      </button>

      <button 
        type="button"
        id="preset-cereus"
        class="text-left p-3 rounded-xl bg-surface border border-indigo-500/30 hover:border-indigo-500 hover:bg-indigo-500/5 transition text-ink font-medium flex items-start gap-2 shadow-2xs"
      >
        <span class="text-indigo-500 font-bold shrink-0">🍚</span>
        <span>{d.presetStarchCereulide}</span>
      </button>
    </div>
  </div>

  <!-- Interactive Controls Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-10">
    <!-- Left Column: Selectors -->
    <div class="space-y-6">
      <div class="border-b border-hairline pb-2">
        <h3 class="text-lg font-bold text-ink">{d.controlsTitle}</h3>
        <p class="text-xs text-muted">{d.controlsSub}</p>
      </div>

      <!-- Chiller Architecture -->
      <div>
        <label for="chiller-select" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5">
          {d.chillerLabel}
        </label>
        <select 
          id="chiller-select"
          class="w-full bg-surface border border-hairline rounded-xl px-3.5 py-2.5 text-xs text-ink focus:outline-hidden focus:ring-2 focus:ring-sky-500 shadow-2xs cursor-pointer"
        >
          {architectures.map((item) => (
            <option value={item.id} selected={item.id === 'reach_in_10_pan_commercial_chiller'}>
              {item.name}
            </option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1 leading-normal" id="chiller-help">{d.chillerHelp}</p>
      </div>

      <!-- Food Matrix -->
      <div>
        <label for="matrix-select" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5">
          {d.matrixLabel}
        </label>
        <select 
          id="matrix-select"
          class="w-full bg-surface border border-hairline rounded-xl px-3.5 py-2.5 text-xs text-ink focus:outline-hidden focus:ring-2 focus:ring-sky-500 shadow-2xs cursor-pointer"
        >
          {foodMatrices.map((m) => (
            <option value={m.id} selected={m.id === 'dense_viscous_beef_stew'}>
              {m.name}
            </option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1 leading-normal" id="matrix-help">{d.matrixHelp}</p>
      </div>

      <!-- Pan Depth & Covering -->
      <div>
        <label for="pan-select" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5">
          {d.panLabel}
        </label>
        <select 
          id="pan-select"
          class="w-full bg-surface border border-hairline rounded-xl px-3.5 py-2.5 text-xs text-ink focus:outline-hidden focus:ring-2 focus:ring-sky-500 shadow-2xs cursor-pointer"
        >
          {panOptions.map((p) => (
            <option value={p.id} selected={p.id === 'standard_50mm_perforated_lid'}>
              {p.name}
            </option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1 leading-normal" id="pan-help">{d.panHelp}</p>
      </div>

      <!-- Evaporator Frost State -->
      <div>
        <label for="frost-select" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5">
          {d.frostLabel}
        </label>
        <select 
          id="frost-select"
          class="w-full bg-surface border border-hairline rounded-xl px-3.5 py-2.5 text-xs text-ink focus:outline-hidden focus:ring-2 focus:ring-sky-500 shadow-2xs cursor-pointer"
        >
          {frostStates.map((f) => (
            <option value={f.id} selected={f.id === 'light_frost_buildup'}>
              {f.name}
            </option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1 leading-normal" id="frost-help">{d.frostHelp}</p>
      </div>
    </div>

    <!-- Right Column: Sliders -->
    <div class="space-y-6 bg-surface-soft border border-hairline rounded-2xl p-6">
      <div class="border-b border-hairline pb-2">
        <h4 class="text-sm font-bold uppercase tracking-wider text-ink">Fine-Tuning Operational Variables</h4>
        <p class="text-xs text-muted">Adjust physical velocities, thermal setpoints, and layer depths</p>
      </div>

      <!-- Air Velocity Slider -->
      <div>
        <div class="flex items-center justify-between text-xs font-bold mb-1">
          <span class="text-ink">{d.velocitySliderLabel}</span>
          <span class="font-mono text-sky-600 dark:text-sky-400 text-sm" id="velocity-val">4.5 m/s (885 FPM)</span>
        </div>
        <input 
          type="range"
          id="velocity-slider"
          min="1.0"
          max="8.0"
          step="0.1"
          value="4.5"
          class="w-full accent-sky-500 cursor-pointer"
        />
        <p class="text-[11px] text-muted mt-1">{d.velocitySliderHelp}</p>
      </div>

      <!-- Initial Core Temp Slider -->
      <div>
        <div class="flex items-center justify-between text-xs font-bold mb-1">
          <span class="text-ink">{d.tempSliderLabel}</span>
          <span class="font-mono text-amber-600 dark:text-amber-400 text-sm" id="temp-val">75.0°C (167.0°F)</span>
        </div>
        <input 
          type="range"
          id="temp-slider"
          min="60.0"
          max="95.0"
          step="1.0"
          value="75.0"
          class="w-full accent-amber-500 cursor-pointer"
        />
        <p class="text-[11px] text-muted mt-1">{d.tempSliderHelp}</p>
      </div>

      <!-- Air Setpoint Temp Slider -->
      <div>
        <div class="flex items-center justify-between text-xs font-bold mb-1">
          <span class="text-ink">{d.airTempSliderLabel}</span>
          <span class="font-mono text-indigo-600 dark:text-indigo-400 text-sm" id="air-temp-val">-28.0°C (-18.4°F)</span>
        </div>
        <input 
          type="range"
          id="air-temp-slider"
          min="-38.0"
          max="-10.0"
          step="1.0"
          value="-28.0"
          class="w-full accent-indigo-500 cursor-pointer"
        />
        <p class="text-[11px] text-muted mt-1">{d.airTempSliderHelp}</p>
      </div>

      <!-- Pan Depth Slider -->
      <div>
        <div class="flex items-center justify-between text-xs font-bold mb-1">
          <span class="text-ink">{d.depthSliderLabel}</span>
          <span class="font-mono text-emerald-600 dark:text-emerald-400 text-sm" id="depth-val">50 mm (2.0 in)</span>
        </div>
        <input 
          type="range"
          id="depth-slider"
          min="20"
          max="150"
          step="5"
          value="50"
          class="w-full accent-emerald-500 cursor-pointer"
        />
        <p class="text-[11px] text-muted mt-1">{d.depthSliderHelp}</p>
      </div>
    </div>
  </div>

  <!-- Telemetry Output Dashboard -->
  <div class="bg-surface-soft border border-hairline rounded-2xl p-6 md:p-8 mb-10">
    <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-hairline mb-6">
      <div>
        <h3 class="text-lg md:text-xl font-extrabold text-ink">{d.diagnosticTitle}</h3>
        <p class="text-xs text-muted">{d.diagnosticSub}</p>
      </div>
      <div id="status-pill" class="px-4 py-1.5 rounded-full text-xs font-bold tracking-wide uppercase bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 border border-emerald-500/30">
        COMPLIANT: 90-MIN PULL-DOWN OK
      </div>
    </div>

    <!-- Metrics Cards 3x2 Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-8">
      <!-- Metric 1: Pull Down Time -->
      <div class="bg-surface border border-hairline rounded-xl p-4 shadow-2xs">
        <div class="text-[11px] uppercase tracking-wider font-bold text-muted mb-1">{d.pullDownTimeLabel}</div>
        <div class="text-2xl font-black font-mono text-ink" id="out-pulldown">74.5 min</div>
        <div class="text-[11px] text-muted mt-1" id="out-pulldown-sub">Target: ≤ 90 min (UK/ECFA)</div>
      </div>

      <!-- Metric 2: Danger Zone Time -->
      <div class="bg-surface border border-hairline rounded-xl p-4 shadow-2xs">
        <div class="text-[11px] uppercase tracking-wider font-bold text-muted mb-1">{d.dangerZoneTimeLabel}</div>
        <div class="text-2xl font-black font-mono text-ink" id="out-danger-zone">42.0 min</div>
        <div class="text-[11px] text-muted mt-1" id="out-danger-sub">FDA CCP Limit: ≤ 120 min</div>
      </div>

      <!-- Metric 3: Clostridium perfringens Growth -->
      <div class="bg-surface border border-hairline rounded-xl p-4 shadow-2xs">
        <div class="text-[11px] uppercase tracking-wider font-bold text-muted mb-1">{d.clostridiumGrowthLabel}</div>
        <div class="text-2xl font-black font-mono text-emerald-600 dark:text-emerald-400" id="out-clostridium">+0.22 log₁₀</div>
        <div class="text-[11px] text-muted mt-1" id="out-clostridium-sub">Safe limit: &lt; 1.0 log₁₀</div>
      </div>

      <!-- Metric 4: Bacillus cereus Emetic Toxin Risk -->
      <div class="bg-surface border border-hairline rounded-xl p-4 shadow-2xs">
        <div class="text-[11px] uppercase tracking-wider font-bold text-muted mb-1">{d.cereusRiskLabel}</div>
        <div class="text-xl font-black font-mono text-ink" id="out-cereus">LOW / NEGLIGIBLE</div>
        <div class="text-[11px] text-muted mt-1" id="out-cereus-sub">Cereulide emetic toxin kinetics</div>
      </div>

      <!-- Metric 5: Moisture Loss & Frost Load -->
      <div class="bg-surface border border-hairline rounded-xl p-4 shadow-2xs">
        <div class="text-[11px] uppercase tracking-wider font-bold text-muted mb-1">{d.frostLoadLabel}</div>
        <div class="text-2xl font-black font-mono text-ink" id="out-frost">145 g / batch</div>
        <div class="text-[11px] text-muted mt-1" id="out-frost-sub">Latent vapor condensation on fins</div>
      </div>

      <!-- Metric 6: Bio-Aerosol Cross Contamination -->
      <div class="bg-surface border border-hairline rounded-xl p-4 shadow-2xs">
        <div class="text-[11px] uppercase tracking-wider font-bold text-muted mb-1">{d.aerosolRiskLabel}</div>
        <div class="text-xl font-black font-mono text-emerald-600 dark:text-emerald-400" id="out-aerosol">LOW (18 / 100)</div>
        <div class="text-[11px] text-muted mt-1" id="out-aerosol-sub">Listeria monocytogenes fan dispersal</div>
      </div>
    </div>

    <!-- Detailed Assessment Panels -->
    <div class="space-y-4 text-xs">
      <div class="bg-surface border border-hairline rounded-xl p-4">
        <span class="font-bold text-ink uppercase tracking-wider block mb-1">
          {d.primaryRiskLabel}
        </span>
        <p class="text-muted leading-relaxed" id="out-primary-risk">
          Standard operational mode with controlled convective pull-down. Minimal risk of Clostridium perfringens or Bacillus cereus germination.
        </p>
      </div>

      <div class="bg-surface border border-hairline rounded-xl p-4">
        <span class="font-bold text-ink uppercase tracking-wider block mb-1">
          {d.mechanismsLabel}
        </span>
        <p class="text-muted leading-relaxed" id="out-mechanisms">
          High-velocity laminar flow (4.5 m/s) strips the stagnant boundary layer, maintaining an elevated convective heat transfer coefficient. Shallow 50 mm geometry keeps the internal Biot number low, allowing rapid heat flux from core to surface.
        </p>
      </div>

      <div class="bg-surface border border-hairline rounded-xl p-4">
        <span class="font-bold text-ink uppercase tracking-wider block mb-1">
          {d.mitigationLabel}
        </span>
        <p class="text-muted leading-relaxed" id="out-mitigations">
          Maintain 50 mm perforated stainless covers during blast chill cycles. Schedule daily warm water drain flush and enzymatic coil sanitization to prevent psychrotrophic Listeria colonization.
        </p>
      </div>
    </div>

    <!-- Export Button -->
    <div class="mt-6 flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-hairline">
      <button 
        type="button"
        id="copy-report-btn"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-sky-600 hover:bg-sky-700 text-white font-medium text-xs transition shadow-xs cursor-pointer"
      >
        <span>📋</span> {d.copyReportBtn}
      </button>
      <span id="copied-toast" class="text-xs text-emerald-600 dark:text-emerald-400 font-bold hidden">
        ✓ {d.copiedFeedback}
      </span>
    </div>
  </div>

  <!-- Hardware Specification Reference Table -->
  <div class="mb-10">
    <div class="mb-4">
      <h3 class="text-lg font-bold text-ink">{d.tableTitle}</h3>
      <p class="text-xs text-muted">{d.tableSub}</p>
    </div>

    <div class="overflow-x-auto border border-hairline rounded-2xl shadow-2xs">
      <table class="w-full text-left text-xs">
        <thead class="bg-surface-soft border-b border-hairline text-ink font-bold">
          <tr>
            <th class="p-3.5">{d.colChiller}</th>
            <th class="p-3.5">{d.colPower}</th>
            <th class="p-3.5">{d.colAirflow}</th>
            <th class="p-3.5">{d.colCapacity}</th>
            <th class="p-3.5">{d.colDefrost}</th>
            <th class="p-3.5">{d.colAerosolRisk}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline bg-surface text-muted">
          {architectures.map((arch) => (
            <tr class="hover:bg-surface-soft/60 transition">
              <td class="p-3.5 font-medium text-ink">{arch.name}</td>
              <td class="p-3.5 font-mono">{(arch.coolingPowerWatts / 1000).toFixed(1)} kW</td>
              <td class="p-3.5 font-mono">{arch.fanVelocityMps} m/s ({arch.airFlowCfm} CFM)</td>
              <td class="p-3.5 font-mono">{arch.capacityKg} kg</td>
              <td class="p-3.5 text-[11px]">{arch.defrostType}</td>
              <td class="p-3.5">
                <span class={`inline-block px-2 py-0.5 rounded text-[10px] font-bold ${
                  arch.baselineAerosolRisk.includes('LOW') ? 'bg-emerald-500/10 text-emerald-600' :
                  arch.baselineAerosolRisk.includes('MODERATE') ? 'bg-amber-500/10 text-amber-600' :
                  'bg-rose-500/10 text-rose-600'
                }`}>
                  {arch.baselineAerosolRisk}
                </span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Golden Rules Section -->
  <div class="border-t border-hairline pt-8">
    <div class="mb-6">
      <h3 class="text-lg font-bold text-ink">{d.rulesTitle}</h3>
      <p class="text-xs text-muted">{d.rulesSub}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
      <div class="bg-surface-soft border border-hairline rounded-2xl p-4">
        <div class="flex items-center gap-2 font-bold text-ink mb-1">
          <span class="text-sky-500">1.</span> {d.rule1Title}
        </div>
        <p class="text-muted leading-relaxed">{d.rule1Text}</p>
      </div>

      <div class="bg-surface-soft border border-hairline rounded-2xl p-4">
        <div class="flex items-center gap-2 font-bold text-ink mb-1">
          <span class="text-sky-500">2.</span> {d.rule2Title}
        </div>
        <p class="text-muted leading-relaxed">{d.rule2Text}</p>
      </div>

      <div class="bg-surface-soft border border-hairline rounded-2xl p-4">
        <div class="flex items-center gap-2 font-bold text-ink mb-1">
          <span class="text-sky-500">3.</span> {d.rule3Title}
        </div>
        <p class="text-muted leading-relaxed">{d.rule3Text}</p>
      </div>

      <div class="bg-surface-soft border border-hairline rounded-2xl p-4">
        <div class="flex items-center gap-2 font-bold text-ink mb-1">
          <span class="text-sky-500">4.</span> {d.rule4Title}
        </div>
        <p class="text-muted leading-relaxed">{d.rule4Text}</p>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ architectures, foodMatrices, panOptions, frostStates }}>
  (function() {
    const el = (id) => document.getElementById(id);

    const chillerSelect = el('chiller-select');
    const matrixSelect = el('matrix-select');
    const panSelect = el('pan-select');
    const frostSelect = el('frost-select');

    const velocitySlider = el('velocity-slider');
    const tempSlider = el('temp-slider');
    const airTempSlider = el('air-temp-slider');
    const depthSlider = el('depth-slider');

    const velocityVal = el('velocity-val');
    const tempVal = el('temp-val');
    const airTempVal = el('air-temp-val');
    const depthVal = el('depth-val');

    const outPulldown = el('out-pulldown');
    const outPulldownSub = el('out-pulldown-sub');
    const outDangerZone = el('out-danger-zone');
    const outDangerSub = el('out-danger-sub');
    const outClostridium = el('out-clostridium');
    const outClostridiumSub = el('out-clostridium-sub');
    const outCereus = el('out-cereus');
    const outCereusSub = el('out-cereus-sub');
    const outFrost = el('out-frost');
    const outFrostSub = el('out-frost-sub');
    const outAerosol = el('out-aerosol');
    const outAerosolSub = el('out-aerosol-sub');
    const statusPill = el('status-pill');

    const outPrimaryRisk = el('out-primary-risk');
    const outMechanisms = el('out-mechanisms');
    const outMitigations = el('out-mitigations');

    const copyBtn = el('copy-report-btn');
    const copiedToast = el('copied-toast');

    function calculate() {
      const arch = architectures.find(a => a.id === chillerSelect.value) || architectures[1];
      const mat = foodMatrices.find(m => m.id === matrixSelect.value) || foodMatrices[0];
      const pan = panOptions.find(p => p.id === panSelect.value) || panOptions[1];
      const frost = frostStates.find(f => f.id === frostSelect.value) || frostStates[1];

      const velocity = parseFloat(velocitySlider.value);
      const initTemp = parseFloat(tempSlider.value);
      const airTemp = parseFloat(airTempSlider.value);
      const depth = parseFloat(depthSlider.value);

      // Display current slider values
      const fpm = Math.round(velocity * 196.85);
      velocityVal.textContent = `${velocity.toFixed(1)} m/s (${fpm} FPM)`;
      const initTempF = ((initTemp * 9/5) + 32).toFixed(1);
      tempVal.textContent = `${initTemp.toFixed(1)}°C (${initTempF}°F)`;
      const airTempF = ((airTemp * 9/5) + 32).toFixed(1);
      airTempVal.textContent = `${airTemp.toFixed(1)}°C (${airTempF}°F)`;
      const depthIn = (depth / 25.4).toFixed(1);
      depthVal.textContent = `${Math.round(depth)} mm (${depthIn} in)`;

      // Heat transfer & pull-down physics modeling
      // Effective convective heat transfer coeff h (W/m²K)
      // Forced convection correlation: h ≈ 10.45 - v + 10 * sqrt(v)
      const h_coeff = 12.0 + (16.5 * Math.pow(velocity, 0.78));
      
      // Effective airflow reduction from frost
      const airflowFactor = (100 - frost.airflowReductionPercent) / 100;
      const effectiveH = h_coeff * airflowFactor * (pan.evaporativeCoolingFactor || 1.0);

      // Thermal resistance model: Conductive R_cond = (L/2) / k, Convective R_conv = 1 / effectiveH
      const L_half = (depth / 1000) / 2; // half thickness in meters
      const R_cond = L_half / mat.thermalConductivityWmk;
      const R_conv = 1 / Math.max(5, effectiveH);
      const R_total = R_cond + R_conv;

      // Biot number
      const Bi = effectiveH * L_half / mat.thermalConductivityWmk;

      // Total sensible + latent heat per unit area: q = rho * Cp * depth * (T_init - 3) + latent
      const deltaT_total = initTemp - 3.0; // target 3°C
      const heatCapacity = (mat.densityKgM3 * mat.specificHeatJkgK * (depth / 1000));
      
      // Base pull-down time in minutes
      // Lumped/distributed Fourier model adjustment
      let pullDownMinutes = (heatCapacity * R_total * Math.log((initTemp - airTemp) / (3.0 - airTemp)) / 60) * 1.35;
      pullDownMinutes *= pan.coolingTimeMultiplier;

      // Bound realistic minimum and maximums
      pullDownMinutes = Math.max(22, pullDownMinutes);

      // Time spent in 57°C to 21°C Danger Zone
      const dangerZoneFraction = Math.log((57.2 - airTemp) / (21.1 - airTemp)) / Math.log((initTemp - airTemp) / (3.0 - airTemp));
      const dangerMinutes = Math.max(12, pullDownMinutes * Math.max(0.28, Math.min(0.65, dangerZoneFraction)));

      // Spore kinetics: Clostridium perfringens growth
      // Generation time in stews is ~7.1 to 10 min at optimal 43°C.
      // Proliferation is function of time spent between 54°C and 25°C
      const clostridiumDwellMin = dangerMinutes * 0.75;
      const clostridiumGenerations = (clostridiumDwellMin / 14.5) * mat.clostridiumRiskFactor;
      const clostridiumLogGrowth = Math.max(0.05, (clostridiumGenerations * Math.log10(2)));

      // Bacillus cereus emetic toxin index
      let cereusVerdict = 'LOW / NEGLIGIBLE';
      if (mat.id === 'cooked_bulk_starch_rice_potatoes' && dangerMinutes > 85) {
        cereusVerdict = 'CRITICAL TOXIN HAZARD';
      } else if (dangerMinutes > 65 || mat.bacillusRiskFactor > 1.8) {
        cereusVerdict = 'ELEVATED / MONITOR';
      }

      // Moisture & frost accumulation (grams per batch)
      const baseFrost = pan.frostLoadGramsPerHour * (pullDownMinutes / 60);
      const frostGrams = Math.round(baseFrost * (mat.latentMoistureLossRatePercent / 3.5));

      // Bio-aerosol risk score (0 to 100)
      let aerosolScore = 15;
      if (frost.id === 'active_hot_gas_defrost_biofilm') aerosolScore += 55;
      if (frost.id === 'heavy_ice_solid_pack') aerosolScore += 30;
      if (arch.baselineAerosolRisk.includes('CRITICAL')) aerosolScore += 25;
      if (pan.id === 'shallow_25mm_uncovered') aerosolScore += 18;
      if (pan.id === 'deep_65mm_tight_foil') aerosolScore -= 20;
      aerosolScore = Math.max(5, Math.min(100, Math.round(aerosolScore)));

      // UI updates
      outPulldown.textContent = `${pullDownMinutes.toFixed(1)} min`;
      outDangerZone.textContent = `${dangerMinutes.toFixed(1)} min`;
      outClostridium.textContent = `+${clostridiumLogGrowth.toFixed(2)} log₁₀`;
      outCereus.textContent = cereusVerdict;
      outFrost.textContent = `${frostGrams} g / batch`;

      let aerosolColor = 'text-emerald-600 dark:text-emerald-400';
      let aerosolText = `LOW (${aerosolScore}/100)`;
      if (aerosolScore >= 70) {
        aerosolColor = 'text-rose-600 dark:text-rose-400';
        aerosolText = `HIGH HAZARD (${aerosolScore}/100)`;
      } else if (aerosolScore >= 40) {
        aerosolColor = 'text-amber-600 dark:text-amber-400';
        aerosolText = `MODERATE (${aerosolScore}/100)`;
      }
      outAerosol.className = `text-xl font-black font-mono ${aerosolColor}`;
      outAerosol.textContent = aerosolText;

      // Status Pill & Verdict
      const passes90Min = pullDownMinutes <= 90.0;
      const passesFda2Hr = dangerMinutes <= 120.0;
      const clostridiumSafe = clostridiumLogGrowth < 1.0;

      if (passes90Min && passesFda2Hr && clostridiumSafe && aerosolScore < 40) {
        statusPill.className = 'px-4 py-1.5 rounded-full text-xs font-bold tracking-wide uppercase bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 border border-emerald-500/30';
        statusPill.textContent = 'COMPLIANT: 90-MIN PULL-DOWN OK';
        outPulldownSub.textContent = 'Meets UK ECFA & FDA Gold Standard';
        outDangerSub.textContent = `Within 2-hr CCP limit (${(120 - dangerMinutes).toFixed(0)}m headroom)`;
        outClostridium.className = 'text-2xl font-black font-mono text-emerald-600 dark:text-emerald-400';
      } else if (passesFda2Hr && (!passes90Min || clostridiumLogGrowth >= 1.0 || aerosolScore >= 40)) {
        statusPill.className = 'px-4 py-1.5 rounded-full text-xs font-bold tracking-wide uppercase bg-amber-500/10 text-amber-700 dark:text-amber-300 border border-amber-500/30';
        statusPill.textContent = 'WARNING: 90-MIN TARGET BREACHED';
        outPulldownSub.textContent = `Exceeds 90 min target by +${(pullDownMinutes - 90).toFixed(1)}m`;
        outDangerSub.textContent = 'Meets US FDA 2-hr limit, but UK non-compliant';
        outClostridium.className = 'text-2xl font-black font-mono text-amber-600 dark:text-amber-400';
      } else {
        statusPill.className = 'px-4 py-1.5 rounded-full text-xs font-bold tracking-wide uppercase bg-rose-500/10 text-rose-700 dark:text-rose-300 border border-rose-500/30';
        statusPill.textContent = 'CRITICAL HACCP VIOLATION: SPORE OUTGROWTH';
        outPulldownSub.textContent = `Severe pull-down failure (${pullDownMinutes.toFixed(0)} min)`;
        outDangerSub.textContent = `Breaches 2-hr 57°C→21°C CCP by +${(dangerMinutes - 120).toFixed(0)}m!`;
        outClostridium.className = 'text-2xl font-black font-mono text-rose-600 dark:text-rose-400';
      }

      // Dynamic text updates for explanations
      if (pullDownMinutes > 90 || clostridiumLogGrowth >= 1.0) {
        outPrimaryRisk.textContent = `Excessive conductive path length and thermal mass trap sensible heat in the core of ${mat.name}. Food dwells in the 54°C–15°C zone for ${dangerMinutes.toFixed(1)} minutes, triggering rapid Clostridium perfringens spore reactivation (+${clostridiumLogGrowth.toFixed(2)} log₁₀ outgrowth).`;
        outMechanisms.textContent = `Food layer thickness (${depth} mm) produces a high Biot number (Bi = ${(Bi).toFixed(2)} > 0.1). Internal conductive thermal resistance (R_cond = ${R_cond.toFixed(3)} K/W) dominates over surface convection, rendering high air velocity ineffective at the pan geometric center.`;
        outMitigations.textContent = `Immediately divide food into shallow 25–50 mm pans. Ensure evaporator fins are defrosted and sanitized. Do not seal tightly with foil until core temperature drops below 21°C to preserve latent evaporative cooling flux.`;
      } else if (aerosolScore >= 60) {
        outPrimaryRisk.textContent = `Elevated risk of Listeria monocytogenes and psychrotrophic mold bio-aerosol cross-contamination. Stagnant moisture and organic residues in the evaporator drain pan are sheared by ${velocity.toFixed(1)} m/s air currents into droplet nuclei.`;
        outMechanisms.textContent = `High-velocity air circulation entrains fine aerosol droplets from wet defrost coils. Uncovered food trays act as passive deposition surfaces for viable microbial cells.`;
        outMitigations.textContent = `Install perforated stainless steel blast chiller lids. Execute automated hot water flush of drain pan and apply dual-quaternary ammonium or peracetic acid foam sanitation to evaporator coil fins.`;
      } else {
        outPrimaryRisk.textContent = `Optimal thermodynamic pull-down rate. Food core successfully crosses the 57°C to 21°C microbiological danger zone in ${dangerMinutes.toFixed(1)} minutes, holding bacterial spore proliferation to negligible levels.`;
        outMechanisms.textContent = `Airflow velocity (${velocity.toFixed(1)} m/s) strips the boundary layer while 50 mm depth maintains low conductive resistance. Latent evaporative heat removal efficiently supplements sensible convective cooling.`;
        outMitigations.textContent = `Maintain current standard operating procedure (SOP). Log calibrated 3-point core needle temperature probes on automated HACCP compliance records.`;
      }
    }

    // Preset handlers
    el('preset-gold')?.addEventListener('click', () => {
      chillerSelect.value = 'reach_in_10_pan_commercial_chiller';
      matrixSelect.value = 'dense_viscous_beef_stew';
      panSelect.value = 'standard_50mm_perforated_lid';
      frostSelect.value = 'pristine_clean_fins';
      velocitySlider.value = '6.5';
      tempSlider.value = '75.0';
      airTempSlider.value = '-32.0';
      depthSlider.value = '50';
      calculate();
    });

    el('preset-spore')?.addEventListener('click', () => {
      chillerSelect.value = 'aged_compromised_chiller_neglect';
      matrixSelect.value = 'dense_viscous_beef_stew';
      panSelect.value = 'overloaded_100mm_plastic_wrap';
      frostSelect.value = 'moderate_choked_frost';
      velocitySlider.value = '2.0';
      tempSlider.value = '85.0';
      airTempSlider.value = '-16.0';
      depthSlider.value = '100';
      calculate();
    });

    el('preset-aerosol')?.addEventListener('click', () => {
      chillerSelect.value = 'reach_in_10_pan_commercial_chiller';
      matrixSelect.value = 'poultry_bone_stock_broth';
      panSelect.value = 'shallow_25mm_uncovered';
      frostSelect.value = 'active_hot_gas_defrost_biofilm';
      velocitySlider.value = '5.8';
      tempSlider.value = '70.0';
      airTempSlider.value = '-22.0';
      depthSlider.value = '35';
      calculate();
    });

    el('preset-cereus')?.addEventListener('click', () => {
      chillerSelect.value = 'compact_countertop_5_pan_chiller';
      matrixSelect.value = 'cooked_bulk_starch_rice_potatoes';
      panSelect.value = 'deep_65mm_tight_foil';
      frostSelect.value = 'light_frost_buildup';
      velocitySlider.value = '3.0';
      tempSlider.value = '80.0';
      airTempSlider.value = '-20.0';
      depthSlider.value = '65';
      calculate();
    });

    // Event listeners for inputs
    [chillerSelect, matrixSelect, panSelect, frostSelect].forEach(sel => {
      sel?.addEventListener('change', calculate);
    });

    [velocitySlider, tempSlider, airTempSlider, depthSlider].forEach(slider => {
      slider?.addEventListener('input', calculate);
    });

    // Copy audit report
    copyBtn?.addEventListener('click', () => {
      const archName = chillerSelect.options[chillerSelect.selectedIndex].text;
      const matName = matrixSelect.options[matrixSelect.selectedIndex].text;
      const panName = panSelect.options[panSelect.selectedIndex].text;
      const frostName = frostSelect.options[frostSelect.selectedIndex].text;

      const report = `======================================================================
ISITKITCHENSAFE BLAST CHILLER THERMODYNAMIC & SPORE AUDIT REPORT
======================================================================
Generated: ${new Date().toISOString()}
Compliance Standard: FDA Food Code 2022 § 3-501.14 & UK ECFA 90-Min Rule

ENGINEERING PARAMETERS:
- Chiller Architecture: ${archName}
- Food Matrix: ${matName}
- Pan Depth & Covering: ${panName} (Layer depth: ${depthSlider.value} mm)
- Evaporator Coil Status: ${frostName}
- Air Velocity across Pan: ${velocitySlider.value} m/s
- Initial Core Food Temp: ${tempSlider.value}°C
- Air Chamber Setpoint: ${airTempSlider.value}°C

DIAGNOSTIC TELEMETRY:
- 70°C → 3°C Pull-Down Time: ${outPulldown.textContent}
- 57°C → 21°C Critical Zone Time: ${outDangerZone.textContent}
- Clostridium perfringens Proliferation: ${outClostridium.textContent}
- Bacillus cereus Emetic Toxin Risk: ${outCereus.textContent}
- Moisture Loss & Frost Load: ${outFrost.textContent}
- Evaporator Bio-Aerosol Risk: ${outAerosol.textContent}
- Status & Verdict: ${statusPill.textContent}

RISK EVALUATION:
${outPrimaryRisk.textContent.trim()}

MECHANISMS:
${outMechanisms.textContent.trim()}

RECOMMENDED SANITARY MITIGATIONS:
${outMitigations.textContent.trim()}
======================================================================`;

      navigator.clipboard.writeText(report).then(() => {
        copiedToast.classList.remove('hidden');
        setTimeout(() => copiedToast.classList.add('hidden'), 3500);
      });
    });

    // Initial run
    calculate();
  })();
</script>
