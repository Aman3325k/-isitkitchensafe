---
import rawData from '../data/cast-iron-seasoning-troubleshooter-data.json';
import type { SupportedLanguage } from '../i18n/ui';
import { useTranslatedPath } from '../i18n/utils';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;
const translatePath = useTranslatedPath(lang);

const cookwareOvenUrl = translatePath('/tools/cookware-oven-temp-lookup/');
const smokePointUrl = translatePath('/tools/cooking-oil-smoke-point-finder/');
const symbolDecoderUrl = translatePath('/tools/kitchen-symbol-decoder/');
const methodologyUrl = translatePath('/methodology/');
const allToolsUrl = translatePath('/tools/');

type PanTypeId = 'cast-iron' | 'carbon-steel' | 'enameled';
type SeverityLevel = 'low' | 'moderate' | 'high' | 'critical';
type CookSafetyLevel = 'safe' | 'caution' | 'unsafe';
type OilRating = 'top-pick' | 'best-everyday' | 'classic' | 'high-heat' | 'warning' | 'avoid';

interface LocalizedPanType {
  id: PanTypeId;
  icon: string;
  isEnameled: boolean;
  label: string;
  sub: string;
  shortNote: string;
}

interface LocalizedSymptom {
  id: string;
  icon: string;
  severity: SeverityLevel;
  cookSafety: CookSafetyLevel;
  needsFullStrip: boolean;
  defaultOilId: string;
  recommendedTempF: number;
  recommendedTempC: number;
  bakeMinutes: number;
  roundsRecommended: number;
  shortLabel: string;
  title: string;
  severityLabel: string;
  verdictLabel: string;
  rootCause: string;
  safetyVerdict: string;
  steps: string[];
  carbonSteelNote: string;
  preventionTip: string;
}

interface LocalizedOil {
  id: string;
  rating: OilRating;
  durability: number;
  smokePointF: number;
  smokePointC: number;
  bakeTempF: number;
  bakeTempC: number;
  bakeMinutes: number;
  coolMinutes: number;
  name: string;
  badge: string;
  pros: string;
  cons: string;
  warning: string;
}

const localizedPanTypes: LocalizedPanType[] = rawData.panTypes.map((p) => {
  const tr = (p.i18n as Record<string, any>)[lang] || p.i18n.en;
  return {
    id: p.id as PanTypeId,
    icon: p.icon,
    isEnameled: Boolean(p.isEnameled),
    label: tr.label,
    sub: tr.sub,
    shortNote: tr.shortNote
  };
});

const localizedEnameledAlert =
  (rawData.enameledAlert as Record<string, {
    badge: string;
    title: string;
    summary: string;
    stepsTitle: string;
    steps: string[];
    safetyCallout: string;
  }>)[lang] || rawData.enameledAlert.en;

const localizedSymptoms: LocalizedSymptom[] = rawData.symptoms.map((s) => {
  const tr = (s.i18n as Record<string, any>)[lang] || s.i18n.en;
  return {
    id: s.id,
    icon: s.icon,
    severity: s.severity as SeverityLevel,
    cookSafety: s.cookSafety as CookSafetyLevel,
    needsFullStrip: Boolean(s.needsFullStrip),
    defaultOilId: s.defaultOilId,
    recommendedTempF: s.recommendedTempF,
    recommendedTempC: s.recommendedTempC,
    bakeMinutes: s.bakeMinutes,
    roundsRecommended: s.roundsRecommended,
    shortLabel: tr.shortLabel,
    title: tr.title,
    severityLabel: tr.severityLabel,
    verdictLabel: tr.verdictLabel,
    rootCause: tr.rootCause,
    safetyVerdict: tr.safetyVerdict,
    steps: tr.steps,
    carbonSteelNote: tr.carbonSteelNote,
    preventionTip: tr.preventionTip
  };
});

const localizedOils: LocalizedOil[] = rawData.oils.map((o) => {
  const tr = (o.i18n as Record<string, any>)[lang] || o.i18n.en;
  return {
    id: o.id,
    rating: o.rating as OilRating,
    durability: o.durability,
    smokePointF: o.smokePointF,
    smokePointC: o.smokePointC,
    bakeTempF: o.bakeTempF,
    bakeTempC: o.bakeTempC,
    bakeMinutes: o.bakeMinutes,
    coolMinutes: o.coolMinutes,
    name: tr.name,
    badge: tr.badge,
    pros: tr.pros,
    cons: tr.cons,
    warning: tr.warning
  };
});

const localizedFaqs: Array<{ question: string; answer: string }> =
  (rawData.faqs as Record<string, Array<{ question: string; answer: string }>>)[lang] ||
  rawData.faqs.en;

