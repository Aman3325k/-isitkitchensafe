const t = UI[lang] || UI.en;
const defaultUnit: 'F' | 'C' = lang === 'en' ? 'F' : 'C';
const defaultPanType = localizedPanTypes[0]; // cast-iron
const defaultSymptom = localizedSymptoms[0]; // sticky-tacky
const defaultOil = localizedOils.find((o) => o.id === defaultSymptom.defaultOilId) || localizedOils[0];

function formatTemp(f: number, c: number, unit: 'F' | 'C'): string {
  return unit === 'F' ? `${f}°F (${c}°C)` : `${c}°C (${f}°F)`;
}

function getSafetyPillClass(safety: CookSafetyLevel): string {
  if (safety === 'safe') return 'badge-yes';
  if (safety === 'caution') return 'badge-depends';
  return 'badge-no';
}

function getSeverityDotClass(severity: SeverityLevel): string {
  if (severity === 'low') return 'bg-emerald-500/20 text-emerald-700 dark:text-emerald-300 border-emerald-500/40';
  if (severity === 'moderate') return 'bg-amber-500/20 text-amber-800 dark:text-amber-300 border-amber-500/40';
  if (severity === 'high') return 'bg-orange-500/20 text-orange-800 dark:text-orange-300 border-orange-500/40';
  return 'bg-red-500/20 text-red-800 dark:text-red-300 border-red-500/40';
}

function getOilBadgeClass(rating: OilRating): string {
  if (rating === 'top-pick' || rating === 'best-everyday' || rating === 'classic') return 'badge-yes';
  if (rating === 'high-heat') return 'badge-depends';
  return 'badge-no';
}

const clientPayload = {
  lang,
  defaultUnit,
  panTypes: localizedPanTypes,
  enameledAlert: localizedEnameledAlert,
  symptoms: localizedSymptoms,
  oils: localizedOils,
  ui: t
};
---

<div id="cast-iron-troubleshooter-root" class="space-y-12">
  <!-- Main Interactive Troubleshooter Card -->
  <section
    id="cast-iron-seasoning-troubleshooter"
    class="bg-canvas border border-hairline rounded-2xl shadow-sm overflow-hidden"
    aria-label={t.ariaLabel}
  >
    <script type="application/json" id="cist-payload" set:html={JSON.stringify(clientPayload)} />

    <!-- Top Bar: Step 1 Pan Type Toggle + °F/°C Unit Switch -->
    <div class="p-5 sm:p-6 border-b border-hairline bg-surface-soft/50 space-y-4 print:hidden">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 class="text-title-sm font-semibold text-ink">{t.step1Title}</h2>
        <div class="flex items-center gap-2">
          <span class="text-xs font-semibold text-muted">{t.unitLabel}:</span>
          <div
            class="inline-flex rounded-lg border border-hairline bg-canvas p-0.5"
            role="radiogroup"
            aria-label={t.unitLabel}
          >
            <button
              type="button"
              role="radio"
              aria-checked={defaultUnit === 'F' ? 'true' : 'false'}
              data-cist-unit="F"
              class={`cist-unit-btn px-3 py-1 rounded-md text-xs font-bold transition-all cursor-pointer ${
                defaultUnit === 'F' ? 'bg-primary text-on-primary' : 'text-ink hover:bg-surface-soft'
              }`}
            >
              °F
            </button>
            <button
              type="button"
              role="radio"
              aria-checked={defaultUnit === 'C' ? 'true' : 'false'}
              data-cist-unit="C"
              class={`cist-unit-btn px-3 py-1 rounded-md text-xs font-bold transition-all cursor-pointer ${
                defaultUnit === 'C' ? 'bg-primary text-on-primary' : 'text-ink hover:bg-surface-soft'
              }`}
            >
              °C
            </button>
          </div>
        </div>
      </div>

      <!-- 3 Pan Type Cards -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-2.5" role="radiogroup" aria-label={t.step1Title}>
        {localizedPanTypes.map((pan) => {
          const isSelected = pan.id === defaultPanType.id;
          return (
            <button
              type="button"
              role="radio"
              aria-checked={isSelected ? 'true' : 'false'}
              data-cist-pan={pan.id}
              class={`cist-pan-btn p-3.5 rounded-xl border text-left transition-all cursor-pointer ${
                isSelected
                  ? 'bg-primary text-on-primary border-primary shadow-sm'
                  : pan.isEnameled
                    ? 'bg-warning-bg/55 dark:bg-amber-950/25 text-ink border-warning-border/80 hover:border-error-border'
                    : 'bg-canvas text-ink border-hairline hover:border-border-strong'
              }`}
            >
              <span class="flex items-center justify-between gap-2">
                <span class="text-sm font-bold leading-snug">
                  {pan.icon} {pan.label}
                </span>
                {pan.isEnameled && (
                  <span class="text-[10px] font-extrabold uppercase px-1.5 py-0.5 rounded bg-error-border text-white shrink-0">
                    ⚠️
                  </span>
                )}
              </span>
              <span class="block text-[11px] opacity-85 mt-0.5 leading-tight">{pan.sub}</span>
            </button>
          );
        })}
      </div>

      <p id="cist-pan-note" class="text-xs text-body bg-canvas border border-hairline rounded-xl px-3.5 py-2.5 leading-relaxed">
        {defaultPanType.shortNote}
      </p>
    </div>

    <!-- Explicit Enameled Cast Iron Warning Banner (Shown immediately when Enameled is selected) -->
    <div
      id="cist-enameled-panel"
      class="hidden border-b-2 border-error-border bg-error-bg/60 dark:bg-red-950/35 p-5 sm:p-6 space-y-4"
      role="region"
      aria-label={localizedEnameledAlert.title}
    >
      <div class="space-y-2 max-w-4xl">
        <span class="inline-block px-2.5 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wider bg-error-border text-white">
          🚨 {localizedEnameledAlert.badge}
        </span>
        <h2 class="text-title-md font-extrabold text-ink leading-snug">
          {localizedEnameledAlert.title}
        </h2>
        <p class="text-xs sm:text-sm text-body leading-relaxed">
          {localizedEnameledAlert.summary}
        </p>
      </div>

      <div class="p-4 rounded-xl bg-canvas border border-error-border/60 space-y-2.5">
        <h3 class="text-xs sm:text-sm font-bold text-ink">{localizedEnameledAlert.stepsTitle}</h3>
        <ol class="space-y-2 text-xs sm:text-[13px] text-body list-decimal list-inside">
          {localizedEnameledAlert.steps.map((step) => (
            <li class="leading-relaxed">{step}</li>
          ))}
        </ol>
      </div>

      <div class="flex flex-wrap items-center justify-between gap-3 p-3.5 rounded-xl bg-warning-bg/75 dark:bg-amber-950/40 border border-warning-border">
        <p class="text-xs font-bold text-ink leading-snug">
          ⚠️ {localizedEnameledAlert.safetyCallout}
        </p>
        <button
          type="button"
          id="cist-enameled-back-btn"
          class="min-h-[38px] px-3.5 py-1.5 rounded-lg text-xs font-bold bg-primary text-on-primary hover:bg-primary-active transition-colors cursor-pointer shrink-0 print:hidden"
        >
          {t.enameledSwitchBack}
        </button>
      </div>
    </div>

    <!-- Main 2-Column Diagnostic Grid: 8 Symptom Cards + Live Step-by-Step Rescue Protocol Dashboard -->
    <div id="cist-diagnostic-grid" class="grid grid-cols-1 lg:grid-cols-12 divide-y lg:divide-y-0 lg:divide-x divide-hairline">
      <!-- Left Column: 8 Clickable Symptom Diagnostic Cards -->
      <div class="lg:col-span-5 p-5 sm:p-6 space-y-4 print:hidden">
        <div>
          <h2 class="text-title-sm font-semibold text-ink">{t.step2Title}</h2>
          <p class="text-xs text-muted mt-0.5">{t.step2Sub}</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-1 gap-2.5" role="radiogroup" aria-label={t.step2Title}>
          {localizedSymptoms.map((sym) => {
            const isSelected = sym.id === defaultSymptom.id;
            return (
              <button
                type="button"
                role="radio"
                aria-checked={isSelected ? 'true' : 'false'}
                data-cist-symptom={sym.id}
                class={`cist-symptom-btn w-full p-3.5 rounded-xl border text-left transition-all cursor-pointer flex items-start gap-3 ${
                  isSelected
                    ? 'bg-surface-soft border-signature-coral ring-2 ring-signature-coral shadow-sm'
                    : 'bg-canvas border-hairline hover:border-border-strong'
                }`}
              >
                <span aria-hidden="true" class="text-xl leading-none mt-0.5 shrink-0">{sym.icon}</span>
                <div class="min-w-0 flex-1 space-y-1">
                  <div class="flex flex-wrap items-center justify-between gap-1.5">
                    <span class="text-xs sm:text-[13px] font-bold text-ink leading-snug">
                      {sym.title}
                    </span>
                  </div>
                  <span class={`inline-block px-2 py-0.5 rounded border text-[10.5px] font-bold ${getSeverityDotClass(sym.severity)}`}>
                    {sym.severityLabel}
                  </span>
                </div>
              </button>
            );
          })}
        </div>
      </div>

      <!-- Right Column: Live Step-by-Step Rescue Protocol Dashboard -->
      <div class="lg:col-span-7 p-5 sm:p-6 bg-surface-soft/40 flex flex-col justify-between space-y-5">
        <div class="space-y-4">
          <!-- High-Contrast Dark Verdict Banner -->
          <div
            id="cist-rescue-banner"
            aria-live="polite"
            class="rounded-2xl bg-surface-dark text-on-dark p-5 sm:p-6 space-y-4 shadow-sm border-l-4 border-success-border"
          >
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span class="text-[11px] font-bold uppercase tracking-wider text-signature-peach">
                {t.dashboardBadge} · <span id="cist-active-pan-label">{defaultPanType.label}</span>
              </span>
              <span id="cist-verdict-pill" class={getSafetyPillClass(defaultSymptom.cookSafety)}>
                {defaultSymptom.verdictLabel}
              </span>
            </div>

            <div class="flex items-start gap-3">
              <span id="cist-banner-icon" aria-hidden="true" class="text-2xl leading-none mt-0.5 shrink-0">
                {defaultSymptom.icon}
              </span>
              <div class="min-w-0 space-y-1.5">
                <h2 id="cist-banner-title" class="text-lg sm:text-xl font-extrabold tracking-tight text-white leading-snug">
                  {defaultSymptom.title}
                </h2>
                <p id="cist-safety-verdict" class="text-xs sm:text-[13px] text-white/90 leading-relaxed">
                  {defaultSymptom.safetyVerdict}
                </p>
              </div>
            </div>

            <!-- 3-Metric Quick Strip: Oil / Oven Temp / Bake Cycle -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 pt-1">
              <div class="p-3 rounded-xl bg-white/5 border border-white/10">
                <span class="block text-[10.5px] font-medium text-white/70">{t.recommendedOilLabel}</span>
                <span id="cist-rec-oil" class="block text-xs sm:text-[13px] font-bold text-signature-yellow mt-0.5">
                  {defaultOil.name}
                </span>
              </div>
              <div class="p-3 rounded-xl bg-white/5 border border-white/10">
                <span class="block text-[10.5px] font-medium text-white/70">{t.ovenTempLabel}</span>
                <span id="cist-rec-temp" class="block text-xs sm:text-[13px] font-mono font-bold text-signature-mint mt-0.5">
                  {formatTemp(defaultSymptom.recommendedTempF, defaultSymptom.recommendedTempC, defaultUnit)}
                </span>
              </div>
              <div class="p-3 rounded-xl bg-white/5 border border-white/10">
                <span class="block text-[10.5px] font-medium text-white/70">{t.bakeCycleLabel}</span>
                <span id="cist-rec-cycle" class="block text-xs sm:text-[13px] font-bold text-white mt-0.5">
                  {defaultSymptom.bakeMinutes} {t.minUnit} × {defaultSymptom.roundsRecommended}
                </span>
              </div>
            </div>
          </div>

          <!-- Root Cause Box -->
          <div class="p-4 rounded-xl bg-canvas border border-hairline space-y-1">
            <h3 class="text-xs font-bold uppercase tracking-wider text-ink flex items-center gap-1.5">
              <span aria-hidden="true">🔬</span> {t.rootCauseTitle}
            </h3>
            <p id="cist-root-cause" class="text-xs sm:text-[13px] text-body leading-relaxed">
              {defaultSymptom.rootCause}
            </p>
          </div>

          <!-- Numbered Step-by-Step Rescue Plan -->
          <div class="p-4 sm:p-5 rounded-xl bg-canvas border border-hairline space-y-3">
            <h3 class="text-xs sm:text-sm font-bold uppercase tracking-wider text-ink flex items-center gap-1.5">
              <span aria-hidden="true">🛠️</span> {t.rescueStepsTitle}
            </h3>
            <ol id="cist-steps-list" class="space-y-2.5 text-xs sm:text-[13.5px] text-body list-decimal list-outside pl-5">
              {defaultSymptom.steps.map((step) => (
                <li class="leading-relaxed pl-1">{step}</li>
              ))}
            </ol>
          </div>

          <!-- Carbon Steel Specific Note (Revealed when Carbon Steel mode is active) -->
          <div
            id="cist-carbon-note-box"
            class="hidden p-4 rounded-xl bg-warning-bg/60 dark:bg-amber-950/30 border border-warning-border/80 space-y-1"
          >
            <h3 class="text-xs font-bold uppercase tracking-wider text-ink flex items-center gap-1.5">
              <span aria-hidden="true">🥘</span> {t.carbonSteelBadge}
            </h3>
            <p id="cist-carbon-note" class="text-xs sm:text-[13px] text-body leading-relaxed">
              {defaultSymptom.carbonSteelNote}
            </p>
          </div>

          <!-- Prevention Tip -->
          <div class="p-4 rounded-xl bg-surface-soft border border-hairline space-y-1">
            <h3 class="text-xs font-bold uppercase tracking-wider text-ink flex items-center gap-1.5">
              <span aria-hidden="true">🛡️</span> {t.preventionTitle}
            </h3>
            <p id="cist-prevention-tip" class="text-xs sm:text-[13px] text-body leading-relaxed">
              {defaultSymptom.preventionTip}
            </p>
          </div>

          <!-- Action Buttons: Copy / Print / Reset -->
          <div class="flex flex-wrap items-center gap-2.5 pt-1 print:hidden">
            <button
              type="button"
              id="cist-copy-btn"
              class="min-h-[44px] flex-1 px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold bg-primary text-on-primary hover:bg-primary-active transition-colors cursor-pointer shadow-sm"
            >
              <span id="cist-copy-label">📋 {t.copyBtn}</span>
            </button>
            <button
              type="button"
              id="cist-print-btn"
              class="min-h-[44px] px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold bg-canvas text-ink border border-hairline hover:border-signature-coral transition-colors cursor-pointer"
            >
              🖨️ {t.printBtn}
            </button>
            <button
              type="button"
              id="cist-reset-btn"
              class="min-h-[44px] px-3.5 py-2.5 rounded-xl text-xs sm:text-sm font-semibold bg-canvas text-muted border border-hairline hover:border-border-strong hover:text-ink transition-colors cursor-pointer"
            >
              {t.resetBtn}
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Interactive Seasoning Oil Selector & Bake Temp Calculator -->
    <div class="border-t border-hairline p-5 sm:p-6 space-y-5">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-3">
        <div>
          <h2 class="text-title-md font-semibold text-ink">{t.oilCalcTitle}</h2>
          <p class="text-xs text-muted mt-0.5">{t.oilCalcSub}</p>
        </div>

        <!-- Coat Rounds Selector -->
        <div class="flex flex-wrap items-center gap-2 print:hidden">
          <span class="text-xs font-semibold text-muted">{t.coatsLabel}</span>
          <div class="inline-flex rounded-lg border border-hairline bg-surface-soft p-0.5" role="radiogroup" aria-label={t.coatsLabel}>
            <button
              type="button"
              role="radio"
              aria-checked="false"
              data-cist-coats="1"
              class="cist-coats-btn px-2.5 py-1.5 rounded-md text-xs font-bold transition-all cursor-pointer text-ink hover:bg-canvas"
            >
              {t.coat1}
            </button>
            <button
              type="button"
              role="radio"
              aria-checked="true"
              data-cist-coats="2"
              class="cist-coats-btn px-2.5 py-1.5 rounded-md text-xs font-bold transition-all cursor-pointer bg-primary text-on-primary"
            >
              {t.coat2}
            </button>
            <button
              type="button"
              role="radio"
              aria-checked="false"
              data-cist-coats="3"
              class="cist-coats-btn px-2.5 py-1.5 rounded-md text-xs font-bold transition-all cursor-pointer text-ink hover:bg-canvas"
            >
              {t.coat3}
            </button>
          </div>
        </div>
      </div>

      <!-- 6 Oil Selector Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {localizedOils.map((oil) => {
          const isSelected = oil.id === defaultOil.id;
          return (
            <button
              type="button"
              data-cist-oil={oil.id}
              aria-pressed={isSelected ? 'true' : 'false'}
              class={`cist-oil-btn p-4 rounded-xl border text-left transition-all cursor-pointer flex flex-col justify-between gap-2 ${
                isSelected
                  ? 'bg-surface-soft border-signature-coral ring-2 ring-signature-coral shadow-sm'
                  : oil.rating === 'avoid' || oil.rating === 'warning'
                    ? 'bg-error-bg/35 dark:bg-red-950/20 border-error-border/60 hover:border-error-border'
                    : 'bg-canvas border-hairline hover:border-border-strong'
              }`}
            >
              <div class="flex items-start justify-between gap-2 w-full">
                <span class="text-sm font-bold text-ink leading-snug">{oil.name}</span>
                <span class={`shrink-0 ${getOilBadgeClass(oil.rating)}`}>{oil.badge}</span>
              </div>
              <div class="flex items-center justify-between gap-2 text-xs text-muted pt-1 border-t border-hairline/60 w-full">
                <span data-cist-oil-card-temp={oil.id} class="font-mono font-bold text-ink">
                  🔥 {formatTemp(oil.bakeTempF, oil.bakeTempC, defaultUnit)}
                </span>
                <span class="font-semibold">
                  {oil.durability}/5 ★
                </span>
              </div>
            </button>
          );
        })}
      </div>

      <!-- Live Oil Polymerization Readout Panel -->
      <div
        id="cist-oil-detail"
        aria-live="polite"
        class="p-5 rounded-2xl bg-surface-soft border border-hairline space-y-4"
      >
        <div class="flex flex-wrap items-center justify-between gap-2">
          <h3 id="cist-oil-name" class="text-title-sm font-bold text-ink">{defaultOil.name}</h3>
          <span id="cist-oil-badge" class={getOilBadgeClass(defaultOil.rating)}>{defaultOil.badge}</span>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-5 gap-2.5">
          <div class="p-3 rounded-xl bg-canvas border border-hairline">
            <span class="block text-[11px] text-muted font-medium">{t.oilBakeTemp}</span>
            <span id="cist-oil-bake-temp" class="block text-sm font-mono font-extrabold text-ink mt-0.5">
              {formatTemp(defaultOil.bakeTempF, defaultOil.bakeTempC, defaultUnit)}
            </span>
          </div>
          <div class="p-3 rounded-xl bg-canvas border border-hairline">
            <span class="block text-[11px] text-muted font-medium">{t.oilSmokePoint}</span>
            <span id="cist-oil-smoke-temp" class="block text-sm font-mono font-bold text-ink mt-0.5">
              {formatTemp(defaultOil.smokePointF, defaultOil.smokePointC, defaultUnit)}
            </span>
          </div>
          <div class="p-3 rounded-xl bg-canvas border border-hairline">
            <span class="block text-[11px] text-muted font-medium">{t.oilBakeTime}</span>
            <span id="cist-oil-bake-time" class="block text-sm font-bold text-ink mt-0.5">
              60 {t.minUnit} × 2
            </span>
          </div>
          <div class="p-3 rounded-xl bg-canvas border border-hairline">
            <span class="block text-[11px] text-muted font-medium">{t.oilCoolTime}</span>
            <span id="cist-oil-cool-time" class="block text-sm font-bold text-ink mt-0.5">
              60 {t.minUnit} × 2
            </span>
          </div>
          <div class="p-3 rounded-xl bg-canvas border border-hairline col-span-2 sm:col-span-1">
            <span class="block text-[11px] text-muted font-medium">{t.oilTotalTime}</span>
            <span id="cist-oil-total-time" class="block text-sm font-extrabold text-signature-coral mt-0.5">
              4 {t.hrUnit}
            </span>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <div class="p-3.5 rounded-xl bg-canvas border border-hairline space-y-1">
            <span class="text-[11px] font-bold uppercase tracking-wider text-muted block">✅ {t.oilProsLabel}</span>
            <p id="cist-oil-pros" class="text-xs sm:text-[13px] text-body leading-relaxed">{defaultOil.pros}</p>
          </div>
          <div class="p-3.5 rounded-xl bg-canvas border border-hairline space-y-1">
            <span class="text-[11px] font-bold uppercase tracking-wider text-muted block">📌 {t.oilConsLabel}</span>
            <p id="cist-oil-cons" class="text-xs sm:text-[13px] text-body leading-relaxed">{defaultOil.cons}</p>
          </div>
        </div>

        <!-- Dynamic Oil Warning Callout (Flaxseed / EVOO / Avocado) -->
        <div
          id="cist-oil-warning-box"
          class="hidden p-4 rounded-xl bg-error-bg/55 dark:bg-red-950/30 border border-error-border/75 space-y-1"
        >
          <span class="text-xs font-extrabold uppercase tracking-wider text-ink block">
            ⚠️ {t.oilWarningTitle}
          </span>
          <p id="cist-oil-warning-text" class="text-xs sm:text-[13px] text-body leading-relaxed"></p>
        </div>

        <p class="text-[12px] text-muted leading-relaxed">
          💡 {t.upsideDownNote}
        </p>
      </div>
    </div>

    <!-- 3 Science-Backed Rules Strip -->
    <div class="border-t border-hairline p-5 sm:p-6 bg-surface-soft/50 space-y-4">
      <div>
        <h2 class="text-title-md font-semibold text-ink">{t.rulesTitle}</h2>
        <p class="text-xs text-muted mt-0.5">{t.rulesSub}</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <article class="p-4 rounded-xl border bg-canvas border-hairline space-y-1.5">
          <div class="flex items-center gap-2">
            <span aria-hidden="true" class="text-lg">🧼</span>
            <h3 class="text-xs sm:text-sm font-bold text-ink leading-snug">{t.rule1Title}</h3>
          </div>
          <p class="text-xs text-body leading-relaxed">{t.rule1Body}</p>
        </article>
        <article class="p-4 rounded-xl border bg-warning-bg/55 dark:bg-amber-950/25 border-warning-border/70 space-y-1.5">
          <div class="flex items-center gap-2">
            <span aria-hidden="true" class="text-lg">🧻</span>
            <h3 class="text-xs sm:text-sm font-bold text-ink leading-snug">{t.rule2Title}</h3>
          </div>
          <p class="text-xs text-body leading-relaxed">{t.rule2Body}</p>
        </article>
        <article class="p-4 rounded-xl border bg-canvas border-hairline space-y-1.5">
          <div class="flex items-center gap-2">
            <span aria-hidden="true" class="text-lg">🔥</span>
            <h3 class="text-xs sm:text-sm font-bold text-ink leading-snug">{t.rule3Title}</h3>
          </div>
          <p class="text-xs text-body leading-relaxed">{t.rule3Body}</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Related Companion Tools -->
  <section class="space-y-4 print:hidden">
    <h2 class="text-title-md font-semibold text-ink">{t.relatedHeading}</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      <a
        href={cookwareOvenUrl}
        class="p-6 rounded-2xl bg-surface-soft border border-hairline hover:border-signature-coral transition-all group block"
      >
        <span class="text-[11px] font-bold uppercase tracking-wider text-signature-coral block mb-1.5">
          {t.relatedOvenTag}
        </span>
        <h3 class="text-title-sm font-semibold text-ink group-hover:text-signature-coral transition-colors mb-1.5">
          {t.relatedOvenTitle}
        </h3>
        <p class="text-[13.5px] text-body leading-relaxed">{t.relatedOvenDesc}</p>
      </a>

      <a
        href={smokePointUrl}
        class="p-6 rounded-2xl bg-surface-soft border border-hairline hover:border-signature-coral transition-all group block"
      >
        <span class="text-[11px] font-bold uppercase tracking-wider text-signature-coral block mb-1.5">
          {t.relatedSmokeTag}
        </span>
        <h3 class="text-title-sm font-semibold text-ink group-hover:text-signature-coral transition-colors mb-1.5">
          {t.relatedSmokeTitle}
        </h3>
        <p class="text-[13.5px] text-body leading-relaxed">{t.relatedSmokeDesc}</p>
      </a>

      <a
        href={symbolDecoderUrl}
        class="p-6 rounded-2xl bg-surface-soft border border-hairline hover:border-signature-coral transition-all group block"
      >
        <span class="text-[11px] font-bold uppercase tracking-wider text-signature-coral block mb-1.5">
          {t.relatedSymbolTag}
        </span>
        <h3 class="text-title-sm font-semibold text-ink group-hover:text-signature-coral transition-colors mb-1.5">
          {t.relatedSymbolTitle}
        </h3>
        <p class="text-[13.5px] text-body leading-relaxed">{t.relatedSymbolDesc}</p>
      </a>
    </div>
  </section>

  <!-- Methodology & Hub Strip -->
  <section class="p-6 rounded-2xl bg-surface-soft border border-hairline print:hidden">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <h2 class="text-title-sm font-semibold text-ink mb-1">{t.methodologyStripTitle}</h2>
        <p class="text-[13px] text-muted">
          {t.methodologyStripPrefix}{' '}
          <a href={methodologyUrl} class="text-link underline hover:text-link-active">{t.methodologyLabel}</a>.
        </p>
      </div>
      <div class="flex flex-wrap gap-2">
        <a
          href={smokePointUrl}
          class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral transition-colors"
        >
          {t.smokePointLabel}
        </a>
        <a
          href={methodologyUrl}
          class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral transition-colors"
        >
          {t.methodologyLabel}
        </a>
        <a
          href={allToolsUrl}
          class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-primary text-on-primary hover:bg-primary-active transition-colors"
        >
          {t.allToolsLabel}
        </a>
      </div>
    </div>
  </section>

  <!-- Visible FAQ Accordion (Matches JSON-LD 1:1) -->
  <section class="print:hidden">
    <h2 class="text-title-lg font-medium text-ink tracking-tight mb-6">
      {t.faqTitle}
    </h2>
    <div class="space-y-4">
      {localizedFaqs.map((faq) => (
        <details class="group p-5 bg-surface-soft border border-hairline rounded-xl" open>
          <summary class="text-title-sm font-semibold text-ink cursor-pointer list-none flex items-center justify-between gap-3">
            <span>{faq.question}</span>
            <span class="text-muted text-sm transition-transform group-open:rotate-180 shrink-0" aria-hidden="true">&#9662;</span>
          </summary>
          <p class="text-[14px] text-body leading-relaxed mt-3 pt-3 border-t border-hairline/70">
            {faq.answer}
          </p>
        </details>
      ))}
    </div>
  </section>
</div>

<script is:inline>
  (function () {
    const payloadEl = document.getElementById('cist-payload');
    if (!payloadEl) return;

    let payload;
    try {
      payload = JSON.parse(payloadEl.textContent || '{}');
    } catch (_) {
      return;
    }

    const panTypes = payload.panTypes || [];
    const symptoms = payload.symptoms || [];
    const oils = payload.oils || [];
    const ui = payload.ui || {};

    if (!panTypes.length || !symptoms.length || !oils.length) return;

    const panById = new Map(panTypes.map(function (p) { return [p.id, p]; }));
    const symById = new Map(symptoms.map(function (s) { return [s.id, s]; }));
    const oilById = new Map(oils.map(function (o) { return [o.id, o]; }));

    // Controls
    const panBtns = Array.from(document.querySelectorAll('.cist-pan-btn'));
    const unitBtns = Array.from(document.querySelectorAll('.cist-unit-btn'));
    const symptomBtns = Array.from(document.querySelectorAll('.cist-symptom-btn'));
    const oilBtns = Array.from(document.querySelectorAll('.cist-oil-btn'));
    const coatsBtns = Array.from(document.querySelectorAll('.cist-coats-btn'));

    // Dashboard outputs
    const panNoteEl = document.getElementById('cist-pan-note');
    const enameledPanel = document.getElementById('cist-enameled-panel');
    const enameledBackBtn = document.getElementById('cist-enameled-back-btn');
    const diagnosticGrid = document.getElementById('cist-diagnostic-grid');

    const rescueBanner = document.getElementById('cist-rescue-banner');
    const activePanLabel = document.getElementById('cist-active-pan-label');
    const verdictPill = document.getElementById('cist-verdict-pill');
    const bannerIcon = document.getElementById('cist-banner-icon');
    const bannerTitle = document.getElementById('cist-banner-title');
    const safetyVerdictEl = document.getElementById('cist-safety-verdict');
    const recOilEl = document.getElementById('cist-rec-oil');
    const recTempEl = document.getElementById('cist-rec-temp');
    const recCycleEl = document.getElementById('cist-rec-cycle');
    const rootCauseEl = document.getElementById('cist-root-cause');
    const stepsListEl = document.getElementById('cist-steps-list');
    const carbonNoteBox = document.getElementById('cist-carbon-note-box');
    const carbonNoteEl = document.getElementById('cist-carbon-note');
    const preventionTipEl = document.getElementById('cist-prevention-tip');

    // Oil calculator outputs
    const oilNameEl = document.getElementById('cist-oil-name');
    const oilBadgeEl = document.getElementById('cist-oil-badge');
    const oilBakeTempEl = document.getElementById('cist-oil-bake-temp');
    const oilSmokeTempEl = document.getElementById('cist-oil-smoke-temp');
    const oilBakeTimeEl = document.getElementById('cist-oil-bake-time');
    const oilCoolTimeEl = document.getElementById('cist-oil-cool-time');
    const oilTotalTimeEl = document.getElementById('cist-oil-total-time');
    const oilProsEl = document.getElementById('cist-oil-pros');
    const oilConsEl = document.getElementById('cist-oil-cons');
    const oilWarningBox = document.getElementById('cist-oil-warning-box');
    const oilWarningText = document.getElementById('cist-oil-warning-text');

    // Action buttons
    const copyBtn = document.getElementById('cist-copy-btn');
    const copyLabel = document.getElementById('cist-copy-label');
    const printBtn = document.getElementById('cist-print-btn');
    const resetBtn = document.getElementById('cist-reset-btn');

    const state = {
      panId: 'cast-iron',
      unit: payload.defaultUnit === 'C' ? 'C' : 'F',
      symptomId: symptoms[0].id,
      oilId: symptoms[0].defaultOilId || oils[0].id,
      coats: 2
    };

    let lastRescueText = '';

    function fmtTemp(f, c) {
      if (state.unit === 'C') {
        return c + '°C (' + f + '°F)';
      }
      return f + '°F (' + c + '°C)';
    }

    function getSafetyPillClass(safety) {
      if (safety === 'safe') return 'badge-yes';
      if (safety === 'caution') return 'badge-depends';
      return 'badge-no';
    }

    function getOilBadgeClass(rating) {
      if (rating === 'top-pick' || rating === 'best-everyday' || rating === 'classic') return 'badge-yes';
      if (rating === 'high-heat') return 'badge-depends';
      return 'badge-no';
    }

    function render() {
      const activePan = panById.get(state.panId) || panTypes[0];
      const activeSym = symById.get(state.symptomId) || symptoms[0];
      const recOil = oilById.get(activeSym.defaultOilId) || oils[0];
      const activeOil = oilById.get(state.oilId) || oils[0];
      const isEnameled = Boolean(activePan.isEnameled);

      // Update unit toggle buttons
      unitBtns.forEach(function (btn) {
        const active = btn.getAttribute('data-cist-unit') === state.unit;
        btn.setAttribute('aria-checked', active ? 'true' : 'false');
        btn.classList.toggle('bg-primary', active);
        btn.classList.toggle('text-on-primary', active);
        btn.classList.toggle('text-ink', !active);
      });

      // Update pan type buttons
      panBtns.forEach(function (btn) {
        const pid = btn.getAttribute('data-cist-pan');
        const active = pid === state.panId;
        const pObj = panById.get(pid);
        const btnIsEnamel = Boolean(pObj && pObj.isEnameled);

        btn.setAttribute('aria-checked', active ? 'true' : 'false');
        btn.classList.remove(
          'bg-primary',
          'text-on-primary',
          'border-primary',
          'bg-error-border',
          'text-white',
          'border-error-border',
          'shadow-sm',
          'bg-canvas',
          'text-ink',
          'border-hairline',
          'bg-warning-bg/55',
          'dark:bg-amber-950/25',
          'border-warning-border/80'
        );

        if (active && btnIsEnamel) {
          btn.classList.add('bg-error-border', 'text-white', 'border-error-border', 'shadow-sm');
        } else if (active) {
          btn.classList.add('bg-primary', 'text-on-primary', 'border-primary', 'shadow-sm');
        } else if (btnIsEnamel) {
          btn.classList.add('bg-warning-bg/55', 'dark:bg-amber-950/25', 'text-ink', 'border-warning-border/80');
        } else {
          btn.classList.add('bg-canvas', 'text-ink', 'border-hairline');
        }
      });

      if (panNoteEl) {
        panNoteEl.textContent = activePan.shortNote;
      }

      // Enameled warning visibility
      if (enameledPanel) {
        enameledPanel.classList.toggle('hidden', !isEnameled);
      }
      if (diagnosticGrid) {
        diagnosticGrid.classList.toggle('opacity-55', isEnameled);
      }

      // Symptom button active styles
      symptomBtns.forEach(function (btn) {
        const active = btn.getAttribute('data-cist-symptom') === state.symptomId;
        btn.setAttribute('aria-checked', active ? 'true' : 'false');
        btn.classList.toggle('bg-surface-soft', active);
        btn.classList.toggle('border-signature-coral', active);
        btn.classList.toggle('ring-2', active);
        btn.classList.toggle('ring-signature-coral', active);
        btn.classList.toggle('shadow-sm', active);
        btn.classList.toggle('bg-canvas', !active);
        btn.classList.toggle('border-hairline', !active);
      });

      // Update Rescue Protocol Dashboard
      if (activePanLabel) activePanLabel.textContent = activePan.label;
      if (bannerIcon) bannerIcon.textContent = activeSym.icon;
      if (bannerTitle) bannerTitle.textContent = activeSym.title;
      if (safetyVerdictEl) safetyVerdictEl.textContent = activeSym.safetyVerdict;
      if (rootCauseEl) rootCauseEl.textContent = activeSym.rootCause;
      if (preventionTipEl) preventionTipEl.textContent = activeSym.preventionTip;

      if (verdictPill) {
        verdictPill.className = getSafetyPillClass(activeSym.cookSafety);
        verdictPill.textContent = activeSym.verdictLabel;
      }

      if (rescueBanner) {
        rescueBanner.classList.remove('border-success-border', 'border-warning-border', 'border-error-border');
        rescueBanner.classList.add(
          activeSym.cookSafety === 'safe'
            ? 'border-success-border'
            : activeSym.cookSafety === 'caution'
              ? 'border-warning-border'
              : 'border-error-border'
        );
      }

      if (recOilEl) recOilEl.textContent = recOil.name;
      if (recTempEl) recTempEl.textContent = fmtTemp(activeSym.recommendedTempF, activeSym.recommendedTempC);
      if (recCycleEl) {
        recCycleEl.textContent =
          activeSym.bakeMinutes + ' ' + (ui.minUnit || 'min') + ' × ' + activeSym.roundsRecommended;
      }

      // Render numbered rescue steps via pure DOM nodes
      if (stepsListEl) {
        while (stepsListEl.firstChild) {
          stepsListEl.removeChild(stepsListEl.firstChild);
        }
        (activeSym.steps || []).forEach(function (stepText) {
          const li = document.createElement('li');
          li.className = 'leading-relaxed pl-1';
          li.textContent = stepText;
          stepsListEl.appendChild(li);
        });
      }

      // Carbon Steel specific adjustment box
      const showCarbonNote = state.panId === 'carbon-steel' && Boolean(activeSym.carbonSteelNote);
      if (carbonNoteBox) {
        carbonNoteBox.classList.toggle('hidden', !showCarbonNote);
      }
      if (carbonNoteEl && activeSym.carbonSteelNote) {
        carbonNoteEl.textContent = activeSym.carbonSteelNote;
      }

      // Update Oil Selector cards & calculator
      oilBtns.forEach(function (btn) {
        const oid = btn.getAttribute('data-cist-oil');
        const active = oid === state.oilId;
        const oObj = oilById.get(oid);
        const isRisky = Boolean(oObj && (oObj.rating === 'avoid' || oObj.rating === 'warning'));

        btn.setAttribute('aria-pressed', active ? 'true' : 'false');
        btn.classList.remove(
          'bg-surface-soft',
          'border-signature-coral',
          'ring-2',
          'ring-signature-coral',
          'shadow-sm',
          'bg-canvas',
          'border-hairline',
          'bg-error-bg/35',
          'dark:bg-red-950/20',
          'border-error-border/60'
        );

        if (active) {
          btn.classList.add('bg-surface-soft', 'border-signature-coral', 'ring-2', 'ring-signature-coral', 'shadow-sm');
        } else if (isRisky) {
          btn.classList.add('bg-error-bg/35', 'dark:bg-red-950/20', 'border-error-border/60');
        } else {
          btn.classList.add('bg-canvas', 'border-hairline');
        }

        const cardTempEl = btn.querySelector('[data-cist-oil-card-temp]');
        if (cardTempEl && oObj) {
          cardTempEl.textContent = '🔥 ' + fmtTemp(oObj.bakeTempF, oObj.bakeTempC);
        }
      });

      coatsBtns.forEach(function (btn) {
        const cNum = Number(btn.getAttribute('data-cist-coats') || '2');
        const active = cNum === state.coats;
        btn.setAttribute('aria-checked', active ? 'true' : 'false');
        btn.classList.toggle('bg-primary', active);
        btn.classList.toggle('text-on-primary', active);
        btn.classList.toggle('text-ink', !active);
      });

      if (oilNameEl) oilNameEl.textContent = activeOil.name;
      if (oilBadgeEl) {
        oilBadgeEl.className = getOilBadgeClass(activeOil.rating);
        oilBadgeEl.textContent = activeOil.badge;
      }
      if (oilBakeTempEl) oilBakeTempEl.textContent = fmtTemp(activeOil.bakeTempF, activeOil.bakeTempC);
      if (oilSmokeTempEl) oilSmokeTempEl.textContent = fmtTemp(activeOil.smokePointF, activeOil.smokePointC);
      if (oilBakeTimeEl) {
        oilBakeTimeEl.textContent = activeOil.bakeMinutes + ' ' + (ui.minUnit || 'min') + ' × ' + state.coats;
      }
      if (oilCoolTimeEl) {
        oilCoolTimeEl.textContent = activeOil.coolMinutes + ' ' + (ui.minUnit || 'min') + ' × ' + state.coats;
      }
      if (oilTotalTimeEl) {
        const totalHours = ((activeOil.bakeMinutes + activeOil.coolMinutes) * state.coats) / 60;
        oilTotalTimeEl.textContent = totalHours + ' ' + (ui.hrUnit || 'hrs');
      }
      if (oilProsEl) oilProsEl.textContent = activeOil.pros;
      if (oilConsEl) oilConsEl.textContent = activeOil.cons;

      const hasWarning = Boolean(activeOil.warning && activeOil.warning.trim().length > 0);
      if (oilWarningBox) {
        oilWarningBox.classList.toggle('hidden', !hasWarning);
      }
      if (oilWarningText) {
        oilWarningText.textContent = activeOil.warning || '';
      }

      // Build copyable plain-text rescue plan
      const stepLines = (activeSym.steps || []).map(function (st, idx) {
        return '  ' + (idx + 1) + '. ' + st;
      });

      const summaryLines = [
        ui.copyHeader || 'Cast Iron & Carbon Steel Rescue Protocol',
        (ui.copyPanLine || 'Cookware') + ': ' + activePan.label,
        (ui.copySymptomLine || 'Symptom') + ': ' + activeSym.title,
        (ui.copyVerdictLine || 'Verdict') + ': ' + activeSym.verdictLabel + ' — ' + activeSym.safetyVerdict,
        (ui.copyCauseLine || 'Root Cause') + ': ' + activeSym.rootCause,
        (ui.copyOilTempLine || 'Recommended Oil & Oven Temp') +
          ': ' +
          recOil.name +
          ' @ ' +
          fmtTemp(activeSym.recommendedTempF, activeSym.recommendedTempC) +
          ' (' +
          activeSym.bakeMinutes +
          ' ' +
          (ui.minUnit || 'min') +
          ' x ' +
          activeSym.roundsRecommended +
          ')',
        '',
        ui.copyStepsHeader || 'Rescue Steps:',
        stepLines.join('\n'),
        '',
        (ui.copyPreventLine || 'Prevention') + ': ' + activeSym.preventionTip
      ];

      lastRescueText = summaryLines.join('\n');
    }

    // Event bindings
    panBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        const pid = btn.getAttribute('data-cist-pan');
        if (pid && panById.has(pid)) {
          state.panId = pid;
          render();
        }
      });
    });

    if (enameledBackBtn) {
      enameledBackBtn.addEventListener('click', function () {
        state.panId = 'cast-iron';
        render();
      });
    }

    unitBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        const u = btn.getAttribute('data-cist-unit');
        if (u === 'F' || u === 'C') {
          state.unit = u;
          render();
        }
      });
    });

    symptomBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        const sid = btn.getAttribute('data-cist-symptom');
        if (sid && symById.has(sid)) {
          state.symptomId = sid;
          const symObj = symById.get(sid);
          if (symObj && symObj.defaultOilId && oilById.has(symObj.defaultOilId)) {
            state.oilId = symObj.defaultOilId;
          }
          if (symObj && symObj.roundsRecommended) {
            state.coats = symObj.roundsRecommended;
          }
          if (state.panId === 'enameled') {
            state.panId = 'cast-iron';
          }
          render();
        }
      });
    });

    oilBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        const oid = btn.getAttribute('data-cist-oil');
        if (oid && oilById.has(oid)) {
          state.oilId = oid;
          render();
        }
      });
    });

    coatsBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        const cNum = Number(btn.getAttribute('data-cist-coats') || '2');
        if (cNum >= 1 && cNum <= 3) {
          state.coats = cNum;
          render();
        }
      });
    });

    if (copyBtn) {
      copyBtn.addEventListener('click', function () {
        const showCopied = function () {
          if (copyLabel) copyLabel.textContent = ui.copiedBtn || 'Rescue Plan Copied ✓';
          window.setTimeout(function () {
            if (copyLabel) copyLabel.textContent = '📋 ' + (ui.copyBtn || 'Copy Rescue Plan');
          }, 2200);
        };

        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(lastRescueText).then(showCopied).catch(showCopied);
        } else {
          const ta = document.createElement('textarea');
          ta.value = lastRescueText;
          ta.setAttribute('readonly', '');
          ta.style.position = 'absolute';
          ta.style.left = '-9999px';
          document.body.appendChild(ta);
          ta.select();
          try {
            document.execCommand('copy');
          } catch (_) {
            // ignore
          }
          document.body.removeChild(ta);
          showCopied();
        }
      });
    }

    if (printBtn) {
      printBtn.addEventListener('click', function () {
        window.print();
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', function () {
        state.panId = 'cast-iron';
        state.unit = payload.defaultUnit === 'C' ? 'C' : 'F';
        state.symptomId = symptoms[0].id;
        state.oilId = symptoms[0].defaultOilId || oils[0].id;
        state.coats = 2;
        render();
      });
    }

    render();
  })();
</script>
