    presetCider: "冷榨混浊苹果原汁低温超清澄清（1200 RPM, 0.8 bar TMP, 650 W超声, 0.1 µm SiC）",
    presetFermentation: "精密发酵真菌菌丝体细胞分离收获（1600 RPM, 1.2 bar TMP, 900 W超声, 0.2 µm ZrO2）",
    presetCitrus: "柑橘果皮冷榨精油萜烯微乳澄清（1100 RPM, 0.7 bar TMP, 550 W超声, 0.1 µm SiC）",
    presetElderberry: "北欧野生长接骨木莓花青素精萃（1350 RPM, 0.9 bar TMP, 700 W超声, 0.1 µm SiC）",
    presetFoulingHazard: "声波脱附关闭导致的严重滤饼堵塞过载工况（400 RPM, 0 W超声, 4500 NTU - 无声学脱附）",
    telemetryTitle: "实时流体动力学与物料澄清遥测",
    telemetrySub: "连续监测稳态渗透通量、表面剪切速率、清亮液浊度、滤饼阻力消除率、多酚保留率及吨能耗。",
    fluxLabel: "稳态渗透通量（J）：",
    shearRateLabel: "表面动态剪切速率（γ）：",
    clarityLabel: "出流清亮液浊度（NTU_out）：",
    cakeMitigationLabel: "凝胶滤饼流阻消除率（ΔR_ac）：",
    bioactiveRetentionLabel: "热敏活性成分与多酚保留率：",
    secLabel: "吨料比能耗（SEC）：",
    cipIntervalLabel: "CIP化学清洗连续运行间隔：",
    verdictLabel: "卫生级HACCP与质量合规鉴定：",
    diagramTitle: "旋转陶瓷盘动态微滤与超声波脱附工艺流程图",
    diagramSub: "动态呈现高速离心剪切场、28 kHz超声波微射流脱附及常温清澈渗透流的连续作业原理。",
    chartTitle: "工业液体澄清工艺综合性能雷达对比",
    chartSub: "对比DCM-LFAD与传统管式陶瓷膜微滤、硅藻土助滤板框压滤机及高速管式离心机。",
    scienceTitle: "流体力学剪切、声空化辐射力与Darcy-Starling定律",
    scienceSub: "解析边界层剪切速率、微射流空化冲击波、临界通量界限及串联阻力传质模型。",
    tableTitle: "工业液体澄清主流技术对比矩阵",
    exportAuditBtn: "导出DCM-LFAD工程技术审计报告"
  }
};

const d = DICT[lang] || DICT.en;
const data = dcmData;
---

<div class="dcm-engine-container bg-surface border border-hairline rounded-3xl p-6 sm:p-8 lg:p-10 shadow-xs mb-12">
  <!-- Header Badge & Title -->
  <div class="mb-8">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-sky-950 text-sky-400 border border-sky-800/80 mb-3">
      <span class="w-2 h-2 rounded-full bg-sky-400 animate-pulse"></span>
      {d.badge}
    </div>
    <h2 class="text-2xl sm:text-3xl font-extrabold text-ink tracking-tight mb-3">
      {d.title}
    </h2>
    <p class="text-body text-sm sm:text-base max-w-4xl leading-relaxed">
      {d.subtitle}
    </p>
  </div>

  <!-- Presets Bar -->
  <div class="bg-surface-soft border border-hairline rounded-2xl p-4 sm:p-5 mb-8">
    <div class="flex items-center justify-between gap-2 mb-3">
      <span class="text-xs font-bold uppercase tracking-wider text-ink">{d.presetsTitle}</span>
      <span class="text-[11px] text-muted">Click to auto-configure simulation</span>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-2.5">
      <button type="button" class="dcm-preset-btn text-left p-2.5 rounded-xl border border-hairline hover:border-sky-500 hover:bg-sky-500/10 transition-colors text-xs text-ink" data-preset="cider">
        🍎 <strong>{d.presetCider.split('(')[0]}</strong>
        <span class="block text-[11px] text-muted">({d.presetCider.split('(')[1]}</span>
      </button>
      <button type="button" class="dcm-preset-btn text-left p-2.5 rounded-xl border border-hairline hover:border-sky-500 hover:bg-sky-500/10 transition-colors text-xs text-ink" data-preset="fermentation">
        🌿 <strong>{d.presetFermentation.split('(')[0]}</strong>
        <span class="block text-[11px] text-muted">({d.presetFermentation.split('(')[1]}</span>
      </button>
      <button type="button" class="dcm-preset-btn text-left p-2.5 rounded-xl border border-hairline hover:border-sky-500 hover:bg-sky-500/10 transition-colors text-xs text-ink" data-preset="citrus">
        🍊 <strong>{d.presetCitrus.split('(')[0]}</strong>
        <span class="block text-[11px] text-muted">({d.presetCitrus.split('(')[1]}</span>
      </button>
      <button type="button" class="dcm-preset-btn text-left p-2.5 rounded-xl border border-hairline hover:border-sky-500 hover:bg-sky-500/10 transition-colors text-xs text-ink" data-preset="elderberry">
        🍇 <strong>{d.presetElderberry.split('(')[0]}</strong>
        <span class="block text-[11px] text-muted">({d.presetElderberry.split('(')[1]}</span>
      </button>
      <button type="button" class="dcm-preset-btn text-left p-2.5 rounded-xl border border-rose-900/60 hover:border-rose-500 hover:bg-rose-500/10 transition-colors text-xs text-ink" data-preset="foulingHazard">
        ⚠️ <strong>{d.presetFoulingHazard.split('(')[0]}</strong>
        <span class="block text-[11px] text-rose-400">({d.presetFoulingHazard.split('(')[1]}</span>
      </button>
    </div>
  </div>

  <!-- Main Grid: Controls + Live Telemetry -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-10">
    <!-- Controls Column (7 cols) -->
    <div class="lg:col-span-7 space-y-6">
      <div class="bg-surface-soft border border-hairline rounded-2xl p-5 sm:p-6">
        <h3 class="text-lg font-bold text-ink mb-1">{d.controlsTitle}</h3>
        <p class="text-xs text-muted mb-6">{d.controlsSub}</p>

        <!-- Select 1: Feedstock Selection -->
        <div class="mb-5">
          <label for="dcm-feed-select" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5">
            {d.feedstockLabel}
          </label>
          <select id="dcm-feed-select" class="w-full bg-surface border border-hairline rounded-xl px-3.5 py-2.5 text-xs text-ink focus:outline-hidden focus:border-sky-500">
            {data.feedstocksAndTurbidities.map(feed => (
              <option value={feed.id}>{feed.name}</option>
            ))}
          </select>
          <span class="block text-[11px] text-muted mt-1">{d.feedstockHelp}</span>
        </div>

        <!-- Select 2: Ceramic Membrane Material Selection -->
        <div class="mb-5">
          <label for="dcm-membrane-select" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5">
            {d.membraneLabel}
          </label>
          <select id="dcm-membrane-select" class="w-full bg-surface border border-hairline rounded-xl px-3.5 py-2.5 text-xs text-ink focus:outline-hidden focus:border-sky-500">
            {data.ceramicMembraneMaterials.map(mem => (
              <option value={mem.id}>{mem.name} ({mem.nominalPoreSizeMicrons} µm)</option>
            ))}
          </select>
          <span class="block text-[11px] text-muted mt-1">{d.membraneHelp}</span>
        </div>

        <!-- Slider 1: Disc Rotational Speed (RPM) -->
        <div class="mb-5">
          <div class="flex items-center justify-between mb-1.5">
            <label for="dcm-rpm-slider" class="text-xs font-bold uppercase tracking-wider text-ink">
              {d.rpmLabel}
            </label>
            <span id="dcm-rpm-val" class="text-xs font-mono font-bold px-2 py-0.5 rounded-md bg-sky-950 text-sky-400 border border-sky-800">
              1200 RPM
            </span>
          </div>
          <input 
            type="range" 
            id="dcm-rpm-slider" 
            min="400" 
            max="1800" 
            step="50" 
            value="1200" 
            class="w-full accent-sky-500 cursor-pointer"
          />
          <span class="block text-[11px] text-muted mt-1">{d.rpmHelp}</span>
        </div>

        <!-- Slider 2: Transmembrane Pressure (TMP) -->
        <div class="mb-5">
          <div class="flex items-center justify-between mb-1.5">
            <label for="dcm-tmp-slider" class="text-xs font-bold uppercase tracking-wider text-ink">
              {d.tmpLabel}
            </label>
            <span id="dcm-tmp-val" class="text-xs font-mono font-bold px-2 py-0.5 rounded-md bg-sky-950 text-sky-400 border border-sky-800">
              0.8 bar
            </span>
          </div>
          <input 
            type="range" 
            id="dcm-tmp-slider" 
            min="0.2" 
            max="2.5" 
            step="0.1" 
            value="0.8" 
            class="w-full accent-sky-500 cursor-pointer"
          />
          <span class="block text-[11px] text-muted mt-1">{d.tmpHelp}</span>
        </div>

        <!-- Slider 3: Acoustic Desorption Power (Watts) -->
        <div class="mb-5">
          <div class="flex items-center justify-between mb-1.5">
            <label for="dcm-power-slider" class="text-xs font-bold uppercase tracking-wider text-ink">
              {d.acousticPowerLabel}
            </label>
            <span id="dcm-power-val" class="text-xs font-mono font-bold px-2 py-0.5 rounded-md bg-cyan-950 text-cyan-400 border border-cyan-800">
              650 W
            </span>
          </div>
          <input 
            type="range" 
            id="dcm-power-slider" 
            min="0" 
            max="1200" 
            step="50" 
            value="650" 
            class="w-full accent-cyan-500 cursor-pointer"
          />
          <span class="block text-[11px] text-muted mt-1">{d.acousticPowerHelp}</span>
        </div>

        <!-- Slider 4: Feed Inflow Turbidity (NTU) -->
        <div class="mb-5">
          <div class="flex items-center justify-between mb-1.5">
            <label for="dcm-turbidity-slider" class="text-xs font-bold uppercase tracking-wider text-ink">
              {d.turbidityLabel}
            </label>
            <span id="dcm-turbidity-val" class="text-xs font-mono font-bold px-2 py-0.5 rounded-md bg-purple-950 text-purple-400 border border-purple-800">
              1450 NTU
            </span>
          </div>
          <input 
            type="range" 
            id="dcm-turbidity-slider" 
            min="500" 
            max="5000" 
            step="50" 
            value="1450" 
            class="w-full accent-purple-500 cursor-pointer"
          />
          <span class="block text-[11px] text-muted mt-1">{d.turbidityHelp}</span>
        </div>

        <!-- Slider 5: Operating Cross-Flow Temperature -->
        <div class="mb-2">
          <div class="flex items-center justify-between mb-1.5">
            <label for="dcm-temp-slider" class="text-xs font-bold uppercase tracking-wider text-ink">
              {d.tempLabel}
            </label>
            <span id="dcm-temp-val" class="text-xs font-mono font-bold px-2 py-0.5 rounded-md bg-emerald-950 text-emerald-400 border border-emerald-800">
              12.0 °C
            </span>
          </div>
          <input 
            type="range" 
            id="dcm-temp-slider" 
            min="6" 
            max="35" 
            step="1" 
            value="12" 
            class="w-full accent-emerald-500 cursor-pointer"
          />
          <span class="block text-[11px] text-muted mt-1">{d.tempHelp}</span>
        </div>
      </div>
    </div>

    <!-- Live Telemetry Column (5 cols) -->
    <div class="lg:col-span-5 space-y-6">
      <div class="bg-surface-soft border border-hairline rounded-2xl p-5 sm:p-6 sticky top-6">
        <div class="flex items-center justify-between gap-2 mb-2">
          <h3 class="text-lg font-bold text-ink">{d.telemetryTitle}</h3>
          <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-mono font-bold bg-emerald-950 text-emerald-400 border border-emerald-800">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            ACTIVE TELEMETRY
          </span>
        </div>
        <p class="text-xs text-muted mb-5">{d.telemetrySub}</p>

        <!-- Metric 1: Steady-State Permeate Flux -->
        <div class="bg-surface border border-hairline rounded-xl p-3.5 mb-3">
          <div class="flex items-center justify-between mb-1">
            <span class="text-xs text-muted font-medium">{d.fluxLabel}</span>
            <span id="telemetry-flux" class="text-xl font-extrabold text-sky-400 font-mono">
              420 LMH
            </span>
          </div>
          <span class="block text-[10px] text-muted">Liters per square meter per hour (L/m²·h)</span>
        </div>

        <!-- Metric 2: Surface Dynamic Shear Rate -->
        <div class="bg-surface border border-hairline rounded-xl p-3.5 mb-3">
          <div class="flex items-center justify-between mb-1">
            <span class="text-xs text-muted font-medium">{d.shearRateLabel}</span>
            <span id="telemetry-shear" class="text-xl font-extrabold text-cyan-400 font-mono">
              156,000 s⁻¹
            </span>
          </div>
          <span class="block text-[10px] text-muted">Displaces cake layer via centrifugal inertial lift</span>
        </div>

        <!-- Metric 3: Clarified Effluent Turbidity -->
        <div class="bg-surface border border-hairline rounded-xl p-3.5 mb-3">
          <div class="flex items-center justify-between mb-1">
            <span class="text-xs text-muted font-medium">{d.clarityLabel}</span>
            <span id="telemetry-turbidity" class="text-xl font-extrabold text-emerald-400 font-mono">
              0.42 NTU
            </span>
          </div>
          <span class="block text-[10px] text-muted">Brilliant optical clarity (99.97% turbidity reduction)</span>
        </div>

        <!-- Metric 4: Cake Resistance Mitigation -->
        <div class="bg-surface border border-hairline rounded-xl p-3.5 mb-3">
          <div class="flex items-center justify-between mb-1">
            <span class="text-xs text-muted font-medium">{d.cakeMitigationLabel}</span>
            <span id="telemetry-mitigation" class="text-base font-bold text-teal-400 font-mono">
              -84.5% ΔR_cake
            </span>
          </div>
          <span class="block text-[10px] text-muted">Ultrasonic micro-jet acoustic boundary desorption</span>
        </div>

        <!-- Metric 5: Bioactive & Polyphenol Retention -->
        <div class="bg-surface border border-hairline rounded-xl p-3.5 mb-3">
          <div class="flex items-center justify-between mb-1">
            <span class="text-xs text-muted font-medium">{d.bioactiveRetentionLabel}</span>
            <span id="telemetry-bioactive" class="text-base font-bold text-purple-400 font-mono">
              99.4% Preserved
            </span>
          </div>
          <span class="block text-[10px] text-muted">Zero thermal boiling, non-adsorptive SiC ceramic disc</span>
        </div>

        <!-- Metric 6: Specific Energy Consumption & CIP Runtime -->
        <div class="grid grid-cols-2 gap-2 mb-3">
          <div class="bg-surface border border-hairline rounded-xl p-3">
            <span class="text-[11px] text-muted block mb-0.5">{d.secLabel}</span>
            <span id="telemetry-sec" class="text-xs font-mono font-bold text-amber-400">
              0.58 kWh/m³
            </span>
          </div>
          <div class="bg-surface border border-hairline rounded-xl p-3">
            <span class="text-[11px] text-muted block mb-0.5">{d.cipIntervalLabel}</span>
            <span id="telemetry-cip" class="text-xs font-mono font-bold text-emerald-400">
              64 Hours
            </span>
          </div>
        </div>

        <!-- Metric 7: Overall Industrial Verdict Card -->
        <div id="telemetry-verdict-card" class="bg-surface border border-sky-800/80 rounded-xl p-4">
          <div class="flex items-center gap-2 mb-1.5">
            <span class="w-2 h-2 rounded-full bg-sky-400"></span>
            <span class="text-xs font-bold text-ink uppercase tracking-wider">{d.verdictLabel}</span>
          </div>
          <p id="telemetry-verdict-text" class="text-xs font-medium text-sky-200 leading-relaxed">
            FDA 21 CFR § 120 JUICE HACCP VALIDATED: >7.0-log microbial exclusion, 0.0 ppm chemical filter aid residues, 99.4% cold bioactive polyphenol preservation.
          </p>
        </div>

        <!-- Export Audit Button -->
        <button type="button" id="dcm-export-btn" class="mt-5 w-full py-2.5 px-4 rounded-xl bg-sky-700 hover:bg-sky-800 text-white text-center font-semibold text-xs transition-colors shadow-xs flex items-center justify-center gap-2">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          {d.exportAuditBtn}
        </button>
      </div>
    </div>
  </div>

  <!-- Interactive SVG Process Flow Diagram -->
  <div class="bg-surface-soft border border-hairline rounded-2xl p-6 sm:p-8 mb-10">
    <div class="mb-5">
      <h3 class="text-lg font-bold text-ink mb-1">{d.diagramTitle}</h3>
      <p class="text-xs text-muted">{d.diagramSub}</p>
    </div>

    <div class="w-full overflow-x-auto">
      <svg class="w-full min-w-[700px] h-[340px] rounded-xl bg-surface border border-hairline" viewBox="0 0 900 340" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="dcmGradFeed" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#b45309" stop-opacity="0.8" />
            <stop offset="100%" stop-color="#f59e0b" stop-opacity="0.9" />
          </linearGradient>
          <linearGradient id="dcmGradPermeate" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#0284c7" stop-opacity="0.8" />
            <stop offset="100%" stop-color="#38bdf8" stop-opacity="0.9" />
          </linearGradient>
          <linearGradient id="dcmGradCavitation" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#06b6d4" stop-opacity="0.9" />
            <stop offset="100%" stop-color="#3b82f6" stop-opacity="0.2" />
          </linearGradient>
        </defs>

        <!-- Background grid lines -->
        <g stroke="#334155" stroke-width="0.5" stroke-dasharray="3,3" opacity="0.3">
          <line x1="50" y1="50" x2="850" y2="50" />
          <line x1="50" y1="170" x2="850" y2="170" />
          <line x1="50" y1="290" x2="850" y2="290" />
        </g>

        <!-- PRESSURE VESSEL HOUSING -->
        <rect x="250" y="40" width="400" height="260" rx="20" fill="#0b1329" stroke="#38bdf8" stroke-width="2" />
        <text x="450" y="65" fill="#38bdf8" font-size="13" font-weight="bold" text-anchor="middle">ASME B31.3 Sanitary Ceramic Membrane Module (3-A 45-03)</text>
        <text x="450" y="82" fill="#94a3b8" font-size="10" text-anchor="middle">High-Pressure Stainless Steel Housing (316L Ra &lt; 0.4 µm)</text>

        <!-- CENTRAL ROTATING SHAFT (SPINDLE) -->
        <rect x="435" y="95" width="30" height="180" rx="4" fill="#475569" stroke="#94a3b8" stroke-width="1.5" />
        <text x="450" y="290" fill="#cbd5e1" font-size="10" font-weight="bold" text-anchor="middle">Rotational Spindle (N = 1200 RPM)</text>

        <!-- ROTATING CERAMIC DISCS (3 Discs displayed for schematic) -->
        <!-- Disc 1 -->
        <ellipse cx="450" cy="125" rx="140" ry="24" fill="#1e293b" stroke="#0ea5e9" stroke-width="2.5" />
        <ellipse cx="450" cy="125" rx="130" ry="20" fill="#0f172a" stroke="#38bdf8" stroke-dasharray="4,2" />
        <!-- Disc 2 -->
        <ellipse cx="450" cy="175" rx="140" ry="24" fill="#1e293b" stroke="#0ea5e9" stroke-width="2.5" />
        <ellipse cx="450" cy="175" rx="130" ry="20" fill="#0f172a" stroke="#38bdf8" stroke-dasharray="4,2" />
        <!-- Disc 3 -->
        <ellipse cx="450" cy="225" rx="140" ry="24" fill="#1e293b" stroke="#0ea5e9" stroke-width="2.5" />
        <ellipse cx="450" cy="225" rx="130" ry="20" fill="#0f172a" stroke="#38bdf8" stroke-dasharray="4,2" />

        <!-- SHEAR VECTOR ARROWS -->
        <path d="M 330 115 C 330 100 370 95 410 98" fill="none" stroke="#22d3ee" stroke-width="2" marker-end="url(#dcmArrow)" />
        <path d="M 570 135 C 570 150 530 155 490 152" fill="none" stroke="#22d3ee" stroke-width="2" marker-end="url(#dcmArrow)" />
        <text x="360" y="90" fill="#22d3ee" font-size="9" font-weight="bold">γ &gt; 150,000 s⁻¹</text>

        <!-- 28 kHz ULTRASONIC TRANSDUCER HORNS (IN-LINE) -->
        <!-- Horn Left -->
        <rect x="265" y="110" width="35" height="120" rx="6" fill="#0284c7" stroke="#38bdf8" stroke-width="1.5" />
        <text x="282" y="150" fill="#ffffff" font-size="9" font-weight="bold" transform="rotate(-90 282 150)" text-anchor="middle">28 kHz PZT SONICATOR</text>

        <!-- Ultrasonic Wavefronts Left -->
        <path d="M 305 130 Q 320 145 305 160" fill="none" stroke="#06b6d4" stroke-width="2" stroke-dasharray="2,2" />
        <path d="M 315 125 Q 335 145 315 165" fill="none" stroke="#06b6d4" stroke-width="2" stroke-dasharray="2,2" />
        <path d="M 325 120 Q 350 145 325 170" fill="none" stroke="#06b6d4" stroke-width="2" stroke-dasharray="2,2" />

        <!-- Horn Right -->
        <rect x="600" y="110" width="35" height="120" rx="6" fill="#0284c7" stroke="#38bdf8" stroke-width="1.5" />
        <text x="618" y="150" fill="#ffffff" font-size="9" font-weight="bold" transform="rotate(90 618 150)" text-anchor="middle">ACOUSTIC HORN (650 W)</text>

        <!-- Ultrasonic Wavefronts Right -->
        <path d="M 595 130 Q 580 145 595 160" fill="none" stroke="#06b6d4" stroke-width="2" stroke-dasharray="2,2" />
        <path d="M 585 125 Q 565 145 585 165" fill="none" stroke="#06b6d4" stroke-width="2" stroke-dasharray="2,2" />

        <!-- INFLOW: Turbid Feed Stream -->
        <path d="M 50 140 L 250 140" stroke="#f59e0b" stroke-width="3.5" />
        <text x="130" y="125" fill="#fbbf24" font-size="11" font-weight="bold" text-anchor="middle">Colloidal Feed Juice</text>
        <text x="130" y="160" fill="#94a3b8" font-size="9" text-anchor="middle">1,450 NTU • 12 °C Cold</text>

        <!-- RETENTATE: Concentrated Reject Recirculation -->
        <path d="M 250 240 L 50 240" stroke="#b45309" stroke-width="3" stroke-dasharray="5,2" />
        <text x="130" y="230" fill="#d97706" font-size="10" font-weight="bold" text-anchor="middle">Retentate Recirculation</text>
        <text x="130" y="260" fill="#94a3b8" font-size="9" text-anchor="middle">Concentrated Pectins &amp; Cells</text>

        <!-- OUTFLOW: Crystal-Clear Clarified Permeate (Drawn via Hollow Shaft) -->
        <path d="M 450 95 L 450 25 L 820 25 L 820 140" stroke="#38bdf8" stroke-width="3.5" />
        <rect x="730" y="140" width="140" height="90" rx="12" fill="#0f172a" stroke="#38bdf8" stroke-width="2" />
        <text x="800" y="168" fill="#38bdf8" font-size="11" font-weight="bold" text-anchor="middle">PERMEATE STREAM</text>
        <text x="800" y="188" fill="#4ade80" font-size="13" font-weight="extrabold" text-anchor="middle">&lt; 0.5 NTU Brilliant</text>
        <text x="800" y="210" fill="#94a3b8" font-size="9" text-anchor="middle">99.4% Polyphenols Intact</text>
      </svg>
    </div>
  </div>

  <!-- Technology Comparison Radar & Matrix -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-10">
    <!-- Bar Chart Comparison (5 cols) -->
    <div class="lg:col-span-5 bg-surface-soft border border-hairline rounded-2xl p-5 sm:p-6">
      <h3 class="text-lg font-bold text-ink mb-1">{d.chartTitle}</h3>
      <p class="text-xs text-muted mb-5">{d.chartSub}</p>

      <div class="space-y-4">
        <!-- Metric 1: Optical Clarity & Turbidity Reduction -->
        <div>
          <div class="flex justify-between text-xs font-semibold mb-1">
            <span class="text-ink">Clarification Efficiency (Turbidity Loss)</span>
            <span class="text-emerald-400 font-mono">99.98% vs 96.5%</span>
          </div>
          <div class="h-2.5 w-full bg-surface rounded-full overflow-hidden flex">
            <div class="bg-emerald-500 h-full" style="width: 99.98%"></div>
          </div>
          <span class="block text-[10px] text-muted mt-0.5">DCM-LFAD: 99.98% | High-Speed Centrifuge: 96.5%</span>
        </div>

        <!-- Metric 2: Steady-State Permeate Flux (LMH) -->
        <div>
          <div class="flex justify-between text-xs font-semibold mb-1">
            <span class="text-ink">Steady-State Flux (LMH at 10-15°C)</span>
            <span class="text-sky-400 font-mono">420 LMH vs 85 LMH</span>
          </div>
          <div class="h-2.5 w-full bg-surface rounded-full overflow-hidden flex">
            <div class="bg-sky-500 h-full" style="width: 100%"></div>
          </div>
          <span class="block text-[10px] text-muted mt-0.5">DCM-LFAD: 420 LMH | Static Tubular Ceramic: 85 LMH</span>
        </div>

        <!-- Metric 3: Cold Bioactive Polyphenol Retention -->
        <div>
          <div class="flex justify-between text-xs font-semibold mb-1">
            <span class="text-ink">Cold Bioactive & Polyphenol Retention</span>
            <span class="text-purple-400 font-mono">99.4% vs 84.5%</span>
          </div>
          <div class="h-2.5 w-full bg-surface rounded-full overflow-hidden flex">
            <div class="bg-purple-500 h-full" style="width: 99.4%"></div>
          </div>
          <span class="block text-[10px] text-muted mt-0.5">DCM-LFAD: 99.4% | Diatomaceous Earth: 84.5% (Silica Adsorption)</span>
        </div>

        <!-- Metric 4: Specific Energy Consumption (kWh/m³) -->
        <div>
          <div class="flex justify-between text-xs font-semibold mb-1">
            <span class="text-ink">Energy Efficiency & Decarbonization</span>
            <span class="text-teal-400 font-mono">88.5% Energy Savings</span>
          </div>
          <div class="h-2.5 w-full bg-surface rounded-full overflow-hidden flex">
            <div class="bg-teal-500 h-full" style="width: 88.5%"></div>
          </div>
          <span class="block text-[10px] text-muted mt-0.5">DCM-LFAD: 0.58 kWh/m³ vs Static Tubular: 5.10 kWh/m³</span>
        </div>
      </div>
    </div>

    <!-- Science Equations & Governing Laws (7 cols) -->
    <div class="lg:col-span-7 bg-surface-soft border border-hairline rounded-2xl p-5 sm:p-6">
      <h3 class="text-lg font-bold text-ink mb-1">{d.scienceTitle}</h3>
      <p class="text-xs text-muted mb-4">{d.scienceSub}</p>

      <div class="space-y-3.5">
        {data.governingEquations.map((eq, idx) => (
          <div class="bg-surface border border-hairline rounded-xl p-3.5">
            <div class="flex items-center gap-2 mb-1">
              <span class="w-5 h-5 rounded-full bg-sky-950 text-sky-400 text-xs font-bold flex items-center justify-center border border-sky-800">
                {idx + 1}
              </span>
              <h4 class="text-xs font-bold text-ink">{eq.name}</h4>
            </div>
            <code class="block font-mono text-[11px] text-sky-300 bg-black/40 px-2.5 py-1.5 rounded-lg border border-hairline my-1.5 overflow-x-auto">
              {eq.formula}
            </code>
            <p class="text-[11px] text-muted leading-relaxed">{eq.explanation}</p>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Comparison Matrix Table -->
  <div class="bg-surface-soft border border-hairline rounded-2xl p-5 sm:p-6 mb-4">
    <h3 class="text-lg font-bold text-ink mb-1">{d.tableTitle}</h3>
    <p class="text-xs text-muted mb-4">Comprehensive engineering comparison between DCM-LFAD, conventional static tubular ceramic MF, diatomaceous earth cake filtration, and high-speed centrifuges.</p>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs border-collapse">
        <thead>
          <tr class="border-b border-hairline text-muted">
            <th class="py-2.5 px-3 font-semibold">Technology</th>
            <th class="py-2.5 px-3 font-semibold">Clarification Eff.</th>
            <th class="py-2.5 px-3 font-semibold">Steady Flux (LMH)</th>
            <th class="py-2.5 px-3 font-semibold">Fouling Cake Control</th>
            <th class="py-2.5 px-3 font-semibold">Bioactive Retention</th>
            <th class="py-2.5 px-3 font-semibold">Energy (SEC)</th>
            <th class="py-2.5 px-3 font-semibold">Waste Profile</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline">
          {data.technologyComparisonMatrix.map((row, idx) => (
            <tr class={idx === 0 ? "bg-sky-950/20 text-sky-200 font-medium" : "text-ink"}>
              <td class="py-2.5 px-3 font-bold">{row.technology}</td>
              <td class="py-2.5 px-3 font-mono">{row.clarificationEfficiencyPct}%</td>
              <td class="py-2.5 px-3 font-mono">{row.averageSteadyStateFluxLmH}</td>
              <td class="py-2.5 px-3">{row.foulingCakeControl}</td>
              <td class="py-2.5 px-3 font-mono">{row.bioactivePolyphenolRetention}</td>
              <td class="py-2.5 px-3 font-mono">{row.operatingCostKwhPerM3}</td>
              <td class="py-2.5 px-3">{row.wasteResidueProfile}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  // Client-Side Dynamic Telemetry Calculator for DCM-LFAD
  function initDcmLfadModeler() {
    const container = document.querySelector('.dcm-engine-container');
    if (!container) return;

    const feedSelect = document.getElementById('dcm-feed-select') as HTMLSelectElement;
    const membraneSelect = document.getElementById('dcm-membrane-select') as HTMLSelectElement;

    const rpmSlider = document.getElementById('dcm-rpm-slider') as HTMLInputElement;
    const tmpSlider = document.getElementById('dcm-tmp-slider') as HTMLInputElement;
    const powerSlider = document.getElementById('dcm-power-slider') as HTMLInputElement;
    const turbiditySlider = document.getElementById('dcm-turbidity-slider') as HTMLInputElement;
    const tempSlider = document.getElementById('dcm-temp-slider') as HTMLInputElement;

    const rpmVal = document.getElementById('dcm-rpm-val');
    const tmpVal = document.getElementById('dcm-tmp-val');
    const powerVal = document.getElementById('dcm-power-val');
    const turbidityVal = document.getElementById('dcm-turbidity-val');
    const tempVal = document.getElementById('dcm-temp-val');

    const telemetryFlux = document.getElementById('telemetry-flux');
    const telemetryShear = document.getElementById('telemetry-shear');
    const telemetryTurbidity = document.getElementById('telemetry-turbidity');
    const telemetryMitigation = document.getElementById('telemetry-mitigation');
    const telemetryBioactive = document.getElementById('telemetry-bioactive');
    const telemetrySec = document.getElementById('telemetry-sec');
    const telemetryCip = document.getElementById('telemetry-cip');
    const telemetryVerdictText = document.getElementById('telemetry-verdict-text');
    const telemetryVerdictCard = document.getElementById('telemetry-verdict-card');

    function calculateTelemetry() {
      const rpm = parseFloat(rpmSlider.value);
      const tmp = parseFloat(tmpSlider.value);
      const power = parseFloat(powerSlider.value);
      const turbidity = parseFloat(turbiditySlider.value);
      const temp = parseFloat(tempSlider.value);
      const feedType = feedSelect.value;
      const memType = membraneSelect.value;

      // Update Slider Label Badges
      if (rpmVal) rpmVal.textContent = `${rpm} RPM`;
      if (tmpVal) tmpVal.textContent = `${tmp.toFixed(1)} bar`;
      if (powerVal) powerVal.textContent = `${power} W`;
      if (turbidityVal) turbidityVal.textContent = `${turbidity} NTU`;
      if (tempVal) tempVal.textContent = `${temp.toFixed(1)} °C`;

      // Severe Cake Fouling Hazard Stress Scenario
      if (power === 0 && rpm <= 500) {
        if (telemetryFlux) {
          telemetryFlux.textContent = '38 LMH';
          telemetryFlux.className = 'text-xl font-extrabold text-rose-500 font-mono';
        }
        if (telemetryShear) {
          telemetryShear.textContent = '32,000 s⁻¹';
          telemetryShear.className = 'text-xl font-extrabold text-amber-500 font-mono';
        }
        if (telemetryTurbidity) {
          telemetryTurbidity.textContent = '8.5 NTU (Hazy Permeate)';
          telemetryTurbidity.className = 'text-xl font-extrabold text-rose-500 font-mono';
        }
        if (telemetryMitigation) {
          telemetryMitigation.textContent = '0.0% (Severe Cake Deposition)';
          telemetryMitigation.className = 'text-base font-bold text-rose-500 font-mono';
        }
        if (telemetryBioactive) {
          telemetryBioactive.textContent = '88.5% (Cake Entrapment)';
          telemetryBioactive.className = 'text-base font-bold text-rose-400 font-mono';
        }
        if (telemetrySec) {
          telemetrySec.textContent = '2.45 kWh/m³';
          telemetrySec.className = 'text-xs font-mono font-bold text-rose-400';
        }
        if (telemetryCip) {
          telemetryCip.textContent = '4 Hours (Rapid Decline)';
          telemetryCip.className = 'text-xs font-mono font-bold text-rose-400';
        }
        if (telemetryVerdictCard) {
          telemetryVerdictCard.className = 'bg-surface border border-rose-800/80 rounded-xl p-4';
        }
        if (telemetryVerdictText) {
          telemetryVerdictText.className = 'text-xs font-medium text-rose-300 leading-relaxed';
          telemetryVerdictText.textContent = 'SEVERE FOULING WARNING: Without 28 kHz acoustic desorption and sufficient rotational shear, colloidal pectins form an impermeable gel cake, reducing flux by 88% and causing premature membrane blinding.';
        }
        return;
      }

      // Normal Dynamic DCM-LFAD Physics Simulation
      // 1. Dynamic Surface Shear Rate: gamma = (r * omega) / delta_b
      const radiusM = 0.156; // 312 mm disc diameter / 2
      const omega = (2 * Math.PI * rpm) / 60;
      const kinematicViscosity = (1.002e-6) * (1 + (turbidity / 10000));
      const boundaryLayer = Math.sqrt(kinematicViscosity / omega);
      const shearRate = Math.round((radiusM * omega) / boundaryLayer);

      // 2. Intrinsic Membrane Permeability factor
      let basePermeability = 520; // LMH/bar
      if (memType === 'silicon_carbide_sic') basePermeability = 680;
      else if (memType === 'zirconia_coated_alumina') basePermeability = 510;
      else if (memType === 'titania_nanocomposite') basePermeability = 380;

      // 3. Acoustic Desorption Resistance Reduction factor (0 to 1200 W)
      const acousticMitigationPct = Math.min(94.0, (power / 1200) * 88.0 + 8.0);

      // 4. Flux Calculation with Darcy's Resistance-in-series
      const shearBonus = Math.pow(shearRate / 100000, 0.45);
      const acousticBonus = 1 + (power / 1500);
      const viscosityPenalty = 1 + ((turbidity - 500) / 7000);
      const tempBonus = 1 + ((temp - 12) * 0.022); // ~2.2% flux increase per °C

      let steadyFlux = Math.round((basePermeability * tmp * 0.62 * shearBonus * acousticBonus * tempBonus) / viscosityPenalty);
      steadyFlux = Math.max(85, Math.min(780, steadyFlux));

      // 5. Clarified Permeate Turbidity (NTU)
      let outTurbidity = (turbidity * 0.00028) / (acousticBonus * Math.pow(rpm / 1000, 0.3));
      if (memType === 'titania_nanocomposite') outTurbidity *= 0.5;
      outTurbidity = Math.max(0.12, Math.min(1.2, outTurbidity));

      // 6. Cold Bioactive Retention (%)
      const bioactive = Math.min(99.9, Math.max(98.5, 99.8 - ((temp - 8) * 0.025) - ((1200 - power) * 0.0003)));

      // 7. Specific Energy Consumption (kWh/m³)
      // Energy = Mechanical rotational power + Ultrasound acoustic power / Permeate volumetric output
      const discCount = 24;
      const totalArea = 9.3; // m²
      const permeateRateM3PerH = (steadyFlux * totalArea) / 1000;
      const mechanicalPowerKw = 0.0000015 * Math.pow(rpm, 2.4);
      const acousticPowerKw = power / 1000;
      const pumpingPowerKw = 0.35 * tmp;
      const totalPowerKw = mechanicalPowerKw + acousticPowerKw + pumpingPowerKw;
      const sec = Math.max(0.35, Math.min(1.65, totalPowerKw / Math.max(0.1, permeateRateM3PerH)));

      // 8. Continuous CIP Runtime (Hours)
      const cipHours = Math.round(Math.min(96, Math.max(24, 28 + (power / 1200) * 36 + (rpm / 1800) * 22)));

      // Render Outputs
      if (telemetryFlux) {
        telemetryFlux.textContent = `${steadyFlux} LMH`;
        telemetryFlux.className = 'text-xl font-extrabold text-sky-400 font-mono';
      }
      if (telemetryShear) {
        telemetryShear.textContent = `${shearRate.toLocaleString()} s⁻¹`;
        telemetryShear.className = 'text-xl font-extrabold text-cyan-400 font-mono';
      }
      if (telemetryTurbidity) {
        telemetryTurbidity.textContent = `${outTurbidity.toFixed(2)} NTU`;
        telemetryTurbidity.className = 'text-xl font-extrabold text-emerald-400 font-mono';
      }
      if (telemetryMitigation) {
        telemetryMitigation.textContent = `-${acousticMitigationPct.toFixed(1)}% ΔR_cake`;
        telemetryMitigation.className = 'text-base font-bold text-teal-400 font-mono';
      }
      if (telemetryBioactive) {
        telemetryBioactive.textContent = `${bioactive.toFixed(1)}% Preserved`;
        telemetryBioactive.className = 'text-base font-bold text-purple-400 font-mono';
      }
      if (telemetrySec) {
        telemetrySec.textContent = `${sec.toFixed(2)} kWh/m³`;
        telemetrySec.className = 'text-xs font-mono font-bold text-amber-400';
      }
      if (telemetryCip) {
        telemetryCip.textContent = `${cipHours} Hours`;
        telemetryCip.className = 'text-xs font-mono font-bold text-emerald-400';
      }
      if (telemetryVerdictCard) {
        telemetryVerdictCard.className = 'bg-surface border border-sky-800/80 rounded-xl p-4';
      }
      if (telemetryVerdictText) {
        telemetryVerdictText.className = 'text-xs font-medium text-sky-200 leading-relaxed';
        telemetryVerdictText.textContent = `FDA 21 CFR § 120 JUICE HACCP VALIDATED: >7.0-log microbial exclusion, 0.0 ppm chemical filter aid residues, ${bioactive.toFixed(1)}% cold bioactive polyphenol preservation.`;
      }
    }

    // Attach Event Listeners
    rpmSlider.addEventListener('input', calculateTelemetry);
    tmpSlider.addEventListener('input', calculateTelemetry);
    powerSlider.addEventListener('input', calculateTelemetry);
    turbiditySlider.addEventListener('input', calculateTelemetry);
    tempSlider.addEventListener('input', calculateTelemetry);
    feedSelect.addEventListener('change', calculateTelemetry);
    membraneSelect.addEventListener('change', calculateTelemetry);

    // Preset Buttons
    const presetButtons = document.querySelectorAll('.dcm-preset-btn');
    presetButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = (e.currentTarget as HTMLButtonElement).dataset.preset;
        if (target === 'cider') {
          feedSelect.value = 'cold_cloudy_apple_cider';
          membraneSelect.value = 'silicon_carbide_sic';
          rpmSlider.value = '1200';
          tmpSlider.value = '0.8';
          powerSlider.value = '650';
          turbiditySlider.value = '1450';
          tempSlider.value = '12';
        } else if (target === 'fermentation') {
          feedSelect.value = 'precision_fermented_mycoprotein_broth';
          membraneSelect.value = 'zirconia_coated_alumina';
          rpmSlider.value = '1600';
          tmpSlider.value = '1.2';
          powerSlider.value = '900';
          turbiditySlider.value = '4800';
          tempSlider.value = '10';
        } else if (target === 'citrus') {
          feedSelect.value = 'cold_pressed_citrus_peel_wash';
          membraneSelect.value = 'silicon_carbide_sic';
          rpmSlider.value = '1100';
          tmpSlider.value = '0.7';
          powerSlider.value = '550';
          turbiditySlider.value = '3400';
          tempSlider.value = '14';
        } else if (target === 'elderberry') {
          feedSelect.value = 'wild_elderberry_aronia_extract';
          membraneSelect.value = 'silicon_carbide_sic';
          rpmSlider.value = '1350';
          tmpSlider.value = '0.9';
          powerSlider.value = '700';
          turbiditySlider.value = '1900';
          tempSlider.value = '10';
        } else if (target === 'foulingHazard') {
          feedSelect.value = 'precision_fermented_mycoprotein_broth';
          membraneSelect.value = 'silicon_carbide_sic';
          rpmSlider.value = '400';
          tmpSlider.value = '1.5';
          powerSlider.value = '0';
          turbiditySlider.value = '4500';
          tempSlider.value = '25';
        }
        calculateTelemetry();
      });
    });

    // Export Audit Report
    const exportBtn = document.getElementById('dcm-export-btn');
    if (exportBtn) {
      exportBtn.addEventListener('click', () => {
        const report = {
          auditTitle: "DCM-LFAD Commercial Engineering Audit Certificate",
          system: "Continuous Dynamic Ceramic Membrane Micro-Filtration & Low-Frequency Acoustic Desorption Skid",
          standardsCompliance: [
            "FDA 21 CFR § 120 (Juice HACCP 5-log pathogen reduction)",
            "FDA 21 CFR § 117 (FSMA cGMP)",
            "3-A Sanitary Standards 45-03 for Cross-Flow Membrane Modules",
            "EHEDG Type EL Class I CIP/SIP Cleanability",
            "ASME B31.3 High-Pressure Process Piping"
          ],
          parameters: {
            feedstock: feedSelect.value,
            membrane: membraneSelect.value,
            rotationalSpeedRpm: rpmSlider.value,
            transmembranePressureBar: tmpSlider.value,
            acousticPowerWatts: powerSlider.value,
            inletTurbidityNtu: turbiditySlider.value,
            operatingTempC: tempSlider.value
          },
          telemetry: {
            permeateFlux: telemetryFlux?.textContent?.trim(),
            surfaceShearRate: telemetryShear?.textContent?.trim(),
            clarifiedTurbidity: telemetryTurbidity?.textContent?.trim(),
            cakeResistanceMitigation: telemetryMitigation?.textContent?.trim(),
            bioactiveRetention: telemetryBioactive?.textContent?.trim(),
            specificEnergyConsumption: telemetrySec?.textContent?.trim(),
            continuousCipInterval: telemetryCip?.textContent?.trim()
          },
          timestamp: new Date().toISOString()
        };

        const blob = new Blob([JSON.stringify(report, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `dcm-lfad-audit-${Date.now()}.json`;
        a.click();
        URL.revokeObjectURL(url);
      });
    }

    // Initial Calculation Run
    calculateTelemetry();
  }

  // Lifecycle Bindings
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDcmLfadModeler);
  } else {
    initDcmLfadModeler();
  }
</script>
