    coolingJacketHelp: "2℃〜4℃の冷水グリコール循環ジャケットを起動し、超音波粘性散逸熱を速やかに排熱してタンパク質熱変性を防止。",
    presetsTitle: "推奨産業運転プリセット",
    presetDairy: "乳業用非加熱連続脱脂＆天然脂肪球分画 (400kHz+1.6MHz, 1200 L/h, 18℃)",
    presetAlgae: "無菌微細藻類バイオマス脱水回収 (600kHz+2.0MHz, 450 L/h, 22℃)",
    presetCoffee: "クラフトコールドブリュー非加熱清澄＆脱油 (400kHz+1.2MHz, 800 L/h, 12℃)",
    presetInfant: "高級乳児用粉乳向け天然極性脂質分画 (400kHz+1.6MHz, 750 L/h, 15℃)",
    presetHazard: "流速過剰＆音響流バイパス短絡警報 (低出力, 2500 L/h, 冷却なし)",
    diagnosticTitle: "音響泳動分離＆物理テレメトリー",
    diagnosticSub: "音響コントラスト因子（Φ）、Gor'kov音響放射力、総合分離清澄率、濃縮倍率、MFGM生理活性保持率、音響流安定性指数、Blakeキャビテーションマージンをリアルタイム算出。",
    contrastFactorLabel: "音響コントラスト因子 (Φ):",
    radiationForceLabel: "一次Gor'kov音響放射力 (F_rad):",
    separationEffLabel: "総合微粒子分離・清澄効率:",
    concentrationFoldLabel: "濃縮倍数ファクター (Fold):",
    bioactiveRetentionLabel: "天然生理活性成分／MFGM保持率:",
    streamingStabilityLabel: "音響流渦流抑制安定性比:",
    thermalDissipationLabel: "音響粘性発熱量／正味出口温度:",
    cavitationSafetyLabel: "Blakeキャビテーション＆過酸化防止マージン:",
    diagramTitle: "連続フロースルー音響泳動共振器プロセス構造",
    diagramSub: "二重周波数圧電セラミックアレイ、直交定在波の音圧節・腹分布、分散相粒子の移行挙動、向流冷却ジャケット、および多段層流スプリッター出口を可視化。",
    scienceTitle: "科学原理解析: 音響泳動力場＆非せん断分離メカニズム",
    scienceSub: "Gor'kov音響ポテンシャル理論、二次Bjerknes引力凝集動力学、非加熱乳脂肪球膜（MFGM）保護、微細藻類無薬剤濃縮、および3-A/EHEDGサニタリー規格を詳解。",
    tableTitle: "二重周波数メガソニック定在波分離と主要食品分離技術の比較"
  }
};

const d = DICT[lang] || DICT.en;
const data = megasonicData;
---

<div class="space-y-8 bg-surface p-6 sm:p-8 rounded-3xl border border-hairline shadow-sm" id="megasonic-modeler-container">
  <!-- Header / Badge -->
  <div class="space-y-3">
    <div class="flex flex-wrap items-center gap-2">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-emerald-950 text-emerald-200 border border-emerald-800">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 2v20M2 12h20M4.93 4.93l14.14 14.14M4.93 19.07l14.14-14.14"/>
        </svg>
        {d.badge}
      </span>
      <span class="text-xs text-muted font-mono">400 kHz &bull; 1.6 MHz &bull; 3-A 63-04 &bull; EHEDG Class I</span>
    </div>
    <h1 class="text-2xl sm:text-3xl font-bold text-ink tracking-tight">
      {d.title}
    </h1>
    <p class="text-body text-sm sm:text-base leading-relaxed max-w-4xl">
      {d.subtitle}
    </p>
  </div>

  <!-- Presets Bar -->
  <div class="bg-surface-soft border border-hairline rounded-2xl p-4 sm:p-5">
    <div class="text-xs font-bold uppercase tracking-wider text-muted mb-3 flex items-center gap-2">
      <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
      </svg>
      {d.presetsTitle}
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2.5">
      <button 
        type="button" 
        class="preset-btn text-left p-3 rounded-xl border border-hairline/80 bg-surface hover:border-emerald-600 hover:bg-emerald-50/10 transition-all text-xs"
        data-preset="dairy"
      >
        <span class="font-semibold text-ink block text-xs">🥛 {d.presetDairy.split('(')[0]}</span>
        <span class="text-muted block text-[11px] mt-0.5">400kHz + 1.6MHz &bull; 1,200 L/h &bull; 18°C</span>
      </button>

      <button 
        type="button" 
        class="preset-btn text-left p-3 rounded-xl border border-hairline/80 bg-surface hover:border-emerald-600 hover:bg-emerald-50/10 transition-all text-xs"
        data-preset="algae"
      >
        <span class="font-semibold text-ink block text-xs">🌿 {d.presetAlgae.split('(')[0]}</span>
        <span class="text-muted block text-[11px] mt-0.5">600kHz + 2.0MHz &bull; 450 L/h &bull; 22°C</span>
      </button>

      <button 
        type="button" 
        class="preset-btn text-left p-3 rounded-xl border border-hairline/80 bg-surface hover:border-emerald-600 hover:bg-emerald-50/10 transition-all text-xs"
        data-preset="coffee"
      >
        <span class="font-semibold text-ink block text-xs">☕ {d.presetCoffee.split('(')[0]}</span>
        <span class="text-muted block text-[11px] mt-0.5">400kHz + 1.2MHz &bull; 800 L/h &bull; 12°C</span>
      </button>

      <button 
        type="button" 
        class="preset-btn text-left p-3 rounded-xl border border-hairline/80 bg-surface hover:border-emerald-600 hover:bg-emerald-50/10 transition-all text-xs"
        data-preset="infant"
      >
        <span class="font-semibold text-ink block text-xs">🍼 {d.presetInfant.split('(')[0]}</span>
        <span class="text-muted block text-[11px] mt-0.5">400kHz + 1.6MHz &bull; 750 L/h &bull; 15°C</span>
      </button>

      <button 
        type="button" 
        class="preset-btn text-left p-3 rounded-xl border border-amber-800/40 bg-amber-950/10 hover:border-amber-600 transition-all text-xs sm:col-span-2 lg:col-span-2"
        data-preset="hazard"
      >
        <span class="font-semibold text-amber-400 block text-xs">⚠️ {d.presetHazard.split('(')[0]}</span>
        <span class="text-amber-300/80 block text-[11px] mt-0.5">Critical Hazard &bull; Flow Bypass &bull; No Cooling Jacket</span>
      </button>
    </div>
  </div>

  <!-- Interactive Controls & Live Telemetry Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <!-- Controls Column (7 Cols) -->
    <div class="lg:col-span-7 space-y-6">
      <div class="border-b border-hairline pb-3">
        <h2 class="text-lg font-bold text-ink">{d.controlsTitle}</h2>
        <p class="text-xs text-muted">{d.controlsSub}</p>
      </div>

      <!-- Resonator Skid Selector -->
      <div class="space-y-1.5">
        <label for="resonator-skid-select" class="block text-xs font-semibold text-ink">
          {d.resonatorLabel}
        </label>
        <select 
          id="resonator-skid-select" 
          class="w-full text-xs font-medium bg-surface border border-hairline rounded-xl px-3.5 py-2.5 text-ink focus:outline-none focus:ring-2 focus:ring-emerald-500"
        >
          {data.resonatorSystems.map(sys => (
            <option value={sys.id}>{sys.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted">{d.resonatorHelp}</p>
      </div>

      <!-- Feedstock / Fluid Matrix Selector -->
      <div class="space-y-1.5">
        <label for="fluid-matrix-select" class="block text-xs font-semibold text-ink">
          {d.matrixLabel}
        </label>
        <select 
          id="fluid-matrix-select" 
          class="w-full text-xs font-medium bg-surface border border-hairline rounded-xl px-3.5 py-2.5 text-ink focus:outline-none focus:ring-2 focus:ring-emerald-500"
        >
          {data.processingMatrices.map(mat => (
            <option value={mat.id}>{mat.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted">{d.matrixHelp}</p>
      </div>

      <!-- Primary Low-Megasonic Power Slider (400 kHz) -->
      <div class="space-y-2 bg-surface-soft/60 p-4 rounded-xl border border-hairline">
        <div class="flex justify-between items-center text-xs">
          <label for="primary-power-input" class="font-semibold text-ink">{d.primaryPowerLabel}</label>
          <span class="font-mono font-bold text-emerald-600 bg-emerald-500/10 px-2 py-0.5 rounded text-xs" id="primary-power-val">2400 W</span>
        </div>
        <input 
          type="range" 
          id="primary-power-input" 
          min="200" 
          max="4800" 
          step="100" 
          value="2400" 
          class="w-full accent-emerald-600 h-2 bg-hairline rounded-lg cursor-pointer"
        />
        <div class="flex justify-between text-[11px] text-muted">
          <span>200 W (Gentle)</span>
          <span>Nominal: 2400 W</span>
          <span>4800 W (High-Energy)</span>
        </div>
        <p class="text-[11px] text-muted">{d.primaryPowerHelp}</p>
      </div>

      <!-- Secondary High-Megasonic Power Slider (1.6 MHz) -->
      <div class="space-y-2 bg-surface-soft/60 p-4 rounded-xl border border-hairline">
        <div class="flex justify-between items-center text-xs">
          <label for="secondary-power-input" class="font-semibold text-ink">{d.secondaryPowerLabel}</label>
          <span class="font-mono font-bold text-teal-600 bg-teal-500/10 px-2 py-0.5 rounded text-xs" id="secondary-power-val">1600 W</span>
        </div>
        <input 
          type="range" 
          id="secondary-power-input" 
          min="100" 
          max="3200" 
          step="100" 
          value="1600" 
          class="w-full accent-teal-600 h-2 bg-hairline rounded-lg cursor-pointer"
        />
        <div class="flex justify-between text-[11px] text-muted">
          <span>100 W (Low Gradient)</span>
          <span>Nominal: 1600 W</span>
          <span>3200 W (Fine Trapping)</span>
        </div>
        <p class="text-[11px] text-muted">{d.secondaryPowerHelp}</p>
      </div>

      <!-- Flow Rate & Temperature in 2 Columns -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- Flow Rate Slider -->
        <div class="space-y-2 bg-surface-soft/60 p-4 rounded-xl border border-hairline">
          <div class="flex justify-between items-center text-xs">
            <label for="flow-rate-input" class="font-semibold text-ink">{d.flowRateLabel}</label>
            <span class="font-mono font-bold text-ink bg-surface px-2 py-0.5 rounded border border-hairline text-xs" id="flow-rate-val">1200 L/h</span>
          </div>
          <input 
            type="range" 
            id="flow-rate-input" 
            min="100" 
            max="2500" 
            step="50" 
            value="1200" 
            class="w-full accent-emerald-600 h-2 bg-hairline rounded-lg cursor-pointer"
          />
          <p class="text-[11px] text-muted">{d.flowRateHelp}</p>
        </div>

        <!-- Inlet Temperature Slider -->
        <div class="space-y-2 bg-surface-soft/60 p-4 rounded-xl border border-hairline">
          <div class="flex justify-between items-center text-xs">
            <label for="temp-input" class="font-semibold text-ink">{d.temperatureLabel}</label>
            <span class="font-mono font-bold text-ink bg-surface px-2 py-0.5 rounded border border-hairline text-xs" id="temp-val">18°C</span>
          </div>
          <input 
            type="range" 
            id="temp-input" 
            min="5" 
            max="45" 
            step="1" 
            value="18" 
            class="w-full accent-emerald-600 h-2 bg-hairline rounded-lg cursor-pointer"
          />
          <p class="text-[11px] text-muted">{d.temperatureHelp}</p>
        </div>
      </div>

      <!-- Cooling Jacket Toggle -->
      <div class="flex items-center justify-between p-4 rounded-xl border border-hairline bg-surface-soft/80">
        <div class="space-y-0.5">
          <span class="text-xs font-semibold text-ink block">{d.coolingJacketLabel}</span>
          <span class="text-[11px] text-muted block">{d.coolingJacketHelp}</span>
        </div>
        <label class="relative inline-flex items-center cursor-pointer">
          <input type="checkbox" id="cooling-toggle" class="sr-only peer" checked />
          <div class="w-11 h-6 bg-hairline peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-600"></div>
        </label>
      </div>
    </div>

    <!-- Live Telemetry & Diagnostics Column (5 Cols) -->
    <div class="lg:col-span-5 space-y-4">
      <div class="border-b border-hairline pb-3">
        <h2 class="text-lg font-bold text-ink">{d.diagnosticTitle}</h2>
        <p class="text-xs text-muted">{d.diagnosticSub}</p>
      </div>

      <!-- Status Banner -->
      <div id="telemetry-status-card" class="p-4 rounded-2xl border border-emerald-800 bg-emerald-950/20 text-emerald-200 space-y-1">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-emerald-400 flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            Acoustophoretic Resonator Status
          </span>
          <span id="telemetry-badge" class="px-2 py-0.5 text-[10px] font-bold rounded-full bg-emerald-900 border border-emerald-700 text-emerald-100 uppercase">
            OPTIMAL HARMONIC RESONANCE
          </span>
        </div>
        <p id="telemetry-summary-text" class="text-xs leading-relaxed text-emerald-100/90 font-medium pt-1">
          Dual-frequency standing waves fully active. Primary 400 kHz node spacing (1.88 mm) driving macro-globules; 1.6 MHz harmonic array trapping submicron haze.
        </p>
      </div>

      <!-- Metric Cards Grid -->
      <div class="grid grid-cols-2 gap-3">
        <!-- Contrast Factor -->
        <div class="bg-surface-soft border border-hairline rounded-xl p-3.5 space-y-1">
          <span class="text-[11px] font-semibold text-muted block">{d.contrastFactorLabel}</span>
          <div class="flex items-baseline gap-1">
            <span class="text-lg font-bold font-mono text-ink" id="out-contrast-factor">-0.285</span>
            <span class="text-[10px] font-mono text-muted">Φ</span>
          </div>
          <span class="text-[10px] font-medium text-emerald-600 block" id="out-contrast-dir">Antinode (Lipid Cream)</span>
        </div>

        <!-- Gor'kov Force -->
        <div class="bg-surface-soft border border-hairline rounded-xl p-3.5 space-y-1">
          <span class="text-[11px] font-semibold text-muted block">{d.radiationForceLabel}</span>
          <div class="flex items-baseline gap-1">
            <span class="text-lg font-bold font-mono text-ink" id="out-radiation-force">184.2</span>
            <span class="text-[10px] font-mono text-muted">pN</span>
          </div>
          <span class="text-[10px] text-muted block" id="out-radiation-sub">Stokes Drift: 4.8 mm/s</span>
        </div>

        <!-- Separation Yield -->
        <div class="bg-surface-soft border border-hairline rounded-xl p-3.5 space-y-1">
          <span class="text-[11px] font-semibold text-muted block">{d.separationEffLabel}</span>
          <div class="flex items-baseline gap-1">
            <span class="text-lg font-bold font-mono text-emerald-600" id="out-separation-yield">92.5%</span>
          </div>
          <div class="w-full bg-hairline rounded-full h-1.5 mt-1">
            <div id="bar-separation-yield" class="bg-emerald-600 h-1.5 rounded-full" style="width: 92.5%"></div>
          </div>
        </div>

        <!-- Concentration Fold -->
        <div class="bg-surface-soft border border-hairline rounded-xl p-3.5 space-y-1">
          <span class="text-[11px] font-semibold text-muted block">{d.concentrationFoldLabel}</span>
          <div class="flex items-baseline gap-1">
            <span class="text-lg font-bold font-mono text-ink" id="out-concentration-fold">4.2x</span>
          </div>
          <span class="text-[10px] text-muted block" id="out-fold-sub">Cream Layer: 38.5% Fat</span>
        </div>

        <!-- Bioactive / MFGM Retention -->
        <div class="bg-surface-soft border border-hairline rounded-xl p-3.5 space-y-1">
          <span class="text-[11px] font-semibold text-muted block">{d.bioactiveRetentionLabel}</span>
          <div class="flex items-baseline gap-1">
            <span class="text-lg font-bold font-mono text-emerald-600" id="out-bioactive-retention">100.0%</span>
          </div>
          <span class="text-[10px] text-muted block" id="out-bioactive-sub">Zero Membrane Rupture</span>
        </div>

        <!-- Streaming Stability -->
        <div class="bg-surface-soft border border-hairline rounded-xl p-3.5 space-y-1">
          <span class="text-[11px] font-semibold text-muted block">{d.streamingStabilityLabel}</span>
          <div class="flex items-baseline gap-1">
            <span class="text-lg font-bold font-mono text-ink" id="out-streaming-ratio">3.85</span>
          </div>
          <span class="text-[10px] font-medium text-emerald-600 block" id="out-streaming-sub">Laminar Trap Locked</span>
        </div>

        <!-- Thermal Dissipation -->
        <div class="bg-surface-soft border border-hairline rounded-xl p-3.5 space-y-1">
          <span class="text-[11px] font-semibold text-muted block">{d.thermalDissipationLabel}</span>
          <div class="flex items-baseline gap-1">
            <span class="text-lg font-bold font-mono text-ink" id="out-temp-rise">+1.4°C</span>
            <span class="text-[10px] font-mono text-muted" id="out-net-exit">(19.4°C)</span>
          </div>
          <span class="text-[10px] text-muted block" id="out-cooling-status">Glycol Chilled (2°C)</span>
        </div>

        <!-- Cavitation Safety Margin -->
        <div class="bg-surface-soft border border-hairline rounded-xl p-3.5 space-y-1">
          <span class="text-[11px] font-semibold text-muted block">{d.cavitationSafetyLabel}</span>
          <div class="flex items-baseline gap-1">
            <span class="text-lg font-bold font-mono text-emerald-600" id="out-cavitation-margin">+1.24 MPa</span>
          </div>
          <span class="text-[10px] text-muted block" id="out-cavitation-sub">TBARS = 0.0 µg/g (No Radicals)</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Interactive Equipment & Acoustophoretic Visualization -->
  <div class="bg-surface-soft border border-hairline rounded-2xl p-5 sm:p-6 space-y-4">
    <div class="flex flex-col sm:flex-row justify-between sm:items-center gap-2">
      <div>
        <h3 class="text-base font-bold text-ink">{d.diagramTitle}</h3>
        <p class="text-xs text-muted">{d.diagramSub}</p>
      </div>
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center gap-1 text-[11px] font-medium text-emerald-600 bg-emerald-500/10 px-2 py-0.5 rounded">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          Resonator Channel: Active
        </span>
      </div>
    </div>

    <!-- Live SVG Visual Diagram -->
    <div class="w-full overflow-x-auto bg-surface border border-hairline rounded-xl p-4">
      <svg id="megasonic-svg-schematic" class="w-full min-w-[640px] h-64" viewBox="0 0 800 260" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Definitions & Gradients -->
        <defs>
          <linearGradient id="fluidFlowGrad" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#3b82f6" stop-opacity="0.15"/>
            <stop offset="60%" stop-color="#10b981" stop-opacity="0.25"/>
            <stop offset="100%" stop-color="#059669" stop-opacity="0.4"/>
          </linearGradient>
          <linearGradient id="transducerGradTop" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#059669"/>
            <stop offset="100%" stop-color="#064e3b"/>
          </linearGradient>
          <linearGradient id="transducerGradBottom" x1="0%" y1="100%" x2="0%" y2="0%">
            <stop offset="0%" stop-color="#0d9488"/>
            <stop offset="100%" stop-color="#134e4a"/>
          </linearGradient>
          <linearGradient id="jacketGrad" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#0284c7" stop-opacity="0.3"/>
            <stop offset="100%" stop-color="#38bdf8" stop-opacity="0.2"/>
          </linearGradient>
          <pattern id="standingWaveGrid" width="40" height="120" patternUnits="userSpaceOnUse">
            <line x1="20" y1="0" x2="20" y2="120" stroke="#10b981" stroke-width="1.2" stroke-dasharray="3 3" opacity="0.6"/>
            <line x1="40" y1="0" x2="40" y2="120" stroke="#0ea5e9" stroke-width="0.8" opacity="0.4"/>
          </pattern>
        </defs>

        <!-- Outer Chilled Water Jacket -->
        <rect id="svg-cooling-jacket" x="120" y="45" width="460" height="170" rx="8" fill="url(#jacketGrad)" stroke="#0284c7" stroke-width="1.5" stroke-dasharray="6 4" />
        <text x="135" y="60" font-size="10" fill="#0284c7" font-weight="bold" font-family="monospace">COOLING JACKET: 2°C GLYCOL COUNTER-FLOW</text>

        <!-- In-Line Fluid Flow Channel -->
        <rect x="60" y="70" width="580" height="120" rx="4" fill="url(#fluidFlowGrad)" stroke="#334155" stroke-width="2"/>

        <!-- Inlet Pipe and Arrow -->
        <path d="M 10 130 L 60 130" stroke="#3b82f6" stroke-width="8" stroke-linecap="round"/>
        <polygon points="55,122 70,130 55,138" fill="#3b82f6"/>
        <text x="15" y="115" font-size="10" fill="#3b82f6" font-weight="bold" font-family="sans-serif">RAW FEED INLET</text>
        <text x="15" y="152" font-size="9" fill="#64748b" font-family="monospace" id="svg-flow-label">1200 L/h &bull; 18°C</text>

