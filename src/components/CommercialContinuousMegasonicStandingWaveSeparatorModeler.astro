<script>
  function initMegasonicModeler() {
    const container = document.getElementById('megasonic-modeler-container');
    if (!container) return;

    // Elements
    const skidSelect = document.getElementById('resonator-skid-select') as HTMLSelectElement;
    const matrixSelect = document.getElementById('fluid-matrix-select') as HTMLSelectElement;
    const primaryPowerInput = document.getElementById('primary-power-input') as HTMLInputElement;
    const secondaryPowerInput = document.getElementById('secondary-power-input') as HTMLInputElement;
    const flowRateInput = document.getElementById('flow-rate-input') as HTMLInputElement;
    const tempInput = document.getElementById('temp-input') as HTMLInputElement;
    const coolingToggle = document.getElementById('cooling-toggle') as HTMLInputElement;

    // Display values
    const primaryPowerVal = document.getElementById('primary-power-val');
    const secondaryPowerVal = document.getElementById('secondary-power-val');
    const flowRateVal = document.getElementById('flow-rate-val');
    const tempVal = document.getElementById('temp-val');

    // Outputs
    const outContrastFactor = document.getElementById('out-contrast-factor');
    const outContrastDir = document.getElementById('out-contrast-dir');
    const outRadiationForce = document.getElementById('out-radiation-force');
    const outRadiationSub = document.getElementById('out-radiation-sub');
    const outSeparationYield = document.getElementById('out-separation-yield');
    const barSeparationYield = document.getElementById('bar-separation-yield');
    const outConcentrationFold = document.getElementById('out-concentration-fold');
    const outFoldSub = document.getElementById('out-fold-sub');
    const outBioactiveRetention = document.getElementById('out-bioactive-retention');
    const outStreamingRatio = document.getElementById('out-streaming-ratio');
    const outStreamingSub = document.getElementById('out-streaming-sub');
    const outTempRise = document.getElementById('out-temp-rise');
    const outNetExit = document.getElementById('out-net-exit');
    const outCoolingStatus = document.getElementById('out-cooling-status');
    const outCavitationMargin = document.getElementById('out-cavitation-margin');
    const outCavitationSub = document.getElementById('out-cavitation-sub');

    const telemetryStatusCard = document.getElementById('telemetry-status-card');
    const telemetryBadge = document.getElementById('telemetry-badge');
    const telemetrySummaryText = document.getElementById('telemetry-summary-text');

    // SVG elements
    const svgCoolingJacket = document.getElementById('svg-cooling-jacket');
    const svgFlowLabel = document.getElementById('svg-flow-label');
    const svgCreamLabel = document.getElementById('svg-cream-label');

    // Preset Buttons
    const presetButtons = document.querySelectorAll('.preset-btn');

    // Matrix lookup database
    const MATRICES: Record<string, {
      name: string;
      density: number;
      viscosity: number;
      meanDiameter: number;
      contrastFactor: number;
      target: string;
    }> = {
      whole_bovine_milk: { name: 'Whole Bovine Milk', density: 1030, viscosity: 1.75, meanDiameter: 3.8, contrastFactor: -0.285, target: 'Antinodes (Lipid Cream)' },
      microalgae_biomass_broth: { name: 'Microalgae Broth', density: 1015, viscosity: 1.35, meanDiameter: 2.5, contrastFactor: 0.178, target: 'Nodes (Cell Biomass)' },
      citrus_essential_oil_emulsion: { name: 'Citrus Peel Oil Emulsion', density: 998, viscosity: 1.15, meanDiameter: 1.5, contrastFactor: -0.342, target: 'Antinodes (Cold Terpene)' },
      cold_brew_coffee_extract: { name: 'Cold Brew Coffee Extract', density: 1005, viscosity: 1.25, meanDiameter: 0.9, contrastFactor: -0.215, target: 'Antinodes (Oil De-hazing)' },
      plant_based_oat_milk_base: { name: 'Oat/Soy Milk Base', density: 1022, viscosity: 2.10, meanDiameter: 2.2, contrastFactor: -0.262, target: 'Antinodes (Barista Foam)' }
    };

    function recalculate() {
      const p1 = parseFloat(primaryPowerInput?.value || '2400');
      const p2 = parseFloat(secondaryPowerInput?.value || '1600');
      const flow = parseFloat(flowRateInput?.value || '1200');
      const tIn = parseFloat(tempInput?.value || '18');
      const coolingOn = coolingToggle?.checked ?? true;
      const matKey = matrixSelect?.value || 'whole_bovine_milk';
      const matrix = MATRICES[matKey] || MATRICES.whole_bovine_milk;

      // Update text labels
      if (primaryPowerVal) primaryPowerVal.textContent = `${p1} W`;
      if (secondaryPowerVal) secondaryPowerVal.textContent = `${p2} W`;
      if (flowRateVal) flowRateVal.textContent = `${flow} L/h`;
      if (tempVal) tempVal.textContent = `${tIn}°C`;
      if (svgFlowLabel) svgFlowLabel.textContent = `${flow} L/h • ${tIn}°C`;

      // 1. Acoustic Pressure & Radiation Force (pN)
      // Gor'kov force scales with P0^2, particle volume r^3, frequency f, and contrast factor Phi
      const totalPower = p1 + p2;
      const powerDensity = totalPower / 1200; // W/cm^2 approx for standard skid
      const acousticPressureMpa = Math.sqrt(powerDensity * 0.45); // approx 0.8 - 2.5 MPa
      const radiusM = (matrix.meanDiameter * 1e-6) / 2;
      const particleVol = (4 / 3) * Math.PI * Math.pow(radiusM, 3);
      
      // Calculate Radiation Force in pN (scaled)
      const fRadPicoNewtons = Math.abs(matrix.contrastFactor) * (totalPower / 4000) * Math.pow(matrix.meanDiameter / 3.8, 3) * 184.2;
      const driftVelocityMmPerSec = (fRadPicoNewtons * 1e-12) / (6 * Math.PI * (matrix.viscosity * 1e-3) * radiusM) * 1000;

      // 2. Residence Time & Separation Yield (%)
      // Chamber volume approx 3.84 L
      const chamberVolL = 3.84;
      const residenceTimeSec = (chamberVolL / (flow / 3600)); // seconds
      
      // Effective capture parameter
      const captureScore = (fRadPicoNewtons * residenceTimeSec) / (matrix.viscosity * (flow / 1000));
      let separationYield = 100 * (1 - Math.exp(-0.018 * captureScore));
      separationYield = Math.min(99.6, Math.max(25.0, separationYield));

      // 3. Concentration Fold Factor
      const foldFactor = 1.0 + (separationYield / 100) * 3.4;

      // 4. Acoustic Streaming Stability Ratio
      // Ratio of acoustic particle drift velocity to streaming vortex velocity
      const streamingVelocity = (totalPower / 4000) * 1.25;
      const stabilityRatio = driftVelocityMmPerSec / Math.max(0.1, streamingVelocity);

      // 5. Thermal Dissipation & Net Exit Temperature
      // Ultrasonic absorption generates heat: Q = alpha * I * tau / (rho * Cp)
      const rawTempRise = (totalPower / (flow * 1.163)) * 0.85; // approx °C
      const netTempRise = coolingOn ? Math.max(0.3, rawTempRise * 0.22) : rawTempRise;
      const exitTemp = tIn + netTempRise;

      // 6. Cavitation Safety Margin (Blake Threshold)
      // At 400kHz Blake threshold is approx 1.85 MPa, at 1.6MHz approx 3.4 MPa
      const blakeThresholdMpa = 1.85;
      const cavitationMarginMpa = blakeThresholdMpa - acousticPressureMpa;

      // 7. Bioactive & MFGM Retention
      let bioactiveRetention = 100.0;
      if (exitTemp > 38.0) {
        bioactiveRetention -= (exitTemp - 38.0) * 2.8;
      }
      if (flow > 2200 && totalPower < 1500) {
        bioactiveRetention -= 4.5;
      }
      bioactiveRetention = Math.min(100.0, Math.max(65.0, bioactiveRetention));

      // Update DOM outputs
      if (outContrastFactor) outContrastFactor.textContent = matrix.contrastFactor.toFixed(3);
      if (outContrastDir) outContrastDir.textContent = matrix.target;
      if (outRadiationForce) outRadiationForce.textContent = fRadPicoNewtons.toFixed(1);
      if (outRadiationSub) outRadiationSub.textContent = `Stokes Drift: ${driftVelocityMmPerSec.toFixed(1)} mm/s`;
      
      if (outSeparationYield) outSeparationYield.textContent = `${separationYield.toFixed(1)}%`;
      if (barSeparationYield) barSeparationYield.style.width = `${separationYield.toFixed(1)}%`;
      
      if (outConcentrationFold) outConcentrationFold.textContent = `${foldFactor.toFixed(1)}x`;
      if (outFoldSub) outFoldSub.textContent = matrix.contrastFactor < 0 ? `Cream Phase: ${(separationYield * 0.42).toFixed(1)}% Lipids` : `Cell Paste: ${(separationYield * 0.15).toFixed(1)}% Solids`;

      if (outBioactiveRetention) {
        outBioactiveRetention.textContent = `${bioactiveRetention.toFixed(1)}%`;
        outBioactiveRetention.className = bioactiveRetention > 95 ? 'text-lg font-bold font-mono text-emerald-600' : 'text-lg font-bold font-mono text-amber-500';
      }

      if (outStreamingRatio) {
        outStreamingRatio.textContent = stabilityRatio.toFixed(2);
        outStreamingRatio.className = stabilityRatio > 2.0 ? 'text-lg font-bold font-mono text-ink' : 'text-lg font-bold font-mono text-amber-500';
      }
      if (outStreamingSub) {
        outStreamingSub.textContent = stabilityRatio > 2.0 ? 'Laminar Trap Locked' : 'Streaming Vortex Disturbance';
        outStreamingSub.className = stabilityRatio > 2.0 ? 'text-[10px] font-medium text-emerald-600 block' : 'text-[10px] font-medium text-amber-500 block';
      }

      if (outTempRise) outTempRise.textContent = `+${netTempRise.toFixed(1)}°C`;
      if (outNetExit) outNetExit.textContent = `(${exitTemp.toFixed(1)}°C exit)`;
      if (outCoolingStatus) {
        outCoolingStatus.textContent = coolingOn ? 'Glycol Chilled (2°C)' : 'UNCOOLED (Thermal Risk)';
        outCoolingStatus.className = coolingOn ? 'text-[10px] text-muted block' : 'text-[10px] text-amber-500 font-bold block';
      }

      if (outCavitationMargin) {
        outCavitationMargin.textContent = cavitationMarginMpa > 0 ? `+${cavitationMarginMpa.toFixed(2)} MPa` : `${cavitationMarginMpa.toFixed(2)} MPa (Cavitation!)`;
        outCavitationMargin.className = cavitationMarginMpa > 0 ? 'text-lg font-bold font-mono text-emerald-600' : 'text-lg font-bold font-mono text-rose-600';
      }
      if (outCavitationSub) {
        outCavitationSub.textContent = cavitationMarginMpa > 0 ? 'TBARS = 0.0 µg/g (No Radicals)' : 'HAZARD: Transient Cavitation Triggered';
        outCavitationSub.className = cavitationMarginMpa > 0 ? 'text-[10px] text-muted block' : 'text-[10px] text-rose-500 font-bold block';
      }

      // Update SVG styling & cream label
      if (svgCoolingJacket) {
        svgCoolingJacket.setAttribute('opacity', coolingOn ? '1.0' : '0.15');
      }
      if (svgCreamLabel) {
        svgCreamLabel.textContent = `${(separationYield * 0.42).toFixed(1)}% Lipids • ${separationYield.toFixed(1)}% Yield`;
      }

      // Overall status evaluation
      if (telemetryStatusCard && telemetryBadge && telemetrySummaryText) {
        if (!coolingOn && netTempRise > 4.5) {
          telemetryStatusCard.className = 'p-4 rounded-2xl border border-amber-800 bg-amber-950/30 text-amber-200 space-y-1';
          telemetryBadge.className = 'px-2 py-0.5 text-[10px] font-bold rounded-full bg-amber-900 border border-amber-700 text-amber-100 uppercase';
          telemetryBadge.textContent = 'THERMAL OVERHEATING WARNING';
          telemetrySummaryText.textContent = `Acoustic thermal dissipation is elevating product temperature to ${exitTemp.toFixed(1)}°C without cooling. Enable the chilled counter-current jacket to preserve delicate MFGM enzymes and polar lipids.`;
        } else if (flow > 2000 && totalPower < 1600) {
          telemetryStatusCard.className = 'p-4 rounded-2xl border border-rose-800 bg-rose-950/30 text-rose-200 space-y-1';
          telemetryBadge.className = 'px-2 py-0.5 text-[10px] font-bold rounded-full bg-rose-900 border border-rose-700 text-rose-100 uppercase';
          telemetryBadge.textContent = 'HIGH FLOW STREAMING BYPASS';
          telemetrySummaryText.textContent = `Volumetric throughput exceeds acoustophoretic capture threshold. Residence time (${residenceTimeSec.toFixed(1)}s) is insufficient to complete nodal migration. Reduce flow rate or boost acoustic generator power.`;
        } else {
          telemetryStatusCard.className = 'p-4 rounded-2xl border border-emerald-800 bg-emerald-950/20 text-emerald-200 space-y-1';
          telemetryBadge.className = 'px-2 py-0.5 text-[10px] font-bold rounded-full bg-emerald-900 border border-emerald-700 text-emerald-100 uppercase';
          telemetryBadge.textContent = 'OPTIMAL HARMONIC RESONANCE';
          telemetrySummaryText.textContent = `Dual-frequency standing waves fully active. Primary 400 kHz node spacing (1.88 mm) driving macro-globules; 1.6 MHz harmonic array trapping submicron haze at ${separationYield.toFixed(1)}% recovery.`;
        }
      }
    }

    // Attach listeners
    skidSelect?.addEventListener('change', recalculate);
    matrixSelect?.addEventListener('change', recalculate);
    primaryPowerInput?.addEventListener('input', recalculate);
    secondaryPowerInput?.addEventListener('input', recalculate);
    flowRateInput?.addEventListener('input', recalculate);
    tempInput?.addEventListener('input', recalculate);
    coolingToggle?.addEventListener('change', recalculate);

    // Preset click handlers
    presetButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const preset = btn.getAttribute('data-preset');
        if (preset === 'dairy') {
          if (matrixSelect) matrixSelect.value = 'whole_bovine_milk';
          if (primaryPowerInput) primaryPowerInput.value = '2400';
          if (secondaryPowerInput) secondaryPowerInput.value = '1600';
          if (flowRateInput) flowRateInput.value = '1200';
          if (tempInput) tempInput.value = '18';
          if (coolingToggle) coolingToggle.checked = true;
        } else if (preset === 'algae') {
          if (matrixSelect) matrixSelect.value = 'microalgae_biomass_broth';
          if (primaryPowerInput) primaryPowerInput.value = '2800';
          if (secondaryPowerInput) secondaryPowerInput.value = '2200';
          if (flowRateInput) flowRateInput.value = '450';
          if (tempInput) tempInput.value = '22';
          if (coolingToggle) coolingToggle.checked = true;
        } else if (preset === 'coffee') {
          if (matrixSelect) matrixSelect.value = 'cold_brew_coffee_extract';
          if (primaryPowerInput) primaryPowerInput.value = '1200';
          if (secondaryPowerInput) secondaryPowerInput.value = '900';
          if (flowRateInput) flowRateInput.value = '800';
          if (tempInput) tempInput.value = '12';
          if (coolingToggle) coolingToggle.checked = true;
        } else if (preset === 'infant') {
          if (matrixSelect) matrixSelect.value = 'whole_bovine_milk';
          if (primaryPowerInput) primaryPowerInput.value = '2800';
          if (secondaryPowerInput) secondaryPowerInput.value = '1800';
          if (flowRateInput) flowRateInput.value = '750';
          if (tempInput) tempInput.value = '15';
          if (coolingToggle) coolingToggle.checked = true;
        } else if (preset === 'hazard') {
          if (matrixSelect) matrixSelect.value = 'whole_bovine_milk';
          if (primaryPowerInput) primaryPowerInput.value = '600';
          if (secondaryPowerInput) secondaryPowerInput.value = '300';
          if (flowRateInput) flowRateInput.value = '2500';
          if (tempInput) tempInput.value = '38';
          if (coolingToggle) coolingToggle.checked = false;
        }
        recalculate();
      });
    });

    // Run initial calculation
    recalculate();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMegasonicModeler);
  } else {
    initMegasonicModeler();
  }
</script>
