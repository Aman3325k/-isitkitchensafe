<script>
  // Client-side physics engine for interactive recalculation
  function initUhpsModeler() {
    const container = document.querySelector('.uhps-mfs-modeler-container');
    if (!container) return;

    // Sliders
    const formulationSelect = document.getElementById('uhps-formulation') as HTMLSelectElement | null;
    const pressureInput = document.getElementById('uhps-pressure') as HTMLInputElement | null;
    const tempInput = document.getElementById('uhps-temp') as HTMLInputElement | null;
    const co2Input = document.getElementById('uhps-co2') as HTMLInputElement | null;
    const orificeInput = document.getElementById('uhps-orifice') as HTMLInputElement | null;
    const flowInput = document.getElementById('uhps-flow') as HTMLInputElement | null;

    // Value Labels
    const pressureVal = document.getElementById('uhps-pressure-val');
    const tempVal = document.getElementById('uhps-temp-val');
    const co2Val = document.getElementById('uhps-co2-val');
    const orificeVal = document.getElementById('uhps-orifice-val');
    const flowVal = document.getElementById('uhps-flow-val');

    // Telemetry Outputs
    const outDroplet = document.getElementById('uhps-out-droplet');
    const outSterility = document.getElementById('uhps-out-sterility');
    const outShear = document.getElementById('uhps-out-shear');
    const outEpsilon = document.getElementById('uhps-out-epsilon');
    const outPdi = document.getElementById('uhps-out-pdi');
    const outClarity = document.getElementById('uhps-out-clarity');
    const outRetention = document.getElementById('uhps-out-retention');
    const outSec = document.getElementById('uhps-out-sec');

    // Chart & Visuals
    const chartBar = document.getElementById('uhps-chart-bar');
    const chartBarVal = document.getElementById('uhps-chart-bar-val');
    const chartLogBar = document.getElementById('uhps-chart-log-bar');
    const chartLogVal = document.getElementById('uhps-chart-log-val');
    const verdictTitle = document.getElementById('uhps-verdict-title');
    const verdictDesc = document.getElementById('uhps-verdict-desc');
    const verdictBox = document.getElementById('uhps-verdict-box');
    const particleScale = document.getElementById('uhps-particle-scale');

    const presets = {
      curcumin: { form: 'curcumin_mct_nanoemulsion', p: 220, t: 38, co2: 8.0, orif: 87, flow: 50 },
      resveratrol: { form: 'resveratrol_phospholipid_nanoemulsion', p: 240, t: 36, co2: 9.5, orif: 75, flow: 45 },
      citrus: { form: 'citrus_quillaja_antimicrobial_nanoemulsion', p: 190, t: 34, co2: 7.0, orif: 95, flow: 60 },
      peaprotein: { form: 'probiotic_spore_pea_protein_nanoemulsion', p: 210, t: 37, co2: 8.5, orif: 87, flow: 50 },
      astaxanthin: { form: 'astaxanthin_omega3_nanoemulsion', p: 250, t: 35, co2: 10.0, orif: 70, flow: 40 },
      hazard: { form: 'curcumin_mct_nanoemulsion', p: 60, t: 28, co2: 1.5, orif: 140, flow: 90 }
    };

    function recalculate() {
      const p = parseFloat(pressureInput?.value || '220');
      const t = parseFloat(tempInput?.value || '38');
      const co2 = parseFloat(co2Input?.value || '8.0');
      const orif = parseFloat(orificeInput?.value || '87');
      const flow = parseFloat(flowInput?.value || '50');

      if (pressureVal) pressureVal.textContent = `${p.toFixed(0)} bar`;
      if (tempVal) tempVal.textContent = `${t.toFixed(1)} °C`;
      if (co2Val) co2Val.textContent = `${co2.toFixed(1)} vol %`;
      if (orificeVal) orificeVal.textContent = `${orif.toFixed(0)} µm`;
      if (flowVal) flowVal.textContent = `${flow.toFixed(1)} L/h`;

      // Check supercritical state
      const isSupercritical = p >= 73.8 && t >= 31.1;

      // Hydrodynamic calculation
      // Velocity v_jet = Q / (pi/4 * d^2)
      const orifM = orif * 1e-6;
      const flowM3s = (flow * 1e-3) / 3600;
      const vJet = flowM3s / (Math.PI * Math.pow(orifM / 2, 2));
      const shearRate = (8 * vJet) / orifM;

      // Energy dissipation rate epsilon
      const deltaPPa = p * 1e5;
      const rho = 980; // approximate emulsion density kg/m3
      const chamberVol = Math.PI * Math.pow(orifM / 2, 2) * (orifM * 10);
      const epsilon = (deltaPPa * flowM3s) / (rho * chamberVol);

      // Droplet calculation based on Kolmogorov-Hinze
      let d32 = 0;
      let logReduction = 0;
      let pdi = 0.08;
      let clarity = 95.0;
      let retention = 99.5;

      if (isSupercritical) {
        // Interfacial tension reduced by scCO2
        const sigmaEffective = 0.002 * (15.0 / Math.max(co2, 2.0));
        d32 = Math.max(28.0, 32.0 * Math.pow(220 / p, 0.75) * Math.pow(orif / 87, 0.5) * (10.0 / Math.max(co2, 2.0)));
        logReduction = Math.min(7.2, 4.0 + (p - 100) * 0.018 + (t - 30) * 0.03 + co2 * 0.08);
        pdi = Math.min(0.25, 0.065 + (orif / 150) * 0.04);
        clarity = Math.max(70.0, Math.min(99.0, 100.0 - (d32 - 30) * 0.8));
        retention = Math.max(90.0, 100.0 - (t > 45 ? (t - 45) * 0.6 : 0.1));
      } else {
        // Subcritical phase - poor dispersion and poor sterilization
        d32 = 180.0 + (100 - p) * 1.5;
        logReduction = Math.max(0.5, 1.0 + (p / 73.8) * 0.8);
        pdi = 0.38;
        clarity = 35.0;
        retention = 98.0;
      }

      const sec = (p * 1e5) / (rho * 0.85 * 3.6e6); // kWh/kg

      // Telemetry DOM updates
      if (outDroplet) outDroplet.textContent = `${d32.toFixed(1)} nm`;
      if (outSterility) outSterility.textContent = `${logReduction.toFixed(1)} log10`;
      if (outShear) outShear.textContent = `${(shearRate / 1e7).toFixed(2)}×10⁷ s⁻¹`;
      if (outEpsilon) outEpsilon.textContent = `${(epsilon / 1e8).toFixed(2)}×10⁸ W/kg`;
      if (outPdi) outPdi.textContent = `${pdi.toFixed(3)}`;
      if (outClarity) outClarity.textContent = `${clarity.toFixed(1)}%`;
      if (outRetention) outRetention.textContent = `${retention.toFixed(1)}%`;
      if (outSec) outSec.textContent = `${sec.toFixed(3)} kWh/kg`;

      // Chart updates
      if (chartBar) {
        const heightPct = Math.min(100, Math.max(10, (d32 / 200) * 100));
        chartBar.style.height = `${heightPct}%`;
      }
      if (chartBarVal) chartBarVal.textContent = `${d32.toFixed(1)}nm`;

      if (chartLogBar) {
        const heightPct = Math.min(100, Math.max(10, (logReduction / 7.0) * 100));
        chartLogBar.style.height = `${heightPct}%`;
      }
      if (chartLogVal) chartLogVal.textContent = `${logReduction.toFixed(1)} log`;

      // Particle text
      if (particleScale) {
        particleScale.textContent = `d_32 = ${d32.toFixed(1)} nm (${d32 < 50 ? 'Sub-50 nm Rayleigh Transparent' : 'Turbid Tyndall Scattering'})`;
      }

      // Verdict styling
      if (isSupercritical && d32 < 50 && logReduction >= 6.0) {
        if (verdictBox) {
          verdictBox.className = "mb-6 p-4 rounded-2xl border transition-all bg-emerald-950/40 border-emerald-500/80 text-emerald-200 shadow-md";
        }
        if (verdictTitle) verdictTitle.textContent = `SUB-50nm OPTICAL NANO-EMULSION (${d32.toFixed(1)} nm) • >${logReduction.toFixed(1)} LOG10 STERILE`;
        if (verdictDesc) verdictDesc.textContent = `Supercritical CO2 dense-phase interfacial tension reduction combined with diamond chamber micro-turbulent dissipation achieves complete spore and pathogen lethality without thermal degradation under FDA 21 CFR § 117.`;
      } else if (!isSupercritical) {
        if (verdictBox) {
          verdictBox.className = "mb-6 p-4 rounded-2xl border transition-all bg-red-950/50 border-red-500/80 text-red-200 shadow-md";
        }
        if (verdictTitle) verdictTitle.textContent = `HAZARD: SUBCRITICAL CO2 PHASE FAULT (P < 73.8 bar / T < 31.1 °C)`;
        if (verdictDesc) verdictDesc.textContent = `Interfacial tension not eliminated. Emulsion exhibits broad polydispersity (d_32 > 150 nm), severe turbidity, and insufficient microbial lethality (<2.0 log10). Critical parameters required.`;
      } else {
        if (verdictBox) {
          verdictBox.className = "mb-6 p-4 rounded-2xl border transition-all bg-amber-950/40 border-amber-500/80 text-amber-200 shadow-md";
        }
        if (verdictTitle) verdictTitle.textContent = `SUB-OPTIMAL DISPERSION (${d32.toFixed(1)} nm) • ${logReduction.toFixed(1)} LOG10 INACTIVATION`;
        if (verdictDesc) verdictDesc.textContent = `Supercritical phase maintained, but shear rate or CO2 dosing requires optimization to cross the sub-50 nm threshold for true beverage clarity.`;
      }
    }

    // Attach listeners
    [pressureInput, tempInput, co2Input, orificeInput, flowInput].forEach(input => {
      input?.addEventListener('input', recalculate);
    });

    formulationSelect?.addEventListener('change', () => {
      const selected = formulationSelect.value;
      if (selected === 'curcumin_mct_nanoemulsion') applyPreset('curcumin');
      else if (selected === 'resveratrol_phospholipid_nanoemulsion') applyPreset('resveratrol');
      else if (selected === 'citrus_quillaja_antimicrobial_nanoemulsion') applyPreset('citrus');
      else if (selected === 'probiotic_spore_pea_protein_nanoemulsion') applyPreset('peaprotein');
      else if (selected === 'astaxanthin_omega3_nanoemulsion') applyPreset('astaxanthin');
    });

    function applyPreset(key: keyof typeof presets) {
      const data = presets[key];
      if (!data) return;
      if (formulationSelect) formulationSelect.value = data.form;
      if (pressureInput) pressureInput.value = data.p.toString();
      if (tempInput) tempInput.value = data.t.toString();
      if (co2Input) co2Input.value = data.co2.toString();
      if (orificeInput) orificeInput.value = data.orif.toString();
      if (flowInput) flowInput.value = data.flow.toString();
      recalculate();
    }

    document.querySelectorAll('.preset-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const presetKey = target.getAttribute('data-preset') as keyof typeof presets;
        if (presetKey) applyPreset(presetKey);
      });
    });

    // Run initial computation
    recalculate();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initUhpsModeler);
  } else {
    initUhpsModeler();
  }
</script>
