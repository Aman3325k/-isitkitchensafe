    pressureLabel: "均質化＆超臨界チャンバー運転圧力 (bar)：",
    pressureHelp: "運転圧力（100 – 300 bar, 臨界圧 P_crit = 73.8 bar）。超音速マイクロジェット加速と高密度相CO2の細胞膜浸透を牽引します。",
    tempLabel: "プロセス流体運転温度 (°C)：",
    tempHelp: "等温均質化温度（25.0 – 55.0 °C, 臨界温度 T_crit = 31.1 °C）。熱感受性機能成分の熱変性を完全に防止します。",
    co2Label: "超臨界CO2注入溶解比率 (vol %)：",
    co2Help: "連続液相流に溶解させる高密度超臨界CO2体積比（2.0 – 15.0 vol %）。油水界面張力を劇的に低下させます。",
    orificeLabel: "ダイヤモンド微細流路オリフィス径 (µm)：",
    orificeHelp: "微細加工ダイヤモンド製Y型流路の狭小部孔径（50 – 150 µm）。剪断速度 γ̇ と乱流散逸率 ε を決定します。",
    flowLabel: "連続処理供給流量 (L/h)：",
    flowHelp: "ダイヤモンド相互作用チャンバーを通過する連続製品供給流量（10.0 – 100.0 L/h）。",
    presetsTitle: "シミュレーション プリセット：",
    presetCurcumin: "クルクミン / MCTオイル（38.5 nm, 6.4 log10）",
    presetResveratrol: "レスベラトロール / リン脂質（34.2 nm, 6.8 log10）",
    presetCitrus: "柑橘系コールドプレス精油（42.0 nm, 6.2 log10）",
    presetPeaProtein: "エンドウ豆タンパク質 / 芽胞保護系（44.8 nm, 6.5 log10）",
    presetAstaxanthin: "アスタキサンチン / オメガ3（32.8 nm, 6.9 log10）",
    presetHazard: "亜臨界相態 / 低剪断フォールト（<73.8 bar）",
    telemetryTitle: "微粒化・非加熱無菌化リアルタイム物理テレメトリ",
    telemetrySub: "Sauter平均粒子径 d_32、細菌芽胞対数減少値、剪断速度、乱流散逸率、および光学透明度のリアルタイム力学演算結果。",
    dropletLabel: "Sauter平均液滴径 d_32 (nm)：",
    sterilityLabel: "微生物＆細菌芽胞殺菌対数減少値 (log10)：",
    shearRateLabel: "ダイヤモンド流路内剪断速度 γ̇ (s⁻¹)：",
    energyDissipationLabel: "乱流運動エネルギー散逸率 ε (W/kg)：",
    pdiLabel: "多分散度指数 (PDI)：",
    clarityLabel: "光学透明度 / 透光率 (% Transmittance)：",
    bioactiveRetentionLabel: "機能性成分化学的保持率 (%)：",
    secLabel: "単位製品比エネルギー消費量 (SEC, kWh/kg)：",
    verdictLabel: "ナノエマルション均質化＆無菌化判定：",
    diagramTitle: "ダイヤモンド流路超臨界マイクロフルイダイザー スキッド系統図",
    diagramSub: "超高圧プランジャーポンプ、超臨界CO2オンライン混和部、対向型Y型ダイヤモンドチャンバー、および減圧気液分離部。",
    chartTitle: "Kolmogorov-Hinze 粒子径分布＆殺菌速度論",
    chartSub: "50 nm未満の UHPS-MFS、従来型高圧ホモジナイザー、および撹拌機の比較と、D_scCO2 非加熱殺菌挙動。",
    principlesTitle: "Kolmogorov-Hinze 微細化力学＆超臨界殺菌機序",
    principlesSub: "乱流微細化モデル、Laplace 内圧突破条件、超臨界CO2による細胞内急激酸性化、および水力衝撃波による機械的溶菌機序。",
    compTitle: "産業用ナノ乳化＆商業的殺菌技術の横断的比較",
    compSub: "UHPS-MFS、従来型マイクロフルイダイザー、高圧ピストンホモジナイザー、およびUHT加熱殺菌の性能・品質比較。",
    regTitle: "衛生工学基準および無菌プロセス国際規格適合性",
    regSub: "FDA 21 CFR § 117 FSMA cGMP、21 CFR § 113、3-A 衛生規格 63-04 & 08-17、EHEDG Type EL Class I、および ASME Section VIII 適合。"
  }
};

const d = DICT[lang] || DICT.en;
const formulations = uhpsData.nanoEmulsionFormulations;
const techComp = uhpsData.industrialTechnologyComparison;
---

<div class="uhps-mfs-modeler-container my-8" data-lang={lang}>
  <!-- Header Card -->
  <header class="bg-gradient-to-br from-cyan-950/80 via-slate-900 to-indigo-950/80 border border-cyan-800/60 rounded-3xl p-6 sm:p-10 shadow-xl backdrop-blur-md mb-8">
    <div class="flex flex-wrap items-center gap-3 mb-4">
      <span class="px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-cyan-500/20 text-cyan-300 border border-cyan-500/40 shadow-xs">
        {d.badge}
      </span>
      <span class="text-xs text-muted font-mono tracking-tight">
        FDA 21 CFR § 117 • 3-A Standards 63-04 • ASME B31.3 • γ̇ &gt; 10⁷ s⁻¹ • d_32 &lt; 45 nm
      </span>
    </div>
    <h1 class="text-2xl sm:text-4xl font-extrabold text-ink tracking-tight mb-4">
      {d.title}
    </h1>
    <p class="text-sm sm:text-base text-muted max-w-4xl leading-relaxed">
      {d.subtitle}
    </p>
  </header>

  <!-- Quick Presets -->
  <section class="mb-8 bg-surface-soft border border-hairline rounded-2xl p-4 sm:p-6 shadow-xs">
    <h2 class="text-sm font-bold text-ink uppercase tracking-wider mb-3">
      {d.presetsTitle}
    </h2>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2 sm:gap-3 text-xs">
      <button type="button" class="preset-btn px-3 py-2.5 rounded-xl border border-cyan-700/50 bg-cyan-950/40 hover:bg-cyan-900/60 text-cyan-200 text-left font-medium transition-all" data-preset="curcumin">
        {d.presetCurcumin}
      </button>
      <button type="button" class="preset-btn px-3 py-2.5 rounded-xl border border-indigo-700/50 bg-indigo-950/40 hover:bg-indigo-900/60 text-indigo-200 text-left font-medium transition-all" data-preset="resveratrol">
        {d.presetResveratrol}
      </button>
      <button type="button" class="preset-btn px-3 py-2.5 rounded-xl border border-amber-700/50 bg-amber-950/40 hover:bg-amber-900/60 text-amber-200 text-left font-medium transition-all" data-preset="citrus">
        {d.presetCitrus}
      </button>
      <button type="button" class="preset-btn px-3 py-2.5 rounded-xl border border-emerald-700/50 bg-emerald-950/40 hover:bg-emerald-900/60 text-emerald-200 text-left font-medium transition-all" data-preset="peaprotein">
        {d.presetPeaProtein}
      </button>
      <button type="button" class="preset-btn px-3 py-2.5 rounded-xl border border-rose-700/50 bg-rose-950/40 hover:bg-rose-900/60 text-rose-200 text-left font-medium transition-all" data-preset="astaxanthin">
        {d.presetAstaxanthin}
      </button>
      <button type="button" class="preset-btn px-3 py-2.5 rounded-xl border border-red-700/60 bg-red-950/50 hover:bg-red-900/70 text-red-200 text-left font-medium transition-all" data-preset="hazard">
        {d.presetHazard}
      </button>
    </div>
  </section>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-8">
    <!-- Controls Column (5 cols) -->
    <div class="lg:col-span-5 space-y-6">
      <section class="bg-surface border border-hairline rounded-3xl p-6 sm:p-8 shadow-sm">
        <h2 class="text-lg font-bold text-ink mb-1">
          {d.controlsTitle}
        </h2>
        <p class="text-xs text-muted mb-6">
          {d.controlsSub}
        </p>

        <div class="space-y-5">
          <!-- Formulation Selector -->
          <div>
            <label for="uhps-formulation" class="block text-xs font-bold text-ink mb-1.5">
              {d.formulationLabel}
            </label>
            <select id="uhps-formulation" class="w-full bg-surface-soft border border-hairline rounded-xl px-3 py-2 text-xs font-medium text-ink focus:outline-hidden focus:ring-2 focus:ring-cyan-500">
              {formulations.map((f) => (
                <option value={f.id}>{f.name}</option>
              ))}
            </select>
            <p class="text-[11px] text-muted mt-1">{d.formulationHelp}</p>
          </div>

          <!-- Operating Pressure -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label for="uhps-pressure" class="text-xs font-bold text-ink">
                {d.pressureLabel}
              </label>
              <span id="uhps-pressure-val" class="font-mono text-xs font-bold text-cyan-400">220 bar</span>
            </div>
            <input type="range" id="uhps-pressure" min="100" max="300" step="5" value="220" class="w-full accent-cyan-500 cursor-pointer" />
            <div class="flex justify-between text-[10px] text-muted mt-1">
              <span>100 bar</span>
              <span class="text-amber-400 font-semibold">P_crit = 73.8 bar</span>
              <span>300 bar</span>
            </div>
            <p class="text-[11px] text-muted mt-1">{d.pressureHelp}</p>
          </div>

          <!-- Temperature -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label for="uhps-temp" class="text-xs font-bold text-ink">
                {d.tempLabel}
              </label>
              <span id="uhps-temp-val" class="font-mono text-xs font-bold text-cyan-400">38.0 °C</span>
            </div>
            <input type="range" id="uhps-temp" min="25" max="55" step="1" value="38" class="w-full accent-cyan-500 cursor-pointer" />
            <div class="flex justify-between text-[10px] text-muted mt-1">
              <span>25.0 °C</span>
              <span class="text-amber-400 font-semibold">T_crit = 31.1 °C</span>
              <span>55.0 °C</span>
            </div>
            <p class="text-[11px] text-muted mt-1">{d.tempHelp}</p>
          </div>

          <!-- CO2 Injection Ratio -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label for="uhps-co2" class="text-xs font-bold text-ink">
                {d.co2Label}
              </label>
              <span id="uhps-co2-val" class="font-mono text-xs font-bold text-cyan-400">8.0 vol %</span>
            </div>
            <input type="range" id="uhps-co2" min="2.0" max="15.0" step="0.5" value="8.0" class="w-full accent-cyan-500 cursor-pointer" />
            <div class="flex justify-between text-[10px] text-muted mt-1">
              <span>2.0%</span>
              <span>Optimum 7–10%</span>
              <span>15.0%</span>
            </div>
            <p class="text-[11px] text-muted mt-1">{d.co2Help}</p>
          </div>

          <!-- Diamond Orifice Diameter -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label for="uhps-orifice" class="text-xs font-bold text-ink">
                {d.orificeLabel}
              </label>
              <span id="uhps-orifice-val" class="font-mono text-xs font-bold text-cyan-400">87 µm</span>
            </div>
            <input type="range" id="uhps-orifice" min="50" max="150" step="5" value="87" class="w-full accent-cyan-500 cursor-pointer" />
            <div class="flex justify-between text-[10px] text-muted mt-1">
              <span>50 µm (Ultra-Shear)</span>
              <span>87 µm (Standard)</span>
              <span>150 µm (High-Flow)</span>
            </div>
            <p class="text-[11px] text-muted mt-1">{d.orificeHelp}</p>
          </div>

          <!-- Volumetric Feed Flow Rate -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label for="uhps-flow" class="text-xs font-bold text-ink">
                {d.flowLabel}
              </label>
              <span id="uhps-flow-val" class="font-mono text-xs font-bold text-cyan-400">50.0 L/h</span>
            </div>
            <input type="range" id="uhps-flow" min="10" max="100" step="5" value="50" class="w-full accent-cyan-500 cursor-pointer" />
            <div class="flex justify-between text-[10px] text-muted mt-1">
              <span>10.0 L/h</span>
              <span>50.0 L/h</span>
              <span>100.0 L/h</span>
            </div>
            <p class="text-[11px] text-muted mt-1">{d.flowHelp}</p>
          </div>
        </div>
      </section>
    </div>

    <!-- Live Telemetry & Verdict Column (7 cols) -->
    <div class="lg:col-span-7 space-y-6">
      <section class="bg-surface border border-hairline rounded-3xl p-6 sm:p-8 shadow-sm">
        <h2 class="text-lg font-bold text-ink mb-1">
          {d.telemetryTitle}
        </h2>
        <p class="text-xs text-muted mb-6">
          {d.telemetrySub}
        </p>

        <!-- Verdict Banner -->
        <div id="uhps-verdict-box" class="mb-6 p-4 rounded-2xl border transition-all bg-emerald-950/30 border-emerald-700/60 text-emerald-200">
          <div class="flex items-center gap-3">
            <span id="uhps-verdict-icon" class="text-2xl">✨</span>
            <div>
              <div class="text-[11px] uppercase tracking-wider font-bold opacity-80">{d.verdictLabel}</div>
              <div id="uhps-verdict-title" class="text-base font-extrabold text-ink">SUB-50nm OPTICAL NANO-EMULSION &gt;6.4 LOG10 STERILE</div>
            </div>
          </div>
          <p id="uhps-verdict-desc" class="text-xs text-muted mt-2 leading-relaxed">
            Turbulent dissipation rate ε > 1.6×10⁸ W/kg with supercritical CO2 dense-phase interfacial tension reduction achieves d_32 = 38.5 nm. Non-thermal cellular membrane collapse achieves 6.4 log10 bacterial endospore reduction without thermal degradation.
          </p>
        </div>

        <!-- Telemetry Metrics Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs mb-6">
          <!-- Droplet Size -->
          <div class="p-3.5 rounded-2xl bg-surface-soft border border-hairline">
            <span class="text-muted block text-[10px] font-bold uppercase">{d.dropletLabel}</span>
            <span id="uhps-out-droplet" class="text-lg font-black text-cyan-400 font-mono">38.5 nm</span>
            <span id="uhps-sub50-badge" class="block text-[10px] text-emerald-400 font-medium">Sub-50 nm Aseptic</span>
          </div>

          <!-- Log10 Reduction -->
          <div class="p-3.5 rounded-2xl bg-surface-soft border border-hairline">
            <span class="text-muted block text-[10px] font-bold uppercase">{d.sterilityLabel}</span>
            <span id="uhps-out-sterility" class="text-lg font-black text-emerald-400 font-mono">6.4 log10</span>
            <span id="uhps-spore-badge" class="block text-[10px] text-emerald-400 font-medium">Endospores Killed</span>
          </div>

          <!-- Shear Rate -->
          <div class="p-3.5 rounded-2xl bg-surface-soft border border-hairline">
            <span class="text-muted block text-[10px] font-bold uppercase">{d.shearRateLabel}</span>
            <span id="uhps-out-shear" class="text-lg font-black text-indigo-300 font-mono">1.15×10⁷ s⁻¹</span>
            <span class="block text-[10px] text-muted font-mono">&gt; 10⁷ s⁻¹ Threshold</span>
          </div>

          <!-- Energy Dissipation -->
          <div class="p-3.5 rounded-2xl bg-surface-soft border border-hairline">
            <span class="text-muted block text-[10px] font-bold uppercase">{d.energyDissipationLabel}</span>
            <span id="uhps-out-epsilon" class="text-lg font-black text-amber-300 font-mono">1.65×10⁸ W/kg</span>
            <span class="block text-[10px] text-muted font-mono">Kolmogorov Scale &lt; 8 nm</span>
          </div>

          <!-- PDI -->
          <div class="p-3.5 rounded-2xl bg-surface-soft border border-hairline">
            <span class="text-muted block text-[10px] font-bold uppercase">{d.pdiLabel}</span>
            <span id="uhps-out-pdi" class="text-lg font-black text-ink font-mono">0.082</span>
            <span class="block text-[10px] text-emerald-400 font-medium">Monodisperse &lt; 0.10</span>
          </div>

          <!-- Optical Clarity -->
          <div class="p-3.5 rounded-2xl bg-surface-soft border border-hairline">
            <span class="text-muted block text-[10px] font-bold uppercase">{d.clarityLabel}</span>
            <span id="uhps-out-clarity" class="text-lg font-black text-cyan-300 font-mono">96.8%</span>
            <span class="block text-[10px] text-cyan-400 font-medium">Crystal Clear Beverage</span>
          </div>

          <!-- Bioactive Retention -->
          <div class="p-3.5 rounded-2xl bg-surface-soft border border-hairline">
            <span class="text-muted block text-[10px] font-bold uppercase">{d.bioactiveRetentionLabel}</span>
            <span id="uhps-out-retention" class="text-lg font-black text-emerald-300 font-mono">99.4%</span>
            <span class="block text-[10px] text-muted font-medium">Zero Heat Degradation</span>
          </div>

          <!-- Specific Energy Consumption -->
          <div class="p-3.5 rounded-2xl bg-surface-soft border border-hairline">
            <span class="text-muted block text-[10px] font-bold uppercase">{d.secLabel}</span>
            <span id="uhps-out-sec" class="text-lg font-black text-amber-200 font-mono">0.115 kWh/kg</span>
            <span class="block text-[10px] text-emerald-400 font-medium">-88% vs Pasteurization</span>
          </div>
        </div>

        <!-- Animated Particle Visualizer Box -->
        <div class="p-4 rounded-2xl bg-slate-950/60 border border-hairline flex flex-col items-center justify-center relative overflow-hidden">
          <div class="text-[11px] font-mono text-muted mb-2 w-full flex justify-between items-center">
            <span>Dynamic Droplet Size & Micro-Jet Representation:</span>
            <span id="uhps-particle-scale" class="text-cyan-400 font-bold">d_32 = 38.5 nm (Rayleigh Scattering Regime)</span>
          </div>
          
          <div class="w-full h-24 bg-gradient-to-r from-slate-900 via-cyan-950/40 to-slate-900 rounded-xl border border-hairline/60 flex items-center justify-around relative px-4">
            <!-- Simulated Nano-Droplets -->
            <div class="flex items-center gap-2" id="droplet-visual-array">
              <div class="droplet-dot w-3 h-3 rounded-full bg-cyan-400 shadow-[0_0_8px_#22d3ee] animate-pulse"></div>
              <div class="droplet-dot w-2.5 h-2.5 rounded-full bg-cyan-300 shadow-[0_0_6px_#67e8f9]"></div>
              <div class="droplet-dot w-3.5 h-3.5 rounded-full bg-cyan-400 shadow-[0_0_9px_#22d3ee]"></div>
              <div class="droplet-dot w-2 h-2 rounded-full bg-cyan-200 shadow-[0_0_5px_#a5f3fc]"></div>
              <div class="droplet-dot w-3 h-3 rounded-full bg-cyan-400 shadow-[0_0_8px_#22d3ee] animate-pulse"></div>
            </div>

            <div class="text-center font-mono text-[11px]">
              <span class="text-muted block">Brownian Diffusion Velocity:</span>
              <span id="uhps-brownian-vel" class="text-emerald-400 font-bold">v_B = 1.42 × 10⁻³ m/s</span>
            </div>

            <div class="text-center font-mono text-[11px]">
              <span class="text-muted block">Gravitational Settling:</span>
              <span class="text-emerald-400 font-bold">Stable &gt; 365 Days</span>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>

  <!-- Interactive SVG Schematic Diagram -->
  <section class="bg-surface border border-hairline rounded-3xl p-6 sm:p-10 shadow-sm mb-8">
    <div class="mb-6">
      <h2 class="text-xl font-bold text-ink mb-1">
        {d.diagramTitle}
      </h2>
      <p class="text-xs sm:text-sm text-muted">
        {d.diagramSub}
      </p>
    </div>

    <div class="w-full overflow-x-auto bg-slate-950/80 rounded-2xl p-4 sm:p-6 border border-hairline/80">
      <svg class="w-full min-w-[700px] h-[320px]" viewBox="0 0 950 320" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="pipeFluid" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#0891b2" />
            <stop offset="50%" stop-color="#06b6d4" />
            <stop offset="100%" stop-color="#3b82f6" />
          </linearGradient>
          <linearGradient id="scCo2Flow" x1="0%" y1="100%" x2="0%" y2="0%">
            <stop offset="0%" stop-color="#10b981" />
            <stop offset="100%" stop-color="#34d399" />
          </linearGradient>
          <linearGradient id="diamondChamberGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#1e1b4b" />
            <stop offset="50%" stop-color="#312e81" />
            <stop offset="100%" stop-color="#0f172a" />
          </linearGradient>
          <filter id="glowEffect" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur stdDeviation="3" result="glow" />
            <feComposite in="SourceGraphic" in2="glow" operator="over" />
          </filter>
        </defs>

        <!-- Background grid lines -->
        <pattern id="diagGrid" width="20" height="20" patternUnits="userSpaceOnUse">
          <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#1e293b" stroke-width="0.5" />
        </pattern>
        <rect width="950" height="320" fill="url(#diagGrid)" opacity="0.7" />

        <!-- 1. High-Pressure Intensifier Dual-Head Pump -->
        <g transform="translate(40, 80)">
          <rect width="130" height="150" rx="14" fill="#0f172a" stroke="#0284c7" stroke-width="2" />
          <text x="65" y="30" fill="#38bdf8" font-size="11" font-weight="bold" text-anchor="middle" font-family="monospace">HIGH-PRESSURE</text>
          <text x="65" y="45" fill="#38bdf8" font-size="11" font-weight="bold" text-anchor="middle" font-family="monospace">INTENSIFIER PUMP</text>
          
          <rect x="25" y="60" width="80" height="40" rx="6" fill="#1e293b" stroke="#38bdf8" stroke-dasharray="3 3" />
          <text x="65" y="85" fill="#f8fafc" font-size="14" font-weight="bold" text-anchor="middle" font-family="monospace">P = 220 bar</text>

