    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 text-xs">
      <div class="p-4 rounded-2xl bg-surface border border-hairline space-y-1.5">
        <div class="font-bold text-ink">FDA 21 CFR § 117 FSMA cGMP</div>
