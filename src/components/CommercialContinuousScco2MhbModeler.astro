<!-- Reactive Client-Side Simulation Script -->
<script is:inline define:vars={{ formulations }}>
  (function initMhbSimulator() {
    function setup() {
      const container = document.querySelector('.scco2-mhb-container');
      if (!container) return;

      const formulationSelect = document.getElementById('mhb-formulation');
      const formulationDesc = document.getElementById('mhb-formulation-desc');
      const pressureSlider = document.getElementById('mhb-pressure');
      const pressureVal = document.getElementById('mhb-pressure-val');
      const tempSlider = document.getElementById('mhb-temp');
      const tempVal = document.getElementById('mhb-temp-val');
      const orificeSlider = document.getElementById('mhb-orifice');
      const orificeVal = document.getElementById('mhb-orifice-val');
      const residenceSlider = document.getElementById('mhb-residence');
      const residenceVal = document.getElementById('mhb-residence-val');
      const flowSlider = document.getElementById('mhb-flow');
      const flowVal = document.getElementById('mhb-flow-val');

      // Telemetry elements
      const telePh = document.getElementById('telemetry-ph');
      const teleCaRate = document.getElementById('telemetry-ca-rate');
      const teleDiameter = document.getElementById('telemetry-diameter');
      const telePdi = document.getElementById('telemetry-pdi');
      const teleEncapsulation = document.getElementById('telemetry-encapsulation');
      const teleGastric = document.getElementById('telemetry-gastric');
      const teleColon = document.getElementById('telemetry-colon');
      const teleProbioticLoss = document.getElementById('telemetry-probiotic-loss');
      const teleSec = document.getElementById('telemetry-sec');
      const teleVerdict = document.getElementById('telemetry-verdict');

      // Presets
      const presetBtns = container.querySelectorAll('.preset-btn');
      presetBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const preset = btn.getAttribute('data-preset');
          if (preset === 'probiotic') {
            formulationSelect.value = 'probiotic_live_bifidobacterium_delivery';
            pressureSlider.value = 95;
            tempSlider.value = 37.0;
            orificeSlider.value = 45;
            residenceSlider.value = 6.5;
            flowSlider.value = 65;
          } else if (preset === 'curcumin') {
            formulationSelect.value = 'curcumin_polyphenol_nano_crystals';
            pressureSlider.value = 120;
            tempSlider.value = 38.5;
            orificeSlider.value = 50;
            residenceSlider.value = 8.0;
            flowSlider.value = 80;
          } else if (preset === 'anthocyanin') {
            formulationSelect.value = 'anthocyanin_delphinidin_extract';
            pressureSlider.value = 110;
            tempSlider.value = 36.0;
            orificeSlider.value = 40;
            residenceSlider.value = 5.5;
            flowSlider.value = 55;
          } else if (preset === 'algal') {
            formulationSelect.value = 'algal_dha_omega3_nano_emulsion';
            pressureSlider.value = 135;
            tempSlider.value = 40.0;
            orificeSlider.value = 60;
            residenceSlider.value = 9.0;
            flowSlider.value = 90;
          } else if (preset === 'hazard') {
            pressureSlider.value = 75; // Below supercritical transition
            tempSlider.value = 48.0;
            orificeSlider.value = 110;
            residenceSlider.value = 1.5;
            flowSlider.value = 220;
          }
          updateSimulation();
        });
      });

      function updateSimulation() {
        const selectedId = formulationSelect.value;
        const currentForm = formulations.find(f => f.id === selectedId) || formulations[0];
        formulationDesc.textContent = currentForm.payloadDescription;

        const pressure = parseFloat(pressureSlider.value);
        const temp = parseFloat(tempSlider.value);
        const orifice = parseFloat(orificeSlider.value);
        const residence = parseFloat(residenceSlider.value);
        const flow = parseFloat(flowSlider.value);

        // Update Slider value displays
        pressureVal.textContent = pressure.toFixed(1) + ' bar';
        tempVal.textContent = temp.toFixed(1) + ' °C';
        orificeVal.textContent = orifice.toFixed(1) + ' µm';
        residenceVal.textContent = residence.toFixed(1) + ' s';
        flowVal.textContent = flow.toFixed(1) + ' L/h';

        // Physics Model:
        // 1. In-situ Carbonic Acid pH:
        // At 75-180 bar, CO2 solubility k_H increases with pressure, lowering droplet pH
        // Ideal range: 3.2 - 3.8
        const inSituPh = Math.max(3.05, Math.min(5.2, 5.8 - (pressure / 100) * 1.85 + (temp - 35) * 0.035));

        // 2. Calcium Dissolution Rate:
        // Exponentially driven by proton concentration [H+] = 10^(-pH)
        const hPlus = Math.pow(10, -inSituPh);
        const caRate = Math.min(1.85, Math.max(0.08, (hPlus * 1800) * (pressure / 100) * 1.15));

        // 3. Monodisperse Bead Diameter:
        // d_bead scales with d_orifice and (Q / Q_ref)^0.48
        const flowRatio = flow / 65.0;
        const beadDiameter = orifice * 0.63 * Math.pow(flowRatio, 0.22);

        // 4. Polydispersity Index (PDI):
        // Lowest when orifice is 35-55um and flow is steady
        let pdi = currentForm.polydispersityIndexPdi + Math.abs(orifice - 45) * 0.0003 + (flow > 120 ? (flow - 120) * 0.0002 : 0);
        if (pressure < 80) pdi += 0.08; // incomplete gelation broadens size distribution

        // 5. Encapsulation Efficiency:
        let encEff = currentForm.encapsulationEfficiencyPct;
        if (residence < 4.0) encEff -= (4.0 - residence) * 3.5;
        if (pressure < 82.0) encEff -= (82.0 - pressure) * 0.8;
        encEff = Math.max(68.0, Math.min(99.6, encEff));

        // 6. Gastric Survival (pH 1.2):
        let gastricSurvival = currentForm.gastricSimulatedFluidSurvivalPct;
        if (inSituPh > 4.0) gastricSurvival -= (inSituPh - 4.0) * 15.0;
        if (residence < 4.0) gastricSurvival -= (4.0 - residence) * 4.0;
        gastricSurvival = Math.max(52.0, Math.min(99.4, gastricSurvival));

        // 7. Targeted Colon Release (pH 7.4):
        let colonDelivery = currentForm.targetedColonReleasePct;
        if (gastricSurvival < 90) colonDelivery = gastricSurvival * 0.98;
        if (pressure < 80) colonDelivery -= 12.0;
        colonDelivery = Math.max(45.0, Math.min(99.5, colonDelivery));

        // 8. Probiotic Viability Loss:
        let probLoss = currentForm.probioticViabilityLossLogCfu;
        if (temp > 42.0) probLoss += (temp - 42.0) * 0.35;
        if (pressure > 160.0) probLoss += (pressure - 160.0) * 0.008;

        // 9. Specific Energy Consumption (SEC):
        const sec = (0.35 + (pressure / 180) * 0.18 + (flow / 250) * 0.08).toFixed(2);

        // Update Telemetry Display
        telePh.textContent = 'pH ' + inSituPh.toFixed(2);
        teleCaRate.textContent = caRate.toFixed(2) + ' mmol/s';
        teleDiameter.textContent = beadDiameter.toFixed(1) + ' µm';
        telePdi.textContent = pdi.toFixed(3);
        teleEncapsulation.textContent = encEff.toFixed(1) + '%';
        teleGastric.textContent = gastricSurvival.toFixed(1) + '%';
        teleColon.textContent = colonDelivery.toFixed(1) + '%';
        teleProbioticLoss.textContent = probLoss.toFixed(2) + ' log CFU';
        teleSec.textContent = sec + ' kWh/kg payload';

        // Styling and Verdict
        const isOptimal = (pressure >= 82 && inSituPh <= 3.85 && pdi <= 0.055 && gastricSurvival >= 95.0 && colonDelivery >= 96.0);
        if (isOptimal) {
          teleVerdict.className = 'text-sm font-bold font-mono text-emerald-400';
          teleVerdict.textContent = '✅ OPTIMAL SOL-GEL GELATION • USP <711> ENTERIC PASS';
          telePdi.className = 'text-2xl font-bold font-mono text-emerald-400';
          teleColon.className = 'text-2xl font-bold font-mono text-emerald-400';
        } else if (pressure < 80) {
          teleVerdict.className = 'text-sm font-bold font-mono text-rose-400 animate-pulse';
          teleVerdict.textContent = '🚨 HAZARD: SUB-CRITICAL CO2 • INCOMPLETE GELATION';
          telePdi.className = 'text-2xl font-bold font-mono text-rose-400';
          teleColon.className = 'text-2xl font-bold font-mono text-rose-400';
        } else {
          teleVerdict.className = 'text-sm font-bold font-mono text-amber-400';
          teleVerdict.textContent = '⚠️ SUB-OPTIMAL PARAMETERS • CHECK RESIDENCE & PRESSURE';
          telePdi.className = 'text-2xl font-bold font-mono text-amber-400';
          teleColon.className = 'text-2xl font-bold font-mono text-amber-400';
        }

        renderChart(gastricSurvival, colonDelivery);
      }

      // Canvas Dissolution Chart
      function renderChart(gastricSurvival, colonDelivery) {
        const canvas = document.getElementById('mhb-dissolution-chart');
        if (!canvas) return;
        const ctx = canvas.getContext('2d');
        const dpr = window.devicePixelRatio || 1;

        const rect = canvas.getBoundingClientRect();
        canvas.width = rect.width * dpr;
        canvas.height = rect.height * dpr;
        ctx.scale(dpr, dpr);

        const w = rect.width;
        const h = rect.height;

        ctx.clearRect(0, 0, w, h);

        const padLeft = 45;
        const padRight = 20;
        const padTop = 20;
        const padBottom = 30;

        const graphW = w - padLeft - padRight;
        const graphH = h - padTop - padBottom;

        // Background Zones (Stomach, Intestine, Colon)
        const xStomachEnd = padLeft + graphW * 0.25; // 0-2 hr
        const xIntestineEnd = padLeft + graphW * 0.55; // 2-4.5 hr

        // Stomach Zone
        ctx.fillStyle = 'rgba(6, 182, 212, 0.08)';
        ctx.fillRect(padLeft, padTop, xStomachEnd - padLeft, graphH);

        // Small Intestine Zone
        ctx.fillStyle = 'rgba(245, 158, 11, 0.08)';
        ctx.fillRect(xStomachEnd, padTop, xIntestineEnd - xStomachEnd, graphH);

        // Colon Zone
        ctx.fillStyle = 'rgba(16, 185, 129, 0.08)';
        ctx.fillRect(xIntestineEnd, padTop, padLeft + graphW - xIntestineEnd, graphH);

        // Grid Lines
        ctx.strokeStyle = 'rgba(148, 163, 184, 0.15)';
        ctx.lineWidth = 1;
        for (let pct = 0; pct <= 100; pct += 25) {
          const y = padTop + graphH - (pct / 100) * graphH;
          ctx.beginPath();
          ctx.moveTo(padLeft, y);
          ctx.lineTo(padLeft + graphW, y);
          ctx.stroke();

          ctx.fillStyle = '#94a3b8';
          ctx.font = '10px monospace';
          ctx.textAlign = 'right';
          ctx.fillText(pct + '%', padLeft - 6, y + 3);
        }

        // Zone Labels
        ctx.font = 'bold 10px sans-serif';
        ctx.fillStyle = '#06b6d4';
        ctx.textAlign = 'center';
        ctx.fillText('STOMACH (pH 1.2)', padLeft + (xStomachEnd - padLeft) / 2, padTop + 14);

        ctx.fillStyle = '#f59e0b';
        ctx.fillText('DUODENUM (pH 6.8)', xStomachEnd + (xIntestineEnd - xStomachEnd) / 2, padTop + 14);

        ctx.fillStyle = '#10b981';
        ctx.fillText('COLON (pH 7.4)', xIntestineEnd + (padLeft + graphW - xIntestineEnd) / 2, padTop + 14);

        // X-Axis Time Labels
        const times = ['0h', '2h', '4h', '6h', '8h'];
        times.forEach((tStr, idx) => {
          const x = padLeft + (idx / 4) * graphW;
          ctx.fillStyle = '#94a3b8';
          ctx.font = '10px monospace';
          ctx.textAlign = 'center';
          ctx.fillText(tStr, x, h - 10);
        });

        // Dissolution Curve Points (Time 0 to 8h)
        // At 0h: 0%
        // At 2h: 100 - gastricSurvival (e.g., 2-3%)
        // At 4h: ~12-18%
        // At 6h: ~85%
        // At 8h: colonDelivery (e.g. 98.6%)
        const gastricLeak = Math.max(0.5, 100.0 - gastricSurvival);
        const curvePoints = [
          { t: 0, r: 0 },
          { t: 1.0, r: gastricLeak * 0.4 },
          { t: 2.0, r: gastricLeak },
          { t: 3.0, r: gastricLeak + 6.0 },
          { t: 4.0, r: gastricLeak + 12.0 },
          { t: 5.0, r: 48.0 },
          { t: 6.0, r: colonDelivery * 0.88 },
          { t: 7.0, r: colonDelivery * 0.96 },
          { t: 8.0, r: colonDelivery }
        ];

        // Draw Line Curve
        ctx.beginPath();
        curvePoints.forEach((pt, i) => {
          const x = padLeft + (pt.t / 8.0) * graphW;
          const y = padTop + graphH - (pt.r / 100.0) * graphH;
          if (i === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        });

        ctx.strokeStyle = '#10b981';
        ctx.lineWidth = 3;
        ctx.stroke();

        // Draw Area Under Curve
        ctx.lineTo(padLeft + graphW, padTop + graphH);
        ctx.lineTo(padLeft, padTop + graphH);
        ctx.fillStyle = 'rgba(16, 185, 129, 0.15)';
        ctx.fill();

        // Draw Point Markers
        curvePoints.forEach(pt => {
          const x = padLeft + (pt.t / 8.0) * graphW;
          const y = padTop + graphH - (pt.r / 100.0) * graphH;
          ctx.beginPath();
          ctx.arc(x, y, 4, 0, Math.PI * 2);
          ctx.fillStyle = '#ffffff';
          ctx.fill();
          ctx.strokeStyle = '#10b981';
          ctx.lineWidth = 2;
          ctx.stroke();
        });
      }

      // Event Listeners
      formulationSelect.addEventListener('change', updateSimulation);
      pressureSlider.addEventListener('input', updateSimulation);
      tempSlider.addEventListener('input', updateSimulation);
      orificeSlider.addEventListener('input', updateSimulation);
      residenceSlider.addEventListener('input', updateSimulation);
      flowSlider.addEventListener('input', updateSimulation);
      window.addEventListener('resize', updateSimulation);

      // Initial Run
      updateSimulation();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setup);
    } else {
      setup();
    }
  })();
</script>
