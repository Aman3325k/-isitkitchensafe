    inSituPhLabel: "液滴内原位炭酸酸性化pH：",
    calciumRateLabel: "内部カルシウムイオン解離速度：",
    beadDiameterLabel: "固化ビーズ平均粒子径 (d_bead)：",
    pdiLabel: "粒子径単分散性指数 (PDI)：",
    encapsulationLabel: "生体活性物質カプセル化効率：",
    gastricSurvivalLabel: "人工胃液耐性生存率 (pH 1.2)：",
    colonDeliveryLabel: "標的大腸定点到達送達率：",
    probioticLossLabel: "プロバイオティクス生菌数損失 (Δ Log CFU)：",
    secLabel: "比エネルギー消費量 (SEC)：",
    verdictLabel: "固化判定および規制適合グレード：",
    diagramTitle: "同軸マイクロ流体ノズルおよび高密度超臨界CO2固化チャンバー",
    diagramSub: "精密同軸コアシェルマイクロ毛細管流体フォーカシングと高圧超臨界CO2原位酸性化、カルシウム内部架橋、背圧回収機構。",
    chartTitle: "消化管管腔内インビトロ溶出・放出キネティクス",
    chartSub: "USP <711> に準拠した溶出挙動：胃酸耐性バリア（pH 1.2）、十二指腸保護（pH 6.8）、大腸での急速放出（pH 7.4）。",
    principlesTitle: "マイクロ流体力学および超臨界ゾル-ゲル固化制御原理",
    principlesSub: "支配方程式：毛細管ウェーバー数、ヘンリーの法則CO2溶解平衡、原位プロトン解離、およびアルギン酸エッグボックス多価イオン架橋。",
    compTitle: "産業用マイクロカプセル化技術ベンチマーク比較",
    compSub: "scCO2-MHB、高温スプレードライ、有機溶媒蒸発法、流動層コーティングの直接性能比較。",
    regTitle: "国際規制適合性およびサニタリーエンジニアリング基準",
    regSub: "FDA 21 CFR § 117、FDA GRAS アルギン酸塩（21 CFR § 184.1724）、USP <711> 溶出、3-Aサニタリー 63-04/08-17、EHEDG Type EL Class I、ASME Section VIII Div 1 適合。"
  }
};

const d = DICT[lang] || DICT.en;
const formulations = mhbData.bioactivePayloadFormulations;
const comparisonData = mhbData.industrialTechnologyComparison;
---

<div class="scco2-mhb-container space-y-12 max-w-7xl mx-auto" data-lang={lang}>
  <!-- Top Hero Header Badge & Quick Stats Banner -->
  <div class="bg-surface-soft border border-hairline rounded-3xl p-6 sm:p-8 lg:p-10 shadow-xs relative overflow-hidden">
    <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-950 text-emerald-400 border border-emerald-800/80 shadow-xs">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        {d.badge}
      </div>
      <div class="flex items-center gap-2 text-xs font-mono text-muted">
        <span>ISO 22000 / FSMA cGMP</span>
        <span>&bull;</span>
        <span>USP &lt;711&gt; Enteric</span>
        <span>&bull;</span>
        <span class="text-emerald-400 font-semibold">100% Solvent-Free</span>
      </div>
    </div>

    <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-ink tracking-tight mb-4">
      {d.title}
    </h2>
    <p class="text-body text-sm sm:text-base leading-relaxed max-w-4xl">
      {d.subtitle}
    </p>

    <!-- Key Performance Indicator Pill Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 mt-8 pt-6 border-t border-hairline/60">
      <div class="bg-surface p-3.5 sm:p-4 rounded-2xl border border-hairline">
        <div class="text-xs text-muted mb-1 font-medium">Particle Monodispersity</div>
        <div class="text-xl sm:text-2xl font-bold font-mono text-emerald-400">PDI &lt; 0.045</div>
        <div class="text-[11px] text-muted mt-0.5">Ultra-Uniform 10–80 µm</div>
      </div>
      <div class="bg-surface p-3.5 sm:p-4 rounded-2xl border border-hairline">
        <div class="text-xs text-muted mb-1 font-medium">Targeted Colon Delivery</div>
        <div class="text-xl sm:text-2xl font-bold font-mono text-emerald-400">&gt; 98.2%</div>
        <div class="text-[11px] text-muted mt-0.5">Resists Gastric Juice pH 1.2</div>
      </div>
      <div class="bg-surface p-3.5 sm:p-4 rounded-2xl border border-hairline">
        <div class="text-xs text-muted mb-1 font-medium">Live Probiotic Survival</div>
        <div class="text-xl sm:text-2xl font-bold font-mono text-emerald-400">&gt; 97.5%</div>
        <div class="text-[11px] text-muted mt-0.5">Isothermal 35–40°C Operation</div>
      </div>
      <div class="bg-surface p-3.5 sm:p-4 rounded-2xl border border-hairline">
        <div class="text-xs text-muted mb-1 font-medium">Energy Savings vs Dryer</div>
        <div class="text-xl sm:text-2xl font-bold font-mono text-emerald-400">&gt; 82%</div>
        <div class="text-[11px] text-muted mt-0.5">0.42 kWh/kg Closed Cycle</div>
      </div>
    </div>
  </div>

  <!-- Interactive Controls & Simulator Matrix -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Controls Column (5 cols) -->
    <div class="lg:col-span-5 bg-surface-soft border border-hairline rounded-3xl p-6 sm:p-7 shadow-xs space-y-6">
      <div class="border-b border-hairline/80 pb-4">
        <h3 class="text-lg sm:text-xl font-bold text-ink mb-1">{d.controlsTitle}</h3>
        <p class="text-xs text-muted leading-relaxed">{d.controlsSub}</p>
      </div>

      <!-- Presets Selector -->
      <div>
        <label class="block text-xs font-semibold uppercase tracking-wider text-muted mb-2">
          {d.presetsTitle}
        </label>
        <div class="grid grid-cols-2 gap-2 text-xs">
          <button type="button" class="preset-btn px-3 py-2 rounded-xl bg-surface border border-hairline hover:border-emerald-500/60 text-left font-medium text-ink transition-all active:scale-[0.98]" data-preset="probiotic">
            🌿 {d.presetProbiotic}
          </button>
          <button type="button" class="preset-btn px-3 py-2 rounded-xl bg-surface border border-hairline hover:border-emerald-500/60 text-left font-medium text-ink transition-all active:scale-[0.98]" data-preset="curcumin">
            ⚡ {d.presetCurcumin}
          </button>
          <button type="button" class="preset-btn px-3 py-2 rounded-xl bg-surface border border-hairline hover:border-emerald-500/60 text-left font-medium text-ink transition-all active:scale-[0.98]" data-preset="anthocyanin">
            🫐 {d.presetAnthocyanin}
          </button>
          <button type="button" class="preset-btn px-3 py-2 rounded-xl bg-surface border border-hairline hover:border-emerald-500/60 text-left font-medium text-ink transition-all active:scale-[0.98]" data-preset="algal">
            🌊 {d.presetAlgal}
          </button>
        </div>
        <button type="button" class="preset-btn w-full mt-2 px-3 py-2 rounded-xl bg-rose-950/40 border border-rose-900/60 hover:border-rose-500/60 text-left font-medium text-rose-300 text-xs transition-all active:scale-[0.98]" data-preset="hazard">
          ⚠️ {d.presetInadequateHazard}
        </button>
      </div>

      <!-- Bioactive Formulation Selector -->
      <div>
        <div class="flex items-center justify-between mb-1.5">
          <label for="mhb-formulation" class="text-xs font-semibold uppercase tracking-wider text-muted">
            {d.payloadLabel}
          </label>
        </div>
        <select id="mhb-formulation" class="w-full bg-surface border border-hairline rounded-xl px-3.5 py-2.5 text-sm text-ink font-medium focus:outline-hidden focus:border-emerald-500 transition-colors">
          {formulations.map(f => (
            <option value={f.id}>{f.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1 leading-normal" id="mhb-formulation-desc">
          {formulations[0].payloadDescription}
        </p>
      </div>

      <!-- Pressure Slider -->
      <div>
        <div class="flex items-center justify-between mb-1">
          <label for="mhb-pressure" class="text-xs font-semibold uppercase tracking-wider text-muted">
            {d.pressureLabel}
          </label>
          <span class="font-mono text-sm font-bold text-emerald-400" id="mhb-pressure-val">95.0 bar</span>
        </div>
        <input 
          type="range" 
          id="mhb-pressure" 
          min="75" 
          max="180" 
          step="1" 
          value="95" 
          class="w-full h-2 bg-surface rounded-lg appearance-none cursor-pointer accent-emerald-500"
        />
        <p class="text-[11px] text-muted mt-1">{d.pressureHelp}</p>
      </div>

      <!-- Temperature Slider -->
      <div>
        <div class="flex items-center justify-between mb-1">
          <label for="mhb-temp" class="text-xs font-semibold uppercase tracking-wider text-muted">
            {d.tempLabel}
          </label>
          <span class="font-mono text-sm font-bold text-emerald-400" id="mhb-temp-val">37.0 °C</span>
        </div>
        <input 
          type="range" 
          id="mhb-temp" 
          min="32" 
          max="50" 
          step="0.5" 
          value="37" 
          class="w-full h-2 bg-surface rounded-lg appearance-none cursor-pointer accent-emerald-500"
        />
        <p class="text-[11px] text-muted mt-1">{d.tempHelp}</p>
      </div>

      <!-- Capillary Orifice Diameter Slider -->
      <div>
        <div class="flex items-center justify-between mb-1">
          <label for="mhb-orifice" class="text-xs font-semibold uppercase tracking-wider text-muted">
            {d.orificeLabel}
          </label>
          <span class="font-mono text-sm font-bold text-emerald-400" id="mhb-orifice-val">45.0 µm</span>
        </div>
        <input 
          type="range" 
          id="mhb-orifice" 
          min="25" 
          max="120" 
          step="1" 
          value="45" 
          class="w-full h-2 bg-surface rounded-lg appearance-none cursor-pointer accent-emerald-500"
        />
        <p class="text-[11px] text-muted mt-1">{d.orificeHelp}</p>
      </div>

      <!-- Supercritical Residence Time Slider -->
      <div>
        <div class="flex items-center justify-between mb-1">
          <label for="mhb-residence" class="text-xs font-semibold uppercase tracking-wider text-muted">
            {d.residenceLabel}
          </label>
          <span class="font-mono text-sm font-bold text-emerald-400" id="mhb-residence-val">6.5 s</span>
        </div>
        <input 
          type="range" 
          id="mhb-residence" 
          min="1.0" 
          max="25.0" 
          step="0.5" 
          value="6.5" 
          class="w-full h-2 bg-surface rounded-lg appearance-none cursor-pointer accent-emerald-500"
        />
        <p class="text-[11px] text-muted mt-1">{d.residenceHelp}</p>
      </div>

      <!-- Continuous Slurry Flow Rate Slider -->
      <div>
        <div class="flex items-center justify-between mb-1">
          <label for="mhb-flow" class="text-xs font-semibold uppercase tracking-wider text-muted">
            {d.flowLabel}
          </label>
          <span class="font-mono text-sm font-bold text-emerald-400" id="mhb-flow-val">65.0 L/h</span>
        </div>
        <input 
          type="range" 
          id="mhb-flow" 
          min="10" 
          max="250" 
          step="5" 
          value="65" 
          class="w-full h-2 bg-surface rounded-lg appearance-none cursor-pointer accent-emerald-500"
        />
        <p class="text-[11px] text-muted mt-1">{d.flowHelp}</p>
      </div>
    </div>

    <!-- Live Telemetry & Visualizer Column (7 cols) -->
    <div class="lg:col-span-7 space-y-6">
      <!-- Live Telemetry Card -->
      <div class="bg-surface-soft border border-hairline rounded-3xl p-6 sm:p-7 shadow-xs space-y-6">
        <div class="border-b border-hairline/80 pb-4">
          <h3 class="text-lg sm:text-xl font-bold text-ink mb-1">{d.telemetryTitle}</h3>
          <p class="text-xs text-muted leading-relaxed">{d.telemetrySub}</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- In-situ Carbonic pH -->
          <div class="bg-surface p-4 rounded-2xl border border-hairline">
            <div class="text-xs text-muted font-medium mb-1">{d.inSituPhLabel}</div>
            <div class="text-2xl font-bold font-mono text-cyan-400" id="telemetry-ph">pH 3.42</div>
            <div class="text-[11px] text-muted mt-1">H₂CO₃ in-situ sol-gel trigger</div>
          </div>

          <!-- Calcium Dissolution Rate -->
          <div class="bg-surface p-4 rounded-2xl border border-hairline">
            <div class="text-xs text-muted font-medium mb-1">{d.calciumRateLabel}</div>
            <div class="text-2xl font-bold font-mono text-emerald-400" id="telemetry-ca-rate">0.89 mmol/s</div>
            <div class="text-[11px] text-muted mt-1">Homogeneous internal crosslinking</div>
          </div>

          <!-- Bead Diameter -->
          <div class="bg-surface p-4 rounded-2xl border border-hairline">
            <div class="text-xs text-muted font-medium mb-1">{d.beadDiameterLabel}</div>
            <div class="text-2xl font-bold font-mono text-amber-400" id="telemetry-diameter">28.5 µm</div>
            <div class="text-[11px] text-muted mt-1">Monodisperse core-shell capsule</div>
          </div>

          <!-- PDI -->
          <div class="bg-surface p-4 rounded-2xl border border-hairline">
            <div class="text-xs text-muted font-medium mb-1">{d.pdiLabel}</div>
            <div class="text-2xl font-bold font-mono text-emerald-400" id="telemetry-pdi">0.038</div>
            <div class="text-[11px] text-muted mt-1">Sub-0.05 monodisperse ceiling</div>
          </div>

          <!-- Encapsulation Efficiency -->
          <div class="bg-surface p-4 rounded-2xl border border-hairline">
            <div class="text-xs text-muted font-medium mb-1">{d.encapsulationLabel}</div>
            <div class="text-2xl font-bold font-mono text-emerald-400" id="telemetry-encapsulation">98.8%</div>
            <div class="text-[11px] text-muted mt-1">Zero core leakage into scCO2</div>
          </div>

          <!-- Gastric Survival -->
          <div class="bg-surface p-4 rounded-2xl border border-hairline">
            <div class="text-xs text-muted font-medium mb-1">{d.gastricSurvivalLabel}</div>
            <div class="text-2xl font-bold font-mono text-cyan-400" id="telemetry-gastric">97.9%</div>
            <div class="text-[11px] text-muted mt-1">Intact barrier at pH 1.2 (2 hours)</div>
          </div>

          <!-- Colon Targeted Delivery -->
          <div class="bg-surface p-4 rounded-2xl border border-hairline">
            <div class="text-xs text-muted font-medium mb-1">{d.colonDeliveryLabel}</div>
            <div class="text-2xl font-bold font-mono text-emerald-400" id="telemetry-colon">98.6%</div>
            <div class="text-[11px] text-muted mt-1">Targeted ileum/colon release (pH &gt; 7.2)</div>
          </div>

          <!-- Probiotic Loss -->
          <div class="bg-surface p-4 rounded-2xl border border-hairline">
            <div class="text-xs text-muted font-medium mb-1">{d.probioticLossLabel}</div>
            <div class="text-2xl font-bold font-mono text-emerald-400" id="telemetry-probiotic-loss">0.12 log CFU</div>
            <div class="text-[11px] text-muted mt-1">&gt;97.2% survival vs &gt;3.5 log kill in spray dryer</div>
          </div>
        </div>

        <!-- System Energy & Verdict Box -->
        <div class="p-4 rounded-2xl bg-surface border border-hairline flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
          <div>
            <div class="text-xs text-muted font-medium">{d.secLabel}</div>
            <div class="text-lg font-bold font-mono text-ink" id="telemetry-sec">0.42 kWh/kg payload</div>
          </div>
          <div class="text-left sm:text-right">
            <div class="text-xs text-muted font-medium">{d.verdictLabel}</div>
            <div class="text-sm font-bold font-mono text-emerald-400" id="telemetry-verdict">
              ✅ OPTIMAL SOL-GEL GELATION • USP &lt;711&gt; ENTERIC PASS
            </div>
          </div>
        </div>
      </div>

      <!-- Coaxial Micro-Fluidic Nozzle & High-Pressure Chamber Schematic (SVG) -->
      <div class="bg-surface-soft border border-hairline rounded-3xl p-6 sm:p-7 shadow-xs space-y-4">
        <div>
          <h4 class="text-base font-bold text-ink mb-1">{d.diagramTitle}</h4>
          <p class="text-xs text-muted">{d.diagramSub}</p>
        </div>

        <div class="bg-surface rounded-2xl p-4 border border-hairline overflow-hidden flex items-center justify-center">
          <svg viewBox="0 0 720 280" class="w-full h-auto max-h-[300px] text-ink select-none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="co2FlowGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#06b6d4" stop-opacity="0.25" />
                <stop offset="50%" stop-color="#06b6d4" stop-opacity="0.8" />
                <stop offset="100%" stop-color="#10b981" stop-opacity="0.9" />
              </linearGradient>
              <linearGradient id="coreShellGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#f59e0b" stop-opacity="0.9" />
                <stop offset="100%" stop-color="#10b981" stop-opacity="0.9" />
              </linearGradient>
              <pattern id="gridPattern" width="20" height="20" patternUnits="userSpaceOnUse">
                <path d="M 20 0 L 0 0 0 20" fill="none" stroke="currentColor" stroke-opacity="0.05" stroke-width="1" />
              </pattern>
            </defs>

            <!-- Background Grid -->
            <rect width="720" height="280" fill="url(#gridPattern)" />

            <!-- Vessel Outer Shell (High-Pressure Autoclave) -->
            <rect x="200" y="25" width="480" height="230" rx="20" fill="#0f172a" stroke="#334155" stroke-width="2" />
            <text x="440" y="48" fill="#94a3b8" font-size="11" font-weight="bold" text-anchor="middle" letter-spacing="1">
              ASME B31.3 HIGH-PRESSURE scCO₂ GELATION CHAMBER (P = 80–180 BAR)
            </text>

            <!-- Supercritical CO2 Inlet Port -->
            <rect x="240" y="8" width="60" height="20" rx="4" fill="#0284c7" stroke="#38bdf8" stroke-width="1.5" />
            <text x="270" y="21" fill="#ffffff" font-size="9" font-weight="bold" text-anchor="middle">scCO₂ IN</text>
            <path d="M 270 28 L 270 65" stroke="#38bdf8" stroke-width="2.5" stroke-dasharray="4 3" marker-end="url(#arrow)" />

            <!-- Coaxial Microfluidic Nozzle Assembly -->
            <!-- Outer Shell Flow (Alginate/Chitosan/CaCO3) -->
            <path d="M 40 100 L 190 100 L 225 125 L 225 155 L 190 180 L 40 180 Z" fill="#1e293b" stroke="#10b981" stroke-width="2" />
            <text x="110" y="118" fill="#10b981" font-size="10" font-weight="bold">Shell: Alginate + CaCO₃</text>

            <!-- Inner Core Flow (Bioactive Payload) -->
            <path d="M 20 125 L 180 125 L 210 135 L 210 145 L 180 155 L 20 155 Z" fill="#334155" stroke="#f59e0b" stroke-width="2" />
            <text x="100" y="143" fill="#f59e0b" font-size="10" font-weight="bold">Core: Bioactive Cargo</text>

            <!-- Flow-Focusing Orifice (Pinch-off zone) -->
            <circle cx="225" cy="140" r="5" fill="#f59e0b" stroke="#ffffff" stroke-width="1.5" />
            <line x1="225" y1="80" x2="225" y2="130" stroke="#f59e0b" stroke-width="1" stroke-dasharray="2 2" />
            <text x="225" y="75" fill="#f59e0b" font-size="9" text-anchor="middle" font-family="monospace">Orifice d₀ (45 µm)</text>

            <!-- Micro-droplet Pinch-off to Solidified Bead Stream in scCO2 -->
            <!-- Droplet 1: Liquid core-shell pinch-off -->
            <circle cx="260" cy="140" r="8" fill="#f59e0b" stroke="#10b981" stroke-width="2.5" />
            <!-- Droplet 2: Rapid CO2 diffusion forming in-situ H2CO3 -->
            <circle cx="330" cy="140" r="8" fill="#f59e0b" stroke="#06b6d4" stroke-width="2.5" />
            <path d="M 320 115 L 328 130" stroke="#06b6d4" stroke-width="1.5" stroke-dasharray="2 2" />
            <path d="M 340 115 L 332 130" stroke="#06b6d4" stroke-width="1.5" stroke-dasharray="2 2" />
            <text x="330" y="108" fill="#06b6d4" font-size="9" text-anchor="middle">CO₂ Diffusion: pH &rarr; 3.4</text>

            <!-- Droplet 3: Internal Calcium Dissociation & Egg-Box Crosslinking -->
            <circle cx="430" cy="140" r="8" fill="#f59e0b" stroke="#10b981" stroke-width="3.5" />
            <text x="430" y="170" fill="#10b981" font-size="9" text-anchor="middle">Ca²⁺ Release &rarr; Egg-Box Gel</text>

            <!-- Droplet 4 & 5: Solidified Monodisperse Core-Shell Beads -->
            <circle cx="530" cy="140" r="8" fill="#d97706" stroke="#059669" stroke-width="3.5" />
            <circle cx="600" cy="140" r="8" fill="#d97706" stroke="#059669" stroke-width="3.5" />
            <text x="565" y="115" fill="#34d399" font-size="10" font-weight="bold" text-anchor="middle">
              Monodisperse Beads (PDI &lt; 0.045)
            </text>

            <!-- High-Pressure Slurry Discharge Valve -->
            <path d="M 640 140 L 680 140" stroke="#34d399" stroke-width="4" />
            <polygon points="675,135 685,140 675,145" fill="#34d399" />
            <text x="660" y="165" fill="#34d399" font-size="9" font-weight="bold" text-anchor="middle">Depressurization</text>

            <!-- CO2 Recovery Loop -->
            <path d="M 600 255 L 600 270 L 250 270 L 250 28" fill="none" stroke="#0284c7" stroke-width="1.5" stroke-dasharray="5 3" />
            <text x="420" y="275" fill="#38bdf8" font-size="9" text-anchor="middle">&gt;96% scCO₂ Closed Loop Recycle</text>
          </svg>
        </div>
      </div>

      <!-- Gastrointestinal Transit Dissolution Kinetics Canvas Chart -->
      <div class="bg-surface-soft border border-hairline rounded-3xl p-6 sm:p-7 shadow-xs space-y-4">
        <div>
          <h4 class="text-base font-bold text-ink mb-1">{d.chartTitle}</h4>
          <p class="text-xs text-muted">{d.chartSub}</p>
        </div>

        <div class="bg-surface rounded-2xl p-4 border border-hairline">
          <canvas id="mhb-dissolution-chart" class="w-full h-56"></canvas>
          <div class="flex flex-wrap items-center justify-between text-xs text-muted mt-3 pt-2 border-t border-hairline/60">
            <span class="inline-flex items-center gap-1.5">
              <span class="w-2.5 h-2.5 rounded-full bg-cyan-400"></span>
              Stomach (pH 1.2, 0–2h, &lt;2.1% Release)
            </span>
            <span class="inline-flex items-center gap-1.5">
              <span class="w-2.5 h-2.5 rounded-full bg-amber-400"></span>
              Small Intestine (pH 6.8, 2–4h, &lt;14.5% Release)
            </span>
            <span class="inline-flex items-center gap-1.5">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
