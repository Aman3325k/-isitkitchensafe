    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {maHphData.engineeringFormulas.map((form) => (
        <div class="p-4 rounded-xl bg-surface border border-hairline/80 flex flex-col justify-between">
