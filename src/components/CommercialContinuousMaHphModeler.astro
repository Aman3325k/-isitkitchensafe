        <!-- Process Telemetry Legend Overlay -->
        <rect x="30" y="215" width="785" height="45" rx="6" fill="#0f172a" fill-opacity="0.85" stroke="#334155" />
        <text x="45" y="235" fill="#cbd5e1" font-size="10" font-family="monospace">
          <tspan fill="#38bdf8" font-weight="bold">FEED:</tspan> Coarse Pre-Mix (d &gt; 2 µm) &bull; 
          <tspan fill="#818cf8" font-weight="bold">PRESSURE:</tspan> 180 MPa (420 m/s jet velocity) &bull; 
          <tspan fill="#f59e0b" font-weight="bold">MEGASONICS:</tspan> 1.2 MHz PZT Array &bull; 
          <tspan fill="#34d399" font-weight="bold">OUTPUT:</tspan> 58 nm Monodisperse Nano-Lipid (PDI &lt;0.08)
        </text>
        <text x="45" y="250" fill="#94a3b8" font-size="9" font-family="monospace">
          Sanitary Validation: FDA 21 CFR § 117 FSMA cGMP &bull; 3-A Sanitary Standards 04-05 &bull; ASME BPE-2024 &bull; USP &lt;467&gt; &lt;1788&gt;
        </text>
