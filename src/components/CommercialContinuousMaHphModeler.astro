    surfactantLabel: "界面活性剤／乳化剤添加量 (C_surf)：",
    surfactantHelp: "エマルション系内の天然または合成界面活性剤質量濃度（0.0〜10.0% w/w）。",
    presetsTitle: "産業用クイック設定プリセット：",
    presetOmega3: "高DHA藻類オメガ3ナノエマルション（180 MPa、1.2 MHz、62 nm、界面活性剤88%削減、生体利用率19.2倍）",
    presetCurcumin: "クルクミン＆アスタキサンチン疎水性ナノキャリア（220 MPa、1.4 MHz、52 nm、合成乳化剤94%削減、吸収率23.5倍）",
    presetPlantMilk: "クリーンラベル・バリスタ用オーツミルクタンパク質乳化（150 MPa、0.9 MHz、135 nm、合成添加物ゼロ完全フリー）",
    presetCoQ10: "レスベラトロール＆CoQ10細胞送達キャリア（200 MPa、1.6 MHz、46 nm、乳化剤90%削減、リンパ管吸収25.8倍）",
    presetHazard: "従来の低圧高界面活性剤粗大エマルション（危険：20 MPa、0 MHz、2,850 nm、8% ポリソルベート80、腸管バリア破壊）",
    telemetryTitle: "リアルタイムナノ乳化テレメトリー＆音響流体レーダー",
    telemetrySub: "ザウター平均粒子径、多分散指数、音響放射力、界面活性剤削減率を連続監視。",
    dropletSizeLabel: "液滴平均径 (d_32)：",
    pdiLabel: "多分散指数 (PDI)：",
    acousticForceLabel: "一次音響放射力 (F_rad)：",
    surfactantSavingsLabel: "界面活性剤削減率：",
    bioavailabilityLabel: "生体利用率向上倍率：",
    shelfLifeLabel: "物理的クリーミング分離半減期：",
    energyLabel: "比消費エネルギー (E_vol)：",
    asmeSafetyLabel: "ASME B31.3 疲労安全係数：",
    complianceVerdictLabel: "衛生規格＆FDA FSMA適合状況：",
    diagramTitle: "MA-HPH 連続音響流体動的プロセスフロー＆マイクロ流路模式図",
    diagramSub: "複数セラミックプランジャー加圧、ダイヤモンド対向噴流衝突、メガソニック定在波圧力節、オンラインDLSレーザー計測。",
    scienceTitle: "音響流体キャビテーションとナノ液滴微細化物理学",
    scienceSub: "レイリー・プレセット二次液滴分裂、音響放射力による合一阻止、ストークス・アインシュタインナノブラウン安定性。",
    tableTitle: "サニタリーエンジニアリング、材料金属学および規制基準",
    exportAuditBtn: "検証監査証明書のエクスポート (PDF / JSON)"
  }
};

const d = DICT[lang] || DICT.en;
---

<div id="ma-hph-modeler-root" class="bg-surface border border-hairline rounded-2xl p-6 lg:p-8 shadow-xs my-8" data-lang={lang}>
  <!-- Header Banner -->
  <div class="border-b border-hairline/80 pb-6 mb-8">
    <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-indigo-950 text-indigo-300 border border-indigo-800 font-mono">
        <svg class="w-3.5 h-3.5 text-indigo-400 animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        {d.badge}
      </span>
      <span class="text-xs text-muted font-mono bg-surface-soft px-3 py-1 rounded-md border border-hairline">
        MA-HPH &bull; 100&ndash;250 MPa &bull; 0.8&ndash;2.0 MHz &bull; d32 &lt;70 nm &bull; 3-A 04-05 &bull; ASME BPE
      </span>
    </div>
    <h1 class="text-2xl lg:text-3xl font-black text-ink tracking-tight mb-2">
      {d.title}
    </h1>
    <p class="text-sm lg:text-base text-body leading-relaxed max-w-4xl">
      {d.subtitle}
    </p>
  </div>

  <!-- Presets Strip -->
  <div class="mb-8 p-4 bg-surface-soft border border-hairline rounded-xl">
    <div class="text-xs font-bold uppercase tracking-wider text-muted mb-3 font-mono">
      ⚡ {d.presetsTitle}
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-2 text-xs">
      <button type="button" class="preset-btn text-left p-2.5 rounded-lg border border-hairline/70 hover:border-indigo-600 bg-surface hover:bg-indigo-950/20 text-ink transition" data-preset="omega3">
        <span class="font-bold text-indigo-400 block mb-0.5">🐟 High-DHA Algal Omega-3</span>
        <span class="text-muted text-[11px] block leading-tight">{d.presetOmega3}</span>
      </button>
      <button type="button" class="preset-btn text-left p-2.5 rounded-lg border border-hairline/70 hover:border-amber-600 bg-surface hover:bg-amber-950/20 text-ink transition" data-preset="curcumin">
        <span class="font-bold text-amber-400 block mb-0.5">🌿 Curcumin & Astaxanthin Carrier</span>
        <span class="text-muted text-[11px] block leading-tight">{d.presetCurcumin}</span>
      </button>
      <button type="button" class="preset-btn text-left p-2.5 rounded-lg border border-hairline/70 hover:border-emerald-600 bg-surface hover:bg-emerald-950/20 text-ink transition" data-preset="plantmilk">
        <span class="font-bold text-emerald-400 block mb-0.5">🥛 Clean-Label Barista Oat Milk</span>
        <span class="text-muted text-[11px] block leading-tight">{d.presetPlantMilk}</span>
      </button>
      <button type="button" class="preset-btn text-left p-2.5 rounded-lg border border-hairline/70 hover:border-cyan-600 bg-surface hover:bg-cyan-950/20 text-ink transition" data-preset="coq10">
        <span class="font-bold text-cyan-400 block mb-0.5">✨ Resveratrol & CoQ10 Carrier</span>
        <span class="text-muted text-[11px] block leading-tight">{d.presetCoQ10}</span>
      </button>
      <button type="button" class="preset-btn text-left p-2.5 rounded-lg border border-rose-800/80 hover:border-rose-600 bg-rose-950/20 hover:bg-rose-950/40 text-rose-200 transition md:col-span-2 lg:col-span-2" data-preset="hazard">
        <span class="font-bold text-rose-400 block mb-0.5">⚠️ Conventional Coarse Rotor-Stator (CRITICAL HAZARD)</span>
        <span class="text-rose-300/80 text-[11px] block leading-tight">{d.presetHazard}</span>
      </button>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-10">
    <!-- Controls Column (5 cols) -->
    <div class="lg:col-span-5 space-y-6">
      <div class="border border-hairline rounded-xl p-5 bg-surface-soft">
        <h2 class="text-base font-bold text-ink mb-1 flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-indigo-500"></span>
          {d.controlsTitle}
        </h2>
        <p class="text-xs text-muted mb-4">{d.controlsSub}</p>

        <div class="space-y-4 text-xs">
          <!-- Skid Selection -->
          <div>
            <label for="skid-select" class="block font-medium text-ink mb-1">{d.skidLabel}</label>
            <select id="skid-select" class="w-full bg-surface border border-hairline rounded-lg px-3 py-2 text-ink text-xs focus:outline-none focus:border-indigo-500">
              {maHphData.systemArchitectures.map((skid) => (
                <option value={skid.id}>{skid.name}</option>
              ))}
            </select>
            <span class="text-[11px] text-muted block mt-1">{d.skidHelp}</span>
          </div>

          <!-- Feedstock Profile Selection -->
          <div>
            <label for="feedstock-select" class="block font-medium text-ink mb-1">{d.feedstockLabel}</label>
            <select id="feedstock-select" class="w-full bg-surface border border-hairline rounded-lg px-3 py-2 text-ink text-xs focus:outline-none focus:border-indigo-500">
              {maHphData.lipidFeedstockProfiles.map((feed) => (
                <option value={feed.id}>{feed.name}</option>
              ))}
            </select>
            <span class="text-[11px] text-muted block mt-1">{d.feedstockHelp}</span>
          </div>

          <!-- Nozzle / Chamber Geometry -->
          <div>
            <label for="nozzle-select" class="block font-medium text-ink mb-1">{d.nozzleLabel}</label>
            <select id="nozzle-select" class="w-full bg-surface border border-hairline rounded-lg px-3 py-2 text-ink text-xs focus:outline-none focus:border-indigo-500">
              {maHphData.acousticNozzleGeometries.map((noz) => (
                <option value={noz.id}>{noz.name}</option>
              ))}
            </select>
            <span class="text-[11px] text-muted block mt-1">{d.nozzleHelp}</span>
          </div>

          <!-- Feed Rate Slider -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label for="feed-rate-slider" class="font-medium text-ink">{d.feedRateLabel}</label>
              <span id="feed-rate-val" class="font-mono font-bold text-indigo-400">1,200 L/h</span>
            </div>
            <input type="range" id="feed-rate-slider" min="50" max="5000" step="50" value="1200" class="w-full accent-indigo-500 h-1.5 bg-surface rounded-lg cursor-pointer" />
            <span class="text-[11px] text-muted block mt-1">{d.feedRateHelp}</span>
          </div>

          <!-- Pressure Slider -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label for="pressure-slider" class="font-medium text-ink">{d.pressureLabel}</label>
              <span id="pressure-val" class="font-mono font-bold text-indigo-400">180.0 MPa</span>
            </div>
            <input type="range" id="pressure-slider" min="50" max="250" step="5" value="180" class="w-full accent-indigo-500 h-1.5 bg-surface rounded-lg cursor-pointer" />
            <span class="text-[11px] text-muted block mt-1">{d.pressureHelp}</span>
          </div>

          <!-- Acoustic Frequency Slider -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label for="frequency-slider" class="font-medium text-ink">{d.frequencyLabel}</label>
              <span id="frequency-val" class="font-mono font-bold text-cyan-400">1.20 MHz</span>
            </div>
            <input type="range" id="frequency-slider" min="0.5" max="2.5" step="0.05" value="1.2" class="w-full accent-cyan-500 h-1.5 bg-surface rounded-lg cursor-pointer" />
            <span class="text-[11px] text-muted block mt-1">{d.frequencyHelp}</span>
          </div>

          <!-- Acoustic Power Slider -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label for="power-slider" class="font-medium text-ink">{d.acousticPowerLabel}</label>
              <span id="power-val" class="font-mono font-bold text-amber-400">450 W/L</span>
            </div>
            <input type="range" id="power-slider" min="100" max="800" step="25" value="450" class="w-full accent-amber-500 h-1.5 bg-surface rounded-lg cursor-pointer" />
            <span class="text-[11px] text-muted block mt-1">{d.acousticPowerHelp}</span>
          </div>

          <!-- Surfactant Concentration Slider -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label for="surfactant-slider" class="font-medium text-ink">{d.surfactantLabel}</label>
              <span id="surfactant-val" class="font-mono font-bold text-emerald-400">1.2% w/w</span>
            </div>
            <input type="range" id="surfactant-slider" min="0.0" max="10.0" step="0.2" value="1.2" class="w-full accent-emerald-500 h-1.5 bg-surface rounded-lg cursor-pointer" />
            <span class="text-[11px] text-muted block mt-1">{d.surfactantHelp}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Telemetry & Process Column (7 cols) -->
    <div class="lg:col-span-7 space-y-6">
      <!-- Live Metrics Radar Grid -->
      <div class="border border-hairline rounded-xl p-5 bg-surface-soft">
        <div class="flex items-center justify-between mb-4">
          <div>
            <h2 class="text-base font-bold text-ink flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-ping"></span>
              {d.telemetryTitle}
            </h2>
            <p class="text-xs text-muted">{d.telemetrySub}</p>
          </div>
          <span id="status-pill" class="px-2.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-emerald-950 text-emerald-300 border border-emerald-800 font-mono">
            3-A / FDA PASS
          </span>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mb-4">
          <!-- Droplet Size -->
          <div class="p-3 rounded-lg bg-surface border border-hairline">
            <span class="text-[11px] text-muted block font-medium">{d.dropletSizeLabel}</span>
            <div class="flex items-baseline gap-1 mt-1">
              <span id="droplet-size-metric" class="text-2xl font-black font-mono text-indigo-400">58.4</span>
              <span class="text-xs font-mono text-muted">nm</span>
            </div>
            <span id="droplet-size-sub" class="text-[10px] text-emerald-400 font-mono block mt-1">Ultra-Fine Sub-70 nm</span>
          </div>

          <!-- PDI -->
          <div class="p-3 rounded-lg bg-surface border border-hairline">
            <span class="text-[11px] text-muted block font-medium">{d.pdiLabel}</span>
            <div class="flex items-baseline gap-1 mt-1">
              <span id="pdi-metric" class="text-2xl font-black font-mono text-cyan-400">0.076</span>
            </div>
            <span id="pdi-sub" class="text-[10px] text-emerald-400 font-mono block mt-1">Monodisperse (&lt;0.10)</span>
          </div>

          <!-- Acoustic Force -->
          <div class="p-3 rounded-lg bg-surface border border-hairline">
            <span class="text-[11px] text-muted block font-medium">{d.acousticForceLabel}</span>
            <div class="flex items-baseline gap-1 mt-1">
              <span id="acoustic-force-metric" class="text-2xl font-black font-mono text-amber-400">14.2</span>
              <span class="text-xs font-mono text-muted">pN</span>
            </div>
            <span id="acoustic-force-sub" class="text-[10px] text-muted font-mono block mt-1">Anti-Coalescence Trap</span>
          </div>

          <!-- Surfactant Savings -->
          <div class="p-3 rounded-lg bg-surface border border-hairline">
            <span class="text-[11px] text-muted block font-medium">{d.surfactantSavingsLabel}</span>
            <div class="flex items-baseline gap-1 mt-1">
              <span id="savings-metric" class="text-xl font-black font-mono text-emerald-400">85.0%</span>
            </div>
            <span id="savings-sub" class="text-[10px] text-muted font-mono block mt-1">Clean-Label Formulation</span>
          </div>

          <!-- Bioavailability Multiplier -->
          <div class="p-3 rounded-lg bg-surface border border-hairline">
            <span class="text-[11px] text-muted block font-medium">{d.bioavailabilityLabel}</span>
            <div class="flex items-baseline gap-1 mt-1">
              <span id="bioavail-metric" class="text-xl font-black font-mono text-indigo-300">19.2x</span>
            </div>
            <span id="bioavail-sub" class="text-[10px] text-emerald-400 font-mono block mt-1">Intestinal Permeation</span>
          </div>

          <!-- Physical Shelf Life -->
          <div class="p-3 rounded-lg bg-surface border border-hairline">
            <span class="text-[11px] text-muted block font-medium">{d.shelfLifeLabel}</span>
            <div class="flex items-baseline gap-1 mt-1">
              <span id="shelflife-metric" class="text-xl font-black font-mono text-emerald-400">&gt; 365</span>
              <span class="text-xs font-mono text-muted">days</span>
            </div>
            <span id="shelflife-sub" class="text-[10px] text-emerald-400 font-mono block mt-1">Zero Gravitational Creaming</span>
          </div>
        </div>

        <div class="border-t border-hairline pt-3 space-y-2 text-xs">
          <div class="flex justify-between items-center">
            <span class="text-muted">{d.energyLabel}</span>
            <span id="sec-val" class="font-mono font-bold text-ink">14.8 kWh/m³ (35% lower than thermal)</span>
          </div>
          <div class="flex justify-between items-center">
            <span class="text-muted">{d.asmeSafetyLabel}</span>
            <span id="asme-val" class="font-mono font-bold text-emerald-400">SF = 4.8 &ge; 3.5 (10^8 Cycles Safe)</span>
          </div>
        </div>
      </div>

      <!-- Compliance Verdict Banner -->
      <div id="compliance-banner" class="p-4 rounded-xl border bg-emerald-950/40 border-emerald-800 text-xs text-emerald-200 flex items-start gap-3">
        <svg class="w-5 h-5 text-emerald-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <div>
          <span id="compliance-title" class="font-bold block text-sm text-emerald-300">COMPLIANT: 3-A 04-05 & FDA 21 CFR § 117 SANITARY VALIDATION</span>
          <span id="compliance-desc" class="text-muted block mt-0.5 leading-relaxed">
            The configured megasonic high-pressure nano-emulsifier generates sub-70 nm monodisperse droplets (PDI &lt;0.08) while operating below lipid oxidation thresholds (&lt;28°C discharge), reducing synthetic surfactant requirements by &gt;85% without cavitation erosion risk.
          </span>
        </div>
      </div>

      <!-- Export Action -->
      <div class="flex justify-end">
        <button type="button" id="export-audit-btn" class="px-4 py-2.5 rounded-xl bg-indigo-700 hover:bg-indigo-800 text-white font-medium text-xs transition shadow-xs flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          {d.exportAuditBtn}
        </button>
      </div>
    </div>
  </div>

  <!-- SVG Process Schematic Section -->
  <section class="border border-hairline rounded-xl p-6 bg-surface-soft mb-10">
    <div class="mb-4">
      <h3 class="text-base font-bold text-ink">{d.diagramTitle}</h3>
      <p class="text-xs text-muted">{d.diagramSub}</p>
    </div>

    <div class="w-full overflow-x-auto bg-surface border border-hairline rounded-xl p-4">
      <svg class="w-full min-w-[700px] h-[280px]" viewBox="0 0 840 280" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Background Grid -->
        <defs>
          <pattern id="hphGrid" width="20" height="20" patternUnits="userSpaceOnUse">
            <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#334155" stroke-width="0.5" stroke-opacity="0.25" />
          </pattern>
          <linearGradient id="liquidFeedGrad" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#38bdf8" />
            <stop offset="100%" stop-color="#818cf8" />
          </linearGradient>
          <linearGradient id="nanoStreamGrad" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#818cf8" />
            <stop offset="100%" stop-color="#34d399" />
          </linearGradient>
          <linearGradient id="acousticWaveGrad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#f59e0b" stop-opacity="0.8" />
            <stop offset="50%" stop-color="#f59e0b" stop-opacity="0.1" />
            <stop offset="100%" stop-color="#f59e0b" stop-opacity="0.8" />
          </linearGradient>
        </defs>
        <rect width="840" height="280" fill="url(#hphGrid)" rx="8" />

        <!-- Unit 1: Raw Feed & Pre-Mix Buffer Tank -->
        <g id="svg-feed-tank" transform="translate(30, 60)">
          <rect x="0" y="20" width="75" height="110" rx="8" fill="#1e293b" stroke="#475569" stroke-width="2" />
          <path d="M 5 60 Q 37.5 50 70 60 L 70 125 Q 37.5 130 5 125 Z" fill="#0284c7" fill-opacity="0.35" />
          <text x="37.5" y="42" fill="#94a3b8" font-size="9" font-family="monospace" text-anchor="middle">Feed Buffer</text>
          <text x="37.5" y="85" fill="#38bdf8" font-size="10" font-weight="bold" font-family="monospace" text-anchor="middle">Pre-Mix</text>
          <text x="37.5" y="100" fill="#cbd5e1" font-size="8" font-family="monospace" text-anchor="middle">Coarse &gt;2µm</text>
          <!-- Pipe Out -->
          <path d="M 75 90 L 120 90" stroke="#38bdf8" stroke-width="4" stroke-linecap="round" />
        </g>

        <!-- Unit 2: Ceramic Plunger High-Pressure Intensifier Pump -->
        <g id="svg-pump-intensifier" transform="translate(120, 45)">
          <rect x="0" y="25" width="115" height="90" rx="6" fill="#0f172a" stroke="#6366f1" stroke-width="2" />
          <!-- Plungers (Triple ceramic) -->
          <rect x="15" y="40" width="12" height="60" rx="2" fill="#e2e8f0" stroke="#94a3b8" />
          <rect x="50" y="40" width="12" height="60" rx="2" fill="#e2e8f0" stroke="#94a3b8" />
          <rect x="85" y="40" width="12" height="60" rx="2" fill="#e2e8f0" stroke="#94a3b8" />
          <text x="57.5" y="20" fill="#a5b4fc" font-size="10" font-weight="bold" font-family="monospace" text-anchor="middle">Hydraulic Intensifier</text>
          <text x="57.5" y="125" fill="#818cf8" font-size="9" font-family="monospace" text-anchor="middle">100&ndash;250 MPa</text>
          <!-- High-Pressure Discharge Pipe -->
          <path d="M 115 70 L 175 70" stroke="#818cf8" stroke-width="5" stroke-linecap="round" />
        </g>

        <!-- Unit 3: Opposed Diamond Jet Micro-Channel & Megasonic Collision Chamber -->
        <g id="svg-interaction-core" transform="translate(295, 30)">
          <!-- Outer Sanitary Block -->
          <rect x="0" y="10" width="180" height="150" rx="10" fill="#0f172a" stroke="#38bdf8" stroke-width="2.5" />
          <!-- Y-Type Diamond Channels -->
          <path d="M 0 85 L 45 85 L 75 55 L 105 85" stroke="#38bdf8" stroke-width="3" fill="none" />
          <path d="M 0 85 L 45 85 L 75 115 L 105 85" stroke="#38bdf8" stroke-width="3" fill="none" />
          <!-- Diamond Orifices -->
