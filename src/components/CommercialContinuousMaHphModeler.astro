        <tbody class="divide-y divide-hairline/60">
          {maHphData.regulatoryStandards.map((std) => (
            <tr class="hover:bg-surface/30 transition">
              <td class="py-3.5 px-4 font-mono font-bold text-indigo-400">{std.code}</td>
              <td class="py-3.5 px-4 font-medium text-ink">{std.organization}</td>
              <td class="py-3.5 px-4 text-muted">{std.title}</td>
              <td class="py-3.5 px-4 text-emerald-300 font-medium">{std.scope}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</div>

<!-- Reactive Client Script -->
<script is:inline>
  function initMaHphModeler() {
    const root = document.getElementById('ma-hph-modeler-root');
    if (!root) return;

    // Elements
    const skidSelect = root.querySelector('#skid-select');
    const feedstockSelect = root.querySelector('#feedstock-select');
    const nozzleSelect = root.querySelector('#nozzle-select');

    const feedRateSlider = root.querySelector('#feed-rate-slider');
    const feedRateVal = root.querySelector('#feed-rate-val');

    const pressureSlider = root.querySelector('#pressure-slider');
    const pressureVal = root.querySelector('#pressure-val');

    const frequencySlider = root.querySelector('#frequency-slider');
    const frequencyVal = root.querySelector('#frequency-val');

    const powerSlider = root.querySelector('#power-slider');
    const powerVal = root.querySelector('#power-val');

    const surfactantSlider = root.querySelector('#surfactant-slider');
    const surfactantVal = root.querySelector('#surfactant-val');

    // Metrics Display Elements
    const dropletSizeMetric = root.querySelector('#droplet-size-metric');
    const dropletSizeSub = root.querySelector('#droplet-size-sub');
    const pdiMetric = root.querySelector('#pdi-metric');
    const pdiSub = root.querySelector('#pdi-sub');
    const acousticForceMetric = root.querySelector('#acoustic-force-metric');
    const acousticForceSub = root.querySelector('#acoustic-force-sub');
    const savingsMetric = root.querySelector('#savings-metric');
    const savingsSub = root.querySelector('#savings-sub');
    const bioavailMetric = root.querySelector('#bioavail-metric');
    const bioavailSub = root.querySelector('#bioavail-sub');
    const shelflifeMetric = root.querySelector('#shelflife-metric');
    const shelflifeSub = root.querySelector('#shelflife-sub');
    const secVal = root.querySelector('#sec-val');
    const asmeVal = root.querySelector('#asme-val');
    const statusPill = root.querySelector('#status-pill');

    const complianceBanner = root.querySelector('#compliance-banner');
    const complianceTitle = root.querySelector('#compliance-title');
    const complianceDesc = root.querySelector('#compliance-desc');
    const exportBtn = root.querySelector('#export-audit-btn');

    function calculateMetrics() {
      const feedRate = parseFloat(feedRateSlider.value);
      const pressure = parseFloat(pressureSlider.value);
      const frequency = parseFloat(frequencySlider.value);
      const power = parseFloat(powerSlider.value);
      const surfactant = parseFloat(surfactantSlider.value);

      // Update Slider Label Displays
      if (feedRateVal) feedRateVal.textContent = `${feedRate.toLocaleString()} L/h`;
      if (pressureVal) pressureVal.textContent = `${pressure.toFixed(1)} MPa`;
      if (frequencyVal) frequencyVal.textContent = `${frequency.toFixed(2)} MHz`;
      if (powerVal) powerVal.textContent = `${power.toFixed(0)} W/L`;
      if (surfactantVal) surfactantVal.textContent = `${surfactant.toFixed(1)}% w/w`;

      const feedstockId = feedstockSelect.value;
      const nozzleId = nozzleSelect.value;

      // Hazard Check (Conventional Coarse Rotor-Stator Emulsion Hazard)
      if (feedstockId === 'conventional_coarse_rotor_stator_hazard') {
        if (dropletSizeMetric) {
          dropletSizeMetric.textContent = '2,850';
          dropletSizeMetric.className = 'text-2xl font-black font-mono text-rose-500';
        }
        if (dropletSizeSub) {
          dropletSizeSub.textContent = 'GIANT COARSE DROPLETS (>2.5 µm)';
          dropletSizeSub.className = 'text-[10px] text-rose-400 font-mono block mt-1 font-bold';
        }
        if (pdiMetric) {
          pdiMetric.textContent = '0.450';
          pdiMetric.className = 'text-2xl font-black font-mono text-rose-500';
        }
        if (pdiSub) {
          pdiSub.textContent = 'Severe Polydispersity (PDI > 0.4)';
          pdiSub.className = 'text-[10px] text-rose-400 font-mono block mt-1';
        }
        if (acousticForceMetric) {
          acousticForceMetric.textContent = '0.0';
          acousticForceMetric.className = 'text-2xl font-black font-mono text-muted';
        }
        if (acousticForceSub) {
          acousticForceSub.textContent = 'No Acoustic Standing Waves';
          acousticForceSub.className = 'text-[10px] text-rose-400 font-mono block mt-1';
        }
        if (savingsMetric) {
          savingsMetric.textContent = '0.0%';
          savingsMetric.className = 'text-xl font-black font-mono text-rose-500';
        }
        if (savingsSub) {
          savingsSub.textContent = 'Requires 8% Synthetic Polysorbate';
          savingsSub.className = 'text-[10px] text-rose-400 font-mono block mt-1';
        }
        if (bioavailMetric) {
          bioavailMetric.textContent = '1.0x';
          bioavailMetric.className = 'text-xl font-black font-mono text-muted';
        }
        if (bioavailSub) {
          bioavailSub.textContent = 'Baseline Poor GI Absorption';
          bioavailSub.className = 'text-[10px] text-rose-400 font-mono block mt-1';
        }
        if (shelflifeMetric) {
          shelflifeMetric.textContent = '< 14';
          shelflifeMetric.className = 'text-xl font-black font-mono text-rose-500';
        }
        if (shelflifeSub) {
          shelflifeSub.textContent = 'Rapid Phase Separation & Creaming';
          shelflifeSub.className = 'text-[10px] text-rose-400 font-mono block mt-1';
        }
        if (secVal) secVal.textContent = 'Non-Uniform Shear Mill (High Friction Waste)';
        if (asmeVal) asmeVal.textContent = 'Low Pressure Shear (No High Pressure Fatigue)';
        if (statusPill) {
          statusPill.textContent = 'PHASE INSTABILITY HAZARD';
          statusPill.className = 'px-2.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-rose-950 text-rose-300 border border-rose-800 font-mono';
        }
        if (complianceBanner) {
          complianceBanner.className = 'p-4 rounded-xl border bg-rose-950/40 border-rose-800 text-xs text-rose-200 flex items-start gap-3';
        }
        if (complianceTitle) {
          complianceTitle.textContent = 'CRITICAL HAZARD: RAPID PHASE SEPARATION & HIGH SYNTHETIC SURFACTANT BURDEN';
          complianceTitle.className = 'font-bold block text-sm text-rose-300';
        }
        if (complianceDesc) {
          complianceDesc.textContent = 'Conventional low-shear rotor-stator mills create polydisperse micro-droplets (>2.5 µm) that rapidly cream within days and require 8–10% synthetic polysorbate-80, creating severe intestinal mucosal barrier permeability and chronic inflammation risks.';
        }
        return;
      }

      // Normal Scientific Calculations for MA-HPH
      // 1. Sauter Mean Droplet Diameter d_32 (nm)
      // d_32 = C * (ΔP)^(-0.65) * (1 - Φ_megasonic)
      // Base constant C depends on feedstock viscosity & interfacial tension
      let cConst = 1850.0;
      if (feedstockId === 'curcumin_astaxanthin_lipophilic_nano_carrier') cConst = 1680.0;
      else if (feedstockId === 'high_dha_algal_omega3_nano_emulsion') cConst = 1920.0;
      else if (feedstockId === 'oat_almond_plant_milk_lipid_globules') cConst = 3200.0;
      else if (feedstockId === 'resveratrol_coq10_cellular_nano_carrier') cConst = 1550.0;

      // Nozzle geometry factor
      let nozzleFactor = 1.0;
      if (nozzleId === 'y_type_diamond_megasonic_interaction_chamber') nozzleFactor = 0.88;
      else if (nozzleId === 'z_type_ceramic_acoustic_standing_wave_cell') nozzleFactor = 0.94;
      else if (nozzleId === 'multi_slit_hydrodynamic_shear_piezo_horn') nozzleFactor = 1.08;

      // Megasonic acoustic reduction factor: up to 35% reduction in droplet size
      const acousticReduction = Math.min(0.38, (frequency / 2.5) * 0.22 + (power / 800.0) * 0.16);
      const rawD32 = (cConst * nozzleFactor * Math.pow(pressure, -0.62) * (1.0 - acousticReduction));
      const d32Nm = Math.max(38.0, rawD32).toFixed(1);

      // 2. Polydispersity Index (PDI)
      // Megasonics sharpens droplet size distribution
      const pdiVal = Math.max(0.055, 0.18 - (frequency / 2.5) * 0.06 - (pressure / 250.0) * 0.05).toFixed(3);

      // 3. Acoustic Radiation Force F_rad (pN)
      // F_rad proportional to P_0^2 * V_p * frequency
      const fRadPn = ((power / 400.0) * (frequency / 1.2) * 14.2).toFixed(1);

      // 4. Surfactant Savings vs conventional 8.0% load
      const baselineSurf = 8.0;
      const savingsPct = Math.min(100.0, Math.max(0.0, ((baselineSurf - surfactant) / baselineSurf) * 100.0)).toFixed(1);

      // 5. Intestinal Bioavailability Multiplier
      // Nano-droplets (<70 nm) achieve 15–25x absorption
      let bioMulti = 12.0;
      if (parseFloat(d32Nm) < 55.0) bioMulti = 23.5;
      else if (parseFloat(d32Nm) < 70.0) bioMulti = 19.2;
      else if (parseFloat(d32Nm) < 100.0) bioMulti = 16.5;
      else bioMulti = 13.8;

      // 6. Physical Shelf-Life (Days until creaming)
      const shelfDays = parseFloat(d32Nm) < 80.0 ? '> 365' : (365 * Math.pow(80.0 / parseFloat(d32Nm), 2)).toFixed(0);

      // 7. Specific Energy Consumption & ASME Safety Factor
      const secKwh = (10.5 + (pressure / 250.0) * 8.5 + (power / 800.0) * 3.2).toFixed(1);
      const asmeFs = (5.8 - (pressure / 250.0) * 1.5).toFixed(1);

      // DOM Updates
      if (dropletSizeMetric) {
        dropletSizeMetric.textContent = d32Nm;
        dropletSizeMetric.className = 'text-2xl font-black font-mono text-indigo-400';
      }
      if (dropletSizeSub) {
        dropletSizeSub.textContent = parseFloat(d32Nm) < 70.0 ? 'Ultra-Fine Sub-70 nm' : 'Sub-Micron Monodisperse';
        dropletSizeSub.className = 'text-[10px] text-emerald-400 font-mono block mt-1';
      }
      if (pdiMetric) {
        pdiMetric.textContent = pdiVal;
        pdiMetric.className = 'text-2xl font-black font-mono text-cyan-400';
      }
      if (pdiSub) {
        pdiSub.textContent = parseFloat(pdiVal) < 0.10 ? 'Monodisperse (<0.10)' : 'Moderate Distribution';
        pdiSub.className = 'text-[10px] text-emerald-400 font-mono block mt-1';
      }
      if (acousticForceMetric) {
        acousticForceMetric.textContent = fRadPn;
        acousticForceMetric.className = 'text-2xl font-black font-mono text-amber-400';
      }
      if (acousticForceSub) {
        acousticForceSub.textContent = 'Anti-Coalescence Trap';
        acousticForceSub.className = 'text-[10px] text-muted font-mono block mt-1';
      }
      if (savingsMetric) {
        savingsMetric.textContent = `${savingsPct}%`;
        savingsMetric.className = 'text-xl font-black font-mono text-emerald-400';
      }
      if (savingsSub) {
        savingsSub.textContent = parseFloat(savingsPct) >= 80.0 ? 'Clean-Label Compliant' : 'Reduced Surfactant';
        savingsSub.className = 'text-[10px] text-muted font-mono block mt-1';
      }
      if (bioavailMetric) {
        bioavailMetric.textContent = `${bioMulti.toFixed(1)}x`;
        bioavailMetric.className = 'text-xl font-black font-mono text-indigo-300';
      }
      if (bioavailSub) {
        bioavailSub.textContent = 'Intestinal Permeation';
        bioavailSub.className = 'text-[10px] text-emerald-400 font-mono block mt-1';
      }
      if (shelflifeMetric) {
        shelflifeMetric.textContent = shelfDays;
        shelflifeMetric.className = 'text-xl font-black font-mono text-emerald-400';
      }
      if (shelflifeSub) {
        shelflifeSub.textContent = 'Zero Gravitational Creaming';
        shelflifeSub.className = 'text-[10px] text-emerald-400 font-mono block mt-1';
      }
      if (secVal) secVal.textContent = `${secKwh} kWh/m³ (35% lower than thermal)`;
      if (asmeVal) asmeVal.textContent = `SF = ${asmeFs} >= 3.5 (10^8 Cycles Safe)`;
      if (statusPill) {
        statusPill.textContent = '3-A / FDA PASS';
        statusPill.className = 'px-2.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-emerald-950 text-emerald-300 border border-emerald-800 font-mono';
      }
      if (complianceBanner) {
        complianceBanner.className = 'p-4 rounded-xl border bg-emerald-950/40 border-emerald-800 text-xs text-emerald-200 flex items-start gap-3';
      }
      if (complianceTitle) {
        complianceTitle.textContent = 'COMPLIANT: 3-A 04-05 & FDA 21 CFR § 117 SANITARY VALIDATION';
        complianceTitle.className = 'font-bold block text-sm text-emerald-300';
      }
      if (complianceDesc) {
        complianceDesc.textContent = `The configured megasonic high-pressure nano-emulsifier generates sub-70 nm monodisperse droplets (d32 = ${d32Nm} nm, PDI = ${pdiVal}) while operating below lipid oxidation thresholds (<28°C discharge), reducing synthetic surfactant requirements by ${savingsPct}% without cavitation erosion risk.`;
      }
    }

    // Attach Event Listeners
    [feedRateSlider, pressureSlider, frequencySlider, powerSlider, surfactantSlider].forEach((slider) => {
      slider.addEventListener('input', calculateMetrics);
    });

    [skidSelect, feedstockSelect, nozzleSelect].forEach((select) => {
      select.addEventListener('change', calculateMetrics);
    });

    // Preset Buttons
    root.querySelectorAll('.preset-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const p = btn.getAttribute('data-preset');
        if (p === 'omega3') {
          skidSelect.value = 'commercial_continuous_ma_hph_skid';
          feedstockSelect.value = 'high_dha_algal_omega3_nano_emulsion';
          nozzleSelect.value = 'y_type_diamond_megasonic_interaction_chamber';
          feedRateSlider.value = '1500';
          pressureSlider.value = '180';
          frequencySlider.value = '1.2';
          powerSlider.value = '450';
          surfactantSlider.value = '1.2';
        } else if (p === 'curcumin') {
          skidSelect.value = 'aseptic_pharma_bioactive_ma_hph_unit';
          feedstockSelect.value = 'curcumin_astaxanthin_lipophilic_nano_carrier';
          nozzleSelect.value = 'y_type_diamond_megasonic_interaction_chamber';
          feedRateSlider.value = '800';
          pressureSlider.value = '220';
          frequencySlider.value = '1.4';
          powerSlider.value = '520';
          surfactantSlider.value = '0.8';
        } else if (p === 'plantmilk') {
          skidSelect.value = 'clean_label_plant_beverage_ma_hph_plant';
          feedstockSelect.value = 'oat_almond_plant_milk_lipid_globules';
          nozzleSelect.value = 'multi_slit_hydrodynamic_shear_piezo_horn';
          feedRateSlider.value = '4000';
          pressureSlider.value = '150';
          frequencySlider.value = '0.9';
          powerSlider.value = '380';
          surfactantSlider.value = '0.0';
        } else if (p === 'coq10') {
          skidSelect.value = 'pilot_analytical_acousto_fluidic_rig';
          feedstockSelect.value = 'resveratrol_coq10_cellular_nano_carrier';
          nozzleSelect.value = 'z_type_ceramic_acoustic_standing_wave_cell';
          feedRateSlider.value = '200';
          pressureSlider.value = '200';
          frequencySlider.value = '1.6';
          powerSlider.value = '600';
          surfactantSlider.value = '0.6';
        } else if (p === 'hazard') {
          skidSelect.value = 'commercial_continuous_ma_hph_skid';
          feedstockSelect.value = 'conventional_coarse_rotor_stator_hazard';
          nozzleSelect.value = 'multi_slit_hydrodynamic_shear_piezo_horn';
          feedRateSlider.value = '1200';
          pressureSlider.value = '50';
          frequencySlider.value = '0.5';
          powerSlider.value = '100';
          surfactantSlider.value = '8.0';
        }
        calculateMetrics();
      });
    });

    // Export Certificate
    if (exportBtn) {
      exportBtn.addEventListener('click', () => {
        const certData = {
          engine: "IsItKitchenSafe Commercial Continuous MA-HPH Modeler",
          version: "2.0-AcoustoFluidic",
          timestamp: new Date().toISOString(),
          skid: skidSelect.value,
          feedstock: feedstockSelect.value,
          nozzle: nozzleSelect.value,
          operatingParameters: {
            feedRateLph: parseFloat(feedRateSlider.value),
            pressureMpa: parseFloat(pressureSlider.value),
            megasonicFrequencyMhz: parseFloat(frequencySlider.value),
            acousticPowerDensityWL: parseFloat(powerSlider.value),
            surfactantConcentrationPct: parseFloat(surfactantSlider.value)
          },
          telemetryMetrics: {
            dropletSizeD32Nm: dropletSizeMetric ? dropletSizeMetric.textContent : "58.4",
            polydispersityIndexPdi: pdiMetric ? pdiMetric.textContent : "0.076",
            acousticForcePn: acousticForceMetric ? acousticForceMetric.textContent : "14.2",
            surfactantSavingsPct: savingsMetric ? savingsMetric.textContent : "85.0%",
            bioavailabilityMultiplier: bioavailMetric ? bioavailMetric.textContent : "19.2x",
            shelfLifeDays: shelflifeMetric ? shelflifeMetric.textContent : ">365",
            asmeFatigueSafetyFactor: asmeVal ? asmeVal.textContent : "SF >= 3.5"
          },
          standardsCompliance: [
            "FDA 21 CFR § 117 (FSMA cGMP)",
            "3-A Sanitary Standards 04-05 & 60-01",
            "ASME BPE-2024 Bioprocessing Equipment",
            "USP <467> / USP <1788>",
            "FSSC 22000 Clean-Label Emulsion Validation"
          ]
        };

        const blob = new Blob([JSON.stringify(certData, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `MA_HPH_Validation_Certificate_${Date.now()}.json`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      });
    }

    calculateMetrics();
  }

  // Initialize on load and on Astro page transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMaHphModeler);
  } else {
    initMaHphModeler();
  }
  document.addEventListener('astro:page-load', initMaHphModeler);
</script>
