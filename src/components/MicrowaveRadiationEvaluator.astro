    copyReportBtn: "📋 复制完整物理诊断报告至剪贴板",
    reportCopied: "✅ 报告已成功复制至剪贴板！",
    crossLinkTitle: "探索 IsItKitchenSafe 更多权威厨电科学工具",
    crossLinkSlowCooker: "慢炖锅陶瓷重金属与芽孢孵化模拟器",
    crossLinkAirFryer: "空气炸锅丙烯酰胺与美拉德反应计算器",
    crossLinkSousVide: "低温慢煮塑料微粒与肉毒杆菌安全模型",
    crossLinkThermalShock: "厨具热冲击防爆裂物理模拟器",
    crossLinkWater: "反渗透净水机重金属滤除效率分析器"
  },
  ja: {
    badge: "高周波電磁波バイオフィジックス＆家電安全研究所",
