    inspectionSub: "専門機器がなくても、ドアの気密性と電波漏洩を判定できる4つの点検手順。",
    step1Title: "1. 紙幣（お札）挟み込みテスト",
    step1Text: "千円札をドアパッキンに挟んでドアを閉め、ゆっくり引き抜きます。抵抗なくスルスル抜ける場合は気密性が失われており、隙間からの漏洩リスクがあります。",
    step2Title: "2. 2.4 GHz Wi-Fi動画ストリーミング試験",
    step2Text: "レンジから1mの位置でスマホの2.4 GHz Wi-Fi動画を再生しながら45秒間加熱します。再生停止や大幅な遅延が起きる場合、電磁波シールドの低下が疑われます。",
    step3Title: "3. チョーク空洞溝の焦げ付き清掃",
    step3Text: "ドア内周の黒い溝（チョーク空洞）に付着した焦げや油汚れを拭き取ります。炭化した油汚れは電気を通し、電波の逆位相相殺を妨げます。",
    step4Title: "4. ファラデーシールドメッシュの確認",
    step4Text: "ガラス面の黒い金属メッシュ（1.5mmの微細穴）に破れ、凹み、剥がれがないかライトで照らして確認します。",
    copyReportBtn: "📋 診断レポートをクリップボードにコピー",
    reportCopied: "✅ レポートをクリップボードにコピーしました！",
    crossLinkTitle: "IsItKitchenSafe の他の科学的キッチン安全ツール",
    crossLinkSlowCooker: "スロークッカー鉛溶出＆耐熱芽胞菌繁殖シミュレーター",
    crossLinkAirFryer: "ノンフライヤーアクリルアミド生成計算機",
    crossLinkSousVide: "低温調理マイクロプラスチック溶出モデル",
    crossLinkThermalShock: "耐熱ガラス・食器熱衝撃破損シミュレーター",
    crossLinkWater: "逆浸透膜（RO）浄水器重金属除去率分析器"
  }
};

const d = DICT[lang] || DICT.en;
---

<div class="bg-surface-soft border border-hairline rounded-3xl p-6 md:p-10 shadow-sm space-y-8" id="microwave-evaluator">
  <!-- Header Badge & Title -->
  <header class="space-y-3">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-violet-600 text-white shadow-xs">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        {d.badge}
      </span>
      <span class="text-xs font-mono text-muted">FDA 21 CFR § 1030.10 &bull; ICNIRP Standards</span>
    </div>

    <h1 class="text-display-sm md:text-display-md font-bold text-ink tracking-tight">
      {d.title}
    </h1>
    <p class="text-xs md:text-sm text-body leading-relaxed max-w-4xl">
      {d.subtitle}
    </p>
  </header>

  <!-- Quick Diagnostic Presets -->
  <div class="bg-surface border border-hairline/80 rounded-2xl p-4 md:p-5 space-y-3">
    <div class="flex items-center justify-between gap-2">
      <span class="text-xs font-bold uppercase tracking-wider text-violet-700 dark:text-violet-400">
        {d.presetsTitle}
      </span>
      <span class="text-[11px] text-muted">One-click auto-configuration</span>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2">
      <button type="button" data-preset="new_microwave" class="preset-btn px-2.5 py-2 rounded-xl border border-hairline hover:border-violet-500 bg-surface-soft hover:bg-violet-50 dark:hover:bg-violet-950/30 text-ink text-xs font-medium text-left transition-all">
        {d.presetNew}
      </button>
      <button type="button" data-preset="typical_family" class="preset-btn px-2.5 py-2 rounded-xl border border-hairline hover:border-violet-500 bg-surface-soft hover:bg-violet-50 dark:hover:bg-violet-950/30 text-ink text-xs font-medium text-left transition-all">
        {d.presetFamily}
      </button>
      <button type="button" data-preset="loose_latch_senior" class="preset-btn px-2.5 py-2 rounded-xl border border-hairline hover:border-violet-500 bg-surface-soft hover:bg-violet-50 dark:hover:bg-violet-950/30 text-ink text-xs font-medium text-left transition-all">
        {d.presetWobbly}
      </button>
      <button type="button" data-preset="face_peeker_kid" class="preset-btn px-2.5 py-2 rounded-xl border border-hairline hover:border-violet-500 bg-surface-soft hover:bg-violet-50 dark:hover:bg-violet-950/30 text-ink text-xs font-medium text-left transition-all">
        {d.presetPeeker}
      </button>
      <button type="button" data-preset="cracked_door_rental" class="preset-btn px-2.5 py-2 rounded-xl border border-hairline hover:border-violet-500 bg-surface-soft hover:bg-violet-50 dark:hover:bg-violet-950/30 text-ink text-xs font-medium text-left transition-all">
        {d.presetRental}
      </button>
      <button type="button" data-preset="vintage_beater" class="preset-btn px-2.5 py-2 rounded-xl border border-hairline hover:border-violet-500 bg-surface-soft hover:bg-violet-50 dark:hover:bg-violet-950/30 text-ink text-xs font-medium text-left transition-all">
        {d.presetVintage}
      </button>
    </div>
  </div>

  <!-- Interactive Controls Section -->
  <div class="bg-surface border border-hairline rounded-2xl p-5 md:p-8 space-y-6">
    <div class="border-b border-hairline pb-4">
      <h2 class="text-title-sm md:text-title-md font-bold text-ink">
        {d.controlsTitle}
      </h2>
      <p class="text-xs text-muted mt-1 leading-relaxed">
        {d.controlsSub}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- 1. Appliance Age & Service Life -->
      <div class="space-y-2">
        <label for="select-age" class="block text-xs font-bold uppercase tracking-wider text-ink">
          {d.ageLabel}
        </label>
        <select id="select-age" class="w-full bg-surface-soft border border-hairline rounded-xl px-3 py-2.5 text-xs text-ink focus:outline-none focus:ring-2 focus:ring-violet-500">
          {radiationData.applianceAges.map(age => (
            <option value={age.id} selected={age.id === 'mature'}>
              {age.label}
            </option>
          ))}
        </select>
        <p id="age-desc" class="text-[11px] text-muted leading-tight">
          Factory-aligned interlocks, supple silicone seal, clean choke.
        </p>
      </div>

      <!-- 2. Door Seal & Hinge State -->
      <div class="space-y-2">
        <label for="select-door" class="block text-xs font-bold uppercase tracking-wider text-ink">
          {d.doorLabel}
        </label>
        <select id="select-door" class="w-full bg-surface-soft border border-hairline rounded-xl px-3 py-2.5 text-xs text-ink focus:outline-none focus:ring-2 focus:ring-violet-500">
          {radiationData.doorConditions.map(dc => (
            <option value={dc.id} selected={dc.id === 'greasy'}>
              {dc.label}
            </option>
          ))}
        </select>
        <p id="door-desc" class="text-[11px] text-muted leading-tight">
          Condensed fat vapors and food film bridge choke channel.
        </p>
      </div>

      <!-- 3. Magnetron Power Rating -->
      <div class="space-y-2">
        <label for="select-power" class="block text-xs font-bold uppercase tracking-wider text-ink">
          {d.powerLabel}
        </label>
        <select id="select-power" class="w-full bg-surface-soft border border-hairline rounded-xl px-3 py-2.5 text-xs text-ink focus:outline-none focus:ring-2 focus:ring-violet-500">
          {radiationData.powerSettings.map(p => (
            <option value={p.id} selected={p.id === 'standard'}>
              {p.label}
            </option>
          ))}
        </select>
        <p class="text-[11px] text-muted leading-tight">
          Output power determines raw RF photon density inside cavity.
        </p>
      </div>
    </div>

    <!-- Sliders: Daily Minutes & Standing Distance -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4 border-t border-hairline">
      <!-- Daily Microwave Time Slider -->
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <label for="slider-time" class="text-xs font-bold uppercase tracking-wider text-ink">
            {d.timeLabel}
          </label>
          <span id="time-val" class="font-mono text-xs font-bold text-violet-600 bg-violet-50 dark:bg-violet-950/40 px-2.5 py-1 rounded-lg border border-violet-200 dark:border-violet-800">
            18 min/day
          </span>
        </div>
        <input 
          type="range" 
          id="slider-time" 
          min="1" 
          max="60" 
          value="18" 
          step="1"
          class="w-full accent-violet-600 cursor-pointer"
        />
        <div class="flex justify-between text-[10px] text-muted font-mono">
          <span>1 min (Light)</span>
          <span>15 min</span>
          <span>30 min</span>
          <span>60 min (Continuous)</span>
        </div>
      </div>

      <!-- Standing Distance Slider -->
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <label for="slider-dist" class="text-xs font-bold uppercase tracking-wider text-ink">
            {d.distLabel}
          </label>
          <span id="dist-val" class="font-mono text-xs font-bold text-violet-600 bg-violet-50 dark:bg-violet-950/40 px-2.5 py-1 rounded-lg border border-violet-200 dark:border-violet-800">
            45 cm (18 in)
          </span>
        </div>
        <input 
          type="range" 
          id="slider-dist" 
          min="5" 
          max="200" 
          value="45" 
          step="5"
          class="w-full accent-violet-600 cursor-pointer"
        />
        <div class="flex justify-between text-[10px] text-muted font-mono">
          <span>5 cm (FDA test / Peeking)</span>
          <span>50 cm (~1.5 ft)</span>
          <span>100 cm (3.3 ft)</span>
          <span>200 cm (6.6 ft)</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Real-Time Diagnostic Report Card -->
  <div class="bg-surface border border-hairline rounded-2xl p-5 md:p-8 space-y-6">
    <div class="border-b border-hairline pb-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
      <div>
        <h2 class="text-title-sm md:text-title-md font-bold text-ink">
          {d.diagnosticTitle}
        </h2>
        <p class="text-xs text-muted mt-1 leading-relaxed">
          {d.diagnosticSub}
        </p>
      </div>
      <button 
        type="button" 
        id="copy-report-btn" 
        class="inline-flex items-center justify-center gap-1.5 px-3 py-1.5 rounded-xl border border-hairline hover:border-violet-500 bg-surface-soft text-xs font-medium text-ink transition-all cursor-pointer whitespace-nowrap self-start sm:self-auto"
      >
        <span id="copy-btn-text">{d.copyReportBtn}</span>
      </button>
    </div>

    <!-- Overall Verdict Badge Banner -->
    <div id="verdict-banner" class="rounded-2xl p-4 md:p-6 border transition-all space-y-2 bg-blue-50/70 border-blue-200 dark:bg-blue-950/30 dark:border-blue-900/50">
      <div class="flex items-center justify-between gap-2">
        <span class="text-[11px] font-bold uppercase tracking-wider text-muted">
          {d.overallStatusLabel}
        </span>
        <span id="badge-code" class="font-mono text-xs font-bold px-2.5 py-0.5 rounded-full bg-white dark:bg-zinc-900 border text-blue-700 dark:text-blue-400">
          TIER B
        </span>
      </div>
      <div id="verdict-title" class="text-sm md:text-base font-bold text-ink leading-snug">
        {d.statusNormal}
      </div>
      <p id="verdict-summary" class="text-xs text-body leading-relaxed">
        Typical for appliances in service for 3 to 8 years. Well below the FDA 5.0 mW/cm² lifetime limit.
      </p>
    </div>

    <!-- Dynamic Warning Alerts (Conditional) -->
    <div id="alert-fda" class="hidden rounded-2xl p-4 md:p-5 bg-rose-50 border border-rose-300 dark:bg-rose-950/40 dark:border-rose-900 space-y-1.5">
      <div class="flex items-center gap-2 text-rose-800 dark:text-rose-300 font-bold text-xs md:text-sm">
        <span>{d.alertExceedsFdaTitle}</span>
      </div>
      <p class="text-xs text-rose-700 dark:text-rose-200 leading-relaxed">
        {d.alertExceedsFdaText}
      </p>
    </div>

    <div id="alert-ocular" class="hidden rounded-2xl p-4 md:p-5 bg-amber-50 border border-amber-300 dark:bg-amber-950/40 dark:border-amber-900 space-y-1.5">
      <div class="flex items-center gap-2 text-amber-800 dark:text-amber-300 font-bold text-xs md:text-sm">
        <span>{d.alertOcularRiskTitle}</span>
      </div>
      <p class="text-xs text-amber-700 dark:text-amber-200 leading-relaxed">
        {d.alertOcularRiskText}
      </p>
    </div>

    <!-- 6 Quantitative Metric Tiles -->
    <div>
      <h3 class="text-xs font-bold uppercase tracking-wider text-muted mb-3">
        {d.metricsTitle}
      </h3>
      <div class="grid grid-cols-2 lg:grid-cols-3 gap-3 md:gap-4">
        <!-- Metric 1: Leakage at 5 cm -->
        <div class="bg-surface-soft border border-hairline rounded-xl p-3.5 space-y-1">
          <span class="text-[11px] text-muted block leading-tight">{d.leakage5cmLabel}</span>
          <div class="flex items-baseline gap-1.5">
            <span id="metric-leakage-5cm" class="text-base md:text-lg font-bold font-mono text-ink">1.30</span>
            <span class="text-[11px] text-muted font-mono">mW/cm²</span>
          </div>
          <span id="sub-leakage-5cm" class="text-[10px] text-muted block">FDA standard distance</span>
        </div>

        <!-- Metric 2: Leakage at Chosen Distance -->
        <div class="bg-surface-soft border border-hairline rounded-xl p-3.5 space-y-1">
          <span class="text-[11px] text-muted block leading-tight">{d.leakageDistLabel}</span>
          <div class="flex items-baseline gap-1.5">
            <span id="metric-leakage-dist" class="text-base md:text-lg font-bold font-mono text-ink">0.016</span>
            <span class="text-[11px] text-muted font-mono">mW/cm²</span>
          </div>
          <span id="sub-leakage-dist" class="text-[10px] text-emerald-600 dark:text-emerald-400 font-medium block">
            98.8% Inverse-Square Falloff
          </span>
        </div>

        <!-- Metric 3: FDA New Unit Limit Ratio -->
        <div class="bg-surface-soft border border-hairline rounded-xl p-3.5 space-y-1">
          <span class="text-[11px] text-muted block leading-tight">{d.fdaNewRatioLabel}</span>
          <div class="flex items-baseline gap-1.5">
            <span id="metric-fda-new" class="text-base md:text-lg font-bold font-mono text-ink">130%</span>
            <span class="text-[11px] text-muted font-mono">of 1.0 mW/cm²</span>
          </div>
          <span id="sub-fda-new" class="text-[10px] text-muted block">Exceeds new, below lifetime</span>
        </div>

        <!-- Metric 4: FDA Lifetime Limit Ratio -->
        <div class="bg-surface-soft border border-hairline rounded-xl p-3.5 space-y-1">
          <span class="text-[11px] text-muted block leading-tight">{d.fdaLifetimeRatioLabel}</span>
          <div class="flex items-baseline gap-1.5">
            <span id="metric-fda-life" class="text-base md:text-lg font-bold font-mono text-ink">26%</span>
            <span class="text-[11px] text-muted font-mono">of 5.0 mW/cm²</span>
          </div>
          <span id="sub-fda-life" class="text-[10px] text-emerald-600 dark:text-emerald-400 font-medium block">
            74% Safety Margin Intact
          </span>
        </div>

        <!-- Metric 5: Gasket Elasticity Loss -->
        <div class="bg-surface-soft border border-hairline rounded-xl p-3.5 space-y-1">
          <span class="text-[11px] text-muted block leading-tight">{d.gasketLossLabel}</span>
          <div class="flex items-baseline gap-1.5">
            <span id="metric-gasket-loss" class="text-base md:text-lg font-bold font-mono text-ink">15%</span>
            <span class="text-[11px] text-muted font-mono">compression set</span>
          </div>
          <span id="sub-gasket-loss" class="text-[10px] text-muted block">Mild polymer hardening</span>
        </div>

        <!-- Metric 6: Choke Attenuation Efficiency -->
        <div class="bg-surface-soft border border-hairline rounded-xl p-3.5 space-y-1">
          <span class="text-[11px] text-muted block leading-tight">{d.chokeEfficiencyLabel}</span>
          <div class="flex items-baseline gap-1.5">
            <span id="metric-choke-eff" class="text-base md:text-lg font-bold font-mono text-ink">92.0%</span>
            <span class="text-[11px] text-muted font-mono">wave cancellation</span>
          </div>
          <span id="sub-choke-eff" class="text-[10px] text-muted block">Quarter-wave phase match</span>
        </div>
      </div>
    </div>

    <!-- 3 Specialized Domain Cards: WiFi Interference, Ocular Safety, Pacemaker Compatibility -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
      <!-- Domain 1: WiFi Interference -->
      <div class="bg-surface-soft border border-hairline rounded-xl p-4 space-y-2">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-violet-500"></span>
          <h4 class="text-xs font-bold uppercase tracking-wider text-ink">{d.wifiStatusTitle}</h4>
        </div>
        <div id="wifi-tier-badge" class="text-xs font-mono font-bold text-violet-700 dark:text-violet-300">
          Minor Interference
        </div>
        <p id="wifi-impact-text" class="text-[11px] text-muted leading-relaxed">
          Mild jitter and 5–15% packet retransmissions on 2.4 GHz channel 6 and 11 within 2 meters.
        </p>
      </div>

      <!-- Domain 2: Ocular Lens / Cataracts -->
      <div class="bg-surface-soft border border-hairline rounded-xl p-4 space-y-2">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
          <h4 class="text-xs font-bold uppercase tracking-wider text-ink">{d.ocularStatusTitle}</h4>
        </div>
        <div id="ocular-tier-badge" class="text-xs font-mono font-bold text-emerald-700 dark:text-emerald-400">
          Negligible Thermal Absorption
        </div>
        <p id="ocular-impact-text" class="text-[11px] text-muted leading-relaxed">
          No measurable thermal rise in cornea or lens tissue at normal viewing distances (> 30 cm).
        </p>
      </div>

      <!-- Domain 3: Medical Implants / Pacemakers -->
      <div class="bg-surface-soft border border-hairline rounded-xl p-4 space-y-2">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-indigo-500"></span>
          <h4 class="text-xs font-bold uppercase tracking-wider text-ink">{d.pacemakerStatusTitle}</h4>
        </div>
        <div id="pacemaker-tier-badge" class="text-xs font-mono font-bold text-indigo-700 dark:text-indigo-300">
          Shielded Compatibility
        </div>
        <p id="pacemaker-impact-text" class="text-[11px] text-muted leading-relaxed">
          Safe. Modern titanium pacemaker casings attenuate far beyond EMI thresholds. Maintain standard 1-foot clearance.
        </p>
      </div>
    </div>
  </div>

  <!-- Physical DIY Inspection Protocol Section -->
  <div class="bg-surface border border-hairline rounded-2xl p-5 md:p-8 space-y-6">
    <div class="border-b border-hairline pb-4">
      <span class="text-xs font-bold uppercase tracking-wider text-violet-700 dark:text-violet-400 block mb-1">
        Laboratory-Tested Diagnostic Protocol
      </span>
      <h3 class="text-title-sm md:text-title-md font-bold text-ink">
        {d.inspectionTitle}
      </h3>
      <p class="text-xs text-muted mt-1 leading-relaxed">
        {d.inspectionSub}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="bg-surface-soft border border-hairline rounded-xl p-4 space-y-2">
        <h4 class="text-xs font-bold text-ink flex items-center gap-2">
          <span class="w-5 h-5 rounded-full bg-violet-600 text-white flex items-center justify-center text-[10px]">1</span>
          {d.step1Title}
        </h4>
        <p class="text-xs text-body leading-relaxed">{d.step1Text}</p>
      </div>

      <div class="bg-surface-soft border border-hairline rounded-xl p-4 space-y-2">
        <h4 class="text-xs font-bold text-ink flex items-center gap-2">
          <span class="w-5 h-5 rounded-full bg-violet-600 text-white flex items-center justify-center text-[10px]">2</span>
          {d.step2Title}
        </h4>
        <p class="text-xs text-body leading-relaxed">{d.step2Text}</p>
      </div>

      <div class="bg-surface-soft border border-hairline rounded-xl p-4 space-y-2">
        <h4 class="text-xs font-bold text-ink flex items-center gap-2">
          <span class="w-5 h-5 rounded-full bg-violet-600 text-white flex items-center justify-center text-[10px]">3</span>
          {d.step3Title}
        </h4>
        <p class="text-xs text-body leading-relaxed">{d.step3Text}</p>
      </div>

      <div class="bg-surface-soft border border-hairline rounded-xl p-4 space-y-2">
        <h4 class="text-xs font-bold text-ink flex items-center gap-2">
          <span class="w-5 h-5 rounded-full bg-violet-600 text-white flex items-center justify-center text-[10px]">4</span>
          {d.step4Title}
        </h4>
        <p class="text-xs text-body leading-relaxed">{d.step4Text}</p>
      </div>
    </div>
  </div>

  <!-- Cross-Links to Complementary Tools -->
  <div class="bg-surface border border-hairline rounded-2xl p-5 md:p-6 space-y-3">
    <span class="text-xs font-bold uppercase tracking-wider text-muted block">
      {d.crossLinkTitle}
    </span>
    <div class="flex flex-wrap gap-2 text-xs">
      <a href={lang === 'en' ? "/tools/slow-cooker-safety-simulator/" : `/${lang}/tools/slow-cooker-safety-simulator/`} class="px-3 py-1.5 rounded-lg border border-hairline bg-surface-soft hover:bg-violet-50 hover:border-violet-400 dark:hover:bg-violet-950/30 text-ink transition-colors">
        🍲 {d.crossLinkSlowCooker}
      </a>
      <a href={lang === 'en' ? "/tools/air-fryer-acrylamide-calculator/" : `/${lang}/tools/air-fryer-acrylamide-calculator/`} class="px-3 py-1.5 rounded-lg border border-hairline bg-surface-soft hover:bg-violet-50 hover:border-violet-400 dark:hover:bg-violet-950/30 text-ink transition-colors">
        🍟 {d.crossLinkAirFryer}
      </a>
      <a href={lang === 'en' ? "/tools/sous-vide-plastic-microbial-modeler/" : `/${lang}/tools/sous-vide-plastic-microbial-modeler/`} class="px-3 py-1.5 rounded-lg border border-hairline bg-surface-soft hover:bg-violet-50 hover:border-violet-400 dark:hover:bg-violet-950/30 text-ink transition-colors">
        🥩 {d.crossLinkSousVide}
      </a>
      <a href={lang === 'en' ? "/tools/thermal-shock-simulator/" : `/${lang}/tools/thermal-shock-simulator/`} class="px-3 py-1.5 rounded-lg border border-hairline bg-surface-soft hover:bg-violet-50 hover:border-violet-400 dark:hover:bg-violet-950/30 text-ink transition-colors">
        💥 {d.crossLinkThermalShock}
      </a>
      <a href={lang === 'en' ? "/tools/water-filter-efficiency-analyzer/" : `/${lang}/tools/water-filter-efficiency-analyzer/`} class="px-3 py-1.5 rounded-lg border border-hairline bg-surface-soft hover:bg-violet-50 hover:border-violet-400 dark:hover:bg-violet-950/30 text-ink transition-colors">
        💧 {d.crossLinkWater}
      </a>
    </div>
  </div>
</div>

<script is:inline define:vars={{ radiationData, currentLang: lang, dictObj: d }}>
  (function() {
    const ageSelect = document.getElementById('select-age');
    const doorSelect = document.getElementById('select-door');
    const powerSelect = document.getElementById('select-power');
    const timeSlider = document.getElementById('slider-time');
    const distSlider = document.getElementById('slider-dist');

    const ageDesc = document.getElementById('age-desc');
    const doorDesc = document.getElementById('door-desc');
    const timeVal = document.getElementById('time-val');
    const distVal = document.getElementById('dist-val');

    const verdictBanner = document.getElementById('verdict-banner');
    const badgeCode = document.getElementById('badge-code');
    const verdictTitle = document.getElementById('verdict-title');
    const verdictSummary = document.getElementById('verdict-summary');

    const alertFda = document.getElementById('alert-fda');
    const alertOcular = document.getElementById('alert-ocular');

    const mLeakage5cm = document.getElementById('metric-leakage-5cm');
    const mLeakageDist = document.getElementById('metric-leakage-dist');
    const subLeakageDist = document.getElementById('sub-leakage-dist');
    const mFdaNew = document.getElementById('metric-fda-new');
    const subFdaNew = document.getElementById('sub-fda-new');
    const mFdaLife = document.getElementById('metric-fda-life');
    const subFdaLife = document.getElementById('sub-fda-life');
    const mGasketLoss = document.getElementById('metric-gasket-loss');
    const subGasketLoss = document.getElementById('sub-gasket-loss');
    const mChokeEff = document.getElementById('metric-choke-eff');
    const subChokeEff = document.getElementById('sub-choke-eff');

    const wifiTierBadge = document.getElementById('wifi-tier-badge');
    const wifiImpactText = document.getElementById('wifi-impact-text');
    const ocularTierBadge = document.getElementById('ocular-tier-badge');
    const ocularImpactText = document.getElementById('ocular-impact-text');
    const pacemakerTierBadge = document.getElementById('pacemaker-tier-badge');
    const pacemakerImpactText = document.getElementById('pacemaker-impact-text');

    const copyBtn = document.getElementById('copy-report-btn');
    const copyBtnText = document.getElementById('copy-btn-text');
    const presetButtons = document.querySelectorAll('.preset-btn');

    function calculate() {
      if (!ageSelect || !doorSelect || !powerSelect || !timeSlider || !distSlider) return;

      const ageId = ageSelect.value;
      const doorId = doorSelect.value;
      const powerId = powerSelect.value;
      const minutes = parseInt(timeSlider.value, 10);
      const distanceCm = parseInt(distSlider.value, 10);

      const ageObj = radiationData.applianceAges.find(a => a.id === ageId) || radiationData.applianceAges[1];
      const doorObj = radiationData.doorConditions.find(d => d.id === doorId) || radiationData.doorConditions[1];
      const powerObj = radiationData.powerSettings.find(p => p.id === powerId) || radiationData.powerSettings[1];

      // Update descriptions
      if (ageDesc) ageDesc.textContent = ageObj.description;
      if (doorDesc) doorDesc.textContent = doorObj.description;
      if (timeVal) timeVal.textContent = minutes + " min/day";
      if (distVal) {
        const inVal = Math.round(distanceCm / 2.54);
        distVal.textContent = distanceCm + " cm (" + inVal + " in)";
      }

      // Physics Calculation:
      // Leakage at 5 cm (standard FDA measurement plane)
      const rawLeakage5cm = (ageObj.baseLeakage_mW_cm2 + doorObj.leakageAdder_mW_cm2) * powerObj.powerMultiplier;
      const leakage5cm = Math.round(rawLeakage5cm * 100) / 100;

      // Leakage at chosen distance using Inverse-Square Law with 5 cm reference plane
      // P(d) = P_5cm * (5 / d)^2 for d >= 5 cm
      let leakageDist = 0;
      if (distanceCm <= 5) {
        leakageDist = leakage5cm;
      } else {
        const ratio = 5.0 / distanceCm;
        leakageDist = leakage5cm * (ratio * ratio);
      }
      leakageDist = Math.round(leakageDist * 1000) / 1000;

      const falloffPct = distanceCm <= 5 ? 0 : Math.round((1 - (leakageDist / (leakage5cm || 0.001))) * 1000) / 10;

      // Metric calculations
      const fdaNewRatio = Math.round((leakage5cm / 1.0) * 100);
      const fdaLifeRatio = Math.round((leakage5cm / 5.0) * 100);

      if (mLeakage5cm) mLeakage5cm.textContent = leakage5cm.toFixed(2);
      if (mLeakageDist) mLeakageDist.textContent = leakageDist.toFixed(3);
      if (subLeakageDist) {
        if (distanceCm <= 5) {
          subLeakageDist.textContent = "Immediate Near-Field (No Falloff)";
          subLeakageDist.className = "text-[10px] text-rose-600 dark:text-rose-400 font-bold block";
        } else {
          subLeakageDist.textContent = falloffPct + "% Inverse-Square Falloff";
          subLeakageDist.className = "text-[10px] text-emerald-600 dark:text-emerald-400 font-medium block";
        }
      }

      if (mFdaNew) mFdaNew.textContent = fdaNewRatio + "%";
      if (subFdaNew) {
        if (fdaNewRatio <= 100) {
          subFdaNew.textContent = "Complies with new factory limit";
          subFdaNew.className = "text-[10px] text-emerald-600 dark:text-emerald-400 font-medium block";
        } else {
          subFdaNew.textContent = "Exceeds new, operational aging";
          subFdaNew.className = "text-[10px] text-amber-600 dark:text-amber-400 font-medium block";
        }
      }

      if (mFdaLife) mFdaLife.textContent = fdaLifeRatio + "%";
      if (subFdaLife) {
        if (fdaLifeRatio <= 100) {
          const margin = 100 - fdaLifeRatio;
          subFdaLife.textContent = margin + "% Safety Margin Intact";
          subFdaLife.className = "text-[10px] text-emerald-600 dark:text-emerald-400 font-medium block";
        } else {
          const excess = fdaLifeRatio - 100;
          subFdaLife.textContent = "EXCEEDS LEGAL LIMIT BY +" + excess + "%";
          subFdaLife.className = "text-[10px] text-rose-600 dark:text-rose-400 font-bold block";
        }
      }

      if (mGasketLoss) mGasketLoss.textContent = ageObj.gasketElasticityLossPct + "%";
      if (subGasketLoss) {
        if (ageObj.gasketElasticityLossPct < 20) subGasketLoss.textContent = "Optimal seal resilience";
        else if (ageObj.gasketElasticityLossPct < 50) subGasketLoss.textContent = "Moderate compression set";
        else subGasketLoss.textContent = "Severe polymer embrittlement";
      }

      if (mChokeEff) mChokeEff.textContent = doorObj.chokeEfficiencyPct + "%";
      if (subChokeEff) {
        if (doorObj.chokeEfficiencyPct >= 95) subChokeEff.textContent = "Optimal wave cancellation";
        else if (doorObj.chokeEfficiencyPct >= 80) subChokeEff.textContent = "Impedance detuned by residue";
        else subChokeEff.textContent = "Severe RF phase mismatch";
      }

      // Determine Biological / Regulatory Tier
      let matchedTier = radiationData.biologicalTiers[0];
      for (let i = 0; i < radiationData.biologicalTiers.length; i++) {
        if (leakage5cm <= radiationData.biologicalTiers[i].maxLeakage_mW_cm2) {
          matchedTier = radiationData.biologicalTiers[i];
          break;
        }
      }

      // Update Verdict Banner
      if (badgeCode) badgeCode.textContent = "TIER " + matchedTier.grade;
      if (verdictTitle) {
        if (matchedTier.grade === 'EXCELLENT') verdictTitle.textContent = dictObj.statusExcellent;
        else if (matchedTier.grade === 'NORMAL') verdictTitle.textContent = dictObj.statusNormal;
        else if (matchedTier.grade === 'BORDERLINE') verdictTitle.textContent = dictObj.statusBorderline;
        else if (matchedTier.grade === 'HAZARDOUS') verdictTitle.textContent = dictObj.statusHazardous;
        else verdictTitle.textContent = dictObj.statusCritical;
      }
      if (verdictSummary) verdictSummary.textContent = matchedTier.summary;

      // Banner color theme
      if (verdictBanner) {
        verdictBanner.className = "rounded-2xl p-4 md:p-6 border transition-all space-y-2 ";
        if (matchedTier.color === 'emerald') {
          verdictBanner.className += "bg-emerald-50/70 border-emerald-200 dark:bg-emerald-950/30 dark:border-emerald-900/50";
        } else if (matchedTier.color === 'blue') {
          verdictBanner.className += "bg-blue-50/70 border-blue-200 dark:bg-blue-950/30 dark:border-blue-900/50";
        } else if (matchedTier.color === 'amber') {
          verdictBanner.className += "bg-amber-50/70 border-amber-200 dark:bg-amber-950/30 dark:border-amber-900/50";
        } else if (matchedTier.color === 'rose') {
          verdictBanner.className += "bg-rose-50/80 border-rose-300 dark:bg-rose-950/40 dark:border-rose-900/60";
        } else {
          verdictBanner.className += "bg-red-100/90 border-red-400 dark:bg-red-950/60 dark:border-red-800";
        }
      }

      // Conditional Alerts
      if (alertFda) {
        if (leakage5cm > 5.0) alertFda.classList.remove('hidden');
        else alertFda.classList.add('hidden');
      }

      if (alertOcular) {
        if (distanceCm < 15 && leakage5cm >= 3.0) alertOcular.classList.remove('hidden');
        else alertOcular.classList.add('hidden');
      }

      // WiFi Interference Tier
      let wifiTier = radiationData.wifiInterferenceTiers[0];
      for (let i = 0; i < radiationData.wifiInterferenceTiers.length; i++) {
        if (leakage5cm <= radiationData.wifiInterferenceTiers[i].leakageThreshold_mW_cm2) {
          wifiTier = radiationData.wifiInterferenceTiers[i];
          break;
        }
      }
      if (leakage5cm > radiationData.wifiInterferenceTiers[radiationData.wifiInterferenceTiers.length - 1].leakageThreshold_mW_cm2) {
        wifiTier = radiationData.wifiInterferenceTiers[radiationData.wifiInterferenceTiers.length - 1];
      }

      if (wifiTierBadge) wifiTierBadge.textContent = wifiTier.tier;
      if (wifiImpactText) wifiImpactText.textContent = wifiTier.wifiImpact + " " + wifiTier.bluetoothImpact;

      // Ocular & Pacemaker texts
      if (ocularTierBadge) {
        if (distanceCm <= 10 && leakage5cm >= 3.0) {
          ocularTierBadge.textContent = "Elevated Lens Thermal Load";
          ocularTierBadge.className = "text-xs font-mono font-bold text-rose-700 dark:text-rose-400";
        } else if (distanceCm <= 20) {
          ocularTierBadge.textContent = "Cautionary Proximity";
          ocularTierBadge.className = "text-xs font-mono font-bold text-amber-700 dark:text-amber-400";
        } else {
          ocularTierBadge.textContent = "Negligible Thermal Absorption";
          ocularTierBadge.className = "text-xs font-mono font-bold text-emerald-700 dark:text-emerald-400";
        }
      }
      if (ocularImpactText) ocularImpactText.textContent = matchedTier.ocularRisk;
      if (pacemakerImpactText) pacemakerImpactText.textContent = matchedTier.pacemakerSafety;
    }

    // Attach listeners
    if (ageSelect) ageSelect.addEventListener('change', calculate);
    if (doorSelect) doorSelect.addEventListener('change', calculate);
    if (powerSelect) powerSelect.addEventListener('change', calculate);
    if (timeSlider) timeSlider.addEventListener('input', calculate);
    if (distSlider) distSlider.addEventListener('input', calculate);

    // Presets
    presetButtons.forEach(btn => {
      btn.addEventListener('click', function() {
        const pId = this.getAttribute('data-preset');
        const p = radiationData.presets.find(item => item.id === pId);
        if (p) {
          if (ageSelect) ageSelect.value = p.ageId;
          if (doorSelect) doorSelect.value = p.doorId;
          if (powerSelect) powerSelect.value = p.powerId;
          if (timeSlider) timeSlider.value = p.dailyMinutes;
          if (distSlider) distSlider.value = p.viewingDistance_cm;
          calculate();
        }
      });
    });

    // Copy Report
    if (copyBtn) {
      copyBtn.addEventListener('click', function() {
        const ageText = ageSelect ? ageSelect.options[ageSelect.selectedIndex].text : '';
        const doorText = doorSelect ? doorSelect.options[doorSelect.selectedIndex].text : '';
        const powerText = powerSelect ? powerSelect.options[powerSelect.selectedIndex].text : '';
        const minutes = timeSlider ? timeSlider.value : '';
        const dist = distSlider ? distSlider.value : '';
        const leakage5cm = mLeakage5cm ? mLeakage5cm.textContent : '';
        const leakageDist = mLeakageDist ? mLeakageDist.textContent : '';
        const verdict = verdictTitle ? verdictTitle.textContent.trim() : '';

        const report = [
          "===========================================================",
          "ISITKITCHENSAFE: MICROWAVE RADIATION LEAKAGE DIAGNOSTIC REPORT",
          "===========================================================",
          "Date: " + new Date().toISOString().split('T')[0],
          "Standards Benchmark: FDA 21 CFR § 1030.10 (5.0 mW/cm² at 5 cm)",
          "",
          "--- APPLIANCE PARAMETERS ---",
          "- Appliance Age: " + ageText,
          "- Door / Gasket State: " + doorText,
          "- Magnetron Wattage: " + powerText,
          "- Daily Usage: " + minutes + " min/day",
          "- User Standing Distance: " + dist + " cm (" + Math.round(parseInt(dist||'0')/2.54) + " in)",
          "",
          "--- RADIATION EVALUATION ---",
          "- Leakage at 5 cm: " + leakage5cm + " mW/cm²",
          "- Exposure at " + dist + " cm: " + leakageDist + " mW/cm²",
          "- Verdict: " + verdict,
          "",
          "--- DIY ZERO-COST PHYSICAL AUDIT ---",
          "1. Dollar-Bill Gasket Test: Close door on a dollar bill; if it pulls free with no drag, seal compression has failed.",
          "2. 2.4 GHz WiFi Audit: Stream 2.4 GHz video 3 ft from running microwave; heavy stutter confirms RF leakage.",
          "3. Choke Cavity: Clean carbonized grease off perimeter door groove to maintain 180° wave cancellation.",
          "4. Faraday Mesh: Inspect viewing window perforated metal (1.5 mm holes) for tears or dents.",
          "",
          "Report generated at: https://isitkitchensafe.com/tools/microwave-radiation-leakage-evaluator/",
          "==========================================================="
        ].join('\n');

        navigator.clipboard.writeText(report).then(function() {
          if (copyBtnText) copyBtnText.textContent = dictObj.reportCopied;
          setTimeout(function() {
            if (copyBtnText) copyBtnText.textContent = dictObj.copyReportBtn;
          }, 2500);
        }).catch(function() {
          alert("Report ready:\n\n" + report);
        });
      });
    }

    // Initial calculation
    calculate();
  })();
</script>
