    matrixHelp: "エンドウ豆分離タンパク質（7S/11S）、脱脂大豆グリシニン、ビール粕食物繊維、バリスタ用燕麦残渣、濃縮乳タンパク質を選択。",
    cavLabel: "キャビテーション発生器幾何構造＆ローター構成：",
    cavHelp: "放射状穿孔ローターステーター円筒、マルチホールベンチュリオリフィス板、対向差動二重ローター、低剪断撹拌翼（危険対照）を選択。",
    enzymeLabel: "酵素製剤処方＆生体触媒複合体：",
    enzymeHelp: "Alcalase 2.4L エンドプロテアーゼ、Flavourzyme 1000L 脱苦味複合酵素、パパイン-ブロメラインカクテル、熱失活酵素（故障対照）を選択。",
    rpmLabel: "ローター周速 / 先端回転数 (RPM)：",
    rpmHelp: "キャビテーション円筒の回転速度（1,000〜12,000 RPM）。微小キャビティ発生頻度と音響衝撃波強度を支配します。",
    pressureLabel: "キャビテーション上流圧力 (P_cav)：",
    pressureHelp: "キャビテーション発生器両端の作動圧力差（5.0〜28.0 bar）。気泡核生成と激しい崩壊現象を制御します。",
    tempLabel: "バイオ触媒ループ液温 (T_bulk)：",
    tempHelp: "消化ループ内の液温（25.0〜68.0 °C）。酵素の熱失活閾値以下（T < 62°C）に維持する必要があります。",
    esRatioLabel: "酵素/基質重量比 (E/S wt%)：",
    esRatioHelp: "乾燥基質タンパク質に対する酵素添加割合（0.20〜5.00 wt%）。初期のミカエリス・メンテン反応速度を決定します。",
    residenceLabel: "連続加水分解総滞留時間 (t_res)：",
    residenceHelp: "キャビテーション領域およびサニタリー管型消化ループの通過時間（5.0〜90.0分）。",
    flowLabel: "連続スラリー供給流量 (Q_slurry)：",
    flowHelp: "連続処理スキッドの処理流量能力（300〜6,000 L/h）。",
    presetsTitle: "産業用バイオプロセス標準プリセット：",
    presetPea: "エンドウ豆タンパク質高可溶化＆青臭み分子脱離 (DH 16.5%)",
    presetSoy: "脱脂大豆低アレルゲン完全脱苦味ペプチド合成 (DH 19.2%)",
    presetGrain: "ビール醸造粕リグノセルロース加水分解＆プレバイオティクス抽出 (DH 22.0%)",
    presetOat: "バリスタ用オーツミルク微細泡安定化タンパク質改質 (DH 14.5%)",
    presetHazard: "従来型低剪断拡散律速＆苦味ペプチド過剰蓄積危険工況",
    diagnosticTitle: "リアルタイム HC-AEH テレメトリ＆生体触媒速度論",
    diagnosticSub: "加水分解度 (DH%)、触媒速度加速倍数、活性酵素残存率、窒素溶解指数 (NSI)、苦味疎水性指数、比エネルギー消費率を予測。",
    dhLabel: "加水分解度 (DH%)：",
    rateAccelLabel: "生体触媒反応加速因子：",
    enzymeActiveLabel: "活性酵素分子残存率：",
    solubilityLabel: "窒素溶解指数 (NSI / タンパク質溶解度 %)：",
    bitternessLabel: "疎水性苦味ペプチド指数：",
    energyLabel: "比キャビテーションエネルギー消費 (SEC)：",
    throughputLabel: "連続正味製品生産能力：",
    statusLabel: "サニタリーバイオプロセス適合状態：",
    diagramTitle: "連続流体力学的キャビテーションリアクター＆管型バイオ触媒ループ構造図",
    diagramSub: "スラリー調合タンク、高剪断ローターステーター発生器、音響崩壊帯、インライン酵素注入部、管型反応器、フラッシュ冷却脱気部。",
    scienceTitle: "HC-AEH の科学的基礎＆生物物理機構",
    scienceSub: "流体力学的キャビテーション力学、レイリー・プレセット気泡動力学、タンパク質立体構造開裂、ミカエリス・メンテン促進、Adler-Nissen DH 動力学の徹底解析。",
    tableTitle: "商用システム工学仕様＆バイオ触媒プロセス基準表"
  }
};

const d = DICT[lang];
---

<div class="bg-surface border border-hairline rounded-3xl p-6 sm:p-8 lg:p-10 shadow-sm transition-all" id="hc-aeh-modeler-container">
  <!-- Header Badge & Title -->
  <div class="mb-8">
    <div class="flex flex-wrap items-center gap-2 mb-3">
      <span class="inline-block px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-950 text-emerald-200 border border-emerald-800">
        {d.badge}
      </span>
      <span class="text-xs text-muted font-mono">HC-AEH &bull; 30–60 kHz &bull; 10–25 bar &bull; ASME Sec VIII &bull; 3-A 04-05 &bull; FDA 21 CFR § 117</span>
    </div>
    <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-ink tracking-tight">
      {d.title}
    </h1>
    <p class="text-sm sm:text-base text-body mt-3 leading-relaxed max-w-4xl">
      {d.subtitle}
    </p>
  </div>

  <!-- Presets Bar -->
  <div class="mb-8 bg-surface-soft border border-hairline rounded-2xl p-4 sm:p-5">
    <div class="text-xs font-bold text-ink uppercase tracking-wider mb-3 flex items-center gap-1.5">
      <span class="inline-block w-2 h-2 rounded-full bg-emerald-500"></span>
      {d.presetsTitle}
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-2.5">
      <button 
        type="button" 
        class="hc-preset-btn text-left px-3.5 py-2.5 rounded-xl border border-hairline/80 bg-surface hover:bg-emerald-50 hover:border-emerald-300 text-xs font-medium text-ink transition-all shadow-2xs"
        data-preset="pea"
      >
        🌱 {d.presetPea}
      </button>
      <button 
        type="button" 
        class="hc-preset-btn text-left px-3.5 py-2.5 rounded-xl border border-hairline/80 bg-surface hover:bg-emerald-50 hover:border-emerald-300 text-xs font-medium text-ink transition-all shadow-2xs"
        data-preset="soy"
      >
        🌾 {d.presetSoy}
      </button>
      <button 
        type="button" 
        class="hc-preset-btn text-left px-3.5 py-2.5 rounded-xl border border-hairline/80 bg-surface hover:bg-emerald-50 hover:border-emerald-300 text-xs font-medium text-ink transition-all shadow-2xs"
        data-preset="grain"
      >
        🍺 {d.presetGrain}
      </button>
      <button 
        type="button" 
        class="hc-preset-btn text-left px-3.5 py-2.5 rounded-xl border border-hairline/80 bg-surface hover:bg-emerald-50 hover:border-emerald-300 text-xs font-medium text-ink transition-all shadow-2xs"
        data-preset="oat"
      >
        🥛 {d.presetOat}
      </button>
      <button 
        type="button" 
        class="hc-preset-btn text-left px-3.5 py-2.5 rounded-xl border border-rose-200 bg-rose-50/50 hover:bg-rose-100 hover:border-rose-400 text-xs font-medium text-rose-900 transition-all shadow-2xs"
        data-preset="hazard"
      >
        ⚠️ {d.presetHazard}
      </button>
    </div>
  </div>

  <!-- Main Grid: Controls + Live Diagnostics -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-10">
    <!-- Controls Column (7 cols) -->
    <div class="lg:col-span-7 space-y-6">
      <div class="border border-hairline rounded-2xl p-5 sm:p-6 bg-surface-soft">
        <h2 class="text-base sm:text-lg font-bold text-ink mb-1">
          {d.controlsTitle}
        </h2>
        <p class="text-xs text-muted mb-6">
          {d.controlsSub}
        </p>

        <div class="space-y-5 text-sm">
          <!-- 1. System Architecture -->
          <div>
            <label for="hc-system" class="block font-medium text-ink mb-1">
              {d.systemLabel}
            </label>
            <select 
              id="hc-system" 
              class="w-full bg-surface border border-hairline rounded-xl px-3.5 py-2.5 text-sm text-ink font-medium focus:ring-2 focus:ring-emerald-500 focus:outline-none"
            >
              {hcData.systemArchitectures.map((sys) => (
                <option value={sys.id}>{sys.name}</option>
              ))}
            </select>
            <p class="text-xs text-muted mt-1">{d.systemHelp}</p>
          </div>

          <!-- 2. Target Matrix -->
          <div>
            <label for="hc-matrix" class="block font-medium text-ink mb-1">
              {d.matrixLabel}
            </label>
            <select 
              id="hc-matrix" 
              class="w-full bg-surface border border-hairline rounded-xl px-3.5 py-2.5 text-sm text-ink font-medium focus:ring-2 focus:ring-emerald-500 focus:outline-none"
            >
              {hcData.targetMatrices.map((mat) => (
                <option value={mat.id}>{mat.name}</option>
              ))}
            </select>
            <p class="text-xs text-muted mt-1">{d.matrixHelp}</p>
          </div>

          <!-- 3. Cavitation Generator Configuration -->
          <div>
            <label for="hc-generator" class="block font-medium text-ink mb-1">
              {d.cavLabel}
            </label>
            <select 
              id="hc-generator" 
              class="w-full bg-surface border border-hairline rounded-xl px-3.5 py-2.5 text-sm text-ink font-medium focus:ring-2 focus:ring-emerald-500 focus:outline-none"
            >
              {hcData.cavitationGenerators.map((gen) => (
                <option value={gen.id}>{gen.name}</option>
              ))}
            </select>
            <p class="text-xs text-muted mt-1">{d.cavHelp}</p>
          </div>

          <!-- 4. Enzyme Formulation -->
          <div>
            <label for="hc-enzyme" class="block font-medium text-ink mb-1">
              {d.enzymeLabel}
            </label>
            <select 
              id="hc-enzyme" 
              class="w-full bg-surface border border-hairline rounded-xl px-3.5 py-2.5 text-sm text-ink font-medium focus:ring-2 focus:ring-emerald-500 focus:outline-none"
            >
              {hcData.enzymeFormulations.map((enz) => (
                <option value={enz.id}>{enz.name}</option>
              ))}
            </select>
            <p class="text-xs text-muted mt-1">{d.enzymeHelp}</p>
          </div>

          <!-- Slider 1: Rotor Speed RPM -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label for="hc-rpm" class="font-medium text-ink text-xs sm:text-sm">
                {d.rpmLabel}
              </label>
              <span class="font-mono text-emerald-800 font-bold text-sm" id="hc-rpm-val">4,800 RPM</span>
            </div>
            <input 
              type="range" 
              id="hc-rpm" 
              min="1000" 
              max="12000" 
              step="200" 
              value="4800" 
              class="w-full accent-emerald-600 cursor-pointer"
            />
            <p class="text-xs text-muted mt-1">{d.rpmHelp}</p>
          </div>

          <!-- Slider 2: Cavitation Operating Pressure -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label for="hc-pressure" class="font-medium text-ink text-xs sm:text-sm">
                {d.pressureLabel}
              </label>
              <span class="font-mono text-emerald-800 font-bold text-sm" id="hc-pressure-val">16.0 bar</span>
            </div>
            <input 
              type="range" 
              id="hc-pressure" 
              min="5.0" 
              max="28.0" 
              step="0.5" 
              value="16.0" 
              class="w-full accent-emerald-600 cursor-pointer"
            />
            <p class="text-xs text-muted mt-1">{d.pressureHelp}</p>
          </div>

          <!-- Slider 3: Reaction Bulk Temperature -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label for="hc-temp" class="font-medium text-ink text-xs sm:text-sm">
                {d.tempLabel}
              </label>
              <span class="font-mono text-emerald-800 font-bold text-sm" id="hc-temp-val">50.0 °C</span>
            </div>
            <input 
              type="range" 
              id="hc-temp" 
              min="25.0" 
              max="68.0" 
              step="0.5" 
              value="50.0" 
              class="w-full accent-emerald-600 cursor-pointer"
            />
            <p class="text-xs text-muted mt-1">{d.tempHelp}</p>
          </div>

          <!-- Slider 4: Enzyme-to-Substrate Ratio -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label for="hc-es-ratio" class="font-medium text-ink text-xs sm:text-sm">
                {d.esRatioLabel}
              </label>
              <span class="font-mono text-emerald-800 font-bold text-sm" id="hc-es-ratio-val">1.50 wt%</span>
            </div>
            <input 
              type="range" 
              id="hc-es-ratio" 
              min="0.20" 
              max="5.00" 
              step="0.05" 
              value="1.50" 
              class="w-full accent-emerald-600 cursor-pointer"
            />
            <p class="text-xs text-muted mt-1">{d.esRatioHelp}</p>
          </div>

          <!-- Slider 5: Continuous Residence Time -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label for="hc-residence" class="font-medium text-ink text-xs sm:text-sm">
                {d.residenceLabel}
              </label>
              <span class="font-mono text-emerald-800 font-bold text-sm" id="hc-residence-val">25.0 min</span>
            </div>
            <input 
              type="range" 
              id="hc-residence" 
              min="5.0" 
              max="90.0" 
              step="1.0" 
              value="25.0" 
              class="w-full accent-emerald-600 cursor-pointer"
            />
            <p class="text-xs text-muted mt-1">{d.residenceHelp}</p>
          </div>

          <!-- Slider 6: Slurry Processing Throughput -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label for="hc-flow" class="font-medium text-ink text-xs sm:text-sm">
                {d.flowLabel}
              </label>
              <span class="font-mono text-emerald-800 font-bold text-sm" id="hc-flow-val">3,200 L/h</span>
            </div>
            <input 
              type="range" 
              id="hc-flow" 
              min="300" 
              max="6000" 
              step="100" 
              value="3200" 
              class="w-full accent-emerald-600 cursor-pointer"
            />
            <p class="text-xs text-muted mt-1">{d.flowHelp}</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Live Telemetry & Diagnostics Column (5 cols) -->
    <div class="lg:col-span-5 space-y-6">
      <div class="border border-hairline rounded-2xl p-5 sm:p-6 bg-surface-soft sticky top-6">
        <h2 class="text-base sm:text-lg font-bold text-ink mb-1">
          {d.diagnosticTitle}
        </h2>
        <p class="text-xs text-muted mb-6">
          {d.diagnosticSub}
        </p>

        <!-- Dynamic Status Banner -->
        <div id="hc-status-banner" class="mb-5 p-4 rounded-xl border border-emerald-300 bg-emerald-50 text-emerald-900 transition-all">
          <div class="flex items-center gap-2">
            <span class="text-xl" id="hc-status-icon">✅</span>
            <div class="font-bold text-sm" id="hc-status-title">Optimal Biocatalysis &amp; Sanitary Cavitation</div>
          </div>
          <div class="text-xs mt-1 leading-relaxed opacity-90" id="hc-status-desc">
            Rotor-stator cavitation efficiently unfolds protein globules; enzyme remains fully active with zero thermal denaturation.
          </div>
        </div>

        <div class="space-y-4">
          <!-- Metric 1: Degree of Hydrolysis (DH%) -->
          <div class="p-3.5 bg-surface border border-hairline rounded-xl">
            <div class="flex justify-between items-center">
              <span class="text-xs text-muted font-medium">{d.dhLabel}</span>
              <span class="font-mono font-extrabold text-base text-emerald-800" id="hc-out-dh">16.8%</span>
            </div>
            <div class="w-full bg-hairline rounded-full h-1.5 mt-2 overflow-hidden">
              <div class="bg-emerald-600 h-1.5 rounded-full transition-all duration-300" id="hc-bar-dh" style="width: 75%;"></div>
            </div>
          </div>

          <!-- Metric 2: Rate Acceleration Factor -->
          <div class="p-3.5 bg-surface border border-hairline rounded-xl">
            <div class="flex justify-between items-center">
              <span class="text-xs text-muted font-medium">{d.rateAccelLabel}</span>
              <span class="font-mono font-bold text-sm text-ink" id="hc-out-accel">3.85x faster</span>
            </div>
          </div>

          <!-- Metric 3: Active Enzyme Retention -->
          <div class="p-3.5 bg-surface border border-hairline rounded-xl">
            <div class="flex justify-between items-center">
              <span class="text-xs text-muted font-medium">{d.enzymeActiveLabel}</span>
              <span class="font-mono font-bold text-sm text-emerald-800" id="hc-out-enzyme">98.4%</span>
            </div>
          </div>

          <!-- Metric 4: Nitrogen Solubility Index (NSI) -->
          <div class="p-3.5 bg-surface border border-hairline rounded-xl">
            <div class="flex justify-between items-center">
              <span class="text-xs text-muted font-medium">{d.solubilityLabel}</span>
              <span class="font-mono font-bold text-sm text-ink" id="hc-out-nsi">96.8% (pH 4.5–7.0)</span>
            </div>
          </div>

          <!-- Metric 5: Bitterness Score -->
          <div class="p-3.5 bg-surface border border-hairline rounded-xl">
            <div class="flex justify-between items-center">
              <span class="text-xs text-muted font-medium">{d.bitternessLabel}</span>
              <span class="font-mono font-bold text-sm text-emerald-800" id="hc-out-bitter">1.4 / 10 (Neutral)</span>
            </div>
          </div>

          <!-- Metric 6: Specific Cavitation Energy Consumption (SEC) -->
          <div class="p-3.5 bg-surface border border-hairline rounded-xl">
            <div class="flex justify-between items-center">
              <span class="text-xs text-muted font-medium">{d.energyLabel}</span>
              <span class="font-mono font-bold text-sm text-ink" id="hc-out-sec">2.35 kWh/m³</span>
            </div>
          </div>

          <!-- Metric 7: Continuous Output Throughput -->
          <div class="p-3.5 bg-surface border border-hairline rounded-xl">
            <div class="flex justify-between items-center">
              <span class="text-xs text-muted font-medium">{d.throughputLabel}</span>
              <span class="font-mono font-bold text-sm text-ink" id="hc-out-throughput">3,200 L/h (480 kg/h dry)</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Interactive SVG Process Flow Architecture Diagram -->
  <div class="mb-12 border border-hairline rounded-2xl p-6 sm:p-8 bg-surface-soft">
    <div class="mb-6">
      <h2 class="text-lg sm:text-xl font-bold text-ink">
        {d.diagramTitle}
      </h2>
      <p class="text-xs sm:text-sm text-muted mt-1">
        {d.diagramSub}
      </p>
    </div>

    <div class="w-full overflow-x-auto bg-surface rounded-xl p-4 border border-hairline">
      <svg viewBox="0 0 920 340" class="w-full min-w-[750px] h-auto select-none" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="hcCavGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#059669" stop-opacity="0.9" />
            <stop offset="50%" stop-color="#10b981" stop-opacity="0.8" />
            <stop offset="100%" stop-color="#34d399" stop-opacity="0.9" />
          </linearGradient>
          <linearGradient id="hcPipeGrad" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#94a3b8" />
            <stop offset="50%" stop-color="#cbd5e1" />
            <stop offset="100%" stop-color="#64748b" />
          </linearGradient>
          <filter id="hcGlow" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur stdDeviation="3" result="blur" />
            <feComposite in="SourceGraphic" in2="blur" operator="over" />
          </filter>
        </defs>

        <!-- Background grid lines -->
        <g stroke="#f1f5f9" stroke-width="1">
          <line x1="0" y1="60" x2="920" y2="60" />
          <line x1="0" y1="120" x2="920" y2="120" />
          <line x1="0" y1="180" x2="920" y2="180" />
          <line x1="0" y1="240" x2="920" y2="240" />
          <line x1="0" y1="300" x2="920" y2="300" />
        </g>

        <!-- 1. Continuous Slurry Feed Tank -->
        <g id="svg-feed-tank" transform="translate(40, 60)">
          <rect x="0" y="30" width="100" height="150" rx="14" fill="#f8fafc" stroke="#475569" stroke-width="2.5" />
          <!-- Liquid level -->
          <rect x="4" y="80" width="92" height="96" rx="8" fill="#a7f3d0" fill-opacity="0.55" />
          <!-- Impeller agitator shaft -->
          <line x1="50" y1="10" x2="50" y2="150" stroke="#334155" stroke-width="3" />
          <line x1="30" y1="140" x2="70" y2="140" stroke="#334155" stroke-width="3" />
          <line x1="30" y1="105" x2="70" y2="105" stroke="#334155" stroke-width="2.5" />
          <!-- Motor -->
          <rect x="36" y="0" width="28" height="24" rx="4" fill="#0f172a" />
          <text x="50" y="200" text-anchor="middle" font-size="11" font-weight="700" fill="#1e293b">1. Slurry Feed Tank</text>
          <text x="50" y="215" text-anchor="middle" font-size="9" fill="#64748b">15–20% Dry Solids</text>
        </g>

        <!-- Feed Pump & Pipe to Cavitator -->
        <path d="M 140 160 L 210 160" fill="none" stroke="url(#hcPipeGrad)" stroke-width="8" stroke-linecap="round" />
        <!-- Positive Displacement Booster Pump -->
        <circle cx="210" cy="160" r="18" fill="#1e293b" stroke="#334155" stroke-width="2" />
        <polygon points="204,152 220,160 204,168" fill="#10b981" />
        <path d="M 228 160 L 280 160" fill="none" stroke="url(#hcPipeGrad)" stroke-width="8" stroke-linecap="round" />

        <!-- 2. High-Shear Rotor-Stator Hydrodynamic Cavitation Reactor -->
