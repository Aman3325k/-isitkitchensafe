<script>
  function initHcAehModeler() {
    const sysSelect = document.getElementById('hc-system') as HTMLSelectElement | null;
    const matSelect = document.getElementById('hc-matrix') as HTMLSelectElement | null;
    const genSelect = document.getElementById('hc-generator') as HTMLSelectElement | null;
    const enzSelect = document.getElementById('hc-enzyme') as HTMLSelectElement | null;

    const rpmInput = document.getElementById('hc-rpm') as HTMLInputElement | null;
    const presInput = document.getElementById('hc-pressure') as HTMLInputElement | null;
    const tempInput = document.getElementById('hc-temp') as HTMLInputElement | null;
    const esInput = document.getElementById('hc-es-ratio') as HTMLInputElement | null;
    const resInput = document.getElementById('hc-residence') as HTMLInputElement | null;
    const flowInput = document.getElementById('hc-flow') as HTMLInputElement | null;

    const rpmVal = document.getElementById('hc-rpm-val');
    const presVal = document.getElementById('hc-pressure-val');
    const tempVal = document.getElementById('hc-temp-val');
    const esVal = document.getElementById('hc-es-ratio-val');
    const resVal = document.getElementById('hc-residence-val');
    const flowVal = document.getElementById('hc-flow-val');

    const outDh = document.getElementById('hc-out-dh');
    const barDh = document.getElementById('hc-bar-dh');
    const outAccel = document.getElementById('hc-out-accel');
    const outEnzyme = document.getElementById('hc-out-enzyme');
    const outNsi = document.getElementById('hc-out-nsi');
    const outBitter = document.getElementById('hc-out-bitter');
    const outSec = document.getElementById('hc-out-sec');
    const outThroughput = document.getElementById('hc-out-throughput');

    const statusBanner = document.getElementById('hc-status-banner');
    const statusIcon = document.getElementById('hc-status-icon');
    const statusTitle = document.getElementById('hc-status-title');
    const statusDesc = document.getElementById('hc-status-desc');

    if (!sysSelect || !matSelect || !genSelect || !enzSelect || !rpmInput || !presInput || !tempInput || !esInput || !resInput || !flowInput) {
      return;
    }

    function calculateKinetics() {
      const rpm = parseFloat(rpmInput.value);
      const pressure = parseFloat(presInput.value);
      const temp = parseFloat(tempInput.value);
      const esRatio = parseFloat(esInput.value);
      const residence = parseFloat(resInput.value);
      const flow = parseFloat(flowInput.value);

      const isConventionalHazard = genSelect.value === 'conventional_low_shear_agitator' || enzSelect.value === 'incompatible_low_activity_enzyme';

      // 1. Cavitation Intensity & Unfolding Factor
      let unfoldingFactor = 1.0;
      if (genSelect.value === 'perforated_rotor_stator_generator') {
        unfoldingFactor = 0.95 + (rpm / 12000) * 0.35 + (pressure / 28) * 0.25;
      } else if (genSelect.value === 'counter_rotating_dual_rotor') {
        unfoldingFactor = 1.05 + (rpm / 12000) * 0.45 + (pressure / 28) * 0.30;
      } else if (genSelect.value === 'venturi_multi_hole_orifice_plate') {
        unfoldingFactor = 0.90 + (pressure / 28) * 0.40;
      } else {
        // conventional agitator
        unfoldingFactor = 0.15;
      }

      // 2. Enzyme Thermal Inactivation Curve
      let enzymeRetention = 99.0;
      if (temp > 58.0) {
        const excessT = temp - 58.0;
        enzymeRetention = Math.max(5.0, 99.0 - Math.pow(excessT, 1.85) * 4.2);
      } else if (temp < 40.0) {
        enzymeRetention = 85.0 + (temp - 25.0) * 0.9;
      }

      if (enzSelect.value === 'incompatible_low_activity_enzyme') {
        enzymeRetention = Math.min(enzymeRetention, 12.0);
      }

      // 3. Biocatalytic Rate Acceleration
      let rateAccel = 1.0;
      if (!isConventionalHazard) {
        rateAccel = 1.2 + unfoldingFactor * 2.2 * (enzymeRetention / 100);
      } else {
        rateAccel = 0.85;
      }

      // 4. Degree of Hydrolysis (DH%)
      // Base DH target from matrix
      let baseDh = 16.0;
      if (matSelect.value === 'yellow_pea_protein_isolate') baseDh = 16.5;
      else if (matSelect.value === 'defatted_soy_glycinin_flakes') baseDh = 19.2;
      else if (matSelect.value === 'spent_brewers_grain_fiber') baseDh = 22.0;
      else if (matSelect.value === 'oat_milk_protein_residue') baseDh = 14.5;
      else if (matSelect.value === 'bovine_whey_retentate') baseDh = 12.0;

      // Time and enzyme progression
      const timeSaturation = 1.0 - Math.exp(-residence / (35.0 / Math.max(0.5, rateAccel)));
      const esFactor = Math.pow(esRatio / 1.5, 0.45);
      let calculatedDh = baseDh * timeSaturation * esFactor * (enzymeRetention / 100);

      if (isConventionalHazard) {
        calculatedDh = Math.min(3.8, calculatedDh * 0.2);
      }

      calculatedDh = Math.min(28.0, Math.max(1.5, calculatedDh));

      // 5. Nitrogen Solubility Index (NSI %)
      let nsi = 35.0 + (calculatedDh / baseDh) * 60.0;
      if (isConventionalHazard) nsi = 32.0;
      nsi = Math.min(98.5, Math.max(28.0, nsi));

      // 6. Bitterness Hydrophobic Score (1 to 10 scale)
      let bitterness = 1.2;
      if (enzSelect.value === 'flavourzyme_complex') {
        bitterness = 1.1 + Math.max(0, calculatedDh - 22.0) * 0.15;
      } else if (enzSelect.value === 'alcalase_endoprotease') {
        bitterness = 1.5 + (calculatedDh / 15.0) * 0.6;
      } else if (enzSelect.value === 'papain_bromelain_plant_protease') {
        bitterness = 1.3 + (calculatedDh / 18.0) * 0.5;
      } else {
        bitterness = 8.5; // severe bitterness in failed run
      }

      if (isConventionalHazard) bitterness = 9.2;
      bitterness = Math.min(10.0, Math.max(1.0, bitterness));

      // 7. Specific Cavitation Energy (SEC in kWh/m³)
      let sec = 1.2 + (rpm / 6000) * 0.8 + (pressure / 15) * 0.5;
      if (genSelect.value === 'venturi_multi_hole_orifice_plate') {
        sec = 0.9 + (pressure / 18) * 0.9;
      } else if (isConventionalHazard) {
        sec = 0.45;
      }

      // Update Slider Labels
      if (rpmVal) rpmVal.textContent = `${rpm.toLocaleString()} RPM`;
      if (presVal) presVal.textContent = `${pressure.toFixed(1)} bar`;
      if (tempVal) tempVal.textContent = `${temp.toFixed(1)} °C`;
      if (esVal) esVal.textContent = `${esRatio.toFixed(2)} wt%`;
      if (resVal) resVal.textContent = `${residence.toFixed(0)} min`;
      if (flowVal) flowVal.textContent = `${flow.toLocaleString()} L/h`;

      // Update Diagnostics
      if (outDh) outDh.textContent = `${calculatedDh.toFixed(1)}%`;
      if (barDh) barDh.style.width = `${Math.min(100, (calculatedDh / 25) * 100)}%`;
      if (outAccel) outAccel.textContent = `${rateAccel.toFixed(2)}x faster`;
      if (outEnzyme) outEnzyme.textContent = `${enzymeRetention.toFixed(1)}%`;
      if (outNsi) outNsi.textContent = `${nsi.toFixed(1)}% (Soluble)`;
      if (outBitter) {
        const taste = bitterness < 2.5 ? 'Neutral' : bitterness < 5.0 ? 'Mild' : 'Bitter / Defect';
        outBitter.textContent = `${bitterness.toFixed(1)} / 10 (${taste})`;
      }
      if (outSec) outSec.textContent = `${sec.toFixed(2)} kWh/m³`;
      if (outThroughput) {
        const dryRate = (flow * 0.16).toFixed(0);
        outThroughput.textContent = `${flow.toLocaleString()} L/h (${dryRate} kg/h dry)`;
      }

      // Status Banner Logic
      if (statusBanner && statusIcon && statusTitle && statusDesc) {
        if (isConventionalHazard || enzymeRetention < 35.0 || bitterness > 6.0) {
          statusBanner.className = 'mb-5 p-4 rounded-xl border border-rose-300 bg-rose-50 text-rose-900 transition-all';
          statusIcon.textContent = '🚨';
          statusTitle.textContent = 'Bioprocess Hazard: Stalled Biocatalysis & Bitterness Buildup';
          statusDesc.textContent = 'Insufficient cavitation shear or thermal enzyme denaturation. Globular proteins remain folded; bitter terminal oligopeptides accumulate with unacceptable sediment.';
        } else if (temp > 56.0 || calculatedDh < (baseDh * 0.65)) {
          statusBanner.className = 'mb-5 p-4 rounded-xl border border-amber-300 bg-amber-50 text-amber-900 transition-all';
          statusIcon.textContent = '⚠️';
          statusTitle.textContent = 'Sub-Optimal Operating Window: High Temperature or Under-Hydrolysis';
          statusDesc.textContent = 'Temperature is approaching enzyme denaturation threshold (T > 56°C) or residence time is insufficient for target degree of hydrolysis. Monitor cooling loop.';
        } else {
          statusBanner.className = 'mb-5 p-4 rounded-xl border border-emerald-300 bg-emerald-50 text-emerald-900 transition-all';
          statusIcon.textContent = '✅';
          statusTitle.textContent = 'Optimal Biocatalysis & Sanitary Cavitation';
          statusDesc.textContent = 'Rotor-stator cavitation efficiently unfolds protein globules; enzyme remains fully active with zero thermal denaturation. High nitrogen solubility achieved.';
        }
      }
    }

    // Attach listeners
    [sysSelect, matSelect, genSelect, enzSelect].forEach(el => el.addEventListener('change', calculateKinetics));
    [rpmInput, presInput, tempInput, esInput, resInput, flowInput].forEach(el => el.addEventListener('input', calculateKinetics));

    // Preset handlers
    const presetButtons = document.querySelectorAll('.hc-preset-btn');
    presetButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const preset = btn.getAttribute('data-preset');
        if (preset === 'pea') {
          sysSelect.value = 'commercial_rotor_stator_spr_hydrolysis_skid';
          matSelect.value = 'yellow_pea_protein_isolate';
          genSelect.value = 'perforated_rotor_stator_generator';
          enzSelect.value = 'alcalase_endoprotease';
          rpmInput.value = '4800';
          presInput.value = '16.0';
          tempInput.value = '50.0';
          esInput.value = '1.50';
          resInput.value = '25.0';
          flowInput.value = '3200';
        } else if (preset === 'soy') {
          sysSelect.value = 'dual_stage_enzyme_coupled_cavitation_loop';
          matSelect.value = 'defatted_soy_glycinin_flakes';
          genSelect.value = 'counter_rotating_dual_rotor';
          enzSelect.value = 'flavourzyme_complex';
          rpmInput.value = '6000';
          presInput.value = '20.0';
          tempInput.value = '48.0';
          esInput.value = '2.00';
          resInput.value = '20.0';
          flowInput.value = '2800';
        } else if (preset === 'grain') {
          sysSelect.value = 'sanitary_multi_stage_venturi_cavitation_reactor';
          matSelect.value = 'spent_brewers_grain_fiber';
          genSelect.value = 'venturi_multi_hole_orifice_plate';
          enzSelect.value = 'papain_bromelain_plant_protease';
          rpmInput.value = '1000';
          presInput.value = '18.0';
          tempInput.value = '52.0';
          esInput.value = '2.50';
          resInput.value = '35.0';
          flowInput.value = '3200';
        } else if (preset === 'oat') {
          sysSelect.value = 'commercial_rotor_stator_spr_hydrolysis_skid';
          matSelect.value = 'oat_milk_protein_residue';
          genSelect.value = 'perforated_rotor_stator_generator';
          enzSelect.value = 'alcalase_endoprotease';
          rpmInput.value = '5200';
          presInput.value = '14.0';
          tempInput.value = '48.0';
          esInput.value = '1.20';
          resInput.value = '18.0';
          flowInput.value = '4200';
        } else if (preset === 'hazard') {
          sysSelect.value = 'commercial_rotor_stator_spr_hydrolysis_skid';
          matSelect.value = 'defatted_soy_glycinin_flakes';
          genSelect.value = 'conventional_low_shear_agitator';
          enzSelect.value = 'incompatible_low_activity_enzyme';
          rpmInput.value = '1000';
          presInput.value = '5.0';
          tempInput.value = '65.0';
          esInput.value = '0.50';
          resInput.value = '60.0';
          flowInput.value = '1200';
        }
        calculateKinetics();
      });
    });

    calculateKinetics();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHcAehModeler);
  } else {
    initHcAehModeler();
  }
</script>