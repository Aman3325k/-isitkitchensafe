<script is:inline define:vars={{ feedstocks }}>
  function initOswDorModeler() {
    const feedSelect = document.getElementById('osw-feedstock-select');
    const feedDesc = document.getElementById('osw-feedstock-desc');
    const powerSlider = document.getElementById('osw-power-slider');
    const powerVal = document.getElementById('osw-power-val');
    const tempSlider = document.getElementById('osw-temp-slider');
    const tempVal = document.getElementById('osw-temp-val');
    const resSlider = document.getElementById('osw-residence-slider');
    const resVal = document.getElementById('osw-residence-val');
    const flowSlider = document.getElementById('osw-flow-slider');
    const flowVal = document.getElementById('osw-flow-val');
    const dropSlider = document.getElementById('osw-droplet-slider');
    const dropVal = document.getElementById('osw-droplet-val');

    // Outputs
    const outGorkov = document.getElementById('osw-out-gorkov');
    const outDroplet = document.getElementById('osw-out-droplet');
    const outGrowth = document.getElementById('osw-out-growth');
    const outStokes = document.getElementById('osw-out-stokes');
    const outRecovery = document.getElementById('osw-out-recovery');
    const outPolyphenol = document.getElementById('osw-out-polyphenol');
    const outSec = document.getElementById('osw-out-sec');
    const verdictBox = document.getElementById('osw-verdict-box');
    const verdictBadge = document.getElementById('osw-verdict-badge');
    const verdictIcon = document.getElementById('osw-verdict-icon');
    const verdictText = document.getElementById('osw-verdict-text');

    // Presets
    const btnOlive = document.getElementById('osw-preset-olive');
    const btnAvocado = document.getElementById('osw-preset-avocado');
    const btnCoconut = document.getElementById('osw-preset-coconut');
    const btnAlgal = document.getElementById('osw-preset-algal');
    const btnHazard = document.getElementById('osw-preset-hazard');

    if (!feedSelect || !powerSlider) return;

    function getActiveFeed() {
      const id = feedSelect.value;
      return feedstocks.find(f => f.id === id) || feedstocks[0];
    }

    function calculateModel() {
      const feed = getActiveFeed();
      const p = parseFloat(powerSlider.value);
      const t = parseFloat(tempSlider.value);
      const res = parseFloat(residenceSlider.value);
      const flow = parseFloat(flowSlider.value);
      const d0 = parseFloat(dropSlider.value);

      // Update Text Displays
      powerVal.textContent = p.toFixed(1) + ' W/cm²';
      tempVal.textContent = t.toFixed(1) + ' °C';
      resVal.textContent = res.toFixed(1) + ' s';
      flowVal.textContent = flow.toFixed(0) + ' L/h';
      dropVal.textContent = d0.toFixed(1) + ' µm';
      if (feedDesc) feedDesc.textContent = feed.feedDescription;

      // Physics Models:
      // 1. Primary Gor'kov Force F_rad (pN):
      // Scales with acoustic power p, contrast factor Phi, and volume (d0^3)
      const phi = feed.acousticContrastFactorPhi;
      const gorkovForce = Math.max(2.5, (p * 0.95 * phi * (d0 / 2.0)**2.2 * 3.8));

      // 2. Bjerknes Coalescence & Droplet Growth
      // Coalescence factor driven by power density, residence time, and initial droplet size
      const acousticEnergyDensity = (p * res) / 100.0; // J/cm² equivalent
      let coalescenceRatio = 1.0;
      if (acousticEnergyDensity >= 1.5) {
        coalescenceRatio = Math.min(28.0, 1.0 + (acousticEnergyDensity * 2.8 * (d0 / 1.5)**0.4));
      } else {
        coalescenceRatio = Math.max(1.0, 1.0 + (acousticEnergyDensity * 0.8));
      }
      const dFinal = Math.min(65.0, Math.round(d0 * coalescenceRatio * 10) / 10);

      // 3. Stokes Creaming Separation Velocity v_sep (mm/s):
      // v = [2 * r^2 * delta_rho * g] / [9 * eta]
      // Velocity scales with dFinal^2
      const deltaRho = 85.0; // kg/m^3 (water 1000 - oil 915)
      const baseViscosity = 0.0018 * Math.exp(500 / (t + 273.15)); // Pa*s
      const stokesVel = Math.min(3.8, Math.max(0.01, (2 * ((dFinal * 1e-6) / 2)**2 * deltaRho * 9.81 / (9 * baseViscosity)) * 1000));

      // 4. Free Oil Recovery Yield (%):
      let recovery = 0.0;
      if (dFinal >= 35.0 && res >= 12.0) {
        recovery = Math.min(99.6, feed.freeOilRecoveryYieldPct + (p >= 35.0 ? 0.3 : -0.2));
      } else if (dFinal >= 20.0) {
        recovery = Math.max(88.0, 92.0 + (dFinal - 20.0) * 0.4);
      } else {
        recovery = Math.max(45.0, 50.0 + dFinal * 1.5);
      }

      // 5. Bioactive Polyphenol & Tocopherol Retention (%):
      // Degrades if temperature exceeds 28°C or extreme acoustic cavitation (> 75 W/cm²)
      let polyphenol = feed.polyphenolRetentionPct;
      if (t > 28.0) {
        polyphenol -= (t - 28.0) * 1.8;
      }
      if (p > 70.0) {
        polyphenol -= (p - 70.0) * 0.15;
      }
      polyphenol = Math.max(82.0, Math.min(99.8, polyphenol));

      // 6. Specific Energy Consumption SEC (kWh/m³):
      // SEC = Acoustic Power / Flow Rate
      const totalElectricKw = (p * 4.2 * (flow / 500.0) * 0.08) + 0.12;
      const secVal = Math.max(0.18, Math.min(0.95, totalElectricKw / (flow / 1000.0)));

      // Update DOM outputs
      outGorkov.textContent = gorkovForce.toFixed(1) + ' pN';
      outDroplet.textContent = dFinal.toFixed(1) + ' µm';
      outGrowth.textContent = coalescenceRatio.toFixed(1) + 'x Coalescence';
      outStokes.textContent = stokesVel.toFixed(2) + ' mm/s';
      outRecovery.textContent = recovery.toFixed(1) + '%';
      outPolyphenol.textContent = polyphenol.toFixed(1) + '%';
      outSec.textContent = secVal.toFixed(2) + ' kWh/m³';

      // Update Verdict Box
      if (recovery >= 98.0 && polyphenol >= 98.5 && t <= 28.0) {
        verdictBox.className = "mt-4 p-4 rounded-xl bg-emerald-950/30 border border-emerald-800/80 flex items-start gap-3";
        verdictBadge.className = "px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-900 text-emerald-200";
        verdictBadge.textContent = "OPTIMAL COLD ACOUSTOPHORESIS";
        verdictIcon.textContent = "✅";
        verdictText.textContent = `Orthogonal 1.2 & 2.4 MHz megasonic fields successfully overcome interfacial steric resistance, driving droplet coalescence to ${dFinal.toFixed(1)} µm and achieving ${recovery.toFixed(1)}% free oil recovery at ${t.toFixed(1)}°C with zero chemical additives under USDA Organic.`;
      } else if (t > 28.0) {
        verdictBox.className = "mt-4 p-4 rounded-xl bg-amber-950/30 border border-amber-800/80 flex items-start gap-3";
        verdictBadge.className = "px-2 py-0.5 rounded text-[10px] font-bold bg-amber-900 text-amber-200";
        verdictBadge.textContent = "THERMAL COLD-PRESS DEVIATION";
        verdictIcon.textContent = "⚠️";
        verdictText.textContent = `Operating temperature (${t.toFixed(1)}°C) exceeds the strict cold-pressed threshold (≤27°C). Thermal oxidation degrades polyphenols to ${polyphenol.toFixed(1)}% and risks loss of Extra Virgin certification under Codex CXS 210-1999.`;
      } else {
        verdictBox.className = "mt-4 p-4 rounded-xl bg-rose-950/30 border border-rose-800/80 flex items-start gap-3";
        verdictBadge.className = "px-2 py-0.5 rounded text-[10px] font-bold bg-rose-900 text-rose-200";
        verdictBadge.textContent = "INCOMPLETE ACOUSTIC SEPARATION";
        verdictIcon.textContent = "🛑";
        verdictText.textContent = `Acoustic energy density is insufficient to overcome droplet interfacial elasticity (d_final = ${dFinal.toFixed(1)} µm). Stokes creaming velocity is restricted to ${stokesVel.toFixed(2)} mm/s, causing >${(100 - recovery).toFixed(1)}% unrecovered emulsified oil loss in vegetative effluent.`;
      }
    }

    // Attach Listeners
    feedSelect.addEventListener('change', () => {
      const feed = getActiveFeed();
      powerSlider.value = feed.acousticResonancePowerDensityWPerCm2.toString();
      resSlider.value = feed.residenceTimeSec.toString();
      dropSlider.value = feed.initialMeanDropletDiameterMicrons.toString();
      calculateModel();
    });

    [powerSlider, tempSlider, resSlider, flowSlider, dropSlider].forEach(el => {
      el.addEventListener('input', calculateModel);
    });

    // Preset handlers
    if (btnOlive) {
      btnOlive.addEventListener('click', () => {
        feedSelect.value = 'cold_pressed_extra_virgin_olive_oil_paste';
        powerSlider.value = "38.0";
        tempSlider.value = "22.0";
        resSlider.value = "18.0";
        flowSlider.value = "450";
        dropSlider.value = "2.4";
        calculateModel();
      });
    }

    if (btnAvocado) {
      btnAvocado.addEventListener('click', () => {
        feedSelect.value = 'virgin_avocado_oil_pulp_clarification';
        powerSlider.value = "44.0";
        tempSlider.value = "24.0";
        resSlider.value = "22.0";
        flowSlider.value = "350";
        dropSlider.value = "3.1";
        calculateModel();
      });
    }

    if (btnCoconut) {
      btnCoconut.addEventListener('click', () => {
        feedSelect.value = 'wet_milled_virgin_coconut_milk_separation';
        powerSlider.value = "32.0";
        tempSlider.value = "23.0";
        resSlider.value = "15.0";
        flowSlider.value = "550";
        dropSlider.value = "1.8";
        calculateModel();
      });
    }

    if (btnAlgal) {
      btnAlgal.addEventListener('click', () => {
        feedSelect.value = 'algal_heterotrophic_lipid_harvest_emulsion';
        powerSlider.value = "65.0";
        tempSlider.value = "20.0";
        resSlider.value = "32.0";
        flowSlider.value = "250";
        dropSlider.value = "0.9";
        calculateModel();
      });
    }

    if (btnHazard) {
      btnHazard.addEventListener('click', () => {
        powerSlider.value = "10.0";
        tempSlider.value = "33.5";
        resSlider.value = "6.0";
        flowSlider.value = "1200";
        dropSlider.value = "1.2";
        calculateModel();
      });
    }

    calculateModel();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initOswDorModeler);
  } else {
    initOswDorModeler();
  }
</script>
