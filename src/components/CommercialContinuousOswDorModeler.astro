            <circle cx="100" cy="110" r="2.5" fill="#f59e0b" opacity="0.7"/>
            <circle cx="85" cy="150" r="3.2" fill="#f59e0b" opacity="0.7"/>
            <circle cx="115" cy="160" r="2.8" fill="#f59e0b" opacity="0.7"/>

            <!-- Node Coalescence Zone (Bjerknes Aggregation) -->
            <circle cx="220" cy="120" r="10" fill="#f59e0b" stroke="#fef08a" stroke-width="1.5"/>
            <circle cx="270" cy="120" r="12" fill="#f59e0b" stroke="#fef08a" stroke-width="1.5"/>
            <circle cx="320" cy="105" r="14" fill="#10b981" stroke="#a7f3d0" stroke-width="1.5"/>
            <text x="245" y="70" text-anchor="middle" fill="#fef08a" font-size="8">BJERKNES INTER-DROPLET COALESCENCE</text>
            <text x="245" y="80" text-anchor="middle" fill="#6ee7b7" font-size="7">d_final &gt; 40 µm</text>

            <!-- Laminar Stratification & Decanting Funnel (Right Zone) -->
            <path d="M 510 30 L 650 30 L 650 75 L 560 120 L 650 165 L 650 210 L 510 210 Z" fill="#1e293b" stroke="#475569" stroke-width="1.5"/>

            <!-- Top Overflow: Pure Cold-Pressed Virgin Oil -->
            <path d="M 560 65 L 670 65" stroke="#10b981" stroke-width="6" stroke-linecap="round"/>
            <polygon points="666,60 674,65 666,70" fill="#10b981"/>
            <text x="615" y="52" text-anchor="middle" fill="#34d399" font-size="9" font-weight="bold">CLEAN OIL OUT</text>
            <text x="615" y="80" text-anchor="middle" fill="#a7f3d0" font-size="7">Recovery &gt; 99% &bull; PV &lt; 0.5</text>

            <!-- Bottom Underflow: Clarified Vegetative Water / Mucilage -->
            <path d="M 560 175 L 670 175" stroke="#64748b" stroke-width="5" stroke-linecap="round"/>
            <polygon points="666,170 674,175 666,180" fill="#64748b"/>
            <text x="615" y="165" text-anchor="middle" fill="#cbd5e1" font-size="8" font-weight="bold">AQUEOUS VEGETATIVE</text>
            <text x="615" y="195" text-anchor="middle" fill="#94a3b8" font-size="7">Oil Residue &lt; 0.6%</text>
          </svg>
        </div>
      </div>
    </div>
  </div>

  <!-- Comparative Technology Benchmark Matrix -->
  <div class="bg-surface-soft border border-hairline rounded-2xl p-6 sm:p-8 mb-10">
    <h3 class="text-base font-bold text-ink mb-1">{d.compTitle}</h3>
    <p class="text-xs text-muted mb-6">{d.compSub}</p>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs border-collapse">
        <thead>
          <tr class="border-b border-hairline bg-surface/50 text-muted uppercase tracking-wider text-[10px]">
            <th class="p-3">Extraction Technology</th>
            <th class="p-3">Separation Principle</th>
            <th class="p-3">Operating Temp</th>
            <th class="p-3">Oil Recovery Yield</th>
            <th class="p-3">Polyphenol Retention</th>
            <th class="p-3">Energy (kWh/m³)</th>
            <th class="p-3">Regulatory Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline">
          <tr class="bg-amber-950/20 font-medium">
            <td class="p-3 font-bold text-amber-400">Continuous OSW-DOR (This System)</td>
            <td class="p-3 text-ink">Orthogonal Dual-Frequency Acoustic Resonance</td>
            <td class="p-3 font-mono text-emerald-400">18 – 24 °C (Cold Ambient)</td>
            <td class="p-3 font-mono text-emerald-400">98.5 – 99.6%</td>
            <td class="p-3 font-mono text-emerald-400">&gt; 99.4% (Unoxidized)</td>
            <td class="p-3 font-mono text-emerald-400">0.25 – 0.44</td>
            <td class="p-3 text-emerald-400 font-semibold">FDA 21 CFR § 117 / USDA Organic</td>
          </tr>
          <tr>
            <td class="p-3 font-semibold text-ink">High-Speed Disc-Stack Centrifuge</td>
            <td class="p-3 text-muted">Centrifugal Density Stratification (5,000–8,000 G)</td>
