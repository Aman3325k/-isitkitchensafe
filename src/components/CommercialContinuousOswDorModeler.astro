        <div class="w-full bg-surface border border-hairline rounded-xl p-3 flex justify-center">
          <svg viewBox="0 0 700 240" class="w-full h-auto max-w-[620px] font-sans" fill="none" xmlns="http://www.w3.org/2000/svg">
            <!-- Background Acoustic Flow Cell -->
            <rect x="50" y="30" width="460" height="180" rx="12" fill="#0f172a" stroke="#334155" stroke-width="2"/>
            
