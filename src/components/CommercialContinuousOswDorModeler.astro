            <text x="25" y="105" text-anchor="middle" fill="#fcd34d" font-size="9" font-weight="bold">SLURRY IN</text>
            <text x="25" y="140" text-anchor="middle" fill="#94a3b8" font-size="7">d₀ ≈ 2.4 µm</text>

            <!-- Standing Wave Nodes (Grid Pattern) -->
