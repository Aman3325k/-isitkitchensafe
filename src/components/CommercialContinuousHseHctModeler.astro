    presetPork: "手撕猪肉/炖牛腩替代肉 (豌豆-微蛋白复合, 360 RPM, 64%水分, 26.5 bar, AI 3.12)",
    presetSpentGrain: "酒糟再生红烧牛肉块 (侧耳菌丝, 280 RPM, 62%水分, 28 bar, AI 2.85, 循环经济认证)",
    presetFish: "层状剥离白身鱼排 (蚕豆+蛹虫草, 240 RPM, 70%水分, 20 bar, AI 2.65, 薄片层叠感)",
    presetSyntheticHazard: "传统甲基纤维素合成对照组 (TVP风险基准, 0 bar空化, AI 1.45, 3.5%化学胶体)",
    telemetryTitle: "实时流变动力学遥测 & 肌肉纤维雷达",
    telemetrySub: "持续监控纤维各向异性指数、菌丝微纤化缠结度、抗拉应力比、比机械能与清洁标签合规性。",
    anisotropyLabel: "纤维各向异性指数 (AI):",
    entanglementLabel: "菌丝体微纤化缠结度:",
    tensileParallelLabel: "平行挤压拉伸强度 (F_parallel):",
    tensilePerpLabel: "垂直挤压拉伸强度 (F_perp):",
    gumLabel: "化学粘结胶体添加量:",
    smeLabel: "比机械能消耗 (SME):",
    energySavingsLabel: "综合能耗与碳足迹削减率:",
    pressureSafetyLabel: "ASME机筒耐压安全裕度:",
    verdictLabel: "替代肉组织感与清洁标签评定:",
    diagramTitle: "HSE-HCT连续挤压与管线式空化结构示意图",
    diagramSub: "直观展示双螺杆剪切塑化、水动力空化微纤化解聚与狭缝模头层流纤维定向冻结全流程。",
    chartTitle: "纤维各向异性与流变学对比雷达",
    chartSub: "横向比对HSE-HCT、传统TVP挤压、剪切室技术、湿法纺丝与3D食品打印。",
    scienceTitle: "食品物理学、流变学与水动力空化核心机理",
    scienceSub: "解析菌丝取向定向流、瑞利-普莱塞特空化冲击波物理以及天然氢键自缠结理论。",
    tableTitle: "人造肉替代蛋白制造技术综合比对矩阵",
    exportAuditBtn: "导出完整工程审计报告 (JSON)"
  }
};

const d = DICT[lang] || DICT.en;
---

<div class="hse-hct-container bg-surface border border-hairline rounded-3xl p-4 sm:p-8 shadow-xs" data-lang={lang}>
  <!-- Header Bar -->
  <div class="flex flex-wrap items-center justify-between gap-4 pb-6 mb-8 border-b border-hairline">
    <div class="flex items-center gap-3">
      <span class="inline-flex items-center justify-center w-10 h-10 rounded-2xl bg-amber-950 text-amber-300 font-bold border border-amber-800 text-lg">
        HSE
      </span>
      <div>
        <h2 class="text-xl sm:text-2xl font-extrabold text-ink tracking-tight">{d.title}</h2>
        <p class="text-xs sm:text-sm text-muted">{d.subtitle}</p>
      </div>
    </div>
    <div class="flex items-center gap-2">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-950 text-emerald-300 border border-emerald-800">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        FDA GRN 000091 &bull; 0.0% GUMS
      </span>
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-blue-950 text-blue-300 border border-blue-800">
        ASME 180 BAR RATED
      </span>
    </div>
  </div>

  <!-- Operational Presets -->
  <div class="mb-8 p-5 bg-surface-soft rounded-2xl border border-hairline/80">
    <div class="text-xs font-bold uppercase tracking-wider text-muted mb-3 flex items-center gap-2">
      <svg class="w-4 h-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
      </svg>
      {d.presetsTitle}
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-2.5">
      <button type="button" class="preset-btn px-3 py-2.5 rounded-xl text-left bg-surface border border-hairline hover:border-amber-500 hover:bg-amber-950/20 text-xs transition-all cursor-pointer font-medium text-ink flex flex-col justify-between" data-preset="chicken">
        <span class="font-bold text-amber-400 mb-1">🍗 {d.presetChicken.split('(')[0]}</span>
        <span class="text-muted text-[11px] leading-tight">Fusarium &bull; AI 3.45 &bull; 0.0% Gums</span>
      </button>
      <button type="button" class="preset-btn px-3 py-2.5 rounded-xl text-left bg-surface border border-hairline hover:border-amber-500 hover:bg-amber-950/20 text-xs transition-all cursor-pointer font-medium text-ink flex flex-col justify-between" data-preset="pork">
        <span class="font-bold text-emerald-400 mb-1">🥩 {d.presetPork.split('(')[0]}</span>
        <span class="text-muted text-[11px] leading-tight">Pea-Myco &bull; AI 3.12 &bull; 0.0% Gums</span>
      </button>
      <button type="button" class="preset-btn px-3 py-2.5 rounded-xl text-left bg-surface border border-hairline hover:border-amber-500 hover:bg-amber-950/20 text-xs transition-all cursor-pointer font-medium text-ink flex flex-col justify-between" data-preset="spent_grain">
        <span class="font-bold text-yellow-400 mb-1">🌾 {d.presetSpentGrain.split('(')[0]}</span>
        <span class="text-muted text-[11px] leading-tight">Pleurotus &bull; Upcycled &bull; AI 2.85</span>
      </button>
      <button type="button" class="preset-btn px-3 py-2.5 rounded-xl text-left bg-surface border border-hairline hover:border-amber-500 hover:bg-amber-950/20 text-xs transition-all cursor-pointer font-medium text-ink flex flex-col justify-between" data-preset="fish">
        <span class="font-bold text-cyan-400 mb-1">🐟 {d.presetFish.split('(')[0]}</span>
        <span class="text-muted text-[11px] leading-tight">Faba-Cordyceps &bull; Flaky &bull; AI 2.65</span>
      </button>
      <button type="button" class="preset-btn px-3 py-2.5 rounded-xl text-left bg-surface border border-hairline hover:border-red-500 hover:bg-red-950/20 text-xs transition-all cursor-pointer font-medium text-ink flex flex-col justify-between" data-preset="synthetic_hazard">
        <span class="font-bold text-rose-400 mb-1">⚠️ {d.presetSyntheticHazard.split('(')[0]}</span>
        <span class="text-muted text-[11px] leading-tight">TVP Hazard &bull; 3.5% Gums &bull; AI 1.45</span>
      </button>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-10">
    <!-- Controls Panel (Left 5 Cols) -->
    <div class="lg:col-span-5 bg-surface-soft p-5 sm:p-6 rounded-2xl border border-hairline space-y-6">
      <div>
        <h3 class="text-base font-bold text-ink mb-1">{d.controlsTitle}</h3>
        <p class="text-xs text-muted leading-relaxed">{d.controlsSub}</p>
      </div>

      <!-- Skid Selector -->
      <div>
        <label for="skid-select" class="block text-xs font-semibold text-ink mb-1.5">{d.skidLabel}</label>
        <select id="skid-select" class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-xs font-medium text-ink focus:outline-none focus:border-amber-500">
          {hseData.systemArchitectures.map(skid => (
            <option value={skid.id}>{skid.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1">{d.skidHelp}</p>
      </div>

      <!-- Feedstock Selector -->
      <div>
        <label for="feedstock-select" class="block text-xs font-semibold text-ink mb-1.5">{d.feedstockLabel}</label>
        <select id="feedstock-select" class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-xs font-medium text-ink focus:outline-none focus:border-amber-500">
          {hseData.mycoproteinFeedstocks.map(f => (
            <option value={f.id}>{f.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1">{d.feedstockHelp}</p>
      </div>

      <!-- Screw Speed Slider -->
      <div>
        <div class="flex justify-between text-xs font-semibold mb-1">
          <label for="screw-speed" class="text-ink">{d.screwSpeedLabel}</label>
          <span id="screw-speed-val" class="text-amber-400 font-mono">320 RPM</span>
        </div>
        <input 
          type="range" 
          id="screw-speed" 
          min="100" 
          max="550" 
          step="10" 
          value="320" 
          class="w-full h-2 bg-surface rounded-lg appearance-none cursor-pointer accent-amber-500" 
        />
        <p class="text-[11px] text-muted mt-1">{d.screwSpeedHelp}</p>
      </div>

      <!-- Moisture Content Slider -->
      <div>
        <div class="flex justify-between text-xs font-semibold mb-1">
          <label for="moisture" class="text-ink">{d.moistureLabel}</label>
          <span id="moisture-val" class="text-emerald-400 font-mono">68.0 %</span>
        </div>
        <input 
          type="range" 
          id="moisture" 
          min="50" 
          max="78" 
          step="0.5" 
          value="68.0" 
          class="w-full h-2 bg-surface rounded-lg appearance-none cursor-pointer accent-emerald-500" 
        />
        <p class="text-[11px] text-muted mt-1">{d.moistureHelp}</p>
      </div>

      <!-- Cavitation Pressure Slider -->
      <div>
        <div class="flex justify-between text-xs font-semibold mb-1">
          <label for="cavitation" class="text-ink">{d.cavitationLabel}</label>
          <span id="cavitation-val" class="text-cyan-400 font-mono">22.0 bar</span>
        </div>
        <input 
          type="range" 
          id="cavitation" 
          min="0" 
          max="35" 
          step="0.5" 
          value="22.0" 
          class="w-full h-2 bg-surface rounded-lg appearance-none cursor-pointer accent-cyan-500" 
        />
        <p class="text-[11px] text-muted mt-1">{d.cavitationHelp}</p>
      </div>

      <!-- Slit-Die Cooling Temp Slider -->
      <div>
        <div class="flex justify-between text-xs font-semibold mb-1">
          <label for="cooling-temp" class="text-ink">{d.coolingTempLabel}</label>
          <span id="cooling-temp-val" class="text-blue-400 font-mono">68.0 °C</span>
        </div>
        <input 
          type="range" 
          id="cooling-temp" 
          min="45" 
          max="85" 
          step="1" 
          value="68" 
          class="w-full h-2 bg-surface rounded-lg appearance-none cursor-pointer accent-blue-500" 
        />
        <p class="text-[11px] text-muted mt-1">{d.coolingTempHelp}</p>
      </div>

      <!-- Throughput Slider -->
      <div>
        <div class="flex justify-between text-xs font-semibold mb-1">
          <label for="throughput" class="text-ink">{d.throughputLabel}</label>
          <span id="throughput-val" class="text-violet-400 font-mono">350 kg/h</span>
        </div>
        <input 
          type="range" 
          id="throughput" 
          min="50" 
          max="1200" 
          step="25" 
          value="350" 
          class="w-full h-2 bg-surface rounded-lg appearance-none cursor-pointer accent-violet-500" 
        />
        <p class="text-[11px] text-muted mt-1">{d.throughputHelp}</p>
      </div>
    </div>

    <!-- Telemetry & Live Simulation Radar (Right 7 Cols) -->
    <div class="lg:col-span-7 flex flex-col justify-between space-y-6">
      <!-- Telemetry Dashboard -->
      <div class="bg-surface-soft p-5 sm:p-6 rounded-2xl border border-hairline">
        <div class="flex items-center justify-between mb-4">
          <div>
            <h3 class="text-base font-bold text-ink">{d.telemetryTitle}</h3>
            <p class="text-xs text-muted">{d.telemetrySub}</p>
          </div>
          <span id="clean-label-pill" class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-emerald-950 text-emerald-300 border border-emerald-800">
            100% GUM-FREE NATURAL
          </span>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          <div class="bg-surface p-3 rounded-xl border border-hairline text-center">
            <span class="block text-[11px] text-muted mb-1">{d.anisotropyLabel}</span>
            <span id="tel-anisotropy" class="text-xl font-extrabold text-amber-400 font-mono">3.45</span>
            <span id="anisotropy-status" class="block text-[10px] text-emerald-400 font-semibold mt-0.5">High Muscle Anisotropy</span>
          </div>

          <div class="bg-surface p-3 rounded-xl border border-hairline text-center">
            <span class="block text-[11px] text-muted mb-1">{d.entanglementLabel}</span>
            <span id="tel-entanglement" class="text-xl font-extrabold text-cyan-400 font-mono">94.6%</span>
            <span class="block text-[10px] text-muted mt-0.5">Defibrillated Fibrils</span>
          </div>

          <div class="bg-surface p-3 rounded-xl border border-hairline text-center">
            <span class="block text-[11px] text-muted mb-1">{d.tensileParallelLabel}</span>
            <span id="tel-parallel" class="text-xl font-extrabold text-ink font-mono">89.2 kPa</span>
            <span class="block text-[10px] text-muted mt-0.5">F_parallel (Fiber Grain)</span>
          </div>

          <div class="bg-surface p-3 rounded-xl border border-hairline text-center">
            <span class="block text-[11px] text-muted mb-1">{d.tensilePerpLabel}</span>
            <span id="tel-perp" class="text-xl font-extrabold text-ink font-mono">25.8 kPa</span>
            <span class="block text-[10px] text-muted mt-0.5">F_perp (Tear Shear)</span>
          </div>

          <div class="bg-surface p-3 rounded-xl border border-hairline text-center">
            <span class="block text-[11px] text-muted mb-1">{d.gumLabel}</span>
            <span id="tel-gum" class="text-xl font-extrabold text-emerald-400 font-mono">0.0 %</span>
            <span class="block text-[10px] text-emerald-400 font-semibold mt-0.5">Zero Binders</span>
          </div>

          <div class="bg-surface p-3 rounded-xl border border-hairline text-center">
            <span class="block text-[11px] text-muted mb-1">{d.smeLabel}</span>
            <span id="tel-sme" class="text-xl font-extrabold text-violet-400 font-mono">88.5 kWh/t</span>
            <span class="block text-[10px] text-muted mt-0.5">Motor Work</span>
          </div>

          <div class="bg-surface p-3 rounded-xl border border-hairline text-center">
            <span class="block text-[11px] text-muted mb-1">{d.energySavingsLabel}</span>
            <span id="tel-savings" class="text-xl font-extrabold text-emerald-400 font-mono">39.0 %</span>
            <span class="block text-[10px] text-emerald-400 font-semibold mt-0.5">vs TVP Extrusion</span>
          </div>

          <div class="bg-surface p-3 rounded-xl border border-hairline text-center">
            <span class="block text-[11px] text-muted mb-1">{d.pressureSafetyLabel}</span>
            <span id="tel-pressure-safety" class="text-xl font-extrabold text-blue-400 font-mono">SF 4.8</span>
            <span class="block text-[10px] text-blue-400 font-semibold mt-0.5">180 Bar Certified</span>
          </div>
        </div>

        <div class="mt-4 p-3.5 bg-surface rounded-xl border border-hairline flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2">
          <div>
            <span class="text-xs font-bold text-muted uppercase tracking-wider">{d.verdictLabel}</span>
            <span id="tel-verdict" class="block text-sm font-extrabold text-amber-400 mt-0.5">
              Whole-Cut Chicken Breast Fillet (Striated Longitudinal Muscle Fibers &bull; Natural Chewiness &bull; Zero Methylcellulose)
            </span>
          </div>
          <button type="button" id="export-report-btn" class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-amber-950 text-amber-300 border border-amber-800 hover:bg-amber-900 transition-colors cursor-pointer shrink-0">
            {d.exportAuditBtn}
          </button>
        </div>
      </div>

      <!-- Real-Time SVG Engineering Schematic -->
      <div class="bg-surface-soft p-5 sm:p-6 rounded-2xl border border-hairline">
        <div class="flex items-center justify-between mb-3">
          <div>
            <h4 class="text-sm font-bold text-ink">{d.diagramTitle}</h4>
            <p class="text-xs text-muted">{d.diagramSub}</p>
          </div>
          <span class="text-[11px] font-mono text-muted">L/D 40:1 &bull; W/H &gt; 12:1 Slit</span>
        </div>

        <div class="w-full overflow-hidden bg-surface rounded-xl border border-hairline p-3">
          <svg viewBox="0 0 800 280" class="w-full h-auto text-ink font-sans" id="extruder-svg">
            <defs>
              <linearGradient id="barrelGradient" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#3b82f6" stop-opacity="0.3" />
                <stop offset="40%" stop-color="#f59e0b" stop-opacity="0.5" />
                <stop offset="65%" stop-color="#ef4444" stop-opacity="0.6" />
                <stop offset="80%" stop-color="#06b6d4" stop-opacity="0.5" />
                <stop offset="100%" stop-color="#3b82f6" stop-opacity="0.4" />
              </linearGradient>
              <pattern id="fiberPattern" width="20" height="8" patternUnits="userSpaceOnUse">
                <line x1="0" y1="4" x2="20" y2="4" stroke="#f59e0b" stroke-width="1.5" stroke-dasharray="8,2" />
              </pattern>
            </defs>

            <!-- Barrel Housing -->
            <rect x="40" y="70" width="380" height="90" rx="6" fill="#1e293b" stroke="#475569" stroke-width="2" />
            <rect x="42" y="72" width="376" height="86" fill="url(#barrelGradient)" />

            <!-- Hopper Feed -->
            <polygon points="70,20 120,20 105,70 85,70" fill="#334155" stroke="#64748b" stroke-width="2" />
            <text x="95" y="42" font-size="10" fill="#94a3b8" text-anchor="middle" font-weight="bold">FEED</text>
            <circle cx="95" cy="56" r="3" fill="#10b981" class="animate-ping" />

            <!-- Twin Screws (Intermeshing Flights) -->
            <g id="screw-flights">
              <path d="M 125,80 Q 145,95 125,115 Q 145,135 125,150" fill="none" stroke="#94a3b8" stroke-width="3" />
              <path d="M 175,80 Q 195,95 175,115 Q 195,135 175,150" fill="none" stroke="#94a3b8" stroke-width="3" />
              <path d="M 225,80 Q 245,95 225,115 Q 245,135 225,150" fill="none" stroke="#cbd5e1" stroke-width="3" />
              <path d="M 275,80 Q 295,95 275,115 Q 295,135 275,150" fill="none" stroke="#fbbf24" stroke-width="3.5" />
              <path d="M 325,80 Q 345,95 325,115 Q 345,135 325,150" fill="none" stroke="#f87171" stroke-width="3.5" />
              <path d="M 375,80 Q 395,95 375,115 Q 395,135 375,150" fill="none" stroke="#f87171" stroke-width="3.5" />
            </g>

            <!-- Zone Labels -->
            <text x="145" y="180" font-size="9" fill="#94a3b8" text-anchor="middle">Feed & Convey</text>
            <text x="250" y="180" font-size="9" fill="#f59e0b" text-anchor="middle">Kneading Shear</text>
            <text x="350" y="180" font-size="9" fill="#ef4444" text-anchor="middle">Melt (138°C)</text>

            <!-- In-Line Micro-Hydrodynamic Cavitation Venturi Chamber -->
            <rect x="420" y="80" width="70" height="70" rx="4" fill="#0f172a" stroke="#06b6d4" stroke-width="2" />
            <polygon points="425,95 445,115 425,135" fill="#0891b2" />
            <polygon points="465,115 485,95 485,135" fill="#0891b2" />
            <circle cx="455" cy="115" r="5" fill="#38bdf8" id="cavitation-core-bubble" />
            <text x="455" y="70" font-size="10" fill="#38bdf8" font-weight="bold" text-anchor="middle">CAVITATION</text>
            <text x="455" y="165" font-size="8" fill="#38bdf8" text-anchor="middle" id="svg-cav-pressure">22.0 bar &bull; σ&lt;0.25</text>

            <!-- Long Cooling Slit-Die -->
            <rect x="490" y="92" width="260" height="46" rx="4" fill="#1e293b" stroke="#3b82f6" stroke-width="2" />
            <!-- Glycol Cooling Jackets (Top & Bottom) -->
            <rect x="495" y="80" width="250" height="10" rx="2" fill="#2563eb" opacity="0.6" />
            <rect x="495" y="140" width="250" height="10" rx="2" fill="#2563eb" opacity="0.6" />
            <text x="620" y="74" font-size="9" fill="#60a5fa" text-anchor="middle">Counter-Current Glycol Chiller (T_die = <tspan id="svg-die-temp">68°C</tspan>)</text>

            <!-- Aligned Meat Fibers inside Slit-Die -->
            <rect x="492" y="94" width="256" height="42" fill="url(#fiberPattern)" id="svg-fiber-fill" />
            <g id="fiber-lines" stroke="#f59e0b" stroke-width="1.8" stroke-linecap="round">
              <line x1="500" y1="102" x2="740" y2="102" />
              <line x1="500" y1="110" x2="740" y2="110" />
              <line x1="500" y1="115" x2="740" y2="115" stroke="#fbbf24" stroke-width="2.2" />
              <line x1="500" y1="120" x2="740" y2="120" />
              <line x1="500" y1="128" x2="740" y2="128" />
            </g>

            <!-- Extruded Whole-Cut Strip -->
            <polygon points="750,96 785,92 785,138 750,134" fill="#d97706" stroke="#f59e0b" stroke-width="1.5" />
            <text x="768" y="118" font-size="9" fill="#ffffff" font-weight="bold" text-anchor="middle">WHOLE-CUT</text>

            <!-- Anisotropy Vector Indicator -->
            <g transform="translate(620, 215)">
              <rect x="-80" y="-20" width="160" height="45" rx="6" fill="#0f172a" stroke="#475569" stroke-width="1" />
              <line x1="-60" y1="5" x2="60" y2="5" stroke="#10b981" stroke-width="2" marker-end="url(#arrow)" />
              <text x="0" y="-5" font-size="9" fill="#94a3b8" text-anchor="middle">F_parallel (Tensile)</text>
              <text x="0" y="18" font-size="10" fill="#10b981" font-weight="bold" text-anchor="middle" id="svg-ai-text">AI = 3.45 (Meat-Like Grain)</text>
            </g>

            <!-- Velocity Profile In Slit Die -->
            <g transform="translate(540, 205)">
              <text x="0" y="0" font-size="8" fill="#94a3b8">Laminar Velocity Profile</text>
              <path d="M 0,10 Q 25,20 0,30" fill="none" stroke="#38bdf8" stroke-width="1.5" />
              <line x1="0" y1="20" x2="25" y2="20" stroke="#38bdf8" stroke-width="1.5" />
            </g>
          </svg>
        </div>
      </div>
    </div>
  </div>

  <!-- Comparative Benchmarking Radar Table -->
  <div class="mb-10 p-6 bg-surface-soft rounded-2xl border border-hairline">
    <div class="flex items-center justify-between mb-4">
      <div>
        <h3 class="text-base font-bold text-ink">{d.chartTitle}</h3>
        <p class="text-xs text-muted">{d.chartSub}</p>
      </div>
      <span class="text-xs font-mono text-muted">Benchmarking 5 Alternative Protein Methods</span>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs border-collapse">
        <thead>
          <tr class="border-b border-hairline bg-surface/60 text-muted uppercase font-semibold">
            <th class="py-3 px-3">Manufacturing Attribute</th>
            <th class="py-3 px-3 text-amber-400 font-bold">HSE-HCT Mycoprotein (Flagship)</th>
            <th class="py-3 px-3">Conventional TVP Extrusion</th>
            <th class="py-3 px-3">Shear-Cell Technology</th>
            <th class="py-3 px-3">Wet Spinning</th>
            <th class="py-3 px-3">3D Food Printing</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline/60 font-medium">
          {hseData.comparativeTechnologyMatrix.map(row => (
            <tr class="hover:bg-surface/40 transition-colors">
              <td class="py-3 px-3 font-semibold text-ink">{row.attribute}</td>
              <td class="py-3 px-3 text-amber-300 font-bold bg-amber-950/20">{row.hseHctMycoprotein}</td>
              <td class="py-3 px-3 text-muted">{row.conventionalExtrusionTvp}</td>
              <td class="py-3 px-3 text-muted">{row.shearCellTechnology}</td>
              <td class="py-3 px-3 text-muted">{row.spinningTechnology}</td>
              <td class="py-3 px-3 text-muted">{row.threeDPrinting}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Engineering Science & Rheological Formulas -->
  <div class="p-6 bg-surface-soft rounded-2xl border border-hairline">
    <h3 class="text-base font-bold text-ink mb-1">{d.scienceTitle}</h3>
    <p class="text-xs text-muted mb-6">{d.scienceSub}</p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      <div class="bg-surface p-4 rounded-xl border border-hairline">
        <span class="inline-block px-2 py-0.5 rounded text-[10px] font-bold bg-amber-950 text-amber-300 border border-amber-800 mb-2">
          Anisotropy Index (AI)
        </span>
        <code class="block text-xs font-mono text-ink bg-surface-soft p-2 rounded mb-2 border border-hairline">
          {hseData.rheologicalFormulasAndPhysics.anisotropyIndex.formula}
        </code>
        <p class="text-xs text-muted leading-relaxed">
          {hseData.rheologicalFormulasAndPhysics.anisotropyIndex.explanation}
        </p>
      </div>

      <div class="bg-surface p-4 rounded-xl border border-hairline">
        <span class="inline-block px-2 py-0.5 rounded text-[10px] font-bold bg-cyan-950 text-cyan-300 border border-cyan-800 mb-2">
          Slit-Die Wall Shear Rate
        </span>
        <code class="block text-xs font-mono text-ink bg-surface-soft p-2 rounded mb-2 border border-hairline">
          {hseData.rheologicalFormulasAndPhysics.slitDieShearRate.formula}
        </code>
        <p class="text-xs text-muted leading-relaxed">
          {hseData.rheologicalFormulasAndPhysics.slitDieShearRate.explanation}
        </p>
      </div>

      <div class="bg-surface p-4 rounded-xl border border-hairline">
        <span class="inline-block px-2 py-0.5 rounded text-[10px] font-bold bg-blue-950 text-blue-300 border border-blue-800 mb-2">
          Hydrodynamic Cavitation Number
        </span>
        <code class="block text-xs font-mono text-ink bg-surface-soft p-2 rounded mb-2 border border-hairline">
          {hseData.rheologicalFormulasAndPhysics.hydrodynamicCavitationNumber.formula}
        </code>
        <p class="text-xs text-muted leading-relaxed">
          {hseData.rheologicalFormulasAndPhysics.hydrodynamicCavitationNumber.explanation}
        </p>
      </div>
    </div>
  </div>
</div>

<script>
  function initHseHctModeler() {
    const container = document.querySelector('.hse-hct-container');
    if (!container) return;

    // Elements
    const skidSelect = container.querySelector('#skid-select') as HTMLSelectElement | null;
    const feedstockSelect = container.querySelector('#feedstock-select') as HTMLSelectElement | null;
    const screwSpeedInput = container.querySelector('#screw-speed') as HTMLInputElement | null;
    const moistureInput = container.querySelector('#moisture') as HTMLInputElement | null;
    const cavitationInput = container.querySelector('#cavitation') as HTMLInputElement | null;
    const coolingTempInput = container.querySelector('#cooling-temp') as HTMLInputElement | null;
    const throughputInput = container.querySelector('#throughput') as HTMLInputElement | null;

    // Display Values
    const screwSpeedVal = container.querySelector('#screw-speed-val');
    const moistureVal = container.querySelector('#moisture-val');
    const cavitationVal = container.querySelector('#cavitation-val');
    const coolingTempVal = container.querySelector('#cooling-temp-val');
    const throughputVal = container.querySelector('#throughput-val');

    // Telemetry Displays
    const telAnisotropy = container.querySelector('#tel-anisotropy');
    const anisotropyStatus = container.querySelector('#anisotropy-status');
    const telEntanglement = container.querySelector('#tel-entanglement');
    const telParallel = container.querySelector('#tel-parallel');
    const telPerp = container.querySelector('#tel-perp');
    const telGum = container.querySelector('#tel-gum');
    const telSme = container.querySelector('#tel-sme');
    const telSavings = container.querySelector('#tel-savings');
    const telPressureSafety = container.querySelector('#tel-pressure-safety');
    const telVerdict = container.querySelector('#tel-verdict');
    const cleanLabelPill = container.querySelector('#clean-label-pill');

    // SVG elements
    const svgCavPressure = container.querySelector('#svg-cav-pressure');
    const svgDieTemp = container.querySelector('#svg-die-temp');
    const svgAiText = container.querySelector('#svg-ai-text');
    const cavitationBubble = container.querySelector('#cavitation-core-bubble');

    function calculateMetrics() {
      if (!screwSpeedInput || !moistureInput || !cavitationInput || !coolingTempInput || !throughputInput || !feedstockSelect) return;

      const rpm = parseFloat(screwSpeedInput.value);
      const mc = parseFloat(moistureInput.value);
      const pCav = parseFloat(cavitationInput.value);
      const tDie = parseFloat(coolingTempInput.value);
      const throughput = parseFloat(throughputInput.value);
      const feedstock = feedstockSelect.value;

      // Update text displays
      if (screwSpeedVal) screwSpeedVal.textContent = `${rpm.toFixed(0)} RPM`;
      if (moistureVal) moistureVal.textContent = `${mc.toFixed(1)} %`;
      if (cavitationVal) cavitationVal.textContent = `${pCav.toFixed(1)} bar`;
      if (coolingTempVal) coolingTempVal.textContent = `${tDie.toFixed(0)} °C`;
      if (throughputVal) throughputVal.textContent = `${throughput.toFixed(0)} kg/h`;

      let baseAI = 3.2;
      let baseParallel = 82.0;
      let basePerp = 26.0;
      let gumReq = 0.0;
      let isCleanLabel = true;
      let verdict = '';

      if (feedstock === 'fusarium_venenatum_pure_biomass') {
        baseAI = 3.45;
        baseParallel = 89.2;
        basePerp = 25.8;
        gumReq = 0.0;
        verdict = 'Whole-Cut Chicken Breast Fillet (Striated Longitudinal Muscle Fibers • Natural Chewiness • 0.0% Methylcellulose)';
      } else if (feedstock === 'pea_mycoprotein_hybrid_matrix') {
        baseAI = 3.12;
        baseParallel = 98.4;
        basePerp = 31.5;
        gumReq = 0.0;
        verdict = 'Structured Pulled Pork & Braised Beef Flank (High Shear Resistance • Excellent Pan-Fry Moisture Retention)';
      } else if (feedstock === 'spent_grain_upcycled_mycelium') {
        baseAI = 2.85;
        baseParallel = 76.5;
        basePerp = 26.8;
        gumReq = 0.0;
        verdict = 'Upcycled Spent Grain Beef Stew Chunks (Certified Upcycled • Rich Beta-Glucan Umami • Boiling Resistant)';
      } else if (feedstock === 'faba_mycoprotein_whitefish_matrix') {
        baseAI = 2.65;
        baseParallel = 64.0;
        basePerp = 24.1;
        gumReq = 0.0;
        verdict = 'Flaky Whitefish Cod Fillet (Delicate Laminar Cleavage • Succulent Moisture Release • Phosphate-Free)';
      } else {
        // conventional hazard benchmark
        baseAI = 1.45;
        baseParallel = 46.0;
        basePerp = 31.7;
        gumReq = 3.5;
        isCleanLabel = false;
        verdict = 'Conventional Textured Vegetable Protein Hazard (Isotropic Rubbery Chew • Gummy Film • Contains E461 Gums)';
      }

      // Physics modulation
      // Cavitation enhances defibrillation and entanglement
      const cavFactor = pCav > 0 ? (1 + (pCav - 20) * 0.015) : 0.65;
      // Slit die cooling fixes alignment: optimal cooling around 65-70°C
      const coolingFactor = tDie >= 60 && tDie <= 72 ? 1.05 : (1.0 - Math.abs(tDie - 68) * 0.015);
      // Screw RPM shear alignment
      const rpmFactor = 1.0 + (rpm - 300) * 0.0008;

      let calculatedAI = baseAI * cavFactor * coolingFactor * (isCleanLabel ? 1.0 : 0.6);
      if (calculatedAI < 1.1) calculatedAI = 1.1;
      if (calculatedAI > 4.2) calculatedAI = 4.2;

      const entanglementPct = Math.min(99.2, Math.max(35.0, 75.0 + (pCav * 0.9) - (isCleanLabel ? 0 : 25)));
      const parallelKpa = baseParallel * (calculatedAI / baseAI);
      const perpKpa = basePerp;

      // SME calculation
      const sme = (80.0 + (rpm * 0.05) + (throughput * 0.01) - (mc * 0.25)).toFixed(1);
      const energySavings = isCleanLabel ? ((145.0 - parseFloat(sme)) / 145.0 * 100).toFixed(1) : '0.0';

      // Pressure safety margin
      const barrelPressure = (65.0 + (throughput * 0.04) + (pCav * 0.5) - (mc * 0.3)).toFixed(1);
      const safetyFactor = (180.0 / parseFloat(barrelPressure)).toFixed(1);

      // Render to DOM
      if (telAnisotropy) telAnisotropy.textContent = calculatedAI.toFixed(2);
      if (anisotropyStatus) {
        if (calculatedAI >= 2.8) {
          anisotropyStatus.textContent = 'High Muscle Anisotropy (Meat-Like)';
          anisotropyStatus.className = 'block text-[10px] text-emerald-400 font-semibold mt-0.5';
        } else if (calculatedAI >= 2.0) {
          anisotropyStatus.textContent = 'Moderate Anisotropy (Structured)';
          anisotropyStatus.className = 'block text-[10px] text-amber-400 font-semibold mt-0.5';
        } else {
          anisotropyStatus.textContent = 'Low Anisotropy (Isotropic / Rubbery)';
          anisotropyStatus.className = 'block text-[10px] text-rose-400 font-semibold mt-0.5';
        }
      }

      if (telEntanglement) telEntanglement.textContent = `${entanglementPct.toFixed(1)}%`;
      if (telParallel) telParallel.textContent = `${parallelKpa.toFixed(1)} kPa`;
      if (telPerp) telPerp.textContent = `${perpKpa.toFixed(1)} kPa`;
      if (telGum) {
        telGum.textContent = `${gumReq.toFixed(1)} %`;
        telGum.className = isCleanLabel ? 'text-xl font-extrabold text-emerald-400 font-mono' : 'text-xl font-extrabold text-rose-400 font-mono';
      }
      if (telSme) telSme.textContent = `${sme} kWh/t`;
      if (telSavings) telSavings.textContent = `${energySavings} %`;
      if (telPressureSafety) telPressureSafety.textContent = `SF ${safetyFactor}`;
      if (telVerdict) telVerdict.textContent = verdict;

      if (cleanLabelPill) {
        if (isCleanLabel) {
          cleanLabelPill.textContent = '100% GUM-FREE NATURAL';
          cleanLabelPill.className = 'inline-block px-3 py-1 rounded-full text-xs font-bold bg-emerald-950 text-emerald-300 border border-emerald-800';
        } else {
          cleanLabelPill.textContent = 'SYNTHETIC GUMS PRESENT (E461)';
          cleanLabelPill.className = 'inline-block px-3 py-1 rounded-full text-xs font-bold bg-rose-950 text-rose-300 border border-rose-800';
        }
      }

      // Update SVG
      if (svgCavPressure) svgCavPressure.textContent = `${pCav.toFixed(1)} bar • σ<0.25`;
      if (svgDieTemp) svgDieTemp.textContent = `${tDie.toFixed(0)}°C`;
      if (svgAiText) svgAiText.textContent = `AI = ${calculatedAI.toFixed(2)} (${calculatedAI >= 2.5 ? 'Meat-Like Grain' : 'Isotropic Matrix'})`;

      if (cavitationBubble) {
        const radius = Math.max(2, Math.min(8, 2 + (pCav / 5)));
        cavitationBubble.setAttribute('r', radius.toString());
      }
    }

    // Event listeners
    [screwSpeedInput, moistureInput, cavitationInput, coolingTempInput, throughputInput].forEach(inp => {
      inp?.addEventListener('input', calculateMetrics);
    });

    feedstockSelect?.addEventListener('change', calculateMetrics);
    skidSelect?.addEventListener('change', calculateMetrics);

    // Preset button clicks
    container.querySelectorAll('.preset-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const preset = btn.getAttribute('data-preset');
        if (!feedstockSelect || !screwSpeedInput || !moistureInput || !cavitationInput || !coolingTempInput) return;

        if (preset === 'chicken') {
          feedstockSelect.value = 'fusarium_venenatum_pure_biomass';
          screwSpeedInput.value = '320';
          moistureInput.value = '68.0';
          cavitationInput.value = '22.0';
          coolingTempInput.value = '68';
        } else if (preset === 'pork') {
          feedstockSelect.value = 'pea_mycoprotein_hybrid_matrix';
          screwSpeedInput.value = '360';
          moistureInput.value = '64.0';
          cavitationInput.value = '26.5';
          coolingTempInput.value = '72';
        } else if (preset === 'spent_grain') {
          feedstockSelect.value = 'spent_grain_upcycled_mycelium';
          screwSpeedInput.value = '280';
          moistureInput.value = '62.0';
          cavitationInput.value = '28.0';
          coolingTempInput.value = '64';
        } else if (preset === 'fish') {
          feedstockSelect.value = 'faba_mycoprotein_whitefish_matrix';
          screwSpeedInput.value = '240';
          moistureInput.value = '70.0';
          cavitationInput.value = '20.0';
          coolingTempInput.value = '60';
        } else if (preset === 'synthetic_hazard') {
          feedstockSelect.value = 'conventional_chemical_benchmark_hazard';
          screwSpeedInput.value = '220';
          moistureInput.value = '65.0';
          cavitationInput.value = '0.0';
          coolingTempInput.value = '82';
        }
        calculateMetrics();
      });
    });

    // Export button
    container.querySelector('#export-report-btn')?.addEventListener('click', () => {
      const data = {
        tool: 'Commercial Continuous High-Shear Slit-Die Extrusion & Hydrodynamic Cavitation Mycoprotein Texturizing (HSE-HCT) Modeler',
        timestamp: new Date().toISOString(),
        skid: skidSelect?.value,
        feedstock: feedstockSelect?.value,
        parameters: {
          screwSpeedRpm: screwSpeedInput?.value,
          moisturePct: moistureInput?.value,
          cavitationPressureBar: cavitationInput?.value,
          coolingDieTempCelsius: coolingTempInput?.value,
          throughputKgH: throughputInput?.value
        },
        telemetry: {
          anisotropyIndex: telAnisotropy?.textContent,
          hyphalEntanglement: telEntanglement?.textContent,
          tensileStrengthParallel: telParallel?.textContent,
          tensileStrengthPerpendicular: telPerp?.textContent,
          bindingGumRequirement: telGum?.textContent,
          specificMechanicalEnergy: telSme?.textContent,
          energySavingsVsTvp: telSavings?.textContent,
          asmeBarrelSafetyFactor: telPressureSafety?.textContent,
          verdict: telVerdict?.textContent
        },
        regulatoryCompliance: [
          'FDA 21 CFR § 170.36 GRAS (GRN 000091)',
          'FDA 21 CFR § 117 FSMA cGMP',
          'ASME BPVC Section VIII Div 1 (180 bar design pressure)',
          '3-A Sanitary Standards 60-01',
          'Clean Label (0.0% Methylcellulose E461 / 0.0% Egg Albumen)'
        ]
      };

      const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `hse-hct-mycoprotein-audit-${Date.now()}.json`;
      a.click();
      URL.revokeObjectURL(url);
    });

    // Initial calculation
    calculateMetrics();
  }

  // Initialize on DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHseHctModeler);
  } else {
    initHseHctModeler();
  }
</script>
