    rule2Text: "FDA cGMP基準において、主乾燥期間中の原料昇華前線温度は崩壊温度（Tc）を絶対に超えてはなりません。微小崩壊が発生すると毛細管細孔が閉塞し、残留水分（>4%）が閉じ込められて常温保存時の劣化や失活を引き起こします。",
    rule3Title: "排気ダクト音速チョーク制限（Mach 1.0 Limit）と圧力サージ",
    rule3Text: "0.10 mbarの高真空下において、1 kgの氷が昇華すると10,000 m³を超える水蒸気に膨張します。昇華速度がダクトの音速限界（マッハ数0.90以上）を超えると気体が排気されずチャンバーに滞留し、急激な真空破壊とバッチ融解を招きます。",
    rule4Title: "トラップ着氷断熱と交互自動除霜（ISO 13408-3）",
    rule4Text: "トラップコイル上の着氷が25 mmを超えると、氷の低い熱伝導率（k_ice ≈ 2.2 W/m·K）が断熱層となり表面温度が上昇します。連続運転機ではホットガス等によるデュアル交互切り替え除霜システムが必須となります。",
    copyReportBtn: "診断レポートをコピー",
    copiedFeedback: "レポートをクリップボードにコピーしました！"
  }
};

const d = DICTIONARY[lang] || DICTIONARY.en;
---

<div class="freeze-drying-modeler bg-surface border border-hairline rounded-3xl p-6 sm:p-8 shadow-xs">
  <!-- Header -->
  <div class="flex flex-wrap items-center justify-between gap-3 mb-6 pb-6 border-b border-hairline/60">
    <div>
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-cyan-700 text-white">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
        </svg>
        {d.badge}
      </span>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-ink tracking-tight mt-2">{d.title}</h2>
      <p class="text-xs sm:text-sm text-muted mt-1 max-w-3xl leading-relaxed">{d.subtitle}</p>
    </div>
    <div class="flex items-center gap-2">
      <button 
        type="button" 
        id="fd-copy-report-btn" 
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-semibold bg-surface-soft hover:bg-surface-elevated text-ink border border-hairline transition-all shadow-2xs cursor-pointer"
      >
        <svg class="w-4 h-4 text-cyan-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
        </svg>
        <span id="fd-copy-text">{d.copyReportBtn}</span>
      </button>
    </div>
  </div>

  <!-- Quick Presets -->
  <div class="mb-8 p-4 bg-surface-soft rounded-2xl border border-hairline/80">
    <div class="text-xs font-bold uppercase tracking-wider text-muted mb-2.5 flex items-center gap-1.5">
      <svg class="w-4 h-4 text-cyan-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
      </svg>
      {d.presetsTitle}
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2">
      <button type="button" class="fd-preset-btn p-2.5 rounded-xl text-left bg-surface hover:bg-cyan-50/50 border border-hairline transition-all text-xs font-medium text-ink cursor-pointer" data-preset="probiotic">
        🌱 {d.presetProbiotic}
      </button>
      <button type="button" class="fd-preset-btn p-2.5 rounded-xl text-left bg-surface hover:bg-cyan-50/50 border border-hairline transition-all text-xs font-medium text-ink cursor-pointer" data-preset="berry">
        🍓 {d.presetBerry}
      </button>
      <button type="button" class="fd-preset-btn p-2.5 rounded-xl text-left bg-surface hover:bg-cyan-50/50 border border-hairline transition-all text-xs font-medium text-ink cursor-pointer" data-preset="poultry">
        🍗 {d.presetPoultry}
      </button>
      <button type="button" class="fd-preset-btn p-2.5 rounded-xl text-left bg-surface hover:bg-rose-50/50 border border-rose-300 text-rose-900 transition-all text-xs font-medium cursor-pointer" data-preset="catastrophic">
        ⚠️ {d.presetCatastrophic}
      </button>
    </div>
  </div>

  <!-- Interactive Controls Section -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-8">
    <div class="lg:col-span-6 space-y-5">
      <div class="pb-2 border-b border-hairline/60">
        <h3 class="text-base font-bold text-ink flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-cyan-700"></span>
          {d.controlsTitle}
        </h3>
        <p class="text-xs text-muted mt-0.5">{d.controlsSub}</p>
      </div>

      <!-- Tunnel Selector -->
      <div>
        <label for="fd-tunnel-select" class="block text-xs font-bold text-ink mb-1">{d.machineLabel}</label>
        <select id="fd-tunnel-select" class="w-full text-xs font-medium bg-surface border border-hairline rounded-xl p-2.5 text-ink focus:outline-none focus:ring-2 focus:ring-cyan-700">
          {freezeDryingData.tunnelSystems.map(t => (
            <option value={t.id} selected={t.id === 'industrial_bulk_food_tunnel'}>
              {t.name}
            </option>
          ))}
        </select>
        <p class="text-2xs text-muted mt-1">{d.machineHelp}</p>
      </div>

      <!-- Product Selector -->
      <div>
        <label for="fd-product-select" class="block text-xs font-bold text-ink mb-1">{d.productLabel}</label>
        <select id="fd-product-select" class="w-full text-xs font-medium bg-surface border border-hairline rounded-xl p-2.5 text-ink focus:outline-none focus:ring-2 focus:ring-cyan-700">
          {freezeDryingData.targetProducts.map(p => (
            <option value={p.id} selected={p.id === 'probiotics_starter_cultures'}>
              {p.name}
            </option>
          ))}
        </select>
        <p class="text-2xs text-muted mt-1">{d.productHelp}</p>
      </div>

      <!-- Thermal Fluid & Condenser Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="fd-fluid-select" class="block text-xs font-bold text-ink mb-1">{d.fluidLabel}</label>
          <select id="fd-fluid-select" class="w-full text-xs font-medium bg-surface border border-hairline rounded-xl p-2 text-ink focus:outline-none focus:ring-2 focus:ring-cyan-700">
            {freezeDryingData.glycolThermalFluids.map(f => (
              <option value={f.id}>{f.name}</option>
            ))}
          </select>
          <p class="text-2xs text-muted mt-1">{d.fluidHelp}</p>
        </div>
        <div>
          <label for="fd-condenser-select" class="block text-xs font-bold text-ink mb-1">{d.condenserLabel}</label>
          <select id="fd-condenser-select" class="w-full text-xs font-medium bg-surface border border-hairline rounded-xl p-2 text-ink focus:outline-none focus:ring-2 focus:ring-cyan-700">
            {freezeDryingData.vacuumCondenserStates.map(c => (
              <option value={c.id} selected={c.id === 'pristine_defrosted'}>
                {c.id.replace(/_/g, ' ').toUpperCase()} ({c.iceThicknessMm} mm ice, U={c.overallHeatTransferU})
              </option>
            ))}
          </select>
          <p class="text-2xs text-muted mt-1">{d.condenserHelp}</p>
        </div>
      </div>

      <!-- Chamber Vacuum Pressure Slider -->
      <div class="bg-surface-soft p-3.5 rounded-2xl border border-hairline">
        <div class="flex justify-between items-center mb-1">
          <label for="fd-chamber-press" class="text-xs font-bold text-ink">{d.chamberPressureLabel}</label>
          <span id="fd-chamber-press-val" class="font-mono text-xs font-bold text-cyan-800 bg-cyan-50 px-2 py-0.5 rounded border border-cyan-200">0.10 mbar</span>
        </div>
        <input type="range" id="fd-chamber-press" min="0.02" max="0.45" step="0.01" value="0.10" class="w-full accent-cyan-700 cursor-pointer" />
        <p class="text-2xs text-muted mt-1">{d.chamberPressureHelp}</p>
      </div>

      <!-- Platen Temperature Sliders -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="bg-surface-soft p-3.5 rounded-2xl border border-hairline">
          <div class="flex justify-between items-center mb-1">
            <label for="fd-shelf-temp" class="text-xs font-bold text-ink">{d.zoneShelfTempLabel}</label>
            <span id="fd-shelf-temp-val" class="font-mono text-xs font-bold text-cyan-800 bg-cyan-50 px-2 py-0.5 rounded border border-cyan-200">+15.0°C</span>
          </div>
          <input type="range" id="fd-shelf-temp" min="-20" max="50" step="1" value="15" class="w-full accent-cyan-700 cursor-pointer" />
          <p class="text-2xs text-muted mt-1">{d.zoneShelfTempHelp}</p>
        </div>
        <div class="bg-surface-soft p-3.5 rounded-2xl border border-hairline">
          <div class="flex justify-between items-center mb-1">
            <label for="fd-desorp-temp" class="text-xs font-bold text-ink">{d.secondaryDesorpTempLabel}</label>
            <span id="fd-desorp-temp-val" class="font-mono text-xs font-bold text-cyan-800 bg-cyan-50 px-2 py-0.5 rounded border border-cyan-200">+35.0°C</span>
          </div>
          <input type="range" id="fd-desorp-temp" min="20" max="60" step="1" value="35" class="w-full accent-cyan-700 cursor-pointer" />
          <p class="text-2xs text-muted mt-1">{d.secondaryDesorpTempHelp}</p>
        </div>
      </div>
    </div>

    <!-- Right Controls Column -->
    <div class="lg:col-span-6 space-y-5">
      <!-- Residence Time Slider -->
      <div class="bg-surface-soft p-3.5 rounded-2xl border border-hairline">
        <div class="flex justify-between items-center mb-1">
          <label for="fd-residence-time" class="text-xs font-bold text-ink">{d.residenceTimeLabel}</label>
          <span id="fd-residence-time-val" class="font-mono text-xs font-bold text-cyan-800 bg-cyan-50 px-2 py-0.5 rounded border border-cyan-200">14.0 hrs</span>
        </div>
        <input type="range" id="fd-residence-time" min="4" max="28" step="0.5" value="14.0" class="w-full accent-cyan-700 cursor-pointer" />
        <p class="text-2xs text-muted mt-1">{d.residenceTimeHelp}</p>
      </div>

      <!-- Tray Loading Depth Slider -->
      <div class="bg-surface-soft p-3.5 rounded-2xl border border-hairline">
        <div class="flex justify-between items-center mb-1">
          <label for="fd-tray-depth" class="text-xs font-bold text-ink">{d.trayDepthLabel}</label>
          <span id="fd-tray-depth-val" class="font-mono text-xs font-bold text-cyan-800 bg-cyan-50 px-2 py-0.5 rounded border border-cyan-200">18 mm</span>
        </div>
        <input type="range" id="fd-tray-depth" min="6" max="40" step="1" value="18" class="w-full accent-cyan-700 cursor-pointer" />
        <p class="text-2xs text-muted mt-1">{d.trayDepthHelp}</p>
      </div>

      <!-- Vapor Duct Diameter & Airlock Vacuum Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="bg-surface-soft p-3.5 rounded-2xl border border-hairline">
          <div class="flex justify-between items-center mb-1">
            <label for="fd-duct-diam" class="text-xs font-bold text-ink">{d.ductDiameterLabel}</label>
            <span id="fd-duct-diam-val" class="font-mono text-xs font-bold text-cyan-800 bg-cyan-50 px-2 py-0.5 rounded border border-cyan-200">850 mm</span>
          </div>
          <input type="range" id="fd-duct-diam" min="300" max="1000" step="25" value="850" class="w-full accent-cyan-700 cursor-pointer" />
          <p class="text-2xs text-muted mt-1">{d.ductDiameterHelp}</p>
        </div>
        <div class="bg-surface-soft p-3.5 rounded-2xl border border-hairline">
          <div class="flex justify-between items-center mb-1">
            <label for="fd-airlock-vac" class="text-xs font-bold text-ink">{d.airlockVacLabel}</label>
            <span id="fd-airlock-vac-val" class="font-mono text-xs font-bold text-cyan-800 bg-cyan-50 px-2 py-0.5 rounded border border-cyan-200">0.50 mbar</span>
          </div>
          <input type="range" id="fd-airlock-vac" min="0.2" max="4.0" step="0.1" value="0.5" class="w-full accent-cyan-700 cursor-pointer" />
          <p class="text-2xs text-muted mt-1">{d.airlockVacHelp}</p>
        </div>
      </div>

      <!-- Engineering Toggles -->
      <div class="p-4 bg-surface-soft rounded-2xl border border-hairline space-y-3">
        <label class="flex items-start gap-3 cursor-pointer">
          <input type="checkbox" id="fd-condenser-toggle" class="mt-1 h-4 w-4 rounded border-hairline text-cyan-700 focus:ring-cyan-600 accent-cyan-700" checked />
          <div>
            <span class="text-xs font-bold text-ink block">{d.condenserToggleLabel}</span>
            <span class="text-2xs text-muted block leading-tight">{d.condenserToggleHelp}</span>
          </div>
        </label>
        <label class="flex items-start gap-3 cursor-pointer">
          <input type="checkbox" id="fd-glycol-toggle" class="mt-1 h-4 w-4 rounded border-hairline text-cyan-700 focus:ring-cyan-600 accent-cyan-700" checked />
          <div>
            <span class="text-xs font-bold text-ink block">{d.glycolToggleLabel}</span>
            <span class="text-2xs text-muted block leading-tight">{d.glycolToggleHelp}</span>
          </div>
        </label>
      </div>

      <!-- Tunnel Architecture Dynamic SVG Visualizer -->
      <div class="p-4 bg-slate-900 rounded-2xl border border-slate-800 text-slate-100">
        <div class="text-2xs font-mono uppercase text-slate-400 mb-2 flex items-center justify-between">
          <span>Continuous Lyophilization Tunnel Dynamic Schematic</span>
          <span id="fd-svg-status-pill" class="px-2 py-0.5 rounded text-3xs font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/40">SUB-SONIC FLOW</span>
        </div>
        <svg class="w-full h-44 rounded bg-slate-950 border border-slate-800" viewBox="0 0 600 200" fill="none" xmlns="http://www.w3.org/2000/svg">
          <!-- Main Tunnel Shell -->
          <rect x="70" y="55" width="460" height="90" rx="8" fill="#0f172a" stroke="#334155" stroke-width="2" />
          
          <!-- Infeed Airlock Gate -->
          <rect x="25" y="65" width="40" height="70" rx="4" fill="#1e293b" stroke="#0284c7" stroke-width="1.5" />
          <line x1="65" y1="65" x2="65" y2="135" stroke="#38bdf8" stroke-width="3" id="fd-gate-in" />
          <text x="30" y="105" fill="#94a3b8" font-family="monospace" font-size="8">AIRLOCK</text>

          <!-- Outfeed Airlock Gate -->
          <rect x="535" y="65" width="40" height="70" rx="4" fill="#1e293b" stroke="#0284c7" stroke-width="1.5" />
          <line x1="535" y1="65" x2="535" y2="135" stroke="#38bdf8" stroke-width="3" id="fd-gate-out" />
          <text x="540" y="105" fill="#94a3b8" font-family="monospace" font-size="8">DISCHARGE</text>

          <!-- Heated Shelf Platens (Zone 1, Zone 2, Zone 3) -->
          <rect x="80" y="125" width="135" height="12" rx="2" fill="#0369a1" stroke="#38bdf8" stroke-width="1" />
          <rect x="225" y="125" width="145" height="12" rx="2" fill="#0284c7" stroke="#38bdf8" stroke-width="1" />
          <rect x="380" y="125" width="140" height="12" rx="2" fill="#0ea5e9" stroke="#38bdf8" stroke-width="1" />
          <text x="110" y="134" fill="#bae6fd" font-family="monospace" font-size="7">ZONE 1 (SUBLIMATION)</text>
          <text x="255" y="134" fill="#bae6fd" font-family="monospace" font-size="7">ZONE 2 (CORE DRY)</text>
          <text x="410" y="134" fill="#bae6fd" font-family="monospace" font-size="7">ZONE 3 (DESORPTION)</text>

          <!-- Conveyor Tray Carrier & Product Trays -->
          <line x1="75" y1="120" x2="525" y2="120" stroke="#64748b" stroke-width="2" stroke-dasharray="4 2" />
          <g id="fd-trays-group">
            <rect x="90" y="108" width="30" height="10" rx="1" fill="#f8fafc" stroke="#94a3b8" />
            <rect x="140" y="108" width="30" height="10" rx="1" fill="#f8fafc" stroke="#94a3b8" />
            <rect x="190" y="108" width="30" height="10" rx="1" fill="#f1f5f9" stroke="#94a3b8" />
            <rect x="240" y="108" width="30" height="10" rx="1" fill="#e2e8f0" stroke="#94a3b8" />
            <rect x="290" y="108" width="30" height="10" rx="1" fill="#e2e8f0" stroke="#94a3b8" />
            <rect x="340" y="108" width="30" height="10" rx="1" fill="#cbd5e1" stroke="#94a3b8" />
            <rect x="390" y="108" width="30" height="10" rx="1" fill="#94a3b8" stroke="#64748b" />
            <rect x="440" y="108" width="30" height="10" rx="1" fill="#64748b" stroke="#475569" />
            <rect x="485" y="108" width="30" height="10" rx="1" fill="#475569" stroke="#334155" />
          </g>

          <!-- Subliming Vapor Arrows Rising Upwards -->
          <g id="fd-vapor-arrows" stroke="#38bdf8" stroke-width="1.5" stroke-dasharray="3 3">
            <line x1="150" y1="102" x2="150" y2="75" />
            <line x1="250" y1="102" x2="250" y2="60" />
            <line x1="330" y1="102" x2="330" y2="65" />
          </g>

          <!-- Overhead Vapor Duct to External Condenser -->
          <path d="M 230 55 L 230 25 L 370 25 L 370 55 Z" fill="#1e293b" stroke="#64748b" stroke-width="1.5" id="fd-vapor-duct-svg" />
          <text x="250" y="38" fill="#38bdf8" font-family="monospace" font-size="8" font-weight="bold" id="fd-mach-svg-text">VAPOR DUCT M = 0.42</text>

          <!-- External Cryogenic Condenser Chamber -->
          <rect x="260" y="5" width="80" height="20" rx="3" fill="#0284c7" stroke="#38bdf8" stroke-width="1" />
          <text x="270" y="18" fill="#ffffff" font-family="monospace" font-size="7">CONDENSER -65°C</text>
        </svg>
      </div>
    </div>
  </div>

  <!-- Real-Time Diagnostic Telemetry Readout Grid -->
  <div class="mb-8 p-6 bg-surface-soft rounded-3xl border border-hairline">
    <div class="pb-3 border-b border-hairline/60 mb-5 flex flex-wrap items-center justify-between gap-2">
      <div>
        <h3 class="text-base font-bold text-ink">{d.diagnosticTitle}</h3>
        <p class="text-xs text-muted">{d.diagnosticSub}</p>
      </div>
      <div id="fd-compliance-badge" class="px-3 py-1 rounded-full text-xs font-extrabold uppercase tracking-wider bg-emerald-100 text-emerald-800 border border-emerald-300">
        OPTIMAL COMPLIANCE
      </div>
    </div>

    <!-- Core Metrics 4-Column Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-5">
      <div class="p-3.5 bg-surface rounded-2xl border border-hairline">
        <span class="text-2xs font-semibold text-muted block mb-1">{d.sublimationTempLabel}</span>
        <span id="fd-sublimation-temp" class="text-lg sm:text-xl font-extrabold text-cyan-800 font-mono">-26.4°C</span>
        <span class="text-3xs text-muted block mt-0.5">Clausius-Clapeyron Equilibrium</span>
      </div>

      <div class="p-3.5 bg-surface rounded-2xl border border-hairline">
        <span class="text-2xs font-semibold text-muted block mb-1">{d.collapseMarginLabel}</span>
        <span id="fd-collapse-margin" class="text-lg sm:text-xl font-extrabold text-emerald-700 font-mono">+2.6°C</span>
        <span class="text-3xs text-muted block mt-0.5">Tc Margin: Safe Threshold</span>
      </div>

      <div class="p-3.5 bg-surface rounded-2xl border border-hairline">
        <span class="text-2xs font-semibold text-muted block mb-1">{d.sublimationFluxLabel}</span>
        <span id="fd-sublimation-flux" class="text-lg sm:text-xl font-extrabold text-ink font-mono">0.82 kg/m²·h</span>
        <span class="text-3xs text-muted block mt-0.5">Knudsen Rarefied Vapor Rate</span>
      </div>

      <div class="p-3.5 bg-surface rounded-2xl border border-hairline">
        <span class="text-2xs font-semibold text-muted block mb-1">{d.vaporMachLabel}</span>
        <span id="fd-vapor-mach" class="text-lg sm:text-xl font-extrabold text-ink font-mono">164 m/s (M 0.42)</span>
        <span class="text-3xs text-muted block mt-0.5">Sonic Choke Limit: M &lt; 0.85</span>
      </div>
    </div>

    <!-- Secondary Metrics 4-Column Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
      <div class="p-3.5 bg-surface rounded-2xl border border-hairline">
        <span class="text-2xs font-semibold text-muted block mb-1">{d.glycolDeltaLabel}</span>
        <span id="fd-glycol-delta" class="text-sm sm:text-base font-bold text-ink font-mono">0.85°C</span>
        <span class="text-3xs text-muted block mt-0.5">Platen Cross-Flow Gradient</span>
      </div>

      <div class="p-3.5 bg-surface rounded-2xl border border-hairline">
        <span class="text-2xs font-semibold text-muted block mb-1">{d.finalMoistureLabel}</span>
        <span id="fd-final-moisture" class="text-sm sm:text-base font-bold text-ink font-mono">1.6%</span>
        <span class="text-3xs text-muted block mt-0.5">Target Spec: &lt; 2.0%</span>
      </div>

      <div class="p-3.5 bg-surface rounded-2xl border border-hairline">
        <span class="text-2xs font-semibold text-muted block mb-1">{d.waterActivityLabel}</span>
        <span id="fd-water-activity" class="text-sm sm:text-base font-bold text-ink font-mono">0.14 a_w</span>
        <span class="text-3xs text-muted block mt-0.5">Microbial Stability: Aw &lt; 0.20</span>
      </div>

      <div class="p-3.5 bg-surface rounded-2xl border border-hairline">
        <span class="text-2xs font-semibold text-muted block mb-1">{d.condenserSurfaceLabel}</span>
        <span id="fd-condenser-surf-temp" class="text-sm sm:text-base font-bold text-ink font-mono">-61.4°C</span>
        <span class="text-3xs text-muted block mt-0.5">Ice Frost Surface Equil.</span>
      </div>
    </div>

    <!-- Hazard Alert & Engineering Action Directives -->
    <div id="fd-alert-box" class="p-4 rounded-2xl border bg-emerald-50/70 border-emerald-200 text-emerald-950 transition-all">
      <div class="flex items-center gap-2 mb-1.5">
        <span id="fd-alert-icon" class="text-base">✅</span>
        <h4 id="fd-alert-title" class="text-xs font-bold uppercase tracking-wider text-emerald-900">
          STABLE CRYOGENIC SUBLIMATION &amp; DEEP VACUUM CONFORMITY
        </h4>
      </div>
      <div class="text-xs space-y-1.5 text-emerald-900/90 leading-relaxed">
        <p><strong>{d.primaryRiskLabel}</strong> <span id="fd-alert-risk">No active structural collapse or sonic vapor duct choking detected. Sublimation front remains securely below critical matrix threshold.</span></p>
        <p><strong>{d.mechanismsLabel}</strong> <span id="fd-alert-mechanism">Continuous radiant and contact platen heat transfer is precisely counterbalanced by latent heat consumption of ice sublimation (ΔH_sub = 2838 kJ/kg). Knudsen vapor diffusion maintains pore structural rigidity.</span></p>
        <p><strong>{d.mitigationLabel}</strong> <span id="fd-alert-action">Maintain steady continuous conveyor speed. Keep alternating cryogenic ice condensers synchronized with automated hot-gas defrost schedules.</span></p>
      </div>
    </div>
  </div>

  <!-- Engineering Data Table Comparison -->
  <div class="mb-8">
    <div class="pb-2 border-b border-hairline/60 mb-4">
      <h3 class="text-base font-bold text-ink">{d.tableTitle}</h3>
      <p class="text-xs text-muted">{d.tableSub}</p>
    </div>
    <div class="overflow-x-auto rounded-2xl border border-hairline">
      <table class="w-full text-left text-xs text-ink">
        <thead class="bg-surface-soft text-muted font-semibold uppercase text-3xs border-b border-hairline">
          <tr>
            <th class="p-3">{d.colModel}</th>
            <th class="p-3">{d.colClass}</th>
            <th class="p-3">{d.colCapacity}</th>
            <th class="p-3">{d.colPressure}</th>
            <th class="p-3">{d.colCondenser}</th>
            <th class="p-3">{d.colDuct}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline">
          {freezeDryingData.tunnelSystems.map(t => (
            <tr class="hover:bg-surface-soft/50 transition-colors">
              <td class="p-3 font-semibold text-ink">{t.name.split(' (')[0]}</td>
              <td class="p-3 text-muted">{t.classification.split(' (')[0]}</td>
              <td class="p-3 font-mono text-cyan-800">{t.nominalCapacityKgPerHour} kg/h</td>
              <td class="p-3 font-mono">{t.operatingChamberPressureMbar} mbar</td>
              <td class="p-3 font-mono">{t.condenserBaseTempC}°C ({t.condenserSurfaceAreaM2} m²)</td>
              <td class="p-3 font-mono">{t.vaporDuctDiameterMm} mm</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Regulatory Compliance Cards -->
  <div>
    <div class="pb-2 border-b border-hairline/60 mb-4">
      <h3 class="text-base font-bold text-ink">{d.rulesTitle}</h3>
      <p class="text-xs text-muted">{d.rulesSub}</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="p-4 rounded-2xl bg-surface-soft border border-hairline">
        <h4 class="text-xs font-bold text-ink mb-1.5 flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-cyan-700"></span>
          {d.rule1Title}
        </h4>
        <p class="text-2xs text-muted leading-relaxed">{d.rule1Text}</p>
      </div>

      <div class="p-4 rounded-2xl bg-surface-soft border border-hairline">
        <h4 class="text-xs font-bold text-ink mb-1.5 flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-cyan-700"></span>
          {d.rule2Title}
        </h4>
        <p class="text-2xs text-muted leading-relaxed">{d.rule2Text}</p>
      </div>

      <div class="p-4 rounded-2xl bg-surface-soft border border-hairline">
        <h4 class="text-xs font-bold text-ink mb-1.5 flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-cyan-700"></span>
          {d.rule3Title}
        </h4>
        <p class="text-2xs text-muted leading-relaxed">{d.rule3Text}</p>
      </div>

      <div class="p-4 rounded-2xl bg-surface-soft border border-hairline">
        <h4 class="text-xs font-bold text-ink mb-1.5 flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-cyan-700"></span>
          {d.rule4Title}
        </h4>
        <p class="text-2xs text-muted leading-relaxed">{d.rule4Text}</p>
      </div>
    </div>
  </div>
</div>

<script>
  function initFreezeDryingModeler() {
    const rawData = {
      tunnels: {
        pilot_cryo_tunnel: { capacity: 150, baseP: 0.08, condT: -55, ductD: 450, condArea: 45 },
        industrial_bulk_food_tunnel: { capacity: 1200, baseP: 0.12, condT: -65, ductD: 900, condArea: 240 },
        ultra_aseptic_pharma_tunnel: { capacity: 350, baseP: 0.05, condT: -80, ductD: 650, condArea: 110 },
        compromised_choked_tunnel: { capacity: 900, baseP: 0.42, condT: -38, ductD: 500, condArea: 160 }
      },
      products: {
        probiotics_starter_cultures: { tc: -29.0, moisture: 82.0, targetM: 1.8, targetAw: 0.15, rp0: 1.45e4 },
        strawberries_whole_berries: { tc: -21.0, moisture: 89.5, targetM: 2.5, targetAw: 0.20, rp0: 2.10e4 },
        shredded_cooked_poultry: { tc: -15.5, moisture: 74.0, targetM: 1.9, targetAw: 0.18, rp0: 0.85e4 },
        marine_extracts_enzymes: { tc: -26.5, moisture: 84.5, targetM: 1.5, targetAw: 0.12, rp0: 1.80e4 }
      },
      condensers: {
        pristine_defrosted: { iceThick: 2.0, u: 380 },
        moderate_ice_cake: { iceThick: 16.0, u: 210 },
        heavy_ice_insulation: { iceThick: 38.0, u: 85 }
      }
    };

    // Elements
    const tunnelSelect = document.getElementById('fd-tunnel-select') as HTMLSelectElement | null;
    const productSelect = document.getElementById('fd-product-select') as HTMLSelectElement | null;
    const fluidSelect = document.getElementById('fd-fluid-select') as HTMLSelectElement | null;
    const condenserSelect = document.getElementById('fd-condenser-select') as HTMLSelectElement | null;

    const chamberPress = document.getElementById('fd-chamber-press') as HTMLInputElement | null;
    const chamberPressVal = document.getElementById('fd-chamber-press-val');
    const shelfTemp = document.getElementById('fd-shelf-temp') as HTMLInputElement | null;
    const shelfTempVal = document.getElementById('fd-shelf-temp-val');
    const desorpTemp = document.getElementById('fd-desorp-temp') as HTMLInputElement | null;
    const desorpTempVal = document.getElementById('fd-desorp-temp-val');
    const residenceTime = document.getElementById('fd-residence-time') as HTMLInputElement | null;
    const residenceTimeVal = document.getElementById('fd-residence-time-val');
    const trayDepth = document.getElementById('fd-tray-depth') as HTMLInputElement | null;
    const trayDepthVal = document.getElementById('fd-tray-depth-val');
    const ductDiam = document.getElementById('fd-duct-diam') as HTMLInputElement | null;
    const ductDiamVal = document.getElementById('fd-duct-diam-val');
    const airlockVac = document.getElementById('fd-airlock-vac') as HTMLInputElement | null;
    const airlockVacVal = document.getElementById('fd-airlock-vac-val');

    const condenserToggle = document.getElementById('fd-condenser-toggle') as HTMLInputElement | null;
    const glycolToggle = document.getElementById('fd-glycol-toggle') as HTMLInputElement | null;

    // Telemetry display elements
    const subTempDisp = document.getElementById('fd-sublimation-temp');
    const collapseMarginDisp = document.getElementById('fd-collapse-margin');
    const subFluxDisp = document.getElementById('fd-sublimation-flux');
    const vaporMachDisp = document.getElementById('fd-vapor-mach');
    const glycolDeltaDisp = document.getElementById('fd-glycol-delta');
    const finalMoistDisp = document.getElementById('fd-final-moisture');
    const waterActDisp = document.getElementById('fd-water-activity');
    const condSurfDisp = document.getElementById('fd-condenser-surf-temp');
    const complianceBadge = document.getElementById('fd-compliance-badge');

    const alertBox = document.getElementById('fd-alert-box');
    const alertIcon = document.getElementById('fd-alert-icon');
    const alertTitle = document.getElementById('fd-alert-title');
    const alertRisk = document.getElementById('fd-alert-risk');
    const alertMechanism = document.getElementById('fd-alert-mechanism');
    const alertAction = document.getElementById('fd-alert-action');

    const svgStatusPill = document.getElementById('fd-svg-status-pill');
    const machSvgText = document.getElementById('fd-mach-svg-text');
    const copyReportBtn = document.getElementById('fd-copy-report-btn');
    const copyText = document.getElementById('fd-copy-text');

    if (!tunnelSelect || !productSelect || !chamberPress) return;

    function recalculate() {
      const tunnelId = tunnelSelect?.value || 'industrial_bulk_food_tunnel';
      const prodId = productSelect?.value || 'probiotics_starter_cultures';
      const condId = condenserSelect?.value || 'pristine_defrosted';

      const tunnel = rawData.tunnels[tunnelId as keyof typeof rawData.tunnels] || rawData.tunnels.industrial_bulk_food_tunnel;
      const prod = rawData.products[prodId as keyof typeof rawData.products] || rawData.products.probiotics_starter_cultures;
      const cond = rawData.condensers[condId as keyof typeof rawData.condensers] || rawData.condensers.pristine_defrosted;

      const pChamber = parseFloat(chamberPress?.value || '0.10');
      const tShelf = parseFloat(shelfTemp?.value || '15');
      const tDesorp = parseFloat(desorpTemp?.value || '35');
      const tResidence = parseFloat(residenceTime?.value || '14');
      const dTray = parseFloat(trayDepth?.value || '18');
      const dDuct = parseFloat(ductDiam?.value || '850');
      const pAirlock = parseFloat(airlockVac?.value || '0.5');

      const isDualCondenser = condenserToggle?.checked ?? true;
      const isGlycolBalanced = glycolToggle?.checked ?? true;

      // Update slider value labels
      if (chamberPressVal) chamberPressVal.textContent = `${pChamber.toFixed(2)} mbar`;
      if (shelfTempVal) shelfTempVal.textContent = `${tShelf > 0 ? '+' : ''}${tShelf.toFixed(1)}°C`;
      if (desorpTempVal) desorpTempVal.textContent = `+${tDesorp.toFixed(1)}°C`;
      if (residenceTimeVal) residenceTimeVal.textContent = `${tResidence.toFixed(1)} hrs`;
      if (trayDepthVal) trayDepthVal.textContent = `${dTray} mm`;
      if (ductDiamVal) ductDiamVal.textContent = `${dDuct} mm`;
      if (airlockVacVal) airlockVacVal.textContent = `${pAirlock.toFixed(2)} mbar`;

      // 1. Ice Sublimation Temperature (T_sub) via Clausius-Clapeyron Equilibrium
      // P_sat(T) = 611.65 * exp(22.5 * (T - 273.16) / (T - 0.7)) Pa
      // Invert approximately for P_ice = P_chamber + ΔP_resistance
      const pPa = pChamber * 100.0;
      // Driving pressure at ice interface slightly higher than chamber due to dry cake vapor resistance
      const cakeResistanceFactor = 1.0 + (dTray / 20.0) * (prod.rp0 / 1.5e4) * 0.45;
      const pInterfacePa = pPa * cakeResistanceFactor;
      
      // Clausius-Clapeyron inverted: T(K) approx from saturation vapor pressure
      // Log approx: ln(P/611.65) = A * (T - 273.15) / (T - C)
      const lnP = Math.log(Math.max(pInterfacePa, 1.0) / 611.65);
      const tSubKelvin = 273.16 + (lnP * 272.46) / (22.5 - lnP);
      let tSubC = tSubKelvin - 273.15;

      // Platen heating influence: shelf adds sensible heat conducting into ice core
      const platenThermalLeak = Math.max(0, (tShelf - tSubC) * 0.08);
      tSubC += platenThermalLeak;

      // 2. Critical Collapse Margin (ΔT_collapse = Tc - T_sub)
      const collapseMargin = prod.tc - tSubC; // Positive = safe, Negative = collapse!

      // 3. Sublimation Flux (J_sub, kg/m²·h)
      // Driving force ΔP = (P_sat(T_sub) - P_chamber) / Rp
      const pSatSubPa = 611.65 * Math.exp((22.5 * tSubC) / (tSubC + 272.46));
      const deltaP = Math.max(2.0, pSatSubPa - pPa);
      let jSub = (deltaP / (prod.rp0 * (dTray / 15.0))) * 3600.0;
      jSub = Math.min(2.8, Math.max(0.15, jSub));

      // 4. Vapor Duct Flow Velocity & Mach Number
      // Volumetric flow Q = (mass_rate * R * T) / (P * M_w)
      // Speed of sound in H2O vapor at ~250 K: c ≈ 395 m/s
      const ductAreaM2 = Math.PI * Math.pow(dDuct / 2000.0, 2);
      const totalVaporKgS = (jSub * (tunnel.condArea * 1.8)) / 3600.0;
      const vaporDensityKgM3 = (pPa * 0.018) / (8.314 * (tSubC + 273.15));
      const vaporVelocity = Math.max(15, totalVaporKgS / (ductAreaM2 * Math.max(0.0001, vaporDensityKgM3)));
      const speedOfSound = 395.0;
      const machNumber = vaporVelocity / speedOfSound;

      // 5. Shelf Glycol Uniformity (ΔT_glycol across platens)
      let glycolDelta = (tShelf > 25 ? 1.2 : 0.6) * (tunnelId === 'compromised_choked_tunnel' ? 3.2 : 1.0);
      if (!isGlycolBalanced) glycolDelta *= 2.8;

      // 6. Final Moisture & Water Activity
      // Function of desorption temperature, residence time, and chamber pressure
      const dryingCompletionFactor = (tResidence / 14.0) * (tDesorp / 35.0) * (0.12 / pChamber);
      let finalMoist = prod.targetM / Math.max(0.4, Math.min(2.5, dryingCompletionFactor));
      if (tResidence < 8.0) finalMoist *= 1.8;
      let finalAw = prod.targetAw * (finalMoist / prod.targetM);
      finalMoist = Math.max(0.8, Math.min(12.5, finalMoist));
      finalAw = Math.max(0.08, Math.min(0.65, finalAw));

      // 7. Condenser Surface Equilibrium Temp
      let iceThickMm = cond.iceThick;
      if (!isDualCondenser) iceThickMm += 18.0; // Ice builds up if no auto-alternating defrost
      const iceThermalPenalty = (iceThickMm / 2.2) * (jSub * 0.45);
      const condSurfTemp = tunnel.condT + iceThermalPenalty;

      // Update text displays
      if (subTempDisp) subTempDisp.textContent = `${tSubC.toFixed(1)}°C`;
      if (collapseMarginDisp) {
        collapseMarginDisp.textContent = `${collapseMargin >= 0 ? '+' : ''}${collapseMargin.toFixed(1)}°C`;
        collapseMarginDisp.className = collapseMargin >= 1.5 
          ? 'text-lg sm:text-xl font-extrabold text-emerald-700 font-mono'
          : (collapseMargin >= 0 ? 'text-lg sm:text-xl font-extrabold text-amber-600 font-mono' : 'text-lg sm:text-xl font-extrabold text-rose-700 font-mono');
      }
      if (subFluxDisp) subFluxDisp.textContent = `${jSub.toFixed(2)} kg/m²·h`;
      if (vaporMachDisp) {
        vaporMachDisp.textContent = `${vaporVelocity.toFixed(0)} m/s (M ${machNumber.toFixed(2)})`;
        vaporMachDisp.className = machNumber < 0.70 
          ? 'text-lg sm:text-xl font-extrabold text-ink font-mono'
          : (machNumber < 0.90 ? 'text-lg sm:text-xl font-extrabold text-amber-600 font-mono' : 'text-lg sm:text-xl font-extrabold text-rose-700 font-mono');
      }
      if (glycolDeltaDisp) glycolDeltaDisp.textContent = `${glycolDelta.toFixed(2)}°C`;
      if (finalMoistDisp) finalMoistDisp.textContent = `${finalMoist.toFixed(1)}%`;
      if (waterActDisp) waterActDisp.textContent = `${finalAw.toFixed(2)} a_w`;
      if (condSurfDisp) condSurfDisp.textContent = `${condSurfTemp.toFixed(1)}°C`;

      if (machSvgText) machSvgText.textContent = `VAPOR DUCT M = ${machNumber.toFixed(2)}`;

      // Compliance & Hazard Alert Triage
      let isCritical = false;
      let isWarning = false;
      let statusText = 'OPTIMAL COMPLIANCE';
      let riskText = 'No active structural collapse or sonic vapor duct choking detected. Sublimation front remains securely below critical matrix threshold.';
      let mechText = 'Continuous radiant and contact platen heat transfer is precisely counterbalanced by latent heat consumption of ice sublimation (ΔH_sub = 2838 kJ/kg). Knudsen vapor diffusion maintains pore structural rigidity.';
      let actText = 'Maintain steady continuous conveyor speed. Keep alternating cryogenic ice condensers synchronized with automated hot-gas defrost schedules.';

      if (collapseMargin < 0.0) {
        isCritical = true;
        statusText = 'CRITICAL PRODUCT COLLAPSE & MELT-BACK';
        riskText = `Product ice interface temperature (${tSubC.toFixed(1)}°C) exceeds critical collapse threshold Tc (${prod.tc.toFixed(1)}°C) by ${Math.abs(collapseMargin).toFixed(1)}°C!`;
        mechText = 'Amorphous sugar/protein matrix exceeds glass transition temperature Tg\', inducing catastrophic viscous flow, pore collapse, bubbling foam, irreversible loss of porosity, and entrapped water activity.';
        actText = 'IMMEDIATELY reduce primary shelf heating temperature by 10-15°C and verify vacuum pumping capacity to restore deep sublimation vacuum.';
      } else if (machNumber >= 0.88) {
        isCritical = true;
        statusText = 'SONIC CHOKED FLOW (MACH 1.0 VAPOR CHOKE)';
        riskText = `Vapor duct velocity (${vaporVelocity.toFixed(0)} m/s, Mach ${machNumber.toFixed(2)}) has reached sonic choking throughput. Chamber vacuum cannot evacuate sublimed vapor!`;
        mechText = 'Gas velocity reaches local speed of sound in water vapor. Duct becomes aerodynamically choked (Mach 1.0), triggering rapid chamber pressure surges and thermal runaway.';
        actText = 'Reduce platen sublimation heat input to throttle sublimation flux, or expand vapor duct effective throat diameter.';
      } else if (collapseMargin < 1.5 || machNumber >= 0.70 || glycolDelta > 1.8 || pAirlock > 2.0) {
        isWarning = true;
        statusText = 'ELEVATED PROCESS WARN / MARGINAL HEADROOM';
        riskText = 'Process running near critical collapse boundary or vapor duct capacity limits. Platen temperature variance or airlock vacuum shocks detected.';
        mechText = 'Sublimation driving force is constrained by rising vapor resistance or slight platen temperature maldistribution across bulk conveyor trays.';
        actText = 'Enable Tichelmann reverse-return balancing, ensure airlock pre-evacuation drops below 1.0 mbar before valve actuation, and inspect condenser ice frost.';
      }

      // Update Alert Box Styling
      if (isCritical) {
        if (alertBox) alertBox.className = 'p-4 rounded-2xl border bg-rose-50/80 border-rose-300 text-rose-950 transition-all';
        if (alertTitle) { alertTitle.textContent = statusText; alertTitle.className = 'text-xs font-bold uppercase tracking-wider text-rose-900'; }
        if (alertIcon) alertIcon.textContent = '🚨';
        if (complianceBadge) { complianceBadge.textContent = 'CRITICAL HAZARD'; complianceBadge.className = 'px-3 py-1 rounded-full text-xs font-extrabold uppercase tracking-wider bg-rose-100 text-rose-800 border border-rose-300'; }
        if (svgStatusPill) { svgStatusPill.textContent = 'CHOKED VAPOR / COLLAPSE'; svgStatusPill.className = 'px-2 py-0.5 rounded text-3xs font-bold bg-rose-500/30 text-rose-300 border border-rose-500/50'; }
      } else if (isWarning) {
        if (alertBox) alertBox.className = 'p-4 rounded-2xl border bg-amber-50/80 border-amber-300 text-amber-950 transition-all';
        if (alertTitle) { alertTitle.textContent = statusText; alertTitle.className = 'text-xs font-bold uppercase tracking-wider text-amber-900'; }
        if (alertIcon) alertIcon.textContent = '⚠️';
        if (complianceBadge) { complianceBadge.textContent = 'WARNING LIMITS'; complianceBadge.className = 'px-3 py-1 rounded-full text-xs font-extrabold uppercase tracking-wider bg-amber-100 text-amber-800 border border-amber-300'; }
        if (svgStatusPill) { svgStatusPill.textContent = 'TRANSONIC CAUTION'; svgStatusPill.className = 'px-2 py-0.5 rounded text-3xs font-bold bg-amber-500/30 text-amber-300 border border-amber-500/50'; }
      } else {
        if (alertBox) alertBox.className = 'p-4 rounded-2xl border bg-emerald-50/70 border-emerald-200 text-emerald-950 transition-all';
        if (alertTitle) { alertTitle.textContent = statusText; alertTitle.className = 'text-xs font-bold uppercase tracking-wider text-emerald-900'; }
        if (alertIcon) alertIcon.textContent = '✅';
        if (complianceBadge) { complianceBadge.textContent = 'OPTIMAL COMPLIANCE'; complianceBadge.className = 'px-3 py-1 rounded-full text-xs font-extrabold uppercase tracking-wider bg-emerald-100 text-emerald-800 border border-emerald-300'; }
        if (svgStatusPill) { svgStatusPill.textContent = 'SUB-SONIC FLOW'; svgStatusPill.className = 'px-2 py-0.5 rounded text-3xs font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/40'; }
      }

      if (alertRisk) alertRisk.textContent = riskText;
      if (alertMechanism) alertMechanism.textContent = mechText;
      if (alertAction) alertAction.textContent = actText;
    }

    // Attach event listeners
    const inputs = [
      tunnelSelect, productSelect, fluidSelect, condenserSelect,
      chamberPress, shelfTemp, desorpTemp, residenceTime,
      trayDepth, ductDiam, airlockVac, condenserToggle, glycolToggle
    ];
    inputs.forEach(input => {
      input?.addEventListener('input', recalculate);
      input?.addEventListener('change', recalculate);
    });

    // Preset Buttons
    document.querySelectorAll('.fd-preset-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const preset = (e.currentTarget as HTMLElement).getAttribute('data-preset');
        if (preset === 'probiotic') {
          if (tunnelSelect) tunnelSelect.value = 'ultra_aseptic_pharma_tunnel';
          if (productSelect) productSelect.value = 'probiotics_starter_cultures';
          if (chamberPress) chamberPress.value = '0.05';
          if (shelfTemp) shelfTemp.value = '-10';
          if (desorpTemp) desorpTemp.value = '28';
          if (residenceTime) residenceTime.value = '18';
          if (trayDepth) trayDepth.value = '12';
          if (ductDiam) ductDiam.value = '700';
          if (airlockVac) airlockVac.value = '0.3';
          if (condenserToggle) condenserToggle.checked = true;
          if (glycolToggle) glycolToggle.checked = true;
        } else if (preset === 'berry') {
          if (tunnelSelect) tunnelSelect.value = 'industrial_bulk_food_tunnel';
          if (productSelect) productSelect.value = 'strawberries_whole_berries';
          if (chamberPress) chamberPress.value = '0.10';
          if (shelfTemp) shelfTemp.value = '15';
          if (desorpTemp) desorpTemp.value = '38';
          if (residenceTime) residenceTime.value = '16';
          if (trayDepth) trayDepth.value = '20';
          if (ductDiam) ductDiam.value = '900';
          if (airlockVac) airlockVac.value = '0.5';
          if (condenserToggle) condenserToggle.checked = true;
          if (glycolToggle) glycolToggle.checked = true;
        } else if (preset === 'poultry') {
          if (tunnelSelect) tunnelSelect.value = 'industrial_bulk_food_tunnel';
          if (productSelect) productSelect.value = 'shredded_cooked_poultry';
          if (chamberPress) chamberPress.value = '0.14';
          if (shelfTemp) shelfTemp.value = '25';
          if (desorpTemp) desorpTemp.value = '45';
          if (residenceTime) residenceTime.value = '10';
          if (trayDepth) trayDepth.value = '22';
          if (ductDiam) ductDiam.value = '850';
          if (airlockVac) airlockVac.value = '0.8';
          if (condenserToggle) condenserToggle.checked = true;
          if (glycolToggle) glycolToggle.checked = true;
        } else if (preset === 'catastrophic') {
          if (tunnelSelect) tunnelSelect.value = 'compromised_choked_tunnel';
          if (productSelect) productSelect.value = 'probiotics_starter_cultures';
          if (condenserSelect) condenserSelect.value = 'heavy_ice_insulation';
          if (chamberPress) chamberPress.value = '0.38';
          if (shelfTemp) shelfTemp.value = '42';
          if (desorpTemp) desorpTemp.value = '55';
          if (residenceTime) residenceTime.value = '6';
          if (trayDepth) trayDepth.value = '35';
          if (ductDiam) ductDiam.value = '350';
          if (airlockVac) airlockVac.value = '3.5';
          if (condenserToggle) condenserToggle.checked = false;
          if (glycolToggle) glycolToggle.checked = false;
        }
        recalculate();
      });
    });

    // Copy Telemetry Report Button
    copyReportBtn?.addEventListener('click', () => {
      const report = `ISITKITCHENSAFE AUTONOMOUS OPS - FREEZE-DRYING TELEMETRY REPORT
----------------------------------------------------------------------
Timestamp: ${new Date().toISOString()}
System: ${tunnelSelect?.value}
Target Product: ${productSelect?.value}
Chamber Vacuum: ${chamberPress?.value} mbar
Primary Shelf Temp: ${shelfTemp?.value}°C | Desorption Temp: ${desorpTemp?.value}°C
Residence Time: ${residenceTime?.value} hrs | Tray Fill: ${trayDepth?.value} mm
Vapor Duct Diameter: ${ductDiam?.value} mm | Airlock Vac: ${airlockVac?.value} mbar
Sublimation Interface Temp: ${subTempDisp?.textContent}
Collapse Safety Margin: ${collapseMarginDisp?.textContent}
Sublimation Flux: ${subFluxDisp?.textContent}
Vapor Duct Mach: ${vaporMachDisp?.textContent}
Platen Glycol Delta: ${glycolDeltaDisp?.textContent}
Predicted Final Moisture: ${finalMoistDisp?.textContent} (Aw: ${waterActDisp?.textContent})
Condenser Surface Equil: ${condSurfDisp?.textContent}
Compliance Status: ${complianceBadge?.textContent}
----------------------------------------------------------------------`;

      navigator.clipboard.writeText(report).then(() => {
        if (copyText) copyText.textContent = 'Report Copied!';
        setTimeout(() => {
          if (copyText) copyText.textContent = 'Copy Telemetry Report';
        }, 2500);
      });
    });

    // Initial calculation run
    recalculate();
  }

  // Bind on DOM loaded & Astro page swaps
  document.addEventListener('DOMContentLoaded', initFreezeDryingModeler);
  document.addEventListener('astro:page-load', initFreezeDryingModeler);
</script>
