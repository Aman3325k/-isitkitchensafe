<script is:inline define:vars={{ conveyors, descalers, seals, scales, vents }}>
  (function() {
    const el = (id) => document.getElementById(id);

    const conveyorSelect = el('conveyor-select');
    const descalerSelect = el('descaler-select');
    const sealSelect = el('seal-select');
    const scaleSelect = el('scale-select');
    const ventSelect = el('vent-select');

    const tempSlider = el('temp-slider');
    const concSlider = el('conc-slider');
    const pumpSlider = el('pump-slider');
    const timeSlider = el('time-slider');

    const tempVal = el('temp-val');
    const concVal = el('conc-val');
    const pumpVal = el('pump-val');
    const timeVal = el('time-val');

    const outAirVapor = el('out-air-vapor');
    const outAirVaporSub = el('out-air-vapor-sub');
    const outCavitation = el('out-cavitation');
    const outCavitationSub = el('out-cavitation-sub');
    const outSealLife = el('out-seal-life');
    const outSealLifeSub = el('out-seal-life-sub');
    const outScaleRate = el('out-scale-rate');
    const outScaleRateSub = el('out-scale-rate-sub');
    const outCo2Rate = el('out-co2-rate');
    const outCo2RateSub = el('out-co2-rate-sub');
    const outPpeLevel = el('out-ppe-level');
    const outPpeLevelSub = el('out-ppe-level-sub');
    const statusPill = el('status-pill');

    const outPrimaryRisk = el('out-primary-risk');
    const outMechanisms = el('out-mechanisms');
    const outMitigations = el('out-mitigations');

    const copyBtn = el('copy-report-btn');
    const copiedToast = el('copied-toast');

    function calculate() {
      const conv = conveyors.find(c => c.id === conveyorSelect.value) || conveyors[0];
      const desc = descalers.find(d => d.id === descalerSelect.value) || descalers[0];
      const seal = seals.find(s => s.id === sealSelect.value) || seals[0];
      const scale = scales.find(sc => sc.id === scaleSelect.value) || scales[1];
      const vent = vents.find(v => v.id === ventSelect.value) || vents[0];

      const tempC = parseFloat(tempSlider.value);
      const concPercent = parseFloat(concSlider.value);
      const pumpPercent = parseFloat(pumpSlider.value);
      const dwellMins = parseFloat(timeSlider.value);

      // Display live slider labels
      const tempF = ((tempC * 9/5) + 32).toFixed(1);
      tempVal.textContent = `${tempC.toFixed(1)}°C (${tempF}°F)`;
      concVal.textContent = `${concPercent.toFixed(1)}% v/v`;
      const currentGpm = Math.round(conv.pumpFlowRateGpm * (pumpPercent / 100));
      pumpVal.textContent = `${Math.round(pumpPercent)}% (${currentGpm} GPM)`;
      timeVal.textContent = `${Math.round(dwellMins)} min`;

      // 1. Air Vapor / Aerosol Generation Modeling
      // Antoine temperature scaling factor: vapor pressure rises exponentially with temperature
      const tempFactor = Math.exp((tempC - 50) / 14);
      // High pump velocity creates mechanical aerosol droplet shearing
      const shearFactor = Math.pow(pumpPercent / 100, 1.4);
      // Concentration factor
      const chemVolatility = desc.vaporPressureMmHgAt20C * (concPercent / 4.0);
      
      // Base generation rate in mg/sec
      let vaporGenRateMgSec = chemVolatility * tempFactor * shearFactor * (conv.washTankVolumeLiters / 100) * 12.5;
      if (desc.id === 'hydrochloric_muriatic_banned') {
        vaporGenRateMgSec *= 24.0; // extreme HCl gas release
      }

      // Room capture efficiency from ventilation
      const captureRate = vent.captureEfficiencyPercent / 100;
      const spilloverRate = (100 - vent.captureEfficiencyPercent) / 100;
      
      // Steady-state dishroom concentration (assuming 120 m³ standard dishroom volume)
      const airChangesPerHour = vent.airChangesPerHourDishroom;
      const effectiveVentilationRateM3Sec = (120 * airChangesPerHour) / 3600;
      
      const roomEscapedMgSec = vaporGenRateMgSec * spilloverRate;
      let airborneMgM3 = roomEscapedMgSec / Math.max(0.08, effectiveVentilationRateM3Sec);
      airborneMgM3 = Math.max(0.02, Math.min(25.0, airborneMgM3));

      // 2. Net Positive Suction Head (NPSHa) & Cavitation Modeling
      // Water vapor pressure rises with temperature; CO2 effervescence adds dissolved gas partial pressure
      const scaleVolumeKg = (scale.thicknessMm / 1000) * 8.5 * (scale.densityGcm3 * 1000); // estimated scale mass
      const co2GenRateLpm = (scaleVolumeKg * scale.co2GasReleaseLitersPerKgScale * (concPercent / 5.0) * (tempC / 50)) / Math.max(10, dwellMins);
      
      // Gas-binding and vapor pressure drop NPSHa
      const vaporPressureLossMeters = (Math.pow(tempC / 45, 2.8) - 1.0) * 0.95;
      const effervescenceLossMeters = Math.min(3.5, (co2GenRateLpm / 15.0) * desc.cavitationInductionFactor);
      const velocityHeadLoss = Math.pow(pumpPercent / 100, 2) * 0.6;
      
      const npshaAvailable = Math.max(0.1, conv.baselineCavitationMarginNpshMeters - vaporPressureLossMeters - effervescenceLossMeters - velocityHeadLoss);
      const cavitationMarginDelta = npshaAvailable - 1.2; // 1.2m typical NPSHr threshold

      // 3. Elastomeric Seal Degradation Modeling
      let baseSealLife = seal.expectedSealLifespanHours;
      let chemicalDamageFactor = 1.0;
      
      if (desc.id === 'phosphoric_acid_blend') {
        if (seal.id === 'nbr_buna_nitrile') chemicalDamageFactor *= 0.28;
        if (seal.id === 'silicone_elastomer') chemicalDamageFactor *= 0.45;
        if (seal.id === 'fkm_viton_fluoroelastomer') chemicalDamageFactor *= 0.95;
      } else if (desc.id === 'sulfamic_acid_crystalline') {
        if (seal.id === 'nbr_buna_nitrile') chemicalDamageFactor *= 0.12;
        if (seal.id === 'epdm_ethylene_propylene') chemicalDamageFactor *= 0.65;
        if (seal.id === 'fkm_viton_fluoroelastomer') chemicalDamageFactor *= 0.92;
      } else if (desc.id === 'hydrochloric_muriatic_banned') {
        chemicalDamageFactor *= 0.05; // catastrophic destruction
      }

      // High temp acceleration (Arrhenius degradation of polymer chains)
      const polymerThermalStress = Math.exp((tempC - 50) / 16);
      // Cavitation erosion shockwave factor
      const cavitationErosion = cavitationMarginDelta < 0 ? 2.5 : 1.0;

      const effectiveSealLifeHours = Math.max(12, Math.round((baseSealLife * chemicalDamageFactor) / (polymerThermalStress * cavitationErosion)));
      const sealHealthPercent = Math.min(100, Math.round((effectiveSealLifeHours / baseSealLife) * 100));

      // 4. Scale Dissolution & Removal Efficiency
      let removalEfficiency = (concPercent / 4.0) * (tempC / 50) * (dwellMins / 20) * 88.0;
      if (scale.id === 'heavy_calcite_scale') removalEfficiency *= 0.85;
      if (scale.id === 'composite_grease_protein_scale') removalEfficiency *= 0.70;
      if (desc.id === 'citric_acid_anhydrous') removalEfficiency *= 0.65;
      if (desc.id === 'hydrochloric_muriatic_banned') removalEfficiency *= 1.25;
      removalEfficiency = Math.max(15, Math.min(99.8, removalEfficiency));

      // 5. Worker PPE Classification
      let ppeLevel = 'LEVEL 1 (Standard)';
      let ppeSub = 'Splash goggles & nitrile gloves';
      let ppeColor = 'text-emerald-600 dark:text-emerald-400';

      if (airborneMgM3 > desc.oshaPelMgM3 * 2.5 || desc.id === 'hydrochloric_muriatic_banned') {
        ppeLevel = 'LEVEL 4 (CRITICAL / ESCAPE)';
        ppeSub = 'Full-face acid gas / P100 respirator, neoprene suit & clear area';
        ppeColor = 'text-purple-600 dark:text-purple-400';
      } else if (airborneMgM3 > desc.oshaPelMgM3) {
        ppeLevel = 'LEVEL 3 (RESPIRATOR MANDATORY)';
        ppeSub = 'Half-mask cartridge respirator for acid gas + face shield';
        ppeColor = 'text-rose-600 dark:text-rose-400';
      } else if (airborneMgM3 > desc.oshaPelMgM3 * 0.5) {
        ppeLevel = 'LEVEL 2 (ELEVATED CAUTION)';
        ppeSub = 'N95 particulate/mist mask, chemical splash apron, eye protection';
        ppeColor = 'text-amber-600 dark:text-amber-400';
      }

      // UI Updates
      let vaporColor = 'text-emerald-600 dark:text-emerald-400';
      let vaporSub = `OSHA PEL: <${desc.oshaPelMgM3} mg/m³ (Safe)`;
      if (airborneMgM3 > desc.oshaPelMgM3) {
        vaporColor = 'text-rose-600 dark:text-rose-400';
        vaporSub = `VIOLATION: Exceeds OSHA PEL (${desc.oshaPelMgM3} mg/m³) by ${(airborneMgM3 / desc.oshaPelMgM3).toFixed(1)}x`;
      } else if (airborneMgM3 > desc.oshaPelMgM3 * 0.7) {
        vaporColor = 'text-amber-600 dark:text-amber-400';
        vaporSub = `Approaching OSHA PEL (${desc.oshaPelMgM3} mg/m³) threshold`;
      }

      outAirVapor.className = `text-xl font-black font-mono ${vaporColor}`;
      outAirVapor.textContent = `${airborneMgM3.toFixed(2)} mg/m³`;
      outAirVaporSub.textContent = vaporSub;

      let cavColor = 'text-emerald-600 dark:text-emerald-400';
      let cavText = `NPSHa ${npshaAvailable.toFixed(1)}m (+${cavitationMarginDelta.toFixed(1)}m)`;
      let cavSub = 'Laminar flow, 0% gas binding in volute';
      if (cavitationMarginDelta < -0.8) {
        cavColor = 'text-rose-600 dark:text-rose-400';
        cavText = `SEVERE CAVITATION (${npshaAvailable.toFixed(1)}m)`;
        cavSub = 'Acoustic micro-implosions pitting impeller & face seals';
      } else if (cavitationMarginDelta < 0.2) {
        cavColor = 'text-amber-600 dark:text-amber-400';
        cavText = `INCIPIENT CAVITATION (${npshaAvailable.toFixed(1)}m)`;
        cavSub = 'CO₂ micro-bubbles reducing pump head by 15–25%';
      }
      outCavitation.className = `text-xl font-black font-mono ${cavColor}`;
      outCavitation.textContent = cavText;
      outCavitationSub.textContent = cavSub;

      let sealColor = 'text-emerald-600 dark:text-emerald-400';
      if (sealHealthPercent < 35) sealColor = 'text-rose-600 dark:text-rose-400';
      else if (sealHealthPercent < 70) sealColor = 'text-amber-600 dark:text-amber-400';

      outSealLife.className = `text-xl font-black font-mono ${sealColor}`;
      outSealLife.textContent = `${effectiveSealLifeHours.toLocaleString()} Hours (${sealHealthPercent}%)`;
      outSealLifeSub.textContent = `${seal.chemicalFamily}: ${seal.failureMechanism.split(',')[0]}`;

      outScaleRate.textContent = `${removalEfficiency.toFixed(1)}% Stripped`;
      outScaleRateSub.textContent = `${dwellMins} min cycle; ${scale.chemicalComposition.split(',')[0]}`;

      outCo2Rate.textContent = `${co2GenRateLpm.toFixed(1)} L/min CO₂`;
      outCo2RateSub.textContent = `${scale.effervescenceIntensity.split(' (')[0]} effervescence`;

      outPpeLevel.className = `text-xl font-black font-mono ${ppeColor}`;
      outPpeLevel.textContent = ppeLevel;
      outPpeLevelSub.textContent = ppeSub;

      // Status Pill & Overall Compliance
      if (desc.id === 'hydrochloric_muriatic_banned') {
        statusPill.className = 'inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-purple-500/10 text-purple-800 dark:text-purple-300 border border-purple-500/20 shrink-0';
        statusPill.innerHTML = '<span>🚫</span><span>ILLEGAL ACID CONTRAINDICATION (NSF BANNED)</span>';
        outPrimaryRisk.textContent = 'Severe hydrochloric acid pitting corrosion destroying 304 stainless steel welds, boiler heating elements, and releasing toxic HCl acid gases.';
        outMechanisms.textContent = 'Chloride ions break down chromium passivity; violent effervescence strips pump seals and causes immediate impeller gas binding.';
        outMitigations.textContent = 'IMMEDIATE EMERGENCY SHUTDOWN: Flush tank 5x with cold water; neutralize rinse with sodium bicarbonate; inspect pump and welds for fissures.';
      } else if (airborneMgM3 > desc.oshaPelMgM3 || cavitationMarginDelta < -0.8 || sealHealthPercent < 30) {
        statusPill.className = 'inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-rose-500/10 text-rose-800 dark:text-rose-300 border border-rose-500/20 shrink-0';
        statusPill.innerHTML = '<span>🚨</span><span>CRITICAL HAZARD (OSHA / CAVITATION VIOLATION)</span>';
        outPrimaryRisk.textContent = 'Airborne chemical concentration breaches OSHA PEL ceiling or pump cavitating violently from excessive heat and dissolved CO₂ gas binding.';
        outMechanisms.textContent = `Vapor pressure at ${tempC}°C exceeds containment draft; ${desc.primaryAcid} aerosols spill past entrance curtains into worker breathing zone.`;
        outMitigations.textContent = 'Reduce wash tank temperature below 52°C; engage powered exhaust at full speed (-20 Pa); upgrade pump seals to FKM Viton.';
      } else if (airborneMgM3 > desc.oshaPelMgM3 * 0.6 || cavitationMarginDelta < 0.5) {
        statusPill.className = 'inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-500/10 text-amber-800 dark:text-amber-300 border border-amber-500/20 shrink-0';
        statusPill.innerHTML = '<span>⚠️</span><span>ELEVATED CAUTION (MONITOR DRAFT & TEMPERATURE)</span>';
        outPrimaryRisk.textContent = 'Moderate chemical aerosol release approaching occupational thresholds; slight pump head drop from scale effervescence.';
        outMechanisms.textContent = 'Elevated water temperature accelerates chemical evaporation; EPDM seals experiencing minor plasticizer swelling.';
        outMitigations.textContent = 'Ensure kitchen exhaust hood baffles are clear; limit deliming cycle to 20 minutes maximum; wear eye protection and splash apron.';
      } else {
        statusPill.className = 'inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-500/10 text-emerald-800 dark:text-emerald-300 border border-emerald-500/20 shrink-0';
        statusPill.innerHTML = '<span>🛡️</span><span>COMPLIANT (OSHA &amp; NSF/ANSI 3)</span>';
        outPrimaryRisk.textContent = 'Optimal commercial descaling regime; controlled dissolution of calcium carbonate scale with minimal aerosolization into operator workspace.';
        outMechanisms.textContent = 'Moderate acid vapor pressure maintained below volatilization threshold by active negative pressure exhaust draft.';
        outMitigations.textContent = 'Maintain wash water temperature at 50°C–52°C; inspect mechanical seals semi-annually; perform neutral cold rinse before dishwashing restart.';
      }

      return {
        timestamp: new Date().toISOString(),
        conveyor: conv.name,
        descaler: desc.name,
        seal: seal.name,
        scale: scale.name,
        ventilation: vent.name,
        operationalParameters: {
          washTempC: tempC,
          washTempF: parseFloat(tempF),
          acidConcentrationPercent: concPercent,
          pumpSpeedPercent: pumpPercent,
          circulationFlowGpm: currentGpm,
          dwellMinutes: dwellMins
        },
        diagnostics: {
          airborneConcentrationMgM3: parseFloat(airborneMgM3.toFixed(3)),
          oshaPelMgM3: desc.oshaPelMgM3,
          oshaCompliant: airborneMgM3 <= desc.oshaPelMgM3,
          npshaAvailableMeters: parseFloat(npshaAvailable.toFixed(2)),
          cavitationMarginDeltaMeters: parseFloat(cavitationMarginDelta.toFixed(2)),
          cavitationState: cavText,
          sealRemainingLifeHours: effectiveSealLifeHours,
          sealHealthPercentage: sealHealthPercent,
          scaleRemovalEfficiencyPercent: parseFloat(removalEfficiency.toFixed(1)),
          co2GenerationRateLpm: parseFloat(co2GenRateLpm.toFixed(2)),
          mandatoryPpeLevel: ppeLevel
        }
      };
    }

    // Attach event listeners
    conveyorSelect.addEventListener('change', calculate);
    descalerSelect.addEventListener('change', calculate);
    sealSelect.addEventListener('change', calculate);
    scaleSelect.addEventListener('change', calculate);
    ventSelect.addEventListener('change', calculate);

    tempSlider.addEventListener('input', calculate);
    concSlider.addEventListener('input', calculate);
    pumpSlider.addEventListener('input', calculate);
    timeSlider.addEventListener('input', calculate);

    // Preset Buttons
    el('preset-gold').addEventListener('click', () => {
      conveyorSelect.value = 'multi_tank_flight_conveyor';
      descalerSelect.value = 'phosphoric_acid_blend';
      sealSelect.value = 'fkm_viton_fluoroelastomer';
      scaleSelect.value = 'moderate_limescale_silicate';
      ventSelect.value = 'dedicated_powered_stack_500cfm';
      tempSlider.value = '50';
      concSlider.value = '4.0';
      pumpSlider.value = '100';
      timeSlider.value = '20';
      calculate();
    });

    el('preset-cavitation').addEventListener('click', () => {
      conveyorSelect.value = 'aged_passthrough_hood';
      descalerSelect.value = 'sulfamic_acid_crystalline';
      sealSelect.value = 'nbr_buna_nitrile';
      scaleSelect.value = 'heavy_calcite_scale';
      ventSelect.value = 'shared_type_ii_canopy_250cfm';
      tempSlider.value = '75';
      concSlider.value = '8.0';
      pumpSlider.value = '115';
      timeSlider.value = '35';
      calculate();
    });

    el('preset-aerosol').addEventListener('click', () => {
      conveyorSelect.value = 'continuous_rack_conveyor';
      descalerSelect.value = 'sulfamic_acid_crystalline';
      sealSelect.value = 'epdm_ethylene_propylene';
      scaleSelect.value = 'heavy_calcite_scale';
      ventSelect.value = 'unventilated_dishroom_0cfm';
      tempSlider.value = '68';
      concSlider.value = '12.0';
      pumpSlider.value = '100';
      timeSlider.value = '30';
      calculate();
    });

    el('preset-hydrochloric').addEventListener('click', () => {
      conveyorSelect.value = 'multi_tank_flight_conveyor';
      descalerSelect.value = 'hydrochloric_muriatic_banned';
      sealSelect.value = 'nbr_buna_nitrile';
      scaleSelect.value = 'heavy_calcite_scale';
      ventSelect.value = 'shared_type_ii_canopy_250cfm';
      tempSlider.value = '62';
      concSlider.value = '15.0';
      pumpSlider.value = '100';
      timeSlider.value = '15';
      calculate();
    });

    copyBtn.addEventListener('click', () => {
      const report = calculate();
      navigator.clipboard.writeText(JSON.stringify(report, null, 2)).then(() => {
        copiedToast.classList.remove('hidden');
        setTimeout(() => {
          copiedToast.classList.add('hidden');
        }, 3000);
      });
    });

    // Initial run
    calculate();
  })();
</script>
