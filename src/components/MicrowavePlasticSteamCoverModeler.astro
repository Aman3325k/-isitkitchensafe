    foodLabel: "食品の水分・脂質マトリックス:",
    foodHelp: "脂肪分と油跳ねの激しさが親脂性化学物質の抽出速度と局所ホットスポット温度を左右します。",
    ventLabel: "蒸気抜きスチームベントの状態:",
    ventHelp: "通気孔が閉じていると100%の高温蒸気が閉じ込められ、天井温度が上昇して汚染結露水が激しく食品へ逆流滴下します。",
    wearLabel: "カバーの劣化歴・食洗機洗浄回数:",
    wearHelp: "食洗機のアルカリ洗剤と高熱乾燥の繰り返しにより、微小クラックが生じ添加剤が表面へブリードアウト（白化析出）します。",
    durationLabel: "加熱時間 (分):",
    durationHelp: "加熱が長引くほど蒸気飽和度が高まり、連続的な蒸気還流滴下ループが発生します。",
    wattsLabel: "電子レンジ出力 (W):",
    wattsHelp: "高出力ほど水分が急速沸騰し、超高温（120°C以上）の油滴が天井へ爆発的に跳ね上がります。",
    presetsTitle: "クイック診断シナリオ:",
    presetPizzaPvc: "🍕 安価PVC蓋でペパロニピザを再加熱 (重度フタル酸エステル溶出)",
    presetSoupPc: "🍲 ポリカーボネート製ドームで温野菜スープ (BPA高温加水分解還流)",
    presetChiliPp: "🌶️ 傷だらけの古いPP蓋でミートチリを加熱 (オリゴマー・添加剤溶出)",
    presetRicePp: "🍚 新品のBPAフリーPP蓋で白米を加熱 (中低度の蒸気還流)",
    presetSilicone: "🥞 プラチナシリコンカバーで朝食プレート加熱 (安全な食品用グレード基準)",
    presetGlass: "🥗 耐熱ホウケイ酸ガラスドームで高温再加熱 (完全無溶出のゴールドマスター)",
    diagnosticTitle: "リアルタイム化学溶出解析＆毒性スコアカード",
    diagnosticSub: "化学抽出シミュレーター：総溶出量、還流結露水量、国内外の食品接触規制適合性を瞬時に判定。",
    hazardScoreLabel: "内分泌攪乱および化学溶出ハザード指数",
    chemicalLeachedLabel: "推定化学物質溶出量 (μg / 1食分)",
    condensateVolumeLabel: "食品へ滴下した推定結露水量 (mL)",
    primaryMigrantLabel: "主な溶出化学物質プロファイル",
    regulatoryStatusLabel: "EU 10/2011および米国FDA規制適合性",
    endocrineRiskLabel: "内分泌撹乱リスク脆弱性指数",
    alertTitle: "臨床安全性判定と化学物質暴露メカニズム",
    tableTitle: "電子レンジカバー用ポリマーの化学的溶出ベンチマーク比較",
    tableSub: "沸騰蒸気結露および高温油脂の接触下における主要プラスチック素材の安全性比較。",
    colMaterial: "カバーのポリマー素材",
    colPlasticizers: "可塑剤・主要添加剤分類",
    colMaxTemp: "耐熱上限温度",
    colLeachRate: "基準溶出速度",
    colStatus: "規制適合ステータス",
    colVerdict: "調理安全性判定",
    rulesTitle: "電子レンジ用カバーの安全な使い方 5大鉄則",
    rulesSub: "食品への有害化学物質移行をゼロにするための科学的ガイドライン。",
    rule1Title: "1. 陶器皿の逆さ置きプロトコル (無料・完全無害の代用法)",
    rule1Text: "脂っこい料理を温めるときは安価なプラスチック蓋を使わず、普通の陶器の平皿やボウルを逆さまに被せてください。蒸気結露を吸い取り化学物質も一切溶出しません。",
    rule2Title: "2. 高温油脂の溶剤効果 (脂溶性分配による移行急増)",
    rule2Text: "フタル酸エステル等の可塑剤は水より高温の油脂に1,000倍溶けやすい性質があります。蓋に跳ねた油膜が添加剤を瞬時に吸い出し、結露水とともに食品へ滴下します。",
    rule3Title: "3. 傷・白化・黄ばみが出たプラスチック蓋は即刻破棄",
    rule3Text: "食洗機等で白く濁ったり傷だらけになったポリプロピレンは分子鎖が切断されています。新品に比べ最大6倍のオリゴマーや酸化防止剤分解物が溶出します。",
    rule4Title: "4. 加熱時は蒸気抜きスチームベントを必ず全開にする",
    rule4Text: "通気弁を閉じたままだと密閉蒸留状態となり、天井で結露した汚染水滴が全て食品に落ちます。弁を開けることで余分な蒸気の75%を逃がすことができます。",
    rule5Title: "5. 耐熱ホウケイ酸ガラス製ドームへのアップグレード",
    rule5Text: "厚手の耐熱ガラス製レンジカバーは半永久的に使えます。完全無機質で油や酸にもビクともせず、何百回食洗機で洗っても化学物質溶出のリスクは永久にゼロです。",
    copyReportBtn: "診断レポートをコピー",
    copiedFeedback: "診断レポートをクリップボードにコピーしました！"
  }
};

const d = DICTIONARY[lang] || DICTIONARY.en;
---

<div class="bg-surface rounded-3xl border border-hairline p-6 md:p-10 shadow-sm mb-12">
  <!-- Presets Header -->
  <div class="mb-8 border-b border-hairline pb-6">
    <div class="flex items-center gap-2 mb-2">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-rose-100 text-rose-900 border border-rose-200">
        🔬 {d.badge}
      </span>
    </div>
    <h2 class="text-2xl md:text-3xl font-extrabold text-ink tracking-tight mb-2">
      {d.title}
    </h2>
    <p class="text-body text-sm md:text-base leading-relaxed">
      {d.subtitle}
    </p>

    <!-- Preset Buttons -->
    <div class="mt-6">
      <span class="text-xs font-mono uppercase tracking-wider text-muted font-bold block mb-3">
        {d.presetsTitle}
      </span>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        <button type="button" class="preset-btn text-left p-3 rounded-xl border border-hairline bg-surface hover:bg-rose-50 hover:border-rose-300 transition-all text-xs font-medium text-ink flex items-center gap-2" data-preset="pizza-pvc">
          {d.presetPizzaPvc}
        </button>
        <button type="button" class="preset-btn text-left p-3 rounded-xl border border-hairline bg-surface hover:bg-rose-50 hover:border-rose-300 transition-all text-xs font-medium text-ink flex items-center gap-2" data-preset="soup-pc">
          {d.presetSoupPc}
        </button>
        <button type="button" class="preset-btn text-left p-3 rounded-xl border border-hairline bg-surface hover:bg-rose-50 hover:border-rose-300 transition-all text-xs font-medium text-ink flex items-center gap-2" data-preset="chili-pp">
          {d.presetChiliPp}
        </button>
        <button type="button" class="preset-btn text-left p-3 rounded-xl border border-hairline bg-surface hover:bg-rose-50 hover:border-rose-300 transition-all text-xs font-medium text-ink flex items-center gap-2" data-preset="rice-pp">
          {d.presetRicePp}
        </button>
        <button type="button" class="preset-btn text-left p-3 rounded-xl border border-hairline bg-surface hover:bg-rose-50 hover:border-rose-300 transition-all text-xs font-medium text-ink flex items-center gap-2" data-preset="silicone">
          {d.presetSilicone}
        </button>
        <button type="button" class="preset-btn text-left p-3 rounded-xl border border-hairline bg-surface hover:bg-rose-50 hover:border-rose-300 transition-all text-xs font-medium text-ink flex items-center gap-2" data-preset="glass">
          {d.presetGlass}
        </button>
      </div>
    </div>
  </div>

  <!-- Main Controls & Simulator Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-10">
    <!-- Left: Controls Column (7 Cols) -->
    <div class="lg:col-span-7 space-y-6">
      <div class="border-b border-hairline pb-3">
        <h3 class="text-base font-bold text-ink">
          {d.controlsTitle}
        </h3>
        <p class="text-xs text-body mt-0.5">
          {d.controlsSub}
        </p>
      </div>

      <!-- Cover Material Select -->
      <div>
        <label for="cover-material-select" class="block text-xs font-mono uppercase tracking-wider font-bold text-ink mb-1">
          {d.coverLabel}
        </label>
        <select id="cover-material-select" class="w-full bg-surface border border-hairline rounded-xl px-3 py-2.5 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-rose-500 font-medium">
          {steamData.coverMaterials.map((mat) => (
            <option value={mat.id}>{mat.name}</option>
          ))}
        </select>
        <p class="text-xs text-body mt-1">
          {d.coverHelp}
        </p>
      </div>

      <!-- Food Moisture & Lipid Matrix -->
      <div>
        <label for="food-matrix-select" class="block text-xs font-mono uppercase tracking-wider font-bold text-ink mb-1">
          {d.foodLabel}
        </label>
        <select id="food-matrix-select" class="w-full bg-surface border border-hairline rounded-xl px-3 py-2.5 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-rose-500 font-medium">
          {steamData.foodMatrices.map((food) => (
            <option value={food.id}>{food.name} (Fat: {food.fatContentPercent}%, pH: {food.pH})</option>
          ))}
        </select>
        <p class="text-xs text-body mt-1">
          {d.foodHelp}
        </p>
      </div>

      <!-- Steam Vent Mode -->
      <div>
        <label for="vent-mode-select" class="block text-xs font-mono uppercase tracking-wider font-bold text-ink mb-1">
          {d.ventLabel}
        </label>
        <select id="vent-mode-select" class="w-full bg-surface border border-hairline rounded-xl px-3 py-2.5 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-rose-500 font-medium">
          {steamData.steamVentStates.map((vent) => (
            <option value={vent.id}>{vent.name}</option>
          ))}
        </select>
        <p class="text-xs text-body mt-1">
          {d.ventHelp}
        </p>
      </div>

      <!-- Wear & Wash Cycle Level -->
      <div>
        <label for="wear-level-select" class="block text-xs font-mono uppercase tracking-wider font-bold text-ink mb-1">
          {d.wearLabel}
        </label>
        <select id="wear-level-select" class="w-full bg-surface border border-hairline rounded-xl px-3 py-2.5 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-rose-500 font-medium">
          {steamData.wearLevels.map((w) => (
            <option value={w.id}>{w.name}</option>
          ))}
        </select>
        <p class="text-xs text-body mt-1">
          {d.wearHelp}
        </p>
      </div>

      <!-- Heating Duration Slider -->
      <div class="bg-surface-soft p-4 rounded-2xl border border-hairline">
        <div class="flex justify-between items-center mb-1">
          <label for="duration-slider" class="text-xs font-mono uppercase tracking-wider font-bold text-ink">
            {d.durationLabel}
          </label>
          <span id="duration-val-display" class="font-mono text-sm font-extrabold text-rose-800">
            3.0 min
          </span>
        </div>
        <input id="duration-slider" type="range" min="0.5" max="10.0" step="0.5" value="3.0" class="w-full accent-rose-600 cursor-pointer" />
        <p class="text-xs text-body mt-1">
          {d.durationHelp}
        </p>
      </div>

      <!-- Microwave Power Slider -->
      <div class="bg-surface-soft p-4 rounded-2xl border border-hairline">
        <div class="flex justify-between items-center mb-1">
          <label for="watts-slider" class="text-xs font-mono uppercase tracking-wider font-bold text-ink">
            {d.wattsLabel}
          </label>
          <span id="watts-val-display" class="font-mono text-sm font-extrabold text-rose-800">
            1000 W
          </span>
        </div>
        <input id="watts-slider" type="range" min="600" max="1200" step="100" value="1000" class="w-full accent-rose-600 cursor-pointer" />
        <p class="text-xs text-body mt-1">
          {d.wattsHelp}
        </p>
      </div>
    </div>

    <!-- Right: Live Diagnostic Scorecard (5 Cols) -->
    <div class="lg:col-span-5 flex flex-col justify-between space-y-6">
      <div class="border-b border-hairline pb-3">
        <h3 class="text-base font-bold text-ink">
          {d.diagnosticTitle}
        </h3>
        <p class="text-xs text-body mt-0.5">
          {d.diagnosticSub}
        </p>
      </div>

      <!-- Hazard Gauge Card -->
      <div id="hazard-card" class="p-5 rounded-2xl border transition-all duration-300 bg-emerald-50 border-emerald-200">
        <div class="flex justify-between items-start mb-2">
          <span class="text-xs font-mono uppercase font-bold text-ink">
            {d.hazardScoreLabel}
          </span>
          <span id="hazard-badge" class="px-2.5 py-0.5 rounded-full text-xs font-extrabold tracking-wide uppercase bg-emerald-100 text-emerald-800">
            LOW RISK
          </span>
        </div>
        <div class="flex items-baseline gap-2">
          <span id="hazard-score-num" class="text-4xl md:text-5xl font-black text-ink tracking-tight font-mono">
            8
          </span>
          <span class="text-xs text-body font-mono">/ 100 HAZARD INDEX</span>
        </div>
        <!-- Progress bar -->
        <div class="w-full bg-surface rounded-full h-2.5 my-3 overflow-hidden border border-hairline">
          <div id="hazard-progress-bar" class="h-full bg-emerald-500 transition-all duration-500" style="width: 8%;"></div>
        </div>
        <p id="hazard-summary-text" class="text-xs text-body leading-relaxed mt-2">
          Minimal chemical migration. Steam condensate droplets contain negligible synthetic additives.
        </p>
      </div>

      <!-- Metric Grid -->
      <div class="grid grid-cols-2 gap-3">
        <!-- Chemical Leached -->
        <div class="bg-surface-soft p-4 rounded-xl border border-hairline">
          <span class="text-xs text-muted block font-mono uppercase tracking-wider mb-1">
            {d.chemicalLeachedLabel}
          </span>
          <span id="chemical-dose-display" class="text-xl md:text-2xl font-black text-ink font-mono block">
            1.2 μg
          </span>
          <span id="chemical-ppm-display" class="text-xs text-muted font-mono block mt-0.5">
            0.005 ppm in food
          </span>
        </div>

        <!-- Condensate Volume -->
        <div class="bg-surface-soft p-4 rounded-xl border border-hairline">
          <span class="text-xs text-muted block font-mono uppercase tracking-wider mb-1">
            {d.condensateVolumeLabel}
          </span>
          <span id="condensate-volume-display" class="text-xl md:text-2xl font-black text-ink font-mono block">
            2.4 mL
          </span>
          <span id="reflux-velocity-display" class="text-xs text-muted font-mono block mt-0.5">
            ~48 droplets refluxed
          </span>
        </div>
      </div>

      <!-- Regulatory & Clinical Indicators -->
      <div class="space-y-3 bg-surface-soft p-4 rounded-xl border border-hairline text-xs font-mono">
        <div class="flex items-center justify-between border-b border-hairline/60 pb-2">
          <span class="text-muted">{d.primaryMigrantLabel}:</span>
          <span id="primary-migrant-display" class="font-bold text-ink">Inert Silica Glass</span>
        </div>
        <div class="flex items-center justify-between border-b border-hairline/60 pb-2">
          <span class="text-muted">{d.regulatoryStatusLabel}:</span>
          <span id="regulatory-status-display" class="font-bold text-emerald-700">COMPLIANT (GRAS)</span>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-muted">{d.endocrineRiskLabel}:</span>
          <span id="endocrine-risk-display" class="font-bold text-emerald-700">NONE DETECTED</span>
        </div>
      </div>

      <!-- Copy Report Button -->
      <div class="pt-2">
        <button id="copy-report-btn" type="button" class="w-full py-3 px-4 rounded-xl bg-ink hover:bg-black text-white text-xs font-bold font-mono uppercase tracking-wider transition-all shadow-xs flex items-center justify-center gap-2">
          <span>📋</span> {d.copyReportBtn}
        </button>
        <p id="copied-feedback" class="text-center text-xs text-emerald-600 font-bold mt-1.5 transition-opacity opacity-0">
          {d.copiedFeedback}
        </p>
      </div>
    </div>
  </div>

  <!-- Dynamic Mechanism & Clinical Alert Box -->
  <div id="clinical-alert-box" class="p-6 rounded-2xl border mb-10 bg-emerald-50 border-emerald-200 transition-all">
    <div class="flex items-start gap-4">
      <span id="alert-icon" class="text-3xl">✅</span>
      <div class="space-y-1">
        <h4 id="alert-title" class="text-base font-bold text-ink">
          {d.alertTitle}
        </h4>
        <p id="alert-detailed-text" class="text-xs md:text-sm text-body leading-relaxed">
          Optimal culinary hygiene. The selected cover material does not leach phthalates, bisphenols, or synthetic plasticizers under hot steam conditions.
        </p>
      </div>
    </div>
  </div>

  <!-- Scientific Reference Table -->
  <div class="mb-12 border border-hairline rounded-2xl overflow-hidden shadow-xs">
    <div class="bg-surface-soft p-5 border-b border-hairline">
      <h3 class="text-base font-bold text-ink">
        {d.tableTitle}
      </h3>
      <p class="text-xs text-body mt-0.5">
        {d.tableSub}
      </p>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="bg-surface border-b border-hairline text-muted uppercase font-mono tracking-wider">
          <tr>
            <th class="p-3.5">{d.colMaterial}</th>
            <th class="p-3.5">{d.colPlasticizers}</th>
            <th class="p-3.5">{d.colMaxTemp}</th>
            <th class="p-3.5">{d.colLeachRate}</th>
            <th class="p-3.5">{d.colStatus}</th>
            <th class="p-3.5">{d.colVerdict}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline">
          {steamData.coverMaterials.map((mat) => (
            <tr class="hover:bg-surface-soft/60 transition-colors">
              <td class="p-3.5 font-bold text-ink">{mat.name}</td>
              <td class="p-3.5 text-body">{mat.plasticizerType}</td>
              <td class="p-3.5 font-mono text-ink">{mat.temperatureCeilingC}°C</td>
              <td class="p-3.5 font-mono text-ink">{mat.chemicalLeachRateUgMin} μg/min</td>
              <td class="p-3.5 text-body">{mat.fdaEuStatus}</td>
              <td class="p-3.5 font-bold">
                {mat.chemicalLeachRateUgMin === 0 ? (
                  <span class="text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200">GOLD MASTER INERT</span>
                ) : mat.chemicalLeachRateUgMin > 20 ? (
                  <span class="text-red-700 bg-red-50 px-2 py-0.5 rounded-full border border-red-200">CRITICAL HAZARD</span>
                ) : (
                  <span class="text-amber-700 bg-amber-50 px-2 py-0.5 rounded-full border border-amber-200">CAUTION</span>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- 5 Golden Rules of Microwave Cover Safety -->
  <div class="bg-surface-soft p-6 md:p-8 rounded-2xl border border-hairline">
    <div class="mb-6">
      <h3 class="text-lg font-bold text-ink">
        {d.rulesTitle}
      </h3>
      <p class="text-xs text-body mt-0.5">
        {d.rulesSub}
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <div class="space-y-1.5">
        <h4 class="text-sm font-bold text-ink">{d.rule1Title}</h4>
        <p class="text-xs text-body leading-relaxed">{d.rule1Text}</p>
      </div>
      <div class="space-y-1.5">
        <h4 class="text-sm font-bold text-ink">{d.rule2Title}</h4>
        <p class="text-xs text-body leading-relaxed">{d.rule2Text}</p>
      </div>
      <div class="space-y-1.5">
        <h4 class="text-sm font-bold text-ink">{d.rule3Title}</h4>
        <p class="text-xs text-body leading-relaxed">{d.rule3Text}</p>
      </div>
      <div class="space-y-1.5">
        <h4 class="text-sm font-bold text-ink">{d.rule4Title}</h4>
        <p class="text-xs text-body leading-relaxed">{d.rule4Text}</p>
      </div>
      <div class="space-y-1.5 md:col-span-2 lg:col-span-2">
        <h4 class="text-sm font-bold text-ink">{d.rule5Title}</h4>
        <p class="text-xs text-body leading-relaxed">{d.rule5Text}</p>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ steamData }}>
  (function() {
    const coverSelect = document.getElementById('cover-material-select');
    const foodSelect = document.getElementById('food-matrix-select');
    const ventSelect = document.getElementById('vent-mode-select');
    const wearSelect = document.getElementById('wear-level-select');
    const durationSlider = document.getElementById('duration-slider');
    const wattsSlider = document.getElementById('watts-slider');

    const durationValDisplay = document.getElementById('duration-val-display');
    const wattsValDisplay = document.getElementById('watts-val-display');

    const hazardCard = document.getElementById('hazard-card');
    const hazardBadge = document.getElementById('hazard-badge');
    const hazardScoreNum = document.getElementById('hazard-score-num');
    const hazardProgressBar = document.getElementById('hazard-progress-bar');
    const hazardSummaryText = document.getElementById('hazard-summary-text');

    const chemicalDoseDisplay = document.getElementById('chemical-dose-display');
    const chemicalPpmDisplay = document.getElementById('chemical-ppm-display');
    const condensateVolumeDisplay = document.getElementById('condensate-volume-display');
    const refluxVelocityDisplay = document.getElementById('reflux-velocity-display');

    const primaryMigrantDisplay = document.getElementById('primary-migrant-display');
    const regulatoryStatusDisplay = document.getElementById('regulatory-status-display');
    const endocrineRiskDisplay = document.getElementById('endocrine-risk-display');

    const clinicalAlertBox = document.getElementById('clinical-alert-box');
    const alertIcon = document.getElementById('alert-icon');
    const alertTitle = document.getElementById('alert-title');
    const alertDetailedText = document.getElementById('alert-detailed-text');

    const copyBtn = document.getElementById('copy-report-btn');
    const copyFeedback = document.getElementById('copied-feedback');
    const presetButtons = document.querySelectorAll('.preset-btn');

    if (!coverSelect || !foodSelect || !ventSelect || !wearSelect || !durationSlider || !wattsSlider) return;

    function calculateHazard() {
      const coverId = coverSelect.value;
      const foodId = foodSelect.value;
      const ventId = ventSelect.value;
      const wearId = wearSelect.value;
      const duration = parseFloat(durationSlider.value);
      const watts = parseInt(wattsSlider.value, 10);

      durationValDisplay.textContent = duration.toFixed(1) + ' min';
      wattsValDisplay.textContent = watts + ' W';

      const cover = steamData.coverMaterials.find(c => c.id === coverId) || steamData.coverMaterials[0];
      const food = steamData.foodMatrices.find(f => f.id === foodId) || steamData.foodMatrices[0];
      const vent = steamData.steamVentStates.find(v => v.id === ventId) || steamData.steamVentStates[0];
      const wear = steamData.wearLevels.find(w => w.id === wearId) || steamData.wearLevels[0];

      // Physical Thermodynamics & Extraction Calculations
      // Wattage factor: 1000W benchmark
      const powerFactor = Math.pow(watts / 1000, 1.25);
      
      // Condensate Generation: Food steam rate * time * powerFactor * vent retention
      const rawSteamGeneratedMl = food.steamGenerationRateMlMin * duration * powerFactor;
      const condensateRefluxMl = rawSteamGeneratedMl * (vent.steamRetentionPercent / 100) * 0.45;
      const dropletCount = Math.round((condensateRefluxMl * 1000) / 50); // ~50 μL per drop

      // Chemical Migration (μg): Base leach rate * duration * lipid multiplier * wear multiplier * vent temperature multiplier
      const fatBoost = 1 + ((cover.fatLipophilicMultiplier - 1) * (food.fatContentPercent / 20));
      const tempBoost = 1 + (vent.ceilingTempElevationC / 50);
      
      let totalMigrantUg = 0;
      if (cover.chemicalLeachRateUgMin > 0) {
        totalMigrantUg = cover.chemicalLeachRateUgMin * duration * fatBoost * wear.migrationMultiplier * tempBoost * powerFactor;
      }

      // Concentration in a standard 300g food portion (ppm = mg/kg)
      const foodPortionKg = 0.30;
      const migrantPpm = (totalMigrantUg / 1000) / foodPortionKg;

      // Hazard Index (0 to 100)
      let hazardIndex = 0;
      if (cover.id === 'borosilicate-glass-dome') {
        hazardIndex = 2;
      } else if (cover.id === 'platinum-silicone-lid') {
        hazardIndex = Math.min(15, Math.round(4 + (duration * 0.5)));
      } else if (cover.id === 'virgin-microwave-pp5') {
        hazardIndex = Math.min(48, Math.round(18 + (totalMigrantUg * 0.4) + (food.fatContentPercent * 0.5)));
      } else if (cover.id === 'aged-degraded-pp5') {
        hazardIndex = Math.min(78, Math.round(35 + (totalMigrantUg * 0.35) + (wear.migrationMultiplier * 5)));
      } else if (cover.id === 'polycarbonate-bpa') {
        hazardIndex = Math.min(94, Math.round(52 + (totalMigrantUg * 0.6) + (duration * 3)));
      } else {
        // cheap-flexible-pvc
        hazardIndex = Math.min(100, Math.round(65 + (totalMigrantUg * 0.25) + (fatBoost * 4)));
      }

      // Display Numerical Outputs
      hazardScoreNum.textContent = hazardIndex;
      hazardProgressBar.style.width = Math.min(100, Math.max(5, hazardIndex)) + '%';
      chemicalDoseDisplay.textContent = totalMigrantUg < 0.1 ? '< 0.05 μg' : totalMigrantUg.toFixed(1) + ' μg';
      chemicalPpmDisplay.textContent = migrantPpm < 0.001 ? '< 0.001 ppm' : migrantPpm.toFixed(3) + ' ppm in food';
      condensateVolumeDisplay.textContent = condensateRefluxMl.toFixed(1) + ' mL';
      refluxVelocityDisplay.textContent = '~' + dropletCount + ' droplets refluxed';

      // Primary Migrant String
      if (cover.id === 'borosilicate-glass-dome') {
        primaryMigrantDisplay.textContent = 'None (100% Inert Vitreous)';
      } else if (cover.id === 'platinum-silicone-lid') {
        primaryMigrantDisplay.textContent = 'Trace Cyclic Siloxanes (<0.01 μg)';
      } else if (cover.id === 'virgin-microwave-pp5') {
        primaryMigrantDisplay.textContent = 'Oleamide & Propylene Oligomers';
      } else if (cover.id === 'aged-degraded-pp5') {
        primaryMigrantDisplay.textContent = 'Cyclic PP Oligomers & Degraded Phenols';
      } else if (cover.id === 'polycarbonate-bpa') {
        primaryMigrantDisplay.textContent = 'Monomeric Bisphenol A (BPA)';
      } else {
        primaryMigrantDisplay.textContent = 'Ortho-Phthalates (DEHP / DINP)';
      }

      // Regulatory Indicator
      if (cover.id === 'borosilicate-glass-dome' || cover.id === 'platinum-silicone-lid') {
        regulatoryStatusDisplay.textContent = 'COMPLIANT (GRAS)';
        regulatoryStatusDisplay.className = 'font-bold text-emerald-700';
        endocrineRiskDisplay.textContent = 'NONE DETECTED';
        endocrineRiskDisplay.className = 'font-bold text-emerald-700';
      } else if (cover.id === 'virgin-microwave-pp5') {
        if (food.fatContentPercent > 15) {
          regulatoryStatusDisplay.textContent = 'CAUTION: FATTY REFLUX';
          regulatoryStatusDisplay.className = 'font-bold text-amber-700';
          endocrineRiskDisplay.textContent = 'LOW / TRACE';
          endocrineRiskDisplay.className = 'font-bold text-amber-700';
        } else {
          regulatoryStatusDisplay.textContent = 'COMPLIANT (FDA 21 CFR)';
          regulatoryStatusDisplay.className = 'font-bold text-emerald-700';
          endocrineRiskDisplay.textContent = 'NEGLIGIBLE';
          endocrineRiskDisplay.className = 'font-bold text-emerald-700';
        }
      } else if (cover.id === 'aged-degraded-pp5') {
        regulatoryStatusDisplay.textContent = 'MICRO-OLIGOMER RISK';
        regulatoryStatusDisplay.className = 'font-bold text-amber-700';
        endocrineRiskDisplay.textContent = 'MODERATE (Oligomer/Additive)';
        endocrineRiskDisplay.className = 'font-bold text-amber-700';
      } else if (cover.id === 'polycarbonate-bpa') {
        regulatoryStatusDisplay.textContent = 'VIOLATES EFSA 2023 BPA LIMIT';
        regulatoryStatusDisplay.className = 'font-bold text-red-700';
        endocrineRiskDisplay.textContent = 'SEVERE (Estrogenic BPA)';
        endocrineRiskDisplay.className = 'font-bold text-red-700';
      } else {
        // PVC
        regulatoryStatusDisplay.textContent = 'BANNED IN EU (EU 10/2011)';
        regulatoryStatusDisplay.className = 'font-bold text-red-700';
        endocrineRiskDisplay.textContent = 'CRITICAL (Anti-Androgenic Phthalates)';
        endocrineRiskDisplay.className = 'font-bold text-red-700';
      }

      // Hazard Color Grading
      if (hazardIndex <= 20) {
        hazardCard.className = 'p-5 rounded-2xl border transition-all duration-300 bg-emerald-50 border-emerald-200';
        hazardBadge.className = 'px-2.5 py-0.5 rounded-full text-xs font-extrabold tracking-wide uppercase bg-emerald-100 text-emerald-800';
        hazardBadge.textContent = 'SAFE / LOW RISK';
        hazardProgressBar.className = 'h-full bg-emerald-500 transition-all duration-500';
        hazardSummaryText.textContent = 'Minimal chemical migration. Steam condensate droplets contain negligible synthetic additives.';
        clinicalAlertBox.className = 'p-6 rounded-2xl border mb-10 bg-emerald-50 border-emerald-200 transition-all';
        alertIcon.textContent = '✅';
        alertTitle.textContent = 'Clean Food Contact: Negligible Extraction';
        alertDetailedText.textContent = 'Optimal metallurgical and material hygiene. The cover does not release phthalate plasticizers or bisphenols under boiling microwave steam. Droplets refluxing into the dish remain safe for consumption.';
      } else if (hazardIndex <= 45) {
        hazardCard.className = 'p-5 rounded-2xl border transition-all duration-300 bg-amber-50 border-amber-200';
        hazardBadge.className = 'px-2.5 py-0.5 rounded-full text-xs font-extrabold tracking-wide uppercase bg-amber-100 text-amber-800';
        hazardBadge.textContent = 'ELEVATED / CAUTION';
        hazardProgressBar.className = 'h-full bg-amber-500 transition-all duration-500';
        hazardSummaryText.textContent = 'Moderate chemical leaching. Hot fat splatters and prolonged boiling steam are beginning to extract polymer slip agents and oligomers.';
        clinicalAlertBox.className = 'p-6 rounded-2xl border mb-10 bg-amber-50 border-amber-200 transition-all';
        alertIcon.textContent = '⚠️';
        alertTitle.textContent = 'Caution: Fat-Enhanced Additive Leaching';
        alertDetailedText.textContent = 'Notice: Lipid splatters are dissolving low-molecular-weight additives from the cover. Ensure the steam vent is open to minimize reflux dripping, or switch to an inverted ceramic plate for greasy foods.';
      } else if (hazardIndex <= 75) {
        hazardCard.className = 'p-5 rounded-2xl border transition-all duration-300 bg-orange-50 border-orange-200';
        hazardBadge.className = 'px-2.5 py-0.5 rounded-full text-xs font-extrabold tracking-wide uppercase bg-orange-100 text-orange-800';
        hazardBadge.textContent = 'HIGH REFLUX TOXICITY HAZARD';
        hazardProgressBar.className = 'h-full bg-orange-500 transition-all duration-500';
        hazardSummaryText.textContent = 'High chemical migration. Degraded polymer fissures or hydrolyzing polycarbonate are washing significant monomeric and oligomeric loads into food.';
        clinicalAlertBox.className = 'p-6 rounded-2xl border mb-10 bg-orange-50 border-orange-200 transition-all';
        alertIcon.textContent = '🚨';
        alertTitle.textContent = 'Hazard Alert: Severe Polymer Reflux Contamination';
        alertDetailedText.textContent = 'Warning: Hundreds of micro-droplets containing extracted synthetic oligomers or bisphenols have dripped into your food. This cover has degraded past safe limits and should be retired from kitchen service immediately.';
      } else {
        hazardCard.className = 'p-5 rounded-2xl border transition-all duration-300 bg-red-50 border-red-300';
        hazardBadge.className = 'px-2.5 py-0.5 rounded-full text-xs font-extrabold tracking-wide uppercase bg-red-200 text-red-900 animate-pulse';
        hazardBadge.textContent = 'CRITICAL PHTHALATE EXPOSURE HAZARD';
        hazardProgressBar.className = 'h-full bg-red-600 transition-all duration-500';
        hazardSummaryText.textContent = 'CRITICAL ENDOCRINE TOXICITY: Low-molecular-weight ortho-phthalates (DEHP) are being stripped into hot lipid splatters and steam condensate.';
        clinicalAlertBox.className = 'p-6 rounded-2xl border mb-10 bg-red-50 border-red-300 transition-all';
        alertIcon.textContent = '☠️';
        alertTitle.textContent = 'Critical Endocrine Disruption Hazard';
        alertDetailedText.textContent = 'Toxicological Emergency: Heating fatty food under flexible PVC generates dangerous phthalate migration (DEHP/DINP) far exceeding EU SML limits (1.5 mg/kg). Daily exposure is linked to anti-androgenic reproductive toxicity, insulin resistance, and hepatic stress. Discard this cover immediately.';
      }
    }

    // Attach Input Event Listeners
    coverSelect.addEventListener('change', calculateHazard);
    foodSelect.addEventListener('change', calculateHazard);
    ventSelect.addEventListener('change', calculateHazard);
    wearSelect.addEventListener('change', calculateHazard);
    durationSlider.addEventListener('input', calculateHazard);
    wattsSlider.addEventListener('input', calculateHazard);

    // Preset Button Click Handlers
    presetButtons.forEach(btn => {
      btn.addEventListener('click', function() {
        const p = this.getAttribute('data-preset');
        if (p === 'pizza-pvc') {
          coverSelect.value = 'cheap-flexible-pvc';
          foodSelect.value = 'high-fat-chili-cheese';
          ventSelect.value = 'sealed-closed';
          wearSelect.value = 'moderate-wear';
          durationSlider.value = 3.5;
          wattsSlider.value = 1000;
        } else if (p === 'soup-pc') {
          coverSelect.value = 'polycarbonate-bpa';
          foodSelect.value = 'chicken-soup-broth';
          ventSelect.value = 'sealed-closed';
          wearSelect.value = 'severe-crazed';
          durationSlider.value = 5.0;
          wattsSlider.value = 1100;
        } else if (p === 'chili-pp') {
          coverSelect.value = 'aged-degraded-pp5';
          foodSelect.value = 'high-fat-chili-cheese';
          ventSelect.value = 'adjustable-half';
          wearSelect.value = 'severe-crazed';
          durationSlider.value = 4.0;
          wattsSlider.value = 900;
        } else if (p === 'rice-pp') {
          coverSelect.value = 'virgin-microwave-pp5';
          foodSelect.value = 'starchy-rice-potatoes';
          ventSelect.value = 'wide-open-ports';
          wearSelect.value = 'pristine-new';
          durationSlider.value = 2.5;
          wattsSlider.value = 800;
        } else if (p === 'silicone') {
          coverSelect.value = 'platinum-silicone-lid';
          foodSelect.value = 'bacon-grease-sausage';
          ventSelect.value = 'adjustable-half';
          wearSelect.value = 'pristine-new';
          durationSlider.value = 2.0;
          wattsSlider.value = 900;
        } else if (p === 'glass') {
          coverSelect.value = 'borosilicate-glass-dome';
          foodSelect.value = 'acidic-tomato-marinara';
          ventSelect.value = 'wide-open-ports';
          wearSelect.value = 'pristine-new';
          durationSlider.value = 6.0;
          wattsSlider.value = 1200;
        }
        calculateHazard();
      });
    });

    // Copy Diagnostic Report
    if (copyBtn) {
      copyBtn.addEventListener('click', function() {
        const report = `ISITKITCHENSAFE MICROWAVE PLASTIC STEAM COVER TOXICOLOGY REPORT
------------------------------------------------------------
Cover Material: ${coverSelect.options[coverSelect.selectedIndex].text}
Food Matrix: ${foodSelect.options[foodSelect.selectedIndex].text}
Steam Vent State: ${ventSelect.options[ventSelect.selectedIndex].text}
Cover Degradation Level: ${wearSelect.options[wearSelect.selectedIndex].text}
Heating Duration: ${durationSlider.value} minutes
Microwave Power: ${wattsSlider.value} Watts

DIAGNOSTIC FINDINGS:
Hazard Severity Score: ${hazardScoreNum.textContent} / 100 [${hazardBadge.textContent.trim()}]
Estimated Chemical Leached: ${chemicalDoseDisplay.textContent} (${chemicalPpmDisplay.textContent})
Condensate Reflux Volume: ${condensateVolumeDisplay.textContent} (${refluxVelocityDisplay.textContent})
Primary Chemical Migrant: ${primaryMigrantDisplay.textContent}
Regulatory Compliance: ${regulatoryStatusDisplay.textContent}
Endocrine Disruption Risk: ${endocrineRiskDisplay.textContent}

CLINICAL SAFETY VERDICT:
${alertDetailedText.textContent.trim()}
------------------------------------------------------------
Verified via IsItKitchenSafe Autonomous Growth & Ops Engine v2.0`;

        navigator.clipboard.writeText(report).then(() => {
          copyFeedback.style.opacity = '1';
          setTimeout(() => { copyFeedback.style.opacity = '0'; }, 3000);
        });
      });
    }

    calculateHazard();
  })();
</script>
