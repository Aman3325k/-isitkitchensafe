<script is:inline define:vars={{ data }}>
  function initColloidMillModeler() {
    const millSelect = document.getElementById('mill-architecture-select');
    const fluidSelect = document.getElementById('fluid-matrix-select');
    const metalSelect = document.getElementById('metallurgy-select');

    const rpmSlider = document.getElementById('rpm-slider');
    const gapSlider = document.getElementById('gap-slider');
    const flowSlider = document.getElementById('flow-slider');
    const inletTempSlider = document.getElementById('inlet-temp-slider');
    const coolingFlowSlider = document.getElementById('cooling-flow-slider');

    const rpmVal = document.getElementById('rpm-val');
    const gapVal = document.getElementById('gap-val');
    const flowVal = document.getElementById('flow-val');
    const inletTempVal = document.getElementById('inlet-temp-val');
    const coolingFlowVal = document.getElementById('cooling-flow-val');

    const outShearRate = document.getElementById('out-shear-rate');
    const shearBar = document.getElementById('shear-bar');
    const shearStatus = document.getElementById('shear-status');

    const outViscousHeat = document.getElementById('out-viscous-heat');
    const heatBar = document.getElementById('heat-bar');
    const heatStatus = document.getElementById('heat-status');

    const outExitTemp = document.getElementById('out-exit-temp');
    const tempBar = document.getElementById('temp-bar');
    const tempStatus = document.getElementById('temp-status');

    const outParticleSize = document.getElementById('out-particle-size');
    const particleBar = document.getElementById('particle-bar');
    const particleStatus = document.getElementById('particle-status');

    const outSealTemp = document.getElementById('out-seal-temp');
    const sealBar = document.getElementById('seal-bar');
    const sealStatus = document.getElementById('seal-status');

    const outCipScore = document.getElementById('out-cip-score');
    const cipBar = document.getElementById('cip-bar');
    const cipStatus = document.getElementById('cip-status');

    const safetyBadge = document.getElementById('safety-badge');
    const hazardDetail = document.getElementById('hazard-detail');
    const mechanismsDetail = document.getElementById('mechanisms-detail');
    const mitigationDetail = document.getElementById('mitigation-detail');

    const copyBtn = document.getElementById('copy-report-btn');
    const copyBtnText = document.getElementById('copy-btn-text');

    function recalculate() {
      if (!millSelect || !fluidSelect || !metalSelect) return;

      const mill = data.millArchitectures.find(m => m.id === millSelect.value) || data.millArchitectures[0];
      const fluid = data.commodityProfiles.find(f => f.id === fluidSelect.value) || data.commodityProfiles[0];
      const metal = data.metallurgyCoatings.find(c => c.id === metalSelect.value) || data.metallurgyCoatings[0];

      const rpm = parseFloat(rpmSlider.value);
      const gapMicrons = parseFloat(gapSlider.value);
      const flowRateKgHr = parseFloat(flowSlider.value);
      const inletTempC = parseFloat(inletTempSlider.value);
      const coolingLpm = parseFloat(coolingFlowSlider.value);

      // Display Slider Text Values
      if (rpmVal) rpmVal.textContent = `${rpm} RPM`;
      if (gapVal) gapVal.textContent = `${gapMicrons} µm`;
      if (flowVal) flowVal.textContent = `${flowRateKgHr} kg/hr`;
      if (inletTempVal) {
        const fahrenheit = Math.round(inletTempC * 9/5 + 32);
        inletTempVal.textContent = `${inletTempC}°C (${fahrenheit}°F)`;
      }
      if (coolingFlowVal) coolingFlowVal.textContent = `${coolingLpm.toFixed(1)} L/min`;

      // 1. Fluid Dynamics & Shear Rate Calculation:
      // Tip Speed: v_tip = (pi * D * N) / 60
      const tipSpeedMs = (Math.PI * mill.rotorDiameterM * rpm) / 60; // m/s
      // Gap in meters: delta = gapMicrons * 1e-6
      const gapMeters = gapMicrons * 1e-6;
      // Shear rate: gamma_dot = v_tip / delta
      const shearRate = Math.round(tipSpeedMs / gapMeters); // s^-1

      // 2. Non-Newtonian Apparent Viscosity (Power-Law Model: mu_app = K * gamma_dot^(n - 1))
      // Normalized from base viscosity at reference shear rate 1,000 s^-1
      const refShear = 1000.0;
      const consistencyK = (fluid.baseViscosityCp * 1e-3) / Math.pow(refShear, fluid.shearThinningIndex - 1); // Pa*s^n
      const apparentViscosityPaS = consistencyK * Math.pow(Math.max(100, shearRate), fluid.shearThinningIndex - 1); // Pa*s

      // 3. Viscous Dissipation Power (P = mu_app * gamma_dot^2 * Volume_gap)
      // Volume_gap approx: pi * D * L * delta
      const gapVolumeM3 = Math.PI * mill.rotorDiameterM * mill.rotorLengthM * gapMeters;
      const viscousPowerWatts = apparentViscosityPaS * Math.pow(shearRate, 2) * gapVolumeM3;
      const viscousPowerKw = viscousPowerWatts / 1000.0;

      // 4. Stator Cooling Jacket Heat Removal: Q_cool = U * A * LMTD
      // Effective heat transfer coefficient based on water flow rate
      const effectiveU = mill.coolingJacketUFactor * Math.min(1.2, Math.sqrt(Math.max(0.05, coolingLpm / (mill.coolingJacketCapacityLpm || 20))));
      const coolantTempC = 12.0; // Standard industrial chilled water
      const meanShearTempEstimate = inletTempC + Math.min(40, viscousPowerKw * 1.5);
      const lmtd = Math.max(5.0, meanShearTempEstimate - coolantTempC);
      let coolingPowerKw = (effectiveU * mill.jacketAreaM2 * lmtd) / 1000.0;
      if (mill.coolingJacketCapacityLpm === 0 || coolingLpm === 0) {
        coolingPowerKw = 0.4; // Only natural air convection
      }

      // Net Heat added to fluid
      const netThermalPowerKw = Math.max(0, viscousPowerKw - coolingPowerKw);
      // Fluid mass flow in kg/s
      const massFlowKgS = Math.max(0.01, flowRateKgHr / 3600.0);
      // Temperature rise: Delta T = Net_Power / (m_dot * Cp)
      const deltaTC = (netThermalPowerKw * 1000.0) / (massFlowKgS * fluid.specificHeatJkgK);
      const exitTempC = Math.round((inletTempC + deltaTC) * 10) / 10;
      const exitTempF = Math.round(exitTempC * 9/5 + 32);

      // 5. Droplet / Particle Size Reduction d90:
      // Controlled by Capillary Number Ca and energy density
      const d0 = fluid.targetParticleSizeMicrons * 3.5;
      const shearFactor = Math.pow(150000 / Math.max(10000, shearRate), 0.55);
      const passFactor = Math.pow(3000 / Math.max(200, flowRateKgHr), 0.2);
      let particleSizeMicrons = Math.max(0.8, Math.round(d0 * shearFactor * passFactor * 10) / 10);
      if (mill.id === 'aging_worn_gap_legacy_mill') {
        particleSizeMicrons += 18.0; // Runout unevenness prevents sub-micron comminution
      }

      // 6. Mechanical Face Seal Temperature:
      // Seal cavity temp driven by fluid temp + boundary friction heating
      const sealFrictionHeat = mill.sealType.includes('Double') ? 8.0 : 26.0;
      const sealCavityTempC = Math.round(exitTempC * 0.75 + inletTempC * 0.25 + sealFrictionHeat);

      // 7. 3-A Sanitary Standard 36-01 CIP Cleanability Index (0 to 100):
      let cipScore = 98;
      if (mill.id === 'artisan_corundum_stone_wet_mill') cipScore = 42; // Stone porosity requires COP
      if (mill.id === 'aging_worn_gap_legacy_mill') cipScore = 35; // Pitting & runout harbor biofilm
      if (exitTempC > fluid.thermalDegradationLimitC) cipScore -= 20; // Baked-on carbonized fouling
      if (coolingLpm < 5 && mill.coolingJacketCapacityLpm > 0) cipScore -= 10;
      cipScore = Math.max(10, Math.min(100, cipScore));

      // Update Outputs
      if (outShearRate) outShearRate.textContent = `${shearRate.toLocaleString()} s⁻¹`;
      if (shearBar) {
        const shearPct = Math.min(100, Math.round((shearRate / 250000) * 100));
        shearBar.style.width = `${shearPct}%`;
        shearBar.className = `h-2 rounded-full transition-all duration-300 ${shearRate > 180000 ? 'bg-purple-600' : 'bg-blue-600'}`;
      }
      if (shearStatus) {
        shearStatus.textContent = shearRate > 150000 ? 'High-Intensity Emulsification Shear' : 'Moderate Laminar Wet Milling';
      }

      if (outViscousHeat) outViscousHeat.textContent = `${viscousPowerKw.toFixed(1)} kW`;
      if (heatBar) {
        const heatPct = Math.min(100, Math.round((viscousPowerKw / 40.0) * 100));
        heatBar.style.width = `${heatPct}%`;
        heatBar.className = `h-2 rounded-full transition-all duration-300 ${viscousPowerKw > 25 ? 'bg-red-600' : (viscousPowerKw > 15 ? 'bg-amber-500' : 'bg-blue-600')}`;
      }
      if (heatStatus) {
        heatStatus.textContent = `Jacket removes ~${coolingPowerKw.toFixed(1)} kW heat`;
      }

      if (outExitTemp) {
        outExitTemp.textContent = `${exitTempC}°C (${exitTempF}°F)`;
        outExitTemp.className = `text-2xl font-black font-mono ${exitTempC > fluid.thermalDegradationLimitC ? 'text-red-700' : (exitTempC > fluid.thermalDegradationLimitC - 8 ? 'text-amber-700' : 'text-emerald-700')}`;
      }
      if (tempBar) {
        const tempPct = Math.min(100, Math.round((exitTempC / 100.0) * 100));
        tempBar.style.width = `${tempPct}%`;
        tempBar.className = `h-2 rounded-full transition-all duration-300 ${exitTempC > fluid.thermalDegradationLimitC ? 'bg-red-600' : (exitTempC > fluid.thermalDegradationLimitC - 8 ? 'bg-amber-500' : 'bg-emerald-600')}`;
      }
      if (tempStatus) {
        tempStatus.textContent = exitTempC > fluid.thermalDegradationLimitC ? `OVERHEATING: Exceeds ${fluid.thermalDegradationLimitC}°C limit!` : `Safe Target: < ${fluid.thermalDegradationLimitC}°C`;
        tempStatus.className = exitTempC > fluid.thermalDegradationLimitC ? 'text-red-700 font-bold' : 'text-muted';
      }

      if (outParticleSize) outParticleSize.textContent = `${particleSizeMicrons.toFixed(1)} µm`;
      if (particleBar) {
        const particlePct = Math.min(100, Math.round((particleSizeMicrons / 80.0) * 100));
        particleBar.style.width = `${particlePct}%`;
        particleBar.className = `h-2 rounded-full transition-all duration-300 ${particleSizeMicrons <= fluid.targetParticleSizeMicrons ? 'bg-emerald-600' : 'bg-blue-600'}`;
      }
      if (particleStatus) {
        particleStatus.textContent = particleSizeMicrons <= fluid.targetParticleSizeMicrons ? `Target Met (<= ${fluid.targetParticleSizeMicrons} µm)` : `Coarse Dispersion (> ${fluid.targetParticleSizeMicrons} µm)`;
        particleStatus.className = particleSizeMicrons <= fluid.targetParticleSizeMicrons ? 'text-emerald-700 font-bold' : 'text-muted';
      }

      if (outSealTemp) {
        outSealTemp.textContent = `${sealCavityTempC}°C`;
        outSealTemp.className = `text-2xl font-black font-mono ${sealCavityTempC > mill.sealMaxTempC ? 'text-red-700' : (sealCavityTempC > 95 ? 'text-amber-700' : 'text-emerald-700')}`;
      }
      if (sealBar) {
        const sealPct = Math.min(100, Math.round((sealCavityTempC / 150.0) * 100));
        sealBar.style.width = `${sealPct}%`;
        sealBar.className = `h-2 rounded-full transition-all duration-300 ${sealCavityTempC > mill.sealMaxTempC ? 'bg-red-600' : 'bg-emerald-600'}`;
      }
      if (sealStatus) {
        sealStatus.textContent = sealCavityTempC > mill.sealMaxTempC ? 'SEAL VAPORIZATION & CARBONIZATION RISK!' : `Safe Seal Boundary (Max ${mill.sealMaxTempC}°C)`;
        sealStatus.className = sealCavityTempC > mill.sealMaxTempC ? 'text-red-700 font-bold' : 'text-muted';
      }

      if (outCipScore) {
        outCipScore.textContent = `${cipScore} / 100`;
        outCipScore.className = `text-2xl font-black font-mono ${cipScore < 60 ? 'text-red-700' : (cipScore < 85 ? 'text-amber-700' : 'text-emerald-700')}`;
      }
      if (cipBar) {
        cipBar.style.width = `${cipScore}%`;
        cipBar.className = `h-2 rounded-full transition-all duration-300 ${cipScore < 60 ? 'bg-red-600' : (cipScore < 85 ? 'bg-amber-500' : 'bg-emerald-600')}`;
      }
      if (cipStatus) {
        cipStatus.textContent = cipScore >= 90 ? '3-A Standard 36-01 CIP Validated' : (cipScore >= 60 ? 'Moderate COP Disassembly Required' : 'Critical Biofilm & Spalling Non-Compliance');
        cipStatus.className = cipScore < 60 ? 'text-red-700 font-bold' : 'text-muted';
      }

      // Overall Safety & Compliance Classification
      const isThermalFailure = exitTempC > fluid.thermalDegradationLimitC;
      const isSealFailure = sealCavityTempC > mill.sealMaxTempC;
      const isMechanicalSpall = mill.id === 'aging_worn_gap_legacy_mill';

      if (isMechanicalSpall) {
        if (safetyBadge) {
          safetyBadge.textContent = 'CRITICAL_METALLIC_SPALLING_HAZARD';
          safetyBadge.className = 'px-3 py-1.5 rounded-full text-xs font-bold tracking-wide uppercase bg-rose-100 text-rose-900 border border-rose-400 font-mono';
        }
        if (hazardDetail) hazardDetail.textContent = 'Rotor shaft runout (>60 µm) and bearing deflection cause intermittent tooth-to-tooth metallic rubbing, shedding carcinogenic stainless steel / cobalt micro-particulates directly into the food stream.';
        if (mechanismsDetail) mechanismsDetail.textContent = `Shear gap of ${gapMicrons} µm is compromised by ±65 µm axial wobble. Local contact stresses exceed material shear strength, generating metal spalls and degrading seal elastomer rings.`;
        if (mitigationDetail) mitigationDetail.textContent = 'Immediate shutdown required. Replace worn spindle bearings, re-balance rotor assembly to ISO 1940 Grade G1.0, and install magnetic traps and 25-micron inline sanitary filter strainers.';
      } else if (isThermalFailure || isSealFailure) {
        if (safetyBadge) {
          safetyBadge.textContent = 'THERMAL_OVERHEATING_&_SEAL_CARBONIZATION';
          safetyBadge.className = 'px-3 py-1.5 rounded-full text-xs font-bold tracking-wide uppercase bg-red-100 text-red-900 border border-red-400 font-mono';
        }
        if (hazardDetail) hazardDetail.textContent = `Exit product temperature (${exitTempC}°C) exceeds the ${fluid.thermalDegradationLimitC}°C degradation limit. Food solids bake onto the hot rotor teeth, while seal cavity fluid films flash dry, carbonizing organic matter onto seal faces.`;
        if (mechanismsDetail) mechanismsDetail.textContent = `Viscous dissipation of ${viscousPowerKw.toFixed(1)} kW outpaces the cooling capacity (${coolingPowerKw.toFixed(1)} kW), generating an excessive net adiabatic rise of +${deltaTC.toFixed(1)}°C.`;
        if (mitigationDetail) mitigationDetail.textContent = `Increase cooling jacket flow to >= 25 L/min or increase flow throughput rate to reduce shear chamber residence time. Ensure double mechanical seal buffer quench pressure is verified.`;
      } else {
        if (safetyBadge) {
          safetyBadge.textContent = '100%_3A_CIP_COMPLIANT';
          safetyBadge.className = 'px-3 py-1.5 rounded-full text-xs font-bold tracking-wide uppercase bg-emerald-100 text-emerald-800 border border-emerald-300 font-mono';
        }
        if (hazardDetail) hazardDetail.textContent = 'Zero thermal degradation or mechanical spalling. Emulsion droplet breakdown progresses efficiently within certified safe hydrodynamic and thermal boundaries.';
        if (mechanismsDetail) mechanismsDetail.textContent = `Fluid shear rate of ${shearRate.toLocaleString()} s⁻¹ achieves target micronization (${particleSizeMicrons.toFixed(1)} µm) while stator water jacket removes ${coolingPowerKw.toFixed(1)} kW of viscous dissipation heat.`;
        if (mitigationDetail) mitigationDetail.textContent = 'Maintain automated CIP verification cycles (flow >= 1.5 m/s). Verify annual laser alignment of spindle bearings and monitor seal barrier fluid pressure differential.';
      }
    }

    // Preset Handlers
    document.getElementById('preset-peanut-btn')?.addEventListener('click', () => {
      millSelect.value = 'industrial_continuous_toothed_colloid_mill';
      fluidSelect.value = 'peanut_butter_nut_paste';
      metalSelect.value = 'tungsten_carbide_flame_spray';
      rpmSlider.value = '5400';
      gapSlider.value = '35';
      flowSlider.value = '3200';
      inletTempSlider.value = '24';
      coolingFlowSlider.value = '28';
      recalculate();
    });

    document.getElementById('preset-mayo-btn')?.addEventListener('click', () => {
      millSelect.value = 'sanitary_conical_microgap_colloid_mill';
      fluidSelect.value = 'mayonnaise_salad_emulsion';
      metalSelect.value = '316l_stainless_passivated';
      rpmSlider.value = '6200';
      gapSlider.value = '55';
      flowSlider.value = '1100';
      inletTempSlider.value = '16';
      coolingFlowSlider.value = '16';
      recalculate();
    });

    document.getElementById('preset-seal-btn')?.addEventListener('click', () => {
      millSelect.value = 'artisan_corundum_stone_wet_mill';
      fluidSelect.value = 'peanut_butter_nut_paste';
      metalSelect.value = '316l_stainless_passivated';
      rpmSlider.value = '3600';
      gapSlider.value = '40';
      flowSlider.value = '180';
      inletTempSlider.value = '25';
      coolingFlowSlider.value = '0';
      recalculate();
    });

    document.getElementById('preset-spall-btn')?.addEventListener('click', () => {
      millSelect.value = 'aging_worn_gap_legacy_mill';
      fluidSelect.value = 'hot_chili_mustard_condiment';
      metalSelect.value = '316l_stainless_passivated';
      rpmSlider.value = '4800';
      gapSlider.value = '180';
      flowSlider.value = '650';
      inletTempSlider.value = '20';
      coolingFlowSlider.value = '2';
      recalculate();
    });

    // Copy Telemetry Report
    copyBtn?.addEventListener('click', () => {
      const report = `======================================================================
ISITKITCHENSAFE COLLOID MILL RHEOLOGY & SHEAR TELEMETRY REPORT
Standard: 3-A Sanitary Standard 36-01, EHEDG Doc 8 & FDA 21 CFR 110
Generated: ${new Date().toISOString()}
======================================================================
[EQUIPMENT & FLUID MATRIX]
- Colloid Mill: ${millSelect.value}
- Fluid Commodity: ${fluidSelect.value}
- Metallurgy: ${metalSelect.value}
- Rotor Speed: ${rpmSlider.value} RPM
- Micro-Gap Clearance: ${gapSlider.value} µm
- Mass Flow Rate: ${flowSlider.value} kg/hr
- Stator Cooling Water Flow: ${coolingFlowSlider.value} L/min

[RHEOLOGICAL & THERMAL DIAGNOSTICS]
- Micro-Gap Shear Rate: ${outShearRate?.textContent}
- Viscous Power Dissipated: ${outViscousHeat?.textContent}
- Product Exit Temperature: ${outExitTemp?.textContent}
- Emulsion Particle Size (d90): ${outParticleSize?.textContent}
- Mechanical Seal Temp: ${outSealTemp?.textContent}
- 3-A 36-01 CIP Cleanability Score: ${outCipScore?.textContent}
- Overall Sanitary Status: ${safetyBadge?.textContent}
======================================================================`;

      navigator.clipboard.writeText(report).then(() => {
        if (copyBtnText) copyBtnText.textContent = "Copied to Clipboard!";
        setTimeout(() => {
          if (copyBtnText) copyBtnText.textContent = "Copy Telemetry Report to Clipboard";
        }, 2500);
      }).catch(() => {
        alert("Telemetry report prepared in console.");
      });
    });

    // Attach Listeners
    [millSelect, fluidSelect, metalSelect].forEach(el => el?.addEventListener('change', recalculate));
    [rpmSlider, gapSlider, flowSlider, inletTempSlider, coolingFlowSlider].forEach(el => el?.addEventListener('input', recalculate));

    // Initial Trigger
    recalculate();
  }

  initColloidMillModeler();
  document.addEventListener('astro:page-load', initColloidMillModeler);
</script>
