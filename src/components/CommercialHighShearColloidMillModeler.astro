const d = DICTIONARY[lang] || DICTIONARY.en;
const data = colloidData;
---

<div class="bg-surface-soft border border-hairline rounded-3xl p-6 sm:p-8 md:p-10 shadow-sm max-w-5xl mx-auto my-8 font-sans">
  <!-- Header Banner -->
  <div class="mb-8 border-b border-hairline/80 pb-6">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold tracking-wide uppercase bg-blue-700/10 text-blue-900 mb-3 border border-blue-700/20">
      <span class="w-2 h-2 rounded-full bg-blue-600 animate-pulse"></span>
      {d.badge}
    </div>
    <h2 class="text-display-xs sm:text-display-sm font-bold text-ink tracking-tight mb-2">
      {d.title}
    </h2>
    <p class="text-body text-sm sm:text-base text-muted leading-relaxed max-w-4xl">
      {d.subtitle}
    </p>
  </div>

  <!-- Operational Presets -->
  <div class="mb-8 p-5 bg-surface rounded-2xl border border-hairline">
    <div class="text-xs font-bold uppercase tracking-wider text-muted mb-3 flex items-center gap-1.5">
      <svg class="w-4 h-4 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
      </svg>
      {d.presetsTitle}
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
      <button 
        type="button" 
        id="preset-peanut-btn"
        class="text-left p-3 rounded-xl border border-hairline bg-surface-soft hover:bg-surface-hover hover:border-blue-400 text-xs transition-all flex flex-col gap-1 cursor-pointer"
      >
        <span class="font-bold text-ink text-xs flex items-center justify-between">
          <span>🥜 {d.presetPeanut.split(' (')[0]}</span>
          <span class="px-1.5 py-0.5 rounded bg-emerald-100 text-emerald-800 text-[10px] font-mono">SAFE</span>
        </span>
        <span class="text-muted text-[11px] leading-tight">Continuous Toothed • 35 µm Gap • 5,400 RPM • Active Cooling</span>
      </button>

      <button 
        type="button" 
        id="preset-mayo-btn"
        class="text-left p-3 rounded-xl border border-hairline bg-surface-soft hover:bg-surface-hover hover:border-blue-400 text-xs transition-all flex flex-col gap-1 cursor-pointer"
      >
        <span class="font-bold text-ink text-xs flex items-center justify-between">
          <span>🥚 {d.presetMayo.split(' (')[0]}</span>
          <span class="px-1.5 py-0.5 rounded bg-emerald-100 text-emerald-800 text-[10px] font-mono">SAFE</span>
        </span>
        <span class="text-muted text-[11px] leading-tight">Conical Micro-Gap • 55 µm Gap • 6,200 RPM • Sub-2µm Droplets</span>
      </button>

      <button 
        type="button" 
        id="preset-seal-btn"
        class="text-left p-3 rounded-xl border border-hairline bg-surface-soft hover:bg-surface-hover hover:border-red-400 text-xs transition-all flex flex-col gap-1 cursor-pointer"
      >
        <span class="font-bold text-ink text-xs flex items-center justify-between">
          <span>🔥 {d.presetSealFailure.split(' (')[0]}</span>
          <span class="px-1.5 py-0.5 rounded bg-rose-100 text-rose-800 text-[10px] font-mono">HAZARD</span>
        </span>
        <span class="text-muted text-[11px] leading-tight">Uncooled Corundum Stone • 40 µm • Zero Cooling Water • ΔT &gt; 55°C</span>
      </button>

      <button 
        type="button" 
        id="preset-spall-btn"
        class="text-left p-3 rounded-xl border border-hairline bg-surface-soft hover:bg-surface-hover hover:border-amber-400 text-xs transition-all flex flex-col gap-1 cursor-pointer"
      >
        <span class="font-bold text-ink text-xs flex items-center justify-between">
          <span>⚠️ {d.presetWornSpall.split(' (')[0]}</span>
          <span class="px-1.5 py-0.5 rounded bg-amber-100 text-amber-800 text-[10px] font-mono">WARNING</span>
        </span>
        <span class="text-muted text-[11px] leading-tight">Legacy Worn Mill • 180 µm Gap • 65 µm Spindle Runout • Metallic Spall</span>
      </button>
    </div>
  </div>

  <!-- Interactive Controls Section -->
  <div class="mb-10 p-6 bg-surface rounded-2xl border border-hairline">
    <div class="mb-6">
      <h3 class="text-title-sm font-bold text-ink tracking-tight mb-1">
        {d.controlsTitle}
      </h3>
      <p class="text-xs text-muted leading-relaxed">
        {d.controlsSub}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Select Mill Architecture -->
      <div class="space-y-1.5">
        <label for="mill-architecture-select" class="block text-xs font-bold text-ink">
          {d.millLabel}
        </label>
        <select 
          id="mill-architecture-select" 
          class="w-full text-xs rounded-xl border border-hairline bg-surface-soft p-3 text-ink focus:outline-none focus:ring-2 focus:ring-blue-600 transition-shadow"
        >
          {data.millArchitectures.map((m) => (
            <option value={m.id}>{m.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted leading-tight">{d.millHelp}</p>
      </div>

      <!-- Select Food Fluid -->
      <div class="space-y-1.5">
        <label for="fluid-matrix-select" class="block text-xs font-bold text-ink">
          {d.fluidLabel}
        </label>
        <select 
          id="fluid-matrix-select" 
          class="w-full text-xs rounded-xl border border-hairline bg-surface-soft p-3 text-ink focus:outline-none focus:ring-2 focus:ring-blue-600 transition-shadow"
        >
          {data.commodityProfiles.map((f) => (
