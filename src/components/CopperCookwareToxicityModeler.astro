    rule5Text: "洗碗机专用强碱性洗涤剂（pH高达10-12）会迅速腐蚀溶解柔软的锡层，并导致外层纯铜剧烈氧化发黑发紫。铜锅必须使用中性洗洁精手工轻柔清洗。",
    copyReportBtn: "📋 复制毒理学诊断报告",
    copiedFeedback: "✅ 诊断报告已成功复制到剪贴板！"
  },
  ja: {
    badge: "金属工学・毒性学シミュレーター",
    title: "銅製調理器具・酸性食品銅溶出＆緑青毒性モデラー",
    subtitle: "銅イオン溶出速度、酸性食品の腐食作用、錫（スズ）引きの摩耗、有毒な緑青（ろくしょう）塩の形成、急性胃腸炎リスクを精密シミュレーション。",
    controlsTitle: "銅鍋の材質および調理パラメータ設定",
    controlsSub: "内面ライニング、食品の酸度、緑青・酸化皮膜の状態、加熱時間、温度、摩耗率を設定。",
    panLabel: "銅鍋の基材と内面ライニング：",
    panHelp: "純銅・素銅 vs 伝統的な手引き錫（スズ） vs 現代のステンレス多層 vs アンティーク真鍮。",
    foodLabel: "調理食材の酸性度マトリックス：",
    foodHelp: "食品pH、有機酸の種類（クエン酸、酒石酸、酢酸）、糖・タンパク質緩衝作用。",
    verdigrisLabel: "表面酸化皮膜および緑青（ろくしょう）の状態：",
    verdigrisHelp: "新品の光沢銅から、褐色酸化銅、有毒な塩基性炭酸銅・酢酸銅緑青まで。",
    durationLabel: "煮込み・接触時間（分）：",
    durationHelp: "時間の経過に伴いイオン拡散が進行し、スープへの銅溶出量が指数関数的に増大します。",
    tempLabel: "調理・煮沸温度（°C）：",
    tempHelp: "高温加熱により水素イオンの攻撃とアレニウス反応速度が急激に加速します。",
    wearLabel: "錫（スズ）引き摩耗・露出銅パッチ率（%）：",
    wearHelp: "0% = 錫引き完全健全；100% = 錫完全剥離；20%超で25セント硬貨の再錫引き基準を超過。",
    presetsTitle: "クイック診断シナリオ：",
    presetTomatoWorn: "🍝 錫摩耗銅鍋でのトマトソース煮込み（露出面積が硬貨大以上）",
    presetWineBare: "🍷 素銅鍋での赤ワイン煮込みソース（急性毒性高リスク）",
    presetLemonBare: "🍋 素銅鍋でのレモンカード作り（強酸による激しい緑青溶出）",
    presetJamSafe: "🍓 フランス伝統の純銅ジャム鍋（高糖度・安全調理法）",
    presetCladModern: "🍳 ステンレス内張り複合銅フライパン（現代の完全無害基準）",
    presetEggWhite: "🥚 純銅ボウルでのメレンゲ泡立て（安定なタンパク質キレート）",
    diagnosticTitle: "毒性ハザード・銅溶出スコアカード",
    diagnosticSub: "銅イオンの溶出濃度、緑青塩の急速溶解、臨床的急性毒性リスクをリアルタイム計算。",
    hazardScoreLabel: "毒性リスク総合危険指数",
    copperConcentrationLabel: "計算された銅イオン溶出濃度 (mg/kg / ppm)",
    ingestedDoseLabel: "1食分（250g）あたりの銅元素推定摂取量",
    verdigrisRateLabel: "緑青・銅塩の化学的溶解速度",
    metallicTasteLabel: "金属臭・色調劣化（泥状変色）評価",
    fdaStatusLabel: "米国FDA食品規則 Sec 4-101.14 準拠判定",
    utensilStatusLabel: "調理器具の安全性・再錫引き判定",
    alertTitle: "臨床毒性評価と安全勧告",
    tableTitle: "銅製調理器具の冶金・ライニング比較表",
    tableSub: "熱伝導率、耐酸性、耐熱限界、FDA基準適合性の詳細比較。",
    colSubstrate: "器具の材質",
    colConductivity: "熱拡散率 (W/m·K)",
    colMaxTemp: "安全限界温度 (°C / °F)",
    colAcidReactivity: "耐酸性 (pH < 6.0)",
    colFdaCode: "FDA規則適合性",
    colVerdict: "調理適合判定",
    rulesTitle: "銅鍋の安全管理・使用に関する5大黄金則",
    rulesSub: "金属学と食品衛生学に基づく重金属中毒予防プロトコル。",
    rule1Title: "1. 錫引きは『25セント硬貨ルール』で再加工に出す",
    rule1Text: "錫が剥がれて露出した素銅の面積が25セント硬貨（直径約24mm/面積約4.6cm²）を超えた場合、酸性料理の使用を中止してください。異種金属接触腐食と直接酸腐食により有毒な銅が溶出するため、専門業者による再錫引き（リライニング）が必須です。",
    rule2Title: "2. 素銅や真鍮の鍋で酸性料理を絶対に煮込まない",
    rule2Text: "トマトソース、赤ワイン煮、レモンジャム、お酢を使った料理を素銅鍋で作ってはいけません。FDA基準でもpH 6.0未満の食品への銅の直接接触は急性胃腸炎リスクから禁止されています。",
    rule3Title: "3. 錫引き銅鍋を230°C以上で絶対に空焚きしない",
    rule3Text: "錫の融点はわずか231.9°Cです。強火で空焚きすると90秒以内に錫が溶け、水玉状になって剥がれてしまいます。必ず油や水分を入れてから加熱してください。",
    rule4Title: "4. 調理前に緑色・青緑色の緑青を完全に除去する",
    rule4Text: "緑青（塩基性炭酸銅や酢酸銅）は温かい料理の汁に素早く溶け込みます。リベットや縁に緑色の粉状付着物がある場合、塩と酢またはレモン汁で磨いて洗い流し、完全に乾燥させてください。",
    rule5Title: "5. 銅製調理器具を絶対に食洗機に入れない",
    rule5Text: "食洗機用洗剤の強アルカリ成分（pH 10〜12）は柔らかな錫を化学的に溶かし、外側の銅を黒や紫に変色・腐食させます。中性洗剤で優しく手洗いしてください。",
    copyReportBtn: "📋 毒性診断レポートをコピー",
    copiedFeedback: "✅ 診断レポートをクリップボードにコピーしました！"
  }
};

const d = DICTIONARY[lang] || DICTIONARY.en;
---

<div class="copper-modeler-container bg-surface border border-hairline rounded-3xl p-6 md:p-10 shadow-sm max-w-5xl mx-auto my-8">
  <!-- Interactive Header -->
  <div class="flex flex-wrap items-center justify-between gap-4 mb-8 pb-6 border-b border-hairline">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-amber-100 text-amber-900 mb-2 border border-amber-200">
        <span>⚗️</span>
        {d.badge}
      </div>
      <h2 class="text-2xl md:text-3xl font-extrabold text-ink tracking-tight">
        {d.title}
      </h2>
      <p class="text-sm md:text-base text-body mt-1 max-w-3xl">
        {d.subtitle}
      </p>
    </div>
  </div>

  <!-- Presets -->
  <div class="mb-8 p-5 bg-surface-soft rounded-2xl border border-hairline">
    <div class="text-xs font-mono font-bold uppercase tracking-wider text-amber-800 mb-3">
      {d.presetsTitle}
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2.5">
      <button type="button" class="preset-btn text-left p-3 rounded-xl border border-hairline bg-surface hover:bg-amber-50 hover:border-amber-300 transition-all text-xs font-medium text-ink flex items-center gap-2" data-preset="tomato-worn">
        {d.presetTomatoWorn}
      </button>
      <button type="button" class="preset-btn text-left p-3 rounded-xl border border-hairline bg-surface hover:bg-amber-50 hover:border-amber-300 transition-all text-xs font-medium text-ink flex items-center gap-2" data-preset="wine-bare">
        {d.presetWineBare}
      </button>
      <button type="button" class="preset-btn text-left p-3 rounded-xl border border-hairline bg-surface hover:bg-amber-50 hover:border-amber-300 transition-all text-xs font-medium text-ink flex items-center gap-2" data-preset="lemon-bare">
        {d.presetLemonBare}
      </button>
      <button type="button" class="preset-btn text-left p-3 rounded-xl border border-hairline bg-surface hover:bg-amber-50 hover:border-amber-300 transition-all text-xs font-medium text-ink flex items-center gap-2" data-preset="jam-safe">
        {d.presetJamSafe}
      </button>
      <button type="button" class="preset-btn text-left p-3 rounded-xl border border-hairline bg-surface hover:bg-amber-50 hover:border-amber-300 transition-all text-xs font-medium text-ink flex items-center gap-2" data-preset="clad-modern">
        {d.presetCladModern}
      </button>
      <button type="button" class="preset-btn text-left p-3 rounded-xl border border-hairline bg-surface hover:bg-amber-50 hover:border-amber-300 transition-all text-xs font-medium text-ink flex items-center gap-2" data-preset="egg-white">
        {d.presetEggWhite}
      </button>
    </div>
  </div>

  <!-- Main Controls & Simulator Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-10">
    <!-- Left: Inputs (7 Cols) -->
    <div class="lg:col-span-7 space-y-6">
      <div class="border-b border-hairline pb-3">
        <h3 class="text-base font-bold text-ink">
          {d.controlsTitle}
        </h3>
        <p class="text-xs text-body mt-0.5">
          {d.controlsSub}
        </p>
      </div>

      <!-- Substrate -->
      <div>
        <label for="pan-substrate-select" class="block text-xs font-mono uppercase tracking-wider font-bold text-ink mb-1">
          {d.panLabel}
        </label>
        <select id="pan-substrate-select" class="w-full bg-surface border border-hairline rounded-xl px-3 py-2.5 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-amber-500 font-medium">
          {copperData.panSubstrates.map((pan) => (
            <option value={pan.id}>{pan.name}</option>
          ))}
        </select>
        <p class="text-xs text-body mt-1">
          {d.panHelp}
        </p>
      </div>

      <!-- Food Matrix -->
      <div>
        <label for="food-matrix-select" class="block text-xs font-mono uppercase tracking-wider font-bold text-ink mb-1">
          {d.foodLabel}
        </label>
        <select id="food-matrix-select" class="w-full bg-surface border border-hairline rounded-xl px-3 py-2.5 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-amber-500 font-medium">
          {copperData.foodMatrices.map((food) => (
            <option value={food.id}>{food.name} (pH {food.pH})</option>
          ))}
        </select>
        <p class="text-xs text-body mt-1">
          {d.foodHelp}
        </p>
      </div>

      <!-- Verdigris State -->
      <div>
        <label for="verdigris-select" class="block text-xs font-mono uppercase tracking-wider font-bold text-ink mb-1">
          {d.verdigrisLabel}
        </label>
        <select id="verdigris-select" class="w-full bg-surface border border-hairline rounded-xl px-3 py-2.5 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-amber-500 font-medium">
          {copperData.verdigrisStates.map((vg) => (
            <option value={vg.id}>{vg.name}</option>
          ))}
        </select>
        <p class="text-xs text-body mt-1">
          {d.verdigrisHelp}
        </p>
      </div>

      <!-- Cooking Duration Slider -->
      <div class="bg-surface-soft p-4 rounded-2xl border border-hairline">
        <div class="flex justify-between items-center mb-1">
          <label for="duration-slider" class="text-xs font-mono uppercase tracking-wider font-bold text-ink">
            {d.durationLabel}
          </label>
          <span id="duration-val-display" class="font-mono text-sm font-extrabold text-amber-800">
            30 min
          </span>
        </div>
        <input id="duration-slider" type="range" min="5" max="180" step="5" value="30" class="w-full accent-amber-600 cursor-pointer" />
        <p class="text-xs text-body mt-1">
          {d.durationHelp}
        </p>
      </div>

      <!-- Temperature Slider -->
      <div class="bg-surface-soft p-4 rounded-2xl border border-hairline">
        <div class="flex justify-between items-center mb-1">
          <label for="temp-slider" class="text-xs font-mono uppercase tracking-wider font-bold text-ink">
            {d.tempLabel}
          </label>
          <span id="temp-val-display" class="font-mono text-sm font-extrabold text-amber-800">
            90°C (194°F)
          </span>
        </div>
        <input id="temp-slider" type="range" min="40" max="220" step="5" value="90" class="w-full accent-amber-600 cursor-pointer" />
        <p class="text-xs text-body mt-1">
          {d.tempHelp}
        </p>
      </div>

      <!-- Tin Wear Slider -->
      <div class="bg-surface-soft p-4 rounded-2xl border border-hairline">
        <div class="flex justify-between items-center mb-1">
          <label for="wear-slider" class="text-xs font-mono uppercase tracking-wider font-bold text-ink">
            {d.wearLabel}
          </label>
          <span id="wear-val-display" class="font-mono text-sm font-extrabold text-amber-800">
            0% (Pristine Tin)
          </span>
        </div>
        <input id="wear-slider" type="range" min="0" max="100" step="5" value="0" class="w-full accent-amber-600 cursor-pointer" />
        <p class="text-xs text-body mt-1">
          {d.wearHelp}
        </p>
      </div>
    </div>

    <!-- Right: Live Diagnostic Scorecard (5 Cols) -->
    <div class="lg:col-span-5 flex flex-col justify-between space-y-6">
      <div class="border-b border-hairline pb-3">
        <h3 class="text-base font-bold text-ink">
          {d.diagnosticTitle}
        </h3>
        <p class="text-xs text-body mt-0.5">
          {d.diagnosticSub}
        </p>
      </div>

      <!-- Hazard Gauge Card -->
      <div id="hazard-card" class="p-5 rounded-2xl border transition-all duration-300 bg-amber-50 border-amber-200">
        <div class="flex justify-between items-start mb-2">
          <span class="text-xs font-mono uppercase font-bold text-ink">
            {d.hazardScoreLabel}
          </span>
          <span id="hazard-badge" class="px-2.5 py-0.5 rounded-full text-xs font-extrabold tracking-wide uppercase bg-emerald-100 text-emerald-800">
            LOW RISK
          </span>
        </div>
        <div class="flex items-baseline gap-2">
          <span id="hazard-score-num" class="text-4xl md:text-5xl font-black text-ink tracking-tight font-mono">
            12
          </span>
          <span class="text-xs text-body font-mono">/ 100 HAZARD INDEX</span>
        </div>
        <!-- Progress bar -->
        <div class="w-full bg-surface rounded-full h-2.5 my-3 overflow-hidden border border-hairline">
          <div id="hazard-progress-bar" class="h-full bg-emerald-500 transition-all duration-500" style="width: 12%;"></div>
        </div>
        <p id="hazard-summary-text" class="text-xs text-body leading-relaxed mt-2">
          Minimal copper ion migration. Safe for food consumption under normal culinary exposure.
        </p>
      </div>

      <!-- Key Diagnostic Metrics Grid -->
      <div class="grid grid-cols-2 gap-3">
        <!-- Copper PPM -->
        <div class="p-3.5 bg-surface-soft rounded-xl border border-hairline">
          <span class="text-[10px] font-mono uppercase text-body block mb-1">
            {d.copperConcentrationLabel}
          </span>
          <span id="copper-ppm-display" class="text-lg font-bold text-ink font-mono block">
            0.15 mg/kg
          </span>
          <span class="text-[10px] text-body block mt-0.5">WHO limit: 10 mg/kg</span>
        </div>

        <!-- Ingested Dose -->
        <div class="p-3.5 bg-surface-soft rounded-xl border border-hairline">
          <span class="text-[10px] font-mono uppercase text-body block mb-1">
            {d.ingestedDoseLabel}
          </span>
          <span id="copper-dose-display" class="text-lg font-bold text-ink font-mono block">
            0.04 mg
          </span>
          <span class="text-[10px] text-body block mt-0.5">Acute nausea: >15 mg</span>
        </div>

        <!-- Verdigris Velocity -->
        <div class="p-3.5 bg-surface-soft rounded-xl border border-hairline">
          <span class="text-[10px] font-mono uppercase text-body block mb-1">
            {d.verdigrisRateLabel}
          </span>
          <span id="verdigris-vel-display" class="text-sm font-bold text-ink font-mono block">
            0.02 µm/h
          </span>
          <span class="text-[10px] text-body block mt-0.5">Ionic dissolution rate</span>
        </div>

        <!-- Metallic Taste -->
        <div class="p-3.5 bg-surface-soft rounded-xl border border-hairline">
          <span class="text-[10px] font-mono uppercase text-body block mb-1">
            {d.metallicTasteLabel}
          </span>
          <span id="metallic-taste-display" class="text-sm font-bold text-emerald-700 font-mono block">
            UNDETECTABLE
          </span>
          <span class="text-[10px] text-body block mt-0.5">Flavor & color impact</span>
        </div>
      </div>

      <!-- FDA Status Badge -->
      <div class="p-3.5 rounded-xl border bg-surface-soft border-hairline flex items-center justify-between">
        <div>
          <span class="text-[10px] font-mono uppercase text-body block">
            {d.fdaStatusLabel}
          </span>
          <span id="fda-compliance-display" class="text-xs font-bold font-mono text-emerald-700">
            COMPLIANT (Sec 4-101.14)
          </span>
        </div>
        <span id="fda-icon-display" class="text-xl">✅</span>
      </div>

      <!-- Action Button -->
      <div>
        <button id="copy-report-btn" type="button" class="w-full py-3 px-4 rounded-xl font-bold text-xs uppercase tracking-wider bg-ink text-surface hover:opacity-90 active:scale-[0.99] transition-all flex items-center justify-center gap-2 shadow-sm">
          <span>{d.copyReportBtn}</span>
        </button>
        <div id="copy-feedback" class="text-center text-xs font-semibold text-emerald-700 mt-2 opacity-0 transition-opacity">
          {d.copiedFeedback}
        </div>
      </div>
    </div>
  </div>

  <!-- Clinical Alert Section -->
  <div id="clinical-alert-box" class="p-6 rounded-2xl border mb-10 bg-surface-soft border-hairline transition-all">
    <div class="flex items-center gap-2 mb-2">
      <span id="alert-icon" class="text-xl">ℹ️</span>
      <h4 class="text-sm font-mono font-bold uppercase tracking-wider text-ink">
        {d.alertTitle}
      </h4>
    </div>
    <p id="alert-detailed-text" class="text-xs md:text-sm text-body leading-relaxed">
      Calculations reflect peer-reviewed food contact metallurgy data and FDA Food Code guidelines. Adjust sliders to evaluate cooking scenarios.
    </p>
  </div>

  <!-- Substrates Comparison Table -->
  <div class="border-t border-hairline pt-8 mb-10">
    <h3 class="text-lg font-bold text-ink mb-1">
      {d.tableTitle}
    </h3>
    <p class="text-xs text-body mb-4">
      {d.tableSub}
    </p>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs border border-hairline rounded-xl overflow-hidden">
        <thead class="bg-surface-soft font-mono uppercase text-[11px] text-ink border-b border-hairline">
          <tr>
            <th class="p-3 font-bold">{d.colSubstrate}</th>
            <th class="p-3 font-bold">{d.colConductivity}</th>
            <th class="p-3 font-bold">{d.colMaxTemp}</th>
            <th class="p-3 font-bold">{d.colAcidReactivity}</th>
            <th class="p-3 font-bold">{d.colFdaCode}</th>
            <th class="p-3 font-bold">{d.colVerdict}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline">
          <tr class="hover:bg-surface-soft transition-colors">
            <td class="p-3 font-medium text-ink">Bare Unlined Copper (C11000)</td>
            <td class="p-3 font-mono font-bold text-amber-700">401 W/m·K</td>
            <td class="p-3 font-mono">1085°C (1984°F)</td>
            <td class="p-3 text-red-700 font-bold">Severe (Instant Cu2+ Leaching)</td>
            <td class="p-3 font-mono text-red-700">Prohibited (pH &lt; 6.0)</td>
            <td class="p-3"><span class="px-2 py-0.5 rounded text-[10px] font-bold bg-red-100 text-red-800">HAZARDOUS FOR ACIDS</span></td>
          </tr>
          <tr class="hover:bg-surface-soft transition-colors">
            <td class="p-3 font-medium text-ink">Hand-Wiped Pure Tin Lining</td>
            <td class="p-3 font-mono">66.8 W/m·K</td>
            <td class="p-3 font-mono text-amber-700 font-bold">231.9°C (Melts at 450°F)</td>
            <td class="p-3 text-emerald-700 font-bold">Inert (Acid-Resistant)</td>
            <td class="p-3 font-mono text-emerald-700">Fully Compliant</td>
            <td class="p-3"><span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-800">SAFE (NO DRY HEAT)</span></td>
          </tr>
          <tr class="hover:bg-surface-soft transition-colors">
            <td class="p-3 font-medium text-ink">Worn Tin Lining (&gt;25mm Bare Patch)</td>
            <td class="p-3 font-mono">280 W/m·K</td>
            <td class="p-3 font-mono">231.9°C (Tin)</td>
            <td class="p-3 text-red-700 font-bold">High (Galvanic Couple Attack)</td>
            <td class="p-3 font-mono text-red-700">Non-Compliant</td>
            <td class="p-3"><span class="px-2 py-0.5 rounded text-[10px] font-bold bg-red-100 text-red-800">RE-TINNING MANDATORY</span></td>
          </tr>
          <tr class="hover:bg-surface-soft transition-colors">
            <td class="p-3 font-medium text-ink">Stainless Steel-Clad Copper (18/10)</td>
            <td class="p-3 font-mono">16.3 W/m·K (Liner)</td>
            <td class="p-3 font-mono font-bold text-emerald-700">800°C+ (1472°F)</td>
            <td class="p-3 text-emerald-700 font-bold">Zero (Acid-Proof Cr2O3)</td>
            <td class="p-3 font-mono text-emerald-700">Fully Compliant</td>
            <td class="p-3"><span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-800">OPTIMAL SAFE STANDARD</span></td>
          </tr>
          <tr class="hover:bg-surface-soft transition-colors">
            <td class="p-3 font-medium text-ink">Vintage Nickel-Plated Copper</td>
            <td class="p-3 font-mono">90.7 W/m·K</td>
            <td class="p-3 font-mono">1455°C (2651°F)</td>
            <td class="p-3 text-amber-700 font-bold">Moderate (Nickel Pitting)</td>
            <td class="p-3 font-mono text-amber-700">Restricted (Allergen)</td>
            <td class="p-3"><span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-100 text-amber-800">ALLERGY &amp; PITTING RISK</span></td>
          </tr>
          <tr class="hover:bg-surface-soft transition-colors">
            <td class="p-3 font-medium text-ink">Cast Brass / Bronze (Cu-Zn Alloy)</td>
            <td class="p-3 font-mono">115 W/m·K</td>
            <td class="p-3 font-mono">930°C (1706°F)</td>
            <td class="p-3 text-red-700 font-bold">High (Dezincification + Lead)</td>
            <td class="p-3 font-mono text-red-700">Prohibited (pH &lt; 6.0)</td>
            <td class="p-3"><span class="px-2 py-0.5 rounded text-[10px] font-bold bg-red-100 text-red-800">TOXICITY HAZARD</span></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- 5 Golden Rules of Copper Safety -->
  <div class="border-t border-hairline pt-8">
    <div class="text-xs font-mono font-bold uppercase tracking-wider text-amber-800 mb-1">
      {d.rulesTitle}
    </div>
    <p class="text-xs text-body mb-6">
      {d.rulesSub}
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="p-4 rounded-xl border border-hairline bg-surface-soft">
        <h4 class="font-bold text-ink text-xs mb-1.5">{d.rule1Title}</h4>
        <p class="text-xs text-body leading-relaxed">{d.rule1Text}</p>
      </div>
      <div class="p-4 rounded-xl border border-hairline bg-surface-soft">
        <h4 class="font-bold text-ink text-xs mb-1.5">{d.rule2Title}</h4>
        <p class="text-xs text-body leading-relaxed">{d.rule2Text}</p>
      </div>
      <div class="p-4 rounded-xl border border-hairline bg-surface-soft">
        <h4 class="font-bold text-ink text-xs mb-1.5">{d.rule3Title}</h4>
        <p class="text-xs text-body leading-relaxed">{d.rule3Text}</p>
      </div>
      <div class="p-4 rounded-xl border border-hairline bg-surface-soft">
        <h4 class="font-bold text-ink text-xs mb-1.5">{d.rule4Title}</h4>
        <p class="text-xs text-body leading-relaxed">{d.rule4Text}</p>
      </div>
      <div class="p-4 rounded-xl border border-hairline bg-surface-soft md:col-span-2">
        <h4 class="font-bold text-ink text-xs mb-1.5">{d.rule5Title}</h4>
        <p class="text-xs text-body leading-relaxed">{d.rule5Text}</p>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ copperData }}>
  (function() {
    // Elements
    const panSelect = document.getElementById('pan-substrate-select');
    const foodSelect = document.getElementById('food-matrix-select');
    const verdigrisSelect = document.getElementById('verdigris-select');
    const durationSlider = document.getElementById('duration-slider');
    const tempSlider = document.getElementById('temp-slider');
    const wearSlider = document.getElementById('wear-slider');

    const durationDisplay = document.getElementById('duration-val-display');
    const tempDisplay = document.getElementById('temp-val-display');
    const wearDisplay = document.getElementById('wear-val-display');

    const hazardCard = document.getElementById('hazard-card');
    const hazardBadge = document.getElementById('hazard-badge');
    const hazardScoreNum = document.getElementById('hazard-score-num');
    const hazardProgressBar = document.getElementById('hazard-progress-bar');
    const hazardSummaryText = document.getElementById('hazard-summary-text');

    const copperPpmDisplay = document.getElementById('copper-ppm-display');
    const copperDoseDisplay = document.getElementById('copper-dose-display');
    const verdigrisVelDisplay = document.getElementById('verdigris-vel-display');
    const metallicTasteDisplay = document.getElementById('metallic-taste-display');
    const fdaComplianceDisplay = document.getElementById('fda-compliance-display');
    const fdaIconDisplay = document.getElementById('fda-icon-display');

    const clinicalAlertBox = document.getElementById('clinical-alert-box');
    const alertDetailedText = document.getElementById('alert-detailed-text');
    const alertIcon = document.getElementById('alert-icon');

    const copyBtn = document.getElementById('copy-report-btn');
    const copyFeedback = document.getElementById('copy-feedback');
    const presetButtons = document.querySelectorAll('.preset-btn');

    if (!panSelect) return;

    function calculateHazard() {
      const panId = panSelect.value;
      const foodId = foodSelect.value;
      const vgId = verdigrisSelect.value;
      const durationMin = parseFloat(durationSlider.value);
      const tempC = parseFloat(tempSlider.value);
      const wearPercent = parseFloat(wearSlider.value);

      durationDisplay.textContent = durationMin + ' min';
      tempDisplay.textContent = tempC + '°C (' + Math.round((tempC * 9/5) + 32) + '°F)';
      wearDisplay.textContent = wearPercent + '% (' + (wearPercent >= 20 ? 'Quarter Rule Violated' : 'Acceptable') + ')';

      const pan = copperData.panSubstrates.find(p => p.id === panId) || copperData.panSubstrates[0];
      const food = copperData.foodMatrices.find(f => f.id === foodId) || copperData.foodMatrices[0];
      const vg = copperData.verdigrisStates.find(v => v.id === vgId) || copperData.verdigrisStates[0];

      // Arrhenius-like temperature multiplier
      const tempFactor = Math.pow(1.035, (tempC - 20));

      // Calculate effective substrate leach rate based on wear
      let effectiveBaseLeach = pan.baseLeachRateMgMin;
      if (pan.id === 'pristine-tin-lined') {
        const exposedRatio = wearPercent / 100;
        // Galvanic acceleration factor when tin and copper co-exist
        const galvanicFactor = exposedRatio > 0 && exposedRatio < 1 ? 1.6 : 1.0;
        effectiveBaseLeach = (0.005 * (1 - exposedRatio)) + (0.85 * exposedRatio * galvanicFactor);
      }

      // Total leached copper calculation (mg/kg in 1 kg food batch)
      // duration in minutes, dissolutionFactor based on pH
      let totalLeachedMgKg = effectiveBaseLeach * food.dissolutionFactor * vg.hazardMultiplier * tempFactor * (durationMin / 30);

      // In stainless steel clad, leaching is zero regardless of heat or acid
      if (pan.id === 'stainless-steel-clad') {
        totalLeachedMgKg = 0.001 * (durationMin / 30);
      }

      totalLeachedMgKg = Math.max(0.001, totalLeachedMgKg);
      const servingDoseMg = (totalLeachedMgKg * 0.25); // 250g serving

      // Velocity of verdigris salt dissolution in µm/hour
      let verdigrisVel = (effectiveBaseLeach * food.dissolutionFactor * vg.hazardMultiplier * 0.45).toFixed(2);
      if (pan.id === 'stainless-steel-clad') verdigrisVel = '0.00';

      // Hazard index 0 to 100
      let hazardIndex = 0;
      if (pan.id === 'stainless-steel-clad') {
        hazardIndex = 2;
      } else {
        hazardIndex = Math.min(100, Math.round((servingDoseMg / 25.0) * 85 + (food.pH < 6.0 && pan.copperPurityPercent > 0 ? 15 : 0)));
      }

      // Updates
      hazardScoreNum.textContent = hazardIndex;
      hazardProgressBar.style.width = Math.min(100, Math.max(5, hazardIndex)) + '%';
      copperPpmDisplay.textContent = totalLeachedMgKg.toFixed(2) + ' mg/kg';
      copperDoseDisplay.textContent = servingDoseMg.toFixed(2) + ' mg';
      verdigrisVelDisplay.textContent = verdigrisVel + ' µm/h';

      // FDA Status
      const isFdaViolated = (food.pH < 6.0 && (pan.copperPurityPercent > 10 || wearPercent >= 20 || pan.id === 'unlined-bare-copper' || pan.id === 'cast-brass-bronze'));
      if (pan.id === 'stainless-steel-clad' || (pan.id === 'pristine-tin-lined' && wearPercent < 20)) {
        fdaComplianceDisplay.textContent = 'COMPLIANT (Sec 4-101.14)';
        fdaComplianceDisplay.className = 'text-xs font-bold font-mono text-emerald-700';
        fdaIconDisplay.textContent = '✅';
      } else if (isFdaViolated) {
        fdaComplianceDisplay.textContent = 'VIOLATION (Sec 4-101.14: pH < 6.0)';
        fdaComplianceDisplay.className = 'text-xs font-bold font-mono text-red-700';
        fdaIconDisplay.textContent = '🚨';
      } else {
        fdaComplianceDisplay.textContent = 'RESTRICTED USE ONLY';
        fdaComplianceDisplay.className = 'text-xs font-bold font-mono text-amber-700';
        fdaIconDisplay.textContent = '⚠️';
      }

      // Taste and color degradation
      if (totalLeachedMgKg < 1.0) {
        metallicTasteDisplay.textContent = 'UNDETECTABLE';
        metallicTasteDisplay.className = 'text-sm font-bold text-emerald-700 font-mono block';
      } else if (totalLeachedMgKg < 5.0) {
        metallicTasteDisplay.textContent = 'FAINT METALLIC';
        metallicTasteDisplay.className = 'text-sm font-bold text-amber-700 font-mono block';
      } else if (totalLeachedMgKg < 15.0) {
        metallicTasteDisplay.textContent = 'DISTINCT COIN TASTE';
        metallicTasteDisplay.className = 'text-sm font-bold text-orange-700 font-mono block';
      } else {
        metallicTasteDisplay.textContent = 'SEVERE METALLIC & TURPID';
        metallicTasteDisplay.className = 'text-sm font-bold text-red-700 font-mono block';
      }

      // Hazard Styling
      if (hazardIndex <= 20) {
        hazardCard.className = 'p-5 rounded-2xl border transition-all duration-300 bg-emerald-50 border-emerald-200';
        hazardBadge.className = 'px-2.5 py-0.5 rounded-full text-xs font-extrabold tracking-wide uppercase bg-emerald-100 text-emerald-800';
        hazardBadge.textContent = 'SAFE / LOW RISK';
        hazardProgressBar.className = 'h-full bg-emerald-500 transition-all duration-500';
        hazardSummaryText.textContent = 'Minimal ionic copper leaching. Safe for food consumption under normal culinary exposure.';
        clinicalAlertBox.className = 'p-6 rounded-2xl border mb-10 bg-emerald-50 border-emerald-200 transition-all';
        alertIcon.textContent = '✅';
        alertDetailedText.textContent = 'Optimal metallurgical safety. Leached copper remains far below the WHO Tolerable Daily Intake (10 mg/day). Food flavor, aroma, and color remain uncompromised.';
      } else if (hazardIndex <= 45) {
        hazardCard.className = 'p-5 rounded-2xl border transition-all duration-300 bg-amber-50 border-amber-200';
        hazardBadge.className = 'px-2.5 py-0.5 rounded-full text-xs font-extrabold tracking-wide uppercase bg-amber-100 text-amber-800';
        hazardBadge.textContent = 'ELEVATED / CAUTION';
        hazardProgressBar.className = 'h-full bg-amber-500 transition-all duration-500';
        hazardSummaryText.textContent = 'Moderate copper migration. Sensitive individuals may experience mild stomach ache or notice a faint copper penny aftertaste.';
        clinicalAlertBox.className = 'p-6 rounded-2xl border mb-10 bg-amber-50 border-amber-200 transition-all';
        alertIcon.textContent = '⚠️';
        alertDetailedText.textContent = 'Caution: Prolonged simmering or acidic contact is starting to strip metallic ions into the sauce. Avoid serving to young children. Inspect pan lining for bare copper spots.';
      } else if (hazardIndex <= 75) {
        hazardCard.className = 'p-5 rounded-2xl border transition-all duration-300 bg-orange-50 border-orange-200';
        hazardBadge.className = 'px-2.5 py-0.5 rounded-full text-xs font-extrabold tracking-wide uppercase bg-orange-100 text-orange-800';
        hazardBadge.textContent = 'SEVERE HAZARD';
        hazardProgressBar.className = 'h-full bg-orange-500 transition-all duration-500';
        hazardSummaryText.textContent = 'Hazardous copper dissolution (>15 mg/serving). Likely to cause acute nausea, stomach cramping, and projectile vomiting within 1 hour.';
        clinicalAlertBox.className = 'p-6 rounded-2xl border mb-10 bg-orange-50 border-orange-200 transition-all';
        alertIcon.textContent = '🚨';
        alertDetailedText.textContent = 'High Acute Toxicity Risk: High levels of dissolved cupric ions can irritate the gastric mucosa, triggering rapid nausea and emesis. Do not consume this dish. The pan must be retired or sent for professional re-tinning.';
      } else {
        hazardCard.className = 'p-5 rounded-2xl border transition-all duration-300 bg-red-50 border-red-300';
        hazardBadge.className = 'px-2.5 py-0.5 rounded-full text-xs font-extrabold tracking-wide uppercase bg-red-200 text-red-900 animate-pulse';
        hazardBadge.textContent = 'ACUTE TOXIC POISONING RISK';
        hazardProgressBar.className = 'h-full bg-red-600 transition-all duration-500';
        hazardSummaryText.textContent = 'CRITICAL TOXICITY: Copper salt concentrations exceed 25–40 mg/serving. Severe chemical gastroenteritis and heavy metal intoxication risk.';
        clinicalAlertBox.className = 'p-6 rounded-2xl border mb-10 bg-red-50 border-red-300 transition-all';
        alertIcon.textContent = '☠️';
        alertDetailedText.textContent = 'Emergency Medical Risk: Verdigris salts (copper acetates and carbonates) have dissolved directly into the food matrix. Ingestion poses severe risk of acute toxic gastroenteritis, blue-green emesis, hemolytic anemia, and liver toxicity. Discard the food immediately.';
      }
    }

    // Attach listeners
    panSelect.addEventListener('change', calculateHazard);
    foodSelect.addEventListener('change', calculateHazard);
    verdigrisSelect.addEventListener('change', calculateHazard);
    durationSlider.addEventListener('input', calculateHazard);
    tempSlider.addEventListener('input', calculateHazard);
    wearSlider.addEventListener('input', calculateHazard);

    // Preset Buttons
    presetButtons.forEach(btn => {
      btn.addEventListener('click', function() {
        const p = this.getAttribute('data-preset');
        if (p === 'tomato-worn') {
          panSelect.value = 'worn-tin-lined-exposed';
          foodSelect.value = 'tomato-marinara-sauce';
          verdigrisSelect.value = 'brown-oxide-patina';
          durationSlider.value = 60;
          tempSlider.value = 90;
          wearSlider.value = 45;
        } else if (p === 'wine-bare') {
          panSelect.value = 'unlined-bare-copper';
          foodSelect.value = 'red-wine-coq-au-vin';
          verdigrisSelect.value = 'pristine-polished';
          durationSlider.value = 45;
          tempSlider.value = 100;
          wearSlider.value = 100;
        } else if (p === 'lemon-bare') {
          panSelect.value = 'unlined-bare-copper';
          foodSelect.value = 'lemon-curd-citrus';
          verdigrisSelect.value = 'green-carbonate-verdigris';
          durationSlider.value = 25;
          tempSlider.value = 85;
          wearSlider.value = 100;
        } else if (p === 'jam-safe') {
          panSelect.value = 'unlined-bare-copper';
          foodSelect.value = 'fruit-jam-preserves';
          verdigrisSelect.value = 'pristine-polished';
          durationSlider.value = 30;
          tempSlider.value = 105;
          wearSlider.value = 0;
        } else if (p === 'clad-modern') {
          panSelect.value = 'stainless-steel-clad';
          foodSelect.value = 'tomato-marinara-sauce';
          verdigrisSelect.value = 'pristine-polished';
          durationSlider.value = 120;
          tempSlider.value = 95;
          wearSlider.value = 0;
        } else if (p === 'egg-white') {
          panSelect.value = 'unlined-bare-copper';
          foodSelect.value = 'whipped-egg-whites';
          verdigrisSelect.value = 'pristine-polished';
          durationSlider.value = 15;
          tempSlider.value = 22;
          wearSlider.value = 0;
        }
        calculateHazard();
      });
    });

    // Copy Report
    if (copyBtn) {
      copyBtn.addEventListener('click', function() {
        const report = `ISITKITCHENSAFE COPPER COOKWARE & VERDIGRIS TOXICOLOGY REPORT
------------------------------------------------------------
Pan Substrate: ${panSelect.options[panSelect.selectedIndex].text}
Food Matrix: ${foodSelect.options[foodSelect.selectedIndex].text}
Surface State: ${verdigrisSelect.options[verdigrisSelect.selectedIndex].text}
Cooking Time: ${durationSlider.value} minutes
Cooking Temp: ${tempSlider.value}°C
Lining Wear / Exposed Copper: ${wearSlider.value}%

DIAGNOSTIC FINDINGS:
Hazard Severity Score: ${hazardScoreNum.textContent} / 100 [${hazardBadge.textContent.trim()}]
Copper Concentration: ${copperPpmDisplay.textContent} (WHO Limit: 10 mg/kg)
Ingested Copper per 250g Serving: ${copperDoseDisplay.textContent}
Verdigris Solubilization Velocity: ${verdigrisVelDisplay.textContent}
Organoleptic Impact: ${metallicTasteDisplay.textContent}
FDA Compliance (Sec 4-101.14): ${fdaComplianceDisplay.textContent}

CLINICAL SAFETY VERDICT:
${alertDetailedText.textContent.trim()}
------------------------------------------------------------
Verified via IsItKitchenSafe Autonomous Growth & Ops Engine`;

        navigator.clipboard.writeText(report).then(() => {
          copyFeedback.style.opacity = '1';
          setTimeout(() => { copyFeedback.style.opacity = '0'; }, 3000);
        });
      });
    }

    calculateHazard();
  })();
</script>
