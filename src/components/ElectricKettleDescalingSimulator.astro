---
import rawData from '../data/electric-kettle-descaling-leaching-data.json';
import type { SupportedLanguage } from '../i18n/ui';
import { useTranslatedPath } from '../i18n/utils';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;
const translatePath = useTranslatedPath(lang);

const waterFilterUrl = translatePath('/tools/water-filter-efficiency-analyzer/');
const plasticLeachingUrl = translatePath('/tools/kitchen-plastic-leaching-checker/');
const kettleComparisonUrl = translatePath('/compare/stainless-steel-vs-plastic-electric-kettle/');
const descalingComparisonUrl = translatePath('/compare/citric-acid-vs-vinegar-descaling/');
const panScratchUrl = translatePath('/tools/pan-scratch-inspector/');
const methodologyUrl = translatePath('/methodology/');
const allToolsUrl = translatePath('/tools/');

const currentLocale = (['en', 'es', 'pt', 'zh-cn', 'ja'].includes(lang) ? lang : 'en') as 'en' | 'es' | 'pt' | 'zh-cn' | 'ja';

const bannerData = rawData.safetyBanner[currentLocale] || rawData.safetyBanner.en;

const localizedKettles = rawData.kettleTypes.map((k: any) => ({
  id: k.id,
  name: k.name[currentLocale] || k.name.en,
  materialCategory: k.materialCategory,
  nickelLeachingRisk: k.nickelLeachingRisk,
  microplasticsRisk: k.microplasticsRisk,
  thermalConductivity: k.thermalConductivity,
  corrosionResistance: k.corrosionResistance
}));

const localizedMethods = rawData.descalingMethods.map((m: any) => ({
  id: m.id,
  name: m.name[currentLocale] || m.name.en,
  chemistry: m.chemistry,
  scaleDissolutionRate: m.scaleDissolutionRate,
  metalPassivationEffect: m.metalPassivationEffect,
  odorResidue: m.odorResidue,
  safetyRating: m.safetyRating
}));

const localizedHardness = rawData.waterHardnessLevels.map((h: any) => ({
  id: h.id,
  name: h.name[currentLocale] || h.name.en,
  scaleAccumulationDays: h.scaleAccumulationDays,
  thermalEfficiencyPenalty: h.thermalEfficiencyPenalty,
  descalingFrequencyRecommended: h.descalingFrequencyRecommended
}));

const uiTranslations = {
  en: {
    selectKettle: '1. Select Kettle Interior & Element Type',
    selectMethod: '2. Select Descaling Agent / Cleaning Method',
    selectHardness: '3. Select Municipal Water Hardness',
    kettleHint: 'Choose your kettle body construction and heating base',
    methodHint: 'Compare chemistry: citric acid chelation vs. boiling acetic acid',
    hardnessHint: 'Harder water accelerates scale thermal insulation & plate overheating',
    verdictHeader: 'Laboratory Simulation Assessment',
    badgeSafe: 'OPTIMAL · SAFE DESCALING',
    badgeCaution: 'CAUTION · ELEVATED NICKEL / ODOR',
    badgeDanger: 'WARNING · AGGRESSIVE CHEMICAL STRESS',
    badgeCritical: 'CRITICAL HAZARD · RETIRE APPLIANCE',
    badgeMyth: 'INEFFECTIVE MYTH · 0% SCALE REMOVAL',
    nickelLabel: 'Nickel Ion Leaching Concentration',
    nickelLimit: 'WHO Drinking Limit: 70 µg/L · Allergy Limit: 20 µg/L',
    microplasticsLabel: 'Microplastic Shedding (100°C Boiling)',
    scaleEfficiencyLabel: 'Limescale Chelation & Removal Efficiency',
    plateConditionLabel: 'Heating Base Condition & Passivation Status',
    mechanismHeader: 'Biochemical & Electrochemical Mechanism',
    actionHeader: 'Actionable Safety & Cleaning Protocol',
    copyVerdict: 'Copy Safety Verdict & Protocol',
