    printVerdict: 'Imprimir / Salvar em PDF',
    relatedToolsTitle: 'Calculadoras Científicas e Comparativos Relacionados'
  },
  'zh-cn': {
    selectKettle: '1. 选择电热水壶内胆与发热底盘材质',
    selectMethod: '2. 选择水垢除垢剂与清洗方案',
    selectHardness: '3. 选择所在地区自来水硬度',
    kettleHint: '选择您的电热水壶内部构造与发热盘工艺',
    methodHint: '科学对比：柠檬酸螯合钝化 vs. 沸水白醋酸蚀剥离',
