const t = uiTranslations[currentLocale];
---

<div class="bg-white rounded-2xl border border-hairline shadow-sm p-6 md:p-8 my-8">
  <!-- Science Benchmark Banner -->
  <div class="bg-surface-soft border border-hairline rounded-xl p-4 md:p-5 mb-8">
    <div class="flex items-center gap-2 mb-2">
      <span class="inline-block px-2.5 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wider bg-ink text-white">
        {bannerData.alertBadge}
      </span>
    </div>
    <h3 class="text-base md:text-lg font-bold text-ink mb-1">
      {bannerData.title}
    </h3>
    <p class="text-xs md:text-sm text-ink-muted leading-relaxed">
      {bannerData.description}
    </p>
  </div>

  <!-- Interactive Controls Grid -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <!-- 1. Kettle Type -->
    <div class="space-y-2">
      <label for="kettle-select" class="block text-xs font-bold uppercase tracking-wider text-ink">
        {t.selectKettle}
      </label>
      <select id="kettle-select" class="w-full bg-white border border-hairline rounded-xl px-3 py-2.5 text-sm text-ink font-medium focus:ring-2 focus:ring-accent focus:border-accent transition-all">
        {localizedKettles.map((k, idx) => (
          <option value={k.id} selected={idx === 0}>{k.name}</option>
        ))}
      </select>
      <p class="text-[11px] text-ink-muted">{t.kettleHint}</p>
    </div>

    <!-- 2. Descaling Method -->
    <div class="space-y-2">
      <label for="method-select" class="block text-xs font-bold uppercase tracking-wider text-ink">
        {t.selectMethod}
      </label>
      <select id="method-select" class="w-full bg-white border border-hairline rounded-xl px-3 py-2.5 text-sm text-ink font-medium focus:ring-2 focus:ring-accent focus:border-accent transition-all">
        {localizedMethods.map((m, idx) => (
          <option value={m.id} selected={idx === 0}>{m.name}</option>
        ))}
      </select>
      <p class="text-[11px] text-ink-muted">{t.methodHint}</p>
    </div>

    <!-- 3. Water Hardness -->
    <div class="space-y-2">
      <label for="hardness-select" class="block text-xs font-bold uppercase tracking-wider text-ink">
        {t.selectHardness}
      </label>
      <select id="hardness-select" class="w-full bg-white border border-hairline rounded-xl px-3 py-2.5 text-sm text-ink font-medium focus:ring-2 focus:ring-accent focus:border-accent transition-all">
        {localizedHardness.map((h, idx) => (
          <option value={h.id} selected={idx === 1}>{h.name}</option>
        ))}
      </select>
      <p class="text-[11px] text-ink-muted">{t.hardnessHint}</p>
    </div>
  </div>

  <!-- Real-Time Dynamic Simulation Results Card -->
  <div id="results-card" class="bg-surface-soft border border-hairline rounded-2xl p-6 md:p-8 space-y-6">
    <!-- Result Header & Verdict Badge -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-hairline pb-4">
      <div>
        <span id="result-badge" class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-700 text-white mb-2">
          {t.badgeSafe}
        </span>
        <h3 id="result-title" class="text-lg md:text-xl font-bold text-ink">
          304 Stainless Steel + Food-Grade Citric Acid
        </h3>
      </div>
      <div class="flex items-center gap-2">
        <button id="copy-btn" type="button" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-lg border border-hairline bg-white hover:bg-surface-soft text-ink transition-colors">
          <span>📋</span> {t.copyVerdict}
        </button>
        <button id="print-btn" type="button" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-lg border border-hairline bg-white hover:bg-surface-soft text-ink transition-colors">
          <span>🖨️</span> {t.printVerdict}
        </button>
      </div>
    </div>

    <!-- Metrics & Gauge Row -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Metric 1: Nickel Leaching -->
      <div class="bg-white rounded-xl border border-hairline p-4 space-y-2">
        <div class="text-xs font-bold uppercase text-ink-muted tracking-wider">
          {t.nickelLabel}
        </div>
        <div class="flex items-baseline gap-2">
          <span id="nickel-value" class="text-2xl font-black text-ink">6.2</span>
          <span class="text-xs text-ink-muted font-semibold">µg/L</span>
        </div>
        <div class="w-full bg-slate-100 rounded-full h-2 overflow-hidden">
          <div id="nickel-bar" class="bg-emerald-500 h-2 rounded-full transition-all duration-300" style="width: 9%;"></div>
        </div>
        <div class="text-[10px] text-ink-muted leading-tight">
          {t.nickelLimit}
        </div>
      </div>

      <!-- Metric 2: Microplastics -->
      <div class="bg-white rounded-xl border border-hairline p-4 space-y-2">
        <div class="text-xs font-bold uppercase text-ink-muted tracking-wider">
          {t.microplasticsLabel}
        </div>
        <div class="flex items-baseline gap-2">
          <span id="microplastics-value" class="text-2xl font-black text-ink">0</span>
          <span class="text-xs text-ink-muted font-semibold">particles / L</span>
        </div>
        <div class="w-full bg-slate-100 rounded-full h-2 overflow-hidden">
          <div id="microplastics-bar" class="bg-emerald-500 h-2 rounded-full transition-all duration-300" style="width: 0%;"></div>
        </div>
        <div id="microplastics-note" class="text-[10px] text-ink-muted leading-tight">
          Zero plastic contact in 100% all-stainless body
        </div>
      </div>

      <!-- Metric 3: Scale Removal Efficiency -->
      <div class="bg-white rounded-xl border border-hairline p-4 space-y-2">
        <div class="text-xs font-bold uppercase text-ink-muted tracking-wider">
          {t.scaleEfficiencyLabel}
        </div>
        <div class="flex items-baseline gap-2">
          <span id="scale-efficiency-value" class="text-2xl font-black text-ink">99%</span>
          <span id="plate-condition-badge" class="text-xs px-2 py-0.5 rounded font-bold bg-emerald-100 text-emerald-800">Passivated</span>
        </div>
        <div class="w-full bg-slate-100 rounded-full h-2 overflow-hidden">
          <div id="scale-bar" class="bg-emerald-500 h-2 rounded-full transition-all duration-300" style="width: 99%;"></div>
        </div>
        <div id="recommended-frequency" class="text-[10px] text-ink-muted leading-tight">
          Recommended descaling: Every 45–60 days
        </div>
      </div>
    </div>

    <!-- Scientific Mechanism Box -->
    <div class="bg-white rounded-xl border border-hairline p-5 space-y-2">
      <h4 class="text-xs font-bold uppercase tracking-wider text-ink flex items-center gap-1.5">
        <span>🔬</span> {t.mechanismHeader}
      </h4>
      <p id="mechanism-text" class="text-sm text-ink-muted leading-relaxed">
        Citric acid acts as a bidentate/tridentate chelating agent that selectively strips calcium carbonate while passivating the 304 stainless steel surface with a refreshed chromium oxide layer. Nickel ion migration remains far below the 70 µg/L WHO drinking water ceiling.
      </p>
    </div>

    <!-- Actionable Protocol Box -->
    <div id="action-box" class="space-y-2 bg-emerald-600/10 p-5 rounded-xl border border-emerald-600/30">
      <h4 class="text-xs font-bold uppercase tracking-wider text-ink flex items-center gap-1.5">
        <span>🛡️</span> {t.actionHeader}
      </h4>
      <p id="action-text" class="text-sm text-ink leading-relaxed font-medium">
        Dissolve 1 tbsp (15g) food-grade citric acid powder in 500ml water. Bring kettle to a boil, allow to soak for 15 minutes without reboiling. Empty and rinse once with cold water. Zero odor and 100% clean.
      </p>
    </div>
  </div>

  <!-- Contextual Internal Link Graph Row -->
  <div class="mt-10 pt-6 border-t border-hairline">
    <h4 class="text-xs font-bold uppercase tracking-wider text-ink-muted mb-4">
      {t.relatedToolsTitle}
    </h4>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3 text-xs">
      <a href={descalingComparisonUrl} class="p-3 bg-surface-soft hover:bg-slate-100 rounded-xl border border-hairline font-semibold text-ink flex flex-col justify-between transition-colors">
        <span>Citric Acid vs Vinegar Descaling</span>
        <span class="text-[10px] text-accent mt-1">Comparison Guide →</span>
      </a>
      <a href={kettleComparisonUrl} class="p-3 bg-surface-soft hover:bg-slate-100 rounded-xl border border-hairline font-semibold text-ink flex flex-col justify-between transition-colors">
        <span>Stainless Steel vs Plastic Kettle</span>
        <span class="text-[10px] text-accent mt-1">Materials Deep-Dive →</span>
      </a>
      <a href={plasticLeachingUrl} class="p-3 bg-surface-soft hover:bg-slate-100 rounded-xl border border-hairline font-semibold text-ink flex flex-col justify-between transition-colors">
        <span>Kitchen Plastic Leaching Checker</span>
        <span class="text-[10px] text-accent mt-1">Interactive Tool →</span>
      </a>
      <a href={waterFilterUrl} class="p-3 bg-surface-soft hover:bg-slate-100 rounded-xl border border-hairline font-semibold text-ink flex flex-col justify-between transition-colors">
        <span>Water Filter & RO Efficiency</span>
        <span class="text-[10px] text-accent mt-1">Toxin Scorecard →</span>
      </a>
    </div>
  </div>
</div>

<script define:vars={{ rawData, currentLocale, t }}>
  document.addEventListener('DOMContentLoaded', () => {
    const kettleSelect = document.getElementById('kettle-select');
    const methodSelect = document.getElementById('method-select');
    const hardnessSelect = document.getElementById('hardness-select');

    const resultBadge = document.getElementById('result-badge');
    const resultTitle = document.getElementById('result-title');
    const nickelValue = document.getElementById('nickel-value');
    const nickelBar = document.getElementById('nickel-bar');
    const microplasticsValue = document.getElementById('microplastics-value');
    const microplasticsBar = document.getElementById('microplastics-bar');
    const microplasticsNote = document.getElementById('microplastics-note');
    const scaleEfficiencyValue = document.getElementById('scale-efficiency-value');
    const plateConditionBadge = document.getElementById('plate-condition-badge');
    const scaleBar = document.getElementById('scale-bar');
    const recommendedFrequency = document.getElementById('recommended-frequency');
    const mechanismText = document.getElementById('mechanism-text');
    const actionText = document.getElementById('action-text');
    const actionBox = document.getElementById('action-box');
    const copyBtn = document.getElementById('copy-btn');
    const printBtn = document.getElementById('print-btn');

    if (!kettleSelect || !methodSelect || !hardnessSelect) return;

    function updateSimulation() {
      const kettleId = kettleSelect.value;
      const methodId = methodSelect.value;
      const hardnessId = hardnessSelect.value;

      const simKey = kettleId + ':' + methodId;
      const sim = rawData.simulationMatrix[simKey] || {
        nickelLeachingUgL: 12.0,
        microplasticsPerL: 0,
        descalingEfficiencyPct: 80,
        heatingPlateCondition: 'NORMAL_PASSIVATED',
        safetyScore: 75,
        verdictCategory: 'ACCEPTABLE_CAUTION',
        mechanism: 'Standard reaction between boiling solution and interior base.',
        actionProtocol: 'Rinse thoroughly with clean water before consuming.'
      };

      const kettleObj = rawData.kettleTypes.find(k => k.id === kettleId) || rawData.kettleTypes[0];
      const methodObj = rawData.descalingMethods.find(m => m.id === methodId) || rawData.descalingMethods[0];
      const hardnessObj = rawData.waterHardnessLevels.find(h => h.id === hardnessId) || rawData.waterHardnessLevels[1];

      // Update Title
      if (resultTitle) {
        resultTitle.textContent = (kettleObj.name[currentLocale] || kettleObj.name.en) + ' + ' + (methodObj.name[currentLocale] || methodObj.name.en);
      }

      // Update Badge
      if (resultBadge) {
        if (sim.verdictCategory === 'SAFE_OPTIMAL') {
          resultBadge.className = 'inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-700 text-white mb-2';
          resultBadge.textContent = t.badgeSafe;
        } else if (sim.verdictCategory === 'ACCEPTABLE_CAUTION') {
          resultBadge.className = 'inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-500 text-white mb-2';
          resultBadge.textContent = t.badgeCaution;
        } else if (sim.verdictCategory === 'MODERATE_CAUTION') {
          resultBadge.className = 'inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-600 text-white mb-2';
          resultBadge.textContent = t.badgeDanger;
        } else if (sim.verdictCategory === 'CRITICAL_HAZARD') {
          resultBadge.className = 'inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-signature-coral text-white mb-2';
          resultBadge.textContent = t.badgeCritical;
        } else {
          resultBadge.className = 'inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-slate-600 text-white mb-2';
          resultBadge.textContent = t.badgeMyth;
        }
      }

      // Update Nickel
      if (nickelValue) {
        nickelValue.textContent = sim.nickelLeachingUgL.toFixed(1);
      }
      if (nickelBar) {
        const pct = Math.min(100, Math.round((sim.nickelLeachingUgL / 100) * 100));
        nickelBar.style.width = pct + '%';
        if (sim.nickelLeachingUgL > 70) {
          nickelBar.className = 'bg-signature-coral h-2 rounded-full transition-all duration-300';
        } else if (sim.nickelLeachingUgL > 20) {
          nickelBar.className = 'bg-amber-500 h-2 rounded-full transition-all duration-300';
        } else {
          nickelBar.className = 'bg-emerald-500 h-2 rounded-full transition-all duration-300';
        }
      }

      // Update Microplastics
      if (microplasticsValue) {
        if (sim.microplasticsPerL === 0) {
          microplasticsValue.textContent = '0';
        } else {
          const million = (sim.microplasticsPerL / 1000000).toFixed(1);
          microplasticsValue.textContent = million + 'M';
        }
      }
      if (microplasticsBar) {
        if (sim.microplasticsPerL > 0) {
          microplasticsBar.style.width = '100%';
          microplasticsBar.className = 'bg-signature-coral h-2 rounded-full transition-all duration-300';
        } else {
          microplasticsBar.style.width = '0%';
          microplasticsBar.className = 'bg-emerald-500 h-2 rounded-full transition-all duration-300';
        }
      }
      if (microplasticsNote) {
        if (sim.microplasticsPerL > 0) {
          microplasticsNote.textContent = 'Polypropylene (PP #5) thermal degradation: millions of micro/nano particles shed at 100°C';
        } else {
          microplasticsNote.textContent = 'Zero plastic contact in 100% all-stainless or borosilicate glass interior';
        }
      }

      // Scale Efficiency
      if (scaleEfficiencyValue) {
        scaleEfficiencyValue.textContent = sim.descalingEfficiencyPct + '%';
      }
      if (scaleBar) {
        scaleBar.style.width = sim.descalingEfficiencyPct + '%';
        if (sim.descalingEfficiencyPct >= 90) {
          scaleBar.className = 'bg-emerald-500 h-2 rounded-full transition-all duration-300';
        } else if (sim.descalingEfficiencyPct >= 50) {
          scaleBar.className = 'bg-amber-500 h-2 rounded-full transition-all duration-300';
        } else {
          scaleBar.className = 'bg-slate-400 h-2 rounded-full transition-all duration-300';
        }
      }

      if (plateConditionBadge) {
        if (sim.descalingEfficiencyPct >= 90) {
          plateConditionBadge.className = 'text-xs px-2 py-0.5 rounded font-bold bg-emerald-100 text-emerald-800';
          plateConditionBadge.textContent = 'Passivated';
        } else if (sim.descalingEfficiencyPct >= 50) {
          plateConditionBadge.className = 'text-xs px-2 py-0.5 rounded font-bold bg-amber-100 text-amber-800';
          plateConditionBadge.textContent = 'Partial Scale';
        } else {
          plateConditionBadge.className = 'text-xs px-2 py-0.5 rounded font-bold bg-slate-200 text-slate-800';
          plateConditionBadge.textContent = 'Crusted';
        }
      }

      if (recommendedFrequency) {
        recommendedFrequency.textContent = 'Recommended cycle: ' + (hardnessObj.descalingFrequencyRecommended || 'Every 60 days') + ' (' + (hardnessObj.thermalEfficiencyPenalty || '') + ')';
      }

      // Text Fields
      if (mechanismText) {
        mechanismText.textContent = sim.mechanism;
      }
      if (actionText) {
        actionText.textContent = sim.actionProtocol;
      }

      // Action Box Styling
      if (actionBox) {
        if (sim.verdictCategory === 'SAFE_OPTIMAL') {
          actionBox.className = 'space-y-2 bg-emerald-600/10 p-5 rounded-xl border border-emerald-600/30';
        } else if (sim.verdictCategory === 'CRITICAL_HAZARD') {
          actionBox.className = 'space-y-2 bg-signature-coral/10 p-5 rounded-xl border border-signature-coral/30';
        } else if (sim.verdictCategory === 'INEFFECTIVE_MYTH') {
          actionBox.className = 'space-y-2 bg-slate-500/10 p-5 rounded-xl border border-slate-500/30';
        } else {
          actionBox.className = 'space-y-2 bg-amber-500/10 p-5 rounded-xl border border-amber-500/30';
        }
      }
    }

    kettleSelect.addEventListener('change', updateSimulation);
    methodSelect.addEventListener('change', updateSimulation);
    hardnessSelect.addEventListener('change', updateSimulation);

    updateSimulation();

    // Copy Handler
    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        const title = resultTitle ? resultTitle.textContent : '';
        const nickel = nickelValue ? nickelValue.textContent : '';
        const micro = microplasticsValue ? microplasticsValue.textContent : '';
        const mech = mechanismText ? mechanismText.textContent : '';
        const act = actionText ? actionText.textContent : '';

        const textToCopy = 'IsItKitchenSafe Electric Kettle Descaling Assessment:\n' +
          'Configuration: ' + title + '\n' +
          'Nickel Leaching: ' + nickel + ' µg/L | Microplastics: ' + micro + ' particles/L\n' +
          'Mechanism: ' + mech + '\n' +
          'Action Protocol: ' + act + '\n' +
          'Verified at: https://isitkitchensafe.com/tools/electric-kettle-descaling-leaching-simulator/';

        navigator.clipboard.writeText(textToCopy).then(() => {
          const original = copyBtn.textContent;
          copyBtn.textContent = '✓ ' + t.copySuccess;
          setTimeout(() => {
            copyBtn.textContent = original;
          }, 2500);
        });
      });
    }

    // Print Handler
    if (printBtn) {
      printBtn.addEventListener('click', () => {
        window.print();
      });
    }
  });
</script>
