    subtitle: "飲料・食品包装（HDPEキャップ、PETプリフォーム、アセプティック紙容器スリーブ、PPカップ）に対する連続低エネルギー電子線（80〜160 keV）非加熱表面滅菌プロセスをシミュレート。表面吸収線量分布（kGy）、樹脂透過深さ曲線、耐熱耐放射線性芽胞の不活性化挙動（>6-log10殺滅）、制動X線遮蔽減衰、および高純度窒素カーテンによるオゾン抑制をFDA 21 CFR § 179.26、OSHA 29 CFR § 1910.1096、3-A Sanitary基準に準拠して精密にモデル化します。",
    controlsTitle: "電子線照射装置＆搬送ラインプロセス制御",
    controlsSub: "加速電圧、陰極エミッション電流、搬送ライン速度、チタン窓寸法、包装樹脂材質、対象芽胞菌、窒素イナートシステム、二次放射線鉛遮蔽チャンバーを設定します。",
    generatorLabel: "電子線発生器＆チタン窓アセンブリ：",
    generatorHelp: "線状陰極コンパクトカーテン型 (105 keV)、高速対向デュアルエミッター型 (130 keV)、ボトルプリフォーム内部ペンシル型 (150 keV)、または窓箔ピンホール破損機を選択。",
    substrateLabel: "包装樹脂材質＆成形ジオメトリ：",
    substrateHelp: "HDPEボトルキャップ、非晶質PETボトルプリフォーム、多層ラミネート紙容器スリーブ、または薄肉PP乳製品カップを選択。",
    pathogenLabel: "対象指標菌・耐放射線性芽胞：",
    pathogenHelp: "Bacillus atrophaeus（放射線滅菌基準菌、D10 = 4.2 kGy）、Geobacillus stearothermophilus、Clostridium botulinum A型、またはAspergillus niger分生子を選択。",
    inertingLabel: "窒素イナート＆オゾン抑制システム：",
    inertingHelp: "超高純度液化窒素ブランケット (<80 ppm O2)、中空糸膜分離窒素発生機、半イナート微正圧ダクト、または大気混入異常を選択。",
    shieldingLabel: "二次放射線遮蔽鉛室＆安全インターロック：",
    shieldingHelp: "迷路型鉛遮蔽トンネル (Pb 8.0 mm)、高密度炭素鋼防護キャビネット (25 mm Fe)、または隙間破損遮蔽室を選択。",
    voltageLabel: "電子線加速電圧 (keV)：",
    voltageHelp: "高真空電界内で電子を加速する電位差。ポリマー包装表面層への電子の最大到達深さを決定します。",
    currentLabel: "陰極ビームエミッション電流 (mA)：",
    currentHelp: "タングステンフィラメントから放出される電子流束総量。表面吸収線量（kGy）に直接比例します。",
    speedLabel: "連続包装搬送ライン速度 (m/s)：",
    speedHelp: "チタン窓下を通過する容器の搬送速度。滞留時間および吸収線量と反比例します。",
    widthLabel: "電子線カーテン照射窓幅 (mm)：",
    widthHelp: "搬送ラインを横断する真空密閉チタン箔窓の有効照射スパン。",
    presetsTitle: "アセプティック包装標準バリデーションプリセット",
    presetClosure: "アセプティック飲料キャップ高速滅菌 (105 keV, 15 mA, 1.2 m/s, HDPE, B. atrophaeus, 液化窒素)",
    presetCarton: "高速UHT紙容器スリーブ連続滅菌 (130 keV, 35 mA, 2.4 m/s, 紙容器, C. botulinum)",
    presetPreform: "PETプリフォーム内壁回転挿入殺菌 (145 keV, 18 mA, 1.0 m/s, PET, G. stearothermophilus)",
    presetDairyTub: "薄肉PPヨーグルトカップ温和表面殺菌 (95 keV, 12 mA, 1.8 m/s, PP, A. niger)",
    presetHazard: "放射線外部漏洩＆高濃度オゾン腐食危険状態 (85 keV, 8 mA, 0.5 m/s, 箔ピンホール, 大気混入)",
    diagnosticTitle: "放射線速度論・殺菌力・安全性総合診断",
    diagnosticSub: "表面吸収線量、芽胞対数減少値、最大到達深さ、排気オゾン濃度、10 cm位置での制動X線漏洩線量率、および断熱温度上昇をリアルタイム計算。",
    absorbedDoseLabel: "表面吸収放射線量 (D)",
    logReductionLabel: "芽胞菌対数減少率 (Log10 Reduction)",
    penetrationDepthLabel: "電子線最大到達深さ (R_p)",
    ozoneEmissionLabel: "排気ダクト内オゾン濃度 (O3)",
    bremsstrahlungLabel: "10 cm位置での外部制動X線漏洩率",
    surfaceTempRiseLabel: "包装材表層の断熱温度上昇 (ΔT)",
    windowTempLabel: "チタン窓箔の連続平衡動作温度",
    complianceStatusLabel: "衛生規格認証＆アセプティック保証状態",
    primaryLimitationLabel: "主要物理限界＆材料制約",
    mitigationActionLabel: "推奨衛生エンジニアリング対策",
    scienceTitle: "低エネルギー電子線電離物理学＆無菌包装工学",
    scienceSub: "低エネルギー電子の散乱挙動、Bethe-Bloch阻止能理論、DNAラジカル切断機構、および制動放射線遮蔽設計の技術的解説。",
    tableTitle: "電子線発生装置および包装材料物性仕様表"
  }
};

const d = DICT[lang] || DICT.en;
---

<div class="bg-surface border border-hairline rounded-3xl p-6 sm:p-10 shadow-xs mb-12">
  <!-- Header Bar -->
  <div class="flex flex-wrap items-center justify-between gap-4 border-b border-hairline pb-6 mb-8">
    <div>
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-violet-600 text-white mb-3">
        {d.badge}
      </span>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-ink tracking-tight">
        {d.title}
      </h1>
      <p class="text-body text-sm sm:text-base mt-2 max-w-4xl leading-relaxed">
        {d.subtitle}
      </p>
    </div>
  </div>

  <!-- Presets Bar -->
  <div class="mb-10 bg-surface-soft border border-hairline rounded-2xl p-5">
    <h3 class="text-xs font-bold uppercase tracking-wider text-muted mb-3">
      {d.presetsTitle}
    </h3>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-2.5">
      <button
        type="button"
        id="btn-preset-closure"
        class="text-left px-3.5 py-2.5 rounded-xl border border-hairline bg-surface hover:border-violet-500 hover:text-violet-600 text-xs font-medium text-ink transition-all shadow-2xs"
      >
        🍶 {d.presetClosure}
      </button>
      <button
        type="button"
        id="btn-preset-carton"
        class="text-left px-3.5 py-2.5 rounded-xl border border-hairline bg-surface hover:border-violet-500 hover:text-violet-600 text-xs font-medium text-ink transition-all shadow-2xs"
      >
        🧃 {d.presetCarton}
      </button>
      <button
        type="button"
        id="btn-preset-preform"
        class="text-left px-3.5 py-2.5 rounded-xl border border-hairline bg-surface hover:border-violet-500 hover:text-violet-600 text-xs font-medium text-ink transition-all shadow-2xs"
      >
        🧪 {d.presetPreform}
      </button>
      <button
        type="button"
        id="btn-preset-dairytub"
        class="text-left px-3.5 py-2.5 rounded-xl border border-hairline bg-surface hover:border-violet-500 hover:text-violet-600 text-xs font-medium text-ink transition-all shadow-2xs"
      >
        🍨 {d.presetDairyTub}
      </button>
      <button
        type="button"
        id="btn-preset-hazard"
        class="text-left px-3.5 py-2.5 rounded-xl border border-rose-300 bg-rose-50/70 hover:bg-rose-100/80 text-xs font-medium text-rose-800 transition-all shadow-2xs"
      >
        ⚠️ {d.presetHazard}
      </button>
    </div>
  </div>

  <!-- Interactive Grid: Controls & Real-Time Engine -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-12">
    <!-- Left Column: Controls (5 Cols) -->
    <div class="lg:col-span-5 space-y-6">
      <div class="bg-surface-soft border border-hairline rounded-2xl p-6">
        <h2 class="text-base font-bold text-ink mb-1">
          {d.controlsTitle}
        </h2>
        <p class="text-xs text-muted mb-6 leading-relaxed">
          {d.controlsSub}
        </p>

        <div class="space-y-5 text-sm">
          <!-- Generator Selection -->
          <div>
            <label for="ebeam-generator" class="block font-semibold text-ink text-xs mb-1">
              {d.generatorLabel}
            </label>
            <select
              id="ebeam-generator"
              class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-xs text-ink focus:outline-hidden focus:ring-2 focus:ring-violet-500"
            >
              {ebeamData.beamGenerators.map(gen => (
                <option value={gen.id}>{gen.name}</option>
              ))}
            </select>
            <span class="block text-2xs text-muted mt-1 leading-tight">{d.generatorHelp}</span>
          </div>

          <!-- Substrate Selection -->
          <div>
            <label for="packaging-substrate" class="block font-semibold text-ink text-xs mb-1">
              {d.substrateLabel}
            </label>
            <select
              id="packaging-substrate"
              class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-xs text-ink focus:outline-hidden focus:ring-2 focus:ring-violet-500"
            >
              {ebeamData.packagingSubstrates.map(sub => (
                <option value={sub.id}>{sub.name}</option>
              ))}
            </select>
            <span class="block text-2xs text-muted mt-1 leading-tight">{d.substrateHelp}</span>
          </div>

          <!-- Pathogen Selection -->
          <div>
            <label for="target-pathogen" class="block font-semibold text-ink text-xs mb-1">
              {d.pathogenLabel}
            </label>
            <select
              id="target-pathogen"
              class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-xs text-ink focus:outline-hidden focus:ring-2 focus:ring-violet-500"
            >
              {ebeamData.targetPathogens.map(pat => (
                <option value={pat.id}>{pat.name}</option>
              ))}
            </select>
            <span class="block text-2xs text-muted mt-1 leading-tight">{d.pathogenHelp}</span>
          </div>

          <!-- Inerting System Selection -->
          <div>
            <label for="inerting-system" class="block font-semibold text-ink text-xs mb-1">
              {d.inertingLabel}
            </label>
            <select
              id="inerting-system"
              class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-xs text-ink focus:outline-hidden focus:ring-2 focus:ring-violet-500"
            >
              {ebeamData.inertingSystems.map(sys => (
                <option value={sys.id}>{sys.name}</option>
              ))}
            </select>
            <span class="block text-2xs text-muted mt-1 leading-tight">{d.inertingHelp}</span>
          </div>

          <!-- Shielding Selection -->
          <div>
            <label for="shielding-architecture" class="block font-semibold text-ink text-xs mb-1">
              {d.shieldingLabel}
            </label>
            <select
              id="shielding-architecture"
              class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-xs text-ink focus:outline-hidden focus:ring-2 focus:ring-violet-500"
            >
              {ebeamData.shieldingArchitectures.map(sh => (
                <option value={sh.id}>{sh.name}</option>
              ))}
            </select>
            <span class="block text-2xs text-muted mt-1 leading-tight">{d.shieldingHelp}</span>
          </div>

          <!-- Sliders -->
          <!-- Accelerating Voltage -->
          <div class="pt-2 border-t border-hairline/60">
            <div class="flex justify-between items-center mb-1">
              <label for="slider-voltage" class="font-semibold text-ink text-xs">
                {d.voltageLabel}
              </label>
              <span id="val-voltage" class="font-mono text-xs font-bold text-violet-700 bg-violet-50 px-2 py-0.5 rounded-md">
                105 keV
              </span>
            </div>
            <input
              type="range"
              id="slider-voltage"
              min="80"
              max="160"
              step="5"
              value="105"
              class="w-full accent-violet-600 cursor-pointer"
            />
            <span class="block text-2xs text-muted mt-0.5">{d.voltageHelp}</span>
          </div>

          <!-- Beam Current -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label for="slider-current" class="font-semibold text-ink text-xs">
                {d.currentLabel}
              </label>
              <span id="val-current" class="font-mono text-xs font-bold text-violet-700 bg-violet-50 px-2 py-0.5 rounded-md">
                15.0 mA
              </span>
            </div>
            <input
              type="range"
              id="slider-current"
              min="5"
              max="50"
              step="1"
              value="15"
              class="w-full accent-violet-600 cursor-pointer"
            />
            <span class="block text-2xs text-muted mt-0.5">{d.currentHelp}</span>
          </div>

          <!-- Conveyor Speed -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label for="slider-speed" class="font-semibold text-ink text-xs">
                {d.speedLabel}
              </label>
              <span id="val-speed" class="font-mono text-xs font-bold text-violet-700 bg-violet-50 px-2 py-0.5 rounded-md">
                1.2 m/s
              </span>
            </div>
            <input
              type="range"
              id="slider-speed"
              min="0.2"
              max="3.5"
              step="0.1"
              value="1.2"
              class="w-full accent-violet-600 cursor-pointer"
            />
            <span class="block text-2xs text-muted mt-0.5">{d.speedHelp}</span>
          </div>

          <!-- Window Span -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label for="slider-width" class="font-semibold text-ink text-xs">
                {d.widthLabel}
              </label>
              <span id="val-width" class="font-mono text-xs font-bold text-violet-700 bg-violet-50 px-2 py-0.5 rounded-md">
                250 mm
              </span>
            </div>
            <input
              type="range"
              id="slider-width"
              min="100"
              max="500"
              step="25"
              value="250"
              class="w-full accent-violet-600 cursor-pointer"
            />
            <span class="block text-2xs text-muted mt-0.5">{d.widthHelp}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Diagnostics, Gauges & Physics Curves (7 Cols) -->
    <div class="lg:col-span-7 space-y-6">
      <div class="bg-surface-soft border border-hairline rounded-2xl p-6">
        <div class="flex items-center justify-between border-b border-hairline/60 pb-3 mb-6">
          <div>
            <h2 class="text-base font-bold text-ink">
              {d.diagnosticTitle}
            </h2>
            <p class="text-xs text-muted mt-0.5">
              {d.diagnosticSub}
            </p>
          </div>
          <span id="live-indicator" class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-2xs font-bold uppercase bg-emerald-100 text-emerald-800">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 animate-pulse"></span>
            ACTIVE SIMULATION
          </span>
        </div>

        <!-- 6 Core Metric Badges Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3.5 mb-6">
          <!-- Absorbed Surface Dose -->
          <div class="bg-surface border border-hairline rounded-xl p-3.5 flex flex-col justify-between">
            <span class="text-2xs font-semibold text-muted leading-tight">{d.absorbedDoseLabel}</span>
            <div class="mt-2">
              <span id="metric-absorbed-dose" class="text-lg font-black text-ink font-mono">26.3</span>
              <span class="text-xs text-muted font-normal ml-0.5">kGy</span>
            </div>
            <span id="sub-absorbed-dose" class="text-2xs text-emerald-600 font-medium mt-1">Target Met (&ge; 25 kGy)</span>
          </div>

          <!-- Spore Log10 Reduction -->
          <div class="bg-surface border border-hairline rounded-xl p-3.5 flex flex-col justify-between">
            <span class="text-2xs font-semibold text-muted leading-tight">{d.logReductionLabel}</span>
            <div class="mt-2">
              <span id="metric-log-reduction" class="text-lg font-black text-emerald-600 font-mono">6.25</span>
              <span class="text-xs text-muted font-normal ml-0.5">log₁₀</span>
            </div>
            <span id="sub-log-reduction" class="text-2xs text-emerald-600 font-medium mt-1">Aseptic Inactivation</span>
          </div>

          <!-- Penetration Depth -->
          <div class="bg-surface border border-hairline rounded-xl p-3.5 flex flex-col justify-between">
            <span class="text-2xs font-semibold text-muted leading-tight">{d.penetrationDepthLabel}</span>
            <div class="mt-2">
              <span id="metric-penetration" class="text-lg font-black text-ink font-mono">48.2</span>
              <span class="text-xs text-muted font-normal ml-0.5">µm</span>
            </div>
            <span id="sub-penetration" class="text-2xs text-muted font-medium mt-1">Surface Only (< 60 µm)</span>
          </div>

          <!-- Ozone Emission Concentration -->
          <div class="bg-surface border border-hairline rounded-xl p-3.5 flex flex-col justify-between">
            <span class="text-2xs font-semibold text-muted leading-tight">{d.ozoneEmissionLabel}</span>
            <div class="mt-2">
              <span id="metric-ozone" class="text-lg font-black text-emerald-600 font-mono">0.015</span>
              <span class="text-xs text-muted font-normal ml-0.5">ppm</span>
            </div>
            <span id="sub-ozone" class="text-2xs text-emerald-600 font-medium mt-1">OSHA Safe (< 0.10 ppm)</span>
          </div>

          <!-- Bremsstrahlung Stray Dose Rate -->
          <div class="bg-surface border border-hairline rounded-xl p-3.5 flex flex-col justify-between">
            <span class="text-2xs font-semibold text-muted leading-tight">{d.bremsstrahlungLabel}</span>
            <div class="mt-2">
              <span id="metric-bremsstrahlung" class="text-lg font-black text-emerald-600 font-mono">0.12</span>
              <span class="text-xs text-muted font-normal ml-0.5">µSv/h</span>
            </div>
            <span id="sub-bremsstrahlung" class="text-2xs text-emerald-600 font-medium mt-1">Shielded (< 0.50 µSv/h)</span>
          </div>

          <!-- Surface Adiabatic Temperature Rise -->
          <div class="bg-surface border border-hairline rounded-xl p-3.5 flex flex-col justify-between">
            <span class="text-2xs font-semibold text-muted leading-tight">{d.surfaceTempRiseLabel}</span>
            <div class="mt-2">
              <span id="metric-temp-rise" class="text-lg font-black text-ink font-mono">+13.8</span>
              <span class="text-xs text-muted font-normal ml-0.5">°C</span>
            </div>
            <span id="sub-temp-rise" class="text-2xs text-emerald-600 font-medium mt-1">No Bulk Melting</span>
          </div>
        </div>

        <!-- Canvas: Electron Penetration Depth-Dose Profile -->
        <div class="bg-surface border border-hairline rounded-xl p-4 mb-6">
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-bold text-ink flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-sm bg-violet-600 inline-block"></span>
              Electron Depth-Dose Distribution Curve in Substrate (Normalized % Dose vs. Depth µm)
            </span>
            <span class="text-2xs text-muted font-mono" id="depth-cutoff-label">Cutoff: 48.2 µm</span>
          </div>
          <div class="w-full h-44 sm:h-52 relative">
            <canvas id="depth-dose-canvas" class="w-full h-full block rounded-lg"></canvas>
          </div>
          <div class="flex items-center justify-between text-2xs text-muted mt-2 px-1">
            <span>0 µm (Outer Packaging Surface)</span>
            <span>25 µm (Sub-Surface Ionization Peak)</span>
            <span>50 µm (Absorption Cut-Off Zone)</span>
            <span>100 µm (Unaffected Bulk Plastic)</span>
          </div>
        </div>

        <!-- Compliance & Regulatory Box -->
        <div id="compliance-card" class="bg-emerald-50 border border-emerald-200 rounded-xl p-4 transition-colors">
          <div class="flex items-start justify-between gap-3">
            <div>
              <span class="text-2xs font-bold uppercase tracking-wider text-emerald-700 block mb-1">
                {d.complianceStatusLabel}
              </span>
              <h3 id="compliance-headline" class="text-sm font-bold text-emerald-950">
                100% COMMERCIAL ASEPTIC COMPLIANCE CONFIRMED (FDA 21 CFR § 179.26 & OSHA)
              </h3>
              <p id="compliance-details" class="text-xs text-emerald-900 mt-1 leading-relaxed">
                Absorbed surface radiation dose exceeds 25 kGy delivering &gt;6.0 log₁₀ inactivation of Bacillus atrophaeus endospores. Low-energy electron confinement (&le; 50 µm) eliminates polymer embrittlement and off-flavor migration, while nitrogen blanket suppresses ozone emissions below OSHA limits.
              </p>
            </div>
            <span id="badge-compliance" class="shrink-0 px-2.5 py-1 rounded-md text-xs font-black bg-emerald-600 text-white">
              PASS
            </span>
          </div>
        </div>

        <!-- Engineering Limitation & Recommended Action -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-4">
          <div class="bg-surface border border-hairline rounded-xl p-3.5">
            <span class="text-2xs font-bold uppercase tracking-wider text-muted block mb-1">
              {d.primaryLimitationLabel}
            </span>
            <p id="primary-limitation-text" class="text-xs text-ink leading-relaxed font-medium">
              Conveyor transport velocity must not exceed 1.4 m/s to prevent under-dosing shadow crevices on high-profile closure threads.
            </p>
          </div>
          <div class="bg-surface border border-hairline rounded-xl p-3.5">
            <span class="text-2xs font-bold uppercase tracking-wider text-muted block mb-1">
              {d.mitigationActionLabel}
            </span>
            <p id="mitigation-action-text" class="text-xs text-ink leading-relaxed font-medium">
              Maintain chilled nitrogen gas knife velocity (&gt;35 m/s at -10°C) across the 8 µm titanium foil window to prevent thermal creep buckling.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Scientific Reference & Data Table -->
  <section class="border-t border-hairline pt-10">
    <div class="max-w-3xl mb-8">
      <h2 class="text-xl font-bold text-ink">
        {d.scienceTitle}
      </h2>
      <p class="text-body text-xs sm:text-sm mt-1.5 leading-relaxed">
        {d.scienceSub}
      </p>
    </div>

    <!-- Comparative Technical Table -->
    <div class="overflow-x-auto border border-hairline rounded-2xl bg-surface mb-8">
      <table class="w-full text-left border-collapse text-xs">
        <thead>
          <tr class="bg-surface-soft border-b border-hairline">
            <th class="p-3.5 font-bold text-ink">Packaging Substrate & Target Geometry</th>
            <th class="p-3.5 font-bold text-ink">Polymer Density</th>
            <th class="p-3.5 font-bold text-ink">Penetration at 105 keV</th>
            <th class="p-3.5 font-bold text-ink">Max Permissible Dose</th>
            <th class="p-3.5 font-bold text-ink">Degradation Mechanism</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline">
          {ebeamData.packagingSubstrates.map(sub => (
            <tr class="hover:bg-surface-soft/50 transition-colors">
              <td class="p-3.5 font-medium text-ink">{sub.name}</td>
              <td class="p-3.5 font-mono text-muted">{sub.densityGPerCm3} g/cm³</td>
              <td class="p-3.5 font-mono text-violet-700 font-bold">{sub.electronPenetrationDepthAt105KevUm} µm</td>
              <td class="p-3.5 font-mono text-ink">{sub.maxPermissibleDoseKgy} kGy</td>
              <td class="p-3.5 text-muted leading-tight">{sub.bulkDegradationMechanism}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</div>

<script is:inline define:vars={{ ebeamData }}>
  (function initEbeamModeler() {
    // DOM Elements
    const selGenerator = document.getElementById('ebeam-generator');
    const selSubstrate = document.getElementById('packaging-substrate');
    const selPathogen = document.getElementById('target-pathogen');
    const selInerting = document.getElementById('inerting-system');
    const selShielding = document.getElementById('shielding-architecture');

    const sliderVoltage = document.getElementById('slider-voltage');
    const sliderCurrent = document.getElementById('slider-current');
    const sliderSpeed = document.getElementById('slider-speed');
    const sliderWidth = document.getElementById('slider-width');

    const valVoltage = document.getElementById('val-voltage');
    const valCurrent = document.getElementById('val-current');
    const valSpeed = document.getElementById('val-speed');
    const valWidth = document.getElementById('val-width');

    const metricDose = document.getElementById('metric-absorbed-dose');
    const subDose = document.getElementById('sub-absorbed-dose');
    const metricLog = document.getElementById('metric-log-reduction');
    const subLog = document.getElementById('sub-log-reduction');
    const metricPenetration = document.getElementById('metric-penetration');
    const subPenetration = document.getElementById('sub-penetration');
    const metricOzone = document.getElementById('metric-ozone');
    const subOzone = document.getElementById('sub-ozone');
    const metricBremsstrahlung = document.getElementById('metric-bremsstrahlung');
    const subBremsstrahlung = document.getElementById('sub-bremsstrahlung');
    const metricTempRise = document.getElementById('metric-temp-rise');
    const subTempRise = document.getElementById('sub-temp-rise');

    const complianceCard = document.getElementById('compliance-card');
    const complianceHeadline = document.getElementById('compliance-headline');
    const complianceDetails = document.getElementById('compliance-details');
    const badgeCompliance = document.getElementById('badge-compliance');
    const primaryLimitation = document.getElementById('primary-limitation-text');
    const mitigationAction = document.getElementById('mitigation-action-text');
    const depthCutoffLabel = document.getElementById('depth-cutoff-label');

    const canvas = document.getElementById('depth-dose-canvas');
    let ctx = canvas ? canvas.getContext('2d') : null;

    // Presets Buttons
    const btnClosure = document.getElementById('btn-preset-closure');
    const btnCarton = document.getElementById('btn-preset-carton');
    const btnPreform = document.getElementById('btn-preset-preform');
    const btnDairyTub = document.getElementById('btn-preset-dairytub');
    const btnHazard = document.getElementById('btn-preset-hazard');

    function applyPreset(genId, subId, patId, inertId, shId, v, cur, sp, w) {
      if (selGenerator) selGenerator.value = genId;
      if (selSubstrate) selSubstrate.value = subId;
      if (selPathogen) selPathogen.value = patId;
      if (selInerting) selInerting.value = inertId;
      if (selShielding) selShielding.value = shId;

      if (sliderVoltage) sliderVoltage.value = v;
      if (sliderCurrent) sliderCurrent.value = cur;
      if (sliderSpeed) sliderSpeed.value = sp;
      if (sliderWidth) sliderWidth.value = w;

      recalculate();
    }

    if (btnClosure) {
      btnClosure.addEventListener('click', () => {
        applyPreset('low_energy_compact_curtain_100kev', 'hdpe_bottle_closure_cap', 'bacillus_atrophaeus_endospore', 'high_purity_cryogenic_n2_curtain', 'lead_lined_labyrinth_tunnel', 105, 15, 1.2, 250);
      });
    }

    if (btnCarton) {
      btnCarton.addEventListener('click', () => {
        applyPreset('high_speed_dual_emitter_130kev', 'aseptic_carton_preformed_sleeve', 'clostridium_botulinum_type_a', 'high_purity_cryogenic_n2_curtain', 'heavy_density_steel_interlock_cabinet', 130, 35, 2.4, 300);
      });
    }

    if (btnPreform) {
      btnPreform.addEventListener('click', () => {
        applyPreset('preform_penetrating_pencil_beam_150kev', 'pet_aseptic_bottle_preform', 'geobacillus_stearothermophilus', 'membrane_separation_n2_blanket', 'lead_lined_labyrinth_tunnel', 145, 18, 1.0, 200);
      });
    }

    if (btnDairyTub) {
      btnDairyTub.addEventListener('click', () => {
        applyPreset('low_energy_compact_curtain_100kev', 'pp_thermoformed_dairy_tub', 'aspergillus_niger_conidia', 'membrane_separation_n2_blanket', 'lead_lined_labyrinth_tunnel', 95, 12, 1.8, 250);
      });
    }

    if (btnHazard) {
      btnHazard.addEventListener('click', () => {
        applyPreset('compromised_pinhole_foil_emitter', 'pp_thermoformed_dairy_tub', 'bacillus_atrophaeus_endospore', 'uninerted_ambient_air_breach', 'depleted_shielding_joint_gap', 85, 8, 0.5, 250);
      });
    }

    function recalculate() {
      const voltage = parseFloat(sliderVoltage.value);
      const current = parseFloat(sliderCurrent.value);
      const speed = parseFloat(sliderSpeed.value);
      const widthMm = parseFloat(sliderWidth.value);
      const widthM = widthMm / 1000.0;

      valVoltage.textContent = `${voltage.toFixed(0)} keV`;
      valCurrent.textContent = `${current.toFixed(1)} mA`;
      valSpeed.textContent = `${speed.toFixed(1)} m/s`;
      valWidth.textContent = `${widthMm.toFixed(0)} mm`;

      const gen = ebeamData.beamGenerators.find(g => g.id === selGenerator.value) || ebeamData.beamGenerators[0];
      const sub = ebeamData.packagingSubstrates.find(s => s.id === selSubstrate.value) || ebeamData.packagingSubstrates[0];
      const pat = ebeamData.targetPathogens.find(p => p.id === selPathogen.value) || ebeamData.targetPathogens[0];
      const inert = ebeamData.inertingSystems.find(i => i.id === selInerting.value) || ebeamData.inertingSystems[0];
      const shield = ebeamData.shieldingArchitectures.find(s => s.id === selShielding.value) || ebeamData.shieldingArchitectures[0];

      // 1. Surface Absorbed Dose (kGy)
      // Dose = (K * Current_mA * Voltage_factor) / (Speed_m_s * Width_m)
      const isCompromisedGen = gen.id === 'compromised_pinhole_foil_emitter';
      const windowLoss = isCompromisedGen ? 0.45 : 0.88;
      const K = 0.185 * windowLoss;
      const absorbedDose = (K * current * (voltage / 100.0)) / (speed * widthM);

      // 2. Microbial Log10 Reduction
      const logReduction = absorbedDose / pat.d10ValueKgy;

      // 3. Electron Penetration Depth (R_p in µm)
      // R_p (g/cm²) ≈ 0.04 * (E / 100)^1.75
      const practicalRangeGPerCm2 = 0.041 * Math.pow(voltage / 100.0, 1.72);
      const maxPenetrationDepthUm = (practicalRangeGPerCm2 / sub.densityGPerCm3) * 10000.0;

      // 4. Ozone Generation & Exhaust Concentration (ppm)
      const o2Fraction = inert.residualOxygenPpm / 1000000.0;
      const beamPowerKw = (voltage * current) / 1000.0;
      const o3GenerationGPerH = beamPowerKw * o2Fraction * 18.5 * (1.0 - (inert.ozoneSuppressionEfficiencyPercent / 100.0) * 0.98);
      const exhaustAirflowM3 = inert.exhaustAirflowM3PerH || 350.0;
      const o3Ppm = Math.max(0.005, (o3GenerationGPerH / exhaustAirflowM3) * 0.52);

      // 5. Bremsstrahlung Stray Radiation at 10 cm (µSv/h)
      let baseBremsstrahlung = shield.strayBremsstrahlungDoseRateMicroSvPerH;
      if (isCompromisedGen) baseBremsstrahlung *= 2.8;
      if (shield.id === 'depleted_shielding_joint_gap') {
        baseBremsstrahlung = Math.max(baseBremsstrahlung, 22.0 + (current * 0.35));
      }

      // 6. Substrate Surface Adiabatic Temperature Rise (°C)
      // ΔT = (Dose_kGy * 1000) / Cp_J_kg_K
      // Cp for polyolefins ~ 1900 J/(kg·K), PET ~ 1250 J/(kg·K)
      const cp = sub.materialClass.includes('PET') ? 1250.0 : 1900.0;
      const tempRise = (absorbedDose * 1000.0) / cp;

      // Render Metrics
      metricDose.textContent = absorbedDose.toFixed(1);
      if (absorbedDose >= 25.0) {
        subDose.textContent = 'Sterilizing (≥ 25 kGy)';
        subDose.className = 'text-2xs text-emerald-600 font-medium mt-1';
      } else if (absorbedDose >= 15.0) {
        subDose.textContent = 'Sanitizing (15-25 kGy)';
        subDose.className = 'text-2xs text-amber-600 font-medium mt-1';
      } else {
        subDose.textContent = 'Sub-Lethal (< 15 kGy)';
        subDose.className = 'text-2xs text-rose-600 font-medium mt-1';
      }

      metricLog.textContent = logReduction.toFixed(2);
      if (logReduction >= 6.0) {
        metricLog.className = 'text-lg font-black text-emerald-600 font-mono';
        subLog.textContent = 'Aseptic (> 6-log₁₀)';
        subLog.className = 'text-2xs text-emerald-600 font-medium mt-1';
      } else if (logReduction >= 4.0) {
        metricLog.className = 'text-lg font-black text-amber-600 font-mono';
        subLog.textContent = 'Commercial Clean (4-6 log)';
        subLog.className = 'text-2xs text-amber-600 font-medium mt-1';
      } else {
        metricLog.className = 'text-lg font-black text-rose-600 font-mono';
        subLog.textContent = 'Deficient (< 4 log₁₀)';
        subLog.className = 'text-2xs text-rose-600 font-medium mt-1';
      }

      metricPenetration.textContent = maxPenetrationDepthUm.toFixed(1);
      if (maxPenetrationDepthUm <= 60.0) {
        subPenetration.textContent = 'Confined Surface (< 60 µm)';
        subPenetration.className = 'text-2xs text-emerald-600 font-medium mt-1';
      } else if (maxPenetrationDepthUm <= 90.0) {
        subPenetration.textContent = 'Moderate Depth (60-90 µm)';
        subPenetration.className = 'text-2xs text-amber-600 font-medium mt-1';
      } else {
        subPenetration.textContent = 'Deep Penetration (> 90 µm)';
        subPenetration.className = 'text-2xs text-amber-700 font-medium mt-1';
      }

      metricOzone.textContent = o3Ppm.toFixed(3);
      if (o3Ppm < 0.05) {
        metricOzone.className = 'text-lg font-black text-emerald-600 font-mono';
        subOzone.textContent = 'OSHA Safe (< 0.05 ppm)';
        subOzone.className = 'text-2xs text-emerald-600 font-medium mt-1';
      } else if (o3Ppm <= 0.10) {
        metricOzone.className = 'text-lg font-black text-amber-600 font-mono';
        subOzone.textContent = 'Warning (0.05-0.10 ppm)';
        subOzone.className = 'text-2xs text-amber-600 font-medium mt-1';
      } else {
        metricOzone.className = 'text-lg font-black text-rose-600 font-mono';
        subOzone.textContent = 'HAZARD (> 0.10 ppm)';
        subOzone.className = 'text-2xs text-rose-600 font-medium mt-1';
      }

      metricBremsstrahlung.textContent = baseBremsstrahlung.toFixed(2);
      if (baseBremsstrahlung < 0.25) {
        metricBremsstrahlung.className = 'text-lg font-black text-emerald-600 font-mono';
        subBremsstrahlung.textContent = 'Shielded (< 0.25 µSv/h)';
        subBremsstrahlung.className = 'text-2xs text-emerald-600 font-medium mt-1';
      } else if (baseBremsstrahlung <= 0.50) {
        metricBremsstrahlung.className = 'text-lg font-black text-amber-600 font-mono';
        subBremsstrahlung.textContent = 'OSHA Limit (< 0.50 µSv/h)';
        subBremsstrahlung.className = 'text-2xs text-amber-600 font-medium mt-1';
      } else {
        metricBremsstrahlung.className = 'text-lg font-black text-rose-600 font-mono';
        subBremsstrahlung.textContent = 'RADIATION LEAK (> 0.5 µSv/h)';
        subBremsstrahlung.className = 'text-2xs text-rose-600 font-medium mt-1';
      }

      metricTempRise.textContent = `+${tempRise.toFixed(1)}`;
      if (tempRise <= 20.0) {
        subTempRise.textContent = 'Zero Thermal Distortion';
        subTempRise.className = 'text-2xs text-emerald-600 font-medium mt-1';
      } else if (tempRise <= 35.0) {
        subTempRise.textContent = 'Mild Heating';
        subTempRise.className = 'text-2xs text-amber-600 font-medium mt-1';
      } else {
        subTempRise.textContent = 'Thermal Warp Risk';
        subTempRise.className = 'text-2xs text-rose-600 font-medium mt-1';
      }

      depthCutoffLabel.textContent = `Cutoff: ${maxPenetrationDepthUm.toFixed(1)} µm`;

      // Compliance Logic
      const isCompliant = (
        logReduction >= 6.0 &&
        o3Ppm <= 0.10 &&
        baseBremsstrahlung <= 0.50 &&
        absorbedDose <= sub.maxPermissibleDoseKgy &&
        !isCompromisedGen
      );

      if (isCompliant) {
        complianceCard.className = 'bg-emerald-50 border border-emerald-200 rounded-xl p-4 transition-colors';
        badgeCompliance.className = 'shrink-0 px-2.5 py-1 rounded-md text-xs font-black bg-emerald-600 text-white';
        badgeCompliance.textContent = 'PASS';
        complianceHeadline.className = 'text-sm font-bold text-emerald-950';
        complianceHeadline.textContent = '100% COMMERCIAL ASEPTIC COMPLIANCE CONFIRMED (FDA 21 CFR § 179.26 & OSHA)';
        complianceDetails.className = 'text-xs text-emerald-900 mt-1 leading-relaxed';
        complianceDetails.textContent = `Absorbed surface radiation dose of ${absorbedDose.toFixed(1)} kGy delivers ${logReduction.toFixed(2)} log₁₀ lethality against ${pat.name}. Electron penetration (${maxPenetrationDepthUm.toFixed(1)} µm) protects polymer bulk, while Bremsstrahlung (${baseBremsstrahlung.toFixed(2)} µSv/h) and ozone (${o3Ppm.toFixed(3)} ppm) satisfy occupational safety limits.`;
        primaryLimitation.textContent = `Conveyor line speed is optimized at ${speed.toFixed(1)} m/s, matching linear beam dwell time to prevent under-dosing on internal cap thread recesses.`;
        mitigationAction.textContent = `Maintain nitrogen curtain blanket purity (residual O2 < 100 ppm) and verify titanium foil window cooling gas knife at -10°C to guarantee >2,000 hours window service life.`;
      } else {
        complianceCard.className = 'bg-rose-50 border border-rose-200 rounded-xl p-4 transition-colors';
        badgeCompliance.className = 'shrink-0 px-2.5 py-1 rounded-md text-xs font-black bg-rose-600 text-white';
        badgeCompliance.textContent = 'FAIL / WARN';
        complianceHeadline.className = 'text-sm font-bold text-rose-950';
        complianceHeadline.textContent = 'ASEPTIC PROCESS DEVIATION & SAFETY VIOLATION DETECTED';
        complianceDetails.className = 'text-xs text-rose-900 mt-1 leading-relaxed';

        let issues = [];
        if (logReduction < 6.0) issues.push(`Insufficient microbial kill (${logReduction.toFixed(2)} log₁₀ vs. 6.0 required)`);
        if (absorbedDose > sub.maxPermissibleDoseKgy) issues.push(`Absorbed dose exceeds polymer threshold (${sub.maxPermissibleDoseKgy} kGy), risking off-odors and yellowing`);
        if (o3Ppm > 0.10) issues.push(`Ozone leakage (${o3Ppm.toFixed(3)} ppm) violates OSHA 0.10 ppm permissible limit`);
        if (baseBremsstrahlung > 0.50) issues.push(`Bremsstrahlung X-ray leakage (${baseBremsstrahlung.toFixed(2)} µSv/h) exceeds 0.50 µSv/h ceiling`);
        if (isCompromisedGen) issues.push(`Compromised vacuum window experiencing pinhole arcing`);

        complianceDetails.textContent = issues.join('; ') + '.';
        primaryLimitation.textContent = `Current process parameters create severe biological, radiological, or occupational hazards under FDA 21 CFR § 179.26 and OSHA 1910.1096.`;
        mitigationAction.textContent = `Increase beam current or decrease conveyor line speed, repair shielding enclosure, restore nitrogen inerting supply, or replace degraded window foil immediately.`;
      }

      // Draw Depth-Dose Profile Curve
      drawDepthDoseCurve(maxPenetrationDepthUm, voltage, absorbedDose);
    }

    function drawDepthDoseCurve(maxDepthUm, voltage, surfaceDose) {
      if (!ctx || !canvas) return;
      const rect = canvas.getBoundingClientRect();
      const dpr = window.devicePixelRatio || 1;
      canvas.width = rect.width * dpr;
      canvas.height = rect.height * dpr;
      ctx.scale(dpr, dpr);

      const w = rect.width;
      const h = rect.height;

      ctx.clearRect(0, 0, w, h);

      // Background grid
      ctx.strokeStyle = '#e2e8f0';
      ctx.lineWidth = 1;
      for (let x = 40; x < w - 20; x += 50) {
        ctx.beginPath();
        ctx.moveTo(x, 20);
        ctx.lineTo(x, h - 30);
        ctx.stroke();
      }
      for (let y = 30; y < h - 30; y += 30) {
        ctx.beginPath();
        ctx.moveTo(40, y);
        ctx.lineTo(w - 20, y);
        ctx.stroke();
      }

      // Curve: Electron relative dose vs. normalized depth
      // In low energy electrons, dose builds up slightly to ~110-120% at ~1/3 of range, then drops steeply
      const xStart = 45;
      const xEnd = w - 30;
      const graphW = xEnd - xStart;
      const graphH = h - 60;

      const maxScaleDepth = Math.max(80.0, maxDepthUm * 1.3);

      ctx.beginPath();
      const points = [];
      const numSteps = 60;
      for (let i = 0; i <= numSteps; i++) {
        const d_um = (i / numSteps) * maxScaleDepth;
        let relDose = 0.0;
        if (d_um <= maxDepthUm) {
          const normD = d_um / maxDepthUm;
          // Characteristic curve: 1.0 at surface, peaks at ~1.15 at normD = 0.35, then plunges towards zero at 1.0
          relDose = Math.max(0.0, (1.0 + 0.45 * normD - 1.45 * Math.pow(normD, 2.5)));
        } else {
          relDose = 0.0;
        }
        const px = xStart + (d_um / maxScaleDepth) * graphW;
        const py = (h - 30) - (relDose / 1.3) * graphH;
        points.push({ x: px, y: py });
        if (i === 0) ctx.moveTo(px, py);
        else ctx.lineTo(px, py);
      }

      // Gradient fill under curve
      ctx.lineTo(points[points.length - 1].x, h - 30);
      ctx.lineTo(points[0].x, h - 30);
      ctx.closePath();
      const grad = ctx.createLinearGradient(0, 20, 0, h - 30);
      grad.addColorStop(0, 'rgba(124, 58, 237, 0.45)');
      grad.addColorStop(1, 'rgba(124, 58, 237, 0.05)');
      ctx.fillStyle = grad;
      ctx.fill();

      // Draw curve line
      ctx.beginPath();
      points.forEach((pt, idx) => {
        if (idx === 0) ctx.moveTo(pt.x, pt.y);
        else ctx.lineTo(pt.x, pt.y);
      });
      ctx.strokeStyle = '#7c3aed';
      ctx.lineWidth = 3;
      ctx.stroke();

      // Mark cutoff depth point
      const cutoffX = xStart + (maxDepthUm / maxScaleDepth) * graphW;
      const cutoffY = h - 30;

      ctx.beginPath();
      ctx.setLineDash([4, 4]);
      ctx.strokeStyle = '#e11d48';
      ctx.lineWidth = 1.5;
      ctx.moveTo(cutoffX, 20);
      ctx.lineTo(cutoffX, cutoffY);
      ctx.stroke();
      ctx.setLineDash([]);

      ctx.fillStyle = '#e11d48';
      ctx.beginPath();
      ctx.arc(cutoffX, cutoffY, 4, 0, Math.PI * 2);
      ctx.fill();

      // Label on cutoff
      ctx.font = '10px monospace';
      ctx.fillStyle = '#e11d48';
      ctx.fillText(`R_p = ${maxDepthUm.toFixed(1)} µm`, Math.min(cutoffX - 25, w - 90), 32);

      // Axes labels
      ctx.fillStyle = '#64748b';
      ctx.font = '10px sans-serif';
      ctx.fillText('100% Dose', 10, (h - 30) - (1.0 / 1.3) * graphH + 3);
      ctx.fillText('0%', 22, h - 30);
      ctx.fillText('0 µm', xStart - 8, h - 15);
      ctx.fillText(`${maxScaleDepth.toFixed(0)} µm`, xEnd - 15, h - 15);
    }

    // Bind Event Listeners
    [selGenerator, selSubstrate, selPathogen, selInerting, selShielding].forEach(sel => {
      if (sel) sel.addEventListener('change', recalculate);
    });

    [sliderVoltage, sliderCurrent, sliderSpeed, sliderWidth].forEach(sl => {
      if (sl) sl.addEventListener('input', recalculate);
    });

    window.addEventListener('resize', recalculate);

    // Initial run
    recalculate();
  })();
</script>
