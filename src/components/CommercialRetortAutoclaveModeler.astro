const d = DICTIONARY[lang];
---

<div class="not-prose my-8 p-6 sm:p-8 rounded-3xl bg-surface-card border border-hairline shadow-sm" id="retort-modeler-root">
  <!-- Header Bar -->
  <div class="flex flex-wrap items-center justify-between gap-4 pb-6 border-b border-hairline">
    <div>
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-rose-700 text-white mb-2">
        {d.badge}
      </span>
      <h2 class="text-xl sm:text-2xl font-extrabold text-ink tracking-tight">
        {d.title}
      </h2>
      <p class="text-xs sm:text-sm text-muted mt-1 max-w-3xl leading-relaxed">
        {d.subtitle}
      </p>
    </div>
    <div class="flex items-center gap-2">
      <span class="px-2.5 py-1 rounded-md text-xs font-mono font-bold bg-rose-100 text-rose-900 border border-rose-200">
        FDA 21 CFR § 113 &bull; ASME BPVC Sec VIII &bull; 12D Fo
      </span>
    </div>
  </div>

  <!-- Operational Presets -->
  <div class="mt-6 pt-2">
    <label class="block text-xs font-bold text-ink uppercase tracking-wider mb-2">
      {d.presetsTitle}
    </label>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5">
      <button 
        type="button" 
        id="preset-btn-compliant" 
        class="py-2.5 px-3 text-xs font-semibold rounded-xl border border-hairline bg-surface-soft hover:bg-surface-hover text-ink text-left transition-colors"
      >
        <span class="text-emerald-600 font-bold block mb-0.5">✓ {d.presetCompliant}</span>
        <span class="text-muted text-[11px] block">121.1°C, 15 min, 8 min Vent, 3-Piece Tinplate, Fo = 5.2 min</span>
      </button>
      <button 
        type="button" 
        id="preset-btn-underprocessed" 
        class="py-2.5 px-3 text-xs font-semibold rounded-xl border border-rose-300 bg-rose-50/50 hover:bg-rose-100/60 text-ink text-left transition-colors"
      >
        <span class="text-rose-600 font-bold block mb-0.5">⚠️ {d.presetUnderprocessed}</span>
        <span class="text-muted text-[11px] block">110°C, Unvented Air Pockets, Fo = 0.8 min, Lethal Spore Survival</span>
      </button>
      <button 
        type="button" 
        id="preset-btn-buckling" 
        class="py-2.5 px-3 text-xs font-semibold rounded-xl border border-amber-300 bg-amber-50/50 hover:bg-amber-100/60 text-ink text-left transition-colors"
      >
        <span class="text-amber-700 font-bold block mb-0.5">⚡ {d.presetBuckling}</span>
        <span class="text-muted text-[11px] block">Thin Aluminum Can, 0 psi Overpressure, ΔP = 22 psi, Seam Burst</span>
      </button>
      <button 
        type="button" 
        id="preset-btn-overpressure-pouch" 
        class="py-2.5 px-3 text-xs font-semibold rounded-xl border border-hairline bg-surface-soft hover:bg-surface-hover text-ink text-left transition-colors"
      >
        <span class="text-cyan-700 font-bold block mb-0.5">📦 {d.presetOverpressurePouch}</span>
        <span class="text-muted text-[11px] block">Retort Pouch, Water Immersion, 15 psig Air Overpressure, Zero Stress</span>
      </button>
    </div>
  </div>

  <!-- Main Grid Controls & Diagnostics -->
  <div class="mt-8 grid grid-cols-1 lg:grid-cols-12 gap-8">
    <!-- Controls (7 cols) -->
    <div class="lg:col-span-7 space-y-6">
      <div class="border-b border-hairline pb-2">
        <h3 class="text-sm font-bold text-ink uppercase tracking-wider">
          {d.controlsTitle}
        </h3>
        <p class="text-xs text-muted mt-0.5">
          {d.controlsSub}
        </p>
      </div>

      <!-- 1. Retort Architecture -->
      <div class="space-y-1.5">
        <label for="select-retort-arch" class="block text-xs font-bold text-ink uppercase tracking-wider">
          {d.retortLabel}
        </label>
        <select 
          id="select-retort-arch" 
          class="w-full py-2.5 px-3 text-sm rounded-xl border border-hairline bg-surface-soft text-ink focus:outline-none focus:ring-2 focus:ring-rose-500 font-medium"
        >
          {retortData.retortArchitectures.map((arch) => (
            <option value={arch.id}>{arch.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted">
          {d.retortHelp}
        </p>
      </div>

      <!-- 2. Container & Packaging Profile -->
      <div class="space-y-1.5">
        <label for="select-container-profile" class="block text-xs font-bold text-ink uppercase tracking-wider">
          {d.containerLabel}
        </label>
        <select 
          id="select-container-profile" 
          class="w-full py-2.5 px-3 text-sm rounded-xl border border-hairline bg-surface-soft text-ink focus:outline-none focus:ring-2 focus:ring-rose-500 font-medium"
        >
          {retortData.containerPackagingProfiles.map((pkg) => (
            <option value={pkg.id}>{pkg.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted">
          {d.containerHelp}
        </p>
      </div>

      <!-- 3. Retort Temperature -->
      <div class="space-y-1.5">
        <div class="flex items-center justify-between">
          <label for="input-retort-temp" class="text-xs font-bold text-ink uppercase tracking-wider">
            {d.tempLabel}
          </label>
          <span class="text-xs font-mono font-bold text-rose-700" id="disp-retort-temp">
            121.1 °C (250.0 °F)
          </span>
        </div>
        <input 
          type="range" 
          id="input-retort-temp" 
          min="105" 
          max="135" 
          step="0.5" 
          value="121.1" 
          class="w-full accent-rose-600 cursor-pointer"
        />
        <p class="text-[11px] text-muted">
          {d.tempHelp}
        </p>
      </div>

      <!-- 4. Sterilization Hold Duration -->
      <div class="space-y-1.5">
        <div class="flex items-center justify-between">
          <label for="input-hold-time" class="text-xs font-bold text-ink uppercase tracking-wider">
            {d.holdTimeLabel}
          </label>
          <span class="text-xs font-mono font-bold text-rose-700" id="disp-hold-time">
            15.0 minutes
          </span>
        </div>
        <input 
          type="range" 
          id="input-hold-time" 
          min="1" 
          max="60" 
          step="1" 
          value="15" 
          class="w-full accent-rose-600 cursor-pointer"
        />
        <p class="text-[11px] text-muted">
          {d.holdTimeHelp}
        </p>
      </div>

      <!-- 5. Compressed Air Overpressure -->
      <div class="space-y-1.5">
        <div class="flex items-center justify-between">
          <label for="input-overpressure" class="text-xs font-bold text-ink uppercase tracking-wider">
            {d.overpressureLabel}
          </label>
          <span class="text-xs font-mono font-bold text-rose-700" id="disp-overpressure">
            0.0 psig (0.0 bar)
          </span>
        </div>
        <input 
          type="range" 
          id="input-overpressure" 
          min="0" 
          max="30" 
          step="1" 
          value="0" 
          class="w-full accent-rose-600 cursor-pointer"
        />
        <p class="text-[11px] text-muted">
          {d.overpressureHelp}
        </p>
      </div>

      <!-- 6. Pre-Heating Venting Time -->
      <div class="space-y-1.5">
        <div class="flex items-center justify-between">
          <label for="input-venting-time" class="text-xs font-bold text-ink uppercase tracking-wider">
            {d.ventingLabel}
          </label>
          <span class="text-xs font-mono font-bold text-rose-700" id="disp-venting-time">
            8.0 minutes
          </span>
        </div>
        <input 
          type="range" 
          id="input-venting-time" 
          min="0" 
          max="15" 
          step="0.5" 
          value="8" 
          class="w-full accent-rose-600 cursor-pointer"
        />
        <p class="text-[11px] text-muted">
          {d.ventingHelp}
        </p>
      </div>

      <!-- 7. Door Safety Interlock Mechanism -->
      <div class="space-y-1.5">
        <label for="select-door-interlock" class="block text-xs font-bold text-ink uppercase tracking-wider">
          {d.doorInterlockLabel}
        </label>
        <select 
          id="select-door-interlock" 
          class="w-full py-2.5 px-3 text-sm rounded-xl border border-hairline bg-surface-soft text-ink focus:outline-none focus:ring-2 focus:ring-rose-500 font-medium"
        >
          <option value="dual_mechanical_pneumatic_safe">Dual Mechanical Safety Pin & Pneumatic Bleeder Interlock (ASME Certified)</option>
          <option value="single_pressure_switch">Single Electrical Pressure Switch Interlock (No Mechanical Latch Bar)</option>
          <option value="bypassed_manual_hazard">Bypassed / Defeated Interlock (Severe Projectile & Scald Risk)</option>
        </select>
        <p class="text-[11px] text-muted">
          {d.doorInterlockHelp}
        </p>
      </div>
    </div>

    <!-- Live Telemetry & Diagnostics (5 cols) -->
    <div class="lg:col-span-5 space-y-6">
      <div class="border-b border-hairline pb-2">
        <h3 class="text-sm font-bold text-ink uppercase tracking-wider">
          {d.diagnosticTitle}
        </h3>
        <p class="text-xs text-muted mt-0.5">
          {d.diagnosticSub}
        </p>
      </div>

      <!-- Telemetry Cards -->
      <div class="space-y-3">
        <!-- 1. Cumulative Thermal Lethality Fo -->
        <div class="p-4 rounded-2xl bg-surface-soft border border-hairline shadow-xs">
          <div class="flex items-center justify-between text-xs mb-1">
            <span class="font-semibold text-muted">{d.foLethalityLabel}</span>
            <span id="badge-fo" class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800">
              Safe 12D Achieved
            </span>
          </div>
          <div class="flex items-baseline gap-2">
            <span id="metric-fo" class="text-2xl font-black text-ink font-mono tracking-tight">
              5.2 min
            </span>
            <span class="text-xs text-muted">standard commercial Fo</span>
          </div>
          <div class="w-full bg-hairline rounded-full h-1.5 mt-2 overflow-hidden">
            <div id="bar-fo" class="bg-emerald-500 h-1.5 rounded-full transition-all duration-300" style="width: 100%;"></div>
          </div>
          <p class="text-[11px] text-muted mt-1.5">
            Target benchmark: <span class="font-mono text-ink font-semibold">Fo ≥ 3.0 min</span> (12D C. botulinum cook).
          </p>
        </div>

        <!-- 2. Spore Log Reduction -->
        <div class="p-4 rounded-2xl bg-surface-soft border border-hairline shadow-xs">
          <div class="flex items-center justify-between text-xs mb-1">
            <span class="font-semibold text-muted">{d.botulinumLogLabel}</span>
            <span id="badge-log-decay" class="px-2 py-0.5 rounded text-[10px] font-bold font-mono bg-cyan-100 text-cyan-800">
              &gt;24-Log Kill
            </span>
          </div>
          <div class="flex items-baseline gap-2">
            <span id="metric-log-reduction" class="text-2xl font-black text-ink font-mono tracking-tight">
              24.8 Log
            </span>
            <span class="text-xs text-muted">decimal spore reduction</span>
          </div>
          <p class="text-[11px] text-muted mt-1">
            D121.1 = 0.21 min | <span id="metric-spore-survivors" class="font-mono text-emerald-700 font-semibold">&lt; 1 in 10^12 probability</span>.
          </p>
        </div>

        <!-- 3. Retort Vessel Total Pressure -->
        <div class="p-4 rounded-2xl bg-surface-soft border border-hairline shadow-xs">
          <div class="flex items-center justify-between text-xs mb-1">
            <span class="font-semibold text-muted">{d.vesselPressureLabel}</span>
            <span id="badge-vessel-p" class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800">
              MAWP Safe
            </span>
          </div>
          <div class="flex items-baseline gap-2">
            <span id="metric-vessel-pressure" class="text-2xl font-black text-ink font-mono tracking-tight">
              15.3 psig
            </span>
            <span class="text-xs text-muted">(1.05 bar gauge)</span>
          </div>
          <p class="text-[11px] text-muted mt-1">
            Saturated Steam: <span id="metric-sat-steam-p" class="font-mono text-ink font-semibold">15.3 psig</span> + Overpressure: <span id="metric-disp-overp" class="font-mono text-ink font-semibold">0.0 psig</span>.
          </p>
        </div>

        <!-- 4. Container Net Differential ΔP -->
        <div class="p-4 rounded-2xl bg-surface-soft border border-hairline shadow-xs">
          <div class="flex items-center justify-between text-xs mb-1">
            <span class="font-semibold text-muted">{d.canDeltaPLabel}</span>
            <span id="badge-delta-p" class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800">
              Seam Equilibrium
            </span>
          </div>
          <div class="flex items-baseline gap-2">
            <span id="metric-delta-p" class="text-2xl font-black text-ink font-mono tracking-tight">
              +4.2 psid
            </span>
            <span class="text-xs text-muted">net internal outward pressure</span>
          </div>
          <p class="text-[11px] text-muted mt-1">
            Can internal: <span id="metric-internal-p" class="font-mono text-ink font-semibold">19.5 psi</span> vs Retort: <span id="metric-external-p" class="font-mono text-ink font-semibold">15.3 psi</span>.
          </p>
        </div>

        <!-- 5. Seam Integrity & ASME Interlock -->
        <div class="p-4 rounded-2xl bg-surface-soft border border-hairline shadow-xs">
          <div class="flex items-center justify-between text-xs mb-1">
            <span class="font-semibold text-muted">{d.seamIntegrityLabel}</span>
            <span id="badge-seam" class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800">
              Hermetic Intact
            </span>
          </div>
          <div class="flex items-baseline gap-2">
            <span id="metric-seam-status" class="text-lg font-black text-ink font-mono tracking-tight">
              Double Seam Sound
            </span>
          </div>
          <div class="mt-2 pt-2 border-t border-hairline/60 flex items-center justify-between text-xs">
            <span class="text-muted">{d.asmeSafetyLabel}:</span>
            <span id="metric-interlock-status" class="font-bold font-mono text-emerald-700">
              LOCKED &bull; INTERLOCK ENGAGED
            </span>
          </div>
        </div>
      </div>

      <!-- Diagnostic Banner -->
      <div class="p-5 rounded-2xl border bg-surface-card shadow-xs transition-colors" id="banner-diagnostic-root">
        <div class="flex items-center justify-between gap-2 mb-3">
          <span class="text-xs font-extrabold uppercase tracking-wider text-muted">
            {d.complianceStatusLabel}
          </span>
          <span id="banner-compliance-badge" class="px-2.5 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-emerald-600 text-white">
            COMPLIANT &bull; FDA 12D SAFE
          </span>
        </div>

        <div class="space-y-2 text-xs">
          <div>
            <span class="font-bold text-ink block">{d.primaryRiskLabel}</span>
            <p id="diag-primary-risk" class="text-muted leading-relaxed mt-0.5">
              Normal sterile processing; adequate lethality Fo and hermetic double-seam integrity maintained.
            </p>
          </div>
          <div>
            <span class="font-bold text-ink block">{d.mechanismsLabel}</span>
            <p id="diag-mechanisms" class="text-muted leading-relaxed mt-0.5">
              Pure condensing saturated steam transfers latent heat rapidly; complete venting purges insulating air blankets, achieving 12D commercial sterility.
            </p>
          </div>
          <div>
            <span class="font-bold text-ink block">{d.mitigationLabel}</span>
            <p id="diag-mitigation" class="text-muted leading-relaxed mt-0.5">
              Verify continuous MIG temperature sensor calibration against NIST standards; conduct double-seam teardown inspection every 4 hours per FDA 21 CFR § 113.
            </p>
          </div>
        </div>

        <!-- Copy Telemetry Button -->
        <div class="mt-4 pt-3 border-t border-hairline/70">
          <button 
            type="button" 
            id="btn-copy-telemetry" 
            class="w-full py-2.5 px-3 text-xs font-bold rounded-xl border border-hairline bg-surface-soft hover:bg-surface-hover text-ink text-center transition-colors flex items-center justify-center gap-2"
          >
            <svg class="w-4 h-4 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
            </svg>
            <span id="copy-btn-text">{d.copyReportBtn}</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Deep Scientific & Engineering Analysis Section -->
  <div class="mt-12 pt-8 border-t border-hairline">
    <div class="max-w-3xl mb-6">
      <h3 class="text-lg font-bold text-ink">
        {d.scienceTitle}
      </h3>
      <p class="text-xs sm:text-sm text-muted mt-1 leading-relaxed">
        {d.scienceSub}
      </p>
    </div>

    <!-- Science Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs leading-relaxed mb-8">
      <div class="p-5 rounded-2xl bg-surface-soft border border-hairline">
        <h4 class="font-bold text-ink text-sm mb-1.5 text-rose-700">
          Bigelow General Method &amp; Fo Thermal Death Time Equation
        </h4>
        <p class="text-muted">
          Thermal death kinetics of Clostridium botulinum spores obey a first-order logarithmic death rate. Cumulative thermal lethality Fo is determined by the Bigelow integral:
        </p>
        <div class="my-2 p-2.5 rounded-lg bg-surface-card font-mono text-[11px] text-ink border border-hairline">
          Fo = &int; 10^((T(t) - 121.11°C) / z) dt
        </div>
        <p class="text-muted">
          Where reference temperature is 121.11°C (250°F) and the thermal resistance constant z = 10°C (18°F). A process delivering Fo = 2.52 minutes guarantees a 12-decimal logarithmic reduction (12D cook), reducing an initial population of 1,000,000,000,000 spores to fewer than 1 viable spore.
        </p>
      </div>

      <div class="p-5 rounded-2xl bg-surface-soft border border-hairline">
        <h4 class="font-bold text-ink text-sm mb-1.5 text-rose-700">
          Air Insulation &amp; 21 CFR § 113 Steam Venting Dynamics
        </h4>
        <p class="text-muted">
          Air is a thermal insulator with a thermal conductivity (k &asymp; 0.026 W/m&middot;K) drastically lower than condensing steam (h &gt; 3,500 W/m&middot;K). Under Dalton&apos;s law of partial pressures:
        </p>
        <div class="my-2 p-2.5 rounded-lg bg-surface-card font-mono text-[11px] text-ink border border-hairline">
          P_total = P_steam + P_air  &rarr;  T_actual &lt; T_sat(P_total)
        </div>
        <p class="text-muted">
          If air is trapped, the steam temperature corresponds only to the partial pressure of steam, not total vessel pressure. A pressure gauge may read 15 psig, but trapped air pockets lower the temperature from 121°C to 110°C, causing fatal microbial under-processing.
        </p>
      </div>

      <div class="p-5 rounded-2xl bg-surface-soft border border-hairline">
        <h4 class="font-bold text-ink text-sm mb-1.5 text-rose-700">
          Can Double-Seam Buckling &amp; Peaking Mechanics
        </h4>
        <p class="text-muted">
          During thermal processing, food product expansion and water vapor generation create substantial internal container pressure:
        </p>
        <div class="my-2 p-2.5 rounded-lg bg-surface-card font-mono text-[11px] text-ink border border-hairline">
          &Delta;P_net = P_internal(T) - (P_steam + P_overpressure)
        </div>
        <p class="text-muted">
          When net internal differential &Delta;P exceeds 28-34 psi in tinplate or 18-20 psi in aluminum, the end dome buckles outward (&quot;peaking&quot;). This permanently deforms the double seam, unhooking the body and cover hooks, breaking the compound hermetic seal, and aspirating cooling water pathogens.
        </p>
      </div>

      <div class="p-5 rounded-2xl bg-surface-soft border border-hairline">
        <h4 class="font-bold text-ink text-sm mb-1.5 text-rose-700">
          ASME BPVC Section VIII Quick-Opening Door Interlocks
        </h4>
        <p class="text-muted">
          Commercial autoclaves operate at 15 to 45 psig. A 48-inch (1.2 m) diameter retort door experiences over 81,000 lbs (36 metric tons) of hydrostatic thrust force:
        </p>
        <div class="my-2 p-2.5 rounded-lg bg-surface-card font-mono text-[11px] text-ink border border-hairline">
          Thrust Force F = P &middot; &pi; &middot; r&sup2; = 45 psi &middot; &pi; &middot; (24 in)&sup2; = 81,430 lbs
        </div>
        <p class="text-muted">
          ASME BPVC Section VIII Division 1 mandates mechanical safety interlocks that physically prevent unlocking the door locking ring if residual internal vessel pressure exceeds 0.2 psig (0.014 bar).
        </p>
      </div>
    </div>

    <!-- Comparative Table -->
    <div class="mt-8">
      <div class="mb-3">
        <h4 class="font-bold text-ink text-sm">
          {d.tableTitle}
        </h4>
        <p class="text-xs text-muted">
          {d.tableSub}
        </p>
      </div>
      <div class="overflow-x-auto rounded-2xl border border-hairline">
        <table class="w-full text-left text-xs">
          <thead class="bg-surface-soft border-b border-hairline text-ink font-bold">
            <tr>
              <th class="py-3 px-4">{d.colModel}</th>
              <th class="py-3 px-4">{d.colClass}</th>
              <th class="py-3 px-4">{d.colMedium}</th>
              <th class="py-3 px-4">{d.colMaxP}</th>
              <th class="py-3 px-4">{d.colVentTime}</th>
              <th class="py-3 px-4">{d.colHtc}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-hairline">
            {retortData.retortArchitectures.map((arch) => (
              <tr class="hover:bg-surface-hover/50 transition-colors">
                <td class="py-3 px-4 font-semibold text-ink">{arch.name}</td>
                <td class="py-3 px-4 text-muted">{arch.classification}</td>
                <td class="py-3 px-4 text-muted">{arch.operatingMedium}</td>
                <td class="py-3 px-4 font-mono font-bold text-rose-700">{arch.maxWorkingPressurePsig} psig</td>
                <td class="py-3 px-4 font-mono text-ink">{arch.ventingCycleTimeMin} min</td>
                <td class="py-3 px-4 font-mono text-muted">{arch.heatTransferCoeffWm2K} W/m&sup2;K</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Regulatory Rules & Mandates -->
    <div class="mt-8 p-6 rounded-2xl bg-surface-soft border border-hairline">
      <div class="mb-4">
        <h4 class="font-bold text-ink text-sm">
          {d.rulesTitle}
        </h4>
        <p class="text-xs text-muted">
          {d.rulesSub}
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
        <div class="space-y-1">
          <span class="font-bold text-rose-700 block">&bull; {d.rule1Title}</span>
          <p class="text-muted leading-relaxed">{d.rule1Text}</p>
        </div>
        <div class="space-y-1">
          <span class="font-bold text-rose-700 block">&bull; {d.rule2Title}</span>
          <p class="text-muted leading-relaxed">{d.rule2Text}</p>
        </div>
        <div class="space-y-1">
          <span class="font-bold text-rose-700 block">&bull; {d.rule3Title}</span>
          <p class="text-muted leading-relaxed">{d.rule3Text}</p>
        </div>
        <div class="space-y-1">
          <span class="font-bold text-rose-700 block">&bull; {d.rule4Title}</span>
          <p class="text-muted leading-relaxed">{d.rule4Text}</p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function initRetortModeler() {
    const root = document.getElementById('retort-modeler-root');
    if (!root) return;

    // Elements
    const retortSelect = document.getElementById('select-retort-arch') as HTMLSelectElement | null;
    const containerSelect = document.getElementById('select-container-profile') as HTMLSelectElement | null;
    const tempInput = document.getElementById('input-retort-temp') as HTMLInputElement | null;
    const holdTimeInput = document.getElementById('input-hold-time') as HTMLInputElement | null;
    const overpressureInput = document.getElementById('input-overpressure') as HTMLInputElement | null;
    const ventingTimeInput = document.getElementById('input-venting-time') as HTMLInputElement | null;
    const doorInterlockSelect = document.getElementById('select-door-interlock') as HTMLSelectElement | null;

    // Value displays
    const dispTemp = document.getElementById('disp-retort-temp');
    const dispTime = document.getElementById('disp-hold-time');
    const dispOverpressure = document.getElementById('disp-overpressure');
    const dispVenting = document.getElementById('disp-venting-time');

    // Telemetry displays
    const metricFo = document.getElementById('metric-fo');
    const badgeFo = document.getElementById('badge-fo');
    const barFo = document.getElementById('bar-fo');
    const metricLog = document.getElementById('metric-log-reduction');
    const badgeLog = document.getElementById('badge-log-decay');
    const metricSurvivors = document.getElementById('metric-spore-survivors');

    const metricVesselP = document.getElementById('metric-vessel-pressure');
    const badgeVesselP = document.getElementById('badge-vessel-p');
    const metricSatSteamP = document.getElementById('metric-sat-steam-p');
    const metricDispOverP = document.getElementById('metric-disp-overp');

    const metricDeltaP = document.getElementById('metric-delta-p');
    const badgeDeltaP = document.getElementById('badge-delta-p');
    const metricInternalP = document.getElementById('metric-internal-p');
    const metricExternalP = document.getElementById('metric-external-p');

    const metricSeamStatus = document.getElementById('metric-seam-status');
    const badgeSeam = document.getElementById('badge-seam');
    const metricInterlockStatus = document.getElementById('metric-interlock-status');

    // Banner
    const bannerRoot = document.getElementById('banner-diagnostic-root');
    const bannerBadge = document.getElementById('banner-compliance-badge');
    const diagPrimaryRisk = document.getElementById('diag-primary-risk');
    const diagMechanisms = document.getElementById('diag-mechanisms');
    const diagMitigation = document.getElementById('diag-mitigation');

    // Presets
    const btnCompliant = document.getElementById('preset-btn-compliant');
    const btnUnderprocessed = document.getElementById('preset-btn-underprocessed');
    const btnBuckling = document.getElementById('preset-btn-buckling');
    const btnOverpressurePouch = document.getElementById('preset-btn-overpressure-pouch');

    // Copy
    const copyBtn = document.getElementById('btn-copy-telemetry');
    const copyText = document.getElementById('copy-btn-text');

    // Saturated Steam Pressure formula (Antoine equation approximation for water 100°C to 140°C in psig)
    function getSaturatedSteamPsig(tempC: number): number {
      // P in bar absolute: Antoine eq log10(P_bar) = 5.20389 - 1730.63 / (T_C + 233.426)
      const pBarAbs = Math.pow(10, 5.20389 - (1730.63 / (tempC + 233.426)));
      const pPsia = pBarAbs * 14.5038;
      const pPsig = Math.max(0, pPsia - 14.696);
      return pPsig;
    }

    function calculate() {
      if (!retortSelect || !containerSelect || !tempInput || !holdTimeInput || !overpressureInput || !ventingTimeInput || !doorInterlockSelect) return;

      const tempC = parseFloat(tempInput.value);
      const tempF = (tempC * 9/5) + 32;
      const holdMin = parseFloat(holdTimeInput.value);
      const overpressurePsig = parseFloat(overpressureInput.value);
      const ventingMin = parseFloat(ventingTimeInput.value);
      const interlockMode = doorInterlockSelect.value;
      const retortId = retortSelect.value;
      const containerId = containerSelect.value;

      // Update control displays
      if (dispTemp) dispTemp.textContent = `${tempC.toFixed(1)} °C (${tempF.toFixed(1)} °F)`;
      if (dispTime) dispTime.textContent = `${holdMin.toFixed(1)} minutes`;
      if (dispOverpressure) dispOverpressure.textContent = `${overpressurePsig.toFixed(1)} psig (${(overpressurePsig * 0.0689476).toFixed(2)} bar)`;
      if (dispVenting) dispVenting.textContent = `${ventingMin.toFixed(1)} minutes`;

      // 1. Saturated Steam & Effective Temperature inside load
      const satSteamPsig = getSaturatedSteamPsig(tempC);
      const totalVesselPsig = satSteamPsig + overpressurePsig;

      // Air Pocket penalty if under-vented
      // Standard required venting time is 7-8 min for saturated steam
      let airPocketPenaltyC = 0;
      if (retortId === 'substandard_unvented_steam_autoclave' || (retortId === 'saturated_steam_batch_retort' && ventingMin < 5)) {
        const missingVent = Math.max(0, 8 - ventingMin);
        airPocketPenaltyC = missingVent * 1.5; // Up to 12°C drop in cold spots
      }

      const effectiveCoreTempC = Math.max(90, tempC - airPocketPenaltyC);

      // 2. Bigelow Lethality Fo Calculation
      // L = 10^((T_eff - 121.11) / 10)
      const lethalityRate = Math.pow(10, (effectiveCoreTempC - 121.11) / 10.0);
      const foMinutes = holdMin * lethalityRate;
      const botulinumLogReduction = foMinutes / 0.21;

      if (metricFo) metricFo.textContent = `${foMinutes.toFixed(2)} min`;
      if (metricLog) metricLog.textContent = `${botulinumLogReduction.toFixed(1)} Log`;

      // Fo Badges
      if (badgeFo && barFo) {
        if (foMinutes >= 3.0) {
          badgeFo.className = 'px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800';
          badgeFo.textContent = 'Safe 12D Achieved';
          barFo.className = 'bg-emerald-500 h-1.5 rounded-full transition-all duration-300';
          barFo.style.width = '100%';
        } else if (foMinutes >= 2.0) {
          badgeFo.className = 'px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-amber-100 text-amber-800';
          badgeFo.textContent = 'Marginal / Sub-Target';
          barFo.className = 'bg-amber-500 h-1.5 rounded-full transition-all duration-300';
          barFo.style.width = `${Math.min(100, (foMinutes / 3.0) * 100)}%`;
        } else {
          badgeFo.className = 'px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-rose-100 text-rose-800 animate-pulse';
          badgeFo.textContent = 'DANGER: LETHAL SURVIVAL (<2D)';
          barFo.className = 'bg-rose-600 h-1.5 rounded-full transition-all duration-300';
          barFo.style.width = `${Math.min(100, (foMinutes / 3.0) * 100)}%`;
        }
      }

      if (badgeLog && metricSurvivors) {
        if (botulinumLogReduction >= 12.0) {
          badgeLog.className = 'px-2 py-0.5 rounded text-[10px] font-bold font-mono bg-cyan-100 text-cyan-800';
          badgeLog.textContent = `≥${Math.floor(botulinumLogReduction)}-Log Kill`;
          metricSurvivors.textContent = '< 1 in 10^12 probability';
          metricSurvivors.className = 'font-mono text-emerald-700 font-semibold';
        } else {
          badgeLog.className = 'px-2 py-0.5 rounded text-[10px] font-bold font-mono bg-rose-100 text-rose-800';
          badgeLog.textContent = `${botulinumLogReduction.toFixed(1)}-Log Under-Process`;
          metricSurvivors.textContent = 'VIABLE SPORES SURVIVE IN BATCH';
          metricSurvivors.className = 'font-mono text-rose-700 font-black animate-pulse';
        }
      }

      // 3. Vessel Pressure
      if (metricVesselP) metricVesselP.textContent = `${totalVesselPsig.toFixed(1)} psig`;
      if (metricSatSteamP) metricSatSteamP.textContent = `${satSteamPsig.toFixed(1)} psig`;
      if (metricDispOverP) metricDispOverP.textContent = `${overpressurePsig.toFixed(1)} psig`;

      if (badgeVesselP) {
        if (totalVesselPsig > 50) {
          badgeVesselP.className = 'px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-rose-100 text-rose-800 animate-pulse';
          badgeVesselP.textContent = 'EXCEEDS MAWP (50 psig)';
        } else if (totalVesselPsig > 40) {
          badgeVesselP.className = 'px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-amber-100 text-amber-800';
          badgeVesselP.textContent = 'High Working Pressure';
        } else {
          badgeVesselP.className = 'px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800';
          badgeVesselP.textContent = 'MAWP Safe';
        }
      }

      // 4. Container Net Differential Pressure ΔP
      // Internal container vapor pressure is roughly sat steam pressure at core temperature + 3-5 psi head space expansion
      const canInternalPressurePsig = satSteamPsig + 4.2;
      const netDeltaPsid = canInternalPressurePsig - totalVesselPsig;

      if (metricDeltaP) {
        const sign = netDeltaPsid >= 0 ? '+' : '';
        metricDeltaP.textContent = `${sign}${netDeltaPsid.toFixed(1)} psid`;
      }
      if (metricInternalP) metricInternalP.textContent = `${canInternalPressurePsig.toFixed(1)} psig`;
      if (metricExternalP) metricExternalP.textContent = `${totalVesselPsig.toFixed(1)} psig`;

      // Container Buckling Thresholds
      let buckleLimitPsid = 34.0;
      if (containerId === 'two_piece_aluminum_beverage_can') buckleLimitPsid = 19.5;
      else if (containerId === 'glass_jar_lug_closure') buckleLimitPsid = 6.5;
      else if (containerId === 'four_ply_foil_retort_pouch') buckleLimitPsid = 14.0;

      let isSeamBuckled = false;
      let isSeamMarginal = false;

      if (netDeltaPsid > buckleLimitPsid) {
        isSeamBuckled = true;
      } else if (netDeltaPsid > (buckleLimitPsid * 0.75)) {
        isSeamMarginal = true;
      }

      if (metricSeamStatus && badgeSeam && badgeDeltaP) {
        if (isSeamBuckled) {
          badgeDeltaP.className = 'px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-rose-100 text-rose-800 animate-pulse';
          badgeDeltaP.textContent = 'Overpressure Rupture';
          badgeSeam.className = 'px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-rose-100 text-rose-800 font-black';
          badgeSeam.textContent = 'SEAM PEAKING / BURST';
          metricSeamStatus.textContent = 'Buckled Double Seam / Seal Failed';
          metricSeamStatus.className = 'text-lg font-black text-rose-700 font-mono tracking-tight animate-pulse';
        } else if (isSeamMarginal) {
          badgeDeltaP.className = 'px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-amber-100 text-amber-800';
          badgeDeltaP.textContent = 'Near Buckle Limit';
          badgeSeam.className = 'px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-amber-100 text-amber-800';
          badgeSeam.textContent = 'High Seam Stress';
          metricSeamStatus.textContent = 'Compound Extrusion Risk';
          metricSeamStatus.className = 'text-lg font-bold text-amber-700 font-mono tracking-tight';
        } else {
          badgeDeltaP.className = 'px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800';
          badgeDeltaP.textContent = 'Seam Equilibrium';
          badgeSeam.className = 'px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800';
          badgeSeam.textContent = 'Hermetic Intact';
          metricSeamStatus.textContent = 'Double Seam Sound';
          metricSeamStatus.className = 'text-lg font-black text-ink font-mono tracking-tight';
        }
      }

      // 5. Door Interlock Status
      if (metricInterlockStatus) {
        if (interlockMode === 'bypassed_manual_hazard') {
          metricInterlockStatus.textContent = 'BYPASSED / SEVERE STEAM BLAST HAZARD';
          metricInterlockStatus.className = 'font-bold font-mono text-red-700 animate-pulse';
        } else if (interlockMode === 'single_pressure_switch') {
          metricInterlockStatus.textContent = 'ELECTRICAL ONLY (NO MECHANICAL LOCK)';
          metricInterlockStatus.className = 'font-bold font-mono text-amber-700';
        } else {
          metricInterlockStatus.textContent = 'LOCKED & INTERLOCKED (<0.2 psig SAFE)';
          metricInterlockStatus.className = 'font-bold font-mono text-emerald-700';
        }
      }

      // 6. Comprehensive Assessment & Banner
      let isCompliant = true;
      let primaryRisk = '';
      let mechanisms = '';
      let mitigation = '';

      if (foMinutes < 3.0) {
        isCompliant = false;
        primaryRisk = 'Catastrophic Clostridium botulinum Spore Survival & Toxin Production Hazard';
        mechanisms = `Process delivered only Fo = ${foMinutes.toFixed(2)} minutes (below FDA 12D minimum Fo ≥ 3.0 min). ${airPocketPenaltyC > 0 ? `Inadequate steam venting (${ventingMin} min) left insulating air pockets causing a ${airPocketPenaltyC.toFixed(1)}°C cold-spot depression.` : 'Insufficient hold time failed to achieve log lethality.'}`;
        mitigation = 'Quarantine entire production batch immediately; re-sterilize with full venting schedule or destroy under FDA 21 CFR § 113.89 recall protocol.';
      } else if (isSeamBuckled) {
        isCompliant = false;
        primaryRisk = 'Container Hermetic Seam Peaking, End Dome Buckling & Micro-Leakage';
        mechanisms = `Net outward internal differential pressure (${netDeltaPsid.toFixed(1)} psid) exceeded container buckle threshold (${buckleLimitPsid} psid). Double-seam overlap or heat seal delaminated under thermal hoop stress.`;
        mitigation = 'Increase compressed air overpressure to ≥12-16 psig to counterbalance internal vapor pressure; inspect seam tear-down cross-sections on optical projector.';
      } else if (totalVesselPsig > 50) {
        isCompliant = false;
        primaryRisk = 'ASME BPVC Section VIII Vessel Overpressure & PRV Blowdown Hazard';
        mechanisms = `Combined saturated steam (${satSteamPsig.toFixed(1)} psig) and air overpressure (${overpressurePsig.toFixed(1)} psig) reached ${totalVesselPsig.toFixed(1)} psig, exceeding vessel Maximum Allowable Working Pressure (50 psig).`;
        mitigation = 'Reduce operating temperature or tune proportional air relief regulators; verify annual ASME UV-stamped safety relief valve certification.';
      } else if (interlockMode === 'bypassed_manual_hazard') {
        isCompliant = false;
        primaryRisk = 'ASME Pressure Vessel Door Catastrophic Blowout & Severe Steam Scald Risk';
        mechanisms = `Vessel holds ${totalVesselPsig.toFixed(1)} psig with bypassed door interlock. Over 80,000 lbs of hydrostatic door thrust could eject the door ring and project superheated steam.`;
        mitigation = 'Shut down retort immediately; lock out electrical supply and reinstall ASME-certified mechanical safety pin and pneumatic bleeder valves.';
      } else {
        primaryRisk = 'FDA 21 CFR § 113 Compliant Commercial 12D Thermal Process';
        mechanisms = `Cumulative Fo = ${foMinutes.toFixed(2)} min achieves >24-Log reduction of C. botulinum spores; net can differential pressure (${netDeltaPsid.toFixed(1)} psid) remains safely within container hermetic tolerance.`;
        mitigation = 'Maintain temperature recorder charts; perform can seam tear-downs every 4 operating hours; calibrate MIG temperature sensors against NIST standards quarterly.';
      }

      if (bannerBadge && bannerRoot) {
        if (isCompliant) {
          bannerBadge.className = 'px-2.5 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-emerald-600 text-white';
          bannerBadge.textContent = 'COMPLIANT • FDA 12D SAFE';
          bannerRoot.className = 'p-5 rounded-2xl border border-emerald-200 bg-emerald-50/30 shadow-xs transition-colors';
        } else {
          bannerBadge.className = 'px-2.5 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-rose-600 text-white animate-pulse';
          bannerBadge.textContent = 'CRITICAL PROCESS DEFICIENCY';
          bannerRoot.className = 'p-5 rounded-2xl border border-rose-200 bg-rose-50/40 shadow-xs transition-colors';
        }
      }

      if (diagPrimaryRisk) diagPrimaryRisk.textContent = primaryRisk;
      if (diagMechanisms) diagMechanisms.textContent = mechanisms;
      if (diagMitigation) diagMitigation.textContent = mitigation;
    }

    // Preset Handlers
    if (btnCompliant) {
      btnCompliant.addEventListener('click', () => {
        retortSelect.value = 'saturated_steam_batch_retort';
        containerSelect.value = 'tinplate_steel_sanitary_can';
        tempInput.value = '121.1';
        holdTimeInput.value = '15';
        overpressureInput.value = '0';
        ventingTimeInput.value = '8';
        doorInterlockSelect.value = 'dual_mechanical_pneumatic_safe';
        calculate();
      });
    }

    if (btnUnderprocessed) {
      btnUnderprocessed.addEventListener('click', () => {
        retortSelect.value = 'substandard_unvented_steam_autoclave';
        containerSelect.value = 'tinplate_steel_sanitary_can';
        tempInput.value = '110';
        holdTimeInput.value = '10';
        overpressureInput.value = '0';
        ventingTimeInput.value = '1';
        doorInterlockSelect.value = 'single_pressure_switch';
        calculate();
      });
    }

    if (btnBuckling) {
      btnBuckling.addEventListener('click', () => {
        retortSelect.value = 'saturated_steam_batch_retort';
        containerSelect.value = 'two_piece_aluminum_beverage_can';
        tempInput.value = '124';
        holdTimeInput.value = '12';
        overpressureInput.value = '0';
        ventingTimeInput.value = '8';
        doorInterlockSelect.value = 'dual_mechanical_pneumatic_safe';
        calculate();
      });
    }

    if (btnOverpressurePouch) {
      btnOverpressurePouch.addEventListener('click', () => {
        retortSelect.value = 'water_immersion_overpressure_retort';
        containerSelect.value = 'four_ply_foil_retort_pouch';
        tempInput.value = '121.1';
        holdTimeInput.value = '14';
        overpressureInput.value = '15';
        ventingTimeInput.value = '6';
        doorInterlockSelect.value = 'dual_mechanical_pneumatic_safe';
        calculate();
      });
    }

    // Input Listeners
    [retortSelect, containerSelect, tempInput, holdTimeInput, overpressureInput, ventingTimeInput, doorInterlockSelect].forEach(el => {
      if (el) el.addEventListener('input', calculate);
    });

    // Copy Telemetry
    if (copyBtn && copyText) {
      copyBtn.addEventListener('click', () => {
        const report = `======================================================================
ISITKITCHENSAFE RETORT AUTOCLAVE & BOTULINUM FO TELEMETRY REPORT
Standards: FDA 21 CFR § 113 / ASME BPVC Section VIII / USDA-FSIS 9 CFR § 318
======================================================================
Retort Architecture: ${retortSelect.selectedOptions[0]?.text || retortSelect.value}
Container Profile: ${containerSelect.selectedOptions[0]?.text || containerSelect.value}
Sterilization Temp: ${tempInput.value} °C (${((parseFloat(tempInput.value) * 9/5) + 32).toFixed(1)} °F)
Sterilization Hold Time: ${holdTimeInput.value} minutes
Pneumatic Air Overpressure: ${overpressureInput.value} psig
Steam Venting / Purge Time: ${ventingTimeInput.value} minutes
Door Safety Interlock: ${doorInterlockSelect.selectedOptions[0]?.text || doorInterlockSelect.value}
----------------------------------------------------------------------
TELEMETRY RESULTS:
Cumulative Thermal Lethality: ${metricFo?.textContent || 'N/A'} (12D Target: ≥3.0 min)
C. botulinum Log Reduction: ${metricLog?.textContent || 'N/A'} (${metricSurvivors?.textContent || ''})
Vessel Total Pressure: ${metricVesselP?.textContent || 'N/A'} (Sat Steam: ${metricSatSteamP?.textContent || ''})
Container Net Differential ΔP: ${metricDeltaP?.textContent || 'N/A'}
Double Seam Integrity: ${metricSeamStatus?.textContent || 'N/A'}
ASME Vessel Door Interlock: ${metricInterlockStatus?.textContent || 'N/A'}
----------------------------------------------------------------------
DIAGNOSTIC ASSESSMENT:
Primary Risk: ${diagPrimaryRisk?.textContent || 'N/A'}
Mechanisms: ${diagMechanisms?.textContent || 'N/A'}
Remediation / CCP-1: ${diagMitigation?.textContent || 'N/A'}
======================================================================`;

        navigator.clipboard.writeText(report).then(() => {
          const originalText = copyText.textContent;
          copyText.textContent = 'Telemetry Copied to Clipboard!';
          setTimeout(() => {
            copyText.textContent = originalText;
          }, 2500);
        });
      });
    }

    calculate();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initRetortModeler);
  } else {
    initRetortModeler();
  }
</script>
