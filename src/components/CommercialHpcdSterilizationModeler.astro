          </span>
        </div>
        <input 
          type="range" 
          id="pressureSlider" 
          min="30" 
          max="250" 
          step="5" 
          value="120"
          class="w-full h-2 bg-hairline rounded-lg appearance-none cursor-pointer accent-sky-600"
        />
        <div class="flex justify-between text-[10px] text-muted font-mono mt-0.5">
          <span>30 bar (Sub-Critical)</span>
          <span class="text-sky-600 font-bold">Pc = 73.8 bar</span>
          <span>250 bar (Supercritical)</span>
        </div>
        <p class="text-[11px] text-muted mt-1 leading-normal">
          {d.pressureHelp}
        </p>
      </div>

      <!-- 4. Temperature Slider -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <label for="tempSlider" class="text-xs font-bold uppercase tracking-wider text-ink">
            {d.tempLabel}
          </label>
          <span class="text-xs font-mono font-bold px-2 py-0.5 rounded bg-amber-100 dark:bg-amber-900/60 text-amber-800 dark:text-amber-200" id="tempValue">
