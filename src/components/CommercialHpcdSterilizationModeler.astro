<script>
  // Technical Data Integration
  const hpcdSystemsData = {
    pilot_continuous_hpcd_50l: {
      name: "Pilot R&D Continuous Dense-Phase HPCD Micro-Bubble System",
      nominalThroughput: 50,
      maxPressure: 150.0,
