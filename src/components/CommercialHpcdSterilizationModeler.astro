      desc: "Severely degraded line operating below CO2 critical solubility threshold."
    }
  };

  const foodMatricesData = {
    cold_pressed_orange_juice: {
      density: 1045,
      nativePh: 3.65,
      solubilityFactor: 1.15,
      dRefMin: 1.45,
      targetLog: 5.0,
      ppoSensitivity: 0.85,
      desc: "Acidic citrus suspension prone to severe thermal off-flavors under traditional heat."
    },
    cloudy_apple_cider: {
      density: 1052,
      nativePh: 3.85,
      solubilityFactor: 1.08,
      dRefMin: 1.38,
      targetLog: 5.0,
      ppoSensitivity: 1.15,
      desc: "High-polyphenol unpasteurized apple juice subject to rapid enzymatic browning by PPO."
    },
    raw_coconut_water: {
      density: 1020,
      nativePh: 5.25,
      solubilityFactor: 1.30,
      dRefMin: 2.10,
      targetLog: 5.0,
      ppoSensitivity: 0.95,
      desc: "Delicate low-acid electrolyte fluid requiring rapid cytoplasmic acidification."
    },
    liquid_whole_egg: {
      density: 1032,
      nativePh: 7.40,
      solubilityFactor: 0.88,
      dRefMin: 1.65,
      targetLog: 5.0,
      ppoSensitivity: 0.70,
      desc: "High-protein colloidal matrix coagulating at 62-64°C; HPCD destroys Salmonella at 36°C."
    }
  };

  const microbialTargetsData = {
    ecoli_o157h7: {
      name: "Escherichia coli O157:H7",
      kP: 0.016,
      kT: 0.045,
      baseDVal: 1.45,
      desc: "Gram-negative target for FDA Juice HACCP 5-log rule."
    },
    salmonella_enteritidis: {
      name: "Salmonella enterica serovar Enteritidis",
      kP: 0.015,
      kT: 0.042,
      baseDVal: 1.55,
      desc: "Gram-negative foodborne pathogen with high cellular acidification sensitivity."
    },
    listeria_monocytogenes: {
      name: "Listeria monocytogenes",
      kP: 0.012,
      kT: 0.038,
      baseDVal: 2.80,
      desc: "Gram-positive psychrotrophic pathogen with dense peptidoglycan cell wall."
    },
    ppo_enzyme: {
      name: "Endogenous Polyphenol Oxidase (PPO)",
      kP: 0.018,
      kT: 0.052,
      baseDVal: 3.60,
      desc: "Binuclear copper enzyme responsible for rapid post-harvest enzymatic browning."
    }
  };

  // DOM Elements
  const systemSelect = document.getElementById('systemSelect') as HTMLSelectElement | null;
  const matrixSelect = document.getElementById('matrixSelect') as HTMLSelectElement | null;
  const targetSelect = document.getElementById('targetSelect') as HTMLSelectElement | null;
  const pressureSlider = document.getElementById('pressureSlider') as HTMLInputElement | null;
  const tempSlider = document.getElementById('tempSlider') as HTMLInputElement | null;
  const orificeSlider = document.getElementById('orificeSlider') as HTMLInputElement | null;
  const co2RatioSlider = document.getElementById('co2RatioSlider') as HTMLInputElement | null;
  const flowRateSlider = document.getElementById('flowRateSlider') as HTMLInputElement | null;

  // Displays
  const pressureValue = document.getElementById('pressureValue');
  const tempValue = document.getElementById('tempValue');
  const orificeValue = document.getElementById('orificeValue');
  const co2RatioValue = document.getElementById('co2RatioValue');
  const flowRateValue = document.getElementById('flowRateValue');
  const systemDescriptionText = document.getElementById('systemDescriptionText');
  const matrixDescriptionText = document.getElementById('matrixDescriptionText');
  const targetDescriptionText = document.getElementById('targetDescriptionText');

  // Metrics
  const metricPhaseState = document.getElementById('metricPhaseState');
  const metricPhaseSub = document.getElementById('metricPhaseSub');
  const metricDissolvedCo2 = document.getElementById('metricDissolvedCo2');
  const metricDissolvedCo2Sub = document.getElementById('metricDissolvedCo2Sub');
  const metricPhDrop = document.getElementById('metricPhDrop');
  const metricPhDropSub = document.getElementById('metricPhDropSub');
  const metricBubbleDiameter = document.getElementById('metricBubbleDiameter');
  const metricBubbleSub = document.getElementById('metricBubbleSub');
  const metricResidenceTime = document.getElementById('metricResidenceTime');
  const metricResidenceSub = document.getElementById('metricResidenceSub');
  const metricLogReduction = document.getElementById('metricLogReduction');
  const metricLogSub = document.getElementById('metricLogSub');
  const metricEnzymeActivity = document.getElementById('metricEnzymeActivity');
  const metricEnzymeSub = document.getElementById('metricEnzymeSub');
  const metricAsmeSafety = document.getElementById('metricAsmeSafety');
  const metricAsmeSub = document.getElementById('metricAsmeSub');

  // Hero Card
  const statusHeroCard = document.getElementById('statusHeroCard');
  const safetyStatusIcon = document.getElementById('safetyStatusIcon');
  const safetyStatusTitle = document.getElementById('safetyStatusTitle');
  const complianceBadge = document.getElementById('complianceBadge');
  const primaryRiskText = document.getElementById('primaryRiskText');
  const mechanismsText = document.getElementById('mechanismsText');
  const mitigationText = document.getElementById('mitigationText');

  // Presets
  const presetCitrusBtn = document.getElementById('presetCitrusBtn');
  const presetCiderBtn = document.getElementById('presetCiderBtn');
  const presetEggBtn = document.getElementById('presetEggBtn');
  const presetChannelingBtn = document.getElementById('presetChannelingBtn');

  function updateSimulation() {
    if (!systemSelect || !matrixSelect || !targetSelect || !pressureSlider || !tempSlider || !orificeSlider || !co2RatioSlider || !flowRateSlider) return;

    const sysKey = systemSelect.value as keyof typeof hpcdSystemsData;
    const matKey = matrixSelect.value as keyof typeof foodMatricesData;
    const tarKey = targetSelect.value as keyof typeof microbialTargetsData;

    const sys = hpcdSystemsData[sysKey] || hpcdSystemsData.commercial_high_pressure_hpcd_600l;
    const mat = foodMatricesData[matKey] || foodMatricesData.cold_pressed_orange_juice;
    const tar = microbialTargetsData[tarKey] || microbialTargetsData.ecoli_o157h7;

    const pressure = parseFloat(pressureSlider.value);
    const temp = parseFloat(tempSlider.value);
    const orifice = parseFloat(orificeSlider.value);
    const co2Ratio = parseFloat(co2RatioSlider.value);
    const flowRate = parseFloat(flowRateSlider.value);

    // Update Slider text
    if (pressureValue) pressureValue.textContent = `${pressure.toFixed(0)} bar`;
    if (tempValue) tempValue.textContent = `${temp.toFixed(0)} °C`;
    if (orificeValue) orificeValue.textContent = `${orifice.toFixed(0)} µm`;
    if (co2RatioValue) co2RatioValue.textContent = `${co2Ratio.toFixed(1)} %`;
    if (flowRateValue) flowRateValue.textContent = `${flowRate.toFixed(0)} L/h`;

    if (systemDescriptionText) systemDescriptionText.textContent = sys.desc;
    if (matrixDescriptionText) matrixDescriptionText.textContent = mat.desc;
    if (targetDescriptionText) targetDescriptionText.textContent = tar.desc;

    // 1. Thermodynamic Phase State
    const Pc = 73.8;
    const Tc = 31.1;
    let phaseState = "Supercritical Fluid";
    let phaseDensity = 680; // kg/m³
    let isSupercritical = false;
    let isSubCritical = false;

    if (pressure >= Pc && temp >= Tc) {
      phaseState = "Supercritical Fluid";
      phaseDensity = 450 + (pressure - Pc) * 1.8 + (40 - temp) * 4.5;
      isSupercritical = true;
    } else if (pressure >= Pc && temp < Tc) {
      phaseState = "Dense-Phase Liquid CO2";
      phaseDensity = 820 + (pressure - Pc) * 1.2;
    } else if (pressure < Pc && temp >= Tc) {
      phaseState = "Superheated Dense Vapor";
      phaseDensity = 150 + pressure * 2.2;
      isSubCritical = true;
    } else {
      phaseState = "Sub-Critical Subcooled Liquid";
      phaseDensity = 750 + pressure * 1.5;
      isSubCritical = true;
    }

    if (metricPhaseState) {
      metricPhaseState.textContent = phaseState;
      if (isSubCritical) {
        metricPhaseState.className = "text-lg md:text-xl font-extrabold text-rose-600 font-mono";
      } else {
        metricPhaseState.className = "text-lg md:text-xl font-extrabold text-sky-700 dark:text-sky-300 font-mono";
      }
    }
    if (metricPhaseSub) metricPhaseSub.textContent = `ρ ≈ ${phaseDensity.toFixed(0)} kg/m³ • Pc=73.8 bar, Tc=31.1°C`;

    // 2. Micro-Bubble Sauter Mean Diameter d32
    // d32 = orifice * (We^-0.4) where We = (rho * v^2 * d) / sigma
    const nozzleVelocity = (flowRate / 3600 / 1000) / (Math.PI * Math.pow(orifice * 1e-6 / 2, 2) * 4);
    const d32Microns = Math.max(12.0, Math.min(95.0, orifice * 0.72 * Math.pow(100 / Math.max(pressure, 30), 0.35)));
    const specificAreaM2PerM3 = (6.0 * (co2Ratio / 100)) / (d32Microns * 1e-6);

    if (metricBubbleDiameter) metricBubbleDiameter.textContent = `${d32Microns.toFixed(1)} µm`;
    if (metricBubbleSub) metricBubbleSub.textContent = `Interfacial Area a ≈ ${specificAreaM2PerM3.toFixed(0)} m²/m³`;

    // 3. Dissolved CO2 Concentration via Henry's Law with Fugacity Correction
    // C_CO2 (g/L) = kH(T) * phi * P * mat.solubilityFactor
    const kH_ambient = 1.45; // g/(L*bar) at 25°C
    const kH_temp = kH_ambient * Math.exp(-0.024 * (temp - 25));
    const fugacityCoeff = pressure > 100 ? (0.65 + 0.0018 * pressure) : (0.85 - 0.0012 * pressure);
    const dissolvedCo2GL = Math.min(48.0, kH_temp * fugacityCoeff * pressure * mat.solubilityFactor * (co2Ratio / 10));

    if (metricDissolvedCo2) metricDissolvedCo2.textContent = `${dissolvedCo2GL.toFixed(1)} g/L`;
    if (metricDissolvedCo2Sub) metricDissolvedCo2Sub.textContent = `Fugacity: ${(pressure * fugacityCoeff).toFixed(1)} bar • Sol: ${(dissolvedCo2GL / 10.45).toFixed(1)}% w/v`;

    // 4. Cytoplasmic pH Drop
    // Delta pH = -log10(1 + 10^(pH_initial - pKa_carbonic) * (C_CO2 / C_ref))
    const initialPh = mat.nativePh;
    const phDrop = Math.min(3.2, Math.max(0.4, 0.45 * Math.log(dissolvedCo2GL + 1.0) * (matKey === 'raw_coconut_water' ? 1.25 : 1.0)));
    const finalPh = Math.max(2.8, initialPh - phDrop);

    if (metricPhDrop) metricPhDrop.textContent = `- ${phDrop.toFixed(2)} pH`;
    if (metricPhDropSub) metricPhDropSub.textContent = `In-Situ pH: ${initialPh.toFixed(2)} → ${finalPh.toFixed(2)}`;

    // 5. Pressurized Residence Time
    // tau = V_reactor / (Q_liquid + Q_co2_dense)
    const effectiveFlowRateM3PerHour = (flowRate * (1 + (co2Ratio / 100) * (1000 / phaseDensity))) / 1000;
    const residenceTimeSec = (sys.reactorVolume / 1000 / effectiveFlowRateM3PerHour) * 3600;

    if (metricResidenceTime) metricResidenceTime.textContent = `${residenceTimeSec.toFixed(1)} s`;
    if (metricResidenceSub) metricResidenceSub.textContent = `Holding Volume: ${sys.reactorVolume.toFixed(1)} L (${(residenceTimeSec / 60).toFixed(2)} min)`;

    // 6. Microbial Lethality (Log Reduction)
    // D_eff = baseDVal / ( (P/100)^kP * exp(kT * (T - 25)) * (a / a_ref)^0.4 )
    const pressureMultiplier = Math.pow(Math.max(pressure, 20) / 100, tar.kP * 55);
    const tempMultiplier = Math.exp(tar.kT * (temp - 25));
    const massTransferBoost = Math.pow(specificAreaM2PerM3 / 2500, 0.45);
    const effectiveDValMin = Math.max(0.12, tar.baseDVal / (pressureMultiplier * tempMultiplier * massTransferBoost));
    const residenceTimeMin = residenceTimeSec / 60;
    
    let calculatedLog = residenceTimeMin / effectiveDValMin;
    if (isSubCritical) {
      calculatedLog = calculatedLog * 0.42; // severe penalty for subcritical incomplete solubilization
    }

    if (metricLogReduction) {
      metricLogReduction.textContent = `${calculatedLog.toFixed(2)} Log`;
      if (calculatedLog >= 5.0) {
        metricLogReduction.className = "text-lg md:text-xl font-extrabold text-emerald-700 dark:text-emerald-300 font-mono";
      } else {
        metricLogReduction.className = "text-lg md:text-xl font-extrabold text-amber-600 font-mono";
      }
    }
    const survivalFraction = Math.pow(10, -calculatedLog);
    if (metricLogSub) metricLogSub.textContent = `Survival: ${survivalFraction.toExponential(1)} • Deff: ${(effectiveDValMin * 60).toFixed(0)}s`;

    // 7. Residual PPO Enzyme Activity (%)
    // PPO inactivation rate k_ppo
    const ppoInactRate = 0.012 * Math.pow(pressure / 100, 1.8) * Math.exp(0.06 * (temp - 30)) * mat.ppoSensitivity;
    const residualActivityPercent = Math.max(0.2, Math.min(100.0, 100.0 * Math.exp(-ppoInactRate * (residenceTimeSec / 60))));

    if (metricEnzymeActivity) metricEnzymeActivity.textContent = `${residualActivityPercent.toFixed(1)} %`;
    if (metricEnzymeSub) metricEnzymeSub.textContent = `${(100 - residualActivityPercent).toFixed(1)}% Inactivated (Anti-Browning)`;

    // 8. ASME BPVC Safety Factor
    const burstPressure = sys.burstPressure || 320.0;
    const asmeFactor = burstPressure / pressure;

    if (metricAsmeSafety) {
      metricAsmeSafety.textContent = `${asmeFactor.toFixed(2)}x`;
      if (asmeFactor < 1.5) {
        metricAsmeSafety.className = "text-lg md:text-xl font-extrabold text-rose-600 font-mono";
      } else if (asmeFactor < 2.0) {
        metricAsmeSafety.className = "text-lg md:text-xl font-extrabold text-amber-600 font-mono";
      } else {
        metricAsmeSafety.className = "text-lg md:text-xl font-extrabold text-sky-800 dark:text-sky-200 font-mono";
      }
    }
    if (metricAsmeSub) metricAsmeSub.textContent = `P_burst: ${burstPressure.toFixed(0)} bar (ASME VIII Div 1)`;

    // Process Status & Hero Card Assessment
    if (statusHeroCard && safetyStatusIcon && safetyStatusTitle && complianceBadge && primaryRiskText && mechanismsText && mitigationText) {
      if (asmeFactor < 1.35) {
        // Overpressure Hazard
        statusHeroCard.className = "p-6 rounded-2xl border mb-6 transition-all bg-rose-50 dark:bg-rose-950/40 border-rose-300 dark:border-rose-800 text-rose-950 dark:text-rose-100";
        safetyStatusIcon.textContent = "🚨";
        safetyStatusTitle.textContent = "ASME Overpressure Hazard / Wall Burst Risk";
        complianceBadge.className = "px-4 py-2 rounded-xl text-xs font-bold tracking-wider uppercase border border-rose-400 bg-rose-100 dark:bg-rose-900/60 text-rose-800 dark:text-rose-200";
        complianceBadge.textContent = "ASME SECTION VIII BREACH (SF < 1.5x)";
        primaryRiskText.textContent = "Operating pressure exceeds allowable continuous design working stress.";
        mechanismsText.textContent = "Severe hoop stress on thin-wall tubes; risk of elastomeric Kalrez extrusion.";
        mitigationText.textContent = "Immediately reduce backpressure valve setting or install ASME certified burst disk.";
      } else if (isSubCritical || calculatedLog < 4.0) {
        // Subcritical / Sterility Failure
        statusHeroCard.className = "p-6 rounded-2xl border mb-6 transition-all bg-amber-50 dark:bg-amber-950/40 border-amber-300 dark:border-amber-800 text-amber-950 dark:text-amber-100";
        safetyStatusIcon.textContent = "⚠️";
        safetyStatusTitle.textContent = "Sub-Critical Macro-Bubble & 5-Log Sterility Failure";
        complianceBadge.className = "px-4 py-2 rounded-xl text-xs font-bold tracking-wider uppercase border border-amber-400 bg-amber-100 dark:bg-amber-900/60 text-amber-800 dark:text-amber-200";
        complianceBadge.textContent = "NON-COMPLIANT (< 5.0 LOG REDUCTION)";
        primaryRiskText.textContent = "CO2 in subcritical gas/vapor phase; large coalesced bubbles bypass microbial contact.";
        mechanismsText.textContent = "Insufficient carbonic acid dissociation; bacterial proton pumps remain unexhausted.";
        mitigationText.textContent = "Elevate hydraulic pressure ≥ 100 bar and reduce Venturi micro-orifice diameter ≤ 35 µm.";
      } else if (calculatedLog >= 5.0) {
        // Fully Compliant Gold Master
        statusHeroCard.className = "p-6 rounded-2xl border mb-6 transition-all bg-emerald-50 dark:bg-emerald-950/40 border-emerald-300 dark:border-emerald-800 text-emerald-950 dark:text-emerald-100";
        safetyStatusIcon.textContent = "✅";
        safetyStatusTitle.textContent = "Validated Dense-Phase CO2 Aseptic Sterilization";
        complianceBadge.className = "px-4 py-2 rounded-xl text-xs font-bold tracking-wider uppercase border border-emerald-400 bg-emerald-100 dark:bg-emerald-900/60 text-emerald-800 dark:text-emerald-200";
        complianceBadge.textContent = "FDA 21 CFR § 120 COMPLIANT (≥ 5.0 LOG)";
        primaryRiskText.textContent = "Optimal supercritical fluid mass transfer; no microbial cold spots or channeling.";
        mechanismsText.textContent = "Complete cell membrane lipid extraction, internal pH collapse, and cyclone degassing.";
        mitigationText.textContent = "Maintain current continuous parameters (120-150 bar, 35-40°C) for validated HACCP run.";
      } else {
        // Marginal
        statusHeroCard.className = "p-6 rounded-2xl border mb-6 transition-all bg-sky-50 dark:bg-sky-950/40 border-sky-300 dark:border-sky-800 text-sky-950 dark:text-sky-100";
        safetyStatusIcon.textContent = "ℹ️";
        safetyStatusTitle.textContent = "Marginal Log Reduction (4.0 - 4.9 Log)";
        complianceBadge.className = "px-4 py-2 rounded-xl text-xs font-bold tracking-wider uppercase border border-sky-400 bg-sky-100 dark:bg-sky-900/60 text-sky-800 dark:text-sky-200";
        complianceBadge.textContent = "MARGINAL (NEEDS +15S HOLDING TIME)";
        primaryRiskText.textContent = "Microbial reduction approaches target but fails strict 5-log Juice HACCP criterion.";
        mechanismsText.textContent = "Moderate cytoplasmic acidification with partial enzyme inactivation.";
        mitigationText.textContent = "Increase CO2 injection ratio by 2% or slightly reduce throughput flow rate.";
      }
    }
  }

  // Preset Handlers
  presetCitrusBtn?.addEventListener('click', () => {
    if (systemSelect) systemSelect.value = 'commercial_high_pressure_hpcd_600l';
    if (matrixSelect) matrixSelect.value = 'cold_pressed_orange_juice';
    if (targetSelect) targetSelect.value = 'ecoli_o157h7';
    if (pressureSlider) pressureSlider.value = '120';
    if (tempSlider) tempSlider.value = '38';
    if (orificeSlider) orificeSlider.value = '25';
    if (co2RatioSlider) co2RatioSlider.value = '10.0';
    if (flowRateSlider) flowRateSlider.value = '600';
    updateSimulation();
  });

  presetCiderBtn?.addEventListener('click', () => {
    if (systemSelect) systemSelect.value = 'commercial_high_pressure_hpcd_600l';
    if (matrixSelect) matrixSelect.value = 'cloudy_apple_cider';
    if (targetSelect) targetSelect.value = 'ppo_enzyme';
    if (pressureSlider) pressureSlider.value = '140';
    if (tempSlider) tempSlider.value = '40';
    if (orificeSlider) orificeSlider.value = '20';
    if (co2RatioSlider) co2RatioSlider.value = '12.0';
    if (flowRateSlider) flowRateSlider.value = '500';
    updateSimulation();
  });

  presetEggBtn?.addEventListener('click', () => {
    if (systemSelect) systemSelect.value = 'commercial_high_pressure_hpcd_600l';
    if (matrixSelect) matrixSelect.value = 'liquid_whole_egg';
    if (targetSelect) targetSelect.value = 'salmonella_enteritidis';
    if (pressureSlider) pressureSlider.value = '160';
    if (tempSlider) tempSlider.value = '36';
    if (orificeSlider) orificeSlider.value = '35';
    if (co2RatioSlider) co2RatioSlider.value = '8.0';
    if (flowRateSlider) flowRateSlider.value = '450';
    updateSimulation();
  });

  presetChannelingBtn?.addEventListener('click', () => {
    if (systemSelect) systemSelect.value = 'compromised_channeling_hpcd';
    if (matrixSelect) matrixSelect.value = 'cold_pressed_orange_juice';
    if (targetSelect) targetSelect.value = 'ecoli_o157h7';
    if (pressureSlider) pressureSlider.value = '45';
    if (tempSlider) tempSlider.value = '24';
    if (orificeSlider) orificeSlider.value = '85';
    if (co2RatioSlider) co2RatioSlider.value = '4.0';
    if (flowRateSlider) flowRateSlider.value = '750';
    updateSimulation();
  });

  // Listeners
  [systemSelect, matrixSelect, targetSelect].forEach(el => el?.addEventListener('change', updateSimulation));
  [pressureSlider, tempSlider, orificeSlider, co2RatioSlider, flowRateSlider].forEach(el => el?.addEventListener('input', updateSimulation));

  // Initialize
  updateSimulation();
</script>
