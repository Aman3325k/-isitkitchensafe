          <span>50 L/h</span>
          <span>1,500 L/h</span>
          <span>3,000 L/h</span>
        </div>
        <p class="text-[11px] text-muted mt-1 leading-normal">
          {d.flowRateHelp}
        </p>
      </div>

      <!-- 8. Target Pathogen / Enzyme Selection -->
      <div>
        <label for="targetSelect" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1">
          {d.targetLabel}
