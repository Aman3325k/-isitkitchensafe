          <span>20 °C</span>
          <span class="text-amber-600 font-bold">Tc = 31.1 °C</span>
          <span>55 °C</span>
        </div>
        <p class="text-[11px] text-muted mt-1 leading-normal">
          {d.tempHelp}
        </p>
      </div>

      <!-- 5. Venturi Orifice Slider -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <label for="orificeSlider" class="text-xs font-bold uppercase tracking-wider text-ink">
            {d.orificeLabel}
          </label>
          <span class="text-xs font-mono font-bold px-2 py-0.5 rounded bg-indigo-100 dark:bg-indigo-900/60 text-indigo-800 dark:text-indigo-200" id="orificeValue">
            25 µm
          </span>
        </div>
        <input 
          type="range" 
          id="orificeSlider" 
          min="15" 
          max="100" 
          step="5" 
          value="25"
          class="w-full h-2 bg-hairline rounded-lg appearance-none cursor-pointer accent-indigo-600"
        />
        <div class="flex justify-between text-[10px] text-muted font-mono mt-0.5">
          <span>15 µm (Sub-Micro)</span>
          <span>50 µm</span>
          <span>100 µm (Macro)</span>
        </div>
        <p class="text-[11px] text-muted mt-1 leading-normal">
          {d.orificeHelp}
        </p>
      </div>

      <!-- 6. CO2 Mass Ratio Slider -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <label for="co2RatioSlider" class="text-xs font-bold uppercase tracking-wider text-ink">
            {d.co2RatioLabel}
          </label>
          <span class="text-xs font-mono font-bold px-2 py-0.5 rounded bg-emerald-100 dark:bg-emerald-900/60 text-emerald-800 dark:text-emerald-200" id="co2RatioValue">
            10.0 %
          </span>
        </div>
        <input 
          type="range" 
          id="co2RatioSlider" 
          min="2.0" 
          max="20.0" 
          step="0.5" 
          value="10.0"
          class="w-full h-2 bg-hairline rounded-lg appearance-none cursor-pointer accent-emerald-600"
        />
        <div class="flex justify-between text-[10px] text-muted font-mono mt-0.5">
          <span>2.0%</span>
          <span>10.0%</span>
          <span>20.0%</span>
        </div>
        <p class="text-[11px] text-muted mt-1 leading-normal">
          {d.co2RatioHelp}
        </p>
      </div>

      <!-- 7. Flow Rate Slider -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <label for="flowRateSlider" class="text-xs font-bold uppercase tracking-wider text-ink">
            {d.flowRateLabel}
          </label>
          <span class="text-xs font-mono font-bold px-2 py-0.5 rounded bg-purple-100 dark:bg-purple-900/60 text-purple-800 dark:text-purple-200" id="flowRateValue">
            600 L/h
          </span>
        </div>
        <input 
          type="range" 
          id="flowRateSlider" 
          min="50" 
          max="3000" 
          step="50" 
          value="600"
          class="w-full h-2 bg-hairline rounded-lg appearance-none cursor-pointer accent-purple-600"
        />
