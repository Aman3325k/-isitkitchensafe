      <!-- Copy Report Action -->
      <div class="pt-2 flex justify-end">
        <button 
          type="button" 
          id="rh-copy-report-btn" 
          class="inline-flex items-center gap-2 text-xs font-semibold px-4 py-2.5 rounded-xl bg-ink text-white hover:bg-black transition-colors cursor-pointer shadow-xs"
        >
          <span>📋</span>
          <span id="rh-copy-btn-text">{d.copyReportBtn}</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Comparative Reference Table: Range Hood Architectures -->
  <div class="mt-12 pt-8 border-t border-hairline">
    <div class="mb-6">
      <h3 class="text-lg md:text-xl font-bold text-ink">{d.tableTitle}</h3>
      <p class="text-xs md:text-sm text-muted mt-1">{d.tableSub}</p>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs border border-hairline rounded-xl overflow-hidden">
        <thead class="bg-surface-soft text-ink font-bold border-b border-hairline">
          <tr>
            <th class="p-3">{d.colHood}</th>
            <th class="p-3">{d.colDepth}</th>
            <th class="p-3">{d.colFrontCapture}</th>
            <th class="p-3">{d.colRearCapture}</th>
            <th class="p-3">{d.colNo2Removal}</th>
            <th class="p-3">{d.colSones}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline bg-white">
          {hoodData.hoodTypes.map(h => (
            <tr class="hover:bg-surface-soft/40 transition-colors">
              <td class="p-3 font-semibold text-ink">
                {h.name}
              </td>
              <td class="p-3 font-mono text-body">
                {h.depthInches}" (Sump: {h.sumpReservoirDepthInches}")
              </td>
              <td class="p-3 font-mono">
                <span class={h.baselineCaptureEfficiencyFront >= 0.75 ? "text-emerald-700 font-bold" : h.baselineCaptureEfficiencyFront >= 0.50 ? "text-amber-700 font-bold" : "text-red-700 font-bold"}>
                  {Math.round(h.baselineCaptureEfficiencyFront * 100)}%
                </span>
              </td>
              <td class="p-3 font-mono">
                <span class={h.baselineCaptureEfficiencyRear >= 0.85 ? "text-emerald-700 font-bold" : "text-amber-700 font-bold"}>
                  {Math.round(h.baselineCaptureEfficiencyRear * 100)}%
                </span>
              </td>
              <td class="p-3 font-mono text-body">
                {h.id === 'recirculating-ductless-charcoal' ? (
                  <span class="text-red-700 font-bold">0% (Recirculated)</span>
                ) : (
                  <span class="text-emerald-700 font-bold">100% (Ducted Outside)</span>
                )}
              </td>
              <td class="p-3 font-mono text-muted">
                {h.soundLevelSonesAtHigh} Sones
              </td>
