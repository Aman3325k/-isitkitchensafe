        </select>
      </div>
    </div>

    <!-- Right Column: Live Diagnostics & Gauge Telemetry (7 Cols) -->
    <div class="lg:col-span-7 bg-white border border-hairline rounded-2xl p-6 md:p-8 shadow-2xs space-y-6">
      <div class="border-b border-hairline/80 pb-3 flex flex-wrap items-center justify-between gap-2">
