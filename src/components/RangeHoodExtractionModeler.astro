const d = dict[lang] || dict.en;
---

<div id="range-hood-modeler-container" class="my-10 bg-canvas border border-hairline rounded-3xl p-6 md:p-10 shadow-xs">
  <!-- Top Badge & Header -->
  <div class="mb-8 border-b border-hairline/80 pb-6">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-blue-100 text-blue-900 mb-3">
      <span>💨</span>
      {d.badge}
    </div>
    <h2 class="text-2xl md:text-3xl font-extrabold text-ink tracking-tight">
      {d.title}
    </h2>
    <p class="text-body text-sm md:text-base mt-2 max-w-4xl leading-relaxed">
      {d.subtitle}
    </p>

    <!-- Preset Shortcuts Bar -->
    <div class="mt-6 pt-4 border-t border-hairline/60">
      <span class="text-xs font-bold uppercase tracking-wider text-muted block mb-2.5">
        ⚡ {d.presetsTitle}
      </span>
      <div class="flex flex-wrap gap-2">
        <button type="button" data-preset="preset-condo-gas-disaster" class="rh-preset-btn text-xs font-medium px-3 py-1.5 rounded-lg bg-surface-soft hover:bg-surface-strong border border-hairline transition-colors">
          ⚠️ {d.presetCondo}
        </button>
        <button type="button" data-preset="preset-pro-chef-island" class="rh-preset-btn text-xs font-medium px-3 py-1.5 rounded-lg bg-surface-soft hover:bg-surface-strong border border-hairline transition-colors">
          🔥 {d.presetProIsland}
        </button>
        <button type="button" data-preset="preset-clean-induction-canopy" class="rh-preset-btn text-xs font-medium px-3 py-1.5 rounded-lg bg-surface-soft hover:bg-surface-strong border border-hairline transition-colors">
          🍃 {d.presetInduction}
        </button>
        <button type="button" data-preset="preset-otr-microwave-sear" class="rh-preset-btn text-xs font-medium px-3 py-1.5 rounded-lg bg-surface-soft hover:bg-surface-strong border border-hairline transition-colors">
          📉 {d.presetOtr}
        </button>
      </div>
    </div>
  </div>

  <!-- Interactive Controls & Diagnostics Dual Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Left Column: Controls (5 Cols) -->
    <div class="lg:col-span-5 bg-surface-soft/60 border border-hairline rounded-2xl p-5 md:p-6 space-y-5">
      <div class="border-b border-hairline/80 pb-3">
        <h3 class="text-base font-bold text-ink">{d.controlsTitle}</h3>
        <p class="text-xs text-muted mt-0.5">{d.controlsSub}</p>
      </div>

      <!-- 1. Cooktop Selection -->
      <div>
        <label for="rh-cooktop-select" class="block text-xs font-semibold text-ink mb-1.5">
          {d.cooktopLabel}
        </label>
        <select id="rh-cooktop-select" class="w-full bg-white border border-hairline rounded-xl px-3 py-2 text-xs font-medium text-ink focus:outline-none focus:ring-2 focus:ring-blue-500">
          {hoodData.cooktopTypes.map(ct => (
            <option value={ct.id} selected={ct.id === 'gas-standard-4burner'}>
              {ct.name} ({ct.heatOutputBTU > 0 ? `${ct.heatOutputBTU.toLocaleString()} BTU` : `${ct.heatOutputKw} kW`})
            </option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1 leading-tight">{d.cooktopHelp}</p>
      </div>

      <!-- 2. Cooking Process -->
      <div>
        <label for="rh-process-select" class="block text-xs font-semibold text-ink mb-1.5">
          {d.processLabel}
        </label>
        <select id="rh-process-select" class="w-full bg-white border border-hairline rounded-xl px-3 py-2 text-xs font-medium text-ink focus:outline-none focus:ring-2 focus:ring-blue-500">
          {hoodData.cookingProcesses.map(proc => (
            <option value={proc.id} selected={proc.id === 'high-heat-wok-searing'}>
              {proc.name} ({proc.panTemperatureF}°F / {proc.panTemperatureC}°C)
            </option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1 leading-tight">{d.processHelp}</p>
      </div>

      <!-- 3. Range Hood Architecture -->
      <div>
        <label for="rh-hood-select" class="block text-xs font-semibold text-ink mb-1.5">
          {d.hoodLabel}
        </label>
        <select id="rh-hood-select" class="w-full bg-white border border-hairline rounded-xl px-3 py-2 text-xs font-medium text-ink focus:outline-none focus:ring-2 focus:ring-blue-500">
          {hoodData.hoodTypes.map(h => (
            <option value={h.id} selected={h.id === 'ducted-wall-canopy'}>
              {h.name} (Depth: {h.depthInches}")
            </option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1 leading-tight">{d.hoodHelp}</p>
      </div>

      <!-- 4. Rated Blower CFM Slider -->
      <div>
        <div class="flex items-center justify-between mb-1.5">
          <label for="rh-cfm-slider" class="text-xs font-semibold text-ink">
            {d.cfmLabel}
          </label>
          <span id="rh-cfm-val" class="font-mono text-xs font-bold text-ink bg-white px-2 py-0.5 rounded border border-hairline">
            400 CFM
          </span>
        </div>
        <input 
          type="range" 
          id="rh-cfm-slider" 
          min="150" 
          max="1200" 
          step="50" 
          value="400" 
          class="w-full accent-blue-600 cursor-pointer"
        />
        <div class="flex justify-between text-[10px] text-muted mt-1 font-mono">
          <span>150 (Weak)</span>
          <span>400 (Standard)</span>
          <span>1200 (Pro)</span>
        </div>
        <p class="text-[11px] text-muted mt-1 leading-tight">{d.cfmHelp}</p>
      </div>

      <!-- 5. Active Burner Location -->
      <div>
        <label for="rh-burner-select" class="block text-xs font-semibold text-ink mb-1.5">
          {d.burnerLabel}
        </label>
        <select id="rh-burner-select" class="w-full bg-white border border-hairline rounded-xl px-3 py-2 text-xs font-medium text-ink focus:outline-none focus:ring-2 focus:ring-blue-500">
          <option value="front">{d.frontBurner}</option>
          <option value="rear" selected>{d.rearBurner}</option>
        </select>
        <p class="text-[11px] text-muted mt-1 leading-tight">{d.burnerHelp}</p>
      </div>

      <!-- 6. Mounting Height Slider -->
      <div>
        <div class="flex items-center justify-between mb-1.5">
          <label for="rh-height-slider" class="text-xs font-semibold text-ink">
            {d.mountHeightLabel}
          </label>
          <span id="rh-height-val" class="font-mono text-xs font-bold text-ink bg-white px-2 py-0.5 rounded border border-hairline">
            28 in
          </span>
        </div>
        <input 
          type="range" 
          id="rh-height-slider" 
          min="18" 
          max="38" 
          step="1" 
          value="28" 
          class="w-full accent-blue-600 cursor-pointer"
        />
        <div class="flex justify-between text-[10px] text-muted mt-1 font-mono">
          <span>18" (Low)</span>
          <span>28" (Optimal)</span>
          <span>38" (High / Drafty)</span>
        </div>
        <p class="text-[11px] text-muted mt-1 leading-tight">{d.mountHeightHelp}</p>
      </div>

      <!-- 7. Kitchen Floor Area Slider -->
      <div>
        <div class="flex items-center justify-between mb-1.5">
          <label for="rh-area-slider" class="text-xs font-semibold text-ink">
            {d.areaLabel}
          </label>
          <span id="rh-area-val" class="font-mono text-xs font-bold text-ink bg-white px-2 py-0.5 rounded border border-hairline">
            180 sq ft
          </span>
        </div>
        <input 
          type="range" 
          id="rh-area-slider" 
          min="80" 
          max="500" 
          step="10" 
          value="180" 
          class="w-full accent-blue-600 cursor-pointer"
        />
        <div class="flex justify-between text-[10px] text-muted mt-1 font-mono">
          <span>80 sq ft (Studio)</span>
          <span>180 sq ft</span>
          <span>500 sq ft (Great Room)</span>
        </div>
        <p class="text-[11px] text-muted mt-1 leading-tight">{d.areaHelp}</p>
      </div>

      <!-- 8. Ceiling Height Selection -->
      <div>
        <label for="rh-ceiling-select" class="block text-xs font-semibold text-ink mb-1.5">
          {d.ceilingLabel}
        </label>
        <select id="rh-ceiling-select" class="w-full bg-white border border-hairline rounded-xl px-3 py-2 text-xs font-medium text-ink focus:outline-none focus:ring-2 focus:ring-blue-500">
          <option value="8">8 ft (Standard)</option>
          <option value="9" selected>9 ft (Modern Standard)</option>
          <option value="10">10 ft (High Ceiling)</option>
          <option value="12">12 ft (Cathedral / Vaulted)</option>
        </select>
        <p class="text-[11px] text-muted mt-1 leading-tight">{d.ceilingHelp}</p>
      </div>

      <!-- 9. Venting Mode Toggle & Conditional Inputs -->
      <div class="pt-2 border-t border-hairline/80">
        <label for="rh-vent-select" class="block text-xs font-semibold text-ink mb-1.5">
          {d.ventModeLabel}
        </label>
        <select id="rh-vent-select" class="w-full bg-white border border-hairline rounded-xl px-3 py-2 text-xs font-medium text-ink focus:outline-none focus:ring-2 focus:ring-blue-500">
          <option value="ducted" selected>{d.ductedMode}</option>
          <option value="ductless">{d.ductlessMode}</option>
        </select>
        <p class="text-[11px] text-muted mt-1 leading-tight">{d.ventModeHelp}</p>
      </div>

      <!-- Ducted Options Panel -->
      <div id="rh-ducted-panel" class="space-y-4 pt-2">
        <div>
          <label for="rh-duct-profile-select" class="block text-xs font-semibold text-ink mb-1">
            {d.ductProfileLabel}
          </label>
          <select id="rh-duct-profile-select" class="w-full bg-white border border-hairline rounded-xl px-3 py-2 text-xs font-medium text-ink">
            {hoodData.ductProfiles.map(dp => (
              <option value={dp.id} selected={dp.id === 'duct-6inch-rigid'}>
                {dp.name}
              </option>
            ))}
          </select>
          <p class="text-[11px] text-muted mt-0.5 leading-tight">{d.ductProfileHelp}</p>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="rh-duct-length" class="block text-xs font-semibold text-ink mb-1">
              {d.ductLengthLabel}
            </label>
            <input type="number" id="rh-duct-length" min="3" max="50" value="12" class="w-full bg-white border border-hairline rounded-xl px-3 py-2 text-xs font-mono text-ink" />
          </div>
          <div>
