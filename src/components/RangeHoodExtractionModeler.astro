</div>

<script is:inline define:vars={{ hoodData, d }}>
(function() {
  function initRangeHoodModeler() {
    const container = document.getElementById('range-hood-modeler-container');
    if (!container) return;

    // Elements
    const cooktopSelect = document.getElementById('rh-cooktop-select');
    const processSelect = document.getElementById('rh-process-select');
    const hoodSelect = document.getElementById('rh-hood-select');
    const cfmSlider = document.getElementById('rh-cfm-slider');
    const cfmVal = document.getElementById('rh-cfm-val');
    const burnerSelect = document.getElementById('rh-burner-select');
    const heightSlider = document.getElementById('rh-height-slider');
    const heightVal = document.getElementById('rh-height-val');
    const areaSlider = document.getElementById('rh-area-slider');
    const areaVal = document.getElementById('rh-area-val');
    const ceilingSelect = document.getElementById('rh-ceiling-select');
    const ventSelect = document.getElementById('rh-vent-select');
    const ductedPanel = document.getElementById('rh-ducted-panel');
    const ductlessPanel = document.getElementById('rh-ductless-panel');
    const ductProfileSelect = document.getElementById('rh-duct-profile-select');
    const ductLengthInput = document.getElementById('rh-duct-length');
    const ductElbowsInput = document.getElementById('rh-duct-elbows');
    const filterAgeSelect = document.getElementById('rh-filter-age-select');
    const occupantSelect = document.getElementById('rh-occupant-select');

    // Outputs
    const flowDeltaPill = document.getElementById('rh-flow-delta-pill');
    const statusCard = document.getElementById('rh-status-card');
    const scoreNum = document.getElementById('rh-score-num');
    const statusTitle = document.getElementById('rh-status-title');
    const statusDesc = document.getElementById('rh-status-desc');
    const effectiveCfmVal = document.getElementById('rh-effective-cfm-val');
    const cfmLossText = document.getElementById('rh-cfm-loss-text');
    const achVal = document.getElementById('rh-ach-val');
    const achStatus = document.getElementById('rh-ach-status');
    const captureEffVal = document.getElementById('rh-capture-eff-val');
    const plumeSpillText = document.getElementById('rh-plume-spill-text');
    const no2Val = document.getElementById('rh-no2-val');
    const no2Benchmark = document.getElementById('rh-no2-benchmark');
    const pm25Val = document.getElementById('rh-pm25-val');
    const pm25Aqi = document.getElementById('rh-pm25-aqi');
    const pediatricVal = document.getElementById('rh-pediatric-val');
    const pediatricOdds = document.getElementById('rh-pediatric-odds');
    const warningBox = document.getElementById('rh-warning-box');
    const warningTitle = document.getElementById('rh-warning-title');
    const warningText = document.getElementById('rh-warning-text');
    const copyReportBtn = document.getElementById('rh-copy-report-btn');
    const copyBtnText = document.getElementById('rh-copy-btn-text');

    // Lookup data
    const cooktopMap = {};
    hoodData.cooktopTypes.forEach(c => { cooktopMap[c.id] = c; });
    const processMap = {};
    hoodData.cookingProcesses.forEach(p => { processMap[p.id] = p; });
    const hoodMap = {};
    hoodData.hoodTypes.forEach(h => { hoodMap[h.id] = h; });
    const ductMap = {};
    hoodData.ductProfiles.forEach(d => { ductMap[d.id] = d; });
    const presetMap = {};
    hoodData.presets.forEach(pr => { presetMap[pr.id] = pr; });

    function recalculate() {
      const cooktop = cooktopMap[cooktopSelect.value] || hoodData.cooktopTypes[0];
      const process = processMap[processSelect.value] || hoodData.cookingProcesses[0];
      const hood = hoodMap[hoodSelect.value] || hoodData.hoodTypes[0];
      const ratedCFM = parseInt(cfmSlider.value, 10);
      const burner = burnerSelect.value;
      const mountHeight = parseInt(heightSlider.value, 10);
      const floorArea = parseInt(areaSlider.value, 10);
      const ceilingHeight = parseFloat(ceilingSelect.value);
      const ventMode = ventSelect.value;
      const isPediatric = occupantSelect.value === 'pediatric';

      // Update Slider labels
      if (cfmVal) cfmVal.textContent = `${ratedCFM} CFM`;
      if (heightVal) heightVal.textContent = `${mountHeight} in`;
      if (areaVal) areaVal.textContent = `${floorArea} sq ft`;

      // Toggle Panels
      if (ventMode === 'ducted') {
        if (ductedPanel) ductedPanel.classList.remove('hidden');
        if (ductlessPanel) ductlessPanel.classList.add('hidden');
      } else {
        if (ductedPanel) ductedPanel.classList.add('hidden');
        if (ductlessPanel) ductlessPanel.classList.remove('hidden');
      }

      // 1. Calculate Duct Drag & Effective Delivered CFM
      let effectiveCFM = ratedCFM;
      let cfmLossPercent = 0;

      if (ventMode === 'ducted') {
        const duct = ductMap[ductProfileSelect.value] || hoodData.ductProfiles[0];
        const ductLength = parseFloat(ductLengthInput.value) || 12;
        const elbows = parseInt(ductElbowsInput.value, 10) || 1;
        // Equivalent duct length: each elbow adds 8 ft equivalent length
        const equivLength = ductLength + (elbows * 8);
        // Friction loss factor
        const frictionLoss = (equivLength / 100) * 0.15 * duct.frictionFactorEquivalent;
        cfmLossPercent = Math.min(50, Math.round(frictionLoss * 100));
        effectiveCFM = Math.max(100, Math.round(ratedCFM * (1 - (cfmLossPercent / 100))));
      } else {
        // Recirculating charcoal filter loss (35–45% CFM drop)
        const age = filterAgeSelect.value;
        cfmLossPercent = age === 'new' ? 30 : age === 'moderate' ? 38 : 45;
        effectiveCFM = Math.max(80, Math.round(ratedCFM * (1 - (cfmLossPercent / 100))));
      }

      // 2. Kitchen Volume & Air Changes per Hour (ACH)
      const kitchenVolumeCuFt = floorArea * ceilingHeight;
      const ach = ((effectiveCFM * 60) / kitchenVolumeCuFt).toFixed(1);

      // 3. Plume Capture Efficiency %
      let baseCapture = (burner === 'front') ? hood.baselineCaptureEfficiencyFront : hood.baselineCaptureEfficiencyRear;

      // Height penalty: optimal is 24–28"; above 28" loses 2% per inch
      let heightPenalty = 0;
      if (mountHeight > 28) {
        heightPenalty = (mountHeight - 28) * 0.025;
      }
      baseCapture = Math.max(0.15, baseCapture - heightPenalty);

      // Thermal Upthrust vs CFM adequacy
      // Gas needs 100 CFM per 10,000 BTU
      if (cooktop.heatOutputBTU > 0) {
        const minCfmNeeded = (cooktop.heatOutputBTU / 10000) * 100;
        if (effectiveCFM < minCfmNeeded) {
          const cfmDeficitRatio = effectiveCFM / minCfmNeeded;
          baseCapture = baseCapture * (0.6 + (0.4 * cfmDeficitRatio));
        }
      }

      const captureEfficiency = Math.max(0.15, Math.min(0.98, baseCapture));
      const capturePct = Math.round(captureEfficiency * 100);
      const spillPct = 100 - capturePct;

      // 4. Nitrogen Dioxide (NO2) Exposure Modeling
      let steadyStateNo2Ppb = 0;
      let peakNo2Ppb = 0;

      if (cooktop.no2EmissionRateUgPerMin > 0) {
        // If ducted: escaped NO2 = emission * (1 - capture)
        // If ductless: charcoal filters capture 0% of NO2! 100% of generated NO2 remains indoors
        let indoorNo2EmissionRate = 0;
        if (ventMode === 'ducted') {
          indoorNo2EmissionRate = cooktop.no2EmissionRateUgPerMin * (1 - captureEfficiency);
        } else {
          indoorNo2EmissionRate = cooktop.no2EmissionRateUgPerMin; // 100% pass-through
        }

        // Room dilution formula: C_steady = Emission_Rate / (Volume_m3 * ACH_per_min)
        const roomVolumeM3 = kitchenVolumeCuFt * 0.0283168;
        const achPerMin = Math.max(0.05, parseFloat(ach) / 60);
        // Concentration in ug/m3
        const concUgM3 = indoorNo2EmissionRate / (roomVolumeM3 * achPerMin);
        // Conversion: 1 ppb NO2 ≈ 1.88 ug/m3
        steadyStateNo2Ppb = Math.round(concUgM3 / 1.88);
        peakNo2Ppb = Math.round(steadyStateNo2Ppb * 1.6); // localized surge near stove
      }

      // 5. PM2.5 Fine Particulate Cooking Aerosols
      let escapedPm25Rate = process.pm25EmissionRateUgPerMin * (1 - captureEfficiency);
      if (ventMode === 'ductless') {
        // Charcoal grease mesh only captures ~70% of PM2.5
        escapedPm25Rate += process.pm25EmissionRateUgPerMin * captureEfficiency * 0.30;
      }
      const roomVolumeM3 = kitchenVolumeCuFt * 0.0283168;
      const achPerMin = Math.max(0.05, parseFloat(ach) / 60);
      const pm25UgM3 = Math.round(escapedPm25Rate / (roomVolumeM3 * achPerMin));

      // 6. Extraction Health Score (0-100)
      let score = 95;

      // Gas without ducted exterior exhaust penalty
      if (cooktop.heatOutputBTU > 0 && ventMode === 'ductless') {
        score -= 40; // Critical health penalty: NO2 trapped
      }

      // Capture efficiency impact
      if (captureEfficiency < 0.5) score -= 25;
      else if (captureEfficiency < 0.75) score -= 15;

      // ACH adequacy impact (cooking space needs >8 ACH)
      if (parseFloat(ach) < 5) score -= 20;
      else if (parseFloat(ach) < 8) score -= 10;

      // Front burner penalty
      if (burner === 'front' && hood.depthInches < 20) score -= 10;

      // Corrugated flexible duct penalty
      if (ventMode === 'ducted' && ductProfileSelect.value === 'duct-6inch-flexible-corrugated') {
        score -= 10;
      }

      // Mounting height excessive
      if (mountHeight > 32) score -= 8;

      score = Math.max(10, Math.min(99, score));

      // 7. Pediatric Asthma Risk Stratification
      let pediatricRiskStr = 'LOW';
      let pediatricRiskColor = 'text-emerald-700';
      let oddsRatioStr = '1.0x (Baseline)';

      if (cooktop.heatOutputBTU > 0) {
        if (ventMode === 'ductless' || peakNo2Ppb > 150) {
          pediatricRiskStr = 'CRITICAL HAZARD';
          pediatricRiskColor = 'text-red-700';
          oddsRatioStr = '+42% Inhalation Hazard (RMI 2023)';
        } else if (peakNo2Ppb > 80 || pm25UgM3 > 55) {
          pediatricRiskStr = 'ELEVATED RISK';
          pediatricRiskColor = 'text-amber-700';
          oddsRatioStr = '+24% Asthma Exacerbation Risk';
        } else {
          pediatricRiskStr = 'MODERATE';
          pediatricRiskColor = 'text-amber-600';
          oddsRatioStr = '+10% Minor Airway Irritation';
        }
      } else {
        // Induction / Electric
        if (pm25UgM3 > 100) {
          pediatricRiskStr = 'ELEVATED OIL PM2.5';
          pediatricRiskColor = 'text-amber-700';
          oddsRatioStr = 'Acute Aerosol Lung Irritation';
        } else {
          pediatricRiskStr = 'CLEAN AIR BASELINE';
          pediatricRiskColor = 'text-emerald-700';
          oddsRatioStr = 'Zero Combustion Byproducts';
        }
      }

      // Update Live UI
      if (scoreNum) scoreNum.textContent = score.toString();
      if (effectiveCfmVal) effectiveCfmVal.textContent = effectiveCFM.toString();
      if (cfmLossText) cfmLossText.textContent = `-${cfmLossPercent}% Duct/Filter Drag`;
      if (achVal) achVal.textContent = ach.toString();
      if (captureEffVal) captureEffVal.textContent = `${capturePct}%`;
      if (plumeSpillText) plumeSpillText.textContent = `${spillPct}% Plume Spill Escape`;
      if (no2Val) no2Val.textContent = peakNo2Ppb.toString();
      if (pm25Val) pm25Val.textContent = pm25UgM3.toString();
      if (pediatricVal) {
        pediatricVal.textContent = pediatricRiskStr;
        pediatricVal.className = `text-sm md:text-base font-black font-mono ${pediatricRiskColor}`;
      }
      if (pediatricOdds) pediatricOdds.textContent = oddsRatioStr;

      // Status Card Appearance
      if (statusCard && statusTitle && statusDesc) {
        if (score >= 80) {
          statusCard.className = 'rounded-2xl p-6 border transition-all bg-emerald-50 border-emerald-300';
          statusTitle.textContent = 'EXCELLENT: HIGH-EFFICIENCY CAPTURE & EXTERIOR EVACUATION';
          statusTitle.className = 'text-lg font-extrabold text-emerald-950 mb-1';
          statusDesc.textContent = 'Adequate capture velocity and exterior ducting keep indoor NO2 and cooking PM2.5 within strict WHO/EPA environmental health standards.';
          if (scoreNum) scoreNum.className = 'text-4xl md:text-5xl font-black font-mono text-emerald-800';
        } else if (score >= 50) {
          statusCard.className = 'rounded-2xl p-6 border transition-all bg-amber-50 border-amber-300';
          statusTitle.textContent = 'SUBOPTIMAL: PARTIAL PLUME ESCAPE & INDOOR POLLUTANT ACCUMULATION';
          statusTitle.className = 'text-lg font-extrabold text-amber-950 mb-1';
          statusDesc.textContent = 'Thermal plume spills into living areas due to front burner cooking, low CFM, or duct drag. Consider cooking on back burners and cracking a window for make-up air.';
          if (scoreNum) scoreNum.className = 'text-4xl md:text-5xl font-black font-mono text-amber-800';
        } else {
          statusCard.className = 'rounded-2xl p-6 border transition-all bg-red-50 border-red-300';
          statusTitle.textContent = 'HAZARDOUS: GAS COMBUSTION TRAPPED INDOORS';
          statusTitle.className = 'text-lg font-extrabold text-red-950 mb-1';
          statusDesc.textContent = 'Ductless recirculating hoods cannot remove nitrogen dioxide or carbon monoxide from gas burners. Inhaled concentrations exceed EPA outdoor emergency levels.';
          if (scoreNum) scoreNum.className = 'text-4xl md:text-5xl font-black font-mono text-red-800';
        }
      }

      // Benchmarks pill
      if (flowDeltaPill) {
        if (cooktop.heatOutputBTU > 0 && ventMode === 'ductless') {
          flowDeltaPill.className = 'text-[11px] font-mono px-2.5 py-1 rounded font-semibold bg-red-100 text-red-900 border border-red-200';
          flowDeltaPill.textContent = '⚠️ Ductless Gas Hazard (0% NO2 Removal)';
        } else if (effectiveCFM >= (cooktop.heatOutputBTU / 100)) {
          flowDeltaPill.className = 'text-[11px] font-mono px-2.5 py-1 rounded font-semibold bg-emerald-100 text-emerald-900 border border-emerald-200';
          flowDeltaPill.textContent = '✓ CFM Meets HVI Gas Benchmark';
        } else {
          flowDeltaPill.className = 'text-[11px] font-mono px-2.5 py-1 rounded font-semibold bg-amber-100 text-amber-900 border border-amber-200';
          flowDeltaPill.textContent = '⚠️ Under-Delivering CFM';
        }
      }

      // Specific Warning Alerts
      if (warningBox && warningText) {
        if (cooktop.heatOutputBTU > 0 && ventMode === 'ductless') {
          warningBox.classList.remove('hidden');
          warningBox.className = 'rounded-xl p-4 border transition-all bg-red-50 border-red-300 text-red-950 block';
          warningText.textContent = 'CRITICAL WARNING: Ductless recirculating hoods equipped with charcoal filters do NOT adsorb nitrogen dioxide (NO2) or carbon monoxide (CO). 100% of gas combustion gases are blown directly back into your kitchen air. Children face a 42% higher risk of developing asthma in gas kitchens without exterior ducting (Gruenwald et al. 2023).';
        } else if (burner === 'front' && capturePct < 60) {
          warningBox.classList.remove('hidden');
          warningBox.className = 'rounded-xl p-4 border transition-all bg-amber-50 border-amber-300 text-amber-950 block';
          warningText.textContent = `AERODYNAMIC SPILL WARNING: Cooking high-heat food on front burners causes ${spillPct}% of the rising smoke plume to bypass the hood. Switch heavy searing and frying pans to the rear burners to utilize the backsplash as a natural air guide.`;
        } else if (ventMode === 'ducted' && ductProfileSelect.value === 'duct-6inch-flexible-corrugated') {
          warningBox.classList.remove('hidden');
          warningBox.className = 'rounded-xl p-4 border transition-all bg-amber-50 border-amber-300 text-amber-950 block';
          warningText.textContent = 'FIRE & RESTRICTION ALERT: Flexible corrugated accordion ducting creates intense aerodynamic friction, slashing fan flow rate by ~35% while trapping aerosolized grease in the ridges, presenting a severe chimney fire risk.';
        } else {
          warningBox.classList.add('hidden');
        }
      }
    }

    // Preset loaders
    function applyPreset(presetId) {
      const preset = presetMap[presetId];
      if (!preset) return;

      if (cooktopSelect) cooktopSelect.value = preset.cooktop;
      if (processSelect) processSelect.value = preset.cookingProcess;
      if (hoodSelect) hoodSelect.value = preset.hood;
      if (cfmSlider) cfmSlider.value = preset.ratedCFM.toString();
      if (areaSlider) areaSlider.value = preset.kitchenAreaSqFt.toString();
      if (ceilingSelect) ceilingSelect.value = preset.ceilingHeightFt.toString();
      if (burnerSelect) burnerSelect.value = preset.burnerLocation;
      if (heightSlider) heightSlider.value = preset.mountingHeightInches.toString();
      if (ventSelect) ventSelect.value = preset.ventingMode;
      if (preset.ductProfile && ductProfileSelect) ductProfileSelect.value = preset.ductProfile;
      if (preset.ductLengthFt && ductLengthInput) ductLengthInput.value = preset.ductLengthFt.toString();
      if (preset.ductElbows && ductElbowsInput) ductElbowsInput.value = preset.ductElbows.toString();
      if (preset.filterAgeMonths && filterAgeSelect) {
        filterAgeSelect.value = preset.filterAgeMonths <= 2 ? 'new' : preset.filterAgeMonths <= 5 ? 'moderate' : 'saturated';
      }

      recalculate();
    }

    // Attach listeners
    [cooktopSelect, processSelect, hoodSelect, burnerSelect, ceilingSelect, ventSelect, ductProfileSelect, filterAgeSelect, occupantSelect].forEach(el => {
      if (el) el.addEventListener('change', recalculate);
    });

    [cfmSlider, heightSlider, areaSlider, ductLengthInput, ductElbowsInput].forEach(el => {
      if (el) el.addEventListener('input', recalculate);
    });

    document.querySelectorAll('.rh-preset-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        const pId = this.getAttribute('data-preset');
        if (pId) applyPreset(pId);
      });
    });

    // Copy Report handler
    if (copyReportBtn) {
      copyReportBtn.addEventListener('click', function() {
        const cooktop = cooktopMap[cooktopSelect.value]?.name || 'Cooktop';
        const process = processMap[processSelect.value]?.name || 'Cooking';
        const hood = hoodMap[hoodSelect.value]?.name || 'Hood';
        const score = scoreNum?.textContent || '0';
        const effCFM = effectiveCfmVal?.textContent || '0';
        const ach = achVal?.textContent || '0';
        const capture = captureEffVal?.textContent || '0';
        const no2 = no2Val?.textContent || '0';
        const pm25 = pm25Val?.textContent || '0';
        const ped = pediatricVal?.textContent || 'N/A';

        const report = `=====================================================
ISITKITCHENSAFE RANGE HOOD VENTILATION DIAGNOSTIC
=====================================================
Cooktop: ${cooktop}
Process: ${process}
Hood Style: ${hood}
Venting: ${ventSelect.value === 'ducted' ? 'Ducted Exterior' : 'Ductless Recirculating'}
Active Burner: ${burnerSelect.value === 'front' ? 'Front Burner' : 'Back Burner'}

AERODYNAMIC TELEMETRY:
- Extraction Health Score: ${score} / 100
- Effective Delivered Flow: ${effCFM} CFM
- Air Changes per Hour (ACH): ${ach} ACH
- Plume Capture Efficiency: ${capture}
- Peak Room NO2 Surge: ${no2} ppb (WHO Limit: 106 ppb)
- Cooking PM2.5 Density: ${pm25} µg/m³ (WHO 24h: 15 µg/m³)
- Pediatric Asthma Hazard Grade: ${ped}

DIAGNOSTIC ENGINE: IsItKitchenSafe Autonomous Growth Engine v2.0
URL: https://isitkitchensafe.com/tools/range-hood-extraction-efficiency-modeler/
=====================================================`;

        navigator.clipboard.writeText(report).then(() => {
          if (copyBtnText) copyBtnText.textContent = d.reportCopied;
          setTimeout(() => {
            if (copyBtnText) copyBtnText.textContent = d.copyReportBtn;
          }, 3000);
        });
      });
    }

    // Initial calculation
    recalculate();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initRangeHoodModeler);
  } else {
    initRangeHoodModeler();
  }
})();
</script>
