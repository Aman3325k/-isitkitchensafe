    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <div class="p-5 rounded-2xl bg-surface-soft border border-hairline">
        <h4 class="text-sm font-bold text-ink mb-1.5">{d.rule1Title}</h4>
        <p class="text-xs text-body leading-relaxed">{d.rule1Text}</p>
      </div>

      <div class="p-5 rounded-2xl bg-surface-soft border border-hairline">
        <h4 class="text-sm font-bold text-ink mb-1.5">{d.rule2Title}</h4>
        <p class="text-xs text-body leading-relaxed">{d.rule2Text}</p>
      </div>

      <div class="p-5 rounded-2xl bg-surface-soft border border-hairline">
        <h4 class="text-sm font-bold text-ink mb-1.5">{d.rule3Title}</h4>
        <p class="text-xs text-body leading-relaxed">{d.rule3Text}</p>
      </div>

      <div class="p-5 rounded-2xl bg-surface-soft border border-hairline">
        <h4 class="text-sm font-bold text-ink mb-1.5">{d.rule4Title}</h4>
        <p class="text-xs text-body leading-relaxed">{d.rule4Text}</p>
      </div>
    </div>
  </div>

  <!-- Cross-Tool Exploration Bar -->
  <div class="mt-10 pt-6 border-t border-hairline/80 flex flex-wrap items-center justify-between gap-4">
    <span class="text-xs font-bold uppercase tracking-wider text-muted">
      🔗 {d.crossLinkTitle}
    </span>
    <div class="flex flex-wrap gap-2 text-xs">
      <a href="/tools/induction-cooktop-emf-safety-modeler/" class="text-blue-800 hover:text-blue-900 font-semibold bg-blue-50 px-3 py-1.5 rounded-lg border border-blue-200 transition-colors">
        {d.crossLinkInduction} &rarr;
      </a>
      <a href="/tools/culinary-oil-smoke-point-simulator/" class="text-amber-800 hover:text-amber-900 font-semibold bg-amber-50 px-3 py-1.5 rounded-lg border border-amber-200 transition-colors">
        {d.crossLinkOilSmoke} &rarr;
      </a>
      <a href="/tools/kitchen-energy-carbon-calculator/" class="text-emerald-800 hover:text-emerald-900 font-semibold bg-emerald-50 px-3 py-1.5 rounded-lg border border-emerald-200 transition-colors">
        {d.crossLinkCarbon} &rarr;
      </a>
    </div>
