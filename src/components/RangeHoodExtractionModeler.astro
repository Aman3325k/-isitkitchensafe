          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Scientific Engineering Protocols: 5 Golden Rules of Kitchen Exhaust -->
  <div class="mt-12 pt-8 border-t border-hairline">
    <div class="mb-6">
      <h3 class="text-lg md:text-xl font-bold text-ink">{d.protocolsTitle}</h3>
