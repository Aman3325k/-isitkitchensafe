            <span id="svg-blade-mat" class="font-semibold text-ink text-[11px] truncate block">Virgin PEEK</span>
          </div>
          <div class="p-2 rounded bg-surface-soft border border-hairline">
            <span class="block text-[10px] text-body">Exit Temperature</span>
            <span id="svg-exit-temp" class="font-semibold text-ink text-[11px] block">138.2°C</span>
          </div>
        </div>
      </div>

      <div class="mt-4 pt-3 border-t border-hairline flex items-center justify-between text-xs">
        <span class="text-body text-[11px]">3-A Standard 31-07 Compliant</span>
        <button type="button" id="btn-copy-report" class="px-2.5 py-1.5 rounded-lg bg-surface-soft hover:bg-surface-soft/80 border border-hairline font-semibold text-ink text-xs transition-colors">
          📋 {d.copyReportBtn}
        </button>
      </div>
    </div>
  </div>

  <!-- Telemetry Diagnostic Cards -->
  <div class="p-6 md:p-8 rounded-2xl bg-surface border border-hairline shadow-sm space-y-6">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <h2 class="text-lg md:text-xl font-bold text-ink">{d.diagnosticTitle}</h2>
        <p class="text-xs text-body mt-0.5">{d.diagnosticSub}</p>
      </div>
      <div id="status-badge" class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
        OPTIMAL
      </div>
    </div>

    <!-- Status Banner -->
    <div id="status-banner" class="p-4 rounded-xl bg-surface-soft border border-hairline">
      <div class="flex items-start gap-3">
        <span class="text-lg">🛡️</span>
        <div>
          <div id="risk-factor" class="text-sm font-bold text-ink">Normal Operation - Boundary Layer Continuously Cleared</div>
          <p id="risk-mech" class="text-xs text-body mt-1 leading-relaxed">
            Scraping frequency is sufficient to suppress thermal boundary layer growth below critical Biot number limits.
          </p>
          <p id="risk-mitigation" class="text-xs text-primary font-medium mt-1">
            Maintain routine CIP inspections every 250 operating hours.
          </p>
        </div>
      </div>
    </div>

    <!-- Metric Tiles (10 metrics) -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3.5">
      <!-- Scraping Frequency -->
      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <span class="block text-[11px] font-semibold text-body mb-1">{d.scrapeFreqLabel}</span>
        <span id="tele-scrape-freq" class="text-base md:text-lg font-mono font-extrabold text-ink">20.0 Hz</span>
        <span id="tele-freq-state" class="block text-[10px] text-emerald-600 dark:text-emerald-400 mt-1">Optimal Renewal</span>
      </div>

      <!-- Hydrodynamic Lift Force -->
      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <span class="block text-[11px] font-semibold text-body mb-1">{d.hydroLiftLabel}</span>
        <span id="tele-hydro-lift" class="text-base md:text-lg font-mono font-extrabold text-ink">14.8 N/m</span>
        <span id="tele-lift-state" class="block text-[10px] text-emerald-600 dark:text-emerald-400 mt-1">Spring Dominant</span>
      </div>

      <!-- Boundary Film Clearance -->
      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <span class="block text-[11px] font-semibold text-body mb-1">{d.filmGapLabel}</span>
        <span id="tele-film-gap" class="text-base md:text-lg font-mono font-extrabold text-ink">2.4 μm</span>
        <span id="tele-gap-state" class="block text-[10px] text-emerald-600 dark:text-emerald-400 mt-1">Full Wall Contact</span>
      </div>

      <!-- Blade Chattering Vibration -->
      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <span class="block text-[11px] font-semibold text-body mb-1">{d.chatterAccelLabel}</span>
        <span id="tele-chatter" class="text-base md:text-lg font-mono font-extrabold text-ink">1.2 g RMS</span>
        <span id="tele-chatter-state" class="block text-[10px] text-emerald-600 dark:text-emerald-400 mt-1">Smooth Gliding</span>
      </div>

      <!-- Overall Heat Transfer U -->
      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <span class="block text-[11px] font-semibold text-body mb-1">{d.heatCoeffLabel}</span>
        <span id="tele-heat-u" class="text-base md:text-lg font-mono font-extrabold text-ink">1,420 W/m²K</span>
        <span id="tele-u-state" class="block text-[10px] text-emerald-600 dark:text-emerald-400 mt-1">High Thermal Flux</span>
      </div>

      <!-- Product Discharge Exit Temp -->
      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <span class="block text-[11px] font-semibold text-body mb-1">{d.exitTempLabel}</span>
        <span id="tele-exit-temp" class="text-base md:text-lg font-mono font-extrabold text-ink">138.4°C</span>
        <span id="tele-temp-state" class="block text-[10px] text-emerald-600 dark:text-emerald-400 mt-1">Target Reached</span>
      </div>

      <!-- Wall Fouling Resistance Rf -->
      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <span class="block text-[11px] font-semibold text-body mb-1">{d.foulingResistLabel}</span>
        <span id="tele-fouling-rf" class="text-base md:text-lg font-mono font-extrabold text-ink">0.08 m²K/kW</span>
        <span id="tele-fouling-state" class="block text-[10px] text-emerald-600 dark:text-emerald-400 mt-1">Clean Wall</span>
      </div>

      <!-- Boundary Layer Biot Number -->
      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <span class="block text-[11px] font-semibold text-body mb-1">{d.biotNumLabel}</span>
        <span id="tele-biot" class="text-base md:text-lg font-mono font-extrabold text-ink">0.045</span>
        <span id="tele-biot-state" class="block text-[10px] text-emerald-600 dark:text-emerald-400 mt-1">Bi &lt; 0.1 (Uniform)</span>
      </div>

      <!-- Blade Tip Wear -->
      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <span class="block text-[11px] font-semibold text-body mb-1">{d.bladeWearLabel}</span>
        <span id="tele-blade-wear" class="text-base md:text-lg font-mono font-extrabold text-ink">0.45 mm</span>
        <span id="tele-wear-state" class="block text-[10px] text-emerald-600 dark:text-emerald-400 mt-1">Normal Wear</span>
      </div>

      <!-- Remaining Blade Useful Life -->
      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <span class="block text-[11px] font-semibold text-body mb-1">{d.remainingLifeLabel}</span>
        <span id="tele-rul" class="text-base md:text-lg font-mono font-extrabold text-ink">1,850 hrs</span>
        <span id="tele-rul-state" class="block text-[10px] text-emerald-600 dark:text-emerald-400 mt-1">62% Life Remaining</span>
      </div>
    </div>
  </div>

  <!-- Scientific Physics Reference Section -->
  <div class="p-6 md:p-8 rounded-2xl bg-surface border border-hairline shadow-sm space-y-4">
    <div>
      <h2 class="text-lg md:text-xl font-bold text-ink">{d.scienceTitle}</h2>
      <p class="text-xs text-body mt-0.5">{d.scienceSub}</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs leading-relaxed text-body">
      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <h3 class="font-bold text-ink mb-1">Hydrodynamic Lift & Lubrication Wedge Theory</h3>
        <p>
          As the mutator rotates at angular velocity ω, non-Newtonian fluid is sheared between the scraper blade bevel and cylinder wall. The Reynolds hydrodynamic lubrication equation dictates normal lift force: F_lift ∝ (η · ω · W · L) / h². When F_lift exceeds spring pre-load F_spring, blade clearance h expands, leaving an un-scraped stagnant boundary layer prone to instantaneous fouling.
        </p>
      </div>
      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <h3 class="font-bold text-ink mb-1">Protein Burn-On & Biot Number (Bi) Criteria</h3>
        <p>
          Thermal boundary layers are governed by the Biot number: Bi = (h_fluid · δ_film) / k_product. When Bi &gt; 0.1, internal conductive thermal resistance dominates over surface convection, creating sharp thermal spikes at the wall. For whey and egg proteins, wall temperatures &gt;75°C trigger irreversible β-lactoglobulin aggregation, forming an insulating crust that collapses overall heat transfer.
        </p>
      </div>
      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <h3 class="font-bold text-ink mb-1">Acoustic Blade Chattering & Chrome Delamination</h3>
        <p>
          Shaft runout or fluid cavitation destabilizes blade trajectory, inducing high-frequency mechanical vibration (&gt;4.5 g RMS). As blade tips repeatedly impact hard-chrome-plated nickel liners, localized tensile stresses initiate micro-cleavage cracks in the chrome matrix (850 HV), leading to hazardous metal flake delamination into food streams.
        </p>
      </div>
      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <h3 class="font-bold text-ink mb-1">3-A Sanitary Standard 31-07 & Aseptic Steam Barriers</h3>
        <p>
          Continuous aseptic processing requires hermetic microbial isolation under FDA 21 CFR § 113.40. Scraper blade polymer must comply with FDA 21 CFR § 177.2415 (PEEK) without micro-chipping. Mutator drive shafts must feature dual balanced mechanical seals with continuous live steam condensate barriers (1.0 to 1.5 bar) to neutralize bacterial spore ingress.
        </p>
      </div>
    </div>
  </div>

  <!-- Architecture Comparison Table -->
  <div class="p-6 md:p-8 rounded-2xl bg-surface border border-hairline shadow-sm space-y-4">
    <div>
      <h2 class="text-lg md:text-xl font-bold text-ink">{d.tableTitle}</h2>
      <p class="text-xs text-body mt-0.5">{d.tableSub}</p>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs border-collapse">
        <thead>
          <tr class="border-b border-hairline text-body font-semibold">
            <th class="py-2.5 pr-4">{d.colModel}</th>
            <th class="py-2.5 px-3">{d.colClass}</th>
            <th class="py-2.5 px-3">{d.colPressure}</th>
            <th class="py-2.5 px-3">{d.colArea}</th>
            <th class="py-2.5 px-3">{d.colMutator}</th>
            <th class="py-2.5 pl-3">{d.colSeal}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline">
          {ssheData.ssheArchitectures.map((m) => (
            <tr class="hover:bg-surface-soft/50 transition-colors">
              <td class="py-2.5 pr-4 font-semibold text-ink">{m.name.split('(')[0].trim()}</td>
              <td class="py-2.5 px-3 text-body">{m.classification.split('(')[0].trim()}</td>
              <td class="py-2.5 px-3 font-mono text-ink">{m.maxOperatingPressureBar} bar</td>
              <td class="py-2.5 px-3 font-mono text-ink">{m.heatTransferAreaM2} m²</td>
              <td class="py-2.5 px-3 text-body font-mono">{m.mutatorDrivePowerKw} kW ({m.mutatorSpeedRpmRange[0]}-{m.mutatorSpeedRpmRange[1]} RPM)</td>
              <td class="py-2.5 pl-3 text-body">{m.asepticSealType}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Operational Rules Section -->
  <div class="p-6 md:p-8 rounded-2xl bg-surface border border-hairline shadow-sm space-y-4">
    <div>
      <h2 class="text-lg md:text-xl font-bold text-ink">{d.rulesTitle}</h2>
      <p class="text-xs text-body mt-0.5">{d.rulesSub}</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <h3 class="text-sm font-bold text-ink mb-1.5">{d.rule1Title}</h3>
        <p class="text-xs text-body leading-relaxed">{d.rule1Text}</p>
      </div>
      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <h3 class="text-sm font-bold text-ink mb-1.5">{d.rule2Title}</h3>
        <p class="text-xs text-body leading-relaxed">{d.rule2Text}</p>
      </div>
      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <h3 class="text-sm font-bold text-ink mb-1.5">{d.rule3Title}</h3>
        <p class="text-xs text-body leading-relaxed">{d.rule3Text}</p>
      </div>
      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <h3 class="text-sm font-bold text-ink mb-1.5">{d.rule4Title}</h3>
        <p class="text-xs text-body leading-relaxed">{d.rule4Text}</p>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ ssheData }}>
(function() {
  const container = document.querySelector('.sshe-modeler-container');
  if (!container) return;

  const machines = ssheData.ssheArchitectures;
  const fluids = ssheData.fluidProductProfiles;
  const blades = ssheData.bladeMaterials;

  // DOM Elements
  const selMachine = document.getElementById('select-machine');
  const selFluid = document.getElementById('select-fluid');
  const selBlade = document.getElementById('select-blade');

  const sRpm = document.getElementById('slider-rpm');
  const sFlow = document.getElementById('slider-flow');
  const sJacket = document.getElementById('slider-jacket');
  const sInlet = document.getElementById('slider-inlet');
  const sSpring = document.getElementById('slider-spring');
  const sHours = document.getElementById('slider-hours');
  const sEccentricity = document.getElementById('slider-eccentricity');

  const valRpm = document.getElementById('val-rpm');
  const valFlow = document.getElementById('val-flow');
  const valJacket = document.getElementById('val-jacket');
  const valInlet = document.getElementById('val-inlet');
  const valSpring = document.getElementById('val-spring');
  const valHours = document.getElementById('val-hours');
  const valEccentricity = document.getElementById('val-eccentricity');

  // Telemetry outputs
  const teleScrapeFreq = document.getElementById('tele-scrape-freq');
  const teleFreqState = document.getElementById('tele-freq-state');
  const teleHydroLift = document.getElementById('tele-hydro-lift');
  const teleLiftState = document.getElementById('tele-lift-state');
  const teleFilmGap = document.getElementById('tele-film-gap');
  const teleGapState = document.getElementById('tele-gap-state');
  const teleChatter = document.getElementById('tele-chatter');
  const teleChatterState = document.getElementById('tele-chatter-state');
  const teleHeatU = document.getElementById('tele-heat-u');
  const teleUState = document.getElementById('tele-u-state');
  const teleExitTemp = document.getElementById('tele-exit-temp');
  const teleTempState = document.getElementById('tele-temp-state');
  const teleFoulingRf = document.getElementById('tele-fouling-rf');
  const teleFoulingState = document.getElementById('tele-fouling-state');
  const teleBiot = document.getElementById('tele-biot');
  const teleBiotState = document.getElementById('tele-biot-state');
  const teleBladeWear = document.getElementById('tele-blade-wear');
  const teleWearState = document.getElementById('tele-wear-state');
  const teleRul = document.getElementById('tele-rul');
  const teleRulState = document.getElementById('tele-rul-state');

  const statusBanner = document.getElementById('status-banner');
  const statusBadge = document.getElementById('status-badge');
  const riskFactor = document.getElementById('risk-factor');
  const riskMech = document.getElementById('risk-mech');
  const riskMitigation = document.getElementById('risk-mitigation');

  // SVG Diagram elements
  const svgBladeMat = document.getElementById('svg-blade-mat');
  const svgExitTemp = document.getElementById('svg-exit-temp');
  const svgRpmText = document.getElementById('svg-rpm-text');
  const diagramBadge = document.getElementById('diagram-badge');
  const svgFoulingRing = document.getElementById('svg-fouling-ring');

  // Presets
  const btnInfant = document.getElementById('btn-preset-infant');
  const btnTomato = document.getElementById('btn-preset-tomato');
  const btnCrystallizer = document.getElementById('btn-preset-crystallizer');
  const btnChatter = document.getElementById('btn-preset-chatter');
  const btnCopy = document.getElementById('btn-copy-report');

  function calculateSimulation() {
    const machine = machines.find(m => m.id === selMachine.value) || machines[0];
    const fluid = fluids.find(f => f.id === selFluid.value) || fluids[0];
    const blade = blades.find(b => b.id === selBlade.value) || blades[0];

    const rpm = parseFloat(sRpm.value);
    const flowLh = parseFloat(sFlow.value);
    const jacketTemp = parseFloat(sJacket.value);
    const inletTemp = parseFloat(sInlet.value);
    const springForce = parseFloat(sSpring.value); // N/m
    const hours = parseFloat(sHours.value);
    const eccentricity = parseFloat(sEccentricity.value); // mm

    // Update Slider Labels
    valRpm.textContent = `${rpm} RPM`;
    valFlow.textContent = `${flowLh.toLocaleString()} L/h`;
    valJacket.textContent = `${jacketTemp}°C`;
    valInlet.textContent = `${inletTemp}°C`;
    valSpring.textContent = `${springForce} N/m`;
    valHours.textContent = `${hours.toLocaleString()} hrs`;
    valEccentricity.textContent = `${eccentricity.toFixed(2)} mm`;

    // 1. Scraping Frequency (f = N_blades * RPM / 60)
    const scrapeFreq = (machine.bladeCount * rpm) / 60.0; // Hz

    // 2. Apparent Viscosity at Scraper Shear Rate
    // Shear rate γ̇ = π * D * (RPM/60) / gap
    const D_m = machine.cylinderDiameterMm / 1000.0;
    const tipSpeedMs = Math.PI * D_m * (rpm / 60.0);
    const nominalAnnulusM = 0.015; // 15 mm nominal gap
    const shearRate = Math.max(10.0, tipSpeedMs / nominalAnnulusM);
    // Herschel-Bulkley / Ostwald-de Waele: η_app = K * γ̇^(n - 1)
    const apparentViscosityPaS = (fluid.consistencyIndexK * Math.pow(shearRate, fluid.flowBehaviorIndexN - 1)) * 0.1;

    // 3. Hydrodynamic Lift Force per blade length (N/m)
    // F_lift = 6 * η * tipSpeed / tan(bevel_angle)
    const hydroLiftForce = Math.max(1.0, 4.5 * apparentViscosityPaS * tipSpeedMs * 12.0);

    // 4. Boundary Film Gap (μm)
    // h_film = sqrt(η * v / F_net)
    const netForce = Math.max(0.5, springForce - hydroLiftForce * 0.4);
    let filmGapMicrons = 1.2 + (hydroLiftForce / (springForce + 5.0)) * 6.5;
    if (springForce < hydroLiftForce * 0.7) {
      filmGapMicrons += (hydroLiftForce * 0.7 - springForce) * 0.8;
    }

    // 5. Blade Chattering Vibration (g RMS)
    // Chatter accel scales with eccentricity, RPM, and blade stiffness
    const chatterBase = (eccentricity / 0.2) * Math.pow(rpm / 200.0, 1.3);
    const chatterAccel = Math.min(12.0, Math.max(0.3, chatterBase * (blade.flexuralModulusGpa / 3.0)));

    // 6. Wall Fouling Thermal Resistance (Rf) & Biot Number
    // Protein burn-on accelerates when wall temperature > denaturation temp
    const wallTempEst = (jacketTemp * 0.65) + (inletTemp * 0.35);
    let foulingGrowthRate = 0.001;
    if (wallTempEst > fluid.proteinDenaturationTempC) {
      const overTemp = wallTempEst - fluid.proteinDenaturationTempC;
      foulingGrowthRate = 0.005 + 0.003 * Math.pow(overTemp, 1.35) * Math.exp(-scrapeFreq / 18.0);
    }
    const foulingResistance = Math.min(0.85, (foulingGrowthRate * Math.sqrt(hours + 10) * 0.15) + (filmGapMicrons > 10 ? 0.12 : 0.0));
    
    // Biot Number = (h_wall * delta_film) / k_fluid
    const h_wall = 1600 / (1 + foulingResistance * 1600);
    const biotNumber = (h_wall * (filmGapMicrons * 1e-6)) / fluid.thermalConductivityWmK;

    // 7. Overall Heat Transfer Coefficient U (W/m²K)
    // 1/U = 1/h_jacket + L_cyl/k_cyl + Rf + 1/h_product
    const h_jacket = 3500; // steam or brine
    const h_product_clean = 850 + Math.sqrt(scrapeFreq) * 220 + tipSpeedMs * 180;
    const invU = (1 / h_jacket) + (0.008 / machine.cylinderThermalConductivityWmK) + (foulingResistance * 0.001) + (1 / h_product_clean);
    const overallU = Math.min(2200, Math.max(120, Math.round(1 / invU)));

    // 8. Product Discharge Exit Temperature (°C)
    // Q = m_dot * Cp * ΔT = U * A * LMTD
    const massFlowKgS = (flowLh * fluid.densityKgM3) / 3600.0;
    const heatCapacityFlow = massFlowKgS * fluid.specificHeatJouleKgK;
    const NTU = (overallU * machine.heatTransferAreaM2) / Math.max(10, heatCapacityFlow);
    const effectiveness = 1 - Math.exp(-NTU);
    const exitTemp = inletTemp + effectiveness * (jacketTemp - inletTemp);

    // 9. Cumulative Blade Tip Wear (mm) & RUL (hrs)
    // Archard wear: wear = coeff * load * sliding_distance
    const slidingDistanceM = tipSpeedMs * hours * 3600.0;
    const bladeWearMm = Math.min(4.5, (blade.wearRateCoeffMm3Nm * springForce * slidingDistanceM * 0.000000008) + (chatterAccel > 3.0 ? 0.35 : 0.0));
    const maxWearToleranceMm = 3.0; // 3.0 mm replacement limit
    const wearFraction = Math.min(1.5, bladeWearMm / maxWearToleranceMm);
    const remainingHours = Math.max(0, Math.round(2500 * (1 - wearFraction) / Math.max(0.5, chatterAccel / 1.5)));

    // Update Telemetry Displays
    teleScrapeFreq.textContent = `${scrapeFreq.toFixed(1)} Hz`;
    if (scrapeFreq >= 15.0) {
      teleFreqState.textContent = 'Optimal Boundary Renewal';
      teleFreqState.className = 'block text-[10px] text-emerald-600 dark:text-emerald-400 mt-1';
    } else if (scrapeFreq >= 8.0) {
      teleFreqState.textContent = 'Moderate Scraping Rate';
      teleFreqState.className = 'block text-[10px] text-amber-500 font-medium mt-1';
    } else {
      teleFreqState.textContent = 'Low Frequency - Severe Fouling Risk';
      teleFreqState.className = 'block text-[10px] text-rose-500 font-bold mt-1';
    }

    teleHydroLift.textContent = `${hydroLiftForce.toFixed(1)} N/m`;
    if (springForce > hydroLiftForce * 1.2) {
      teleLiftState.textContent = 'Spring Dominant (Firm Contact)';
      teleLiftState.className = 'block text-[10px] text-emerald-600 dark:text-emerald-400 mt-1';
    } else {
      teleLiftState.textContent = 'Hydrodynamic Lift Overcoming Spring!';
      teleLiftState.className = 'block text-[10px] text-amber-500 font-medium mt-1';
    }

    teleFilmGap.textContent = `${filmGapMicrons.toFixed(1)} μm`;
    if (filmGapMicrons < 5.0) {
      teleGapState.textContent = 'Full Wall Scraping (h < 5 μm)';
      teleGapState.className = 'block text-[10px] text-emerald-600 dark:text-emerald-400 mt-1';
    } else if (filmGapMicrons < 15.0) {
      teleGapState.textContent = 'Partial Boundary Layer Slip';
      teleGapState.className = 'block text-[10px] text-amber-500 font-medium mt-1';
    } else {
      teleGapState.textContent = 'Blade Lift-Off (Stagnant Layer)';
      teleGapState.className = 'block text-[10px] text-rose-500 font-bold mt-1';
    }

    teleChatter.textContent = `${chatterAccel.toFixed(1)} g RMS`;
    if (chatterAccel > 4.5) {
      teleChatterState.textContent = 'Violent Chattering - Chrome Gouging!';
      teleChatterState.className = 'block text-[10px] text-rose-500 font-bold mt-1';
    } else if (chatterAccel > 2.2) {
      teleChatterState.textContent = 'Moderate Resonant Oscillation';
      teleChatterState.className = 'block text-[10px] text-amber-500 font-medium mt-1';
    } else {
      teleChatterState.textContent = 'Smooth Gliding Dynamics';
      teleChatterState.className = 'block text-[10px] text-emerald-600 dark:text-emerald-400 mt-1';
    }

    teleHeatU.textContent = `${overallU.toLocaleString()} W/m²K`;
    if (overallU > 1000) {
      teleUState.textContent = 'High Thermal Convection';
      teleUState.className = 'block text-[10px] text-emerald-600 dark:text-emerald-400 mt-1';
    } else {
      teleUState.textContent = 'Degraded Thermal Flux';
      teleUState.className = 'block text-[10px] text-amber-500 font-medium mt-1';
    }

    teleExitTemp.textContent = `${exitTemp.toFixed(1)}°C`;
    teleTempState.textContent = jacketTemp > inletTemp ? 'Heating Cycle' : 'Cooling / Freezing';

    teleFoulingRf.textContent = `${(foulingResistance * 1000).toFixed(1)} m²K/kW`;
    if (foulingResistance > 0.35) {
      teleFoulingState.textContent = 'Severe Crust - CIP Required!';
      teleFoulingState.className = 'block text-[10px] text-rose-500 font-bold mt-1';
    } else {
      teleFoulingState.textContent = 'Clean / Minimal Fouling';
      teleFoulingState.className = 'block text-[10px] text-emerald-600 dark:text-emerald-400 mt-1';
    }

    teleBiot.textContent = biotNumber.toFixed(3);
    if (biotNumber > 0.1) {
      teleBiotState.textContent = 'Bi > 0.1 (Severe Thermal Gradients)';
      teleBiotState.className = 'block text-[10px] text-rose-500 font-bold mt-1';
    } else {
      teleBiotState.textContent = 'Bi < 0.1 (Uniform Thermal Profile)';
      teleBiotState.className = 'block text-[10px] text-emerald-600 dark:text-emerald-400 mt-1';
    }

    teleBladeWear.textContent = `${bladeWearMm.toFixed(2)} mm`;
    if (bladeWearMm >= maxWearToleranceMm) {
      teleWearState.textContent = 'Exceeds Wear Tolerance (>3 mm) - Replace!';
      teleWearState.className = 'block text-[10px] text-rose-500 font-bold mt-1';
    } else {
      teleWearState.textContent = 'Normal Blade Geometry';
      teleWearState.className = 'block text-[10px] text-emerald-600 dark:text-emerald-400 mt-1';
    }

    teleRul.textContent = `${remainingHours.toLocaleString()} hrs`;
    teleRulState.textContent = `${Math.round((1 - wearFraction) * 100)}% Life Remaining`;

    // Update SVG Elements
    svgBladeMat.textContent = blade.name.split('(')[0].trim();
    svgExitTemp.textContent = `${exitTemp.toFixed(1)}°C`;
    svgRpmText.textContent = `${rpm} RPM`;
    diagramBadge.textContent = `Scraping: ${scrapeFreq.toFixed(1)} Hz`;
    if (svgFoulingRing) {
      svgFoulingRing.setAttribute('opacity', (foulingResistance * 1.5).toFixed(2));
    }

    // Multi-factor Safety Evaluation
    let isSevere = false;
    let isWarning = false;
    let riskTitle = '';
    let riskDetail = '';
    let mitigation = '';

    if (chatterAccel > 4.5) {
      isSevere = true;
      riskTitle = 'Violent Resonant Blade Chattering & Chrome Flake Spalling';
      riskDetail = `High shaft eccentricity (${eccentricity.toFixed(2)} mm) coupled with high mutator speed (${rpm} RPM) produces ${chatterAccel.toFixed(1)} g RMS vibration. Cyclic blade hammering gouges hard chrome plating (850 HV), triggering hazardous metal flaking into food.`;
      mitigation = 'Immediately shut down line. Re-align mutator shaft bearings to restore radial runout <0.15 mm and inspect chrome cylinder liner with borescope for micro-spalling.';
    } else if (biotNumber > 0.1 || foulingResistance > 0.35) {
      isSevere = true;
      riskTitle = 'Critical Protein Burn-On Fouling & Heat Transfer Collapse';
      riskDetail = `Wall temperature exceeds protein denaturation threshold (${fluid.proteinDenaturationTempC}°C). High Biot number (Bi: ${biotNumber.toFixed(3)}) indicates thick stagnant boundary layer (h: ${filmGapMicrons.toFixed(1)} μm), resulting in burnt product crusting and lost sterility.`;
      mitigation = 'Trigger emergency CIP caustic wash (2.0% NaOH at 80°C). Increase blade spring pre-load to >35 N/m and elevate mutator RPM to maintain scraping frequency >20 Hz.';
    } else if (bladeWearMm >= maxWearToleranceMm) {
      isSevere = true;
      riskTitle = 'Scraper Blade End-of-Life Wear & Micro-Plastic Shaving Hazard';
      riskDetail = `Blade tip wear (${bladeWearMm.toFixed(2)} mm) has exceeded the 3.0 mm replacement limit. Fatigued polymer edges risk brittle mechanical fracture and micro-particle contamination.`;
      mitigation = 'Replace complete set of scraper blades with virgin PEEK or food-grade polyketone blades. Verify pivot pins and tension springs.';
    } else if (filmGapMicrons > 10.0) {
      isWarning = true;
      riskTitle = 'Hydrodynamic Lift-Off & Stagnant Boundary Layer Slip';
      riskDetail = `Viscous product shear generates ${hydroLiftForce.toFixed(1)} N/m hydrodynamic lift, exceeding spring force (${springForce} N/m). Blade clearance is ${filmGapMicrons.toFixed(1)} μm, lowering heat transfer coefficient (U: ${overallU} W/m²K).`;
      mitigation = 'Increase spring pre-load force or reduce mutator speed slightly to allow centrifugal pins and springs to maintain positive wall contact.';
    } else {
      riskTitle = 'Normal Operation - 3-A Sanitary Standard 31-07 Compliant';
      riskDetail = `Scraping frequency (${scrapeFreq.toFixed(1)} Hz) and blade wall contact (gap ${filmGapMicrons.toFixed(1)} μm) maintain clean boundary renewal with uniform Biot number (Bi: ${biotNumber.toFixed(3)}) and safe vibration levels.`;
      mitigation = 'Continue standard aseptic processing. Perform visual blade inspection and sterile steam seal barrier pressure verification at scheduled 500-hour intervals.';
    }

    if (isSevere) {
      statusBanner.className = 'p-4 rounded-xl border border-rose-500/40 bg-rose-50 dark:bg-rose-950/40';
      statusBadge.className = 'px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-rose-600 text-white';
      statusBadge.textContent = 'CRITICAL ALARM';
    } else if (isWarning) {
      statusBanner.className = 'p-4 rounded-xl border border-amber-500/40 bg-amber-50 dark:bg-amber-950/40';
      statusBadge.className = 'px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-600 text-white';
      statusBadge.textContent = 'OPERATIONAL WARNING';
    } else {
      statusBanner.className = 'p-4 rounded-xl border border-emerald-500/30 bg-emerald-50 dark:bg-emerald-950/30';
      statusBadge.className = 'px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-600 text-white';
      statusBadge.textContent = 'OPTIMAL (3-A COMPLIANT)';
    }

    riskFactor.textContent = riskTitle;
    riskMech.textContent = riskDetail;
    riskMitigation.textContent = mitigation;
  }

  // Presets Handlers
  if (btnInfant) {
    btnInfant.addEventListener('click', () => {
      selMachine.value = 'concentric_triple_tube_aseptic_sshe';
      selFluid.value = 'infant_formula_whey_dairy_puree';
      selBlade.value = 'virgin_peek_polymer';
      sRpm.value = '300';
      sFlow.value = '2500';
      sJacket.value = '145';
      sInlet.value = '65';
      sSpring.value = '30';
      sHours.value = '350';
      sEccentricity.value = '0.12';
      calculateSimulation();
    });
  }

  if (btnTomato) {
    btnTomato.addEventListener('click', () => {
      selMachine.value = 'vertical_conical_dual_cylinder_sshe';
      selFluid.value = 'viscous_tomato_paste_puree';
      selBlade.value = 'food_grade_polyketone';
      sRpm.value = '200';
      sFlow.value = '1800';
      sJacket.value = '115';
      sInlet.value = '55';
      sSpring.value = '40';
      sHours.value = '600';
      sEccentricity.value = '0.18';
      calculateSimulation();
    });
  }

  if (btnCrystallizer) {
    btnCrystallizer.addEventListener('click', () => {
      selMachine.value = 'compact_pilot_cryogenic_crystallizer_sshe';
      selFluid.value = 'chocolate_confectionery_fat_blend';
      selBlade.value = 'carbon_impregnated_ptfe';
      sRpm.value = '450';
      sFlow.value = '800';
      sJacket.value = '-15';
      sInlet.value = '45';
      sSpring.value = '20';
      sHours.value = '150';
      sEccentricity.value = '0.10';
      calculateSimulation();
    });
  }

  if (btnChatter) {
    btnChatter.addEventListener('click', () => {
      selMachine.value = 'aging_misaligned_sshe_severe_chatter';
      selFluid.value = 'starch_thickened_cheese_sauce';
      selBlade.value = 'martensitic_stainless_17_4ph';
      sRpm.value = '380';
      sFlow.value = '3200';
      sJacket.value = '130';
      sInlet.value = '70';
      sSpring.value = '15';
      sHours.value = '2100';
      sEccentricity.value = '1.20';
      calculateSimulation();
    });
  }

  // Copy Telemetry
  if (btnCopy) {
    btnCopy.addEventListener('click', () => {
      const reportText = `[ISITKITCHENSAFE SSHE MODELER TELEMETRY]
Timestamp: ${new Date().toISOString()}
Machine: ${selMachine.options[selMachine.selectedIndex].text}
Product: ${selFluid.options[selFluid.selectedIndex].text}
Blade: ${selBlade.options[selBlade.selectedIndex].text}
Operating Parameters: ${sRpm.value} RPM | Flow: ${sFlow.value} L/h | Jacket: ${sJacket.value}°C | Inlet: ${sInlet.value}°C | Spring: ${sSpring.value} N/m | Eccentricity: ${sEccentricity.value} mm
Telemetry:
- Scraping Frequency: ${teleScrapeFreq.textContent}
- Hydrodynamic Lift Force: ${teleHydroLift.textContent}
- Boundary Film Gap: ${teleFilmGap.textContent}
- Blade Chattering: ${teleChatter.textContent}
- Overall Heat Transfer U: ${teleHeatU.textContent}
- Exit Temperature: ${teleExitTemp.textContent}
- Wall Fouling Resistance: ${teleFoulingRf.textContent}
- Biot Number: ${teleBiot.textContent}
- Blade Wear: ${teleBladeWear.textContent} (RUL: ${teleRul.textContent})
Safety Status: ${statusBadge.textContent}
Risk Summary: ${riskFactor.textContent}
Directive: ${riskMitigation.textContent}`;

      navigator.clipboard.writeText(reportText).then(() => {
        const orig = btnCopy.textContent;
        btnCopy.textContent = '✅ Copied!';
        setTimeout(() => { btnCopy.textContent = orig; }, 2000);
      }).catch(() => {});
    });
  }

  // Event Listeners for Live Reactive Changes
  [selMachine, selFluid, selBlade].forEach(el => el.addEventListener('change', calculateSimulation));
  [sRpm, sFlow, sJacket, sInlet, sSpring, sHours, sEccentricity].forEach(el => el.addEventListener('input', calculateSimulation));

  // Initial Calculation
  calculateSimulation();
})();
</script>
