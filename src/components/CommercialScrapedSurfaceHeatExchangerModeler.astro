          <p class="text-[11px] text-body mt-0.5">{d.hoursHelp}</p>
        </div>

        <!-- Shaft Eccentricity -->
        <div class="sm:col-span-2">
          <div class="flex justify-between items-center text-xs mb-1">
            <label for="slider-eccentricity" class="font-semibold text-ink">{d.eccentricityLabel}</label>
            <span id="val-eccentricity" class="font-mono font-bold text-primary">0.15 mm</span>
          </div>
          <input type="range" id="slider-eccentricity" min="0.05" max="1.50" step="0.05" value="0.15" class="w-full accent-primary" />
          <p class="text-[11px] text-body mt-0.5">{d.eccentricityHelp}</p>
        </div>
      </div>
    </div>

    <!-- Schematic & Real-Time Animation Preview (5 Cols) -->
    <div class="lg:col-span-5 p-6 rounded-2xl bg-surface border border-hairline shadow-sm flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between mb-3">
          <span class="text-xs font-bold text-ink uppercase tracking-wider">🔬 Cross-Section Schematic</span>
          <span id="diagram-badge" class="px-2 py-0.5 rounded text-[11px] font-mono font-semibold bg-primary/10 text-primary border border-primary/20">
            Scraping: 20.0 Hz
          </span>
        </div>

        <!-- SVG SSHE Schematic -->
        <div class="relative w-full aspect-square max-h-[300px] flex items-center justify-center p-2 rounded-xl bg-canvas border border-hairline overflow-hidden">
          <svg viewBox="0 0 320 320" class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="jacketGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#ef4444" stop-opacity="0.3" />
                <stop offset="100%" stop-color="#f97316" stop-opacity="0.15" />
              </linearGradient>
              <linearGradient id="cylinderGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#94a3b8" stop-opacity="0.5" />
                <stop offset="100%" stop-color="#64748b" stop-opacity="0.3" />
              </linearGradient>
            </defs>

            <!-- Outer Utility Jacket -->
            <circle cx="160" cy="160" r="148" fill="url(#jacketGradient)" stroke="#f97316" stroke-width="2.5" stroke-dasharray="6,4" />
            <text x="160" y="24" text-anchor="middle" font-size="9" font-family="monospace" fill="#f97316" font-weight="bold">JACKET UTILITY MEDIUM</text>

            <!-- Chrome Cylinder Wall -->
            <circle cx="160" cy="160" r="126" fill="url(#cylinderGradient)" stroke="#38bdf8" stroke-width="3" />
            <circle cx="160" cy="160" r="118" fill="none" stroke="#e2e8f0" stroke-width="1.5" />

            <!-- Rotating Mutator Rotor Shaft -->
            <circle cx="160" cy="160" r="48" fill="#1e293b" stroke="#0ea5e9" stroke-width="2.5" />
            <text x="160" y="156" text-anchor="middle" font-size="10" font-family="sans-serif" font-weight="bold" fill="#f8fafc">MUTATOR</text>
            <text id="svg-rpm-text" x="160" y="170" text-anchor="middle" font-size="9" font-family="monospace" fill="#38bdf8">300 RPM</text>

            <!-- Scraper Blades (4 Blades at 90 deg) -->
            <!-- Blade 1 Top -->
            <rect x="156" y="44" width="8" height="68" rx="2" fill="#eab308" stroke="#ca8a04" stroke-width="1.5" />
            <!-- Blade 2 Bottom -->
            <rect x="156" y="208" width="8" height="68" rx="2" fill="#eab308" stroke="#ca8a04" stroke-width="1.5" />
            <!-- Blade 3 Right -->
            <rect x="208" y="156" width="68" height="8" rx="2" fill="#eab308" stroke="#ca8a04" stroke-width="1.5" />
            <!-- Blade 4 Left -->
            <rect x="44" y="156" width="68" height="8" rx="2" fill="#eab308" stroke="#ca8a04" stroke-width="1.5" />

            <!-- Boundary Fouling Crust Indicator Ring -->
            <circle id="svg-fouling-ring" cx="160" cy="160" r="117" fill="none" stroke="#ef4444" stroke-width="2.5" stroke-dasharray="3,3" opacity="0.4" />

            <!-- Central Shaft Centerpoint -->
            <circle cx="160" cy="160" r="5" fill="#38bdf8" />
          </svg>
        </div>

        <div class="mt-4 grid grid-cols-2 gap-2 text-center text-xs">
          <div class="p-2 rounded bg-surface-soft border border-hairline">
