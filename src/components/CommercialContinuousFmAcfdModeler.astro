    freqLabel: "マイクロ波共振運転周波数モード：",
    freqHelp: "固体素子周波数選択：2.45 GHz（高い浸透深さ）vs 5.8 GHz（高表面吸収）vs ハイブリッド動的モード。",
    tempLabel: "常圧深冷乾燥流動窒素温度 (°C)：",
    tempHelp: "深冷乾燥窒素温度（-45.0 〜 -10.0 °C, 露点 < -60°C）。氷の共晶温度以下を維持しながら水蒸気を即座に除去。",
    velocityLabel: "流動層多孔板表観ガス流速 (m/s)：",
    velocityHelp: "流動窒素表観流速（0.6 – 3.5 m/s）。Reynolds数およびSherwood物質移動係数と粒子浮遊状態を決定します。",
    diameterLabel: "凍結マイクロペレット平均球径 (mm)：",
    diameterHelp: "凍結均一微小液滴の直径（1.0 – 6.0 mm）。小粒径化により内部水蒸気拡散抵抗を低減。",
    presetsTitle: "検証済み商業プリセット：",
    presetProbiotic: "L. rhamnosus GG 凍結微球（32.5分, 生菌残存96.8%）",
    presetLactase: "熱感受性真菌ラクターゼ（28.0分, 活性残存98.6%）",
    presetHmo: "乳児用HMO＆ビフィズス菌（34.0分, a_w 0.17）",
    presetIgg: "ウシ初乳活性IgG濃縮物（26.5分, 98.0% IgG残存）",
    presetRoyalJelly: "新鮮ローヤルゼリー 10-HDA（38.0分, 96.2% 残存）",
    presetHazard: "空洞内プラズマ放電＆局所融解障害（>650 W）",
    telemetryTitle: "誘電昇華速度論＆常圧凍結乾燥リアルタイムテレメトリ",
    telemetrySub: "氷昇華質量フラックス、一次乾燥完了時間、水分活性 a_w、氷核内部温度、共振空洞Q値、およびプロバイオティクス生存率の計算値。",
    sublimationFluxLabel: "氷結晶昇華質量フラックス J_sub (kg/m²·h)：",
    dryingTimeLabel: "水分活性 a_w < 0.20 到達乾燥時間（分）：",
    waterActivityLabel: "製品最終水分活性 (a_w)：",
    coreTempLabel: "微球内部氷核昇華温度 (°C)：",
    qFactorLabel: "共振空洞誘電摂動 Q 値（クオリティファクタ）：",
    probioticLabel: "プロバイオティクス生菌回収残存率 (%)：",
    enzymeLabel: "熱感受性酵素触媒活性保持率 (%)：",
    secLabel: "氷昇華単位エネルギー消費量（SEC, kWh/kg 氷）：",
    verdictLabel: "常圧マイクロ波凍結乾燥品質判定：",
    diagramTitle: "連続式集束マイクロ波常圧凍結乾燥スキッド系統図",
    diagramSub: "凍結ペレット振動ホッパー、固体素子GaNマイクロ波共振空洞、密閉循環深冷乾燥窒素流動塔、オンライン誘電率摂動センサー、およびサイクロン捕集器。",
    chartTitle: "常圧凍結乾燥脱水速度論＆生物活性保持プロファイル",
    chartSub: "FM-ACFD、従来の真空棚段凍結乾燥機、スプレードライヤー、および真空マイクロ波乾燥の乾燥時間と生菌生存率の直接比較。",
    principlesTitle: "氷相誘電分極機序、内部体積加熱＆常圧クヌーセン昇華動力学",
    principlesSub: "基礎物理方程式：氷と液体の複素誘電率差 (ε''_ice << ε''_water)、GaN電界分布、Maxwell-Wagner界面緩和、および非真空対流脱着。",
    compTitle: "産業用生物・食品凍結乾燥技術の横断的比較ベンチマーク",
    compSub: "一次乾燥時間、生菌残存率、運転圧力、および氷昇華単位電力量の直接比較。",
    regTitle: "衛生工学基準、FDA規制適合性およびFCC ISM高周波安全規格",
    regSub: "FDA 21 CFR § 117 FSMA cGMP、3-A 衛生規格 01-09 & 33-03、EHEDG Type EL Class I CIP適合、およびFCC Title 47 Part 18電磁環境適合規格適合。"
  }
};

const d = DICT[lang] || DICT.en;
const formulations = fmAcfdData.formulations;
---

<div class="fm-acfd-modeler-container my-8" data-lang={lang}>
  <!-- Header Card -->
  <header class="bg-gradient-to-br from-indigo-950/80 via-slate-900 to-cyan-950/80 border border-indigo-800/60 rounded-3xl p-6 sm:p-10 shadow-xl backdrop-blur-md mb-8">
    <div class="flex flex-wrap items-center gap-3 mb-4">
      <span class="px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-indigo-500/20 text-indigo-300 border border-indigo-500/40 shadow-xs">
        {d.badge}
      </span>
      <span class="text-xs text-muted font-mono tracking-tight">
        FDA 21 CFR § 117 • 3-A Sanitary 01-09 • Non-Vacuum 1.013 bar • Sub-45 min • SEC &lt; 1.5 kWh/kg
      </span>
    </div>
    <h1 class="text-2xl sm:text-4xl font-extrabold text-ink tracking-tight mb-4">
      {d.title}
    </h1>
    <p class="text-sm sm:text-base text-muted max-w-4xl leading-relaxed">
      {d.subtitle}
    </p>
  </header>

  <!-- Main Grid: Controls + Telemetry -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mb-12">
    <!-- Left Column: Controls (7 cols) -->
    <section class="lg:col-span-7 bg-surface border border-hairline rounded-3xl p-6 sm:p-8 shadow-sm">
      <div class="border-b border-hairline/80 pb-4 mb-6">
        <h2 class="text-xl font-bold text-ink tracking-tight flex items-center gap-2">
          <span class="text-indigo-400">⚡</span>
          {d.controlsTitle}
        </h2>
        <p class="text-xs sm:text-sm text-muted mt-1 leading-relaxed">
          {d.controlsSub}
        </p>
      </div>

      <!-- Presets Selector -->
      <div class="mb-6 p-4 rounded-2xl bg-surface-soft border border-hairline">
        <label class="block text-xs font-bold uppercase tracking-wider text-muted mb-2">
          {d.presetsTitle}
        </label>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
          <button type="button" class="fm-acfd-preset-btn text-xs py-2 px-2.5 rounded-xl border border-hairline bg-surface hover:border-indigo-500/60 text-ink font-medium transition-all text-left truncate" data-preset="probiotic_micro_pellets">
            {d.presetProbiotic}
          </button>
          <button type="button" class="fm-acfd-preset-btn text-xs py-2 px-2.5 rounded-xl border border-hairline bg-surface hover:border-indigo-500/60 text-ink font-medium transition-all text-left truncate" data-preset="dairy_lactase_enzyme">
            {d.presetLactase}
          </button>
          <button type="button" class="fm-acfd-preset-btn text-xs py-2 px-2.5 rounded-xl border border-hairline bg-surface hover:border-indigo-500/60 text-ink font-medium transition-all text-left truncate" data-preset="human_milk_oligosaccharide">
            {d.presetHmo}
          </button>
          <button type="button" class="fm-acfd-preset-btn text-xs py-2 px-2.5 rounded-xl border border-hairline bg-surface hover:border-indigo-500/60 text-ink font-medium transition-all text-left truncate" data-preset="bovine_colostrum_igg">
            {d.presetIgg}
          </button>
          <button type="button" class="fm-acfd-preset-btn text-xs py-2 px-2.5 rounded-xl border border-hairline bg-surface hover:border-indigo-500/60 text-ink font-medium transition-all text-left truncate" data-preset="royal_jelly_apalbumin">
            {d.presetRoyalJelly}
          </button>
          <button type="button" class="fm-acfd-preset-btn text-xs py-2 px-2.5 rounded-xl border border-rose-900/60 bg-rose-950/20 hover:border-rose-600 text-rose-300 font-medium transition-all text-left truncate" data-preset="cavity_plasma_arcing_hazard">
            {d.presetHazard}
          </button>
        </div>
      </div>

      <!-- Controls Form -->
      <form class="space-y-5" id="fm-acfd-controls-form" onsubmit="return false;">
        <!-- 1. Formulation Selection -->
        <div>
          <label for="fm-acfd-formulation-select" class="block text-xs font-semibold text-ink mb-1">
            {d.formulationLabel}
          </label>
          <select id="fm-acfd-formulation-select" class="w-full text-xs sm:text-sm bg-surface-soft border border-hairline rounded-xl px-3 py-2.5 text-ink focus:outline-none focus:border-indigo-500 transition-colors">
            {formulations.map(f => (
              <option value={f.id}>{f.name}</option>
            ))}
          </select>
          <p class="text-[11px] text-muted mt-1">{d.formulationHelp}</p>
        </div>

        <!-- 2. Microwave Power Slider -->
        <div>
          <div class="flex items-center justify-between text-xs font-semibold text-ink mb-1">
            <span>{d.powerLabel}</span>
            <span class="font-mono text-indigo-400 font-bold" id="fm-acfd-power-val">380 W</span>
          </div>
          <input type="range" id="fm-acfd-power-slider" min="100" max="700" step="10" value="380" class="w-full accent-indigo-500 cursor-pointer" />
          <p class="text-[11px] text-muted mt-1">{d.powerHelp}</p>
        </div>

        <!-- 3. Microwave Frequency Selector -->
        <div>
          <label for="fm-acfd-freq-select" class="block text-xs font-semibold text-ink mb-1">
            {d.freqLabel}
          </label>
          <select id="fm-acfd-freq-select" class="w-full text-xs sm:text-sm bg-surface-soft border border-hairline rounded-xl px-3 py-2.5 text-ink focus:outline-none focus:border-indigo-500 transition-colors">
            <option value="2.45">Dual-Band 2.45 GHz (High Penetration Depth &bull; Core Sublimation)</option>
            <option value="5.80">Dual-Band 5.80 GHz (High Surface Flux &bull; Rapid Thin-Layer)</option>
            <option value="hybrid">Dynamic Hybrid (2.45 GHz Core + 5.80 GHz Surface Pulse)</option>
          </select>
          <p class="text-[11px] text-muted mt-1">{d.freqHelp}</p>
        </div>

        <!-- 4. Fluidizing Gas Temperature -->
        <div>
          <div class="flex items-center justify-between text-xs font-semibold text-ink mb-1">
            <span>{d.tempLabel}</span>
            <span class="font-mono text-cyan-400 font-bold" id="fm-acfd-temp-val">-28.0 °C</span>
          </div>
          <input type="range" id="fm-acfd-temp-slider" min="-45.0" max="-10.0" step="1.0" value="-28.0" class="w-full accent-cyan-500 cursor-pointer" />
          <p class="text-[11px] text-muted mt-1">{d.tempHelp}</p>
        </div>

        <!-- 5. Fluidizing Gas Velocity -->
        <div>
          <div class="flex items-center justify-between text-xs font-semibold text-ink mb-1">
            <span>{d.velocityLabel}</span>
            <span class="font-mono text-indigo-400 font-bold" id="fm-acfd-velocity-val">1.8 m/s</span>
          </div>
          <input type="range" id="fm-acfd-velocity-slider" min="0.6" max="3.5" step="0.1" value="1.8" class="w-full accent-indigo-500 cursor-pointer" />
          <p class="text-[11px] text-muted mt-1">{d.velocityHelp}</p>
        </div>

        <!-- 6. Pellet Diameter -->
        <div>
          <div class="flex items-center justify-between text-xs font-semibold text-ink mb-1">
            <span>{d.diameterLabel}</span>
            <span class="font-mono text-indigo-400 font-bold" id="fm-acfd-diameter-val">2.5 mm</span>
          </div>
          <input type="range" id="fm-acfd-diameter-slider" min="1.0" max="6.0" step="0.2" value="2.5" class="w-full accent-indigo-500 cursor-pointer" />
          <p class="text-[11px] text-muted mt-1">{d.diameterHelp}</p>
        </div>
      </form>
    </section>

    <!-- Right Column: Live Telemetry Cards (5 cols) -->
    <section class="lg:col-span-5 bg-surface border border-hairline rounded-3xl p-6 sm:p-8 shadow-sm flex flex-col justify-between">
      <div>
        <div class="border-b border-hairline/80 pb-4 mb-6">
          <h2 class="text-xl font-bold text-ink tracking-tight flex items-center gap-2">
            <span class="text-cyan-400">📊</span>
            {d.telemetryTitle}
          </h2>
          <p class="text-xs sm:text-sm text-muted mt-1 leading-relaxed">
            {d.telemetrySub}
          </p>
        </div>

        <div class="grid grid-cols-2 gap-4 mb-6">
          <!-- Metric 1: Sublimation Flux -->
          <div class="p-4 rounded-2xl bg-surface-soft border border-hairline">
            <span class="block text-[11px] font-semibold text-muted mb-1">{d.sublimationFluxLabel}</span>
            <span class="text-xl sm:text-2xl font-black font-mono text-indigo-400" id="fm-acfd-out-flux">1.45 kg/m²·h</span>
          </div>

          <!-- Metric 2: Drying Time -->
          <div class="p-4 rounded-2xl bg-surface-soft border border-hairline">
            <span class="block text-[11px] font-semibold text-muted mb-1">{d.dryingTimeLabel}</span>
            <span class="text-xl sm:text-2xl font-black font-mono text-cyan-400" id="fm-acfd-out-time">32.5 min</span>
          </div>

          <!-- Metric 3: Water Activity -->
          <div class="p-4 rounded-2xl bg-surface-soft border border-hairline">
            <span class="block text-[11px] font-semibold text-muted mb-1">{d.waterActivityLabel}</span>
            <span class="text-xl sm:text-2xl font-black font-mono text-emerald-400" id="fm-acfd-out-aw">0.16 a_w</span>
          </div>

          <!-- Metric 4: Core Temperature -->
          <div class="p-4 rounded-2xl bg-surface-soft border border-hairline">
            <span class="block text-[11px] font-semibold text-muted mb-1">{d.coreTempLabel}</span>
            <span class="text-xl sm:text-2xl font-black font-mono text-cyan-300" id="fm-acfd-out-core-temp">-24.8 °C</span>
          </div>

          <!-- Metric 5: Cavity Q-Factor -->
          <div class="p-4 rounded-2xl bg-surface-soft border border-hairline">
            <span class="block text-[11px] font-semibold text-muted mb-1">{d.qFactorLabel}</span>
            <span class="text-xl sm:text-2xl font-black font-mono text-indigo-300" id="fm-acfd-out-q">3,420 Q</span>
          </div>

          <!-- Metric 6: Energy SEC -->
          <div class="p-4 rounded-2xl bg-surface-soft border border-hairline">
            <span class="block text-[11px] font-semibold text-muted mb-1">{d.secLabel}</span>
            <span class="text-xl sm:text-2xl font-black font-mono text-amber-400" id="fm-acfd-out-sec">1.42 kWh/kg</span>
          </div>
        </div>

        <!-- Probiotic & Enzyme Survival Bars -->
        <div class="space-y-4 p-4 rounded-2xl bg-surface-soft border border-hairline mb-6">
          <div>
            <div class="flex justify-between text-xs font-bold text-ink mb-1">
              <span>{d.probioticLabel}</span>
              <span class="font-mono text-emerald-400" id="fm-acfd-out-probiotic">96.8%</span>
            </div>
            <div class="w-full bg-slate-800 rounded-full h-2.5 overflow-hidden">
              <div class="bg-emerald-500 h-2.5 rounded-full transition-all duration-300" id="fm-acfd-bar-probiotic" style="width: 96.8%"></div>
            </div>
          </div>

          <div>
            <div class="flex justify-between text-xs font-bold text-ink mb-1">
              <span>{d.enzymeLabel}</span>
              <span class="font-mono text-cyan-400" id="fm-acfd-out-enzyme">97.4%</span>
            </div>
            <div class="w-full bg-slate-800 rounded-full h-2.5 overflow-hidden">
              <div class="bg-cyan-500 h-2.5 rounded-full transition-all duration-300" id="fm-acfd-bar-enzyme" style="width: 97.4%"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Verdict Banner -->
      <div class="p-5 rounded-2xl border transition-all" id="fm-acfd-verdict-banner">
        <div class="flex items-center gap-2 mb-2">
          <span class="text-lg" id="fm-acfd-verdict-icon">✅</span>
          <span class="text-xs font-bold uppercase tracking-wider" id="fm-acfd-verdict-title">
            {d.verdictLabel}
          </span>
        </div>
        <p class="text-xs sm:text-sm leading-relaxed" id="fm-acfd-verdict-desc">
          Optimal continuous atmospheric lyophilization. Ice sublimation proceeds rapidly under 35 minutes without melting. Full probiotic viability and enzymatic activity preserved under FDA 21 CFR § 117.
        </p>
      </div>
    </section>
  </div>

  <!-- Skid Architecture SVG Diagram -->
  <section class="bg-surface border border-hairline rounded-3xl p-6 sm:p-10 shadow-sm mb-12">
    <div class="border-b border-hairline/80 pb-4 mb-6">
      <h2 class="text-xl sm:text-2xl font-bold text-ink tracking-tight flex items-center gap-2">
        <span class="text-indigo-400">📐</span>
        {d.diagramTitle}
      </h2>
      <p class="text-xs sm:text-sm text-muted mt-1 leading-relaxed">
        {d.diagramSub}
      </p>
    </div>

    <div class="w-full overflow-x-auto py-4">
      <svg viewBox="0 0 960 380" class="w-full max-w-4xl mx-auto block font-sans" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Background Grid -->
        <rect width="960" height="380" rx="16" fill="#0f172a" stroke="#1e293b" stroke-width="2"/>

        <!-- Flow Lines -->
        <path d="M 120 180 L 220 180" stroke="#38bdf8" stroke-width="3" stroke-dasharray="6 4"/>
        <path d="M 380 180 L 480 180" stroke="#818cf8" stroke-width="3"/>
        <path d="M 640 180 L 740 180" stroke="#34d399" stroke-width="3"/>
        <path d="M 860 180 L 920 180" stroke="#34d399" stroke-width="3" stroke-dasharray="4 4"/>

        <!-- Closed Loop N2 Recirculation -->
        <path d="M 560 80 L 560 40 L 280 40 L 280 120" stroke="#06b6d4" stroke-width="2" stroke-dasharray="4 4"/>
        <text x="420" y="32" fill="#38bdf8" font-size="11" font-weight="bold" text-anchor="middle">Dry Cryogenic N2 Loop (Dew Point &lt; -60°C • P = 1.013 bar)</text>

        <!-- Sub-Unit 1: Cryo-Pellet Vibratory Feeder -->
        <g transform="translate(40, 110)">
          <rect width="100" height="140" rx="12" fill="#1e293b" stroke="#38bdf8" stroke-width="2"/>
          <circle cx="50" cy="45" r="24" fill="#0284c7" fill-opacity="0.2"/>
          <text x="50" y="49" fill="#38bdf8" font-size="20" text-anchor="middle">❄️</text>
          <text x="50" y="90" fill="#f8fafc" font-size="12" font-weight="bold" text-anchor="middle">Cryo-Pellet</text>
          <text x="50" y="105" fill="#94a3b8" font-size="10" text-anchor="middle">Feed Hopper</text>
          <text x="50" y="125" fill="#38bdf8" font-size="9" font-family="monospace" text-anchor="middle">-40°C Pellets</text>
        </g>

        <!-- Sub-Unit 2: Solid-State GaN RF Power Generator -->
        <g transform="translate(220, 110)">
          <rect width="160" height="140" rx="12" fill="#1e293b" stroke="#818cf8" stroke-width="2"/>
          <rect x="20" y="20" width="120" height="40" rx="6" fill="#4338ca" fill-opacity="0.3" stroke="#6366f1" stroke-width="1.5"/>
          <text x="80" y="44" fill="#a5b4fc" font-size="12" font-weight="bold" text-anchor="middle">Solid-State GaN</text>
          <text x="80" y="85" fill="#f8fafc" font-size="12" font-weight="bold" text-anchor="middle">2.45 &amp; 5.8 GHz</text>
          <text x="80" y="102" fill="#94a3b8" font-size="10" text-anchor="middle">Dual-Band RF</text>
          <text x="80" y="125" fill="#818cf8" font-size="9" font-family="monospace" text-anchor="middle">150–600 W Variable</text>
        </g>

        <!-- Sub-Unit 3: Resonant Microwave Fluidized Bed Cavity -->
        <g transform="translate(480, 80)">
          <rect width="160" height="200" rx="12" fill="#1e1b4b" stroke="#c084fc" stroke-width="2.5"/>
          <circle cx="80" cy="55" r="30" fill="#7e22ce" fill-opacity="0.2"/>
          <text x="80" y="60" fill="#c084fc" font-size="24" text-anchor="middle">⚡</text>
          <text x="80" y="110" fill="#f8fafc" font-size="13" font-weight="bold" text-anchor="middle">Microwave Bed</text>
          <text x="80" y="128" fill="#e9d5ff" font-size="11" text-anchor="middle">Resonant Cavity</text>
