<script>
  import fmAcfdData from '../data/fm-acfd-freeze-drying-data.json';

  function initFmAcfdModeler() {
    const container = document.querySelector('.fm-acfd-modeler-container');
    if (!container) return;

    const form = document.getElementById('fm-acfd-controls-form');
    const formulationSelect = document.getElementById('fm-acfd-formulation-select') as HTMLSelectElement | null;
    const powerSlider = document.getElementById('fm-acfd-power-slider') as HTMLInputElement | null;
    const powerVal = document.getElementById('fm-acfd-power-val');
    const freqSelect = document.getElementById('fm-acfd-freq-select') as HTMLSelectElement | null;
    const tempSlider = document.getElementById('fm-acfd-temp-slider') as HTMLInputElement | null;
    const tempVal = document.getElementById('fm-acfd-temp-val');
    const velocitySlider = document.getElementById('fm-acfd-velocity-slider') as HTMLInputElement | null;
    const velocityVal = document.getElementById('fm-acfd-velocity-val');
    const diameterSlider = document.getElementById('fm-acfd-diameter-slider') as HTMLInputElement | null;
    const diameterVal = document.getElementById('fm-acfd-diameter-val');

    // Telemetry outputs
    const outFlux = document.getElementById('fm-acfd-out-flux');
    const outTime = document.getElementById('fm-acfd-out-time');
    const outAw = document.getElementById('fm-acfd-out-aw');
    const outCoreTemp = document.getElementById('fm-acfd-out-core-temp');
    const outQ = document.getElementById('fm-acfd-out-q');
    const outSec = document.getElementById('fm-acfd-out-sec');
    const outProbiotic = document.getElementById('fm-acfd-out-probiotic');
    const outEnzyme = document.getElementById('fm-acfd-out-enzyme');
    const barProbiotic = document.getElementById('fm-acfd-bar-probiotic');
    const barEnzyme = document.getElementById('fm-acfd-bar-enzyme');

    // Verdict elements
    const verdictBanner = document.getElementById('fm-acfd-verdict-banner');
    const verdictIcon = document.getElementById('fm-acfd-verdict-icon');
    const verdictTitle = document.getElementById('fm-acfd-verdict-title');
    const verdictDesc = document.getElementById('fm-acfd-verdict-desc');

    const formulations = fmAcfdData.formulations;

    function recalculate() {
      if (!formulationSelect || !powerSlider || !freqSelect || !tempSlider || !velocitySlider || !diameterSlider) return;

      const fId = formulationSelect.value;
      const baseF = formulations.find(f => f.id === fId) || formulations[0];

      const powerW = parseFloat(powerSlider.value);
      const freqMode = freqSelect.value;
      const gasTempC = parseFloat(tempSlider.value);
      const gasVel = parseFloat(velocitySlider.value);
      const diamMm = parseFloat(diameterSlider.value);

      if (powerVal) powerVal.textContent = `${powerW.toFixed(0)} W`;
      if (tempVal) tempVal.textContent = `${gasTempC.toFixed(1)} °C`;
      if (velocityVal) velocityVal.textContent = `${gasVel.toFixed(1)} m/s`;
      if (diameterVal) diameterVal.textContent = `${diamMm.toFixed(1)} mm`;

      // Physics computations
      // Base sublimation flux scaling: J = J_base * (P/P_base)^0.65 * (v/v_base)^0.4 * (d_base/d)^0.5
      const powerFactor = Math.pow(powerW / baseF.microwavePowerWatts, 0.65);
      const velFactor = Math.pow(gasVel / baseF.fluidizingGasVelocityMPerS, 0.4);
      const diamFactor = Math.pow(baseF.pelletDiameterMm / diamMm, 0.5);
      const freqFactor = freqMode === '5.80' ? 1.12 : (freqMode === 'hybrid' ? 1.08 : 1.0);

      const calculatedFlux = Math.max(0.2, baseF.iceSublimationFluxKgPerM2H * powerFactor * velFactor * diamFactor * freqFactor);
      
      // Drying time (minutes) inversely proportional to flux
      const calculatedTime = Math.max(12.0, (baseF.dryingTimeMinutes * (baseF.iceSublimationFluxKgPerM2H / calculatedFlux)));

      // Core ice temperature estimation: balances internal RF heating with convective gas cooling
      const heatLoad = (powerW / 400.0) * 12.0;
      const coolingLoad = (gasVel / 1.8) * Math.abs(gasTempC);
      const calculatedCoreTemp = Math.min(-2.0, gasTempC + (heatLoad * 1.5) - (coolingLoad * 0.2));

      // Water activity estimation
      const calculatedAw = Math.max(0.10, Math.min(0.65, baseF.finalWaterActivityAw * (30.0 / calculatedTime) * (calculatedCoreTemp > -10 ? 1.8 : 1.0)));

      // Cavity Q-factor (increases as dielectric load leaves)
      const calculatedQ = Math.round(1800 + (calculatedFlux / 2.0) * 2200);

      // Energy SEC (kWh/kg ice)
      const calculatedSec = Math.max(1.10, baseF.secKwhPerKgIce * (powerW / 380.0) * (calculatedTime / baseF.dryingTimeMinutes));

      // Biological viability
      let probSurvival = baseF.probioticViabilitySurvivalPct;
      let enzymeAct = baseF.enzymeRetentionPct;

      if (powerW > 600 || calculatedCoreTemp > -8.0) {
        const penalty = (powerW - 600) * 0.4 + Math.max(0, calculatedCoreTemp + 8.0) * 5.0;
        probSurvival = Math.max(5.0, probSurvival - penalty);
        enzymeAct = Math.max(8.0, enzymeAct - penalty * 0.8);
      } else {
        probSurvival = Math.min(99.2, probSurvival + (gasTempC < -25 ? 1.2 : 0));
        enzymeAct = Math.min(99.5, enzymeAct + (gasTempC < -25 ? 1.0 : 0));
      }

      // Update UI elements
      if (outFlux) outFlux.textContent = `${calculatedFlux.toFixed(2)} kg/m²·h`;
      if (outTime) outTime.textContent = `${calculatedTime.toFixed(1)} min`;
      if (outAw) outAw.textContent = `${calculatedAw.toFixed(2)} a_w`;
      if (outCoreTemp) outCoreTemp.textContent = `${calculatedCoreTemp.toFixed(1)} °C`;
      if (outQ) outQ.textContent = `${calculatedQ.toLocaleString()} Q`;
      if (outSec) outSec.textContent = `${calculatedSec.toFixed(2)} kWh/kg`;

      if (outProbiotic) outProbiotic.textContent = `${probSurvival.toFixed(1)}%`;
      if (outEnzyme) outEnzyme.textContent = `${enzymeAct.toFixed(1)}%`;

      if (barProbiotic) {
        barProbiotic.style.width = `${probSurvival}%`;
        barProbiotic.className = `h-2.5 rounded-full transition-all duration-300 ${probSurvival > 85 ? 'bg-emerald-500' : probSurvival > 60 ? 'bg-amber-500' : 'bg-rose-500'}`;
      }
      if (barEnzyme) {
        barEnzyme.style.width = `${enzymeAct}%`;
        barEnzyme.className = `h-2.5 rounded-full transition-all duration-300 ${enzymeAct > 85 ? 'bg-cyan-500' : enzymeAct > 60 ? 'bg-amber-500' : 'bg-rose-500'}`;
      }

      // Verdict Logic
      if (verdictBanner && verdictIcon && verdictTitle && verdictDesc) {
        if (powerW > 650 || calculatedCoreTemp > -6.0 || fId === 'cavity_plasma_arcing_hazard') {
          verdictBanner.className = 'p-5 rounded-2xl border transition-all bg-rose-950/40 border-rose-800 text-rose-200';
          verdictIcon.textContent = '🚨';
          verdictTitle.textContent = 'HIGH RISK: MICROWAVE DIELECTRIC BREAKDOWN & ICE MELTING';
          verdictDesc.textContent = 'Excessive RF power density or insufficient cryogenic gas cooling has triggered localized ice melting. Dielectric loss jumped 10,000x, inducing runaway thermal arcing and complete biological denaturation.';
        } else if (calculatedTime > 50.0) {
          verdictBanner.className = 'p-5 rounded-2xl border transition-all bg-amber-950/40 border-amber-800 text-amber-200';
          verdictIcon.textContent = '⚠️';
          verdictTitle.textContent = 'SLOW SUBLIMATION RATE: KINETIC DIFFUSION LIMITED';
          verdictDesc.textContent = 'Sublimation duration exceeds 50 minutes due to low microwave power or large cryo-pellet diameter. Increase solid-state power to 380 W or decrease droplet size to 2.0 mm.';
        } else {
          verdictBanner.className = 'p-5 rounded-2xl border transition-all bg-emerald-950/40 border-emerald-800 text-emerald-200';
          verdictIcon.textContent = '✅';
          verdictTitle.textContent = 'OPTIMAL ATMOSPHERIC LYOPHILIZATION (FDA & 3-A COMPLIANT)';
          verdictDesc.textContent = 'Flawless non-vacuum sublimation. Focused solid-state GaN microwave energy delivers ice sublimation latent heat while maintaining product below -18°C. Probiotic recovery exceeds 95% in under 40 minutes.';
        }
      }
    }

    // Attach event listeners
    if (form) {
      form.addEventListener('input', recalculate);
      form.addEventListener('change', recalculate);
    }

    // Presets handler
    const presetButtons = document.querySelectorAll('.fm-acfd-preset-btn');
    presetButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const presetId = target.getAttribute('data-preset');
        if (!presetId) return;

        const p = formulations.find(f => f.id === presetId);
        if (p && formulationSelect && powerSlider && tempSlider && velocitySlider && diameterSlider && freqSelect) {
          formulationSelect.value = p.id;
          powerSlider.value = p.microwavePowerWatts.toString();
          tempSlider.value = p.fluidizingGasTempCelsius.toString();
          velocitySlider.value = p.fluidizingGasVelocityMPerS.toString();
          diameterSlider.value = p.pelletDiameterMm.toString();
          freqSelect.value = p.microwaveFrequencyGhz === 5.8 ? '5.80' : '2.45';
          recalculate();
        }
      });
    });

    recalculate();
  }

  // Lifecycle initialization
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFmAcfdModeler);
  } else {
    initFmAcfdModeler();
  }
</script>
