const d = DICTIONARY[lang];
---

<div class="not-prose my-8 p-6 sm:p-8 rounded-3xl bg-surface-card border border-hairline shadow-sm" id="freeze-dryer-modeler-root">
  <!-- Header Bar -->
  <div class="flex flex-wrap items-center justify-between gap-4 pb-6 border-b border-hairline">
    <div>
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-cyan-700 text-white mb-2">
        {d.badge}
      </span>
      <h2 class="text-xl sm:text-2xl font-extrabold text-ink tracking-tight">
        {d.title}
      </h2>
      <p class="text-xs sm:text-sm text-muted mt-1 max-w-3xl leading-relaxed">
        {d.subtitle}
      </p>
    </div>
    <div class="flex items-center gap-2">
      <span class="px-2.5 py-1 rounded-md text-xs font-mono font-bold bg-cyan-100 text-cyan-900 border border-cyan-200">
        FDA 21 CFR § 117 &bull; ASME Sec VIII &bull; ISO 13408-3
      </span>
    </div>
  </div>

  <!-- Operational Presets -->
  <div class="mt-6 pt-2">
    <label class="block text-xs font-bold text-ink uppercase tracking-wider mb-2">
      {d.presetsTitle}
    </label>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5">
      <button 
        type="button" 
        id="preset-btn-compliant" 
        class="py-2.5 px-3 text-xs font-semibold rounded-xl border border-hairline bg-surface-soft hover:bg-surface-hover text-ink text-left transition-colors"
      >
        <span class="text-emerald-600 font-bold block mb-0.5">✓ {d.presetCompliant}</span>
        <span class="text-muted text-[11px] block">Shelf +15°C, 0.08 mbar, -65°C Trap, 4mm Ice, ΔT = +3.7°C Safe</span>
      </button>
      <button 
        type="button" 
        id="preset-btn-meltback" 
        class="py-2.5 px-3 text-xs font-semibold rounded-xl border border-rose-300 bg-rose-50/50 hover:bg-rose-100/60 text-ink text-left transition-colors"
      >
        <span class="text-rose-600 font-bold block mb-0.5">⚠️ {d.presetMeltback}</span>
        <span class="text-muted text-[11px] block">Shelf +45°C, 0.45 mbar, Tg' Exceeded, Viscous Sponge Collapse</span>
      </button>
      <button 
        type="button" 
        id="preset-btn-condenser-choke" 
        class="py-2.5 px-3 text-xs font-semibold rounded-xl border border-amber-300 bg-amber-50/50 hover:bg-amber-100/60 text-ink text-left transition-colors"
      >
        <span class="text-amber-700 font-bold block mb-0.5">⚡ {d.presetCondenserChoke}</span>
        <span class="text-muted text-[11px] block">19.5mm Ice Cake, Condenser Choked, Vapor Backpressure Surge</span>
      </button>
      <button 
        type="button" 
        id="preset-btn-gasket-leak" 
        class="py-2.5 px-3 text-xs font-semibold rounded-xl border border-hairline bg-surface-soft hover:bg-surface-hover text-ink text-left transition-colors"
      >
        <span class="text-cyan-700 font-bold block mb-0.5">💨 {d.presetGasketLeak}</span>
        <span class="text-muted text-[11px] block">Aged EPDM Door Gasket, 0.185 mbar·L/s Inleakage, Hexanal Oxidation</span>
      </button>
    </div>
  </div>

  <!-- Main Grid Controls & Diagnostics -->
  <div class="mt-8 grid grid-cols-1 lg:grid-cols-12 gap-8">
    <!-- Controls (7 cols) -->
    <div class="lg:col-span-7 space-y-6">
      <div class="border-b border-hairline pb-2">
        <h3 class="text-sm font-bold text-ink uppercase tracking-wider">
          {d.controlsTitle}
        </h3>
        <p class="text-xs text-muted mt-0.5">
          {d.controlsSub}
        </p>
      </div>

      <!-- 1. Freeze Dryer Architecture -->
      <div class="space-y-1.5">
        <label for="select-dryer-arch" class="block text-xs font-bold text-ink">
          {d.dryerLabel}
        </label>
        <select 
          id="select-dryer-arch" 
          class="w-full text-xs p-3 rounded-xl border border-hairline bg-surface-soft text-ink font-medium focus:ring-2 focus:ring-cyan-500 focus:outline-hidden transition-all"
        >
          {freezeDryerData.freezeDryerArchitectures.map(arch => (
            <option value={arch.id}>{arch.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted leading-relaxed">
          {d.dryerHelp}
        </p>
      </div>

      <!-- 2. Food Substrate Profile -->
      <div class="space-y-1.5">
        <label for="select-substrate-profile" class="block text-xs font-bold text-ink">
          {d.substrateLabel}
        </label>
        <select 
          id="select-substrate-profile" 
          class="w-full text-xs p-3 rounded-xl border border-hairline bg-surface-soft text-ink font-medium focus:ring-2 focus:ring-cyan-500 focus:outline-hidden transition-all"
        >
          {freezeDryerData.foodSubstrateProfiles.map(sub => (
            <option value={sub.id}>{sub.name} (Tg' = {sub.glassTransitionCollapseTempC}°C)</option>
          ))}
        </select>
        <p class="text-[11px] text-muted leading-relaxed">
          {d.substrateHelp}
        </p>
      </div>

      <!-- 3. Fluid-Circulating Shelf Heating Temperature Slider -->
      <div class="space-y-2 p-4 rounded-2xl bg-surface-soft border border-hairline">
        <div class="flex items-center justify-between text-xs">
          <label for="input-shelf-temp" class="font-bold text-ink">
            {d.shelfTempLabel}
          </label>
          <span id="disp-shelf-temp" class="font-mono font-bold text-cyan-800 bg-cyan-100 px-2 py-0.5 rounded border border-cyan-200">
            +15.0°C / +59.0°F
          </span>
        </div>
        <input 
          type="range" 
          id="input-shelf-temp" 
          min="-40" 
          max="50" 
          step="1" 
          value="15" 
          class="w-full accent-cyan-600 cursor-pointer"
        />
        <div class="flex justify-between text-[10px] text-muted font-mono">
          <span>-40°C (Freezing Dwell)</span>
          <span>0°C (Ice Triple Point)</span>
          <span>+50°C (Secondary Max)</span>
        </div>
        <p class="text-[11px] text-muted leading-relaxed mt-1">
          {d.shelfTempHelp}
        </p>
      </div>

      <!-- 4. Chamber Deep Vacuum Level Slider -->
      <div class="space-y-2 p-4 rounded-2xl bg-surface-soft border border-hairline">
        <div class="flex items-center justify-between text-xs">
          <label for="input-vacuum-level" class="font-bold text-ink">
            {d.vacuumLabel}
          </label>
          <span id="disp-vacuum-level" class="font-mono font-bold text-cyan-800 bg-cyan-100 px-2 py-0.5 rounded border border-cyan-200">
            0.080 mbar (60 mTorr)
          </span>
        </div>
        <input 
          type="range" 
          id="input-vacuum-level" 
          min="0.020" 
          max="0.800" 
          step="0.010" 
          value="0.080" 
          class="w-full accent-cyan-600 cursor-pointer"
        />
        <div class="flex justify-between text-[10px] text-muted font-mono">
          <span>0.020 mbar (Deep Vacuum)</span>
          <span>0.200 mbar (Commercial Nom.)</span>
          <span>0.800 mbar (Near Collapse)</span>
        </div>
        <p class="text-[11px] text-muted leading-relaxed mt-1">
          {d.vacuumHelp}
        </p>
      </div>

      <!-- 5. Condenser Coil Temperature Slider -->
      <div class="space-y-2 p-4 rounded-2xl bg-surface-soft border border-hairline">
        <div class="flex items-center justify-between text-xs">
          <label for="input-condenser-temp" class="font-bold text-ink">
            {d.condenserTempLabel}
          </label>
          <span id="disp-condenser-temp" class="font-mono font-bold text-cyan-800 bg-cyan-100 px-2 py-0.5 rounded border border-cyan-200">
            -65.0°C / -85.0°F
          </span>
        </div>
        <input 
          type="range" 
          id="input-condenser-temp" 
          min="-90" 
          max="-30" 
          step="1" 
          value="-65" 
          class="w-full accent-cyan-600 cursor-pointer"
        />
        <div class="flex justify-between text-[10px] text-muted font-mono">
          <span>-90°C (Cascade / LN2)</span>
          <span>-60°C (Industrial Target)</span>
          <span>-30°C (Deficient Trap)</span>
        </div>
        <p class="text-[11px] text-muted leading-relaxed mt-1">
          {d.condenserTempHelp}
        </p>
      </div>

      <!-- 6. Condenser Coil Ice Cake Thickness Slider -->
      <div class="space-y-2 p-4 rounded-2xl bg-surface-soft border border-hairline">
        <div class="flex items-center justify-between text-xs">
          <label for="input-ice-cake" class="font-bold text-ink">
            {d.iceCakeLabel}
          </label>
          <span id="disp-ice-cake" class="font-mono font-bold text-cyan-800 bg-cyan-100 px-2 py-0.5 rounded border border-cyan-200">
            4.0 mm
          </span>
        </div>
        <input 
          type="range" 
          id="input-ice-cake" 
          min="1.0" 
          max="25.0" 
          step="0.5" 
          value="4.0" 
          class="w-full accent-cyan-600 cursor-pointer"
        />
        <div class="flex justify-between text-[10px] text-muted font-mono">
          <span>1.0 mm (Clean Bare Coil)</span>
          <span>10.0 mm (Moderate Load)</span>
          <span>25.0 mm (Severe Choke)</span>
        </div>
        <p class="text-[11px] text-muted leading-relaxed mt-1">
          {d.iceCakeHelp}
        </p>
      </div>

      <!-- 7. Door Gasket & Elastomer Profile -->
      <div class="space-y-1.5">
        <label for="select-gasket-profile" class="block text-xs font-bold text-ink">
          {d.gasketLabel}
        </label>
        <select 
          id="select-gasket-profile" 
          class="w-full text-xs p-3 rounded-xl border border-hairline bg-surface-soft text-ink font-medium focus:ring-2 focus:ring-cyan-500 focus:outline-hidden transition-all"
        >
          {freezeDryerData.vacuumGasketSealingProfiles.map(g => (
            <option value={g.id}>{g.name} (Leak: {g.leakRateMbarLs} mbar·L/s)</option>
          ))}
        </select>
        <p class="text-[11px] text-muted leading-relaxed">
          {d.gasketHelp}
        </p>
      </div>
    </div>

    <!-- Telemetry & Diagnostic Visuals (5 cols) -->
    <div class="lg:col-span-5 space-y-6">
      <div class="border-b border-hairline pb-2">
        <h3 class="text-sm font-bold text-ink uppercase tracking-wider">
          {d.diagnosticTitle}
        </h3>
        <p class="text-xs text-muted mt-0.5">
          {d.diagnosticSub}
