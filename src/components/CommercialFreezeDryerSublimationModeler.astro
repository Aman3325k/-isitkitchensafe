              <td class="p-3 font-mono text-ink">{arch.condenserCapacityKg} kg</td>
              <td class="p-3 font-mono text-ink">{arch.ultimateVacuumMbar} mbar</td>
              <td class="p-3 font-mono text-ink">{arch.iceCakeChokeLimitMm} mm</td>
            </tr>
          ))}
