        </div>
        <div class="space-y-1">
          <span class="font-bold text-cyan-700 block">&bull; {d.rule3Title}</span>
          <p class="text-muted leading-relaxed">{d.rule3Text}</p>
        </div>
        <div class="space-y-1">
          <span class="font-bold text-cyan-700 block">&bull; {d.rule4Title}</span>
          <p class="text-muted leading-relaxed">{d.rule4Text}</p>
