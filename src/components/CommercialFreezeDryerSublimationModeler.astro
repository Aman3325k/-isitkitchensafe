            <path d="M 125,75 L 125,60 Q 180,50 235,80" fill="none" stroke="#38bdf8" stroke-width="2" stroke-dasharray="4,4" />
            <path d="M 125,110 L 125,95 Q 180,90 235,115" fill="none" stroke="#38bdf8" stroke-width="2" stroke-dasharray="4,4" />
          </g>

          <!-- Connecting Vacuum Duct / Butterfly Isolation Valve -->
          <rect x="235" y="75" width="30" height="40" fill="#334155" stroke="#64748b" stroke-width="2" />
