</div>

<script>
  function initFreezeDryerModeler() {
    const root = document.getElementById('freeze-dryer-modeler-root');
    if (!root) return;

    // Elements
    const dryerSelect = document.getElementById('select-dryer-arch') as HTMLSelectElement | null;
    const substrateSelect = document.getElementById('select-substrate-profile') as HTMLSelectElement | null;
    const shelfTempInput = document.getElementById('input-shelf-temp') as HTMLInputElement | null;
    const vacuumInput = document.getElementById('input-vacuum-level') as HTMLInputElement | null;
    const condenserTempInput = document.getElementById('input-condenser-temp') as HTMLInputElement | null;
    const iceCakeInput = document.getElementById('input-ice-cake') as HTMLInputElement | null;
    const gasketSelect = document.getElementById('select-gasket-profile') as HTMLSelectElement | null;

    // Value displays
    const dispShelfTemp = document.getElementById('disp-shelf-temp');
    const dispVacuum = document.getElementById('disp-vacuum-level');
    const dispCondenserTemp = document.getElementById('disp-condenser-temp');
    const dispIceCake = document.getElementById('disp-ice-cake');

    // Telemetry displays
    const metricSublimationTemp = document.getElementById('metric-sublimation-temp');
    const badgeCollapse = document.getElementById('badge-collapse');
    const metricCollapseMargin = document.getElementById('metric-collapse-margin');
    const barCollapse = document.getElementById('bar-collapse');

    const metricIceSurfaceTemp = document.getElementById('metric-ice-surface-temp');
    const badgeChoke = document.getElementById('badge-choke');
    const metricChokeMargin = document.getElementById('metric-choke-margin');

    const metricPiraniRatio = document.getElementById('metric-pirani-ratio');
    const badgePirani = document.getElementById('badge-pirani');
    const metricPiraniDisp = document.getElementById('metric-pirani-disp');
    const metricBaratronDisp = document.getElementById('metric-baratron-disp');

    const metricLeakRate = document.getElementById('metric-leak-rate');
    const badgeGasket = document.getElementById('badge-gasket');
    const metricGasketStatus = document.getElementById('metric-gasket-status');

    // SVG elements
    const svgIceCakeLayer = document.getElementById('svg-ice-cake-layer');
    const svgIceCakeDisp = document.getElementById('svg-ice-cake-disp');
    const svgPiraniDisp = document.getElementById('svg-pirani-disp');
    const svgStatusIndicator = document.getElementById('svg-status-indicator');
    const svgDoorGasket = document.getElementById('svg-door-gasket');

    // Banner
    const bannerRoot = document.getElementById('banner-diagnostic-root');
    const bannerBadge = document.getElementById('banner-compliance-badge');
    const diagPrimaryRisk = document.getElementById('diag-primary-risk');
    const diagMechanisms = document.getElementById('diag-mechanisms');
    const diagMitigation = document.getElementById('diag-mitigation');

    // Presets
    const btnCompliant = document.getElementById('preset-btn-compliant');
    const btnMeltback = document.getElementById('preset-btn-meltback');
    const btnCondenserChoke = document.getElementById('preset-btn-condenser-choke');
    const btnGasketLeak = document.getElementById('preset-btn-gasket-leak');

    // Copy
    const copyBtn = document.getElementById('btn-copy-telemetry');
    const copyText = document.getElementById('copy-btn-text');

    // Substrate Tg' lookup
    const substrateData: Record<string, { tg: number; moisture: number; rp: number }> = {
      high_sugar_berries_puree: { tg: -34.5, moisture: 89.5, rp: 18200 },
      raw_cooked_meats_poultry: { tg: -16.5, moisture: 74.0, rp: 9400 },
      liquid_dairy_probiotics: { tg: -26.0, moisture: 85.0, rp: 14100 },
      coffee_tea_botanical_extracts: { tg: -20.5, moisture: 76.5, rp: 11800 }
    };

    // Gasket leak rate lookup
    const gasketData: Record<string, { leak: number; name: string }> = {
      peroxide_cured_silicone_d_gasket: { leak: 0.002, name: 'Peroxide Silicone' },
      fkm_viton_solid_o_ring: { leak: 0.0005, name: 'FKM Viton A' },
      aged_hardened_epdm_gasket: { leak: 0.185, name: 'Aged Hardened EPDM' }
    };

    // Calculate saturation vapor pressure over ice in mbar
    function getVaporPressureOverIceMbar(tempC: number): number {
      const tKelvin = tempC + 273.15;
      if (tKelvin <= 180) return 0.0001;
      // Formula for vapor pressure over ice (Goff-Gratch / Clausius-Clapeyron approx)
      const logP = -9.09718 * (273.16 / tKelvin - 1) - 3.56654 * Math.log10(273.16 / tKelvin) + 0.876793 * (1 - tKelvin / 273.16) + Math.log10(6.1071);
      return Math.pow(10, logP);
    }

    // Inverse: get saturation temp in °C from vapor pressure in mbar
    function getTempFromVaporPressureC(pMbar: number): number {
      if (pMbar <= 0.001) return -70;
      if (pMbar >= 6.11) return 0.0;
      // Approximation for T from P over ice
      let low = -80;
      let high = 0;
      for (let i = 0; i < 25; i++) {
        const mid = (low + high) / 2;
        const pMid = getVaporPressureOverIceMbar(mid);
        if (pMid < pMbar) low = mid;
        else high = mid;
      }
      return (low + high) / 2;
    }

    function calculate() {
      if (!dryerSelect || !substrateSelect || !shelfTempInput || !vacuumInput || !condenserTempInput || !iceCakeInput || !gasketSelect) return;

      const dryerId = dryerSelect.value;
      const substrateId = substrateSelect.value;
      const shelfTempC = parseFloat(shelfTempInput.value);
      const vacuumMbar = parseFloat(vacuumInput.value);
      const condenserTempC = parseFloat(condenserTempInput.value);
      const iceCakeMm = parseFloat(iceCakeInput.value);
      const gasketId = gasketSelect.value;

      const sub = substrateData[substrateId] || { tg: -34.5, moisture: 85, rp: 15000 };
      const gasket = gasketData[gasketId] || { leak: 0.002, name: 'Silicone' };

      // Update slider readout values
      if (dispShelfTemp) {
        const f = (shelfTempC * 9/5 + 32).toFixed(1);
        dispShelfTemp.textContent = `${shelfTempC >= 0 ? '+' : ''}${shelfTempC.toFixed(1)}°C / ${f >= 0 ? '+' : ''}${f}°F`;
      }
      if (dispVacuum) {
        const mTorr = (vacuumMbar * 750.06).toFixed(0);
        dispVacuum.textContent = `${vacuumMbar.toFixed(3)} mbar (${mTorr} mTorr)`;
      }
      if (dispCondenserTemp) {
        const f = (condenserTempC * 9/5 + 32).toFixed(1);
        dispCondenserTemp.textContent = `${condenserTempC.toFixed(1)}°C / ${f}°F`;
      }
      if (dispIceCake) {
        dispIceCake.textContent = `${iceCakeMm.toFixed(1)} mm`;
      }

      // 1. Sublimation Interface Temperature Calculation
      // Vapor pressure at sublimation front = chamber vacuum + pressure drop through dry cake porous matrix
      const deltaPCake = vacuumMbar * 0.35 + (Math.max(0, shelfTempC) * 0.015);
      const pSubFrontMbar = vacuumMbar + deltaPCake;
      const tSubFrontC = getTempFromVaporPressureC(pSubFrontMbar);

      // Glass transition collapse margin: ΔT = Tg' - Tsub (positive = safe, negative = collapse/meltback)
      const collapseMarginC = sub.tg - tSubFrontC;
      const isMeltback = collapseMarginC < 0;

      // 2. Condenser Ice Cake Thermal Resistance & Outer Surface Temperature
      // k_ice = 2.22 W/m·K. Heat flux from sublimation: q'' ≈ (P_sub - P_cond) * Latent_Heat / R_total
      const kIce = 2.22;
      const iceThicknessM = iceCakeMm / 1000.0;
      const estHeatFluxWm2 = Math.max(150, 450 + shelfTempC * 15);
      const deltaTIceCake = (estHeatFluxWm2 * iceThicknessM) / kIce;
      const tIceSurfaceC = Math.min(0, condenserTempC + deltaTIceCake);
      const pIceSurfaceMbar = getVaporPressureOverIceMbar(tIceSurfaceC);

      // Choking check: if vapor pressure at ice surface >= chamber pressure, condensation halts!
      const isCondenserChoked = (pIceSurfaceMbar >= vacuumMbar * 0.90) || (iceCakeMm >= 18.0 && condenserTempC > -50);
      const vaporFluxKgHm2 = isCondenserChoked 
        ? 0.05 
        : Math.max(0.1, (vacuumMbar - pIceSurfaceMbar) * 1.85 + (estHeatFluxWm2 / 2838) * 3.6);

      // 3. Pirani Gauge Ratio in Water Vapor
      const piraniRatio = isMeltback ? 1.70 : (1.62 - (isCondenserChoked ? 0.25 : 0.04));
      const piraniReadingMbar = vacuumMbar * piraniRatio;

      // 4. Update Metric Displays
      if (metricSublimationTemp) {
        const f = (tSubFrontC * 9/5 + 32).toFixed(1);
        metricSublimationTemp.textContent = `${tSubFrontC.toFixed(1)}°C`;
        metricSublimationTemp.className = `text-2xl font-black font-mono tracking-tight ${isMeltback ? 'text-rose-600' : 'text-ink'}`;
      }
      if (badgeCollapse) {
        if (isMeltback) {
          badgeCollapse.textContent = "MELTBACK & COLLAPSE";
          badgeCollapse.className = "px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-rose-100 text-rose-800";
        } else if (collapseMarginC < 2.0) {
          badgeCollapse.textContent = "BORDERLINE MARGIN";
          badgeCollapse.className = "px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-amber-100 text-amber-800";
        } else {
          badgeCollapse.textContent = "SAFE • Tsub < Tg'";
          badgeCollapse.className = "px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800";
        }
      }
      if (metricCollapseMargin) {
        metricCollapseMargin.textContent = isMeltback 
          ? `${Math.abs(collapseMarginC).toFixed(1)}°C ABOVE Tg' (Violent Meltback)`
          : `+${collapseMarginC.toFixed(1)}°C Safety Margin Below Tg' (${sub.tg}°C)`;
        metricCollapseMargin.className = `font-bold font-mono ${isMeltback ? 'text-rose-600' : 'text-emerald-700'}`;
      }
      if (barCollapse) {
        const pct = isMeltback ? 100 : Math.min(100, Math.max(10, (1 - collapseMarginC / 20) * 100));
        barCollapse.style.width = `${pct}%`;
        barCollapse.className = `h-1.5 rounded-full transition-all ${isMeltback ? 'bg-rose-500' : collapseMarginC < 2.0 ? 'bg-amber-500' : 'bg-emerald-500'}`;
      }

      if (metricIceSurfaceTemp) {
        const f = (tIceSurfaceC * 9/5 + 32).toFixed(1);
        metricIceSurfaceTemp.textContent = `${tIceSurfaceC.toFixed(1)}°C`;
        metricIceSurfaceTemp.className = `text-2xl font-black font-mono tracking-tight ${isCondenserChoked ? 'text-amber-700' : 'text-ink'}`;
      }
      if (badgeChoke) {
        if (isCondenserChoked) {
          badgeChoke.textContent = "CONDENSER CHOKED";
          badgeChoke.className = "px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-rose-100 text-rose-800";
        } else if (iceCakeMm >= 12.0) {
          badgeChoke.textContent = "HIGH ICE LOAD";
          badgeChoke.className = "px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-amber-100 text-amber-800";
        } else {
          badgeChoke.textContent = "VAPOR TRAPPING ACTIVE";
          badgeChoke.className = "px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800";
        }
      }
      if (metricChokeMargin) {
        const chokeHeadroomMm = Math.max(0, 18.0 - iceCakeMm);
        metricChokeMargin.textContent = `${vaporFluxKgHm2.toFixed(2)} kg/h·m² • ${chokeHeadroomMm.toFixed(1)} mm Headroom`;
        metricChokeMargin.className = `font-bold font-mono ${isCondenserChoked ? 'text-rose-600' : 'text-cyan-700'}`;
      }

      if (metricPiraniRatio) {
        metricPiraniRatio.textContent = `${piraniRatio.toFixed(2)}x`;
      }
      if (metricPiraniDisp) {
        metricPiraniDisp.textContent = `${piraniReadingMbar.toFixed(3)} mbar`;
      }
      if (metricBaratronDisp) {
        metricBaratronDisp.textContent = `${vacuumMbar.toFixed(3)} mbar`;
      }

      const isGasketDefective = gasket.leak > 0.05;
      if (metricLeakRate) {
        metricLeakRate.textContent = `${gasket.leak} mbar·L/s`;
      }
      if (badgeGasket) {
        if (isGasketDefective) {
          badgeGasket.textContent = "INLEAKAGE HAZARD";
          badgeGasket.className = "px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-rose-100 text-rose-800";
        } else {
          badgeGasket.textContent = "HERMETIC TIGHT";
          badgeGasket.className = "px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800";
        }
      }
      if (metricGasketStatus) {
        metricGasketStatus.textContent = isGasketDefective 
          ? `${gasket.name} • Permanent Set Failure (>40%)` 
          : `${gasket.name} • Compression Set Safe (<15%)`;
        metricGasketStatus.className = `font-mono font-semibold ${isGasketDefective ? 'text-rose-600' : 'text-emerald-700'}`;
      }

      // 5. Update SVG Graphic
      if (svgIceCakeLayer) {
        const strokeW = Math.max(4, Math.min(28, 4 + iceCakeMm * 1.0));
        svgIceCakeLayer.setAttribute('stroke-width', strokeW.toString());
      }
      if (svgIceCakeDisp) {
        svgIceCakeDisp.textContent = `${iceCakeMm.toFixed(1)} mm`;
      }
      if (svgPiraniDisp) {
        svgPiraniDisp.textContent = `${piraniRatio.toFixed(2)}x (H2O)`;
      }
      if (svgDoorGasket) {
        svgDoorGasket.setAttribute('fill', isGasketDefective ? '#ef4444' : '#10b981');
      }
      if (svgStatusIndicator) {
        if (isMeltback) {
          svgStatusIndicator.textContent = "● CAKE MELTBACK DETECTED";
          svgStatusIndicator.className = "text-rose-400 font-bold animate-pulse";
        } else if (isCondenserChoked) {
          svgStatusIndicator.textContent = "● CONDENSER CHOKING ALARM";
          svgStatusIndicator.className = "text-amber-400 font-bold animate-pulse";
        } else {
          svgStatusIndicator.textContent = "● SUBLIMATION ACTIVE";
          svgStatusIndicator.className = "text-emerald-400 font-bold";
        }
      }

      // 6. Update Diagnostic Banner
      if (bannerRoot && bannerBadge && diagPrimaryRisk && diagMechanisms && diagMitigation) {
        if (isMeltback) {
          bannerRoot.className = "p-5 rounded-2xl border border-rose-300 bg-rose-50/60 shadow-xs transition-colors";
          bannerBadge.textContent = "CRITICAL FAIL • PRODUCT MELTBACK COLLAPSE";
          bannerBadge.className = "px-2.5 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-rose-600 text-white";
          diagPrimaryRisk.textContent = `Severe product core meltback! Sublimation front temperature (${tSubFrontC.toFixed(1)}°C) exceeds the formulation glass transition threshold (${sub.tg}°C). Porous honeycomb structure collapses into an impermeable rubbery skin, entrapping unevaporated liquid water.`;
          diagMechanisms.textContent = "Excessive shelf heating flux or poor chamber vacuum drives sublimation vapor flux beyond cake pore permeability limits. The maximally freeze-concentrated amorphous matrix flows viscously, destroying rehydration capacity and accelerating enzymatic browning.";
          diagMitigation.textContent = "Immediately lower fluid shelf heating temperature below -10°C; reduce chamber vacuum setpoint to <0.080 mbar; verify vacuum pump ballast and condenser refrigeration stage.";
        } else if (isCondenserChoked) {
          bannerRoot.className = "p-5 rounded-2xl border border-amber-300 bg-amber-50/60 shadow-xs transition-colors";
          bannerBadge.textContent = "WARNING • CONDENSER ICE CAKE CHOKING";
          bannerBadge.className = "px-2.5 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-amber-600 text-white";
          diagPrimaryRisk.textContent = `Condenser ice thermal choking limit reached! Thick crystalline ice (${iceCakeMm.toFixed(1)} mm) acts as a thermal insulator (k = 2.22 W/m·K), warming the outer ice surface to ${tIceSurfaceC.toFixed(1)}°C. Vapor capture ceases, threatening chamber pressure blowout.`;
          diagMechanisms.textContent = "Thermal resistance R_ice = x_ice / k_ice elevates ice outer boundary vapor pressure above chamber pressure. Sublimated vapor backs up into the product chamber, causing rapid pressure surging and secondary meltback.";
          diagMitigation.textContent = "Initiate external condenser defrost cycle on alternating trap chamber per 21 CFR § 117; verify condenser refrigeration suction pressure; throttle shelf heat flux to match trap condensing capacity.";
        } else if (isGasketDefective) {
          bannerRoot.className = "p-5 rounded-2xl border border-amber-300 bg-amber-50/60 shadow-xs transition-colors";
          bannerBadge.textContent = "WARNING • VACUUM GASKET AIR INLEAKAGE";
          bannerBadge.className = "px-2.5 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-amber-600 text-white";
          diagPrimaryRisk.textContent = `Chamber door gasket leak rate (${gasket.leak} mbar·L/s) exceeds ISO 13408-3 limit (<0.02 mbar·L/s). Continuous atmospheric oxygen and moisture ingress degrades lipid stability, triggering hexanal rancidity and probiotic culture mortality.`;
          diagMechanisms.textContent = "Permanent compression set (>40%) in hardened EPDM seal prevents continuous elastomeric sealing against the stainless chamber flange under deep vacuum.";
          diagMitigation.textContent = "Replace aged gasket with FDA 21 CFR § 177.2600 peroxide-cured silicone D-profile or FKM Viton O-ring; clean chamber sealing flange; perform Helium mass-spectrometer leak test.";
        } else {
          bannerRoot.className = "p-5 rounded-2xl border border-emerald-300 bg-emerald-50/40 shadow-xs transition-colors";
          bannerBadge.textContent = "COMPLIANT • POROUS CAKE INTACT";
          bannerBadge.className = "px-2.5 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-emerald-600 text-white";
          diagPrimaryRisk.textContent = `Normal sterile lyophilization; sublimation front core temperature (${tSubFrontC.toFixed(1)}°C) is safely buffered below the glass transition collapse threshold (${sub.tg}°C). Porous cake structure and enzymatic stability fully preserved.`;
          diagMechanisms.textContent = "Latent heat of ice sublimation (2,838 kJ/kg) is balanced by fluid shelf heat flux; clean condenser coil captures vapor with low thermal resistance; hermetic vacuum seal holds deep vacuum.";
          diagMitigation.textContent = "Continue primary drying until Pirani and Baratron vacuum readings converge (<1.05x ratio); then advance shelf temperature to +35°C for secondary desorption to achieve final moisture <2.0%.";
        }
      }
    }

    // Event listeners
    dryerSelect?.addEventListener('change', calculate);
    substrateSelect?.addEventListener('change', calculate);
    shelfTempInput?.addEventListener('input', calculate);
    vacuumInput?.addEventListener('input', calculate);
    condenserTempInput?.addEventListener('input', calculate);
    iceCakeInput?.addEventListener('input', calculate);
    gasketSelect?.addEventListener('change', calculate);

    // Preset button handlers
    btnCompliant?.addEventListener('click', () => {
      if (dryerSelect) dryerSelect.value = 'industrial_bulk_food_freeze_dryer';
      if (substrateSelect) substrateSelect.value = 'high_sugar_berries_puree';
      if (shelfTempInput) shelfTempInput.value = '15';
      if (vacuumInput) vacuumInput.value = '0.080';
      if (condenserTempInput) condenserTempInput.value = '-65';
      if (iceCakeInput) iceCakeInput.value = '4.0';
      if (gasketSelect) gasketSelect.value = 'peroxide_cured_silicone_d_gasket';
      calculate();
    });

    btnMeltback?.addEventListener('click', () => {
      if (dryerSelect) dryerSelect.value = 'commercial_craft_batch_freeze_dryer';
      if (substrateSelect) substrateSelect.value = 'high_sugar_berries_puree';
      if (shelfTempInput) shelfTempInput.value = '45';
      if (vacuumInput) vacuumInput.value = '0.450';
      if (condenserTempInput) condenserTempInput.value = '-40';
      if (iceCakeInput) iceCakeInput.value = '8.0';
      if (gasketSelect) gasketSelect.value = 'peroxide_cured_silicone_d_gasket';
      calculate();
    });

    btnCondenserChoke?.addEventListener('click', () => {
      if (dryerSelect) dryerSelect.value = 'commercial_craft_batch_freeze_dryer';
      if (substrateSelect) substrateSelect.value = 'coffee_tea_botanical_extracts';
      if (shelfTempInput) shelfTempInput.value = '25';
      if (vacuumInput) vacuumInput.value = '0.120';
      if (condenserTempInput) condenserTempInput.value = '-45';
      if (iceCakeInput) iceCakeInput.value = '19.5';
      if (gasketSelect) gasketSelect.value = 'peroxide_cured_silicone_d_gasket';
      calculate();
    });

    btnGasketLeak?.addEventListener('click', () => {
      if (dryerSelect) dryerSelect.value = 'substandard_fouled_freeze_dryer';
      if (substrateSelect) substrateSelect.value = 'raw_cooked_meats_poultry';
      if (shelfTempInput) shelfTempInput.value = '20';
      if (vacuumInput) vacuumInput.value = '0.350';
      if (condenserTempInput) condenserTempInput.value = '-45';
      if (iceCakeInput) iceCakeInput.value = '7.0';
      if (gasketSelect) gasketSelect.value = 'aged_hardened_epdm_gasket';
      calculate();
    });

    // Copy telemetry report
    copyBtn?.addEventListener('click', () => {
      if (!dryerSelect || !substrateSelect || !shelfTempInput || !vacuumInput || !condenserTempInput || !iceCakeInput || !gasketSelect) return;
      
      const report = `=== ISITKITCHENSAFE FREEZE DRYER SUBLIMATION & VACUUM TELEMETRY REPORT ===
Timestamp: ${new Date().toISOString()}
Standard: FDA 21 CFR § 117 (FSMA) / ASME BPVC Section VIII / ISO 13408-3
Architecture: ${dryerSelect.options[dryerSelect.selectedIndex].text}
Substrate: ${substrateSelect.options[substrateSelect.selectedIndex].text}
Shelf Heating Temp: ${shelfTempInput.value}°C
Chamber Deep Vacuum: ${vacuumInput.value} mbar
Condenser Coil Temp: ${condenserTempInput.value}°C
Condenser Ice Cake: ${iceCakeInput.value} mm
Door Gasket Profile: ${gasketSelect.options[gasketSelect.selectedIndex].text}

--- THERMODYNAMIC TELEMETRY ---
Sublimation Core Temp (Tsub): ${metricSublimationTemp?.textContent}
Collapse Safety Margin (ΔT): ${metricCollapseMargin?.textContent}
Condenser Ice Surface Temp: ${metricIceSurfaceTemp?.textContent}
Choke Margin & Flux: ${metricChokeMargin?.textContent}
Pirani / Baratron Ratio: ${metricPiraniRatio?.textContent} (Pirani: ${metricPiraniDisp?.textContent})
Vacuum Gasket Ingress Rate: ${metricLeakRate?.textContent}
Process Assessment: ${bannerBadge?.textContent}
Primary Risk: ${diagPrimaryRisk?.textContent}
Remediation: ${diagMitigation?.textContent}
================================================================================`;

      navigator.clipboard.writeText(report).then(() => {
        if (copyText) {
          const original = copyText.textContent;
          copyText.textContent = "Report Copied to Clipboard!";
          setTimeout(() => {
            copyText.textContent = original;
          }, 3000);
        }
      });
    });

    // Initial calculation
    calculate();
  }

  // Run on initial load and Astro page swaps
  initFreezeDryerModeler();
  document.addEventListener('astro:page-load', initFreezeDryerModeler);
</script>
