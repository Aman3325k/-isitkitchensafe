---

<div class="not-prose my-8 bg-surface border border-hairline rounded-3xl p-6 md:p-8 shadow-sm">
  <div class="space-y-8">
    <!-- Component Header -->
    <div class="border-b border-hairline pb-6">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-amber-500/10 text-amber-800 dark:text-amber-300 mb-3 border border-amber-500/20">
        <span>♨️</span>
        {d.badge}
      </div>
      <h2 class="text-2xl md:text-3xl font-extrabold text-ink tracking-tight mb-2">
        {d.title}
      </h2>
      <p class="text-sm md:text-base text-muted leading-relaxed max-w-4xl">
        {d.subtitle}
      </p>
    </div>

    <!-- Quick Presets -->
    <div class="bg-surface-soft border border-hairline rounded-2xl p-4 md:p-5">
      <div class="text-xs font-bold uppercase tracking-wider text-muted mb-3">
        {d.presetsTitle}
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-2 text-xs">
        <button
          type="button"
          id="preset-gold"
          class="text-left p-3 rounded-xl border border-hairline/70 hover:border-emerald-500/50 hover:bg-emerald-500/5 transition-colors font-medium text-ink flex items-start gap-2"
        >
          <span class="text-emerald-500 font-bold shrink-0">🟢</span>
          <span>{d.presetGoldStandard}</span>
        </button>
        <button
          type="button"
          id="preset-steam-inversion"
          class="text-left p-3 rounded-xl border border-hairline/70 hover:border-amber-500/50 hover:bg-amber-500/5 transition-colors font-medium text-ink flex items-start gap-2"
        >
          <span class="text-amber-500 font-bold shrink-0">🟡</span>
          <span>{d.presetSteamInversion}</span>
        </button>
        <button
          type="button"
          id="preset-failed-quench"
          class="text-left p-3 rounded-xl border border-hairline/70 hover:border-rose-500/50 hover:bg-rose-500/5 transition-colors font-medium text-ink flex items-start gap-2"
        >
          <span class="text-rose-500 font-bold shrink-0">🔴</span>
          <span>{d.presetFailedQuench}</span>
        </button>
        <button
          type="button"
          id="preset-illegal-muriatic"
          class="text-left p-3 rounded-xl border border-hairline/70 hover:border-purple-500/50 hover:bg-purple-500/5 transition-colors font-medium text-ink flex items-start gap-2"
        >
          <span class="text-purple-500 font-bold shrink-0">🟣</span>
          <span>{d.presetIllegalMuriatic}</span>
        </button>
      </div>
    </div>

    <!-- Operational Controls Grid -->
    <div class="bg-surface-soft border border-hairline rounded-2xl p-5 md:p-6 space-y-6">
      <div>
        <h3 class="text-base font-bold text-ink mb-1">{d.controlsTitle}</h3>
        <p class="text-xs text-muted leading-relaxed">{d.controlsSub}</p>
      </div>

