<script is:inline define:vars={{ ovens, descalers, gaskets, scales, vents }}>
  (function() {
    const el = (id) => document.getElementById(id);

    const ovenSelect = el('oven-select');
    const descalerSelect = el('descaler-select');
    const gasketSelect = el('gasket-select');
    const scaleSelect = el('scale-select');
    const ventSelect = el('vent-select');

    const tempSlider = el('temp-slider');
    const concSlider = el('conc-slider');
    const timeSlider = el('time-slider');
    const hoodSlider = el('hood-slider');

    const tempVal = el('temp-val');
    const concVal = el('conc-val');
    const timeVal = el('time-val');
    const hoodVal = el('hood-val');

    const outAirVapor = el('out-air-vapor');
    const outAirVaporSub = el('out-air-vapor-sub');
    const outSteamInversion = el('out-steam-inversion');
    const outSteamInversionSub = el('out-steam-inversion-sub');
    const outGasketLife = el('out-gasket-life');
    const outGasketLifeSub = el('out-gasket-life-sub');
    const outScaleRate = el('out-scale-rate');
    const outScaleRateSub = el('out-scale-rate-sub');
    const outQuenchTemp = el('out-quench-temp');
    const outQuenchTempSub = el('out-quench-temp-sub');
    const outPpeLevel = el('out-ppe-level');
    const outPpeLevelSub = el('out-ppe-level-sub');
    const statusPill = el('status-pill');

    const outPrimaryRisk = el('out-primary-risk');
    const outMechanisms = el('out-mechanisms');
    const outMitigations = el('out-mitigations');

    const copyBtn = el('copy-report-btn');
    const copiedToast = el('copied-toast');

    function calculate() {
      const oven = ovens.find(o => o.id === ovenSelect.value) || ovens[0];
      const desc = descalers.find(d => d.id === descalerSelect.value) || descalers[0];
      const gasket = gaskets.find(g => g.id === gasketSelect.value) || gaskets[0];
      const scale = scales.find(s => s.id === scaleSelect.value) || scales[0];
      const vent = vents.find(v => v.id === ventSelect.value) || vents[0];

      const tempC = parseFloat(tempSlider.value);
      const concPercent = parseFloat(concSlider.value);
      const dwellMins = parseFloat(timeSlider.value);
      const hoodCfm = parseFloat(hoodSlider.value);

      // Display live slider labels
      const tempF = ((tempC * 9/5) + 32).toFixed(1);
      tempVal.textContent = `${tempC.toFixed(1)}°C (${tempF}°F)`;
      concVal.textContent = `${concPercent.toFixed(1)}% w/w`;
      timeVal.textContent = `${Math.round(dwellMins)} min`;
      hoodVal.textContent = `${Math.round(hoodCfm)} CFM`;

      // 1. Steam Inversion & Escaped Vapor Modeling
      // At temp > 100°C, superheated steam generates high gauge pressure
      let steamGenFactor = 0.02;
      if (tempC >= 95) {
        steamGenFactor = Math.pow((tempC - 90) / 10, 2.2) * (oven.boilerPowerKw / 20.0);
      }
      
      // Gasket leakage based on durometer and degraded state
      let gasketSealingQuality = 0.98; // 98% tight
      if (gasket.id === 'degraded_silicone_aged') gasketSealingQuality = 0.25;
      else if (gasket.id === 'food_grade_silicone_vmq') gasketSealingQuality = tempC > 90 ? 0.75 : 0.95;
      else if (gasket.id === 'peroxide_cured_epdm') gasketSealingQuality = 0.94;
      else if (gasket.id === 'fkm_viton_fluoroelastomer') gasketSealingQuality = 0.99;

      const escapedSteamVolumeM3 = Math.max(0.01, ((1 - gasketSealingQuality) * steamGenFactor * (dwellMins / 30) * 1.8));
      const containmentPercent = Math.max(5.0, Math.min(99.9, gasketSealingQuality * 100));

      // 2. Air Vapor / Inhalation Aerosol Concentration Modeling
      // Thermal hydrolysis onset: above 60°C for sulfamic acid, volatilization spikes
      let thermalHydrolysisMultiplier = 1.0;
      if (desc.id === 'sulfamic_acid_tabs' && tempC > 60) {
        thermalHydrolysisMultiplier = 1.0 + Math.pow((tempC - 60) / 12, 1.8);
      } else if (desc.id === 'hydrochloric_muriatic_banned') {
        thermalHydrolysisMultiplier = 28.0; // extreme HCl vaporization
      } else if (desc.id === 'phosphoric_acid_liquid' && tempC > 90) {
        thermalHydrolysisMultiplier = 1.0 + ((tempC - 90) / 15);
      }

      const captureEfficiency = Math.min(0.99, (vent.captureEfficiencyPercent / 100) * (hoodCfm / Math.max(200, vent.exhaustCfm || 300)));
      const spilloverFraction = Math.max(0.01, 1 - captureEfficiency);

      // Base chemical mass generated in mg/sec
      const chemGenRateMgSec = (concPercent / 5.0) * desc.aerosolVolatilityIndex * thermalHydrolysisMultiplier * (escapedSteamVolumeM3 + 0.15) * 8.5;
      const effectiveVentilationRate = Math.max(0.15, (hoodCfm * 0.0004719) + 0.08); // m3/s

      let airborneMgM3 = (chemGenRateMgSec * spilloverFraction) / effectiveVentilationRate;
      airborneMgM3 = Math.max(0.01, Math.min(30.0, airborneMgM3));

      // 3. Gasket Embrittlement & Sealing Health
      let baseGasketCycles = gasket.expectedGasketLifespanCycles;
      let chemicalDegradation = 1.0;
      if (desc.id === 'hydrochloric_muriatic_banned') chemicalDegradation = 0.08;
      else if (desc.id === 'sulfamic_acid_tabs' && gasket.id.includes('silicone')) chemicalDegradation = 0.55;
      else if (desc.id === 'phosphoric_acid_liquid' && gasket.id === 'degraded_silicone_aged') chemicalDegradation = 0.30;
      else if (gasket.id === 'fkm_viton_fluoroelastomer') chemicalDegradation = 0.98;

      const thermalStressElastomer = Math.exp((tempC - 50) / 22);
      const effectiveCycles = Math.max(5, Math.round((baseGasketCycles * chemicalDegradation) / thermalStressElastomer));
      
      let finalShoreA = 60;
      if (gasket.id === 'degraded_silicone_aged') finalShoreA = 88;
      else if (gasket.id === 'food_grade_silicone_vmq') finalShoreA = Math.min(85, Math.round(60 + (tempC > 70 ? (tempC - 70) * 0.25 : 2)));
      else if (gasket.id === 'peroxide_cured_epdm') finalShoreA = Math.min(78, Math.round(70 + (tempC > 90 ? (tempC - 90) * 0.12 : 1)));
      else if (gasket.id === 'fkm_viton_fluoroelastomer') finalShoreA = Math.min(78, Math.round(75 + 1));

      // 4. Calcite Scale Stripping & Dissolution Rate
      let strippingRate = (concPercent / 5.0) * (tempC / 50) * (dwellMins / 30) * 85.0;
      if (scale.id === 'severe_calcite_crust') strippingRate *= 0.82;
      if (scale.id === 'silicate_sulfate_glassy_scale') strippingRate *= 0.45;
      if (desc.id === 'citric_lactic_organic_blend') strippingRate *= 0.65;
      if (desc.id === 'neutralizing_alkaline_buffer') strippingRate = 0.0;
      if (desc.id === 'hydrochloric_muriatic_banned') strippingRate *= 1.35;
      strippingRate = Math.max(5.0, Math.min(99.8, strippingRate));

      // 5. Drain Quench Sewer Discharge Temperature
      // Heat balance between boiler discharge and quench cold water (assumed at 15°C cold municipal inlet)
      const quenchGpm = vent.quenchWaterFlowGpm;
      let drainDischargeTempC = tempC;
      if (quenchGpm > 0) {
        const boilerDrainFlowGpm = 1.2;
        // Weighted temperature blend
        drainDischargeTempC = ((boilerDrainFlowGpm * tempC) + (quenchGpm * 15.0)) / (boilerDrainFlowGpm + quenchGpm);
      }
      drainDischargeTempC = Math.max(18.0, Math.min(tempC, drainDischargeTempC));
      const drainDischargeTempF = ((drainDischargeTempC * 9/5) + 32).toFixed(1);

      // 6. PPE Classification
      let ppeLevel = 'LEVEL 1 (Standard)';
      let ppeSub = 'Splash goggles & nitrile gloves';
      let ppeColor = 'text-emerald-600 dark:text-emerald-400';

      if (airborneMgM3 > desc.oshaPelMgM3 * 2.5 || desc.id === 'hydrochloric_muriatic_banned' || drainDischargeTempC > 80) {
        ppeLevel = 'LEVEL 4 (CRITICAL / ESCAPE)';
        ppeSub = 'Full-face acid gas / P100 respirator, neoprene suit & clear area';
        ppeColor = 'text-purple-600 dark:text-purple-400';
      } else if (airborneMgM3 > desc.oshaPelMgM3 || drainDischargeTempC > 60) {
        ppeLevel = 'LEVEL 3 (RESPIRATOR MANDATORY)';
        ppeSub = 'Half-mask cartridge respirator for acid gas + face shield';
        ppeColor = 'text-rose-600 dark:text-rose-400';
      } else if (airborneMgM3 > desc.oshaPelMgM3 * 0.5) {
        ppeLevel = 'LEVEL 2 (ELEVATED CAUTION)';
        ppeSub = 'N95 mist mask, chemical splash apron, eye protection';
        ppeColor = 'text-amber-600 dark:text-amber-400';
      }

      // UI Updates
      let vaporColor = 'text-emerald-600 dark:text-emerald-400';
      let vaporSub = `OSHA PEL: <${desc.oshaPelMgM3} mg/m³ (Safe)`;
      if (airborneMgM3 > desc.oshaPelMgM3) {
        vaporColor = 'text-rose-600 dark:text-rose-400';
        vaporSub = `VIOLATION: Exceeds OSHA PEL (${desc.oshaPelMgM3} mg/m³) by ${(airborneMgM3 / desc.oshaPelMgM3).toFixed(1)}x`;
      } else if (airborneMgM3 > desc.oshaPelMgM3 * 0.7) {
        vaporColor = 'text-amber-600 dark:text-amber-400';
        vaporSub = `Approaching OSHA PEL (${desc.oshaPelMgM3} mg/m³) threshold`;
      }

      outAirVapor.className = `text-xl font-black font-mono ${vaporColor}`;
      outAirVapor.textContent = `${airborneMgM3.toFixed(2)} mg/m³`;
      outAirVaporSub.textContent = vaporSub;

      let steamColor = 'text-emerald-600 dark:text-emerald-400';
      let steamSub = 'Negative draft containment intact';
      if (containmentPercent < 60) {
        steamColor = 'text-rose-600 dark:text-rose-400';
        steamSub = 'SEVERE BLOWOUT: Gasket failure past door rim';
      } else if (containmentPercent < 90) {
        steamColor = 'text-amber-600 dark:text-amber-400';
        steamSub = 'Moderate steam channeling around door perimeter';
      }
      outSteamInversion.className = `text-xl font-black font-mono ${steamColor}`;
      outSteamInversion.textContent = `${escapedSteamVolumeM3.toFixed(2)} m³ (${containmentPercent.toFixed(1)}% Contained)`;
      outSteamInversionSub.textContent = steamSub;

      let gasketColor = 'text-emerald-600 dark:text-emerald-400';
      let gasketSub = 'Minimal siloxane hydrolysis';
      if (finalShoreA >= 80) {
        gasketColor = 'text-rose-600 dark:text-rose-400';
        gasketSub = 'HARDENED & BRITTLE: Severe steam channeling risk';
      } else if (finalShoreA >= 72) {
        gasketColor = 'text-amber-600 dark:text-amber-400';
        gasketSub = 'Moderate thermal compression set';
      }
      outGasketLife.className = `text-xl font-black font-mono ${gasketColor}`;
      outGasketLife.textContent = `${effectiveCycles} Cycles (${finalShoreA} Shore A)`;
      outGasketLifeSub.textContent = gasketSub;

      outScaleRate.textContent = `${strippingRate.toFixed(1)}% Stripped`;
      outScaleRateSub.textContent = strippingRate > 80 ? 'Complete boiler element passivation' : 'Partial scale removal; repeat cycle required';

      let drainColor = 'text-emerald-600 dark:text-emerald-400';
      let drainSub = 'IPC § 701.7 <60°C (140°F) Compliant';
      if (drainDischargeTempC > 60.0) {
        drainColor = 'text-rose-600 dark:text-rose-400';
        drainSub = `PLUMBING CODE VIOLATION: Exceeds 60°C limit (Risk of PVC melt & steam back-venting)`;
      } else if (drainDischargeTempC > 52.0) {
        drainColor = 'text-amber-600 dark:text-amber-400';
        drainSub = 'Marginal quench cooling margin';
      }
      outQuenchTemp.className = `text-xl font-black font-mono ${drainColor}`;
      outQuenchTemp.textContent = `${drainDischargeTempC.toFixed(1)}°C (${drainDischargeTempF}°F)`;
      outQuenchTempSub.textContent = drainSub;

      outPpeLevel.className = `text-xl font-black font-mono ${ppeColor}`;
      outPpeLevel.textContent = ppeLevel;
      outPpeLevelSub.textContent = ppeSub;

      // Master Status Pill & Qualitative Logic
      if (desc.id === 'hydrochloric_muriatic_banned') {
        statusPill.className = 'px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-purple-500/10 text-purple-800 dark:text-purple-300 border border-purple-500/20';
        statusPill.textContent = 'ILLEGAL CHEMICAL CONTRAINDICATION';
        outPrimaryRisk.textContent = 'Catastrophic chloride-induced stress corrosion cracking (SCC) of 316L stainless steel boiler and toxic hydrogen chloride gas plume (OSHA 5 ppm ceiling breached).';
        outMechanisms.textContent = 'Chloride ions depassivate protective Cr₂O₃ oxide layer within seconds, inducing micro-pitting and lethal volatile HCl gas emission.';
        outMitigations.textContent = 'Immediately abort cycle; flush with cold water; do not breathe vapors; inspect boiler welds with dye-penetrant testing.';
      } else if (airborneMgM3 > desc.oshaPelMgM3 || drainDischargeTempC > 60.0 || containmentPercent < 70) {
        statusPill.className = 'px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-rose-500/10 text-rose-800 dark:text-rose-300 border border-rose-500/20';
        statusPill.textContent = 'HAZARD: OSHA / IPC CODE VIOLATION';
        outPrimaryRisk.textContent = `Worker breathing zone acid concentration exceeds OSHA PEL (${airborneMgM3.toFixed(2)} mg/m³) or drain temperature (${drainDischargeTempC.toFixed(1)}°C) breaches plumbing code threshold.`;
        outMechanisms.textContent = 'Thermal hydrolysis of sulfamic acid above 60°C or quench failure allows superheated steam and caustic aerosols to escape into kitchen standing zones.';
        outMitigations.textContent = 'Immediately lower boiler deliming temperature to 52°C; restore drain quench cold water flow; mandate Level 3 cartridge respirators until area is cleared.';
      } else if (airborneMgM3 > desc.oshaPelMgM3 * 0.7 || finalShoreA >= 75) {
        statusPill.className = 'px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-500/10 text-amber-800 dark:text-amber-300 border border-amber-500/20';
        statusPill.textContent = 'ELEVATED RISK: OPERATIONAL CAUTION';
        outPrimaryRisk.textContent = 'Approaching occupational exposure threshold or door gasket hardening past 75 Shore A, indicating impending steam perimeter seal failure.';
        outMechanisms.textContent = 'High bath temperature accelerates siloxane depolymerization while partial hood capture allows minor aerosol drift toward cook line.';
        outMitigations.textContent = 'Verify exhaust hood airflow exceeds 500 CFM; replace silicone door gasket at next scheduled PM interval; maintain wash bath at 50°C–55°C.';
      } else {
        statusPill.className = 'px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-500/10 text-emerald-800 dark:text-emerald-300 border border-emerald-500/20';
        statusPill.textContent = 'OSHA & NSF COMPLIANT';
        outPrimaryRisk.textContent = 'Controlled automated descaling cycle; acid aerosol emissions well below OSHA PEL limits; drain water safely tempered below municipal plumbing limits.';
        outMechanisms.textContent = 'Controlled bath temperature (50°C–55°C) inhibits thermal hydrolysis of sulfamic acid; active quench prevents boiling acid back-venting through floor drains.';
        outMitigations.textContent = 'Maintain standard operating procedures; perform quarterly door gasket durometer inspections; run alkaline neutralizing rinse cycle after acid dwell.';
      }
    }

    // Presets Handlers
    el('preset-gold').addEventListener('click', () => {
      ovenSelect.value = 'boiler_high_capacity_floor';
      descalerSelect.value = 'sulfamic_acid_tabs';
      gasketSelect.value = 'fkm_viton_fluoroelastomer';
      scaleSelect.value = 'moderate_limescale_layer';
      ventSelect.value = 'dedicated_canopy_active_quench';
      tempSlider.value = 52;
      concSlider.value = 5;
      timeSlider.value = 35;
      hoodSlider.value = 600;
      calculate();
    });

    el('preset-steam-inversion').addEventListener('click', () => {
      ovenSelect.value = 'aged_legacy_combi_unit';
      descalerSelect.value = 'sulfamic_acid_tabs';
      gasketSelect.value = 'degraded_silicone_aged';
      scaleSelect.value = 'severe_calcite_crust';
      ventSelect.value = 'shared_line_hood_standard_quench';
      tempSlider.value = 115;
      concSlider.value = 8;
      timeSlider.value = 50;
      hoodSlider.value = 250;
      calculate();
    });

    el('preset-failed-quench').addEventListener('click', () => {
      ovenSelect.value = 'boiler_countertop_commercial';
      descalerSelect.value = 'sulfamic_acid_tabs';
      gasketSelect.value = 'food_grade_silicone_vmq';
      scaleSelect.value = 'severe_calcite_crust';
      ventSelect.value = 'failed_quench_zero_ventilation';
      tempSlider.value = 95;
      concSlider.value = 6;
      timeSlider.value = 40;
      hoodSlider.value = 0;
      calculate();
    });

    el('preset-illegal-muriatic').addEventListener('click', () => {
      ovenSelect.value = 'institutional_dual_boiler_heavy';
      descalerSelect.value = 'hydrochloric_muriatic_banned';
      gasketSelect.value = 'degraded_silicone_aged';
      scaleSelect.value = 'severe_calcite_crust';
      ventSelect.value = 'failed_quench_zero_ventilation';
      tempSlider.value = 85;
      concSlider.value = 10;
      timeSlider.value = 30;
      hoodSlider.value = 100;
      calculate();
    });

    // Inputs Event Listeners
    [ovenSelect, descalerSelect, gasketSelect, scaleSelect, ventSelect].forEach(sel => {
      sel.addEventListener('change', calculate);
    });

    [tempSlider, concSlider, timeSlider, hoodSlider].forEach(slider => {
      slider.addEventListener('input', calculate);
    });

    // Copy Report Event Listener
    copyBtn.addEventListener('click', () => {
      const data = {
        tool: 'Commercial Combi Oven Boiler Descaling Acid Aerosol & Steam Inversion Modeler',
        version: '2.0.0',
        timestamp: new Date().toISOString(),
        inputs: {
          oven: ovenSelect.value,
          descaler: descalerSelect.value,
          gasket: gasketSelect.value,
          scale: scaleSelect.value,
          ventQuench: ventSelect.value,
          temperatureC: parseFloat(tempSlider.value),
          concentrationPercent: parseFloat(concSlider.value),
          dwellMinutes: parseFloat(timeSlider.value),
          hoodCfm: parseFloat(hoodSlider.value)
        },
        telemetry: {
          airborneAerosolMgM3: outAirVapor.textContent,
          steamInversionVolume: outSteamInversion.textContent,
          gasketLifeShoreA: outGasketLife.textContent,
          scaleStrippingRate: outScaleRate.textContent,
          drainDischargeTemp: outQuenchTemp.textContent,
          ppeLevel: outPpeLevel.textContent,
          status: statusPill.textContent
        }
      };

      navigator.clipboard.writeText(JSON.stringify(data, null, 2)).then(() => {
        copiedToast.classList.remove('hidden');
        setTimeout(() => copiedToast.classList.add('hidden'), 3500);
      });
    });

    // Initial calculation on load
    calculate();
  })();
</script>
