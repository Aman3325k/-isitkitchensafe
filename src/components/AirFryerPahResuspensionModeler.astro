    rule4Text: "在炸篮内放置耐热瓷碗，加入1杯清水与2片鲜柠檬。以180°C运行5分钟。高温水蒸气能迅速水解陈旧油膜，大幅降低清洁阻力。",
    copyReportBtn: "复制气溶胶诊断报告",
    copiedFeedback: "毒理诊断报告已复制至剪贴板！"
  },
  ja: {
    badge: "エアロゾル毒性学＆強制対流熱物理シミュレーター",
    title: "ノンフライヤー多環芳香族炭化水素（PAH）熱分解再飛散＆吸入暴露シミュレーター",
    subtitle: "ノンフライヤーの発熱ヒーターやファンカバーに焼き付いた過去の油汚れが高温対流で熱分解・再飛散する挙動をモデル化し、ベンゾ[a]ピレン（BaP-TEQ）、アクロレイン、PM2.5濃度を算出します。",
    controlsTitle: "ノンフライヤー及び室内環境パラメーター",
    controlsSub: "ヒーター管の汚れ蓄積度、焦げ付き油脂の種類、加熱温度、換気設備、連続調理時間を設定してください。",
    cleanlinessLabel: "ヒーター管の汚れ・焦げ付き蓄積度：",
    cleanlinessHelp: "完全脱脂・新品同様（0g） vs 薄い酸化油膜（0.6g） vs 中度の褐色炭化ニス（2.2g） vs 重度の黒色炭化スラグ（5.8g）。",
    precursorLabel: "焼き付き汚れの主成分油脂タイプ：",
    precursorHelp: "動物性油脂（ベーコン/鶏脂） vs 多価不飽和種子油（キャノーラ/大豆油） vs 照り焼き・甘辛タレ vs 高オレイン酸オリーブ油。",
    tempLabel: "ノンフライヤー設定加熱温度：",
    tempHelp: "150°C（300°F 穏やかな温め直し）〜 220°C（430°F 最大高温グリル）。",
    ventilationLabel: "キッチンの換気扇・排気設備環境：",
    ventilationHelp: "屋外排気型レンジフード（強風量 >350 CFM） vs 室内循環型活性炭フィルター vs 窓の自然換気 vs 密閉・無換気キッチン。",
    durationLabel: "実稼働調理時間（分）：",
    durationHelp: "発熱ヒーターと高速対流ファンが連続通電している合計時間。",
    roomSizeLabel: "キッチンの気積容積（m³）：",
    roomSizeHelp: "キッチンの空気容量（標準的な30 m³ ＝ 約8畳 / 天井高2.5m）。",
    presetsTitle: "実証実験プリセットシナリオ：",
    presetCleanBenchmark: "清浄ヒーター基準比較（新品同様 ＋ 175°C ＋ 屋外排気レンジフード）",
    presetBaconDisaster: "焦げ付きベーコン脂汚染事故（黒色炭化スラグ ＋ 200°C ＋ 密閉無換気）",
    presetApartmentDuctless: "集合住宅循環フィルターの罠（中度ニス ＋ キャノーラ油 ＋ 200°C）",
    presetSugarGlazeFlash: "タレ焦げ熱分解フラッシュ（照り焼きタレ ＋ 220°C ＋ 窓換気）",
    presetWellVentilatedRoast: "高換気安全ロースト（軽微油膜 ＋ オリーブ油 ＋ 175°C ＋ 強排気）",
    diagnosticTitle: "吸入エアロゾル＆微小粒子毒性診断カード",
    diagnosticSub: "室内PM2.5予測濃度、ベンゾ[a]ピレン毒性等量（BaP-TEQ）、アクロレイン発生量、WHOガイドライン基準比をリアルタイム表示。",
    pm25Label: "キッチン室内再飛散PM2.5濃度",
    bapTeqLabel: "ベンゾ[a]ピレン毒性等量（BaP-TEQ）",
    acroleinLabel: "揮発性アクロレイン発生速度",
    whoExceedanceLabel: "WHO 24時間基準値に対する超過倍率",
    airQualityStatusLabel: "室内空気質指数（AQIカテゴリー）",
    respiratoryRiskLabel: "呼吸器への吸入毒性危険度レベル",
    elementHealthLabel: "電熱ニクロムヒーター表面の劣化状態",
    actionProtocolLabel: "推奨される必須洗浄・換気プロトコル",
    scienceTitle: "未清掃ノンフライヤーにおける熱分解とエアロゾル物理",
    scienceSub: "なぜ350°Cのヒーター管と風速5m/sのファンが古い油汚れを有害微粒子へと変えてしまうのか。",
    tableTitle: "ヒーター油汚れ蓄積量と毒性物質排出マトリックス",
    tableSub: "堆積油質量、熱分解再飛散係数、PM2.5排出速度、発がんリスク評価一覧。",
    colCondition: "ヒーター管清掃状態",
    colResidueGrams: "焼き付き油脂質量",
    colResuspension: "再飛散係数",
    colPm25Rate: "PM2.5排出速度",
    colBapTeqRate: "BaP-TEQ毒性収率",
    colVerdict: "吸入リスク評価",
    rulesTitle: "ノンフライヤーの有害エアロゾルを防ぐ鉄則",
    rulesSub: "発熱管の適切なメンテナンスと換気により、発がん性微小粒子の室内拡散を遮断します。",
    rule1Title: "換気のない吊戸棚の下で直接稼働させない",
    rule1Text: "排気口から秒速5〜7mの超微小エアロゾルが室内に直接放出されます。必ず屋外排気型レンジフードの真下で作動させてください。",
    rule2Title: "10回調理ごとに本体を反転させてヒーターを点検・清掃",
    rule2Text: "プラグを抜いて冷めた後、柔らかいタオルの上で本体を逆さまにし、上部ヒーターに黄褐色の油膜が焼き付く前に拭き取ります。",
    rule3Title: "脂分の多い肉料理には耐熱スプラッターガードを使用",
    rule3Text: "ベーコンや手羽先を調理する際は、穴あき耐熱シートを上部に被せ、油滴が350°Cの発熱ヒーターに直接飛び跳ねるのを防ぎます。",
    rule4Title: "5分間のレモン蒸気サイクルで焦げ付きを軟化",
    rule4Text: "耐熱ボウルに水1カップとレモンスライスを入れ、180°Cで5分加熱します。熱水蒸気が頑固な油膜を加水分解し、拭き取りを劇的に容易にします。",
    copyReportBtn: "エアロゾル診断レポートをコピー",
    copiedFeedback: "診断レポートをクリップボードにコピーしました！"
  }
};

const d = DICTIONARY[lang] || DICTIONARY.en;
---

<div class="bg-surface border border-hairline rounded-3xl p-6 md:p-10 shadow-xs mb-12">
  <!-- Title / Badge -->
  <div class="flex flex-wrap items-center justify-between gap-3 mb-6 pb-6 border-b border-hairline">
    <div>
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-amber-500/10 text-amber-950 border border-amber-500/20 mb-2">
        <span>💨</span>
        {d.badge}
      </span>
      <h2 class="text-xl md:text-2xl font-bold text-ink tracking-tight">
        {d.title}
      </h2>
      <p class="text-xs md:text-sm text-muted mt-1 max-w-3xl leading-relaxed">
        {d.subtitle}
      </p>
    </div>
  </div>

  <!-- Presets -->
  <div class="mb-8">
    <div class="text-xs font-bold uppercase tracking-wider text-muted mb-3 flex items-center gap-1.5">
      <span>⚡</span>
      {d.presetsTitle}
    </div>
    <div class="flex flex-wrap gap-2">
      <button type="button" class="preset-btn px-3 py-1.5 text-xs font-medium rounded-xl border border-hairline hover:bg-surface-soft hover:border-amber-500 transition-all text-ink cursor-pointer" data-preset="clean-benchmark">
        {d.presetCleanBenchmark}
      </button>
      <button type="button" class="preset-btn px-3 py-1.5 text-xs font-medium rounded-xl border border-hairline hover:bg-surface-soft hover:border-amber-500 transition-all text-ink cursor-pointer" data-preset="bacon-disaster">
        {d.presetBaconDisaster}
      </button>
      <button type="button" class="preset-btn px-3 py-1.5 text-xs font-medium rounded-xl border border-hairline hover:bg-surface-soft hover:border-amber-500 transition-all text-ink cursor-pointer" data-preset="apartment-ductless">
        {d.presetApartmentDuctless}
      </button>
      <button type="button" class="preset-btn px-3 py-1.5 text-xs font-medium rounded-xl border border-hairline hover:bg-surface-soft hover:border-amber-500 transition-all text-ink cursor-pointer" data-preset="sugar-glaze-flash">
        {d.presetSugarGlazeFlash}
      </button>
      <button type="button" class="preset-btn px-3 py-1.5 text-xs font-medium rounded-xl border border-hairline hover:bg-surface-soft hover:border-amber-500 transition-all text-ink cursor-pointer" data-preset="well-ventilated-roast">
        {d.presetWellVentilatedRoast}
      </button>
    </div>
  </div>

  <!-- Controls Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-10 bg-surface-soft/60 border border-hairline rounded-2xl p-6">
    <!-- Cleanliness Condition -->
    <div>
      <label for="cleanliness-select" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5">
        {d.cleanlinessLabel}
      </label>
      <select id="cleanliness-select" class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-sm font-medium text-ink focus:outline-none focus:ring-2 focus:ring-amber-500">
        {modelData.residueConditions.map(c => (
          <option value={c.id} selected={c.id === 'moderate-crust'}>
            {c.name} ({c.bakedResidueGrams}g)
          </option>
        ))}
      </select>
      <p class="text-[11px] text-muted mt-1 leading-snug">{d.cleanlinessHelp}</p>
    </div>

    <!-- Oil Precursor Type -->
    <div>
      <label for="precursor-select" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5">
        {d.precursorLabel}
      </label>
      <select id="precursor-select" class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-sm font-medium text-ink focus:outline-none focus:ring-2 focus:ring-amber-500">
        {modelData.oilPrecursorTypes.map(p => (
          <option value={p.id} selected={p.id === 'polyunsaturated-seed-oil'}>
            {p.name}
          </option>
        ))}
      </select>
      <p class="text-[11px] text-muted mt-1 leading-snug">{d.precursorHelp}</p>
    </div>

    <!-- Cooking Temperature -->
    <div>
      <label for="temp-select" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5">
        {d.tempLabel}
      </label>
      <select id="temp-select" class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-sm font-medium text-ink focus:outline-none focus:ring-2 focus:ring-amber-500">
        {modelData.cookingTemperatures.map(t => (
          <option value={t.id} selected={t.id === 'temp-200'}>
            {t.tempC}°C ({t.tempF}°F) — {t.kineticAerosolizationRate.split(' ')[0]}
          </option>
        ))}
      </select>
      <p class="text-[11px] text-muted mt-1 leading-snug">{d.tempHelp}</p>
    </div>

    <!-- Ventilation Mode -->
    <div>
      <label for="ventilation-select" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5">
        {d.ventilationLabel}
      </label>
      <select id="ventilation-select" class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-sm font-medium text-ink focus:outline-none focus:ring-2 focus:ring-amber-500">
        {modelData.ventilationModes.map(v => (
          <option value={v.id} selected={v.id === 'recirculating-charcoal-hood'}>
            {v.name}
          </option>
        ))}
      </select>
      <p class="text-[11px] text-muted mt-1 leading-snug">{d.ventilationHelp}</p>
    </div>

    <!-- Cooking Duration Slider -->
    <div>
      <div class="flex justify-between items-center mb-1.5">
        <label for="duration-slider" class="text-xs font-bold uppercase tracking-wider text-ink">
          {d.durationLabel}
        </label>
        <span id="duration-val" class="font-mono text-sm font-bold text-amber-800">20 min</span>
      </div>
      <input id="duration-slider" type="range" min="5" max="45" step="5" value="20" class="w-full accent-amber-600 cursor-pointer" />
      <p class="text-[11px] text-muted mt-1 leading-snug">{d.durationHelp}</p>
    </div>

    <!-- Kitchen Volume Slider -->
    <div>
      <div class="flex justify-between items-center mb-1.5">
        <label for="room-slider" class="text-xs font-bold uppercase tracking-wider text-ink">
          {d.roomSizeLabel}
        </label>
        <span id="room-val" class="font-mono text-sm font-bold text-amber-800">30 m³ (~130 sq ft)</span>
      </div>
      <input id="room-slider" type="range" min="15" max="75" step="5" value="30" class="w-full accent-amber-600 cursor-pointer" />
      <p class="text-[11px] text-muted mt-1 leading-snug">{d.roomSizeHelp}</p>
    </div>
  </div>

  <!-- Scorecard Display -->
  <div class="mb-10">
    <div class="flex items-center justify-between mb-4">
      <div>
        <h3 class="text-base font-bold text-ink uppercase tracking-wider flex items-center gap-2">
          <span>📊</span>
          {d.diagnosticTitle}
        </h3>
        <p class="text-xs text-muted">{d.diagnosticSub}</p>
      </div>
      <button id="copy-btn" type="button" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-xl bg-amber-500/10 text-amber-950 border border-amber-500/30 hover:bg-amber-500/20 transition-all cursor-pointer">
        <span>📋</span>
        <span id="copy-text">{d.copyReportBtn}</span>
      </button>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <!-- Card 1: PM2.5 -->
      <div class="bg-surface-soft border border-hairline rounded-2xl p-5 flex flex-col justify-between">
        <div class="text-xs font-bold text-muted uppercase tracking-wider mb-2">
          {d.pm25Label}
        </div>
        <div class="flex items-baseline gap-2 mb-2">
          <span id="pm25-val" class="text-3xl font-extrabold text-ink font-mono tracking-tight">184.2</span>
          <span class="text-xs font-semibold text-muted">µg/m³</span>
        </div>
        <div id="pm25-badge" class="inline-block px-2.5 py-1 rounded-lg text-xs font-bold uppercase tracking-wider bg-rose-500/15 text-rose-900 border border-rose-500/30 text-center">
          Very Unhealthy (AQI 234)
        </div>
      </div>

      <!-- Card 2: BaP-TEQ -->
      <div class="bg-surface-soft border border-hairline rounded-2xl p-5 flex flex-col justify-between">
        <div class="text-xs font-bold text-muted uppercase tracking-wider mb-2">
          {d.bapTeqLabel}
        </div>
        <div class="flex items-baseline gap-2 mb-2">
          <span id="bap-val" class="text-3xl font-extrabold text-ink font-mono tracking-tight">2.45</span>
          <span class="text-xs font-semibold text-muted">ng/m³</span>
        </div>
        <div id="bap-badge" class="inline-block px-2.5 py-1 rounded-lg text-xs font-bold uppercase tracking-wider bg-amber-500/15 text-amber-900 border border-amber-500/30 text-center">
          2.45x Annual WHO Limit
        </div>
      </div>

      <!-- Card 3: Acrolein Rate -->
      <div class="bg-surface-soft border border-hairline rounded-2xl p-5 flex flex-col justify-between">
        <div class="text-xs font-bold text-muted uppercase tracking-wider mb-2">
          {d.acroleinLabel}
        </div>
        <div class="flex items-baseline gap-2 mb-2">
          <span id="acrolein-val" class="text-3xl font-extrabold text-ink font-mono tracking-tight">1.82</span>
          <span class="text-xs font-semibold text-muted">mg/hr</span>
        </div>
        <div id="acrolein-badge" class="inline-block px-2.5 py-1 rounded-lg text-xs font-bold uppercase tracking-wider bg-orange-500/15 text-orange-900 border border-orange-500/30 text-center">
          Mucosal Irritation Level
        </div>
      </div>

      <!-- Card 4: WHO Exceedance -->
      <div class="bg-surface-soft border border-hairline rounded-2xl p-5 flex flex-col justify-between">
        <div class="text-xs font-bold text-muted uppercase tracking-wider mb-2">
          {d.whoExceedanceLabel}
        </div>
        <div class="flex items-baseline gap-2 mb-2">
          <span id="who-ratio-val" class="text-3xl font-extrabold text-ink font-mono tracking-tight">12.3x</span>
          <span class="text-xs font-semibold text-muted">Above Safe Limit</span>
        </div>
        <div id="threat-badge" class="inline-block px-2.5 py-1 rounded-lg text-xs font-bold uppercase tracking-wider bg-rose-500/15 text-rose-900 border border-rose-500/30 text-center">
          High Respiratory Burden
        </div>
      </div>
    </div>
  </div>

  <!-- Real-time Aerosol Plume Progress Meter -->
  <div class="bg-surface-soft/80 border border-hairline rounded-2xl p-6 mb-10">
    <div class="flex items-center justify-between mb-2">
      <span class="text-xs font-bold uppercase tracking-wider text-ink flex items-center gap-1.5">
        <span>🫁</span>
        {d.respiratoryRiskLabel}
      </span>
      <span id="plume-percent" class="text-xs font-mono font-bold text-rose-900">76% Toxic Resuspension Severity</span>
    </div>
    <div class="w-full bg-surface border border-hairline rounded-full h-3 overflow-hidden">
      <div id="plume-bar" class="h-full bg-gradient-to-r from-emerald-500 via-amber-500 to-rose-600 transition-all duration-500" style="width: 76%;"></div>
    </div>
    <div class="flex justify-between text-[10px] text-muted font-mono mt-1.5">
      <span>0 µg/m³ (Clean Room)</span>
      <span>15 µg/m³ (WHO Safe)</span>
      <span>35 µg/m³ (EPA Standard)</span>
      <span>150 µg/m³ (Unhealthy)</span>
      <span>250+ µg/m³ (Hazardous)</span>
    </div>
  </div>

  <!-- Mandatory Mitigation Protocol Banner -->
  <div class="bg-amber-500/10 border border-amber-500/30 rounded-2xl p-6 mb-10">
    <div class="flex items-start gap-4">
      <div class="text-2xl mt-0.5">⚠️</div>
      <div class="flex-1">
        <h4 class="text-sm font-bold text-ink uppercase tracking-wider mb-1">
          {d.actionProtocolLabel}
        </h4>
        <p id="action-recommendation" class="text-xs md:text-sm text-ink leading-relaxed">
          Moderate carbonized oil crust detected on heating coil. Relocate air fryer directly onto stovetop beneath an outdoor-ducted range hood. Perform an inverted flashlight inspection and run a 5-minute lemon steam cycle before cooking foods for young children or individuals with asthma.
        </p>
      </div>
    </div>
  </div>

  <!-- Comparative Table -->
  <div class="border border-hairline rounded-2xl overflow-hidden mb-10">
    <div class="bg-surface-soft p-4 border-b border-hairline">
      <h3 class="text-sm font-bold text-ink uppercase tracking-wider">
        {d.tableTitle}
      </h3>
      <p class="text-xs text-muted mt-0.5">
        {d.tableSub}
      </p>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="bg-surface-soft/60 border-b border-hairline text-ink font-semibold uppercase tracking-wider">
          <tr>
            <th class="p-3.5">{d.colCondition}</th>
            <th class="p-3.5">{d.colResidueGrams}</th>
            <th class="p-3.5">{d.colResuspension}</th>
            <th class="p-3.5">{d.colPm25Rate}</th>
            <th class="p-3.5">{d.colBapTeqRate}</th>
            <th class="p-3.5">{d.colVerdict}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline text-ink">
          {modelData.residueConditions.map(rc => (
            <tr class="hover:bg-surface-soft/30 transition-colors">
              <td class="p-3.5 font-medium">{rc.name}</td>
              <td class="p-3.5 font-mono">{rc.bakedResidueGrams} g</td>
              <td class="p-3.5 font-mono">{rc.resuspensionMultiplier}x</td>
              <td class="p-3.5 font-mono">{rc.pm25BaselineEmissionUgPerMin} µg/min</td>
              <td class="p-3.5 font-mono">{rc.bapTeqBaselineNgPerMin} ng/min</td>
              <td class="p-3.5">
                <span class={`inline-block px-2 py-0.5 rounded text-[11px] font-semibold ${
                  rc.bakedResidueGrams === 0 ? 'bg-emerald-500/15 text-emerald-950' :
                  rc.bakedResidueGrams < 1.0 ? 'bg-blue-500/15 text-blue-950' :
                  rc.bakedResidueGrams < 3.0 ? 'bg-amber-500/15 text-amber-950' :
                  'bg-rose-500/15 text-rose-950'
                }`}>
                  {rc.smokeGeneration}
                </span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Golden Rules of Air Fryer Safety -->
  <div>
    <div class="mb-4">
      <h3 class="text-sm font-bold text-ink uppercase tracking-wider flex items-center gap-1.5">
        <span>🛡️</span>
        {d.rulesTitle}
      </h3>
      <p class="text-xs text-muted">{d.rulesSub}</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="bg-surface-soft border border-hairline rounded-2xl p-5">
        <h4 class="text-xs font-bold text-amber-950 uppercase tracking-wider mb-1.5 flex items-center gap-1">
          <span>1.</span> {d.rule1Title}
        </h4>
        <p class="text-xs text-muted leading-relaxed">{d.rule1Text}</p>
      </div>
      <div class="bg-surface-soft border border-hairline rounded-2xl p-5">
        <h4 class="text-xs font-bold text-amber-950 uppercase tracking-wider mb-1.5 flex items-center gap-1">
          <span>2.</span> {d.rule2Title}
        </h4>
        <p class="text-xs text-muted leading-relaxed">{d.rule2Text}</p>
      </div>
      <div class="bg-surface-soft border border-hairline rounded-2xl p-5">
        <h4 class="text-xs font-bold text-amber-950 uppercase tracking-wider mb-1.5 flex items-center gap-1">
          <span>3.</span> {d.rule3Title}
        </h4>
        <p class="text-xs text-muted leading-relaxed">{d.rule3Text}</p>
      </div>
      <div class="bg-surface-soft border border-hairline rounded-2xl p-5">
        <h4 class="text-xs font-bold text-amber-950 uppercase tracking-wider mb-1.5 flex items-center gap-1">
          <span>4.</span> {d.rule4Title}
        </h4>
        <p class="text-xs text-muted leading-relaxed">{d.rule4Text}</p>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ modelData, dict: d }}>
  // Client-side simulation logic
  const cleanlinessSelect = document.getElementById('cleanliness-select');
  const precursorSelect = document.getElementById('precursor-select');
  const tempSelect = document.getElementById('temp-select');
  const ventilationSelect = document.getElementById('ventilation-select');
  const durationSlider = document.getElementById('duration-slider');
  const durationVal = document.getElementById('duration-val');
  const roomSlider = document.getElementById('room-slider');
  const roomVal = document.getElementById('room-val');

  const pm25Val = document.getElementById('pm25-val');
  const pm25Badge = document.getElementById('pm25-badge');
  const bapVal = document.getElementById('bap-val');
  const bapBadge = document.getElementById('bap-badge');
  const acroleinVal = document.getElementById('acrolein-val');
  const acroleinBadge = document.getElementById('acrolein-badge');
  const whoRatioVal = document.getElementById('who-ratio-val');
  const threatBadge = document.getElementById('threat-badge');
  const plumeBar = document.getElementById('plume-bar');
  const plumePercent = document.getElementById('plume-percent');
  const actionRec = document.getElementById('action-recommendation');
  const copyBtn = document.getElementById('copy-btn');
  const copyText = document.getElementById('copy-text');

  function calculateSimulation() {
    const cleanId = cleanlinessSelect.value;
    const precId = precursorSelect.value;
    const tempId = tempSelect.value;
    const ventId = ventilationSelect.value;
    const duration = parseFloat(durationSlider.value);
    const roomVolume = parseFloat(roomSlider.value);

    durationVal.textContent = `${duration} min`;
    roomVal.textContent = `${roomVolume} m³ (~${Math.round(roomVolume * 4.3)} sq ft)`;

    const cleanObj = modelData.residueConditions.find(c => c.id === cleanId) || modelData.residueConditions[0];
    const precObj = modelData.oilPrecursorTypes.find(p => p.id === precId) || modelData.oilPrecursorTypes[0];
    const tempObj = modelData.cookingTemperatures.find(t => t.id === tempId) || modelData.cookingTemperatures[0];
    const ventObj = modelData.ventilationModes.find(v => v.id === ventId) || modelData.ventilationModes[0];

    // Mathematical modeling of particulate emission:
    // Base emission rate (ug/min) * residue multiplier * precursor multiplier * temperature factor
    const pm25EmissionRateUgMin = cleanObj.pm25BaselineEmissionUgPerMin * precObj.pm25Multiplier * tempObj.thermalPyrolysisFactor;
    const totalPm25GeneratedUg = pm25EmissionRateUgMin * duration;

    // Fraction retained indoors based on ventilation mode
    const retainedPm25Ug = totalPm25GeneratedUg * ventObj.indoorRetentionFactor;
    // Ambient room concentration (ug/m3) assuming mixing + baseline ambient (10 ug/m3)
    const indoorPm25Conc = Math.round((10 + (retainedPm25Ug / roomVolume)) * 10) / 10;

    // Benzo[a]pyrene Toxic Equivalent Quotient (BaP-TEQ ng/m3)
    const bapEmissionRateNgMin = cleanObj.bapTeqBaselineNgPerMin * precObj.pahMultiplier * tempObj.thermalPyrolysisFactor;
    const totalBapGeneratedNg = bapEmissionRateNgMin * duration;
    const retainedBapNg = totalBapGeneratedNg * ventObj.indoorRetentionFactor;
    const indoorBapTeq = Math.round(((retainedBapNg / roomVolume)) * 100) / 100;

    // Acrolein emission rate (mg/hr)
    const acroleinBaseMgMin = cleanObj.bakedResidueGrams * 0.025 * precObj.acroleinMultiplier * tempObj.thermalPyrolysisFactor;
    const acroleinRateMgHr = Math.round((acroleinBaseMgMin * 60) * 100) / 100;

    // WHO Benchmark Ratio (24-hr guideline = 15 ug/m3)
    const whoRatio = Math.round((indoorPm25Conc / modelData.toxicologicalBenchmarks.whoPm25_24hr_ug_m3) * 10) / 10;

    // Update display values
    pm25Val.textContent = indoorPm25Conc.toFixed(1);
    bapVal.textContent = indoorBapTeq.toFixed(2);
    acroleinVal.textContent = acroleinRateMgHr.toFixed(2);
    whoRatioVal.textContent = `${whoRatio}x`;

    // AQI & Badges
    if (indoorPm25Conc <= 12) {
      pm25Badge.textContent = 'Good (AQI 0–50)';
      pm25Badge.className = 'inline-block px-2.5 py-1 rounded-lg text-xs font-bold uppercase tracking-wider bg-emerald-500/15 text-emerald-900 border border-emerald-500/30 text-center';
    } else if (indoorPm25Conc <= 35.4) {
      pm25Badge.textContent = 'Moderate (AQI 51–100)';
      pm25Badge.className = 'inline-block px-2.5 py-1 rounded-lg text-xs font-bold uppercase tracking-wider bg-amber-500/15 text-amber-900 border border-amber-500/30 text-center';
    } else if (indoorPm25Conc <= 55.4) {
      pm25Badge.textContent = 'Unhealthy for Sensitive (AQI 101–150)';
      pm25Badge.className = 'inline-block px-2.5 py-1 rounded-lg text-xs font-bold uppercase tracking-wider bg-orange-500/15 text-orange-900 border border-orange-500/30 text-center';
    } else if (indoorPm25Conc <= 150.4) {
      pm25Badge.textContent = 'Unhealthy (AQI 151–200)';
      pm25Badge.className = 'inline-block px-2.5 py-1 rounded-lg text-xs font-bold uppercase tracking-wider bg-rose-500/15 text-rose-900 border border-rose-500/30 text-center';
    } else {
      pm25Badge.textContent = 'Hazardous / Toxic (AQI 250+)';
      pm25Badge.className = 'inline-block px-2.5 py-1 rounded-lg text-xs font-bold uppercase tracking-wider bg-purple-500/15 text-purple-900 border border-purple-500/30 text-center';
    }

    if (indoorBapTeq < 1.0) {
      bapBadge.textContent = '< WHO Annual Guideline';
      bapBadge.className = 'inline-block px-2.5 py-1 rounded-lg text-xs font-bold uppercase tracking-wider bg-emerald-500/15 text-emerald-900 border border-emerald-500/30 text-center';
    } else {
      bapBadge.textContent = `${indoorBapTeq}x WHO Annual Limit`;
      bapBadge.className = 'inline-block px-2.5 py-1 rounded-lg text-xs font-bold uppercase tracking-wider bg-rose-500/15 text-rose-900 border border-rose-500/30 text-center';
    }

    if (acroleinRateMgHr < 0.5) {
      acroleinBadge.textContent = 'Negligible Irritation';
      acroleinBadge.className = 'inline-block px-2.5 py-1 rounded-lg text-xs font-bold uppercase tracking-wider bg-emerald-500/15 text-emerald-900 border border-emerald-500/30 text-center';
    } else if (acroleinRateMgHr < 1.5) {
      acroleinBadge.textContent = 'Moderate Respiratory Odor';
      acroleinBadge.className = 'inline-block px-2.5 py-1 rounded-lg text-xs font-bold uppercase tracking-wider bg-amber-500/15 text-amber-900 border border-amber-500/30 text-center';
    } else {
      acroleinBadge.textContent = 'Severe Cough / Stinging Eyes';
      acroleinBadge.className = 'inline-block px-2.5 py-1 rounded-lg text-xs font-bold uppercase tracking-wider bg-rose-500/15 text-rose-900 border border-rose-500/30 text-center';
    }

    // Threat level & Plume bar
    let plumeScore = Math.min(100, Math.round((indoorPm25Conc / 250) * 100));
    plumeBar.style.width = `${Math.max(5, plumeScore)}%`;
    plumePercent.textContent = `${plumeScore}% Airborne Toxicant Intensity`;

    if (plumeScore < 20) {
      threatBadge.textContent = 'Low Respiratory Risk';
      threatBadge.className = 'inline-block px-2.5 py-1 rounded-lg text-xs font-bold uppercase tracking-wider bg-emerald-500/15 text-emerald-900 border border-emerald-500/30 text-center';
    } else if (plumeScore < 50) {
      threatBadge.textContent = 'Moderate Irritant Burden';
      threatBadge.className = 'inline-block px-2.5 py-1 rounded-lg text-xs font-bold uppercase tracking-wider bg-amber-500/15 text-amber-900 border border-amber-500/30 text-center';
    } else {
      threatBadge.textContent = 'Severe Toxic Inhalation Alert';
      threatBadge.className = 'inline-block px-2.5 py-1 rounded-lg text-xs font-bold uppercase tracking-wider bg-rose-500/15 text-rose-900 border border-rose-500/30 text-center';
    }

    // Dynamic Action Recommendation
    if (cleanObj.bakedResidueGrams === 0) {
      actionRec.textContent = 'Optimal air quality. Heating element is pristine. Continue routine maintenance and always keep range hood on while air frying.';
    } else if (cleanObj.bakedResidueGrams < 1.0) {
      actionRec.textContent = 'Light organic film detected. Wipe the cold heating coil with a damp microfiber cloth and ensure kitchen exhaust is running at medium speed.';
    } else if (cleanObj.bakedResidueGrams < 3.0) {
      actionRec.textContent = 'Moderate baked varnish on coil. Relocate appliance directly beneath an outdoor-ducted range hood. Run a 5-minute lemon steam cycle before next use.';
    } else {
      actionRec.textContent = 'CRITICAL RESIDUE BUILDUP: Thick carbonized slag detected. Cease using until deep cleaning is performed. Invert cold appliance, apply baking soda paste, and avoid inhaling pyrolytic smoke plumes.';
    }
  }

  // Presets Handler
  document.querySelectorAll('.preset-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const p = btn.getAttribute('data-preset');
      if (p === 'clean-benchmark') {
        cleanlinessSelect.value = 'pristine-clean';
        precursorSelect.value = 'high-oleic-olive-oil';
        tempSelect.value = 'temp-175';
        ventilationSelect.value = 'ducted-hood-high';
        durationSlider.value = '15';
        roomSlider.value = '30';
      } else if (p === 'bacon-disaster') {
        cleanlinessSelect.value = 'heavy-charred';
        precursorSelect.value = 'animal-tallow-bacon';
        tempSelect.value = 'temp-200';
        ventilationSelect.value = 'closed-unventilated';
        durationSlider.value = '25';
        roomSlider.value = '25';
      } else if (p === 'apartment-ductless') {
        cleanlinessSelect.value = 'moderate-crust';
        precursorSelect.value = 'polyunsaturated-seed-oil';
        tempSelect.value = 'temp-200';
        ventilationSelect.value = 'recirculating-charcoal-hood';
        durationSlider.value = '20';
        roomSlider.value = '30';
      } else if (p === 'sugar-glaze-flash') {
        cleanlinessSelect.value = 'moderate-crust';
        precursorSelect.value = 'sugary-marinade-glaze';
        tempSelect.value = 'temp-220';
        ventilationSelect.value = 'open-window-breeze';
        durationSlider.value = '15';
        roomSlider.value = '30';
      } else if (p === 'well-ventilated-roast') {
        cleanlinessSelect.value = 'light-film';
        precursorSelect.value = 'high-oleic-olive-oil';
        tempSelect.value = 'temp-175';
        ventilationSelect.value = 'ducted-hood-high';
        durationSlider.value = '20';
        roomSlider.value = '35';
      }
      calculateSimulation();
    });
  });

  // Attach event listeners
  [cleanlinessSelect, precursorSelect, tempSelect, ventilationSelect, durationSlider, roomSlider].forEach(el => {
    el.addEventListener('input', calculateSimulation);
    el.addEventListener('change', calculateSimulation);
  });

  // Copy report
  copyBtn.addEventListener('click', () => {
    const reportText = `IsItKitchenSafe Air Fryer PAH Resuspension Diagnostic:
- Element Cleanliness: ${cleanlinessSelect.options[cleanlinessSelect.selectedIndex].text}
- Oil Precursor: ${precursorSelect.options[precursorSelect.selectedIndex].text}
- Temperature: ${tempSelect.options[tempSelect.selectedIndex].text}
- Ventilation Mode: ${ventilationSelect.options[ventilationSelect.selectedIndex].text}
- Cooking Duration: ${durationSlider.value} min
- Kitchen Room Size: ${roomSlider.value} m³
- Predicted PM2.5 Concentration: ${pm25Val.textContent} µg/m³ (${pm25Badge.textContent})
- Benzo[a]pyrene (BaP-TEQ): ${bapVal.textContent} ng/m³
- Acrolein Emission Rate: ${acroleinVal.textContent} mg/hr
- WHO 24h Guideline Exceedance: ${whoRatioVal.textContent}
- Action Guidance: ${actionRec.textContent}`;

    navigator.clipboard.writeText(reportText).then(() => {
      copyText.textContent = dict.copiedFeedback;
      setTimeout(() => {
        copyText.textContent = dict.copyReportBtn;
      }, 2500);
    });
  });

  // Initial calculation
  calculateSimulation();
</script>
