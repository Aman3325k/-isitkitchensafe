          <th class="border border-gray-400 p-2">{ui.printColTip}</th>
        </tr>
      </thead>
      <tbody>
        {localizedFoods.map((f) => (
          <tr>
            <td class="border border-gray-400 p-2 font-bold">{f.name}</td>
            <td class="border border-gray-400 p-2 uppercase">{f.safetyStatus}</td>
            <td class="border border-gray-400 p-2">{f.timeLow || f.timeHigh}</td>
            <td class="border border-gray-400 p-2">{f.recommendation}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <!-- FREQUENTLY ASKED QUESTIONS ACCORDION -->
  <section class="mb-12 rounded-3xl border border-hairline bg-canvas p-6 md:p-8 shadow-xs">
    <h2 class="text-title-lg md:text-headline-sm font-medium text-ink tracking-tight mb-6">
      {ui.faqTitle}
    </h2>
    <div class="space-y-3">
      {localizedFaqs.map((faq, idx) => (
        <details class="group rounded-2xl border border-hairline bg-surface-soft/60 open:bg-surface-soft p-4 transition-colors">
          <summary class="flex items-center justify-between gap-3 text-sm font-bold text-ink cursor-pointer list-none select-none">
            <span>{faq.question}</span>
            <span class="text-xs text-muted group-open:rotate-180 transition-transform font-mono">▼</span>
          </summary>
          <p class="mt-3 text-xs md:text-[13px] text-body leading-relaxed border-t border-hairline/60 pt-3">
            {faq.answer}
          </p>
        </details>
      ))}
    </div>
  </section>

  <!-- METHODOLOGY STRIP -->
  <section class="mb-12 rounded-2xl border border-hairline bg-surface-soft p-5 text-xs text-muted leading-relaxed">
    <h3 class="font-bold text-ink mb-1">{ui.methodologyStripTitle}</h3>
    <p>
      {ui.methodologyStripPrefix}{' '}
      <a href={methodologyUrl} class="underline hover:text-ink font-semibold">
        {ui.methodologyLabel} &rarr;
      </a>
    </p>
  </section>

  <!-- RELATED TOOLS CROSS-LINKING STRIP -->
  <section class="rounded-3xl border border-hairline bg-canvas p-6 md:p-8 shadow-xs">
    <h2 class="text-sm font-bold uppercase tracking-wider text-muted mb-4">
      {ui.relatedHeading}
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <a
        href={instantPotUrl}
        class="p-4 rounded-2xl border border-hairline bg-surface-soft hover:bg-surface-strong/60 transition-colors flex flex-col justify-between"
      >
        <div>
          <span class="text-[10px] font-bold uppercase tracking-wider text-cyan-700 mb-1 block">
            {ui.relatedInstantPotTag}
          </span>
          <h3 class="text-xs font-bold text-ink mb-1">{ui.relatedInstantPotTitle}</h3>
          <p class="text-[11px] text-muted leading-relaxed">{ui.relatedInstantPotDesc}</p>
        </div>
      </a>
      <a
        href={internalTempUrl}
        class="p-4 rounded-2xl border border-hairline bg-surface-soft hover:bg-surface-strong/60 transition-colors flex flex-col justify-between"
      >
        <div>
          <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-700 mb-1 block">
            {ui.relatedTempTag}
          </span>
          <h3 class="text-xs font-bold text-ink mb-1">{ui.relatedTempTitle}</h3>
          <p class="text-[11px] text-muted leading-relaxed">{ui.relatedTempDesc}</p>
        </div>
      </a>
      <a
        href={meatThawingUrl}
        class="p-4 rounded-2xl border border-hairline bg-surface-soft hover:bg-surface-strong/60 transition-colors flex flex-col justify-between"
      >
        <div>
          <span class="text-[10px] font-bold uppercase tracking-wider text-blue-700 mb-1 block">
            {ui.relatedThawTag}
          </span>
          <h3 class="text-xs font-bold text-ink mb-1">{ui.relatedThawTitle}</h3>
          <p class="text-[11px] text-muted leading-relaxed">{ui.relatedThawDesc}</p>
        </div>
      </a>
      <a
        href={kitchenFireUrl}
        class="p-4 rounded-2xl border border-hairline bg-surface-soft hover:bg-surface-strong/60 transition-colors flex flex-col justify-between"
      >
        <div>
          <span class="text-[10px] font-bold uppercase tracking-wider text-red-700 mb-1 block">
            {ui.relatedFireTag}
          </span>
          <h3 class="text-xs font-bold text-ink mb-1">{ui.relatedFireTitle}</h3>
          <p class="text-[11px] text-muted leading-relaxed">{ui.relatedFireDesc}</p>
        </div>
      </a>
    </div>
  </section>
</div>

<script is:inline>
(function() {
  const root = document.getElementById('slow-cooker-checker-root');
  if (!root) return;

  const copyBtn = document.getElementById('scc-copy-btn');
  const copyText = document.getElementById('scc-copy-text');
  const printBtn = document.getElementById('scc-print-btn');
  const liquidDisplay = document.getElementById('scc-liquid-display');
  const frozenAlert = document.getElementById('scc-frozen-alert');
  const switchToThawedBtn = document.getElementById('scc-switch-to-thawed');

  // Inspector Elements
  const activeFoodBadge = document.getElementById('scc-active-food-badge');
  const activeVerdictBadge = document.getElementById('scc-active-verdict-badge');
  const gaugeFillText = document.getElementById('scc-gauge-fill-text');
  const inspectorFillRule = document.getElementById('scc-inspector-fill-rule');
  const inspectorTime = document.getElementById('scc-inspector-time');
  const inspectorHeatTag = document.getElementById('scc-inspector-heat-tag');
  const inspectorTargetTemp = document.getElementById('scc-inspector-target-temp');
  const inspectorPotSize = document.getElementById('scc-inspector-pot-size');
  const inspectorSummary = document.getElementById('scc-inspector-summary');
  const inspectorRecommendation = document.getElementById('scc-inspector-recommendation');

  // State buttons & search
  const stateThawedBtn = document.getElementById('scc-state-thawed');
  const stateFrozenBtn = document.getElementById('scc-state-frozen');
  const searchInput = document.getElementById('scc-search-input');
  const searchClearBtn = document.getElementById('scc-search-clear');
  const emptyState = document.getElementById('scc-empty-state');
  const resetFiltersBtn = document.getElementById('scc-reset-filters-btn');

  const sizeBtns = Array.from(root.querySelectorAll('.scc-size-btn'));
  const heatBtns = Array.from(root.querySelectorAll('.scc-heat-btn'));
  const foodCards = Array.from(root.querySelectorAll('.scc-food-card'));
  const catBtns = Array.from(root.querySelectorAll('.scc-cat-btn'));

  let currentSize = sizeBtns.find(b => b.dataset.sizeId === root.dataset.defaultSizeId) || sizeBtns[1] || sizeBtns[0];
  let currentHeat = heatBtns.find(b => b.dataset.heatId === root.dataset.defaultHeatId) || heatBtns[0];
  let currentFood = foodCards.find(c => c.dataset.foodId === root.dataset.defaultFoodId) || foodCards[0];
  let isFrozen = false;
  let currentCat = 'all';

  function updateInspector() {
    if (!currentFood) return;

    const foodName = currentFood.dataset.foodName || '';
    const isKidneyBean = currentFood.dataset.isKidneyBean === 'true';
    const isFrozenBan = currentFood.dataset.isFrozenBan === 'true';
    const isDairy = currentFood.dataset.isDairy === 'true';
    const isReheatBan = currentFood.dataset.isReheatBan === 'true';

    // Update active badges
    if (activeFoodBadge) activeFoodBadge.textContent = foodName;

    // Determine verdict
    let verdictText = currentFood.dataset.verdict || 'SAFE';
    let verdictClass = 'bg-emerald-700 text-white';

    if (isFrozen) {
      verdictText = 'DANGER — USDA STRICT FROZEN BAN';
      verdictClass = 'bg-red-700 text-white';
    } else if (isKidneyBean) {
      verdictText = 'DANGER WITHOUT PRE-BOIL';
      verdictClass = 'bg-red-700 text-white';
    } else if (isReheatBan) {
      verdictText = 'UNSAFE IN SLOW COOKER — REHEAT ON STOVE';
      verdictClass = 'bg-red-700 text-white';
    } else if (isDairy) {
      verdictText = 'CAUTION — ADD IN FINAL 30 MIN';
      verdictClass = 'bg-amber-600 text-white';
    }

    if (activeVerdictBadge) {
      activeVerdictBadge.textContent = verdictText;
      activeVerdictBadge.className = 'px-3.5 py-1.5 rounded-full text-xs font-bold tracking-wide ' + verdictClass;
    }

    // Time calculations
    const isHigh = currentHeat && currentHeat.dataset.heatId === 'high';
    const isWarm = currentHeat && currentHeat.dataset.heatId === 'warm';
    let timeDisplay = currentFood.dataset.timeLow || '7–8 Hours';

    if (isWarm) {
      timeDisplay = 'Max 2–4 Hours (Hot Food Only)';
      if (inspectorHeatTag) inspectorHeatTag.textContent = 'on WARM';
    } else if (isHigh) {
      timeDisplay = currentFood.dataset.timeHigh || '3–4 Hours';
      if (inspectorHeatTag) inspectorHeatTag.textContent = 'on HIGH';
    } else {
      if (inspectorHeatTag) inspectorHeatTag.textContent = 'on LOW';
    }

    if (inspectorTime) inspectorTime.textContent = timeDisplay;
    if (inspectorTargetTemp) inspectorTargetTemp.textContent = currentFood.dataset.usdaTemp || 'USDA FSIS Safe Simmer';
    if (inspectorPotSize && currentSize) inspectorPotSize.textContent = currentSize.dataset.sizeName || '';

    // Fill rule
    const fillRule = currentFood.dataset.fillRule || 'Between 1/2 and 2/3 full';
    if (gaugeFillText) gaugeFillText.textContent = fillRule;
    if (inspectorFillRule) inspectorFillRule.textContent = fillRule;

    // Safety summary & recommendation
    if (inspectorSummary) {
      if (isFrozen) {
        inspectorSummary.textContent = 'USDA FSIS Warning: Putting frozen meat or poultry directly into a slow cooker causes it to remain in the 40°F–140°F (4°C–60°C) bacterial danger zone for hours. Always thaw in the refrigerator first.';
      } else {
        inspectorSummary.textContent = currentFood.dataset.summary || '';
      }
    }

    if (inspectorRecommendation) {
      if (isFrozen) {
        inspectorRecommendation.textContent = 'Action: Thaw completely in the refrigerator before placing in the slow cooker!';
      } else {
        inspectorRecommendation.textContent = currentFood.dataset.recommendation || '';
      }
    }
  }

  // Size button click
  sizeBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      sizeBtns.forEach(b => {
        b.classList.remove('border-ink', 'bg-surface-soft', 'shadow-xs');
        b.classList.add('border-hairline', 'bg-canvas');
      });
      btn.classList.add('border-ink', 'bg-surface-soft', 'shadow-xs');
      btn.classList.remove('border-hairline', 'bg-canvas');
      currentSize = btn;

      const cups = btn.dataset.minCups;
      const ml = btn.dataset.minMl;
      if (liquidDisplay) {
        liquidDisplay.textContent = cups + ' cup (' + ml + ' mL)';
      }
      updateInspector();
    });
  });

  // Heat button click
  heatBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      heatBtns.forEach(b => {
        b.classList.remove('border-ink', 'bg-surface-soft', 'shadow-xs');
        b.classList.add('border-hairline', 'bg-canvas');
      });
      btn.classList.add('border-ink', 'bg-surface-soft', 'shadow-xs');
      btn.classList.remove('border-hairline', 'bg-canvas');
      currentHeat = btn;
      updateInspector();
    });
  });

  // State toggle
  if (stateThawedBtn && stateFrozenBtn) {
    stateThawedBtn.addEventListener('click', () => {
      isFrozen = false;
      stateThawedBtn.className = 'scc-state-btn px-3 py-1.5 rounded-xl text-xs font-bold border transition-all cursor-pointer bg-emerald-700 text-white border-emerald-700 shadow-xs';
      stateFrozenBtn.className = 'scc-state-btn px-3 py-1.5 rounded-xl text-xs font-bold border transition-all cursor-pointer bg-canvas text-red-700 border-hairline hover:bg-red-50 hover:border-red-400';
      if (frozenAlert) frozenAlert.classList.add('hidden');
      updateInspector();
    });

    stateFrozenBtn.addEventListener('click', () => {
      isFrozen = true;
      stateFrozenBtn.className = 'scc-state-btn px-3 py-1.5 rounded-xl text-xs font-bold border transition-all cursor-pointer bg-red-700 text-white border-red-700 shadow-xs';
      stateThawedBtn.className = 'scc-state-btn px-3 py-1.5 rounded-xl text-xs font-bold border transition-all cursor-pointer bg-canvas text-emerald-700 border-hairline hover:bg-emerald-50 hover:border-emerald-400';
      if (frozenAlert) frozenAlert.classList.remove('hidden');
      updateInspector();
    });
  }

  if (switchToThawedBtn && stateThawedBtn) {
    switchToThawedBtn.addEventListener('click', () => {
      stateThawedBtn.click();
    });
  }

  // Food cards click
  foodCards.forEach(card => {
    card.addEventListener('click', () => {
      foodCards.forEach(c => {
        c.classList.remove('border-ink', 'bg-surface-soft', 'shadow-xs');
        c.classList.add('border-hairline', 'bg-canvas');
      });
      card.classList.add('border-ink', 'bg-surface-soft', 'shadow-xs');
      card.classList.remove('border-hairline', 'bg-canvas');
      currentFood = card;
      updateInspector();

      // Scroll smoothly to inspector if mobile
      if (window.innerWidth < 768) {
        const inspector = document.getElementById('scc-inspector');
        if (inspector) inspector.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    });
  });

  // Category filter
  catBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      catBtns.forEach(b => {
        b.classList.remove('bg-ink', 'text-canvas', 'border-ink');
        b.classList.add('bg-canvas', 'text-ink', 'border-hairline');
      });
      btn.classList.add('bg-ink', 'text-canvas', 'border-ink');
      btn.classList.remove('bg-canvas', 'text-ink', 'border-hairline');
      currentCat = btn.dataset.cat || 'all';
      filterFoods();
    });
  });

  // Search filter
  function filterFoods() {
    const query = (searchInput ? searchInput.value : '').toLowerCase().trim();
    if (searchClearBtn) {
      if (query.length > 0) searchClearBtn.classList.remove('hidden');
      else searchClearBtn.classList.add('hidden');
    }

    let visibleCount = 0;
    foodCards.forEach(card => {
      const foodName = (card.dataset.foodName || '').toLowerCase();
      const summary = (card.dataset.summary || '').toLowerCase();
      const cat = card.dataset.category || '';

      let matchesCat = true;
      if (currentCat === 'meats') {
        matchesCat = cat === 'poultry' || cat === 'beef' || cat === 'pork';
      } else if (currentCat === 'beans') {
        matchesCat = cat === 'beans' || cat === 'grains';
      } else if (currentCat === 'produce') {
        matchesCat = cat === 'produce' || cat === 'soup';
      } else if (currentCat === 'leftovers-dairy') {
        matchesCat = cat === 'dairy' || cat === 'seafood' || cat === 'leftovers';
      }

      const matchesQuery = query.length === 0 || foodName.includes(query) || summary.includes(query);

      if (matchesCat && matchesQuery) {
        card.classList.remove('hidden');
        visibleCount++;
      } else {
        card.classList.add('hidden');
      }
    });

    if (emptyState) {
      if (visibleCount === 0) emptyState.classList.remove('hidden');
      else emptyState.classList.add('hidden');
    }
  }

  if (searchInput) {
    searchInput.addEventListener('input', filterFoods);
  }

  if (searchClearBtn && searchInput) {
    searchClearBtn.addEventListener('click', () => {
      searchInput.value = '';
      filterFoods();
      searchInput.focus();
    });
  }

  if (resetFiltersBtn) {
    resetFiltersBtn.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      if (catBtns[0]) catBtns[0].click();
      filterFoods();
    });
  }

  // Copy Cheat Sheet
  if (copyBtn) {
    copyBtn.addEventListener('click', () => {
      if (!currentFood) return;
      const text = [
        '--- ISITKITCHENSAFE SLOW COOKER SAFETY CHEAT SHEET ---',
        'FOOD: ' + (currentFood.dataset.foodName || ''),
        'SAFETY VERDICT: ' + (currentFood.dataset.verdict || ''),
        'COOKING TIME (LOW): ' + (currentFood.dataset.timeLow || '7–8h'),
        'COOKING TIME (HIGH): ' + (currentFood.dataset.timeHigh || '3–4h'),
        'FILL-LEVEL LIMIT: ' + (currentFood.dataset.fillRule || '1/2 to 2/3 full'),
        'MINIMUM THIN LIQUID: ' + (liquidDisplay ? liquidDisplay.textContent : '1 cup'),
        'SAFETY RECOMMENDATION: ' + (currentFood.dataset.recommendation || ''),
        '',
        'CRITICAL RULES:',
        '1. Never cook raw frozen meat directly in a slow cooker (USDA FSIS).',
        '2. Boil red kidney beans 10–30 min at 212°F before slow cooking (FDA PHA toxin alert).',
        '3. Protect ceramic crock from thermal shock (never add ice-cold liquid to hot crock).'
      ].join('\n');

      navigator.clipboard.writeText(text).then(() => {
        if (copyText) copyText.textContent = 'Copied ✓';
        setTimeout(() => {
          if (copyText) copyText.textContent = 'Copy Slow Cooker Safety Sheet';
        }, 2000);
      });
    });
  }

  // Print
  if (printBtn) {
    printBtn.addEventListener('click', () => {
      window.print();
    });
  }

  // Initialize
  updateInspector();
})();
</script>
