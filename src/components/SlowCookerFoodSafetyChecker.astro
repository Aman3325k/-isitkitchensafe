const ui = UI[lang as SupportedLanguage] || UI.en;
const defaultFood = localizedFoods[0];
const defaultSize = localizedCookerSizes.find((s) => s.isDefault) || localizedCookerSizes[1];
const defaultHeat = localizedHeatSettings[0];
---

<div
  id="slow-cooker-checker-root"
  class="w-full bg-canvas text-ink"
  role="region"
  aria-label={ui.ariaLabel}
  data-lang={lang}
  data-default-food-id={defaultFood.id}
  data-default-size-id={defaultSize.id}
  data-default-heat-id={defaultHeat.id}
>
  <!-- TOP 4 GOLDEN SAFETY RULES BANNER -->
  <section class="mb-10 rounded-3xl border-2 border-hairline/80 bg-surface-soft p-6 md:p-8 shadow-xs">
    <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-700 text-white">
        <span>⚠️</span>
        <span>{safetyBanner.badge}</span>
      </span>
      <div class="flex items-center gap-2 print:hidden">
        <button
          type="button"
          id="scc-copy-btn"
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl border border-hairline bg-canvas hover:bg-surface-strong/60 text-xs font-semibold text-ink shadow-2xs transition-colors cursor-pointer"
        >
          <span id="scc-copy-icon">📋</span>
          <span id="scc-copy-text">{ui.copyBtn}</span>
        </button>
        <button
          type="button"
          id="scc-print-btn"
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl border border-hairline bg-canvas hover:bg-surface-strong/60 text-xs font-semibold text-ink shadow-2xs transition-colors cursor-pointer"
        >
          <span>🖨️</span>
          <span>{ui.printBtn}</span>
        </button>
      </div>
    </div>

    <h2 class="text-title-lg md:text-headline-sm font-medium text-ink tracking-tight mb-2">
      {safetyBanner.headline}
    </h2>
    <p class="text-sm md:text-[15px] text-body leading-relaxed max-w-3xl mb-6">
      {safetyBanner.subline}
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {safetyBanner.rules.map((rule) => (
        <div class="rounded-2xl border border-hairline bg-canvas p-5 shadow-2xs">
          <div class="flex items-start gap-3">
            <span class="text-2xl select-none" aria-hidden="true">{rule.icon}</span>
            <div>
              <h3 class="text-sm font-bold text-ink mb-1.5">{rule.title}</h3>
              <p class="text-xs md:text-[13px] text-body leading-relaxed">{rule.body}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- STEP 1: COOKER SIZE SELECTOR -->
  <section class="mb-8 rounded-3xl border border-hairline bg-canvas p-6 md:p-8 shadow-xs">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-2 mb-4">
      <div>
        <h2 class="text-base md:text-lg font-bold text-ink flex items-center gap-2">
          <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-ink text-canvas text-xs font-bold">1</span>
          <span>{ui.sizeStepLabel}</span>
        </h2>
        <p class="text-xs text-muted mt-1">{ui.sizeStepHint}</p>
      </div>
      <div class="text-xs font-mono px-3 py-1.5 rounded-xl bg-surface-soft border border-hairline text-ink inline-flex items-center gap-2 self-start md:self-auto">
        <span class="text-muted">{ui.minLiquidLabel}</span>
        <strong id="scc-liquid-display" class="text-signature-coral font-bold">
          {defaultSize.minLiquidCups} cup ({defaultSize.minLiquidMl} mL)
        </strong>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5">
      {localizedCookerSizes.map((size) => (
        <button
          type="button"
          class={`scc-size-btn text-left p-4 rounded-2xl border-2 transition-all cursor-pointer ${
            size.isDefault
              ? 'border-ink bg-surface-soft shadow-xs'
              : 'border-hairline bg-canvas hover:border-ink/40 hover:bg-surface-soft/40'
          }`}
          data-size-id={size.id}
          data-min-cups={size.minLiquidCups}
          data-min-ml={size.minLiquidMl}
          data-capacity-qt={size.capacityQt}
          data-size-name={size.name}
        >
          <div class="flex items-center justify-between gap-2 mb-1.5">
            <span class="text-xl" aria-hidden="true">{size.icon}</span>
            <span class="text-[11px] font-mono px-2 py-0.5 rounded-md bg-canvas border border-hairline text-muted">
              {size.servings} servings
            </span>
          </div>
          <h3 class="text-sm font-bold text-ink mb-1">{size.name}</h3>
          <p class="text-xs text-muted leading-relaxed">{size.desc}</p>
        </button>
      ))}
    </div>
  </section>

  <!-- STEP 2: HEAT SETTING & FROZEN STATE TOGGLE -->
  <section class="mb-8 rounded-3xl border border-hairline bg-canvas p-6 md:p-8 shadow-xs">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-5">
      <div>
        <h2 class="text-base md:text-lg font-bold text-ink flex items-center gap-2">
          <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-ink text-canvas text-xs font-bold">2</span>
          <span>{ui.heatStepLabel}</span>
        </h2>
        <p class="text-xs text-muted mt-1">{ui.heatStepHint}</p>
      </div>

      <!-- State Toggle: Thawed vs Frozen -->
      <div class="flex items-center gap-2 bg-surface-soft p-1.5 rounded-2xl border border-hairline self-start md:self-auto">
        <span class="text-xs font-semibold text-muted px-2">{ui.stateLabel}</span>
        <button
          type="button"
          id="scc-state-thawed"
          class="scc-state-btn px-3 py-1.5 rounded-xl text-xs font-bold border transition-all cursor-pointer bg-emerald-700 text-white border-emerald-700 shadow-xs"
          data-state="thawed"
        >
          ✓ {ui.stateThawed}
        </button>
        <button
          type="button"
          id="scc-state-frozen"
          class="scc-state-btn px-3 py-1.5 rounded-xl text-xs font-bold border transition-all cursor-pointer bg-canvas text-red-700 border-hairline hover:bg-red-50 hover:border-red-400"
          data-state="frozen"
        >
          ⚠️ {ui.stateFrozen}
        </button>
      </div>
    </div>

    <!-- Heat Settings Buttons -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5">
      {localizedHeatSettings.map((heat, idx) => (
        <button
          type="button"
          class={`scc-heat-btn text-left p-4 rounded-2xl border-2 transition-all cursor-pointer ${
            idx === 0
              ? 'border-ink bg-surface-soft shadow-xs'
              : 'border-hairline bg-canvas hover:border-ink/40 hover:bg-surface-soft/40'
          }`}
          data-heat-id={heat.id}
          data-heat-name={heat.name}
          data-temp-f={heat.tempF}
          data-temp-c={heat.tempC}
          data-multiplier={heat.hoursMultiplier}
          data-is-warm={heat.isKeepWarm ? 'true' : 'false'}
        >
          <div class="flex items-center justify-between gap-2 mb-1.5">
            <span class="text-lg" aria-hidden="true">{heat.icon}</span>
            <span class={`text-[11px] font-bold px-2 py-0.5 rounded-md ${
              heat.isKeepWarm ? 'bg-red-100 text-red-800' : 'bg-canvas border border-hairline text-ink'
            }`}>
              {heat.badge}
            </span>
          </div>
          <h3 class="text-sm font-bold text-ink mb-1">{heat.name}</h3>
          <p class="text-xs text-muted leading-relaxed">{heat.desc}</p>
        </button>
      ))}
    </div>
  </section>

  <!-- FROZEN STRICT BAN ALERT (DYNAMICALLY SHOWN IF FROZEN SELECTED) -->
  <div
    id="scc-frozen-alert"
    class="hidden mb-8 rounded-3xl border-2 border-red-600 bg-red-50 dark:bg-red-950/40 p-6 md:p-8 text-red-950 dark:text-red-100 shadow-md animate-pulse"
    role="alert"
  >
    <div class="flex items-start gap-4">
      <span class="text-3xl select-none" aria-hidden="true">🚫</span>
      <div>
        <h3 class="text-base md:text-lg font-bold text-red-700 dark:text-red-300 mb-2">
          {ui.frozenWarningTitle}
        </h3>
        <p class="text-sm leading-relaxed mb-4">
          {ui.frozenWarningBody}
        </p>
        <div class="flex flex-wrap items-center gap-3">
          <a
            href={meatThawingUrl}
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-red-700 hover:bg-red-800 text-white text-xs font-bold transition-colors shadow-xs"
          >
            <span>❄️</span>
            <span>{ui.relatedThawTitle}</span>
          </a>
          <button
            type="button"
            id="scc-switch-to-thawed"
            class="px-4 py-2 rounded-xl border border-red-300 dark:border-red-700 bg-white dark:bg-red-900/60 text-red-800 dark:text-red-100 text-xs font-semibold hover:bg-red-100 transition-colors cursor-pointer"
          >
            Switch back to Thawed (Recommended)
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- LIVE SLOW COOKER SAFETY INSPECTOR CARD -->
  <section
    id="scc-inspector"
    class="mb-10 rounded-3xl border-2 border-ink/80 bg-surface-soft p-6 md:p-8 shadow-md"
    aria-live="polite"
  >
    <div class="flex flex-wrap items-center justify-between gap-3 mb-6 pb-4 border-b border-hairline/80">
      <div class="flex items-center gap-2">
        <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-ink text-canvas">
          {ui.inspectorBadge}
        </span>
        <span id="scc-active-food-badge" class="text-xs font-bold text-muted">
          {defaultFood.name}
        </span>
      </div>
      <div id="scc-active-verdict-badge" class="px-3.5 py-1.5 rounded-full text-xs font-bold tracking-wide bg-emerald-700 text-white">
        {defaultFood.verdict}
      </div>
    </div>

    <!-- Inspector Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Left Column: Visual Fill Gauge -->
      <div class="rounded-2xl border border-hairline bg-canvas p-5 shadow-2xs flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between gap-2 mb-2">
            <h3 class="text-xs font-bold uppercase tracking-wider text-muted">
              {ui.fillGaugeHeading}
            </h3>
            <span class="text-xs font-mono font-bold text-emerald-700">1/2–2/3</span>
          </div>
          <p id="scc-gauge-fill-text" class="text-xs text-body mb-4">
            {defaultFood.fillRule}
          </p>

          <!-- Graphic Gauge Bar -->
          <div class="space-y-1.5 my-3">
            <div class="h-6 w-full rounded-xl bg-surface-strong/60 overflow-hidden flex border border-hairline relative">
              <div class="w-1/2 bg-amber-400/80 border-r border-hairline/80 flex items-center justify-center text-[10px] font-bold text-amber-950">
                1/2 MIN
              </div>
              <div class="w-1/6 bg-emerald-500/80 border-r border-hairline/80 flex items-center justify-center text-[10px] font-bold text-white">
                SAFE
              </div>
              <div class="w-1/3 bg-red-400/80 flex items-center justify-center text-[10px] font-bold text-red-950">
                OVERFILL
              </div>
            </div>
            <div class="flex items-center justify-between text-[10px] text-muted font-mono px-1">
              <span>0% ({ui.gaugeEmpty})</span>
              <span>50% ({ui.gaugeHalf})</span>
