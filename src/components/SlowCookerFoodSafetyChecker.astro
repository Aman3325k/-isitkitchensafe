        </div>
      ))}
    </div>
  </section>

  <!-- PRINT-ONLY REFERENCE TABLE -->
  <div class="hidden print:block mb-8">
    <div class="border-b-2 border-black pb-3 mb-4">
      <h2 class="text-lg font-bold">{ui.printTitle}</h2>
      <p class="text-xs text-gray-600">{ui.printSub}</p>
    </div>
    <table class="w-full text-xs text-left border-collapse border border-gray-400">
      <thead>
        <tr class="bg-gray-100">
          <th class="border border-gray-400 p-2">{ui.printColFood}</th>
          <th class="border border-gray-400 p-2">{ui.printColStatus}</th>
