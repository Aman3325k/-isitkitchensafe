---
import rawData from '../data/slow-cooker-food-safety-data.json';
import type { SupportedLanguage } from '../i18n/ui';
import { useTranslatedPath } from '../i18n/utils';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;
const translatePath = useTranslatedPath(lang);

const instantPotUrl = translatePath('/tools/instant-pot-pressure-release-checker/');
const internalTempUrl = translatePath('/tools/internal-cooking-temp-chart/');
const meatThawingUrl = translatePath('/tools/meat-thawing-calculator/');
const kitchenFireUrl = translatePath('/tools/kitchen-fire-emergency-guide/');
const methodologyUrl = translatePath('/methodology/');
const allToolsUrl = translatePath('/tools/');

type SafetyStatus = 'safe' | 'caution' | 'danger';
type CategoryKey = 'beans' | 'poultry' | 'beef' | 'pork' | 'produce' | 'dairy' | 'seafood' | 'grains' | 'soup' | 'leftovers';

interface BannerRule {
  icon: string;
  title: string;
  body: string;
}

interface SafetyBannerData {
  badge: string;
  headline: string;
  subline: string;
  rules: BannerRule[];
}

interface LocalizedCookerSize {
  id: string;
  icon: string;
  capacityQt: number;
  capacityLiters: number;
  minLiquidCups: number;
  minLiquidMl: number;
  servings: string;
  isDefault: boolean;
  name: string;
  shortName: string;
  desc: string;
}

interface LocalizedHeatSetting {
  id: string;
  icon: string;
  tempF: string;
  tempC: string;
  hoursMultiplier: number;
  typicalHours: string;
  isKeepWarm?: boolean;
  name: string;
  shortName: string;
  badge: string;
  desc: string;
}

interface LocalizedFood {
  id: string;
  icon: string;
  category: CategoryKey;
  safetyStatus: SafetyStatus;
  isKidneyBeanToxin?: boolean;
  isFrozenBan?: boolean;
  isDairyLateAdd?: boolean;
  isSeafoodLateAdd?: boolean;
  isGrainLateAdd?: boolean;
  isReheatBan?: boolean;
  freshOrThawedOnly?: boolean;
  usdaTargetTemp?: string;
  timeLow?: string;
  timeHigh?: string;
  name: string;
  shortName: string;
  verdict: string;
  summary: string;
  recommendation: string;
  fillRule: string;
}

const safetyBanner: SafetyBannerData =
  (rawData.safetyBanner as Record<string, SafetyBannerData>)[lang] ||
  rawData.safetyBanner.en;

const localizedCookerSizes: LocalizedCookerSize[] = rawData.cookerSizes.map((item) => {
  const tr = (item.i18n as Record<string, any>)[lang] || item.i18n.en;
  return {
    id: item.id,
    icon: item.icon,
    capacityQt: item.capacityQt,
    capacityLiters: item.capacityLiters,
    minLiquidCups: item.minLiquidCups,
    minLiquidMl: item.minLiquidMl,
    servings: item.servings,
    isDefault: Boolean(item.isDefault),
    name: tr.name,
    shortName: tr.shortName,
    desc: tr.desc
  };
});

const localizedHeatSettings: LocalizedHeatSetting[] = rawData.heatSettings.map((item) => {
  const tr = (item.i18n as Record<string, any>)[lang] || item.i18n.en;
  return {
    id: item.id,
    icon: item.icon,
    tempF: item.tempF,
    tempC: item.tempC,
    hoursMultiplier: item.hoursMultiplier || 1.0,
    typicalHours: item.typicalHours,
    isKeepWarm: Boolean(item.isKeepWarm),
    name: tr.name,
    shortName: tr.shortName,
    badge: tr.badge,
    desc: tr.desc
  };
});

const localizedFoods: LocalizedFood[] = rawData.foods.map((item) => {
  const tr = (item.i18n as Record<string, any>)[lang] || item.i18n.en;
  return {
    id: item.id,
    icon: item.icon,
    category: item.category as CategoryKey,
    safetyStatus: item.safetyStatus as SafetyStatus,
    isKidneyBeanToxin: Boolean(item.isKidneyBeanToxin),
    isFrozenBan: Boolean(item.isFrozenBan),
    isDairyLateAdd: Boolean(item.isDairyLateAdd),
    isSeafoodLateAdd: Boolean(item.isSeafoodLateAdd),
    isGrainLateAdd: Boolean(item.isGrainLateAdd),
    isReheatBan: Boolean(item.isReheatBan),
    freshOrThawedOnly: Boolean(item.freshOrThawedOnly),
    usdaTargetTemp: item.usdaTargetTemp || '',
    timeLow: item.timeLow || '',
    timeHigh: item.timeHigh || '',
    name: tr.name,
    shortName: tr.shortName,
    verdict: tr.verdict,
    summary: tr.summary,
    recommendation: tr.recommendation,
    fillRule: tr.fillRule
  };
});

const thermalRules =
  (rawData.thermalShockRules as Record<string, any>)[lang] ||
  rawData.thermalShockRules.en;

const localizedFaqs =
  (rawData.faqs as Record<string, Array<{ question: string; answer: string }>>)[lang] ||
  rawData.faqs.en;

