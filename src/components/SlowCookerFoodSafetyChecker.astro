  </section>

  <!-- CERAMIC STONEWARE THERMAL SHOCK RULES SECTION -->
  <section class="mb-12 rounded-3xl border border-hairline bg-surface-soft p-6 md:p-8 shadow-xs">
    <div class="flex items-center gap-2 mb-4">
      <span class="text-2xl" aria-hidden="true">🛡️</span>
