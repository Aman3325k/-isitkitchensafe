---
import rawData from '../data/slow-cooker-food-safety-data.json';
import type { SupportedLanguage } from '../i18n/ui';
import { useTranslatedPath } from '../i18n/utils';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;
const translatePath = useTranslatedPath(lang);

const instantPotUrl = translatePath('/tools/instant-pot-pressure-release-checker/');
const meatThawingUrl = translatePath('/tools/meat-thawing-calculator/');
const internalTempUrl = translatePath('/tools/internal-cooking-temp-chart/');
const powerOutageUrl = translatePath('/tools/power-outage-food-safety-checker/');
const methodologyUrl = translatePath('/methodology/');
const allToolsUrl = translatePath('/tools/');

type CategoryKey = 'meats-poultry' | 'beans-veggies' | 'leftovers-dairy' | 'crock-liners';
type VerdictKey = 'safe' | 'caution' | 'unsafe';

interface BannerRule {
  icon: string;
  title: string;
  body: string;
}

interface SafetyBannerData {
  badge: string;
  headline: string;
  subline: string;
  rules: BannerRule[];
}

interface SimFillOption {
  id: string;
  icon: string;
  status: VerdictKey;
  gaugePercent: number;
  shortLabel: string;
  detail: string;
  note: string;
}

interface SimHeatOption {
  id: string;
  icon: string;
  status: VerdictKey;
  tempRange: string;
  shortLabel: string;
  detail: string;
  note: string;
}

interface SimOutageOption {
  id: string;
  icon: string;
  status: VerdictKey;
  shortLabel: string;
  detail: string;
  note: string;
}

interface LocalizedItem {
  id: string;
  icon: string;
  category: CategoryKey;
  verdict: VerdictKey;
  hasUsdaTemp: boolean;
  usdaTemp: string;
  shortName: string;
  name: string;
  verdictBadge: string;
  headline: string;
  usdaRule: string;
  safeAlternative: string;
  tempNote: string;
}

const safetyBanner: SafetyBannerData =
  (rawData.safetyBanner as Record<string, SafetyBannerData>)[lang] ||
  rawData.safetyBanner.en;

const fillOptions: SimFillOption[] = rawData.simulator.fillLevels.map((opt) => {
  const tr = (opt.i18n as Record<string, any>)[lang] || opt.i18n.en;
  return {
    id: opt.id,
    icon: opt.icon,
    status: opt.status as VerdictKey,
    gaugePercent: opt.gaugePercent,
    shortLabel: tr.shortLabel,
    detail: tr.detail,
    note: tr.note
  };
});

const heatOptions: SimHeatOption[] = rawData.simulator.heatSettings.map((opt) => {
  const tr = (opt.i18n as Record<string, any>)[lang] || opt.i18n.en;
  return {
    id: opt.id,
    icon: opt.icon,
    status: opt.status as VerdictKey,
    tempRange: opt.tempRange,
    shortLabel: tr.shortLabel,
    detail: tr.detail,
    note: tr.note
  };
});

const outageOptions: SimOutageOption[] = rawData.simulator.powerOutages.map((opt) => {
  const tr = (opt.i18n as Record<string, any>)[lang] || opt.i18n.en;
  return {
    id: opt.id,
    icon: opt.icon,
    status: opt.status as VerdictKey,
    shortLabel: tr.shortLabel,
    detail: tr.detail,
    note: tr.note
  };
});

const simVerdicts: Record<string, string> =
  (rawData.simulator.verdictTemplates as Record<string, Record<string, string>>)[lang] ||
  rawData.simulator.verdictTemplates.en;

const localizedItems: LocalizedItem[] = rawData.items.map((item) => {
  const tr = (item.i18n as Record<string, any>)[lang] || item.i18n.en;
  return {
    id: item.id,
    icon: item.icon,
    category: item.category as CategoryKey,
    verdict: item.verdict as VerdictKey,
    hasUsdaTemp: Boolean(item.hasUsdaTemp),
    usdaTemp: item.usdaTemp || '',
    shortName: tr.shortName,
    name: tr.name,
    verdictBadge: tr.verdictBadge,
    headline: tr.headline,
    usdaRule: tr.usdaRule,
    safeAlternative: tr.safeAlternative,
    tempNote: tr.tempNote
  };
});

const localizedFaqs: Array<{ question: string; answer: string }> =
  (rawData.faqs as Record<string, Array<{ question: string; answer: string }>>)[lang] ||
  rawData.faqs.en;

