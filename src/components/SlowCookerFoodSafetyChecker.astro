    <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 mb-6">
      <div>
        <h2 class="text-base md:text-lg font-bold text-ink flex items-center gap-2">
          <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-ink text-canvas text-xs font-bold">3</span>
