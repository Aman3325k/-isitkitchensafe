    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {thermalRules.rules.map((rule: any) => (
        <div class="rounded-2xl border border-hairline bg-canvas p-5 shadow-2xs flex flex-col justify-between">
          <div class="mb-3">
            <span class="inline-block text-[10px] font-bold uppercase tracking-wider text-emerald-700 bg-emerald-50 dark:bg-emerald-950/60 px-2 py-0.5 rounded mb-1">
              ✓ {ui.thermalDo}
            </span>
            <p class="text-xs md:text-[13px] text-body leading-relaxed">{rule.do}</p>
          </div>
          <div class="pt-3 border-t border-hairline/60">
            <span class="inline-block text-[10px] font-bold uppercase tracking-wider text-red-700 bg-red-50 dark:bg-red-950/60 px-2 py-0.5 rounded mb-1">
              ✕ {ui.thermalDont}
            </span>
            <p class="text-xs md:text-[13px] text-body leading-relaxed">{rule.dont}</p>
