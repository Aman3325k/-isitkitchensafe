    diagnosticSub: "黄身中心の過熱温度、水蒸気ゲージ圧、衝撃波音圧レベル、飛散初速度をリアルタイム算出。",
    peakYolkTempLabel: "黄身中心の過熱ピーク温度",
    vaporPressureLabel: "内部水蒸気ゲージ圧力",
    acousticBlastLabel: "衝撃波音圧（デシベル）",
    ejectionVelocityLabel: "高温破片の飛散初速度",
    explosionRiskLabel: "キャビテーション爆発危険度",
    clinicalBurnLabel: "重度熱傷および眼球損傷リスク",
    safetyStatusLabel: "熱力学的相状態",
    actionProtocolLabel: "必須安全基準＆応急処置プロトコル",
    physicsTitle: "誘電加熱とキャビテーション突沸のメカニズム",
    physicsSub: "なぜ卵黄内の水分は100°Cを超えて過熱し、刺激によって1,600倍の体積膨張を起こすのか。",
    tableTitle: "電子レンジ加熱卵の調理形態別安全性マトリックス",
    tableSub: "950W標準レンジ加熱時の熱物理的挙動と爆発リスクの比較。",
    colPrep: "調理形態",
    colDielectric: "誘電損失・昇温率",
    colPressure: "耐圧限界",
    colAcoustic: "破裂音圧 (dB SPL)",
    colVerdict: "安全判定",
    rulesTitle: "電子レンジ卵調理の黄金ルール",
    rulesSub: "米国音響学会および眼科臨床研究に基づく顔面熱傷防止ガイドライン。",
    rule1Title: "殻付き卵は絶対にレンジ加熱禁止",
    rule1Text: "炭酸カルシウムの殻は密閉圧力容器です。内部蒸気圧が限界に達すると脆性破裂を起こし、レンジの扉を吹き飛ばします。",
    rule2Title: "殻をむいた固ゆで卵も丸ごと加熱禁止",
    rule2Text: "殻がなくても、凝固白身と卵黄膜が105°C以上の過熱水分を閉じ込めます。フォークを刺した瞬間に爆発します。",
    rule3Title: "必ず爪楊枝で黄身と白身に3〜4箇所穴を開ける",
    rule3Text: "爪楊枝で深くまで穴を開けることで膜の張力を破壊し、気化蒸気が穏やかに逃げる逃げ道を作ります。",
    rule4Title: "応急手当：直ちに流水で15分間冷却",
    rule4Text: "万が一爆発した場合は、目をこすらず直ちに冷たい流水で顔と目を15分間洗浄し、救急眼科を受診してください。",
    copyReportBtn: "事故物理シミュレーション報告書をコピー",
    copiedFeedback: "報告書をクリップボードにコピーしました！"
  }
};

const d = DICTIONARY[lang] || DICTIONARY.en;
---

<div class="bg-surface-soft border border-hairline rounded-3xl p-6 md:p-10 shadow-xs mb-12" id="egg-simulator-app">
  <!-- Header Badge -->
  <div class="flex flex-wrap items-center justify-between gap-4 mb-6 pb-6 border-b border-hairline">
    <div class="flex items-center gap-2">
      <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-amber-500/10 text-amber-950 font-bold text-base border border-amber-500/20">
        🥚
      </span>
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-amber-950 block">{d.badge}</span>
        <h2 class="text-xl md:text-2xl font-extrabold text-ink tracking-tight">{d.title}</h2>
      </div>
    </div>
    <div class="flex items-center gap-2">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-950 border border-emerald-500/20">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        ASA / FSIS Kinetic Physics Engine
      </span>
    </div>
  </div>

  <p class="text-sm md:text-base text-muted leading-relaxed mb-8">
    {d.subtitle}
  </p>

  <!-- Interactive Presets -->
  <div class="mb-10 bg-surface border border-hairline rounded-2xl p-5 md:p-6 shadow-2xs">
    <div class="text-xs font-bold uppercase tracking-wider text-muted mb-3 flex items-center gap-2">
      <span>⚡</span> {d.presetsTitle}
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2.5">
      <button 
        type="button" 
        class="preset-btn text-left p-3 rounded-xl border border-rose-500/30 bg-rose-500/5 hover:bg-rose-500/10 text-ink text-xs font-medium transition-all flex flex-col justify-between"
        data-prep="boiled-whole" 
        data-wattage="standard-900w" 
        data-start="refrigerated" 
        data-duration="35" 
        data-trigger="fork-tine"
      >
        <span class="font-bold text-rose-950 mb-1">🏢 {d.presetBreakroom}</span>
        <span class="text-[11px] text-muted">950W • 35s • Fork Puncture Shockwave</span>
      </button>

      <button 
        type="button" 
        class="preset-btn text-left p-3 rounded-xl border border-red-500/30 bg-red-500/5 hover:bg-red-500/10 text-ink text-xs font-medium transition-all flex flex-col justify-between"
        data-prep="raw-shell" 
        data-wattage="standard-900w" 
        data-start="room-temp" 
        data-duration="45" 
        data-trigger="in-microwave-rupture"
      >
        <span class="font-bold text-red-950 mb-1">💣 {d.presetShellBomb}</span>
        <span class="text-[11px] text-muted">950W • 45s • Shell Brittle Shrapnel Blast</span>
      </button>

      <button 
        type="button" 
        class="preset-btn text-left p-3 rounded-xl border border-purple-500/30 bg-purple-500/5 hover:bg-purple-500/10 text-ink text-xs font-medium transition-all flex flex-col justify-between"
        data-prep="boiled-whole" 
        data-wattage="standard-900w" 
        data-start="room-temp" 
        data-duration="30" 
        data-trigger="tooth-bite"
      >
        <span class="font-bold text-purple-950 mb-1">👄 {d.presetOralBite}</span>
        <span class="text-[11px] text-muted">950W • 30s • Direct Oral Cavitation Scald</span>
      </button>

      <button 
        type="button" 
        class="preset-btn text-left p-3 rounded-xl border border-emerald-500/30 bg-emerald-500/5 hover:bg-emerald-500/10 text-ink text-xs font-medium transition-all flex flex-col justify-between"
        data-prep="water-poached" 
        data-wattage="medium-600w" 
        data-start="refrigerated" 
        data-duration="45" 
        data-trigger="fork-tine"
      >
        <span class="font-bold text-emerald-950 mb-1">💧 {d.presetVentedPoach}</span>
        <span class="text-[11px] text-muted">600W • 45s • Submerged Water Buffer</span>
      </button>

      <button 
        type="button" 
        class="preset-btn text-left p-3 rounded-xl border border-blue-500/30 bg-blue-500/5 hover:bg-blue-500/10 text-ink text-xs font-medium transition-all flex flex-col justify-between"
        data-prep="beaten-scrambled" 
        data-wattage="standard-900w" 
        data-start="refrigerated" 
        data-duration="50" 
        data-trigger="fork-tine"
      >
        <span class="font-bold text-blue-950 mb-1">🍳 {d.presetScrambled}</span>
        <span class="text-[11px] text-muted">950W • 50s • Fully Emulsified Zero Blast</span>
      </button>
    </div>
  </div>

  <!-- Main Grid: Controls + Live Scorecard -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-10">
    <!-- Controls Column (7 cols) -->
    <div class="lg:col-span-7 space-y-6">
      <div class="bg-surface border border-hairline rounded-2xl p-6 shadow-2xs">
        <h3 class="text-base font-bold text-ink mb-1">{d.controlsTitle}</h3>
        <p class="text-xs text-muted mb-6">{d.controlsSub}</p>

        <!-- Control 1: Preparation -->
        <div class="mb-5">
          <label for="egg-prep-select" class="block text-xs font-bold text-ink uppercase tracking-wider mb-2">
            {d.prepLabel}
          </label>
          <select 
            id="egg-prep-select" 
            class="w-full bg-surface-soft border border-hairline rounded-xl px-4 py-2.5 text-sm text-ink font-medium focus:ring-2 focus:ring-amber-500 focus:outline-hidden transition-all"
          >
            {modelData.eggPreparations.map(p => (
              <option value={p.id} selected={p.id === 'boiled-whole'}>
                {p.name}
              </option>
            ))}
          </select>
          <p class="text-[11px] text-muted mt-1.5" id="prep-help-text">
            {d.prepHelp}
          </p>
        </div>

        <!-- Control 2: Microwave Wattage -->
        <div class="mb-5">
          <label for="egg-wattage-select" class="block text-xs font-bold text-ink uppercase tracking-wider mb-2">
            {d.wattageLabel}
          </label>
          <select 
            id="egg-wattage-select" 
            class="w-full bg-surface-soft border border-hairline rounded-xl px-4 py-2.5 text-sm text-ink font-medium focus:ring-2 focus:ring-amber-500 focus:outline-hidden transition-all"
          >
            {modelData.microwaveWattage.map(w => (
              <option value={w.id} selected={w.id === 'standard-900w'}>
                {w.name}
              </option>
            ))}
          </select>
          <p class="text-[11px] text-muted mt-1.5">
            {d.wattageHelp}
          </p>
        </div>

        <!-- Control 3: Starting Temp & Trigger Mechanism (2 cols) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-5">
          <div>
            <label for="egg-start-temp" class="block text-xs font-bold text-ink uppercase tracking-wider mb-2">
              {d.startTempLabel}
            </label>
            <select 
              id="egg-start-temp" 
              class="w-full bg-surface-soft border border-hairline rounded-xl px-4 py-2.5 text-sm text-ink font-medium focus:ring-2 focus:ring-amber-500 focus:outline-hidden transition-all"
            >
              {modelData.startingTemperatures.map(st => (
                <option value={st.id} selected={st.id === 'refrigerated'}>
                  {st.name}
                </option>
              ))}
            </select>
            <p class="text-[11px] text-muted mt-1.5">
              {d.startTempHelp}
            </p>
          </div>

          <div>
            <label for="egg-trigger-select" class="block text-xs font-bold text-ink uppercase tracking-wider mb-2">
              {d.triggerLabel}
            </label>
            <select 
              id="egg-trigger-select" 
              class="w-full bg-surface-soft border border-hairline rounded-xl px-4 py-2.5 text-sm text-ink font-medium focus:ring-2 focus:ring-amber-500 focus:outline-hidden transition-all"
            >
              {modelData.triggerMechanisms.map(tm => (
                <option value={tm.id} selected={tm.id === 'fork-tine'}>
                  {tm.name}
                </option>
              ))}
            </select>
            <p class="text-[11px] text-muted mt-1.5">
              {d.triggerHelp}
            </p>
          </div>
        </div>

        <!-- Control 4: Heating Duration Slider -->
        <div class="pt-2 border-t border-hairline">
          <div class="flex items-center justify-between mb-2">
            <label for="egg-duration-range" class="text-xs font-bold text-ink uppercase tracking-wider">
              {d.durationLabel}
            </label>
            <span class="text-sm font-mono font-bold text-amber-950 bg-amber-500/10 px-2.5 py-0.5 rounded-md border border-amber-500/20" id="duration-display">
              35s
            </span>
          </div>
          <input 
            type="range" 
            id="egg-duration-range" 
            min="10" 
            max="90" 
            step="5" 
            value="35" 
            class="w-full accent-amber-600 cursor-pointer"
          />
          <div class="flex justify-between text-[10px] text-muted font-mono mt-1">
            <span>10s (Lukewarm)</span>
            <span>30s (Superheat Danger)</span>
            <span>60s (Critical Pressure)</span>
            <span>90s (Max Cook)</span>
          </div>
          <p class="text-[11px] text-muted mt-2">
            {d.durationHelp}
          </p>
        </div>
      </div>
    </div>

    <!-- Live Diagnostic Scorecard Column (5 cols) -->
    <div class="lg:col-span-5 space-y-6">
      <div class="bg-surface border border-hairline rounded-2xl p-6 shadow-2xs relative overflow-hidden flex flex-col justify-between h-full">
        <!-- Top Status Pill -->
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-bold uppercase tracking-wider text-muted">{d.diagnosticTitle}</span>
            <span class="text-xs px-2.5 py-0.5 rounded-full font-bold uppercase tracking-wider" id="status-pill">
              Calculating...
            </span>
          </div>

          <!-- Primary Metric: Peak Yolk Temperature -->
          <div class="mb-5 bg-surface-soft border border-hairline rounded-xl p-4 text-center">
            <div class="text-xs text-muted font-medium mb-1">{d.peakYolkTempLabel}</div>
            <div class="text-3xl md:text-4xl font-extrabold font-mono tracking-tight text-ink" id="peak-yolk-temp">
              --
            </div>
            <div class="text-[11px] font-medium mt-1" id="superheat-flag">
              Checking liquid superheat state...
            </div>
          </div>

          <!-- Secondary Grid: Pressure, Sound, Velocity -->
          <div class="grid grid-cols-2 gap-3 mb-5">
            <div class="bg-surface-soft border border-hairline rounded-xl p-3 text-center">
              <div class="text-[11px] text-muted mb-0.5">{d.vaporPressureLabel}</div>
              <div class="text-xl font-bold font-mono text-ink" id="vapor-pressure-val">--</div>
              <div class="text-[10px] text-muted" id="vapor-kpa-val">--</div>
            </div>

            <div class="bg-surface-soft border border-hairline rounded-xl p-3 text-center">
              <div class="text-[11px] text-muted mb-0.5">{d.acousticBlastLabel}</div>
              <div class="text-xl font-bold font-mono text-ink" id="acoustic-blast-val">--</div>
              <div class="text-[10px] text-muted">at 30 cm distance</div>
            </div>

            <div class="bg-surface-soft border border-hairline rounded-xl p-3 text-center">
              <div class="text-[11px] text-muted mb-0.5">{d.ejectionVelocityLabel}</div>
              <div class="text-xl font-bold font-mono text-ink" id="ejection-velocity-val">--</div>
              <div class="text-[10px] text-muted" id="ejection-mph-val">--</div>
            </div>

            <div class="bg-surface-soft border border-hairline rounded-xl p-3 text-center">
              <div class="text-[11px] text-muted mb-0.5">{d.explosionRiskLabel}</div>
              <div class="text-xs font-extrabold uppercase tracking-wider" id="explosion-risk-val">--</div>
              <div class="text-[10px] text-muted" id="flash-odds-val">--</div>
            </div>
          </div>

          <!-- Clinical Burn Risk Banner -->
          <div class="border rounded-xl p-3.5 mb-5 text-xs" id="clinical-burn-box">
            <div class="font-bold mb-1 flex items-center gap-1.5">
              <span>🩺</span>
              <span id="clinical-burn-title">{d.clinicalBurnLabel}</span>
            </div>
            <p class="text-[11px] leading-relaxed" id="clinical-burn-desc">
              Evaluating clinical burn depth and corneal epithelial risk...
            </p>
          </div>
        </div>

        <!-- Action / Copy Button -->
        <div class="pt-4 border-t border-hairline">
          <button 
            type="button" 
            id="copy-report-btn" 
            class="w-full py-2.5 px-4 rounded-xl bg-amber-700 hover:bg-amber-800 text-white font-medium text-xs transition-colors flex items-center justify-center gap-2 shadow-xs"
          >
            <span>📋</span>
            <span id="copy-btn-text">{d.copyReportBtn}</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Educational Physics & Mechanism Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
    <div class="bg-surface border border-hairline rounded-2xl p-6">
      <h3 class="text-base font-bold text-ink mb-3 flex items-center gap-2">
        <span>🔬</span> {d.physicsTitle}
      </h3>
      <p class="text-xs md:text-sm text-muted leading-relaxed mb-4">
        Microwaves (2.45 GHz) excite polar water molecules and ionic dissolved salts. The egg yolk contains ~30% emulsified lipids and high mineral ions (phosphorus, sodium), giving it a higher dielectric loss tangent than the surrounding white. Consequently, microwave power deposits volumetrically in the center yolk.
      </p>
      <div class="bg-surface-soft border border-hairline rounded-xl p-3.5 font-mono text-[11px] space-y-1 text-ink">
        <div><strong>Phase Transition:</strong> Liquid H2O → Saturated Steam (1,600x expansion)</div>
        <div><strong>Superheated State:</strong> Yolk reaches 105°C–120°C with 0 nucleation sites</div>
        <div><strong>Trigger Mechanism:</strong> Fork tine induces heterogeneous cavitation flash</div>
      </div>
    </div>

    <div class="bg-surface border border-hairline rounded-2xl p-6">
      <h3 class="text-base font-bold text-ink mb-3 flex items-center gap-2">
        <span>⚠️</span> {d.actionProtocolLabel}
      </h3>
      <p class="text-xs md:text-sm text-muted leading-relaxed mb-4">
        Acoustical Society of America (ASA) and British Journal of Ophthalmology clinical reviews confirm that microwaved hard-boiled egg explosions cause traumatic anterior uveitis, corneal epithelial loss, and acute second-degree facial burns.
      </p>
      <ul class="text-xs text-muted space-y-2 list-disc list-inside">
        <li><strong>Immediate First Aid:</strong> Irrigate skin and eyes with clean cool water for 15 minutes.</li>
        <li><strong>Ophthalmology Referral:</strong> Never rub eyes; seek emergency corneal fluorescence staining.</li>
        <li><strong>Prevention:</strong> Scramble eggs thoroughly or pierce yolks 3–4 times before cooking.</li>
      </ul>
    </div>
  </div>

  <!-- Comparison Matrix Table -->
  <div class="bg-surface border border-hairline rounded-2xl p-6 mb-12 overflow-x-auto shadow-2xs">
    <h3 class="text-base font-bold text-ink mb-1">{d.tableTitle}</h3>
    <p class="text-xs text-muted mb-5">{d.tableSub}</p>

    <table class="w-full text-left text-xs border-collapse">
      <thead>
        <tr class="border-b border-hairline text-muted uppercase tracking-wider text-[11px]">
          <th class="py-3 px-3">{d.colPrep}</th>
          <th class="py-3 px-3">{d.colDielectric}</th>
          <th class="py-3 px-3">{d.colPressure}</th>
          <th class="py-3 px-3">{d.colAcoustic}</th>
          <th class="py-3 px-3">{d.colVerdict}</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-hairline">
        <tr class="hover:bg-surface-soft/60 transition-colors">
          <td class="py-3 px-3 font-semibold text-ink">Raw Whole Egg in Shell</td>
          <td class="py-3 px-3 text-muted">Rapid central yolk boiling</td>
          <td class="py-3 px-3 font-mono font-medium text-rose-950">35.0 PSI (Shell Brittle Limit)</td>
          <td class="py-3 px-3 font-mono">125–133 dB SPL</td>
          <td class="py-3 px-3"><span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-500/10 text-rose-950 border border-rose-500/20">NEVER MICROWAVE</span></td>
        </tr>
        <tr class="hover:bg-surface-soft/60 transition-colors">
          <td class="py-3 px-3 font-semibold text-ink">Peeled Whole Boiled Egg</td>
          <td class="py-3 px-3 text-muted">Severe yolk superheat (110°C–120°C)</td>
          <td class="py-3 px-3 font-mono font-medium text-rose-950">26.0 PSI (Rubbery White Mantle)</td>
          <td class="py-3 px-3 font-mono">105–115 dB SPL</td>
          <td class="py-3 px-3"><span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-500/10 text-rose-950 border border-rose-500/20">EXTREME DANGER</span></td>
        </tr>
        <tr class="hover:bg-surface-soft/60 transition-colors">
          <td class="py-3 px-3 font-semibold text-ink">Raw Egg (Unpierced Yolk)</td>
          <td class="py-3 px-3 text-muted">Central volumetric hot spot</td>
          <td class="py-3 px-3 font-mono font-medium text-amber-950">14.0 PSI (Vitelline Membrane)</td>
          <td class="py-3 px-3 font-mono">86–95 dB SPL</td>
          <td class="py-3 px-3"><span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-500/10 text-amber-950 border border-amber-500/20">HIGH RISK</span></td>
        </tr>
        <tr class="hover:bg-surface-soft/60 transition-colors">
          <td class="py-3 px-3 font-semibold text-ink">Pierced Yolk (Toothpick Vented)</td>
          <td class="py-3 px-3 text-muted">Continuous vapor bleed-off</td>
          <td class="py-3 px-3 font-mono font-medium text-emerald-950">&lt; 2.0 PSI (Vented Voids)</td>
          <td class="py-3 px-3 font-mono">&lt; 40 dB SPL</td>
          <td class="py-3 px-3"><span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/10 text-emerald-950 border border-emerald-500/20">SAFE WITH VENTS</span></td>
        </tr>
        <tr class="hover:bg-surface-soft/60 transition-colors">
          <td class="py-3 px-3 font-semibold text-ink">Scrambled / Whisked Emulsion</td>
          <td class="py-3 px-3 text-muted">Uniform conductive distribution</td>
          <td class="py-3 px-3 font-mono font-medium text-emerald-950">0.0 PSI (Zero Membrane)</td>
          <td class="py-3 px-3 font-mono">0 dB SPL</td>
          <td class="py-3 px-3"><span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/10 text-emerald-950 border border-emerald-500/20">100% SAFE</span></td>
        </tr>
      </tbody>
    </table>
  </div>

  <!-- 4 Golden Rules Section -->
  <div class="border-t border-hairline pt-10">
    <div class="max-w-2xl mb-8">
      <h3 class="text-xl font-bold text-ink mb-1">{d.rulesTitle}</h3>
      <p class="text-xs md:text-sm text-muted">{d.rulesSub}</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      <div class="bg-surface border border-hairline rounded-2xl p-5 shadow-2xs">
        <div class="w-8 h-8 rounded-lg bg-rose-500/10 text-rose-950 font-bold flex items-center justify-center text-sm mb-3">1</div>
        <h4 class="text-sm font-bold text-ink mb-2">{d.rule1Title}</h4>
        <p class="text-xs text-muted leading-relaxed">{d.rule1Text}</p>
      </div>

      <div class="bg-surface border border-hairline rounded-2xl p-5 shadow-2xs">
        <div class="w-8 h-8 rounded-lg bg-rose-500/10 text-rose-950 font-bold flex items-center justify-center text-sm mb-3">2</div>
        <h4 class="text-sm font-bold text-ink mb-2">{d.rule2Title}</h4>
        <p class="text-xs text-muted leading-relaxed">{d.rule2Text}</p>
      </div>

      <div class="bg-surface border border-hairline rounded-2xl p-5 shadow-2xs">
        <div class="w-8 h-8 rounded-lg bg-emerald-500/10 text-emerald-950 font-bold flex items-center justify-center text-sm mb-3">3</div>
        <h4 class="text-sm font-bold text-ink mb-2">{d.rule3Title}</h4>
        <p class="text-xs text-muted leading-relaxed">{d.rule3Text}</p>
      </div>

      <div class="bg-surface border border-hairline rounded-2xl p-5 shadow-2xs">
        <div class="w-8 h-8 rounded-lg bg-blue-500/10 text-blue-950 font-bold flex items-center justify-center text-sm mb-3">4</div>
        <h4 class="text-sm font-bold text-ink mb-2">{d.rule4Title}</h4>
        <p class="text-xs text-muted leading-relaxed">{d.rule4Text}</p>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ modelData, d }}>
  document.addEventListener('DOMContentLoaded', () => {
    const prepSelect = document.getElementById('egg-prep-select');
    const wattageSelect = document.getElementById('egg-wattage-select');
    const startTempSelect = document.getElementById('egg-start-temp');
    const triggerSelect = document.getElementById('egg-trigger-select');
    const durationRange = document.getElementById('egg-duration-range');
    const durationDisplay = document.getElementById('duration-display');

    const statusPill = document.getElementById('status-pill');
    const peakYolkTemp = document.getElementById('peak-yolk-temp');
    const superheatFlag = document.getElementById('superheat-flag');
    const vaporPressureVal = document.getElementById('vapor-pressure-val');
    const vaporKpaVal = document.getElementById('vapor-kpa-val');
    const acousticBlastVal = document.getElementById('acoustic-blast-val');
    const ejectionVelocityVal = document.getElementById('ejection-velocity-val');
    const ejectionMphVal = document.getElementById('ejection-mph-val');
    const explosionRiskVal = document.getElementById('explosion-risk-val');
    const flashOddsVal = document.getElementById('flash-odds-val');
    const clinicalBurnBox = document.getElementById('clinical-burn-box');
    const clinicalBurnTitle = document.getElementById('clinical-burn-title');
    const clinicalBurnDesc = document.getElementById('clinical-burn-desc');
    const copyReportBtn = document.getElementById('copy-report-btn');
    const copyBtnText = document.getElementById('copy-btn-text');

    const prepMap = {};
    modelData.eggPreparations.forEach(p => prepMap[p.id] = p);

    const wattMap = {};
    modelData.microwaveWattage.forEach(w => wattMap[w.id] = w);

    const startMap = {};
    modelData.startingTemperatures.forEach(s => startMap[s.id] = s);

    const triggerMap = {};
    modelData.triggerMechanisms.forEach(t => triggerMap[t.id] = t);

    function calculateThermodynamics() {
      const prep = prepMap[prepSelect.value] || modelData.eggPreparations[1];
      const watt = wattMap[wattageSelect.value] || modelData.microwaveWattage[2];
      const start = startMap[startTempSelect.value] || modelData.startingTemperatures[0];
      const trig = triggerMap[triggerSelect.value] || modelData.triggerMechanisms[0];
      const duration = parseInt(durationRange.value, 10);

      durationDisplay.textContent = `${duration}s`;

      // Temperature kinetic equation:
      // Delta_T = duration * heatingRate * powerFactor * (0.6 + 0.4 * superheatSensitivity)
      const baseDeltaT = duration * watt.heatingRateCPerSec * watt.powerFactor * (0.7 + 0.3 * prep.superheatSensitivity);
      let calculatedTempC = start.tempC + baseDeltaT;

      // Realistic thermodynamic ceiling inside household egg matrix (approx 135°C peak superheated liquid limit before complete vapor venting)
      if (calculatedTempC > 135) calculatedTempC = 135;

      const calculatedTempF = Math.round(calculatedTempC * 1.8 + 32);
      const isSuperheated = calculatedTempC > 100.0 && prep.nucleationSites < 5;

      peakYolkTemp.textContent = `${calculatedTempC.toFixed(1)}°C (${calculatedTempF}°F)`;

      // Clausius-Clapeyron Vapor Pressure estimation
      // P_sat(T) in kPa approx: 101.3 * exp(13.7 - 5120 / (T_K))
      let pGaugePsi = 0;
      let pGaugeKpa = 0;
      if (calculatedTempC > 100) {
        const tK = calculatedTempC + 273.15;
        const pSatAtm = Math.exp((5417.4 * (1/373.15 - 1/tK)));
        const pSatKpa = pSatAtm * 101.325;
        pGaugeKpa = Math.max(0, pSatKpa - 101.325);
        pGaugePsi = pGaugeKpa * 0.145038;
      }

      // Cap gauge pressure by preparation rupture strength
      const cappedPsi = Math.min(pGaugePsi, prep.pressureResistancePsi);
      const cappedKpa = cappedPsi / 0.145038;

      vaporPressureVal.textContent = `${cappedPsi.toFixed(1)} PSI`;
      vaporKpaVal.textContent = `${cappedKpa.toFixed(0)} kPa gauge`;

      // Acoustic Impulse & Ejection Velocity
      let blastDb = 0;
      let velocityMs = 0;
      let riskLevel = 'LOW';
      let riskColor = 'text-emerald-950 bg-emerald-500/10 border-emerald-500/20';

      if (prep.id === 'beaten-scrambled') {
        blastDb = 0;
        velocityMs = 0;
        riskLevel = 'ZERO EXPLOSION HAZARD';
        riskColor = 'text-emerald-950 bg-emerald-500/10 border-emerald-500/20';
        superheatFlag.textContent = '✅ Uniform heat distribution; zero superheated pockets';
        superheatFlag.className = 'text-[11px] font-medium mt-1 text-emerald-950';
      } else if (prep.id === 'pierced-yolk-white') {
        blastDb = 25;
        velocityMs = 1.5;
        riskLevel = 'SAFE VENTED STEAM';
        riskColor = 'text-emerald-950 bg-emerald-500/10 border-emerald-500/20';
        superheatFlag.textContent = '✅ Toothpick vent holes allow safe continuous vapor release';
        superheatFlag.className = 'text-[11px] font-medium mt-1 text-emerald-950';
      } else if (prep.id === 'water-poached') {
        if (calculatedTempC > 105) {
          blastDb = 68;
          velocityMs = 6.2;
          riskLevel = 'MODERATE POP HAZARD';
          riskColor = 'text-amber-950 bg-amber-500/10 border-amber-500/20';
          superheatFlag.textContent = '⚠️ Surrounding water buffering heat, but unpierced core may pop';
          superheatFlag.className = 'text-[11px] font-medium mt-1 text-amber-950';
        } else {
          blastDb = 15;
          velocityMs = 0.5;
          riskLevel = 'SAFE CONDUCTIVE POACH';
          riskColor = 'text-emerald-950 bg-emerald-500/10 border-emerald-500/20';
          superheatFlag.textContent = '✅ Water bath caps surface temperature at 100°C';
          superheatFlag.className = 'text-[11px] font-medium mt-1 text-emerald-950';
        }
      } else {
        // High Risk Preps: raw-shell, boiled-whole, raw-unpierced-bowl
        if (calculatedTempC >= 100) {
          superheatFlag.textContent = `🚨 SUPERHEATED LIQUID: +${(calculatedTempC - 100).toFixed(1)}°C past boiling threshold!`;
          superheatFlag.className = 'text-[11px] font-extrabold mt-1 text-rose-950 animate-pulse';

          if (trig.id === 'quiescent-rest') {
            blastDb = 40;
            velocityMs = 3.0;
            riskLevel = 'DISSIPATING (RESTING)';
            riskColor = 'text-amber-950 bg-amber-500/10 border-amber-500/20';
          } else {
            // Instantaneous flash cavitation!
            // Acoustic blast scales with stored pressure and trigger impulse
            const baseDb = prep.id === 'raw-shell' ? 122 : (prep.id === 'boiled-whole' ? 108 : 94);
            const durMultiplier = Math.min(1.2, 0.7 + (duration / 50));
            blastDb = Math.round(baseDb * durMultiplier * trig.blastImpulseMultiplier);
            if (blastDb > 133) blastDb = 133;

            // Bernoulli ejection velocity v = sqrt(2 * deltaP / rho)
            // with expansion impulse multiplier
            const baseVelocity = Math.sqrt((2 * cappedKpa * 1000) / 1050);
            velocityMs = Math.round(baseVelocity * trig.blastImpulseMultiplier * 1.3);
            if (velocityMs > 45) velocityMs = 45;

            if (prep.id === 'raw-shell') {
              riskLevel = 'CATASTROPHIC SHRAPNEL BLAST';
              riskColor = 'text-red-950 bg-red-500/15 border-red-500/30';
            } else if (trig.id === 'tooth-bite') {
              riskLevel = 'CRITICAL ORAL BLAST & SCALD';
              riskColor = 'text-rose-950 bg-rose-500/15 border-rose-500/30';
            } else {
              riskLevel = 'SEVERE CAVITATION BLAST';
              riskColor = 'text-rose-950 bg-rose-500/10 border-rose-500/20';
            }
          }
        } else {
          superheatFlag.textContent = 'Under boiling point (<100°C) - insufficient vapor pressure for blast';
          superheatFlag.className = 'text-[11px] font-medium mt-1 text-muted';
          blastDb = 20;
          velocityMs = 1.0;
          riskLevel = 'BELOW FLASH THRESHOLD';
          riskColor = 'text-blue-950 bg-blue-500/10 border-blue-500/20';
        }
      }

      acousticBlastVal.textContent = `${blastDb} dB SPL`;
      ejectionVelocityVal.textContent = `${velocityMs} m/s`;
      ejectionMphVal.textContent = `${Math.round(velocityMs * 2.237)} mph`;

      explosionRiskVal.textContent = riskLevel;
      statusPill.textContent = riskLevel;
      statusPill.className = `text-xs px-2.5 py-0.5 rounded-full font-bold uppercase tracking-wider border ${riskColor}`;

      // Clinical Burn Risk Assessment
      if (calculatedTempC >= 105 && velocityMs > 10) {
        if (trig.id === 'tooth-bite') {
          clinicalBurnBox.className = 'border border-purple-500/30 bg-purple-500/10 rounded-xl p-3.5 mb-5 text-xs text-purple-950';
          clinicalBurnTitle.textContent = 'CRITICAL CLINICAL EMERGENCY: Severe Palatal & Facial Burns';
          clinicalBurnDesc.textContent = `Superheated yolk (${calculatedTempC.toFixed(0)}°C) ejected under ${cappedPsi.toFixed(0)} PSI pressure directly against oral mucous membranes. Causes immediate second-degree palatal blistering, lips tissue necrosis, and high risk of scalding corneal spray.`;
        } else if (prep.id === 'raw-shell') {
          clinicalBurnBox.className = 'border border-red-500/30 bg-red-500/10 rounded-xl p-3.5 mb-5 text-xs text-red-950';
          clinicalBurnTitle.textContent = 'HIGH-VELOCITY SHRAPNEL & THERMAL TRAUMA';
          clinicalBurnDesc.textContent = `Eggshell ruptures at ${cappedPsi.toFixed(0)} PSI with ${blastDb} dB impulse. Calcium carbonate shards and scalding yolk blast outward at ${velocityMs} m/s (${Math.round(velocityMs * 2.237)} mph). Extreme danger of penetrating corneal laceration if oven door fails or is opened.`;
        } else {
          clinicalBurnBox.className = 'border border-rose-500/30 bg-rose-500/10 rounded-xl p-3.5 mb-5 text-xs text-rose-950';
          clinicalBurnTitle.textContent = 'ACUTE CORNEAL & SECOND-DEGREE FACIAL SCALD';
          clinicalBurnDesc.textContent = `Fork tine creates instantaneous heterogeneous nucleation. Superheated yolk flashes into steam, blasting boiling liquid straight up at ${velocityMs} m/s. Documented cause of traumatic anterior uveitis and corneal epithelial loss.`;
        }
      } else if (calculatedTempC > 70) {
        clinicalBurnBox.className = 'border border-amber-500/30 bg-amber-500/10 rounded-xl p-3.5 mb-5 text-xs text-amber-950';
        clinicalBurnTitle.textContent = 'MODERATE THERMAL BURN POTENTIAL (>70°C)';
        clinicalBurnDesc.textContent = `Egg contents are hot enough to induce partial-thickness thermal skin burns in under 1 second of direct contact, though explosive cavitation velocity is constrained.`;
      } else {
        clinicalBurnBox.className = 'border border-emerald-500/30 bg-emerald-500/10 rounded-xl p-3.5 mb-5 text-xs text-emerald-950';
        clinicalBurnTitle.textContent = 'MINIMAL BURN & EXPLOSION RISK';
        clinicalBurnDesc.textContent = `Vented pathways and uniform thermal distribution prevent localized pressure accumulation. Completely safe to consume.`;
      }
    }

    // Attach Event Listeners
    [prepSelect, wattageSelect, startTempSelect, triggerSelect].forEach(el => {
      el.addEventListener('change', calculateThermodynamics);
    });

    durationRange.addEventListener('input', calculateThermodynamics);

    // Preset Buttons
    document.querySelectorAll('.preset-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const p = btn.getAttribute('data-prep');
        const w = btn.getAttribute('data-wattage');
        const s = btn.getAttribute('data-start');
        const d = btn.getAttribute('data-duration');
        const t = btn.getAttribute('data-trigger');

        if (p) prepSelect.value = p;
        if (w) wattageSelect.value = w;
        if (s) startTempSelect.value = s;
        if (d) durationRange.value = d;
        if (t) triggerSelect.value = t;

        calculateThermodynamics();
      });
    });

    // Copy Forensic Report
    copyReportBtn.addEventListener('click', () => {
      const reportText = `[IsItKitchenSafe Forensic Egg Explosion Simulation Report]
Preparation: ${prepSelect.options[prepSelect.selectedIndex].text}
Wattage: ${wattageSelect.options[wattageSelect.selectedIndex].text}
Initial Temp: ${startTempSelect.options[startTempSelect.selectedIndex].text}
Heating Duration: ${durationRange.value} seconds
Trigger Disturbance: ${triggerSelect.options[triggerSelect.selectedIndex].text}
--------------------------------------------------
Peak Yolk Core Temp: ${peakYolkTemp.textContent}
Internal Gauge Pressure: ${vaporPressureVal.textContent} (${vaporKpaVal.textContent})
Acoustic Blast Impulse: ${acousticBlastVal.textContent}
Scalding Ejection Velocity: ${ejectionVelocityVal.textContent} (${ejectionMphVal.textContent})
Cavitation Hazard Rating: ${explosionRiskVal.textContent}
Clinical Burn Triage: ${clinicalBurnTitle.textContent} - ${clinicalBurnDesc.textContent}
Simulation Timestamp: ${new Date().toISOString()}
Standard: Acoustical Society of America (ASA) 2017 & USDA-FSIS Microwave Guidelines`;

      navigator.clipboard.writeText(reportText).then(() => {
        const origText = copyBtnText.textContent;
        copyBtnText.textContent = d.copiedFeedback;
        setTimeout(() => {
          copyBtnText.textContent = origText;
        }, 3000);
      });
    });

    // Initial calculation
    calculateThermodynamics();
  });
</script>
