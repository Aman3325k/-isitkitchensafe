const c = DICTIONARY[lang];
---

<div class="my-8 p-6 sm:p-8 rounded-3xl bg-surface-card border border-hairline shadow-sm" id="rotary-rack-oven-modeler">
  <!-- Header Bar -->
  <div class="flex flex-wrap items-center justify-between gap-3 mb-6 pb-6 border-b border-hairline">
    <div>
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-rose-600 text-white mb-2">
        {c.badge}
      </span>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-ink tracking-tight">
        {c.title}
      </h2>
      <p class="text-xs sm:text-sm text-muted mt-1 max-w-3xl leading-relaxed">
        {c.subtitle}
      </p>
    </div>
    <div class="flex items-center gap-2">
      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-mono font-medium bg-surface-soft border border-hairline text-ink">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        NFPA 86 &bull; ANSI Z83.11 &bull; OSHA CO
      </span>
    </div>
  </div>

  <!-- Presets -->
  <div class="mb-8">
    <div class="text-xs font-bold uppercase tracking-wider text-muted mb-3 flex items-center gap-2">
      <svg class="w-4 h-4 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
      </svg>
      {c.presetsTitle}
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5">
      <button 
        type="button" 
        class="preset-btn px-3.5 py-2.5 rounded-xl border border-hairline text-left text-xs font-medium bg-surface hover:bg-surface-soft text-ink transition-all cursor-pointer hover:border-rose-500"
        data-preset="optimal"
      >
        <div class="font-bold text-emerald-600 mb-0.5">✓ {c.presetOptimal.split('(')[0]}</div>
        <div class="text-[11px] text-muted">({c.presetOptimal.split('(')[1]}</div>
      </button>

      <button 
        type="button" 
        class="preset-btn px-3.5 py-2.5 rounded-xl border border-hairline text-left text-xs font-medium bg-surface hover:bg-surface-soft text-ink transition-all cursor-pointer hover:border-rose-500"
        data-preset="fatigue"
      >
        <div class="font-bold text-amber-600 mb-0.5">⚠ {c.presetFatigue.split('(')[0]}</div>
        <div class="text-[11px] text-muted">({c.presetFatigue.split('(')[1]}</div>
      </button>

      <button 
        type="button" 
        class="preset-btn px-3.5 py-2.5 rounded-xl border border-hairline text-left text-xs font-medium bg-surface hover:bg-surface-soft text-ink transition-all cursor-pointer hover:border-rose-500"
        data-preset="inversion"
      >
        <div class="font-bold text-rose-600 mb-0.5">🚨 {c.presetInversion.split('(')[0]}</div>
        <div class="text-[11px] text-muted">({c.presetInversion.split('(')[1]}</div>
      </button>

      <button 
        type="button" 
        class="preset-btn px-3.5 py-2.5 rounded-xl border border-hairline text-left text-xs font-medium bg-surface hover:bg-surface-soft text-ink transition-all cursor-pointer hover:border-rose-500"
        data-preset="artisanSteam"
      >
        <div class="font-bold text-cyan-600 mb-0.5">⚡ {c.presetArtisanSteam.split('(')[0]}</div>
        <div class="text-[11px] text-muted">({c.presetArtisanSteam.split('(')[1]}</div>
      </button>
    </div>
  </div>

  <!-- Interactive Controls & Canvas Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-8">
    <!-- Controls Column (5 cols) -->
    <div class="lg:col-span-5 space-y-5 bg-surface-soft p-5 sm:p-6 rounded-2xl border border-hairline">
      <div>
        <h3 class="text-base font-bold text-ink mb-1">{c.controlsTitle}</h3>
        <p class="text-xs text-muted leading-relaxed">{c.controlsSub}</p>
      </div>

      <!-- Oven Architecture -->
      <div>
        <label for="oven-select" class="block text-xs font-bold text-ink uppercase tracking-wider mb-1.5">
          {c.ovenLabel}
        </label>
        <select 
          id="oven-select" 
          class="w-full text-xs rounded-xl bg-surface border border-hairline text-ink p-2.5 focus:border-rose-500 focus:outline-none transition-colors"
        >
          {ovenData.ovenConfigurations.map(o => (
            <option value={o.id}>{o.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1 leading-normal">{c.ovenHelp}</p>
      </div>

      <!-- Metallurgy Grade -->
      <div>
        <label for="metallurgy-select" class="block text-xs font-bold text-ink uppercase tracking-wider mb-1.5">
          {c.metallurgyLabel}
        </label>
        <select 
          id="metallurgy-select" 
          class="w-full text-xs rounded-xl bg-surface border border-hairline text-ink p-2.5 focus:border-rose-500 focus:outline-none transition-colors"
        >
          {ovenData.metallurgyGrades.map(m => (
            <option value={m.id}>{m.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1 leading-normal">{c.metallurgyHelp}</p>
      </div>

      <!-- Burner Profile -->
      <div>
        <label for="burner-select" class="block text-xs font-bold text-ink uppercase tracking-wider mb-1.5">
          {c.burnerLabel}
        </label>
        <select 
          id="burner-select" 
          class="w-full text-xs rounded-xl bg-surface border border-hairline text-ink p-2.5 focus:border-rose-500 focus:outline-none transition-colors"
        >
          {ovenData.fuelBurnerProfiles.map(b => (
            <option value={b.id}>{b.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1 leading-normal">{c.burnerHelp}</p>
      </div>

      <!-- Temperature Slider -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <label for="temp-slider" class="text-xs font-bold text-ink uppercase tracking-wider">
            {c.tempSliderLabel}
          </label>
          <span id="temp-val" class="text-xs font-mono font-bold text-rose-600 bg-surface px-2 py-0.5 rounded border border-hairline">
            485°F (252°C)
          </span>
        </div>
        <input 
          type="range" 
          id="temp-slider" 
          min="300" 
          max="550" 
          step="5" 
          value="485" 
          class="w-full accent-rose-600 cursor-pointer"
        />
        <p class="text-[11px] text-muted mt-1">{c.tempSliderHelp}</p>
      </div>

      <!-- Daily Thermal Cycles Slider -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <label for="cycles-slider" class="text-xs font-bold text-ink uppercase tracking-wider">
            {c.cyclesSliderLabel}
          </label>
          <span id="cycles-val" class="text-xs font-mono font-bold text-rose-600 bg-surface px-2 py-0.5 rounded border border-hairline">
            16 cycles/day
          </span>
        </div>
        <input 
          type="range" 
          id="cycles-slider" 
          min="2" 
          max="35" 
          step="1" 
          value="16" 
          class="w-full accent-rose-600 cursor-pointer"
        />
        <p class="text-[11px] text-muted mt-1">{c.cyclesSliderHelp}</p>
      </div>

      <!-- Differential Pressure Delta-P Slider -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <label for="pressure-slider" class="text-xs font-bold text-ink uppercase tracking-wider">
            {c.pressureSliderLabel}
          </label>
          <span id="pressure-val" class="text-xs font-mono font-bold text-emerald-600 bg-surface px-2 py-0.5 rounded border border-hairline">
            +0.04 in. w.g. (Safe)
          </span>
        </div>
        <input 
          type="range" 
          id="pressure-slider" 
          min="-0.20" 
          max="0.20" 
          step="0.01" 
          value="0.04" 
          class="w-full accent-rose-600 cursor-pointer"
        />
        <p class="text-[11px] text-muted mt-1">{c.pressureSliderHelp}</p>
      </div>

      <!-- Steam Injection Quench Slider -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <label for="steam-slider" class="text-xs font-bold text-ink uppercase tracking-wider">
            {c.steamSliderLabel}
          </label>
          <span id="steam-val" class="text-xs font-mono font-bold text-cyan-600 bg-surface px-2 py-0.5 rounded border border-hairline">
            25 sec
          </span>
        </div>
        <input 
          type="range" 
          id="steam-slider" 
          min="0" 
          max="90" 
          step="5" 
          value="25" 
          class="w-full accent-rose-600 cursor-pointer"
        />
        <p class="text-[11px] text-muted mt-1">{c.steamSliderHelp}</p>
      </div>

      <!-- Service Age Slider -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <label for="years-slider" class="text-xs font-bold text-ink uppercase tracking-wider">
            {c.yearsSliderLabel}
          </label>
          <span id="years-val" class="text-xs font-mono font-bold text-ink bg-surface px-2 py-0.5 rounded border border-hairline">
            8 Years
          </span>
        </div>
        <input 
          type="range" 
          id="years-slider" 
          min="1" 
          max="25" 
          step="1" 
          value="8" 
          class="w-full accent-rose-600 cursor-pointer"
        />
        <p class="text-[11px] text-muted mt-1">{c.yearsSliderHelp}</p>
      </div>

      <!-- Flue Exhaust Draft Airflow Slider -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <label for="flue-slider" class="text-xs font-bold text-ink uppercase tracking-wider">
            {c.flueAirflowLabel}
          </label>
