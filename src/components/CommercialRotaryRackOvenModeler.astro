<script is:inline define:vars={{ ovenData, dictionary: DICTIONARY, currentLang: lang }}>
  (function initRotaryRackOvenModeler() {
    // DOM Elements
    const ovenSelect = document.getElementById('oven-select');
    const metallurgySelect = document.getElementById('metallurgy-select');
    const burnerSelect = document.getElementById('burner-select');
    const tempSlider = document.getElementById('temp-slider');
    const cyclesSlider = document.getElementById('cycles-slider');
    const pressureSlider = document.getElementById('pressure-slider');
    const steamSlider = document.getElementById('steam-slider');
    const yearsSlider = document.getElementById('years-slider');
    const flueSlider = document.getElementById('flue-slider');

    const tempVal = document.getElementById('temp-val');
    const cyclesVal = document.getElementById('cycles-val');
    const pressureVal = document.getElementById('pressure-val');
    const steamVal = document.getElementById('steam-val');
    const yearsVal = document.getElementById('years-val');
    const flueVal = document.getElementById('flue-val');

    const canvasBadge = document.getElementById('canvas-badge');
    const metricFatigue = document.getElementById('metric-fatigue');
    const metricFatigueSub = document.getElementById('metric-fatigue-sub');
    const metricInversion = document.getElementById('metric-inversion');
    const metricInversionSub = document.getElementById('metric-inversion-sub');
    const metricChamberCo = document.getElementById('metric-chamber-co');
    const metricChamberCoSub = document.getElementById('metric-chamber-co-sub');
    const metricAmbientCo = document.getElementById('metric-ambient-co');
    const metricAmbientCoSub = document.getElementById('metric-ambient-co-sub');
    const metricCrackRisk = document.getElementById('metric-crack-risk');
    const metricNfpa = document.getElementById('metric-nfpa');
    const metricRemainingLife = document.getElementById('metric-remaining-life');

    const reportRiskBadge = document.getElementById('report-risk-badge');
    const reportPrimaryRisk = document.getElementById('report-primary-risk');
    const reportMechanisms = document.getElementById('report-mechanisms');
    const reportMitigation = document.getElementById('report-mitigation');
    const copyReportBtn = document.getElementById('copy-report-btn');
    const copyBtnText = document.getElementById('copy-btn-text');

    const canvas = document.getElementById('rackOvenCanvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');

    // Preset Buttons
    const presetButtons = document.querySelectorAll('.preset-btn');
    presetButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const p = btn.getAttribute('data-preset');
        if (p === 'optimal') {
          ovenSelect.value = 'heavy_duty_double_rack_gas_409';
          metallurgySelect.value = 'aisi_409_ferritic';
          burnerSelect.value = 'natural_gas_forced_draft';
          tempSlider.value = 425;
          cyclesSlider.value = 12;
          pressureSlider.value = 0.05;
          steamSlider.value = 15;
          yearsSlider.value = 3;
          flueSlider.value = 420;
        } else if (p === 'fatigue') {
          ovenSelect.value = 'heavy_duty_double_rack_gas_409';
          metallurgySelect.value = 'aisi_409_ferritic';
          burnerSelect.value = 'natural_gas_forced_draft';
          tempSlider.value = 520;
          cyclesSlider.value = 28;
          pressureSlider.value = 0.01;
          steamSlider.value = 35;
          yearsSlider.value = 14;
          flueSlider.value = 340;
        } else if (p === 'inversion') {
          ovenSelect.value = 'aged_institutional_rack_oven_cracked';
          metallurgySelect.value = 'aisi_409_ferritic';
          burnerSelect.value = 'malfunctioning_rich_burn';
          tempSlider.value = 500;
          cyclesSlider.value = 22;
          pressureSlider.value = -0.12;
          steamSlider.value = 20;
          yearsSlider.value = 18;
          flueSlider.value = 160;
        } else if (p === 'artisanSteam') {
          ovenSelect.value = 'single_rack_artisan_304';
          metallurgySelect.value = 'aisi_304_austenitic';
          burnerSelect.value = 'propane_lpg_high_temp';
          tempSlider.value = 490;
          cyclesSlider.value = 18;
          pressureSlider.value = 0.02;
          steamSlider.value = 65;
          yearsSlider.value = 7;
          flueSlider.value = 280;
        }
        recalculateAndRender();
      });
    });

    // Event Listeners for Sliders & Selects
    [ovenSelect, metallurgySelect, burnerSelect, tempSlider, cyclesSlider, pressureSlider, steamSlider, yearsSlider, flueSlider].forEach(el => {
      el.addEventListener('input', recalculateAndRender);
      el.addEventListener('change', recalculateAndRender);
    });

    // Physics & Engineering Math Engine
    function recalculateAndRender() {
      const selectedOvenId = ovenSelect.value;
      const selectedMetalId = metallurgySelect.value;
      const selectedBurnerId = burnerSelect.value;

      const tempF = parseFloat(tempSlider.value);
      const tempC = Math.round((tempF - 32) * (5 / 9));
      const cyclesPerDay = parseInt(cyclesSlider.value, 10);
      const deltaP = parseFloat(pressureSlider.value); // in. w.g.
      const steamSec = parseInt(steamSlider.value, 10);
      const yearsInService = parseInt(yearsSlider.value, 10);
      const flueCfm = parseInt(flueSlider.value, 10);

      // Label updates
      tempVal.textContent = `${tempF}°F (${tempC}°C)`;
      cyclesVal.textContent = `${cyclesPerDay} cycles/day`;
      pressureVal.textContent = `${deltaP >= 0 ? '+' : ''}${deltaP.toFixed(2)} in. w.g. (${deltaP < 0 ? 'Inversion' : 'Safe'})`;
      pressureVal.className = `text-xs font-mono font-bold px-2 py-0.5 rounded border border-hairline ${deltaP < 0 ? 'text-rose-600 bg-rose-50 dark:bg-rose-950' : 'text-emerald-600 bg-emerald-50 dark:bg-emerald-950'}`;
      steamVal.textContent = `${steamSec} sec`;
      yearsVal.textContent = `${yearsInService} Years`;
      flueVal.textContent = `${flueCfm} CFM`;

      // Find referenced configs
      const oven = ovenData.ovenConfigurations.find(o => o.id === selectedOvenId) || ovenData.ovenConfigurations[0];
      const metal = ovenData.metallurgyGrades.find(m => m.id === selectedMetalId) || ovenData.metallurgyGrades[0];
      const burner = ovenData.fuelBurnerProfiles.find(b => b.id === selectedBurnerId) || ovenData.fuelBurnerProfiles[0];

      // 1. Coffin-Manson Low-Cycle Thermal Fatigue Calculation
      // Thermal stress factor based on expansion coefficient and delta T
      const deltaT = Math.max(50, tempF - 70); // from ambient dough cart
      const thermalExpansionFactor = metal.thermalExpansionCoeff / 11.2; // normalized to 409
      const steamShockStress = (steamSec / 30) * 1.35; // quench multiplier
      const dailyStrainIndex = (cyclesPerDay / 10) * Math.pow(deltaT / 400, 1.8) * thermalExpansionFactor * (1 + steamShockStress * 0.4);
      
      // Cumulative lifetime cycles
      const totalLifetimeCycles = cyclesPerDay * 320 * yearsInService;
      
      // Material cycle fatigue threshold before crack initiation (Coffin-Manson)
      let baseFatigueLifeCycles = 65000;
      if (selectedMetalId === 'incoloy_800h_superalloy') baseFatigueLifeCycles = 220000;
      else if (selectedMetalId === 'aisi_304_austenitic') baseFatigueLifeCycles = 48000; // high expansion shear
      else if (selectedMetalId === 'aluminized_steel_budget') baseFatigueLifeCycles = 26000;

      // Consumed fatigue life percentage
      let fatigueConsumedPercent = (totalLifetimeCycles / baseFatigueLifeCycles) * 100 * (tempF > 500 ? 1.4 : 1.0);
      fatigueConsumedPercent = Math.min(100, Math.max(1, fatigueConsumedPercent));

      // 2. Crack Formation Probability & Physical Breach
      let crackProbability = 0;
      if (fatigueConsumedPercent < 40) {
        crackProbability = (fatigueConsumedPercent / 40) * 8.0;
      } else if (fatigueConsumedPercent < 75) {
        crackProbability = 8.0 + ((fatigueConsumedPercent - 40) / 35) * 42.0;
      } else {
        crackProbability = 50.0 + ((fatigueConsumedPercent - 75) / 25) * 50.0;
      }
      crackProbability = Math.min(99.5, Math.max(0.5, crackProbability));

      // 3. Aerodynamic Inversion & Flue Gas / CO Leakage
      // Is there an active open fissure?
      const fissureIsOpen = crackProbability > 35;
      const isElectric = burner.nominalCoPpm === 0;

      let chamberCoPpm = 0;
      let ambientSpillCoPpm = 0;
      let inversionStatusText = 'SEALED';
      let inversionSeverity = 'OK';

      if (deltaP < 0) {
        // Negative chamber pressure induces suction from combustion chamber into bake chamber
        inversionStatusText = 'INVERSION (LEAK)';
        inversionSeverity = 'CRITICAL';
        if (fissureIsOpen && !isElectric) {
          const suctionFlowFactor = Math.abs(deltaP) / 0.10;
          const crackApertureFactor = (crackProbability - 35) / 65;
          chamberCoPpm = burner.nominalCoPpm * 0.18 * suctionFlowFactor * crackApertureFactor;
          // Room spill when door opens (15% volume release into 1,200 sq ft bakery)
          ambientSpillCoPpm = chamberCoPpm * 0.32;
        }
      } else if (deltaP < 0.02) {
        inversionStatusText = 'MARGINAL (+0.01)';
        inversionSeverity = 'WARN';
        if (fissureIsOpen && !isElectric) {
          chamberCoPpm = burner.nominalCoPpm * 0.02 * (crackProbability / 100);
          ambientSpillCoPpm = chamberCoPpm * 0.25;
        }
      } else {
        inversionStatusText = 'POSITIVE SEAL';
        inversionSeverity = 'SAFE';
        chamberCoPpm = 0.0;
        ambientSpillCoPpm = isElectric ? 0 : 0.4; // baseline ambient trace
      }

      // 4. NFPA 86 Class A Explosion Relief Compliance
      // Required: 1 sq ft per 15 cu ft oven volume
      const requiredReliefSqFt = oven.chamberVolumeCuFt / 15.0;
      const actualReliefSqFt = oven.explosionReliefAreaSqFt;
      const nfpaComplianceRatio = actualReliefSqFt / requiredReliefSqFt;
      const isNfpaCompliant = nfpaComplianceRatio >= 0.98;

      // 5. Remaining Useful Life
      const remainingPercent = Math.max(0, 100 - fatigueConsumedPercent);
      const remainingYears = ((remainingPercent / 100) * (baseFatigueLifeCycles / (cyclesPerDay * 320))).toFixed(1);

      // Render Metrics to UI
      metricFatigue.textContent = `${fatigueConsumedPercent.toFixed(1)}%`;
      if (fatigueConsumedPercent > 75) {
        metricFatigue.className = 'text-xl sm:text-2xl font-black font-mono text-rose-600';
        metricFatigueSub.textContent = 'Severe Thermal Cracking';
      } else if (fatigueConsumedPercent > 45) {
        metricFatigue.className = 'text-xl sm:text-2xl font-black font-mono text-amber-600';
        metricFatigueSub.textContent = 'Active Weld Micro-Fissures';
      } else {
        metricFatigue.className = 'text-xl sm:text-2xl font-black font-mono text-emerald-600';
        metricFatigueSub.textContent = 'Ductile Sound Welds';
      }

      metricInversion.textContent = inversionStatusText;
      if (inversionSeverity === 'CRITICAL') {
        metricInversion.className = 'text-base sm:text-lg font-black font-mono text-rose-600 animate-pulse';
        metricInversionSub.textContent = `${deltaP.toFixed(2)} in. w.g. (Suction)`;
      } else if (inversionSeverity === 'WARN') {
        metricInversion.className = 'text-base sm:text-lg font-black font-mono text-amber-600';
        metricInversionSub.textContent = `${deltaP.toFixed(2)} in. w.g. (Marginal)`;
      } else {
        metricInversion.className = 'text-base sm:text-lg font-black font-mono text-emerald-600';
        metricInversionSub.textContent = `+${deltaP.toFixed(2)} in. w.g. (Positive)`;
      }

      metricChamberCo.textContent = `${chamberCoPpm.toFixed(1)} ppm`;
      metricChamberCo.className = `text-xl sm:text-2xl font-black font-mono ${chamberCoPpm > 15 ? 'text-rose-600' : (chamberCoPpm > 0 ? 'text-amber-600' : 'text-emerald-600')}`;
      metricChamberCoSub.textContent = chamberCoPpm > 15 ? 'Critical Food Contamination' : (chamberCoPpm > 0 ? 'Trace CO Infiltration' : 'Pure Clean Bake');

      metricAmbientCo.textContent = `${ambientSpillCoPpm.toFixed(1)} ppm`;
      if (ambientSpillCoPpm >= 50) {
        metricAmbientCo.className = 'text-xl sm:text-2xl font-black font-mono text-rose-600';
        metricAmbientCoSub.textContent = 'EXCEEDS OSHA PEL (50 ppm)';
      } else if (ambientSpillCoPpm >= 35) {
        metricAmbientCo.className = 'text-xl sm:text-2xl font-black font-mono text-amber-600';
        metricAmbientCoSub.textContent = 'EXCEEDS NIOSH REL (35 ppm)';
      } else {
        metricAmbientCo.className = 'text-xl sm:text-2xl font-black font-mono text-emerald-600';
        metricAmbientCoSub.textContent = '<35 ppm Safe Breathing Zone';
      }

      metricCrackRisk.textContent = `${crackProbability > 50 ? 'HIGH' : (crackProbability > 20 ? 'MODERATE' : 'LOW')} (${crackProbability.toFixed(1)}%)`;
      metricCrackRisk.className = `text-sm font-bold font-mono mt-0.5 ${crackProbability > 50 ? 'text-rose-600' : (crackProbability > 20 ? 'text-amber-600' : 'text-emerald-600')}`;

      const reliefRatioStr = `1:${(oven.chamberVolumeCuFt / actualReliefSqFt).toFixed(1)}`;
      metricNfpa.textContent = `${reliefRatioStr} (${isNfpaCompliant ? 'Compliant' : 'Deficient'})`;
      metricNfpa.className = `text-sm font-bold font-mono mt-0.5 ${isNfpaCompliant ? 'text-emerald-600' : 'text-rose-600'}`;

      metricRemainingLife.textContent = `${remainingYears} Years`;

      // Status Badge
      if (ambientSpillCoPpm >= 35 || chamberCoPpm > 25) {
        reportRiskBadge.textContent = 'CRITICAL COMBUSTION & CO HAZARD - RED';
        reportRiskBadge.className = 'text-rose-600 font-extrabold';
        canvasBadge.textContent = 'ALERT: CO Flue Gas Inversion';
        canvasBadge.className = 'text-[11px] font-mono px-2 py-0.5 rounded bg-rose-100 text-rose-800 dark:bg-rose-950 dark:text-rose-300 font-bold';
      } else if (crackProbability > 40 || deltaP < 0) {
        reportRiskBadge.textContent = 'WARNING: ACTIVE THERMAL CRACKING / MARGINAL DRAFT - AMBER';
        reportRiskBadge.className = 'text-amber-600 font-extrabold';
        canvasBadge.textContent = 'WARN: Weld Micro-Fissuring';
        canvasBadge.className = 'text-[11px] font-mono px-2 py-0.5 rounded bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300 font-bold';
      } else {
        reportRiskBadge.textContent = 'SAFE & COMPLIANT AERODYNAMIC SEAL - GREEN';
        reportRiskBadge.className = 'text-emerald-600 font-extrabold';
        canvasBadge.textContent = 'Airflow: Positive Pressure Seal';
        canvasBadge.className = 'text-[11px] font-mono px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300 font-bold';
      }

      // Detailed Narrative Synthesis
      if (chamberCoPpm > 15) {
        reportPrimaryRisk.textContent = `Severe negative pressure inversion (ΔP = ${deltaP.toFixed(2)} in. w.g.) combined with advanced thermal fatigue crack penetration (${crackProbability.toFixed(1)}%). Raw flue gas containing ${burner.nominalCoPpm} ppm CO is drawn into the bake cavity, contaminating food products.`;
        reportMechanisms.textContent = `Combustion chamber pressure exceeds baking chamber pressure by ${Math.abs(deltaP).toFixed(2)} in. w.g. Bernoulli suction velocity draws hot combustion fumes across tube-sheet weld micro-fissures. Breathing zone spills when opening door reach ${ambientSpillCoPpm.toFixed(1)} ppm CO.`;
        reportMitigation.textContent = `IMMEDIATELY lock out oven gas supply. Rebalance chamber recirculation blower to re-establish +0.02 in. w.g. positive seal. Perform smoke bomb chamber test and weld-repair or replace heat exchanger tube bundle. Inspect NFPA 86 explosion relief panel latches.`;
      } else if (crackProbability > 40) {
        reportPrimaryRisk.textContent = `Elevated thermal fatigue crack propagation (${fatigueConsumedPercent.toFixed(1)}% life consumed) under ${cyclesPerDay} cycles/day at ${tempF}°F. Titanium/chromium carbide precipitation at weld heat-affected zones (HAZ) reduces low-cycle ductility.`;
        reportMechanisms.textContent = `Cold municipal water steam quenching (${steamSec}s injection) produces sharp transient thermal gradient shocks (ΔT > 300°F). While positive static pressure currently holds flue gas at bay, physical breach is imminent within ${remainingYears} years.`;
        reportMitigation.textContent = `Schedule non-destructive ultrasonic or dye-penetrant testing (NDT) across bottom tube passes. Reduce steam injection pulse duration to mitigate quench stress. Maintain continuous ambient CO monitors calibrated to 35 ppm NIOSH threshold.`;
      } else {
        reportPrimaryRisk.textContent = `Sound metallurgical integrity. Total plastic strain is well within Coffin-Manson endurance limits for ${metal.name}. Positive pressure margin (+${deltaP.toFixed(2)} in. w.g.) creates an aerodynamic seal against combustion gas infiltration.`;
        reportMechanisms.textContent = `Forced draft combustion at 83.5% efficiency produces clean stoichiometric exhaust. Flue draft of ${flueCfm} CFM maintains stable chimney draw, while NFPA 86 relief ratio (${reliefRatioStr}) provides compliant emergency overpressure venting.`;
        reportMitigation.textContent = `Continue standard preventive maintenance schedule: annual combustion burner tuning, flue damper inspection, and quarterly manual verification of the top explosion relief panel hinge freedom.`;
      }

      // Draw Visualizer Canvas
      drawCanvas(tempF, deltaP, crackProbability, chamberCoPpm, steamSec, selectedMetalId);
    }

    // Canvas Graphics Renderer
    let animOffset = 0;
    function drawCanvas(tempF, deltaP, crackProb, chamberCo, steamSec, metalId) {
      const w = canvas.width;
      const h = canvas.height;
      ctx.clearRect(0, 0, w, h);

      // 1. Oven Outer Cabinet Enclosure
      ctx.fillStyle = '#0f172a';
      ctx.fillRect(20, 20, w - 40, h - 40);
      ctx.strokeStyle = '#334155';
      ctx.lineWidth = 4;
      ctx.strokeRect(20, 20, w - 40, h - 40);

      // 2. Explosion Relief Panel at Top
      ctx.fillStyle = '#475569';
      ctx.fillRect(w / 2 - 80, 16, 160, 10);
      ctx.strokeStyle = '#94a3b8';
      ctx.lineWidth = 1.5;
      ctx.strokeRect(w / 2 - 80, 16, 160, 10);
      ctx.fillStyle = '#cbd5e1';
      ctx.font = '10px monospace';
      ctx.fillText('NFPA 86 RELIEF PANEL', w / 2 - 62, 14);

      // 3. Baking Chamber Interior Wall
      const chamberX = 180;
      const chamberY = 60;
      const chamberW = w - 220;
      const chamberH = h - 100;
      ctx.fillStyle = '#1e293b';
      ctx.fillRect(chamberX, chamberY, chamberW, chamberH);
      ctx.strokeStyle = '#475569';
      ctx.lineWidth = 2;
      ctx.strokeRect(chamberX, chamberY, chamberW, chamberH);

      // 4. Rotating Rack with Baking Pans (Center of Chamber)
      const rackX = chamberX + chamberW / 2;
      const rackY = chamberY + chamberH / 2 + 10;
      
      // Hanging swivel & rotation shaft
      ctx.strokeStyle = '#cbd5e1';
      ctx.lineWidth = 3;
      ctx.beginPath();
      ctx.moveTo(rackX, chamberY);
      ctx.lineTo(rackX, rackY - 90);
      ctx.stroke();

      // Rotating Rack Frame
      animOffset = (animOffset + 0.02) % (Math.PI * 2);
      const rackWidth = 140 * Math.cos(animOffset);
      ctx.strokeStyle = '#e2e8f0';
      ctx.lineWidth = 2;
      ctx.strokeRect(rackX - Math.abs(rackWidth) / 2, rackY - 80, Math.abs(rackWidth), 160);

      // Bread Pans & Loaves
      for (let i = 0; i < 6; i++) {
        const panY = rackY - 70 + i * 26;
        ctx.fillStyle = '#64748b';
        ctx.fillRect(rackX - Math.abs(rackWidth) / 2 + 6, panY, Math.max(2, Math.abs(rackWidth) - 12), 4);
        
        // Loaf color (Golden brown vs contaminated)
        ctx.fillStyle = chamberCo > 15 ? '#78716c' : '#d97706';
        if (Math.abs(rackWidth) > 30) {
          ctx.beginPath();
          ctx.arc(rackX, panY - 3, 5, Math.PI, 0);
          ctx.fill();
        }
      }

      // 5. Combustion Chamber & Heat Exchanger on the Left
      const exchX = 40;
      const exchY = 80;
      const exchW = 120;
      const exchH = h - 140;

      ctx.fillStyle = '#090d16';
      ctx.fillRect(exchX, exchY, exchW, exchH);
      ctx.strokeStyle = '#e11d48';
      ctx.lineWidth = 2;
      ctx.strokeRect(exchX, exchY, exchW, exchH);

      // Burner Fire Tube at Bottom
      ctx.fillStyle = '#dc2626';
      ctx.beginPath();
      ctx.moveTo(exchX + 15, exchY + exchH - 20);
      ctx.lineTo(exchX + exchW - 15, exchY + exchH - 35);
      ctx.lineTo(exchX + 15, exchY + exchH - 50);
      ctx.closePath();
      ctx.fill();

      // Animated Flame Plumes
      ctx.fillStyle = 'rgba(251, 146, 60, 0.85)';
      const flameFlicker = Math.sin(Date.now() / 120) * 8;
      ctx.beginPath();
      ctx.ellipse(exchX + 45 + flameFlicker, exchY + exchH - 35, 22, 12, 0, 0, Math.PI * 2);
      ctx.fill();

      // Multi-Pass Heat Exchanger Tubes
      for (let j = 0; j < 4; j++) {
        const tubeY = exchY + 30 + j * 42;
        ctx.fillStyle = '#334155';
        ctx.fillRect(exchX + 10, tubeY, exchW - 20, 20);
        ctx.strokeStyle = metalId === 'aisi_304_austenitic' ? '#38bdf8' : (metalId === 'incoloy_800h_superalloy' ? '#a855f7' : '#94a3b8');
        ctx.lineWidth = 1.5;
        ctx.strokeRect(exchX + 10, tubeY, exchW - 20, 20);

        // Flue gas inside tubes
        ctx.fillStyle = 'rgba(244, 63, 94, 0.4)';
        ctx.fillRect(exchX + 12, tubeY + 3, exchW - 24, 14);

        // Tube-to-tubesheet weld on right wall (adjacent to bake chamber)
        const weldX = exchX + exchW - 10;
        const weldY = tubeY + 10;

        if (crackProb > 30) {
          // Micro-fissures or open crack
          ctx.strokeStyle = crackProb > 60 ? '#ef4444' : '#f59e0b';
          ctx.lineWidth = crackProb > 60 ? 3 : 1.5;
          ctx.beginPath();
          ctx.moveTo(weldX, weldY - 8);
          ctx.lineTo(weldX + 3, weldY - 2);
          ctx.lineTo(weldX - 2, weldY + 3);
          ctx.lineTo(weldX + 2, weldY + 8);
          ctx.stroke();

          // Smoke / CO leak jet into bake chamber if deltaP < 0
          if (deltaP < 0 && crackProb > 35) {
            ctx.fillStyle = 'rgba(239, 68, 68, 0.75)';
            const leakW = Math.min(80, Math.abs(deltaP) * 350);
            ctx.beginPath();
            ctx.moveTo(weldX + 4, weldY);
            ctx.lineTo(weldX + leakW, weldY - 14);
            ctx.lineTo(weldX + leakW + 10, weldY + 14);
            ctx.closePath();
            ctx.fill();
            ctx.fillStyle = '#fee2e2';
            ctx.font = '9px monospace';
            ctx.fillText('CO LEAK', weldX + 10, weldY + 3);
          }
        } else {
          // Healthy intact weld
          ctx.fillStyle = '#10b981';
          ctx.beginPath();
          ctx.arc(weldX, weldY, 4, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      // 6. Convection Blower Circulation Fan (Top Right)
      const fanX = chamberX + chamberW - 40;
      const fanY = chamberY + 40;
      ctx.fillStyle = '#475569';
      ctx.beginPath();
      ctx.arc(fanX, fanY, 18, 0, Math.PI * 2);
      ctx.fill();
      ctx.strokeStyle = '#94a3b8';
      ctx.stroke();

      // Airflow circulation arrows
      ctx.strokeStyle = deltaP < 0 ? '#f43f5e' : '#10b981';
      ctx.lineWidth = 2;
      ctx.beginPath();
      // Arrow from fan across bread rack
      ctx.arc(rackX, rackY, 120, -0.6 * Math.PI, 0.2 * Math.PI);
      ctx.stroke();

      // 7. Steam Injection Duct at Chamber Bottom
      if (steamSec > 0) {
        ctx.fillStyle = 'rgba(56, 189, 248, 0.55)';
        for (let s = 0; s < 5; s++) {
          const steamWave = Math.sin(Date.now() / 200 + s) * 6;
          ctx.beginPath();
          ctx.arc(chamberX + 50 + s * 35, chamberY + chamberH - 20 + steamWave, 8 + (steamSec / 15), 0, Math.PI * 2);
          ctx.fill();
        }
        ctx.fillStyle = '#38bdf8';
        ctx.font = '10px monospace';
        ctx.fillText(`STEAM QUENCH (${steamSec}s)`, chamberX + 30, chamberY + chamberH - 35);
      }

      // Labels on Canvas
      ctx.fillStyle = '#f8fafc';
      ctx.font = 'bold 11px sans-serif';
      ctx.fillText('HEAT EXCHANGER (COMBUSTION)', exchX, exchY - 12);
      ctx.fillText('ROTARY BREAD CHAMBER', chamberX + 15, chamberY - 12);
    }

    // Animation Loop
    function loop() {
      recalculateAndRender();
      requestAnimationFrame(loop);
    }
    // Run initial cycle
    recalculateAndRender();

    // Copy Engineering Audit Report Handler
    copyReportBtn.addEventListener('click', () => {
      const reportText = `ISITKITCHENSAFE ENGINEERING AUDIT: COMMERCIAL ROTARY RACK OVEN
======================================================================
Generated: ${new Date().toISOString()}
Standard: NFPA 86 Class A &bull; ANSI Z83.11 &bull; OSHA CO 50 ppm PEL

OVEN SPECIFICATION & AERODYNAMICS:
- Configuration: ${ovenSelect.options[ovenSelect.selectedIndex].text}
- Exchanger Metallurgy: ${metallurgySelect.options[metallurgySelect.selectedIndex].text}
- Burner Profile: ${burnerSelect.options[burnerSelect.selectedIndex].text}
- Bake Temperature: ${tempSlider.value}°F (${Math.round((tempSlider.value - 32) * 5 / 9)}°C)
- Daily Thermal Loading: ${cyclesSlider.value} rack cycles/day
- Static Differential Pressure (ΔP): ${pressureSlider.value} in. w.g.
- Steam Quench Duration: ${steamSlider.value} seconds/bake
- Operational Age: ${yearsSlider.value} Years
- Flue Exhaust Flow: ${flueSlider.value} CFM

DIAGNOSTIC TELEMETRY:
- Fatigue Life Consumed: ${metricFatigue.textContent}
- Aerodynamic Draft Status: ${metricInversion.textContent}
- Bake Chamber Flue Gas CO: ${metricChamberCo.textContent}
- Workplace Spill Peak Breathing CO: ${metricAmbientCo.textContent}
- Weld Fissure Risk: ${metricCrackRisk.textContent}
- NFPA 86 Relief Panel Ratio: ${metricNfpa.textContent}
- Predicted Remaining Useful Life: ${metricRemainingLife.textContent}

SAFETY STATUS & ACTION PROTOCOL:
- Status: ${reportRiskBadge.textContent}
- Primary Risk: ${reportPrimaryRisk.textContent}
- Dynamic Mechanism: ${reportMechanisms.textContent}
- Engineering Mitigation: ${reportMitigation.textContent}
======================================================================`;

      navigator.clipboard.writeText(reportText).then(() => {
        const orig = copyBtnText.textContent;
        copyBtnText.textContent = dictionary[currentLang]?.copiedFeedback || 'Report Copied!';
        setTimeout(() => {
          copyBtnText.textContent = orig;
        }, 2500);
      }).catch(() => {
        alert('Report copied to clipboard.');
      });
    });
  })();
</script>
