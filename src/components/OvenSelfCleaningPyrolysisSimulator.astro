    presetTeflonMat: "【大惨事】フッ素オーブン保護シートの入れ忘れ",
    presetSteamClean: "安全な低温スチーム水蒸気洗浄（無害）",
    diagnosticTitle: "熱分解排煙・有毒ガス診断スコアカード",
    diagnosticSub: "米国EPA空気質指数、OSHA一酸化炭素基準、鳥類獣医学データに基づくリアルタイム解析。",
    hazardScoreLabel: "室内煙霧総合危険度指数",
    peakTempLabel: "庫内最高到達温度",
    pm25Label: "室内PM2.5煙霧ピーク濃度",
    coPeakLabel: "一酸化炭素（CO）ピーク濃度",
    ufpLabel: "PTFE超微粒子（UFP）放出量",
    avianRiskLabel: "愛鳥の急性中毒・致死リスク",
    humanRiskLabel: "ヒトのポリマーヒューム熱発症確率",
    alertTitle: "環境・健康安全総合ステータス",
    tableTitle: "オーブン清掃メカニズム別 排煙比較マトリクス",
    tableSub: "各清掃方式の到達温度、フッ素分解生成物、微粒子濃度、生体安全性の比較。",
    colCycle: "清掃方式",
    colTemp: "最高温度 (°F / °C)",
    colDuration: "所要時間",
    colUfpRate: "PTFEナノ微粒子",
    colCoPlume: "CO排煙濃度",
    colAvianStatus: "愛鳥への安全性",
    rulesTitle: "消防機関＆鳥類獣医師が警告する必須安全手順",
    rulesSub: "有害ガスの吸入を防ぎ、オーブン故障を回避するための最重要ルール。",
    rule1Title: "1. 鳥類の完全避難命令（家の中に1羽も残さない）",
    rule1Text: "セルフクリーニング機能を作動させる際、絶対に家の中にインコやオウムなどの小鳥を残さないでください。鳥の呼吸器（気嚢システム）は極めて敏感で、フッ素熱分解ガス（フッ化カルボニル COF2）や超微粒子を吸入すると、わずか15〜30分で重篤な肺出血を起こし窒息死します。作動前に対象の鳥を別宅へ避難させてください。",
    rule2Title: "2. 全ての焼き網・シートの完全取り出し義務",
    rule2Text: "自走開始前に、クロムメッキの網、温度計プローブ、底面の汚れ防止シートを必ず外してください。500°Cの熱で網のメッキが劣化し、フッ素加工シートを残すと劇物ガスとなって瞬時に蒸発します。",
    rule3Title: "3. 換気扇の最大運転とキッチンの立ち入り禁止",
    rule3Text: "屋外排気型レンジフードを最強運転にし、対角の窓を開けて空気の通り道を作り、寝室へのドアを閉めてください。循環式フードは有毒ガスをろ過できません。",
    rule4Title: "4. 重曹とクエン酸・酢による安全な手動洗浄を推奨",
    rule4Text: "500°Cの超高温はオーブンの基板や温度ヒューズにも大きな熱ストレスを与えます。重曹ペーストを一晩塗布して翌朝拭き取る天然アルカリ洗浄なら、有害ガスゼロで安全に焦げ付きを落とせます。",
    copyReportBtn: "完全診断レポートをコピー",
    copiedFeedback: "レポートをクリップボードにコピーしました！"
  }
};

const t = DICTIONARY[lang] || DICTIONARY.en;
---

<div class="oven-pyrolysis-simulator bg-surface-soft border border-hairline rounded-3xl p-6 md:p-10 shadow-xs mb-12">
  <!-- Top Header Banner -->
  <div class="flex flex-wrap items-center justify-between gap-3 mb-6 border-b border-hairline/80 pb-6">
    <div class="flex items-center gap-2">
      <span class="inline-flex items-center justify-center w-8 h-8 rounded-xl bg-orange-950/20 text-orange-600 font-bold text-lg">
        🔥
      </span>
      <span class="text-xs font-bold uppercase tracking-wider text-orange-700 bg-orange-50 px-3 py-1 rounded-full border border-orange-200">
        {t.badge}
      </span>
    </div>
    <span class="text-xs font-mono text-muted bg-canvas px-3 py-1 rounded-lg border border-hairline">
      500°C (932°F) Pyrolysis • CO &amp; PTFE Toxicosis
    </span>
  </div>

  <div class="mb-8">
    <h2 class="text-2xl md:text-3xl font-extrabold text-ink tracking-tight mb-2">
      {t.title}
    </h2>
    <p class="text-body text-sm md:text-base leading-relaxed text-muted max-w-4xl">
      {t.subtitle}
    </p>
  </div>

  <!-- Quick Scenario Presets -->
  <div class="bg-canvas border border-hairline rounded-2xl p-5 mb-8">
    <span class="text-caption text-xs font-bold uppercase tracking-wider text-muted block mb-3">
      {t.presetsTitle}
    </span>
    <div class="flex flex-wrap gap-2">
      <button 
        type="button" 
        class="preset-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-surface-soft hover:bg-orange-100/70 border border-hairline text-ink transition-colors"
        data-preset="standard"
      >
        {t.presetStandard}
      </button>
      <button 
        type="button" 
        class="preset-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-surface-soft hover:bg-orange-100/70 border border-hairline text-ink transition-colors"
        data-preset="heavy-soil"
      >
        {t.presetHeavySoil}
      </button>
      <button 
        type="button" 
        class="preset-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-rose-50 hover:bg-rose-100 border border-rose-300 text-rose-800 transition-colors"
        data-preset="bird-alert"
      >
        ⚠️ {t.presetBirdAlert}
      </button>
      <button 
        type="button" 
        class="preset-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-red-950/20 hover:bg-red-900/30 border border-red-500 text-red-700 transition-colors"
        data-preset="teflon-mat"
      >
        🚨 {t.presetTeflonMat}
      </button>
      <button 
        type="button" 
        class="preset-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-emerald-50 hover:bg-emerald-100 border border-emerald-300 text-emerald-800 transition-colors"
        data-preset="steam-clean"
      >
        🌱 {t.presetSteamClean}
      </button>
    </div>
  </div>

  <!-- Main Grid: Controls vs Live Diagnostics -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mb-10">
    <!-- Controls Column (7 Cols) -->
    <div class="lg:col-span-7 space-y-6 bg-canvas border border-hairline rounded-2xl p-6 md:p-8">
      <div>
        <h3 class="text-lg font-bold text-ink mb-1">{t.controlsTitle}</h3>
        <p class="text-xs text-muted mb-4">{t.controlsSub}</p>
      </div>

      <!-- Control 1: Cycle Mode -->
      <div>
        <label for="cycle-select" class="block text-sm font-semibold text-ink mb-1">
          {t.cycleLabel}
        </label>
        <p class="text-xs text-muted mb-2">{t.cycleHelp}</p>
        <select 
          id="cycle-select" 
          class="w-full bg-surface-soft border border-hairline rounded-xl px-4 py-2.5 text-sm text-ink font-medium focus:outline-none focus:ring-2 focus:ring-orange-500"
        >
          {pyrolysisData.cycleModes.map((c) => (
            <option value={c.id} selected={c.id === 'mode-standard-3hr'}>
              {c.name}
            </option>
          ))}
        </select>
      </div>

      <!-- Control 2: Soil Burden -->
      <div>
        <label for="soil-select" class="block text-sm font-semibold text-ink mb-1">
          {t.soilLabel}
        </label>
        <p class="text-xs text-muted mb-2">{t.soilHelp}</p>
        <select 
          id="soil-select" 
          class="w-full bg-surface-soft border border-hairline rounded-xl px-4 py-2.5 text-sm text-ink font-medium focus:outline-none focus:ring-2 focus:ring-orange-500"
        >
          {pyrolysisData.soilLoads.map((s) => (
            <option value={s.id} selected={s.id === 'soil-moderate'}>
              {s.name}
            </option>
          ))}
        </select>
      </div>

      <!-- Control 3: Gasket & Fluoropolymers -->
      <div>
        <label for="gasket-select" class="block text-sm font-semibold text-ink mb-1">
          {t.fluoropolymerLabel}
        </label>
        <p class="text-xs text-muted mb-2">{t.fluoropolymerHelp}</p>
        <select 
          id="gasket-select" 
          class="w-full bg-surface-soft border border-hairline rounded-xl px-4 py-2.5 text-sm text-ink font-medium focus:outline-none focus:ring-2 focus:ring-orange-500"
        >
          {pyrolysisData.fluoropolymerSources.map((g) => (
            <option value={g.id} selected={g.id === 'fp-silicone-ptfe-gasket'}>
              {g.name}
            </option>
          ))}
        </select>
      </div>

      <!-- Control 4: Ventilation Environment -->
      <div>
        <label for="vent-select" class="block text-sm font-semibold text-ink mb-1">
          {t.ventilationLabel}
        </label>
        <p class="text-xs text-muted mb-2">{t.ventilationHelp}</p>
        <select 
          id="vent-select" 
          class="w-full bg-surface-soft border border-hairline rounded-xl px-4 py-2.5 text-sm text-ink font-medium focus:outline-none focus:ring-2 focus:ring-orange-500"
        >
          {pyrolysisData.ventilationEnvironments.map((v) => (
            <option value={v.id} selected={v.id === 'vent-recirculating-hood'}>
              {v.name}
            </option>
          ))}
        </select>
      </div>

      <!-- Control 5: Living Profile & Bird Check -->
      <div>
        <label for="vuln-select" class="block text-sm font-semibold text-ink mb-1">
          {t.vulnerabilityLabel}
        </label>
        <p class="text-xs text-muted mb-2">{t.vulnerabilityHelp}</p>
        <select 
          id="vuln-select" 
          class="w-full bg-surface-soft border border-hairline rounded-xl px-4 py-2.5 text-sm text-ink font-medium focus:outline-none focus:ring-2 focus:ring-orange-500"
        >
          {pyrolysisData.vulnerabilityProfiles.map((p) => (
            <option value={p.id} selected={p.id === 'vuln-healthy-adult'}>
              {p.name}
            </option>
          ))}
        </select>
      </div>
    </div>

    <!-- Live Diagnostics Column (5 Cols) -->
    <div class="lg:col-span-5 space-y-4">
      <div class="bg-canvas border border-hairline rounded-2xl p-6 shadow-xs">
        <span class="text-caption text-xs font-bold uppercase tracking-wider text-muted block mb-1">
          {t.diagnosticTitle}
        </span>
        <h4 class="text-base font-bold text-ink mb-4">{t.diagnosticSub}</h4>

        <!-- Main Gauge Card: Hazard Score -->
        <div id="gauge-container" class="rounded-2xl p-5 mb-5 border transition-all bg-amber-50 border-amber-300">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-semibold uppercase tracking-wider text-muted">
              {t.hazardScoreLabel}
            </span>
            <span id="hazard-badge" class="px-2.5 py-0.5 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-200 text-amber-900">
              MODERATE CAUTION
            </span>
          </div>
          <div class="flex items-baseline gap-2 mb-2">
            <span id="hazard-score" class="text-4xl md:text-5xl font-black text-ink tracking-tight font-mono">
              64
            </span>
            <span class="text-sm text-muted font-bold">/ 100</span>
          </div>
          <div class="w-full bg-hairline rounded-full h-2.5 overflow-hidden">
            <div id="hazard-progress" class="h-2.5 bg-amber-500 transition-all duration-300" style="width: 64%;"></div>
          </div>
        </div>

        <!-- Metric 1: Peak Temperature -->
        <div class="grid grid-cols-2 gap-3 mb-4">
          <div class="bg-surface-soft border border-hairline rounded-xl p-3.5">
            <span class="text-[11px] font-bold uppercase tracking-wider text-muted block mb-1">
              {t.peakTempLabel}
            </span>
            <div class="flex items-baseline gap-1">
              <span id="metric-temp" class="text-xl font-extrabold text-ink font-mono">
                875°F
              </span>
              <span id="metric-temp-c" class="text-xs text-muted font-mono">
                (468°C)
              </span>
            </div>
            <span id="metric-temp-sub" class="text-[11px] text-orange-600 block mt-1 font-medium">
              Active Grease Pyrolysis
            </span>
          </div>

          <!-- Metric 2: Peak CO -->
          <div class="bg-surface-soft border border-hairline rounded-xl p-3.5">
            <span class="text-[11px] font-bold uppercase tracking-wider text-muted block mb-1">
              {t.coPeakLabel}
            </span>
            <div class="flex items-baseline gap-1">
              <span id="metric-co" class="text-xl font-extrabold text-ink font-mono">
                28
              </span>
              <span class="text-xs text-muted font-mono">ppm</span>
            </div>
            <span id="metric-co-sub" class="text-[11px] text-muted block mt-1 font-medium">
              Near WHO 1-Hr Limit
            </span>
          </div>
        </div>

        <!-- Metric 3: PM2.5 -->
        <div class="bg-surface-soft border border-hairline rounded-xl p-3.5 mb-3">
          <div class="flex items-center justify-between mb-1">
            <span class="text-[11px] font-bold uppercase tracking-wider text-muted">
              {t.pm25Label}
            </span>
            <span id="pm25-badge" class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-amber-100 text-amber-800">
              UNHEALTHY (AQI)
            </span>
          </div>
          <div class="flex items-baseline gap-1.5">
            <span id="metric-pm25" class="text-2xl font-black text-ink font-mono">
              184
            </span>
            <span class="text-xs text-muted font-mono">μg/m³ (EPA ceiling: 55)</span>
          </div>
        </div>

        <!-- Metric 4: PTFE Ultrafine Particles -->
        <div class="bg-surface-soft border border-hairline rounded-xl p-3.5 mb-3">
          <div class="flex items-center justify-between mb-1">
            <span class="text-[11px] font-bold uppercase tracking-wider text-muted">
              {t.ufpLabel}
            </span>
            <span id="ufp-badge" class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-rose-100 text-rose-800">
              HIGH PARTICULATE
            </span>
          </div>
          <div class="flex items-baseline gap-1.5">
            <span id="metric-ufp" class="text-2xl font-black text-ink font-mono">
              72,000
            </span>
            <span class="text-xs text-muted font-mono">UFP / cm³</span>
          </div>
        </div>

        <!-- Metric 5 & 6: Avian Lethality & Human Fume Fever Risk -->
        <div class="space-y-2 pt-2 border-t border-hairline">
          <div class="flex items-center justify-between text-xs">
            <span class="text-muted font-medium">{t.avianRiskLabel}:</span>
            <span id="metric-avian-risk" class="font-bold font-mono text-rose-600">
              CRITICAL / LETHAL (100%)
            </span>
          </div>
          <div class="flex items-center justify-between text-xs">
            <span class="text-muted font-medium">{t.humanRiskLabel}:</span>
            <span id="metric-human-risk" class="font-bold font-mono text-ink">
              35% (Chills / Throat Burning)
            </span>
          </div>
        </div>
      </div>

      <!-- Dynamic Alert Banner -->
      <div id="dynamic-alert-card" class="rounded-2xl p-5 border transition-all bg-rose-50 border-rose-300 text-rose-900">
        <div class="flex items-start gap-3">
          <span id="alert-icon" class="text-2xl flex-shrink-0">⚠️</span>
          <div>
            <h5 id="alert-title" class="text-sm font-bold mb-1">
              {t.alertTitle}: Elevated Thermal Pyrolysis Hazard
            </h5>
            <p id="alert-desc" class="text-xs leading-relaxed opacity-95">
              Sustained 468°C heat is actively degrading fluoropolymers and pyrolyzing grease. Evacuate all pet birds immediately and exhaust kitchen with maximum cross-ventilation.
            </p>
          </div>
        </div>
      </div>

      <!-- Copy Action Button -->
      <button 
        type="button" 
        id="copy-report-btn" 
        class="w-full py-3 px-4 rounded-xl bg-ink hover:bg-black text-white text-center font-medium text-xs md:text-sm transition-colors shadow-xs flex items-center justify-center gap-2"
      >
        <span>📋</span>
        <span id="copy-btn-text">{t.copyReportBtn}</span>
      </button>
    </div>
  </div>

  <!-- Benchmarking Table: Oven Thermal Cycles -->
  <div class="bg-canvas border border-hairline rounded-2xl p-6 md:p-8 mb-10 overflow-x-auto">
    <div class="mb-4">
      <h3 class="text-lg font-bold text-ink mb-1">{t.tableTitle}</h3>
      <p class="text-xs text-muted">{t.tableSub}</p>
    </div>

    <table class="w-full text-left text-xs border-collapse min-w-[640px]">
      <thead>
        <tr class="border-b border-hairline bg-surface-soft text-ink font-semibold">
          <th class="py-3 px-3">{t.colCycle}</th>
          <th class="py-3 px-3">{t.colTemp}</th>
          <th class="py-3 px-3">{t.colDuration}</th>
          <th class="py-3 px-3">{t.colUfpRate}</th>
          <th class="py-3 px-3">{t.colCoPlume}</th>
          <th class="py-3 px-3">{t.colAvianStatus}</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-hairline text-muted">
        <tr class="hover:bg-surface-soft/60">
          <td class="py-3 px-3 font-semibold text-ink">Light Soil (Pyrolytic)</td>
          <td class="py-3 px-3 font-mono">800°F (427°C)</td>
          <td class="py-3 px-3 font-mono">2.0 Hours</td>
          <td class="py-3 px-3 font-mono">45,000 / cm³</td>
          <td class="py-3 px-3 font-mono">15–25 ppm</td>
          <td class="py-3 px-3 font-semibold text-rose-600">Lethal (Teflon toxicosis)</td>
        </tr>
        <tr class="hover:bg-surface-soft/60 bg-surface-soft/20">
          <td class="py-3 px-3 font-semibold text-ink">Standard Self-Clean</td>
          <td class="py-3 px-3 font-mono">875°F (468°C)</td>
          <td class="py-3 px-3 font-mono">3.0 Hours</td>
          <td class="py-3 px-3 font-mono">75,000 / cm³</td>
          <td class="py-3 px-3 font-mono">30–50 ppm</td>
          <td class="py-3 px-3 font-semibold text-rose-600">Fatal within 15–30 min</td>
        </tr>
        <tr class="hover:bg-surface-soft/60">
          <td class="py-3 px-3 font-semibold text-ink">Heavy Encrusted Soil</td>
          <td class="py-3 px-3 font-mono">932°F (500°C)</td>
          <td class="py-3 px-3 font-mono">4.5 Hours</td>
          <td class="py-3 px-3 font-mono">150,000+ / cm³</td>
          <td class="py-3 px-3 font-mono">60–120 ppm</td>
          <td class="py-3 px-3 font-semibold text-rose-700">Instant Severe Lethality</td>
        </tr>
        <tr class="hover:bg-surface-soft/60 bg-emerald-50/50">
          <td class="py-3 px-3 font-semibold text-emerald-900">AquaClean / Steam Assist</td>
          <td class="py-3 px-3 font-mono text-emerald-800">250°F (121°C)</td>
          <td class="py-3 px-3 font-mono text-emerald-800">40 Minutes</td>
          <td class="py-3 px-3 font-mono text-emerald-800">0 (Zero PTFE Breakdown)</td>
          <td class="py-3 px-3 font-mono text-emerald-800">0 ppm</td>
          <td class="py-3 px-3 font-semibold text-emerald-700">100% Safe for All Birds</td>
        </tr>
      </tbody>
    </table>
  </div>

  <!-- Evidence-Based Fire Marshal & Veterinary Protocols -->
  <div class="bg-canvas border border-hairline rounded-2xl p-6 md:p-8">
    <div class="mb-6">
      <span class="text-caption text-xs font-bold uppercase tracking-wider text-muted block mb-1">
        Evidence-Based Standards
      </span>
      <h3 class="text-lg font-bold text-ink">{t.rulesTitle}</h3>
      <p class="text-xs text-muted">{t.rulesSub}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="bg-surface-soft border border-hairline rounded-xl p-5">
        <h4 class="text-sm font-bold text-ink mb-2 text-rose-700">{t.rule1Title}</h4>
        <p class="text-xs leading-relaxed text-muted">{t.rule1Text}</p>
      </div>
      <div class="bg-surface-soft border border-hairline rounded-xl p-5">
        <h4 class="text-sm font-bold text-ink mb-2 text-amber-700">{t.rule2Title}</h4>
        <p class="text-xs leading-relaxed text-muted">{t.rule2Text}</p>
      </div>
      <div class="bg-surface-soft border border-hairline rounded-xl p-5">
        <h4 class="text-sm font-bold text-ink mb-2 text-blue-700">{t.rule3Title}</h4>
        <p class="text-xs leading-relaxed text-muted">{t.rule3Text}</p>
      </div>
      <div class="bg-surface-soft border border-hairline rounded-xl p-5">
        <h4 class="text-sm font-bold text-ink mb-2 text-emerald-700">{t.rule4Title}</h4>
        <p class="text-xs leading-relaxed text-muted">{t.rule4Text}</p>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ pyrolysisData, lang, t }}>
  document.addEventListener('DOMContentLoaded', () => {
    const cycleSelect = document.getElementById('cycle-select');
    const soilSelect = document.getElementById('soil-select');
    const gasketSelect = document.getElementById('gasket-select');
    const ventSelect = document.getElementById('vent-select');
    const vulnSelect = document.getElementById('vuln-select');

    const hazardScoreEl = document.getElementById('hazard-score');
    const hazardBadgeEl = document.getElementById('hazard-badge');
    const hazardProgressEl = document.getElementById('hazard-progress');
    const gaugeContainerEl = document.getElementById('gauge-container');

    const metricTempEl = document.getElementById('metric-temp');
    const metricTempCEl = document.getElementById('metric-temp-c');
    const metricTempSubEl = document.getElementById('metric-temp-sub');
    const metricCoEl = document.getElementById('metric-co');
    const metricCoSubEl = document.getElementById('metric-co-sub');
    const metricPm25El = document.getElementById('metric-pm25');
    const pm25BadgeEl = document.getElementById('pm25-badge');
    const metricUfpEl = document.getElementById('metric-ufp');
    const ufpBadgeEl = document.getElementById('ufp-badge');
    const metricAvianRiskEl = document.getElementById('metric-avian-risk');
    const metricHumanRiskEl = document.getElementById('metric-human-risk');

    const alertCardEl = document.getElementById('dynamic-alert-card');
    const alertIconEl = document.getElementById('alert-icon');
    const alertTitleEl = document.getElementById('alert-title');
    const alertDescEl = document.getElementById('alert-desc');

    const copyBtn = document.getElementById('copy-report-btn');
    const copyBtnText = document.getElementById('copy-btn-text');
    const presetBtns = document.querySelectorAll('.preset-btn');

    function calculate() {
      const cycleId = cycleSelect.value;
      const soilId = soilSelect.value;
      const gasketId = gasketSelect.value;
      const ventId = ventSelect.value;
      const vulnId = vulnSelect.value;

      const cycle = pyrolysisData.cycleModes.find(c => c.id === cycleId) || pyrolysisData.cycleModes[1];
      const soil = pyrolysisData.soilLoads.find(s => s.id === soilId) || pyrolysisData.soilLoads[1];
      const gasket = pyrolysisData.fluoropolymerSources.find(g => g.id === gasketId) || pyrolysisData.fluoropolymerSources[1];
      const vent = pyrolysisData.ventilationEnvironments.find(v => v.id === ventId) || pyrolysisData.ventilationEnvironments[1];
      const vuln = pyrolysisData.vulnerabilityProfiles.find(p => p.id === vulnId) || pyrolysisData.vulnerabilityProfiles[0];

      // Steam clean special zero-pyrolysis branch
      const isSteamClean = cycle.id === 'mode-steam-clean-low';

      let peakTempF = cycle.peakTempF;
      let peakTempC = cycle.peakTempC;

      // Calculate PM2.5 (μg/m³) in room (standard 40m³ kitchen volume)
      let pm25EmissionMg = soil.basePm25EmissionMg * cycle.pyrolysisIntensityMultiplier;
      let roomVolumeM3 = 40.0;
      let effectiveAch = vent.airChangesPerHour;
      let roomPm25 = isSteamClean ? 8.0 : Math.round((pm25EmissionMg / (roomVolumeM3 * (effectiveAch * 0.8 + 0.3))) * 1.5);
      if (roomPm25 < 5) roomPm25 = 5;

      // Calculate Carbon Monoxide (ppm)
      let coGrams = soil.baseCoEmissionGrams * cycle.pyrolysisIntensityMultiplier;
      let roomCoPpm = isSteamClean ? 1.0 : Math.round((coGrams * 24.45 / (roomVolumeM3 * 0.028 * (effectiveAch * 0.9 + 0.2))) * 0.45);
      if (roomCoPpm < 1) roomCoPpm = 1;

      // Calculate PTFE Ultrafine Particles (UFP / cm³)
      let ufpBaseline = gasket.ufpSheddingBaseline;
      let ufpRate = isSteamClean ? 400 : Math.round(ufpBaseline * cycle.pyrolysisIntensityMultiplier * (1 / (effectiveAch * 0.4 + 0.6)));

      // If forgotten teflon mat was left inside, skyrocket UFP
      if (soil.id === 'soil-catastrophic-liner' && !isSteamClean) {
        ufpRate = Math.max(ufpRate, 2400000);
      }

      // Calculate Hazard Score (0 - 100)
      let hazardScore = 0;
      if (!isSteamClean) {
        hazardScore = Math.min(100, Math.round(
          (roomPm25 / 12.0) + (roomCoPpm * 1.1) + (ufpRate / 40000.0 * 20.0) + (vuln.avianRiskFactor * 35.0)
        ));
        if (soil.id === 'soil-catastrophic-liner') hazardScore = 100;
        if (hazardScore < 15) hazardScore = 15;
      } else {
        hazardScore = 4;
      }

      // Avian Risk
      let isBirdPresent = vuln.id === 'vuln-pet-bird';
      let avianRiskText = '0% (Safe / No Birds)';
      if (isBirdPresent) {
        if (isSteamClean) {
          avianRiskText = '0% (Completely Safe with Steam)';
        } else if (ufpRate > 35000 || peakTempC >= 260) {
          avianRiskText = '100% FATAL LETHALITY (Avian Hemorrhage within 15-30m)';
        } else {
          avianRiskText = '65% Severe Toxicosis Risk';
        }
      }

      // Human Fume Fever & Asthma Odds
      let humanRiskText = 'Minimal (<5%)';
      if (!isSteamClean) {
        if (ufpRate > 150000 || roomCoPpm > 45) {
          humanRiskText = vuln.id === 'vuln-asthma-copd' 
            ? '95% Immediate Severe Bronchospasm' 
            : '70% Teflon Flu (Chills, Chest Pain, Fever)';
        } else if (ufpRate > 60000 || roomCoPpm > 25) {
          humanRiskText = vuln.id === 'vuln-asthma-copd'
            ? '60% Acute Asthma Attack'
            : '35% Mucous Membrane Irritation / Headache';
        } else {
          humanRiskText = '15% Mild Throat Scratch / Eye Watering';
        }
      }

      // Render Outputs
      hazardScoreEl.textContent = hazardScore;
      hazardProgressEl.style.width = `${hazardScore}%`;
      metricTempEl.textContent = `${peakTempF}°F`;
      metricTempCEl.textContent = `(${peakTempC}°C)`;
      metricCoEl.textContent = roomCoPpm;
      metricPm25El.textContent = roomPm25;
      metricUfpEl.textContent = ufpRate.toLocaleString();
      metricAvianRiskEl.textContent = avianRiskText;
      metricHumanRiskEl.textContent = humanRiskText;

      // Update Gauge Styling & Badges
      if (hazardScore <= 20) {
        hazardBadgeEl.textContent = 'MINIMAL RISK / SAFE';
        hazardBadgeEl.className = 'px-2.5 py-0.5 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800';
        gaugeContainerEl.className = 'rounded-2xl p-5 mb-5 border transition-all bg-emerald-50 border-emerald-300';
        hazardProgressEl.className = 'h-2.5 bg-emerald-500 transition-all duration-300';
        metricTempSubEl.textContent = 'Non-Pyrolytic Hydrothermal';
        metricTempSubEl.className = 'text-[11px] text-emerald-700 block mt-1 font-medium';
      } else if (hazardScore <= 60) {
        hazardBadgeEl.textContent = 'MODERATE CAUTION';
        hazardBadgeEl.className = 'px-2.5 py-0.5 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-100 text-amber-800';
        gaugeContainerEl.className = 'rounded-2xl p-5 mb-5 border transition-all bg-amber-50 border-amber-300';
        hazardProgressEl.className = 'h-2.5 bg-amber-500 transition-all duration-300';
        metricTempSubEl.textContent = 'Active Surface Pyrolysis';
        metricTempSubEl.className = 'text-[11px] text-amber-700 block mt-1 font-medium';
      } else if (hazardScore <= 85) {
        hazardBadgeEl.textContent = 'HIGH HAZARD ALERT';
        hazardBadgeEl.className = 'px-2.5 py-0.5 rounded-full text-xs font-bold uppercase tracking-wider bg-orange-100 text-orange-900';
        gaugeContainerEl.className = 'rounded-2xl p-5 mb-5 border transition-all bg-orange-50 border-orange-400';
        hazardProgressEl.className = 'h-2.5 bg-orange-600 transition-all duration-300';
        metricTempSubEl.textContent = 'Thermal Decomposition Zone';
        metricTempSubEl.className = 'text-[11px] text-orange-700 block mt-1 font-medium';
      } else {
        hazardBadgeEl.textContent = 'CRITICAL EMERGENCY LEVEL';
        hazardBadgeEl.className = 'px-2.5 py-0.5 rounded-full text-xs font-bold uppercase tracking-wider bg-rose-200 text-rose-950 font-black animate-pulse';
        gaugeContainerEl.className = 'rounded-2xl p-5 mb-5 border transition-all bg-rose-100/90 border-rose-500';
        hazardProgressEl.className = 'h-2.5 bg-rose-600 transition-all duration-300';
        metricTempSubEl.textContent = 'Extreme Pyrolytic Off-Gassing';
        metricTempSubEl.className = 'text-[11px] text-rose-800 block mt-1 font-bold';
      }

      // Update PM2.5 Badge
      if (roomPm25 > 250) {
        pm25BadgeEl.textContent = 'HAZARDOUS (EPA AQI)';
        pm25BadgeEl.className = 'text-[10px] font-bold px-2 py-0.5 rounded-full bg-rose-200 text-rose-900';
      } else if (roomPm25 > 55) {
        pm25BadgeEl.textContent = 'UNHEALTHY (AQI)';
        pm25BadgeEl.className = 'text-[10px] font-bold px-2 py-0.5 rounded-full bg-amber-100 text-amber-800';
      } else {
        pm25BadgeEl.textContent = 'GOOD / MODERATE';
        pm25BadgeEl.className = 'text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800';
      }

      // Update UFP Badge
      if (ufpRate > 150000) {
        ufpBadgeEl.textContent = 'ACUTE FUME FEVER TIER';
        ufpBadgeEl.className = 'text-[10px] font-bold px-2 py-0.5 rounded-full bg-rose-200 text-rose-900';
      } else if (ufpRate > 50000) {
        ufpBadgeEl.textContent = 'AVIAN LETHAL RANGE';
        ufpBadgeEl.className = 'text-[10px] font-bold px-2 py-0.5 rounded-full bg-orange-200 text-orange-900';
      } else {
        ufpBadgeEl.textContent = 'LOW PARTICULATE';
        ufpBadgeEl.className = 'text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800';
      }

      // Update Alert Card
      if (isBirdPresent && !isSteamClean) {
        alertCardEl.className = 'rounded-2xl p-5 border transition-all bg-rose-100 border-rose-500 text-rose-950';
        alertIconEl.textContent = '🚨';
        alertTitleEl.textContent = 'CRITICAL BIRD EVACUATION ALERT: LETHAL TEFLON TOXICOSIS';
        alertDescEl.textContent = 'Avian lungs will absorb pyrolyzed fluorocarbon gases and ultrafine particulates within minutes, resulting in rapid fatal pulmonary hemorrhage and suffocation. Remove all pet birds completely off the property before starting!';
      } else if (isSteamClean) {
        alertCardEl.className = 'rounded-2xl p-5 border transition-all bg-emerald-50 border-emerald-300 text-emerald-900';
        alertIconEl.textContent = '🌱';
        alertTitleEl.textContent = 'Non-Toxic Hydrothermal Operation';
        alertDescEl.textContent = 'Cavity temperature is capped at 121°C (250°F). Zero fluoropolymers are degraded, zero carbon monoxide is generated, and air quality remains completely safe for pet birds, infants, and asthmatics.';
      } else if (soil.id === 'soil-catastrophic-liner') {
        alertCardEl.className = 'rounded-2xl p-5 border transition-all bg-rose-100 border-rose-600 text-rose-950';
        alertIconEl.textContent = '☠️';
        alertTitleEl.textContent = 'CATASTROPHIC TEFLON MAT PYROLYSIS ALERT';
        alertDescEl.textContent = 'A non-stick PTFE liner left inside during a 500°C self-cleaning cycle vaporizes tens of grams of pure fluoropolymer directly into lethal carbonyl fluoride (COF2) and perfluoroisobutylene (PFIB). Abort cycle immediately if safe, open all windows, and evacuate.';
      } else if (hazardScore > 75) {
        alertCardEl.className = 'rounded-2xl p-5 border transition-all bg-orange-100 border-orange-400 text-orange-950';
        alertIconEl.textContent = '⚠️';
        alertTitleEl.textContent = 'Severe Indoor Air Quality Degradation';
        alertDescEl.textContent = 'Particulate matter PM2.5 and CO emissions exceed domestic safety ceilings. Ensure maximum exterior exhaust ventilation and keep vulnerable individuals out of the kitchen.';
      } else {
        alertCardEl.className = 'rounded-2xl p-5 border transition-all bg-amber-50 border-amber-300 text-amber-900';
        alertIconEl.textContent = '⚠️';
        alertTitleEl.textContent = 'Standard Pyrolysis Cycle Caution';
        alertDescEl.textContent = 'Moderate acrolein and particulate fumes detected. Run range hood on high, open opposing windows for cross-ventilation, and verify all interior racks have been removed.';
      }
    }

    // Attach Change Listeners
    [cycleSelect, soilSelect, gasketSelect, ventSelect, vulnSelect].forEach(sel => {
      sel.addEventListener('change', calculate);
    });

    // Preset Buttons
    presetBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const p = btn.getAttribute('data-preset');
        if (p === 'standard') {
          cycleSelect.value = 'mode-standard-3hr';
          soilSelect.value = 'soil-moderate';
          gasketSelect.value = 'fp-silicone-ptfe-gasket';
          ventSelect.value = 'vent-recirculating-hood';
          vulnSelect.value = 'vuln-healthy-adult';
        } else if (p === 'heavy-soil') {
          cycleSelect.value = 'mode-heavy-4hr';
          soilSelect.value = 'soil-heavy';
          gasketSelect.value = 'fp-convection-wiring';
          ventSelect.value = 'vent-closed-apartment';
          vulnSelect.value = 'vuln-asthma-copd';
        } else if (p === 'bird-alert') {
          cycleSelect.value = 'mode-standard-3hr';
          soilSelect.value = 'soil-moderate';
          gasketSelect.value = 'fp-silicone-ptfe-gasket';
          ventSelect.value = 'vent-recirculating-hood';
          vulnSelect.value = 'vuln-pet-bird';
        } else if (p === 'teflon-mat') {
          cycleSelect.value = 'mode-heavy-4hr';
          soilSelect.value = 'soil-catastrophic-liner';
          gasketSelect.value = 'fp-forgotten-mat';
          ventSelect.value = 'vent-closed-apartment';
          vulnSelect.value = 'vuln-pet-bird';
        } else if (p === 'steam-clean') {
          cycleSelect.value = 'mode-steam-clean-low';
          soilSelect.value = 'soil-trace';
          gasketSelect.value = 'fp-vitreous-fiberglass';
          ventSelect.value = 'vent-ducted-hood-med';
          vulnSelect.value = 'vuln-healthy-adult';
        }
        calculate();
      });
    });

    // Copy Report to Clipboard
    copyBtn.addEventListener('click', async () => {
      const report = `=====================================================================
ISITKITCHENSAFE OVEN PYROLYSIS & PTFE OFF-GASSING REPORT
=====================================================================
Cycle Mode:       ${cycleSelect.options[cycleSelect.selectedIndex].text}
Soil Load:        ${soilSelect.options[soilSelect.selectedIndex].text}
Internal Gasket:  ${gasketSelect.options[gasketSelect.selectedIndex].text}
Ventilation:      ${ventSelect.options[ventSelect.selectedIndex].text}
Biological Tier:  ${vulnSelect.options[vulnSelect.selectedIndex].text}

DIAGNOSTIC OUTCOMES:
- Hazard Score:       ${hazardScoreEl.textContent} / 100 (${hazardBadgeEl.textContent})
- Peak Cavity Temp:   ${metricTempEl.textContent} ${metricTempCEl.textContent}
- Peak Indoor PM2.5:  ${metricPm25El.textContent} μg/m³ (${pm25BadgeEl.textContent})
- Peak Carbon Monox:  ${metricCoEl.textContent} ppm
- PTFE Ultrafine:     ${metricUfpEl.textContent} UFP/cm³ (${ufpBadgeEl.textContent})
- Avian Lethality:    ${metricAvianRiskEl.textContent}
- Human Fume Fever:   ${metricHumanRiskEl.textContent}

EVIDENCE-BASED SAFETY DIRECTIVES:
1. Birds: Must be 100% evacuated off-premises for 24h prior to pyrolytic cleaning.
2. Racks & Liners: All chrome racks, pans, and non-stick mats must be removed.
3. Ventilation: Run exterior-vented ducted hood on high + open cross-breeze windows.
4. Non-Toxic Option: Use baking soda + water paste overnight + vinegar spritz.
=====================================================================
Generated by IsItKitchenSafe.com (Evidence-Based Appliance Safety Tools)`;

      try {
        await navigator.clipboard.writeText(report);
        const originalText = copyBtnText.textContent;
        copyBtnText.textContent = t.copiedFeedback;
        setTimeout(() => {
          copyBtnText.textContent = originalText;
        }, 2500);
      } catch (err) {
        console.error('Failed to copy to clipboard:', err);
      }
    });

    // Initial Calculation Run
    calculate();
  });
</script>
