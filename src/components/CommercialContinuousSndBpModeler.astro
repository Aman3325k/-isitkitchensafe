          <text x="25" y="80" text-anchor="middle" font-size="10" font-bold" fill="#34d399">Dry Puffed Crisp</text>
          <text x="25" y="94" text-anchor="middle" font-size="8" font-mono" fill="#a7f3d0">aw &le; 0.18</text>
        </g>

        <!-- Safety Atmosphere Monitoring Banner (OSHA O2 sensor) -->
        <g id="unit-o2-monitor" transform="translate(680, 15)">
          <rect x="0" y="0" width="190" height="35" rx="8" fill="#1e1b4b" stroke="#818cf8" stroke-width="1.5" />
