              <td class="px-4 py-2.5">{m.shockDepressurizationThresholdBar} bar</td>
              <td class="px-4 py-2.5 font-bold text-cyan-400">4.5&ndash;5.2x</td>
              <td class="px-4 py-2.5 text-emerald-400">&le; {m.targetResidualMoisturePct <= 2.0 ? '0.16' : '0.20'}</td>
              <td class="px-4 py-2.5 text-teal-400">{m.antioxidantRetentionPct}%</td>
            </tr>
          ))}
        </tbody>
