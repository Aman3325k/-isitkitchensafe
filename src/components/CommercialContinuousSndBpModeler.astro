<!-- Real-time Mathematical Engine & Interactive Scripts -->
<script is:inline define:vars={{ sndData }}>
  (function initSndBpModeler() {
    // DOM Elements
    const systemSelect = document.getElementById('system-select');
    const matrixSelect = document.getElementById('matrix-select');
    const injectorSelect = document.getElementById('injector-select');
    const chamberSelect = document.getElementById('chamber-select');

    const pressureSlider = document.getElementById('pressure-slider');
    const tempSlider = document.getElementById('temp-slider');
    const vacuumSlider = document.getElementById('vacuum-slider');
    const residenceSlider = document.getElementById('residence-slider');
    const feedSlider = document.getElementById('feed-slider');

    const pressureVal = document.getElementById('pressure-val');
    const tempVal = document.getElementById('temp-val');
    const vacuumVal = document.getElementById('vacuum-val');
    const residenceVal = document.getElementById('residence-val');
    const feedVal = document.getElementById('feed-val');

    const telemetryMoisture = document.getElementById('telemetry-moisture');
    const telemetryPorosity = document.getElementById('telemetry-porosity');
    const telemetryViability = document.getElementById('telemetry-viability');
    const telemetryAw = document.getElementById('telemetry-aw');
    const telemetryCrispness = document.getElementById('telemetry-crispness');
    const telemetryLn2 = document.getElementById('telemetry-ln2');
    const telemetryOutput = document.getElementById('telemetry-output');
    const telemetryStatus = document.getElementById('telemetry-status');
    const telemetryDetail = document.getElementById('telemetry-detail');

    const barMoisture = document.getElementById('bar-moisture');
    const barPorosity = document.getElementById('bar-porosity');
    const barViability = document.getElementById('bar-viability');
    const barAw = document.getElementById('bar-aw');
    const barCrispness = document.getElementById('bar-crispness');
    const barLn2 = document.getElementById('bar-ln2');

    const subMoisture = document.getElementById('sub-moisture');
    const subPorosity = document.getElementById('sub-porosity');
    const subViability = document.getElementById('sub-viability');
    const subAw = document.getElementById('sub-aw');
    const subCrispness = document.getElementById('sub-crispness');
    const subLn2 = document.getElementById('sub-ln2');

    const safetyBadge = document.getElementById('safety-badge');
    const svgPumpP = document.getElementById('svg-pump-p');
    const svgReactorState = document.getElementById('svg-reactor-state');
    const svgVacP = document.getElementById('svg-vac-p');
    const svgO2Led = document.getElementById('svg-o2-led');
    const svgO2Val = document.getElementById('svg-o2-val');

    function calculateMetrics() {
      const currentSystem = sndData.systemArchitectures.find(s => s.id === systemSelect.value) || sndData.systemArchitectures[0];
      const currentMatrix = sndData.targetMatrices.find(m => m.id === matrixSelect.value) || sndData.targetMatrices[0];
      const currentInjector = sndData.cryogenicInjectors.find(i => i.id === injectorSelect.value) || sndData.cryogenicInjectors[0];
      const currentChamber = sndData.expansionAtmospheres.find(c => c.id === chamberSelect.value) || sndData.expansionAtmospheres[0];

      const Pinj = parseFloat(pressureSlider.value);
      const Tn2 = parseFloat(tempSlider.value);
      const Pexp = parseFloat(vacuumSlider.value);
      const tres = parseFloat(residenceSlider.value);
      const Qfeed = parseFloat(feedSlider.value);

      // Check Hazard Condition
      const isHazard = (
        currentInjector.id === 'conventional_batch_freeze_dryer_plate' ||
        currentChamber.id === 'uncontrolled_ambient_air_flash_zone' ||
        Pinj < 22.0 ||
        Tn2 > -155.0 ||
        Pexp > 500.0
      );

      // 1. Porosity & Expansion Ratio Calculation
      // Base expansion depends on pressure ratio (Pinj / Pexp) and saturation efficiency
      const pressureRatio = Math.max(1.0, (Pinj * 1000.0) / Math.max(0.1, Pexp));
      let expansionRatio = 1.0 + (Math.log10(pressureRatio) * 0.95) * (currentInjector.saturationEfficiencyPct / 100.0);
      if (tres < 5.0) {
        expansionRatio *= (tres / 5.0);
      }
      if (currentInjector.id === 'conventional_batch_freeze_dryer_plate') {
        expansionRatio = 1.15;
      }
      if (currentChamber.id === 'uncontrolled_ambient_air_flash_zone') {
        expansionRatio = 1.25; // collapsed
      }
      expansionRatio = Math.max(1.0, Math.min(6.2, expansionRatio));

      // 2. Residual Moisture & Water Activity (aw)
      let flashMoistureRemoval = currentChamber.flashMoistureRemovalPct;
      if (Pexp > 1.0) {
        flashMoistureRemoval *= Math.max(0.35, 1.0 - (Math.log10(Pexp) * 0.22));
      }
      if (currentInjector.id === 'conventional_batch_freeze_dryer_plate') {
        flashMoistureRemoval = 30.0;
      }

      const initialMoisture = currentMatrix.initialMoisturePct;
      const dryMatterRatio = (100.0 - initialMoisture) / 100.0;
      let residualMoisture = (initialMoisture * (100.0 - flashMoistureRemoval)) / 100.0;
      if (isHazard) {
        residualMoisture = Math.max(12.5, residualMoisture * 3.5);
      } else {
        residualMoisture = Math.max(1.2, Math.min(8.5, residualMoisture));
      }

      // Water Activity (GAB / BET isotherm approximation)
      let aw = 0.08 + (residualMoisture / 100.0) * 3.8;
      if (Pexp < 0.2) aw *= 0.85;
      if (isHazard) aw = Math.max(0.55, aw * 2.2);
      aw = Math.max(0.10, Math.min(0.85, aw));

      // 3. Probiotic & Bioactive Viability Retention (%)
      let viability = currentMatrix.antioxidantRetentionPct;
      // Below eutectic point (T < matrix.eutecticPointC), high viability
      const subZeroMargin = currentMatrix.eutecticPointC - Tn2; // e.g. -32 - (-185) = 153 deg margin
      if (subZeroMargin > 80.0 && !isHazard) {
        viability = Math.min(99.6, viability + 0.8);
      } else if (isHazard) {
        viability = Math.max(8.0, viability * 0.18);
      }
      if (currentInjector.id === 'conventional_batch_freeze_dryer_plate') {
        viability = 14.5; // massive ice crystal lysis
      }

      // 4. Sensory Crispness (Peak Force in Newtons)
      // Ideal crispness is 11–16 N; rubbery/collapsed is >35 N or <4 N
      let crispnessForce = 13.5;
      if (expansionRatio > 4.0) {
        crispnessForce = 16.0 - (expansionRatio - 4.0) * 2.0;
      } else {
        crispnessForce = 22.0 + (4.0 - expansionRatio) * 6.0;
      }
      if (isHazard) {
        crispnessForce = 38.0; // rubbery collapsed chewy
      }
      crispnessForce = Math.max(4.0, Math.min(45.0, crispnessForce));

      // 5. Specific LN2 Consumption (kg LN2 / kg dry product)
      let ln2Ratio = currentSystem.specificNitrogenConsumptionKgPerKg * (Pinj / 40.0) * (Math.abs(Tn2) / 185.0);
      if (isHazard) ln2Ratio *= 1.8;

      // 6. Continuous Dry Production Output
      const dryOutputKgH = Qfeed * dryMatterRatio * (1.0 + (residualMoisture / 100.0));

      // Render Outputs
      pressureVal.textContent = `${Pinj.toFixed(1)} bar`;
      tempVal.textContent = `${Tn2.toFixed(1)} °C`;
      vacuumVal.textContent = `${Pexp.toFixed(2)} mbar`;
      residenceVal.textContent = `${tres.toFixed(1)} s`;
      feedVal.textContent = `${Math.round(Qfeed)} kg/h`;

      telemetryMoisture.textContent = `${residualMoisture.toFixed(1)}%`;
      barMoisture.style.width = `${Math.min(100, (residualMoisture / 10.0) * 100)}%`;
      subMoisture.textContent = `Target &le; 2.5% | Flash Loss ${flashMoistureRemoval.toFixed(1)}%`;

      telemetryPorosity.textContent = `${expansionRatio.toFixed(1)}x`;
      barPorosity.style.width = `${Math.min(100, (expansionRatio / 6.0) * 100)}%`;
      subPorosity.textContent = `Honeycomb Pore Vol: ${(expansionRatio * 18.0).toFixed(1)}%`;

      telemetryViability.textContent = `${viability.toFixed(1)}%`;
      barViability.style.width = `${Math.min(100, viability)}%`;
      subViability.textContent = viability > 90 ? 'Vitrified Amorphous State | Zero Intracellular Shearing' : 'Intracellular Ice Damage / Severe Lysis';

      telemetryAw.textContent = aw.toFixed(2);
      barAw.style.width = `${Math.min(100, aw * 100)}%`;
      subAw.textContent = aw <= 0.25 ? 'Microbial Stasis aw &le; 0.25 (Safe)' : 'Critical Water Activity (Microbial Risk)';

      telemetryCrispness.textContent = `${crispnessForce.toFixed(1)} N`;
      barCrispness.style.width = `${Math.min(100, (crispnessForce / 40.0) * 100)}%`;
      subCrispness.textContent = (crispnessForce >= 10 && crispnessForce <= 18) ? 'Optimal Brittle Acoustic Crunch (10–18 N)' : 'Sensory Defect (Rubbery/Dense)';

      telemetryLn2.textContent = `${ln2Ratio.toFixed(2)} kg/kg`;
      barLn2.style.width = `${Math.min(100, (ln2Ratio / 3.0) * 100)}%`;

      telemetryOutput.textContent = `${Math.round(dryOutputKgH)} kg/h (Dry Mass)`;

      // Safety Status Evaluation
      if (isHazard) {
        safetyBadge.className = 'inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-rose-950 text-rose-300 border border-rose-800';
        safetyBadge.textContent = 'Atmospheric Flashing / Collapse Hazard Active';
        telemetryStatus.className = 'font-bold text-rose-400';
        telemetryStatus.textContent = 'CRITICAL PROCESS COLLAPSE / HIGH MOISTURE HAZARD';
        telemetryDetail.innerHTML = '<span class="text-rose-400 font-bold">WARNING:</span> Atmospheric water vapor condensing onto sub-zero product surfaces. Matrix collapsing into dense rubbery state with &gt;85% probiotic mortality. Immediately engage high-vacuum sublimation lock.';
        svgO2Led.setAttribute('fill', '#ef4444');
        svgO2Val.textContent = '17.8% (ALARM)';
        svgO2Val.setAttribute('fill', '#f87171');
      } else {
        safetyBadge.className = 'inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-950 text-emerald-300 border border-emerald-800';
        safetyBadge.textContent = 'Cryo-Seal & O2 Safety: Nominal';
        telemetryStatus.className = 'font-bold text-emerald-400';
        telemetryStatus.textContent = 'OPTIMAL CONTINUOUS FLASH VITRIFICATION';
        telemetryDetail.innerHTML = `Cryogenic saturation at ${Pinj.toFixed(1)} bar &bull; Flash sublimating micro-voids across De Laval orifice &bull; Ambient room oxygen: 20.9% (Nominal Safe)`;
        svgO2Led.setAttribute('fill', '#22c55e');
        svgO2Val.textContent = '20.9%';
        svgO2Val.setAttribute('fill', '#4ade80');
      }

      // Update SVG diagram labels
      if (svgPumpP) svgPumpP.textContent = `${Pinj.toFixed(1)} bar`;
      if (svgReactorState) svgReactorState.textContent = `P: ${Pinj.toFixed(0)} bar | ${Tn2.toFixed(0)}°C`;
      if (svgVacP) svgVacP.textContent = `P_exp: ${Pexp.toFixed(2)} mbar`;
    }

    // Preset Handlers
    document.querySelectorAll('.preset-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        const p = this.getAttribute('data-preset');
        if (p === 'probiotic') {
          systemSelect.value = 'continuous_cryogenic_snd_bp_skid';
          matrixSelect.value = 'probiotic_fruit_puree_cubes';
          injectorSelect.value = 'multi_orifice_micro_jet_infuser';
          chamberSelect.value = 'continuous_high_vacuum_sublimation_chamber';
          pressureSlider.value = '42.0';
          tempSlider.value = '-185.0';
          vacuumSlider.value = '0.10';
          residenceSlider.value = '15.0';
          feedSlider.value = '500';
        } else if (p === 'berry') {
          systemSelect.value = 'sanitary_supersonic_shock_puffer_reactor';
          matrixSelect.value = 'wild_nordic_berry_crisps';
          injectorSelect.value = 'supersonic_shock_depressurization_nozzle';
          chamberSelect.value = 'continuous_high_vacuum_sublimation_chamber';
          pressureSlider.value = '38.0';
          tempSlider.value = '-175.0';
          vacuumSlider.value = '0.15';
          residenceSlider.value = '10.0';
          feedSlider.value = '650';
        } else if (p === 'collagen') {
          systemSelect.value = 'dual_stage_infusion_sublimation_loop';
          matrixSelect.value = 'marine_collagen_peptide_foam';
          injectorSelect.value = 'dual_fluid_vortex_cryogenic_atomizer';
          chamberSelect.value = 'continuous_high_vacuum_sublimation_chamber';
          pressureSlider.value = '48.0';
          tempSlider.value = '-190.0';
          vacuumSlider.value = '0.08';
          residenceSlider.value = '20.0';
          feedSlider.value = '400';
        } else if (p === 'coffee') {
          systemSelect.value = 'continuous_cryogenic_snd_bp_skid';
          matrixSelect.value = 'specialty_coffee_extract_beads';
          injectorSelect.value = 'multi_orifice_micro_jet_infuser';
          chamberSelect.value = 'low_pressure_inert_nitrogen_buffer_chamber';
          pressureSlider.value = '45.0';
          tempSlider.value = '-180.0';
          vacuumSlider.value = '35.0';
          residenceSlider.value = '12.0';
          feedSlider.value = '600';
        } else if (p === 'hazard') {
          systemSelect.value = 'cleanroom_pilot_modular_snd_skid';
          matrixSelect.value = 'probiotic_fruit_puree_cubes';
          injectorSelect.value = 'conventional_batch_freeze_dryer_plate';
          chamberSelect.value = 'uncontrolled_ambient_air_flash_zone';
          pressureSlider.value = '20.0';
          tempSlider.value = '-150.0';
          vacuumSlider.value = '1013.0';
          residenceSlider.value = '2.0';
          feedSlider.value = '1200';
        }
        calculateMetrics();
      });
    });

    // Event Listeners
    [systemSelect, matrixSelect, injectorSelect, chamberSelect].forEach(el => {
      el.addEventListener('change', calculateMetrics);
    });
    [pressureSlider, tempSlider, vacuumSlider, residenceSlider, feedSlider].forEach(el => {
      el.addEventListener('input', calculateMetrics);
    });

    // Initial Calculation
    calculateMetrics();
  })();
</script>
