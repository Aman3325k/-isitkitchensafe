          <path d="M 35 45 L 65 45 M 50 30 L 50 60" stroke="#38bdf8" stroke-width="3" stroke-linecap="round" />
          <text x="50" y="90" text-anchor="middle" font-size="10" font-weight="bold" fill="#f8fafc">Cryo-Pump</text>
          <text x="50" y="103" text-anchor="middle" font-size="9" font-mono" fill="#38bdf8" id="svg-pump-p">42.0 bar</text>
        </g>

        <!-- Pipeline: Pump to Saturation Reactor -->
        <path d="M 310 170 L 360 170" stroke="#06b6d4" stroke-width="4" />

        <!-- Unit 3: Biomass Feed Hopper -->
        <g id="unit-feed" transform="translate(370, 20)">
