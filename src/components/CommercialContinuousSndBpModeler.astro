    matrixHelp: "凍結濃縮プロバイオティクスピューレキューブ、野生北欧リンゴンベリー、海洋コラーゲンペプチド微細発泡、水出しコーヒー抽出芳香ビーズ、スピルリナハニカムを選択。",
    injectorLabel: "極低温インジェクター形状＆流体力学：",
    injectorHelp: "多孔微細ジェット含浸器、超音速ラバール減圧ショックノズル、二流体渦流アトマイザー、従来型静置凍結乾燥棚（危険/低効率）を選択。",
    chamberLabel: "減圧フラッシュ雰囲気＆脱水真空圧力：",
    chamberHelp: "連続高真空昇華チャンバー（0.1 mbar）、不活性窒素緩衝チャンバー（35 mbar）、常圧低温チャンバー、大気湿潤空気直接減圧（危険）を選択。",
    pressureLabel: "窒素含浸圧力 (P_inj)：",
    pressureHelp: "極低温高圧容器内の飽和作動圧力（20.0〜60.0 bar）。溶解ガス濃度と微細孔膨張比を決定します。",
    tempLabel: "極低温液体窒素温度 (T_N2)：",
    tempHelp: "含浸流体温度（-150.0〜-196.0 °C）。瞬時ガラス転移凍結を維持するため共晶点（T < -35°C）以下に厳密管理。",
    vacuumLabel: "膨張チャンバー絶対真空度 (P_exp)：",
    vacuumHelp: "受入チャンバー圧力（0.05〜1013.0 mbar）。水の三重点以下の超低圧領域で微小氷晶の高速非加熱昇華を実現。",
    residenceLabel: "極低温高圧含浸滞留時間 (t_res)：",
    residenceHelp: "高圧飽和域内での原料滞留時間（1.0〜90.0 秒）。細胞内部深部への完全含浸を担保。",
    feedRateLabel: "連続バイオマス原料供給量 (Q_feed)：",
    feedRateHelp: "連続極低温脱水スキッドの湿原料スループット（50〜1,500 kg/h）。",
    presetsTitle: "工業用極低温プロセスプリセット：",
    presetProbiotic: "生プロバイオティクスピューレ膨化＆ガラス固化（aw 0.18、生菌生存率 98.5%）",
    presetBerry: "野生北欧ベリー丸ごとショッククリスプ脱水（aw 0.22、アントシアニン残存率 99.4%）",
    presetCollagen: "海洋コラーゲン開気孔スポンジ微細発泡（aw 0.15、熱変性・臭気ゼロ）",
    presetCoffee: "水出しコーヒー揮発性アロマ高保持ビーズ（aw 0.19、テルペン残存率 97.8%）",
    presetHazard: "大気中温湿気直接減圧＆融解崩壊ハザード（重大危険）",
    diagnosticTitle: "リアルタイム SND-BP テレメトリ解析＆微細物理構造",
    diagnosticSub: "残留水分、多孔質体積膨張比、プロバイオティクス生菌生存率、水分活性 (aw)、破壊破断力、液体窒素原単位を連続シミュレート。",
    moistureLabel: "乾燥最終残存水分率：",
    porosityLabel: "ハニカム多孔質体積膨張比：",
    viabilityLabel: "プロバイオティクス生菌・栄養残存率：",
    awLabel: "平衡水分活性 (aw)：",
    crispnessLabel: "破断スナックピーク破壊力：",
    ln2ConsumptionLabel: "液体窒素消費原単位 (kg/kg)：",
    throughputLabel: "乾燥製品連続純生産量：",
    statusLabel: "極低温・酸素欠乏安全インターロック：",
    diagramTitle: "連続式超臨界極低温液体窒素ショック脱水・膨化スキッド構成系統図",
    diagramSub: "極低温液体窒素断熱タンク、高圧超低温プランジャーポンプ、連続高圧含浸反応器、ラバール超音速ノズル、真空昇華ベルト、および室内O2酸素濃度監視センサー群。",
    scienceTitle: "SND-BP 科学的基礎理論と極低温熱力学機構",
    scienceSub: "超臨界窒素相平衡図、ジュール＝トムソン超音速断熱膨張、ワイブル破壊力学理論、極低温安全規制の包括的解説。",
    tableTitle: "商用装置エンジニアリング仕様と原料熱物理定数基準"
  }
};

const d = DICT[lang] || DICT.en;
---

<div class="bg-surface border border-hairline rounded-3xl p-6 sm:p-8 lg:p-10 shadow-xs mb-10 text-ink">
  <!-- Top Banner / Badge -->
  <div class="flex flex-wrap items-center justify-between gap-4 mb-6 pb-6 border-b border-hairline/60">
    <div class="flex items-center gap-3">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-cyan-950 text-cyan-200 border border-cyan-800">
        <svg class="w-3.5 h-3.5 text-cyan-400 animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        {d.badge}
      </span>
      <span class="text-xs font-mono text-muted">
        ASME Sec VIII &bull; CGA P-12 &bull; OSHA 1910.146 &bull; 3-A 23-06
      </span>
    </div>
    <div class="flex items-center gap-2">
      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-950 text-emerald-300 border border-emerald-800" id="safety-badge">
        Cryo-Seal &amp; O2 Safety: Nominal
      </span>
    </div>
  </div>

  <!-- Header -->
  <div class="mb-8">
    <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-ink tracking-tight mb-4">
      {d.title}
    </h1>
    <p class="text-body text-base sm:text-lg leading-relaxed max-w-5xl">
      {d.subtitle}
    </p>
  </div>

  <!-- Presets -->
  <div class="bg-surface-soft border border-hairline rounded-2xl p-4 sm:p-5 mb-8">
    <div class="text-xs font-bold uppercase tracking-wider text-muted mb-3 flex items-center gap-2">
      <svg class="w-4 h-4 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
      </svg>
      {d.presetsTitle}
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-2.5">
      <button type="button" class="preset-btn px-3 py-2 text-xs font-medium rounded-xl border border-hairline/80 bg-surface hover:bg-cyan-950 hover:text-cyan-200 hover:border-cyan-700 transition-colors text-left" data-preset="probiotic">
        🍓 {d.presetProbiotic}
      </button>
      <button type="button" class="preset-btn px-3 py-2 text-xs font-medium rounded-xl border border-hairline/80 bg-surface hover:bg-cyan-950 hover:text-cyan-200 hover:border-cyan-700 transition-colors text-left" data-preset="berry">
        🫐 {d.presetBerry}
      </button>
      <button type="button" class="preset-btn px-3 py-2 text-xs font-medium rounded-xl border border-hairline/80 bg-surface hover:bg-cyan-950 hover:text-cyan-200 hover:border-cyan-700 transition-colors text-left" data-preset="collagen">
        🧬 {d.presetCollagen}
      </button>
      <button type="button" class="preset-btn px-3 py-2 text-xs font-medium rounded-xl border border-hairline/80 bg-surface hover:bg-cyan-950 hover:text-cyan-200 hover:border-cyan-700 transition-colors text-left" data-preset="coffee">
        ☕ {d.presetCoffee}
      </button>
      <button type="button" class="preset-btn px-3 py-2 text-xs font-medium rounded-xl border border-rose-900/50 bg-rose-950/20 text-rose-300 hover:bg-rose-900/40 hover:border-rose-600 transition-colors text-left" data-preset="hazard">
        ⚠️ {d.presetHazard}
      </button>
    </div>
  </div>

  <!-- Interactive Controls & Live Diagnostics Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-10">
    <!-- Controls (Left 6 Cols) -->
    <div class="lg:col-span-6 bg-surface-soft border border-hairline rounded-2xl p-6 flex flex-col justify-between shadow-xs">
      <div>
        <div class="border-b border-hairline pb-4 mb-6">
          <h2 class="text-lg font-bold text-ink mb-1">{d.controlsTitle}</h2>
          <p class="text-xs text-muted leading-relaxed">{d.controlsSub}</p>
        </div>

        <div class="space-y-5">
          <!-- System Architecture -->
          <div>
            <label class="block text-xs font-semibold text-ink uppercase tracking-wider mb-1" for="system-select">
              {d.systemLabel}
            </label>
            <select id="system-select" class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-sm text-ink focus:outline-none focus:border-cyan-500 font-mono">
              {sndData.systemArchitectures.map(s => (
                <option value={s.id}>{s.name}</option>
              ))}
            </select>
            <p class="text-[11px] text-muted mt-1 leading-normal">{d.systemHelp}</p>
          </div>

          <!-- Biomass Matrix -->
          <div>
            <label class="block text-xs font-semibold text-ink uppercase tracking-wider mb-1" for="matrix-select">
              {d.matrixLabel}
            </label>
            <select id="matrix-select" class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-sm text-ink focus:outline-none focus:border-cyan-500 font-mono">
              {sndData.targetMatrices.map(m => (
                <option value={m.id}>{m.name}</option>
              ))}
            </select>
            <p class="text-[11px] text-muted mt-1 leading-normal">{d.matrixHelp}</p>
          </div>

          <!-- Injector Geometry -->
          <div>
            <label class="block text-xs font-semibold text-ink uppercase tracking-wider mb-1" for="injector-select">
              {d.injectorLabel}
            </label>
            <select id="injector-select" class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-sm text-ink focus:outline-none focus:border-cyan-500 font-mono">
              {sndData.cryogenicInjectors.map(inj => (
                <option value={inj.id}>{inj.name}</option>
              ))}
            </select>
            <p class="text-[11px] text-muted mt-1 leading-normal">{d.injectorHelp}</p>
          </div>

          <!-- Expansion Atmosphere -->
          <div>
            <label class="block text-xs font-semibold text-ink uppercase tracking-wider mb-1" for="chamber-select">
              {d.chamberLabel}
            </label>
            <select id="chamber-select" class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-sm text-ink focus:outline-none focus:border-cyan-500 font-mono">
              {sndData.expansionAtmospheres.map(atm => (
                <option value={atm.id}>{atm.name}</option>
              ))}
            </select>
            <p class="text-[11px] text-muted mt-1 leading-normal">{d.chamberHelp}</p>
          </div>

          <!-- Pressure Slider -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label class="text-xs font-semibold text-ink uppercase tracking-wider" for="pressure-slider">
                {d.pressureLabel}
              </label>
              <span class="text-sm font-bold font-mono text-cyan-400" id="pressure-val">42.0 bar</span>
            </div>
            <input type="range" id="pressure-slider" min="20.0" max="60.0" step="0.5" value="42.0" class="w-full accent-cyan-500 cursor-pointer" />
            <p class="text-[11px] text-muted mt-1">{d.pressureHelp}</p>
          </div>

          <!-- Cryogenic Temperature Slider -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label class="text-xs font-semibold text-ink uppercase tracking-wider" for="temp-slider">
                {d.tempLabel}
              </label>
              <span class="text-sm font-bold font-mono text-cyan-400" id="temp-val">-185.0 °C</span>
            </div>
            <input type="range" id="temp-slider" min="-196.0" max="-150.0" step="1.0" value="-185.0" class="w-full accent-cyan-500 cursor-pointer" />
            <p class="text-[11px] text-muted mt-1">{d.tempHelp}</p>
          </div>

          <!-- Chamber Vacuum Slider -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label class="text-xs font-semibold text-ink uppercase tracking-wider" for="vacuum-slider">
                {d.vacuumLabel}
              </label>
              <span class="text-sm font-bold font-mono text-cyan-400" id="vacuum-val">0.10 mbar</span>
            </div>
            <input type="range" id="vacuum-slider" min="0.05" max="200.0" step="0.05" value="0.10" class="w-full accent-cyan-500 cursor-pointer" />
            <p class="text-[11px] text-muted mt-1">{d.vacuumHelp}</p>
          </div>

          <!-- Residence Time Slider -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label class="text-xs font-semibold text-ink uppercase tracking-wider" for="residence-slider">
                {d.residenceLabel}
              </label>
              <span class="text-sm font-bold font-mono text-cyan-400" id="residence-val">12.0 s</span>
            </div>
            <input type="range" id="residence-slider" min="1.0" max="90.0" step="1.0" value="12.0" class="w-full accent-cyan-500 cursor-pointer" />
            <p class="text-[11px] text-muted mt-1">{d.residenceHelp}</p>
          </div>

          <!-- Feed Rate Slider -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label class="text-xs font-semibold text-ink uppercase tracking-wider" for="feed-slider">
                {d.feedRateLabel}
              </label>
              <span class="text-sm font-bold font-mono text-cyan-400" id="feed-val">500 kg/h</span>
            </div>
            <input type="range" id="feed-slider" min="50" max="1500" step="25" value="500" class="w-full accent-cyan-500 cursor-pointer" />
            <p class="text-[11px] text-muted mt-1">{d.feedRateHelp}</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Live Telemetry & Engineering Indicators (Right 6 Cols) -->
    <div class="lg:col-span-6 bg-surface-soft border border-hairline rounded-2xl p-6 flex flex-col justify-between shadow-xs">
      <div>
        <div class="border-b border-hairline pb-4 mb-6">
          <h2 class="text-lg font-bold text-ink mb-1">{d.diagnosticTitle}</h2>
          <p class="text-xs text-muted leading-relaxed">{d.diagnosticSub}</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
          <!-- Moisture Reduction Card -->
          <div class="bg-surface border border-hairline rounded-xl p-4">
            <span class="text-[11px] font-bold text-muted uppercase tracking-wider block mb-1">
              {d.moistureLabel}
            </span>
            <div class="text-2xl font-black font-mono text-cyan-400 mb-1" id="telemetry-moisture">
              2.1%
            </div>
            <div class="w-full bg-surface-soft rounded-full h-1.5 overflow-hidden border border-hairline mb-1">
              <div id="bar-moisture" class="bg-cyan-500 h-full rounded-full transition-all duration-300" style="width: 25%;"></div>
            </div>
            <span class="text-[10px] text-muted font-mono" id="sub-moisture">Target &le; 2.5% | Flash Loss 97.4%</span>
          </div>

          <!-- Porosity Expansion Card -->
          <div class="bg-surface border border-hairline rounded-xl p-4">
            <span class="text-[11px] font-bold text-muted uppercase tracking-wider block mb-1">
              {d.porosityLabel}
            </span>
            <div class="text-2xl font-black font-mono text-emerald-400 mb-1" id="telemetry-porosity">
              4.6x
            </div>
            <div class="w-full bg-surface-soft rounded-full h-1.5 overflow-hidden border border-hairline mb-1">
              <div id="bar-porosity" class="bg-emerald-500 h-full rounded-full transition-all duration-300" style="width: 85%;"></div>
            </div>
            <span class="text-[10px] text-muted font-mono" id="sub-porosity">Honeycomb Pore Vol: 82.4%</span>
          </div>

          <!-- Probiotic Viability Card -->
          <div class="bg-surface border border-hairline rounded-xl p-4">
            <span class="text-[11px] font-bold text-muted uppercase tracking-wider block mb-1">
              {d.viabilityLabel}
            </span>
            <div class="text-2xl font-black font-mono text-teal-400 mb-1" id="telemetry-viability">
              98.6%
            </div>
            <div class="w-full bg-surface-soft rounded-full h-1.5 overflow-hidden border border-hairline mb-1">
              <div id="bar-viability" class="bg-teal-500 h-full rounded-full transition-all duration-300" style="width: 98%;"></div>
            </div>
            <span class="text-[10px] text-muted font-mono" id="sub-viability">T &lt; Teu | Zero Intracellular Ice Shearing</span>
          </div>

          <!-- Water Activity Card -->
          <div class="bg-surface border border-hairline rounded-xl p-4">
            <span class="text-[11px] font-bold text-muted uppercase tracking-wider block mb-1">
              {d.awLabel}
            </span>
            <div class="text-2xl font-black font-mono text-cyan-300 mb-1" id="telemetry-aw">
              0.17
            </div>
            <div class="w-full bg-surface-soft rounded-full h-1.5 overflow-hidden border border-hairline mb-1">
              <div id="bar-aw" class="bg-cyan-400 h-full rounded-full transition-all duration-300" style="width: 30%;"></div>
            </div>
            <span class="text-[10px] text-muted font-mono" id="sub-aw">Microbial Stasis aw &le; 0.25</span>
          </div>

          <!-- Sensory Crispness Force Card -->
          <div class="bg-surface border border-hairline rounded-xl p-4">
            <span class="text-[11px] font-bold text-muted uppercase tracking-wider block mb-1">
              {d.crispnessLabel}
            </span>
            <div class="text-2xl font-black font-mono text-amber-400 mb-1" id="telemetry-crispness">
              13.8 N
            </div>
            <div class="w-full bg-surface-soft rounded-full h-1.5 overflow-hidden border border-hairline mb-1">
              <div id="bar-crispness" class="bg-amber-500 h-full rounded-full transition-all duration-300" style="width: 65%;"></div>
            </div>
            <span class="text-[10px] text-muted font-mono" id="sub-crispness">Optimal Brittle Crunch (10–18 N)</span>
          </div>

          <!-- Specific LN2 Ratio Card -->
          <div class="bg-surface border border-hairline rounded-xl p-4">
            <span class="text-[11px] font-bold text-muted uppercase tracking-wider block mb-1">
              {d.ln2ConsumptionLabel}
            </span>
            <div class="text-2xl font-black font-mono text-indigo-400 mb-1" id="telemetry-ln2">
              1.42 kg/kg
            </div>
            <div class="w-full bg-surface-soft rounded-full h-1.5 overflow-hidden border border-hairline mb-1">
              <div id="bar-ln2" class="bg-indigo-500 h-full rounded-full transition-all duration-300" style="width: 45%;"></div>
            </div>
            <span class="text-[10px] text-muted font-mono" id="sub-ln2">High Thermodynamic Recovery Efficiency</span>
          </div>
        </div>

        <!-- System Output & Safety Summary Banner -->
        <div class="bg-surface border border-hairline rounded-xl p-4 space-y-2">
          <div class="flex items-center justify-between text-xs font-mono">
            <span class="text-muted">{d.throughputLabel}</span>
            <span class="font-bold text-ink" id="telemetry-output">105 kg/h (Dry Mass)</span>
          </div>
          <div class="flex items-center justify-between text-xs font-mono">
            <span class="text-muted">{d.statusLabel}</span>
            <span class="font-bold text-emerald-400" id="telemetry-status">OPTIMAL CONTINUOUS FLASH VITRIFICATION</span>
          </div>
          <div class="text-[11px] text-muted font-mono border-t border-hairline/60 pt-2 leading-relaxed" id="telemetry-detail">
            Cryogenic saturation at 42.0 bar &bull; Flash sublimating micro-voids across De Laval orifice &bull; Ambient room oxygen: 20.9% (Nominal Safe)
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Dynamic Process Flow Schematic (SVG Diagram) -->
  <div class="bg-surface-soft border border-hairline rounded-2xl p-6 mb-10 shadow-xs">
    <div class="border-b border-hairline pb-4 mb-6">
      <h2 class="text-lg font-bold text-ink mb-1">{d.diagramTitle}</h2>
      <p class="text-xs text-muted leading-relaxed">{d.diagramSub}</p>
    </div>

    <div class="overflow-x-auto">
      <svg class="w-full min-w-[760px] h-[340px] text-ink select-none" viewBox="0 0 900 340" fill="none">
        <!-- Background Grid -->
        <defs>
          <pattern id="grid-pattern" width="30" height="30" patternUnits="userSpaceOnUse">
            <path d="M 30 0 L 0 0 0 30" fill="none" stroke="currentColor" stroke-width="0.5" stroke-opacity="0.08" />
          </pattern>
          <linearGradient id="ln2-grad" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#06b6d4" stop-opacity="0.8" />
            <stop offset="100%" stop-color="#3b82f6" stop-opacity="0.8" />
          </linearGradient>
          <linearGradient id="puff-grad" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#10b981" stop-opacity="0.7" />
            <stop offset="100%" stop-color="#06b6d4" stop-opacity="0.7" />
          </linearGradient>
        </defs>

        <rect width="900" height="340" fill="url(#grid-pattern)" />

        <!-- Unit 1: LN2 Vacuum-Jacketed Storage Dewar -->
        <g id="unit-dewar" transform="translate(30, 40)">
          <rect x="0" y="0" width="130" height="230" rx="16" fill="#082f49" stroke="#0284c7" stroke-width="2" />
          <path d="M 15 20 Q 65 5 115 20 L 115 200 Q 65 215 15 200 Z" fill="#0369a1" fill-opacity="0.3" />
          <text x="65" y="45" text-anchor="middle" font-size="12" font-weight="bold" fill="#38bdf8">LN2 Storage</text>
