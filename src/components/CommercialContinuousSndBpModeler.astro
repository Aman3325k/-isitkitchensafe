          <text x="115" y="35" text-anchor="middle" font-size="12" font-weight="bold" fill="#6ee7b7">Vacuum Sublimation</text>
          <text x="115" y="52" text-anchor="middle" font-size="10" font-mono" fill="#a7f3d0" id="svg-vac-p">P_exp: 0.10 mbar</text>
