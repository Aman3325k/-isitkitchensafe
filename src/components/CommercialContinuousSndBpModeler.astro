          <text x="65" y="172" text-anchor="middle" font-size="9" font-mono" fill="#cffafe">Vacuum Jacketed</text>
        </g>

        <!-- Pipeline: LN2 to Cryo-Pump -->
        <path d="M 160 170 L 210 170" stroke="#0284c7" stroke-width="4" stroke-dasharray="6 3" />

        <!-- Unit 2: High-Pressure Cryogenic Plunger Pump -->
        <g id="unit-pump" transform="translate(210, 115)">
