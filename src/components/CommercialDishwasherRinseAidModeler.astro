const d = DICT[lang] || DICT.en;
---

<div class="bg-surface border border-hairline rounded-3xl p-6 md:p-8 space-y-8 shadow-xs" id="dishwasher-rinse-modeler">
  <!-- Tool Header Banner -->
  <header class="border-b border-hairline pb-6">
    <div class="flex flex-wrap items-center justify-between gap-3 mb-2">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-rose-600 text-white">
        {d.badge}
      </span>
      <span class="text-xs text-muted font-mono">
        JACI 2023 Benchmark &bull; Swiss SIAF Epithelial Barrier Model &bull; ISO 10993 Cytotoxicity
      </span>
    </div>
    <h1 class="text-display-md md:text-display-lg font-bold text-ink tracking-tight">
      {d.title}
    </h1>
    <p class="text-sm md:text-base text-body leading-relaxed mt-2 max-w-4xl">
      {d.subtitle}
    </p>
  </header>

  <!-- One-Click Diagnostic Presets -->
  <section class="bg-surface-soft border border-hairline/80 rounded-2xl p-5 space-y-3">
    <div class="flex items-center justify-between">
      <h3 class="text-xs md:text-sm font-bold uppercase tracking-wider text-muted">
        {d.presetsTitle}
      </h3>
      <span class="text-[11px] text-muted">Click to instantly load clinical &amp; culinary scenarios</span>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2">
      <button type="button" data-preset="preset-cafeteria-melamine" class="preset-btn px-3 py-2 text-xs font-medium rounded-xl border border-hairline bg-surface hover:bg-surface-strong text-ink transition-all text-left">
        {d.presetCafeteria}
      </button>
      <button type="button" data-preset="preset-restaurant-coffee" class="preset-btn px-3 py-2 text-xs font-medium rounded-xl border border-hairline bg-surface hover:bg-surface-strong text-amber-700 dark:text-amber-400 transition-all text-left">
        {d.presetCoffee}
      </button>
      <button type="button" data-preset="preset-ibd-dining-out" class="preset-btn px-3 py-2 text-xs font-medium rounded-xl border border-hairline bg-surface hover:bg-surface-strong text-rose-700 dark:text-rose-400 transition-all text-left">
        {d.presetIbd}
      </button>
      <button type="button" data-preset="preset-infant-silicone" class="preset-btn px-3 py-2 text-xs font-medium rounded-xl border border-hairline bg-surface hover:bg-surface-strong text-purple-700 dark:text-purple-400 transition-all text-left">
        {d.presetInfant}
      </button>
      <button type="button" data-preset="preset-domestic-rinse" class="preset-btn px-3 py-2 text-xs font-medium rounded-xl border border-hairline bg-surface hover:bg-surface-strong text-emerald-700 dark:text-emerald-400 transition-all text-left">
        {d.presetDomestic}
      </button>
      <button type="button" data-preset="preset-zero-surfactant" class="preset-btn px-3 py-2 text-xs font-medium rounded-xl border border-hairline bg-surface hover:bg-surface-strong text-sky-700 dark:text-sky-400 transition-all text-left">
        {d.presetZeroSurfactant}
      </button>
    </div>
  </section>

  <!-- Interactive Controls Form -->
  <section class="bg-surface-soft border border-hairline rounded-2xl p-6 md:p-8 space-y-6">
    <div class="border-b border-hairline pb-4">
      <h2 class="text-title-md font-bold text-ink">
        {d.controlsTitle}
      </h2>
      <p class="text-xs md:text-sm text-body leading-relaxed mt-1">
        {d.controlsSub}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- 1. Dishwasher Type -->
      <div class="space-y-2">
        <label for="washer-select" class="block text-xs font-bold uppercase tracking-wider text-muted">
          {d.washerLabel}
        </label>
        <select id="washer-select" class="w-full bg-surface border border-hairline rounded-xl px-3 py-2.5 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-rose-500">
          {rinseData.washers.map(w => (
            <option value={w.id} selected={w.id === 'commercial_hood'}>
              {w.name} ({w.cycle_duration_sec < 180 ? `${w.cycle_duration_sec}s cycle &bull; 0 clean rinse` : `${Math.round(w.cycle_duration_sec/60)}m &bull; Multi-rinse`})
            </option>
          ))}
        </select>
        <p id="washer-desc" class="text-[11px] text-muted leading-tight"></p>
      </div>

      <!-- 2. Dishware Substrate -->
      <div class="space-y-2">
        <label for="substrate-select" class="block text-xs font-bold uppercase tracking-wider text-muted">
          {d.substrateLabel}
        </label>
        <select id="substrate-select" class="w-full bg-surface border border-hairline rounded-xl px-3 py-2.5 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-rose-500">
          {rinseData.substrates.map(s => (
            <option value={s.id} selected={s.id === 'glazed_ceramic'}>
              {s.name} ({s.retention_mult}x retention)
            </option>
          ))}
        </select>
        <p id="substrate-desc" class="text-[11px] text-muted leading-tight"></p>
      </div>

      <!-- 3. Food / Solvent Matrix -->
      <div class="space-y-2">
        <label for="food-select" class="block text-xs font-bold uppercase tracking-wider text-muted">
          {d.foodLabel}
        </label>
        <select id="food-select" class="w-full bg-surface border border-hairline rounded-xl px-3 py-2.5 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-rose-500">
          {rinseData.food_matrices.map(f => (
            <option value={f.id} selected={f.id === 'fatty_warm'}>
              {f.name} ({f.extraction_pct}% extraction)
            </option>
          ))}
        </select>
        <p id="food-desc" class="text-[11px] text-muted leading-tight"></p>
      </div>

      <!-- 4. Dining Out Frequency -->
      <div class="space-y-2">
        <label for="frequency-select" class="block text-xs font-bold uppercase tracking-wider text-muted">
          {d.frequencyLabel}
        </label>
        <select id="frequency-select" class="w-full bg-surface border border-hairline rounded-xl px-3 py-2.5 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-rose-500">
          {rinseData.frequencies.map(fr => (
            <option value={fr.id} selected={fr.id === 'dining_3x_week'}>
              {fr.label}
            </option>
          ))}
        </select>
      </div>

      <!-- 5. Clinical Vulnerability Profile -->
      <div class="space-y-2">
        <label for="profile-select" class="block text-xs font-bold uppercase tracking-wider text-muted">
          {d.profileLabel}
        </label>
        <select id="profile-select" class="w-full bg-surface border border-hairline rounded-xl px-3 py-2.5 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-rose-500">
          {rinseData.clinical_profiles.map(p => (
            <option value={p.id} selected={p.id === 'healthy_adult'}>
              {p.name} ({p.susceptibility_mult}x susceptibility)
            </option>
          ))}
        </select>
        <p id="profile-desc" class="text-[11px] text-muted leading-tight"></p>
      </div>

      <!-- 6. Dish Contact Surface Area Slider -->
      <div class="space-y-2">
        <div class="flex items-center justify-between">
          <label for="area-slider" class="block text-xs font-bold uppercase tracking-wider text-muted">
            {d.areaLabel}
          </label>
          <span id="area-val" class="text-xs font-mono font-bold text-rose-600">350 cm²</span>
        </div>
        <input 
          type="range" 
          id="area-slider" 
          min="50" 
          max="600" 
          step="25" 
          value="350" 
          class="w-full accent-rose-600 cursor-pointer"
        />
        <div class="flex justify-between text-[10px] text-muted font-mono">
          <span>50 cm² (Espresso cup)</span>
          <span>350 cm² (Dinner plate)</span>
          <span>600 cm² (Large tray)</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Live Diagnostic & Toxicology Panel -->
  <section class="bg-surface border border-hairline rounded-3xl p-6 md:p-8 space-y-6 shadow-sm">
    <div class="border-b border-hairline pb-4 flex flex-wrap items-center justify-between gap-4">
      <div>
        <h2 class="text-title-lg font-bold text-ink">
          {d.diagnosticTitle}
        </h2>
        <p class="text-xs md:text-sm text-body leading-relaxed mt-1">
          {d.diagnosticSub}
        </p>
      </div>
      <button 
        id="copy-report-btn" 
        type="button" 
        class="px-4 py-2 text-xs font-bold rounded-xl border border-hairline bg-surface hover:bg-surface-strong text-ink transition-colors"
      >
        {d.copyReportBtn}
      </button>
    </div>

    <!-- Overall Risk Tier Banner -->
    <div id="status-card" class="p-5 rounded-2xl border transition-all space-y-2 bg-emerald-50/70 border-emerald-300 dark:bg-emerald-950/20 dark:border-emerald-800">
      <span class="text-xs font-bold uppercase tracking-wider text-muted block">
        {d.overallStatusLabel}
      </span>
      <h3 id="status-title" class="text-lg md:text-xl font-bold tracking-tight text-emerald-700 dark:text-emerald-300">
        {d.statusTierA}
      </h3>
      <p id="status-desc" class="text-xs md:text-sm leading-relaxed text-body"></p>
    </div>

    <!-- Dynamic Warning Alerts -->
    <div id="alerts-container" class="space-y-3">
      <!-- Cytotoxic Threshold Alert -->
      <div id="alert-cytotoxic" class="hidden p-4 rounded-2xl bg-rose-50 border border-rose-300 dark:bg-rose-950/30 dark:border-rose-800 text-rose-900 dark:text-rose-200 text-xs md:text-sm space-y-1">
        <strong class="font-bold block text-rose-700 dark:text-rose-300 text-sm flex items-center gap-1.5">
          {d.alertCytotoxicTitle}
        </strong>
        <p class="leading-relaxed">{d.alertCytotoxicText}</p>
      </div>

      <!-- Clinical Vulnerability Alert -->
      <div id="alert-clinical" class="hidden p-4 rounded-2xl bg-amber-50 border border-amber-300 dark:bg-amber-950/30 dark:border-amber-800 text-amber-900 dark:text-amber-200 text-xs md:text-sm space-y-1">
        <strong class="font-bold block text-amber-700 dark:text-amber-300 text-sm flex items-center gap-1.5">
          {d.alertClinicalTitle}
        </strong>
        <p class="leading-relaxed">{d.alertClinicalText}</p>
      </div>

      <!-- No-Rinse Commercial Defect Alert -->
      <div id="alert-norinse" class="hidden p-4 rounded-2xl bg-sky-50 border border-sky-300 dark:bg-sky-950/30 dark:border-sky-800 text-sky-900 dark:text-sky-200 text-xs md:text-sm space-y-1">
        <strong class="font-bold block text-sky-700 dark:text-sky-300 text-sm flex items-center gap-1.5">
          {d.alertNoRinseTitle}
        </strong>
        <p class="leading-relaxed">{d.alertNoRinseText}</p>
      </div>

      <!-- Polymer Retention Alert -->
      <div id="alert-polymer" class="hidden p-4 rounded-2xl bg-purple-50 border border-purple-300 dark:bg-purple-950/30 dark:border-purple-800 text-purple-900 dark:text-purple-200 text-xs md:text-sm space-y-1">
        <strong class="font-bold block text-purple-700 dark:text-purple-300 text-sm flex items-center gap-1.5">
          {d.alertPolymerTitle}
        </strong>
        <p class="leading-relaxed">{d.alertPolymerText}</p>
      </div>
    </div>

    <!-- Quantitative Metrics Grid -->
    <div class="space-y-4">
      <h3 class="text-xs font-bold uppercase tracking-wider text-muted">
        {d.metricsTitle}
      </h3>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3">
        <!-- Metric 1: Residual Density -->
        <div class="bg-surface-soft border border-hairline rounded-2xl p-4 text-center space-y-1">
          <span class="text-[10px] uppercase font-bold text-muted block leading-tight">{d.residualDensityLabel}</span>
          <span id="metric-density" class="text-xl md:text-2xl font-bold font-mono text-ink">--</span>
          <span class="text-[10px] text-muted block">μg / cm²</span>
        </div>

        <!-- Metric 2: Ingested Dose -->
        <div class="bg-surface-soft border border-hairline rounded-2xl p-4 text-center space-y-1">
          <span class="text-[10px] uppercase font-bold text-muted block leading-tight">{d.ingestedDoseLabel}</span>
          <span id="metric-ingested" class="text-xl md:text-2xl font-bold font-mono text-ink">--</span>
          <span class="text-[10px] text-muted block">μg / meal</span>
        </div>

        <!-- Metric 3: Gastric Conc -->
        <div class="bg-surface-soft border border-hairline rounded-2xl p-4 text-center space-y-1">
          <span class="text-[10px] uppercase font-bold text-muted block leading-tight">{d.gastricConcLabel}</span>
          <span id="metric-gastric" class="text-xl md:text-2xl font-bold font-mono text-ink">--</span>
          <span class="text-[10px] text-muted block">ppm (mg/L)</span>
        </div>

        <!-- Metric 4: TEER Loss -->
        <div class="bg-surface-soft border border-hairline rounded-2xl p-4 text-center space-y-1">
          <span class="text-[10px] uppercase font-bold text-muted block leading-tight">{d.teerLossLabel}</span>
          <span id="metric-teer" class="text-xl md:text-2xl font-bold font-mono text-ink">--</span>
          <span class="text-[10px] text-muted block">Ω·cm² (% drop)</span>
        </div>

        <!-- Metric 5: Viability -->
        <div class="bg-surface-soft border border-hairline rounded-2xl p-4 text-center space-y-1">
          <span class="text-[10px] uppercase font-bold text-muted block leading-tight">{d.cellViabilityLabel}</span>
          <span id="metric-viability" class="text-xl md:text-2xl font-bold font-mono text-ink">--</span>
          <span class="text-[10px] text-muted block">Caco-2 cell survival</span>
        </div>

        <!-- Metric 6: Alarmin Index -->
        <div class="bg-surface-soft border border-hairline rounded-2xl p-4 text-center space-y-1">
          <span class="text-[10px] uppercase font-bold text-muted block leading-tight">{d.alarminLabel}</span>
          <span id="metric-alarmin" class="text-xl md:text-2xl font-bold font-mono text-ink">--</span>
          <span class="text-[10px] text-muted block">Baseline Fold-Rise</span>
        </div>
      </div>
    </div>

    <!-- Epithelial Tight Junction Visualizer -->
    <div class="bg-surface-soft border border-hairline rounded-2xl p-6 space-y-4">
      <div class="flex items-center justify-between">
        <h4 class="text-xs md:text-sm font-bold uppercase tracking-wider text-ink">
          {d.barrierHeading}
        </h4>
        <span id="teer-status-tag" class="text-xs font-mono font-bold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">
          TEER Intact
        </span>
      </div>

      <div class="space-y-3 text-xs">
        <div>
          <div class="flex justify-between mb-1 font-medium">
            <span class="text-muted">{d.tightJunctionIntegrity}</span>
            <span id="tj-pct" class="font-mono font-bold text-ink">95%</span>
          </div>
          <div class="w-full bg-hairline rounded-full h-3 overflow-hidden">
            <div id="tj-bar" class="h-full bg-emerald-500 rounded-full transition-all duration-500" style="width: 95%;"></div>
          </div>
        </div>

        <div>
          <div class="flex justify-between mb-1 font-medium">
            <span class="text-muted">{d.paracellularFlux}</span>
            <span id="flux-pct" class="font-mono font-bold text-ink">1.0x (Physiological)</span>
          </div>
          <div class="w-full bg-hairline rounded-full h-3 overflow-hidden">
            <div id="flux-bar" class="h-full bg-rose-500 rounded-full transition-all duration-500" style="width: 5%;"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4-Step Practical Mitigation Protocols -->
  <section class="bg-surface-soft border border-hairline rounded-2xl p-6 md:p-8 space-y-6">
    <div class="border-b border-hairline pb-4">
      <span class="text-xs font-bold uppercase tracking-wider text-rose-600 block mb-1">
        Clinical &amp; Culinary Sanitation Protocol
      </span>
      <h2 class="text-title-md font-bold text-ink">
        {d.protocolsTitle}
      </h2>
      <p class="text-xs md:text-sm text-body leading-relaxed mt-1">
        {d.protocolsSub}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="p-5 rounded-2xl bg-surface border border-hairline space-y-2">
        <h3 class="text-sm md:text-base font-bold text-ink flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-rose-500"></span>
          {d.step1Title}
        </h3>
        <p class="text-xs md:text-sm text-body leading-relaxed">
          {d.step1Text}
        </p>
      </div>

      <div class="p-5 rounded-2xl bg-surface border border-hairline space-y-2">
        <h3 class="text-sm md:text-base font-bold text-ink flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-amber-500"></span>
          {d.step2Title}
        </h3>
        <p class="text-xs md:text-sm text-body leading-relaxed">
          {d.step2Text}
        </p>
      </div>

      <div class="p-5 rounded-2xl bg-surface border border-hairline space-y-2">
        <h3 class="text-sm md:text-base font-bold text-ink flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-sky-500"></span>
          {d.step3Title}
        </h3>
        <p class="text-xs md:text-sm text-body leading-relaxed">
          {d.step3Text}
        </p>
      </div>

      <div class="p-5 rounded-2xl bg-surface border border-hairline space-y-2">
        <h3 class="text-sm md:text-base font-bold text-ink flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          {d.step4Title}
        </h3>
        <p class="text-xs md:text-sm text-body leading-relaxed">
          {d.step4Text}
        </p>
      </div>
    </div>
  </section>

  <!-- Cross-linking to Companion Tools -->
  <section class="border-t border-hairline pt-6">
    <h3 class="text-xs font-bold uppercase tracking-wider text-muted mb-4">
      {d.crossLinkTitle}
    </h3>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
      <a href="/tools/induction-cooktop-emf-safety-modeler/" class="p-3.5 rounded-xl border border-hairline bg-surface hover:bg-surface-strong text-xs font-medium text-ink transition-colors flex items-center justify-between">
        <span>⚡ {d.crossLinkInduction}</span>
        <span class="text-muted">&rarr;</span>
      </a>
      <a href="/tools/microwave-radiation-leakage-evaluator/" class="p-3.5 rounded-xl border border-hairline bg-surface hover:bg-surface-strong text-xs font-medium text-ink transition-colors flex items-center justify-between">
        <span>📡 {d.crossLinkMicrowave}</span>
        <span class="text-muted">&rarr;</span>
      </a>
      <a href="/tools/slow-cooker-safety-simulator/" class="p-3.5 rounded-xl border border-hairline bg-surface hover:bg-surface-strong text-xs font-medium text-ink transition-colors flex items-center justify-between">
        <span>🍲 {d.crossLinkSlowCooker}</span>
        <span class="text-muted">&rarr;</span>
      </a>
      <a href="/tools/air-fryer-acrylamide-calculator/" class="p-3.5 rounded-xl border border-hairline bg-surface hover:bg-surface-strong text-xs font-medium text-ink transition-colors flex items-center justify-between">
        <span>🍟 {d.crossLinkAirFryer}</span>
        <span class="text-muted">&rarr;</span>
      </a>
      <a href="/tools/water-filter-efficiency-analyzer/" class="p-3.5 rounded-xl border border-hairline bg-surface hover:bg-surface-strong text-xs font-medium text-ink transition-colors flex items-center justify-between">
        <span>💧 {d.crossLinkWaterFilter}</span>
        <span class="text-muted">&rarr;</span>
      </a>
    </div>
  </section>
</div>

<script is:inline define:vars={{ rinseData, d }}>
  document.addEventListener('DOMContentLoaded', () => {
    const root = document.getElementById('dishwasher-rinse-modeler');
    if (!root) return;

    // Elements
    const washerSelect = document.getElementById('washer-select');
    const substrateSelect = document.getElementById('substrate-select');
    const foodSelect = document.getElementById('food-select');
    const frequencySelect = document.getElementById('frequency-select');
    const profileSelect = document.getElementById('profile-select');
    const areaSlider = document.getElementById('area-slider');
    const areaVal = document.getElementById('area-val');

    // Descs
    const washerDesc = document.getElementById('washer-desc');
    const substrateDesc = document.getElementById('substrate-desc');
    const foodDesc = document.getElementById('food-desc');
    const profileDesc = document.getElementById('profile-desc');

    // Status UI
    const statusCard = document.getElementById('status-card');
    const statusTitle = document.getElementById('status-title');
    const statusDesc = document.getElementById('status-desc');

    // Alerts
    const alertCytotoxic = document.getElementById('alert-cytotoxic');
    const alertClinical = document.getElementById('alert-clinical');
    const alertNoRinse = document.getElementById('alert-norinse');
    const alertPolymer = document.getElementById('alert-polymer');

    // Metrics
    const metricDensity = document.getElementById('metric-density');
    const metricIngested = document.getElementById('metric-ingested');
    const metricGastric = document.getElementById('metric-gastric');
    const metricTeer = document.getElementById('metric-teer');
    const metricViability = document.getElementById('metric-viability');
    const metricAlarmin = document.getElementById('metric-alarmin');

    // Visualizer
    const tjPct = document.getElementById('tj-pct');
    const tjBar = document.getElementById('tj-bar');
    const fluxPct = document.getElementById('flux-pct');
    const fluxBar = document.getElementById('flux-bar');
    const teerStatusTag = document.getElementById('teer-status-tag');

    // Preset buttons
    const presetBtns = root.querySelectorAll('.preset-btn');
    const copyReportBtn = document.getElementById('copy-report-btn');

    let currentReportSummary = '';

    function compute() {
      const washer = rinseData.washers.find(w => w.id === washerSelect.value) || rinseData.washers[0];
      const substrate = rinseData.substrates.find(s => s.id === substrateSelect.value) || rinseData.substrates[0];
      const food = rinseData.food_matrices.find(f => f.id === foodSelect.value) || rinseData.food_matrices[0];
      const freq = rinseData.frequencies.find(fr => fr.id === frequencySelect.value) || rinseData.frequencies[0];
      const profile = rinseData.clinical_profiles.find(p => p.id === profileSelect.value) || rinseData.clinical_profiles[0];
      const areaCm2 = parseFloat(areaSlider.value);

      // Update descriptions
      washerDesc.textContent = washer.description;
      substrateDesc.textContent = substrate.notes;
      foodDesc.textContent = food.notes;
      profileDesc.textContent = profile.description;
      areaVal.textContent = `${areaCm2} cm²`;

      // 1. Surface residual density (μg/cm²)
      const residualDensity = washer.base_residue_ug_cm2 * substrate.retention_mult;

      // 2. Ingested surfactant dose per meal (μg)
      // Dose = Surface Area * Residual Density * Food Extraction Efficiency
      const extractionFraction = food.extraction_pct / 100;
      const singleMealDoseUg = areaCm2 * residualDensity * extractionFraction;

      // Cumulative daily dose factoring frequency multiplier
      const dailyExposureUg = singleMealDoseUg * freq.daily_meals;

      // 3. Gastric Concentration (ppm = mg/L):
      // Average postprandial gastric chyme volume ~500 mL (0.5 L)
      const gastricPpm = (singleMealDoseUg / 1000) / 0.5;

      // 4. Tight junction and TEER response model:
      // JACI (Ogulur 2023) benchmark:
      // ~10 ppm = mild TEER drop (~15%)
      // ~25 ppm (1:40,000) = cytotoxicity threshold, 50% TEER collapse
      // >50 ppm (1:20,000) = severe cell necrosis, 80%+ TEER collapse
      // We scale with clinical susceptibility factor
      const effectiveStressConc = gastricPpm * profile.susceptibility_mult;

      // Sigmoidal TEER loss curve
      const teerLossPct = Math.min(95, Math.max(0, (effectiveStressConc / (effectiveStressConc + 18)) * 100));
      const remainingTeerVal = Math.round(profile.teer_baseline * (1 - (teerLossPct / 100)));

      // Cell viability model
      const viabilityPct = Math.max(10, Math.min(100, Math.round(100 - (effectiveStressConc * 1.6))));

      // Tight junction claudin-1/ZO-1 integrity
      const tjIntegrityPct = Math.max(5, Math.min(100, Math.round(100 - teerLossPct)));

      // Paracellular leak rate multiplier (LPS/antigen flux)
      const paracellularFluxMult = (1 + (teerLossPct / 100) * 8.5).toFixed(1);

      // Inflammatory Alarmin Elevation (IL-8/TNF-alpha fold rise)
      const alarminFoldRise = (1 + (effectiveStressConc / 7.5)).toFixed(1);

      // Render Metrics
      metricDensity.textContent = residualDensity.toFixed(2);
      metricIngested.textContent = singleMealDoseUg >= 1000 
        ? `${(singleMealDoseUg / 1000).toFixed(2)} mg` 
        : `${Math.round(singleMealDoseUg)} μg`;
      metricGastric.textContent = `${gastricPpm.toFixed(1)} ppm`;
      metricTeer.textContent = `${remainingTeerVal} (-${Math.round(teerLossPct)}%)`;
      metricViability.textContent = `${viabilityPct}%`;
      metricAlarmin.textContent = `${alarminFoldRise}x`;

      // Update Visualizer Bars
      tjPct.textContent = `${tjIntegrityPct}%`;
      tjBar.style.width = `${tjIntegrityPct}%`;
      if (tjIntegrityPct > 75) {
        tjBar.className = 'h-full bg-emerald-500 rounded-full transition-all duration-500';
      } else if (tjIntegrityPct > 45) {
        tjBar.className = 'h-full bg-amber-500 rounded-full transition-all duration-500';
      } else {
        tjBar.className = 'h-full bg-rose-500 rounded-full transition-all duration-500';
      }

      fluxPct.textContent = `${paracellularFluxMult}x (${tjIntegrityPct < 50 ? 'Severe Leakage' : 'Controlled'})`;
      fluxBar.style.width = `${Math.min(100, (parseFloat(paracellularFluxMult) / 9.5) * 100)}%`;

      // Status Tiers
      let tierClass = '';
      let tierTitle = '';
      let tierDesc = '';

      if (singleMealDoseUg < 80 && teerLossPct < 15) {
        tierClass = 'bg-emerald-50/70 border-emerald-300 dark:bg-emerald-950/20 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300';
        tierTitle = d.statusTierA;
        tierDesc = "Chemical surfactant residue is negligible or effectively washed away by fresh water rinsing. Intestinal tight junctions maintain high electrical resistance with normal protective mucin barriers.";
        teerStatusTag.className = 'text-xs font-mono font-bold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300';
        teerStatusTag.textContent = 'Barrier Intact (Homeostasis)';
      } else if (singleMealDoseUg < 350 && teerLossPct < 30) {
        tierClass = 'bg-teal-50/70 border-teal-300 dark:bg-teal-950/20 dark:border-teal-800 text-teal-800 dark:text-teal-300';
        tierTitle = d.statusTierB;
        tierDesc = "Residual chemical levels are below physiological cytotoxicity thresholds. Healthy adult gut mucosa tolerates this low exposure without measurable barrier disruption, though pediatric or sensitive guts may experience mild subclinical strain.";
        teerStatusTag.className = 'text-xs font-mono font-bold px-2 py-0.5 rounded-full bg-teal-100 text-teal-800 dark:bg-teal-950 dark:text-teal-300';
        teerStatusTag.textContent = 'Sub-Threshold Residual';
      } else if (singleMealDoseUg < 1200 && teerLossPct < 50) {
        tierClass = 'bg-amber-50/70 border-amber-300 dark:bg-amber-950/20 dark:border-amber-800 text-amber-800 dark:text-amber-300';
        tierTitle = d.statusTierC;
        tierDesc = "Surfactant exposure induces measurable tight junction strain. Claudin-1 down-regulation begins, triggering early release of epithelial inflammatory alarmins (IL-8). Caution strongly recommended for patients with inflammatory bowel disease.";
        teerStatusTag.className = 'text-xs font-mono font-bold px-2 py-0.5 rounded-full bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300';
        teerStatusTag.textContent = 'Tight Junction Stress';
      } else if (singleMealDoseUg < 3500 && teerLossPct < 70) {
        tierClass = 'bg-orange-50/70 border-orange-300 dark:bg-orange-950/20 dark:border-orange-800 text-orange-800 dark:text-orange-300';
        tierTitle = d.statusTierD;
        tierDesc = "High chemical burden causes substantial epithelial permeability and tight junction degradation. Paracellular translocation of bacterial lipopolysaccharides (LPS) and food antigens is amplified. Immediate dining habit modification advised.";
        teerStatusTag.className = 'text-xs font-mono font-bold px-2 py-0.5 rounded-full bg-orange-100 text-orange-800 dark:bg-orange-950 dark:text-orange-300';
        teerStatusTag.textContent = 'Permeability Hazard (Leaky Gut)';
      } else {
        tierClass = 'bg-rose-50/70 border-rose-300 dark:bg-rose-950/20 dark:border-rose-800 text-rose-800 dark:text-rose-300';
        tierTitle = d.statusTierE;
        tierDesc = "Critical chemical burden! Gastric concentrations exceed the Swiss SIAF / JACI cytotoxicity threshold. Rapid dissolution of lipid bilayers triggers epithelial cell apoptosis and mucosal necrosis. Actionable mitigation required immediately.";
        teerStatusTag.className = 'text-xs font-mono font-bold px-2 py-0.5 rounded-full bg-rose-100 text-rose-800 dark:bg-rose-950 dark:text-rose-300';
        teerStatusTag.textContent = 'Critical Cytotoxicity & Barrier Collapse';
      }

      statusCard.className = `p-5 rounded-2xl border transition-all space-y-2 ${tierClass}`;
      statusTitle.textContent = tierTitle;
      statusDesc.textContent = tierDesc;

      // Toggle Dynamic Alerts
      if (gastricPpm >= 25 || teerLossPct >= 50) {
        alertCytotoxic.classList.remove('hidden');
      } else {
        alertCytotoxic.classList.add('hidden');
      }

      if (profile.susceptibility_mult > 1.5 && (singleMealDoseUg > 200 || teerLossPct > 20)) {
        alertClinical.classList.remove('hidden');
      } else {
        alertClinical.classList.add('hidden');
      }

      if (!washer.fresh_water_post_rinse) {
        alertNoRinse.classList.remove('hidden');
      } else {
        alertNoRinse.classList.add('hidden');
      }

      if (substrate.retention_mult > 2.0 && singleMealDoseUg > 150) {
        alertPolymer.classList.remove('hidden');
      } else {
        alertPolymer.classList.add('hidden');
      }

      // Generate printable clipboard summary
      currentReportSummary = [
        "============================================================",
        "COMMERCIAL DISHWASHER RINSE AID & GUT EPITHELIAL BARRIER REPORT",
        "Source: IsItKitchenSafe Toxicology & Gastroenterology Laboratory",
        "Reference: Ogulur et al. (2023) JACI & Swiss SIAF Benchmark",
        "============================================================",
        `Dishwasher Type: ${washer.name}`,
        `Dishware Contact Material: ${substrate.name} (${substrate.retention_mult}x retention)`,
        `Food Extraction Matrix: ${food.name} (${food.extraction_pct}% extraction)`,
        `Commercial Exposure Frequency: ${freq.label}`,
        `Clinical Susceptibility Profile: ${profile.name} (${profile.susceptibility_mult}x susceptibility)`,
        `Contact Surface Area: ${areaCm2} cm²`,
        "------------------------------------------------------------",
        "QUANTITATIVE DOSIMETRY & EPITHELIAL METRICS:",
        `- Surface Surfactant Residue Density: ${residualDensity.toFixed(2)} μg/cm²`,
        `- Estimated Single Meal Ingested Dose: ${(singleMealDoseUg).toFixed(1)} μg`,
        `- Estimated Gastric Fluid Concentration: ${gastricPpm.toFixed(1)} ppm (mg/L)`,
        `- Cytotoxicity Dilution Equivalent: 1:${Math.round(1000000 / (gastricPpm || 1))}`,
        `- Remaining TEER Electrical Resistance: ${remainingTeerVal} Ω·cm² (-${Math.round(teerLossPct)}%)`,
        `- Intestinal Epithelial Cell Viability: ${viabilityPct}%`,
        `- Tight Junction Integrity Score: ${tjIntegrityPct}%`,
        `- Paracellular Antigen/LPS Leakage Flux: ${paracellularFluxMult}x`,
        `- Pro-inflammatory Alarmin Index (IL-8/TNF-α): ${alarminFoldRise}x baseline`,
        "------------------------------------------------------------",
        `VERDICT & RISK TIER: ${tierTitle}`,
        `CLINICAL IMPLICATION: ${tierDesc}`,
        "============================================================",
        "Visit https://isitkitchensafe.com/tools/commercial-dishwasher-rinse-aid-modeler/ for full interactive simulation."
      ].join('\n');
    }

    // Attach listeners
    washerSelect.addEventListener('change', compute);
    substrateSelect.addEventListener('change', compute);
    foodSelect.addEventListener('change', compute);
    frequencySelect.addEventListener('change', compute);
    profileSelect.addEventListener('change', compute);
    areaSlider.addEventListener('input', compute);

    // Preset handlers
    presetBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const pId = btn.getAttribute('data-preset');
        const p = rinseData.presets.find(item => item.id === pId);
        if (p) {
          washerSelect.value = p.washerId;
          substrateSelect.value = p.substrateId;
          foodSelect.value = p.foodId;
          frequencySelect.value = p.frequencyId;
          profileSelect.value = p.profileId;
          areaSlider.value = p.plateAreaCm2.toString();
          compute();
        }
      });
    });

    // Copy report
    copyReportBtn.addEventListener('click', () => {
      if (navigator.clipboard && currentReportSummary) {
        navigator.clipboard.writeText(currentReportSummary).then(() => {
          const originalText = copyReportBtn.textContent;
          copyReportBtn.textContent = d.reportCopied;
          copyReportBtn.classList.add('bg-emerald-600', 'text-white', 'border-emerald-600');
          setTimeout(() => {
            copyReportBtn.textContent = originalText;
            copyReportBtn.classList.remove('bg-emerald-600', 'text-white', 'border-emerald-600');
          }, 3000);
        });
      }
    });

    // Initial calculation
    compute();
  });
</script>
