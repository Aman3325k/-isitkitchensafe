  <!-- Fundamental Governing Physics Equations -->
  <div class="mb-10 bg-surface-soft border border-hairline rounded-2xl p-6 sm:p-8">
    <div class="border-b border-hairline/60 pb-3 mb-6">
      <h3 class="text-base font-bold text-ink">{d.principlesTitle}</h3>
      <p class="text-xs text-muted mt-1">{d.principlesSub}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 text-xs font-mono">
      <!-- Equation 1: Gor'kov Acoustic Potential -->
      <div class="bg-surface p-4 rounded-xl border border-hairline flex flex-col justify-between">
        <div>
          <span class="text-[10px] uppercase font-bold text-cyan-400 block mb-1">Gor'kov Acoustic Force</span>
          <div class="text-sm font-bold text-ink my-2">F_rad = -∇U_G</div>
          <p class="text-[11px] text-muted font-sans leading-normal">
            Acoustic radiation force counterbalances gravitational body force F_g = ρ·V·g, stably trapping droplets at pressure nodes.
          </p>
        </div>
        <div class="mt-3 pt-2 border-t border-hairline/60 text-[10px] text-cyan-400">
          U_G = V_0·[f_1·⟨p²⟩/(2ρc²) - ¾f_2·ρ⟨v²⟩]
        </div>
      </div>

      <!-- Equation 2: Young-Laplace Capillary Stress -->
      <div class="bg-surface p-4 rounded-xl border border-hairline flex flex-col justify-between">
        <div>
          <span class="text-[10px] uppercase font-bold text-emerald-400 block mb-1">Zero Capillary Stress</span>
          <div class="text-sm font-bold text-ink my-2">P_cap = 2γ cosθ / r = 0</div>
          <p class="text-[11px] text-muted font-sans leading-normal">
            Interfacial surface tension vanishes in dense supercritical CO2 (γ → 0), preventing mesopore compressive collapse.
          </p>
        </div>
        <div class="mt-3 pt-2 border-t border-hairline/60 text-[10px] text-emerald-400">
          P &gt; P_crit (73.8 bar) &bull; T &gt; T_crit (31.1°C)
        </div>
      </div>

      <!-- Equation 3: Knudsen Supercritical Diffusion -->
      <div class="bg-surface p-4 rounded-xl border border-hairline flex flex-col justify-between">
        <div>
          <span class="text-[10px] uppercase font-bold text-sky-400 block mb-1">Knudsen Nano-Diffusion</span>
          <div class="text-sm font-bold text-ink my-2">D_K = (d_pore/3)·√(8RT/πM)</div>
          <p class="text-[11px] text-muted font-sans leading-normal">
            Low supercritical viscosity (10–100× lower than liquid) enables rapid pore solvent displacement in under 25 minutes.
          </p>
        </div>
        <div class="mt-3 pt-2 border-t border-hairline/60 text-[10px] text-sky-400">
          τ_dry = L² / (π²·D_eff) &bull; Rapid Stripping
        </div>
      </div>

      <!-- Equation 4: BET Specific Surface Area -->
      <div class="bg-surface p-4 rounded-xl border border-hairline flex flex-col justify-between">
        <div>
          <span class="text-[10px] uppercase font-bold text-violet-400 block mb-1">BET Surface Area</span>
          <div class="text-sm font-bold text-ink my-2">S_BET = (V_m·N_A·s) / (V_0·M)</div>
          <p class="text-[11px] text-muted font-sans leading-normal">
            Multilayer nitrogen gas physisorption model confirming intact 720–950 m²/g internal skeleton area.
          </p>
        </div>
        <div class="mt-3 pt-2 border-t border-hairline/60 text-[10px] text-violet-400">
          IUPAC Type IV &bull; Porosity &gt; 96.5%
        </div>
      </div>
    </div>
  </div>

  <!-- Industrial Benchmark Comparison Table -->
  <div class="mb-10 bg-surface-soft border border-hairline rounded-2xl p-6 sm:p-8">
