<script is:inline>
  function initAlSadModeler() {
    const root = document.querySelector('.al-sad-modeler');
    if (!root) return;

    // Controls
    const formSelect = root.querySelector('#formulation-select');
    const formDesc = root.querySelector('#formulation-desc');
    const splSlider = root.querySelector('#spl-slider');
    const splVal = root.querySelector('#spl-val');
    const freqSlider = root.querySelector('#freq-slider');
    const freqVal = root.querySelector('#freq-val');
    const pressureSlider = root.querySelector('#pressure-slider');
    const pressureVal = root.querySelector('#pressure-val');
    const tempSlider = root.querySelector('#temp-slider');
    const tempVal = root.querySelector('#temp-val');
    const flowSlider = root.querySelector('#flow-slider');
    const flowVal = root.querySelector('#flow-val');
    const dropletSlider = root.querySelector('#droplet-slider');
    const dropletVal = root.querySelector('#droplet-val');

    // Outputs
    const outTrapping = root.querySelector('#out-trapping');
    const outCapillary = root.querySelector('#out-capillary');
    const outSurfaceArea = root.querySelector('#out-surface-area');
    const outPorosity = root.querySelector('#out-porosity');
    const outDensity = root.querySelector('#out-density');
    const outShrinkage = root.querySelector('#out-shrinkage');
    const outDuration = root.querySelector('#out-duration');
    const outSec = root.querySelector('#out-sec');
    const telemetryChip = root.querySelector('#telemetry-chip');
    const verdictTitle = root.querySelector('#verdict-title');
    const verdictDesc = root.querySelector('#verdict-desc');
    const verdictDot = root.querySelector('#verdict-dot');
    const verdictBox = root.querySelector('#verdict-box');

    // Formulation Data Database
    const FORMULATION_MAP = {
      'silica_alginate_hybrid_microspheres': {
        desc: "Interpenetrating hybrid silica-calcium alginate aerogel network synthesized via in-situ sol-gel condensation in acoustic levitation node, followed by supercritical drying.",
        baseSurface: 840,
        basePorosity: 97.4,
        baseDensity: 0.038,
        baseShrink: 4.2,
        baseTime: 22.0,
        baseSec: 0.52
      },
      'cellulose_nanocrystal_chitosan_aerogel': {
        desc: "High-crystallinity plant CNCs crosslinked with deacetylated chitosan for nutraceutical polyphenolic delivery with targeted colonic release.",
        baseSurface: 760,
        basePorosity: 96.8,
        baseDensity: 0.042,
        baseShrink: 5.1,
        baseTime: 20.0,
        baseSec: 0.48
      },
      'pure_silica_monolith_aerogel': {
        desc: "Ultra-pure tetramethyl orthosilicate (TMOS) catalyzed sol-gel for volatile aromatic compound adsorption and clean-label flavor stabilization.",
        baseSurface: 925,
        basePorosity: 98.2,
        baseDensity: 0.028,
        baseShrink: 3.1,
        baseTime: 25.0,
        baseSec: 0.58
      },
      'pectin_calcium_nutraceutical_aerogel': {
        desc: "Low-methoxyl citrus pectin crosslinked with calcium divalent ions forming egg-box structural pockets for fat-soluble vitamins (A, D, E, K).",
        baseSurface: 735,
        basePorosity: 96.5,
        baseDensity: 0.045,
        baseShrink: 5.8,
        baseTime: 18.0,
        baseSec: 0.44
      },
      'zein_protein_phenolic_aerogel': {
        desc: "Hydrophobic maize prolamine zein structured into an aerated protein scaffold capable of reversible high-capacity oil absorption and phenolic binding.",
        baseSurface: 790,
        basePorosity: 97.1,
        baseDensity: 0.035,
        baseShrink: 4.6,
        baseTime: 24.0,
        baseSec: 0.50
      }
    };

    function recalculate() {
      const formKey = formSelect ? formSelect.value : 'silica_alginate_hybrid_microspheres';
      const form = FORMULATION_MAP[formKey] || FORMULATION_MAP['silica_alginate_hybrid_microspheres'];
      
      const spl = parseFloat(splSlider.value);
      const freq = parseFloat(freqSlider.value);
      const pressure = parseFloat(pressureSlider.value);
      const temp = parseFloat(tempSlider.value);
      const flow = parseFloat(flowSlider.value);
      const droplet = parseFloat(dropletSlider.value);

      // Label updates
      splVal.textContent = spl.toFixed(1) + ' dB';
      freqVal.textContent = freq.toFixed(1) + ' kHz';
      pressureVal.textContent = pressure.toFixed(1) + ' bar';
      tempVal.textContent = temp.toFixed(1) + ' °C';
      flowVal.textContent = flow.toFixed(1) + ' kg/h';
      dropletVal.textContent = droplet.toFixed(0) + ' µm';
      if (formDesc) formDesc.textContent = form.desc;

      // 1. Gor'kov Acoustic Radiation Force vs Gravity Ratio
      // Radiation force scales with acoustic energy density (10^(SPL/10)) and frequency, inversely with droplet mass ~ droplet^3
      const acousticEnergyFactor = Math.pow(10, (spl - 150) / 20);
      const freqScaling = freq / 40.0;
      const massFactor = Math.pow(droplet / 480, 2.2);
      const trappingRatio = (3.85 * acousticEnergyFactor * freqScaling) / massFactor;

      // 2. Capillary Stress (Young-Laplace)
      // If pressure < 73.8 bar (P_crit) or temp < 31.1 °C (T_crit), system is subcritical, liquid-gas meniscus forms!
      const isSupercritical = pressure >= 73.8 && temp >= 31.1;
      let capStress = 0.0;
      if (!isSupercritical) {
        // High destructive capillary tension in subcritical zone
        capStress = 16.5 * (1.0 - (pressure / 73.8) * 0.7);
        if (capStress < 3.0) capStress = 3.0;
      }

      // 3. Specific Surface Area S_BET
      let surfaceArea = form.baseSurface * (pressure / 140.0) * 0.3 + form.baseSurface * 0.7;
      if (!isSupercritical) {
        // Severe capillary pore collapse
        surfaceArea = surfaceArea * 0.12;
      }

      // 4. Porosity
      let porosity = form.basePorosity;
      if (!isSupercritical) {
        porosity = porosity * 0.35;
      } else {
        porosity = Math.min(98.8, form.basePorosity + (pressure - 140) * 0.015);
      }

      // 5. Bulk Density
      let density = form.baseDensity;
      if (!isSupercritical) {
        density = density * 4.5; // dense collapsed pebble
      } else {
        density = form.baseDensity * (100 - porosity) / (100 - form.basePorosity);
      }

      // 6. Volumetric Shrinkage
      let shrinkage = form.baseShrink;
      if (!isSupercritical) {
        shrinkage = 84.5; // severe capillary collapse
      } else {
        shrinkage = Math.max(2.8, form.baseShrink - (pressure - 140) * 0.02);
      }

      // 7. Drying Duration
      const flowFactor = 18.0 / Math.max(5.0, flow);
      const dropletDiffFactor = Math.pow(droplet / 480, 1.3);
      const duration = form.baseTime * flowFactor * dropletDiffFactor;

      // 8. SEC
      const sec = form.baseSec * (flow / 18.0) * 0.4 + form.baseSec * 0.6;

      // Update Telemetry Elements
      outTrapping.textContent = trappingRatio.toFixed(2) + 'x';
      outCapillary.textContent = capStress.toFixed(2) + ' MPa';
      outSurfaceArea.textContent = surfaceArea.toFixed(0) + ' m²/g';
      outPorosity.textContent = porosity.toFixed(1) + '%';
      outDensity.textContent = density.toFixed(3) + ' g/cm³';
      outShrinkage.textContent = shrinkage.toFixed(1) + '%';
      outDuration.textContent = duration.toFixed(1) + ' min';
      outSec.textContent = sec.toFixed(2) + ' kWh/kg';

      // Verdict State Machine
      if (trappingRatio < 1.0) {
        // Acoustic Drop Hazard
        telemetryChip.textContent = "ACOUSTIC_DROPOUT_HAZARD";
        telemetryChip.className = "px-2.5 py-1 text-[11px] font-bold rounded-lg bg-rose-950 text-rose-300 border border-rose-800";
        verdictBox.className = "mt-5 p-4 rounded-xl border border-rose-800 bg-rose-950/30";
        verdictDot.className = "w-2.5 h-2.5 rounded-full bg-rose-400 mt-1.5 shrink-0";
        verdictTitle.textContent = "ACOUSTIC_NODE_UNSTABLE: Droplet Settling / Wall Impingement";
        verdictDesc.textContent = "Acoustic radiation force (F_rad) has fallen below gravitational body force (F_rad / F_g = " + trappingRatio.toFixed(2) + "x < 1.0). Precursor alcogel droplets will fall out of the acoustic standing wave nodes, causing chamber floor fouling.";
      } else if (!isSupercritical) {
        // Subcritical Capillary Collapse
        telemetryChip.textContent = "SUBCRITICAL_CAPILLARY_COLLAPSE";
        telemetryChip.className = "px-2.5 py-1 text-[11px] font-bold rounded-lg bg-amber-950 text-amber-300 border border-amber-800";
        verdictBox.className = "mt-5 p-4 rounded-xl border border-amber-800 bg-amber-950/30";
        verdictDot.className = "w-2.5 h-2.5 rounded-full bg-amber-400 mt-1.5 shrink-0";
        verdictTitle.textContent = "SUBCRITICAL_MENISCUS_ALERT: Severe Pore Network Collapse";
        verdictDesc.textContent = "System operating below CO2 critical coordinates (P = " + pressure.toFixed(1) + " bar, T = " + temp.toFixed(1) + " °C). A liquid-gas meniscus has formed, exerting high Young-Laplace tension (" + capStress.toFixed(2) + " MPa) that crushes >85% of mesopores.";
      } else {
        // Healthy Optimal Operation
        telemetryChip.textContent = "OPTIMAL_LEVITATION";
        telemetryChip.className = "px-2.5 py-1 text-[11px] font-bold rounded-lg bg-emerald-950 text-emerald-300 border border-emerald-800";
        verdictBox.className = "mt-5 p-4 rounded-xl border border-cyan-800 bg-cyan-950/30";
        verdictDot.className = "w-2.5 h-2.5 rounded-full bg-cyan-400 mt-1.5 shrink-0";
        verdictTitle.textContent = "OPTIMAL_CONTAINERLESS_AEROGEL: 100% Intact Mesoporous Network";
        verdictDesc.textContent = "Acoustic radiation pressure exceeds gravity by " + trappingRatio.toFixed(2) + "x, maintaining containerless suspension. Dense supercritical CO2 strips solvent at zero capillary stress (P_cap = 0.00 MPa), synthesizing intact aerogels (S_BET = " + surfaceArea.toFixed(0) + " m²/g).";
      }
    }

    // Attach Event Listeners
    if (formSelect) formSelect.addEventListener('change', recalculate);
    [splSlider, freqSlider, pressureSlider, tempSlider, flowSlider, dropletSlider].forEach(slider => {
      if (slider) slider.addEventListener('input', recalculate);
    });

    // Preset Buttons
    root.querySelectorAll('.preset-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const p = btn.getAttribute('data-preset');
        if (p === 'silica-alginate') {
          formSelect.value = 'silica_alginate_hybrid_microspheres';
          splSlider.value = 160.0;
          freqSlider.value = 40.0;
          pressureSlider.value = 140.0;
          tempSlider.value = 40.0;
          flowSlider.value = 18.0;
          dropletSlider.value = 480;
        } else if (p === 'cnc-chitosan') {
          formSelect.value = 'cellulose_nanocrystal_chitosan_aerogel';
          splSlider.value = 158.0;
          freqSlider.value = 40.0;
          pressureSlider.value = 130.0;
          tempSlider.value = 39.0;
          flowSlider.value = 15.0;
          dropletSlider.value = 520;
        } else if (p === 'pure-silica') {
          formSelect.value = 'pure_silica_monolith_aerogel';
          splSlider.value = 162.0;
