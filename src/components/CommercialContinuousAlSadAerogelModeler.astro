    <div class="border-b border-hairline/60 pb-3 mb-4">
      <h3 class="text-base font-bold text-ink">{d.regTitle}</h3>
      <p class="text-xs text-muted mt-1">{d.regSub}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs text-muted">
      <div class="bg-surface p-4 rounded-xl border border-hairline">
        <span class="font-bold text-ink block mb-1">FDA 21 CFR § 117 FSMA cGMP:</span>
        Sanitary food-contact validation ensuring zero contamination from piezoelectric acoustic elements, cleanable 316L stainless steel process piping, and safe food-grade CO2 solvent verification.
      </div>
