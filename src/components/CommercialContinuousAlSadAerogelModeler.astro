    controlsTitle: "音響浮遊力学＆超臨界CO2抽出プロセス制御盤",
    controlsSub: "音圧レベル強度、共振周波数、超臨界抽出圧力、温度、流体質量流量および前駆体液滴径を調整し、音響放射力バランスとナノメソ細孔保持状態をリアルタイム解析します。",
    formulationLabel: "ゾル-ゲル エアロゲル前駆体＆ポリマーマトリックス：",
    formulationHelp: "食品グレードの多糖類、タンパク質ヒドロゲル、または有機シリカハイブリッド処方を選択。",
    splLabel: "音響定在波 音圧レベル（dB SPL）：",
    splHelp: "浮遊軸における音響強度（150 – 170 dB）。Gor'kov 音響放射力ポテンシャル井戸の深さを決定します。",
    freqLabel: "圧電トランスデューサー超音波共振周波数（kHz）：",
    freqHelp: "動作周波数（25 – 60 kHz）。音響波長 λ = c / f とノード間隔 λ/2 を決定します。",
    pressureLabel: "超臨界CO2抽出チャンバー圧力（bar）：",
    pressureHelp: "運転圧力（90 – 220 bar, 臨界圧 P_crit = 73.8 bar）。溶媒密度を制御し、界面メニスカス張力を完全消失（γ = 0）させます。",
    tempLabel: "抽出チャンバー温度（°C）：",
    tempHelp: "等温乾燥温度（35.0 – 55.0 °C, 臨界温度 T_crit = 31.1 °C）。熱感受性有効成分の熱変性を完全に防止します。",
    flowLabel: "超臨界CO2溶媒循環質量流量（kg/h）：",
    flowHelp: "音響浮遊垂直カラム内を上昇通過する超臨界CO2の連続質量流量（5.0 – 35.0 kg/h）。",
    dropletLabel: "滴下前駆体液滴初期直径（µm）：",
    dropletHelp: "ピエゾマイクロディスペンサーから吐出されるアルコゲル液滴径（200 – 1200 µm）。",
    presetsTitle: "シミュレーション プリセット：",
    presetSilicaAlginate: "シリカ-アルギン酸ハイブリッド（840 m²/g）",
    presetCncChitosan: "CNC-キトサン生分解エアロゲル（760 m²/g）",
    presetPureSilica: "高メソ孔純シリカ（925 m²/g）",
    presetPectin: "柑橘ペクチン / Ca2+（735 m²/g）",
    presetZein: "ゼイン植物性タンパク質（790 m²/g）",
    presetHazard: "亜臨界相態 / 浮遊脱落フォールト",
    telemetryTitle: "音響放射力バランス＆ナノ細孔保全リアルタイムテレメトリ",
    telemetrySub: "Gor'kov 放射力対重力比、Young-Laplace 毛細管応力、BET比表面積、メソ細孔率、体積収縮率のリアルタイム力学演算結果。",
    trappingRatioLabel: "音響放射力対重力比率（F_rad / F_g）：",
    capillaryPressureLabel: "Young-Laplace 毛細管応力（P_cap）：",
    surfaceAreaLabel: "BET 窒素吸着比表面積（m²/g）：",
    porosityLabel: "総開気孔メソ細孔率（%）：",
    bulkDensityLabel: "エアロゲル微小球見掛け嵩密度（g/cm³）：",
    shrinkageLabel: "乾燥体積収縮率（%）：",
    dryingDurationLabel: "連続乾燥滞留所要時間（min）：",
    integrityLabel: "生体活性成分化学的保持率（%）：",
    secLabel: "単位製品比エネルギー消費量（SEC）：",
    verdictLabel: "エアロゲル合成判定＆食品衛生グレード：",
    diagramTitle: "非接触フェーズドアレイ超音波浮遊超臨界乾燥カラム系統図",
    diagramSub: "垂直高圧パイプ内での定在波ノード音響捕集、重力自己バランス、容器壁接触ゼロ、超高速溶媒抽出挙動を図解。",
    chartTitle: "IUPAC IV型メソ細孔窒素吸着等温線＆BJH細孔径分布",
    chartSub: "細孔ネック崩壊のない15–25 nmの均一なメソ細孔骨格を示す吸着ヒステリシス曲線。",
    principlesTitle: "音響浮遊力学、超臨界熱力学＆ゾル-ゲル相転移理論",
    principlesSub: "支配方程式：Gor'kov 音響ポテンシャル、Young-Laplace ゼロ界面張力、Knudsen ナノ孔超臨界拡散、BET吸着比表面積。",
    compTitle: "工業用エアロゲル微小球合成＆粉体乾燥技術比較ベンチマーク",
    compSub: "AL-SAD 非接触連続乾燥、回分式高圧オートクレーブ乾燥、真空凍結乾燥（フリーズドライ）、高温噴霧乾燥（スプレードライ）の比較。",
    regTitle: "国際食品安全衛生エンジニアリング＆圧力容器適合認証",
    regSub: "FDA 21 CFR § 117 FSMA cGMP、3-A 衛生基準 63-04 & 08-17、EHEDG Type EL Class I、ASME Section VIII Div 1 適合認証。"
  }
};

const d = DICT[lang] || DICT.en;
const formulations = alSadData.aerogelFormulations;
const benchmarks = alSadData.industrialTechnologyComparison;
---

<div class="al-sad-modeler bg-surface border border-hairline rounded-3xl p-6 sm:p-10 shadow-sm" data-lang={lang}>
  <!-- Header / Badge -->
  <div class="mb-8 border-b border-hairline/80 pb-6">
    <div class="flex items-center gap-2 mb-3">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-cyan-950 text-cyan-300 border border-cyan-800">
        {d.badge}
      </span>
      <span class="text-xs text-muted font-mono">AL-SAD &bull; 40 kHz &bull; S_BET &gt; 720 m²/g &bull; IUPAC Mesoporous</span>
    </div>
    <h2 class="text-2xl sm:text-3xl font-extrabold text-ink tracking-tight mb-3">
      {d.title}
    </h2>
    <p class="text-sm sm:text-base text-muted leading-relaxed max-w-4xl">
      {d.subtitle}
    </p>
  </div>

  <!-- Simulation Quick Presets -->
  <div class="mb-8 bg-surface-soft border border-hairline/70 rounded-2xl p-5">
    <h3 class="text-xs font-bold uppercase tracking-wider text-ink mb-3 flex items-center gap-2">
      <svg class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
      </svg>
      {d.presetsTitle}
    </h3>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2">
      <button type="button" class="preset-btn px-3 py-2 text-xs font-medium rounded-xl border border-hairline bg-surface hover:bg-cyan-900/30 hover:border-cyan-500 text-ink transition-all text-left" data-preset="silica-alginate">
        {d.presetSilicaAlginate}
      </button>
      <button type="button" class="preset-btn px-3 py-2 text-xs font-medium rounded-xl border border-hairline bg-surface hover:bg-cyan-900/30 hover:border-cyan-500 text-ink transition-all text-left" data-preset="cnc-chitosan">
        {d.presetCncChitosan}
      </button>
      <button type="button" class="preset-btn px-3 py-2 text-xs font-medium rounded-xl border border-hairline bg-surface hover:bg-cyan-900/30 hover:border-cyan-500 text-ink transition-all text-left" data-preset="pure-silica">
        {d.presetPureSilica}
      </button>
      <button type="button" class="preset-btn px-3 py-2 text-xs font-medium rounded-xl border border-hairline bg-surface hover:bg-cyan-900/30 hover:border-cyan-500 text-ink transition-all text-left" data-preset="pectin">
        {d.presetPectin}
      </button>
      <button type="button" class="preset-btn px-3 py-2 text-xs font-medium rounded-xl border border-hairline bg-surface hover:bg-cyan-900/30 hover:border-cyan-500 text-ink transition-all text-left" data-preset="zein">
        {d.presetZein}
      </button>
      <button type="button" class="preset-btn px-3 py-2 text-xs font-medium rounded-xl border border-rose-900/60 bg-rose-950/20 hover:bg-rose-900/40 hover:border-rose-500 text-rose-300 transition-all text-left" data-preset="hazard">
        {d.presetHazard}
      </button>
    </div>
  </div>

  <!-- Interactive Controls Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-10">
    <!-- Controls Column -->
    <div class="lg:col-span-6 space-y-6 bg-surface-soft/60 border border-hairline/80 rounded-2xl p-6">
      <div class="border-b border-hairline/60 pb-3">
        <h3 class="text-base font-bold text-ink">{d.controlsTitle}</h3>
        <p class="text-xs text-muted mt-1">{d.controlsSub}</p>
      </div>

      <!-- Formulation Selector -->
      <div>
        <label for="formulation-select" class="block text-xs font-semibold text-ink mb-1">
          {d.formulationLabel}
        </label>
        <select id="formulation-select" class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-xs text-ink focus:outline-none focus:border-cyan-500 transition-colors">
          {formulations.map(f => (
            <option value={f.id}>{f.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1" id="formulation-desc">
          {formulations[0].formulationDescription}
        </p>
      </div>

      <!-- Sound Pressure Level Slider -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <label for="spl-slider" class="text-xs font-semibold text-ink">{d.splLabel}</label>
          <span class="text-xs font-mono font-bold text-cyan-400" id="spl-val">160.0 dB</span>
        </div>
        <input type="range" id="spl-slider" min="150" max="170" step="0.5" value="160.0" class="w-full accent-cyan-500 cursor-pointer" />
        <p class="text-[11px] text-muted mt-1">{d.splHelp}</p>
      </div>

      <!-- Ultrasonic Frequency Slider -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <label for="freq-slider" class="text-xs font-semibold text-ink">{d.freqLabel}</label>
          <span class="text-xs font-mono font-bold text-cyan-400" id="freq-val">40.0 kHz</span>
        </div>
        <input type="range" id="freq-slider" min="25" max="60" step="1.0" value="40.0" class="w-full accent-cyan-500 cursor-pointer" />
        <p class="text-[11px] text-muted mt-1">{d.freqHelp}</p>
      </div>

      <!-- Supercritical CO2 Pressure Slider -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <label for="pressure-slider" class="text-xs font-semibold text-ink">{d.pressureLabel}</label>
          <span class="text-xs font-mono font-bold text-cyan-400" id="pressure-val">140.0 bar</span>
        </div>
        <input type="range" id="pressure-slider" min="90" max="220" step="1.0" value="140.0" class="w-full accent-cyan-500 cursor-pointer" />
        <p class="text-[11px] text-muted mt-1">{d.pressureHelp}</p>
      </div>

      <!-- Temperature Slider -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <label for="temp-slider" class="text-xs font-semibold text-ink">{d.tempLabel}</label>
          <span class="text-xs font-mono font-bold text-cyan-400" id="temp-val">40.0 °C</span>
        </div>
        <input type="range" id="temp-slider" min="32.0" max="55.0" step="0.5" value="40.0" class="w-full accent-cyan-500 cursor-pointer" />
        <p class="text-[11px] text-muted mt-1">{d.tempHelp}</p>
      </div>

      <!-- Supercritical CO2 Mass Flow Rate -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <label for="flow-slider" class="text-xs font-semibold text-ink">{d.flowLabel}</label>
          <span class="text-xs font-mono font-bold text-cyan-400" id="flow-val">18.0 kg/h</span>
        </div>
        <input type="range" id="flow-slider" min="5.0" max="35.0" step="0.5" value="18.0" class="w-full accent-cyan-500 cursor-pointer" />
        <p class="text-[11px] text-muted mt-1">{d.flowHelp}</p>
      </div>

      <!-- Droplet Diameter Slider -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <label for="droplet-slider" class="text-xs font-semibold text-ink">{d.dropletLabel}</label>
          <span class="text-xs font-mono font-bold text-cyan-400" id="droplet-val">480 µm</span>
        </div>
        <input type="range" id="droplet-slider" min="200" max="1200" step="10" value="480" class="w-full accent-cyan-500 cursor-pointer" />
        <p class="text-[11px] text-muted mt-1">{d.dropletHelp}</p>
      </div>
    </div>

    <!-- Live Telemetry & Calculations Column -->
    <div class="lg:col-span-6 space-y-6">
      <div class="bg-surface-soft border border-hairline rounded-2xl p-6">
        <div class="border-b border-hairline/60 pb-3 mb-4 flex justify-between items-center">
          <div>
            <h3 class="text-base font-bold text-ink">{d.telemetryTitle}</h3>
            <p class="text-xs text-muted mt-0.5">{d.telemetrySub}</p>
          </div>
          <span id="telemetry-chip" class="px-2.5 py-1 text-[11px] font-bold rounded-lg bg-emerald-950 text-emerald-300 border border-emerald-800">
            OPTIMAL_LEVITATION
          </span>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <!-- Acoustic Force Ratio -->
          <div class="bg-surface p-3.5 rounded-xl border border-hairline">
            <span class="text-[11px] text-muted block mb-1">{d.trappingRatioLabel}</span>
            <span class="text-lg font-mono font-extrabold text-cyan-400" id="out-trapping">3.85x</span>
            <span class="text-[10px] text-muted block mt-0.5">F_rad &gt; 3.0× Gravity (Stable)</span>
          </div>

          <!-- Capillary Stress -->
          <div class="bg-surface p-3.5 rounded-xl border border-hairline">
            <span class="text-[11px] text-muted block mb-1">{d.capillaryPressureLabel}</span>
            <span class="text-lg font-mono font-extrabold text-emerald-400" id="out-capillary">0.00 MPa</span>
            <span class="text-[10px] text-muted block mt-0.5">γ = 0 (Zero Meniscus Tension)</span>
          </div>

          <!-- Specific Surface Area -->
          <div class="bg-surface p-3.5 rounded-xl border border-hairline">
            <span class="text-[11px] text-muted block mb-1">{d.surfaceAreaLabel}</span>
            <span class="text-lg font-mono font-extrabold text-ink" id="out-surface-area">840 m²/g</span>
            <span class="text-[10px] text-muted block mt-0.5">S_BET (N2 Adsorption)</span>
          </div>

          <!-- Porosity -->
          <div class="bg-surface p-3.5 rounded-xl border border-hairline">
            <span class="text-[11px] text-muted block mb-1">{d.porosityLabel}</span>
            <span class="text-lg font-mono font-extrabold text-ink" id="out-porosity">97.4%</span>
            <span class="text-[10px] text-muted block mt-0.5">Open Meso-Pore Volume</span>
          </div>

          <!-- Bulk Density -->
          <div class="bg-surface p-3.5 rounded-xl border border-hairline">
            <span class="text-[11px] text-muted block mb-1">{d.bulkDensityLabel}</span>
            <span class="text-lg font-mono font-extrabold text-ink" id="out-density">0.038 g/cm³</span>
            <span class="text-[10px] text-muted block mt-0.5">Ultralight Aerogel Foam</span>
          </div>

          <!-- Shrinkage Factor -->
          <div class="bg-surface p-3.5 rounded-xl border border-hairline">
            <span class="text-[11px] text-muted block mb-1">{d.shrinkageLabel}</span>
            <span class="text-lg font-mono font-extrabold text-emerald-400" id="out-shrinkage">4.2%</span>
            <span class="text-[10px] text-muted block mt-0.5">ΔV / V_0 Volumetric Loss</span>
          </div>

          <!-- Continuous Drying Duration -->
          <div class="bg-surface p-3.5 rounded-xl border border-hairline">
            <span class="text-[11px] text-muted block mb-1">{d.dryingDurationLabel}</span>
            <span class="text-lg font-mono font-extrabold text-ink" id="out-duration">22.0 min</span>
            <span class="text-[10px] text-muted block mt-0.5">Supercritical In-Line Residence</span>
          </div>

          <!-- SEC -->
          <div class="bg-surface p-3.5 rounded-xl border border-hairline">
            <span class="text-[11px] text-muted block mb-1">{d.secLabel}</span>
            <span class="text-lg font-mono font-extrabold text-ink" id="out-sec">0.52 kWh/kg</span>
            <span class="text-[10px] text-muted block mt-0.5">&gt;85% Energy Saving vs Freeze</span>
          </div>
        </div>

        <!-- Overall Verdict Callout -->
        <div class="mt-5 p-4 rounded-xl border border-cyan-800 bg-cyan-950/30" id="verdict-box">
          <div class="flex items-start gap-3">
            <div class="w-2.5 h-2.5 rounded-full bg-cyan-400 mt-1.5 shrink-0" id="verdict-dot"></div>
            <div>
              <span class="text-xs font-bold text-ink block" id="verdict-title">
                OPTIMAL_CONTAINERLESS_AEROGEL: 100% Intact Mesoporous Network
              </span>
              <p class="text-xs text-muted mt-1 leading-relaxed" id="verdict-desc">
                Acoustic radiation pressure exceeds gravitational acceleration by 3.85x, maintaining frictionless containerless levitation at the acoustic pressure node. Dense-phase supercritical CO2 completely extracts solvent with zero interfacial tension (P_cap = 0.00 MPa), preventing pore wall collapse.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Schematic Diagram: Acoustic Supercritical Column -->
      <div class="bg-surface-soft border border-hairline rounded-2xl p-6">
        <div class="border-b border-hairline/60 pb-3 mb-4">
          <h3 class="text-xs font-bold uppercase tracking-wider text-ink flex items-center gap-2">
            <svg class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
            {d.diagramTitle}
          </h3>
          <p class="text-[11px] text-muted mt-1">{d.diagramSub}</p>
        </div>

        <div class="w-full overflow-hidden flex justify-center py-2">
          <svg viewBox="0 0 540 240" class="w-full max-w-lg h-auto font-mono text-[10px]">
            <defs>
              <linearGradient id="scCo2Flow" x1="0%" y1="100%" x2="0%" y2="0%">
                <stop offset="0%" stop-color="#0e7490" stop-opacity="0.15" />
                <stop offset="100%" stop-color="#06b6d4" stop-opacity="0.4" />
              </linearGradient>
              <radialGradient id="acousticNodeGlow" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#22d3ee" stop-opacity="0.9" />
                <stop offset="70%" stop-color="#0891b2" stop-opacity="0.4" />
                <stop offset="100%" stop-color="#0891b2" stop-opacity="0" />
              </radialGradient>
            </defs>

            <!-- Column Housing -->
            <rect x="140" y="20" width="260" height="200" rx="16" fill="#0f172a" stroke="#334155" stroke-width="2" />
            <rect x="150" y="30" width="240" height="180" rx="10" fill="url(#scCo2Flow)" stroke="#0e7490" stroke-width="1" stroke-dasharray="3 3" />

            <!-- Transducer Emitters (Top & Bottom) -->
            <rect x="180" y="10" width="180" height="12" rx="4" fill="#1e293b" stroke="#38bdf8" stroke-width="1.5" />
            <text x="270" y="19" fill="#38bdf8" text-anchor="middle" font-size="8">TOP PHASED ULTRASONIC EMITTER (40 kHz)</text>

            <rect x="180" y="218" width="180" height="12" rx="4" fill="#1e293b" stroke="#38bdf8" stroke-width="1.5" />
            <text x="270" y="227" fill="#38bdf8" text-anchor="middle" font-size="8">BOTTOM PHASED ULTRASONIC REFLECTOR</text>

            <!-- Acoustic Standing Wave Isobars -->
            <path d="M 160,70 Q 270,45 380,70" fill="none" stroke="#22d3ee" stroke-width="1.5" stroke-dasharray="4 2" opacity="0.6" />
            <path d="M 160,110 Q 270,135 380,110" fill="none" stroke="#22d3ee" stroke-width="1.5" opacity="0.8" />
            <path d="M 160,150 Q 270,125 380,150" fill="none" stroke="#22d3ee" stroke-width="1.5" stroke-dasharray="4 2" opacity="0.6" />

            <!-- Acoustic Pressure Node (Trapped Microsphere) -->
            <circle cx="270" cy="120" r="16" fill="url(#acousticNodeGlow)" />
            <circle cx="270" cy="120" r="7" fill="#67e8f9" stroke="#ffffff" stroke-width="1.5" />
            <text x="270" y="100" fill="#a5f3fc" text-anchor="middle" font-weight="bold" font-size="9">ACOUSTIC NODE: r_sphere = 240 µm</text>

            <!-- Flow Arrows (Supercritical CO2 upward) -->
            <g stroke="#38bdf8" stroke-width="1.5" fill="none" opacity="0.7">
              <path d="M 170,180 L 170,60" />
              <polygon points="167,65 170,55 173,65" fill="#38bdf8" />
              <path d="M 370,180 L 370,60" />
              <polygon points="367,65 370,55 373,65" fill="#38bdf8" />
            </g>
            <text x="175" y="175" fill="#38bdf8" font-size="8" transform="rotate(-90 175,175)">Upward scCO2 Flow (18 kg/h)</text>

            <!-- Gas-Liquid Separation & CIP annotations -->
