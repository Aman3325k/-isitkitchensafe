    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs text-muted">
        <thead class="bg-surface text-ink uppercase tracking-wider font-bold border-b border-hairline">
          <tr>
            <th class="py-3 px-4">Parameter / Metric</th>
            <th class="py-3 px-4 text-cyan-400">AL-SAD Acoustic Supercritical</th>
            <th class="py-3 px-4">Batch Autoclave scCO2</th>
            <th class="py-3 px-4">Vacuum Freeze-Drying</th>
            <th class="py-3 px-4">Hot Air Spray Drying</th>
