const d = DICT[lang] || DICT.en;
---

<div class="bg-surface border border-hairline rounded-3xl p-6 md:p-8 space-y-8 shadow-xs" id="induction-emf-modeler">
  <!-- Tool Header Banner -->
  <header class="border-b border-hairline pb-6">
    <div class="flex flex-wrap items-center justify-between gap-3 mb-2">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-sky-600 text-white">
        {d.badge}
      </span>
      <span class="text-xs text-muted font-mono">
        ICNIRP 1998/2010 &bull; IEC 62233 &bull; ISO 14117 CIED Standard
      </span>
    </div>
    <h1 class="text-display-md md:text-display-lg font-bold text-ink tracking-tight">
      {d.title}
    </h1>
    <p class="text-sm md:text-base text-body leading-relaxed mt-2 max-w-4xl">
      {d.subtitle}
    </p>
  </header>

  <!-- One-Click Diagnostic Presets -->
  <section class="bg-surface-soft border border-hairline/80 rounded-2xl p-5 space-y-3">
    <div class="flex items-center justify-between">
      <h3 class="text-xs md:text-sm font-bold uppercase tracking-wider text-muted">
        {d.presetsTitle}
      </h3>
      <span class="text-[11px] text-muted">Click to instantly load clinical &amp; culinary scenarios</span>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2">
      <button type="button" data-preset="preset-standard-cooking" class="preset-btn px-3 py-2 text-xs font-medium rounded-xl border border-hairline bg-surface hover:bg-surface-strong text-ink transition-all text-left">
        {d.presetStandard}
      </button>
      <button type="button" data-preset="preset-pacemaker-leaning" class="preset-btn px-3 py-2 text-xs font-medium rounded-xl border border-hairline bg-surface hover:bg-surface-strong text-amber-700 dark:text-amber-400 transition-all text-left">
        {d.presetPacemakerLeaning}
      </button>
      <button type="button" data-preset="preset-unipolar-metal-spoon" class="preset-btn px-3 py-2 text-xs font-medium rounded-xl border border-hairline bg-surface hover:bg-surface-strong text-rose-700 dark:text-rose-400 transition-all text-left">
        {d.presetUnipolarMetal}
      </button>
      <button type="button" data-preset="preset-cardiac-safe-protocol" class="preset-btn px-3 py-2 text-xs font-medium rounded-xl border border-hairline bg-surface hover:bg-surface-strong text-emerald-700 dark:text-emerald-400 transition-all text-left">
        {d.presetCardiacSafe}
      </button>
      <button type="button" data-preset="preset-warped-aluminum-disk" class="preset-btn px-3 py-2 text-xs font-medium rounded-xl border border-hairline bg-surface hover:bg-surface-strong text-orange-700 dark:text-orange-400 transition-all text-left">
        {d.presetWarped}
      </button>
      <button type="button" data-preset="preset-commercial-boost" class="preset-btn px-3 py-2 text-xs font-medium rounded-xl border border-hairline bg-surface hover:bg-surface-strong text-sky-700 dark:text-sky-400 transition-all text-left">
        {d.presetBoost}
      </button>
    </div>
  </section>

  <!-- Dual Column Interactive Control & Live Analysis Dashboard -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Left: Reactive Controls -->
    <div class="lg:col-span-6 bg-surface-soft border border-hairline rounded-2xl p-6 space-y-6">
      <div>
        <h2 class="text-base md:text-lg font-bold text-ink">
          {d.controlsTitle}
        </h2>
        <p class="text-xs text-body mt-1">
          {d.controlsSub}
        </p>
      </div>

      <!-- Distance Slider -->
      <div class="space-y-2">
        <div class="flex items-center justify-between text-xs font-medium text-ink">
          <label for="emf-distance-slider" class="font-bold">{d.distLabel}</label>
          <span class="font-mono text-sky-600 dark:text-sky-400 text-sm font-bold" id="dist-display">35 cm (14 in)</span>
        </div>
        <input 
          type="range" 
          id="emf-distance-slider" 
          min="5" 
          max="80" 
          step="1" 
          value="35"
          class="w-full accent-sky-600 cursor-pointer"
        />
        <div class="flex justify-between text-[11px] text-muted">
          <span>5 cm (Touching Counter Edge)</span>
          <span>30 cm (AHA / Standard Standing)</span>
          <span>80 cm (2.6 ft)</span>
        </div>
      </div>

      <!-- Power Rating Selector -->
      <div class="space-y-2">
        <label for="emf-power-select" class="block text-xs font-bold text-ink">
          {d.powerLabel}
        </label>
        <select id="emf-power-select" class="w-full p-2.5 rounded-xl border border-hairline bg-surface text-ink text-xs md:text-sm font-medium focus:ring-2 focus:ring-sky-500 outline-none">
          {emfData.powers.map(p => (
            <option value={p.id} selected={p.id === 'p1400'}>
              {p.label} &bull; {p.watts}W
            </option>
          ))}
        </select>
      </div>

      <!-- Pot Sizing Ratio -->
      <div class="space-y-2">
        <label for="emf-potsize-select" class="block text-xs font-bold text-ink">
          {d.potSizeLabel}
        </label>
        <select id="emf-potsize-select" class="w-full p-2.5 rounded-xl border border-hairline bg-surface text-ink text-xs md:text-sm font-medium focus:ring-2 focus:ring-sky-500 outline-none">
          {emfData.pot_sizes.map(s => (
            <option value={s.id} selected={s.id === 'matched'}>
              {s.label}
            </option>
          ))}
        </select>
      </div>

      <!-- Pan Alignment & Centering -->
      <div class="space-y-2">
        <label for="emf-alignment-select" class="block text-xs font-bold text-ink">
          {d.alignmentLabel}
        </label>
        <select id="emf-alignment-select" class="w-full p-2.5 rounded-xl border border-hairline bg-surface text-ink text-xs md:text-sm font-medium focus:ring-2 focus:ring-sky-500 outline-none">
          {emfData.alignments.map(a => (
            <option value={a.id} selected={a.id === 'centered'}>
              {a.label}
            </option>
          ))}
        </select>
      </div>

      <!-- Cookware Material & Ferromagnetism -->
      <div class="space-y-2">
        <label for="emf-material-select" class="block text-xs font-bold text-ink">
          {d.materialLabel}
        </label>
        <select id="emf-material-select" class="w-full p-2.5 rounded-xl border border-hairline bg-surface text-ink text-xs md:text-sm font-medium focus:ring-2 focus:ring-sky-500 outline-none">
          {emfData.materials.map(m => (
            <option value={m.id} selected={m.id === 'clad_stainless'}>
              {m.name} ({m.coupling_efficiency} Coupling)
            </option>
          ))}
        </select>
      </div>

      <!-- Cardiac Implant Profile -->
      <div class="space-y-2">
        <label for="emf-implant-select" class="block text-xs font-bold text-ink">
          {d.implantLabel}
        </label>
        <select id="emf-implant-select" class="w-full p-2.5 rounded-xl border border-hairline bg-surface text-ink text-xs md:text-sm font-medium focus:ring-2 focus:ring-sky-500 outline-none">
          {emfData.implants.map(i => (
            <option value={i.id} selected={i.id === 'none'}>
              {i.label}
            </option>
          ))}
        </select>
      </div>

      <!-- Burner Placement & Utensil Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="space-y-2">
          <label for="emf-burner-select" class="block text-xs font-bold text-ink">
            {d.burnerLabel}
          </label>
          <select id="emf-burner-select" class="w-full p-2.5 rounded-xl border border-hairline bg-surface text-ink text-xs md:text-sm font-medium focus:ring-2 focus:ring-sky-500 outline-none">
            {emfData.burners.map(b => (
              <option value={b.id} selected={b.id === 'front'}>
                {b.label}
              </option>
            ))}
          </select>
        </div>
        <div class="space-y-2">
          <label for="emf-utensil-select" class="block text-xs font-bold text-ink">
            {d.utensilLabel}
          </label>
          <select id="emf-utensil-select" class="w-full p-2.5 rounded-xl border border-hairline bg-surface text-ink text-xs md:text-sm font-medium focus:ring-2 focus:ring-sky-500 outline-none">
            {emfData.utensils.map(u => (
              <option value={u.id} selected={u.id === 'wood_silicone'}>
                {u.label}
              </option>
            ))}
          </select>
        </div>
      </div>
    </div>

    <!-- Right: Live Diagnostic Output Dashboard -->
    <div class="lg:col-span-6 space-y-6">
      <!-- Main Status Card -->
      <div id="verdict-card" class="rounded-2xl border p-6 space-y-4 transition-all border-emerald-500/40 bg-emerald-500/5">
        <div class="flex items-center justify-between gap-3">
          <span class="text-xs font-bold uppercase tracking-wider text-muted">
            {d.overallStatusLabel}
          </span>
          <span id="tier-badge" class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-600 text-white">
            Tier A: Compliant
          </span>
        </div>
        <h3 id="verdict-title" class="text-base md:text-lg font-bold text-ink">
          {d.statusTierA}
        </h3>
        <p id="verdict-desc" class="text-xs md:text-sm text-body leading-relaxed">
          Stray magnetic flux density remains well beneath both ICNIRP reference limits and cardiac implant sensing interference thresholds. Safe for continuous cooking at this distance.
        </p>
      </div>

      <!-- Critical Warnings / Alerts Container -->
      <div id="alert-icnirp" class="hidden rounded-2xl border border-rose-500/40 bg-rose-500/10 p-5 space-y-2">
        <h4 class="text-xs md:text-sm font-bold text-rose-800 dark:text-rose-400 flex items-center gap-2">
          {d.alertIcnirpTitle}
        </h4>
        <p class="text-xs text-rose-900/80 dark:text-rose-300/90 leading-relaxed">
          {d.alertIcnirpText}
        </p>
      </div>

      <div id="alert-pacemaker" class="hidden rounded-2xl border border-amber-500/40 bg-amber-500/10 p-5 space-y-2">
        <h4 class="text-xs md:text-sm font-bold text-amber-800 dark:text-amber-400 flex items-center gap-2">
          {d.alertPacemakerTitle}
        </h4>
        <p class="text-xs text-amber-900/80 dark:text-amber-300/90 leading-relaxed">
          {d.alertPacemakerText}
        </p>
      </div>

      <div id="alert-utensil" class="hidden rounded-2xl border border-sky-500/40 bg-sky-500/10 p-5 space-y-2">
        <h4 class="text-xs md:text-sm font-bold text-sky-800 dark:text-sky-400 flex items-center gap-2">
          {d.alertUtensilTitle}
        </h4>
        <p class="text-xs text-sky-900/80 dark:text-sky-300/90 leading-relaxed">
          {d.alertUtensilText}
        </p>
      </div>

      <!-- Quantitative 6-Metric Grid -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-muted">
          {d.metricsTitle}
        </h4>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 text-xs">
          <!-- Metric 1: Flux Density -->
          <div class="bg-surface-soft border border-hairline rounded-xl p-3 space-y-1">
            <span class="text-muted block text-[11px]">{d.fluxDensityLabel}</span>
            <span id="metric-flux-ut" class="text-sm md:text-base font-mono font-bold text-ink block">0.42 μT</span>
            <span id="metric-flux-mg" class="text-[11px] font-mono text-muted block">4.20 mG</span>
          </div>

          <!-- Metric 2: ICNIRP 1998 Ratio -->
          <div class="bg-surface-soft border border-hairline rounded-xl p-3 space-y-1">
            <span class="text-muted block text-[11px]">{d.icnirp1998Label}</span>
            <span id="metric-icnirp-1998" class="text-sm md:text-base font-mono font-bold text-emerald-600 dark:text-emerald-400 block">6.7%</span>
            <span class="text-[11px] text-muted block">Limit: 6.25 μT</span>
          </div>

          <!-- Metric 3: ICNIRP 2010 Ratio -->
          <div class="bg-surface-soft border border-hairline rounded-xl p-3 space-y-1">
            <span class="text-muted block text-[11px]">{d.icnirp2010Label}</span>
            <span id="metric-icnirp-2010" class="text-sm md:text-base font-mono font-bold text-emerald-600 dark:text-emerald-400 block">1.6%</span>
            <span class="text-[11px] text-muted block">Limit: 27.0 μT</span>
          </div>

          <!-- Metric 4: Pacemaker EMI Stress -->
          <div class="bg-surface-soft border border-hairline rounded-xl p-3 space-y-1">
            <span class="text-muted block text-[11px]">{d.pacemakerEmiLabel}</span>
            <span id="metric-pacemaker-emi" class="text-sm md:text-base font-mono font-bold text-emerald-600 dark:text-emerald-400 block">2.8%</span>
            <span id="metric-pacemaker-threshold" class="text-[11px] text-muted block">Threshold: 15.0 μT</span>
          </div>

          <!-- Metric 5: Safe Distance -->
          <div class="bg-surface-soft border border-hairline rounded-xl p-3 space-y-1">
            <span class="text-muted block text-[11px]">{d.safeDistanceLabel}</span>
            <span id="metric-safe-dist" class="text-sm md:text-base font-mono font-bold text-sky-600 dark:text-sky-400 block">15 cm</span>
            <span id="metric-safe-dist-in" class="text-[11px] font-mono text-muted block">(6.0 in)</span>
          </div>

          <!-- Metric 6: Distance Attenuation -->
          <div class="bg-surface-soft border border-hairline rounded-xl p-3 space-y-1">
            <span class="text-muted block text-[11px]">{d.attenuationLabel}</span>
            <span id="metric-attenuation" class="text-sm md:text-base font-mono font-bold text-ink block">-96.2%</span>
            <span class="text-[11px] text-muted block">1/r^2.4 Inverse Falloff</span>
          </div>
        </div>
      </div>

      <!-- Biophysical Context Panels -->
      <div class="space-y-3">
        <div class="bg-surface-soft border border-hairline rounded-xl p-4 space-y-1 text-xs">
          <div class="flex items-center justify-between font-bold text-ink">
            <span>{d.implantImpactTitle}</span>
            <span id="implant-badge" class="font-mono text-emerald-600 dark:text-emerald-400">Zero Sensing Risk</span>
          </div>
          <p id="implant-impact-text" class="text-muted leading-relaxed">
            Standard public cooking: magnetic flux density remains comfortably within international safety margins.
          </p>
        </div>

        <div class="bg-surface-soft border border-hairline rounded-xl p-4 space-y-1 text-xs">
          <div class="flex items-center justify-between font-bold text-ink">
            <span>{d.couplingImpactTitle}</span>
            <span id="coupling-badge" class="font-mono text-emerald-600 dark:text-emerald-400">High Permeability (μr)</span>
          </div>
          <p id="coupling-impact-text" class="text-muted leading-relaxed">
            Ferromagnetic base absorbs >90% of alternating magnetic field lines, tightly confining eddy currents.
          </p>
        </div>
      </div>

      <!-- Action Button: Copy Report -->
      <div>
        <button 
          type="button" 
          id="copy-emf-report-btn" 
          class="w-full py-3 px-4 rounded-xl bg-ink hover:bg-black text-white text-center font-medium text-xs md:text-sm transition-all shadow-xs flex items-center justify-center gap-2"
        >
          <span id="copy-report-text">{d.copyReportBtn}</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Step-by-Step DIY Household Induction Safety Protocols -->
  <section class="bg-surface-soft border border-hairline rounded-2xl p-6 md:p-8 space-y-6">
    <div class="border-b border-hairline pb-4">
      <h3 class="text-base md:text-lg font-bold text-ink">
        {d.protocolsTitle}
      </h3>
      <p class="text-xs md:text-sm text-body leading-relaxed mt-1">
        {d.protocolsSub}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs md:text-sm">
      <div class="p-4 rounded-xl bg-surface border border-hairline space-y-2">
        <h4 class="font-bold text-ink flex items-center gap-2">
          <span class="w-6 h-6 rounded-full bg-sky-600 text-white flex items-center justify-center text-xs font-bold">1</span>
          {d.step1Title}
        </h4>
        <p class="text-body leading-relaxed">
          {d.step1Text}
        </p>
      </div>

      <div class="p-4 rounded-xl bg-surface border border-hairline space-y-2">
        <h4 class="font-bold text-ink flex items-center gap-2">
          <span class="w-6 h-6 rounded-full bg-emerald-600 text-white flex items-center justify-center text-xs font-bold">2</span>
          {d.step2Title}
        </h4>
        <p class="text-body leading-relaxed">
          {d.step2Text}
        </p>
      </div>

      <div class="p-4 rounded-xl bg-surface border border-hairline space-y-2">
        <h4 class="font-bold text-ink flex items-center gap-2">
          <span class="w-6 h-6 rounded-full bg-amber-600 text-white flex items-center justify-center text-xs font-bold">3</span>
          {d.step3Title}
        </h4>
        <p class="text-body leading-relaxed">
          {d.step3Text}
        </p>
      </div>

      <div class="p-4 rounded-xl bg-surface border border-hairline space-y-2">
        <h4 class="font-bold text-ink flex items-center gap-2">
          <span class="w-6 h-6 rounded-full bg-violet-600 text-white flex items-center justify-center text-xs font-bold">4</span>
          {d.step4Title}
        </h4>
        <p class="text-body leading-relaxed">
          {d.step4Text}
        </p>
      </div>
    </div>
  </section>

  <!-- Cross-Link Cards to Other Specialized Calculators -->
  <footer class="pt-4 border-t border-hairline">
    <h4 class="text-xs font-bold uppercase tracking-wider text-muted mb-4">
      {d.crossLinkTitle}
    </h4>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 text-xs">
      <a href="/tools/microwave-radiation-leakage-evaluator/" class="p-3 rounded-xl bg-surface-soft hover:bg-surface-strong border border-hairline transition-all block">
        <span class="font-semibold text-ink block mb-0.5">{d.crossLinkMicrowave}</span>
        <span class="text-[11px] text-muted">2.45 GHz Choke Cavity &bull; FDA 1030.10</span>
      </a>
      <a href="/tools/slow-cooker-safety-simulator/" class="p-3 rounded-xl bg-surface-soft hover:bg-surface-strong border border-hairline transition-all block">
        <span class="font-semibold text-ink block mb-0.5">{d.crossLinkSlowCooker}</span>
        <span class="text-[11px] text-muted">Lead Glaze Leaching &bull; C. perfringens</span>
      </a>
      <a href="/tools/air-fryer-acrylamide-calculator/" class="p-3 rounded-xl bg-surface-soft hover:bg-surface-strong border border-hairline transition-all block">
        <span class="font-semibold text-ink block mb-0.5">{d.crossLinkAirFryer}</span>
        <span class="text-[11px] text-muted">Maillard Byproducts &bull; EFSA 0.17 mg/kg</span>
      </a>
      <a href="/tools/sous-vide-plastic-microbial-modeler/" class="p-3 rounded-xl bg-surface-soft hover:bg-surface-strong border border-hairline transition-all block">
        <span class="font-semibold text-ink block mb-0.5">{d.crossLinkSousVide}</span>
        <span class="text-[11px] text-muted">Core D-Lethality &bull; C. botulinum</span>
      </a>
      <a href="/tools/thermal-shock-simulator/" class="p-3 rounded-xl bg-surface-soft hover:bg-surface-strong border border-hairline transition-all block">
        <span class="font-semibold text-ink block mb-0.5">{d.crossLinkThermalShock}</span>
        <span class="text-[11px] text-muted">Thermoelastic Stress &bull; Explosion ΔT</span>
      </a>
    </div>
  </footer>
</div>

<script is:inline define:vars={{ emfData, currentLang: lang, dictObj: d }}>
  (function() {
    // DOM Elements
    const distSlider = document.getElementById('emf-distance-slider');
    const distDisplay = document.getElementById('dist-display');
    const powerSelect = document.getElementById('emf-power-select');
    const potSizeSelect = document.getElementById('emf-potsize-select');
    const alignmentSelect = document.getElementById('emf-alignment-select');
    const materialSelect = document.getElementById('emf-material-select');
    const implantSelect = document.getElementById('emf-implant-select');
    const burnerSelect = document.getElementById('emf-burner-select');
    const utensilSelect = document.getElementById('emf-utensil-select');

    // Output DOM
    const verdictCard = document.getElementById('verdict-card');
    const tierBadge = document.getElementById('tier-badge');
    const verdictTitle = document.getElementById('verdict-title');
    const verdictDesc = document.getElementById('verdict-desc');

    const alertIcnirp = document.getElementById('alert-icnirp');
    const alertPacemaker = document.getElementById('alert-pacemaker');
    const alertUtensil = document.getElementById('alert-utensil');

    const mFluxUt = document.getElementById('metric-flux-ut');
    const mFluxMg = document.getElementById('metric-flux-mg');
    const mIcnirp1998 = document.getElementById('metric-icnirp-1998');
    const mIcnirp2010 = document.getElementById('metric-icnirp-2010');
    const mPacemakerEmi = document.getElementById('metric-pacemaker-emi');
    const mPacemakerThreshold = document.getElementById('metric-pacemaker-threshold');
    const mSafeDist = document.getElementById('metric-safe-dist');
    const mSafeDistIn = document.getElementById('metric-safe-dist-in');
    const mAttenuation = document.getElementById('metric-attenuation');

    const implantBadge = document.getElementById('implant-badge');
    const implantImpactText = document.getElementById('implant-impact-text');
    const couplingBadge = document.getElementById('coupling-badge');
    const couplingImpactText = document.getElementById('coupling-impact-text');

    const copyBtn = document.getElementById('copy-emf-report-btn');
    const copyBtnText = document.getElementById('copy-report-text');
    const presetButtons = document.querySelectorAll('.preset-btn');

    function calculate() {
      const userDistCm = parseInt(distSlider ? distSlider.value : '35', 10);
      const userDistIn = Math.round(userDistCm / 2.54);
      if (distDisplay) {
        distDisplay.textContent = userDistCm + " cm (" + userDistIn + " in)";
      }

      const powerId = powerSelect ? powerSelect.value : 'p1400';
      const potSizeId = potSizeSelect ? potSizeSelect.value : 'matched';
      const alignmentId = alignmentSelect ? alignmentSelect.value : 'centered';
      const materialId = materialSelect ? materialSelect.value : 'clad_stainless';
      const implantId = implantSelect ? implantSelect.value : 'none';
      const burnerId = burnerSelect ? burnerSelect.value : 'front';
      const utensilId = utensilSelect ? utensilSelect.value : 'wood_silicone';

      const powerObj = emfData.powers.find(p => p.id === powerId) || emfData.powers[2];
      const potObj = emfData.pot_sizes.find(s => s.id === potSizeId) || emfData.pot_sizes[2];
      const alignObj = emfData.alignments.find(a => a.id === alignmentId) || emfData.alignments[0];
      const matObj = emfData.materials.find(m => m.id === materialId) || emfData.materials[1];
      const implantObj = emfData.implants.find(i => i.id === implantId) || emfData.implants[0];
      const burnerObj = emfData.burners.find(b => b.id === burnerId) || emfData.burners[0];
      const utensilObj = emfData.utensils.find(u => u.id === utensilId) || emfData.utensils[0];

      // Physical calculation
      // Effective total distance = user standing distance + burner buffer distance
      const totalDistCm = userDistCm + burnerObj.distance_buffer_cm;

      // Base flux at 5 cm contact rim
      const baseRimFlux = powerObj.base_uT_5cm * potObj.leakage_mult * alignObj.offset_mult * matObj.material_mult * utensilObj.utensil_mult;

      // Distance power law attenuation: B(r) = B_rim * (5 / r)^2.4
      const distFactor = Math.pow(5 / Math.max(5, totalDistCm), 2.4);
      const fluxAtDistance = baseRimFlux * distFactor;
      const fluxMg = fluxAtDistance * 10;

      // Ratios
      const icnirp1998Ratio = (fluxAtDistance / emfData.standards.icnirp1998_public_uT) * 100;
      const icnirp2010Ratio = (fluxAtDistance / emfData.standards.icnirp2010_public_uT) * 100;
      const implantThreshold = implantObj.emi_threshold_uT;
      const pacemakerEmiRatio = (fluxAtDistance / implantThreshold) * 100;

      // Minimum safe distance D_safe for this implant
      // D_safe = 5 * (baseRimFlux / implantThreshold)^(1 / 2.4)
      let minSafeDistanceCm = Math.round(5 * Math.pow(Math.max(1, baseRimFlux / implantThreshold), 1 / 2.4));
      minSafeDistanceCm = Math.max(implantObj.safe_distance_cm, Math.min(120, minSafeDistanceCm));
      const minSafeDistanceIn = Math.round(minSafeDistanceCm / 2.54);

      // Distance attenuation percentage vs contact rim
      const attenuationPct = Math.max(0, Math.min(99.9, (1 - (fluxAtDistance / baseRimFlux)) * 100));

      // Tier Matching
      let matchedTier = emfData.tiers[0];
      if (fluxAtDistance >= 27.0) {
        matchedTier = emfData.tiers[4]; // Tier E
      } else if (fluxAtDistance >= 6.25) {
        matchedTier = emfData.tiers[3]; // Tier D
      } else if (fluxAtDistance >= 2.0) {
        matchedTier = emfData.tiers[2]; // Tier C
      } else if (fluxAtDistance >= 0.5) {
        matchedTier = emfData.tiers[1]; // Tier B
      } else {
        matchedTier = emfData.tiers[0]; // Tier A
      }

      // Update Verdict Card UI
      if (verdictCard) {
        verdictCard.className = "rounded-2xl border p-6 space-y-4 transition-all " + matchedTier.cardClass;
      }
      if (tierBadge) {
        tierBadge.className = "px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider " + matchedTier.badgeClass;
        tierBadge.textContent = matchedTier.tier + ": " + (matchedTier.max_uT < 1.0 ? "Absolute Safe" : (matchedTier.max_uT <= 6.25 ? "Compliant" : "EMI Risk"));
      }
      if (verdictTitle) {
        if (matchedTier.tier === 'Tier A') verdictTitle.textContent = dictObj.statusTierA;
        else if (matchedTier.tier === 'Tier B') verdictTitle.textContent = dictObj.statusTierB;
        else if (matchedTier.tier === 'Tier C') verdictTitle.textContent = dictObj.statusTierC;
        else if (matchedTier.tier === 'Tier D') verdictTitle.textContent = dictObj.statusTierD;
        else verdictTitle.textContent = dictObj.statusTierE;
      }
      if (verdictDesc) {
        verdictDesc.textContent = matchedTier.pacemaker_safety + " " + matchedTier.clinical_verdict;
      }

      // Update Alerts
      if (alertIcnirp) {
        if (fluxAtDistance >= 6.25) alertIcnirp.classList.remove('hidden');
        else alertIcnirp.classList.add('hidden');
      }
      if (alertPacemaker) {
        if (pacemakerEmiRatio >= 80 && implantId !== 'none') alertPacemaker.classList.remove('hidden');
        else alertPacemaker.classList.add('hidden');
      }
      if (alertUtensil) {
        if (utensilId === 'metal_spoon' && fluxAtDistance >= 1.5) alertUtensil.classList.remove('hidden');
        else alertUtensil.classList.add('hidden');
      }

      // Update Metrics
      if (mFluxUt) mFluxUt.textContent = fluxAtDistance.toFixed(2) + " μT";
      if (mFluxMg) mFluxMg.textContent = fluxMg.toFixed(2) + " mG";

      if (mIcnirp1998) {
        mIcnirp1998.textContent = icnirp1998Ratio.toFixed(1) + "%";
        mIcnirp1998.className = icnirp1998Ratio > 100 ? "text-sm md:text-base font-mono font-bold text-rose-600 dark:text-rose-400 block" : "text-sm md:text-base font-mono font-bold text-emerald-600 dark:text-emerald-400 block";
      }

      if (mIcnirp2010) {
        mIcnirp2010.textContent = icnirp2010Ratio.toFixed(1) + "%";
        mIcnirp2010.className = icnirp2010Ratio > 100 ? "text-sm md:text-base font-mono font-bold text-rose-600 dark:text-rose-400 block" : "text-sm md:text-base font-mono font-bold text-emerald-600 dark:text-emerald-400 block";
      }

      if (mPacemakerEmi) {
        mPacemakerEmi.textContent = pacemakerEmiRatio.toFixed(1) + "%";
        mPacemakerEmi.className = pacemakerEmiRatio > 100 ? "text-sm md:text-base font-mono font-bold text-rose-600 dark:text-rose-400 block" : (pacemakerEmiRatio > 50 ? "text-sm md:text-base font-mono font-bold text-amber-600 dark:text-amber-400 block" : "text-sm md:text-base font-mono font-bold text-emerald-600 dark:text-emerald-400 block");
      }
      if (mPacemakerThreshold) {
        mPacemakerThreshold.textContent = "Threshold: " + implantThreshold.toFixed(1) + " μT";
      }

      if (mSafeDist) mSafeDist.textContent = minSafeDistanceCm + " cm";
      if (mSafeDistIn) mSafeDistIn.textContent = "(" + minSafeDistanceIn + " in)";

      if (mAttenuation) {
        mAttenuation.textContent = "-" + attenuationPct.toFixed(1) + "%";
      }

      // Biophysical context
      if (implantBadge) {
        if (pacemakerEmiRatio >= 100 && implantId !== 'none') {
          implantBadge.textContent = "High Interference Risk";
          implantBadge.className = "font-mono text-rose-600 dark:text-rose-400";
        } else if (pacemakerEmiRatio >= 50 && implantId !== 'none') {
          implantBadge.textContent = "Moderate Caution Zone";
          implantBadge.className = "font-mono text-amber-600 dark:text-amber-400";
        } else {
          implantBadge.textContent = "Physiologically Safe";
          implantBadge.className = "font-mono text-emerald-600 dark:text-emerald-400";
        }
      }
      if (implantImpactText) {
        if (implantId === 'none') {
          implantImpactText.textContent = "General public exposure: well below human central nervous system peripheral nerve stimulation thresholds (ICNIRP reference levels).";
        } else if (implantId === 'bipolar_pacemaker') {
          implantImpactText.textContent = "Bipolar leads offer high common-mode rejection with small inter-electrode spacing (~10mm). Safe at >30cm; risk escalates if leaning directly over active coil.";
        } else {
          implantImpactText.textContent = "Unipolar leads form a large conductor loop between pectoral can and myocardial tip, maximizing antenna aperture for 20–50 kHz induction fields. Maintain >50cm.";
        }
      }

      if (couplingBadge) {
        couplingBadge.textContent = matObj.coupling_efficiency + " Coupling";
        couplingBadge.className = matObj.coupling_efficiency === '98%' ? "font-mono text-emerald-600 dark:text-emerald-400" : "font-mono text-amber-600 dark:text-amber-400";
      }
      if (couplingImpactText) {
        couplingImpactText.textContent = matObj.notes;
      }
    }

    // Attach Listeners
    if (distSlider) distSlider.addEventListener('input', calculate);
    if (powerSelect) powerSelect.addEventListener('change', calculate);
    if (potSizeSelect) potSizeSelect.addEventListener('change', calculate);
    if (alignmentSelect) alignmentSelect.addEventListener('change', calculate);
    if (materialSelect) materialSelect.addEventListener('change', calculate);
    if (implantSelect) implantSelect.addEventListener('change', calculate);
    if (burnerSelect) burnerSelect.addEventListener('change', calculate);
    if (utensilSelect) utensilSelect.addEventListener('change', calculate);

    // Preset Buttons
    presetButtons.forEach(btn => {
      btn.addEventListener('click', function() {
        const pId = this.getAttribute('data-preset');
        const p = emfData.presets.find(item => item.id === pId);
        if (p) {
          if (distSlider) distSlider.value = p.distance_cm;
          if (powerSelect) powerSelect.value = p.powerId;
          if (potSizeSelect) potSizeSelect.value = p.potSizeId;
          if (alignmentSelect) alignmentSelect.value = p.alignmentId;
          if (materialSelect) materialSelect.value = p.materialId;
          if (implantSelect) implantSelect.value = p.implantId;
          if (burnerSelect) burnerSelect.value = p.burnerId;
          if (utensilSelect) utensilSelect.value = p.utensilId;
          calculate();
        }
      });
    });

    // Copy Report Button
    if (copyBtn) {
      copyBtn.addEventListener('click', function() {
        const dist = distSlider ? distSlider.value : '';
        const powerText = powerSelect ? powerSelect.options[powerSelect.selectedIndex].text : '';
        const potText = potSizeSelect ? potSizeSelect.options[potSizeSelect.selectedIndex].text : '';
        const alignText = alignmentSelect ? alignmentSelect.options[alignmentSelect.selectedIndex].text : '';
        const matText = materialSelect ? materialSelect.options[materialSelect.selectedIndex].text : '';
        const implantText = implantSelect ? implantSelect.options[implantSelect.selectedIndex].text : '';
        const burnerText = burnerSelect ? burnerSelect.options[burnerSelect.selectedIndex].text : '';
        const utensilText = utensilSelect ? utensilSelect.options[utensilSelect.selectedIndex].text : '';
        const flux = mFluxUt ? mFluxUt.textContent : '';
        const icnirp1998 = mIcnirp1998 ? mIcnirp1998.textContent : '';
        const icnirp2010 = mIcnirp2010 ? mIcnirp2010.textContent : '';
        const emiIndex = mPacemakerEmi ? mPacemakerEmi.textContent : '';
        const safeDist = mSafeDist ? mSafeDist.textContent : '';
        const verdict = verdictTitle ? verdictTitle.textContent.trim() : '';

        const report = [
          "===========================================================",
          "ISITKITCHENSAFE: INDUCTION COOKTOP EMF & CARDIAC SAFETY AUDIT",
          "===========================================================",
          "Date: " + new Date().toISOString().split('T')[0],
          "Standards Benchmark: ICNIRP (1998: 6.25 μT, 2010: 27.0 μT) | IEC 62233 | ISO 14117",
          "",
          "--- APPLIANCE & COOKWARE PARAMETERS ---",
          "- Standing Distance: " + dist + " cm (" + Math.round(parseInt(dist||'0')/2.54) + " in)",
          "- Power Rating: " + powerText,
          "- Pot-to-Coil Ratio: " + potText,
          "- Pan Alignment: " + alignText,
          "- Cookware Material: " + matText,
          "- Burner Placement: " + burnerText,
          "- Utensil Material: " + utensilText,
          "- Medical Implant Profile: " + implantText,
          "",
          "--- EMF RADIATION & CARDIAC EVALUATION ---",
          "- Stray Magnetic Flux Density (B): " + flux,
          "- ICNIRP 1998 Public Ratio: " + icnirp1998 + " (Limit: 6.25 μT)",
          "- ICNIRP 2010 Public Ratio: " + icnirp2010 + " (Limit: 27.0 μT)",
          "- Pacemaker EMI Sensing Stress: " + emiIndex,
          "- Recommended Safe Separation: " + safeDist,
          "- Compliance Verdict: " + verdict,
          "",
          "--- ZERO-COST HOUSEHOLD SAFETY PROTOCOL ---",
          "1. Refrigerator Magnet Test: Ensure pan base firmly attracts magnet with high magnetic permeability.",
          "2. Rear Burner Rule: Cook on rear burners to gain 25–30 cm passive clearance, cutting EMF by >85%.",
          "3. Concentric Alignment: Ensure cookware base fully covers the printed zone ring to shield stray flux.",
          "4. Non-Conductive Utensils: Use wooden or silicone spoons to eliminate parasitic high-frequency conduction.",
          "",
          "Report generated at: https://isitkitchensafe.com/tools/induction-cooktop-emf-safety-modeler/",
          "==========================================================="
        ].join('\n');

        navigator.clipboard.writeText(report).then(function() {
          if (copyBtnText) copyBtnText.textContent = dictObj.reportCopied;
          setTimeout(function() {
            if (copyBtnText) copyBtnText.textContent = dictObj.copyReportBtn;
          }, 2500);
        }).catch(function() {
          alert("Safety Audit Report:\n\n" + report);
        });
      });
    }

    // Run initial calculation
    calculate();
  })();
</script>
