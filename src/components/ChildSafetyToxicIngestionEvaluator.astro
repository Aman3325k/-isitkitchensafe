    progressionTitle: "生体内損傷タイムラインと穿孔リスク進展",
    callPoisonControlBtn: "📞 中毒110番に電話（072-727-2499 / #7119）",
    callEmergencyBtn: "🚨 119番通報 / 救急車要請",
    copyTriageReportBtn: "📋 救急隊・医師引き継ぎ用レポートをコピー",
    reportCopied: "✓ 救急レポートをクリップボードにコピーしました！",
    auditTitle: "キッチンチャイルドプルーフ物理防御診断",
    auditSub: "CPSC基準に基づき、8つの高リスク危険箇所を点検します。",
    safetyScoreLabel: "小児安全スコア",
    safetyGradeLabel: "キッチン防御グレード",
    criticalRisksLabel: "致命的欠陥数",
    actionPlanTitle: "優先改善チャイルドプルーフ対策",
    actionPlanSub: "誤飲や熱傷事故を根本から防ぐ物理的施錠と動線管理。",
    copyAuditReportBtn: "📋 キッチン安全診断レポートをコピー",
    crossLinkTitle: "関連する科学的キッチン安全診断ツール：",
    crossLinkTriage: "キッチン危険緊急トリアージツール",
    crossLinkPlasticizer: "マイクロプラスチック体内蓄積推計器",
    crossLinkNsf: "厨房機器 NSF 認証検査ツール",
    crossLinkScorecard: "有害物質溶出＆PFASリスク評価表",
    crossLinkPanInspector: "AI フライパン傷診断ツール",
    ageInfant: "乳児期（6〜12ヶ月, 約8〜10kg）",
    ageToddler: "幼児期前期（1〜2歳, 約10〜13kg）",
    ageYoungChild: "幼児期中期（2〜3歳, 約13〜15kg）",
    agePreschool: "就学前幼児（3〜5歳, 約15〜20kg）",
    amountTrace: "唇や舌先で触れたのみ（ごく微量）",
    amountPartial: "一部摂取（ジェルボールを噛んだ / 電池1個 / ひとくち）",
    amountFull: "丸飲み / 複数個誤飲 / 容器ごと大量摂取",
    time15m: "15分未満（最も重要な初期対応時間）",
    time30m: "15〜30分経過",
    time1h: "30〜60分経過",
    time2h: "1〜2時間経過",
    timeOver2h: "2時間以上経過（組織穿孔ハイリスク期）"
  }
};

const d = DICT[lang] || DICT.en;
const hazards = safetyData.ingestionHazardClasses;
const checklist = safetyData.childproofingAuditChecklist;
---

<div class="bg-surface-soft border border-hairline rounded-3xl p-6 md:p-10 shadow-xs space-y-8" id="child-safety-evaluator-root">
  <!-- Header -->
  <header class="space-y-3 border-b border-hairline/80 pb-6">
    <div class="flex flex-wrap items-center gap-3">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-rose-700 text-white shadow-xs">
        {d.badge}
      </span>
      <span class="text-xs text-muted font-mono font-medium">AAPCC &bull; CPSC 16 CFR &bull; AAP Guidelines</span>
    </div>
    <h1 class="text-display-sm md:text-display-md font-medium text-ink tracking-tight">
      {d.title}
    </h1>
    <p class="text-sm md:text-base text-body leading-relaxed max-w-4xl">
      {d.subtitle}
    </p>

    <!-- Hotlines Bar -->
    <div class="mt-4 p-3.5 bg-rose-50 border border-rose-200 rounded-xl flex flex-wrap items-center justify-between gap-3 text-xs text-rose-950">
      <div class="flex items-center gap-2">
        <span class="text-base">🚨</span>
        <span class="font-bold">Poison Emergency Hotlines:</span>
        <span>US/CA: <strong>1-800-222-1222</strong> (AAPCC) | UK: <strong>111 / 999</strong> | EU: <strong>112</strong> | AU: <strong>13 11 26</strong> | JP: <strong>#7119 / 119</strong></span>
      </div>
      <span class="text-[11px] font-semibold uppercase tracking-wider text-rose-800 bg-rose-100 px-2 py-0.5 rounded">24/7 Free Medical Advice</span>
    </div>
  </header>

  <!-- Mode Navigation Tabs -->
  <div class="flex border-b border-hairline gap-2 md:gap-4">
    <button 
      id="tab-btn-triage"
      type="button"
      class="px-5 py-3 font-semibold text-sm border-b-2 border-rose-700 text-rose-800 transition-colors cursor-pointer"
    >
      {d.tabTriage}
    </button>
    <button 
      id="tab-btn-audit"
      type="button"
      class="px-5 py-3 font-medium text-sm text-muted hover:text-ink border-b-2 border-transparent transition-colors cursor-pointer"
    >
      {d.tabAudit}
    </button>
  </div>

  <!-- TAB 1: EMERGENCY TRIAGE -->
  <div id="panel-triage" class="space-y-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 bg-canvas p-6 md:p-8 rounded-2xl border border-hairline">
      <!-- Substance Selection -->
      <div class="space-y-2 md:col-span-2">
        <label for="select-hazard" class="block text-xs font-bold uppercase tracking-wider text-ink">
          {d.hazardLabel}
        </label>
        <select 
          id="select-hazard"
          class="w-full p-3 text-sm rounded-xl border border-hairline bg-surface text-ink font-medium focus:ring-2 focus:ring-rose-500 focus:outline-hidden"
        >
          {hazards.map(h => (
            <option value={h.id}>
              {h.name} — [{h.severity.split(' - ')[0]}]
            </option>
          ))}
        </select>
        <p id="hazard-category-desc" class="text-xs text-muted leading-relaxed"></p>
      </div>

      <!-- Child Age Bracket -->
      <div class="space-y-2">
        <label for="select-age" class="block text-xs font-bold uppercase tracking-wider text-ink">
          {d.ageLabel}
        </label>
        <select 
          id="select-age"
          class="w-full p-3 text-sm rounded-xl border border-hairline bg-surface text-ink font-medium focus:ring-2 focus:ring-rose-500 focus:outline-hidden"
        >
          <option value="infant">{d.ageInfant}</option>
          <option value="toddler" selected>{d.ageToddler}</option>
          <option value="young-child">{d.ageYoungChild}</option>
          <option value="preschool">{d.agePreschool}</option>
        </select>
      </div>

      <!-- Dose / Exposure -->
      <div class="space-y-2">
        <label for="select-amount" class="block text-xs font-bold uppercase tracking-wider text-ink">
          {d.amountLabel}
        </label>
        <select 
          id="select-amount"
          class="w-full p-3 text-sm rounded-xl border border-hairline bg-surface text-ink font-medium focus:ring-2 focus:ring-rose-500 focus:outline-hidden"
        >
          <option value="trace">{d.amountTrace}</option>
          <option value="partial" selected>{d.amountPartial}</option>
          <option value="full">{d.amountFull}</option>
        </select>
      </div>

      <!-- Time Elapsed -->
      <div class="space-y-2">
        <label for="select-time" class="block text-xs font-bold uppercase tracking-wider text-ink">
          {d.timeElapsedLabel}
        </label>
        <select 
          id="select-time"
          class="w-full p-3 text-sm rounded-xl border border-hairline bg-surface text-ink font-medium focus:ring-2 focus:ring-rose-500 focus:outline-hidden"
        >
          <option value="15m" selected>{d.time15m}</option>
          <option value="30m">{d.time30m}</option>
          <option value="1h">{d.time1h}</option>
          <option value="2h">{d.time2h}</option>
          <option value="over2h">{d.timeOver2h}</option>
        </select>
      </div>

      <!-- Action Buttons Quick Links -->
      <div class="flex flex-col justify-end gap-2">
        <div class="grid grid-cols-2 gap-2">
          <a 
            href="tel:18002221222" 
            class="py-3 px-3 bg-rose-700 hover:bg-rose-800 text-white rounded-xl text-center text-xs font-bold flex items-center justify-center gap-1.5 shadow-xs transition-colors"
          >
            <span>📞</span> 1-800-222-1222
          </a>
          <a 
            href="tel:911" 
            class="py-3 px-3 bg-red-900 hover:bg-black text-white rounded-xl text-center text-xs font-bold flex items-center justify-center gap-1.5 shadow-xs transition-colors"
          >
            <span>🚨</span> Dial 911
          </a>
        </div>
      </div>

      <!-- Symptoms Checkboxes -->
      <div class="md:col-span-2 pt-4 border-t border-hairline/70 space-y-3">
        <span class="block text-xs font-bold uppercase tracking-wider text-ink">
          {d.symptomsTitle}
        </span>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
          <label class="flex items-start gap-2.5 p-2.5 bg-surface rounded-xl border border-hairline cursor-pointer hover:bg-surface-soft">
            <input type="checkbox" id="sym-drooling" class="mt-0.5 rounded text-rose-600 focus:ring-rose-500" />
            <span class="text-xs text-body leading-tight">{d.symptomDrooling}</span>
          </label>
          <label class="flex items-start gap-2.5 p-2.5 bg-surface rounded-xl border border-hairline cursor-pointer hover:bg-surface-soft">
            <input type="checkbox" id="sym-breathing" class="mt-0.5 rounded text-rose-600 focus:ring-rose-500" />
            <span class="text-xs text-body leading-tight">{d.symptomBreathing}</span>
          </label>
          <label class="flex items-start gap-2.5 p-2.5 bg-surface rounded-xl border border-hairline cursor-pointer hover:bg-surface-soft">
            <input type="checkbox" id="sym-vomiting" class="mt-0.5 rounded text-rose-600 focus:ring-rose-500" />
            <span class="text-xs text-body leading-tight">{d.symptomVomiting}</span>
          </label>
          <label class="flex items-start gap-2.5 p-2.5 bg-surface rounded-xl border border-hairline cursor-pointer hover:bg-surface-soft">
            <input type="checkbox" id="sym-lethargy" class="mt-0.5 rounded text-rose-600 focus:ring-rose-500" />
            <span class="text-xs text-body leading-tight">{d.symptomLethargy}</span>
          </label>
          <label class="flex items-start gap-2.5 p-2.5 bg-surface rounded-xl border border-hairline cursor-pointer hover:bg-surface-soft">
            <input type="checkbox" id="sym-oral-burns" class="mt-0.5 rounded text-rose-600 focus:ring-rose-500" />
            <span class="text-xs text-body leading-tight">{d.symptomOralBurns}</span>
          </label>
          <label class="flex items-start gap-2.5 p-2.5 bg-surface rounded-xl border border-hairline cursor-pointer hover:bg-surface-soft">
            <input type="checkbox" id="sym-abdominal" class="mt-0.5 rounded text-rose-600 focus:ring-rose-500" />
            <span class="text-xs text-body leading-tight">{d.symptomAbdominal}</span>
          </label>
        </div>
      </div>
    </div>

    <!-- Triage Assessment Results Box -->
    <div class="bg-surface rounded-2xl border-2 border-rose-300 p-6 md:p-8 space-y-6 shadow-sm" id="triage-results-box">
      <div class="flex flex-wrap items-center justify-between gap-4 border-b border-hairline/80 pb-4">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-rose-800 block mb-1">
            {d.urgencyLevelLabel}
          </span>
          <h2 id="triage-urgency-badge" class="text-title-lg md:text-title-xl font-bold text-rose-900 tracking-tight">
            CRITICAL EMERGENCY — IMMEDIATE ACTION REQUIRED
          </h2>
        </div>
        <div class="text-right">
          <span class="text-xs text-muted block">Estimated Time-to-Tissue Perforation:</span>
          <span id="triage-window-metric" class="text-base font-mono font-bold text-rose-700">120 Minutes</span>
        </div>
      </div>

      <!-- Action Directive -->
      <div class="p-4 bg-rose-50 border border-rose-200 rounded-xl space-y-2">
        <h3 class="text-xs font-bold uppercase tracking-wider text-rose-900 flex items-center gap-1.5">
          <span>🚨</span> {d.immediateActionTitle}
        </h3>
        <p id="triage-action-directive" class="text-sm text-rose-950 font-semibold leading-relaxed">
          Proceed immediately to Pediatric Emergency Department or call 911. Notify triage desk on arrival that button lithium battery ingestion is suspected.
        </p>
      </div>

      <!-- First Aid Protocol & Honey Directive -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="p-4 bg-amber-50/60 border border-amber-200 rounded-xl space-y-2">
          <h3 class="text-xs font-bold uppercase tracking-wider text-amber-900 flex items-center gap-1.5">
            <span>🍯</span> {d.firstAidTitle}
          </h3>
          <p id="triage-first-aid" class="text-xs md:text-sm text-amber-950 leading-relaxed"></p>
        </div>

        <div class="p-4 bg-red-50/80 border border-red-300 rounded-xl space-y-2">
          <h3 class="text-xs font-bold uppercase tracking-wider text-red-900 flex items-center gap-1.5">
            <span>⛔</span> {d.criticalContraindicationsTitle}
          </h3>
          <p id="triage-contraindications" class="text-xs md:text-sm text-red-950 font-medium leading-relaxed"></p>
        </div>
      </div>

      <!-- Physiological Progression -->
      <div class="space-y-2 pt-2">
        <h3 class="text-xs font-bold uppercase tracking-wider text-ink flex items-center gap-1.5">
          <span>⏱️</span> {d.progressionTitle}
        </h3>
        <div id="triage-timeline-container" class="p-4 bg-canvas border border-hairline rounded-xl text-xs text-body leading-relaxed space-y-2"></div>
      </div>

      <!-- Copy Report Button -->
      <div class="pt-4 border-t border-hairline flex flex-wrap items-center justify-between gap-4">
        <button 
          id="btn-copy-triage"
          type="button"
          class="py-3 px-6 rounded-xl bg-ink hover:bg-black text-white text-xs md:text-sm font-semibold transition-colors cursor-pointer shadow-xs"
        >
          {d.copyTriageReportBtn}
        </button>
        <span id="triage-copy-feedback" class="text-xs text-emerald-800 font-medium hidden">
          {d.reportCopied}
        </span>
      </div>
    </div>
  </div>

  <!-- TAB 2: CHILDPROOFING AUDIT -->
  <div id="panel-audit" class="hidden space-y-8">
    <div class="space-y-2">
      <h2 class="text-title-lg font-medium text-ink tracking-tight">
        {d.auditTitle}
      </h2>
      <p class="text-xs md:text-sm text-muted leading-relaxed">
        {d.auditSub}
      </p>
    </div>

    <!-- Questions list -->
    <div class="space-y-6" id="audit-questions-container">
      {checklist.map((q, idx) => (
        <fieldset class="p-5 md:p-6 bg-canvas border border-hairline rounded-2xl space-y-3 audit-question-block" data-qid={q.id}>
          <legend class="text-xs font-bold uppercase tracking-wider text-rose-800 mb-1">
            Section {idx + 1}: {q.category}
          </legend>
          <p class="text-sm md:text-base font-medium text-ink leading-snug">
            {q.question}
          </p>

          <div class="space-y-2 pt-2">
            {q.options.map((opt, optIdx) => (
              <label class="flex items-start gap-3 p-3 bg-surface rounded-xl border border-hairline cursor-pointer hover:bg-surface-soft transition-colors">
                <input 
                  type="radio" 
                  name={`audit-${q.id}`} 
                  value={opt.score} 
                  data-risk={opt.risk}
                  checked={optIdx === 0}
                  class="mt-1 text-rose-700 focus:ring-rose-500"
                />
                <div class="text-xs md:text-sm">
                  <span class="font-medium text-ink">{opt.label}</span>
                </div>
              </label>
            ))}
          </div>

          <p class="text-[11px] text-muted pt-2 border-t border-hairline/60">
            <strong>CPSC Benchmark:</strong> {q.recommendation}
          </p>
        </fieldset>
      ))}
    </div>

    <!-- Audit Score Summary Card -->
    <div class="bg-surface rounded-2xl border border-hairline p-6 md:p-8 space-y-6">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-center border-b border-hairline pb-6">
        <div class="p-4 bg-canvas rounded-xl border border-hairline">
          <span class="text-xs font-bold uppercase tracking-wider text-muted block mb-1">{d.safetyScoreLabel}</span>
          <span id="audit-score-val" class="text-display-sm font-bold text-ink">100 / 100</span>
        </div>
        <div class="p-4 bg-canvas rounded-xl border border-hairline">
          <span class="text-xs font-bold uppercase tracking-wider text-muted block mb-1">{d.safetyGradeLabel}</span>
          <span id="audit-grade-val" class="text-display-sm font-bold text-emerald-800">A+ (Secure)</span>
        </div>
        <div class="p-4 bg-canvas rounded-xl border border-hairline">
          <span class="text-xs font-bold uppercase tracking-wider text-muted block mb-1">{d.criticalRisksLabel}</span>
          <span id="audit-critical-val" class="text-display-sm font-bold text-emerald-800">0 High Hazards</span>
        </div>
      </div>

      <!-- Action Plan -->
      <div class="space-y-3">
        <h3 class="text-sm font-bold uppercase tracking-wider text-ink">{d.actionPlanTitle}</h3>
        <p class="text-xs text-muted">{d.actionPlanSub}</p>
        <div id="audit-action-list" class="space-y-2 text-xs text-body leading-relaxed"></div>
      </div>

      <!-- Copy Audit Report Button -->
      <div class="pt-4 border-t border-hairline flex flex-wrap items-center justify-between gap-4">
        <button 
          id="btn-copy-audit"
          type="button"
          class="py-3 px-6 rounded-xl bg-ink hover:bg-black text-white text-xs md:text-sm font-semibold transition-colors cursor-pointer shadow-xs"
        >
          {d.copyAuditReportBtn}
        </button>
        <span id="audit-copy-feedback" class="text-xs text-emerald-800 font-medium hidden">
          {d.reportCopied}
        </span>
      </div>
    </div>
  </div>

  <!-- Companion Tools Navigation Hub -->
  <footer class="pt-8 border-t border-hairline space-y-3">
    <span class="text-xs font-bold uppercase tracking-wider text-muted block">
      {d.crossLinkTitle}
    </span>
    <div class="flex flex-wrap gap-2 text-xs">
      <a href="/tools/kitchen-hazard-emergency-triage/" class="px-3 py-1.5 rounded-lg bg-surface border border-hairline hover:border-ink font-medium transition-colors">
        {d.crossLinkTriage} &rarr;
      </a>
      <a href="/tools/plasticizer-microplastic-burden-estimator/" class="px-3 py-1.5 rounded-lg bg-surface border border-hairline hover:border-ink font-medium transition-colors">
        {d.crossLinkPlasticizer} &rarr;
      </a>
      <a href="/tools/commercial-cookware-nsf-inspector/" class="px-3 py-1.5 rounded-lg bg-surface border border-hairline hover:border-ink font-medium transition-colors">
        {d.crossLinkNsf} &rarr;
      </a>
      <a href="/tools/toxic-leaching-scorecard/" class="px-3 py-1.5 rounded-lg bg-surface border border-hairline hover:border-ink font-medium transition-colors">
        {d.crossLinkScorecard} &rarr;
      </a>
      <a href="/tools/pan-scratch-inspector/" class="px-3 py-1.5 rounded-lg bg-surface border border-hairline hover:border-ink font-medium transition-colors">
        {d.crossLinkPanInspector} &rarr;
      </a>
    </div>
  </footer>
</div>

<script define:vars={{ safetyData, lang }}>
  // Client-side Interactive Engine
  const hazards = safetyData.ingestionHazardClasses;
  const checklist = safetyData.childproofingAuditChecklist;

  // DOM Elements - Tabs
  const tabBtnTriage = document.getElementById('tab-btn-triage');
  const tabBtnAudit = document.getElementById('tab-btn-audit');
  const panelTriage = document.getElementById('panel-triage');
  const panelAudit = document.getElementById('panel-audit');

  // DOM Elements - Triage Controls
  const selectHazard = document.getElementById('select-hazard');
  const hazardCategoryDesc = document.getElementById('hazard-category-desc');
  const selectAge = document.getElementById('select-age');
  const selectAmount = document.getElementById('select-amount');
  const selectTime = document.getElementById('select-time');
  const symDrooling = document.getElementById('sym-drooling');
  const symBreathing = document.getElementById('sym-breathing');
  const symVomiting = document.getElementById('sym-vomiting');
  const symLethargy = document.getElementById('sym-lethargy');
  const symOralBurns = document.getElementById('sym-oral-burns');
  const symAbdominal = document.getElementById('sym-abdominal');

  // DOM Elements - Triage Results
  const triageResultsBox = document.getElementById('triage-results-box');
  const triageUrgencyBadge = document.getElementById('triage-urgency-badge');
  const triageWindowMetric = document.getElementById('triage-window-metric');
  const triageActionDirective = document.getElementById('triage-action-directive');
  const triageFirstAid = document.getElementById('triage-first-aid');
  const triageContraindications = document.getElementById('triage-contraindications');
  const triageTimelineContainer = document.getElementById('triage-timeline-container');
  const btnCopyTriage = document.getElementById('btn-copy-triage');
  const triageCopyFeedback = document.getElementById('triage-copy-feedback');

  // DOM Elements - Audit
  const auditScoreVal = document.getElementById('audit-score-val');
  const auditGradeVal = document.getElementById('audit-grade-val');
  const auditCriticalVal = document.getElementById('audit-critical-val');
  const auditActionList = document.getElementById('audit-action-list');
  const btnCopyAudit = document.getElementById('btn-copy-audit');
  const auditCopyFeedback = document.getElementById('audit-copy-feedback');

  // Tab Switching
  tabBtnTriage?.addEventListener('click', () => {
    tabBtnTriage.className = "px-5 py-3 font-semibold text-sm border-b-2 border-rose-700 text-rose-800 transition-colors cursor-pointer";
    tabBtnAudit.className = "px-5 py-3 font-medium text-sm text-muted hover:text-ink border-b-2 border-transparent transition-colors cursor-pointer";
    panelTriage.classList.remove('hidden');
    panelAudit.classList.add('hidden');
  });

  tabBtnAudit?.addEventListener('click', () => {
    tabBtnAudit.className = "px-5 py-3 font-semibold text-sm border-b-2 border-rose-700 text-rose-800 transition-colors cursor-pointer";
    tabBtnTriage.className = "px-5 py-3 font-medium text-sm text-muted hover:text-ink border-b-2 border-transparent transition-colors cursor-pointer";
    panelAudit.classList.remove('hidden');
    panelTriage.classList.add('hidden');
    calculateAudit();
  });

  function updateTriage() {
    const hazardId = selectHazard.value;
    const currentHazard = hazards.find(h => h.id === hazardId) || hazards[0];
    const age = selectAge.value;
    const amount = selectAmount.value;
    const time = selectTime.value;

    const hasDrooling = symDrooling.checked;
    const hasBreathing = symBreathing.checked;
    const hasVomiting = symVomiting.checked;
    const hasLethargy = symLethargy.checked;
    const hasOralBurns = symOralBurns.checked;
    const hasAbdominal = symAbdominal.checked;

    const symptomCount = (hasDrooling?1:0) + (hasBreathing?1:0) + (hasVomiting?1:0) + (hasLethargy?1:0) + (hasOralBurns?1:0) + (hasAbdominal?1:0);

    hazardCategoryDesc.textContent = `${currentHazard.category} — Common sources: ${currentHazard.commonSources}`;

    // Calculate urgency tier
    let isTier1 = false;
    let urgencyTitle = "";
    let windowText = "";

    if (hazardId === 'button-battery') {
      isTier1 = true;
      urgencyTitle = "CRITICAL EMERGENCY: BUTTON BATTERY PERFORATION RISK";
      windowText = "< 2 Hours to Esophageal Erosion";
      if (time === 'over2h' || hasBreathing || hasDrooling) {
        windowText = "IMMEDIATE AORTIC THREAT — RUSH TO ED";
      }
    } else if (hazardId === 'caustic-cleaner') {
      isTier1 = true;
      urgencyTitle = "CRITICAL EMERGENCY: LIQUEFACTIVE CAUSTIC BURNS";
      windowText = "Seconds to Permanent Stricture";
    } else if (hazardId === 'rare-earth-magnets') {
      isTier1 = true;
      urgencyTitle = "SURGICAL EMERGENCY: INTESTINAL BOWEL PINCHING";
      windowText = "Urgent Bi-Plane X-Ray Required";
    } else if (hazardId === 'dishwasher-pod') {
      if (amount === 'full' || hasBreathing || hasVomiting || hasOralBurns) {
        isTier1 = true;
        urgencyTitle = "HIGH-SEVERITY ALKALINE SURFACTANT ASPIRATION RISK";
      } else {
        urgencyTitle = "ACUTE SURFACTANT EXPOSURE — POISON CONTROL MONITORING";
      }
      windowText = "30-Minute Aspiration Window";
    } else if (hazardId === 'boiling-liquids-burns') {
      isTier1 = true;
      urgencyTitle = "CRITICAL THERMAL TRAUMA: FULL-THICKNESS SCALD";
      windowText = "Immediate 20-Min Cold Water Flush";
    } else if (hazardId === 'pure-alcohol-extracts') {
      if (age === 'infant' || age === 'toddler' || hasLethargy) {
        isTier1 = true;
        urgencyTitle = "HIGH MEDICAL ALERT: PEDIATRIC HYPOGLYCEMIA & CNS DEPRESSION";
      } else {
        urgencyTitle = "MODERATE ALCOHOL METABOLIC RISK";
      }
      windowText = "60-Minute Glucose Crash Window";
    } else {
      urgencyTitle = "MODERATE TOXIC MONITORING & POISON ADVICE";
      windowText = "1–3 Hour Observation Window";
    }

    triageUrgencyBadge.textContent = urgencyTitle;
    triageWindowMetric.textContent = windowText;

    // Directives
    if (isTier1) {
      triageResultsBox.className = "bg-surface rounded-2xl border-2 border-rose-500 p-6 md:p-8 space-y-6 shadow-sm";
      triageUrgencyBadge.className = "text-title-lg md:text-title-xl font-bold text-rose-900 tracking-tight";
      triageActionDirective.textContent = `🚨 IMMEDIATE 911 / PEDIATRIC EMERGENCY TRANSPORT MANDATED: ${currentHazard.severity}. Transport child immediately without delay.`;
    } else {
      triageResultsBox.className = "bg-surface rounded-2xl border-2 border-amber-400 p-6 md:p-8 space-y-6 shadow-sm";
      triageUrgencyBadge.className = "text-title-lg md:text-title-xl font-bold text-amber-900 tracking-tight";
      triageActionDirective.textContent = `⚠️ URGENT CLINICAL CONSULTATION: Contact Poison Control (1-800-222-1222) immediately with the product package in hand. Monitor airway and mental alertness.`;
    }

    // First Aid
    triageFirstAid.textContent = currentHazard.immediateTriageProtocol;
    triageContraindications.textContent = `${currentHazard.contraindications} ${safetyData.clinicalRiskLevels.tier1_critical.rationale}`;

    // Progression timeline
    let timelineHtml = `
      <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
        <div class="p-3 bg-surface rounded-lg border border-hairline">
          <strong class="block text-ink text-xs mb-1">Phase 1: Initial Contact (0–15 min)</strong>
          <span class="text-muted text-[11px]">${currentHazard.mechanismOfInjury.split('.')[0]}.</span>
        </div>
        <div class="p-3 bg-surface rounded-lg border border-hairline">
          <strong class="block text-ink text-xs mb-1">Phase 2: Acute Reaction (15–60 min)</strong>
          <span class="text-muted text-[11px]">${currentHazard.mechanismOfInjury.split('.')[1] || 'Tissue inflammation and chemical infiltration.'}.</span>
        </div>
        <div class="p-3 bg-surface rounded-lg border border-hairline">
          <strong class="block text-ink text-xs mb-1">Phase 3: Critical Risks (1–6 hrs)</strong>
          <span class="text-muted text-[11px]">${currentHazard.clinicalRedFlags}</span>
        </div>
      </div>
      <p class="text-[11px] text-muted font-mono mt-2">AAPCC Epidemiological Note: ${currentHazard.aapccData}</p>
    `;
    triageTimelineContainer.innerHTML = timelineHtml;
  }

  // Triage listeners
  [selectHazard, selectAge, selectAmount, selectTime, symDrooling, symBreathing, symVomiting, symLethargy, symOralBurns, symAbdominal].forEach(el => {
    el?.addEventListener('change', updateTriage);
  });

  // Copy Triage Report
  btnCopyTriage?.addEventListener('click', () => {
    const hazardId = selectHazard.value;
    const currentHazard = hazards.find(h => h.id === hazardId) || hazards[0];
    const reportText = `=====================================================
EMERGENCY PEDIATRIC INGESTION TRIAGE REPORT
Generated by IsItKitchenSafe.com (AAPCC/CPSC Protocols)
=====================================================
INCIDENT DETAILS:
- Suspected Hazard: ${currentHazard.name}
- Hazard Category: ${currentHazard.category}
- Child Age: ${selectAge.options[selectAge.selectedIndex].text}
- Estimated Dose: ${selectAmount.options[selectAmount.selectedIndex].text}
- Time Elapsed: ${selectTime.options[selectTime.selectedIndex].text}

OBSERVED SYMPTOMS:
- Drooling/Swallowing difficulty: ${symDrooling.checked ? 'YES' : 'NO'}
- Respiratory Stridor/Coughing: ${symBreathing.checked ? 'YES' : 'NO'}
- Vomiting/Retching: ${symVomiting.checked ? 'YES' : 'NO'}
- Lethargy/Altered Mental Status: ${symLethargy.checked ? 'YES' : 'NO'}
- Oral Burns/White mucosal lesions: ${symOralBurns.checked ? 'YES' : 'NO'}
- Severe Abdominal Pain: ${symAbdominal.checked ? 'YES' : 'NO'}

CLINICAL TRIAGE LEVEL:
${triageUrgencyBadge.textContent}
Action Directive: ${triageActionDirective.textContent}

MANDATORY FIRST-AID DIRECTIVE:
${currentHazard.immediateTriageProtocol}

CRITICAL CONTRAINDICATIONS:
${currentHazard.contraindications}
DO NOT INDUCE VOMITING!

NATIONAL POISON CONTROL: 1-800-222-1222 (US) | 911 / 112 (Emergency)
=====================================================`;

    navigator.clipboard.writeText(reportText).then(() => {
      triageCopyFeedback.classList.remove('hidden');
      setTimeout(() => triageCopyFeedback.classList.add('hidden'), 4000);
    });
  });

  // Calculate Audit Score
  function calculateAudit() {
    let totalScore = 0;
    let maxScore = 100;
    let criticalCount = 0;
    const actionItems = [];

    checklist.forEach(q => {
      const checkedRadio = document.querySelector(`input[name="audit-${q.id}"]:checked`);
      if (checkedRadio) {
        const score = parseInt(checkedRadio.value, 10);
        const risk = checkedRadio.getAttribute('data-risk');
        totalScore += score;
        if (risk === 'critical') {
          criticalCount++;
          actionItems.push(`❌ ${q.category}: ${q.recommendation}`);
        } else if (risk === 'moderate') {
          actionItems.push(`⚠️ ${q.category}: ${q.recommendation}`);
        }
      }
    });

    auditScoreVal.textContent = `${totalScore} / ${maxScore}`;

    let gradeText = "";
    let gradeClass = "";
    if (totalScore >= 90 && criticalCount === 0) {
      gradeText = "A+ (Excellent Protection)";
      gradeClass = "text-display-sm font-bold text-emerald-800";
    } else if (totalScore >= 75 && criticalCount === 0) {
      gradeText = "B (Good / Minor Gaps)";
      gradeClass = "text-display-sm font-bold text-blue-800";
    } else if (totalScore >= 60) {
      gradeText = "C (Moderate Risk)";
      gradeClass = "text-display-sm font-bold text-amber-800";
    } else if (totalScore >= 40) {
      gradeText = "D (High Ingestion Vulnerability)";
      gradeClass = "text-display-sm font-bold text-rose-800";
    } else {
      gradeText = "F (CRITICAL HAZARD - UNPROTECTED)";
      gradeClass = "text-display-sm font-bold text-red-900";
    }

    auditGradeVal.textContent = gradeText;
    auditGradeVal.className = gradeClass;

    if (criticalCount > 0) {
      auditCriticalVal.textContent = `${criticalCount} High Risk Flaws`;
      auditCriticalVal.className = "text-display-sm font-bold text-rose-800";
    } else {
      auditCriticalVal.textContent = "0 High Hazards";
      auditCriticalVal.className = "text-display-sm font-bold text-emerald-800";
    }

    if (actionItems.length === 0) {
      auditActionList.innerHTML = `<div class="p-4 bg-emerald-50 text-emerald-950 rounded-xl font-medium">✓ Outstanding! Your kitchen defenses meet or exceed CPSC pediatric home safety guidelines. Continue performing periodic audits as your child grows and gains vertical reach.</div>`;
    } else {
      auditActionList.innerHTML = actionItems.map(item => `
        <div class="p-3 bg-canvas rounded-xl border border-hairline font-medium text-ink">
          ${item}
        </div>
      `).join('');
    }
  }

  // Audit listeners
  document.querySelectorAll('input[type="radio"][name^="audit-"]').forEach(radio => {
    radio.addEventListener('change', calculateAudit);
  });

  // Copy Audit Report
  btnCopyAudit?.addEventListener('click', () => {
    const reportText = `=====================================================
KITCHEN CHILDPROOFING & ACCIDENTAL INGESTION AUDIT
Generated by IsItKitchenSafe.com (CPSC Child Defense Standards)
=====================================================
OVERALL RESULTS:
- Child Safety Score: ${auditScoreVal.textContent}
- Security Rating: ${auditGradeVal.textContent}
- Critical Ingestion Hazards: ${auditCriticalVal.textContent}

ACTIONABLE REMEDIATION CHECKLIST:
${Array.from(auditActionList.children).map(c => c.textContent.trim()).join('\n\n')}

SAFETY NOTICE:
Audit based on CPSC 16 CFR Part 1263 (Reese's Law), ASTM F977, and AAPCC pediatric emergency benchmarks.
=====================================================`;

    navigator.clipboard.writeText(reportText).then(() => {
      auditCopyFeedback.classList.remove('hidden');
      setTimeout(() => auditCopyFeedback.classList.add('hidden'), 4000);
    });
  });

  // Initial Run
  updateTriage();
</script>
