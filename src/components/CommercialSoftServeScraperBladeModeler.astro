const d = DICTIONARY[lang] || DICTIONARY.en;
---

<div class="not-prose my-8 bg-surface border border-hairline rounded-3xl p-6 md:p-8 shadow-sm">
  <!-- Title Badge & Header -->
  <div class="flex flex-wrap items-center justify-between gap-4 border-b border-hairline pb-6 mb-6">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-cyan-500/10 text-cyan-800 dark:text-cyan-300 mb-2 border border-cyan-500/20">
        <span>🍦</span>
        {d.badge}
      </div>
      <h2 class="text-2xl md:text-3xl font-extrabold text-ink tracking-tight">
        {d.title}
      </h2>
      <p class="text-sm md:text-base text-muted mt-1 max-w-3xl">
        {d.subtitle}
      </p>
    </div>
  </div>

  <!-- Presets -->
  <div class="mb-8 bg-surface-soft border border-hairline rounded-2xl p-4 md:p-5">
    <label class="block text-xs font-bold uppercase tracking-wider text-ink mb-2">
      {d.presetsTitle}
    </label>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2">
      <button
        type="button"
        id="btn-preset-gold"
        class="text-left text-xs p-3 rounded-xl border border-hairline bg-surface hover:border-cyan-500/50 hover:bg-cyan-500/5 transition-all text-ink cursor-pointer font-medium"
      >
        <span class="block font-bold text-emerald-600 dark:text-emerald-400 mb-1">✓ HACCP &amp; 3-A Gold Standard</span>
        <span class="text-[11px] text-muted leading-relaxed block">Virgin POM, 120h blades, 0.02mm gap, 11°R Superheat, 0 PPM shavings</span>
      </button>

      <button
        type="button"
        id="btn-preset-floodback"
        class="text-left text-xs p-3 rounded-xl border border-hairline bg-surface hover:border-amber-500/50 hover:bg-amber-500/5 transition-all text-ink cursor-pointer font-medium"
      >
        <span class="block font-bold text-amber-600 dark:text-amber-400 mb-1">⚠️ Dull Blade Glaciation &amp; Slugging</span>
        <span class="text-[11px] text-muted leading-relaxed block">950h blades (0.24mm gap), rock-hard ice crust, 0°R SH, severe POE oil dilution</span>
      </button>

      <button
        type="button"
        id="btn-preset-shaving"
        class="text-left text-xs p-3 rounded-xl border border-hairline bg-surface hover:border-rose-500/50 hover:bg-rose-500/5 transition-all text-ink cursor-pointer font-medium"
      >
        <span class="block font-bold text-rose-600 dark:text-rose-400 mb-1">🚨 High-Draw Micro-Shaving</span>
        <span class="text-[11px] text-muted leading-relaxed block">14% Custard + Economy UHMW-PE at 340 RPM (48 PPM plastic shavings, NSF 6 violation)</span>
      </button>

      <button
        type="button"
        id="btn-preset-sorbet"
        class="text-left text-xs p-3 rounded-xl border border-hairline bg-surface hover:border-purple-500/50 hover:bg-purple-500/5 transition-all text-ink cursor-pointer font-medium"
      >
        <span class="block font-bold text-purple-600 dark:text-purple-400 mb-1">🔬 Sorbet Lock &amp; Chrome Pitting</span>
        <span class="text-[11px] text-muted leading-relaxed block">Acidic slush + capillary tube, severe blade chatter, 3.2µm barrel scoring, biofilm risk</span>
      </button>
    </div>
  </div>

  <!-- Interactive Controls Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
    <!-- Left Column: Equipment & Mix Selectors -->
    <div class="space-y-4">
      <div>
        <label for="select-machine-model" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1">
          {d.machineModelLabel}
        </label>
        <select
          id="select-machine-model"
          class="w-full text-xs md:text-sm bg-surface border border-hairline rounded-xl px-3 py-2.5 text-ink focus:outline-hidden focus:ring-2 focus:ring-cyan-500"
        >
          {freezerData.machineArchitectures.map(m => (
            <option value={m.id}>{m.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1">{d.machineModelHelp}</p>
      </div>

      <div>
        <label for="select-blade-material" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1">
          {d.bladeMaterialLabel}
        </label>
        <select
          id="select-blade-material"
          class="w-full text-xs md:text-sm bg-surface border border-hairline rounded-xl px-3 py-2.5 text-ink focus:outline-hidden focus:ring-2 focus:ring-cyan-500"
        >
          {freezerData.bladeMaterials.map(b => (
            <option value={b.id}>{b.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1">{d.bladeMaterialHelp}</p>
      </div>

      <div>
        <label for="select-mix-formulation" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1">
          {d.mixFormulationLabel}
        </label>
        <select
          id="select-mix-formulation"
          class="w-full text-xs md:text-sm bg-surface border border-hairline rounded-xl px-3 py-2.5 text-ink focus:outline-hidden focus:ring-2 focus:ring-cyan-500"
        >
          {freezerData.dairyMixFormulations.map(mix => (
            <option value={mix.id}>{mix.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1">{d.mixFormulationHelp}</p>
      </div>

      <div>
        <label for="select-expansion-valve" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1">
          {d.valveTypeLabel}
        </label>
        <select
          id="select-expansion-valve"
          class="w-full text-xs md:text-sm bg-surface border border-hairline rounded-xl px-3 py-2.5 text-ink focus:outline-hidden focus:ring-2 focus:ring-cyan-500"
        >
          {freezerData.expansionValves.map(v => (
            <option value={v.id}>{v.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1">{d.valveTypeHelp}</p>
      </div>
    </div>

    <!-- Right Column: Operational Sliders -->
    <div class="space-y-4 bg-surface-soft border border-hairline rounded-2xl p-4 md:p-5">
      <!-- Slider 1: Operating Hours -->
      <div>
        <div class="flex justify-between items-center text-xs font-bold uppercase tracking-wider text-ink mb-1">
          <span>{d.hoursSliderLabel}</span>
          <span id="val-hours" class="font-mono text-cyan-600 dark:text-cyan-400">120 hrs</span>
        </div>
        <input
          type="range"
          id="range-hours"
          min="0"
          max="1200"
          step="10"
          value="120"
          class="w-full accent-cyan-600 cursor-pointer"
        />
        <p class="text-[11px] text-muted mt-1">{d.hoursSliderHelp}</p>
      </div>

      <!-- Slider 2: Blade Wear Clearance Gap -->
      <div>
        <div class="flex justify-between items-center text-xs font-bold uppercase tracking-wider text-ink mb-1">
          <span>{d.wearGapSliderLabel}</span>
          <span id="val-wear-gap" class="font-mono text-cyan-600 dark:text-cyan-400">0.02 mm (20 µm)</span>
        </div>
        <input
          type="range"
          id="range-wear-gap"
          min="0.00"
          max="0.35"
          step="0.01"
          value="0.02"
          class="w-full accent-cyan-600 cursor-pointer"
        />
        <p class="text-[11px] text-muted mt-1">{d.wearGapSliderHelp}</p>
      </div>

      <!-- Slider 3: Continuous Draw Rate -->
      <div>
        <div class="flex justify-between items-center text-xs font-bold uppercase tracking-wider text-ink mb-1">
          <span>{d.drawRateSliderLabel}</span>
          <span id="val-draw-rate" class="font-mono text-cyan-600 dark:text-cyan-400">28 L/hr</span>
        </div>
        <input
          type="range"
          id="range-draw-rate"
          min="5"
          max="80"
          step="1"
          value="28"
          class="w-full accent-cyan-600 cursor-pointer"
        />
        <p class="text-[11px] text-muted mt-1">{d.drawRateSliderHelp}</p>
      </div>

      <!-- Slider 4: Evaporating Temperature -->
      <div>
        <div class="flex justify-between items-center text-xs font-bold uppercase tracking-wider text-ink mb-1">
          <span>{d.evapTempSliderLabel}</span>
          <span id="val-evap-temp" class="font-mono text-cyan-600 dark:text-cyan-400">-16.0°C (3.2°F)</span>
        </div>
        <input
          type="range"
          id="range-evap-temp"
          min="-24"
          max="-8"
          step="0.5"
          value="-16"
          class="w-full accent-cyan-600 cursor-pointer"
        />
        <p class="text-[11px] text-muted mt-1">{d.evapTempSliderHelp}</p>
      </div>
    </div>
  </div>

  <!-- Telemetry Dashboard Cards -->
  <div class="mb-8">
    <div class="flex items-center justify-between mb-4">
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wider text-ink">
          {d.diagnosticTitle}
        </h3>
        <p class="text-xs text-muted">
          {d.diagnosticSub}
        </p>
      </div>
      <button
        type="button"
        id="btn-copy-report"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-hairline bg-surface hover:bg-surface-soft text-xs font-medium text-ink transition-colors cursor-pointer"
      >
        <span>📋</span>
        <span id="copy-btn-text">{d.copyReportBtn}</span>
      </button>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
      <!-- Metric 1: Wear Degradation -->
      <div class="bg-surface-soft border border-hairline rounded-2xl p-4 flex flex-col justify-between">
        <span class="text-xs font-bold text-muted">{d.wearDegradationLabel}</span>
        <div class="my-2">
          <span id="metric-wear-degradation" class="text-2xl font-extrabold font-mono text-emerald-600 dark:text-emerald-400">12%</span>
          <span class="text-[10px] text-muted block mt-0.5">Archard volumetric wear</span>
        </div>
        <div class="w-full bg-hairline rounded-full h-1.5 overflow-hidden">
          <div id="bar-wear" class="bg-emerald-500 h-full w-[12%] transition-all"></div>
        </div>
      </div>

      <!-- Metric 2: Ice Glaciation Thickness -->
      <div class="bg-surface-soft border border-hairline rounded-2xl p-4 flex flex-col justify-between">
        <span class="text-xs font-bold text-muted">{d.glaciationThickLabel}</span>
        <div class="my-2">
          <span id="metric-glaciation" class="text-2xl font-extrabold font-mono text-emerald-600 dark:text-emerald-400">0.03 mm</span>
          <span class="text-[10px] text-muted block mt-0.5" id="metric-thermal-loss">Thermal loss: 4.8%</span>
        </div>
        <div class="w-full bg-hairline rounded-full h-1.5 overflow-hidden">
          <div id="bar-glaciation" class="bg-emerald-500 h-full w-[8%] transition-all"></div>
        </div>
      </div>

      <!-- Metric 3: Suction Superheat -->
      <div class="bg-surface-soft border border-hairline rounded-2xl p-4 flex flex-col justify-between">
        <span class="text-xs font-bold text-muted">{d.superheatLabel}</span>
        <div class="my-2">
          <span id="metric-superheat" class="text-2xl font-extrabold font-mono text-emerald-600 dark:text-emerald-400">11.2°R</span>
          <span class="text-[10px] text-muted block mt-0.5">Target: 8°R–14°R</span>
        </div>
        <div class="w-full bg-hairline rounded-full h-1.5 overflow-hidden">
          <div id="bar-superheat" class="bg-emerald-500 h-full w-[85%] transition-all"></div>
        </div>
      </div>

      <!-- Metric 4: Micro-Shaved Particulates -->
      <div class="bg-surface-soft border border-hairline rounded-2xl p-4 flex flex-col justify-between">
        <span class="text-xs font-bold text-muted">{d.particulatePpmLabel}</span>
        <div class="my-2">
          <span id="metric-particulate" class="text-2xl font-extrabold font-mono text-emerald-600 dark:text-emerald-400">0.4 PPM</span>
          <span class="text-[10px] text-muted block mt-0.5" id="metric-particulate-desc">FDA Limit: 5.0 PPM</span>
        </div>
        <div class="w-full bg-hairline rounded-full h-1.5 overflow-hidden">
          <div id="bar-particulate" class="bg-emerald-500 h-full w-[5%] transition-all"></div>
        </div>
      </div>

      <!-- Metric 5: Floodback Risk -->
      <div class="bg-surface-soft border border-hairline rounded-2xl p-4 flex flex-col justify-between">
        <span class="text-xs font-bold text-muted">{d.floodbackRiskLabel}</span>
        <div class="my-2">
          <span id="metric-floodback" class="text-2xl font-extrabold font-mono text-emerald-600 dark:text-emerald-400">LOW</span>
          <span class="text-[10px] text-muted block mt-0.5" id="metric-oil-wash">Crankcase oil dilution: 2.1%</span>
        </div>
        <div class="w-full bg-hairline rounded-full h-1.5 overflow-hidden">
          <div id="bar-floodback" class="bg-emerald-500 h-full w-[10%] transition-all"></div>
        </div>
      </div>
    </div>

    <!-- Diagnostic Details Box -->
    <div class="mt-4 bg-surface-soft border border-hairline rounded-2xl p-5 space-y-3">
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-muted block mb-1">
          {d.complianceLabel}
        </span>
        <span id="text-compliance" class="font-bold text-sm text-emerald-600 dark:text-emerald-400">
          ✅ 100% COMPLIANT (NSF 6 § 4.2 &amp; 3-A Standard 20-27 Passed: Non-shedding polymer, superheat stabilized, 0 mm ice glaciation)
        </span>
      </div>

      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-muted block mb-1">
          {d.primaryRiskLabel}
        </span>
        <p id="text-risk" class="text-xs text-ink leading-relaxed">
          Minimal tribological degradation. Scraper blades are maintaining full hydrodynamic film clearance against hard chrome cylinder walls with zero polymer shedding.
        </p>
      </div>

      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-muted block mb-1">
          {d.mechanismsLabel}
        </span>
        <p id="text-mechanisms" class="text-xs text-muted leading-relaxed font-mono">
          W = (K·Fn·s)/H = 0.08 mm³/hr wear; U_barrel = 420 W/m²·K; TXV hunting amplitude = 0.4°R; POE lubricant viscosity maintained at 32 cSt @ 40°C.
        </p>
      </div>

      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-muted block mb-1">
          {d.mitigationLabel}
        </span>
        <p id="text-mitigation" class="text-xs text-ink leading-relaxed">
          Maintain scheduled bi-weekly blade rotation and clean-in-place (CIP) inspection. Replace Delrin blades at 250 operating hours or upon reaching 0.08 mm wear gap.
        </p>
      </div>
    </div>
  </div>

  <!-- Engineering Specifications Comparison Table -->
  <div class="mb-8">
    <div class="mb-4">
      <h3 class="text-sm font-bold uppercase tracking-wider text-ink">
        {d.tableTitle}
      </h3>
      <p class="text-xs text-muted">
        {d.tableSub}
      </p>
    </div>

    <div class="overflow-x-auto border border-hairline rounded-2xl">
      <table class="w-full text-left text-xs">
        <thead class="bg-surface-soft border-b border-hairline text-ink font-bold">
          <tr>
            <th class="p-3">{d.colModel}</th>
            <th class="p-3">{d.colCylinderCap}</th>
            <th class="p-3">{d.colDrivePower}</th>
            <th class="p-3">{d.colPlating}</th>
            <th class="p-3">{d.colMaxDraw}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline text-muted">
          {freezerData.machineArchitectures.map(m => (
            <tr class="hover:bg-surface-soft/50 transition-colors">
              <td class="p-3 font-medium text-ink">{m.name.split('(')[0]}</td>
              <td class="p-3 font-mono">{m.cylinderCapacityLiters} L ({m.cylinderCapacityQuarts} Qt)</td>
              <td class="p-3 font-mono">{m.beaterDrivePowerHp} HP Drive / {m.refrigerationPowerHp} HP Ref</td>
              <td class="p-3">{m.barrelPlatingType.split('(')[0]}</td>
              <td class="p-3 font-mono">{m.maxContinuousDrawRateLph} L/hr</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- HACCP Operational Rules -->
  <div>
    <div class="mb-4">
      <h3 class="text-sm font-bold uppercase tracking-wider text-ink">
        {d.rulesTitle}
      </h3>
      <p class="text-xs text-muted">
        {d.rulesSub}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="bg-surface-soft border border-hairline rounded-2xl p-4">
        <h4 class="text-xs font-bold text-ink mb-1">{d.rule1Title}</h4>
        <p class="text-xs text-muted leading-relaxed">{d.rule1Text}</p>
      </div>

      <div class="bg-surface-soft border border-hairline rounded-2xl p-4">
        <h4 class="text-xs font-bold text-ink mb-1">{d.rule2Title}</h4>
        <p class="text-xs text-muted leading-relaxed">{d.rule2Text}</p>
      </div>

      <div class="bg-surface-soft border border-hairline rounded-2xl p-4">
        <h4 class="text-xs font-bold text-ink mb-1">{d.rule3Title}</h4>
        <p class="text-xs text-muted leading-relaxed">{d.rule3Text}</p>
      </div>

      <div class="bg-surface-soft border border-hairline rounded-2xl p-4">
        <h4 class="text-xs font-bold text-ink mb-1">{d.rule4Title}</h4>
        <p class="text-xs text-muted leading-relaxed">{d.rule4Text}</p>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ freezerData }}>
  (function() {
    // DOM Elements
    const selMachine = document.getElementById('select-machine-model');
    const selBlade = document.getElementById('select-blade-material');
    const selMix = document.getElementById('select-mix-formulation');
    const selValve = document.getElementById('select-expansion-valve');

    const rangeHours = document.getElementById('range-hours');
    const rangeWearGap = document.getElementById('range-wear-gap');
    const rangeDrawRate = document.getElementById('range-draw-rate');
    const rangeEvapTemp = document.getElementById('range-evap-temp');

    const valHours = document.getElementById('val-hours');
    const valWearGap = document.getElementById('val-wear-gap');
    const valDrawRate = document.getElementById('val-draw-rate');
    const valEvapTemp = document.getElementById('val-evap-temp');

    const metricWear = document.getElementById('metric-wear-degradation');
    const barWear = document.getElementById('bar-wear');
    const metricGlaciation = document.getElementById('metric-glaciation');
    const metricThermalLoss = document.getElementById('metric-thermal-loss');
    const barGlaciation = document.getElementById('bar-glaciation');
    const metricSuperheat = document.getElementById('metric-superheat');
    const barSuperheat = document.getElementById('bar-superheat');
    const metricParticulate = document.getElementById('metric-particulate');
    const barParticulate = document.getElementById('bar-particulate');
    const metricParticulateDesc = document.getElementById('metric-particulate-desc');
    const metricFloodback = document.getElementById('metric-floodback');
    const metricOilWash = document.getElementById('metric-oil-wash');
    const barFloodback = document.getElementById('bar-floodback');

    const textCompliance = document.getElementById('text-compliance');
    const textRisk = document.getElementById('text-risk');
    const textMechanisms = document.getElementById('text-mechanisms');
    const textMitigation = document.getElementById('text-mitigation');

    const btnPresetGold = document.getElementById('btn-preset-gold');
    const btnPresetFloodback = document.getElementById('btn-preset-floodback');
    const btnPresetShaving = document.getElementById('btn-preset-shaving');
    const btnPresetSorbet = document.getElementById('btn-preset-sorbet');
    const btnCopyReport = document.getElementById('btn-copy-report');
    const copyBtnText = document.getElementById('copy-btn-text');

    function calculateTelemetry() {
      const machineId = selMachine.value;
      const bladeId = selBlade.value;
      const mixId = selMix.value;
      const valveId = selValve.value;

      const machine = freezerData.machineArchitectures.find(m => m.id === machineId) || freezerData.machineArchitectures[0];
      const blade = freezerData.bladeMaterials.find(b => b.id === bladeId) || freezerData.bladeMaterials[0];
      const mix = freezerData.dairyMixFormulations.find(m => m.id === mixId) || freezerData.dairyMixFormulations[0];
      const valve = freezerData.expansionValves.find(v => v.id === valveId) || freezerData.expansionValves[0];

      const hours = parseFloat(rangeHours.value);
      const wearGap = parseFloat(rangeWearGap.value); // mm
      const drawRate = parseFloat(rangeDrawRate.value); // L/hr
      const evapTemp = parseFloat(rangeEvapTemp.value); // °C

      // Slider visual text
      valHours.textContent = hours + ' hrs';
      valWearGap.textContent = wearGap.toFixed(2) + ' mm (' + Math.round(wearGap * 1000) + ' µm)';
      valDrawRate.textContent = drawRate + ' L/hr';
      valEvapTemp.textContent = evapTemp.toFixed(1) + '°C (' + (evapTemp * 1.8 + 32).toFixed(1) + '°F)';

      // 1. Wear Degradation Percentage
      // Archard Wear Model: W = (K * Fn * s) / H
      const hoursRatio = hours / blade.recommendedReplacementHours;
      const gapRatio = wearGap / freezerData.wearBenchmarks.maxSafeBladeClearanceMm;
      let wearPercent = Math.min(100, Math.round(((hoursRatio * 0.45) + (gapRatio * 0.55)) * 40));

      // 2. Ice Glaciation Thickness
      // If wearGap > 0.08 mm, ice layer accumulates
      let glaciationMm = 0;
      if (wearGap > 0.05) {
        const excess = wearGap - 0.05;
        glaciationMm = excess * 0.85;
      }
      // Low evap temp accelerates glaciation
      if (evapTemp < -18.0) {
        glaciationMm += (-18.0 - evapTemp) * 0.015;
      }
      glaciationMm = parseFloat(glaciationMm.toFixed(3));

      // Thermal Conductivity Loss (%)
      // k_ice = 2.22 W/mK, k_cylinder = 16.3 W/mK
      // U = 1 / ( (L_ice / k_ice) + (L_wall / k_wall) )
      const thermalLossPercent = Math.min(85, Math.round((glaciationMm / 0.25) * 65));

      // 3. Suction Superheat & Valve Hunting
      // Nominal superheat around 10°R (5.5K)
      let baseSuperheat = 11.0;
      if (valve.id === 'eev_electronic_stepper') baseSuperheat = 7.0;
      if (valve.id === 'capillary_tube_fixed') baseSuperheat = 14.0;

      // Thermal loss drops evaporator heat absorption -> superheat drops!
      let actualSuperheat = baseSuperheat - (thermalLossPercent * 0.16);
      if (actualSuperheat < 0) actualSuperheat = 0.0;
      actualSuperheat = parseFloat(actualSuperheat.toFixed(1));

      // 4. Micro-Shaved Particulates (PPM)
      // High shear stress + abrasive gap + soft polymer
      let particulatePpm = 0.0;
      const shearFactor = mix.shearStressOnBladesMpa / 2.5;
      const rpmFactor = machine.nominalBeaterRpm / 290;
      let matSheddingBase = 0.5;
      if (blade.id === 'carbon_reinforced_peek') matSheddingBase = 0.1;
      if (blade.id === 'virgin_delrin_pom_copolymer') matSheddingBase = 0.8;
      if (blade.id === 'stainless_steel_with_pom_shoe') matSheddingBase = 0.4;
      if (blade.id === 'economy_recycled_uhmwpe') matSheddingBase = 4.5;

      particulatePpm = matSheddingBase * shearFactor * rpmFactor * (1 + (hours / 350) * 2.2);
      if (wearGap > 0.15) particulatePpm *= 1.6;
      particulatePpm = parseFloat(particulatePpm.toFixed(1));

      // 5. Compressor Crankcase Liquid Floodback Risk & Oil Dilution
      let floodbackRisk = 'LOW';
      let oilDilutionPercent = Math.min(45, Math.round((1 - (actualSuperheat / 10.0)) * 25));
      if (oilDilutionPercent < 2) oilDilutionPercent = 2.0;

      if (actualSuperheat <= 1.0) {
        floodbackRisk = 'CRITICAL_SEVERE';
        oilDilutionPercent = 38.0;
      } else if (actualSuperheat <= 4.0) {
        floodbackRisk = 'ELEVATED_DANGER';
        oilDilutionPercent = 22.0;
      } else if (actualSuperheat <= 7.0) {
        floodbackRisk = 'MODERATE';
        oilDilutionPercent = 9.5;
      } else {
        floodbackRisk = 'OPTIMAL_LOW';
      }

      // Update UI Metrics
      metricWear.textContent = wearPercent + '%';
      barWear.style.width = Math.min(100, wearPercent) + '%';
      if (wearPercent > 70) {
        metricWear.className = 'text-2xl font-extrabold font-mono text-rose-600 dark:text-rose-400';
        barWear.className = 'bg-rose-500 h-full transition-all';
      } else if (wearPercent > 40) {
        metricWear.className = 'text-2xl font-extrabold font-mono text-amber-600 dark:text-amber-400';
        barWear.className = 'bg-amber-500 h-full transition-all';
      } else {
        metricWear.className = 'text-2xl font-extrabold font-mono text-emerald-600 dark:text-emerald-400';
        barWear.className = 'bg-emerald-500 h-full transition-all';
      }

      metricGlaciation.textContent = glaciationMm.toFixed(2) + ' mm';
      metricThermalLoss.textContent = 'Thermal loss: ' + thermalLossPercent + '%';
      barGlaciation.style.width = Math.min(100, Math.round((glaciationMm / 0.3) * 100)) + '%';
      if (glaciationMm > 0.10) {
        metricGlaciation.className = 'text-2xl font-extrabold font-mono text-rose-600 dark:text-rose-400';
        barGlaciation.className = 'bg-rose-500 h-full transition-all';
      } else if (glaciationMm > 0.04) {
        metricGlaciation.className = 'text-2xl font-extrabold font-mono text-amber-600 dark:text-amber-400';
        barGlaciation.className = 'bg-amber-500 h-full transition-all';
      } else {
        metricGlaciation.className = 'text-2xl font-extrabold font-mono text-emerald-600 dark:text-emerald-400';
        barGlaciation.className = 'bg-emerald-500 h-full transition-all';
      }

      metricSuperheat.textContent = actualSuperheat.toFixed(1) + '°R';
      barSuperheat.style.width = Math.min(100, Math.round((actualSuperheat / 15.0) * 100)) + '%';
      if (actualSuperheat < 3.0) {
        metricSuperheat.className = 'text-2xl font-extrabold font-mono text-rose-600 dark:text-rose-400';
        barSuperheat.className = 'bg-rose-500 h-full transition-all';
      } else if (actualSuperheat < 7.0) {
        metricSuperheat.className = 'text-2xl font-extrabold font-mono text-amber-600 dark:text-amber-400';
        barSuperheat.className = 'bg-amber-500 h-full transition-all';
      } else {
        metricSuperheat.className = 'text-2xl font-extrabold font-mono text-emerald-600 dark:text-emerald-400';
        barSuperheat.className = 'bg-emerald-500 h-full transition-all';
      }

      metricParticulate.textContent = particulatePpm.toFixed(1) + ' PPM';
      metricParticulateDesc.textContent = particulatePpm > 5.0 ? 'Exceeds FDA Action Level' : 'FDA Ceiling: 5.0 PPM';
      barParticulate.style.width = Math.min(100, Math.round((particulatePpm / 20.0) * 100)) + '%';
      if (particulatePpm > 5.0) {
        metricParticulate.className = 'text-2xl font-extrabold font-mono text-rose-600 dark:text-rose-400';
        barParticulate.className = 'bg-rose-500 h-full transition-all';
      } else if (particulatePpm > 2.0) {
        metricParticulate.className = 'text-2xl font-extrabold font-mono text-amber-600 dark:text-amber-400';
        barParticulate.className = 'bg-amber-500 h-full transition-all';
      } else {
        metricParticulate.className = 'text-2xl font-extrabold font-mono text-emerald-600 dark:text-emerald-400';
        barParticulate.className = 'bg-emerald-500 h-full transition-all';
      }

      metricFloodback.textContent = floodbackRisk;
      metricOilWash.textContent = 'Crankcase oil dilution: ' + oilDilutionPercent.toFixed(1) + '%';
      barFloodback.style.width = Math.min(100, Math.round((oilDilutionPercent / 40.0) * 100)) + '%';
      if (floodbackRisk.includes('CRITICAL') || floodbackRisk.includes('ELEVATED')) {
        metricFloodback.className = 'text-2xl font-extrabold font-mono text-rose-600 dark:text-rose-400';
        barFloodback.className = 'bg-rose-500 h-full transition-all';
      } else if (floodbackRisk === 'MODERATE') {
        metricFloodback.className = 'text-2xl font-extrabold font-mono text-amber-600 dark:text-amber-400';
        barFloodback.className = 'bg-amber-500 h-full transition-all';
      } else {
        metricFloodback.className = 'text-2xl font-extrabold font-mono text-emerald-600 dark:text-emerald-400';
        barFloodback.className = 'bg-emerald-500 h-full transition-all';
      }

      // Compliance Verdict & Narrative
      if (particulatePpm > 5.0 || actualSuperheat < 3.0 || glaciationMm > 0.12) {
        textCompliance.textContent = '🚨 FAILED: NSF/ANSI 6 & 3-A Sanitary Standard 20-27 Violation (Severe Polymer Shedding / Compressor Slugging)';
        textCompliance.className = 'font-bold text-sm text-rose-600 dark:text-rose-400';
        textRisk.textContent = 'High probability of soft-serve microplastic contamination (>5.0 PPM) and imminent compressor failure from liquid refrigerant washing out POE lubricant films.';
        textMitigation.textContent = 'Immediate shutdown required: replace worn scraper blades, inspect hard chrome cylinder plating for gouges, and calibrate thermal expansion valve.';
      } else if (wearPercent > 50 || actualSuperheat < 7.0 || glaciationMm > 0.05) {
        textCompliance.textContent = '⚠️ WARNING: Sub-Optimal Performance (Approaching 250-Hour Blade Replacement Threshold)';
        textCompliance.className = 'font-bold text-sm text-amber-600 dark:text-amber-400';
        textRisk.textContent = 'Glaciation layer forming on cylinder walls increases motor torque draw by 28% and causes hunting in mechanical expansion valves.';
        textMitigation.textContent = 'Schedule blade replacement during the next bi-weekly wash cycle. Verify rotor spring tension (18–24 N) to prevent blade chatter.';
      } else {
        textCompliance.textContent = '✅ 100% COMPLIANT: NSF 6 § 4.2 & 3-A Standard 20-27 Passed (Zero polymer shedding, superheat stabilized, 0 mm ice glaciation)';
        textCompliance.className = 'font-bold text-sm text-emerald-600 dark:text-emerald-400';
        textRisk.textContent = 'Optimal tribological clearance maintained. Blades cleanly shear soft-serve ice matrix with zero cylinder scoring or refrigerant floodback.';
        textMitigation.textContent = 'Maintain standard preventative maintenance. Inspect blade leading edges bi-weekly using a precision optical comparator.';
      }

      textMechanisms.textContent = 'Archard Wear Rate: ' + (wearPercent * 0.002).toFixed(3) + ' mm³/hr | Evaporator U-factor: ' + (450 * (1 - thermalLossPercent / 100)).toFixed(0) + ' W/m²·K | Superheat Hunting Amplitude: ' + (valve.huntingDampingFactor < 0.5 ? '2.8°R' : '0.5°R') + ' | POE Oil Viscosity: ' + (32 * (1 - oilDilutionPercent / 100)).toFixed(1) + ' cSt @ 40°C';
    }

    // Preset Handlers
    btnPresetGold.addEventListener('click', function() {
      selMachine.value = 'freezer_high_volume_twin_twist';
      selBlade.value = 'virgin_delrin_pom_copolymer';
      selMix.value = 'mix_premium_soft_serve_10pct';
      selValve.value = 'txv_balanced_port_mop';
      rangeHours.value = 120;
      rangeWearGap.value = 0.02;
      rangeDrawRate.value = 35;
      rangeEvapTemp.value = -16.0;
      calculateTelemetry();
    });

    btnPresetFloodback.addEventListener('click', function() {
      selMachine.value = 'freezer_legacy_aged_high_hour';
      selBlade.value = 'virgin_delrin_pom_copolymer';
      selMix.value = 'mix_premium_soft_serve_10pct';
      selValve.value = 'capillary_tube_fixed';
      rangeHours.value = 950;
      rangeWearGap.value = 0.24;
      rangeDrawRate.value = 45;
      rangeEvapTemp.value = -21.0;
      calculateTelemetry();
    });

    btnPresetShaving.addEventListener('click', function() {
      selMachine.value = 'freezer_pressurized_pump_heavy';
      selBlade.value = 'economy_recycled_uhmwpe';
      selMix.value = 'mix_frozen_custard_14pct_egg';
      selValve.value = 'txv_balanced_port_mop';
      rangeHours.value = 380;
      rangeWearGap.value = 0.16;
      rangeDrawRate.value = 55;
      rangeEvapTemp.value = -15.0;
      calculateTelemetry();
    });

    btnPresetSorbet.addEventListener('click', function() {
      selMachine.value = 'freezer_countertop_gravity';
      selBlade.value = 'virgin_delrin_pom_copolymer';
      selMix.value = 'mix_high_water_slush_sorbet';
      selValve.value = 'capillary_tube_fixed';
      rangeHours.value = 420;
      rangeWearGap.value = 0.18;
      rangeDrawRate.value = 20;
      rangeEvapTemp.value = -22.0;
      calculateTelemetry();
    });

    // Event Listeners for Controls
    [selMachine, selBlade, selMix, selValve, rangeHours, rangeWearGap, rangeDrawRate, rangeEvapTemp].forEach(function(el) {
      el.addEventListener('input', calculateTelemetry);
      el.addEventListener('change', calculateTelemetry);
    });

    // Copy Report
    btnCopyReport.addEventListener('click', function() {
      const report = [
        '=== COMMERCIAL SOFT-SERVE SCRAPER BLADE & FLOODBACK TELEMETRY ===',
        'Timestamp: ' + new Date().toISOString(),
        'Freezer Model: ' + selMachine.options[selMachine.selectedIndex].text,
        'Blade Material: ' + selBlade.options[selBlade.selectedIndex].text,
        'Dairy Mix Formulation: ' + selMix.options[selMix.selectedIndex].text,
        'Refrigeration Valve: ' + selValve.options[selValve.selectedIndex].text,
        'Blade In-Service Hours: ' + rangeHours.value + ' hrs',
        'Wear Clearance Gap: ' + rangeWearGap.value + ' mm',
        'Draw Rate: ' + rangeDrawRate.value + ' L/hr',
        'Evaporating Temp: ' + rangeEvapTemp.value + ' °C',
        '--- TELEMETRY METRICS ---',
        'Blade Wear Degradation: ' + metricWear.textContent,
        'Cylinder Glaciation Thickness: ' + metricGlaciation.textContent,
        'Thermal Conductance Loss: ' + metricThermalLoss.textContent,
        'Suction Line Superheat: ' + metricSuperheat.textContent,
        'Micro-Shaved Plastic Particles: ' + metricParticulate.textContent,
        'Compressor Floodback Risk: ' + metricFloodback.textContent,
        'Crankcase Lubricant Dilution: ' + metricOilWash.textContent,
        '--- COMPLIANCE VERDICT ---',
        textCompliance.textContent,
        '--- PRIMARY RISK & MITIGATION ---',
        textRisk.textContent,
        textMitigation.textContent
      ].join('\n');

      navigator.clipboard.writeText(report).then(function() {
        const orig = copyBtnText.textContent;
        copyBtnText.textContent = 'Copied!';
        setTimeout(function() {
          copyBtnText.textContent = orig;
        }, 2000);
      });
    });

    // Initialize
    calculateTelemetry();
  })();
</script>
