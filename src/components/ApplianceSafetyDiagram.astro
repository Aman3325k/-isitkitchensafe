---
import type { SupportedLanguage } from '../i18n/ui';

interface Props {
  appliance: string;
  lang?: SupportedLanguage;
}

const { appliance, lang = 'en' } = Astro.props as Props;

type ApplianceKey =
  | 'dishwasher'
  | 'refrigerator'
  | 'microwave'
  | 'freezer'
  | 'airfryer'
  | 'oven'
  | 'dryer';

const SUPPORTED_APPLIANCES: ApplianceKey[] = [
  'dishwasher',
  'refrigerator',
  'microwave',
  'freezer',
  'airfryer',
  'oven',
  'dryer',
];

const isSupported = SUPPORTED_APPLIANCES.includes(appliance as ApplianceKey);
const appKey = appliance as ApplianceKey;
const locale: SupportedLanguage =
  lang === 'es' || lang === 'pt' || lang === 'zh-cn' || lang === 'ja' ? lang : 'en';

interface Takeaway {
  title: string;
  detail: string;
  tone: 'safe' | 'warn' | 'danger' | 'info';
}

interface DiagramMeta {
  eyebrow: string;
  title: string;
  subtitle: string;
  figcaption: string;
  svgTitle: string;
  svgDesc: string;
  takeawaysHeading: string;
  takeaways: [Takeaway, Takeaway, Takeaway];
  labels: Record<string, string>;
}

const uiCommon: Record<
  SupportedLanguage,
  { eyebrow: string; takeawaysHeading: string; referenceTag: string }
> = {
  en: {
    eyebrow: 'Visual Safety Diagram',
    takeawaysHeading: 'Key Safety Takeaways',
    referenceTag: 'Technical Safety Reference · IsItKitchenSafe.com',
  },
  es: {
    eyebrow: 'Diagrama Visual de Seguridad',
    takeawaysHeading: 'Puntos Clave de Seguridad',
    referenceTag: 'Referencia Técnica de Seguridad · IsItKitchenSafe.com',
  },
  pt: {
    eyebrow: 'Diagrama Visual de Segurança',
    takeawaysHeading: 'Pontos-Chave de Segurança',
    referenceTag: 'Referência Técnica de Segurança · IsItKitchenSafe.com',
  },
  'zh-cn': {
    eyebrow: '可视化安全结构图',
    takeawaysHeading: '核心安全要点',
    referenceTag: '厨房安全技术参考 · IsItKitchenSafe.com',
