                <!-- Top Rack Wireframe -->
                <line x1="64" y1="164" x2="336" y2="164" class="svg-rack-stroke" stroke-width="3" stroke-linecap="round" />
                <path d="M 86 164 L 86 150 M 116 164 L 116 150 M 146 164 L 146 150 M 214 164 L 214 150 M 244 164 L 244 150 M 274 164 L 274 150" class="svg-rack-stroke" stroke-width="1.5" />
                <!-- Items on Top Rack: Glass, #5 PP Cup, Silicone Lid -->
                <path d="M 82 118 L 112 118 L 106 160 L 88 160 Z" class="svg-item-glass" stroke-width="1.8" />
                <rect x="134" y="114" width="56" height="46" rx="5" class="svg-safe-box" stroke-width="1.8" />
                <text x="162" y="142" text-anchor="middle" class="svg-safe-text" font-size="11" font-weight="700">#5 PP</text>
                <rect x="208" y="130" width="54" height="30" rx="6" class="svg-safe-box" stroke-width="1.6" />
                <path d="M 276 122 Q 296 112 316 122 L 310 160 L 282 160 Z" class="svg-item-glass" stroke-width="1.8" />

                <!-- Upper Spray Arm + Water Arcs -->
                <line x1="120" y1="176" x2="280" y2="176" class="svg-info-stroke" stroke-width="4" stroke-linecap="round" />
                <circle cx="200" cy="176" r="5" class="svg-info-fill" />
                <path d="M 145 170 Q 145 154 156 146 M 200 170 L 200 150 M 255 170 Q 255 154 244 146" fill="none" class="svg-info-stroke" stroke-width="1.5" stroke-dasharray="3 3" />

                <!-- Bottom Rack Thermal Tint -->
                <rect x="56" y="188" width="288" height="100" rx="6" class="svg-warn-tint" />
                <text x="66" y="204" class="svg-warn-text" font-size="10" font-weight="700">{L.botRackTag}</text>
                <!-- Bottom Rack Wireframe -->
                <line x1="64" y1="276" x2="336" y2="276" class="svg-rack-stroke" stroke-width="3.5" stroke-linecap="round" />
                <!-- Heavy Ceramic Plates + Stainless Steel Pot -->
                <ellipse cx="102" cy="244" rx="10" ry="28" class="svg-item-ceramic" stroke-width="1.8" />
                <ellipse cx="126" cy="244" rx="10" ry="28" class="svg-item-ceramic" stroke-width="1.8" />
                <ellipse cx="150" cy="244" rx="10" ry="28" class="svg-item-ceramic" stroke-width="1.8" />
                <rect x="190" y="218" width="116" height="54" rx="6" class="svg-item-metal" stroke-width="2" />
                <line x1="180" y1="234" x2="190" y2="234" class="svg-rack-stroke" stroke-width="3" stroke-linecap="round" />
                <line x1="306" y1="234" x2="316" y2="234" class="svg-rack-stroke" stroke-width="3" stroke-linecap="round" />
                <text x="248" y="250" text-anchor="middle" class="svg-ink" font-size="11" font-weight="700">18/8 STEEL</text>

                <!-- Exposed Bottom Heating Element Coil -->
                <rect x="56" y="294" width="288" height="48" rx="6" class="svg-danger-tint" />
                <text x="66" y="309" class="svg-danger-text" font-size="10" font-weight="700">{L.coilTag}</text>
                <path
                  d="M 80 328 C 94 316, 114 316, 128 328 C 142 340, 162 340, 176 328 C 190 316, 210 316, 224 328 C 238 340, 258 340, 272 328 C 286 316, 306 316, 320 328"
                  fill="none"
                  class="svg-danger-stroke"
                  stroke-width="5"
                  stroke-linecap="round"
                />
                <!-- Rising Radiant Heat Wavy Lines -->
                <path d="M 110 312 Q 114 302 110 294 M 200 312 Q 204 302 200 294 M 290 312 Q 294 302 290 294" fill="none" class="svg-danger-stroke" stroke-width="1.6" stroke-dasharray="3 2" />

                <!-- Leader Lines -->
                <line x1="344" y1="126" x2="410" y2="82" class="svg-safe-stroke" stroke-width="1.6" stroke-dasharray="4 3" />
                <circle cx="344" cy="126" r="4" class="svg-safe-fill" />

                <line x1="344" y1="238" x2="410" y2="195" class="svg-warn-stroke" stroke-width="1.6" stroke-dasharray="4 3" />
                <circle cx="344" cy="238" r="4" class="svg-warn-fill" />

                <line x1="344" y1="322" x2="410" y2="308" class="svg-danger-stroke" stroke-width="1.6" stroke-dasharray="4 3" />
                <circle cx="344" cy="322" r="4" class="svg-danger-fill" />

                <!-- Callout Card 1: Top Rack -->
                <g transform="translate(412, 34)">
                  <rect x="0" y="0" width="322" height="96" rx="10" class="svg-card" stroke-width="1.4" />
                  <rect x="0" y="0" width="6" height="96" rx="3" class="svg-safe-fill" />
                  <text x="18" y="24" class="svg-ink" font-size="13" font-weight="700">{L.c1Title}</text>
                  <rect x="18" y="33" width="146" height="20" rx="10" class="svg-safe-pill" />
                  <text x="27" y="47" class="svg-safe-text" font-size="10.5" font-weight="700">{L.c1Temp}</text>
                  <text x="18" y="69" class="svg-muted" font-size="11.5">{L.c1Line1}</text>
                  <text x="18" y="85" class="svg-muted" font-size="11.5">{L.c1Line2}</text>
                </g>

                <!-- Callout Card 2: Bottom Rack -->
                <g transform="translate(412, 147)">
                  <rect x="0" y="0" width="322" height="96" rx="10" class="svg-card" stroke-width="1.4" />
                  <rect x="0" y="0" width="6" height="96" rx="3" class="svg-warn-fill" />
                  <text x="18" y="24" class="svg-ink" font-size="13" font-weight="700">{L.c2Title}</text>
                  <rect x="18" y="33" width="146" height="20" rx="10" class="svg-warn-pill" />
                  <text x="27" y="47" class="svg-warn-text" font-size="10.5" font-weight="700">{L.c2Temp}</text>
                  <text x="18" y="69" class="svg-muted" font-size="11.5">{L.c2Line1}</text>
                  <text x="18" y="85" class="svg-muted" font-size="11.5">{L.c2Line2}</text>
                </g>

                <!-- Callout Card 3: Heating Coil -->
                <g transform="translate(412, 260)">
                  <rect x="0" y="0" width="322" height="96" rx="10" class="svg-card" stroke-width="1.4" />
                  <rect x="0" y="0" width="6" height="96" rx="3" class="svg-danger-fill" />
                  <text x="18" y="24" class="svg-ink" font-size="13" font-weight="700">{L.c3Title}</text>
                  <rect x="18" y="33" width="152" height="20" rx="10" class="svg-danger-pill" />
                  <text x="27" y="47" class="svg-danger-text" font-size="10.5" font-weight="700">{L.c3Temp}</text>
                  <text x="18" y="69" class="svg-muted" font-size="11.5">{L.c3Line1}</text>
                  <text x="18" y="85" class="svg-muted" font-size="11.5">{L.c3Line2}</text>
                </g>
              </g>
            )}

            {/* ==================== 2. REFRIGERATOR ==================== */}
            {appKey === 'refrigerator' && (
              <g>
                <!-- Main Fridge Body -->
                <rect x="28" y="24" width="240" height="342" rx="12" class="svg-shell" stroke-width="2" />
                <!-- Interior Main Cavity -->
                <rect x="38" y="34" width="220" height="322" rx="7" class="svg-cavity" stroke-width="1.4" />

                <!-- Upper & Middle Shelves Zone -->
                <rect x="44" y="40" width="208" height="128" rx="6" class="svg-safe-tint" />
                <text x="52" y="55" class="svg-safe-text" font-size="10" font-weight="700">{L.upperTag}</text>
                <!-- Shelf 1 -->
                <line x1="48" y1="104" x2="248" y2="104" class="svg-rack-stroke" stroke-width="3" />
                <rect x="64" y="72" width="44" height="28" rx="4" class="svg-safe-box" stroke-width="1.5" />
                <rect x="122" y="64" width="32" height="36" rx="4" class="svg-item-glass" stroke-width="1.5" />
                <rect x="168" y="76" width="58" height="24" rx="4" class="svg-safe-box" stroke-width="1.5" />
                <!-- Shelf 2 (Milk + Eggs) -->
                <line x1="48" y1="164" x2="248" y2="164" class="svg-rack-stroke" stroke-width="3" />
                <path d="M 68 122 L 96 122 L 96 160 L 68 160 Z M 74 114 L 90 114 L 96 122 L 68 122 Z" class="svg-item-ceramic" stroke-width="1.5" />
                <rect x="114" y="138" width="66" height="22" rx="4" class="svg-safe-box" stroke-width="1.5" />
                <circle cx="130" cy="149" r="5" class="svg-item-ceramic" stroke-width="1.2" />
                <circle cx="147" cy="149" r="5" class="svg-item-ceramic" stroke-width="1.2" />
                <circle cx="164" cy="149" r="5" class="svg-item-ceramic" stroke-width="1.2" />
                <rect x="194" y="128" width="40" height="32" rx="4" class="svg-item-glass" stroke-width="1.5" />

                <!-- Coldest Bottom Shelf (Raw Meat in Tray) -->
                <rect x="44" y="176" width="208" height="80" rx="6" class="svg-info-tint" />
                <text x="52" y="192" class="svg-info-text" font-size="10" font-weight="700">{L.botTag}</text>
                <line x1="48" y1="250" x2="248" y2="250" class="svg-rack-stroke" stroke-width="3" />
                <!-- Leakproof Tray + Raw Meat Packs -->
                <path d="M 64 234 L 232 234 L 226 246 L 70 246 Z" class="svg-info-box" stroke-width="1.8" />
                <rect x="78" y="212" width="66" height="22" rx="5" class="svg-danger-box" stroke-width="1.5" />
                <rect x="154" y="216" width="64" height="18" rx="5" class="svg-danger-box" stroke-width="1.5" />

                <!-- Crisper Drawers (Dual Humidity) -->
                <rect x="44" y="264" width="100" height="84" rx="6" class="svg-safe-box" stroke-width="1.6" />
                <text x="94" y="284" text-anchor="middle" class="svg-safe-text" font-size="9" font-weight="700">{L.hiHumTag}</text>
                <circle cx="76" cy="316" r="12" class="svg-safe-tint" stroke-width="1.4" />
                <circle cx="106" cy="320" r="11" class="svg-safe-tint" stroke-width="1.4" />
                <line x1="76" y1="336" x2="112" y2="336" class="svg-safe-stroke" stroke-width="2.5" stroke-linecap="round" />

                <rect x="152" y="264" width="100" height="84" rx="6" class="svg-warn-box" stroke-width="1.6" />
                <text x="202" y="284" text-anchor="middle" class="svg-warn-text" font-size="9" font-weight="700">{L.loHumTag}</text>
                <circle cx="186" cy="318" r="11" class="svg-warn-tint" stroke-width="1.4" />
                <circle cx="216" cy="318" r="10" class="svg-warn-tint" stroke-width="1.4" />
                <line x1="184" y1="336" x2="220" y2="336" class="svg-warn-stroke" stroke-width="2.5" stroke-linecap="round" />

                <!-- Hinged Door Compartment (Warmest Zone) -->
                <rect x="278" y="34" width="94" height="322" rx="10" class="svg-shell" stroke-width="2" />
                <rect x="285" y="44" width="80" height="302" rx="6" class="svg-danger-tint" />
                <text x="325" y="61" text-anchor="middle" class="svg-danger-text" font-size="9" font-weight="700">{L.doorTag}</text>
                <!-- Door Bins with Condiment Bottles -->
                <rect x="292" y="88" width="66" height="44" rx="4" class="svg-card" stroke-width="1.3" />
                <rect x="303" y="96" width="14" height="32" rx="3" class="svg-warn-box" stroke-width="1.2" />
                <rect x="324" y="100" width="18" height="28" rx="3" class="svg-danger-box" stroke-width="1.2" />

                <rect x="292" y="164" width="66" height="50" rx="4" class="svg-card" stroke-width="1.3" />
                <rect x="302" y="172" width="16" height="38" rx="3" class="svg-warn-box" stroke-width="1.2" />
                <rect x="326" y="178" width="20" height="32" rx="3" class="svg-safe-box" stroke-width="1.2" />

                <rect x="292" y="250" width="66" height="58" rx="4" class="svg-card" stroke-width="1.3" />
                <rect x="304" y="260" width="16" height="44" rx="3" class="svg-warn-box" stroke-width="1.2" />
                <rect x="328" y="266" width="18" height="38" rx="3" class="svg-danger-box" stroke-width="1.2" />

                <!-- Leader Dots -->
                <circle cx="252" cy="104" r="4" class="svg-safe-fill" />
                <line x1="252" y1="104" x2="404" y2="62" class="svg-safe-stroke" stroke-width="1.5" stroke-dasharray="4 3" />

                <circle cx="252" cy="216" r="4" class="svg-info-fill" />
                <line x1="252" y1="216" x2="404" y2="152" class="svg-info-stroke" stroke-width="1.5" stroke-dasharray="4 3" />

                <circle cx="252" cy="306" r="4" class="svg-warn-fill" />
                <line x1="252" y1="306" x2="404" y2="240" class="svg-warn-stroke" stroke-width="1.5" stroke-dasharray="4 3" />

                <circle cx="372" cy="326" r="4" class="svg-danger-fill" />
                <line x1="372" y1="326" x2="404" y2="326" class="svg-danger-stroke" stroke-width="1.5" stroke-dasharray="4 3" />

                <!-- 4 Callout Cards -->
                <g transform="translate(406, 26)">
                  <rect x="0" y="0" width="330" height="76" rx="9" class="svg-card" stroke-width="1.4" />
                  <rect x="0" y="0" width="6" height="76" rx="3" class="svg-safe-fill" />
                  <text x="16" y="23" class="svg-safe-text" font-size="12" font-weight="700">{L.z1Title}</text>
                  <text x="16" y="45" class="svg-ink" font-size="11.5">{L.z1Line1}</text>
                  <text x="16" y="62" class="svg-muted" font-size="11">{L.z1Line2}</text>
                </g>

                <g transform="translate(406, 114)">
                  <rect x="0" y="0" width="330" height="76" rx="9" class="svg-card" stroke-width="1.4" />
                  <rect x="0" y="0" width="6" height="76" rx="3" class="svg-info-fill" />
                  <text x="16" y="23" class="svg-info-text" font-size="12" font-weight="700">{L.z2Title}</text>
                  <text x="16" y="45" class="svg-ink" font-size="11.5">{L.z2Line1}</text>
                  <text x="16" y="62" class="svg-muted" font-size="11">{L.z2Line2}</text>
                </g>

                <g transform="translate(406, 202)">
                  <rect x="0" y="0" width="330" height="76" rx="9" class="svg-card" stroke-width="1.4" />
                  <rect x="0" y="0" width="6" height="76" rx="3" class="svg-warn-fill" />
                  <text x="16" y="23" class="svg-warn-text" font-size="12" font-weight="700">{L.z3Title}</text>
                  <text x="16" y="45" class="svg-ink" font-size="11.5">{L.z3Line1}</text>
                  <text x="16" y="62" class="svg-muted" font-size="11">{L.z3Line2}</text>
                </g>

                <g transform="translate(406, 290)">
                  <rect x="0" y="0" width="330" height="76" rx="9" class="svg-card" stroke-width="1.4" />
                  <rect x="0" y="0" width="6" height="76" rx="3" class="svg-danger-fill" />
                  <text x="16" y="23" class="svg-danger-text" font-size="12" font-weight="700">{L.z4Title}</text>
                  <text x="16" y="45" class="svg-ink" font-size="11.5">{L.z4Line1}</text>
                  <text x="16" y="62" class="svg-danger-text" font-size="11" font-weight="600">{L.z4Line2}</text>
                </g>
              </g>
            )}

            {/* ==================== 3. MICROWAVE ==================== */}
            {appKey === 'microwave' && (
              <g>
                <!-- TOP LANE: SAFE PENETRATION -->
                <rect x="24" y="24" width="712" height="162" rx="12" class="svg-card" stroke-width="1.5" />
                <rect x="24" y="24" width="7" height="162" rx="3.5" class="svg-safe-fill" />

                <!-- Magnetron Source Top -->
                <rect x="44" y="54" width="84" height="102" rx="8" class="svg-shell" stroke-width="1.6" />
                <text x="86" y="96" text-anchor="middle" class="svg-ink" font-size="9.5" font-weight="700">{L.emitter}</text>
                <rect x="54" y="106" width="64" height="20" rx="10" class="svg-safe-pill" />
                <text x="86" y="120" text-anchor="middle" class="svg-safe-text" font-size="9.5" font-weight="700">{L.freq}</text>

                <!-- 2.45 GHz Smooth Waves Passing Through Glass Bowl -->
                <path
                  d="M 134 90 Q 148 76 162 90 T 190 90 T 218 90 T 246 90 T 274 90 T 302 90 T 330 90"
                  fill="none"
                  class="svg-safe-stroke"
                  stroke-width="2.4"
                  marker-end={`url(#${svgId}-arrow-green)`}
                />
                <path
                  d="M 134 126 Q 148 112 162 126 T 190 126 T 218 126 T 246 126 T 274 126 T 302 126 T 330 126"
                  fill="none"
                  class="svg-safe-stroke"
                  stroke-width="2.4"
                  marker-end={`url(#${svgId}-arrow-green)`}
                />

                <!-- Glass Bowl with Vented Lid + Steam Wisps -->
