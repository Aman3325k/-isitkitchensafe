        c1Line2: 'ウール縮み・ゴム劣化に注意',
        c2Title: '低温 / 送風コース',
        c2Temp: '≤43°C · 110°F / 熱なし',
        c2Line1: '化繊・スポーツ着・デリケート',
        c2Line2: '伸縮素材やプリントを保護',
        c3Title: '乾燥厳禁（発火・溶融）',
        c3Temp: '自然発火・溶解リスク',
        c3Line1: '油・溶剤付き布 → 自然発火',
        c3Line2: 'ゴム裏マット・発泡材はNG！',
      },
    },
  },
};

const activeData = isSupported ? diagramData[appKey][locale] : null;
const L = activeData?.labels || {};
const svgId = `safety-diagram-${appKey}-${locale}`;

const toneBadgeClasses: Record<Takeaway['tone'], string> = {
  safe: 'bg-success/10 text-success dark:text-success-border border-success/30',
  info: 'bg-info/10 text-info dark:text-info-border border-info/30',
  warn: 'bg-warning/10 text-warning dark:text-warning-border border-warning/30',
  danger: 'bg-error/10 text-error dark:text-error-border border-error/30',
};
---

{isSupported && activeData && (
  <section aria-labelledby={`${svgId}-heading`} class="my-0">
    <figure class="bg-canvas border border-hairline rounded-lg shadow-xs overflow-hidden">
      <!-- Header -->
      <div class="px-6 pt-6 pb-4 md:px-8 md:pt-7 md:pb-5 border-b border-hairline bg-surface-soft/60">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
          <span class="inline-flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wider text-info dark:text-info-border bg-info/10 border border-info/25 px-2.5 py-1 rounded-full">
            <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M10 1.944A11.954 11.954 0 012.166 5C2.056 5.649 2 6.319 2 7c0 5.225 3.34 9.67 8 11.317C14.66 16.67 18 12.225 18 7c0-.682-.057-1.35-.166-2.001A11.954 11.954 0 0110 1.944zM11 14a1 1 0 11-2 0 1 1 0 012 0zm0-7a1 1 0 10-2 0v3a1 1 0 102 0V7z" clip-rule="evenodd" />
            </svg>
            {common.eyebrow}
          </span>
          <span class="text-[11px] font-medium text-muted tracking-wide">{common.referenceTag}</span>
        </div>
        <h2 id={`${svgId}-heading`} class="text-title-lg font-medium text-ink tracking-tight mb-1">
          {activeData.title}
        </h2>
        <p class="text-body-md text-muted leading-relaxed max-w-3xl">
          {activeData.subtitle}
        </p>
      </div>

      <!-- Responsive Technical SVG Canvas -->
      <div class="p-4 sm:p-6 md:p-8 bg-canvas">
        <div class="w-full overflow-hidden rounded-md border border-hairline/80 diagram-frame">
          <svg
            viewBox="0 0 760 390"
            role="img"
            aria-labelledby={`${svgId}-title ${svgId}-desc`}
            class="w-full h-auto block safety-diagram-svg"
            xmlns="http://www.w3.org/2000/svg"
          >
            <title id={`${svgId}-title`}>{activeData.svgTitle}</title>
            <desc id={`${svgId}-desc`}>{activeData.svgDesc}</desc>

            <defs>
              <pattern id={`${svgId}-grid`} width="24" height="24" patternUnits="userSpaceOnUse">
                <path d="M 24 0 L 0 0 0 24" fill="none" class="svg-grid-line" stroke-width="0.7" />
              </pattern>
              <marker id={`${svgId}-arrow-blue`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                <path d="M 0 1.5 L 8 5 L 0 8.5 z" class="svg-info-fill" />
              </marker>
              <marker id={`${svgId}-arrow-red`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                <path d="M 0 1.5 L 8 5 L 0 8.5 z" class="svg-danger-fill" />
              </marker>
              <marker id={`${svgId}-arrow-green`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                <path d="M 0 1.5 L 8 5 L 0 8.5 z" class="svg-safe-fill" />
              </marker>
              <marker id={`${svgId}-arrow-amber`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                <path d="M 0 1.5 L 8 5 L 0 8.5 z" class="svg-warn-fill" />
              </marker>
            </defs>

            <!-- Subtle Technical Blueprint Background -->
            <rect x="0" y="0" width="760" height="390" class="svg-canvas" />
            <rect x="0" y="0" width="760" height="390" fill={`url(#${svgId}-grid)`} />

            {/* ==================== 1. DISHWASHER ==================== */}
            {appKey === 'dishwasher' && (
              <g>
                <!-- Outer Dishwasher Chassis -->
                <rect x="34" y="26" width="332" height="338" rx="14" class="svg-shell" stroke-width="2" />
                <!-- Control Bar -->
                <rect x="46" y="38" width="308" height="28" rx="6" class="svg-header-bar" />
                <text x="60" y="56" class="svg-micro-label" font-size="10" font-weight="700">{L.unitTag}</text>
                <circle cx="312" cy="52" r="4" class="svg-safe-fill" />
                <circle cx="326" cy="52" r="4" class="svg-warn-fill" />
                <circle cx="340" cy="52" r="4" class="svg-danger-fill" />

                <!-- Interior Cavity -->
                <rect x="48" y="76" width="304" height="274" rx="8" class="svg-cavity" stroke-width="1.5" />

                <!-- Top Rack Thermal Tint -->
