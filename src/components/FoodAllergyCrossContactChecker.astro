const t = UI[lang] || UI.en;
const defaultAllergen = localizedAllergens[0];
const defaultSurface = localizedSurfaces[0];

function getRiskPillClass(risk: RiskLevel): string {
  if (risk === 'safe-after-wash') return 'badge-yes';
  if (risk === 'high-risk-scrub') return 'badge-depends';
  return 'badge-no';
}

function getRiskLabel(risk: RiskLevel): string {
  if (risk === 'safe-after-wash') return t.badgeSafeWash;
  if (risk === 'high-risk-scrub') return t.badgeStrictScrub;
  return t.badgeNeverShare;
}

function getShareLabel(share: CanShareType): string {
  if (share === 'yes-with-soap-wash') return t.shareYes;
  if (share === 'caution-strict-wash') return t.shareCaution;
  return t.shareNo;
}

function getSubRiskLabel(level: SubRiskLevel): string {
  if (level === 'high') return t.riskHigh;
  if (level === 'moderate') return t.riskModerate;
  return t.riskLow;
}

function getSubRiskBadgeClass(level: SubRiskLevel): string {
  if (level === 'high') return 'bg-red-500/15 text-red-800 dark:text-red-300 border-red-500/40';
  if (level === 'moderate') return 'bg-amber-500/15 text-amber-800 dark:text-amber-300 border-amber-500/40';
  return 'bg-emerald-500/15 text-emerald-800 dark:text-emerald-300 border-emerald-500/35';
}

function getCardBorderAccent(risk: RiskLevel): string {
  if (risk === 'safe-after-wash') return 'border-l-4 border-l-success-border';
  if (risk === 'high-risk-scrub') return 'border-l-4 border-l-warning-border';
  return 'border-l-4 border-l-error-border';
}

const clientPayload = {
  totalCount: localizedSurfaces.length,
  allergens: localizedAllergens,
  surfaces: localizedSurfaces,
  ui: {
    copyBtn: t.copyBtn,
    copiedBtn: t.copiedBtn,
    showingPrefix: t.showingPrefix,
    showingOf: t.showingOf,
    showingSuffix: t.showingSuffix,
    badgeNeverShare: t.badgeNeverShare,
    badgeStrictScrub: t.badgeStrictScrub,
    badgeSafeWash: t.badgeSafeWash,
    fdaTop9Tag: t.fdaTop9Tag,
    protocolMultiTag: t.protocolMultiTag,
    riskHigh: t.riskHigh,
    riskModerate: t.riskModerate,
    riskLow: t.riskLow,
    airborneLabel: t.airborneLabel,
    oilFilmLabel: t.oilFilmLabel,
    cardInspectHint: t.cardInspectHint,
    cardSelectedLabel: t.cardSelectedLabel,
    checklistHeader: t.checklistHeader,
    checklistCoreRules: t.checklistCoreRules,
    checklistSurfacePrefix: t.checklistSurfacePrefix,
    checklistAllergenPrefix: t.checklistAllergenPrefix
  }
};
---

<div id="food-allergy-checker-root" class="space-y-12">
  <!-- Critical Science Myth Banner -->
  <aside
    class="p-5 sm:p-6 rounded-2xl bg-error-bg/70 dark:bg-red-950/35 border-2 border-error-border/80 shadow-sm space-y-2"
    role="note"
    aria-label={mythBanner.badge}
  >
    <div class="flex flex-wrap items-center gap-2">
      <span class="inline-block px-2.5 py-0.5 rounded-full text-[11px] font-extrabold uppercase tracking-wider bg-error-border text-white">
        ⚠️ {mythBanner.badge}
      </span>
      <span class="inline-block px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-canvas text-ink border border-hairline">
        🔥 {t.heatMythPill}
      </span>
    </div>
    <h2 class="text-base sm:text-lg font-extrabold text-ink leading-snug">
      {mythBanner.headline}
    </h2>
    <p class="text-xs sm:text-[13.5px] text-body leading-relaxed">
      {mythBanner.body}
    </p>
  </aside>

  <!-- Main Interactive Checker Card -->
  <section
    id="food-allergy-cross-contact-checker"
    class="bg-canvas border border-hairline rounded-2xl shadow-sm overflow-hidden"
    aria-label={t.ariaLabel}
  >
    <script type="application/json" id="facc-payload" set:html={JSON.stringify(clientPayload)} />

    <!-- PART 1: Allergen Selector + Dynamic Allergen Alert + Action Buttons -->
    <div class="p-5 sm:p-6 border-b border-hairline bg-surface-soft/50 space-y-5">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div class="space-y-1 max-w-2xl">
          <span class="inline-block px-2.5 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wider bg-signature-coral text-white">
            🛡️ {t.step1Badge}
          </span>
          <h2 class="text-title-md font-bold text-ink">{t.step1Title}</h2>
          <p class="text-xs sm:text-[13px] text-muted leading-relaxed">{t.step1Sub}</p>
        </div>

        <div class="flex flex-wrap items-center gap-2 print:hidden">
          <button
            type="button"
            id="facc-copy-btn"
            class="min-h-[40px] px-3.5 py-2 rounded-xl text-xs font-semibold bg-primary text-on-primary hover:bg-primary-active transition-colors cursor-pointer shadow-sm"
          >
            <span id="facc-copy-label">📋 {t.copyBtn}</span>
          </button>
          <button
            type="button"
            id="facc-print-btn"
            class="min-h-[40px] px-3.5 py-2 rounded-xl text-xs font-semibold bg-canvas text-ink border border-hairline hover:border-signature-coral transition-colors cursor-pointer"
          >
            🖨️ {t.printBtn}
          </button>
          <button
            type="button"
            id="facc-reset-btn"
            class="min-h-[40px] px-3 py-2 rounded-xl text-xs font-semibold bg-canvas text-muted border border-hairline hover:border-border-strong hover:text-ink transition-colors cursor-pointer"
          >
            {t.resetBtn}
          </button>
        </div>
      </div>

      <!-- 10 Allergen Profile Chips -->
      <div
        class="flex flex-wrap gap-2 print:hidden"
        role="radiogroup"
        aria-label={t.step1Title}
      >
        {localizedAllergens.map((allergen, idx) => (
          <button
            type="button"
            role="radio"
            aria-checked={idx === 0 ? 'true' : 'false'}
            data-facc-allergen={allergen.id}
            class={`facc-allergen-btn min-h-[38px] px-3.5 py-1.5 rounded-xl text-xs font-bold border transition-all cursor-pointer inline-flex items-center gap-1.5 ${
              idx === 0
                ? 'bg-primary text-on-primary border-primary shadow-sm'
                : 'bg-canvas text-ink border-hairline hover:border-border-strong'
            }`}
          >
            <span aria-hidden="true">{allergen.icon}</span>
            <span>{allergen.shortName}</span>
          </button>
        ))}
      </div>

      <!-- 2-Column Live Readout: Allergen-Specific Risk Alert + Selected Surface Decontamination Protocol Dashboard -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-stretch">
        <!-- Left (5 cols): Dynamic Allergen-Specific Risk Alert -->
        <div class="lg:col-span-5 flex">
          <div
            id="facc-allergen-alert"
            aria-live="polite"
            class="w-full rounded-2xl bg-warning-bg/55 dark:bg-amber-950/25 border border-warning-border/80 p-5 space-y-3.5 flex flex-col justify-between"
          >
            <div class="space-y-2.5">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <span class="inline-block px-2.5 py-0.5 rounded-full text-[10.5px] font-extrabold uppercase tracking-wider bg-ink text-canvas">
                  {t.allergenAlertBadge}
                </span>
                <span
                  id="facc-allergen-fda-tag"
                  class="text-[11px] font-bold text-ink/80"
                >
                  {defaultAllergen.fdaTop9 ? t.fdaTop9Tag : t.protocolMultiTag}
                </span>
              </div>

              <div class="flex items-start gap-2.5">
                <span id="facc-allergen-icon" aria-hidden="true" class="text-2xl leading-none mt-0.5 shrink-0">
                  {defaultAllergen.icon}
                </span>
                <div>
                  <h3 id="facc-allergen-name" class="text-base font-extrabold text-ink leading-snug">
                    {defaultAllergen.name}
                  </h3>
                  <p id="facc-allergen-tag" class="text-[11.5px] font-bold text-signature-coral mt-0.5">
                    {defaultAllergen.persistenceTag}
                  </p>
                </div>
              </div>

              <!-- Airborne & Oil-Film Badges -->
              <div class="flex flex-wrap gap-1.5">
                <span
                  id="facc-allergen-airborne"
                  class={`inline-flex items-center gap-1 px-2 py-0.5 rounded-md border text-[11px] font-bold ${getSubRiskBadgeClass(defaultAllergen.airborneRisk)}`}
                >
                  💨 {t.airborneLabel}: {getSubRiskLabel(defaultAllergen.airborneRisk)}
                </span>
                <span
                  id="facc-allergen-oil"
                  class={`inline-flex items-center gap-1 px-2 py-0.5 rounded-md border text-[11px] font-bold ${getSubRiskBadgeClass(defaultAllergen.oilFilmRisk)}`}
                >
                  🫧 {t.oilFilmLabel}: {getSubRiskLabel(defaultAllergen.oilFilmRisk)}
                </span>
              </div>

              <p id="facc-allergen-headline" class="text-xs sm:text-[13px] font-bold text-ink leading-snug">
                {defaultAllergen.riskHeadline}
              </p>
              <p id="facc-allergen-fact" class="text-xs sm:text-[13px] text-body leading-relaxed">
                {defaultAllergen.persistenceFact}
              </p>
            </div>

            <div class="p-3 rounded-xl bg-canvas border border-hairline">
              <span class="block text-[10.5px] font-extrabold uppercase tracking-wider text-signature-coral">
                🛡️ {t.precautionLabel}
              </span>
              <p id="facc-allergen-precaution" class="text-xs text-body leading-relaxed mt-1">
                {defaultAllergen.specialPrecaution}
              </p>
            </div>
          </div>
        </div>

        <!-- Right (7 cols): High-Contrast Dark FDA/FARE Surface Decontamination Protocol Dashboard -->
        <div class="lg:col-span-7 flex">
          <div
            id="facc-surface-dashboard"
            aria-live="polite"
            class={`w-full rounded-2xl bg-surface-dark text-on-dark p-5 sm:p-6 space-y-4 shadow-sm border-l-4 ${
              defaultSurface.riskLevel === 'safe-after-wash'
                ? 'border-success-border'
                : defaultSurface.riskLevel === 'high-risk-scrub'
                  ? 'border-warning-border'
                  : 'border-error-border'
            } flex flex-col justify-between`}
          >
            <div class="space-y-3">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <span class="text-[11px] font-bold uppercase tracking-wider text-signature-peach">
                  {t.dashboardBadge}
                </span>
                <span id="facc-dash-pill" class={getRiskPillClass(defaultSurface.riskLevel)}>
                  {getRiskLabel(defaultSurface.riskLevel)}
                </span>
              </div>

              <div class="flex items-start gap-2.5">
                <span id="facc-dash-icon" aria-hidden="true" class="text-2xl leading-none mt-0.5 shrink-0">
                  {defaultSurface.icon}
                </span>
                <div>
                  <h3 id="facc-dash-name" class="text-base sm:text-lg font-extrabold tracking-tight text-white leading-snug">
                    {defaultSurface.name}
                  </h3>
                  <p id="facc-dash-verdict" class="text-xs sm:text-[13px] font-bold text-signature-yellow mt-0.5 leading-snug">
                    {defaultSurface.verdictHeadline}
                  </p>
                </div>
              </div>

              <!-- Why Risky -->
              <div class="p-3 rounded-xl bg-white/5 border border-white/10">
                <span class="block text-[10.5px] font-bold uppercase tracking-wider text-white/70">
                  🔬 {t.whyRiskyLabel}
                </span>
                <p id="facc-dash-why" class="text-xs sm:text-[13px] text-white/90 leading-relaxed mt-1">
                  {defaultSurface.whyRisky}
                </p>
              </div>

              <!-- Step-by-Step FDA/FARE Cleaning Protocol -->
              <div class="space-y-1.5">
                <span class="block text-[10.5px] font-bold uppercase tracking-wider text-signature-mint">
                  🧼 {t.protocolStepsLabel}
                </span>
                <ol id="facc-dash-steps" class="space-y-1.5 text-xs sm:text-[13px] text-white/95 list-decimal list-outside pl-5">
                  {defaultSurface.cleaningSteps.map((step) => (
                    <li class="leading-relaxed">{step}</li>
                  ))}
                </ol>
              </div>
            </div>

            <!-- Dedicated Recommendation + Severe Allergy Callout -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-1">
              <div class="p-3 rounded-xl bg-white/8 border border-white/15">
                <span class="block text-[10.5px] font-bold uppercase tracking-wider text-signature-peach">
                  ✅ {t.dedicatedLabel}
                </span>
                <p id="facc-dash-dedicated" class="text-xs text-white/95 leading-relaxed mt-1">
                  {defaultSurface.dedicatedRecommendation}
                </p>
              </div>
              <div class="p-3 rounded-xl bg-red-500/15 border border-red-400/35">
                <span class="block text-[10.5px] font-bold uppercase tracking-wider text-red-200">
                  🚨 {t.anaphylaxisCalloutLabel}
                </span>
                <p id="facc-dash-anaphylaxis" class="text-xs text-white/95 leading-relaxed mt-1">
                  {defaultSurface.anaphylaxisNote}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- PART 2: Filterable & Searchable 10-Surface Cross-Contact Cards -->
    <div class="p-5 sm:p-6 space-y-5">
      <div class="space-y-1">
        <h2 class="text-title-md font-semibold text-ink">{t.catalogTitle}</h2>
        <p class="text-xs sm:text-[13px] text-muted">{t.catalogSub}</p>
      </div>

      <!-- Search Input + Risk Filter Pills -->
      <div class="space-y-3 print:hidden">
        <div class="flex flex-col sm:flex-row gap-2.5">
          <div class="relative flex-1">
            <label for="facc-search-input" class="sr-only">{t.searchLabel}</label>
            <span aria-hidden="true" class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-sm text-muted">
              🔎
            </span>
            <input
              id="facc-search-input"
              type="search"
              autocomplete="off"
              placeholder={t.searchPlaceholder}
              class="w-full min-h-[44px] pl-10 pr-4 py-2 rounded-xl bg-surface-soft border border-hairline text-sm text-ink placeholder:text-muted focus:outline-none focus:border-signature-coral focus:ring-2 focus:ring-signature-coral/25 transition-all"
            />
          </div>
          <button
            type="button"
            id="facc-clear-btn"
            class="min-h-[44px] px-4 py-2 rounded-xl text-xs font-semibold bg-canvas text-ink border border-hairline hover:border-signature-coral transition-colors cursor-pointer shrink-0"
          >
            {t.clearSearchBtn}
          </button>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-3">
          <div class="flex flex-wrap gap-2" role="group" aria-label={t.catalogTitle}>
            <button
              type="button"
              data-facc-filter="all"
              aria-pressed="true"
              class="facc-filter-btn px-3.5 py-1.5 rounded-full text-xs font-bold border transition-all cursor-pointer bg-primary text-on-primary border-primary shadow-sm"
            >
              {t.filterAll} ({counts.all})
            </button>
            <button
              type="button"
              data-facc-filter="cannot-decontaminate"
              aria-pressed="false"
              class="facc-filter-btn px-3.5 py-1.5 rounded-full text-xs font-bold border transition-all cursor-pointer bg-canvas text-ink border-hairline hover:border-error-border"
            >
              🚫 {t.filterNeverShare} ({counts.cannotDecontaminate})
            </button>
            <button
              type="button"
              data-facc-filter="high-risk-scrub"
              aria-pressed="false"
              class="facc-filter-btn px-3.5 py-1.5 rounded-full text-xs font-bold border transition-all cursor-pointer bg-canvas text-ink border-hairline hover:border-warning-border"
            >
              ⚠️ {t.filterStrictScrub} ({counts.highRiskScrub})
            </button>
            <button
              type="button"
              data-facc-filter="safe-after-wash"
              aria-pressed="false"
              class="facc-filter-btn px-3.5 py-1.5 rounded-full text-xs font-bold border transition-all cursor-pointer bg-canvas text-ink border-hairline hover:border-success-border"
            >
              ✅ {t.filterSafeWash} ({counts.safeAfterWash})
            </button>
          </div>

          <p id="facc-count-readout" aria-live="polite" class="text-xs font-semibold text-muted">
            {t.showingPrefix} {counts.all} {t.showingOf} {counts.all} {t.showingSuffix}
          </p>
        </div>
      </div>

      <!-- Empty Search State -->
      <div
        id="facc-empty-state"
        class="hidden p-8 rounded-2xl bg-surface-soft border border-hairline text-center space-y-2"
      >
        <p class="text-sm font-bold text-ink">{t.noResultsTitle}</p>
        <p class="text-xs text-muted">{t.noResultsSub}</p>
        <button
          type="button"
          id="facc-empty-reset-btn"
          class="mt-2 px-4 py-2 rounded-xl text-xs font-bold bg-primary text-on-primary hover:bg-primary-active transition-colors cursor-pointer"
        >
          {t.clearSearchBtn}
        </button>
      </div>

      <!-- 10 Clickable Appliance & Surface Cards -->
      <div id="facc-cards-grid" class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {localizedSurfaces.map((surface, idx) => (
          <button
            type="button"
            data-facc-card={surface.id}
            data-facc-risk={surface.riskLevel}
            data-facc-search={surface.keywords}
            aria-pressed={idx === 0 ? 'true' : 'false'}
            class={`facc-card text-left w-full p-4 sm:p-5 rounded-2xl bg-surface-soft/55 border border-hairline hover:border-signature-coral ${getCardBorderAccent(surface.riskLevel)} flex flex-col justify-between gap-3 transition-all cursor-pointer ${
              idx === 0 ? 'ring-2 ring-signature-coral bg-canvas shadow-sm' : ''
            }`}
          >
            <div class="space-y-2.5 w-full">
              <div class="flex items-start justify-between gap-2.5">
                <div class="flex items-start gap-2.5 min-w-0">
                  <span aria-hidden="true" class="text-xl leading-none mt-0.5 shrink-0">{surface.icon}</span>
                  <div class="min-w-0">
                    <h3 class="text-sm sm:text-[15px] font-bold text-ink leading-snug">{surface.name}</h3>
                    <p class="text-[11.5px] text-muted mt-0.5 leading-snug">{getShareLabel(surface.canShare)}</p>
                  </div>
                </div>
                <span class={`shrink-0 ${getRiskPillClass(surface.riskLevel)}`}>
                  {getRiskLabel(surface.riskLevel)}
                </span>
              </div>

              <p class="text-xs sm:text-[13px] font-semibold text-ink leading-snug">
                {surface.verdictHeadline}
              </p>

              <p class="text-xs text-body leading-relaxed">
                {surface.dedicatedRecommendation}
              </p>
            </div>

            <div class="w-full pt-2 border-t border-hairline/70 flex items-center justify-between gap-2">
              <span class="text-[11px] font-semibold text-muted">
                🔥 {t.heatMythPill}
              </span>
              <span
                data-facc-card-hint
                class={`text-[11px] font-bold ${idx === 0 ? 'text-signature-coral' : 'text-muted'}`}
              >
                {idx === 0 ? t.cardSelectedLabel : t.cardInspectHint}
              </span>
            </div>
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Related Companion Tools -->
  <section class="space-y-4 print:hidden">
    <h2 class="text-title-md font-semibold text-ink">{t.relatedHeading}</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      <a
        href={dishwasherUrl}
        class="p-6 rounded-2xl bg-surface-soft border border-hairline hover:border-signature-coral transition-all group block"
      >
        <span class="text-[11px] font-bold uppercase tracking-wider text-signature-coral block mb-1.5">
          {t.relatedDishTag}
        </span>
        <h3 class="text-title-sm font-semibold text-ink group-hover:text-signature-coral transition-colors mb-1.5">
          {t.relatedDishTitle}
        </h3>
        <p class="text-[13.5px] text-body leading-relaxed">{t.relatedDishDesc}</p>
      </a>

      <a
        href={cleanerMixingUrl}
        class="p-6 rounded-2xl bg-surface-soft border border-hairline hover:border-signature-coral transition-all group block"
      >
        <span class="text-[11px] font-bold uppercase tracking-wider text-signature-coral block mb-1.5">
          {t.relatedCleanerTag}
        </span>
        <h3 class="text-title-sm font-semibold text-ink group-hover:text-signature-coral transition-colors mb-1.5">
          {t.relatedCleanerTitle}
        </h3>
        <p class="text-[13.5px] text-body leading-relaxed">{t.relatedCleanerDesc}</p>
      </a>

      <a
        href={fridgeZoneUrl}
        class="p-6 rounded-2xl bg-surface-soft border border-hairline hover:border-signature-coral transition-all group block"
      >
        <span class="text-[11px] font-bold uppercase tracking-wider text-signature-coral block mb-1.5">
          {t.relatedFridgeTag}
        </span>
        <h3 class="text-title-sm font-semibold text-ink group-hover:text-signature-coral transition-colors mb-1.5">
          {t.relatedFridgeTitle}
        </h3>
        <p class="text-[13.5px] text-body leading-relaxed">{t.relatedFridgeDesc}</p>
      </a>
    </div>
  </section>

  <!-- Methodology & Hub Strip -->
  <section class="p-6 rounded-2xl bg-surface-soft border border-hairline print:hidden">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <h2 class="text-title-sm font-semibold text-ink mb-1">{t.methodologyStripTitle}</h2>
        <p class="text-[13px] text-muted">
          {t.methodologyStripPrefix}{' '}
          <a href={methodologyUrl} class="text-link underline hover:text-link-active">{t.methodologyLabel}</a>.
        </p>
      </div>
      <div class="flex flex-wrap gap-2">
        <a
          href={cleanerMixingUrl}
          class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral transition-colors"
        >
          {t.cleanerQuickLabel}
        </a>
        <a
          href={methodologyUrl}
          class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral transition-colors"
        >
          {t.methodologyLabel}
        </a>
        <a
          href={allToolsUrl}
          class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-primary text-on-primary hover:bg-primary-active transition-colors"
        >
          {t.allToolsLabel}
        </a>
      </div>
    </div>
  </section>

  <!-- Visible FAQ Accordion (Matches JSON-LD 1:1) -->
  <section class="print:hidden">
    <h2 class="text-title-lg font-medium text-ink tracking-tight mb-6">
      {t.faqTitle}
    </h2>
    <div class="space-y-4">
      {localizedFaqs.map((faq) => (
        <details class="group p-5 bg-surface-soft border border-hairline rounded-xl" open>
          <summary class="text-title-sm font-semibold text-ink cursor-pointer list-none flex items-center justify-between gap-3">
            <span>{faq.question}</span>
            <span class="text-muted text-sm transition-transform group-open:rotate-180 shrink-0" aria-hidden="true">&#9662;</span>
          </summary>
          <p class="text-[14px] text-body leading-relaxed mt-3 pt-3 border-t border-hairline/70">
            {faq.answer}
          </p>
        </details>
      ))}
    </div>
  </section>
</div>

<script is:inline>
  (function () {
    var payloadEl = document.getElementById('facc-payload');
    if (!payloadEl) return;

    var payload;
    try {
      payload = JSON.parse(payloadEl.textContent || '{}');
    } catch (_) {
      return;
    }

    var allergens = Array.isArray(payload.allergens) ? payload.allergens : [];
    var surfaces = Array.isArray(payload.surfaces) ? payload.surfaces : [];
    var ui = payload.ui || {};
    var totalCount = Number(payload.totalCount || surfaces.length || 10);

    var allergenMap = {};
    allergens.forEach(function (a) {
      if (a && a.id) allergenMap[a.id] = a;
    });

    var surfaceMap = {};
    surfaces.forEach(function (s) {
      if (s && s.id) surfaceMap[s.id] = s;
    });

    // Allergen controls & outputs
    var allergenBtns = Array.from(document.querySelectorAll('.facc-allergen-btn'));
    var elAllergenFdaTag = document.getElementById('facc-allergen-fda-tag');
    var elAllergenIcon = document.getElementById('facc-allergen-icon');
    var elAllergenName = document.getElementById('facc-allergen-name');
    var elAllergenTag = document.getElementById('facc-allergen-tag');
    var elAllergenAirborne = document.getElementById('facc-allergen-airborne');
    var elAllergenOil = document.getElementById('facc-allergen-oil');
    var elAllergenHeadline = document.getElementById('facc-allergen-headline');
    var elAllergenFact = document.getElementById('facc-allergen-fact');
    var elAllergenPrecaution = document.getElementById('facc-allergen-precaution');

    // Surface dashboard outputs
    var elDash = document.getElementById('facc-surface-dashboard');
    var elDashPill = document.getElementById('facc-dash-pill');
    var elDashIcon = document.getElementById('facc-dash-icon');
    var elDashName = document.getElementById('facc-dash-name');
    var elDashVerdict = document.getElementById('facc-dash-verdict');
    var elDashWhy = document.getElementById('facc-dash-why');
    var elDashSteps = document.getElementById('facc-dash-steps');
    var elDashDedicated = document.getElementById('facc-dash-dedicated');
    var elDashAnaphylaxis = document.getElementById('facc-dash-anaphylaxis');

    // Filter, search & card controls
    var searchInput = document.getElementById('facc-search-input');
    var clearBtn = document.getElementById('facc-clear-btn');
    var emptyResetBtn = document.getElementById('facc-empty-reset-btn');
    var filterBtns = Array.from(document.querySelectorAll('.facc-filter-btn'));
    var cards = Array.from(document.querySelectorAll('.facc-card'));
    var countReadout = document.getElementById('facc-count-readout');
    var emptyState = document.getElementById('facc-empty-state');
    var cardsGrid = document.getElementById('facc-cards-grid');

    // Top action buttons
    var copyBtn = document.getElementById('facc-copy-btn');
    var copyLabel = document.getElementById('facc-copy-label');
    var printBtn = document.getElementById('facc-print-btn');
    var resetBtn = document.getElementById('facc-reset-btn');

    var state = {
      allergenId: allergens[0] ? allergens[0].id : 'peanut',
      surfaceId: surfaces[0] ? surfaces[0].id : 'pop-up-toaster',
      filter: 'all',
      query: ''
    };

    function getRiskPillClass(risk) {
      if (risk === 'safe-after-wash') return 'badge-yes';
      if (risk === 'high-risk-scrub') return 'badge-depends';
      return 'badge-no';
    }

    function getRiskLabel(risk) {
      if (risk === 'safe-after-wash') return ui.badgeSafeWash || 'Safe After Proper Wash';
      if (risk === 'high-risk-scrub') return ui.badgeStrictScrub || 'Strict Soap Scrub Required';
      return ui.badgeNeverShare || 'Never Share / Dedicated Only';
    }

    function getSubRiskText(level) {
      if (level === 'high') return ui.riskHigh || 'High';
      if (level === 'moderate') return ui.riskModerate || 'Moderate';
      return ui.riskLow || 'Low';
    }

    function setSubRiskClasses(el, level) {
      if (!el) return;
      el.classList.remove(
        'bg-red-500/15',
        'text-red-800',
        'dark:text-red-300',
        'border-red-500/40',
        'bg-amber-500/15',
        'text-amber-800',
        'dark:text-amber-300',
        'border-amber-500/40',
        'bg-emerald-500/15',
        'text-emerald-800',
        'dark:text-emerald-300',
        'border-emerald-500/35'
      );
      if (level === 'high') {
        el.classList.add('bg-red-500/15', 'text-red-800', 'dark:text-red-300', 'border-red-500/40');
      } else if (level === 'moderate') {
        el.classList.add('bg-amber-500/15', 'text-amber-800', 'dark:text-amber-300', 'border-amber-500/40');
      } else {
        el.classList.add('bg-emerald-500/15', 'text-emerald-800', 'dark:text-emerald-300', 'border-emerald-500/35');
      }
    }

    function renderAllergen() {
      var allergen = allergenMap[state.allergenId] || allergens[0];
      if (!allergen) return;

      allergenBtns.forEach(function (btn) {
        var active = btn.getAttribute('data-facc-allergen') === allergen.id;
        btn.setAttribute('aria-checked', active ? 'true' : 'false');
        btn.classList.toggle('bg-primary', active);
        btn.classList.toggle('text-on-primary', active);
        btn.classList.toggle('border-primary', active);
        btn.classList.toggle('shadow-sm', active);
        btn.classList.toggle('bg-canvas', !active);
        btn.classList.toggle('text-ink', !active);
        btn.classList.toggle('border-hairline', !active);
      });

      if (elAllergenFdaTag) {
        elAllergenFdaTag.textContent = allergen.fdaTop9
          ? (ui.fdaTop9Tag || 'FDA Top 9 Major Allergen')
          : (ui.protocolMultiTag || 'Zero-Tolerance Anaphylaxis Protocol');
      }
      if (elAllergenIcon) elAllergenIcon.textContent = allergen.icon || '';
      if (elAllergenName) elAllergenName.textContent = allergen.name || '';
      if (elAllergenTag) elAllergenTag.textContent = allergen.persistenceTag || '';
      if (elAllergenHeadline) elAllergenHeadline.textContent = allergen.riskHeadline || '';
      if (elAllergenFact) elAllergenFact.textContent = allergen.persistenceFact || '';
      if (elAllergenPrecaution) elAllergenPrecaution.textContent = allergen.specialPrecaution || '';

      if (elAllergenAirborne) {
        elAllergenAirborne.textContent = '💨 ' + (ui.airborneLabel || 'Airborne / Steam Risk') + ': ' + getSubRiskText(allergen.airborneRisk);
        setSubRiskClasses(elAllergenAirborne, allergen.airborneRisk);
      }
      if (elAllergenOil) {
        elAllergenOil.textContent = '🫧 ' + (ui.oilFilmLabel || 'Sticky Oil / Residue Risk') + ': ' + getSubRiskText(allergen.oilFilmRisk);
        setSubRiskClasses(elAllergenOil, allergen.oilFilmRisk);
      }
    }

    function renderSurfaceDashboard() {
      var surface = surfaceMap[state.surfaceId] || surfaces[0];
      var allergen = allergenMap[state.allergenId] || allergens[0];
      if (!surface) return;

      if (elDashPill) {
        elDashPill.className = getRiskPillClass(surface.riskLevel);
        elDashPill.textContent = getRiskLabel(surface.riskLevel);
      }
      if (elDashIcon) elDashIcon.textContent = surface.icon || '';
      if (elDashName) elDashName.textContent = surface.name || '';
      if (elDashVerdict) elDashVerdict.textContent = surface.verdictHeadline || '';
      if (elDashWhy) elDashWhy.textContent = surface.whyRisky || '';
      if (elDashDedicated) elDashDedicated.textContent = surface.dedicatedRecommendation || '';

      if (elDashAnaphylaxis) {
        var combinedNote = surface.anaphylaxisNote || '';
        if (allergen && allergen.shortName) {
          combinedNote = '[' + allergen.shortName + '] ' + combinedNote;
        }
        elDashAnaphylaxis.textContent = combinedNote;
      }

      if (elDashSteps) {
        while (elDashSteps.firstChild) {
          elDashSteps.removeChild(elDashSteps.firstChild);
        }
        var steps = Array.isArray(surface.cleaningSteps) ? surface.cleaningSteps : [];
        steps.forEach(function (stepText) {
          var li = document.createElement('li');
          li.className = 'leading-relaxed';
          li.textContent = stepText;
          elDashSteps.appendChild(li);
        });
      }

      if (elDash) {
        elDash.classList.remove('border-success-border', 'border-warning-border', 'border-error-border');
        elDash.classList.add(
          surface.riskLevel === 'safe-after-wash'
            ? 'border-success-border'
            : surface.riskLevel === 'high-risk-scrub'
              ? 'border-warning-border'
              : 'border-error-border'
        );
      }

      cards.forEach(function (card) {
        var active = card.getAttribute('data-facc-card') === surface.id;
        card.setAttribute('aria-pressed', active ? 'true' : 'false');
        card.classList.toggle('ring-2', active);
        card.classList.toggle('ring-signature-coral', active);
        card.classList.toggle('bg-canvas', active);
        card.classList.toggle('shadow-sm', active);
        card.classList.toggle('bg-surface-soft/55', !active);
        var hint = card.querySelector('[data-facc-card-hint]');
        if (hint) {
          hint.textContent = active
            ? (ui.cardSelectedLabel || 'Viewing Protocol ↑')
            : (ui.cardInspectHint || 'Click to view full FDA/FARE protocol ↑');
          hint.classList.toggle('text-signature-coral', active);
          hint.classList.toggle('text-muted', !active);
        }
      });
    }

    function renderCatalog() {
      var q = (state.query || '').trim().toLowerCase();
      var visibleCount = 0;

      filterBtns.forEach(function (btn) {
        var fVal = btn.getAttribute('data-facc-filter');
        var active = fVal === state.filter;
        btn.setAttribute('aria-pressed', active ? 'true' : 'false');
        btn.classList.toggle('bg-primary', active);
        btn.classList.toggle('text-on-primary', active);
        btn.classList.toggle('border-primary', active);
        btn.classList.toggle('shadow-sm', active);
        btn.classList.toggle('bg-canvas', !active);
        btn.classList.toggle('text-ink', !active);
        btn.classList.toggle('border-hairline', !active);
      });

      cards.forEach(function (card) {
        var risk = card.getAttribute('data-facc-risk') || '';
        var haystack = card.getAttribute('data-facc-search') || '';
        var filterMatch = state.filter === 'all' || risk === state.filter;
        var queryMatch = !q || haystack.indexOf(q) !== -1;
        var show = filterMatch && queryMatch;
        card.classList.toggle('hidden', !show);
        if (show) visibleCount += 1;
      });

      if (countReadout) {
        countReadout.textContent =
          (ui.showingPrefix || 'Showing') +
          ' ' +
          visibleCount +
          ' ' +
          (ui.showingOf || 'of') +
          ' ' +
          totalCount +
          ' ' +
          (ui.showingSuffix || 'surfaces & appliances');
      }

      var isEmpty = visibleCount === 0;
      if (emptyState) emptyState.classList.toggle('hidden', !isEmpty);
      if (cardsGrid) cardsGrid.classList.toggle('hidden', isEmpty);
    }

    function buildChecklistText() {
      var allergen = allergenMap[state.allergenId] || allergens[0];
      var surface = surfaceMap[state.surfaceId] || surfaces[0];
      var lines = [];
      lines.push(ui.checklistHeader || 'IsItKitchenSafe — Guest Allergy-Safe Kitchen Prep Checklist');
      lines.push('');
      if (allergen) {
        lines.push((ui.checklistAllergenPrefix || 'Active Allergen Focus') + ': ' + allergen.name);
        lines.push('- ' + allergen.checklistNote);
        lines.push('');
      }
      if (surface) {
        lines.push((ui.checklistSurfacePrefix || 'Selected Appliance/Surface Protocol') + ': ' + surface.name + ' (' + getRiskLabel(surface.riskLevel) + ')');
        lines.push('- ' + surface.dedicatedRecommendation);
        if (Array.isArray(surface.cleaningSteps)) {
          surface.cleaningSteps.forEach(function (step, i) {
            lines.push('  ' + (i + 1) + ') ' + step);
          });
        }
        lines.push('');
      }
      if (Array.isArray(ui.checklistCoreRules)) {
        ui.checklistCoreRules.forEach(function (rule) {
          lines.push(rule);
        });
      }
      return lines.join('\n');
    }

    function clearCatalogFilters() {
      state.filter = 'all';
      state.query = '';
      if (searchInput) searchInput.value = '';
      renderCatalog();
    }

    // Event listeners
    allergenBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var id = btn.getAttribute('data-facc-allergen');
        if (id && allergenMap[id]) {
          state.allergenId = id;
          renderAllergen();
          renderSurfaceDashboard();
        }
      });
    });

    cards.forEach(function (card) {
      card.addEventListener('click', function () {
        var id = card.getAttribute('data-facc-card');
        if (id && surfaceMap[id]) {
          state.surfaceId = id;
          renderSurfaceDashboard();
          if (elDash && typeof elDash.scrollIntoView === 'function') {
            var rect = elDash.getBoundingClientRect();
            if (rect.top < 0 || rect.top > window.innerHeight * 0.65) {
              elDash.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
          }
        }
      });
    });

    filterBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var val = btn.getAttribute('data-facc-filter');
        if (val) {
          state.filter = val;
          renderCatalog();
        }
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', function () {
        state.query = searchInput.value || '';
        renderCatalog();
      });
    }

    if (clearBtn) {
      clearBtn.addEventListener('click', clearCatalogFilters);
    }
    if (emptyResetBtn) {
      emptyResetBtn.addEventListener('click', clearCatalogFilters);
    }

    if (copyBtn) {
      copyBtn.addEventListener('click', function () {
        var checklistText = buildChecklistText();
        var showCopied = function () {
          if (copyLabel) copyLabel.textContent = ui.copiedBtn || 'Checklist Copied ✓';
          window.setTimeout(function () {
            if (copyLabel) copyLabel.textContent = '📋 ' + (ui.copyBtn || 'Copy Guest Allergy Prep Checklist');
          }, 2200);
        };

        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(checklistText).then(showCopied).catch(showCopied);
        } else {
          var ta = document.createElement('textarea');
          ta.value = checklistText;
          ta.setAttribute('readonly', '');
          ta.style.position = 'absolute';
          ta.style.left = '-9999px';
          document.body.appendChild(ta);
          ta.select();
          try {
            document.execCommand('copy');
          } catch (_) {
            // ignore
          }
          document.body.removeChild(ta);
          showCopied();
        }
      });
    }

    if (printBtn) {
      printBtn.addEventListener('click', function () {
        window.print();
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', function () {
        state.allergenId = allergens[0] ? allergens[0].id : 'peanut';
        state.surfaceId = surfaces[0] ? surfaces[0].id : 'pop-up-toaster';
        clearCatalogFilters();
        renderAllergen();
        renderSurfaceDashboard();
      });
    }

    renderAllergen();
    renderSurfaceDashboard();
    renderCatalog();
  })();
</script>
