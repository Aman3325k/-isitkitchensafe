---
import rawData from '../data/food-allergy-cross-contact-data.json';
import type { SupportedLanguage } from '../i18n/ui';
import { useTranslatedPath } from '../i18n/utils';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;
const translatePath = useTranslatedPath(lang);

const dishwasherUrl = translatePath('/tools/dishwasher-detergent-dosage-calculator/');
const cleanerMixingUrl = translatePath('/tools/cleaner-mixing-danger-checker/');
const fridgeZoneUrl = translatePath('/tools/fridge-organization-zone-planner/');
const methodologyUrl = translatePath('/methodology/');
const allToolsUrl = translatePath('/tools/');

type RiskLevel = 'cannot-decontaminate' | 'high-risk-scrub' | 'safe-after-wash';
type CanShareType = 'no-dedicated-only' | 'caution-strict-wash' | 'yes-with-soap-wash';
type SubRiskLevel = 'high' | 'moderate' | 'low';

interface LocalizedAllergen {
  id: string;
  icon: string;
  airborneRisk: SubRiskLevel;
  oilFilmRisk: SubRiskLevel;
  fdaTop9: boolean;
  name: string;
  shortName: string;
  persistenceTag: string;
  riskHeadline: string;
  persistenceFact: string;
  specialPrecaution: string;
  checklistNote: string;
}

interface LocalizedSurface {
  id: string;
  icon: string;
  riskLevel: RiskLevel;
  canShare: CanShareType;
  heatDestroysAllergen: boolean;
  keywords: string;
  name: string;
  shortLabel: string;
  verdictHeadline: string;
  whyRisky: string;
  cleaningSteps: string[];
  dedicatedRecommendation: string;
  anaphylaxisNote: string;
}

const mythBanner =
  (rawData.mythBanner as Record<string, { badge: string; headline: string; body: string }>)[lang] ||
  rawData.mythBanner.en;

const localizedAllergens: LocalizedAllergen[] = rawData.allergens.map((item) => {
  const tr = (item.i18n as Record<string, any>)[lang] || item.i18n.en;
  return {
    id: item.id,
    icon: item.icon,
    airborneRisk: item.airborneRisk as SubRiskLevel,
    oilFilmRisk: item.oilFilmRisk as SubRiskLevel,
    fdaTop9: Boolean(item.fdaTop9),
    name: tr.name,
    shortName: tr.shortName,
    persistenceTag: tr.persistenceTag,
    riskHeadline: tr.riskHeadline,
    persistenceFact: tr.persistenceFact,
    specialPrecaution: tr.specialPrecaution,
    checklistNote: tr.checklistNote
  };
});

const localizedSurfaces: LocalizedSurface[] = rawData.surfaces.map((item) => {
  const tr = (item.i18n as Record<string, any>)[lang] || item.i18n.en;
  return {
    id: item.id,
    icon: item.icon,
    riskLevel: item.riskLevel as RiskLevel,
    canShare: item.canShare as CanShareType,
    heatDestroysAllergen: Boolean(item.heatDestroysAllergen),
    keywords: `${item.keywords} ${tr.name} ${tr.shortLabel} ${tr.verdictHeadline} ${tr.whyRisky}`.toLowerCase(),
    name: tr.name,
    shortLabel: tr.shortLabel,
    verdictHeadline: tr.verdictHeadline,
    whyRisky: tr.whyRisky,
    cleaningSteps: tr.cleaningSteps as string[],
    dedicatedRecommendation: tr.dedicatedRecommendation,
    anaphylaxisNote: tr.anaphylaxisNote
  };
});

const localizedFaqs: Array<{ question: string; answer: string }> =
  (rawData.faqs as Record<string, Array<{ question: string; answer: string }>>)[lang] ||
  rawData.faqs.en;

const counts = {
  all: localizedSurfaces.length,
  cannotDecontaminate: localizedSurfaces.filter((s) => s.riskLevel === 'cannot-decontaminate').length,
  highRiskScrub: localizedSurfaces.filter((s) => s.riskLevel === 'high-risk-scrub').length,
  safeAfterWash: localizedSurfaces.filter((s) => s.riskLevel === 'safe-after-wash').length
};

