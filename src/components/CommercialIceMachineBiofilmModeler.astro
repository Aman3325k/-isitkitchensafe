    consumerServingsHelp: "汚染氷が混入した飲料を口にする1日あたりの消費者数。経口摂取および吸入による感染リスクを評価します。",
    presetsTitle: "実証実験プリセットシナリオ：",
    presetNsfBenchmark: "NSF/ANSI-12適合ゴールド基準（格子キューブ ＋ 週1回除菌 ＋ 衛生厨房）",
    presetBarDisaster: "クラフトビールバー酵母汚染事故（アンダーカウンター ＋ 90日放置 ＋ 酵母浮遊）",
    presetPortableHomeTrap: "家庭用卓上循環機の死水トラップ（小型卓上機 ＋ 未洗浄 ＋ 硬水直結）",
    presetHospitalFlaker: "医療施設フレーク機レジオネラリスク（連続スクリュー ＋ 180日放置 ＋ 密閉室）",
    presetSilverBlockProtection: "サブミクロン銀イオン防護シールド（月1回洗浄 ＋ 0.2µm銀抗菌フィルター）",
    diagnosticTitle: "微生物汚染負荷＆バイオフィルム診断カード",
    diagnosticSub: "氷融解水の一般生菌数（HPC CFU/mL）、EPSバイオフィルム膜厚、レジオネラ飛散リスク、米FDA食品衛生基準判定をリアルタイム表示。",
    cfuPerMlLabel: "氷融解水の予測一般細菌密度（HPC CFU/mL）",
    epsThicknessLabel: "蒸発板上の細胞外ポリマー（EPS）膜厚",
    legionellaRiskLabel: "レジオネラ菌及び好冷性黒カビ危険度ランク",
    epaExceedanceLabel: "米EPA飲料水水質基準に対する超過倍率",
    bioAerosolRateLabel: "離氷サイクル時のバイオエアロゾル放出速度",
    fdaComplianceLabel: "米国FDA食品衛生法4-602.11(E)(4)適合性",
    clinicalSymptomsLabel: "消費者への病理的健康被害・感染リスク",
    actionProtocolLabel: "義務付けられる緊急除染・酸洗浄プロトコル",
    scienceTitle: "製氷機内部における好冷菌バイオフィルムと気泡飛散の物理",
    scienceSub: "なぜ0°C〜4°Cの氷結面と流水カーテンが、スライム形成細菌や真菌にとって格好の防壁となってしまうのか。",
    tableTitle: "製氷機構造別蒸発面特性と微生物付着動態マトリックス",
    tableSub: "蒸発板の金属材質、水流剪断力、バイオエアロゾル生成ポテンシャルの比較一覧。",
    colArchitecture: "製氷機機械構造",
    colSurfaceArea: "接水蒸発面積",
    colFlowRate: "循環水流量",
    colAdhesion: "菌体付着係数",
    colAerosolization: "エアロゾルリスク",
    colMetallurgy: "蒸発板材質特性",
    rulesTitle: "製氷機の衛生管理とレジオネラ感染防止の鉄則",
    rulesSub: "公衆衛生ガイドラインに基づき、ぬめり・黒カビ・異臭を根絶し、安全な氷を供給するための必須手順。",
    rule1Title: "ストッカー内の氷を全て廃棄する前に洗浄剤を投入しない",
    rule1Text: "酸性洗浄剤や塩素系除菌剤は化学蒸気を発生させます。氷への薬剤混入中毒事故を防止するため、作業前に必ず全氷を廃棄してください。",
    rule2Title: "殺菌剤の前に必ずニッケル対応酸性スケール除去剤を使用する",
    rule2Text: "バイオフィルムは多孔質のカルシウムスケールに根を張っています。スケールを残したまま消毒しても菌根は生き残ります。酸洗浄でカルシウムを溶かしてから殺菌します。",
    rule3Title: "プラスチック製水カーテンは14日ごとに取り外して手洗いする",
    rule3Text: "水カーテンは冷水飛沫と空気が常に交差するため、ピンク色のメチロバクテリウムや黒カビクラドスポリウムの最大の温床となります。",
    rule4Title: "銀ゼオライト抗菌機能付き0.2µmサブミクロン浄水器を設置する",
    rule4Text: "通常の活性炭は残留塩素を除去する一方で抗菌力がないため、ぬるい水槽で細菌が爆発的に増殖します。銀抗菌剤やスケール防止剤を含む微細フィルターが不可欠です。",
    copyReportBtn: "製氷機バイオフィルム診断書をコピー",
    copiedFeedback: "診断レポートをクリップボードにコピーしました！"
  }
};

const d = DICTIONARY[lang] || DICTIONARY.en;
---

<div class="bg-surface border border-hairline rounded-3xl p-6 md:p-10 shadow-xs mb-12">
  <!-- Title / Badge -->
  <div class="flex flex-wrap items-center justify-between gap-3 mb-6 pb-6 border-b border-hairline">
    <div>
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-cyan-500/10 text-cyan-950 border border-cyan-500/20 mb-2">
        <span>🧊</span>
        {d.badge}
      </span>
      <h2 class="text-xl md:text-2xl font-bold text-ink tracking-tight">
        {d.title}
      </h2>
      <p class="text-xs md:text-sm text-muted mt-1 max-w-3xl leading-relaxed">
        {d.subtitle}
      </p>
    </div>
  </div>

  <!-- Presets -->
  <div class="mb-8">
    <div class="text-xs font-bold uppercase tracking-wider text-muted mb-3 flex items-center gap-1.5">
      <span>⚡</span>
      {d.presetsTitle}
    </div>
    <div class="flex flex-wrap gap-2">
      <button type="button" class="preset-btn px-3 py-1.5 text-xs font-medium rounded-xl border border-hairline hover:bg-surface-soft hover:border-cyan-500 transition-all text-ink cursor-pointer" data-preset="nsf-benchmark">
        {d.presetNsfBenchmark}
      </button>
      <button type="button" class="preset-btn px-3 py-1.5 text-xs font-medium rounded-xl border border-hairline hover:bg-surface-soft hover:border-cyan-500 transition-all text-ink cursor-pointer" data-preset="bar-disaster">
        {d.presetBarDisaster}
      </button>
      <button type="button" class="preset-btn px-3 py-1.5 text-xs font-medium rounded-xl border border-hairline hover:bg-surface-soft hover:border-cyan-500 transition-all text-ink cursor-pointer" data-preset="portable-home-trap">
        {d.presetPortableHomeTrap}
      </button>
      <button type="button" class="preset-btn px-3 py-1.5 text-xs font-medium rounded-xl border border-hairline hover:bg-surface-soft hover:border-cyan-500 transition-all text-ink cursor-pointer" data-preset="hospital-flaker">
        {d.presetHospitalFlaker}
      </button>
      <button type="button" class="preset-btn px-3 py-1.5 text-xs font-medium rounded-xl border border-hairline hover:bg-surface-soft hover:border-cyan-500 transition-all text-ink cursor-pointer" data-preset="silver-block-protection">
        {d.presetSilverBlockProtection}
      </button>
    </div>
  </div>

  <!-- Controls Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-10 bg-surface-soft/60 border border-hairline rounded-2xl p-6">
    <!-- Machine Architecture -->
    <div>
      <label for="architecture-select" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5">
        {d.architectureLabel}
      </label>
      <select id="architecture-select" class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-sm font-medium text-ink focus:outline-none focus:ring-2 focus:ring-cyan-500">
        {modelData.machineArchitectures.map(a => (
          <option value={a.id} selected={a.id === 'modular-vertical-grid'}>
            {a.name}
          </option>
        ))}
      </select>
      <p class="text-[11px] text-muted mt-1 leading-snug">{d.architectureHelp}</p>
    </div>

    <!-- Sanitation Level -->
    <div>
      <label for="sanitation-select" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5">
        {d.sanitationLabel}
      </label>
      <select id="sanitation-select" class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-sm font-medium text-ink focus:outline-none focus:ring-2 focus:ring-cyan-500">
        {modelData.sanitationMaintenanceLevels.map(s => (
          <option value={s.id} selected={s.id === 'monthly-standard-clean'}>
            {s.name}
          </option>
        ))}
      </select>
      <p class="text-[11px] text-muted mt-1 leading-snug">{d.sanitationHelp}</p>
    </div>

    <!-- Ambient Environment -->
    <div>
      <label for="environment-select" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5">
        {d.environmentLabel}
      </label>
      <select id="environment-select" class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-sm font-medium text-ink focus:outline-none focus:ring-2 focus:ring-cyan-500">
        {modelData.ambientEnvironmentAirTypes.map(e => (
          <option value={e.id} selected={e.id === 'clean-commercial-kitchen'}>
            {e.name}
          </option>
        ))}
      </select>
      <p class="text-[11px] text-muted mt-1 leading-snug">{d.environmentHelp}</p>
    </div>

    <!-- Water Filtration -->
    <div>
      <label for="filtration-select" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5">
        {d.filtrationLabel}
      </label>
      <select id="filtration-select" class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-sm font-medium text-ink focus:outline-none focus:ring-2 focus:ring-cyan-500">
        {modelData.waterFiltrationProtocols.map(f => (
          <option value={f.id} selected={f.id === 'standard-5micron-carbon'}>
            {f.name}
          </option>
        ))}
      </select>
      <p class="text-[11px] text-muted mt-1 leading-snug">{d.filtrationHelp}</p>
    </div>

    <!-- Daily Ice Volume Slider -->
    <div>
      <div class="flex items-center justify-between mb-1.5">
        <label for="volume-slider" class="text-xs font-bold uppercase tracking-wider text-ink">
          {d.iceVolumeLabel}
        </label>
        <span id="volume-val" class="text-xs font-mono font-bold text-cyan-600 bg-cyan-50 px-2 py-0.5 rounded-md border border-cyan-200">
          120 kg / day
        </span>
      </div>
      <input type="range" id="volume-slider" min="10" max="300" step="5" value="120" class="w-full accent-cyan-600 cursor-pointer" />
      <p class="text-[11px] text-muted mt-1 leading-snug">{d.iceVolumeHelp}</p>
    </div>

    <!-- Daily Ingestion Servings Slider -->
    <div>
      <div class="flex items-center justify-between mb-1.5">
        <label for="servings-slider" class="text-xs font-bold uppercase tracking-wider text-ink">
          {d.consumerServingsLabel}
        </label>
        <span id="servings-val" class="text-xs font-mono font-bold text-cyan-600 bg-cyan-50 px-2 py-0.5 rounded-md border border-cyan-200">
          150 servings
        </span>
      </div>
      <input type="range" id="servings-slider" min="5" max="500" step="5" value="150" class="w-full accent-cyan-600 cursor-pointer" />
      <p class="text-[11px] text-muted mt-1 leading-snug">{d.consumerServingsHelp}</p>
    </div>
  </div>

  <!-- Real-Time Diagnostic Dashboard -->
  <div class="border border-hairline rounded-2xl p-6 bg-surface mb-10 shadow-xs">
    <div class="flex flex-wrap items-center justify-between gap-3 mb-6 pb-4 border-b border-hairline">
      <div>
        <h3 class="text-base md:text-lg font-bold text-ink flex items-center gap-2">
          <span>🔬</span>
          {d.diagnosticTitle}
        </h3>
        <p class="text-xs text-muted">{d.diagnosticSub}</p>
      </div>
      <div id="status-badge" class="px-3 py-1 rounded-full text-xs font-bold tracking-wider uppercase bg-emerald-100 text-emerald-900 border border-emerald-300">
        NSF Compliant / Potable Grade
      </div>
    </div>

    <!-- Diagnostic Score Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
      <!-- 1. HPC Microbial Density -->
      <div class="bg-surface-soft border border-hairline rounded-xl p-4 flex flex-col justify-between">
        <div class="text-[11px] font-bold uppercase tracking-wider text-muted mb-1 flex items-center justify-between">
          <span>{d.cfuPerMlLabel}</span>
          <span class="text-cyan-700">🧫</span>
        </div>
        <div class="my-2">
          <div class="text-2xl md:text-3xl font-extrabold text-ink font-mono tracking-tight">
            <span id="cfu-val">180</span> <span class="text-xs font-normal text-muted">CFU/mL</span>
          </div>
          <div id="cfu-badge" class="inline-block px-2 py-0.5 text-[10px] font-bold rounded mt-1 bg-emerald-100 text-emerald-800">
            Within Potable Limit (&lt;500 CFU/mL)
          </div>
        </div>
        <div class="text-[11px] text-muted">
          EPA Limit: 500 CFU/mL (HPC)
        </div>
      </div>

      <!-- 2. EPS Biofilm Thickness -->
      <div class="bg-surface-soft border border-hairline rounded-xl p-4 flex flex-col justify-between">
        <div class="text-[11px] font-bold uppercase tracking-wider text-muted mb-1 flex items-center justify-between">
          <span>{d.epsThicknessLabel}</span>
          <span class="text-cyan-700">📏</span>
        </div>
        <div class="my-2">
          <div class="text-2xl md:text-3xl font-extrabold text-ink font-mono tracking-tight">
            <span id="eps-val">4.5</span> <span class="text-xs font-normal text-muted">µm</span>
          </div>
          <div id="eps-badge" class="inline-block px-2 py-0.5 text-[10px] font-bold rounded mt-1 bg-emerald-100 text-emerald-800">
            Initial Conditioning Film
          </div>
        </div>
        <div class="text-[11px] text-muted">
          Sloughing Threshold: &gt;30.0 µm
        </div>
      </div>

      <!-- 3. Legionella & Mold Hazard -->
      <div class="bg-surface-soft border border-hairline rounded-xl p-4 flex flex-col justify-between">
        <div class="text-[11px] font-bold uppercase tracking-wider text-muted mb-1 flex items-center justify-between">
          <span>{d.legionellaRiskLabel}</span>
          <span class="text-cyan-700">⚠️</span>
        </div>
        <div class="my-2">
          <div class="text-2xl md:text-3xl font-extrabold text-ink font-mono tracking-tight">
            <span id="legionella-val">Low</span>
          </div>
          <div id="legionella-badge" class="inline-block px-2 py-0.5 text-[10px] font-bold rounded mt-1 bg-emerald-100 text-emerald-800">
            Bacteriostatic State
          </div>
        </div>
        <div class="text-[11px] text-muted">
          Aerosol Dose: &lt;100 CFU/m³
        </div>
      </div>

      <!-- 4. EPA Exceedance Ratio -->
      <div class="bg-surface-soft border border-hairline rounded-xl p-4 flex flex-col justify-between">
        <div class="text-[11px] font-bold uppercase tracking-wider text-muted mb-1 flex items-center justify-between">
          <span>{d.epaExceedanceLabel}</span>
          <span class="text-cyan-700">⚖️</span>
        </div>
        <div class="my-2">
          <div class="text-2xl md:text-3xl font-extrabold text-ink font-mono tracking-tight">
            <span id="epa-ratio-val">0.4x</span>
          </div>
          <div id="epa-ratio-badge" class="inline-block px-2 py-0.5 text-[10px] font-bold rounded mt-1 bg-emerald-100 text-emerald-800">
            100% Compliant Potable
          </div>
        </div>
        <div class="text-[11px] text-muted">
          Alert Level: &gt;2.0x EPA Limit
        </div>
      </div>
    </div>

    <!-- Bio-Aerosol Generation Progress Bar -->
    <div class="mb-6 p-4 rounded-xl bg-surface-soft border border-hairline">
      <div class="flex items-center justify-between text-xs font-bold text-ink mb-1.5">
        <span class="flex items-center gap-1.5">
          <span>💨</span>
          {d.bioAerosolRateLabel}:
        </span>
        <span id="aerosol-val" class="font-mono text-cyan-600">42 particles / m³ (Negligible)</span>
      </div>
      <div class="w-full bg-surface rounded-full h-3 border border-hairline overflow-hidden">
        <div id="aerosol-bar" class="bg-cyan-500 h-full rounded-full transition-all duration-300" style="width: 8%;"></div>
      </div>
      <div class="flex justify-between text-[10px] text-muted mt-1 font-mono">
        <span>0 (Pristine)</span>
        <span>250 (Warning Threshold)</span>
        <span>1,000+ CFU/m³ (Infectious Bio-Aerosol Plume)</span>
      </div>
    </div>

    <!-- Clinical Pathology & Action Guidance Box -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="bg-surface-soft border border-hairline rounded-xl p-4">
        <div class="text-xs font-bold text-ink uppercase tracking-wider mb-2 flex items-center gap-1.5">
          <span>🩺</span>
          {d.clinicalSymptomsLabel}
        </div>
        <p id="clinical-text" class="text-xs text-muted leading-relaxed">
          At baseline compliance (&lt;500 CFU/mL), ice melt is safe for general human consumption. No pathogenic gastrointestinal colonization or respiratory Legionellosis risk is detected.
        </p>
      </div>

      <div class="bg-surface-soft border border-hairline rounded-xl p-4">
        <div class="text-xs font-bold text-ink uppercase tracking-wider mb-2 flex items-center gap-1.5">
          <span>🛠️</span>
          {d.actionProtocolLabel}
        </div>
        <p id="action-text" class="text-xs text-muted leading-relaxed">
          Maintain standard monthly maintenance. Inspect plastic water curtain for mineral scales and flush with nickel-safe acid descaler every 30 days.
        </p>
      </div>
    </div>

    <!-- Copy Audit Report Button -->
    <div class="mt-6 pt-4 border-t border-hairline flex items-center justify-between">
      <button type="button" id="copy-btn" class="px-4 py-2 text-xs font-bold rounded-xl bg-cyan-600 hover:bg-cyan-700 text-white transition-all shadow-xs cursor-pointer flex items-center gap-2">
        <span>📋</span>
        <span id="copy-text">{d.copyReportBtn}</span>
      </button>
      <span class="text-xs text-muted font-mono">{d.fdaComplianceLabel}: <strong id="fda-status" class="text-emerald-700 font-bold">COMPLIANT</strong></span>
    </div>
  </div>

  <!-- Comparative Scientific Table -->
  <div class="mb-10">
    <div class="mb-4">
      <h3 class="text-base md:text-lg font-bold text-ink flex items-center gap-2">
        <span>📊</span>
        {d.tableTitle}
      </h3>
      <p class="text-xs text-muted">{d.tableSub}</p>
    </div>
    <div class="overflow-x-auto border border-hairline rounded-2xl">
      <table class="w-full text-left border-collapse text-xs">
        <thead>
          <tr class="bg-surface-soft border-b border-hairline font-bold text-ink">
            <th class="p-3.5">{d.colArchitecture}</th>
            <th class="p-3.5">{d.colSurfaceArea}</th>
            <th class="p-3.5">{d.colFlowRate}</th>
            <th class="p-3.5">{d.colAdhesion}</th>
            <th class="p-3.5">{d.colAerosolization}</th>
            <th class="p-3.5">{d.colMetallurgy}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline">
          {modelData.machineArchitectures.map(m => (
            <tr class="hover:bg-surface-soft/50 transition-colors">
              <td class="p-3.5 font-bold text-ink">{m.name}</td>
              <td class="p-3.5 font-mono text-muted">{m.surfaceAreaCm2} cm²</td>
              <td class="p-3.5 font-mono text-muted">{m.waterFlowRateLitersPerMin} L/min</td>
              <td class="p-3.5 font-mono text-cyan-700 font-semibold">{m.biofilmAdhesionMultiplier}x</td>
              <td class="p-3.5 text-muted">{m.aerosolizationPotential}</td>
              <td class="p-3.5 text-muted">{m.evaporatorMetallurgy}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- 4 Golden Rules Box -->
  <div class="bg-surface-soft/60 border border-hairline rounded-2xl p-6">
    <div class="mb-4">
      <h3 class="text-sm font-bold text-ink uppercase tracking-wider flex items-center gap-1.5">
        <span>🛡️</span>
        {d.rulesTitle}
      </h3>
      <p class="text-xs text-muted">{d.rulesSub}</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="bg-surface border border-hairline rounded-xl p-4">
        <h4 class="text-xs font-bold text-cyan-950 uppercase tracking-wider mb-1 flex items-center gap-1">
          <span>1.</span> {d.rule1Title}
        </h4>
        <p class="text-xs text-muted leading-relaxed">{d.rule1Text}</p>
      </div>
      <div class="bg-surface border border-hairline rounded-xl p-4">
        <h4 class="text-xs font-bold text-cyan-950 uppercase tracking-wider mb-1 flex items-center gap-1">
          <span>2.</span> {d.rule2Title}
        </h4>
        <p class="text-xs text-muted leading-relaxed">{d.rule2Text}</p>
      </div>
      <div class="bg-surface border border-hairline rounded-xl p-4">
        <h4 class="text-xs font-bold text-cyan-950 uppercase tracking-wider mb-1 flex items-center gap-1">
          <span>3.</span> {d.rule3Title}
        </h4>
        <p class="text-xs text-muted leading-relaxed">{d.rule3Text}</p>
      </div>
      <div class="bg-surface border border-hairline rounded-xl p-4">
        <h4 class="text-xs font-bold text-cyan-950 uppercase tracking-wider mb-1 flex items-center gap-1">
          <span>4.</span> {d.rule4Title}
        </h4>
        <p class="text-xs text-muted leading-relaxed">{d.rule4Text}</p>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ modelData, dict: d }}>
  // Interactive client-side simulation logic
  const archSelect = document.getElementById('architecture-select');
  const sanitSelect = document.getElementById('sanitation-select');
  const envSelect = document.getElementById('environment-select');
  const filtSelect = document.getElementById('filtration-select');
  const volSlider = document.getElementById('volume-slider');
  const volVal = document.getElementById('volume-val');
  const servSlider = document.getElementById('servings-slider');
  const servVal = document.getElementById('servings-val');

  const cfuVal = document.getElementById('cfu-val');
  const cfuBadge = document.getElementById('cfu-badge');
  const epsVal = document.getElementById('eps-val');
  const epsBadge = document.getElementById('eps-badge');
  const legionellaVal = document.getElementById('legionella-val');
  const legionellaBadge = document.getElementById('legionella-badge');
  const epaRatioVal = document.getElementById('epa-ratio-val');
  const epaRatioBadge = document.getElementById('epa-ratio-badge');
  const statusBadge = document.getElementById('status-badge');
  const aerosolVal = document.getElementById('aerosol-val');
  const aerosolBar = document.getElementById('aerosol-bar');
  const clinicalText = document.getElementById('clinical-text');
  const actionText = document.getElementById('action-text');
  const fdaStatus = document.getElementById('fda-status');
  const copyBtn = document.getElementById('copy-btn');
  const copyText = document.getElementById('copy-text');

  function calculateSimulation() {
    const archId = archSelect.value;
    const sanitId = sanitSelect.value;
    const envId = envSelect.value;
    const filtId = filtSelect.value;
    const volume = parseFloat(volSlider.value);
    const servings = parseFloat(servSlider.value);

    volVal.textContent = `${volume} kg / day`;
    servVal.textContent = `${servings} servings`;

    const archObj = modelData.machineArchitectures.find(a => a.id === archId) || modelData.machineArchitectures[0];
    const sanitObj = modelData.sanitationMaintenanceLevels.find(s => s.id === sanitId) || modelData.sanitationMaintenanceLevels[0];
    const envObj = modelData.ambientEnvironmentAirTypes.find(e => e.id === envId) || modelData.ambientEnvironmentAirTypes[0];
    const filtObj = modelData.waterFiltrationProtocols.find(f => f.id === filtId) || modelData.waterFiltrationProtocols[0];

    // Mathematical modeling of biofilm kinetics:
    // Base CFU/mL modulated by architecture adhesion, airborne yeast loading factor, and filtration efficacy
    const filtrationSurvivalMultiplier = (100 - filtObj.bacterialReductionPercent) / 100;
    // For unfiltered hard water, minerals accelerate attachment by 1.4x
    const filtrationScaleFactor = filtId === 'unfiltered-hard-tap' ? 1.4 : (filtId === 'submicron-silver-block' ? 0.35 : 1.0);

    const calculatedCfu = Math.round(
      sanitObj.hpcBaselineCfuPerMl *
      archObj.biofilmAdhesionMultiplier *
      envObj.airborneYeastMoldFactor *
      filtrationScaleFactor
    );

    // EPS Matrix thickness in microns
    const calculatedEps = Math.round(
      (sanitObj.epsThicknessMicrons * archObj.biofilmAdhesionMultiplier * (envObj.airborneYeastMoldFactor * 0.8) * filtrationScaleFactor) * 10
    ) / 10;

    // EPA Potable Drinking Water Benchmark ratio (500 CFU/mL)
    const epaRatio = Math.round((calculatedCfu / modelData.microbialBenchmarks.epaDrinkingWaterMaxCfuPerMl) * 10) / 10;

    // Bio-aerosol generation during hot-gas harvest or fan cycle (CFU/m3 air)
    const aerosolGenerationRate = Math.round(
      calculatedCfu * 0.12 * archObj.shearDetachmentFactor
    );

    // Update display values
    cfuVal.textContent = calculatedCfu.toLocaleString();
    epsVal.textContent = calculatedEps.toFixed(1);
    epaRatioVal.textContent = `${epaRatio}x`;
    aerosolVal.textContent = `${aerosolGenerationRate.toLocaleString()} particles / m³ (${aerosolGenerationRate > 250 ? 'Significant Aerosol Risk' : 'Low Emission'})`;

    const barPercent = Math.min(100, Math.round((aerosolGenerationRate / 1000) * 100));
    aerosolBar.style.width = `${Math.max(5, barPercent)}%`;

    // Visual classes and status badge updates
    if (calculatedCfu < 500) {
      statusBadge.textContent = "NSF Compliant / Potable Grade";
      statusBadge.className = "px-3 py-1 rounded-full text-xs font-bold tracking-wider uppercase bg-emerald-100 text-emerald-900 border border-emerald-300";
      cfuBadge.textContent = "Within Potable Limit (<500 CFU/mL)";
      cfuBadge.className = "inline-block px-2 py-0.5 text-[10px] font-bold rounded mt-1 bg-emerald-100 text-emerald-800";
      epsBadge.textContent = "Passivated / Conditioning Film";
      epsBadge.className = "inline-block px-2 py-0.5 text-[10px] font-bold rounded mt-1 bg-emerald-100 text-emerald-800";
      legionellaVal.textContent = "Low";
      legionellaBadge.textContent = "Negligible Colonization";
      legionellaBadge.className = "inline-block px-2 py-0.5 text-[10px] font-bold rounded mt-1 bg-emerald-100 text-emerald-800";
      epaRatioBadge.textContent = "100% Compliant Potable";
      epaRatioBadge.className = "inline-block px-2 py-0.5 text-[10px] font-bold rounded mt-1 bg-emerald-100 text-emerald-800";
      fdaStatus.textContent = "COMPLIANT";
      fdaStatus.className = "text-emerald-700 font-bold";
      aerosolBar.className = "bg-emerald-500 h-full rounded-full transition-all duration-300";
      clinicalText.textContent = "At baseline compliance (<500 CFU/mL), ice melt is bacteriologically safe for general human consumption. Zero mucosal irritation or gastrointestinal pathology expected.";
      actionText.textContent = "Maintain regular monthly routine cleaning. Check water curtain for lime scale and flush with nickel-safe descaler every 30 days.";
    } else if (calculatedCfu < 5000) {
      statusBadge.textContent = "Sanitary Warning / Active Slime Layer";
      statusBadge.className = "px-3 py-1 rounded-full text-xs font-bold tracking-wider uppercase bg-amber-100 text-amber-900 border border-amber-300";
      cfuBadge.textContent = "Exceeds Potable Standard (1x–10x)";
      cfuBadge.className = "inline-block px-2 py-0.5 text-[10px] font-bold rounded mt-1 bg-amber-100 text-amber-800";
      epsBadge.textContent = "Active Extracellular Slime";
      epsBadge.className = "inline-block px-2 py-0.5 text-[10px] font-bold rounded mt-1 bg-amber-100 text-amber-800";
      legionellaVal.textContent = "Moderate";
      legionellaBadge.textContent = "Psychrophilic Mold Growth";
      legionellaBadge.className = "inline-block px-2 py-0.5 text-[10px] font-bold rounded mt-1 bg-amber-100 text-amber-800";
      epaRatioBadge.textContent = `${epaRatio}x EPA Max Potable Limit`;
      epaRatioBadge.className = "inline-block px-2 py-0.5 text-[10px] font-bold rounded mt-1 bg-amber-100 text-amber-800";
      fdaStatus.textContent = "PROVISIONAL WARNING";
      fdaStatus.className = "text-amber-700 font-bold";
      aerosolBar.className = "bg-amber-500 h-full rounded-full transition-all duration-300";
      clinicalText.textContent = `Moderate microbial burden (${calculatedCfu} CFU/mL). Sloughing Pseudomonas and Cladosporium mold spores cause stale, musty ice taste and can trigger mild gastrointestinal upset or nausea in immunocompromised consumers across ${servings} daily servings.`;
      actionText.textContent = "Immediate intervention required within 48 hours. Discard all ice in storage bin. Disassemble splash curtain and run complete acid descaling followed by 200 ppm EPA biocide flush.";
    } else {
      statusBadge.textContent = "Critical Biohazard / Immediate Shutdown";
      statusBadge.className = "px-3 py-1 rounded-full text-xs font-bold tracking-wider uppercase bg-rose-100 text-rose-900 border border-rose-300";
      cfuBadge.textContent = `Severe Microbial Spikes (${calculatedCfu.toLocaleString()} CFU/mL)`;
      cfuBadge.className = "inline-block px-2 py-0.5 text-[10px] font-bold rounded mt-1 bg-rose-100 text-rose-800";
      epsBadge.textContent = `Mature Macroscopic Slime (${calculatedEps} µm)`;
      epsBadge.className = "inline-block px-2 py-0.5 text-[10px] font-bold rounded mt-1 bg-rose-100 text-rose-800";
      legionellaVal.textContent = "CRITICAL HIGH";
      legionellaBadge.textContent = "Legionella / Black Mold Hazard";
      legionellaBadge.className = "inline-block px-2 py-0.5 text-[10px] font-bold rounded mt-1 bg-rose-100 text-rose-800";
      epaRatioBadge.textContent = `${epaRatio}x EPA Violation`;
      epaRatioBadge.className = "inline-block px-2 py-0.5 text-[10px] font-bold rounded mt-1 bg-rose-100 text-rose-800";
      fdaStatus.textContent = "VIOLATION (4-602.11)";
      fdaStatus.className = "text-rose-700 font-bold";
      aerosolBar.className = "bg-rose-600 h-full rounded-full transition-all duration-300";
      clinicalText.textContent = `CRITICAL HEALTH HAZARD: Ice melt contains macroscopic bacterial/mold aggregates (${calculatedCfu.toLocaleString()} CFU/mL). Exophiala jeanselmei black yeast, Listeria, and Legionella pneumophila pose acute risks of infectious gastroenteritis, respiratory Pontiac fever, and severe illness in vulnerable populations.`;
      actionText.textContent = "LOCKOUT-TAGOUT PROCEDURE: Cease ice distribution immediately. Discard all ice. Execute full mechanical teardown, physical wire-brush scrubbing of evaporator and tubing, double acid descaling, chlorine dioxide sterilization, and replace water filter.";
    }
  }

  // Event Listeners
  [archSelect, sanitSelect, envSelect, filtSelect].forEach(el => el.addEventListener('change', calculateSimulation));
  [volSlider, servSlider].forEach(el => el.addEventListener('input', calculateSimulation));

  // Presets
  document.querySelectorAll('.preset-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const preset = btn.getAttribute('data-preset');
      if (preset === 'nsf-benchmark') {
        archSelect.value = 'modular-vertical-grid';
        sanitSelect.value = 'weekly-biocide-nsf';
        envSelect.value = 'clean-commercial-kitchen';
        filtSelect.value = 'submicron-silver-block';
        volSlider.value = 150;
        servSlider.value = 200;
      } else if (preset === 'bar-disaster') {
        archSelect.value = 'undercounter-bar-beverage';
        sanitSelect.value = 'neglected-90-days';
        envSelect.value = 'high-yeast-brewery-bakery';
        filtSelect.value = 'standard-5micron-carbon';
        volSlider.value = 80;
        servSlider.value = 250;
      } else if (preset === 'portable-home-trap') {
        archSelect.value = 'domestic-countertop-portable';
        sanitSelect.value = 'abandoned-180-days';
        envSelect.value = 'domestic-open-kitchen';
        filtSelect.value = 'unfiltered-hard-tap';
        volSlider.value = 12;
        servSlider.value = 25;
      } else if (preset === 'hospital-flaker') {
        archSelect.value = 'flaker-nugget-auger';
        sanitSelect.value = 'abandoned-180-days';
        envSelect.value = 'humid-unventilated-basement';
        filtSelect.value = 'standard-5micron-carbon';
        volSlider.value = 200;
        servSlider.value = 400;
      } else if (preset === 'silver-block-protection') {
        archSelect.value = 'modular-vertical-grid';
        sanitSelect.value = 'monthly-standard-clean';
        envSelect.value = 'clean-commercial-kitchen';
        filtSelect.value = 'submicron-silver-block';
        volSlider.value = 100;
        servSlider.value = 120;
      }
      calculateSimulation();
    });
  });

  // Copy Report
  copyBtn.addEventListener('click', () => {
    const reportText = `[IsItKitchenSafe Commercial Ice Machine Biofilm & Legionella Audit Report]
Machine Architecture: ${archSelect.options[archSelect.selectedIndex].text}
Sanitation Frequency: ${sanitSelect.options[sanitSelect.selectedIndex].text}
Ambient Air Environment: ${envSelect.options[envSelect.selectedIndex].text}
Water Filtration: ${filtSelect.options[filtSelect.selectedIndex].text}
Daily Ice Volume: ${volSlider.value} kg/day | Daily Servings: ${servSlider.value}
------------------------------------------------------------
• Predicted Microbial Density: ${cfuVal.textContent} CFU/mL
• EPS Biofilm Matrix Thickness: ${epsVal.textContent} µm
• Legionella & Mold Hazard Tier: ${legionellaVal.textContent}
• EPA Potable Water Ratio: ${epaRatioVal.textContent}
• Bio-Aerosol Generation: ${aerosolVal.textContent}
• FDA 4-602.11 Compliance: ${fdaStatus.textContent}
• Clinical Risk: ${clinicalText.textContent}
• Decontamination Action: ${actionText.textContent}`;

    navigator.clipboard.writeText(reportText).then(() => {
      copyText.textContent = dict.copiedFeedback;
      setTimeout(() => {
        copyText.textContent = dict.copyReportBtn;
      }, 3000);
    });
  });

  // Initial Run
  calculateSimulation();
</script>
