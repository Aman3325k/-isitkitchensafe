        percarbonate: 'Percarbonato',
        surfactants: 'Tensoativos',
        completeInact: 'Inativação Completa',
        inadequateInact: 'Inativação (Insuficiente)',
        pillPass: 'CONFORME NSF 184',
        statusPass: 'APROVADO',
        passRisk: (target, name) => `A pasteurização térmica e a oxidação química superaram a meta clínica de ${target}-log. O micro-organismo (${name}) foi reduzido a níveis não infecciosos sem risco de contaminação cruzada.`,
        pillFail: 'HIGIENIZAÇÃO INSUFICIENTE',
