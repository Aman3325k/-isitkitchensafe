    }
  },
  ja: {
    cycles: {
      'eco-light': { name: 'エコ・節電コース (40°C–46°C・ヒーター乾燥なし)', description: '熱による殺菌効果は極めて低く、物理的なすすぎ希釈に依存します。ノロウイルスや強固なバイオフィルムには無効です。' },
      'normal-unheated': { name: '標準コース (49°C–54°C・送風乾燥)', description: '家庭用標準コース。軽微な栄養細胞菌は2–3 log程度減らせますが、ノロウイルスや乾燥タンパク汚れには不十分です。' },
