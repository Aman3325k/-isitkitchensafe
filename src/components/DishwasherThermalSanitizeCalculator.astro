      'commercial-high-temp': { name: '業務用高温食器洗浄機 (NSF/ANSI 3：最終すすぎ 82°C)', description: '飲食店向け高温機。60〜90秒の短時間で瞬間的な熱殺菌を達成します。' }
    },
    pathogens: {
      'norovirus-gii4': { name: 'ヒトノロウイルス (GII.4) / ネズミノロウイルス', microbeType: 'ノンエンベロープRNAウイルス', clinicalRisk: '急性ウイルス性胃腸炎。18〜100個で感染する強固なカプシドを持ち、中性洗剤や胃酸に耐性を示します。' },
      'salmonella-enterica': { name: 'サルモネラ菌 (生鶏肉・生卵由来)', microbeType: 'グラム陰性桿菌', clinicalRisk: 'サルモネラ食中毒、激しい胃腸炎、発熱、乳幼児・高齢者の菌血症リスク。' },
      'listeria-monocytogenes': { name: 'リステリア菌 (加工肉・乳製品由来)', microbeType: 'グラム陽性低温増殖菌', clinicalRisk: '侵襲性リステリア症、髄膜炎、妊婦・胎児敗血症（致死率が高い）。' },
