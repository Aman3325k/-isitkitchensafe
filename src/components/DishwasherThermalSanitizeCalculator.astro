      'salmonella-enterica': { name: '肠炎沙门氏菌 (生禽肉与鸡蛋污染物)', microbeType: '革兰氏阴性杆菌', clinicalRisk: '导致沙门氏菌食物中毒、高热腹泻，婴幼儿及老人易并发菌血症。' },
      'listeria-monocytogenes': { name: '单增李斯特菌 (即食肉类与乳制品污染物)', microbeType: '革兰氏阳性耐冷菌', clinicalRisk: '引起侵袭性李斯特菌病、脑膜炎及孕妇流产败血症，致死率较高。' },
