        failRisk: (target, name) => `AVISO: O ciclo não atingiu a redução clínica de ${target}-log. Patógenos viáveis (${name}) podem permanecer nos pratos e talheres. Selecione o ciclo Sanitize certificado ou detergente com percarbonato.`
      },
      'zh-cn': {
        minUnit: '分钟',
        minShort: '分钟',
        secShort: '秒',
        moreThan1000: '> 1,000 分钟',
        sporeKillPct: '0.00% 致死率（完全无效）',
        chemImmune: '+0.0 Log（芽孢免疫）',
        failAutoclave: '未达标（需 121°C 高压灭菌锅）',
        pillSporeFail: '灭菌失败警示',
        sporeAlert: '严重食品安全警示：肉毒杆菌（Clostridium botulinum）内生芽孢可完整耐受所有家用及商用洗碗机高温程序。洗碗机不具备 121°C（15 PSI）高压蒸汽条件。严禁使用洗碗机对自制低酸性罐头玻璃瓶进行灭菌！',
        percarbonate: '过碳酸钠',
        surfactants: '表活剂',
