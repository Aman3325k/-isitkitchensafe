      'enterococcus-faecium': { name: 'エンテロコッカス・フェシウム (NSF 184 公式指標菌)', microbeType: '耐熱性グラム陽性指標菌', clinicalRisk: '家庭用食洗機のSanitize認証試験において5-log死滅を検証する公式耐熱指標菌です。' },
      'clostridium-spores': { name: 'ボツリヌス菌・セレウス菌芽胞 (保存瓶滅菌の誤信検証)', microbeType: '細菌内生芽胞', clinicalRisk: '100°Cの煮沸でも生存し、食洗機では一切死滅しません。低酸性保存食には121°Cの圧力釜が必要です。' }
    },
    detergents: {
      'alkaline-powder-percarbonate': { name: '過炭酸ナトリウム配合 強アルカリ粉末・ジェルタブ (pH 10.5–11.5)', description: '50°C以上で過酸化水素を放出し、ウイルスのタンパク殻を酸化分解する強力な化学相乗効果を発揮します。' },
      'standard-liquid-gel': { name: '酵素配合 標準液体・ジェル洗剤 (pH 8.0–9.0・漂白剤なし)', description: 'デンプンやタンパク質分解に優れますが酸化剤を含まず、除菌の90%以上を水温に依存します。' },
      'eco-plant-neutral': { name: '植物系エコ中性洗剤 (pH 7.0–7.8・無漂白)', description: 'マイルドな界面活性剤のみで酸化作用がなく、除菌の98%が熱水の温度のみに依存します。' }
    },
    soils: {
      'clean-prerinse': { name: '予洗い済み・軽微な汚れ (温水直接接触)', description: '汚れのバリアがなく、高温水と洗剤が微生物に直接作用します。' },
      'grease-fat-film': { name: '動物性油脂・油膜 (疎水性バリア)', description: '油膜が熱と洗剤の浸透を妨げ、病原体の熱死滅所要時間を50%延長させます。' },
      'dried-protein-starch': { name: '乾燥卵・チーズ・デンプン固着 (カプセル保護)', description: '乾燥したタンパク被膜が熱とアルカリから病原体を遮蔽します。' }
    },
    hydraulics: {
      'optimal-spacing': { name: '適正間隔配置・ノズル回転良好 (100% 噴射)', description: 'ノズルが障害なく回転し、全食器表面に定格温度の高圧水流が届きます。' },
      'overcrowded-nesting': { name: '重ね置き・詰め込み過ぎ (水流シャドウゾーン)', description: '重なった深皿が水流を遮断し、局所温度が約5°C低下します。' },
      'stalled-spray-arm': { name: '高いまな板・お玉等で下部ノズルが回転停止', description: 'ノズルが止まると食器の70%が冷たい死角（12°C低下）に置かれ、除菌効果が失われます。' }
    }
  }
};

function getLocCycle(c: any) {
  const tr = ITEM_I18N[lang]?.cycles?.[c.id];
  return tr ? { ...c, ...tr } : c;
}
function getLocPathogen(p: any) {
  const tr = ITEM_I18N[lang]?.pathogens?.[p.id];
  return tr ? { ...p, ...tr } : p;
}
function getLocDetergent(det: any) {
  const tr = ITEM_I18N[lang]?.detergents?.[det.id];
  return tr ? { ...det, ...tr } : det;
}
function getLocSoil(s: any) {
  const tr = ITEM_I18N[lang]?.soils?.[s.id];
  return tr ? { ...s, ...tr } : s;
}
function getLocHydraulic(h: any) {
  const tr = ITEM_I18N[lang]?.hydraulics?.[h.id];
  return tr ? { ...h, ...tr } : h;
}

const d = DICTIONARY[lang] || DICTIONARY.en;
const localizedCycles = sanitizeData.cycleTypes.map(getLocCycle);
const localizedPathogens = sanitizeData.pathogens.map(getLocPathogen);
const localizedDetergents = sanitizeData.detergentFormulations.map(getLocDetergent);
const localizedSoils = sanitizeData.soilShieldingMatrices.map(getLocSoil);
const localizedHydraulics = sanitizeData.hydraulicLoadFactors.map(getLocHydraulic);
---

<div class="bg-surface-soft border border-hairline rounded-3xl p-6 md:p-10 shadow-xs my-8" id="dishwasher-sanitize-calc-app" data-lang={lang}>
  <!-- Badge & Header -->
  <div class="mb-8">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-emerald-100 text-emerald-950 mb-3 border border-emerald-200">
      <span class="w-2 h-2 rounded-full bg-emerald-600 animate-pulse"></span>
      {d.badge}
    </div>
    <h2 class="text-2xl md:text-3xl font-bold text-ink tracking-tight mb-2">
      {d.title}
    </h2>
    <p class="text-sm md:text-base text-muted leading-relaxed">
      {d.subtitle}
    </p>
  </div>

  <!-- Presets Strip -->
  <div class="mb-8 bg-surface-strong/40 border border-hairline rounded-2xl p-4">
    <div class="text-xs font-bold uppercase tracking-wider text-muted mb-3 flex items-center gap-2">
      <span>⚡</span>
      {d.presetsTitle}
    </div>
    <div class="flex flex-wrap gap-2">
      <button 
        type="button" 
        class="preset-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-canvas hover:bg-surface-strong border border-hairline text-ink transition-colors cursor-pointer"
        data-preset="preset-gastro-outbreak"
      >
        🦠 {d.presetGastro}
      </button>
      <button 
        type="button" 
        class="preset-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-canvas hover:bg-surface-strong border border-hairline text-ink transition-colors cursor-pointer"
        data-preset="preset-raw-chicken-eco"
      >
        🍗 {d.presetRawChicken}
      </button>
      <button 
        type="button" 
        class="preset-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-canvas hover:bg-surface-strong border border-hairline text-ink transition-colors cursor-pointer"
        data-preset="preset-baby-bottles-sanitize"
      >
        🍼 {d.presetBabyBottles}
      </button>
      <button 
        type="button" 
        class="preset-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-canvas hover:bg-surface-strong border border-hairline text-ink transition-colors cursor-pointer"
        data-preset="preset-nested-bowls-normal"
      >
        🥣 {d.presetNestedBowls}
      </button>
      <button 
        type="button" 
        class="preset-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-canvas hover:bg-surface-strong border border-hairline text-ink transition-colors cursor-pointer"
        data-preset="preset-spore-myth"
      >
        ⚠️ {d.presetSporeMyth}
      </button>
    </div>
  </div>

  <!-- Main Grid: Controls + Live Diagnostic Scorecard -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mb-12">
    <!-- Controls Column (7 cols) -->
    <div class="lg:col-span-7 space-y-6">
      <div class="border-b border-hairline pb-3">
        <h3 class="text-lg font-bold text-ink flex items-center gap-2">
          <span>🎛️</span>
          {d.controlsTitle}
        </h3>
        <p class="text-xs text-muted">{d.controlsSub}</p>
      </div>

      <!-- 1. Cycle Selector -->
      <div>
        <label for="ds-cycle" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-1.5">
          {d.cycleLabel}
        </label>
        <select 
          id="ds-cycle" 
          class="w-full bg-canvas border border-hairline rounded-xl px-3.5 py-2.5 text-sm text-ink focus:outline-hidden focus:ring-2 focus:ring-emerald-500 font-medium cursor-pointer"
        >
          {localizedCycles.map(c => (
            <option value={c.id} selected={c.id === 'nsf-184-sanitize'}>
              {c.name}
            </option>
          ))}
        </select>
        <p class="text-xs text-muted mt-1" id="ds-cycle-desc">
          {localizedCycles.find(c => c.id === 'nsf-184-sanitize')?.description}
        </p>
      </div>

      <!-- 2. Pathogen Selector -->
      <div>
        <label for="ds-pathogen" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-1.5">
          {d.pathogenLabel}
        </label>
        <select 
          id="ds-pathogen" 
          class="w-full bg-canvas border border-hairline rounded-xl px-3.5 py-2.5 text-sm text-ink focus:outline-hidden focus:ring-2 focus:ring-emerald-500 font-medium cursor-pointer"
        >
          {localizedPathogens.map(p => (
            <option value={p.id} selected={p.id === 'norovirus-gii4'}>
              {p.name} [{p.microbeType}]
            </option>
          ))}
        </select>
        <p class="text-xs text-muted mt-1" id="ds-pathogen-desc">
          {localizedPathogens.find(p => p.id === 'norovirus-gii4')?.clinicalRisk}
        </p>
      </div>

      <!-- 3. Detergent Chemistry Selector -->
      <div>
        <label for="ds-detergent" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-1.5">
          {d.detergentLabel}
        </label>
        <select 
          id="ds-detergent" 
          class="w-full bg-canvas border border-hairline rounded-xl px-3.5 py-2.5 text-sm text-ink focus:outline-hidden focus:ring-2 focus:ring-emerald-500 font-medium cursor-pointer"
        >
          {localizedDetergents.map(det => (
            <option value={det.id} selected={det.id === 'alkaline-powder-percarbonate'}>
              {det.name}
            </option>
          ))}
        </select>
        <p class="text-xs text-muted mt-1" id="ds-detergent-desc">
          {localizedDetergents.find(det => det.id === 'alkaline-powder-percarbonate')?.description}
        </p>
      </div>

      <!-- Two-col: Soil Matrix + Hydraulic Spacing -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Soil Matrix -->
        <div>
          <label for="ds-soil" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-1.5">
            {d.soilLabel}
          </label>
          <select 
            id="ds-soil" 
            class="w-full bg-canvas border border-hairline rounded-xl px-3 py-2 text-xs text-ink focus:outline-hidden focus:ring-2 focus:ring-emerald-500 font-medium cursor-pointer"
          >
            {localizedSoils.map(s => (
              <option value={s.id} selected={s.id === 'clean-prerinse'}>
                {s.name}
              </option>
            ))}
          </select>
        </div>

        <!-- Hydraulic Spacing -->
        <div>
          <label for="ds-hydraulic" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-1.5">
            {d.hydraulicLabel}
          </label>
          <select 
            id="ds-hydraulic" 
            class="w-full bg-canvas border border-hairline rounded-xl px-3 py-2 text-xs text-ink focus:outline-hidden focus:ring-2 focus:ring-emerald-500 font-medium cursor-pointer"
          >
            {localizedHydraulics.map(h => (
              <option value={h.id} selected={h.id === 'optimal-spacing'}>
                {h.name}
              </option>
            ))}
          </select>
        </div>
      </div>

      <!-- Live Dwell Time Fine-Tune Slider -->
      <div class="bg-canvas border border-hairline rounded-xl p-4 space-y-2">
        <div class="flex items-center justify-between text-xs">
          <span class="font-semibold text-ink">{d.dwellLabel}</span>
          <span class="font-mono text-emerald-800 font-bold" id="ds-dwell-val">14 {d.minShort}</span>
        </div>
        <input 
          type="range" 
          id="ds-dwell-slider" 
          min="1" 
          max="30" 
          step="1" 
          value="14" 
          class="w-full accent-emerald-600 cursor-pointer"
        />
        <div class="flex justify-between text-[10px] text-muted font-mono">
          <span>{d.dwellMin1}</span>
          <span>{d.dwellMin14}</span>
