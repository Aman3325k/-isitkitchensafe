    rule4Text: "微生物在洗涤完成后若想继续增殖，必须依赖游离水（水分活度 a_w > 0.85）。液体光亮剂（漂洗剂）能大幅降低水分子表面张力，使水流呈薄膜状快速滑落。餐具在几分钟内彻底干燥，剥夺残留细菌在密闭潮湿箱体内形成生物膜的水分条件。",
    copyReportBtn: "📋 复制消杀评估报告",
    copiedFeedback: "✓ 消杀评估报告已复制至剪贴板！"
  },
  ja: {
    badge: "微生物学＆NSF/ANSI 184 食器洗浄衛生工学モデラー",
    title: "食洗機熱消毒・ノロウイルス致死率計算シミュレーター",
    subtitle: "熱力学と微生物死滅速度論（Bigelowモデル）に基づき、食洗機の温度・滞留時間、D値対数減少率、酸素系漂白剤シナジー、芽胞耐熱限界を算出します。",
    controlsTitle: "食洗機洗浄プログラムと微生物汚染パラメータ設定",
    controlsSub: "洗浄・すすぎ温度プロファイル、対象病原菌・ウイルス、洗剤の化学的酸化能、有機物汚れシールド、ノズル水力条件を設定します。",
    cycleLabel: "食洗機コースと運転温度：",
    cycleHelp: "洗浄温度、高温すすぎ保持時間、ヒーター乾燥の有無を選択します。",
    pathogenLabel: "対象微生物または指標菌：",
    pathogenHelp: "固有の耐熱性（D値・z値）を持つ細菌、ウイルス、芽胞を選択します。",
    detergentLabel: "洗剤の化学組成と活性酸素成分：",
    detergentHelp: "過炭酸ナトリウム配合粉末/ジェルタブ vs 酵素のみ中性液体洗剤。",
    soilLabel: "有機物汚れ・食品残渣シールド：",
    soilHelp: "予洗い済み平滑面 vs 油脂疎水性皮膜 vs 乾燥卵・デンプン被膜。",
    hydraulicLabel: "回転ノズルと食器の配置工況：",
    hydraulicHelp: "全方位直接噴射 vs 重ね置きによる死角 vs 障害物によるノズル停止。",
    presetsTitle: "代表的な家庭内シナリオプリセット：",
    presetGastro: "家庭内ノロウイルス胃腸炎発生時（NSF高温除菌コース）",
    presetRawChicken: "生鶏肉を切ったまな板と皿をエコ節電コースで洗浄",
    presetBabyBottles: "乳幼児用哺乳瓶と乳首パーツをNSF除菌コースで洗浄",
    presetNestedBowls: "チーズが乾燥付着した重ね置き皿を標準コースで洗浄",
    presetSporeMyth: "保存食の誤信：ボツリヌス菌芽胞の食洗機滅菌を試行",
    diagnosticTitle: "熱致死率動力学＆衛生安全性診断スコアカード",
    diagnosticSub: "Bigelowモデル対数死滅率のリアルタイム計算、NSF/ANSI 184基準判定、臨床感染リスクの評価。",
    logReductionLabel: "微生物総対数減少率 (Log Reduction)",
    killPercentageLabel: "病原微生物不活化率（致死率％）",
    nsfComplianceLabel: "NSF/ANSI 184 除菌規格判定",
    effectiveTempLabel: "食器表面実効ピーク温度",
    dValueLabel: "ピーク温度での90%死滅時間 (D_T値)",
    chemBoostLabel: "過炭酸ナトリウム化学的死滅ゲイン",
    clinicalRiskLabel: "微生物学的危険度と臨床リスク",
    actionProtocolLabel: "推奨される科学的対処手順",
    mechanicsTitle: "微生物熱死滅速度論と消毒メカニズム",
    mechanicsSub: "家庭用食器洗浄における病原性細菌およびノンエンベロープウイルスの熱分解を支配する計算式。",
    tableTitle: "病原微生物耐熱特性マトリクス（D値およびz値）",
    tableSub: "食中毒起因細菌、腸管系ウイルス、細菌芽胞の耐熱性パラメータ比較。",
    colPathogen: "微生物名",
    colType: "分類",
    colD60: "60°CでのD値 (分)",
    colTargetLog: "NSF/FSIS目標対数",
    colRisk: "臨床的健康影響",
    rulesTitle: "食洗機による衛生除菌の4大鉄則",
    rulesSub: "感染症拡大と二次汚染を防ぐための科学的根拠に基づいた手順。",
    rule1Title: "1. ノロウイルス対策の鉄則：Sanitizeコース＋酸素系漂白粉末洗剤を使用",
    rule1Text: "ヒトノロウイルスはエンベロープを持たない強固なカプシド構造を持ち、40°C–45°Cのエコ洗浄では不活化できません。胃腸炎発症時は、必ずNSF 184認証のSanitizeコース（最終すすぎ68°C–71°C維持）を選択し、過炭酸ナトリウムを含む粉末洗剤を使用してください。高温で発生する過酸化水素ラジカルがカプシドを酸化分解します。",
    rule2Title: "2. ノズル回転の手動点検：運転開始前に必ず手で360度回す",
    rule2Text: "扉を閉める前に、上下のノズルを手で回してください。まな板の角やお玉の柄が引っかかるとノズルが停止し、食器の70%が温水死角（11°C以上の温度低下）となり、除菌効果が完全に喪失します。",
    rule3Title: "3. 細菌芽胞の限界：食洗機は保存瓶の滅菌には使えない",
    rule3Text: "食洗機の除菌機能で手作りジャムやピクルスの瓶を滅菌できるという誤信がありますが、極めて危険です。食洗機は最高でも約71°Cであり、ボツリヌス菌（C. botulinum）の耐熱性芽胞は100°Cの熱湯でも数時間生存します。低酸性食品の瓶詰めには121°Cの圧力釜（圧力鍋）が必須です。",
    rule4Title: "4. リンス剤による急速乾燥：残留水分を奪い細菌の再増殖を防止",
    rule4Text: "洗浄完了後に細菌が増殖するには自由水（水分活性 a_w > 0.85）が必要です。液状リンス剤（乾燥仕上げ剤）は水の表面張力を低下させ、水滴を残さず数分で完全乾燥させます。湿気のある庫内でのバイオフィルム再形成を物理的に遮断します。",
    copyReportBtn: "📋 除菌診断レポートをコピー",
    copiedFeedback: "✓ レポートをクリップボードにコピーしました！"
  }
};

const d = DICTIONARY[lang] || DICTIONARY.en;
---

<div class="bg-surface-soft border border-hairline rounded-3xl p-6 md:p-10 shadow-xs my-8" id="dishwasher-sanitize-calc-app">
  <!-- Badge & Header -->
  <div class="mb-8">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-emerald-100 text-emerald-950 mb-3 border border-emerald-200">
      <span class="w-2 h-2 rounded-full bg-emerald-600 animate-pulse"></span>
      {d.badge}
    </div>
    <h2 class="text-2xl md:text-3xl font-bold text-ink tracking-tight mb-2">
      {d.title}
    </h2>
    <p class="text-sm md:text-base text-muted leading-relaxed">
      {d.subtitle}
    </p>
  </div>

  <!-- Presets Strip -->
  <div class="mb-8 bg-surface-strong/40 border border-hairline rounded-2xl p-4">
    <div class="text-xs font-bold uppercase tracking-wider text-muted mb-3 flex items-center gap-2">
      <span>⚡</span>
      {d.presetsTitle}
    </div>
    <div class="flex flex-wrap gap-2">
      <button 
        type="button" 
        class="preset-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-canvas hover:bg-surface-strong border border-hairline text-ink transition-colors cursor-pointer"
        data-preset="preset-gastro-outbreak"
      >
        🦠 {d.presetGastro}
      </button>
      <button 
        type="button" 
        class="preset-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-canvas hover:bg-surface-strong border border-hairline text-ink transition-colors cursor-pointer"
        data-preset="preset-raw-chicken-eco"
      >
        🍗 {d.presetRawChicken}
      </button>
      <button 
        type="button" 
        class="preset-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-canvas hover:bg-surface-strong border border-hairline text-ink transition-colors cursor-pointer"
        data-preset="preset-baby-bottles-sanitize"
      >
        🍼 {d.presetBabyBottles}
      </button>
      <button 
        type="button" 
        class="preset-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-canvas hover:bg-surface-strong border border-hairline text-ink transition-colors cursor-pointer"
        data-preset="preset-nested-bowls-normal"
      >
        🥣 {d.presetNestedBowls}
      </button>
      <button 
        type="button" 
        class="preset-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-canvas hover:bg-surface-strong border border-hairline text-ink transition-colors cursor-pointer"
        data-preset="preset-spore-myth"
      >
        ⚠️ {d.presetSporeMyth}
      </button>
    </div>
  </div>

  <!-- Main Grid: Controls + Live Diagnostic Scorecard -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mb-12">
    <!-- Controls Column (7 cols) -->
    <div class="lg:col-span-7 space-y-6">
      <div class="border-b border-hairline pb-3">
        <h3 class="text-lg font-bold text-ink flex items-center gap-2">
          <span>🎛️</span>
          {d.controlsTitle}
        </h3>
        <p class="text-xs text-muted">{d.controlsSub}</p>
      </div>

      <!-- 1. Cycle Selector -->
      <div>
        <label for="ds-cycle" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-1.5">
          {d.cycleLabel}
        </label>
        <select 
          id="ds-cycle" 
          class="w-full bg-canvas border border-hairline rounded-xl px-3.5 py-2.5 text-sm text-ink focus:outline-hidden focus:ring-2 focus:ring-emerald-500 font-medium cursor-pointer"
        >
          {sanitizeData.cycleTypes.map(c => (
            <option value={c.id} selected={c.id === 'nsf-184-sanitize'}>
              {c.name}
            </option>
          ))}
        </select>
        <p class="text-xs text-muted mt-1" id="ds-cycle-desc">
          {sanitizeData.cycleTypes.find(c => c.id === 'nsf-184-sanitize')?.description}
        </p>
      </div>

      <!-- 2. Pathogen Selector -->
      <div>
        <label for="ds-pathogen" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-1.5">
          {d.pathogenLabel}
        </label>
        <select 
          id="ds-pathogen" 
          class="w-full bg-canvas border border-hairline rounded-xl px-3.5 py-2.5 text-sm text-ink focus:outline-hidden focus:ring-2 focus:ring-emerald-500 font-medium cursor-pointer"
        >
          {sanitizeData.pathogens.map(p => (
            <option value={p.id} selected={p.id === 'norovirus-gii4'}>
              {p.name} [{p.microbeType}]
            </option>
          ))}
        </select>
        <p class="text-xs text-muted mt-1" id="ds-pathogen-desc">
          {sanitizeData.pathogens.find(p => p.id === 'norovirus-gii4')?.clinicalRisk}
        </p>
      </div>

      <!-- 3. Detergent Chemistry Selector -->
      <div>
        <label for="ds-detergent" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-1.5">
          {d.detergentLabel}
        </label>
        <select 
          id="ds-detergent" 
          class="w-full bg-canvas border border-hairline rounded-xl px-3.5 py-2.5 text-sm text-ink focus:outline-hidden focus:ring-2 focus:ring-emerald-500 font-medium cursor-pointer"
        >
          {sanitizeData.detergentFormulations.map(det => (
            <option value={det.id} selected={det.id === 'alkaline-powder-percarbonate'}>
              {det.name}
            </option>
          ))}
        </select>
        <p class="text-xs text-muted mt-1" id="ds-detergent-desc">
          {sanitizeData.detergentFormulations.find(det => det.id === 'alkaline-powder-percarbonate')?.description}
        </p>
      </div>

      <!-- Two-col: Soil Matrix + Hydraulic Spacing -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Soil Matrix -->
        <div>
          <label for="ds-soil" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-1.5">
            {d.soilLabel}
          </label>
          <select 
            id="ds-soil" 
            class="w-full bg-canvas border border-hairline rounded-xl px-3 py-2 text-xs text-ink focus:outline-hidden focus:ring-2 focus:ring-emerald-500 font-medium cursor-pointer"
          >
            {sanitizeData.soilShieldingMatrices.map(s => (
              <option value={s.id} selected={s.id === 'clean-prerinse'}>
                {s.name}
              </option>
            ))}
          </select>
        </div>

        <!-- Hydraulic Spacing -->
        <div>
          <label for="ds-hydraulic" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-1.5">
            {d.hydraulicLabel}
          </label>
          <select 
            id="ds-hydraulic" 
            class="w-full bg-canvas border border-hairline rounded-xl px-3 py-2 text-xs text-ink focus:outline-hidden focus:ring-2 focus:ring-emerald-500 font-medium cursor-pointer"
          >
            {sanitizeData.hydraulicLoadFactors.map(h => (
              <option value={h.id} selected={h.id === 'optimal-spacing'}>
                {h.name}
              </option>
            ))}
          </select>
        </div>
      </div>

      <!-- Live Dwell Time Fine-Tune Slider -->
      <div class="bg-canvas border border-hairline rounded-xl p-4 space-y-2">
        <div class="flex items-center justify-between text-xs">
          <span class="font-semibold text-ink">Final Rinse Thermal Dwell Adjustment:</span>
          <span class="font-mono text-emerald-800 font-bold" id="ds-dwell-val">14 minutes</span>
        </div>
        <input 
          type="range" 
          id="ds-dwell-slider" 
          min="1" 
          max="30" 
          step="1" 
          value="14" 
          class="w-full accent-emerald-600 cursor-pointer"
        />
        <div class="flex justify-between text-[10px] text-muted font-mono">
          <span>1 min (Quick rinse)</span>
          <span>14 min (NSF 184 Dwell)</span>
          <span>30 min (Commercial soak)</span>
        </div>
      </div>
    </div>

    <!-- Live Diagnostic Scorecard (5 cols) -->
    <div class="lg:col-span-5 bg-canvas border-2 border-hairline rounded-3xl p-6 shadow-sm space-y-6" id="ds-scorecard">
      <div class="border-b border-hairline pb-4 flex items-center justify-between">
        <div>
          <h3 class="text-base font-bold text-ink flex items-center gap-2">
            <span>🔬</span>
            {d.diagnosticTitle}
          </h3>
          <p class="text-xs text-muted">{d.diagnosticSub}</p>
        </div>
        <span id="ds-nsf-pill" class="px-2.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-100 text-emerald-950 border border-emerald-300">
          NSF 184 COMPLIANT
        </span>
      </div>

      <!-- Big Metric 1: Log Reduction -->
      <div class="bg-surface-soft border border-hairline rounded-2xl p-5 text-center">
        <div class="text-xs font-bold uppercase tracking-wider text-muted mb-1">
          {d.logReductionLabel}
        </div>
        <div class="text-4xl md:text-5xl font-extrabold text-emerald-800 font-mono tracking-tight" id="ds-log-reduction">
          &gt; 5.2-log
        </div>
        <div class="text-sm font-semibold text-emerald-950 mt-1" id="ds-kill-pct">
          99.9994% Inactivation Lethality
        </div>
      </div>

      <!-- Quick Stats Grid -->
      <div class="grid grid-cols-2 gap-3 text-xs">
        <div class="bg-surface-soft border border-hairline rounded-xl p-3">
          <span class="text-muted block text-[11px] mb-0.5">{d.effectiveTempLabel}</span>
          <span class="font-mono font-bold text-ink text-sm" id="ds-peak-temp">158°F (70°C)</span>
        </div>
        <div class="bg-surface-soft border border-hairline rounded-xl p-3">
          <span class="text-muted block text-[11px] mb-0.5">{d.dValueLabel}</span>
          <span class="font-mono font-bold text-ink text-sm" id="ds-d-value">0.15 min</span>
        </div>
        <div class="bg-surface-soft border border-hairline rounded-xl p-3">
          <span class="text-muted block text-[11px] mb-0.5">{d.chemBoostLabel}</span>
          <span class="font-mono font-bold text-ink text-sm" id="ds-chem-boost">+1.8 Log (Percarbonate)</span>
        </div>
        <div class="bg-surface-soft border border-hairline rounded-xl p-3">
          <span class="text-muted block text-[11px] mb-0.5">{d.nsfComplianceLabel}</span>
          <span class="font-mono font-bold text-emerald-800 text-sm" id="ds-nsf-status">PASS (≥ 5-Log)</span>
        </div>
      </div>

      <!-- Clinical Risk Box -->
      <div class="bg-amber-50 border border-amber-200 rounded-2xl p-4 text-xs space-y-2" id="ds-risk-box">
        <div class="font-bold text-amber-950 flex items-center gap-1.5 text-xs">
          <span>⚠️</span>
          {d.clinicalRiskLabel}
        </div>
        <p class="text-amber-900 leading-relaxed" id="ds-risk-text">
          Norovirus (GII.4) requires 60°C–70°C for multiple minutes to achieve 4-log reduction. The current cycle successfully meets the clinical lethality threshold, eliminating active cross-contamination risks across household dishes.
        </p>
      </div>

      <!-- Copy Report Button -->
      <div>
        <button 
          type="button" 
          id="ds-copy-btn" 
          class="w-full py-2.5 px-4 rounded-xl bg-ink text-canvas hover:bg-ink/90 font-semibold text-xs transition-colors flex items-center justify-center gap-2 cursor-pointer shadow-xs"
        >
          {d.copyReportBtn}
        </button>
        <p id="ds-copied-msg" class="text-center text-xs text-emerald-700 font-medium mt-1.5 hidden">
          {d.copiedFeedback}
        </p>
      </div>
    </div>
  </div>

  <!-- Microbiology Kinetics & Formulas Strip -->
  <div class="bg-canvas border border-hairline rounded-2xl p-6 md:p-8 mb-12">
    <div class="mb-4">
      <h3 class="text-lg font-bold text-ink flex items-center gap-2">
        <span>📐</span>
        {d.mechanicsTitle}
      </h3>
      <p class="text-xs text-muted">{d.mechanicsSub}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs font-mono">
      <div class="bg-surface-soft border border-hairline rounded-xl p-4">
        <div class="text-muted text-[11px] uppercase font-bold mb-1">1. Bigelow Thermal Death Kinetics (D-Value)</div>
        <div class="text-ink font-semibold mb-1">D_T = D_ref &middot; 10^((T_ref - T_eff) / z)</div>
        <p class="text-muted font-sans text-[11px]">
          Calculates the minutes required at effective plate temperature T_eff to achieve a 90% (1-log) destruction of the target pathogen.
        </p>
      </div>

      <div class="bg-surface-soft border border-hairline rounded-xl p-4">
        <div class="text-muted text-[11px] uppercase font-bold mb-1">2. Total Thermal &amp; Chemical Log Reduction</div>
        <div class="text-ink font-semibold mb-1">Log_Red = (t_rinse + 0.4 &middot; t_dry) / (D_T &middot; S_matrix) + Chem_Boost</div>
        <p class="text-muted font-sans text-[11px]">
          Integrates high-temperature rinse dwell and heated dry air against soil shielding factors, plus active percarbonate oxygen bleaching.
        </p>
      </div>
    </div>
  </div>

  <!-- Reference Matrix Table -->
  <div class="bg-canvas border border-hairline rounded-2xl p-6 md:p-8 mb-12 overflow-x-auto">
    <div class="mb-4">
      <h3 class="text-lg font-bold text-ink flex items-center gap-2">
        <span>📊</span>
        {d.tableTitle}
      </h3>
      <p class="text-xs text-muted">{d.tableSub}</p>
    </div>

    <table class="w-full text-left text-xs text-ink border-collapse">
      <thead>
        <tr class="border-b border-hairline text-muted uppercase text-[11px]">
          <th class="py-2.5 pr-4 font-bold">{d.colPathogen}</th>
          <th class="py-2.5 pr-4 font-bold">{d.colType}</th>
          <th class="py-2.5 pr-4 font-bold">{d.colD60}</th>
          <th class="py-2.5 pr-4 font-bold">{d.colTargetLog}</th>
          <th class="py-2.5 font-bold">{d.colRisk}</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-hairline">
        {sanitizeData.pathogens.map(p => (
          <tr class="hover:bg-surface-soft/60 transition-colors">
            <td class="py-3 pr-4 font-semibold text-ink">{p.name}</td>
            <td class="py-3 pr-4 text-muted font-mono">{p.microbeType}</td>
            <td class="py-3 pr-4 font-mono">{p.dRefTempC === 100 ? '> 1,000 min' : `${p.dRefMin} min`}</td>
            <td class="py-3 pr-4 font-mono font-bold text-emerald-800">{p.targetLogReduction > 0 ? `≥ ${p.targetLogReduction}-log` : 'N/A (Autoclave)'}</td>
            <td class="py-3 text-muted">{p.clinicalRisk}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <!-- 4 Critical Sanitization Rules -->
  <div class="bg-surface-strong/30 border border-hairline rounded-3xl p-6 md:p-10">
    <div class="mb-6">
      <h3 class="text-xl font-bold text-ink flex items-center gap-2">
        <span>🛡️</span>
        {d.rulesTitle}
      </h3>
      <p class="text-xs text-muted">{d.rulesSub}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs text-muted">
      <div class="bg-canvas border border-hairline rounded-2xl p-5 space-y-2">
        <h4 class="font-bold text-ink text-sm text-emerald-950 flex items-center gap-1.5">
          <span>1.</span>
          {d.rule1Title}
        </h4>
        <p class="leading-relaxed">{d.rule1Text}</p>
      </div>

      <div class="bg-canvas border border-hairline rounded-2xl p-5 space-y-2">
        <h4 class="font-bold text-ink text-sm text-emerald-950 flex items-center gap-1.5">
          <span>2.</span>
          {d.rule2Title}
        </h4>
        <p class="leading-relaxed">{d.rule2Text}</p>
      </div>

      <div class="bg-canvas border border-hairline rounded-2xl p-5 space-y-2">
        <h4 class="font-bold text-ink text-sm text-red-950 flex items-center gap-1.5">
          <span>3.</span>
          {d.rule3Title}
        </h4>
        <p class="leading-relaxed">{d.rule3Text}</p>
      </div>

      <div class="bg-canvas border border-hairline rounded-2xl p-5 space-y-2">
        <h4 class="font-bold text-ink text-sm text-emerald-950 flex items-center gap-1.5">
          <span>4.</span>
          {d.rule4Title}
        </h4>
        <p class="leading-relaxed">{d.rule4Text}</p>
      </div>
    </div>
  </div>
</div>

<!-- Embedded Client Script for Reactive Simulation -->
<script define:vars={{ sanitizeData, lang }}>
  (function() {
    const cycleSelect = document.getElementById('ds-cycle');
    const pathogenSelect = document.getElementById('ds-pathogen');
    const detergentSelect = document.getElementById('ds-detergent');
    const soilSelect = document.getElementById('ds-soil');
    const hydraulicSelect = document.getElementById('ds-hydraulic');
    const dwellSlider = document.getElementById('ds-dwell-slider');
    const dwellValText = document.getElementById('ds-dwell-val');

    const cycleDesc = document.getElementById('ds-cycle-desc');
    const pathogenDesc = document.getElementById('ds-pathogen-desc');
    const detergentDesc = document.getElementById('ds-detergent-desc');

    const nsfPill = document.getElementById('ds-nsf-pill');
    const logReductionText = document.getElementById('ds-log-reduction');
    const killPctText = document.getElementById('ds-kill-pct');
    const peakTempText = document.getElementById('ds-peak-temp');
    const dValueText = document.getElementById('ds-d-value');
    const chemBoostText = document.getElementById('ds-chem-boost');
    const nsfStatusText = document.getElementById('ds-nsf-status');
    const riskBox = document.getElementById('ds-risk-box');
    const riskText = document.getElementById('ds-risk-text');

    const copyBtn = document.getElementById('ds-copy-btn');
    const copiedMsg = document.getElementById('ds-copied-msg');

    if (!cycleSelect || !pathogenSelect || !logReductionText) return;

    function recalculate() {
      const cycleId = cycleSelect.value;
      const pathogenId = pathogenSelect.value;
      const detergentId = detergentSelect.value;
      const soilId = soilSelect.value;
      const hydraulicId = hydraulicSelect.value;
      const customDwell = parseInt(dwellSlider.value, 10);

      dwellValText.textContent = `${customDwell} minutes`;

      const cycle = sanitizeData.cycleTypes.find(c => c.id === cycleId) || sanitizeData.cycleTypes[0];
      const pathogen = sanitizeData.pathogens.find(p => p.id === pathogenId) || sanitizeData.pathogens[0];
      const detergent = sanitizeData.detergentFormulations.find(d => d.id === detergentId) || sanitizeData.detergentFormulations[0];
      const soil = sanitizeData.soilShieldingMatrices.find(s => s.id === soilId) || sanitizeData.soilShieldingMatrices[0];
      const hydraulic = sanitizeData.hydraulicLoadFactors.find(h => h.id === hydraulicId) || sanitizeData.hydraulicLoadFactors[0];

      if (cycleDesc) cycleDesc.textContent = cycle.description;
      if (pathogenDesc) pathogenDesc.textContent = pathogen.clinicalRisk;
      if (detergentDesc) detergentDesc.textContent = detergent.description;

      // Effective Peak Temperature
      const effectivePeakTempC = Math.max(20, cycle.rinseTempC - hydraulic.tempDropDeltaC);
      const effectivePeakTempF = Math.round((effectivePeakTempC * 9 / 5) + 32);
      peakTempText.textContent = `${effectivePeakTempF}°F (${effectivePeakTempC}°C)`;

      // Bacterial Endospore Special Case
      if (pathogen.id === 'clostridium-spores') {
        logReductionText.textContent = '0.0-log';
        logReductionText.className = 'text-4xl md:text-5xl font-extrabold text-red-600 font-mono tracking-tight';
        killPctText.textContent = '0.00% Lethality (Total Ineffective)';
        dValueText.textContent = '> 1,000 min';
        chemBoostText.textContent = '+0.0 Log (Immune)';
        nsfStatusText.textContent = 'FAIL (Requires 121°C Autoclave)';
        nsfStatusText.className = 'font-mono font-bold text-red-600 text-sm';
        nsfPill.textContent = 'STERILIZATION FAILURE';
        nsfPill.className = 'px-2.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-red-100 text-red-950 border border-red-300';

        riskBox.className = 'bg-red-50 border border-red-200 rounded-2xl p-4 text-xs space-y-2';
        riskText.textContent = 'CRITICAL FOOD SAFETY ALERT: Bacterial endospores from Clostridium botulinum completely survive all residential and commercial dishwasher cycles. Dishwashers lack the pressurized steam (121°C / 250°F at 15 PSI) required to denature endospores. NEVER use a dishwasher to sterilize canning jars for home preservation.';
        return;
      }

      // Calculate D-value at effective temperature using Bigelow equation:
      // D_T = D_ref * 10^((T_ref - T_eff) / z)
      const exponent = (pathogen.dRefTempC - effectivePeakTempC) / pathogen.zValueC;
      const dValueAtPeak = pathogen.dRefMin * Math.pow(10, exponent);

      let dValueDisplay = '';
      if (dValueAtPeak < 0.01) {
        dValueDisplay = `< 0.01 min (${(dValueAtPeak * 60).toFixed(1)}s)`;
      } else if (dValueAtPeak > 999) {
        dValueDisplay = '> 1,000 min';
      } else {
        dValueDisplay = `${dValueAtPeak.toFixed(2)} min`;
      }
      dValueText.textContent = dValueDisplay;

      // Chemical Boost
      const chemBoost = detergent.chemicalLogBoost * (detergent.hasActiveOxygenBleach ? detergent.capsidDisruptionFactor : 1.0);
      chemBoostText.textContent = `+${chemBoost.toFixed(1)} Log (${detergent.hasActiveOxygenBleach ? 'Percarbonate' : 'Surfactants'})`;

      // Thermal Log Reduction
      const effectiveDwellTime = customDwell + (cycle.heatedDry ? (cycle.heatedDryMin * 0.4) : 0);
      const effectiveDValue = dValueAtPeak * soil.shieldingMultiplier;
      const thermalLogRed = effectiveDValue > 0 ? (effectiveDwellTime / effectiveDValue) : 0;
      const totalLogRed = Math.min(12.0, thermalLogRed + chemBoost);

      // Kill percentage
      let killPct = 0;
      if (totalLogRed >= 6.0) {
        killPct = 99.9999;
      } else if (totalLogRed <= 0) {
        killPct = 0;
      } else {
        killPct = (1 - Math.pow(10, -totalLogRed)) * 100;
      }

      logReductionText.textContent = totalLogRed >= 7 ? '> 7.0-log' : `${totalLogRed.toFixed(1)}-log`;
      killPctText.textContent = totalLogRed >= 5 ? `${killPct.toFixed(4)}% Complete Inactivation` : `${killPct.toFixed(2)}% Inactivation (Inadequate)`;

      // NSF 184 Evaluation
      const meetsNSF = totalLogRed >= pathogen.targetLogReduction && effectivePeakTempF >= 148;

      if (meetsNSF) {
        logReductionText.className = 'text-4xl md:text-5xl font-extrabold text-emerald-800 font-mono tracking-tight';
        nsfPill.textContent = 'NSF 184 COMPLIANT';
        nsfPill.className = 'px-2.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-100 text-emerald-950 border border-emerald-300';
        nsfStatusText.textContent = `PASS (≥ ${pathogen.targetLogReduction}-Log)`;
        nsfStatusText.className = 'font-mono font-bold text-emerald-800 text-sm';

        riskBox.className = 'bg-emerald-50 border border-emerald-200 rounded-2xl p-4 text-xs space-y-2';
        riskText.textContent = `Thermal pasteurization and chemical oxidation successfully exceeded the required ${pathogen.targetLogReduction}-log kill threshold. Target organism (${pathogen.name}) reduced to non-infectious levels with zero cross-contamination risk.`;
      } else {
        logReductionText.className = 'text-4xl md:text-5xl font-extrabold text-amber-800 font-mono tracking-tight';
        nsfPill.textContent = 'DEFICIENT SANITIZE';
        nsfPill.className = 'px-2.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-100 text-amber-950 border border-amber-300';
        nsfStatusText.textContent = `FAIL (< ${pathogen.targetLogReduction}-Log Target)`;
        nsfStatusText.className = 'font-mono font-bold text-amber-800 text-sm';

        riskBox.className = 'bg-amber-50 border border-amber-200 rounded-2xl p-4 text-xs space-y-2';
        riskText.textContent = `WARNING: Cycle failed to achieve the clinical ${pathogen.targetLogReduction}-log reduction standard. Viable pathogens (${pathogen.name}) may remain adhered to tableware and cutlery surfaces. Select the certified Sanitize cycle or switch to an oxygen bleach detergent.`;
      }
    }

    // Preset click listeners
    const presetBtns = document.querySelectorAll('.preset-btn');
    presetBtns.forEach(btn => {
      btn.addEventListener('click', function() {
        const presetId = this.getAttribute('data-preset');
        const preset = sanitizeData.presets.find(p => p.id === presetId);
        if (!preset) return;

        cycleSelect.value = preset.cycle;
        pathogenSelect.value = preset.pathogen;
        detergentSelect.value = preset.detergent;
        soilSelect.value = preset.soil;
        hydraulicSelect.value = preset.hydraulic;

        const cycleObj = sanitizeData.cycleTypes.find(c => c.id === preset.cycle);
        if (cycleObj) {
          dwellSlider.value = cycleObj.rinseDwellMin;
        }

        recalculate();
      });
    });

    cycleSelect.addEventListener('change', () => {
      const cycleObj = sanitizeData.cycleTypes.find(c => c.id === cycleSelect.value);
      if (cycleObj) {
        dwellSlider.value = cycleObj.rinseDwellMin;
      }
      recalculate();
    });

    pathogenSelect.addEventListener('change', recalculate);
    detergentSelect.addEventListener('change', recalculate);
    soilSelect.addEventListener('change', recalculate);
    hydraulicSelect.addEventListener('change', recalculate);
    dwellSlider.addEventListener('input', recalculate);

    // Initial calculation
    recalculate();

    // Copy Report
    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        const report = `ISITKITCHENSAFE DISHWASHER THERMAL SANITIZE REPORT
==================================================
Date: ${new Date().toISOString()}
Cycle: ${cycleSelect.options[cycleSelect.selectedIndex].text}
Pathogen: ${pathogenSelect.options[pathogenSelect.selectedIndex].text}
Detergent: ${detergentSelect.options[detergentSelect.selectedIndex].text}
Dwell Time: ${dwellSlider.value} minutes
Effective Peak Temp: ${peakTempText.textContent}
Total Microbial Log Reduction: ${logReductionText.textContent} (${killPctText.textContent})
NSF/ANSI 184 Status: ${nsfPill.textContent}
D_T (Peak D-Value): ${dValueText.textContent}
Chemical Synergy: ${chemBoostText.textContent}
Assessment: ${riskText.textContent}
==================================================
Powered by IsItKitchenSafe Autonomous Growth & Ops Engine`;

        navigator.clipboard.writeText(report).then(() => {
          if (copiedMsg) {
            copiedMsg.classList.remove('hidden');
            setTimeout(() => copiedMsg.classList.add('hidden'), 3500);
          }
        });
      });
    }
  })();
</script>
