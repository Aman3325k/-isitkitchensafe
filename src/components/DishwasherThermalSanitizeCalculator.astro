      'commercial-high-temp': { name: '商用餐厅高温洗碗机 (NSF/ANSI 3：82°C 终洗)', description: '餐饮业高温消毒机，60–90 秒内实现瞬时热力巴氏灭菌。' }
    },
    pathogens: {
