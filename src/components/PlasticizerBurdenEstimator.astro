}

const { lang = 'en' } = Astro.props;

interface Dict {
  badge: string;
  title: string;
  subtitle: string;
  calcHeader: string;
  calcDesc: string;
  riskGaugeTitle: string;
  scoreLabel: string;
  weeklyParticlesLabel: string;
  creditCardsLabel: string;
  bloodBurdenLabel: string;
  nanoplasticTranslocation: string;
  yourPlanTitle: string;
  yourPlanSub: string;
  copyPlanBtn: string;
  planCopied: string;
  scienceTitle: string;
  scienceSub: string;
  polymersTitle: string;
  polymersSub: string;
  crossLinkTools: string;
  crossLinkSwap: string;
  crossLinkEnergy: string;
  crossLinkThermal: string;
  crossLinkScorecard: string;
  crossLinkPanInspector: string;
