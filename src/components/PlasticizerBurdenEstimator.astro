const d = DICT[lang] || DICT.en;
const prefix = lang === 'en' ? '' : `/${lang}`;
---

<div class="max-w-5xl mx-auto space-y-12 text-ink">
  <!-- Hero / Header Section -->
  <header class="text-center space-y-4">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-purple-100 text-purple-900 border border-purple-200">
      <span class="w-2 h-2 rounded-full bg-purple-600 animate-pulse"></span>
      {d.badge}
    </div>
    <h1 class="text-display-sm md:text-display-md font-semibold text-ink tracking-tight">
      {d.title}
    </h1>
    <p class="text-body max-w-3xl mx-auto text-base md:text-lg leading-relaxed text-muted">
      {d.subtitle}
    </p>
  </header>

  <!-- Interactive Audit Tool Form -->
  <section class="bg-surface-soft border border-hairline rounded-3xl p-6 md:p-10 shadow-xs space-y-8" id="plasticizer-calculator">
    <div class="border-b border-hairline pb-4 flex flex-col md:flex-row md:items-center justify-between gap-2">
      <div>
        <h2 class="text-title-lg font-medium text-ink tracking-tight">{d.calcHeader}</h2>
        <p class="text-body text-xs md:text-sm text-muted">{d.calcDesc}</p>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-xs font-mono px-2.5 py-1 rounded-lg bg-surface font-medium border border-hairline text-muted">
          5 Clinical Indicators
        </span>
      </div>
    </div>

    <!-- Questions Grid -->
    <div class="space-y-6" id="audit-questions-container">
      {burdenData.questions.map((q, idx) => (
        <div class="p-5 rounded-2xl bg-canvas border border-hairline space-y-3" data-question-id={q.id}>
          <div class="flex items-start justify-between gap-4">
            <div>
              <span class="text-[11px] font-bold uppercase tracking-wider text-purple-700 block mb-0.5">
                Factor 0{idx + 1}
              </span>
              <h3 class="text-title-sm font-medium text-ink">{q.title}</h3>
              <p class="text-xs text-muted mt-0.5">{q.description}</p>
            </div>
            <span class="text-xs font-mono font-semibold px-2 py-0.5 rounded bg-surface border border-hairline text-muted shrink-0">
              Weight: {q.weight}%
            </span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-2">
            {q.options.map((opt, optIdx) => (
              <label class={`cursor-pointer p-3.5 rounded-xl border transition-all text-xs flex items-start gap-3 ${optIdx === 0 ? 'border-purple-600 bg-purple-50/50' : 'border-hairline bg-surface hover:bg-surface-strong'}`}>
                <input 
                  type="radio" 
                  name={q.id} 
                  value={opt.id} 
                  data-score={opt.score}
                  data-weekly={opt.weeklyParticles}
                  checked={optIdx === 0}
                  class="mt-0.5 text-purple-600 focus:ring-purple-500 rounded border-hairline"
                />
                <div class="space-y-0.5">
                  <span class="font-medium text-ink block leading-snug">{opt.label}</span>
                  <div class="flex items-center gap-2 text-[11px] text-muted font-mono">
                    <span>+{opt.weeklyParticles.toLocaleString()} pts/wk</span>
                    <span>&bull;</span>
                    <span class={opt.score > 15 ? 'text-rose-600 font-semibold' : 'text-emerald-700 font-semibold'}>
                      {opt.plasticizerRisk}
                    </span>
                  </div>
                </div>
              </label>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Results Display Panel -->
    <div class="p-6 md:p-8 rounded-2xl bg-canvas border-2 border-purple-200 space-y-8" id="audit-results-card">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-hairline pb-6">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-purple-700 block mb-1">
            {d.riskGaugeTitle}
          </span>
          <h3 class="text-title-md font-semibold text-ink" id="result-tier-badge">
            {burdenData.riskTiers[3].badge}
          </h3>
          <p class="text-xs text-muted mt-1 max-w-xl" id="result-tier-desc">
            {burdenData.riskTiers[3].description}
          </p>
        </div>

        <div class="text-center md:text-right shrink-0 bg-surface px-6 py-4 rounded-xl border border-hairline">
          <span class="text-[11px] uppercase tracking-wider text-muted font-mono block mb-0.5">{d.scoreLabel}</span>
          <div class="text-display-xs font-bold text-rose-600 font-mono" id="result-score-val">
            100 <span class="text-sm font-normal text-muted">/ 100</span>
          </div>
        </div>
      </div>

      <!-- Core Metrics 3-Column Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <!-- Metric 1: Weekly Particle Count -->
        <div class="p-4 rounded-xl bg-surface border border-hairline space-y-1">
          <span class="text-[11px] uppercase font-mono tracking-wider text-muted block">
            {d.weeklyParticlesLabel}
          </span>
          <div class="text-title-lg font-bold text-ink font-mono" id="result-particles-val">
            349,000
          </div>
          <p class="text-[11px] text-muted leading-tight">
            Microplastics &gt;1 µm + millions of sub-visible nanoplastics.
          </p>
        </div>

        <!-- Metric 2: Credit Cards Ingested -->
        <div class="p-4 rounded-xl bg-surface border border-hairline space-y-1">
          <span class="text-[11px] uppercase font-mono tracking-wider text-muted block">
            {d.creditCardsLabel}
          </span>
          <div class="text-title-lg font-bold text-rose-600 font-mono" id="result-cards-val">
            10.4 Cards / Yr
          </div>
          <p class="text-[11px] text-muted leading-tight">
            Based on standard 5.0g PVC/PET card mass ingestion modeling.
          </p>
        </div>

        <!-- Metric 3: Blood Translocation Risk -->
        <div class="p-4 rounded-xl bg-surface border border-hairline space-y-1">
          <span class="text-[11px] uppercase font-mono tracking-wider text-muted block">
            {d.bloodBurdenLabel}
          </span>
          <div class="text-title-lg font-bold text-purple-700 font-mono" id="result-blood-val">
            High Accumulation
          </div>
          <p class="text-[11px] text-muted leading-tight" id="result-blood-detail">
            &gt;5.0 µg/mL polymer equivalent crossing gut epithelium barrier.
          </p>
        </div>
      </div>

      <!-- Dynamic Action Plan Recommendations -->
      <div class="space-y-4 pt-4 border-t border-hairline">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div>
            <h4 class="text-title-sm font-semibold text-ink">{d.yourPlanTitle}</h4>
            <p class="text-xs text-muted">{d.yourPlanSub}</p>
          </div>
          <button 
            type="button" 
            id="copy-plan-btn" 
            class="px-4 py-2 rounded-xl bg-purple-700 hover:bg-purple-800 text-white font-medium text-xs transition-colors shadow-xs shrink-0 flex items-center gap-1.5"
          >
            {d.copyPlanBtn}
          </button>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
          {burdenData.actionPlanInterventions.map((act) => (
            <div class="p-4 rounded-xl bg-surface border border-hairline space-y-2 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between gap-2 mb-1.5">
                  <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-purple-100 text-purple-900 border border-purple-200">
                    Priority 0{act.priority} &bull; {act.category}
                  </span>
                  <span class="text-xs font-mono text-muted">{act.costEstimate}</span>
                </div>
                <h5 class="text-body font-semibold text-ink text-sm">{act.action}</h5>
                <p class="text-xs text-muted leading-relaxed mt-1">{act.detail}</p>
              </div>

              <div class="pt-3 border-t border-hairline/60 mt-3 text-xs">
                <span class="text-muted block text-[11px] mb-0.5">Vetted Non-Toxic Alternative:</span>
                <span class="font-medium text-purple-900">{act.recommendedProduct}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Scientific Evidence & Peer-Reviewed Studies Section -->
  <section class="space-y-6">
    <div class="border-b border-hairline pb-3">
      <h2 class="text-title-lg font-medium text-ink">{d.scienceTitle}</h2>
      <p class="text-xs text-muted">{d.scienceSub}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {burdenData.scientificReferences.map((ref) => (
        <article class="p-5 rounded-2xl bg-surface-soft border border-hairline space-y-2">
          <span class="text-[11px] font-mono font-semibold text-purple-800 block">
            {ref.source}
          </span>
          <h3 class="text-sm font-semibold text-ink leading-snug">
            {ref.title}
          </h3>
          <p class="text-xs text-body leading-relaxed">
            {ref.keyFinding}
          </p>
        </article>
      ))}
    </div>
  </section>

  <!-- Kitchen Food Contact Polymers Reference Grid -->
  <section class="space-y-6">
    <div class="border-b border-hairline pb-3">
      <h2 class="text-title-lg font-medium text-ink">{d.polymersTitle}</h2>
      <p class="text-xs text-muted">{d.polymersSub}</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {burdenData.polymerClasses.map((p) => (
        <div class="p-5 rounded-2xl bg-surface-soft border border-hairline space-y-2.5">
          <div class="flex items-center justify-between gap-2">
            <span class="text-xs font-mono font-bold px-2 py-0.5 rounded bg-surface border border-hairline text-ink">
              {p.code}
            </span>
            <span class="text-[11px] text-rose-600 font-mono font-medium">
              Degrades &gt;{p.heatDegradationC}°C
            </span>
          </div>
          <h3 class="text-sm font-semibold text-ink">{p.name}</h3>
          <p class="text-xs text-muted"><strong class="text-ink">Common in:</strong> {p.commonUses}</p>
          <p class="text-xs text-body border-t border-hairline/60 pt-2 leading-relaxed">
            {p.primaryRisks}
          </p>
        </div>
      ))}
    </div>
  </section>

  <!-- Cross-Link Eco System Section -->
  <section class="p-6 rounded-2xl bg-surface border border-hairline space-y-3">
    <h3 class="text-title-xs uppercase tracking-wider font-mono text-muted">
      {d.crossLinkTools}
    </h3>
    <div class="flex flex-wrap gap-2 text-xs">
      <a href={`${prefix}/tools/material-swap-calculator/`} class="px-3 py-1.5 rounded-lg bg-surface-soft hover:bg-surface-strong border border-hairline font-medium text-ink transition-colors">
        🔄 {d.crossLinkSwap} &rarr;
      </a>
      <a href={`${prefix}/tools/kitchen-energy-carbon-calculator/`} class="px-3 py-1.5 rounded-lg bg-surface-soft hover:bg-surface-strong border border-hairline font-medium text-ink transition-colors">
        ⚡ {d.crossLinkEnergy} &rarr;
      </a>
      <a href={`${prefix}/tools/thermal-shock-simulator/`} class="px-3 py-1.5 rounded-lg bg-surface-soft hover:bg-surface-strong border border-hairline font-medium text-ink transition-colors">
        💥 {d.crossLinkThermal} &rarr;
      </a>
      <a href={`${prefix}/tools/toxic-leaching-scorecard/`} class="px-3 py-1.5 rounded-lg bg-surface-soft hover:bg-surface-strong border border-hairline font-medium text-ink transition-colors">
        🧪 {d.crossLinkScorecard} &rarr;
      </a>
      <a href={`${prefix}/tools/pan-scratch-inspector/`} class="px-3 py-1.5 rounded-lg bg-surface-soft hover:bg-surface-strong border border-hairline font-medium text-ink transition-colors">
