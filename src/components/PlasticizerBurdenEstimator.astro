<!-- Vanilla JS Client-Side Calculation Script -->
<script is:inline define:vars={{ tiers: burdenData.riskTiers }}>
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('audit-questions-container');
    const resultScore = document.getElementById('result-score-val');
    const resultTierBadge = document.getElementById('result-tier-badge');
    const resultTierDesc = document.getElementById('result-tier-desc');
    const resultParticles = document.getElementById('result-particles-val');
    const resultCards = document.getElementById('result-cards-val');
    const resultBlood = document.getElementById('result-blood-val');
    const resultBloodDetail = document.getElementById('result-blood-detail');
    const copyBtn = document.getElementById('copy-plan-btn');

    if (!container) return;

    function recalculate() {
      const inputs = container.querySelectorAll('input[type="radio"]:checked');
      let totalScore = 0;
      let totalWeeklyParticles = 0;

      inputs.forEach(input => {
        totalScore += parseInt(input.dataset.score || '0', 10);
        totalWeeklyParticles += parseInt(input.dataset.weekly || '0', 10);
      });

      // Normalize score to max 100
      totalScore = Math.min(100, Math.max(0, totalScore));

      // Calculate annual credit cards equivalent
      // Benchmark: ~5 grams per card. High risk dietary ingestion modeled at 10-14 cards/yr (~1g/week max)
      const annualCards = (totalWeeklyParticles / 33500).toFixed(1);

      // Determine Tier
      let currentTier = tiers[0];
      for (const t of tiers) {
        if (totalScore <= t.maxScore) {
          currentTier = t;
          break;
        }
      }

      if (resultScore) resultScore.innerHTML = `${totalScore} <span class="text-sm font-normal text-muted">/ 100</span>`;
      if (resultTierBadge) resultTierBadge.textContent = currentTier.badge;
      if (resultTierDesc) resultTierDesc.textContent = currentTier.description;
      if (resultParticles) resultParticles.textContent = totalWeeklyParticles.toLocaleString();
      if (resultCards) resultCards.textContent = `${annualCards} Cards / Yr`;
      if (resultBlood) resultBlood.textContent = currentTier.tier === 'low' ? 'Low / Background' : currentTier.tier === 'moderate' ? 'Moderate Migration' : currentTier.tier === 'elevated' ? 'Elevated Translocation' : 'High Biological Accumulation';
      if (resultBloodDetail) resultBloodDetail.textContent = currentTier.estimatedBloodBurden;

      // Update styling of selected labels
      container.querySelectorAll('label').forEach(label => {
        const radio = label.querySelector('input[type="radio"]');
        if (radio && radio.checked) {
          label.className = 'cursor-pointer p-3.5 rounded-xl border transition-all text-xs flex items-start gap-3 border-purple-600 bg-purple-50/50';
        } else {
          label.className = 'cursor-pointer p-3.5 rounded-xl border transition-all text-xs flex items-start gap-3 border-hairline bg-surface hover:bg-surface-strong';
        }
      });
    }

    container.addEventListener('change', recalculate);
    recalculate();

    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        const score = resultScore ? resultScore.innerText.trim() : 'N/A';
        const tier = resultTierBadge ? resultTierBadge.innerText.trim() : 'N/A';
        const particles = resultParticles ? resultParticles.innerText.trim() : 'N/A';
        const cards = resultCards ? resultCards.innerText.trim() : 'N/A';

        const summary = `IsItKitchenSafe - Household Food Contact Plasticizer & Microplastic Audit Report\n` +
          `-------------------------------------------------------------------------------\n` +
          `• Exposure Risk Score: ${score}\n` +
          `• Risk Classification: ${tier}\n` +
          `• Weekly Ingested Particles: ~${particles}\n` +
          `• Annual Equivalent Plastic Mass: ${cards}\n` +
          `\nKey Immediate Interventions:\n` +
          `1. 100% Ban on Microwaving Plastic (Switch to Borosilicate Glass)\n` +
          `2. Swap Plastic Chopping Boards for Organic End-Grain Hardwood\n` +
          `3. Replace Plastic Kettles with Seamless 316 Stainless Steel\n` +
          `4. Replace PVC Cling Wrap with Beeswax Wraps for Fatty Leftovers\n` +
          `-------------------------------------------------------------------------------\n` +
          `Audit URL: https://isitkitchensafe.com/tools/plasticizer-microplastic-burden-estimator/`;

        navigator.clipboard.writeText(summary).then(() => {
          const originalText = copyBtn.innerText;
          copyBtn.innerText = '✓ Report Copied to Clipboard!';
          copyBtn.classList.replace('bg-purple-700', 'bg-emerald-700');
          setTimeout(() => {
            copyBtn.innerText = originalText;
            copyBtn.classList.replace('bg-emerald-700', 'bg-purple-700');
          }, 3000);
        });
      });
    }
  });
</script>
