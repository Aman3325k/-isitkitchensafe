    throughputHelp: "相互作用チャンバーを通過する連続フィード流量（50〜1,500 L/h）。",
    passesLabel: "均質化衝突パス回数 (N_pass):",
    passesHelp: "微小衝突剪断ゾーンを連続通過するインライン循環回数（1〜5回）。",
    feedTempLabel: "原料フィード初期入口温度 (T_feed):",
    feedTempHelp: "入口液体温度（15.0〜55.0°C）。リン脂質の相転移流動性と熱劣化の限界を両立。",
    backpressureLabel: "インライン自動制御背圧 (P_back):",
    backpressureHelp: "下流側アセプティック背圧（2.0〜25.0 MPa）。流体密度を保ち、エロージョン性キャビテーション蒸気泡を完全消滅。",
    presetsTitle: "産業用標準プロセスプリセット:",
    presetCurcumin: "クルクミンフィトソーム（生体内利用率向上）",
    presetOmega3: "海洋性オメガ3（酸化抑制シールド）",
    presetVitaminC: "リポソームビタミンC＋GSH（水相内包）",
    presetFlavor: "植物性乳製品香料キャリア（高透明度分散）",
    presetHazard: "キャビテーション浸食＆熱暴走危険条件",
    diagnosticTitle: "リアルタイム水力流体力学診断テレメトリ",
    diagnosticSub: "小胞粒径、カプセル化収率、剪断エネルギー散逸、サニタリー適合度をバイオフィジカルにリアルタイム予測。",
    liposomeSizeLabel: "平均ナノリポソーム粒径 (D32):",
    pdiLabel: "多分散度指数 (PDI):",
    encapsulationLabel: "カプセル化効率 (EE%):",
    jetVelocityLabel: "マイクロジェット衝突速度 (v_jet):",
    shearRateLabel: "伸長剪断速度 (γ̇):",
    exitTempLabel: "急冷後流体出口温度 (T_exit):",
    cavitationFactorLabel: "キャビテーション抑制係数 (Ψ):",
    energyKwhLabel: "単位処理エネルギー消費量 (E_spec):",
    shelfStabilityLabel: "4°C コロイド保存安定性:",
    overallStatusLabel: "サニタリー＆品質総合評価:",
    diagramTitle: "対向マイクロキャピラリージェット衝突＆小胞剪断微細化メカニズム",
    diagramSub: "単結晶ダイヤモンドチャンバー内で560 m/sの極音速で正面衝突する対向マイクロジェットと、インライン急冷熱交換プロセスの模式図。",
    scienceTitle: "HC-HDJ リポソーム合成の生物物理学＆流体工学的基礎理論",
    scienceSub: "衝突運動エネルギー散逸、伸長層流マイクロ剪断、断熱昇温制御、脂質二重層パッキングおよび3-A規格適合性を包括的に解説。",
    tableTitle: "商用成套スキッド構成＆生体活性物質処方リファレンスデータ"
  }
};

const d = DICT[lang] || DICT.en;
---

<div class="not-prose max-w-7xl mx-auto my-8 font-sans">
  <!-- Top Hero Header -->
  <header class="bg-surface-soft border border-hairline rounded-3xl p-6 sm:p-10 mb-8 shadow-xs">
    <div class="flex flex-wrap items-center gap-3 mb-4">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-sky-950 text-sky-200 border border-sky-800">
        <span class="w-2 h-2 rounded-full bg-sky-400 animate-pulse"></span>
        {d.badge}
      </span>
      <span class="text-xs text-muted font-mono">HC-HDJ &bull; 100&ndash;300 MPa &bull; 560 m/s Jet &bull; 3-A 04-05 &amp; 44-03</span>
    </div>

    <h1 class="text-2xl sm:text-4xl font-extrabold text-ink tracking-tight mb-4">
      {d.title}
    </h1>

    <p class="text-body text-base sm:text-lg leading-relaxed max-w-5xl">
      {d.subtitle}
    </p>
  </header>

  <!-- Interactive Simulator Grid: Left Controls, Right Diagnostics -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-12">
    <!-- Left Column: Controls (7 cols) -->
    <div class="lg:col-span-7 space-y-6">
      <section class="bg-surface-soft border border-hairline rounded-2xl p-6 sm:p-7 shadow-xs">
        <div class="flex items-center justify-between pb-4 mb-6 border-b border-hairline">
          <div>
            <h2 class="text-lg font-bold text-ink">{d.controlsTitle}</h2>
            <p class="text-xs text-muted mt-0.5">{d.controlsSub}</p>
          </div>
          <span class="text-xs font-mono px-2.5 py-1 rounded-md bg-surface border border-hairline text-muted">
            ISO 14644-1 / 3-A
          </span>
        </div>

        <!-- Presets Selection Bar -->
        <div class="mb-6 p-4 rounded-xl bg-surface border border-hairline">
          <label for="hdj-preset-select" class="block text-xs font-bold uppercase tracking-wider text-muted mb-2">
            ⚡ {d.presetsTitle}
          </label>
          <select 
            id="hdj-preset-select"
            class="w-full bg-surface-soft border border-hairline rounded-lg px-3 py-2 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-sky-500 font-medium"
          >
            <option value="curcumin">{d.presetCurcumin}</option>
            <option value="omega3">{d.presetOmega3}</option>
            <option value="vitaminc">{d.presetVitaminC}</option>
            <option value="flavor">{d.presetFlavor}</option>
            <option value="hazard">{d.presetHazard}</option>
          </select>
        </div>

        <!-- Skid Architecture Select -->
        <div class="space-y-4 mb-6">
          <div>
            <label for="hdj-system-select" class="block text-sm font-semibold text-ink mb-1">
              {d.systemLabel}
            </label>
            <select 
              id="hdj-system-select"
              class="w-full bg-surface border border-hairline rounded-lg px-3 py-2.5 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-sky-500"
            >
              {hdjData.systemArchitectures.map(sys => (
                <option value={sys.id}>{sys.name}</option>
              ))}
            </select>
            <p class="text-xs text-muted mt-1">{d.systemHelp}</p>
          </div>

          <!-- Bioactive Select -->
          <div>
            <label for="hdj-bioactive-select" class="block text-sm font-semibold text-ink mb-1">
              {d.bioactiveLabel}
            </label>
            <select 
              id="hdj-bioactive-select"
              class="w-full bg-surface border border-hairline rounded-lg px-3 py-2.5 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-sky-500"
            >
              {hdjData.bioactiveSubstrates.map(bio => (
                <option value={bio.id}>{bio.name} ({bio.category})</option>
              ))}
            </select>
            <p class="text-xs text-muted mt-1">{d.bioactiveHelp}</p>
          </div>

          <!-- Chamber Geometry Select -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="hdj-chamber-select" class="block text-sm font-semibold text-ink mb-1">
                {d.chamberLabel}
              </label>
              <select 
                id="hdj-chamber-select"
                class="w-full bg-surface border border-hairline rounded-lg px-3 py-2 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-sky-500"
              >
                {hdjData.collisionChamberTechnologies.map(ch => (
                  <option value={ch.type}>{ch.name}</option>
                ))}
              </select>
              <p class="text-xs text-muted mt-1">{d.chamberHelp}</p>
            </div>

            <!-- Quench Exchanger Select -->
            <div>
              <label for="hdj-quench-select" class="block text-sm font-semibold text-ink mb-1">
                {d.quenchLabel}
              </label>
              <select 
                id="hdj-quench-select"
                class="w-full bg-surface border border-hairline rounded-lg px-3 py-2 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-sky-500"
              >
                {hdjData.inLineQuenchSystems.map(q => (
                  <option value={q.id}>{q.name}</option>
                ))}
              </select>
              <p class="text-xs text-muted mt-1">{d.quenchHelp}</p>
            </div>
          </div>
        </div>

        <!-- Sliders -->
        <div class="space-y-5 pt-4 border-t border-hairline">
          <!-- Pressure Range -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label for="hdj-pressure-range" class="text-sm font-semibold text-ink">{d.pressureLabel}</label>
              <span id="hdj-pressure-val" class="text-sm font-mono font-bold text-sky-600 dark:text-sky-400">210.0 MPa</span>
            </div>
            <input 
              id="hdj-pressure-range" 
              type="range" 
              min="100.0" 
              max="300.0" 
              step="5.0" 
              value="210.0"
              class="w-full accent-sky-600 cursor-pointer"
            />
            <p class="text-xs text-muted mt-0.5">{d.pressureHelp}</p>
          </div>

          <!-- Volumetric Throughput Range -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label for="hdj-flow-range" class="text-sm font-semibold text-ink">{d.throughputLabel}</label>
              <span id="hdj-flow-val" class="text-sm font-mono font-bold text-sky-600 dark:text-sky-400">420 L/h</span>
            </div>
            <input 
              id="hdj-flow-range" 
              type="range" 
              min="50" 
              max="1500" 
              step="25" 
              value="420"
              class="w-full accent-sky-600 cursor-pointer"
            />
            <p class="text-xs text-muted mt-0.5">{d.throughputHelp}</p>
          </div>

          <!-- Homogenization Passes Range -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
              <div class="flex justify-between items-center mb-1">
                <label for="hdj-passes-range" class="text-sm font-semibold text-ink">{d.passesLabel}</label>
                <span id="hdj-passes-val" class="text-sm font-mono font-bold text-sky-600 dark:text-sky-400">2 Passes</span>
              </div>
              <input 
                id="hdj-passes-range" 
                type="range" 
                min="1" 
                max="5" 
                step="1" 
                value="2"
                class="w-full accent-sky-600 cursor-pointer"
              />
              <p class="text-xs text-muted mt-0.5">{d.passesHelp}</p>
            </div>

            <!-- Feed Temperature Range -->
            <div>
              <div class="flex justify-between items-center mb-1">
                <label for="hdj-temp-range" class="text-sm font-semibold text-ink">{d.feedTempLabel}</label>
                <span id="hdj-temp-val" class="text-sm font-mono font-bold text-sky-600 dark:text-sky-400">25.0°C</span>
              </div>
              <input 
                id="hdj-temp-range" 
                type="range" 
                min="15.0" 
                max="55.0" 
                step="0.5" 
                value="25.0"
                class="w-full accent-sky-600 cursor-pointer"
              />
              <p class="text-xs text-muted mt-0.5">{d.feedTempHelp}</p>
            </div>

            <!-- Backpressure Range -->
            <div>
              <div class="flex justify-between items-center mb-1">
                <label for="hdj-backpressure-range" class="text-sm font-semibold text-ink">{d.backpressureLabel}</label>
                <span id="hdj-backpressure-val" class="text-sm font-mono font-bold text-sky-600 dark:text-sky-400">12.0 MPa</span>
              </div>
              <input 
                id="hdj-backpressure-range" 
                type="range" 
                min="2.0" 
                max="25.0" 
                step="0.5" 
                value="12.0"
                class="w-full accent-sky-600 cursor-pointer"
              />
              <p class="text-xs text-muted mt-0.5">{d.backpressureHelp}</p>
            </div>
          </div>
        </div>
      </section>
    </div>

    <!-- Right Column: Diagnostics & Live Telemetry (5 cols) -->
    <div class="lg:col-span-5 space-y-6">
      <section class="bg-surface-soft border border-hairline rounded-2xl p-6 sm:p-7 shadow-xs">
        <div class="flex items-center justify-between pb-4 mb-6 border-b border-hairline">
          <div>
            <h2 class="text-lg font-bold text-ink">{d.diagnosticTitle}</h2>
            <p class="text-xs text-muted mt-0.5">{d.diagnosticSub}</p>
          </div>
          <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-xs font-mono font-semibold bg-emerald-950 text-emerald-300 border border-emerald-800">
            ONLINE
          </span>
        </div>

        <!-- Primary KPI Cards: Mean Size & Encapsulation -->
        <div class="grid grid-cols-2 gap-4 mb-4">
          <div class="p-4 rounded-xl bg-surface border border-hairline">
            <span class="text-xs text-muted block mb-1">{d.liposomeSizeLabel}</span>
            <span id="hdj-diag-size" class="text-2xl sm:text-3xl font-black font-mono text-sky-600 dark:text-sky-400">
              52.4 nm
            </span>
            <span class="text-[10px] text-muted block mt-1">D32 / Z-Average (DLS)</span>
          </div>

          <div class="p-4 rounded-xl bg-surface border border-hairline">
            <span class="text-xs text-muted block mb-1">{d.encapsulationLabel}</span>
            <span id="hdj-diag-encap" class="text-2xl sm:text-3xl font-black font-mono text-emerald-600 dark:text-emerald-400">
              95.2%
            </span>
            <span class="text-[10px] text-muted block mt-1">Active Entrapment Yield</span>
          </div>
        </div>

        <!-- Secondary KPI Cards -->
        <div class="grid grid-cols-2 gap-4 mb-4">
          <div class="p-4 rounded-xl bg-surface border border-hairline">
            <span class="text-xs text-muted block mb-1">{d.pdiLabel}</span>
            <span id="hdj-diag-pdi" class="text-xl font-bold font-mono text-ink">
              0.088
            </span>
            <span class="text-[10px] text-emerald-600 dark:text-emerald-400 block mt-0.5">Ultra-Monodisperse (&lt;0.10)</span>
          </div>

          <div class="p-4 rounded-xl bg-surface border border-hairline">
            <span class="text-xs text-muted block mb-1">{d.jetVelocityLabel}</span>
            <span id="hdj-diag-velocity" class="text-xl font-bold font-mono text-ink">
              560 m/s
            </span>
            <span class="text-[10px] text-muted block mt-0.5">Sonic Orifice Discharge</span>
          </div>
        </div>

        <!-- Fluid Mechanics & Shear Grid -->
        <div class="space-y-3 p-4 rounded-xl bg-surface border border-hairline mb-4 text-xs font-mono">
          <div class="flex items-center justify-between">
            <span class="text-muted">{d.shearRateLabel}</span>
            <span id="hdj-diag-shear" class="font-bold text-ink">1.45 &times; 10⁷ s⁻¹</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-muted">{d.exitTempLabel}</span>
            <span id="hdj-diag-exit-temp" class="font-bold text-emerald-600 dark:text-emerald-400">18.4°C (Safe)</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-muted">{d.cavitationFactorLabel}</span>
            <span id="hdj-diag-cavitation" class="font-bold text-emerald-600 dark:text-emerald-400">0.00 / Suppressed</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-muted">{d.energyKwhLabel}</span>
            <span id="hdj-diag-energy" class="font-bold text-ink">64.5 kWh/m³</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-muted">{d.shelfStabilityLabel}</span>
            <span id="hdj-diag-stability" class="font-bold text-ink">365+ Days (&gt;12 Mos)</span>
          </div>
        </div>

        <!-- Compliance & Overall Status Banner -->
        <div class="p-4 rounded-xl border border-hairline bg-surface flex flex-col justify-between">
          <span class="text-xs text-muted uppercase font-bold tracking-wider mb-1">{d.overallStatusLabel}</span>
          <div id="hdj-diag-status" class="text-base font-extrabold text-emerald-600 dark:text-emerald-400">
            3-A SANITARY 04-05 &amp; 44-03 PASS
          </div>
          <p id="hdj-diag-status-sub" class="text-xs text-muted mt-1">
            EHEDG Class I Aseptic Cleanable / FDA 21 CFR § 117 Validated
          </p>
        </div>
      </section>
    </div>
  </div>

  <!-- Interactive SVG Physics Schematic -->
  <section class="bg-surface-soft border border-hairline rounded-3xl p-6 sm:p-10 mb-12 shadow-xs">
    <div class="max-w-3xl mb-6">
      <h2 class="text-xl sm:text-2xl font-bold text-ink mb-2">{d.diagramTitle}</h2>
      <p class="text-sm text-body">{d.diagramSub}</p>
    </div>

    <div class="overflow-hidden rounded-2xl border border-hairline bg-slate-950 p-4 sm:p-8">
      <svg viewBox="0 0 960 480" class="w-full h-auto text-white select-none" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <!-- Gradient for Inflow -->
          <linearGradient id="inflowGrad" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.2" />
            <stop offset="100%" stop-color="#0284c7" stop-opacity="0.9" />
          </linearGradient>
          <!-- Gradient for Opposed Micro-Jets -->
          <linearGradient id="jetGradLeft" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#0284c7" />
            <stop offset="100%" stop-color="#38bdf8" />
          </linearGradient>
          <linearGradient id="jetGradRight" x1="100%" y1="0%" x2="0%" y2="0%">
            <stop offset="0%" stop-color="#0284c7" />
            <stop offset="100%" stop-color="#38bdf8" />
          </linearGradient>
          <!-- Collision Focal Glow -->
          <radialGradient id="collisionGlow" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#f59e0b" stop-opacity="1" />
            <stop offset="40%" stop-color="#ea580c" stop-opacity="0.8" />
            <stop offset="70%" stop-color="#38bdf8" stop-opacity="0.3" />
            <stop offset="100%" stop-color="#0284c7" stop-opacity="0" />
          </radialGradient>
          <!-- Cryo Quench Exchanger Grad -->
          <linearGradient id="quenchGrad" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#ea580c" stop-opacity="0.8" />
            <stop offset="40%" stop-color="#38bdf8" stop-opacity="0.9" />
            <stop offset="100%" stop-color="#10b981" stop-opacity="0.9" />
          </linearGradient>
        </defs>

        <!-- Outer Boundary & Piping Grid -->
        <rect x="20" y="20" width="920" height="440" rx="16" fill="#090d16" stroke="#1e293b" stroke-width="2"/>

        <!-- Flow Channel Guide Lines -->
        <path d="M 60 240 L 220 240 L 320 180 L 420 220" fill="none" stroke="#1e293b" stroke-width="44" stroke-linecap="round"/>
        <path d="M 60 240 L 220 240 L 320 300 L 420 260" fill="none" stroke="#1e293b" stroke-width="44" stroke-linecap="round"/>

        <!-- High-Pressure Feed Manifold -->
        <rect x="50" y="200" width="130" height="80" rx="10" fill="#1e293b" stroke="#38bdf8" stroke-width="2"/>
        <text x="115" y="235" fill="#38bdf8" font-size="12" font-family="monospace" font-weight="bold" text-anchor="middle">INTENSIFIER PUMP</text>
        <text x="115" y="255" fill="#94a3b8" font-size="11" font-family="monospace" text-anchor="middle">100–300 MPa</text>

        <!-- Split Streams into Dual Micro-Capillaries -->
        <path d="M 180 240 C 240 240 250 170 330 170" fill="none" stroke="#0284c7" stroke-width="12" stroke-linecap="round"/>
        <path d="M 180 240 C 240 240 250 310 330 310" fill="none" stroke="#0284c7" stroke-width="12" stroke-linecap="round"/>

        <!-- Opposed Diamond Interaction Chamber Block -->
        <rect x="360" y="100" width="240" height="280" rx="14" fill="#0f172a" stroke="#0284c7" stroke-width="3"/>
        <text x="480" y="130" fill="#38bdf8" font-size="13" font-family="monospace" font-weight="bold" text-anchor="middle">DIAMOND INTERACTION CHAMBER</text>
        <text x="480" y="148" fill="#64748b" font-size="10" font-family="monospace" text-anchor="middle">Y-Type Opposed Capillaries (75 µm)</text>

        <!-- Left Micro-Capillary Nozzle -->
        <path d="M 330 170 L 430 235" fill="none" stroke="url(#jetGradLeft)" stroke-width="5" stroke-linecap="round"/>
        <!-- Right Opposed Micro-Capillary Nozzle -->
        <path d="M 330 310 L 430 245" fill="none" stroke="url(#jetGradRight)" stroke-width="5" stroke-linecap="round"/>

        <!-- Frontal Micro-Jets Entering Collision Hub -->
        <line x1="410" y1="230" x2="475" y2="240" stroke="#38bdf8" stroke-width="6" stroke-linecap="round"/>
        <line x1="550" y1="240" x2="485" y2="240" stroke="#38bdf8" stroke-width="6" stroke-linecap="round"/>

        <!-- Opposed Fluid Collision Node (Focal Explosion Glow) -->
        <circle cx="480" cy="240" r="42" fill="url(#collisionGlow)" />
        <circle cx="480" cy="240" r="14" fill="#f59e0b" />
        <circle cx="480" cy="240" r="6" fill="#ffffff" />

        <text x="480" y="275" fill="#fef08a" font-size="11" font-family="monospace" font-weight="bold" text-anchor="middle">OPPOSED COLLISION</text>
        <text x="480" y="292" fill="#93c5fd" font-size="10" font-family="monospace" text-anchor="middle">v_jet: 560 m/s | γ̇ &gt; 10⁷ s⁻¹</text>

        <!-- Giant MLVs Disrupted into Sub-60nm SUVs (Particles) -->
        <!-- Inflow MLVs (Large circles) -->
        <circle cx="210" cy="210" r="12" fill="none" stroke="#38bdf8" stroke-width="2"/>
        <circle cx="210" cy="210" r="7" fill="none" stroke="#38bdf8" stroke-width="1.5"/>
        <circle cx="210" cy="270" r="14" fill="none" stroke="#38bdf8" stroke-width="2"/>
        <circle cx="210" cy="270" r="8" fill="none" stroke="#38bdf8" stroke-width="1.5"/>
        <text x="210" y="305" fill="#64748b" font-size="9" font-family="monospace" text-anchor="middle">Giant MLVs (&gt;1,000 nm)</text>

        <!-- Exit Channel (Discharged High-Shear Fluid) -->
        <path d="M 500 240 L 640 240" fill="none" stroke="#ea580c" stroke-width="16" stroke-linecap="round"/>

        <!-- In-Line Cryogenic Glycol Quench Exchanger -->
        <rect x="640" y="160" width="180" height="160" rx="12" fill="#1e293b" stroke="#10b981" stroke-width="2"/>
        <text x="730" y="190" fill="#10b981" font-size="12" font-family="monospace" font-weight="bold" text-anchor="middle">IN-LINE GLYCOL QUENCH</text>
        <text x="730" y="206" fill="#64748b" font-size="10" font-family="monospace" text-anchor="middle">ΔT = -32°C in &lt;120 ms</text>

        <!-- Cooling Coil Geometry Inside Exchanger -->
        <path d="M 660 220 C 680 200 700 240 720 220 C 740 200 760 240 780 220 L 800 220" fill="none" stroke="#38bdf8" stroke-width="4" stroke-dasharray="4,4"/>
        <path d="M 660 240 C 680 220 700 260 720 240 C 740 220 760 260 780 240 L 800 240" fill="none" stroke="#10b981" stroke-width="6"/>
        <path d="M 660 260 C 680 240 700 280 720 260 C 740 240 760 280 780 260 L 800 260" fill="none" stroke="#38bdf8" stroke-width="4" stroke-dasharray="4,4"/>

        <!-- Post-Quench Aseptic Exit Stream -->
        <path d="M 820 240 L 900 240" fill="none" stroke="#10b981" stroke-width="14" stroke-linecap="round"/>

        <!-- Quenched Sub-60nm Nano-Liposomes (Small dense green circles) -->
        <circle cx="850" cy="235" r="3.5" fill="#10b981" />
        <circle cx="865" cy="245" r="3.0" fill="#34d399" />
        <circle cx="880" cy="238" r="3.2" fill="#10b981" />
        <circle cx="860" cy="232" r="2.8" fill="#6ee7b7" />
        <circle cx="875" cy="248" r="3.1" fill="#34d399" />
        <text x="865" y="270" fill="#34d399" font-size="10" font-family="monospace" font-weight="bold" text-anchor="middle">SUVs (40–60 nm)</text>
        <text x="865" y="285" fill="#6ee7b7" font-size="9" font-family="monospace" text-anchor="middle">PDI &lt; 0.09 &bull; EE &gt; 94%</text>

        <!-- Dynamic Indicator Badges -->
        <g transform="translate(60, 390)">
          <rect x="0" y="0" width="240" height="42" rx="8" fill="#1e293b" stroke="#334155"/>
          <text x="12" y="18" fill="#94a3b8" font-size="10" font-family="monospace">JET COLLISION VELOCITY</text>
          <text id="svg-jet-speed" x="12" y="34" fill="#38bdf8" font-size="13" font-family="monospace" font-weight="bold">v_jet = 560 m/s</text>
        </g>

        <g transform="translate(360, 390)">
          <rect x="0" y="0" width="240" height="42" rx="8" fill="#1e293b" stroke="#334155"/>
          <text x="12" y="18" fill="#94a3b8" font-size="10" font-family="monospace">ELONGATIONAL SHEAR RATE</text>
          <text id="svg-shear-rate" x="12" y="34" fill="#f59e0b" font-size="13" font-family="monospace" font-weight="bold">γ̇ = 1.45 &times; 10⁷ s⁻¹</text>
        </g>

        <g transform="translate(660, 390)">
          <rect x="0" y="0" width="240" height="42" rx="8" fill="#1e293b" stroke="#334155"/>
          <text x="12" y="18" fill="#94a3b8" font-size="10" font-family="monospace">POST-QUENCH BULK TEMP</text>
          <text id="svg-quench-temp" x="12" y="34" fill="#10b981" font-size="13" font-family="monospace" font-weight="bold">T_exit = 18.4°C (Preserved)</text>
        </g>
      </svg>
    </div>
  </section>

  <!-- Comprehensive Biophysical Science & Engineering Guide -->
  <section class="bg-surface-soft border border-hairline rounded-3xl p-6 sm:p-10 mb-12 shadow-xs prose dark:prose-invert max-w-none">
    <div class="border-b border-hairline pb-4 mb-6">
      <h2 class="text-xl sm:text-2xl font-extrabold text-ink tracking-tight">{d.scienceTitle}</h2>
      <p class="text-sm text-muted mt-1">{d.scienceSub}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-body text-sm leading-relaxed">
      <div>
        <h3 class="text-base font-bold text-ink mb-2">1. Fluid Dynamics of Opposed Micro-Capillary Collisions</h3>
        <p>
          Unlike standard high-pressure valve homogenizers that force fluid against a stationary impact ring, High-Pressure Micro-Capillary Colliding Hydrodynamic Jet (HC-HDJ) technology splits a pressurized fluid stream (100–300 MPa) into dual opposing micro-capillaries (50–100 µm aperture). Utilizing Bernoulli acceleration:
        </p>
        <p class="font-mono text-xs bg-surface p-2.5 rounded-lg border border-hairline my-2">
          v_jet = C_d &times; &radic;(2 &Delta;P / &rho;) &asymp; 560 m/s (at 210 MPa)
        </p>
        <p>
          The two coherent liquid jets collide directly against each other at their focal impingement point. This fluid-on-fluid collision dissipates massive kinetic energy directly within the liquid phase. The resulting elongational shear rate (&gamma;&dot; &gt; 10⁷ s⁻¹) shreds coarse multi-lamellar vesicles (MLVs, 1,000–5,000 nm) into uniform small unilamellar vesicles (SUVs, 40–80 nm) within nanoseconds.
        </p>
      </div>

      <div>
        <h3 class="text-base font-bold text-ink mb-2">2. Hydrodynamic Temperature Rise &amp; Cryo-Quenching</h3>
        <p>
          Pumping incompressible fluid across a 200+ MPa pressure differential inherently converts fluid friction and viscous dissipation into adiabatic heat:
        </p>
        <p class="font-mono text-xs bg-surface p-2.5 rounded-lg border border-hairline my-2">
          &Delta;T_ad = (&Delta;P / (&rho; &times; C_p)) &times; (1 - &eta;_mech) &asymp; +2.2&deg;C per 10 MPa
        </p>
        <p>
          At 210 MPa, the transient temperature rise inside the collision cavity reaches +46.2°C, temporarily fluidizing the lipid bilayer into the liquid-crystalline state (L&alpha;). To prevent oxidative degradation of sensitive omega-3 fatty acids or thermal denaturation of polyphenols (curcumin, resveratrol), the continuous skid routes the product stream directly through an in-line chilled glycol quench exchanger, dropping the bulk temperature below 20°C in under 120 milliseconds.
        </p>
      </div>

      <div>
        <h3 class="text-base font-bold text-ink mb-2">3. Zero Metallic Wear &amp; Elimination of Cavitation Erosion</h3>
        <p>
          Traditional high-pressure valve homogenizers experience severe cavitation pitting and erosion along valve seats, releasing microscopic tungsten carbide or steel particles into the food stream. Furthermore, ultrasonic sonication probes shed titanium particulates over time.
        </p>
        <p>
          HC-HDJ utilizes single-crystal synthetic diamond chambers. Because the primary collision occurs fluid-on-fluid in the central collision node rather than against a solid metallic wall, wall shear erosion is virtually zero (erosion rate = 0.000 mm/1,000 h). Regulated backpressure (P_back &ge; 10 MPa) maintains local hydrostatic pressure above the vapor pressure threshold, completely suppressing erosive vapor bubble collapse.
        </p>
      </div>

      <div>
        <h3 class="text-base font-bold text-ink mb-2">4. Sanitary Compliance: 3-A Standards &amp; EHEDG Aseptic Design</h3>
        <p>
          To satisfy commercial food and dairy safety guidelines:
        </p>
        <ul class="list-disc pl-5 space-y-1.5 mt-2">
          <li><strong>3-A Standard 04-05:</strong> All pump cylinders and plunger packings are designed for complete drainability and non-contaminating operation.</li>
          <li><strong>3-A Standard 44-03:</strong> High-pressure interaction cavities and boundary components feature electropolished AISI 316L stainless steel (Ra &le; 0.38 &micro;m / 15 &micro;-in) with crevice-free geometries.</li>
          <li><strong>3-A Standard 74-07:</strong> Flush-diaphragm pressure transducers eliminate dead-legs (L/D &lt; 1.5).</li>
          <li><strong>EHEDG Class I &amp; FDA 21 CFR &sect; 117:</strong> Fully validated Clean-In-Place (CIP) and Steam-In-Place (SIP, 130&deg;C for 30 min) protocols ensure zero microbial harboring and complete allergen wash-out.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Technical Specifications Reference Table -->
  <section class="bg-surface-soft border border-hairline rounded-3xl p-6 sm:p-10 mb-8 shadow-xs">
    <h2 class="text-xl font-bold text-ink mb-4">{d.tableTitle}</h2>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs border-collapse">
        <thead>
          <tr class="border-b border-hairline bg-surface text-ink font-bold">
            <th class="p-3">System Architecture</th>
            <th class="p-3">Chamber Tech</th>
            <th class="p-3">Max Press (MPa)</th>
            <th class="p-3">Flow (L/h)</th>
            <th class="p-3">Mean Size (nm)</th>
            <th class="p-3">PDI</th>
            <th class="p-3">EE (%)</th>
            <th class="p-3">Sanitary Certification</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline text-muted font-mono">
          {hdjData.systemArchitectures.map(sys => (
            <tr class="hover:bg-surface/50 transition-colors">
              <td class="p-3 font-semibold text-ink font-sans">{sys.name}</td>
              <td class="p-3">{sys.interactionChamberTechnology.split('(')[0]}</td>
              <td class="p-3 text-sky-600 dark:text-sky-400 font-bold">{sys.maximumOperatingPressureMPa}</td>
              <td class="p-3">{sys.continuousThroughputLitersPerHour}</td>
              <td class="p-3 text-emerald-600 dark:text-emerald-400 font-bold">{sys.typicalMeanLiposomeSizeNm}</td>
              <td class="p-3">{sys.typicalPdi}</td>
              <td class="p-3 text-emerald-600 dark:text-emerald-400 font-bold">{sys.typicalEncapsulationEfficiencyPct}%</td>
              <td class="p-3 font-sans text-[11px]">{sys.classification.split('/')[0]}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</div>

<!-- Interactive Client-Side Simulation Script -->
<script>
  function initHdjSimulator() {
    // Inputs
    const presetSelect = document.getElementById('hdj-preset-select') as HTMLSelectElement | null;
    const systemSelect = document.getElementById('hdj-system-select') as HTMLSelectElement | null;
    const bioactiveSelect = document.getElementById('hdj-bioactive-select') as HTMLSelectElement | null;
    const chamberSelect = document.getElementById('hdj-chamber-select') as HTMLSelectElement | null;
    const quenchSelect = document.getElementById('hdj-quench-select') as HTMLSelectElement | null;

    const pressureRange = document.getElementById('hdj-pressure-range') as HTMLInputElement | null;
    const flowRange = document.getElementById('hdj-flow-range') as HTMLInputElement | null;
    const passesRange = document.getElementById('hdj-passes-range') as HTMLInputElement | null;
    const tempRange = document.getElementById('hdj-temp-range') as HTMLInputElement | null;
    const backpressureRange = document.getElementById('hdj-backpressure-range') as HTMLInputElement | null;

    // Value Badges
    const pressureVal = document.getElementById('hdj-pressure-val');
    const flowVal = document.getElementById('hdj-flow-val');
    const passesVal = document.getElementById('hdj-passes-val');
    const tempVal = document.getElementById('hdj-temp-val');
    const backpressureVal = document.getElementById('hdj-backpressure-val');

    // Diagnostics Elements
    const diagSize = document.getElementById('hdj-diag-size');
    const diagEncap = document.getElementById('hdj-diag-encap');
    const diagPdi = document.getElementById('hdj-diag-pdi');
    const diagVelocity = document.getElementById('hdj-diag-velocity');
    const diagShear = document.getElementById('hdj-diag-shear');
    const diagExitTemp = document.getElementById('hdj-diag-exit-temp');
    const diagCavitation = document.getElementById('hdj-diag-cavitation');
    const diagEnergy = document.getElementById('hdj-diag-energy');
    const diagStability = document.getElementById('hdj-diag-stability');
    const diagStatus = document.getElementById('hdj-diag-status');
    const diagStatusSub = document.getElementById('hdj-diag-status-sub');

    // SVG Badges
    const svgJetSpeed = document.getElementById('svg-jet-speed');
    const svgShearRate = document.getElementById('svg-shear-rate');
    const svgQuenchTemp = document.getElementById('svg-quench-temp');

    function recalculate() {
      const pressure = parseFloat(pressureRange?.value || '210.0');
      const flow = parseFloat(flowRange?.value || '420');
      const passes = parseInt(passesRange?.value || '2', 10);
      const feedTemp = parseFloat(tempRange?.value || '25.0');
      const backpressure = parseFloat(backpressureRange?.value || '12.0');
      const chamber = chamberSelect?.value || 'opposed_y_diamond';
      const quench = quenchSelect?.value || 'sanitary_dual_tube_glycol';
      const bioactive = bioactiveSelect?.value || 'curcumin_phytosome_complex';

      // Update Slider Display Texts
      if (pressureVal) pressureVal.textContent = `${pressure.toFixed(1)} MPa`;
      if (flowVal) flowVal.textContent = `${flow.toFixed(0)} L/h`;
      if (passesVal) passesVal.textContent = `${passes} ${passes === 1 ? 'Pass' : 'Passes'}`;
      if (tempVal) tempVal.textContent = `${feedTemp.toFixed(1)}°C`;
      if (backpressureVal) backpressureVal.textContent = `${backpressure.toFixed(1)} MPa`;

      // 1. Bernoulli Jet Velocity
      // v = Cd * sqrt(2 * deltaP / rho), with rho = 1010 kg/m3, Cd = 0.88
      const deltaP_Pa = pressure * 1e6;
      const jetVelocity = 0.88 * Math.sqrt((2 * deltaP_Pa) / 1010.0);
      if (diagVelocity) diagVelocity.textContent = `${jetVelocity.toFixed(0)} m/s`;
      if (svgJetSpeed) svgJetSpeed.textContent = `v_jet = ${jetVelocity.toFixed(0)} m/s`;

      // 2. Elongational Shear Rate
      // gamma_dot = 2 * v_jet / d_aperture
      const aperture_m = chamber === 'concentric_hydrodynamic_nozzle' ? 50e-6 : (chamber === 'opposed_y_diamond' ? 75e-6 : 100e-6);
      const shearRate = (2 * jetVelocity) / aperture_m;
      const shearRateE7 = shearRate / 1e7;
      if (diagShear) diagShear.textContent = `${shearRateE7.toFixed(2)} × 10⁷ s⁻¹`;
      if (svgShearRate) svgShearRate.textContent = `γ̇ = ${shearRateE7.toFixed(2)} × 10⁷ s⁻¹`;

      // 3. Nano-Liposome Mean Size (D32 / Z-Average)
      // Size decreases with pressure^0.45 and passes^0.25
      let baseSize = 135.0;
      if (bioactive === 'curcumin_phytosome_complex') baseSize = 130.0;
      else if (bioactive === 'omega3_dha_epa_triacylglycerols') baseSize = 145.0;
      else if (bioactive === 'liposomal_ascorbic_acid_glutathione') baseSize = 115.0;
      else if (bioactive === 'plant_based_milk_flavor_essence') baseSize = 105.0;
      else if (bioactive === 'resveratrol_pterostilbene_stilbenoids') baseSize = 125.0;
      else if (bioactive === 'coenzyme_q10_ubiquinone_complex') baseSize = 150.0;

      const pressureFactor = Math.pow(pressure / 100.0, -0.48);
      const passesFactor = Math.pow(passes, -0.22);
      let liposomeSize = baseSize * pressureFactor * passesFactor;
      if (chamber === 'concentric_hydrodynamic_nozzle') liposomeSize *= 0.88;
      if (chamber === 'z_type_shearing_sapphire') liposomeSize *= 1.12;
      liposomeSize = Math.max(38.0, Math.min(180.0, liposomeSize));

      if (diagSize) diagSize.textContent = `${liposomeSize.toFixed(1)} nm`;

      // 4. Polydispersity Index (PDI)
      let pdi = 0.18 - (pressure / 300.0 * 0.07) - (passes * 0.015);
      if (chamber === 'opposed_y_diamond') pdi -= 0.02;
      if (chamber === 'concentric_hydrodynamic_nozzle') pdi -= 0.03;
      pdi = Math.max(0.065, Math.min(0.28, pdi));
      if (diagPdi) {
        diagPdi.textContent = pdi.toFixed(3);
        diagPdi.className = pdi < 0.10 ? 'text-xl font-bold font-mono text-emerald-600 dark:text-emerald-400' : (pdi < 0.18 ? 'text-xl font-bold font-mono text-ink' : 'text-xl font-bold font-mono text-amber-600');
      }

      // 5. Encapsulation Efficiency (EE%)
      let baseEE = 91.5;
      if (bioactive === 'curcumin_phytosome_complex') baseEE = 94.0;
      else if (bioactive === 'resveratrol_pterostilbene_stilbenoids') baseEE = 95.0;
      else if (bioactive === 'plant_based_milk_flavor_essence') baseEE = 96.5;
      else if (bioactive === 'liposomal_ascorbic_acid_glutathione') baseEE = 89.0;

      let encapYield = baseEE + ((pressure - 100) / 200 * 3.5) + ((passes - 1) * 0.8);
      // Thermal penalty if quench is poor
      const adiabaticRise = (pressure / 10.0) * 2.2;
      let quenchCooling = -32.0;
      if (quench === 'micro_channel_plate_chiller') quenchCooling = -38.0;
      else if (quench === 'unassisted_cooling_warning') quenchCooling = -4.0;

      const exitTemp = Math.max(8.0, feedTemp + adiabaticRise + quenchCooling);

      if (exitTemp > 45.0) {
        encapYield -= (exitTemp - 45.0) * 0.6; // thermal degradation of vesicle & payload
      }
      encapYield = Math.max(62.0, Math.min(98.8, encapYield));
      if (diagEncap) diagEncap.textContent = `${encapYield.toFixed(1)}%`;

      // 6. Exit Temperature Badge
      if (diagExitTemp) {
        diagExitTemp.textContent = `${exitTemp.toFixed(1)}°C (${exitTemp <= 30.0 ? 'Preserved' : (exitTemp <= 45.0 ? 'Elevated' : 'Heat Hazard')})`;
        diagExitTemp.className = exitTemp <= 30.0 ? 'font-bold text-emerald-600 dark:text-emerald-400' : (exitTemp <= 45.0 ? 'font-bold text-amber-600' : 'font-bold text-rose-600');
      }
      if (svgQuenchTemp) {
        svgQuenchTemp.textContent = `T_exit = ${exitTemp.toFixed(1)}°C (${exitTemp <= 30.0 ? 'Preserved' : 'Elevated'})`;
        svgQuenchTemp.setAttribute('fill', exitTemp <= 30.0 ? '#10b981' : (exitTemp <= 45.0 ? '#f59e0b' : '#ef4444'));
      }

      // 7. Cavitation Suppression Factor
      // Psi = (P_back - P_vapor) / (0.5 * rho * v_jet^2 * cavitation_number)
      const cavitationSafe = backpressure >= 8.0;
      if (diagCavitation) {
        if (cavitationSafe) {
          diagCavitation.textContent = '0.00 / Suppressed (Zero Pitting)';
          diagCavitation.className = 'font-bold text-emerald-600 dark:text-emerald-400';
        } else {
          diagCavitation.textContent = '0.45 / High Cavitation Risk';
          diagCavitation.className = 'font-bold text-rose-600';
        }
      }

      // 8. Specific Energy Consumption
      // E = deltaP (in MPa) / 3.6 (approx kWh/m3) * passes
      const energyKwh = ((pressure / 3.6) * passes) * 1.05;
      if (diagEnergy) diagEnergy.textContent = `${energyKwh.toFixed(1)} kWh/m³`;

      // 9. Colloidal Stability Days
      let stabilityDays = 365;
      if (pdi < 0.10 && liposomeSize < 70) stabilityDays = 420;
      if (exitTemp > 45.0) stabilityDays = 90;
      if (!cavitationSafe) stabilityDays = Math.min(stabilityDays, 120);
      if (diagStability) diagStability.textContent = `${stabilityDays}+ Days (${(stabilityDays/30).toFixed(0)} Mos)`;

      // 10. Compliance Status
      if (diagStatus && diagStatusSub) {
        if (cavitationSafe && exitTemp <= 35.0 && encapYield >= 90.0) {
          diagStatus.textContent = '3-A SANITARY 04-05 & 44-03 PASS';
          diagStatus.className = 'text-base font-extrabold text-emerald-600 dark:text-emerald-400';
          diagStatusSub.textContent = 'EHEDG Class I Aseptic Cleanable / FDA 21 CFR § 117 Validated';
        } else if (exitTemp <= 45.0 && encapYield >= 80.0) {
          diagStatus.textContent = 'THERMAL ELEVATION WARNING';
          diagStatus.className = 'text-base font-extrabold text-amber-600 dark:text-amber-400';
          diagStatusSub.textContent = 'Bioactive Yield Sub-Optimal / Increase Cryo Glycol Quench Flow';
        } else {
          diagStatus.textContent = 'CRITICAL SANITARY & QUALITY FAULT';
          diagStatus.className = 'text-base font-extrabold text-rose-600 dark:text-rose-400';
          diagStatusSub.textContent = 'Severe Cavitation Risk or Bioactive Thermal Denaturation';
        }
      }
    }

    // Attach Event Listeners
    [pressureRange, flowRange, passesRange, tempRange, backpressureRange].forEach(input => {
      input?.addEventListener('input', recalculate);
    });

    [systemSelect, bioactiveSelect, chamberSelect, quenchSelect].forEach(sel => {
      sel?.addEventListener('change', recalculate);
    });

    presetSelect?.addEventListener('change', (e) => {
      const val = (e.target as HTMLSelectElement).value;
      if (val === 'curcumin') {
        if (pressureRange) pressureRange.value = '210.0';
        if (flowRange) flowRange.value = '420';
        if (passesRange) passesRange.value = '2';
        if (tempRange) tempRange.value = '25.0';
        if (backpressureRange) backpressureRange.value = '12.0';
        if (bioactiveSelect) bioactiveSelect.value = 'curcumin_phytosome_complex';
        if (systemSelect) systemSelect.value = 'commercial_opposed_jet_microfluidic_skid';
        if (chamberSelect) chamberSelect.value = 'opposed_y_diamond';
        if (quenchSelect) quenchSelect.value = 'sanitary_dual_tube_glycol';
      } else if (val === 'omega3') {
        if (pressureRange) pressureRange.value = '180.0';
        if (flowRange) flowRange.value = '550';
        if (passesRange) passesRange.value = '2';
        if (tempRange) tempRange.value = '20.0';
        if (backpressureRange) backpressureRange.value = '15.0';
        if (bioactiveSelect) bioactiveSelect.value = 'omega3_dha_epa_triacylglycerols';
        if (systemSelect) systemSelect.value = 'commercial_opposed_jet_microfluidic_skid';
        if (chamberSelect) chamberSelect.value = 'opposed_y_diamond';
        if (quenchSelect) quenchSelect.value = 'micro_channel_plate_chiller';
      } else if (val === 'vitaminc') {
        if (pressureRange) pressureRange.value = '240.0';
        if (flowRange) flowRange.value = '380';
        if (passesRange) passesRange.value = '3';
        if (tempRange) tempRange.value = '22.0';
        if (backpressureRange) backpressureRange.value = '14.0';
        if (bioactiveSelect) bioactiveSelect.value = 'liposomal_ascorbic_acid_glutathione';
        if (systemSelect) systemSelect.value = 'cleanroom_pilot_micro_orifice_validation_skid';
        if (chamberSelect) chamberSelect.value = 'opposed_y_diamond';
        if (quenchSelect) quenchSelect.value = 'sanitary_dual_tube_glycol';
      } else if (val === 'flavor') {
        if (pressureRange) pressureRange.value = '150.0';
        if (flowRange) flowRange.value = '280';
        if (passesRange) passesRange.value = '1';
        if (tempRange) tempRange.value = '18.0';
        if (backpressureRange) backpressureRange.value = '10.0';
        if (bioactiveSelect) bioactiveSelect.value = 'plant_based_milk_flavor_essence';
        if (systemSelect) systemSelect.value = 'concentric_sheath_nano_focusing_skid';
        if (chamberSelect) chamberSelect.value = 'concentric_hydrodynamic_nozzle';
        if (quenchSelect) quenchSelect.value = 'micro_channel_plate_chiller';
      } else if (val === 'hazard') {
        if (pressureRange) pressureRange.value = '290.0';
        if (flowRange) flowRange.value = '1200';
        if (passesRange) passesRange.value = '5';
        if (tempRange) tempRange.value = '48.0';
        if (backpressureRange) backpressureRange.value = '2.5';
        if (bioactiveSelect) bioactiveSelect.value = 'omega3_dha_epa_triacylglycerols';
        if (systemSelect) systemSelect.value = 'multi_channel_high_throughput_hdj_skid';
        if (chamberSelect) chamberSelect.value = 'z_type_shearing_sapphire';
        if (quenchSelect) quenchSelect.value = 'unassisted_cooling_warning';
      }
      recalculate();
    });

    // Initial calculation
    recalculate();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHdjSimulator);
  } else {
    initHdjSimulator();
  }
</script>
