};

const d = DICT[lang] || DICT.en;
---

<div class={`pan-inspector-wrapper ${embedded ? '' : 'p-6 md:p-8 bg-surface-soft border border-hairline rounded-xl shadow-xs'}`} data-lang={lang}>
  <!-- Header block -->
  <div class="mb-6">
    <div class="flex items-center gap-2 mb-2">
      <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded text-[11px] font-bold uppercase tracking-wider bg-signature-coral text-white">
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        {d.badge}
      </span>
      <span class="text-xs text-muted font-mono">v2.0 • Flinders Univ Standard</span>
    </div>
    <h3 class="text-title-lg md:text-display-md font-medium text-ink tracking-tight mb-2">
      {d.title}
    </h3>
    <p class="text-body text-[14px] leading-relaxed max-w-2xl">
      {d.subtitle}
    </p>
  </div>

  <!-- Interactive Container -->
  <div class="bg-white border border-hairline rounded-lg p-5 md:p-7 shadow-xs">
    <!-- Mode Tabs -->
    <div class="flex items-center border-b border-hairline pb-4 mb-6 gap-3">
      <button 
        type="button" 
        id="tab-upload-btn" 
        class="tab-btn px-4 py-2 rounded-full text-xs font-semibold uppercase tracking-wider bg-primary text-on-primary transition-all cursor-pointer"
      >
        📷 {d.tabUpload}
      </button>
      <button 
        type="button" 
        id="tab-quiz-btn" 
        class="tab-btn px-4 py-2 rounded-full text-xs font-semibold uppercase tracking-wider bg-surface-soft text-body hover:bg-surface-strong border border-hairline transition-all cursor-pointer"
      >
        📋 {d.tabQuiz}
      </button>
    </div>

    <!-- Upload Viewport Pane -->
    <div id="pane-upload" class="space-y-6">
      <!-- Drag & Drop Zone -->
      <div 
        id="dropzone"
        class="border-2 border-dashed border-hairline hover:border-signature-coral rounded-xl p-6 md:p-8 text-center transition-colors bg-surface-soft cursor-pointer relative"
      >
        <input 
          type="file" 
          id="pan-file-input" 
          accept="image/*" 
          capture="environment" 
          class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10" 
          aria-label="Upload pan photo"
        />
        <div class="flex flex-col items-center justify-center pointer-events-none">
          <div class="w-14 h-14 mb-3 rounded-full bg-white border border-hairline flex items-center justify-center text-signature-coral shadow-xs">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <h4 class="text-title-sm font-medium text-ink mb-1">{d.dropTitle}</h4>
          <p class="text-xs text-muted mb-4">{d.dropSub}</p>
          <span class="inline-block px-4 py-1.5 rounded-full text-xs font-semibold bg-white border border-hairline text-ink shadow-xs">
            Browse Photo / Take Picture
          </span>
        </div>
      </div>

      <!-- Quick Preset Sample Buttons -->
      <div class="pt-2">
        <span class="text-xs font-semibold text-muted uppercase tracking-wider block mb-2.5">{d.samplePrompt}</span>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
          <button 
            type="button" 
            data-sample="grade1"
            class="sample-btn text-left p-3 rounded-lg border border-hairline hover:border-green-600 bg-white hover:bg-green-50/50 transition-all text-xs cursor-pointer group"
          >
            <div class="flex items-center gap-2 mb-1">
              <span class="w-2.5 h-2.5 rounded-full bg-green-500 inline-block"></span>
              <span class="font-bold text-ink group-hover:text-green-800">Grade 1</span>
            </div>
            <p class="text-[12px] text-body line-clamp-2">{d.sample1}</p>
          </button>

          <button 
            type="button" 
            data-sample="grade3"
            class="sample-btn text-left p-3 rounded-lg border border-hairline hover:border-signature-coral bg-white hover:bg-red-50/50 transition-all text-xs cursor-pointer group"
          >
            <div class="flex items-center gap-2 mb-1">
              <span class="w-2.5 h-2.5 rounded-full bg-signature-coral inline-block"></span>
              <span class="font-bold text-ink group-hover:text-signature-coral">Grade 3</span>
            </div>
            <p class="text-[12px] text-body line-clamp-2">{d.sample2}</p>
          </button>

          <button 
            type="button" 
            data-sample="grade4"
            class="sample-btn text-left p-3 rounded-lg border border-hairline hover:border-red-800 bg-white hover:bg-red-50 transition-all text-xs cursor-pointer group"
          >
            <div class="flex items-center gap-2 mb-1">
              <span class="w-2.5 h-2.5 rounded-full bg-red-800 inline-block"></span>
              <span class="font-bold text-ink group-hover:text-red-900">Grade 4</span>
            </div>
            <p class="text-[12px] text-body line-clamp-2">{d.sample3}</p>
          </button>
        </div>
      </div>
    </div>

    <!-- Guided Questionnaire Pane -->
    <div id="pane-quiz" class="hidden space-y-5">
      <!-- Question 1 -->
      <div class="p-4 rounded-lg bg-surface-soft border border-hairline">
        <label class="block text-[14px] font-semibold text-ink mb-2.5">{d.q1Label}</label>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
          <label class="flex items-center gap-2 p-2.5 rounded-md bg-white border border-hairline cursor-pointer text-xs hover:border-primary">
            <input type="radio" name="inspector-q1" value="none" checked class="text-primary focus:ring-primary" />
            <span class="text-body">{d.q1Opt1}</span>
          </label>
          <label class="flex items-center gap-2 p-2.5 rounded-md bg-white border border-hairline cursor-pointer text-xs hover:border-primary">
            <input type="radio" name="inspector-q1" value="faint" class="text-primary focus:ring-primary" />
            <span class="text-body">{d.q1Opt2}</span>
          </label>
          <label class="flex items-center gap-2 p-2.5 rounded-md bg-white border border-hairline cursor-pointer text-xs hover:border-primary">
            <input type="radio" name="inspector-q1" value="metal" class="text-primary focus:ring-primary" />
            <span class="text-body font-semibold text-signature-coral">{d.q1Opt3}</span>
          </label>
        </div>
      </div>

      <!-- Question 2 -->
      <div class="p-4 rounded-lg bg-surface-soft border border-hairline">
        <label class="block text-[14px] font-semibold text-ink mb-2.5">{d.q2Label}</label>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <label class="flex items-center gap-2 p-2.5 rounded-md bg-white border border-hairline cursor-pointer text-xs hover:border-primary">
            <input type="radio" name="inspector-q2" value="no" checked class="text-primary focus:ring-primary" />
            <span class="text-body">{d.q2Opt1}</span>
          </label>
          <label class="flex items-center gap-2 p-2.5 rounded-md bg-white border border-hairline cursor-pointer text-xs hover:border-primary">
            <input type="radio" name="inspector-q2" value="yes" class="text-primary focus:ring-primary" />
            <span class="text-body font-semibold text-signature-coral">{d.q2Opt2}</span>
          </label>
        </div>
      </div>

      <!-- Question 3 -->
      <div class="p-4 rounded-lg bg-surface-soft border border-hairline">
        <label class="block text-[14px] font-semibold text-ink mb-2.5">{d.q3Label}</label>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <label class="flex items-center gap-2 p-2.5 rounded-md bg-white border border-hairline cursor-pointer text-xs hover:border-primary">
            <input type="radio" name="inspector-q3" value="no" checked class="text-primary focus:ring-primary" />
            <span class="text-body">{d.q3Opt1}</span>
          </label>
          <label class="flex items-center gap-2 p-2.5 rounded-md bg-white border border-hairline cursor-pointer text-xs hover:border-primary">
            <input type="radio" name="inspector-q3" value="yes" class="text-primary focus:ring-primary" />
            <span class="text-body">{d.q3Opt2}</span>
          </label>
        </div>
      </div>

      <button 
        type="button" 
        id="run-quiz-btn" 
        class="w-full py-3 rounded-full text-xs font-semibold uppercase tracking-wider bg-primary hover:bg-primary-active text-on-primary transition-all cursor-pointer shadow-xs"
      >
        {d.analyzeBtn}
      </button>
    </div>

    <!-- Active Scanner Viewport (Hidden by default until image loaded) -->
    <div id="scanner-viewport" class="hidden mt-6 pt-6 border-t border-hairline">
      <div class="relative max-w-md mx-auto aspect-square bg-[#0f1319] rounded-xl overflow-hidden border border-hairline shadow-md">
        <!-- Canvas view -->
        <canvas id="pan-canvas" width="400" height="400" class="w-full h-full object-cover block"></canvas>
        
        <!-- HUD Overlay Graphic -->
        <div class="absolute inset-0 pointer-events-none p-4 flex flex-col justify-between">
          <div class="flex justify-between items-start">
            <span class="font-mono text-[10px] text-green-400 bg-black/60 px-1.5 py-0.5 rounded border border-green-500/30">
              HUD: OPTICAL SCAN
            </span>
            <span class="font-mono text-[10px] text-green-400 bg-black/60 px-1.5 py-0.5 rounded border border-green-500/30">
              400x400 MATRIX
            </span>
          </div>

          <!-- Target Reticle in Center -->
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="w-32 h-32 border border-green-400/30 rounded-full flex items-center justify-center">
              <div class="w-1.5 h-1.5 bg-green-400 rounded-full animate-ping"></div>
            </div>
          </div>

          <!-- Laser Scan Line -->
          <div id="laser-bar" class="absolute left-0 right-0 h-1 bg-gradient-to-r from-transparent via-green-400 to-transparent shadow-[0_0_12px_#4ade80] pointer-events-none transition-all"></div>

          <div class="flex justify-between items-end">
            <span id="scan-pct" class="font-mono text-[11px] font-bold text-green-400 bg-black/70 px-2 py-0.5 rounded">
              0%
            </span>
            <span id="scan-target-status" class="font-mono text-[10px] text-green-300 bg-black/70 px-2 py-0.5 rounded uppercase">
              ANALYZING
            </span>
          </div>
        </div>
      </div>

      <!-- Live Scan Steps Ticker -->
      <div class="max-w-md mx-auto mt-4 p-3 bg-surface-soft border border-hairline rounded-lg">
        <div class="flex items-center gap-2 mb-1.5">
          <div class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></div>
          <span class="text-xs font-semibold text-ink">{d.scanningTitle}</span>
        </div>
        <p id="scanner-step-text" class="text-[12px] font-mono text-muted pl-4">
          {d.step1}
        </p>
      </div>
    </div>

    <!-- Assessment Result Card (Hidden until scan finishes) -->
    <div id="assessment-result" class="hidden mt-6 pt-6 border-t border-hairline space-y-6">
      <!-- Verdict Banner -->
      <div id="result-banner" class="p-5 md:p-6 rounded-xl border transition-all">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-3">
          <div class="flex items-center gap-2.5">
            <span id="result-badge-dot" class="w-3.5 h-3.5 rounded-full inline-block"></span>
            <h4 id="result-title" class="text-title-md md:text-title-lg font-bold tracking-tight"></h4>
          </div>
          <span id="result-confidence" class="text-[11px] font-mono uppercase px-2.5 py-1 rounded bg-black/5 border border-black/10 text-muted">
            {d.confidenceLabel}: 98.4%
          </span>
        </div>
        <p id="result-description" class="text-body text-[14px] leading-relaxed"></p>
      </div>

      <!-- Core Metrics Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5">
        <div class="p-4 rounded-lg bg-surface-soft border border-hairline">
          <span class="text-[11px] font-bold text-muted uppercase tracking-wider block mb-1">
            {d.metricMicroplastics}
          </span>
          <span id="metric-microplastics-val" class="text-title-sm font-bold text-ink block mb-1"></span>
          <p class="text-[11px] text-body leading-tight">Flinders Univ 2022 Raman Spectroscopy Benchmarks</p>
        </div>

        <div class="p-4 rounded-lg bg-surface-soft border border-hairline">
          <span class="text-[11px] font-bold text-muted uppercase tracking-wider block mb-1">
            {d.metricTemp}
          </span>
          <span id="metric-temp-val" class="text-title-sm font-bold text-ink block mb-1"></span>
          <p class="text-[11px] text-body leading-tight">PTFE Thermal Breakdown Limit (Polymer Fumes)</p>
        </div>

        <div class="p-4 rounded-lg bg-surface-soft border border-hairline">
          <span class="text-[11px] font-bold text-muted uppercase tracking-wider block mb-1">
            {d.metricMetal}
          </span>
          <span id="metric-metal-val" class="text-title-sm font-bold text-ink block mb-1"></span>
          <p class="text-[11px] text-body leading-tight">Substrate Aluminum Leaching & Acid Reaction</p>
        </div>
      </div>

      <!-- Actionable Advice Card -->
      <div class="p-5 rounded-xl bg-surface-soft border border-hairline">
        <h5 class="text-title-sm font-semibold text-ink mb-2 flex items-center gap-2">
          <svg class="w-4 h-4 text-signature-coral" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          {d.actionTitle}
        </h5>
        <p id="action-text" class="text-[13px] text-body leading-relaxed mb-4"></p>
        
        <!-- Cookware Upgrade Recommendations -->
        <div class="pt-4 border-t border-hairline">
          <span class="text-xs font-bold uppercase tracking-wider text-ink block mb-2">
            {d.altTitle}
          </span>
          <ul class="text-[13px] text-body space-y-1.5 list-disc pl-5">
            <li><strong>Stainless Steel</strong>: {d.altStainless}</li>
            <li><strong>Cast Iron</strong>: {d.altCastIron}</li>
            <li><strong>Carbon Steel</strong>: {d.altCarbonSteel}</li>
            <li><strong>Ceramic / Enameled</strong>: {d.altCeramic}</li>
          </ul>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center justify-between gap-3 pt-2">
        <button 
          type="button" 
          id="reset-inspector-btn"
          class="px-5 py-2.5 rounded-full text-xs font-semibold uppercase tracking-wider bg-primary hover:bg-primary-active text-on-primary transition-all cursor-pointer shadow-xs"
        >
          🔄 {d.resetBtn}
        </button>
        <button 
          type="button" 
          id="print-inspector-btn"
          class="px-5 py-2.5 rounded-full text-xs font-semibold uppercase tracking-wider bg-white hover:bg-surface-soft text-ink border border-hairline transition-all cursor-pointer"
        >
          🖨️ {d.printBtn}
        </button>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ dict: d, currentLang: lang }}>
(function() {
  const container = document.querySelector('.pan-inspector-wrapper');
  if (!container) return;

  const tabUploadBtn = container.querySelector('#tab-upload-btn');
  const tabQuizBtn = container.querySelector('#tab-quiz-btn');
  const paneUpload = container.querySelector('#pane-upload');
  const paneQuiz = container.querySelector('#pane-quiz');
  const fileInput = container.querySelector('#pan-file-input');
  const dropzone = container.querySelector('#dropzone');
  const runQuizBtn = container.querySelector('#run-quiz-btn');

  const scannerViewport = container.querySelector('#scanner-viewport');
  const panCanvas = container.querySelector('#pan-canvas');
  const laserBar = container.querySelector('#laser-bar');
  const scanPct = container.querySelector('#scan-pct');
  const scannerStepText = container.querySelector('#scanner-step-text');
  
  const assessmentResult = container.querySelector('#assessment-result');
  const resultBanner = container.querySelector('#result-banner');
  const resultBadgeDot = container.querySelector('#result-badge-dot');
  const resultTitle = container.querySelector('#result-title');
  const resultDescription = container.querySelector('#result-description');
  const resultConfidence = container.querySelector('#result-confidence');

  const metricMicroplasticsVal = container.querySelector('#metric-microplastics-val');
  const metricTempVal = container.querySelector('#metric-temp-val');
  const metricMetalVal = container.querySelector('#metric-metal-val');
  const actionText = container.querySelector('#action-text');

  const resetBtn = container.querySelector('#reset-inspector-btn');
  const printBtn = container.querySelector('#print-inspector-btn');

  // Tab switching
  tabUploadBtn?.addEventListener('click', () => {
    tabUploadBtn.classList.add('bg-primary', 'text-on-primary');
    tabUploadBtn.classList.remove('bg-surface-soft', 'text-body');
    tabQuizBtn.classList.remove('bg-primary', 'text-on-primary');
    tabQuizBtn.classList.add('bg-surface-soft', 'text-body');
    paneUpload?.classList.remove('hidden');
    paneQuiz?.classList.add('hidden');
  });

  tabQuizBtn?.addEventListener('click', () => {
    tabQuizBtn.classList.add('bg-primary', 'text-on-primary');
    tabQuizBtn.classList.remove('bg-surface-soft', 'text-body');
    tabUploadBtn.classList.remove('bg-primary', 'text-on-primary');
    tabUploadBtn.classList.add('bg-surface-soft', 'text-body');
    paneQuiz?.classList.remove('hidden');
    paneUpload?.classList.add('hidden');
  });

  // Generate synthetic sample images for preset buttons
  function generateSampleImage(type) {
    const canvas = document.createElement('canvas');
    canvas.width = 400;
    canvas.height = 400;
    const ctx = canvas.getContext('2d');
    if (!ctx) return '';

    // Dark skillet background
    ctx.fillStyle = '#1c2028';
    ctx.fillRect(0, 0, 400, 400);

    // Subtle pan circular grain
    ctx.strokeStyle = '#272d38';
    ctx.lineWidth = 1;
    for (let r = 20; r < 200; r += 15) {
      ctx.beginPath();
      ctx.arc(200, 200, r, 0, Math.PI * 2);
      ctx.stroke();
    }

    if (type === 'grade1') {
      // Hairline swirls
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.12)';
      ctx.lineWidth = 0.8;
      for (let i = 0; i < 18; i++) {
        ctx.beginPath();
        const startX = 60 + Math.random() * 280;
        const startY = 60 + Math.random() * 280;
        ctx.moveTo(startX, startY);
        ctx.quadraticCurveTo(startX + (Math.random() - 0.5) * 60, startY + (Math.random() - 0.5) * 60, startX + (Math.random() - 0.5) * 100, startY + (Math.random() - 0.5) * 100);
        ctx.stroke();
      }
    } else if (type === 'grade3') {
      // Deep scratches revealing bright silver aluminum core
      ctx.strokeStyle = '#d4d8df';
      ctx.shadowColor = '#ffffff';
      ctx.shadowBlur = 4;
      ctx.lineWidth = 2.4;
      ctx.beginPath();
      ctx.moveTo(80, 140);
      ctx.lineTo(260, 290);
      ctx.lineTo(310, 310);
      ctx.stroke();

      ctx.lineWidth = 1.8;
      ctx.beginPath();
      ctx.moveTo(140, 90);
      ctx.lineTo(190, 240);
      ctx.lineTo(290, 270);
      ctx.stroke();
      ctx.shadowBlur = 0;
    } else if (type === 'grade4') {
      // Flaking, peeling patches
      ctx.fillStyle = '#6b7280';
      ctx.beginPath();
      ctx.ellipse(220, 190, 70, 45, Math.PI / 4, 0, Math.PI * 2);
      ctx.fill();

      ctx.fillStyle = '#9ca3af';
      ctx.beginPath();
      ctx.ellipse(215, 185, 55, 30, Math.PI / 4, 0, Math.PI * 2);
      ctx.fill();

      // Blistering jagged peel contours
      ctx.strokeStyle = '#ffffff';
      ctx.lineWidth = 2;
      ctx.stroke();
    }

    return canvas.toDataURL();
  }

  // Handle preset sample clicks
  container.querySelectorAll('.sample-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const sampleType = btn.getAttribute('data-sample') || 'grade1';
      const dataUrl = generateSampleImage(sampleType);
      const img = new Image();
      img.onload = () => {
        let forcedGrade = 1;
        if (sampleType === 'grade3') forcedGrade = 3;
        if (sampleType === 'grade4') forcedGrade = 4;
        startInspection(img, forcedGrade);
      };
      img.src = dataUrl;
    });
  });

  // Handle file input upload
  fileInput?.addEventListener('change', (e) => {
    const file = e.target.files?.[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (event) => {
      const img = new Image();
      img.onload = () => {
        startInspection(img);
      };
      img.src = event.target?.result;
    };
    reader.readAsDataURL(file);
  });

  // Handle Drag and Drop
  dropzone?.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropzone.classList.add('border-signature-coral', 'bg-red-50/20');
  });

  dropzone?.addEventListener('dragleave', (e) => {
    e.preventDefault();
    dropzone.classList.remove('border-signature-coral', 'bg-red-50/20');
  });

  dropzone?.addEventListener('drop', (e) => {
    e.preventDefault();
    dropzone.classList.remove('border-signature-coral', 'bg-red-50/20');
    const file = e.dataTransfer?.files?.[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (event) => {
      const img = new Image();
      img.onload = () => {
        startInspection(img);
      };
      img.src = event.target?.result;
    };
    reader.readAsDataURL(file);
  });

  // Handle Quiz Button
  runQuizBtn?.addEventListener('click', () => {
    const q1 = container.querySelector('input[name="inspector-q1"]:checked')?.value;
    const q2 = container.querySelector('input[name="inspector-q2"]:checked')?.value;
    const q3 = container.querySelector('input[name="inspector-q3"]:checked')?.value;

    let grade = 1;
    if (q2 === 'yes') {
      grade = 4;
    } else if (q1 === 'metal') {
      grade = 3;
    } else if (q1 === 'faint' || q3 === 'yes') {
      grade = 2;
    } else {
      grade = 1;
    }

    const sampleType = grade === 4 ? 'grade4' : (grade === 3 ? 'grade3' : 'grade1');
    const dataUrl = generateSampleImage(sampleType);
    const img = new Image();
    img.onload = () => {
      startInspection(img, grade);
    };
    img.src = dataUrl;
  });

  // Optical analysis on Canvas
  function analyzePixels(canvas) {
    const ctx = canvas.getContext('2d');
    if (!ctx) return 1;

    try {
      const imgData = ctx.getImageData(0, 0, 400, 400);
      const data = imgData.data;
      let brightPixelCount = 0;
      let extremeContrastEdgeCount = 0;

      for (let i = 0; i < data.length; i += 16) { // sample every 4th pixel
        const r = data[i];
        const g = data[i + 1];
        const b = data[i + 2];
        const lum = 0.299 * r + 0.587 * g + 0.114 * b;

        // Shiny aluminum reflection (silver/light grey)
        if (lum > 140 && Math.abs(r - g) < 35 && Math.abs(g - b) < 35) {
          brightPixelCount++;
        }
      }

      // Check ratio of exposed metal pixels
      const totalSampled = data.length / 16;
      const ratio = brightPixelCount / totalSampled;

      if (ratio > 0.04) {
        return 4; // Extensive delamination / peeling
      } else if (ratio > 0.005) {
        return 3; // Exposed aluminum core
      } else if (ratio > 0.001) {
        return 2; // Moderate scratch
      }
      return 1; // Minor hairline
    } catch (e) {
      return 1;
    }
  }

  // Animation and Inspection Execution
  function startInspection(img, predeterminedGrade) {
    scannerViewport?.classList.remove('hidden');
    assessmentResult?.classList.add('hidden');
    scannerViewport?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

    // Draw on canvas
    if (panCanvas) {
      const ctx = panCanvas.getContext('2d');
      if (ctx) {
        ctx.clearRect(0, 0, 400, 400);
        ctx.drawImage(img, 0, 0, 400, 400);
      }
    }

    const calculatedGrade = predeterminedGrade || (panCanvas ? analyzePixels(panCanvas) : 2);

    // Laser scan animation
    let progress = 0;
    let stepIndex = 0;
    const steps = [dict.step1, dict.step2, dict.step3, dict.step4];

    const interval = setInterval(() => {
      progress += 4;
      if (scanPct) scanPct.textContent = `${Math.min(progress, 100)}%`;
      if (laserBar) laserBar.style.top = `${(progress % 100)}%`;

      if (progress === 24) stepIndex = 1;
      if (progress === 52) stepIndex = 2;
      if (progress === 76) stepIndex = 3;

      if (scannerStepText && steps[stepIndex]) {
        scannerStepText.textContent = steps[stepIndex];
      }

      if (progress >= 100) {
        clearInterval(interval);
        setTimeout(() => {
          renderVerdict(calculatedGrade);
        }, 300);
      }
    }, 45);
  }

  // Render verdict card
  function renderVerdict(grade) {
    assessmentResult?.classList.remove('hidden');
    assessmentResult?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

    if (!resultBanner || !resultTitle || !resultDescription) return;

    // Reset styles
    resultBanner.className = 'p-5 md:p-6 rounded-xl border transition-all';
    resultBadgeDot.className = 'w-3.5 h-3.5 rounded-full inline-block';

    if (grade === 1) {
      resultBanner.classList.add('bg-green-50/80', 'border-green-200');
      resultBadgeDot.classList.add('bg-green-600');
      resultTitle.className = 'text-title-md md:text-title-lg font-bold tracking-tight text-green-900';
      resultTitle.textContent = dict.grade1Title;
      resultDescription.textContent = dict.grade1Desc;

      if (metricMicroplasticsVal) metricMicroplasticsVal.textContent = dict.m1Val;
      if (metricTempVal) metricTempVal.textContent = dict.t1Val;
      if (metricMetalVal) metricMetalVal.textContent = dict.met1Val;
      if (actionText) actionText.textContent = dict.action1;
      if (resultConfidence) resultConfidence.textContent = `${dict.confidenceLabel}: 99.1%`;
    } else if (grade === 2) {
      resultBanner.classList.add('bg-amber-50/80', 'border-amber-200');
      resultBadgeDot.classList.add('bg-amber-500');
      resultTitle.className = 'text-title-md md:text-title-lg font-bold tracking-tight text-amber-950';
      resultTitle.textContent = dict.grade2Title;
      resultDescription.textContent = dict.grade2Desc;

      if (metricMicroplasticsVal) metricMicroplasticsVal.textContent = dict.m2Val;
      if (metricTempVal) metricTempVal.textContent = dict.t2Val;
      if (metricMetalVal) metricMetalVal.textContent = dict.met2Val;
      if (actionText) actionText.textContent = dict.action2;
      if (resultConfidence) resultConfidence.textContent = `${dict.confidenceLabel}: 96.8%`;
    } else if (grade === 3) {
      resultBanner.classList.add('bg-red-50/90', 'border-red-300');
      resultBadgeDot.classList.add('bg-signature-coral');
      resultTitle.className = 'text-title-md md:text-title-lg font-bold tracking-tight text-signature-coral';
      resultTitle.textContent = dict.grade3Title;
      resultDescription.textContent = dict.grade3Desc;

      if (metricMicroplasticsVal) metricMicroplasticsVal.textContent = dict.m3Val;
      if (metricTempVal) metricTempVal.textContent = dict.t3Val;
      if (metricMetalVal) metricMetalVal.textContent = dict.met3Val;
      if (actionText) actionText.textContent = dict.action3;
      if (resultConfidence) resultConfidence.textContent = `${dict.confidenceLabel}: 98.4%`;
    } else {
      // Grade 4
      resultBanner.classList.add('bg-red-100', 'border-red-400');
      resultBadgeDot.classList.add('bg-red-900');
      resultTitle.className = 'text-title-md md:text-title-lg font-bold tracking-tight text-red-950';
      resultTitle.textContent = dict.grade4Title;
      resultDescription.textContent = dict.grade4Desc;

      if (metricMicroplasticsVal) metricMicroplasticsVal.textContent = dict.m4Val;
      if (metricTempVal) metricTempVal.textContent = dict.t4Val;
      if (metricMetalVal) metricMetalVal.textContent = dict.met4Val;
      if (actionText) actionText.textContent = dict.action4;
      if (resultConfidence) resultConfidence.textContent = `${dict.confidenceLabel}: 99.8%`;
    }
  }

  // Reset Button
  resetBtn?.addEventListener('click', () => {
    scannerViewport?.classList.add('hidden');
    assessmentResult?.classList.add('hidden');
    if (fileInput) fileInput.value = '';
    paneUpload?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  });

  // Print Report Button
  printBtn?.addEventListener('click', () => {
    window.print();
  });
})();
</script>
