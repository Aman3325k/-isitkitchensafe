---

<div class="nsf-inspector-root space-y-10" data-nsf-data={serializedData} data-dict={dictJson} data-lang={lang}>
  <!-- Hero / Header Badge Section -->
  <div class="bg-surface-soft border border-hairline rounded-3xl p-6 md:p-10 space-y-4">
    <div class="flex flex-wrap items-center gap-3">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-blue-700 text-white shadow-xs">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        {d.badge}
      </span>
      <span class="text-xs text-muted font-mono">NSF/ANSI Standard 2 &bull; Standard 51 &bull; FDA § 4-101.11</span>
    </div>

    <h1 class="text-display-sm md:text-display-md font-medium text-ink tracking-tight">
      {d.title}
    </h1>
    <p class="text-sm md:text-base text-body max-w-4xl leading-relaxed">
      {d.subtitle}
    </p>
  </div>

  <!-- Interactive Controls + Real-Time Status Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Controls Column (5 cols) -->
    <div class="lg:col-span-5 bg-surface-soft border border-hairline rounded-2xl p-6 md:p-8 space-y-6">
      <div class="border-b border-hairline pb-4">
        <h2 class="text-title-sm font-medium text-ink tracking-tight">{d.controlsTitle}</h2>
        <p class="text-xs text-muted mt-1">{d.controlsSub}</p>
      </div>

      <!-- Equipment Selector -->
      <div class="space-y-2">
        <label for="eq-select" class="block text-xs font-bold uppercase tracking-wider text-muted">
          {d.equipmentLabel}
        </label>
        <select id="eq-select" class="w-full bg-canvas text-ink border border-hairline rounded-xl px-3 py-2.5 text-xs md:text-sm font-medium focus:ring-2 focus:ring-blue-600 focus:outline-hidden">
          {nsfData.equipmentCategories.map(eq => (
            <option value={eq.id}>{eq.name}</option>
          ))}
        </select>
      </div>

      <!-- Sanitation Protocol Selector -->
      <div class="space-y-2">
        <label for="san-select" class="block text-xs font-bold uppercase tracking-wider text-muted">
          {d.sanitationLabel}
        </label>
        <select id="san-select" class="w-full bg-canvas text-ink border border-hairline rounded-xl px-3 py-2.5 text-xs md:text-sm font-medium focus:ring-2 focus:ring-blue-600 focus:outline-hidden">
          {nsfData.sanitationProtocols.map(proto => (
            <option value={proto.id}>{proto.name}</option>
          ))}
        </select>
      </div>

      <!-- Wear Condition Selector -->
      <div class="space-y-2">
        <label for="wear-select" class="block text-xs font-bold uppercase tracking-wider text-muted">
          {d.wearLabel}
        </label>
        <select id="wear-select" class="w-full bg-canvas text-ink border border-hairline rounded-xl px-3 py-2.5 text-xs md:text-sm font-medium focus:ring-2 focus:ring-blue-600 focus:outline-hidden">
          {nsfData.wearConditions.map(w => (
            <option value={w.id} selected={w.id === 'moderate-degradation'}>{w.label}</option>
          ))}
        </select>
      </div>

      <!-- Cycles Per Day Slider -->
      <div class="space-y-2 pt-2 border-t border-hairline">
        <div class="flex items-center justify-between text-xs font-medium">
          <span class="text-muted">{d.cyclesPerDayLabel}</span>
          <span id="cycles-val" class="font-bold text-blue-700 bg-blue-50 px-2 py-0.5 rounded-md">15 cycles / day</span>
        </div>
        <input 
          type="range" 
          id="cycles-slider" 
          min="1" 
          max="60" 
          value="15" 
          class="w-full accent-blue-700 cursor-pointer h-2 bg-hairline rounded-lg"
        />
        <div class="flex justify-between text-[10px] text-muted font-mono">
          <span>1 (Low)</span>
          <span>15 (Bistro)</span>
          <span>35 (High-Vol)</span>
          <span>60 (Banquet)</span>
        </div>
      </div>

      <!-- Months In Service Slider -->
      <div class="space-y-2 pt-2 border-t border-hairline">
        <div class="flex items-center justify-between text-xs font-medium">
          <span class="text-muted">{d.monthsInServiceLabel}</span>
          <span id="months-val" class="font-bold text-blue-700 bg-blue-50 px-2 py-0.5 rounded-md">12 months</span>
        </div>
        <input 
          type="range" 
          id="months-slider" 
          min="1" 
          max="60" 
          value="12" 
          class="w-full accent-blue-700 cursor-pointer h-2 bg-hairline rounded-lg"
        />
        <div class="flex justify-between text-[10px] text-muted font-mono">
          <span>1 mo</span>
          <span>12 mos (1 yr)</span>
          <span>36 mos (3 yrs)</span>
          <span>60 mos (5 yrs)</span>
        </div>
      </div>
    </div>

    <!-- Diagnostic Results Column (7 cols) -->
    <div class="lg:col-span-7 space-y-6">
      <!-- Status Banner Card -->
      <div id="status-card" class="rounded-2xl p-6 md:p-8 border border-hairline bg-surface-soft space-y-4 transition-all">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <span id="status-badge" class="px-3 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider text-white shadow-xs">
            Calculating...
          </span>
          <span id="inspection-pill" class="text-xs font-bold px-2.5 py-1 rounded-md">
            FDA Assessment Pending
          </span>
        </div>

        <div>
          <span class="text-xs font-mono text-muted uppercase block mb-1">{d.nsfStatusLabel}</span>
          <h3 id="status-headline" class="text-title-lg font-bold text-ink">
            Calculating Compliance...
          </h3>
          <p id="status-sub" class="text-xs md:text-sm text-body mt-2 leading-relaxed">
            Evaluating surface morphology and sanitizer compatibility...
          </p>
        </div>

        <!-- Metric Gauges Row -->
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 pt-4 border-t border-hairline">
          <div class="bg-canvas p-3 rounded-xl border border-hairline">
            <span class="text-[10px] uppercase font-bold text-muted block mb-1">{d.biofilmRiskLabel}</span>
            <span id="biofilm-percent" class="text-lg md:text-xl font-bold font-mono text-ink">0%</span>
            <div class="w-full bg-hairline h-1.5 rounded-full mt-1.5 overflow-hidden">
              <div id="biofilm-bar" class="h-full bg-emerald-600 transition-all duration-300" style="width: 0%"></div>
            </div>
          </div>

          <div class="bg-canvas p-3 rounded-xl border border-hairline">
            <span class="text-[10px] uppercase font-bold text-muted block mb-1">{d.wearConsumptionLabel}</span>
            <span id="wear-percent" class="text-lg md:text-xl font-bold font-mono text-ink">0%</span>
            <div class="w-full bg-hairline h-1.5 rounded-full mt-1.5 overflow-hidden">
              <div id="wear-bar" class="h-full bg-emerald-600 transition-all duration-300" style="width: 0%"></div>
            </div>
          </div>

          <div class="bg-canvas p-3 rounded-xl border border-hairline col-span-2 sm:col-span-1">
            <span class="text-[10px] uppercase font-bold text-muted block mb-1">{d.estRemainingMonthsLabel}</span>
            <span id="remaining-months-val" class="text-lg md:text-xl font-bold font-mono text-blue-700">0 mos</span>
            <span id="remaining-cycles-val" class="text-[10px] text-muted block mt-1">0 cycles left</span>
          </div>
        </div>
      </div>

      <!-- Detailed Regulatory Citation & Hazard Cards -->
      <div class="space-y-4">
        <!-- Citation Card -->
        <div class="bg-surface-soft border border-hairline rounded-2xl p-5 space-y-2">
          <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-amber-800">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            {d.citationTitle}
          </div>
          <p id="citation-text" class="text-xs md:text-sm text-body leading-relaxed font-mono bg-canvas p-3 rounded-xl border border-hairline">
            Loading citation...
          </p>
        </div>

        <!-- Sanitizer Incompatibility Notice -->
        <div class="bg-surface-soft border border-hairline rounded-2xl p-5 space-y-2">
          <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-blue-800">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
            </svg>
            {d.sanitizerWarningTitle}
          </div>
          <p id="sanitizer-text" class="text-xs md:text-sm text-body leading-relaxed">
            Evaluating sanitizer chemistry...
          </p>
        </div>

        <!-- Corrective Action & Restoration Protocol -->
        <div class="bg-surface-soft border border-hairline rounded-2xl p-5 space-y-3">
          <div class="border-b border-hairline pb-2">
            <span class="text-xs font-bold uppercase tracking-wider text-emerald-800 block">
              {d.correctiveTitle}
            </span>
            <p class="text-[11px] text-muted">{d.correctiveSub}</p>
          </div>
          <div class="space-y-2 text-xs md:text-sm text-body">
            <div class="flex items-start gap-2">
              <span class="font-bold text-ink">Action:</span>
              <span id="corrective-action-text" class="leading-relaxed">...</span>
            </div>
            <div class="flex items-start gap-2 pt-2 border-t border-hairline/60">
              <span class="font-bold text-ink">{d.replacementLabel}</span>
              <span id="replacement-text" class="text-blue-700 font-medium leading-relaxed">...</span>
            </div>
          </div>
        </div>

        <!-- Copy Diagnostic Report Button -->
        <div class="pt-2">
          <button 
            type="button" 
            id="copy-audit-btn" 
            class="w-full py-3.5 px-4 rounded-xl bg-ink hover:bg-black text-white font-medium text-xs md:text-sm transition-all shadow-xs flex items-center justify-center gap-2 cursor-pointer"
          >
            <span>{d.copyReportBtn}</span>
          </button>
          <p id="copy-confirm" class="text-xs text-center text-emerald-700 font-bold mt-2 hidden">
            {d.reportCopied}
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Technical Standards & Engineering Benchmarks Accordion -->
  <section class="bg-surface-soft border border-hairline rounded-3xl p-6 md:p-10 space-y-6">
    <div class="border-b border-hairline pb-4">
      <span class="text-xs font-bold uppercase tracking-wider text-blue-800 block mb-1">
        {d.standardsTitle}
      </span>
      <h2 class="text-title-lg font-medium text-ink tracking-tight">
        Sanitation Engineering Norms &amp; Cleanability Requirements
      </h2>
      <p class="text-xs text-muted mt-1">{d.standardsSub}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {nsfData.regulatoryStandards.map(std => (
        <div class="p-4 rounded-xl bg-canvas border border-hairline space-y-1">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-blue-700 font-mono">{std.code}</span>
            <span class="text-[10px] text-muted">{std.authority}</span>
          </div>
          <h3 class="text-sm font-medium text-ink">{std.title}</h3>
          <p class="text-xs text-body leading-relaxed">{std.scope}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Cross-link Related Tools Section -->
  <section class="bg-canvas border border-hairline rounded-2xl p-6 md:p-8 space-y-4">
    <h3 class="text-title-sm font-medium text-ink">
      {d.crossLinkTools}
    </h3>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 text-xs">
      <a href={lang === 'en' ? "/tools/food-contact-migration-predictor/" : `/${lang}/tools/food-contact-migration-predictor/`} class="p-3 rounded-xl bg-surface-soft hover:bg-surface border border-hairline transition-colors">
        <span class="font-bold text-ink block mb-0.5">{d.crossLinkMigration}</span>
        <span class="text-muted">Fickian planar diffusion & Arrhenius leaching kinetics.</span>
      </a>
      <a href={lang === 'en' ? "/tools/toxic-leaching-scorecard/" : `/${lang}/tools/toxic-leaching-scorecard/`} class="p-3 rounded-xl bg-surface-soft hover:bg-surface border border-hairline transition-colors">
        <span class="font-bold text-ink block mb-0.5">{d.crossLinkScorecard}</span>
        <span class="text-muted">Heavy metal leaching (Pb, Cd, Al) & PFAS degradation.</span>
      </a>
      <a href={lang === 'en' ? "/tools/plasticizer-microplastic-burden-estimator/" : `/${lang}/tools/plasticizer-microplastic-burden-estimator/`} class="p-3 rounded-xl bg-surface-soft hover:bg-surface border border-hairline transition-colors">
        <span class="font-bold text-ink block mb-0.5">{d.crossLinkPlasticizer}</span>
        <span class="text-muted">Phthalates & microplastic dietary ingestion estimator.</span>
      </a>
      <a href={lang === 'en' ? "/tools/material-swap-calculator/" : `/${lang}/tools/material-swap-calculator/`} class="p-3 rounded-xl bg-surface-soft hover:bg-surface border border-hairline transition-colors">
        <span class="font-bold text-ink block mb-0.5">{d.crossLinkSwap}</span>
        <span class="text-muted">Certified non-toxic cookware replacement calculator.</span>
      </a>
      <a href={lang === 'en' ? "/tools/pan-scratch-inspector/" : `/${lang}/tools/pan-scratch-inspector/`} class="p-3 rounded-xl bg-surface-soft hover:bg-surface border border-hairline transition-colors">
        <span class="font-bold text-ink block mb-0.5">{d.crossLinkPanInspector}</span>
        <span class="text-muted">Client-side AI image scanner for Teflon damage triage.</span>
      </a>
    </div>
  </section>
</div>

<script>
  function initNsfInspector() {
    const root = document.querySelector('.nsf-inspector-root') as HTMLElement | null;
    if (!root) return;

    const dataAttr = root.getAttribute('data-nsf-data');
    const dictAttr = root.getAttribute('data-dict');
    if (!dataAttr || !dictAttr) return;

    const data = JSON.parse(dataAttr);
    const dict = JSON.parse(dictAttr);

    // Form elements
    const eqSelect = root.querySelector('#eq-select') as HTMLSelectElement | null;
    const sanSelect = root.querySelector('#san-select') as HTMLSelectElement | null;
    const wearSelect = root.querySelector('#wear-select') as HTMLSelectElement | null;
    const cyclesSlider = root.querySelector('#cycles-slider') as HTMLInputElement | null;
    const monthsSlider = root.querySelector('#months-slider') as HTMLInputElement | null;
    const cyclesVal = root.querySelector('#cycles-val') as HTMLElement | null;
    const monthsVal = root.querySelector('#months-val') as HTMLElement | null;

    // Display elements
    const statusCard = root.querySelector('#status-card') as HTMLElement | null;
    const statusBadge = root.querySelector('#status-badge') as HTMLElement | null;
    const inspectionPill = root.querySelector('#inspection-pill') as HTMLElement | null;
    const statusHeadline = root.querySelector('#status-headline') as HTMLElement | null;
    const statusSub = root.querySelector('#status-sub') as HTMLElement | null;
    const biofilmPercent = root.querySelector('#biofilm-percent') as HTMLElement | null;
    const biofilmBar = root.querySelector('#biofilm-bar') as HTMLElement | null;
    const wearPercent = root.querySelector('#wear-percent') as HTMLElement | null;
    const wearBar = root.querySelector('#wear-bar') as HTMLElement | null;
    const remainingMonthsVal = root.querySelector('#remaining-months-val') as HTMLElement | null;
    const remainingCyclesVal = root.querySelector('#remaining-cycles-val') as HTMLElement | null;
    const citationText = root.querySelector('#citation-text') as HTMLElement | null;
    const sanitizerText = root.querySelector('#sanitizer-text') as HTMLElement | null;
    const correctiveActionText = root.querySelector('#corrective-action-text') as HTMLElement | null;
    const replacementText = root.querySelector('#replacement-text') as HTMLElement | null;
    const copyBtn = root.querySelector('#copy-audit-btn') as HTMLButtonElement | null;
    const copyConfirm = root.querySelector('#copy-confirm') as HTMLElement | null;

    if (!eqSelect || !sanSelect || !wearSelect || !cyclesSlider || !monthsSlider) return;

    function recalculate() {
      const eqId = eqSelect!.value;
      const sanId = sanSelect!.value;
      const wearId = wearSelect!.value;
      const dailyCycles = parseInt(cyclesSlider!.value, 10);
      const monthsInService = parseInt(monthsSlider!.value, 10);

      if (cyclesVal) cyclesVal.textContent = `${dailyCycles} cycles / day`;
      if (monthsVal) monthsVal.textContent = `${monthsInService} months`;

      const eq = data.equipmentCategories.find((c: any) => c.id === eqId) || data.equipmentCategories[0];
      const proto = data.sanitationProtocols.find((p: any) => p.id === sanId) || data.sanitationProtocols[0];
      const wear = data.wearConditions.find((w: any) => w.id === wearId) || data.wearConditions[0];

      // Total lifetime cycles completed
      const totalCyclesCompleted = dailyCycles * monthsInService * 30;
      const lifecycleRatio = totalCyclesCompleted / eq.nominalLifespanCycles;
      
      // Wear fatigue score (0 - 100%)
      const wearDepletion = Math.min(100, Math.round(lifecycleRatio * 70 + wear.defectScore * 0.3));

      // Incompatibility factor (e.g. Bare Aluminum + High Temp Caustic Dishwasher = Critical boost)
      let incompatibilityMultiplier = 1.0;
      if (eqId === 'aluminum-sheet-pans' && sanId.includes('dishwasher')) {
        incompatibilityMultiplier = 1.6;
      } else if (eqId === 'cutting-board-hdpe' && sanId === 'high-temp-dishwasher') {
        incompatibilityMultiplier = 1.3;
      } else if (eqId === 'stainless-cookware-304' && sanId.includes('chlorine')) {
        incompatibilityMultiplier = 1.4;
      } else if (eqId === 'commercial-nonstick-frypan' && sanId.includes('dishwasher')) {
        incompatibilityMultiplier = 1.5;
      }

      // Biofilm harboring risk calculation (0 - 100%)
      let calculatedBiofilmRisk = Math.round(
        (wear.biofilmRisk * 0.75 + (wearDepletion * 0.25)) * incompatibilityMultiplier
      );
      calculatedBiofilmRisk = Math.max(2, Math.min(99, calculatedBiofilmRisk));

      // Remaining service estimation
      const remainingCycles = Math.max(0, Math.round(eq.nominalLifespanCycles - totalCyclesCompleted));
      const remainingMonths = Math.max(0, Math.round(remainingCycles / (dailyCycles * 30)));

      // Render Gauges
      if (biofilmPercent) biofilmPercent.textContent = `${calculatedBiofilmRisk}%`;
      if (biofilmBar) {
        biofilmBar.style.width = `${calculatedBiofilmRisk}%`;
        biofilmBar.className = `h-full transition-all duration-300 ${
          calculatedBiofilmRisk > 70 ? 'bg-red-600' : calculatedBiofilmRisk > 40 ? 'bg-amber-500' : 'bg-emerald-600'
        }`;
      }

      if (wearPercent) wearPercent.textContent = `${wearDepletion}%`;
      if (wearBar) {
        wearBar.style.width = `${wearDepletion}%`;
        wearBar.className = `h-full transition-all duration-300 ${
          wearDepletion > 85 ? 'bg-red-600' : wearDepletion > 50 ? 'bg-amber-500' : 'bg-emerald-600'
        }`;
      }

      if (remainingMonthsVal) remainingMonthsVal.textContent = `${remainingMonths} mos`;
      if (remainingCyclesVal) remainingCyclesVal.textContent = `${remainingCycles.toLocaleString()} cycles remaining`;

      // Status Assessment
      let complianceTier = 'compliant';
      if (calculatedBiofilmRisk >= 70 || wearDepletion >= 90 || wearId === 'condemned') {
        complianceTier = 'condemned';
      } else if (calculatedBiofilmRisk >= 40 || wearDepletion >= 60 || wearId === 'moderate-degradation') {
        complianceTier = 'warning';
      }

      if (statusCard && statusBadge && statusHeadline && statusSub && inspectionPill) {
        if (complianceTier === 'compliant') {
          statusCard.className = 'rounded-2xl p-6 md:p-8 border border-emerald-500/40 bg-emerald-500/5 space-y-4 transition-all';
          statusBadge.className = 'px-3 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider text-white bg-emerald-700 shadow-xs';
          statusBadge.textContent = dict.statusCompliant;
          inspectionPill.className = 'text-xs font-bold px-2.5 py-1 rounded-md bg-emerald-100 text-emerald-800';
          inspectionPill.textContent = dict.inspectionRiskNone;
          statusHeadline.textContent = "NSF/ANSI Cleanability Standards Met";
          statusHeadline.className = "text-title-lg font-bold text-emerald-950";
          statusSub.textContent = `Equipment surface is smooth, non-porous, and receiving effective thermal/chemical pathogen eradication. Safe for high-volume commercial food preparation under ${eq.nsfStandard}.`;
        } else if (complianceTier === 'warning') {
          statusCard.className = 'rounded-2xl p-6 md:p-8 border border-amber-500/40 bg-amber-500/5 space-y-4 transition-all';
          statusBadge.className = 'px-3 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider text-white bg-amber-600 shadow-xs';
          statusBadge.textContent = dict.statusWarning;
          inspectionPill.className = 'text-xs font-bold px-2.5 py-1 rounded-md bg-amber-100 text-amber-900';
          inspectionPill.textContent = dict.inspectionRiskWarning;
          statusHeadline.textContent = "Surface Degradation Requires Reconditioning";
          statusHeadline.className = "text-title-lg font-bold text-amber-950";
          statusSub.textContent = `Micro-crevices and surface fatigue require increased sanitizer contact times or physical resurfacing. Continued use without corrective action will precipitate health code violations.`;
        } else {
          statusCard.className = 'rounded-2xl p-6 md:p-8 border border-red-500/40 bg-red-500/5 space-y-4 transition-all';
          statusBadge.className = 'px-3 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider text-white bg-red-600 shadow-xs';
          statusBadge.textContent = dict.statusCondemned;
          inspectionPill.className = 'text-xs font-bold px-2.5 py-1 rounded-md bg-red-100 text-red-900';
          inspectionPill.textContent = dict.inspectionRiskCritical;
          statusHeadline.textContent = "CRITICAL SANITATION FAILURE: Immediate Decommission Mandated";
          statusHeadline.className = "text-title-lg font-bold text-red-950";
          statusSub.textContent = `Surface grooving, flaking, or chemical corrosion prevents effective sanitizer penetration. Pathogenic biofilms (Listeria, Salmonella) cannot be eradicated. Mandatory removal from kitchen per FDA Food Code.`;
        }
      }

      // Detailed text cards
      if (citationText) {
        citationText.textContent = `${eq.fdaCodeCitation} [Classification: ${
          complianceTier === 'condemned' ? data.inspectionViolations.critical.level : complianceTier === 'warning' ? data.inspectionViolations.nonCritical.level : 'Passing Grade'
        }]`;
      }

      if (sanitizerText) {
        sanitizerText.textContent = `${proto.sanitizingAgent}. Warning: ${proto.compatibilityWarning} ${proto.corrosiveProfile}`;
      }

      if (correctiveActionText) {
        correctiveActionText.textContent = eq.maintenanceProtocol;
      }

      if (replacementText) {
        replacementText.textContent = eq.replacementRecommendation;
      }
    }

    // Attach listeners
    eqSelect.addEventListener('change', recalculate);
    sanSelect.addEventListener('change', recalculate);
    wearSelect.addEventListener('change', recalculate);
    cyclesSlider.addEventListener('input', recalculate);
    monthsSlider.addEventListener('input', recalculate);

    // Copy Report handler
    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        const eqId = eqSelect.value;
        const eq = data.equipmentCategories.find((c: any) => c.id === eqId) || data.equipmentCategories[0];
        const status = statusBadge ? statusBadge.textContent : 'Audited';
        const biofilm = biofilmPercent ? biofilmPercent.textContent : '0%';
        const wear = wearPercent ? wearPercent.textContent : '0%';
        const remMonths = remainingMonthsVal ? remainingMonthsVal.textContent : '0';
        const citation = citationText ? citationText.textContent : '';
        const corrective = correctiveActionText ? correctiveActionText.textContent : '';

        const report = `========================================================
COMMERCIAL KITCHEN SANITATION & NSF/ANSI LIFECYCLE AUDIT
IsItKitchenSafe Diagnostic Audit Report
========================================================
Equipment: ${eq.name}
Substrate Standard: ${eq.nsfStandard}
NSF / FDA Compliance Status: ${status}
Biofilm Colonization Risk Index: ${biofilm}
Lifecycle Fatigue Depletion: ${wear}
Estimated Remaining Safe Service: ${remMonths}

REGULATORY HEALTH INSPECTION CITATION:
${citation}

MANDATORY CORRECTIVE ACTION PROTOCOL:
${corrective}

CERTIFIED NSF UPGRADE RECOMMENDATION:
${eq.replacementRecommendation}
========================================================
Audited via IsItKitchenSafe Commercial NSF Lifecycle Engine
URL: https://isitkitchensafe.com/tools/commercial-cookware-nsf-inspector/`;

        navigator.clipboard.writeText(report).then(() => {
          if (copyConfirm) {
            copyConfirm.classList.remove('hidden');
            setTimeout(() => {
              copyConfirm.classList.add('hidden');
            }, 3000);
          }
        });
      });
    }

    // Initial run
    recalculate();
  }

  // Support Astro view transitions or direct DOM load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNsfInspector);
  } else {
    initNsfInspector();
  }
  document.addEventListener('astro:page-load', initNsfInspector);
</script>
