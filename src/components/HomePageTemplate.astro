  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const searchForm = document.getElementById('search-form') as HTMLFormElement | null;
      const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
      const datalist = document.getElementById('search-items') as HTMLDataListElement | null;
      const searchLoading = document.getElementById('search-loading');
      const searchPath = searchForm?.dataset.searchPath || '/search-index.json';
      const searchError = document.getElementById('search-error');
      const searchErrorTerm = document.getElementById('search-error-term');
      
      let searchIndex: Array<{ name: string; appliance: string; url: string; keywords: string }> | null = null;
      let isFetching = false;

      const populateDatalist = (items: typeof searchIndex) => {
        if (!datalist || !items) return;
        datalist.innerHTML = items.map(entry => 
          `<option value="${entry.name} (${entry.appliance})" data-url="${entry.url}"></option>`
        ).join('');
      };

      const loadSearchIndex = async (): Promise<boolean> => {
        if (searchIndex) return true;
        if (isFetching) return false;
        
        isFetching = true;
        if (searchLoading) searchLoading.classList.remove('hidden');
        if (searchError) searchError.classList.add('hidden');
        
        try {
          const response = await fetch(searchPath);
          if (response.ok) {
            const rawIndex = await response.json();
            searchIndex = rawIndex.map((entry: any) => ({
              name: entry.name,
              appliance: entry.category,
              url: entry.url,
              keywords: entry.keywords || ''
            }));
            populateDatalist(searchIndex);
            return true;
          }
        } catch (e) {
          console.error("Failed to load search index", e);
        } finally {
          isFetching = false;
          if (searchLoading) searchLoading.classList.add('hidden');
        }
        return false;
      };

      const performSearch = (query: string) => {
        if (!query || query.trim() === '' || !searchIndex) return;
        
        const rawValue = query.toLowerCase().trim();
        if (searchError) searchError.classList.add('hidden');
        
        let match = searchIndex.find(item => item.name.toLowerCase() === rawValue);

        if (!match) {
          match = searchIndex.find(item => {
            const displayVal = `${item.name} (${item.appliance})`.toLowerCase();
            return displayVal === rawValue;
          });
        }

        if (!match) {
          match = searchIndex.find(item => item.name.toLowerCase().includes(rawValue));
        }
        
        if (!match) {
          match = searchIndex.find(item => item.keywords && item.keywords.includes(rawValue));
        }

        if (match) {
          window.location.href = match.url;
        } else {
          if (searchError && searchErrorTerm) {
            searchErrorTerm.textContent = query;
            searchError.classList.remove('hidden');
          }
        }
      };

      const params = new URLSearchParams(window.location.search);
      const q = params.get('q');
      if (q && q.trim() !== '') {
        loadSearchIndex().then((loaded) => {
          if (loaded && searchInput) {
            searchInput.value = q;
            performSearch(q);
          }
        });
      }

      if (searchInput) {
        searchInput.addEventListener('focus', loadSearchIndex, { once: true });
        searchInput.addEventListener('input', loadSearchIndex, { once: true });
      }

      if (searchForm && searchInput) {
        searchForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          const query = searchInput.value;
          if (!query) return;
          
          if (!searchIndex) {
            await loadSearchIndex();
          }
          performSearch(query);
        });
      }
    });
  </script>
