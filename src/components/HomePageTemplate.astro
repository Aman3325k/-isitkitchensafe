      es: 'Convierte al instante recetas de horno tradicional a freidora de aire, convección, °F/°C y Gas Mark ajustando el tiempo.',
      pt: 'Converta receitas de forno convencional para Air Fryer, convecção, °F/°C e Gas Mark com redução automática de tempo.',
      'zh-cn': '一键将传统烤箱食谱换算为空气炸锅、热风对流烤箱、华氏/摄氏度及燃气档位，自动缩减烹饪时长。',
      ja: '通常オーブンのレシピをノンフライヤー・コンベクション・°F/°C・ガスマークへ自動で時短換算します。'
    }
  },
  {
    slug: 'cookware-oven-temp-lookup',
    icon: 'oven',
    accentClass: 'bg-warning/15 text-warning',
    tag: {
      en: '24 Brands',
      es: '24 Marcas',
      pt: '24 Marcas',
      'zh-cn': '24 大品牌',
      ja: '24ブランド対応'
    },
    title: {
      en: 'Cookware & Bakeware Safe Oven Temp Lookup',
      es: 'Límite Seguro de Horno por Marca (24 Marcas)',
      pt: 'Temperatura Segura de Forno (24 Marcas)',
      'zh-cn': '24 大品牌厨具与烤盘耐高温查询',
      ja: '主要24ブランド調理器具・オーブン耐熱温度検索'
    },
    desc: {
      en: 'Look up exact max oven & broiler temps for Pyrex, Le Creuset, Caraway, HexClad, Staub, Lodge, and 24 leading brands.',
      es: 'Consulta la temperatura máxima de horno y gratinador para Pyrex, Le Creuset, Caraway, HexClad, Staub, Lodge y 24 marcas.',
      pt: 'Veja a temperatura máxima de forno e grill para Pyrex, Le Creuset, Caraway, HexClad, Staub, Lodge e 24 marcas famosas.',
      'zh-cn': '查询 Pyrex、Le Creuset、Caraway、HexClad、Staub、Lodge 等 24 大主流品牌锅具与烤盘的最高烤箱耐温。',
      ja: 'Pyrex・Le Creuset・Caraway・HexClad・Staub・Lodgeなど主要24ブランドのオーブン耐熱上限を検索。'
    }
  },
  {
    slug: 'internal-cooking-temp-chart',
    icon: 'thermometer',
    accentClass: 'bg-signature-coral/10 text-signature-coral',
    tag: {
      en: 'USDA Probe',
      es: 'Guía USDA',
      pt: 'Guia USDA',
      'zh-cn': 'USDA 中心温度',
      ja: 'USDA 中心温度'
    },
    title: {
      en: 'USDA Safe Internal Cooking Temp Chart & Probe Checker',
      es: 'Tabla USDA de Temperatura Interna y Termómetro',
      pt: 'Tabela USDA de Temperatura Interna e Termômetro',
      'zh-cn': 'USDA 安全中心烹饪温度表与探针检测',
      ja: 'USDA 安全中心温度チャート＆温度計チェッカー'
    },
    desc: {
      en: 'Verify safe minimum internal °F/°C temperatures, instant probe verdicts, and rest times for poultry, steak, pork, and seafood.',
      es: 'Verifica temperaturas internas mínimas (°F/°C), lecturas de termómetro y tiempos de reposo para aves, carnes y mariscos.',
      pt: 'Confira temperaturas internas mínimas (°F/°C), leituras de termômetro e tempo de descanso para aves, carnes e frutos do mar.',
      'zh-cn': '核对禽肉、牛排、猪肉及海鲜的 USDA 最低安全中心温度（°F/°C）、探针读数判定与静置时间。',
      ja: '鶏肉・ステーキ・豚肉・魚介類のUSDA安全中心温度（°F/°C）と温度計チェック・休ませ時間を確認できます。'
    }
  },
  {
    slug: 'pan-scratch-inspector',
    icon: 'pan',
    accentClass: 'bg-error/10 text-error',
    tag: {
      en: 'Cookware Safety',
      es: 'Sartenes',
      pt: 'Panelas',
      'zh-cn': '锅具健康',
      ja: '調理器具診断'
    },
    title: {
      en: 'AI Pan Scratch & Nonstick Coating Inspector',
      es: 'Inspector de Rayones y Recubrimiento Antiadherente',
      pt: 'Inspetor de Riscos e Revestimento Antiaderente',
      'zh-cn': 'AI 不粘锅划痕与涂层损伤检测器',
      ja: 'AI フライパン傷・ノンスティック塗装診断'
    },
    desc: {
      en: 'Assess scratched nonstick Teflon, ceramic, and anodized pans to know whether to keep cooking safely or replace immediately.',
      es: 'Evalúa el desgaste de sartenes antiadherentes de teflón o cerámica para decidir si aún son seguros o conviene reemplazarlos.',
      pt: 'Avalie riscos em panelas antiaderentes de teflon ou cerâmica para saber se ainda é seguro cozinhar ou hora de trocar.',
      'zh-cn': '评估特氟龙、陶瓷与阳极氧化不粘锅涂层的划痕与剥落损伤，科学判断是否仍可安全使用或需立即更换。',
      ja: 'テフロン・セラミック・アルマイト加工の傷や剥がれ具合を診断し、使い続けて安全か買い替えるべきかを判定します。'
    }
  }
];

const spotlightTools = spotlightToolsRaw.map((tool) => ({
  slug: tool.slug,
  icon: tool.icon,
  accentClass: tool.accentClass,
  url: translatePath(`/tools/${tool.slug}/`),
  tag: tool.tag[lang] || tool.tag.en,
  title: tool.title[lang] || tool.title.en,
  desc: tool.desc[lang] || tool.desc.en
}));

const toolsSpotlightCopyMap: Record<SupportedLanguage, {
  badge: string;
  title: string;
  subtitle: string;
  launchTool: string;
  allToolsCta: string;
  cheatSheetCta: string;
}> = {
  en: {
    badge: 'Interactive Consumer Labs',
    title: 'Free Interactive Kitchen Safety Tools',
    subtitle: 'Instant USDA calculators, visual symbol decoders, oven temp lookups, and cookware inspectors built to prevent kitchen hazards in seconds.',
    launchTool: 'Open free tool',
    allToolsCta: 'Explore All Interactive Tools',
    cheatSheetCta: 'Printable Fridge Cheat Sheet'
  },
  es: {
    badge: 'Herramientas Interactivas Gratuitas',
    title: 'Herramientas Interactivas de Seguridad en la Cocina',
    subtitle: 'Calculadoras USDA instantáneas, decodificadores visuales, límites de horno por marca e inspectores de utensilios para cocinar sin riesgos.',
    launchTool: 'Abrir herramienta',
    allToolsCta: 'Explorar Todas las Herramientas',
    cheatSheetCta: 'Guía Imprimible para la Nevera'
  },
  pt: {
    badge: 'Ferramentas Interativas Gratuitas',
    title: 'Ferramentas Interativas de Segurança na Cozinha',
    subtitle: 'Calculadoras USDA instantâneas, decodificadores visuais, limites de forno por marca e inspetores de panelas para evitar acidentes em segundos.',
    launchTool: 'Abrir ferramenta',
    allToolsCta: 'Explorar Todas as Ferramentas',
    cheatSheetCta: 'Guia Imprimível para Geladeira'
  },
  'zh-cn': {
    badge: '免费互动安全实验室',
    title: '免费交互式厨房安全实用工具',
    subtitle: '无需下载，即时使用标志解码、USDA 剩菜与解冻计时、塑料编号查询、烤箱温时换算与不粘锅涂层检测等实用工具。',
    launchTool: '免费使用工具',
    allToolsCta: '浏览全部交互式工具',
    cheatSheetCta: '可打印冰箱贴速查表'
  },
  ja: {
    badge: '無料インタラクティブツール',
    title: '無料で使えるキッチン安全診断ツール',
    subtitle: '底面マーク解読、USDA保存期限・解凍タイマー、プラ識別判定、オーブン温度換算、フライパン傷診断まで毎日使える実用ツール集。',
    launchTool: '無料ツールを開く',
    allToolsCta: 'すべての診断ツールを見る',
    cheatSheetCta: '印刷用・冷蔵庫チートシート'
  }
};
const toolsSpotlightCopy = toolsSpotlightCopyMap[lang] || toolsSpotlightCopyMap.en;
const toolsHubUrl = getDirectoryUrl('tools', lang);
const savedCheatSheetUrl = getDirectoryUrl('saved', lang);
---

<Layout 
  title={metaTitle} 
  description={metaDesc}
  faqs={homeFaqs}
  excludeArticleSchema={true}
  lang={lang}
  availableLocales={['en', 'es', 'pt', 'zh-cn', 'ja']}
>
  <!-- Hero Section -->
  <section class="bg-canvas border-b border-hairline py-[80px] md:py-[96px]">
    <div class="max-w-[800px] mx-auto px-6 text-center flex flex-col items-center">
      <h1 class="text-display-lg md:text-display-xl font-medium tracking-tight text-ink mb-6">
        {t('home.heroTitle')}
      </h1>
      <p class="text-body-md text-muted max-w-[580px] mb-8 leading-relaxed">
        {t('home.heroSubtitle')}
      </p>

      <!-- Static Search Bar -->
      <form 
        id="search-form" 
        class="w-full max-w-[600px] flex flex-col sm:flex-row gap-3"
        data-search-path={lang === 'en' ? '/search-index.json' : `/${lang}/search-index.json`}
        data-lang={lang}
      >
        <div class="relative flex-grow">
          <input 
            type="text" 
            id="search-input" 
            placeholder={t('home.searchPlaceholder')} 
            autocomplete="off"
            aria-label={t('nav.searchAria')}
            role="combobox"
            aria-autocomplete="list"
            aria-expanded="false"
            aria-controls="search-dropdown"
            class="w-full min-h-[44px] h-12 md:h-11 pl-4 pr-10 py-3 bg-canvas text-ink text-[16px] md:text-[14px] border border-hairline rounded-sm focus:outline-none focus:border-info-border"
          />
          <div 
            id="search-dropdown" 
            role="listbox" 
            aria-label="Search suggestions"
            class="hidden absolute top-full left-0 right-0 mt-1 max-h-72 overflow-y-auto bg-canvas border border-hairline rounded-md shadow-lg z-50 py-1 text-left"
          ></div>
          <div id="search-loading" class="hidden absolute right-3.5 top-1/2 -translate-y-1/2 pointer-events-none">
            <svg class="animate-spin h-5 w-5 text-muted" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </div>
        </div>
        <button 
          type="submit" 
          class="h-12 md:h-11 min-h-[44px] px-6 bg-primary hover:bg-primary-active text-on-primary text-[15px] md:text-[14px] font-medium rounded-sm border-none cursor-pointer flex items-center justify-center transition-colors select-none"
        >
          {lang === 'es' ? 'Verificar Seguridad' : lang === 'pt' ? 'Verificar Segurança' : lang === 'zh-cn' ? '安全验证' : lang === 'ja' ? '安全性を確認' : 'Check Safety'}
        </button>
      </form>
      <div id="search-error" class="hidden w-full max-w-[600px] mt-4 text-left p-4 bg-error-bg text-error border border-error/30 rounded-md text-[14px]">
        {t('nav.searchNoResults')} "<span id="search-error-term"></span>".
      </div>
    </div>
  </section>

  <!-- Browse by Appliance -->
  <section id="appliances-section" class="max-w-[1280px] mx-auto px-6 pt-[96px] pb-12">
    <div class="mb-12">
      <h2 class="text-display-md text-ink tracking-tight mb-3">{t('home.exploreAppliances')}</h2>
      <p class="text-body-md text-muted">
        {lang === 'es' ? 'Selecciona un electrodoméstico para explorar todas las reglas de seguridad.' : lang === 'pt' ? 'Selecione um eletrodoméstico para ver todas as regras de segurança.' : lang === 'zh-cn' ? '选择厨房电器，查看完整的安全指南与使用规则。' : lang === 'ja' ? '家電を選択して、安全ルールやガイドを確認できます。' : 'Select an appliance to explore all safety guides and rules.'}
      </p>
    </div>

    <!-- Responsive Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      {appliances.map(app => (
        <a 
          href={getApplianceUrl(app.slug, lang)} 
          class={`${app.bgColor} ${app.textColor} rounded-lg p-8 flex flex-col justify-between min-h-[200px] shadow-sm transition-transform active:scale-[0.98] border border-transparent`}
        >
          <div>
            <span class="text-caption font-semibold tracking-wider uppercase mb-2 block">{app.name} {t('page.guideSuffix')}</span>
            <h3 class="text-title-lg font-medium tracking-tight mb-3 flex items-center justify-between">
              <span>{app.name}</span>
              {lang !== 'en' && !isApplianceTranslatedInLocale(app.slug, lang) && (
                <span class="text-[9px] font-semibold text-muted bg-surface-soft border border-hairline px-1 py-0.5 rounded tracking-wider uppercase" title="Available in English only">EN</span>
              )}
            </h3>
            <p class="text-body-md leading-relaxed mb-6">{app.desc}</p>
          </div>
          <span class="text-[14px] font-medium underline underline-offset-4 flex items-center gap-1">
            {t('home.viewAll')} &rarr;
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- Interactive "Can I Put This In...?" 7-Appliance Matrix Lookup -->
  {defaultMatrixItem && (
    <section id="home-matrix-section" class="bg-surface-soft border-t border-b border-hairline py-16 md:py-20">
      <div class="max-w-[1280px] mx-auto px-6">
        <div class="mb-8 max-w-3xl">
          <div class="flex items-center gap-2 mb-2.5">
            <span class="inline-flex items-center justify-center bg-signature-forest/10 text-signature-forest dark:bg-success/15 dark:text-success w-5 h-5 rounded-full font-bold text-xs" aria-hidden="true">⚡</span>
            <span class="text-xs uppercase tracking-wider text-muted font-bold">{matrixCopy.badge}</span>
          </div>
          <h2 class="text-display-md text-ink tracking-tight mb-3">{matrixCopy.title}</h2>
          <p class="text-body-md text-muted leading-relaxed">{matrixCopy.subtitle}</p>
        </div>

        <!-- Search + Quick-Pick Controls -->
        <div class="bg-canvas border border-hairline rounded-lg p-5 md:p-6 shadow-xs mb-5">
          <div class="relative max-w-xl mb-4" id="home-matrix-search-wrap">
            <label for="home-matrix-search" class="sr-only">{matrixCopy.searchLabel}</label>
            <div class="relative">
              <svg class="w-4 h-4 text-muted absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35m1.85-5.15a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
              <input
                type="text"
                id="home-matrix-search"
                autocomplete="off"
                placeholder={matrixCopy.searchPlaceholder}
                role="combobox"
                aria-autocomplete="list"
                aria-expanded="false"
                aria-controls="home-matrix-dropdown"
                class="w-full min-h-[44px] pl-10 pr-10 py-2.5 bg-surface-soft text-ink text-[15px] md:text-[14px] border border-hairline rounded-sm focus:outline-none focus:border-info-border focus:bg-canvas transition-colors"
              />
              <button
                type="button"
                id="home-matrix-clear"
                aria-label={matrixCopy.clearSearch}
                class="hidden absolute right-2 top-1/2 -translate-y-1/2 w-8 h-8 rounded-sm text-muted hover:text-ink hover:bg-surface-strong/50 flex items-center justify-center cursor-pointer transition-colors"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
            </div>
            <div
              id="home-matrix-dropdown"
              role="listbox"
              aria-label={matrixCopy.searchLabel}
              class="hidden absolute top-full left-0 right-0 mt-1 max-h-64 overflow-y-auto bg-canvas border border-hairline rounded-md shadow-lg z-40 py-1 text-left"
            ></div>
          </div>

          <!-- Top 8 Quick-Pick Chips -->
          <div class="flex flex-wrap items-center gap-2" id="home-matrix-chips" role="group" aria-label={matrixCopy.quickPickLabel}>
            <span class="text-xs font-semibold uppercase tracking-wider text-muted mr-1">{matrixCopy.quickPickLabel}</span>
            {matrixQuickChips.map((item, idx) => (
              <button
                type="button"
                data-matrix-slug={item.slug}
                aria-pressed={idx === 0 ? 'true' : 'false'}
                class={`matrix-chip min-h-[36px] px-3.5 py-1.5 rounded-full text-[13px] font-medium border transition-colors cursor-pointer select-none ${
                  idx === 0
                    ? 'bg-primary text-on-primary border-primary'
                    : 'bg-surface-soft text-ink border-hairline hover:border-border-strong'
                }`}
              >
                {item.label}
              </button>
            ))}
            {matrixItems.length > 8 && (
              <button
                type="button"
                id="home-matrix-toggle-all"
                aria-expanded="false"
                aria-controls="home-matrix-all-chips"
                data-label-show={matrixCopy.showAllLabel}
                data-label-hide={matrixCopy.hideAllLabel}
                class="min-h-[36px] px-3 py-1.5 rounded-full text-[13px] font-medium text-link hover:text-link-active bg-transparent border border-dashed border-hairline hover:border-info-border transition-colors cursor-pointer select-none"
              >
                {matrixCopy.showAllLabel} +
              </button>
            )}
          </div>

          <!-- Collapsible Tray for Remaining Matrix Items (9-32) -->
          {matrixItems.length > 8 && (
            <div id="home-matrix-all-chips" class="hidden mt-3 pt-3 border-t border-hairline/70 flex flex-wrap gap-2">
              {matrixItems.slice(8).map((item) => (
                <button
                  type="button"
                  data-matrix-slug={item.slug}
                  aria-pressed="false"
                  class="matrix-chip min-h-[34px] px-3 py-1 rounded-full text-[12.5px] font-medium border bg-surface-soft text-ink border-hairline hover:border-border-strong transition-colors cursor-pointer select-none"
                >
                  {item.label}
                </button>
              ))}
            </div>
          )}
        </div>

        <!-- 7-Appliance Safety Row Output -->
        <div class="bg-canvas border border-hairline rounded-lg p-5 md:p-6 shadow-xs" aria-live="polite">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-5 pb-4 border-b border-hairline/70">
            <h3 class="text-title-sm text-ink font-semibold flex flex-wrap items-center gap-1.5">
              <span class="text-muted font-normal">{matrixCopy.verdictsFor}</span>
              <span id="home-matrix-active-name" class="text-ink font-semibold">{defaultMatrixItem.label}</span>
            </h3>
            <span id="home-matrix-active-count" class="text-xs font-semibold text-muted bg-surface-soft border border-hairline px-2.5 py-1 rounded-full self-start sm:self-auto">
              {defaultMatrixItem.count}/7 {matrixCopy.guidesSuffix}
            </span>
          </div>

          <div id="home-matrix-grid" class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-3">
            {matrixApplianceMeta.map((app) => {
              const entry = defaultMatrixItem.appliances[app.slug];
              if (entry) {
                const cardClass =
                  entry.safe === 'yes'
                    ? 'border-success/35 bg-success/5 hover:border-success'
                    : entry.safe === 'no'
                    ? 'border-error/35 bg-error/5 hover:border-error'
                    : 'border-warning/40 bg-warning/5 hover:border-warning';
                const badgeClass =
                  entry.safe === 'yes'
                    ? 'badge-yes'
                    : entry.safe === 'no'
                    ? 'badge-no'
                    : 'badge-depends';
                const verdictText =
                  entry.safe === 'yes'
                    ? t('verdict.yes')
                    : entry.safe === 'no'
                    ? t('verdict.no')
                    : t('verdict.depends');
                return (
                  <a
                    href={entry.url}
                    class={`group rounded-md p-3.5 border transition-all flex flex-col items-center justify-between text-center min-h-[120px] shadow-2xs hover:shadow-sm ${cardClass}`}
                  >
                    <span class="text-[13px] font-semibold text-ink leading-tight">{app.name}</span>
                    <span class={`${badgeClass} my-2 text-[11px] px-3 py-1`}>{verdictText}</span>
                    <span class="text-[12px] font-medium text-link group-hover:underline inline-flex items-center gap-0.5">
                      {matrixCopy.readGuide} <span aria-hidden="true">&rarr;</span>
                    </span>
                  </a>
                );
              }
              return (
                <div class="rounded-md p-3.5 border border-dashed border-hairline bg-surface-soft/70 flex flex-col items-center justify-between text-center min-h-[120px] opacity-75">
                  <span class="text-[13px] font-medium text-muted leading-tight">{app.name}</span>
                  <span class="my-2 inline-flex items-center justify-center font-semibold px-3 py-1 rounded-full text-[11px] tracking-wider uppercase bg-surface-strong/70 text-muted border border-hairline">
                    {matrixCopy.naLabel}
                  </span>
                  <span class="text-[11px] text-muted">{matrixCopy.naSubtext}</span>
                </div>
              );
            })}
          </div>

          <p class="mt-4 text-[12.5px] text-muted">{matrixCopy.footerHint}</p>
        </div>

        <script id="home-matrix-data" type="application/json" is:inline set:html={JSON.stringify(matrixClientPayload).replace(/</g, '\\u003c')}></script>
      </div>
    </section>
  )}

  <!-- Consumer Kitchen Tools Spotlight Grid -->
  <section id="home-tools-spotlight" class="bg-canvas py-16 md:py-20">
    <div class="max-w-[1280px] mx-auto px-6">
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-4 mb-10">
        <div class="max-w-2xl">
          <div class="flex items-center gap-2 mb-2.5">
            <span class="inline-flex items-center justify-center bg-info/10 text-info w-5 h-5 rounded-full font-bold text-xs" aria-hidden="true">★</span>
            <span class="text-xs uppercase tracking-wider text-muted font-bold">{toolsSpotlightCopy.badge}</span>
          </div>
          <h2 class="text-display-md text-ink tracking-tight mb-3">{toolsSpotlightCopy.title}</h2>
          <p class="text-body-md text-muted leading-relaxed">{toolsSpotlightCopy.subtitle}</p>
        </div>
        <div class="flex flex-wrap items-center gap-3 shrink-0">
          <a
            href={toolsHubUrl}
            class="min-h-[44px] px-5 py-2.5 bg-primary hover:bg-primary-active text-on-primary text-[14px] font-medium rounded-md inline-flex items-center justify-center gap-1.5 transition-colors"
          >
            <span>{toolsSpotlightCopy.allToolsCta}</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
          <a
            href={savedCheatSheetUrl}
