---
import Layout from '../layouts/Layout.astro';
import itemsData from '../data/items.json';
import itemsEs from '../data/items.es.json';
import itemsPt from '../data/items.pt.json';
import itemsZh from '../data/items.zh-cn.json';
import itemsJa from '../data/items.ja.json';
import { useTranslations, useTranslatedPath, getApplianceIn, getApplianceUrl, getDirectoryUrl, isApplianceTranslatedInLocale, isDirectoryTranslatedInLocale } from '../i18n/utils';
import type { SupportedLanguage } from '../i18n/ui';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;

const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

// Format appliance names
function formatAppliance(app: string) {
  const appKey = `appliance.${app}` as any;
  return t(appKey) || (app.charAt(0).toUpperCase() + app.slice(1));
}

// Localized content definitions for appliances
const applianceData: Record<string, { desc: Record<SupportedLanguage, string>; bg: string; text: string }> = {
  dishwasher: {
    desc: {
      en: 'Can you wash cast iron, vacuum flasks, and blender lids?',
      es: '¿Se pueden lavar sartenes de hierro, botellas térmicas y tapas de licuadora?',
      pt: 'Pode lavar ferro fundido, garrafas térmicas e tampas de liquidificador?',
      'zh-cn': '铸铁锅、真空保温杯和搅拌机杯盖可以机洗吗？',
      ja: '鉄フライパンや真空断熱ボトル、ミキサーのフタは洗える？'
    },
    bg: 'bg-signature-forest',
    text: 'text-white'
  },
  microwave: {
    desc: {
      en: 'Is Styrofoam, aluminum foil, or paper plates safe to heat?',
      es: '¿Es seguro calentar espuma de poliestireno, papel de aluminio o platos de cartón?',
      pt: 'É seguro aquecer isopor, papel alumínio ou pratos descartáveis?',
      'zh-cn': '泡沫塑料、铝箔纸或纸盘可以微波加热吗？',
      ja: '発泡スチロール、アルミホイル、紙皿はレンジ加熱できる？'
    },
    bg: 'bg-signature-coral',
    text: 'text-white'
  },
  freezer: {
    desc: {
      en: 'What happens if you freeze milk, avocados, or carbonated soda?',
      es: '¿Qué pasa si congelas leche, aguacates o bebidas con gas?',
      pt: 'O que acontece ao congelar leite, abacates ou refrigerantes com gás?',
      'zh-cn': '冷冻牛奶、牛油果或碳酸饮料会发生什么？',
      ja: '牛乳、アボカド、炭酸飲料を凍らせるとどうなる？'
    },
    bg: 'bg-signature-cream',
    text: 'text-ink'
  },
  oven: {
    desc: {
      en: 'Baking with parchment paper, wax paper, glass, or plastic?',
      es: '¿Hornear con papel para hornear, papel encerado o vidrio?',
      pt: 'Assar com papel manteiga, papel vegetal, vidro ou plástico?',
      'zh-cn': '烘焙时可以使用烘焙纸、蜡纸、玻璃或塑料吗？',
      ja: 'クッキングシート、ワックスペーパー、耐熱ガラスはオーブン可能？'
    },
    bg: 'bg-signature-peach',
    text: 'text-ink'
  },
  dryer: {
    desc: {
      en: 'Will shoes, Crocs, pillows, or wool shrink in the dryer?',
      es: '¿Se encogen los zapatos, Crocs, almohadas o prendas de lana en la secadora?',
      pt: 'Calçados, Crocs, travesseiros ou lã encolhem na secadora?',
      'zh-cn': '鞋子、洞洞鞋、枕头或羊毛会在烘干机中缩水吗？',
      ja: '靴、クロックス、枕、ウール素材は乾燥機で縮む？'
    },
    bg: 'bg-signature-mint',
    text: 'text-ink'
  },
  airfryer: {
    desc: {
      en: 'Can you use foil, parchment paper, or cook raw chicken?',
      es: '¿Se puede usar papel aluminio, papel de horno o cocinar pollo crudo?',
      pt: 'Pode usar papel alumínio, papel manteiga ou assar frango cru?',
      'zh-cn': '可以使用锡纸、烘焙纸或直接烹饪生鸡肉吗？',
      ja: 'アルミホイルやクッキングシートは使える？生の鶏肉は調理可能？'
    },
    bg: 'bg-signature-yellow',
    text: 'text-ink'
  },
  refrigerator: {
    desc: {
      en: 'Should you store potatoes, onions, honey, or tomatoes in the cold?',
      es: '¿Se deben guardar papas, cebollas, miel o tomates en el frío?',
      pt: 'Deve guardar batatas, cebolas, mel ou tomates na geladeira?',
      'zh-cn': '土豆、洋葱、蜂蜜或番茄应该放冰箱冷藏吗？',
      ja: 'じゃがいも、玉ねぎ、蜂蜜、トマトは冷蔵庫に入れるべき？'
    },
    bg: 'bg-signature-mustard',
    text: 'text-ink'
  }
};

const appliances = [
  { slug: 'dishwasher', name: t('appliance.dishwasher') },
  { slug: 'microwave', name: t('appliance.microwave') },
  { slug: 'freezer', name: t('appliance.freezer') },
  { slug: 'oven', name: t('appliance.oven') },
  { slug: 'dryer', name: t('appliance.dryer') },
  { slug: 'airfryer', name: t('appliance.airfryer') },
  { slug: 'refrigerator', name: t('appliance.refrigerator') }
].map(app => ({
  ...app,
  desc: applianceData[app.slug]?.desc[lang] || applianceData[app.slug]?.desc.en,
  bgColor: applianceData[app.slug]?.bg || 'bg-surface-soft',
  textColor: applianceData[app.slug]?.text || 'text-ink'
}));

// Popular test showcase items
const currentItemsDataset = lang === 'es' ? itemsEs : lang === 'pt' ? itemsPt : lang === 'zh-cn' ? itemsZh : lang === 'ja' ? itemsJa : itemsData;
const popularItems = currentItemsDataset.slice(0, 6);

const homeFaqs = lang === 'es' ? [
  {
    question: "¿Qué es IsItKitchenSafe?",
    answer: "IsItKitchenSafe es una base de datos de consulta estática que ayuda a determinar rápidamente si los utensilios, recipientes y alimentos de uso diario se pueden colocar de forma segura en distintos electrodomésticos."
  },
  {
    question: "¿Qué electrodomésticos se cubren en este sitio?",
    answer: "Cubrimos siete electrodomésticos principales: lavavajillas, microondas, congelador, horno, secadora, freidora de aire y refrigerador."
  },
  {
    question: "¿Cómo se verifica la información de seguridad?",
    answer: "Nuestras recomendaciones se compilan a partir de pautas de ciencia de materiales, manuales oficiales de fabricantes, normas de seguridad alimentaria y principios fundamentales de seguridad en la cocina."
  }
] : lang === 'pt' ? [
  {
    question: "O que é o IsItKitchenSafe?",
    answer: "O IsItKitchenSafe é uma base de referência rápida que ajuda a descobrir se recipientes, utensílios de cozinha e alimentos podem ser usados com segurança em eletrodomésticos."
  },
  {
    question: "Quais eletrodomésticos são abordados no site?",
    answer: "Cobrimos sete eletrodomésticos principais: máquina de lavar louça, micro-ondas, freezer, forno, secadora, fritadeira sem óleo (air fryer) e geladeira."
  },
  {
    question: "Como as informações de segurança são verificadas?",
    answer: "Nossas diretrizes são elaboradas com base em manuais oficiais de fabricantes, diretrizes de ciência dos materiais e normas internacionais de segurança alimentar."
  }
] : lang === 'zh-cn' ? [
  {
    question: "什么是 厨房安全指南 (Is It Kitchen Safe)？",
    answer: "Is It Kitchen Safe 是一个权威的厨房电器安全速查指南，帮助您快速判断餐具、容器及各类食材能否安全放入微波炉、洗碗机、冷冻室及烤箱等家用电器。"
  },
  {
    question: "本站涵盖哪些厨房电器与专区？",
    answer: "涵盖洗碗机、微波炉、冷冻室、烤箱、烘干机、空气炸锅、冰箱冷藏室等核心电器，以及食品保质期、二次冷冻安全等专项安全索引。"
  },
  {
    question: "安全指南是如何审核验证的？",
    answer: "所有安全指南均基于国家食品接触材料标准（GB 4806系列）、JIS标准、FDA及各大家电原厂使用说明书进行严格交叉核验。"
  }
] : lang === 'ja' ? [
  {
    question: "キッチン安全チェッカーとは？",
    answer: "キッチン安全チェッカーは、食器、保存容器、食材が各種キッチン家電で安全に使えるかを即座に判定できる静的リファレンスサイトです。"
  },
  {
    question: "どの家電に対応していますか？",
    answer: "食洗機、電子レンジ、冷凍庫、オーブン、衣類乾燥機、ノンフライヤー、冷蔵庫の7大主要家電と、保存期間や再冷凍ガイドを網羅しています。"
  },
  {
    question: "安全性データはどのように検証されていますか？",
    answer: "JIS（日本産業規格）、食品衛生法、消費者庁ガイドライン、各家電メーカーの公式取扱説明書に基づいて厳格に検証されています。"
  }
] : [
  {
    question: "What is IsItKitchenSafe?",
    answer: "IsItKitchenSafe is a static reference database that helps home cooks quickly determine whether everyday kitchenware, containers, and food items can be safely used in various household appliances."
  },
  {
    question: "Which appliances are covered on this site?",
    answer: "We cover seven major kitchen appliances: the dishwasher, microwave, freezer, oven, dryer, air fryer, and refrigerator."
  },
  {
    question: "How is the safety information verified?",
    answer: "Our recommendations are compiled from material science guidelines, official manufacturer manuals (such as Yeti, Pyrex, and Hydro Flask), FDA safety standards, and kitchen safety principles."
  }
];

let metaTitle = "IsItKitchenSafe - Quick Safety Guides for Kitchen Appliances";
let metaDesc = `Search and browse 2,000+ kitchen safety guides. Find out if you can put cookware, containers, or ingredients in the microwave, dishwasher, freezer, and oven.`;

if (lang === 'es') {
  metaTitle = "¿Es Seguro en la Cocina? - Guías de Seguridad para Electrodomésticos";
  metaDesc = "Respuestas rápidas y verificadas para saber si puedes meter recipientes, utensilios y alimentos en el microondas, lavavajillas, horno, freidora de aire y más.";
} else if (lang === 'pt') {
  metaTitle = "É Seguro na Cozinha? - Guias Rápidos de Segurança para Eletrodomésticos";
  metaDesc = "Descubra se você pode colocar utensílios, recipientes e alimentos no micro-ondas, lava-louças, freezer, forno e fritadeira sem óleo.";
} else if (lang === 'zh-cn') {
  metaTitle = "厨房安全速查指南 - 厨房电器安全参考手册 | Is It Kitchen Safe";
  metaDesc = "即时查询 2,000+ 种日常厨具、容器与食材是否能安全放入微波炉、洗碗机、冷冻室及烤箱。";
} else if (lang === 'ja') {
  metaTitle = "キッチン安全チェッカー - 家電ごとの安全性クイック早見表 | Is It Kitchen Safe";
  metaDesc = "2,000以上のキッチン用品、容器、食材が食洗機、電子レンジ、冷凍庫、オーブンで使えるかを即座に判定。";
}
---

<Layout 
  title={metaTitle} 
  description={metaDesc}
  faqs={homeFaqs}
  excludeArticleSchema={true}
  lang={lang}
  availableLocales={['en', 'es', 'pt', 'zh-cn', 'ja']}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://isitkitchensafe.com/#organization",
          "name": "IsItKitchenSafe",
          "url": "https://isitkitchensafe.com",
          "logo": {
            "@type": "ImageObject",
            "url": "https://isitkitchensafe.com/favicon.svg"
          }
        },
        {
          "@type": "WebSite",
          "@id": "https://isitkitchensafe.com/#website",
          "name": t('nav.siteTitle'),
          "url": "https://isitkitchensafe.com",
          "publisher": {
            "@id": "https://isitkitchensafe.com/#organization"
          },
          "potentialAction": {
            "@type": "SearchAction",
            "target": {
              "@type": "EntryPoint",
              "urlTemplate": "https://isitkitchensafe.com/search?q={search_term_string}"
            },
            "query-input": "required name=search_term_string"
          }
        }
      ]
    })} />
  </Fragment>

  <!-- Hero Section -->
  <section class="bg-canvas border-b border-hairline py-[80px] md:py-[96px]">
    <div class="max-w-[800px] mx-auto px-6 text-center flex flex-col items-center">
      <h1 class="text-display-lg md:text-display-xl font-medium tracking-tight text-ink mb-6">
        {t('home.heroTitle')}
      </h1>
      <p class="text-body-md text-muted max-w-[580px] mb-8 leading-relaxed">
        {t('home.heroSubtitle')}
      </p>

      <!-- Static Search Bar -->
      <form 
        id="search-form" 
        class="w-full max-w-[600px] flex flex-col sm:flex-row gap-3"
        data-search-path={lang === 'en' ? '/search-index.json' : `/${lang}/search-index.json`}
        data-lang={lang}
      >
        <div class="relative flex-grow">
          <input 
            type="text" 
            id="search-input" 
            placeholder={t('home.searchPlaceholder')} 
            list="search-items"
            autocomplete="off"
            aria-label={t('nav.searchAria')}
            class="w-full min-h-[44px] h-12 md:h-11 pl-4 pr-10 py-3 bg-canvas text-ink text-[16px] md:text-[14px] border border-hairline rounded-sm focus:outline-none focus:border-info-border"
          />
          <datalist id="search-items"></datalist>
          <div id="search-loading" class="hidden absolute right-3.5 top-1/2 -translate-y-1/2">
            <svg class="animate-spin h-5 w-5 text-muted" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </div>
        </div>
        <button 
          type="submit" 
          class="h-12 md:h-11 min-h-[44px] px-6 bg-primary hover:bg-primary-active text-on-primary text-[15px] md:text-[14px] font-medium rounded-sm border-none cursor-pointer flex items-center justify-center transition-colors select-none"
        >
          {lang === 'es' ? 'Verificar Seguridad' : lang === 'pt' ? 'Verificar Segurança' : lang === 'zh-cn' ? '安全验证' : lang === 'ja' ? '安全性を確認' : 'Check Safety'}
        </button>
      </form>
      <div id="search-error" class="hidden w-full max-w-[600px] mt-4 text-left p-4 bg-error-bg text-error border border-error/30 rounded-md text-[14px]">
        {t('nav.searchNoResults')} "<span id="search-error-term"></span>".
      </div>
    </div>
  </section>

  <!-- Browse by Appliance -->
  <section class="max-w-[1280px] mx-auto px-6 pt-[96px] pb-12">
    <div class="mb-12">
      <h2 class="text-display-md text-ink tracking-tight mb-3">{t('home.exploreAppliances')}</h2>
      <p class="text-body-md text-muted">
        {lang === 'es' ? 'Selecciona un electrodoméstico para explorar todas las reglas de seguridad.' : lang === 'pt' ? 'Selecione um eletrodoméstico para ver todas as regras de segurança.' : lang === 'zh-cn' ? '选择厨房电器，查看完整的安全指南与使用规则。' : lang === 'ja' ? '家電を選択して、安全ルールやガイドを確認できます。' : 'Select an appliance to explore all safety guides and rules.'}
      </p>
    </div>

    <!-- Responsive Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      {appliances.map(app => (
        <a 
          href={getApplianceUrl(app.slug, lang)} 
          class={`${app.bgColor} ${app.textColor} rounded-lg p-8 flex flex-col justify-between min-h-[200px] shadow-sm transition-transform active:scale-[0.98] border border-transparent`}
        >
          <div>
            <span class="text-caption font-semibold tracking-wider uppercase mb-2 block">{app.name} {t('page.guideSuffix')}</span>
            <h3 class="text-title-lg font-medium tracking-tight mb-3 flex items-center justify-between">
              <span>{app.name}</span>
              {lang !== 'en' && !isApplianceTranslatedInLocale(app.slug, lang) && (
                <span class="text-[9px] font-semibold text-muted bg-surface-soft border border-hairline px-1 py-0.5 rounded tracking-wider uppercase" title="Available in English only">EN</span>
              )}
            </h3>
            <p class="text-body-md leading-relaxed mb-6">{app.desc}</p>
          </div>
          <span class="text-[14px] font-medium underline underline-offset-4 flex items-center gap-1">
            {t('home.viewAll')} &rarr;
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- Browse by Safety Category -->
  <section class="max-w-[1280px] mx-auto px-6 pb-[96px]">
    <div class="mb-12 border-t border-hairline pt-[96px]">
      <h2 class="text-display-md text-ink tracking-tight mb-3">{t('home.safetyDirectories')}</h2>
      <p class="text-body-md text-muted">
        {lang === 'es' ? 'Explora directorios de almacenamiento, cuidado de materiales y prevención de accidentes.' : lang === 'pt' ? 'Explore diretórios de conservação, cuidados com materiais e prevenção de acidentes.' : lang === 'zh-cn' ? '查阅保质期、材质安全及事故预防专项指南。' : lang === 'ja' ? '保存期間、素材のお手入れ、事故防止の特別ガイドを確認できます。' : 'Explore shelf life, material cleaning, and prevention guidelines.'}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <a 
        href={getDirectoryUrl('how-long', lang)} 
        class="bg-signature-forest text-on-primary rounded-lg p-8 flex flex-col justify-between min-h-[220px] shadow-sm transition-transform active:scale-[0.98] border border-transparent"
      >
        <div>
          <span class="text-caption font-semibold tracking-wider uppercase mb-2 block">{t('footer.shelfLife')}</span>
          <h3 class="text-title-lg font-medium tracking-tight mb-3 flex items-center justify-between">
            <span>{t('nav.howLong')}</span>
            {lang !== 'en' && !isDirectoryTranslatedInLocale('how-long', lang) && (
              <span class="text-[9px] font-semibold text-muted bg-surface-soft border border-hairline px-1 py-0.5 rounded tracking-wider uppercase" title="Available in English only">EN</span>
            )}
          </h3>
          <p class="text-body-md leading-relaxed mb-6">
            {lang === 'es' ? '¿Cuánto tiempo duran las carnes, sobras y lácteos en la nevera, congelador o despensa?' : lang === 'pt' ? 'Quanto tempo carnes, sobras e laticínios duram na geladeira ou freezer?' : lang === 'zh-cn' ? '肉类、剩菜、乳制品及果蔬在冷藏、冷冻或常温下可存放多久？' : lang === 'ja' ? '生肉、作り置き、乳製品、野菜は冷蔵・冷凍・常温でどのくらい日持ちする？' : 'How long do raw meats, leftovers, dairy, and produce stay safe in the fridge, freezer, or pantry?'}
          </p>
        </div>
        <span class="text-[14px] font-medium underline underline-offset-4 flex items-center gap-1">
          {t('home.viewAll')} &rarr;
        </span>
      </a>

      <a 
        href={getDirectoryUrl('washing-machine', lang)} 
        class="bg-signature-coral text-white rounded-lg p-8 flex flex-col justify-between min-h-[220px] shadow-sm transition-transform active:scale-[0.98] border border-transparent"
      >
        <div>
          <span class="text-caption font-semibold tracking-wider uppercase mb-2 block">{t('footer.washingMachine')}</span>
          <h3 class="text-title-lg font-medium tracking-tight mb-3 flex items-center justify-between">
            <span>{t('nav.washingMachine')}</span>
            {lang !== 'en' && !isDirectoryTranslatedInLocale('washing-machine', lang) && (
              <span class="text-[9px] font-semibold text-muted bg-surface-soft border border-hairline px-1 py-0.5 rounded tracking-wider uppercase" title="Available in English only">EN</span>
            )}
          </h3>
          <p class="text-body-md leading-relaxed mb-6">
            {lang === 'es' ? '¿Se pueden lavar zapatillas, almohadas o prendas delicadas en la lavadora?' : lang === 'pt' ? 'Pode lavar tênis, travesseiros ou roupas delicadas na máquina de lavar?' : lang === 'zh-cn' ? '运动鞋、枕头、羽绒服或易损衣物可以放洗衣机清洗吗？' : lang === 'ja' ? 'スニーカー、枕、羽毛布団、デリケートな衣類は洗濯機で洗える？' : 'Can you wash sneakers, pillows, bedding, or down jackets in the washing machine?'}
          </p>
        </div>
        <span class="text-[14px] font-medium underline underline-offset-4 flex items-center gap-1">
          {t('home.viewAll')} &rarr;
        </span>
      </a>

      <a 
        href={getDirectoryUrl('refreeze', lang)} 
        class="bg-signature-cream text-ink rounded-lg p-8 flex flex-col justify-between min-h-[220px] shadow-sm transition-transform active:scale-[0.98] border border-transparent"
      >
        <div>
          <span class="text-caption font-semibold tracking-wider uppercase mb-2 block">{t('footer.refreeze')}</span>
          <h3 class="text-title-lg font-medium tracking-tight mb-3 flex items-center justify-between">
            <span>{t('nav.refreeze')}</span>
            {lang !== 'en' && !isDirectoryTranslatedInLocale('refreeze', lang) && (
              <span class="text-[9px] font-semibold text-muted bg-surface-soft border border-hairline px-1 py-0.5 rounded tracking-wider uppercase" title="Available in English only">EN</span>
            )}
          </h3>
          <p class="text-body-md leading-relaxed mb-6">
