      {
        question: "判定の「条件付き」とはどういう意味ですか？",
        answer: "素材のグレード、製造時期、家電のコース設定などによって安全性が異なることを意味します。たとえば耐熱ポリプロピレンはレンジ対応ですが一般プラスチックは溶融する恐れがあり、金彩付きの皿はレンジで火花を生じます。"
      },
      {
        question: "器具に表示されたメーカーのマークを優先すべきですか？",
        answer: "はい、必ずメーカーの公式表示を最優先してください。本サイトは一般的な素材特性に基づいていますが、製品ごとの個別の注意事項や底面のマーク（電子レンジ対応・食洗機対応など）に従うことが最も安全です。"
      }
    ],
    aboutTitle: "IsItKitchenSafe について",
    aboutDescription: "IsItKitchenSafe は、キッチンでの日常的な疑問をすばやく解決し、家電の故障や破損事故、健康被害を未然に防ぐために作られたリファレンスサイトです。誰にでもわかりやすい正確な情報提供を目指しています。",
    aboutLinkText: "私たちのミッションと編集方針の詳細は「当サイトについて」ページをご覧ください"
  }
};

const editorial = homeEditorialData[lang] || homeEditorialData.en;
const homeFaqs = editorial.faqs;

let metaTitle = "IsItKitchenSafe - Quick Safety Guides for Kitchen Appliances";
let metaDesc = `Search and browse 2,000+ kitchen safety guides. Find out if you can put cookware, containers, or ingredients in the microwave, dishwasher, freezer, and oven.`;

if (lang === 'es') {
  metaTitle = "¿Es Seguro en la Cocina? - Guías de Seguridad para Electrodomésticos";
  metaDesc = "Respuestas rápidas y verificadas para saber si puedes meter recipientes, utensilios y alimentos en el microondas, lavavajillas, horno, freidora de aire y más.";
} else if (lang === 'pt') {
  metaTitle = "É Seguro na Cozinha? - Guias Rápidos de Segurança para Eletrodomésticos";
  metaDesc = "Descubra se você pode colocar utensílios, recipientes e alimentos no micro-ondas, lava-louças, freezer, forno e fritadeira sem óleo.";
} else if (lang === 'zh-cn') {
  metaTitle = "厨房安全速查指南 - 厨房电器安全参考手册 | Is It Kitchen Safe";
  metaDesc = "即时查询 2,000+ 种日常厨具、容器与食材是否能安全放入微波炉、洗碗机、冷冻室及烤箱。";
} else if (lang === 'ja') {
  metaTitle = "キッチン安全チェッカー - 家電ごとの安全性クイック早見表 | Is It Kitchen Safe";
  metaDesc = "2,000以上のキッチン用品、容器、食材が食洗機、電子レンジ、冷凍庫、オーブンで使えるかを即座に判定。";
}
---

<Layout 
  title={metaTitle} 
  description={metaDesc}
  faqs={homeFaqs}
  excludeArticleSchema={true}
  lang={lang}
  availableLocales={['en', 'es', 'pt', 'zh-cn', 'ja']}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://isitkitchensafe.com/#organization",
          "name": "IsItKitchenSafe",
          "url": "https://isitkitchensafe.com",
          "logo": {
            "@type": "ImageObject",
            "url": "https://isitkitchensafe.com/favicon.svg"
          }
        },
        {
          "@type": "WebSite",
          "@id": "https://isitkitchensafe.com/#website",
          "name": t('nav.siteTitle'),
          "url": "https://isitkitchensafe.com",
          "publisher": {
            "@id": "https://isitkitchensafe.com/#organization"
          },
          "potentialAction": {
            "@type": "SearchAction",
            "target": {
              "@type": "EntryPoint",
              "urlTemplate": "https://isitkitchensafe.com/search?q={search_term_string}"
            },
            "query-input": "required name=search_term_string"
          }
        }
      ]
    })} />
  </Fragment>

  <!-- Hero Section -->
  <section class="bg-canvas border-b border-hairline py-[80px] md:py-[96px]">
    <div class="max-w-[800px] mx-auto px-6 text-center flex flex-col items-center">
      <h1 class="text-display-lg md:text-display-xl font-medium tracking-tight text-ink mb-6">
        {t('home.heroTitle')}
      </h1>
      <p class="text-body-md text-muted max-w-[580px] mb-8 leading-relaxed">
        {t('home.heroSubtitle')}
      </p>

      <!-- Static Search Bar -->
      <form 
        id="search-form" 
        class="w-full max-w-[600px] flex flex-col sm:flex-row gap-3"
        data-search-path={lang === 'en' ? '/search-index.json' : `/${lang}/search-index.json`}
        data-lang={lang}
      >
        <div class="relative flex-grow">
          <input 
            type="text" 
            id="search-input" 
            placeholder={t('home.searchPlaceholder')} 
            autocomplete="off"
            aria-label={t('nav.searchAria')}
            role="combobox"
            aria-autocomplete="list"
            aria-expanded="false"
            aria-controls="search-dropdown"
            class="w-full min-h-[44px] h-12 md:h-11 pl-4 pr-10 py-3 bg-canvas text-ink text-[16px] md:text-[14px] border border-hairline rounded-sm focus:outline-none focus:border-info-border"
          />
          <div 
            id="search-dropdown" 
            role="listbox" 
            aria-label="Search suggestions"
            class="hidden absolute top-full left-0 right-0 mt-1 max-h-72 overflow-y-auto bg-canvas border border-hairline rounded-md shadow-lg z-50 py-1 text-left"
          ></div>
          <div id="search-loading" class="hidden absolute right-3.5 top-1/2 -translate-y-1/2 pointer-events-none">
            <svg class="animate-spin h-5 w-5 text-muted" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </div>
        </div>
        <button 
          type="submit" 
          class="h-12 md:h-11 min-h-[44px] px-6 bg-primary hover:bg-primary-active text-on-primary text-[15px] md:text-[14px] font-medium rounded-sm border-none cursor-pointer flex items-center justify-center transition-colors select-none"
        >
          {lang === 'es' ? 'Verificar Seguridad' : lang === 'pt' ? 'Verificar Segurança' : lang === 'zh-cn' ? '安全验证' : lang === 'ja' ? '安全性を確認' : 'Check Safety'}
        </button>
      </form>
      <div id="search-error" class="hidden w-full max-w-[600px] mt-4 text-left p-4 bg-error-bg text-error border border-error/30 rounded-md text-[14px]">
        {t('nav.searchNoResults')} "<span id="search-error-term"></span>".
      </div>
    </div>
  </section>

  <!-- Browse by Appliance -->
  <section id="appliances-section" class="max-w-[1280px] mx-auto px-6 pt-[96px] pb-12">
    <div class="mb-12">
      <h2 class="text-display-md text-ink tracking-tight mb-3">{t('home.exploreAppliances')}</h2>
      <p class="text-body-md text-muted">
        {lang === 'es' ? 'Selecciona un electrodoméstico para explorar todas las reglas de seguridad.' : lang === 'pt' ? 'Selecione um eletrodoméstico para ver todas as regras de segurança.' : lang === 'zh-cn' ? '选择厨房电器，查看完整的安全指南与使用规则。' : lang === 'ja' ? '家電を選択して、安全ルールやガイドを確認できます。' : 'Select an appliance to explore all safety guides and rules.'}
      </p>
    </div>

    <!-- Responsive Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      {appliances.map(app => (
        <a 
          href={getApplianceUrl(app.slug, lang)} 
          class={`${app.bgColor} ${app.textColor} rounded-lg p-8 flex flex-col justify-between min-h-[200px] shadow-sm transition-transform active:scale-[0.98] border border-transparent`}
        >
          <div>
            <span class="text-caption font-semibold tracking-wider uppercase mb-2 block">{app.name} {t('page.guideSuffix')}</span>
            <h3 class="text-title-lg font-medium tracking-tight mb-3 flex items-center justify-between">
              <span>{app.name}</span>
              {lang !== 'en' && !isApplianceTranslatedInLocale(app.slug, lang) && (
                <span class="text-[9px] font-semibold text-muted bg-surface-soft border border-hairline px-1 py-0.5 rounded tracking-wider uppercase" title="Available in English only">EN</span>
              )}
            </h3>
            <p class="text-body-md leading-relaxed mb-6">{app.desc}</p>
          </div>
          <span class="text-[14px] font-medium underline underline-offset-4 flex items-center gap-1">
            {t('home.viewAll')} &rarr;
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- Browse by Safety Category -->
  <section id="materials-section" class="max-w-[1280px] mx-auto px-6 pb-[96px] content-visibility-auto">
    <div class="mb-12 border-t border-hairline pt-[96px]">
      <h2 class="text-display-md text-ink tracking-tight mb-3">{t('home.safetyDirectories')}</h2>
      <p class="text-body-md text-muted">
        {lang === 'es' ? 'Explora directorios de almacenamiento, cuidado de materiales y prevención de accidentes.' : lang === 'pt' ? 'Explore diretórios de conservação, cuidados com materiais e prevenção de acidentes.' : lang === 'zh-cn' ? '查阅保质期、材质安全及事故预防专项指南。' : lang === 'ja' ? '保存期間、素材のお手入れ、事故防止の特別ガイドを確認できます。' : 'Explore shelf life, material cleaning, and prevention guidelines.'}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <a 
        href={getDirectoryUrl('how-long', lang)} 
        class="bg-signature-forest text-white rounded-lg p-8 flex flex-col justify-between min-h-[220px] shadow-sm transition-transform active:scale-[0.98] border border-transparent"
      >
        <div>
          <span class="text-caption text-white/80 font-semibold tracking-wider uppercase mb-2 block">{t('footer.shelfLife')}</span>
          <h3 class="text-title-lg text-white font-medium tracking-tight mb-3 flex items-center justify-between">
            <span>{t('nav.howLong')}</span>
            {lang !== 'en' && !isDirectoryTranslatedInLocale('how-long', lang) && (
              <span class="text-[9px] font-semibold text-muted bg-surface-soft border border-hairline px-1 py-0.5 rounded tracking-wider uppercase" title="Available in English only">EN</span>
            )}
          </h3>
          <p class="text-body-md text-white/90 leading-relaxed mb-6">
            {lang === 'es' ? '¿Cuánto tiempo duran las carnes, sobras y lácteos en la nevera, congelador o despensa?' : lang === 'pt' ? 'Quanto tempo carnes, sobras e laticínios duram na geladeira ou freezer?' : lang === 'zh-cn' ? '肉类、剩菜、乳制品及果蔬在冷藏、冷冻或常温下可存放多久？' : lang === 'ja' ? '生肉、作り置き、乳製品、野菜は冷蔵・冷凍・常温でどのくらい日持ちする？' : 'How long do raw meats, leftovers, dairy, and produce stay safe in the fridge, freezer, or pantry?'}
          </p>
        </div>
        <span class="text-[14px] text-white font-medium underline underline-offset-4 flex items-center gap-1">
          {t('home.viewAll')} &rarr;
        </span>
      </a>

      <a 
        href={getDirectoryUrl('washing-machine', lang)} 
        class="bg-signature-coral text-white rounded-lg p-8 flex flex-col justify-between min-h-[220px] shadow-sm transition-transform active:scale-[0.98] border border-transparent"
      >
        <div>
          <span class="text-caption text-white/80 font-semibold tracking-wider uppercase mb-2 block">{t('footer.washingMachine')}</span>
          <h3 class="text-title-lg text-white font-medium tracking-tight mb-3 flex items-center justify-between">
            <span>{t('nav.washingMachine')}</span>
            {lang !== 'en' && !isDirectoryTranslatedInLocale('washing-machine', lang) && (
              <span class="text-[9px] font-semibold text-muted bg-surface-soft border border-hairline px-1 py-0.5 rounded tracking-wider uppercase" title="Available in English only">EN</span>
            )}
          </h3>
          <p class="text-body-md text-white/90 leading-relaxed mb-6">
            {lang === 'es' ? '¿Se pueden lavar zapatillas, almohadas o prendas delicadas en la lavadora?' : lang === 'pt' ? 'Pode lavar tênis, travesseiros ou roupas delicadas na máquina de lavar?' : lang === 'zh-cn' ? '运动鞋、枕头、羽绒服或易损衣物可以放洗衣机清洗吗？' : lang === 'ja' ? 'スニーカー、枕、羽毛布団、デリケートな衣類は洗濯機で洗える？' : 'Can you wash sneakers, pillows, bedding, or down jackets in the washing machine?'}
          </p>
        </div>
        <span class="text-[14px] text-white font-medium underline underline-offset-4 flex items-center gap-1">
          {t('home.viewAll')} &rarr;
        </span>
      </a>

      <a 
        href={getDirectoryUrl('refreeze', lang)} 
        class="bg-signature-cream text-ink rounded-lg p-8 flex flex-col justify-between min-h-[220px] shadow-sm transition-transform active:scale-[0.98] border border-transparent"
      >
        <div>
          <span class="text-caption font-semibold tracking-wider uppercase mb-2 block">{t('footer.refreeze')}</span>
          <h3 class="text-title-lg font-medium tracking-tight mb-3 flex items-center justify-between">
            <span>{t('nav.refreeze')}</span>
            {lang !== 'en' && !isDirectoryTranslatedInLocale('refreeze', lang) && (
              <span class="text-[9px] font-semibold text-muted bg-surface-soft border border-hairline px-1 py-0.5 rounded tracking-wider uppercase" title="Available in English only">EN</span>
            )}
          </h3>
          <p class="text-body-md leading-relaxed mb-6">
            {lang === 'es' ? '¿Es seguro recongelar pollo, carne o lácteos una vez descongelados?' : lang === 'pt' ? 'É seguro recongelar frango, carne ou leite depois de descongelados?' : lang === 'zh-cn' ? '解冻后的鸡肉、牛肉或乳制品可以再次冷冻吗？获取权威安全准则。' : lang === 'ja' ? '解凍した鶏肉、牛肉、乳製品を再冷凍しても安全？公式安全基準を解説。' : 'Is it safe to refreeze chicken, beef, or dairy once thawed? Get the absolute USDA safety rules.'}
          </p>
        </div>
        <span class="text-[14px] font-medium underline underline-offset-4 flex items-center gap-1 text-ink">
          {t('home.viewAll')} &rarr;
        </span>
      </a>

      <a 
        href={getDirectoryUrl('what-happens', lang)} 
        class="bg-surface-dark text-on-dark rounded-lg p-8 flex flex-col justify-between min-h-[220px] shadow-sm transition-transform active:scale-[0.98] border border-transparent"
      >
        <div>
          <span class="text-caption font-semibold tracking-wider uppercase mb-2 block">{t('footer.emergencyScenarios')}</span>
          <h3 class="text-title-lg font-medium tracking-tight mb-3 flex items-center justify-between">
            <span>{t('nav.whatHappens')}</span>
            {lang !== 'en' && !isDirectoryTranslatedInLocale('what-happens', lang) && (
              <span class="text-[9px] font-semibold text-muted bg-surface-soft border border-hairline px-1 py-0.5 rounded tracking-wider uppercase" title="Available in English only">EN</span>
            )}
          </h3>
          <p class="text-body-md leading-relaxed mb-6">
            {lang === 'es' ? 'Descubre los riesgos y consecuencias de meter metal al microondas o dejar el horno encendido.' : lang === 'pt' ? 'Descubra os riscos e consequências de colocar metal no micro-ondas ou esquecer o forno ligado.' : lang === 'zh-cn' ? '了解微波加热铝箔纸、烤箱未关或误加热容器的危险等级与后果。' : lang === 'ja' ? 'アルミホイルのレンジ加熱やオーブンの消し忘れなど、危険性と影響を解説。' : 'Explore the danger levels and physical results of microwaving foil, leaving ovens on, or mixing chemicals.'}
          </p>
        </div>
        <span class="text-[14px] font-medium underline underline-offset-4 flex items-center gap-1 text-white">
          {t('home.viewAll')} &rarr;
        </span>
      </a>

      <a 
        href={getDirectoryUrl('compare', lang)} 
        class="bg-signature-yellow text-ink rounded-lg p-8 flex flex-col justify-between min-h-[220px] shadow-sm transition-transform active:scale-[0.98] border border-transparent"
      >
        <div>
          <span class="text-caption font-semibold tracking-wider uppercase mb-2 block">{t('footer.compare')}</span>
          <h3 class="text-title-lg font-medium tracking-tight mb-3 flex items-center justify-between">
            <span>{t('nav.compare')}</span>
            {lang !== 'en' && !isDirectoryTranslatedInLocale('compare', lang) && (
              <span class="text-[9px] font-semibold text-muted bg-surface-soft border border-hairline px-1 py-0.5 rounded tracking-wider uppercase" title="Available in English only">EN</span>
            )}
          </h3>
          <p class="text-body-md leading-relaxed mb-6">
            {lang === 'es' ? 'Comparativas directas de seguridad (aluminio vs papel vegetal, hierro fundido vs acero).' : lang === 'pt' ? 'Comparações diretas de segurança (papel alumínio vs papel manteiga, ferro vs inox).' : lang === 'zh-cn' ? '厨房常见材质与用品安全性横向对比（如铝箔纸 vs 烘焙纸、铸铁 vs 不锈钢）。' : lang === 'ja' ? 'アルミホイル対クッキングシート、鉄フライパン対ステンレスなど安全性を徹底比較。' : 'Side-by-side kitchen safety reviews (e.g. foil vs parchment paper, cast iron vs stainless steel).'}
          </p>
        </div>
        <span class="text-[14px] font-medium underline underline-offset-4 flex items-center gap-1 text-ink">
          {t('home.viewAll')} &rarr;
        </span>
      </a>

      <a 
        href={getDirectoryUrl('material', lang)} 
        class="bg-signature-mint text-ink rounded-lg p-8 flex flex-col justify-between min-h-[220px] shadow-sm transition-transform active:scale-[0.98] border border-transparent"
      >
        <div>
          <span class="text-caption font-semibold tracking-wider uppercase mb-2 block">{t('footer.materialHubs')}</span>
          <h3 class="text-title-lg font-medium tracking-tight mb-3 flex items-center justify-between">
            <span>{t('nav.material')}</span>
            {lang !== 'en' && !isDirectoryTranslatedInLocale('material', lang) && (
              <span class="text-[9px] font-semibold text-muted bg-surface-soft border border-hairline px-1 py-0.5 rounded tracking-wider uppercase" title="Available in English only">EN</span>
            )}
          </h3>
          <p class="text-body-md leading-relaxed mb-6">
            {lang === 'es' ? 'Guías completas de seguridad para metales, plásticos, vidrios, cerámicas y silicona.' : lang === 'pt' ? 'Guias completos de segurança para metais, plásticos, vidros, cerâmica e silicone.' : lang === 'zh-cn' ? '金属、塑料、玻璃、陶瓷及硅胶材质的深度安全指南。' : lang === 'ja' ? '金属、プラスチック、耐熱ガラス、陶器、シリコンの安全性を徹底解説。' : 'Deep dives and guides examining metals, polymers, glass, ceramic, and silicone safety.'}
          </p>
        </div>
        <span class="text-[14px] font-medium underline underline-offset-4 flex items-center gap-1 text-ink">
          {t('home.viewAll')} &rarr;
        </span>
      </a>
    </div>
  </section>

  <!-- Showcase Guides -->
  {popularItems.length > 0 && (
    <section id="recent-guides" class="bg-surface-soft border-t border-b border-hairline py-[96px] content-visibility-auto">
      <div class="max-w-[1280px] mx-auto px-6">
        <div class="mb-12 text-center md:text-left">
          <h2 class="text-display-md text-ink tracking-tight mb-3">
            {lang === 'es' ? 'Guías Destacadas de Seguridad' : lang === 'pt' ? 'Guias em Destaque de Segurança' : lang === 'zh-cn' ? '热门厨房安全疑问' : lang === 'ja' ? 'よく検索される質問' : 'Frequently Searched Questions'}
          </h2>
          <p class="text-body-md text-muted">
            {lang === 'es' ? 'Respuestas inmediatas a dudas cotidianas en la cocina.' : lang === 'pt' ? 'Respostas rápidas para dúvidas comuns na cozinha.' : lang === 'zh-cn' ? '快速解答日常厨房中最常见的安全困惑。' : lang === 'ja' ? 'キッチンでよくある疑問や悩みにすぐにお答えします。' : 'Get immediate answers to some of the most common kitchen safety dilemmas.'}
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {popularItems.map((item: any) => (
            <div class="bg-canvas border border-hairline rounded-md p-6 flex flex-col justify-between shadow-xs transition-shadow">
              <div>
                <div class="flex items-center justify-between mb-4">
                  <span class="text-caption text-muted uppercase tracking-wider text-xs">{formatAppliance(item.appliance)}</span>
                  {item.safe === 'yes' && <span class="badge-yes">{t('verdict.yes')}</span>}
                  {item.safe === 'no' && <span class="badge-no">{t('verdict.no')}</span>}
                  {item.safe === 'depends' && <span class="badge-depends">{t('verdict.depends')}</span>}
                </div>
                <h3 class="text-title-sm text-ink mb-3">
                  {t('page.canYouPut')} {item.item} {getApplianceIn(item.appliance, lang)}?
                </h3>
                <p class="text-body-md text-body leading-relaxed mb-6">
                  {item.shortAnswer}
                </p>
              </div>
              <a 
                href={translatePath(`/${item.appliance}/${item.slug}/`)} 
                class="text-link text-[14px] font-medium hover:text-link-active transition-colors min-h-[44px] inline-flex items-center gap-1 group -ml-1 px-1"
              >
                {t('page.readDetailedBreakdown')} <span class="group-hover:translate-x-0.5 transition-transform">&rarr;</span>
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Editorial Sections: Methodology, FAQ, and About Us -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-14 border-t border-hairline/60">
    <!-- Methodology Section -->
    <div class="mb-14">
      <div class="flex items-center gap-2 mb-3">
        <span class="inline-flex items-center justify-center bg-signature-forest/10 text-signature-forest w-6 h-6 rounded-full font-bold text-xs">✓</span>
        <span class="text-xs uppercase tracking-wider text-muted font-semibold">{editorial.methodologyBadge}</span>
      </div>
      <h2 class="text-title-lg text-ink font-semibold tracking-tight mb-6">
        {editorial.methodologyTitle}
      </h2>
      <div class="text-body-md text-body leading-relaxed space-y-4">
        {editorial.methodologyParagraphs.map((paragraph: string) => (
          <p>{paragraph}</p>
        ))}
      </div>
    </div>

    <!-- 4-Item FAQ Section -->
    <div class="mb-14 border-t border-hairline/60 pt-10">
      <h2 class="text-title-lg text-ink font-semibold tracking-tight mb-6">
        {editorial.faqTitle}
      </h2>
      <div class="flex flex-col">
        {homeFaqs.map((faq: { question: string; answer: string }) => (
          <details class="group border-b border-hairline py-4">
            <summary class="flex items-center justify-between text-title-sm text-ink font-medium cursor-pointer list-none [&::-webkit-details-marker]:hidden select-none">
              <span>{faq.question}</span>
              <span class="text-muted group-open:rotate-180 transition-transform duration-200">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </summary>
            <div class="mt-3 text-body-md text-body leading-relaxed pl-1">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
    </div>

    <!-- About Us Blurb -->
    <div class="border-t border-hairline/60 pt-10">
      <div class="bg-surface-soft border border-hairline rounded-lg p-6 sm:p-8">
        <h2 class="text-title-md text-ink font-semibold mb-3">
          {editorial.aboutTitle}
        </h2>
        <p class="text-body-md text-body leading-relaxed mb-4">
          {editorial.aboutDescription}
        </p>
        <a 
          href={getDirectoryUrl('about', lang)} 
          class="text-link text-body-md font-medium hover:text-link-active transition-colors inline-flex items-center gap-1 group"
        >
          {editorial.aboutLinkText} <span class="group-hover:translate-x-0.5 transition-transform">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const searchForm = document.getElementById('search-form') as HTMLFormElement | null;
      const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
      const dropdown = document.getElementById('search-dropdown');
      const searchLoading = document.getElementById('search-loading');
      const searchPath = searchForm?.dataset.searchPath || '/search-index.json';
      const searchError = document.getElementById('search-error');
      const searchErrorTerm = document.getElementById('search-error-term');
      
      let searchIndex: Array<{ name: string; appliance: string; url: string; keywords: string }> | null = null;
      let isFetching = false;
      let activeIndex = -1;
      let currentMatches: Array<{ name: string; appliance: string; url: string; keywords: string }> = [];

      const closeDropdown = () => {
        if (!dropdown) return;
        dropdown.classList.add('hidden');
        dropdown.innerHTML = '';
        searchInput?.setAttribute('aria-expanded', 'false');
        searchInput?.removeAttribute('aria-activedescendant');
        activeIndex = -1;
        currentMatches = [];
      };

      const renderDropdown = (matches: typeof currentMatches) => {
        currentMatches = matches;
        activeIndex = -1;
        if (!dropdown) return;
        if (!matches || matches.length === 0) {
          closeDropdown();
          return;
        }
        dropdown.innerHTML = matches.map((entry, idx) => `
          <div 
            role="option" 
            id="hero-search-opt-${idx}" 
            data-index="${idx}" 
            data-url="${entry.url}" 
            aria-selected="false" 
            class="hero-search-option px-4 py-2.5 text-[14px] text-ink hover:bg-surface-soft cursor-pointer flex items-center justify-between transition-colors"
          >
            <span class="font-medium text-ink truncate">${entry.name}</span>
            <span class="text-[12px] text-muted ml-2 shrink-0 capitalize">${entry.appliance}</span>
          </div>
        `).join('');
        dropdown.classList.remove('hidden');
        searchInput?.setAttribute('aria-expanded', 'true');
      };

      const updateActiveOption = (newIndex: number) => {
        if (!dropdown) return;
        const options = dropdown.querySelectorAll<HTMLElement>('.hero-search-option');
        if (options.length === 0) return;
        if (activeIndex >= 0 && options[activeIndex]) {
          options[activeIndex].classList.remove('bg-surface-soft');
          options[activeIndex].setAttribute('aria-selected', 'false');
        }
        activeIndex = newIndex;
        if (activeIndex >= 0 && options[activeIndex]) {
          options[activeIndex].classList.add('bg-surface-soft');
          options[activeIndex].setAttribute('aria-selected', 'true');
          searchInput?.setAttribute('aria-activedescendant', options[activeIndex].id);
          options[activeIndex].scrollIntoView({ block: 'nearest' });
        } else {
          searchInput?.removeAttribute('aria-activedescendant');
        }
      };

      const loadSearchIndex = async (): Promise<boolean> => {
        if (searchIndex) return true;
        if (isFetching) return false;
        
        isFetching = true;
        if (searchLoading) searchLoading.classList.remove('hidden');
        if (searchError) searchError.classList.add('hidden');
        
        try {
          const response = await fetch(searchPath);
          if (response.ok) {
            const rawIndex = await response.json();
            searchIndex = rawIndex.map((entry: any) => ({
              name: entry.name,
              appliance: entry.category,
              url: entry.url,
              keywords: entry.keywords || ''
            }));
            const q = searchInput?.value.trim().toLowerCase();
            if (q && searchIndex) {
              const matches = searchIndex.filter(entry => {
                const name = entry.name.toLowerCase();
                const cat = entry.appliance.toLowerCase();
                const kw = entry.keywords.toLowerCase();
                return name.includes(q) || cat.includes(q) || kw.includes(q);
              }).slice(0, 8);
              renderDropdown(matches);
            }
            return true;
          }
        } catch (e) {
          console.error("Failed to load search index", e);
        } finally {
          isFetching = false;
          if (searchLoading) searchLoading.classList.add('hidden');
        }
        return false;
      };

      const performSearch = (query: string) => {
        if (!query || query.trim() === '' || !searchIndex) return;
        
        const rawValue = query.toLowerCase().trim();
        if (searchError) searchError.classList.add('hidden');
        closeDropdown();
        
        let match = searchIndex.find(item => item.name.toLowerCase() === rawValue);

        if (!match) {
          match = searchIndex.find(item => {
            const displayVal = `${item.name} (${item.appliance})`.toLowerCase();
            return displayVal === rawValue;
          });
        }

        if (!match) {
          match = searchIndex.find(item => item.name.toLowerCase().includes(rawValue));
        }
        
        if (!match) {
          match = searchIndex.find(item => item.keywords && item.keywords.includes(rawValue));
        }

        if (match) {
          window.location.href = match.url;
        } else {
          if (searchError && searchErrorTerm) {
            searchErrorTerm.textContent = query;
            searchError.classList.remove('hidden');
          }
        }
      };

      const params = new URLSearchParams(window.location.search);
      const q = params.get('q');
      if (q && q.trim() !== '') {
        loadSearchIndex().then((loaded) => {
          if (loaded && searchInput) {
            searchInput.value = q;
            performSearch(q);
          }
        });
      }

      if (searchInput) {
        searchInput.addEventListener('focus', () => {
          loadSearchIndex();
        });
        
        searchInput.addEventListener('input', () => {
          loadSearchIndex();
          if (searchError) searchError.classList.add('hidden');
          const query = searchInput.value.trim().toLowerCase();
          if (!query || !searchIndex) {
            closeDropdown();
            return;
          }
          const matches = searchIndex.filter(entry => {
            const name = entry.name.toLowerCase();
            const cat = entry.appliance.toLowerCase();
            const kw = entry.keywords.toLowerCase();
            return name.includes(query) || cat.includes(query) || kw.includes(query);
          }).slice(0, 8);
          renderDropdown(matches);
        });

        searchInput.addEventListener('keydown', (e) => {
          if (!dropdown || dropdown.classList.contains('hidden') || currentMatches.length === 0) {
            return;
          }
          if (e.key === 'ArrowDown') {
            e.preventDefault();
            const nextIndex = (activeIndex + 1) % currentMatches.length;
            updateActiveOption(nextIndex);
          } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            const prevIndex = activeIndex <= 0 ? currentMatches.length - 1 : activeIndex - 1;
            updateActiveOption(prevIndex);
          } else if (e.key === 'Enter') {
            if (activeIndex >= 0 && currentMatches[activeIndex]) {
              e.preventDefault();
              closeDropdown();
              window.location.href = currentMatches[activeIndex].url;
            }
          } else if (e.key === 'Escape') {
            closeDropdown();
          }
        });
      }

      if (dropdown) {
        dropdown.addEventListener('click', (e) => {
          const opt = (e.target as HTMLElement).closest('.hero-search-option') as HTMLElement | null;
          if (opt && opt.dataset.url) {
            closeDropdown();
            window.location.href = opt.dataset.url;
          }
        });
      }

      document.addEventListener('click', (e) => {
        if (searchForm && !searchForm.contains(e.target as Node)) {
          closeDropdown();
        }
      });

      if (searchForm && searchInput) {
        searchForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          const query = searchInput.value;
          if (!query) return;
          
          if (!searchIndex) {
            await loadSearchIndex();
          }
          performSearch(query);
        });
      }
    });
  </script>
</Layout>
