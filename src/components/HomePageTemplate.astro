interface MatrixApplianceEntry {
  safe: 'yes' | 'no' | 'depends';
  url: string;
}

interface MatrixItemGroup {
  slug: string;
  label: string;
  search: string;
  count: number;
  appliances: Partial<Record<MatrixAppliance, MatrixApplianceEntry>>;
}

function cleanMatrixLabel(names: string[]): string {
  const cleaned = Array.from(
    new Set(
      names
        .map((n) => {
          const trimmed = (n || '').trim();
          const stripped = trimmed.replace(/\s*[（(][^）)]*[）)]\s*$/, '').trim();
          return stripped.length >= 2 ? stripped : trimmed;
        })
        .filter(Boolean)
    )
  );
  if (cleaned.length === 0) return '';
  cleaned.sort((a, b) => a.length - b.length);
  return cleaned[0];
}

const matrixApplianceSet = new Set<string>(MATRIX_APPLIANCES);
const groupedMatrixMap = new Map<string, { names: string[]; appliances: Partial<Record<MatrixAppliance, MatrixApplianceEntry>> }>();

for (const row of currentItemsDataset as any[]) {
  if (!row || !row.slug || !row.appliance || !matrixApplianceSet.has(row.appliance)) continue;
  const app = row.appliance as MatrixAppliance;
  const safeVal: 'yes' | 'no' | 'depends' = row.safe === 'yes' || row.safe === 'no' || row.safe === 'depends' ? row.safe : 'depends';
  let bucket = groupedMatrixMap.get(row.slug);
  if (!bucket) {
    bucket = { names: [], appliances: {} };
    groupedMatrixMap.set(row.slug, bucket);
  }
  if (row.item) bucket.names.push(String(row.item));
  if (!bucket.appliances[app]) {
    const baseAppUrl = getApplianceUrl(app, lang);
    const normalizedBase = baseAppUrl.endsWith('/') ? baseAppUrl : `${baseAppUrl}/`;
    bucket.appliances[app] = {
      safe: safeVal,
      url: `${normalizedBase}${row.slug}/`
    };
  }
}

const curatedMatrixRank = new Map<string, number>(CURATED_MATRIX_SLUGS.map((s, idx) => [s, idx]));
const eligibleMatrixItems: MatrixItemGroup[] = [];

for (const [slug, bucket] of groupedMatrixMap.entries()) {
  const count = Object.keys(bucket.appliances).length;
  if (count < 3) continue;
  const label = cleanMatrixLabel(bucket.names) || slug;
  const search = [slug.replace(/-/g, ' '), label, ...bucket.names].join(' ').toLowerCase();
  eligibleMatrixItems.push({
    slug,
    label,
    search,
    count,
    appliances: bucket.appliances
  });
}

eligibleMatrixItems.sort((a, b) => {
  const aRank = curatedMatrixRank.has(a.slug) ? curatedMatrixRank.get(a.slug)! : 9999;
  const bRank = curatedMatrixRank.has(b.slug) ? curatedMatrixRank.get(b.slug)! : 9999;
  if (aRank !== bRank) return aRank - bRank;
  if (b.count !== a.count) return b.count - a.count;
  return a.label.localeCompare(b.label);
});

const matrixItems = eligibleMatrixItems.slice(0, 32);
