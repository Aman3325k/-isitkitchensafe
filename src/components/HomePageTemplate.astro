            <summary class="flex items-center justify-between text-title-sm text-ink font-medium cursor-pointer list-none [&::-webkit-details-marker]:hidden select-none">
              <span>{faq.question}</span>
              <span class="text-muted group-open:rotate-180 transition-transform duration-200">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </summary>
            <div class="mt-3 text-body-md text-body leading-relaxed pl-1">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
    </div>

    <!-- About Us Blurb -->
    <div class="border-t border-hairline/60 pt-10">
      <div class="bg-surface-soft border border-hairline rounded-lg p-6 sm:p-8">
        <h2 class="text-title-md text-ink font-semibold mb-3">
          {editorial.aboutTitle}
        </h2>
        <p class="text-body-md text-body leading-relaxed mb-4">
          {editorial.aboutDescription}
        </p>
        <a 
          href={getDirectoryUrl('about', lang)} 
          class="text-link text-body-md font-medium hover:text-link-active transition-colors inline-flex items-center gap-1 group"
        >
          {editorial.aboutLinkText} <span class="group-hover:translate-x-0.5 transition-transform">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const searchForm = document.getElementById('search-form') as HTMLFormElement | null;
      const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
      const dropdown = document.getElementById('search-dropdown');
      const searchLoading = document.getElementById('search-loading');
      const searchPath = searchForm?.dataset.searchPath || '/search-index.json';
      const searchError = document.getElementById('search-error');
      const searchErrorTerm = document.getElementById('search-error-term');
      
      let searchIndex: Array<{ name: string; appliance: string; url: string; keywords: string }> | null = null;
      let isFetching = false;
      let activeIndex = -1;
      let currentMatches: Array<{ name: string; appliance: string; url: string; keywords: string }> = [];

      const closeDropdown = () => {
        if (!dropdown) return;
        dropdown.classList.add('hidden');
        dropdown.innerHTML = '';
        searchInput?.setAttribute('aria-expanded', 'false');
        searchInput?.removeAttribute('aria-activedescendant');
        activeIndex = -1;
        currentMatches = [];
      };

      const renderDropdown = (matches: typeof currentMatches) => {
        currentMatches = matches;
        activeIndex = -1;
        if (!dropdown) return;
        if (!matches || matches.length === 0) {
          closeDropdown();
          return;
        }
        dropdown.innerHTML = matches.map((entry, idx) => `
          <div 
            role="option" 
            id="hero-search-opt-${idx}" 
            data-index="${idx}" 
            data-url="${entry.url}" 
            aria-selected="false" 
            class="hero-search-option px-4 py-2.5 text-[14px] text-ink hover:bg-surface-soft cursor-pointer flex items-center justify-between transition-colors"
          >
            <span class="font-medium text-ink truncate">${entry.name}</span>
            <span class="text-[12px] text-muted ml-2 shrink-0 capitalize">${entry.appliance}</span>
          </div>
        `).join('');
        dropdown.classList.remove('hidden');
        searchInput?.setAttribute('aria-expanded', 'true');
      };

      const updateActiveOption = (newIndex: number) => {
        if (!dropdown) return;
        const options = dropdown.querySelectorAll<HTMLElement>('.hero-search-option');
        if (options.length === 0) return;
        if (activeIndex >= 0 && options[activeIndex]) {
          options[activeIndex].classList.remove('bg-surface-soft');
          options[activeIndex].setAttribute('aria-selected', 'false');
        }
        activeIndex = newIndex;
        if (activeIndex >= 0 && options[activeIndex]) {
          options[activeIndex].classList.add('bg-surface-soft');
          options[activeIndex].setAttribute('aria-selected', 'true');
          searchInput?.setAttribute('aria-activedescendant', options[activeIndex].id);
          options[activeIndex].scrollIntoView({ block: 'nearest' });
        } else {
          searchInput?.removeAttribute('aria-activedescendant');
        }
      };

      const loadSearchIndex = async (): Promise<boolean> => {
        if (searchIndex) return true;
        if (isFetching) return false;
        
        isFetching = true;
        if (searchLoading) searchLoading.classList.remove('hidden');
        if (searchError) searchError.classList.add('hidden');
        
        try {
          const response = await fetch(searchPath);
          if (response.ok) {
            const rawIndex = await response.json();
            searchIndex = rawIndex.map((entry: any) => ({
              name: entry.name,
              appliance: entry.category,
              url: entry.url,
              keywords: entry.keywords || ''
            }));
            const q = searchInput?.value.trim().toLowerCase();
            if (q && searchIndex) {
              const matches = searchIndex.filter(entry => {
                const name = entry.name.toLowerCase();
                const cat = entry.appliance.toLowerCase();
                const kw = entry.keywords.toLowerCase();
                return name.includes(q) || cat.includes(q) || kw.includes(q);
              }).slice(0, 8);
              renderDropdown(matches);
            }
            return true;
          }
        } catch (e) {
          console.error("Failed to load search index", e);
        } finally {
          isFetching = false;
          if (searchLoading) searchLoading.classList.add('hidden');
        }
        return false;
      };

      const performSearch = (query: string) => {
        if (!query || query.trim() === '' || !searchIndex) return;
        
        const rawValue = query.toLowerCase().trim();
        if (searchError) searchError.classList.add('hidden');
        closeDropdown();
        
        let match = searchIndex.find(item => item.name.toLowerCase() === rawValue);

        if (!match) {
          match = searchIndex.find(item => {
            const displayVal = `${item.name} (${item.appliance})`.toLowerCase();
            return displayVal === rawValue;
          });
        }

        if (!match) {
          match = searchIndex.find(item => item.name.toLowerCase().includes(rawValue));
        }
        
        if (!match) {
          match = searchIndex.find(item => item.keywords && item.keywords.includes(rawValue));
        }

        if (match) {
          window.location.href = match.url;
        } else {
          if (searchError && searchErrorTerm) {
            searchErrorTerm.textContent = query;
            searchError.classList.remove('hidden');
          }
        }
      };

      const params = new URLSearchParams(window.location.search);
      const q = params.get('q');
      if (q && q.trim() !== '') {
        loadSearchIndex().then((loaded) => {
          if (loaded && searchInput) {
            searchInput.value = q;
            performSearch(q);
          }
        });
      }

      if (searchInput) {
        searchInput.addEventListener('focus', () => {
          loadSearchIndex();
        });
        
        searchInput.addEventListener('input', () => {
          loadSearchIndex();
          if (searchError) searchError.classList.add('hidden');
          const query = searchInput.value.trim().toLowerCase();
          if (!query || !searchIndex) {
            closeDropdown();
            return;
          }
          const matches = searchIndex.filter(entry => {
            const name = entry.name.toLowerCase();
            const cat = entry.appliance.toLowerCase();
            const kw = entry.keywords.toLowerCase();
            return name.includes(query) || cat.includes(query) || kw.includes(query);
          }).slice(0, 8);
          renderDropdown(matches);
        });

        searchInput.addEventListener('keydown', (e) => {
          if (!dropdown || dropdown.classList.contains('hidden') || currentMatches.length === 0) {
            return;
          }
          if (e.key === 'ArrowDown') {
            e.preventDefault();
            const nextIndex = (activeIndex + 1) % currentMatches.length;
            updateActiveOption(nextIndex);
          } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            const prevIndex = activeIndex <= 0 ? currentMatches.length - 1 : activeIndex - 1;
            updateActiveOption(prevIndex);
          } else if (e.key === 'Enter') {
            if (activeIndex >= 0 && currentMatches[activeIndex]) {
              e.preventDefault();
              closeDropdown();
              window.location.href = currentMatches[activeIndex].url;
            }
          } else if (e.key === 'Escape') {
            closeDropdown();
          }
        });
      }

      if (dropdown) {
        dropdown.addEventListener('click', (e) => {
          const opt = (e.target as HTMLElement).closest('.hero-search-option') as HTMLElement | null;
          if (opt && opt.dataset.url) {
            closeDropdown();
            window.location.href = opt.dataset.url;
          }
        });
      }

      document.addEventListener('click', (e) => {
        if (searchForm && !searchForm.contains(e.target as Node)) {
          closeDropdown();
        }
      });

      if (searchForm && searchInput) {
        searchForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          const query = searchInput.value;
          if (!query) return;
          
          if (!searchIndex) {
            await loadSearchIndex();
          }
          performSearch(query);
        });
      }

      // ======================================================================
      // Interactive 7-Appliance Safety Matrix Lookup
      // ======================================================================
      const matrixDataEl = document.getElementById('home-matrix-data');
      const matrixSearch = document.getElementById('home-matrix-search') as HTMLInputElement | null;
      const matrixClear = document.getElementById('home-matrix-clear') as HTMLButtonElement | null;
      const matrixDropdown = document.getElementById('home-matrix-dropdown');
      const matrixSearchWrap = document.getElementById('home-matrix-search-wrap');
      const matrixSection = document.getElementById('home-matrix-section');
      const matrixGrid = document.getElementById('home-matrix-grid');
      const matrixActiveName = document.getElementById('home-matrix-active-name');
      const matrixActiveCount = document.getElementById('home-matrix-active-count');
      const matrixToggleAll = document.getElementById('home-matrix-toggle-all') as HTMLButtonElement | null;
      const matrixAllChips = document.getElementById('home-matrix-all-chips');

      if (matrixDataEl && matrixGrid) {
        type MatrixSafe = 'yes' | 'no' | 'depends';
        interface ClientMatrixItem {
          slug: string;
          label: string;
          search: string;
          count: number;
          appliances: Record<string, { safe: MatrixSafe; url: string } | undefined>;
        }
        interface ClientMatrixPayload {
          appliances: Array<{ slug: string; name: string }>;
          items: ClientMatrixItem[];
          labels: {
            yes: string;
            no: string;
            depends: string;
            na: string;
            naSubtext: string;
            readGuide: string;
            guidesSuffix: string;
            noMatches: string;
          };
        }

        let payload: ClientMatrixPayload | null = null;
        try {
          payload = JSON.parse(matrixDataEl.textContent || 'null');
        } catch (err) {
          console.error('Failed to parse matrix payload', err);
        }

        if (payload && payload.items.length > 0) {
          const itemBySlug = new Map<string, ClientMatrixItem>(
            payload.items.map((it) => [it.slug, it])
          );
          let matrixMatches: ClientMatrixItem[] = [];
          let matrixOptionIndex = -1;

          const closeMatrixDropdown = () => {
            if (!matrixDropdown) return;
            matrixDropdown.classList.add('hidden');
            matrixDropdown.replaceChildren();
            matrixSearch?.setAttribute('aria-expanded', 'false');
            matrixSearch?.removeAttribute('aria-activedescendant');
            matrixMatches = [];
            matrixOptionIndex = -1;
          };

          const updateMatrixChips = (selectedSlug: string) => {
            if (!matrixSection) return;
            const chips = matrixSection.querySelectorAll<HTMLButtonElement>('.matrix-chip');
            chips.forEach((chip) => {
              const isSelected = chip.dataset.matrixSlug === selectedSlug;
              chip.setAttribute('aria-pressed', isSelected ? 'true' : 'false');
              if (isSelected) {
                chip.classList.remove('bg-surface-soft', 'text-ink', 'border-hairline', 'hover:border-border-strong');
                chip.classList.add('bg-primary', 'text-on-primary', 'border-primary');
              } else {
                chip.classList.remove('bg-primary', 'text-on-primary', 'border-primary');
                chip.classList.add('bg-surface-soft', 'text-ink', 'border-hairline', 'hover:border-border-strong');
              }
            });
          };

          const renderMatrixRow = (item: ClientMatrixItem) => {
            if (!payload || !matrixGrid) return;
            if (matrixActiveName) matrixActiveName.textContent = item.label;
            if (matrixActiveCount) {
              matrixActiveCount.textContent = `${item.count}/7 ${payload.labels.guidesSuffix}`;
            }
            updateMatrixChips(item.slug);

            const fragment = document.createDocumentFragment();
            for (const app of payload.appliances) {
              const entry = item.appliances[app.slug];
              if (entry) {
                const card = document.createElement('a');
                card.href = entry.url;
                const toneClass =
                  entry.safe === 'yes'
                    ? 'border-success/35 bg-success/5 hover:border-success'
                    : entry.safe === 'no'
                    ? 'border-error/35 bg-error/5 hover:border-error'
                    : 'border-warning/40 bg-warning/5 hover:border-warning';
                card.className = `group rounded-md p-3.5 border transition-all flex flex-col items-center justify-between text-center min-h-[120px] shadow-2xs hover:shadow-sm ${toneClass}`;

                const appNameEl = document.createElement('span');
                appNameEl.className = 'text-[13px] font-semibold text-ink leading-tight';
                appNameEl.textContent = app.name;

                const badgeEl = document.createElement('span');
                const badgeTone =
                  entry.safe === 'yes'
                    ? 'badge-yes'
                    : entry.safe === 'no'
                    ? 'badge-no'
                    : 'badge-depends';
                badgeEl.className = `${badgeTone} my-2 text-[11px] px-3 py-1`;
                badgeEl.textContent =
                  entry.safe === 'yes'
                    ? payload.labels.yes
                    : entry.safe === 'no'
                    ? payload.labels.no
                    : payload.labels.depends;

                const ctaEl = document.createElement('span');
                ctaEl.className = 'text-[12px] font-medium text-link group-hover:underline inline-flex items-center gap-0.5';
                ctaEl.textContent = `${payload.labels.readGuide} →`;

                card.appendChild(appNameEl);
                card.appendChild(badgeEl);
                card.appendChild(ctaEl);
                fragment.appendChild(card);
              } else {
                const card = document.createElement('div');
                card.className = 'rounded-md p-3.5 border border-dashed border-hairline bg-surface-soft/70 flex flex-col items-center justify-between text-center min-h-[120px] opacity-75';

                const appNameEl = document.createElement('span');
                appNameEl.className = 'text-[13px] font-medium text-muted leading-tight';
                appNameEl.textContent = app.name;

                const naBadgeEl = document.createElement('span');
                naBadgeEl.className = 'my-2 inline-flex items-center justify-center font-semibold px-3 py-1 rounded-full text-[11px] tracking-wider uppercase bg-surface-strong/70 text-muted border border-hairline';
                naBadgeEl.textContent = payload.labels.na;

                const naSubEl = document.createElement('span');
                naSubEl.className = 'text-[11px] text-muted';
                naSubEl.textContent = payload.labels.naSubtext;

                card.appendChild(appNameEl);
                card.appendChild(naBadgeEl);
                card.appendChild(naSubEl);
                fragment.appendChild(card);
              }
            }

            matrixGrid.replaceChildren(fragment);
          };

          const selectMatrixItem = (item: ClientMatrixItem, syncInput: boolean) => {
            renderMatrixRow(item);
            closeMatrixDropdown();
            if (syncInput && matrixSearch) {
              matrixSearch.value = item.label;
              if (matrixClear) matrixClear.classList.remove('hidden');
            }
          };

          const updateMatrixOptionHighlight = (newIdx: number) => {
            if (!matrixDropdown) return;
            const opts = matrixDropdown.querySelectorAll<HTMLButtonElement>('.matrix-search-opt');
            if (opts.length === 0) return;
            if (matrixOptionIndex >= 0 && opts[matrixOptionIndex]) {
              opts[matrixOptionIndex].classList.remove('bg-surface-soft');
              opts[matrixOptionIndex].setAttribute('aria-selected', 'false');
            }
            matrixOptionIndex = newIdx;
            if (matrixOptionIndex >= 0 && opts[matrixOptionIndex]) {
              opts[matrixOptionIndex].classList.add('bg-surface-soft');
              opts[matrixOptionIndex].setAttribute('aria-selected', 'true');
              matrixSearch?.setAttribute('aria-activedescendant', opts[matrixOptionIndex].id);
              opts[matrixOptionIndex].scrollIntoView({ block: 'nearest' });
            } else {
              matrixSearch?.removeAttribute('aria-activedescendant');
            }
          };

          const renderMatrixDropdown = (query: string) => {
            if (!payload || !matrixDropdown) return;
            const norm = query.trim().toLowerCase();
            matrixMatches = (norm
              ? payload.items.filter((it) => it.search.includes(norm))
              : payload.items
            ).slice(0, 10);
            matrixOptionIndex = -1;

            const frag = document.createDocumentFragment();
            if (matrixMatches.length === 0) {
              const emptyEl = document.createElement('div');
              emptyEl.className = 'px-4 py-3 text-[13px] text-muted';
              emptyEl.textContent = payload.labels.noMatches;
              frag.appendChild(emptyEl);
            } else {
              matrixMatches.forEach((item, idx) => {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.id = `home-matrix-opt-${idx}`;
                btn.setAttribute('role', 'option');
                btn.setAttribute('aria-selected', 'false');
                btn.dataset.matrixSlug = item.slug;
                btn.className = 'matrix-search-opt w-full px-4 py-2.5 text-left text-[14px] text-ink hover:bg-surface-soft cursor-pointer flex items-center justify-between gap-2 transition-colors';

                const labelSpan = document.createElement('span');
                labelSpan.className = 'font-medium text-ink truncate';
                labelSpan.textContent = item.label;

                const metaSpan = document.createElement('span');
                metaSpan.className = 'text-[12px] text-muted shrink-0';
                metaSpan.textContent = `${item.count}/7`;

                btn.appendChild(labelSpan);
                btn.appendChild(metaSpan);
                btn.addEventListener('click', () => selectMatrixItem(item, true));
                frag.appendChild(btn);
              });
            }

            matrixDropdown.replaceChildren(frag);
            matrixDropdown.classList.remove('hidden');
            matrixSearch?.setAttribute('aria-expanded', 'true');
          };

          // Delegate chip clicks across both quick-pick and expanded chip trays
          matrixSection?.addEventListener('click', (e) => {
            const chip = (e.target as HTMLElement).closest('.matrix-chip') as HTMLButtonElement | null;
            if (!chip || !chip.dataset.matrixSlug) return;
            const found = itemBySlug.get(chip.dataset.matrixSlug);
            if (found) {
              selectMatrixItem(found, false);
              if (matrixSearch) matrixSearch.value = '';
              if (matrixClear) matrixClear.classList.add('hidden');
            }
          });

          if (matrixSearch) {
            matrixSearch.addEventListener('focus', () => {
              renderMatrixDropdown(matrixSearch.value);
            });
            matrixSearch.addEventListener('input', () => {
              if (matrixClear) {
                matrixClear.classList.toggle('hidden', matrixSearch.value.trim().length === 0);
              }
              renderMatrixDropdown(matrixSearch.value);
            });
            matrixSearch.addEventListener('keydown', (e) => {
              if (!matrixDropdown || matrixDropdown.classList.contains('hidden')) return;
              if (e.key === 'ArrowDown' && matrixMatches.length > 0) {
                e.preventDefault();
                updateMatrixOptionHighlight((matrixOptionIndex + 1) % matrixMatches.length);
              } else if (e.key === 'ArrowUp' && matrixMatches.length > 0) {
                e.preventDefault();
                updateMatrixOptionHighlight(matrixOptionIndex <= 0 ? matrixMatches.length - 1 : matrixOptionIndex - 1);
              } else if (e.key === 'Enter' && matrixMatches.length > 0) {
                e.preventDefault();
                const targetItem = matrixOptionIndex >= 0 ? matrixMatches[matrixOptionIndex] : matrixMatches[0];
                if (targetItem) selectMatrixItem(targetItem, true);
              } else if (e.key === 'Escape') {
                closeMatrixDropdown();
              }
            });
          }

          if (matrixClear && matrixSearch) {
            matrixClear.addEventListener('click', () => {
              matrixSearch.value = '';
              matrixClear.classList.add('hidden');
              closeMatrixDropdown();
              matrixSearch.focus();
            });
          }

          if (matrixToggleAll && matrixAllChips) {
            matrixToggleAll.addEventListener('click', () => {
              const isHidden = matrixAllChips.classList.toggle('hidden');
              matrixToggleAll.setAttribute('aria-expanded', isHidden ? 'false' : 'true');
              const showText = matrixToggleAll.dataset.labelShow || 'Browse all';
              const hideText = matrixToggleAll.dataset.labelHide || 'Show less';
              matrixToggleAll.textContent = isHidden ? `${showText} +` : `${hideText} −`;
            });
          }

          document.addEventListener('click', (e) => {
            if (matrixSearchWrap && !matrixSearchWrap.contains(e.target as Node)) {
              closeMatrixDropdown();
            }
          });
        }
      }
    });
  </script>
</Layout>
