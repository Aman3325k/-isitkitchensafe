    formulationHelp: "选择活性益生菌培养液、微藻DHA/EPA油脂、热敏功能酶制剂，或传统热力/化学毒性对照基准。",
    voltageLabel: "施加高压电位 (V_ehd):",
    voltageHelp: "建立稳定泰勒锥-射流静电麦克斯韦应力的受控高压直流电压（10至30 kV）。",
    coreFlowLabel: "核心流体注入流速 (Q_core):",
    coreFlowHelp: "单支毛细管喷针内部有效成分输送流速（每喷嘴0.2至10.0 mL/h）。",
    shellFlowLabel: "外壳聚合物注入流速 (Q_shell):",
    shellFlowHelp: "单支喷针外部保护性生物大分子流体输送流速（每喷嘴0.5至25.0 mL/h）。",
    distanceLabel: "发射针与接收电极工作间距 (H_gap):",
    distanceHelp: "毛细喷针尖端与接地交联收集槽之间的轴向距离（60至200 mm）。",
    needleCountLabel: "多毛细管阵列喷针总数 (N_nozzles):",
    needleCountHelp: "生产型连续管组阵列中的并联同轴喷针总数（1至256支喷针）。",
    collectionLabel: "固化交联与收集介质:",
    collectionHelp: "选择连续氯化钙离子交联水浴、冷态干燥氮气逆流沉降塔或卫生型旋风分离收集器。",
    presetsTitle: "工业标准预设方案:",
    presetProbiotic: "活性益生菌肠溶保护预设（18.5 kV，Q_core 1.2 mL/h，Q_shell 3.6 mL/h，98.9%存活率，胃液存活94.2%）",
    presetOmega3: "微藻Omega-3 DHA零氧化预设（21.0 kV，Q_core 2.0 mL/h，Q_shell 5.0 mL/h，过氧化值PV < 0.8 meq/kg，常温保质240天）",
    presetEnzyme: "热敏酶类构象完全保留预设（16.8 kV，Q_core 0.8 mL/h，Q_shell 2.8 mL/h，催化活性99.4%，无热损伤）",
    presetThermalHazard: "传统高温喷雾干燥热损伤对照（进风180℃，活菌致死>65%，剧烈脂质氧化哈败，PV > 5.4）",
    presetChemicalHazard: "传统戊二醛化学交联毒性对照（残留>50 ppm严重违反USP <467>，引发细胞毒性与危险废物）",
    telemetryTitle: "实时电流体动力学遥测与微胶囊雷达",
    telemetrySub: "连续监测胶囊平均粒径、多分散系数（PDI）、包埋率、菌株存活率、过氧化值及能耗。",
    diameterLabel: "微胶囊平均粒径 (d_p):",
    pdiLabel: "多分散指数 (PDI):",
    efficiencyLabel: "核心包埋效率 (EE):",
    survivalLabel: "益生菌活性保留率:",
    peroxideLabel: "Omega-3过氧化值 (PV):",
    gastricLabel: "模拟胃液耐受通过率 (pH 2.0):",
    intestinalLabel: "肠道靶向崩解释放率 (pH 7.4):",
    secLabel: "单位质量能耗 (SEC):",
    savingsLabel: "相对传统喷雾干燥节能率:",
    arcSafetyLabel: "IEEE Std 510 电弧熄灭安全系数:",
    complianceVerdictLabel: "卫生与FDA FSMA合规状态:",
    diagramTitle: "同轴泰勒锥-射流（Taylor Cone-Jet）EHD流动截面示意图",
    diagramSub: "工程剖面图展示同轴双层喷针结构、静电电场线分布、弯月面泰勒锥形变及非热微滴单分散库仑裂变。",
    chartTitle: "胶囊粒径 (µm) 及活菌存活率 (%) 与 施加高压 (kV) 关系曲线",
    chartSub: "参数化模拟滴落模式向稳定泰勒锥模式的跃迁，以及高压库仑多重射流的裂变阈值。",
    scienceTitle: "电流体动力学雾化物理学与泰勒锥原理",
    scienceSub: "麦克斯韦静电应力张量、雷利极限电荷量及无量纲标度律对常温微胶囊包埋的控制方程。",
    tableTitle: "微胶囊制备技术核心指标综合对比表",
    exportAuditBtn: "导出完整EHD-CME系统审计JSON"
  }
};

const d = DICT[lang] || DICT.en;
---

<div class="ehd-cme-modeler bg-surface-soft border border-hairline rounded-3xl p-6 sm:p-10 mb-12 shadow-sm text-ink font-sans">
  <!-- Header Badge & Titles -->
  <div class="mb-8">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-violet-950 text-violet-300 border border-violet-800 mb-3">
      <span class="w-2 h-2 rounded-full bg-violet-400 animate-pulse"></span>
      {d.badge}
    </div>
    <h2 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-ink mb-3 leading-tight">
      {d.title}
    </h2>
    <p class="text-muted text-sm sm:text-base leading-relaxed max-w-4xl">
      {d.subtitle}
    </p>
  </div>

  <!-- Presets Bar -->
  <div class="mb-8 p-4 sm:p-5 bg-surface rounded-2xl border border-hairline/80">
    <div class="text-xs font-semibold text-muted uppercase tracking-wider mb-3">
      {d.presetsTitle}
    </div>
    <div class="flex flex-wrap gap-2 sm:gap-3">
      <button type="button" class="preset-btn px-3.5 py-2 rounded-xl text-xs font-medium bg-surface-hover hover:bg-violet-900/30 border border-hairline text-ink transition-all cursor-pointer" data-preset="probiotic">
        🌱 {d.presetProbiotic.split('(')[0]}
      </button>
      <button type="button" class="preset-btn px-3.5 py-2 rounded-xl text-xs font-medium bg-surface-hover hover:bg-cyan-900/30 border border-hairline text-ink transition-all cursor-pointer" data-preset="omega3">
        🐟 {d.presetOmega3.split('(')[0]}
      </button>
      <button type="button" class="preset-btn px-3.5 py-2 rounded-xl text-xs font-medium bg-surface-hover hover:bg-emerald-900/30 border border-hairline text-ink transition-all cursor-pointer" data-preset="enzyme">
        🧪 {d.presetEnzyme.split('(')[0]}
      </button>
      <button type="button" class="preset-btn px-3.5 py-2 rounded-xl text-xs font-medium bg-red-950/40 hover:bg-red-900/60 border border-red-800/60 text-red-300 transition-all cursor-pointer" data-preset="thermalHazard">
        ⚠️ {d.presetThermalHazard.split('(')[0]}
      </button>
      <button type="button" class="preset-btn px-3.5 py-2 rounded-xl text-xs font-medium bg-amber-950/40 hover:bg-amber-900/60 border border-amber-800/60 text-amber-300 transition-all cursor-pointer" data-preset="chemicalHazard">
        ☣️ {d.presetChemicalHazard.split('(')[0]}
      </button>
    </div>
  </div>

  <!-- Main Grid: Controls + Telemetry Radar -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-10">
    <!-- Controls (7 cols) -->
    <div class="lg:col-span-7 bg-surface p-6 sm:p-8 rounded-2xl border border-hairline flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between border-b border-hairline/60 pb-3 mb-6">
          <h3 class="text-lg font-bold text-ink flex items-center gap-2">
            <svg class="w-5 h-5 text-violet-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
            </svg>
            {d.controlsTitle}
          </h3>
          <span class="text-xs font-mono text-muted">EHD-CME v2.0</span>
        </div>

        <div class="space-y-5">
          <!-- Skid Architecture -->
          <div>
            <label for="skidSelect" class="block text-xs font-semibold text-muted uppercase tracking-wider mb-1">
              {d.skidLabel}
            </label>
            <select id="skidSelect" class="w-full bg-surface-soft border border-hairline rounded-xl px-3.5 py-2 text-xs sm:text-sm text-ink focus:outline-hidden focus:border-violet-500">
              {ehdData.systemArchitectures.map((skid) => (
                <option value={skid.id}>{skid.name}</option>
              ))}
            </select>
            <p class="text-[11px] text-muted mt-1">{d.skidHelp}</p>
          </div>

          <!-- Payload & Formulation Selection -->
          <div>
            <label for="formulationSelect" class="block text-xs font-semibold text-muted uppercase tracking-wider mb-1">
              {d.formulationLabel}
            </label>
            <select id="formulationSelect" class="w-full bg-surface-soft border border-hairline rounded-xl px-3.5 py-2 text-xs sm:text-sm text-ink focus:outline-hidden focus:border-violet-500">
              {ehdData.encapsulationFormulations.map((form) => (
                <option value={form.id}>{form.name}</option>
              ))}
            </select>
            <p class="text-[11px] text-muted mt-1">{d.formulationHelp}</p>
          </div>

          <!-- Sliders Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 pt-2">
            <!-- Applied Voltage -->
            <div>
              <div class="flex justify-between text-xs mb-1">
                <span class="font-medium text-ink">{d.voltageLabel}</span>
                <span id="voltageVal" class="font-mono text-violet-400 font-bold">18.5 kV</span>
              </div>
              <input type="range" id="voltageRange" min="10" max="30" step="0.5" value="18.5" class="w-full accent-violet-500 cursor-pointer" />
              <div class="flex justify-between text-[10px] text-muted mt-0.5">
                <span>10 kV</span>
                <span>30 kV</span>
              </div>
            </div>

            <!-- Working Distance -->
            <div>
              <div class="flex justify-between text-xs mb-1">
                <span class="font-medium text-ink">{d.distanceLabel}</span>
                <span id="distanceVal" class="font-mono text-violet-400 font-bold">120 mm</span>
              </div>
              <input type="range" id="distanceRange" min="60" max="200" step="5" value="120" class="w-full accent-violet-500 cursor-pointer" />
              <div class="flex justify-between text-[10px] text-muted mt-0.5">
                <span>60 mm</span>
                <span>200 mm</span>
              </div>
            </div>

            <!-- Core Injection Flow Rate -->
            <div>
              <div class="flex justify-between text-xs mb-1">
                <span class="font-medium text-ink">{d.coreFlowLabel}</span>
                <span id="coreFlowVal" class="font-mono text-cyan-400 font-bold">1.2 mL/h</span>
              </div>
              <input type="range" id="coreFlowRange" min="0.2" max="10.0" step="0.1" value="1.2" class="w-full accent-cyan-500 cursor-pointer" />
              <div class="flex justify-between text-[10px] text-muted mt-0.5">
                <span>0.2 mL/h</span>
                <span>10.0 mL/h</span>
              </div>
            </div>

            <!-- Shell Biopolymer Flow Rate -->
            <div>
              <div class="flex justify-between text-xs mb-1">
                <span class="font-medium text-ink">{d.shellFlowLabel}</span>
                <span id="shellFlowVal" class="font-mono text-amber-400 font-bold">3.6 mL/h</span>
              </div>
              <input type="range" id="shellFlowRange" min="0.5" max="25.0" step="0.5" value="3.6" class="w-full accent-amber-500 cursor-pointer" />
              <div class="flex justify-between text-[10px] text-muted mt-0.5">
                <span>0.5 mL/h</span>
                <span>25.0 mL/h</span>
              </div>
            </div>

            <!-- Needle Array Count -->
            <div>
              <div class="flex justify-between text-xs mb-1">
                <span class="font-medium text-ink">{d.needleCountLabel}</span>
                <span id="needleCountVal" class="font-mono text-emerald-400 font-bold">64 Nozzles</span>
              </div>
              <input type="range" id="needleCountRange" min="1" max="256" step="1" value="64" class="w-full accent-emerald-500 cursor-pointer" />
              <div class="flex justify-between text-[10px] text-muted mt-0.5">
                <span>1 (Single)</span>
                <span>256 (Array)</span>
              </div>
            </div>

            <!-- Collection Method -->
            <div>
              <label for="collectionSelect" class="block text-xs font-semibold text-muted uppercase tracking-wider mb-1">
                {d.collectionLabel}
              </label>
              <select id="collectionSelect" class="w-full bg-surface-soft border border-hairline rounded-xl px-3 py-1.5 text-xs text-ink focus:outline-hidden focus:border-violet-500">
                <option value="cacl2_bath">Aqueous CaCl2 Ionic Crosslinking Bath</option>
                <option value="cold_nitrogen_tower">Cold Dry Nitrogen Desolvation Tower</option>
                <option value="sanitary_cyclone">Sanitary High-Velocity Cyclone Harvest</option>
              </select>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-6 pt-4 border-t border-hairline/60 flex items-center justify-between">
        <span class="text-xs text-muted">Taylor Cone-Jet Stability Regime: <span id="regimeIndicator" class="font-bold text-emerald-400">STABLE CONE-JET</span></span>
        <button type="button" id="exportAuditBtn" class="px-4 py-2 rounded-xl text-xs font-semibold bg-violet-700 hover:bg-violet-800 text-white transition-all shadow-xs cursor-pointer">
          {d.exportAuditBtn}
        </button>
      </div>
    </div>

    <!-- Telemetry Radar & Readouts (5 cols) -->
    <div class="lg:col-span-5 bg-surface p-6 sm:p-8 rounded-2xl border border-hairline flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between border-b border-hairline/60 pb-3 mb-5">
          <h3 class="text-lg font-bold text-ink flex items-center gap-2">
            <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
            {d.telemetryTitle}
          </h3>
          <span class="text-[11px] px-2 py-0.5 rounded-full bg-emerald-950 text-emerald-400 border border-emerald-800 font-mono">LIVE MODEL</span>
        </div>

        <div class="grid grid-cols-2 gap-3.5 mb-5">
          <!-- Capsule Diameter -->
          <div class="p-3 bg-surface-soft rounded-xl border border-hairline">
            <div class="text-[11px] text-muted mb-0.5">{d.diameterLabel}</div>
            <div id="readoutDiameter" class="text-xl font-bold font-mono text-ink">8.4 µm</div>
            <div class="text-[10px] text-emerald-400 mt-0.5 font-mono">Sub-10 µm Monodisperse</div>
          </div>

          <!-- PDI -->
          <div class="p-3 bg-surface-soft rounded-xl border border-hairline">
            <div class="text-[11px] text-muted mb-0.5">{d.pdiLabel}</div>
            <div id="readoutPdi" class="text-xl font-bold font-mono text-ink">0.07</div>
            <div class="text-[10px] text-emerald-400 mt-0.5 font-mono">&lt; 0.12 Uniform Jet</div>
          </div>

          <!-- Encapsulation Efficiency -->
          <div class="p-3 bg-surface-soft rounded-xl border border-hairline">
            <div class="text-[11px] text-muted mb-0.5">{d.efficiencyLabel}</div>
            <div id="readoutEfficiency" class="text-xl font-bold font-mono text-cyan-400">98.4%</div>
            <div class="text-[10px] text-muted mt-0.5">Total Core Retention</div>
          </div>

          <!-- Survival / Viability -->
          <div class="p-3 bg-surface-soft rounded-xl border border-hairline">
            <div class="text-[11px] text-muted mb-0.5">{d.survivalLabel}</div>
            <div id="readoutSurvival" class="text-xl font-bold font-mono text-emerald-400">98.9%</div>
            <div class="text-[10px] text-emerald-400 mt-0.5 font-mono">Zero Heat Lethality</div>
          </div>

          <!-- Gastric Bypass Survival -->
          <div class="p-3 bg-surface-soft rounded-xl border border-hairline">
            <div class="text-[11px] text-muted mb-0.5">{d.gastricLabel}</div>
            <div id="readoutGastric" class="text-xl font-bold font-mono text-amber-400">94.2%</div>
            <div class="text-[10px] text-muted mt-0.5 font-mono">2h Pepsin @ pH 2.0</div>
          </div>

          <!-- Intestinal Release -->
          <div class="p-3 bg-surface-soft rounded-xl border border-hairline">
            <div class="text-[11px] text-muted mb-0.5">{d.intestinalLabel}</div>
            <div id="readoutIntestinal" class="text-xl font-bold font-mono text-cyan-400">96.8%</div>
            <div class="text-[10px] text-muted mt-0.5 font-mono">Pancreatin @ pH 7.4</div>
          </div>

          <!-- Specific Energy SEC -->
          <div class="p-3 bg-surface-soft rounded-xl border border-hairline">
            <div class="text-[11px] text-muted mb-0.5">{d.secLabel}</div>
            <div id="readoutSec" class="text-xl font-bold font-mono text-ink">0.21 kWh/kg</div>
            <div class="text-[10px] text-muted mt-0.5 font-mono">Non-Thermal Coulombic</div>
          </div>

          <!-- Energy Savings -->
          <div class="p-3 bg-surface-soft rounded-xl border border-hairline">
            <div class="text-[11px] text-muted mb-0.5">{d.savingsLabel}</div>
            <div id="readoutSavings" class="text-xl font-bold font-mono text-emerald-400">93.8%</div>
            <div class="text-[10px] text-emerald-400 mt-0.5 font-mono">vs 3.4 kWh/kg Thermal</div>
          </div>
        </div>

        <!-- Compliance & Arc-Safety Verdict -->
        <div class="p-4 bg-surface-soft rounded-xl border border-hairline space-y-2">
          <div class="flex items-center justify-between text-xs">
            <span class="text-muted">{d.arcSafetyLabel}</span>
            <span id="readoutArcSafety" class="font-mono font-bold text-emerald-400">SF = 4.8 (IEEE Std 510 Quench &lt; 1.0 µs)</span>
          </div>
          <div class="flex items-center justify-between text-xs">
            <span class="text-muted">{d.complianceVerdictLabel}</span>
            <span id="readoutVerdict" class="font-mono font-bold text-emerald-400">FDA 21 CFR § 170.36 GRAS &bull; USP &lt;467&gt;</span>
          </div>
        </div>
      </div>

      <div class="mt-4 pt-3 text-[11px] text-muted text-center border-t border-hairline/60">
        Simulated at 22°C ambient room temperature &bull; 0.0 ppm toxic solvent residues &bull; Aseptic Class 7 HEPA
      </div>
    </div>
  </div>

  <!-- Interactive Cross-Sectional Engineering SVG Schematic -->
  <div class="bg-surface p-6 sm:p-8 rounded-2xl border border-hairline mb-10">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-hairline/60 pb-3 mb-6">
      <div>
        <h3 class="text-lg font-bold text-ink flex items-center gap-2">
          <svg class="w-5 h-5 text-violet-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          {d.diagramTitle}
        </h3>
        <p class="text-xs text-muted mt-0.5">{d.diagramSub}</p>
      </div>
      <div class="flex items-center gap-2 text-xs font-mono">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-cyan-950 text-cyan-300 border border-cyan-800">
          <span class="w-2 h-2 rounded-full bg-cyan-400"></span> Core Fluid (Probiotics / DHA)
        </span>
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-amber-950 text-amber-300 border border-amber-800">
          <span class="w-2 h-2 rounded-full bg-amber-400"></span> Shell Biopolymer (Alginate/WPI)
        </span>
      </div>
    </div>

    <div class="w-full overflow-x-auto">
      <svg class="w-full min-w-[700px] h-[340px] bg-slate-950 rounded-xl border border-slate-800" viewBox="0 0 800 340" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Background Grid -->
        <defs>
          <pattern id="gridPattern" width="40" height="40" patternUnits="userSpaceOnUse">
            <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#1e293b" stroke-width="0.8" opacity="0.4"/>
          </pattern>
          <linearGradient id="voltageGlow" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#8b5cf6" stop-opacity="0.3"/>
            <stop offset="100%" stop-color="#8b5cf6" stop-opacity="0.0"/>
          </linearGradient>
        </defs>
        <rect width="800" height="340" fill="url(#gridPattern)" />

        <!-- High-Voltage Potential Field Area -->
        <path d="M 360 80 L 440 80 L 520 270 L 280 270 Z" fill="url(#voltageGlow)" />

        <!-- Electrical Field Lines (Dotted) -->
        <g stroke="#a78bfa" stroke-width="1" stroke-dasharray="3 3" opacity="0.5">
          <path d="M 380 90 Q 320 180 290 270" />
          <path d="M 395 90 Q 360 180 350 270" />
          <path d="M 400 90 L 400 270" />
          <path d="M 405 90 Q 440 180 450 270" />
          <path d="M 420 90 Q 480 180 510 270" />
        </g>

        <!-- Coaxial Emitter Structure (Top) -->
        <!-- Outer Capillary (Shell) -->
        <rect x="375" y="15" width="50" height="65" rx="3" fill="#334155" stroke="#94a3b8" stroke-width="1.5" />
