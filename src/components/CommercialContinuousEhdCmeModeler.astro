  (function initEhdCmeModeler() {
    // Inputs
    const skidSelect = document.getElementById('skidSelect');
    const formulationSelect = document.getElementById('formulationSelect');
    const voltageRange = document.getElementById('voltageRange');
    const distanceRange = document.getElementById('distanceRange');
    const coreFlowRange = document.getElementById('coreFlowRange');
    const shellFlowRange = document.getElementById('shellFlowRange');
    const needleCountRange = document.getElementById('needleCountRange');
    const collectionSelect = document.getElementById('collectionSelect');

    // Value Labels
    const voltageVal = document.getElementById('voltageVal');
    const distanceVal = document.getElementById('distanceVal');
    const coreFlowVal = document.getElementById('coreFlowVal');
    const shellFlowVal = document.getElementById('shellFlowVal');
    const needleCountVal = document.getElementById('needleCountVal');
    const regimeIndicator = document.getElementById('regimeIndicator');

    // Telemetry Readouts
    const readoutDiameter = document.getElementById('readoutDiameter');
    const readoutPdi = document.getElementById('readoutPdi');
    const readoutEfficiency = document.getElementById('readoutEfficiency');
    const readoutSurvival = document.getElementById('readoutSurvival');
    const readoutGastric = document.getElementById('readoutGastric');
    const readoutIntestinal = document.getElementById('readoutIntestinal');
    const readoutSec = document.getElementById('readoutSec');
    const readoutSavings = document.getElementById('readoutSavings');
    const readoutArcSafety = document.getElementById('readoutArcSafety');
    const readoutVerdict = document.getElementById('readoutVerdict');

    // SVG Marker Elements
    const operatingLine = document.getElementById('operatingLine');
    const diameterMarker = document.getElementById('diameterMarker');
    const viabilityMarker = document.getElementById('viabilityMarker');

    // Presets Buttons
    const presetBtns = document.querySelectorAll('.preset-btn');
    const exportBtn = document.getElementById('exportAuditBtn');

    function calculateModel() {
      if (!voltageRange) return;

      const V = parseFloat(voltageRange.value);
      const H = parseFloat(distanceRange.value);
      const Q_core = parseFloat(coreFlowRange.value);
      const Q_shell = parseFloat(shellFlowRange.value);
      const N_needles = parseInt(needleCountRange.value, 10);
      const formId = formulationSelect.value;

      // Update Slider Label Displays
      if (voltageVal) voltageVal.textContent = V.toFixed(1) + ' kV';
      if (distanceVal) distanceVal.textContent = H.toFixed(0) + ' mm';
      if (coreFlowVal) coreFlowVal.textContent = Q_core.toFixed(1) + ' mL/h';
      if (shellFlowVal) shellFlowVal.textContent = Q_shell.toFixed(1) + ' mL/h';
      if (needleCountVal) needleCountVal.textContent = N_needles + (N_needles === 1 ? ' Nozzle' : ' Nozzles');

      // Check Hazard Benchmark overrides
      const isThermalHazard = formId === 'spray_drying_thermal_hazard_benchmark';
      const isChemicalHazard = formId === 'toxic_chemical_crosslinking_hazard_benchmark';

      // Physics Calculations
      // EHD Regime Check: Critical onset V_c ≈ 12-14 kV depending on H
      const V_c = 11.5 + (H / 100.0) * 2.5; // Critical Taylor threshold
      let regimeText = 'STABLE CONE-JET';
      let regimeColor = 'text-emerald-400';

      if (V < V_c) {
        regimeText = 'DRIPPING / PULSATING (SUB-CRITICAL)';
        regimeColor = 'text-amber-400';
      } else if (V > 26.0) {
        regimeText = 'MULTI-JET / CORONA BREAKDOWN RISK';
        regimeColor = 'text-red-400';
      }

      if (regimeIndicator) {
        regimeIndicator.textContent = regimeText;
        regimeIndicator.className = 'font-bold ' + regimeColor;
      }

      // Droplet Diameter scaling law: d_p ~ Q^(1/2) / V^(1/3)
      const Q_total = Q_core + Q_shell;
      let d_p = 4.2 * Math.sqrt(Q_total) / Math.pow(V / 18.0, 0.45);
      if (V < V_c) d_p *= 2.8; // Drops are coarse in dripping mode
      if (d_p < 1.5) d_p = 1.5;

      // Polydispersity Index
      let pdi = (V >= V_c && V <= 25.5) ? (0.05 + (Q_core / Q_total) * 0.04) : 0.35;

      // Encapsulation Efficiency (EE)
      let ee = (Q_shell >= Q_core * 1.5) ? (98.5 - (Q_core / Q_total) * 2.0) : 84.0;

      // Probiotic / Payload Viability
      let viability = 99.2 - Math.max(0, (V - 25.0) * 1.8);
      let gastricSurvival = 94.5 - (d_p < 4.0 ? 5.0 : 0.0);
      let intestinalRelease = 96.8;

      // Specific Energy Consumption (SEC in kWh/kg)
      // EHD uses ~150 to 300 W per kg of atomized biopolymer
      let sec = 0.18 + (V / 30.0) * 0.10;
      let savings = ((3.40 - sec) / 3.40) * 100.0;

      // Hazard overrides
      if (isThermalHazard) {
        d_p = 32.5;
        pdi = 0.58;
        ee = 61.2;
        viability = 32.4;
        gastricSurvival = 41.0;
        intestinalRelease = 55.0;
        sec = 3.65;
        savings = 0.0;
      } else if (isChemicalHazard) {
        d_p = 24.0;
        pdi = 0.38;
        ee = 88.0;
        viability = 12.0;
        gastricSurvival = 78.0;
        intestinalRelease = 42.0;
        sec = 1.65;
        savings = 51.5;
      }

      // Update Telemetry Display
      if (readoutDiameter) readoutDiameter.textContent = d_p.toFixed(1) + ' µm';
      if (readoutPdi) readoutPdi.textContent = pdi.toFixed(2);
      if (readoutEfficiency) readoutEfficiency.textContent = ee.toFixed(1) + '%';
      if (readoutSurvival) readoutSurvival.textContent = viability.toFixed(1) + '%';
      if (readoutGastric) readoutGastric.textContent = gastricSurvival.toFixed(1) + '%';
      if (readoutIntestinal) readoutIntestinal.textContent = intestinalRelease.toFixed(1) + '%';
      if (readoutSec) readoutSec.textContent = sec.toFixed(2) + ' kWh/kg';
      if (readoutSavings) readoutSavings.textContent = savings.toFixed(1) + '%';

      // Arc Safety & Verdict
      if (readoutArcSafety) {
        if (isChemicalHazard) {
          readoutArcSafety.textContent = 'FAIL: Glutaraldehyde Toxicity (>50 ppm)';
          readoutArcSafety.className = 'font-mono font-bold text-red-400';
        } else if (isThermalHazard) {
          readoutArcSafety.textContent = 'FAIL: Thermal Pyrolysis Denaturation';
          readoutArcSafety.className = 'font-mono font-bold text-red-400';
        } else if (V > 26.5) {
          readoutArcSafety.textContent = 'WARNING: High Field Stress (SF = 1.8)';
          readoutArcSafety.className = 'font-mono font-bold text-amber-400';
        } else {
          readoutArcSafety.textContent = 'SF = 4.8 (IEEE Std 510 Quench < 1.0 µs)';
          readoutArcSafety.className = 'font-mono font-bold text-emerald-400';
        }
      }

      if (readoutVerdict) {
        if (isChemicalHazard) {
          readoutVerdict.textContent = 'NON-COMPLIANT (Violates USP <467>)';
          readoutVerdict.className = 'font-mono font-bold text-red-400';
        } else if (isThermalHazard) {
          readoutVerdict.textContent = 'THERMAL HAZARD (>65% Cell Death)';
          readoutVerdict.className = 'font-mono font-bold text-red-400';
        } else {
          readoutVerdict.textContent = 'FDA 21 CFR § 170.36 GRAS • USP <467>';
          readoutVerdict.className = 'font-mono font-bold text-emerald-400';
        }
      }

      // Update Chart SVG Marker
      // Voltage 10 to 30 mapped to x: 60 to 760 (width = 700 -> 35 px per kV)
      const clampedV = Math.min(30, Math.max(10, V));
      const chartX = 60 + (clampedV - 10) * 35.0;
      if (operatingLine) {
        operatingLine.setAttribute('x1', chartX);
        operatingLine.setAttribute('x2', chartX);
      }

      // Diameter mapped to y: 50 um -> 25px, 5 um -> 205px
      const clampedD = Math.min(50, Math.max(4, d_p));
      const chartYD = 205 - ((clampedD - 5) / 45.0) * 180.0;
      if (diameterMarker) {
        diameterMarker.setAttribute('cx', chartX);
        diameterMarker.setAttribute('cy', chartYD);
      }

      // Viability mapped to y: 100% -> 25px, 70% -> 205px
      const clampedViab = Math.min(100, Math.max(70, viability));
      const chartYV = 205 - ((clampedViab - 70) / 30.0) * 180.0;
      if (viabilityMarker) {
        viabilityMarker.setAttribute('cx', chartX);
        viabilityMarker.setAttribute('cy', chartYV);
      }
    }

    // Attach Event Listeners to all controls
    [skidSelect, formulationSelect, voltageRange, distanceRange, coreFlowRange, shellFlowRange, needleCountRange, collectionSelect].forEach(el => {
      if (el) {
        el.addEventListener('input', calculateModel);
        el.addEventListener('change', calculateModel);
      }
    });

    // Preset handlers
    presetBtns.forEach(btn => {
      btn.addEventListener('click', function() {
        const p = this.getAttribute('data-preset');
        if (p === 'probiotic') {
          if (formulationSelect) formulationSelect.value = 'probiotic_alginate_whey_core_shell';
          if (voltageRange) voltageRange.value = '18.5';
          if (coreFlowRange) coreFlowRange.value = '1.2';
          if (shellFlowRange) shellFlowRange.value = '3.6';
          if (distanceRange) distanceRange.value = '110';
          if (needleCountRange) needleCountRange.value = '64';
        } else if (p === 'omega3') {
          if (formulationSelect) formulationSelect.value = 'omega3_dha_epa_whey_maltodextrin';
          if (voltageRange) voltageRange.value = '21.0';
          if (coreFlowRange) coreFlowRange.value = '2.0';
          if (shellFlowRange) shellFlowRange.value = '5.0';
          if (distanceRange) distanceRange.value = '130';
          if (needleCountRange) needleCountRange.value = '128';
        } else if (p === 'enzyme') {
          if (formulationSelect) formulationSelect.value = 'labile_enzyme_chitosan_pectin';
          if (voltageRange) voltageRange.value = '16.8';
          if (coreFlowRange) coreFlowRange.value = '0.8';
          if (shellFlowRange) shellFlowRange.value = '2.8';
          if (distanceRange) distanceRange.value = '100';
          if (needleCountRange) needleCountRange.value = '32';
        } else if (p === 'thermalHazard') {
          if (formulationSelect) formulationSelect.value = 'spray_drying_thermal_hazard_benchmark';
          if (voltageRange) voltageRange.value = '10.0';
          if (coreFlowRange) coreFlowRange.value = '5.0';
          if (shellFlowRange) shellFlowRange.value = '10.0';
        } else if (p === 'chemicalHazard') {
          if (formulationSelect) formulationSelect.value = 'toxic_chemical_crosslinking_hazard_benchmark';
          if (voltageRange) voltageRange.value = '10.0';
          if (coreFlowRange) coreFlowRange.value = '3.0';
          if (shellFlowRange) shellFlowRange.value = '8.0';
        }
        calculateModel();
      });
    });

    // Export Audit JSON Handler
    if (exportBtn) {
      exportBtn.addEventListener('click', function() {
        const auditData = {
          timestamp: new Date().toISOString(),
          system: "Commercial Continuous Coaxial EHD-CME Skid",
          parameters: {
            voltageKv: parseFloat(voltageRange.value),
            workingDistanceMm: parseFloat(distanceRange.value),
            coreFlowMlLH: parseFloat(coreFlowRange.value),
            shellFlowMlLH: parseFloat(shellFlowRange.value),
            needleCount: parseInt(needleCountRange.value, 10),
            formulation: formulationSelect.value,
            collectionMode: collectionSelect.value
          },
          telemetry: {
            capsuleDiameterMicrons: readoutDiameter.textContent,
            polydispersityIndex: readoutPdi.textContent,
            encapsulationEfficiency: readoutEfficiency.textContent,
            probioticSurvival: readoutSurvival.textContent,
            gastricBypassSurvival: readoutGastric.textContent,
            intestinalRelease: readoutIntestinal.textContent,
            specificEnergyKwhPerKg: readoutSec.textContent,
            energySavingsPct: readoutSavings.textContent,
            arcSafetyFactor: readoutArcSafety.textContent,
            regulatoryStatus: readoutVerdict.textContent
          },
          compliance: {
            fdaGras: "FDA 21 CFR § 170.36 GRAS - Verified",
            uspSolvents: "USP <467> Residual Solvents 0.0 ppm - Exceeded",
            ieeeArcQuench: "IEEE Std 510 Fast Arc-Quench - Active",
            sanitaryStandards: "3-A Sanitary Standards 60-01 - Compliant"
          }
        };

        const blob = new Blob([JSON.stringify(auditData, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'ehd_cme_encapsulation_audit_' + Date.now() + '.json';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      });
    }

    // Initial run
    calculateModel();
  })();
</script>
