    rule3Text: "淀粉类根茎蔬菜在85°C以上会持续产生水分蒸发与组织排气。单道1mm细丝封口应力集中极易被撕开，而5mm双道加热条封口能有效分散剥离应力，彻底避免进水漏气。",
    rule4Title: "4. 85°C–95°C近沸点高温慢煮全面升级为蒸煮级CPP或铂金硅胶袋",
    rule4Text: "对于需要高温软化植物细胞壁的食材，请使用耐蒸煮聚丙烯（CPP/BOPA）真空袋或铂金硫化一体成型硅胶袋。两者耐温达121°C–200°C，不会发生热蠕变，实现真正的零微塑料溶出。",
    copyReportBtn: "复制诊断遥测数据报告",
    copiedFeedback: "诊断遥测报告已复制至剪贴板！"
  },
  ja: {
    badge: "高分子ポリマー化学＆食品接触安全性",
    title: "低温調理（低温真空調理）高温パウチ熱クリープ剥離＆マイクロプラスチック溶出モデラー",
    subtitle: "ポリエチレン（PE）およびナイロン（PA）多層真空パウチが、根菜類の高熱水温（85°C〜90°C）ブライン調理時に引き起こすヒートシール部の熱クリープ破断、微小プラスチック剥離、可塑剤移行を精密にモデル化。",
    controlsTitle: "真空調理（スーヴィード）熱力学＆ポリマー制御設定",
    controlsSub: "パウチポリマー材質、水槽温度、連続加熱時間、ヒートシール幅・仕様、食材の油分・酸性度を設定します。",
    materialLabel: "パウチポリマー構造と材料区分：",
    materialHelp: "家庭用LDPEジッパー付き保存袋 vs 業務用PA/PE多層ラミネート真空袋 vs レトルトCPP袋 vs プラチナ硬化シリコンバッグ vs PVCラップフィルム。",
    tempLabel: "ウォーターバス加熱温度（°C / °F）：",
    tempHelp: "繊細な魚介・赤身肉の低温調理（55°C）からペクチン軟化・根菜類の高熱加熱（85°C〜92°C）まで設定可能。",
    durationLabel: "連続浸漬加熱時間（時間）：",
    durationHelp: "1時間急速加熱 vs 4時間標準根菜煮込み vs 12〜24時間コンフィ vs 48時間長時間エキスパート調理。",
    sealLabel: "シール部の幅と溶着方式：",
    sealHelp: "単線1mm細幅インパルスシール vs 3mm標準フラット熱溶着 vs チャンバー式5mmダブル溶着 vs ジッパー式嵌合部。",
    matrixLabel: "食品基質（油脂含有率と酸性度）：",
    matrixHelp: "水性スープ・低脂肪食材 vs バター・オイルたっぷりコンフィ（親脂性溶出増大） vs 柑橘・ワイン等の酸性マリネ（pH < 3.5）。",
    presetsTitle: "実践的な調理事例とプリセット設定：",
    presetVegetableBraise: "高温根菜ブライン（ニンジン 88°C 4時間 LDPEジッパー袋）",
    presetConfitChamber: "24時間豚バラ肉コンフィ（豚肉＋バター 82°C 24時間 PA/PE真空袋 5mmダブルシール）",
    presetSafeSilicone: "プラチナシリコン安全仕様（ジャガイモ 90°C 2時間 プラチナ硬化シリコンバッグ）",
    presetCatastrophicCreep: "熱クリープ破断重大事故（ビーツ 92°C 6時間 LDPE袋 1mm単線シール 酸性ソース）",
    diagnosticTitle: "ポリマー熱劣化＆化学物質移行診断パネル",
    diagnosticSub: "シール部クリープ破断確率、マイクロプラスチック溶出密度、化学物質移行量（EU基準比較）、熱劣化指数をリアルタイム解析。",
    creepRiskLabel: "シール部クリープ剥離・破断確率",
    microplasticLabel: "微小・ナノプラスチック溶出密度",
    migrationLabel: "添加剤・オリゴマー化学移行量",
    degradationLabel: "ポリマー基質熱劣化損傷指数",
    complianceLabel: "EU 10/2011基準およびFDA適合性",
    mechanismLabel: "生物物理的劣化と層間接着剤加水分解機序",
    guidanceLabel: "厨房調理衛生および高分子工学対策指針",
    scienceTitle: "高分子物理学、粘弾性クリープ現象、マイクロプラスチック溶出速度論",
    scienceSub: "ビカー軟化点近傍の水温下で、非晶質ポリエチレン分子鎖の弛緩、水蒸気膨張圧、添加剤の相溶性拡散が加速するメカニズム。",
    tableTitle: "真空調理用バリアフィルム工学特性比較マトリクス",
    tableSub: "調理用ポリマーフィルムの熱機械的物性、化学物質移行限界、食品衛生基準の全容比較。",
    colMaterial: "ポリマーフィルム材料構造",
    colSoftening: "ビカー軟化点 (°C)",
    colMaxTemp: "安全最高浸漬温度 (°C)",
    colPeelStrength: "ピール強度 (N/m)",
    colMicroplastic: "微小プラスチック溶出量 (85°C)",
    colCompliance: "食品接触適合基準＆評価",
    rulesTitle: "高温スーヴィード調理 4大必須安全プロトコル",
    rulesSub: "パウチ破損・浸水、環境ホルモン移行、微小プラスチック経口摂取を未然に防止するための技術基準。",
    rule1Title: "1. 70°C（158°F）を超える水温で家庭用LDPEジッパー袋を使用しない",
    rule1Text: "一般的なジッパー付き保存袋は低密度ポリエチレン製で、ビカー軟化点は85°C〜88°Cです。根菜を調理する85°C〜90°Cではポリマーが軟化し、蒸気圧でジッパーが開き、1平方デシメートルあたり25万個以上のマイクロプラスチックが食品に脱落します。",
    rule2Title: "2. 12時間以上の長時間調理ではPA/PE多層共押出真空袋を選定する",
    rule2Text: "ナイロン・ポリエチレン共押出袋は80°C以下で優れた強度を発揮しますが、高温下で12時間を超えると中間ポリウレタン接着剤が湿気で可塑化・加水分解し、層間剥離リスクが高まります。",
    rule3Title: "3. 85°C以上の根菜調理には5mmダブルシールまたはチャンバー溶着を採用する",
    rule3Text: "デンプン質根菜は加熱時に気化蒸気を発生させ内圧が上昇します。1mmの細い溶着線では剥離応力が集中して破裂するため、幅広の5mmダブル熱溶着で応力を分散させてください。",
    rule4Title: "4. 85°C〜95°Cの高温調理にはレトルトCPP袋またはプラチナシリコン袋へ移行する",
    rule4Text: "沸点に近い高温加熱には、耐熱121°C以上のキャストポリプロピレン（CPP）製レトルト袋やプラチナ硬化シリコンバッグを使用してください。熱クリープを起こさず、マイクロプラスチック溶出もほぼゼロに抑えられます。",
    copyReportBtn: "診断テレメトリレポートをコピー",
    copiedFeedback: "診断テレメトリをクリップボードにコピーしました！"
  }
};

const d = DICTIONARY[lang] || DICTIONARY.en;
const materials = pouchData.pouchMaterials;
const temps = pouchData.bathTemperatures;
const durations = pouchData.cookDurations;
const seals = pouchData.sealGeometries;
const matrices = pouchData.foodMatrices;
---

<div class="sous-vide-pouch-modeler-wrapper space-y-10 my-8">
  <!-- Interactive Modeler Box -->
  <div class="bg-surface border border-hairline rounded-3xl p-6 md:p-10 shadow-xs">
    <!-- Header inside tool -->
    <div class="border-b border-hairline/60 pb-6 mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 mb-3 border border-emerald-500/20">
        <span>🧪</span>
        {d.badge}
      </div>
      <h2 class="text-2xl md:text-3xl font-extrabold text-ink tracking-tight mb-2">
        {d.title}
      </h2>
      <p class="text-sm md:text-base text-muted leading-relaxed">
        {d.subtitle}
      </p>
    </div>

    <!-- Presets Bar -->
    <div class="mb-8 p-4 bg-surface-soft border border-hairline rounded-2xl">
      <div class="flex items-center gap-2 text-xs font-bold text-ink uppercase tracking-wider mb-3">
        <span>⚡</span> {d.presetsTitle}
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2">
        <button
          type="button"
          data-preset="vegetable_braise"
          class="preset-btn text-left p-3 rounded-xl border border-hairline/80 bg-surface hover:bg-surface-soft text-xs font-medium text-ink transition-all shadow-2xs hover:border-emerald-500/50"
        >
          🥕 {d.presetVegetableBraise}
        </button>
        <button
          type="button"
          data-preset="confit_chamber"
          class="preset-btn text-left p-3 rounded-xl border border-hairline/80 bg-surface hover:bg-surface-soft text-xs font-medium text-ink transition-all shadow-2xs hover:border-emerald-500/50"
        >
          🥩 {d.presetConfitChamber}
        </button>
        <button
          type="button"
          data-preset="safe_silicone"
          class="preset-btn text-left p-3 rounded-xl border border-hairline/80 bg-surface hover:bg-surface-soft text-xs font-medium text-ink transition-all shadow-2xs hover:border-emerald-500/50"
        >
          🥔 {d.presetSafeSilicone}
        </button>
        <button
          type="button"
          data-preset="catastrophic_creep"
          class="preset-btn text-left p-3 rounded-xl border border-hairline/80 bg-surface hover:bg-surface-soft text-xs font-medium text-ink transition-all shadow-2xs hover:border-emerald-500/50"
        >
          🚨 {d.presetCatastrophicCreep}
        </button>
      </div>
    </div>

    <!-- Control Inputs Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-10">
      <div class="lg:col-span-6 space-y-6">
        <h3 class="text-base font-bold text-ink flex items-center gap-2 border-b border-hairline pb-2">
          <span>⚙️</span> {d.controlsTitle}
        </h3>

        <!-- Pouch Polymer Material -->
        <div class="space-y-2">
          <div class="flex justify-between items-baseline">
            <label for="pouch-material-select" class="text-xs font-bold uppercase tracking-wider text-muted">
              {d.materialLabel}
            </label>
            <span id="material-badge" class="text-xs font-semibold px-2 py-0.5 rounded-full bg-surface-soft text-ink border border-hairline">
              LDPE Zipper Bag
            </span>
          </div>
          <select
            id="pouch-material-select"
            class="w-full bg-surface-soft border border-hairline rounded-xl px-4 py-3 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-emerald-500/40 transition-all font-medium"
          >
            {materials.map((m) => (
              <option value={m.id} selected={m.id === 'ldpe_ziploc'}>
                {m.name} (Vicat: {m.vicatSofteningPointC}°C | Max: {m.maxSafeImmersionTempC}°C)
              </option>
            ))}
          </select>
          <p class="text-xs text-muted leading-relaxed">
            {d.materialHelp}
          </p>
        </div>

        <!-- Bath Temperature Slider -->
        <div class="space-y-2">
          <div class="flex justify-between items-baseline">
            <label for="bath-temp-range" class="text-xs font-bold uppercase tracking-wider text-muted">
              {d.tempLabel}
            </label>
            <span id="temp-display" class="text-sm font-bold font-mono text-emerald-600 dark:text-emerald-400">
              88°C (190°F)
            </span>
          </div>
          <input
            id="bath-temp-range"
            type="range"
            min="50"
            max="95"
            step="1"
            value="88"
            class="w-full accent-emerald-600 cursor-pointer"
          />
          <div class="flex justify-between text-[11px] text-muted font-mono">
            <span>50°C (Rare)</span>
            <span>70°C (LDPE Limit)</span>
            <span>85°C (Vegetables)</span>
            <span>95°C (Starch Boil)</span>
          </div>
          <p class="text-xs text-muted leading-relaxed">
            {d.tempHelp}
          </p>
        </div>

        <!-- Cook Duration Slider -->
        <div class="space-y-2">
          <div class="flex justify-between items-baseline">
            <label for="dwell-duration-range" class="text-xs font-bold uppercase tracking-wider text-muted">
              {d.durationLabel}
            </label>
            <span id="duration-display" class="text-sm font-bold font-mono text-emerald-600 dark:text-emerald-400">
              4.0 Hours
            </span>
          </div>
          <input
            id="dwell-duration-range"
            type="range"
            min="0.5"
            max="48"
            step="0.5"
            value="4.0"
            class="w-full accent-emerald-600 cursor-pointer"
          />
          <div class="flex justify-between text-[11px] text-muted font-mono">
            <span>0.5h (Quick)</span>
            <span>4h (Braise)</span>
            <span>12h (Overnight)</span>
            <span>24h (Confit)</span>
            <span>48h (Max)</span>
          </div>
          <p class="text-xs text-muted leading-relaxed">
            {d.durationHelp}
          </p>
        </div>
      </div>

      <div class="lg:col-span-6 space-y-6">
        <h3 class="text-base font-bold text-ink flex items-center gap-2 border-b border-hairline pb-2">
          <span>📐</span> {d.controlsSub}
        </h3>

        <!-- Seal Geometry & Type -->
        <div class="space-y-2">
          <div class="flex justify-between items-baseline">
            <label for="seal-geometry-select" class="text-xs font-bold uppercase tracking-wider text-muted">
              {d.sealLabel}
            </label>
            <span id="seal-badge" class="text-xs font-semibold px-2 py-0.5 rounded-full bg-surface-soft text-ink border border-hairline">
              Mechanical Zipper
            </span>
          </div>
          <select
            id="seal-geometry-select"
            class="w-full bg-surface-soft border border-hairline rounded-xl px-4 py-3 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-emerald-500/40 transition-all font-medium"
          >
            {seals.map((s) => (
              <option value={s.id} selected={s.id === 'zipper_mechanical'}>
                {s.name} ({s.widthMm}mm width &bull; {s.creepVulnerability} Creep)
              </option>
            ))}
          </select>
          <p class="text-xs text-muted leading-relaxed">
            {d.sealHelp}
          </p>
        </div>

        <!-- Food Matrix / Acidity & Lipids -->
        <div class="space-y-2">
          <div class="flex justify-between items-baseline">
            <label for="food-matrix-select" class="text-xs font-bold uppercase tracking-wider text-muted">
              {d.matrixLabel}
            </label>
            <span id="matrix-badge" class="text-xs font-semibold px-2 py-0.5 rounded-full bg-surface-soft text-ink border border-hairline">
              Aqueous Low-Acid
            </span>
          </div>
          <select
            id="food-matrix-select"
            class="w-full bg-surface-soft border border-hairline rounded-xl px-4 py-3 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-emerald-500/40 transition-all font-medium"
          >
            {matrices.map((m) => (
              <option value={m.id} selected={m.id === 'neutral_aqueous'}>
                {m.name}
              </option>
            ))}
          </select>
          <p class="text-xs text-muted leading-relaxed">
            {d.matrixHelp}
          </p>
        </div>

        <!-- Dynamic Real-Time Micro-Parameters -->
        <div class="p-4 bg-surface-soft/80 border border-hairline rounded-2xl space-y-3">
          <div class="text-xs font-bold text-ink uppercase tracking-wider">
            📊 Polymer Thermomechanical Telemetry
          </div>
          <div class="grid grid-cols-2 gap-3 text-xs font-mono">
            <div>
              <span class="text-muted block">Vicat Softening:</span>
              <span id="telemetry-vicat" class="font-bold text-ink">88°C</span>
            </div>
            <div>
              <span class="text-muted block">Delta to Softening:</span>
              <span id="telemetry-delta" class="font-bold text-amber-600 dark:text-amber-400">0.0°C (Exceeded)</span>
            </div>
            <div>
              <span class="text-muted block">Vapor Outgassing Pressure:</span>
              <span id="telemetry-vapor" class="font-bold text-ink">64.5 kPa</span>
            </div>
            <div>
              <span class="text-muted block">Seam Peel Load Factor:</span>
              <span id="telemetry-peelload" class="font-bold text-ink">3.8x baseline</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Diagnostic Results Card -->
    <div class="bg-surface-soft border-2 border-hairline rounded-3xl p-6 md:p-8 transition-all" id="diagnostic-card">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-hairline pb-6 mb-6">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-muted block mb-1">
            {d.diagnosticTitle}
          </span>
          <h4 id="status-title" class="text-2xl font-black text-ink">
            CRITICAL SEAL CREEP &amp; MICROPLASTIC FAILURE HAZARD
          </h4>
        </div>
        <div id="status-badge" class="inline-flex items-center gap-2 px-4 py-2 rounded-2xl text-xs font-black uppercase tracking-wider bg-red-500/10 text-red-700 dark:text-red-400 border border-red-500/20 whitespace-nowrap self-start sm:self-auto">
          ⚠️ SEVERE CREEP RISK
        </div>
      </div>

      <!-- Metrics 4-Box Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
        <!-- 1. Seam Creep Rupture Risk -->
        <div class="bg-surface p-4 rounded-2xl border border-hairline shadow-2xs">
          <span class="text-xs text-muted block mb-1">{d.creepRiskLabel}</span>
          <div class="flex items-baseline gap-2">
            <span id="val-creep-risk" class="text-2xl font-extrabold font-mono text-red-600 dark:text-red-400">
              94%
            </span>
            <span class="text-xs text-muted">rupture prob.</span>
          </div>
          <div class="w-full bg-surface-soft rounded-full h-2 mt-2 overflow-hidden border border-hairline/60">
            <div id="bar-creep-risk" class="bg-red-500 h-full rounded-full transition-all duration-300" style="width: 94%;"></div>
          </div>
        </div>

        <!-- 2. Microplastic Shedding Density -->
        <div class="bg-surface p-4 rounded-2xl border border-hairline shadow-2xs">
          <span class="text-xs text-muted block mb-1">{d.microplasticLabel}</span>
          <div class="flex items-baseline gap-2">
            <span id="val-microplastics" class="text-2xl font-extrabold font-mono text-amber-600 dark:text-amber-400">
              315,000
            </span>
            <span class="text-xs text-muted">particles/dm²</span>
          </div>
          <div class="w-full bg-surface-soft rounded-full h-2 mt-2 overflow-hidden border border-hairline/60">
            <div id="bar-microplastics" class="bg-amber-500 h-full rounded-full transition-all duration-300" style="width: 78%;"></div>
          </div>
        </div>

        <!-- 3. Chemical & Oligomer Migration -->
        <div class="bg-surface p-4 rounded-2xl border border-hairline shadow-2xs">
          <span class="text-xs text-muted block mb-1">{d.migrationLabel}</span>
          <div class="flex items-baseline gap-2">
            <span id="val-migration" class="text-2xl font-extrabold font-mono text-ink">
              18.4
            </span>
            <span class="text-xs text-muted">mg/dm² (EU &lt;10)</span>
          </div>
          <div class="w-full bg-surface-soft rounded-full h-2 mt-2 overflow-hidden border border-hairline/60">
            <div id="bar-migration" class="bg-red-500 h-full rounded-full transition-all duration-300" style="width: 85%;"></div>
          </div>
        </div>

        <!-- 4. Thermal Degradation Index -->
        <div class="bg-surface p-4 rounded-2xl border border-hairline shadow-2xs">
          <span class="text-xs text-muted block mb-1">{d.degradationLabel}</span>
          <div class="flex items-baseline gap-2">
            <span id="val-degradation" class="text-2xl font-extrabold font-mono text-ink">
              88 / 100
            </span>
            <span class="text-xs text-muted">stress index</span>
          </div>
          <div class="w-full bg-surface-soft rounded-full h-2 mt-2 overflow-hidden border border-hairline/60">
            <div id="bar-degradation" class="bg-red-500 h-full rounded-full transition-all duration-300" style="width: 88%;"></div>
          </div>
        </div>
      </div>

      <!-- Descriptive Mechanisms & Protocols -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4 border-t border-hairline/80">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-muted block mb-2">
            🔬 {d.mechanismLabel}
          </span>
          <p id="mechanism-text" class="text-xs md:text-sm text-ink leading-relaxed">
            At 88°C, the water bath temperature exceeds the Vicat softening point of low-density polyethylene (88°C). Amorphous tie-chains undergo rapid entropy relaxation and tensile creep under hydrostatic vegetable steam pressure. The single-point mechanical zipper or thin heat seal peels progressively along the stress vector, shedding sub-micron polymeric particles directly into the food matrix.
          </p>
        </div>
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-muted block mb-2">
            🛡️ {d.guidanceLabel}
          </span>
          <p id="guidance-text" class="text-xs md:text-sm text-ink leading-relaxed">
            Immediately discontinue use of domestic LDPE zipper bags for vegetable cooking above 75°C. Upgrade to cast polypropylene (CPP/BOPA) retort vacuum bags or platinum-cured monolithic silicone pouches with a 5mm chamber impulse seal to eliminate seam peel creep and microplastic shedding.
          </p>
        </div>
      </div>

      <!-- Action Button -->
      <div class="mt-8 pt-6 border-t border-hairline flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="text-xs text-muted font-mono" id="compliance-summary">
          EU Regulation (EU) No 10/2011: NON-COMPLIANT (Migration exceeds 10 mg/dm²) &bull; ASTM F88 Creep Failure
        </div>
        <button
          type="button"
          id="copy-telemetry-btn"
          class="w-full sm:w-auto px-6 py-3 rounded-2xl bg-ink text-surface font-semibold text-xs transition-all hover:opacity-90 flex items-center justify-center gap-2 shadow-xs cursor-pointer"
        >
          <span>📋</span> {d.copyReportBtn}
        </button>
      </div>
    </div>
  </div>

  <!-- Comparative Engineering Table -->
  <div class="bg-surface border border-hairline rounded-3xl p-6 md:p-10 shadow-xs">
    <div class="mb-6">
      <div class="text-xs font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400 mb-1">
        ASTM F88 &bull; ISO 11357 &bull; EU 10/2011
      </div>
      <h3 class="text-xl md:text-2xl font-bold text-ink">
        {d.tableTitle}
      </h3>
      <p class="text-xs md:text-sm text-muted mt-1">
        {d.tableSub}
      </p>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-xs md:text-sm">
        <thead>
          <tr class="border-b border-hairline bg-surface-soft text-muted font-bold uppercase tracking-wider text-[11px]">
            <th class="p-4 rounded-tl-xl">{d.colMaterial}</th>
            <th class="p-4">{d.colSoftening}</th>
            <th class="p-4">{d.colMaxTemp}</th>
            <th class="p-4">{d.colPeelStrength}</th>
            <th class="p-4">{d.colMicroplastic}</th>
            <th class="p-4 rounded-tr-xl">{d.colCompliance}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline font-mono text-xs">
          {materials.map((m) => (
            <tr class="hover:bg-surface-soft/60 transition-colors">
              <td class="p-4 font-bold font-sans text-ink">{m.name}</td>
              <td class="p-4">{m.vicatSofteningPointC}°C</td>
              <td class="p-4">{m.maxSafeImmersionTempC}°C</td>
              <td class="p-4">{m.peelStrengthNM} N/m</td>
              <td class="p-4">{m.microplasticSheddingRate85C}</td>
              <td class="p-4 font-sans text-muted">{m.foodContactStandard}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- 4 Mandatory Safety Rules -->
  <div class="bg-surface border border-hairline rounded-3xl p-6 md:p-10 shadow-xs">
    <div class="mb-8">
      <div class="text-xs font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400 mb-1">
        Modernist Culinary Engineering Standard
      </div>
      <h3 class="text-xl md:text-2xl font-bold text-ink">
        {d.rulesTitle}
      </h3>
      <p class="text-xs md:text-sm text-muted mt-1">
        {d.rulesSub}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="p-5 rounded-2xl bg-surface-soft border border-hairline">
        <h4 class="text-sm font-bold text-ink mb-2">{d.rule1Title}</h4>
        <p class="text-xs text-muted leading-relaxed">{d.rule1Text}</p>
      </div>
      <div class="p-5 rounded-2xl bg-surface-soft border border-hairline">
        <h4 class="text-sm font-bold text-ink mb-2">{d.rule2Title}</h4>
        <p class="text-xs text-muted leading-relaxed">{d.rule2Text}</p>
      </div>
      <div class="p-5 rounded-2xl bg-surface-soft border border-hairline">
        <h4 class="text-sm font-bold text-ink mb-2">{d.rule3Title}</h4>
        <p class="text-xs text-muted leading-relaxed">{d.rule3Text}</p>
      </div>
      <div class="p-5 rounded-2xl bg-surface-soft border border-hairline">
        <h4 class="text-sm font-bold text-ink mb-2">{d.rule4Title}</h4>
        <p class="text-xs text-muted leading-relaxed">{d.rule4Text}</p>
      </div>
    </div>
  </div>
</div>

<!-- Reactive Client-Side Engine -->
<script define:vars={{ pouchData, feedbackMsg: d.copiedFeedback }}>
  document.addEventListener('DOMContentLoaded', () => {
    const materialSelect = document.getElementById('pouch-material-select');
    const tempRange = document.getElementById('bath-temp-range');
    const tempDisplay = document.getElementById('temp-display');
    const durationRange = document.getElementById('dwell-duration-range');
    const durationDisplay = document.getElementById('duration-display');
    const sealSelect = document.getElementById('seal-geometry-select');
    const matrixSelect = document.getElementById('food-matrix-select');

    const materialBadge = document.getElementById('material-badge');
    const sealBadge = document.getElementById('seal-badge');
    const matrixBadge = document.getElementById('matrix-badge');

    const telemetryVicat = document.getElementById('telemetry-vicat');
    const telemetryDelta = document.getElementById('telemetry-delta');
    const telemetryVapor = document.getElementById('telemetry-vapor');
    const telemetryPeelLoad = document.getElementById('telemetry-peelload');

    const statusTitle = document.getElementById('status-title');
    const statusBadge = document.getElementById('status-badge');
    const valCreepRisk = document.getElementById('val-creep-risk');
    const barCreepRisk = document.getElementById('bar-creep-risk');
    const valMicroplastics = document.getElementById('val-microplastics');
    const barMicroplastics = document.getElementById('bar-microplastics');
    const valMigration = document.getElementById('val-migration');
    const barMigration = document.getElementById('bar-migration');
    const valDegradation = document.getElementById('val-degradation');
    const barDegradation = document.getElementById('bar-degradation');
    const mechanismText = document.getElementById('mechanism-text');
    const guidanceText = document.getElementById('guidance-text');
    const complianceSummary = document.getElementById('compliance-summary');
    const copyBtn = document.getElementById('copy-telemetry-btn');
    const presetBtns = document.querySelectorAll('.preset-btn');

    if (!materialSelect || !tempRange || !durationRange || !sealSelect || !matrixSelect) return;

    function calculateDiagnostics() {
      const matId = materialSelect.value;
      const tempC = parseFloat(tempRange.value);
      const hours = parseFloat(durationRange.value);
      const sealId = sealSelect.value;
      const matrixId = matrixSelect.value;

      const mat = pouchData.pouchMaterials.find(m => m.id === matId) || pouchData.pouchMaterials[0];
      const seal = pouchData.sealGeometries.find(s => s.id === sealId) || pouchData.sealGeometries[0];
      const matrix = pouchData.foodMatrices.find(m => m.id === matrixId) || pouchData.foodMatrices[0];

      // Update text displays
      const tempF = Math.round((tempC * 9/5) + 32);
      tempDisplay.textContent = `${tempC}°C (${tempF}°F)`;
      durationDisplay.textContent = `${hours.toFixed(1)} Hours`;

      materialBadge.textContent = mat.name.split('(')[0].trim();
      sealBadge.textContent = seal.name.split('(')[0].trim();
      matrixBadge.textContent = matrix.name.split('(')[0].trim();

      // Vapor pressure formula (Antoine equation approx in kPa)
      const vaporPressure = (0.61078 * Math.exp((17.27 * tempC) / (tempC + 237.3))).toFixed(1);
      telemetryVicat.textContent = `${mat.vicatSofteningPointC}°C`;
      telemetryVapor.textContent = `${vaporPressure} kPa`;

      const deltaVicat = mat.vicatSofteningPointC - tempC;
      if (deltaVicat <= 0) {
        telemetryDelta.textContent = `${Math.abs(deltaVicat).toFixed(1)}°C (Softening Exceeded)`;
        telemetryDelta.className = 'font-bold text-red-600 dark:text-red-400';
      } else if (deltaVicat <= 10) {
        telemetryDelta.textContent = `${deltaVicat.toFixed(1)}°C (Near Softening)`;
        telemetryDelta.className = 'font-bold text-amber-600 dark:text-amber-400';
      } else {
        telemetryDelta.textContent = `+${deltaVicat.toFixed(1)}°C (Stable)`;
        telemetryDelta.className = 'font-bold text-emerald-600 dark:text-emerald-400';
      }

      // Peel load multiplier based on internal vapor pressure and duration
      const peelMultiplier = (Math.max(0.5, (tempC / 60)) * (1 + Math.log10(Math.max(1, hours))) * (1 / seal.sealIntegrityFactor)).toFixed(2);
      telemetryPeelLoad.textContent = `${peelMultiplier}x baseline`;

      // 1. Creep Rupture Risk Calculation
      let baseCreep = 0;
      if (mat.id === 'platinum_silicone') {
        baseCreep = 0.5;
      } else if (mat.id === 'boilable_pp_retort') {
        baseCreep = (tempC / 121) * 8 * (hours / 12) / seal.sealIntegrityFactor;
      } else if (mat.id === 'pa_pe_multilayer') {
        const thermalRatio = Math.max(0, (tempC - 60) / 30);
        baseCreep = (thermalRatio * 25 + (hours * 1.5)) * (1 / seal.sealIntegrityFactor) * (matrix.id === 'acidic_sauce' ? 1.5 : 1.0);
      } else if (mat.id === 'ldpe_ziploc') {
        const thermalRatio = Math.max(0.1, (tempC - 50) / 38);
        baseCreep = (Math.pow(thermalRatio, 2.2) * 55 + (hours * 6.5)) * (1 / seal.sealIntegrityFactor);
      } else if (mat.id === 'plasticized_pvc') {
        baseCreep = 85 + (tempC > 65 ? 15 : 5);
      }

      const creepRisk = Math.min(99, Math.max(1, Math.round(baseCreep)));
      valCreepRisk.textContent = `${creepRisk}%`;
      barCreepRisk.style.width = `${creepRisk}%`;

      // 2. Microplastic Shedding Density (particles/dm²)
      let baseShedding = 0;
      if (mat.id === 'platinum_silicone') {
        baseShedding = Math.round(15 + hours * 3);
      } else if (mat.id === 'boilable_pp_retort') {
        baseShedding = Math.round(1200 + (tempC - 50) * 45 * Math.sqrt(hours));
      } else if (mat.id === 'pa_pe_multilayer') {
        baseShedding = Math.round(6500 + Math.pow(Math.max(1, tempC - 55), 1.6) * 75 * Math.sqrt(hours));
      } else if (mat.id === 'ldpe_ziploc') {
        baseShedding = Math.round(25000 + Math.pow(Math.max(1, tempC - 50), 2.1) * 220 * Math.sqrt(hours));
      } else if (mat.id === 'plasticized_pvc') {
        baseShedding = Math.round(150000 + Math.pow(Math.max(1, tempC - 45), 2.3) * 650 * Math.sqrt(hours));
      }
      valMicroplastics.textContent = baseShedding.toLocaleString();
      const shedPercent = Math.min(100, Math.round((baseShedding / 400000) * 100));
      barMicroplastics.style.width = `${Math.max(4, shedPercent)}%`;

      // 3. Chemical / Oligomer Migration (mg/dm²)
      let baseMigration = 0;
      if (mat.id === 'platinum_silicone') {
        baseMigration = (0.1 + hours * 0.01).toFixed(2);
      } else if (mat.id === 'boilable_pp_retort') {
        baseMigration = (0.45 + (tempC / 90) * 0.4 * matrix.lipophilicMigrationMultiplier * Math.sqrt(hours / 4)).toFixed(2);
      } else if (mat.id === 'pa_pe_multilayer') {
        baseMigration = (1.8 + Math.max(0, (tempC - 60) / 25) * 3.2 * matrix.lipophilicMigrationMultiplier * Math.sqrt(hours / 4)).toFixed(1);
      } else if (mat.id === 'ldpe_ziploc') {
        baseMigration = (3.5 + Math.pow(Math.max(0.1, (tempC - 55) / 20), 1.8) * 6.5 * matrix.lipophilicMigrationMultiplier * Math.sqrt(hours / 2)).toFixed(1);
      } else if (mat.id === 'plasticized_pvc') {
        baseMigration = (18.0 + (tempC / 50) * 22.0 * matrix.lipophilicMigrationMultiplier * (hours / 4)).toFixed(1);
      }
      valMigration.textContent = `${baseMigration}`;
      const migPercent = Math.min(100, Math.round((parseFloat(baseMigration) / 30) * 100));
      barMigration.style.width = `${Math.max(5, migPercent)}%`;

      // 4. Degradation Index (0 - 100)
      let baseDegradation = 0;
      if (mat.id === 'platinum_silicone') {
        baseDegradation = 4;
      } else if (mat.id === 'boilable_pp_retort') {
        baseDegradation = Math.min(30, Math.round((tempC / 121) * 22 + (hours * 0.4)));
      } else if (mat.id === 'pa_pe_multilayer') {
        baseDegradation = Math.min(85, Math.round((tempC / 90) * 45 + (hours * 1.2) + (matrix.id === 'acidic_sauce' ? 12 : 0)));
      } else if (mat.id === 'ldpe_ziploc') {
        baseDegradation = Math.min(98, Math.round((tempC / 88) * 65 + (hours * 2.5) + (tempC > 85 ? 18 : 0)));
      } else if (mat.id === 'plasticized_pvc') {
        baseDegradation = 96;
      }
      valDegradation.textContent = `${baseDegradation} / 100`;
      barDegradation.style.width = `${baseDegradation}%`;

      // Color coding & safety status
      if (creepRisk > 75 || parseFloat(baseMigration) > 10.0 || mat.id === 'plasticized_pvc') {
        statusTitle.textContent = 'CRITICAL SEAL CREEP & CHEMICAL MIGRATION RISK';
        statusTitle.className = 'text-2xl font-black text-red-600 dark:text-red-400';
        statusBadge.textContent = '🚨 DANGER: NON-COMPLIANT';
        statusBadge.className = 'inline-flex items-center gap-2 px-4 py-2 rounded-2xl text-xs font-black uppercase tracking-wider bg-red-500/10 text-red-700 dark:text-red-400 border border-red-500/20';
        barCreepRisk.className = 'bg-red-500 h-full rounded-full transition-all duration-300';
        barMigration.className = 'bg-red-500 h-full rounded-full transition-all duration-300';
        barDegradation.className = 'bg-red-500 h-full rounded-full transition-all duration-300';
        complianceSummary.textContent = `EU 10/2011 Limit Exceeded: Migration is ${baseMigration} mg/dm² (Limit: 10.0 mg/dm²) • High Seam Rupture Risk`;
      } else if (creepRisk > 35 || parseFloat(baseMigration) > 5.0) {
        statusTitle.textContent = 'ELEVATED THERMAL CREEP & ADHESIVE VULNERABILITY';
        statusTitle.className = 'text-2xl font-black text-amber-600 dark:text-amber-400';
        statusBadge.textContent = '⚠️ CAUTION: MONITOR DWELL';
        statusBadge.className = 'inline-flex items-center gap-2 px-4 py-2 rounded-2xl text-xs font-black uppercase tracking-wider bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20';
        barCreepRisk.className = 'bg-amber-500 h-full rounded-full transition-all duration-300';
        barMigration.className = 'bg-amber-500 h-full rounded-full transition-all duration-300';
        barDegradation.className = 'bg-amber-500 h-full rounded-full transition-all duration-300';
        complianceSummary.textContent = `EU 10/2011 Borderline: Migration is ${baseMigration} mg/dm² • Prolonged dwell may degrade tie-layer`;
      } else {
        statusTitle.textContent = 'OPTIMAL STRUCTURAL INTEGRITY & FOOD-SAFE CONTACT';
        statusTitle.className = 'text-2xl font-black text-emerald-600 dark:text-emerald-400';
        statusBadge.textContent = '✅ CERTIFIED SAFE';
        statusBadge.className = 'inline-flex items-center gap-2 px-4 py-2 rounded-2xl text-xs font-black uppercase tracking-wider bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20';
        barCreepRisk.className = 'bg-emerald-500 h-full rounded-full transition-all duration-300';
        barMigration.className = 'bg-emerald-500 h-full rounded-full transition-all duration-300';
        barDegradation.className = 'bg-emerald-500 h-full rounded-full transition-all duration-300';
        complianceSummary.textContent = `EU 10/2011 & FDA Compliant: Migration is ${baseMigration} mg/dm² (Below 10.0 mg/dm² OML) • Zero Seam Creep`;
      }

      // Dynamic mechanisms
      if (mat.id === 'platinum_silicone') {
        mechanismText.textContent = `Platinum-cured cross-linked silicone consists of an inorganic siloxane (-Si-O-Si-) backbone with covalent bonds requiring over 450 kJ/mol to cleave. It experiences zero thermodynamic softening up to 200°C, zero seam creep, and leaves negligible chemical residues (<0.1 mg/kg) in water or dietary fats.`;
        guidanceText.textContent = `Platinum silicone is the premier reusable solution for high-heat root vegetable braising (85°C–92°C). Ensure an airtight pinch seal and clean with food-grade neutral detergent between uses.`;
      } else if (mat.id === 'boilable_pp_retort') {
        mechanismText.textContent = `Cast polypropylene (CPP) possesses a high degree of crystalline isotacticity with a melting point of 165°C and Vicat softening point of 135°C. At water bath temperatures of ${tempC}°C, the polymer chains remain in their glassy/semi-crystalline matrix, resisting hydrostatic steam pressure with near-zero microplastic shed.`;
        guidanceText.textContent = `High-barrier retort polypropylene bags are the industrial gold standard for high-temperature sous vide. Pair with standard 3mm or 5mm impulse seals for foolproof seal integrity during long root vegetable cycles.`;
      } else if (mat.id === 'pa_pe_multilayer') {
        mechanismText.textContent = `Multi-layer co-extruded PA/PE bags utilize biaxially oriented polyamide (Nylon 6) on the exterior for oxygen barrier strength and LLDPE on the interior for heat fusion. At ${tempC}°C for ${hours} hours, moisture permeability gradually plasticizes the polyurethane tie-layer adhesive, especially when cooking ${matrix.name.toLowerCase()}.`;
        guidanceText.textContent = `For temperatures below 80°C, PA/PE pouches are robust. For vegetable braises exceeding 85°C with durations over 8 hours, switch to retort CPP or dual 5mm chamber seals to prevent seam fatigue.`;
      } else if (mat.id === 'ldpe_ziploc') {
        mechanismText.textContent = `Standard low-density polyethylene (LDPE) has a low Vicat softening point of 88°C. At current bath temperature (${tempC}°C), the polymer enters its rubbery state. Hydrostatic pressure from vegetable outgassing (${vaporPressure} kPa) creates high peel stress on the ${seal.name.toLowerCase()}, resulting in high creep rupture probability (${creepRisk}%) and massive microplastic shed.`;
        guidanceText.textContent = `Cease using domestic LDPE zipper bags for cooking above 70°C. Upgrade immediately to retort polypropylene or platinum silicone bags to prevent seal rupture and microplastic ingestion.`;
      } else if (mat.id === 'plasticized_pvc') {
        mechanismText.textContent = `Plasticized PVC contains 20% to 35% low-molecular-weight phthalates (DEHP, DINP) that are not chemically bound to the polymer backbone. At elevated temperatures and in the presence of dietary lipids, plasticizers rapidly diffuse into food, causing severe endocrine disruption and massive microplastic fragmentation.`;
        guidanceText.textContent = `STRICTLY PROHIBITED: Never use plasticized PVC cling films or utility bags in sous vide cooking. Replace immediately with certified food-grade vacuum pouches complying with EU 10/2011.`;
      }
    }

    // Event listeners
    materialSelect.addEventListener('change', calculateDiagnostics);
    tempRange.addEventListener('input', calculateDiagnostics);
    durationRange.addEventListener('input', calculateDiagnostics);
    sealSelect.addEventListener('change', calculateDiagnostics);
    matrixSelect.addEventListener('change', calculateDiagnostics);

    // Preset handlers
    presetBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const presetKey = btn.getAttribute('data-preset');
        if (presetKey === 'vegetable_braise') {
          materialSelect.value = 'ldpe_ziploc';
          tempRange.value = '88';
          durationRange.value = '4.0';
          sealSelect.value = 'zipper_mechanical';
          matrixSelect.value = 'neutral_aqueous';
        } else if (presetKey === 'confit_chamber') {
          materialSelect.value = 'pa_pe_multilayer';
          tempRange.value = '82';
          durationRange.value = '24.0';
          sealSelect.value = 'dual_5mm';
          matrixSelect.value = 'fatty_lipid';
        } else if (presetKey === 'safe_silicone') {
          materialSelect.value = 'platinum_silicone';
          tempRange.value = '90';
          durationRange.value = '2.0';
          sealSelect.value = 'standard_3mm';
          matrixSelect.value = 'neutral_aqueous';
        } else if (presetKey === 'catastrophic_creep') {
          materialSelect.value = 'ldpe_ziploc';
          tempRange.value = '92';
          durationRange.value = '6.0';
          sealSelect.value = 'single_1mm';
          matrixSelect.value = 'acidic_sauce';
        }
        calculateDiagnostics();
      });
    });

    // Copy Telemetry
    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        const report = `=== SOUS VIDE POUCH SEAM DELAMINATION & MICROPLASTIC REPORT ===
Timestamp: ${new Date().toISOString()}
Pouch Material: ${materialSelect.options[materialSelect.selectedIndex].text}
Water Bath Temperature: ${tempRange.value}°C
Immersion Duration: ${durationRange.value} Hours
Seal Geometry: ${sealSelect.options[sealSelect.selectedIndex].text}
Food Matrix: ${matrixSelect.options[matrixSelect.selectedIndex].text}

DIAGNOSTIC OUTCOMES:
- Seam Creep Rupture Risk: ${valCreepRisk.textContent}
- Microplastic Shedding Density: ${valMicroplastics.textContent} particles/dm²
- Chemical & Oligomer Migration: ${valMigration.textContent} mg/dm² (EU Limit: 10.0 mg/dm²)
- Thermal Matrix Degradation Index: ${valDegradation.textContent}
- Safety Status: ${statusTitle.textContent} (${statusBadge.textContent})
- Compliance: ${complianceSummary.textContent}
- Corrective Protocol: ${guidanceText.textContent}
Source: IsItKitchenSafe Autonomous Growth & Ops Engine (v2.0)
================================================================`;

        navigator.clipboard.writeText(report).then(() => {
          const originalText = copyBtn.innerHTML;
          copyBtn.innerHTML = `<span>✅</span> ${feedbackMsg || 'Copied to Clipboard!'}`;
          setTimeout(() => {
            copyBtn.innerHTML = originalText;
          }, 2500);
        });
      });
    }

    // Initial calculation
    calculateDiagnostics();
  });
</script>
