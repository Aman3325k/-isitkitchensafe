---
import rawData from '../data/outdoor-grill-bbq-safety-data.json';
import type { SupportedLanguage } from '../i18n/ui';
import { useTranslatedPath } from '../i18n/utils';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;
const translatePath = useTranslatedPath(lang);

const fireEmergencyUrl = translatePath('/tools/kitchen-fire-emergency-guide/');
const meatThawingUrl = translatePath('/tools/meat-thawing-calculator/');
const internalTempUrl = translatePath('/tools/internal-cooking-temp-chart/');
const foodAllergyUrl = translatePath('/tools/food-allergy-cross-contact-checker/');
const methodologyUrl = translatePath('/methodology/');
const allToolsUrl = translatePath('/tools/');

const currentLocale = (['en', 'es', 'pt', 'zh-cn', 'ja'].includes(lang) ? lang : 'en') as 'en' | 'es' | 'pt' | 'zh-cn' | 'ja';

const bannerData = rawData.safetyBanner[currentLocale] || rawData.safetyBanner.en;

const localizedEquipment = rawData.equipmentTypes.map((eq: any) => ({
  id: eq.id,
  icon: eq.icon,
  fuel: eq.fuel,
  carbonMonoxideHazard: eq.carbonMonoxideHazard,
  flareUpHazard: eq.flareUpHazard,
  safeClearance: eq.safeClearance,
  name: eq.i18n[currentLocale]?.name || eq.i18n.en.name,
  description: eq.i18n[currentLocale]?.description || eq.i18n.en.description,
  safetyAlert: eq.i18n[currentLocale]?.safetyAlert || eq.i18n.en.safetyAlert,
  tankStorage: eq.i18n[currentLocale]?.tankStorage || eq.i18n.en.tankStorage
}));

const localizedBrushes = rawData.brushAlternatives.map((b: any) => ({
  id: b.id,
  safetyRating: b.safetyRating,
  ingestionRisk: b.ingestionRisk,
  icon: b.icon,
  name: b.i18n[currentLocale]?.name || b.i18n.en.name,
  pros: b.i18n[currentLocale]?.pros || b.i18n.en.pros,
  cons: b.i18n[currentLocale]?.cons || b.i18n.en.cons,
  medicalVerdict: b.i18n[currentLocale]?.medicalVerdict || b.i18n.en.medicalVerdict
}));

const localizedMeatTemps = rawData.meatTemps.map((m: any) => ({
  id: m.id,
  icon: m.icon,
  nameEn: m.nameEn,
  safeTempF: m.safeTempF,
  safeTempC: m.safeTempC,
  restMinutes: m.restMinutes,
  pathogenTarget: m.pathogenTarget,
  cut: m.i18n[currentLocale]?.cut || m.i18n.en.cut,
  guideline: m.i18n[currentLocale]?.guideline || m.i18n.en.guideline,
  dangerNote: m.i18n[currentLocale]?.dangerNote || m.i18n.en.dangerNote
}));

const localizedFaqs = rawData.faqs[currentLocale] || rawData.faqs.en;

const uiStrings: Record<'en' | 'es' | 'pt' | 'zh-cn' | 'ja', {
  tabEquipment: string;
  tabBrush: string;
