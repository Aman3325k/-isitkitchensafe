  .related-card h4 {
    font-size: 0.95rem;
    font-weight: 700;
    margin: 0 0 0.25rem 0;
    color: #0f172a;
  }
  .related-card p {
    font-size: 0.8rem;
    color: #64748b;
    margin: 0;
    line-height: 1.35;
  }

  @media (max-width: 640px) {
    .banner-title {
      font-size: 1.45rem;
    }
    .rules-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  function initGrillChecker() {
    // Tab switching
    const tabBtns = document.querySelectorAll('.tab-btn');
    const panels = document.querySelectorAll('.tab-panel');

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-tab');
        tabBtns.forEach(b => {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        panels.forEach(p => {
          p.classList.remove('active');
          p.setAttribute('hidden', '');
        });

        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');
        const activePanel = document.getElementById('panel-' + target);
        if (activePanel) {
          activePanel.classList.add('active');
          activePanel.removeAttribute('hidden');
        }
      });
    });

    // Temp unit toggle
    const unitBtns = document.querySelectorAll('.unit-btn');
    const tempDisplays = document.querySelectorAll('.temp-val-display');

    unitBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const unit = btn.getAttribute('data-unit');
        unitBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        tempDisplays.forEach(disp => {
          const f = disp.getAttribute('data-temp-f');
          const c = disp.getAttribute('data-temp-c');
          if (unit === 'c') {
            disp.textContent = c + '°C';
          } else {
            disp.textContent = f + '°F';
          }
        });
      });
    });

    // Checklist progress
    const checkboxes = document.querySelectorAll('.bbq-check');
    const counter = document.getElementById('checklist-counter');
    const bar = document.getElementById('checklist-bar');

    function updateProgress() {
      let checked = 0;
      checkboxes.forEach(cb => {
        if ((cb as HTMLInputElement).checked) checked++;
      });
      if (counter) counter.textContent = checked + ' / ' + checkboxes.length + ' Completed';
      if (bar) bar.style.width = ((checked / checkboxes.length) * 100) + '%';
    }

    checkboxes.forEach(cb => {
      cb.addEventListener('change', updateProgress);
    });

    // Copy Summary
    const copyBtn = document.getElementById('copy-summary-btn');
    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        const summary = [
          '🔥 IsItKitchenSafe BBQ & Grill Safety Protocol:',
          '1. Propane Leak Test: 50/50 soap and water tested; zero bubbles.',
          '2. Wire Brush Check: 100% wire-free (wood scraper/pumice used).',
          '3. Clearance: 10 ft (3m) away from structures & eaves; strictly outdoor.',
          '4. Grease Trap: Emptied to prevent explosive grease fireballs.',
          '5. Safe Internal Temps: Poultry 165°F (74°C), Burgers 160°F (71°C), Steaks 145°F (63°C) + 3m rest.',
          '6. Cross-Contamination: Separate raw/cooked platters; boil marinade 5m.',
          '7. Grease Fire: NEVER throw water! Close lid, turn off fuel, use baking soda.',
          'Verified via https://isitkitchensafe.com/tools/outdoor-grill-bbq-safety-checker/'
        ].join('\n');

        navigator.clipboard.writeText(summary).then(() => {
          const original = copyBtn.innerHTML;
          copyBtn.innerHTML = '<span>✅</span> Copied!';
          setTimeout(() => {
            copyBtn.innerHTML = original;
          }, 2500);
        });
      });
    }

    // Print Guide
    const printBtn = document.getElementById('print-guide-btn');
    if (printBtn) {
      printBtn.addEventListener('click', () => {
        window.print();
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGrillChecker);
  } else {
    initGrillChecker();
  }
</script>
