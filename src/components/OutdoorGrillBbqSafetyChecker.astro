const t = uiStrings[currentLocale];
---

<div class="grill-checker-wrapper">
  <!-- SAFETY BANNER (CDC/NFPA/USDA 4 RULES) -->
  <section class="banner-card" aria-label="BBQ Safety Rules">
    <div class="banner-header">
      <span class="banner-badge">{bannerData.badge}</span>
      <h2 class="banner-title">{bannerData.headline}</h2>
      <p class="banner-subline">{bannerData.subline}</p>
    </div>
    <div class="rules-grid">
      {bannerData.rules.map((rule: any) => (
        <div class="rule-box">
          <div class="rule-icon">{rule.icon}</div>
          <div class="rule-content">
            <h3 class="rule-title">{rule.title}</h3>
            <p class="rule-body">{rule.body}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- NAVIGATION TABS -->
  <div class="tab-nav" role="tablist">
    <button class="tab-btn active" data-tab="equipment" role="tab" aria-selected="true">
      <span class="tab-icon">🔥</span>
      <span class="tab-label">{t.tabEquipment}</span>
    </button>
    <button class="tab-btn" data-tab="brush" role="tab" aria-selected="false">
      <span class="tab-icon">⚠️</span>
      <span class="tab-label">{t.tabBrush}</span>
    </button>
    <button class="tab-btn" data-tab="temps" role="tab" aria-selected="false">
      <span class="tab-icon">🌡️</span>
      <span class="tab-label">{t.tabTemps}</span>
    </button>
    <button class="tab-btn" data-tab="checklist" role="tab" aria-selected="false">
      <span class="tab-icon">📋</span>
      <span class="tab-label">{t.tabChecklist}</span>
    </button>
  </div>

  <!-- TAB 1: EQUIPMENT TYPES -->
  <section id="panel-equipment" class="tab-panel active" role="tabpanel">
    <div class="panel-header">
      <h3>{t.selectGrill}</h3>
      <p class="panel-intro">Compare propane, charcoal, pellet, and flat-top setups for carbon monoxide clearances and flare-up protocols.</p>
