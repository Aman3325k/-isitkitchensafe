const t = dict[lang] || dict.en;
const itemLoc = ITEM_I18N[lang] || ITEM_I18N.en;
const jsI18n = JS_STATUS_I18N[lang] || JS_STATUS_I18N.en;

const localizedData = {
  ...defrostData,
  applianceModels: defrostData.applianceModels.map((m) => ({
    ...m,
    i18nName: itemLoc.modelNames[m.id] || m.name,
    i18nVuln: itemLoc.modelVulns[m.id] || m.failureVulnerability
  })),
  failureModes: defrostData.failureModes.map((f) => ({
    ...f,
    i18nName: itemLoc.failureNames[f.id] || f.name,
    i18nTraj: itemLoc.failureTrajs[f.id] || f.tempTrajectory
  })),
  foodTriageList: defrostData.foodTriageList.map((food) => ({
    ...food,
    i18nCategory: itemLoc.foodCats[food.id] || food.category,
    i18nItems: itemLoc.foodItems[food.id] || food.items,
    i18nRationale: itemLoc.foodRats[food.id] || food.rationale
  })),
  multimeterDiagnosticGuide: defrostData.multimeterDiagnosticGuide.map((g) => ({
    ...g,
    i18nComponent: itemLoc.guideComps[g.step] || g.component,
    i18nLocation: itemLoc.guideLocs[g.step] || g.location,
    i18nCondition: itemLoc.guideConds[g.step] || g.testCondition,
    i18nExpected: itemLoc.guideNorms[g.step] || g.expectedReading,
    i18nDefect: itemLoc.guideDefs[g.step] || g.failureIndication
  }))
};
---

<div id="refrigerator-defrost-simulator" data-lang={lang} class="refrigerator-defrost-simulator bg-slate-900 border border-slate-800 rounded-2xl p-6 sm:p-8 text-slate-100 shadow-2xl my-8">
  <!-- Header Badge -->
  <div class="flex flex-wrap items-center justify-between gap-3 mb-6 pb-6 border-b border-slate-800">
    <div class="flex items-center space-x-2">
      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-cyan-950 text-cyan-400 border border-cyan-800">
        <svg class="w-3.5 h-3.5 mr-1.5 animate-pulse text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
        </svg>
        {t.badge}
      </span>
    </div>
    <div class="text-xs text-slate-400 font-mono">
      USDA-FSIS &bull; FDA Food Code &bull; ASHRAE Handbook Standard
    </div>
  </div>

  <!-- Title & Subtitle -->
  <div class="mb-8">
    <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight mb-3">
      {t.title}
    </h2>
    <p class="text-slate-300 text-sm sm:text-base leading-relaxed max-w-4xl">
      {t.subtitle}
    </p>
  </div>

  <!-- Quick Presets -->
  <div class="mb-8 p-4 bg-slate-950/60 rounded-xl border border-slate-800/80">
    <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">
      ⚡ {t.presetsTitle}
    </label>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2">
      <button type="button" class="preset-btn text-left px-3 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs font-medium text-slate-200 transition border border-slate-700" data-preset="stealth">
        🧊 {t.presetStealth}
      </button>
      <button type="button" class="preset-btn text-left px-3 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs font-medium text-slate-200 transition border border-slate-700" data-preset="runaway">
        🔥 {t.presetRunaway}
      </button>
      <button type="button" class="preset-btn text-left px-3 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs font-medium text-slate-200 transition border border-slate-700" data-preset="timerStall">
        ⏳ {t.presetTimerStall}
      </button>
      <button type="button" class="preset-btn text-left px-3 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs font-medium text-slate-200 transition border border-slate-700" data-preset="frozenDrain">
        💧 {t.presetFrozenDrain}
      </button>
      <button type="button" class="preset-btn text-left px-3 py-2 rounded-lg bg-emerald-950/50 hover:bg-emerald-900/50 text-xs font-medium text-emerald-300 transition border border-emerald-800/80" data-preset="nominal">
        ✅ {t.presetNominal}
      </button>
    </div>
  </div>

  <!-- Controls Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
    <div class="space-y-5 bg-slate-950/40 p-5 rounded-xl border border-slate-800">
      <h3 class="text-sm font-bold text-cyan-300 uppercase tracking-wider flex items-center gap-2">
        <svg class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
        {t.controlsTitle}
      </h3>

      <!-- Model Select -->
      <div>
        <label for="model-select" class="block text-xs font-medium text-slate-300 mb-1.5">
          {t.modelLabel}
        </label>
        <select id="model-select" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2.5 text-xs sm:text-sm text-slate-100 focus:outline-none focus:border-cyan-500">
          {localizedData.applianceModels.map((m) => (
            <option value={m.id}>{m.i18nName}</option>
          ))}
        </select>
        <p id="model-desc" class="text-[11px] text-slate-400 mt-1 italic">
          {localizedData.applianceModels[0].i18nVuln}
        </p>
      </div>

      <!-- Failure Mode Select -->
      <div>
