    diagnosticSub: "冷鎖崩壊指数、細菌の倍加時間、耐熱性エンテロトキシン産生リスクをリアルタイムでシミュレーション。",
    overallStatusLabel: "コールドチェーン総合脅威レベル",
    statusSafe: "安全な正常運転領域 (40°F未満)",
    statusElevated: "軽度細菌増殖・品質劣化領域 (41°F–46°F)",
    statusHigh: "危険な対数増殖フェーズ (47°F–52°F)",
    statusCatastrophic: "耐熱毒素産生・全破棄クライシス (52°F超)",
    coldChainScoreLabel: "冷鎖健全性スコア",
    listeriaRiskLabel: "リステリア菌（Listeria）リスク",
    salmonellaRiskLabel: "サルモネラ / カンピロバクター増殖率",
    staphToxinLabel: "黄色ブドウ球菌 耐熱エンテロトキシン",
    cereusRiskLabel: "セレウス菌 嘔吐毒（米・パスタ）",
    shelfLifeLossLabel: "生鮮食品の賞味期限消失率",
    alertTitle: "食中毒病原体および耐熱毒素の緊急警告",
    alertStaphText: "50°F (10°C) 以上で4時間放置された食品は黄色ブドウ球菌毒素の深刻な危険があります。この毒素は耐熱性で30分の煮沸でも分解されず、再加熱しても無毒化できません。",
    alertListeriaText: "リステリア菌は好冷菌であり、40°F〜50°Fの低温でも増殖します。妊婦や新生児、高齢者において20〜30%の高い致死率があります。",
    alertInfantText: "調乳済み粉ミルクおよび母乳は、40°F以上で1時間以上経過した場合はクロノバクター感染防止のため即座に破棄してください。",
    alertCoilIceText: "エバポレーターフィンを覆う分厚い氷の塊は、除霜回路（バイメタル、ヒーター、タイマー）の故障を確実に示しています。コンプレッサーが回り続けても冷気は届きません。",
    triageTableTitle: "生鮮食品別 安全仕分け・トリアージマトリクス",
    triageTableSub: "USDA-FSIS および FDA 食品規定に準拠した、時間と温度に基づく食品廃棄・消費判断。",
    colCategory: "食品カテゴリ",
    colItems: "品目例",
    colSafeLimit: "40°F超の安全限界",
    colVerdict: "安全判定",
    colRationale: "微生物学的危険の根拠",
    troubleshootingTitle: "冷蔵庫除霜電気回路 テスター点検ガイド",
    troubleshootingSub: "デジタルマルチメーターを用いて故障部品を特定する4ステップ点検手順。",
    step1Title: "1. 冷凍室背面のエバポレーター霜付き状態を確認",
    step2Title: "2. バイメタルサーモスタットの導通テスト",
    step3Title: "3. 除霜カルロッドヒーターの抵抗値測定",
    step4Title: "4. 機械式デフロストタイマーの手動回転テスト",
    copyReportBtn: "食品損失・故障診断レポートをコピー",
    reportCopied: "レポートがクリップボードにコピーされました！",
    crossLinkTitle: "関連する熱力学・安全シミュレーターを見る",
    crossLinkSlowCooker: "スロークッカー釉薬溶出＆芽胞シミュレーター",
    crossLinkSousVide: "低温真空調理プラスチック溶出＆ボツリヌス菌モデラー",
    crossLinkPressureCooker: "圧力鍋・電気圧力鍋 破裂リスクシミュレーター"
  }
};

const t = dict[lang] || dict.en;
const data = defrostData;
---

<div class="refrigerator-defrost-simulator bg-slate-900 border border-slate-800 rounded-2xl p-6 sm:p-8 text-slate-100 shadow-2xl my-8">
  <!-- Header Badge -->
  <div class="flex flex-wrap items-center justify-between gap-3 mb-6 pb-6 border-b border-slate-800">
    <div class="flex items-center space-x-2">
      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-cyan-950 text-cyan-400 border border-cyan-800">
        <svg class="w-3.5 h-3.5 mr-1.5 animate-pulse text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
        </svg>
        {t.badge}
      </span>
    </div>
    <div class="text-xs text-slate-400 font-mono">
      USDA-FSIS &bull; FDA Food Code &bull; ASHRAE Handbook Standard
    </div>
  </div>

  <!-- Title & Subtitle -->
  <div class="mb-8">
    <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight mb-3">
      {t.title}
    </h2>
    <p class="text-slate-300 text-sm sm:text-base leading-relaxed max-w-4xl">
      {t.subtitle}
    </p>
  </div>

  <!-- Quick Presets -->
  <div class="mb-8 p-4 bg-slate-950/60 rounded-xl border border-slate-800/80">
    <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">
      ⚡ {t.presetsTitle}
    </label>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2">
      <button type="button" class="preset-btn text-left px-3 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs font-medium text-slate-200 transition border border-slate-700" data-preset="stealth">
        🧊 {t.presetStealth}
      </button>
      <button type="button" class="preset-btn text-left px-3 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs font-medium text-slate-200 transition border border-slate-700" data-preset="runaway">
        🔥 {t.presetRunaway}
      </button>
      <button type="button" class="preset-btn text-left px-3 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs font-medium text-slate-200 transition border border-slate-700" data-preset="timerStall">
        ⏳ {t.presetTimerStall}
      </button>
      <button type="button" class="preset-btn text-left px-3 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs font-medium text-slate-200 transition border border-slate-700" data-preset="frozenDrain">
        💧 {t.presetFrozenDrain}
      </button>
      <button type="button" class="preset-btn text-left px-3 py-2 rounded-lg bg-emerald-950/50 hover:bg-emerald-900/50 text-xs font-medium text-emerald-300 transition border border-emerald-800/80" data-preset="nominal">
        ✅ {t.presetNominal}
      </button>
    </div>
  </div>

  <!-- Controls Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
    <div class="space-y-5 bg-slate-950/40 p-5 rounded-xl border border-slate-800">
      <h3 class="text-sm font-bold text-cyan-300 uppercase tracking-wider flex items-center gap-2">
        <svg class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
        {t.controlsTitle}
      </h3>

      <!-- Model Select -->
      <div>
        <label for="model-select" class="block text-xs font-medium text-slate-300 mb-1.5">
          {t.modelLabel}
        </label>
        <select id="model-select" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2.5 text-xs sm:text-sm text-slate-100 focus:outline-none focus:border-cyan-500">
          {data.applianceModels.map((m) => (
            <option value={m.id}>{m.name}</option>
          ))}
        </select>
        <p id="model-desc" class="text-[11px] text-slate-400 mt-1 italic">
          {data.applianceModels[0].failureVulnerability}
        </p>
      </div>

      <!-- Failure Mode Select -->
      <div>
        <label for="failure-select" class="block text-xs font-medium text-slate-300 mb-1.5">
          {t.failureLabel}
        </label>
        <select id="failure-select" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2.5 text-xs sm:text-sm text-slate-100 focus:outline-none focus:border-cyan-500">
          {data.failureModes.map((f) => (
            <option value={f.id}>{f.name}</option>
          ))}
        </select>
        <p id="failure-desc" class="text-[11px] text-amber-400/90 mt-1">
          {data.failureModes[0].tempTrajectory}
        </p>
      </div>

      <!-- Food Select -->
      <div>
        <label for="food-select" class="block text-xs font-medium text-slate-300 mb-1.5">
          {t.foodLabel}
        </label>
        <select id="food-select" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2.5 text-xs sm:text-sm text-slate-100 focus:outline-none focus:border-cyan-500">
          {data.foodTriageList.map((food) => (
            <option value={food.id}>{food.category} ({food.items})</option>
          ))}
        </select>
      </div>
    </div>

    <!-- Sliders and Thermals -->
    <div class="space-y-5 bg-slate-950/40 p-5 rounded-xl border border-slate-800">
      <h3 class="text-sm font-bold text-cyan-300 uppercase tracking-wider flex items-center gap-2">
        <svg class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
        </svg>
        {t.controlsSub}
      </h3>

      <!-- Refrigerator Temperature Slider -->
      <div>
        <div class="flex justify-between items-center text-xs font-medium text-slate-300 mb-1.5">
          <span>{t.tempLabel}</span>
          <span id="temp-display" class="font-mono text-cyan-400 text-sm font-bold">52.0°F (11.1°C)</span>
        </div>
        <input
          id="temp-slider"
          type="range"
          min="34"
          max="75"
          step="0.5"
          value="52"
          class="w-full h-2 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-cyan-500"
        />
        <div class="flex justify-between text-[10px] text-slate-500 mt-1 font-mono">
          <span class="text-emerald-400">34°F (Optimal)</span>
          <span class="text-yellow-400">40°F (USDA Limit)</span>
          <span class="text-orange-400">50°F (Staph Limit)</span>
          <span class="text-red-400">75°F (Ambient)</span>
        </div>
      </div>

      <!-- Breach Duration Hours Slider -->
      <div>
        <div class="flex justify-between items-center text-xs font-medium text-slate-300 mb-1.5">
          <span>{t.hoursLabel}</span>
          <span id="hours-display" class="font-mono text-cyan-400 text-sm font-bold">8.0 hrs</span>
        </div>
        <input
          id="hours-slider"
          type="range"
          min="0"
          max="48"
          step="0.5"
          value="8"
          class="w-full h-2 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-cyan-500"
        />
        <div class="flex justify-between text-[10px] text-slate-500 mt-1 font-mono">
          <span>0 hrs</span>
          <span class="text-yellow-400">2 hrs (Max Perishables)</span>
          <span class="text-orange-400">4 hrs (Staph Toxin)</span>
          <span class="text-red-400">48 hrs</span>
        </div>
      </div>

      <!-- Ambient Kitchen Temperature -->
      <div>
        <div class="flex justify-between items-center text-xs font-medium text-slate-300 mb-1.5">
          <span>{t.ambientLabel}</span>
          <span id="ambient-display" class="font-mono text-cyan-400 text-sm font-bold">72°F (22.2°C)</span>
        </div>
        <input
          id="ambient-slider"
          type="range"
          min="60"
          max="95"
          step="1"
          value="72"
          class="w-full h-2 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-cyan-500"
        />
      </div>
    </div>
  </div>

  <!-- Primary Dynamic Diagnostic Card -->
  <div class="mb-8 p-6 bg-slate-950 rounded-xl border border-slate-800 relative overflow-hidden">
    <!-- Background Glow -->
    <div id="status-glow" class="absolute -right-20 -top-20 w-64 h-64 bg-yellow-500/10 rounded-full blur-3xl pointer-events-none transition-all duration-700"></div>

    <div class="relative z-10">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6 pb-6 border-b border-slate-800/80">
        <div>
          <span class="text-xs uppercase font-bold tracking-wider text-slate-400 block mb-1">
            {t.overallStatusLabel}
          </span>
          <div id="status-badge" class="text-lg sm:text-xl font-extrabold text-yellow-400 tracking-wide flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-yellow-400 animate-pulse"></span>
            {t.statusHigh}
          </div>
        </div>
        <div class="text-right">
          <span class="text-xs uppercase font-semibold text-slate-400 block mb-0.5">
            {t.coldChainScoreLabel}
          </span>
          <div class="flex items-baseline gap-1 justify-end">
            <span id="score-val" class="font-mono text-3xl sm:text-4xl font-extrabold text-yellow-400">28</span>
            <span class="text-slate-500 text-sm font-mono">/ 100</span>
          </div>
        </div>
      </div>

      <!-- Specific Alerts Banner -->
      <div id="critical-alert-box" class="mb-6 p-4 rounded-lg bg-red-950/60 border border-red-800/80 flex items-start gap-3">
        <svg class="w-5 h-5 text-red-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
        </svg>
        <div>
          <h4 id="alert-title" class="text-xs font-bold text-red-200 uppercase tracking-wide mb-1">
            {t.alertTitle}
          </h4>
          <p id="alert-text" class="text-xs text-red-300/90 leading-relaxed">
            {t.alertStaphText}
          </p>
        </div>
      </div>

      <!-- Metrics Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Listeria Metric -->
        <div class="p-4 bg-slate-900/80 rounded-lg border border-slate-800">
          <div class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider mb-1">
            {t.listeriaRiskLabel}
          </div>
          <div id="listeria-val" class="font-mono text-lg font-bold text-red-400">
            HIGH (6.2x Multiplier)
          </div>
          <div id="listeria-sub" class="text-[10px] text-slate-500 mt-1">
            Doubling every 4.8 hrs
          </div>
        </div>

        <!-- Salmonella Metric -->
        <div class="p-4 bg-slate-900/80 rounded-lg border border-slate-800">
          <div class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider mb-1">
            {t.salmonellaRiskLabel}
          </div>
          <div id="salmonella-val" class="font-mono text-lg font-bold text-red-400">
            RAPID LOG PHASE
          </div>
          <div id="salmonella-sub" class="text-[10px] text-slate-500 mt-1">
            Active replication above 41.5°F
          </div>
        </div>

        <!-- Staph Enterotoxin Metric -->
        <div class="p-4 bg-slate-900/80 rounded-lg border border-slate-800">
          <div class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider mb-1">
            {t.staphToxinLabel}
          </div>
          <div id="staph-val" class="font-mono text-lg font-bold text-orange-400">
            CRITICAL SYNTHESIS
          </div>
          <div id="staph-sub" class="text-[10px] text-slate-500 mt-1">
            >4 hrs above 50°F threshold breached
          </div>
        </div>

        <!-- Shelf Life Loss Metric -->
        <div class="p-4 bg-slate-900/80 rounded-lg border border-slate-800">
          <div class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider mb-1">
            {t.shelfLifeLossLabel}
          </div>
          <div id="shelflife-val" class="font-mono text-lg font-bold text-red-400">
            -85% LOSS
          </div>
          <div id="shelflife-sub" class="text-[10px] text-slate-500 mt-1">
            Quality & microbial half-life collapsed
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Itemized Food Inventory Triage Matrix -->
  <div class="mb-8">
    <div class="mb-4">
      <h3 class="text-base sm:text-lg font-bold text-white flex items-center gap-2">
        <svg class="w-5 h-5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
        </svg>
        {t.triageTableTitle}
      </h3>
      <p class="text-xs text-slate-400 mt-0.5">
        {t.triageTableSub}
      </p>
    </div>

    <div class="overflow-x-auto rounded-xl border border-slate-800 bg-slate-950/60">
      <table class="w-full text-left text-xs">
        <thead class="bg-slate-900/90 text-slate-300 font-semibold border-b border-slate-800">
          <tr>
            <th class="py-3 px-3 sm:px-4">{t.colCategory}</th>
            <th class="py-3 px-3 sm:px-4">{t.colItems}</th>
            <th class="py-3 px-3 sm:px-4 text-center">{t.colSafeLimit}</th>
            <th class="py-3 px-3 sm:px-4 text-center">{t.colVerdict}</th>
            <th class="py-3 px-3 sm:px-4">{t.colRationale}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800/60" id="triage-table-body">
          {data.foodTriageList.map((item) => (
            <tr class="hover:bg-slate-900/40 transition food-row" data-food-id={item.id} data-max-hours={item.maxSafeHoursAbove40F}>
              <td class="py-3 px-3 sm:px-4 font-bold text-slate-200">{item.category}</td>
              <td class="py-3 px-3 sm:px-4 text-slate-400">{item.items}</td>
              <td class="py-3 px-3 sm:px-4 text-center font-mono text-cyan-400">{item.maxSafeHoursAbove40F} hrs</td>
              <td class="py-3 px-3 sm:px-4 text-center">
                <span class="food-verdict-badge inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-red-950 text-red-400 border border-red-800">
                  {item.verdictAt4HoursAt48F}
                </span>
              </td>
              <td class="py-3 px-3 sm:px-4 text-slate-300 text-[11px]">{item.rationale}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Appliance Defrost Circuit Electrical Troubleshooting Guide -->
  <div class="mb-8 p-6 bg-slate-950 rounded-xl border border-slate-800">
    <div class="mb-5">
      <h3 class="text-base sm:text-lg font-bold text-white flex items-center gap-2">
        <svg class="w-5 h-5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
        </svg>
        {t.troubleshootingTitle}
      </h3>
      <p class="text-xs text-slate-400 mt-0.5">
        {t.troubleshootingSub}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {data.multimeterDiagnosticGuide.map((guide) => (
        <div class="p-4 bg-slate-900/90 rounded-lg border border-slate-800 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-bold text-cyan-400 uppercase tracking-wider">
                Step {guide.step}: {guide.component}
              </span>
              <span class="text-[10px] font-mono bg-slate-800 px-2 py-0.5 rounded text-slate-300">
                Multimeter Test
              </span>
            </div>
            <p class="text-xs text-slate-300 mb-2">
              <strong class="text-slate-100">Location:</strong> {guide.location}
            </p>
            <p class="text-xs text-slate-400 mb-2">
              <strong class="text-slate-300">Condition:</strong> {guide.testCondition}
            </p>
          </div>
          <div class="mt-3 pt-3 border-t border-slate-800 text-[11px]">
            <div class="text-emerald-400 font-medium mb-1">
              ✓ Normal: {guide.expectedReading}
            </div>
            <div class="text-red-400 font-medium">
              ✗ Defect: {guide.failureIndication}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Copyable Loss Report Button -->
  <div class="flex flex-wrap items-center justify-between gap-4 p-4 bg-slate-950/80 rounded-xl border border-slate-800 mb-8">
    <div class="text-xs text-slate-400">
      Need an itemized audit for landlord repairs, technician dispatch, or homeowners insurance food loss claim?
    </div>
    <button
      id="copy-report-btn"
      type="button"
      class="inline-flex items-center px-4 py-2.5 rounded-lg bg-cyan-600 hover:bg-cyan-500 text-white text-xs font-bold transition shadow-lg shadow-cyan-950"
    >
      <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/>
      </svg>
      {t.copyReportBtn}
    </button>
  </div>

  <!-- Cross-link Related Tools -->
  <div class="pt-6 border-t border-slate-800/80">
    <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3">
      {t.crossLinkTitle}
    </h4>
    <div class="flex flex-wrap gap-2 text-xs">
      <a href={lang === 'en' ? "/tools/slow-cooker-safety-simulator" : `/${lang}/tools/slow-cooker-safety-simulator`} class="px-3 py-1.5 rounded-lg bg-slate-800/80 hover:bg-slate-700 text-cyan-300 border border-slate-700/60 transition">
        🍲 {t.crossLinkSlowCooker} &rarr;
      </a>
      <a href={lang === 'en' ? "/tools/sous-vide-plastic-microbial-modeler" : `/${lang}/tools/sous-vide-plastic-microbial-modeler`} class="px-3 py-1.5 rounded-lg bg-slate-800/80 hover:bg-slate-700 text-cyan-300 border border-slate-700/60 transition">
        🥩 {t.crossLinkSousVide} &rarr;
      </a>
      <a href={lang === 'en' ? "/tools/pressure-cooker-instant-pot-safety-simulator" : `/${lang}/tools/pressure-cooker-instant-pot-safety-simulator`} class="px-3 py-1.5 rounded-lg bg-slate-800/80 hover:bg-slate-700 text-cyan-300 border border-slate-700/60 transition">
        ⚡ {t.crossLinkPressureCooker} &rarr;
      </a>
    </div>
  </div>
</div>

<script define:vars={{ data, t }}>
  document.addEventListener('DOMContentLoaded', () => {
    const modelSelect = document.getElementById('model-select');
    const failureSelect = document.getElementById('failure-select');
    const foodSelect = document.getElementById('food-select');
    const tempSlider = document.getElementById('temp-slider');
    const hoursSlider = document.getElementById('hours-slider');
    const ambientSlider = document.getElementById('ambient-slider');

    const tempDisplay = document.getElementById('temp-display');
    const hoursDisplay = document.getElementById('hours-display');
    const ambientDisplay = document.getElementById('ambient-display');
    const modelDesc = document.getElementById('model-desc');
    const failureDesc = document.getElementById('failure-desc');

    const statusBadge = document.getElementById('status-badge');
    const scoreVal = document.getElementById('score-val');
    const statusGlow = document.getElementById('status-glow');
    const alertTitle = document.getElementById('alert-title');
    const alertText = document.getElementById('alert-text');
    const criticalAlertBox = document.getElementById('critical-alert-box');

    const listeriaVal = document.getElementById('listeria-val');
    const listeriaSub = document.getElementById('listeria-sub');
    const salmonellaVal = document.getElementById('salmonella-val');
    const salmonellaSub = document.getElementById('salmonella-sub');
    const staphVal = document.getElementById('staph-val');
    const staphSub = document.getElementById('staph-sub');
    const shelflifeVal = document.getElementById('shelflife-val');
    const shelflifeSub = document.getElementById('shelflife-sub');

    const presetButtons = document.querySelectorAll('.preset-btn');
    const copyReportBtn = document.getElementById('copy-report-btn');
    const foodRows = document.querySelectorAll('.food-row');

    function calculateDiagnostics() {
      const tempF = parseFloat(tempSlider.value);
      const hours = parseFloat(hoursSlider.value);
      const ambientF = parseFloat(ambientSlider.value);
      const tempC = ((tempF - 32) * 5 / 9).toFixed(1);
      const ambientC = ((ambientF - 32) * 5 / 9).toFixed(1);

      // Display updates
      tempDisplay.textContent = `${tempF.toFixed(1)}°F (${tempC}°C)`;
      hoursDisplay.textContent = `${hours.toFixed(1)} hrs`;
      ambientDisplay.textContent = `${ambientF.toFixed(0)}°F (${ambientC}°C)`;

      // Model & Failure descriptions
      const selectedModel = data.applianceModels.find(m => m.id === modelSelect.value);
      if (selectedModel && modelDesc) {
        modelDesc.textContent = selectedModel.failureVulnerability;
      }
      const selectedFailure = data.failureModes.find(f => f.id === failureSelect.value);
      if (selectedFailure && failureDesc) {
        failureDesc.textContent = selectedFailure.tempTrajectory;
      }

      // Cold Chain Integrity Score (100 = perfect, 0 = ruined)
      let score = 100;
      if (tempF > 40) {
        const excessTemp = tempF - 40;
        // Exponential penalty based on temp and duration
        const penalty = Math.min(100, (excessTemp * 2.8) + (hours * excessTemp * 0.45));
        score = Math.max(0, Math.round(100 - penalty));
      } else {
        // Temperature safe, minimal penalty
        score = Math.max(90, 100 - Math.round(hours * 0.2));
      }
      scoreVal.textContent = score;

      // Status Level Determination
      if (tempF <= 40.0) {
        statusBadge.innerHTML = `<span class="w-3 h-3 rounded-full bg-emerald-400"></span> ${t.statusSafe}`;
        statusBadge.className = 'text-lg sm:text-xl font-extrabold text-emerald-400 tracking-wide flex items-center gap-2';
        scoreVal.className = 'font-mono text-3xl sm:text-4xl font-extrabold text-emerald-400';
        statusGlow.className = 'absolute -right-20 -top-20 w-64 h-64 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none transition-all duration-700';
        criticalAlertBox.className = 'hidden';
      } else if (tempF <= 46.0 && hours <= 4.0) {
        statusBadge.innerHTML = `<span class="w-3 h-3 rounded-full bg-yellow-400"></span> ${t.statusElevated}`;
        statusBadge.className = 'text-lg sm:text-xl font-extrabold text-yellow-400 tracking-wide flex items-center gap-2';
        scoreVal.className = 'font-mono text-3xl sm:text-4xl font-extrabold text-yellow-400';
        statusGlow.className = 'absolute -right-20 -top-20 w-64 h-64 bg-yellow-500/10 rounded-full blur-3xl pointer-events-none transition-all duration-700';
        criticalAlertBox.className = 'mb-6 p-4 rounded-lg bg-yellow-950/60 border border-yellow-800/80 flex items-start gap-3';
        alertTitle.textContent = "MODERATE PERISHABLE SPOILAGE WARNING";
        alertText.textContent = "Temperatures between 41°F and 46°F accelerate milk souring and raw meat bacterial proliferation. Consume or cook immediately within 2 hours.";
      } else if (tempF <= 52.0 && hours <= 6.0) {
        statusBadge.innerHTML = `<span class="w-3 h-3 rounded-full bg-orange-400 animate-pulse"></span> ${t.statusHigh}`;
        statusBadge.className = 'text-lg sm:text-xl font-extrabold text-orange-400 tracking-wide flex items-center gap-2';
        scoreVal.className = 'font-mono text-3xl sm:text-4xl font-extrabold text-orange-400';
        statusGlow.className = 'absolute -right-20 -top-20 w-64 h-64 bg-orange-500/10 rounded-full blur-3xl pointer-events-none transition-all duration-700';
        criticalAlertBox.className = 'mb-6 p-4 rounded-lg bg-orange-950/60 border border-orange-800/80 flex items-start gap-3';
        alertTitle.textContent = "DANGEROUS PATHOGEN MULTIPLICATION DETECTED";
        alertText.textContent = t.alertListeriaText;
      } else {
        statusBadge.innerHTML = `<span class="w-3 h-3 rounded-full bg-red-500 animate-pulse"></span> ${t.statusCatastrophic}`;
        statusBadge.className = 'text-lg sm:text-xl font-extrabold text-red-500 tracking-wide flex items-center gap-2';
        scoreVal.className = 'font-mono text-3xl sm:text-4xl font-extrabold text-red-500';
        statusGlow.className = 'absolute -right-20 -top-20 w-64 h-64 bg-red-600/20 rounded-full blur-3xl pointer-events-none transition-all duration-700';
        criticalAlertBox.className = 'mb-6 p-4 rounded-lg bg-red-950/80 border border-red-700 flex items-start gap-3';
        alertTitle.textContent = t.alertTitle;
        alertText.textContent = t.alertStaphText;
      }

      // Listeria Kinetics
      if (tempF <= 40.0) {
        listeriaVal.textContent = "NEGLIGIBLE";
        listeriaVal.className = "font-mono text-lg font-bold text-emerald-400";
        listeriaSub.textContent = "Doubling requires >32 hours";
      } else if (tempF <= 46.0) {
        listeriaVal.textContent = "ELEVATED (2.5x)";
        listeriaVal.className = "font-mono text-lg font-bold text-yellow-400";
        listeriaSub.textContent = `Doubling in ~12 hrs; ${hours} hrs exposure`;
      } else {
        const fold = Math.min(48, Math.round(Math.pow(1.6, (tempF - 40) / 3)));
        listeriaVal.textContent = `CRITICAL (${fold}x Multiplier)`;
        listeriaVal.className = "font-mono text-lg font-bold text-red-400";
        listeriaSub.textContent = "Psychrotrophic exponential expansion";
      }

      // Salmonella Kinetics
      if (tempF <= 41.5) {
        salmonellaVal.textContent = "DORMANT (INHIBITED)";
        salmonellaVal.className = "font-mono text-lg font-bold text-emerald-400";
        salmonellaSub.textContent = "Replication halted below 41.5°F";
      } else if (tempF <= 48.0) {
        salmonellaVal.textContent = "ACTIVE SLOW LOG";
        salmonellaVal.className = "font-mono text-lg font-bold text-yellow-400";
        salmonellaSub.textContent = "Generation time ~6-8 hours";
      } else {
        salmonellaVal.textContent = "RAPID LOG PHASE";
        salmonellaVal.className = "font-mono text-lg font-bold text-red-400";
        salmonellaSub.textContent = "Doubling every 90-120 minutes";
      }

      // Staph Enterotoxin Kinetics
      if (tempF < 50.0) {
        staphVal.textContent = "ZERO TOXIN";
        staphVal.className = "font-mono text-lg font-bold text-emerald-400";
        staphSub.textContent = "Toxin synthesis suppressed below 50°F";
      } else if (hours < 4.0) {
        staphVal.textContent = "PRE-TOXIN LAG";
        staphVal.className = "font-mono text-lg font-bold text-yellow-400";
        staphSub.textContent = `${(4 - hours).toFixed(1)} hrs until toxin threshold`;
      } else {
        staphVal.textContent = "CRITICAL SYNTHESIS";
        staphVal.className = "font-mono text-lg font-bold text-red-500 animate-pulse";
        staphSub.textContent = "Heat-stable enterotoxin present (Do not eat)";
      }

      // Shelf-Life Loss
      let lossPct = 0;
      if (tempF <= 40.0) {
        lossPct = Math.min(10, Math.round(hours * 0.2));
      } else {
        lossPct = Math.min(100, Math.round((tempF - 40) * 2.5 + hours * 3.5));
      }
      shelflifeVal.textContent = `-${lossPct}% LOSS`;
      shelflifeVal.className = lossPct < 25 ? "font-mono text-lg font-bold text-emerald-400" : lossPct < 60 ? "font-mono text-lg font-bold text-yellow-400" : "font-mono text-lg font-bold text-red-400";
      shelflifeSub.textContent = lossPct >= 100 ? "Complete microbiological discard" : "Accelerated proteolytic rancidity";

      // Update Triage Table Rows
      foodRows.forEach((row) => {
        const maxHours = parseFloat(row.getAttribute('data-max-hours'));
        const verdictBadge = row.querySelector('.food-verdict-badge');
        if (!verdictBadge) return;

        if (tempF <= 40.0) {
          verdictBadge.textContent = "SAFE TO KEEP";
          verdictBadge.className = "food-verdict-badge inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-950 text-emerald-400 border border-emerald-800";
        } else if (hours <= maxHours) {
          if (maxHours <= 2.0 && tempF > 46.0) {
            verdictBadge.textContent = "COOK IMMEDIATELY (>165°F)";
            verdictBadge.className = "food-verdict-badge inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-yellow-950 text-yellow-400 border border-yellow-800";
          } else {
            verdictBadge.textContent = "SAFE TO KEEP";
            verdictBadge.className = "food-verdict-badge inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-950 text-emerald-400 border border-emerald-800";
          }
        } else {
          verdictBadge.textContent = "DISCARD IMMEDIATELY";
          verdictBadge.className = "food-verdict-badge inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-red-950 text-red-400 border border-red-800";
        }
      });
    }

    // Preset Handlers
    presetButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const preset = btn.getAttribute('data-preset');
        if (preset === 'stealth') {
          modelSelect.value = 'top-freezer-traditional';
          failureSelect.value = 'bimetal-open-iced-coils';
          tempSlider.value = 52;
          hoursSlider.value = 8;
          ambientSlider.value = 72;
        } else if (preset === 'runaway') {
          modelSelect.value = 'french-door-bottom-freezer';
          failureSelect.value = 'bimetal-welded-heater-runaway';
          tempSlider.value = 58;
          hoursSlider.value = 4;
          ambientSlider.value = 75;
        } else if (preset === 'timerStall') {
          modelSelect.value = 'top-freezer-traditional';
          failureSelect.value = 'timer-motor-burnt-out';
          tempSlider.value = 72;
          hoursSlider.value = 14;
          ambientSlider.value = 74;
        } else if (preset === 'frozenDrain') {
          modelSelect.value = 'french-door-bottom-freezer';
          failureSelect.value = 'drain-tube-frozen-clogged';
          tempSlider.value = 39;
          hoursSlider.value = 24;
          ambientSlider.value = 70;
        } else if (preset === 'nominal') {
          modelSelect.value = 'french-door-bottom-freezer';
          failureSelect.value = 'drain-tube-frozen-clogged';
          tempSlider.value = 37;
          hoursSlider.value = 0;
          ambientSlider.value = 70;
        }
        calculateDiagnostics();
      });
    });

    // Copy Report Generator
    copyReportBtn.addEventListener('click', () => {
      const tempF = parseFloat(tempSlider.value);
      const hours = parseFloat(hoursSlider.value);
      const model = modelSelect.options[modelSelect.selectedIndex].text;
      const failure = failureSelect.options[failureSelect.selectedIndex].text;

      const report = `=====================================================
ISITKITCHENSAFE COLD CHAIN & DEFROST DIAGNOSTIC REPORT
Generated: ${new Date().toISOString()}
Standard: USDA-FSIS & FDA Food Code § 3-501.16 Compliance
=====================================================

1. APPLIANCE & FAILURE TELEMETRY:
   - Model / Configuration: ${model}
   - Diagnostic Failure Mode: ${failure}
   - Measured Fridge Temp: ${tempF.toFixed(1)}°F (${((tempF - 32) * 5 / 9).toFixed(1)}°C)
   - Cold Chain Breach Duration: ${hours.toFixed(1)} hours above 40°F
   - Cold Chain Integrity Score: ${scoreVal.textContent} / 100

2. MICROBIOLOGICAL PATHOGEN THREAT ASSESSMENT:
   - Listeria monocytogenes: ${listeriaVal.textContent} (${listeriaSub.textContent})
   - Salmonella / Campylobacter: ${salmonellaVal.textContent} (${salmonellaSub.textContent})
   - Staphylococcus aureus Enterotoxin: ${staphVal.textContent} (${staphSub.textContent})
   - Perishable Shelf Life Loss: ${shelflifeVal.textContent}

3. PRIMARY CLINICAL / SANITARY VERDICT:
   - ${statusBadge.textContent.trim()}
   - USDA Rule: Any perishable food held >40°F for >2 hours (or >50°F for >1 hour) must be discarded.
   - Heat Warning: Staph enterotoxins are heat-stable and cannot be eliminated by cooking.

4. MULTIMETER REPAIR DIRECTIVES:
   - Test bi-metal thermostat while frosty (<20°F): Normal = 0.0 Ω (closed); Defect = O.L. (open)
   - Test defrost heater: Normal = 15 to 35 Ω; Defect = O.L. (burned calrod)
   - Check mechanical timer: Turn manual advance notch until loud click; motor should advance in 25-35 min.

Verify full diagnostic tools at: https://isitkitchensafe.com/tools/refrigerator-defrost-safety-modeler
=====================================================`;

      navigator.clipboard.writeText(report).then(() => {
        const originalText = copyReportBtn.innerHTML;
        copyReportBtn.innerHTML = `✓ ${t.reportCopied}`;
        copyReportBtn.classList.remove('bg-cyan-600', 'hover:bg-cyan-500');
        copyReportBtn.classList.add('bg-emerald-600', 'hover:bg-emerald-500');
        setTimeout(() => {
          copyReportBtn.innerHTML = originalText;
          copyReportBtn.classList.remove('bg-emerald-600', 'hover:bg-emerald-500');
          copyReportBtn.classList.add('bg-cyan-600', 'hover:bg-cyan-500');
        }, 3000);
      });
    });

    // Event listeners
    tempSlider.addEventListener('input', calculateDiagnostics);
    hoursSlider.addEventListener('input', calculateDiagnostics);
    ambientSlider.addEventListener('input', calculateDiagnostics);
    modelSelect.addEventListener('change', calculateDiagnostics);
    failureSelect.addEventListener('change', calculateDiagnostics);
    foodSelect.addEventListener('change', calculateDiagnostics);

    // Initial run
    calculateDiagnostics();
  });
</script>
