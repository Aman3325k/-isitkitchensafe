        </div>
        <input 
          type="range" 
          id="speed-slider" 
          min="1" 
          max="2" 
          step="1" 
          value="2"
          class="w-full accent-amber-600"
        />
        <span class="block text-[10px] text-muted mt-0.5">{d.speedSliderHelp}</span>
      </div>

      <!-- Ambient Room Temp -->
      <div>
        <div class="flex items-center justify-between text-xs font-bold text-ink mb-1">
          <span>{d.ambientSliderLabel.split(' (')[0]}</span>
