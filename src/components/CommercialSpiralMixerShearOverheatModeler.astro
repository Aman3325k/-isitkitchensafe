        <input 
          type="range" 
          id="ambient-slider" 
          min="16" 
          max="38" 
          step="1" 
          value="24"
          class="w-full accent-amber-600"
        />
        <span class="block text-[10px] text-muted mt-0.5">{d.ambientSliderHelp}</span>
