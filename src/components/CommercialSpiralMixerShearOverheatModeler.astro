const d = DICTIONARY[lang] || DICTIONARY.en;
---

<div class="my-8 p-6 sm:p-8 rounded-3xl bg-surface-soft border border-hairline shadow-sm">
  <!-- Header -->
  <div class="mb-6">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-600 text-white mb-3">
      {d.badge}
    </div>
    <h2 class="text-2xl sm:text-3xl font-bold text-ink tracking-tight mb-2">
      {d.title}
    </h2>
    <p class="text-sm sm:text-base text-muted leading-relaxed">
      {d.subtitle}
    </p>
  </div>

  <!-- Quick Presets -->
  <div class="mb-8 p-4 rounded-2xl bg-surface border border-hairline">
    <span class="text-xs font-bold text-ink uppercase tracking-wider block mb-2">{d.presetsTitle}</span>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2">
      <button type="button" id="preset-compliant" class="px-3 py-2 text-xs font-medium rounded-xl bg-surface-soft hover:bg-amber-600/10 hover:text-amber-700 dark:hover:text-amber-400 border border-hairline transition-colors text-left">
        🛡️ {d.presetCompliant}
      </button>
      <button type="button" id="preset-overheat" class="px-3 py-2 text-xs font-medium rounded-xl bg-surface-soft hover:bg-amber-600/10 hover:text-amber-700 dark:hover:text-amber-400 border border-hairline transition-colors text-left">
        🔥 {d.presetOverheat}
      </button>
      <button type="button" id="preset-gearshear" class="px-3 py-2 text-xs font-medium rounded-xl bg-surface-soft hover:bg-amber-600/10 hover:text-amber-700 dark:hover:text-amber-400 border border-hairline transition-colors text-left">
        ⚙️ {d.presetGearShear}
      </button>
      <button type="button" id="preset-bypassed" class="px-3 py-2 text-xs font-medium rounded-xl bg-surface-soft hover:bg-amber-600/10 hover:text-amber-700 dark:hover:text-amber-400 border border-hairline transition-colors text-left">
        🚨 {d.presetBypassedGuard}
      </button>
    </div>
  </div>

  <!-- Primary Control Grid -->
  <div class="mb-8">
    <h3 class="text-lg font-bold text-ink mb-1">{d.controlsTitle}</h3>
    <p class="text-xs text-muted mb-4">{d.controlsSub}</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-5">
      <!-- Mixer Config -->
      <div>
        <label for="mixer-select" class="block text-xs font-bold text-ink mb-1">
          {d.mixerLabel}
        </label>
        <select id="mixer-select" class="w-full text-xs p-2.5 rounded-xl bg-surface border border-hairline text-ink focus:outline-none focus:ring-2 focus:ring-amber-500">
          {mixerData.mixerConfigurations.map((m) => (
            <option value={m.id}>{m.name}</option>
          ))}
        </select>
        <span class="block text-[11px] text-muted mt-1 leading-tight">{d.mixerHelp}</span>
      </div>

      <!-- Dough Formulation -->
      <div>
        <label for="dough-select" class="block text-xs font-bold text-ink mb-1">
          {d.doughLabel}
        </label>
        <select id="dough-select" class="w-full text-xs p-2.5 rounded-xl bg-surface border border-hairline text-ink focus:outline-none focus:ring-2 focus:ring-amber-500">
          {mixerData.doughTypes.map((dt) => (
            <option value={dt.id}>{dt.name}</option>
          ))}
        </select>
        <span class="block text-[11px] text-muted mt-1 leading-tight">{d.doughHelp}</span>
      </div>

      <!-- Safety Guard & Interlock -->
      <div>
        <label for="guard-select" class="block text-xs font-bold text-ink mb-1">
          {d.guardLabel}
        </label>
        <select id="guard-select" class="w-full text-xs p-2.5 rounded-xl bg-surface border border-hairline text-ink focus:outline-none focus:ring-2 focus:ring-amber-500">
          {mixerData.safetyGuardsAndInterlocks.map((g) => (
            <option value={g.id}>{g.name}</option>
          ))}
        </select>
        <span class="block text-[11px] text-muted mt-1 leading-tight">{d.guardHelp}</span>
      </div>

      <!-- Lubricant Selection -->
      <div>
        <label for="lubricant-select" class="block text-xs font-bold text-ink mb-1">
          {d.lubricantLabel}
        </label>
        <select id="lubricant-select" class="w-full text-xs p-2.5 rounded-xl bg-surface border border-hairline text-ink focus:outline-none focus:ring-2 focus:ring-amber-500">
          {mixerData.gearboxLubricants.map((l) => (
            <option value={l.id}>{l.name}</option>
          ))}
        </select>
        <span class="block text-[11px] text-muted mt-1 leading-tight">{d.lubricantHelp}</span>
      </div>
    </div>

    <!-- Sliders Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 p-4 rounded-2xl bg-surface border border-hairline">
      <!-- Flour Weight Slider -->
      <div>
        <div class="flex items-center justify-between text-xs font-bold text-ink mb-1">
          <span>{d.flourSliderLabel.split(' (')[0]}</span>
          <span id="flour-display" class="font-mono text-amber-600 dark:text-amber-400">75 kg</span>
        </div>
        <input 
          type="range" 
          id="flour-slider" 
          min="15" 
          max="160" 
          step="5" 
          value="75"
          class="w-full accent-amber-600"
        />
        <span class="block text-[10px] text-muted mt-0.5">{d.flourSliderHelp}</span>
      </div>

      <!-- Speed Mode Slider -->
      <div>
        <div class="flex items-center justify-between text-xs font-bold text-ink mb-1">
          <span>{d.speedSliderLabel.split(' (')[0]}</span>
