</div>

<script define:vars={{ mixerData, lang }}>
  (function () {
    const mixerSelect = document.getElementById('mixer-select');
    const doughSelect = document.getElementById('dough-select');
    const guardSelect = document.getElementById('guard-select');
    const lubricantSelect = document.getElementById('lubricant-select');

    const flourSlider = document.getElementById('flour-slider');
    const speedSlider = document.getElementById('speed-slider');
    const ambientSlider = document.getElementById('ambient-slider');
    const waterSlider = document.getElementById('water-slider');
    const durationSlider = document.getElementById('duration-slider');

    const flourDisplay = document.getElementById('flour-display');
    const speedDisplay = document.getElementById('speed-display');
    const ambientDisplay = document.getElementById('ambient-display');
    const waterDisplay = document.getElementById('water-display');
    const durationDisplay = document.getElementById('duration-display');

    const complianceBadge = document.getElementById('compliance-badge');
    const gearStressOut = document.getElementById('gear-stress-out');
    const gearSafetyOut = document.getElementById('gear-safety-out');
    const doughTempOut = document.getElementById('dough-temp-out');
    const doughFOut = document.getElementById('dough-f-out');
    const frictionRiseOut = document.getElementById('friction-rise-out');
    const viscousPowerOut = document.getElementById('viscous-power-out');
    const waterTargetOut = document.getElementById('water-target-out');
    const iceFractionOut = document.getElementById('ice-fraction-out');
    const motorThermalOut = document.getElementById('motor-thermal-out');
    const motorInsulationOut = document.getElementById('motor-insulation-out');
    const interlockDriftOut = document.getElementById('interlock-drift-out');
    const falseTripOut = document.getElementById('false-trip-out');
    const lubricantStatusOut = document.getElementById('lubricant-status-out');
    const fdaComplianceOut = document.getElementById('fda-compliance-out');
    const statusSummaryOut = document.getElementById('status-summary-out');
    const safetyStandardOut = document.getElementById('safety-standard-out');

    const primaryRiskText = document.getElementById('primary-risk-text');
    const mechanismsText = document.getElementById('mechanisms-text');
    const mitigationText = document.getElementById('mitigation-text');

    const copyBtn = document.getElementById('copy-report-btn');
    const copyBtnText = document.getElementById('copy-btn-text');

    function calculateDiagnostics() {
      const mixerId = mixerSelect.value;
      const doughId = doughSelect.value;
      const guardId = guardSelect.value;
      const lubricantId = lubricantSelect.value;

      const flourKg = parseFloat(flourSlider.value);
      const speedMode = parseInt(speedSlider.value, 10);
      const ambientC = parseFloat(ambientSlider.value);
      const waterC = parseFloat(waterSlider.value);
      const durationMin = parseFloat(durationSlider.value);

      const mixer = mixerData.mixerConfigurations.find(m => m.id === mixerId) || mixerData.mixerConfigurations[0];
      const dough = mixerData.doughTypes.find(d => d.id === doughId) || mixerData.doughTypes[0];
      const guard = mixerData.safetyGuardsAndInterlocks.find(g => g.id === guardId) || mixerData.safetyGuardsAndInterlocks[0];
      const lubricant = mixerData.gearboxLubricants.find(l => l.id === lubricantId) || mixerData.gearboxLubricants[0];

      // Update Slider Displays
      const flourLbs = (flourKg * 2.20462).toFixed(0);
      flourDisplay.textContent = `${flourKg} kg (${flourLbs} lbs)`;
      
      const speedRpm = speedMode === 1 ? mixer.spiralSpeed1Rpm : mixer.spiralSpeed2Rpm;
      speedDisplay.textContent = speedMode === 1 ? `Speed 1 (${speedRpm} RPM)` : `Speed 2 (${speedRpm} RPM)`;

      const ambientF = ((ambientC * 9/5) + 32).toFixed(0);
      ambientDisplay.textContent = `${ambientC}°C / ${ambientF}°F`;

      const waterF = ((waterC * 9/5) + 32).toFixed(0);
      waterDisplay.textContent = `${waterC}°C / ${waterF}°F`;

      durationDisplay.textContent = `${durationMin} min`;

      // 1. Total Dough Mass Calculation
      const totalDoughKg = flourKg * (1 + (dough.hydrationPercent / 100) + 0.04); // flour + water + salt/yeast
      const capacityRatio = flourKg / mixer.flourCapacityKg;

      // 2. Viscous Shear Torque & AGMA Gear Tooth Bending Stress
      // Stiffer dough (higher viscosity index) generates higher torque
      const speedMultiplier = speedMode === 1 ? 0.65 : 1.25;
      const torqueEstimatedNm = (totalDoughKg * 14.5 * dough.viscosityIndex * speedMultiplier) * (capacityRatio > 1 ? Math.pow(capacityRatio, 1.3) : capacityRatio);
      
      // AGMA Bending Stress: sigma = (F_t * K_o * K_v * K_s) / (b * m * J)
      const gearBaseCapacity = mixer.maxTorqueNm;
      const overloadFactor = torqueEstimatedNm / gearBaseCapacity;
      let nominalToothStressMpa = 140 * overloadFactor * (mixer.beltDrive ? 0.88 : 1.12);
      if (lubricant.foodGradeCertified === false && lubricant.shearStability === 'Depleted') {
        nominalToothStressMpa *= 1.35; // lack of lubricity increases tooth impact
      }
      const agmaSafetyFactor = (320 / nominalToothStressMpa).toFixed(2);

      // 3. Viscous Dissipation & Dough Friction Rise (ΔT)
      // Viscous power P = T * omega (W)
      const omegaRadS = (speedRpm * 2 * Math.PI) / 60;
      const viscousPowerKw = ((torqueEstimatedNm * omegaRadS) / 1000) * 0.45; // effective fraction absorbed by dough mass
      
      // Heat Q = P * t (kJ) = m * c_p * ΔT
      const totalHeatKj = viscousPowerKw * (durationMin * 60);
      const doughCp = dough.specificHeatKjKgK; // kJ / (kg * K)
      const theoreticalTempRiseC = totalHeatKj / (totalDoughKg * doughCp);
      const frictionRiseC = Math.min(28.0, theoreticalTempRiseC * (dough.frictionFactorC / 14.0));

      // 4. Final Dough Discharge Temperature (Rule of 3 / 4)
      // T_dough = (T_flour + T_water + T_room + Friction_Factor) / 3 or weighted sum
      // Flour temp typically tracks ambient: T_flour = ambientC
      const waterMass = flourKg * (dough.hydrationPercent / 100);
      const flourMass = flourKg;
      const totalMass = flourMass + waterMass;
      const mixedInitialC = ((flourMass * ambientC) + (waterMass * waterC)) / totalMass;
      const finalDoughTempC = mixedInitialC + frictionRiseC;
      const finalDoughTempF = ((finalDoughTempC * 9/5) + 32).toFixed(1);

      // 5. Target Water Temperature to reach ideal discharge temp (e.g., 24.0°C)
      // T_water_target = [3 * T_target - (T_flour + T_room + Friction)]
      const idealTargetC = dough.idealDischargeTempC;
      const calculatedTargetWaterC = Math.max(-5, (3 * idealTargetC - (ambientC + ambientC + frictionRiseC)));
      const iceRequired = calculatedTargetWaterC < 4;
      const iceFractionPercent = iceRequired ? Math.min(65, Math.round((4 - calculatedTargetWaterC) * 8.5)) : 0;

      // 6. Motor Stator Thermal Rise & Insulation Margin
      const motorLoadRatio = (torqueEstimatedNm / mixer.maxTorqueNm) * (speedMode === 2 ? 1.15 : 0.85);
      const motorDeltaTK = Math.round(55 * Math.pow(motorLoadRatio, 1.4));
      const motorLimitK = 105; // Class F limit
      const motorMarginPercent = Math.max(0, Math.round(((motorLimitK - motorDeltaTK) / motorLimitK) * 100));

      // 7. Safety Interlock Vibration Drift
      const bowlVibrationG = (mixer.vibrationAmplitudeMm * (torqueEstimatedNm / 1000) * (speedMode === 2 ? 1.6 : 0.9)).toFixed(2);
      const interlockToleranceG = guard.vibrationToleranceG;
      const vibrationDriftMm = (parseFloat(bowlVibrationG) * 0.22 * (guard.interlockType.includes('RFID') ? 0.2 : 1.4)).toFixed(2);
      let falseTripPercent = 0.2;
      if (guard.id === 'vibration_drifted_loose_switch') {
        falseTripPercent = Math.min(95, Math.round(parseFloat(bowlVibrationG) * 35));
      } else if (guard.id === 'ansi_asb_101_positive_opening_switch' && parseFloat(bowlVibrationG) > interlockToleranceG) {
        falseTripPercent = Math.min(45, Math.round((parseFloat(bowlVibrationG) - interlockToleranceG) * 22));
      } else if (guard.id === 'bypassed_jumpered_safety_switch') {
        falseTripPercent = 0.0;
      }

      // Render Outputs
      gearStressOut.textContent = `${Math.round(nominalToothStressMpa)} MPa`;
      if (parseFloat(agmaSafetyFactor) >= 1.5) {
        gearSafetyOut.textContent = `AGMA SF: ${agmaSafetyFactor} (Safe)`;
        gearSafetyOut.className = "text-[11px] font-mono text-emerald-600 dark:text-emerald-400";
      } else if (parseFloat(agmaSafetyFactor) >= 1.0) {
        gearSafetyOut.textContent = `AGMA SF: ${agmaSafetyFactor} (Marginal)`;
        gearSafetyOut.className = "text-[11px] font-mono text-amber-600 dark:text-amber-400";
      } else {
        gearSafetyOut.textContent = `AGMA SF: ${agmaSafetyFactor} (Tooth Shear Failure!)`;
        gearSafetyOut.className = "text-[11px] font-mono text-red-600 dark:text-red-400 font-bold";
      }

      doughTempOut.textContent = `${finalDoughTempC.toFixed(1)}°C`;
      doughFOut.textContent = `${finalDoughTempF}°F (Ideal: ${dough.idealDischargeTempC}°C)`;
      if (finalDoughTempC > dough.maxAllowableTempC) {
        doughTempOut.className = "text-xl sm:text-2xl font-bold font-mono text-red-600 dark:text-red-400";
      } else if (finalDoughTempC > dough.idealDischargeTempC + 1.5) {
        doughTempOut.className = "text-xl sm:text-2xl font-bold font-mono text-amber-600 dark:text-amber-400";
      } else {
        doughTempOut.className = "text-xl sm:text-2xl font-bold font-mono text-ink";
      }

      frictionRiseOut.textContent = `+${frictionRiseC.toFixed(1)}°C`;
      viscousPowerOut.textContent = `${viscousPowerKw.toFixed(1)} kW Viscous Shear`;

      waterTargetOut.textContent = `${calculatedTargetWaterC.toFixed(1)}°C`;
      const waterTargetF = ((calculatedTargetWaterC * 9/5) + 32).toFixed(0);
      iceFractionOut.textContent = iceRequired 
        ? `${waterTargetF}°F (Requires ${iceFractionPercent}% Flake Ice)`
        : `${waterTargetF}°F (Chilled Water OK)`;

      motorThermalOut.textContent = `ΔT ${motorDeltaTK} K`;
      if (motorDeltaTK > motorLimitK) {
        motorInsulationOut.textContent = `Class F Overheated! (+${motorDeltaTK - motorLimitK} K Overlimit)`;
        motorInsulationOut.className = "text-[11px] font-mono text-red-600 dark:text-red-400 font-bold";
      } else {
        motorInsulationOut.textContent = `Class F Thermal Margin: ${motorMarginPercent}%`;
        motorInsulationOut.className = "text-[11px] font-mono text-emerald-600 dark:text-emerald-400";
      }

      interlockDriftOut.textContent = `${vibrationDriftMm} mm`;
      falseTripOut.textContent = `False Trip Probability: ${falseTripPercent}%`;
      if (falseTripPercent > 20) {
        falseTripOut.className = "text-[11px] font-mono text-red-600 dark:text-red-400 font-bold";
      } else {
        falseTripOut.className = "text-[11px] font-mono text-muted";
      }

      if (lubricant.foodGradeCertified) {
        lubricantStatusOut.textContent = "NSF H1 Certified";
        fdaComplianceOut.textContent = "FDA 21 CFR § 178.3570 OK";
        fdaComplianceOut.className = "text-[11px] font-mono text-emerald-600 dark:text-emerald-400";
      } else {
        lubricantStatusOut.textContent = "NON-FOOD GRADE!";
        fdaComplianceOut.textContent = "Toxic Additives / PAH Hazard";
        fdaComplianceOut.className = "text-[11px] font-mono text-red-600 dark:text-red-400 font-bold";
      }

      // Compliance & Status Logic
      let isCritical = false;
      let isWarning = false;

      if (guard.id === 'bypassed_jumpered_safety_switch') {
        isCritical = true;
      }
      if (lubricant.foodGradeCertified === false) {
        isCritical = true;
      }
      if (parseFloat(agmaSafetyFactor) < 1.0) {
        isCritical = true;
      }
      if (finalDoughTempC > dough.maxAllowableTempC) {
        isWarning = true;
      }
      if (motorDeltaTK > motorLimitK) {
        isWarning = true;
      }

      if (isCritical) {
        complianceBadge.textContent = "CRITICAL SAFETY HAZARD";
        complianceBadge.className = "px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-red-600 text-white self-start sm:self-auto";
        statusSummaryOut.textContent = "NON-COMPLIANT";
        safetyStandardOut.textContent = "OSHA 1910.212 / NSF 8 VIOLATION";
        safetyStandardOut.className = "text-[11px] font-mono text-red-600 dark:text-red-400 font-bold";
      } else if (isWarning) {
        complianceBadge.textContent = "OPERATIONAL WARNING";
        complianceBadge.className = "px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-600 text-white self-start sm:self-auto";
        statusSummaryOut.textContent = "FERMENTATION ALERT";
        safetyStandardOut.textContent = "Premature Fermentation Risk";
        safetyStandardOut.className = "text-[11px] font-mono text-amber-600 dark:text-amber-400";
      } else {
        complianceBadge.textContent = "CODE COMPLIANT (OSHA & ANSI)";
        complianceBadge.className = "px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-600 text-white self-start sm:self-auto";
        statusSummaryOut.textContent = guard.performanceLevel;
        safetyStandardOut.textContent = "OSHA & ANSI/ASB 101 OK";
        safetyStandardOut.className = "text-[11px] font-mono text-emerald-600 dark:text-emerald-400";
      }

      // Narrative Diagnoses
      if (guard.id === 'bypassed_jumpered_safety_switch') {
        primaryRiskText.textContent = "FATAL / SEVERE AMPUTATION HAZARD: The bowl safety interlock switch has been electrically defeated or bypassed. The 210 RPM spiral hook exerts over 2,000 Nm of torque with zero barrier guarding. Severe OSHA 29 CFR § 1910.212 willful violation.";
        mechanismsText.textContent = "Operator limbs can enter the pinch zone between the rotating spiral blade and stainless steel bowl divider column. Tensile and compressive forces exceed human bone shear fracture thresholds in under 0.08 seconds.";
        mitigationText.textContent = "IMMEDIATE LOCKOUT/TAGOUT (LOTO) REQUIRED. Reinstall factory dual-channel positive-opening interlock switches or RFID coded switches with zero-speed coast monitoring under ISO 13849-1.";
      } else if (lubricant.foodGradeCertified === false) {
        primaryRiskText.textContent = "TOXIC LUBRICANT CONTAMINATION: Non-food-grade mineral grease (EP2) or degraded sludge is located above the dough bowl. Seal weeping leaks toxic heavy metals and PAHs directly into dough batches.";
        mechanismsText.textContent = "Overhead spiral upper bearing gland operates at elevated temperatures. Petroleum hydrocarbons and toxic sulfur-phosphorus anti-wear additives migrate past worn shaft lip seals into dough during 2-speed kneading.";
        mitigationText.textContent = "Purge gearboxes immediately. Flush and refill with certified NSF H1 registered food-grade synthetic PAO oil or polyurea grease meeting FDA 21 CFR § 178.3570 for incidental food contact (<10 PPM).";
      } else if (finalDoughTempC > dough.maxAllowableTempC) {
        primaryRiskText.textContent = `DOUGH FRICTION THERMAL OVERHEAT: Final dough temperature (${finalDoughTempC.toFixed(1)}°C / ${finalDoughTempF}°F) exceeds maximum allowable ceiling (${dough.maxAllowableTempC}°C), causing irreversible enzymatic and gluten degradation.`;
        mechanismsText.textContent = `Mechanical energy conversion (viscous heating ΔT = +${frictionRiseC.toFixed(1)}°C) accelerates yeast zymase metabolism prematurely in the mixing bowl. Gluten matrix suffers proteolytic breakdown, gas retention collapses, and dough becomes sticky and untensioned.`;
        mitigationText.textContent = `Switch immediately to chilled water or flake ice. Reduce ingoing water temperature from ${waterC}°C to ${calculatedTargetWaterC.toFixed(1)}°C (incorporate ${iceFractionPercent}% flake ice by weight). Shorten Speed 2 mix time or split batch hydration.`;
      } else if (parseFloat(agmaSafetyFactor) < 1.0) {
        primaryRiskText.textContent = `GEAR TOOTH SHEAR OVERLOAD: Bending stress (${Math.round(nominalToothStressMpa)} MPa) exceeds AGMA allowable tooth root fatigue limit. High risk of catastrophic tooth fracture during speed shift.`;
        mechanismsText.textContent = `Extreme torque demands (${Math.round(torqueEstimatedNm)} Nm) from stiff low-hydration dough combined with batch flour overfill create excessive bending moments at the gear tooth root. Surface micro-pitting accelerates into fatigue spalling.`;
        mitigationText.textContent = `Reduce batch size to conform to OEM flour limits (${mixer.flourCapacityKg} kg max). Inspect gear teeth for micro-cracks using magnetic particle testing. Upgrade drive to case-hardened 8620 carburized alloy steel.`;
      } else {
        primaryRiskText.textContent = "NORMAL OPTIMAL OPERATION: Mechanical gear tooth stresses are well within AGMA endurance limits. Dough friction heating is safely balanced by cold ingredient water, achieving perfect gluten development.";
        mechanismsText.textContent = `Viscous shear dissipation (+${frictionRiseC.toFixed(1)}°C) brings dough to the ideal discharge temperature (${finalDoughTempC.toFixed(1)}°C). Motor thermal rise (ΔT ${motorDeltaTK} K) operates with ${motorMarginPercent}% Class F safety margin. Interlock switch drift remains below 0.2 mm.`;
        mitigationText.textContent = "Maintain routine preventative maintenance schedule. Lubricate mixer head bearings every 500 hours with NSF H1 grease. Calibrate ingredient water chiller quarterly to ensure consistent dough discharge temperatures.";
      }
    }

    // Preset Handlers
    document.getElementById('preset-compliant')?.addEventListener('click', () => {
      mixerSelect.value = 'high_capacity_industrial_dual_speed';
      doughSelect.value = 'stiff_bagel_pretzel_dough';
      guardSelect.value = 'iso_13849_cat4_ple_rfid_guard';
      lubricantSelect.value = 'nsf_h1_synthetic_pao_vg220';
      flourSlider.value = '100';
      speedSlider.value = '2';
      ambientSlider.value = '22';
      waterSlider.value = '3';
      durationSlider.value = '12';
      calculateDiagnostics();
    });

    document.getElementById('preset-overheat')?.addEventListener('click', () => {
      mixerSelect.value = 'mid_scale_commercial_vfd_polyv';
      doughSelect.value = 'stiff_bagel_pretzel_dough';
      guardSelect.value = 'ansi_asb_101_positive_opening_switch';
      lubricantSelect.value = 'nsf_h1_synthetic_pao_vg220';
      flourSlider.value = '75';
      speedSlider.value = '2';
      ambientSlider.value = '28';
      waterSlider.value = '22';
      durationSlider.value = '16';
      calculateDiagnostics();
    });

    document.getElementById('preset-gearshear')?.addEventListener('click', () => {
      mixerSelect.value = 'legacy_unmaintained_spiral_mixer';
      doughSelect.value = 'stiff_bagel_pretzel_dough';
      guardSelect.value = 'vibration_drifted_loose_switch';
      lubricantSelect.value = 'thermally_degraded_varnished_sludge';
      flourSlider.value = '95';
      speedSlider.value = '2';
      ambientSlider.value = '24';
      waterSlider.value = '8';
      durationSlider.value = '14';
      calculateDiagnostics();
    });

    document.getElementById('preset-bypassed')?.addEventListener('click', () => {
      mixerSelect.value = 'artisan_pizzeria_bagel_fixed_bowl';
      doughSelect.value = 'artisan_pizza_dough';
      guardSelect.value = 'bypassed_jumpered_safety_switch';
      lubricantSelect.value = 'conventional_industrial_ep2_mineral';
      flourSlider.value = '40';
      speedSlider.value = '2';
      ambientSlider.value = '26';
      waterSlider.value = '14';
      durationSlider.value = '11';
      calculateDiagnostics();
    });

    // Copy Forensic Report
    copyBtn?.addEventListener('click', () => {
      const flourKg = flourSlider.value;
      const speedVal = speedSlider.value;
      const ambientVal = ambientSlider.value;
      const waterVal = waterSlider.value;
      const durationVal = durationSlider.value;
      
      const reportText = `=== ISITKITCHENSAFE FORENSIC DIAGNOSTIC REPORT ===
Tool: Commercial Bakery Spiral Mixer Gear Shear & Overheat Modeler
Mixer Model: ${mixerSelect.options[mixerSelect.selectedIndex].text}
Dough Formulation: ${doughSelect.options[doughSelect.selectedIndex].text}
Flour Batch Mass: ${flourKg} kg | Mix Speed Mode: Speed ${speedVal} | Duration: ${durationVal} min
Ambient Temperature: ${ambientVal}°C | Ingoing Water Temp: ${waterVal}°C
Gear Tooth Stress: ${gearStressOut.textContent} (${gearSafetyOut.textContent})
Final Dough Discharge Temp: ${doughTempOut.textContent} (${doughFOut.textContent})
Viscous Heat Rise: ${frictionRiseOut.textContent} (${viscousPowerOut.textContent})
Target Water Temp for 24°C: ${waterTargetOut.textContent} (${iceFractionOut.textContent})
Motor Stator Thermal Rise: ${motorThermalOut.textContent} (${motorInsulationOut.textContent})
Interlock Vibration Drift: ${interlockDriftOut.textContent} (${falseTripOut.textContent})
Food Safety Status: ${lubricantStatusOut.textContent} (${fdaComplianceOut.textContent})
OSHA / ANSI Code Compliance: ${statusSummaryOut.textContent}
Primary Operational Risk: ${primaryRiskText.textContent}
Mechanisms & Tribology: ${mechanismsText.textContent}
Engineering Directives: ${mitigationText.textContent}
==================================================`;

      navigator.clipboard.writeText(reportText).then(() => {
        const originalText = copyBtnText.textContent;
        copyBtnText.textContent = "Report Copied to Clipboard!";
        setTimeout(() => {
          copyBtnText.textContent = originalText;
        }, 2500);
      }).catch(err => {
        console.error('Failed to copy report:', err);
      });
    });

    // Event Listeners
    [mixerSelect, doughSelect, guardSelect, lubricantSelect].forEach(el => {
      el?.addEventListener('change', calculateDiagnostics);
    });

    [flourSlider, speedSlider, ambientSlider, waterSlider, durationSlider].forEach(el => {
      el?.addEventListener('input', calculateDiagnostics);
    });

    // Initial Execution
    calculateDiagnostics();
  })();
</script>
