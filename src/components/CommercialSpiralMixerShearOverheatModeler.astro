        <div class="flex items-center justify-between text-xs font-bold text-ink mb-1">
          <span>{d.durationSliderLabel.split(' (')[0]}</span>
          <span id="duration-display" class="font-mono text-amber-600 dark:text-amber-400">11 min</span>
        </div>
        <input 
          type="range" 
          id="duration-slider" 
          min="3" 
          max="22" 
          step="1" 
          value="11"
          class="w-full accent-amber-600"
        />
        <span class="block text-[10px] text-muted mt-0.5">{d.durationSliderHelp}</span>
      </div>
    </div>
  </div>

  <!-- Diagnostic Console -->
  <div class="mb-10 p-5 sm:p-6 rounded-2xl bg-surface border border-hairline shadow-inner">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-6 border-b border-hairline/60 pb-4">
      <div>
        <h3 class="text-base sm:text-lg font-bold text-ink">{d.diagnosticTitle}</h3>
        <p class="text-xs text-muted">{d.diagnosticSub}</p>
      </div>
      <div id="compliance-badge" class="px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-600 text-white self-start sm:self-auto">
        CODE COMPLIANT (OSHA &amp; ANSI)
      </div>
    </div>

    <!-- Metrics Cards Grid -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 mb-6">
      <!-- 1. Gear Tooth Bending Stress -->
      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <span class="text-[11px] text-muted block mb-1">{d.gearStressLabel}</span>
        <div id="gear-stress-out" class="text-xl sm:text-2xl font-bold font-mono text-ink">184 MPa</div>
        <span id="gear-safety-out" class="text-[11px] font-mono text-emerald-600 dark:text-emerald-400">AGMA SF: 2.15 (Safe)</span>
      </div>

      <!-- 2. Final Dough Temperature -->
      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <span class="text-[11px] text-muted block mb-1">{d.doughTempLabel}</span>
        <div id="dough-temp-out" class="text-xl sm:text-2xl font-bold font-mono text-ink">23.8°C</div>
        <span id="dough-f-out" class="text-[11px] font-mono text-muted">74.8°F (Target: 23–25°C)</span>
      </div>

      <!-- 3. Frictional Temperature Rise -->
      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <span class="text-[11px] text-muted block mb-1">{d.frictionFactorLabel}</span>
        <div id="friction-rise-out" class="text-xl sm:text-2xl font-bold font-mono text-ink">+15.8°C</div>
        <span id="viscous-power-out" class="text-[11px] font-mono text-muted">6.8 kW Dissipation</span>
      </div>

      <!-- 4. Required Water Temperature -->
