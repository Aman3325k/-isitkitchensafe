    // Stats
    const badgeCompliance = document.getElementById('badge-compliance');
    const statRetention = document.getElementById('stat-retention');
    const statSolids = document.getElementById('stat-solids');
    const statAspectRatio = document.getElementById('stat-aspect-ratio');
    const statAspectSub = document.getElementById('stat-aspect-sub');
    const statStreaming = document.getElementById('stat-streaming');
    const statDryingRate = document.getElementById('stat-drying-rate');
    const statNoise = document.getElementById('stat-noise');
    const statComplianceText = document.getElementById('stat-compliance-text');
    const statLimitationText = document.getElementById('stat-limitation-text');
    const statMitigationText = document.getElementById('stat-mitigation-text');
    const svgDroplet = document.getElementById('svg-droplet');

    // Preset buttons
    const presetRoyalJelly = document.getElementById('preset-royal-jelly');
    const presetLactase = document.getElementById('preset-lactase');
    const presetColostrum = document.getElementById('preset-colostrum');
    const presetBerry = document.getElementById('preset-berry');
    const presetHazard = document.getElementById('preset-hazard');

    function updateSimulation() {
      const curSys = systems.find(s => s.id === systemSelect.value) || systems[0];
      const curSub = substrates.find(s => s.id === substrateSelect.value) || substrates[0];
      const curGas = gases.find(g => g.id === gasSelect.value) || gases[0];
      const curEnc = enclosures.find(e => e.id === enclosureSelect.value) || enclosures[0];

      const spl = parseFloat(splSlider.value);
      const diam = parseFloat(dropletSlider.value);
      const temp = parseFloat(tempSlider.value);
      const residence = parseFloat(residenceSlider.value);

      splVal.textContent = spl + ' dB';
      dropletVal.textContent = diam.toFixed(1) + ' mm';
      tempVal.textContent = Math.round(temp) + ' °C';
      residenceVal.textContent = Math.round(residence) + ' s';

      // Physics model calculations
      // 1. Acoustic streaming velocity (m/s) as function of SPL
      // Pressure amplitude: p0 = 20e-6 * 10^(spl / 20)
      // u_streaming scales exponentially with SPL
      const baseSpl = 160.0;
      const streamingVel = curSys.acousticStreamingVelocityMPerSec * Math.pow(10, (spl - baseSpl) / 30);
      statStreaming.textContent = streamingVel.toFixed(2) + ' m/s';

      // 2. Aspect Ratio deformation (a/b)
      // Gor'kov acoustic radiation pressure flattens droplet
      // Proportional to SPL and diameter, inversely proportional to surface tension sigma
      const sigma = curSub.surfaceTensionNewtonPerM; // N/m (typically 0.045 to 0.065)
      const deformationFactor = (spl - 148) * 0.08 * (diam / 1.5) * (0.055 / sigma);
      const aspectRatio = Math.max(1.05, 1.0 + deformationFactor);
      statAspectRatio.textContent = aspectRatio.toFixed(2);

      // SVG droplet visual update
      if (svgDroplet) {
        const baseRx = 20 * (diam / 1.6);
        const rx = Math.min(48, Math.max(12, baseRx * Math.sqrt(aspectRatio)));
        const ry = Math.min(28, Math.max(7, baseRx / Math.sqrt(aspectRatio)));
        svgDroplet.setAttribute('rx', rx.toFixed(1));
        svgDroplet.setAttribute('ry', ry.toFixed(1));
      }

      // Weber number for stability: We = rho_air * u_streaming^2 * (diam*1e-3) / sigma
      const rhoAir = 1.204;
      const weber = (rhoAir * Math.pow(streamingVel, 2) * (diam * 1e-3)) / sigma;

      // 3. Drying Rate (% solids increase / sec)
      // Enhanced by streaming velocity, carrier gas mass transfer factor, and temperature
      const tempFactor = 1.0 + (temp - 20) * 0.035;
      const dryingRate = 0.65 * (streamingVel / 2.0) * curGas.massTransferFactor * tempFactor * (1.5 / diam);
      statDryingRate.textContent = dryingRate.toFixed(2) + ' %/s';

      // 4. Final solids concentration
      const totalSolidsGain = dryingRate * residence;
      const finalSolids = Math.min(curSub.targetSolidsPercent, curSub.initialSolidsPercent + totalSolidsGain);
      statSolids.textContent = finalSolids.toFixed(1) + '% wt';

      // 5. Bioactive / Enzyme Retention
      // Temperature denaturation kinetics + residence time
      // Activation energy penalty above threshold
      let thermalDegradation = 0.0;
      if (temp > curSub.inactivationTempThresholdC) {
        thermalDegradation = (temp - curSub.inactivationTempThresholdC) * (residence / 30) * 1.8;
      }
      // Zero wall contact bonus: base retention from dataset minus thermal penalty
      const retention = Math.max(50.0, Math.min(99.6, curSub.acousticLevitationRetentionPercent - thermalDegradation));
      statRetention.textContent = retention.toFixed(1) + '%';
      if (retention > 97.0) {
        statRetention.className = 'text-xl font-black font-mono text-emerald-400';
      } else if (retention > 85.0) {
        statRetention.className = 'text-xl font-black font-mono text-amber-400';
      } else {
        statRetention.className = 'text-xl font-black font-mono text-red-400';
      }

      // 6. External Noise Floor
      const internalSpl = spl;
      // Acoustic insertion loss from enclosure
      const externalDba = Math.max(52.0, internalSpl - 85.0 + Math.abs(curEnc.insertionLossDb) * 0.2 + (curSys.enclosureNoiseLevelDba - 68.0));
      statNoise.textContent = externalDba.toFixed(1) + ' dBA';
      if (externalDba < 80.0) {
        statNoise.className = 'text-xl font-black font-mono text-emerald-400';
      } else if (externalDba <= 85.0) {
        statNoise.className = 'text-xl font-black font-mono text-amber-400';
      } else {
        statNoise.className = 'text-xl font-black font-mono text-red-400';
      }

      // 7. Hazard and Compliance Check
      if (aspectRatio > 3.2 || weber > 12.0) {
        badgeCompliance.textContent = 'CRITICAL: ACOUSTIC ATOMIZATION / FISSION';
        badgeCompliance.className = 'px-3 py-1 rounded-full text-xs font-extrabold uppercase tracking-wider bg-red-950 text-red-300 border border-red-800';
        statAspectSub.textContent = 'Unstable (Capillary Breakup)';
        statAspectSub.className = 'text-[10px] text-red-400 block mt-0.5';
        statComplianceText.textContent = 'CRITICAL WARNING: The acoustic radiation pressure exceeds the liquid surface tension restoring force (Weber number ' + weber.toFixed(1) + ' > 12). The droplet will undergo catastrophic equatorial liquid sheet ejection and atomization.';
        statLimitationText.textContent = 'Excessive Sound Pressure Level (' + spl + ' dB) creates extreme flattening (a/b = ' + aspectRatio.toFixed(2) + ' > 3.2). Droplets will shatter and deposit onto horn surfaces.';
        statMitigationText.textContent = 'Immediately attenuate ultrasonic transducer excitation power to reduce SPL below ' + (spl - 5) + ' dB, or decrease micro-dispenser droplet diameter to < 2.0 mm.';
      } else if (temp > curSub.inactivationTempThresholdC) {
        badgeCompliance.textContent = 'WARNING: THERMAL INACTIVATION RISK';
        badgeCompliance.className = 'px-3 py-1 rounded-full text-xs font-extrabold uppercase tracking-wider bg-amber-950 text-amber-300 border border-amber-800';
        statAspectSub.textContent = 'Stable Oblate Spheroid';
        statAspectSub.className = 'text-[10px] text-emerald-400 block mt-0.5';
        statComplianceText.textContent = 'Process gas temperature (' + temp + '°C) exceeds the thermal denaturation threshold of ' + curSub.name + ' (' + curSub.inactivationTempThresholdC + '°C). Bioactive yield is being lost to heat.';
        statLimitationText.textContent = 'Bioactive marker degradation accelerates past ' + curSub.inactivationTempThresholdC + '°C. Enzyme retention dropped to ' + retention.toFixed(1) + '%.';
        statMitigationText.textContent = 'Lower carrier gas supply temperature to 20–25°C. Rely on acoustic streaming boundary layer disruption rather than thermal enthalpy to drive evaporation.';
      } else {
        badgeCompliance.textContent = 'OPTIMAL CONTAINERLESS LEVITATION';
        badgeCompliance.className = 'px-3 py-1 rounded-full text-xs font-extrabold uppercase tracking-wider bg-emerald-950 text-emerald-300 border border-emerald-800';
        statAspectSub.textContent = 'Stable Oblate Spheroid';
        statAspectSub.className = 'text-[10px] text-emerald-400 block mt-0.5';
        statComplianceText.textContent = 'Full compliance with FDA 21 CFR § 117 sanitary manufacturing and OSHA 29 CFR § 1910.95 noise standards (< 85 dBA). Zero product-to-wall contact prevents cross-contamination, wall buildup, and caramelization scorch.';
        statLimitationText.textContent = 'Maximum droplet diameter constrained by acoustic capillary length. Stable levitation maintained at Weber number ' + weber.toFixed(2) + ' (safe margin < 10.0).';
        statMitigationText.textContent = 'Maintain steady micro-dispenser frequency; monitor acoustic corridor temperature and ensure viscoelastic acoustic enclosure panels remain secured.';
      }
    }

    // Event listeners
    systemSelect.addEventListener('change', updateSimulation);
    substrateSelect.addEventListener('change', updateSimulation);
    gasSelect.addEventListener('change', updateSimulation);
    enclosureSelect.addEventListener('change', updateSimulation);

    splSlider.addEventListener('input', updateSimulation);
    dropletSlider.addEventListener('input', updateSimulation);
    tempSlider.addEventListener('input', updateSimulation);
    residenceSlider.addEventListener('input', updateSimulation);

    // Presets
    if (presetRoyalJelly) {
      presetRoyalJelly.addEventListener('click', function() {
        systemSelect.value = 'commercial_continuous_langevin_phased_tunnel';
        substrateSelect.value = 'royal_jelly_apalbumin';
        gasSelect.value = 'ultra_dry_nitrogen';
        enclosureSelect.value = 'tri_layer_viscoelastic_panel';
        splSlider.value = '162';
        dropletSlider.value = '1.6';
        tempSlider.value = '22';
        residenceSlider.value = '45';
        updateSimulation();
      });
    }

    if (presetLactase) {
      presetLactase.addEventListener('click', function() {
        systemSelect.value = 'biopharmaceutical_aseptic_piezo_dod_evaporator';
        substrateSelect.value = 'lactase_enzyme_ferment';
        gasSelect.value = 'chilled_dry_nitrogen';
        enclosureSelect.value = 'sanitary_dual_pane_polycarbonate';
        splSlider.value = '158';
        dropletSlider.value = '0.9';
        tempSlider.value = '16';
        residenceSlider.value = '35';
        updateSimulation();
      });
    }

    if (presetColostrum) {
      presetColostrum.addEventListener('click', function() {
        systemSelect.value = 'commercial_continuous_langevin_phased_tunnel';
        substrateSelect.value = 'monoclonal_antibody_colostrum';
        gasSelect.value = 'desiccant_dehumidified_air';
        enclosureSelect.value = 'tri_layer_viscoelastic_panel';
        splSlider.value = '164';
        dropletSlider.value = '1.8';
        tempSlider.value = '24';
        residenceSlider.value = '50';
        updateSimulation();
      });
    }

    if (presetBerry) {
      presetBerry.addEventListener('click', function() {
        systemSelect.value = 'high_throughput_curved_reflector_resonant_skid';
        substrateSelect.value = 'wild_berry_anthocyanin_extract';
        gasSelect.value = 'ultra_dry_nitrogen';
        enclosureSelect.value = 'vented_silencer_labyrinth';
        splSlider.value = '165';
        dropletSlider.value = '2.2';
        tempSlider.value = '20';
        residenceSlider.value = '60';
        updateSimulation();
      });
    }

    if (presetHazard) {
      presetHazard.addEventListener('click', function() {
        systemSelect.value = 'high_throughput_curved_reflector_resonant_skid';
        substrateSelect.value = 'wild_berry_anthocyanin_extract';
        gasSelect.value = 'desiccant_dehumidified_air';
        enclosureSelect.value = 'sanitary_dual_pane_polycarbonate';
        splSlider.value = '170';
        dropletSlider.value = '3.5';
        tempSlider.value = '38';
        residenceSlider.value = '90';
        updateSimulation();
      });
    }

    // Initialize
    updateSimulation();
  })();
</script>
