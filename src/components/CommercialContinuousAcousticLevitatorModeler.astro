---

<div class="space-y-12">
  <!-- Header / Badge -->
  <div>
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-sky-950 text-sky-200 border border-sky-800 mb-4">
      <span class="w-2 h-2 rounded-full bg-sky-400 animate-pulse"></span>
      {d.badge}
    </div>
    <h1 class="text-3xl md:text-4xl font-extrabold text-ink tracking-tight mb-4">
      {d.title}
    </h1>
    <p class="text-base md:text-lg text-muted max-w-4xl leading-relaxed">
      {d.subtitle}
    </p>
  </div>

  <!-- Interactive Simulator Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    
    <!-- Controls Panel (5 Cols) -->
    <div class="lg:col-span-5 bg-surface-soft border border-hairline rounded-2xl p-6 shadow-xs space-y-6">
      <div class="border-b border-hairline/60 pb-4">
        <h2 class="text-lg font-bold text-ink mb-1">{d.controlsTitle}</h2>
        <p class="text-xs text-muted leading-relaxed">{d.controlsSub}</p>
      </div>

      <!-- Presets -->
      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-muted mb-2">
          {d.presetsTitle}
        </label>
        <div class="grid grid-cols-2 gap-2">
          <button 
            type="button" 
            id="preset-royal-jelly"
            class="px-2.5 py-2 text-xs font-medium rounded-lg bg-surface border border-hairline hover:border-sky-500 hover:text-sky-400 text-ink text-left transition-colors truncate"
          >
            🍯 {d.presetRoyalJelly}
          </button>
          <button 
            type="button" 
            id="preset-lactase"
            class="px-2.5 py-2 text-xs font-medium rounded-lg bg-surface border border-hairline hover:border-sky-500 hover:text-sky-400 text-ink text-left transition-colors truncate"
          >
            🧪 {d.presetLactase}
          </button>
          <button 
            type="button" 
            id="preset-colostrum"
