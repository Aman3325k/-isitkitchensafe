<script>
  function initAswSimulator() {
    const presetSelect = document.getElementById('asw-preset-select') as HTMLSelectElement | null;
    const systemSelect = document.getElementById('asw-system-select') as HTMLSelectElement | null;
    const lipidSelect = document.getElementById('asw-lipid-select') as HTMLSelectElement | null;
    const freqRange = document.getElementById('asw-freq-range') as HTMLInputElement | null;
    const powerRange = document.getElementById('asw-power-range') as HTMLInputElement | null;
    const flowRange = document.getElementById('asw-flow-range') as HTMLInputElement | null;
    const tempRange = document.getElementById('asw-temp-range') as HTMLInputElement | null;
    const timeRange = document.getElementById('asw-time-range') as HTMLInputElement | null;
    const jacketSelect = document.getElementById('asw-jacket-select') as HTMLSelectElement | null;

    // Value Labels
    const freqVal = document.getElementById('asw-freq-val');
    const powerVal = document.getElementById('asw-power-val');
    const flowVal = document.getElementById('asw-flow-val');
    const tempVal = document.getElementById('asw-temp-val');
    const timeVal = document.getElementById('asw-time-val');

    // Telemetry Diagnostics
    const diagYield = document.getElementById('diag-yield');
    const barYield = document.getElementById('bar-yield');
    const diagSize = document.getElementById('diag-size');
    const diagTrans = document.getElementById('diag-trans');
    const diagDroplet = document.getElementById('diag-droplet');
    const diagTemper = document.getElementById('diag-temper');
    const diagBloom = document.getElementById('diag-bloom');
    const diagBio = document.getElementById('diag-bio');
    const diagEnergy = document.getElementById('diag-energy');
    const diagCavit = document.getElementById('diag-cavit');
    const diagStatus = document.getElementById('diag-status');
    const diagStatusSub = document.getElementById('diag-status-sub');

    // SVG Annotations
    const svgShear = document.getElementById('asw-svg-shear');
    const svgPhase = document.getElementById('asw-svg-phase');

    if (!freqRange || !powerRange || !tempRange) return;

    function recalculate() {
      const freq = parseFloat(freqRange?.value || '1.8');
      const power = parseFloat(powerRange?.value || '5.5');
      const flow = parseFloat(flowRange?.value || '500');
      const temp = parseFloat(tempRange?.value || '30.8');
      const time = parseFloat(timeRange?.value || '24');
      const lipid = lipidSelect?.value || 'cocoa_butter_dark_chocolate';
      const jacket = jacketSelect?.value || 'precision';

      // Update Slider Value Texts
      if (freqVal) freqVal.textContent = `${freq.toFixed(1)} MHz`;
      if (powerVal) powerVal.textContent = `${power.toFixed(1)} W/cm²`;
      if (flowVal) flowVal.textContent = `${Math.round(flow)} kg/h`;
      if (tempVal) tempVal.textContent = `${temp.toFixed(1)} °C`;
      if (timeVal) timeVal.textContent = `${Math.round(time)} s`;

      // Biophysical Modeling Computations
      // 1. Acoustic shear rate: gamma_dot = (alpha * I_ac * freq) / (rho * c * mu)
      const shearRate = Math.round(freq * power * 1450 + (time * 12));
      if (svgShear) svgShear.textContent = `ACOUSTIC SHEAR: γ̇ = ${shearRate.toLocaleString()} s⁻¹`;

      // 2. Temperature deviation penalty from optimum
      let optTemp = 30.8;
      if (lipid === 'zero_trans_plant_shortening') optTemp = 23.5;
      else if (lipid === 'omega3_dha_epa_nano_emulsion') optTemp = 20.0;
      else if (lipid === 'plant_based_dairy_cream') optTemp = 21.5;
      else if (lipid === 'confectionery_filling_fat') optTemp = 26.0;

      const tempDelta = Math.abs(temp - optTemp);

      // Jacket penalty
      let jacketPenalty = 0;
      if (jacket === 'off') jacketPenalty = 18.5;
      else if (jacket === 'multizone') jacketPenalty = 1.0;

      // 3. Form V / beta-prime Polymorphic Conversion Yield
      let yieldPct = 99.2 - (tempDelta * 4.2) - jacketPenalty + (power * 0.4);
      if (power > 14.0 && freq < 0.8) yieldPct -= 22.0; // Overheating & thermal runaway
      yieldPct = Math.max(35.0, Math.min(99.6, yieldPct));

      if (diagYield) diagYield.textContent = `${yieldPct.toFixed(1)}%`;
      if (barYield) {
        barYield.style.width = `${yieldPct}%`;
        barYield.className = yieldPct > 90 ? 'bg-emerald-500 h-full rounded-full transition-all' : (yieldPct > 70 ? 'bg-amber-500 h-full rounded-full transition-all' : 'bg-rose-500 h-full rounded-full transition-all');
      }

      // 4. Mean Crystal Size (D50)
      let d50 = 2.1;
      if (lipid === 'omega3_dha_epa_nano_emulsion') {
        d50 = Math.max(0.08, 0.28 - (freq * 0.05) - (power * 0.008));
        if (diagSize) diagSize.textContent = `${(d50 * 1000).toFixed(0)} nm`;
      } else {
        d50 = Math.max(1.1, 4.2 - (freq * 0.9) - (power * 0.08) + (tempDelta * 0.3));
        if (diagSize) diagSize.textContent = `${d50.toFixed(1)} µm`;
      }

      // 5. Trans-Fat Formation (Always 0.00%)
      if (diagTrans) diagTrans.textContent = '0.00%';

      // 6. Emulsion Droplet Size (D32)
      const d32 = Math.max(95, Math.round(480 / (freq * 1.1 + power * 0.15)));
      if (diagDroplet) diagDroplet.textContent = `${d32} nm`;

      // 7. Temper Meter Index (TI / CTU)
      let temperIndex = 5.2 - (tempDelta * 0.45);
      if (yieldPct < 75) temperIndex = Math.max(1.5, 3.2 - tempDelta);
      if (diagTemper) diagTemper.textContent = `${Math.max(1.0, temperIndex).toFixed(1)} CTU`;

      // 8. Fat Bloom Shelf Life
      let bloomDays = Math.round(yieldPct * 2.6 - (tempDelta * 18));
      bloomDays = Math.max(14, Math.min(365, bloomDays));
      if (diagBloom) diagBloom.textContent = `${bloomDays} Days`;

      // 9. Bioactive Retention
      let bioRet = 99.8 - (power * 0.12) - (tempDelta * 0.6);
      if (jacket === 'off') bioRet -= 6.5;
      bioRet = Math.max(82.0, Math.min(99.9, bioRet));
      if (diagBio) diagBio.textContent = `${bioRet.toFixed(1)}%`;

      // 10. Specific Energy Consumption
      const energyWh = (power * 3.1) + (flow / 800 * 2.5);
      if (diagEnergy) diagEnergy.textContent = `${energyWh.toFixed(1)} Wh/kg`;

      // 11. Cavitation Factor (High frequency prevents cavitation)
      const cavitFactor = freq >= 1.0 ? 0.00 : (power > 12.0 ? 0.42 : 0.08);
      if (diagCavit) {
        diagCavit.textContent = cavitFactor === 0 ? '0.00 / Zero' : `${cavitFactor.toFixed(2)} (Caution)`;
        diagCavit.className = cavitFactor === 0 ? 'text-2xl font-black font-mono text-emerald-600 dark:text-emerald-400' : 'text-2xl font-black font-mono text-rose-600';
      }

      // Overall Status Assessment
      if (svgPhase) {
        if (yieldPct >= 95) {
          svgPhase.textContent = 'PHASE: FORM V (β2) STABLE';
          svgPhase.setAttribute('fill', '#22c55e');
        } else if (yieldPct >= 80) {
          svgPhase.textContent = 'PHASE: FORM IV METASTABLE';
          svgPhase.setAttribute('fill', '#f59e0b');
        } else {
          svgPhase.textContent = 'PHASE: UNSTABLE FORM II / BLOOM';
          svgPhase.setAttribute('fill', '#ef4444');
        }
      }

      if (diagStatus && diagStatusSub) {
        if (yieldPct >= 92 && cavitFactor === 0 && tempDelta <= 2.5) {
          diagStatus.textContent = '3-A SANITARY 44-03 PASS';
          diagStatus.className = 'text-base font-extrabold text-emerald-600 dark:text-emerald-400';
          diagStatusSub.textContent = 'EHEDG Class I Aseptic Cleanable / FDA 21 CFR § 117';
        } else if (yieldPct >= 75) {
          diagStatus.textContent = 'OPTIMAL TEMPER CAUTION';
          diagStatus.className = 'text-base font-extrabold text-amber-600 dark:text-amber-400';
          diagStatusSub.textContent = 'Sub-Optimal Polymorph Conversion Yield / Adjust Glycol ΔT';
        } else {
          diagStatus.textContent = 'THERMAL DECOUPLING WARNING';
          diagStatus.className = 'text-base font-extrabold text-rose-600 dark:text-rose-400';
          diagStatusSub.textContent = 'Severe Bloom Hazard / Grainy Texture & Off-Spec Temper';
        }
      }
    }

    // Attach Event Listeners
    [freqRange, powerRange, flowRange, tempRange, timeRange].forEach(input => {
      input?.addEventListener('input', recalculate);
    });

    [systemSelect, lipidSelect, jacketSelect].forEach(select => {
      select?.addEventListener('change', recalculate);
    });

    presetSelect?.addEventListener('change', (e) => {
      const val = (e.target as HTMLSelectElement).value;
      if (val === 'chocolate') {
        if (freqRange) freqRange.value = '1.8';
        if (powerRange) powerRange.value = '5.5';
        if (flowRange) flowRange.value = '500';
        if (tempRange) tempRange.value = '30.8';
        if (timeRange) timeRange.value = '24';
        if (lipidSelect) lipidSelect.value = 'cocoa_butter_dark_chocolate';
        if (systemSelect) systemSelect.value = 'megasonic_resonant_flow_cell_skid';
        if (jacketSelect) jacketSelect.value = 'precision';
      } else if (val === 'shortening') {
        if (freqRange) freqRange.value = '1.2';
        if (powerRange) powerRange.value = '7.0';
        if (flowRange) flowRange.value = '1400';
        if (tempRange) tempRange.value = '23.5';
        if (timeRange) timeRange.value = '32';
        if (lipidSelect) lipidSelect.value = 'zero_trans_plant_shortening';
        if (systemSelect) systemSelect.value = 'jacketed_crystallization_column';
        if (jacketSelect) jacketSelect.value = 'multizone';
      } else if (val === 'omega3') {
        if (freqRange) freqRange.value = '2.4';
        if (powerRange) powerRange.value = '9.5';
        if (flowRange) flowRange.value = '280';
        if (tempRange) tempRange.value = '20.0';
        if (timeRange) timeRange.value = '18';
        if (lipidSelect) lipidSelect.value = 'omega3_dha_epa_nano_emulsion';
        if (systemSelect) systemSelect.value = 'sanitary_microchannel_reactor';
        if (jacketSelect) jacketSelect.value = 'microchannel';
      } else if (val === 'plantCream') {
        if (freqRange) freqRange.value = '1.5';
        if (powerRange) powerRange.value = '5.8';
        if (flowRange) flowRange.value = '750';
        if (tempRange) tempRange.value = '21.5';
        if (timeRange) timeRange.value = '26';
        if (lipidSelect) lipidSelect.value = 'plant_based_dairy_cream';
        if (systemSelect) systemSelect.value = 'megasonic_resonant_flow_cell_skid';
        if (jacketSelect) jacketSelect.value = 'precision';
      } else if (val === 'hazard') {
        if (freqRange) freqRange.value = '0.4';
        if (powerRange) powerRange.value = '16.5';
        if (flowRange) flowRange.value = '80';
        if (tempRange) tempRange.value = '38.5';
        if (timeRange) timeRange.value = '75';
        if (lipidSelect) lipidSelect.value = 'cocoa_butter_dark_chocolate';
        if (systemSelect) systemSelect.value = 'cleanroom_pilot_validation_skid';
        if (jacketSelect) jacketSelect.value = 'off';
      }
      recalculate();
    });

    // Initial calculation
    recalculate();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAswSimulator);
  } else {
    initAswSimulator();
  }
</script>