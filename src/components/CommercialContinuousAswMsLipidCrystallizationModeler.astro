const d = DICT[lang] || DICT.en;
---

<div class="asw-ms-container max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-12">
  <!-- Header Banner -->
  <header class="text-center space-y-4 max-w-4xl mx-auto">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-950 text-amber-200 border border-amber-800 shadow-xs">
      <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
      {d.badge}
    </div>
    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-ink tracking-tight">
      {d.title}
    </h1>
    <p class="text-muted text-sm sm:text-base leading-relaxed">
      {d.subtitle}
    </p>
  </header>

  <!-- Main Simulator Layout: Two Columns on Large Screens -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Controls Panel (5 cols) -->
    <section class="lg:col-span-5 bg-surface-soft border border-hairline rounded-2xl p-6 sm:p-7 shadow-xs space-y-6">
      <div class="border-b border-hairline/60 pb-4">
        <h2 class="text-lg font-bold text-ink flex items-center gap-2">
          <svg class="w-5 h-5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
          </svg>
          {d.controlsTitle}
        </h2>
        <p class="text-xs text-muted mt-1 leading-normal">
          {d.controlsSub}
        </p>
      </div>

      <!-- Presets Selector -->
      <div class="space-y-2">
        <label for="asw-preset-select" class="block text-xs font-bold uppercase tracking-wider text-ink/80">
          {d.presetsTitle}
        </label>
        <select id="asw-preset-select" class="w-full text-xs rounded-xl bg-surface border border-hairline p-2.5 text-ink focus:outline-none focus:ring-2 focus:ring-amber-500">
          <option value="chocolate" selected>{d.presetChocolate}</option>
          <option value="shortening">{d.presetShortening}</option>
          <option value="omega3">{d.presetOmega3}</option>
          <option value="plantCream">{d.presetPlantCream}</option>
          <option value="hazard">{d.presetHazard}</option>
        </select>
      </div>

      <!-- System Architecture Selector -->
      <div class="space-y-1.5">
        <label for="asw-system-select" class="block text-xs font-bold text-ink flex items-center justify-between">
          <span>{d.systemLabel}</span>
        </label>
        <select id="asw-system-select" class="w-full text-xs rounded-xl bg-surface border border-hairline p-2.5 text-ink focus:outline-none focus:ring-2 focus:ring-amber-500">
          {aswData.systemArchitectures.map(sys => (
            <option value={sys.id}>{sys.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted leading-tight">{d.systemHelp}</p>
      </div>

      <!-- Lipid Substrate Selector -->
      <div class="space-y-1.5">
        <label for="asw-lipid-select" class="block text-xs font-bold text-ink flex items-center justify-between">
          <span>{d.lipidLabel}</span>
        </label>
        <select id="asw-lipid-select" class="w-full text-xs rounded-xl bg-surface border border-hairline p-2.5 text-ink focus:outline-none focus:ring-2 focus:ring-amber-500">
          {aswData.lipidSystems.map(lip => (
            <option value={lip.id}>{lip.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted leading-tight">{d.lipidHelp}</p>
      </div>

      <!-- Parameter Sliders -->
      <div class="space-y-4 pt-2 border-t border-hairline/60">
        <!-- Frequency Slider (0.5 to 3.0 MHz) -->
        <div class="space-y-1">
          <div class="flex justify-between items-center text-xs font-bold text-ink">
            <label for="asw-freq-range">{d.frequencyLabel}</label>
            <span id="asw-freq-val" class="font-mono text-amber-600 dark:text-amber-400 font-extrabold text-sm">1.8 MHz</span>
          </div>
          <input type="range" id="asw-freq-range" min="0.4" max="3.2" step="0.1" value="1.8" class="w-full accent-amber-600 cursor-pointer" />
          <p class="text-[10px] text-muted">{d.frequencyHelp}</p>
        </div>

        <!-- Power Density Slider (1.0 to 15.0 W/cm2) -->
        <div class="space-y-1">
          <div class="flex justify-between items-center text-xs font-bold text-ink">
            <label for="asw-power-range">{d.powerDensityLabel}</label>
            <span id="asw-power-val" class="font-mono text-amber-600 dark:text-amber-400 font-extrabold text-sm">5.5 W/cm²</span>
          </div>
          <input type="range" id="asw-power-range" min="1.0" max="18.0" step="0.5" value="5.5" class="w-full accent-amber-600 cursor-pointer" />
          <p class="text-[10px] text-muted">{d.powerDensityHelp}</p>
        </div>

        <!-- Flow Rate Slider (100 to 2500 kg/h) -->
        <div class="space-y-1">
          <div class="flex justify-between items-center text-xs font-bold text-ink">
            <label for="asw-flow-range">{d.flowRateLabel}</label>
            <span id="asw-flow-val" class="font-mono text-amber-600 dark:text-amber-400 font-extrabold text-sm">500 kg/h</span>
          </div>
          <input type="range" id="asw-flow-range" min="50" max="2500" step="50" value="500" class="w-full accent-amber-600 cursor-pointer" />
          <p class="text-[10px] text-muted">{d.flowRateHelp}</p>
        </div>

        <!-- Chamber Temperature Slider (16.0 to 42.0 C) -->
        <div class="space-y-1">
          <div class="flex justify-between items-center text-xs font-bold text-ink">
            <label for="asw-temp-range">{d.temperatureLabel}</label>
            <span id="asw-temp-val" class="font-mono text-amber-600 dark:text-amber-400 font-extrabold text-sm">30.8 °C</span>
          </div>
          <input type="range" id="asw-temp-range" min="16.0" max="42.0" step="0.2" value="30.8" class="w-full accent-amber-600 cursor-pointer" />
          <p class="text-[10px] text-muted">{d.temperatureHelp}</p>
        </div>

        <!-- Residence Time Slider (5 to 60 s) -->
        <div class="space-y-1">
          <div class="flex justify-between items-center text-xs font-bold text-ink">
            <label for="asw-time-range">{d.residenceTimeLabel}</label>
            <span id="asw-time-val" class="font-mono text-amber-600 dark:text-amber-400 font-extrabold text-sm">24 s</span>
          </div>
          <input type="range" id="asw-time-range" min="5" max="80" step="1" value="24" class="w-full accent-amber-600 cursor-pointer" />
          <p class="text-[10px] text-muted">{d.residenceTimeHelp}</p>
        </div>

        <!-- Jacket Cooling Select -->
        <div class="space-y-1.5 pt-2 border-t border-hairline/60">
          <label for="asw-jacket-select" class="block text-xs font-bold text-ink">
            {d.jacketCoolingLabel}
          </label>
          <select id="asw-jacket-select" class="w-full text-xs rounded-xl bg-surface border border-hairline p-2.5 text-ink focus:outline-none focus:ring-2 focus:ring-amber-500">
            <option value="precision" selected>Precision Counter-Current Chilled Glycol (±0.1°C Stability)</option>
            <option value="multizone">Multi-Zone Direct Ammonia Cascade (Heavy Duty Cooling)</option>
            <option value="microchannel">Micro-Channel Chilled Heat Exchange Plate</option>
            <option value="off">Off / Ambient Free Convection (High Risk of Thermal Runaway)</option>
          </select>
          <p class="text-[10px] text-muted">{d.jacketCoolingHelp}</p>
        </div>
      </div>
    </section>

    <!-- Diagnostics and Live SVG Panel (7 cols) -->
    <div class="lg:col-span-7 space-y-6">
      <!-- Live Interactive SVG Visualization -->
      <section class="bg-surface-soft border border-hairline rounded-2xl p-6 shadow-xs space-y-4">
        <div>
          <h2 class="text-base font-bold text-ink flex items-center justify-between">
            <span>{d.diagramTitle}</span>
            <span class="text-xs font-mono px-2 py-0.5 rounded-md bg-amber-950 text-amber-300 border border-amber-800">
              3-A 44-03 / EHEDG Class I
            </span>
          </h2>
          <p class="text-xs text-muted mt-1 leading-normal">
            {d.diagramSub}
          </p>
        </div>

        <!-- Interactive SVG Canvas -->
        <div class="w-full bg-slate-950 border border-slate-800 rounded-xl p-4 overflow-hidden relative shadow-inner">
          <svg viewBox="0 0 700 360" class="w-full h-auto select-none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="piezoGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#f59e0b" stop-opacity="0.9" />
                <stop offset="50%" stop-color="#b45309" stop-opacity="0.95" />
                <stop offset="100%" stop-color="#78350f" stop-opacity="1" />
              </linearGradient>
              <linearGradient id="liquidGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#451a03" stop-opacity="0.85" />
                <stop offset="50%" stop-color="#78350f" stop-opacity="0.9" />
                <stop offset="100%" stop-color="#451a03" stop-opacity="0.85" />
              </linearGradient>
              <linearGradient id="glycolGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#0284c7" stop-opacity="0.4" />
                <stop offset="100%" stop-color="#0369a1" stop-opacity="0.6" />
              </linearGradient>
              <pattern id="grid" width="20" height="20" patternUnits="userSpaceOnUse">
                <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#1e293b" stroke-width="0.5" />
              </pattern>
            </defs>

            <!-- Grid Background -->
            <rect width="700" height="360" fill="url(#grid)" />

            <!-- Chilled Glycol Outer Cooling Jacket -->
            <rect x="40" y="30" width="620" height="40" rx="6" fill="url(#glycolGrad)" stroke="#0284c7" stroke-width="1.5" />
            <text x="350" y="55" fill="#bae6fd" font-size="11" font-weight="bold" font-family="monospace" text-anchor="middle">
              ❄️ COUNTER-CURRENT CHILLED GLYCOL JACKET (ΔT CONTROL ±0.1°C)
            </text>

            <rect x="40" y="290" width="620" height="40" rx="6" fill="url(#glycolGrad)" stroke="#0284c7" stroke-width="1.5" />
            <text x="350" y="315" fill="#bae6fd" font-size="11" font-weight="bold" font-family="monospace" text-anchor="middle">
              ❄️ GLYCOL RETURN / PRECISION HEAT SINK (ACOUSTIC HEAT REMOVAL)
            </text>

            <!-- Main Resonant Acoustic Chamber Flow Core -->
            <rect x="60" y="80" width="580" height="200" rx="8" fill="url(#liquidGrad)" stroke="#d97706" stroke-width="2" />

            <!-- Piezoceramic Transducer Arrays (Top & Bottom Half-Wave Plates) -->
            <rect x="100" y="80" width="500" height="22" rx="4" fill="url(#piezoGrad)" stroke="#fef08a" stroke-width="1" />
            <text x="350" y="95" fill="#ffffff" font-size="10" font-weight="extrabold" font-family="monospace" text-anchor="middle">
              ▲ PZT-8 PIEZOCERAMIC TRANSDUCER ARRAY (0.5 – 3.0 MHz RESONANT EMISSION) ▲
            </text>

            <rect x="100" y="258" width="500" height="22" rx="4" fill="url(#piezoGrad)" stroke="#fef08a" stroke-width="1" />
            <text x="350" y="273" fill="#ffffff" font-size="10" font-weight="extrabold" font-family="monospace" text-anchor="middle">
              ▼ OPPOSING ACOUSTIC REFLECTOR / HALF-WAVE BOUNDARY RESONATOR ▼
            </text>

            <!-- Megasonic Standing Wave Nodal Planes & Acoustic Streamlines -->
            <g id="asw-standing-waves" stroke="#38bdf8" stroke-width="1.5" stroke-dasharray="3,3" opacity="0.75">
              <line x1="160" y1="104" x2="160" y2="256" />
              <line x1="220" y1="104" x2="220" y2="256" />
              <line x1="280" y1="104" x2="280" y2="256" />
              <line x1="340" y1="104" x2="340" y2="256" />
              <line x1="400" y1="104" x2="400" y2="256" />
              <line x1="460" y1="104" x2="460" y2="256" />
              <line x1="520" y1="104" x2="520" y2="256" />
              <line x1="580" y1="104" x2="580" y2="256" />
            </g>

            <!-- Dynamic Acoustic Pressure Standing Waves (Sine Waves across planes) -->
            <path id="asw-sine-top" d="M 100 140 Q 130 115 160 140 T 220 140 T 280 140 T 340 140 T 400 140 T 460 140 T 520 140 T 580 140" fill="none" stroke="#f59e0b" stroke-width="2.2" opacity="0.85" />
            <path id="asw-sine-bot" d="M 100 220 Q 130 245 160 220 T 220 220 T 280 220 T 340 220 T 400 220 T 460 220 T 520 220 T 580 220" fill="none" stroke="#f59e0b" stroke-width="2.2" opacity="0.85" />

            <!-- Eckart Micro-Streaming Acoustic Vortices (Shear zones) -->
            <g id="asw-vortices" stroke="#34d399" stroke-width="1.2" fill="none" opacity="0.8">
              <ellipse cx="190" cy="180" rx="18" ry="12" />
              <ellipse cx="250" cy="180" rx="18" ry="12" />
              <ellipse cx="310" cy="180" rx="18" ry="12" />
              <ellipse cx="370" cy="180" rx="18" ry="12" />
              <ellipse cx="430" cy="180" rx="18" ry="12" />
              <ellipse cx="490" cy="180" rx="18" ry="12" />
              <ellipse cx="550" cy="180" rx="18" ry="12" />
            </g>

            <!-- Nucleating Lipid Micro-Crystals (Seed Crystal Clusters in Acoustic Nodes) -->
            <g id="asw-crystals" fill="#fef08a" stroke="#ca8a04" stroke-width="0.8">
              <polygon points="160,176 163,180 160,184 157,180" />
              <polygon points="220,174 224,180 220,186 216,180" />
              <polygon points="280,172 285,180 280,188 275,180" />
              <polygon points="340,170 346,180 340,190 334,180" />
              <polygon points="400,168 407,180 400,192 393,180" />
              <polygon points="460,168 408,180 460,192 452,180" />
              <polygon points="520,167 529,180 520,193 511,180" />
              <polygon points="580,166 590,180 580,194 570,180" />

              <!-- Sub-micron dispersed seed satellites -->
              <circle cx="215" cy="165" r="2.5" fill="#fde047" />
              <circle cx="275" cy="195" r="3.0" fill="#fde047" />
              <circle cx="335" cy="160" r="3.2" fill="#fde047" />
              <circle cx="395" cy="200" r="3.5" fill="#fde047" />
              <circle cx="455" cy="162" r="3.8" fill="#fde047" />
              <circle cx="515" cy="198" r="4.0" fill="#fde047" />
              <circle cx="575" cy="160" r="4.2" fill="#fde047" />
            </g>

            <!-- Flow Direction Annotations -->
