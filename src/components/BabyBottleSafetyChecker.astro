const t = UI[lang] || UI.en;

const quickPickIds = [
  'pp-baby-bottles',
  'borosilicate-glass-bottles',
  'silicone-suction-plates',
  'melamine-kids-plates',
  'latex-pacifiers-teethers',
  'breast-milk-storage-bags'
];

const quickPicks = quickPickIds
  .map((id) => localizedItems.find((i) => i.id === id))
  .filter((x): x is LocalizedItem => Boolean(x));

const defaultItem = localizedItems[0]; // Polypropylene (#5 PP) Baby Bottles
const defaultAppliance: ApplianceId = 'microwave';
const defaultVerdict: VerdictLevel = defaultItem.verdicts[defaultAppliance];
const defaultNote = defaultItem.applianceNotes[defaultAppliance];

const catCounts = {
  all: localizedItems.length,
  bottles: localizedItems.filter((i) => i.category === 'bottles').length,
  plates: localizedItems.filter((i) => i.category === 'plates').length,
  cups: localizedItems.filter((i) => i.category === 'cups').length,
  pacifiers: localizedItems.filter((i) => i.category === 'pacifiers').length
};

const clientPayload = {
  lang,
  appliances: localizedAppliances,
  items: localizedItems,
  milkAlert: localizedMilkAlert,
  ui: t
};

function getVerdictLabel(verdict: VerdictLevel): string {
  if (verdict === 'safe') return t.verdictSafe;
  if (verdict === 'caution') return t.verdictCaution;
  return t.verdictUnsafe;
}

function getVerdictPillClass(verdict: VerdictLevel): string {
  if (verdict === 'safe') return 'badge-yes';
  if (verdict === 'caution') return 'badge-depends';
  return 'badge-no';
}

function getVerdictCardClasses(verdict: VerdictLevel): string {
  if (verdict === 'safe') return 'border-success-border/60 bg-canvas';
  if (verdict === 'caution') return 'border-warning-border/80 bg-warning-bg/35 dark:bg-amber-950/20';
  return 'border-error-border/70 bg-error-bg/45 dark:bg-red-950/20';
}

function getMiniDotClass(verdict: VerdictLevel): string {
  if (verdict === 'safe') return 'bg-success-border/20 text-ink border-success-border/60';
  if (verdict === 'caution') return 'bg-warning-bg/80 dark:bg-amber-950/40 text-ink border-warning-border/70';
  return 'bg-error-bg/80 dark:bg-red-950/40 text-ink border-error-border/70';
}

function getMiniStatusChar(verdict: VerdictLevel): string {
  if (verdict === 'safe') return '✓';
  if (verdict === 'caution') return '!';
  return '✕';
}
---

<div id="baby-bottle-checker-root" class="space-y-12">
  <!-- Main Interactive Checker Card -->
  <section
    id="baby-bottle-safety-checker"
    class="bg-canvas border border-hairline rounded-2xl shadow-sm overflow-hidden"
    aria-label={t.ariaLabel}
  >
    <script type="application/json" id="bbsc-payload" set:html={JSON.stringify(clientPayload)} />

    <div class="grid grid-cols-1 lg:grid-cols-12 divide-y lg:divide-y-0 lg:divide-x divide-hairline">
      <!-- Left Column: Material/Item Selector, Appliance Matrix & Milk Warming Toggle -->
      <div class="lg:col-span-6 p-5 sm:p-6 space-y-6 print:hidden">
        <!-- Step 1: Select Material / Item -->
        <div class="space-y-3">
          <div class="flex items-center justify-between gap-2">
            <label for="bbsc-item-select" class="text-title-sm font-semibold text-ink">
              {t.step1Title}
            </label>
          </div>

          <select
            id="bbsc-item-select"
            aria-label={t.itemSelectLabel}
            class="w-full min-h-[46px] px-3.5 py-2.5 rounded-xl bg-surface-soft border border-hairline text-ink text-sm font-semibold focus:outline-none focus:border-info-border cursor-pointer"
          >
            {localizedItems.map((item) => (
              <option value={item.id} selected={item.id === defaultItem.id}>
                {item.icon} {item.name}
              </option>
            ))}
          </select>

          <div class="space-y-1.5">
            <span class="block text-[11px] font-semibold uppercase tracking-wider text-muted">
              {t.quickPicksLabel}
            </span>
            <div class="flex flex-wrap gap-1.5">
              {quickPicks.map((item) => (
                <button
                  type="button"
                  data-bbsc-quick={item.id}
                  class={`bbsc-quick-btn min-h-[34px] px-2.5 py-1 rounded-lg text-xs font-semibold border transition-all cursor-pointer ${
                    item.id === defaultItem.id
                      ? 'bg-signature-coral text-white border-signature-coral shadow-sm'
                      : 'bg-canvas text-ink border-hairline hover:border-signature-coral'
                  }`}
                >
                  {item.icon} {item.name.split('(')[0].trim()}
                </button>
              ))}
            </div>
          </div>
        </div>

        <!-- Step 2: Select Kitchen Task / Appliance -->
        <div class="space-y-3">
          <h2 class="text-title-sm font-semibold text-ink">{t.step2Title}</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2" role="radiogroup" aria-label={t.step2Title}>
            {localizedAppliances.map((app) => {
              const isSelected = app.id === defaultAppliance;
              return (
                <button
                  type="button"
                  role="radio"
                  aria-checked={isSelected ? 'true' : 'false'}
                  data-bbsc-appliance={app.id}
                  class={`bbsc-app-btn min-h-[62px] p-3 rounded-xl border text-left transition-all cursor-pointer ${
                    isSelected
                      ? 'bg-primary text-on-primary border-primary shadow-sm'
                      : 'bg-canvas text-ink border-hairline hover:border-border-strong'
                  }`}
                >
                  <span class="block text-sm font-bold leading-snug">
                    {app.icon} {app.label}
                  </span>
                  <span class="block text-[11px] opacity-80 mt-0.5 leading-tight">{app.sub}</span>
                </button>
              );
            })}
          </div>
        </div>

        <!-- Special Toggle: Heating Breast Milk or Formula? -->
        <div class="p-4 rounded-xl bg-error-bg/45 dark:bg-red-950/25 border border-error-border/70 space-y-3">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div>
              <span class="block text-xs sm:text-sm font-bold text-ink">
                🍼 {t.milkToggleTitle}
              </span>
              <span class="block text-[11.5px] text-body mt-0.5">
                {t.milkToggleSub}
              </span>
            </div>
            <div
              class="inline-flex rounded-lg border border-hairline bg-canvas p-0.5 shrink-0"
              role="radiogroup"
              aria-label={t.milkToggleTitle}
            >
              <button
                type="button"
                role="radio"
                aria-checked="true"
                data-bbsc-milk="off"
                class="bbsc-milk-btn px-3 py-1.5 rounded-md text-xs font-bold transition-all cursor-pointer bg-primary text-on-primary"
              >
                {t.milkToggleNo}
              </button>
              <button
                type="button"
                role="radio"
                aria-checked="false"
                data-bbsc-milk="on"
                class="bbsc-milk-btn px-3 py-1.5 rounded-md text-xs font-bold transition-all cursor-pointer text-ink hover:bg-surface-soft"
              >
                {t.milkToggleYes}
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Live Nursery Safety Verdict Dashboard -->
      <div class="lg:col-span-6 p-5 sm:p-6 bg-surface-soft/50 flex flex-col justify-between space-y-4">
        <div class="space-y-4">
          <!-- High-Contrast Live Verdict Banner -->
          <div
            id="bbsc-verdict-banner"
            aria-live="polite"
            class="rounded-2xl bg-surface-dark text-on-dark p-5 sm:p-6 space-y-4 shadow-sm border-l-4 border-error-border"
          >
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span class="text-[11px] font-bold uppercase tracking-wider text-signature-peach">
                {t.verdictBadge}
              </span>
              <span
                id="bbsc-verdict-pill"
                class={getVerdictPillClass(defaultVerdict)}
              >
                {getVerdictLabel(defaultVerdict)}
              </span>
            </div>

            <div class="space-y-1.5">
              <div class="flex items-start gap-2.5">
                <span id="bbsc-banner-icon" aria-hidden="true" class="text-2xl shrink-0 leading-none mt-0.5">
                  🚫
                </span>
                <div class="min-w-0">
                  <h2 id="bbsc-banner-title" class="text-lg sm:text-xl font-extrabold tracking-tight text-white leading-snug">
                    {defaultItem.name}
                  </h2>
                  <p id="bbsc-banner-task" class="text-xs font-semibold text-signature-yellow mt-0.5">
                    {localizedAppliances[0].icon} {localizedAppliances[0].label} — {localizedAppliances[0].sub}
                  </p>
                  <p id="bbsc-verdict-note" class="text-xs sm:text-[13px] text-white/90 leading-relaxed mt-2">
                    {defaultNote}
                  </p>
                </div>
              </div>
            </div>

            <!-- Max Safe Temperature Strip -->
            <div class="p-3 rounded-xl bg-white/5 border border-white/10 flex flex-wrap items-center justify-between gap-2 text-xs">
              <span class="text-white/75 font-medium">🌡️ {t.maxTempLabel}:</span>
              <span id="bbsc-max-temp" class="font-mono font-bold text-signature-mint">
                {defaultItem.maxTemp}
              </span>
            </div>

            <!-- 5-Appliance Mini Matrix for Selected Item -->
            <div class="space-y-2">
              <span class="block text-[11px] font-medium text-white/75">{t.matrixMiniTitle}</span>
              <div class="grid grid-cols-5 gap-1.5">
                {localizedAppliances.map((app) => {
                  const v = defaultItem.verdicts[app.id];
                  return (
                    <button
                      type="button"
                      data-bbsc-mini-app={app.id}
                      class={`bbsc-mini-btn p-2 rounded-xl border text-center transition-all cursor-pointer ${
                        app.id === defaultAppliance
                          ? 'bg-white/20 border-white/60 ring-1 ring-white/50'
                          : 'bg-white/5 border-white/15 hover:bg-white/10'
                      }`}
                    >
                      <span aria-hidden="true" class="block text-sm leading-none">{app.icon}</span>
                      <span class="block text-[10px] font-semibold text-white/90 truncate mt-1">
                        {app.label}
                      </span>
                      <span
                        data-bbsc-mini-status={app.id}
                        class={`inline-block mt-1 px-1.5 py-0.5 rounded text-[9.5px] font-extrabold ${
                          v === 'safe'
                            ? 'bg-emerald-500/25 text-emerald-200'
                            : v === 'caution'
                              ? 'bg-amber-500/25 text-amber-200'
                              : 'bg-red-500/30 text-red-200'
                        }`}
                      >
                        {getVerdictLabel(v)}
                      </span>
                    </button>
                  );
                })}
              </div>
            </div>
          </div>

          <!-- Chemical / Microplastic / Mold Alert & Parent Care Tip -->
          <div class="grid grid-cols-1 gap-3">
            <div class="p-4 rounded-xl bg-warning-bg/55 dark:bg-amber-950/25 border border-warning-border/75 space-y-1">
              <h3 class="text-xs font-bold uppercase tracking-wider text-ink flex items-center gap-1.5">
                <span aria-hidden="true">⚠️</span> {t.riskAlertTitle}
              </h3>
              <p id="bbsc-risk-alert" class="text-xs sm:text-[13px] text-body leading-relaxed">
                {defaultItem.riskAlert}
              </p>
            </div>

            <div class="p-4 rounded-xl bg-canvas border border-hairline space-y-1">
              <h3 class="text-xs font-bold uppercase tracking-wider text-ink flex items-center gap-1.5">
                <span aria-hidden="true">💡</span> {t.parentTipTitle}
              </h3>
              <p id="bbsc-care-tip" class="text-xs sm:text-[13px] text-body leading-relaxed">
                {defaultItem.parentCareTip}
              </p>
            </div>
          </div>

          <!-- Action Buttons: Copy / Print / Reset -->
          <div class="flex flex-wrap items-center gap-2.5 print:hidden">
            <button
              type="button"
              id="bbsc-copy-btn"
              class="min-h-[44px] flex-1 px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold bg-primary text-on-primary hover:bg-primary-active transition-colors cursor-pointer shadow-sm"
            >
              <span id="bbsc-copy-label">📋 {t.copySummaryBtn}</span>
            </button>
            <button
              type="button"
              id="bbsc-print-btn"
              class="min-h-[44px] px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold bg-canvas text-ink border border-hairline hover:border-signature-coral transition-colors cursor-pointer"
            >
              🖨️ {t.printChartBtn}
            </button>
            <button
              type="button"
              id="bbsc-reset-btn"
              class="min-h-[44px] px-3.5 py-2.5 rounded-xl text-xs sm:text-sm font-semibold bg-canvas text-muted border border-hairline hover:border-border-strong hover:text-ink transition-colors cursor-pointer"
            >
              {t.resetBtn}
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Dedicated Breast Milk & Formula Warming Safety Alert Panel (Revealed when Toggle is ON) -->
    <div
      id="bbsc-milk-alert-panel"
      class="hidden border-t-2 border-error-border bg-error-bg/60 dark:bg-red-950/35 p-5 sm:p-6 space-y-4"
      role="region"
      aria-label={localizedMilkAlert.title}
    >
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div class="space-y-1.5 max-w-3xl">
          <span class="inline-block px-2.5 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wider bg-error-border text-white">
            🚨 {localizedMilkAlert.badge}
          </span>
          <h2 class="text-title-md font-extrabold text-ink leading-snug">
            {localizedMilkAlert.title}
          </h2>
          <p class="text-xs sm:text-sm text-body leading-relaxed">
            {localizedMilkAlert.summary}
          </p>
        </div>
      </div>

      <div class="p-4 rounded-xl bg-canvas border border-error-border/50 space-y-2.5">
        <h3 class="text-xs sm:text-sm font-bold text-ink">{localizedMilkAlert.stepsTitle}</h3>
        <ol class="space-y-2 text-xs sm:text-[13px] text-body list-decimal list-inside">
          {localizedMilkAlert.steps.map((step) => (
            <li class="leading-relaxed">{step}</li>
          ))}
        </ol>
      </div>
    </div>

    <!-- Search, Category Filter Pills & 14 Interactive Baby/Kids Kitchenware Cards -->
    <div class="border-t border-hairline p-5 sm:p-6 space-y-5">
      <div>
        <h2 class="text-title-md font-semibold text-ink">{t.matrixTitle}</h2>
        <p class="text-xs text-muted mt-0.5">{t.matrixSub}</p>
      </div>

      <!-- Search + Category Pills -->
      <div class="flex flex-col lg:flex-row lg:items-center gap-3 print:hidden">
        <div class="relative flex-1">
          <span aria-hidden="true" class="absolute left-3.5 top-1/2 -translate-y-1/2 text-muted text-sm pointer-events-none">🔎</span>
          <input
            type="search"
            id="bbsc-search-input"
            placeholder={t.searchPlaceholder}
            aria-label={t.searchPlaceholder}
            class="w-full h-11 pl-10 pr-4 rounded-xl bg-surface-soft border border-hairline text-ink text-sm focus:outline-none focus:border-info-border"
          />
        </div>

        <div class="flex flex-wrap gap-1.5" role="group" aria-label="Filter by Category">
          <button
            type="button"
            aria-pressed="true"
            data-bbsc-cat="all"
            class="bbsc-cat-btn min-h-[38px] px-3 py-1.5 rounded-full text-xs font-bold border transition-all cursor-pointer bg-primary text-on-primary border-primary"
          >
            {t.catAll} ({catCounts.all})
          </button>
          <button
            type="button"
            aria-pressed="false"
            data-bbsc-cat="bottles"
            class="bbsc-cat-btn min-h-[38px] px-3 py-1.5 rounded-full text-xs font-bold border transition-all cursor-pointer bg-canvas text-ink border-hairline hover:border-signature-coral"
          >
            🍼 {t.catBottles} ({catCounts.bottles})
          </button>
          <button
            type="button"
            aria-pressed="false"
            data-bbsc-cat="plates"
            class="bbsc-cat-btn min-h-[38px] px-3 py-1.5 rounded-full text-xs font-bold border transition-all cursor-pointer bg-canvas text-ink border-hairline hover:border-signature-coral"
          >
            🍽️ {t.catPlates} ({catCounts.plates})
          </button>
          <button
            type="button"
            aria-pressed="false"
            data-bbsc-cat="cups"
            class="bbsc-cat-btn min-h-[38px] px-3 py-1.5 rounded-full text-xs font-bold border transition-all cursor-pointer bg-canvas text-ink border-hairline hover:border-signature-coral"
          >
            🥤 {t.catCups} ({catCounts.cups})
          </button>
          <button
            type="button"
            aria-pressed="false"
            data-bbsc-cat="pacifiers"
            class="bbsc-cat-btn min-h-[38px] px-3 py-1.5 rounded-full text-xs font-bold border transition-all cursor-pointer bg-canvas text-ink border-hairline hover:border-signature-coral"
          >
            🧸 {t.catPacifiers} ({catCounts.pacifiers})
          </button>
        </div>
      </div>

      <!-- Empty Search State -->
      <div id="bbsc-empty-state" class="hidden p-8 rounded-xl bg-surface-soft border border-hairline text-center text-sm text-muted">
        {t.noResultsMsg}
      </div>

      <!-- 14 Color-Coded Interactive Item Cards (all SSR-rendered for SEO & instant paint) -->
      <div id="bbsc-item-grid" class="grid grid-cols-1 md:grid-cols-2 gap-3.5">
        {localizedItems.map((item) => {
          const v = item.verdicts[defaultAppliance];
          const isSelected = item.id === defaultItem.id;
          return (
            <article
              data-bbsc-card={item.id}
              data-bbsc-category={item.category}
              class={`bbsc-item-card p-4 rounded-xl border transition-all flex flex-col justify-between gap-3 cursor-pointer ${getVerdictCardClasses(v)} ${
                isSelected ? 'ring-2 ring-signature-coral' : 'hover:border-border-strong'
              }`}
            >
              <div class="space-y-2">
                <div class="flex items-start justify-between gap-2.5">
                  <div class="flex items-start gap-2.5 min-w-0">
                    <span aria-hidden="true" class="text-xl shrink-0 leading-none mt-0.5">{item.icon}</span>
                    <div class="min-w-0">
                      <h3 class="text-sm font-bold text-ink leading-snug">
                        {item.name}
                      </h3>
                      <p class="text-[11.5px] text-muted leading-snug mt-0.5">
                        {item.examples}
                      </p>
                    </div>
                  </div>
                  <span
                    data-bbsc-card-pill
                    class={`shrink-0 ${getVerdictPillClass(v)}`}
                  >
                    {getVerdictLabel(v)}
                  </span>
                </div>

                <p data-bbsc-card-note class="text-xs text-body leading-relaxed pt-1.5 border-t border-hairline/60">
                  {item.applianceNotes[defaultAppliance]}
                </p>
              </div>

              <div class="space-y-2 pt-1">
                <!-- 5-Appliance Compact Row -->
                <div class="flex flex-wrap gap-1">
                  {localizedAppliances.map((app) => {
                    const av = item.verdicts[app.id];
                    return (
                      <span
                        title={`${app.label}: ${getVerdictLabel(av)}`}
                        class={`inline-flex items-center gap-1 px-1.5 py-0.5 rounded border text-[10.5px] font-semibold ${getMiniDotClass(av)}`}
                      >
                        <span aria-hidden="true">{app.icon}</span>
                        <span>{getMiniStatusChar(av)}</span>
                      </span>
                    );
                  })}
                </div>

                <div class="flex items-center justify-between gap-2 text-[11px]">
                  <span class="px-2 py-0.5 rounded bg-surface-soft border border-hairline text-muted font-mono font-medium truncate">
                    🌡️ {item.maxTemp}
                  </span>
                  <button
                    type="button"
                    data-bbsc-select-btn={item.id}
                    class="bbsc-card-select-btn shrink-0 px-2.5 py-1 rounded-lg font-bold text-ink bg-surface-soft border border-hairline hover:border-signature-coral transition-colors cursor-pointer print:hidden"
                  >
                    {isSelected ? t.selectedBadge : t.inspectBtn}
                  </button>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>

    <!-- 3-Card Nursery Kitchen Safety Essentials Strip -->
    <div class="border-t border-hairline p-5 sm:p-6 bg-surface-soft/50 space-y-4">
      <div>
        <h2 class="text-title-md font-semibold text-ink">{t.goldenRulesTitle}</h2>
        <p class="text-xs text-muted mt-0.5">{t.goldenRulesSub}</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <article class="p-4 rounded-xl border bg-error-bg/55 dark:bg-red-950/25 border-error-border/70 space-y-1.5">
          <div class="flex items-center gap-2">
            <span aria-hidden="true" class="text-lg">🚫</span>
            <h3 class="text-xs sm:text-sm font-bold text-ink leading-snug">{t.rule1Title}</h3>
          </div>
          <p class="text-xs text-body leading-relaxed">{t.rule1Body}</p>
        </article>
        <article class="p-4 rounded-xl border bg-warning-bg/65 dark:bg-amber-950/25 border-warning-border/70 space-y-1.5">
          <div class="flex items-center gap-2">
            <span aria-hidden="true" class="text-lg">🧼</span>
            <h3 class="text-xs sm:text-sm font-bold text-ink leading-snug">{t.rule2Title}</h3>
          </div>
          <p class="text-xs text-body leading-relaxed">{t.rule2Body}</p>
        </article>
        <article class="p-4 rounded-xl border bg-canvas border-hairline space-y-1.5">
          <div class="flex items-center gap-2">
            <span aria-hidden="true" class="text-lg">🔍</span>
            <h3 class="text-xs sm:text-sm font-bold text-ink leading-snug">{t.rule3Title}</h3>
          </div>
          <p class="text-xs text-body leading-relaxed">{t.rule3Body}</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Related Verified Companion Tools -->
  <section class="space-y-4 print:hidden">
    <h2 class="text-title-md font-semibold text-ink">{t.relatedHeading}</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      <a
        href={plasticCodeUrl}
        class="p-6 rounded-2xl bg-surface-soft border border-hairline hover:border-signature-coral transition-all group block"
      >
        <span class="text-[11px] font-bold uppercase tracking-wider text-signature-coral block mb-1.5">
          {t.relatedPlasticTag}
        </span>
        <h3 class="text-title-sm font-semibold text-ink group-hover:text-signature-coral transition-colors mb-1.5">
          {t.relatedPlasticTitle}
        </h3>
        <p class="text-[13.5px] text-body leading-relaxed">{t.relatedPlasticDesc}</p>
      </a>

      <a
        href={symbolDecoderUrl}
        class="p-6 rounded-2xl bg-surface-soft border border-hairline hover:border-signature-coral transition-all group block"
      >
        <span class="text-[11px] font-bold uppercase tracking-wider text-signature-coral block mb-1.5">
          {t.relatedSymbolTag}
        </span>
        <h3 class="text-title-sm font-semibold text-ink group-hover:text-signature-coral transition-colors mb-1.5">
          {t.relatedSymbolTitle}
        </h3>
        <p class="text-[13.5px] text-body leading-relaxed">{t.relatedSymbolDesc}</p>
      </a>

      <a
        href={powerOutageUrl}
        class="p-6 rounded-2xl bg-surface-soft border border-hairline hover:border-signature-coral transition-all group block"
      >
        <span class="text-[11px] font-bold uppercase tracking-wider text-signature-coral block mb-1.5">
          {t.relatedOutageTag}
        </span>
        <h3 class="text-title-sm font-semibold text-ink group-hover:text-signature-coral transition-colors mb-1.5">
          {t.relatedOutageTitle}
        </h3>
        <p class="text-[13.5px] text-body leading-relaxed">{t.relatedOutageDesc}</p>
      </a>
    </div>
  </section>

  <!-- Methodology & Reference Hub Strip -->
  <section class="p-6 rounded-2xl bg-surface-soft border border-hairline print:hidden">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <h2 class="text-title-sm font-semibold text-ink mb-1">{t.methodologyStripTitle}</h2>
        <p class="text-[13px] text-muted">
          {t.methodologyStripPrefix}{' '}
          <a href={methodologyUrl} class="text-link underline hover:text-link-active">{t.methodologyLabel}</a>.
        </p>
      </div>
      <div class="flex flex-wrap gap-2">
        <a
          href={plasticCodeUrl}
          class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral transition-colors"
        >
          {t.plasticCheckerLabel}
        </a>
        <a
          href={methodologyUrl}
          class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral transition-colors"
        >
          {t.methodologyLabel}
        </a>
        <a
          href={allToolsUrl}
          class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-primary text-on-primary hover:bg-primary-active transition-colors"
        >
          {t.allToolsLabel}
        </a>
      </div>
    </div>
  </section>

  <!-- Visible FAQ Accordion (Matches JSON-LD 1:1) -->
  <section class="print:hidden">
    <h2 class="text-title-lg font-medium text-ink tracking-tight mb-6">
      {t.faqTitle}
    </h2>
    <div class="space-y-4">
      {localizedFaqs.map((faq) => (
        <details class="group p-5 bg-surface-soft border border-hairline rounded-xl" open>
          <summary class="text-title-sm font-semibold text-ink cursor-pointer list-none flex items-center justify-between gap-3">
            <span>{faq.question}</span>
            <span class="text-muted text-sm transition-transform group-open:rotate-180 shrink-0" aria-hidden="true">&#9662;</span>
          </summary>
          <p class="text-[14px] text-body leading-relaxed mt-3 pt-3 border-t border-hairline/70">
            {faq.answer}
          </p>
        </details>
      ))}
    </div>
  </section>
</div>

<script is:inline>
  (function () {
    const payloadEl = document.getElementById('bbsc-payload');
    if (!payloadEl) return;

    let payload;
    try {
      payload = JSON.parse(payloadEl.textContent || '{}');
    } catch (_) {
      return;
    }

    const items = payload.items || [];
    const appliances = payload.appliances || [];
    const milkAlert = payload.milkAlert || {};
    const ui = payload.ui || {};

    if (!items.length || !appliances.length) return;

    const itemById = new Map(items.map(function (it) { return [it.id, it]; }));
    const appById = new Map(appliances.map(function (ap) { return [ap.id, ap]; }));

    // Controls
    const itemSelect = document.getElementById('bbsc-item-select');
    const quickBtns = Array.from(document.querySelectorAll('.bbsc-quick-btn'));
    const appBtns = Array.from(document.querySelectorAll('.bbsc-app-btn'));
    const miniBtns = Array.from(document.querySelectorAll('.bbsc-mini-btn'));
    const milkBtns = Array.from(document.querySelectorAll('.bbsc-milk-btn'));
    const catBtns = Array.from(document.querySelectorAll('.bbsc-cat-btn'));
    const cardEls = Array.from(document.querySelectorAll('.bbsc-item-card'));
    const searchInput = document.getElementById('bbsc-search-input');

    // Dashboard outputs
    const checkerSection = document.getElementById('baby-bottle-safety-checker');
    const verdictBanner = document.getElementById('bbsc-verdict-banner');
    const verdictPill = document.getElementById('bbsc-verdict-pill');
    const bannerIcon = document.getElementById('bbsc-banner-icon');
    const bannerTitle = document.getElementById('bbsc-banner-title');
    const bannerTask = document.getElementById('bbsc-banner-task');
    const verdictNote = document.getElementById('bbsc-verdict-note');
    const maxTempEl = document.getElementById('bbsc-max-temp');
    const riskAlertEl = document.getElementById('bbsc-risk-alert');
    const careTipEl = document.getElementById('bbsc-care-tip');
    const milkAlertPanel = document.getElementById('bbsc-milk-alert-panel');
    const emptyStateEl = document.getElementById('bbsc-empty-state');

    // Action buttons
    const copyBtn = document.getElementById('bbsc-copy-btn');
    const copyLabel = document.getElementById('bbsc-copy-label');
    const printBtn = document.getElementById('bbsc-print-btn');
    const resetBtn = document.getElementById('bbsc-reset-btn');

    const state = {
      itemId: items[0].id,
      applianceId: 'microwave',
      heatingMilk: false,
      category: 'all',
      query: ''
    };

    let lastSummaryText = '';

    function getVerdictLabel(v) {
      if (v === 'safe') return ui.verdictSafe || 'SAFE';
      if (v === 'caution') return ui.verdictCaution || 'CAUTION';
      return ui.verdictUnsafe || 'UNSAFE';
    }

    function getVerdictPillClass(v) {
      if (v === 'safe') return 'badge-yes';
      if (v === 'caution') return 'badge-depends';
      return 'badge-no';
    }

    function getVerdictIcon(v) {
      if (v === 'safe') return '✅';
      if (v === 'caution') return '⚠️';
      return '🚫';
    }

    function getEffectiveVerdict(item, applianceId) {
      const baseVerdict = (item.verdicts && item.verdicts[applianceId]) || 'caution';
      const baseNote = (item.applianceNotes && item.applianceNotes[applianceId]) || '';

      if (state.heatingMilk && applianceId === 'microwave') {
        return {
          verdict: 'unsafe',
          pillLabel: milkAlert.overrideVerdict || getVerdictLabel('unsafe'),
          note: milkAlert.overrideReason || baseNote
        };
      }

      return {
        verdict: baseVerdict,
        pillLabel: getVerdictLabel(baseVerdict),
        note: baseNote
      };
    }

    function applyControlStyles() {
      if (itemSelect && itemSelect.value !== state.itemId) {
        itemSelect.value = state.itemId;
      }

      quickBtns.forEach(function (btn) {
        const active = btn.getAttribute('data-bbsc-quick') === state.itemId;
        btn.classList.toggle('bg-signature-coral', active);
        btn.classList.toggle('text-white', active);
        btn.classList.toggle('border-signature-coral', active);
        btn.classList.toggle('shadow-sm', active);
        btn.classList.toggle('bg-canvas', !active);
        btn.classList.toggle('text-ink', !active);
        btn.classList.toggle('border-hairline', !active);
      });

      appBtns.forEach(function (btn) {
        const active = btn.getAttribute('data-bbsc-appliance') === state.applianceId;
        btn.setAttribute('aria-checked', active ? 'true' : 'false');
        btn.classList.toggle('bg-primary', active);
        btn.classList.toggle('text-on-primary', active);
        btn.classList.toggle('border-primary', active);
        btn.classList.toggle('shadow-sm', active);
        btn.classList.toggle('bg-canvas', !active);
        btn.classList.toggle('text-ink', !active);
        btn.classList.toggle('border-hairline', !active);
      });

      milkBtns.forEach(function (btn) {
        const isOn = btn.getAttribute('data-bbsc-milk') === 'on';
        const active = isOn === state.heatingMilk;
        btn.setAttribute('aria-checked', active ? 'true' : 'false');
        btn.classList.toggle('bg-primary', active && !isOn);
        btn.classList.toggle('bg-error-border', active && isOn);
        btn.classList.toggle('text-on-primary', active && !isOn);
        btn.classList.toggle('text-white', active && isOn);
        btn.classList.toggle('text-ink', !active);
      });

      if (milkAlertPanel) {
        milkAlertPanel.classList.toggle('hidden', !state.heatingMilk);
      }

      catBtns.forEach(function (btn) {
        const active = btn.getAttribute('data-bbsc-cat') === state.category;
        btn.setAttribute('aria-pressed', active ? 'true' : 'false');
        btn.classList.toggle('bg-primary', active);
        btn.classList.toggle('text-on-primary', active);
        btn.classList.toggle('border-primary', active);
        btn.classList.toggle('bg-canvas', !active);
        btn.classList.toggle('text-ink', !active);
        btn.classList.toggle('border-hairline', !active);
      });
    }

    function updateCardClasses(cardEl, verdict, isSelected) {
      cardEl.classList.remove(
        'border-success-border/60',
        'bg-canvas',
        'border-warning-border/80',
        'bg-warning-bg/35',
        'dark:bg-amber-950/20',
        'border-error-border/70',
        'bg-error-bg/45',
        'dark:bg-red-950/20',
        'ring-2',
        'ring-signature-coral',
        'hover:border-border-strong'
      );

      if (verdict === 'safe') {
        cardEl.classList.add('border-success-border/60', 'bg-canvas');
      } else if (verdict === 'caution') {
        cardEl.classList.add('border-warning-border/80', 'bg-warning-bg/35', 'dark:bg-amber-950/20');
      } else {
        cardEl.classList.add('border-error-border/70', 'bg-error-bg/45', 'dark:bg-red-950/20');
      }

      if (isSelected) {
        cardEl.classList.add('ring-2', 'ring-signature-coral');
      } else {
        cardEl.classList.add('hover:border-border-strong');
      }
    }

    function render() {
      applyControlStyles();

      const activeItem = itemById.get(state.itemId) || items[0];
      const activeApp = appById.get(state.applianceId) || appliances[0];
      const eff = getEffectiveVerdict(activeItem, activeApp.id);

      // Update live dashboard
      if (bannerIcon) bannerIcon.textContent = getVerdictIcon(eff.verdict);
      if (bannerTitle) bannerTitle.textContent = activeItem.name;
      if (bannerTask) bannerTask.textContent = activeApp.icon + ' ' + activeApp.label + ' — ' + activeApp.sub;
      if (verdictNote) verdictNote.textContent = eff.note;
      if (maxTempEl) maxTempEl.textContent = activeItem.maxTemp;
      if (riskAlertEl) riskAlertEl.textContent = activeItem.riskAlert;
      if (careTipEl) careTipEl.textContent = activeItem.parentCareTip;

      if (verdictPill) {
        verdictPill.className = getVerdictPillClass(eff.verdict);
        verdictPill.textContent = eff.pillLabel;
      }

      if (verdictBanner) {
        verdictBanner.classList.remove('border-success-border', 'border-warning-border', 'border-error-border');
        verdictBanner.classList.add(
          eff.verdict === 'safe'
            ? 'border-success-border'
            : eff.verdict === 'caution'
              ? 'border-warning-border'
              : 'border-error-border'
        );
      }

      // Update 5-appliance mini buttons inside dashboard
      miniBtns.forEach(function (btn) {
        const aid = btn.getAttribute('data-bbsc-mini-app') || '';
        const isCurrent = aid === state.applianceId;
        btn.classList.toggle('bg-white/20', isCurrent);
        btn.classList.toggle('border-white/60', isCurrent);
        btn.classList.toggle('ring-1', isCurrent);
        btn.classList.toggle('ring-white/50', isCurrent);
        btn.classList.toggle('bg-white/5', !isCurrent);
        btn.classList.toggle('border-white/15', !isCurrent);

        const statusEl = btn.querySelector('[data-bbsc-mini-status]');
        if (statusEl) {
          const mv = getEffectiveVerdict(activeItem, aid).verdict;
          statusEl.textContent = getVerdictLabel(mv);
          statusEl.className =
            'inline-block mt-1 px-1.5 py-0.5 rounded text-[9.5px] font-extrabold ' +
            (mv === 'safe'
              ? 'bg-emerald-500/25 text-emerald-200'
              : mv === 'caution'
                ? 'bg-amber-500/25 text-amber-200'
                : 'bg-red-500/30 text-red-200');
        }
      });

      // Update all 14 item cards
      const queryLower = state.query.trim().toLowerCase();
      let visibleCount = 0;

      cardEls.forEach(function (cardEl) {
        const cid = cardEl.getAttribute('data-bbsc-card') || '';
        const item = itemById.get(cid);
        if (!item) return;

        const cardEff = getEffectiveVerdict(item, state.applianceId);
        const isSelected = cid === state.itemId;
        updateCardClasses(cardEl, cardEff.verdict, isSelected);

        const pillEl = cardEl.querySelector('[data-bbsc-card-pill]');
        if (pillEl) {
          pillEl.className = 'shrink-0 ' + getVerdictPillClass(cardEff.verdict);
          pillEl.textContent = getVerdictLabel(cardEff.verdict);
        }

        const noteEl = cardEl.querySelector('[data-bbsc-card-note]');
        if (noteEl) {
          noteEl.textContent = cardEff.note;
        }

        const selBtn = cardEl.querySelector('.bbsc-card-select-btn');
        if (selBtn) {
          selBtn.textContent = isSelected ? (ui.selectedBadge || 'Selected') : (ui.inspectBtn || 'Inspect');
          selBtn.classList.toggle('bg-signature-coral', isSelected);
          selBtn.classList.toggle('text-white', isSelected);
          selBtn.classList.toggle('border-signature-coral', isSelected);
          selBtn.classList.toggle('bg-surface-soft', !isSelected);
          selBtn.classList.toggle('text-ink', !isSelected);
          selBtn.classList.toggle('border-hairline', !isSelected);
        }

        const matchesCat = state.category === 'all' || item.category === state.category;
        const matchesQuery =
          queryLower.length === 0 ||
          item.name.toLowerCase().indexOf(queryLower) !== -1 ||
          item.examples.toLowerCase().indexOf(queryLower) !== -1 ||
          item.riskAlert.toLowerCase().indexOf(queryLower) !== -1 ||
          item.parentCareTip.toLowerCase().indexOf(queryLower) !== -1;

        const show = matchesCat && matchesQuery;
        cardEl.classList.toggle('hidden', !show);
        if (show) visibleCount += 1;
      });

      if (emptyStateEl) {
        emptyStateEl.classList.toggle('hidden', visibleCount > 0);
      }

      // Build plain-text Parent Care Summary
      const matrixLines = appliances.map(function (ap) {
        const av = getEffectiveVerdict(activeItem, ap.id).verdict;
        return '  - ' + ap.label + ': ' + getVerdictLabel(av);
      });

      const summaryLines = [
        ui.copyHeader || 'Baby Bottle & Kids Kitchenware Safety Summary',
        (ui.copyItemLine || 'Item') + ': ' + activeItem.name,
        (ui.copyTaskLine || 'Task') + ': ' + activeApp.label + ' (' + activeApp.sub + ')',
        (ui.copyVerdictLine || 'Verdict') + ': ' + eff.pillLabel + ' — ' + eff.note,
        (ui.copyMaxTempLine || 'Max Temp') + ': ' + activeItem.maxTemp,
        '',
        (ui.copyAlertLine || 'Safety Alert') + ': ' + activeItem.riskAlert,
        (ui.copyTipLine || 'Parent Care Tip') + ': ' + activeItem.parentCareTip,
        '',
        ui.copyMatrixHeader || '5-Appliance Summary:',
        matrixLines.join('\n'),
        '',
        ui.copyMilkReminder || 'AAP/CDC Reminder: NEVER microwave breast milk or infant formula.'
      ];

      lastSummaryText = summaryLines.join('\n');
    }

    // Event bindings
    if (itemSelect) {
      itemSelect.addEventListener('change', function () {
        if (itemById.has(itemSelect.value)) {
          state.itemId = itemSelect.value;
          render();
        }
      });
    }

    quickBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        const id = btn.getAttribute('data-bbsc-quick');
        if (id && itemById.has(id)) {
          state.itemId = id;
          render();
        }
      });
    });

    appBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        const aid = btn.getAttribute('data-bbsc-appliance');
        if (aid && appById.has(aid)) {
          state.applianceId = aid;
          render();
        }
      });
    });

    miniBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        const aid = btn.getAttribute('data-bbsc-mini-app');
        if (aid && appById.has(aid)) {
          state.applianceId = aid;
          render();
        }
      });
    });

    milkBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        state.heatingMilk = btn.getAttribute('data-bbsc-milk') === 'on';
        render();
      });
    });

    catBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        state.category = btn.getAttribute('data-bbsc-cat') || 'all';
        render();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', function () {
        state.query = searchInput.value || '';
        render();
      });
    }

    cardEls.forEach(function (cardEl) {
      cardEl.addEventListener('click', function () {
        const cid = cardEl.getAttribute('data-bbsc-card');
        if (cid && itemById.has(cid)) {
          state.itemId = cid;
          render();
          if (checkerSection && typeof checkerSection.scrollIntoView === 'function') {
            checkerSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }
      });
    });

    if (copyBtn) {
      copyBtn.addEventListener('click', function () {
        const showCopied = function () {
          if (copyLabel) copyLabel.textContent = ui.copiedSummaryBtn || 'Summary Copied ✓';
          window.setTimeout(function () {
            if (copyLabel) copyLabel.textContent = '📋 ' + (ui.copySummaryBtn || 'Copy Parent Care Summary');
          }, 2200);
        };

        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(lastSummaryText).then(showCopied).catch(showCopied);
        } else {
          const ta = document.createElement('textarea');
          ta.value = lastSummaryText;
          ta.setAttribute('readonly', '');
          ta.style.position = 'absolute';
          ta.style.left = '-9999px';
          document.body.appendChild(ta);
          ta.select();
          try {
            document.execCommand('copy');
          } catch (_) {
            // ignore
          }
          document.body.removeChild(ta);
          showCopied();
        }
      });
    }

    if (printBtn) {
      printBtn.addEventListener('click', function () {
        window.print();
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', function () {
        state.itemId = items[0].id;
        state.applianceId = 'microwave';
        state.heatingMilk = false;
        state.category = 'all';
        state.query = '';
        if (searchInput) searchInput.value = '';
        render();
      });
    }

    render();
  })();
</script>
