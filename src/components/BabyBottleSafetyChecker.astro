---
import rawData from '../data/baby-bottle-safety-data.json';
import type { SupportedLanguage } from '../i18n/ui';
import { useTranslatedPath } from '../i18n/utils';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;
const translatePath = useTranslatedPath(lang);

const plasticCodeUrl = translatePath('/tools/plastic-code-checker/');
const symbolDecoderUrl = translatePath('/tools/kitchen-symbol-decoder/');
const powerOutageUrl = translatePath('/tools/power-outage-food-safety-checker/');
const methodologyUrl = translatePath('/methodology/');
const allToolsUrl = translatePath('/tools/');

type ApplianceId = 'microwave' | 'dishwasher' | 'steam-boil' | 'uv-sterilizer' | 'freezer';
type CategoryId = 'all' | 'bottles' | 'plates' | 'cups' | 'pacifiers';
type VerdictLevel = 'safe' | 'caution' | 'unsafe';

interface LocalizedAppliance {
  id: ApplianceId;
  icon: string;
  label: string;
  sub: string;
}

interface LocalizedItem {
  id: string;
  icon: string;
  category: Exclude<CategoryId, 'all'>;
  milkContainer: boolean;
  maxTempF: number;
  maxTempC: number;
  verdicts: Record<ApplianceId, VerdictLevel>;
  name: string;
  examples: string;
  maxTemp: string;
  riskAlert: string;
  parentCareTip: string;
  applianceNotes: Record<ApplianceId, string>;
}

const localizedAppliances: LocalizedAppliance[] = rawData.appliances.map((a) => {
  const tr = (a.i18n as Record<string, any>)[lang] || a.i18n.en;
  return {
    id: a.id as ApplianceId,
    icon: a.icon,
    label: tr.label,
    sub: tr.sub
  };
});

const localizedItems: LocalizedItem[] = rawData.items.map((item) => {
  const tr = (item.i18n as Record<string, any>)[lang] || item.i18n.en;
  return {
    id: item.id,
    icon: item.icon,
    category: item.category as Exclude<CategoryId, 'all'>,
    milkContainer: Boolean(item.milkContainer),
    maxTempF: item.maxTempF,
    maxTempC: item.maxTempC,
    verdicts: item.verdicts as Record<ApplianceId, VerdictLevel>,
    name: tr.name,
    examples: tr.examples,
    maxTemp: tr.maxTemp,
    riskAlert: tr.riskAlert,
    parentCareTip: tr.parentCareTip,
    applianceNotes: tr.applianceNotes as Record<ApplianceId, string>
  };
});

const localizedMilkAlert =
  (rawData.milkAlert as Record<string, {
    badge: string;
    title: string;
    summary: string;
    stepsTitle: string;
    steps: string[];
    overrideVerdict: string;
    overrideReason: string;
  }>)[lang] || rawData.milkAlert.en;

const localizedFaqs: Array<{ question: string; answer: string }> =
  (rawData.faqs as Record<string, Array<{ question: string; answer: string }>>)[lang] ||
  rawData.faqs.en;

