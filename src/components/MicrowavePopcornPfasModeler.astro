            <div class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-extrabold uppercase tracking-wider bg-emerald-500/10 text-emerald-700 mb-2 border border-emerald-500/20">
              100% Non-Toxic
            </div>
