          <tr>
            <th class="py-3.5 px-4">{c.colCoating}</th>
            <th class="py-3.5 px-4">{c.colChemistry}</th>
            <th class="py-3.5 px-4">{c.colFluorinePpm}</th>
            <th class="py-3.5 px-4">{c.colMigration}</th>
            <th class="py-3.5 px-4">{c.colVaporVol}</th>
            <th class="py-3.5 px-4">{c.colHalfLife}</th>
            <th class="py-3.5 px-4">{c.colStatus}</th>
