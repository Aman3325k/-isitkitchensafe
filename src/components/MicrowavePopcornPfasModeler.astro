    <div class="flex flex-wrap gap-2">
      <a href="/tools/air-fryer-teflon-fluoropolymer-modeler/" class="text-amber-600 hover:text-amber-700 font-medium underline underline-offset-4">
        {c.crossLinkAirFryer} &rarr;
      </a>
      <span class="text-muted">&bull;</span>
      <a href="/tools/toxic-leaching-scorecard/" class="text-amber-600 hover:text-amber-700 font-medium underline underline-offset-4">
        {c.crossLinkToxScorecard} &rarr;
      </a>
      <span class="text-muted">&bull;</span>
      <a href="/tools/food-contact-migration-predictor/" class="text-amber-600 hover:text-amber-700 font-medium underline underline-offset-4">
        {c.crossLinkMigration} &rarr;
