            <div class="flex justify-between"><span class="text-muted">Efficiency:</span><span class="font-medium text-ink">{alt.popEfficiency}</span></div>
            <div class="flex justify-between"><span class="text-muted">Savings:</span><span class="font-medium text-ink">{alt.annualSavingsVsBags}</span></div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- 5 Golden Rules Section -->
  <div class="mt-12 pt-10 border-t border-hairline">
    <div class="mb-6">
      <h3 class="text-xl font-extrabold text-ink tracking-tight mb-1">
        {c.rulesTitle}
      </h3>
      <p class="text-body text-xs md:text-sm">
        {c.rulesSub}
