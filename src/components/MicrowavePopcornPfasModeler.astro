};

const c = dict[lang] || dict.en;
---

<section class="my-10 bg-surface border border-hairline rounded-3xl p-6 md:p-10 shadow-sm" id="microwave-popcorn-modeler">
  <!-- Top Badge & Header -->
  <div class="flex flex-wrap items-center justify-between gap-4 mb-8 pb-6 border-b border-hairline">
    <div>
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20 mb-2">
        <span class="inline-block w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
        {c.badge}
      </div>
      <h2 class="text-2xl md:text-3xl font-extrabold text-ink tracking-tight">
        {c.title}
      </h2>
      <p class="text-body text-sm md:text-base mt-1 max-w-3xl leading-relaxed">
        {c.subtitle}
      </p>
    </div>

    <!-- Quick Telemetry Badge -->
    <div class="flex items-center gap-3 bg-surface-soft border border-hairline rounded-2xl px-5 py-3">
      <div class="text-right">
        <div class="text-[11px] uppercase tracking-wider text-muted font-bold">Standard Metric</div>
        <div class="text-xs font-semibold text-ink">EFSA TWI: 4.4 ng/kg/wk &bull; FDA 2024 Ban</div>
      </div>
      <div class="w-10 h-10 rounded-xl bg-amber-500/10 flex items-center justify-center text-amber-600 text-xl font-black">
        🍿
      </div>
    </div>
  </div>

  <!-- Presets Bar -->
  <div class="mb-8 p-4 bg-surface-soft border border-hairline rounded-2xl">
    <div class="text-xs font-bold uppercase tracking-wider text-muted mb-3 flex items-center gap-2">
      <svg class="w-4 h-4 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
      </svg>
      {c.presetsTitle}
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5">
      <button 
        type="button" 
        data-preset="clean" 
        class="preset-btn text-left p-3 rounded-xl border border-hairline bg-surface hover:bg-amber-500/5 hover:border-amber-500/30 transition-all text-xs font-medium text-ink flex items-start gap-2 shadow-2xs"
      >
        <span>{c.presetClean}</span>
      </button>
      <button 
        type="button" 
        data-preset="standard" 
        class="preset-btn text-left p-3 rounded-xl border border-hairline bg-surface hover:bg-amber-500/5 hover:border-amber-500/30 transition-all text-xs font-medium text-ink flex items-start gap-2 shadow-2xs"
      >
        <span>{c.presetStandard}</span>
      </button>
      <button 
        type="button" 
        data-preset="legacy" 
        class="preset-btn text-left p-3 rounded-xl border border-hairline bg-surface hover:bg-red-500/5 hover:border-red-500/30 transition-all text-xs font-medium text-ink flex items-start gap-2 shadow-2xs"
      >
        <span>{c.presetLegacy}</span>
      </button>
      <button 
        type="button" 
        data-preset="child" 
        class="preset-btn text-left p-3 rounded-xl border border-hairline bg-surface hover:bg-amber-500/5 hover:border-amber-500/30 transition-all text-xs font-medium text-ink flex items-start gap-2 shadow-2xs"
      >
        <span>{c.presetChild}</span>
      </button>
    </div>
  </div>

  <!-- Main Grid: Controls (Left) & Telemetry (Right) -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    
    <!-- Left Column: Controls (7 cols) -->
    <div class="lg:col-span-7 space-y-6 bg-surface-soft/60 border border-hairline rounded-2xl p-6 md:p-7">
      <div>
        <h3 class="text-lg font-bold text-ink mb-1 flex items-center gap-2">
          <span>⚙️</span> {c.controlsTitle}
        </h3>
        <p class="text-xs text-body leading-relaxed">
          {c.controlsSub}
        </p>
      </div>

      <!-- Control 1: Bag Coating Type -->
      <div class="space-y-2">
        <label for="popcorn-coating" class="block text-xs font-bold uppercase tracking-wider text-ink">
          {c.coatingLabel}
        </label>
        <select 
          id="popcorn-coating" 
          class="w-full bg-surface border border-hairline rounded-xl px-4 py-3 text-sm text-ink font-medium focus:ring-2 focus:ring-amber-500 focus:outline-none transition-shadow shadow-2xs"
        >
          {popcornData.bagCoatingTypes.map((b) => (
            <option value={b.id} selected={b.id === 'short-chain-pfas'}>
              {b.name} ({b.fluorineContentPpm} ppm F)
            </option>
          ))}
        </select>
        <p class="text-[11px] text-muted leading-tight">
          {c.coatingHelp}
        </p>
      </div>

      <!-- Control 2: Molten Fat Matrix -->
      <div class="space-y-2">
        <label for="popcorn-fat" class="block text-xs font-bold uppercase tracking-wider text-ink">
          {c.fatLabel}
        </label>
        <select 
          id="popcorn-fat" 
          class="w-full bg-surface border border-hairline rounded-xl px-4 py-3 text-sm text-ink font-medium focus:ring-2 focus:ring-amber-500 focus:outline-none transition-shadow shadow-2xs"
        >
          {popcornData.fatMatrices.map((f) => (
            <option value={f.id} selected={f.id === 'extra-movie-butter'}>
              {f.name}
            </option>
          ))}
        </select>
        <p class="text-[11px] text-muted leading-tight">
          {c.fatHelp}
        </p>
      </div>

      <!-- Two-column Sliders: Wattage & Popping Time -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <!-- Control 3: Microwave Wattage -->
        <div class="space-y-2 bg-surface p-4 rounded-xl border border-hairline">
          <div class="flex items-center justify-between">
            <label for="popcorn-wattage" class="text-xs font-bold text-ink">
              {c.wattageLabel}
            </label>
            <span id="wattage-val" class="font-mono text-xs font-extrabold text-amber-600 bg-amber-500/10 px-2 py-0.5 rounded-md">
              1000 W
            </span>
          </div>
          <input 
            type="range" 
            id="popcorn-wattage" 
            min="700" 
            max="1250" 
            step="50" 
            value="1000" 
            class="w-full accent-amber-600 cursor-pointer"
          />
          <p class="text-[10px] text-muted leading-tight">
            {c.wattageHelp}
          </p>
        </div>

        <!-- Control 4: Popping Duration Seconds -->
        <div class="space-y-2 bg-surface p-4 rounded-xl border border-hairline">
          <div class="flex items-center justify-between">
            <label for="popcorn-time" class="text-xs font-bold text-ink">
              {c.timeLabel}
            </label>
            <span id="time-val" class="font-mono text-xs font-extrabold text-amber-600 bg-amber-500/10 px-2 py-0.5 rounded-md">
              150s (2:30)
            </span>
          </div>
          <input 
            type="range" 
            id="popcorn-time" 
            min="90" 
            max="210" 
            step="15" 
            value="150" 
            class="w-full accent-amber-600 cursor-pointer"
          />
          <p class="text-[10px] text-muted leading-tight">
            {c.timeHelp}
          </p>
        </div>
      </div>

      <!-- Control 5: Bag Opening Inhalation Technique -->
      <div class="space-y-2">
        <label for="popcorn-inhalation" class="block text-xs font-bold uppercase tracking-wider text-ink">
          {c.inhalationLabel}
        </label>
        <select 
          id="popcorn-inhalation" 
          class="w-full bg-surface border border-hairline rounded-xl px-4 py-3 text-sm text-ink font-medium focus:ring-2 focus:ring-amber-500 focus:outline-none transition-shadow shadow-2xs"
        >
          {popcornData.bagOpeningInhalationProfiles.map((p) => (
            <option value={p.id} selected={p.id === 'countertop-arms-length'}>
              {p.name}
            </option>
          ))}
        </select>
        <p class="text-[11px] text-muted leading-tight">
          {c.inhalationHelp}
        </p>
      </div>

      <!-- Two-column Sliders: Monthly Frequency & Body Weight -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <!-- Control 6: Monthly Frequency -->
        <div class="space-y-2 bg-surface p-4 rounded-xl border border-hairline">
          <div class="flex items-center justify-between">
            <label for="popcorn-freq" class="text-xs font-bold text-ink">
              {c.frequencyLabel}
            </label>
            <span id="freq-val" class="font-mono text-xs font-extrabold text-amber-600 bg-amber-500/10 px-2 py-0.5 rounded-md">
              4 bags/mo
            </span>
          </div>
          <input 
            type="range" 
            id="popcorn-freq" 
            min="1" 
            max="16" 
            step="1" 
            value="4" 
            class="w-full accent-amber-600 cursor-pointer"
          />
          <p class="text-[10px] text-muted leading-tight">
            {c.frequencyHelp}
          </p>
        </div>

        <!-- Control 7: Body Weight (kg) -->
        <div class="space-y-2 bg-surface p-4 rounded-xl border border-hairline">
          <div class="flex items-center justify-between">
            <label for="popcorn-weight" class="text-xs font-bold text-ink">
              {c.weightLabel}
            </label>
            <span id="weight-val" class="font-mono text-xs font-extrabold text-amber-600 bg-amber-500/10 px-2 py-0.5 rounded-md">
              70 kg (154 lb)
            </span>
          </div>
          <input 
            type="range" 
            id="popcorn-weight" 
            min="25" 
            max="115" 
            step="5" 
            value="70" 
            class="w-full accent-amber-600 cursor-pointer"
          />
          <p class="text-[10px] text-muted leading-tight">
            {c.weightHelp}
          </p>
        </div>
      </div>
    </div>

    <!-- Right Column: Live Telemetry Gauges (5 cols) -->
    <div class="lg:col-span-5 space-y-6">
      
      <!-- Primary Score Card -->
      <div class="bg-surface border border-hairline rounded-2xl p-6 shadow-sm relative overflow-hidden">
        <div class="flex items-center justify-between mb-4">
          <span class="text-xs font-bold uppercase tracking-wider text-muted">
            {c.overallScoreLabel}
          </span>
          <span id="safety-badge" class="px-3 py-1 rounded-full text-xs font-black uppercase tracking-wide bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20">
            EVALUATING
          </span>
        </div>

        <div class="flex items-baseline gap-3 mb-3">
          <span id="safety-score" class="text-5xl font-black text-ink tracking-tight font-mono">
            --
          </span>
          <span class="text-xs text-muted font-medium">/ 100 Safety Index</span>
        </div>

        <!-- Progress Bar -->
        <div class="w-full bg-surface-soft h-3 rounded-full overflow-hidden mb-5 border border-hairline">
          <div id="safety-bar" class="h-full bg-amber-500 transition-all duration-300 w-1/2"></div>
        </div>

        <!-- Real-Time Metrics Grid -->
        <div class="grid grid-cols-2 gap-3 pt-3 border-t border-hairline text-xs">
          <div class="bg-surface-soft p-3 rounded-xl border border-hairline">
            <div class="text-[11px] text-muted mb-1">{c.oralMigrationLabel}</div>
            <div id="metric-oral" class="font-mono text-sm font-extrabold text-ink">-- µg</div>
            <div id="metric-oral-sub" class="text-[10px] text-muted mt-0.5">Molten lipid phase</div>
          </div>

