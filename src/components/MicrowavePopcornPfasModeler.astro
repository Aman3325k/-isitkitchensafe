              <td class="py-3.5 px-4 font-bold text-ink">{row.name}</td>
              <td class="py-3.5 px-4 text-muted">{row.chemicalClass}</td>
              <td class="py-3.5 px-4 font-mono font-bold {row.fluorineContentPpm > 100 ? 'text-red-600' : 'text-emerald-600'}">
                {row.fluorineContentPpm} ppm
              </td>
              <td class="py-3.5 px-4 font-mono">{row.migrationRatePercent}%</td>
              <td class="py-3.5 px-4 font-mono">{row.volatilizationRatePpm > 0 ? `${row.volatilizationRatePpm} ppm` : '0 ppm'}</td>
              <td class="py-3.5 px-4 font-mono font-semibold">{row.humanHalfLifeYears > 0 ? `${row.humanHalfLifeYears} yrs` : '0 days'}</td>
              <td class="py-3.5 px-4">
                <span class="inline-block px-2.5 py-1 rounded-md text-[10px] font-bold {row.fluorineContentPpm > 50 ? 'bg-amber-500/10 text-amber-700' : 'bg-emerald-500/10 text-emerald-700'}">
                  {row.regulatoryStatus.split(';')[0]}
