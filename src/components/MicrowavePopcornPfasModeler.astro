    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      {popcornData.cleanPoppingAlternatives.map((alt) => (
        <div class="p-5 rounded-2xl border border-hairline bg-surface-soft flex flex-col justify-between shadow-2xs">
