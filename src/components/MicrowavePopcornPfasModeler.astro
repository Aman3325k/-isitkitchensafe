<!-- Client Script for Interactive Live Engine -->
<script define:vars={{ popcornData, currentLang: lang, dict }}>
  (function initPopcornModeler() {
    const coatingSelect = document.getElementById('popcorn-coating');
    const fatSelect = document.getElementById('popcorn-fat');
    const wattageSlider = document.getElementById('popcorn-wattage');
    const timeSlider = document.getElementById('popcorn-time');
    const inhalationSelect = document.getElementById('popcorn-inhalation');
    const freqSlider = document.getElementById('popcorn-freq');
    const weightSlider = document.getElementById('popcorn-weight');

    const wattageVal = document.getElementById('wattage-val');
    const timeVal = document.getElementById('time-val');
    const freqVal = document.getElementById('freq-val');
    const weightVal = document.getElementById('weight-val');

    const safetyScoreEl = document.getElementById('safety-score');
    const safetyBadgeEl = document.getElementById('safety-badge');
    const safetyBarEl = document.getElementById('safety-bar');

    const metricOralEl = document.getElementById('metric-oral');
    const metricAirEl = document.getElementById('metric-air');
    const metricTwiEl = document.getElementById('metric-twi');
    const metricTempEl = document.getElementById('metric-temp');
    const metricTempFEl = document.getElementById('metric-temp-f');
    const metricHalfLifeEl = document.getElementById('metric-halflife');
    const metricHalfLifeBadgeEl = document.getElementById('metric-halflife-badge');
    const assessmentTextEl = document.getElementById('assessment-text');
    const copyBtn = document.getElementById('copy-report-btn');
    const copyBtnText = document.getElementById('copy-btn-text');

    if (!coatingSelect || !fatSelect) return;

    function recalculate() {
      const coatingId = coatingSelect.value;
      const fatId = fatSelect.value;
      const wattage = parseInt(wattageSlider.value, 10);
      const durationSec = parseInt(timeSlider.value, 10);
      const inhalationId = inhalationSelect.value;
      const monthlyBags = parseInt(freqSlider.value, 10);
      const bodyWeightKg = parseInt(weightSlider.value, 10);

      // Sliders UI sync
      wattageVal.textContent = `${wattage} W`;
      const mins = Math.floor(durationSec / 60);
      const remSecs = durationSec % 60;
      timeVal.textContent = `${durationSec}s (${mins}:${remSecs < 10 ? '0' : ''}${remSecs})`;
      freqVal.textContent = `${monthlyBags} bags/mo`;
      const weightLbs = Math.round(bodyWeightKg * 2.20462);
      weightVal.textContent = `${bodyWeightKg} kg (${weightLbs} lb)`;

      // Lookup data objects
      const coating = popcornData.bagCoatingTypes.find(b => b.id === coatingId) || popcornData.bagCoatingTypes[0];
      const fat = popcornData.fatMatrices.find(f => f.id === fatId) || popcornData.fatMatrices[0];
      const inhalation = popcornData.bagOpeningInhalationProfiles.find(p => p.id === inhalationId) || popcornData.bagOpeningInhalationProfiles[0];

      // Physical modeling calculations:
      // 1. Susceptor Temperature calculation (°C)
      // Base temp starts from ~160°C, scales with wattage (700-1250W) and duration (90-210s)
      const wattageFactor = (wattage - 700) / (1250 - 700); // 0.0 to 1.0
      const timeFactor = (durationSec - 90) / (210 - 90);    // 0.0 to 1.0
      const peakTempC = Math.round(165 + (fat.susceptorPeakTempC - 165) * 0.7 + (wattageFactor * 25) + (timeFactor * 35));
      const peakTempF = Math.round((peakTempC * 9/5) + 32);

      // 2. Chemical Migration into Molten Lipid (µg of PFAS migrated per bag)
      // Standard commercial popcorn bag paper weighs ~18-22 grams, with ~12g interior food contact sheet
      const paperMassGrams = 14.0;
      const totalPaperFluorineMg = (coating.fluorineContentPpm * paperMassGrams) / 1000; // mg
      
      // Migration percentage scales with temperature & lipid extraction multiplier
      const tempOvershootRatio = Math.max(0, (peakTempC - 170) / 45); // 0 at 170°C, 1.0 at 215°C
      const effectiveMigrationPercent = Math.min(95, coating.migrationRatePercent * (fat.extractionMultiplier / 1.65) * (0.6 + 0.4 * tempOvershootRatio));
      
      // Migrated oral dose in µg
      const migratedOralUgc = totalPaperFluorineMg > 0 ? (totalPaperFluorineMg * 1000 * (effectiveMigrationPercent / 100)) : 0;

      // 3. Airborne Steam Puff Volatilization (ng per puff inhaled)
      const baseVaporMassNg = (coating.volatilizationRatePpm * paperMassGrams * 100); // ng in bag steam
      const timeVaporMultiplier = durationSec > 165 ? 1.5 : 1.0;
      const inhaledAerosolNg = Math.round(baseVaporMassNg * timeVaporMultiplier * inhalation.inhalationFraction);

      // 4. EFSA TWI Benchmark Comparison (% of Tolerable Weekly Intake)
      // EFSA TWI = 4.4 ng/kg body weight per week for sum of 4 PFAS
      const weeklyMaxAllowanceNg = 4.4 * bodyWeightKg;
      // Convert monthly bags to weekly ingestion (oral + inhaled)
      const weeklyBags = monthlyBags / 4.33;
      const weeklyIngestedNg = (migratedOralUgc * 1000) * weeklyBags; // convert µg to ng
      const weeklyInhaledNg = inhaledAerosolNg * weeklyBags;
      const totalWeeklyExposureNg = weeklyIngestedNg + weeklyInhaledNg;
      const twiPercent = Math.round((totalWeeklyExposureNg / weeklyMaxAllowanceNg) * 100);

      // 5. Overall Popcorn Safety Index (0 to 100)
      let score = 100;
      if (coating.fluorineContentPpm === 0) {
        score = 99; // Perfect clean
      } else {
        score -= (coating.fluorineContentPpm / 420) * 45;
        score -= Math.min(30, (twiPercent / 100) * 20);
        if (inhalation.inhalationFraction >= 0.8) score -= 15;
        if (peakTempC > 220) score -= 10;
        score = Math.max(8, Math.round(score));
      }

      // Display metrics
      safetyScoreEl.textContent = score;
      safetyBarEl.style.width = `${score}%`;

      if (score >= 85) {
        safetyBadgeEl.textContent = 'EXCELLENT / NON-TOXIC';
        safetyBadgeEl.className = 'px-3 py-1 rounded-full text-xs font-black uppercase tracking-wide bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20';
        safetyBarEl.className = 'h-full bg-emerald-500 transition-all duration-300';
      } else if (score >= 55) {
        safetyBadgeEl.textContent = 'MODERATE PFAS RISK';
        safetyBadgeEl.className = 'px-3 py-1 rounded-full text-xs font-black uppercase tracking-wide bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20';
        safetyBarEl.className = 'h-full bg-amber-500 transition-all duration-300';
      } else {
        safetyBadgeEl.textContent = 'HIGH PFAS & VAPOR HAZARD';
        safetyBadgeEl.className = 'px-3 py-1 rounded-full text-xs font-black uppercase tracking-wide bg-red-500/10 text-red-700 dark:text-red-400 border border-red-500/20';
        safetyBarEl.className = 'h-full bg-red-500 transition-all duration-300';
      }

      metricOralEl.textContent = migratedOralUgc > 0 ? `${migratedOralUgc.toFixed(1)} µg` : '0.0 µg';
      metricAirEl.textContent = inhaledAerosolNg > 0 ? `${inhaledAerosolNg} ng` : '0 ng';
      metricTwiEl.textContent = twiPercent > 0 ? `${twiPercent}%` : '0%';
      if (twiPercent > 100) {
        metricTwiEl.className = 'font-mono text-sm font-extrabold text-red-600';
      } else if (twiPercent > 40) {
        metricTwiEl.className = 'font-mono text-sm font-extrabold text-amber-600';
      } else {
        metricTwiEl.className = 'font-mono text-sm font-extrabold text-emerald-600';
      }

      metricTempEl.textContent = `${peakTempC} °C`;
      metricTempFEl.textContent = `${peakTempF} °F`;

      if (coating.humanHalfLifeYears > 0.5) {
        metricHalfLifeEl.textContent = `${coating.humanHalfLifeYears} Years (Long-Chain PFOA)`;
        metricHalfLifeBadgeEl.textContent = 'Critical Persistence';
        metricHalfLifeBadgeEl.className = 'px-2 py-0.5 rounded text-[10px] font-bold bg-red-500/10 text-red-700';
      } else if (coating.humanHalfLifeYears > 0) {
        metricHalfLifeEl.textContent = '~32 Days (Short-Chain PFHxA)';
        metricHalfLifeBadgeEl.textContent = 'High Vapor Mobility';
        metricHalfLifeBadgeEl.className = 'px-2 py-0.5 rounded text-[10px] font-bold bg-amber-500/10 text-amber-700';
      } else {
        metricHalfLifeEl.textContent = '0 Days (Completely Non-Fluorinated)';
        metricHalfLifeBadgeEl.textContent = 'Zero Retention';
        metricHalfLifeBadgeEl.className = 'px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/10 text-emerald-700';
      }

      // Generate dynamic assessment text
      if (coating.fluorineContentPpm === 0) {
        assessmentTextEl.innerHTML = `<strong>100% Non-Toxic Popping Verified:</strong> Selected paper or silicone vessel contains zero fluorinated coatings. Zero chemical migration into molten fat and zero volatile fluorotelomer outgassing occur during heating. Recommended for daily consumption.`;
      } else if (coating.id === 'legacy-long-chain-pfas') {
        assessmentTextEl.innerHTML = `<strong>Critical Long-Chain C8 PFAS Hazard:</strong> At susceptor temperatures reaching <strong>${peakTempC}°C</strong>, up to <strong>${migratedOralUgc.toFixed(1)} µg</strong> of polyfluoroalkyl phosphate esters migrate into the hot butter pool. Consuming ${monthlyBags} bags/month exceeds the EFSA Tolerable Weekly Intake by <strong>${twiPercent}%</strong>. PFOA remains in human serum for 3.8 years. Immediate transition to silicone poppers advised.`;
      } else {
        assessmentTextEl.innerHTML = `<strong>Short-Chain C6 Exposure with Elevated Vapor Outgassing:</strong> While PFHxA clears faster from blood (~32 days), volatile 6:2 FTOH has higher vapor pressure. Opening this bag yields an estimated <strong>${inhaledAerosolNg} ng</strong> aerosol inhalation dose. Weekly dietary load stands at <strong>${twiPercent}%</strong> of the EFSA TWI limit. Always wait 90 seconds before opening.`;
      }
    }

    // Attach listeners
    [coatingSelect, fatSelect, inhalationSelect].forEach(el => el.addEventListener('change', recalculate));
    [wattageSlider, timeSlider, freqSlider, weightSlider].forEach(el => el.addEventListener('input', recalculate));

    // Preset buttons
    document.querySelectorAll('.preset-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const p = btn.getAttribute('data-preset');
        if (p === 'clean') {
          coatingSelect.value = 'pfas-free-siliconized';
          fatSelect.value = 'standard-butter';
          wattageSlider.value = '1000';
          timeSlider.value = '150';
          inhalationSelect.value = 'delayed-cooled-vent';
          freqSlider.value = '4';
          weightSlider.value = '70';
        } else if (p === 'standard') {
          coatingSelect.value = 'short-chain-pfas';
          fatSelect.value = 'extra-movie-butter';
          wattageSlider.value = '1000';
          timeSlider.value = '150';
          inhalationSelect.value = 'countertop-arms-length';
          freqSlider.value = '4';
          weightSlider.value = '70';
        } else if (p === 'legacy') {
          coatingSelect.value = 'legacy-long-chain-pfas';
          fatSelect.value = 'extra-movie-butter';
          wattageSlider.value = '1200';
          timeSlider.value = '195';
          inhalationSelect.value = 'face-puff-immediate';
          freqSlider.value = '8';
          weightSlider.value = '70';
        } else if (p === 'child') {
          coatingSelect.value = 'short-chain-pfas';
          fatSelect.value = 'extra-movie-butter';
          wattageSlider.value = '1000';
          timeSlider.value = '150';
          inhalationSelect.value = 'face-puff-immediate';
          freqSlider.value = '8';
          weightSlider.value = '35';
        }
        recalculate();
      });
    });

    // Copy telemetry report
    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        const text = `=== IsItKitchenSafe Microwave Popcorn PFAS & Surfactant Telemetry ===\n` +
          `Date: ${new Date().toISOString()}\n` +
          `Coating: ${coatingSelect.options[coatingSelect.selectedIndex].text}\n` +
          `Lipid Matrix: ${fatSelect.options[fatSelect.selectedIndex].text}\n` +
          `Microwave: ${wattageSlider.value} W | Time: ${timeSlider.value} s\n` +
          `Opening Technique: ${inhalationSelect.options[inhalationSelect.selectedIndex].text}\n` +
          `Frequency: ${freqSlider.value} bags/mo | Weight: ${weightSlider.value} kg\n` +
          `Safety Score: ${safetyScoreEl.textContent} / 100 (${safetyBadgeEl.textContent})\n` +
          `Oral Migration: ${metricOralEl.textContent}\n` +
          `Inhaled Steam Puff Dose: ${metricAirEl.textContent}\n` +
          `EFSA TWI % Burden: ${metricTwiEl.textContent}\n` +
          `Susceptor Peak Temp: ${metricTempEl.textContent} (${metricTempFEl.textContent})\n` +
          `Serum Retention: ${metricHalfLifeEl.textContent}\n` +
          `Reference: https://isitkitchensafe.com/tools/microwave-popcorn-pfas-modeler/`;

        navigator.clipboard.writeText(text).then(() => {
          const original = copyBtnText.textContent;
          copyBtnText.textContent = dict[currentLang]?.reportCopied || 'Copied!';
          setTimeout(() => { copyBtnText.textContent = original; }, 2500);
        });
      });
    }

    recalculate();
  })();
</script>
