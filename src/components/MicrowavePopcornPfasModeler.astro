    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      <div class="p-5 rounded-2xl bg-surface border border-hairline">
        <h4 class="text-sm font-bold text-ink mb-2">{c.rule1Title}</h4>
        <p class="text-xs text-body leading-relaxed">{c.rule1Text}</p>
      </div>
      <div class="p-5 rounded-2xl bg-surface border border-hairline">
        <h4 class="text-sm font-bold text-ink mb-2">{c.rule2Title}</h4>
        <p class="text-xs text-body leading-relaxed">{c.rule2Text}</p>
      </div>
      <div class="p-5 rounded-2xl bg-surface border border-hairline">
        <h4 class="text-sm font-bold text-ink mb-2">{c.rule3Title}</h4>
        <p class="text-xs text-body leading-relaxed">{c.rule3Text}</p>
      </div>
      <div class="p-5 rounded-2xl bg-surface border border-hairline">
        <h4 class="text-sm font-bold text-ink mb-2">{c.rule4Title}</h4>
        <p class="text-xs text-body leading-relaxed">{c.rule4Text}</p>
