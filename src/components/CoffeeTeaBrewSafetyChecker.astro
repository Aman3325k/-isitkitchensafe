              <tr class="border-b border-hairline/60 break-inside-avoid">
                <td class="py-1.5 pr-2 font-bold text-ink">{b.name}</td>
                <td class="py-1.5 px-2 font-bold text-ink">{b.tempF}°F / {b.tempC}°C</td>
                <td class="py-1.5 px-2 text-body">{b.steepTime}</td>
                <td class="py-1.5 pl-2 text-body">{b.safetyAndFlavorNote}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Related Companion Tools (Localized via useTranslatedPath) -->
  <section class="space-y-4 print:hidden">
    <h2 class="text-title-md font-semibold text-ink">{t.relatedHeading}</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <a
        href={descalingUrl}
        class="p-5 rounded-2xl bg-surface-soft border border-hairline hover:border-signature-coral transition-all group block"
      >
        <span class="text-[11px] font-bold uppercase tracking-wider text-signature-coral block mb-1.5">
          {t.relatedDescaleTag}
        </span>
        <h3 class="text-title-sm font-semibold text-ink group-hover:text-signature-coral transition-colors mb-1.5">
          {t.relatedDescaleTitle}
        </h3>
        <p class="text-[13px] text-body leading-relaxed">{t.relatedDescaleDesc}</p>
      </a>

      <a
        href={plasticUrl}
        class="p-5 rounded-2xl bg-surface-soft border border-hairline hover:border-signature-coral transition-all group block"
      >
        <span class="text-[11px] font-bold uppercase tracking-wider text-signature-coral block mb-1.5">
          {t.relatedPlasticTag}
        </span>
        <h3 class="text-title-sm font-semibold text-ink group-hover:text-signature-coral transition-colors mb-1.5">
          {t.relatedPlasticTitle}
        </h3>
        <p class="text-[13px] text-body leading-relaxed">{t.relatedPlasticDesc}</p>
      </a>

      <a
        href={moldUrl}
        class="p-5 rounded-2xl bg-surface-soft border border-hairline hover:border-signature-coral transition-all group block"
      >
        <span class="text-[11px] font-bold uppercase tracking-wider text-signature-coral block mb-1.5">
          {t.relatedMoldTag}
        </span>
        <h3 class="text-title-sm font-semibold text-ink group-hover:text-signature-coral transition-colors mb-1.5">
          {t.relatedMoldTitle}
        </h3>
        <p class="text-[13px] text-body leading-relaxed">{t.relatedMoldDesc}</p>
      </a>
    </div>
  </section>

  <!-- Methodology & Hub Strip -->
  <section class="p-6 rounded-2xl bg-surface-soft border border-hairline print:hidden">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <h2 class="text-title-sm font-semibold text-ink mb-1">{t.methodologyStripTitle}</h2>
        <p class="text-[13px] text-muted">
          {t.methodologyStripPrefix}{' '}
          <a href={methodologyUrl} class="text-link underline hover:text-link-active">{t.methodologyLabel}</a>.
        </p>
      </div>
      <div class="flex flex-wrap gap-2">
        <a
          href={descalingUrl}
          class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral transition-colors"
        >
          {t.descaleQuickLabel}
        </a>
        <a
          href={methodologyUrl}
          class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral transition-colors"
        >
          {t.methodologyLabel}
        </a>
        <a
          href={allToolsUrl}
          class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-primary text-on-primary hover:bg-primary-active transition-colors"
        >
          {t.allToolsLabel}
        </a>
      </div>
    </div>
  </section>

  <!-- Visible 5-Item FAQ Accordion (Matches FAQPage JSON-LD 1:1) -->
  <section class="print:hidden">
    <h2 class="text-title-lg font-medium text-ink tracking-tight mb-6">
      {t.faqTitle}
    </h2>
    <div class="space-y-4">
      {localizedFaqs.map((faq) => (
        <details class="group p-5 bg-surface-soft border border-hairline rounded-xl" open>
          <summary class="text-title-sm font-semibold text-ink cursor-pointer list-none flex items-center justify-between gap-3">
            <span>{faq.question}</span>
            <span class="text-muted text-sm transition-transform group-open:rotate-180 shrink-0" aria-hidden="true">&#9662;</span>
          </summary>
          <p class="text-[14px] text-body leading-relaxed mt-3 pt-3 border-t border-hairline/70">
            {faq.answer}
          </p>
        </details>
      ))}
    </div>
  </section>
</div>

<script is:inline>
  (function () {
    var payloadEl = document.getElementById('ctbs-payload');
    if (!payloadEl) return;

    var payload;
    try {
      payload = JSON.parse(payloadEl.textContent || '{}');
    } catch (_) {
      return;
    }

    var drinks = Array.isArray(payload.drinks) ? payload.drinks : [];
    var materials = Array.isArray(payload.materials) ? payload.materials : [];
    var brewTemps = Array.isArray(payload.brewTemps) ? payload.brewTemps : [];
    var safetyRules = Array.isArray(payload.safetyRules) ? payload.safetyRules : [];
    var ui = payload.ui || {};

    var drinkMap = {};
    drinks.forEach(function (d) {
      if (d && d.id) drinkMap[d.id] = d;
    });

    var materialMap = {};
    materials.forEach(function (m) {
      if (m && m.id) materialMap[m.id] = m;
    });

    var tempMap = {};
    brewTemps.forEach(function (b) {
      if (b && b.id) tempMap[b.id] = b;
    });

    var state = {
      activeTab: 'drinks',
      drinkId: payload.defaultDrinkId || (drinks[0] ? drinks[0].id : ''),
      drinkCat: 'all',
      materialId: payload.defaultMaterialId || (materials[0] ? materials[0].id : ''),
      tempUnit: payload.defaultUnit === 'C' ? 'C' : 'F',
      tempCat: 'all'
    };

    var tabBtns = Array.from(document.querySelectorAll('.ctbs-tab-btn'));
    var panelDrinks = document.getElementById('ctbs-panel-drinks');
    var panelMaterials = document.getElementById('ctbs-panel-materials');
    var panelTemps = document.getElementById('ctbs-panel-temps');

    var drinkCatBtns = Array.from(document.querySelectorAll('.ctbs-dcat-btn'));
    var drinkCards = Array.from(document.querySelectorAll('.ctbs-drink-card'));
    var elDrinkDash = document.getElementById('ctbs-drink-dashboard');
    var elDrinkBadge = document.getElementById('ctbs-drink-verdict-badge');
    var elDrinkAuth = document.getElementById('ctbs-drink-authority');
    var elDrinkPh = document.getElementById('ctbs-drink-ph');
    var elDrinkTitle = document.getElementById('ctbs-drink-title');
    var elDrinkHeadline = document.getElementById('ctbs-drink-headline');
    var elDrinkDetail = document.getElementById('ctbs-drink-detail');
    var elDrinkRoom = document.getElementById('ctbs-drink-room');
    var elDrinkFridge = document.getElementById('ctbs-drink-fridge');
    var elDrinkSpoilage = document.getElementById('ctbs-drink-spoilage');
    var elDrinkTip = document.getElementById('ctbs-drink-tip');

    var matCards = Array.from(document.querySelectorAll('.ctbs-mat-card'));
    var elMatDash = document.getElementById('ctbs-material-dashboard');
    var elMatBadge = document.getElementById('ctbs-mat-badge');
    var elMatLeachPill = document.getElementById('ctbs-mat-leach-pill');
    var elMatDwPill = document.getElementById('ctbs-mat-dw-pill');
    var elMatTitle = document.getElementById('ctbs-mat-title');
    var elMatSummary = document.getElementById('ctbs-mat-summary');
    var elMatLeachDetail = document.getElementById('ctbs-mat-leach-detail');
    var elMatDwRule = document.getElementById('ctbs-mat-dw-rule');
    var elMatDescale = document.getElementById('ctbs-mat-descale');
    var elMatReplace = document.getElementById('ctbs-mat-replace');

    var unitBtns = Array.from(document.querySelectorAll('.ctbs-unit-btn'));
    var tempCatBtns = Array.from(document.querySelectorAll('.ctbs-tcat-btn'));
    var tempCards = Array.from(document.querySelectorAll('.ctbs-temp-card'));

    var copyBtn = document.getElementById('ctbs-copy-btn');
    var copyLabel = document.getElementById('ctbs-copy-label');
    var printBtn = document.getElementById('ctbs-print-btn');

    function getDrinkDarkPillClass(status) {
      var base = 'inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-extrabold uppercase tracking-wider ';
      if (status === 'unsafe') return base + 'bg-red-500 text-white';
      if (status === 'caution') return base + 'bg-amber-400 text-slate-950';
      return base + 'bg-emerald-400 text-slate-950';
    }

    function getDrinkCardPillClass(status) {
      var base = 'inline-block self-start px-2 py-0.5 rounded-md text-[9.5px] font-extrabold uppercase tracking-wider border ';
      if (status === 'unsafe') return base + 'bg-red-500/15 text-red-800 dark:text-red-200 border-red-500/45';
      if (status === 'caution') return base + 'bg-amber-500/15 text-amber-900 dark:text-amber-200 border-amber-500/45';
      return base + 'bg-emerald-500/15 text-emerald-800 dark:text-emerald-200 border-emerald-500/40';
    }

    function getMaterialDarkPillClass(rating) {
      var base = 'inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-extrabold uppercase tracking-wider ';
      if (rating === 'avoid') return base + 'bg-red-500 text-white';
      if (rating === 'caution') return base + 'bg-amber-400 text-slate-950';
      if (rating === 'good') return base + 'bg-sky-400 text-slate-950';
      return base + 'bg-emerald-400 text-slate-950';
    }

    function renderTabs() {
      tabBtns.forEach(function (btn) {
        var tab = btn.getAttribute('data-ctbs-tab');
        var active = tab === state.activeTab;
        btn.setAttribute('aria-selected', active ? 'true' : 'false');
        btn.classList.toggle('bg-primary', active);
        btn.classList.toggle('text-on-primary', active);
        btn.classList.toggle('border-primary', active);
        btn.classList.toggle('ring-2', active);
        btn.classList.toggle('ring-signature-coral/50', active);
        btn.classList.toggle('shadow-xs', active);
        btn.classList.toggle('bg-canvas', !active);
        btn.classList.toggle('text-ink', !active);
        btn.classList.toggle('border-hairline', !active);
      });

      if (panelDrinks) panelDrinks.classList.toggle('hidden', state.activeTab !== 'drinks');
      if (panelMaterials) panelMaterials.classList.toggle('hidden', state.activeTab !== 'materials');
      if (panelTemps) panelTemps.classList.toggle('hidden', state.activeTab !== 'temps');
    }

    function renderDrinkInspector() {
      var drink = drinkMap[state.drinkId] || drinks[0];
      if (!drink) return;

      drinkCatBtns.forEach(function (btn) {
        var active = btn.getAttribute('data-ctbs-dcat') === state.drinkCat;
        btn.setAttribute('aria-pressed', active ? 'true' : 'false');
        btn.classList.toggle('bg-primary', active);
        btn.classList.toggle('text-on-primary', active);
        btn.classList.toggle('border-primary', active);
        btn.classList.toggle('bg-surface-soft', !active);
        btn.classList.toggle('text-ink', !active);
        btn.classList.toggle('border-hairline', !active);
      });

      drinkCards.forEach(function (card) {
        var id = card.getAttribute('data-ctbs-drink') || '';
        var cat = card.getAttribute('data-ctbs-drink-cat') || '';
        var show = state.drinkCat === 'all' || cat === state.drinkCat;
        card.classList.toggle('hidden', !show);

        var active = id === drink.id;
        card.setAttribute('aria-pressed', active ? 'true' : 'false');
        card.classList.toggle('bg-primary', active);
        card.classList.toggle('text-on-primary', active);
        card.classList.toggle('border-primary', active);
        card.classList.toggle('ring-2', active);
        card.classList.toggle('ring-signature-coral/60', active);
        card.classList.toggle('shadow-xs', active);
        card.classList.toggle('bg-surface-soft/70', !active);
        card.classList.toggle('text-ink', !active);
        card.classList.toggle('border-hairline', !active);

        var pill = card.querySelector('[data-ctbs-dpill]');
        var dItem = drinkMap[id];
        if (pill && dItem) {
          if (active) {
            pill.className = 'inline-block self-start px-2 py-0.5 rounded-md text-[9.5px] font-extrabold uppercase tracking-wider border bg-white/20 text-white border-white/30';
          } else {
            pill.className = getDrinkCardPillClass(dItem.status);
          }
        }
      });

      if (elDrinkDash) {
        elDrinkDash.classList.toggle('border-red-400', drink.status === 'unsafe');
        elDrinkDash.classList.toggle('border-amber-400', drink.status === 'caution');
        elDrinkDash.classList.toggle('border-emerald-400', drink.status === 'safe');
      }

      if (elDrinkBadge) {
        elDrinkBadge.textContent = drink.verdictBadge || '';
        elDrinkBadge.className = getDrinkDarkPillClass(drink.status);
      }
      if (elDrinkAuth) elDrinkAuth.textContent = '🛡️ ' + (drink.authorityTag || '');
      if (elDrinkPh) elDrinkPh.textContent = '⚗️ ' + (drink.phRange || '');
      if (elDrinkTitle) elDrinkTitle.textContent = (drink.icon ? drink.icon + ' ' : '') + (drink.name || '');
      if (elDrinkHeadline) elDrinkHeadline.textContent = drink.verdictHeadline || '';
      if (elDrinkDetail) elDrinkDetail.textContent = drink.verdictDetail || '';
      if (elDrinkRoom) elDrinkRoom.textContent = drink.roomTempLimit || '';
      if (elDrinkFridge) elDrinkFridge.textContent = drink.fridgeLimit || '';
      if (elDrinkSpoilage) elDrinkSpoilage.textContent = drink.spoilageRedFlags || '';
      if (elDrinkTip) elDrinkTip.textContent = drink.safeTip || '';
    }

    function renderMaterialInspector() {
      var mat = materialMap[state.materialId] || materials[0];
      if (!mat) return;

      matCards.forEach(function (card) {
        var active = card.getAttribute('data-ctbs-material') === mat.id;
        card.setAttribute('aria-pressed', active ? 'true' : 'false');
        card.classList.toggle('bg-canvas', active);
        card.classList.toggle('border-signature-coral', active);
        card.classList.toggle('ring-2', active);
        card.classList.toggle('ring-signature-coral', active);
        card.classList.toggle('shadow-sm', active);
        card.classList.toggle('bg-surface-soft/65', !active);
        card.classList.toggle('border-hairline', !active);
      });

      if (elMatDash) {
        elMatDash.classList.toggle('border-red-400', mat.safetyRating === 'avoid');
        elMatDash.classList.toggle('border-amber-400', mat.safetyRating === 'caution');
        elMatDash.classList.toggle('border-sky-400', mat.safetyRating === 'good');
        elMatDash.classList.toggle('border-emerald-400', mat.safetyRating === 'best');
      }

      if (elMatBadge) {
        elMatBadge.textContent = mat.safetyBadge || '';
        elMatBadge.className = getMaterialDarkPillClass(mat.safetyRating);
      }
      if (elMatLeachPill) elMatLeachPill.textContent = '⚗️ ' + (mat.leachRiskBadge || '');
      if (elMatDwPill) elMatDwPill.textContent = '🫧 ' + (mat.dishwasherBadge || '');
      if (elMatTitle) elMatTitle.textContent = (mat.icon ? mat.icon + ' ' : '') + (mat.name || '');
      if (elMatSummary) elMatSummary.textContent = mat.summary || '';
      if (elMatLeachDetail) elMatLeachDetail.textContent = mat.leachDetail || '';
      if (elMatDwRule) elMatDwRule.textContent = mat.dishwasherRule || '';
      if (elMatDescale) elMatDescale.textContent = mat.descalingTip || '';
      if (elMatReplace) elMatReplace.textContent = mat.replacementTrigger || '';
    }

    function renderTemps() {
      unitBtns.forEach(function (btn) {
        var active = btn.getAttribute('data-ctbs-unit') === state.tempUnit;
        btn.setAttribute('aria-pressed', active ? 'true' : 'false');
        btn.classList.toggle('bg-primary', active);
        btn.classList.toggle('text-on-primary', active);
        btn.classList.toggle('border-primary', active);
        btn.classList.toggle('bg-surface-soft', !active);
        btn.classList.toggle('text-ink', !active);
        btn.classList.toggle('border-hairline', !active);
      });

      tempCatBtns.forEach(function (btn) {
        var active = btn.getAttribute('data-ctbs-tcat') === state.tempCat;
        btn.setAttribute('aria-pressed', active ? 'true' : 'false');
        btn.classList.toggle('bg-signature-coral', active);
        btn.classList.toggle('text-white', active);
        btn.classList.toggle('border-signature-coral', active);
        btn.classList.toggle('bg-surface-soft', !active);
        btn.classList.toggle('text-ink', !active);
        btn.classList.toggle('border-hairline', !active);
      });

      tempCards.forEach(function (card) {
        var id = card.getAttribute('data-ctbs-temp-card') || '';
        var cat = card.getAttribute('data-ctbs-temp-cat') || '';
        var show = state.tempCat === 'all' || cat === state.tempCat;
        card.classList.toggle('hidden', !show);

        var item = tempMap[id];
        if (!item) return;

        var valEl = card.querySelector('[data-ctbs-temp-val]');
        var rangeEl = card.querySelector('[data-ctbs-temp-range]');
        if (valEl) {
          valEl.textContent = state.tempUnit === 'F' ? String(item.tempF) + '°F' : String(item.tempC) + '°C';
        }
        if (rangeEl) {
          var rangeStr = state.tempUnit === 'F' ? item.rangeF : item.rangeC;
          rangeEl.textContent = (ui.rangeLabel || 'Safe Range') + ': ' + rangeStr;
        }
      });
    }

    function buildCopyCard() {
      var drink = drinkMap[state.drinkId] || drinks[0];
      var mat = materialMap[state.materialId] || materials[0];
      var lines = [];

      lines.push(ui.copyHeader || 'IsItKitchenSafe — Coffee, Cold Brew, Tea & Kettle Safety Card');
      lines.push('');

      if (drink) {
        lines.push((ui.copyDrinkLabel || 'SELECTED DRINK:') + ' ' + drink.name);
        lines.push((ui.copyVerdictLabel || 'SAFETY VERDICT:') + ' [' + drink.verdictBadge + '] ' + drink.verdictHeadline);
        lines.push((ui.copyRoomLabel || 'ROOM TEMP LIMIT:') + ' ' + drink.roomTempLimit);
        lines.push((ui.copyFridgeLabel || 'FRIDGE LIMIT:') + ' ' + drink.fridgeLimit);
        lines.push((ui.copySpoilageLabel || 'SPOILAGE RED FLAGS:') + ' ' + drink.spoilageRedFlags);
        lines.push('');
      }

      if (mat) {
        lines.push((ui.copyMaterialLabel || 'SELECTED KETTLE/BREWER MATERIAL:') + ' ' + mat.name + ' [' + mat.safetyBadge + ']');
        lines.push((ui.copyLeachLabel || 'LEACHING / MICROPLASTIC RISK:') + ' ' + mat.leachRiskBadge + ' — ' + mat.leachDetail);
        lines.push((ui.copyDishwasherLabel || 'DISHWASHER VERDICT:') + ' ' + mat.dishwasherBadge + ' — ' + mat.dishwasherRule);
        lines.push((ui.copyDescaleLabel || 'DESCALING TIP:') + ' ' + mat.descalingTip);
        lines.push('');
      }

      if (brewTemps.length > 0) {
        lines.push(ui.copyTempHeader || 'BREW TEMPERATURE QUICK CHART:');
        brewTemps.forEach(function (b) {
          var tempStr = state.tempUnit === 'F' ? String(b.tempF) + '°F' : String(b.tempC) + '°C';
          lines.push('  - ' + b.name + ': ' + tempStr + ' (' + b.steepTime + ')');
        });
      }

      if (safetyRules.length > 0) {
        lines.push('');
        lines.push(ui.copyRulesHeader || '3 CRITICAL BREW & KETTLE SAFETY RULES:');
        safetyRules.forEach(function (r, idx) {
          lines.push('  ' + String(idx + 1) + '. ' + r.title + ' — ' + r.body);
        });
      }

      return lines.join('\n');
    }

    tabBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var tab = btn.getAttribute('data-ctbs-tab');
        if (tab) {
          state.activeTab = tab;
          renderTabs();
        }
      });
    });

    drinkCatBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var cat = btn.getAttribute('data-ctbs-dcat');
        if (cat) {
          state.drinkCat = cat;
          renderDrinkInspector();
        }
      });
    });

    drinkCards.forEach(function (card) {
      card.addEventListener('click', function () {
        var id = card.getAttribute('data-ctbs-drink');
        if (id && drinkMap[id]) {
          state.drinkId = id;
          renderDrinkInspector();
        }
      });
    });

    matCards.forEach(function (card) {
      card.addEventListener('click', function () {
        var id = card.getAttribute('data-ctbs-material');
        if (id && materialMap[id]) {
          state.materialId = id;
          renderMaterialInspector();
          if (elMatDash && elMatDash.getBoundingClientRect) {
            var rect = elMatDash.getBoundingClientRect();
            if (rect.top < 16 || rect.top > window.innerHeight) {
              elMatDash.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
          }
        }
      });
    });

    unitBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var u = btn.getAttribute('data-ctbs-unit');
        if (u === 'F' || u === 'C') {
          state.tempUnit = u;
          renderTemps();
        }
      });
    });

    tempCatBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var tc = btn.getAttribute('data-ctbs-tcat');
        if (tc) {
          state.tempCat = tc;
          renderTemps();
        }
      });
    });

    if (copyBtn) {
      copyBtn.addEventListener('click', function () {
        var text = buildCopyCard();
        var showCopied = function () {
          if (copyLabel) copyLabel.textContent = ui.copiedBtn || 'Safety Card Copied ✓';
          window.setTimeout(function () {
            if (copyLabel) copyLabel.textContent = '📋 ' + (ui.copyBtn || 'Copy Coffee & Tea Safety Card');
          }, 2200);
        };

        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(showCopied).catch(showCopied);
        } else {
          var ta = document.createElement('textarea');
          ta.value = text;
          ta.setAttribute('readonly', '');
          ta.style.position = 'absolute';
          ta.style.left = '-9999px';
          document.body.appendChild(ta);
          ta.select();
          try {
            document.execCommand('copy');
          } catch (_) {
            // ignore
          }
          document.body.removeChild(ta);
          showCopied();
        }
      });
    }

    if (printBtn) {
      printBtn.addEventListener('click', function () {
        window.print();
      });
    }

    renderTabs();
    renderDrinkInspector();
    renderMaterialInspector();
    renderTemps();
  })();
</script>
