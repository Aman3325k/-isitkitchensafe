const t = UI[lang] || UI.en;
const defaultUnit: 'F' | 'C' = lang === 'en' ? 'F' : 'C';
const defaultDrink = drinks[0];
const defaultMaterial = materials[0];

function getDrinkDarkPillClass(status: DrinkStatusKey): string {
  if (status === 'unsafe') return 'bg-red-500 text-white';
  if (status === 'caution') return 'bg-amber-400 text-slate-950';
  return 'bg-emerald-400 text-slate-950';
}

function getDrinkBorderClass(status: DrinkStatusKey): string {
  if (status === 'unsafe') return 'border-red-400';
  if (status === 'caution') return 'border-amber-400';
  return 'border-emerald-400';
}

function getDrinkCardPillClass(status: DrinkStatusKey): string {
  if (status === 'unsafe') return 'bg-red-500/15 text-red-800 dark:text-red-200 border-red-500/45';
  if (status === 'caution') return 'bg-amber-500/15 text-amber-900 dark:text-amber-200 border-amber-500/45';
  return 'bg-emerald-500/15 text-emerald-800 dark:text-emerald-200 border-emerald-500/40';
}

function getMaterialDarkPillClass(rating: MaterialRatingKey): string {
  if (rating === 'avoid') return 'bg-red-500 text-white';
  if (rating === 'caution') return 'bg-amber-400 text-slate-950';
  if (rating === 'good') return 'bg-sky-400 text-slate-950';
  return 'bg-emerald-400 text-slate-950';
}

function getMaterialBorderClass(rating: MaterialRatingKey): string {
  if (rating === 'avoid') return 'border-red-400';
  if (rating === 'caution') return 'border-amber-400';
  if (rating === 'good') return 'border-sky-400';
  return 'border-emerald-400';
}

function getMaterialCardPillClass(rating: MaterialRatingKey): string {
  if (rating === 'avoid') return 'bg-red-500/15 text-red-800 dark:text-red-200 border-red-500/45';
  if (rating === 'caution') return 'bg-amber-500/15 text-amber-900 dark:text-amber-200 border-amber-500/45';
  if (rating === 'good') return 'bg-sky-500/15 text-sky-800 dark:text-sky-200 border-sky-500/40';
  return 'bg-emerald-500/15 text-emerald-800 dark:text-emerald-200 border-emerald-500/40';
}

const drinkCategories: Array<{ key: 'all' | DrinkCategoryKey; label: string }> = [
  { key: 'all', label: t.drinkCatAll },
  { key: 'cold-brew', label: t.drinkCatColdBrew },
  { key: 'hot-coffee', label: t.drinkCatHotCoffee },
  { key: 'milk-drink', label: t.drinkCatMilk },
  { key: 'tea', label: t.drinkCatTea }
];

const tempCategories: Array<{ key: 'all' | 'coffee' | 'tea'; label: string }> = [
  { key: 'all', label: t.tempFilterAll },
  { key: 'coffee', label: t.tempFilterCoffee },
  { key: 'tea', label: t.tempFilterTea }
];

const clientPayload = {
  lang,
  defaultUnit,
  defaultDrinkId: defaultDrink.id,
  defaultMaterialId: defaultMaterial.id,
  drinks,
  materials,
  brewTemps,
  safetyRules: safetyBanner.rules,
  ui: {
    copyBtn: t.copyBtn,
    copiedBtn: t.copiedBtn,
    copyHeader: t.copyHeader,
    copyDrinkLabel: t.copyDrinkLabel,
    copyVerdictLabel: t.copyVerdictLabel,
    copyRoomLabel: t.copyRoomLabel,
    copyFridgeLabel: t.copyFridgeLabel,
    copySpoilageLabel: t.copySpoilageLabel,
    copyMaterialLabel: t.copyMaterialLabel,
    copyLeachLabel: t.copyLeachLabel,
    copyDishwasherLabel: t.copyDishwasherLabel,
    copyDescaleLabel: t.copyDescaleLabel,
    copyTempHeader: t.copyTempHeader,
    copyRulesHeader: t.copyRulesHeader,
    rangeLabel: t.rangeLabel
  }
};
---

<div id="coffee-tea-checker-root" class="space-y-12">
  <!-- Top 3-Rule Critical Brew & Kettle Safety Banner -->
  <aside
    class="p-5 sm:p-6 rounded-2xl bg-error-bg/80 dark:bg-red-950/45 border-2 border-error-border shadow-sm space-y-4"
    role="alert"
    aria-label={safetyBanner.badge}
  >
    <div class="space-y-1.5 max-w-4xl">
      <span class="inline-block px-3 py-0.5 rounded-full text-[11px] font-extrabold uppercase tracking-wider bg-error-border text-white">
        ⚠️ {safetyBanner.badge}
      </span>
      <h2 class="text-base sm:text-xl font-extrabold text-ink leading-snug">
        {safetyBanner.headline}
      </h2>
      <p class="text-xs sm:text-[13.5px] font-medium text-body leading-relaxed">
        {safetyBanner.subline}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      {safetyBanner.rules.map((rule) => (
        <div class="p-3.5 rounded-xl bg-canvas border border-hairline shadow-xs space-y-1">
          <div class="flex items-start gap-2">
            <span aria-hidden="true" class="text-lg leading-none mt-0.5 shrink-0">{rule.icon}</span>
            <h3 class="text-xs sm:text-[13px] font-extrabold text-ink leading-snug">{rule.title}</h3>
          </div>
          <p class="text-xs text-body leading-relaxed">{rule.body}</p>
        </div>
      ))}
    </div>
  </aside>

  <!-- Main Interactive 3-Tab Brew & Kettle Safety Dashboard -->
  <section
    id="coffee-tea-brew-safety-checker"
    class="bg-canvas border border-hairline rounded-2xl shadow-sm overflow-hidden"
    aria-label={t.ariaLabel}
  >
    <script type="application/json" id="ctbs-payload" set:html={JSON.stringify(clientPayload)} />

    <!-- Header + Action Buttons + 3-Tab Switcher -->
    <div class="p-5 sm:p-6 border-b border-hairline bg-surface-soft/50 space-y-5">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div class="space-y-1 max-w-2xl">
          <span class="inline-block px-2.5 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wider bg-signature-coral text-white">
            ☕ {t.toolBadge}
          </span>
          <h2 class="text-title-md font-bold text-ink">{t.toolTitle}</h2>
          <p class="text-xs sm:text-[13px] text-muted leading-relaxed">{t.toolSub}</p>
        </div>

        <div class="flex flex-wrap items-center gap-2 print:hidden">
          <button
            type="button"
            id="ctbs-copy-btn"
            class="min-h-[40px] px-3.5 py-2 rounded-xl text-xs font-semibold bg-primary text-on-primary hover:bg-primary-active transition-colors cursor-pointer shadow-sm"
          >
            <span id="ctbs-copy-label">📋 {t.copyBtn}</span>
          </button>
          <button
            type="button"
            id="ctbs-print-btn"
