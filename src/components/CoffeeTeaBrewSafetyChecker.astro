---
import rawData from '../data/coffee-tea-brew-safety-data.json';
import type { SupportedLanguage } from '../i18n/ui';
import { useTranslatedPath } from '../i18n/utils';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;
const translatePath = useTranslatedPath(lang);

const descalingUrl = translatePath('/tools/appliance-descaling-calculator/');
const plasticUrl = translatePath('/tools/plastic-code-checker/');
const moldUrl = translatePath('/tools/moldy-food-safety-checker/');
const methodologyUrl = translatePath('/methodology/');
const allToolsUrl = translatePath('/tools/');

type DrinkStatusKey = 'safe' | 'caution' | 'unsafe';
type DrinkCategoryKey = 'cold-brew' | 'hot-coffee' | 'milk-drink' | 'tea';
type MaterialRatingKey = 'best' | 'good' | 'caution' | 'avoid';
type LeachRiskKey = 'zero' | 'low' | 'moderate' | 'high';
type DishwasherKey = 'yes' | 'check' | 'never';

interface BannerRule {
  icon: string;
  title: string;
  body: string;
}

interface SafetyBannerData {
  badge: string;
  headline: string;
  subline: string;
  rules: BannerRule[];
}

interface LocalizedDrink {
  id: string;
  icon: string;
  status: DrinkStatusKey;
  category: DrinkCategoryKey;
  phRange: string;
  shortName: string;
  name: string;
  verdictBadge: string;
  authorityTag: string;
  roomTempLimit: string;
  fridgeLimit: string;
  verdictHeadline: string;
  verdictDetail: string;
  spoilageRedFlags: string;
  safeTip: string;
}

interface LocalizedMaterial {
  id: string;
  icon: string;
  safetyRating: MaterialRatingKey;
  leachRiskLevel: LeachRiskKey;
  dishwasherStatus: DishwasherKey;
  shortName: string;
  name: string;
  safetyBadge: string;
  leachRiskBadge: string;
  dishwasherBadge: string;
  summary: string;
  leachDetail: string;
  dishwasherRule: string;
  descalingTip: string;
  replacementTrigger: string;
}

interface LocalizedBrewTemp {
  id: string;
  icon: string;
  tempF: number;
  tempC: number;
  rangeF: string;
  rangeC: string;
  category: 'tea' | 'coffee';
  name: string;
  steepTime: string;
  ratio: string;
  safetyAndFlavorNote: string;
  whyTempMatters: string;
}

const safetyBanner: SafetyBannerData =
  (rawData.safetyBanner as Record<string, SafetyBannerData>)[lang] ||
  rawData.safetyBanner.en;

const drinks: LocalizedDrink[] = rawData.drinks.map((d) => {
  const tr = (d.i18n as Record<string, any>)[lang] || d.i18n.en;
  return {
    id: d.id,
    icon: d.icon,
    status: d.status as DrinkStatusKey,
    category: d.category as DrinkCategoryKey,
    phRange: d.phRange,
    shortName: tr.shortName,
    name: tr.name,
    verdictBadge: tr.verdictBadge,
    authorityTag: tr.authorityTag,
    roomTempLimit: tr.roomTempLimit,
    fridgeLimit: tr.fridgeLimit,
    verdictHeadline: tr.verdictHeadline,
    verdictDetail: tr.verdictDetail,
    spoilageRedFlags: tr.spoilageRedFlags,
    safeTip: tr.safeTip
  };
});

const materials: LocalizedMaterial[] = rawData.materials.map((m) => {
  const tr = (m.i18n as Record<string, any>)[lang] || m.i18n.en;
  return {
    id: m.id,
    icon: m.icon,
    safetyRating: m.safetyRating as MaterialRatingKey,
    leachRiskLevel: m.leachRiskLevel as LeachRiskKey,
    dishwasherStatus: m.dishwasherStatus as DishwasherKey,
    shortName: tr.shortName,
    name: tr.name,
    safetyBadge: tr.safetyBadge,
    leachRiskBadge: tr.leachRiskBadge,
    dishwasherBadge: tr.dishwasherBadge,
    summary: tr.summary,
    leachDetail: tr.leachDetail,
    dishwasherRule: tr.dishwasherRule,
    descalingTip: tr.descalingTip,
    replacementTrigger: tr.replacementTrigger
  };
});

const brewTemps: LocalizedBrewTemp[] = rawData.brewTemps.map((b) => {
  const tr = (b.i18n as Record<string, any>)[lang] || b.i18n.en;
  return {
    id: b.id,
    icon: b.icon,
    tempF: b.tempF,
    tempC: b.tempC,
    rangeF: b.rangeF,
    rangeC: b.rangeC,
    category: b.category as 'tea' | 'coffee',
    name: tr.name,
    steepTime: tr.steepTime,
    ratio: tr.ratio,
    safetyAndFlavorNote: tr.safetyAndFlavorNote,
    whyTempMatters: tr.whyTempMatters
  };
});

const localizedFaqs: Array<{ question: string; answer: string }> =
  (rawData.faqs as Record<string, Array<{ question: string; answer: string }>>)[lang] ||
  rawData.faqs.en;

