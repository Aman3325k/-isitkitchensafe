      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
      </svg>
      <span>{d.copyReportBtn}</span>
    </button>
  </div>

  <!-- Scientific Principles & Mathematical Equations -->
  <div class="mb-12 p-6 md:p-8 bg-surface rounded-2xl border border-hairline">
    <h3 class="text-title-lg font-bold text-ink mb-2">{d.scienceTitle}</h3>
    <p class="text-xs text-muted leading-relaxed mb-6">{d.scienceSub}</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs text-body">
      <!-- Equation 1: Schwan's Transmembrane Potential -->
      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <h4 class="font-bold text-ink mb-1">1. Schwan Induced Transmembrane Potential Formula</h4>
        <div class="font-mono bg-surface p-2.5 rounded-lg border border-hairline my-2 text-purple-900 font-semibold">
          &Delta;V_m = 1.5 &bull; r &bull; E &bull; cos(&theta;) &bull; [1 - exp(-t / &tau;_c)]
        </div>
        <p class="text-muted leading-relaxed">
          Where <span class="font-mono">r</span> is the cell radius (µm), <span class="font-mono">E</span> is electric field intensity (kV/cm), <span class="font-mono">&theta;</span> is the polar angle between the field vector and membrane normal, and <span class="font-mono">&tau;_c</span> is the membrane charging time constant (~0.1 µs). When induced voltage exceeds the critical potential <span class="font-mono">V_c &approx; 1.0 V</span>, hydrophobic lipid molecules reorient into hydrophilic water-filled channels.
        </p>
      </div>

      <!-- Equation 2: Specific Energy Input & Joule Dissipation -->
      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <h4 class="font-bold text-ink mb-1">2. Specific Energy Input &amp; Joule Heating Equation</h4>
        <div class="font-mono bg-surface p-2.5 rounded-lg border border-hairline my-2 text-purple-900 font-semibold">
          W_spec = (&sigma; &bull; E&sup2; &bull; &tau;_total) / &rho; = (V_p&sup2; &bull; &tau; &bull; f &bull; n_chambers) / (ṁ &bull; &rho;)
        </div>
        <p class="text-muted leading-relaxed">
          Where <span class="font-mono">&sigma;</span> is liquid electrical conductivity (S/m), <span class="font-mono">&tau;_total</span> is total cumulative pulse exposure time, and <span class="font-mono">&rho;</span> is fluid density. The resulting adiabatic Joule temperature rise is <span class="font-mono">&Delta;T = W_spec / c_p</span>, where <span class="font-mono">c_p</span> is specific heat capacity (~3.9 kJ/kg&middot;°C).
        </p>
      </div>

      <!-- Equation 3: Weibull Pathogen Inactivation Kinetics -->
      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <h4 class="font-bold text-ink mb-1">3. Modified Weibull Microbial Inactivation Model</h4>
        <div class="font-mono bg-surface p-2.5 rounded-lg border border-hairline my-2 text-purple-900 font-semibold">
          Log₁₀(N / N₀) = - (1 / 2.303) &bull; [(E - E_c) / &alpha;]&sup2; &bull; (t_eff / &tau;_0)^n
        </div>
        <p class="text-muted leading-relaxed">
          Where <span class="font-mono">E_c</span> is the critical threshold electric field below which no lethal pore formation occurs, <span class="font-mono">t_eff = n_pulses &bull; &tau;</span> is the effective field treatment time, <span class="font-mono">&alpha;</span> is the scale parameter, and <span class="font-mono">n</span> is the survival curve shape parameter.
        </p>
      </div>

      <!-- Equation 4: Townsend Dielectric Arc Breakdown Margin -->
      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <h4 class="font-bold text-ink mb-1">4. Townsend Avalanche Dielectric Breakdown &amp; Arc Margin</h4>
        <div class="font-mono bg-surface p-2.5 rounded-lg border border-hairline my-2 text-purple-900 font-semibold">
          E_breakdown = E_fluid,0 &bull; [1 + 0.18 &bull; (P_hyd / P_atm)] &bull; [1 - 0.065 &bull; (DO / DO_sat)]
        </div>
        <p class="text-muted leading-relaxed">
          Gas bubbles undergo Paschen discharge at only 3 kV/cm, creating a Townsend electron avalanche that propagates into a thermal plasma arc. Increasing hydraulic back-pressure elevates gas solubility and collapses cavitation micro-voids, elevating breakdown field strength above applied PEF levels.
        </p>
      </div>
    </div>
  </div>

  <!-- Engineering Data Table -->
  <div class="mb-12 p-6 md:p-8 bg-surface rounded-2xl border border-hairline">
    <h3 class="text-title-lg font-bold text-ink mb-2">{d.tableTitle}</h3>
    <p class="text-xs text-muted leading-relaxed mb-6">{d.tableSub}</p>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs text-body border-collapse">
        <thead>
          <tr class="border-b border-hairline bg-surface-soft text-ink font-semibold uppercase tracking-wider text-[11px]">
            <th class="p-3">{d.colSystem}</th>
            <th class="p-3">{d.colClassification}</th>
            <th class="p-3">{d.colThroughput}</th>
            <th class="p-3">{d.colMaxVoltage}</th>
            <th class="p-3">{d.colElectrode}</th>
            <th class="p-3">{d.colPulseType}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline">
          {pefData.pefSystems.map(sys => (
            <tr class="hover:bg-surface-soft/60 transition-colors">
              <td class="p-3 font-medium text-ink">{sys.name}</td>
              <td class="p-3 text-muted">{sys.classification}</td>
              <td class="p-3 font-mono">{sys.nominalThroughputLPerHour} L/h</td>
              <td class="p-3 font-mono">{sys.maxVoltageKv} kV</td>
              <td class="p-3">{sys.electrodeMaterial}</td>
              <td class="p-3 text-[11px] font-mono text-purple-700">{sys.pulseType}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Process Authority Engineering Guidelines -->
  <div class="p-6 md:p-8 bg-surface rounded-2xl border border-hairline">
    <h3 class="text-title-lg font-bold text-ink mb-2">{d.rulesTitle}</h3>
    <p class="text-xs text-muted leading-relaxed mb-6">{d.rulesSub}</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs text-body">
      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <h4 class="font-bold text-ink mb-2">{d.rule1Title}</h4>
        <p class="text-muted leading-relaxed">{d.rule1Text}</p>
      </div>
      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <h4 class="font-bold text-ink mb-2">{d.rule2Title}</h4>
        <p class="text-muted leading-relaxed">{d.rule2Text}</p>
      </div>
      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <h4 class="font-bold text-ink mb-2">{d.rule3Title}</h4>
        <p class="text-muted leading-relaxed">{d.rule3Text}</p>
      </div>
      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <h4 class="font-bold text-ink mb-2">{d.rule4Title}</h4>
        <p class="text-muted leading-relaxed">{d.rule4Text}</p>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ pefData, dict: d }}>
  // Interactive Simulation Engine for Continuous High-Voltage PEF
  (function initPefSimulation() {
    const systems = pefData.pefSystems;
    const matrices = pefData.liquidMatrices;
    const microbes = pefData.targetMicroorganisms;

    // Elements
    const systemSelect = document.getElementById('pef-system');
    const matrixSelect = document.getElementById('pef-matrix');
    const microbeSelect = document.getElementById('pef-microbe');
    const waveformSelect = document.getElementById('pef-waveform');

    const fieldSlider = document.getElementById('field-strength');
    const pulseWidthSlider = document.getElementById('pulse-width');
    const frequencySlider = document.getElementById('pulse-frequency');
    const flowRateSlider = document.getElementById('flow-rate');
    const backpressureSlider = document.getElementById('back-pressure');
    const dissolvedGasSlider = document.getElementById('dissolved-gas');
    const inletTempSlider = document.getElementById('inlet-temp');

    const fieldVal = document.getElementById('field-strength-val');
    const pulseWidthVal = document.getElementById('pulse-width-val');
    const frequencyVal = document.getElementById('pulse-frequency-val');
    const flowRateVal = document.getElementById('flow-rate-val');
    const backpressureVal = document.getElementById('back-pressure-val');
    const dissolvedGasVal = document.getElementById('dissolved-gas-val');
    const inletTempVal = document.getElementById('inlet-temp-val');

    // Outputs
    const diagTransmembrane = document.getElementById('diag-transmembrane');
    const diagTransmembraneSub = document.getElementById('diag-transmembrane-sub');
    const diagState = document.getElementById('diag-state');
    const diagStateSub = document.getElementById('diag-state-sub');
    const diagLogRed = document.getElementById('diag-log-red');
    const diagLogRedSub = document.getElementById('diag-log-red-sub');
    const diagSpecificEnergy = document.getElementById('diag-specific-energy');
    const diagSpecificEnergySub = document.getElementById('diag-specific-energy-sub');
    const diagDeltaT = document.getElementById('diag-delta-t');
    const diagDeltaTSub = document.getElementById('diag-delta-t-sub');
    const diagOutletTemp = document.getElementById('diag-outlet-temp');
    const diagOutletTempSub = document.getElementById('diag-outlet-temp-sub');
    const diagArcMargin = document.getElementById('diag-arc-margin');
    const diagArcMarginSub = document.getElementById('diag-arc-margin-sub');
    const diagMetalLeaching = document.getElementById('diag-metal-leaching');
    const diagMetalLeachingSub = document.getElementById('diag-metal-leaching-sub');

    const narrativeSafety = document.getElementById('narrative-safety');
    const narrativeRisk = document.getElementById('narrative-risk');
    const narrativeMitigation = document.getElementById('narrative-mitigation');
    const overallStatusPill = document.getElementById('overall-status-pill');

    // SVGs
    const fieldSvgLabel = document.getElementById('field-svg-label');
    const cavitationGroup = document.getElementById('cavitation-group');
    const chamberStatusBadge = document.getElementById('chamber-status-badge');
    const membraneStatusBadge = document.getElementById('membrane-status-badge');
    const schwanVmReadout = document.getElementById('schwan-vm-readout');
    const criticalRatioBadge = document.getElementById('critical-ratio-badge');
    const treatmentTimeBadge = document.getElementById('treatment-time-badge');
    const microbeCoreLabel = document.getElementById('microbe-core-label');

    function updateSimulation() {
      const selectedSystem = systems.find(s => s.id === systemSelect.value) || systems[0];
      const selectedMatrix = matrices.find(m => m.id === matrixSelect.value) || matrices[0];
      const selectedMicrobe = microbes.find(m => m.id === microbeSelect.value) || microbes[0];
      const selectedWaveform = waveformSelect.value;

      const E = parseFloat(fieldSlider.value); // kV/cm
      const tau = parseFloat(pulseWidthSlider.value); // µs
      const f = parseFloat(frequencySlider.value); // Hz
      const flowLh = parseFloat(flowRateSlider.value); // L/h
      const p_hyd = parseFloat(backpressureSlider.value); // bar
      const do_ppm = parseFloat(dissolvedGasSlider.value); // ppm
      const t_in = parseFloat(inletTempSlider.value); // °C

      // Text readouts
      fieldVal.textContent = E.toFixed(1) + ' kV/cm';
      pulseWidthVal.textContent = tau.toFixed(1) + ' µs';
      frequencyVal.textContent = f.toFixed(0) + ' Hz';
      flowRateVal.textContent = flowLh.toFixed(0) + ' L/h';
      backpressureVal.textContent = p_hyd.toFixed(1) + ' bar';
      dissolvedGasVal.textContent = do_ppm.toFixed(1) + ' ppm';
      inletTempVal.textContent = t_in.toFixed(1) + ' °C';

      // 1. Schwan Equation for Induced Transmembrane Potential
      // ΔVm = 1.5 * r_cell * E * cos(0°)
      // E in kV/cm = E * 10^5 V/m. r_cell in µm = r * 10^-6 m.
      // ΔVm = 1.5 * (r * 10^-6) * (E * 10^5) = 1.5 * r * E * 0.1 = 0.15 * r * E
      const deltaVm = 0.15 * selectedMicrobe.cellRadiusMicrons * E;
      const vCrit = selectedMicrobe.criticalTransmembranePotentialVolts;
      const vmRatio = deltaVm / vCrit;

      let electroporationState = 'Sub-Lethal Reversible';
      let stateColor = 'text-amber-600';
      let stateBadgeClass = 'bg-amber-100 text-amber-800';

      if (deltaVm >= vCrit * 1.35) {
        electroporationState = 'Irreversible Lethal Lysis';
        stateColor = 'text-emerald-700';
        stateBadgeClass = 'bg-emerald-100 text-emerald-800';
      } else if (deltaVm >= vCrit) {
        electroporationState = 'Critical Pore Coalescence';
        stateColor = 'text-purple-700';
        stateBadgeClass = 'bg-purple-100 text-purple-800';
      }

      // 2. Chamber Hydrodynamics & Effective Treatment Time
      // Chamber volume estimate based on gap and diameter
      const gapCm = selectedSystem.electrodeGapMm / 10.0;
      const radiusCm = (selectedSystem.electrodeDiameterMm / 20.0);
      const chamberVolCm3 = Math.PI * Math.pow(radiusCm, 2) * gapCm * selectedSystem.numberOfChambers;
      const chamberVolLiters = chamberVolCm3 / 1000.0;
      
      const flowLitersSec = flowLh / 3600.0;
      const residenceTimeSec = chamberVolLiters / flowLitersSec;
      const pulsesReceived = Math.max(1, Math.round(residenceTimeSec * f));
      const totalExposureMicrosec = pulsesReceived * tau;
      const totalExposureSec = totalExposureMicrosec * 1e-6;

      // 3. Specific Energy Dissipation (kJ/kg)
      // W_spec = (sigma * E^2 * t_total) / rho
      // sigma in S/m. E in kV/cm = E * 10^5 V/m. E^2 = E^2 * 10^10 V^2/m^2.
      // W_joule/m^3 = sigma * (E*10^5)^2 * t_sec = sigma * E^2 * 10^10 * t_sec (J/m^3)
      // W_kJ/kg = (W_joule/m^3) / (rho * 1000)
      const sigma = selectedMatrix.electricalConductivitySm;
      const rho = selectedMatrix.densityKgM3;
      const specificEnergyKjKg = (sigma * Math.pow(E * 1e5, 2) * totalExposureSec) / (rho * 1000.0);

      // 4. Joule Temperature Rise
      const cp = selectedMatrix.specificHeatKjKgC;
      const deltaT = specificEnergyKjKg / cp;
      const tOut = t_in + deltaT;

      // 5. Microbial Inactivation Log Reduction (Weibull / Fermi Kinetic Model)
      const Ec = selectedMicrobe.criticalFieldThresholdKvCm;
      let logReduction = 0.0;
      if (E > Ec) {
        const fieldFactor = Math.pow((E - Ec) / selectedMicrobe.weibullScaleParameterE0, 1.8);
        const timeFactor = Math.pow(totalExposureMicrosec / 20.0, selectedMicrobe.shapeFactorN);
        const phSynergy = selectedMatrix.ph < 4.5 ? 1.35 : (selectedMatrix.ph < 6.0 ? 1.15 : 1.0);
        logReduction = fieldFactor * timeFactor * phSynergy;
      }
      // Spores have minimal PEF kill without heat hurdle
      if (selectedMicrobe.id === 'bacillus_cereus_spores') {
        logReduction = Math.min(1.2, logReduction * 0.15);
      }
      logReduction = Math.min(8.5, Math.max(0.05, logReduction));

      // 6. Townsend Dielectric Arc Breakdown Margin & Quenching Safety Factor
      // Baseline fluid dielectric breakdown strength (kV/cm)
      const baseDielectricKvCm = selectedMatrix.dielectricStrengthKvCm;
      // High pressure increases breakdown threshold; dissolved gases severely decrease it
      const pressureBonus = 1.0 + 0.12 * (p_hyd - 1.0);
      const gasPenalty = 1.0 - (do_ppm / 14.0) * 0.45;
      const cavitationPenalty = (flowLh > 3500 && p_hyd < 2.0) ? 0.45 : 1.0;
      const effectiveBreakdownKvCm = baseDielectricKvCm * pressureBonus * gasPenalty * cavitationPenalty;
      const arcSafetyFactor = effectiveBreakdownKvCm / E;

      // 7. Faradaic Metal Leaching (µg/L)
      let waveformMultiplier = 1.0;
      if (selectedWaveform === 'bipolar_square') waveformMultiplier = 0.05;
      else if (selectedWaveform === 'narrow_bipolar') waveformMultiplier = 0.015;
      else if (selectedWaveform === 'monopolar_decay') waveformMultiplier = 3.8;

      let electrodeMaterialFactor = 1.0;
      if (selectedSystem.electrodeMaterial.includes('Platinum')) electrodeMaterialFactor = 0.25;
      else if (selectedSystem.electrodeMaterial.includes('Mixed Metal')) electrodeMaterialFactor = 0.15;
      else if (selectedSystem.electrodeMaterial.includes('Stainless Steel')) electrodeMaterialFactor = 4.2;

      const metalLeachingUgL = (specificEnergyKjKg * 0.045) * waveformMultiplier * electrodeMaterialFactor * (totalExposureSec * 100);

      // DOM Updates
      diagTransmembrane.textContent = deltaVm.toFixed(2) + ' V';
      diagTransmembraneSub.textContent = `${vmRatio.toFixed(2)}x V_crit (${vCrit.toFixed(2)} V)`;
      
      diagState.textContent = electroporationState;
      diagState.className = `text-base font-bold font-mono ${stateColor}`;
      diagStateSub.textContent = vmRatio >= 1.35 ? 'Irreversible pore coalescence' : (vmRatio >= 1.0 ? 'Transient critical threshold' : 'Sub-threshold survival');

      diagLogRed.textContent = logReduction.toFixed(2) + ' log₁₀';
      diagLogRed.className = `text-xl font-bold font-mono ${logReduction >= 5.0 ? 'text-emerald-700' : (logReduction >= 3.0 ? 'text-amber-600' : 'text-red-600')}`;
      diagLogRedSub.textContent = logReduction >= 5.0 ? 'Exceeds 5.0 log FDA rule' : (logReduction >= 3.0 ? 'Sub-5-log partial reduction' : 'Non-compliant (<3.0 log)');

      diagSpecificEnergy.textContent = specificEnergyKjKg.toFixed(1) + ' kJ/kg';
      diagSpecificEnergySub.textContent = `${pulsesReceived} pulses received`;

      diagDeltaT.textContent = '+' + deltaT.toFixed(1) + ' °C';
      diagDeltaTSub.textContent = `cp = ${cp.toFixed(2)} kJ/kg·°C`;

      diagOutletTemp.textContent = tOut.toFixed(1) + ' °C';
      diagOutletTemp.className = `text-xl font-bold font-mono ${tOut <= 45.0 ? 'text-emerald-700' : (tOut <= 55.0 ? 'text-amber-600' : 'text-red-600')}`;
      diagOutletTempSub.textContent = tOut <= 45.0 ? 'Strict non-thermal (<45°C)' : (tOut <= 55.0 ? 'Hurdle warm zone (<55°C)' : 'Thermal degradation (>55°C)');

      diagArcMargin.textContent = arcSafetyFactor.toFixed(2) + 'x SF';
      diagArcMargin.className = `text-xl font-bold font-mono ${arcSafetyFactor >= 1.8 ? 'text-emerald-700' : (arcSafetyFactor >= 1.2 ? 'text-amber-600' : 'text-red-600')}`;
      diagArcMarginSub.textContent = arcSafetyFactor >= 1.8 ? 'Quench margin robust' : (arcSafetyFactor >= 1.2 ? 'Moderate arc risk' : 'CRITICAL ARC TRIP HAZARD');

      diagMetalLeaching.textContent = metalLeachingUgL.toFixed(1) + ' µg/L';
      diagMetalLeaching.className = `text-xl font-bold font-mono ${metalLeachingUgL <= 15.0 ? 'text-emerald-700' : 'text-red-600'}`;
      diagMetalLeachingSub.textContent = metalLeachingUgL <= 15.0 ? '<15 µg/L EU/FDA limit' : 'EXCEEDS Faradaic limit!';

      // Status Pill & Narrative Box
      if (arcSafetyFactor < 1.15) {
        overallStatusPill.className = 'px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-red-100 text-red-800 border border-red-300';
        overallStatusPill.textContent = 'CRITICAL: DIELECTRIC ARC BREAKDOWN TRIP';
        narrativeSafety.textContent = 'PROCESS SAFETY TRIP: Applied electric field exceeds local fluid dielectric breakdown. Low back-pressure or high dissolved oxygen induced Townsend electron avalanche discharges.';
        narrativeRisk.textContent = 'High-energy plasma arc discharge risk inside treatment chamber! Catastrophic acoustic shock waves, pipe rupture, product scorching, and severe electrode crater pitting.';
        narrativeMitigation.textContent = 'Immediately elevate hydraulic backpressure above 3.5 bar and engage upstream vacuum deaerator (<2.0 ppm DO). Switch to bipolar pulse waveform.';
      } else if (logReduction < 5.0 && selectedMicrobe.id !== 'bacillus_cereus_spores') {
        overallStatusPill.className = 'px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-100 text-amber-800 border border-amber-300';
        overallStatusPill.textContent = 'WARNING: SUB-5-LOG HACCP INACTIVATION';
        narrativeSafety.textContent = `Pathogen reduction (${logReduction.toFixed(2)} log₁₀) does not fulfill the mandatory FDA 21 CFR § 120 5-log lethal reduction standard. Surviving pathogens present public health hazard.`;
        narrativeRisk.textContent = 'Bacterial cells experience reversible electroporation without irreversible pore coalescence, allowing post-treatment enzymatic repair and pathogen regrowth.';
        narrativeMitigation.textContent = 'Increase electric field intensity E above 28 kV/cm, elevate pulse repetition frequency, or reduce liquid flow rate to deliver sufficient cumulative lethal exposure time.';
      } else if (tOut > 50.0) {
        overallStatusPill.className = 'px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-100 text-amber-800 border border-amber-300';
        overallStatusPill.textContent = 'CAUTION: EXCESSIVE JOULE THERMAL HEATING';
        narrativeSafety.textContent = `Fluid temperature reached ${tOut.toFixed(1)}°C. High conductivity driven Joule dissipation borders on thermal degradation, threatening heat-sensitive nutrients and flavor volatiles.`;
        narrativeRisk.textContent = 'Thermal protein denaturation and electrode surface fouling (burn-on layer) which distorts the uniform electric field and triggers secondary arcing.';
        narrativeMitigation.textContent = 'Activate inter-stage sanitary cooling jackets, lower inlet product temperature (e.g., 4°C - 8°C), or increase continuous mass flow velocity.';
      } else {
        overallStatusPill.className = 'px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800 border border-emerald-300';
        overallStatusPill.textContent = '100% FDA 5-Log & Arc-Safe';
        narrativeSafety.textContent = `Complies with FDA 21 CFR § 120 (5-Log Juice HACCP), 3-A Sanitary Standard 63-04, and EHEDG Doc 35 guidelines. The treatment parameters achieve lethal irreversible bacterial membrane breakdown while strictly maintaining food temperatures below 45°C.`;
        narrativeRisk.textContent = 'None detected under current continuous flow velocity and hydraulic back-pressure. Fluid cavitation index is suppressed, preventing dielectric arc breakdown.';
        narrativeMitigation.textContent = 'Bipolar symmetrical pulses ensure zero net Faradaic charge accumulation, holding electrode erosion to negligible trace levels (<15 µg/L).';
      }

      // SVG Updates
      fieldSvgLabel.textContent = `E = ${E.toFixed(1)} kV/cm`;
      treatmentTimeBadge.textContent = `Residence Time: ${(residenceTimeSec * 1000).toFixed(1)} ms`;
      microbeCoreLabel.textContent = `${selectedMicrobe.name.split(' (')[0]} (r = ${selectedMicrobe.cellRadiusMicrons} µm)`;
      schwanVmReadout.textContent = `Induced ΔVm = ${deltaVm.toFixed(2)} V (V_crit: ${vCrit.toFixed(2)} V)`;
      criticalRatioBadge.textContent = `ΔVm / Vc = ${vmRatio.toFixed(2)}x`;

      if (arcSafetyFactor < 1.15) {
        cavitationGroup.setAttribute('opacity', '1');
        chamberStatusBadge.textContent = 'ARC DISCHARGE TRIP!';
        chamberStatusBadge.className = 'px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-red-100 text-red-800 animate-pulse';
      } else {
        cavitationGroup.setAttribute('opacity', '0');
        chamberStatusBadge.textContent = 'Laminar • Arc-Safe';
        chamberStatusBadge.className = 'px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-emerald-100 text-emerald-800';
      }

      membraneStatusBadge.textContent = electroporationState;
      membraneStatusBadge.className = `px-2 py-0.5 rounded text-[10px] font-bold uppercase ${stateBadgeClass}`;
    }

    // Presets handler
    document.querySelectorAll('.preset-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const p = btn.getAttribute('data-preset');
        if (p === 'juice_haccp') {
          systemSelect.value = 'industrial_multistage_coaxial';
          matrixSelect.value = 'fresh_orange_juice';
          microbeSelect.value = 'escherichia_coli_o157h7';
          waveformSelect.value = 'bipolar_square';
          fieldSlider.value = 32.0;
          pulseWidthSlider.value = 2.5;
          frequencySlider.value = 280;
          flowRateSlider.value = 2200;
          backpressureSlider.value = 4.5;
          dissolvedGasSlider.value = 1.5;
          inletTempSlider.value = 12.0;
        } else if (p === 'dairy_colostrum') {
          systemSelect.value = 'ultra_clean_dairy_pef';
          matrixSelect.value = 'raw_whole_milk';
          microbeSelect.value = 'listeria_monocytogenes';
          waveformSelect.value = 'narrow_bipolar';
          fieldSlider.value = 30.0;
          pulseWidthSlider.value = 2.0;
          frequencySlider.value = 220;
          flowRateSlider.value = 1200;
          backpressureSlider.value = 5.0;
          dissolvedGasSlider.value = 1.0;
          inletTempSlider.value = 6.0;
        } else if (p === 'liquid_egg') {
          systemSelect.value = 'industrial_multistage_coaxial';
          matrixSelect.value = 'liquid_whole_egg';
          microbeSelect.value = 'salmonella_enterica_typhimurium';
          waveformSelect.value = 'bipolar_square';
          fieldSlider.value = 28.0;
          pulseWidthSlider.value = 2.2;
          frequencySlider.value = 200;
          flowRateSlider.value = 1500;
          backpressureSlider.value = 4.0;
          dissolvedGasSlider.value = 2.0;
          inletTempSlider.value = 10.0;
        } else if (p === 'arc_cavitation') {
          systemSelect.value = 'compromised_cavitating_line';
          matrixSelect.value = 'cold_pressed_vegetable_blend';
          microbeSelect.value = 'escherichia_coli_o157h7';
          waveformSelect.value = 'monopolar_decay';
          fieldSlider.value = 42.0;
          pulseWidthSlider.value = 4.5;
          frequencySlider.value = 350;
          flowRateSlider.value = 4200;
          backpressureSlider.value = 0.8;
          dissolvedGasSlider.value = 9.5;
          inletTempSlider.value = 24.0;
        }
        updateSimulation();
      });
    });

    // Listeners
    [systemSelect, matrixSelect, microbeSelect, waveformSelect].forEach(el => el.addEventListener('change', updateSimulation));
    [fieldSlider, pulseWidthSlider, frequencySlider, flowRateSlider, backpressureSlider, dissolvedGasSlider, inletTempSlider].forEach(el => el.addEventListener('input', updateSimulation));

    // Copy audit report
    const copyBtn = document.getElementById('copy-pef-report-btn');
    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        const reportText = `======================================================================
ISITKITCHENSAFE CONTINUOUS HIGH-VOLTAGE PEF AUDIT REPORT
Standard: FDA 21 CFR § 120 (5-Log Juice HACCP) / 3-A 63-04 / EHEDG Doc 35
======================================================================
PEF System: ${systemSelect.options[systemSelect.selectedIndex].text}
Liquid Matrix: ${matrixSelect.options[matrixSelect.selectedIndex].text}
Target Microorganism: ${microbeSelect.options[microbeSelect.selectedIndex].text}
Pulse Waveform: ${waveformSelect.options[waveformSelect.selectedIndex].text}

OPERATING PARAMETERS:
- Applied Electric Field (E): ${fieldSlider.value} kV/cm
- Pulse Width (tau): ${pulseWidthSlider.value} µs
- Repetition Frequency (f): ${frequencySlider.value} Hz
- Flow Rate: ${flowRateSlider.value} L/h
- Hydraulic Back-Pressure: ${backpressureSlider.value} bar
- Dissolved Gas (DO): ${dissolvedGasSlider.value} ppm
- Inlet Temperature: ${inletTempSlider.value} °C

DIAGNOSTIC TELEMETRY:
- Schwan Induced Transmembrane Potential: ${diagTransmembrane.textContent}
- Electroporation State: ${diagState.textContent}
- Microbial Pathogen Reduction: ${diagLogRed.textContent}
- Specific Energy Input: ${diagSpecificEnergy.textContent}
- Joule Temperature Rise: ${diagDeltaT.textContent}
- Fluid Outlet Temperature: ${diagOutletTemp.textContent}
- Townsend Arc Safety Factor: ${diagArcMargin.textContent}
- Faradaic Metal Dissolution: ${diagMetalLeaching.textContent}

OVERALL COMPLIANCE ASSESSMENT:
${overallStatusPill.textContent}
Safety Evaluation: ${narrativeSafety.textContent}
Risk Profile: ${narrativeRisk.textContent}
Process Safeguards: ${narrativeMitigation.textContent}
======================================================================`;

        navigator.clipboard.writeText(reportText).then(() => {
          const originalText = copyBtn.innerHTML;
          copyBtn.innerHTML = `<span class="text-white font-bold">${dict.copiedFeedback}</span>`;
          setTimeout(() => {
            copyBtn.innerHTML = originalText;
          }, 3000);
        });
      });
    }

    // Initial run
    updateSimulation();
  })();
</script>
