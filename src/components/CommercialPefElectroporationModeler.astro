const d = DICTIONARY[lang] || DICTIONARY.en;
---

<div class="pef-modeler-container my-8 rounded-3xl bg-surface-soft border border-hairline p-6 md:p-10 shadow-sm" data-lang={lang}>
  <!-- Header Bar -->
  <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
    <div class="flex items-center gap-2">
      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-purple-700 text-white">
        {d.badge}
      </span>
      <span class="text-xs text-muted font-mono">FDA 21 CFR § 120 • 3-A 63-04 • EHEDG Doc 35</span>
    </div>
    <div class="text-xs text-muted font-mono bg-surface px-3 py-1.5 rounded-lg border border-hairline/60">
      Schwan Electroporation Engine v2.4 • Dynamic Fluidics
    </div>
  </div>

  <h2 class="text-title-xl font-bold text-ink tracking-tight mb-3">
    {d.title}
  </h2>
  <p class="text-body text-muted leading-relaxed mb-8 max-w-4xl">
    {d.subtitle}
  </p>

  <!-- Presets Scenario Bar -->
  <div class="mb-8 p-5 bg-surface rounded-2xl border border-hairline">
    <div class="text-xs font-bold uppercase tracking-wider text-muted mb-3">
      {d.presetsTitle}
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
      <button type="button" class="preset-btn px-4 py-2.5 rounded-xl border border-hairline text-xs font-medium text-ink bg-surface-soft hover:bg-purple-50 hover:border-purple-300 transition-all text-left flex items-center justify-between" data-preset="juice_haccp">
        <span>{d.presetJuiceHaccp}</span>
        <span class="text-purple-600 font-mono text-[10px] ml-1">5-Log</span>
      </button>
      <button type="button" class="preset-btn px-4 py-2.5 rounded-xl border border-hairline text-xs font-medium text-ink bg-surface-soft hover:bg-purple-50 hover:border-purple-300 transition-all text-left flex items-center justify-between" data-preset="dairy_colostrum">
        <span>{d.presetDairyColostrum}</span>
