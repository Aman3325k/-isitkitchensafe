---

<div class="rf-post-bake-leveling-modeler bg-surface border border-hairline rounded-3xl p-6 md:p-8 shadow-sm mb-12">
  <div class="flex flex-wrap items-center justify-between gap-3 mb-6 pb-6 border-b border-hairline">
    <div>
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-600 text-white mb-2">
        {d.badge}
      </span>
      <h2 class="text-title-lg md:text-display-sm font-bold text-ink">
        {d.title}
      </h2>
      <p class="text-body-sm text-muted max-w-3xl mt-1">
        {d.subtitle}
      </p>
    </div>
    <div class="flex items-center gap-2">
      <span class="px-3 py-1.5 rounded-xl bg-surface-soft border border-hairline font-mono text-xs text-muted">
        27.12 MHz ISM &bull; FCC Part 18 &bull; EU 2017/2158
      </span>
    </div>
  </div>

  <!-- Presets -->
  <div class="mb-8">
    <div class="text-xs font-semibold uppercase tracking-wider text-muted mb-3">
      {d.presetsTitle}
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5">
      <button 
        type="button"
        id="preset-cracker"
        class="text-left px-3.5 py-2.5 rounded-xl border border-hairline bg-surface-soft hover:bg-amber-50 hover:border-amber-400 text-xs font-medium text-ink transition-colors"
      >
