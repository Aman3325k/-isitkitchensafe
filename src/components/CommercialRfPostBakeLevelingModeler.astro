<script is:inline define:vars={{ rfData, lang }}>
  (function() {
    const systems = rfData.rfSystems;
    const matrices = rfData.bakedProductMatrices;

    // Elements
    const systemSelect = document.getElementById('rf-system-select');
    const matrixSelect = document.getElementById('rf-matrix-select');
    const powerSlider = document.getElementById('power-slider');
    const gapSlider = document.getElementById('gap-slider');
    const speedSlider = document.getElementById('speed-slider');
    const moistureSlider = document.getElementById('moisture-slider');
    const rhSlider = document.getElementById('rh-slider');
    const saltSlider = document.getElementById('salt-slider');

    // Displays
    const powerDisp = document.getElementById('power-display');
    const gapDisp = document.getElementById('gap-display');
    const speedDisp = document.getElementById('speed-display');
    const moistureDisp = document.getElementById('moisture-display');
    const rhDisp = document.getElementById('rh-display');
    const saltDisp = document.getElementById('salt-display');
    const systemDescHelp = document.getElementById('system-desc-help');

    // Results
    const resCenterMoisture = document.getElementById('res-center-moisture');
    const resMoistureDiff = document.getElementById('res-moisture-diff');
    const resSelectiveRatio = document.getElementById('res-selective-ratio');
    const resFieldStrength = document.getElementById('res-field-strength');
    const resCheckingRisk = document.getElementById('res-checking-risk');
    const resArcSafety = document.getElementById('res-arc-safety');
    const resAcrylamide = document.getElementById('res-acrylamide');
    const resRunawayStatus = document.getElementById('res-runaway-status');
    const resEmfLeakage = document.getElementById('res-emf-leakage');
    const safetyBadge = document.getElementById('safety-badge');
    const advisoryTitle = document.getElementById('advisory-title');
    const advisoryText = document.getElementById('advisory-text');
    const advisoryBox = document.getElementById('advisory-box');

    // Presets
    const btnCracker = document.getElementById('preset-cracker');
    const btnBiscuit = document.getElementById('preset-biscuit');
    const btnDigestive = document.getElementById('preset-digestive');
    const btnHazard = document.getElementById('preset-hazard');

    function updateSimulation() {
      const currentSystemId = systemSelect.value;
      const currentMatrixId = matrixSelect.value;

      const system = systems.find(s => s.id === currentSystemId) || systems[1];
      const matrix = matrices.find(m => m.id === currentMatrixId) || matrices[0];

      const powerKw = parseFloat(powerSlider.value);
      const gapMm = parseFloat(gapSlider.value);
      const beltSpeedMMin = parseFloat(speedSlider.value);
      const moistureInCenter = parseFloat(moistureSlider.value);
      const airRh = parseFloat(rhSlider.value);
      const saltPct = parseFloat(saltSlider.value);

      // Update text displays
      powerDisp.textContent = `${powerKw} kW`;
      gapDisp.textContent = `${gapMm} mm`;
      speedDisp.textContent = `${beltSpeedMMin} m/min`;
      moistureDisp.textContent = `${moistureInCenter.toFixed(1)} %`;
      rhDisp.textContent = `${airRh} %`;
      saltDisp.textContent = `${saltPct.toFixed(1)} %`;
      if (systemDescHelp) {
        systemDescHelp.textContent = system.description;
      }

      // Physics Calculations:
      // 1. Residence time in RF zone (seconds)
      const beltSpeedMS = beltSpeedMMin / 60.0;
      const residenceTimeSec = system.electrodeLengthM / Math.max(0.05, beltSpeedMS);

      // 2. Applied RF Voltage (V_peak) across electrode plates
      // V_peak roughly proportional to sqrt(P * Z), capped by system max
      const maxVoltKv = system.maxRfVoltagePeakKv || 18.0;
      const appliedVoltageKv = Math.min(maxVoltKv, Math.sqrt((powerKw / 100.0) * (system.generatorPowerKw || 75.0)) * 2.2 + 4.0);
      
      // 3. Electric field strength E (kV/cm)
      const gapCm = gapMm / 10.0;
      const fieldStrengthKvCm = appliedVoltageKv / Math.max(1.0, gapCm);

      // 4. Selective Heating: Dielectric loss factors
      // Loss factor of wet center: water loss factor scaled by moisture & ionic conductivity
      const ionicBoost = 1.0 + (saltPct - 1.0) * 0.45;
      const epsCenter = (matrix.lossFactorWaterEpsilonDoublePrime * (moistureInCenter / 100.0) * 1.8 + matrix.lossFactorDryCrumbEpsilonDoublePrime) * Math.max(0.5, ionicBoost);
      const epsEdge = matrix.lossFactorDryCrumbEpsilonDoublePrime * 1.15;
      const selectiveRatio = Math.max(1.2, epsCenter / Math.max(0.1, epsEdge));

      // 5. Moisture Evaporation in Core
      // Latent heat of vaporization ~ 2260 kJ/kg water
      // Evaporative moisture reduction in center
      const energyDryingFactor = (powerKw * residenceTimeSec) / (system.beltWidthM * 1800);
      const moistureDropCenter = Math.min(moistureInCenter - 1.2, energyDryingFactor * (epsCenter / 4.0) * 0.75);
      const finalCenterMoisture = Math.max(1.4, moistureInCenter - Math.max(0.2, moistureDropCenter));
      
      // Edge moisture drops much less due to low dielectric absorption
      const finalEdgeMoisture = Math.max(1.0, matrix.initialEdgeMoisturePct - (moistureDropCenter * 0.12));
      const moistureDelta = Math.abs(finalCenterMoisture - finalEdgeMoisture);

      // 6. Checking Stress Risk
      // Internal tensile stress proportional to moisture gradient across lamellae
      let checkingStatus = 'ZERO CHECKING';
      let checkingClass = 'text-emerald-700 bg-emerald-50';
      if (moistureDelta > 2.2) {
        checkingStatus = 'SEVERE CHECKING RISK (>85% Spontaneous Breakage)';
        checkingClass = 'text-red-700 bg-red-50';
      } else if (moistureDelta > 1.2) {
        checkingStatus = 'MODERATE CHECKING (20-40% Fragile Cracks)';
        checkingClass = 'text-amber-700 bg-amber-50';
      } else if (moistureDelta > 0.8) {
        checkingStatus = 'MINOR CHECKING (<5% Flaws)';
        checkingClass = 'text-yellow-700 bg-yellow-50';
      } else {
        checkingStatus = `ZERO CHECKING (Δ ${moistureDelta.toFixed(2)}%)`;
        checkingClass = 'text-emerald-700 bg-emerald-50';
      }

      // 7. Townsend Dielectric Breakdown & Arc Safety Factor
      // Dry air breakdown ~ 30 kV/cm, reduced by temperature (hot oven air ~ 60°C) and relative humidity
      const airDensityFactor = 293.0 / (273.0 + 55.0); // 0.893
      const humidityDerate = 1.0 - (airRh / 100.0) * 0.28;
      const dustDerate = currentSystemId === 'uncalibrated_cavitating_rf' ? 0.65 : 0.95;
      const breakdownThresholdKvCm = 30.0 * airDensityFactor * humidityDerate * dustDerate;
      const arcSafetyFactor = breakdownThresholdKvCm / Math.max(0.1, fieldStrengthKvCm);

      // 8. Acrylamide Formation Reduction
      // Oven baking time reduced because drying is offloaded to RF
      const thermalOvenOffloadPct = Math.min(0.40, (moistureInCenter - finalCenterMoisture) * 0.08);
      const acrylamideFinal = Math.round(matrix.acrylamideBaselineUgcKg * (1.0 - thermalOvenOffloadPct * 1.5));
      const euBenchmark = 350; // biscuits benchmark
      const acrylamideDeltaPct = Math.round(((acrylamideFinal - euBenchmark) / euBenchmark) * 100);

      // 9. Thermal Runaway Stability
      // High salt + high field + low speed can trigger positive feedback
      let runawayStatus = 'STABLE (Ionic Dissipation Controlled)';
      let runawayColor = 'text-emerald-700';
      const runawayRiskIndex = (saltPct / matrix.thermalRunawayConductivityThresholdSm) * (powerKw / gapMm) * 0.15;
      if (currentSystemId === 'uncalibrated_cavitating_rf' || runawayRiskIndex > 1.8) {
        runawayStatus = 'CRITICAL THERMAL RUNAWAY (Hotspots & Charring)';
        runawayColor = 'text-red-700';
      } else if (runawayRiskIndex > 1.1) {
        runawayStatus = 'ELEVATED RUNAWAY RISK (High Salt Ionic Dissipation)';
        runawayColor = 'text-amber-700';
      }

      // 10. OSHA EMF Leakage
      const faradayShield = system.faradayShieldingDb || 75.0;
      const leakagePowerDensity = Math.max(0.02, (powerKw / 100.0) * Math.pow(10, -(faradayShield - 40.0) / 10.0));

      // Update Live UI
      resCenterMoisture.textContent = `${finalCenterMoisture.toFixed(2)} %`;
      resCenterMoisture.className = `font-mono text-title-sm font-bold ${finalCenterMoisture >= 1.8 && finalCenterMoisture <= 2.6 ? 'text-emerald-600' : 'text-amber-600'}`;

      resMoistureDiff.textContent = `Δ ${moistureDelta.toFixed(2)} %`;
      resMoistureDiff.className = `font-mono text-title-sm font-bold ${moistureDelta <= 0.8 ? 'text-emerald-600' : (moistureDelta <= 1.5 ? 'text-amber-600' : 'text-red-600')}`;

      resSelectiveRatio.textContent = `${selectiveRatio.toFixed(1)}x`;
      resFieldStrength.textContent = `${fieldStrengthKvCm.toFixed(2)} kV/cm`;

      resCheckingRisk.textContent = checkingStatus;
      resCheckingRisk.className = `font-bold px-2 py-0.5 rounded text-[11px] ${checkingClass}`;

      resArcSafety.textContent = `SF = ${arcSafetyFactor.toFixed(2)}x ${arcSafetyFactor >= 1.6 ? '(Safe)' : (arcSafetyFactor >= 1.1 ? '(Marginal)' : '(ARC FLASHOVER HAZARD)')}`;
      resArcSafety.className = `font-mono font-bold ${arcSafetyFactor >= 1.6 ? 'text-ink' : (arcSafetyFactor >= 1.1 ? 'text-amber-600' : 'text-red-600 animate-pulse')}`;

      resAcrylamide.textContent = `${acrylamideFinal} µg/kg (${acrylamideDeltaPct <= 0 ? acrylamideDeltaPct + '% vs EU Benchmark' : '+' + acrylamideDeltaPct + '% above EU Benchmark'})`;
      resAcrylamide.className = `font-bold ${acrylamideFinal <= euBenchmark ? 'text-emerald-700' : 'text-red-700'}`;

      resRunawayStatus.textContent = runawayStatus;
      resRunawayStatus.className = `font-bold ${runawayColor}`;

      resEmfLeakage.textContent = `${leakagePowerDensity.toFixed(2)} mW/cm² (OSHA Limit 10.0)`;

      // Overall System Health Badge & Advisory
      if (arcSafetyFactor < 1.1 || currentSystemId === 'uncalibrated_cavitating_rf') {
        safetyBadge.textContent = 'DANGER: ARCING HAZARD';
        safetyBadge.className = 'px-2.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-red-600 text-white';
        advisoryBox.className = 'p-3.5 rounded-xl bg-red-50 border border-red-200';
        advisoryTitle.textContent = 'CRITICAL DIELECTRIC BREAKDOWN & FIRE HAZARD';
        advisoryTitle.className = 'text-[11px] font-bold uppercase tracking-wider text-red-900 mb-1';
        advisoryText.textContent = `Applied electric field (${fieldStrengthKvCm.toFixed(2)} kV/cm) exceeds or borders the dielectric breakdown strength of the humid air gap (${breakdownThresholdKvCm.toFixed(2)} kV/cm). Townsend electron avalanche creates catastrophic plasma arcs between the electrode and conveyor band. Increase electrode gap height to ≥70 mm or reduce generator power immediately.`;
      } else if (moistureDelta > 1.8) {
        safetyBadge.textContent = 'WARNING: CHECKING RISK';
        safetyBadge.className = 'px-2.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-amber-600 text-white';
        advisoryBox.className = 'p-3.5 rounded-xl bg-amber-50 border border-amber-200';
        advisoryTitle.textContent = 'INSUFFICIENT RESIDENCE TIME / MOISTURE GRADIENT ELEVATED';
        advisoryTitle.className = 'text-[11px] font-bold uppercase tracking-wider text-amber-900 mb-1';
        advisoryText.textContent = `The core-to-edge moisture gradient (Δ ${moistureDelta.toFixed(2)}%) remains above the mechanical tensile threshold. Biscuits will experience spontaneous transverse stress cracking (checking) within 24 to 48 hours post-packaging. Increase RF generator power or decrease conveyor belt speed to prolong dielectric exposure.`;
      } else {
        safetyBadge.textContent = 'OPTIMAL & COMPLIANT';
        safetyBadge.className = 'px-2.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-emerald-600 text-white';
        advisoryBox.className = 'p-3.5 rounded-xl bg-surface border border-hairline';
        advisoryTitle.textContent = 'PROCESS OPTIMIZATION STATUS: GOLD MASTER';
        advisoryTitle.className = 'text-[11px] font-bold uppercase tracking-wider text-muted mb-1';
        advisoryText.textContent = `Optimal 27.12 MHz dielectric dissipation. The selective heating ratio (${selectiveRatio.toFixed(1)}x) drives preferential evaporation of core moisture to ${finalCenterMoisture.toFixed(2)}%, achieving a tight moisture differential (Δ ${moistureDelta.toFixed(2)}%). Acrylamide is safely minimized to ${acrylamideFinal} µg/kg, arc safety factor is robust (SF ${arcSafetyFactor.toFixed(2)}x), and checking is 100% prevented.`;
      }
    }

    // Attach listeners
    systemSelect.addEventListener('change', updateSimulation);
    matrixSelect.addEventListener('change', updateSimulation);
    powerSlider.addEventListener('input', updateSimulation);
    gapSlider.addEventListener('input', updateSimulation);
    speedSlider.addEventListener('input', updateSimulation);
    moistureSlider.addEventListener('input', updateSimulation);
    rhSlider.addEventListener('input', updateSimulation);
    saltSlider.addEventListener('input', updateSimulation);

    // Preset Handlers
    btnCracker.addEventListener('click', function() {
      systemSelect.value = 'commercial_high_throughput_75kw';
      matrixSelect.value = 'soda_cracker';
      powerSlider.value = 75;
      gapSlider.value = 75;
      speedSlider.value = 32;
      moistureSlider.value = 5.8;
      rhSlider.value = 45;
      saltSlider.value = 1.2;
      updateSimulation();
    });

    btnBiscuit.addEventListener('click', function() {
      systemSelect.value = 'commercial_high_throughput_75kw';
      matrixSelect.value = 'hard_sweet_biscuit';
      powerSlider.value = 50;
      gapSlider.value = 85;
      speedSlider.value = 24;
      moistureSlider.value = 6.5;
      rhSlider.value = 40;
      saltSlider.value = 0.8;
      updateSimulation();
    });

    btnDigestive.addEventListener('click', function() {
      systemSelect.value = 'ultra_wide_industrial_120kw';
      matrixSelect.value = 'digestive_cookie';
      powerSlider.value = 95;
      gapSlider.value = 90;
      speedSlider.value = 16;
      moistureSlider.value = 7.8;
      rhSlider.value = 45;
      saltSlider.value = 1.0;
      updateSimulation();
    });

    btnHazard.addEventListener('click', function() {
      systemSelect.value = 'uncalibrated_cavitating_rf';
      matrixSelect.value = 'soda_cracker';
      powerSlider.value = 60;
      gapSlider.value = 35;
      speedSlider.value = 40;
      moistureSlider.value = 6.2;
      rhSlider.value = 85;
      saltSlider.value = 2.4;
      updateSimulation();
    });

    // Run initial simulation on load
    updateSimulation();
  })();
</script>
