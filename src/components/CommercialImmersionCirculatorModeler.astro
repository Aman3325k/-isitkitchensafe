    copyReportBtn: "完全エンジニアリング監査レポートをコピー",
    copiedFeedback: "監査レポートをクリップボードにコピーしました！"
  }
};

const d = DICTIONARY[lang] || DICTIONARY.en;
---

<section class="bg-surface border border-hairline rounded-3xl p-6 md:p-10 shadow-sm relative overflow-hidden" id="circulator-modeler-root">
  <!-- Top Badge & Header -->
  <div class="flex flex-wrap items-center justify-between gap-4 mb-8 pb-6 border-b border-hairline/80">
    <div class="space-y-1">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-sky-600/10 text-sky-800 dark:text-sky-300 border border-sky-600/20">
        <span class="w-2 h-2 rounded-full bg-sky-500 animate-pulse"></span>
        {d.badge}
      </div>
      <h2 class="text-2xl md:text-3xl font-extrabold text-ink tracking-tight mt-2">
        {d.title}
      </h2>
      <p class="text-sm md:text-base text-muted max-w-4xl leading-relaxed">
        {d.subtitle}
      </p>
    </div>
    <div class="flex items-center gap-2">
      <span class="text-xs font-mono px-3 py-1.5 rounded-lg bg-surface-soft border border-hairline text-muted">
        FDA 2022 &bull; NSF 8 &bull; USDA FSIS
      </span>
    </div>
  </div>

  <!-- Operational Presets -->
  <div class="mb-8 p-5 bg-surface-soft border border-hairline rounded-2xl">
    <div class="text-xs font-bold uppercase tracking-wider text-muted mb-3 flex items-center gap-2">
      <span>⚡</span> {d.presetsTitle}
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5">
      <button 
        type="button" 
        class="preset-btn text-left p-3 rounded-xl border border-hairline bg-surface hover:bg-surface-elevated text-xs font-medium text-ink transition-all hover:border-sky-500/50 hover:shadow-xs active:scale-[0.98]" 
        data-preset="gold-standard"
      >
        <span class="block font-bold text-sky-600 dark:text-sky-400 mb-1">✓ FDA Gold Standard</span>
        <span class="line-clamp-2 text-muted">{d.presetGoldStandard}</span>
      </button>
      <button 
        type="button" 
        class="preset-btn text-left p-3 rounded-xl border border-hairline bg-surface hover:bg-surface-elevated text-xs font-medium text-ink transition-all hover:border-red-500/50 hover:shadow-xs active:scale-[0.98]" 
        data-preset="banquet-deadzone"
      >
        <span class="block font-bold text-red-600 dark:text-red-400 mb-1">🚨 Banquet Dead-Zone</span>
        <span class="line-clamp-2 text-muted">{d.presetBanquetDeadZone}</span>
      </button>
      <button 
        type="button" 
        class="preset-btn text-left p-3 rounded-xl border border-hairline bg-surface hover:bg-surface-elevated text-xs font-medium text-ink transition-all hover:border-amber-500/50 hover:shadow-xs active:scale-[0.98]" 
        data-preset="calcified-decoupling"
      >
        <span class="block font-bold text-amber-600 dark:text-amber-400 mb-1">⚠️ Calcified Decoupling</span>
        <span class="line-clamp-2 text-muted">{d.presetCalcifiedDecoupling}</span>
      </button>
      <button 
        type="button" 
        class="preset-btn text-left p-3 rounded-xl border border-hairline bg-surface hover:bg-surface-elevated text-xs font-medium text-ink transition-all hover:border-purple-500/50 hover:shadow-xs active:scale-[0.98]" 
        data-preset="sublethal-danger"
      >
        <span class="block font-bold text-purple-600 dark:text-purple-400 mb-1">☣️ Sub-Lethal Danger</span>
        <span class="line-clamp-2 text-muted">{d.presetSublethalDanger}</span>
      </button>
    </div>
  </div>

  <!-- Interactive Simulator Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-10">
    <!-- Controls (7 Cols) -->
    <div class="lg:col-span-7 space-y-6">
      <div class="border-b border-hairline pb-3">
        <h3 class="text-base font-bold text-ink flex items-center gap-2">
          <span>⚙️</span> {d.controlsTitle}
        </h3>
        <p class="text-xs text-muted mt-1">{d.controlsSub}</p>
      </div>

      <!-- Select 1: Circulator Architecture -->
      <div class="space-y-1.5">
        <label for="circulator-select" class="block text-xs font-bold uppercase tracking-wider text-ink">
          {d.circulatorLabel}
        </label>
        <select id="circulator-select" class="w-full text-sm bg-surface-soft border border-hairline rounded-xl px-3.5 py-2.5 text-ink focus:outline-none focus:border-sky-500 transition-colors">
          {circulatorData.circulatorConfigurations.map(c => (
            <option value={c.id}>{c.name}</option>
          ))}
        </select>
        <p class="text-xs text-muted">{d.circulatorHelp}</p>
      </div>

      <!-- Select 2: Cook Cycle Profile -->
      <div class="space-y-1.5">
        <label for="cycle-select" class="block text-xs font-bold uppercase tracking-wider text-ink">
          {d.cycleLabel}
        </label>
        <select id="cycle-select" class="w-full text-sm bg-surface-soft border border-hairline rounded-xl px-3.5 py-2.5 text-ink focus:outline-none focus:border-sky-500 transition-colors">
          {circulatorData.cookTemperatureCycles.map(c => (
            <option value={c.id}>{c.name}</option>
          ))}
        </select>
        <p class="text-xs text-muted">{d.cycleHelp}</p>
      </div>

      <!-- Select 3: Tank Flow & Pouch Spacing -->
      <div class="space-y-1.5">
        <label for="flow-select" class="block text-xs font-bold uppercase tracking-wider text-ink">
          {d.flowLabel}
        </label>
        <select id="flow-select" class="w-full text-sm bg-surface-soft border border-hairline rounded-xl px-3.5 py-2.5 text-ink focus:outline-none focus:border-sky-500 transition-colors">
          {circulatorData.tankFlowAndCirculationDynamics.map(f => (
            <option value={f.id}>{f.name}</option>
          ))}
        </select>
        <p class="text-xs text-muted">{d.flowHelp}</p>
      </div>

      <!-- Select 4: Scale & Biofilm Conditions -->
      <div class="space-y-1.5">
        <label for="scale-select" class="block text-xs font-bold uppercase tracking-wider text-ink">
          {d.scaleLabel}
        </label>
        <select id="scale-select" class="w-full text-sm bg-surface-soft border border-hairline rounded-xl px-3.5 py-2.5 text-ink focus:outline-none focus:border-sky-500 transition-colors">
          {circulatorData.heatingCoilScaleAndBiofilmConditions.map(s => (
            <option value={s.id}>{s.name}</option>
          ))}
        </select>
        <p class="text-xs text-muted">{d.scaleHelp}</p>
      </div>

      <!-- Select 5: Water Quality & Sanitation -->
      <div class="space-y-1.5">
        <label for="sanitation-select" class="block text-xs font-bold uppercase tracking-wider text-ink">
          {d.sanitationLabel}
        </label>
        <select id="sanitation-select" class="w-full text-sm bg-surface-soft border border-hairline rounded-xl px-3.5 py-2.5 text-ink focus:outline-none focus:border-sky-500 transition-colors">
          {circulatorData.waterQualityAndSanitationRegimens.map(w => (
            <option value={w.id}>{w.name}</option>
          ))}
        </select>
        <p class="text-xs text-muted">{d.sanitationHelp}</p>
      </div>

      <!-- Sliders Section -->
      <div class="pt-4 border-t border-hairline space-y-4">
        <!-- Slider 1: Bath Volume -->
        <div class="space-y-1.5">
          <div class="flex items-center justify-between text-xs font-bold text-ink">
            <span>{d.volumeSliderLabel}</span>
            <span id="volume-val" class="font-mono text-sky-600 dark:text-sky-400">45 L</span>
          </div>
          <input 
            type="range" 
            id="volume-slider" 
            min="10" 
            max="120" 
            step="5" 
            value="45"
            class="w-full accent-sky-600 cursor-pointer"
          />
          <p class="text-xs text-muted">{d.volumeSliderHelp}</p>
        </div>

        <!-- Slider 2: Set Temperature -->
        <div class="space-y-1.5">
          <div class="flex items-center justify-between text-xs font-bold text-ink">
            <span>{d.tempSliderLabel}</span>
            <span id="temp-val" class="font-mono text-sky-600 dark:text-sky-400">56.0°C (132.8°F)</span>
          </div>
          <input 
            type="range" 
            id="temp-slider" 
            min="45.0" 
            max="75.0" 
            step="0.5" 
            value="56.0"
            class="w-full accent-sky-600 cursor-pointer"
          />
          <p class="text-xs text-muted">{d.tempSliderHelp}</p>
        </div>

        <!-- Slider 3: Cook Duration -->
        <div class="space-y-1.5">
          <div class="flex items-center justify-between text-xs font-bold text-ink">
            <span>{d.durationSliderLabel}</span>
            <span id="duration-val" class="font-mono text-sky-600 dark:text-sky-400">48 Hours</span>
          </div>
          <input 
            type="range" 
            id="duration-slider" 
            min="1" 
            max="72" 
            step="1" 
            value="48"
            class="w-full accent-sky-600 cursor-pointer"
          />
          <p class="text-xs text-muted">{d.durationSliderHelp}</p>
        </div>
      </div>
    </div>

    <!-- Telemetry & Diagnostic Visualizer (5 Cols) -->
    <div class="lg:col-span-5 space-y-6 flex flex-col justify-between">
      <div class="p-6 bg-surface-soft border border-hairline rounded-2xl space-y-5">
        <div class="flex items-center justify-between border-b border-hairline pb-3">
          <h3 class="text-sm font-bold text-ink flex items-center gap-2">
            <span>📊</span> {d.diagnosticTitle}
          </h3>
          <span id="risk-badge" class="px-2.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-600/10 text-emerald-700 dark:text-emerald-400 border border-emerald-600/20">
            OPTIMAL / SAFE
          </span>
        </div>

        <!-- Diagnostic Metrics Grid -->
        <div class="grid grid-cols-2 gap-3">
          <div class="p-3 bg-surface rounded-xl border border-hairline/60">
            <span class="text-xs text-muted block mb-1">{d.effectiveTempLabel}</span>
            <span id="effective-temp-val" class="text-base font-extrabold text-ink font-mono">56.0°C</span>
            <span class="text-[10px] text-muted block mt-0.5" id="decoupling-offset">Offset: 0.0°C</span>
          </div>
          <div class="p-3 bg-surface rounded-xl border border-hairline/60">
            <span class="text-xs text-muted block mb-1">{d.coldSpotTempLabel}</span>
            <span id="cold-spot-val" class="text-base font-extrabold text-ink font-mono">55.8°C</span>
            <span class="text-[10px] text-muted block mt-0.5" id="strat-gradient">&Delta;T: 0.2°C</span>
          </div>
          <div class="p-3 bg-surface rounded-xl border border-hairline/60">
            <span class="text-xs text-muted block mb-1">{d.sporeRiskLabel}</span>
            <span id="spore-risk-val" class="text-base font-extrabold text-emerald-600 dark:text-emerald-400 font-mono">NEGLIGIBLE</span>
            <span class="text-[10px] text-muted block mt-0.5" id="spore-index">Index: 2 / 100</span>
          </div>
          <div class="p-3 bg-surface rounded-xl border border-hairline/60">
            <span class="text-xs text-muted block mb-1">{d.pathogenKillLabel}</span>
            <span id="pathogen-kill-val" class="text-base font-extrabold text-emerald-600 dark:text-emerald-400 font-mono">7.2-Log Kill</span>
            <span class="text-[10px] text-muted block mt-0.5">Salmonella / Listeria</span>
          </div>
        </div>

        <!-- Compliance Banner -->
        <div class="p-3.5 bg-surface rounded-xl border border-hairline/80 space-y-1">
          <span class="text-xs font-bold text-muted uppercase tracking-wider block">{d.complianceLabel}</span>
          <span id="compliance-val" class="text-xs font-bold font-mono text-emerald-600 dark:text-emerald-400 block">
            COMPLIANT: FDA Food Code 2022 § 3-501.13 Validated
          </span>
        </div>

        <!-- Engineering Narrative Cards -->
        <div class="space-y-3 pt-2 text-xs">
          <div>
            <span class="font-bold text-ink block mb-0.5">{d.primaryRiskLabel}</span>
            <p id="risk-desc" class="text-muted leading-relaxed">
              Minimal microbiological risk. Constant water circulation (Re > 4000) and uniform thermal delivery exceed the 54.4°C / 130°F pasteurization threshold.
            </p>
          </div>
          <div>
