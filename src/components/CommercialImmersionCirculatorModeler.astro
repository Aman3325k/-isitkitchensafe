<script is:inline define:vars={{ d, circulatorData }}>
  document.addEventListener('DOMContentLoaded', () => {
    const root = document.getElementById('circulator-modeler-root');
    if (!root) return;

    // Elements
    const circulatorSelect = root.querySelector('#circulator-select');
    const cycleSelect = root.querySelector('#cycle-select');
    const flowSelect = root.querySelector('#flow-select');
    const scaleSelect = root.querySelector('#scale-select');
    const sanitationSelect = root.querySelector('#sanitation-select');

    const volumeSlider = root.querySelector('#volume-slider');
    const tempSlider = root.querySelector('#temp-slider');
    const durationSlider = root.querySelector('#duration-slider');

    const volumeVal = root.querySelector('#volume-val');
    const tempVal = root.querySelector('#temp-val');
    const durationVal = root.querySelector('#duration-val');

    const effectiveTempVal = root.querySelector('#effective-temp-val');
    const coldSpotVal = root.querySelector('#cold-spot-val');
    const sporeRiskVal = root.querySelector('#spore-risk-val');
    const pathogenKillVal = root.querySelector('#pathogen-kill-val');
    const complianceVal = root.querySelector('#compliance-val');
    const riskBadge = root.querySelector('#risk-badge');

    const decouplingOffset = root.querySelector('#decoupling-offset');
    const stratGradient = root.querySelector('#strat-gradient');
    const sporeIndex = root.querySelector('#spore-index');

    const riskDesc = root.querySelector('#risk-desc');
    const mechanismDesc = root.querySelector('#mechanism-desc');
    const mitigationDesc = root.querySelector('#mitigation-desc');

    const copyBtn = root.querySelector('#copy-report-btn');
    const copyBtnText = root.querySelector('#copy-btn-text');

    function calculate() {
      const circId = circulatorSelect.value;
      const cycleId = cycleSelect.value;
      const flowId = flowSelect.value;
      const scaleId = scaleSelect.value;
      const sanId = sanitationSelect.value;

      const volume = parseFloat(volumeSlider.value);
      const setTemp = parseFloat(tempSlider.value);
      const duration = parseFloat(durationSlider.value);

      // Lookups
      const circ = circulatorData.circulatorConfigurations.find(c => c.id === circId) || circulatorData.circulatorConfigurations[0];
      const cycle = circulatorData.cookTemperatureCycles.find(c => c.id === cycleId) || circulatorData.cookTemperatureCycles[0];
      const flow = circulatorData.tankFlowAndCirculationDynamics.find(f => f.id === flowId) || circulatorData.tankFlowAndCirculationDynamics[0];
      const scale = circulatorData.heatingCoilScaleAndBiofilmConditions.find(s => s.id === scaleId) || circulatorData.heatingCoilScaleAndBiofilmConditions[0];
      const san = circulatorData.waterQualityAndSanitationRegimens.find(w => w.id === sanId) || circulatorData.waterQualityAndSanitationRegimens[0];

      // Update Slider Labels
      const tempF = (setTemp * 1.8 + 32).toFixed(1);
      volumeVal.textContent = `${volume} L`;
      tempVal.textContent = `${setTemp.toFixed(1)}°C (${tempF}°F)`;
      durationVal.textContent = `${duration} Hours`;

      // Thermal Decoupling Offset: Limescale insulates thermistor and element
      let thermalDecoupling = scale.thermalDecouplingDeltaTC;
      if (sanId === 'grease_contaminated_bath_neglect') thermalDecoupling += 0.6;
      if (volume > circ.maxBathVolumeLiters) {
        thermalDecoupling += (volume - circ.maxBathVolumeLiters) * 0.03;
      }

      // Actual Bulk Water Temp: Due to thermistor shielding, bulk water is cooler than set temp
      const bulkWaterTemp = Math.max(30.0, setTemp - thermalDecoupling);

      // Thermal Stratification Gradient: Fluid dynamics and pouch crowding
      let deltaT = flow.thermalGradientDeltaTC;
      // Volume overload penalty
      if (volume > circ.maxBathVolumeLiters) {
        deltaT += 0.8 * (volume / circ.maxBathVolumeLiters);
      }
      // Low pump flow penalty
      if (circ.flowRateLitersMin < 12) {
        deltaT += 0.5 * (12 - circ.flowRateLitersMin);
      }

      // Stagnant Corner Cold Spot
      const coldSpotTemp = Math.max(25.0, bulkWaterTemp - deltaT);

      // Microbiological Lethality Calculation
      // 54.4°C is the critical threshold for spore germination and vegetative pathogen inactivation
      let netSalmonellaKill = 0;
      let netListeriaKill = 0;
      let sporeRiskScore = 0; // 0 to 100

      if (coldSpotTemp >= 60.0) {
        netSalmonellaKill = Math.min(9.5, 6.0 + duration * 0.15);
        netListeriaKill = Math.min(9.0, 5.5 + duration * 0.12);
        sporeRiskScore = 2;
      } else if (coldSpotTemp >= 55.0) {
        netSalmonellaKill = Math.min(8.0, 4.5 + duration * 0.08);
        netListeriaKill = Math.min(7.5, 4.0 + duration * 0.07);
        sporeRiskScore = 8;
      } else if (coldSpotTemp >= 54.4) {
        netSalmonellaKill = Math.min(6.5, 3.5 + duration * 0.04);
        netListeriaKill = Math.min(6.0, 3.0 + duration * 0.03);
        sporeRiskScore = 18;
      } else if (coldSpotTemp >= 50.0) {
        // Below 54.4°C: Spore germination window!
        netSalmonellaKill = Math.max(0.5, 2.5 - duration * 0.03);
        netListeriaKill = Math.max(0.3, 2.0 - duration * 0.04);
        sporeRiskScore = Math.min(85, 40 + duration * 1.1);
      } else {
        // Severe danger zone (<50°C)
        netSalmonellaKill = 0.2;
        netListeriaKill = 0.1;
        sporeRiskScore = Math.min(100, 70 + duration * 1.5);
      }

      // Scale Biofilm Penalty on Lethality
      if (scale.biofilmColonyDensityCfuCm2 > 5000) {
        netSalmonellaKill = Math.max(0.1, netSalmonellaKill - 1.2);
        netListeriaKill = Math.max(0.1, netListeriaKill - 1.0);
        sporeRiskScore = Math.min(100, sporeRiskScore + 15);
      }

      // Update UI Telemetry
      effectiveTempVal.textContent = `${bulkWaterTemp.toFixed(1)}°C`;
      decouplingOffset.textContent = `Offset: -${thermalDecoupling.toFixed(1)}°C`;

      coldSpotVal.textContent = `${coldSpotTemp.toFixed(1)}°C`;
      stratGradient.textContent = `ΔT: ${deltaT.toFixed(1)}°C`;

      sporeIndex.textContent = `Index: ${Math.round(sporeRiskScore)} / 100`;
      pathogenKillVal.textContent = `${netSalmonellaKill.toFixed(1)}-Log Kill`;

      if (sporeRiskScore < 20) {
        sporeRiskVal.textContent = "NEGLIGIBLE";
        sporeRiskVal.className = "text-base font-extrabold text-emerald-600 dark:text-emerald-400 font-mono";
      } else if (sporeRiskScore < 50) {
        sporeRiskVal.textContent = "MODERATE";
        sporeRiskVal.className = "text-base font-extrabold text-amber-600 dark:text-amber-400 font-mono";
      } else {
        sporeRiskVal.textContent = "CRITICAL OUTGROWTH";
        sporeRiskVal.className = "text-base font-extrabold text-red-600 dark:text-red-400 font-mono";
      }

      // Compliance determination
      let isCompliant = true;
      let complianceText = "";
      let riskLevel = "SAFE";

      if (coldSpotTemp < 54.4) {
        isCompliant = false;
        complianceText = "VIOLATION: Cold Spot < 54.4°C (130°F) Endangers Pathogen Inactivation";
        riskLevel = "CRITICAL";
      } else if (netSalmonellaKill < 6.5) {
        isCompliant = false;
        complianceText = "WARNING: Pathogen Lethality < 6.5-Log Reduction under FDA Standards";
        riskLevel = "ELEVATED";
      } else if (thermalDecoupling > 1.5) {
        isCompliant = false;
        complianceText = "WARNING: Heating Coil Scale Decoupling Exceeds 1.5°C";
        riskLevel = "ELEVATED";
      } else {
        complianceText = "COMPLIANT: FDA Food Code 2022 § 3-501.13 Validated";
        riskLevel = "SAFE";
      }

      complianceVal.textContent = complianceText;
      if (isCompliant) {
        complianceVal.className = "text-xs font-bold font-mono text-emerald-600 dark:text-emerald-400 block";
      } else {
        complianceVal.className = "text-xs font-bold font-mono text-red-600 dark:text-red-400 block";
      }

      // Risk Badge and Narrative
      if (riskLevel === "SAFE") {
        riskBadge.textContent = "OPTIMAL / SAFE";
        riskBadge.className = "px-2.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-600/10 text-emerald-700 dark:text-emerald-400 border border-emerald-600/20";
        riskDesc.textContent = "Minimal microbiological risk. High flow velocity (Re > 4000) and uniform cross-flow keep all food pouches safely above the 54.4°C / 130°F thermal inactivation threshold.";
        mechanismDesc.textContent = "Thermal energy denatures vegetative Salmonella and Listeria cell membranes. Pristine 316 stainless steel coils provide clean heat flux without limescale insulation or biofilm harborage.";
        mitigationDesc.textContent = "Maintain validated 15mm wire rack pouch spacing. Drain water bath daily and circulate 5% citric acid weekly at 60°C to prevent mineral build-up.";
      } else if (riskLevel === "ELEVATED") {
        riskBadge.textContent = "ELEVATED RISK";
        riskBadge.className = "px-2.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-600/10 text-amber-700 dark:text-amber-400 border border-amber-600/20";
        riskDesc.textContent = "Elevated pathogen persistence risk. Mineral limescale on the heating element or moderate pouch crowding reduces net lethality below optimal 6.5-log reduction.";
        mechanismDesc.textContent = "Limescale acts as a thermal barrier, causing the internal controller thermistor to misread bulk water temperature. Crowded pouches create localized micro-convection bottlenecks.";
        mitigationDesc.textContent = "Descaling required within 48 hours. Remove stacked pouches and install wire rack dividing inserts. Check bulk water temperature with calibrated secondary thermometer.";
      } else {
        riskBadge.textContent = "CRITICAL OUTGROWTH";
        riskBadge.className = "px-2.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-red-600/10 text-red-700 dark:text-red-400 border border-red-600/20";
        riskDesc.textContent = "Catastrophic foodborne illness hazard. Cold spot temperature has dropped below 54.4°C (130°F) in stagnant corners, creating an incubator for Clostridium perfringens.";
        mechanismDesc.textContent = "Under vacuum packaging without oxygen, bacterial endospores germinate and replicate rapidly between 45°C and 53°C. Limescale thermal decoupling and blocked water circulation create dangerous thermal gradients.";
        mitigationDesc.textContent = "IMMEDIATE CULINARY ISOLATION. Verify internal meat core temperature. If food was submerged below 54.4°C for >2 hours, DISCARD IMMEDIATELY under FDA Food Code § 3-501.13.";
      }
    }

    // Presets Click Handler
    root.querySelectorAll('.preset-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const p = btn.getAttribute('data-preset');
        if (p === 'gold-standard') {
          circulatorSelect.value = 'heavy_duty_commercial_head';
          cycleSelect.value = 'pasteurized_chef_medium_rare_beef';
          flowSelect.value = 'unobstructed_turbulent_crossflow';
          scaleSelect.value = 'factory_descaled_sanitized_316ss';
          sanitationSelect.value = 'daily_drain_acid_descale_sanitized';
          volumeSlider.value = 45;
          tempSlider.value = 56.0;
          durationSlider.value = 48;
        } else if (p === 'banquet-deadzone') {
          circulatorSelect.value = 'high_density_packed_polycarbonate_tank';
          cycleSelect.value = 'severe_thermal_inversion_deadzone';
          flowSelect.value = 'crowded_overstacked_pouches';
          scaleSelect.value = 'moderate_mineral_scale_30_days';
          sanitationSelect.value = 'multi_day_stagnant_topup_only';
          volumeSlider.value = 45;
          tempSlider.value = 54.5;
          durationSlider.value = 30;
        } else if (p === 'calcified-decoupling') {
          circulatorSelect.value = 'standard_commercial_clip_on';
          cycleSelect.value = 'pasteurized_chef_medium_rare_beef';
          flowSelect.value = 'moderate_pouch_loading_wire_racks';
          scaleSelect.value = 'severe_calcification_bag_leakage';
          sanitationSelect.value = 'grease_contaminated_bath_neglect';
          volumeSlider.value = 35;
          tempSlider.value = 55.0;
          durationSlider.value = 36;
        } else if (p === 'sublethal-danger') {
          circulatorSelect.value = 'standard_commercial_clip_on';
          cycleSelect.value = 'borderline_danger_zone_rare';
          flowSelect.value = 'stratified_surface_evaporation_no_lid';
          scaleSelect.value = 'moderate_mineral_scale_30_days';
          sanitationSelect.value = 'lukewarm_standing_water_intermittent';
          volumeSlider.value = 40;
          tempSlider.value = 53.5;
          durationSlider.value = 36;
        }
        calculate();
      });
    });

    // Listeners
    [circulatorSelect, cycleSelect, flowSelect, scaleSelect, sanitationSelect].forEach(el => el.addEventListener('change', calculate));
    [volumeSlider, tempSlider, durationSlider].forEach(el => el.addEventListener('input', calculate));

    // Copy Report Handler
    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        const report = `=== ISITKITCHENSAFE COMMERCIAL IMMERSION CIRCULATOR ENGINEERING AUDIT ===\n` +
          `Date: ${new Date().toISOString()}\n` +
          `Circulator Architecture: ${circulatorSelect.options[circulatorSelect.selectedIndex].text}\n` +
          `Cooking Cycle Profile: ${cycleSelect.options[cycleSelect.selectedIndex].text}\n` +
          `Fluid Dynamics & Spacing: ${flowSelect.options[flowSelect.selectedIndex].text}\n` +
          `Heating Coil Condition: ${scaleSelect.options[scaleSelect.selectedIndex].text}\n` +
          `Sanitation Protocol: ${sanitationSelect.options[sanitationSelect.selectedIndex].text}\n` +
          `Bath Volume: ${volumeVal.textContent}\n` +
          `Thermostat Set Temp: ${tempVal.textContent}\n` +
          `Cooking Duration: ${durationVal.textContent}\n` +
          `--------------------------------------------------\n` +
          `Effective Bulk Water: ${effectiveTempVal.textContent} (${decouplingOffset.textContent})\n` +
          `Stagnant Corner Cold Spot: ${coldSpotVal.textContent} (${stratGradient.textContent})\n` +
          `Spore Outgrowth Risk: ${sporeRiskVal.textContent} (${sporeIndex.textContent})\n` +
          `Pathogen Reduction: ${pathogenKillVal.textContent}\n` +
          `FDA Food Code Status: ${complianceVal.textContent}\n` +
          `Risk Classification: ${riskBadge.textContent.trim()}\n` +
          `--------------------------------------------------\n` +
          `Audit Standard: FDA Food Code 2022 § 3-501.13 | NSF/ANSI 8 | USDA FSIS Appendix A`;

        navigator.clipboard.writeText(report).then(() => {
          const original = copyBtnText.textContent;
          copyBtnText.textContent = d.copiedFeedback;
          setTimeout(() => {
            copyBtnText.textContent = original;
          }, 2500);
        });
      });
    }

    calculate();
  });
</script>
