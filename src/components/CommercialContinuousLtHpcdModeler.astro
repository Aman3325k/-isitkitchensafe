    title: "商用連続式低温高圧炭酸ガス（稠密相CO2）殺菌＆インライン炭酸化（LT-HPCD）モデラー",
    subtitle: "連続式低温高圧炭酸ガス殺菌および溶解炭酸化プロセス（LT-HPCD、80〜150 bar、18〜32°C）をシミュレーション。FDA 21 CFR § 120（果汁HACCP）、FDA 21 CFR § 184.1240 GRAS、ASME BPVC VIII、3-A 60-01/61-01基準に準拠し、加熱臭なしで5-log以上の病原菌死滅、芽胞不活化、ビタミンC 97%以上保持を達成します。",
    controlsTitle: "LT-HPCD プロセススキッド運転条件設定",
    controlsSub: "高圧反応圧力、保持温度、CO2注入質量比、保持管滞留時間、連続処理流量を設定します。",
    skidLabel: "稠密相HPCDスキッドシステム構造:",
    skidHelp: "商用連続殺菌スキッド、クラフトコンブチャ/コールドブリュー機、高酸性柑橘用スキッド、研究用パイロット機から選択。",
    beverageLabel: "飲料基質・液体マトリックス:",
    beverageHelp: "無濾過混濁リンゴ果汁、バレンシアオレンジ果汁、生コンブチャ茶、コールドブリュー珈琲、天然ココナッツ水、高糖度危険泥流から選択。",
    pathogenLabel: "対象微生物・腐敗性芽胞菌:",
    pathogenHelp: "Alicyclobacillus耐熱耐酸性芽胞、Saccharomyces酵母、病原性大腸菌O157:H7、サルモネラ菌、リステリア菌から選択。",
    dosingLabel: "CO2混合・気液接触インジェクター:",
    dosingHelp: "焼結多孔質チタンマイクロスパージャー、Sulzer SMX Plusスタティックミキサー、ベンチュリインジェクター、短絡配管から選択。",
    nozzleLabel: "減圧ノズル＆炭酸化膨張機構:",
    nozzleHelp: "セラミック微細オリフィスノズル、誘導加熱同軸ノズル、多段ラビリンス減圧弁から選択。",
    carbonationLabel: "仕上がり目標炭酸ガス溶解度:",
    carbonationHelp: "無炭酸果汁（脱気）、微炭酸シードル（2.1 vol）、標準クラフトソーダ（3.2 vol）、強炭酸水（4.5 vol）から選択。",
    pressureLabel: "稠密相反応圧力 (P_reactor):",
    pressureHelp: "接触器および保持コイル内の圧力（70.0〜180.0 bar）。CO2溶解度と細胞膜透過破壊力を左右します。",
    tempLabel: "プロセス運転温度 (T_process):",
    tempHelp: "保持コイル内温度（15.0〜38.0 °C）。低温維持でビタミンC熱分解と加熱劣化臭を防止します。",
    co2RatioLabel: "CO2注入質量比 (w_CO2):",
    co2RatioHelp: "二酸化炭素の連続注入比率（4.0〜14.0 wt%）。炭酸解離によるpH降下を制御します。",
    residenceLabel: "保持コイル内滞留時間 (t_residence):",
    residenceHelp: "高圧マルチパス微小管反応器内の流体通過時間（1.0〜15.0分）。",
    throughputLabel: "飲料連続処理流量 (Q_liquid):",
    throughputHelp: "スキッドの体積流量（50〜3000 L/h）。",
    presetsTitle: "工業標準運転プリセット:",
    presetCider: "混濁リンゴ果汁耐酸性芽胞死滅 (130 bar, 24°C, 8.5 wt%, 6.0分, 5.8-log芽胞死滅, ビタミンC 97.5%以上)",
    presetOrange: "オレンジ果汁ペクチンエステラーゼ失活 (140 bar, 28°C, 10.0 wt%, 7.5分, 96.8% PME失活, 混濁維持)",
    presetKombucha: "生コンブチャ炭酸化＆菌叢調和 (85 bar, 20°C, 6.0 wt%, 3.5分, 3.2 vol CO2, 酵母適正化)",
    presetCoffee: "コールドブリュー低酸度安全殺菌 (120 bar, 22°C, 7.5 wt%, 5.0分, 6.5-log死滅, 焦げ苦味ゼロ)",
    presetHazard: "バイパス短絡・重大殺菌不良ハザード (50 bar, 38°C, 2.0 wt%, 0.8分, HACCP 5-log基準違反)",
    telemetryTitle: "リアルタイム速度論テレメトリ＆診断レーダー",
    telemetrySub: "熱力学的状態、微生物致死率、溶解炭酸化、省エネルギー指標の連続算出。",
    pathogenReductionLabel: "病原菌致死対数値 (Log10):",
    sporeReductionLabel: "芽胞不活化対数値 (Log10):",
    pmeInactivationLabel: "PME酵素失活率:",
    vitaminCRetentionLabel: "ビタミンC（L-アスコルビン酸）保持率:",
    aromaRetentionLabel: "フレッシュ果実アロマ保持率:",
    carbonationLevelLabel: "溶存炭酸ガス濃度 (CO2 Vol):",
    secLabel: "比エネルギー消費量 (SEC kWh/hL):",
    energySavingsLabel: "加熱殺菌対比省エネ率:",
    co2RecycleLabel: "CO2クローズドループ回収率:",
    haccpVerdictLabel: "FDA 21 CFR § 120 HACCP判定:",
    diagramTitle: "連続LT-HPCDフロー＆減圧回収系統図",
    diagramSub: "高圧気液接触、微小管反応、受控炭酸化膨張、CO2再圧縮回収ループ。",
    scienceTitle: "熱力学的相平衡と微生物非熱的死滅理論",
    scienceSub: "細胞内アシドーシス、脂質二重層膜抽出、ヘンリーの法則高圧溶解現象。",
    tableTitle: "サニタリーエンジニアリング＆法規制準拠マトリックス",
    exportAuditBtn: "適合性監査証書の発行 (PDF / JSON)"
  }
};

const d = DICT[lang] || DICT.en;
---

<div class="lt-hpcd-modeler-container space-y-10" id="lt-hpcd-modeler">
  <!-- Header Badge & Intro -->
  <header class="border-b border-hairline/60 pb-6">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-950 text-emerald-300 border border-emerald-800 mb-3">
      <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      {d.badge}
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-ink tracking-tight mb-3">
      {d.title}
    </h1>
    <p class="text-body text-base leading-relaxed text-muted max-w-4xl">
      {d.subtitle}
    </p>
  </header>

  <!-- Industrial Presets Bar -->
  <section class="bg-surface-soft border border-hairline rounded-2xl p-5 shadow-xs">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 mb-3">
      <h2 class="text-sm font-bold text-ink uppercase tracking-wider flex items-center gap-2">
        <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        {d.presetsTitle}
      </h2>
      <span class="text-xs text-muted font-mono">1-Click HACCP Validated Setup</span>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-2">
      <button type="button" data-preset="cider" class="preset-btn text-left p-3 rounded-xl border border-hairline/80 bg-surface hover:bg-emerald-950/20 hover:border-emerald-700 transition text-xs font-medium text-ink flex flex-col gap-1">
        <span class="text-emerald-400 font-bold">🍏 Cider Spore Eradication</span>
        <span class="text-muted line-clamp-1">{d.presetCider}</span>
      </button>
      <button type="button" data-preset="orange" class="preset-btn text-left p-3 rounded-xl border border-hairline/80 bg-surface hover:bg-amber-950/20 hover:border-amber-700 transition text-xs font-medium text-ink flex flex-col gap-1">
        <span class="text-amber-400 font-bold">🍊 Valencia Orange PME Hold</span>
        <span class="text-muted line-clamp-1">{d.presetOrange}</span>
      </button>
      <button type="button" data-preset="kombucha" class="preset-btn text-left p-3 rounded-xl border border-hairline/80 bg-surface hover:bg-teal-950/20 hover:border-teal-700 transition text-xs font-medium text-ink flex flex-col gap-1">
        <span class="text-teal-400 font-bold">🍵 Probiotic Kombucha Carbonate</span>
        <span class="text-muted line-clamp-1">{d.presetKombucha}</span>
      </button>
      <button type="button" data-preset="coffee" class="preset-btn text-left p-3 rounded-xl border border-hairline/80 bg-surface hover:bg-amber-950/20 hover:border-amber-600 transition text-xs font-medium text-ink flex flex-col gap-1">
        <span class="text-amber-300 font-bold">☕ Cold-Brew Low-Acid Safety</span>
        <span class="text-muted line-clamp-1">{d.presetCoffee}</span>
      </button>
      <button type="button" data-preset="hazard" class="preset-btn text-left p-3 rounded-xl border border-red-900/60 bg-red-950/20 hover:bg-red-950/40 hover:border-red-600 transition text-xs font-medium text-red-200 flex flex-col gap-1">
        <span class="text-red-400 font-bold">🚨 Defective Bypass Hazard</span>
        <span class="text-red-300/80 line-clamp-1">{d.presetHazard}</span>
      </button>
    </div>
  </section>

  <!-- Interactive Simulator Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Controls Form (Left Column, 7 Cols) -->
    <div class="lg:col-span-7 bg-surface-soft border border-hairline rounded-2xl p-6 sm:p-7 shadow-xs space-y-6">
      <div class="border-b border-hairline/60 pb-4">
        <h2 class="text-lg font-bold text-ink tracking-tight flex items-center gap-2">
          <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/></svg>
          {d.controlsTitle}
        </h2>
        <p class="text-xs text-muted mt-1">{d.controlsSub}</p>
      </div>

      <!-- Selectors Group -->
      <div class="space-y-4">
        <!-- Skid Architecture -->
        <div>
          <label for="skid-select" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-1">
            {d.skidLabel}
          </label>
          <select id="skid-select" class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-xs font-medium text-ink focus:outline-hidden focus:border-emerald-500">
            {ltHpcdData.systemArchitectures.map(s => (
              <option value={s.id}>{s.name} ({s.minOperatingPressureBar}–{s.maxOperatingPressureBar} bar)</option>
            ))}
          </select>
          <p class="text-[11px] text-muted mt-1">{d.skidHelp}</p>
        </div>

        <!-- Beverage Matrix -->
        <div>
          <label for="beverage-select" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-1">
            {d.beverageLabel}
          </label>
          <select id="beverage-select" class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-xs font-medium text-ink focus:outline-hidden focus:border-emerald-500">
            {ltHpcdData.beverageMatrices.map(b => (
              <option value={b.id}>{b.name}</option>
            ))}
          </select>
          <p class="text-[11px] text-muted mt-1">{d.beverageHelp}</p>
        </div>

        <!-- Target Pathogen -->
        <div>
          <label for="pathogen-select" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-1">
            {d.pathogenLabel}
          </label>
          <select id="pathogen-select" class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-xs font-medium text-ink focus:outline-hidden focus:border-emerald-500">
            {ltHpcdData.microbialPathogens.map(p => (
              <option value={p.id}>{p.name}</option>
            ))}
          </select>
          <p class="text-[11px] text-muted mt-1">{d.pathogenHelp}</p>
        </div>

        <!-- Injection Dosing Mechanism -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="dosing-select" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-1">
              {d.dosingLabel}
            </label>
            <select id="dosing-select" class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-xs font-medium text-ink focus:outline-hidden focus:border-emerald-500">
              {ltHpcdData.co2DosingMechanisms.map(m => (
                <option value={m.id}>{m.name}</option>
              ))}
            </select>
          </div>

          <!-- Decompression Nozzle -->
          <div>
            <label for="nozzle-select" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-1">
              {d.nozzleLabel}
            </label>
            <select id="nozzle-select" class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-xs font-medium text-ink focus:outline-hidden focus:border-emerald-500">
              {ltHpcdData.decompressionNozzleTypes.map(n => (
                <option value={n.id}>{n.name}</option>
              ))}
            </select>
          </div>
        </div>

        <!-- Desired Carbonation Profile -->
        <div>
          <label for="carbonation-select" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-1">
            {d.carbonationLabel}
          </label>
          <select id="carbonation-select" class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-xs font-medium text-ink focus:outline-hidden focus:border-emerald-500">
            {ltHpcdData.carbonationSaturationProfiles.map(c => (
              <option value={c.id}>{c.name}</option>
            ))}
          </select>
          <p class="text-[11px] text-muted mt-1">{d.carbonationHelp}</p>
        </div>
      </div>

      <!-- Sliders Group -->
      <div class="space-y-5 pt-4 border-t border-hairline/60">
        <!-- Operating Pressure -->
        <div>
          <div class="flex justify-between items-center mb-1">
            <label for="pressure-slider" class="text-xs font-semibold text-ink">{d.pressureLabel}</label>
            <span id="pressure-val" class="font-mono text-xs font-bold text-emerald-400 bg-emerald-950/60 px-2 py-0.5 rounded-md border border-emerald-800">130.0 bar</span>
          </div>
          <input type="range" id="pressure-slider" min="70.0" max="180.0" step="1.0" value="130.0" class="w-full accent-emerald-500 cursor-pointer" />
          <div class="flex justify-between text-[10px] text-muted font-mono mt-0.5">
            <span>70.0 bar</span>
            <span>120.0 bar (Target)</span>
            <span>180.0 bar</span>
          </div>
        </div>

        <!-- Temperature -->
        <div>
          <div class="flex justify-between items-center mb-1">
            <label for="temp-slider" class="text-xs font-semibold text-ink">{d.tempLabel}</label>
            <span id="temp-val" class="font-mono text-xs font-bold text-amber-400 bg-amber-950/60 px-2 py-0.5 rounded-md border border-amber-800">24.0 °C</span>
          </div>
          <input type="range" id="temp-slider" min="15.0" max="38.0" step="0.5" value="24.0" class="w-full accent-amber-500 cursor-pointer" />
          <div class="flex justify-between text-[10px] text-muted font-mono mt-0.5">
            <span>15.0 °C (Chilled)</span>
            <span>25.0 °C (Ambient)</span>
            <span>38.0 °C (Max Sub-Thermal)</span>
          </div>
        </div>

        <!-- CO2 Dosing Ratio -->
        <div>
          <div class="flex justify-between items-center mb-1">
            <label for="co2-ratio-slider" class="text-xs font-semibold text-ink">{d.co2RatioLabel}</label>
            <span id="co2-ratio-val" class="font-mono text-xs font-bold text-cyan-400 bg-cyan-950/60 px-2 py-0.5 rounded-md border border-cyan-800">8.5 wt%</span>
          </div>
          <input type="range" id="co2-ratio-slider" min="4.0" max="14.0" step="0.5" value="8.5" class="w-full accent-cyan-500 cursor-pointer" />
          <div class="flex justify-between text-[10px] text-muted font-mono mt-0.5">
            <span>4.0 wt%</span>
            <span>8.5 wt% (Optimum)</span>
            <span>14.0 wt%</span>
          </div>
        </div>

        <!-- Residence Time -->
        <div>
          <div class="flex justify-between items-center mb-1">
            <label for="residence-slider" class="text-xs font-semibold text-ink">{d.residenceLabel}</label>
            <span id="residence-val" class="font-mono text-xs font-bold text-indigo-400 bg-indigo-950/60 px-2 py-0.5 rounded-md border border-indigo-800">6.0 min</span>
          </div>
          <input type="range" id="residence-slider" min="1.0" max="15.0" step="0.5" value="6.0" class="w-full accent-indigo-500 cursor-pointer" />
          <div class="flex justify-between text-[10px] text-muted font-mono mt-0.5">
            <span>1.0 min</span>
            <span>6.0 min (Holding Coil)</span>
            <span>15.0 min</span>
          </div>
        </div>

        <!-- Liquid Throughput -->
        <div>
          <div class="flex justify-between items-center mb-1">
            <label for="throughput-slider" class="text-xs font-semibold text-ink">{d.throughputLabel}</label>
            <span id="throughput-val" class="font-mono text-xs font-bold text-purple-400 bg-purple-950/60 px-2 py-0.5 rounded-md border border-purple-800">1500 L/h</span>
          </div>
          <input type="range" id="throughput-slider" min="50" max="3000" step="50" value="1500" class="w-full accent-purple-500 cursor-pointer" />
          <div class="flex justify-between text-[10px] text-muted font-mono mt-0.5">
            <span>50 L/h (Pilot)</span>
            <span>1500 L/h (Skid)</span>
            <span>3000 L/h (Plant)</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Diagnostic Radar & Telemetry Display (Right Column, 5 Cols) -->
    <div class="lg:col-span-5 space-y-6">
      <div class="bg-surface-soft border border-hairline rounded-2xl p-6 sm:p-7 shadow-xs space-y-5">
        <div class="border-b border-hairline/60 pb-4 flex items-center justify-between">
          <div>
            <h2 class="text-lg font-bold text-ink tracking-tight flex items-center gap-2">
              <svg class="w-5 h-5 text-emerald-400 animate-spin" style="animation-duration: 8s;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              {d.telemetryTitle}
            </h2>
            <p class="text-xs text-muted mt-0.5">{d.telemetrySub}</p>
          </div>
          <span id="status-pill" class="text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-wider bg-emerald-950 text-emerald-300 border border-emerald-800">
            HACCP PASS
          </span>
        </div>

        <!-- Key Metrics Cards -->
        <div class="grid grid-cols-2 gap-3">
          <!-- Pathogen Reduction -->
          <div class="p-3 rounded-xl bg-surface border border-hairline flex flex-col justify-between">
            <span class="text-[11px] text-muted">{d.pathogenReductionLabel}</span>
            <div class="mt-1 flex items-baseline gap-1">
              <span id="metric-pathogen-red" class="text-2xl font-black font-mono text-emerald-400">6.8</span>
              <span class="text-[10px] text-muted font-mono">log10</span>
            </div>
            <div class="w-full bg-hairline/40 h-1.5 rounded-full mt-2 overflow-hidden">
              <div id="bar-pathogen" class="bg-emerald-500 h-full rounded-full transition-all" style="width: 90%;"></div>
            </div>
          </div>

          <!-- Spore Inactivation -->
          <div class="p-3 rounded-xl bg-surface border border-hairline flex flex-col justify-between">
            <span class="text-[11px] text-muted">{d.sporeReductionLabel}</span>
            <div class="mt-1 flex items-baseline gap-1">
              <span id="metric-spore-red" class="text-2xl font-black font-mono text-cyan-400">5.4</span>
              <span class="text-[10px] text-muted font-mono">log10</span>
            </div>
            <div class="w-full bg-hairline/40 h-1.5 rounded-full mt-2 overflow-hidden">
              <div id="bar-spore" class="bg-cyan-500 h-full rounded-full transition-all" style="width: 85%;"></div>
            </div>
          </div>

          <!-- PME Enzyme Inactivation -->
          <div class="p-3 rounded-xl bg-surface border border-hairline flex flex-col justify-between">
            <span class="text-[11px] text-muted">{d.pmeInactivationLabel}</span>
            <div class="mt-1 flex items-baseline gap-1">
              <span id="metric-pme" class="text-2xl font-black font-mono text-amber-400">96.5%</span>
            </div>
            <span class="text-[10px] text-muted font-mono mt-2">Cloud Stable &gt;60d</span>
          </div>

          <!-- Vitamin C Retention -->
          <div class="p-3 rounded-xl bg-surface border border-hairline flex flex-col justify-between">
            <span class="text-[11px] text-muted">{d.vitaminCRetentionLabel}</span>
            <div class="mt-1 flex items-baseline gap-1">
              <span id="metric-vitc" class="text-2xl font-black font-mono text-emerald-400">97.8%</span>
            </div>
            <span class="text-[10px] text-muted font-mono mt-2">vs 68% Thermal</span>
          </div>
        </div>

        <!-- Secondary Metrics List -->
        <div class="space-y-2 text-xs border-y border-hairline/60 py-3">
          <div class="flex items-center justify-between">
            <span class="text-muted">{d.aromaRetentionLabel}</span>
            <span id="metric-aroma" class="font-mono font-bold text-ink">98.4% (Valencene/Limonene)</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-muted">{d.carbonationLevelLabel}</span>
            <span id="metric-carb" class="font-mono font-bold text-ink">3.20 vol (6.32 g/L CO2)</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-muted">{d.secLabel}</span>
            <span id="metric-sec" class="font-mono font-bold text-ink">1.15 kWh/hL</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-muted">{d.energySavingsLabel}</span>
            <span id="metric-savings" class="font-mono font-bold text-emerald-400">78.5% Reduction</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-muted">{d.co2RecycleLabel}</span>
            <span id="metric-recycle" class="font-mono font-bold text-cyan-400">94.2% Recompression</span>
          </div>
        </div>

        <!-- FDA 21 CFR § 120 HACCP Badge & Explanation -->
        <div id="haccp-callout" class="p-4 rounded-xl border border-emerald-800/80 bg-emerald-950/20 text-xs space-y-1.5">
          <div class="flex items-center gap-2 font-bold text-emerald-300">
            <svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            <span id="haccp-status-title">VALIDATED 5-LOG JUICE HACCP KILL STEP</span>
          </div>
          <p id="haccp-status-desc" class="text-muted text-[11px] leading-relaxed">
            Meets or exceeds statutory FDA 21 CFR § 120.24 requirements. The process achieves a continuous 6.8-log reduction of pertinent bacterial pathogens with 5.4-log spore destruction without heat-induced off-flavors.
          </p>
        </div>

        <!-- Action / Certificate Button -->
        <button type="button" id="export-cert-btn" class="w-full py-3 px-4 rounded-xl bg-emerald-700 hover:bg-emerald-800 text-white text-center font-bold text-xs uppercase tracking-wider transition-colors shadow-xs flex items-center justify-center gap-2 cursor-pointer">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          {d.exportAuditBtn}
        </button>
      </div>
    </div>
  </div>

  <!-- SVG Process Flow Diagram Section -->
  <section class="bg-surface-soft border border-hairline rounded-2xl p-6 sm:p-7 shadow-xs space-y-4">
    <div class="border-b border-hairline/60 pb-3">
      <h2 class="text-lg font-bold text-ink tracking-tight flex items-center gap-2">
        <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"/></svg>
        {d.diagramTitle}
      </h2>
      <p class="text-xs text-muted mt-0.5">{d.diagramSub}</p>
    </div>

    <!-- Scalable Vector Diagram -->
    <div class="w-full overflow-x-auto py-2">
      <svg class="w-full min-w-[700px] h-48 text-ink font-mono select-none" viewBox="0 0 900 240" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Background Grid -->
        <rect width="900" height="240" rx="12" fill="currentColor" fill-opacity="0.02" stroke="currentColor" stroke-opacity="0.08"/>

        <!-- Flow Lines with Arrows -->
        <path d="M 110 120 L 190 120" stroke="#10b981" stroke-width="3" stroke-dasharray="4 2"/>
        <path d="M 290 120 L 370 120" stroke="#10b981" stroke-width="3"/>
        <path d="M 470 120 L 550 120" stroke="#10b981" stroke-width="3"/>
        <path d="M 650 120 L 730 120" stroke="#10b981" stroke-width="3"/>
        <path d="M 830 120 L 870 120" stroke="#10b981" stroke-width="3"/>

        <!-- CO2 Recycle Loop (Top Arch) -->
        <path d="M 780 80 Q 780 30, 480 30 Q 240 30, 240 80" stroke="#06b6d4" stroke-width="2" stroke-dasharray="5 3" fill="none"/>
        <text x="510" y="24" fill="#06b6d4" font-size="10" font-weight="bold" text-anchor="middle">CLOSED-LOOP CO2 RECYCLE (&gt;94% RECOVERY RECOMPRESSION)</text>

        <!-- Stage 1: Liquid Feed Pump -->
        <g transform="translate(30, 80)">
          <rect width="80" height="80" rx="8" fill="#18181b" stroke="#3f3f46" stroke-width="1.5"/>
          <circle cx="40" cy="40" r="22" fill="#27272a" stroke="#10b981" stroke-width="2"/>
          <text x="40" y="38" fill="#fafafa" font-size="9" font-weight="bold" text-anchor="middle">BEVERAGE</text>
          <text x="40" y="50" fill="#10b981" font-size="8" text-anchor="middle">FEED PUMP</text>
          <text x="40" y="95" fill="#a1a1aa" font-size="9" text-anchor="middle">1–4 bar</text>
        </g>

        <!-- Stage 2: Dense-Phase CO2 High-Shear Contactor -->
        <g transform="translate(190, 80)">
          <rect width="100" height="80" rx="8" fill="#18181b" stroke="#10b981" stroke-width="1.5"/>
          <path d="M 20 20 L 80 60 M 20 60 L 80 20 M 50 15 L 50 65" stroke="#10b981" stroke-width="2"/>
          <text x="50" y="36" fill="#fafafa" font-size="9" font-weight="bold" text-anchor="middle">DENSE CO2</text>
          <text x="50" y="48" fill="#06b6d4" font-size="8" text-anchor="middle">CONTACTOR</text>
          <text x="50" y="95" fill="#a1a1aa" font-size="9" text-anchor="middle">80–150 bar</text>
        </g>

        <!-- Stage 3: Multi-Pass Micro-Tubular Holding Reactor Coil -->
        <g transform="translate(370, 80)">
          <rect width="100" height="80" rx="8" fill="#18181b" stroke="#059669" stroke-width="1.5"/>
          <path d="M 20 25 C 80 25, 80 40, 20 40 C 80 40, 80 55, 20 55" stroke="#10b981" stroke-width="2" fill="none"/>
          <text x="50" y="32" fill="#fafafa" font-size="9" font-weight="bold" text-anchor="middle">HOLDING</text>
          <text x="50" y="44" fill="#10b981" font-size="8" text-anchor="middle">COIL REACTOR</text>
          <text x="50" y="56" fill="#34d399" font-size="7" text-anchor="middle">18–32°C / 5-Log</text>
          <text x="50" y="95" fill="#a1a1aa" font-size="9" text-anchor="middle">1–15 min</text>
        </g>

        <!-- Stage 4: Decompression Expansion & Carbonation Nozzle -->
        <g transform="translate(550, 80)">
          <rect width="100" height="80" rx="8" fill="#18181b" stroke="#f59e0b" stroke-width="1.5"/>
          <polygon points="25,25 75,40 25,55" fill="#f59e0b" fill-opacity="0.2" stroke="#f59e0b" stroke-width="1.5"/>
          <text x="50" y="34" fill="#fafafa" font-size="9" font-weight="bold" text-anchor="middle">CERAMIC</text>
          <text x="50" y="46" fill="#f59e0b" font-size="8" text-anchor="middle">LETDOWN NOZZLE</text>
          <text x="50" y="95" fill="#a1a1aa" font-size="9" text-anchor="middle">&gt;10^7 bar/s</text>
        </g>

        <!-- Stage 5: Aseptic Liquid/Gas Separator & Packaging Interface -->
        <g transform="translate(730, 80)">
          <rect width="100" height="80" rx="8" fill="#18181b" stroke="#6366f1" stroke-width="1.5"/>
          <rect x="25" y="20" width="50" height="40" rx="4" fill="#312e81" stroke="#818cf8" stroke-width="1.5"/>
          <text x="50" y="36" fill="#fafafa" font-size="9" font-weight="bold" text-anchor="middle">ASEPTIC</text>
          <text x="50" y="48" fill="#a5b4fc" font-size="8" text-anchor="middle">BOTTLER</text>
          <text x="50" y="95" fill="#a1a1aa" font-size="9" text-anchor="middle">Chilled / Sterile</text>
        </g>
      </svg>
    </div>
  </section>

  <!-- Scientific Explainer & Regulatory Compliance Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <!-- Scientific Explainer -->
    <section class="bg-surface-soft border border-hairline rounded-2xl p-6 sm:p-7 shadow-xs space-y-4">
      <div class="border-b border-hairline/60 pb-3">
        <h2 class="text-base font-bold text-ink tracking-tight flex items-center gap-2">
          <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
          {d.scienceTitle}
        </h2>
        <p class="text-xs text-muted mt-0.5">{d.scienceSub}</p>
      </div>

      <div class="space-y-3 text-xs leading-relaxed text-body">
        <p>
          <strong class="text-ink">1. Intracellular Carbonic Acid Dissociation &amp; Acid Shock:</strong> Dense-phase CO2 at 80–150 bar rapidly permeates the protective peptidoglycan and outer lipopolysaccharide membranes of bacteria and spores. Inside the cytoplasm, dissolved CO2 hydrates to carbonic acid (H2CO3) and dissociates into bicarbonate (HCO3-) and free protons (H+), causing cytoplasmic pH to plunge from neutral (pH ~7.2) down below pH 3.2. This massive acidification halts proton-translocating ATPases and denatures essential metabolic enzymes.
        </p>
        <p>
          <strong class="text-ink">2. Lipophilic Membrane Solubilization &amp; Fluidity Collapse:</strong> Dense supercritical carbon dioxide behaves as a hydrophobic solvent, dissolving and extracting non-polar fatty acids, phospholipids, and sterols directly from the microbial lipid bilayer, irreversibly altering cell permeability and driving rapid osmotic collapse.
        </p>
        <p>
          <strong class="text-ink">3. Supersonic Decompression Explosive Rupture:</strong> Passing through the ceramic micro-orifice nozzle at decompression rates exceeding 10^7 bar/s, dissolved intracellular CO2 undergoes instant explosive volumetric phase expansion from dense fluid to gas, generating extreme internal micro-jet shear stresses that physically lyse bacterial cell envelopes and vegetative spores.
        </p>
      </div>
    </section>

    <!-- Regulatory Compliance Matrix -->
    <section class="bg-surface-soft border border-hairline rounded-2xl p-6 sm:p-7 shadow-xs space-y-4">
      <div class="border-b border-hairline/60 pb-3">
        <h2 class="text-base font-bold text-ink tracking-tight flex items-center gap-2">
          <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          {d.tableTitle}
        </h2>
        <p class="text-xs text-muted mt-0.5">Statutory standards governing high-pressure food contact skids.</p>
      </div>

      <div class="space-y-2.5 text-xs">
        {ltHpcdData.regulatoryStandards.map(reg => (
          <div class="p-2.5 rounded-xl bg-surface border border-hairline">
            <div class="flex items-center justify-between font-bold text-ink mb-1">
              <span>{reg.standard}</span>
              <span class="text-[10px] text-emerald-400 bg-emerald-950/60 px-2 py-0.5 rounded border border-emerald-800">COMPLIANT</span>
            </div>
            <p class="text-muted text-[11px] leading-relaxed">{reg.requirement}</p>
          </div>
        ))}
      </div>
    </section>
  </div>
</div>

<script is:inline define:vars={{ ltHpcdData }}>
  (function initLtHpcdModeler() {
    const root = document.getElementById('lt-hpcd-modeler');
    if (!root) return;

    // Element references
    const skidSelect = document.getElementById('skid-select');
    const beverageSelect = document.getElementById('beverage-select');
    const pathogenSelect = document.getElementById('pathogen-select');
    const dosingSelect = document.getElementById('dosing-select');
    const nozzleSelect = document.getElementById('nozzle-select');
    const carbonationSelect = document.getElementById('carbonation-select');

    const pressureSlider = document.getElementById('pressure-slider');
    const tempSlider = document.getElementById('temp-slider');
    const co2RatioSlider = document.getElementById('co2-ratio-slider');
    const residenceSlider = document.getElementById('residence-slider');
    const throughputSlider = document.getElementById('throughput-slider');

    const pressureVal = document.getElementById('pressure-val');
    const tempVal = document.getElementById('temp-val');
    const co2RatioVal = document.getElementById('co2-ratio-val');
    const residenceVal = document.getElementById('residence-val');
    const throughputVal = document.getElementById('throughput-val');

    const metricPathogen = document.getElementById('metric-pathogen-red');
    const metricSpore = document.getElementById('metric-spore-red');
    const metricPme = document.getElementById('metric-pme');
    const metricVitC = document.getElementById('metric-vitc');
    const metricAroma = document.getElementById('metric-aroma');
    const metricCarb = document.getElementById('metric-carb');
    const metricSec = document.getElementById('metric-sec');
    const metricSavings = document.getElementById('metric-savings');
    const metricRecycle = document.getElementById('metric-recycle');

    const barPathogen = document.getElementById('bar-pathogen');
    const barSpore = document.getElementById('bar-spore');
    const statusPill = document.getElementById('status-pill');
    const haccpCallout = document.getElementById('haccp-callout');
    const haccpTitle = document.getElementById('haccp-status-title');
    const haccpDesc = document.getElementById('haccp-status-desc');
    const exportBtn = document.getElementById('export-cert-btn');

    function calculate() {
      const pressure = parseFloat(pressureSlider.value);
      const temp = parseFloat(tempSlider.value);
      const co2Ratio = parseFloat(co2RatioSlider.value);
      const residence = parseFloat(residenceSlider.value);
      const throughput = parseFloat(throughputSlider.value);

      const skid = ltHpcdData.systemArchitectures.find(s => s.id === skidSelect.value) || ltHpcdData.systemArchitectures[0];
      const beverage = ltHpcdData.beverageMatrices.find(b => b.id === beverageSelect.value) || ltHpcdData.beverageMatrices[0];
      const pathogen = ltHpcdData.microbialPathogens.find(p => p.id === pathogenSelect.value) || ltHpcdData.microbialPathogens[0];
      const dosing = ltHpcdData.co2DosingMechanisms.find(d => d.id === dosingSelect.value) || ltHpcdData.co2DosingMechanisms[0];
      const nozzle = ltHpcdData.decompressionNozzleTypes.find(n => n.id === nozzleSelect.value) || ltHpcdData.decompressionNozzleTypes[0];
      const carbProfile = ltHpcdData.carbonationSaturationProfiles.find(c => c.id === carbonationSelect.value) || ltHpcdData.carbonationSaturationProfiles[2];

      // Update text displays
      pressureVal.textContent = pressure.toFixed(1) + ' bar';
      tempVal.textContent = temp.toFixed(1) + ' °C';
      co2RatioVal.textContent = co2Ratio.toFixed(1) + ' wt%';
      residenceVal.textContent = residence.toFixed(1) + ' min';
      throughputVal.textContent = Math.round(throughput) + ' L/h';

      // Check for bypass hazard
      const isHazard = (dosing.id === 'unbaffled_bulk_gas_headspace_hazard') || (beverage.id === 'industrial_high_sugar_syrup_contaminant_hazard');

      // 1. Pathogen Log Reduction Calculation
      let pathogenLethality = 0;
      let sporeLethality = 0;

      if (isHazard) {
        pathogenLethality = Math.min(2.1, 0.4 + (pressure / 150) * 0.8 + (residence / 10) * 0.5);
        sporeLethality = Math.min(0.9, 0.1 + (pressure / 180) * 0.4);
      } else {
        // Normal robust dense-phase kinetic model
        const pressureFactor = Math.pow(pressure / 100, 1.35);
        const timeFactor = Math.pow(residence / 5, 0.65);
        const co2Factor = Math.pow(co2Ratio / 8.5, 0.45);
        const tempFactor = 1.0 + ((temp - 20) * 0.025);
        const dosingFactor = (dosing.massTransferEfficiencyPct || 95) / 100;

        pathogenLethality = Math.min(8.5, Math.max(1.2, 4.8 * pressureFactor * timeFactor * co2Factor * tempFactor * dosingFactor));
        sporeLethality = Math.min(6.8, Math.max(0.5, 3.4 * (pressure / 120) * (residence / 6) * (co2Ratio / 8.0) * dosingFactor));
      }

      // 2. Enzyme (PME) Inactivation %
      let pmeInact = 0;
      if (isHazard) {
        pmeInact = Math.min(42.0, 15.0 + pressure * 0.15);
      } else {
        pmeInact = Math.min(99.4, Math.max(70.0, 88.0 + (pressure - 80) * 0.12 + (temp - 18) * 0.35 + (residence - 2) * 0.8));
      }

      // 3. Vitamin C & Fresh Aroma Retention %
      let vitCRetention = Math.max(82.0, Math.min(99.4, 99.0 - (temp - 18) * 0.22 - (residence - 2) * 0.15));
      let aromaRetention = Math.max(85.0, Math.min(99.6, 99.2 - (temp - 18) * 0.18));

      // 4. Finished Carbonation (Volumes & g/L)
      let finalVolumes = carbProfile.volumesCo2;
      let finalGL = carbProfile.dissolvedCo2GramsPerLiter;

      // 5. Specific Energy Consumption & Savings vs Thermal
      const baseSec = (pressure * 0.006) + (throughput * 0.0002) + 0.35;
      const secKwh = Math.max(0.65, Math.min(2.4, baseSec));
      const energySavingsPct = Math.max(65.0, Math.min(85.0, 100 - (secKwh / 6.5) * 100));
      const recyclePct = isHazard ? 24.0 : Math.min(97.5, (skid.co2RecycleEfficiencyPct || 93) * (nozzle.microEffervescenceRetentionPct ? nozzle.microEffervescenceRetentionPct / 100 : 0.95));

      // DOM Updates
      metricPathogen.textContent = pathogenLethality.toFixed(1);
      metricSpore.textContent = sporeLethality.toFixed(1);
      metricPme.textContent = pmeInact.toFixed(1) + '%';
      metricVitC.textContent = vitCRetention.toFixed(1) + '%';
      metricAroma.textContent = aromaRetention.toFixed(1) + '%';
      metricCarb.textContent = finalVolumes.toFixed(2) + ' vol (' + finalGL.toFixed(2) + ' g/L)';
      metricSec.textContent = secKwh.toFixed(2) + ' kWh/hL';
      metricSavings.textContent = energySavingsPct.toFixed(1) + '% Reduction';
      metricRecycle.textContent = recyclePct.toFixed(1) + '% Recompression';

      barPathogen.style.width = Math.min(100, (pathogenLethality / 8) * 100) + '%';
      barSpore.style.width = Math.min(100, (sporeLethality / 6.5) * 100) + '%';

      // FDA 21 CFR § 120 HACCP Verdict Status
      if (pathogenLethality >= 5.0 && !isHazard) {
        statusPill.textContent = 'HACCP PASS';
        statusPill.className = 'text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-wider bg-emerald-950 text-emerald-300 border border-emerald-800';
        haccpCallout.className = 'p-4 rounded-xl border border-emerald-800/80 bg-emerald-950/20 text-xs space-y-1.5';
        haccpTitle.textContent = 'VALIDATED 5-LOG JUICE HACCP KILL STEP';
        haccpTitle.className = 'flex items-center gap-2 font-bold text-emerald-300';
        haccpDesc.textContent = 'Meets or exceeds statutory FDA 21 CFR § 120.24 requirements. The process achieves a continuous ' + pathogenLethality.toFixed(1) + '-log reduction of pertinent bacterial pathogens with ' + sporeLethality.toFixed(1) + '-log spore destruction without thermal cooked off-flavors.';
      } else if (pathogenLethality >= 4.0 && !isHazard) {
        statusPill.textContent = 'HACCP CAUTION';
        statusPill.className = 'text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-wider bg-amber-950 text-amber-300 border border-amber-800';
        haccpCallout.className = 'p-4 rounded-xl border border-amber-800/80 bg-amber-950/20 text-xs space-y-1.5';
        haccpTitle.textContent = 'MARGINAL LETHALITY (<5.0 LOG REQUIREMENT)';
        haccpTitle.className = 'flex items-center gap-2 font-bold text-amber-300';
        haccpDesc.textContent = 'Current parameters achieve ' + pathogenLethality.toFixed(1) + '-log lethality, falling short of the mandatory FDA 5-log standard. Increase operating pressure above 110 bar or extend holding residence time.';
      } else {
        statusPill.textContent = 'CRITICAL HAZARD';
        statusPill.className = 'text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-wider bg-red-950 text-red-300 border border-red-800';
        haccpCallout.className = 'p-4 rounded-xl border border-red-900/80 bg-red-950/30 text-xs space-y-1.5';
        haccpTitle.textContent = 'CRITICAL CONTAMINATION / INSUFFICIENT KILL STEP';
        haccpTitle.className = 'flex items-center gap-2 font-bold text-red-400';
        haccpDesc.textContent = 'CRITICAL VIOLATION: Lethality (' + pathogenLethality.toFixed(1) + '-log) fails FDA 21 CFR § 120 safety regulations. Product cannot be legally released into commerce.';
      }
    }

    // Attach slider and select listeners
    [skidSelect, beverageSelect, pathogenSelect, dosingSelect, nozzleSelect, carbonationSelect].forEach(el => {
      el.addEventListener('change', calculate);
    });

    [pressureSlider, tempSlider, co2RatioSlider, residenceSlider, throughputSlider].forEach(slider => {
      slider.addEventListener('input', calculate);
    });

    // Preset buttons
    const presetBtns = root.querySelectorAll('.preset-btn');
    presetBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const type = btn.getAttribute('data-preset');
        if (type === 'cider') {
          skidSelect.value = 'commercial_continuous_lt_hpcd_pasteurizer_skid';
          beverageSelect.value = 'cold_pressed_cloudy_apple_cider';
          pathogenSelect.value = 'alicyclobacillus_acidoterrestris_spores';
          dosingSelect.value = 'multi_orifice_micro_bubble_sparger';
          nozzleSelect.value = 'variable_backpressure_ceramic_orifice_nozzle';
          carbonationSelect.value = 'still_beverage_degassed';
          pressureSlider.value = 130.0;
          tempSlider.value = 24.0;
          co2RatioSlider.value = 8.5;
          residenceSlider.value = 6.0;
          throughputSlider.value = 1500;
        } else if (type === 'orange') {
          skidSelect.value = 'high_acid_citrus_cloud_retention_skid';
          beverageSelect.value = 'fresh_squeezed_valencia_orange_juice';
          pathogenSelect.value = 'salmonella_enterica_serovars';
          dosingSelect.value = 'sulzer_smx_plus_dense_phase_contactor';
          nozzleSelect.value = 'variable_backpressure_ceramic_orifice_nozzle';
          carbonationSelect.value = 'still_beverage_degassed';
          pressureSlider.value = 140.0;
          tempSlider.value = 28.0;
          co2RatioSlider.value = 10.0;
          residenceSlider.value = 7.5;
          throughputSlider.value = 2200;
        } else if (type === 'kombucha') {
          skidSelect.value = 'craft_beverage_cold_brew_kombucha_skid';
          beverageSelect.value = 'raw_botanical_kombucha_infusion';
          pathogenSelect.value = 'saccharomyces_cerevisiae_yeast';
          dosingSelect.value = 'multi_orifice_micro_bubble_sparger';
          nozzleSelect.value = 'multi_stage_labyrinth_anti_choke_valve';
          carbonationSelect.value = 'craft_soda_kombucha_standard';
          pressureSlider.value = 85.0;
          tempSlider.value = 20.0;
          co2RatioSlider.value = 6.0;
          residenceSlider.value = 3.5;
          throughputSlider.value = 450;
        } else if (type === 'coffee') {
          skidSelect.value = 'craft_beverage_cold_brew_kombucha_skid';
          beverageSelect.value = 'cold_brew_nitrogen_coffee_beverage';
          pathogenSelect.value = 'listeria_monocytogenes';
          dosingSelect.value = 'venturi_suction_high_pressure_injector';
          nozzleSelect.value = 'coaxial_counter_current_induction_decompression';
          carbonationSelect.value = 'still_beverage_degassed';
          pressureSlider.value = 120.0;
          tempSlider.value = 22.0;
          co2RatioSlider.value = 7.5;
          residenceSlider.value = 5.0;
          throughputSlider.value = 800;
        } else if (type === 'hazard') {
          skidSelect.value = 'commercial_continuous_lt_hpcd_pasteurizer_skid';
          beverageSelect.value = 'industrial_high_sugar_syrup_contaminant_hazard';
          pathogenSelect.value = 'alicyclobacillus_acidoterrestris_spores';
          dosingSelect.value = 'unbaffled_bulk_gas_headspace_hazard';
          nozzleSelect.value = 'variable_backpressure_ceramic_orifice_nozzle';
          carbonationSelect.value = 'still_beverage_degassed';
          pressureSlider.value = 50.0;
          tempSlider.value = 38.0;
          co2RatioSlider.value = 2.0;
          residenceSlider.value = 0.8;
          throughputSlider.value = 2800;
        }
        calculate();
      });
    });

    // Certificate Export Handler
    if (exportBtn) {
      exportBtn.addEventListener('click', () => {
        const certData = {
          title: "IsItKitchenSafe - Commercial LT-HPCD Sanitary & Microbiological Validation Certificate",
          certificateId: "IIKS-LT-HPCD-" + Math.floor(100000 + Math.random() * 900000),
          issuedTimestamp: new Date().toISOString(),
          parameters: {
            pressureBar: parseFloat(pressureSlider.value),
            temperatureC: parseFloat(tempSlider.value),
            co2RatioWtPct: parseFloat(co2RatioSlider.value),
            residenceMinutes: parseFloat(residenceSlider.value),
            throughputLph: parseFloat(throughputSlider.value),
            beverageMatrix: beverageSelect.options[beverageSelect.selectedIndex].text,
            targetPathogen: pathogenSelect.options[pathogenSelect.selectedIndex].text,
            injectionMechanism: dosingSelect.options[dosingSelect.selectedIndex].text
          },
          telemetryResults: {
            pathogenReductionLog10: metricPathogen.textContent,
            sporeReductionLog10: metricSpore.textContent,
            pmeEnzymeInactivation: metricPme.textContent,
            vitaminCRetention: metricVitC.textContent,
            freshAromaRetention: metricAroma.textContent,
            dissolvedCarbonation: metricCarb.textContent,
            specificEnergyConsumption: metricSec.textContent,
            energySavingsVsThermal: metricSavings.textContent,
            co2RecoveryRecycle: metricRecycle.textContent,
            fdaHaccpComplianceVerdict: statusPill.textContent
          },
          standardsCompliance: [
            "FDA 21 CFR § 120 (Juice HACCP 5-Log Pathogen Reduction Mandate)",
            "FDA 21 CFR § 184.1240 (Direct Food Substances - Carbon Dioxide GRAS)",
            "ASME Boiler & Pressure Vessel Code (BPVC) Section VIII Div 1 & 2",
            "3-A Sanitary Standards 60-01 (Pumps) & 61-01 (In-Line Contactors)",
            "CGA G-6.2 (Beverage-Grade Carbon Dioxide Specification)",
            "EHEDG Guidelines Doc 8 & Doc 16 (Aseptic Equipment Design)"
          ]
        };

        const blob = new Blob([JSON.stringify(certData, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'lt_hpcd_haccp_validation_certificate_' + Date.now() + '.json';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      });
    }

    // Initial run
    calculate();
  })();
</script>
