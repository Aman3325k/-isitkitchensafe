        <p class="text-[11px] text-muted mt-1">{d.dampenerHelp}</p>
      </div>
    </div>

    <!-- Diagnostic & Visualization Column (7 cols) -->
    <div class="lg:col-span-7 space-y-6">
      <!-- Interactive Valve Geometry & Cavitation SVG Diagram -->
      <div class="bg-surface border border-hairline rounded-2xl p-6 shadow-xs">
        <div class="flex justify-between items-center mb-4">
          <div>
            <h2 class="text-title-sm font-bold text-ink">High-Pressure Homogenization Valve Cross-Section</h2>
            <p class="text-xs text-muted">Micro-orifice fluid jet, acoustic bubble collapse zone, and impact ring shear</p>
          </div>
          <span id="diagram-badge" class="px-2.5 py-1 rounded-full text-xs font-mono font-semibold bg-emerald-100 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300">
            Jet Velocity: 485 m/s
          </span>
        </div>

        <div class="relative bg-slate-950 rounded-xl p-4 overflow-hidden border border-slate-800 flex items-center justify-center">
          <svg viewBox="0 0 700 320" class="w-full h-auto max-h-72 select-none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="jetGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#38bdf8" />
                <stop offset="60%" stop-color="#06b6d4" />
                <stop offset="100%" stop-color="#f43f5e" />
              </linearGradient>
              <linearGradient id="cavitationGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#e11d48" stop-opacity="0.8" />
                <stop offset="100%" stop-color="#be123c" stop-opacity="0.1" />
              </linearGradient>
            </defs>

            <!-- Background Grid -->
            <pattern id="gridPattern" width="20" height="20" patternUnits="userSpaceOnUse">
              <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#1e293b" stroke-width="0.5"/>
            </pattern>
            <rect width="700" height="320" fill="url(#gridPattern)" />

            <!-- Stationary Valve Seat (Upper and Lower) -->
            <rect x="180" y="40" width="120" height="70" rx="4" fill="#334155" stroke="#64748b" stroke-width="1.5" />
            <text x="240" y="80" fill="#94a3b8" font-size="11" font-family="monospace" text-anchor="middle">VALVE SEAT</text>
            <text x="240" y="95" id="svg-seat-mat" fill="#38bdf8" font-size="9" font-family="monospace" text-anchor="middle">WC-Co (HV 1550)</text>

            <rect x="180" y="210" width="120" height="70" rx="4" fill="#334155" stroke="#64748b" stroke-width="1.5" />
            <text x="240" y="250" fill="#94a3b8" font-size="11" font-family="monospace" text-anchor="middle">VALVE SEAT</text>

            <!-- Central Inlet Channel (High Pressure Flow) -->
            <path d="M 40 130 L 180 130 L 180 190 L 40 190 Z" fill="#0f172a" stroke="#0ea5e9" stroke-width="2" />
            <path d="M 60 160 L 160 160" stroke="#38bdf8" stroke-width="3" stroke-dasharray="6,4" />
            <polygon points="160,160 150,154 150,166" fill="#38bdf8" />
            <text x="100" y="152" fill="#38bdf8" font-size="10" font-family="monospace" text-anchor="middle">HIGH-PRESSURE INLET</text>
            <text x="100" y="178" id="svg-inlet-press" fill="#f8fafc" font-size="11" font-weight="bold" font-family="monospace" text-anchor="middle">1200 bar</text>

            <!-- Adjustable Valve Cone (Moves dynamically to adjust gap) -->
            <polygon id="svg-valve-cone" points="300,160 220,122 220,198" fill="#475569" stroke="#94a3b8" stroke-width="2" />
            <text x="245" y="163" fill="#f1f5f9" font-size="9" font-weight="bold" font-family="monospace" text-anchor="middle">CONE</text>

            <!-- Micro-Orifice Gap Channels (Upper & Lower) -->
            <rect id="svg-gap-upper" x="210" y="112" width="90" height="8" fill="url(#jetGrad)" opacity="0.9" />
            <rect id="svg-gap-lower" x="210" y="200" width="90" height="8" fill="url(#jetGrad)" opacity="0.9" />

            <!-- Supersonic Radial Jet Streamlines -->
            <path d="M 300 115 L 450 60" stroke="#38bdf8" stroke-width="3" stroke-linecap="round" />
            <path d="M 300 205 L 450 260" stroke="#38bdf8" stroke-width="3" stroke-linecap="round" />

            <!-- Impact Ring (Encircling peripheral wall) -->
            <rect x="470" y="30" width="40" height="110" rx="3" fill="#1e293b" stroke="#e11d48" stroke-width="2" />
