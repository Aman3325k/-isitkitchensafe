        <input type="range" id="slider-temp" min="4" max="85" step="1" value="55" class="w-full accent-cyan-600" />
        <p class="text-[11px] text-muted mt-1">{d.tempHelp}</p>
      </div>

      <!-- Orifice Gap Slider -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <label for="slider-gap" class="text-xs font-semibold text-ink">{d.gapLabel}</label>
          <span id="val-gap" class="font-mono text-xs font-bold text-cyan-600 dark:text-cyan-400">12 μm</span>
        </div>
        <input type="range" id="slider-gap" min="2" max="35" step="1" value="12" class="w-full accent-cyan-600" />
