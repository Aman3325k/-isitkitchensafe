const d = DICTIONARY[lang] || DICTIONARY.en;
const machines = homogenizerData.homogenizerArchitectures;
const fluids = homogenizerData.fluidProductProfiles;
const valves = homogenizerData.valveMaterialConfigurations;
---

<div class="homogenizer-modeler-container max-w-7xl mx-auto px-4 py-8" data-lang={lang}>
  <!-- Header Title & Badges -->
  <div class="mb-8">
    <div class="flex items-center gap-3 mb-3">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-cyan-700 text-white">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        {d.badge}
      </span>
      <span class="text-xs text-muted font-mono">3-A Standard 04-05 &bull; ASME BPVC VIII &bull; ISO 22000 &bull; FDA 21 CFR § 113</span>
    </div>
    <h1 class="text-display-sm md:text-display-md font-bold text-ink tracking-tight mb-3">
      {d.title}
    </h1>
    <p class="text-body text-sm md:text-base leading-relaxed max-w-4xl text-muted">
      {d.subtitle}
    </p>
  </div>

  <!-- Interactive Engineering Simulator Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mb-12">
    <!-- Controls Column (5 cols) -->
    <div class="lg:col-span-5 bg-surface border border-hairline rounded-2xl p-6 shadow-xs space-y-6">
      <div class="border-b border-hairline pb-4">
        <h2 class="text-title-md font-bold text-ink mb-1">{d.controlsTitle}</h2>
        <p class="text-xs text-muted leading-relaxed">{d.controlsSub}</p>
      </div>

      <!-- Quick Engineering Presets -->
      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-muted mb-2">{d.presetsTitle}</label>
        <div class="grid grid-cols-2 gap-2 text-xs">
          <button type="button" id="btn-preset-dairy" class="p-2.5 rounded-lg border border-hairline bg-surface-soft hover:bg-cyan-50 dark:hover:bg-cyan-950/40 text-left font-medium text-ink transition-colors">
            {d.presetDairy}
          </button>
          <button type="button" id="btn-preset-nano" class="p-2.5 rounded-lg border border-hairline bg-surface-soft hover:bg-cyan-50 dark:hover:bg-cyan-950/40 text-left font-medium text-ink transition-colors">
            {d.presetNano}
          </button>
          <button type="button" id="btn-preset-spalling" class="p-2.5 rounded-lg border border-hairline bg-surface-soft hover:bg-rose-50 dark:hover:bg-rose-950/40 text-left font-medium text-ink transition-colors">
            {d.presetSpalling}
          </button>
          <button type="button" id="btn-preset-pulsation" class="p-2.5 rounded-lg border border-hairline bg-surface-soft hover:bg-amber-50 dark:hover:bg-amber-950/40 text-left font-medium text-ink transition-colors">
            {d.presetPulsation}
          </button>
        </div>
      </div>

      <!-- Architecture Selector -->
      <div>
        <label for="select-machine" class="block text-xs font-semibold text-ink mb-1">{d.machineLabel}</label>
        <select id="select-machine" class="w-full text-xs rounded-xl border border-hairline bg-canvas p-2.5 text-ink focus:outline-none focus:ring-2 focus:ring-cyan-500">
          {machines.map((m) => (
            <option value={m.id}>{m.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1">{d.machineHelp}</p>
      </div>

      <!-- Feedstock Selector -->
      <div>
        <label for="select-fluid" class="block text-xs font-semibold text-ink mb-1">{d.fluidLabel}</label>
        <select id="select-fluid" class="w-full text-xs rounded-xl border border-hairline bg-canvas p-2.5 text-ink focus:outline-none focus:ring-2 focus:ring-cyan-500">
          {fluids.map((f) => (
            <option value={f.id}>{f.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1">{d.fluidHelp}</p>
      </div>

      <!-- Valve Material Selector -->
      <div>
        <label for="select-valve" class="block text-xs font-semibold text-ink mb-1">{d.valveLabel}</label>
        <select id="select-valve" class="w-full text-xs rounded-xl border border-hairline bg-canvas p-2.5 text-ink focus:outline-none focus:ring-2 focus:ring-cyan-500">
          {valves.map((v) => (
            <option value={v.id}>{v.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1">{d.valveHelp}</p>
      </div>

      <!-- Pressure Slider -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <label for="slider-pressure" class="text-xs font-semibold text-ink">{d.pressureLabel}</label>
          <span id="val-pressure" class="font-mono text-xs font-bold text-cyan-600 dark:text-cyan-400">1200 bar</span>
        </div>
        <input type="range" id="slider-pressure" min="100" max="2500" step="25" value="1200" class="w-full accent-cyan-600" />
        <p class="text-[11px] text-muted mt-1">{d.pressureHelp}</p>
      </div>

      <!-- Flow Rate Slider -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <label for="slider-flow" class="text-xs font-semibold text-ink">{d.flowLabel}</label>
          <span id="val-flow" class="font-mono text-xs font-bold text-cyan-600 dark:text-cyan-400">6000 L/h</span>
        </div>
        <input type="range" id="slider-flow" min="50" max="15000" step="50" value="6000" class="w-full accent-cyan-600" />
