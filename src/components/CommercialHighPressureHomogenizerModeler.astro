            <!-- Acoustic Shockwaves -->
            <path d="M 440 65 A 25 25 0 0 1 465 95" stroke="#fb7185" stroke-width="2" fill="none" opacity="0.8" />
            <path d="M 440 255 A 25 25 0 0 0 465 225" stroke="#fb7185" stroke-width="2" fill="none" opacity="0.8" />

            <!-- Exit Discharge Channel -->
