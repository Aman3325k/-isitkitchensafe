          <!-- Metric 3: Shock Collapse Pressure -->
          <div class="p-3.5 rounded-xl bg-surface-soft border border-hairline">
            <span class="block text-[11px] text-muted mb-1">{d.shockPressureLabel}</span>
            <span id="tele-shock-press" class="text-title-sm font-mono font-bold text-ink">9,850 bar</span>
            <span class="block text-[10px] text-muted mt-1">0.98 GPa Acoustic Spike</span>
          </div>

          <!-- Metric 4: Viscous Temp Rise -->
          <div class="p-3.5 rounded-xl bg-surface-soft border border-hairline">
            <span class="block text-[11px] text-muted mb-1">{d.tempRiseLabel}</span>
            <span id="tele-temp-rise" class="text-title-sm font-mono font-bold text-amber-600 dark:text-amber-400">+31.2°C</span>
            <span class="block text-[10px] text-muted mt-1">ΔT = ΔP / (ρ·Cp)</span>
          </div>

          <!-- Metric 5: Exit Temp -->
          <div class="p-3.5 rounded-xl bg-surface-soft border border-hairline">
            <span class="block text-[11px] text-muted mb-1">{d.exitTempLabel}</span>
            <span id="tele-exit-temp" class="text-title-sm font-mono font-bold text-ink">86.2°C</span>
            <span id="tele-temp-status" class="block text-[10px] text-amber-500 font-medium mt-1">Requires Downstream Chiller</span>
          </div>

          <!-- Metric 6: Particle Size -->
          <div class="p-3.5 rounded-xl bg-surface-soft border border-hairline">
            <span class="block text-[11px] text-muted mb-1">{d.particleSizeLabel}</span>
            <span id="tele-particle-size" class="text-title-sm font-mono font-bold text-emerald-600 dark:text-emerald-400">0.52 μm</span>
            <span class="block text-[10px] text-muted mt-1">Stable emulsion (d90)</span>
          </div>

          <!-- Metric 7: Seat Wear Depth -->
          <div class="p-3.5 rounded-xl bg-surface-soft border border-hairline">
            <span class="block text-[11px] text-muted mb-1">{d.seatWearLabel}</span>
            <span id="tele-seat-wear" class="text-title-sm font-mono font-bold text-ink">11.4 μm</span>
            <span id="tele-wear-rating" class="block text-[10px] text-emerald-600 dark:text-emerald-400 mt-1">Within 3-A Tolerance (&lt;25 μm)</span>
          </div>

          <!-- Metric 8: Remaining Useful Life -->
          <div class="p-3.5 rounded-xl bg-surface-soft border border-hairline">
            <span class="block text-[11px] text-muted mb-1">{d.remainingLifeLabel}</span>
            <span id="tele-rul-hours" class="text-title-sm font-mono font-bold text-ink">3,050 hrs</span>
            <span class="block text-[10px] text-muted mt-1">Prior to valve re-lapping</span>
          </div>

          <!-- Metric 9: Pulsation Amplitude -->
          <div class="p-3.5 rounded-xl bg-surface-soft border border-hairline">
            <span class="block text-[11px] text-muted mb-1">{d.pulsationSurgeLabel}</span>
            <span id="tele-pulsation" class="text-title-sm font-mono font-bold text-ink">±4.2%</span>
            <span id="tele-pulse-status" class="block text-[10px] text-emerald-600 dark:text-emerald-400 mt-1">Optimal Dampener Charge</span>
          </div>
        </div>

        <!-- Overall Safety & Diagnostic Status Banner -->
        <div id="status-banner" class="p-4 rounded-xl border border-emerald-500/30 bg-emerald-50 dark:bg-emerald-950/30">
          <div class="flex items-center gap-2 mb-2">
            <span id="status-badge" class="px-2 py-0.5 rounded text-xs font-bold uppercase tracking-wider bg-emerald-600 text-white">
              OPTIMAL (3-A COMPLIANT)
            </span>
            <span class="text-xs font-semibold text-ink">{d.safetyStatusLabel}</span>
          </div>
          <div class="space-y-1.5 text-xs">
            <p><strong class="text-ink">{d.primaryRiskLabel}</strong> <span id="risk-factor" class="text-body">Super-cavitation jet erosion controlled by high-hardness WC-Co alloy.</span></p>
            <p><strong class="text-ink">{d.mechanismsLabel}</strong> <span id="risk-mech" class="text-body">Bernoulli micro-orifice depression creates vapor cavity; Rayleigh-Plesset implosion against impact ring preserves valve seating face.</span></p>
            <p><strong class="text-ink">{d.mitigationLabel}</strong> <span id="risk-mitigation" class="text-body">Maintain downstream chillers to mitigate +31.2°C viscous rise; check nitrogen pre-charge every 500 operating hours.</span></p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Scientific Reference & Architecture Comparison Table -->
  <div class="bg-surface border border-hairline rounded-2xl p-6 shadow-xs mb-12">
    <div class="mb-4">
      <h2 class="text-title-md font-bold text-ink">{d.tableTitle}</h2>
      <p class="text-xs text-muted">{d.tableSub}</p>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs border-collapse">
        <thead>
          <tr class="border-b border-hairline bg-surface-soft text-muted font-mono uppercase text-[11px]">
            <th class="py-3 px-4">{d.colModel}</th>
            <th class="py-3 px-4">{d.colClass}</th>
            <th class="py-3 px-4">{d.colPressure}</th>
            <th class="py-3 px-4">{d.colCapacity}</th>
            <th class="py-3 px-4">{d.colPlungers}</th>
            <th class="py-3 px-4">{d.colDampener}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline">
          {machines.map((m) => (
            <tr class="hover:bg-canvas transition-colors">
              <td class="py-3 px-4 font-semibold text-ink">{m.name}</td>
              <td class="py-3 px-4 text-muted">{m.classification}</td>
              <td class="py-3 px-4 font-mono font-bold text-cyan-600 dark:text-cyan-400">{m.maxPressureBar} bar</td>
              <td class="py-3 px-4 font-mono text-ink">{m.nominalCapacityLh} L/h</td>
              <td class="py-3 px-4 text-ink">{m.plungerCount} &times; Ø{m.plungerDiameterMm} mm</td>
              <td class="py-3 px-4 text-muted">{m.hydraulicPulsationDampener}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Mandatory Operational Rules & 3-A Sanitary Directives -->
  <div class="bg-surface border border-hairline rounded-2xl p-6 shadow-xs">
    <div class="mb-6">
      <h2 class="text-title-md font-bold text-ink">{d.rulesTitle}</h2>
      <p class="text-xs text-muted">{d.rulesSub}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="p-5 rounded-xl bg-surface-soft border border-hairline">
        <h3 class="text-sm font-bold text-ink mb-2">{d.rule1Title}</h3>
        <p class="text-xs text-body leading-relaxed">{d.rule1Text}</p>
      </div>

      <div class="p-5 rounded-xl bg-surface-soft border border-hairline">
        <h3 class="text-sm font-bold text-ink mb-2">{d.rule2Title}</h3>
        <p class="text-xs text-body leading-relaxed">{d.rule2Text}</p>
      </div>

      <div class="p-5 rounded-xl bg-surface-soft border border-hairline">
        <h3 class="text-sm font-bold text-ink mb-2">{d.rule3Title}</h3>
        <p class="text-xs text-body leading-relaxed">{d.rule3Text}</p>
      </div>

      <div class="p-5 rounded-xl bg-surface-soft border border-hairline">
        <h3 class="text-sm font-bold text-ink mb-2">{d.rule4Title}</h3>
        <p class="text-xs text-body leading-relaxed">{d.rule4Text}</p>
      </div>
