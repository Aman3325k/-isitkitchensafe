</div>

<script is:inline define:vars={{ homogenizerData }}>
(function() {
  const container = document.querySelector('.homogenizer-modeler-container');
  if (!container) return;

  const machines = homogenizerData.homogenizerArchitectures;
  const fluids = homogenizerData.fluidProductProfiles;
  const valves = homogenizerData.valveMaterialConfigurations;

  // DOM Elements
  const selMachine = document.getElementById('select-machine');
  const selFluid = document.getElementById('select-fluid');
  const selValve = document.getElementById('select-valve');

  const sPressure = document.getElementById('slider-pressure');
  const sFlow = document.getElementById('slider-flow');
  const sTemp = document.getElementById('slider-temp');
  const sGap = document.getElementById('slider-gap');
  const sHours = document.getElementById('slider-hours');
  const sDampener = document.getElementById('slider-dampener');

  const valPressure = document.getElementById('val-pressure');
  const valFlow = document.getElementById('val-flow');
  const valTemp = document.getElementById('val-temp');
  const valGap = document.getElementById('val-gap');
  const valHours = document.getElementById('val-hours');
  const valDampener = document.getElementById('val-dampener');

  // Telemetry outputs
  const teleVelocity = document.getElementById('tele-velocity');
  const teleCavNum = document.getElementById('tele-cav-num');
  const teleCavState = document.getElementById('tele-cav-state');
  const teleShockPress = document.getElementById('tele-shock-press');
  const teleTempRise = document.getElementById('tele-temp-rise');
  const teleExitTemp = document.getElementById('tele-exit-temp');
  const teleTempStatus = document.getElementById('tele-temp-status');
  const teleParticleSize = document.getElementById('tele-particle-size');
  const teleSeatWear = document.getElementById('tele-seat-wear');
  const teleWearRating = document.getElementById('tele-wear-rating');
  const teleRulHours = document.getElementById('tele-rul-hours');
  const telePulsation = document.getElementById('tele-pulsation');
  const telePulseStatus = document.getElementById('tele-pulse-status');

  const statusBanner = document.getElementById('status-banner');
  const statusBadge = document.getElementById('status-badge');
  const riskFactor = document.getElementById('risk-factor');
  const riskMech = document.getElementById('risk-mech');
  const riskMitigation = document.getElementById('risk-mitigation');

  // SVG Diagram elements
  const svgSeatMat = document.getElementById('svg-seat-mat');
  const svgInletPress = document.getElementById('svg-inlet-press');
  const svgExitTemp = document.getElementById('svg-exit-temp');
  const diagramBadge = document.getElementById('diagram-badge');

  // Presets
  const btnDairy = document.getElementById('btn-preset-dairy');
  const btnNano = document.getElementById('btn-preset-nano');
  const btnSpalling = document.getElementById('btn-preset-spalling');
  const btnPulsation = document.getElementById('btn-preset-pulsation');
  const btnCopy = document.getElementById('btn-copy-report');

  function calculateSimulation() {
    const machine = machines.find(m => m.id === selMachine.value) || machines[0];
    const fluid = fluids.find(f => f.id === selFluid.value) || fluids[0];
    const valve = valves.find(v => v.id === selValve.value) || valves[0];

    const P = parseFloat(sPressure.value); // bar
    const Q = parseFloat(sFlow.value); // L/h
    const T_in = parseFloat(sTemp.value); // °C
    const gap = parseFloat(sGap.value); // μm
    const hours = parseFloat(sHours.value); // hrs
    const N2_press = parseFloat(sDampener.value); // bar

    // Update Slider Labels
    valPressure.textContent = `${P.toLocaleString()} bar`;
    valFlow.textContent = `${Q.toLocaleString()} L/h`;
    valTemp.textContent = `${T_in}°C`;
    valGap.textContent = `${gap} μm`;
    valHours.textContent = `${hours.toLocaleString()} hrs`;
    valDampener.textContent = `${N2_press} bar`;

    // 1. Orifice Jet Velocity (Bernoulli Discharge with contraction coefficient Cd ~ 0.68)
    // v = Cd * sqrt(2 * ΔP * 10^5 / ρ)
    const Cd = 0.68;
    const deltaP_Pa = P * 1e5;
    const rho = fluid.densityKgM3;
    const jetVelocity = Cd * Math.sqrt((2 * deltaP_Pa) / rho); // m/s

    // 2. Cavitation Number σ = (P_downstream - P_vapor) / (0.5 * ρ * v^2)
    // Downstream backpressure typically 3-5 bar in sanitary lines
    const P_downstream_Pa = 4.0 * 1e5;
    const P_vapor_Pa = 3.5 * 1e3; // at moderate temperature ~25°C
    const dynamicPressure = 0.5 * rho * Math.pow(jetVelocity, 2);
    const sigma = Math.max(0.005, (P_downstream_Pa - P_vapor_Pa) / dynamicPressure);

    // 3. Rayleigh-Plesset Shock Collapse Peak Pressure (acoustic microjet impact ~ 1,000-1,400 m/s)
    // P_shock ≈ ρ * c_sound * v_microjet, typically 6,000 - 15,000 bar
    const c_sound = 1480; // m/s in aqueous fluid
    const v_microjet = Math.min(1600, jetVelocity * 2.2);
    const shockPressureBar = (rho * c_sound * v_microjet * 0.45) / 1e5; // bar

    // 4. Adiabatic Viscous Dissipation Temp Rise
    // ΔT = (ΔP_Pa) / (ρ * Cp) * (1 - η_work), where pumping work ~ 0.98 converted to heat
    const Cp = fluid.specificHeatJouleKgK;
    const deltaT = (deltaP_Pa / (rho * Cp)) * 0.98;
    const T_exit = T_in + deltaT;

    // 5. Target Particle / Fat Globule Size Reduction (d90)
    // d90 = d_initial * (P_ref / P)^0.65 * (1 + wear_factor)
    const P_ref = 300; // bar
    const wearFactor = (hours / valve.expectedServiceLifeHours) * 0.25;
    const particleRatio = Math.pow(P_ref / Math.max(100, P), 0.65);
    const d90 = Math.max(0.08, fluid.initialParticleSizeMicrons * particleRatio * (1 + wearFactor));

    // 6. Cumulative Valve Seat Wear & Spalling Rate
    // Archard wear: depth ∝ (P^1.2 * fluid.abrasiveness * hours) / (valve.vickersHardnessHv^1.4)
    const wearCoeff = 0.00015;
    const wearDepthMicrons = wearCoeff * (Math.pow(P, 1.25) * fluid.abrasivenessIndex * hours) / Math.pow(valve.vickersHardnessHv, 1.35);
    const maxWearTolerance = 25.0; // 3-A Sanitary standard limit (25 μm)
    const wearFraction = Math.min(1.5, wearDepthMicrons / maxWearTolerance);
    const remainingHours = Math.max(0, Math.round(valve.expectedServiceLifeHours * (1 - wearFraction)));

    // 7. Hydraulic Pulsation Dampener Surge Amplitude
    // Ideal pre-charge is 0.60 to 0.70 of P. Deviation leads to surge amplitude escalation
    const targetN2 = P * 0.65;
    const n2Ratio = N2_press / Math.max(1, targetN2);
    let pulseAmplitudePercent = 4.0;
    if (n2Ratio < 0.3) {
      pulseAmplitudePercent = 26.5; // severe water hammer
    } else if (n2Ratio < 0.6) {
      pulseAmplitudePercent = 14.2;
    } else if (n2Ratio > 1.3) {
      pulseAmplitudePercent = 12.0;
    } else {
      pulseAmplitudePercent = 3.5 + Math.abs(1 - n2Ratio) * 5.0;
    }

    // Update Telemetry Displays
    teleVelocity.textContent = `${Math.round(jetVelocity)} m/s`;
    teleCavNum.textContent = sigma.toFixed(3);
    if (sigma < 0.05) {
      teleCavState.textContent = 'Intense Super-Cavitation Cloud';
      teleCavState.className = 'block text-[10px] text-rose-500 font-medium mt-1';
    } else if (sigma < 0.12) {
      teleCavState.textContent = 'Moderate Acoustic Cavitation';
      teleCavState.className = 'block text-[10px] text-amber-500 font-medium mt-1';
    } else {
      teleCavState.textContent = 'Incipient Shear Cavitation';
      teleCavState.className = 'block text-[10px] text-emerald-600 dark:text-emerald-400 mt-1';
    }

    teleShockPress.textContent = `${Math.round(shockPressureBar).toLocaleString()} bar`;
    teleTempRise.textContent = `+${deltaT.toFixed(1)}°C`;
    teleExitTemp.textContent = `${T_exit.toFixed(1)}°C`;
    if (T_exit > 80.0) {
      teleTempStatus.textContent = 'Denaturation Risk - Immediate Plate Chiller Required';
      teleTempStatus.className = 'block text-[10px] text-rose-500 font-medium mt-1';
    } else if (T_exit > 68.0) {
      teleTempStatus.textContent = 'Moderate Heat Accumulation - Chiller Advised';
      teleTempStatus.className = 'block text-[10px] text-amber-500 font-medium mt-1';
    } else {
      teleTempStatus.textContent = 'Acceptable Thermal Window';
      teleTempStatus.className = 'block text-[10px] text-emerald-600 dark:text-emerald-400 mt-1';
    }

    teleParticleSize.textContent = d90 < 1.0 ? `${Math.round(d90 * 1000)} nm` : `${d90.toFixed(2)} μm`;
    teleSeatWear.textContent = `${wearDepthMicrons.toFixed(1)} μm`;
    if (wearDepthMicrons > maxWearTolerance) {
      teleWearRating.textContent = 'Exceeds 3-A Tolerance (>25 μm) - Biofilm Risk!';
      teleWearRating.className = 'block text-[10px] text-rose-500 font-bold mt-1';
    } else if (wearDepthMicrons > 18.0) {
      teleWearRating.textContent = 'Approaching Re-Lapping Limit';
      teleWearRating.className = 'block text-[10px] text-amber-500 font-medium mt-1';
    } else {
      teleWearRating.textContent = 'Optimal 3-A Sanitary Finish (Ra ≤ 0.8 μm)';
      teleWearRating.className = 'block text-[10px] text-emerald-600 dark:text-emerald-400 mt-1';
    }

    teleRulHours.textContent = `${remainingHours.toLocaleString()} hrs`;
    telePulsation.textContent = `±${pulseAmplitudePercent.toFixed(1)}%`;
    if (pulseAmplitudePercent > 20.0) {
      telePulseStatus.textContent = 'Critical Water Hammer - Bladder Depressurized!';
      telePulseStatus.className = 'block text-[10px] text-rose-500 font-bold mt-1';
    } else if (pulseAmplitudePercent > 10.0) {
      telePulseStatus.textContent = 'Elevated Hydraulic Pulsation - Check N2';
      telePulseStatus.className = 'block text-[10px] text-amber-500 font-medium mt-1';
    } else {
      telePulseStatus.textContent = 'Optimal Pulsation Dampening (<±5%)';
      telePulseStatus.className = 'block text-[10px] text-emerald-600 dark:text-emerald-400 mt-1';
    }

    // Update SVG Diagram
    svgSeatMat.textContent = `${valve.name.split('(')[0].trim()}`;
    svgInletPress.textContent = `${P.toLocaleString()} bar`;
    svgExitTemp.textContent = `T_exit: ${T_exit.toFixed(1)}°C`;
    diagramBadge.textContent = `Jet Velocity: ${Math.round(jetVelocity)} m/s`;

    // Multi-factor Safety Evaluation
    let isSevere = false;
    let isWarning = false;
    let riskTitle = '';
    let riskDetail = '';
    let mitigation = '';

    if (pulseAmplitudePercent > 20.0) {
      isSevere = true;
      riskTitle = 'Catastrophic Hydraulic Pulsation & Water Hammer Fatigue';
      riskDetail = `Nitrogen pre-charge (${N2_press} bar) is severely depleted compared to optimal charge (${Math.round(targetN2)} bar). Cyclic pressure spikes (±${pulseAmplitudePercent.toFixed(1)}%) induce severe fatigue stresses in manifold forging and high-pressure plunger seals.`;
      mitigation = 'Immediately recharge accumulator nitrogen bladder to 65% of operating pressure per ASME Section VIII. Inspect plunger chevron seals for extrusion damage.';
    } else if (wearDepthMicrons > maxWearTolerance) {
      isSevere = true;
      riskTitle = '3-A Sanitary Standard Breach & Biofilm Harboring Pitting';
      riskDetail = `Cumulative valve seat cavitation pitting has reached ${wearDepthMicrons.toFixed(1)} μm (exceeding 25 μm ceiling). Pitted surface channels harbor heat-resistant spores and ruin particle size distribution (d90: ${d90.toFixed(2)} μm).`;
      mitigation = 'Remove homogenization valve and seat assembly for diamond micro-lapping or replace with new sintered WC-Co / Si3N4 ceramic components immediately.';
    } else if (T_exit > 78.0) {
      isWarning = true;
      riskTitle = 'Viscous Dissipation Thermal Denaturation & Scorching';
      riskDetail = `Adiabatic viscous dissipation has raised fluid temperature by +${deltaT.toFixed(1)}°C to ${T_exit.toFixed(1)}°C. High exit temperature threatens thermal degradation of sensitive proteins, polyphenols, and flavor esters.`;
      mitigation = 'Integrate closed-loop chilled glycol heat exchanger immediately downstream of the homogenization stage to rapidly quench discharge below 10°C.';
    } else if (valve.id === 'hardened_martensitic_stainless_steel' && P > 1000) {
      isWarning = true;
      riskTitle = 'High-Risk Metallurgy: Stainless Steel Under Ultrasonic Cavitation';
      riskDetail = `Martensitic stainless steel (HV 450) exhibits low fatigue resistance against sonic microjet collapse pressures (${Math.round(shockPressureBar).toLocaleString()} bar). Accelerated groove erosion is imminent.`;
      mitigation = 'Upgrade homogenization valve seat to micro-grain sintered tungsten carbide (WC-Co 6%) or monolithic silicon nitride ceramic.';
    } else {
      riskTitle = 'Normal Operation - 3-A Sanitary & ASME Compliant';
      riskDetail = `Supersonic jet velocity (${Math.round(jetVelocity)} m/s) and acoustic cavitation energy successfully disperse emulsion down to ${d90 < 1.0 ? Math.round(d90 * 1000) + ' nm' : d90.toFixed(2) + ' μm'} with safe wear rates.`;
      mitigation = 'Continue routine preventive maintenance: verify nitrogen bladder charge monthly and inspect seat finish every 500 operating hours.';
    }

    if (isSevere) {
      statusBanner.className = 'p-4 rounded-xl border border-rose-500/40 bg-rose-50 dark:bg-rose-950/40';
      statusBadge.className = 'px-2 py-0.5 rounded text-xs font-bold uppercase tracking-wider bg-rose-600 text-white';
      statusBadge.textContent = 'CRITICAL ALARM';
    } else if (isWarning) {
      statusBanner.className = 'p-4 rounded-xl border border-amber-500/40 bg-amber-50 dark:bg-amber-950/40';
      statusBadge.className = 'px-2 py-0.5 rounded text-xs font-bold uppercase tracking-wider bg-amber-600 text-white';
      statusBadge.textContent = 'OPERATIONAL WARNING';
    } else {
      statusBanner.className = 'p-4 rounded-xl border border-emerald-500/30 bg-emerald-50 dark:bg-emerald-950/30';
      statusBadge.className = 'px-2 py-0.5 rounded text-xs font-bold uppercase tracking-wider bg-emerald-600 text-white';
      statusBadge.textContent = 'OPTIMAL (3-A COMPLIANT)';
    }

    riskFactor.textContent = riskTitle;
    riskMech.textContent = riskDetail;
    riskMitigation.textContent = mitigation;
  }

  // Presets Handlers
  if (btnDairy) {
    btnDairy.addEventListener('click', () => {
      selMachine.value = 'industrial_two_stage_dairy_homogenizer';
      selFluid.value = 'whole_bovine_dairy_milk';
      selValve.value = 'sintered_tungsten_carbide_wc_co';
      sPressure.value = '1200';
      sFlow.value = '12000';
      sTemp.value = '65';
      sGap.value = '14';
      sHours.value = '400';
      sDampener.value = '75';
      calculateSimulation();
    });
  }

  if (btnNano) {
    btnNano.addEventListener('click', () => {
      selMachine.value = 'ultra_high_pressure_sanitary_homogenizer';
      selFluid.value = 'pharmaceutical_nanoemulsion_lipid_carrier';
      selValve.value = 'monolithic_ceramic_silicon_nitride';
      sPressure.value = '2200';
      sFlow.value = '4500';
      sTemp.value = '15';
      sGap.value = '6';
      sHours.value = '150';
      sDampener.value = '110';
      calculateSimulation();
    });
  }

  if (btnSpalling) {
    btnSpalling.addEventListener('click', () => {
      selMachine.value = 'aging_degraded_homogenizer_high_pulsation';
      selFluid.value = 'plant_based_oat_almond_dairy_alt';
      selValve.value = 'hardened_martensitic_stainless_steel';
      sPressure.value = '1800';
      sFlow.value = '8000';
      sTemp.value = '55';
      sGap.value = '10';
      sHours.value = '2600';
      sDampener.value = '70';
      calculateSimulation();
    });
  }

  if (btnPulsation) {
    btnPulsation.addEventListener('click', () => {
      selMachine.value = 'aging_degraded_homogenizer_high_pulsation';
      selFluid.value = 'whole_bovine_dairy_milk';
      selValve.value = 'cobalt_chromium_stellite_alloy';
      sPressure.value = '800';
      sFlow.value = '7500';
      sTemp.value = '50';
      sGap.value = '16';
      sHours.value = '1200';
      sDampener.value = '10'; // depleted
      calculateSimulation();
    });
  }

  // Copy Telemetry Report
  if (btnCopy) {
    btnCopy.addEventListener('click', () => {
      const report = `=== HIGH-PRESSURE HOMOGENIZER TELEMETRY REPORT ===
Machine: ${selMachine.options[selMachine.selectedIndex].text}
Fluid: ${selFluid.options[selFluid.selectedIndex].text}
Valve Metallurgy: ${selValve.options[selValve.selectedIndex].text}
Operating Pressure: ${sPressure.value} bar
Flow Rate: ${sFlow.value} L/h
Inlet Temp: ${sTemp.value}°C -> Exit Temp: ${teleExitTemp.textContent} (ΔT: ${teleTempRise.textContent})
Micro-Orifice Jet Velocity: ${teleVelocity.textContent}
Cavitation Index (σ): ${teleCavNum.textContent} (${teleCavState.textContent})
Peak Acoustic Shock Pressure: ${teleShockPress.textContent}
Particle Size (d90): ${teleParticleSize.textContent}
Seat Wear Depth: ${teleSeatWear.textContent} | Remaining Life: ${teleRulHours.textContent}
Hydraulic Pulsation: ${telePulsation.textContent}
Compliance: ${statusBadge.textContent} - ${riskFactor.textContent}
Mitigation: ${riskMitigation.textContent}
Standard: 3-A Sanitary Standard 04-05 & ASME BPVC Section VIII`;

      navigator.clipboard.writeText(report).then(() => {
        const originalText = btnCopy.textContent;
        btnCopy.textContent = 'Report Copied!';
        btnCopy.classList.add('bg-emerald-600', 'text-white');
        setTimeout(() => {
          btnCopy.textContent = originalText;
          btnCopy.classList.remove('bg-emerald-600', 'text-white');
        }, 2000);
      });
    });
  }

  // Listeners
  [selMachine, selFluid, selValve].forEach(el => el && el.addEventListener('change', calculateSimulation));
  [sPressure, sFlow, sTemp, sGap, sHours, sDampener].forEach(el => el && el.addEventListener('input', calculateSimulation));

  // Initial Run
  calculateSimulation();
})();
</script>
