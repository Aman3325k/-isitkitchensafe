    rule2Text: "裸露80/20镍铬丝在热胀冷缩和设备机械震动下极易发生氧化皮微观碎裂，剥落的三氧化二铬晶片会直接落入下方烘烤的面包上。铠装Calrod管彻底杜绝了重金属微粒接触。",
    rule3Title: "3. 针对高糖面包（布里欧修/汉堡胚）精确校准履带转速",
    rule3Text: "含糖量超过8%的面包美拉德反应速度呈几何级加快。在表面超过180°C时，丙烯酰胺生成量可突破1,200 µg/kg（欧盟基准的三倍以上）。务必调快转速，烘烤至金黄色而非深焦褐色。",
    rule4Title: "4. 履带多士炉必须布置在Type II专用排热排烟罩下方",
    rule4Text: "多士炉连续工作产生强烈热气羽流、气溶胶面粉尘、牛油气化烟气及微量金属氧化物颗粒。专用排烟罩可抽除90%以上的空气悬浮物，保护员工呼吸健康。",
    copyReportBtn: "复制诊断遥测数据报告",
    copiedFeedback: "诊断遥测报告已复制至剪贴板！"
  },
  ja: {
    badge: "熱物理学＆産業毒性学シミュレーター",
    title: "業務用コンベアトースター ニクロム線Cr(VI)剥離＆表面アクリルアミド生成モデラー",
    subtitle: "280°C〜340°Cの急速放射伝熱下における連続コンベアトースターのメイラード反応、発がん性アクリルアミド蓄積、ニクロム線酸化被膜の微小剥離、パンくずトレイ熱分解煙を精密モデル化。",
    controlsTitle: "コンベアトースター熱物理＆運用パラメータ設定",
    controlsSub: "ヒーター冶金材質、ベルト搬送速度・照射時間、パン基質の還元糖/アスパラギン含有量、パンくず受け皿清掃状態、排気フード環境を設定します。",
    elementLabel: "加熱エレメント技術と冶金材質：",
    elementHelp: "露出型ニクロム線（NiCr 80/20）コイル vs 金属シースIncoloy Calrod管 vs 石英ハロゲン赤外線管 vs FeCrAl Kanthal。",
    speedLabel: "コンベア搬送速度と放射熱曝露時間：",
    speedHelp: "バンズ15秒高速パス vs 30秒標準トースト vs 60秒ベーグル深焼き vs 120秒コンベア停止・詰まり事故。",
    breadLabel: "パン基質と還元糖／遊離アスパラギン含有率：",
    breadHelp: "高糖度ブリオッシュ（糖分11.5%） vs 標準食パン vs 自家製天然酵母サワードウ（pH 4.4） vs グルテンフリー米粉パン。",
    trayLabel: "パンくず受け皿の衛生清掃＆熱蓄積状態：",
    trayHelp: "1時間毎の清掃（パンくず<5g） vs 8時間シフト連続堆積（~180g） vs 数日間放置された炭化層（>500g・発煙）。",
    ventLabel: "業務用排気設備とフード換気：",
    ventHelp: "専用Type II業務用排気フード（350+ CFM） vs ビュッフェカウンター自然室内対流。",
    hoursLabel: "1日の連続稼働時間（時間/日）：",
    hoursHelp: "連続稼働時間はヒーター金属の熱疲労蓄積およびパンくずトレイの熱浸透温度を決定します。",
    presetsTitle: "実際の外食現場における実証プリセット：",
    presetDinerRush: "ファストフード・ダイナーピーク（ブリオッシュ + 露出ニクロム線 + 8時間パンくず堆積）",
    presetHotelBuffet: "ホテル朝食ビュッフェ（食パン + 石英赤外線管 + 室内自然対流）",
    presetCertifiedClean: "クリーン標準仕様（サワードウ + シース管Calrod + 1時間毎清掃 + 専用排気フード）",
    presetConveyorJam: "コンベア詰まり・重大滞留事故（露出ニクロム線 + 120秒加熱 + 炭化発煙パンくず）",
    diagnosticTitle: "熱放射＆表面化学リアルタイム診断カード",
    diagnosticSub: "トースト表面ピーク温度、アクリルアミド推定濃度、六価クロム酸化物剥離リスク、パンくず熱分解指数をリアルタイム定量化。",
    crustTempLabel: "クラスト表面ピーク放射温度",
    acrylamideLabel: "推定表面アクリルアミド濃度",
    cr6RiskLabel: "六価クロム＆金属酸化物微粒子剥離",
    pyrolysisLabel: "パンくずトレイ熱分解＆発煙指数",
    complianceLabel: "EU基準値＆NSF/ANSI 4適合状況",
    mechanismLabel: "生物物理反応速度論＆熱伝達メカニズム",
    guidanceLabel: "外食厨房是正措置＆安全エンジニアリング指針",
    scienceTitle: "放射物理学、アクリルアミド生成速度論、高温ニクロム線冶金学",
    scienceSub: "高密度赤外線放射フラックスが表面メイラード反応を極大化させ、高温酸化被膜がパン上に剥離落下するメカニズムを解明。",
    tableTitle: "業務用トースター発熱エレメント工学比較マトリクス",
    tableSub: "業務用食品放射加熱技術の物理的・毒性学的特性の包括的比較。",
    colTech: "エレメント技術",
    colEmitterTemp: "発熱体温度 (°C)",
    colRadiantFlux: "放射熱流束 (kW/m²)",
    colSpallation: "酸化皮膜微小剥離率",
    colCr6Hazard: "六価クロム揮発リスク",
    colNsfRating: "食品衛生＆NSF評価",
    rulesTitle: "業務用コンベアトースター4大必須衛生・防火安全規則",
    rulesSub: "商業施設およびホテル・レストラン厨房における食品安全と火災予防の基本規範。",
    rule1Title: "1. パンくず受け皿は2〜4時間毎に排出し脱脂清掃すること",
    rule1Text: "下部ヒーター直下の堆積パンくずは220°C〜295°Cに達し、燻焼熱分解により細胞毒性アクロレインや多環芳香族炭化水素（PAH、ベンゾ[a]ピレン）を放出し、重大な火災リスク（NFPA 96違反）となります。",
    rule2Title: "2. 露出型ニクロム線から金属シース管（Calrod）または石英管へ移行すること",
    rule2Text: "開放型80/20ニクロム線は熱膨張と振動により微細な酸化クロム（Cr2O3）フレークを直下の食品へ脱落させます。シース管構造により金属微粒子の混入を完全に防止できます。",
    rule3Title: "3. 高糖度パン（ブリオッシュ・ミルクパン）は搬送速度を高速化すること",
    rule3Text: "糖分8%以上のパンはメイラード反応が急激に進行します。表面温度が180°Cを超えるとアクリルアミドは1,200 µg/kg（EU基準の3倍以上）に達します。明るい黄金色で焼き上がるよう速度を校正してください。",
    rule4Title: "4. コンベアトースターはType II排気フードの真下に配置すること",
    rule4Text: "連続稼働するトースターは大量の熱プルーム、油脂蒸気、超微小金属粒子を発生させます。専用排気フード下で運用することで浮遊粒子の90%以上を捕集・排出できます。",
    copyReportBtn: "診断テレメトリレポートをコピー",
    copiedFeedback: "診断テレメトリをクリップボードにコピーしました！"
  }
};

const d = DICTIONARY[lang] || DICTIONARY.en;
---

<div class="bg-surface-card border border-hairline rounded-3xl p-6 md:p-10 shadow-sm mb-12" id="conveyor-modeler-app">
  <!-- Top Badge & Header -->
  <div class="flex flex-wrap items-center justify-between gap-4 border-b border-hairline/80 pb-6 mb-8">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-orange-500/10 text-orange-700 dark:text-orange-400 mb-2 border border-orange-500/20">
        <span>🍞</span>
        {d.badge}
      </div>
      <h2 class="text-2xl md:text-3xl font-extrabold text-ink tracking-tight">
        {d.title}
      </h2>
      <p class="text-sm md:text-base text-muted max-w-3xl mt-1">
        {d.subtitle}
      </p>
    </div>
    
    <button
      id="copy-report-btn"
      type="button"
      class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-surface-soft hover:bg-surface-subtle text-ink font-semibold text-xs tracking-wide transition-all border border-hairline shadow-xs hover:border-accent active:scale-95 cursor-pointer"
    >
      <svg class="w-4 h-4 text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
      </svg>
      <span id="copy-btn-text">{d.copyReportBtn}</span>
    </button>
  </div>

  <!-- Presets Bar -->
  <div class="mb-8 p-4 md:p-5 bg-surface-soft rounded-2xl border border-hairline">
    <div class="text-xs font-bold uppercase tracking-wider text-muted mb-3 flex items-center gap-2">
      <svg class="w-4 h-4 text-orange-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
      </svg>
      {d.presetsTitle}
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5">
      <button
        type="button"
        data-preset="diner-rush"
        class="preset-btn text-left p-3 rounded-xl bg-surface-card hover:bg-orange-500/10 border border-hairline hover:border-orange-500/30 transition-all text-xs font-medium text-ink group cursor-pointer"
      >
        <span class="block text-orange-700 dark:text-orange-400 font-bold mb-0.5">⚡ Rush Hour</span>
        <span class="text-muted group-hover:text-ink">{d.presetDinerRush}</span>
      </button>
      <button
        type="button"
        data-preset="hotel-buffet"
        class="preset-btn text-left p-3 rounded-xl bg-surface-card hover:bg-amber-500/10 border border-hairline hover:border-amber-500/30 transition-all text-xs font-medium text-ink group cursor-pointer"
      >
        <span class="block text-amber-700 dark:text-amber-400 font-bold mb-0.5">🏨 Hotel Buffet</span>
        <span class="text-muted group-hover:text-ink">{d.presetHotelBuffet}</span>
      </button>
      <button
        type="button"
        data-preset="certified-clean"
        class="preset-btn text-left p-3 rounded-xl bg-surface-card hover:bg-emerald-500/10 border border-hairline hover:border-emerald-500/30 transition-all text-xs font-medium text-ink group cursor-pointer"
      >
        <span class="block text-emerald-700 dark:text-emerald-400 font-bold mb-0.5">🌿 Certified Clean</span>
        <span class="text-muted group-hover:text-ink">{d.presetCertifiedClean}</span>
      </button>
      <button
        type="button"
        data-preset="conveyor-jam"
        class="preset-btn text-left p-3 rounded-xl bg-surface-card hover:bg-rose-500/10 border border-hairline hover:border-rose-500/30 transition-all text-xs font-medium text-ink group cursor-pointer"
      >
        <span class="block text-rose-700 dark:text-rose-400 font-bold mb-0.5">🚨 Stalled Jam</span>
        <span class="text-muted group-hover:text-ink">{d.presetConveyorJam}</span>
      </button>
    </div>
  </div>

  <!-- Main Grid: Controls + Live Diagnostic Card -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-12">
    <!-- Controls Column (7 cols) -->
    <div class="lg:col-span-7 space-y-6">
      <div class="border-b border-hairline/60 pb-3">
        <h3 class="text-lg font-bold text-ink">{d.controlsTitle}</h3>
        <p class="text-xs text-muted">{d.controlsSub}</p>
      </div>

      <!-- 1. Heating Element -->
      <div class="space-y-2">
        <label for="element-select" class="block text-xs font-bold uppercase tracking-wider text-ink">
          {d.elementLabel}
        </label>
        <select
          id="element-select"
          class="w-full px-3.5 py-2.5 rounded-xl bg-surface-soft border border-hairline text-ink text-sm font-medium focus:ring-2 focus:ring-orange-500/20 focus:border-orange-500 transition-colors"
        >
          {toasterData.heatingElements.map(el => (
            <option value={el.id} selected={el.id === 'bare_nichrome'}>
              {el.name} ({el.emitterTempC}°C &bull; {el.radiantFluxKwM2} kW/m²)
            </option>
          ))}
        </select>
        <p class="text-xs text-muted leading-relaxed" id="element-desc-text">
          {d.elementHelp}
        </p>
      </div>

      <!-- 2. Conveyor Belt Transit Velocity -->
      <div class="space-y-2">
        <label for="speed-select" class="block text-xs font-bold uppercase tracking-wider text-ink">
          {d.speedLabel}
        </label>
        <select
          id="speed-select"
          class="w-full px-3.5 py-2.5 rounded-xl bg-surface-soft border border-hairline text-ink text-sm font-medium focus:ring-2 focus:ring-orange-500/20 focus:border-orange-500 transition-colors"
        >
          {toasterData.conveyorSpeeds.map(sp => (
            <option value={sp.id} selected={sp.id === 'standard_30s'}>
              {sp.name} &mdash; {sp.typicalUse}
            </option>
          ))}
        </select>
        <p class="text-xs text-muted leading-relaxed">{d.speedHelp}</p>
      </div>

      <!-- 3. Bread Matrix -->
      <div class="space-y-2">
        <label for="bread-select" class="block text-xs font-bold uppercase tracking-wider text-ink">
          {d.breadLabel}
        </label>
        <select
          id="bread-select"
          class="w-full px-3.5 py-2.5 rounded-xl bg-surface-soft border border-hairline text-ink text-sm font-medium focus:ring-2 focus:ring-orange-500/20 focus:border-orange-500 transition-colors"
        >
          {toasterData.breadMatrices.map(bm => (
            <option value={bm.id} selected={bm.id === 'white_bread'}>
              {bm.name} ({bm.sugarContentPercent}% sugar &bull; {bm.freeAsparagineMgKg} mg/kg asparagine)
            </option>
          ))}
        </select>
        <p class="text-xs text-muted leading-relaxed">{d.breadHelp}</p>
      </div>

      <!-- 4. Crumb Collection Tray State -->
      <div class="space-y-2">
        <label for="tray-select" class="block text-xs font-bold uppercase tracking-wider text-ink">
          {d.trayLabel}
        </label>
        <select
          id="tray-select"
          class="w-full px-3.5 py-2.5 rounded-xl bg-surface-soft border border-hairline text-ink text-sm font-medium focus:ring-2 focus:ring-orange-500/20 focus:border-orange-500 transition-colors"
        >
          {toasterData.crumbTrayStates.map(ct => (
            <option value={ct.id} selected={ct.id === 'shift_buildup'}>
              {ct.name} &bull; Tray Temp: ~{ct.trayTempC}°C
            </option>
          ))}
        </select>
        <p class="text-xs text-muted leading-relaxed">{d.trayHelp}</p>
      </div>

      <!-- 5. Commercial Ventilation Exhaust -->
      <div class="space-y-2">
        <label for="vent-select" class="block text-xs font-bold uppercase tracking-wider text-ink">
          {d.ventLabel}
        </label>
        <select
          id="vent-select"
          class="w-full px-3.5 py-2.5 rounded-xl bg-surface-soft border border-hairline text-ink text-sm font-medium focus:ring-2 focus:ring-orange-500/20 focus:border-orange-500 transition-colors"
        >
          {toasterData.ventilationStates.map(vs => (
            <option value={vs.id} selected={vs.id === 'countertop_ambient'}>
              {vs.name}
            </option>
          ))}
        </select>
        <p class="text-xs text-muted leading-relaxed">{d.ventHelp}</p>
      </div>

      <!-- 6. Daily Operating Hours Slider -->
      <div class="space-y-2 pt-2">
        <div class="flex justify-between items-center text-xs">
          <label for="hours-slider" class="font-bold uppercase tracking-wider text-ink">
            {d.hoursLabel}
          </label>
          <span id="hours-display" class="font-mono font-bold text-orange-600 bg-orange-50 dark:bg-orange-950/40 px-2.5 py-0.5 rounded-lg border border-orange-200 dark:border-orange-900">
            8 Hours / Day
          </span>
        </div>
        <input
          type="range"
          id="hours-slider"
          min="1"
          max="18"
          step="1"
          value="8"
          class="w-full h-2 bg-surface-soft rounded-lg appearance-none cursor-pointer accent-orange-600"
        />
        <p class="text-xs text-muted leading-relaxed">{d.hoursHelp}</p>
      </div>
    </div>

    <!-- Live Telemetry / Diagnostic Card Column (5 cols) -->
    <div class="lg:col-span-5">
      <div class="sticky top-6 bg-surface-soft border border-hairline rounded-2xl p-6 shadow-sm space-y-5">
        <div class="border-b border-hairline/80 pb-4">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono uppercase tracking-wider text-muted">Telemetry v2.0</span>
            <span id="overall-badge" class="px-2.5 py-0.5 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-500/10 text-amber-700 border border-amber-500/20">
              ELEVATED RISK
            </span>
          </div>
          <h4 class="text-lg font-bold text-ink mt-1">{d.diagnosticTitle}</h4>
          <p class="text-xs text-muted">{d.diagnosticSub}</p>
        </div>

        <!-- Metric 1: Crust Surface Temperature -->
        <div class="p-4 rounded-xl bg-surface-card border border-hairline">
          <div class="flex items-center justify-between text-xs mb-1">
            <span class="text-muted font-medium">{d.crustTempLabel}</span>
            <span id="crust-temp-val" class="font-mono font-bold text-ink text-base">182°C</span>
          </div>
          <div class="w-full bg-surface-soft rounded-full h-2 overflow-hidden mt-2">
            <div id="crust-temp-bar" class="bg-amber-500 h-2 rounded-full transition-all duration-300" style="width: 58%"></div>
          </div>
          <span id="crust-temp-sub" class="text-[11px] text-muted mt-1.5 block">Maillard threshold: 140°C &bull; Charring onset: 205°C</span>
        </div>

        <!-- Metric 2: Acrylamide Concentration -->
        <div class="p-4 rounded-xl bg-surface-card border border-hairline">
          <div class="flex items-center justify-between text-xs mb-1">
            <span class="text-muted font-medium">{d.acrylamideLabel}</span>
            <span id="acrylamide-val" class="font-mono font-bold text-amber-600 text-base">520 µg/kg</span>
          </div>
          <div class="w-full bg-surface-soft rounded-full h-2 overflow-hidden mt-2">
            <div id="acrylamide-bar" class="bg-amber-500 h-2 rounded-full transition-all duration-300" style="width: 65%"></div>
          </div>
          <span id="acrylamide-sub" class="text-[11px] text-muted mt-1.5 block">EU Regulation 2017/2158 Benchmark: 400 µg/kg</span>
        </div>

        <!-- Metric 3: Hexavalent Chromium & Metal Spallation -->
        <div class="p-4 rounded-xl bg-surface-card border border-hairline">
          <div class="flex items-center justify-between text-xs mb-1">
            <span class="text-muted font-medium">{d.cr6RiskLabel}</span>
            <span id="cr6-val" class="font-mono font-bold text-rose-600 text-sm">HIGH SPALLATION</span>
          </div>
          <span id="cr6-sub" class="text-[11px] text-muted mt-1 block">NiCr 80/20 oxide micro-flake shedding into bread conveyor chute</span>
        </div>

        <!-- Metric 4: Crumb Pyrolysis Index -->
        <div class="p-4 rounded-xl bg-surface-card border border-hairline">
          <div class="flex items-center justify-between text-xs mb-1">
            <span class="text-muted font-medium">{d.pyrolysisLabel}</span>
            <span id="pyrolysis-val" class="font-mono font-bold text-orange-600 text-sm">MODERATE SMOLDERING</span>
          </div>
          <span id="pyrolysis-sub" class="text-[11px] text-muted mt-1 block">Acrolein & PAH generation from 218°C crumb bed</span>
        </div>

        <!-- Metric 5: Regulatory Compliance -->
        <div class="p-4 rounded-xl bg-surface-card border border-hairline">
          <div class="text-xs font-medium text-muted mb-1">{d.complianceLabel}</div>
          <div id="compliance-val" class="text-xs font-bold text-ink leading-relaxed">
            Non-Compliant: Exceeds EU 400 µg/kg Benchmark &bull; Bare Wire NSF Advisory
          </div>
        </div>

        <!-- Dynamic Mechanistic Analysis Box -->
        <div class="p-4 rounded-xl bg-orange-500/5 border border-orange-500/20 text-xs space-y-2">
          <div class="font-bold text-orange-800 dark:text-orange-300 flex items-center gap-1.5">
            <span>🔬</span>
            {d.mechanismLabel}
          </div>
          <p id="mechanism-text" class="text-muted leading-relaxed">
            Intense radiative heat transfer dehydrates outer crust to &lt;2% moisture within 18 seconds. Asparagine reacts with glucose at 182°C. Simultaneously, bare nichrome elements undergo thermal shock spallation.
          </p>
        </div>

        <!-- Corrective Action Guidance -->
        <div class="p-4 rounded-xl bg-emerald-500/5 border border-emerald-500/20 text-xs space-y-2">
          <div class="font-bold text-emerald-800 dark:text-emerald-300 flex items-center gap-1.5">
            <span>🛡️</span>
            {d.guidanceLabel}
          </div>
          <p id="guidance-text" class="text-muted leading-relaxed">
            Calibrate belt speed to 25s; empty crumb tray every 3 hours; upgrade toaster elements to sheathed Incoloy Calrod; operate under mechanical ventilation.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Comparative Reference Table Section -->
  <div class="border-t border-hairline pt-10 mb-12">
    <div class="max-w-3xl mb-6">
      <h3 class="text-xl font-bold text-ink tracking-tight">{d.tableTitle}</h3>
      <p class="text-xs md:text-sm text-muted">{d.tableSub}</p>
    </div>

    <div class="overflow-x-auto rounded-2xl border border-hairline bg-surface-card shadow-xs">
      <table class="w-full text-left border-collapse text-xs">
        <thead>
          <tr class="bg-surface-soft border-b border-hairline text-ink font-semibold">
            <th class="p-3.5 whitespace-nowrap">{d.colTech}</th>
            <th class="p-3.5 whitespace-nowrap">{d.colEmitterTemp}</th>
            <th class="p-3.5 whitespace-nowrap">{d.colRadiantFlux}</th>
            <th class="p-3.5 whitespace-nowrap">{d.colSpallation}</th>
            <th class="p-3.5 whitespace-nowrap">{d.colCr6Hazard}</th>
            <th class="p-3.5 whitespace-nowrap">{d.colNsfRating}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline text-muted">
          {toasterData.heatingElements.map(el => (
            <tr class="hover:bg-surface-soft/60 transition-colors">
              <td class="p-3.5 font-bold text-ink whitespace-nowrap">{el.name}</td>
              <td class="p-3.5 font-mono">{el.emitterTempC}°C</td>
              <td class="p-3.5 font-mono">{el.radiantFluxKwM2} kW/m²</td>
              <td class="p-3.5">
                <span class={`inline-block px-2 py-0.5 rounded text-[11px] font-bold ${
                  el.spallationRate === 'High' ? 'bg-rose-500/10 text-rose-700' :
                  el.spallationRate === 'Moderate' ? 'bg-amber-500/10 text-amber-700' :
                  'bg-emerald-500/10 text-emerald-700'
                }`}>
                  {el.spallationRate}
                </span>
              </td>
              <td class="p-3.5">{el.cr6Potential}</td>
              <td class="p-3.5 font-medium text-ink">
                {el.sheathProtection ? 'NSF Commercial Grade (Preferred)' : 'Standard Commercial (Requires Shielding)'}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- 4 Golden Rules Section -->
  <div class="border-t border-hairline pt-10">
    <div class="max-w-3xl mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-orange-500/10 text-orange-700 dark:text-orange-400 mb-2 border border-orange-500/20">
        <span>📋</span>
        Commercial Safety Protocols
      </div>
      <h3 class="text-xl md:text-2xl font-bold text-ink tracking-tight">{d.rulesTitle}</h3>
      <p class="text-xs md:text-sm text-muted">{d.rulesSub}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="p-6 rounded-2xl bg-surface-soft border border-hairline space-y-2">
        <h4 class="text-base font-bold text-ink flex items-center gap-2">
          <span class="text-orange-600">🧹</span>
          {d.rule1Title}
        </h4>
        <p class="text-xs md:text-sm text-muted leading-relaxed">
          {d.rule1Text}
        </p>
      </div>

      <div class="p-6 rounded-2xl bg-surface-soft border border-hairline space-y-2">
        <h4 class="text-base font-bold text-ink flex items-center gap-2">
          <span class="text-orange-600">🛡️</span>
          {d.rule2Title}
        </h4>
        <p class="text-xs md:text-sm text-muted leading-relaxed">
          {d.rule2Text}
        </p>
      </div>

      <div class="p-6 rounded-2xl bg-surface-soft border border-hairline space-y-2">
        <h4 class="text-base font-bold text-ink flex items-center gap-2">
          <span class="text-orange-600">⏱️</span>
          {d.rule3Title}
        </h4>
        <p class="text-xs md:text-sm text-muted leading-relaxed">
          {d.rule3Text}
        </p>
      </div>

      <div class="p-6 rounded-2xl bg-surface-soft border border-hairline space-y-2">
        <h4 class="text-base font-bold text-ink flex items-center gap-2">
          <span class="text-orange-600">💨</span>
          {d.rule4Title}
        </h4>
        <p class="text-xs md:text-sm text-muted leading-relaxed">
          {d.rule4Text}
        </p>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ toasterData, d }}>
  document.addEventListener('DOMContentLoaded', () => {
    const elSelect = document.getElementById('element-select');
    const spSelect = document.getElementById('speed-select');
    const brSelect = document.getElementById('bread-select');
    const trSelect = document.getElementById('tray-select');
    const vnSelect = document.getElementById('vent-select');
    const hrSlider = document.getElementById('hours-slider');
    const hrDisplay = document.getElementById('hours-display');

    const crustTempVal = document.getElementById('crust-temp-val');
    const crustTempBar = document.getElementById('crust-temp-bar');
    const crustTempSub = document.getElementById('crust-temp-sub');

    const acrylamideVal = document.getElementById('acrylamide-val');
    const acrylamideBar = document.getElementById('acrylamide-bar');
    const acrylamideSub = document.getElementById('acrylamide-sub');

    const cr6Val = document.getElementById('cr6-val');
    const cr6Sub = document.getElementById('cr6-sub');

    const pyrolysisVal = document.getElementById('pyrolysis-val');
    const pyrolysisSub = document.getElementById('pyrolysis-sub');

    const complianceVal = document.getElementById('compliance-val');
    const overallBadge = document.getElementById('overall-badge');
    const mechanismText = document.getElementById('mechanism-text');
    const guidanceText = document.getElementById('guidance-text');

    const copyBtn = document.getElementById('copy-report-btn');
    const copyBtnText = document.getElementById('copy-btn-text');

    function calculateTelemetry() {
      const elId = elSelect.value;
      const spId = spSelect.value;
      const brId = brSelect.value;
      const trId = trSelect.value;
      const vnId = vnSelect.value;
      const hours = parseInt(hrSlider.value, 10);

      hrDisplay.textContent = `${hours} Hours / Day`;

      const elObj = toasterData.heatingElements.find(e => e.id === elId) || toasterData.heatingElements[0];
      const spObj = toasterData.conveyorSpeeds.find(s => s.id === spId) || toasterData.conveyorSpeeds[1];
      const brObj = toasterData.breadMatrices.find(b => b.id === brId) || toasterData.breadMatrices[1];
      const trObj = toasterData.crumbTrayStates.find(t => t.id === trId) || toasterData.crumbTrayStates[1];
      const vnObj = toasterData.ventilationStates.find(v => v.id === vnId) || toasterData.ventilationStates[1];

      // 1. Calculate Peak Surface Temperature
      // Baseline emitter radiation factor + speed exposure duration
      const radiantFactor = elObj.radiantFluxKwM2 / 30.0;
      let calculatedCrustTemp = Math.round(140 + (spObj.crustTempPeakC - 140) * radiantFactor * (1.0 + (hours * 0.015)));
      if (calculatedCrustTemp > 285) calculatedCrustTemp = 285;

      // 2. Acrylamide formation kinetics
      // Arrhenius acceleration above 160°C, multiplied by bread matrix factor
      let baseAcrylamide = 0;
      if (calculatedCrustTemp < 145) {
        baseAcrylamide = 45;
      } else if (calculatedCrustTemp < 170) {
        baseAcrylamide = 180 + (calculatedCrustTemp - 145) * 8;
      } else if (calculatedCrustTemp < 205) {
        baseAcrylamide = 380 + Math.pow(calculatedCrustTemp - 170, 1.85) * 1.5;
      } else {
        baseAcrylamide = 950 + (calculatedCrustTemp - 205) * 22;
      }
      
      let finalAcrylamide = Math.round(baseAcrylamide * brObj.acrylamideKineticFactor * spObj.surfaceExposureFactor);
      if (finalAcrylamide > 2200) finalAcrylamide = 2200;

      // 3. Cr(VI) & Spallation Risk
      let cr6Level = 'ZERO';
      let cr6Desc = 'Sealed elements eliminate metal spallation into food pathway.';
      if (elObj.id === 'bare_nichrome') {
        if (hours >= 8 || spObj.seconds >= 60) {
          cr6Level = 'CRITICAL EXTREME';
          cr6Desc = 'Severe thermal fatigue & vibration: high Cr2O3 oxide micro-flake spallation into traversing toast.';
        } else {
          cr6Level = 'ELEVATED RISK';
          cr6Desc = 'Exposed 80/20 NiCr wire: moderate surface oxide spallation during continuous service.';
        }
      } else if (elObj.id === 'fecral_kanthal') {
        cr6Level = 'LOW TO MODERATE';
        cr6Desc = 'Alumina (Al2O3) passivation scale minimizes Cr(VI) volatility but shows thermal embrittlement.';
      } else {
        cr6Level = 'ZERO (SAFE)';
        cr6Desc = 'Hermetic Incoloy sheath or quartz envelope prevents all direct metal contact.';
      }

      // 4. Crumb Pyrolysis Index
      let pyrolysisLevel = trObj.pyrolysisEmissionLevel;
      let pyrolysisDesc = trObj.description;

      // 5. Update UI values
      crustTempVal.textContent = `${calculatedCrustTemp}°C`;
      const crustPct = Math.min(100, Math.round(((calculatedCrustTemp - 100) / 185) * 100));
      crustTempBar.style.width = `${crustPct}%`;
      crustTempBar.className = calculatedCrustTemp > 210 ? 'bg-rose-500 h-2 rounded-full transition-all' :
                               calculatedCrustTemp > 180 ? 'bg-amber-500 h-2 rounded-full transition-all' :
                               'bg-emerald-500 h-2 rounded-full transition-all';

      acrylamideVal.textContent = `${finalAcrylamide} µg/kg`;
      const acrylamidePct = Math.min(100, Math.round((finalAcrylamide / 1500) * 100));
      acrylamideBar.style.width = `${acrylamidePct}%`;
      acrylamideBar.className = finalAcrylamide > 800 ? 'bg-rose-500 h-2 rounded-full transition-all' :
                                finalAcrylamide > 400 ? 'bg-amber-500 h-2 rounded-full transition-all' :
                                'bg-emerald-500 h-2 rounded-full transition-all';

      cr6Val.textContent = cr6Level;
      cr6Val.className = cr6Level.includes('CRITICAL') ? 'font-mono font-bold text-rose-600 text-sm' :
                         cr6Level.includes('ELEVATED') ? 'font-mono font-bold text-amber-600 text-sm' :
                         'font-mono font-bold text-emerald-600 text-sm';
      cr6Sub.textContent = cr6Desc;

      pyrolysisVal.textContent = pyrolysisLevel.toUpperCase();
      pyrolysisVal.className = trObj.id === 'multi_day_neglect' ? 'font-mono font-bold text-rose-600 text-sm' :
                               trObj.id === 'shift_buildup' ? 'font-mono font-bold text-amber-600 text-sm' :
                               'font-mono font-bold text-emerald-600 text-sm';
      pyrolysisSub.textContent = `Tray temp: ~${trObj.trayTempC}°C • PAH Index: ${trObj.pahAcroleinIndex}`;

      // Overall badge & compliance
      const exceedsEuBenchmark = finalAcrylamide > toasterData.standardsAndLimits.acrylamideEuBenchmarkWheatUgKg;
      const isDangerousMetal = elObj.id === 'bare_nichrome';
      const isSmoldering = trObj.id === 'multi_day_neglect';

      if (isSmoldering || (isDangerousMetal && exceedsEuBenchmark)) {
        overallBadge.textContent = 'CRITICAL HAZARD';
        overallBadge.className = 'px-2.5 py-0.5 rounded-full text-xs font-bold uppercase tracking-wider bg-rose-500/10 text-rose-700 border border-rose-500/20';
        complianceVal.textContent = `VIOLATION: Exceeds EU Benchmark (${finalAcrylamide} > 400 µg/kg) • NFPA 96 Crumb Pyrolysis Alert • Bare NiCr Advisory`;
        complianceVal.className = 'text-xs font-bold text-rose-700 leading-relaxed';
      } else if (exceedsEuBenchmark || isDangerousMetal || trObj.id === 'shift_buildup') {
        overallBadge.textContent = 'ELEVATED RISK';
        overallBadge.className = 'px-2.5 py-0.5 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-500/10 text-amber-700 border border-amber-500/20';
        complianceVal.textContent = exceedsEuBenchmark ? 
          `NON-COMPLIANT: Acrylamide (${finalAcrylamide} µg/kg) exceeds EU 400 µg/kg Benchmark • Empty crumb tray every 4h` :
          `COMPLIANT WITH ADVISORIES: Acrylamide within range (${finalAcrylamide} µg/kg) • Monitor element spallation`;
        complianceVal.className = 'text-xs font-bold text-amber-700 leading-relaxed';
      } else {
        overallBadge.textContent = 'OPTIMAL COMPLIANT';
        overallBadge.className = 'px-2.5 py-0.5 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-500/10 text-emerald-700 border border-emerald-500/20';
        complianceVal.textContent = `100% COMPLIANT: Under EU 400 µg/kg Benchmark (${finalAcrylamide} µg/kg) • NSF/ANSI 4 Sanitation Pass • NFPA 96 Zero Smoke`;
        complianceVal.className = 'text-xs font-bold text-emerald-700 leading-relaxed';
      }

      // Mechanistic Narrative
      mechanismText.textContent = `At ${calculatedCrustTemp}°C peak radiant surface temperature, ${brObj.name} with ${brObj.sugarContentPercent}% sugar undergoes high-velocity Maillard kinetics, generating ~${finalAcrylamide} µg/kg acrylamide. Heating element (${elObj.name}) at ${elObj.emitterTempC}°C provides ${elObj.radiantFluxKwM2} kW/m² flux. Crumb tray at ~${trObj.trayTempC}°C has ${trObj.pyrolysisEmissionLevel.toLowerCase()} behavior. Ventilation (${vnObj.name}) evacuates ${Math.round(vnObj.particleEvacuationEfficiency * 100)}% of thermal plumes and aerosols.`;

      // Corrective Guidance
      if (finalAcrylamide > 400 && elObj.id === 'bare_nichrome') {
        guidanceText.textContent = `Immediate action: (1) Upgrade from bare nichrome to sheathed Incoloy Calrod or quartz tubes; (2) Decrease exposure dwell time by increasing conveyor speed; (3) Clean crumb tray at 3-hour intervals; (4) Ensure operations occur under ducted Type II exhaust.`;
      } else if (finalAcrylamide > 400) {
        guidanceText.textContent = `Acrylamide mitigation: Accelerate belt speed from ${spObj.seconds}s to reduce crust surface dehydration below 180°C. For high-sugar brioche, lower top radiant element voltage to preserve golden color without chemical charring.`;
      } else if (trObj.id !== 'hourly_clean') {
        guidanceText.textContent = `Sanitation protocol: Empty and wash crumb trays every 2 to 4 hours to prevent smoldering crumb buildup (>200°C) and comply with NFPA 96 commercial grease/smoke standards.`;
      } else {
        guidanceText.textContent = `Optimal practice: Maintain current calibrated ${spObj.seconds}s cycle, clean hourly tray protocols, and regular mechanical hood maintenance.`;
      }

      return {
        element: elObj.name,
        speed: spObj.name,
        bread: brObj.name,
        crustTemp: calculatedCrustTemp,
        acrylamide: finalAcrylamide,
        cr6Risk: cr6Level,
        pyrolysis: pyrolysisLevel,
        compliance: complianceVal.textContent
      };
    }

    // Presets
    document.querySelectorAll('.preset-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const p = btn.getAttribute('data-preset');
        if (p === 'diner-rush') {
          elSelect.value = 'bare_nichrome';
          spSelect.value = 'fast_15s';
          brSelect.value = 'brioche';
          trSelect.value = 'shift_buildup';
          vnSelect.value = 'countertop_ambient';
          hrSlider.value = '12';
        } else if (p === 'hotel-buffet') {
          elSelect.value = 'quartz_infrared';
          spSelect.value = 'standard_30s';
          brSelect.value = 'white_bread';
          trSelect.value = 'shift_buildup';
          vnSelect.value = 'countertop_ambient';
          hrSlider.value = '6';
        } else if (p === 'certified-clean') {
          elSelect.value = 'sheathed_calrod';
          spSelect.value = 'standard_30s';
          brSelect.value = 'sourdough';
          trSelect.value = 'hourly_clean';
          vnSelect.value = 'type2_hood';
          hrSlider.value = '8';
        } else if (p === 'conveyor-jam') {
          elSelect.value = 'bare_nichrome';
          spSelect.value = 'stalled_120s';
          brSelect.value = 'brioche';
          trSelect.value = 'multi_day_neglect';
          vnSelect.value = 'countertop_ambient';
          hrSlider.value = '16';
        }
        calculateTelemetry();
      });
    });

    // Event listeners
    [elSelect, spSelect, brSelect, trSelect, vnSelect, hrSlider].forEach(el => {
      el.addEventListener('change', calculateTelemetry);
      el.addEventListener('input', calculateTelemetry);
    });

    // Copy Telemetry
    copyBtn.addEventListener('click', () => {
      const res = calculateTelemetry();
      const report = `======================================================
ISITKITCHENSAFE TELEMETRY: COMMERCIAL CONVEYOR TOASTER MODELER
Timestamp: ${new Date().toISOString()}
======================================================
* Heating Element: ${res.element}
* Conveyor Transit: ${res.speed}
* Bread Matrix: ${res.bread}
* Peak Crust Surface Temp: ${res.crustTemp}°C
* Surface Acrylamide Level: ${res.acrylamide} µg/kg (EU Benchmark: 400 µg/kg)
* Cr(VI) & Heavy Metal Spallation: ${res.cr6Risk}
* Crumb Tray Pyrolysis State: ${res.pyrolysis}
* Compliance Status: ${res.compliance}
======================================================
Science-backed diagnostic via IsItKitchenSafe.com`;

      navigator.clipboard.writeText(report).then(() => {
        copyBtnText.textContent = d.copiedFeedback;
        setTimeout(() => {
          copyBtnText.textContent = d.copyReportBtn;
        }, 2500);
      });
    });

    // Initial run
    calculateTelemetry();
  });
</script>
