    colElement: "发热元件类型",
    colAlloy: "合金组成成分",
    colTempRange: "工作温度范围",
    colCr6Risk: "六价铬挥发风险",
    colShockHazard: "带电触电危险",
    colWavelength: "红外辐射峰值波长",
    colSafetySummary: "安全性与运行特征",
    protocolsTitle: "权威科学防范与化学风险阻断方案",
    protocolsSub: "源自欧洲食品安全局 (EFSA)、美国 FDA 及电气工程标准的实用安全指南。",
    rule1Title: "1. 遵循 EFSA '金黄原则' (Go for Gold)",
    rule1Text: "将烘烤程度控制在温暖的淡金黄色（2–3挡，约150°C）。科学检测证明金黄色能将丙烯酰胺稳定在欧盟 300 ppb 基准值以内，而烤成深褐色往往超过 1000 ppb。",
    rule2Title: "2. 每使用 20–30 次清理一次碎屑盘",
    rule2Text: "每月至少清理两次抽拉式碎屑盘。炽热发热丝下方的面包屑和油脂堆积是家庭烤面包机火灾的首要诱因，并会释放刺激性丙烯醛毒雾。",
    rule3Title: "3. 彻底刮除烤焦的黑色边缘",
    rule3Text: "如果不小心将面包烤焦，食用前务必在水槽上方用黄油刀将焦黑层完全刮除。物理刮除可去除 85% 以上的表层丙烯酰胺和多环芳烃 (PAH)。",
    rule4Title: "4. 严禁在通电状态下将金属餐具插入口内",
    rule4Text: "面包卡在槽内时，绝对不要用金属刀叉探入取物。传统弹出式烤面包机内部缠绕的是 220V 裸露带电镍铬丝，直接接触会导致致命的心室纤颤电击。",
    rule5Title: "5. 优先选择 24 小时长时间慢发酵酸面包",
    rule5Text: "天然酵母乳酸菌在长时间发酵过程中会主动分解游离还原糖并代谢天冬酰胺，从根源上将高温烘烤时的丙烯酰胺生成量降低 60% 以上。",
    copyReportBtn: "复制遥测诊断报告",
    reportCopied: "诊断报告已复制到剪贴板！",
    crossLinkTitle: "相关厨房电器热工与毒理检测工具",
    crossLinkAirFryer: "空气炸锅丙烯酰胺与美拉德反应计算器",
    crossLinkOilSmoke: "食用油烟点与致癌醛类生成模拟器",
    crossLinkEmergency: "厨房突发危险应急处置与止损工具"
  },
  ja: {
    badge: "熱物理学＆メイラード反応速度論",
    title: "トースター・コンベクションオーブン ニクロム熱線 六価クロム＆アクリルアミド生成リスクシミュレーター",
    subtitle: "80/20ニクロム線の熱サイクル酸化、六価クロム揮発、アスパラギン・メイラード反応、パンくずトレイの熱分解発火リスクを数値解析。",
    controlsTitle: "機器・発熱体合金・パン基質のパラメーター設定",
    controlsSub: "ヒーター合金、パンの穀物原料、焼き色ダイヤル、厚みと冷凍状態、パンくずトレイの清潔度、金属食器の接触危険度を設定して安全性を評価。",
    elementLabel: "ヒーター種別＆合金組成",
    elementHelp: "露出ニクロムリボン線は600℃〜1000℃で赤熱し100V感電危険を伴います。密閉石英管ヒーターは重金属蒸気を完全に遮断します。",
    breadLabel: "パンの原料穀物＆生地マトリックス",
    breadHelp: "全粒粉やライ麦パンは精白小麦パンの2〜3倍の遊離アスパラギンを含み、高温加熱時にアクリルアミドが急激に生成されます。",
    browningLabel: "焼き色調節ダイヤル（1〜7段階）",
    browningHelp: "欧州食品安全機関（EFSA）は黄金色（レベル3、約150℃）を推奨。濃い褐色や焦げ目（>180℃）では発がん性物質が指数関数的に増大します。",
    thicknessLabel: "スライスの厚み＆冷凍状態",
    thicknessHelp: "冷凍パンは解凍加熱が長引くためパン表面が急速に乾燥し、局所的な高温メイラード反応が加速します。",
    crumbTrayLabel: "底面パンくずトレイの堆積状態",
    crumbTrayHelp: "赤熱ヒーター直下に溜まったパンくずや油脂は250℃〜340℃で不完全燃焼熱分解を起こし、アクロレイン毒煙や火災を引き起こします。",
    utensilLabel: "金属製ナイフ・フォークの挿入危険",
    utensilHelp: "プラグが刺さった状態でパン詰まりを金属フォーク等で取ろうとすると、裸の100V発熱線に触れアーク放電と致命的感電を招きます。",
    presetsTitle: "代表的シナリオのクイック設定",
    presetBlackenedRye: "🚨 焦げ付いたライ麦パン（極めて高いアクリルアミド >2,500 ppb）",
    presetAgedNichrome: "⚡ 老朽化ニクロム線の酸化皮膜剥離（NiCrリボン＋パンくず堆積）",
    presetCrumbFire: "🔥 放置パンくずトレイの発煙・発火（3ヶ月未清掃の油脂堆積）",
    presetSourdoughShield: "🥖 長時間発酵サワードウの防御壁（低アクリルアミド天然パン）",
    presetOptimalGold: "✅ EFSA推奨の黄金色トースト（レベル3 / 150℃）",
    diagnosticTitle: "熱工学＆化学リスク・テレメトリーダッシュボード",
    diagnosticSub: "アレニウス反応速度論、欧州委員会規則 (EU) 2017/2158、および電気安全規格 UL 1026 に基づくリアルタイム工学計算。",
    overallScoreLabel: "トースター総合安全性スコア",
    acrylamideLabel: "推定アクリルアミド濃度",
    surfaceTempLabel: "パン表面のメイラード反応ピーク温度",
    chromiumRiskLabel: "六価クロム（Cr VI）揮発＆酸化物剥離",
    crumbFireRiskLabel: "パンくず熱分解＆発火危険度指数",
    smokeToxicityLabel: "燻煙VOC＆微粒子煤（アクロレイン/PAH）",
    shockHazardLabel: "100V/200V 裸線感電危険度",
    alertTitle: "重要安全評価＆工学的警告アラート",
    diagramTitle: "トースター赤外放射加熱室＆熱化学反応断面図",
    diagramSub: "露出ニクロム線と石英管の赤外放射特性、パン表面のメイラード層、底面パンくず熱分解室の構造を図解。",
    tableTitle: "発熱体冶金学＆毒性学エンジニアリング比較表",
    tableSub: "家庭用・業務用トースターの発熱合金、電気絶縁性、化学物質放散特性の比較。",
    colElement: "発熱体方式",
    colAlloy: "合金組成",
    colTempRange: "動作温度範囲",
    colCr6Risk: "六価クロム危険度",
    colShockHazard: "感電危険性",
    colWavelength: "赤外線放射ピーク",
    colSafetySummary: "安全性プロファイル",
    protocolsTitle: "科学的根拠に基づく安全対策＆化学物質低減手順",
    protocolsSub: "欧州食品安全機関（EFSA）、米国FDA、および電気安全工学に基づく実践プロトコル。",
    rule1Title: "1. EFSA推奨の「ゴー・フォー・ゴールド（黄金色）原則」",
    rule1Text: "トーストの焼き色は明るい黄色〜黄金色（レベル2〜3、約150℃）に留めてください。黄金色ならアクリルアミドをEU基準値300 ppb以下に抑えられますが、濃い褐色では1,000 ppbを超過します。",
    rule2Title: "2. 20〜30回使用ごとにパンくずトレイを清掃",
    rule2Text: "引き出し式パンくずトレイは最低でも月2回清掃してください。赤熱ヒーター下に溜まったパンくずはトースター火災の最大の原因であり、アクロレインなどの有害煙を発生させます。",
    rule3Title: "3. 焦げ付いた黒い部分はバターナイフ等で削り落とす",
    rule3Text: "万が一パンが焦げて黒くなった場合は、流し台でナイフを使って黒い焦げをしっかり削り落としてください。物理的切削により表面のアクリルアミドや多環芳香族炭化水素（PAH）の85%以上を除去できます。",
    rule4Title: "4. 通電中の金属製器具の挿入は厳禁",
    rule4Text: "パンが挟まった際、プラグを抜かずに金属製のナイフやフォークを差し込むことは絶対にやめてください。露出したニクロム線には100V〜200Vの電圧がかかっており、致命的な感電事故を招きます。",
    rule5Title: "5. 24時間以上の長時間発酵サワードウブレッドを活用",
    rule5Text: "天然酵母と乳酸菌による長時間発酵パンを選んでください。乳酸菌が生地中の遊離糖やアスパラギンを消費するため、トースト加熱時のアクリルアミド生成を60%以上抑制できます。",
    copyReportBtn: "診断レポートをクリップボードにコピー",
    reportCopied: "レポートをコピーしました！",
    crossLinkTitle: "関連する調理家電・熱物理診断ツール",
    crossLinkAirFryer: "ノンフライヤー アクリルアミド＆メイラード計算機",
    crossLinkOilSmoke: "食用油 発煙点＆有毒アルデヒド生成シミュレーター",
    crossLinkEmergency: "キッチン火災・家電異常事態 緊急トリアージツール"
  }
};

const d = dict[lang];
---

<div class="not-prose my-10 bg-canvas border border-hairline rounded-3xl p-6 sm:p-8 md:p-10 shadow-xs" id="toaster-safety-modeler">
  <!-- Header Badge -->
  <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-amber-100 text-amber-900 mb-4">
    <span>⚡</span>
    {d.badge}
  </div>

  <h2 class="text-2xl sm:text-3xl font-extrabold text-ink tracking-tight mb-2">
    {d.title}
  </h2>
  <p class="text-sm sm:text-base text-body leading-relaxed max-w-4xl mb-8">
    {d.subtitle}
  </p>

  <!-- Quick Scenario Presets -->
  <div class="mb-10 p-5 bg-surface-soft border border-hairline rounded-2xl">
    <div class="flex items-center justify-between gap-2 mb-3">
      <span class="text-xs font-bold uppercase tracking-wider text-muted">
        ⚡ {d.presetsTitle}
      </span>
      <span class="text-[11px] text-muted font-mono">1-Click Scenarios</span>
    </div>
    <div class="flex flex-wrap gap-2">
      <button 
        type="button" 
        class="scenario-preset-btn px-3 py-1.5 text-xs font-medium rounded-xl bg-surface-strong hover:bg-hairline text-ink border border-hairline transition-all active:scale-95 cursor-pointer"
        data-preset="optimal-gold"
      >
        {d.presetOptimalGold}
      </button>
      <button 
        type="button" 
        class="scenario-preset-btn px-3 py-1.5 text-xs font-medium rounded-xl bg-surface-strong hover:bg-hairline text-ink border border-hairline transition-all active:scale-95 cursor-pointer"
        data-preset="sourdough-shield"
      >
        {d.presetSourdoughShield}
      </button>
      <button 
        type="button" 
        class="scenario-preset-btn px-3 py-1.5 text-xs font-medium rounded-xl bg-surface-strong hover:bg-hairline text-ink border border-hairline transition-all active:scale-95 cursor-pointer"
        data-preset="crumb-fire"
      >
        {d.presetCrumbFire}
      </button>
      <button 
        type="button" 
        class="scenario-preset-btn px-3 py-1.5 text-xs font-medium rounded-xl bg-surface-strong hover:bg-hairline text-ink border border-hairline transition-all active:scale-95 cursor-pointer"
        data-preset="blackened-rye"
      >
        {d.presetBlackenedRye}
      </button>
      <button 
        type="button" 
        class="scenario-preset-btn px-3 py-1.5 text-xs font-medium rounded-xl bg-surface-strong hover:bg-hairline text-ink border border-hairline transition-all active:scale-95 cursor-pointer"
        data-preset="aged-nichrome"
      >
        {d.presetAgedNichrome}
      </button>
    </div>
  </div>

  <!-- Interactive Simulator Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-10">
    <!-- Controls Panel (Left 5 Cols) -->
    <div class="lg:col-span-5 bg-surface-soft border border-hairline rounded-2xl p-6 flex flex-col justify-between">
      <div>
        <h3 class="text-base font-bold text-ink mb-1 flex items-center gap-2">
          <span>🎛️</span> {d.controlsTitle}
        </h3>
        <p class="text-xs text-muted mb-6 leading-relaxed">
          {d.controlsSub}
        </p>

        <div class="space-y-5 text-xs">
          <!-- 1. Heating Element Technology -->
          <div>
            <label for="heating-element-select" class="block font-semibold text-ink mb-1">
              {d.elementLabel}
            </label>
            <select 
              id="heating-element-select" 
              class="w-full p-2.5 rounded-xl bg-surface-strong border border-hairline text-ink text-xs focus:outline-none focus:ring-2 focus:ring-amber-500 cursor-pointer"
            >
              {toasterData.heatingElementTypes.map(elem => (
                <option value={elem.id}>
                  {elem.name}
                </option>
              ))}
            </select>
            <p class="text-[11px] text-muted mt-1 leading-normal">
              {d.elementHelp}
            </p>
          </div>

          <!-- 2. Bread Matrix Selection -->
          <div>
            <label for="bread-matrix-select" class="block font-semibold text-ink mb-1">
              {d.breadLabel}
            </label>
            <select 
              id="bread-matrix-select" 
              class="w-full p-2.5 rounded-xl bg-surface-strong border border-hairline text-ink text-xs focus:outline-none focus:ring-2 focus:ring-amber-500 cursor-pointer"
            >
              {toasterData.breadMatrices.map(bread => (
                <option value={bread.id} selected={bread.id === 'white-refined-wheat'}>
                  {bread.name} ({bread.freeAsparagineMgKg} mg/kg Asparagine)
                </option>
              ))}
            </select>
            <p class="text-[11px] text-muted mt-1 leading-normal">
              {d.breadHelp}
            </p>
          </div>

          <!-- 3. Browning Slider (Level 1 to 7) -->
          <div>
            <div class="flex items-center justify-between mb-1">
              <label for="browning-slider" class="font-semibold text-ink">
                {d.browningLabel}
              </label>
              <span id="browning-level-badge" class="px-2 py-0.5 rounded-md text-[11px] font-mono font-bold bg-amber-100 text-amber-900">
                Level 3 (Golden)
              </span>
            </div>
            <input 
              type="range" 
              id="browning-slider" 
              min="1" 
              max="7" 
              step="1" 
              value="3" 
              class="w-full h-2 bg-hairline rounded-lg appearance-none cursor-pointer accent-amber-500"
            />
            <div class="flex justify-between text-[10px] text-muted font-mono mt-1 px-1">
              <span>1: Warm</span>
              <span>2: Pale</span>
              <span class="text-amber-800 font-bold">3: Gold</span>
              <span>4: Brown</span>
              <span>5: Deep</span>
              <span>6: Dark</span>
              <span class="text-red-700 font-bold">7: Burnt</span>
            </div>
            <p class="text-[11px] text-muted mt-1.5 leading-normal">
              {d.browningHelp}
            </p>
          </div>

          <!-- 4. Slice Thickness & Moisture -->
          <div>
            <label for="thickness-select" class="block font-semibold text-ink mb-1">
              {d.thicknessLabel}
            </label>
            <select 
              id="thickness-select" 
              class="w-full p-2.5 rounded-xl bg-surface-strong border border-hairline text-ink text-xs focus:outline-none focus:ring-2 focus:ring-amber-500 cursor-pointer"
            >
              <option value="standard-fresh" selected>Standard Fresh Slice (12–14mm, Ambient 20°C)</option>
              <option value="thick-artisan">Thick Cut Artisan Bread (20–25mm)</option>
              <option value="frozen-slice">Frozen Bread Slice (-18°C / High Surface Desiccation)</option>
              <option value="dense-bagel">Dense Bagel / English Muffin Half</option>
            </select>
            <p class="text-[11px] text-muted mt-1 leading-normal">
              {d.thicknessHelp}
            </p>
          </div>

          <!-- 5. Crumb Tray Condition -->
          <div>
            <label for="crumb-tray-select" class="block font-semibold text-ink mb-1">
              {d.crumbTrayLabel}
            </label>
            <select 
              id="crumb-tray-select" 
              class="w-full p-2.5 rounded-xl bg-surface-strong border border-hairline text-ink text-xs focus:outline-none focus:ring-2 focus:ring-amber-500 cursor-pointer"
            >
              {toasterData.crumbTrayPyrolysisData.map(tray => (
                <option value={tray.id} selected={tray.id === 'clean-empty'}>
                  {tray.label}
                </option>
              ))}
            </select>
            <p class="text-[11px] text-muted mt-1 leading-normal">
              {d.crumbTrayHelp}
            </p>
          </div>

          <!-- 6. Metal Silverware Probing Hazard -->
          <div>
            <label for="silverware-select" class="block font-semibold text-ink mb-1">
              {d.utensilLabel}
            </label>
            <select 
              id="silverware-select" 
              class="w-full p-2.5 rounded-xl bg-surface-strong border border-hairline text-ink text-xs focus:outline-none focus:ring-2 focus:ring-red-500 cursor-pointer"
            >
              <option value="safe-unplugged" selected>Unplugged Appliance / Wooden Toast Tongs Used</option>
              <option value="metal-knife-inserted">Metal Butter Knife or Fork Inserted While Plugged In (120V/240V Live)</option>
            </select>
            <p class="text-[11px] text-muted mt-1 leading-normal">
              {d.utensilHelp}
            </p>
          </div>
        </div>
      </div>

      <div class="mt-6 pt-4 border-t border-hairline">
        <button 
          id="copy-telemetry-btn" 
          type="button" 
          class="w-full py-2.5 px-4 rounded-xl bg-ink hover:bg-black text-white text-xs font-semibold tracking-wide transition-all active:scale-95 cursor-pointer shadow-xs flex items-center justify-center gap-2"
        >
          <span>📋</span>
          <span id="copy-btn-label">{d.copyReportBtn}</span>
        </button>
      </div>
    </div>

    <!-- Telemetry Display (Right 7 Cols) -->
    <div class="lg:col-span-7 flex flex-col justify-between">
      <div>
        <!-- Top Metrics Header -->
        <div class="p-6 bg-surface-soft border border-hairline rounded-2xl mb-6">
          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-4">
            <div>
              <span class="text-[11px] font-bold uppercase tracking-wider text-muted">
                {d.overallScoreLabel}
              </span>
              <div class="flex items-baseline gap-2 mt-1">
                <span id="overall-score-display" class="text-4xl font-black text-emerald-700">92</span>
                <span class="text-xs text-muted font-mono">/ 100 Safety Index</span>
              </div>
            </div>
            <div id="safety-tier-pill" class="px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800">
              Optimal Gold Safety
            </div>
          </div>

          <!-- Dynamic Visual Bread Slice Color Bar -->
          <div class="w-full h-3 rounded-full overflow-hidden border border-hairline mb-2 flex">
            <div id="toast-color-preview-bar" class="w-full h-full transition-colors duration-500 bg-amber-400"></div>
          </div>
          <div class="flex justify-between items-center text-[11px] text-muted font-mono">
            <span>Visual Toast Tone: <strong id="toast-tone-name" class="text-ink">Golden Yellow</strong></span>
            <span>Est. Toast Time: <strong id="toast-est-time" class="text-ink">125s</strong></span>
          </div>
        </div>

        <!-- 6 Core Diagnostic Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
          <!-- Card 1: Acrylamide -->
          <div class="p-4 bg-surface-soft rounded-2xl border border-hairline">
            <div class="flex items-center justify-between text-xs text-muted mb-1">
              <span class="font-medium">{d.acrylamideLabel}</span>
              <span class="text-amber-800 font-bold font-mono">EU 300 ppb Limit</span>
            </div>
            <div class="flex items-baseline gap-2">
              <span id="acrylamide-ppb-val" class="text-2xl font-black text-ink">120</span>
              <span class="text-xs font-mono text-muted">ppb (µg/kg)</span>
            </div>
            <div id="acrylamide-status-text" class="text-[11px] text-emerald-700 font-semibold mt-1">
              ✓ Complies with EFSA Benchmark
            </div>
          </div>

          <!-- Card 2: Surface Temperature -->
          <div class="p-4 bg-surface-soft rounded-2xl border border-hairline">
            <div class="flex items-center justify-between text-xs text-muted mb-1">
              <span class="font-medium">{d.surfaceTempLabel}</span>
              <span class="text-muted font-mono">Pyrolysis &gt;200°C</span>
            </div>
            <div class="flex items-baseline gap-2">
