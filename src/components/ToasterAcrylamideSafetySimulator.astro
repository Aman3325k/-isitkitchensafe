    alertCrumbTitle: '火災警告：放置パンくずトレイの熱分解発火',
    alertCrumbBody: '600°C以上の発熱体直下に蓄積したパンくずやバター油脂が熱分解を起こしています。フラッシュ火災や有害なアクロレイン・一酸化炭素・PAH煙を発生させるため、使用前に必ず清掃してください。',
    alertAcrylCritTitle: '重大毒性超過：アクリルアミド＆炭化熱分解オーバーロード',
    alertAcrylCritBodyTpl: '推定アクリルアミド濃度が {ppb} ppb に達し、EFSAゴールデン基準およびEU規則2017/2158指標（小麦パン50 ppb / クリスプブレッド350 ppb）を大幅に超過しています。黒焦げ部分はPAHも含むため必ず削り落とすか廃棄してください。',
    alertAcrylWarnTitle: 'アクリルアミド上昇：ダイヤルを黄金色へ下げてください',
    alertAcrylWarnBodyTpl: 'レベル {lvl} では推定アクリルアミドが {ppb} ppb に達します。EFSA推奨の明るい黄金色を保つためレベル2〜3への引き下げを推奨します。',
    alertOptimalTitle: '最適安全達成：EFSA「ゴー・フォー・ゴールド」適合',
    alertOptimalBodyTpl: '現在の設定は安全な黄金色レンジ（{ppb} ppb）にあり、発熱体の酸化スケール剥離やパンくずトレイ発火のリスクも抑えられています。',
    svgAriaLabel: 'トースター赤外放射加熱室 断面工学図',
    svgCavity: 'パンスロット放射加熱室',
    svgMica: 'マイカ絶縁板',
    svgSoftCrumb: '内部クラム層',
    svgMoisture: '水分率: 35–40%',
    svgCoreTemp: '中心温度: <100°C',
    svgMaillardZone: '表面メイラード反応層',
    svgSurfaceRange: '表面温度: 130°C–200°C',
    svgReactionEq: 'アスパラギン＋還元糖反応',
    svgCrumbTray: '引き出し式底面パンくずトレイ（亜鉛メッキ鋼板）',
    svgPyrolysisWarn: '⚠️ 熱分解火災危険：パンくず・油脂残渣は >260°C で燻焼発火',
    svgCalloutRibbon: '80/20 ニクロムリボン線',
    svgCalloutTemp: '温度: 600°C–1000°C',
    svgCalloutVolts: '100V/200V 露出活線',
    svgCalloutWave: '赤外線放射波',
    svgCalloutLambda: 'λ = 1.2–2.5 µm',
    svgCalloutSear: '急速表面焼き上げ',
    repHeader: '=== IsItKitchenSafe トースター発熱線＆アクリルアミド安全診断レポート ===',
    repScore: '総合安全スコア',
    repElement: '発熱体種別',
    repBread: 'パンの種類',
    repBrowning: '焼き色レベル',
    repTemp: 'パン表面ピーク温度',
    repAcrylamide: '推定アクリルアミド濃度',
    repAcrylamideNote: 'EU 2017/2158指標: 小麦パン 50 ppb / クリスプブレッド 350 ppb',
    repCr: '酸化皮膜・クロム状態',
    repCrumb: 'パンくず発火リスク',
    repAssessment: '総合安全評価',
    repSource: '診断ツール URL'
  }
};

const d = dict[lang] || dict.en;
const itemI18n = ITEM_I18N[lang] || ITEM_I18N.en;
const jsI18n = JS_STATUS_I18N[lang] || JS_STATUS_I18N.en;

const localizedElements = toasterData.heatingElementTypes.map((el) => ({
  ...el,
  name: itemI18n.elements[el.id]?.name || el.name,
  alloyComposition: itemI18n.elements[el.id]?.alloy || el.alloyComposition,
  cr6VolatilizationRisk: itemI18n.elements[el.id]?.cr6Risk || el.cr6VolatilizationRisk,
  shockHazardRisk: itemI18n.elements[el.id]?.shockHazard || el.shockHazardRisk,
  description: itemI18n.elements[el.id]?.description || el.description
}));

const localizedBreads = toasterData.breadMatrices.map((b) => ({
  ...b,
  name: itemI18n.breads[b.id]?.name || b.name,
  shortName: itemI18n.breads[b.id]?.shortName || b.name
}));

const localizedCrumbTrays = toasterData.crumbTrayPyrolysisData.map((t) => ({
  ...t,
  label: itemI18n.crumbTrays[t.id]?.label || t.label,
  smoke: itemI18n.crumbTrays[t.id]?.smoke || 'Zero Smoke',
  desc: itemI18n.crumbTrays[t.id]?.desc || ''
}));

const localizedData = {
  ...toasterData,
  heatingElementTypes: localizedElements,
  breadMatrices: localizedBreads,
  crumbTrayPyrolysisData: localizedCrumbTrays
};

const localePrefix = lang === 'en' ? '' : `/${lang}`;
const toolUrl = `https://isitkitchensafe.com${localePrefix}/tools/toaster-element-acrylamide-safety-simulator/`;
---

<div class="not-prose my-10 bg-canvas border border-hairline rounded-3xl p-6 sm:p-8 md:p-10 shadow-xs" id="toaster-safety-modeler">
  <!-- Header Badge -->
  <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-amber-100 text-amber-900 mb-4">
    <span>⚡</span>
    {d.badge}
  </div>

  <h2 class="text-2xl sm:text-3xl font-extrabold text-ink tracking-tight mb-2">
    {d.title}
  </h2>
  <p class="text-sm sm:text-base text-body leading-relaxed max-w-4xl mb-8">
    {d.subtitle}
  </p>

  <!-- Quick Scenario Presets -->
  <div class="mb-10 p-5 bg-surface-soft border border-hairline rounded-2xl">
    <div class="flex items-center justify-between gap-2 mb-3">
      <span class="text-xs font-bold uppercase tracking-wider text-muted">
        ⚡ {d.presetsTitle}
      </span>
      <span class="text-[11px] text-muted font-mono">{jsI18n.oneClickLabel}</span>
    </div>
    <div class="flex flex-wrap gap-2">
      <button 
        type="button" 
        class="scenario-preset-btn px-3 py-1.5 text-xs font-medium rounded-xl bg-surface-strong hover:bg-hairline text-ink border border-hairline transition-all active:scale-95 cursor-pointer"
        data-preset="optimal-gold"
      >
        {d.presetOptimalGold}
      </button>
      <button 
        type="button" 
        class="scenario-preset-btn px-3 py-1.5 text-xs font-medium rounded-xl bg-surface-strong hover:bg-hairline text-ink border border-hairline transition-all active:scale-95 cursor-pointer"
        data-preset="sourdough-shield"
      >
        {d.presetSourdoughShield}
      </button>
      <button 
        type="button" 
        class="scenario-preset-btn px-3 py-1.5 text-xs font-medium rounded-xl bg-surface-strong hover:bg-hairline text-ink border border-hairline transition-all active:scale-95 cursor-pointer"
        data-preset="crumb-fire"
      >
        {d.presetCrumbFire}
      </button>
      <button 
        type="button" 
        class="scenario-preset-btn px-3 py-1.5 text-xs font-medium rounded-xl bg-surface-strong hover:bg-hairline text-ink border border-hairline transition-all active:scale-95 cursor-pointer"
        data-preset="blackened-rye"
      >
        {d.presetBlackenedRye}
      </button>
      <button 
        type="button" 
        class="scenario-preset-btn px-3 py-1.5 text-xs font-medium rounded-xl bg-surface-strong hover:bg-hairline text-ink border border-hairline transition-all active:scale-95 cursor-pointer"
        data-preset="aged-nichrome"
      >
        {d.presetAgedNichrome}
      </button>
    </div>
  </div>

  <!-- Interactive Simulator Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-10">
    <!-- Controls Panel (Left 5 Cols) -->
    <div class="lg:col-span-5 bg-surface-soft border border-hairline rounded-2xl p-6 flex flex-col justify-between">
      <div>
        <h3 class="text-base font-bold text-ink mb-1 flex items-center gap-2">
          <span>🎛️</span> {d.controlsTitle}
        </h3>
        <p class="text-xs text-muted mb-6 leading-relaxed">
          {d.controlsSub}
        </p>

        <div class="space-y-5 text-xs">
          <!-- 1. Heating Element Technology -->
          <div>
            <label for="heating-element-select" class="block font-semibold text-ink mb-1">
              {d.elementLabel}
            </label>
            <select 
              id="heating-element-select" 
              class="w-full p-2.5 rounded-xl bg-surface-strong border border-hairline text-ink text-xs focus:outline-none focus:ring-2 focus:ring-amber-500 cursor-pointer"
            >
              {localizedElements.map(elem => (
                <option value={elem.id}>
                  {elem.name}
                </option>
              ))}
            </select>
            <p class="text-[11px] text-muted mt-1 leading-normal">
              {d.elementHelp}
            </p>
          </div>

          <!-- 2. Bread Matrix Selection -->
          <div>
            <label for="bread-matrix-select" class="block font-semibold text-ink mb-1">
              {d.breadLabel}
            </label>
            <select 
              id="bread-matrix-select" 
              class="w-full p-2.5 rounded-xl bg-surface-strong border border-hairline text-ink text-xs focus:outline-none focus:ring-2 focus:ring-amber-500 cursor-pointer"
            >
              {localizedBreads.map(bread => (
                <option value={bread.id} selected={bread.id === 'white-refined-wheat'}>
                  {bread.name} ({bread.freeAsparagineMgKg} {jsI18n.asparagineTag})
                </option>
              ))}
            </select>
            <p class="text-[11px] text-muted mt-1 leading-normal">
              {d.breadHelp}
            </p>
          </div>

          <!-- 3. Browning Slider (Level 1 to 7) -->
          <div>
            <div class="flex items-center justify-between mb-1">
              <label for="browning-slider" class="font-semibold text-ink">
                {d.browningLabel}
              </label>
              <span id="browning-level-badge" class="px-2 py-0.5 rounded-md text-[11px] font-mono font-bold bg-amber-100 text-amber-900">
                {jsI18n.browningLevelBadgeTpl.replace('{lvl}', '3').replace('{tone}', jsI18n.browningTones[3].split('(')[0].trim())}
              </span>
            </div>
            <input 
              type="range" 
              id="browning-slider" 
              min="1" 
              max="7" 
              step="1" 
              value="3" 
              class="w-full h-2 bg-hairline rounded-lg appearance-none cursor-pointer accent-amber-500"
            />
            <div class="flex justify-between text-[10px] text-muted font-mono mt-1 px-1">
              <span>{jsI18n.browningTicks[0]}</span>
              <span>{jsI18n.browningTicks[1]}</span>
              <span class="text-amber-800 font-bold">{jsI18n.browningTicks[2]}</span>
              <span>{jsI18n.browningTicks[3]}</span>
              <span>{jsI18n.browningTicks[4]}</span>
              <span>{jsI18n.browningTicks[5]}</span>
              <span class="text-red-700 font-bold">{jsI18n.browningTicks[6]}</span>
            </div>
            <p class="text-[11px] text-muted mt-1.5 leading-normal">
              {d.browningHelp}
            </p>
          </div>

          <!-- 4. Slice Thickness & Moisture -->
          <div>
            <label for="thickness-select" class="block font-semibold text-ink mb-1">
              {d.thicknessLabel}
            </label>
            <select 
              id="thickness-select" 
              class="w-full p-2.5 rounded-xl bg-surface-strong border border-hairline text-ink text-xs focus:outline-none focus:ring-2 focus:ring-amber-500 cursor-pointer"
            >
              <option value="standard-fresh" selected>{itemI18n.thicknesses['standard-fresh']}</option>
              <option value="thick-artisan">{itemI18n.thicknesses['thick-artisan']}</option>
              <option value="frozen-slice">{itemI18n.thicknesses['frozen-slice']}</option>
              <option value="dense-bagel">{itemI18n.thicknesses['dense-bagel']}</option>
            </select>
            <p class="text-[11px] text-muted mt-1 leading-normal">
              {d.thicknessHelp}
            </p>
          </div>

          <!-- 5. Crumb Tray Condition -->
          <div>
            <label for="crumb-tray-select" class="block font-semibold text-ink mb-1">
              {d.crumbTrayLabel}
            </label>
            <select 
              id="crumb-tray-select" 
              class="w-full p-2.5 rounded-xl bg-surface-strong border border-hairline text-ink text-xs focus:outline-none focus:ring-2 focus:ring-amber-500 cursor-pointer"
            >
              {localizedCrumbTrays.map(tray => (
                <option value={tray.id} selected={tray.id === 'clean-empty'}>
                  {tray.label}
                </option>
              ))}
            </select>
            <p class="text-[11px] text-muted mt-1 leading-normal">
              {d.crumbTrayHelp}
            </p>
          </div>

          <!-- 6. Metal Silverware Probing Hazard -->
          <div>
            <label for="silverware-select" class="block font-semibold text-ink mb-1">
              {d.utensilLabel}
            </label>
            <select 
              id="silverware-select" 
              class="w-full p-2.5 rounded-xl bg-surface-strong border border-hairline text-ink text-xs focus:outline-none focus:ring-2 focus:ring-red-500 cursor-pointer"
            >
              <option value="safe-unplugged" selected>{itemI18n.silverware['safe-unplugged']}</option>
              <option value="metal-knife-inserted">{itemI18n.silverware['metal-knife-inserted']}</option>
            </select>
            <p class="text-[11px] text-muted mt-1 leading-normal">
              {d.utensilHelp}
            </p>
          </div>
        </div>
      </div>

      <div class="mt-6 pt-4 border-t border-hairline">
        <button 
          id="copy-telemetry-btn" 
          type="button" 
          class="w-full py-2.5 px-4 rounded-xl bg-ink hover:bg-black text-white text-xs font-semibold tracking-wide transition-all active:scale-95 cursor-pointer shadow-xs flex items-center justify-center gap-2"
        >
          <span>📋</span>
          <span id="copy-btn-label">{d.copyReportBtn}</span>
        </button>
      </div>
    </div>

    <!-- Telemetry Display (Right 7 Cols) -->
    <div class="lg:col-span-7 flex flex-col justify-between">
      <div>
        <!-- Top Metrics Header -->
        <div class="p-6 bg-surface-soft border border-hairline rounded-2xl mb-6">
          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-4">
            <div>
              <span class="text-[11px] font-bold uppercase tracking-wider text-muted">
                {d.overallScoreLabel}
              </span>
              <div class="flex items-baseline gap-2 mt-1">
                <span id="overall-score-display" class="text-4xl font-black text-emerald-700">92</span>
                <span class="text-xs text-muted font-mono">{jsI18n.safetyIndexSuffix}</span>
              </div>
            </div>
            <div id="safety-tier-pill" class="px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800">
              {jsI18n.tierOptimal}
            </div>
          </div>

          <!-- Dynamic Visual Bread Slice Color Bar -->
          <div class="w-full h-3 rounded-full overflow-hidden border border-hairline mb-2 flex">
            <div id="toast-color-preview-bar" class="w-full h-full transition-colors duration-500 bg-amber-400"></div>
          </div>
          <div class="flex justify-between items-center text-[11px] text-muted font-mono">
            <span>{jsI18n.visualToastToneLabel} <strong id="toast-tone-name" class="text-ink">{jsI18n.browningTones[3]}</strong></span>
            <span>{jsI18n.estToastTimeLabel} <strong id="toast-est-time" class="text-ink">125s</strong></span>
          </div>
        </div>

        <!-- 6 Core Diagnostic Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
          <!-- Card 1: Acrylamide -->
          <div class="p-4 bg-surface-soft rounded-2xl border border-hairline">
            <div class="flex items-center justify-between text-xs text-muted mb-1">
              <span class="font-medium">{d.acrylamideLabel}</span>
              <span class="text-amber-800 font-bold font-mono">{jsI18n.euRuleBadge}</span>
            </div>
            <div class="flex items-baseline gap-2">
              <span id="acrylamide-ppb-val" class="text-2xl font-black text-ink">120</span>
              <span class="text-xs font-mono text-muted">{jsI18n.ppbUnit}</span>
            </div>
            <div id="acrylamide-status-text" class="text-[11px] text-emerald-700 font-semibold mt-1">
              {jsI18n.acrylamideSafe}
            </div>
          </div>

          <!-- Card 2: Surface Temperature -->
          <div class="p-4 bg-surface-soft rounded-2xl border border-hairline">
            <div class="flex items-center justify-between text-xs text-muted mb-1">
              <span class="font-medium">{d.surfaceTempLabel}</span>
              <span class="text-muted font-mono">{jsI18n.pyrolysisBadge}</span>
            </div>
            <div class="flex items-baseline gap-2">
              <span id="surface-temp-val" class="text-2xl font-black text-ink">152°C</span>
              <span id="surface-temp-f-val" class="text-xs font-mono text-muted">(306°F)</span>
            </div>
            <div id="maillard-status-text" class="text-[11px] text-muted mt-1">
              {jsI18n.maillardOptimal}
            </div>
          </div>

          <!-- Card 3: Chromium Oxide & Flaking -->
          <div class="p-4 bg-surface-soft rounded-2xl border border-hairline">
            <div class="flex items-center justify-between text-xs text-muted mb-1">
              <span class="font-medium">{d.chromiumRiskLabel}</span>
              <span class="text-muted font-mono">{jsI18n.iarcBadge}</span>
            </div>
            <div class="flex items-baseline gap-2">
              <span id="chromium-risk-val" class="text-xl font-black text-emerald-700">{jsI18n.crNichromeLowVal}</span>
            </div>
            <div id="chromium-desc-text" class="text-[11px] text-muted mt-1 leading-snug">
              {jsI18n.crNichromeLowDesc}
            </div>
          </div>

          <!-- Card 4: Crumb Pyrolysis -->
          <div class="p-4 bg-surface-soft rounded-2xl border border-hairline">
            <div class="flex items-center justify-between text-xs text-muted mb-1">
              <span class="font-medium">{d.crumbFireRiskLabel}</span>
              <span class="text-muted font-mono">{jsI18n.autoIgnitionBadge}</span>
            </div>
            <div class="flex items-baseline gap-2">
              <span id="crumb-fire-val" class="text-2xl font-black text-emerald-700">4%</span>
              <span class="text-xs font-mono text-muted">{jsI18n.fireRiskScoreUnit}</span>
            </div>
            <div id="crumb-fire-desc" class="text-[11px] text-muted mt-1 leading-snug">
              {localizedCrumbTrays[0]?.desc}
            </div>
          </div>

          <!-- Card 5: Smoldering Smoke & VOCs -->
          <div class="p-4 bg-surface-soft rounded-2xl border border-hairline">
            <div class="flex items-center justify-between text-xs text-muted mb-1">
              <span class="font-medium">{d.smokeToxicityLabel}</span>
              <span class="text-muted font-mono">{jsI18n.acroleinBadge}</span>
            </div>
            <div class="flex items-baseline gap-2">
              <span id="smoke-val" class="text-lg font-black text-ink">{localizedCrumbTrays[0]?.smoke}</span>
            </div>
            <div id="smoke-desc" class="text-[11px] text-muted mt-1 leading-snug">
              {jsI18n.smokeCleanDesc}
            </div>
          </div>

          <!-- Card 6: Electrocution Risk -->
          <div class="p-4 bg-surface-soft rounded-2xl border border-hairline">
            <div class="flex items-center justify-between text-xs text-muted mb-1">
              <span class="font-medium">{d.shockHazardLabel}</span>
              <span class="text-muted font-mono">{jsI18n.ulBadge}</span>
            </div>
            <div class="flex items-baseline gap-2">
              <span id="shock-hazard-val" class="text-lg font-black text-emerald-700">{jsI18n.shockSafeVal}</span>
            </div>
            <div id="shock-hazard-desc" class="text-[11px] text-muted mt-1 leading-snug">
              {jsI18n.shockSafeDesc}
            </div>
          </div>
        </div>

        <!-- Dynamic Warning Alert Banner -->
        <div id="dynamic-alert-banner" class="p-5 rounded-2xl border transition-all bg-emerald-50 border-emerald-300">
          <div class="flex items-start gap-3">
            <span id="alert-banner-icon" class="text-2xl">✅</span>
            <div>
              <h4 id="alert-banner-title" class="text-xs font-bold text-emerald-900 uppercase tracking-wider mb-1">
                {jsI18n.alertOptimalTitle}
              </h4>
              <p id="alert-banner-body" class="text-xs text-body leading-relaxed">
                {jsI18n.alertOptimalBodyTpl.replace('{ppb}', '120')}
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Toaster Radiant Chamber & Thermal Reaction Cross-Section Diagram -->
  <div class="mb-12 bg-surface-soft border border-hairline rounded-3xl p-6 sm:p-8">
    <div class="max-w-2xl mb-6">
      <h3 class="text-lg font-bold text-ink mb-1 flex items-center gap-2">
        <span>🔬</span> {d.diagramTitle}
      </h3>
      <p class="text-xs text-muted leading-relaxed">
        {d.diagramSub}
      </p>
    </div>

    <!-- Responsive SVG Technical Diagram -->
    <div class="w-full overflow-x-auto">
      <div class="min-w-[640px] max-w-4xl mx-auto">
        <svg viewBox="0 0 800 360" class="w-full h-auto font-sans" aria-label={jsI18n.svgAriaLabel}>
          <defs>
            <linearGradient id="nichromeGlow" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#ea580c" stop-opacity="0.9" />
              <stop offset="50%" stop-color="#f97316" stop-opacity="1" />
              <stop offset="100%" stop-color="#ea580c" stop-opacity="0.9" />
            </linearGradient>
            <linearGradient id="breadSliceGradient" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#b45309" stop-opacity="0.95" />
              <stop offset="8%" stop-color="#fef08a" stop-opacity="1" />
              <stop offset="50%" stop-color="#fef9c3" stop-opacity="1" />
              <stop offset="92%" stop-color="#fef08a" stop-opacity="1" />
              <stop offset="100%" stop-color="#b45309" stop-opacity="0.95" />
            </linearGradient>
            <linearGradient id="crumbBedGradient" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#78350f" stop-opacity="0.8" />
