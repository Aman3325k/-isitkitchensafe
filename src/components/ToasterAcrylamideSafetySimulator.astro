      5: { tempC: 184, tempF: 363, timeSec: 200, color: '#9a3412', toneName: 'Deep Chestnut Brown', baseAcrylamide: 490 },
      6: { tempC: 202, tempF: 396, timeSec: 245, color: '#581c87', toneName: 'Dark / Edge Charred', baseAcrylamide: 1150 },
      7: { tempC: 225, tempF: 437, timeSec: 300, color: '#18181b', toneName: 'Carbonized / Blackened Toast', baseAcrylamide: 2950 }
    };

    const THICKNESS_FACTORS: Record<string, { acrylamideFactor: number; timeFactor: number }> = {
      'standard-fresh': { acrylamideFactor: 1.0, timeFactor: 1.0 },
      'thick-artisan': { acrylamideFactor: 1.15, timeFactor: 1.35 },
      'frozen-slice': { acrylamideFactor: 1.35, timeFactor: 1.5 },
      'dense-bagel': { acrylamideFactor: 1.25, timeFactor: 1.4 }
    };

    const CRUMB_TRAY_RISKS: Record<string, { riskScore: number; smoke: string; desc: string }> = {
      'clean-empty': { riskScore: 4, smoke: 'Zero Smoke', desc: 'Clean tray; negligible smoldering fuel bed.' },
      'moderate-buildup': { riskScore: 38, smoke: 'Slight Toasty Odor', desc: 'Trace crumbs dropping onto hot elements; occasional wisps.' },
      'heavy-buildup': { riskScore: 74, smoke: 'Acrid Blue Smoke', desc: 'Heavy lipid glaze; acrolein irritant plume emitted at high heat.' },
      'neglected-critical': { riskScore: 98, smoke: 'Dense Toxic Smoke (CO & PAHs)', desc: 'Critical flare-up fuel; top cause of residential kitchen fires.' }
    };

    function recalculate() {
      if (!elementSelect || !breadSelect || !browningSlider || !thicknessSelect || !crumbTraySelect || !silverwareSelect) return;

      const elementId = elementSelect.value;
      const breadId = breadSelect.value;
      const browningLevel = parseInt(browningSlider.value, 10);
      const thicknessId = thicknessSelect.value;
      const crumbTrayId = crumbTraySelect.value;
      const silverwareState = silverwareSelect.value;

      const breadInfo = BREAD_MULTIPLIERS[breadId] || BREAD_MULTIPLIERS['white-refined-wheat'];
      const browningInfo = BROWNING_LEVEL_DATA[browningLevel] || BROWNING_LEVEL_DATA[3];
      const thicknessInfo = THICKNESS_FACTORS[thicknessId] || THICKNESS_FACTORS['standard-fresh'];
      const crumbInfo = CRUMB_TRAY_RISKS[crumbTrayId] || CRUMB_TRAY_RISKS['clean-empty'];

      // Update Slider Badge
      if (browningBadge) {
        browningBadge.textContent = `Level ${browningLevel} (${browningInfo.toneName.split('(')[0].trim()})`;
      }

      // Calculate Acrylamide (ppb)
      // Base * Bread Multiplier * Thickness/Moisture Factor
      const estimatedAcrylamide = Math.round(
        browningInfo.baseAcrylamide * breadInfo.asparagineMultiplier * thicknessInfo.acrylamideFactor
      );

      // Estimated Time
      const calculatedTime = Math.round(browningInfo.timeSec * thicknessInfo.timeFactor);

      // Update Visuals
      if (toastColorBar) {
        toastColorBar.style.backgroundColor = browningInfo.color;
      }
      if (toastToneName) {
        toastToneName.textContent = browningInfo.toneName;
      }
      if (toastEstTime) {
        toastEstTime.textContent = `${calculatedTime}s`;
      }

      // Update Acrylamide Card
      if (acrylamideVal) {
        acrylamideVal.textContent = estimatedAcrylamide.toLocaleString();
        if (estimatedAcrylamide <= 300) {
          acrylamideVal.className = 'text-2xl font-black text-emerald-700';
        } else if (estimatedAcrylamide <= 750) {
          acrylamideVal.className = 'text-2xl font-black text-amber-600';
        } else {
          acrylamideVal.className = 'text-2xl font-black text-red-600';
        }
      }

      if (acrylamideStatus) {
        if (estimatedAcrylamide <= 300) {
          acrylamideStatus.textContent = '✓ Complies with EFSA Benchmark (≤300 ppb)';
          acrylamideStatus.className = 'text-[11px] text-emerald-700 font-semibold mt-1';
        } else if (estimatedAcrylamide <= 600) {
          acrylamideStatus.textContent = '⚠️ Exceeds EU Benchmark (Moderate Hazard)';
          acrylamideStatus.className = 'text-[11px] text-amber-700 font-semibold mt-1';
        } else {
          acrylamideStatus.textContent = '🚨 Critical Carcinogen Risk (Severely Non-Compliant)';
          acrylamideStatus.className = 'text-[11px] text-red-700 font-semibold mt-1';
        }
      }

      // Update Surface Temperature
      if (surfaceTempVal) {
        surfaceTempVal.textContent = `${browningInfo.tempC}°C`;
      }
      if (maillardStatus) {
        if (browningLevel <= 2) {
          maillardStatus.textContent = 'Mild Early Amadori Phase (<140°C)';
        } else if (browningLevel <= 4) {
          maillardStatus.textContent = 'Optimal Melanoidin & Aroma Phase (150°C–170°C)';
        } else if (browningLevel <= 5) {
          maillardStatus.textContent = 'Advanced Glycation & Crust Desiccation (180°C)';
        } else {
          maillardStatus.textContent = 'Destructive Carbon Pyrolysis & Soot (>200°C)';
        }
      }

      // Update Chromium Risk based on Element Type
      if (chromiumRiskVal && chromiumDesc) {
        if (elementId === 'quartz-infrared-tube') {
          chromiumRiskVal.textContent = 'Zero (Sealed Quartz)';
          chromiumRiskVal.className = 'text-xl font-black text-emerald-700';
          chromiumDesc.textContent = 'Fused silica glass hermetically isolates all alloy vapors.';
        } else if (elementId === 'calrod-metal-sheath') {
          chromiumRiskVal.textContent = 'Negligible (Sheathed)';
          chromiumRiskVal.className = 'text-xl font-black text-emerald-700';
          chromiumDesc.textContent = 'Sub-600°C convection temperatures prevent Cr VI synthesis.';
        } else if (elementId === 'kanthal-fecral') {
          chromiumRiskVal.textContent = 'Low / Passivated';
          chromiumRiskVal.className = 'text-xl font-black text-blue-700';
          chromiumDesc.textContent = 'Dense alpha-alumina ceramic scale blocks chromium migration.';
        } else {
          // Nichrome 80/20
          if (browningLevel >= 6) {
            chromiumRiskVal.textContent = 'Moderate / Thermal Flaking';
            chromiumRiskVal.className = 'text-xl font-black text-amber-700';
            chromiumDesc.textContent = 'Thermal shock cycles shed micro-flakes of oxidized Ni/Cr.';
          } else {
            chromiumRiskVal.textContent = 'Low / Passivated';
            chromiumRiskVal.className = 'text-xl font-black text-emerald-700';
            chromiumDesc.textContent = 'Self-passivating chromia (Cr2O3) scale remains intact.';
          }
        }
      }

      // Crumb Pyrolysis Card
      if (crumbFireVal && crumbFireDesc) {
        crumbFireVal.textContent = `${crumbInfo.riskScore}%`;
        crumbFireDesc.textContent = crumbInfo.desc;
        if (crumbInfo.riskScore < 20) {
          crumbFireVal.className = 'text-2xl font-black text-emerald-700';
        } else if (crumbInfo.riskScore < 60) {
          crumbFireVal.className = 'text-2xl font-black text-amber-600';
        } else {
          crumbFireVal.className = 'text-2xl font-black text-red-600';
        }
      }

      // Smoke Toxicity
      if (smokeVal && smokeDesc) {
        smokeVal.textContent = crumbInfo.smoke;
        if (crumbInfo.riskScore >= 70) {
          smokeVal.className = 'text-lg font-black text-red-600';
          smokeDesc.textContent = 'Acrolein, Carbon Monoxide & mutagenic PAHs generated.';
        } else if (crumbInfo.riskScore >= 30) {
          smokeVal.className = 'text-lg font-black text-amber-600';
          smokeDesc.textContent = 'Moderate VOCs from fallen crumbs on heating wires.';
        } else {
          smokeVal.className = 'text-lg font-black text-ink';
          smokeDesc.textContent = 'Pure radiant convection exhaust with clean tray.';
        }
      }

      // Silverware Shock Hazard
      const isMetalInserted = silverwareState === 'metal-knife-inserted';
      if (shockHazardVal && shockHazardDesc) {
        if (isMetalInserted && (elementId === 'nichrome-80-20' || elementId === 'kanthal-fecral')) {
          shockHazardVal.textContent = '⚡ CRITICAL (LETHAL 120V/240V)';
          shockHazardVal.className = 'text-lg font-black text-red-600 animate-pulse';
          shockHazardDesc.textContent = 'Direct live wire short-circuit! High risk of fatal electrocution.';
        } else if (isMetalInserted && elementId === 'quartz-infrared-tube') {
          shockHazardVal.textContent = 'Moderate (Glass Fracture Risk)';
          shockHazardVal.className = 'text-lg font-black text-amber-600';
          shockHazardDesc.textContent = 'Dielectric quartz tube protects unless smashed by utensil.';
        } else {
          shockHazardVal.textContent = 'Zero (Safe)';
          shockHazardVal.className = 'text-lg font-black text-emerald-700';
          shockHazardDesc.textContent = 'No conductive silverware introduced into live slots.';
        }
      }

      // Calculate Overall Safety Score (0–100)
      let score = 100;

      // Deduct for Acrylamide
      if (estimatedAcrylamide > 2000) score -= 45;
      else if (estimatedAcrylamide > 1000) score -= 32;
      else if (estimatedAcrylamide > 500) score -= 20;
      else if (estimatedAcrylamide > 300) score -= 10;

      // Deduct for Crumb Tray Pyrolysis
      score -= Math.round(crumbInfo.riskScore * 0.35);

      // Deduct for Shock Hazard
      if (isMetalInserted) {
        if (elementId === 'nichrome-80-20' || elementId === 'kanthal-fecral') {
          score = 5; // Instant failure
        } else {
          score -= 30;
        }
      }

      score = Math.max(0, Math.min(100, score));

      if (overallScoreDisplay) {
        overallScoreDisplay.textContent = score.toString();
        if (score >= 80) overallScoreDisplay.className = 'text-4xl font-black text-emerald-700';
        else if (score >= 50) overallScoreDisplay.className = 'text-4xl font-black text-amber-600';
        else overallScoreDisplay.className = 'text-4xl font-black text-red-600';
      }

      if (safetyTierPill) {
        if (score >= 80) {
          safetyTierPill.textContent = 'Optimal Gold Safety';
          safetyTierPill.className = 'px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800';
        } else if (score >= 50) {
          safetyTierPill.textContent = 'Moderate Chemical Exposure';
          safetyTierPill.className = 'px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-100 text-amber-800';
        } else {
          safetyTierPill.textContent = 'Critical Hazard Alert';
          safetyTierPill.className = 'px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-red-100 text-red-800 animate-pulse';
        }
      }

      // Dynamic Alert Banner Logic
      if (alertBanner && alertIcon && alertTitle && alertBody) {
        if (isMetalInserted && (elementId === 'nichrome-80-20' || elementId === 'kanthal-fecral')) {
          alertBanner.className = 'p-5 rounded-2xl border transition-all bg-red-50 border-red-300';
          alertIcon.textContent = '⚡';
          alertTitle.textContent = 'FATAL ELECTROCUTION & ARC FLASH WARNING';
          alertTitle.className = 'text-xs font-bold text-red-900 uppercase tracking-wider mb-1';
          alertBody.textContent = 'NEVER insert a metal knife, fork, or spoon into a plugged-in slot toaster. Classic toasters expose uninsulated 120V/240V Nichrome wires. Conductive contact will trigger an instantaneous arc flash, severe electrical burns, and lethal ventricular fibrillation. Always unplug first!';
        } else if (crumbInfo.riskScore >= 75) {
          alertBanner.className = 'p-5 rounded-2xl border transition-all bg-red-50 border-red-300';
          alertIcon.textContent = '🔥';
          alertTitle.textContent = 'FIRE HAZARD: NEGLECTED CRUMB TRAY PYROLYSIS';
          alertTitle.className = 'text-xs font-bold text-red-900 uppercase tracking-wider mb-1';
          alertBody.textContent = `Deep accumulation of bread crumbs and fat droplets on the bottom tray is undergoing thermal pyrolysis. At heating element radiant temperatures (>600°C), crumb piles auto-ignite into flash fires and emit carcinogenic acrolein, carbon monoxide, and soot. Empty the tray immediately before re-using.`;
        } else if (estimatedAcrylamide > 1500) {
          alertBanner.className = 'p-5 rounded-2xl border transition-all bg-red-50 border-red-300';
          alertIcon.textContent = '🚨';
          alertTitle.textContent = 'CRITICAL TOXICITY: SEVERE ACRYLAMIDE & PYROLYSIS OVERLOAD';
          alertTitle.className = 'text-xs font-bold text-red-900 uppercase tracking-wider mb-1';
          alertBody.textContent = `Acrylamide concentration is estimated at ${estimatedAcrylamide.toLocaleString()} ppb—over 5x the EU 300 ppb safety benchmark. Dark charred crusts also contain polycyclic aromatic hydrocarbons (PAHs). If consumed, thoroughly scrape off all blackened crust with a butter knife over a sink, or discard the slice.`;
        } else if (estimatedAcrylamide > 300) {
          alertBanner.className = 'p-5 rounded-2xl border transition-all bg-amber-50 border-amber-300';
          alertIcon.textContent = '⚠️';
          alertTitle.textContent = 'ELEVATED ACRYLAMIDE: EXCEEDS EFSA BENCHMARK';
          alertTitle.className = 'text-xs font-bold text-amber-900 uppercase tracking-wider mb-1';
          alertBody.textContent = `At Level ${browningLevel}, estimated acrylamide reaches ${estimatedAcrylamide.toLocaleString()} ppb, crossing the European benchmark. Reduce the dial to Level 3 to achieve the optimal 'Go for Gold' light yellow-golden shade.`;
        } else {
          alertBanner.className = 'p-5 rounded-2xl border transition-all bg-emerald-50 border-emerald-300';
          alertIcon.textContent = '✅';
          alertTitle.textContent = 'OPTIMAL SAFETY: EFSA "GO FOR GOLD" METRIC ACHIEVED';
          alertTitle.className = 'text-xs font-bold text-emerald-900 uppercase tracking-wider mb-1';
          alertBody.textContent = `The configured setup operates safely. Acrylamide (${estimatedAcrylamide} ppb) is well below international benchmarks, heating elements operate without spalling, and the clean crumb tray prevents smoldering and fire hazards.`;
        }
      }
    }

    // Attach Event Listeners
    [elementSelect, breadSelect, browningSlider, thicknessSelect, crumbTraySelect, silverwareSelect].forEach(input => {
      if (input) input.addEventListener('input', recalculate);
    });

    // Preset Buttons
    presetButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const p = btn.getAttribute('data-preset');
        if (p === 'optimal-gold') {
          if (elementSelect) elementSelect.value = 'nichrome-80-20';
          if (breadSelect) breadSelect.value = 'white-refined-wheat';
          if (browningSlider) browningSlider.value = '3';
          if (thicknessSelect) thicknessSelect.value = 'standard-fresh';
          if (crumbTraySelect) crumbTraySelect.value = 'clean-empty';
          if (silverwareSelect) silverwareSelect.value = 'safe-unplugged';
        } else if (p === 'sourdough-shield') {
          if (elementSelect) elementSelect.value = 'quartz-infrared-tube';
          if (breadSelect) breadSelect.value = 'artisan-sourdough';
          if (browningSlider) browningSlider.value = '4';
          if (thicknessSelect) thicknessSelect.value = 'thick-artisan';
          if (crumbTraySelect) crumbTraySelect.value = 'clean-empty';
          if (silverwareSelect) silverwareSelect.value = 'safe-unplugged';
        } else if (p === 'crumb-fire') {
          if (elementSelect) elementSelect.value = 'nichrome-80-20';
          if (breadSelect) breadSelect.value = 'brioche-challah';
          if (browningSlider) browningSlider.value = '5';
          if (thicknessSelect) thicknessSelect.value = 'standard-fresh';
          if (crumbTraySelect) crumbTraySelect.value = 'neglected-critical';
          if (silverwareSelect) silverwareSelect.value = 'safe-unplugged';
        } else if (p === 'blackened-rye') {
          if (elementSelect) elementSelect.value = 'nichrome-80-20';
          if (breadSelect) breadSelect.value = 'dark-rye';
          if (browningSlider) browningSlider.value = '7';
          if (thicknessSelect) thicknessSelect.value = 'standard-fresh';
          if (crumbTraySelect) crumbTraySelect.value = 'moderate-buildup';
          if (silverwareSelect) silverwareSelect.value = 'safe-unplugged';
        } else if (p === 'aged-nichrome') {
          if (elementSelect) elementSelect.value = 'nichrome-80-20';
          if (breadSelect) breadSelect.value = 'whole-wheat-100';
          if (browningSlider) browningSlider.value = '6';
          if (thicknessSelect) thicknessSelect.value = 'frozen-slice';
          if (crumbTraySelect) crumbTraySelect.value = 'heavy-buildup';
          if (silverwareSelect) silverwareSelect.value = 'metal-knife-inserted';
        }
        recalculate();
      });
    });

    // Copy Report to Clipboard
    if (copyBtn && copyLabel) {
      copyBtn.addEventListener('click', () => {
        const score = overallScoreDisplay ? overallScoreDisplay.textContent : '92';
        const acrylamide = acrylamideVal ? acrylamideVal.textContent : '120';
        const surfaceT = surfaceTempVal ? surfaceTempVal.textContent : '152°C';
        const crRisk = chromiumRiskVal ? chromiumRiskVal.textContent : 'Low';
        const crumbRisk = crumbFireVal ? crumbFireVal.textContent : '4%';
        const alertText = alertBody ? alertBody.textContent : '';

        const report = `=== IsItKitchenSafe Toaster & Oven Nichrome/Acrylamide Safety Report ===
Overall Safety Score: ${score}/100
Heating Element: ${elementSelect?.selectedOptions[0]?.text || ''}
Bread Type: ${breadSelect?.selectedOptions[0]?.text || ''}
Browning Setting: Level ${browningSlider?.value || 3}
Crust Surface Reaction Temp: ${surfaceT}
Estimated Acrylamide: ${acrylamide} ppb (EFSA Benchmark: 300 ppb)
Chromium VI / Flaking: ${crRisk}
Crumb Tray Fire Risk: ${crumbRisk}
Safety Assessment: ${alertText}
Generated via https://isitkitchensafe.com/tools/toaster-element-acrylamide-safety-simulator/`;

        navigator.clipboard.writeText(report).then(() => {
          const original = copyLabel.textContent;
          copyLabel.textContent = 'Report Copied to Clipboard!';
          setTimeout(() => {
            copyLabel.textContent = original;
          }, 2500);
        });
      });
    }

    // Run initial calculation
    recalculate();
  }

  initToasterSimulator();
  document.addEventListener('astro:page-load', initToasterSimulator);
</script>
