<script define:vars={{ toasterData: localizedData, d, jsI18n, toolUrl }} is:inline>
  function initToasterSimulator() {
    const root = document.getElementById('toaster-safety-modeler');
    if (!root) return;
    if (root.dataset.bound === '1') return;
    root.dataset.bound = '1';

    const elementSelect = root.querySelector('#heating-element-select');
    const breadSelect = root.querySelector('#bread-matrix-select');
    const browningSlider = root.querySelector('#browning-slider');
    const thicknessSelect = root.querySelector('#thickness-select');
    const crumbTraySelect = root.querySelector('#crumb-tray-select');
    const silverwareSelect = root.querySelector('#silverware-select');

    const browningBadge = root.querySelector('#browning-level-badge');
    const overallScoreDisplay = root.querySelector('#overall-score-display');
    const safetyTierPill = root.querySelector('#safety-tier-pill');
    const toastColorBar = root.querySelector('#toast-color-preview-bar');
    const toastToneName = root.querySelector('#toast-tone-name');
    const toastEstTime = root.querySelector('#toast-est-time');

    const acrylamideVal = root.querySelector('#acrylamide-ppb-val');
    const acrylamideStatus = root.querySelector('#acrylamide-status-text');
    const surfaceTempVal = root.querySelector('#surface-temp-val');
    const surfaceTempFVal = root.querySelector('#surface-temp-f-val');
    const maillardStatus = root.querySelector('#maillard-status-text');
    const chromiumRiskVal = root.querySelector('#chromium-risk-val');
    const chromiumDesc = root.querySelector('#chromium-desc-text');
    const crumbFireVal = root.querySelector('#crumb-fire-val');
    const crumbFireDesc = root.querySelector('#crumb-fire-desc');
    const smokeVal = root.querySelector('#smoke-val');
    const smokeDesc = root.querySelector('#smoke-desc');
    const shockHazardVal = root.querySelector('#shock-hazard-val');
    const shockHazardDesc = root.querySelector('#shock-hazard-desc');

    const alertBanner = root.querySelector('#dynamic-alert-banner');
    const alertIcon = root.querySelector('#alert-banner-icon');
    const alertTitle = root.querySelector('#alert-banner-title');
    const alertBody = root.querySelector('#alert-banner-body');

    const presetButtons = root.querySelectorAll('.scenario-preset-btn');
    const copyBtn = root.querySelector('#copy-telemetry-btn');
    const copyLabel = root.querySelector('#copy-btn-label');

    const BREAD_MULTIPLIERS = {
      'white-refined-wheat': { asparagineMultiplier: 1.0 },
      'whole-wheat-100': { asparagineMultiplier: 2.15 },
      'dark-rye': { asparagineMultiplier: 3.25 },
      'artisan-sourdough': { asparagineMultiplier: 0.38 },
      'brioche-challah': { asparagineMultiplier: 1.75 },
      'gluten-free-potato-starch': { asparagineMultiplier: 1.9 }
    };

    const BROWNING_LEVEL_DATA = {
      1: { tempC: 118, tempF: 244, timeSec: 60, color: '#fef9c3', baseAcrylamide: 25 },
      2: { tempC: 136, tempF: 277, timeSec: 90, color: '#fde047', baseAcrylamide: 60 },
      3: { tempC: 152, tempF: 306, timeSec: 125, color: '#eab308', baseAcrylamide: 120 },
      4: { tempC: 168, tempF: 334, timeSec: 160, color: '#ca8a04', baseAcrylamide: 240 },
      5: { tempC: 184, tempF: 363, timeSec: 200, color: '#9a3412', baseAcrylamide: 490 },
      6: { tempC: 202, tempF: 396, timeSec: 245, color: '#581c87', baseAcrylamide: 1150 },
      7: { tempC: 225, tempF: 437, timeSec: 300, color: '#18181b', baseAcrylamide: 2950 }
    };

    const THICKNESS_FACTORS = {
      'standard-fresh': { acrylamideFactor: 1.0, timeFactor: 1.0 },
      'thick-artisan': { acrylamideFactor: 1.15, timeFactor: 1.35 },
      'frozen-slice': { acrylamideFactor: 1.35, timeFactor: 1.5 },
      'dense-bagel': { acrylamideFactor: 1.25, timeFactor: 1.4 }
    };

    const CRUMB_BY_ID = {};
    (toasterData.crumbTrayPyrolysisData || []).forEach(function (item) {
      CRUMB_BY_ID[item.id] = item;
    });

    function recalculate() {
      if (!elementSelect || !breadSelect || !browningSlider || !thicknessSelect || !crumbTraySelect || !silverwareSelect) return;

      const elementId = elementSelect.value;
      const breadId = breadSelect.value;
      const browningLevel = parseInt(browningSlider.value, 10) || 3;
      const thicknessId = thicknessSelect.value;
      const crumbTrayId = crumbTraySelect.value;
      const silverwareState = silverwareSelect.value;

      const breadInfo = BREAD_MULTIPLIERS[breadId] || BREAD_MULTIPLIERS['white-refined-wheat'];
      const browningInfo = BROWNING_LEVEL_DATA[browningLevel] || BROWNING_LEVEL_DATA[3];
      const thicknessInfo = THICKNESS_FACTORS[thicknessId] || THICKNESS_FACTORS['standard-fresh'];
      const crumbInfo = CRUMB_BY_ID[crumbTrayId] || { crumbSmolderRiskScore: 4, smoke: '', desc: '' };
      const toneLabel = (jsI18n.browningTones && jsI18n.browningTones[browningLevel]) || '';

      if (browningBadge) {
        browningBadge.textContent = jsI18n.browningLevelBadgeTpl
          .replace('{lvl}', String(browningLevel))
          .replace('{tone}', toneLabel.split('(')[0].trim());
      }

      const estimatedAcrylamide = Math.round(
        browningInfo.baseAcrylamide * breadInfo.asparagineMultiplier * thicknessInfo.acrylamideFactor
      );
      const calculatedTime = Math.round(browningInfo.timeSec * thicknessInfo.timeFactor);

      if (toastColorBar) toastColorBar.style.backgroundColor = browningInfo.color;
      if (toastToneName) toastToneName.textContent = toneLabel;
      if (toastEstTime) toastEstTime.textContent = calculatedTime + 's';

      if (acrylamideVal) {
        acrylamideVal.textContent = estimatedAcrylamide.toLocaleString();
        if (estimatedAcrylamide <= 180) {
          acrylamideVal.className = 'text-2xl font-black text-emerald-700';
        } else if (estimatedAcrylamide <= 400) {
          acrylamideVal.className = 'text-2xl font-black text-amber-600';
        } else {
          acrylamideVal.className = 'text-2xl font-black text-red-600';
        }
      }

      if (acrylamideStatus) {
        if (estimatedAcrylamide <= 180) {
          acrylamideStatus.textContent = jsI18n.acrylamideSafe;
          acrylamideStatus.className = 'text-[11px] text-emerald-700 font-semibold mt-1';
        } else if (estimatedAcrylamide <= 400) {
          acrylamideStatus.textContent = jsI18n.acrylamideWarn;
          acrylamideStatus.className = 'text-[11px] text-amber-700 font-semibold mt-1';
        } else {
          acrylamideStatus.textContent = jsI18n.acrylamideCrit;
          acrylamideStatus.className = 'text-[11px] text-red-700 font-semibold mt-1';
        }
      }

      if (surfaceTempVal) surfaceTempVal.textContent = browningInfo.tempC + '°C';
      if (surfaceTempFVal) surfaceTempFVal.textContent = '(' + browningInfo.tempF + '°F)';
      if (maillardStatus) {
        if (browningLevel <= 2) maillardStatus.textContent = jsI18n.maillardEarly;
        else if (browningLevel <= 4) maillardStatus.textContent = jsI18n.maillardOptimal;
        else if (browningLevel <= 5) maillardStatus.textContent = jsI18n.maillardAdvanced;
        else maillardStatus.textContent = jsI18n.maillardPyrolysis;
      }

      if (chromiumRiskVal && chromiumDesc) {
        if (elementId === 'quartz-infrared-tube') {
          chromiumRiskVal.textContent = jsI18n.crQuartzVal;
          chromiumRiskVal.className = 'text-xl font-black text-emerald-700';
          chromiumDesc.textContent = jsI18n.crQuartzDesc;
        } else if (elementId === 'calrod-metal-sheath') {
          chromiumRiskVal.textContent = jsI18n.crCalrodVal;
          chromiumRiskVal.className = 'text-xl font-black text-emerald-700';
          chromiumDesc.textContent = jsI18n.crCalrodDesc;
        } else if (elementId === 'kanthal-fecral') {
          chromiumRiskVal.textContent = jsI18n.crKanthalVal;
          chromiumRiskVal.className = 'text-xl font-black text-blue-700';
          chromiumDesc.textContent = jsI18n.crKanthalDesc;
        } else if (browningLevel >= 6) {
          chromiumRiskVal.textContent = jsI18n.crNichromeHighVal;
          chromiumRiskVal.className = 'text-xl font-black text-amber-700';
          chromiumDesc.textContent = jsI18n.crNichromeHighDesc;
        } else {
          chromiumRiskVal.textContent = jsI18n.crNichromeLowVal;
          chromiumRiskVal.className = 'text-xl font-black text-emerald-700';
          chromiumDesc.textContent = jsI18n.crNichromeLowDesc;
        }
      }

      const crumbScore = Number(crumbInfo.crumbSmolderRiskScore || 4);
      if (crumbFireVal && crumbFireDesc) {
        crumbFireVal.textContent = crumbScore + '%';
        crumbFireDesc.textContent = crumbInfo.desc || '';
        if (crumbScore < 20) crumbFireVal.className = 'text-2xl font-black text-emerald-700';
        else if (crumbScore < 60) crumbFireVal.className = 'text-2xl font-black text-amber-600';
        else crumbFireVal.className = 'text-2xl font-black text-red-600';
      }

      if (smokeVal && smokeDesc) {
        smokeVal.textContent = crumbInfo.smoke || '';
        if (crumbScore >= 70) {
          smokeVal.className = 'text-lg font-black text-red-600';
          smokeDesc.textContent = jsI18n.smokeCritDesc;
        } else if (crumbScore >= 30) {
          smokeVal.className = 'text-lg font-black text-amber-600';
          smokeDesc.textContent = jsI18n.smokeWarnDesc;
        } else {
          smokeVal.className = 'text-lg font-black text-ink';
          smokeDesc.textContent = jsI18n.smokeCleanDesc;
        }
      }

      const isMetalInserted = silverwareState === 'metal-knife-inserted';
      if (shockHazardVal && shockHazardDesc) {
        if (isMetalInserted && (elementId === 'nichrome-80-20' || elementId === 'kanthal-fecral')) {
          shockHazardVal.textContent = jsI18n.shockCritVal;
          shockHazardVal.className = 'text-lg font-black text-red-600 animate-pulse';
          shockHazardDesc.textContent = jsI18n.shockCritDesc;
        } else if (isMetalInserted && elementId === 'quartz-infrared-tube') {
          shockHazardVal.textContent = jsI18n.shockModVal;
          shockHazardVal.className = 'text-lg font-black text-amber-600';
          shockHazardDesc.textContent = jsI18n.shockModDesc;
        } else {
          shockHazardVal.textContent = jsI18n.shockSafeVal;
          shockHazardVal.className = 'text-lg font-black text-emerald-700';
          shockHazardDesc.textContent = jsI18n.shockSafeDesc;
        }
      }

      let score = 100;
      if (estimatedAcrylamide > 2000) score -= 45;
      else if (estimatedAcrylamide > 1000) score -= 32;
      else if (estimatedAcrylamide > 400) score -= 20;
      else if (estimatedAcrylamide > 180) score -= 10;

      score -= Math.round(crumbScore * 0.35);

      if (isMetalInserted) {
        if (elementId === 'nichrome-80-20' || elementId === 'kanthal-fecral') {
          score = 5;
        } else {
          score -= 30;
        }
      }

      score = Math.max(0, Math.min(100, score));

      if (overallScoreDisplay) {
        overallScoreDisplay.textContent = String(score);
        if (score >= 80) overallScoreDisplay.className = 'text-4xl font-black text-emerald-700';
        else if (score >= 50) overallScoreDisplay.className = 'text-4xl font-black text-amber-600';
        else overallScoreDisplay.className = 'text-4xl font-black text-red-600';
      }

      if (safetyTierPill) {
        if (score >= 80) {
          safetyTierPill.textContent = jsI18n.tierOptimal;
          safetyTierPill.className = 'px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800';
        } else if (score >= 50) {
          safetyTierPill.textContent = jsI18n.tierModerate;
          safetyTierPill.className = 'px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-100 text-amber-800';
        } else {
          safetyTierPill.textContent = jsI18n.tierCritical;
          safetyTierPill.className = 'px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-red-100 text-red-800 animate-pulse';
        }
      }

      if (alertBanner && alertIcon && alertTitle && alertBody) {
        const ppbFormatted = estimatedAcrylamide.toLocaleString();
        if (isMetalInserted && (elementId === 'nichrome-80-20' || elementId === 'kanthal-fecral')) {
          alertBanner.className = 'p-5 rounded-2xl border transition-all bg-red-50 border-red-300';
          alertIcon.textContent = '⚡';
          alertTitle.textContent = jsI18n.alertShockTitle;
          alertTitle.className = 'text-xs font-bold text-red-900 uppercase tracking-wider mb-1';
          alertBody.textContent = jsI18n.alertShockBody;
        } else if (crumbScore >= 75) {
          alertBanner.className = 'p-5 rounded-2xl border transition-all bg-red-50 border-red-300';
          alertIcon.textContent = '🔥';
          alertTitle.textContent = jsI18n.alertCrumbTitle;
          alertTitle.className = 'text-xs font-bold text-red-900 uppercase tracking-wider mb-1';
          alertBody.textContent = jsI18n.alertCrumbBody;
        } else if (estimatedAcrylamide > 800) {
          alertBanner.className = 'p-5 rounded-2xl border transition-all bg-red-50 border-red-300';
          alertIcon.textContent = '🚨';
          alertTitle.textContent = jsI18n.alertAcrylCritTitle;
          alertTitle.className = 'text-xs font-bold text-red-900 uppercase tracking-wider mb-1';
          alertBody.textContent = jsI18n.alertAcrylCritBodyTpl.replace('{ppb}', ppbFormatted);
        } else if (estimatedAcrylamide > 180) {
          alertBanner.className = 'p-5 rounded-2xl border transition-all bg-amber-50 border-amber-300';
          alertIcon.textContent = '⚠️';
          alertTitle.textContent = jsI18n.alertAcrylWarnTitle;
          alertTitle.className = 'text-xs font-bold text-amber-900 uppercase tracking-wider mb-1';
          alertBody.textContent = jsI18n.alertAcrylWarnBodyTpl
            .replace('{lvl}', String(browningLevel))
            .replace('{ppb}', ppbFormatted);
        } else {
          alertBanner.className = 'p-5 rounded-2xl border transition-all bg-emerald-50 border-emerald-300';
          alertIcon.textContent = '✅';
          alertTitle.textContent = jsI18n.alertOptimalTitle;
          alertTitle.className = 'text-xs font-bold text-emerald-900 uppercase tracking-wider mb-1';
          alertBody.textContent = jsI18n.alertOptimalBodyTpl.replace('{ppb}', ppbFormatted);
        }
      }
    }

    [elementSelect, breadSelect, browningSlider, thicknessSelect, crumbTraySelect, silverwareSelect].forEach(function (input) {
      if (input) input.addEventListener('input', recalculate);
      if (input) input.addEventListener('change', recalculate);
    });

    presetButtons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        const p = btn.getAttribute('data-preset');
        if (p === 'optimal-gold') {
          if (elementSelect) elementSelect.value = 'nichrome-80-20';
          if (breadSelect) breadSelect.value = 'white-refined-wheat';
          if (browningSlider) browningSlider.value = '3';
          if (thicknessSelect) thicknessSelect.value = 'standard-fresh';
          if (crumbTraySelect) crumbTraySelect.value = 'clean-empty';
          if (silverwareSelect) silverwareSelect.value = 'safe-unplugged';
        } else if (p === 'sourdough-shield') {
          if (elementSelect) elementSelect.value = 'quartz-infrared-tube';
          if (breadSelect) breadSelect.value = 'artisan-sourdough';
          if (browningSlider) browningSlider.value = '4';
          if (thicknessSelect) thicknessSelect.value = 'thick-artisan';
          if (crumbTraySelect) crumbTraySelect.value = 'clean-empty';
          if (silverwareSelect) silverwareSelect.value = 'safe-unplugged';
        } else if (p === 'crumb-fire') {
          if (elementSelect) elementSelect.value = 'nichrome-80-20';
          if (breadSelect) breadSelect.value = 'brioche-challah';
          if (browningSlider) browningSlider.value = '5';
          if (thicknessSelect) thicknessSelect.value = 'standard-fresh';
          if (crumbTraySelect) crumbTraySelect.value = 'neglected-critical';
          if (silverwareSelect) silverwareSelect.value = 'safe-unplugged';
        } else if (p === 'blackened-rye') {
          if (elementSelect) elementSelect.value = 'nichrome-80-20';
          if (breadSelect) breadSelect.value = 'dark-rye';
          if (browningSlider) browningSlider.value = '7';
          if (thicknessSelect) thicknessSelect.value = 'standard-fresh';
          if (crumbTraySelect) crumbTraySelect.value = 'moderate-buildup';
          if (silverwareSelect) silverwareSelect.value = 'safe-unplugged';
        } else if (p === 'aged-nichrome') {
          if (elementSelect) elementSelect.value = 'nichrome-80-20';
          if (breadSelect) breadSelect.value = 'whole-wheat-100';
          if (browningSlider) browningSlider.value = '6';
          if (thicknessSelect) thicknessSelect.value = 'frozen-slice';
          if (crumbTraySelect) crumbTraySelect.value = 'heavy-buildup';
          if (silverwareSelect) silverwareSelect.value = 'metal-knife-inserted';
        }
        recalculate();
      });
    });

    if (copyBtn && copyLabel) {
      copyBtn.addEventListener('click', function () {
        const score = overallScoreDisplay ? overallScoreDisplay.textContent : '92';
        const acrylamide = acrylamideVal ? acrylamideVal.textContent : '120';
        const surfaceT = surfaceTempVal ? surfaceTempVal.textContent : '152°C';
        const crRisk = chromiumRiskVal ? chromiumRiskVal.textContent : '';
        const crumbRisk = crumbFireVal ? crumbFireVal.textContent : '4%';
        const alertText = alertBody ? alertBody.textContent : '';

        const report = jsI18n.repHeader + '\n' +
          jsI18n.repScore + ': ' + score + '/100\n' +
          jsI18n.repElement + ': ' + (elementSelect && elementSelect.selectedOptions[0] ? elementSelect.selectedOptions[0].text : '') + '\n' +
          jsI18n.repBread + ': ' + (breadSelect && breadSelect.selectedOptions[0] ? breadSelect.selectedOptions[0].text : '') + '\n' +
          jsI18n.repBrowning + ': ' + (browningBadge ? browningBadge.textContent : (browningSlider ? browningSlider.value : '3')) + '\n' +
          jsI18n.repTemp + ': ' + surfaceT + '\n' +
          jsI18n.repAcrylamide + ': ' + acrylamide + ' ppb (' + jsI18n.repAcrylamideNote + ')\n' +
          jsI18n.repCr + ': ' + crRisk + '\n' +
          jsI18n.repCrumb + ': ' + crumbRisk + '\n' +
          jsI18n.repAssessment + ': ' + alertText + '\n' +
          jsI18n.repSource + ': ' + toolUrl;

        navigator.clipboard.writeText(report).then(function () {
          copyLabel.textContent = d.reportCopied;
          setTimeout(function () {
            copyLabel.textContent = d.copyReportBtn;
          }, 2500);
        });
      });
    }

    recalculate();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initToasterSimulator);
  } else {
    initToasterSimulator();
  }
  document.addEventListener('astro:page-load', initToasterSimulator);
</script>
