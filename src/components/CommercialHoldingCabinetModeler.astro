<!-- Client-Side Reactive Physics Engine -->
<script define:vars={{ cabinetData, d }}>
  document.addEventListener('DOMContentLoaded', () => {
    // Elements
    const cabinetSelect = document.getElementById('cabinetSelect');
    const foodSelect = document.getElementById('foodSelect');
    const waterPanSelect = document.getElementById('waterPanSelect');
    const gasketSelect = document.getElementById('gasketSelect');

    const setpointSlider = document.getElementById('setpointSlider');
    const setpointVal = document.getElementById('setpointVal');

    const durationSlider = document.getElementById('durationSlider');
    const durationVal = document.getElementById('durationVal');

    const doorOpensSlider = document.getElementById('doorOpensSlider');
    const doorOpensVal = document.getElementById('doorOpensVal');

    const ambientRhSlider = document.getElementById('ambientRhSlider');
    const ambientRhVal = document.getElementById('ambientRhVal');

    // Metrics
    const metricCoreTemp = document.getElementById('metricCoreTemp');
    const metricCoreTempC = document.getElementById('metricCoreTempC');
    const badgeCoreTemp = document.getElementById('badgeCoreTemp');

    const metricCavityRh = document.getElementById('metricCavityRh');
    const badgeCavityRh = document.getElementById('badgeCavityRh');

    const metricVpd = document.getElementById('metricVpd');
    const badgeVpd = document.getElementById('badgeVpd');

    const metricMoistureLoss = document.getElementById('metricMoistureLoss');
    const badgeMoistureLoss = document.getElementById('badgeMoistureLoss');

    const metricPanHours = document.getElementById('metricPanHours');
    const metricPanLevel = document.getElementById('metricPanLevel');
    const badgePanStatus = document.getElementById('badgePanStatus');

    const metricSensoryIndex = document.getElementById('metricSensoryIndex');
    const badgeSensoryIndex = document.getElementById('badgeSensoryIndex');

    const pathogenVerdictBadge = document.getElementById('pathogenVerdictBadge');
    const pathogenVerdictText = document.getElementById('pathogenVerdictText');
    const pathogenBanner = document.getElementById('pathogenBanner');

    const complianceVerdictBadge = document.getElementById('complianceVerdictBadge');
    const complianceVerdictText = document.getElementById('complianceVerdictText');
    const complianceBanner = document.getElementById('complianceBanner');

    const mechanismsText = document.getElementById('mechanismsText');
    const mitigationText = document.getElementById('mitigationText');

    const btnCopyReport = document.getElementById('btnCopyReport');
    const copyBtnText = document.getElementById('copyBtnText');

    // Presets
    const btnPresetCompliant = document.getElementById('btnPresetCompliant');
    const btnPresetDesiccation = document.getElementById('btnPresetDesiccation');
    const btnPresetDangerZone = document.getElementById('btnPresetDangerZone');
    const btnPresetUninsulated = document.getElementById('btnPresetUninsulated');

    function calculateDiagnostics() {
      const cabinetId = cabinetSelect.value;
      const foodId = foodSelect.value;
      const waterPanId = waterPanSelect.value;
      const gasketId = gasketSelect.value;

      const setpointF = parseFloat(setpointSlider.value);
      const setpointC = (setpointF - 32) * (5 / 9);

      const durationHours = parseFloat(durationSlider.value);
      const doorOpensPerHour = parseFloat(doorOpensSlider.value);
      const ambientRh = parseFloat(ambientRhSlider.value);

      // Lookups
      const cabinet = cabinetData.cabinetConfigurations.find(c => c.id === cabinetId) || cabinetData.cabinetConfigurations[0];
      const food = cabinetData.foodHoldingItems.find(f => f.id === foodId) || cabinetData.foodHoldingItems[0];
      const waterPan = cabinetData.waterPanModes.find(w => w.id === waterPanId) || cabinetData.waterPanModes[0];
      const gasket = cabinetData.doorGasketConditions.find(g => g.id === gasketId) || cabinetData.doorGasketConditions[0];

      // Update text sliders
      setpointVal.textContent = `${setpointF}°F (${setpointC.toFixed(1)}°C)`;
      durationVal.textContent = `${durationHours.toFixed(1)} Hours`;
      doorOpensVal.textContent = `${doorOpensPerHour} Opens / Hour`;
      ambientRhVal.textContent = `${ambientRh}% RH`;

      // 1. Thermal Degradation & Infiltration Calculation
      // Sensor drift on legacy models
      let sensorBiasC = 0.0;
      if (cabinetId === 'legacy_uncalibrated_institutional_cabinet') {
        sensorBiasC = -5.5; // -10°F actual colder than dial
      }

      // Heat loss from door openings & gasket leakage
      const gasketLeakagePenaltyC = (1.0 - gasket.thermalEfficiency) * 8.0;
      const doorOpenLossC = doorOpensPerHour * (gasket.temperatureLossPerDoorOpenC * 0.35);
      const insulationLossC = cabinet.insulationType.includes('Uninsulated') ? 6.5 : (cabinet.insulationType.includes('Deteriorated') ? 4.2 : 0.8);

      const actualAirTempC = Math.max(35.0, setpointC + sensorBiasC - gasketLeakagePenaltyC - (doorOpenLossC * 0.4) - insulationLossC);
      const actualAirTempF = (actualAirTempC * 9 / 5) + 32;

      // 2. Relative Humidity & Water Pan Depletion
      const waterPanInitialLiters = waterPan.panWaterLiters;
      const hourlyEvaporationLiters = (waterPan.evaporationRateGPerHour / 1000) * (actualAirTempC / 60.0);
      const waterRemainingLiters = Math.max(0.0, waterPanInitialLiters - (hourlyEvaporationLiters * durationHours));
      const hoursUntilDry = hourlyEvaporationLiters > 0 ? (waterPanInitialLiters / hourlyEvaporationLiters) : 0.0;

      let effectiveRh = waterPan.rhBaselinePercent;
      if (waterRemainingLiters <= 0.0 && waterPanInitialLiters > 0) {
        effectiveRh = 20.0; // Dropped to dry pan state
      }

      // Air exchange dilution from door opens
      const rhDilution = (doorOpensPerHour * 0.8);
      effectiveRh = Math.max(12.0, Math.min(95.0, effectiveRh - rhDilution + (ambientRh * 0.15)));

      // 3. Vapor Pressure Deficit (VPD in kPa)
      // Saturation vapor pressure formula: e_s(T) = 0.61078 * exp((17.27 * T) / (T + 237.3))
      const e_sat_food = 0.61078 * Math.exp((17.27 * actualAirTempC) / (actualAirTempC + 237.3));
      const e_actual_air = e_sat_food * (effectiveRh / 100.0);
      const vpdKpa = Math.max(0.05, e_sat_food - e_actual_air);

      // 4. Food Desiccation & Moisture Loss
      const desiccationRatePerHour = (vpdKpa * 0.85) * (food.surfaceAreaToMassRatio / 2.0);
      const cumulativeMoistureLossPercent = Math.min(35.0, desiccationRatePerHour * durationHours);

      // 5. Core Food Temperature (accounting for evaporative cooling ΔT)
      const evaporativeCoolingC = vpdKpa * 0.95;
      const coreTempC = Math.max(actualAirTempC - evaporativeCoolingC - (cabinet.temperatureUniformityDeltaC * 0.5), 32.0);
      const coreTempF = (coreTempC * 9 / 5) + 32;

      // 6. Sensory Quality Index (0 to 100)
      let sensoryScore = 100.0 - (cumulativeMoistureLossPercent * 3.8);
      if (durationHours > 3.0) sensoryScore -= (durationHours - 3.0) * 4.5;
      if (coreTempF < 138.0) sensoryScore -= 15.0;
      sensoryScore = Math.max(10, Math.min(100, Math.round(sensoryScore)));

      // Render Primary Metrics
      metricCoreTemp.textContent = `${coreTempF.toFixed(1)}°F`;
      metricCoreTempC.textContent = `(${coreTempC.toFixed(1)}°C)`;
      if (coreTempF >= 140.0) {
        metricCoreTemp.className = 'text-xl sm:text-2xl font-bold font-mono text-emerald-600 dark:text-emerald-400';
        badgeCoreTemp.className = 'inline-block px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-emerald-500/10 text-emerald-600';
        badgeCoreTemp.textContent = 'PASS ≥140°F';
      } else if (coreTempF >= 135.0) {
        metricCoreTemp.className = 'text-xl sm:text-2xl font-bold font-mono text-amber-600 dark:text-amber-400';
        badgeCoreTemp.className = 'inline-block px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-amber-500/10 text-amber-600';
        badgeCoreTemp.textContent = 'MARGINAL ≥135°F';
      } else {
        metricCoreTemp.className = 'text-xl sm:text-2xl font-bold font-mono text-rose-600 dark:text-rose-400';
        badgeCoreTemp.className = 'inline-block px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-rose-500/10 text-rose-600';
        badgeCoreTemp.textContent = 'BREACH <135°F';
      }

      metricCavityRh.textContent = `${effectiveRh.toFixed(0)}% RH`;
      if (effectiveRh >= 60.0) {
        badgeCavityRh.className = 'inline-block px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-emerald-500/10 text-emerald-600';
        badgeCavityRh.textContent = 'OPTIMAL RH';
      } else if (effectiveRh >= 40.0) {
        badgeCavityRh.className = 'inline-block px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-amber-500/10 text-amber-600';
        badgeCavityRh.textContent = 'MODERATE RH';
      } else {
        badgeCavityRh.className = 'inline-block px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-rose-500/10 text-rose-600';
        badgeCavityRh.textContent = 'DRY AIR';
      }

      metricVpd.textContent = `${vpdKpa.toFixed(2)} kPa`;
      if (vpdKpa < 1.0) {
        badgeVpd.className = 'inline-block px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-emerald-500/10 text-emerald-600';
        badgeVpd.textContent = 'LOW FLUX';
      } else if (vpdKpa < 2.0) {
        badgeVpd.className = 'inline-block px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-amber-500/10 text-amber-600';
        badgeVpd.textContent = 'MODERATE FLUX';
      } else {
        badgeVpd.className = 'inline-block px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-rose-500/10 text-rose-600';
        badgeVpd.textContent = 'RAPID EVAP';
      }

      metricMoistureLoss.textContent = `${cumulativeMoistureLossPercent.toFixed(1)}%`;
      if (cumulativeMoistureLossPercent <= food.criticalDesiccationThreshold * 0.6) {
        badgeMoistureLoss.className = 'inline-block px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-emerald-500/10 text-emerald-600';
        badgeMoistureLoss.textContent = 'SUCCULENT';
      } else if (cumulativeMoistureLossPercent <= food.criticalDesiccationThreshold) {
        badgeMoistureLoss.className = 'inline-block px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-amber-500/10 text-amber-600';
        badgeMoistureLoss.textContent = 'MODERATE LOSS';
      } else {
        badgeMoistureLoss.className = 'inline-block px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-rose-500/10 text-rose-600';
        badgeMoistureLoss.textContent = 'LEATHERY / CRUST';
      }

      if (waterPanId === 'active_controlled_humidity') {
        metricPanHours.textContent = 'Continuous';
        metricPanLevel.textContent = 'Auto Solenoid';
        badgePanStatus.className = 'inline-block px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-emerald-500/10 text-emerald-600';
        badgePanStatus.textContent = 'CONTINUOUS';
      } else if (waterRemainingLiters > 0) {
        metricPanHours.textContent = `${hoursUntilDry.toFixed(1)}h Left`;
        metricPanLevel.textContent = `${waterRemainingLiters.toFixed(1)}L / ${waterPanInitialLiters.toFixed(1)}L`;
        badgePanStatus.className = 'inline-block px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-emerald-500/10 text-emerald-600';
        badgePanStatus.textContent = 'CHARGED';
      } else {
        metricPanHours.textContent = 'DEPLETED';
        metricPanLevel.textContent = '0.0L (Dry-Out)';
        badgePanStatus.className = 'inline-block px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-rose-500/10 text-rose-600';
        badgePanStatus.textContent = 'DRY WELL';
      }

      metricSensoryIndex.textContent = `${sensoryScore} / 100`;
      if (sensoryScore >= 80) {
        metricSensoryIndex.className = 'text-xl sm:text-2xl font-bold font-mono text-emerald-600 dark:text-emerald-400';
        badgeSensoryIndex.className = 'inline-block px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-emerald-500/10 text-emerald-600';
        badgeSensoryIndex.textContent = 'EXCELLENT';
      } else if (sensoryScore >= 60) {
        metricSensoryIndex.className = 'text-xl sm:text-2xl font-bold font-mono text-amber-600 dark:text-amber-400';
        badgeSensoryIndex.className = 'inline-block px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-amber-500/10 text-amber-600';
        badgeSensoryIndex.textContent = 'ACCEPTABLE';
      } else {
        metricSensoryIndex.className = 'text-xl sm:text-2xl font-bold font-mono text-rose-600 dark:text-rose-400';
        badgeSensoryIndex.className = 'inline-block px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-rose-500/10 text-rose-600';
        badgeSensoryIndex.textContent = 'STALE / TOUGH';
      }

      // Render Verdicts & Regulatory Banners
      if (coreTempF >= 140.0) {
        pathogenBanner.className = 'border border-emerald-500/30 bg-emerald-500/10 rounded-2xl p-4 sm:p-5 flex items-start gap-3';
        pathogenVerdictBadge.className = 'text-xs font-mono font-bold text-emerald-600 dark:text-emerald-400';
        pathogenVerdictBadge.textContent = 'SAFE: VEGETATIVE & SPORE REPLICATION SUPPRESSED';
        pathogenVerdictText.textContent = `Core food temperature is maintained at ${coreTempF.toFixed(1)}°F (≥140°F / 60°C), completely blocking vegetative outgrowth of C. perfringens, S. aureus, and B. cereus. Reminder: Hot holding cannot denature pre-formed heat-stable enterotoxin SEA if food was mishandled prior to loading.`;
      } else if (coreTempF >= 135.0) {
        pathogenBanner.className = 'border border-amber-500/30 bg-amber-500/10 rounded-2xl p-4 sm:p-5 flex items-start gap-3';
        pathogenVerdictBadge.className = 'text-xs font-mono font-bold text-amber-600 dark:text-amber-400';
        pathogenVerdictBadge.textContent = 'CAUTION: MARGINAL HOLDING TEMPERATURE (135°F–139°F)';
        pathogenVerdictText.textContent = `Food core temperature (${coreTempF.toFixed(1)}°F) meets the bare legal minimum under FDA § 3-501.16 but provides zero safety buffer against convective air drafts during service. Bottom pan corners may drop into the pathogen replication danger zone.`;
      } else {
        pathogenBanner.className = 'border border-rose-500/30 bg-rose-500/10 rounded-2xl p-4 sm:p-5 flex items-start gap-3';
        pathogenVerdictBadge.className = 'text-xs font-mono font-bold text-rose-600 dark:text-rose-400';
        pathogenVerdictBadge.textContent = 'CRITICAL DANGER: PATHOGEN DANGER ZONE BREACH (<135°F)';
        pathogenVerdictText.textContent = `CRITICAL FOOD SAFETY HAZARD: Core temperature dropped to ${coreTempF.toFixed(1)}°F (${coreTempC.toFixed(1)}°C). Under FDA Food Code § 3-501.16, food held below 135°F for >2 hours must be discarded. Clostridium perfringens doubling time is <10 minutes at 110°F–117°F; Staph enterotoxin accumulates rapidly.`;
      }

      // Compliance verdict
      const isNsfCompliant = actualAirTempF >= 150.0 && cabinet.doorRecoveryTimeMin <= 15.0 && gasket.thermalEfficiency >= 0.80;
      const isFdaCompliant = coreTempF >= 135.0;

      if (isNsfCompliant && isFdaCompliant) {
        complianceBanner.className = 'border border-blue-500/30 bg-blue-500/10 rounded-2xl p-4 sm:p-5 flex items-start gap-3';
        complianceVerdictBadge.className = 'text-xs font-mono font-bold text-blue-600 dark:text-blue-400';
        complianceVerdictBadge.textContent = 'FULL COMPLIANCE: FDA § 3-501.16 & NSF/ANSI STANDARD 4';
        complianceVerdictText.textContent = `Cabinet air is maintained at ${actualAirTempF.toFixed(1)}°F (≥150°F / 65.6°C) and door recovery is rated at ${cabinet.doorRecoveryTimeMin} min (≤15 min limit under NSF 4 § 5.2.1). Cavity temperature uniformity is within ±${(cabinet.temperatureUniformityDeltaC * 1.8).toFixed(1)}°F.`;
      } else if (isFdaCompliant && !isNsfCompliant) {
        complianceBanner.className = 'border border-amber-500/30 bg-amber-500/10 rounded-2xl p-4 sm:p-5 flex items-start gap-3';
        complianceVerdictBadge.className = 'text-xs font-mono font-bold text-amber-600 dark:text-amber-400';
        complianceVerdictBadge.textContent = 'PARTIAL COMPLIANCE: MEETS FDA FOOD CODE, FAILS NSF/ANSI 4';
        complianceVerdictText.textContent = `Food is temporarily above the 135°F minimum, but cabinet air (${actualAirTempF.toFixed(1)}°F) or recovery performance fails NSF/ANSI Standard 4 engineering specifications. High risk of non-uniform pan temperatures during high-volume service.`;
      } else {
        complianceBanner.className = 'border border-rose-500/30 bg-rose-500/10 rounded-2xl p-4 sm:p-5 flex items-start gap-3';
        complianceVerdictBadge.className = 'text-xs font-mono font-bold text-rose-600 dark:text-rose-400';
        complianceVerdictBadge.textContent = 'REGULATORY VIOLATION: FDA § 3-501.16 & NSF 4 BREACH';
        complianceVerdictText.textContent = `IMMEDIATE REGULATORY CITATION: Core temperature (${coreTempF.toFixed(1)}°F) fails FDA Food Code § 3-501.16(A)(1). The enclosure fails NSF/ANSI 4 holding uniformity standards. Suspend service immediately.`;
      }

      // Mechanisms narrative update
      mechanismsText.textContent = `In this configuration, effective cavity RH is ${effectiveRh.toFixed(0)}%, resulting in a vapor pressure deficit of ${vpdKpa.toFixed(2)} kPa. Over ${durationHours} hours of holding with ${doorOpensPerHour} door openings/hr, cumulative moisture loss reaches ${cumulativeMoistureLossPercent.toFixed(1)}% (critical limit: ${food.criticalDesiccationThreshold}%). ${cumulativeMoistureLossPercent > food.criticalDesiccationThreshold ? 'Surface desiccation has exceeded palatable limits, producing leathery skin or dried gravy crusts.' : 'Moisture migration remains well-buffered within acceptable culinary quality margins.'}`;

      mitigationText.textContent = `1. Set thermostat to at least 150°F (65.6°C) to compensate for ${gasketLeakagePenaltyC > 2 ? 'excessive gasket seal leakage' : 'convective air cooling'}.\n2. ${waterPanId === 'depleted_dry_water_pan' || waterRemainingLiters <= 0 ? 'CRITICAL: Replenish the dry water pan immediately to prevent aggressive surface dehydration.' : 'Monitor water reservoir levels and replenish prior to mid-shift depletion.'}\n3. ${doorOpensPerHour > 12 ? 'Excessive door openings (' + doorOpensPerHour + '/hr) are stripping cavity sensible heat; batch pan retrieval to reduce door dwell time.' : 'Maintain current door service discipline.'}`;
    }

    // Attach listeners
    cabinetSelect.addEventListener('change', calculateDiagnostics);
    foodSelect.addEventListener('change', calculateDiagnostics);
    waterPanSelect.addEventListener('change', calculateDiagnostics);
    gasketSelect.addEventListener('change', calculateDiagnostics);

    setpointSlider.addEventListener('input', calculateDiagnostics);
    durationSlider.addEventListener('input', calculateDiagnostics);
    doorOpensSlider.addEventListener('input', calculateDiagnostics);
    ambientRhSlider.addEventListener('input', calculateDiagnostics);

    // Preset Buttons
    btnPresetCompliant.addEventListener('click', () => {
      cabinetSelect.value = 'insulated_pass_through_banquet';
      foodSelect.value = 'rotisserie_roast_poultry';
      waterPanSelect.value = 'active_controlled_humidity';
      gasketSelect.value = 'airtight_magnetic_santoprene';
      setpointSlider.value = '150';
      durationSlider.value = '3.0';
      doorOpensSlider.value = '6';
      ambientRhSlider.value = '50';
      calculateDiagnostics();
    });

    btnPresetDesiccation.addEventListener('click', () => {
      cabinetSelect.value = 'insulated_pass_through_banquet';
      foodSelect.value = 'braised_carved_beef_brisket';
      waterPanSelect.value = 'depleted_dry_water_pan';
      gasketSelect.value = 'airtight_magnetic_santoprene';
      setpointSlider.value = '160';
      durationSlider.value = '4.5';
      doorOpensSlider.value = '10';
      ambientRhSlider.value = '35';
      calculateDiagnostics();
    });

    btnPresetDangerZone.addEventListener('click', () => {
      cabinetSelect.value = 'legacy_uncalibrated_institutional_cabinet';
      foodSelect.value = 'baked_macaroni_and_cheese';
      waterPanSelect.value = 'depleted_dry_water_pan';
      gasketSelect.value = 'torn_cracked_warped_door';
      setpointSlider.value = '132';
      durationSlider.value = '4.0';
      doorOpensSlider.value = '14';
      ambientRhSlider.value = '40';
      calculateDiagnostics();
    });

    btnPresetUninsulated.addEventListener('click', () => {
      cabinetSelect.value = 'uninsulated_mobile_transport_cabinet';
      foodSelect.value = 'crisp_pork_carnitas_pulled_pork';
      waterPanSelect.value = 'passive_filled_water_pan';
      gasketSelect.value = 'minor_wear_compression_set';
      setpointSlider.value = '145';
      durationSlider.value = '3.5';
      doorOpensSlider.value = '18';
      ambientRhSlider.value = '45';
      calculateDiagnostics();
    });

    // Copy Report Button
    btnCopyReport.addEventListener('click', () => {
      const report = `======================================================================
ISITKITCHENSAFE COMMERCIAL HOLDING CABINET AUDIT REPORT
======================================================================
Date: ${new Date().toISOString()}
Cabinet Architecture: ${cabinetSelect.options[cabinetSelect.selectedIndex].text}
Held Food Item: ${foodSelect.options[foodSelect.selectedIndex].text}
Humidity System: ${waterPanSelect.options[waterPanSelect.selectedIndex].text}
Door Gasket Seal: ${gasketSelect.options[gasketSelect.selectedIndex].text}

THERMAL & PSYCHROMETRIC TELEMETRY:
- Air Setpoint: ${setpointSlider.value}°F
- Calculated Core Food Temp: ${metricCoreTemp.textContent} ${metricCoreTempC.textContent}
- Cavity Relative Humidity: ${metricCavityRh.textContent}
- Vapor Pressure Deficit (VPD): ${metricVpd.textContent}
- Cumulative Surface Moisture Loss: ${metricMoistureLoss.textContent}
- Water Pan Status: ${metricPanHours.textContent} (${metricPanLevel.textContent})
- Sensory & Texture Score: ${metricSensoryIndex.textContent}

REGULATORY & MICROBIOLOGICAL STATUS:
- Pathogen Verdict: ${pathogenVerdictBadge.textContent}
- Regulatory Compliance: ${complianceVerdictBadge.textContent}
- FDA Food Code § 3-501.16: ${parseFloat(metricCoreTemp.textContent) >= 135 ? 'PASS' : 'VIOLATION'}
- NSF/ANSI Standard 4: ${complianceVerdictBadge.textContent.includes('FULL') ? 'COMPLIANT' : 'NON-COMPLIANT'}

ENGINEERING DIRECTIVES:
${mitigationText.textContent}
======================================================================`;

      navigator.clipboard.writeText(report).then(() => {
        copyBtnText.textContent = d.copiedFeedback;
        setTimeout(() => {
          copyBtnText.textContent = d.copyReportBtn;
        }, 3000);
      });
    });

    // Initial calculation
    calculateDiagnostics();
  });
</script>
