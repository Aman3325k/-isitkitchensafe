const d = DICTIONARY[lang];
---

<div class="bg-surface-card border border-hairline rounded-3xl p-6 sm:p-10 shadow-sm mb-12">
  <!-- Header -->
  <div class="mb-8">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold uppercase tracking-wider bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20 mb-4">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
      </svg>
      {d.badge}
    </div>
    <h2 class="text-title-xl sm:text-headline-sm font-bold text-ink tracking-tight mb-3">
      {d.title}
    </h2>
    <p class="text-body text-muted leading-relaxed max-w-4xl text-sm sm:text-base">
      {d.subtitle}
    </p>
  </div>

  <!-- Presets Bar -->
  <div class="bg-surface-soft border border-hairline/80 rounded-2xl p-4 sm:p-5 mb-8">
    <div class="text-xs font-bold text-ink uppercase tracking-wider mb-3 flex items-center gap-2">
      <svg class="w-4 h-4 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
      </svg>
      {d.presetsTitle}
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5">
      <button 
        type="button" 
        id="btnPresetCompliant"
        class="text-left p-3 rounded-xl border border-emerald-500/30 bg-emerald-500/5 hover:bg-emerald-500/10 transition-colors text-xs font-medium text-ink flex flex-col justify-between"
      >
        <span class="font-bold text-emerald-600 dark:text-emerald-400 mb-1">✓ {d.presetCompliant.split('(')[0]}</span>
        <span class="text-muted text-[11px] leading-tight">{d.presetCompliant.includes('(') ? '(' + d.presetCompliant.split('(')[1] : ''}</span>
      </button>

      <button 
        type="button" 
        id="btnPresetDesiccation"
        class="text-left p-3 rounded-xl border border-amber-500/30 bg-amber-500/5 hover:bg-amber-500/10 transition-colors text-xs font-medium text-ink flex flex-col justify-between"
      >
        <span class="font-bold text-amber-600 dark:text-amber-400 mb-1">⚠ {d.presetDesiccation.split('(')[0]}</span>
        <span class="text-muted text-[11px] leading-tight">{d.presetDesiccation.includes('(') ? '(' + d.presetDesiccation.split('(')[1] : ''}</span>
      </button>

      <button 
        type="button" 
        id="btnPresetDangerZone"
        class="text-left p-3 rounded-xl border border-rose-500/30 bg-rose-500/5 hover:bg-rose-500/10 transition-colors text-xs font-medium text-ink flex flex-col justify-between"
      >
        <span class="font-bold text-rose-600 dark:text-rose-400 mb-1">🚨 {d.presetDangerZone.split('(')[0]}</span>
        <span class="text-muted text-[11px] leading-tight">{d.presetDangerZone.includes('(') ? '(' + d.presetDangerZone.split('(')[1] : ''}</span>
      </button>

      <button 
        type="button" 
        id="btnPresetUninsulated"
        class="text-left p-3 rounded-xl border border-purple-500/30 bg-purple-500/5 hover:bg-purple-500/10 transition-colors text-xs font-medium text-ink flex flex-col justify-between"
      >
        <span class="font-bold text-purple-600 dark:text-purple-400 mb-1">⚡ {d.presetUninsulatedMobile.split('(')[0]}</span>
        <span class="text-muted text-[11px] leading-tight">{d.presetUninsulatedMobile.includes('(') ? '(' + d.presetUninsulatedMobile.split('(')[1] : ''}</span>
      </button>
    </div>
  </div>

  <!-- Interactive Controls Form -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-10">
    <!-- Left Column: Hardware & Food Selection -->
    <div class="space-y-6">
      <div>
        <label for="cabinetSelect" class="block text-sm font-semibold text-ink mb-1">
          {d.cabinetLabel}
        </label>
        <select 
          id="cabinetSelect"
          class="w-full bg-surface-soft border border-hairline rounded-xl px-3.5 py-2.5 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-amber-500 transition-all"
        >
          {cabinetData.cabinetConfigurations.map(c => (
            <option value={c.id}>{c.name}</option>
          ))}
        </select>
        <p class="text-xs text-muted mt-1.5">{d.cabinetHelp}</p>
      </div>

      <div>
        <label for="foodSelect" class="block text-sm font-semibold text-ink mb-1">
          {d.foodLabel}
        </label>
        <select 
          id="foodSelect"
          class="w-full bg-surface-soft border border-hairline rounded-xl px-3.5 py-2.5 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-amber-500 transition-all"
        >
          {cabinetData.foodHoldingItems.map(f => (
            <option value={f.id}>{f.name}</option>
          ))}
        </select>
        <p class="text-xs text-muted mt-1.5">{d.foodHelp}</p>
      </div>

      <div>
        <label for="waterPanSelect" class="block text-sm font-semibold text-ink mb-1">
          {d.waterPanLabel}
        </label>
        <select 
          id="waterPanSelect"
          class="w-full bg-surface-soft border border-hairline rounded-xl px-3.5 py-2.5 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-amber-500 transition-all"
        >
          {cabinetData.waterPanModes.map(w => (
            <option value={w.id}>{w.name}</option>
          ))}
        </select>
        <p class="text-xs text-muted mt-1.5">{d.waterPanHelp}</p>
      </div>

      <div>
        <label for="gasketSelect" class="block text-sm font-semibold text-ink mb-1">
          {d.gasketLabel}
        </label>
        <select 
          id="gasketSelect"
          class="w-full bg-surface-soft border border-hairline rounded-xl px-3.5 py-2.5 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-amber-500 transition-all"
        >
          {cabinetData.doorGasketConditions.map(g => (
