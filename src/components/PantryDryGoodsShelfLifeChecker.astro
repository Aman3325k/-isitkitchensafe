---

<div class="pantry-checker-container max-w-5xl mx-auto" data-lang={lang}>
  <!-- Myth Fact Banner -->
  <section class="bg-amber-500/10 border-2 border-amber-600/40 rounded-xl p-5 mb-8 shadow-sm">
    <div class="flex items-start gap-3.5">
      <span class="text-2xl shrink-0" aria-hidden="true">💡</span>
      <div class="space-y-1.5">
        <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full text-xs font-bold tracking-wide uppercase bg-amber-600 text-white">
          {mythBanner.badge}
        </div>
        <h2 class="text-base sm:text-lg font-bold text-ink leading-snug">
          {mythBanner.headline}
        </h2>
        <p class="text-xs sm:text-sm text-muted leading-relaxed">
          {mythBanner.body}
        </p>
      </div>
    </div>
  </section>

  <!-- View Mode Tabs -->
  <div class="flex flex-wrap items-center justify-center gap-2 mb-8 print:hidden" role="tablist" aria-label="Pantry Safety Tool Views">
    <button
      type="button"
      id="tab-staples"
      class="tab-btn active px-4 py-2.5 rounded-lg text-sm font-semibold transition-all cursor-pointer border border-signature-coral bg-signature-coral text-white shadow-sm flex items-center gap-2"
      role="tab"
      aria-selected="true"
      aria-controls="view-staples"
    >
      <span aria-hidden="true">🌾</span>
      <span>{str.viewModeStaples}</span>
    </button>
    <button
      type="button"
      id="tab-can-triage"
      class="tab-btn px-4 py-2.5 rounded-lg text-sm font-semibold transition-all cursor-pointer border border-hairline bg-surface-soft text-ink hover:bg-surface-strong/50 flex items-center gap-2"
      role="tab"
      aria-selected="false"
      aria-controls="view-can-triage"
    >
      <span aria-hidden="true">🥫</span>
      <span>{str.viewModeCanTriage}</span>
    </button>
    <button
      type="button"
      id="tab-freshness"
      class="tab-btn px-4 py-2.5 rounded-lg text-sm font-semibold transition-all cursor-pointer border border-hairline bg-surface-soft text-ink hover:bg-surface-strong/50 flex items-center gap-2"
      role="tab"
      aria-selected="false"
      aria-controls="view-freshness"
    >
      <span aria-hidden="true">🫧</span>
      <span>{str.viewModeFreshness}</span>
    </button>
  </div>

  <!-- VIEW 1: STAPLES DIRECTORY -->
  <div id="view-staples" class="tool-view block" role="tabpanel" aria-labelledby="tab-staples">
    <!-- Search & Filter Controls -->
    <div class="bg-surface-soft border border-hairline rounded-xl p-4 sm:p-5 mb-6 shadow-2xs space-y-4 print:hidden">
      <div class="relative">
        <input
          type="search"
          id="pantry-search-input"
          class="w-full pl-10 pr-4 py-2.5 bg-canvas border border-hairline rounded-lg text-sm text-ink placeholder-muted focus:outline-none focus:ring-2 focus:ring-primary transition-all"
          placeholder={str.searchPlaceholder}
          aria-label={str.searchPlaceholder}
        />
        <svg class="w-5 h-5 text-muted absolute left-3 top-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>

      <!-- Category Filter Pills -->
      <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Category Filters">
        {localizedCategories.map((cat, idx) => (
          <button
            type="button"
            class={`category-filter-btn px-3 py-1.5 rounded-full text-xs font-medium border transition-colors cursor-pointer ${
              idx === 0
                ? 'bg-ink text-white border-ink'
                : 'bg-canvas text-ink border-hairline hover:border-border-strong'
            }`}
            data-category={cat.id}
          >
            {cat.label}
          </button>
        ))}
      </div>
    </div>

    <!-- Active Count -->
    <div class="flex flex-wrap items-center justify-between gap-2 text-xs text-muted mb-4 px-1 print:hidden">
      <span
        id="results-count-text"
        data-prefix={str.showingPrefix}
        data-suffix={str.showingSuffix}
      >
        {str.showingPrefix}{localizedStaples.length}{str.showingSuffix}
      </span>
      <div class="flex items-center gap-3">
        <button
          id="copy-summary-btn"
          type="button"
          class="text-link hover:underline font-medium inline-flex items-center gap-1 cursor-pointer"
          data-copy-prefix={str.copySummaryPrefix}
          data-copied-label={str.copiedLabel}
        >
          📋 {str.shareBtn}
        </button>
        <button id="print-pantry-btn" type="button" class="text-link hover:underline font-medium inline-flex items-center gap-1 cursor-pointer">
          🖨️ {str.printBtn}
        </button>
      </div>
    </div>

    <!-- Staples Grid -->
    <div id="staples-cards-grid" class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {localizedStaples.map((staple) => (
        <article
          class="staple-card bg-surface-soft border border-hairline hover:border-border-strong rounded-xl p-5 flex flex-col justify-between transition-all shadow-2xs"
          data-category={staple.category}
          data-keywords={staple.keywords}
        >
          <div>
            <div class="flex items-start justify-between gap-3 mb-3">
              <div class="flex items-center gap-2.5">
                <span class="text-2xl p-2 rounded-lg bg-canvas border border-hairline" aria-hidden="true">{staple.icon}</span>
                <div>
                  <h3 class="text-base font-bold text-ink leading-snug">{staple.name}</h3>
                  <span class="text-xs text-muted block">{staple.categoryLabel}</span>
                </div>
              </div>

              {staple.verdictType === 'indefinite' && (
                <span class="shrink-0 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-emerald-700 text-white">
                  ✓ {str.verdictIndefinite}
                </span>
              )}
              {staple.verdictType === 'quality-only' && (
                <span class="shrink-0 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-sky-700 text-white">
                  ℹ {str.verdictQualityOnly}
                </span>
              )}
              {staple.verdictType === 'refrigerate-opened' && (
                <span class="shrink-0 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-amber-700 text-white">
                  ❄️ {str.verdictRefrigerateOpened}
                </span>
              )}
              {staple.verdictType === 'spoils-easily' && (
                <span class="shrink-0 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-amber-700 text-white">
                  ⚠ {str.verdictSpoilsEasily}
                </span>
              )}
            </div>

            <!-- Shelf Life Box -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 bg-canvas border border-hairline rounded-lg p-3 text-xs mb-3">
              <div>
                <span class="font-bold text-ink block mb-0.5">{str.unopenedLabel}:</span>
                <span class="text-muted leading-relaxed">{staple.unopened}</span>
              </div>
              <div>
                <span class="font-bold text-ink block mb-0.5">{str.openedLabel}:</span>
                <span class="text-muted leading-relaxed">{staple.opened}</span>
              </div>
            </div>

            <!-- Verdict Note -->
            <p class="text-xs text-ink/90 leading-relaxed mb-3">
              <strong class="text-ink font-semibold">{str.verdictLabel}</strong> {staple.verdict}
            </p>

            <!-- Red Flags & Storage Tip -->
            <div class="space-y-2 border-t border-hairline/80 pt-3 text-xs">
              <div class="flex items-start gap-1.5 text-error leading-relaxed">
                <span class="shrink-0" aria-hidden="true">🚩</span>
                <span><strong>{str.redFlagsLabel}:</strong> {staple.redFlags}</span>
              </div>
              <div class="flex items-start gap-1.5 text-muted leading-relaxed">
                <span class="shrink-0" aria-hidden="true">💡</span>
                <span><strong>{str.storageTipLabel}:</strong> {staple.storageTip}</span>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Empty Results -->
    <div id="no-staples-found" class="hidden text-center py-12 bg-surface-soft border border-hairline rounded-xl">
      <span class="text-3xl block mb-2" aria-hidden="true">🔍</span>
      <p class="text-sm font-semibold text-ink">{str.noResultsTitle}</p>
      <p class="text-xs text-muted mt-1">{str.noResultsSub}</p>
    </div>
  </div>

  <!-- VIEW 2: DENTED CAN BOTULISM TRIAGE -->
  <div id="view-can-triage" class="tool-view hidden" role="tabpanel" aria-labelledby="tab-can-triage">
    <div class="bg-surface-soft border border-hairline rounded-xl p-5 mb-6 text-center max-w-2xl mx-auto">
      <h2 class="text-lg font-bold text-ink mb-1">{str.canTriageHeading}</h2>
      <p class="text-xs sm:text-sm text-muted leading-relaxed">{str.canTriageSub}</p>
    </div>

    <!-- Triage Selection Chips -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-2.5 mb-8">
      {localizedCanTriage.map((item, idx) => (
        <button
          type="button"
          class={`can-triage-selector p-3 rounded-xl border text-center transition-all cursor-pointer flex flex-col items-center justify-center gap-1.5 ${
            idx === 0
              ? 'border-primary bg-primary/10 shadow-sm'
              : 'border-hairline bg-surface-soft hover:bg-surface-strong/40'
          }`}
          data-can-id={item.id}
        >
          <span class="text-2xl" aria-hidden="true">{item.icon}</span>
          <span class="text-xs font-bold text-ink leading-tight">{item.shortLabel}</span>
          <span class={`text-[10px] font-semibold px-2 py-0.5 rounded-full ${
            item.verdictLevel === 'safe' ? 'bg-emerald-700 text-white' : 'bg-red-700 text-white'
          }`}>
            {item.verdictLevel === 'safe' ? str.safeBadge : str.dangerBadge}
          </span>
        </button>
      ))}
    </div>

    <!-- Triage Detail Cards -->
    <div id="can-triage-details-container">
      {localizedCanTriage.map((item, idx) => (
        <div
          class={`can-triage-card border-2 rounded-xl p-6 transition-all ${
            item.verdictLevel === 'safe'
              ? 'border-emerald-600/50 bg-emerald-500/5'
              : 'border-red-600/60 bg-red-500/5'
          } ${idx === 0 ? 'block' : 'hidden'}`}
          data-can-card-id={item.id}
        >
          <div class="flex items-start gap-4 mb-4">
            <span class="text-4xl p-3 bg-canvas border border-hairline rounded-xl shadow-xs" aria-hidden="true">{item.icon}</span>
            <div>
              <div
                class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wide text-white mb-2"
                style={{ backgroundColor: item.verdictLevel === 'safe' ? '#047857' : '#b91c1c' }}
              >
                {item.verdict}
              </div>
              <h3 class="text-lg sm:text-xl font-bold text-ink leading-tight">{item.label}</h3>
            </div>
          </div>

          <div class="space-y-4 border-t border-hairline/80 pt-4 text-sm">
            <div class="bg-canvas border border-hairline rounded-lg p-4">
              <strong class="text-ink font-bold block mb-1">📜 {str.canRuleLabel}</strong>
              <p class="text-xs sm:text-sm text-muted leading-relaxed">{item.rule}</p>
            </div>

            <div class="bg-canvas border border-hairline rounded-lg p-4">
              <strong class="text-ink font-bold block mb-1">🛡️ {str.canActionLabel}</strong>
              <p class="text-xs sm:text-sm text-muted leading-relaxed">{item.action}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- VIEW 3: KITCHEN FRESHNESS TESTS -->
  <div id="view-freshness" class="tool-view hidden" role="tabpanel" aria-labelledby="tab-freshness">
    <div class="bg-surface-soft border border-hairline rounded-xl p-5 mb-8 text-center max-w-2xl mx-auto">
      <h2 class="text-lg font-bold text-ink mb-1">{str.freshnessHeading}</h2>
      <p class="text-xs sm:text-sm text-muted leading-relaxed">{str.freshnessSub}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {localizedFreshnessTests.map((test) => (
        <div class="bg-surface-soft border border-hairline hover:border-border-strong rounded-xl p-5 flex flex-col justify-between shadow-2xs">
          <div>
            <div class="flex items-center justify-between gap-3 mb-3">
              <div class="flex items-center gap-2.5">
                <span class="text-2xl p-2 rounded-lg bg-canvas border border-hairline" aria-hidden="true">{test.icon}</span>
                <div>
                  <h3 class="text-base font-bold text-ink leading-snug">{test.name}</h3>
                  <span class="text-xs text-muted block font-mono">⏱️ {test.duration}</span>
                </div>
              </div>
            </div>

            <div class="bg-canvas border border-hairline rounded-lg p-3 text-xs mb-3">
              <span class="font-bold text-ink block mb-1">🧪 {str.testRatioLabel}:</span>
              <p class="text-muted leading-relaxed font-mono">{test.ratio}</p>
            </div>

            <div class="space-y-1.5 mb-4 text-xs text-ink/90">
              <strong class="text-ink font-bold block">{str.stepsLabel}</strong>
              <ol class="list-decimal pl-5 space-y-1 text-muted leading-relaxed">
                {test.steps.map((st) => (
                  <li>{st}</li>
                ))}
              </ol>
            </div>
          </div>

          <div class="space-y-2 border-t border-hairline pt-3 text-xs">
            <div class="p-2.5 rounded-lg bg-emerald-500/10 border border-emerald-600/30 text-emerald-900 dark:text-emerald-200">
              <span class="font-bold block mb-0.5">{str.passLabel}:</span>
              <span class="leading-relaxed">{test.passSign}</span>
            </div>
            <div class="p-2.5 rounded-lg bg-rose-500/10 border border-rose-600/30 text-rose-900 dark:text-rose-200">
              <span class="font-bold block mb-0.5">{str.failLabel}:</span>
              <span class="leading-relaxed">{test.failSign}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Related Tools Navigation Strip -->
  <section class="mt-12 bg-surface-soft border border-hairline rounded-xl p-6 print:hidden">
    <h2 class="text-base font-bold text-ink mb-4">{str.relatedHeading}</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
      <a href={leftoverUrl} class="p-3.5 rounded-lg bg-canvas border border-hairline hover:border-border-strong transition-all flex flex-col justify-between">
        <div>
          <span class="text-xl block mb-1" aria-hidden="true">🍲</span>
          <span class="text-xs font-bold text-ink block leading-snug">{str.relatedLeftoverTitle}</span>
          <span class="text-[11px] text-muted block mt-1">{str.relatedLeftoverSub}</span>
        </div>
        <span class="text-xs font-semibold text-link mt-3 block">{str.openCalcCta} &rarr;</span>
      </a>
      <a href={powerOutageUrl} class="p-3.5 rounded-lg bg-canvas border border-hairline hover:border-border-strong transition-all flex flex-col justify-between">
        <div>
          <span class="text-xl block mb-1" aria-hidden="true">⚡</span>
          <span class="text-xs font-bold text-ink block leading-snug">{str.relatedPowerTitle}</span>
          <span class="text-[11px] text-muted block mt-1">{str.relatedPowerSub}</span>
        </div>
        <span class="text-xs font-semibold text-link mt-3 block">{str.openCalcCta} &rarr;</span>
      </a>
      <a href={fridgeZoneUrl} class="p-3.5 rounded-lg bg-canvas border border-hairline hover:border-border-strong transition-all flex flex-col justify-between">
        <div>
          <span class="text-xl block mb-1" aria-hidden="true">❄️</span>
          <span class="text-xs font-bold text-ink block leading-snug">{str.relatedFridgeTitle}</span>
          <span class="text-[11px] text-muted block mt-1">{str.relatedFridgeSub}</span>
        </div>
        <span class="text-xs font-semibold text-link mt-3 block">{str.openCalcCta} &rarr;</span>
      </a>
      <a href={methodologyUrl} class="p-3.5 rounded-lg bg-canvas border border-hairline hover:border-border-strong transition-all flex flex-col justify-between">
        <div>
          <span class="text-xl block mb-1" aria-hidden="true">🛡️</span>
          <span class="text-xs font-bold text-ink block leading-snug">{str.relatedMethodTitle}</span>
          <span class="text-[11px] text-muted block mt-1">{str.relatedMethodSub}</span>
        </div>
        <span class="text-xs font-semibold text-link mt-3 block">{str.readMethodCta} &rarr;</span>
      </a>
    </div>
  </section>

  <!-- Visible FAQ Accordion (Matches JSON-LD 1:1) -->
  <section class="mt-12 print:hidden">
    <h2 class="text-title-lg font-medium text-ink tracking-tight mb-6">
      {str.faqHeading}
    </h2>
    <div class="space-y-4">
      {localizedFaqs.map((faq) => (
        <details class="group p-5 bg-surface-soft border border-hairline rounded-xl" open>
          <summary class="text-title-sm font-semibold text-ink cursor-pointer list-none flex items-center justify-between gap-3">
            <span>{faq.question}</span>
            <span class="text-muted text-sm transition-transform group-open:rotate-180 shrink-0" aria-hidden="true">&#9662;</span>
          </summary>
          <p class="text-[14px] text-body leading-relaxed mt-3 pt-3 border-t border-hairline/70">
            {faq.answer}
          </p>
        </details>
      ))}
    </div>
  </section>

  <!-- Scientific Sources Strip -->
  <footer class="mt-10 pt-6 border-t border-hairline text-xs text-muted space-y-2">
    <p class="font-bold text-ink">{str.sourcesHeading}:</p>
    <ul class="list-disc pl-5 space-y-1">
      {rawData.meta.sources.map((src) => (
        <li>{src}</li>
      ))}
    </ul>
  </footer>
</div>

<script is:inline>
  (function () {
    function initPantryChecker() {
      var tabStaples = document.getElementById('tab-staples');
      var tabCanTriage = document.getElementById('tab-can-triage');
      var tabFreshness = document.getElementById('tab-freshness');

      var viewStaples = document.getElementById('view-staples');
      var viewCanTriage = document.getElementById('view-can-triage');
      var viewFreshness = document.getElementById('view-freshness');

      function switchTab(activeTab, activeView) {
        [tabStaples, tabCanTriage, tabFreshness].forEach(function (tab) {
          if (!tab) return;
          tab.classList.remove('bg-signature-coral', 'text-white', 'border-signature-coral');
          tab.classList.add('bg-surface-soft', 'text-ink', 'border-hairline');
          tab.setAttribute('aria-selected', 'false');
        });

        [viewStaples, viewCanTriage, viewFreshness].forEach(function (view) {
          if (!view) return;
          view.classList.add('hidden');
          view.classList.remove('block');
        });

        if (activeTab && activeView) {
          activeTab.classList.remove('bg-surface-soft', 'text-ink', 'border-hairline');
          activeTab.classList.add('bg-signature-coral', 'text-white', 'border-signature-coral');
          activeTab.setAttribute('aria-selected', 'true');
          activeView.classList.remove('hidden');
          activeView.classList.add('block');
        }
      }

      if (tabStaples && viewStaples) {
        tabStaples.onclick = function () { switchTab(tabStaples, viewStaples); };
      }
      if (tabCanTriage && viewCanTriage) {
        tabCanTriage.onclick = function () { switchTab(tabCanTriage, viewCanTriage); };
      }
      if (tabFreshness && viewFreshness) {
        tabFreshness.onclick = function () { switchTab(tabFreshness, viewFreshness); };
      }

      var triageSelectors = document.querySelectorAll('.can-triage-selector');
      var triageCards = document.querySelectorAll('.can-triage-card');

      triageSelectors.forEach(function (btn) {
        btn.onclick = function () {
          var targetId = btn.getAttribute('data-can-id');
          triageSelectors.forEach(function (s) {
            s.classList.remove('border-primary', 'bg-primary/10', 'shadow-sm');
            s.classList.add('border-hairline', 'bg-surface-soft');
          });
          btn.classList.remove('border-hairline', 'bg-surface-soft');
          btn.classList.add('border-primary', 'bg-primary/10', 'shadow-sm');

          triageCards.forEach(function (card) {
            if (card.getAttribute('data-can-card-id') === targetId) {
              card.classList.remove('hidden');
              card.classList.add('block');
            } else {
              card.classList.add('hidden');
              card.classList.remove('block');
            }
          });
        };
      });

      var searchInput = document.getElementById('pantry-search-input');
      var filterButtons = document.querySelectorAll('.category-filter-btn');
      var stapleCards = document.querySelectorAll('.staple-card');
      var resultsCountText = document.getElementById('results-count-text');
      var emptyNotice = document.getElementById('no-staples-found');

      var currentCat = 'all';

      function applyFilters() {
        var query = searchInput ? searchInput.value.toLowerCase().trim() : '';
        var visibleCount = 0;

        stapleCards.forEach(function (card) {
          var cat = card.getAttribute('data-category') || '';
          var kw = card.getAttribute('data-keywords') || '';

          var matchesCat = currentCat === 'all' || cat === currentCat;
          var matchesQuery = !query || kw.indexOf(query) !== -1;

          if (matchesCat && matchesQuery) {
            card.style.display = '';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        if (resultsCountText) {
          var prefix = resultsCountText.getAttribute('data-prefix') || 'Showing ';
          var suffix = resultsCountText.getAttribute('data-suffix') || ' staples';
          resultsCountText.textContent = prefix + String(visibleCount) + suffix;
        }

        if (emptyNotice) {
          if (visibleCount === 0) {
            emptyNotice.classList.remove('hidden');
            emptyNotice.classList.add('block');
          } else {
            emptyNotice.classList.add('hidden');
            emptyNotice.classList.remove('block');
          }
        }
      }

      if (searchInput) {
        searchInput.oninput = applyFilters;
      }

      filterButtons.forEach(function (btn) {
        btn.onclick = function () {
          filterButtons.forEach(function (b) {
            b.classList.remove('bg-ink', 'text-white', 'border-ink');
            b.classList.add('bg-canvas', 'text-ink', 'border-hairline');
          });
          btn.classList.remove('bg-canvas', 'border-hairline');
          btn.classList.add('bg-ink', 'text-white', 'border-ink');

          currentCat = btn.getAttribute('data-category') || 'all';
          applyFilters();
        };
      });

      var copyBtn = document.getElementById('copy-summary-btn');
      if (copyBtn) {
        var originalCopyText = copyBtn.textContent || '';
        copyBtn.onclick = function () {
          var copyPrefix = copyBtn.getAttribute('data-copy-prefix') || 'IsItKitchenSafe: ';
          var copiedLabel = copyBtn.getAttribute('data-copied-label') || '✓ Copied!';
          var shareText = copyPrefix + window.location.href;
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(shareText).then(function () {
              copyBtn.textContent = copiedLabel;
              setTimeout(function () {
                copyBtn.textContent = originalCopyText;
              }, 2500);
            });
          }
        };
      }

      var printBtn = document.getElementById('print-pantry-btn');
      if (printBtn) {
        printBtn.onclick = function () {
          window.print();
        };
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initPantryChecker);
    } else {
      initPantryChecker();
    }
    document.addEventListener('astro:page-load', initPantryChecker);
  })();
</script>
