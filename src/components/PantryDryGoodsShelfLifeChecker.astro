---
import rawData from '../data/pantry-dry-goods-shelf-life-data.json';
import type { SupportedLanguage } from '../i18n/ui';
import { useTranslatedPath } from '../i18n/utils';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;
const translatePath = useTranslatedPath(lang);

const leftoverUrl = translatePath('/tools/leftover-shelf-life-calculator/');
const powerOutageUrl = translatePath('/tools/power-outage-food-safety-checker/');
const fridgeZoneUrl = translatePath('/tools/fridge-organization-zone-planner/');
const methodologyUrl = translatePath('/methodology/');

type VerdictType = 'indefinite' | 'quality-only' | 'refrigerate-opened' | 'spoils-easily';

interface LocalizedStaple {
  id: string;
  icon: string;
  category: string;
  categoryLabel: string;
  verdictType: VerdictType;
  riskFlags: string[];
  keywords: string;
  name: string;
  unopened: string;
  opened: string;
  verdict: string;
  redFlags: string;
  storageTip: string;
}

interface LocalizedCanTriage {
  id: string;
  icon: string;
  verdictLevel: 'safe' | 'danger';
  label: string;
  shortLabel: string;
  verdict: string;
  rule: string;
  action: string;
}

interface LocalizedFreshnessTest {
  id: string;
  icon: string;
  duration: string;
  name: string;
  shortName: string;
  ratio: string;
  steps: string[];
  passSign: string;
  failSign: string;
}

const mythBanner =
  (rawData.mythBanner as Record<string, { badge: string; headline: string; body: string }>)[lang] ||
  rawData.mythBanner.en;

const localizedCategories: Array<{ id: string; label: string }> =
  (rawData.categories as Record<string, Array<{ id: string; label: string }>>)[lang] ||
  rawData.categories.en;

const categoryLabelMap: Record<string, string> = {};
for (const cat of localizedCategories) {
  categoryLabelMap[cat.id] = cat.label;
}

const localizedStaples: LocalizedStaple[] = rawData.staples.map((item) => {
  const tr = (item.i18n as Record<string, any>)[lang] || item.i18n.en;
  return {
    id: item.id,
    icon: item.icon,
    category: item.category,
    categoryLabel: categoryLabelMap[item.category] || item.category.replace('-', ' '),
    verdictType: item.verdictType as VerdictType,
    riskFlags: item.riskFlags || [],
    keywords: `${item.keywords} ${tr.name} ${tr.unopened} ${tr.opened} ${tr.verdict}`.toLowerCase(),
    name: tr.name,
    unopened: tr.unopened,
    opened: tr.opened,
    verdict: tr.verdict,
    redFlags: tr.redFlags,
    storageTip: tr.storageTip
  };
});

const localizedCanTriage: LocalizedCanTriage[] = rawData.canTriage.map((item) => {
  const tr = (item.i18n as Record<string, any>)[lang] || item.i18n.en;
  return {
    id: item.id,
    icon: item.icon,
    verdictLevel: item.verdictLevel as 'safe' | 'danger',
    label: tr.label,
    shortLabel: tr.shortLabel,
    verdict: tr.verdict,
    rule: tr.rule,
    action: tr.action
  };
});

const localizedFreshnessTests: LocalizedFreshnessTest[] = rawData.freshnessTests.map((item) => {
  const tr = (item.i18n as Record<string, any>)[lang] || item.i18n.en;
  return {
    id: item.id,
    icon: item.icon,
    duration: item.duration,
    name: tr.name,
    shortName: tr.shortName,
    ratio: tr.ratio,
    steps: tr.steps as string[],
    passSign: tr.passSign,
    failSign: tr.failSign
  };
});

const localizedFaqs: Array<{ question: string; answer: string }> =
  (rawData.faqs as Record<string, Array<{ question: string; answer: string }>>)[lang] ||
  rawData.faqs.en;

