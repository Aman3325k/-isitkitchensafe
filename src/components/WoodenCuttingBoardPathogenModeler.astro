    subtitle: "木材の導管（道管）によるサルモネラ菌・カンピロバクター・大腸菌の毛細管トラップと、傷ついたプラスチック製まな板の細菌残存率を比較。カエデ・チーク・アカシアの脱水殺菌動態を科学的に予測します。",
    controlsTitle: "まな板材質および微生物学的パラメータ設定",
    controlsSub: "まな板基材の木目構造、病原菌種、包丁傷の重症度、殺菌プロトコル、自然乾燥時間を設定します。",
    materialLabel: "まな板基材および木目構造：",
    materialHelp: "ハードメイプル木口（End-Grain） vs チーク板目（Edge-Grain） vs アカシア木口 vs 積層竹まな板 vs 傷ついたHDPEプラスチック（対照群）。",
    pathogenLabel: "接種対象の食中毒病原菌：",
    pathogenHelp: "サルモネラ菌（生鶏肉由来） vs カンピロバクター vs 病原性大腸菌O157 vs リステリア菌 vs 黄色ブドウ球菌。",
    conditionLabel: "包丁傷の深さと表面摩耗状態：",
    conditionHelp: "新品・定期オイル塗布（<0.1mm） vs 一般家庭の通常傷（0.5mm） vs 深い刻み傷（>1.5mm） vs 食洗機等による割れ・接合剥離。",
    protocolLabel: "適用する洗浄・殺菌プロトコル：",
    protocolHelp: "12時間常温風乾 vs 温水＋食器用洗剤洗浄 vs 200ppm次亜塩素酸液浸漬 vs 過酸化水素＋酢スプレー vs 食洗機高温洗浄 vs 湿った布巾での水拭き。",
    volumeLabel: "汚染肉汁・液滴ボリューム（mL）：",
    volumeHelp: "まな板表面に付着した生肉・生鶏肉のドリップ総量。",
    timeLabel: "汚染後の経過・乾燥時間（時間）：",
    timeHelp: "汚染後、次の調理または食材接触までの空気暴露および水分蒸発時間。",
    presetsTitle: "実証実験プリセットシナリオ：",
    presetCliverBenchmark: "クリバー教授の古典実験（メイプル木口＋生鶏肉＋12時間風乾）",
    presetPlasticDisaster: "傷だらけのプラスチック板の悲劇（HDPE＋生七面鳥肉＋台拭き水拭き）",
    presetBambooSplit: "食洗機で割れた竹まな板（積層竹＋生牛肉＋2時間乾燥）",
    presetCommercialTeak: "業務用解体調理台（チーク＋サルモネラ＋過酸化水素・酢スプレー）",
    presetPristineAcacia: "極上オイル塗布アカシア（アカシア＋生野菜サラダ＋温水洗剤洗浄）",
    diagnosticTitle: "病原菌生残率・交差汚染リスク診断スコアカード",
    diagnosticSub: "表面回収可能CFU、道管深部トラップ効率、殺菌対数減少率、FDA基準適合度をリアルタイム算出。",
    recoverableSurfaceLabel: "表面残存・食材移行可能菌量",
    capillaryTrappingLabel: "毛細管現象による深部トラップ率",
    sanitizationKillLabel: "病原菌ネット殺菌減少対数",
    crossContamRiskLabel: "生食食材への交差汚染リスク",
    fdaComplianceLabel: "米FDA食品コード 4-101.17 適合性",
    woodFiberHealthLabel: "木材繊維の健康度・耐久年数",
    actionProtocolLabel: "義務的まな板除染・安全プロトコル",
    scienceTitle: "毛細管現象の物理とウィスコンシン大・クリバー教授の歴史的発見",
    scienceSub: "なぜ多孔質な木製まな板は、不浸透性のプラスチックよりも自然に細菌を死滅させることができるのか？",
    tableTitle: "まな板材質別 微生物動態・物理特性比較マトリックス",
    tableSub: "ヤンカ硬度、毛細管水分吸収、自然乾燥脱水速度、包丁傷の自己修復能の徹底比較。",
    colMaterial: "まな板材質",
    colHardness: "ヤンカ硬度（lbf）",
    colCapillary: "毛細管液体吸引速度",
    colDesiccation: "自然乾燥による殺菌速度",
    colKnifeHealing: "包丁傷の自己修復性",
    colOverallVerdict: "食品衛生総合評価",
    rulesTitle: "木製まな板を安全に使い続けるための黄金律",
    rulesSub: "食中毒の交差汚染を完全に防ぐための科学的メンテナンス基準。",
    rule1Title: "天然木製まな板は絶対に食器洗い乾燥機に入れない",
    rule1Text: "食洗機の高温（65℃以上）とアルカリ性洗剤は木材細胞を急激に膨張させ、接着面を剥離させて深いひび割れを生み、細菌バイオフィルムの温床となります。",
    rule2Title: "月に1回、食品用ミネラルオイルと蜜蝋で保湿コーティングする",
    rule2Text: "食品安全グレードの流動パラフィンオイルを塗布することで、木材の導管に疎水性バリアを張り、生肉の血液や肉汁が1mm以上深くに染み込むのを防ぎます。",
    rule3Title: "深く毛羽立ったプラスチック製まな板は廃棄する",
    rule3Text: "包丁による毛羽立ちや1mm以上の深い溝ができたプラスチック板は直ちに交換してください。傷の奥の微小な空洞はスポンジが届かず、細菌を保護してしまいます。",
    rule4Title: "過酸化水素水と食酢の「二段噴霧消毒法」を活用する",
    rule4Text: "まな板表面に3%オキシドール（過酸化水素）を噴霧して2分放置後、5%の食酢をスプレーして拭き取ります。表面で生じる過酢酸が木を傷めずに5 logの強力な殺菌効果を発揮します。",
    copyReportBtn: "微生物衛生分析レポートをコピー",
    copiedFeedback: "衛生レポートをクリップボードにコピーしました！"
  }
};

const c = DICTIONARY[lang] || DICTIONARY.en;
---

<div class="wooden-board-modeler bg-surface border border-hairline rounded-3xl p-6 md:p-10 shadow-xs mb-12" data-lang={lang}>
  <!-- Header / Badge -->
  <div class="flex flex-wrap items-center justify-between gap-4 mb-8 pb-6 border-b border-hairline">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-emerald-500/10 text-emerald-900 border border-emerald-500/20 mb-2">
        <span>🪵</span>
        <span>{c.badge}</span>
      </div>
      <h2 class="text-2xl md:text-3xl font-extrabold text-ink tracking-tight">
        {c.title}
      </h2>
      <p class="text-xs md:text-sm text-muted mt-1 max-w-3xl">
        {c.subtitle}
      </p>
    </div>
  </div>

  <!-- Presets Bar -->
  <div class="mb-8 p-4 bg-surface-soft border border-hairline rounded-2xl">
    <div class="text-xs font-bold text-muted uppercase tracking-wider mb-2 flex items-center gap-1.5">
      <span>⚡</span> {c.presetsTitle}
    </div>
    <div class="flex flex-wrap gap-2">
      <button type="button" class="preset-btn px-3 py-1.5 bg-surface hover:bg-emerald-50 text-xs font-medium text-ink rounded-xl border border-hairline hover:border-emerald-300 transition-colors" data-preset="cliver-maple">
        🧪 {c.presetCliverBenchmark}
      </button>
      <button type="button" class="preset-btn px-3 py-1.5 bg-surface hover:bg-rose-50 text-xs font-medium text-ink rounded-xl border border-hairline hover:border-rose-300 transition-colors" data-preset="plastic-hazard">
        ⚠️ {c.presetPlasticDisaster}
      </button>
      <button type="button" class="preset-btn px-3 py-1.5 bg-surface hover:bg-amber-50 text-xs font-medium text-ink rounded-xl border border-hairline hover:border-amber-300 transition-colors" data-preset="bamboo-dishwasher">
        💥 {c.presetBambooSplit}
      </button>
      <button type="button" class="preset-btn px-3 py-1.5 bg-surface hover:bg-cyan-50 text-xs font-medium text-ink rounded-xl border border-hairline hover:border-cyan-300 transition-colors" data-preset="commercial-teak">
        🔪 {c.presetCommercialTeak}
      </button>
      <button type="button" class="preset-btn px-3 py-1.5 bg-surface hover:bg-emerald-50 text-xs font-medium text-ink rounded-xl border border-hairline hover:border-emerald-300 transition-colors" data-preset="pristine-acacia">
        🥗 {c.presetPristineAcacia}
      </button>
    </div>
  </div>

  <!-- Interactive Grid: Controls & Diagnostics -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-12">
    <!-- Left Column: Controls (7 cols) -->
    <div class="lg:col-span-7 space-y-6">
      <div class="bg-surface-soft border border-hairline rounded-2xl p-6">
        <h3 class="text-base font-bold text-ink mb-1 flex items-center gap-2">
          <span>⚙️</span> {c.controlsTitle}
        </h3>
        <p class="text-xs text-muted mb-6">
          {c.controlsSub}
        </p>

        <div class="space-y-5">
          <!-- Material Select -->
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-muted mb-1.5" for="board-material-select">
              {c.materialLabel}
            </label>
            <select id="board-material-select" class="w-full bg-surface border border-hairline rounded-xl px-3.5 py-2.5 text-sm text-ink focus:outline-hidden focus:ring-2 focus:ring-emerald-500 font-medium">
              {modelData.boardMaterials.map(mat => (
                <option value={mat.id}>{mat.name} ({mat.category})</option>
              ))}
            </select>
            <p class="text-[11px] text-muted mt-1" id="material-description">
              {modelData.boardMaterials[0].description}
            </p>
          </div>

          <!-- Pathogen Select -->
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-muted mb-1.5" for="pathogen-select">
              {c.pathogenLabel}
            </label>
            <select id="pathogen-select" class="w-full bg-surface border border-hairline rounded-xl px-3.5 py-2.5 text-sm text-ink focus:outline-hidden focus:ring-2 focus:ring-emerald-500 font-medium">
              {modelData.pathogens.map(pat => (
                <option value={pat.id}>{pat.name} (Infectious Dose: {pat.infectiousDoseCfu} CFU)</option>
              ))}
            </select>
            <p class="text-[11px] text-muted mt-1" id="pathogen-hazard-desc">
              Clinical Hazard: {modelData.pathogens[0].clinicalHazard}
            </p>
          </div>

          <!-- Wear Condition Select -->
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-muted mb-1.5" for="wear-condition-select">
              {c.conditionLabel}
            </label>
            <select id="wear-condition-select" class="w-full bg-surface border border-hairline rounded-xl px-3.5 py-2.5 text-sm text-ink focus:outline-hidden focus:ring-2 focus:ring-emerald-500 font-medium">
              {modelData.boardWearConditions.map(cond => (
                <option value={cond.id}>{cond.name} (Knife Score Depth: ~{cond.knifeScarDepthMm} mm)</option>
              ))}
            </select>
            <p class="text-[11px] text-muted mt-1" id="wear-description">
              Surface State: {modelData.boardWearConditions[0].surfaceCondition}
            </p>
          </div>

          <!-- Sanitization Protocol Select -->
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-muted mb-1.5" for="protocol-select">
              {c.protocolLabel}
            </label>
            <select id="protocol-select" class="w-full bg-surface border border-hairline rounded-xl px-3.5 py-2.5 text-sm text-ink focus:outline-hidden focus:ring-2 focus:ring-emerald-500 font-medium">
              {modelData.sanitizationProtocols.map(proto => (
                <option value={proto.id}>{proto.name} [{proto.sanitizerType}]</option>
              ))}
            </select>
            <p class="text-[11px] text-muted mt-1" id="protocol-description">
              {modelData.sanitizationProtocols[0].description}
            </p>
          </div>

          <!-- Sliders Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
            <!-- Inoculum Volume Slider -->
            <div class="bg-surface p-4 rounded-xl border border-hairline">
              <div class="flex items-center justify-between mb-1.5">
                <span class="text-xs font-bold uppercase tracking-wider text-muted">{c.volumeLabel}</span>
                <span class="text-xs font-mono font-bold text-ink" id="volume-val-display">1.0 mL</span>
              </div>
              <input type="range" id="volume-slider" min="0.1" max="5.0" step="0.1" value="1.0" class="w-full accent-emerald-600" />
              <p class="text-[10px] text-muted mt-1">{c.volumeHelp}</p>
            </div>

            <!-- Elapsed Hours Slider -->
            <div class="bg-surface p-4 rounded-xl border border-hairline">
              <div class="flex items-center justify-between mb-1.5">
                <span class="text-xs font-bold uppercase tracking-wider text-muted">{c.timeLabel}</span>
                <span class="text-xs font-mono font-bold text-ink" id="time-val-display">12 Hours</span>
              </div>
              <input type="range" id="time-slider" min="0.25" max="24.0" step="0.25" value="12.0" class="w-full accent-emerald-600" />
              <p class="text-[10px] text-muted mt-1">{c.timeHelp}</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Diagnostics Scorecard (5 cols) -->
    <div class="lg:col-span-5 space-y-6">
      <div class="bg-surface-soft border border-hairline rounded-2xl p-6 h-full flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-4 pb-3 border-b border-hairline">
            <h3 class="text-base font-bold text-ink flex items-center gap-2">
              <span>🔬</span> {c.diagnosticTitle}
            </h3>
            <span id="threat-pill" class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 border border-emerald-300">
              LOW RISK
            </span>
          </div>
          <p class="text-xs text-muted mb-6">
            {c.diagnosticSub}
          </p>

          <!-- Metrics Stack -->
          <div class="space-y-3.5 mb-6">
            <!-- Recoverable Surface CFU -->
            <div class="bg-surface p-3.5 rounded-xl border border-hairline flex items-center justify-between">
              <div>
                <div class="text-[11px] font-bold uppercase tracking-wider text-muted">{c.recoverableSurfaceLabel}</div>
                <div class="text-xs text-muted" id="initial-inoculum-sub">Inoculated: 10,000,000 CFU</div>
              </div>
              <div class="text-right">
                <div class="text-lg font-black font-mono text-emerald-700" id="recoverable-cfu-val">0 CFU</div>
                <div class="text-[10px] font-mono text-muted" id="surface-cfu-cm2">0.0 CFU/cm²</div>
              </div>
            </div>

            <!-- Capillary Trapping Efficiency -->
            <div class="bg-surface p-3.5 rounded-xl border border-hairline flex items-center justify-between">
              <div>
                <div class="text-[11px] font-bold uppercase tracking-wider text-muted">{c.capillaryTrappingLabel}</div>
                <div class="text-xs text-muted" id="capillary-status-sub">Xylem Absorption</div>
              </div>
              <div class="text-right">
                <div class="text-lg font-black font-mono text-ink" id="capillary-trap-pct">99.8%</div>
                <div class="text-[10px] font-mono text-muted" id="capillary-depth-val">Depth: 1.8 mm</div>
              </div>
            </div>

            <!-- Net Sanitization Log Kill -->
            <div class="bg-surface p-3.5 rounded-xl border border-hairline flex items-center justify-between">
              <div>
                <div class="text-[11px] font-bold uppercase tracking-wider text-muted">{c.sanitizationKillLabel}</div>
                <div class="text-xs text-muted" id="kill-kinetics-sub">Desiccation + Sanitizer</div>
              </div>
              <div class="text-right">
                <div class="text-lg font-black font-mono text-emerald-700" id="log-kill-val">6.2 Log</div>
                <div class="text-[10px] font-mono text-muted" id="kill-pct-val">99.9999% Inactivated</div>
              </div>
            </div>

            <!-- FDA Food Code Compliance -->
            <div class="bg-surface p-3.5 rounded-xl border border-hairline flex items-center justify-between">
              <div>
                <div class="text-[11px] font-bold uppercase tracking-wider text-muted">{c.fdaComplianceLabel}</div>
                <div class="text-xs text-muted">Smooth, easily cleanable, non-absorbent</div>
              </div>
              <div class="text-right">
                <div class="text-sm font-bold text-emerald-700 font-mono" id="fda-compliance-val">COMPLIANT (FDA 4-101.17)</div>
                <div class="text-[10px] font-mono text-muted" id="board-health-val">Fiber Health: Optimal</div>
              </div>
            </div>
          </div>

          <!-- Protocol Recommendation Banner -->
          <div class="p-4 rounded-xl border mb-6 transition-all" id="action-banner">
            <div class="text-xs font-bold uppercase tracking-wider mb-1 flex items-center gap-1.5" id="action-header">
              <span>🛡️</span> {c.actionProtocolLabel}
            </div>
            <p class="text-xs leading-relaxed" id="action-text">
              Board surface is completely decontaminated. Natural wood xylem capillary action has desiccated trapped bacterial cells. Food contact safe for raw and ready-to-eat produce.
            </p>
          </div>
        </div>

        <!-- Copy Report Button -->
        <button type="button" id="copy-report-btn" class="w-full py-2.5 px-4 bg-emerald-600 hover:bg-emerald-700 text-white font-medium text-xs rounded-xl transition-colors shadow-xs flex items-center justify-center gap-2">
          <span>📋</span>
          <span id="copy-btn-text">{c.copyReportBtn}</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Deep-Dive Science Section: Cliver Discovery -->
  <div class="border-t border-hairline pt-10 mb-12">
    <div class="max-w-4xl mb-8">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-surface-soft border border-hairline text-ink mb-2">
        <span>🧪</span> {c.scienceTitle}
      </div>
      <h3 class="text-xl md:text-2xl font-extrabold text-ink tracking-tight mb-2">
        {c.scienceSub}
      </h3>
      <p class="text-sm text-muted leading-relaxed">
        In 1994, microbiologists Dean O. Cliver and Nese O. Ak at the University of Wisconsin–Madison Food Research Institute made a counterintuitive discovery: when identical concentrations of Salmonella, Listeria, and E. coli were inoculated onto wooden and plastic cutting boards, bacteria recovered from wooden boards dropped by 99.9% within 3 hours, whereas populations on plastic boards remained viable and frequently multiplied.
      </p>
    </div>

    <!-- Science Pillars Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
      <div class="bg-surface-soft border border-hairline rounded-2xl p-5">
        <div class="text-xs font-bold uppercase text-emerald-800 mb-2 flex items-center gap-1.5">
          <span>💧</span> Vertical Capillary Suction
        </div>
        <p class="text-xs text-muted leading-relaxed mb-3">
          Hardwood contains thousands of microscopic tubular xylem vessels. When poultry juices touch the board, vertical capillary pressure sucks water droplets and bacterial cells beneath the surface within 3 to 10 minutes, isolating pathogens away from food contact.
        </p>
        <div class="text-[11px] font-mono text-ink bg-surface p-2.5 rounded-xl border border-hairline">
          Penetration Depth: 1.0–2.5 mm<br/>
          Surface Contact Clearance: &gt;99%
        </div>
      </div>

      <div class="bg-surface-soft border border-hairline rounded-2xl p-5">
        <div class="text-xs font-bold uppercase text-amber-900 mb-2 flex items-center gap-1.5">
          <span>☀️</span> Cellular Desiccation Kinetics
        </div>
        <p class="text-xs text-muted leading-relaxed mb-3">
          Bacteria require free unbound water (water activity aw &gt; 0.95) to replicate. Because wood hygroscopically absorbs moisture into its cell walls without pooling, the trapped bacteria are starved of moisture and rapidly undergo osmotic cellular collapse and death.
        </p>
        <div class="text-[11px] font-mono text-ink bg-surface p-2.5 rounded-xl border border-hairline">
          Salmonella Inactivation: 3–6 Hours<br/>
          Campylobacter Inactivation: &lt;2 Hours
        </div>
      </div>

      <div class="bg-surface-soft border border-hairline rounded-2xl p-5">
        <div class="text-xs font-bold uppercase text-rose-800 mb-2 flex items-center gap-1.5">
          <span>🔪</span> Plastic Scar Shielding Trap
        </div>
        <p class="text-xs text-muted leading-relaxed mb-3">
          Unlike wood fibers that self-heal under blade pressure, chef's knives gouge permanent feathered ridges into polyethylene plastic. Meat juices pool in these micro-craters where kitchen sponges skim right over them, sheltering bacterial biofilms.
        </p>
        <div class="text-[11px] font-mono text-ink bg-surface p-2.5 rounded-xl border border-hairline">
          Plastic Scar Depth: Up to 2.0 mm<br/>
          Sponge Cleaning Clearance: &lt;45% in cuts
        </div>
      </div>
    </div>
  </div>

  <!-- Comparative Material Matrix Table -->
  <div class="border-t border-hairline pt-10 mb-12">
    <div class="mb-6">
      <h3 class="text-lg md:text-xl font-bold text-ink mb-1">
        {c.tableTitle}
      </h3>
      <p class="text-xs text-muted">
        {c.tableSub}
      </p>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs border-collapse">
        <thead>
          <tr class="border-b border-hairline text-muted uppercase font-semibold">
            <th class="py-3 px-3">{c.colMaterial}</th>
            <th class="py-3 px-3">{c.colHardness}</th>
            <th class="py-3 px-3">{c.colCapillary}</th>
            <th class="py-3 px-3">{c.colDesiccation}</th>
            <th class="py-3 px-3">{c.colKnifeHealing}</th>
            <th class="py-3 px-3">{c.colOverallVerdict}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline/60">
          <tr class="hover:bg-surface-soft transition-colors">
            <td class="py-3 px-3 font-medium text-ink">Hard Rock Maple (End-Grain)</td>
            <td class="py-3 px-3 font-mono">1,450 lbf</td>
            <td class="py-3 px-3 text-emerald-800">Rapid Vertical Draw</td>
            <td class="py-3 px-3 text-emerald-800">3–6h (&gt;99.9% Kill)</td>
            <td class="py-3 px-3 text-emerald-800">Superior (Fibers Part)</td>
            <td class="py-3 px-3"><span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-800">GOLD STANDARD</span></td>
          </tr>
          <tr class="hover:bg-surface-soft transition-colors">
            <td class="py-3 px-3 font-medium text-ink">Plantation Teak (Edge-Grain)</td>
            <td class="py-3 px-3 font-mono">1,070 lbf</td>
            <td class="py-3 px-3 text-amber-900">Moderate (Silica Oils)</td>
            <td class="py-3 px-3 text-emerald-800">4–8h (Tectoquinones)</td>
            <td class="py-3 px-3 text-muted">Moderate Resistance</td>
            <td class="py-3 px-3"><span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-800">EXCELLENT</span></td>
          </tr>
          <tr class="hover:bg-surface-soft transition-colors">
            <td class="py-3 px-3 font-medium text-ink">Acacia Hardwood (End-Grain)</td>
            <td class="py-3 px-3 font-mono">1,750 lbf</td>
            <td class="py-3 px-3 text-emerald-800">Fast Capillary Draw</td>
            <td class="py-3 px-3 text-emerald-800">2–5h (Tannin Rich)</td>
            <td class="py-3 px-3 text-emerald-800">High Resilience</td>
            <td class="py-3 px-3"><span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-800">OUTSTANDING</span></td>
          </tr>
          <tr class="hover:bg-surface-soft transition-colors">
            <td class="py-3 px-3 font-medium text-ink">Laminated Moso Bamboo</td>
            <td class="py-3 px-3 font-mono">1,380 lbf</td>
            <td class="py-3 px-3 text-muted">Low (Adhesive Seams)</td>
            <td class="py-3 px-3 text-amber-900">Slow in Glue Joints</td>
            <td class="py-3 px-3 text-rose-800">Splinters &amp; Dulls Knives</td>
            <td class="py-3 px-3"><span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-100 text-amber-800">MODERATE / CRACKS</span></td>
          </tr>
          <tr class="hover:bg-surface-soft transition-colors">
            <td class="py-3 px-3 font-medium text-ink">Scratched HDPE Plastic (Control)</td>
            <td class="py-3 px-3 font-mono">N/A (Soft)</td>
            <td class="py-3 px-3 text-rose-800">Zero (Non-Porous)</td>
            <td class="py-3 px-3 text-rose-800">None (Days in Scars)</td>
            <td class="py-3 px-3 text-rose-800">Zero (Permanent Gouges)</td>
            <td class="py-3 px-3"><span class="px-2 py-0.5 rounded text-[10px] font-bold bg-rose-100 text-rose-800">HIGH BIOFILM RISK</span></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Golden Rules Section -->
  <div class="border-t border-hairline pt-10">
    <div class="mb-6">
      <h3 class="text-lg md:text-xl font-bold text-ink mb-1">
        {c.rulesTitle}
      </h3>
      <p class="text-xs text-muted">
        {c.rulesSub}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="bg-surface-soft border border-hairline rounded-2xl p-5">
        <div class="text-xs font-bold text-rose-800 uppercase mb-1.5 flex items-center gap-1.5">
          <span>🚫</span> {c.rule1Title}
        </div>
        <p class="text-xs text-muted leading-relaxed">
          {c.rule1Text}
        </p>
      </div>

      <div class="bg-surface-soft border border-hairline rounded-2xl p-5">
        <div class="text-xs font-bold text-emerald-800 uppercase mb-1.5 flex items-center gap-1.5">
          <span>🧴</span> {c.rule2Title}
        </div>
        <p class="text-xs text-muted leading-relaxed">
          {c.rule2Text}
        </p>
      </div>

      <div class="bg-surface-soft border border-hairline rounded-2xl p-5">
        <div class="text-xs font-bold text-amber-900 uppercase mb-1.5 flex items-center gap-1.5">
          <span>♻️</span> {c.rule3Title}
        </div>
        <p class="text-xs text-muted leading-relaxed">
          {c.rule3Text}
        </p>
      </div>

      <div class="bg-surface-soft border border-hairline rounded-2xl p-5">
        <div class="text-xs font-bold text-cyan-800 uppercase mb-1.5 flex items-center gap-1.5">
          <span>🧪</span> {c.rule4Title}
        </div>
        <p class="text-xs text-muted leading-relaxed">
          {c.rule4Text}
        </p>
      </div>
    </div>
  </div>
</div>

<script>
  function initCuttingBoardModeler() {
    const root = document.querySelector('.wooden-board-modeler') as HTMLElement;
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';

    // Model database constants
    const materials: Record<string, {
      name: string;
      isWood: boolean;
      janka: number;
      capillaryEfficiency: number;
      desiccationRatePerHour: number;
      knifeScarMultiplier: number;
      dishwasherTolerant: boolean;
      description: string;
    }> = {
      'end-grain-maple': {
        name: 'End-Grain Hard Rock Maple',
        isWood: true,
        janka: 1450,
        capillaryEfficiency: 0.96,
        desiccationRatePerHour: 0.85,
        knifeScarMultiplier: 0.3,
        dishwasherTolerant: false,
        description: 'End-grain hard maple vertical xylem capillary tubes draw fluids inward. Pathogens desiccate inside wood pores.'
      },
      'edge-grain-teak': {
        name: 'Edge-Grain Plantation Teak',
        isWood: true,
        janka: 1070,
        capillaryEfficiency: 0.82,
        desiccationRatePerHour: 0.75,
        knifeScarMultiplier: 0.45,
        dishwasherTolerant: false,
        description: 'Natural silica and tectoquinone oleoresins prevent deep meat juice penetration while suppressing bacterial division.'
      },
      'end-grain-acacia': {
        name: 'End-Grain Acacia Hardwood',
        isWood: true,
        janka: 1750,
        capillaryEfficiency: 0.94,
        desiccationRatePerHour: 0.92,
        knifeScarMultiplier: 0.35,
        dishwasherTolerant: false,
        description: 'Dense tannin concentrations and fibrous end-grain provide rapid desiccation and natural antimicrobial inhibition.'
      },
      'laminated-bamboo': {
        name: 'Laminated Moso Bamboo',
        isWood: false,
        janka: 1380,
        capillaryEfficiency: 0.60,
        desiccationRatePerHour: 0.50,
        knifeScarMultiplier: 0.70,
        dishwasherTolerant: false,
        description: 'Bamboo grass strips bound with synthetic glue. Knife gouges splinter fibers and expose adhesive seams.'
      },
      'scratched-plastic-hdpe': {
        name: 'Scratched HDPE Plastic',
        isWood: false,
        janka: 0,
        capillaryEfficiency: 0.0,
        desiccationRatePerHour: 0.05,
        knifeScarMultiplier: 1.0,
        dishwasherTolerant: true,
        description: 'Non-porous synthetic plastic. Fluids pool on surface; bacteria hide inside feathered knife scars immune to sponge washing.'
      }
    };

    const pathogens: Record<string, {
      name: string;
      baseInoculumCfuMl: number;
      infectiousDose: number;
      susceptibilityFactor: number;
      hazardLevel: string;
    }> = {
      'salmonella-enterica': {
        name: 'Salmonella enterica',
        baseInoculumCfuMl: 10000000,
        infectiousDose: 50,
        susceptibilityFactor: 1.2,
        hazardLevel: 'Severe Enteritis & Reactive Arthritis'
      },
      'campylobacter-jejuni': {
        name: 'Campylobacter jejuni',
        baseInoculumCfuMl: 5000000,
        infectiousDose: 500,
        susceptibilityFactor: 1.8,
        hazardLevel: 'Acute Enteritis & Guillain-Barré Syndrome'
      },
      'escherichia-coli-o157': {
        name: 'E. coli O157:H7 (STEC)',
        baseInoculumCfuMl: 2000000,
        infectiousDose: 20,
        susceptibilityFactor: 1.1,
        hazardLevel: 'Hemorrhagic Colitis & HUS Kidney Failure'
      },
      'listeria-monocytogenes': {
        name: 'Listeria monocytogenes',
        baseInoculumCfuMl: 500000,
        infectiousDose: 100,
        susceptibilityFactor: 0.85,
        hazardLevel: 'Invasive Listeriosis, Sepsis & Miscarriage'
      },
      'staphylococcus-aureus': {
        name: 'Staphylococcus aureus',
        baseInoculumCfuMl: 8000000,
        infectiousDose: 100000,
        susceptibilityFactor: 0.75,
        hazardLevel: 'Heat-Stable Enterotoxin Emetic Shock'
      }
    };

    const wearConditions: Record<string, {
      name: string;
      depthMm: number;
      scarMultiplier: number;
    }> = {
      'pristine-oiled': { name: 'Pristine Oiled', depthMm: 0.1, scarMultiplier: 0.2 },
      'moderate-residential': { name: 'Moderate Residential', depthMm: 0.5, scarMultiplier: 0.6 },
      'heavily-gouged': { name: 'Heavily Gouged', depthMm: 1.8, scarMultiplier: 1.4 },
      'cracked-warped': { name: 'Cracked / Delaminated', depthMm: 3.0, scarMultiplier: 2.2 }
    };

    const protocols: Record<string, {
      name: string;
      woodLogKill: number;
      plasticLogKill: number;
      ruinsWood: boolean;
    }> = {
      'air-dry-ambient': { name: 'Air-Drying 12h', woodLogKill: 3.8, plasticLogKill: 0.6, ruinsWood: false },
      'soap-scrub-hot-water': { name: 'Hot Soap Scrub', woodLogKill: 4.2, plasticLogKill: 2.2, ruinsWood: false },
      'bleach-solution-200ppm': { name: '200ppm Bleach Soak', woodLogKill: 5.2, plasticLogKill: 4.8, ruinsWood: false },
      'h2o2-vinegar-two-step': { name: 'H2O2 + Vinegar Spray', woodLogKill: 5.5, plasticLogKill: 4.9, ruinsWood: false },
      'dishwasher-sanitize-cycle': { name: 'Dishwasher Sanitize', woodLogKill: 6.0, plasticLogKill: 5.8, ruinsWood: true },
      'cold-damp-cloth-wipe': { name: 'Cold Damp Cloth Wipe', woodLogKill: 0.2, plasticLogKill: -0.8, ruinsWood: false }
    };

    // DOM Elements
    const matSelect = root.querySelector('#board-material-select') as HTMLSelectElement;
    const patSelect = root.querySelector('#pathogen-select') as HTMLSelectElement;
    const wearSelect = root.querySelector('#wear-condition-select') as HTMLSelectElement;
    const protoSelect = root.querySelector('#protocol-select') as HTMLSelectElement;
    const volSlider = root.querySelector('#volume-slider') as HTMLInputElement;
    const timeSlider = root.querySelector('#time-slider') as HTMLInputElement;

    const volDisplay = root.querySelector('#volume-val-display') as HTMLElement;
    const timeDisplay = root.querySelector('#time-val-display') as HTMLElement;
    const matDesc = root.querySelector('#material-description') as HTMLElement;
    const patDesc = root.querySelector('#pathogen-hazard-desc') as HTMLElement;
    const wearDesc = root.querySelector('#wear-description') as HTMLElement;
    const protoDesc = root.querySelector('#protocol-description') as HTMLElement;

    const threatPill = root.querySelector('#threat-pill') as HTMLElement;
    const recoverableCfuVal = root.querySelector('#recoverable-cfu-val') as HTMLElement;
    const surfaceCfuCm2 = root.querySelector('#surface-cfu-cm2') as HTMLElement;
    const initialInoculumSub = root.querySelector('#initial-inoculum-sub') as HTMLElement;
    const capillaryTrapPct = root.querySelector('#capillary-trap-pct') as HTMLElement;
    const capillaryDepthVal = root.querySelector('#capillary-depth-val') as HTMLElement;
    const capillaryStatusSub = root.querySelector('#capillary-status-sub') as HTMLElement;
    const logKillVal = root.querySelector('#log-kill-val') as HTMLElement;
    const killPctVal = root.querySelector('#kill-pct-val') as HTMLElement;
    const fdaComplianceVal = root.querySelector('#fda-compliance-val') as HTMLElement;
    const boardHealthVal = root.querySelector('#board-health-val') as HTMLElement;

    const actionBanner = root.querySelector('#action-banner') as HTMLElement;
    const actionHeader = root.querySelector('#action-header') as HTMLElement;
    const actionText = root.querySelector('#action-text') as HTMLElement;

    const copyBtn = root.querySelector('#copy-report-btn') as HTMLButtonElement;
    const copyBtnText = root.querySelector('#copy-btn-text') as HTMLElement;

    function calculate() {
      const mat = materials[matSelect.value];
      const pat = pathogens[patSelect.value];
      const wear = wearConditions[wearSelect.value];
      const proto = protocols[protoSelect.value];
      const vol = parseFloat(volSlider.value);
      const hours = parseFloat(timeSlider.value);

      volDisplay.textContent = `${vol.toFixed(1)} mL`;
      timeDisplay.textContent = `${hours >= 1 ? hours.toFixed(1) + ' Hours' : (hours * 60).toFixed(0) + ' Mins'}`;

      matDesc.textContent = mat.description;
      patDesc.textContent = `Clinical Hazard: ${pat.hazardLevel} (Infectious Dose: ${pat.infectiousDose} CFU)`;
      wearDesc.textContent = `Knife Scar Depth: ~${wear.depthMm} mm | Scar Multiplier: ${wear.scarMultiplier}x`;
      protoDesc.textContent = `Sanitization Protocol: ${proto.name} (Dishwasher ruins wood: ${proto.ruinsWood ? 'YES' : 'NO'})`;

      // 1. Initial Inoculum
      const initialTotalCfu = pat.baseInoculumCfuMl * vol;
      initialInoculumSub.textContent = `Inoculated: ${initialTotalCfu.toLocaleString()} CFU (${vol} mL)`;

      // 2. Capillary Trapping Calculation
      let trappingPct = 0;
      let trapDepthMm = 0;

      if (mat.isWood) {
        // Wood draws fluid into xylem
        const oilProtectionDampener = wear.scarMultiplier > 1 ? 0.8 : 1.0;
        trappingPct = Math.min(99.9, mat.capillaryEfficiency * 100 * oilProtectionDampener);
        trapDepthMm = Math.min(3.5, 0.8 + (vol * 0.4) + (wear.depthMm * 0.5));
        capillaryStatusSub.textContent = 'Xylem Vascular Draw';
      } else if (mat.name.includes('Bamboo')) {
        trappingPct = 60.0;
        trapDepthMm = 0.5 + (wear.depthMm * 0.3);
        capillaryStatusSub.textContent = 'Vascular Bundle Trap';
      } else {
        // Plastic has ZERO capillary trapping
        trappingPct = 0.0;
        trapDepthMm = 0.0;
        capillaryStatusSub.textContent = 'Non-Porous Polymer';
      }

      capillaryTrapPct.textContent = `${trappingPct.toFixed(1)}%`;
      capillaryDepthVal.textContent = mat.isWood ? `Depth: ${trapDepthMm.toFixed(1)} mm` : (mat.name.includes('Bamboo') ? 'Seam Seepage' : 'Surface Pooled');

      // 3. Desiccation and Sanitizer Kill Calculation
      const desiccationLogKill = mat.isWood 
        ? Math.min(4.5, mat.desiccationRatePerHour * hours * pat.susceptibilityFactor)
        : Math.min(1.0, 0.04 * hours * pat.susceptibilityFactor);

      const sanitizerLogKill = mat.isWood ? proto.woodLogKill : proto.plasticLogKill;
      
      // Knife scar penalty on plastic
      let netScarPenalty = 0;
      if (!mat.isWood && protoSelect.value !== 'dishwasher-sanitize-cycle') {
        netScarPenalty = wear.scarMultiplier * 1.5;
      }

      let netLogKill = Math.max(0, (desiccationLogKill + sanitizerLogKill) - netScarPenalty);
      if (protoSelect.value === 'cold-damp-cloth-wipe') {
        netLogKill = 0.1;
      }

      logKillVal.textContent = `${netLogKill.toFixed(1)} Log`;
      const killPct = (1 - Math.pow(10, -netLogKill)) * 100;
      killPctVal.textContent = `${Math.min(99.9999, Math.max(0, killPct)).toFixed(4)}% Inactivated`;

      // 4. Recoverable Surface Pathogen Load
      // In wood, capillary trapping removes (trappingPct)% from the surface. In plastic, 100% stays on surface.
      const surfacePortionFraction = mat.isWood ? Math.max(0.001, (100 - trappingPct) / 100) : 1.0;
      const survivingFraction = Math.pow(10, -netLogKill);
      let recoverableSurfaceCfu = initialTotalCfu * surfacePortionFraction * survivingFraction;
      
      if (recoverableSurfaceCfu < 1) recoverableSurfaceCfu = 0;

      recoverableCfuVal.textContent = `${Math.round(recoverableSurfaceCfu).toLocaleString()} CFU`;
      const boardAreaCm2 = 900; // ~30cm x 30cm standard board
      const cfuPerCm2 = (recoverableSurfaceCfu / boardAreaCm2).toFixed(1);
      surfaceCfuCm2.textContent = `${cfuPerCm2} CFU/cm²`;

      // 5. Threat Evaluation & Banner
      if (proto.ruinsWood && mat.isWood) {
        threatPill.className = 'text-xs font-bold px-2.5 py-0.5 rounded-full bg-rose-600 text-white border border-rose-700';
        threatPill.textContent = 'CATASTROPHIC BOARD FAILURE';
        actionBanner.className = 'p-4 rounded-xl border border-rose-300 bg-rose-50 text-rose-950 mb-6';
        actionHeader.innerHTML = '<span>🚨</span> Irreversible Dishwasher Wood Rupture';
        actionText.textContent = 'WARNING: Dishwasher wash cycles destroy hardwood and bamboo boards! Heat spikes and harsh caustic detergents dissolve glue laminations, causing warp, cup, and gaping cracks that become permanent bio-shelters.';
        fdaComplianceVal.textContent = 'VIOLATION (CRACKED / ABSORBENT)';
        fdaComplianceVal.className = 'text-sm font-bold text-rose-700 font-mono';
        boardHealthVal.textContent = 'Fiber Health: Ruined (Warps & Splits)';
      } else if (recoverableSurfaceCfu > pat.infectiousDose * 100) {
        threatPill.className = 'text-xs font-bold px-2.5 py-0.5 rounded-full bg-rose-600 text-white border border-rose-700';
        threatPill.textContent = 'CRITICAL BIOHAZARD';
        actionBanner.className = 'p-4 rounded-xl border border-rose-300 bg-rose-50 text-rose-950 mb-6';
        actionHeader.innerHTML = '<span>⚠️</span> High-Risk Cross-Contamination Emergency';
        actionText.textContent = `DANGER: ${Math.round(recoverableSurfaceCfu).toLocaleString()} active CFU of ${pat.name} remain viable on the board surface. Slicing cucumbers, bread, or ready-to-eat foods here will deliver an infectious dose exceeding the threshold by ${Math.round(recoverableSurfaceCfu / pat.infectiousDose)}x. Mandatory 200 ppm bleach or hydrogen peroxide scrub required!`;
        fdaComplianceVal.textContent = 'NON-COMPLIANT (GROSS CONTAMINATION)';
        fdaComplianceVal.className = 'text-sm font-bold text-rose-700 font-mono';
        boardHealthVal.textContent = mat.isWood ? 'Fiber Health: Recondition & Oil' : 'Plastic Health: Discard & Replace';
      } else if (recoverableSurfaceCfu > pat.infectiousDose) {
        threatPill.className = 'text-xs font-bold px-2.5 py-0.5 rounded-full bg-amber-500 text-white border border-amber-600';
        threatPill.textContent = 'ELEVATED RISK';
        actionBanner.className = 'p-4 rounded-xl border border-amber-300 bg-amber-50 text-amber-950 mb-6';
        actionHeader.innerHTML = '<span>⚠️</span> Active Pathogen Dose Present';
        actionText.textContent = `CAUTION: Recoverable load (${Math.round(recoverableSurfaceCfu).toLocaleString()} CFU) exceeds minimum infectious dose (${pat.infectiousDose} CFU). Do not use for ready-to-eat foods. Apply hot soapy scrub and allow at least 6 hours of vertical air drying.`;
        fdaComplianceVal.textContent = 'CONDITIONAL USE ONLY';
        fdaComplianceVal.className = 'text-sm font-bold text-amber-700 font-mono';
        boardHealthVal.textContent = 'Fiber Health: Fair';
      } else {
        threatPill.className = 'text-xs font-bold px-2.5 py-0.5 rounded-full bg-emerald-600 text-white border border-emerald-700';
        threatPill.textContent = 'SAFE / SANITIZED';
        actionBanner.className = 'p-4 rounded-xl border border-emerald-300 bg-emerald-50 text-emerald-950 mb-6';
        actionHeader.innerHTML = '<span>🛡️</span> Sanitary Surface Verified';
        actionText.textContent = `VERIFIED: Board surface is safely decontaminated (<1 CFU/cm²). Natural capillary xylem desiccation and applied sanitization have neutralized the bacterial inoculum. Safe for ready-to-eat produce and raw meats.`;
        fdaComplianceVal.textContent = 'FDA 4-101.17 COMPLIANT';
        fdaComplianceVal.className = 'text-sm font-bold text-emerald-700 font-mono';
        boardHealthVal.textContent = 'Fiber Health: Optimal';
      }
    }

    // Presets Handlers
    const presetBtns = root.querySelectorAll('.preset-btn');
    presetBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const p = (btn as HTMLElement).dataset.preset;
        if (p === 'cliver-maple') {
          matSelect.value = 'end-grain-maple';
          patSelect.value = 'salmonella-enterica';
          wearSelect.value = 'moderate-residential';
          protoSelect.value = 'air-dry-ambient';
          volSlider.value = '1.0';
          timeSlider.value = '12.0';
        } else if (p === 'plastic-hazard') {
          matSelect.value = 'scratched-plastic-hdpe';
          patSelect.value = 'campylobacter-jejuni';
          wearSelect.value = 'heavily-gouged';
          protoSelect.value = 'cold-damp-cloth-wipe';
          volSlider.value = '2.0';
          timeSlider.value = '2.0';
        } else if (p === 'bamboo-dishwasher') {
          matSelect.value = 'laminated-bamboo';
          patSelect.value = 'escherichia-coli-o157';
          wearSelect.value = 'cracked-warped';
          protoSelect.value = 'dishwasher-sanitize-cycle';
          volSlider.value = '1.5';
          timeSlider.value = '2.0';
        } else if (p === 'commercial-teak') {
          matSelect.value = 'edge-grain-teak';
          patSelect.value = 'salmonella-enterica';
          wearSelect.value = 'moderate-residential';
          protoSelect.value = 'h2o2-vinegar-two-step';
          volSlider.value = '1.5';
          timeSlider.value = '0.5';
        } else if (p === 'pristine-acacia') {
          matSelect.value = 'end-grain-acacia';
          patSelect.value = 'listeria-monocytogenes';
          wearSelect.value = 'pristine-oiled';
          protoSelect.value = 'soap-scrub-hot-water';
          volSlider.value = '0.5';
          timeSlider.value = '4.0';
        }
        calculate();
      });
    });

    // Copy Report Event
    copyBtn.addEventListener('click', () => {
      const mat = materials[matSelect.value];
      const pat = pathogens[patSelect.value];
      const report = `=====================================================
ISITKITCHENSAFE CUTTING BOARD MICROBIOLOGY REPORT
Generated: ${new Date().toISOString()}
=====================================================
Board Substrate:        ${mat.name} (Janka Hardness: ${mat.janka} lbf)
Inoculated Pathogen:    ${pat.name} (${pat.hazardLevel})
Wear / Knife Scoring:   ${wearConditions[wearSelect.value].name} (${wearConditions[wearSelect.value].depthMm} mm deep)
Sanitization Applied:   ${protocols[protoSelect.value].name}
Inoculum Volume:        ${volSlider.value} mL
Elapsed Air Drying:     ${timeSlider.value} Hours

--- MICROBIOLOGICAL DIAGNOSTICS ---
Initial Bacterial Load: ${initialInoculumSub.textContent}
Capillary Trapping:     ${capillaryTrapPct.textContent} (${capillaryDepthVal.textContent})
Net Log Reduction:      ${logKillVal.textContent} (${killPctVal.textContent})
Recoverable Surface:    ${recoverableCfuVal.textContent} (${surfaceCfuCm2.textContent})
Cross-Contam Threat:    ${threatPill.textContent}
FDA Compliance:         ${fdaComplianceVal.textContent}

--- SANITARY DIRECTIVE ---
${actionText.textContent}
=====================================================`;

      navigator.clipboard.writeText(report).then(() => {
        const oldText = copyBtnText.textContent;
        copyBtnText.textContent = '✓ Copied to Clipboard!';
        setTimeout(() => {
          copyBtnText.textContent = oldText;
        }, 2500);
      });
    });

    // Change listeners
    [matSelect, patSelect, wearSelect, protoSelect, volSlider, timeSlider].forEach(el => {
      el.addEventListener('input', calculate);
      el.addEventListener('change', calculate);
    });

    // Initial calculation
    calculate();
  }

  // Auto-init on load or Astro view transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCuttingBoardModeler);
  } else {
    initCuttingBoardModeler();
  }
  document.addEventListener('astro:page-load', initCuttingBoardModeler);
</script>
