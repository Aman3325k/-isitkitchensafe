</div>

<script>
  import microfluidData from '../data/micro-fluidization-nano-encapsulation-data.json';

  function initMicrofluidizerModeler() {
    const root = document.getElementById('microfluidizer-modeler');
    if (!root) return;

    // Elements
    const systemSelect = document.getElementById('mf-system') as HTMLSelectElement;
    const chamberSelect = document.getElementById('mf-chamber') as HTMLSelectElement;
    const formulationSelect = document.getElementById('mf-formulation') as HTMLSelectElement;
    const coolingSelect = document.getElementById('mf-cooling') as HTMLSelectElement;
    const plungerSelect = document.getElementById('mf-plunger') as HTMLSelectElement;

    const pressureInput = document.getElementById('mf-pressure') as HTMLInputElement;
    const passesInput = document.getElementById('mf-passes') as HTMLInputElement;
    const inletTempInput = document.getElementById('mf-inlet-temp') as HTMLInputElement;
    const flowInput = document.getElementById('mf-flow') as HTMLInputElement;

    const pressureVal = document.getElementById('mf-pressure-val');
    const passesVal = document.getElementById('mf-passes-val');
    const inletTempVal = document.getElementById('mf-inlet-temp-val');
    const flowVal = document.getElementById('mf-flow-val');

    // Diagnostic Readouts
    const diagDropletVal = document.getElementById('diag-droplet-val');
    const diagPdiVal = document.getElementById('diag-pdi-val');
    const diagTargetVal = document.getElementById('diag-target-val');
    const diagVelocityVal = document.getElementById('diag-velocity-val');
    const diagMachVal = document.getElementById('diag-mach-val');
    const diagShearVal = document.getElementById('diag-shear-val');
    const diagEnergyVal = document.getElementById('diag-energy-val');
    const diagDeltaTVal = document.getElementById('diag-delta-t-val');
    const diagExitTempVal = document.getElementById('diag-exit-temp-val');
    const diagCoolingStatusVal = document.getElementById('diag-cooling-status-val');
    const diagRetentionVal = document.getElementById('diag-retention-val');
    const diagPlungerLifeBadge = document.getElementById('diag-plunger-life-badge');
    const diagPlungerBar = document.getElementById('diag-plunger-bar');
    const diagPlungerDesc = document.getElementById('diag-plunger-desc');
    const diagComplianceBadge = document.getElementById('diag-compliance-badge');
    const diagComplianceDesc = document.getElementById('diag-compliance-desc');
    const diagLimitationText = document.getElementById('diag-limitation-text');
    const diagActionText = document.getElementById('diag-action-text');
    const diagramStatusPill = document.getElementById('diagram-status-pill');

    function calculate() {
      const systemId = systemSelect?.value || 'm110p_pilot_dual_intensifier';
      const chamberId = chamberSelect?.value || 'y_type_opposing_jet_diamond';
      const formulationId = formulationSelect?.value || 'curcumin_phytosterol_nanoemulsion';
      const coolingId = coolingSelect?.value || 'sanitary_dual_stage_glycol_chiller';
      const plungerId = plungerSelect?.value || 'yttria_stabilized_zirconia';

      const pressure = parseFloat(pressureInput?.value || '1500');
      const passes = parseInt(passesInput?.value || '2', 10);
      const inletTemp = parseFloat(inletTempInput?.value || '20');
      const flowRate = parseFloat(flowInput?.value || '12');

      // Update Slider Display Text
      const psi = Math.round(pressure * 14.5038);
      if (pressureVal) pressureVal.textContent = `${pressure.toLocaleString()} bar (${psi.toLocaleString()} psi)`;
      if (passesVal) passesVal.textContent = `${passes} ${passes === 1 ? 'Pass' : 'Passes'}`;
      if (inletTempVal) inletTempVal.textContent = `${inletTemp}°C`;
      if (flowVal) flowVal.textContent = `${flowRate.toFixed(1)} L/h`;

      // Find Config Objects
      const system = microfluidData.microfluidizerSystems.find(s => s.id === systemId);
      const chamber = microfluidData.chamberGeometries.find(c => c.id === chamberId);
      const formulation = microfluidData.emulsionFormulations.find(f => f.id === formulationId);
      const cooling = microfluidData.coolingSystems.find(c => c.id === coolingId);
      const plunger = microfluidData.plungerMaterials.find(p => p.id === plungerId);

      // Jet Velocity calculation: v = Cd * sqrt(2 * DeltaP / rho)
      const deltaP_Pa = pressure * 1e5;
      const rho = 1000; // kg/m^3
      let cd = 0.92;
      if (chamberId === 'eroded_cracked_carbide_orifice') cd = 0.62;
      else if (chamberId === 'z_type_auxiliary_impact_diamond') cd = 0.88;

      let jetVelocity = cd * Math.sqrt((2 * deltaP_Pa) / rho);
      if (chamberId === 'eroded_cracked_carbide_orifice') jetVelocity *= 0.72; // pressure bypass loss

      const machNumber = jetVelocity / 1480; // Speed of sound in water ~1480 m/s

      // Shear Rate: gamma = v / dh
      const channelWidthM = (chamber?.channelWidthMicrons || 75) * 1e-6;
      const shearRate = jetVelocity / channelWidthM;

      // Energy Dissipation Rate: epsilon ~ DeltaP * v / (rho * L)
      let energyDissipation = (deltaP_Pa * jetVelocity) / (rho * 0.005);
      if (chamberId === 'eroded_cracked_carbide_orifice') energyDissipation *= 0.15;

      // Adiabatic Temp Rise: DeltaT = DeltaP / (rho * cp)
      const cp = 4184; // J/kg K
      const adiabaticRisePerPass = (deltaP_Pa / (rho * cp));
      const totalAdiabaticRise = adiabaticRisePerPass * Math.min(passes, 3); // cumulative unquenched heating

      // Quenched Exit Temperature
      let quenchCoolingFactor = 0.95; // Glycol chiller quenches 95% of heat spike
      if (coolingId === 'counter_flow_ice_water_jacket') quenchCoolingFactor = 0.70;
      else if (coolingId === 'ambient_air_fan_fin_skid') quenchCoolingFactor = 0.15;
      else if (coolingId === 'fouled_chiller_scale_lockup') quenchCoolingFactor = 0.02;

      let exitTemp = inletTemp + totalAdiabaticRise * (1 - quenchCoolingFactor);
      if (coolingId === 'sanitary_dual_stage_glycol_chiller') {
        exitTemp = Math.max(8.0, inletTemp + 4.0 + (pressure / 2000) * 4.0);
      }

      // Droplet Sizing Dv50 (nm)
      const baseTarget = formulation?.targetDropletSizeNm || 65.0;
      const pressureFactor = Math.pow(1500 / Math.max(300, pressure), 0.68);
      const passFactor = Math.pow(1 / passes, 0.28);
      let chamberFactor = 1.0;
      if (chamberId === 'z_type_auxiliary_impact_diamond') chamberFactor = 1.18; // Z is slightly less effective for liquid-liquid nano-emulsions than Y
      else if (chamberId === 'multi_slotted_parallel_y_diamond') chamberFactor = 1.02;
      else if (chamberId === 'eroded_cracked_carbide_orifice') chamberFactor = 3.85;

      let dropletSize = baseTarget * pressureFactor * passFactor * chamberFactor;
      if (chamberId === 'eroded_cracked_carbide_orifice') {
        dropletSize = Math.max(280.0, dropletSize);
      }

      // PDI Calculation
      let pdi = (formulation?.targetPdi || 0.11) + (passes > 1 ? -0.015 * Math.min(passes - 1, 3) : 0.06);
      if (pressure < 800) pdi += 0.08;
      if (chamberId === 'eroded_cracked_carbide_orifice') pdi = 0.58; // severe bimodal polydispersity
      pdi = Math.max(0.065, Math.min(0.65, pdi));

      // Bioactive Retention / Encapsulation Efficiency
      let retention = 98.8 - (passes - 1) * 0.4;
      if (exitTemp > 45) {
        retention -= (exitTemp - 45) * 1.6;
      }
      if (chamberId === 'eroded_cracked_carbide_orifice') retention -= 22;
      if (coolingId === 'fouled_chiller_scale_lockup') retention -= 38;
      retention = Math.max(15.0, Math.min(99.5, retention));

      // Plunger Life (Hours)
      let plungerLifeHours = plunger?.expectedServiceLifeHours || 3500;
      if (pressure > 1600) {
        plungerLifeHours *= Math.pow(1600 / pressure, 1.4);
      }
      if (plungerId === 'delaminated_scored_ceramic') plungerLifeHours = 0;
      else if (plungerId === 'hard_chrome_plated_316' && pressure > 1200) plungerLifeHours *= 0.45;

      // Update Diagnostics DOM
      if (diagDropletVal) {
        diagDropletVal.textContent = `${dropletSize.toFixed(1)} nm`;
        diagDropletVal.className = `text-2xl sm:text-3xl font-extrabold font-mono ${
          dropletSize < 100 ? 'text-emerald-600 dark:text-emerald-400' : dropletSize < 180 ? 'text-amber-600 dark:text-amber-400' : 'text-red-600 dark:text-red-400'
        }`;
      }

      if (diagPdiVal) {
        diagPdiVal.textContent = `PDI ${pdi.toFixed(3)}`;
        diagPdiVal.className = `text-xs font-mono font-medium ${
          pdi < 0.15 ? 'text-emerald-600 dark:text-emerald-400' : pdi < 0.25 ? 'text-amber-600 dark:text-amber-400' : 'text-red-600 dark:text-red-400'
        }`;
      }

      if (diagTargetVal) {
        diagTargetVal.textContent = `< ${baseTarget.toFixed(0)} nm (${pdi < 0.15 ? 'Monodisperse' : 'Polydisperse'})`;
      }

      if (diagVelocityVal) {
        diagVelocityVal.textContent = `${Math.round(jetVelocity)} m/s`;
      }

      if (diagMachVal) {
        diagMachVal.textContent = `Mach ${machNumber.toFixed(2)}`;
      }

      if (diagShearVal) {
        diagShearVal.textContent = `${(shearRate / 1e6).toFixed(1)} × 10⁶ s⁻¹`;
      }

      if (diagEnergyVal) {
        const mantissa = (energyDissipation / 1e8).toFixed(2);
        diagEnergyVal.textContent = `${mantissa} × 10⁸`;
      }

      if (diagDeltaTVal) {
        diagDeltaTVal.textContent = `+${totalAdiabaticRise.toFixed(1)}°C Spike`;
      }

      if (diagExitTempVal) {
        diagExitTempVal.textContent = `${exitTemp.toFixed(1)}°C`;
        diagExitTempVal.className = `text-2xl sm:text-3xl font-extrabold font-mono ${
          exitTemp <= 20 ? 'text-emerald-600 dark:text-emerald-400' : exitTemp <= 45 ? 'text-amber-600 dark:text-amber-400' : 'text-red-600 dark:text-red-400'
        }`;
      }

      if (diagCoolingStatusVal) {
        diagCoolingStatusVal.textContent = exitTemp <= 20 ? 'Quenched (Safe)' : exitTemp <= 45 ? 'Warm (Monitor)' : 'SCORCHING RISK';
      }

      if (diagRetentionVal) {
        diagRetentionVal.textContent = `${retention.toFixed(1)}% Retained`;
        diagRetentionVal.className = `font-mono font-bold ${
          retention >= 90 ? 'text-emerald-600 dark:text-emerald-400' : retention >= 75 ? 'text-amber-600 dark:text-amber-400' : 'text-red-600 dark:text-red-400'
        }`;
      }

      // Plunger Life Display
      if (diagPlungerLifeBadge && diagPlungerBar && diagPlungerDesc) {
        const pct = Math.min(100, Math.round((plungerLifeHours / 3500) * 100));
        diagPlungerBar.style.width = `${pct}%`;

        if (plungerLifeHours > 2000) {
          diagPlungerLifeBadge.textContent = `OPTIMAL (${Math.round(plungerLifeHours)} h)`;
          diagPlungerLifeBadge.className = 'px-2 py-0.5 rounded text-xs font-mono font-bold bg-emerald-100 text-emerald-800 dark:bg-emerald-950/50 dark:text-emerald-300';
          diagPlungerBar.className = 'bg-emerald-500 h-2 rounded-full transition-all duration-300';
          diagPlungerDesc.textContent = `${plunger?.name.split('(')[0]}: Wear rates minimal. Spring-energized UHMWPE seals intact with zero blow-by.`;
        } else if (plungerLifeHours > 500) {
          diagPlungerLifeBadge.textContent = `ACCEPTABLE (${Math.round(plungerLifeHours)} h)`;
          diagPlungerLifeBadge.className = 'px-2 py-0.5 rounded text-xs font-mono font-bold bg-amber-100 text-amber-800 dark:bg-amber-950/50 dark:text-amber-300';
          diagPlungerBar.className = 'bg-amber-500 h-2 rounded-full transition-all duration-300';
          diagPlungerDesc.textContent = `Accelerated seal wear. Inspect plunger alignment and rod packing seals every 500 operating hours.`;
        } else {
          diagPlungerLifeBadge.textContent = `REPLACE IMMEDIATELY (0 h)`;
          diagPlungerLifeBadge.className = 'px-2 py-0.5 rounded text-xs font-mono font-bold bg-red-100 text-red-800 dark:bg-red-950/50 dark:text-red-300';
          diagPlungerBar.className = 'bg-red-500 h-2 rounded-full transition-all duration-300';
          diagPlungerDesc.textContent = `CRITICAL PLUNGER DEFECT: Severe axial scoring, chrome flaking, or blown seals causing hydraulic fluid contamination.`;
        }
      }

      // Compliance Status
      if (diagComplianceBadge && diagComplianceDesc) {
        if (chamberId !== 'eroded_cracked_carbide_orifice' && coolingId !== 'fouled_chiller_scale_lockup' && plungerId !== 'delaminated_scored_ceramic' && exitTemp < 48) {
          diagComplianceBadge.textContent = '3-A 04-05 / EHEDG CLASS 1';
          diagComplianceBadge.className = 'px-2 py-0.5 rounded text-xs font-mono font-bold bg-emerald-100 text-emerald-800 dark:bg-emerald-950/50 dark:text-emerald-300';
          diagComplianceDesc.textContent = 'Full compliance with 3-A Sanitary Standard 04-05, EHEDG Doc 8 & 17 cleanability, and ASME BPE-2022 aseptic standards.';
        } else {
          diagComplianceBadge.textContent = 'NON-COMPLIANT / DEFECTIVE';
          diagComplianceBadge.className = 'px-2 py-0.5 rounded text-xs font-mono font-bold bg-red-100 text-red-800 dark:bg-red-950/50 dark:text-red-300';
          diagComplianceDesc.textContent = 'Breach of cGMP 21 CFR § 117 / 3-A Standards due to particle shedding, thermal degradation, or unquenched product scorching.';
        }
      }

      // Limitation & Action Texts
      if (diagLimitationText && diagActionText) {
        if (chamberId === 'eroded_cracked_carbide_orifice') {
          diagLimitationText.textContent = 'Chamber orifice cavitation erosion and bypass flow stalling.';
          diagActionText.textContent = 'ACTION: Replace damaged interaction chamber with laser-cut polycrystalline diamond F12Y core.';
        } else if (coolingId === 'fouled_chiller_scale_lockup' || exitTemp > 50) {
          diagLimitationText.textContent = `Severe product thermal scorching (${exitTemp.toFixed(1)}°C exit temperature).`;
          diagActionText.textContent = 'ACTION: Clean-in-place (CIP) descaling of heat exchanger; verify -5°C glycol flow rate > 1,200 L/h.';
        } else if (pressure < 800) {
          diagLimitationText.textContent = 'Sub-optimal operating pressure; insufficient Kolmogorov micro-eddy energy.';
          diagActionText.textContent = 'ACTION: Increase hydraulic pressure to > 1,200 bar for sub-80 nm monodisperse emulsification.';
        } else {
          diagLimitationText.textContent = 'Uniform high-shear dissipation in diamond micro-channels; optimal in-line quench.';
          diagActionText.textContent = 'ACTION: Maintain steady feed flow and schedule periodic plunger seal inspection per 3-A guidelines.';
        }
      }

      // Diagram Status Pill
      if (diagramStatusPill) {
        if (chamberId === 'eroded_cracked_carbide_orifice' || coolingId === 'fouled_chiller_scale_lockup') {
          diagramStatusPill.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-bold bg-red-100 text-red-800 dark:bg-red-950/60 dark:text-red-300';
          diagramStatusPill.innerHTML = '<span class="w-2 h-2 rounded-full bg-red-500 animate-ping"></span> COLLISION: DEGRADED';
        } else {
          diagramStatusPill.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-bold bg-emerald-100 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300';
          diagramStatusPill.innerHTML = `<span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> COLLISION: OPTIMAL (${Math.round(jetVelocity)} m/s)`;
        }
      }
    }

    // Event Listeners for Controls
    [systemSelect, chamberSelect, formulationSelect, coolingSelect, plungerSelect].forEach(select => {
      select?.addEventListener('change', calculate);
    });

    [pressureInput, passesInput, inletTempInput, flowInput].forEach(slider => {
      slider?.addEventListener('input', calculate);
    });

    // Preset Buttons
    root.querySelectorAll('.preset-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const preset = btn.getAttribute('data-preset');
        if (preset === 'curcumin') {
          systemSelect.value = 'm110p_pilot_dual_intensifier';
          chamberSelect.value = 'y_type_opposing_jet_diamond';
          formulationSelect.value = 'curcumin_phytosterol_nanoemulsion';
          coolingSelect.value = 'sanitary_dual_stage_glycol_chiller';
          plungerSelect.value = 'yttria_stabilized_zirconia';
          pressureInput.value = '1500';
          passesInput.value = '2';
          inletTempInput.value = '20';
          flowInput.value = '12';
        } else if (preset === 'omega3') {
          systemSelect.value = 'm110p_pilot_dual_intensifier';
          chamberSelect.value = 'y_type_opposing_jet_diamond';
          formulationSelect.value = 'dha_epa_omega3_liposome';
          coolingSelect.value = 'sanitary_dual_stage_glycol_chiller';
          plungerSelect.value = 'yttria_stabilized_zirconia';
          pressureInput.value = '1000';
          passesInput.value = '3';
          inletTempInput.value = '12';
          flowInput.value = '10';
        } else if (preset === 'beverage') {
          systemSelect.value = 'm110p_pilot_dual_intensifier';
          chamberSelect.value = 'y_type_opposing_jet_diamond';
          formulationSelect.value = 'vitamin_d3_flavor_beverage_dispersion';
          coolingSelect.value = 'sanitary_dual_stage_glycol_chiller';
          plungerSelect.value = 'high_purity_alpha_alumina';
          pressureInput.value = '1800';
          passesInput.value = '3';
          inletTempInput.value = '15';
          flowInput.value = '12';
        } else if (preset === 'industrial') {
          systemSelect.value = 'm700_industrial_multi_channel';
          chamberSelect.value = 'multi_slotted_parallel_y_diamond';
          formulationSelect.value = 'curcumin_phytosterol_nanoemulsion';
          coolingSelect.value = 'sanitary_dual_stage_glycol_chiller';
          plungerSelect.value = 'yttria_stabilized_zirconia';
          pressureInput.value = '1250';
          passesInput.value = '2';
          inletTempInput.value = '18';
          flowInput.value = '950';
        } else if (preset === 'hazard') {
          systemSelect.value = 'compromised_cavitated_chamber_skid';
          chamberSelect.value = 'eroded_cracked_carbide_orifice';
          formulationSelect.value = 'dha_epa_omega3_liposome';
          coolingSelect.value = 'fouled_chiller_scale_lockup';
          plungerSelect.value = 'delaminated_scored_ceramic';
          pressureInput.value = '850';
          passesInput.value = '4';
          inletTempInput.value = '25';
          flowInput.value = '6';
        }
        calculate();
      });
    });

    // Initial run
    calculate();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMicrofluidizerModeler);
  } else {
    initMicrofluidizerModeler();
  }
</script>
