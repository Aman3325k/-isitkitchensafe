    controlsSub: "油圧増圧ポンプ構造、ダイヤモンド相互作用チャンバー微細流路幾何学、生理活性成分処方、インライン冷却システム、プランジャー材質、均質化圧力、パス回数、供給温度を設定します。",
    systemLabel: "プロセッサー＆増圧ポンプ構成：",
    systemHelp: "サニタリーパイロット機 (M-110P)、大容量連続生産スキッド (M-700)、微量研究用卓上機 (LV1)、またはキャビテーション破損スキッドを選択。",
    chamberLabel: "ダイヤモンド相互作用チャンバー流路形状：",
    chamberHelp: "Y型対向衝突ジェットチャンバー (75 µm)、Z型ジグザグ高速衝突チャンバー (100 µm)、多流路並列ダイヤモンドアレイ (8 x 87 µm)、または破損オリフィスを選択。",
    formulationLabel: "対象生理活性成分＆界面活性剤キャリア：",
    formulationHelp: "クルクミン/植物ステロール MCT ナノエマルション、オメガ-3 DHA/EPA リン脂質リポソーム、ビタミン D3 透明飲料ナノ分散系、またはカゼイン複合体を選択。",
    coolingLabel: "インライン熱交換器＆急速クエンチシステム：",
    coolingHelp: "サニタリー二段インライングリコール冷却器 (-5°C)、向流氷水ジャケット (3°C)、自然空冷配管、またはファウリング閉塞冷却器を選択。",
    plungerLabel: "超高圧セラミックプランジャー材質＆表面粗さ：",
    plungerHelp: "イットリア安定化ジルコニア (Y-TZP, Ra < 0.03 µm)、高純度焼結アルミナ、硬質クロムメッキ 316L、または摩耗キズ付きセラミックを選択。",
    pressureLabel: "均質化運転圧力 (bar)：",
    pressureHelp: "流体をダイヤモンド流路に加速噴出させる油圧超高圧。ジェット速度 (300-500+ m/s) と空間エネルギー散逸率を決定します。",
    passesLabel: "均質化処理パス回数 (Passes)：",
    passesHelp: "ダイヤモンド流路を通過させる個別循環サイクル数。粒度分布の多分散指数 (PDI) を劇的にシャープ化します。",
    inletTempLabel: "原料プレミックス供給温度 (°C)：",
    inletTempHelp: "高圧シリンダーに入る粗エマルションの初期温度。粘度や界面張力、熱感受性成分の初期活性に影響します。",
    flowRateLabel: "連続処理流量 (L/h)：",
    flowRateHelp: "ダイヤモンド微細ノズルを通過する全流体体積流量。",
    presetsTitle: "標準産業用ナノカプセル化＆検証プリセット",
    presetCurcumin: "クルクミン透明ナノエマルション sub-70 nm (1,500 bar, 2パス, Y型, グリコール急冷)",
    presetOmega3: "オメガ-3 DHA/EPA 低温リポソーム包括 (1,000 bar, 3パス, Y型, グリコール急冷)",
    presetBeverage: "高透明ビタミン D3 飲料用ナノ分散液 (1,800 bar, 3パス, Y型, インライン冷却)",
    presetIndustrial: "大容量連続飲料生産スキッド (1,250 bar, 2パス, 多流路並列 Y型アレイ)",
    presetHazard: "熱劣化＆プランジャー高圧リーク危険状態 (850 bar, 4パス, 破損オリフィス, 閉塞冷却器)",
    diagnosticTitle: "ナノスケール粒子破壊＆工学総合診断",
    diagnosticSub: "メディアン粒子径 (Dv50)、多分散指数 (PDI)、ジェット噴出流速、空間エネルギー散逸率、粘性発熱昇温、活性成分保持率、プランジャー寿命をリアルタイム計算。",
    dropletSizeLabel: "メディアン液滴 / 小胞粒子径 (Dv50)",
    jetVelocityLabel: "微細流路ジェット出口ピーク流速",
    shearRateLabel: "微細流路局所せん断速度 (γ̇)",
    energyDissipationLabel: "空間エネルギー散逸率 (ε)",
    exitTempLabel: "急速冷却後最終出口製品温度",
    retentionLabel: "生理活性成分保持率 / カプセル化率",
    sealLifeLabel: "プランジャーシール耐摩耗寿命マージン",
    complianceStatusLabel: "サニタリー設計＆法規制準拠状態",
    primaryLimitationLabel: "主要流体工学＆熱力学的ボトルネック",
    mitigationActionLabel: "推奨サニタリーエンジニアリング対策",
    scienceTitle: "マイクロフルイディクス衝突物理学＆ナノカプセル化速度論",
    scienceSub: "ダイヤモンド流路内の流体力学、コルモゴロフ乱流渦破壊理論、リン脂質自己組織化、および断熱粘性発熱制御の技術解説。",
    tableTitle: "マイクロフルイダイザー仕様＆処方パラメータ一覧"
  }
};

const d = DICT[lang] || DICT.en;
---

<div class="bg-surface border border-hairline rounded-3xl p-6 sm:p-8 lg:p-10 shadow-sm transition-all" id="microfluidizer-modeler">
  <!-- Header -->
  <div class="mb-8 border-b border-hairline pb-6">
    <div class="flex items-center gap-3 mb-3">
      <span class="inline-block px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-violet-600 text-white">
        {d.badge}
      </span>
      <span class="text-xs text-muted font-mono">
        3-A Sanitary 04-05 &bull; EHEDG Doc 8 &amp; 17 &bull; ASME B31.3 Ch IX
      </span>
    </div>
    <h1 class="text-2xl sm:text-3xl lg:text-4xl font-semibold text-ink tracking-tight">
      {d.title}
    </h1>
    <p class="text-body text-sm sm:text-base leading-relaxed mt-2 max-w-5xl">
      {d.subtitle}
    </p>
  </div>

  <!-- Presets -->
  <div class="mb-8 bg-surface-soft border border-hairline rounded-2xl p-4 sm:p-5">
    <h2 class="text-xs font-bold uppercase tracking-wider text-muted mb-3">
      {d.presetsTitle}
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2.5">
      <button 
        type="button" 
        data-preset="curcumin" 
        class="preset-btn text-left p-2.5 rounded-xl text-xs font-medium bg-white dark:bg-surface border border-hairline hover:border-violet-500 hover:text-violet-600 dark:hover:text-violet-400 transition-colors shadow-2xs"
      >
        <span class="block font-bold text-ink mb-0.5">🌟 {d.presetCurcumin.split('(')[0]}</span>
        <span class="text-muted block truncate">({d.presetCurcumin.split('(')[1]}</span>
      </button>

      <button 
        type="button" 
        data-preset="omega3" 
        class="preset-btn text-left p-2.5 rounded-xl text-xs font-medium bg-white dark:bg-surface border border-hairline hover:border-violet-500 hover:text-violet-600 dark:hover:text-violet-400 transition-colors shadow-2xs"
      >
        <span class="block font-bold text-ink mb-0.5">🧬 {d.presetOmega3.split('(')[0]}</span>
        <span class="text-muted block truncate">({d.presetOmega3.split('(')[1]}</span>
      </button>

      <button 
        type="button" 
        data-preset="beverage" 
        class="preset-btn text-left p-2.5 rounded-xl text-xs font-medium bg-white dark:bg-surface border border-hairline hover:border-violet-500 hover:text-violet-600 dark:hover:text-violet-400 transition-colors shadow-2xs"
      >
        <span class="block font-bold text-ink mb-0.5">🥤 {d.presetBeverage.split('(')[0]}</span>
        <span class="text-muted block truncate">({d.presetBeverage.split('(')[1]}</span>
      </button>

      <button 
        type="button" 
        data-preset="industrial" 
        class="preset-btn text-left p-2.5 rounded-xl text-xs font-medium bg-white dark:bg-surface border border-hairline hover:border-violet-500 hover:text-violet-600 dark:hover:text-violet-400 transition-colors shadow-2xs"
      >
        <span class="block font-bold text-ink mb-0.5">🏭 {d.presetIndustrial.split('(')[0]}</span>
        <span class="text-muted block truncate">({d.presetIndustrial.split('(')[1]}</span>
      </button>

      <button 
        type="button" 
        data-preset="hazard" 
        class="preset-btn text-left p-2.5 rounded-xl text-xs font-medium bg-red-50 dark:bg-red-950/30 border border-red-200 dark:border-red-900/50 text-red-700 dark:text-red-400 hover:bg-red-100 transition-colors sm:col-span-2 lg:col-span-1 shadow-2xs"
      >
        <span class="block font-bold mb-0.5">🚨 {d.presetHazard.split('(')[0]}</span>
        <span class="text-red-600/80 dark:text-red-400/80 block truncate">({d.presetHazard.split('(')[1]}</span>
      </button>
    </div>
  </div>

  <!-- Interactive Controls Grid -->
  <div class="mb-10 bg-surface-soft border border-hairline rounded-3xl p-6 sm:p-8">
    <div class="mb-6">
      <h2 class="text-lg font-bold text-ink tracking-tight">{d.controlsTitle}</h2>
      <p class="text-xs text-muted mt-1">{d.controlsSub}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- System Architecture Select -->
      <div>
        <label for="mf-system" class="block text-xs font-bold uppercase tracking-wider text-muted mb-2">
          {d.systemLabel}
        </label>
        <select id="mf-system" class="w-full bg-white dark:bg-surface border border-hairline rounded-xl px-3.5 py-2.5 text-xs text-ink focus:outline-none focus:ring-2 focus:ring-violet-500 shadow-2xs">
          {microfluidData.microfluidizerSystems.map(s => (
            <option value={s.id}>{s.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1.5">{d.systemHelp}</p>
      </div>

      <!-- Chamber Geometry Select -->
      <div>
        <label for="mf-chamber" class="block text-xs font-bold uppercase tracking-wider text-muted mb-2">
          {d.chamberLabel}
        </label>
        <select id="mf-chamber" class="w-full bg-white dark:bg-surface border border-hairline rounded-xl px-3.5 py-2.5 text-xs text-ink focus:outline-none focus:ring-2 focus:ring-violet-500 shadow-2xs">
          {microfluidData.chamberGeometries.map(c => (
            <option value={c.id}>{c.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1.5">{d.chamberHelp}</p>
      </div>

      <!-- Formulation Matrix Select -->
      <div>
        <label for="mf-formulation" class="block text-xs font-bold uppercase tracking-wider text-muted mb-2">
          {d.formulationLabel}
        </label>
        <select id="mf-formulation" class="w-full bg-white dark:bg-surface border border-hairline rounded-xl px-3.5 py-2.5 text-xs text-ink focus:outline-none focus:ring-2 focus:ring-violet-500 shadow-2xs">
          {microfluidData.emulsionFormulations.map(f => (
            <option value={f.id}>{f.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1.5">{d.formulationHelp}</p>
      </div>

      <!-- Cooling System Select -->
      <div>
        <label for="mf-cooling" class="block text-xs font-bold uppercase tracking-wider text-muted mb-2">
          {d.coolingLabel}
        </label>
        <select id="mf-cooling" class="w-full bg-white dark:bg-surface border border-hairline rounded-xl px-3.5 py-2.5 text-xs text-ink focus:outline-none focus:ring-2 focus:ring-violet-500 shadow-2xs">
          {microfluidData.coolingSystems.map(c => (
            <option value={c.id}>{c.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1.5">{d.coolingHelp}</p>
      </div>

      <!-- Plunger Metallurgy Select -->
      <div>
        <label for="mf-plunger" class="block text-xs font-bold uppercase tracking-wider text-muted mb-2">
          {d.plungerLabel}
        </label>
        <select id="mf-plunger" class="w-full bg-white dark:bg-surface border border-hairline rounded-xl px-3.5 py-2.5 text-xs text-ink focus:outline-none focus:ring-2 focus:ring-violet-500 shadow-2xs">
          {microfluidData.plungerMaterials.map(p => (
            <option value={p.id}>{p.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1.5">{d.plungerHelp}</p>
      </div>

      <!-- Pressure Slider -->
      <div>
        <div class="flex justify-between items-center mb-2">
          <label for="mf-pressure" class="text-xs font-bold uppercase tracking-wider text-muted">
            {d.pressureLabel}
          </label>
          <span id="mf-pressure-val" class="text-xs font-mono font-bold text-violet-600 dark:text-violet-400 bg-violet-50 dark:bg-violet-950/40 px-2 py-0.5 rounded-md">
            1,500 bar (21,755 psi)
          </span>
        </div>
        <input 
          type="range" 
          id="mf-pressure" 
          min="200" 
          max="2070" 
          step="50" 
          value="1500" 
          class="w-full accent-violet-600 cursor-pointer"
        />
        <p class="text-[11px] text-muted mt-1.5">{d.pressureHelp}</p>
      </div>

      <!-- Passes Slider -->
      <div>
        <div class="flex justify-between items-center mb-2">
          <label for="mf-passes" class="text-xs font-bold uppercase tracking-wider text-muted">
            {d.passesLabel}
          </label>
          <span id="mf-passes-val" class="text-xs font-mono font-bold text-violet-600 dark:text-violet-400 bg-violet-50 dark:bg-violet-950/40 px-2 py-0.5 rounded-md">
            2 Passes
          </span>
        </div>
        <input 
          type="range" 
          id="mf-passes" 
          min="1" 
          max="8" 
          step="1" 
          value="2" 
          class="w-full accent-violet-600 cursor-pointer"
        />
        <p class="text-[11px] text-muted mt-1.5">{d.passesHelp}</p>
      </div>

      <!-- Inlet Feed Temp Slider -->
      <div>
        <div class="flex justify-between items-center mb-2">
          <label for="mf-inlet-temp" class="text-xs font-bold uppercase tracking-wider text-muted">
            {d.inletTempLabel}
          </label>
          <span id="mf-inlet-temp-val" class="text-xs font-mono font-bold text-violet-600 dark:text-violet-400 bg-violet-50 dark:bg-violet-950/40 px-2 py-0.5 rounded-md">
            20°C
          </span>
        </div>
        <input 
          type="range" 
          id="mf-inlet-temp" 
          min="5" 
          max="50" 
          step="1" 
          value="20" 
          class="w-full accent-violet-600 cursor-pointer"
        />
        <p class="text-[11px] text-muted mt-1.5">{d.inletTempHelp}</p>
      </div>

      <!-- Continuous Flow Rate (Readout / Modifier) -->
      <div>
        <div class="flex justify-between items-center mb-2">
          <label for="mf-flow" class="text-xs font-bold uppercase tracking-wider text-muted">
            {d.flowRateLabel}
          </label>
          <span id="mf-flow-val" class="text-xs font-mono font-bold text-violet-600 dark:text-violet-400 bg-violet-50 dark:bg-violet-950/40 px-2 py-0.5 rounded-md">
            12.0 L/h
          </span>
        </div>
        <input 
          type="range" 
          id="mf-flow" 
          min="2" 
          max="1200" 
          step="2" 
          value="12" 
          class="w-full accent-violet-600 cursor-pointer"
        />
        <p class="text-[11px] text-muted mt-1.5">{d.flowRateHelp}</p>
      </div>
    </div>
  </div>

  <!-- Interactive SVG Schematic Diagram of Diamond Interaction Chamber -->
  <div class="mb-10 bg-surface-soft border border-hairline rounded-3xl p-6 sm:p-8">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6">
      <div>
        <h2 class="text-sm font-bold uppercase tracking-wider text-ink">
          Diamond Micro-Channel Jet Collision &amp; In-Line Rapid Quench Dynamics
        </h2>
        <p class="text-xs text-muted mt-0.5">
          Real-time kinematic visualization of ultra-high pressure flow splitting, frontal collision, sub-100 nm droplet breakup, and thermal cooling.
        </p>
      </div>
      <span id="diagram-status-pill" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-bold bg-emerald-100 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        COLLISION: OPTIMAL (465 m/s)
      </span>
    </div>

    <div class="w-full overflow-hidden rounded-2xl bg-slate-900 border border-slate-800 p-4 relative">
      <svg viewBox="0 0 900 320" class="w-full h-auto max-h-[340px]" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <!-- Gradients -->
          <linearGradient id="inletFlowGrad" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#38bdf8" />
            <stop offset="100%" stop-color="#818cf8" />
          </linearGradient>
          <linearGradient id="diamondGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#e0e7ff" />
            <stop offset="50%" stop-color="#a5b4fc" />
            <stop offset="100%" stop-color="#6366f1" />
          </linearGradient>
          <linearGradient id="collisionZoneGrad" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#f43f5e" />
            <stop offset="50%" stop-color="#fbbf24" />
            <stop offset="100%" stop-color="#f43f5e" />
          </linearGradient>
          <linearGradient id="chillerGrad" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#0284c7" />
            <stop offset="100%" stop-color="#06b6d4" />
          </linearGradient>
        </defs>

        <!-- Background grid lines -->
        <g stroke="#334155" stroke-width="0.5" stroke-dasharray="4 4" opacity="0.4">
          <line x1="50" y1="50" x2="850" y2="50" />
          <line x1="50" y1="160" x2="850" y2="160" />
          <line x1="50" y1="270" x2="850" y2="270" />
          <line x1="200" y1="20" x2="200" y2="300" />
          <line x1="420" y1="20" x2="420" y2="300" />
          <line x1="680" y1="20" x2="680" y2="300" />
        </g>

        <!-- Stage 1: High Pressure Inlet Feed Stream -->
        <path d="M 50 160 L 180 160" stroke="url(#inletFlowGrad)" stroke-width="24" stroke-linecap="round" />
        <text x="60" y="130" fill="#38bdf8" font-size="11" font-family="monospace" font-weight="bold">HIGH-PRESSURE INFLOW (ΔP up to 200 MPa)</text>

        <!-- Stage 2: Flow Split Y-Channels -->
        <path d="M 180 160 Q 220 160 250 90 L 330 90 Q 360 90 380 140" fill="none" stroke="#818cf8" stroke-width="8" stroke-linecap="round" />
        <path d="M 180 160 Q 220 160 250 230 L 330 230 Q 360 230 380 180" fill="none" stroke="#818cf8" stroke-width="8" stroke-linecap="round" />

        <!-- Diamond Micro-Channel Blocks -->
        <polygon points="320,60 380,60 400,110 340,110" fill="url(#diamondGrad)" opacity="0.85" stroke="#c7d2fe" stroke-width="1.5" />
        <polygon points="320,260 380,260 400,210 340,210" fill="url(#diamondGrad)" opacity="0.85" stroke="#c7d2fe" stroke-width="1.5" />
        <text x="325" y="48" fill="#e0e7ff" font-size="10" font-family="sans-serif" font-weight="bold">POLYCRYSTALLINE DIAMOND</text>

        <!-- Stage 3: Opposing Impinging Jets Frontal Collision Zone -->
        <circle cx="410" cy="160" r="32" fill="url(#collisionZoneGrad)" opacity="0.3" class="animate-pulse" />
        <circle cx="410" cy="160" r="18" fill="#f59e0b" opacity="0.8" />
        <circle cx="410" cy="160" r="8" fill="#ffffff" />

        <!-- Colliding Jet arrows -->
        <line x1="380" y1="135" x2="405" y2="155" stroke="#ef4444" stroke-width="5" stroke-linecap="round" />
        <line x1="380" y1="185" x2="405" y2="165" stroke="#ef4444" stroke-width="5" stroke-linecap="round" />

        <text x="380" y="210" fill="#facc15" font-size="11" font-family="monospace" font-weight="bold">FRONTAL COLLISION</text>
        <text x="380" y="226" fill="#cbd5e1" font-size="9" font-family="sans-serif">v &gt; 400 m/s &bull; ε &gt; 10⁷ W/kg</text>

        <!-- Stage 4: High Shear Dispersion Jet Exit -->
        <path d="M 430 160 L 520 160" stroke="#f97316" stroke-width="14" stroke-linecap="round" />
        <text x="440" y="142" fill="#fb923c" font-size="9" font-family="monospace" font-weight="bold">ΔT: +28°C</text>

        <!-- Stage 5: In-Line Sanitary Glycol Quench Chiller -->
        <rect x="520" y="110" width="180" height="100" rx="14" fill="#0f172a" stroke="url(#chillerGrad)" stroke-width="2.5" />
        
        <!-- Cooling serpentine pipes inside chiller -->
        <path d="M 540 130 C 580 130, 580 150, 540 150 C 580 150, 580 170, 540 170 C 580 170, 580 190, 540 190" fill="none" stroke="#38bdf8" stroke-width="3" stroke-linecap="round" />
        <path d="M 680 130 C 640 130, 640 150, 680 150 C 640 150, 640 170, 680 170 C 640 170, 640 190, 680 190" fill="none" stroke="#38bdf8" stroke-width="3" stroke-linecap="round" />
        
        <path d="M 530 160 L 690 160" stroke="#38bdf8" stroke-width="8" stroke-linecap="round" />
