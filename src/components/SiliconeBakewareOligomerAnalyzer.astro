    rule4Text: "虽然商家常宣传可耐受 260°C，但在 220°C 以上聚二甲基硅氧烷 (PDMS) 的主链断裂与热氧老化速度剧增，容易释放微量二氧化硅粉尘及挥发副产物。",
    rule5Title: "5. 严禁使用钢丝球或强力研磨性清洁工具",
    rule5Text: "粗糙的磨损会在硅胶表面制造微观划痕，增大油脂与化学浸润面积。请使用中性洗洁精与柔软海绵清洗，或置于洗碗机顶层清洗。",
    copyReportBtn: "📋 复制诊断遥测报告",
    reportCopied: "✓ 报告已成功复制到剪贴板！",
    crossLinkTitle: "探索更多厨房化学迁移与安全工具",
    crossLinkMigration: "食品接触材料化学迁移扩散预测器",
    crossLinkAirFryer: "空气炸锅丙烯酰胺生成与美拉德反应计算器",
    crossLinkSwap: "安全厨具健康材质智能置换计算器"
  },
  ja: {
    badge: "高分子物理学＆食品接触毒性学",
    title: "シリコン製調理器具・型 環状シロキサン熱分解＆揮発リスク解析シミュレーター",
    subtitle: "環状シロキサンオリゴマー（D4、D5、D6）の熱揮発、油脂への化学移行キネティクス、後硬化ベーキング純度を精密算出。",
    controlsTitle: "シリコン素材・硬化方式＆加熱条件設定",
    controlsSub: "白金付加硬化 vs 過酸化物加硫、油脂割合、焼成温度、ピンチテスト結果を設定し、独BfRおよび米FDA規格に基づいて安全性を評価します。",
    cureLabel: "シリコン種別＆硬化触媒テクノロジー",
    cureHelp: "白金触媒液状シリコーン（LSR）は揮発性不純物が極めて微量ですが、安価な過酸化物硬化品は低分子シロキサンや有機酸残渣を含みます。",
    foodLabel: "食材の脂質（油分）割合",
    foodHelp: "非極性の環状シロキサンは強い親油性を持ちます。バターや高温の油脂は、リーンなパン生地や水の最大6倍の速度でシロキサンを抽出します。",
    tempLabel: "オーブン焼成温度 (°C / °F)",
    tempHelp: "低分子シロキサンの揮発は180°Cを超えると急増し、200°C以上ではBfRの0.5%揮発分制限を超過するリスクが高まります。",
    cyclesLabel: "型の使用年数＆累積焼成回数",
    cyclesHelp: "後硬化（熱風処理）されていない型は最初の1〜3回の加熱で最も多く揮発します。劣化した型は微小亀裂を生じ溶出が増加します。",
    pinchLabel: "ピンチ＆ツイスト（折り曲げ白化）テスト結果",
    pinchHelp: "純度100%の食品用シリコンは折り曲げても白くなりません。白化する場合は炭酸カルシウムや安価な油性可塑剤が混入しています。",
    pinchPure: "変色なし（純粋なシリコンポリマー）",
    pinchWhite: "折り目が白化（鉱物フィラー／増塑剤混入）",
    presetsTitle: "診断シナリオのワンクリック設定",
    presetPlatinumSafe: "🏆 ベーキング済白金シリコン＋カンパーニュ（安全基準）",
    presetPoundCakeAlert: "🚨 格安型＋バターパウンドケーキ（高油脂移行警戒）",
    presetNewUntempered: "⚠️ 未処理の新品シリコン型初回使用（揮発ガス発生）",
    presetRoastTallow: "🧪 230°Cミートローフ高温脂浸潤（過酷加熱抽出）",
    presetColdChoc: "❄️ チョコレート型・製氷トレイ（常温・冷温不活性）",
    diagnosticTitle: "毒性・熱分解リアルタイム診断データ",
    diagnosticSub: "独BfR勧告XVおよび米FDA 21 CFR § 177.2600の食品接触基準に基づき評価。",
    overallScoreLabel: "シリコン総合安全性スコア",
    migrationLabel: "脂質への推定移行量 (mg/dm²)",
    outgassingLabel: "庫内シロキサンガス揮発レベル",
    toxicityLabel: "D4/D5 内分泌かく乱・生殖毒性リスク",
    thermalDegradationLabel: "分子主鎖の熱分解・微小損傷リスク",
    fatSolubilityLabel: "油脂抽出加速倍率",
    alertTitle: "毒性学・臨床安全アドバイス",
    tableTitle: "硬化化学と国際食品衛生規格 比較一覧表",
    tableSub: "主要エラストマー、触媒系、揮発性有機物および油脂移行限度値の比較。",
    colGrade: "シリコン配合グレード",
    colCatalyst: "硬化触媒システム",
    colMaxTemp: "耐熱温度上限",
    colVom: "揮発性物質 (% VOM)",
    colMigration: "油脂移行量 (mg/dm²)",
    colCompliance: "規格適合判定",
    protocolsTitle: "安全なシリコン調理のための5つの黄金則",
    protocolsSub: "高分子材料科学者および食品毒性学専門家が推奨するエビデンスに基づく実践策。",
    rule1Title: "1. 初回使用前に必ず「空焼き脱気」を実施する",
    rule1Text: "工場出荷時に後硬化ベーキングが行われていない型は、換気扇を強で回しながら200°Cのオーブンで空の型を4時間加熱し、残留環状シロキサン（D4〜D8）を蒸発・放出させてください。",
    rule2Title: "2. ピンチテストで安価な粗悪品を見破る",
    rule2Text: "シリコンの端を強く折り曲げてねじります。折れ目が白くなる製品は炭酸カルシウムや鉱物油で増量されているため、高温の油脂料理には絶対に使用しないでください。",
    rule3Title: "3. 190°Cを超える高温の動物性油脂調理を避ける",
    rule3Text: "シロキサンは高温で溶けた油に極めて溶け出しやすい性質を持ちます。ベーコンや高脂肪ロースト肉にはステンレスや耐熱陶器を使用するのが賢明です。",
    rule4Title: "4. 実質的な耐熱限界220°Cを厳守する",
    rule4Text: "「260°C対応」と表記されていても、220°Cを超えるとポリマー鎖の熱切断が急激に進み、微量のアモルファスシリカや揮発性分解物が発生します。",
    rule5Title: "5. 研磨スポンジは厳禁、柔らかい素材で洗う",
    rule5Text: "硬いタワシで表面を擦ると微小な傷がつき、化学物質の溶出表面積が拡大します。中性洗剤と柔らかいスポンジで優しく洗浄してください。",
    copyReportBtn: "📋 診断レポートをコピー",
    reportCopied: "✓ クリップボードにコピーしました！",
    crossLinkTitle: "関連する化学物質移行診断ツール",
    crossLinkMigration: "食品接触化学物質移行・拡散シミュレーター",
    crossLinkAirFryer: "ノンフライヤー アクリルアミド生成計算機",
    crossLinkSwap: "安全なキッチンウェア素材スワップ診断"
  }
};

const d = dict[lang] || dict.en;
const data = siliconeData;
---

<div class="bg-canvas border border-hairline rounded-3xl p-6 md:p-10 shadow-sm mb-12" id="silicone-analyzer-root">
  <!-- Header Banner -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-8 border-b border-hairline/80">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-rose-100 text-rose-900 mb-2">
        <span>🔬</span>
        {d.badge}
      </div>
      <h2 class="text-2xl md:text-3xl font-bold text-ink tracking-tight">
        {d.title}
      </h2>
      <p class="text-sm md:text-base text-body mt-1 max-w-3xl leading-relaxed">
        {d.subtitle}
      </p>
    </div>
    <div class="shrink-0 flex items-center gap-2">
      <button 
        type="button" 
        id="btn-copy-silicone-report" 
        class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-surface-soft hover:bg-surface-strong border border-hairline text-ink text-xs font-semibold shadow-2xs transition-all cursor-pointer"
      >
        <span>📋</span>
        <span id="copy-btn-text">{d.copyReportBtn}</span>
      </button>
    </div>
  </div>

  <!-- Scenario Presets Bar -->
  <div class="py-6 border-b border-hairline/80">
    <div class="flex items-center gap-2 text-xs font-semibold text-muted uppercase tracking-wider mb-3">
      <span>⚡</span>
      {d.presetsTitle}
    </div>
    <div class="flex flex-wrap gap-2">
      <button type="button" class="preset-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-surface-soft hover:bg-emerald-50 hover:text-emerald-900 border border-hairline transition-all" data-preset="platinum-safe">
        {d.presetPlatinumSafe}
      </button>
      <button type="button" class="preset-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-surface-soft hover:bg-rose-50 hover:text-rose-900 border border-hairline transition-all" data-preset="pound-cake-alert">
        {d.presetPoundCakeAlert}
      </button>
      <button type="button" class="preset-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-surface-soft hover:bg-amber-50 hover:text-amber-900 border border-hairline transition-all" data-preset="new-untempered">
        {d.presetNewUntempered}
      </button>
      <button type="button" class="preset-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-surface-soft hover:bg-orange-50 hover:text-orange-900 border border-hairline transition-all" data-preset="roast-tallow">
        {d.presetRoastTallow}
      </button>
      <button type="button" class="preset-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-surface-soft hover:bg-blue-50 hover:text-blue-900 border border-hairline transition-all" data-preset="cold-choc">
        {d.presetColdChoc}
      </button>
    </div>
  </div>

  <!-- Interactive Controls & Live Telemetry Layout -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 py-8">
    <!-- Left: Controls Column (7 cols) -->
    <div class="lg:col-span-7 space-y-6">
      <div>
        <h3 class="text-base font-bold text-ink mb-1">
          {d.controlsTitle}
        </h3>
        <p class="text-xs text-muted mb-4">
          {d.controlsSub}
        </p>
      </div>

      <!-- Control 1: Silicone Grade -->
      <div class="p-4 bg-surface-soft rounded-2xl border border-hairline space-y-2">
        <label for="select-cure-tech" class="block text-xs font-bold uppercase tracking-wider text-ink">
          {d.cureLabel}
        </label>
        <select id="select-cure-tech" class="w-full px-3 py-2.5 rounded-xl bg-canvas border border-hairline text-ink text-sm font-medium focus:outline-none focus:ring-2 focus:ring-rose-500">
          {data.cureTechnologies.map(cure => (
            <option value={cure.id}>{cure.name}</option>
          ))}
        </select>
        <p id="help-cure-tech" class="text-xs text-muted leading-relaxed">
          {d.cureHelp}
        </p>
      </div>

      <!-- Control 2: Food Matrix -->
      <div class="p-4 bg-surface-soft rounded-2xl border border-hairline space-y-2">
        <label for="select-food-matrix" class="block text-xs font-bold uppercase tracking-wider text-ink">
          {d.foodLabel}
        </label>
        <select id="select-food-matrix" class="w-full px-3 py-2.5 rounded-xl bg-canvas border border-hairline text-ink text-sm font-medium focus:outline-none focus:ring-2 focus:ring-rose-500">
          {data.foodMatrices.map(food => (
            <option value={food.id}>{food.name}</option>
          ))}
        </select>
        <p id="help-food-matrix" class="text-xs text-muted leading-relaxed">
          {d.foodHelp}
        </p>
      </div>

      <!-- Control 3: Temperature Slider -->
      <div class="p-4 bg-surface-soft rounded-2xl border border-hairline space-y-3">
        <div class="flex items-center justify-between">
          <label for="slider-bake-temp" class="text-xs font-bold uppercase tracking-wider text-ink">
            {d.tempLabel}
          </label>
          <span id="display-bake-temp" class="text-sm font-mono font-bold text-rose-600 bg-rose-50 px-2 py-0.5 rounded-md border border-rose-200">
            180°C (356°F)
          </span>
        </div>
        <input 
          type="range" 
          id="slider-bake-temp" 
          min="100" 
          max="260" 
          step="5" 
          value="180" 
          class="w-full accent-rose-600 cursor-pointer"
        />
        <div class="flex justify-between text-[11px] text-muted">
          <span>100°C (Boil)</span>
          <span>160°C (Gentle)</span>
          <span>190°C (Standard)</span>
          <span>220°C (Limit)</span>
          <span>260°C (Max)</span>
        </div>
        <p class="text-xs text-muted leading-relaxed">
          {d.tempHelp}
        </p>
      </div>

      <!-- Control 4: Cumulative Cycles Slider -->
      <div class="p-4 bg-surface-soft rounded-2xl border border-hairline space-y-3">
        <div class="flex items-center justify-between">
          <label for="slider-cycles" class="text-xs font-bold uppercase tracking-wider text-ink">
            {d.cyclesLabel}
          </label>
          <span id="display-cycles" class="text-sm font-mono font-bold text-ink bg-surface px-2 py-0.5 rounded-md border border-hairline">
            1 Bake (Brand New)
          </span>
        </div>
        <input 
          type="range" 
          id="slider-cycles" 
          min="1" 
          max="150" 
          step="1" 
          value="1" 
          class="w-full accent-ink cursor-pointer"
        />
        <div class="flex justify-between text-[11px] text-muted">
          <span>1 (Brand New)</span>
          <span>5 (Degassed)</span>
          <span>50 (Seasoned)</span>
          <span>100+ (Aged)</span>
        </div>
        <p class="text-xs text-muted leading-relaxed">
          {d.cyclesHelp}
        </p>
      </div>

      <!-- Control 5: Pinch Test -->
      <div class="p-4 bg-surface-soft rounded-2xl border border-hairline space-y-2">
        <label class="block text-xs font-bold uppercase tracking-wider text-ink">
          {d.pinchLabel}
        </label>
        <div class="grid grid-cols-2 gap-3 pt-1">
          <button 
            type="button" 
            id="btn-pinch-pure" 
            class="pinch-toggle-btn px-4 py-2.5 rounded-xl border text-xs font-semibold transition-all bg-emerald-600 text-white border-emerald-600 shadow-2xs"
            data-pinch="pure"
          >
            ✓ {d.pinchPure}
          </button>
          <button 
            type="button" 
            id="btn-pinch-white" 
            class="pinch-toggle-btn px-4 py-2.5 rounded-xl border text-xs font-semibold transition-all bg-canvas text-body border-hairline hover:bg-surface-strong"
            data-pinch="white"
          >
            ⚠️ {d.pinchWhite}
          </button>
        </div>
        <p class="text-xs text-muted leading-relaxed pt-1">
          {d.pinchHelp}
        </p>
      </div>
    </div>

    <!-- Right: Telemetry & Diagnostic Gauges (5 cols) -->
    <div class="lg:col-span-5 space-y-6 flex flex-col justify-between">
      <div class="space-y-4">
        <div>
          <h3 class="text-base font-bold text-ink mb-1">
            {d.diagnosticTitle}
          </h3>
          <p class="text-xs text-muted">
            {d.diagnosticSub}
          </p>
        </div>

        <!-- Overall Score Card -->
        <div class="p-6 rounded-2xl border border-hairline bg-surface-soft text-center space-y-2 relative overflow-hidden" id="card-overall-score">
          <span class="text-xs font-bold uppercase tracking-wider text-muted block">
            {d.overallScoreLabel}
          </span>
          <div class="flex items-baseline justify-center gap-1">
            <span id="val-overall-score" class="text-5xl md:text-6xl font-extrabold text-emerald-600 tracking-tight font-mono">
              96
            </span>
            <span class="text-muted text-lg font-medium">/100</span>
          </div>
          <span id="badge-safety-status" class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800">
            OPTIMAL FOOD GRADE PURITY
          </span>
        </div>

        <!-- Metric Grid -->
        <div class="grid grid-cols-2 gap-3 text-xs">
          <!-- Lipid Migration -->
          <div class="p-3.5 bg-surface-soft rounded-xl border border-hairline space-y-1">
            <span class="text-muted block">{d.migrationLabel}</span>
            <span id="val-migration" class="text-base font-mono font-bold text-ink block">
              1.4 mg/dm²
            </span>
            <span id="sub-migration-bfr" class="text-[10px] text-emerald-600 block">
              &lt;10 mg/dm² (BfR Pass)
            </span>
          </div>

          <!-- Outgassing Severity -->
          <div class="p-3.5 bg-surface-soft rounded-xl border border-hairline space-y-1">
            <span class="text-muted block">{d.outgassingLabel}</span>
            <span id="val-outgassing" class="text-base font-mono font-bold text-ink block">
              0.08% VOM
            </span>
            <span id="sub-outgassing" class="text-[10px] text-emerald-600 block">
              Trace Volatiles
            </span>
          </div>

          <!-- D4/D5 Toxicity -->
          <div class="p-3.5 bg-surface-soft rounded-xl border border-hairline space-y-1">
            <span class="text-muted block">{d.toxicityLabel}</span>
            <span id="val-toxicity" class="text-base font-mono font-bold text-emerald-600 block">
              Negligible
            </span>
            <span id="sub-toxicity" class="text-[10px] text-muted block">
              REACH SVHC Safe
            </span>
          </div>

          <!-- Thermal Scission -->
          <div class="p-3.5 bg-surface-soft rounded-xl border border-hairline space-y-1">
            <span class="text-muted block">{d.thermalDegradationLabel}</span>
            <span id="val-thermal-scission" class="text-base font-mono font-bold text-ink block">
              Stable Matrix
            </span>
            <span id="sub-thermal-scission" class="text-[10px] text-muted block">
              &lt;260°C Ceiling
            </span>
          </div>
        </div>

        <!-- Actionable Alert Banner -->
        <div id="banner-action-alert" class="p-4 rounded-xl border border-emerald-200 bg-emerald-50 text-emerald-950 space-y-1 text-xs">
          <div class="flex items-center gap-2 font-bold uppercase tracking-wider text-[11px] text-emerald-800">
            <span id="alert-icon">✅</span>
            <span id="alert-heading">{d.alertTitle}</span>
          </div>
          <p id="alert-body" class="leading-relaxed text-emerald-900">
            Current parameters demonstrate full compliance with BfR Recommendation XV and FDA 21 CFR § 177.2600. Volatile cyclic siloxanes remain trapped in the fully cross-linked polymer network.
          </p>
        </div>
      </div>

      <!-- Regulatory Citation Footer -->
      <div class="text-[11px] text-muted border-t border-hairline pt-3 flex items-center justify-between">
        <span>German BfR XV • FDA 21 CFR § 177.2600</span>
        <span class="font-mono">Log Kow: 5.1–8.9</span>
      </div>
    </div>
  </div>

  <!-- Engineering & Regulatory Benchmark Matrix Table -->
  <div class="mt-8 pt-8 border-t border-hairline">
    <div class="mb-4">
      <h3 class="text-lg font-bold text-ink">
        {d.tableTitle}
      </h3>
      <p class="text-xs text-muted">
        {d.tableSub}
      </p>
    </div>

    <div class="overflow-x-auto rounded-2xl border border-hairline">
      <table class="w-full text-left text-xs">
        <thead class="bg-surface-soft border-b border-hairline text-ink font-semibold uppercase tracking-wider text-[11px]">
          <tr>
            <th class="p-3">{d.colGrade}</th>
            <th class="p-3">{d.colCatalyst}</th>
            <th class="p-3">{d.colMaxTemp}</th>
            <th class="p-3">{d.colVom}</th>
            <th class="p-3">{d.colMigration}</th>
            <th class="p-3">{d.colCompliance}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline">
          {data.cureTechnologies.map(cure => (
            <tr class="hover:bg-surface-soft/50 transition-colors">
              <td class="p-3 font-semibold text-ink">{cure.name}</td>
              <td class="p-3 text-body">{cure.catalyst}</td>
              <td class="p-3 font-mono text-ink">{cure.maxServiceTempC}°C ({cure.maxServiceTempF}°F)</td>
              <td class="p-3 font-mono text-ink">{cure.volatileOrganicMatterPercent}%</td>
              <td class="p-3 font-mono text-ink">{cure.lipidMigrationMgDm2}</td>
              <td class="p-3">
                <span class={`inline-block px-2 py-0.5 rounded text-[10px] font-bold uppercase ${
                  cure.id === 'platinum-cure-tempered' ? 'bg-emerald-100 text-emerald-800' :
                  cure.id === 'platinum-cure-untempered' ? 'bg-amber-100 text-amber-800' :
                  cure.id === 'peroxide-cure-commercial' ? 'bg-orange-100 text-orange-800' :
                  'bg-rose-100 text-rose-800'
                }`}>
                  {cure.bfrRecommendationXvStatus}
                </span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- 5 Evidence-Based Safety Protocols -->
  <div class="mt-10 pt-8 border-t border-hairline space-y-6">
    <div>
      <h3 class="text-lg font-bold text-ink">
        {d.protocolsTitle}
      </h3>
      <p class="text-xs text-muted">
        {d.protocolsSub}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 text-xs">
      <div class="p-4 rounded-2xl bg-surface-soft border border-hairline space-y-1.5">
        <h4 class="font-bold text-ink">{d.rule1Title}</h4>
        <p class="text-body leading-relaxed">{d.rule1Text}</p>
      </div>
      <div class="p-4 rounded-2xl bg-surface-soft border border-hairline space-y-1.5">
        <h4 class="font-bold text-ink">{d.rule2Title}</h4>
        <p class="text-body leading-relaxed">{d.rule2Text}</p>
      </div>
      <div class="p-4 rounded-2xl bg-surface-soft border border-hairline space-y-1.5">
        <h4 class="font-bold text-ink">{d.rule3Title}</h4>
        <p class="text-body leading-relaxed">{d.rule3Text}</p>
      </div>
      <div class="p-4 rounded-2xl bg-surface-soft border border-hairline space-y-1.5">
        <h4 class="font-bold text-ink">{d.rule4Title}</h4>
        <p class="text-body leading-relaxed">{d.rule4Text}</p>
      </div>
      <div class="p-4 rounded-2xl bg-surface-soft border border-hairline space-y-1.5">
        <h4 class="font-bold text-ink">{d.rule5Title}</h4>
        <p class="text-body leading-relaxed">{d.rule5Text}</p>
      </div>
      <div class="p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-950 space-y-1.5 flex flex-col justify-center">
        <h4 class="font-bold text-rose-900">⚠️ REACH SVHC Monitored</h4>
        <p class="text-rose-950 leading-relaxed">
          Octamethylcyclotetrasiloxane (D4) and Decamethylcyclopentasiloxane (D5) are subject to strict European chemical restriction due to endocrine disruption and environmental bioaccumulation.
        </p>
      </div>
    </div>
  </div>

  <!-- Related Tools Cross-Links -->
  <div class="mt-8 pt-6 border-t border-hairline flex flex-wrap items-center justify-between gap-4 text-xs">
    <span class="font-bold text-muted uppercase tracking-wider">{d.crossLinkTitle}:</span>
    <div class="flex flex-wrap gap-2">
      <a href="/tools/food-contact-migration-predictor/" class="px-3 py-1.5 rounded-lg bg-surface-soft hover:bg-surface-strong border border-hairline text-ink font-medium transition-colors">
        &rarr; {d.crossLinkMigration}
      </a>
      <a href="/tools/air-fryer-acrylamide-calculator/" class="px-3 py-1.5 rounded-lg bg-surface-soft hover:bg-surface-strong border border-hairline text-ink font-medium transition-colors">
        &rarr; {d.crossLinkAirFryer}
      </a>
      <a href="/tools/material-swap-calculator/" class="px-3 py-1.5 rounded-lg bg-surface-soft hover:bg-surface-strong border border-hairline text-ink font-medium transition-colors">
        &rarr; {d.crossLinkSwap}
      </a>
    </div>
  </div>
</div>

<!-- Client-Side Real-Time Diagnostic Engine -->
<script define:vars={{ siliconeData, reportCopiedText: d.reportCopied, copyBtnOriginalText: d.copyReportBtn }}>
  (function initSiliconeEngine() {
    const cureSelect = document.getElementById('select-cure-tech');
    const foodSelect = document.getElementById('select-food-matrix');
    const tempSlider = document.getElementById('slider-bake-temp');
    const tempDisplay = document.getElementById('display-bake-temp');
    const cyclesSlider = document.getElementById('slider-cycles');
    const cyclesDisplay = document.getElementById('display-cycles');
    const btnPinchPure = document.getElementById('btn-pinch-pure');
    const btnPinchWhite = document.getElementById('btn-pinch-white');
    const copyBtn = document.getElementById('btn-copy-silicone-report');
    const copyBtnText = document.getElementById('copy-btn-text');
    const presetButtons = document.querySelectorAll('.preset-btn');

    // Outputs
    const valOverallScore = document.getElementById('val-overall-score');
    const badgeSafetyStatus = document.getElementById('badge-safety-status');
    const valMigration = document.getElementById('val-migration');
    const subMigrationBfr = document.getElementById('sub-migration-bfr');
    const valOutgassing = document.getElementById('val-outgassing');
    const subOutgassing = document.getElementById('sub-outgassing');
    const valToxicity = document.getElementById('val-toxicity');
    const subToxicity = document.getElementById('sub-toxicity');
    const valThermalScission = document.getElementById('val-thermal-scission');
    const subThermalScission = document.getElementById('sub-thermal-scission');
    const bannerAlert = document.getElementById('banner-action-alert');
    const alertIcon = document.getElementById('alert-icon');
    const alertHeading = document.getElementById('alert-heading');
    const alertBody = document.getElementById('alert-body');

    let currentPinch = 'pure'; // 'pure' | 'white'

    function updateCalculations() {
      if (!cureSelect || !foodSelect || !tempSlider || !cyclesSlider) return;

      const cureId = cureSelect.value;
      const foodId = foodSelect.value;
      const tempC = parseInt(tempSlider.value, 10);
      const cycles = parseInt(cyclesSlider.value, 10);

      // Temperature display in C and F
      const tempF = Math.round(tempC * 9 / 5 + 32);
      tempDisplay.textContent = `${tempC}°C (${tempF}°F)`;

      // Cycles display
      if (cycles === 1) {
        cyclesDisplay.textContent = '1 Bake (Brand New)';
      } else if (cycles < 5) {
        cyclesDisplay.textContent = `${cycles} Bakes (Initial Run)`;
      } else if (cycles < 50) {
        cyclesDisplay.textContent = `${cycles} Bakes (Seasoned)`;
      } else {
        cyclesDisplay.textContent = `${cycles} Bakes (Heavy Use)`;
      }

      // Lookup data
      const cure = siliconeData.cureTechnologies.find(c => c.id === cureId) || siliconeData.cureTechnologies[0];
      const food = siliconeData.foodMatrices.find(f => f.id === foodId) || siliconeData.foodMatrices[0];

      // Base migration calculation
      let baseMigration = cure.lipidMigrationMgDm2; // mg/dm2
      const lipidMultiplier = food.extractionMultiplier;

      // Thermal acceleration factor (Arrhenius type)
      // Reference baseline: 180°C
      let tempFactor = 1.0;
      if (tempC < 160) {
        tempFactor = 0.35 + (tempC - 100) / 100 * 0.4;
      } else if (tempC <= 200) {
        tempFactor = 0.75 + ((tempC - 160) / 40) * 0.75; // 0.75 to 1.5
      } else if (tempC <= 220) {
        tempFactor = 1.5 + ((tempC - 200) / 20) * 1.5; // 1.5 to 3.0
      } else {
        tempFactor = 3.0 + ((tempC - 220) / 40) * 4.5; // 3.0 to 7.5
      }

      // Cycle degassing mitigation for untempered molds
      let cycleMitigation = 1.0;
      if (cureId === 'platinum-cure-untempered') {
        if (cycles === 1) cycleMitigation = 1.8;
        else if (cycles <= 3) cycleMitigation = 1.3;
        else cycleMitigation = 0.85;
      } else if (cureId === 'peroxide-cure-commercial') {
        if (cycles === 1) cycleMitigation = 1.5;
        else if (cycles > 80) cycleMitigation = 1.4; // aged peroxide degrades
      }

      // Adulteration penalty if pinch test failed
      let pinchPenalty = 1.0;
      if (currentPinch === 'white') {
        pinchPenalty = 2.4;
      }

      const estimatedMigration = (baseMigration * (lipidMultiplier / 4.5) * tempFactor * cycleMitigation * pinchPenalty).toFixed(1);

      // Outgassing VOM %
      let baseVOM = cure.volatileOrganicMatterPercent;
      let outgassingPercent = (baseVOM * tempFactor * (cycles === 1 ? 1.4 : 0.7) * (currentPinch === 'white' ? 1.8 : 1.0)).toFixed(2);

      // Overall Score Calculation (0 to 100)
      let score = 98;

      // Cure penalty
      if (cureId === 'platinum-cure-untempered') score -= 15;
      else if (cureId === 'peroxide-cure-commercial') score -= 32;
      else if (cureId === 'filler-adulterated') score -= 55;

      // Temperature penalty
      if (tempC > 200) score -= (tempC - 200) * 0.5;
      if (tempC > 220) score -= (tempC - 220) * 0.7;

      // Food lipid penalty if combined with high temp
      if (food.lipidFraction > 0.20 && tempC > 190) {
        score -= 12;
      }

      // Pinch white penalty
      if (currentPinch === 'white') {
        score -= 25;
      }

      // Untempered new mold penalty
      if (cureId === 'platinum-cure-untempered' && cycles <= 2 && tempC >= 180) {
        score -= 10;
      }

      score = Math.max(5, Math.min(100, Math.round(score)));

      // Render Outputs
      valOverallScore.textContent = score;

      // Safety status badge & styling
      let statusText = 'OPTIMAL FOOD GRADE PURITY';
      let statusBg = 'bg-emerald-100 text-emerald-800';
      let scoreColor = 'text-emerald-600';
      let alertTheme = 'emerald';

      if (score >= 85) {
        statusText = 'OPTIMAL FOOD GRADE PURITY';
        statusBg = 'bg-emerald-100 text-emerald-800';
        scoreColor = 'text-emerald-600';
        alertTheme = 'emerald';
      } else if (score >= 68) {
        statusText = 'LOW CONCERN • ACCEPTABLE';
        statusBg = 'bg-blue-100 text-blue-800';
        scoreColor = 'text-blue-600';
        alertTheme = 'blue';
      } else if (score >= 45) {
        statusText = 'MODERATE CONCERN • ELEVATED LEACHING';
        statusBg = 'bg-amber-100 text-amber-800';
        scoreColor = 'text-amber-600';
        alertTheme = 'amber';
      } else {
        statusText = 'CRITICAL TOXICITY HAZARD • DO NOT BAKE';
        statusBg = 'bg-rose-100 text-rose-800';
        scoreColor = 'text-rose-600';
        alertTheme = 'rose';
      }

      valOverallScore.className = `text-5xl md:text-6xl font-extrabold tracking-tight font-mono ${scoreColor}`;
      badgeSafetyStatus.textContent = statusText;
      badgeSafetyStatus.className = `inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider ${statusBg}`;

      // Migration readout
      valMigration.textContent = `${estimatedMigration} mg/dm²`;
      if (parseFloat(estimatedMigration) <= 10.0) {
        subMigrationBfr.textContent = '<10 mg/dm² (BfR Pass)';
        subMigrationBfr.className = 'text-[10px] text-emerald-600 block';
      } else if (parseFloat(estimatedMigration) <= 25.0) {
        subMigrationBfr.textContent = `Breaches BfR 10 mg/dm² limit!`;
        subMigrationBfr.className = 'text-[10px] text-amber-600 font-bold block';
      } else {
        subMigrationBfr.textContent = `Severe Breach (>4x BfR Limit)`;
        subMigrationBfr.className = 'text-[10px] text-rose-600 font-bold block';
      }

      // Outgassing readout
      valOutgassing.textContent = `${outgassingPercent}% VOM`;
      if (parseFloat(outgassingPercent) <= 0.5) {
        subOutgassing.textContent = '<0.5% VOM (BfR Compliant)';
        subOutgassing.className = 'text-[10px] text-emerald-600 block';
      } else {
        subOutgassing.textContent = 'Exceeds 0.5% VOM Limit!';
        subOutgassing.className = 'text-[10px] text-rose-600 font-bold block';
      }

      // D4/D5 Toxicity
      if (cureId === 'platinum-cure-tempered' && currentPinch === 'pure') {
        valToxicity.textContent = 'Negligible';
        valToxicity.className = 'text-base font-mono font-bold text-emerald-600 block';
        subToxicity.textContent = 'REACH SVHC Safe';
      } else if (cureId === 'platinum-cure-untempered' && cycles > 3) {
        valToxicity.textContent = 'Low Residue';
        valToxicity.className = 'text-base font-mono font-bold text-blue-600 block';
        subToxicity.textContent = 'Degassed Matrix';
      } else if (cureId === 'peroxide-cure-commercial') {
        valToxicity.textContent = 'Moderate';
        valToxicity.className = 'text-base font-mono font-bold text-amber-600 block';
        subToxicity.textContent = 'Cyclic Siloxanes Present';
      } else {
        valToxicity.textContent = 'High / Critical';
        valToxicity.className = 'text-base font-mono font-bold text-rose-600 block';
        subToxicity.textContent = 'Endocrine/Reprotoxic Risk';
      }

      // Thermal Scission
      if (tempC <= 200 && currentPinch === 'pure') {
        valThermalScission.textContent = 'Stable Matrix';
        subThermalScission.textContent = '<200°C Inert';
      } else if (tempC <= 220) {
        valThermalScission.textContent = 'Mild Thermal Stress';
        subThermalScission.textContent = 'Accelerated Oligomers';
      } else {
        valThermalScission.textContent = 'Chain Scission';
        subThermalScission.textContent = '>220°C Depolymerization';
      }

      // Dynamic Alert Box Content
      if (alertTheme === 'emerald') {
        bannerAlert.className = 'p-4 rounded-xl border border-emerald-200 bg-emerald-50 text-emerald-950 space-y-1 text-xs';
        alertIcon.textContent = '✅';
        alertHeading.textContent = 'Optimal Culinary Safety Confirmed';
        alertBody.textContent = 'Your current parameters demonstrate full compliance with BfR Recommendation XV and FDA 21 CFR § 177.2600. Volatile cyclic siloxanes remain securely trapped in the high-density platinum-cured elastomer.';
      } else if (alertTheme === 'blue') {
        bannerAlert.className = 'p-4 rounded-xl border border-blue-200 bg-blue-50 text-blue-950 space-y-1 text-xs';
        alertIcon.textContent = 'ℹ️';
        alertHeading.textContent = 'Acceptable Parameters • Minor Degassing';
        alertBody.textContent = 'Silicones are chemically stable at this temperature, though initial bakes may release minor odors. Ensure your kitchen hood is on during first-run heating.';
      } else if (alertTheme === 'amber') {
        bannerAlert.className = 'p-4 rounded-xl border border-amber-200 bg-amber-50 text-amber-950 space-y-1 text-xs';
        alertIcon.textContent = '⚠️';
        alertHeading.textContent = 'Elevated Chemical Migration Detected';
        alertBody.textContent = `Warning: Calculated migration (${estimatedMigration} mg/dm²) approaches or breaches the European BfR 10 mg/dm² ceiling. High-fat content paired with heat >190°C leaches cyclic siloxanes directly into butter and oil.`;
      } else {
        bannerAlert.className = 'p-4 rounded-xl border border-rose-200 bg-rose-50 text-rose-950 space-y-1 text-xs';
        alertIcon.textContent = '🚨';
        alertHeading.textContent = 'Critical Health & Chemical Ingestion Risk';
        alertBody.textContent = `HAZARD: Massive chemical migration (${estimatedMigration} mg/dm²) and high outgassing (${outgassingPercent}% VOM). Adulterated mineral fillers and peroxide byproducts decompose into hot fats. Discard this mold or restrict strictly to sub-ambient cold/ice uses.`;
      }
    }

    // Toggle Pinch Buttons
    function setPinch(type) {
      currentPinch = type;
      if (type === 'pure') {
        btnPinchPure.className = 'pinch-toggle-btn px-4 py-2.5 rounded-xl border text-xs font-semibold transition-all bg-emerald-600 text-white border-emerald-600 shadow-2xs';
        btnPinchWhite.className = 'pinch-toggle-btn px-4 py-2.5 rounded-xl border text-xs font-semibold transition-all bg-canvas text-body border-hairline hover:bg-surface-strong';
      } else {
        btnPinchWhite.className = 'pinch-toggle-btn px-4 py-2.5 rounded-xl border text-xs font-semibold transition-all bg-rose-600 text-white border-rose-600 shadow-2xs';
        btnPinchPure.className = 'pinch-toggle-btn px-4 py-2.5 rounded-xl border text-xs font-semibold transition-all bg-canvas text-body border-hairline hover:bg-surface-strong';
      }
      updateCalculations();
    }

    if (btnPinchPure) btnPinchPure.addEventListener('click', () => setPinch('pure'));
    if (btnPinchWhite) btnPinchWhite.addEventListener('click', () => setPinch('white'));

    // Preset handlers
    presetButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const p = btn.getAttribute('data-preset');
        if (p === 'platinum-safe') {
          cureSelect.value = 'platinum-cure-tempered';
          foodSelect.value = 'low-fat-lean-bread';
          tempSlider.value = '210';
          cyclesSlider.value = '25';
          setPinch('pure');
        } else if (p === 'pound-cake-alert') {
          cureSelect.value = 'peroxide-cure-commercial';
          foodSelect.value = 'high-fat-pastry';
          tempSlider.value = '190';
          cyclesSlider.value = '3';
          setPinch('pure');
        } else if (p === 'new-untempered') {
          cureSelect.value = 'platinum-cure-untempered';
          foodSelect.value = 'high-fat-pastry';
          tempSlider.value = '200';
          cyclesSlider.value = '1';
          setPinch('pure');
        } else if (p === 'roast-tallow') {
          cureSelect.value = 'peroxide-cure-commercial';
          foodSelect.value = 'savory-roast-meat';
          tempSlider.value = '230';
          cyclesSlider.value = '40';
          setPinch('white');
        } else if (p === 'cold-choc') {
          cureSelect.value = 'platinum-cure-tempered';
          foodSelect.value = 'cold-confection-ice';
          tempSlider.value = '100';
          cyclesSlider.value = '10';
          setPinch('pure');
        }
        updateCalculations();
      });
    });

    // Copy Telemetry Report
    if (copyBtn) {
      copyBtn.addEventListener('click', async () => {
        const text = `=== IsItKitchenSafe Silicone Bakeware Chemical Analyzer ===\n` +
          `Date: ${new Date().toISOString()}\n` +
          `Silicone Grade: ${cureSelect.options[cureSelect.selectedIndex].text}\n` +
          `Food Matrix: ${foodSelect.options[foodSelect.selectedIndex].text}\n` +
          `Oven Temperature: ${tempSlider.value}°C (${Math.round(tempSlider.value * 9/5 + 32)}°F)\n` +
          `Bake History: ${cyclesSlider.value} cycles\n` +
          `Pinch Test: ${currentPinch === 'pure' ? 'Colorfast (Pure)' : 'Turns White (Filler Adulterated)'}\n` +
          `Overall Safety Score: ${valOverallScore.textContent} / 100 (${badgeSafetyStatus.textContent})\n` +
          `Lipid Migration: ${valMigration.textContent} (BfR limit: 10 mg/dm²)\n` +
          `Oven Outgassing: ${valOutgassing.textContent} (BfR limit: 0.5% VOM)\n` +
          `D4/D5 Endocrine Risk: ${valToxicity.textContent}\n` +
          `Thermal Scission: ${valThermalScission.textContent}\n` +
          `Verified via: isitkitchensafe.com/tools/silicone-bakeware-oligomer-analyzer/`;

        try {
          await navigator.clipboard.writeText(text);
          copyBtnText.textContent = reportCopiedText;
          setTimeout(() => {
            copyBtnText.textContent = copyBtnOriginalText;
          }, 3000);
        } catch (err) {
          console.error('Clipboard copy failed:', err);
        }
      });
    }

    // Attach listeners
    cureSelect.addEventListener('change', updateCalculations);
    foodSelect.addEventListener('change', updateCalculations);
    tempSlider.addEventListener('input', updateCalculations);
    cyclesSlider.addEventListener('input', updateCalculations);

    // Initial run
    updateCalculations();
  })();
</script>
