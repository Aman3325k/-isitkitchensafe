---
import rawData from '../data/instant-pot-pressure-release-data.json';
import type { SupportedLanguage } from '../i18n/ui';
import { useTranslatedPath } from '../i18n/utils';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;
const translatePath = useTranslatedPath(lang);

const internalTempUrl = translatePath('/tools/internal-cooking-temp-chart/');
const meatThawingUrl = translatePath('/tools/meat-thawing-calculator/');
const kitchenFireUrl = translatePath('/tools/kitchen-fire-emergency-guide/');
const methodologyUrl = translatePath('/methodology/');
const allToolsUrl = translatePath('/tools/');

type RiskLevel = 'low' | 'medium' | 'high' | 'extreme';
type CategoryKey = 'foaming-grains' | 'meats-poultry' | 'soups-liquids' | 'veggies-eggs' | 'pot-in-pot';
type ReleaseFilterKey = 'full-npr' | 'partial-npr' | 'quick-release';

interface BannerRule {
  icon: string;
  title: string;
  body: string;
}

interface SafetyBannerData {
  badge: string;
  headline: string;
  subline: string;
  rules: BannerRule[];
}

interface LocalizedPotSize {
  id: string;
  icon: string;
  minLiquidCups: string;
  minLiquidMl: string;
  isStovetop: boolean;
  shortName: string;
  name: string;
  liquidDisplay: string;
  liquidNote: string;
  stovetopOption: string;
}

interface LocalizedFood {
  id: string;
  icon: string;
  category: CategoryKey;
  maxFill: '1/2' | '2/3';
  releaseFilter: ReleaseFilterKey;
  foamRisk: RiskLevel;
  burnRisk: RiskLevel;
  hasUsdaTemp: boolean;
  usdaTemp: string;
  shortName: string;
  name: string;
  releaseBadge: string;
  releaseSummary: string;
  foamNote: string;
  burnTip: string;
  usdaNote: string;
}

const safetyBanner: SafetyBannerData =
  (rawData.safetyBanner as Record<string, SafetyBannerData>)[lang] ||
  rawData.safetyBanner.en;

const localizedPotSizes: LocalizedPotSize[] = rawData.potSizes.map((item) => {
  const tr = (item.i18n as Record<string, any>)[lang] || item.i18n.en;
  return {
    id: item.id,
    icon: item.icon,
    minLiquidCups: item.minLiquidCups,
    minLiquidMl: item.minLiquidMl,
    isStovetop: Boolean(item.isStovetop),
    shortName: tr.shortName,
    name: tr.name,
    liquidDisplay: tr.liquidDisplay,
    liquidNote: tr.liquidNote,
    stovetopOption: tr.stovetopOption || ''
  };
});

const localizedFoods: LocalizedFood[] = rawData.foods.map((item) => {
  const tr = (item.i18n as Record<string, any>)[lang] || item.i18n.en;
  return {
    id: item.id,
    icon: item.icon,
    category: item.category as CategoryKey,
    maxFill: item.maxFill as '1/2' | '2/3',
    releaseFilter: item.releaseFilter as ReleaseFilterKey,
    foamRisk: item.foamRisk as RiskLevel,
    burnRisk: item.burnRisk as RiskLevel,
    hasUsdaTemp: Boolean(item.hasUsdaTemp),
    usdaTemp: item.usdaTemp || '',
    shortName: tr.shortName,
    name: tr.name,
    releaseBadge: tr.releaseBadge,
    releaseSummary: tr.releaseSummary,
    foamNote: tr.foamNote,
    burnTip: tr.burnTip,
    usdaNote: tr.usdaNote || ''
  };
});

const localizedFaqs: Array<{ question: string; answer: string }> =
  (rawData.faqs as Record<string, Array<{ question: string; answer: string }>>)[lang] ||
  rawData.faqs.en;

