---
import rawData from '../data/dishwasher-detergent-dosage-data.json';
import type { SupportedLanguage } from '../i18n/ui';
import { useTranslatedPath } from '../i18n/utils';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;
const translatePath = useTranslatedPath(lang);

const descalingUrl = translatePath('/tools/appliance-descaling-calculator/');
const symbolDecoderUrl = translatePath('/tools/kitchen-symbol-decoder/');
const babyBottleUrl = translatePath('/tools/baby-bottle-safety-checker/');
const dishwasherHubUrl = translatePath('/dishwasher/');
const methodologyUrl = translatePath('/methodology/');
const allToolsUrl = translatePath('/tools/');

type HardnessId = 'soft' | 'medium' | 'hard' | 'very-hard';
type SoilId = 'light' | 'normal' | 'heavy';
type DetergentId = 'powder' | 'pod' | 'liquid-gel' | 'fragrance-free';
type DelicateId = 'silicone-baby' | 'crystal-glass' | 'aluminum' | 'nonstick-knives';

interface LocalizedHardness {
  id: HardnessId;
  icon: string;
  gpg: string;
  ppm: string;
  etchingRisk: string;
  defaultRinseAid: number;
  citricBoost: boolean;
  label: string;
  shortRange: string;
  summary: string;
}

interface LocalizedSoil {
  id: SoilId;
  icon: string;
  label: string;
  sub: string;
}

interface LocalizedDetergent {
  id: DetergentId;
  icon: string;
  isFixedDose: boolean;
  isFragranceFree: boolean;
  recommended: boolean;
  label: string;
  badge: string;
  note: string;
}

interface LocalizedDelicate {
  id: DelicateId;
  icon: string;
  severity: 'warning' | 'danger';
  label: string;
  short: string;
  alertTitle: string;
  alertBody: string;
}

interface LocalizedVinegarResult {
  status: 'reversible' | 'irreversible';
  icon: string;
  buttonLabel: string;
  buttonSub: string;
  verdictBadge: string;
  title: string;
  explanation: string;
  fixes: string[];
}

interface LocalizedEmergency {
  badge: string;
  title: string;
  subtitle: string;
  steps: string[];
  warning: string;
}

const localizedHardness: LocalizedHardness[] = rawData.waterHardness.map((h) => {
  const tr = (h.i18n as Record<string, any>)[lang] || h.i18n.en;
  return {
    id: h.id as HardnessId,
    icon: h.icon,
    gpg: h.gpg,
    ppm: h.ppm,
    etchingRisk: h.etchingRisk,
    defaultRinseAid: h.defaultRinseAid,
    citricBoost: Boolean(h.citricBoost),
    label: tr.label,
    shortRange: tr.shortRange,
    summary: tr.summary
  };
});

const localizedSoil: LocalizedSoil[] = rawData.soilLevels.map((s) => {
  const tr = (s.i18n as Record<string, any>)[lang] || s.i18n.en;
  return {
    id: s.id as SoilId,
    icon: s.icon,
    label: tr.label,
    sub: tr.sub
  };
});

const localizedDetergents: LocalizedDetergent[] = rawData.detergentTypes.map((d) => {
  const tr = (d.i18n as Record<string, any>)[lang] || d.i18n.en;
  return {
    id: d.id as DetergentId,
    icon: d.icon,
    isFixedDose: Boolean(d.isFixedDose),
    isFragranceFree: Boolean(d.isFragranceFree),
    recommended: Boolean(d.recommended),
    label: tr.label,
    badge: tr.badge,
    note: tr.note
  };
});

const localizedDelicates: LocalizedDelicate[] = rawData.delicateToggles.map((item) => {
  const tr = (item.i18n as Record<string, any>)[lang] || item.i18n.en;
  return {
    id: item.id as DelicateId,
    icon: item.icon,
    severity: item.severity as 'warning' | 'danger',
    label: tr.label,
    short: tr.short,
    alertTitle: tr.alertTitle,
    alertBody: tr.alertBody
  };
});

const vinegarWipedTr = (rawData.vinegarDiagnostic['wiped-clear'].i18n as Record<string, any>)[lang] || rawData.vinegarDiagnostic['wiped-clear'].i18n.en;
const vinegarCloudyTr = (rawData.vinegarDiagnostic['stayed-cloudy'].i18n as Record<string, any>)[lang] || rawData.vinegarDiagnostic['stayed-cloudy'].i18n.en;

const localizedVinegar: Record<'wiped-clear' | 'stayed-cloudy', LocalizedVinegarResult> = {
  'wiped-clear': {
    status: 'reversible',
    icon: rawData.vinegarDiagnostic['wiped-clear'].icon,
    buttonLabel: vinegarWipedTr.buttonLabel,
    buttonSub: vinegarWipedTr.buttonSub,
    verdictBadge: vinegarWipedTr.verdictBadge,
    title: vinegarWipedTr.title,
    explanation: vinegarWipedTr.explanation,
    fixes: vinegarWipedTr.fixes
  },
  'stayed-cloudy': {
    status: 'irreversible',
    icon: rawData.vinegarDiagnostic['stayed-cloudy'].icon,
    buttonLabel: vinegarCloudyTr.buttonLabel,
    buttonSub: vinegarCloudyTr.buttonSub,
    verdictBadge: vinegarCloudyTr.verdictBadge,
    title: vinegarCloudyTr.title,
    explanation: vinegarCloudyTr.explanation,
    fixes: vinegarCloudyTr.fixes
  }
};

const localizedEmergency: LocalizedEmergency =
  (rawData.emergencySoapRescue.i18n as Record<string, LocalizedEmergency>)[lang] ||
  rawData.emergencySoapRescue.i18n.en;

const localizedFaqs: Array<{ question: string; answer: string }> =
  (rawData.faqs as Record<string, Array<{ question: string; answer: string }>>)[lang] ||
  rawData.faqs.en;

