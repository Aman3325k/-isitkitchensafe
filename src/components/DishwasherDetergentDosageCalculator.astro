    rinseAidStandardNote: '水切れを良くし、グラスやプラ容器の水滴跡を防ぎます。',
    rinseAidMaxNote: '最大設定＋内蔵軟水器がある場合は専用塩の残量を確認してください。',
    cycleNormal: '標準／オート (52–60°C / 125–140°F)',
    cycleNormalSub: '固形物だけ落とし、洗い流しすぎないことで酵素とアルカリが適切に作用します。',
    cycleLight: '弱／エコ (45–55°C / 115–130°F)',
    cycleLightSub: 'タブレット使用時は溶け残り防止のため時短・スピードコースを避けてください。',
    cycleHeavy: '念入り／強力 (60–68°C / 140–155°F)',
    cycleHeavySub: '長時間の高温洗浄で焼き付き脂や乾いたデンプンをしっかり分解します。',
    cycleDelicate: 'グラス／低温 (40–45°C / 105–115°F) ・高温乾燥OFF',
    cycleDelicateSub: '高温乾燥と除菌をOFFにし、グラスのエッチングやシリコンの石鹸臭移りを防ぎます。',
    hotTapTipTitle: 'プロのコツ — 運転前にキッチンのお湯を30〜60秒流す：',
    hotTapTipBody: '給湯接続の食洗機はシンクと同じ配管から取水します。スタート前に蛇口が十分熱くなる（約49°C / 120°F）まで流すと、予洗いが冷水ではなく温水で始まり洗浄力が激変します。',
    alertsSectionTitle: '稼働中の素材・化学安全アラート',
    noAlertsText: 'この設定で特別な化学リスクはありません。固形物を落とし、ノズルが干渉しないよう並べて開始してください。',
    softEtchTitle: '軟水グラス白濁（エッチング）注意 (0–3 gpg)',
    softEtchBody: '日本の多くの水道水など軟水はカルシウムが少なくアルカリ洗剤が余りやすいです。上記の低用量を守り、食器を事前にピカピカに洗い流しすぎないでください。',
    softPodTitle: '警告：タブレット／ジェルボールは軟水で過剰投与になります',
    softPodBody: '固定量のタブレット（約20〜25g）は硬水向けに設計されています。軟水(0–3 gpg)ではグラスの永久白濁を早め洗剤残りの原因になるため、計量できる粉末洗剤をおすすめします。',
    podQuickWashTitle: 'タブレット投入位置＆時短コースの注意点',
    podQuickWashBody: '必ず乾いた本洗いポケットへ入れてください（庫内直置きは予洗いで流失します）。また45分未満のスピードコースでは溶け残り・すすぎ残しが起きやすいため避けてください。',
    gelStabilityTitle: '液体・ジェル洗剤の漂白安定性について',
    gelStabilityBody: '液体処方では酸素系漂白剤と酵素を同時に安定保持しにくいため容量を約25%増やしています。茶渋や焦げ汚れには粉末洗剤が圧倒的に強力です。',
    veryHardFilmTitle: '超硬水カルシウム白膜リスク (15+ gpg)',
    veryHardFilmBody: '250 ppm超の超硬水では白い水アカが蓄積します。リンス剤を6に設定し、予洗いにクエン酸小さじ1〜2を追加、軟水塩の補充と月1回の庫内洗浄を行ってください。',
    siliconeSafeConfirmTitle: 'シリコン向け無香料設定を確認済み ✓',
    siliconeSafeConfirmBody: '無香料洗剤の選択は完璧です！高温乾燥・除菌をOFFにしリンス剤も控えめにすれば、ベビー用シリコンへの石鹸味移りを防げます。',
    copyBtn: '計量設定をコピー',
    copiedBtn: 'コピーしました ✓',
    printBtn: '食洗機ガイドを印刷',
    resetBtn: 'リセット',
    vinegarTitle: '曇ったグラス診断：5分間ホワイトビネガー拭き取りテスト',
    vinegarSub: '5%食酢を含ませたペーパーで曇ったグラスを5分拭く（または浸す）→ すすいだ結果を選択：',
    vinegarStepsTitle: '具体的な対処プラン',
    emergencyToggleHint: 'クリックして泡あふれ緊急レスキュー4手順を開く',
    rulesTitle: 'グラスを守りピカピカに洗う3つの工学ルール',
    rulesSub: '食洗機の給排水タイミング・水質化学・酵素反応の原則に基づきます。',
    rule1Title: 'スタート前にキッチンのお湯を流す',
    rule1Body: '給湯配管の冷水を30秒抜くだけで、最初の10分予洗いが温水になり油落ちが格段に向上します。',
    rule2Title: '固形物だけ落とし、洗いすぎない',
    rule2Body: '汚れゼロで入れると濁度センサーが時短運転し、余ったアルカリ成分がグラス表面を攻撃します。',
    rule3Title: '予洗いポケットにも洗剤を入れる',
    rule3Body: '予洗い中は本洗いフタが閉じたままです。予洗いへ粉末小さじ0.5〜2足すだけで高級タブレット以上に洗浄力が上がります。',
    relatedHeading: '関連する食洗機・除垢・ベビー安全ツール',
    relatedDescaleTag: 'クエン酸・食酢の最適比率',
    relatedDescaleTitle: '家電製品・ケトル除垢比率計算機 →',
    relatedDescaleDesc: 'コーヒーメーカーや電気ケトル、硬水家電に安全なクエン酸グラム数と洗浄サイクルを算出。',
    relatedSymbolTag: '食洗機対応マーク解読',
    relatedSymbolTitle: 'キッチン家電・食器マークデコーダー →',
    relatedSymbolDesc: '上段のみ食洗機可・ワイングラスマーク・プラ材質表示・鍋底アイコンを瞬時に判別。',
    relatedBabyTag: 'シリコン・ガラス・プラ',
    relatedBabyTitle: '哺乳瓶＆ベビーシリコン安全チェッカー →',
    relatedBabyDesc: 'BPAフリー樹脂・シリコンの石鹸臭除去・スチーム消毒温度・食洗機耐熱上限を確認。',
    methodologyStripTitle: '家電水質化学とメーカー仕様書に基づく検証基準',
    methodologyStripPrefix: '硬度区分・アルカリpH上限・リンス剤基準は主要食洗機メーカー技術資料に準拠しています。詳細は',
    methodologyLabel: '検証メソドロジー',
    dishwasherHubLabel: '食洗機安全ハブ',
    allToolsLabel: '全ツール一覧 →',
    faqTitle: '食洗機洗剤・リンス剤・硬水に関するよくある質問',
    copyHeader: 'IsItKitchenSafe — 食洗機 洗剤・リンス剤 安全計量レシピ',
    copyProfileLine: '洗浄条件',
    copyMainLine: '本洗い洗剤量',
    copyPreLine: '予洗い洗剤量',
    copyRinseLine: 'リンス剤ダイヤル',
    copyCycleLine: '推奨コース＆水温',
    copyAlertsHeader: '安全アラート：'
  }
};

const t = UI[lang] || UI.en;

// Default SSR state: medium hardness, normal soil, powder detergent, no delicates, vinegar = wiped-clear
const defaultHardness = localizedHardness[1]; // medium
const defaultSoil = localizedSoil[1]; // normal
const defaultDetergent = localizedDetergents[0]; // powder
const defaultMatrixEntry = rawData.dosageMatrix.medium.normal;
const defaultVinegar = localizedVinegar['wiped-clear'];

const clientPayload = {
  lang,
  waterHardness: localizedHardness,
  soilLevels: localizedSoil,
  detergentTypes: localizedDetergents,
  dosageMatrix: rawData.dosageMatrix,
  delicateToggles: localizedDelicates,
  vinegarDiagnostic: localizedVinegar,
  ui: t
};
---

<div id="dishwasher-dosage-root" class="space-y-12">
  <!-- Main Interactive Calculator Card -->
  <section
    id="dishwasher-detergent-dosage-calculator"
    class="bg-canvas border border-hairline rounded-2xl shadow-sm overflow-hidden"
    aria-label={t.ariaLabel}
  >
    <script type="application/json" id="ddd-payload" set:html={JSON.stringify(clientPayload)} />

    <!-- Top Controls Panel: Steps 1–4 -->
    <div class="p-5 sm:p-6 md:p-8 border-b border-hairline bg-surface-soft/50 space-y-6 print:hidden">
      <!-- Step 1: Water Hardness (4 Tiers) -->
      <div class="space-y-2.5">
        <div>
          <h2 class="text-title-sm font-semibold text-ink">{t.step1Title}</h2>
          <p class="text-xs text-muted mt-0.5">{t.step1Sub}</p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5" role="radiogroup" aria-label={t.step1Title}>
          {localizedHardness.map((h) => {
            const isSelected = h.id === defaultHardness.id;
            return (
              <button
                type="button"
                role="radio"
                aria-checked={isSelected ? 'true' : 'false'}
                data-ddd-hardness={h.id}
                class={`ddd-hardness-btn p-3.5 rounded-xl border text-left transition-all cursor-pointer flex flex-col justify-between gap-1.5 ${
                  isSelected
                    ? 'bg-primary text-on-primary border-primary shadow-sm'
                    : 'bg-canvas text-ink border-hairline hover:border-border-strong'
                }`}
              >
                <div class="flex items-center justify-between gap-2 w-full">
                  <span class="text-sm font-bold leading-snug">
                    {h.icon} {h.label}
                  </span>
                </div>
                <span class="text-[11px] font-mono opacity-85">{h.shortRange}</span>
              </button>
            );
          })}
        </div>
        <p id="ddd-hardness-note" class="text-xs text-body bg-canvas border border-hairline rounded-xl px-3.5 py-2.5 leading-relaxed">
          {defaultHardness.summary}
        </p>
      </div>

      <!-- Step 2 (Soil Level) & Step 3 (Detergent Format) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <!-- Step 2: Soil Level -->
        <div class="lg:col-span-5 space-y-2.5">
          <h2 class="text-title-sm font-semibold text-ink">{t.step2Title}</h2>
          <div class="grid grid-cols-1 gap-2" role="radiogroup" aria-label={t.step2Title}>
            {localizedSoil.map((s) => {
              const isSelected = s.id === defaultSoil.id;
              return (
                <button
                  type="button"
                  role="radio"
                  aria-checked={isSelected ? 'true' : 'false'}
                  data-ddd-soil={s.id}
                  class={`ddd-soil-btn p-3 rounded-xl border text-left transition-all cursor-pointer flex items-start gap-2.5 ${
                    isSelected
                      ? 'bg-surface-soft border-signature-coral ring-2 ring-signature-coral shadow-sm'
                      : 'bg-canvas border-hairline hover:border-border-strong'
                  }`}
                >
                  <span aria-hidden="true" class="text-lg leading-none mt-0.5 shrink-0">{s.icon}</span>
                  <span class="min-w-0">
                    <span class="block text-xs sm:text-[13px] font-bold text-ink">{s.label}</span>
                    <span class="block text-[11px] text-muted leading-snug mt-0.5">{s.sub}</span>
                  </span>
                </button>
              );
            })}
          </div>
        </div>

        <!-- Step 3: Detergent Format -->
        <div class="lg:col-span-7 space-y-2.5">
          <h2 class="text-title-sm font-semibold text-ink">{t.step3Title}</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5" role="radiogroup" aria-label={t.step3Title}>
            {localizedDetergents.map((d) => {
              const isSelected = d.id === defaultDetergent.id;
              return (
                <button
                  type="button"
                  role="radio"
                  aria-checked={isSelected ? 'true' : 'false'}
                  data-ddd-detergent={d.id}
                  class={`ddd-detergent-btn p-3.5 rounded-xl border text-left transition-all cursor-pointer flex flex-col justify-between gap-2 ${
                    isSelected
                      ? 'bg-surface-soft border-signature-coral ring-2 ring-signature-coral shadow-sm'
                      : 'bg-canvas border-hairline hover:border-border-strong'
                  }`}
                >
                  <div class="flex items-start justify-between gap-2 w-full">
                    <span class="text-xs sm:text-[13px] font-bold text-ink leading-snug">
                      {d.icon} {d.label}
                    </span>
                    <span class={d.recommended || d.isFragranceFree ? 'badge-yes !px-2 !py-0.5 !text-[10px]' : 'badge-depends !px-2 !py-0.5 !text-[10px]'}>
                      {d.badge}
                    </span>
                  </div>
                  <span class="text-[11px] text-muted leading-relaxed">{d.note}</span>
                </button>
              );
            })}
          </div>
        </div>
      </div>

      <!-- Step 4: 4 Delicate Load Safety Checkboxes -->
      <div class="space-y-2.5 pt-1 border-t border-hairline">
        <div>
          <h2 class="text-title-sm font-semibold text-ink">{t.step4Title}</h2>
          <p class="text-xs text-muted mt-0.5">{t.step4Sub}</p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
          {localizedDelicates.map((item) => (
            <label
              data-ddd-delicate-card={item.id}
              class="ddd-delicate-label flex items-start gap-3 p-3.5 rounded-xl border bg-canvas border-hairline hover:border-border-strong transition-all cursor-pointer select-none"
            >
              <input
                type="checkbox"
                value={item.id}
                class="ddd-delicate-checkbox mt-0.5 w-4 h-4 rounded accent-signature-coral cursor-pointer shrink-0"
              />
              <span class="min-w-0 flex-1">
                <span class="block text-xs sm:text-[13px] font-bold text-ink leading-snug">
                  {item.icon} {item.label}
                </span>
              </span>
            </label>
          ))}
        </div>
      </div>
    </div>

    <!-- Live Calculation Dashboard -->
    <div class="p-5 sm:p-6 md:p-8 space-y-6 bg-surface-soft/30">
      <!-- High-Contrast Dark Header Banner + 4 Core Metrics -->
      <div
        id="ddd-result-banner"
        aria-live="polite"
        class="rounded-2xl bg-surface-dark text-on-dark p-5 sm:p-6 space-y-5 shadow-sm border-l-4 border-success-border"
      >
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div class="space-y-0.5">
            <span class="block text-[11px] font-bold uppercase tracking-wider text-signature-peach">
              {t.dashboardKicker}
            </span>
            <p id="ddd-profile-summary" class="text-xs sm:text-[13px] text-white/85 font-medium">
              {defaultHardness.label} ({defaultHardness.gpg}) · {defaultSoil.label} · {defaultDetergent.label}
            </p>
          </div>
          <span id="ddd-status-pill" class="badge-yes">
            {t.statusSafe}
          </span>
        </div>

        <!-- 4 Live Dosage & Setting Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
          <!-- 1. Main-Wash Dosage -->
          <div class="p-4 rounded-xl bg-white/5 border border-white/10 flex flex-col justify-between gap-2">
            <div>
              <span class="block text-[11px] font-semibold uppercase tracking-wider text-white/70">
                {t.mainWashLabel}
              </span>
              <div id="ddd-main-dose" class="text-xl sm:text-2xl font-extrabold font-mono text-signature-yellow mt-1 leading-tight">
                {defaultMatrixEntry.mainTbsp} {t.tbspUnit} ({Math.round(defaultMatrixEntry.mainTbsp * 15)} {t.mlUnit})
              </div>
            </div>
            <p id="ddd-main-sub" class="text-[11.5px] text-white/80 leading-snug pt-2 border-t border-white/10">
              {t.powderMainSub}
            </p>
          </div>

          <!-- 2. Pre-Wash Dosage -->
          <div class="p-4 rounded-xl bg-white/5 border border-white/10 flex flex-col justify-between gap-2">
            <div>
              <span class="block text-[11px] font-semibold uppercase tracking-wider text-white/70">
                {t.preWashLabel}
              </span>
              <div id="ddd-pre-dose" class="text-xl sm:text-2xl font-extrabold font-mono text-signature-mint mt-1 leading-tight">
                {defaultMatrixEntry.preTsp} {t.tspUnit} ({Math.round(defaultMatrixEntry.preTsp * 5)} {t.mlUnit})
              </div>
            </div>
            <p id="ddd-pre-sub" class="text-[11.5px] text-white/80 leading-snug pt-2 border-t border-white/10">
              {t.preWashWhy}
            </p>
          </div>

          <!-- 3. Rinse Aid Dial Setting (1-6) -->
          <div class="p-4 rounded-xl bg-white/5 border border-white/10 flex flex-col justify-between gap-2">
            <div>
              <span class="block text-[11px] font-semibold uppercase tracking-wider text-white/70">
                {t.rinseAidLabel}
              </span>
              <div class="flex items-baseline gap-1.5 mt-1">
                <span id="ddd-rinse-val" class="text-2xl sm:text-3xl font-extrabold font-mono text-white leading-none">
                  {defaultMatrixEntry.rinseAid}
                </span>
                <span class="text-xs font-bold text-white/70">{t.dialOfSix}</span>
              </div>
              <!-- 6-step visual dial bar -->
              <div id="ddd-rinse-bar" class="grid grid-cols-6 gap-1 mt-2.5" aria-hidden="true">
                {[1, 2, 3, 4, 5, 6].map((step) => (
                  <span
                    data-ddd-dial-step={step}
                    class={`h-2 rounded-full transition-colors ${
                      step <= defaultMatrixEntry.rinseAid ? 'bg-signature-mint' : 'bg-white/15'
                    }`}
                  />
                ))}
              </div>
            </div>
            <p id="ddd-rinse-sub" class="text-[11.5px] text-white/80 leading-snug pt-2 border-t border-white/10">
              {t.rinseAidStandardNote}
            </p>
          </div>

          <!-- 4. Cycle & Water Temp -->
          <div class="p-4 rounded-xl bg-white/5 border border-white/10 flex flex-col justify-between gap-2">
            <div>
              <span class="block text-[11px] font-semibold uppercase tracking-wider text-white/70">
                {t.cycleTempLabel}
              </span>
              <div id="ddd-cycle-title" class="text-sm sm:text-[15px] font-bold text-white mt-1 leading-snug">
                {t.cycleNormal}
              </div>
            </div>
            <p id="ddd-cycle-sub" class="text-[11.5px] text-white/80 leading-snug pt-2 border-t border-white/10">
              {t.cycleNormalSub}
            </p>
          </div>
        </div>

        <!-- Hot Tap Pro-Tip Strip -->
        <div class="p-3.5 rounded-xl bg-white/8 border border-white/15 flex items-start gap-2.5">
          <span aria-hidden="true" class="text-lg leading-none mt-0.5 shrink-0">🔥</span>
          <p class="text-xs text-white/90 leading-relaxed">
            <strong class="text-signature-peach">{t.hotTapTipTitle}</strong>{' '}
            {t.hotTapTipBody}
          </p>
        </div>
      </div>

      <!-- Active Risk & Material Safety Alerts -->
      <div class="space-y-3">
        <h3 class="text-xs sm:text-sm font-bold uppercase tracking-wider text-ink flex items-center gap-1.5">
          <span aria-hidden="true">🛡️</span> {t.alertsSectionTitle}
        </h3>
        <div id="ddd-alerts-container" class="space-y-2.5" aria-live="polite">
          <div class="p-4 rounded-xl bg-canvas border border-hairline flex items-start gap-3">
            <span aria-hidden="true" class="text-lg leading-none mt-0.5 shrink-0">✅</span>
            <p class="text-xs sm:text-[13px] text-body leading-relaxed">{t.noAlertsText}</p>
          </div>
        </div>
      </div>

      <!-- Copy / Print / Reset Actions -->
      <div class="flex flex-wrap items-center gap-2.5 pt-1 print:hidden">
        <button
          type="button"
          id="ddd-copy-btn"
          class="min-h-[44px] flex-1 px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold bg-primary text-on-primary hover:bg-primary-active transition-colors cursor-pointer shadow-sm"
        >
          <span id="ddd-copy-label">📋 {t.copyBtn}</span>
        </button>
        <button
          type="button"
          id="ddd-print-btn"
          class="min-h-[44px] px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold bg-canvas text-ink border border-hairline hover:border-signature-coral transition-colors cursor-pointer"
        >
          🖨️ {t.printBtn}
        </button>
        <button
          type="button"
          id="ddd-reset-btn"
          class="min-h-[44px] px-3.5 py-2.5 rounded-xl text-xs sm:text-sm font-semibold bg-canvas text-muted border border-hairline hover:border-border-strong hover:text-ink transition-colors cursor-pointer"
        >
          {t.resetBtn}
        </button>
      </div>
    </div>

    <!-- Interactive Cloudy Glass Vinegar Wipe Test Diagnostic -->
    <div class="border-t border-hairline p-5 sm:p-6 md:p-8 space-y-5">
      <div>
        <h2 class="text-title-md font-semibold text-ink">{t.vinegarTitle}</h2>
        <p class="text-xs sm:text-[13px] text-muted mt-1">{t.vinegarSub}</p>
      </div>

      <!-- 2-Way Toggle Buttons -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3 print:hidden" role="radiogroup" aria-label={t.vinegarTitle}>
        <button
          type="button"
          role="radio"
          aria-checked="true"
          data-ddd-vinegar="wiped-clear"
          class="ddd-vinegar-btn p-4 rounded-xl border text-left transition-all cursor-pointer flex items-start gap-3 bg-surface-soft border-signature-coral ring-2 ring-signature-coral shadow-sm"
        >
          <span aria-hidden="true" class="text-2xl leading-none shrink-0">{localizedVinegar['wiped-clear'].icon}</span>
          <span class="min-w-0">
            <span class="block text-sm font-bold text-ink">{localizedVinegar['wiped-clear'].buttonLabel}</span>
            <span class="block text-xs text-muted mt-0.5 leading-snug">{localizedVinegar['wiped-clear'].buttonSub}</span>
          </span>
        </button>

        <button
          type="button"
          role="radio"
          aria-checked="false"
          data-ddd-vinegar="stayed-cloudy"
          class="ddd-vinegar-btn p-4 rounded-xl border text-left transition-all cursor-pointer flex items-start gap-3 bg-canvas border-hairline hover:border-error-border"
        >
          <span aria-hidden="true" class="text-2xl leading-none shrink-0">{localizedVinegar['stayed-cloudy'].icon}</span>
          <span class="min-w-0">
            <span class="block text-sm font-bold text-ink">{localizedVinegar['stayed-cloudy'].buttonLabel}</span>
            <span class="block text-xs text-muted mt-0.5 leading-snug">{localizedVinegar['stayed-cloudy'].buttonSub}</span>
          </span>
        </button>
      </div>

      <!-- Live Vinegar Diagnostic Output -->
      <div
        id="ddd-vinegar-panel"
        aria-live="polite"
        class="p-5 rounded-2xl border bg-emerald-500/10 dark:bg-emerald-950/30 border-success-border/70 space-y-3.5"
      >
        <div class="flex flex-wrap items-center justify-between gap-2">
          <span id="ddd-vinegar-badge" class="badge-yes">
            {defaultVinegar.verdictBadge}
          </span>
        </div>
        <h3 id="ddd-vinegar-title" class="text-title-sm font-bold text-ink leading-snug">
          {defaultVinegar.title}
        </h3>
        <p id="ddd-vinegar-explanation" class="text-xs sm:text-[13.5px] text-body leading-relaxed">
          {defaultVinegar.explanation}
        </p>
        <div class="p-4 rounded-xl bg-canvas border border-hairline space-y-2">
          <h4 class="text-xs font-bold uppercase tracking-wider text-ink">{t.vinegarStepsTitle}</h4>
          <ol id="ddd-vinegar-fixes" class="space-y-2 text-xs sm:text-[13px] text-body list-decimal list-outside pl-5">
            {defaultVinegar.fixes.map((fix) => (
              <li class="leading-relaxed pl-1">{fix}</li>
            ))}
          </ol>
        </div>
      </div>
    </div>

    <!-- Expandable Emergency Dish Soap (Dawn) Foam Overflow Rescue Card -->
    <div class="border-t-2 border-error-border bg-error-bg/55 dark:bg-red-950/30 p-5 sm:p-6 md:p-8">
      <details id="ddd-emergency-details" class="group">
        <summary class="cursor-pointer list-none flex flex-wrap items-center justify-between gap-3">
          <div class="space-y-1 max-w-3xl">
            <span class="inline-block px-2.5 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wider bg-error text-white">
              🚨 {localizedEmergency.badge}
            </span>
            <h2 class="text-title-sm sm:text-title-md font-extrabold text-ink leading-snug">
              {localizedEmergency.title}
            </h2>
          </div>
          <span class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-bold bg-canvas text-ink border border-error-border shadow-xs shrink-0">
            <span>{t.emergencyToggleHint}</span>
            <span class="transition-transform group-open:rotate-180" aria-hidden="true">&#9662;</span>
          </span>
        </summary>

        <div class="mt-4 pt-4 border-t border-error-border/50 space-y-4">
          <p class="text-xs sm:text-[13.5px] text-body leading-relaxed">
            {localizedEmergency.subtitle}
          </p>
          <div class="p-4 sm:p-5 rounded-xl bg-canvas border border-error-border/60">
            <ol class="space-y-3 text-xs sm:text-[13.5px] text-body list-decimal list-outside pl-5">
              {localizedEmergency.steps.map((step) => (
                <li class="leading-relaxed pl-1">{step}</li>
              ))}
            </ol>
          </div>
          <div class="p-3.5 rounded-xl bg-warning-bg/80 dark:bg-amber-950/40 border border-warning-border text-xs font-bold text-ink leading-relaxed">
            ⚡ {localizedEmergency.warning}
          </div>
        </div>
      </details>
    </div>

    <!-- 3 Science-Backed Dishwasher Rules Strip -->
    <div class="border-t border-hairline p-5 sm:p-6 md:p-8 bg-surface-soft/50 space-y-4">
      <div>
        <h2 class="text-title-md font-semibold text-ink">{t.rulesTitle}</h2>
        <p class="text-xs text-muted mt-0.5">{t.rulesSub}</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <article class="p-4 rounded-xl border bg-canvas border-hairline space-y-1.5">
          <div class="flex items-center gap-2">
            <span aria-hidden="true" class="text-lg">🚰</span>
            <h3 class="text-xs sm:text-sm font-bold text-ink leading-snug">{t.rule1Title}</h3>
          </div>
          <p class="text-xs text-body leading-relaxed">{t.rule1Body}</p>
        </article>
        <article class="p-4 rounded-xl border bg-warning-bg/55 dark:bg-amber-950/25 border-warning-border/70 space-y-1.5">
          <div class="flex items-center gap-2">
            <span aria-hidden="true" class="text-lg">🍽️</span>
            <h3 class="text-xs sm:text-sm font-bold text-ink leading-snug">{t.rule2Title}</h3>
          </div>
          <p class="text-xs text-body leading-relaxed">{t.rule2Body}</p>
        </article>
        <article class="p-4 rounded-xl border bg-canvas border-hairline space-y-1.5">
          <div class="flex items-center gap-2">
            <span aria-hidden="true" class="text-lg">🥄</span>
            <h3 class="text-xs sm:text-sm font-bold text-ink leading-snug">{t.rule3Title}</h3>
          </div>
          <p class="text-xs text-body leading-relaxed">{t.rule3Body}</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Related Companion Tools -->
  <section class="space-y-4 print:hidden">
    <h2 class="text-title-md font-semibold text-ink">{t.relatedHeading}</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      <a
        href={descalingUrl}
        class="p-6 rounded-2xl bg-surface-soft border border-hairline hover:border-signature-coral transition-all group block"
      >
        <span class="text-[11px] font-bold uppercase tracking-wider text-signature-coral block mb-1.5">
          {t.relatedDescaleTag}
        </span>
        <h3 class="text-title-sm font-semibold text-ink group-hover:text-signature-coral transition-colors mb-1.5">
          {t.relatedDescaleTitle}
        </h3>
        <p class="text-[13.5px] text-body leading-relaxed">{t.relatedDescaleDesc}</p>
      </a>

      <a
        href={symbolDecoderUrl}
        class="p-6 rounded-2xl bg-surface-soft border border-hairline hover:border-signature-coral transition-all group block"
      >
        <span class="text-[11px] font-bold uppercase tracking-wider text-signature-coral block mb-1.5">
          {t.relatedSymbolTag}
        </span>
        <h3 class="text-title-sm font-semibold text-ink group-hover:text-signature-coral transition-colors mb-1.5">
          {t.relatedSymbolTitle}
        </h3>
        <p class="text-[13.5px] text-body leading-relaxed">{t.relatedSymbolDesc}</p>
      </a>

      <a
        href={babyBottleUrl}
        class="p-6 rounded-2xl bg-surface-soft border border-hairline hover:border-signature-coral transition-all group block"
      >
        <span class="text-[11px] font-bold uppercase tracking-wider text-signature-coral block mb-1.5">
          {t.relatedBabyTag}
        </span>
        <h3 class="text-title-sm font-semibold text-ink group-hover:text-signature-coral transition-colors mb-1.5">
          {t.relatedBabyTitle}
        </h3>
        <p class="text-[13.5px] text-body leading-relaxed">{t.relatedBabyDesc}</p>
      </a>
    </div>
  </section>

  <!-- Methodology & Hub Strip -->
  <section class="p-6 rounded-2xl bg-surface-soft border border-hairline print:hidden">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <h2 class="text-title-sm font-semibold text-ink mb-1">{t.methodologyStripTitle}</h2>
        <p class="text-[13px] text-muted">
          {t.methodologyStripPrefix}{' '}
          <a href={methodologyUrl} class="text-link underline hover:text-link-active">{t.methodologyLabel}</a>.
        </p>
      </div>
      <div class="flex flex-wrap gap-2">
        <a
          href={dishwasherHubUrl}
          class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral transition-colors"
        >
          {t.dishwasherHubLabel}
        </a>
        <a
          href={methodologyUrl}
          class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral transition-colors"
        >
          {t.methodologyLabel}
        </a>
        <a
          href={allToolsUrl}
          class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-primary text-on-primary hover:bg-primary-active transition-colors"
        >
          {t.allToolsLabel}
        </a>
      </div>
    </div>
  </section>

  <!-- Visible FAQ Accordion (Matches FAQPage JSON-LD 1:1) -->
  <section class="print:hidden">
    <h2 class="text-title-lg font-medium text-ink tracking-tight mb-6">
      {t.faqTitle}
    </h2>
    <div class="space-y-4">
      {localizedFaqs.map((faq) => (
        <details class="group p-5 bg-surface-soft border border-hairline rounded-xl" open>
          <summary class="text-title-sm font-semibold text-ink cursor-pointer list-none flex items-center justify-between gap-3">
            <span>{faq.question}</span>
            <span class="text-muted text-sm transition-transform group-open:rotate-180 shrink-0" aria-hidden="true">&#9662;</span>
          </summary>
          <p class="text-[14px] text-body leading-relaxed mt-3 pt-3 border-t border-hairline/70">
            {faq.answer}
          </p>
        </details>
      ))}
    </div>
  </section>
</div>

<script is:inline>
  (function () {
    var payloadEl = document.getElementById('ddd-payload');
    if (!payloadEl) return;

    var payload;
    try {
      payload = JSON.parse(payloadEl.textContent || '{}');
    } catch (_) {
      return;
    }

    var hardnessList = payload.waterHardness || [];
    var soilList = payload.soilLevels || [];
    var detergentList = payload.detergentTypes || [];
    var matrix = payload.dosageMatrix || {};
    var delicateList = payload.delicateToggles || [];
    var vinegarData = payload.vinegarDiagnostic || {};
    var ui = payload.ui || {};

    if (!hardnessList.length || !soilList.length || !detergentList.length) return;

    var hardnessById = new Map();
    hardnessList.forEach(function (h) { hardnessById.set(h.id, h); });

    var soilById = new Map();
    soilList.forEach(function (s) { soilById.set(s.id, s); });

    var detergentById = new Map();
    detergentList.forEach(function (d) { detergentById.set(d.id, d); });

    var delicateById = new Map();
    delicateList.forEach(function (item) { delicateById.set(item.id, item); });

    // Controls
    var hardnessBtns = Array.from(document.querySelectorAll('.ddd-hardness-btn'));
    var soilBtns = Array.from(document.querySelectorAll('.ddd-soil-btn'));
    var detergentBtns = Array.from(document.querySelectorAll('.ddd-detergent-btn'));
    var delicateCheckboxes = Array.from(document.querySelectorAll('.ddd-delicate-checkbox'));
    var vinegarBtns = Array.from(document.querySelectorAll('.ddd-vinegar-btn'));

    // Outputs
    var hardnessNoteEl = document.getElementById('ddd-hardness-note');
    var resultBanner = document.getElementById('ddd-result-banner');
    var profileSummaryEl = document.getElementById('ddd-profile-summary');
    var statusPillEl = document.getElementById('ddd-status-pill');
    var mainDoseEl = document.getElementById('ddd-main-dose');
    var mainSubEl = document.getElementById('ddd-main-sub');
    var preDoseEl = document.getElementById('ddd-pre-dose');
    var preSubEl = document.getElementById('ddd-pre-sub');
    var rinseValEl = document.getElementById('ddd-rinse-val');
    var rinseSubEl = document.getElementById('ddd-rinse-sub');
    var dialSteps = Array.from(document.querySelectorAll('[data-ddd-dial-step]'));
    var cycleTitleEl = document.getElementById('ddd-cycle-title');
    var cycleSubEl = document.getElementById('ddd-cycle-sub');
    var alertsContainer = document.getElementById('ddd-alerts-container');

    // Vinegar outputs
    var vinegarPanel = document.getElementById('ddd-vinegar-panel');
    var vinegarBadge = document.getElementById('ddd-vinegar-badge');
    var vinegarTitle = document.getElementById('ddd-vinegar-title');
    var vinegarExplanation = document.getElementById('ddd-vinegar-explanation');
    var vinegarFixes = document.getElementById('ddd-vinegar-fixes');

    // Action buttons
    var copyBtn = document.getElementById('ddd-copy-btn');
    var copyLabel = document.getElementById('ddd-copy-label');
    var printBtn = document.getElementById('ddd-print-btn');
    var resetBtn = document.getElementById('ddd-reset-btn');

    var state = {
      hardnessId: 'medium',
      soilId: 'normal',
      detergentId: 'powder',
      delicates: new Set(),
      vinegarId: 'wiped-clear'
    };

    var lastCopyText = '';

    function roundHalf(val) {
      return Math.round(val * 2) / 2;
    }

    function fmtNum(val) {
      return Number.isInteger(val) ? String(val) : String(val);
    }

    function clearChildren(el) {
      while (el && el.firstChild) {
        el.removeChild(el.firstChild);
      }
    }

    function createAlertCard(severity, icon, title, body) {
      var card = document.createElement('div');
      var baseClasses = 'p-4 rounded-xl border flex items-start gap-3 ';
      if (severity === 'danger') {
        card.className = baseClasses + 'bg-error-bg/65 dark:bg-red-950/35 border-error-border';
      } else if (severity === 'warning') {
        card.className = baseClasses + 'bg-warning-bg/70 dark:bg-amber-950/30 border-warning-border';
      } else if (severity === 'success') {
        card.className = baseClasses + 'bg-emerald-500/10 dark:bg-emerald-950/30 border-success-border/70';
      } else {
        card.className = baseClasses + 'bg-canvas border-hairline';
      }

      var iconSpan = document.createElement('span');
      iconSpan.setAttribute('aria-hidden', 'true');
      iconSpan.className = 'text-lg leading-none mt-0.5 shrink-0';
      iconSpan.textContent = icon;

      var textWrap = document.createElement('div');
      textWrap.className = 'min-w-0 space-y-1';

      if (title) {
        var heading = document.createElement('h4');
        heading.className = 'text-xs sm:text-[13px] font-bold text-ink leading-snug';
        heading.textContent = title;
        textWrap.appendChild(heading);
      }

      var para = document.createElement('p');
      para.className = 'text-xs sm:text-[13px] text-body leading-relaxed';
      para.textContent = body;
      textWrap.appendChild(para);

      card.appendChild(iconSpan);
      card.appendChild(textWrap);
      return card;
    }

    function renderVinegar() {
      var result = vinegarData[state.vinegarId] || vinegarData['wiped-clear'];
      if (!result) return;

      vinegarBtns.forEach(function (btn) {
        var vid = btn.getAttribute('data-ddd-vinegar');
        var active = vid === state.vinegarId;
        btn.setAttribute('aria-checked', active ? 'true' : 'false');
        btn.classList.remove(
          'bg-surface-soft',
          'border-signature-coral',
          'ring-2',
          'ring-signature-coral',
          'shadow-sm',
          'bg-canvas',
          'border-hairline'
        );
        if (active) {
          btn.classList.add('bg-surface-soft', 'border-signature-coral', 'ring-2', 'ring-signature-coral', 'shadow-sm');
        } else {
          btn.classList.add('bg-canvas', 'border-hairline');
        }
      });

      var isReversible = result.status === 'reversible';
      if (vinegarPanel) {
        vinegarPanel.className = isReversible
          ? 'p-5 rounded-2xl border bg-emerald-500/10 dark:bg-emerald-950/30 border-success-border/70 space-y-3.5'
          : 'p-5 rounded-2xl border bg-error-bg/60 dark:bg-red-950/35 border-error-border space-y-3.5';
      }
      if (vinegarBadge) {
        vinegarBadge.className = isReversible ? 'badge-yes' : 'badge-no';
        vinegarBadge.textContent = result.verdictBadge;
      }
      if (vinegarTitle) vinegarTitle.textContent = result.title;
      if (vinegarExplanation) vinegarExplanation.textContent = result.explanation;

      if (vinegarFixes) {
        clearChildren(vinegarFixes);
        (result.fixes || []).forEach(function (stepText) {
          var li = document.createElement('li');
          li.className = 'leading-relaxed pl-1';
          li.textContent = stepText;
          vinegarFixes.appendChild(li);
        });
      }
    }

    function render() {
      var hObj = hardnessById.get(state.hardnessId) || hardnessList[1];
      var sObj = soilById.get(state.soilId) || soilList[1];
      var dObj = detergentById.get(state.detergentId) || detergentList[0];

      var hasSilicone = state.delicates.has('silicone-baby');
      var hasCrystal = state.delicates.has('crystal-glass');
      var hasAluminum = state.delicates.has('aluminum');
      var hasNonstick = state.delicates.has('nonstick-knives');

      // Update Hardness buttons
      hardnessBtns.forEach(function (btn) {
        var active = btn.getAttribute('data-ddd-hardness') === state.hardnessId;
        btn.setAttribute('aria-checked', active ? 'true' : 'false');
        btn.classList.toggle('bg-primary', active);
        btn.classList.toggle('text-on-primary', active);
        btn.classList.toggle('border-primary', active);
        btn.classList.toggle('shadow-sm', active);
        btn.classList.toggle('bg-canvas', !active);
        btn.classList.toggle('text-ink', !active);
        btn.classList.toggle('border-hairline', !active);
      });
      if (hardnessNoteEl) hardnessNoteEl.textContent = hObj.summary;

      // Update Soil buttons
      soilBtns.forEach(function (btn) {
        var active = btn.getAttribute('data-ddd-soil') === state.soilId;
        btn.setAttribute('aria-checked', active ? 'true' : 'false');
        btn.classList.toggle('bg-surface-soft', active);
        btn.classList.toggle('border-signature-coral', active);
        btn.classList.toggle('ring-2', active);
        btn.classList.toggle('ring-signature-coral', active);
        btn.classList.toggle('shadow-sm', active);
        btn.classList.toggle('bg-canvas', !active);
        btn.classList.toggle('border-hairline', !active);
      });

      // Update Detergent buttons
      detergentBtns.forEach(function (btn) {
        var active = btn.getAttribute('data-ddd-detergent') === state.detergentId;
        btn.setAttribute('aria-checked', active ? 'true' : 'false');
        btn.classList.toggle('bg-surface-soft', active);
        btn.classList.toggle('border-signature-coral', active);
        btn.classList.toggle('ring-2', active);
        btn.classList.toggle('ring-signature-coral', active);
        btn.classList.toggle('shadow-sm', active);
        btn.classList.toggle('bg-canvas', !active);
        btn.classList.toggle('border-hairline', !active);
      });

      // Update Delicate cards styling
      delicateCheckboxes.forEach(function (cb) {
        var checked = state.delicates.has(cb.value);
        cb.checked = checked;
        var card = cb.closest('.ddd-delicate-label');
        if (!card) return;
        var itemObj = delicateById.get(cb.value);
        var isDanger = Boolean(itemObj && itemObj.severity === 'danger');

        card.classList.remove(
          'bg-canvas',
          'border-hairline',
          'bg-warning-bg/65',
          'dark:bg-amber-950/30',
          'border-warning-border',
          'bg-error-bg/65',
          'dark:bg-red-950/35',
          'border-error-border'
        );

        if (checked && isDanger) {
          card.classList.add('bg-error-bg/65', 'dark:bg-red-950/35', 'border-error-border');
        } else if (checked) {
          card.classList.add('bg-warning-bg/65', 'dark:bg-amber-950/30', 'border-warning-border');
        } else {
          card.classList.add('bg-canvas', 'border-hairline');
        }
      });

      // Lookup base dosage
      var row = (matrix[state.hardnessId] && matrix[state.hardnessId][state.soilId]) || {
        mainTbsp: 1.5,
        preTsp: 1.0,
        rinseAid: 3
      };

      var mainTbsp = row.mainTbsp;
      var preTsp = row.preTsp;
      var rinseDial = row.rinseAid;

      // Liquid gel dilution adjustment (+25%, capped at 3 tbsp)
      if (state.detergentId === 'liquid-gel') {
        mainTbsp = Math.min(3, roundHalf(mainTbsp * 1.25));
      }

      // Fine crystal etching protection (-25% dose on adjustable detergents, min 0.5 tbsp)
      if (hasCrystal && state.detergentId !== 'pod') {
        mainTbsp = Math.max(0.5, roundHalf(mainTbsp * 0.75));
        preTsp = Math.max(0, roundHalf(preTsp * 0.75));
      }

      // Silicone rinse aid notch down
      if (hasSilicone && rinseDial > 1) {
        rinseDial = rinseDial - 1;
      }

      var mainMl = Math.round(mainTbsp * 15);
      var preMl = Math.round(preTsp * 5);

      // Format Main-Wash output
      var mainText = '';
      var mainSub = '';
      if (state.detergentId === 'pod') {
        mainText = ui.podMainText || '1 Pod';
        mainSub = ui.podMainSub || '';
      } else {
        mainText = fmtNum(mainTbsp) + ' ' + (ui.tbspUnit || 'tbsp') + ' (' + mainMl + ' ' + (ui.mlUnit || 'mL') + ')';
        if (state.detergentId === 'liquid-gel') {
          mainSub = ui.gelMainSub || '';
        } else if (state.detergentId === 'fragrance-free') {
          mainSub = ui.ffMainSub || '';
        } else {
          mainSub = ui.powderMainSub || '';
        }
        if (hasCrystal && ui.crystalCutNote) {
          mainSub = mainSub + ' · ' + ui.crystalCutNote;
        }
      }

      // Format Pre-Wash output
      var preText = '';
      var preSub = '';
      if (state.detergentId === 'pod') {
        if (state.hardnessId === 'soft' && state.soilId !== 'heavy') {
          preText = '0 ' + (ui.tspUnit || 'tsp');
          preSub = ui.podPreSkip || '';
        } else {
          var podPreTsp = preTsp > 0 ? preTsp : 1;
          var podPreMl = Math.round(podPreTsp * 5);
          preText = (ui.podPreAddPrefix || '+ ') + fmtNum(podPreTsp) + ' ' + (ui.tspUnit || 'tsp') + ' (' + podPreMl + ' ' + (ui.mlUnit || 'mL') + ')';
          preSub = (ui.podPreAddSuffix || '') + (hObj.citricBoost && ui.citricBoosterNote ? ' ' + ui.citricBoosterNote : '');
        }
      } else {
        preText = fmtNum(preTsp) + ' ' + (ui.tspUnit || 'tsp') + ' (' + preMl + ' ' + (ui.mlUnit || 'mL') + ')';
        if (preTsp === 0) {
          preSub = ui.preWashNoneNote || '';
        } else {
          preSub = (ui.preWashWhy || '') + (hObj.citricBoost && ui.citricBoosterNote ? ' ' + ui.citricBoosterNote : '');
        }
      }

      // Format Rinse Aid note
      var rinseSub = ui.rinseAidStandardNote || '';
      if (hasSilicone) {
        rinseSub = ui.rinseAidSiliconeNote || rinseSub;
      } else if (rinseDial >= 6) {
        rinseSub = ui.rinseAidMaxNote || rinseSub;
      }

      // Cycle & Temp recommendation
      var cycleTitle = ui.cycleNormal || '';
      var cycleSub = ui.cycleNormalSub || '';
      if (hasCrystal || hasSilicone) {
        cycleTitle = ui.cycleDelicate || cycleTitle;
        cycleSub = ui.cycleDelicateSub || cycleSub;
      } else if (state.soilId === 'heavy') {
        cycleTitle = ui.cycleHeavy || cycleTitle;
        cycleSub = ui.cycleHeavySub || cycleSub;
      } else if (state.soilId === 'light') {
        cycleTitle = ui.cycleLight || cycleTitle;
        cycleSub = ui.cycleLightSub || cycleSub;
      }

      // Build Active Risk Alerts
      var alerts = [];
      var highestSeverity = 'safe';

      function pushAlert(sev, icon, title, body) {
        alerts.push({ severity: sev, icon: icon, title: title, body: body });
        if (sev === 'danger') {
          highestSeverity = 'danger';
        } else if (sev === 'warning' && highestSeverity !== 'danger') {
          highestSeverity = 'warning';
        }
      }

      // Critical Hand-Wash-Only Alerts first
      if (hasAluminum) {
        var alObj = delicateById.get('aluminum');
        if (alObj) pushAlert('danger', '🚨', alObj.alertTitle, alObj.alertBody);
      }
      if (hasNonstick) {
        var nkObj = delicateById.get('nonstick-knives');
        if (nkObj) pushAlert('danger', '🚨', nkObj.alertTitle, nkObj.alertBody);
      }

      // Soft water + Pod critical etching warning
      if (state.hardnessId === 'soft' && state.detergentId === 'pod') {
        pushAlert('danger', '⚠️', ui.softPodTitle, ui.softPodBody);
      } else if (state.hardnessId === 'soft') {
        pushAlert('warning', '💧', ui.softEtchTitle, ui.softEtchBody);
      }

      // Silicone baby gear alerts
      if (hasSilicone) {
        var silObj = delicateById.get('silicone-baby');
        if (state.detergentId !== 'fragrance-free') {
          if (silObj) pushAlert('danger', '🍼', silObj.alertTitle, silObj.alertBody);
        } else {
          pushAlert('success', '🌿', ui.siliconeSafeConfirmTitle, ui.siliconeSafeConfirmBody);
        }
      }

      // Fine crystal alert
      if (hasCrystal) {
        var cryObj = delicateById.get('crystal-glass');
        if (cryObj) pushAlert('warning', '🍷', cryObj.alertTitle, cryObj.alertBody);
      }

      // Pod general rule
      if (state.detergentId === 'pod') {
        pushAlert('warning', '💊', ui.podQuickWashTitle, ui.podQuickWashBody);
      }

      // Liquid gel note
      if (state.detergentId === 'liquid-gel') {
        pushAlert('info', '🧴', ui.gelStabilityTitle, ui.gelStabilityBody);
      }

      // Very hard water film alert
      if (state.hardnessId === 'very-hard') {
        pushAlert('warning', '⛰️', ui.veryHardFilmTitle, ui.veryHardFilmBody);
      }

      // Update DOM outputs
      if (profileSummaryEl) {
        profileSummaryEl.textContent = hObj.label + ' (' + hObj.gpg + ') · ' + sObj.label + ' · ' + dObj.label;
      }
      if (mainDoseEl) mainDoseEl.textContent = mainText;
      if (mainSubEl) mainSubEl.textContent = mainSub;
      if (preDoseEl) preDoseEl.textContent = preText;
      if (preSubEl) preSubEl.textContent = preSub;
      if (rinseValEl) rinseValEl.textContent = String(rinseDial);
      if (rinseSubEl) rinseSubEl.textContent = rinseSub;
      if (cycleTitleEl) cycleTitleEl.textContent = cycleTitle;
      if (cycleSubEl) cycleSubEl.textContent = cycleSub;

      // Update 6-step Rinse Aid bar
      dialSteps.forEach(function (stepEl) {
        var n = Number(stepEl.getAttribute('data-ddd-dial-step') || '0');
        var lit = n <= rinseDial;
        stepEl.classList.toggle('bg-signature-mint', lit);
        stepEl.classList.toggle('bg-white/15', !lit);
      });

      // Update Banner Status Pill & Accent Border
      if (statusPillEl) {
        if (highestSeverity === 'danger') {
          statusPillEl.className = 'badge-no';
          statusPillEl.textContent = (hasAluminum || hasNonstick) ? (ui.statusStop || 'STOP') : (ui.statusCaution || 'CAUTION');
        } else if (highestSeverity === 'warning') {
          statusPillEl.className = 'badge-depends';
          statusPillEl.textContent = ui.statusCaution || 'ADJUST';
        } else {
          statusPillEl.className = 'badge-yes';
          statusPillEl.textContent = ui.statusSafe || 'OPTIMAL';
        }
      }

      if (resultBanner) {
        resultBanner.classList.remove('border-success-border', 'border-warning-border', 'border-error-border');
        resultBanner.classList.add(
          highestSeverity === 'danger'
            ? 'border-error-border'
            : highestSeverity === 'warning'
              ? 'border-warning-border'
              : 'border-success-border'
        );
      }

      // Render alerts via pure DOM
      if (alertsContainer) {
        clearChildren(alertsContainer);
        if (!alerts.length) {
          alertsContainer.appendChild(createAlertCard('info', '✅', '', ui.noAlertsText || ''));
        } else {
          alerts.forEach(function (al) {
            alertsContainer.appendChild(createAlertCard(al.severity, al.icon, al.title, al.body));
          });
        }
      }

      // Build plain-text copy buffer
      var copyLines = [
        ui.copyHeader || 'Dishwasher Dosage Settings',
        (ui.copyProfileLine || 'Profile') + ': ' + hObj.label + ' (' + hObj.gpg + ') | ' + sObj.label + ' | ' + dObj.label,
        (ui.copyMainLine || 'Main-Wash') + ': ' + mainText + ' (' + mainSub + ')',
        (ui.copyPreLine || 'Pre-Wash') + ': ' + preText,
        (ui.copyRinseLine || 'Rinse Aid') + ': ' + rinseDial + ' ' + (ui.dialOfSix || '/ 6'),
        (ui.copyCycleLine || 'Cycle & Temp') + ': ' + cycleTitle
      ];
      if (alerts.length) {
        copyLines.push('');
        copyLines.push(ui.copyAlertsHeader || 'Alerts:');
        alerts.forEach(function (al) {
          copyLines.push('  - ' + al.title + ': ' + al.body);
        });
      }
      lastCopyText = copyLines.join('\n');
    }

    // Event bindings
    hardnessBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var hid = btn.getAttribute('data-ddd-hardness');
        if (hid && hardnessById.has(hid)) {
          state.hardnessId = hid;
          render();
        }
      });
    });

    soilBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var sid = btn.getAttribute('data-ddd-soil');
        if (sid && soilById.has(sid)) {
          state.soilId = sid;
          render();
        }
      });
    });

    detergentBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var did = btn.getAttribute('data-ddd-detergent');
        if (did && detergentById.has(did)) {
          state.detergentId = did;
          render();
        }
      });
    });

    delicateCheckboxes.forEach(function (cb) {
      cb.addEventListener('change', function () {
        if (cb.checked) {
          state.delicates.add(cb.value);
        } else {
          state.delicates.delete(cb.value);
        }
        render();
      });
    });

    vinegarBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var vid = btn.getAttribute('data-ddd-vinegar');
        if (vid && vinegarData[vid]) {
          state.vinegarId = vid;
          renderVinegar();
        }
      });
    });

    if (copyBtn) {
      copyBtn.addEventListener('click', function () {
        var showCopied = function () {
          if (copyLabel) copyLabel.textContent = ui.copiedBtn || 'Dosage Copied ✓';
          window.setTimeout(function () {
            if (copyLabel) copyLabel.textContent = '📋 ' + (ui.copyBtn || 'Copy Dosage Settings');
          }, 2200);
        };
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(lastCopyText).then(showCopied).catch(showCopied);
        } else {
          var ta = document.createElement('textarea');
          ta.value = lastCopyText;
          ta.setAttribute('readonly', '');
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          try { document.execCommand('copy'); } catch (_) {}
          document.body.removeChild(ta);
          showCopied();
        }
      });
    }

    if (printBtn) {
      printBtn.addEventListener('click', function () {
        window.print();
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', function () {
        state.hardnessId = 'medium';
        state.soilId = 'normal';
        state.detergentId = 'powder';
        state.delicates.clear();
        state.vinegarId = 'wiped-clear';
        render();
        renderVinegar();
      });
    }

    render();
    renderVinegar();
  })();
</script>
