    botanicalHelp: "赤ワインブドウ果皮残渣、緑茶抽出後茶殻残渣、柑橘類果皮、赤タマネギ外皮・リンゴ搾汁粕、エルダーベリー残渣、オリーブ剪定葉を選択。",
    filterLabel: "インライン高温耐熱セラミックろ過膜:",
    filterHelp: "高温アルミナセラミッククロスフロー精密ろ過膜（0.14 µm α-Al2O3）、焼結多孔質チタン金属エレメント（0.50 µm）、ジルコニア限外ろ過膜（50 kDa）を選択。",
    quenchLabel: "抽出後インライン超速急冷熱交換システム:",
    quenchHelp: "二重管式サニタリーグリコール急冷熱交換器（<2.2秒急冷）、ハステロイマイクロチャンネル急冷器（<1.2秒）、無補助自然冷却流路（高温劣化警告）を選択。",
    tempLabel: "亜臨界抽出処理温度 (T_ext):",
    tempHelp: "加圧非沸騰高温液水温度（110.0〜220.0°C）。水の比誘電率を制御し、ターゲットとする中・低極性フラボノイドを迅速溶解。",
    pressureLabel: "システム作動油圧圧力 (P_op):",
    pressureHelp: "システム油圧作動圧力（25.0〜90.0 bar / 2.5〜9.0 MPa）。高温水を液相状態に保持し、気化フラッシュ蒸発を完全阻止。",
    flowLabel: "原料スラリー／溶媒連続容積流量 (Q_flow):",
    flowHelp: "抽出カラムおよびセラミック膜を通過する連続流量（100〜1,500 L/h）。",
    residenceLabel: "動的抽出ゾーン平均滞留時間 (t_res):",
    residenceHelp: "植物組織が高温亜臨界水ゾーンに接触する平均時間（1.5〜15.0分）。",
    solidRatioLabel: "固液比・バイオマス投入濃度 (S/L):",
    solidRatioHelp: "亜臨界水流中の乾燥バイオマス固形分濃度（30〜200 g/L）。",
    presetsTitle: "産業用標準プロセスプリセット:",
    presetGrape: "ブドウ皮残渣アントシアニン＆レスベラトロール回収",
    presetTea: "緑茶高純度EGCG＆カテキン完全無溶媒抽出",
    presetQuercetin: "タマネギ皮ケルセチン配糖体水熱脱糖分解抽出",
    presetCitrus: "柑橘類果皮ヘスペリジン＆フラボノイド循環回収",
    presetHazard: "飽和蒸気フラッシュ＆熱分解変色危険工況",
    diagnosticTitle: "リアルタイム水熱流体力学診断テレメトリ",
    diagnosticSub: "水の比誘電率、抽出回収率、総ポリフェノール量（TPC）、抗酸化活性（ORAC）、ASME圧力安全率をリアルタイム算出。",
    dielectricLabel: "水の比誘電率 (ε):",
    yieldLabel: "目的生体活性物質抽出回収率:",
    tpcLabel: "総ポリフェノール含量 (TPC):",
    oracLabel: "抗酸化能吸収指標 (ORAC):",
    halfLifeLabel: "アントシアニン熱分解半減期 (t₁/₂):",
    exitTempLabel: "急冷後流体出口温度 (T_exit):",
    energyKwhLabel: "乾燥原料比熱消費エネルギー (E_spec):",
    solventMetricLabel: "有機溶媒残留限度 (VOCs):",
    asmeSafetyLabel: "ASME 圧力容器安全率 (SF):",
    overallStatusLabel: "サニタリー＆品質総合評価:",
    diagramTitle: "連続向流動的SCW抽出＆インラインセラミック精密ろ過フロー",
    diagramSub: "脱酸素高圧水の急速加熱、向流連続植物抽出、高温セラミッククロスフロー清澄化およびグリコール超速急冷プロセスの模式図。",
    scienceTitle: "亜臨界水動的抽出の熱力学＆生物物理学的基礎理論",
    scienceSub: "水の比誘電率低下メカニズム、自己イオン化積（Kw）による自己触媒脱糖反応、アレニウス熱分解速度論および3-A規格適合性を包括的に解説。",
    tableTitle: "商用成套スキッド構成＆植物バイオマス物性リファレンスデータ"
  }
};

const d = DICT[lang] || DICT.en;
---

<div class="not-prose max-w-7xl mx-auto my-8 font-sans">
  <!-- Top Hero Header -->
  <header class="bg-surface-soft border border-hairline rounded-3xl p-6 sm:p-10 mb-8 shadow-xs">
    <div class="flex flex-wrap items-center gap-3 mb-4">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-950 text-emerald-200 border border-emerald-800">
        <svg class="w-3.5 h-3.5 text-emerald-400" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M4 2a2 2 0 00-2 2v11a3 3 0 106 0V4a2 2 0 00-2-2H4zm1 14a1 1 0 100-2 1 1 0 000 2zm5-1.757l4.9-4.9a2 2 0 000-2.828L13.485 5.1a2 2 0 00-2.828 0L10 5.757v8.486zM16 18H9.071l6-6H16a2 2 0 012 2v2a2 2 0 01-2 2z" clip-rule="evenodd" />
        </svg>
        {d.badge}
      </span>
      <span class="text-xs font-mono text-muted">SCW-ASE &bull; 120&ndash;220&deg;C &bull; 30&ndash;80 bar &bull; ASME Sec VIII &bull; 3-A 04-05 &amp; 44-03</span>
    </div>

    <h1 class="text-2xl sm:text-4xl font-extrabold text-ink tracking-tight mb-4">
      {d.title}
    </h1>

    <p class="text-sm sm:text-base text-body leading-relaxed max-w-4xl">
      {d.subtitle}
    </p>
  </header>

  <!-- Interactive Simulator Grid: Left Controls / Right Telemetry -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-8">
    <!-- Left Column: Controls (7 cols) -->
    <section class="lg:col-span-7 bg-surface-soft border border-hairline rounded-3xl p-6 sm:p-8 shadow-xs flex flex-col justify-between">
      <div>
        <div class="border-b border-hairline pb-4 mb-6">
          <h2 class="text-xl font-bold text-ink mb-1">{d.controlsTitle}</h2>
          <p class="text-xs text-muted leading-relaxed">{d.controlsSub}</p>
        </div>

        <!-- Presets Selection Bar -->
        <div class="mb-6 p-4 rounded-2xl bg-surface border border-hairline">
          <label for="scw-preset-select" class="block text-xs font-bold text-ink uppercase tracking-wider mb-2">
            ⚡ {d.presetsTitle}
          </label>
          <select id="scw-preset-select" class="w-full text-xs font-medium rounded-xl border-hairline bg-surface-soft py-2 px-3 text-ink focus:ring-2 focus:ring-emerald-500">
            <option value="grape_pomace" selected>{d.presetGrape}</option>
            <option value="green_tea">{d.presetTea}</option>
            <option value="quercetin_onion">{d.presetQuercetin}</option>
            <option value="citrus_hesperidin">{d.presetCitrus}</option>
            <option value="thermal_hazard">{d.presetHazard}</option>
          </select>
        </div>

        <!-- System Architecture & Pump Selector -->
        <div class="mb-5">
          <label for="scw-system-select" class="block text-xs font-bold text-ink mb-1">
            {d.systemLabel}
          </label>
          <p class="text-[11px] text-muted mb-2">{d.systemHelp}</p>
          <select id="scw-system-select" class="w-full text-xs font-medium rounded-xl border-hairline bg-surface py-2.5 px-3 text-ink focus:ring-2 focus:ring-emerald-500">
            {scwData.systemArchitectures.map(sys => (
              <option value={sys.id}>{sys.name}</option>
            ))}
          </select>
        </div>

        <!-- Botanical Substrate Selector -->
        <div class="mb-5">
          <label for="scw-botanical-select" class="block text-xs font-bold text-ink mb-1">
            {d.botanicalLabel}
          </label>
          <p class="text-[11px] text-muted mb-2">{d.botanicalHelp}</p>
          <select id="scw-botanical-select" class="w-full text-xs font-medium rounded-xl border-hairline bg-surface py-2.5 px-3 text-ink focus:ring-2 focus:ring-emerald-500">
            {scwData.botanicalSubstrates.map(bot => (
              <option value={bot.id}>{bot.name}</option>
            ))}
          </select>
        </div>

        <!-- In-Line Ceramic Membrane Selector -->
        <div class="mb-5">
          <label for="scw-filter-select" class="block text-xs font-bold text-ink mb-1">
            {d.filterLabel}
          </label>
          <p class="text-[11px] text-muted mb-2">{d.filterHelp}</p>
          <select id="scw-filter-select" class="w-full text-xs font-medium rounded-xl border-hairline bg-surface py-2.5 px-3 text-ink focus:ring-2 focus:ring-emerald-500">
            {scwData.filtrationMembranes.map(m => (
              <option value={m.id}>{m.name}</option>
            ))}
          </select>
        </div>

        <!-- In-Line Quench System Selector -->
        <div class="mb-6">
          <label for="scw-quench-select" class="block text-xs font-bold text-ink mb-1">
            {d.quenchLabel}
          </label>
          <p class="text-[11px] text-muted mb-2">{d.quenchHelp}</p>
          <select id="scw-quench-select" class="w-full text-xs font-medium rounded-xl border-hairline bg-surface py-2.5 px-3 text-ink focus:ring-2 focus:ring-emerald-500">
            {scwData.quenchSystems.map(q => (
              <option value={q.id}>{q.name}</option>
            ))}
          </select>
        </div>

        <!-- Sliders Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 pt-4 border-t border-hairline">
          <!-- Slider 1: Extraction Temperature -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label for="scw-temp-range" class="text-xs font-bold text-ink">{d.tempLabel}</label>
              <span id="scw-temp-val" class="font-mono text-xs font-bold text-emerald-600 dark:text-emerald-400">135.0°C</span>
            </div>
            <p class="text-[11px] text-muted mb-2">{d.tempHelp}</p>
            <input id="scw-temp-range" type="range" min="110.0" max="220.0" step="1.0" value="135.0" class="w-full accent-emerald-600" />
            <div class="flex justify-between text-[10px] text-muted font-mono mt-1">
              <span>110.0°C</span>
              <span>165.0°C</span>
              <span>220.0°C</span>
            </div>
          </div>

          <!-- Slider 2: Operating Pressure -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label for="scw-pressure-range" class="text-xs font-bold text-ink">{d.pressureLabel}</label>
              <span id="scw-pressure-val" class="font-mono text-xs font-bold text-emerald-600 dark:text-emerald-400">45.0 bar</span>
            </div>
            <p class="text-[11px] text-muted mb-2">{d.pressureHelp}</p>
            <input id="scw-pressure-range" type="range" min="25.0" max="90.0" step="1.0" value="45.0" class="w-full accent-emerald-600" />
            <div class="flex justify-between text-[10px] text-muted font-mono mt-1">
              <span>25.0 bar</span>
              <span>55.0 bar</span>
              <span>90.0 bar</span>
            </div>
          </div>

          <!-- Slider 3: Flow Rate -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label for="scw-flow-range" class="text-xs font-bold text-ink">{d.flowLabel}</label>
              <span id="scw-flow-val" class="font-mono text-xs font-bold text-emerald-600 dark:text-emerald-400">450 L/h</span>
            </div>
            <p class="text-[11px] text-muted mb-2">{d.flowHelp}</p>
            <input id="scw-flow-range" type="range" min="100" max="1500" step="25" value="450" class="w-full accent-emerald-600" />
            <div class="flex justify-between text-[10px] text-muted font-mono mt-1">
              <span>100 L/h</span>
              <span>800 L/h</span>
              <span>1,500 L/h</span>
            </div>
          </div>

          <!-- Slider 4: Dynamic Residence Time -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label for="scw-residence-range" class="text-xs font-bold text-ink">{d.residenceLabel}</label>
              <span id="scw-residence-val" class="font-mono text-xs font-bold text-emerald-600 dark:text-emerald-400">4.5 min</span>
            </div>
            <p class="text-[11px] text-muted mb-2">{d.residenceHelp}</p>
            <input id="scw-residence-range" type="range" min="1.5" max="15.0" step="0.5" value="4.5" class="w-full accent-emerald-600" />
            <div class="flex justify-between text-[10px] text-muted font-mono mt-1">
              <span>1.5 min</span>
              <span>8.0 min</span>
              <span>15.0 min</span>
            </div>
          </div>

          <!-- Slider 5: Solid to Liquid Ratio -->
          <div class="sm:col-span-2">
            <div class="flex justify-between items-center mb-1">
              <label for="scw-solid-range" class="text-xs font-bold text-ink">{d.solidRatioLabel}</label>
              <span id="scw-solid-val" class="font-mono text-xs font-bold text-emerald-600 dark:text-emerald-400">80 g/L (1:12.5)</span>
            </div>
            <p class="text-[11px] text-muted mb-2">{d.solidRatioHelp}</p>
            <input id="scw-solid-range" type="range" min="30" max="200" step="5" value="80" class="w-full accent-emerald-600" />
            <div class="flex justify-between text-[10px] text-muted font-mono mt-1">
              <span>30 g/L (Dilute 1:33)</span>
              <span>100 g/L (1:10)</span>
              <span>200 g/L (Dense 1:5)</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Right Column: Telemetry & Results (5 cols) -->
    <section class="lg:col-span-5 bg-surface-soft border border-hairline rounded-3xl p-6 sm:p-8 shadow-xs flex flex-col justify-between">
      <div>
        <div class="border-b border-hairline pb-4 mb-6">
          <div class="flex items-center justify-between">
            <h2 class="text-xl font-bold text-ink mb-1">{d.diagnosticTitle}</h2>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">
              Live Modeler
            </span>
          </div>
          <p class="text-xs text-muted leading-relaxed">{d.diagnosticSub}</p>
        </div>

        <div class="space-y-3.5">
          <!-- Primary Metric 1: Dielectric Constant -->
          <div class="bg-surface p-4 rounded-2xl border border-hairline flex items-center justify-between">
            <div>
              <span class="text-xs text-muted block mb-0.5">{d.dielectricLabel}</span>
              <span class="text-[11px] font-mono text-emerald-600 dark:text-emerald-400">Uematsu-Franck Subcritical Equation</span>
            </div>
            <div id="scw-diag-dielectric" class="text-2xl font-bold font-mono text-emerald-600 dark:text-emerald-400">
              45.8
            </div>
          </div>

          <!-- Primary Metric 2: Bioactive Recovery Yield -->
          <div class="bg-surface p-4 rounded-2xl border border-hairline flex items-center justify-between">
            <div>
              <span class="text-xs text-muted block mb-0.5">{d.yieldLabel}</span>
              <span class="text-[11px] font-mono text-muted">Solvent-Free Active Recovery</span>
            </div>
            <div id="scw-diag-yield" class="text-2xl font-bold font-mono text-emerald-600 dark:text-emerald-400">
              88.4%
            </div>
          </div>

          <!-- Secondary Grid -->
          <div class="grid grid-cols-2 gap-3">
            <div class="bg-surface p-3 rounded-xl border border-hairline">
              <span class="text-[11px] text-muted block mb-0.5">{d.tpcLabel}</span>
              <span id="scw-diag-tpc" class="text-base font-bold font-mono text-ink">48.5 mg/g</span>
            </div>

            <div class="bg-surface p-3 rounded-xl border border-hairline">
              <span class="text-[11px] text-muted block mb-0.5">{d.oracLabel}</span>
              <span id="scw-diag-orac" class="text-base font-bold font-mono text-ink">940 µmol/g</span>
            </div>

            <div class="bg-surface p-3 rounded-xl border border-hairline">
              <span class="text-[11px] text-muted block mb-0.5">{d.halfLifeLabel}</span>
              <span id="scw-diag-halflife" class="text-base font-bold font-mono text-ink">18.2 min</span>
            </div>

            <div class="bg-surface p-3 rounded-xl border border-hairline">
              <span class="text-[11px] text-muted block mb-0.5">{d.exitTempLabel}</span>
              <span id="scw-diag-exit-temp" class="text-base font-bold font-mono text-ink">24.2°C</span>
            </div>

            <div class="bg-surface p-3 rounded-xl border border-hairline">
              <span class="text-[11px] text-muted block mb-0.5">{d.energyKwhLabel}</span>
              <span id="scw-diag-energy" class="text-base font-bold font-mono text-ink">0.18 kWh/kg</span>
            </div>

            <div class="bg-surface p-3 rounded-xl border border-hairline">
              <span class="text-[11px] text-muted block mb-0.5">{d.solventMetricLabel}</span>
              <span id="scw-diag-solvent" class="text-base font-bold font-mono text-emerald-600 dark:text-emerald-400">0.00 ppm (100% Green)</span>
            </div>
          </div>

          <!-- ASME Pressure Safety Margin -->
          <div class="bg-surface p-3 rounded-xl border border-hairline flex items-center justify-between">
            <span class="text-xs text-muted">{d.asmeSafetyLabel}</span>
            <span id="scw-diag-safety" class="font-mono text-xs font-bold text-emerald-600 dark:text-emerald-400">
              SF = 2.22x (MAWP 100 bar)
            </span>
          </div>

          <!-- Overall Sanitary & Compliance Badge -->
          <div id="scw-diag-status-container" class="p-4 rounded-2xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-300 dark:border-emerald-800">
            <span class="text-[11px] font-bold uppercase tracking-wider text-emerald-900 dark:text-emerald-200 block mb-1">
              {d.overallStatusLabel}
            </span>
            <div id="scw-diag-status" class="text-sm font-bold text-emerald-700 dark:text-emerald-300 mb-1">
              ✓ ASME Section VIII Div 1 &amp; 3-A Sanitary Standards 04-05 Compliant
            </div>
            <p id="scw-diag-status-sub" class="text-[11px] text-emerald-800 dark:text-emerald-400 leading-relaxed">
              Subcritical water maintained strictly in sub-boiling liquid phase. Zero toxic solvent residues. Instantaneous cryogenic quenching prevents bioactive degradation.
            </p>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- SVG Process Flow Diagram Section -->
  <section class="bg-surface-soft border border-hairline rounded-3xl p-6 sm:p-10 mb-8 shadow-xs">
    <div class="border-b border-hairline pb-4 mb-6">
      <h2 class="text-xl font-bold text-ink mb-1">{d.diagramTitle}</h2>
      <p class="text-xs text-muted leading-relaxed">{d.diagramSub}</p>
    </div>

    <div class="relative w-full overflow-hidden bg-surface rounded-2xl border border-hairline p-4 sm:p-6 flex items-center justify-center">
      <svg viewBox="0 0 960 400" class="w-full h-auto max-w-4xl font-sans" fill="none" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="scwWaterInlet" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#0284c7" />
            <stop offset="100%" stop-color="#0ea5e9" />
          </linearGradient>
          <linearGradient id="scwSuperheated" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#ea580c" />
            <stop offset="100%" stop-color="#dc2626" />
          </linearGradient>
          <linearGradient id="scwQuenchedExtract" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#059669" />
            <stop offset="100%" stop-color="#10b981" />
          </linearGradient>
          <filter id="scwGlow" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur stdDeviation="3" result="blur" />
            <feComposite in="SourceGraphic" in2="blur" operator="over" />
          </filter>
        </defs>

        <!-- Background Grid Lines -->
        <g stroke="currentColor" stroke-opacity="0.05" stroke-width="1">
          <line x1="80" y1="50" x2="80" y2="350" />
          <line x1="240" y1="50" x2="240" y2="350" />
          <line x1="420" y1="50" x2="420" y2="350" />
          <line x1="600" y1="50" x2="600" y2="350" />
          <line x1="780" y1="50" x2="780" y2="350" />
          <line x1="40" y1="120" x2="920" y2="120" />
          <line x1="40" y1="200" x2="920" y2="200" />
          <line x1="40" y1="280" x2="920" y2="280" />
        </g>

        <!-- Stage 1: Deoxygenated Water Feed & High-Pressure Multi-Piston Pump -->
        <g id="svg-pump-stage">
          <rect x="50" y="140" width="110" height="120" rx="14" fill="#0f172a" stroke="#334155" stroke-width="2" />
          <text x="105" y="170" text-anchor="middle" fill="#38bdf8" font-size="11" font-weight="bold">STAGE 1</text>
          <text x="105" y="188" text-anchor="middle" fill="#f8fafc" font-size="10" font-weight="bold">N2 Deoxygenated</text>
          <text x="105" y="202" text-anchor="middle" fill="#94a3b8" font-size="9">DI Feed Water</text>
          <circle cx="105" cy="230" r="14" fill="#1e293b" stroke="#38bdf8" stroke-width="1.5" />
          <path d="M100 230 L110 225 L110 235 Z" fill="#38bdf8" />
          <text x="105" y="275" text-anchor="middle" fill="#64748b" font-size="8" font-family="monospace">P_in = 1.0 bar</text>
        </g>

        <!-- Connecting Pipe 1 -->
