<!-- Interactive Client-Side Simulation Script -->
<script>
  function initScwSimulator() {
    // Input elements
    const presetSelect = document.getElementById('scw-preset-select') as HTMLSelectElement | null;
    const systemSelect = document.getElementById('scw-system-select') as HTMLSelectElement | null;
    const botanicalSelect = document.getElementById('scw-botanical-select') as HTMLSelectElement | null;
    const filterSelect = document.getElementById('scw-filter-select') as HTMLSelectElement | null;
    const quenchSelect = document.getElementById('scw-quench-select') as HTMLSelectElement | null;

    const tempRange = document.getElementById('scw-temp-range') as HTMLInputElement | null;
    const pressureRange = document.getElementById('scw-pressure-range') as HTMLInputElement | null;
    const flowRange = document.getElementById('scw-flow-range') as HTMLInputElement | null;
    const residenceRange = document.getElementById('scw-residence-range') as HTMLInputElement | null;
    const solidRange = document.getElementById('scw-solid-range') as HTMLInputElement | null;

    // Value Badges
    const tempVal = document.getElementById('scw-temp-val');
    const pressureVal = document.getElementById('scw-pressure-val');
    const flowVal = document.getElementById('scw-flow-val');
    const residenceVal = document.getElementById('scw-residence-val');
    const solidVal = document.getElementById('scw-solid-val');

    // Diagnostics Elements
    const diagDielectric = document.getElementById('scw-diag-dielectric');
    const diagYield = document.getElementById('scw-diag-yield');
    const diagTpc = document.getElementById('scw-diag-tpc');
    const diagOrac = document.getElementById('scw-diag-orac');
    const diagHalfLife = document.getElementById('scw-diag-halflife');
    const diagExitTemp = document.getElementById('scw-diag-exit-temp');
    const diagEnergy = document.getElementById('scw-diag-energy');
    const diagSolvent = document.getElementById('scw-diag-solvent');
    const diagSafety = document.getElementById('scw-diag-safety');
    const diagStatus = document.getElementById('scw-diag-status');
    const diagStatusSub = document.getElementById('scw-diag-status-sub');
    const diagStatusContainer = document.getElementById('scw-diag-status-container');

    // SVG Badges
    const svgHeatTemp = document.getElementById('svg-heat-temp');
    const svgHeatPress = document.getElementById('svg-heat-press');
    const svgDielectricBadge = document.getElementById('svg-dielectric-badge');
    const svgResidenceBadge = document.getElementById('svg-residence-badge');
    const svgQuenchTemp = document.getElementById('svg-quench-temp');
    const svgQuenchTime = document.getElementById('svg-quench-time');

    function recalculate() {
      const temp = parseFloat(tempRange?.value || '135.0');
      const pressure = parseFloat(pressureRange?.value || '45.0');
      const flow = parseFloat(flowRange?.value || '450');
      const residence = parseFloat(residenceRange?.value || '4.5');
      const solidRatio = parseFloat(solidRange?.value || '80');
      const botanical = botanicalSelect?.value || 'grape_pomace_wine_byproduct';
      const quench = quenchSelect?.value || 'countercurrent_chilled_glycol_heat_exchanger';
      const filter = filterSelect?.value || 'ceramic_crossflow_microfilter_014um';
      const system = systemSelect?.value || 'commercial_continuous_countercurrent_scw_extractor';

      // Update Slider Display Text
      if (tempVal) tempVal.textContent = `${temp.toFixed(1)}°C`;
      if (pressureVal) pressureVal.textContent = `${pressure.toFixed(1)} bar`;
      if (flowVal) flowVal.textContent = `${flow.toFixed(0)} L/h`;
      if (residenceVal) residenceVal.textContent = `${residence.toFixed(1)} min`;
      const ratioFraction = (1000 / solidRatio).toFixed(1);
      if (solidVal) solidVal.textContent = `${solidRatio.toFixed(0)} g/L (1:${ratioFraction})`;

      // 1. Water Dielectric Constant (Uematsu-Franck empirical formulation)
      // T_kelvin = temp + 273.15
      const Tk = temp + 273.15;
      let dielectric = (5321.0 / Tk) + 233.76 - (0.9297 * Tk) + (0.001417 * Math.pow(Tk, 2)) - (8.292e-7 * Math.pow(Tk, 3));
      dielectric = Math.max(26.0, Math.min(65.0, dielectric));
      if (diagDielectric) diagDielectric.textContent = dielectric.toFixed(1);
      if (svgDielectricBadge) svgDielectricBadge.textContent = `ε = ${dielectric.toFixed(1)}`;
      if (svgHeatTemp) svgHeatTemp.textContent = `T = ${temp.toFixed(1)}°C`;
      if (svgHeatPress) svgHeatPress.textContent = `P = ${pressure.toFixed(1)} bar`;
      if (svgResidenceBadge) svgResidenceBadge.textContent = `t_res = ${residence.toFixed(1)} min`;

      // Check Steam-Flash Saturation Pressure
      // Antoine-like approximation for water saturation pressure: P_sat (bar)
      const pSat_bar = Math.pow(temp / 100.0, 4.0); // Rough approximation: 100°C=1 bar, 150°C=4.7 bar, 180°C=10 bar, 220°C=23 bar
      const isSteamFlashing = pressure < (pSat_bar * 1.15); // Require 15% hydraulic overpressure to guarantee liquid phase

      // 2. Base Substrate Kinetics
      let baseYield = 88.4;
      let baseTpc = 48.5;
      let baseOrac = 940.0;
      let optTemp = 135.0;
      let optRes = 4.5;
      let Ea_degradation = 65.0; // kJ/mol

      if (botanical === 'green_tea_camellia_sinensis_leaf') {
        baseYield = 93.6; baseTpc = 92.0; baseOrac = 1680.0; optTemp = 145.0; optRes = 5.0; Ea_degradation = 72.0;
      } else if (botanical === 'citrus_peel_albedo_flavedo_bagasse') {
        baseYield = 91.2; baseTpc = 36.2; baseOrac = 720.0; optTemp = 160.0; optRes = 6.0; Ea_degradation = 85.0;
      } else if (botanical === 'red_onion_skin_apple_pomace') {
        baseYield = 94.5; baseTpc = 68.4; baseOrac = 1350.0; optTemp = 170.0; optRes = 4.0; Ea_degradation = 78.0;
      } else if (botanical === 'elderberry_blackcurrant_pomace') {
        baseYield = 89.8; baseTpc = 54.0; baseOrac = 1120.0; optTemp = 125.0; optRes = 3.5; Ea_degradation = 58.0;
      } else if (botanical === 'olive_leaf_mill_pomace_alperujo') {
        baseYield = 92.4; baseTpc = 58.0; baseOrac = 1280.0; optTemp = 155.0; optRes = 5.5; Ea_degradation = 80.0;
      }

      // Extraction rate constant k_ext increases with temp
      const tempDiff = temp - optTemp;
      let yieldFactor = 1.0;
      if (tempDiff < 0) {
        // Temperature lower than optimal -> incomplete solubility
        yieldFactor = Math.max(0.60, 1.0 - (Math.abs(tempDiff) * 0.012));
      } else {
        // Temperature higher than optimal -> thermal degradation penalty
        yieldFactor = Math.max(0.50, 1.0 - (tempDiff * 0.015));
      }

      // Residence time factor
      const resDiff = residence - optRes;
      let resFactor = 1.0;
      if (resDiff < 0) {
        resFactor = Math.max(0.65, 1.0 - (Math.abs(resDiff) * 0.08));
      } else {
        resFactor = Math.max(0.70, 1.0 - (resDiff * 0.03));
      }

      // Quench efficiency
      let quenchRetention = 0.965;
      let exitTemp = 24.2;
      let quenchTime = '<2.2 s';

      if (quench === 'sanitary_microchannel_plate_quencher') {
        quenchRetention = 0.982;
        exitTemp = 18.5;
        quenchTime = '<1.2 s';
      } else if (quench === 'unassisted_ambient_expansion_cooling') {
        quenchRetention = 0.684;
        exitTemp = 74.5;
        quenchTime = '18.0 s';
      }

      if (svgQuenchTemp) svgQuenchTemp.textContent = `T_exit = ${exitTemp.toFixed(1)}°C`;
      if (svgQuenchTime) svgQuenchTime.textContent = `Δt = ${quenchTime}`;

      // Calculate final metrics
      let finalYield = baseYield * yieldFactor * resFactor * (quenchRetention / 0.965);
      if (isSteamFlashing) finalYield *= 0.45; // Steam flash destroys liquid mass transfer
      finalYield = Math.max(25.0, Math.min(98.5, finalYield));

      let finalTpc = baseTpc * (finalYield / baseYield);
      let finalOrac = baseOrac * (finalYield / baseYield);

      // Thermal half-life calculation: t1/2 = 25 * exp(-0.038 * (temp - 120))
      const halfLife = Math.max(1.5, 25.0 * Math.exp(-0.042 * (temp - 120.0)));

      // Energy consumption: E_spec = Cp * deltaT / (3600 * solid_loading)
      const deltaT = temp - 20.0;
      const energyKwhPerKg = (4.184 * deltaT * (1000.0 / solidRatio)) / 3600.0;

      // Update Diagnostics
      if (diagYield) diagYield.textContent = `${finalYield.toFixed(1)}%`;
      if (diagTpc) diagTpc.textContent = `${finalTpc.toFixed(1)} mg/g`;
      if (diagOrac) diagOrac.textContent = `${finalOrac.toFixed(0)} µmol/g`;
      if (diagHalfLife) diagHalfLife.textContent = `${halfLife.toFixed(1)} min`;
      if (diagExitTemp) diagExitTemp.textContent = `${exitTemp.toFixed(1)}°C`;
      if (diagEnergy) diagEnergy.textContent = `${energyKwhPerKg.toFixed(2)} kWh/kg`;
      if (diagSolvent) diagSolvent.textContent = '0.00 ppm (100% Green)';

      // ASME Pressure Safety Factor
      let mawp = 100.0;
      if (system === 'industrial_twin_column_reciprocating_packed_bed_ase_skid') mawp = 85.0;
      else if (system === 'high_shear_dynamic_hydrothermal_dispersion_extractor') mawp = 60.0;
      else if (system === 'cleanroom_pilot_modular_fractionator_skid') mawp = 120.0;

      const safetyFactor = mawp / pressure;
      if (diagSafety) {
        diagSafety.textContent = `SF = ${safetyFactor.toFixed(2)}x (MAWP ${mawp} bar)`;
        diagSafety.className = safetyFactor >= 1.50
          ? 'font-mono text-xs font-bold text-emerald-600 dark:text-emerald-400'
          : (safetyFactor >= 1.15 ? 'font-mono text-xs font-bold text-amber-600' : 'font-mono text-xs font-bold text-rose-600');
      }

      // Overall Process Status Evaluation
      if (isSteamFlashing) {
        if (diagStatus) diagStatus.textContent = '🚨 STEAM FLASHING HAZARD: Operating Pressure Insufficient for Temperature';
        if (diagStatusSub) diagStatusSub.textContent = `At ${temp.toFixed(1)}°C, water vapor pressure exceeds ${pressure.toFixed(1)} bar. Liquid is boiling and flashing to vapor inside the column, causing cavitation shock, phase decoupling, and loss of solvating power. Immediately increase backpressure above ${(pSat_bar * 1.2).toFixed(1)} bar!`;
        if (diagStatusContainer) {
          diagStatusContainer.className = 'p-4 rounded-2xl bg-rose-50 dark:bg-rose-950/40 border border-rose-300 dark:border-rose-800';
        }
      } else if (quench === 'unassisted_ambient_expansion_cooling') {
        if (diagStatus) diagStatus.textContent = '⚠️ THERMAL DEGRADATION ALERT: Unassisted Ambient Cooling';
        if (diagStatusSub) diagStatusSub.textContent = 'Without active cryogenic quench, prolonged high-temperature exposure (>70°C) causes severe oxidative degradation (>30% loss of anthocyanins and EGCG). Active chilled glycol quenching is strictly recommended under 3-A guidelines.';
        if (diagStatusContainer) {
          diagStatusContainer.className = 'p-4 rounded-2xl bg-amber-50 dark:bg-amber-950/40 border border-amber-300 dark:border-amber-800';
        }
      } else if (safetyFactor < 1.15) {
        if (diagStatus) diagStatus.textContent = '🚨 ASME PRESSURE EXCEEDED: Operating Pressure Nearing Rupture Limit';
        if (diagStatusSub) diagStatusSub.textContent = `Operating pressure (${pressure.toFixed(1)} bar) violates ASME Section VIII Div 1 safety margins for this skid (MAWP ${mawp} bar). Reduce pump flow or increase pipe diameter.`;
        if (diagStatusContainer) {
          diagStatusContainer.className = 'p-4 rounded-2xl bg-rose-50 dark:bg-rose-950/40 border border-rose-300 dark:border-rose-800';
        }
      } else {
        if (diagStatus) diagStatus.textContent = '✓ ASME Section VIII Div 1 & 3-A Sanitary Standards 04-05 Compliant';
        if (diagStatusSub) diagStatusSub.textContent = 'Subcritical water maintained strictly in sub-boiling liquid phase. Zero toxic solvent residues. Instantaneous cryogenic quenching prevents bioactive degradation.';
        if (diagStatusContainer) {
          diagStatusContainer.className = 'p-4 rounded-2xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-300 dark:border-emerald-800';
        }
      }
    }

    // Attach Event Listeners
    [tempRange, pressureRange, flowRange, residenceRange, solidRange].forEach(input => {
      input?.addEventListener('input', recalculate);
    });

    [systemSelect, botanicalSelect, filterSelect, quenchSelect].forEach(select => {
      select?.addEventListener('change', recalculate);
    });

    // Preset selection logic
    presetSelect?.addEventListener('change', () => {
      const p = presetSelect.value;
      if (p === 'grape_pomace') {
        if (botanicalSelect) botanicalSelect.value = 'grape_pomace_wine_byproduct';
        if (tempRange) tempRange.value = '135.0';
        if (pressureRange) pressureRange.value = '45.0';
        if (flowRange) flowRange.value = '450';
        if (residenceRange) residenceRange.value = '4.5';
        if (solidRange) solidRange.value = '80';
        if (quenchSelect) quenchSelect.value = 'countercurrent_chilled_glycol_heat_exchanger';
      } else if (p === 'green_tea') {
        if (botanicalSelect) botanicalSelect.value = 'green_tea_camellia_sinensis_leaf';
        if (tempRange) tempRange.value = '145.0';
        if (pressureRange) pressureRange.value = '50.0';
        if (flowRange) flowRange.value = '500';
        if (residenceRange) residenceRange.value = '5.0';
        if (solidRange) solidRange.value = '70';
        if (quenchSelect) quenchSelect.value = 'sanitary_microchannel_plate_quencher';
      } else if (p === 'quercetin_onion') {
        if (botanicalSelect) botanicalSelect.value = 'red_onion_skin_apple_pomace';
        if (tempRange) tempRange.value = '170.0';
        if (pressureRange) pressureRange.value = '60.0';
        if (flowRange) flowRange.value = '400';
        if (residenceRange) residenceRange.value = '4.0';
        if (solidRange) solidRange.value = '90';
        if (quenchSelect) quenchSelect.value = 'sanitary_microchannel_plate_quencher';
      } else if (p === 'citrus_hesperidin') {
        if (botanicalSelect) botanicalSelect.value = 'citrus_peel_albedo_flavedo_bagasse';
        if (tempRange) tempRange.value = '160.0';
        if (pressureRange) pressureRange.value = '55.0';
        if (flowRange) flowRange.value = '600';
        if (residenceRange) residenceRange.value = '6.0';
        if (solidRange) solidRange.value = '100';
        if (quenchSelect) quenchSelect.value = 'countercurrent_chilled_glycol_heat_exchanger';
      } else if (p === 'thermal_hazard') {
        if (botanicalSelect) botanicalSelect.value = 'elderberry_blackcurrant_pomace';
        if (tempRange) tempRange.value = '215.0';
        if (pressureRange) pressureRange.value = '26.0'; // Will trigger steam flash!
        if (flowRange) flowRange.value = '1200';
        if (residenceRange) residenceRange.value = '14.0';
        if (solidRange) solidRange.value = '180';
        if (quenchSelect) quenchSelect.value = 'unassisted_ambient_expansion_cooling';
      }
      recalculate();
    });

    // Initial calculation
    recalculate();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initScwSimulator);
  } else {
    initScwSimulator();
  }
</script>
