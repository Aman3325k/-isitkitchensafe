    presetVitamind: "ビタミン D3＆K2 ナノ脂質キャリア（180 bar、42°C、包括率 98.2％、粒径 210 nm、溶媒残留ゼロ）",
    presetOmega: "深海オメガ3＆アスタキサンチン抗酸化シールド（160 bar、36°C、包括率 98.6％、過酸化物生成ゼロ）",
    presetTerpene: "柑橘テルペン＆ポリフェノール微粉末（120 bar、40°C、包括率 95.8％、芳香成分保持率 94.5％）",
    presetHazard: "未加熱ノズルドライアイス閉塞＆トルエン溶媒混入（高圧暴走リスク＆有毒石油系溶剤汚染）",
    diagnosticTitle: "リアルタイム scCO2-SME プロセステレメトリー＆粒子化動力学",
    diagnosticSub: "カプセル包括率、Sauter 平均粒子径、粒度分布指数 (PDI)、生菌生存率、耐胃酸バイパス性をリアルタイム解析。",
    efficiencyLabel: "コア成分マイクロカプセル包括効率 (EE):",
    particleSizeLabel: "Sauter 平均粒子径 (d_32):",
    pdiLabel: "多分散指数 (PDI):",
    survivalLabel: "プロバイオティクス／熱感受性成分生存率:",
    gastricLabel: "胃酸耐性バイパス率（pH 1.8 下生存率）:",
    secLabel: "単位処理質量あたり比消費電力量 (SEC):",
    energySavingLabel: "噴霧乾燥（スプレードライ）に対する省エネ率:",
    solventLabel: "残留有機溶媒量 (USP <467>):",
    statusLabel: "FDA GRAS § 184.1240 / ASME VIII / 3-A 適合性:",
    diagramTitle: "連続式超臨界 CO2 静止型混合器マイクロカプセル成形プロセス系統図",
    diagramSub: "高圧液体CO2ポンプ、コアおよびシェル原料供給ポンプ、高剪断静止型ミキサー、誘導加熱噴霧ノズル、無菌サイクロン。",
    scienceTitle: "高密度超臨界流体マイクロカプセル化＆ RESS/PGSS 熱力学生体物理学",
    scienceSub: "超臨界二酸化炭素相互溶解性、界面張力消失現象、静止型ミキサー内の剪断層流畳み込み、腸溶性コアシェル結晶化の理論。",
    tableTitle: "技術比較マトリックス：scCO2-SME 対 従来型スプレードライ・凍結乾燥・有機溶媒コアセルベーション"
  }
};

const d = DICT[lang] || DICT.en;
const systems = scco2SmeData.systemArchitectures;
const cores = scco2SmeData.coreMatrices;
const shells = scco2SmeData.shellCarriers;
const mixers = scco2SmeData.staticMixerConfigurations;
const nozzles = scco2SmeData.expansionNozzleGeometries;
---

<div class="my-10 p-6 md:p-8 bg-surface border border-hairline rounded-3xl shadow-xs">
  <!-- Header Badge & Title -->
  <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
    <span class="inline-block px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-950 text-emerald-300 border border-emerald-800">
      {d.badge}
    </span>
    <span class="text-xs text-muted font-mono">
      scCO2-SME &bull; 100&ndash;320 bar &bull; 35&ndash;65&deg;C &bull; FDA GRAS &bull; USP &lt;467&gt; &bull; ASME Sec VIII &bull; 3-A 60-01
    </span>
  </div>

  <h2 class="text-title-lg md:text-headline-sm font-medium text-ink tracking-tight mb-3">
    {d.title}
  </h2>
  <p class="text-body text-sm leading-relaxed mb-8 max-w-4xl text-muted">
    {d.subtitle}
  </p>

  <!-- Industrial Presets Row -->
  <div class="mb-8 p-5 bg-surface-soft border border-hairline rounded-2xl">
    <div class="text-xs font-bold uppercase tracking-wider text-ink mb-3 flex items-center gap-2">
      <svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
      </svg>
      {d.presetsTitle}
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2.5">
      <button 
        type="button" 
        id="sme-preset-probiotic"
        class="text-left p-3 rounded-xl bg-surface border border-hairline hover:border-emerald-500 hover:bg-emerald-950/20 transition-all text-xs text-body"
      >
        <span class="font-bold text-emerald-400 block mb-1">🦠 {d.presetProbiotic.split('(')[0]}</span>
        <span class="text-muted text-[11px] block leading-tight">{d.presetProbiotic}</span>
      </button>

      <button 
        type="button" 
        id="sme-preset-vitamind"
        class="text-left p-3 rounded-xl bg-surface border border-hairline hover:border-emerald-500 hover:bg-emerald-950/20 transition-all text-xs text-body"
      >
        <span class="font-bold text-emerald-400 block mb-1">💊 {d.presetVitamind.split('(')[0]}</span>
        <span class="text-muted text-[11px] block leading-tight">{d.presetVitamind}</span>
      </button>

      <button 
        type="button" 
        id="sme-preset-omega"
        class="text-left p-3 rounded-xl bg-surface border border-hairline hover:border-emerald-500 hover:bg-emerald-950/20 transition-all text-xs text-body"
      >
        <span class="font-bold text-emerald-400 block mb-1">🐟 {d.presetOmega.split('(')[0]}</span>
        <span class="text-muted text-[11px] block leading-tight">{d.presetOmega}</span>
      </button>

      <button 
        type="button" 
        id="sme-preset-terpene"
        class="text-left p-3 rounded-xl bg-surface border border-hairline hover:border-emerald-500 hover:bg-emerald-950/20 transition-all text-xs text-body"
      >
        <span class="font-bold text-emerald-400 block mb-1">🍊 {d.presetTerpene.split('(')[0]}</span>
        <span class="text-muted text-[11px] block leading-tight">{d.presetTerpene}</span>
      </button>

      <button 
        type="button" 
        id="sme-preset-hazard"
        class="text-left p-3 rounded-xl bg-rose-950/30 border border-rose-800/80 hover:border-rose-500 hover:bg-rose-950/50 transition-all text-xs text-body sm:col-span-2 lg:col-span-2"
      >
        <span class="font-bold text-rose-400 block mb-1">⚠️ {d.presetHazard.split('(')[0]}</span>
        <span class="text-rose-200/80 text-[11px] block leading-tight">{d.presetHazard}</span>
      </button>
    </div>
  </div>

  <!-- Interactive Controls Section -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-8">
    <div class="lg:col-span-7 space-y-6">
      <div class="border-b border-hairline pb-3">
        <h3 class="text-base font-bold text-ink">
          {d.controlsTitle}
        </h3>
        <p class="text-xs text-muted mt-1">
          {d.controlsSub}
        </p>
      </div>

      <!-- System Selector -->
      <div>
        <label for="sme-system-select" class="block text-xs font-bold text-ink mb-1.5">
          {d.systemLabel}
        </label>
        <select 
          id="sme-system-select" 
          class="w-full text-xs rounded-xl bg-surface-soft border border-hairline p-3 text-ink focus:outline-none focus:border-emerald-500 font-medium"
        >
          {systems.map((s) => (
            <option value={s.id}>{s.name} ({s.minOperatingPressureBar}–{s.maxOperatingPressureBar} bar, {s.co2FlowRateKgPerHour} kg/h CO2)</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1.5 leading-normal">
          {d.systemHelp}
        </p>
      </div>

      <!-- Core Payload Selector -->
      <div>
        <label for="sme-core-select" class="block text-xs font-bold text-ink mb-1.5">
          {d.coreLabel}
        </label>
        <select 
          id="sme-core-select" 
          class="w-full text-xs rounded-xl bg-surface-soft border border-hairline p-3 text-ink focus:outline-none focus:border-emerald-500 font-medium"
        >
          {cores.map((c) => (
            <option value={c.id}>{c.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1.5 leading-normal">
          {d.coreHelp}
        </p>
      </div>

      <!-- Shell Biopolymer Selector -->
      <div>
        <label for="sme-shell-select" class="block text-xs font-bold text-ink mb-1.5">
          {d.shellLabel}
        </label>
        <select 
          id="sme-shell-select" 
          class="w-full text-xs rounded-xl bg-surface-soft border border-hairline p-3 text-ink focus:outline-none focus:border-emerald-500 font-medium"
        >
          {shells.map((sh) => (
            <option value={sh.id}>{sh.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1.5 leading-normal">
          {d.shellHelp}
        </p>
      </div>

      <!-- Static Mixer & Expansion Nozzle Selectors -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="sme-mixer-select" class="block text-xs font-bold text-ink mb-1.5">
            {d.mixerLabel}
          </label>
          <select 
            id="sme-mixer-select" 
            class="w-full text-xs rounded-xl bg-surface-soft border border-hairline p-3 text-ink focus:outline-none focus:border-emerald-500 font-medium"
          >
            {mixers.map((m) => (
              <option value={m.id}>{m.name}</option>
            ))}
          </select>
          <p class="text-[11px] text-muted mt-1.5 leading-normal">
            {d.mixerHelp}
          </p>
        </div>

        <div>
          <label for="sme-nozzle-select" class="block text-xs font-bold text-ink mb-1.5">
            {d.nozzleLabel}
          </label>
          <select 
            id="sme-nozzle-select" 
            class="w-full text-xs rounded-xl bg-surface-soft border border-hairline p-3 text-ink focus:outline-none focus:border-emerald-500 font-medium"
          >
            {nozzles.map((n) => (
              <option value={n.id}>{n.name}</option>
            ))}
          </select>
          <p class="text-[11px] text-muted mt-1.5 leading-normal">
            {d.nozzleHelp}
          </p>
        </div>
      </div>

      <!-- Process Sliders -->
      <div class="space-y-4 pt-2">
        <!-- Mixer Pressure -->
        <div>
          <div class="flex justify-between items-center text-xs font-bold text-ink mb-1.5">
            <label for="sme-pressure-slider">{d.pressureLabel}</label>
            <span id="sme-pressure-val" class="text-emerald-400 font-mono">160.0 bar</span>
          </div>
          <input 
            type="range" 
            id="sme-pressure-slider" 
            min="80.0" 
            max="320.0" 
            step="5.0" 
            value="160.0"
            class="w-full accent-emerald-500 cursor-pointer h-2 bg-surface-soft rounded-lg"
          />
          <p class="text-[11px] text-muted mt-1">
            {d.pressureHelp}
          </p>
        </div>

        <!-- Operating Temp -->
        <div>
          <div class="flex justify-between items-center text-xs font-bold text-ink mb-1.5">
            <label for="sme-temp-slider">{d.tempLabel}</label>
            <span id="sme-temp-val" class="text-emerald-400 font-mono">38.0 &deg;C</span>
          </div>
          <input 
            type="range" 
            id="sme-temp-slider" 
            min="32.0" 
            max="65.0" 
            step="0.5" 
            value="38.0"
            class="w-full accent-emerald-500 cursor-pointer h-2 bg-surface-soft rounded-lg"
          />
          <p class="text-[11px] text-muted mt-1">
            {d.tempHelp}
          </p>
        </div>

        <!-- CO2 Flow Rate -->
        <div>
          <div class="flex justify-between items-center text-xs font-bold text-ink mb-1.5">
            <label for="sme-co2-flow-slider">{d.co2FlowLabel}</label>
            <span id="sme-co2-flow-val" class="text-emerald-400 font-mono">100.0 kg/h</span>
          </div>
          <input 
            type="range" 
            id="sme-co2-flow-slider" 
            min="20.0" 
            max="200.0" 
            step="5.0" 
            value="100.0"
            class="w-full accent-emerald-500 cursor-pointer h-2 bg-surface-soft rounded-lg"
          />
          <p class="text-[11px] text-muted mt-1">
            {d.co2FlowHelp}
          </p>
        </div>

        <!-- Core-to-Shell Ratio -->
        <div>
          <div class="flex justify-between items-center text-xs font-bold text-ink mb-1.5">
            <label for="sme-ratio-slider">{d.coreShellRatioLabel}</label>
            <span id="sme-ratio-val" class="text-emerald-400 font-mono">0.35 : 1</span>
          </div>
          <input 
            type="range" 
            id="sme-ratio-slider" 
            min="0.10" 
            max="1.00" 
            step="0.05" 
            value="0.35"
            class="w-full accent-emerald-500 cursor-pointer h-2 bg-surface-soft rounded-lg"
          />
          <p class="text-[11px] text-muted mt-1">
            {d.coreShellRatioHelp}
          </p>
        </div>

        <!-- Total Throughput -->
        <div>
          <div class="flex justify-between items-center text-xs font-bold text-ink mb-1.5">
            <label for="sme-throughput-slider">{d.throughputLabel}</label>
            <span id="sme-throughput-val" class="text-emerald-400 font-mono">35.0 kg/h</span>
          </div>
          <input 
            type="range" 
            id="sme-throughput-slider" 
            min="5.0" 
            max="100.0" 
            step="1.0" 
            value="35.0"
            class="w-full accent-emerald-500 cursor-pointer h-2 bg-surface-soft rounded-lg"
          />
          <p class="text-[11px] text-muted mt-1">
            {d.throughputHelp}
          </p>
        </div>
      </div>
    </div>

    <!-- Live Telemetry Column -->
    <div class="lg:col-span-5 flex flex-col justify-between space-y-6 bg-surface-soft border border-hairline p-6 rounded-2xl">
      <div>
        <div class="flex items-center justify-between gap-2 mb-4 border-b border-hairline pb-3">
          <div>
            <h3 class="text-base font-bold text-ink">
              {d.diagnosticTitle}
            </h3>
            <p class="text-xs text-muted mt-0.5">
              {d.diagnosticSub}
            </p>
          </div>
          <span id="sme-safety-badge" class="px-3.5 py-1.5 rounded-full text-xs font-bold tracking-wide bg-emerald-950 text-emerald-300 border border-emerald-800">
            OPTIMAL / FULL PARITY
          </span>
        </div>

        <!-- Hazard Warning Banner -->
        <div id="sme-hazard-banner" class="hidden mb-4 p-4 rounded-xl bg-rose-950/80 border border-rose-700 text-rose-200 text-xs space-y-1">
          <div class="font-bold flex items-center gap-1.5 text-rose-300">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            CRITICAL SAFETY FAILURE: PROCESS CONTAMINATION OR NOZZLE FREEZE HAZARD
          </div>
          <p class="text-[11px] leading-relaxed">
            Unheated decompression capillaries trigger violent Joule-Thomson freezing (&lt; -45&deg;C) creating catastrophic dry ice plugs and upstream overpressure surges (&gt;350 bar). Uncertified feeds containing toluene violate FDA food contact safety and USP &lt;467&gt; Class 1 limits.
          </p>
        </div>

        <!-- Telemetry Meters Grid -->
        <div class="grid grid-cols-2 gap-3.5">
          <!-- Encapsulation Efficiency -->
          <div class="p-3.5 rounded-xl bg-surface border border-hairline">
            <div class="text-[11px] text-muted font-medium mb-1">
              {d.efficiencyLabel}
            </div>
            <div id="sme-eff-metric" class="text-lg md:text-xl font-bold font-mono text-emerald-400">
              97.4%
            </div>
            <div class="text-[10px] text-muted mt-1 font-mono">
              Core Active Retention
            </div>
          </div>

          <!-- Sauter Mean Diameter -->
          <div class="p-3.5 rounded-xl bg-surface border border-hairline">
            <div class="text-[11px] text-muted font-medium mb-1">
              {d.particleSizeLabel}
            </div>
            <div id="sme-size-metric" class="text-lg md:text-xl font-bold font-mono text-sky-400">
              285 nm
            </div>
            <div class="text-[10px] text-muted mt-1 font-mono">
              Sub-Micron Monodisperse
            </div>
          </div>

          <!-- Polydispersity Index -->
          <div class="p-3.5 rounded-xl bg-surface border border-hairline">
            <div class="text-[11px] text-muted font-medium mb-1">
              {d.pdiLabel}
            </div>
            <div id="sme-pdi-metric" class="text-lg md:text-xl font-bold font-mono text-emerald-400">
              0.105
            </div>
            <div class="text-[10px] text-muted mt-1 font-mono">
              Ultra-Narrow Distribution
            </div>
          </div>

          <!-- Probiotic Viability -->
