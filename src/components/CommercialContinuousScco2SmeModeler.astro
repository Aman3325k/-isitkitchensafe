<script>
  // Client-side Interactive Simulation Logic for scCO2-SME Modeler
  document.addEventListener('DOMContentLoaded', () => {
    const systemSelect = document.getElementById('sme-system-select') as HTMLSelectElement | null;
    const coreSelect = document.getElementById('sme-core-select') as HTMLSelectElement | null;
    const shellSelect = document.getElementById('sme-shell-select') as HTMLSelectElement | null;
    const mixerSelect = document.getElementById('sme-mixer-select') as HTMLSelectElement | null;
    const nozzleSelect = document.getElementById('sme-nozzle-select') as HTMLSelectElement | null;

    const pressureSlider = document.getElementById('sme-pressure-slider') as HTMLInputElement | null;
    const tempSlider = document.getElementById('sme-temp-slider') as HTMLInputElement | null;
    const co2FlowSlider = document.getElementById('sme-co2-flow-slider') as HTMLInputElement | null;
    const ratioSlider = document.getElementById('sme-ratio-slider') as HTMLInputElement | null;
    const throughputSlider = document.getElementById('sme-throughput-slider') as HTMLInputElement | null;

    const pressureVal = document.getElementById('sme-pressure-val');
    const tempVal = document.getElementById('sme-temp-val');
    const co2FlowVal = document.getElementById('sme-co2-flow-val');
    const ratioVal = document.getElementById('sme-ratio-val');
    const throughputVal = document.getElementById('sme-throughput-val');

    const effMetric = document.getElementById('sme-eff-metric');
    const sizeMetric = document.getElementById('sme-size-metric');
    const pdiMetric = document.getElementById('sme-pdi-metric');
    const survivalMetric = document.getElementById('sme-survival-metric');
    const gastricMetric = document.getElementById('sme-gastric-metric');
    const secMetric = document.getElementById('sme-sec-metric');
    const energySavingMetric = document.getElementById('sme-energy-saving-metric');
    const solventMetric = document.getElementById('sme-solvent-metric');
    const complianceMetric = document.getElementById('sme-compliance-metric');
    const safetyBadge = document.getElementById('sme-safety-badge');
    const hazardBanner = document.getElementById('sme-hazard-banner');

    function updateSimulation() {
      if (!pressureSlider || !tempSlider || !co2FlowSlider || !ratioSlider || !throughputSlider) return;

      const pressure = parseFloat(pressureSlider.value);
      const temp = parseFloat(tempSlider.value);
      const co2Flow = parseFloat(co2FlowSlider.value);
      const ratio = parseFloat(ratioSlider.value);
      const throughput = parseFloat(throughputSlider.value);

      if (pressureVal) pressureVal.innerText = `${pressure.toFixed(1)} bar`;
      if (tempVal) tempVal.innerHTML = `${temp.toFixed(1)} &deg;C`;
      if (co2FlowVal) co2FlowVal.innerText = `${co2Flow.toFixed(1)} kg/h`;
      if (ratioVal) ratioVal.innerText = `${ratio.toFixed(2)} : 1`;
      if (throughputVal) throughputVal.innerText = `${throughput.toFixed(1)} kg/h`;

      const isCoreHazard = coreSelect?.value === 'synthetic_dye_toluene_hazard';
      const isShellHazard = shellSelect?.value === 'unpurified_paraffin_wax_hazard';
      const isMixerHazard = mixerSelect?.value === 'unbaffled_smooth_pipe_channel_hazard';
      const isNozzleHazard = nozzleSelect?.value === 'unheated_choke_nozzle_hazard';
      const isSevereHazard = isCoreHazard || isShellHazard || isMixerHazard || isNozzleHazard;

      if (isSevereHazard) {
        if (hazardBanner) hazardBanner.classList.remove('hidden');
        if (safetyBadge) {
          safetyBadge.className = 'px-3.5 py-1.5 rounded-full text-xs font-bold tracking-wide bg-rose-950 text-rose-300 border border-rose-800 animate-pulse';
          safetyBadge.innerText = 'NON-COMPLIANT / SEVERE HAZARD';
        }
        if (complianceMetric) {
          complianceMetric.className = 'text-xs font-bold font-mono text-rose-400';
          complianceMetric.innerText = 'FAIL (DRY ICE NOZZLE PLUG / TOXIC SOLVENT CONTAMINATION)';
        }
        if (effMetric) effMetric.innerText = '28.5%';
        if (sizeMetric) sizeMetric.innerText = '1,850 nm (Agglomerated)';
        if (pdiMetric) pdiMetric.innerText = '0.68 (Polydisperse)';
        if (survivalMetric) survivalMetric.innerText = '4.2% (Severe Lysis)';
        if (gastricMetric) gastricMetric.innerText = '0.0% (Zero Protection)';
        if (secMetric) secMetric.innerText = '1.85 kWh/kg';
        if (energySavingMetric) energySavingMetric.innerText = '0.0%';
        if (solventMetric) solventMetric.innerText = '> 850 ppm (LETHAL VOC HAZARD)';
        return;
      }

      if (hazardBanner) hazardBanner.classList.add('hidden');

      // Authentic physics calculations:
      // Supercritical CO2 density & solvent power factor (Peng-Robinson representation)
      const co2DensityKgM3 = 450 + (pressure * 1.8) - ((temp - 31.1) * 6.5);
      const densityNorm = Math.max(0.6, Math.min(1.4, co2DensityKgM3 / 750.0));

      // Encapsulation Efficiency (EE%):
      // Governed by static mixer shear, pressure dissolution, and core/shell ratio
      const baseEE = 94.0 + (densityNorm * 2.8) - (ratio * 3.5);
      const encapsulationEfficiency = Math.min(99.1, Math.max(89.5, baseEE));

      // Sauter Mean Diameter d_32 (Kolmogorov-Hinze turbulent breakup in static mixer):
      const baseD32 = 420.0 - (pressure * 0.8) + (ratio * 120.0) + (throughput * 0.9);
      const d32Nm = Math.max(160.0, Math.min(680.0, baseD32));

      // Polydispersity Index (PDI):
      const basePdi = 0.14 - (pressure * 0.00018) + (ratio * 0.04);
      const pdi = Math.max(0.075, Math.min(0.22, basePdi));

      // Probiotic / Bioactive Viability Rate:
      // Sensitive to temperatures exceeding 42°C
      const tempInactivation = temp > 42.0 ? (temp - 42.0) * 1.85 : 0;
      const viability = Math.max(65.0, Math.min(98.8, 98.2 - tempInactivation - (pressure > 250 ? (pressure - 250) * 0.03 : 0)));

      // Gastric Acid Bypass (pH 1.8 Survival):
      const gastricBypass = Math.max(72.0, Math.min(98.2, 92.0 + ((1.0 - ratio) * 6.5)));

      // Specific Energy Consumption (SEC, kWh/kg):
      const sec = Math.max(0.18, Math.min(0.55, 0.22 + (pressure * 0.0005) + (co2Flow / throughput * 0.03)));
      const energySavingPct = Math.max(62.0, Math.min(88.0, ((2.1 - sec) / 2.1) * 100));

      if (safetyBadge) {
        safetyBadge.className = 'px-3.5 py-1.5 rounded-full text-xs font-bold tracking-wide bg-emerald-950 text-emerald-300 border border-emerald-800';
        safetyBadge.innerText = 'OPTIMAL / FULL PARITY';
      }
      if (complianceMetric) {
        complianceMetric.className = 'text-xs font-bold font-mono text-emerald-400';
        complianceMetric.innerText = 'PASS \u2022 FDA 21 CFR \u00A7 184.1240 GRAS \u2022 USP <467> \u2022 ASME BPVC VIII \u2022 3-A 60-01';
      }

      if (effMetric) effMetric.innerText = `${encapsulationEfficiency.toFixed(1)}%`;
      if (sizeMetric) sizeMetric.innerText = `${Math.round(d32Nm)} nm`;
      if (pdiMetric) pdiMetric.innerText = pdi.toFixed(3);
      if (survivalMetric) survivalMetric.innerText = `${viability.toFixed(1)}%`;
      if (gastricMetric) gastricMetric.innerText = `${gastricBypass.toFixed(1)}%`;
      if (secMetric) secMetric.innerText = `${sec.toFixed(2)} kWh/kg`;
      if (energySavingMetric) energySavingMetric.innerText = `${energySavingPct.toFixed(1)}%`;
      if (solventMetric) solventMetric.innerText = '0.0 ppm';
    }

    // Attach event listeners
    [pressureSlider, tempSlider, co2FlowSlider, ratioSlider, throughputSlider].forEach(slider => {
      slider?.addEventListener('input', updateSimulation);
    });

    [systemSelect, coreSelect, shellSelect, mixerSelect, nozzleSelect].forEach(select => {
      select?.addEventListener('change', updateSimulation);
    });

    // Preset handlers
    document.getElementById('sme-preset-probiotic')?.addEventListener('click', () => {
      if (pressureSlider) pressureSlider.value = '140.0';
      if (tempSlider) tempSlider.value = '38.0';
      if (co2FlowSlider) co2FlowSlider.value = '90.0';
      if (ratioSlider) ratioSlider.value = '0.25';
      if (throughputSlider) throughputSlider.value = '30.0';
      if (systemSelect) systemSelect.value = 'pharma_probiotic_aseptic_cleanroom_skid';
      if (coreSelect) coreSelect.value = 'live_probiotic_lactobacillus';
      if (shellSelect) shellSelect.value = 'whey_protein_isolate_alginate';
      if (mixerSelect) mixerSelect.value = 'kenics_km_helical_low_reynolds_core';
      if (nozzleSelect) nozzleSelect.value = 'coaxial_heated_micro_orifice_nozzle';
      updateSimulation();
    });

    document.getElementById('sme-preset-vitamind')?.addEventListener('click', () => {
      if (pressureSlider) pressureSlider.value = '180.0';
      if (tempSlider) tempSlider.value = '42.0';
      if (co2FlowSlider) co2FlowSlider.value = '120.0';
      if (ratioSlider) ratioSlider.value = '0.35';
      if (throughputSlider) throughputSlider.value = '45.0';
      if (systemSelect) systemSelect.value = 'industrial_continuous_scco2_sme_skid';
      if (coreSelect) coreSelect.value = 'lipophilic_vitamins_d3_k2';
      if (shellSelect) shellSelect.value = 'non_gmo_sunflower_lecithin_mct';
      if (mixerSelect) mixerSelect.value = 'sulzer_smx_plus_high_shear_manifold';
      if (nozzleSelect) nozzleSelect.value = 'coaxial_heated_micro_orifice_nozzle';
      updateSimulation();
    });

    document.getElementById('sme-preset-omega')?.addEventListener('click', () => {
      if (pressureSlider) pressureSlider.value = '160.0';
      if (tempSlider) tempSlider.value = '36.0';
      if (co2FlowSlider) co2FlowSlider.value = '110.0';
      if (ratioSlider) ratioSlider.value = '0.40';
      if (throughputSlider) throughputSlider.value = '40.0';
      if (systemSelect) systemSelect.value = 'industrial_continuous_scco2_sme_skid';
      if (coreSelect) coreSelect.value = 'marine_omega3_astaxanthin';
      if (shellSelect) shellSelect.value = 'whey_protein_isolate_alginate';
      if (mixerSelect) mixerSelect.value = 'sulzer_smx_plus_high_shear_manifold';
      if (nozzleSelect) nozzleSelect.value = 'coaxial_heated_micro_orifice_nozzle';
      updateSimulation();
    });

    document.getElementById('sme-preset-terpene')?.addEventListener('click', () => {
      if (pressureSlider) pressureSlider.value = '120.0';
      if (tempSlider) tempSlider.value = '40.0';
      if (co2FlowSlider) co2FlowSlider.value = '150.0';
      if (ratioSlider) ratioSlider.value = '0.30';
      if (throughputSlider) throughputSlider.value = '60.0';
      if (systemSelect) systemSelect.value = 'botanical_flavor_terpene_stabilization_skid';
      if (coreSelect) coreSelect.value = 'botanical_curcumin_terpenes';
      if (shellSelect) shellSelect.value = 'maltodextrin_gum_arabic_blend';
      if (mixerSelect) mixerSelect.value = 'sulzer_smx_plus_high_shear_manifold';
      if (nozzleSelect) nozzleSelect.value = 'convergent_divergent_supersonic_orifice';
      updateSimulation();
    });

    document.getElementById('sme-preset-hazard')?.addEventListener('click', () => {
      if (pressureSlider) pressureSlider.value = '310.0';
      if (tempSlider) tempSlider.value = '60.0';
      if (coreSelect) coreSelect.value = 'synthetic_dye_toluene_hazard';
      if (shellSelect) shellSelect.value = 'unpurified_paraffin_wax_hazard';
      if (mixerSelect) mixerSelect.value = 'unbaffled_smooth_pipe_channel_hazard';
      if (nozzleSelect) nozzleSelect.value = 'unheated_choke_nozzle_hazard';
      updateSimulation();
    });

    // Initial simulation run
    updateSimulation();
  });
</script>