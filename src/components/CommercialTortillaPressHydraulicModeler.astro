const d = DICTIONARY[lang];
---

<div class="my-10 bg-surface rounded-3xl border border-hairline p-6 sm:p-10 shadow-lg">
  <!-- Header -->
  <div class="border-b border-hairline/60 pb-6 mb-8">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-600 text-white mb-3">
      {d.badge}
    </div>
    <h2 class="text-2xl sm:text-3xl font-black text-ink tracking-tight">
      {d.title}
    </h2>
    <p class="text-muted text-sm sm:text-base mt-2 leading-relaxed">
      {d.subtitle}
    </p>
  </div>

  <!-- Presets -->
  <div class="mb-8">
    <div class="text-xs font-bold uppercase tracking-wider text-muted mb-3 flex items-center gap-1.5">
      <svg class="w-4 h-4 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
      {d.presetsTitle}
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5">
      <button type="button" class="preset-btn px-3.5 py-2.5 text-xs font-semibold rounded-xl border border-hairline bg-surface-soft hover:bg-surface-elevated hover:border-amber-500/50 text-ink text-left transition-all" data-preset="compliant">
        {d.presetCompliant}
      </button>
      <button type="button" class="preset-btn px-3.5 py-2.5 text-xs font-semibold rounded-xl border border-hairline bg-surface-soft hover:bg-surface-elevated hover:border-amber-500/50 text-ink text-left transition-all" data-preset="meltdown">
        {d.presetMeltdown}
      </button>
      <button type="button" class="preset-btn px-3.5 py-2.5 text-xs font-semibold rounded-xl border border-hairline bg-surface-soft hover:bg-surface-elevated hover:border-amber-500/50 text-ink text-left transition-all" data-preset="flashfire">
        {d.presetFlashFire}
      </button>
      <button type="button" class="preset-btn px-3.5 py-2.5 text-xs font-semibold rounded-xl border border-hairline bg-surface-soft hover:bg-surface-elevated hover:border-amber-500/50 text-ink text-left transition-all" data-preset="highoutput">
        {d.presetHighOutput}
      </button>
    </div>
  </div>

  <!-- Control Inputs Form -->
  <div class="bg-surface-soft/60 rounded-2xl border border-hairline/80 p-5 sm:p-7 mb-8">
    <h3 class="text-base sm:text-lg font-bold text-ink mb-1">{d.controlsTitle}</h3>
    <p class="text-xs sm:text-sm text-muted mb-6">{d.controlsSub}</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Press Model Select -->
      <div>
        <label for="press-select" class="block text-xs font-bold text-ink mb-1">
          {d.pressLabel}
        </label>
        <select id="press-select" class="w-full text-xs sm:text-sm rounded-xl border border-hairline bg-surface px-3 py-2.5 text-ink focus:outline-none focus:ring-2 focus:ring-amber-500/40">
          {pressData.pressConfigurations.map((p) => (
            <option value={p.id} selected={p.id === 'high_speed_industrial_mega'}>
              {p.name}
            </option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1.5 leading-normal">{d.pressHelp}</p>
      </div>

      <!-- Seal Material Select -->
      <div>
        <label for="seal-select" class="block text-xs font-bold text-ink mb-1">
          {d.sealLabel}
        </label>
        <select id="seal-select" class="w-full text-xs sm:text-sm rounded-xl border border-hairline bg-surface px-3 py-2.5 text-ink focus:outline-none focus:ring-2 focus:ring-amber-500/40">
          {pressData.cylinderSealMaterials.map((s) => (
            <option value={s.id} selected={s.id === 'fkm_viton_fluoroelastomer'}>
              {s.name}
            </option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1.5 leading-normal">{d.sealHelp}</p>
      </div>

      <!-- Fluid Class Select -->
      <div>
        <label for="fluid-select" class="block text-xs font-bold text-ink mb-1">
          {d.fluidLabel}
        </label>
        <select id="fluid-select" class="w-full text-xs sm:text-sm rounded-xl border border-hairline bg-surface px-3 py-2.5 text-ink focus:outline-none focus:ring-2 focus:ring-amber-500/40">
          {pressData.hydraulicFluidClasses.map((f) => (
            <option value={f.id} selected={f.id === 'nsf_h1_synthetic_pao_vg32'}>
              {f.name}
            </option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1.5 leading-normal">{d.fluidHelp}</p>
      </div>

      <!-- Guarding & Baffle Select -->
      <div>
        <label for="enclosure-select" class="block text-xs font-bold text-ink mb-1">
          {d.enclosureLabel}
        </label>
        <select id="enclosure-select" class="w-full text-xs sm:text-sm rounded-xl border border-hairline bg-surface px-3 py-2.5 text-ink focus:outline-none focus:ring-2 focus:ring-amber-500/40">
          {pressData.protectiveEnclosureAndInterlocks.map((e) => (
            <option value={e.id} selected={e.id === 'pl_e_monitored_thermal_shield'}>
              {e.name}
            </option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1.5 leading-normal">{d.enclosureHelp}</p>
      </div>

      <!-- Platen Temp Slider -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <label for="temp-slider" class="text-xs font-bold text-ink">{d.tempSliderLabel}</label>
          <span id="temp-display" class="font-mono text-xs font-bold text-amber-600 bg-amber-500/10 px-2 py-0.5 rounded">230°C / 446°F</span>
        </div>
        <input type="range" id="temp-slider" min="180" max="260" step="5" value="230" class="w-full accent-amber-600 cursor-pointer" />
        <p class="text-[11px] text-muted mt-1">{d.tempSliderHelp}</p>
      </div>

      <!-- Pressure Slider -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <label for="pressure-slider" class="text-xs font-bold text-ink">{d.pressureSliderLabel}</label>
          <span id="pressure-display" class="font-mono text-xs font-bold text-amber-600 bg-amber-500/10 px-2 py-0.5 rounded">2,400 PSI</span>
        </div>
        <input type="range" id="pressure-slider" min="1200" max="3200" step="50" value="2400" class="w-full accent-amber-600 cursor-pointer" />
        <p class="text-[11px] text-muted mt-1">{d.pressureSliderHelp}</p>
      </div>

      <!-- Cycle Rate Slider -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <label for="cycle-slider" class="text-xs font-bold text-ink">{d.cycleSliderLabel}</label>
          <span id="cycle-display" class="font-mono text-xs font-bold text-amber-600 bg-amber-500/10 px-2 py-0.5 rounded">52 strokes/min</span>
        </div>
        <input type="range" id="cycle-slider" min="15" max="65" step="1" value="52" class="w-full accent-amber-600 cursor-pointer" />
        <p class="text-[11px] text-muted mt-1">{d.cycleSliderHelp}</p>
      </div>

      <!-- Reservoir Temp Slider -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <label for="res-temp-slider" class="text-xs font-bold text-ink">{d.resTempSliderLabel}</label>
          <span id="res-temp-display" class="font-mono text-xs font-bold text-amber-600 bg-amber-500/10 px-2 py-0.5 rounded">55°C / 131°F</span>
        </div>
        <input type="range" id="res-temp-slider" min="40" max="110" step="2" value="55" class="w-full accent-amber-600 cursor-pointer" />
        <p class="text-[11px] text-muted mt-1">{d.resTempSliderHelp}</p>
      </div>
    </div>
  </div>

  <!-- Diagnostic Output Panel -->
  <div class="border border-hairline rounded-2xl bg-surface-soft p-5 sm:p-7 mb-8">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 border-b border-hairline/60 pb-4 mb-6">
      <div>
        <h3 class="text-base sm:text-lg font-bold text-ink">{d.diagnosticTitle}</h3>
        <p class="text-xs sm:text-sm text-muted">{d.diagnosticSub}</p>
      </div>
      <div id="compliance-badge" class="px-3.5 py-1.5 rounded-full text-xs font-black uppercase tracking-wider bg-emerald-600 text-white shadow-xs">
        NFPA 79 & ISO 13849-1 CODE COMPLIANT
      </div>
    </div>

    <!-- Diagnostic Readout Grid -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
      <div class="p-4 rounded-xl bg-surface border border-hairline">
        <span class="text-xs text-muted block mb-1">{d.clampingForceLabel}</span>
        <span id="clamping-force-out" class="text-lg sm:text-xl font-mono font-black text-ink">60.3 Tons</span>
        <span id="clamping-kn-out" class="text-[11px] text-muted block font-mono mt-0.5">536.5 kN</span>
      </div>

      <div class="p-4 rounded-xl bg-surface border border-hairline">
        <span class="text-xs text-muted block mb-1">{d.glandTempLabel}</span>
        <span id="gland-temp-out" class="text-lg sm:text-xl font-mono font-black text-ink">88.5°C</span>
        <span id="gland-f-out" class="text-[11px] text-muted block font-mono mt-0.5">191.3°F (Safe Thermal)</span>
      </div>

      <div class="p-4 rounded-xl bg-surface border border-hairline">
        <span class="text-xs text-muted block mb-1">{d.sealHardnessLabel}</span>
        <span id="seal-hardness-out" class="text-lg sm:text-xl font-mono font-black text-ink">81 Shore A</span>
        <span id="compression-set-out" class="text-[11px] text-muted block font-mono mt-0.5">Set: 14% (Resilient)</span>
      </div>

      <div class="p-4 rounded-xl bg-surface border border-hairline">
        <span class="text-xs text-muted block mb-1">{d.sealLifeLabel}</span>
        <span id="seal-life-out" class="text-lg sm:text-xl font-mono font-black text-ink">3,240 Hours</span>
        <span id="seal-strokes-out" class="text-[11px] text-muted block font-mono mt-0.5">~10.1M Cycles</span>
      </div>

      <div class="p-4 rounded-xl bg-surface border border-hairline">
        <span class="text-xs text-muted block mb-1">{d.jetVelocityLabel}</span>
        <span id="jet-velocity-out" class="text-lg sm:text-xl font-mono font-black text-ink">152 m/s</span>
        <span id="jet-mach-out" class="text-[11px] text-muted block font-mono mt-0.5">340 mph Jet Discharge</span>
      </div>

      <div class="p-4 rounded-xl bg-surface border border-hairline">
        <span class="text-xs text-muted block mb-1">{d.dropletSizeLabel}</span>
        <span id="droplet-size-out" class="text-lg sm:text-xl font-mono font-black text-ink">32.4 µm</span>
        <span id="weber-out" class="text-[11px] text-muted block font-mono mt-0.5">We = 840 (Fine Aerosol)</span>
      </div>

      <div class="p-4 rounded-xl bg-surface border border-hairline">
        <span class="text-xs text-muted block mb-1">{d.flashFireRiskLabel}</span>
        <span id="flash-fire-out" class="text-lg sm:text-xl font-mono font-black text-emerald-600">4.2% (Low Risk)</span>
        <span id="flash-margin-out" class="text-[11px] text-muted block font-mono mt-0.5">Flash Margin: +149°C</span>
      </div>

      <div class="p-4 rounded-xl bg-surface border border-hairline">
        <span class="text-xs text-muted block mb-1">{d.complianceLabel}</span>
        <span id="status-summary-out" class="text-sm sm:text-base font-bold text-emerald-600">PASS (Full Protection)</span>
        <span id="iso-pl-out" class="text-[11px] text-muted block font-mono mt-0.5">ISO 13849-1 PL-e Valid</span>
      </div>
    </div>

    <!-- Forensic Analysis Readouts -->
    <div class="space-y-4 text-xs sm:text-sm">
      <div class="p-4 rounded-xl bg-surface border border-hairline">
        <span class="font-bold text-ink block mb-1">{d.primaryRiskLabel}</span>
        <p id="primary-risk-text" class="text-muted leading-relaxed">
          Hydraulic fluid temperatures and rod gland thermal soak are safely attenuated by active water-cooled shielding and high-performance FKM fluoroelastomer polymer seals. Low vapor ignition probability under NFPA 79.
        </p>
      </div>

      <div class="p-4 rounded-xl bg-surface border border-hairline">
        <span class="font-bold text-ink block mb-1">{d.mechanismsLabel}</span>
        <p id="mechanisms-text" class="text-muted leading-relaxed">
          Polymer Arrhenius thermal degradation constant remains below critical threshold. Minimal cyclic hydrocarbon cracking in NSF H1 synthetic PAO fluid. 2,400 PSI line pressure produces high kinetic jet energy upon rupture, but secondary PL-e containment shield prevents aerosol migration toward 230°C heated platen face.
        </p>
      </div>

      <div class="p-4 rounded-xl bg-surface border border-hairline">
        <span class="font-bold text-ink block mb-1">{d.mitigationLabel}</span>
        <p id="mitigation-text" class="text-muted leading-relaxed">
          Maintain scheduled 2,500-hour replacement interval on cylinder rod packings. Conduct quarterly total acid number (TAN) fluid analysis to verify flash point remains above 220°C. Inspect SAE AS1072 fire-protective sleeving along flexible hose runs crossing platen bridge.
        </p>
      </div>
    </div>

    <div class="mt-6 flex flex-col sm:flex-row items-center justify-between gap-3 pt-4 border-t border-hairline/60">
      <button type="button" id="copy-report-btn" class="w-full sm:w-auto px-5 py-2.5 rounded-xl bg-ink hover:bg-ink/90 text-surface font-semibold text-xs transition-colors flex items-center justify-center gap-2 shadow-xs">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" /></svg>
        <span id="copy-btn-text">{d.copyReportBtn}</span>
      </button>
      <span class="text-[11px] text-muted font-mono">ASME B15.1 • NFPA 79 • ISO 13849-1 • ANSI/ASB 101</span>
    </div>
  </div>

  <!-- Technical Matrix Table -->
  <div class="mb-10">
    <h3 class="text-lg font-bold text-ink mb-1">{d.tableTitle}</h3>
    <p class="text-xs text-muted mb-4">{d.tableSub}</p>
    <div class="overflow-x-auto rounded-xl border border-hairline">
      <table class="w-full text-left text-xs">
        <thead class="bg-surface-soft border-b border-hairline text-ink font-bold">
          <tr>
            <th class="py-3 px-3.5">{d.colModel}</th>
            <th class="py-3 px-3.5">{d.colTonnage}</th>
            <th class="py-3 px-3.5">{d.colPressure}</th>
            <th class="py-3 px-3.5">{d.colPlatenTemp}</th>
            <th class="py-3 px-3.5">{d.colSpeed}</th>
            <th class="py-3 px-3.5">{d.colReservoir}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline bg-surface">
          {pressData.pressConfigurations.map((p) => (
            <tr class="hover:bg-surface-soft/40 transition-colors">
              <td class="py-3 px-3.5 font-medium text-ink">{p.name.split(' (')[0]}</td>
              <td class="py-3 px-3.5 font-mono text-muted">{p.clampingForceTons} Tons</td>
              <td class="py-3 px-3.5 font-mono text-muted">{p.hydraulicPressurePsi} PSI</td>
              <td class="py-3 px-3.5 font-mono text-muted">{p.platenTempC}°C</td>
              <td class="py-3 px-3.5 font-mono text-muted">{p.cycleRatePerMin} cpm</td>
              <td class="py-3 px-3.5 font-mono text-muted">{p.reservoirCapacityGal} Gal</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Regulatory & Code Cards -->
  <div class="mb-8">
    <h3 class="text-lg font-bold text-ink mb-1">{d.rulesTitle}</h3>
    <p class="text-xs text-muted mb-4">{d.rulesSub}</p>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="p-5 rounded-2xl bg-surface-soft border border-hairline">
        <div class="flex items-center gap-2 mb-2 text-amber-700 dark:text-amber-400 font-bold text-xs uppercase tracking-wider">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
          {d.rule1Title}
        </div>
        <p class="text-xs text-muted leading-relaxed">{d.rule1Text}</p>
      </div>

      <div class="p-5 rounded-2xl bg-surface-soft border border-hairline">
        <div class="flex items-center gap-2 mb-2 text-blue-700 dark:text-blue-400 font-bold text-xs uppercase tracking-wider">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
          {d.rule2Title}
        </div>
        <p class="text-xs text-muted leading-relaxed">{d.rule2Text}</p>
      </div>

      <div class="p-5 rounded-2xl bg-surface-soft border border-hairline">
        <div class="flex items-center gap-2 mb-2 text-indigo-700 dark:text-indigo-400 font-bold text-xs uppercase tracking-wider">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /></svg>
          {d.rule3Title}
        </div>
        <p class="text-xs text-muted leading-relaxed">{d.rule3Text}</p>
      </div>

      <div class="p-5 rounded-2xl bg-surface-soft border border-hairline">
        <div class="flex items-center gap-2 mb-2 text-emerald-700 dark:text-emerald-400 font-bold text-xs uppercase tracking-wider">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
          {d.rule4Title}
        </div>
        <p class="text-xs text-muted leading-relaxed">{d.rule4Text}</p>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ pressData, lang }}>
  (function () {
    const pressSelect = document.getElementById('press-select');
    const sealSelect = document.getElementById('seal-select');
    const fluidSelect = document.getElementById('fluid-select');
    const enclosureSelect = document.getElementById('enclosure-select');
    const tempSlider = document.getElementById('temp-slider');
    const pressureSlider = document.getElementById('pressure-slider');
    const cycleSlider = document.getElementById('cycle-slider');
    const resTempSlider = document.getElementById('res-temp-slider');

    const tempDisplay = document.getElementById('temp-display');
    const pressureDisplay = document.getElementById('pressure-display');
    const cycleDisplay = document.getElementById('cycle-display');
    const resTempDisplay = document.getElementById('res-temp-display');

    const complianceBadge = document.getElementById('compliance-badge');
    const clampingForceOut = document.getElementById('clamping-force-out');
    const clampingKnOut = document.getElementById('clamping-kn-out');
    const glandTempOut = document.getElementById('gland-temp-out');
    const glandFOut = document.getElementById('gland-f-out');
    const sealHardnessOut = document.getElementById('seal-hardness-out');
    const compressionSetOut = document.getElementById('compression-set-out');
    const sealLifeOut = document.getElementById('seal-life-out');
    const sealStrokesOut = document.getElementById('seal-strokes-out');
    const jetVelocityOut = document.getElementById('jet-velocity-out');
    const jetMachOut = document.getElementById('jet-mach-out');
    const dropletSizeOut = document.getElementById('droplet-size-out');
    const weberOut = document.getElementById('weber-out');
    const flashFireOut = document.getElementById('flash-fire-out');
    const flashMarginOut = document.getElementById('flash-margin-out');
    const statusSummaryOut = document.getElementById('status-summary-out');
    const isoPlOut = document.getElementById('iso-pl-out');

    const primaryRiskText = document.getElementById('primary-risk-text');
    const mechanismsText = document.getElementById('mechanisms-text');
    const mitigationText = document.getElementById('mitigation-text');

    const copyBtn = document.getElementById('copy-report-btn');
    const copyBtnText = document.getElementById('copy-btn-text');

    function calculateDiagnostics() {
      const pressId = pressSelect.value;
      const sealId = sealSelect.value;
      const fluidId = fluidSelect.value;
      const enclosureId = enclosureSelect.value;

      const platenTempC = parseFloat(tempSlider.value);
      const pressurePsi = parseFloat(pressureSlider.value);
      const cycleRate = parseFloat(cycleSlider.value);
      const resTempC = parseFloat(resTempSlider.value);

      tempDisplay.textContent = `${platenTempC}°C / ${Math.round(platenTempC * 1.8 + 32)}°F`;
      pressureDisplay.textContent = `${pressurePsi.toLocaleString()} PSI`;
      cycleDisplay.textContent = `${cycleRate} strokes/min`;
      resTempDisplay.textContent = `${resTempC}°C / ${Math.round(resTempC * 1.8 + 32)}°F`;

      const press = pressData.pressConfigurations.find(p => p.id === pressId) || pressData.pressConfigurations[0];
      const seal = pressData.cylinderSealMaterials.find(s => s.id === sealId) || pressData.cylinderSealMaterials[0];
      const fluid = pressData.hydraulicFluidClasses.find(f => f.id === fluidId) || pressData.hydraulicFluidClasses[0];
      const enclosure = pressData.protectiveEnclosureAndInterlocks.find(e => e.id === enclosureId) || pressData.protectiveEnclosureAndInterlocks[0];

      // 1. Clamping Force Tonnage
      // Cylinder bore area = pi * (bore/2)^2
      const boreIn = press.cylinderBoreIn;
      const boreAreaSqIn = Math.PI * Math.pow(boreIn / 2, 2);
      const totalForceLbs = boreAreaSqIn * pressurePsi;
      const forceTons = totalForceLbs / 2000.0;
      const forceKn = totalForceLbs * 0.00444822;

      clampingForceOut.textContent = `${forceTons.toFixed(1)} Tons`;
      clampingKnOut.textContent = `${forceKn.toFixed(1)} kN Clamping Force`;

      // 2. Gland Thermal Soak
      // Conductive + Radiative transfer from platen
      // Baffle attenuates radiation by coolingBaffleEffectiveness
      const thermalBaffleFactor = 1.0 - (enclosure.coolingBaffleEffectiveness * 0.85);
      const distanceFactor = Math.max(0.35, 1.0 - (press.proximityToPlatenIn / 12.0));
      const platenDelta = platenTempC - resTempC;
      const glandTempC = resTempC + (platenDelta * 0.38 * distanceFactor * thermalBaffleFactor) + (cycleRate * 0.18);
      const glandTempF = glandTempC * 1.8 + 32;

      glandTempOut.textContent = `${glandTempC.toFixed(1)}°C`;
      glandFOut.textContent = `${glandTempF.toFixed(1)}°F (${glandTempC < seal.maxContinuousTempC ? 'Below Seal Limit' : 'EXCEEDS SEAL LIMIT'})`;

      // 3. Seal Hardening & Compression Set
      // Base hardness + thermal excess factor
      const tempExcess = Math.max(0, glandTempC - (seal.maxContinuousTempC * 0.75));
      const hardnessDelta = Math.min(22, (tempExcess * 0.22 * seal.thermalDegradationMultiplier) + (pressurePsi / 1000.0 * 1.5));
      const finalShoreA = Math.min(95, Math.round(seal.baseHardnessShoreA + hardnessDelta));
      const compressionSetPct = Math.min(85, Math.round(12 + (tempExcess * 0.55 * seal.thermalDegradationMultiplier) + (cycleRate * 0.2)));

      sealHardnessOut.textContent = `${finalShoreA} Shore A`;
      compressionSetOut.textContent = `Set: ${compressionSetPct}% (${compressionSetPct > 40 ? 'Severe Embrittlement' : 'Resilient'})`;

      // 4. Seal Lifetime to Failure
      // Exponential Arrhenius degradation
      const thermalAgingRatio = Math.exp(Math.max(0, glandTempC - seal.maxContinuousTempC) / 18.0);
      const pressureWearMultiplier = Math.pow(pressurePsi / 2000.0, 1.4);
      const cycleMultiplier = cycleRate / 40.0;
      const baselineHours = seal.id === 'ffkm_kalrez_perfluoro' ? 8000 : (seal.id === 'fkm_viton_fluoroelastomer' ? 4500 : (seal.id === 'hnbr_high_temp' ? 2400 : 1200));
      const estimatedHours = Math.max(45, Math.round(baselineHours / (thermalAgingRatio * pressureWearMultiplier * (1 + cycleMultiplier * 0.3))));
      const totalStrokesMillions = ((estimatedHours * 60 * cycleRate) / 1000000.0).toFixed(1);

      sealLifeOut.textContent = `${estimatedHours.toLocaleString()} Hours`;
      sealStrokesOut.textContent = `~${totalStrokesMillions}M Press Cycles`;

      // 5. Orifice Jet Velocity upon Rupture
      // v = Cd * sqrt(2 * deltaP / rho)
      // deltaP in Pa = pressurePsi * 6894.76
      // rho for ISO VG 32 = ~860 kg/m3
      const deltaPa = pressurePsi * 6894.76;
      const fluidDensity = 860.0;
      const cd = 0.62;
      const jetVelocityMs = cd * Math.sqrt((2 * deltaPa) / fluidDensity);
      const jetVelocityMph = jetVelocityMs * 2.23694;

      jetVelocityOut.textContent = `${Math.round(jetVelocityMs)} m/s`;
      jetMachOut.textContent = `${Math.round(jetVelocityMph)} mph (${(jetVelocityMs / 343.0).toFixed(2)} Mach Jet)`;

      // 6. Aerosol Droplet Sauter Mean Diameter d32 (µm)
      // Weber number We = rho_air * v^2 * d_orifice / sigma
      // High pressure creates micro-atomization
      const orificeDiameterMm = 0.8;
      const surfaceTension = 0.030; // N/m
      const weberNum = (1.2 * Math.pow(jetVelocityMs, 2) * (orificeDiameterMm / 1000.0)) / surfaceTension;
      const dropletD32Um = Math.max(12, Math.round(2800 / Math.pow(weberNum, 0.42)));

      dropletSizeOut.textContent = `${dropletD32Um} µm`;
      weberOut.textContent = `We = ${Math.round(weberNum)} (${dropletD32Um < 40 ? 'High-Risk Fine Mist' : 'Coarse Droplets'})`;

      // 7. Platen Contact Flash Fire Probability
      // Compares openCupFlashPoint vs platenTemp
      // Finely atomized mist ignites significantly below bulk flash point
      const effectiveMistFlashPoint = fluid.openCupFlashPointC - (45.0 * (1.0 - Math.min(1.0, dropletD32Um / 80.0)));
      const tempMargin = effectiveMistFlashPoint - platenTempC;
      let rawFireRisk = 0;
      if (tempMargin <= 0) {
        rawFireRisk = 92.0 + Math.min(7.5, Math.abs(tempMargin) * 0.2);
      } else if (tempMargin < 40) {
        rawFireRisk = 65.0 - (tempMargin * 1.1);
      } else if (tempMargin < 90) {
        rawFireRisk = 22.0 - ((tempMargin - 40) * 0.35);
      } else {
        rawFireRisk = 4.0;
      }

      // Factor in containment shield
      const shieldedFireRisk = rawFireRisk * (1.0 - (enclosure.containmentEffectiveness * 0.78));
      const finalFireRisk = Math.min(99.5, Math.max(1.5, shieldedFireRisk));

      flashFireOut.textContent = `${finalFireRisk.toFixed(1)}% (${finalFireRisk > 50 ? 'CRITICAL HAZARD' : (finalFireRisk > 20 ? 'Elevated Risk' : 'Low Risk')})`;
      flashMarginOut.textContent = `Mist FP: ${Math.round(effectiveMistFlashPoint)}°C (Margin: ${tempMargin > 0 ? '+' : ''}${Math.round(tempMargin)}°C)`;

      if (finalFireRisk > 50) {
        flashFireOut.className = 'text-lg sm:text-xl font-mono font-black text-rose-600';
      } else if (finalFireRisk > 20) {
        flashFireOut.className = 'text-lg sm:text-xl font-mono font-black text-amber-600';
      } else {
        flashFireOut.className = 'text-lg sm:text-xl font-mono font-black text-emerald-600';
      }

      // 8. Overall Safety Status & ISO Performance Level
      let overallStatus = 'PASS';
      let statusDesc = 'PASS (NFPA/ISO Compliant)';
      let badgeClass = 'px-3.5 py-1.5 rounded-full text-xs font-black uppercase tracking-wider bg-emerald-600 text-white shadow-xs';

      if (glandTempC > seal.maxContinuousTempC || finalFireRisk > 45 || enclosure.containmentEffectiveness < 0.4 || !fluid.foodGradeCertified) {
        overallStatus = 'FAIL';
        statusDesc = 'CRITICAL CODE VIOLATION';
        badgeClass = 'px-3.5 py-1.5 rounded-full text-xs font-black uppercase tracking-wider bg-rose-600 text-white shadow-xs';
      } else if (glandTempC > seal.maxContinuousTempC * 0.85 || finalFireRisk > 18 || estimatedHours < 800) {
        overallStatus = 'WARN';
        statusDesc = 'WARNING (High Thermal Stress)';
        badgeClass = 'px-3.5 py-1.5 rounded-full text-xs font-black uppercase tracking-wider bg-amber-600 text-white shadow-xs';
      }

      complianceBadge.className = badgeClass;
      complianceBadge.textContent = overallStatus === 'PASS' ? 'NFPA 79 & ISO 13849-1 CODE COMPLIANT' : (overallStatus === 'WARN' ? 'OPERATIONAL STRESS WARNING' : 'HAZARDOUS REGULATORY VIOLATION');
      statusSummaryOut.textContent = statusDesc;
      statusSummaryOut.className = overallStatus === 'PASS' ? 'text-sm sm:text-base font-bold text-emerald-600' : (overallStatus === 'WARN' ? 'text-sm sm:text-base font-bold text-amber-600' : 'text-sm sm:text-base font-bold text-rose-600');
      isoPlOut.textContent = enclosure.id === 'pl_e_monitored_thermal_shield' ? 'ISO 13849-1 PL-e Valid' : (enclosure.id === 'standard_mesh_guard_light_curtain' ? 'PL-c Partial Guarding' : 'NON-COMPLIANT (No Interlock)');

      // Narrative Diagnoses
      if (lang === 'es') {
        if (overallStatus === 'FAIL') {
          primaryRiskText.textContent = `Peligro inminente: La temperatura en la empaquetadura del vástago (${glandTempC.toFixed(1)}°C) excede el límite térmico del polímero ${seal.name}. Riesgo de fuga violenta a ${pressurePsi} PSI con formación de aerosol fino (${dropletD32Um} µm) susceptible de deflagración instantánea sobre platos a ${platenTempC}°C.`;
          mechanismsText.textContent = `La tasa de degradación térmica de Arrhenius es crítica. El fluido ${fluid.name} presenta un margen térmico peligroso. La falta de apantallamiento con refrigeración permite que el calor radiante cocine los sellos elastoméricos, induciendo una deformación remanente por compresión de ${compressionSetPct}%.`;
          mitigationText.textContent = `Acción correctiva obligatoria: Instale sellos de fluoroelastómero FKM o FFKM Kalrez. Reemplace mangueras por líneas con funda antifuego SAE AS1072. Instale un bloque hidráulico con certificación ISO 13849-1 PL-e y purgue el aceite degradado por fluido NSF H1.`;
        } else if (overallStatus === 'WARN') {
          primaryRiskText.textContent = `Estrés operativo moderado: Los sellos operan cerca del 85% de su umbral térmico (${glandTempC.toFixed(1)}°C). La vida útil proyectada se reduce a ${estimatedHours} horas. Se observa un endurecimiento a ${finalShoreA} Shore A.`;
          mechanismsText.textContent = `La frecuencia de ciclado de ${cycleRate} golpes/min genera calor friccional acumulativo. El chorro de fuga alcanzaría ${Math.round(jetVelocityMs)} m/s, pero la pantalla protectora proporciona una contención parcial del 65%.`;
          mitigationText.textContent = `Recomendación: Incremente el enfriamiento del depósito hidráulico por debajo de 50°C. Programe inspecciones bimensuales de fugas en racores y verifique el índice de acidez (TAN) del fluido para evitar la formación de barnices.`;
        } else {
          primaryRiskText.textContent = `Sistema completamente estable: Los sellos ${seal.name} operan holgadamente dentro de su rango térmico de diseño (${glandTempC.toFixed(1)}°C frente a ${seal.maxContinuousTempC}°C). Riesgo de fuego repentino controlado al ${finalFireRisk.toFixed(1)}%.`;
          mechanismsText.textContent = `El deflector térmico refrigerado reduce la radiación de los platos en un 75%. El fluido sintético grado alimenticio NSF H1 conserva un margen de seguridad de +${Math.round(tempMargin)}°C por encima del punto de autoignición de nieblas atomizadas.`;
          mitigationText.textContent = `Mantenimiento estándar: Realice el cambio preventivo de empaquetaduras cada ${estimatedHours} horas de operación. Verifique anualmente el tiempo de respuesta de las válvulas anticaída redundantes PL-e.`;
        }
      } else if (lang === 'pt') {
        if (overallStatus === 'FAIL') {
          primaryRiskText.textContent = `Risco crítico: A temperatura no retentor (${glandTempC.toFixed(1)}°C) ultrapassa o limite térmico do polímero ${seal.name}. Ruptura em alta pressão (${pressurePsi} PSI) formará névoa fina (${dropletD32Um} µm) com risco de deflagração espontânea contra placas a ${platenTempC}°C.`;
          mechanismsText.textContent = `Aceleração severa de degradação térmica por Arrhenius. O fluido ${fluid.name} possui margem de ignição negativa ou nula. Sem blindagem defletora, a radiação direta provoca endurecimento acelerado (${finalShoreA} Shore A) e perda catastrófica de estanqueidade.`;
          mitigationText.textContent = `Intervenção imediata: Substitua as vedações por polímero FKM/FFKM. Instale mantas corta-fogo SAE AS1072 nas mangueiras flexíveis e implemente bloco de segurança hidráulica ISO 13849-1 PL-e.`;
        } else if (overallStatus === 'WARN') {
          primaryRiskText.textContent = `Atenção operacional: Vedações operando a 85% do limite térmico (${glandTempC.toFixed(1)}°C). Vida útil estimada em ${estimatedHours} horas com taxa de deformação de ${compressionSetPct}%.`;
          mechanismsText.textContent = `A pulsação mecânica de ${cycleRate} ciclos/min eleva a temperatura de atrito. A velocidade de escape de um jato rompido seria de ${Math.round(jetVelocityMs)} m/s, contida parcialmente pela proteção mecânica.`;
          mitigationText.textContent = `Diretrizes: Monitore o tanque hidráulico para mantê-lo abaixo de 50°C e efetue análises periódicas de acidez total (TAN) do óleo sintético.`;
        } else {
          primaryRiskText.textContent = `Condição de excelência operacional: Temperatura nos retentores controlada em ${glandTempC.toFixed(1)}°C, amplamente compatível com o material ${seal.name}. Risco de incêndio flash mínimo (${finalFireRisk.toFixed(1)}%).`;
          mechanismsText.textContent = `A blindagem refrigerada dissipa 75% da radiação térmica das placas a ${platenTempC}°C. O óleo sintético NSF H1 preserva estabilidade química e alta resistência dielétrica.`;
          mitigationText.textContent = `Protocolo preventivo: Troca de gaxetas programada a cada ${estimatedHours} horas. Teste funcional semestral das válvulas redundantes monitoradas de retenção.`;
        }
      } else if (lang === 'zh-cn') {
        if (overallStatus === 'FAIL') {
          primaryRiskText.textContent = `重大安全隐患报警：油缸密封圈受热温度（${glandTempC.toFixed(1)}°C）超出该材质（${seal.name}）的安全极限温度。在${pressurePsi} PSI超高压下若发生破裂，将形成微米级极细油雾（${dropletD32Um} µm），接触${platenTempC}°C热压盘将引发剧烈闪燃自燃爆燃！`;
          mechanismsText.textContent = `橡胶阿伦尼乌斯老化常数急剧飙升，密封圈永久压缩变形率高达${compressionSetPct}%。所选介质${fluid.name}在高温下闪点严重退化，无水冷隔热防护使得热辐射直接轰击油缸，导致高压软管与轴封急速脆化。`;
          mitigationText.textContent = `必须立即整改：全线换装原厂高纯度FKM氟橡胶或FFKM全氟醚密封圈；高压胶管加装SAE AS1072航空级耐火护套；升级ISO 13849-1 PL-e双通道安全液压防坠阀组；彻底置换抗裂解食品级NSF H1全合成液压油。`;
        } else if (overallStatus === 'WARN') {
          primaryRiskText.textContent = `运行热应力预警：密封圈受热温度已逼近耐温上限的85%（${glandTempC.toFixed(1)}°C）。预期安全使用寿命缩短至${estimatedHours}小时，硬度升至${finalShoreA} Shore A。`;
          mechanismsText.textContent = `每分钟${cycleRate}次的高速冲程显著加剧了杆面往复滑动摩擦生热。若管路出现针孔喷射速度将达${Math.round(jetVelocityMs)} m/s，现有防护罩仅能提供中等物理阻隔。`;
          mitigationText.textContent = `预防维护指令：加强液压泵站强制风冷或板式水冷，将主油箱油温压制在50°C以下；每月检测液压油总酸值（TAN）以防漆膜堵塞精密伺服比例阀。`;
        } else {
          primaryRiskText.textContent = `系统工况优良合规：液压轴封温度处于安全区间（${glandTempC.toFixed(1)}°C，远低于材质极限${seal.maxContinuousTempC}°C）。油雾热压盘闪燃风险受控在${finalFireRisk.toFixed(1)}%极低水平。`;
          mechanismsText.textContent = `水冷热防护隔板有效拦截了来自${platenTempC}°C热压盘75%的辐射热量。NSF H1食品级合成油在微米雾化状态下仍保持+${Math.round(tempMargin)}°C的自燃安全裕度。`;
          mitigationText.textContent = `标准维护计划：每运行${estimatedHours}小时（约${totalStrokesMillions}百万冲程）进行预防性密封组件翻新；每年由专业安全工程师验证PL-e双联液压电磁阀的动态自检响应。`;
        }
      } else if (lang === 'ja') {
        if (overallStatus === 'FAIL') {
          primaryRiskText.textContent = `重大安全規格違反アラート：油圧シリンダーパッキン受熱温度（${glandTempC.toFixed(1)}°C）が材質（${seal.name}）の耐熱上限を超過。${pressurePsi} PSIの高圧下で破裂した場合、微小油霧（${dropletD32Um} µm）が発生し、${platenTempC}°Cの熱盤に接触して即座にフラッシュ火災爆燃を誘発します。`;
          mechanismsText.textContent = `高分子熱劣化（アレニウス式）が急進し、ゴム永久圧縮歪み率は${compressionSetPct}%に達します。使用油（${fluid.name}）は熱盤に対して十分な引火安全マージンがなく、遮熱板の欠如が配管とシールの熱破壊を決定付けます。`;
          mitigationText.textContent = `緊急是正指示：FKMフッ素ゴムまたはFFKMパーフロパッキンへの全面交換；高圧ホースへのSAE AS1072防火スリーブ装着；ISO 13849-1 PL-e適合安全油圧ブロックの導入；NSF H1全合成食品用作動油への更新。`;
        } else if (overallStatus === 'WARN') {
          primaryRiskText.textContent = `運転熱負荷警告：パッキン受熱温度が耐熱限界の85%（${glandTempC.toFixed(1)}°C）に接近中。推定寿命は${estimatedHours}時間に低下し、シール硬度は${finalShoreA} Shore Aへ硬化しています。`;
          mechanismsText.textContent = `毎分${cycleRate}回の高速プレスによる摩擦熱が重畳。配管ピンホール破断時の噴出速度は${Math.round(jetVelocityMs)} m/sに達し、現行カバーの防護は部分的なものに留まります。`;
          mitigationText.textContent = `予防保全指針：油圧タンク冷却器の能力を増強して油温を50°C以下に維持し、全酸価（TAN）を定期計測してスラッジによるバルブ固着を防いでください。`;
        } else {
          primaryRiskText.textContent = `完全規格適合・安全運転状態：パッキン部受熱温度は${glandTempC.toFixed(1)}°Cに保たれ、材質耐熱${seal.maxContinuousTempC}°Cに対して十分な裕度を確保。油霧発火危険度は${finalFireRisk.toFixed(1)}%と極めて安全です。`;
          mechanismsText.textContent = `水冷遮熱バッフルが${platenTempC}°Cの熱盤放射熱を75%遮断。NSF H1食品用全合成油は噴霧化状態でも+${Math.round(tempMargin)}°Cの発火温度マージンを維持しています。`;
          mitigationText.textContent = `定期保全計画：稼働${estimatedHours}時間（約${totalStrokesMillions}百万回成形）ごとの定期パッキン更新；PL-e二重化安全油圧バルブの年次動作レスポンス検証。`;
        }
      } else {
        // English
        if (overallStatus === 'FAIL') {
          primaryRiskText.textContent = `Critical Safety Violation: Cylinder rod packing thermal soak (${glandTempC.toFixed(1)}°C) exceeds the continuous thermal ceiling of ${seal.name}. A 2,400+ PSI pressure surge risks catastrophic gland rupture, expelling a high-velocity atomized aerosol (${dropletD32Um} µm Sauter mean) directly toward 230°C+ platen heating elements, with extreme flash fire deflagration probability (${finalFireRisk.toFixed(1)}%).`;
          mechanismsText.textContent = `Arrhenius thermal degradation is severe, accelerating seal hardening to ${finalShoreA} Shore A with an excessive compression set of ${compressionSetPct}%. The fluid (${fluid.name}) possesses a compromised or negative flash margin against platen operating temperatures. Unshielded radiation elevates high-pressure flex hose outer sheath temperatures beyond safe tensile fatigue limits.`;
          mitigationText.textContent = `Mandatory Engineering Corrective Actions: Immediately upgrade cylinder seals to OEM FKM Viton or FFKM Kalrez. Retrofit all high-pressure hydraulic flex lines crossing the platen zone with certified SAE AS1072 fire-protective silicone-fiberglass sleeving. Install an ISO 13849-1 PL-e dual monitored hydraulic anti-drop safety block, and replace degraded fluid with certified NSF H1 synthetic ester or PAO fluid.`;
        } else if (overallStatus === 'WARN') {
          primaryRiskText.textContent = `Operational Warning: Cylinder packings are operating near 85% of rated thermal capacity (${glandTempC.toFixed(1)}°C). Expected seal service life is reduced to ${estimatedHours} hours with accelerated polymer hardening to ${finalShoreA} Shore A.`;
          mechanismsText.textContent = `Sliding rod friction from a high cycle rate of ${cycleRate} strokes/min compounds conductive platen thermal transfer. A line rupture would produce a jet velocity of ${Math.round(jetVelocityMs)} m/s, but partial perforated metal guarding provides only moderate droplet containment.`;
          mitigationText.textContent = `Preventive Measures: Increase hydraulic power unit oil cooler fan airflow to maintain reservoir bulk temperature below 50°C. Implement bi-monthly total acid number (TAN) fluid analysis to detect early thermal hydrocarbon cracking.`;
        } else {
          primaryRiskText.textContent = `Fully Code Compliant: Cylinder rod packings operate safely at ${glandTempC.toFixed(1)}°C, well below the ${seal.maxContinuousTempC}°C thermal ceiling of ${seal.name}. Low atomized spray flash fire probability (${finalFireRisk.toFixed(1)}%).`;
          mechanismsText.textContent = `Water-cooled stainless radiation baffling attenuates platen heat flux by 75%. Certified NSF H1 synthetic fluid maintains a robust positive flash margin (+${Math.round(tempMargin)}°C) above atomized aerosol ignition thresholds. Fully redundant PL-e cartridge valves prevent uncommanded platen gravitational descent.`;
          mitigationText.textContent = `Scheduled Protocol: Perform preventive cylinder seal overhaul every ${estimatedHours} operating hours (~${totalStrokesMillions}M cycles). Conduct annual proof-testing of redundant ISO 13849-1 PL-e monitored safety interlocks.`;
        }
      }
    }

    // Preset handlers
    const presetButtons = document.querySelectorAll('.preset-btn');
    presetButtons.forEach(btn => {
      btn.addEventListener('click', function () {
        const p = this.getAttribute('data-preset');
        if (p === 'compliant') {
          pressSelect.value = 'high_speed_industrial_mega';
          sealSelect.value = 'fkm_viton_fluoroelastomer';
          fluidSelect.value = 'nsf_h1_synthetic_pao_vg32';
          enclosureSelect.value = 'pl_e_monitored_thermal_shield';
          tempSlider.value = 215;
          pressureSlider.value = 2200;
          cycleSlider.value = 45;
          resTempSlider.value = 50;
        } else if (p === 'meltdown') {
          pressSelect.value = 'high_speed_industrial_mega';
          sealSelect.value = 'standard_nbr_nitrile';
          fluidSelect.value = 'conventional_mineral_aw32';
          enclosureSelect.value = 'standard_mesh_guard_light_curtain';
          tempSlider.value = 245;
          pressureSlider.value = 2600;
          cycleSlider.value = 58;
          resTempSlider.value = 85;
        } else if (p === 'flashfire') {
          pressSelect.value = 'legacy_unshielded_hydraulic';
          sealSelect.value = 'standard_nbr_nitrile';
          fluidSelect.value = 'thermally_degraded_cracked_oil';
          enclosureSelect.value = 'unshielded_bare_cylinder_run';
          tempSlider.value = 250;
          pressureSlider.value = 2800;
          cycleSlider.value = 50;
          resTempSlider.value = 95;
        } else if (p === 'highoutput') {
          pressSelect.value = 'high_tonnage_double_platen';
          sealSelect.value = 'ffkm_kalrez_perfluoro';
          fluidSelect.value = 'nsf_h1_synthetic_ester_vg46';
          enclosureSelect.value = 'pl_e_monitored_thermal_shield';
          tempSlider.value = 235;
          pressureSlider.value = 2800;
          cycleSlider.value = 55;
          resTempSlider.value = 55;
        }
        calculateDiagnostics();
      });
    });

    [pressSelect, sealSelect, fluidSelect, enclosureSelect].forEach(el => {
      el.addEventListener('change', calculateDiagnostics);
    });

    [tempSlider, pressureSlider, cycleSlider, resTempSlider].forEach(el => {
      el.addEventListener('input', calculateDiagnostics);
    });

    // Copy Forensic Report
    copyBtn.addEventListener('click', function () {
      const report = `======================================================================
ISITKITCHENSAFE FORENSIC DIAGNOSTIC REPORT:
Commercial Continuous Tortilla Press Heated Platen Hydraulic Rupture & Thermal Oil Degradation Modeler
