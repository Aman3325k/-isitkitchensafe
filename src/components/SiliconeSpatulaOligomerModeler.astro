</div>

<script is:inline define:vars={{ modelData }}>
  (function() {
    const gradesMap = {};
    modelData.siliconeGrades.forEach(g => { gradesMap[g.id] = g; });
    const foodsMap = {};
    modelData.foodMatrices.forEach(f => { foodsMap[f.id] = f; });
    const durationsMap = {};
    modelData.contactDurations.forEach(d => { durationsMap[d.id] = d; });

    const gradeSelect = document.getElementById('silicone-grade-select');
    const foodSelect = document.getElementById('food-matrix-select');
    const tempSlider = document.getElementById('pan-temp-slider');
    const tempDisplay = document.getElementById('pan-temp-display');
    const dwellSelect = document.getElementById('dwell-duration-select');
    const presetBtns = document.querySelectorAll('.preset-btn');

    const siloxaneVal = document.getElementById('siloxane-migration-value');
    const progressBar = document.getElementById('migration-progress-bar');
    const complianceBadge = document.getElementById('compliance-badge');
    const vomVal = document.getElementById('vom-loss-value');
    const vomLimitText = document.getElementById('vom-limit-status');
    const depolyVal = document.getElementById('depoly-index-value');
    const depolyStatusText = document.getElementById('depoly-status-text');
    const pinchOutput = document.getElementById('pinch-test-output');
    const endocrineOutput = document.getElementById('endocrine-hazard-output');
    const actionContainer = document.getElementById('action-protocol-container');
    const actionText = document.getElementById('action-protocol-text');
    const copyBtn = document.getElementById('copy-report-btn');
    const copyFeedback = document.getElementById('copy-feedback');

    function calculate() {
      const grade = gradesMap[gradeSelect.value] || modelData.siliconeGrades[1];
      const food = foodsMap[foodSelect.value] || modelData.foodMatrices[0];
      const tempC = parseInt(tempSlider.value, 10);
      const dwell = durationsMap[dwellSelect.value] || modelData.contactDurations[1];

      tempDisplay.textContent = `${tempC}°C (${Math.round(tempC * 9/5 + 32)}°F)`;

      // 1. Temperature Acceleration Factor (Arrhenius-style)
      // T_ref = 180°C. Above 180°C, thermal degradation of siloxane increases exponentially.
      const deltaT = Math.max(0, tempC - 160);
      const thermalFactor = Math.pow(1.035, deltaT);

      // 2. Migration Calculation in mg/kg food simulant
      // Baseline migration scale calibrated to BfR / Zhang et al. experimental findings
      const baseMigration = 12.0 * grade.migrationFactor;
      const lipidMultiplier = food.lipophilicExtractionFactor;
      const dwellMultiplier = dwell.diffusionMultiplier;

      // Actual migration M (mg/kg)
      let migration = baseMigration * lipidMultiplier * dwellMultiplier * thermalFactor;
      migration = Math.max(0.2, migration);

      // 3. Volatile Organic Matter (VOM) Loss (%)
      let vomLoss = (grade.cyclicOligomerContentPercent * 0.4) * (tempC / 200) * (dwell.seconds / 300);
      vomLoss = Math.min(6.5, Math.max(0.05, vomLoss));

      // 4. Depolymerization Index (0 - 100)
      let depolyIndex = 0;
      if (tempC >= grade.depolymerizationThresholdC) {
        depolyIndex = Math.min(100, Math.round(((tempC - grade.depolymerizationThresholdC) / 60) * 80 + (dwell.seconds / 60) * 5));
      } else {
        depolyIndex = Math.min(30, Math.round((tempC / grade.depolymerizationThresholdC) * 20));
      }

      // Format outputs
      siloxaneVal.textContent = `${migration.toFixed(1)} mg/kg`;
      vomVal.textContent = `${vomLoss.toFixed(2)}%`;
      depolyVal.textContent = `${depolyIndex} / 100`;

      // Progress bar percentage (60 mg/kg is 50% of bar width, max 120 mg/kg)
      const barWidth = Math.min(100, (migration / 120) * 100);
      progressBar.style.width = `${barWidth}%`;

      // EU 10/2011 Limit is 60 mg/kg
      const EU_LIMIT = 60.0;
      const BFR_VOM_LIMIT = 0.50;

      if (migration < 10.0) {
        progressBar.className = 'h-full bg-emerald-500 transition-all duration-300';
        complianceBadge.className = 'px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-500/10 text-emerald-800 border-emerald-500/30';
        complianceBadge.textContent = '100% EU COMPLIANT';
        endocrineOutput.textContent = 'Negligible (Trace D4-D6)';
        endocrineOutput.className = 'text-xs font-bold text-emerald-800';
        actionContainer.className = 'p-4 rounded-xl border border-emerald-500/30 bg-emerald-500/5';
        actionText.textContent = 'Safe for routine cooking. Silicone elastomer remains far below thermal depolymerization thresholds with minimal cyclic siloxane extraction into food.';
      } else if (migration <= EU_LIMIT) {
        progressBar.className = 'h-full bg-amber-500 transition-all duration-300';
        complianceBadge.className = 'px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-500/10 text-amber-950 border-amber-500/30';
        complianceBadge.textContent = 'MARGINAL COMPLIANCE';
        endocrineOutput.textContent = 'Low-to-Moderate (Within SML)';
        endocrineOutput.className = 'text-xs font-bold text-amber-950';
        actionContainer.className = 'p-4 rounded-xl border border-amber-500/30 bg-amber-500/5';
        actionText.textContent = 'Acceptable for brief stirring, but avoid leaving utensil resting against pan floor or searing oil. Lift utensil out onto a spoon rest between stirs.';
      } else {
        progressBar.className = 'h-full bg-red-600 transition-all duration-300';
        complianceBadge.className = 'px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-red-500/10 text-red-600 border-red-500/30';
        complianceBadge.textContent = 'EU LIMIT EXCEEDED (ILLEGAL)';
        endocrineOutput.textContent = 'Elevated Endocrine SVHC Risk';
        endocrineOutput.className = 'text-xs font-bold text-red-600';
        actionContainer.className = 'p-4 rounded-xl border border-red-500/30 bg-red-500/5';
        actionText.textContent = 'CRITICAL WARNING: Utensil exceeds the EU 10/2011 60 mg/kg overall migration ceiling. Thermal depolymerization is actively dumping cyclic siloxanes into hot cooking fat. Replace with 100% platinum-cured LSR, hardwood, or 304 stainless steel.';
      }

      // VOM status
      if (vomLoss <= BFR_VOM_LIMIT) {
        vomLimitText.textContent = `BfR Compliant (< 0.5%)`;
        vomLimitText.className = 'text-[10px] text-emerald-800 font-semibold mt-1';
      } else {
        vomLimitText.textContent = `BfR XV Limit Exceeded (> 0.5%)`;
        vomLimitText.className = 'text-[10px] text-red-600 font-semibold mt-1';
      }

      // Depolymerization status
      if (depolyIndex < 25) {
        depolyStatusText.textContent = 'Matrix Structurally Stable';
        depolyStatusText.className = 'text-[10px] text-emerald-800 mt-1';
      } else if (depolyIndex < 60) {
        depolyStatusText.textContent = 'Superficial Siloxane Cleavage';
        depolyStatusText.className = 'text-[10px] text-amber-950 mt-1';
      } else {
        depolyStatusText.textContent = 'Severe Thermal Chain Scission';
        depolyStatusText.className = 'text-[10px] text-red-600 font-semibold mt-1';
      }

      // Pinch test status
      pinchOutput.textContent = grade.pinchTestResult;
    }

    // Event listeners
    gradeSelect.addEventListener('change', calculate);
    foodSelect.addEventListener('change', calculate);
    tempSlider.addEventListener('input', calculate);
    dwellSelect.addEventListener('change', calculate);

    presetBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        gradeSelect.value = btn.dataset.grade;
        foodSelect.value = btn.dataset.food;
        tempSlider.value = btn.dataset.temp;
        dwellSelect.value = btn.dataset.dwell;
        calculate();
      });
    });

    // Copy Forensic Report
    copyBtn.addEventListener('click', () => {
      const grade = gradesMap[gradeSelect.value] || modelData.siliconeGrades[0];
      const food = foodsMap[foodSelect.value] || modelData.foodMatrices[0];
      const tempC = tempSlider.value;
      const dwell = durationsMap[dwellSelect.value] || modelData.contactDurations[0];

      const report = `=== ISITKITCHENSAFE FORENSIC POLYMER MIGRATION REPORT ===
Timestamp: ${new Date().toISOString()}
Tool: Silicone Spatula & Utensil High-Heat Oligomer Leaching Modeler

[INPUT PARAMETERS]
• Silicone Formulation: ${grade.name}
• Curing System: ${grade.curingSystem}
• Food Matrix: ${food.name} (${food.polarity})
• Pan Contact Temp: ${tempC}°C (${Math.round(tempC * 9/5 + 32)}°F)
• Dwell Mode: ${dwell.name}

[DIAGNOSTIC FINDINGS]
• Cyclic Siloxane (D4-D6) Migration: ${siloxaneVal.textContent}
• EU 10/2011 Overall Migration Status: ${complianceBadge.textContent}
• Volatile Organic Matter Loss: ${vomVal.textContent} (${vomLimitText.textContent})
• Depolymerization Index: ${depolyVal.textContent} (${depolyStatusText.textContent})
• Material Pinch Integrity: ${pinchOutput.textContent}
• Endocrine & Bioaccumulation Rating: ${endocrineOutput.textContent}

[MANDATORY SAFETY PROTOCOL]
${actionText.textContent}

Standard Grounding: EU 10/2011, German BfR Recommendation XV, ECHA SVHC Candidate Dossier.
IsItKitchenSafe Diagnostic Reference: https://isitkitchensafe.com/tools/silicone-spatula-oligomer-leaching-modeler/`;

      navigator.clipboard.writeText(report).then(() => {
        copyFeedback.classList.remove('hidden');
        setTimeout(() => copyFeedback.classList.add('hidden'), 3500);
      });
    });

    // Initial calculation on load
    calculate();
  })();
</script>
