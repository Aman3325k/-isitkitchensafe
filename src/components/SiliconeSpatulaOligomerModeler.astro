    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <h4 class="text-xs font-bold text-ink mb-1 flex items-center gap-1.5">
          <span class="text-red-500">1.</span> {t.rule1Title}
        </h4>
        <p class="text-xs text-muted leading-relaxed">{t.rule1Text}</p>
