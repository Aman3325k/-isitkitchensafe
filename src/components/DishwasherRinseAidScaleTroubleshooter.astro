---
import rawData from '../data/dishwasher-rinse-aid-scale-data.json';
import type { SupportedLanguage } from '../i18n/ui';
import { useTranslatedPath } from '../i18n/utils';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;
const translatePath = useTranslatedPath(lang);

const dosageCalculatorUrl = translatePath('/tools/dishwasher-detergent-dosage-calculator/');
const chemicalSafetyUrl = translatePath('/tools/cleaner-mixing-danger-checker/');
const waterFilterUrl = translatePath('/tools/water-filter-efficiency-analyzer/');
const commercialModelerUrl = translatePath('/tools/commercial-dishwasher-rinse-aid-modeler/');
const methodologyUrl = translatePath('/methodology/');
const allToolsUrl = translatePath('/tools/');

const currentLocale = (['en', 'es', 'pt', 'zh-cn', 'ja'].includes(lang) ? lang : 'en') as 'en' | 'es' | 'pt' | 'zh-cn' | 'ja';

const bannerData = rawData.safetyBanner[currentLocale] || rawData.safetyBanner.en;

const localizedVinegarSteps = rawData.vinegarTest.steps[currentLocale] || rawData.vinegarTest.steps.en;

const localizedVinegarOutcomes = rawData.vinegarTest.outcomes.map((oc: any) => ({
  id: oc.id,
  icon: oc.icon,
  isPermanent: oc.isPermanent,
  verdict: oc.verdict,
  title: oc.i18n[currentLocale]?.title || oc.i18n.en.title,
  description: oc.i18n[currentLocale]?.description || oc.i18n.en.description,
  cause: oc.i18n[currentLocale]?.cause || oc.i18n.en.cause,
  action: oc.i18n[currentLocale]?.action || oc.i18n.en.action
}));

const localizedHardnessTiers = rawData.waterHardnessTiers.map((tier: any) => ({
  id: tier.id,
  gpgRange: tier.gpgRange,
  ppmRange: tier.ppmRange,
  etchingRisk: tier.etchingRisk,
  scaleRisk: tier.scaleRisk,
  rinseAidSetting: tier.rinseAidSetting,
  recommendedDetergent: tier.recommendedDetergent,
  saltRequired: tier.saltRequired,
  name: tier.i18n[currentLocale]?.name || tier.i18n.en.name,
  summary: tier.i18n[currentLocale]?.summary || tier.i18n.en.summary,
  action: tier.i18n[currentLocale]?.action || tier.i18n.en.action
}));

const localizedPodSafety = rawData.podOverdoseSafety[currentLocale] || rawData.podOverdoseSafety.en;

const localizedDescalingSteps = rawData.descalingGuide.steps[currentLocale] || rawData.descalingGuide.steps.en;

const localizedFaqs = rawData.faqs[currentLocale] || rawData.faqs.en;

