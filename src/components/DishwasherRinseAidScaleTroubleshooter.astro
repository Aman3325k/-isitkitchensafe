<script>
  function initDishwasherTroubleshooter() {
    const container = document.querySelector('.dishwasher-troubleshooter-container');
    if (!container) return;

    // Tab Switching
    const tabBtns = container.querySelectorAll('.tab-btn');
    const tabContents = container.querySelectorAll('.tab-content');

    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        tabBtns.forEach((b) => {
          b.classList.remove('active', 'bg-slate-900', 'text-white');
          b.classList.add('bg-slate-100', 'text-slate-700');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('active', 'bg-slate-900', 'text-white');
        btn.classList.remove('bg-slate-100', 'text-slate-700');
        btn.setAttribute('aria-selected', 'true');

        tabContents.forEach((c) => {
          if (c.id === targetId) {
            c.classList.remove('hidden');
            c.classList.add('active');
          } else {
            c.classList.add('hidden');
            c.classList.remove('active');
          }
        });
      });
    });

    // Vinegar Test Outcome Toggle
    const outcomeBtns = container.querySelectorAll('.outcome-btn');
    const outcomeScale = container.querySelector('#outcome-scale');
    const outcomeEtching = container.querySelector('#outcome-etching');

    outcomeBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const outcome = btn.getAttribute('data-outcome');
        outcomeBtns.forEach((b) => {
          b.classList.remove('active', 'border-blue-600', 'ring-2', 'ring-blue-500');
          b.classList.add('border-slate-200');
        });
        btn.classList.add('active', 'border-blue-600', 'ring-2', 'ring-blue-500');
        btn.classList.remove('border-slate-200');

        if (outcome === 'scale') {
          outcomeScale?.classList.remove('hidden');
          outcomeEtching?.classList.add('hidden');
        } else {
          outcomeEtching?.classList.remove('hidden');
          outcomeScale?.classList.add('hidden');
        }
      });
    });

    // Hardness Tier Selector
    const tierBtns = container.querySelectorAll('.tier-btn');
    const tierCards = container.querySelectorAll('.tier-card');

    tierBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tierId = btn.getAttribute('data-tier');
        tierBtns.forEach((b) => {
          b.classList.remove('active', 'ring-2', 'ring-blue-600', 'bg-blue-50', 'border-blue-500', 'font-bold');
          b.classList.add('bg-slate-50', 'border-slate-200', 'text-slate-700');
        });
        btn.classList.add('active', 'ring-2', 'ring-blue-600', 'bg-blue-50', 'border-blue-500', 'font-bold');
        btn.classList.remove('bg-slate-50', 'border-slate-200', 'text-slate-700');

        tierCards.forEach((card) => {
          if (card.id === `tier-card-${tierId}`) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });

    // Checklist Progress Counter
    const checkboxes = container.querySelectorAll('.descaling-checkbox');
    const counter = container.querySelector('#completed-counter');
    const resetBtn = container.querySelector('#reset-checklist-btn');
    const totalSteps = checkboxes.length;

    function updateCounter() {
      let checked = 0;
      checkboxes.forEach((cb) => {
        if ((cb as HTMLInputElement).checked) checked++;
      });
      if (counter) {
        counter.textContent = `${checked} / ${totalSteps}`;
      }
    }

    checkboxes.forEach((cb) => {
      cb.addEventListener('change', updateCounter);
    });

    resetBtn?.addEventListener('click', () => {
      checkboxes.forEach((cb) => {
        (cb as HTMLInputElement).checked = false;
      });
      updateCounter();
    });

    // Copy Report Button
    const copyBtn = container.querySelector('#copy-report-btn');
    const copyText = container.querySelector('#copy-btn-text');

    copyBtn?.addEventListener('click', () => {
      const activeOutcome = container.querySelector('.outcome-btn.active')?.getAttribute('data-outcome') || 'scale';
      const activeTier = container.querySelector('.tier-btn.active')?.getAttribute('data-tier') || 'moderate';
      const activeOutcomeTitle = container.querySelector(`#outcome-${activeOutcome} h4`)?.textContent || '';
      const activeTierText = container.querySelector(`#tier-card-${activeTier} h4`)?.textContent || '';

      const reportText = `[IsItKitchenSafe] Dishwasher Rinse Aid & Scale Diagnostic Report\n` +
        `• Glass Status: ${activeOutcome === 'scale' ? 'Mineral Limescale Film (Removable with Citric Acid)' : 'Glass Etching / Silica Leaching (Permanent Corrosion)'}\n` +
        `• Diagnostic Detail: ${activeOutcomeTitle}\n` +
        `• Water Hardness Calibration: ${activeTierText}\n` +
        `• Standard: Residential 3-4 freshwater rinses dilute surfactants by >10,000x (<0.1 mg/L).\n` +
        `• Full Guide: https://isitkitchensafe.com/tools/dishwasher-rinse-aid-scale-troubleshooter/`;

      navigator.clipboard.writeText(reportText).then(() => {
        if (copyText) {
          const original = copyText.textContent;
          copyText.textContent = '✓ Copied!';
          setTimeout(() => {
            copyText.textContent = original;
          }, 2500);
        }
      });
    });
  }

  // Initialize on load and on Astro page transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDishwasherTroubleshooter);
  } else {
    initDishwasherTroubleshooter();
  }
  document.addEventListener('astro:page-load', initDishwasherTroubleshooter);
</script>

