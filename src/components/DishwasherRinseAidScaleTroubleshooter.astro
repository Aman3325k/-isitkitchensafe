---

<div class="dishwasher-troubleshooter-container" data-lang={currentLocale}>
  <!-- Top Safety Banner -->
  <div class="safety-banner bg-amber-50 border-l-4 border-amber-500 p-4 rounded-r-lg mb-8 shadow-xs">
    <div class="flex items-start gap-3">
      <span class="text-2xl select-none" aria-hidden="true">🫧</span>
      <div>
        <h2 class="text-amber-900 font-bold text-base md:text-lg mb-1">{bannerData.title}</h2>
        <p class="text-amber-800 text-sm leading-relaxed">{bannerData.text}</p>
      </div>
    </div>
  </div>

  <!-- Interactive Navigation Tabs -->
  <div class="tabs-nav flex flex-wrap gap-2 border-b border-slate-200 pb-2 mb-8" role="tablist">
    <button
      type="button"
      class="tab-btn active px-4 py-2.5 rounded-lg text-sm font-semibold transition-all flex items-center gap-2"
      data-target="tab-vinegar"
      role="tab"
      aria-selected="true"
    >
      <span>🧪</span>
      <span>{ui.tabVinegar}</span>
    </button>
    <button
      type="button"
      class="tab-btn px-4 py-2.5 rounded-lg text-sm font-semibold transition-all flex items-center gap-2"
      data-target="tab-hardness"
      role="tab"
      aria-selected="false"
    >
      <span>💧</span>
      <span>{ui.tabHardness}</span>
    </button>
    <button
      type="button"
      class="tab-btn px-4 py-2.5 rounded-lg text-sm font-semibold transition-all flex items-center gap-2"
      data-target="tab-surfactant"
      role="tab"
      aria-selected="false"
    >
      <span>🔬</span>
      <span>{ui.tabSurfactant}</span>
    </button>
    <button
      type="button"
      class="tab-btn px-4 py-2.5 rounded-lg text-sm font-semibold transition-all flex items-center gap-2"
      data-target="tab-descaling"
      role="tab"
      aria-selected="false"
    >
      <span>⚡</span>
      <span>{ui.tabDescaling}</span>
    </button>
  </div>

  <!-- TAB 1: CLOUDY GLASS VINEGAR TEST -->
  <section id="tab-vinegar" class="tab-content active" role="tabpanel">
    <div class="bg-white border border-slate-200 rounded-xl p-6 md:p-8 shadow-sm mb-8">
      <div class="mb-6">
        <span class="inline-block px-2.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-sky-100 text-sky-800 mb-2">
          5-Minute Laboratory Vinegar Test
        </span>
        <h3 class="text-xl md:text-2xl font-bold text-slate-900 mb-2">{ui.tabVinegar}</h3>
        <p class="text-slate-600 text-sm leading-relaxed">{ui.testPrompt}</p>
      </div>

      <!-- Steps Instructions Box -->
      <div class="bg-slate-50 border border-slate-200 rounded-lg p-4 mb-6">
        <ol class="list-decimal list-inside space-y-2 text-sm text-slate-700 font-medium">
          {localizedVinegarSteps.map((step: string) => (
            <li>{step}</li>
          ))}
        </ol>
      </div>

      <!-- Test Outcome Selector Buttons -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
        <button
          type="button"
          class="outcome-btn active p-5 rounded-xl border-2 text-left transition-all cursor-pointer flex flex-col justify-between"
          data-outcome="scale"
        >
          <div class="flex items-center gap-3 mb-2">
            <span class="text-2xl">✨</span>
            <span class="font-bold text-base text-slate-900">{ui.selectOutcomeA}</span>
          </div>
          <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 w-fit">
            {ui.reversibleBadge}
          </span>
        </button>

        <button
          type="button"
          class="outcome-btn p-5 rounded-xl border-2 text-left transition-all cursor-pointer flex flex-col justify-between"
          data-outcome="etching"
        >
          <div class="flex items-center gap-3 mb-2">
            <span class="text-2xl">⚠️</span>
