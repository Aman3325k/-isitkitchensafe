---
import { languages, type SupportedLanguage } from '../i18n/ui';
import { getLangFromUrl, getLocalizedUrl } from '../i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const currentPath = Astro.url.pathname;

const languageLabels: Record<SupportedLanguage, { short: string; label: string; flag: string }> = {
  en: { short: 'EN', label: 'English', flag: '🇺🇸' },
  es: { short: 'ES', label: 'Español', flag: '🇪🇸' },
  pt: { short: 'PT', label: 'Português', flag: '🇧🇷' },
};
---

<div class="relative inline-block text-left language-picker-container" data-language-picker>
  <button
    type="button"
    class="language-picker-button inline-flex items-center gap-1.5 px-3 py-2 min-h-[44px] text-[13px] font-medium text-ink bg-surface-soft hover:bg-surface-strong border border-hairline rounded-md transition-colors cursor-pointer"
    aria-expanded="false"
    aria-haspopup="true"
    aria-label="Select Language"
    data-picker-button
  >
    <span class="text-xs">{languageLabels[currentLang].flag}</span>
    <span class="tracking-wide uppercase font-semibold text-[12px]">{languageLabels[currentLang].short}</span>
    <svg class="language-picker-arrow w-3.5 h-3.5 text-muted transition-transform duration-200" data-picker-arrow fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
    </svg>
  </button>

  <!-- Dropdown menu -->
  <div
    class="language-picker-dropdown hidden absolute right-0 mt-1.5 w-44 rounded-md bg-canvas border border-hairline shadow-lg py-1 z-50 ring-1 ring-black/5"
    role="menu"
    aria-orientation="vertical"
    tabindex="-1"
    data-picker-dropdown
  >
    {(Object.keys(languages) as SupportedLanguage[]).map((lang) => {
      const isCurrent = lang === currentLang;
      const targetUrl = getLocalizedUrl(currentPath, lang);
      return (
        <a
          href={targetUrl}
          class={`flex items-center justify-between px-3.5 py-3 min-h-[44px] text-[14px] transition-colors ${
            isCurrent
              ? 'bg-primary text-on-primary font-medium'
              : 'text-body hover:text-ink hover:bg-surface-soft'
          }`}
          role="menuitem"
          tabindex="-1"
          hreflang={lang}
        >
          <span class="flex items-center gap-2.5">
            <span class="text-sm">{languageLabels[lang].flag}</span>
            <span>{languageLabels[lang].label}</span>
          </span>
          {isCurrent && <span class="text-xs font-bold">✓</span>}
        </a>
      );
    })}
  </div>
</div>

<script>
  function setupLanguagePickers() {
    const containers = document.querySelectorAll<HTMLElement>('[data-language-picker]');

    containers.forEach((container) => {
      const btn = container.querySelector<HTMLButtonElement>('[data-picker-button]');
      const menu = container.querySelector<HTMLElement>('[data-picker-dropdown]');
      const arrow = container.querySelector<SVGElement>('[data-picker-arrow]');

      if (!btn || !menu) return;

      const toggleDropdown = (open?: boolean) => {
        const isExpanded = btn.getAttribute('aria-expanded') === 'true';
        const shouldOpen = open !== undefined ? open : !isExpanded;
        btn.setAttribute('aria-expanded', String(shouldOpen));
        if (shouldOpen) {
          menu.classList.remove('hidden');
          arrow?.classList.add('rotate-180');
        } else {
          menu.classList.add('hidden');
          arrow?.classList.remove('rotate-180');
        }
      };

      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        // Close other open language pickers first
        containers.forEach((other) => {
          if (other !== container) {
            const otherBtn = other.querySelector<HTMLButtonElement>('[data-picker-button]');
            const otherMenu = other.querySelector<HTMLElement>('[data-picker-dropdown]');
            const otherArrow = other.querySelector<SVGElement>('[data-picker-arrow]');
            otherBtn?.setAttribute('aria-expanded', 'false');
            otherMenu?.classList.add('hidden');
            otherArrow?.classList.remove('rotate-180');
          }
        });
        toggleDropdown();
      });

      document.addEventListener('click', (e) => {
        if (!container.contains(e.target as Node)) {
          toggleDropdown(false);
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          toggleDropdown(false);
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupLanguagePickers);
  } else {
    setupLanguagePickers();
  }
</script>
