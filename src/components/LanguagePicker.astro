---
import { languages, type SupportedLanguage } from '../i18n/ui';
import { getLangFromUrl, getLocalizedUrl } from '../i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const currentPath = Astro.url.pathname;

const languageLabels: Record<SupportedLanguage, { short: string; label: string; flag: string }> = {
  en: { short: 'EN', label: 'English', flag: '🇺🇸' },
  es: { short: 'ES', label: 'Español', flag: '🇪🇸' },
  pt: { short: 'PT', label: 'Português', flag: '🇧🇷' },
  'zh-cn': { short: '中文', label: '简体中文', flag: '🇨🇳' },
  ja: { short: 'JA', label: '日本語', flag: '🇯🇵' },
};
---

<div class="relative inline-block text-left language-picker-container" data-language-picker>
  <button
    type="button"
    class="language-picker-button inline-flex items-center gap-1 sm:gap-1.5 px-2 sm:px-3 py-2 min-h-[44px] text-[13px] font-medium text-ink bg-surface-soft hover:bg-surface-strong border border-hairline rounded-md transition-colors cursor-pointer"
    aria-expanded="false"
    aria-haspopup="true"
    aria-label={`${languageLabels[currentLang].short} - Select Language`}
    data-picker-button
  >
    <span class="text-xs">{languageLabels[currentLang].flag}</span>
    <span class="tracking-wide uppercase font-semibold text-[12px]">{languageLabels[currentLang].short}</span>
    <svg class="language-picker-arrow w-3.5 h-3.5 text-muted transition-transform duration-200" data-picker-arrow fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
    </svg>
  </button>

  <!-- Dropdown menu -->
  <div
    class="language-picker-dropdown hidden absolute right-0 mt-1.5 w-44 rounded-md bg-canvas border border-hairline shadow-lg py-1 z-[100] ring-1 ring-black/5"
    role="menu"
    aria-orientation="vertical"
    tabindex="-1"
    data-picker-dropdown
  >
    {(Object.keys(languages) as SupportedLanguage[]).map((lang) => {
      const isCurrent = lang === currentLang;
      const targetUrl = getLocalizedUrl(currentPath, lang);
      return (
        <a
          href={targetUrl}
          class={`flex items-center justify-between px-3.5 py-3 min-h-[44px] text-[14px] transition-colors ${
            isCurrent
              ? 'bg-primary text-on-primary font-medium'
              : 'text-body hover:text-ink hover:bg-surface-soft'
          }`}
          role="menuitem"
          tabindex="-1"
          hreflang={lang === 'zh-cn' ? 'zh-CN' : lang}
        >
          <span class="flex items-center gap-2.5">
            <span class="text-sm">{languageLabels[lang].flag}</span>
            <span>{languageLabels[lang].label}</span>
          </span>
          {isCurrent && <span class="text-xs font-bold">✓</span>}
        </a>
      );
    })}
  </div>
</div>


