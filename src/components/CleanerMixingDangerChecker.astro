    rule2: '異臭やガスが出た際に、中和しようとして別の洗剤を追加投入しない。',
    rule3: '刺激臭や泡立ちを感じたら、直ちに息を止めて部屋の外へ全員避難する。',
    rule4: '目や皮膚に飛散した場合は、流水で最低15分間連続して洗い流す。',
    printBtn: '応急ガイドを印刷 / 保存',
    resetBtn: 'リセット',
    sameChemWarning: '同じ洗剤が2つ選択されています。原液のまま使用すると皮膚や粘膜への刺激が強まるため、製品に記載された適正な希釈倍率を守ってご使用ください。',
    unknownSafeCombo: 'この2つの洗剤の間で急激な有毒ガス発生などの危険反応は確認されていませんが、異なる洗剤を混ぜても洗浄力は高まらず効果が相殺されることがあります。別々に使用し水拭きを挟むことを推奨します。'
  }
};

const t = UI_TEXT[lang] || UI_TEXT.en;

const quickCombos = [
  { c1: 'bleach', c2: 'vinegar', label: lang === 'es' ? 'Lejía + Vinagre (Gas Cloro)' : lang === 'pt' ? 'Cloro + Vinagre (Gás Cloro)' : lang === 'zh-cn' ? '漂白水 + 白醋（剧毒氯气）' : lang === 'ja' ? '漂白剤 + お酢（塩素ガス）' : 'Bleach + Vinegar (Chlorine Gas)', badgeClass: 'bg-rose-100 text-rose-800 border-rose-300' },
  { c1: 'bleach', c2: 'ammonia', label: lang === 'es' ? 'Lejía + Amoníaco (Cloramina)' : lang === 'pt' ? 'Cloro + Amônia (Cloramina)' : lang === 'zh-cn' ? '漂白水 + 氨水（剧毒氯胺）' : lang === 'ja' ? '漂白剤 + アンモニア（クロラミン）' : 'Bleach + Ammonia (Chloramine)', badgeClass: 'bg-rose-100 text-rose-800 border-rose-300' },
  { c1: 'bleach', c2: 'rubbing-alcohol', label: lang === 'es' ? 'Lejía + Alcohol (Cloroformo)' : lang === 'pt' ? 'Cloro + Álcool (Clorofórmio)' : lang === 'zh-cn' ? '漂白水 + 酒精（麻醉氯仿）' : lang === 'ja' ? '漂白剤 + アルコール（クロロホルム）' : 'Bleach + Alcohol (Chloroform)', badgeClass: 'bg-rose-100 text-rose-800 border-rose-300' },
  { c1: 'hydrogen-peroxide', c2: 'vinegar', label: lang === 'es' ? 'Agua Oxig. + Vinagre (Ácido Peracético)' : lang === 'pt' ? 'Água Oxig. + Vinagre (Ácido Peracético)' : lang === 'zh-cn' ? '双氧水 + 白醋（过氧乙酸）' : lang === 'ja' ? 'オキシドール + お酢（過酢酸）' : 'Peroxide + Vinegar (Peracetic Acid)', badgeClass: 'bg-amber-100 text-amber-800 border-amber-300' },
  { c1: 'baking-soda', c2: 'vinegar', label: lang === 'es' ? 'Bicarbonato + Vinagre (Mito Ineficaz)' : lang === 'pt' ? 'Bicarbonato + Vinagre (Mito Inútil)' : lang === 'zh-cn' ? '小苏打 + 白醋（中和失效误区）' : lang === 'ja' ? '重曹 + お酢（中和して効果相殺）' : 'Baking Soda + Vinegar (Myth Neutralized)', badgeClass: 'bg-blue-100 text-blue-800 border-blue-300' },
  { c1: 'baking-soda', c2: 'dish-soap', label: lang === 'es' ? 'Bicarbonato + Lavavajillas (Pasta Segura)' : lang === 'pt' ? 'Bicarbonato + Detergente (Pasta Segura)' : lang === 'zh-cn' ? '小苏打 + 洗洁精（安全去焦黑膏）' : lang === 'ja' ? '重曹 + 洗剤（安全万能クレンザー）' : 'Baking Soda + Dish Soap (Safe Paste)', badgeClass: 'bg-emerald-100 text-emerald-800 border-emerald-300' },
  { c1: 'rubbing-alcohol', c2: 'vinegar', label: lang === 'es' ? 'Alcohol + Vinagre (Limpiacristales)' : lang === 'pt' ? 'Álcool + Vinagre (Limpa-Vidros)' : lang === 'zh-cn' ? '酒精 + 白醋（无水痕玻璃喷雾）' : lang === 'ja' ? 'アルコール + お酢（速乾窓拭き）' : 'Alcohol + Vinegar (Safe Glass Spray)', badgeClass: 'bg-emerald-100 text-emerald-800 border-emerald-300' },
  { c1: 'drain-cleaner', c2: 'toilet-bowl-cleaner', label: lang === 'es' ? 'Desatascador + Ácido (Erupción)' : lang === 'pt' ? 'Desentupidor + Ácido (Erupção)' : lang === 'zh-cn' ? '疏通剂 + 洁厕灵（强热暴沸喷溅）' : lang === 'ja' ? 'パイプ洗剤 + 酸性洗剤（爆発突沸）' : 'Drain Cleaner + Acid (Explosive Flash)', badgeClass: 'bg-rose-100 text-rose-800 border-rose-300' }
];
---

<div class="cleaner-danger-engine my-6 bg-surface-card border border-hairline rounded-2xl shadow-sm overflow-hidden" data-lang={lang}>
  <!-- Hero Banner -->
  <div class="p-6 sm:p-8 bg-gradient-to-br from-rose-950 via-slate-900 to-amber-950 text-white relative">
    <div class="max-w-3xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-rose-500/20 text-rose-300 border border-rose-500/30 mb-3">
        <span class="inline-block w-2 h-2 rounded-full bg-rose-400 animate-pulse"></span>
        {t.kicker}
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-white mb-3">
        {t.heading}
      </h2>
      <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
        {t.subheading}
      </p>
    </div>
  </div>

  <div class="p-6 sm:p-8 space-y-8">
    <!-- Quick Click Common Combos -->
    <div class="no-print">
      <span class="block text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-3">
        {t.quickCombosLabel}
      </span>
      <div class="flex flex-wrap gap-2">
        {quickCombos.map((combo) => (
          <button
            type="button"
            class={`quick-combo-btn px-3 py-1.5 rounded-lg text-xs font-medium border transition-all cursor-pointer hover:shadow-xs active:scale-95 ${combo.badgeClass}`}
            data-c1={combo.c1}
            data-c2={combo.c2}
          >
            {combo.label}
          </button>
        ))}
      </div>
    </div>

    <!-- Dual Chemical Selectors -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 items-center relative no-print">
      <!-- Chemical 1 -->
      <div class="bg-surface-soft border border-hairline rounded-xl p-4 sm:p-5 shadow-2xs">
        <label for="chem-select-1" class="block text-xs font-semibold uppercase tracking-wider text-slate-600 dark:text-slate-300 mb-2">
          {t.selectChem1Label}
        </label>
        <select
          id="chem-select-1"
          class="w-full bg-surface-card border border-slate-300 dark:border-slate-700 rounded-lg px-3 py-2.5 text-sm font-medium text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-rose-500 transition-colors"
        >
          {cleanerData.chemicals.map((chem) => (
            <option value={chem.id} selected={chem.id === 'bleach'}>
              {(chem.commonName as any)[lang] || chem.commonName.en} ({chem.formula})
            </option>
          ))}
        </select>
        <div id="chem-1-meta" class="mt-2.5 text-xs text-slate-500 dark:text-slate-400 space-y-0.5">
          <span class="chem-ph font-mono block"></span>
          <span class="chem-uses block"></span>
        </div>
      </div>

      <!-- Swap Button in the Middle -->
      <div class="hidden md:flex absolute left-1/2 -translate-x-1/2 top-1/2 -translate-y-1/2 z-10">
        <button
          type="button"
          id="swap-chems-btn"
          aria-label={t.swapBtnAria}
          class="w-10 h-10 rounded-full bg-surface-card border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-200 shadow-md flex items-center justify-center hover:bg-slate-100 dark:hover:bg-slate-800 active:scale-90 transition-transform cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
          </svg>
        </button>
      </div>

      <!-- Chemical 2 -->
      <div class="bg-surface-soft border border-hairline rounded-xl p-4 sm:p-5 shadow-2xs">
        <label for="chem-select-2" class="block text-xs font-semibold uppercase tracking-wider text-slate-600 dark:text-slate-300 mb-2">
          {t.selectChem2Label}
        </label>
        <select
          id="chem-select-2"
          class="w-full bg-surface-card border border-slate-300 dark:border-slate-700 rounded-lg px-3 py-2.5 text-sm font-medium text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-rose-500 transition-colors"
        >
          {cleanerData.chemicals.map((chem) => (
            <option value={chem.id} selected={chem.id === 'vinegar'}>
              {(chem.commonName as any)[lang] || chem.commonName.en} ({chem.formula})
            </option>
          ))}
        </select>
        <div id="chem-2-meta" class="mt-2.5 text-xs text-slate-500 dark:text-slate-400 space-y-0.5">
          <span class="chem-ph font-mono block"></span>
          <span class="chem-uses block"></span>
        </div>
      </div>
    </div>

    <!-- Active Reaction Diagnostic Result Card -->
    <div id="reaction-verdict-card" class="rounded-xl border p-5 sm:p-6 transition-all shadow-sm">
      <div class="flex items-start justify-between gap-4 border-b pb-4 mb-4 border-inherit">
        <div class="flex items-center gap-3">
          <span id="severity-icon" class="text-3xl shrink-0" aria-hidden="true">🛑</span>
          <div>
            <span id="severity-badge" class="inline-block px-2.5 py-0.5 rounded text-[11px] font-bold uppercase tracking-wider mb-1">
              DEADLY HAZARD
            </span>
            <h3 id="hazard-title" class="text-lg sm:text-xl font-bold leading-snug">
              Produces Toxic Chlorine Gas (Cl₂)
            </h3>
          </div>
        </div>
        <div class="hidden sm:block text-right shrink-0">
          <span id="byproduct-chip" class="inline-block px-3 py-1 rounded-full text-xs font-mono font-semibold bg-slate-900 text-white">
            Cl₂ Gas
          </span>
        </div>
      </div>

      <!-- Chemical Formula Banner -->
      <div id="formula-box" class="bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 rounded-lg px-3.5 py-2 font-mono text-xs sm:text-sm text-slate-800 dark:text-slate-200 mb-4 flex items-center justify-between">
        <span class="text-slate-500 dark:text-slate-400 text-xs">{t.chemicalFormulaLabel}:</span>
        <span id="reaction-formula" class="font-bold">NaClO + 2 CH₃COOH &rarr; Cl₂&uarr; + 2 CH₃COONa + H₂O</span>
      </div>

      <!-- Explanation Paragraph -->
      <p id="hazard-explanation" class="text-sm sm:text-base leading-relaxed text-slate-700 dark:text-slate-300 mb-5">
      </p>

      <!-- Grid: Symptoms & Emergency Protocol -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2 border-t border-inherit">
        <!-- Symptoms -->
        <div class="bg-surface-soft p-4 rounded-lg border border-hairline">
          <div class="flex items-center gap-2 mb-2 text-rose-600 dark:text-rose-400 font-semibold text-xs uppercase tracking-wider">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
            {t.symptomsLabel}
          </div>
          <ul id="symptoms-list" class="space-y-1.5 text-xs sm:text-sm text-slate-700 dark:text-slate-300 list-disc list-inside">
          </ul>
        </div>

        <!-- Emergency Protocol -->
        <div class="bg-rose-50 dark:bg-rose-950/40 p-4 rounded-lg border border-rose-200 dark:border-rose-900/60">
          <div class="flex items-center gap-2 mb-2 text-rose-700 dark:text-rose-300 font-semibold text-xs uppercase tracking-wider">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
            {t.emergencyTitle}
          </div>
          <p id="emergency-action" class="text-xs sm:text-sm leading-relaxed text-rose-950 dark:text-rose-200 font-medium">
          </p>
        </div>
      </div>

      <!-- Safe Cleaning Alternative Strip -->
      <div class="mt-4 p-4 rounded-lg bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-900/60 flex items-start gap-3">
        <span class="text-emerald-600 dark:text-emerald-400 text-lg shrink-0 mt-0.5" aria-hidden="true">💡</span>
        <div>
          <span class="block text-xs font-semibold uppercase tracking-wider text-emerald-800 dark:text-emerald-300 mb-1">
            {t.safeAlternativeTitle}
          </span>
          <p id="safe-alternative" class="text-xs sm:text-sm text-emerald-950 dark:text-emerald-200 leading-relaxed">
          </p>
        </div>
      </div>
    </div>

    <!-- 4 Non-Negotiable Kitchen Chemical Safety Rules -->
    <div class="p-5 sm:p-6 rounded-xl bg-slate-900 text-white">
      <h3 class="text-sm sm:text-base font-bold uppercase tracking-wider text-amber-400 mb-4 flex items-center gap-2">
        <span aria-hidden="true">🛡️</span> {t.fourRulesTitle}
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs sm:text-sm text-slate-300">
        <div class="flex items-start gap-2 bg-slate-800/60 p-3 rounded-lg border border-slate-700/60">
          <span class="text-amber-400 font-bold">1.</span>
          <span>{t.rule1}</span>
        </div>
        <div class="flex items-start gap-2 bg-slate-800/60 p-3 rounded-lg border border-slate-700/60">
          <span class="text-amber-400 font-bold">2.</span>
          <span>{t.rule2}</span>
        </div>
        <div class="flex items-start gap-2 bg-slate-800/60 p-3 rounded-lg border border-slate-700/60">
          <span class="text-amber-400 font-bold">3.</span>
          <span>{t.rule3}</span>
        </div>
        <div class="flex items-start gap-2 bg-slate-800/60 p-3 rounded-lg border border-slate-700/60">
          <span class="text-amber-400 font-bold">4.</span>
          <span>{t.rule4}</span>
        </div>
      </div>
    </div>

    <!-- Kitchen Surfaces Chemical Compatibility Reference Matrix -->
    <div>
      <h3 class="text-base sm:text-lg font-bold text-ink mb-3 flex items-center gap-2">
        <span aria-hidden="true">🍳</span> {t.surfaceGuideTitle}
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {cleanerData.kitchenSurfaces.map((surf) => (
          <div class="p-4 rounded-xl border border-hairline bg-surface-soft space-y-2.5">
            <h4 class="text-sm font-semibold text-ink leading-snug">
              {(surf.name as any)[lang] || surf.name.en}
            </h4>
            <div class="text-xs space-y-1">
              <span class="block font-semibold text-emerald-600 dark:text-emerald-400">{t.safeAgentsLabel}</span>
              <p class="text-slate-600 dark:text-slate-300 leading-relaxed">
                {(surf.safeAgents as any)[lang] || surf.safeAgents.en}
              </p>
            </div>
            <div class="text-xs space-y-1 pt-1.5 border-t border-hairline">
              <span class="block font-semibold text-rose-600 dark:text-rose-400">{t.forbiddenAgentsLabel}</span>
              <p class="text-slate-600 dark:text-slate-300 leading-relaxed font-medium">
                {(surf.forbiddenAgents as any)[lang] || surf.forbiddenAgents.en}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Hotlines & Quick Action Bar -->
    <div class="pt-4 border-t border-hairline flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="text-xs text-slate-500 dark:text-slate-400">
        <span class="font-semibold text-ink block">{t.hotlinesTitle}:</span>
        <span>US/Canada: <strong class="text-rose-600 dark:text-rose-400">1-800-222-1222</strong> | UK: <strong>111 / 999</strong> | EU: <strong>112</strong> | Japan: <strong>119</strong> | China: <strong>120</strong></span>
      </div>
      <div class="flex items-center gap-2 no-print shrink-0">
        <button
          type="button"
          id="print-danger-guide-btn"
          class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-surface-card border border-hairline text-ink hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer inline-flex items-center gap-1.5"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path></svg>
          {t.printBtn}
        </button>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ cleanerData, currentLang: lang, t }}>
  (() => {
    const root = document.querySelector('.cleaner-danger-engine');
    if (!root) return;

    const select1 = root.querySelector('#chem-select-1');
    const select2 = root.querySelector('#chem-select-2');
    const swapBtn = root.querySelector('#swap-chems-btn');
    const quickBtns = root.querySelectorAll('.quick-combo-btn');
    const printBtn = root.querySelector('#print-danger-guide-btn');

    // Verdict elements
    const card = root.querySelector('#reaction-verdict-card');
    const iconEl = root.querySelector('#severity-icon');
    const badgeEl = root.querySelector('#severity-badge');
    const titleEl = root.querySelector('#hazard-title');
    const byproductEl = root.querySelector('#byproduct-chip');
    const formulaBox = root.querySelector('#formula-box');
    const formulaEl = root.querySelector('#reaction-formula');
    const explanationEl = root.querySelector('#hazard-explanation');
    const symptomsList = root.querySelector('#symptoms-list');
    const emergencyEl = root.querySelector('#emergency-action');
    const alternativeEl = root.querySelector('#safe-alternative');

    // Meta elements
    const meta1Ph = root.querySelector('#chem-1-meta .chem-ph');
    const meta1Uses = root.querySelector('#chem-1-meta .chem-uses');
    const meta2Ph = root.querySelector('#chem-2-meta .chem-ph');
    const meta2Uses = root.querySelector('#chem-2-meta .chem-uses');

    function getChem(id) {
      return cleanerData.chemicals.find(c => c.id === id);
    }

    function findReaction(c1, c2) {
      return cleanerData.pairwiseReactions.find(r => 
        (r.pair[0] === c1 && r.pair[1] === c2) || (r.pair[0] === c2 && r.pair[1] === c1)
      );
    }

    function update() {
      const id1 = select1.value;
      const id2 = select2.value;

      const chem1 = getChem(id1);
      const chem2 = getChem(id2);

      if (chem1 && meta1Ph && meta1Uses) {
        meta1Ph.textContent = `pH: ${chem1.ph}`;
        meta1Uses.textContent = chem1.commonUses[currentLang] || chem1.commonUses.en;
      }
      if (chem2 && meta2Ph && meta2Uses) {
        meta2Ph.textContent = `pH: ${chem2.ph}`;
        meta2Uses.textContent = chem2.commonUses[currentLang] || chem2.commonUses.en;
      }

      if (id1 === id2) {
        // Same chemical selected
        card.className = 'rounded-xl border p-5 sm:p-6 transition-all shadow-sm bg-blue-50/60 dark:bg-blue-950/30 border-blue-200 dark:border-blue-900/60';
        iconEl.textContent = 'ℹ️';
        badgeEl.className = 'inline-block px-2.5 py-0.5 rounded text-[11px] font-bold uppercase tracking-wider mb-1 bg-blue-200 text-blue-900';
        badgeEl.textContent = 'IDENTICAL PRODUCT';
        titleEl.textContent = (chem1?.commonName[currentLang] || chem1?.commonName.en) + ' (Single Product)';
        byproductEl.textContent = 'No Reaction';
        formulaBox.style.display = 'none';
        explanationEl.textContent = t.sameChemWarning;
        symptomsList.innerHTML = `<li>${chem1?.dangerSummary[currentLang] || chem1?.dangerSummary.en}</li>`;
        emergencyEl.textContent = 'No chemical mixing reaction has occurred. Ensure proper ventilation and avoid getting concentrated solutions in eyes or on bare skin.';
        alternativeEl.textContent = 'Dilute according to manufacturer instructions on the back label. Never use straight concentrate on food preparation surfaces.';
        return;
      }

      const rx = findReaction(id1, id2);

      if (rx) {
        formulaBox.style.display = 'flex';
        formulaEl.innerHTML = rx.reactionFormula;
        byproductEl.textContent = rx.gasOrByproduct;

        titleEl.textContent = rx.title[currentLang] || rx.title.en;
        explanationEl.textContent = rx.explanation[currentLang] || rx.explanation.en;
        emergencyEl.textContent = rx.emergencyAction[currentLang] || rx.emergencyAction.en;
        alternativeEl.textContent = rx.safeAlternative[currentLang] || rx.safeAlternative.en;

        const symArr = rx.symptoms[currentLang] || rx.symptoms.en || [];
        symptomsList.innerHTML = symArr.map(s => `<li>${s}</li>`).join('');

        if (rx.severity === 'DEADLY') {
          card.className = 'rounded-xl border p-5 sm:p-6 transition-all shadow-sm bg-rose-50 dark:bg-rose-950/40 border-rose-300 dark:border-rose-800 text-rose-950 dark:text-rose-100';
          iconEl.textContent = '🛑';
          badgeEl.className = 'inline-block px-2.5 py-0.5 rounded text-[11px] font-bold uppercase tracking-wider mb-1 bg-rose-600 text-white animate-pulse';
          badgeEl.textContent = 'DEADLY HAZARD (LETHAL GAS / ERUPTION)';
        } else if (rx.severity === 'DANGEROUS') {
          card.className = 'rounded-xl border p-5 sm:p-6 transition-all shadow-sm bg-amber-50 dark:bg-amber-950/40 border-amber-300 dark:border-amber-800 text-amber-950 dark:text-amber-100';
          iconEl.textContent = '⚠️';
          badgeEl.className = 'inline-block px-2.5 py-0.5 rounded text-[11px] font-bold uppercase tracking-wider mb-1 bg-amber-600 text-white';
          badgeEl.textContent = 'HIGH DANGER (CORROSIVE / OVERPRESSURE)';
        } else if (rx.severity === 'INEFFECTIVE') {
          card.className = 'rounded-xl border p-5 sm:p-6 transition-all shadow-sm bg-blue-50 dark:bg-blue-950/40 border-blue-300 dark:border-blue-800 text-blue-950 dark:text-blue-100';
          iconEl.textContent = 'ℹ️';
          badgeEl.className = 'inline-block px-2.5 py-0.5 rounded text-[11px] font-bold uppercase tracking-wider mb-1 bg-blue-600 text-white';
          badgeEl.textContent = 'INEFFECTIVE / MUTUAL NEUTRALIZATION';
        } else if (rx.severity === 'SAFE') {
          card.className = 'rounded-xl border p-5 sm:p-6 transition-all shadow-sm bg-emerald-50 dark:bg-emerald-950/40 border-emerald-300 dark:border-emerald-800 text-emerald-950 dark:text-emerald-100';
          iconEl.textContent = '✅';
          badgeEl.className = 'inline-block px-2.5 py-0.5 rounded text-[11px] font-bold uppercase tracking-wider mb-1 bg-emerald-600 text-white';
          badgeEl.textContent = 'SAFE & HIGHLY EFFECTIVE COMBINATION';
        }
      } else {
        // Unknown pair fallback
        card.className = 'rounded-xl border p-5 sm:p-6 transition-all shadow-sm bg-slate-50 dark:bg-slate-800/40 border-slate-200 dark:border-slate-700 text-slate-900 dark:text-slate-100';
        iconEl.textContent = '🔍';
        badgeEl.className = 'inline-block px-2.5 py-0.5 rounded text-[11px] font-bold uppercase tracking-wider mb-1 bg-slate-600 text-white';
        badgeEl.textContent = 'NO MAJOR ACUTE GAS HAZARD DETECTED';
        titleEl.textContent = `${chem1?.commonName[currentLang] || chem1?.commonName.en} + ${chem2?.commonName[currentLang] || chem2?.commonName.en}`;
        byproductEl.textContent = 'No Incompatibility Recorded';
        formulaBox.style.display = 'none';
        explanationEl.textContent = t.unknownSafeCombo;
        symptomsList.innerHTML = `<li>Mild skin drying or eye irritation if splashed directly</li><li>Chemical scent from combined fragrances</li>`;
        emergencyEl.textContent = 'If any unusual heat, bubbling, or odor occurs, rinse the area with copious clean running water and ventilate the room.';
        alternativeEl.textContent = 'Rinse surfaces with clear tap water between different cleaning products rather than applying them simultaneously.';
      }
    }

    select1.addEventListener('change', update);
    select2.addEventListener('change', update);

    if (swapBtn) {
      swapBtn.addEventListener('click', () => {
        const temp = select1.value;
        select1.value = select2.value;
        select2.value = temp;
        update();
      });
    }

    quickBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const c1 = btn.getAttribute('data-c1');
        const c2 = btn.getAttribute('data-c2');
        if (c1 && c2) {
          select1.value = c1;
          select2.value = c2;
          update();
        }
      });
    });

    if (printBtn) {
      printBtn.addEventListener('click', () => {
        window.print();
      });
    }

    update();
  })();
</script>
