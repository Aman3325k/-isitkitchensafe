---
import cleanerData from '../data/cleaner-mixing-danger-checker-data.json';
import type { SupportedLanguage } from '../i18n/ui';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;

const UI_TEXT: Record<SupportedLanguage, {
  kicker: string;
  heading: string;
  subheading: string;
  quickCombosLabel: string;
  selectChem1Label: string;
  selectChem2Label: string;
  swapBtnAria: string;
  reactionHeading: string;
  chemicalFormulaLabel: string;
  byproductLabel: string;
  symptomsLabel: string;
