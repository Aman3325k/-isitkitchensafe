    simDesc: "选择烹饪目标温度，即刻核对哪些油品处于安全发烟点之下，哪些正处于热解产生剧毒丙烯醛有毒气体的超标危险温区：",
    simSafeBadge: "安全烹饪范围",
    simWarningBadge: "超过发烟点 — 严重氧化与毒性挥发",
    heatPresets: [
      { label: "冷拌 / 沙拉", tempF: 72, tempC: 22 },
      { label: "小火慢煎", tempF: 275, tempC: 135 },
      { label: "中火煎炒", tempF: 350, tempC: 177 },
      { label: "深度油炸", tempF: 375, tempC: 190 },
      { label: "铁锅大火爆炒", tempF: 425, tempC: 218 },
      { label: "牛排猛火煎封", tempF: 500, tempC: 260 }
    ],
    emptyTitle: "未找到匹配的食用油脂",
    emptyDesc: "请尝试更改搜索关键词或重置分类筛选，以查看全部 28 款食用油与油脂参数。",
    faqsTitle: "食用油发烟点、热稳定性与健康科学深度解答（FAQ）",
    relatedToolsTitle: "相关厨房温度与食品安全检测工具",
    methodologyNote: "发烟点数据及脂质降解动力学源自国际食品法典标准（CXS 210-1999）、同行评议色谱实测分析（De Alzaa et al., 2018）及欧盟废弃煎炸油标准（EU 2019/343）。"
  },
  ja: {
    searchPlaceholder: "食用油を検索（例：オリーブ油、アボカド、ギー、牛脂、ココナッツ、ラード）...",
    filterAll: "全28種類の食用油・油脂",
    filterHigh: "超高温焼き・揚げ物（232°C+ / 450°F+）",
    filterMed: "中温調理・フライ（177°–231°C）",
    filterLow: "低温調理・生食専用（<177°C）",
    filterAnimal: "伝統的動物性油脂・バター",
    tempF: "°F 華氏",
    tempC: "°C 摂氏",
    showingCount: "{total} 種類中 {visible} 種類を表示中",
