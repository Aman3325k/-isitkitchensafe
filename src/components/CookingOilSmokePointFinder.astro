---
import rawData from '../data/cooking-oil-smoke-point-data.json';
import type { SupportedLanguage } from '../i18n/ui';
import { useTranslatedPath } from '../i18n/utils';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;
const translatePath = useTranslatedPath(lang);

const cookwareTempUrl = translatePath('/tools/cookware-oven-temp-lookup/');
const internalTempUrl = translatePath('/tools/internal-cooking-temp-chart/');
const panScratchUrl = translatePath('/tools/pan-scratch-inspector/');
const airFryerUrl = translatePath('/tools/air-fryer-oven-converter/');
const methodologyUrl = translatePath('/methodology/');
const allToolsUrl = translatePath('/tools/');

type CategoryFilter = 'all' | 'high-heat' | 'medium-heat' | 'low-heat-raw' | 'animal-fat';

interface LocalizedOil {
  id: string;
  icon: string;
  category: string;
  smokePointF: number;
  smokePointC: number;
  stabilityScore: number;
  primaryFat: string;
  aldehydeRisk: string;
  name: string;
  categoryLabel: string;
  bestFor: string;
  healthVerdict: string;
  warning: string;
}

const localizedOils: LocalizedOil[] = rawData.oils.map((o) => {
  const tr = (o.i18n as Record<string, any>)[lang] || o.i18n.en;
  return {
    id: o.id,
    icon: o.icon,
    category: o.category,
    smokePointF: o.smokePointF,
    smokePointC: o.smokePointC,
    stabilityScore: o.stabilityScore,
    primaryFat: o.primaryFat,
    aldehydeRisk: o.aldehydeRisk,
    name: tr.name,
    categoryLabel: tr.categoryLabel,
    bestFor: tr.bestFor,
    healthVerdict: tr.healthVerdict,
    warning: tr.warning
  };
});

const faqs = (rawData.faqs as Record<string, Array<{ question: string; answer: string }>>)[lang] || rawData.faqs.en;

const UI = {
  en: {
    searchPlaceholder: "Search 28 cooking oils (e.g. olive, avocado, ghee, tallow, coconut)...",
    filterAll: "All Oils & Fats",
    filterHigh: "High-Heat Searing (450°F+)",
    filterMed: "Medium Frying (350°–449°F)",
    filterLow: "Low-Heat / Raw (<350°F)",
    filterAnimal: "Animal Fats & Butters",
    tempF: "°F Fahrenheit",
    tempC: "°C Celsius",
    showingCount: "Showing {visible} of {total} cooking oils",
    clearSearch: "Clear",
    resetFilters: "Reset All Filters",
    smokePointLabel: "Smoke Point:",
    stabilityLabel: "Oxidative Stability:",
    fatProfileLabel: "Fat Profile:",
    bestForLabel: "Best Culinary Uses:",
