    faqsTitle: "Frequently Asked Scientific Questions About Cooking Oils & Smoke Points",
    relatedToolsTitle: "Related Kitchen Temperature & Safety Utilities",
    methodologyNote: "Smoke points and lipid degradation kinetics derived from Codex Alimentarius (CXS 210-1999), peer-reviewed chromatography trials (De Alzaa et al., 2018), and European Commission Regulation (EU) 2019/343 frying oil limits."
  },
  es: {
    searchPlaceholder: "Buscar entre 28 aceites (ej. oliva, aguacate, ghee, sebo, coco)...",
    filterAll: "Todos los Aceites y Grasas",
