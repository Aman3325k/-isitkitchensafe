      { label: "生食・ドレッシング", tempF: 72, tempC: 22 },
      { label: "弱火ソテー", tempF: 275, tempC: 135 },
      { label: "中火フライパン炒め", tempF: 350, tempC: 177 },
      { label: "天ぷら・揚げ物", tempF: 375, tempC: 190 },
      { label: "強火中華炒め", tempF: 425, tempC: 218 },
      { label: "ステーキ強火焼き", tempF: 500, tempC: 260 }
    ],
    emptyTitle: "一致する食用油が見つかりませんでした",
