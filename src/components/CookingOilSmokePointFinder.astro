    verdictLabel: "Scientific Health Verdict:",
    warningLabel: "Kitchen Caution:",
    simTitle: "Interactive Cooking Heat & Searing Threshold Checker",
    simDesc: "Select your target cooking heat to instantly see which oils stay below their smoke point and which are in danger of breaking down into toxic acrolein fumes:",
    simSafeBadge: "SAFE TO COOK",
    simWarningBadge: "PAST SMOKE POINT — BREAKDOWN RISK",
    heatPresets: [
      { label: "Raw / Salad", tempF: 72, tempC: 22 },
      { label: "Low Sauté", tempF: 275, tempC: 135 },
      { label: "Pan-Frying", tempF: 350, tempC: 177 },
      { label: "Deep-Frying", tempF: 375, tempC: 190 },
      { label: "Wok Stir-Fry", tempF: 425, tempC: 218 },
      { label: "Steak Searing", tempF: 500, tempC: 260 }
    ],
