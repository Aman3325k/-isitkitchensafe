    controlsSub: "流下液膜式蒸発器沸騰温度、真空絶対圧力、コンプレッサー飽和温度上昇度、正浸透水透過フラックス、連続原料供給量を設定します。",
    systemLabel: "ハイブリッドシステム装置構成＆蒸発器選定：",
    systemHelp: "商用連続 FO-MVR スキッド、無菌乳清タンパク質濃縮機、高真空香気成分保持濃縮機、クリーンルーム中試検証スキッドを選択。",
    matrixLabel: "原料液体基質＆初期固形分濃度：",
    matrixHelp: "スイート/酸性乳清透過液、コールドプレス柑橘果汁、スペシャルティコールドブリューコーヒー、生菌プロバイオティクス培養液を選択。",
    membraneLabel: "正浸透膜＆駆動溶液ケミストリー：",
    membraneHelp: "熱分解型炭酸水素アンモニウム駆動溶質、食品グレード硫酸マグネシウム電解質、アクアポリン模倣ナノ複合膜、従来型真空釜（危険対照）を選択。",
    compressorLabel: "MVR 蒸気再圧縮エンジン＆ブロワー型式：",
    compressorHelp: "高速遠心ターボ蒸気圧縮機、二軸容積式サニタリーコンプレッサー、多段ターボファン列、非圧縮生スチーム直噴管（危険対照）を選択。",
    tempLabel: "蒸発器沸騰運転温度 (T_evap)：",
    tempHelp: "流下液膜管束内の沸騰温度（38.0〜75.0 °C）。低温維持によりタンパク質熱変性やメイラード焦げ付きを根絶します。",
    pressureLabel: "蒸発器真空絶対圧力 (P_abs)：",
    pressureHelp: "チャンバー運転絶対圧（0.10〜0.90 bar）。沸騰飽和温度を厳密に制御し熱劣化を抑制します。",
    liftLabel: "コンプレッサー飽和温度上昇幅 (ΔT_lift)：",
    liftHelp: "再圧縮二次蒸気の沸騰液に対する温度上昇（3.0〜15.0 °C）。伝熱駆動力と消費電力を決定づけます。",
    fluxLabel: "正浸透膜水透過フラックス (J_w)：",
    fluxHelp: "正浸透脱水フラックス（5.0〜45.0 LMH）。非加圧前濃縮速度と必要膜面積を支配します。",
    feedRateLabel: "連続原料供給流量 (Q_feed)：",
    feedRateHelp: "濃縮スキッドへ供給される原料液の連続体積流量（200〜12,000 L/h）。",
    presetsTitle: "産業用 FO-MVR クイックプロセスプリセット：",
    presetDairy: "乳清タンパク質＆乳糖脱水濃縮 (固形分 65%, SEC 13.8 kWh/t, タンパク質変性ゼロ)",
    presetCitrus: "コールドプレス柑橘香気成分保持濃縮 (65°Brix, テルペン類 99.7% 残存)",
    presetCoffee: "アラビカ種水出しコーヒー非加熱濃縮 (55°Brix, 焦げ付きオフノートゼロ)",
    presetProbiotic: "生プロバイオティクス生菌＆組換え酵素濃縮 (42°C, 活性 CFU 99.4% 維持)",
    presetHazard: "従来型高温ボイラースチーム真空蒸発釜 (過熱焦げ付き・品質破壊ハザード)",
    diagnosticTitle: "リアルタイム FO-MVR エネルギー遠隔計測＆濃縮物理学",
    diagnosticSub: "比消費電力量 (SEC)、最終濃縮度、清澄凝縮水蒸発速度、香気成分残存率、天然タンパク質溶解度、COP、ASME/3-A 適合性をリアルタイム算出。",
    secLabel: "単位水蒸発あたり消費電力量 (SEC):",
    targetBrixLabel: "濃縮液全固形分濃度 (°Brix / TS):",
    evapRateLabel: "連続クリーン凝縮水蒸発回収速度:",
    aromaRetentionLabel: "熱感受性天然アロマ香気残存率:",
    proteinRetentionLabel: "天然可溶性タンパク質保持比率:",
    copLabel: "熱力学性能係数 (COP_th):",
    carbonReductionLabel: "化石燃料ボイラー比 CO2 排出削減率:",
    statusLabel: "ASME 圧力容器＆ 3-A 衛生規格ステータス:",
    diagramTitle: "正浸透＆機械式蒸気再圧縮連成連続フロー系統図",
    diagramSub: "原料液投入、正浸透脱水モジュール、希薄駆動液加熱器、MVR 流下液膜カランドリア、高速遠心蒸気コンプレッサー、高純度蒸留凝縮水回収を可視化。",
    scienceTitle: "FO-MVR の科学的基礎＆熱力学的エネルギー統合",
    scienceSub: "浸透圧駆動力、濃度分極現象 (ECP/ICP)、機械式蒸気再圧縮の熱力学エンタルピーサイクル、潜熱循環理論の包括的解説。",
    tableTitle: "商用システム設計仕様＆典型原料物理特性比較一覧"
  }
};

const d = DICT[lang] || DICT.en;
---

<div class="bg-surface border border-hairline rounded-3xl p-6 sm:p-8 lg:p-10 shadow-sm max-w-7xl mx-auto mb-10">
  <!-- Header / Badge -->
  <div class="flex flex-wrap items-center justify-between gap-3 mb-6 border-b border-hairline/80 pb-6">
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-teal-950 text-teal-200 border border-teal-800">
      <span class="w-2 h-2 rounded-full bg-teal-400 animate-pulse"></span>
      {d.badge}
    </div>
    <div class="flex items-center gap-3 text-xs text-muted font-mono">
      <span>ASME Sec VIII Div 1 &amp; 2</span>
      <span>•</span>
      <span>3-A Standards 60-01 &amp; 45-03</span>
      <span>•</span>
      <span>EHEDG Class I Aseptic</span>
      <span>•</span>
      <span>OSHA 1910.95 Noise Control</span>
    </div>
  </div>

  <div class="mb-8">
    <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-ink tracking-tight mb-3">
      {d.title}
    </h1>
    <p class="text-body text-sm sm:text-base max-w-5xl leading-relaxed text-muted">
      {d.subtitle}
    </p>
  </div>

  <!-- Industrial Presets Bar -->
  <div class="mb-8 bg-surface-soft border border-hairline rounded-2xl p-4 sm:p-5">
    <div class="text-xs font-bold uppercase tracking-wider text-muted mb-3 flex items-center gap-2">
      <svg class="w-4 h-4 text-teal-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
      </svg>
      {d.presetsTitle}
    </div>
    <div class="flex flex-wrap gap-2">
      <button 
        type="button" 
        data-preset="dairy" 
        class="preset-btn px-3.5 py-2 text-xs font-medium rounded-xl bg-surface border border-hairline hover:border-teal-500 hover:text-teal-600 dark:hover:text-teal-400 transition-colors shadow-2xs"
      >
        {d.presetDairy}
      </button>
      <button 
        type="button" 
        data-preset="citrus" 
        class="preset-btn px-3.5 py-2 text-xs font-medium rounded-xl bg-surface border border-hairline hover:border-teal-500 hover:text-teal-600 dark:hover:text-teal-400 transition-colors shadow-2xs"
      >
        {d.presetCitrus}
      </button>
      <button 
        type="button" 
        data-preset="coffee" 
        class="preset-btn px-3.5 py-2 text-xs font-medium rounded-xl bg-surface border border-hairline hover:border-teal-500 hover:text-teal-600 dark:hover:text-teal-400 transition-colors shadow-2xs"
      >
        {d.presetCoffee}
      </button>
      <button 
        type="button" 
        data-preset="probiotic" 
        class="preset-btn px-3.5 py-2 text-xs font-medium rounded-xl bg-surface border border-hairline hover:border-teal-500 hover:text-teal-600 dark:hover:text-teal-400 transition-colors shadow-2xs"
      >
        {d.presetProbiotic}
      </button>
      <button 
        type="button" 
        data-preset="hazard" 
        class="preset-btn px-3.5 py-2 text-xs font-medium rounded-xl bg-red-950/20 text-red-600 dark:text-red-400 border border-red-800/40 hover:bg-red-950/40 transition-colors shadow-2xs"
      >
        {d.presetHazard}
      </button>
    </div>
  </div>

  <!-- Interactive Controls & Process Configuration -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-10">
    <!-- Controls Column -->
    <div class="lg:col-span-6 space-y-5 bg-surface-soft/60 border border-hairline rounded-2xl p-5 sm:p-6">
      <div class="border-b border-hairline pb-3">
        <h2 class="text-base font-bold text-ink flex items-center gap-2">
          <svg class="w-4 h-4 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/>
          </svg>
          {d.controlsTitle}
        </h2>
        <p class="text-xs text-muted mt-1">{d.controlsSub}</p>
      </div>

      <!-- Skid Select -->
      <div>
        <label for="fo-system-select" class="block text-xs font-semibold text-ink mb-1">
          {d.systemLabel}
        </label>
        <select id="fo-system-select" class="w-full text-xs font-medium rounded-xl bg-surface border border-hairline p-2.5 text-ink focus:ring-2 focus:ring-teal-500">
          {foMvrData.systemArchitectures.map((sys) => (
            <option value={sys.id}>{sys.name}</option>
          ))}
        </select>
        <p class="text-2xs text-muted mt-1">{d.systemHelp}</p>
      </div>

      <!-- Feedstock Matrix Select -->
      <div>
        <label for="fo-matrix-select" class="block text-xs font-semibold text-ink mb-1">
          {d.matrixLabel}
        </label>
        <select id="fo-matrix-select" class="w-full text-xs font-medium rounded-xl bg-surface border border-hairline p-2.5 text-ink focus:ring-2 focus:ring-teal-500">
          {foMvrData.feedMatrices.map((mat) => (
            <option value={mat.id}>{mat.name}</option>
          ))}
        </select>
        <p class="text-2xs text-muted mt-1">{d.matrixHelp}</p>
      </div>

      <!-- Membrane & Draw Select -->
      <div>
        <label for="fo-membrane-select" class="block text-xs font-semibold text-ink mb-1">
          {d.membraneLabel}
        </label>
        <select id="fo-membrane-select" class="w-full text-xs font-medium rounded-xl bg-surface border border-hairline p-2.5 text-ink focus:ring-2 focus:ring-teal-500">
          {foMvrData.membraneDrawSolutes.map((mem) => (
            <option value={mem.id}>{mem.name}</option>
          ))}
        </select>
        <p class="text-2xs text-muted mt-1">{d.membraneHelp}</p>
      </div>

      <!-- Compressor Select -->
      <div>
        <label for="fo-compressor-select" class="block text-xs font-semibold text-ink mb-1">
          {d.compressorLabel}
        </label>
        <select id="fo-compressor-select" class="w-full text-xs font-medium rounded-xl bg-surface border border-hairline p-2.5 text-ink focus:ring-2 focus:ring-teal-500">
          {foMvrData.mvrCompressorStages.map((comp) => (
            <option value={comp.id}>{comp.name}</option>
          ))}
        </select>
        <p class="text-2xs text-muted mt-1">{d.compressorHelp}</p>
      </div>

      <!-- Sliders Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
        <!-- Evaporation Temp -->
        <div>
          <div class="flex justify-between text-xs font-semibold text-ink mb-1">
            <span>{d.tempLabel}</span>
            <span id="temp-val" class="font-mono text-teal-600 dark:text-teal-400">52.0 °C</span>
          </div>
          <input 
            type="range" 
            id="temp-slider" 
            min="38.0" 
            max="75.0" 
            step="0.5" 
            value="52.0" 
            class="w-full h-1.5 bg-hairline rounded-lg appearance-none cursor-pointer accent-teal-600"
          />
          <p class="text-2xs text-muted mt-1">{d.tempHelp}</p>
        </div>

        <!-- Evaporator Vacuum -->
        <div>
          <div class="flex justify-between text-xs font-semibold text-ink mb-1">
            <span>{d.pressureLabel}</span>
            <span id="pressure-val" class="font-mono text-teal-600 dark:text-teal-400">0.28 bar</span>
          </div>
          <input 
            type="range" 
            id="pressure-slider" 
            min="0.10" 
            max="0.85" 
            step="0.01" 
            value="0.28" 
            class="w-full h-1.5 bg-hairline rounded-lg appearance-none cursor-pointer accent-teal-600"
          />
          <p class="text-2xs text-muted mt-1">{d.pressureHelp}</p>
        </div>

        <!-- Temp Lift -->
        <div>
          <div class="flex justify-between text-xs font-semibold text-ink mb-1">
            <span>{d.liftLabel}</span>
            <span id="lift-val" class="font-mono text-teal-600 dark:text-teal-400">7.5 °C</span>
          </div>
          <input 
            type="range" 
            id="lift-slider" 
            min="3.0" 
            max="15.0" 
            step="0.5" 
            value="7.5" 
            class="w-full h-1.5 bg-hairline rounded-lg appearance-none cursor-pointer accent-teal-600"
          />
          <p class="text-2xs text-muted mt-1">{d.liftHelp}</p>
        </div>

        <!-- FO Flux -->
        <div>
          <div class="flex justify-between text-xs font-semibold text-ink mb-1">
            <span>{d.fluxLabel}</span>
            <span id="flux-val" class="font-mono text-teal-600 dark:text-teal-400">22.0 LMH</span>
          </div>
          <input 
            type="range" 
            id="flux-slider" 
            min="5.0" 
            max="45.0" 
            step="1.0" 
            value="22.0" 
            class="w-full h-1.5 bg-hairline rounded-lg appearance-none cursor-pointer accent-teal-600"
          />
          <p class="text-2xs text-muted mt-1">{d.fluxHelp}</p>
        </div>

        <!-- Feed Rate -->
        <div class="sm:col-span-2">
          <div class="flex justify-between text-xs font-semibold text-ink mb-1">
            <span>{d.feedRateLabel}</span>
            <span id="feed-val" class="font-mono text-teal-600 dark:text-teal-400">3,500 L/h</span>
          </div>
          <input 
            type="range" 
            id="feed-slider" 
            min="200" 
            max="12000" 
            step="100" 
            value="3500" 
            class="w-full h-1.5 bg-hairline rounded-lg appearance-none cursor-pointer accent-teal-600"
          />
          <p class="text-2xs text-muted mt-1">{d.feedRateHelp}</p>
        </div>
      </div>
    </div>

    <!-- Diagnostic Telemetry Output -->
    <div class="lg:col-span-6 flex flex-col justify-between space-y-4">
      <div class="bg-surface-soft/60 border border-hairline rounded-2xl p-5 sm:p-6 h-full flex flex-col justify-between">
        <div>
          <div class="border-b border-hairline pb-3 mb-4">
            <h2 class="text-base font-bold text-ink flex items-center gap-2">
              <svg class="w-4 h-4 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
              </svg>
              {d.diagnosticTitle}
            </h2>
            <p class="text-xs text-muted mt-1">{d.diagnosticSub}</p>
          </div>

          <div class="grid grid-cols-2 gap-3.5">
            <!-- SEC Energy Card -->
            <div class="bg-surface border border-hairline rounded-xl p-3 shadow-2xs">
              <span class="block text-2xs text-muted uppercase font-semibold">{d.secLabel}</span>
              <span id="telemetry-sec" class="text-lg font-bold font-mono text-teal-600 dark:text-teal-400">13.8 kWh/t</span>
              <span class="block text-2xs text-muted mt-0.5">Electrical SEC (t H2O)</span>
            </div>

            <!-- Concentrated Brix Card -->
            <div class="bg-surface border border-hairline rounded-xl p-3 shadow-2xs">
              <span class="block text-2xs text-muted uppercase font-semibold">{d.targetBrixLabel}</span>
              <span id="telemetry-brix" class="text-lg font-bold font-mono text-emerald-600 dark:text-emerald-400">65.0° Brix</span>
              <span class="block text-2xs text-muted mt-0.5">Final Concentration</span>
            </div>

            <!-- Evaporation Rate Card -->
            <div class="bg-surface border border-hairline rounded-xl p-3 shadow-2xs">
              <span class="block text-2xs text-muted uppercase font-semibold">{d.evapRateLabel}</span>
              <span id="telemetry-evap" class="text-lg font-bold font-mono text-ink">3,176 kg/h</span>
              <span class="block text-2xs text-muted mt-0.5">Clean Distillate Output</span>
            </div>

            <!-- Aroma Retention Card -->
            <div class="bg-surface border border-hairline rounded-xl p-3 shadow-2xs">
              <span class="block text-2xs text-muted uppercase font-semibold">{d.aromaRetentionLabel}</span>
              <span id="telemetry-aroma" class="text-lg font-bold font-mono text-cyan-600 dark:text-cyan-400">99.4%</span>
              <span class="block text-2xs text-muted mt-0.5">Volatiles &amp; Terpenes</span>
            </div>

            <!-- Protein Soluble Fraction Card -->
            <div class="bg-surface border border-hairline rounded-xl p-3 shadow-2xs">
              <span class="block text-2xs text-muted uppercase font-semibold">{d.proteinRetentionLabel}</span>
              <span id="telemetry-protein" class="text-lg font-bold font-mono text-indigo-600 dark:text-indigo-400">99.1%</span>
              <span class="block text-2xs text-muted mt-0.5">Native Soluble Protein</span>
            </div>

            <!-- COP Card -->
            <div class="bg-surface border border-hairline rounded-xl p-3 shadow-2xs">
              <span class="block text-2xs text-muted uppercase font-semibold">{d.copLabel}</span>
              <span id="telemetry-cop" class="text-lg font-bold font-mono text-teal-600 dark:text-teal-400">32.5 COP</span>
              <span class="block text-2xs text-muted mt-0.5">Thermodynamic Multiplier</span>
            </div>
          </div>
        </div>

        <!-- Compliance & Status Banner -->
        <div class="mt-4 pt-4 border-t border-hairline">
          <div class="flex items-center justify-between text-xs mb-1">
            <span class="font-semibold text-ink">{d.carbonReductionLabel}</span>
            <span id="telemetry-carbon" class="font-mono font-bold text-emerald-600 dark:text-emerald-400">-88.5% CO2e</span>
          </div>
          <div class="w-full bg-hairline rounded-full h-2 mb-3 overflow-hidden">
            <div id="telemetry-carbon-bar" class="bg-emerald-500 h-2 rounded-full transition-all duration-300" style="width: 88.5%"></div>
          </div>

          <div class="flex items-center justify-between text-xs">
            <span class="font-semibold text-ink">{d.statusLabel}</span>
            <span id="telemetry-status" class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-2xs font-bold uppercase tracking-wider bg-emerald-950 text-emerald-300 border border-emerald-800">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
              ASME VIII &bull; 3-A 60-01 PASS
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Interactive SVG Schematic Diagram -->
  <div class="mb-10 bg-surface-soft/80 border border-hairline rounded-2xl p-6 sm:p-8">
    <div class="mb-6">
      <h3 class="text-lg font-bold text-ink tracking-tight flex items-center gap-2">
        <svg class="w-5 h-5 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
        </svg>
        {d.diagramTitle}
      </h3>
      <p class="text-xs text-muted mt-1">{d.diagramSub}</p>
    </div>

    <div class="w-full overflow-x-auto">
      <svg class="w-full min-w-[760px] h-[320px]" viewBox="0 0 880 340" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Background Grid -->
        <defs>
          <pattern id="fo-grid" width="20" height="20" patternUnits="userSpaceOnUse">
            <path d="M 20 0 L 0 0 0 20" fill="none" stroke="currentColor" class="text-hairline/40" stroke-width="0.5"/>
          </pattern>
          <linearGradient id="vaporGrad" x1="0%" y1="100%" x2="0%" y2="0%">
            <stop offset="0%" stop-color="#14b8a6" stop-opacity="0.3"/>
            <stop offset="100%" stop-color="#0d9488" stop-opacity="0.8"/>
          </linearGradient>
          <linearGradient id="recompGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#06b6d4"/>
            <stop offset="100%" stop-color="#0284c7"/>
          </linearGradient>
        </defs>
        <rect width="880" height="340" fill="url(#fo-grid)" rx="16"/>

        <!-- 1. Feed Storage Tank -->
        <rect x="30" y="100" width="85" height="150" rx="8" class="fill-surface stroke-hairline" stroke-width="2"/>
        <path d="M 30 115 Q 72.5 105 115 115 L 115 240 Q 72.5 250 30 240 Z" fill="#3b82f6" fill-opacity="0.15"/>
