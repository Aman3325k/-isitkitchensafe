<script>
  function initFoMvrSimulator() {
    // Select elements
    const systemSelect = document.getElementById('fo-system-select') as HTMLSelectElement | null;
    const matrixSelect = document.getElementById('fo-matrix-select') as HTMLSelectElement | null;
    const membraneSelect = document.getElementById('fo-membrane-select') as HTMLSelectElement | null;
    const compressorSelect = document.getElementById('fo-compressor-select') as HTMLSelectElement | null;

    // Sliders
    const tempSlider = document.getElementById('temp-slider') as HTMLInputElement | null;
    const pressureSlider = document.getElementById('pressure-slider') as HTMLInputElement | null;
    const liftSlider = document.getElementById('lift-slider') as HTMLInputElement | null;
    const fluxSlider = document.getElementById('flux-slider') as HTMLInputElement | null;
    const feedSlider = document.getElementById('feed-slider') as HTMLInputElement | null;

    // Value Labels
    const tempVal = document.getElementById('temp-val');
    const pressureVal = document.getElementById('pressure-val');
    const liftVal = document.getElementById('lift-val');
    const fluxVal = document.getElementById('flux-val');
    const feedVal = document.getElementById('feed-val');

    // Telemetry Outputs
    const telemetrySec = document.getElementById('telemetry-sec');
    const telemetryBrix = document.getElementById('telemetry-brix');
    const telemetryEvap = document.getElementById('telemetry-evap');
    const telemetryAroma = document.getElementById('telemetry-aroma');
    const telemetryProtein = document.getElementById('telemetry-protein');
    const telemetryCop = document.getElementById('telemetry-cop');
    const telemetryCarbon = document.getElementById('telemetry-carbon');
    const telemetryCarbonBar = document.getElementById('telemetry-carbon-bar');
    const telemetryStatus = document.getElementById('telemetry-status');

    if (!tempSlider || !pressureSlider || !liftSlider || !fluxSlider || !feedSlider) {
      return;
    }

    function calculatePhysics() {
      const temp = parseFloat(tempSlider?.value || '52.0');
      const pressure = parseFloat(pressureSlider?.value || '0.28');
      const lift = parseFloat(liftSlider?.value || '7.5');
      const flux = parseFloat(fluxSlider?.value || '22.0');
      const feed = parseFloat(feedSlider?.value || '3500');

      if (tempVal) tempVal.textContent = `${temp.toFixed(1)} °C`;
      if (pressureVal) pressureVal.textContent = `${pressure.toFixed(2)} bar`;
      if (liftVal) liftVal.textContent = `${lift.toFixed(1)} °C`;
      if (fluxVal) fluxVal.textContent = `${flux.toFixed(1)} LMH`;
      if (feedVal) feedVal.textContent = `${feed.toLocaleString()} L/h`;

      const isHazardCompressor = compressorSelect?.value === 'uncompressed_live_steam_sparger';
      const isHazardMembrane = membraneSelect?.value === 'conventional_high_heat_vacuum_pan';

      // Specific electrical energy consumption (SEC in kWh / ton H2O)
      let sec = 0;
      let cop = 0;
      let aromaRetention = 0;
      let proteinSoluble = 0;
      let carbonReduction = 0;

      if (isHazardCompressor || isHazardMembrane) {
        sec = 650.0 + (temp * 1.8);
        cop = 1.2;
        aromaRetention = Math.max(35.0, 60.0 - (temp - 50) * 1.2);
        proteinSoluble = Math.max(40.0, 65.0 - (temp - 50) * 1.5);
        carbonReduction = -12.0;
      } else {
        // MVR thermodynamic compression energy: W_comp = (c_p * T_1 / η_is) * ((P2/P1)^((k-1)/k) - 1)
        // With latent heat recovery, SEC is around 11 to 22 kWh/ton
        const baseSec = 10.5 + (lift * 0.72) + (pressure * 3.8);
        const membraneFactor = membraneSelect?.value === 'biomimetic_aquaporin_nanocomposite' ? 0.92 : 1.0;
        sec = Math.min(28.0, Math.max(9.5, baseSec * membraneFactor));

        // COP = ΔH_latent / W_electrical
        cop = Math.min(42.0, Math.max(16.0, 2400.0 / (sec * 3.6)));

        // Aroma & volatile retention: favored by lower temp (< 50°C) and FO preservation
        aromaRetention = Math.min(99.9, Math.max(88.0, 100.2 - (temp - 40) * 0.22));

        // Native protein retention: degrades rapidly if temp > 62°C
        if (temp <= 58.0) {
          proteinSoluble = Math.min(99.8, Math.max(98.0, 99.9 - (temp - 40) * 0.05));
        } else {
          proteinSoluble = Math.max(72.0, 98.0 - (temp - 58.0) * 2.1);
        }

        carbonReduction = Math.min(94.0, Math.max(75.0, 92.0 - (sec - 10.0) * 0.8));
      }

      // Initial vs Final Brix concentration
      let initialBrix = 6.0;
      if (matrixSelect?.value === 'sweet_acid_dairy_whey') initialBrix = 6.0;
      else if (matrixSelect?.value === 'cold_pressed_citrus_juice') initialBrix = 10.5;
      else if (matrixSelect?.value === 'specialty_cold_brew_coffee_extract') initialBrix = 4.5;
      else if (matrixSelect?.value === 'probiotic_microbial_biomass_broth') initialBrix = 3.2;
      else if (matrixSelect?.value === 'upcycled_spent_grain_pea_permeate') initialBrix = 8.0;

      // Target Brix achieved
      let targetBrix = 65.0;
      if (isHazardMembrane) {
        targetBrix = Math.min(50.0, initialBrix * 4.0);
      } else {
        if (matrixSelect?.value === 'specialty_cold_brew_coffee_extract') targetBrix = 55.0;
        else if (matrixSelect?.value === 'probiotic_microbial_biomass_broth') targetBrix = 42.0;
        else if (matrixSelect?.value === 'upcycled_spent_grain_pea_permeate') targetBrix = 60.0;
        else targetBrix = 65.0;
      }

      // Water evaporation rate: Q_evap = Q_feed * (1 - initialBrix / targetBrix)
      const evapRatio = Math.max(0.1, 1 - (initialBrix / targetBrix));
      const evapRateKg = Math.round(feed * evapRatio);

      // Render Telemetry
      if (telemetrySec) telemetrySec.textContent = `${sec.toFixed(1)} kWh/t`;
      if (telemetryBrix) telemetryBrix.textContent = `${targetBrix.toFixed(1)}° Brix`;
      if (telemetryEvap) telemetryEvap.textContent = `${evapRateKg.toLocaleString()} kg/h`;
      if (telemetryAroma) telemetryAroma.textContent = `${aromaRetention.toFixed(1)}%`;
      if (telemetryProtein) telemetryProtein.textContent = `${proteinSoluble.toFixed(1)}%`;
      if (telemetryCop) telemetryCop.textContent = `${cop.toFixed(1)} COP`;

      if (telemetryCarbon) {
        telemetryCarbon.textContent = carbonReduction > 0 ? `-${carbonReduction.toFixed(1)}% CO2e` : `+${Math.abs(carbonReduction).toFixed(1)}% CO2e`;
      }
      if (telemetryCarbonBar) {
        telemetryCarbonBar.style.width = `${Math.max(5, Math.min(100, carbonReduction))}%`;
        telemetryCarbonBar.className = carbonReduction > 50 
          ? 'bg-emerald-500 h-2 rounded-full transition-all duration-300' 
          : 'bg-red-500 h-2 rounded-full transition-all duration-300';
      }

      if (telemetryStatus) {
        if (isHazardCompressor || isHazardMembrane || temp > 72.0) {
          telemetryStatus.className = 'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-2xs font-bold uppercase tracking-wider bg-red-950 text-red-300 border border-red-800';
          telemetryStatus.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-red-400 animate-ping"></span> ASME / 3-A WARNING: HIGH TEMP / FOSSIL STEAM';
        } else {
          telemetryStatus.className = 'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-2xs font-bold uppercase tracking-wider bg-emerald-950 text-emerald-300 border border-emerald-800';
          telemetryStatus.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> ASME VIII &bull; 3-A 60-01 PASS';
        }
      }
    }

    // Presets handler
    document.querySelectorAll('.preset-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const preset = target.getAttribute('data-preset');

        if (preset === 'dairy') {
          if (systemSelect) systemSelect.value = 'aseptic_dairy_whey_fo_mvr_concentrator';
          if (matrixSelect) matrixSelect.value = 'sweet_acid_dairy_whey';
          if (membraneSelect) membraneSelect.value = 'food_grade_polyvalent_electrolyte';
          if (compressorSelect) compressorSelect.value = 'high_speed_centrifugal_turbocompressor';
          tempSlider.value = '50.0';
          pressureSlider.value = '0.24';
          liftSlider.value = '7.5';
          fluxSlider.value = '24.0';
          feedSlider.value = '5000';
        } else if (preset === 'citrus') {
          if (systemSelect) systemSelect.value = 'citrus_botanical_essence_preserver_skid';
          if (matrixSelect) matrixSelect.value = 'cold_pressed_citrus_juice';
          if (membraneSelect) membraneSelect.value = 'biomimetic_aquaporin_nanocomposite';
          if (compressorSelect) compressorSelect.value = 'high_speed_centrifugal_turbocompressor';
          tempSlider.value = '42.0';
          pressureSlider.value = '0.18';
          liftSlider.value = '6.5';
          fluxSlider.value = '28.0';
          feedSlider.value = '3500';
        } else if (preset === 'coffee') {
          if (systemSelect) systemSelect.value = 'citrus_botanical_essence_preserver_skid';
          if (matrixSelect) matrixSelect.value = 'specialty_cold_brew_coffee_extract';
          if (membraneSelect) membraneSelect.value = 'thermolytic_ammonium_bicarbonate';
          if (compressorSelect) compressorSelect.value = 'twin_screw_positive_displacement_compressor';
          tempSlider.value = '44.0';
          pressureSlider.value = '0.20';
          liftSlider.value = '8.0';
          fluxSlider.value = '20.0';
          feedSlider.value = '2200';
        } else if (preset === 'probiotic') {
          if (systemSelect) systemSelect.value = 'cleanroom_modular_pilot_fo_mvr_skid';
          if (matrixSelect) matrixSelect.value = 'probiotic_microbial_biomass_broth';
          if (membraneSelect) membraneSelect.value = 'biomimetic_aquaporin_nanocomposite';
          if (compressorSelect) compressorSelect.value = 'high_speed_centrifugal_turbocompressor';
          tempSlider.value = '40.0';
          pressureSlider.value = '0.15';
          liftSlider.value = '6.0';
          fluxSlider.value = '18.0';
          feedSlider.value = '1200';
        } else if (preset === 'hazard') {
          if (membraneSelect) membraneSelect.value = 'conventional_high_heat_vacuum_pan';
          if (compressorSelect) compressorSelect.value = 'uncompressed_live_steam_sparger';
          tempSlider.value = '74.0';
          pressureSlider.value = '0.80';
          liftSlider.value = '14.0';
          fluxSlider.value = '8.0';
          feedSlider.value = '3500';
        }

        calculatePhysics();
      });
    });

    // Listeners for sliders and selects
    [tempSlider, pressureSlider, liftSlider, fluxSlider, feedSlider].forEach((slider) => {
      slider.addEventListener('input', calculatePhysics);
    });

    [systemSelect, matrixSelect, membraneSelect, compressorSelect].forEach((select) => {
      select?.addEventListener('change', calculatePhysics);
    });

    // Initial calculation run
    calculatePhysics();
  }

  // Run on page load & Astro client navigation
  document.addEventListener('DOMContentLoaded', initFoMvrSimulator);
  if (document.readyState === 'interactive' || document.readyState === 'complete') {
    initFoMvrSimulator();
  }
</script>
