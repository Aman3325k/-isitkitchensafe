const prefix = lang === 'en' ? '' : `/${lang}`;
---

<div class="toxicity-calculator max-w-5xl mx-auto space-y-8" data-lang={lang}>
  <!-- Quick Presets -->
  <div class="bg-surface-soft border border-hairline rounded-2xl p-6">
    <div class="flex items-center gap-2 mb-3">
      <span class="w-2.5 h-2.5 rounded-full bg-rose-600 animate-pulse"></span>
      <h3 class="text-xs font-bold uppercase tracking-wider text-muted">
        {d.presetsHeading}
      </h3>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
      <button type="button" class="preset-btn text-left p-3 rounded-xl bg-canvas hover:bg-surface-strong border border-hairline/70 transition-colors text-xs font-medium text-ink flex items-center gap-2" data-mat="ptfe-traditional" data-cond="severe-flaking" data-temp="extreme-heat" data-acid="neutral" data-dur="standard">
        <span>{d.preset1}</span>
      </button>
      <button type="button" class="preset-btn text-left p-3 rounded-xl bg-canvas hover:bg-surface-strong border border-hairline/70 transition-colors text-xs font-medium text-ink flex items-center gap-2" data-mat="uncoated-aluminum" data-cond="minor-scratches" data-temp="low-simmer" data-acid="strongly-acidic" data-dur="long-simmer">
        <span>{d.preset2}</span>
      </button>
      <button type="button" class="preset-btn text-left p-3 rounded-xl bg-canvas hover:bg-surface-strong border border-hairline/70 transition-colors text-xs font-medium text-ink flex items-center gap-2" data-mat="lead-glazed-ceramic" data-cond="moderate-wear" data-temp="low-simmer" data-acid="mildly-acidic" data-dur="standard">
        <span>{d.preset3}</span>
      </button>
      <button type="button" class="preset-btn text-left p-3 rounded-xl bg-canvas hover:bg-surface-strong border border-hairline/70 transition-colors text-xs font-medium text-ink flex items-center gap-2" data-mat="plastic-polypropylene" data-cond="moderate-wear" data-temp="low-simmer" data-acid="strongly-acidic" data-dur="quick">
        <span>{d.preset4}</span>
      </button>
    </div>
  </div>

  <!-- Interactive Controls Form Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 bg-surface-soft border border-hairline rounded-3xl p-6 md:p-8 shadow-xs">
    <!-- Factor 1: Material Selection -->
    <div class="space-y-2">
      <label for="material-select" class="block text-xs font-bold uppercase tracking-wider text-ink flex items-center gap-1.5">
        <span class="w-5 h-5 rounded-full bg-ink text-white flex items-center justify-center text-[10px]">1</span>
        {d.selectMaterial}
      </label>
      <select id="material-select" class="w-full py-3 px-4 rounded-xl bg-canvas border border-hairline text-ink text-sm focus:outline-none focus:ring-2 focus:ring-ink font-medium">
        {toxicData.materials.map(m => (
          <option value={m.id}>{m.name}</option>
        ))}
      </select>
      <p id="material-chem-note" class="text-xs text-muted leading-relaxed pl-1"></p>
    </div>

    <!-- Factor 2: Condition / Wear -->
    <div class="space-y-2">
      <label for="condition-select" class="block text-xs font-bold uppercase tracking-wider text-ink flex items-center gap-1.5">
        <span class="w-5 h-5 rounded-full bg-ink text-white flex items-center justify-center text-[10px]">2</span>
        {d.selectCondition}
      </label>
      <select id="condition-select" class="w-full py-3 px-4 rounded-xl bg-canvas border border-hairline text-ink text-sm focus:outline-none focus:ring-2 focus:ring-ink font-medium">
        {toxicData.conditions.map(c => (
          <option value={c.id}>{c.label}</option>
        ))}
      </select>
      <p id="condition-desc-note" class="text-xs text-muted leading-relaxed pl-1"></p>
    </div>

    <!-- Factor 3: Cooking Temperature -->
    <div class="space-y-2">
      <label for="temp-select" class="block text-xs font-bold uppercase tracking-wider text-ink flex items-center gap-1.5">
        <span class="w-5 h-5 rounded-full bg-ink text-white flex items-center justify-center text-[10px]">3</span>
        {d.selectTemp}
      </label>
      <select id="temp-select" class="w-full py-3 px-4 rounded-xl bg-canvas border border-hairline text-ink text-sm focus:outline-none focus:ring-2 focus:ring-ink font-medium">
        {toxicData.temperatures.map(t => (
          <option value={t.id}>{t.label}</option>
        ))}
      </select>
      <p id="temp-desc-note" class="text-xs text-muted leading-relaxed pl-1"></p>
    </div>

    <!-- Factor 4: Food Acidity -->
    <div class="space-y-2">
      <label for="acid-select" class="block text-xs font-bold uppercase tracking-wider text-ink flex items-center gap-1.5">
        <span class="w-5 h-5 rounded-full bg-ink text-white flex items-center justify-center text-[10px]">4</span>
        {d.selectAcid}
      </label>
      <select id="acid-select" class="w-full py-3 px-4 rounded-xl bg-canvas border border-hairline text-ink text-sm focus:outline-none focus:ring-2 focus:ring-ink font-medium">
        {toxicData.acidities.map(a => (
          <option value={a.id}>{a.label}</option>
        ))}
      </select>
      <p id="acid-desc-note" class="text-xs text-muted leading-relaxed pl-1"></p>
    </div>

    <!-- Factor 5: Duration -->
    <div class="space-y-2 md:col-span-2">
      <label for="duration-select" class="block text-xs font-bold uppercase tracking-wider text-ink flex items-center gap-1.5">
        <span class="w-5 h-5 rounded-full bg-ink text-white flex items-center justify-center text-[10px]">5</span>
        {d.selectDuration}
      </label>
      <select id="duration-select" class="w-full py-3 px-4 rounded-xl bg-canvas border border-hairline text-ink text-sm focus:outline-none focus:ring-2 focus:ring-ink font-medium">
        {toxicData.durations.map(dur => (
          <option value={dur.id}>{dur.label}</option>
        ))}
      </select>
      <p id="duration-desc-note" class="text-xs text-muted leading-relaxed pl-1"></p>
    </div>
  </div>

  <!-- Output Dashboard: Live Risk Scorecard -->
  <div id="scorecard-output" class="rounded-3xl border-2 transition-all p-7 md:p-10 space-y-8 bg-canvas">
    <!-- Top Bar: Dial & Verdict Tier -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 border-b border-hairline pb-8">
      <div class="space-y-2">
        <span class="text-xs font-bold uppercase tracking-wider text-muted block">
          {d.scoreHeading}
        </span>
        <div class="flex items-baseline gap-3">
          <span id="risk-score-value" class="text-5xl md:text-6xl font-black tracking-tight font-mono">0</span>
          <span class="text-sm font-semibold text-muted">{d.scoreOf100}</span>
        </div>
        <div class="w-full md:w-64 h-3 rounded-full bg-surface-soft overflow-hidden border border-hairline">
          <div id="risk-meter-bar" class="h-full rounded-full transition-all duration-500 w-0 bg-emerald-600"></div>
        </div>
      </div>

      <div class="md:text-right space-y-2 max-w-md">
        <span id="risk-tier-badge" class="inline-block px-4 py-1.5 rounded-full text-xs font-black uppercase tracking-wider text-white bg-emerald-600 shadow-xs">
          {d.tierMinimal}
        </span>
        <p id="risk-tier-description" class="text-xs md:text-sm text-body leading-relaxed">
          {d.tierMinimalDesc}
        </p>
      </div>
    </div>

    <!-- Multiplier Factor Callout -->
    <div id="multiplier-banner" class="p-4 rounded-xl bg-surface-soft border border-hairline flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
      <span class="font-bold text-ink flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-amber-500"></span>
        {d.leachMultiplierLabel}
      </span>
      <span id="multiplier-value" class="font-mono font-bold text-ink px-2.5 py-1 rounded-md bg-canvas border border-hairline text-sm">
        1.0x baseline
      </span>
    </div>

    <!-- Deep-Dive Breakdown Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Card A: Toxins at Risk -->
      <div class="p-6 rounded-2xl bg-surface-soft border border-hairline space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-rose-600 flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
          </svg>
          {d.toxinsHeading}
        </h4>
        <ul id="toxins-list" class="space-y-1.5 text-xs text-ink font-medium list-disc list-inside"></ul>
      </div>

      <!-- Card B: Health Impact -->
      <div class="p-6 rounded-2xl bg-surface-soft border border-hairline space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-ink flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
          {d.healthHeading}
        </h4>
        <p id="health-risk-text" class="text-xs text-body leading-relaxed"></p>
      </div>

      <!-- Card C: Thermal Threshold & Prohibitions -->
      <div class="p-6 rounded-2xl bg-surface-soft border border-hairline space-y-3">
        <div class="flex items-center justify-between">
          <h4 class="text-xs font-bold uppercase tracking-wider text-ink">
            {d.thresholdHeading}
          </h4>
          <span id="temp-ceiling-badge" class="px-2.5 py-0.5 rounded font-mono font-bold text-xs bg-rose-100 dark:bg-rose-950 text-rose-700 dark:text-rose-300"></span>
        </div>
        <div>
          <span class="text-[11px] font-bold text-muted uppercase tracking-wider block mb-1">{d.neverHeading}</span>
          <p id="prohibitions-text" class="text-xs text-rose-700 dark:text-rose-400 font-medium leading-relaxed"></p>
        </div>
      </div>

      <!-- Card D: Safer Alternatives & Validated Use -->
      <div class="p-6 rounded-2xl bg-surface-soft border border-hairline space-y-3">
        <div>
          <span class="text-[11px] font-bold text-emerald-700 dark:text-emerald-400 uppercase tracking-wider block mb-1">{d.altHeading}</span>
          <p id="safer-alt-text" class="text-xs font-semibold text-ink leading-relaxed"></p>
        </div>
        <div class="pt-2 border-t border-hairline/60">
          <span class="text-[11px] font-bold text-muted uppercase tracking-wider block mb-1">{d.bestHeading}</span>
          <p id="best-use-text" class="text-xs text-body leading-relaxed"></p>
        </div>
      </div>
    </div>

    <!-- Peer-Reviewed Scientific Authority -->
    <div class="p-5 rounded-2xl bg-canvas border border-hairline/80 space-y-2">
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
        </svg>
        <span class="text-[11px] font-bold uppercase tracking-wider text-muted">
          {d.citationHeading}
        </span>
      </div>
      <p id="citation-text" class="text-xs font-mono text-muted leading-relaxed"></p>
    </div>

    <!-- Actions: Copy Diagnostic Lab Report -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-4 border-t border-hairline">
      <button id="copy-report-btn" type="button" class="w-full sm:w-auto py-3 px-6 rounded-xl bg-ink hover:bg-black text-white font-medium text-xs transition-colors shadow-xs flex items-center justify-center gap-2">
        <span>{d.copyReportBtn}</span>
      </button>
      <span id="copied-toast" class="text-xs font-bold text-emerald-600 hidden">
        {d.copiedNotice}
      </span>
    </div>
  </div>

  <!-- Regulatory Standards Reference Section -->
  <div class="border-t border-hairline pt-10 space-y-4">
    <h3 class="text-title-md font-medium text-ink tracking-tight">
      {d.standardsTitle}
    </h3>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {toxicData.regulatoryStandards.map(std => (
        <div class="p-4 rounded-xl bg-surface-soft border border-hairline space-y-1.5">
          <span class="text-[11px] font-mono font-bold text-rose-600 block">{std.code}</span>
          <h4 class="text-xs font-semibold text-ink">{std.title}</h4>
          <p class="text-[11px] text-body">{std.threshold}</p>
          <span class="text-[10px] text-muted block pt-1">{std.agency}</span>
        </div>
      ))}
    </div>
  </div>

  <!-- Cross-Links to Other Safety Tools -->
  <div class="p-6 rounded-2xl bg-surface-soft border border-hairline space-y-3">
    <h4 class="text-xs font-bold uppercase tracking-wider text-muted">
      {d.crossLinkTools}
    </h4>
    <div class="flex flex-wrap gap-2 text-xs">
      <a href={`${prefix}/tools/pan-scratch-inspector/`} class="px-3 py-1.5 rounded-lg bg-canvas hover:bg-surface-strong border border-hairline text-ink transition-colors">
        🔍 {d.crossLinkPanInspector} &rarr;
      </a>
      <a href={`${prefix}/tools/cookware-brand-transparency-index/`} class="px-3 py-1.5 rounded-lg bg-canvas hover:bg-surface-strong border border-hairline text-ink transition-colors">
        🛡️ {d.crossLinkBrandIndex} &rarr;
      </a>
      <a href={`${prefix}/tools/kitchen-hazard-emergency-triage/`} class="px-3 py-1.5 rounded-lg bg-canvas hover:bg-surface-strong border border-hairline text-ink transition-colors">
        🚨 {d.crossLinkEmergency} &rarr;
      </a>
      <a href={`${prefix}/tools/product-recalls-scanner/`} class="px-3 py-1.5 rounded-lg bg-canvas hover:bg-surface-strong border border-hairline text-ink transition-colors">
        📷 {d.crossLinkRecalls} &rarr;
      </a>
      <a href={`${prefix}/tools/material-swap-calculator/`} class="px-3 py-1.5 rounded-lg bg-canvas hover:bg-surface-strong border border-hairline text-ink transition-colors">
        🔄 {lang === 'ja' ? '素材乗り換え計算機' : lang === 'zh-cn' ? '厨具材质替换计算器' : lang === 'pt' ? 'Calculadora de Troca Segura' : lang === 'es' ? 'Calculadora de Sustitución Segura' : 'Material Swap Calculator'} &rarr;
      </a>
    </div>
  </div>
</div>

<script is:inline define:vars={{ toxicData, d, lang }}>
  (function() {
    const matSelect = document.getElementById('material-select');
    const condSelect = document.getElementById('condition-select');
    const tempSelect = document.getElementById('temp-select');
    const acidSelect = document.getElementById('acid-select');
    const durSelect = document.getElementById('duration-select');

    const scoreVal = document.getElementById('risk-score-value');
    const meterBar = document.getElementById('risk-meter-bar');
    const tierBadge = document.getElementById('risk-tier-badge');
    const tierDesc = document.getElementById('risk-tier-description');
    const multVal = document.getElementById('multiplier-value');
    const toxinsList = document.getElementById('toxins-list');
    const healthText = document.getElementById('health-risk-text');
    const tempBadge = document.getElementById('temp-ceiling-badge');
    const prohibitionsText = document.getElementById('prohibitions-text');
    const saferAltText = document.getElementById('safer-alt-text');
    const bestUseText = document.getElementById('best-use-text');
    const citationText = document.getElementById('citation-text');
    const matNote = document.getElementById('material-chem-note');
    const condNote = document.getElementById('condition-desc-note');
    const tempNote = document.getElementById('temp-desc-note');
    const acidNote = document.getElementById('acid-desc-note');
    const durNote = document.getElementById('duration-desc-note');

    const copyBtn = document.getElementById('copy-report-btn');
    const copiedToast = document.getElementById('copied-toast');
    const scorecardBox = document.getElementById('scorecard-output');

    if (!matSelect || !condSelect || !tempSelect || !acidSelect || !durSelect) return;

    function recalculate() {
      const matId = matSelect.value;
      const condId = condSelect.value;
      const tempId = tempSelect.value;
      const acidId = acidSelect.value;
      const durId = durSelect.value;

      const mat = toxicData.materials.find(m => m.id === matId) || toxicData.materials[0];
      const cond = toxicData.conditions.find(c => c.id === condId) || toxicData.conditions[0];
      const temp = toxicData.temperatures.find(t => t.id === tempId) || toxicData.temperatures[0];
      const acid = toxicData.acidities.find(a => a.id === acidId) || toxicData.acidities[0];
      const dur = toxicData.durations.find(d => d.id === durId) || toxicData.durations[0];

      // Update explanatory sub-notes
      if (matNote) matNote.textContent = mat.coatings;
      if (condNote) condNote.textContent = cond.description;
      if (tempNote) tempNote.textContent = temp.description;
      if (acidNote) acidNote.textContent = acid.description;
      if (durNote) durNote.textContent = dur.description;

      // Calculate Total Multiplier
      const accelerationFactor = (cond.leachMultiplier * temp.tempMultiplier * acid.acidMultiplier * dur.durationMultiplier);
      if (multVal) {
        multVal.textContent = accelerationFactor.toFixed(1) + 'x baseline';
      }

      // Material-specific chemical modifiers
      let matSpecialMod = 1.0;
      if (mat.id === 'uncoated-aluminum' && acid.id === 'strongly-acidic') {
        matSpecialMod = 1.5; // aluminum vigorously dissolves in acid
      } else if (mat.id === 'lead-glazed-ceramic' && (acid.id === 'strongly-acidic' || temp.id === 'low-simmer')) {
        matSpecialMod = 1.6; // acid/heat accelerates lead dissolution
      } else if (mat.id === 'melamine-resin' && (temp.id === 'high-heat' || temp.id === 'extreme-heat' || dur.id === 'long-simmer')) {
        matSpecialMod = 1.8; // depolymerization of melamine
      } else if (mat.id === 'ptfe-traditional' && (temp.id === 'extreme-heat' || cond.id === 'severe-flaking')) {
        matSpecialMod = 1.7; // rapid pyrolysis / microplastic detachment
      } else if (mat.id === 'stainless-steel-304' && acid.id !== 'strongly-acidic') {
        matSpecialMod = 0.5; // highly passivated inert surface
      }

      // Compute Raw Score: (baseRisk + riskAddition) * (accelerationFactor / 2.5) * matSpecialMod
      const baseWeighted = mat.baseRisk + cond.riskAddition;
      const normalizedFactor = 0.5 + (accelerationFactor * 0.45);
      let calculatedScore = Math.round(baseWeighted * normalizedFactor * matSpecialMod);
      calculatedScore = Math.max(3, Math.min(100, calculatedScore));

      if (scoreVal) scoreVal.textContent = calculatedScore.toString();
      if (meterBar) meterBar.style.width = calculatedScore + '%';

      // Update Tier Styling
      let tierTitle = d.tierMinimal;
      let tierExpl = d.tierMinimalDesc;
      let tierColorClass = 'bg-emerald-600 text-white';
      let barColor = 'bg-emerald-600';
      let boxBorder = 'border-emerald-500/40';

      if (calculatedScore >= 76) {
        tierTitle = d.tierCritical;
        tierExpl = d.tierCriticalDesc;
        tierColorClass = 'bg-rose-600 text-white';
        barColor = 'bg-rose-600';
        boxBorder = 'border-rose-500/60';
      } else if (calculatedScore >= 46) {
        tierTitle = d.tierElevated;
        tierExpl = d.tierElevatedDesc;
        tierColorClass = 'bg-amber-600 text-white';
        barColor = 'bg-amber-600';
        boxBorder = 'border-amber-500/50';
      } else if (calculatedScore >= 21) {
        tierTitle = d.tierLow;
        tierExpl = d.tierLowDesc;
        tierColorClass = 'bg-blue-600 text-white';
        barColor = 'bg-blue-600';
        boxBorder = 'border-blue-500/40';
      }

      if (tierBadge) {
        tierBadge.textContent = tierTitle;
        tierBadge.className = 'inline-block px-4 py-1.5 rounded-full text-xs font-black uppercase tracking-wider shadow-xs ' + tierColorClass;
      }
      if (tierDesc) tierDesc.textContent = tierExpl;
      if (meterBar) {
        meterBar.className = 'h-full rounded-full transition-all duration-500 ' + barColor;
      }
      if (scorecardBox) {
        scorecardBox.className = 'rounded-3xl border-2 transition-all p-7 md:p-10 space-y-8 bg-canvas ' + boxBorder;
      }

      // Update Details Content
      if (toxinsList) {
        toxinsList.innerHTML = mat.primaryToxins.map(t => '<li>' + t + '</li>').join('');
      }
      if (healthText) healthText.textContent = mat.healthRisks;
      if (tempBadge) tempBadge.textContent = mat.heatThresholdC + '°C (' + mat.heatThresholdF + '°F)';
      if (prohibitionsText) prohibitionsText.textContent = mat.neverUseFor;
      if (saferAltText) saferAltText.textContent = mat.saferAlternative;
      if (bestUseText) bestUseText.textContent = mat.bestFor;
      if (citationText) citationText.textContent = mat.scientificCitation;
    }

    [matSelect, condSelect, tempSelect, acidSelect, durSelect].forEach(el => {
      el.addEventListener('change', recalculate);
    });

    // Preset button handlers
    document.querySelectorAll('.preset-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const mat = btn.getAttribute('data-mat');
        const cond = btn.getAttribute('data-cond');
        const temp = btn.getAttribute('data-temp');
        const acid = btn.getAttribute('data-acid');
        const dur = btn.getAttribute('data-dur');

        if (mat) matSelect.value = mat;
        if (cond) condSelect.value = cond;
        if (temp) tempSelect.value = temp;
        if (acid) acidSelect.value = acid;
        if (dur) durSelect.value = dur;

        recalculate();
        scorecardBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });
    });

    // Copy Report handler
    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        const mat = toxicData.materials.find(m => m.id === matSelect.value);
        const cond = toxicData.conditions.find(c => c.id === condSelect.value);
        const temp = toxicData.temperatures.find(t => t.id === tempSelect.value);
        const acid = toxicData.acidities.find(a => a.id === acidSelect.value);
        const dur = toxicData.durations.find(d => d.id === durSelect.value);

        const report = [
          "==================================================",
          "ISITKITCHENSAFE TOXIC LEACHING & PFAS RISK REPORT",
          "==================================================",
          "Vessel / Cookware: " + (mat ? mat.name : matSelect.value),
          "Surface Condition: " + (cond ? cond.label : condSelect.value),
          "Cooking Heat:      " + (temp ? temp.label : tempSelect.value),
          "Food Acidity:      " + (acid ? acid.label : acidSelect.value),
          "Duration:          " + (dur ? dur.label : durSelect.value),
          "--------------------------------------------------",
          "Calculated Risk Score: " + scoreVal.textContent + " / 100",
          "Risk Tier:             " + tierBadge.textContent,
          "Leaching Acceleration: " + multVal.textContent,
          "--------------------------------------------------",
          "Primary Toxins: " + (mat ? mat.primaryToxins.join(', ') : ''),
          "Health Hazard:  " + (mat ? mat.healthRisks : ''),
          "Safe Threshold: Max " + (mat ? mat.heatThresholdC + '°C / ' + mat.heatThresholdF + '°F' : ''),
          "Strict Prohibitions: " + (mat ? mat.neverUseFor : ''),
          "Safer Alternative:   " + (mat ? mat.saferAlternative : ''),
          "Scientific Citation: " + (mat ? mat.scientificCitation : ''),
          "==================================================",
          "Generated at: https://isitkitchensafe.com/tools/toxic-leaching-scorecard/"
        ].join("\n");

        if (navigator.clipboard) {
          navigator.clipboard.writeText(report).then(() => {
            if (copiedToast) {
              copiedToast.classList.remove('hidden');
              setTimeout(() => copiedToast.classList.add('hidden'), 3500);
            }
          });
        }
      });
    }

    recalculate();
  })();
</script>
