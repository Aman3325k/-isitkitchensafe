const d = DICT[lang] || DICT.en;
const materials = shockData.materials;
const contactSurfaces = shockData.contactSurfaces;
const tempPresets = shockData.tempPresets;
---

<div class="bg-surface-soft border border-hairline rounded-3xl p-6 md:p-10 shadow-sm" id="thermal-shock-root">
  <!-- Header Badge -->
  <div class="flex items-center gap-2 mb-3">
    <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-indigo-600 text-white">
      {d.badge}
    </span>
    <span class="text-xs text-muted font-mono">ASTM C149 &bull; ISO 3585</span>
  </div>

  <h2 class="text-title-lg md:text-display-sm font-medium text-ink tracking-tight mb-3">
    {d.title}
  </h2>
  <p class="text-body text-sm md:text-base leading-relaxed mb-8 max-w-3xl">
    {d.subtitle}
  </p>

  <!-- Interactive Controls Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-10">
    <!-- Left Column: Inputs & Sliders (7 cols) -->
    <div class="lg:col-span-7 space-y-7">
      <!-- Step 1: Material Selection -->
      <div>
        <label class="block text-sm font-semibold text-ink mb-2">
          {d.step1}
        </label>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" id="material-selector-grid">
          {materials.map((m, idx) => (
            <button
              type="button"
              data-material-id={m.id}
              class={`text-left p-3.5 rounded-2xl border transition-all text-sm flex flex-col justify-between material-btn ${
                idx === 0 
                  ? 'border-indigo-600 bg-indigo-50/50 dark:bg-indigo-950/20 ring-2 ring-indigo-500/20' 
                  : 'border-hairline bg-surface hover:border-hairline-strong'
              }`}
            >
              <div>
                <div class="font-medium text-ink flex items-center justify-between mb-1">
                  <span>{m.name}</span>
                  <span class="text-[11px] font-mono px-2 py-0.5 rounded-full bg-surface-soft text-muted border border-hairline">
                    α={m.cte}
                  </span>
                </div>
                <div class="text-[12px] text-muted line-clamp-1">
                  {m.tradeNames}
                </div>
              </div>
              <div class="mt-2 text-[11px] font-medium text-indigo-600 dark:text-indigo-400">
                Safe ΔT: ≤{m.maxSafeDeltaTC}°C ({m.maxSafeDeltaTF}°F)
              </div>
            </button>
          ))}
        </div>
      </div>

      <!-- Step 2: Cookware Temperature Slider -->
      <div>
        <div class="flex items-center justify-between mb-2">
          <label for="temp-slider" class="text-sm font-semibold text-ink">
            {d.step2}
          </label>
          <div class="flex items-center gap-2">
            <span class="text-xs text-muted font-medium" id="unit-label">Units: °C</span>
            <button 
              type="button" 
              id="unit-toggle-btn"
              class="text-xs font-semibold px-2.5 py-1 rounded-lg border border-hairline bg-surface hover:bg-surface-soft text-ink transition-colors"
            >
              °C / °F
            </button>
          </div>
        </div>

        <!-- Temperature Presets -->
        <div class="flex flex-wrap gap-1.5 mb-3">
          {tempPresets.map(preset => (
            <button
              type="button"
              data-preset-c={preset.tempC}
              class="text-xs px-2.5 py-1 rounded-lg border border-hairline bg-surface hover:bg-surface-soft text-body transition-colors preset-btn"
            >
              {preset.label} ({preset.tempC}°C)
            </button>
          ))}
        </div>

        <div class="p-4 rounded-2xl bg-surface border border-hairline space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-xs text-muted">Range: -20°C (-4°F) to 260°C (500°F)</span>
            <span class="text-lg font-bold font-mono text-ink" id="current-temp-display">200°C (392°F)</span>
          </div>
          <input 
            type="range" 
            id="temp-slider" 
            min="-20" 
            max="260" 
            value="200" 
            step="5"
            class="w-full accent-indigo-600 h-2 bg-surface-soft rounded-lg cursor-pointer"
          />
        </div>
      </div>

      <!-- Step 3: Quench / Contact Surface -->
      <div>
        <label class="block text-sm font-semibold text-ink mb-2">
          {d.step3}
        </label>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" id="surface-selector-grid">
          {contactSurfaces.map((s, idx) => (
            <button
              type="button"
              data-surface-id={s.id}
              class={`text-left p-3.5 rounded-2xl border transition-all text-sm flex flex-col justify-between surface-btn ${
                idx === 2 
                  ? 'border-indigo-600 bg-indigo-50/50 dark:bg-indigo-950/20 ring-2 ring-indigo-500/20' 
                  : 'border-hairline bg-surface hover:border-hairline-strong'
              }`}
            >
              <div>
                <div class="font-medium text-ink flex items-center justify-between mb-1">
                  <span>{s.name}</span>
                </div>
                <div class="text-[12px] text-muted line-clamp-2">
                  {s.description}
                </div>
              </div>
              <div class="mt-2 text-[11px] font-mono text-muted">
                Temp: {s.tempC}°C ({s.tempF}°F)
              </div>
            </button>
          ))}
        </div>
      </div>
    </div>

    <!-- Right Column: Visualizer & Live Physics Diagnostics (5 cols) -->
    <div class="lg:col-span-5 space-y-6 flex flex-col justify-between">
      <!-- Visual Vessel SVG & Stress Fracture Display -->
      <div class="p-6 rounded-2xl bg-surface border border-hairline shadow-sm flex flex-col items-center justify-center relative overflow-hidden" id="visualizer-box">
        <div class="w-full flex items-center justify-between text-xs text-muted mb-4">
          <span class="font-medium uppercase tracking-wider">{d.liveSimTitle}</span>
          <span class="font-mono text-xs px-2 py-0.5 rounded-full bg-surface-soft" id="acoustic-badge">75 dB</span>
        </div>

        <!-- Dynamic Cookware SVG Canvas -->
        <div class="w-full max-w-[280px] h-[180px] relative flex items-center justify-center my-2">
          <svg viewBox="0 0 300 200" class="w-full h-full overflow-visible" id="cookware-svg">
            <defs>
              <!-- Dynamic Linear Gradient: Hot Rim to Cold Base -->
              <linearGradient id="thermal-gradient" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" id="grad-top" stop-color="#ef4444" />
                <stop offset="70%" id="grad-mid" stop-color="#f97316" />
                <stop offset="100%" id="grad-bot" stop-color="#3b82f6" />
              </linearGradient>

              <!-- Shockwave blast filter -->
              <filter id="glow-danger" x="-20%" y="-20%" width="140%" height="140%">
                <feGaussianBlur stdDeviation="4" result="blur" />
                <feComposite in="SourceGraphic" in2="blur" operator="over" />
              </filter>
            </defs>

            <!-- Countertop / Quench Surface Base Line -->
            <rect x="20" y="150" width="260" height="20" rx="4" id="svg-countertop" fill="#94a3b8" opacity="0.3" />
            <text x="150" y="164" text-anchor="middle" font-size="10" fill="#64748b" id="svg-countertop-text">Cold Granite (18°C)</text>

            <!-- Cookware Vessel Profile (Casserole Dish) -->
            <path 
              id="svg-vessel"
              d="M 50 70 L 65 140 Q 70 148 85 148 L 215 148 Q 230 148 235 140 L 250 70 Q 255 60 240 60 L 60 60 Q 45 60 50 70 Z" 
              fill="url(#thermal-gradient)"
              stroke="#cbd5e1"
              stroke-width="3"
              class="transition-all duration-300"
            />

            <!-- Handles -->
            <path id="svg-handle-l" d="M 50 75 Q 30 75 30 90 Q 30 105 52 105" fill="none" stroke="#94a3b8" stroke-width="4" stroke-linecap="round" />
            <path id="svg-handle-r" d="M 250 75 Q 270 75 270 90 Q 270 105 248 105" fill="none" stroke="#94a3b8" stroke-width="4" stroke-linecap="round" />

            <!-- Dynamic Crack Pattern Lines (Revealed under stress) -->
            <g id="svg-crack-group" class="opacity-0 transition-opacity duration-300">
              <path d="M 150 148 L 140 115 L 115 100 L 90 75" fill="none" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" filter="url(#glow-danger)" />
              <path d="M 140 115 L 165 95 L 195 85 L 230 65" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" />
              <path d="M 165 95 L 175 130 L 205 148" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" />
              <path d="M 115 100 L 80 120 L 70 142" fill="none" stroke="#ffffff" stroke-width="1.8" stroke-linecap="round" />
              
              <!-- Detonation Projectile Shards -->
              <g id="svg-shards" class="hidden">
                <polygon points="120,40 135,30 130,50" fill="#ffffff" stroke="#ef4444" stroke-width="1" />
                <polygon points="180,35 195,45 175,55" fill="#ffffff" stroke="#ef4444" stroke-width="1" />
                <polygon points="20,110 35,125 15,130" fill="#ffffff" stroke="#ef4444" stroke-width="1" />
                <polygon points="265,115 285,105 275,135" fill="#ffffff" stroke="#ef4444" stroke-width="1" />
              </g>
            </g>
          </svg>
        </div>

        <!-- Live Status Alert Banner -->
        <div id="status-banner" class="w-full p-4 rounded-xl text-center font-bold text-xs md:text-sm tracking-wide mt-2 border transition-all">
          <div id="status-headline" class="mb-1">SAFE</div>
          <div id="status-explanation" class="text-xs font-normal opacity-90 leading-relaxed"></div>
        </div>
      </div>

      <!-- Scientific Diagnostics Cards -->
      <div class="grid grid-cols-2 gap-3 text-center">
        <div class="p-4 rounded-xl bg-surface border border-hairline">
          <div class="text-xs text-muted mb-1">{d.deltaTLabel}</div>
          <div class="text-xl font-bold font-mono text-ink" id="stat-delta-t">182°C (328°F)</div>
        </div>
        <div class="p-4 rounded-xl bg-surface border border-hairline">
          <div class="text-xs text-muted mb-1">{d.stressScoreLabel}</div>
          <div class="text-xl font-bold font-mono text-ink" id="stat-risk-score">96 / 100</div>
        </div>
        <div class="p-4 rounded-xl bg-surface border border-hairline">
          <div class="text-xs text-muted mb-1">{d.estStressLabel}</div>
          <div class="text-sm font-semibold font-mono text-ink" id="stat-tensile-stress">148 MPa (21,460 PSI)</div>
        </div>
        <div class="p-4 rounded-xl bg-surface border border-hairline">
          <div class="text-xs text-muted mb-1">{d.acousticLabel}</div>
          <div class="text-sm font-semibold font-mono text-ink" id="stat-decibels">115 dB (Gunshot report)</div>
        </div>
      </div>

      <!-- Failure Mode Summary Box -->
      <div class="p-4 rounded-xl bg-surface border border-hairline space-y-1">
        <span class="text-xs font-bold uppercase tracking-wider text-muted block">{d.failureModeLabel}:</span>
        <div class="text-xs font-semibold text-ink" id="failure-mode-title">Explosive Detonation (Dice Sharding)</div>
        <p class="text-[12px] text-body leading-relaxed" id="failure-mode-desc"></p>
      </div>
    </div>
  </div>

  <!-- Educational Science & Standards Accordion / Breakdown -->
  <div class="border-t border-hairline pt-8 space-y-8">
    <!-- Prevention Rules -->
    <div>
      <h3 class="text-base font-semibold text-ink mb-4 flex items-center gap-2">
        <span class="w-6 h-6 rounded-full bg-emerald-600 text-white flex items-center justify-center text-xs font-bold">✓</span>
        {d.preventionTitle}
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-xs text-body leading-relaxed">
        <div class="p-3.5 rounded-xl bg-surface border border-hairline flex items-start gap-2.5">
          <span class="font-bold text-ink">01</span>
          <span>{d.prevention1}</span>
        </div>
        <div class="p-3.5 rounded-xl bg-surface border border-hairline flex items-start gap-2.5">
          <span class="font-bold text-ink">02</span>
          <span>{d.prevention2}</span>
        </div>
        <div class="p-3.5 rounded-xl bg-surface border border-hairline flex items-start gap-2.5">
          <span class="font-bold text-ink">03</span>
          <span>{d.prevention3}</span>
        </div>
        <div class="p-3.5 rounded-xl bg-surface border border-hairline flex items-start gap-2.5">
          <span class="font-bold text-ink">04</span>
          <span>{d.prevention4}</span>
        </div>
        <div class="p-3.5 rounded-xl bg-surface border border-hairline flex items-start gap-2.5 md:col-span-2">
          <span class="font-bold text-ink">05</span>
          <span>{d.prevention5}</span>
        </div>
      </div>
    </div>

    <!-- Physics & Formula Deep-Dive -->
    <div class="p-6 rounded-2xl bg-surface border border-hairline space-y-3">
      <h3 class="text-sm font-semibold text-ink flex items-center gap-2">
        <span class="w-5 h-5 rounded-full bg-indigo-600 text-white flex items-center justify-center text-xs font-bold">∑</span>
        {d.physicsExpTitle}
      </h3>
      <div class="font-mono text-xs md:text-sm bg-surface-soft p-3 rounded-lg border border-hairline text-indigo-700 dark:text-indigo-300">
        σ = (E &times; α &times; ΔT) / (1 - ν)
      </div>
      <p class="text-xs text-body leading-relaxed">
        {shockData.physicsModel.description} {shockData.physicsModel.failureCondition}
      </p>
    </div>

    <!-- Cross-links to companion tools -->
    <div class="border-t border-hairline pt-6">
      <div class="text-xs font-bold uppercase tracking-wider text-muted mb-3">
        {d.relatedToolsHeading}
      </div>
      <p class="text-xs text-body mb-4">
        {d.relatedToolsDesc}
      </p>
      <div class="flex flex-wrap gap-2 text-xs">
        <a href={lang === 'en' ? '/tools/viral-trend-debunker/' : `/${lang}/tools/viral-trend-debunker/`} class="px-3 py-1.5 rounded-lg bg-surface border border-hairline hover:border-hairline-strong font-medium text-ink transition-colors">
          &rarr; {d.toolDebunker}
        </a>
        <a href={lang === 'en' ? '/tools/pan-scratch-inspector/' : `/${lang}/tools/pan-scratch-inspector/`} class="px-3 py-1.5 rounded-lg bg-surface border border-hairline hover:border-hairline-strong font-medium text-ink transition-colors">
          &rarr; {d.toolInspector}
        </a>
        <a href={lang === 'en' ? '/tools/toxic-leaching-scorecard/' : `/${lang}/tools/toxic-leaching-scorecard/`} class="px-3 py-1.5 rounded-lg bg-surface border border-hairline hover:border-hairline-strong font-medium text-ink transition-colors">
          &rarr; {d.toolScorecard}
        </a>
        <a href={lang === 'en' ? '/tools/material-swap-calculator/' : `/${lang}/tools/material-swap-calculator/`} class="px-3 py-1.5 rounded-lg bg-surface border border-hairline hover:border-hairline-strong font-medium text-ink transition-colors">
          &rarr; {d.toolSwap}
        </a>
        <a href={lang === 'en' ? '/tools/kitchen-hazard-emergency-triage/' : `/${lang}/tools/kitchen-hazard-emergency-triage/`} class="px-3 py-1.5 rounded-lg bg-surface border border-hairline hover:border-hairline-strong font-medium text-ink transition-colors">
          &rarr; {d.toolEmergency}
        </a>
        <a href={lang === 'en' ? '/tools/product-recalls-scanner/' : `/${lang}/tools/product-recalls-scanner/`} class="px-3 py-1.5 rounded-lg bg-surface border border-hairline hover:border-hairline-strong font-medium text-ink transition-colors">
          &rarr; {d.toolRecalls}
        </a>
        <a href={lang === 'en' ? '/tools/kitchen-energy-carbon-calculator/' : `/${lang}/tools/kitchen-energy-carbon-calculator/`} class="px-3 py-1.5 rounded-lg bg-surface border border-hairline hover:border-hairline-strong font-medium text-ink transition-colors">
          &rarr; Kitchen Energy &amp; Carbon Calculator
        </a>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ shockData, d }}>
  (function() {
    const root = document.getElementById('thermal-shock-root');
    if (!root) return;

    let selectedMaterialId = 'soda-lime-tempered';
    let selectedSurfaceId = 'granite-counter';
    let currentTempC = 200;
    let isFahrenheit = false;

    const materials = shockData.materials;
    const surfaces = shockData.contactSurfaces;

    // Elements
    const materialBtns = root.querySelectorAll('.material-btn');
    const surfaceBtns = root.querySelectorAll('.surface-btn');
    const presetBtns = root.querySelectorAll('.preset-btn');
    const tempSlider = root.getElementById('temp-slider');
    const tempDisplay = root.getElementById('current-temp-display');
    const unitToggleBtn = root.getElementById('unit-toggle-btn');
    const unitLabel = root.getElementById('unit-label');

    // Diagnostic stat elements
    const statDeltaT = root.getElementById('stat-delta-t');
    const statRiskScore = root.getElementById('stat-risk-score');
    const statTensileStress = root.getElementById('stat-tensile-stress');
    const statDecibels = root.getElementById('stat-decibels');
    const acousticBadge = root.getElementById('acoustic-badge');
    const statusBanner = root.getElementById('status-banner');
    const statusHeadline = root.getElementById('status-headline');
    const statusExplanation = root.getElementById('status-explanation');
    const failureModeTitle = root.getElementById('failure-mode-title');
    const failureModeDesc = root.getElementById('failure-mode-desc');

    // SVG elements
    const svgCountertopText = root.getElementById('svg-countertop-text');
    const gradTop = root.getElementById('grad-top');
    const gradBot = root.getElementById('grad-bot');
    const crackGroup = root.getElementById('svg-crack-group');
    const shardsGroup = root.getElementById('svg-shards');

    function cToF(c) {
      return Math.round((c * 9/5) + 32);
    }

    function calculate() {
      const mat = materials.find(m => m.id === selectedMaterialId) || materials[0];
      const surf = surfaces.find(s => s.id === selectedSurfaceId) || surfaces[0];

      const rawDeltaT = Math.abs(currentTempC - surf.tempC);
      const effectiveDeltaT = rawDeltaT * surf.riskMultiplier;

      // Risk score: 0 to 100 based on material critical delta T
      let riskScore = Math.min(100, Math.round((effectiveDeltaT / mat.criticalDeltaTC) * 85));
      if (rawDeltaT > mat.criticalDeltaTC) {
        riskScore = Math.min(100, Math.max(85, riskScore));
      }

      // Tensile Stress σ = (E · α · ΔT) / (1 - ν)
      // E in GPa (10^9), α in 10^-6, resulting in MPa
      const E = mat.youngsModulusGPa;
      const alpha = mat.cte;
      const nu = mat.poissonsRatio;
      const tensileStressMPa = Math.round((E * alpha * rawDeltaT) / (1 - nu));
      const tensileStressPSI = Math.round(tensileStressMPa * 145.038);

      // Render Display Text
      const rawDeltaTF = Math.round(rawDeltaT * 9/5);
      statDeltaT.textContent = isFahrenheit 
        ? `${rawDeltaTF}°F (${rawDeltaT}°C)` 
        : `${rawDeltaT}°C (${rawDeltaTF}°F)`;

      statRiskScore.textContent = `${riskScore} / 100`;
      statTensileStress.textContent = `${tensileStressMPa} MPa (${tensileStressPSI.toLocaleString()} PSI)`;

      failureModeTitle.textContent = mat.shatterMode;
      failureModeDesc.textContent = mat.failurePhysics;

      // Acoustic Profile
      let activeDecibels = Math.min(mat.acousticDecibels, Math.round(mat.acousticDecibels * (riskScore / 80)));
      if (riskScore < 30) activeDecibels = 20;
      statDecibels.textContent = `${activeDecibels} dB (${mat.acousticProfile.split('.')[0]})`;
      acousticBadge.textContent = `${activeDecibels} dB`;

      // SVG Countertop Label
      svgCountertopText.textContent = `${surf.name.split('(')[0].trim()} (${isFahrenheit ? surf.tempF + '°F' : surf.tempC + '°C'})`;

      // SVG Heat Colors
      if (currentTempC > 150) {
        gradTop.setAttribute('stop-color', '#dc2626'); // bright red
      } else if (currentTempC > 80) {
        gradTop.setAttribute('stop-color', '#f97316'); // orange
      } else if (currentTempC > 25) {
        gradTop.setAttribute('stop-color', '#eab308'); // yellow
      } else {
        gradTop.setAttribute('stop-color', '#3b82f6'); // blue
      }

      if (surf.tempC <= 0) {
        gradBot.setAttribute('stop-color', '#1e3a8a'); // deep navy ice
      } else if (surf.tempC <= 20) {
        gradBot.setAttribute('stop-color', '#0284c7'); // sky cold
      } else {
        gradBot.setAttribute('stop-color', '#ea580c'); // warm
      }

      // Status tier banner & Crack rendering
      statusBanner.className = 'w-full p-4 rounded-xl text-center font-bold text-xs md:text-sm tracking-wide mt-2 border transition-all ';
      if (riskScore < 30) {
        // Safe
        statusBanner.classList.add('bg-emerald-50', 'text-emerald-800', 'border-emerald-300', 'dark:bg-emerald-950/40', 'dark:text-emerald-300', 'dark:border-emerald-800');
        statusHeadline.textContent = d.safeStatus;
        statusExplanation.textContent = d.safeStatusDesc;
        crackGroup.classList.add('opacity-0');
        crackGroup.classList.remove('opacity-100');
        shardsGroup.classList.add('hidden');
      } else if (riskScore < 60) {
        // Moderate
        statusBanner.classList.add('bg-amber-50', 'text-amber-800', 'border-amber-300', 'dark:bg-amber-950/40', 'dark:text-amber-300', 'dark:border-amber-800');
        statusHeadline.textContent = d.moderateStatus;
        statusExplanation.textContent = d.moderateStatusDesc;
        crackGroup.classList.remove('opacity-0');
        crackGroup.classList.add('opacity-40');
        shardsGroup.classList.add('hidden');
      } else if (riskScore < 80) {
        // High
        statusBanner.classList.add('bg-orange-50', 'text-orange-900', 'border-orange-400', 'dark:bg-orange-950/40', 'dark:text-orange-300', 'dark:border-orange-800');
        statusHeadline.textContent = d.highStatus;
        statusExplanation.textContent = d.highStatusDesc;
        crackGroup.classList.remove('opacity-0');
        crackGroup.classList.add('opacity-80');
        shardsGroup.classList.add('hidden');
      } else {
        // Critical
        statusBanner.classList.add('bg-red-100', 'text-red-900', 'border-red-500', 'dark:bg-red-950/60', 'dark:text-red-200', 'dark:border-red-700', 'animate-pulse');
        statusHeadline.textContent = d.criticalStatus;
        statusExplanation.textContent = d.criticalStatusDesc;
        crackGroup.classList.remove('opacity-0');
        crackGroup.classList.add('opacity-100');
        shardsGroup.classList.remove('hidden');
      }
    }

    // Event Listeners
    materialBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        materialBtns.forEach(b => {
          b.classList.remove('border-indigo-600', 'bg-indigo-50/50', 'dark:bg-indigo-950/20', 'ring-2', 'ring-indigo-500/20');
          b.classList.add('border-hairline', 'bg-surface');
        });
        btn.classList.add('border-indigo-600', 'bg-indigo-50/50', 'dark:bg-indigo-950/20', 'ring-2', 'ring-indigo-500/20');
        btn.classList.remove('border-hairline', 'bg-surface');
        selectedMaterialId = btn.getAttribute('data-material-id');
        calculate();
      });
    });

    surfaceBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        surfaceBtns.forEach(b => {
          b.classList.remove('border-indigo-600', 'bg-indigo-50/50', 'dark:bg-indigo-950/20', 'ring-2', 'ring-indigo-500/20');
          b.classList.add('border-hairline', 'bg-surface');
        });
        btn.classList.add('border-indigo-600', 'bg-indigo-50/50', 'dark:bg-indigo-950/20', 'ring-2', 'ring-indigo-500/20');
        btn.classList.remove('border-hairline', 'bg-surface');
        selectedSurfaceId = btn.getAttribute('data-surface-id');
        calculate();
      });
    });

    tempSlider.addEventListener('input', (e) => {
      currentTempC = parseInt(e.target.value, 10);
      updateTempDisplay();
      calculate();
    });

    presetBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        currentTempC = parseInt(btn.getAttribute('data-preset-c'), 10);
        tempSlider.value = currentTempC;
        updateTempDisplay();
        calculate();
      });
    });

    unitToggleBtn.addEventListener('click', () => {
      isFahrenheit = !isFahrenheit;
      unitLabel.textContent = isFahrenheit ? 'Units: °F' : 'Units: °C';
      updateTempDisplay();
      calculate();
    });

    function updateTempDisplay() {
      const fVal = cToF(currentTempC);
      tempDisplay.textContent = isFahrenheit 
        ? `${fVal}°F (${currentTempC}°C)` 
        : `${currentTempC}°C (${fVal}°F)`;
    }

    // Initial run
    updateTempDisplay();
    calculate();
  })();
</script>
