    rule2Text: "推进剂喷雾罐含有卵磷脂，在 180°C 烘烤下发生深度聚合形成琥珀色顽固焦油，清洗焦油时的物理摩擦会连带撕烂特氟龙膜层。",
    rule3Title: "3. 家中饲养鹦鹉等宠物鸟类的居所严禁使用特氟龙空气炸锅",
    rule3Text: "鸟类特有的单向气囊呼吸系统对含氟热解气体极其敏感，极低浓度（甚至人无法察觉）即可引发肺出血窒息猝死。",
    rule4Title: "4. 一旦炸篮涂层出现起泡或边缘脱落，必须立即更换",
    rule4Text: "脱落松动的涂层在 3,000 RPM 的高速风道冲刷下，微米级特氟龙碎片会源源不断附着在熟食表面，造成慢性摄入。",
    rule5Title: "5. 启动空气炸锅时务必同步开启大吸力吸油烟机",
    rule5Text: "直排式抽油烟机能将热对流产生的烹饪气溶胶和微粒子彻底抽吸排出室外，室内超细微粒浓度降低 90% 以上。",
    copyReportBtn: "📋 复制诊断遥测数据报告",
    reportCopied: "✓ 遥测数据报告已成功复制到剪贴板！",
    crossLinkTitle: "关联厨房安全评估工具",
    crossLinkAcrylamide: "空气炸锅丙烯酰胺计算器",
    crossLinkOven: "多功能烤箱电热丝安全模拟器",
    crossLinkTox: "厨具毒素析出与 PFAS 评估卡"
  },
  ja: {
    badge: "強制対流空気力学＆高分子毒性学",
    title: "ノンフライヤー テフロンバスケット熱劣化＆微小粒子プルーム解析ツール",
    subtitle: "200℃〜240℃の高速熱風環境下におけるPTFE熱分解挙動、空焚き放射過熱、超微小粒子（UFP）放出、および愛鳥への致命的毒性リスクをシミュレーション。",
    controlsTitle: "空気力学的熱負荷・バスケット基材・摩耗設定",
    controlsSub: "バスケット素材、予熱時の食品熱容量、対流設定温度、表面キズ劣化度、および換気環境を入力してフッ素化合物エアロゾルの飛散を推計。",
    materialLabel: "バスケット基材と表面コーティング",
    materialHelp: "標準PTFEは200℃を超えると熱分解を開始；セラミックゾルゲルや304ステンレスは完全フッ素フリーで無害です。",
    loadLabel: "予熱条件と食品の熱容量バッファ",
    loadHelp: "食品中の水分は熱を吸収します。食品なしの空焚き予熱では発熱ヒーターからの直接放射熱でバスケット温度が250℃以上に達します。",
    tempLabel: "ノンフライヤーの設定温度",
    tempHelp: "マックスクリスプ設定（220℃以上）はPTFEの連続耐熱限界に達し、低分子量のフッ素ガス放出を誘発します。",
    wearLabel: "コーティングのキズ・剥がれ状態",
    wearHelp: "マイクロクラックや剥離片は、風速3,000 RPMの熱風対流によって微粒子化され、食品や室内空気に混入します。",
    oilLabel: "調理油の性状とスプレー油の影響",
    oilHelp: "缶入りスプレー油に含まれるレシチンと噴射剤は高温で頑固なワニス状に重合し、洗浄時にテフロンを剥がす原因になります。",
    ventLabel: "キッチンの換気状態と空気希釈",
    ventHelp: "屋外排気型レンジフードは微粒子を効率的に排出しますが、換気のない閉め切った部屋では有毒ガスが数時間滞留します。",
    presetsTitle: "クイック診断プリセット",
    presetCeramicSafe: "🏆 セラミックゾルゲル/ステンレス（100%無毒・小鳥安全）",
    presetControlledPtfe: "⚖️ 標準PTFE＋食材満載 180℃（標準的な安全使用）",
    presetEmptyPreheat: "🚨 220℃空焚き予熱（放射熱過熱＆超微小粒子プルーム発生）",
    presetFlakingAerosol: "⚠️ 剥離PTFE＋スプレー油（マイクロプラスチック誤飲＆ワニス劣化）",
    presetAvianLethal: "🦜 愛鳥警告：密閉キッチンでの空焚き（小鳥への急性致死リスク）",
    diagnosticTitle: "毒性学＆空気力学リアルタイムテレメトリ",
    diagnosticSub: "NIOSH吸入暴露基準、環境保護庁（EPA）基準、および鳥類特有の呼吸生理学モデルに基づき算出。",
    overallScoreLabel: "空気質＆フッ素ポリマー安全性指数",
    ufpRateLabel: "超微粒子（UFP）放出レート",
    surfaceTempLabel: "バスケット局部最高到達温度",
    avianRiskLabel: "鳥類のポリマー煙熱（フッ素中毒）危険度",
    microplasticLabel: "フッ素樹脂微小剥離片の摂取負荷",
    vaporOutgasLabel: "フッ素系揮発ガス・酸性成分放出",
    varnishRiskLabel: "スプレー油ワニスによるコーティング破壊度",
    alertTitle: "臨床毒性学＆空気環境評価",
    tableTitle: "ノンフライヤーバスケット素材別 熱分解比較表",
    tableSub: "フッ素樹脂、セラミックゾルゲル、ステンレス、耐熱ガラスの技術仕様一覧。",
    colMaterial: "バスケット素材",
    colCoating: "コーティング化学構造",
    colThermalLimit: "連続耐熱限界",
    colPyrolysisTemp: "熱分解開始温度",
    colUfpRate: "基準UFP放出率",
    colAvianStatus: "鳥類に対する安全性",
    protocolsTitle: "ノンフライヤーのフッ素樹脂リスクを防ぐ5大鉄則",
    protocolsSub: "エアロゾル物理学者、獣医毒性学者、家電安全技術者が監修。",
    rule1Title: "1. 180℃以上の高温で空のまま予熱しない",
    rule1Text: "食品の水分による吸熱がない場合、ヒーターの赤外線放射によりバスケット表面は4分以内に240℃を超え、有害微粒子が急激に噴出します。",
    rule2Title: "2. ノンフライヤーに缶入りオイルスプレーを使用しない",
    rule2Text: "スプレー油の大豆レシチンが高温で重合して強固な焦げ膜（ワニス）を形成し、それを擦り落とす際にテフロン被膜を破壊します。",
    rule3Title: "3. テフロン製ノンフライヤー使用エリアに小鳥を近づけない",
    rule3Text: "鳥類の気嚢呼吸系はフッ素ガスに極めて弱く、人間には無症状のわずかな微小粒子でも急性肺水腫を引き起こし短時間で死亡します。",
    rule4Title: "4. 塗装が剥がれたり水ぶくれができたら即座に交換する",
    rule4Text: "剥がれかけたフッ素樹脂は、3,000 RPMの高速対流風により数マイクロメートルの破片となって食材に付着し体内に入ります。",
    rule5Title: "5. 調理中は必ず屋外排気型レンジフードを作動させる",
    rule5Text: "ダクト式レンジフードを回すことで、室内に滞留する超微小粒子濃度を90%以上カットし吸入を防ぐことができます。",
    copyReportBtn: "📋 診断テレメトリ結果をコピー",
    reportCopied: "✓ 診断レポートをクリップボードにコピーしました！",
    crossLinkTitle: "関連する家電安全ツール",
    crossLinkAcrylamide: "エアフライヤー アクリルアミド計算機",
    crossLinkOven: "トースター電熱線安全シミュレーター",
    crossLinkTox: "調理器具有害物質溶出スコアカード"
  }
};

const d = dict[lang] || dict.en;
---

<div class="bg-surface border border-hairline rounded-3xl p-6 md:p-10 shadow-xs mb-12">
  <!-- Component Badge & Header -->
  <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold tracking-wide bg-amber-100 text-amber-900 border border-amber-200">
      <span>💨</span>
      {d.badge}
    </span>
    <span class="text-xs font-mono text-muted">PTFE Thermal Degradation &bull; NIOSH REL</span>
  </div>

  <h2 class="text-2xl md:text-3xl font-bold text-ink tracking-tight mb-2">
    {d.title}
  </h2>
  <p class="text-body text-sm md:text-base leading-relaxed mb-8 max-w-4xl">
    {d.subtitle}
  </p>

  <!-- Interactive Simulator Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-10">
    <!-- Controls Column (5 cols) -->
    <div class="lg:col-span-5 space-y-5 bg-surface-soft p-6 rounded-2xl border border-hairline">
      <div>
        <h3 class="text-base font-bold text-ink mb-1">{d.controlsTitle}</h3>
        <p class="text-xs text-muted leading-relaxed">{d.controlsSub}</p>
      </div>

      <!-- Presets -->
      <div class="space-y-2 pt-2 border-t border-hairline">
        <label class="block text-xs font-bold text-ink uppercase tracking-wider">{d.presetsTitle}</label>
        <div class="grid grid-cols-1 gap-1.5">
          <button type="button" class="preset-fryer-btn text-left px-3 py-2 rounded-xl text-xs font-medium bg-canvas hover:bg-surface border border-hairline transition-colors text-ink" data-preset="ceramic-safe">
            {d.presetCeramicSafe}
          </button>
          <button type="button" class="preset-fryer-btn text-left px-3 py-2 rounded-xl text-xs font-medium bg-canvas hover:bg-surface border border-hairline transition-colors text-ink" data-preset="controlled-ptfe">
            {d.presetControlledPtfe}
          </button>
          <button type="button" class="preset-fryer-btn text-left px-3 py-2 rounded-xl text-xs font-medium bg-canvas hover:bg-surface border border-hairline transition-colors text-ink" data-preset="empty-preheat">
            {d.presetEmptyPreheat}
          </button>
          <button type="button" class="preset-fryer-btn text-left px-3 py-2 rounded-xl text-xs font-medium bg-canvas hover:bg-surface border border-hairline transition-colors text-ink" data-preset="flaking-aerosol">
            {d.presetFlakingAerosol}
          </button>
          <button type="button" class="preset-fryer-btn text-left px-3 py-2 rounded-xl text-xs font-medium bg-red-50 hover:bg-red-100 border border-red-200 transition-colors text-red-900" data-preset="avian-lethal">
            {d.presetAvianLethal}
          </button>
        </div>
      </div>

      <!-- 1. Basket Material Select -->
      <div class="space-y-1.5 pt-2 border-t border-hairline">
        <label for="select-fryer-material" class="block text-xs font-bold text-ink">
          {d.materialLabel}
        </label>
        <select id="select-fryer-material" class="w-full text-xs font-medium p-2.5 rounded-xl border border-hairline bg-canvas text-ink focus:outline-hidden focus:ring-2 focus:ring-amber-500">
          {airFryerData.basketMaterials.map((mat) => (
            <option value={mat.id} selected={mat.id === 'ptfe-standard-coated'}>
              {mat.name}
            </option>
          ))}
        </select>
        <p class="text-[11px] text-muted leading-tight">{d.materialHelp}</p>
      </div>

      <!-- 2. Preheat & Load Condition -->
      <div class="space-y-1.5">
        <label for="select-fryer-load" class="block text-xs font-bold text-ink">
          {d.loadLabel}
        </label>
        <select id="select-fryer-load" class="w-full text-xs font-medium p-2.5 rounded-xl border border-hairline bg-canvas text-ink focus:outline-hidden focus:ring-2 focus:ring-amber-500">
          {airFryerData.preheatAndLoadConditions.map((cond) => (
            <option value={cond.id} selected={cond.id === 'loaded-food-mass'}>
              {cond.name}
            </option>
          ))}
        </select>
        <p class="text-[11px] text-muted leading-tight">{d.loadHelp}</p>
      </div>

      <!-- 3. Air Fryer Temperature Setting -->
      <div class="space-y-1.5">
        <label for="select-fryer-temp" class="block text-xs font-bold text-ink">
          {d.tempLabel}
        </label>
        <select id="select-fryer-temp" class="w-full text-xs font-medium p-2.5 rounded-xl border border-hairline bg-canvas text-ink focus:outline-hidden focus:ring-2 focus:ring-amber-500">
          {airFryerData.temperatureSettings.map((temp) => (
            <option value={temp.id} selected={temp.id === 'temp-200'}>
              {temp.name}
            </option>
          ))}
        </select>
        <p class="text-[11px] text-muted leading-tight">{d.tempHelp}</p>
      </div>

      <!-- 4. Coating Wear State -->
      <div class="space-y-1.5">
        <label for="select-fryer-wear" class="block text-xs font-bold text-ink">
          {d.wearLabel}
        </label>
        <select id="select-fryer-wear" class="w-full text-xs font-medium p-2.5 rounded-xl border border-hairline bg-canvas text-ink focus:outline-hidden focus:ring-2 focus:ring-amber-500">
          {airFryerData.coatingWearStates.map((w) => (
            <option value={w.id} selected={w.id === 'scratched'}>
              {w.name}
            </option>
          ))}
        </select>
        <p class="text-[11px] text-muted leading-tight">{d.wearHelp}</p>
      </div>

      <!-- 5. Cooking Oil Chemistry -->
      <div class="space-y-1.5">
        <label for="select-fryer-oil" class="block text-xs font-bold text-ink">
          {d.oilLabel}
        </label>
        <select id="select-fryer-oil" class="w-full text-xs font-medium p-2.5 rounded-xl border border-hairline bg-canvas text-ink focus:outline-hidden focus:ring-2 focus:ring-amber-500">
          {airFryerData.oilSprayTypes.map((o) => (
            <option value={o.id} selected={o.id === 'pure-liquid-oil'}>
              {o.name}
            </option>
          ))}
        </select>
        <p class="text-[11px] text-muted leading-tight">{d.oilHelp}</p>
      </div>

      <!-- 6. Kitchen Ventilation State -->
      <div class="space-y-1.5">
        <label for="select-fryer-vent" class="block text-xs font-bold text-ink">
          {d.ventLabel}
        </label>
        <select id="select-fryer-vent" class="w-full text-xs font-medium p-2.5 rounded-xl border border-hairline bg-canvas text-ink focus:outline-hidden focus:ring-2 focus:ring-amber-500">
          {airFryerData.ventilationStates.map((v) => (
            <option value={v.id} selected={v.id === 'hood-exhaust'}>
              {v.name}
            </option>
          ))}
        </select>
        <p class="text-[11px] text-muted leading-tight">{d.ventHelp}</p>
      </div>
    </div>

    <!-- Telemetry Display Column (7 cols) -->
    <div class="lg:col-span-7 flex flex-col justify-between space-y-6">
      <div>
        <div class="flex items-center justify-between mb-4">
          <div>
            <h3 class="text-base font-bold text-ink">{d.diagnosticTitle}</h3>
            <p class="text-xs text-muted leading-relaxed">{d.diagnosticSub}</p>
          </div>
          <button 
            type="button" 
            id="btn-copy-fryer-report" 
            class="px-3 py-1.5 rounded-xl bg-canvas hover:bg-surface border border-hairline text-xs font-medium text-ink transition-colors flex items-center gap-1.5 shadow-2xs"
          >
            <span>📋</span>
            <span id="copy-fryer-btn-text">{d.copyReportBtn}</span>
          </button>
        </div>

        <!-- Master Score Card -->
        <div class="p-6 rounded-2xl bg-canvas border border-hairline shadow-xs mb-6 text-center space-y-3">
          <span class="text-xs font-bold text-muted uppercase tracking-wider block">
            {d.overallScoreLabel}
          </span>
          <div class="flex items-baseline justify-center gap-2">
            <span id="val-fryer-score" class="text-5xl md:text-6xl font-black font-mono text-emerald-600 transition-colors">
              92
            </span>
            <span class="text-xl font-bold text-muted font-mono">/ 100</span>
          </div>
          <div class="inline-block">
            <span id="badge-fryer-status" class="px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-100 text-emerald-900 border border-emerald-200">
              SAFE / NEGLIGIBLE OUTGASSING
            </span>
          </div>
        </div>

        <!-- Primary Telemetry 6-Box Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 mb-6">
          <!-- 1. UFP Emission Rate -->
          <div class="p-4 rounded-xl bg-surface-soft border border-hairline space-y-1">
            <span class="text-[11px] font-bold text-muted uppercase tracking-wider block">
              {d.ufpRateLabel}
            </span>
            <div id="val-ufp-rate" class="text-xl font-black font-mono text-ink">
              5,400 <span class="text-xs font-normal text-muted">pt/cm³</span>
            </div>
            <p id="sub-ufp-rate" class="text-[11px] text-emerald-600 font-medium">
              Within residential baseline
            </p>
          </div>

          <!-- 2. Peak Surface Hotspot Temp -->
          <div class="p-4 rounded-xl bg-surface-soft border border-hairline space-y-1">
            <span class="text-[11px] font-bold text-muted uppercase tracking-wider block">
              {d.surfaceTempLabel}
            </span>
            <div id="val-surface-temp" class="text-xl font-black font-mono text-ink">
              176°C <span class="text-xs font-normal text-muted">(349°F)</span>
            </div>
            <p id="sub-surface-temp" class="text-[11px] text-emerald-600 font-medium">
              Below 200°C pyrolysis onset
            </p>
          </div>

          <!-- 3. Avian Hazard Level -->
          <div class="p-4 rounded-xl bg-surface-soft border border-hairline space-y-1">
            <span class="text-[11px] font-bold text-muted uppercase tracking-wider block">
              {d.avianRiskLabel}
            </span>
            <div id="val-avian-risk" class="text-base font-black text-emerald-700">
              Low / Negligible
            </div>
            <p id="sub-avian-risk" class="text-[11px] text-muted">
              Safe with food heat-sink
            </p>
          </div>

          <!-- 4. Microplastic Flake Shedding -->
          <div class="p-4 rounded-xl bg-surface-soft border border-hairline space-y-1">
            <span class="text-[11px] font-bold text-muted uppercase tracking-wider block">
              {d.microplasticLabel}
            </span>
            <div id="val-microplastic-shed" class="text-xl font-black font-mono text-ink">
              27.3 <span class="text-xs font-normal text-muted">ppm</span>
            </div>
            <p id="sub-microplastic-shed" class="text-[11px] text-amber-600 font-medium">
              Surface micro-furrow shedding
            </p>
          </div>

          <!-- 5. Fluorocarbon Outgassing -->
          <div class="p-4 rounded-xl bg-surface-soft border border-hairline space-y-1">
            <span class="text-[11px] font-bold text-muted uppercase tracking-wider block">
              {d.vaporOutgasLabel}
            </span>
            <div id="val-gas-outgas" class="text-base font-black text-emerald-700">
              Trace / Bound
            </div>
            <p id="sub-gas-outgas" class="text-[11px] text-muted">
              Zero toxic carbonyl fluoride
            </p>
          </div>

          <!-- 6. Aerosol Varnish Loss -->
          <div class="p-4 rounded-xl bg-surface-soft border border-hairline space-y-1">
            <span class="text-[11px] font-bold text-muted uppercase tracking-wider block">
              {d.varnishRiskLabel}
            </span>
            <div id="val-varnish-risk" class="text-xl font-black font-mono text-ink">
              15% <span class="text-xs font-normal text-muted">Degradation</span>
            </div>
            <p id="sub-varnish-risk" class="text-[11px] text-emerald-600 font-medium">
              Pure liquid fat; low varnish
            </p>
          </div>
        </div>

        <!-- Dynamic Clinical & Engineering Alert Banner -->
        <div id="banner-fryer-alert" class="p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-950 transition-colors">
          <div class="flex items-start gap-3">
            <span id="fryer-alert-icon" class="text-xl">✅</span>
            <div class="space-y-1">
              <h4 id="fryer-alert-heading" class="text-xs font-bold uppercase tracking-wider text-emerald-900">
                Controlled Food-Contact Convective State
              </h4>
              <p id="fryer-alert-body" class="text-xs text-emerald-950 leading-relaxed">
                Food moisture vaporization buffers the basket coating below 180°C, preventing PTFE pyrolysis and keeping ultrafine particle emissions within safe ambient kitchen parameters.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Engineering Data Table: Basket Materials & Pyrolysis Matrix -->
  <div class="border-t border-hairline pt-8 mb-10">
    <div class="mb-4">
      <h3 class="text-lg font-bold text-ink">{d.tableTitle}</h3>
      <p class="text-xs text-muted leading-relaxed">{d.tableSub}</p>
    </div>

    <div class="overflow-x-auto rounded-2xl border border-hairline shadow-2xs">
      <table class="w-full text-left text-xs border-collapse">
        <thead class="bg-surface-soft border-b border-hairline text-ink font-semibold uppercase tracking-wider">
          <tr>
            <th class="p-3.5">{d.colMaterial}</th>
            <th class="p-3.5">{d.colCoating}</th>
            <th class="p-3.5 text-center">{d.colThermalLimit}</th>
            <th class="p-3.5 text-center">{d.colPyrolysisTemp}</th>
            <th class="p-3.5 text-center">{d.colUfpRate}</th>
            <th class="p-3.5">{d.colAvianStatus}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline bg-canvas">
          {airFryerData.basketMaterials.map((mat) => (
            <tr class="hover:bg-surface-soft/60 transition-colors">
              <td class="p-3.5 font-bold text-ink whitespace-nowrap">
                {mat.name.split('(')[0].trim()}
              </td>
              <td class="p-3.5 text-body max-w-xs leading-relaxed">
                {mat.coatingType}
              </td>
              <td class="p-3.5 text-center font-mono font-bold text-ink">
                {mat.thermalLimitC}°C
              </td>
              <td class="p-3.5 text-center font-mono text-muted">
                {mat.ptfePyrolysisOnsetTempC === 999 ? 'N/A' : `${mat.ptfePyrolysisOnsetTempC}°C`}
              </td>
              <td class="p-3.5 text-center font-mono font-bold text-ink">
                {mat.baseUfpEmissionRateParticlesPerCm3.toLocaleString()} pt/cm³
              </td>
              <td class="p-3.5">
                <span class={`inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold ${
                  mat.ptfePyrolysisOnsetTempC === 999 ? 'bg-emerald-100 text-emerald-900' :
                  mat.id === 'peeling-flaked-ptfe' ? 'bg-red-100 text-red-900' : 'bg-amber-100 text-amber-900'
                }`}>
                  {mat.avianHazardLevel.split('(')[0].trim()}
                </span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- 5 Golden Safety Rules -->
  <div class="border-t border-hairline pt-8 space-y-4">
    <div>
      <h3 class="text-lg font-bold text-ink">{d.protocolsTitle}</h3>
      <p class="text-xs text-muted leading-relaxed mt-0.5">{d.protocolsSub}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 text-xs">
      <div class="p-4 rounded-2xl bg-surface-soft border border-hairline space-y-1.5">
        <h4 class="font-bold text-ink">{d.rule1Title}</h4>
        <p class="text-body leading-relaxed">{d.rule1Text}</p>
      </div>
      <div class="p-4 rounded-2xl bg-surface-soft border border-hairline space-y-1.5">
        <h4 class="font-bold text-ink">{d.rule2Title}</h4>
        <p class="text-body leading-relaxed">{d.rule2Text}</p>
      </div>
      <div class="p-4 rounded-2xl bg-surface-soft border border-hairline space-y-1.5">
        <h4 class="font-bold text-ink">{d.rule3Title}</h4>
        <p class="text-body leading-relaxed">{d.rule3Text}</p>
      </div>
      <div class="p-4 rounded-2xl bg-surface-soft border border-hairline space-y-1.5">
        <h4 class="font-bold text-ink">{d.rule4Title}</h4>
        <p class="text-body leading-relaxed">{d.rule4Text}</p>
      </div>
      <div class="p-4 rounded-2xl bg-surface-soft border border-hairline space-y-1.5">
        <h4 class="font-bold text-ink">{d.rule5Title}</h4>
        <p class="text-body leading-relaxed">{d.rule5Text}</p>
      </div>
      <div class="p-4 rounded-2xl bg-amber-50 border border-amber-200 text-amber-950 space-y-1.5 flex flex-col justify-center">
        <h4 class="font-bold text-amber-950">🦜 Veterinary Avian Warning</h4>
        <p class="text-amber-950 leading-relaxed">
          Pet birds (parrots, cockatiels, budgerigars) possess hypersensitive pulmonary blood-gas barriers. Overheated PTFE causes acute bilateral pulmonary hemorrhage within minutes. Always relocate birds away from open kitchens.
        </p>
      </div>
    </div>
  </div>

  <!-- Related Tools Cross-Links -->
  <div class="mt-8 pt-6 border-t border-hairline flex flex-wrap items-center justify-between gap-4 text-xs">
    <span class="font-bold text-muted uppercase tracking-wider">{d.crossLinkTitle}:</span>
    <div class="flex flex-wrap gap-2">
      <a href="/tools/air-fryer-acrylamide-calculator/" class="px-3 py-1.5 rounded-lg bg-surface-soft hover:bg-surface-strong border border-hairline text-ink font-medium transition-colors">
        &rarr; {d.crossLinkAcrylamide}
      </a>
      <a href="/tools/toaster-element-acrylamide-safety-simulator/" class="px-3 py-1.5 rounded-lg bg-surface-soft hover:bg-surface-strong border border-hairline text-ink font-medium transition-colors">
        &rarr; {d.crossLinkOven}
      </a>
      <a href="/tools/toxic-leaching-scorecard/" class="px-3 py-1.5 rounded-lg bg-surface-soft hover:bg-surface-strong border border-hairline text-ink font-medium transition-colors">
        &rarr; {d.crossLinkTox}
      </a>
    </div>
  </div>
</div>

<!-- Client-Side Real-Time Diagnostic Engine -->
<script define:vars={{ airFryerData, reportCopiedText: d.reportCopied, copyBtnOriginalText: d.copyReportBtn }}>
  (function initFryerEngine() {
    const materialSelect = document.getElementById('select-fryer-material');
    const loadSelect = document.getElementById('select-fryer-load');
    const tempSelect = document.getElementById('select-fryer-temp');
    const wearSelect = document.getElementById('select-fryer-wear');
    const oilSelect = document.getElementById('select-fryer-oil');
    const ventSelect = document.getElementById('select-fryer-vent');
    const copyBtn = document.getElementById('btn-copy-fryer-report');
    const copyBtnText = document.getElementById('copy-fryer-btn-text');
    const presetButtons = document.querySelectorAll('.preset-fryer-btn');

    // Telemetry Outputs
    const valFryerScore = document.getElementById('val-fryer-score');
    const badgeFryerStatus = document.getElementById('badge-fryer-status');
    const valUfpRate = document.getElementById('val-ufp-rate');
    const subUfpRate = document.getElementById('sub-ufp-rate');
    const valSurfaceTemp = document.getElementById('val-surface-temp');
    const subSurfaceTemp = document.getElementById('sub-surface-temp');
    const valAvianRisk = document.getElementById('val-avian-risk');
    const subAvianRisk = document.getElementById('sub-avian-risk');
    const valMicroplastic = document.getElementById('val-microplastic-shed');
    const subMicroplastic = document.getElementById('sub-microplastic-shed');
    const valGasOutgas = document.getElementById('val-gas-outgas');
    const subGasOutgas = document.getElementById('sub-gas-outgas');
    const valVarnishRisk = document.getElementById('val-varnish-risk');
    const subVarnishRisk = document.getElementById('sub-varnish-risk');
    const bannerAlert = document.getElementById('banner-fryer-alert');
    const alertIcon = document.getElementById('fryer-alert-icon');
    const alertHeading = document.getElementById('fryer-alert-heading');
    const alertBody = document.getElementById('fryer-alert-body');

    function updateCalculations() {
      if (!materialSelect || !loadSelect || !tempSelect || !wearSelect || !oilSelect || !ventSelect) return;

      const matId = materialSelect.value;
      const loadId = loadSelect.value;
      const tempId = tempSelect.value;
      const wearId = wearSelect.value;
      const oilId = oilSelect.value;
      const ventId = ventSelect.value;

      const matObj = airFryerData.basketMaterials.find(m => m.id === matId) || airFryerData.basketMaterials[0];
      const loadObj = airFryerData.preheatAndLoadConditions.find(l => l.id === loadId) || airFryerData.preheatAndLoadConditions[0];
      const tempObj = airFryerData.temperatureSettings.find(t => t.id === tempId) || airFryerData.temperatureSettings[2];
      const wearObj = airFryerData.coatingWearStates.find(w => w.id === wearId) || airFryerData.coatingWearStates[1];
      const oilObj = airFryerData.oilSprayTypes.find(o => o.id === oilId) || airFryerData.oilSprayTypes[1];
      const ventObj = airFryerData.ventilationStates.find(v => v.id === ventId) || airFryerData.ventilationStates[0];

      // 1. Surface Hotspot Temperature (°C)
      // Food absorbs thermal energy (latent heat of vaporization); empty preheat suffers direct radiant flux overshoot
      const surfaceTempC = Math.round(tempObj.celsius * loadObj.surfaceTempMultiplier);
      const surfaceTempF = Math.round(surfaceTempC * 1.8 + 32);

      // 2. Ultrafine Particle Emission (pt/cm³)
      // Base UFP rate * temp scaling * wear multiplier * load multiplier * ventilation retention
      let rawUfp = matObj.baseUfpEmissionRateParticlesPerCm3 * tempObj.ufpScaling * wearObj.wearMultiplier;
      if (loadId === 'empty-dry-preheat') rawUfp *= 2.8;
      if (loadId === 'extended-burn-off') rawUfp *= 4.5;
      if (oilId === 'propellant-cooking-spray') rawUfp *= 1.9;

      // Indoor concentration after ventilation factor
      const indoorUfp = Math.round(rawUfp * ventObj.indoorRetentionFactor);

      // 3. Avian Toxicity Risk Assessment
      let avianRisk = 'Low / Negligible';
      let avianSub = 'Safe with food heat-sink';
      let avianSeverity = 'low';

      if (matObj.ptfePyrolysisOnsetTempC === 999) {
        avianRisk = 'Safe (100% Inert)';
        avianSub = 'Zero fluorocarbon outgassing';
        avianSeverity = 'safe';
      } else {
        if (surfaceTempC >= 240 || (loadId === 'extended-burn-off' && surfaceTempC >= 220)) {
          avianRisk = '🚨 CATASTROPHIC / FATAL';
          avianSub = 'Acute pulmonary hemorrhage risk';
          avianSeverity = 'critical';
        } else if (surfaceTempC >= 210 || loadId === 'empty-dry-preheat') {
          avianRisk = '⚠️ HIGH DANGER';
          avianSub = 'Relocate pet birds immediately';
          avianSeverity = 'high';
        } else if (surfaceTempC >= 190) {
          avianRisk = 'Moderate / Elevated';
          avianSub = 'Keep birds in separate rooms';
          avianSeverity = 'moderate';
        }
      }

      // 4. Microplastic Flake Shedding (ppm)
      let microplasticPpm = Number((matObj.microplasticSheddingRatePpm * wearObj.wearMultiplier).toFixed(1));
      if (loadId === 'empty-dry-preheat' || loadId === 'extended-burn-off') {
        microplasticPpm = Number((microplasticPpm * 1.35).toFixed(1));
      }

      // 5. Fluorocarbon Gas & Pyrolysis Acid Outgassing
      let gasStatus = 'None / Zero';
      let gasSub = '100% Non-fluorinated substrate';
      if (matObj.ptfePyrolysisOnsetTempC !== 999) {
        if (surfaceTempC >= 240) {
          gasStatus = '🚨 Severe Pyrolysis (PFIB / COF2)';
          gasSub = 'Toxic fluorocarbon & acid plumes';
        } else if (surfaceTempC >= 215) {
          gasStatus = 'Elevated TFA & Fluoride Vapors';
          gasSub = 'Sub-microscopic outgassing';
        } else if (surfaceTempC >= 195) {
          gasStatus = 'Trace Fluoropolymer Vapors';
          gasSub = 'Low-molecular-weight oligomers';
        } else {
          gasStatus = 'Trace / Bound';
          gasSub = 'Zero toxic carbonyl fluoride';
        }
      }

      // 6. Cooking Spray Varnish Risk (% coating degradation)
      let varnishDegradationPct = 10;
      if (oilId === 'propellant-cooking-spray') {
        varnishDegradationPct = Math.min(95, Math.round(18 * oilObj.varnishRiskMultiplier + (surfaceTempC > 190 ? 20 : 5)));
      } else if (oilId === 'pure-liquid-oil') {
        varnishDegradationPct = 15;
      } else {
        varnishDegradationPct = 5;
      }

      // 7. Overall Safety Score (0-100)
      let score = 95;
      if (matObj.ptfePyrolysisOnsetTempC === 999) {
        score = 98;
        if (oilId === 'propellant-cooking-spray') score -= 8;
      } else {
        // Penalize PTFE based on temperature and dry preheating
        if (surfaceTempC > 200) score -= Math.min(45, (surfaceTempC - 200) * 1.8);
        if (loadId === 'empty-dry-preheat') score -= 22;
        if (loadId === 'extended-burn-off') score -= 40;
        if (wearId === 'peeling') score -= 30;
        if (wearId === 'abraded') score -= 18;
        if (oilId === 'propellant-cooking-spray') score -= 14;
        if (ventId === 'unventilated-closed') score -= 18;
      }
      score = Math.max(5, Math.min(99, Math.round(score)));

      // DOM Updates
      if (valFryerScore) valFryerScore.textContent = score;

      if (badgeFryerStatus) {
        if (score >= 85) {
          badgeFryerStatus.textContent = 'EXCELLENT / MINIMAL EMISSIONS';
          badgeFryerStatus.className = 'px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-100 text-emerald-900 border border-emerald-200';
          valFryerScore.className = 'text-5xl md:text-6xl font-black font-mono text-emerald-600 transition-colors';
        } else if (score >= 60) {
          badgeFryerStatus.textContent = 'MODERATE / CONTROLLED OUTGASSING';
          badgeFryerStatus.className = 'px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-100 text-amber-900 border border-amber-200';
          valFryerScore.className = 'text-5xl md:text-6xl font-black font-mono text-amber-600 transition-colors';
        } else {
          badgeFryerStatus.textContent = 'HAZARDOUS / CRITICAL PYROLYSIS PLUME';
          badgeFryerStatus.className = 'px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-red-100 text-red-900 border border-red-200';
          valFryerScore.className = 'text-5xl md:text-6xl font-black font-mono text-red-600 transition-colors';
        }
      }

      if (valUfpRate) valUfpRate.innerHTML = `${indoorUfp.toLocaleString()} <span class="text-xs font-normal text-muted">pt/cm³</span>`;
      if (subUfpRate) {
        if (indoorUfp < 10000) {
          subUfpRate.textContent = 'Within residential baseline';
          subUfpRate.className = 'text-[11px] text-emerald-600 font-medium';
        } else if (indoorUfp < 60000) {
          subUfpRate.textContent = 'Elevated breathing-zone aerosol';
          subUfpRate.className = 'text-[11px] text-amber-600 font-medium';
        } else {
          subUfpRate.textContent = 'Critical ultrafine plume hazard';
          subUfpRate.className = 'text-[11px] text-red-600 font-medium';
        }
      }

      if (valSurfaceTemp) valSurfaceTemp.innerHTML = `${surfaceTempC}°C <span class="text-xs font-normal text-muted">(${surfaceTempF}°F)</span>`;
      if (subSurfaceTemp) {
        if (surfaceTempC < 195) {
          subSurfaceTemp.textContent = 'Below 200°C pyrolysis onset';
          subSurfaceTemp.className = 'text-[11px] text-emerald-600 font-medium';
        } else if (surfaceTempC < 230) {
          subSurfaceTemp.textContent = 'Approaching continuous limit';
          subSurfaceTemp.className = 'text-[11px] text-amber-600 font-medium';
        } else {
          subSurfaceTemp.textContent = 'Active polymer thermal breakdown';
          subSurfaceTemp.className = 'text-[11px] text-red-600 font-medium';
        }
      }

      if (valAvianRisk) {
        valAvianRisk.textContent = avianRisk;
        if (avianSeverity === 'safe' || avianSeverity === 'low') {
          valAvianRisk.className = 'text-base font-black text-emerald-700';
        } else if (avianSeverity === 'moderate') {
          valAvianRisk.className = 'text-base font-black text-amber-700';
        } else {
          valAvianRisk.className = 'text-base font-black text-red-700';
        }
      }
      if (subAvianRisk) subAvianRisk.textContent = avianSub;

      if (valMicroplastic) valMicroplastic.innerHTML = `${microplasticPpm} <span class="text-xs font-normal text-muted">ppm</span>`;
      if (subMicroplastic) {
        if (microplasticPpm === 0) {
          subMicroplastic.textContent = 'Zero polymer coating';
          subMicroplastic.className = 'text-[11px] text-emerald-600 font-medium';
        } else if (microplasticPpm < 35) {
          subMicroplastic.textContent = 'Surface micro-furrow shedding';
          subMicroplastic.className = 'text-[11px] text-amber-600 font-medium';
        } else {
          subMicroplastic.textContent = 'Active flaking & flake ingestion';
          subMicroplastic.className = 'text-[11px] text-red-600 font-medium';
        }
      }

      if (valGasOutgas) valGasOutgas.textContent = gasStatus;
      if (subGasOutgas) subGasOutgas.textContent = gasSub;

      if (valVarnishRisk) valVarnishRisk.innerHTML = `${varnishDegradationPct}% <span class="text-xs font-normal text-muted">Loss</span>`;
      if (subVarnishRisk) {
        if (varnishDegradationPct < 20) {
          subVarnishRisk.textContent = 'Pure liquid fat; low varnish';
          subVarnishRisk.className = 'text-[11px] text-emerald-600 font-medium';
        } else {
          subVarnishRisk.textContent = 'Lecithin varnish destroys PTFE';
          subVarnishRisk.className = 'text-[11px] text-red-600 font-medium';
        }
      }

      // Banner Alert
      if (bannerAlert && alertIcon && alertHeading && alertBody) {
        if (score >= 85) {
          bannerAlert.className = 'p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-950 transition-colors';
          alertIcon.textContent = '✅';
          alertHeading.textContent = 'Controlled Food-Contact Convective State';
          alertHeading.className = 'text-xs font-bold uppercase tracking-wider text-emerald-900';
          alertBody.textContent = 'Food moisture evaporation buffers the basket coating below 180°C, preventing PTFE pyrolysis and keeping ultrafine particle emissions within safe ambient kitchen parameters.';
        } else if (score >= 60) {
          bannerAlert.className = 'p-4 rounded-2xl bg-amber-50 border border-amber-200 text-amber-950 transition-colors';
          alertIcon.textContent = '⚠️';
          alertHeading.textContent = 'Thermal Stress & Micro-Particle Warning';
          alertHeading.className = 'text-xs font-bold uppercase tracking-wider text-amber-900';
          alertBody.textContent = 'Convective airflow and radiant heat are driving basket surface temperatures into the thermal outgassing threshold (200°C–230°C). Micro-scratched coating is shedding particles. Keep range hood on high.';
        } else {
          bannerAlert.className = 'p-4 rounded-2xl bg-red-50 border border-red-200 text-red-950 transition-colors';
          alertIcon.textContent = '🚨';
          alertHeading.textContent = 'Critical Pyrolysis & Toxic Micro-Plume Alert';
          alertHeading.className = 'text-xs font-bold uppercase tracking-wider text-red-900';
          alertBody.textContent = 'Severe thermal degradation detected. Dry preheating or peeling coating is releasing dense ultrafine fluoropolymer plumes and fluorocarbon gases. Lethal to pet birds within minutes. Ventilate immediately.';
        }
      }
    }

    // Attach Event Listeners
    [materialSelect, loadSelect, tempSelect, wearSelect, oilSelect, ventSelect].forEach(el => {
      if (el) el.addEventListener('change', updateCalculations);
    });

    // Preset button handlers
    presetButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const p = btn.getAttribute('data-preset');
        if (p === 'ceramic-safe') {
          if (materialSelect) materialSelect.value = 'ceramic-sol-gel';
          if (loadSelect) loadSelect.value = 'loaded-food-mass';
          if (tempSelect) tempSelect.value = 'temp-200';
          if (wearSelect) wearSelect.value = 'pristine';
          if (oilSelect) oilSelect.value = 'pure-liquid-oil';
          if (ventSelect) ventSelect.value = 'hood-exhaust';
        } else if (p === 'controlled-ptfe') {
          if (materialSelect) materialSelect.value = 'ptfe-standard-coated';
          if (loadSelect) loadSelect.value = 'loaded-food-mass';
          if (tempSelect) tempSelect.value = 'temp-180';
          if (wearSelect) wearSelect.value = 'pristine';
          if (oilSelect) oilSelect.value = 'pure-liquid-oil';
          if (ventSelect) ventSelect.value = 'hood-exhaust';
        } else if (p === 'empty-preheat') {
          if (materialSelect) materialSelect.value = 'ptfe-standard-coated';
          if (loadSelect) loadSelect.value = 'empty-dry-preheat';
          if (tempSelect) tempSelect.value = 'temp-220';
          if (wearSelect) wearSelect.value = 'scratched';
          if (oilSelect) oilSelect.value = 'no-oil';
          if (ventSelect) ventSelect.value = 'window-open';
        } else if (p === 'flaking-aerosol') {
          if (materialSelect) materialSelect.value = 'peeling-flaked-ptfe';
          if (loadSelect) loadSelect.value = 'partial-load';
          if (tempSelect) tempSelect.value = 'temp-200';
          if (wearSelect) wearSelect.value = 'peeling';
          if (oilSelect) oilSelect.value = 'propellant-cooking-spray';
          if (ventSelect) ventSelect.value = 'window-open';
        } else if (p === 'avian-lethal') {
          if (materialSelect) materialSelect.value = 'ptfe-standard-coated';
          if (loadSelect) loadSelect.value = 'extended-burn-off';
          if (tempSelect) tempSelect.value = 'temp-240';
          if (wearSelect) wearSelect.value = 'abraded';
          if (oilSelect) oilSelect.value = 'no-oil';
          if (ventSelect) ventSelect.value = 'unventilated-closed';
        }
        updateCalculations();
      });
    });

    // Copy Telemetry Report
    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        const mat = materialSelect?.options[materialSelect.selectedIndex]?.text || '';
        const load = loadSelect?.options[loadSelect.selectedIndex]?.text || '';
        const temp = tempSelect?.options[tempSelect.selectedIndex]?.text || '';
        const wear = wearSelect?.options[wearSelect.selectedIndex]?.text || '';
        const oil = oilSelect?.options[oilSelect.selectedIndex]?.text || '';
        const vent = ventSelect?.options[ventSelect.selectedIndex]?.text || '';

        const score = valFryerScore?.textContent?.trim() || '';
        const ufp = valUfpRate?.textContent?.trim() || '';
        const surfaceT = valSurfaceTemp?.textContent?.trim() || '';
        const avian = valAvianRisk?.textContent?.trim() || '';
        const mp = valMicroplastic?.textContent?.trim() || '';
        const gas = valGasOutgas?.textContent?.trim() || '';
        const varnish = valVarnishRisk?.textContent?.trim() || '';

        const report = `=== ISITKITCHENSAFE: AIR FRYER FLUOROPOLYMER DEGRADATION & UFP TELEMETRY ===
Timestamp: ${new Date().toISOString()}
Basket Material: ${mat}
Preheat & Food Load: ${load}
Convection Temperature: ${temp}
Coating Degradation State: ${wear}
Cooking Oil Chemistry: ${oil}
Kitchen Ventilation: ${vent}
--------------------------------------------------
Overall Safety Score: ${score} / 100
Peak Basket Surface Hotspot: ${surfaceT}
Ultrafine Particle (UFP) Rate: ${ufp}
Avian Polymer Fume Fever Hazard: ${avian}
Microplastic Flake Ingestion Burden: ${mp}
Fluorocarbon Gas & Pyrolysis Outgassing: ${gas}
Cooking Spray Varnish Adhesion Loss: ${varnish}
Verification: Evaluated against NIOSH Inhalation REL & EPA Standards.
Source: https://isitkitchensafe.com/tools/air-fryer-teflon-fluoropolymer-modeler/`;

        navigator.clipboard.writeText(report).then(() => {
          if (copyBtnText) copyBtnText.textContent = reportCopiedText;
          setTimeout(() => {
            if (copyBtnText) copyBtnText.textContent = copyBtnOriginalText;
          }, 3000);
        }).catch(err => {
          console.error('Clipboard copy failed:', err);
        });
      });
    }

    // Initial run
    updateCalculations();
  })();
</script>
