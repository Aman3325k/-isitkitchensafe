import rawData from '../data/fridge-organization-zone-planner-data.json';
import type { SupportedLanguage } from '../i18n/ui';
import { useTranslatedPath } from '../i18n/utils';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;
const translatePath = useTranslatedPath(lang);

const leftoverUrl = translatePath('/tools/leftover-shelf-life-calculator/');
const powerOutageUrl = translatePath('/tools/power-outage-food-safety-checker/');
const thawingUrl = translatePath('/tools/meat-thawing-calculator/');
const methodologyUrl = translatePath('/methodology/');
const allToolsUrl = translatePath('/tools/');

type EthyleneRole = 'producer' | 'sensitive' | 'neutral';

interface LocalizedZone {
  id: string;
  icon: string;
  isFridge: boolean;
  tempF: string;
  tempC: string;
  humidityKey: string;
  tone: string;
  fdaTier: number;
  name: string;
  shortName: string;
  tempSub: string;
  humidityLabel: string;
  ruleTitle: string;
  safetyRule: string;
  neverPutHere: string;
  bestFor: string;
  itemCount: number;
}

interface LocalizedFood {
  id: string;
  icon: string;
  zoneId: string;
  ethylene: EthyleneRole;
  quickChip: boolean;
  name: string;
  aliases: string;
  shelfLife: string;
  mistake: string;
  container: string;
}

const localizedFoods: LocalizedFood[] = rawData.foods.map((f) => {
  const tr = (f.i18n as Record<string, any>)[lang] || f.i18n.en;
  return {
    id: f.id,
    icon: f.icon,
    zoneId: f.zoneId,
    ethylene: f.ethylene as EthyleneRole,
    quickChip: Boolean(f.quickChip),
    name: tr.name,
    aliases: tr.aliases,
    shelfLife: tr.shelfLife,
    mistake: tr.mistake,
    container: tr.container
  };
});

const localizedZones: LocalizedZone[] = rawData.zones.map((z) => {
  const tr = (z.i18n as Record<string, any>)[lang] || z.i18n.en;
  const itemCount = localizedFoods.filter((f) => f.zoneId === z.id).length;
  return {
    id: z.id,
    icon: z.icon,
    isFridge: Boolean(z.isFridge),
    tempF: z.tempF,
    tempC: z.tempC,
    humidityKey: z.humidityKey,
    tone: z.tone,
    fdaTier: z.fdaTier,
    name: tr.name,
    shortName: tr.shortName,
    tempSub: tr.tempSub,
    humidityLabel: tr.humidityLabel,
    ruleTitle: tr.ruleTitle,
    safetyRule: tr.safetyRule,
    neverPutHere: tr.neverPutHere,
    bestFor: tr.bestFor,
    itemCount
  };
});

const zoneMap = new Map(localizedZones.map((z) => [z.id, z]));
const quickChipFoods = localizedFoods.filter((f) => f.quickChip);

const localizedFaqs: Array<{ question: string; answer: string }> =
  (rawData.faqs as Record<string, Array<{ question: string; answer: string }>>)[lang] ||
  rawData.faqs.en;

