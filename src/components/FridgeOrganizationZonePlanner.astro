const t = UI[lang] || UI.en;
const defaultTempUnit: 'F' | 'C' = lang === 'en' ? 'F' : 'C';
const defaultZoneId = 'middle-shelf';
const defaultZone = zoneMap.get(defaultZoneId) || localizedZones[0];

function getTempRange(z: LocalizedZone, unit: 'F' | 'C'): string {
  return unit === 'C' ? z.tempC : z.tempF;
}

function getEthyleneBadgeClass(role: EthyleneRole): string {
  if (role === 'producer') return 'badge-depends';
  if (role === 'sensitive') return 'badge-time';
  return 'inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-surface-soft text-muted border border-hairline';
}

function getEthyleneBadgeLabel(role: EthyleneRole): string {
  if (role === 'producer') return '💨 ' + t.ethBadgeProducer;
  if (role === 'sensitive') return '🌿 ' + t.ethBadgeSensitive;
  return '✓ ' + t.ethBadgeNeutral;
}

const topZone = zoneMap.get('top-shelf')!;
const middleZone = zoneMap.get('middle-shelf')!;
const bottomZone = zoneMap.get('bottom-shelf')!;
const highCrisperZone = zoneMap.get('high-humidity-crisper')!;
const lowCrisperZone = zoneMap.get('low-humidity-crisper')!;
const doorZone = zoneMap.get('fridge-door')!;
const pantryZone = zoneMap.get('counter-pantry')!;

const clientPayload = {
  lang,
  defaultTempUnit,
  defaultZoneId,
  zones: localizedZones,
  foods: localizedFoods,
  ui: t
};
---

<div id="fridge-zone-planner-root" class="space-y-12">
  <!-- Main Interactive Planner Card -->
  <section
    id="fridge-organization-zone-planner"
    class="bg-canvas border border-hairline rounded-2xl shadow-sm overflow-hidden"
    aria-label={t.ariaLabel}
  >
    <script type="application/json" id="foz-payload" set:html={JSON.stringify(clientPayload)} />

    <!-- Top Instant Grocery Search & Unit Toggle Bar -->
    <div class="p-5 sm:p-6 bg-surface-soft/70 border-b border-hairline space-y-4 print:hidden">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-3">
        <label for="foz-search-input" class="text-title-sm font-semibold text-ink">
          🔎 {t.searchLabel}
        </label>
        <div class="inline-flex items-center gap-2 self-start md:self-auto">
          <span class="text-xs font-medium text-muted">{t.tempUnitLabel}:</span>
          <div class="inline-flex rounded-lg border border-hairline bg-canvas p-0.5" role="radiogroup" aria-label={t.tempUnitLabel}>
            <button
              type="button"
              role="radio"
              aria-checked={defaultTempUnit === 'F' ? 'true' : 'false'}
              data-foz-unit="F"
              class={`foz-unit-btn px-3 py-1 rounded-md text-xs font-bold cursor-pointer transition-all ${
                defaultTempUnit === 'F' ? 'bg-signature-coral text-white shadow-sm' : 'text-ink hover:bg-surface-soft'
              }`}
            >
              °F
            </button>
            <button
              type="button"
              role="radio"
              aria-checked={defaultTempUnit === 'C' ? 'true' : 'false'}
              data-foz-unit="C"
              class={`foz-unit-btn px-3 py-1 rounded-md text-xs font-bold cursor-pointer transition-all ${
                defaultTempUnit === 'C' ? 'bg-signature-coral text-white shadow-sm' : 'text-ink hover:bg-surface-soft'
              }`}
            >
              °C
            </button>
          </div>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row gap-2.5">
        <div class="relative flex-1">
          <span aria-hidden="true" class="absolute left-3.5 top-1/2 -translate-y-1/2 text-muted text-sm pointer-events-none">🛒</span>
          <input
            type="search"
            id="foz-search-input"
            placeholder={t.searchPlaceholder}
            aria-label={t.searchPlaceholder}
            class="w-full h-11 pl-10 pr-4 rounded-xl bg-canvas border border-hairline text-ink text-sm focus:outline-none focus:border-info-border shadow-xs"
          />
        </div>
        <button
          type="button"
          id="foz-clear-search-btn"
          class="hidden h-11 px-4 rounded-xl text-xs font-bold bg-canvas text-ink border border-hairline hover:border-signature-coral cursor-pointer transition-colors shrink-0"
        >
          ✕ {t.clearSearch}
        </button>
      </div>

      <!-- Quick Lookup Chips -->
      <div class="flex flex-wrap items-center gap-1.5">
        <span class="text-[11px] font-semibold text-muted mr-1">{t.quickSearchLabel}</span>
        {quickChipFoods.map((qf) => (
          <button
            type="button"
            data-foz-quick={qf.id}
            class="foz-quick-chip px-2.5 py-1 rounded-full text-xs font-medium bg-canvas text-ink border border-hairline hover:border-signature-coral hover:text-signature-coral transition-colors cursor-pointer"
          >
            {qf.icon} {qf.name.split('(')[0].split(',')[0].trim()}
          </button>
        ))}
      </div>
    </div>

    <!-- Main 2-Column Interactive Fridge Schematic + Active Zone Inspector -->
    <div class="grid grid-cols-1 lg:grid-cols-12 divide-y lg:divide-y-0 lg:divide-x divide-hairline">
      <!-- Left Column: Visual 6-Zone Fridge Map + Counter/Pantry Tab -->
      <div class="lg:col-span-7 p-5 sm:p-6 space-y-4">
        <div class="flex flex-wrap items-start justify-between gap-2">
          <div>
            <h2 class="text-title-sm font-semibold text-ink">{t.mapHeading}</h2>
            <p class="text-xs text-muted mt-0.5">{t.mapSub}</p>
          </div>
          <button
            type="button"
            id="foz-show-all-btn"
            aria-pressed="false"
            class="px-3 py-1.5 rounded-lg text-xs font-bold border transition-all cursor-pointer bg-canvas text-ink border-hairline hover:border-signature-coral print:hidden"
          >
            {t.showAllZonesBtn}
          </button>
        </div>

        <!-- USDA Fridge Thermometer Target Bar -->
        <div class="flex items-center justify-between gap-2 px-3.5 py-2 rounded-xl bg-surface-soft border border-hairline text-xs">
          <span class="font-semibold text-ink">🌡️ <span id="foz-usda-target">{defaultTempUnit === 'C' ? t.usdaTargetC : t.usdaTargetF}</span></span>
        </div>

        <!-- Refrigerator Appliance Visual Diagram -->
        <div class="rounded-2xl border-2 border-border-strong/55 bg-surface-soft/80 p-3 sm:p-4 space-y-3">
          <div class="grid grid-cols-1 sm:grid-cols-12 gap-2.5">
            <!-- Main Cold Cabinet (8 cols) -->
            <div class="sm:col-span-8 flex flex-col gap-2">
              <div class="flex items-center justify-between px-1 text-[10.5px] font-bold uppercase tracking-wider text-muted">
                <span>❄️ {t.fridgeInteriorLabel}</span>
                <span>{t.topToBottomLabel}</span>
              </div>

              <!-- Zone 1: Top Shelf -->
              <button
                type="button"
                data-foz-zone="top-shelf"
                aria-pressed="false"
                class="foz-zone-btn w-full text-left p-3 rounded-xl border-2 transition-all cursor-pointer bg-canvas border-hairline hover:border-info-border"
              >
                <div class="flex items-center justify-between gap-2">
                  <span class="text-xs sm:text-sm font-bold text-ink flex items-center gap-1.5">
                    <span aria-hidden="true">{topZone.icon}</span>
                    <span>{topZone.shortName}</span>
                  </span>
                  <span class="flex items-center gap-1.5 shrink-0">
                    <span data-foz-match-pill="top-shelf" class="hidden px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-signature-coral text-white" />
                    <span data-foz-zone-temp="top-shelf" class="px-2 py-0.5 rounded-md text-[11px] font-mono font-bold bg-surface-soft text-ink border border-hairline">
                      {getTempRange(topZone, defaultTempUnit)}
                    </span>
                  </span>
                </div>
                <div class="flex items-center justify-between gap-2 mt-1 text-[11px] text-muted">
                  <span class="truncate">{topZone.tempSub}</span>
                  <span class="shrink-0 font-semibold">{topZone.itemCount} {t.itemsWord}</span>
                </div>
              </button>

              <!-- Zone 2: Middle Shelf (Default Selected) -->
              <button
                type="button"
                data-foz-zone="middle-shelf"
                aria-pressed="true"
                class="foz-zone-btn w-full text-left p-3 rounded-xl border-2 transition-all cursor-pointer bg-canvas border-hairline hover:border-info-border ring-2 ring-signature-coral ring-offset-1 shadow-sm"
              >
                <div class="flex items-center justify-between gap-2">
                  <span class="text-xs sm:text-sm font-bold text-ink flex items-center gap-1.5">
                    <span aria-hidden="true">{middleZone.icon}</span>
                    <span>{middleZone.shortName}</span>
                  </span>
                  <span class="flex items-center gap-1.5 shrink-0">
                    <span data-foz-match-pill="middle-shelf" class="hidden px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-signature-coral text-white" />
                    <span data-foz-zone-temp="middle-shelf" class="px-2 py-0.5 rounded-md text-[11px] font-mono font-bold bg-surface-soft text-ink border border-hairline">
                      {getTempRange(middleZone, defaultTempUnit)}
                    </span>
                  </span>
                </div>
                <div class="flex items-center justify-between gap-2 mt-1 text-[11px] text-muted">
                  <span class="truncate">{middleZone.tempSub}</span>
                  <span class="shrink-0 font-semibold">{middleZone.itemCount} {t.itemsWord}</span>
                </div>
              </button>

              <!-- Zone 3: Bottom Shelf (Coldest Raw Protein Zone) -->
              <button
                type="button"
                data-foz-zone="bottom-shelf"
                aria-pressed="false"
                class="foz-zone-btn w-full text-left p-3 rounded-xl border-2 transition-all cursor-pointer bg-error-bg/45 dark:bg-red-950/25 border-error-border/75 hover:border-error-border"
              >
                <div class="flex items-center justify-between gap-2">
                  <span class="text-xs sm:text-sm font-bold text-ink flex items-center gap-1.5">
                    <span aria-hidden="true">{bottomZone.icon}</span>
                    <span>{bottomZone.shortName}</span>
                  </span>
                  <span class="flex items-center gap-1.5 shrink-0">
                    <span data-foz-match-pill="bottom-shelf" class="hidden px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-signature-coral text-white" />
                    <span data-foz-zone-temp="bottom-shelf" class="px-2 py-0.5 rounded-md text-[11px] font-mono font-bold bg-canvas text-ink border border-hairline">
                      {getTempRange(bottomZone, defaultTempUnit)}
                    </span>
                  </span>
                </div>
                <div class="flex items-center justify-between gap-2 mt-1 text-[11px] text-body">
                  <span class="truncate font-medium">⚠️ {t.dripTrayMicro}</span>
                  <span class="shrink-0 font-semibold">{bottomZone.itemCount} {t.itemsWord}</span>
                </div>
              </button>

              <!-- Zones 4 & 5: Side-by-Side Crisper Drawers -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-0.5">
                <button
                  type="button"
                  data-foz-zone="high-humidity-crisper"
                  aria-pressed="false"
                  class="foz-zone-btn w-full text-left p-3 rounded-xl border-2 transition-all cursor-pointer bg-canvas border-success-border/60 hover:border-success-border"
                >
                  <div class="flex items-center justify-between gap-1.5">
                    <span class="text-xs font-bold text-ink flex items-center gap-1 min-w-0">
                      <span aria-hidden="true">{highCrisperZone.icon}</span>
                      <span class="truncate">{highCrisperZone.shortName}</span>
                    </span>
                    <span data-foz-match-pill="high-humidity-crisper" class="hidden px-1.5 py-0.5 rounded-full text-[10px] font-extrabold bg-signature-coral text-white shrink-0" />
                  </div>
                  <div class="flex items-center justify-between gap-1 mt-1.5">
                    <span data-foz-zone-temp="high-humidity-crisper" class="px-1.5 py-0.5 rounded text-[10.5px] font-mono font-bold bg-surface-soft text-ink border border-hairline">
                      {getTempRange(highCrisperZone, defaultTempUnit)}
                    </span>
                    <span class="text-[10.5px] text-muted font-semibold">{highCrisperZone.itemCount} {t.itemsWord}</span>
                  </div>
                  <span class="block text-[10.5px] text-muted mt-1 leading-tight">💧 {t.ventClosedMicro}</span>
                </button>

                <button
                  type="button"
