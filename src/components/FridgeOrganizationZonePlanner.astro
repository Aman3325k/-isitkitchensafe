<script is:inline>
  (function () {
    const payloadEl = document.getElementById('foz-payload');
    if (!payloadEl) return;

    let payload;
    try {
      payload = JSON.parse(payloadEl.textContent || '{}');
    } catch (_) {
      return;
    }

    const zones = payload.zones || [];
    const foods = payload.foods || [];
    const ui = payload.ui || {};
    const zoneById = new Map(zones.map((z) => [z.id, z]));
    const foodById = new Map(foods.map((f) => [f.id, f]));

    // Controls
    const searchInput = document.getElementById('foz-search-input');
    const clearSearchBtn = document.getElementById('foz-clear-search-btn');
    const quickChips = Array.from(document.querySelectorAll('.foz-quick-chip'));
    const unitBtns = Array.from(document.querySelectorAll('.foz-unit-btn'));
    const zoneBtns = Array.from(document.querySelectorAll('.foz-zone-btn'));
    const showAllBtn = document.getElementById('foz-show-all-btn');
    const ethBtns = Array.from(document.querySelectorAll('.foz-eth-btn'));
    const jumpZoneBtns = Array.from(document.querySelectorAll('.foz-jump-zone-btn'));
    const cardEls = Array.from(document.querySelectorAll('.foz-food-card'));
    const zoneTempEls = Array.from(document.querySelectorAll('[data-foz-zone-temp]'));
    const cardTempEls = Array.from(document.querySelectorAll('[data-foz-card-temp]'));
    const matchPillEls = Array.from(document.querySelectorAll('[data-foz-match-pill]'));

    // Inspector & summary elements
    const usdaTargetEl = document.getElementById('foz-usda-target');
    const inspectorPanel = document.getElementById('foz-inspector-panel');
    const inspectorBadge = document.getElementById('foz-inspector-badge');
    const inspectorTemp = document.getElementById('foz-inspector-temp');
    const inspectorIcon = document.getElementById('foz-inspector-icon');
    const inspectorName = document.getElementById('foz-inspector-name');
    const inspectorHumidity = document.getElementById('foz-inspector-humidity');
    const inspectorRuleTitle = document.getElementById('foz-inspector-rule-title');
    const inspectorRuleBody = document.getElementById('foz-inspector-rule-body');
    const inspectorNever = document.getElementById('foz-inspector-never');
    const inspectorBest = document.getElementById('foz-inspector-best');
    const inspectorCount = document.getElementById('foz-inspector-count');

    const listHeadingEl = document.getElementById('foz-list-heading');
    const visibleCountBadge = document.getElementById('foz-visible-count-badge');
    const emptyStateEl = document.getElementById('foz-empty-state');

    const copyBtn = document.getElementById('foz-copy-btn');
    const copyLabel = document.getElementById('foz-copy-label');
    const printBtn = document.getElementById('foz-print-btn');
    const resetBtn = document.getElementById('foz-reset-btn');

    const state = {
      tempUnit: payload.defaultTempUnit || 'F',
      selectedZoneId: payload.defaultZoneId || 'middle-shelf',
      showAllZones: false,
      ethFilter: 'all',
      query: ''
    };

    let lastCheatSheetText = '';

    function getZoneTemp(zone, unit) {
      if (!zone) return '';
      return unit === 'C' ? zone.tempC : zone.tempF;
    }

    function getInspectorBorderClass(zone) {
      if (!zone) return 'border-info-border';
      if (zone.id === 'bottom-shelf') return 'border-error-border';
      if (zone.id === 'high-humidity-crisper') return 'border-success-border';
      if (zone.id === 'low-humidity-crisper' || zone.id === 'fridge-door') return 'border-warning-border';
      if (zone.id === 'counter-pantry') return 'border-signature-coral';
      return 'border-info-border';
    }

    function buildCheatSheetText() {
      const targetLine = state.tempUnit === 'C' ? ui.copyTargetLineC : ui.copyTargetLineF;
      const lines = [
        ui.copyHeader || 'Fridge Organization Cheat Sheet',
        targetLine || '',
        ''
      ];

      zones.forEach((z) => {
        const zFoods = foods.filter((f) => f.zoneId === z.id).map((f) => f.name);
        lines.push(
          z.icon + ' ' + z.name + ' [' + getZoneTemp(z, state.tempUnit) + ']',
          '  - ' + z.ruleTitle,
          '  - ' + (ui.copyFoodsPrefix || 'Best foods') + ': ' + zFoods.join(', '),
          '  - ' + (ui.copyNeverPrefix || 'NEVER HERE') + ': ' + z.neverPutHere,
          ''
        );
      });

      return lines.join('\n').trim();
    }

    function updateTempDisplays() {
      if (usdaTargetEl) {
        usdaTargetEl.textContent = state.tempUnit === 'C' ? (ui.usdaTargetC || '') : (ui.usdaTargetF || '');
      }

      zoneTempEls.forEach((el) => {
        const zid = el.getAttribute('data-foz-zone-temp') || '';
        const z = zoneById.get(zid);
        if (z) el.textContent = getZoneTemp(z, state.tempUnit);
      });

      cardTempEls.forEach((el) => {
        const zid = el.getAttribute('data-foz-card-temp') || '';
        const z = zoneById.get(zid);
        if (z) el.textContent = getZoneTemp(z, state.tempUnit);
      });
    }

    function updateInspector(zone) {
      if (!zone) return;
      if (inspectorPanel) {
        inspectorPanel.classList.remove(
          'border-info-border',
          'border-error-border',
          'border-success-border',
          'border-warning-border',
          'border-signature-coral'
        );
        inspectorPanel.classList.add(getInspectorBorderClass(zone));
      }
      if (inspectorBadge) {
        inspectorBadge.textContent = zone.isFridge
          ? (ui.inspectorBadgeFridge || 'Inside Refrigerator Zone')
          : (ui.inspectorBadgePantry || 'Keep Out of Refrigerator');
      }
      if (inspectorTemp) inspectorTemp.textContent = getZoneTemp(zone, state.tempUnit);
      if (inspectorIcon) inspectorIcon.textContent = zone.icon;
      if (inspectorName) inspectorName.textContent = zone.name;
      if (inspectorHumidity) inspectorHumidity.textContent = zone.humidityLabel;
      if (inspectorRuleTitle) inspectorRuleTitle.textContent = zone.ruleTitle;
      if (inspectorRuleBody) inspectorRuleBody.textContent = zone.safetyRule;
      if (inspectorNever) inspectorNever.textContent = zone.neverPutHere;
      if (inspectorBest) inspectorBest.textContent = zone.bestFor;
      if (inspectorCount) inspectorCount.textContent = String(zone.itemCount) + ' ' + (ui.itemsWord || 'items');
    }

    function applyButtonStates(searchMatchesByZone, hasQuery) {
      unitBtns.forEach((btn) => {
        const active = btn.getAttribute('data-foz-unit') === state.tempUnit;
        btn.setAttribute('aria-checked', active ? 'true' : 'false');
        btn.classList.toggle('bg-signature-coral', active);
        btn.classList.toggle('text-white', active);
        btn.classList.toggle('shadow-sm', active);
        btn.classList.toggle('text-ink', !active);
      });

      if (showAllBtn) {
        const active = state.showAllZones && !hasQuery;
        showAllBtn.setAttribute('aria-pressed', active ? 'true' : 'false');
        showAllBtn.classList.toggle('bg-primary', active);
        showAllBtn.classList.toggle('text-on-primary', active);
        showAllBtn.classList.toggle('border-primary', active);
        showAllBtn.classList.toggle('bg-canvas', !active);
        showAllBtn.classList.toggle('text-ink', !active);
        showAllBtn.classList.toggle('border-hairline', !active);
      }

      if (clearSearchBtn) {
        clearSearchBtn.classList.toggle('hidden', !hasQuery);
      }

      ethBtns.forEach((btn) => {
        const active = btn.getAttribute('data-foz-eth') === state.ethFilter;
        btn.setAttribute('aria-pressed', active ? 'true' : 'false');
        btn.classList.toggle('bg-primary', active);
        btn.classList.toggle('text-on-primary', active);
        btn.classList.toggle('border-primary', active);
        btn.classList.toggle('bg-canvas', !active);
        btn.classList.toggle('text-ink', !active);
        btn.classList.toggle('border-hairline', !active);
      });

      zoneBtns.forEach((btn) => {
        const zid = btn.getAttribute('data-foz-zone') || '';
        const matchCount = searchMatchesByZone.get(zid) || 0;
        const isSelected = !state.showAllZones && zid === state.selectedZoneId;
        const isSearchHit = hasQuery && matchCount > 0;

        btn.setAttribute('aria-pressed', isSelected ? 'true' : 'false');
        btn.classList.remove(
          'ring-2',
          'ring-signature-coral',
          'ring-offset-1',
          'opacity-45',
          'shadow-sm'
        );

        if (isSelected && !hasQuery) {
          btn.classList.add('ring-2', 'ring-signature-coral', 'ring-offset-1', 'shadow-sm');
        }

        if (hasQuery) {
          if (isSearchHit) {
            btn.classList.add('ring-2', 'ring-signature-coral', 'ring-offset-1', 'shadow-sm');
          } else {
            btn.classList.add('opacity-45');
          }
        }
      });

      matchPillEls.forEach((pill) => {
        const zid = pill.getAttribute('data-foz-match-pill') || '';
        const count = searchMatchesByZone.get(zid) || 0;
        if (hasQuery && count > 0) {
          pill.textContent = String(count) + ' ' + (ui.matchCountSuffix || 'match');
          pill.classList.remove('hidden');
        } else {
          pill.textContent = '';
          pill.classList.add('hidden');
        }
      });
    }

    function render() {
      updateTempDisplays();

      const queryLower = state.query.trim().toLowerCase();
      const hasQuery = queryLower.length > 0;
      const searchMatchesByZone = new Map();
      let firstMatchedZoneId = null;
      let visibleCount = 0;

      cardEls.forEach((cardEl) => {
        const fid = cardEl.getAttribute('data-foz-card') || '';
        const food = foodById.get(fid);
        if (!food) return;

        const zone = zoneById.get(food.zoneId);
        const matchesEth = state.ethFilter === 'all' || food.ethylene === state.ethFilter;

        let matchesQuery = true;
        if (hasQuery) {
          const haystack = (
            food.name +
            ' ' +
            food.aliases +
            ' ' +
            food.mistake +
            ' ' +
            food.container +
            ' ' +
            (zone ? zone.name + ' ' + zone.shortName : '')
          ).toLowerCase();
          matchesQuery = haystack.indexOf(queryLower) !== -1;
        }

        if (hasQuery && matchesQuery && matchesEth) {
          searchMatchesByZone.set(food.zoneId, (searchMatchesByZone.get(food.zoneId) || 0) + 1);
          if (!firstMatchedZoneId) firstMatchedZoneId = food.zoneId;
        }

        const matchesZone = hasQuery || state.showAllZones || food.zoneId === state.selectedZoneId;
        const show = matchesZone && matchesEth && matchesQuery;
        cardEl.classList.toggle('hidden', !show);
        if (show) visibleCount += 1;
      });

      if (hasQuery && firstMatchedZoneId) {
        state.selectedZoneId = firstMatchedZoneId;
      }

      const activeZone = zoneById.get(state.selectedZoneId) || zones[0];
      updateInspector(activeZone);
      applyButtonStates(searchMatchesByZone, hasQuery);

      if (emptyStateEl) {
        emptyStateEl.classList.toggle('hidden', visibleCount > 0);
      }

      if (visibleCountBadge) {
        visibleCountBadge.textContent = String(visibleCount) + ' / ' + String(foods.length);
      }

      if (listHeadingEl) {
        if (hasQuery) {
          listHeadingEl.textContent = '🔎 ' + (ui.groceryListHeadingSearch || 'Lookup Results') + ': "' + state.query.trim() + '"';
        } else if (state.showAllZones) {
          listHeadingEl.textContent = ui.groceryListHeadingAll || 'All 28 Everyday Groceries';
        } else if (activeZone) {
          listHeadingEl.textContent = activeZone.icon + ' ' + activeZone.shortName + ' — ' + (ui.groceryListHeadingZone || 'Zone Groceries');
        }
      }

      lastCheatSheetText = buildCheatSheetText();
    }

    // Event bindings
    if (searchInput) {
      searchInput.addEventListener('input', () => {
        state.query = searchInput.value || '';
        render();
      });
    }

    if (clearSearchBtn) {
      clearSearchBtn.addEventListener('click', () => {
        state.query = '';
        if (searchInput) {
          searchInput.value = '';
          searchInput.focus();
        }
        render();
      });
    }

    quickChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const fid = chip.getAttribute('data-foz-quick') || '';
        const food = foodById.get(fid);
        if (!food) return;
        const shortTerm = food.name.split('(')[0].split(',')[0].trim();
        state.query = shortTerm;
        state.ethFilter = 'all';
        state.showAllZones = false;
        state.selectedZoneId = food.zoneId;
        if (searchInput) searchInput.value = shortTerm;
        render();
      });
    });

    unitBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        state.tempUnit = btn.getAttribute('data-foz-unit') === 'C' ? 'C' : 'F';
        render();
      });
    });

    zoneBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const zid = btn.getAttribute('data-foz-zone');
        if (!zid) return;
        state.selectedZoneId = zid;
        state.showAllZones = false;
        state.query = '';
        if (searchInput) searchInput.value = '';
        render();
      });
    });

    if (showAllBtn) {
      showAllBtn.addEventListener('click', () => {
        state.showAllZones = !state.showAllZones;
        state.query = '';
        if (searchInput) searchInput.value = '';
        render();
      });
    }

    ethBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        state.ethFilter = btn.getAttribute('data-foz-eth') || 'all';
        if (state.ethFilter !== 'all' && !state.query.trim()) {
          state.showAllZones = true;
        }
        render();
      });
    });

    jumpZoneBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const zid = btn.getAttribute('data-foz-jump-zone');
        if (!zid) return;
        state.selectedZoneId = zid;
        state.showAllZones = false;
        state.query = '';
        if (searchInput) searchInput.value = '';
        render();
        if (inspectorPanel && inspectorPanel.scrollIntoView) {
          inspectorPanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      });
    });

    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        const showCopied = () => {
          if (copyLabel) copyLabel.textContent = ui.copiedCheatSheetBtn || 'Cheat Sheet Copied ✓';
          window.setTimeout(() => {
            if (copyLabel) copyLabel.textContent = '📋 ' + (ui.copyCheatSheetBtn || 'Copy Fridge Zone Cheat Sheet');
          }, 2200);
        };

        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(lastCheatSheetText).then(showCopied).catch(showCopied);
        } else {
          const ta = document.createElement('textarea');
          ta.value = lastCheatSheetText;
          ta.setAttribute('readonly', '');
          ta.style.position = 'absolute';
          ta.style.left = '-9999px';
          document.body.appendChild(ta);
          ta.select();
          try {
            document.execCommand('copy');
          } catch (_) {
            // ignore
          }
          document.body.removeChild(ta);
          showCopied();
        }
      });
    }

    if (printBtn) {
      printBtn.addEventListener('click', () => {
        const prevShowAll = state.showAllZones;
        state.showAllZones = true;
        render();
        window.print();
        state.showAllZones = prevShowAll;
        render();
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        state.tempUnit = payload.defaultTempUnit || 'F';
        state.selectedZoneId = payload.defaultZoneId || 'middle-shelf';
        state.showAllZones = false;
        state.ethFilter = 'all';
        state.query = '';
        if (searchInput) searchInput.value = '';
        render();
      });
    }

    render();
  })();
</script>
