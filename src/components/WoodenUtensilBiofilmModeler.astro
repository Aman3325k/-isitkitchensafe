    copyReportBtn: "📋 复制微生物诊断报告",
    copiedFeedback: "✓ 诊断报告已成功复制至剪贴板！"
  },
  ja: {
    badge: "食品微生物学・木材物理学",
    title: "木製スプーン微細クラック細菌バイオフィルム＆水分滞留モデラー",
    subtitle: "樹種ごとの導管孔隙率、食洗機熱応力によるひび割れ、毛細管水分吸収、病原菌バイオフィルム定着、二次汚染移行率を精密計算。",
    controlsTitle: "器具・衛生パラメータ設定",
    controlsSub: "樹種、食洗機使用履歴、オイル塗布状態、接触食材、乾燥保管環境を選択してください。",
    speciesLabel: "樹種および木材解剖構造：",
    speciesHelp: "導管の孔径、密度、年輪の異方性収縮率が毛細管現象による菌液浸透を左右します。",
    exposureLabel: "食洗機洗浄履歴：",
    exposureHelp: "アルカリ熱水と乾燥熱風がリグニンを溶出させ、著しい乾燥収縮割れを誘発します。",
    conditioningLabel: "表面オイル保護状態：",
    conditioningHelp: "食品グレードUSPミネラルオイル疎水膜 vs 未処理乾燥木肌 vs 酸化酸敗した食用油。",
    foodLabel: "接触調理マトリクス：",
    foodHelp: "病原菌の初期菌数、栄養源、およびその後の加熱殺菌ステップの有無を決定します。",
    dryingLabel: "洗浄後の乾燥・保管環境：",
    dryingHelp: "通気性と湿度が、表面水分活性（Aw）が静菌域（<0.65）に低下する時間を決定します。",
    crackSliderLabel: "目視微細クラック幅 (µm)：",
    crackSliderHelp: "目視状態に応じて微調整：滑らかな新品状態（<30µm）から深い裂け目（>500µm）。",
    presetsTitle: "クイック診断シナリオ：",
    presetRawChicken: "🍗 生鶏肉調理スプーン（手洗い・オイル未塗布）",
    presetDishwasherBeech: "🍽️ 食洗機で酷使されたブナ材スプーン（50回洗浄）",
    presetPristineMaple: "🍁 極上ハードメープルスプーン（ミネラルオイル手入れ済）",
    presetBambooDelam: "🎋 集成竹製スプーン（接着層剥離・縦割れ）",
    presetRancidOil: "🫒 オリーブ油を誤塗布したスプーン（酸化酸敗膜）",
    presetBabyFood: "👶 冷製離乳食・果物ペースト調理（非加熱リスク）",
    diagnosticTitle: "微生物汚染・バイオフィルム診断スコアカード",
    diagnosticSub: "深層微細クラック幅、毛細管水分保持、残存菌数、二次汚染移行確率のシミュレーション。",
    overallScoreLabel: "バイオフィルム汚染危険指数",
    crackWidthLabel: "推定微細クラック幅",
    moistureRetentionLabel: "内部毛細管水分活性 (Aw)",
    bacterialLoadLabel: "残存生存病原菌数",
    transferRateLabel: "二次汚染食品移行率",
    pathogenTransferLabel: "1食あたり推定摂取菌数",
    enterotoxinRiskLabel: "耐熱性黄色ブドウ球菌毒素リスク",
    utensilStatusLabel: "食品接触安全性判定",
    alertTitle: "臨床・公衆衛生学的リスク評価",
    tableTitle: "調理用木材の衛生特性・耐久性能比較マトリクス",
    tableSub: "木材密度、導管構造、食洗機耐性、天然抗菌性の詳細比較一覧。",
    colSpecies: "木材種類",
    colHardness: "ヤンカ硬度 (lbf)",
    colPores: "導管解剖構造と孔径",
    colDishwasher: "食洗機耐性",
    colCapillary: "毛細管吸水性",
    colVerdict: "衛生適合判定",
    rulesTitle: "木製スプーンを衛生的に使うための黄金の5原則",
    rulesSub: "科学的エビデンスに基づく深層細菌汚染防止と器具延命のプロトコル。",
    rule1Title: "1. 木製器具の食洗機洗浄は絶対に厳禁",
    rule1Text: "65°Cのアルカリ温水洗浄と75°Cの温風乾燥は、ヘミセルロースを破壊しリグニンを流出させます。年輪の接線方向と半径方向の収縮差により微細クラックが800%以上拡大し、細菌の隠れ家となります。",
    rule2Title: "2. お手入れにはUSPミネラルオイルを使用し、食用油は禁止",
    rule2Text: "オリーブ油やサラダ油などの食用油は空気中で急速に過酸化脂質へ酸化（酸敗）し、ベタつく被膜となって悪臭を放ち細菌の栄養源になります。高純度パラフィン系ミネラルオイルか蜜蝋のみを使用してください。",
    rule3Title: "3. 生肉・生鶏肉を扱った後は熱湯または過酸化水素消毒",
    rule3Text: "生肉の汁が触れた場合、洗剤での表面手洗いだけでは導管深部に吸い込まれたサルモネラ菌を殺菌できません。沸騰した湯（100°C）に3分間完全に浸すか、3%過酸化水素水で消毒してください。",
    rule4Title: "4. 洗浄後は立てて風通しの良い水切りラックで乾燥",
    rule4Text: "湿ったスプーンを密閉された箸立てや引き出しに密集させて保管しないでください。内部の水分活性がAw 0.85以上で半日以上維持され、黒カビやリステリア菌の爆発的繁殖を招きます。",
    rule5Title: "5. 1ミリ以上の亀裂は廃棄の絶対基準",
    rule5Text: "縦方向の裂け目や毛羽立ちの深さ・幅が1mmを超えた場合、いかなる煮沸や化学消毒でも奥深くに形成されたバイオフィルムを完全に除去することは不可能です。安全のため即座に廃棄してください。",
    copyReportBtn: "📋 微生物診断レポートをコピー",
    copiedFeedback: "✓ レポートをクリップボードにコピーしました！"
  }
};

const d = DICTIONARY[lang] || DICTIONARY.en;
const data = utensilData;
---

<div class="bg-surface-soft border border-hairline rounded-3xl p-6 md:p-10 mb-12 shadow-sm" id="biofilm-modeler-app">
  <!-- Top Banner -->
  <div class="flex flex-wrap items-center justify-between gap-4 mb-8 pb-6 border-b border-hairline">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-emerald-100 text-emerald-900 mb-2 border border-emerald-200">
        <span>🪵</span>
        {d.badge}
      </div>
      <h2 class="text-2xl md:text-3xl font-extrabold text-ink tracking-tight">
        {d.title}
      </h2>
      <p class="text-sm md:text-base text-body mt-1 max-w-3xl">
        {d.subtitle}
      </p>
    </div>
  </div>

  <!-- Presets Bar -->
  <div class="mb-8 p-4 bg-canvas rounded-2xl border border-hairline">
    <div class="text-xs font-bold uppercase tracking-wider text-muted mb-3">
      {d.presetsTitle}
    </div>
    <div class="flex flex-wrap gap-2">
      <button type="button" class="preset-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-surface-soft hover:bg-surface-strong border border-hairline transition-colors text-ink" data-preset="raw-chicken">
        {d.presetRawChicken}
      </button>
      <button type="button" class="preset-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-surface-soft hover:bg-surface-strong border border-hairline transition-colors text-ink" data-preset="dishwasher-beech">
        {d.presetDishwasherBeech}
      </button>
      <button type="button" class="preset-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-surface-soft hover:bg-surface-strong border border-hairline transition-colors text-ink" data-preset="pristine-maple">
        {d.presetPristineMaple}
      </button>
      <button type="button" class="preset-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-surface-soft hover:bg-surface-strong border border-hairline transition-colors text-ink" data-preset="bamboo-delam">
        {d.presetBambooDelam}
      </button>
      <button type="button" class="preset-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-surface-soft hover:bg-surface-strong border border-hairline transition-colors text-ink" data-preset="rancid-oil">
        {d.presetRancidOil}
      </button>
      <button type="button" class="preset-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-surface-soft hover:bg-surface-strong border border-hairline transition-colors text-ink" data-preset="baby-food">
        {d.presetBabyFood}
      </button>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Controls Column (5 cols) -->
    <div class="lg:col-span-5 space-y-6 bg-canvas p-6 rounded-2xl border border-hairline">
      <div>
        <h3 class="text-base font-bold text-ink">{d.controlsTitle}</h3>
        <p class="text-xs text-muted mt-0.5">{d.controlsSub}</p>
      </div>

      <!-- Control 1: Wood Species -->
      <div>
        <label for="species-select" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-1">
          {d.speciesLabel}
        </label>
        <select id="species-select" class="w-full text-sm rounded-xl border border-hairline bg-surface-soft p-2.5 text-ink focus:outline-none focus:ring-2 focus:ring-emerald-500">
          {data.woodSpecies.map((s) => (
            <option value={s.id} selected={s.id === 'hard-maple'}>
              {s.name}
            </option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1">{d.speciesHelp}</p>
      </div>

      <!-- Control 2: Dishwasher Exposure -->
      <div>
        <label for="exposure-select" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-1">
          {d.exposureLabel}
        </label>
        <select id="exposure-select" class="w-full text-sm rounded-xl border border-hairline bg-surface-soft p-2.5 text-ink focus:outline-none focus:ring-2 focus:ring-emerald-500">
          {data.exposureHistories.map((e) => (
            <option value={e.id} selected={e.id === 'handwash-only'}>
              {e.name}
            </option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1">{d.exposureHelp}</p>
      </div>

      <!-- Control 3: Surface Conditioning -->
      <div>
        <label for="conditioning-select" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-1">
          {d.conditioningLabel}
        </label>
        <select id="conditioning-select" class="w-full text-sm rounded-xl border border-hairline bg-surface-soft p-2.5 text-ink focus:outline-none focus:ring-2 focus:ring-emerald-500">
          {data.conditioningStatuses.map((c) => (
            <option value={c.id} selected={c.id === 'well-conditioned-mineral-oil'}>
              {c.name}
            </option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1">{d.conditioningHelp}</p>
      </div>

      <!-- Control 4: Food Contact Matrix -->
      <div>
        <label for="food-select" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-1">
          {d.foodLabel}
        </label>
        <select id="food-select" class="w-full text-sm rounded-xl border border-hairline bg-surface-soft p-2.5 text-ink focus:outline-none focus:ring-2 focus:ring-emerald-500">
          {data.foodContactMatrices.map((f) => (
            <option value={f.id} selected={f.id === 'raw-poultry-pork'}>
              {f.name}
            </option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1">{d.foodHelp}</p>
      </div>

      <!-- Control 5: Drying Micro-Climate -->
      <div>
        <label for="drying-select" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-1">
          {d.dryingLabel}
        </label>
        <select id="drying-select" class="w-full text-sm rounded-xl border border-hairline bg-surface-soft p-2.5 text-ink focus:outline-none focus:ring-2 focus:ring-emerald-500">
          {data.dryingEnvironments.map((dr) => (
            <option value={dr.id} selected={dr.id === 'well-ventilated-rack'}>
              {dr.name}
            </option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1">{d.dryingHelp}</p>
      </div>

      <!-- Control 6: Micro-Crack Slider -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <label for="crack-slider" class="text-xs font-semibold text-ink uppercase tracking-wider">
            {d.crackSliderLabel}
          </label>
          <span id="crack-slider-val" class="text-xs font-bold font-mono text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">
            25 µm (Pristine)
          </span>
        </div>
        <input 
          type="range" 
          id="crack-slider" 
          min="10" 
          max="800" 
          step="10" 
          value="25" 
          class="w-full accent-emerald-600 cursor-pointer"
        />
        <div class="flex justify-between text-[10px] text-muted font-mono mt-1">
          <span>10 µm (Polished)</span>
          <span>150 µm (Raised)</span>
          <span>350 µm (Fissures)</span>
          <span>800 µm (Split)</span>
        </div>
        <p class="text-[11px] text-muted mt-1">{d.crackSliderHelp}</p>
      </div>
    </div>

    <!-- Diagnostic Results Column (7 cols) -->
    <div class="lg:col-span-7 space-y-6">
      <div class="bg-canvas p-6 md:p-8 rounded-2xl border border-hairline">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-6 pb-4 border-b border-hairline">
          <div>
            <h3 class="text-base font-bold text-ink">{d.diagnosticTitle}</h3>
            <p class="text-xs text-muted mt-0.5">{d.diagnosticSub}</p>
          </div>
          <span id="hazard-badge" class="px-3 py-1 rounded-full text-xs font-extrabold uppercase tracking-wider bg-emerald-100 text-emerald-800 border border-emerald-300">
            Grade A: Sanitary
          </span>
        </div>

        <!-- Big Risk Metric -->
        <div class="p-5 rounded-2xl bg-surface-soft border border-hairline mb-6 flex flex-col sm:flex-row items-center justify-between gap-4">
          <div>
            <div class="text-xs font-mono font-bold uppercase tracking-wider text-muted mb-1">
              {d.overallScoreLabel}
            </div>
            <div class="text-3xl md:text-4xl font-extrabold text-ink tracking-tight flex items-baseline gap-2">
              <span id="hazard-score">14</span>
              <span class="text-sm font-normal text-muted">/ 100</span>
            </div>
            <div class="text-xs text-muted mt-1" id="hazard-summary">
              Safe baseline: low porosity and intact hydrophobic barrier inhibit bacterial penetration.
            </div>
          </div>
          <div class="w-full sm:w-44 bg-surface-strong h-3 rounded-full overflow-hidden border border-hairline">
            <div id="hazard-progress" class="bg-emerald-500 h-full w-[14%] transition-all duration-300"></div>
          </div>
        </div>

        <!-- 6 Metrics Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
          <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
            <div class="text-xs text-muted mb-1">{d.crackWidthLabel}</div>
            <div class="text-xl font-bold font-mono text-ink" id="out-crack-width">25 µm</div>
            <div class="text-[11px] text-muted mt-0.5" id="out-crack-desc">Pores microscopic; closed grain</div>
          </div>

          <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
            <div class="text-xs text-muted mb-1">{d.moistureRetentionLabel}</div>
            <div class="text-xl font-bold font-mono text-ink" id="out-moisture-aw">Aw 0.48</div>
            <div class="text-[11px] text-muted mt-0.5" id="out-moisture-desc">Dry core; bacterial multiplication blocked</div>
          </div>

          <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
            <div class="text-xs text-muted mb-1">{d.bacterialLoadLabel}</div>
            <div class="text-xl font-bold font-mono text-ink" id="out-bacterial-load">1.2 log CFU/cm²</div>
            <div class="text-[11px] text-muted mt-0.5" id="out-bacterial-desc">Minimal surface retention</div>
          </div>

          <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
            <div class="text-xs text-muted mb-1">{d.transferRateLabel}</div>
            <div class="text-xl font-bold font-mono text-ink" id="out-transfer-rate">0.8%</div>
            <div class="text-[11px] text-muted mt-0.5" id="out-transfer-desc">Low shedding into food</div>
          </div>

          <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
            <div class="text-xs text-muted mb-1">{d.pathogenTransferLabel}</div>
            <div class="text-xl font-bold font-mono text-ink" id="out-pathogen-transfer">&lt; 10 CFU</div>
            <div class="text-[11px] text-muted mt-0.5" id="out-pathogen-desc">Below infectious dose threshold</div>
          </div>

          <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
            <div class="text-xs text-muted mb-1">{d.enterotoxinRiskLabel}</div>
            <div class="text-xl font-bold font-mono text-ink" id="out-enterotoxin">Negligible</div>
            <div class="text-[11px] text-muted mt-0.5" id="out-enterotoxin-desc">No Staph biofilm accumulation</div>
          </div>
        </div>

        <!-- Clinical & Action Recommendation -->
        <div id="clinical-card" class="p-5 rounded-2xl bg-emerald-50 border border-emerald-200 mb-6 transition-colors">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-lg">🛡️</span>
            <h4 class="text-sm font-bold text-emerald-950 uppercase tracking-wide">
              {d.alertTitle}
            </h4>
          </div>
          <p id="clinical-text" class="text-xs leading-relaxed text-emerald-900">
            <strong>Optimal Sanitary Status:</strong> This utensil exhibits tight wood grain and effective hydrophobic mineral oil protection. Capillary action is suppressed, moisture dries within 90 minutes, and cross-contamination risk into subsequent prepared foods is negligible.
          </p>
        </div>

        <!-- Copy Diagnostic Report Button -->
        <div class="flex flex-col sm:flex-row items-center gap-3">
          <button 
            type="button" 
            id="copy-report-btn" 
            class="w-full sm:w-auto px-5 py-2.5 rounded-xl bg-emerald-700 hover:bg-emerald-800 text-white font-medium text-xs transition-colors shadow-xs flex items-center justify-center gap-2"
          >
            <span>{d.copyReportBtn}</span>
          </button>
          <span id="copied-toast" class="text-xs text-emerald-600 font-semibold hidden">
            {d.copiedFeedback}
          </span>
        </div>
      </div>
    </div>
  </div>

  <!-- Table: Culinary Wood Comparison Matrix -->
  <div class="mt-12 bg-canvas p-6 md:p-8 rounded-2xl border border-hairline">
    <div class="mb-6">
      <h3 class="text-lg font-bold text-ink">{d.tableTitle}</h3>
      <p class="text-xs text-muted mt-0.5">{d.tableSub}</p>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-xs">
        <thead>
          <tr class="border-b border-hairline bg-surface-soft text-muted font-mono uppercase tracking-wider">
            <th class="p-3">{d.colSpecies}</th>
            <th class="p-3">{d.colHardness}</th>
            <th class="p-3">{d.colPores}</th>
            <th class="p-3">{d.colDishwasher}</th>
            <th class="p-3">{d.colCapillary}</th>
            <th class="p-3">{d.colVerdict}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline">
          {data.woodSpecies.map((w) => (
            <tr class="hover:bg-surface-soft/60 transition-colors">
              <td class="p-3 font-semibold text-ink">
                {w.name}
                <span class="block text-[10px] text-muted font-normal">{w.category}</span>
              </td>
              <td class="p-3 font-mono text-ink">{w.jankaHardnessLbf} lbf</td>
              <td class="p-3 text-body">{w.poreStructure}</td>
              <td class="p-3 text-body">{w.dishwasherVulnerability}</td>
              <td class="p-3 text-body">{w.capillaryAbsorptionRate}</td>
              <td class="p-3 font-medium text-emerald-800 bg-emerald-50/50 rounded-lg">
                {w.id === 'hard-maple' || w.id === 'mediterranean-olive' || w.id === 'acacia' ? 'Recommended (Handwash)' : w.id === 'softwood-pine' ? 'Unsuitable for Meats' : 'Moderate (Oil Care Required)'}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- 5 Golden Rules Section -->
  <div class="mt-12 bg-canvas p-6 md:p-8 rounded-2xl border border-hairline">
    <div class="mb-6">
      <h3 class="text-lg font-bold text-ink">{d.rulesTitle}</h3>
      <p class="text-xs text-muted mt-0.5">{d.rulesSub}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="p-5 rounded-xl bg-surface-soft border border-hairline space-y-2">
        <h4 class="font-bold text-ink text-sm flex items-center gap-2">
          <span>🚫</span>
          {d.rule1Title}
        </h4>
        <p class="text-xs text-body leading-relaxed">{d.rule1Text}</p>
      </div>

      <div class="p-5 rounded-xl bg-surface-soft border border-hairline space-y-2">
        <h4 class="font-bold text-ink text-sm flex items-center gap-2">
          <span>🧴</span>
          {d.rule2Title}
        </h4>
        <p class="text-xs text-body leading-relaxed">{d.rule2Text}</p>
      </div>

      <div class="p-5 rounded-xl bg-surface-soft border border-hairline space-y-2">
        <h4 class="font-bold text-ink text-sm flex items-center gap-2">
          <span>♨️</span>
          {d.rule3Title}
        </h4>
        <p class="text-xs text-body leading-relaxed">{d.rule3Text}</p>
      </div>

      <div class="p-5 rounded-xl bg-surface-soft border border-hairline space-y-2">
        <h4 class="font-bold text-ink text-sm flex items-center gap-2">
          <span>🌬️</span>
          {d.rule4Title}
        </h4>
        <p class="text-xs text-body leading-relaxed">{d.rule4Text}</p>
      </div>

      <div class="p-5 rounded-xl bg-surface-soft border border-hairline space-y-2 md:col-span-2">
        <h4 class="font-bold text-ink text-sm flex items-center gap-2">
          <span>📏</span>
          {d.rule5Title}
        </h4>
        <p class="text-xs text-body leading-relaxed">{d.rule5Text}</p>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ data, lang }}>
  // Interactive client-side modeler
  const speciesSelect = document.getElementById('species-select');
  const exposureSelect = document.getElementById('exposure-select');
  const conditioningSelect = document.getElementById('conditioning-select');
  const foodSelect = document.getElementById('food-select');
  const dryingSelect = document.getElementById('drying-select');
  const crackSlider = document.getElementById('crack-slider');
  const crackSliderVal = document.getElementById('crack-slider-val');

  // Outputs
  const hazardBadge = document.getElementById('hazard-badge');
  const hazardScore = document.getElementById('hazard-score');
  const hazardSummary = document.getElementById('hazard-summary');
  const hazardProgress = document.getElementById('hazard-progress');
  const outCrackWidth = document.getElementById('out-crack-width');
  const outCrackDesc = document.getElementById('out-crack-desc');
  const outMoistureAw = document.getElementById('out-moisture-aw');
  const outMoistureDesc = document.getElementById('out-moisture-desc');
  const outBacterialLoad = document.getElementById('out-bacterial-load');
  const outBacterialDesc = document.getElementById('out-bacterial-desc');
  const outTransferRate = document.getElementById('out-transfer-rate');
  const outTransferDesc = document.getElementById('out-transfer-desc');
  const outPathogenTransfer = document.getElementById('out-pathogen-transfer');
  const outPathogenDesc = document.getElementById('out-pathogen-desc');
  const outEnterotoxin = document.getElementById('out-enterotoxin');
  const outEnterotoxinDesc = document.getElementById('out-enterotoxin-desc');
  const clinicalCard = document.getElementById('clinical-card');
  const clinicalText = document.getElementById('clinical-text');
  const copyReportBtn = document.getElementById('copy-report-btn');
  const copiedToast = document.getElementById('copied-toast');

  const speciesMap = {};
  data.woodSpecies.forEach(s => speciesMap[s.id] = s);

  const exposureMap = {};
  data.exposureHistories.forEach(e => exposureMap[e.id] = e);

  const conditioningMap = {};
  data.conditioningStatuses.forEach(c => conditioningMap[c.id] = c);

  const foodMap = {};
  data.foodContactMatrices.forEach(f => foodMap[f.id] = f);

  const dryingMap = {};
  data.dryingEnvironments.forEach(dr => dryingMap[dr.id] = dr);

  function calculateModel() {
    const species = speciesMap[speciesSelect.value];
    const exposure = exposureMap[exposureSelect.value];
    const conditioning = conditioningMap[conditioningSelect.value];
    const food = foodMap[foodSelect.value];
    const drying = dryingMap[dryingSelect.value];
    const sliderCrack = parseInt(crackSlider.value, 10);

    // Calculate effective crack width
    // Base species crack * exposure multiplier blended with manual slider inspection
    const autoCrack = species.baseMicroCrackMicrons * exposure.crackMultiplier;
    const effectiveCrack = Math.max(sliderCrack, Math.round(autoCrack));

    // Internal water activity (Aw)
    // Aw is driven by drying environment, conditioning repellency, and crack expansion
    let baseAw = 0.45;
    if (drying.id === 'well-ventilated-rack') baseAw = 0.52;
    else if (drying.id === 'crowded-crock') baseAw = 0.82;
    else if (drying.id === 'closed-dark-drawer') baseAw = 0.94;

    // Conditioning reduces Aw by sealing pores
    const oilProtection = conditioning.moistureAbsorptionReduction;
    const finalAw = Math.min(0.99, Math.max(0.35, baseAw * (1 - oilProtection * 0.45) + (effectiveCrack / 2500)));

    // Bacterial Load Retention (log CFU/cm2)
    // Inoculum from food, modulated by crack depth, conditioning barrier, and species antimicrobials
    let naturalSpeciesInhibition = 1.0;
    if (species.id === 'mediterranean-olive') naturalSpeciesInhibition = 0.65;
    else if (species.id === 'acacia') naturalSpeciesInhibition = 0.75;
    else if (species.id === 'softwood-pine') naturalSpeciesInhibition = 1.45;

    let conditioningLogModifier = 0.0;
    if (conditioning.id === 'well-conditioned-mineral-oil') conditioningLogModifier = -1.8;
    else if (conditioning.id === 'infrequent-mineral-oil') conditioningLogModifier = -0.5;
    else if (conditioning.id === 'unconditioned-parched') conditioningLogModifier = 1.2;
    else if (conditioning.id === 'rancid-cooking-oil') conditioningLogModifier = 1.9; // Rancid lipids feed bacteria

    const initialLog = Math.log10(Math.max(10, food.pathogenLoadCfuCm2));
    const crackLogFactor = Math.log10(Math.max(1, effectiveCrack / 20));
    
    // Thermal kill if hot stew
    let thermalKillLog = 0;
    if (food.id === 'hot-acidic-stew') thermalKillLog = 4.2;

    const residualLog = Math.max(0.5, (initialLog + crackLogFactor + conditioningLogModifier - thermalKillLog) * naturalSpeciesInhibition);
    const residualCfu = Math.round(Math.pow(10, residualLog));

    // Transfer rate into next food contact (%)
    let transferFactor = food.baseTransferRate;
    if (conditioning.id === 'well-conditioned-mineral-oil') transferFactor *= 0.35;
    else if (conditioning.id === 'rancid-cooking-oil') transferFactor *= 1.8;
    if (effectiveCrack > 300) transferFactor *= 1.6;

    const transferPercent = Math.min(35.0, Math.max(0.1, transferFactor * 100));
    const transferredCfu = Math.round(residualCfu * (transferPercent / 100));

    // Biofilm Contamination Hazard Index (0 to 100)
    let score = 0;
    // Cracks contribution (max 35)
    score += Math.min(35, (effectiveCrack / 600) * 35);
    // Moisture Aw contribution (max 25)
    score += Math.max(0, (finalAw - 0.50) / 0.45) * 25;
    // Pathogen & conditioning contribution (max 30)
    if (conditioning.id === 'rancid-cooking-oil') score += 20;
    else if (conditioning.id === 'unconditioned-parched') score += 12;
    else if (conditioning.id === 'infrequent-mineral-oil') score += 5;
    
    if (food.id === 'raw-poultry-pork' || food.id === 'ready-to-eat-salad') score += 15;
    else if (food.id === 'raw-ground-beef') score += 10;

    // Drying environment penalty (max 10)
    if (drying.id === 'closed-dark-drawer') score += 10;
    else if (drying.id === 'crowded-crock') score += 6;

    score = Math.min(100, Math.max(5, Math.round(score)));

    // UI Updates
    hazardScore.textContent = score.toString();
    hazardProgress.style.width = score + '%';

    outCrackWidth.textContent = `${effectiveCrack} µm`;
    if (effectiveCrack < 50) outCrackDesc.textContent = "Tight closed grain; micro-cavities sealed";
    else if (effectiveCrack < 150) outCrackDesc.textContent = "Slight fiber lifting & grain raise";
    else if (effectiveCrack < 350) outCrackDesc.textContent = "Distinct longitudinal fissures";
    else outCrackDesc.textContent = "Deep structural splitting > 1mm";

    outMoistureAw.textContent = `Aw ${finalAw.toFixed(2)}`;
    if (finalAw < 0.60) outMoistureDesc.textContent = "Bacteriostatic dry threshold (< 0.60)";
    else if (finalAw < 0.80) outMoistureDesc.textContent = "Slow fungal & mold germination zone";
    else outMoistureDesc.textContent = "Active microbial replication zone (Aw > 0.85)";

    outBacterialLoad.textContent = `${residualLog.toFixed(1)} log CFU/cm²`;
    outBacterialDesc.textContent = `~${residualCfu.toLocaleString()} viable bacteria / cm²`;

    outTransferRate.textContent = `${transferPercent.toFixed(1)}%`;
    outTransferDesc.textContent = "Release into prepared food per contact";

    outPathogenTransfer.textContent = transferredCfu > 1000 ? `~${transferredCfu.toLocaleString()} CFU` : `${transferredCfu} CFU`;
    if (transferredCfu < 10) outPathogenDesc.textContent = "Below known clinical infection thresholds";
    else if (transferredCfu < 100) outPathogenDesc.textContent = "Marginal infectious threshold for Salmonella";
    else outPathogenDesc.textContent = "High risk of clinical acute salmonellosis / E. coli";

    if (score < 40) {
      outEnterotoxin.textContent = "Negligible";
      outEnterotoxinDesc.textContent = "No Staph biofilm accumulation";
    } else if (score < 75) {
      outEnterotoxin.textContent = "Moderate Risk";
      outEnterotoxinDesc.textContent = "Staphylococcus aureus colonizing cracks";
    } else {
      outEnterotoxin.textContent = "CRITICAL RISK";
      outEnterotoxinDesc.textContent = "Heat-stable Enterotoxin A formation possible";
    }

    // Grade classification
    if (score <= 25) {
      hazardBadge.textContent = "Grade A: Sanitary";
      hazardBadge.className = "px-3 py-1 rounded-full text-xs font-extrabold uppercase tracking-wider bg-emerald-100 text-emerald-800 border border-emerald-300";
      hazardProgress.className = "bg-emerald-500 h-full transition-all duration-300";
      clinicalCard.className = "p-5 rounded-2xl bg-emerald-50 border border-emerald-200 mb-6 transition-colors";
      clinicalText.innerHTML = `<strong>Optimal Sanitary Status:</strong> Wood fibers remain compact and effectively sealed by hydrophobic mineral oil. Capillary action is blocked, surface drying is rapid, and pathogen retention is well below infectious thresholds. Safe for all culinary applications.`;
      hazardSummary.textContent = "Pristine wood grain and effective hydrophobic sealant prevent microbial colonization.";
    } else if (score <= 50) {
      hazardBadge.textContent = "Grade B: Low-Moderate Risk";
      hazardBadge.className = "px-3 py-1 rounded-full text-xs font-extrabold uppercase tracking-wider bg-lime-100 text-lime-900 border border-lime-300";
      hazardProgress.className = "bg-lime-500 h-full transition-all duration-300";
      clinicalCard.className = "p-5 rounded-2xl bg-lime-50 border border-lime-200 mb-6 transition-colors";
      clinicalText.innerHTML = `<strong>Re-Conditioning Required:</strong> Early surface checking or dried wood fibers are absorbing food moisture. Immediate treatment with food-grade USP mineral oil is recommended to replenish the hydrophobic barrier. Safe for cooked foods, but avoid raw poultry contact.`;
      hazardSummary.textContent = "Wood is parched or experiencing initial grain raise. Oil conditioning needed.";
    } else if (score <= 75) {
      hazardBadge.textContent = "Grade C: High Risk Biofilm";
      hazardBadge.className = "px-3 py-1 rounded-full text-xs font-extrabold uppercase tracking-wider bg-amber-100 text-amber-900 border border-amber-300";
      hazardProgress.className = "bg-amber-500 h-full transition-all duration-300";
      clinicalCard.className = "p-5 rounded-2xl bg-amber-50 border border-amber-200 mb-6 transition-colors";
      clinicalText.innerHTML = `<strong>Relegate from Raw Proteins & Ready-to-Eat Foods:</strong> Dishwasher exposure or rancid oil has opened significant micro-fissures (150–350 µm). Viable Salmonella and Staph reside inside deep pores. Strictly prohibit contact with raw meats or cold ready-to-eat salads. Submerge in boiling water for 3 minutes before any reuse.`;
      hazardSummary.textContent = "Significant micro-cracks present. Deep bacterial survival active.";
    } else {
      hazardBadge.textContent = "Grade F: Severe Hazard / Retire";
      hazardBadge.className = "px-3 py-1 rounded-full text-xs font-extrabold uppercase tracking-wider bg-rose-100 text-rose-900 border border-rose-300";
      hazardProgress.className = "bg-rose-500 h-full transition-all duration-300";
      clinicalCard.className = "p-5 rounded-2xl bg-rose-50 border border-rose-200 mb-6 transition-colors";
      clinicalText.innerHTML = `<strong>IMMEDIATE RETIREMENT REQUIRED:</strong> Deep longitudinal splits (> 500 µm), delaminated bamboo glue lines, or rancid lipid polymerization present an irremediable biological hazard. Bacteria form permanent multi-species extracellular biofilms protected from soap and sanitizers. Discard utensil immediately to prevent foodborne illness.`;
      hazardSummary.textContent = "Permanent biological reservoir. Micro-cracks exceed 500 µm. Discard immediately.";
    }
  }

  // Update slider label on input
  crackSlider.addEventListener('input', () => {
    const val = parseInt(crackSlider.value, 10);
    let label = `${val} µm`;
    if (val < 50) label += " (Polished)";
    else if (val < 150) label += " (Grain Raise)";
    else if (val < 350) label += " (Fissures)";
    else label += " (Severe Split)";
    crackSliderVal.textContent = label;
    calculateModel();
  });

  // Event listeners for selects
  [speciesSelect, exposureSelect, conditioningSelect, foodSelect, dryingSelect].forEach(select => {
    select.addEventListener('change', () => {
      // Auto-adjust slider if exposure changed
      if (select === exposureSelect || select === speciesSelect) {
        const species = speciesMap[speciesSelect.value];
        const exposure = exposureMap[exposureSelect.value];
        const computed = Math.min(800, Math.round(species.baseMicroCrackMicrons * exposure.crackMultiplier));
        crackSlider.value = computed.toString();
        crackSliderVal.textContent = `${computed} µm`;
      }
      calculateModel();
    });
  });

  // Presets handling
  document.querySelectorAll('.preset-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const p = btn.getAttribute('data-preset');
      if (p === 'raw-chicken') {
        speciesSelect.value = 'european-beech';
        exposureSelect.value = 'handwash-only';
        conditioningSelect.value = 'unconditioned-parched';
        foodSelect.value = 'raw-poultry-pork';
        dryingSelect.value = 'well-ventilated-rack';
        crackSlider.value = '45';
      } else if (p === 'dishwasher-beech') {
        speciesSelect.value = 'european-beech';
        exposureSelect.value = 'chronic-dishwasher';
        conditioningSelect.value = 'unconditioned-parched';
        foodSelect.value = 'raw-poultry-pork';
        dryingSelect.value = 'crowded-crock';
        crackSlider.value = '420';
      } else if (p === 'pristine-maple') {
        speciesSelect.value = 'hard-maple';
        exposureSelect.value = 'handwash-only';
        conditioningSelect.value = 'well-conditioned-mineral-oil';
        foodSelect.value = 'hot-acidic-stew';
        dryingSelect.value = 'well-ventilated-rack';
        crackSlider.value = '25';
      } else if (p === 'bamboo-delam') {
        speciesSelect.value = 'moso-bamboo';
        exposureSelect.value = 'frequent-dishwasher';
        conditioningSelect.value = 'unconditioned-parched';
        foodSelect.value = 'ready-to-eat-salad';
        dryingSelect.value = 'crowded-crock';
        crackSlider.value = '380';
      } else if (p === 'rancid-oil') {
        speciesSelect.value = 'mediterranean-olive';
        exposureSelect.value = 'occasional-dishwasher';
        conditioningSelect.value = 'rancid-cooking-oil';
        foodSelect.value = 'ready-to-eat-salad';
        dryingSelect.value = 'closed-dark-drawer';
        crackSlider.value = '180';
      } else if (p === 'baby-food') {
        speciesSelect.value = 'softwood-pine';
        exposureSelect.value = 'occasional-dishwasher';
        conditioningSelect.value = 'infrequent-mineral-oil';
        foodSelect.value = 'ready-to-eat-salad';
        dryingSelect.value = 'crowded-crock';
        crackSlider.value = '260';
      }

      const val = parseInt(crackSlider.value, 10);
      crackSliderVal.textContent = `${val} µm`;
      calculateModel();
    });
  });

  // Copy report
  if (copyReportBtn) {
    copyReportBtn.addEventListener('click', () => {
      const speciesName = speciesSelect.options[speciesSelect.selectedIndex].text;
      const exposureName = exposureSelect.options[exposureSelect.selectedIndex].text;
      const conditioningName = conditioningSelect.options[conditioningSelect.selectedIndex].text;
      const foodName = foodSelect.options[foodSelect.selectedIndex].text;
      const dryingName = dryingSelect.options[dryingSelect.selectedIndex].text;

      const reportText = `=== ISITKITCHENSAFE WOODEN SPOON BIOFILM & MICRO-CRACK DIAGNOSTIC REPORT ===
Timestamp: ${new Date().toISOString()}
Timber Substrate: ${speciesName}
Dishwasher History: ${exposureName}
Conditioning: ${conditioningName}
Food Matrix Contact: ${foodName}
Post-Wash Drying: ${dryingName}
Surface Micro-Crack Width: ${outCrackWidth.textContent}

--- MICROBIOLOGICAL FINDINGS ---
Biofilm Contamination Hazard Index: ${hazardScore.textContent} / 100 (${hazardBadge.textContent.trim()})
Internal Water Activity: ${outMoistureAw.textContent}
Viable Pathogen Retention: ${outBacterialLoad.textContent}
Cross-Contamination Transfer Rate: ${outTransferRate.textContent}
Estimated Ingestion per Serving: ${outPathogenTransfer.textContent}
Staphylococcus Enterotoxin Risk: ${outEnterotoxin.textContent}

--- CLINICAL RECOMMENDATION ---
${clinicalText.innerText}
================================================================================`;

      navigator.clipboard.writeText(reportText).then(() => {
        copiedToast.classList.remove('hidden');
        setTimeout(() => {
          copiedToast.classList.add('hidden');
        }, 3000);
      });
    });
  }

  // Initial run
  calculateModel();
</script>
