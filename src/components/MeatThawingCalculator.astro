  cutNoteHeading: string;
  checklistHeading: string;
  checklistSub: string;
  dangerZoneBannerTitle: string;
  dangerZoneBannerBody: string;
  checklists: {
    fridge: string[];
    coldWater: string[];
    microwave: string[];
    cookFrozen: string[];
  };
  comparisonTitle: string;
  comparisonSub: string;
  comparisonHeaders: [string, string, string, string];
  comparisonNotes: {
    fridge: string;
    coldWater: string;
    microwaveOk: string;
    microwaveNotRec: string;
    cookFrozen: string;
  };
  refreezeBtnLabel: string;
  copyBtn: string;
  copiedBtn: string;
  resetBtn: string;
  units: {
    day: string;
    days: string;
    hr: string;
    hrs: string;
    min: string;
    mins: string;
    approxPrefix: string;
    cookTimePlus50: string;
    startNowOrSwitch: string;
  };
}

