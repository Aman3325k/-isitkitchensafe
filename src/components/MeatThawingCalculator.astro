const initialCut = localizedCuts[0];

const clientPayload = {
  lang,
  defaultUnit,
  cuts: localizedCuts,
  presets: localizedPresets,
  ui: t
};
---

<section
  id="meat-thawing-calculator"
  class="bg-canvas border border-hairline rounded-2xl shadow-sm overflow-hidden"
  aria-label={t.dashboardBadge}
>
  <script
    type="application/json"
    id="mtc-payload"
    is:inline
    set:html={JSON.stringify(clientPayload)}
  />

  <!-- Top Quick Presets Strip -->
  <div class="bg-surface-soft border-b border-hairline px-5 py-4">
    <div class="flex flex-wrap items-center justify-between gap-2 mb-2.5">
      <span class="text-xs font-bold uppercase tracking-wider text-muted">
        {t.quickPresetsLabel}
      </span>
      <button
        type="button"
        id="mtc-reset-btn"
        class="text-xs font-semibold text-link hover:text-link-active underline cursor-pointer"
      >
        {t.resetBtn}
      </button>
    </div>
    <div class="flex flex-wrap gap-2" role="group" aria-label={t.quickPresetsLabel}>
      {localizedPresets.map((preset, idx) => (
        <button
          type="button"
          data-mtc-preset-cut={preset.cutId}
          data-mtc-preset-lbs={preset.weightLbs}
          class={`mtc-preset-btn px-3 py-1.5 rounded-full text-xs font-semibold border transition-all cursor-pointer ${
            idx === 0
              ? 'bg-primary text-on-primary border-primary shadow-xs'
              : 'bg-canvas text-ink border-hairline hover:border-signature-coral'
          }`}
        >
          {preset.label}
        </button>
      ))}
    </div>
  </div>

  <!-- Main 2-Column Calculator Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 divide-y lg:divide-y-0 lg:divide-x divide-hairline">
    <!-- Left Column: Controls -->
    <div class="lg:col-span-5 p-5 md:p-6 space-y-6 bg-canvas">
      <!-- Step 1: Cut & Weight -->
      <div class="space-y-4">
        <h2 class="text-title-sm font-semibold text-ink tracking-tight">
          {t.step1Title}
        </h2>

        <!-- Cut Selector -->
        <div>
          <label for="mtc-cut-select" class="block text-xs font-semibold text-muted mb-1.5">
            {t.selectCutLabel}
          </label>
          <select
            id="mtc-cut-select"
            class="w-full px-3.5 py-2.5 rounded-xl border border-hairline bg-canvas text-ink text-sm font-medium focus:outline-none focus:border-signature-coral cursor-pointer"
          >
            {localizedCuts.map((cut) => (
              <option value={cut.id} selected={cut.id === initialCut.id}>
                {cut.name}
              </option>
            ))}
          </select>
        </div>

        <!-- Weight Input + Unit Toggle + Slider -->
        <div class="p-4 rounded-xl bg-surface-soft border border-hairline space-y-3">
          <div class="flex items-center justify-between gap-2">
            <label for="mtc-weight-input" class="text-xs font-semibold text-ink">
              {t.weightLabel}
            </label>
            <div class="inline-flex rounded-lg border border-hairline bg-canvas p-0.5" role="group" aria-label="Weight unit">
              <button
                type="button"
                data-mtc-unit="lbs"
                aria-pressed={defaultUnit === 'lbs' ? 'true' : 'false'}
                class={`mtc-unit-btn px-2.5 py-1 rounded-md text-xs font-bold transition-all cursor-pointer ${
                  defaultUnit === 'lbs'
                    ? 'bg-primary text-on-primary'
                    : 'text-body hover:text-ink'
                }`}
              >
                {t.unitLbs}
              </button>
              <button
                type="button"
                data-mtc-unit="kg"
                aria-pressed={defaultUnit === 'kg' ? 'true' : 'false'}
                class={`mtc-unit-btn px-2.5 py-1 rounded-md text-xs font-bold transition-all cursor-pointer ${
                  defaultUnit === 'kg'
                    ? 'bg-primary text-on-primary'
                    : 'text-body hover:text-ink'
                }`}
              >
                {t.unitKg}
              </button>
            </div>
          </div>

          <div class="flex items-center gap-3">
            <input
              type="number"
              id="mtc-weight-input"
              min="8"
              max="24"
              step="0.5"
              value="16"
              class="w-28 px-3 py-2 rounded-lg border border-hairline bg-canvas text-ink text-base font-bold text-center focus:outline-none focus:border-signature-coral"
            />
            <span id="mtc-weight-secondary" class="text-xs font-medium text-muted">
              = 7.3 kg
            </span>
          </div>

          <div>
            <input
              type="range"
              id="mtc-weight-slider"
              min="8"
              max="24"
              step="0.5"
              value="16"
              aria-label={t.weightLabel}
              class="w-full accent-signature-coral cursor-pointer"
            />
            <div class="flex justify-between text-[11px] text-muted mt-1">
              <span id="mtc-weight-min">8 lbs</span>
              <span id="mtc-weight-mid">16 lbs</span>
              <span id="mtc-weight-max">24 lbs</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Step 2: Target Date & Method -->
      <div class="space-y-4 pt-2 border-t border-hairline">
        <h2 class="text-title-sm font-semibold text-ink tracking-tight">
          {t.step2Title}
        </h2>

        <!-- Target Cook Date & Time -->
        <div>
          <label for="mtc-cook-datetime" class="block text-xs font-semibold text-muted mb-1.5">
            {t.targetCookLabel}
          </label>
          <input
            type="datetime-local"
            id="mtc-cook-datetime"
            class="w-full px-3.5 py-2.5 rounded-xl border border-hairline bg-canvas text-ink text-sm font-medium focus:outline-none focus:border-signature-coral"
          />
          <p class="text-[11.5px] text-muted mt-1.5 leading-snug">
            {t.targetCookHint}
          </p>
        </div>

        <!-- Method Selector -->
        <div>
          <span class="block text-xs font-semibold text-muted mb-2">
            {t.methodLabel}
          </span>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5" role="group" aria-label={t.methodLabel}>
            {(['fridge', 'cold-water', 'microwave', 'cook-frozen'] as MethodKey[]).map((mKey) => {
              const meta = t.methods[mKey];
              const isDefault = mKey === 'fridge';
              return (
                <button
                  type="button"
                  data-mtc-method={mKey}
                  aria-pressed={isDefault ? 'true' : 'false'}
                  class={`mtc-method-btn text-left p-3 rounded-xl border transition-all cursor-pointer ${
                    isDefault
                      ? 'bg-primary text-on-primary border-primary shadow-xs'
                      : 'bg-canvas text-ink border-hairline hover:border-signature-coral'
                  }`}
                >
                  <div class="flex items-center justify-between gap-1.5 mb-0.5">
                    <span class="text-xs font-bold">{meta.title}</span>
                    <span
                      class={`mtc-method-badge px-1.5 py-0.5 rounded text-[10px] font-bold ${
                        isDefault
                          ? 'bg-white/20 text-white'
                          : 'bg-surface-soft text-muted border border-hairline'
                      }`}
                    >
                      {meta.badge}
                    </span>
                  </div>
                  <div class={`mtc-method-sub text-[11px] leading-tight ${isDefault ? 'opacity-85' : 'text-muted'}`}>
                    {meta.sub}
                  </div>
                </button>
              );
            })}
          </div>
        </div>
      </div>

      <!-- Permanent Countertop Danger Zone Warning -->
      <div class="p-4 rounded-xl bg-error-bg border border-error-border/70">
        <div class="text-xs font-extrabold text-error uppercase tracking-wide mb-1">
          ⛔ {t.dangerZoneBannerTitle}
        </div>
        <p class="text-[12.5px] text-body leading-relaxed">
          {t.dangerZoneBannerBody}
        </p>
      </div>
    </div>

    <!-- Right Column: Live Dashboard Output -->
    <div class="lg:col-span-7 p-5 md:p-6 space-y-5 bg-surface-soft/40">
      <!-- Prominent Hero Callout Banner -->
      <div id="mtc-hero-banner" class="p-5 rounded-2xl border-2 bg-emerald-50 border-emerald-500 transition-colors">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
          <span
            id="mtc-status-pill"
            class="inline-flex items-center px-3 py-1 rounded-full text-xs font-extrabold tracking-wide bg-emerald-600 text-white"
          >
            {t.statusPills.fridge}
          </span>
          <span id="mtc-selected-summary" class="text-xs font-bold text-ink">
            {initialCut.name} · 16 lbs (7.3 kg)
          </span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="p-3.5 rounded-xl bg-canvas border border-hairline/80">
            <div class="text-[11px] font-bold uppercase tracking-wider text-muted mb-1">
              {t.startThawingByLabel}
            </div>
            <div id="mtc-start-by" class="text-lg md:text-xl font-bold text-ink leading-tight">
              —
            </div>
          </div>

          <div class="p-3.5 rounded-xl bg-canvas border border-hairline/80">
            <div class="text-[11px] font-bold uppercase tracking-wider text-muted mb-1">
              {t.totalThawDurationLabel}
            </div>
            <div id="mtc-duration" class="text-lg md:text-xl font-bold text-ink leading-tight">
              3–4 days (77–96 hrs)
            </div>
          </div>
        </div>

        <!-- Dynamic Urgent Alert (Too Late or Microwave Blocked) -->
        <div id="mtc-alert-box" class="hidden mt-3.5 p-3 rounded-xl bg-canvas/90 border border-error-border text-[13px] font-semibold text-error leading-snug">
        </div>
      </div>

      <!-- Conditional Critical Seafood Vacuum-Seal Botulism Alert -->
      <div id="mtc-botulism-box" class="hidden p-4 rounded-xl bg-error-bg border-2 border-error text-ink">
        <div class="text-xs font-extrabold text-error uppercase tracking-wide mb-1">
          ⚠️ {t.botulismBannerTitle}
        </div>
        <p class="text-[13px] text-body leading-relaxed">
          {t.botulismBannerBody}
        </p>
      </div>

      <!-- 3 Key USDA Safety Metrics -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div class="p-3.5 rounded-xl bg-canvas border border-hairline">
          <div class="text-[11px] font-bold uppercase tracking-wider text-muted mb-1">
            {t.metrics.postThawTitle}
          </div>
          <div id="mtc-post-thaw-val" class="text-sm font-bold text-ink leading-snug">
            1–2 days after thawed
          </div>
          <div id="mtc-post-thaw-sub" class="text-[11.5px] text-muted mt-1 leading-snug">
            {t.metrics.postThawFridgeSub}
          </div>
        </div>

        <div class="p-3.5 rounded-xl bg-canvas border border-hairline">
          <div class="text-[11px] font-bold uppercase tracking-wider text-muted mb-1">
            {t.metrics.safeTempTitle}
          </div>
          <div id="mtc-safe-temp-val" class="text-sm font-bold text-signature-coral leading-snug">
            {initialCut.safeTempLabel}
          </div>
          <div id="mtc-temp-loc-sub" class="text-[11.5px] text-muted mt-1 leading-snug">
            {initialCut.tempCheckLocation}
          </div>
        </div>

        <div class="p-3.5 rounded-xl bg-canvas border border-hairline">
          <div id="mtc-third-card-title" class="text-[11px] font-bold uppercase tracking-wider text-muted mb-1">
            {t.metrics.refreezeTitle}
          </div>
          <div id="mtc-third-card-val" class="text-sm font-bold text-ink leading-snug">
            {t.metrics.refreezeFridgeYes}
          </div>
          <div id="mtc-third-card-sub" class="text-[11.5px] text-muted mt-1 leading-snug">
            USDA FSIS
          </div>
        </div>
      </div>

      <!-- Cut-Specific USDA Note -->
      <div class="p-4 rounded-xl bg-canvas border border-hairline">
        <div class="text-xs font-bold uppercase tracking-wider text-signature-coral mb-1">
          {t.cutNoteHeading}
        </div>
        <p id="mtc-cut-note" class="text-[13.5px] text-body leading-relaxed">
          {initialCut.cutNote}
        </p>
      </div>

      <!-- Step-by-Step Safety Checklist -->
      <div class="p-4 rounded-xl bg-canvas border border-hairline space-y-2.5">
        <div>
          <h3 class="text-sm font-bold text-ink">
            {t.checklistHeading}
          </h3>
          <p class="text-[12px] text-muted">
            {t.checklistSub}
          </p>
        </div>
        <div id="mtc-checklist" class="space-y-2 pt-1"></div>
      </div>

      <!-- All-Method Side-by-Side Comparison Table -->
      <div class="rounded-xl bg-canvas border border-hairline overflow-hidden">
        <div class="px-4 py-3 bg-surface-soft border-b border-hairline">
          <h3 class="text-sm font-bold text-ink">
            {t.comparisonTitle}
          </h3>
          <p class="text-[12px] text-muted">
            {t.comparisonSub}
          </p>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs md:text-[13px]">
            <thead class="bg-surface-strong/60 border-b border-hairline text-ink font-semibold">
              <tr>
                <th class="p-3">{t.comparisonHeaders[0]}</th>
                <th class="p-3">{t.comparisonHeaders[1]}</th>
                <th class="p-3">{t.comparisonHeaders[2]}</th>
                <th class="p-3">{t.comparisonHeaders[3]}</th>
              </tr>
            </thead>
            <tbody id="mtc-comparison-tbody" class="divide-y divide-hairline"></tbody>
          </table>
        </div>
      </div>

      <!-- Bottom Action Bar -->
      <div class="flex flex-wrap items-center justify-between gap-3 pt-1">
        <a
          href={refreezeUrl}
          class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl text-xs font-bold bg-primary text-on-primary hover:bg-primary-active transition-colors"
        >
          <span>{t.refreezeBtnLabel}</span>
          <span aria-hidden="true">&rarr;</span>
        </a>

        <button
          type="button"
          id="mtc-copy-btn"
          class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral transition-colors cursor-pointer"
        >
          <span id="mtc-copy-label">{t.copyBtn}</span>
        </button>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const payloadEl = document.getElementById('mtc-payload');
    if (!payloadEl) return;

    let payload;
    try {
      payload = JSON.parse(payloadEl.textContent || '{}');
    } catch (_) {
      return;
    }

    const cuts = payload.cuts || [];
    const ui = payload.ui || {};
    const byId = new Map(cuts.map((c) => [c.id, c]));
    if (!cuts.length) return;

    const LBS_TO_KG = 0.45359237;

    const cutSelect = document.getElementById('mtc-cut-select');
    const weightInput = document.getElementById('mtc-weight-input');
    const weightSlider = document.getElementById('mtc-weight-slider');
    const weightSecondary = document.getElementById('mtc-weight-secondary');
    const weightMinEl = document.getElementById('mtc-weight-min');
    const weightMidEl = document.getElementById('mtc-weight-mid');
    const weightMaxEl = document.getElementById('mtc-weight-max');
    const cookDatetimeInput = document.getElementById('mtc-cook-datetime');
    const resetBtn = document.getElementById('mtc-reset-btn');
    const copyBtn = document.getElementById('mtc-copy-btn');
    const copyLabel = document.getElementById('mtc-copy-label');

    const presetButtons = Array.from(document.querySelectorAll('.mtc-preset-btn'));
    const unitButtons = Array.from(document.querySelectorAll('.mtc-unit-btn'));
    const methodButtons = Array.from(document.querySelectorAll('.mtc-method-btn'));

    const heroBanner = document.getElementById('mtc-hero-banner');
    const statusPill = document.getElementById('mtc-status-pill');
    const selectedSummary = document.getElementById('mtc-selected-summary');
    const startByEl = document.getElementById('mtc-start-by');
    const durationEl = document.getElementById('mtc-duration');
    const alertBox = document.getElementById('mtc-alert-box');
    const botulismBox = document.getElementById('mtc-botulism-box');

    const postThawVal = document.getElementById('mtc-post-thaw-val');
    const postThawSub = document.getElementById('mtc-post-thaw-sub');
    const safeTempVal = document.getElementById('mtc-safe-temp-val');
    const tempLocSub = document.getElementById('mtc-temp-loc-sub');
    const thirdCardTitle = document.getElementById('mtc-third-card-title');
    const thirdCardVal = document.getElementById('mtc-third-card-val');
    const thirdCardSub = document.getElementById('mtc-third-card-sub');
    const cutNoteEl = document.getElementById('mtc-cut-note');
    const checklistEl = document.getElementById('mtc-checklist');
    const compTbody = document.getElementById('mtc-comparison-tbody');

    function toDatetimeLocalValue(dateObj) {
      const pad = (n) => String(n).padStart(2, '0');
      return (
        dateObj.getFullYear() +
        '-' +
        pad(dateObj.getMonth() + 1) +
        '-' +
        pad(dateObj.getDate()) +
        'T' +
        pad(dateObj.getHours()) +
        ':' +
        pad(dateObj.getMinutes())
      );
    }

    function getDefaultCookDate() {
      const d = new Date();
      d.setDate(d.getDate() + 4);
      d.setHours(12, 0, 0, 0);
      return d;
    }

    let state = {
      cutId: cuts[0].id,
      weightLbs: cuts[0].defaultLbs,
      unit: payload.defaultUnit || 'lbs',
      method: 'fridge',
      cookDate: getDefaultCookDate()
    };

    if (cookDatetimeInput) {
      cookDatetimeInput.value = toDatetimeLocalValue(state.cookDate);
    }

    function roundTo(val, decimals) {
      const factor = Math.pow(10, decimals);
      return Math.round(val * factor) / factor;
    }

    function formatWeightPair(lbs) {
      const lbsClean = roundTo(lbs, 2);
      const kgClean = roundTo(lbs * LBS_TO_KG, 2);
      return state.unit === 'lbs'
        ? `${lbsClean} lb (${kgClean} kg)`
        : `${kgClean} kg (${lbsClean} lb)`;
    }

    function formatDateShort(dateObj) {
      try {
        return new Intl.DateTimeFormat(ui.localeCode || 'en-US', {
          weekday: 'short',
          month: 'short',
          day: 'numeric',
          hour: 'numeric',
          minute: '2-digit'
        }).format(dateObj);
      } catch (_) {
        return dateObj.toLocaleString();
      }
    }

    function formatHoursHuman(hoursMin, hoursMax) {
      const u = ui.units;
      if (hoursMax >= 36) {
        const dMin = roundTo(hoursMin / 24, 1);
        const dMax = roundTo(hoursMax / 24, 1);
        const hMinR = Math.round(hoursMin);
        const hMaxR = Math.round(hoursMax);
        const dayStr = dMin === dMax ? `${dMax} ${dMax === 1 ? u.day : u.days}` : `${dMin}–${dMax} ${u.days}`;
        const hrStr = hMinR === hMaxR ? `${hMaxR} ${u.hrs}` : `${hMinR}–${hMaxR} ${u.hrs}`;
        return `${dayStr} (${hrStr})`;
      }
      const hMinR = Math.round(hoursMin);
      const hMaxR = Math.round(hoursMax);
      if (hMinR === hMaxR) {
        return `${hMaxR} ${hMaxR === 1 ? u.hr : u.hrs}`;
      }
      return `${hMinR}–${hMaxR} ${u.hrs}`;
    }

    function formatMinutesHuman(totalMinutes) {
      const u = ui.units;
      const minsR = Math.round(totalMinutes);
      if (minsR < 60) {
        return `${u.approxPrefix}${minsR} ${minsR === 1 ? u.min : u.mins}`;
      }
      const hrs = Math.floor(minsR / 60);
      const rem = minsR % 60;
      if (rem === 0) {
        return `${u.approxPrefix}${hrs} ${hrs === 1 ? u.hr : u.hrs}`;
      }
      return `${u.approxPrefix}${hrs} ${hrs === 1 ? u.hr : u.hrs} ${rem} ${u.mins}`;
    }

    function calcMethodEstimates(cut, weightLbs) {
      // 1. Refrigerator
      const fridgeMinHrs = Math.max(cut.fridgeMinHours, weightLbs * cut.fridgeHoursPerLbMin);
      const fridgeMaxHrs = Math.max(cut.fridgeMinHours, weightLbs * cut.fridgeHoursPerLbMax);
      const fridgePlanHrs = Math.ceil(fridgeMaxHrs);

      // 2. Cold Water Bath
      const coldWaterMins = Math.max(cut.coldWaterMinMinutes, Math.round(weightLbs * cut.coldWaterMinPerLb));
      const waterChanges = Math.max(1, Math.ceil(coldWaterMins / 30));

      // 3. Microwave
      const microwaveAllowed = cut.microwaveMaxLbs > 0 && weightLbs <= cut.microwaveMaxLbs && cut.microwaveMinPerLb > 0;
      const microwaveMins = microwaveAllowed ? Math.max(5, Math.round(weightLbs * cut.microwaveMinPerLb)) : 0;

      return {
        fridgeMinHrs,
        fridgeMaxHrs,
        fridgePlanHrs,
        coldWaterMins,
        waterChanges,
        microwaveAllowed,
        microwaveMins
      };
    }

    function syncWeightControls() {
      const cut = byId.get(state.cutId) || cuts[0];
      const clampedLbs = Math.min(cut.maxLbs, Math.max(cut.minLbs, state.weightLbs));
      state.weightLbs = clampedLbs;

      const isKg = state.unit === 'kg';
      const minDisp = isKg ? roundTo(cut.minLbs * LBS_TO_KG, 2) : cut.minLbs;
      const maxDisp = isKg ? roundTo(cut.maxLbs * LBS_TO_KG, 2) : cut.maxLbs;
      const stepDisp = isKg ? 0.1 : cut.stepLbs;
      const valDisp = isKg ? roundTo(state.weightLbs * LBS_TO_KG, 2) : roundTo(state.weightLbs, 2);

      if (weightInput) {
        weightInput.min = String(minDisp);
        weightInput.max = String(maxDisp);
        weightInput.step = String(stepDisp);
        weightInput.value = String(valDisp);
      }
      if (weightSlider) {
        weightSlider.min = String(minDisp);
        weightSlider.max = String(maxDisp);
        weightSlider.step = String(stepDisp);
        weightSlider.value = String(valDisp);
      }
      if (weightSecondary) {
        weightSecondary.textContent = isKg
          ? `= ${roundTo(state.weightLbs, 2)} lbs`
          : `= ${roundTo(state.weightLbs * LBS_TO_KG, 2)} kg`;
      }
      const unitShort = isKg ? 'kg' : 'lbs';
      if (weightMinEl) weightMinEl.textContent = `${minDisp} ${unitShort}`;
      if (weightMidEl) weightMidEl.textContent = `${roundTo((minDisp + maxDisp) / 2, 1)} ${unitShort}`;
      if (weightMaxEl) weightMaxEl.textContent = `${maxDisp} ${unitShort}`;
    }

    function updateUnitButtons() {
      unitButtons.forEach((btn) => {
        const isAct = btn.getAttribute('data-mtc-unit') === state.unit;
        btn.setAttribute('aria-pressed', isAct ? 'true' : 'false');
        if (isAct) {
          btn.classList.add('bg-primary', 'text-on-primary');
          btn.classList.remove('text-body');
        } else {
          btn.classList.remove('bg-primary', 'text-on-primary');
          btn.classList.add('text-body');
        }
      });
    }

    function updatePresetButtons() {
      presetButtons.forEach((btn) => {
        const pCut = btn.getAttribute('data-mtc-preset-cut');
        const pLbs = parseFloat(btn.getAttribute('data-mtc-preset-lbs') || '0');
        const isAct = pCut === state.cutId && Math.abs(pLbs - state.weightLbs) < 0.15;
        if (isAct) {
          btn.classList.add('bg-primary', 'text-on-primary', 'border-primary', 'shadow-xs');
          btn.classList.remove('bg-canvas', 'text-ink', 'border-hairline');
        } else {
          btn.classList.remove('bg-primary', 'text-on-primary', 'border-primary', 'shadow-xs');
          btn.classList.add('bg-canvas', 'text-ink', 'border-hairline');
        }
      });
    }

    function updateMethodButtons() {
      methodButtons.forEach((btn) => {
        const isAct = btn.getAttribute('data-mtc-method') === state.method;
        btn.setAttribute('aria-pressed', isAct ? 'true' : 'false');
        const badge = btn.querySelector('.mtc-method-badge');
        const sub = btn.querySelector('.mtc-method-sub');
        if (isAct) {
          btn.classList.add('bg-primary', 'text-on-primary', 'border-primary', 'shadow-xs');
          btn.classList.remove('bg-canvas', 'text-ink', 'border-hairline');
          if (badge) {
            badge.classList.add('bg-white/20', 'text-white');
            badge.classList.remove('bg-surface-soft', 'text-muted', 'border', 'border-hairline');
          }
          if (sub) {
            sub.classList.add('opacity-85');
            sub.classList.remove('text-muted');
          }
        } else {
          btn.classList.remove('bg-primary', 'text-on-primary', 'border-primary', 'shadow-xs');
          btn.classList.add('bg-canvas', 'text-ink', 'border-hairline');
          if (badge) {
            badge.classList.remove('bg-white/20', 'text-white');
            badge.classList.add('bg-surface-soft', 'text-muted', 'border', 'border-hairline');
          }
          if (sub) {
            sub.classList.remove('opacity-85');
            sub.classList.add('text-muted');
          }
        }
      });
    }

    function applyHeroTheme(theme) {
      if (!heroBanner || !statusPill) return;
      heroBanner.className = 'p-5 rounded-2xl border-2 transition-colors ';
      statusPill.className = 'inline-flex items-center px-3 py-1 rounded-full text-xs font-extrabold tracking-wide ';
      if (theme === 'error') {
        heroBanner.className += 'bg-red-50 border-red-600';
        statusPill.className += 'bg-red-600 text-white';
      } else if (theme === 'warn') {
        heroBanner.className += 'bg-amber-50 border-amber-500';
        statusPill.className += 'bg-amber-500 text-slate-950';
      } else if (theme === 'info') {
        heroBanner.className += 'bg-blue-50 border-blue-500';
        statusPill.className += 'bg-blue-600 text-white';
      } else {
        heroBanner.className += 'bg-emerald-50 border-emerald-500';
        statusPill.className += 'bg-emerald-600 text-white';
      }
    }

    let lastScheduleSummary = '';

    function render() {
      const cut = byId.get(state.cutId) || cuts[0];
      const est = calcMethodEstimates(cut, state.weightLbs);
      const nowMs = Date.now();
      const cookMs = state.cookDate ? state.cookDate.getTime() : getDefaultCookDate().getTime();

      if (selectedSummary) {
        selectedSummary.textContent = `${cut.name} · ${formatWeightPair(state.weightLbs)}`;
      }

      // Conditional seafood botulism alert
      if (botulismBox) {
        if (cut.specialAlertType === 'botulism-fish') {
          botulismBox.classList.remove('hidden');
        } else {
          botulismBox.classList.add('hidden');
        }
      }

      // Compute startBy & hero display per method
      let startByText = '—';
      let durationText = '—';
      let heroTheme = 'safe';
      let pillText = ui.statusPills.fridge;
      let alertMessage = '';

      const fridgeStartMs = cookMs - est.fridgePlanHrs * 3600000;
      const coldWaterStartMs = cookMs - est.coldWaterMins * 60000;
      const microwaveStartMs = est.microwaveAllowed ? cookMs - est.microwaveMins * 60000 : null;

      if (state.method === 'fridge') {
        durationText = formatHoursHuman(est.fridgeMinHrs, est.fridgeMaxHrs);
        startByText = formatDateShort(new Date(fridgeStartMs));
        if (fridgeStartMs < nowMs) {
          heroTheme = 'warn';
          pillText = ui.statusPills.tooLate;
          alertMessage = ui.tooLateWarning;
        } else {
          heroTheme = 'safe';
          pillText = ui.statusPills.fridge;
        }
      } else if (state.method === 'cold-water') {
        durationText = formatMinutesHuman(est.coldWaterMins);
        startByText = formatDateShort(new Date(coldWaterStartMs));
        if (coldWaterStartMs < nowMs) {
          heroTheme = 'warn';
          pillText = ui.statusPills.tooLate;
          alertMessage = ui.units.startNowOrSwitch;
        } else {
          heroTheme = 'info';
          pillText = ui.statusPills.coldWater;
        }
      } else if (state.method === 'microwave') {
        if (!est.microwaveAllowed) {
          durationText = ui.notRecommendedDuration;
          startByText = '—';
          heroTheme = 'error';
          pillText = ui.statusPills.notRecommended;
          alertMessage = ui.microwaveBlockedWarning;
        } else {
          durationText = formatMinutesHuman(est.microwaveMins);
          startByText = formatDateShort(new Date(microwaveStartMs));
          heroTheme = 'warn';
          pillText = ui.statusPills.microwave;
        }
      } else {
        durationText = ui.noThawNeededDuration;
        startByText = `${ui.cookDirectlyText} (${formatDateShort(new Date(cookMs))})`;
        heroTheme = 'safe';
        pillText = ui.statusPills.cookFrozen;
      }

      applyHeroTheme(heroTheme);
      if (statusPill) statusPill.textContent = pillText;
      if (startByEl) startByEl.textContent = startByText;
      if (durationEl) durationEl.textContent = durationText;

      if (alertBox) {
        if (alertMessage) {
          alertBox.textContent = alertMessage;
          alertBox.classList.remove('hidden');
        } else {
          alertBox.textContent = '';
          alertBox.classList.add('hidden');
        }
      }

      // Metric cards
      const fridgeWindowStr = ui.metrics.postThawFridgeValue
        .replace('{min}', String(cut.postThawFridgeMinDays))
        .replace('{max}', String(cut.postThawFridgeMaxDays));

      if (postThawVal && postThawSub) {
        if (state.method === 'fridge') {
          postThawVal.textContent = fridgeWindowStr;
          postThawSub.textContent = ui.metrics.postThawFridgeSub;
        } else if (state.method === 'cook-frozen') {
          postThawVal.textContent = ui.metrics.postThawFrozenValue;
          postThawSub.textContent = ui.metrics.postThawFrozenSub;
        } else {
          postThawVal.textContent = ui.metrics.postThawImmediateValue;
          postThawSub.textContent = ui.metrics.postThawImmediateSub;
        }
      }

      if (safeTempVal) safeTempVal.textContent = cut.safeTempLabel;
      if (tempLocSub) tempLocSub.textContent = cut.tempCheckLocation;

      if (thirdCardTitle && thirdCardVal && thirdCardSub) {
        if (state.method === 'cold-water') {
          thirdCardTitle.textContent = ui.metrics.waterChangesTitle;
          thirdCardVal.textContent = ui.metrics.waterChangesValue.replace('{count}', String(est.waterChanges));
          thirdCardSub.textContent = ui.metrics.waterChangesSub;
        } else if (state.method === 'fridge') {
          thirdCardTitle.textContent = ui.metrics.refreezeTitle;
          thirdCardVal.textContent = ui.metrics.refreezeFridgeYes;
          thirdCardSub.textContent = 'USDA FSIS';
        } else if (state.method === 'cook-frozen') {
          thirdCardTitle.textContent = ui.metrics.refreezeTitle;
          thirdCardVal.textContent = ui.metrics.refreezeFrozenNA;
          thirdCardSub.textContent = ui.units.cookTimePlus50;
        } else {
          thirdCardTitle.textContent = ui.metrics.refreezeTitle;
          thirdCardVal.textContent = ui.metrics.refreezeCookFirst;
          thirdCardSub.textContent = 'USDA FSIS';
        }
      }

      if (cutNoteEl) {
        cutNoteEl.textContent = state.method === 'cook-frozen' ? cut.cookFromFrozenNote : cut.cutNote;
      }

      // Checklist
      if (checklistEl) {
        checklistEl.innerHTML = '';
        const listKey =
          state.method === 'cold-water'
            ? 'coldWater'
            : state.method === 'cook-frozen'
              ? 'cookFrozen'
              : state.method;
        const steps = (ui.checklists && ui.checklists[listKey]) || [];
        steps.forEach((rawStep) => {
          const text = rawStep
            .replace('{window}', fridgeWindowStr)
            .replace('{changes}', String(est.waterChanges))
            .replace('{mins}', String(est.microwaveMins || 10))
            .replace('{temp}', cut.safeTempLabel);

          const label = document.createElement('label');
          label.className = 'flex items-start gap-2.5 text-[13px] text-body leading-relaxed cursor-pointer';
          const cb = document.createElement('input');
          cb.type = 'checkbox';
          cb.className = 'mt-1 w-4 h-4 rounded accent-signature-coral cursor-pointer shrink-0';
          const span = document.createElement('span');
          span.textContent = text;
          label.appendChild(cb);
          label.appendChild(span);
          checklistEl.appendChild(label);
        });
      }

      // Comparison Table
      if (compTbody) {
        compTbody.innerHTML = '';
        const rows = [
          {
            key: 'fridge',
            name: ui.methods.fridge.title,
            time: formatHoursHuman(est.fridgeMinHrs, est.fridgeMaxHrs),
            startBy: formatDateShort(new Date(fridgeStartMs)),
            note: ui.comparisonNotes.fridge
              .replace('{min}', String(cut.postThawFridgeMinDays))
              .replace('{max}', String(cut.postThawFridgeMaxDays))
          },
          {
            key: 'cold-water',
            name: ui.methods['cold-water'].title,
            time: formatMinutesHuman(est.coldWaterMins),
            startBy: formatDateShort(new Date(coldWaterStartMs)),
            note: ui.comparisonNotes.coldWater.replace('{changes}', String(est.waterChanges))
          },
          {
            key: 'microwave',
            name: ui.methods.microwave.title,
            time: est.microwaveAllowed ? formatMinutesHuman(est.microwaveMins) : ui.notRecommendedDuration,
            startBy: est.microwaveAllowed ? formatDateShort(new Date(microwaveStartMs)) : '—',
            note: est.microwaveAllowed
              ? ui.comparisonNotes.microwaveOk
              : ui.comparisonNotes.microwaveNotRec.replace('{max}', String(cut.microwaveMaxLbs))
          },
          {
            key: 'cook-frozen',
            name: ui.methods['cook-frozen'].title,
            time: ui.units.cookTimePlus50,
            startBy: formatDateShort(new Date(cookMs)),
            note: ui.comparisonNotes.cookFrozen
          }
        ];

        rows.forEach((row) => {
          const tr = document.createElement('tr');
          const isAct = row.key === state.method;
          tr.className = isAct
            ? 'bg-signature-cream/60 font-semibold text-ink cursor-pointer transition-colors'
            : 'bg-canvas hover:bg-surface-soft text-body cursor-pointer transition-colors';
          tr.setAttribute('data-mtc-comp-method', row.key);

          const td1 = document.createElement('td');
          td1.className = 'p-3 font-semibold text-ink whitespace-nowrap';
          td1.textContent = isAct ? `● ${row.name}` : row.name;

          const td2 = document.createElement('td');
          td2.className = 'p-3 whitespace-nowrap';
          td2.textContent = row.time;

          const td3 = document.createElement('td');
          td3.className = 'p-3 whitespace-nowrap';
          td3.textContent = row.startBy;

          const td4 = document.createElement('td');
          td4.className = 'p-3';
          td4.textContent = row.note;

          tr.appendChild(td1);
          tr.appendChild(td2);
          tr.appendChild(td3);
          tr.appendChild(td4);

          tr.addEventListener('click', () => {
            state.method = row.key;
            updateMethodButtons();
            render();
          });

          compTbody.appendChild(tr);
        });
      }

      lastScheduleSummary = [
        `${cut.name} (${formatWeightPair(state.weightLbs)})`,
        `${ui.methodLabel}: ${ui.methods[state.method].title}`,
        `${ui.startThawingByLabel}: ${startByText}`,
        `${ui.totalThawDurationLabel}: ${durationText}`,
        `${ui.metrics.safeTempTitle}: ${cut.safeTempLabel}`
      ].join('\n');
    }

    // Event bindings
    if (cutSelect) {
      cutSelect.addEventListener('change', () => {
        const newCut = byId.get(cutSelect.value);
        if (!newCut) return;
        state.cutId = newCut.id;
        state.weightLbs = newCut.defaultLbs;
        syncWeightControls();
        updatePresetButtons();
        render();
      });
    }

    function applyWeightFromDisplay(rawVal) {
      const parsed = parseFloat(rawVal);
      if (Number.isNaN(parsed) || parsed <= 0) return;
      const cut = byId.get(state.cutId) || cuts[0];
      const lbs = state.unit === 'kg' ? parsed / LBS_TO_KG : parsed;
      state.weightLbs = Math.min(cut.maxLbs, Math.max(cut.minLbs, lbs));
      if (weightSecondary) {
        weightSecondary.textContent =
          state.unit === 'kg'
            ? `= ${roundTo(state.weightLbs, 2)} lbs`
            : `= ${roundTo(state.weightLbs * LBS_TO_KG, 2)} kg`;
      }
      updatePresetButtons();
      render();
    }

    if (weightSlider) {
      weightSlider.addEventListener('input', () => {
        if (weightInput) weightInput.value = weightSlider.value;
        applyWeightFromDisplay(weightSlider.value);
      });
    }

    if (weightInput) {
      weightInput.addEventListener('input', () => {
        if (weightSlider) weightSlider.value = weightInput.value;
        applyWeightFromDisplay(weightInput.value);
      });
      weightInput.addEventListener('blur', () => {
        syncWeightControls();
        render();
      });
    }

    unitButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const nextUnit = btn.getAttribute('data-mtc-unit');
        if (!nextUnit || nextUnit === state.unit) return;
        state.unit = nextUnit;
        updateUnitButtons();
        syncWeightControls();
        render();
      });
    });

    if (cookDatetimeInput) {
      cookDatetimeInput.addEventListener('change', () => {
        const parsed = new Date(cookDatetimeInput.value);
        if (!Number.isNaN(parsed.getTime())) {
          state.cookDate = parsed;
          render();
        }
      });
    }

    methodButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const nextMethod = btn.getAttribute('data-mtc-method');
        if (!nextMethod) return;
        state.method = nextMethod;
        updateMethodButtons();
        render();
      });
    });

    presetButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const pCut = btn.getAttribute('data-mtc-preset-cut');
        const pLbs = parseFloat(btn.getAttribute('data-mtc-preset-lbs') || '0');
        if (!pCut || !byId.has(pCut)) return;
        state.cutId = pCut;
        state.weightLbs = pLbs;
        if (cutSelect) cutSelect.value = pCut;
        syncWeightControls();
        updatePresetButtons();
        render();
      });
    });

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        state.cutId = cuts[0].id;
        state.weightLbs = cuts[0].defaultLbs;
        state.method = 'fridge';
        state.cookDate = getDefaultCookDate();
        if (cutSelect) cutSelect.value = state.cutId;
        if (cookDatetimeInput) cookDatetimeInput.value = toDatetimeLocalValue(state.cookDate);
        syncWeightControls();
        updatePresetButtons();
        updateMethodButtons();
        render();
      });
    }

    if (copyBtn && copyLabel) {
      copyBtn.addEventListener('click', () => {
        if (!navigator.clipboard || !lastScheduleSummary) return;
        navigator.clipboard.writeText(lastScheduleSummary).then(() => {
          copyLabel.textContent = ui.copiedBtn || 'Copied';
          setTimeout(() => {
            copyLabel.textContent = ui.copyBtn || 'Copy';
          }, 2200);
        }).catch(() => {});
      });
    }

    // Initial mount
    updateUnitButtons();
    syncWeightControls();
    updatePresetButtons();
    updateMethodButtons();
    render();
  })();
</script>
