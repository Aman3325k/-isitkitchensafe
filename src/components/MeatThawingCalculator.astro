  metrics: {
    postThawTitle: string;
    postThawFridgeValue: string;
    postThawImmediateValue: string;
    postThawFrozenValue: string;
    postThawFridgeSub: string;
    postThawImmediateSub: string;
    postThawFrozenSub: string;
    safeTempTitle: string;
    refreezeTitle: string;
    refreezeFridgeYes: string;
    refreezeCookFirst: string;
    refreezeFrozenNA: string;
    waterChangesTitle: string;
    waterChangesValue: string;
    waterChangesSub: string;
