---
import rawData from '../data/meat-thawing-calculator-data.json';
import type { SupportedLanguage } from '../i18n/ui';
import { getDirectoryUrl } from '../i18n/utils';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;

type MethodKey = 'fridge' | 'cold-water' | 'microwave' | 'cook-frozen';

interface LocalizedCut {
  id: string;
  name: string;
  minLbs: number;
  maxLbs: number;
  defaultLbs: number;
  stepLbs: number;
  fridgeHoursPerLbMin: number;
  fridgeHoursPerLbMax: number;
  fridgeMinHours: number;
  coldWaterMinPerLb: number;
  coldWaterMinMinutes: number;
  microwaveMinPerLb: number;
  microwaveMaxLbs: number;
  cookFromFrozenAllowed: boolean;
  postThawFridgeMinDays: number;
  postThawFridgeMaxDays: number;
  safeTempF: number;
  safeTempC: number;
  restMinutes: number;
  refreezeAfterFridge: boolean;
  specialAlertType: string;
  safeTempLabel: string;
  tempCheckLocation: string;
  cutNote: string;
  cookFromFrozenNote: string;
}

const localizedCuts: LocalizedCut[] = rawData.cuts.map((cut) => {
  const tr = (cut.i18n as Record<string, any>)[lang] || cut.i18n.en;
  return {
    id: cut.id,
    name: tr.name,
    minLbs: cut.minLbs,
    maxLbs: cut.maxLbs,
    defaultLbs: cut.defaultLbs,
    stepLbs: cut.stepLbs,
    fridgeHoursPerLbMin: cut.fridgeHoursPerLbMin,
    fridgeHoursPerLbMax: cut.fridgeHoursPerLbMax,
    fridgeMinHours: cut.fridgeMinHours,
    coldWaterMinPerLb: cut.coldWaterMinPerLb,
    coldWaterMinMinutes: cut.coldWaterMinMinutes,
    microwaveMinPerLb: cut.microwaveMinPerLb,
    microwaveMaxLbs: cut.microwaveMaxLbs,
    cookFromFrozenAllowed: cut.cookFromFrozenAllowed,
    postThawFridgeMinDays: cut.postThawFridgeMinDays,
    postThawFridgeMaxDays: cut.postThawFridgeMaxDays,
    safeTempF: cut.safeTempF,
    safeTempC: cut.safeTempC,
    restMinutes: cut.restMinutes,
    refreezeAfterFridge: cut.refreezeAfterFridge,
    specialAlertType: cut.specialAlertType,
    safeTempLabel: tr.safeTempLabel,
    tempCheckLocation: tr.tempCheckLocation,
    cutNote: tr.cutNote,
    cookFromFrozenNote: tr.cookFromFrozenNote
  };
});

const localizedPresets = rawData.presets.map((p) => ({
  id: p.id,
  cutId: p.cutId,
  weightLbs: p.weightLbs,
  label: (p.labels as Record<string, string>)[lang] || p.labels.en
}));

const defaultUnit = lang === 'en' ? 'lbs' : 'kg';
const refreezeUrl = getDirectoryUrl('refreeze', lang);

interface UiDict {
  localeCode: string;
  step1Title: string;
  quickPresetsLabel: string;
  selectCutLabel: string;
  weightLabel: string;
  unitLbs: string;
  unitKg: string;
  step2Title: string;
  targetCookLabel: string;
  targetCookHint: string;
  methodLabel: string;
  methods: Record<MethodKey, { title: string; badge: string; sub: string }>;
  dashboardBadge: string;
  startThawingByLabel: string;
  totalThawDurationLabel: string;
  cookDirectlyText: string;
  noThawNeededDuration: string;
  notRecommendedDuration: string;
  tooLateWarning: string;
  microwaveBlockedWarning: string;
  botulismBannerTitle: string;
  botulismBannerBody: string;
  statusPills: {
    fridge: string;
    coldWater: string;
    microwave: string;
    cookFrozen: string;
    tooLate: string;
    notRecommended: string;
