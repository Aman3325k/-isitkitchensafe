  <!-- Regulatory Compliance Rules -->
  <div class="bg-surface border border-hairline rounded-2xl p-6 shadow-xs">
    <div class="border-b border-hairline pb-4 mb-5">
      <h3 class="text-title-sm font-semibold text-ink">
        {d.rulesTitle}
      </h3>
      <p class="text-xs text-muted mt-1">
        {d.rulesSub}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 text-xs">
      <div class="border border-hairline/80 rounded-xl p-4 bg-surface-soft/50">
        <h4 class="font-bold text-ink mb-1.5 flex items-center gap-1.5">
          <span class="text-amber-600 font-mono">§1.</span>
          <span>{d.rule1Title}</span>
        </h4>
        <p class="text-muted leading-relaxed text-[11px]">
          {d.rule1Text}
        </p>
      </div>

      <div class="border border-hairline/80 rounded-xl p-4 bg-surface-soft/50">
        <h4 class="font-bold text-ink mb-1.5 flex items-center gap-1.5">
          <span class="text-amber-600 font-mono">§2.</span>
          <span>{d.rule2Title}</span>
        </h4>
        <p class="text-muted leading-relaxed text-[11px]">
          {d.rule2Text}
        </p>
      </div>

      <div class="border border-hairline/80 rounded-xl p-4 bg-surface-soft/50">
        <h4 class="font-bold text-ink mb-1.5 flex items-center gap-1.5">
          <span class="text-amber-600 font-mono">§3.</span>
          <span>{d.rule3Title}</span>
        </h4>
        <p class="text-muted leading-relaxed text-[11px]">
          {d.rule3Text}
        </p>
      </div>

      <div class="border border-hairline/80 rounded-xl p-4 bg-surface-soft/50">
        <h4 class="font-bold text-ink mb-1.5 flex items-center gap-1.5">
          <span class="text-amber-600 font-mono">§4.</span>
          <span>{d.rule4Title}</span>
        </h4>
        <p class="text-muted leading-relaxed text-[11px]">
          {d.rule4Text}
        </p>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ extrusionDataJson: JSON.stringify(extrusionData), langCode: lang }}>
(function() {
  const modelData = JSON.parse(extrusionDataJson);

  // DOM Elements
  const selExtruder = document.getElementById('select-extruder');
  const selFormulation = document.getElementById('select-formulation');
  const selMetallurgy = document.getElementById('select-metallurgy');

  const rngRpm = document.getElementById('range-rpm');
  const rngTemp = document.getElementById('range-temp');
  const rngThroughput = document.getElementById('range-throughput');
  const rngMoisture = document.getElementById('range-moisture');
  const rngDieOpen = document.getElementById('range-die-open');
  const rngClearance = document.getElementById('range-clearance');
  const rngHours = document.getElementById('range-hours');

  const valRpm = document.getElementById('val-rpm');
  const valTemp = document.getElementById('val-temp');
  const valThroughput = document.getElementById('val-throughput');
  const valMoisture = document.getElementById('val-moisture');
  const valDieOpen = document.getElementById('val-die-open');
  const valClearance = document.getElementById('val-clearance');
  const valHours = document.getElementById('val-hours');

  // Telemetry outputs
  const outShearRate = document.getElementById('telemetry-shear-rate');
  const outShearStatus = document.getElementById('telemetry-shear-status');
  const outViscousHeat = document.getElementById('telemetry-viscous-heat');
  const outViscousStatus = document.getElementById('telemetry-viscous-status');
  const outGelatinization = document.getElementById('telemetry-gelatinization');
  const outGelStatus = document.getElementById('telemetry-gel-status');
  const outSme = document.getElementById('telemetry-sme');
  const outSmeStatus = document.getElementById('telemetry-sme-status');
  const outDiePressure = document.getElementById('telemetry-die-pressure');
  const outPressureStatus = document.getElementById('telemetry-pressure-status');
  const outBurstMargin = document.getElementById('telemetry-burst-margin');
  const outBurstStatus = document.getElementById('telemetry-burst-status');
  const outViscosity = document.getElementById('telemetry-viscosity');
  const outViscStatus = document.getElementById('telemetry-visc-status');
  const outLinerWear = document.getElementById('telemetry-liner-wear');
  const outWearStatus = document.getElementById('telemetry-wear-status');

  const boxSafetyStatus = document.getElementById('box-safety-status');
  const iconSafetyStatus = document.getElementById('icon-safety-status');
  const badgeSafetyVerdict = document.getElementById('badge-safety-verdict');
  const descPrimaryRisk = document.getElementById('desc-primary-risk');
  const descMechanisms = document.getElementById('desc-mechanisms');
  const descMitigation = document.getElementById('desc-mitigation');
  const badgeBarrelStatus = document.getElementById('badge-barrel-status');

  // SVG dynamic texts
  const svgValShear = document.getElementById('svg-val-shear');
  const svgValSme = document.getElementById('svg-val-sme');
  const svgValDieP = document.getElementById('svg-val-die-p');
  const svgValGel = document.getElementById('svg-val-gel');

  // Presets & copy
  const btnPresetPuff = document.getElementById('btn-preset-puff');
  const btnPresetTvp = document.getElementById('btn-preset-tvp');
  const btnPresetScorched = document.getElementById('btn-preset-scorched');
  const btnPresetBurst = document.getElementById('btn-preset-burst');
  const btnCopyReport = document.getElementById('btn-copy-report');
  const btnCopyText = document.getElementById('btn-copy-text');

  function calculateExtrusionModel() {
    const archId = selExtruder ? selExtruder.value : 'twin_screw_corotating_high_shear_extruder';
    const formId = selFormulation ? selFormulation.value : 'corn_starch_expanded_snack';
    const metId = selMetallurgy ? selMetallurgy.value : 'bimetallic_tungsten_carbide_liner';

    const arch = modelData.extruderArchitectures.find(a => a.id === archId) || modelData.extruderArchitectures[0];
    const form = modelData.foodFormulationProfiles.find(f => f.id === formId) || modelData.foodFormulationProfiles[0];
    const met = modelData.screwBarrelMetallurgies.find(m => m.id === metId) || modelData.screwBarrelMetallurgies[0];

    const rpm = parseFloat(rngRpm.value);
    const tempC = parseFloat(rngTemp.value);
    const throughputKgH = parseFloat(rngThroughput.value);
    const moisture = parseFloat(rngMoisture.value);
    const dieOpenPct = parseFloat(rngDieOpen.value);
    const clearanceMm = parseFloat(rngClearance.value);
    const hours = parseFloat(rngHours.value);

    // Update labels
    valRpm.textContent = `${rpm} RPM`;
    valTemp.textContent = `${tempC} °C (${Math.round(tempC * 1.8 + 32)} °F)`;
    valThroughput.textContent = `${throughputKgH} kg/h`;
    valMoisture.textContent = `${moisture.toFixed(1)} %`;
    valDieOpen.textContent = `${dieOpenPct} %`;
    valClearance.textContent = `${clearanceMm.toFixed(2)} mm`;
    valHours.textContent = `${hours} hrs`;

    // 1. Wear growth on liner (Archard wear approximation)
    const wearRate = met.relativeWearRate || 0.5;
    const clearanceWearMm = (hours / 10000) * 0.45 * wearRate;
    const effectiveClearanceMm = clearanceMm + clearanceWearMm;

    // 2. Flight Shear Rate γ̇ = (π · D · N) / (60 · δ)
    const screwDiaM = (arch.screwDiameterMm || 68.0) / 1000;
    const clearanceM = effectiveClearanceMm / 1000;
    const shearRate = Math.round((Math.PI * screwDiaM * rpm) / (60 * clearanceM));

    // 3. Ostwald-de Waele apparent viscosity (Pa·s)
    // η = K0 * exp(E_a/RT) * γ̇^(n-1) * exp(-β*Mw)
    const R = 8.314;
    const tempK = tempC + 273.15;
    const n = form.flowBehaviorIndexN || 0.38;
    const Ea = (form.activationEnergyKj || 34.5) * 1000;
    const arrheniusTerm = Math.exp(Ea / (R * tempK) - Ea / (R * 413.15));
    const moistureTerm = Math.exp(-0.065 * (moisture - 15.0));
    const shearTerm = Math.pow(Math.max(shearRate, 50), n - 1);
    const baseK = form.flowConsistencyIndexK || 4500;
    const apparentViscosity = Math.max(12, Math.round(baseK * arrheniusTerm * shearTerm * moistureTerm));

    // 4. Viscous Dissipation Heat Generation
    // q_diss = η * γ̇² * V_shear
    const shearVolM3 = Math.PI * screwDiaM * clearanceM * (arch.barrelLengthRatio * screwDiaM * 0.3);
    const viscousPowerWatts = apparentViscosity * Math.pow(shearRate, 2) * shearVolM3 * 0.045;
    const viscousPowerKw = Math.min(arch.motorPowerKw * 0.95, (viscousPowerWatts / 1000));
    const totalThermalKw = viscousPowerKw + (tempC - 100) * 0.18;
    const viscousHeatPercent = Math.min(95, Math.max(25, Math.round((viscousPowerKw / Math.max(totalThermalKw, 1)) * 100)));

    // 5. Starch Gelatinization / Protein Unfolding Kinetics
    const residenceTimeSec = ((arch.barrelLengthRatio * screwDiaM * 0.8) / Math.max(throughputKgH / 3600, 0.05)) * 0.45;
    const kGel = 0.025 * Math.exp((tempC - 120) / 32) * (1 + shearRate / 2500);
    let gelIndex = Math.min(99.4, (1 - Math.exp(-kGel * residenceTimeSec)) * 100);
    // Severe degradation penalty if temp > 185C and low moisture
    let degradationPenalty = 0;
    if (tempC > 180 && moisture < 13.0) {
      degradationPenalty = (tempC - 180) * 2.2 + (13.0 - moisture) * 3.5;
    }

    // 6. Specific Mechanical Energy (SME in Wh/kg)
    // SME = P_shaft / ṁ
    const shaftPowerKw = Math.min(arch.motorPowerKw, viscousPowerKw * 1.35 + (rpm / arch.maxScrewRpm) * 18);
    const smeWhKg = Math.round((shaftPowerKw * 1000) / Math.max(throughputKgH, 50));

    // 7. Die Throat Backpressure (bar)
    // Inversely proportional to die open area and moisture
    const openAreaFactor = Math.pow(100 / Math.max(dieOpenPct, 8), 1.25);
    const throughputFactor = throughputKgH / (arch.nominalThroughputKgHr || 1000);
    const diePressureBar = Math.round((apparentViscosity * 0.035 * openAreaFactor * throughputFactor * (15 / Math.max(moisture, 8))) * 10) / 10;
    const diePressurePsi = Math.round(diePressureBar * 14.5038);

    // 8. Rupture Disc Safety Margin
    const burstRating = arch.burstDiscRatingBar || 160.0;
    const burstMarginBar = Math.round((burstRating - diePressureBar) * 10) / 10;

    // Update Telemetry Display
    outShearRate.textContent = `${shearRate.toLocaleString()} s⁻¹`;
    outViscousHeat.textContent = `${viscousPowerKw.toFixed(1)} kW (${viscousHeatPercent}%)`;
    outViscosity.textContent = `${apparentViscosity.toLocaleString()} Pa·s`;
    outGelatinization.textContent = `${Math.max(10, Math.round((gelIndex - degradationPenalty) * 10) / 10)} %`;
    outSme.textContent = `${smeWhKg} Wh/kg`;
    outDiePressure.textContent = `${diePressureBar} bar (${diePressurePsi.toLocaleString()} psi)`;
    outBurstMargin.textContent = `${burstMarginBar > 0 ? '+' : ''}${burstMarginBar} bar Margin`;
    outLinerWear.textContent = `+${clearanceWearMm.toFixed(2)} mm Wear`;

    // SVG Overlays
    if (svgValShear) svgValShear.textContent = `${shearRate.toLocaleString()} s⁻¹`;
    if (svgValSme) svgValSme.textContent = `${smeWhKg} Wh/kg`;
    if (svgValDieP) svgValDieP.textContent = `${diePressureBar} bar`;
    if (svgValGel) svgValGel.textContent = `${Math.max(10, Math.round((gelIndex - degradationPenalty) * 10) / 10)}%`;

    // Status evaluation
    let statusClass = 'SAFE';
    let verdictText = 'OPTIMAL EXTRUSION PARAMETERS (SAFE)';
    let primaryRisk = '';
    let mechanisms = '';
    let mitigation = '';

    if (burstMarginBar <= 0) {
      statusClass = 'CRITICAL';
      verdictText = 'CRITICAL: DIE OVERPRESSURE & BURST DISC RUPTURE IMMINENT';
      primaryRisk = `Die throat backpressure (${diePressureBar} bar) exceeds the ASME rupture disc safety rating (${burstRating} bar). Rupture disc will burst immediately or risk explosive barrel head failure under ASME BPVC Section VIII.`;
      mechanisms = `Severe hydraulic choking caused by restricted die open area (${dieOpenPct}%) combined with high melt viscosity (${apparentViscosity} Pa·s). Flow resistance exponent (Q ∝ R_die⁴) produces rapid pressure multiplication (dP/dt > 40 bar/s).`;
      mitigation = `Immediately reduce dry feed rate, open die restriction, or execute emergency drive stop. Replace ruptured burst disc with genuine factory-calibrated ASME Sec VIII element before restart.`;
    } else if (degradationPenalty > 15 || smeWhKg > 170) {
      statusClass = 'WARN';
      verdictText = 'WARNING: SEVERE STARCH DEGRADATION & DEXTRINIZATION';
      primaryRisk = `Excessive specific mechanical energy (${smeWhKg} Wh/kg) and temperature (${tempC}°C) causing severe molecular fragmentation of amylose and amylopectin chains, destroying melt elasticity and collapsing product expansion.`;
      mechanisms = `High viscous dissipation (${viscousPowerKw.toFixed(1)} kW) under low formulation moisture (${moisture}%) shreds macromolecular starch granules. Dextrinization causes sticky dough, scorching on screw flights, and dark scorched spots.`;
      mitigation = `Increase formulation moisture to ≥ 15%, reduce screw speed by 15-20%, and increase cooling water flow to barrel metering zones 6 through 8.`;
    } else if (effectiveClearanceMm > 1.2) {
      statusClass = 'WARN';
      verdictText = 'WARNING: EXCESSIVE FLIGHT CLEARANCE & BACK-LEAKAGE';
      primaryRisk = `Screw-to-barrel radial clearance (${effectiveClearanceMm.toFixed(2)} mm) exceeds ISO 14159 allowable wear thresholds. Significant melt back-leakage over flight tips collapses conveying efficiency and causes erratic die surging.`;
      mechanisms = `Abrasive wear on liner from cumulative service (${hours} hrs) expands radial clearance. Leakage flow scales cubically with clearance (Q_leak ∝ δ³ · ΔP), destabilizing barrel pressure and doubling residence time.`;
      mitigation = `Schedule screw rebuild or barrel relining with bimetallic tungsten carbide matrix. Inspect screw flight OD for adhesive galling.`;
    } else {
      statusClass = 'SAFE';
      verdictText = 'OPTIMAL EXTRUSION PARAMETERS (SAFE & ASME COMPLIANT)';
      primaryRisk = `Extruder operating in stable hydrodynamic regime. Starch gelatinization reaches ${Math.round(gelIndex)}% with optimal cellular expansion. Die pressure maintains +${burstMarginBar} bar safety margin below burst limit.`;
      mechanisms = `Viscous dissipation contributes ${viscousHeatPercent}% of cooking energy via controlled shear rate (${shearRate.toLocaleString()} s⁻¹). Pseudoplastic shear-thinning maintains low drive motor amp draw without barrel scouring.`;
      mitigation = `Maintain continuous monitoring of Zone 7 melt temperature and feeder throughput. Inspect rupture disc weekly per OSHA 1910.212 safety protocols.`;
    }

    // Apply UI classes
    if (boxSafetyStatus) {
      boxSafetyStatus.className = 'border rounded-2xl p-6 transition-all ' + 
        (statusClass === 'CRITICAL' ? 'bg-rose-500/10 border-rose-500/30' :
         statusClass === 'WARN' ? 'bg-amber-500/10 border-amber-500/30' :
         'bg-emerald-500/5 border-emerald-500/20');
    }

    if (badgeSafetyVerdict) {
      badgeSafetyVerdict.className = 'text-xs font-mono font-bold px-2.5 py-1 rounded-full ' +
        (statusClass === 'CRITICAL' ? 'bg-rose-500/20 text-rose-700' :
         statusClass === 'WARN' ? 'bg-amber-500/20 text-amber-700' :
         'bg-emerald-500/10 text-emerald-700');
      badgeSafetyVerdict.textContent = verdictText;
    }

    if (iconSafetyStatus) {
      iconSafetyStatus.textContent = statusClass === 'CRITICAL' ? '🚨' : (statusClass === 'WARN' ? '⚠️' : '✅');
    }

    if (badgeBarrelStatus) {
      badgeBarrelStatus.className = 'text-[10px] font-mono px-2 py-0.5 rounded font-bold ' +
        (statusClass === 'CRITICAL' ? 'bg-rose-500/20 text-rose-700' :
         statusClass === 'WARN' ? 'bg-amber-500/20 text-amber-700' :
         'bg-emerald-500/10 text-emerald-700');
      badgeBarrelStatus.textContent = statusClass === 'CRITICAL' ? 'OVERPRESSURE ALARM' : (statusClass === 'WARN' ? 'RHEOLOGY WARNING' : 'NORMAL RHEOLOGY');
    }

    if (descPrimaryRisk) descPrimaryRisk.textContent = primaryRisk;
    if (descMechanisms) descMechanisms.textContent = mechanisms;
    if (descMitigation) descMitigation.textContent = mitigation;
  }

  // Preset event listeners
  if (btnPresetPuff) {
    btnPresetPuff.addEventListener('click', () => {
      if (selExtruder) selExtruder.value = 'twin_screw_corotating_high_shear_extruder';
      if (selFormulation) selFormulation.value = 'corn_starch_expanded_snack';
      if (selMetallurgy) selMetallurgy.value = 'bimetallic_tungsten_carbide_liner';
      rngRpm.value = '420';
      rngTemp.value = '160';
      rngThroughput.value = '1100';
      rngMoisture.value = '15.0';
      rngDieOpen.value = '75';
      rngClearance.value = '0.25';
      rngHours.value = '650';
      calculateExtrusionModel();
    });
  }

  if (btnPresetTvp) {
    btnPresetTvp.addEventListener('click', () => {
      if (selExtruder) selExtruder.value = 'twin_screw_corotating_high_shear_extruder';
      if (selFormulation) selFormulation.value = 'textured_soy_protein_tvp';
      if (selMetallurgy) selMetallurgy.value = 'bimetallic_tungsten_carbide_liner';
      rngRpm.value = '320';
      rngTemp.value = '150';
      rngThroughput.value = '950';
      rngMoisture.value = '24.0';
      rngDieOpen.value = '60';
      rngClearance.value = '0.30';
      rngHours.value = '1200';
      calculateExtrusionModel();
    });
  }

  if (btnPresetScorched) {
    btnPresetScorched.addEventListener('click', () => {
      if (selExtruder) selExtruder.value = 'twin_screw_corotating_high_shear_extruder';
      if (selFormulation) selFormulation.value = 'corn_starch_expanded_snack';
      if (selMetallurgy) selMetallurgy.value = 'nitrided_tool_steel_sacm645';
      rngRpm.value = '580';
      rngTemp.value = '195';
      rngThroughput.value = '750';
      rngMoisture.value = '11.0';
      rngDieOpen.value = '70';
      rngClearance.value = '0.35';
      rngHours.value = '4500';
      calculateExtrusionModel();
    });
  }

  if (btnPresetBurst) {
    btnPresetBurst.addEventListener('click', () => {
      if (selExtruder) selExtruder.value = 'single_screw_high_compression_extruder';
      if (selFormulation) selFormulation.value = 'corn_starch_expanded_snack';
      if (selMetallurgy) selMetallurgy.value = 'worn_uncoated_chrome_moly_steel';
      rngRpm.value = '340';
      rngTemp.value = '130';
      rngThroughput.value = '1300';
      rngMoisture.value = '11.5';
      rngDieOpen.value = '15';
      rngClearance.value = '0.40';
      rngHours.value = '7800';
      calculateExtrusionModel();
    });
  }

  // Input change listeners
  [selExtruder, selFormulation, selMetallurgy, rngRpm, rngTemp, rngThroughput, rngMoisture, rngDieOpen, rngClearance, rngHours].forEach(el => {
    if (el) {
      el.addEventListener('input', calculateExtrusionModel);
      el.addEventListener('change', calculateExtrusionModel);
    }
  });

  // Clipboard copy
  if (btnCopyReport) {
    btnCopyReport.addEventListener('click', () => {
      const report = `=== ISITKITCHENSAFE EXTRUSION COOKER TELEMETRY REPORT ===
Architecture: ${selExtruder.options[selExtruder.selectedIndex].text}
Formulation: ${selFormulation.options[selFormulation.selectedIndex].text}
Metallurgy: ${selMetallurgy.options[selMetallurgy.selectedIndex].text}
Operating Conditions: ${rngRpm.value} RPM | ${rngTemp.value}°C | ${rngThroughput.value} kg/h | Moisture: ${rngMoisture.value}% | Die Open: ${rngDieOpen.value}%
Clearance: ${rngClearance.value} mm | Service: ${rngHours.value} hrs
Shear Rate: ${outShearRate.textContent}
Viscous Power: ${outViscousHeat.textContent}
Melt Viscosity: ${outViscosity.textContent}
Starch Gelatinization: ${outGelatinization.textContent}
Specific Mechanical Energy: ${outSme.textContent}
Die Backpressure: ${outDiePressure.textContent}
Burst Disc Margin: ${outBurstMargin.textContent}
Liner Wear: ${outLinerWear.textContent}
Status Verdict: ${badgeSafetyVerdict.textContent}
======================================================`;

      navigator.clipboard.writeText(report).then(() => {
        const originalText = btnCopyText.textContent;
        btnCopyText.textContent = "Report Copied to Clipboard!";
        setTimeout(() => {
          btnCopyText.textContent = originalText;
        }, 2500);
      }).catch(err => {
        console.error('Failed to copy to clipboard:', err);
      });
    });
  }

  // Initial calculation
  calculateExtrusionModel();
})();
</script>
