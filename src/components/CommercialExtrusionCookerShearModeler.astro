---

<section class="max-w-7xl mx-auto px-4 py-8">
  <div class="mb-8">
    <div class="flex items-center gap-2 mb-3">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-700 text-white">
        {d.badge}
      </span>
      <span class="text-xs text-muted font-mono">ASME BPVC Sec VIII &bull; OSHA 1910.212 &bull; FDA 21 CFR § 110 &bull; EHEDG Doc 8</span>
    </div>
    <h1 class="text-title-xl sm:text-4xl font-bold text-ink tracking-tight mb-3">
      {d.title}
    </h1>
    <p class="text-body text-base text-muted max-w-4xl leading-relaxed">
      {d.subtitle}
    </p>
  </div>

  <!-- Operational Presets -->
  <div class="bg-surface border border-hairline rounded-2xl p-5 mb-8 shadow-xs">
    <h3 class="text-sm font-semibold text-ink uppercase tracking-wider mb-3">
