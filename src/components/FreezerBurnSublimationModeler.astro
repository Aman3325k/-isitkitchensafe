    presetDeepFreeze: "直冷式チェストフリーザーの牛塊肉（-29°C、18ヶ月）",
    diagnosticTitle: "冷凍焼け診断スコアカード",
    diagnosticSub: "生化学的脱水乾燥度、油脂酸化度（MDA）、調理レスキュー判定。",
    severityLabel: "冷凍焼け総合深刻度指数",
    sublimationLabel: "氷昇華による水分質量損失率",
    rancidityLabel: "脂質過酸化（酸敗度 TBARS MDA）",
    toughnessLabel: "筋原線維硬化・変性係数",
    safetyStatusLabel: "USDA 微生物学的安全性判定",
    palatabilityLabel: "食味・食感クオリティ評価",
    trimmingTitle: "ナイフによる外科的トリミング基準",
    salvageTitle: "湿熱調理によるレスキュー調理法",
    visualTitle: "組織の外観・色調変化プロセス",
    tableTitle: "昇華耐性および食品マトリクス比較基準表",
    tableSub: "水分保持率、酸化感受性、賞味期間の科学的比較。",
    colFood: "対象食品",
    colOptimal: "最適賞味期間",
    colMoisture: "水分比率",
    colOxidationRisk: "酸化リスク",
    colSalvage: "推奨レスキュー法",
    rulesTitle: "USDAおよび食品科学に基づく根拠プロトコル",
    rulesSub: "氷蒸気圧差による乾燥メカニズムと脂質保護の必須原則。",
    rule1Title: "1. 米国農務省（USDA）の鉄則：冷凍焼けは食中毒ではない",
    rule1Text: "冷凍焼けした肉は白っぽく変色しパサついてダンボールのように硬くなりますが、微生物学的には100%完全に安全です。0°F（-18°C）以下ではサルモネラ菌や大腸菌、リステリア菌などのすべての病原菌が完全休眠状態になります。冷凍焼けした肉を食べても細菌性食中毒を起こすことは決してありません。",
    rule2Title: "2. 氷昇華の熱力学：袋の中に雪のような霜が溜まる理由",
    rule2Text: "昇華とは固体（氷）が液体を経ずに直接気体（水蒸気）へと変化する現象です。ファン式（自動霜取り）冷凍庫ではヒーターが定期的に作動して温度が上昇します。この温度変動によって生じる強力な氷蒸気圧差が細胞から水分を吸い出し、袋の内壁に雪状の霜となって結晶化し、肉に蜂の巣状の空洞を残します。",
    rule3Title: "3. 外側2mmをナイフで削ぎ落とすトリミング原則",
    rule3Text: "冷凍焼けによる組織乾燥と古い油のような異臭（マロンジアルデヒド MDA）は、肉の最外層1.5〜3mm深さに集中しています。調理前に切れ味の良いナイフでこのパサついた外皮を薄く削ぎ落とすだけで、酸化成分の90%以上を除去でき、内部のジューシーな肉質を救出できます。",
    rule4Title: "4. 湿熱調理の鉄則：乾燥した冷凍焼け肉を決してそのまま焼かない",
    rule4Text: "脱水した筋原線維タンパク質は不可逆的に架橋変性しており、水分保持力を失っています。フライパンでそのまま焼くとゴムのように硬化します。必ずワイン、トマト、出汁などの水分と酸味を加えた煮込み料理（シチュー、カレー、ポトフ、角煮）でコラーゲンをゼラチン化させて水分を補給してください。",
    copyReportBtn: "詳細診断レポートをコピー",
    copiedFeedback: "レポートをクリップボードにコピーしました！"
  }
};

const d = DICTIONARY[lang] || DICTIONARY.en;
const data = freezerBurnData;
---

<div class="bg-surface border border-hairline rounded-3xl p-6 md:p-10 shadow-sm transition-all duration-300 hover:shadow-md mb-12">
  <!-- Badge & Header -->
  <div class="flex flex-wrap items-center justify-between gap-4 border-b border-hairline pb-6 mb-8">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-sky-100 text-sky-950 mb-3 border border-sky-200">
        <span class="inline-block w-2 h-2 rounded-full bg-sky-500 animate-pulse"></span>
        {d.badge}
      </div>
      <h2 class="text-2xl md:text-3xl font-extrabold text-ink tracking-tight">
        {d.title}
      </h2>
      <p class="text-sm md:text-base text-muted mt-2 max-w-3xl leading-relaxed">
        {d.subtitle}
      </p>
    </div>

    <!-- Live USDA Safety Seal -->
    <div class="flex items-center gap-3 bg-emerald-50 border border-emerald-200 rounded-2xl px-4 py-3 text-emerald-950">
      <div class="text-2xl">🛡️</div>
      <div>
        <div class="text-xs font-bold uppercase tracking-wider text-emerald-800">USDA FSIS Clearance</div>
        <div class="text-sm font-semibold text-emerald-900">100% Pathogen Inactive (&le; 0°F)</div>
      </div>
    </div>
  </div>

  <!-- Presets Bar -->
  <div class="mb-8 bg-surface-soft border border-hairline rounded-2xl p-4 md:p-5">
    <div class="text-xs font-bold uppercase tracking-wider text-muted mb-3 flex items-center gap-2">
      <span>⚡</span> {d.presetsTitle}
    </div>
    <div class="flex flex-wrap gap-2">
      <button type="button" class="preset-btn px-3 py-1.5 rounded-xl text-xs font-medium bg-canvas border border-hairline hover:border-accent hover:text-accent transition-all text-ink cursor-pointer" data-preset="steak-store">
        🥩 {d.presetSteakStore}
      </button>
      <button type="button" class="preset-btn px-3 py-1.5 rounded-xl text-xs font-medium bg-canvas border border-hairline hover:border-accent hover:text-accent transition-all text-ink cursor-pointer" data-preset="chicken-vacuum">
        🍗 {d.presetChickenVacuum}
      </button>
      <button type="button" class="preset-btn px-3 py-1.5 rounded-xl text-xs font-medium bg-canvas border border-hairline hover:border-accent hover:text-accent transition-all text-ink cursor-pointer" data-preset="salmon-torn">
        🐟 {d.presetSalmonTorn}
      </button>
      <button type="button" class="preset-btn px-3 py-1.5 rounded-xl text-xs font-medium bg-canvas border border-hairline hover:border-accent hover:text-accent transition-all text-ink cursor-pointer" data-preset="ground-auto">
        🍔 {d.presetGroundBeefAuto}
      </button>
      <button type="button" class="preset-btn px-3 py-1.5 rounded-xl text-xs font-medium bg-canvas border border-hairline hover:border-accent hover:text-accent transition-all text-ink cursor-pointer" data-preset="deep-freeze">
        ❄️ {d.presetDeepFreeze}
      </button>
    </div>
  </div>

  <!-- Main Grid: Controls Left, Scorecard Right -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Left Column: Controls (5 cols) -->
    <div class="lg:col-span-5 space-y-6 bg-surface-soft border border-hairline rounded-2xl p-6">
      <div>
        <h3 class="text-base font-bold text-ink flex items-center gap-2">
          <span>⚙️</span> {d.controlsTitle}
        </h3>
        <p class="text-xs text-muted mt-1 leading-relaxed">
          {d.controlsSub}
        </p>
      </div>

      <!-- Food Substrate Matrix -->
      <div>
        <label for="fb-food-matrix" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5">
          {d.foodLabel}
        </label>
        <select id="fb-food-matrix" class="w-full bg-canvas border border-hairline rounded-xl px-3.5 py-2.5 text-sm text-ink font-medium focus:outline-none focus:ring-2 focus:ring-accent transition-all cursor-pointer">
          {data.foodMatrices.map(m => (
            <option value={m.id} selected={m.id === 'matrix-beef-steak'}>
              {m.name} ({m.waterPercent}% Water | {m.fatPercent}% Fat)
            </option>
          ))}
        </select>
        <span class="block text-[11px] text-muted mt-1.5">
          {d.foodHelp}
        </span>
      </div>

      <!-- Packaging Type -->
      <div>
        <label for="fb-packaging-type" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5">
          {d.packagingLabel}
        </label>
        <select id="fb-packaging-type" class="w-full bg-canvas border border-hairline rounded-xl px-3.5 py-2.5 text-sm text-ink font-medium focus:outline-none focus:ring-2 focus:ring-accent transition-all cursor-pointer">
          {data.packagingTypes.map(p => (
            <option value={p.id} selected={p.id === 'pack-supermarket-tray'}>
              {p.name}
            </option>
          ))}
        </select>
        <span class="block text-[11px] text-muted mt-1.5">
          {d.packagingHelp}
        </span>
      </div>

      <!-- Freezer Climate & Defrost Cycling -->
      <div>
        <label for="fb-freezer-env" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5">
          {d.envLabel}
        </label>
        <select id="fb-freezer-env" class="w-full bg-canvas border border-hairline rounded-xl px-3.5 py-2.5 text-sm text-ink font-medium focus:outline-none focus:ring-2 focus:ring-accent transition-all cursor-pointer">
          {data.freezerEnvironments.map(e => (
            <option value={e.id} selected={e.id === 'env-auto-defrost'}>
              {e.name}
            </option>
          ))}
        </select>
        <span class="block text-[11px] text-muted mt-1.5">
          {d.envHelp}
        </span>
      </div>

      <!-- Storage Duration Slider -->
      <div>
        <div class="flex items-center justify-between mb-1.5">
          <label for="fb-duration-months" class="text-xs font-bold uppercase tracking-wider text-ink">
            {d.durationLabel}
          </label>
          <span id="fb-duration-val" class="text-sm font-extrabold text-accent bg-accent/10 px-2 py-0.5 rounded-md">
            4 Months
          </span>
        </div>
        <input
          type="range"
          id="fb-duration-months"
          min="1"
          max="24"
          step="1"
          value="4"
          class="w-full h-2 bg-hairline rounded-lg appearance-none cursor-pointer accent-accent"
        />
        <div class="flex justify-between text-[10px] text-muted mt-1 font-mono">
          <span>1 Month</span>
          <span>6 Mo</span>
          <span>12 Mo</span>
          <span>24+ Months</span>
        </div>
        <span class="block text-[11px] text-muted mt-1.5">
          {d.durationHelp}
        </span>
      </div>

      <!-- Thickness & Geometry -->
      <div>
        <div class="flex items-center justify-between mb-1.5">
          <label for="fb-cut-thickness" class="text-xs font-bold uppercase tracking-wider text-ink">
            {d.thicknessLabel}
          </label>
          <span id="fb-thickness-val" class="text-sm font-extrabold text-accent bg-accent/10 px-2 py-0.5 rounded-md">
            1.0 inch / 25 mm (Standard Cut)
          </span>
        </div>
        <input
          type="range"
          id="fb-cut-thickness"
          min="10"
          max="80"
          step="5"
          value="25"
          class="w-full h-2 bg-hairline rounded-lg appearance-none cursor-pointer accent-accent"
        />
        <div class="flex justify-between text-[10px] text-muted mt-1 font-mono">
          <span>10 mm (Thin Cutlet)</span>
          <span>25 mm (Steak)</span>
          <span>50 mm (Thick Roast)</span>
          <span>80 mm (Whole Bird)</span>
        </div>
        <span class="block text-[11px] text-muted mt-1.5">
          {d.thicknessHelp}
        </span>
      </div>
    </div>

    <!-- Right Column: Diagnostic Output (7 cols) -->
    <div class="lg:col-span-7 space-y-6">
      <div class="bg-surface border border-hairline rounded-2xl p-6 shadow-sm">
        <div class="flex items-center justify-between border-b border-hairline pb-4 mb-5">
          <div>
            <h3 class="text-lg font-bold text-ink">
              {d.diagnosticTitle}
            </h3>
            <p class="text-xs text-muted mt-0.5">
              {d.diagnosticSub}
            </p>
          </div>
          <div id="fb-badge-severity" class="px-3.5 py-1.5 rounded-full text-xs font-black uppercase tracking-wider bg-amber-100 text-amber-900 border border-amber-300">
            Moderate Desiccation
          </div>
        </div>

        <!-- Severity Meter Bar -->
        <div class="space-y-2 mb-6">
          <div class="flex items-center justify-between text-xs font-semibold text-ink">
            <span>{d.severityLabel}</span>
            <span id="fb-severity-pct" class="font-bold text-sm">48%</span>
          </div>
          <div class="w-full h-3 bg-surface-soft border border-hairline rounded-full overflow-hidden p-0.5">
            <div id="fb-severity-bar" class="h-full bg-gradient-to-r from-emerald-500 via-amber-500 to-rose-600 rounded-full transition-all duration-500" style="width: 48%;"></div>
          </div>
        </div>

        <!-- 4 Key Diagnostic Metrics -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3.5 mb-6 text-center">
          <div class="bg-surface-soft border border-hairline rounded-xl p-3.5">
            <div class="text-[10px] font-bold uppercase tracking-wider text-muted mb-1">{d.sublimationLabel}</div>
            <div id="fb-sublimation-val" class="text-lg font-black text-ink">8.4%</div>
            <div class="text-[10px] text-muted mt-0.5">Cellular water loss</div>
          </div>
          <div class="bg-surface-soft border border-hairline rounded-xl p-3.5">
            <div class="text-[10px] font-bold uppercase tracking-wider text-muted mb-1">{d.rancidityLabel}</div>
            <div id="fb-rancidity-val" class="text-lg font-black text-amber-600">0.78 mg/kg</div>
            <div class="text-[10px] text-muted mt-0.5">MDA Aldehydes</div>
          </div>
          <div class="bg-surface-soft border border-hairline rounded-xl p-3.5">
            <div class="text-[10px] font-bold uppercase tracking-wider text-muted mb-1">{d.toughnessLabel}</div>
            <div id="fb-toughness-val" class="text-lg font-black text-ink">2.1x</div>
            <div class="text-[10px] text-muted mt-0.5">Shear resistance</div>
          </div>
          <div class="bg-surface-soft border border-hairline rounded-xl p-3.5">
            <div class="text-[10px] font-bold uppercase tracking-wider text-muted mb-1">{d.palatabilityLabel}</div>
            <div id="fb-palatability-val" class="text-lg font-black text-amber-600">3.0 / 5</div>
            <div class="text-[10px] text-muted mt-0.5">Culinary quality</div>
          </div>
        </div>

        <!-- Dynamic Visual Tissue Progression Card -->
        <div class="bg-surface-soft border border-hairline rounded-xl p-4 mb-6">
          <div class="text-xs font-bold uppercase tracking-wider text-ink mb-1 flex items-center gap-2">
            <span>🔬</span> {d.visualTitle}
          </div>
          <p id="fb-visual-desc" class="text-xs text-muted leading-relaxed">
            Vibrant cherry red (oxymyoglobin) transitioning to dull grayish-brown metmyoglobin with dry tan leathery patches on outer edges.
          </p>
        </div>

        <!-- Dynamic Trimming Protocol Card -->
        <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 mb-4">
          <div class="text-xs font-bold uppercase tracking-wider text-amber-900 mb-1.5 flex items-center gap-2">
            <span>🔪</span> {d.trimmingTitle}
          </div>
          <div class="flex items-start gap-3">
            <div id="fb-trim-depth-badge" class="bg-amber-200 text-amber-950 font-black text-sm px-2.5 py-1 rounded-lg shrink-0">
              1.8 mm
            </div>
            <p id="fb-trim-advice" class="text-xs text-amber-900 leading-relaxed font-medium">
              Trim grayish-brown dry rind (1.5–2.5 mm depth) with a sharp chef's knife before cooking. Interior muscle fibers remain juicy and flavorful.
            </p>
          </div>
        </div>

        <!-- Dynamic Cooking Salvage Method Card -->
        <div class="bg-sky-50 border border-sky-200 rounded-xl p-4 mb-6">
          <div class="text-xs font-bold uppercase tracking-wider text-sky-950 mb-1.5 flex items-center gap-2">
            <span>🍲</span> {d.salvageTitle}
          </div>
          <p id="fb-salvage-technique" class="text-xs text-sky-900 leading-relaxed font-medium">
            Low-and-slow braising in acidic wine/tomato liquids, beef bourguignon, pot roast, or shredded beef chili. Avoid quick high-heat dry grilling.
          </p>
        </div>

        <!-- Action Button: Copy Report -->
        <div class="pt-2">
          <button
            type="button"
            id="fb-copy-btn"
            class="w-full py-3 px-4 rounded-xl text-sm font-bold bg-ink text-canvas hover:opacity-90 transition-all flex items-center justify-center gap-2 cursor-pointer shadow-sm"
          >
            <span>📋</span>
            <span id="fb-copy-btn-text">{d.copyReportBtn}</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Benchmarks Table Section -->
  <div class="mt-12 pt-8 border-t border-hairline">
    <div class="mb-6">
      <h3 class="text-xl font-bold text-ink">
        {d.tableTitle}
      </h3>
      <p class="text-sm text-muted mt-1">
        {d.tableSub}
      </p>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs border border-hairline rounded-2xl overflow-hidden">
        <thead class="bg-surface-soft border-b border-hairline text-ink font-bold uppercase tracking-wider text-[11px]">
          <tr>
            <th class="py-3 px-4">{d.colFood}</th>
            <th class="py-3 px-4">{d.colOptimal}</th>
            <th class="py-3 px-4">{d.colMoisture}</th>
            <th class="py-3 px-4">{d.colOxidationRisk}</th>
            <th class="py-3 px-4">{d.colSalvage}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline text-muted">
          {data.foodMatrices.map(m => (
            <tr class="hover:bg-surface-soft/60 transition-colors">
              <td class="py-3 px-4 font-semibold text-ink">{m.name}</td>
              <td class="py-3 px-4">{m.optimalMonths} Months</td>
              <td class="py-3 px-4">{m.waterPercent}%</td>
              <td class="py-3 px-4">
                <span class={`inline-block px-2 py-0.5 rounded text-[10px] font-bold ${
                  m.lipidOxidationSensitivity > 1.5 ? 'bg-rose-100 text-rose-800' :
                  m.lipidOxidationSensitivity > 1.0 ? 'bg-amber-100 text-amber-800' :
                  'bg-emerald-100 text-emerald-800'
                }`}>
                  {m.lipidOxidationSensitivity > 1.5 ? 'High (Rancid Odors)' :
                   m.lipidOxidationSensitivity > 1.0 ? 'Moderate (Cardboard)' : 'Low (Mild Dryness)'}
                </span>
              </td>
              <td class="py-3 px-4 text-ink font-medium">{m.salvageCookingTechnique}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Evidence-Based Rules Section -->
  <div class="mt-12 pt-8 border-t border-hairline">
    <div class="mb-6">
      <h3 class="text-xl font-bold text-ink">
        {d.rulesTitle}
      </h3>
      <p class="text-sm text-muted mt-1">
        {d.rulesSub}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="bg-surface-soft border border-hairline rounded-2xl p-5">
        <h4 class="text-sm font-bold text-ink mb-2 flex items-center gap-2">
          <span>🛡️</span> {d.rule1Title}
        </h4>
        <p class="text-xs text-muted leading-relaxed">
          {d.rule1Text}
        </p>
      </div>

      <div class="bg-surface-soft border border-hairline rounded-2xl p-5">
        <h4 class="text-sm font-bold text-ink mb-2 flex items-center gap-2">
          <span>🌡️</span> {d.rule2Title}
        </h4>
        <p class="text-xs text-muted leading-relaxed">
          {d.rule2Text}
        </p>
      </div>

      <div class="bg-surface-soft border border-hairline rounded-2xl p-5">
        <h4 class="text-sm font-bold text-ink mb-2 flex items-center gap-2">
          <span>🔪</span> {d.rule3Title}
        </h4>
        <p class="text-xs text-muted leading-relaxed">
          {d.rule3Text}
        </p>
      </div>

      <div class="bg-surface-soft border border-hairline rounded-2xl p-5">
        <h4 class="text-sm font-bold text-ink mb-2 flex items-center gap-2">
          <span>🍲</span> {d.rule4Title}
        </h4>
        <p class="text-xs text-muted leading-relaxed">
          {d.rule4Text}
        </p>
      </div>
    </div>
  </div>
</div>

<!-- Reactive Client-Side Simulation Script -->
<script define:vars={{ data, d }}>
  document.addEventListener('DOMContentLoaded', () => {
    const foodSelect = document.getElementById('fb-food-matrix');
    const packSelect = document.getElementById('fb-packaging-type');
    const envSelect = document.getElementById('fb-freezer-env');
    const durationSlider = document.getElementById('fb-duration-months');
    const durationVal = document.getElementById('fb-duration-val');
    const thicknessSlider = document.getElementById('fb-cut-thickness');
    const thicknessVal = document.getElementById('fb-thickness-val');

    // Outputs
    const severityBadge = document.getElementById('fb-badge-severity');
    const severityPct = document.getElementById('fb-severity-pct');
    const severityBar = document.getElementById('fb-severity-bar');
    const sublimationVal = document.getElementById('fb-sublimation-val');
    const rancidityVal = document.getElementById('fb-rancidity-val');
    const toughnessVal = document.getElementById('fb-toughness-val');
    const palatabilityVal = document.getElementById('fb-palatability-val');
    const visualDesc = document.getElementById('fb-visual-desc');
    const trimDepthBadge = document.getElementById('fb-trim-depth-badge');
    const trimAdvice = document.getElementById('fb-trim-advice');
    const salvageTechnique = document.getElementById('fb-salvage-technique');
    const copyBtn = document.getElementById('fb-copy-btn');
    const copyBtnText = document.getElementById('fb-copy-btn-text');

    function calculate() {
      if (!foodSelect || !packSelect || !envSelect || !durationSlider || !thicknessSlider) return;

      const foodId = foodSelect.value;
      const packId = packSelect.value;
      const envId = envSelect.value;
      const months = parseInt(durationSlider.value, 10);
      const thicknessMm = parseInt(thicknessSlider.value, 10);

      const food = data.foodMatrices.find(m => m.id === foodId) || data.foodMatrices[0];
      const pack = data.packagingTypes.find(p => p.id === packId) || data.packagingTypes[0];
      const env = data.freezerEnvironments.find(e => e.id === envId) || data.freezerEnvironments[0];

      // Update Slider labels
      if (durationVal) durationVal.textContent = `${months} Month${months > 1 ? 's' : ''}`;
      if (thicknessVal) thicknessVal.textContent = `${thicknessMm} mm (${(thicknessMm / 25.4).toFixed(1)} inch)`;

      // Sublimation Kinetics Model:
      // Base rate per month ~ 0.95% water loss under standard packaging at 0°F
      // Multipliers: packaging transmission, freezer vapor delta, matrix sublimation resistance
      const monthlyRate = 1.15 * pack.sublimationMultiplier * env.vaporPressureDiffFactor / food.sublimationResistanceFactor;
      // Exponential saturation curve: loss% = maxWater * (1 - e^(-rate * t / 100))
      const theoreticalLossPct = food.waterPercent * (1 - Math.exp(-monthlyRate * (months / 12) * 0.35));
      const waterLossPct = Math.min(food.waterPercent * 0.45, Math.max(0.4, theoreticalLossPct));

      // Lipid Peroxidation (MDA Aldehyde) Model:
      // Base MDA ~ 0.15 mg/kg (fresh)
      // Driven by oxygen barrier, duration, lipid sensitivity, and fat fraction
      const mdaIncrease = (months / 6) * pack.oxidationMultiplier * env.vaporPressureDiffFactor * food.lipidOxidationSensitivity * (food.polyunsaturatedPercent / 20);
      const mdaScore = Math.min(4.5, Math.max(0.12, 0.15 + mdaIncrease));

      // Protein Toughness Shear Factor:
      // Cross-linking scales with water loss percentage
      const toughnessFactor = Math.min(3.8, Math.max(1.0, 1.0 + (waterLossPct / 10) * 1.3));

      // Freezer Burn Severity Index (0 to 100):
      // Composite of water loss fraction and MDA oxidation
      const severityScore = Math.min(100, Math.round((waterLossPct / (food.waterPercent * 0.35)) * 60 + (mdaScore / 2.5) * 40));

      // Palatability Score (1.0 to 5.0):
      const rawPalatability = 5.0 - (severityScore / 100) * 4.0;
      const palatabilityScore = Math.max(1.0, Math.min(5.0, rawPalatability)).toFixed(1);

      // Trimming Depth (mm):
      // Penetration depth depends on thickness, duration, and sublimation
      const trimDepthMm = Math.min(Math.round(thicknessMm * 0.25 * 10) / 10, Math.max(0.5, (waterLossPct * 0.22 * env.vaporPressureDiffFactor).toFixed(1)));

      // Render Outputs
      if (severityPct) severityPct.textContent = `${severityScore}%`;
      if (severityBar) severityBar.style.width = `${severityScore}%`;
      if (sublimationVal) sublimationVal.textContent = `${waterLossPct.toFixed(1)}%`;
      if (rancidityVal) {
        rancidityVal.textContent = `${mdaScore.toFixed(2)} mg/kg`;
        rancidityVal.className = `text-lg font-black ${
          mdaScore > 1.5 ? 'text-rose-600' :
          mdaScore > 0.8 ? 'text-amber-600' :
          'text-emerald-600'
        }`;
      }
      if (toughnessVal) toughnessVal.textContent = `${toughnessFactor.toFixed(1)}x`;
      if (palatabilityVal) {
        palatabilityVal.textContent = `${palatabilityScore} / 5`;
        palatabilityVal.className = `text-lg font-black ${
          parseFloat(palatabilityScore) >= 4.0 ? 'text-emerald-600' :
          parseFloat(palatabilityScore) >= 2.5 ? 'text-amber-600' :
          'text-rose-600'
        }`;
      }

      // Severity Badge
      if (severityBadge) {
        if (severityScore < 20) {
          severityBadge.textContent = 'Pristine / Negligible Loss';
          severityBadge.className = 'px-3.5 py-1.5 rounded-full text-xs font-black uppercase tracking-wider bg-emerald-100 text-emerald-900 border border-emerald-300';
        } else if (severityScore < 45) {
          severityBadge.textContent = 'Mild Surface Desiccation';
          severityBadge.className = 'px-3.5 py-1.5 rounded-full text-xs font-black uppercase tracking-wider bg-sky-100 text-sky-900 border border-sky-300';
        } else if (severityScore < 70) {
          severityBadge.textContent = 'Moderate Freezer Burn';
          severityBadge.className = 'px-3.5 py-1.5 rounded-full text-xs font-black uppercase tracking-wider bg-amber-100 text-amber-900 border border-amber-300';
        } else {
          severityBadge.textContent = 'Severe Peroxidation & Toughness';
          severityBadge.className = 'px-3.5 py-1.5 rounded-full text-xs font-black uppercase tracking-wider bg-rose-100 text-rose-900 border border-rose-300';
        }
      }

      // Dynamic Guidance
      if (visualDesc) visualDesc.textContent = food.visualProgression;
      if (trimDepthBadge) trimDepthBadge.textContent = `${trimDepthMm} mm`;
      if (trimAdvice) trimAdvice.textContent = food.trimmingAdvice;
      if (salvageTechnique) salvageTechnique.textContent = food.salvageCookingTechnique;
    }

    // Attach Event Listeners
    [foodSelect, packSelect, envSelect, durationSlider, thicknessSlider].forEach(el => {
      if (el) el.addEventListener('input', calculate);
    });

    // Preset Buttons
    const presetBtns = document.querySelectorAll('.preset-btn');
    presetBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const type = btn.getAttribute('data-preset');
        if (type === 'steak-store') {
          foodSelect.value = 'matrix-beef-steak';
          packSelect.value = 'pack-supermarket-tray';
          envSelect.value = 'env-auto-defrost';
          durationSlider.value = '3';
          thicknessSlider.value = '25';
        } else if (type === 'chicken-vacuum') {
          foodSelect.value = 'matrix-poultry-skinless';
          packSelect.value = 'pack-vacuum-sealed';
          envSelect.value = 'env-standard-manual';
          durationSlider.value = '12';
          thicknessSlider.value = '25';
        } else if (type === 'salmon-torn') {
          foodSelect.value = 'matrix-fatty-fish';
          packSelect.value = 'pack-loose-torn';
          envSelect.value = 'env-auto-defrost';
          durationSlider.value = '4';
          thicknessSlider.value = '20';
        } else if (type === 'ground-auto') {
          foodSelect.value = 'matrix-ground-beef';
          packSelect.value = 'pack-freezer-ziploc-pressed';
          envSelect.value = 'env-auto-defrost';
          durationSlider.value = '6';
          thicknessSlider.value = '15';
        } else if (type === 'deep-freeze') {
          foodSelect.value = 'matrix-beef-steak';
          packSelect.value = 'pack-aluminum-foil-double';
          envSelect.value = 'env-deep-freeze';
          durationSlider.value = '18';
          thicknessSlider.value = '50';
        }
        calculate();
      });
    });

    // Copy Report Button
    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        const food = data.foodMatrices.find(m => m.id === foodSelect.value);
        const report = `=====================================================
ISITKITCHENSAFE FREEZER BURN & SUBLIMATION REPORT
Food Substrate: ${food ? food.name : foodSelect.value}
Storage Time: ${durationSlider.value} Months
Freezer Burn Severity: ${severityPct ? severityPct.textContent : ''}
Sublimation Moisture Loss: ${sublimationVal ? sublimationVal.textContent : ''}
Lipid Rancidity (MDA): ${rancidityVal ? rancidityVal.textContent : ''}
Muscle Toughness Factor: ${toughnessVal ? toughnessVal.textContent : ''}
Palatability Rating: ${palatabilityVal ? palatabilityVal.textContent : ''}
USDA Safety Clearance: 100% Pathogen Inactive (Zero Bacterial Food Poisoning Risk)
Trimming Guideline: ${trimDepthBadge ? trimDepthBadge.textContent : ''} - ${trimAdvice ? trimAdvice.textContent : ''}
Culinary Salvage Method: ${salvageTechnique ? salvageTechnique.textContent : ''}
=====================================================
https://isitkitchensafe.com/tools/freezer-burn-sublimation-modeler/`;

        navigator.clipboard.writeText(report).then(() => {
          if (copyBtnText) copyBtnText.textContent = d.copiedFeedback;
          setTimeout(() => {
            if (copyBtnText) copyBtnText.textContent = d.copyReportBtn;
          }, 3000);
        }).catch(() => {
          alert('Report generated and printed to console.');
          console.log(report);
        });
      });
    }

    // Initial run
    calculate();
  });
</script>
