        <span id="telemetry-force-status" class="text-[11px] text-emerald-600 dark:text-emerald-400 font-semibold block mt-1">
          Effortless Manual Push (&lt;350 N Limit)
        </span>
      </div>

      <!-- Plunger Status -->
      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <span class="text-xs text-muted block mb-1">{d.plungerStatusLabel}</span>
        <span id="telemetry-plunger" class="text-base font-bold text-emerald-600 dark:text-emerald-400 block truncate">
          100% Operational Spring Ejection
        </span>
        <span id="telemetry-plunger-sub" class="text-[11px] text-muted block mt-1">
          Heated sleeve &bull; 65 N actuation force
        </span>
      </div>

      <!-- Wind Chill Temperature -->
      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <span class="text-xs text-muted block mb-1">{d.windChillLabel}</span>
        <div class="flex items-baseline gap-2">
          <span id="telemetry-windchill" class="text-2xl font-black font-mono text-cyan-600">-24.8°C</span>
          <span id="telemetry-windchill-f" class="text-xs text-muted font-mono">(-12.6°F)</span>
        </div>
        <span id="telemetry-windchill-status" class="text-[11px] text-cyan-700 dark:text-cyan-400 font-semibold block mt-1">
          High convective heat loss
        </span>
      </div>

      <!-- Core Body Temp -->
      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <span class="text-xs text-muted block mb-1">{d.coreTempLabel}</span>
        <div class="flex items-baseline gap-2">
          <span id="telemetry-core-temp" class="text-2xl font-black font-mono text-emerald-600">36.7°C</span>
          <span id="telemetry-core-temp-f" class="text-xs text-muted font-mono">(98.1°F)</span>
        </div>
        <span id="telemetry-core-status" class="text-[11px] text-emerald-600 dark:text-emerald-400 font-semibold block mt-1">
          Normothermic &bull; Active Shivering
        </span>
      </div>

      <!-- Dexterity Loss Time -->
      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <span class="text-xs text-muted block mb-1">{d.dexterityLabel}</span>
        <span id="telemetry-dexterity" class="text-2xl font-black font-mono text-ink">8.0 Min</span>
        <span id="telemetry-dexterity-status" class="text-[11px] text-amber-600 dark:text-amber-400 font-semibold block mt-1">
          Finger numbness &bull; Grip strength collapse
        </span>
      </div>

      <!-- Time to Severe Hypothermia -->
      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <span class="text-xs text-muted block mb-1">{d.hypothermiaLabel}</span>
        <span id="telemetry-hypothermia" class="text-2xl font-black font-mono text-ink">55 Min</span>
        <span id="telemetry-hypothermia-status" class="text-[11px] text-rose-600 dark:text-rose-400 font-semibold block mt-1">
          Cognitive confusion &bull; Arrhythmia window
        </span>
      </div>
    </div>

    <!-- Forensic Analysis Breakdown -->
    <div class="space-y-4 border-t border-hairline pt-6">
      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <span class="text-xs font-bold text-ink uppercase tracking-wider block mb-1">
          {d.primaryRiskLabel}
        </span>
        <p id="telemetry-risk-text" class="text-xs text-muted leading-relaxed">
          Standard operational status: Active frame heater keeps gasket at +18°C preventing frost bond formation. Dual-port heated vent equalizes negative air pressure within 3 seconds. Glow-in-the-dark plunger disengages latch smoothly.
        </p>
      </div>

      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <span class="text-xs font-bold text-ink uppercase tracking-wider block mb-1">
          {d.mechanismsLabel}
        </span>
        <p id="telemetry-mechanism-text" class="text-xs text-muted leading-relaxed">
          Isochoric cooling (Charles's Law: ΔP ≈ P·ΔT/T) generates minimal vacuum due to functioning relief vent. Ice adhesion stress τ_ice remains 0.0 kPa. Total required egress breakaway force (45 N) is well below the 350 N human push capacity threshold.
        </p>
      </div>

      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <span class="text-xs font-bold text-ink uppercase tracking-wider block mb-1">
          {d.mitigationLabel}
        </span>
        <p id="telemetry-mitigation-text" class="text-xs text-muted leading-relaxed">
          Maintain scheduled quarterly torque actuation tests of the internal emergency plunger. Log daily visual checks of the heated vent port to ensure zero rime ice bridging.
        </p>
      </div>
    </div>
  </div>

  <!-- Cold Vault Engineering Specification Matrix -->
  <div class="p-6 md:p-8 rounded-2xl bg-surface border border-hairline mb-10 overflow-hidden">
    <div class="mb-4">
      <h3 class="text-base font-bold text-ink">{d.tableTitle}</h3>
      <p class="text-xs text-muted mt-0.5">{d.tableSub}</p>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs border-collapse">
        <thead>
          <tr class="border-b border-hairline bg-surface-soft text-muted font-semibold">
            <th class="py-2.5 px-3">{d.colModel}</th>
            <th class="py-2.5 px-3">{d.colOperatingTemp}</th>
            <th class="py-2.5 px-3">{d.colDoorArea}</th>
            <th class="py-2.5 px-3">{d.colAirflow}</th>
            <th class="py-2.5 px-3">{d.colHeaterWattage}</th>
            <th class="py-2.5 px-3">{d.colInsulation}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline">
          {freezerData.freezerEnclosures.map(f => (
            <tr class="hover:bg-surface-soft/50 transition-colors">
              <td class="py-2.5 px-3 font-semibold text-ink">{f.name}</td>
              <td class="py-2.5 px-3 font-mono text-blue-600 font-medium">{f.operatingTempC}°C</td>
              <td class="py-2.5 px-3 font-mono">{f.doorAreaM2} m² ({f.doorWidthM}m &times; {f.doorHeightM}m)</td>
              <td class="py-2.5 px-3 font-mono">{f.evaporatorAirVelocityMs} m/s</td>
              <td class="py-2.5 px-3 font-mono">{f.heatedReliefVentWattage} W</td>
              <td class="py-2.5 px-3 font-mono">R-{f.insulationRValue}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Mandatory Life-Safety Rules -->
  <div class="p-6 md:p-8 rounded-2xl bg-surface border border-hairline">
    <div class="mb-6">
      <h3 class="text-base font-bold text-ink">{d.rulesTitle}</h3>
      <p class="text-xs text-muted mt-0.5">{d.rulesSub}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <h4 class="font-bold text-ink mb-1">{d.rule1Title}</h4>
        <p class="text-muted leading-relaxed">{d.rule1Text}</p>
      </div>

      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <h4 class="font-bold text-ink mb-1">{d.rule2Title}</h4>
        <p class="text-muted leading-relaxed">{d.rule2Text}</p>
      </div>

      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <h4 class="font-bold text-ink mb-1">{d.rule3Title}</h4>
        <p class="text-muted leading-relaxed">{d.rule3Text}</p>
      </div>

      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <h4 class="font-bold text-ink mb-1">{d.rule4Title}</h4>
        <p class="text-muted leading-relaxed">{d.rule4Text}</p>
      </div>
    </div>
  </div>
</div>

<script>
  import freezerData from '../data/walk-in-freezer-entrapment-data.json';

  function initModeler() {
    const freezerSelect = document.getElementById('freezer-select') as HTMLSelectElement | null;
    const latchSelect = document.getElementById('latch-select') as HTMLSelectElement | null;
    const heaterSelect = document.getElementById('heater-select') as HTMLSelectElement | null;
    const ventSelect = document.getElementById('vent-select') as HTMLSelectElement | null;
    const attireSelect = document.getElementById('attire-select') as HTMLSelectElement | null;

    const ambientSlider = document.getElementById('ambient-temp-slider') as HTMLInputElement | null;
    const ambientVal = document.getElementById('ambient-temp-val');
    const humiditySlider = document.getElementById('humidity-slider') as HTMLInputElement | null;
    const humidityVal = document.getElementById('humidity-val');
    const durationSlider = document.getElementById('duration-slider') as HTMLInputElement | null;
    const durationVal = document.getElementById('duration-val');
    const fanSpeedSlider = document.getElementById('fan-speed-slider') as HTMLInputElement | null;
    const fanSpeedVal = document.getElementById('fan-speed-val');

    const copyBtn = document.getElementById('copy-telemetry-btn');
    const copyBtnText = document.getElementById('copy-btn-text');

    if (!freezerSelect || !latchSelect || !heaterSelect || !ventSelect || !attireSelect) return;

    function recalculate() {
      const selectedFreezer = freezerData.freezerEnclosures.find(f => f.id === freezerSelect?.value) || freezerData.freezerEnclosures[0];
      const selectedLatch = freezerData.latchMechanisms.find(l => l.id === latchSelect?.value) || freezerData.latchMechanisms[0];
      const selectedHeater = freezerData.doorHeaterConditions.find(h => h.id === heaterSelect?.value) || freezerData.doorHeaterConditions[0];
      const selectedVent = freezerData.pressureReliefVentStates.find(v => v.id === ventSelect?.value) || freezerData.pressureReliefVentStates[0];
      const selectedAttire = freezerData.occupantAttireProfiles.find(a => a.id === attireSelect?.value) || freezerData.occupantAttireProfiles[0];

      const ambientC = parseFloat(ambientSlider?.value || '25');
      const humidity = parseFloat(humiditySlider?.value || '65');
      const durationMin = parseFloat(durationSlider?.value || '15');
      const fanSpeed = parseFloat(fanSpeedSlider?.value || '1.8');

      if (ambientVal) ambientVal.textContent = `${ambientC}°C (${(ambientC * 9/5 + 32).toFixed(1)}°F)`;
      if (humidityVal) humidityVal.textContent = `${humidity}% RH`;
      if (durationVal) durationVal.textContent = `${durationMin} Minutes`;
      if (fanSpeedVal) fanSpeedVal.textContent = `${fanSpeed.toFixed(1)} m/s (${(fanSpeed * 196.85).toFixed(0)} ft/min)`;

      // 1. Calculate Vacuum Force under Charles's Law & Vent Equalization
      // Inward vacuum holding force on door face: F_vac = ΔP * Area
      let vacuumForceN = 0;
      if (selectedVent.id === 'vent_frost_blocked') {
        // Delta T between ambient ingress and freezer chamber
        const deltaT = (ambientC + 273.15) - (selectedFreezer.operatingTempC + 273.15);
        const tempRatio = (ambientC + 273.15) / (selectedFreezer.operatingTempC + 273.15);
        // Peak isochoric vacuum differential Pa
        const peakVacuumPa = Math.min(1800, (tempRatio - 1.0) * 101325 * 0.12);
        vacuumForceN = peakVacuumPa * selectedFreezer.doorAreaM2;
      } else {
        vacuumForceN = selectedVent.vacuumDoorHoldingForceN;
      }

      // 2. Calculate Perimeter Gasket Ice Adhesion Breakaway Force
      // F_ice = tau_ice * Perimeter * contact_width (e.g. 0.025m)
      const contactWidthM = 0.025; // 25 mm gasket face
      const iceAreaM2 = selectedFreezer.perimeterM * contactWidthM;
      // Convert kPa to Pa: tau (kPa) * 1000 * Area
      const iceAdhesionStressPa = selectedHeater.iceAdhesionStressKpa * 1000.0;
      const iceShearForceN = iceAdhesionStressPa * iceAreaM2;

      // 3. Latch Mechanical Egress Force
      const baselineMechanicalReleaseN = selectedLatch.releaseForceRequiredN;

      // Total required door breakaway force
      let totalEgressResistanceN = 0;
      let isDeadlocked = false;

      if (selectedLatch.id === 'padlocked_exterior_hasp_no_override') {
        totalEgressResistanceN = 9999;
        isDeadlocked = true;
      } else if (selectedLatch.id === 'snapped_shear_pin_plunger') {
        totalEgressResistanceN = 999;
        isDeadlocked = true;
      } else {
        totalEgressResistanceN = baselineMechanicalReleaseN + iceShearForceN + vacuumForceN;
      }

      const totalLbf = (totalEgressResistanceN * 0.224809).toFixed(1);

      // 4. Wind Chill Calculation (Jag/Osczevski National Weather Service Formula)
      // T_wc = 13.12 + 0.6215*Ta - 11.37*v^0.16 + 0.3965*Ta*v^0.16 (Ta in °C, v in km/h)
      const vKmh = Math.max(1.8, fanSpeed * 3.6);
      const taC = selectedFreezer.operatingTempC;
      const windChillC = 13.12 + (0.6215 * taC) - (11.37 * Math.pow(vKmh, 0.16)) + (0.3965 * taC * Math.pow(vKmh, 0.16));
      const windChillF = (windChillC * 9/5 + 32).toFixed(1);

      // 5. Core Body Temperature Degradation Trajectory
      // Human body heat balance: M - E - R - C = S
      // Clo insulation damping: R_cl = 0.155 * cloValue (m²·K/W)
      // Cooling rate per hour: dT/dt ≈ (T_core - T_eff) / (mass * Cp * R_total)
      const clo = selectedAttire.cloValue;
      const rTotal = 0.05 + (0.155 * clo); // m²·K/W
      const surfaceArea = selectedAttire.bodySurfaceAreaM2; // 1.85 m²
      const bodyHeatCapacity = 75.0 * 3470.0; // mass (75 kg) * Cp (3470 J/kg·K) = 260,250 J/K
      
      const heatLossWatts = (surfaceArea * (37.0 - windChillC)) / rTotal;
      const netHeatLossWatts = Math.max(0, heatLossWatts - selectedAttire.metabolicHeatProductionW);
      
      // Total Joules lost over durationMin: Q = netLoss * (durationMin * 60)
      const totalHeatLossJoules = netHeatLossWatts * (durationMin * 60);
      const coreTempDropC = totalHeatLossJoules / bodyHeatCapacity;
      const currentCoreTempC = Math.max(24.0, 37.0 - coreTempDropC);
      const currentCoreTempF = (currentCoreTempC * 9/5 + 32).toFixed(1);

      // 6. Manual Dexterity Time Threshold (fingers reach 14°C)
      const baseDexterityMin = selectedAttire.criticalTimeManualDexterityMin;
      // Cold wind speed accelerates loss
      const adjustedDexterityMin = Math.max(2.0, baseDexterityMin * (2.0 / Math.max(1.0, fanSpeed)) * (clo / 1.0));

      // 7. Severe Hypothermia Time (core < 32°C)
      const neededDropForSevere = 5.0; // 37 - 32
      const coolingRatePerMin = (netHeatLossWatts * 60) / bodyHeatCapacity;
      const timeToSevereHypoMin = coolingRatePerMin > 0 ? (neededDropForSevere / coolingRatePerMin) : 999;

      // 8. Update UI Telemetry Elements
      const forceElem = document.getElementById('telemetry-force');
      const forceLbfElem = document.getElementById('telemetry-force-lbf');
      const forceStatusElem = document.getElementById('telemetry-force-status');
      const plungerElem = document.getElementById('telemetry-plunger');
      const plungerSubElem = document.getElementById('telemetry-plunger-sub');
      const windChillElem = document.getElementById('telemetry-windchill');
      const windChillFElem = document.getElementById('telemetry-windchill-f');
      const coreTempElem = document.getElementById('telemetry-core-temp');
      const coreTempFElem = document.getElementById('telemetry-core-temp-f');
      const coreStatusElem = document.getElementById('telemetry-core-status');
      const dexterityElem = document.getElementById('telemetry-dexterity');
      const hypothermiaElem = document.getElementById('telemetry-hypothermia');
      const complianceBadge = document.getElementById('compliance-badge');
      const riskText = document.getElementById('telemetry-risk-text');
      const mechanismText = document.getElementById('telemetry-mechanism-text');
      const mitigationText = document.getElementById('telemetry-mitigation-text');

      if (forceElem && forceLbfElem && forceStatusElem) {
        if (isDeadlocked) {
          forceElem.textContent = selectedLatch.id === 'padlocked_exterior_hasp_no_override' ? '∞ DEADLOCK' : 'DISCONNECTED';
          forceElem.className = 'text-2xl font-black font-mono text-red-600';
          forceLbfElem.textContent = '(Egress Impossible)';
          forceStatusElem.textContent = 'Zero egress capability — Mechanical failure';
          forceStatusElem.className = 'text-[11px] text-red-600 font-semibold block mt-1';
        } else {
          forceElem.textContent = `${Math.round(totalEgressResistanceN)} N`;
          forceLbfElem.textContent = `(${totalLbf} lbf)`;
          if (totalEgressResistanceN > 650) {
            forceElem.className = 'text-2xl font-black font-mono text-red-600';
            forceStatusElem.textContent = 'CRITICAL: Exceeds Panicked Human Push Limit (>650 N)';
            forceStatusElem.className = 'text-[11px] text-red-600 font-semibold block mt-1';
          } else if (totalEgressResistanceN > 350) {
            forceElem.className = 'text-2xl font-black font-mono text-amber-600';
            forceStatusElem.textContent = 'HIGH: Exceeds Standard Adult Push Strength (350–650 N)';
            forceStatusElem.className = 'text-[11px] text-amber-600 font-semibold block mt-1';
          } else {
            forceElem.className = 'text-2xl font-black font-mono text-emerald-600';
            forceStatusElem.textContent = 'Effortless Manual Push (<350 N Limit)';
            forceStatusElem.className = 'text-[11px] text-emerald-600 font-semibold block mt-1';
          }
        }
      }

      if (plungerElem && plungerSubElem) {
        if (selectedLatch.id === 'kason_safeguard_glow_plunger') {
          plungerElem.textContent = '100% Operational Spring Ejection';
          plungerElem.className = 'text-base font-bold text-emerald-600 dark:text-emerald-400 block truncate';
          plungerSubElem.textContent = 'Photoluminescent knob &bull; Heated guide sleeve &bull; 65 N stroke';
        } else if (selectedLatch.id === 'standard_unheated_push_rod') {
          plungerElem.textContent = selectedHeater.id === 'heater_dead_tripped_breaker' ? 'FROZEN SLEVE SEIZURE' : 'Operational (Moisture Susceptible)';
          plungerElem.className = selectedHeater.id === 'heater_dead_tripped_breaker' ? 'text-base font-bold text-rose-600 block truncate' : 'text-base font-bold text-amber-600 block truncate';
          plungerSubElem.textContent = selectedHeater.id === 'heater_dead_tripped_breaker' ? 'Thermal conduction froze moisture inside wall bore' : 'Unheated push-rod &bull; 120 N force required';
        } else if (selectedLatch.id === 'snapped_shear_pin_plunger') {
          plungerElem.textContent = 'FRACTURED NYLON SHEAR PIN';
          plungerElem.className = 'text-base font-bold text-red-600 block truncate';
          plungerSubElem.textContent = 'Plunger knob depresses smoothly but latchbolt remains deadlocked';
        } else {
          plungerElem.textContent = 'PADLOCKED AFTERMARKET HASP';
          plungerElem.className = 'text-base font-bold text-red-600 block truncate';
          plungerSubElem.textContent = 'Exterior lock shackle blocks all mechanical door movement';
        }
      }

      if (windChillElem && windChillFElem) {
        windChillElem.textContent = `${windChillC.toFixed(1)}°C`;
        windChillFElem.textContent = `(${windChillF}°F)`;
      }

      if (coreTempElem && coreTempFElem && coreStatusElem) {
        coreTempElem.textContent = `${currentCoreTempC.toFixed(1)}°C`;
        coreTempFElem.textContent = `(${currentCoreTempF}°F)`;

        if (currentCoreTempC < 28.0) {
          coreTempElem.className = 'text-2xl font-black font-mono text-purple-700';
          coreStatusElem.textContent = 'FATAL: Ventricular Fibrillation & Cardiac Arrest';
          coreStatusElem.className = 'text-[11px] text-purple-700 font-semibold block mt-1';
        } else if (currentCoreTempC < 32.0) {
          coreTempElem.className = 'text-2xl font-black font-mono text-red-600';
          coreStatusElem.textContent = 'SEVERE HYPOTHERMIA: Loss of Consciousness & Dilated Pupils';
          coreStatusElem.className = 'text-[11px] text-red-600 font-semibold block mt-1';
        } else if (currentCoreTempC < 35.0) {
          coreTempElem.className = 'text-2xl font-black font-mono text-amber-600';
          coreStatusElem.textContent = 'MILD HYPOTHERMIA: Violent Shivering & Slurred Speech';
          coreStatusElem.className = 'text-[11px] text-amber-600 font-semibold block mt-1';
        } else {
          coreTempElem.className = 'text-2xl font-black font-mono text-emerald-600';
          coreStatusElem.textContent = 'Normothermic &bull; Initial Peripheral Vasoconstriction';
          coreStatusElem.className = 'text-[11px] text-emerald-600 font-semibold block mt-1';
        }
      }

      if (dexterityElem) {
        dexterityElem.textContent = `${adjustedDexterityMin.toFixed(1)} Min`;
      }

      if (hypothermiaElem) {
        hypothermiaElem.textContent = timeToSevereHypoMin > 240 ? '>240 Min' : `${Math.round(timeToSevereHypoMin)} Min`;
      }

      // 9. Compliance Status
      const isOshaCompliant = selectedLatch.oshaCompliant && totalEgressResistanceN <= 350 && !isDeadlocked;
      if (complianceBadge) {
        if (isOshaCompliant) {
          complianceBadge.textContent = 'OSHA & NSF Compliant Egress';
          complianceBadge.className = 'px-3 py-1.5 rounded-xl text-xs font-bold uppercase tracking-wider bg-emerald-500/10 text-emerald-600 border border-emerald-500/20';
        } else if (isDeadlocked) {
          complianceBadge.textContent = 'CRIMINAL VIOLATION: OSHA 1910.36 DEADLOCK';
          complianceBadge.className = 'px-3 py-1.5 rounded-xl text-xs font-bold uppercase tracking-wider bg-red-600 text-white animate-pulse';
        } else {
          complianceBadge.textContent = 'NON-COMPLIANT: EXCESSIVE BREAKAWAY RESISTANCE';
          complianceBadge.className = 'px-3 py-1.5 rounded-xl text-xs font-bold uppercase tracking-wider bg-amber-500/10 text-amber-600 border border-amber-500/20';
        }
      }

      // 10. Descriptive Texts
      if (riskText && mechanismText && mitigationText) {
        if (selectedLatch.id === 'padlocked_exterior_hasp_no_override') {
          riskText.textContent = 'DEADLY CRIMINAL NEGLIGENCE: The cold vault door is padlocked externally without an interior safety egress bypass mechanism. The occupant is entirely trapped with zero mechanical self-rescue recourse.';
          mechanismText.textContent = 'Exterior hardened steel padlock shackle immobilizes the latch bolt against the frame keeper. Internal plunger pushes against an immovable mechanical dead-stop. The occupant cannot exert sufficient shear torque to fracture a 10 mm hardened shackle.';
          mitigationText.textContent = 'MANDATORY IMMEDIATE ACTION: Remove external padlock immediately. Replace exterior hardware with an ANSI/NSF Standard 7 compliant handle incorporating an internal bypass slot.';
        } else if (selectedLatch.id === 'snapped_shear_pin_plunger') {
          riskText.textContent = 'CONCEALED MECHANICAL DISCONNECT: The internal glow-in-the-dark plunger moves freely, giving the false tactile sensation of actuation, but the nylon shear pin inside the sleeve is severed.';
          mechanismText.textContent = 'Prior blunt impact broke the 4 mm injection-molded nylon retaining pin. The push rod slips axially through the sleeve without transmitting displacement to the external latch bolt. The door remains locked from outside.';
          mitigationText.textContent = 'MANDATORY REPAIR: Replace plunger linkage with a high-tensile 316 stainless steel roll-pin assembly. Verify weekly that depressing the internal plunger mechanically retracts the latch bolt.';
        } else if (totalEgressResistanceN > 650) {
          riskText.textContent = 'CATASTROPHIC VACUUM & ICE FREEZE-WELD LOCK: De-energized frame heater wire combined with a frost-occluded relief vent creates combined vacuum suction (up to 2,800 N) and ice adhesive shear bond (>750 N).';
          mechanismText.textContent = 'Warm kitchen air entering the vault cooled rapidly (Charles\'s Law: ΔP ≈ 1,450 Pa across 2.28 m² door = 3,300 N inward suction). Simultaneously, moisture on the cold frame froze at -14°C, creating a structural ice weld with adhesive shear strength exceeding human physical capability.';
          mitigationText.textContent = 'EMERGENCY PROTOCOL: Restore power to the 10 W/ft perimeter heat trace immediately. Clear the heated two-way pressure vent port with low-pressure de-icing spray. Install a secondary audible panic alarm button inside the vault.';
        } else {
          riskText.textContent = 'NORMAL COMPLIANT OPERATION: Cold room door hardware operates within statutory OSHA 1910.36 parameters. Frame heater maintains +18°C barrier, eliminating gasket ice formation.';
          mechanismText.textContent = 'Dual-port heated pressure relief port vents negative pressure differential within 3 seconds of door closure. Kason SafeGuard plunger actuates smoothly with 65 N human effort.';
          mitigationText.textContent = 'MAINTENANCE BEST PRACTICE: Perform quarterly actuation checks. Lubricate push-rod sleeves with USDA H1 food-grade low-temperature synthetic grease. Confirm photoluminescent glow duration remains above 8 hours.';
        }
      }
    }

    // Attach Event Listeners
    [freezerSelect, latchSelect, heaterSelect, ventSelect, attireSelect].forEach(sel => {
      sel.addEventListener('change', recalculate);
    });

    [ambientSlider, humiditySlider, durationSlider, fanSpeedSlider].forEach(slider => {
      slider.addEventListener('input', recalculate);
    });

    // Preset Buttons
    document.querySelectorAll('.preset-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const preset = btn.getAttribute('data-preset');
        if (preset === 'compliant') {
          freezerSelect.value = 'restaurant_standard_walkin';
          latchSelect.value = 'kason_safeguard_glow_plunger';
          heaterSelect.value = 'heater_active_10w_ft';
          ventSelect.value = 'vent_active_heated';
          attireSelect.value = 'certified_subzero_freezer_suit';
          if (ambientSlider) ambientSlider.value = '25';
          if (humiditySlider) humiditySlider.value = '65';
          if (durationSlider) durationSlider.value = '15';
          if (fanSpeedSlider) fanSpeedSlider.value = '1.8';
        } else if (preset === 'freeze-weld') {
          freezerSelect.value = 'distribution_cold_storage';
          latchSelect.value = 'standard_unheated_push_rod';
          heaterSelect.value = 'heater_dead_tripped_breaker';
          ventSelect.value = 'vent_frost_blocked';
          attireSelect.value = 'line_cook_hoodie';
          if (ambientSlider) ambientSlider.value = '30';
          if (humiditySlider) humiditySlider.value = '85';
          if (durationSlider) durationSlider.value = '35';
          if (fanSpeedSlider) fanSpeedSlider.value = '3.0';
        } else if (preset === 'shearpin-fail') {
          freezerSelect.value = 'institutional_blast_freezer';
          latchSelect.value = 'snapped_shear_pin_plunger';
          heaterSelect.value = 'heater_degraded_low_wattage';
          ventSelect.value = 'vent_active_heated';
          attireSelect.value = 'short_sleeve_chef_coat';
          if (ambientSlider) ambientSlider.value = '28';
          if (humiditySlider) humiditySlider.value = '70';
          if (durationSlider) durationSlider.value = '25';
          if (fanSpeedSlider) fanSpeedSlider.value = '4.5';
        } else if (preset === 'padlock-deadlock') {
          freezerSelect.value = 'aged_neglected_freezer';
          latchSelect.value = 'padlocked_exterior_hasp_no_override';
          heaterSelect.value = 'heater_dead_tripped_breaker';
          ventSelect.value = 'vent_frost_blocked';
          attireSelect.value = 'short_sleeve_chef_coat';
          if (ambientSlider) ambientSlider.value = '32';
          if (humiditySlider) humiditySlider.value = '90';
          if (durationSlider) durationSlider.value = '60';
          if (fanSpeedSlider) fanSpeedSlider.value = '2.2';
        }
        recalculate();
      });
    });

    // Copy Telemetry
    copyBtn?.addEventListener('click', () => {
      const selectedFreezer = freezerData.freezerEnclosures.find(f => f.id === freezerSelect?.value)?.name;
      const selectedLatch = freezerData.latchMechanisms.find(l => l.id === latchSelect?.value)?.name;
      const selectedHeater = freezerData.doorHeaterConditions.find(h => h.id === heaterSelect?.value)?.name;
      const selectedVent = freezerData.pressureReliefVentStates.find(v => v.id === ventSelect?.value)?.name;
      const selectedAttire = freezerData.occupantAttireProfiles.find(a => a.id === attireSelect?.value)?.name;

      const force = document.getElementById('telemetry-force')?.textContent;
      const windChill = document.getElementById('telemetry-windchill')?.textContent;
      const coreTemp = document.getElementById('telemetry-core-temp')?.textContent;
      const dexterity = document.getElementById('telemetry-dexterity')?.textContent;
      const hypo = document.getElementById('telemetry-hypothermia')?.textContent;
      const compliance = document.getElementById('compliance-badge')?.textContent;

      const report = `======================================================================
ISITKITCHENSAFE FORENSIC CRYOGENIC TELEMETRY AUDIT
Commercial Walk-In Freezer Entrapment & Emergency Release Modeler
======================================================================
Vault Architecture:   ${selectedFreezer}
Release Plunger:      ${selectedLatch}
Perimeter Heater:     ${selectedHeater}
Pressure Relief Vent: ${selectedVent}
Occupant Attire:      ${selectedAttire}
Duration Trapped:     ${durationSlider?.value} Minutes
Kitchen Ambient:      ${ambientSlider?.value}°C @ ${humiditySlider?.value}% RH
Evaporator Airflow:   ${fanSpeedSlider?.value} m/s

TELEMETRY & FORENSIC METRICS:
Total Egress Force:   ${force}
Effective Wind-Chill: ${windChill}
Core Body Temp:       ${coreTemp}
Manual Dexterity Loss:${dexterity}
Severe Hypothermia:   ${hypo}
Compliance Status:    ${compliance}

OSHA 1910.36 & UL 471 Cryogenic Safety Directive Enforced.
======================================================================`;

      navigator.clipboard.writeText(report).then(() => {
        if (copyBtnText) {
          const original = copyBtnText.textContent;
          copyBtnText.textContent = 'Copied to Clipboard!';
          setTimeout(() => {
            copyBtnText.textContent = original;
          }, 2000);
        }
      });
    });

    // Run Initial Calculation
    recalculate();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initModeler);
  } else {
    initModeler();
  }
</script>