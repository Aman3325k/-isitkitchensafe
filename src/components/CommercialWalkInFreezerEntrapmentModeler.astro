      <div id="compliance-badge" class="px-3 py-1.5 rounded-xl text-xs font-bold uppercase tracking-wider bg-emerald-500/10 text-emerald-600 border border-emerald-500/20">
        OSHA &amp; NSF Compliant Egress
      </div>
    </div>

    <!-- Telemetry Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-8">
      <!-- Total Door Opening Force -->
      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <span class="text-xs text-muted block mb-1">{d.egressForceLabel}</span>
        <div class="flex items-baseline gap-2">
          <span id="telemetry-force" class="text-2xl font-black font-mono text-ink">45 N</span>
