  </div>

  <!-- Real-Time Biomechanical & Cryogenic Telemetry Display -->
  <div class="p-6 md:p-8 rounded-2xl bg-surface border border-hairline shadow-xs mb-10">
    <div class="flex flex-wrap items-center justify-between gap-2 mb-6">
      <div>
        <h3 class="text-lg font-bold text-ink">{d.diagnosticTitle}</h3>
