const d = DICTIONARY[lang] || DICTIONARY.en;
---

<div class="bg-surface-soft border border-hairline rounded-3xl p-6 md:p-10 shadow-xs mb-12" id="walkin-freezer-modeler">
  <!-- Header Badge -->
  <div class="flex flex-wrap items-center justify-between gap-4 mb-8 pb-6 border-b border-hairline">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-blue-600/10 text-blue-700 dark:text-blue-400 mb-2 border border-blue-600/20">
        <span>❄️</span>
        {d.badge}
      </div>
      <h2 class="text-2xl md:text-3xl font-extrabold text-ink tracking-tight">
        {d.title}
      </h2>
      <p class="text-sm md:text-base text-muted mt-1 max-w-3xl">
        {d.subtitle}
      </p>
    </div>

    <button 
      type="button" 
      id="copy-telemetry-btn"
      class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-surface border border-hairline hover:bg-surface-hover text-ink text-xs font-semibold shadow-xs transition-colors cursor-pointer"
    >
      <svg class="w-4 h-4 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
      </svg>
      <span id="copy-btn-text">{d.copyReportBtn}</span>
    </button>
  </div>

  <!-- Presets Bar -->
  <div class="mb-10 p-5 rounded-2xl bg-surface border border-hairline">
    <div class="text-xs font-bold uppercase tracking-wider text-muted mb-3">
      {d.presetsTitle}
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
      <button 
        type="button" 
        data-preset="compliant"
        class="preset-btn px-4 py-3 rounded-xl border border-hairline bg-surface-soft hover:bg-surface-hover text-left transition-all text-xs font-medium text-ink flex flex-col justify-between"
      >
        <span class="font-bold text-emerald-600 dark:text-emerald-400 mb-1">✓ {d.presetCompliant}</span>
        <span class="text-[11px] text-muted">Kason Glow Plunger &bull; 10 W/ft Heat &bull; Heated Vent</span>
      </button>

      <button 
        type="button" 
        data-preset="freeze-weld"
        class="preset-btn px-4 py-3 rounded-xl border border-hairline bg-surface-soft hover:bg-surface-hover text-left transition-all text-xs font-medium text-ink flex flex-col justify-between"
      >
        <span class="font-bold text-amber-600 dark:text-amber-400 mb-1">⚠️ {d.presetFreezeWeld}</span>
        <span class="text-[11px] text-muted">Dead Heater (0 W/ft) &bull; Frozen Relief Port &bull; 2,800 N Lock</span>
      </button>

      <button 
        type="button" 
        data-preset="shearpin-fail"
        class="preset-btn px-4 py-3 rounded-xl border border-hairline bg-surface-soft hover:bg-surface-hover text-left transition-all text-xs font-medium text-ink flex flex-col justify-between"
      >
        <span class="font-bold text-rose-600 dark:text-rose-400 mb-1">🚨 {d.presetShearPinFail}</span>
        <span class="text-[11px] text-muted">Broken Nylon Pin &bull; Plunger Spins &bull; Zero Latch Action</span>
      </button>

      <button 
        type="button" 
        data-preset="padlock-deadlock"
        class="preset-btn px-4 py-3 rounded-xl border border-hairline bg-surface-soft hover:bg-surface-hover text-left transition-all text-xs font-medium text-ink flex flex-col justify-between"
      >
        <span class="font-bold text-red-600 dark:text-red-400 mb-1">☠️ {d.presetPadlockDeadlock}</span>
        <span class="text-[11px] text-muted">External Master Padlock &bull; Complete Deadlock &bull; Fatal Risk</span>
      </button>
    </div>
  </div>

  <!-- Interactive Controls Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-10">
    <!-- Left Column: Hardware & Enclosure Selectors -->
    <div class="space-y-6 p-6 rounded-2xl bg-surface border border-hairline">
      <div>
        <h3 class="text-base font-bold text-ink">{d.controlsTitle}</h3>
        <p class="text-xs text-muted mt-1">{d.controlsSub}</p>
      </div>

      <!-- Enclosure Type -->
      <div>
        <label for="freezer-select" class="block text-xs font-semibold text-ink mb-1.5">
          {d.enclosureLabel}
        </label>
        <select 
          id="freezer-select" 
          class="w-full text-xs font-medium bg-surface-soft border border-hairline rounded-xl px-3 py-2.5 text-ink focus:outline-hidden focus:ring-2 focus:ring-blue-500"
        >
          {freezerData.freezerEnclosures.map(f => (
            <option value={f.id}>{f.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1">{d.enclosureHelp}</p>
      </div>

      <!-- Latch & Release Mechanism -->
      <div>
        <label for="latch-select" class="block text-xs font-semibold text-ink mb-1.5">
          {d.latchLabel}
        </label>
        <select 
          id="latch-select" 
          class="w-full text-xs font-medium bg-surface-soft border border-hairline rounded-xl px-3 py-2.5 text-ink focus:outline-hidden focus:ring-2 focus:ring-blue-500"
        >
          {freezerData.latchMechanisms.map(l => (
            <option value={l.id}>{l.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1">{d.latchHelp}</p>
      </div>

      <!-- Perimeter Heater Condition -->
      <div>
        <label for="heater-select" class="block text-xs font-semibold text-ink mb-1.5">
          {d.heaterLabel}
        </label>
        <select 
          id="heater-select" 
          class="w-full text-xs font-medium bg-surface-soft border border-hairline rounded-xl px-3 py-2.5 text-ink focus:outline-hidden focus:ring-2 focus:ring-blue-500"
        >
          {freezerData.doorHeaterConditions.map(h => (
            <option value={h.id}>{h.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1">{d.heaterHelp}</p>
      </div>

      <!-- Pressure Equalization Vent -->
      <div>
        <label for="vent-select" class="block text-xs font-semibold text-ink mb-1.5">
          {d.ventLabel}
        </label>
        <select 
          id="vent-select" 
          class="w-full text-xs font-medium bg-surface-soft border border-hairline rounded-xl px-3 py-2.5 text-ink focus:outline-hidden focus:ring-2 focus:ring-blue-500"
        >
          {freezerData.pressureReliefVentStates.map(v => (
            <option value={v.id}>{v.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1">{d.ventHelp}</p>
      </div>

      <!-- Worker Attire -->
      <div>
        <label for="attire-select" class="block text-xs font-semibold text-ink mb-1.5">
          {d.attireLabel}
        </label>
        <select 
          id="attire-select" 
          class="w-full text-xs font-medium bg-surface-soft border border-hairline rounded-xl px-3 py-2.5 text-ink focus:outline-hidden focus:ring-2 focus:ring-blue-500"
        >
          {freezerData.occupantAttireProfiles.map(a => (
            <option value={a.id}>{a.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1">{d.attireHelp}</p>
      </div>
    </div>

    <!-- Right Column: Environmental & Operational Sliders -->
    <div class="space-y-6 p-6 rounded-2xl bg-surface border border-hairline flex flex-col justify-between">
      <div>
        <h3 class="text-base font-bold text-ink">Environmental &amp; Human Exposure Variables</h3>
        <p class="text-xs text-muted mt-1">Adjust ambient kitchen thermodynamics, trapped dwell time, and air circulation velocity.</p>
      </div>

      <!-- Ambient Temp Slider -->
      <div>
        <div class="flex items-center justify-between text-xs font-semibold text-ink mb-1">
          <span>{d.ambientSliderLabel}</span>
          <span id="ambient-temp-val" class="font-mono text-blue-600 font-bold">25°C (77°F)</span>
        </div>
        <input 
          type="range" 
          id="ambient-temp-slider" 
          min="15" 
          max="40" 
          step="1" 
          value="25"
          class="w-full accent-blue-600 cursor-pointer"
        />
        <p class="text-[11px] text-muted mt-1">{d.ambientSliderHelp}</p>
      </div>

      <!-- Ambient Humidity Slider -->
      <div>
        <div class="flex items-center justify-between text-xs font-semibold text-ink mb-1">
          <span>{d.humiditySliderLabel}</span>
          <span id="humidity-val" class="font-mono text-blue-600 font-bold">65% RH</span>
        </div>
        <input 
          type="range" 
          id="humidity-slider" 
          min="30" 
          max="95" 
          step="5" 
          value="65"
          class="w-full accent-blue-600 cursor-pointer"
        />
        <p class="text-[11px] text-muted mt-1">{d.humiditySliderHelp}</p>
      </div>

      <!-- Entrapment Duration Slider -->
      <div>
        <div class="flex items-center justify-between text-xs font-semibold text-ink mb-1">
          <span>{d.durationSliderLabel}</span>
          <span id="duration-val" class="font-mono text-rose-600 font-bold">15 Minutes</span>
        </div>
        <input 
          type="range" 
          id="duration-slider" 
          min="1" 
          max="180" 
          step="1" 
          value="15"
