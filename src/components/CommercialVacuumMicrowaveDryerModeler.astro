    rule1Text: "100 mbar 以下で稼働する全ての工業用真空マイクロ波加熱装置は、受光アークセンサーと連動した高速クローバー回路を装備し、10 ミリ秒以内に発振を遮断しなければなりません。15〜50 mbar の希薄空気中では絶縁破壊電界が極小値（タウンゼント最小値 ~250–350 V/cm）に低下します。放電アークは 5,000°C の火球へ急拡大し、PTFE ベルトや石英覗き窓を破壊します。",
    rule2Title: "三端子フェライトサーキュレーターおよび純水ダミーロード保護",
    rule2Text: "各マグネトロン導波管は 20 dB 以上のアイソレーションを持つ三端子フェライトサーキュレーターを介して水冷ダミー負荷へ接続される必要があります。乾燥末期に食品の誘電損失（ε″）が >20 から <0.5 へ急減すると、最大 45% のマイクロ波が反射されます。サーキュレーターが無ければ反射波がマグネトロンアンテナに直接逆流し、陰極溶損を引き起こします。",
    rule3Title: "真空チャンバー運転圧力の最適化領域 (30〜60 mbar)",
    rule3Text: "チャンバー内真空度は 30〜60 mbar の安全領域内に維持する必要があります。20 mbar 未満の深真空ではタウンゼント放電の極小トラフに突入し、プラズマ発光リスクが激増します。一方 80 mbar 超では沸点が 45°C〜50°C を超え、アントシアニン等の生理活性成分やプロバイオティクスが死滅します。",
    rule4Title: "OSHA 1910.97 マイクロ波電波漏洩防護規格",
    rule4Text: "真空ロータリーバルブや点検窓周辺のマイクロ波漏洩量は、装置外表面から 5 cm の位置で 5.0 mW/cm²（作業環境上限 10 mW/cm²）を厳格に下回らなければなりません。全ての開口部にはカテゴリー 4 安全インターロックおよび常時監視 RF スニファーセンサーを装備する必要があります。",
    copyReportBtn: "真空マイクロ波測定データをコピー",
    copiedFeedback: "測定レポートをクリップボードにコピーしました！"
  }
};

const d = DICTIONARY[lang] || DICTIONARY.en;
const data = vacuumData;
---

<section class="max-w-7xl mx-auto px-4 py-8">
  <div class="mb-8">
    <div class="flex items-center gap-2 mb-3">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-purple-700 text-white">
        {d.badge}
      </span>
      <span class="text-xs text-muted font-mono">IEC 60519-6 &bull; NFPA 86 &bull; OSHA 1910.97 &bull; FDA 21 CFR § 110</span>
    </div>
    <h1 class="text-title-xl sm:text-4xl font-bold text-ink tracking-tight mb-3">
      {d.title}
    </h1>
    <p class="text-body text-base text-muted max-w-4xl leading-relaxed">
      {d.subtitle}
    </p>
  </div>

  <!-- Operational Presets -->
  <div class="bg-surface border border-hairline rounded-2xl p-5 mb-8 shadow-xs">
    <h3 class="text-sm font-semibold text-ink uppercase tracking-wider mb-3">
      {d.presetsTitle}
    </h3>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
      <button 
        type="button"
        id="btn-preset-gentle" 
        class="text-left p-3 rounded-xl border border-hairline/70 hover:border-purple-600 bg-surface-soft hover:bg-purple-500/5 transition-all text-xs"
      >
        <span class="font-bold text-ink block mb-1 flex items-center justify-between">
          <span>🍇 Berry Cold Dehydration</span>
          <span class="text-[10px] px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-700 font-mono">SAFE</span>
        </span>
        <span class="text-muted text-[11px] leading-tight block">
          {d.presetGentle}
        </span>
      </button>

      <button 
        type="button"
        id="btn-preset-coffee" 
        class="text-left p-3 rounded-xl border border-hairline/70 hover:border-purple-600 bg-surface-soft hover:bg-purple-500/5 transition-all text-xs"
      >
        <span class="font-bold text-ink block mb-1 flex items-center justify-between">
          <span>☕ Soluble Coffee Puff</span>
          <span class="text-[10px] px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-700 font-mono">SAFE</span>
        </span>
        <span class="text-muted text-[11px] leading-tight block">
          {d.presetCoffee}
        </span>
      </button>

      <button 
        type="button"
        id="btn-preset-scorch" 
        class="text-left p-3 rounded-xl border border-hairline/70 hover:border-purple-600 bg-surface-soft hover:bg-purple-500/5 transition-all text-xs"
      >
        <span class="font-bold text-ink block mb-1 flex items-center justify-between">
          <span>🔥 Hotspot Dry Scorching</span>
          <span class="text-[10px] px-1.5 py-0.5 rounded bg-amber-500/10 text-amber-700 font-mono">WARN</span>
        </span>
        <span class="text-muted text-[11px] leading-tight block">
          {d.presetScorch}
        </span>
      </button>

      <button 
        type="button"
        id="btn-preset-arc" 
        class="text-left p-3 rounded-xl border border-hairline/70 hover:border-purple-600 bg-surface-soft hover:bg-purple-500/5 transition-all text-xs"
      >
        <span class="font-bold text-ink block mb-1 flex items-center justify-between">
          <span>⚡ Townsend Plasma Arc</span>
          <span class="text-[10px] px-1.5 py-0.5 rounded bg-rose-500/10 text-rose-700 font-mono">CRITICAL</span>
        </span>
        <span class="text-muted text-[11px] leading-tight block">
          {d.presetArc}
        </span>
      </button>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-10">
    <!-- Controls Panel -->
    <div class="lg:col-span-5 bg-surface border border-hairline rounded-2xl p-6 shadow-xs flex flex-col justify-between">
      <div>
        <div class="border-b border-hairline pb-4 mb-5">
          <h2 class="text-title-sm font-semibold text-ink">
            {d.controlsTitle}
          </h2>
          <p class="text-xs text-muted mt-1">
            {d.controlsSub}
          </p>
        </div>

        <div class="space-y-4">
          <!-- Dryer Architecture -->
          <div>
            <label for="select-dryer" class="block text-xs font-medium text-ink mb-1">
              {d.dryerLabel}
            </label>
            <select 
              id="select-dryer" 
              class="w-full bg-surface-soft border border-hairline rounded-xl px-3 py-2 text-xs text-ink focus:outline-none focus:border-purple-600 font-mono"
            >
              {data.dryerArchitectures.map((arch) => (
                <option value={arch.id}>{arch.name}</option>
              ))}
            </select>
            <span class="text-[11px] text-muted block mt-1 leading-normal">
              {d.dryerHelp}
            </span>
          </div>

          <!-- Food Product Profile -->
          <div>
            <label for="select-product" class="block text-xs font-medium text-ink mb-1">
              {d.productLabel}
            </label>
            <select 
              id="select-product" 
              class="w-full bg-surface-soft border border-hairline rounded-xl px-3 py-2 text-xs text-ink focus:outline-none focus:border-purple-600 font-mono"
            >
              {data.foodProductProfiles.map((prod) => (
                <option value={prod.id}>{prod.name}</option>
              ))}
            </select>
            <span class="text-[11px] text-muted block mt-1 leading-normal">
              {d.productHelp}
            </span>
          </div>

          <!-- Waveguide Configuration -->
          <div>
            <label for="select-waveguide" class="block text-xs font-medium text-ink mb-1">
              {d.waveguideLabel}
            </label>
            <select 
              id="select-waveguide" 
              class="w-full bg-surface-soft border border-hairline rounded-xl px-3 py-2 text-xs text-ink focus:outline-none focus:border-purple-600 font-mono"
            >
              {data.microwaveWaveguideConfigurations.map((wg) => (
                <option value={wg.id}>{wg.name}</option>
              ))}
            </select>
            <span class="text-[11px] text-muted block mt-1 leading-normal">
              {d.waveguideHelp}
            </span>
          </div>

          <!-- Absolute Pressure -->
          <div>
            <div class="flex justify-between items-center text-xs mb-1">
              <label for="range-pressure" class="font-medium text-ink">
                {d.pressureLabel}
              </label>
              <span id="val-pressure" class="font-mono text-purple-700 font-bold">35 mbar</span>
            </div>
            <input 
              type="range" 
              id="range-pressure" 
              min="10" 
              max="120" 
              step="1" 
              value="35"
              class="w-full accent-purple-600"
            />
            <span class="text-[11px] text-muted block mt-1">
              {d.pressureHelp}
            </span>
          </div>

          <!-- Applied Microwave Power -->
          <div>
            <div class="flex justify-between items-center text-xs mb-1">
              <label for="range-power" class="font-medium text-ink">
                {d.powerLabel}
              </label>
              <span id="val-power" class="font-mono text-purple-700 font-bold">42 kW</span>
            </div>
            <input 
              type="range" 
              id="range-power" 
              min="5" 
              max="120" 
              step="1" 
              value="42"
              class="w-full accent-purple-600"
            />
            <span class="text-[11px] text-muted block mt-1">
              {d.powerHelp}
            </span>
          </div>

          <!-- Throughput -->
          <div>
            <div class="flex justify-between items-center text-xs mb-1">
              <label for="range-throughput" class="font-medium text-ink">
                {d.throughputLabel}
              </label>
              <span id="val-throughput" class="font-mono text-purple-700 font-bold">120 kg/h</span>
            </div>
            <input 
              type="range" 
              id="range-throughput" 
              min="20" 
              max="500" 
              step="5" 
              value="120"
              class="w-full accent-purple-600"
            />
            <span class="text-[11px] text-muted block mt-1">
              {d.throughputHelp}
            </span>
          </div>

          <!-- Bed Depth Layer Thickness -->
          <div>
            <div class="flex justify-between items-center text-xs mb-1">
              <label for="range-bed-depth" class="font-medium text-ink">
                {d.bedDepthLabel}
              </label>
              <span id="val-bed-depth" class="font-mono text-purple-700 font-bold">12 mm</span>
            </div>
            <input 
              type="range" 
              id="range-bed-depth" 
              min="2" 
              max="35" 
              step="1" 
              value="12"
              class="w-full accent-purple-600"
            />
            <span class="text-[11px] text-muted block mt-1">
              {d.bedDepthHelp}
            </span>
          </div>

          <!-- Conveyor Speed -->
          <div>
            <div class="flex justify-between items-center text-xs mb-1">
              <label for="range-speed" class="font-medium text-ink">
                {d.speedLabel}
              </label>
              <span id="val-speed" class="font-mono text-purple-700 font-bold">1.2 m/min</span>
            </div>
            <input 
              type="range" 
              id="range-speed" 
              min="0.2" 
              max="3.0" 
              step="0.1" 
              value="1.2"
              class="w-full accent-purple-600"
            />
            <span class="text-[11px] text-muted block mt-1">
              {d.speedHelp}
            </span>
          </div>

          <!-- Target Exit Moisture -->
          <div>
            <div class="flex justify-between items-center text-xs mb-1">
              <label for="range-exit-moisture" class="font-medium text-ink">
                {d.exitMoistureLabel}
              </label>
              <span id="val-exit-moisture" class="font-mono text-purple-700 font-bold">4.0 %</span>
            </div>
            <input 
              type="range" 
              id="range-exit-moisture" 
              min="1.0" 
              max="15.0" 
              step="0.5" 
              value="4.0"
              class="w-full accent-purple-600"
            />
            <span class="text-[11px] text-muted block mt-1">
              {d.exitMoistureHelp}
            </span>
          </div>
        </div>
      </div>

      <div class="pt-6 border-t border-hairline mt-6">
        <button 
          type="button" 
          id="btn-copy-report"
          class="w-full py-2.5 px-4 bg-purple-700 hover:bg-purple-800 text-white rounded-xl text-xs font-semibold flex items-center justify-center gap-2 transition-colors shadow-xs"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
          </svg>
          <span id="btn-copy-text">{d.copyReportBtn}</span>
        </button>
      </div>
    </div>

    <!-- Diagnostic Telemetry Panel -->
    <div class="lg:col-span-7 space-y-6">
      <!-- Status Banner -->
      <div id="box-safety-status" class="p-5 rounded-2xl border transition-all bg-emerald-500/10 border-emerald-500/30 text-emerald-900">
        <div class="flex items-start gap-3">
          <div id="icon-safety-status" class="mt-0.5 text-2xl">
            ✅
          </div>
          <div class="flex-1">
            <div class="flex items-center justify-between gap-2 mb-1">
              <h3 class="text-sm font-bold uppercase tracking-wider">
                {d.safetyStatusLabel}
              </h3>
              <span id="badge-safety-verdict" class="text-[11px] font-mono px-2 py-0.5 rounded font-bold bg-emerald-600 text-white">
                SAFE_OPTIMAL
              </span>
            </div>
            <p id="desc-primary-risk" class="text-xs font-semibold mb-1">
              Chamber operating safely in stable sub-Townsend breakdown zone with minimal reflection.
            </p>
            <p id="desc-mechanisms" class="text-xs text-muted mb-2 leading-relaxed">
              Electric field (145 V/cm) remains below Townsend threshold (320 V/cm). Cold evaporation maintains berry phytochemical integrity.
            </p>
            <div class="pt-2 border-t border-hairline/40 flex items-center justify-between text-[11px]">
              <span class="font-medium text-ink">{d.mitigationLabel}</span>
              <span id="desc-mitigation" class="text-muted font-mono">
                IEC 60519-6 interlocks active &bull; Optical arc detector online (5 ms crowbar)
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Live Reactive Schematic (SVG) -->
      <div class="bg-surface border border-hairline rounded-2xl p-5 shadow-xs">
        <div class="flex items-center justify-between mb-3 border-b border-hairline pb-2">
          <span class="text-xs font-bold text-ink uppercase tracking-wider">
            Continuous Vacuum Microwave Chamber &amp; Plasma Arc Telemetry
          </span>
          <span id="badge-chamber-status" class="text-[10px] font-mono px-2 py-0.5 rounded bg-purple-500/10 text-purple-700 font-semibold">
            CHAMBER: ONLINE
          </span>
        </div>
        <div class="w-full overflow-hidden rounded-xl bg-slate-950 p-3 text-slate-100 font-mono text-[11px]">
          <svg viewBox="0 0 760 270" class="w-full h-auto" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="vacChamberGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#1e293b"/>
                <stop offset="100%" stop-color="#0f172a"/>
              </linearGradient>
              <linearGradient id="mwWaveGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#a855f7" stop-opacity="0.8"/>
                <stop offset="100%" stop-color="#3b82f6" stop-opacity="0.1"/>
              </linearGradient>
            </defs>

            <!-- Vacuum Vessel Shell -->
            <rect x="50" y="30" width="660" height="190" rx="20" fill="url(#vacChamberGrad)" stroke="#475569" stroke-width="2"/>
            <text x="65" y="55" fill="#94a3b8" font-size="11" font-weight="bold">316L SS VACUUM VESSEL (IEC 60519-6)</text>

            <!-- Rotary Vacuum Locks (Inlet & Outlet) -->
            <rect x="15" y="100" width="45" height="50" rx="6" fill="#334155" stroke="#64748b"/>
            <text x="18" y="128" fill="#cbd5e1" font-size="9">FEED LOCK</text>
            <rect x="700" y="100" width="45" height="50" rx="6" fill="#334155" stroke="#64748b"/>
            <text x="704" y="128" fill="#cbd5e1" font-size="9">DISCHARGE</text>

            <!-- Microwave Magnetron Launchers (Top) -->
            <g id="svg-waveguides">
              <rect x="150" y="12" width="70" height="22" rx="4" fill="#6d28d9" stroke="#c084fc"/>
              <text x="155" y="27" fill="#ffffff" font-size="9">MAG 1 (12kW)</text>
              <polygon points="175,34 195,34 220,110 150,110" fill="url(#mwWaveGrad)"/>

              <rect x="345" y="12" width="70" height="22" rx="4" fill="#6d28d9" stroke="#c084fc"/>
              <text x="350" y="27" fill="#ffffff" font-size="9">MAG 2 (12kW)</text>
              <polygon points="370,34 390,34 415,110 345,110" fill="url(#mwWaveGrad)"/>

              <rect x="540" y="12" width="70" height="22" rx="4" fill="#6d28d9" stroke="#c084fc"/>
              <text x="545" y="27" fill="#ffffff" font-size="9">MAG 3 (12kW)</text>
              <polygon points="565,34 585,34 610,110 540,110" fill="url(#mwWaveGrad)"/>
            </g>

            <!-- 3-Port Ferrite Circulator & Dummy Load Icon -->
            <circle cx="280" cy="23" r="11" fill="#0284c7" stroke="#38bdf8"/>
            <text x="274" y="27" fill="#ffffff" font-size="8">CIRC</text>
            <rect x="295" y="15" width="35" height="16" rx="3" fill="#0369a1"/>
            <text x="298" y="26" fill="#e0f2fe" font-size="7">DI LOAD</text>

            <!-- Vacuum Pump Port & Vapor Extraction Pipe -->
            <rect x="445" y="18" width="60" height="14" rx="2" fill="#059669"/>
            <text x="450" y="28" fill="#ffffff" font-size="8">VAC CONDENSER</text>

            <!-- Conveyor Belt (PTFE) -->
            <line x1="70" y1="145" x2="690" y2="145" stroke="#e2e8f0" stroke-width="4"/>
            <circle cx="75" cy="145" r="7" fill="#64748b"/>
            <circle cx="685" cy="145" r="7" fill="#64748b"/>

            <!-- Product Layer on Belt -->
            <rect id="svg-product-bed" x="80" y="137" width="600" height="7" fill="#f59e0b" rx="2"/>

            <!-- Optical Arc Sensor / Pyrometer -->
            <polygon points="630,70 655,70 642,85" fill="#f43f5e"/>
            <text x="605" y="65" fill="#f43f5e" font-size="9">ARC DETECTOR</text>

            <!-- Dynamic Telemetry Badges inside SVG -->
            <g transform="translate(70, 165)">
              <rect width="180" height="45" rx="6" fill="#1e293b" stroke="#334155"/>
              <text x="10" y="18" fill="#94a3b8" font-size="9">CHAMBER ELECTRIC FIELD</text>
              <text id="svg-val-efield" x="10" y="36" fill="#a855f7" font-size="13" font-weight="bold">145 V/cm</text>
            </g>

            <g transform="translate(265, 165)">
              <rect width="165" height="45" rx="6" fill="#1e293b" stroke="#334155"/>
              <text x="10" y="18" fill="#94a3b8" font-size="9">TOWNSEND ARC MARGIN</text>
              <text id="svg-val-arc-margin" x="10" y="36" fill="#10b981" font-size="13" font-weight="bold">+175 V/cm (SAFE)</text>
            </g>

            <g transform="translate(445, 165)">
              <rect width="145" height="45" rx="6" fill="#1e293b" stroke="#334155"/>
              <text x="10" y="18" fill="#94a3b8" font-size="9">VAC SAT BOILING POINT</text>
              <text id="svg-val-tsat" x="10" y="36" fill="#38bdf8" font-size="13" font-weight="bold">26.8 °C (80.2 °F)</text>
            </g>

            <g transform="translate(600, 165)">
              <rect width="100" height="45" rx="6" fill="#1e293b" stroke="#334155"/>
              <text x="8" y="18" fill="#94a3b8" font-size="8">FLASH EVAP</text>
              <text id="svg-val-evap" x="8" y="36" fill="#f59e0b" font-size="12" font-weight="bold">76.3 kg/h</text>
            </g>
          </svg>
        </div>
      </div>

      <!-- Telemetry Output Cards Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- 1. Townsend Plasma Margin -->
        <div class="bg-surface border border-hairline rounded-2xl p-4 shadow-xs">
          <span class="text-[11px] text-muted block mb-1 font-medium">{d.townsendLabel}</span>
          <div id="telemetry-townsend-margin" class="text-xl font-bold font-mono text-ink">
            +175 V/cm
          </div>
          <span id="telemetry-townsend-status" class="text-[10px] px-1.5 py-0.5 rounded font-mono font-bold mt-2 inline-block bg-emerald-500/10 text-emerald-700">
            SUB-BREAKDOWN SAFE
          </span>
        </div>

        <!-- 2. Vacuum Boiling Point -->
        <div class="bg-surface border border-hairline rounded-2xl p-4 shadow-xs">
          <span class="text-[11px] text-muted block mb-1 font-medium">{d.boilingPointLabel}</span>
          <div id="telemetry-boiling-point" class="text-xl font-bold font-mono text-ink">
            26.8 °C (80.2 °F)
          </div>
          <span id="telemetry-boiling-status" class="text-[10px] px-1.5 py-0.5 rounded font-mono font-bold mt-2 inline-block bg-blue-500/10 text-blue-700">
            COLD PRESERVATION
          </span>
        </div>

        <!-- 3. Flash Evaporation Rate -->
        <div class="bg-surface border border-hairline rounded-2xl p-4 shadow-xs">
          <span class="text-[11px] text-muted block mb-1 font-medium">{d.evapRateLabel}</span>
          <div id="telemetry-evap-rate" class="text-xl font-bold font-mono text-ink">
            76.3 kg/h
          </div>
          <span id="telemetry-evap-status" class="text-[10px] px-1.5 py-0.5 rounded font-mono font-bold mt-2 inline-block bg-amber-500/10 text-amber-700">
            BALANCED REMOVAL
          </span>
        </div>

        <!-- 4. Surface Hotspot Temp -->
        <div class="bg-surface border border-hairline rounded-2xl p-4 shadow-xs">
          <span class="text-[11px] text-muted block mb-1 font-medium">{d.hotspotTempLabel}</span>
          <div id="telemetry-hotspot-temp" class="text-xl font-bold font-mono text-ink">
