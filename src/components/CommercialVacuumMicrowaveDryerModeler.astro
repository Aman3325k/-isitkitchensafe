<script is:inline define:vars={{ vacuumDataJson: JSON.stringify(vacuumData), langCode: lang }}>
(function() {
  const modelData = JSON.parse(vacuumDataJson);

  // DOM Elements
  const selDryer = document.getElementById('select-dryer');
  const selProduct = document.getElementById('select-product');
  const selWaveguide = document.getElementById('select-waveguide');

  const rngPressure = document.getElementById('range-pressure');
  const rngPower = document.getElementById('range-power');
  const rngThroughput = document.getElementById('range-throughput');
  const rngBedDepth = document.getElementById('range-bed-depth');
  const rngSpeed = document.getElementById('range-speed');
  const rngExitMoisture = document.getElementById('range-exit-moisture');

  const valPressure = document.getElementById('val-pressure');
  const valPower = document.getElementById('val-power');
  const valThroughput = document.getElementById('val-throughput');
  const valBedDepth = document.getElementById('val-bed-depth');
  const valSpeed = document.getElementById('val-speed');
  const valExitMoisture = document.getElementById('val-exit-moisture');

  // Telemetry outputs
  const outTownsendMargin = document.getElementById('telemetry-townsend-margin');
  const outTownsendStatus = document.getElementById('telemetry-townsend-status');
  const outBoilingPoint = document.getElementById('telemetry-boiling-point');
  const outBoilingStatus = document.getElementById('telemetry-boiling-status');
  const outEvapRate = document.getElementById('telemetry-evap-rate');
  const outEvapStatus = document.getElementById('telemetry-evap-status');
  const outHotspotTemp = document.getElementById('telemetry-hotspot-temp');
  const outHotspotStatus = document.getElementById('telemetry-hotspot-status');
  const outDepthRatio = document.getElementById('telemetry-depth-ratio');
  const outDepthStatus = document.getElementById('telemetry-depth-status');
  const outReflectedPower = document.getElementById('telemetry-reflected-power');
  const outReflectedStatus = document.getElementById('telemetry-reflected-status');
  const outCirculatorHeat = document.getElementById('telemetry-circulator-heat');
  const outCirculatorStatus = document.getElementById('telemetry-circulator-status');
  const outMagnetronLife = document.getElementById('telemetry-magnetron-life');
  const outMagnetronStatus = document.getElementById('telemetry-magnetron-status');

  const boxSafetyStatus = document.getElementById('box-safety-status');
  const iconSafetyStatus = document.getElementById('icon-safety-status');
  const badgeSafetyVerdict = document.getElementById('badge-safety-verdict');
  const descPrimaryRisk = document.getElementById('desc-primary-risk');
  const descMechanisms = document.getElementById('desc-mechanisms');
  const descMitigation = document.getElementById('desc-mitigation');
  const badgeChamberStatus = document.getElementById('badge-chamber-status');

  // SVG dynamic texts
  const svgValEfield = document.getElementById('svg-val-efield');
  const svgValArcMargin = document.getElementById('svg-val-arc-margin');
  const svgValTsat = document.getElementById('svg-val-tsat');
  const svgValEvap = document.getElementById('svg-val-evap');

  // Presets & copy
  const btnPresetGentle = document.getElementById('btn-preset-gentle');
  const btnPresetCoffee = document.getElementById('btn-preset-coffee');
  const btnPresetScorch = document.getElementById('btn-preset-scorch');
  const btnPresetArc = document.getElementById('btn-preset-arc');
  const btnCopyReport = document.getElementById('btn-copy-report');
  const btnCopyText = document.getElementById('btn-copy-text');

  function calculateVacuumMicrowaveModel() {
    const dryerId = selDryer ? selDryer.value : 'continuous_multi_magnetron_vacuum_belt_dryer';
    const prodId = selProduct ? selProduct.value : 'fruit_berry_extract_concentrate';
    const wgId = selWaveguide ? selWaveguide.value : 'triple_stub_tuner_ferrite_circulator';

    const dryer = modelData.dryerArchitectures.find(d => d.id === dryerId) || modelData.dryerArchitectures[0];
    const prod = modelData.foodProductProfiles.find(p => p.id === prodId) || modelData.foodProductProfiles[0];
    const wg = modelData.microwaveWaveguideConfigurations.find(w => w.id === wgId) || modelData.microwaveWaveguideConfigurations[0];

    const pressureMbar = parseFloat(rngPressure.value);
    const powerKw = parseFloat(rngPower.value);
    const throughputKgH = parseFloat(rngThroughput.value);
    const bedDepthMm = parseFloat(rngBedDepth.value);
    const speedMMin = parseFloat(rngSpeed.value);
    const exitMoisturePct = parseFloat(rngExitMoisture.value);

    // Update slider labels
    valPressure.textContent = `${pressureMbar} mbar (${(pressureMbar * 0.75006).toFixed(1)} Torr)`;
    valPower.textContent = `${powerKw} kW`;
    valThroughput.textContent = `${throughputKgH} kg/h`;
    valBedDepth.textContent = `${bedDepthMm} mm`;
    valSpeed.textContent = `${speedMMin.toFixed(1)} m/min`;
    valExitMoisture.textContent = `${exitMoisturePct.toFixed(1)} %`;

    // 1. Vacuum Moisture Saturation Boiling Temperature (°C)
    // Wagner / Antoine approximation for low-pressure water vapor
    const tSatC = Math.round((100 * Math.pow(pressureMbar / 1013.25, 0.19) - 0.5) * 10) / 10;
    const tSatF = Math.round((tSatC * 1.8 + 32) * 10) / 10;

    // 2. Flash Evaporation Water Removal Rate (kg/h)
    const initialMoist = prod.initialMoisturePercent / 100;
    const targetMoist = exitMoisturePct / 100;
    const dryMassKgH = throughputKgH * (1 - initialMoist);
    const targetTotalMassKgH = dryMassKgH / (1 - targetMoist);
    const evapRateKgH = Math.max(0, Math.round((throughputKgH - targetTotalMassKgH) * 10) / 10);

    // 3. Chamber Resonant Electric Field (V/cm)
    // E_rms = sqrt( (P_mw * Q_loaded) / (2pi * f * eps0 * V_cavity) )
    const cavityVolumeM3 = (dryer.chamberLengthM || 9.5) * ((dryer.beltWidthMm || 800) / 1000) * 0.8;
    const moistLossFactor = (exitMoisturePct > 4) ? prod.lossFactorEpsilonDoublePrime : Math.max(0.4, prod.lossFactorEpsilonDoublePrime * (exitMoisturePct / 4.0));
    const loadingFactor = Math.max(0.2, (throughputKgH / (dryer.nominalThroughputKgHr || 150)) * (moistLossFactor / 18.5));
    const loadedQ = Math.round(180 / loadingFactor);
    const eFieldVPerCm = Math.round(Math.sqrt((powerKw * 1000 * loadedQ) / (2 * Math.PI * 2.45e9 * 8.854e-12 * cavityVolumeM3)) / 100);

    // 4. Townsend Plasma Breakdown Threshold (V/cm)
    // Minimum occurs around 25-45 mbar
    const townsendMinField = (dryer.generatorFrequencyMhz === 915) ? 220 : 285;
    const pressureDelta = Math.abs(pressureMbar - 35);
    const townsendThreshold = Math.round(townsendMinField + Math.pow(pressureDelta, 1.45) * 1.8);
    const townsendMargin = townsendThreshold - eFieldVPerCm;

    // 5. Penetration Depth Dp (mm)
    const epsPrime = prod.dielectricConstantEpsilonPrime || 48.0;
    const epsDoublePrime = moistLossFactor;
    const speedOfLightMmS = 3.0e11;
    const freqHz = (dryer.generatorFrequencyMhz || 2450) * 1.0e6;
    const dpMm = Math.round((speedOfLightMmS / (2 * Math.PI * freqHz * Math.sqrt(2 * epsPrime))) * 
      (1 / Math.sqrt(Math.sqrt(1 + Math.pow(epsDoublePrime / epsPrime, 2)) - 1)) * 10) / 10;
    const depthRatio = Math.round((dpMm / Math.max(bedDepthMm, 1)) * 100) / 100;

    // 6. Product Surface Hotspot Exit Temperature (°C)
    // As moisture drops, sensible heating increases above saturation boiling point
    const residenceTimeSec = ((dryer.chamberLengthM || 9.5) / Math.max(speedMMin / 60, 0.005));
    const moistureShortfallPenalty = (exitMoisturePct < 4.0) ? (4.0 - exitMoisturePct) * 7.5 : 0;
    const powerSurplusFactor = Math.max(0, (powerKw - (evapRateKgH * (prod.latentHeatEvaporationKjKg || 2410) / 3600)));
    const sensibleRiseC = (powerSurplusFactor * 0.45) + moistureShortfallPenalty;
    const surfaceHotspotTempC = Math.round((tSatC + sensibleRiseC) * 10) / 10;

    // 7. Reflected Power & Circulator Dummy Load Heat
    const mismatchFactor = Math.min(0.48, Math.max(0.06, (0.08 + (1 / loadingFactor) * 0.04)));
    const reflectedPowerKw = Math.round(powerKw * mismatchFactor * 10) / 10;
    const reflectedPercent = Math.round((reflectedPowerKw / Math.max(powerKw, 1)) * 100);

    const isolationDb = wg.isolationDb || 26.0;
    const circulatorAbsorbedKw = Math.round(reflectedPowerKw * (1 - Math.pow(10, -isolationDb / 10)) * 10) / 10;

    // 8. Magnetron Cathode Stress & MTBF
    const unabsorbedReflectedKw = reflectedPowerKw - circulatorAbsorbedKw;
    const cathodeStressPct = Math.min(100, Math.round((unabsorbedReflectedKw / Math.max(powerKw * 0.15, 0.5)) * 100));
    const baseMtbfHrs = 8000;
    const estimatedMtbfHrs = Math.max(800, Math.round(baseMtbfHrs * (1 - (cathodeStressPct / 100) * 0.75)));

    // Update Telemetry Outputs
    outTownsendMargin.textContent = `${townsendMargin >= 0 ? '+' : ''}${townsendMargin} V/cm`;
    outBoilingPoint.textContent = `${tSatC} °C (${tSatF} °F)`;
    outEvapRate.textContent = `${evapRateKgH} kg/h`;
    outHotspotTemp.textContent = `${surfaceHotspotTempC} °C (Limit: ${prod.criticalScorchingTempC}°C)`;
    outDepthRatio.textContent = `${depthRatio} (Dp: ${dpMm} mm)`;
    outReflectedPower.textContent = `${reflectedPowerKw} kW (${reflectedPercent} %)`;
    outCirculatorHeat.textContent = `${circulatorAbsorbedKw} kW (Cap: ${dryer.waterLoadCoolingKw} kW)`;
    outMagnetronLife.textContent = `${estimatedMtbfHrs} hrs (Stress: ${cathodeStressPct}%)`;

    // SVG Updates
    svgValEfield.textContent = `${eFieldVPerCm} V/cm`;
    svgValArcMargin.textContent = `${townsendMargin >= 0 ? '+' : ''}${townsendMargin} V/cm (${townsendMargin >= 0 ? 'SAFE' : 'ARC FLASH'})`;
    svgValTsat.textContent = `${tSatC} °C (${tSatF} °F)`;
    svgValEvap.textContent = `${evapRateKgH} kg/h`;

    // Status Assessments & Color Styling
    if (townsendMargin < 0) {
      outTownsendStatus.className = 'text-[10px] px-1.5 py-0.5 rounded font-mono font-bold mt-2 inline-block bg-rose-500/10 text-rose-700';
      outTownsendStatus.textContent = 'PLASMA ARC FLASH CRITICAL';
      svgValArcMargin.setAttribute('fill', '#f43f5e');
    } else if (townsendMargin < 60) {
      outTownsendStatus.className = 'text-[10px] px-1.5 py-0.5 rounded font-mono font-bold mt-2 inline-block bg-amber-500/10 text-amber-700';
      outTownsendStatus.textContent = 'MARGIN NARROW WARN';
      svgValArcMargin.setAttribute('fill', '#f59e0b');
    } else {
      outTownsendStatus.className = 'text-[10px] px-1.5 py-0.5 rounded font-mono font-bold mt-2 inline-block bg-emerald-500/10 text-emerald-700';
      outTownsendStatus.textContent = 'SUB-BREAKDOWN SAFE';
      svgValArcMargin.setAttribute('fill', '#10b981');
    }

    if (surfaceHotspotTempC > prod.criticalScorchingTempC) {
      outHotspotStatus.className = 'text-[10px] px-1.5 py-0.5 rounded font-mono font-bold mt-2 inline-block bg-rose-500/10 text-rose-700';
      outHotspotStatus.textContent = 'CRITICAL PRODUCT SCORCH';
    } else if (surfaceHotspotTempC > prod.criticalScorchingTempC - 6) {
      outHotspotStatus.className = 'text-[10px] px-1.5 py-0.5 rounded font-mono font-bold mt-2 inline-block bg-amber-500/10 text-amber-700';
      outHotspotStatus.textContent = 'APPROACHING SCORCH LIMIT';
    } else {
      outHotspotStatus.className = 'text-[10px] px-1.5 py-0.5 rounded font-mono font-bold mt-2 inline-block bg-emerald-500/10 text-emerald-700';
      outHotspotStatus.textContent = 'COLD INTEGRITY PRESERVED';
    }

    if (depthRatio < 0.8) {
      outDepthStatus.className = 'text-[10px] px-1.5 py-0.5 rounded font-mono font-bold mt-2 inline-block bg-amber-500/10 text-amber-700';
      outDepthStatus.textContent = 'SURFACE CORING WARN';
    } else {
      outDepthStatus.className = 'text-[10px] px-1.5 py-0.5 rounded font-mono font-bold mt-2 inline-block bg-emerald-500/10 text-emerald-700';
      outDepthStatus.textContent = 'UNIFORM ATTENUATION';
    }

    if (reflectedPercent > 28) {
      outReflectedStatus.className = 'text-[10px] px-1.5 py-0.5 rounded font-mono font-bold mt-2 inline-block bg-rose-500/10 text-rose-700';
      outReflectedStatus.textContent = 'HIGH MISMATCH DANGER';
    } else if (reflectedPercent > 18) {
      outReflectedStatus.className = 'text-[10px] px-1.5 py-0.5 rounded font-mono font-bold mt-2 inline-block bg-amber-500/10 text-amber-700';
      outReflectedStatus.textContent = 'ELEVATED REFLECTION';
    } else {
      outReflectedStatus.className = 'text-[10px] px-1.5 py-0.5 rounded font-mono font-bold mt-2 inline-block bg-emerald-500/10 text-emerald-700';
      outReflectedStatus.textContent = 'NORMAL MATCHING';
    }

    if (cathodeStressPct > 45) {
      outMagnetronStatus.className = 'text-[10px] px-1.5 py-0.5 rounded font-mono font-bold mt-2 inline-block bg-rose-500/10 text-rose-700';
      outMagnetronStatus.textContent = 'TUBE OVERHEATING WARN';
    } else {
      outMagnetronStatus.className = 'text-[10px] px-1.5 py-0.5 rounded font-mono font-bold mt-2 inline-block bg-emerald-500/10 text-emerald-700';
      outMagnetronStatus.textContent = 'OPTIMAL TUBE LIFE';
    }

    // Safety Verdict Banner Logic
    if (townsendMargin < 0) {
      boxSafetyStatus.className = 'p-5 rounded-2xl border transition-all bg-rose-500/10 border-rose-500/30 text-rose-900';
      badgeSafetyVerdict.className = 'text-[11px] font-mono px-2 py-0.5 rounded font-bold bg-rose-600 text-white';
      badgeSafetyVerdict.textContent = 'TOWNSEND_PLASMA_ARC_CRITICAL';
      iconSafetyStatus.textContent = '🚨';
      badgeChamberStatus.className = 'text-[10px] font-mono px-2 py-0.5 rounded bg-rose-500/10 text-rose-700 font-semibold';
      badgeChamberStatus.textContent = 'CHAMBER: ARC CROWBAR TRIPPED';
      descPrimaryRisk.textContent = 'Townsend Gas Glow Discharge & Sustained Plasma Flashover Fireball in Rarefied Atmosphere';
      descMechanisms.textContent = `Chamber electric field (${eFieldVPerCm} V/cm) exceeds breakdown threshold (${townsendThreshold} V/cm). Free electrons accelerate across mean free path, creating thermal ionization fireball.`;
      descMitigation.textContent = 'IEC 60519-6 optical sensor tripped &bull; Solid-state crowbar quenching generator (&le;5 ms) &bull; Purge nitrogen';
    } else if (surfaceHotspotTempC > prod.criticalScorchingTempC) {
      boxSafetyStatus.className = 'p-5 rounded-2xl border transition-all bg-amber-500/10 border-amber-500/30 text-amber-900';
      badgeSafetyVerdict.className = 'text-[11px] font-mono px-2 py-0.5 rounded font-bold bg-amber-600 text-white';
      badgeSafetyVerdict.textContent = 'PRODUCT_SCORCHING_DEGRADATION';
      iconSafetyStatus.textContent = '⚠️';
      badgeChamberStatus.className = 'text-[10px] font-mono px-2 py-0.5 rounded bg-amber-500/10 text-amber-700 font-semibold';
      badgeChamberStatus.textContent = 'CHAMBER: OVERHEATING DETECTED';
      descPrimaryRisk.textContent = `Thermal Phytochemical Degradation & Localized Dry-Spot Charring (T_surf: ${surfaceHotspotTempC}°C > Limit: ${prod.criticalScorchingTempC}°C)`;
      descMechanisms.textContent = `Moisture depleted below 4%, collapsing dielectric loss factor. Evaporative cooling absent while microwave dissipation overheats bed core.`;
      descMitigation.textContent = 'Reduce microwave generator power or increase belt speed &bull; Maintain minimum 4% exit moisture buffer';
    } else if (reflectedPercent > 25 && isolationDb < 18) {
      boxSafetyStatus.className = 'p-5 rounded-2xl border transition-all bg-amber-500/10 border-amber-500/30 text-amber-900';
      badgeSafetyVerdict.className = 'text-[11px] font-mono px-2 py-0.5 rounded font-bold bg-amber-600 text-white';
      badgeSafetyVerdict.textContent = 'MAGNETRON_REFLECTED_POWER_WARN';
      iconSafetyStatus.textContent = '⚠️';
      badgeChamberStatus.className = 'text-[10px] font-mono px-2 py-0.5 rounded bg-amber-500/10 text-amber-700 font-semibold';
      badgeChamberStatus.textContent = 'CHAMBER: HIGH REFLECTED WAVE';
      descPrimaryRisk.textContent = 'Excessive Reflected Microwave Energy Return to Magnetron Cathode & Mode Hopping Hazard';
      descMechanisms.textContent = `Circulator isolation (${isolationDb} dB) inadequate to absorb ${reflectedPowerKw} kW reflected power. Tube cathode undergoing thermal expansion.`;
      descMitigation.textContent = 'Service dummy water load chiller &bull; Retune waveguide 3-stub tuner &bull; Inspect ferrite circulator';
    } else {
      boxSafetyStatus.className = 'p-5 rounded-2xl border transition-all bg-emerald-500/10 border-emerald-500/30 text-emerald-900';
      badgeSafetyVerdict.className = 'text-[11px] font-mono px-2 py-0.5 rounded font-bold bg-emerald-600 text-white';
      badgeSafetyVerdict.textContent = 'SAFE_OPTIMAL';
      iconSafetyStatus.textContent = '✅';
      badgeChamberStatus.className = 'text-[10px] font-mono px-2 py-0.5 rounded bg-purple-500/10 text-purple-700 font-semibold';
      badgeChamberStatus.textContent = 'CHAMBER: ONLINE';
      descPrimaryRisk.textContent = 'Sub-Townsend Breakdown Safe & Continuous Low-Temperature Volumetric Flash Evaporation';
      descMechanisms.textContent = `Electric field (${eFieldVPerCm} V/cm) comfortably below breakdown threshold (${townsendThreshold} V/cm). Cold vacuum boiling (${tSatC}°C) protects bioactives.`;
      descMitigation.textContent = 'IEC 60519-6 interlocks active &bull; Optical arc detector online &bull; Closed-loop circulator load verified';
    }
  }

  // Event Listeners for inputs
  [selDryer, selProduct, selWaveguide, rngPressure, rngPower, rngThroughput, rngBedDepth, rngSpeed, rngExitMoisture].forEach(el => {
    if (el) {
      el.addEventListener('input', calculateVacuumMicrowaveModel);
      el.addEventListener('change', calculateVacuumMicrowaveModel);
    }
  });

  // Presets
  if (btnPresetGentle) {
    btnPresetGentle.addEventListener('click', function() {
      if (selDryer) selDryer.value = 'continuous_multi_magnetron_vacuum_belt_dryer';
      if (selProduct) selProduct.value = 'fruit_berry_extract_concentrate';
      if (selWaveguide) selWaveguide.value = 'triple_stub_tuner_ferrite_circulator';
      rngPressure.value = 35;
      rngPower.value = 42;
      rngThroughput.value = 120;
      rngBedDepth.value = 12;
      rngSpeed.value = 1.2;
      rngExitMoisture.value = 4.0;
      calculateVacuumMicrowaveModel();
    });
  }

  if (btnPresetCoffee) {
    btnPresetCoffee.addEventListener('click', function() {
      if (selDryer) selDryer.value = 'modular_low_pressure_vacuum_microwave_tunnel';
      if (selProduct) selProduct.value = 'instant_soluble_coffee_tea_extract';
      if (selWaveguide) selWaveguide.value = 'triple_stub_tuner_ferrite_circulator';
      rngPressure.value = 45;
      rngPower.value = 85;
      rngThroughput.value = 280;
      rngBedDepth.value = 22;
      rngSpeed.value = 1.8;
      rngExitMoisture.value = 3.0;
      calculateVacuumMicrowaveModel();
    });
  }

  if (btnPresetScorch) {
    btnPresetScorch.addEventListener('click', function() {
      if (selDryer) selDryer.value = 'continuous_multi_magnetron_vacuum_belt_dryer';
      if (selProduct) selProduct.value = 'fruit_berry_extract_concentrate';
      if (selWaveguide) selWaveguide.value = 'fixed_iris_water_chilled_circulator';
      rngPressure.value = 40;
      rngPower.value = 68;
      rngThroughput.value = 60;
      rngBedDepth.value = 25;
      rngSpeed.value = 0.8;
      rngExitMoisture.value = 1.5;
      calculateVacuumMicrowaveModel();
    });
  }

  if (btnPresetArc) {
    btnPresetArc.addEventListener('click', function() {
      if (selDryer) selDryer.value = 'aging_degraded_vacuum_dryer_poor_waveguide';
      if (selProduct) selProduct.value = 'botanical_herbal_pharmaceutical_powder';
      if (selWaveguide) selWaveguide.value = 'unshielded_direct_magnetron_feed';
      rngPressure.value = 12;
      rngPower.value = 55;
      rngThroughput.value = 40;
      rngBedDepth.value = 8;
      rngSpeed.value = 1.0;
      rngExitMoisture.value = 2.0;
      calculateVacuumMicrowaveModel();
    });
  }

  // Copy to Clipboard Report
  if (btnCopyReport) {
    btnCopyReport.addEventListener('click', function() {
      const report = `=== ISITKITCHENSAFE VACUUM MICROWAVE DRYER TELEMETRY REPORT ===
Dryer Architecture: ${selDryer ? selDryer.options[selDryer.selectedIndex].text : ''}
Food Feedstock: ${selProduct ? selProduct.options[selProduct.selectedIndex].text : ''}
Waveguide Protection: ${selWaveguide ? selWaveguide.options[selWaveguide.selectedIndex].text : ''}
Chamber Pressure: ${valPressure.textContent}
Microwave Power: ${valPower.textContent}
Throughput: ${valThroughput.textContent}
Bed Thickness: ${valBedDepth.textContent}
Conveyor Speed: ${valSpeed.textContent}
Exit Moisture: ${valExitMoisture.textContent}

DIAGNOSTIC TELEMETRY:
Townsend Arc Margin: ${outTownsendMargin.textContent} (${outTownsendStatus.textContent})
Vacuum Boiling Point: ${outBoilingPoint.textContent}
Evaporation Rate: ${outEvapRate.textContent}
Hotspot Temperature: ${outHotspotTemp.textContent} (${outHotspotStatus.textContent})
Depth Ratio (Dp / t): ${outDepthRatio.textContent}
Reflected Power: ${outReflectedPower.textContent} (${outReflectedStatus.textContent})
Circulator Heat Load: ${outCirculatorHeat.textContent}
Cathode Stress / MTBF: ${outMagnetronLife.textContent}
Safety Verdict: ${badgeSafetyVerdict.textContent}
Regulatory Standards: IEC 60519-6, NFPA 86, OSHA 1910.97, FDA 21 CFR § 110
==============================================================`;

      navigator.clipboard.writeText(report).then(() => {
        const originalText = btnCopyText.textContent;
        btnCopyText.textContent = modelData.copiedFeedback || "Report Copied to Clipboard!";
        setTimeout(() => {
          btnCopyText.textContent = originalText;
        }, 2500);
      });
    });
  }

  // Initial execution
  calculateVacuumMicrowaveModel();
})();
</script>
