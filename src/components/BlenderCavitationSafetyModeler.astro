      <div class="p-4 bg-surface rounded-xl border border-hairline">
        <h4 class="text-xs font-bold uppercase tracking-wider text-purple-600 dark:text-purple-400 mb-1">{c.rule4Title}</h4>
        <p class="text-xs text-body leading-relaxed">{c.rule4Text}</p>
      </div>
      <div class="p-4 bg-surface rounded-xl border border-hairline">
        <h4 class="text-xs font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400 mb-1">{c.rule5Title}</h4>
        <p class="text-xs text-body leading-relaxed">{c.rule5Text}</p>
      </div>
