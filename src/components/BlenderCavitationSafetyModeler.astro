  <!-- Material Engineering Comparison Matrix Table -->
  <div class="mb-12">
    <div class="mb-4">
      <h3 class="text-base font-bold text-ink flex items-center gap-2">
        <span>📊</span> {c.tableTitle}
      </h3>
      <p class="text-xs text-muted mt-1">{c.tableSub}</p>
    </div>

    <div class="overflow-x-auto border border-hairline rounded-2xl">
      <table class="w-full text-left text-xs text-body border-collapse">
        <thead class="bg-surface-soft text-[11px] uppercase tracking-wider text-ink border-b border-hairline">
          <tr>
            <th class="p-3.5 font-bold">{c.colMaterial}</th>
            <th class="p-3.5 font-bold">{c.colThermalShock}</th>
            <th class="p-3.5 font-bold">{c.colCavitation}</th>
            <th class="p-3.5 font-bold">{c.colMicroplastics}</th>
            <th class="p-3.5 font-bold">{c.colShatterRisk}</th>
            <th class="p-3.5 font-bold">{c.colDishwasher}</th>
            <th class="p-3.5 font-bold">{c.colChemicalSafety}</th>
