};

const c = dict[lang] || dict.en;
---

<div id="blender-safety-engine" class="w-full bg-surface border border-hairline rounded-3xl p-6 sm:p-10 shadow-sm transition-all" data-lang={lang}>
  <!-- Header Badge & Title -->
  <div class="mb-8">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold tracking-wider uppercase bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20 mb-3">
      <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
      {c.badge}
    </div>
    <h2 class="text-2xl sm:text-4xl font-extrabold text-ink tracking-tight mb-3">
      {c.title}
    </h2>
    <p class="text-sm sm:text-base text-body leading-relaxed max-w-3xl">
      {c.subtitle}
    </p>
  </div>

  <!-- Quick Scenario Presets -->
  <div class="mb-8 bg-surface-soft border border-hairline rounded-2xl p-4 sm:p-6">
    <div class="text-xs font-bold uppercase tracking-wider text-muted mb-3 flex items-center justify-between">
      <span>{c.presetsTitle}</span>
      <span class="text-[11px] font-normal text-muted lowercase">click to load scenario</span>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2.5">
      <button type="button" class="preset-btn text-left p-3 rounded-xl border border-rose-200 dark:border-rose-900/50 bg-rose-50 dark:bg-rose-950/30 hover:bg-rose-100 dark:hover:bg-rose-900/50 text-rose-950 dark:text-rose-200 text-xs font-medium transition-all shadow-xs" data-preset="hot-soup-bullet">
        {c.presetHotSoupBullet}
      </button>
      <button type="button" class="preset-btn text-left p-3 rounded-xl border border-amber-200 dark:border-amber-900/50 bg-amber-50 dark:bg-amber-950/30 hover:bg-amber-100 dark:hover:bg-amber-900/50 text-amber-950 dark:text-amber-200 text-xs font-medium transition-all shadow-xs" data-preset="vitamix-nut-butter">
        {c.presetVitamixNutButter}
      </button>
      <button type="button" class="preset-btn text-left p-3 rounded-xl border border-orange-200 dark:border-orange-900/50 bg-orange-50 dark:bg-orange-950/30 hover:bg-orange-100 dark:hover:bg-orange-900/50 text-orange-950 dark:text-orange-200 text-xs font-medium transition-all shadow-xs" data-preset="glass-thermal-shock">
        {c.presetGlassThermalShock}
      </button>
      <button type="button" class="preset-btn text-left p-3 rounded-xl border border-purple-200 dark:border-purple-900/50 bg-purple-50 dark:bg-purple-950/30 hover:bg-purple-100 dark:hover:bg-purple-900/50 text-purple-950 dark:text-purple-200 text-xs font-medium transition-all shadow-xs" data-preset="worn-bearing-grease">
        {c.presetWornBearingGrease}
      </button>
      <button type="button" class="preset-btn text-left p-3 rounded-xl border border-emerald-200 dark:border-emerald-900/50 bg-emerald-50 dark:bg-emerald-950/30 hover:bg-emerald-100 dark:hover:bg-emerald-900/50 text-emerald-950 dark:text-emerald-200 text-xs font-medium transition-all shadow-xs lg:col-span-2" data-preset="safe-chef-protocol">
        {c.presetSafeChefProtocol}
      </button>
    </div>
  </div>

  <!-- Interactive Controls Section -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-10">
    <!-- Left Column: Inputs (7 cols) -->
    <div class="lg:col-span-7 space-y-6">
      <div class="border-b border-hairline pb-3">
        <h3 class="text-base font-bold text-ink flex items-center gap-2">
          <span>⚙️</span> {c.controlsTitle}
        </h3>
        <p class="text-xs text-muted mt-1">{c.controlsSub}</p>
      </div>

      <!-- Control 1: Blender Type -->
      <div>
        <label for="blender-type" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5">
          {c.blenderTypeLabel}
        </label>
        <select id="blender-type" class="w-full bg-surface-soft border border-hairline rounded-xl px-3.5 py-2.5 text-xs sm:text-sm font-medium text-ink focus:ring-2 focus:ring-primary focus:outline-hidden">
          {blenderData.blenderCategories.map((item) => (
            <option value={item.id} selected={item.id === 'standard-countertop'}>
              {item.name} ({item.motorPowerWatts}W • {item.maxRpm.toLocaleString()} RPM)
            </option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1">{c.blenderTypeHelp}</p>
      </div>

      <!-- Control 2: Pitcher Material -->
      <div>
        <label for="pitcher-material" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5">
          {c.materialLabel}
        </label>
        <select id="pitcher-material" class="w-full bg-surface-soft border border-hairline rounded-xl px-3.5 py-2.5 text-xs sm:text-sm font-medium text-ink focus:ring-2 focus:ring-primary focus:outline-hidden">
          {blenderData.pitcherMaterials.map((item) => (
            <option value={item.id} selected={item.id === 'soda-lime-glass'}>
              {item.name} (ΔT Limit: {item.thermalShockLimitDegC}°C)
            </option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1">{c.materialHelp}</p>
      </div>

      <!-- Control 3: Lid Configuration -->
      <div>
        <label for="lid-config" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5">
          {c.lidLabel}
        </label>
        <select id="lid-config" class="w-full bg-surface-soft border border-hairline rounded-xl px-3.5 py-2.5 text-xs sm:text-sm font-medium text-ink focus:ring-2 focus:ring-primary focus:outline-hidden">
          {blenderData.vesselLidConfigurations.map((item) => (
            <option value={item.id} selected={item.id === 'vented-2piece-cap'}>
              {item.name}
            </option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1">{c.lidHelp}</p>
      </div>

      <!-- Control 4: Ingredient Viscosity -->
      <div>
        <label for="ingredient-viscosity" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5">
          {c.ingredientLabel}
        </label>
        <select id="ingredient-viscosity" class="w-full bg-surface-soft border border-hairline rounded-xl px-3.5 py-2.5 text-xs sm:text-sm font-medium text-ink focus:ring-2 focus:ring-primary focus:outline-hidden">
          {blenderData.ingredientViscosities.map((item) => (
            <option value={item.id} selected={item.id === 'hot-vegetable-soup'}>
              {item.name} ({item.viscosityCp.toLocaleString()} cP)
            </option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1">{c.ingredientHelp}</p>
      </div>

      <!-- Control 5: Initial Temperature Slider -->
      <div>
        <div class="flex items-center justify-between mb-1.5">
          <label for="temp-slider" class="text-xs font-bold uppercase tracking-wider text-ink">
            {c.tempLabel}
          </label>
          <span id="temp-display" class="font-mono text-xs font-bold text-amber-600 dark:text-amber-400 bg-amber-500/10 px-2 py-0.5 rounded-md">
            75°C (167°F)
          </span>
        </div>
        <input type="range" id="temp-slider" min="5" max="95" step="5" value="75" class="w-full accent-amber-500 cursor-pointer h-2 bg-surface-soft rounded-lg" />
        <div class="flex justify-between text-[10px] text-muted mt-1 font-mono">
          <span>5°C (Cold Milk)</span>
          <span>45°C (Warm)</span>
          <span>95°C (Boiling Broth)</span>
        </div>
        <p class="text-[11px] text-muted mt-1">{c.tempHelp}</p>
      </div>

      <!-- Control 6: Continuous Run Duration Slider -->
      <div>
        <div class="flex items-center justify-between mb-1.5">
          <label for="duration-slider" class="text-xs font-bold uppercase tracking-wider text-ink">
            {c.durationLabel}
          </label>
          <span id="duration-display" class="font-mono text-xs font-bold text-blue-600 dark:text-blue-400 bg-blue-500/10 px-2 py-0.5 rounded-md">
            60s (1.0 min)
          </span>
        </div>
        <input type="range" id="duration-slider" min="10" max="300" step="10" value="60" class="w-full accent-blue-500 cursor-pointer h-2 bg-surface-soft rounded-lg" />
        <div class="flex justify-between text-[10px] text-muted mt-1 font-mono">
          <span>10s (Pulse)</span>
          <span>60s (Standard)</span>
          <span>180s (Puree)</span>
          <span>300s (Friction Soup)</span>
        </div>
        <p class="text-[11px] text-muted mt-1">{c.durationHelp}</p>
      </div>

      <!-- Control 7: Shaft Seal Condition -->
      <div>
        <label for="seal-condition" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5">
          {c.sealLabel}
        </label>
        <select id="seal-condition" class="w-full bg-surface-soft border border-hairline rounded-xl px-3.5 py-2.5 text-xs sm:text-sm font-medium text-ink focus:ring-2 focus:ring-primary focus:outline-hidden">
          {blenderData.shaftSealDegradationStages.map((item) => (
            <option value={item.id} selected={item.id === 'cyclic-thermal-wear'}>
              {item.name}
            </option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1">{c.sealHelp}</p>
      </div>
    </div>

    <!-- Right Column: Live Telemetry & Gauge Output (5 cols) -->
    <div class="lg:col-span-5 flex flex-col justify-between space-y-6">
      <div class="bg-surface-soft border border-hairline rounded-2xl p-6 shadow-xs">
        <div class="flex items-center justify-between border-b border-hairline pb-4 mb-4">
          <div>
            <span class="text-[11px] uppercase tracking-wider text-muted font-bold block">{c.overallScoreLabel}</span>
            <div class="flex items-baseline gap-2 mt-1">
              <span id="overall-score-num" class="text-4xl sm:text-5xl font-black font-mono tracking-tight text-ink">
                68
              </span>
              <span class="text-xs text-muted font-mono">/ 100</span>
            </div>
          </div>
          <div id="overall-score-badge" class="px-3.5 py-1.5 rounded-xl text-xs font-bold uppercase tracking-wider bg-amber-500 text-white">
            CAUTION
          </div>
        </div>

        <!-- Telemetry Metrics Grid -->
        <div class="space-y-4">
          <!-- Metric 1: Temp Rise & Final Temp -->
          <div>
