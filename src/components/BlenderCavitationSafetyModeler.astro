</div>

<script>
  function initBlenderSafetyModeler() {
    const root = document.getElementById('blender-safety-engine');
    if (!root) return;

    // Controls
    const blenderSelect = document.getElementById('blender-type') as HTMLSelectElement;
    const materialSelect = document.getElementById('pitcher-material') as HTMLSelectElement;
    const lidSelect = document.getElementById('lid-config') as HTMLSelectElement;
    const ingredientSelect = document.getElementById('ingredient-viscosity') as HTMLSelectElement;
    const tempSlider = document.getElementById('temp-slider') as HTMLInputElement;
    const tempDisplay = document.getElementById('temp-display');
    const durationSlider = document.getElementById('duration-slider') as HTMLInputElement;
    const durationDisplay = document.getElementById('duration-display');
    const sealSelect = document.getElementById('seal-condition') as HTMLSelectElement;

    // Telemetry Outputs
    const overallScoreNum = document.getElementById('overall-score-num');
    const overallScoreBadge = document.getElementById('overall-score-badge');
    const tempRiseVal = document.getElementById('temp-rise-val');
    const finalTempVal = document.getElementById('final-temp-val');
    const tempBar = document.getElementById('temp-bar');
    const pressureVal = document.getElementById('pressure-val');
    const pressureBar = document.getElementById('pressure-bar');
    const pressureStatusNote = document.getElementById('pressure-status-note');
    const bladeSpeedVal = document.getElementById('blade-speed-val');
    const bladeSpeedBar = document.getElementById('blade-speed-bar');
    const cavitationVal = document.getElementById('cavitation-val');
    const cavitationBar = document.getElementById('cavitation-bar');
    const thermalStressVal = document.getElementById('thermal-stress-val');
    const thermalStressBar = document.getElementById('thermal-stress-bar');
    const sealHazardVal = document.getElementById('seal-hazard-val');
    const sealHazardBar = document.getElementById('seal-hazard-bar');
    const microplasticVal = document.getElementById('microplastic-val');

    // Alert Box
    const alertBox = document.getElementById('blender-alert-box');
    const alertIcon = document.getElementById('alert-icon');
    const alertTitle = document.getElementById('alert-title');
    const alertBody = document.getElementById('alert-body');

    // Copy Button
    const copyBtn = document.getElementById('copy-blender-report-btn');
    const copyBtnText = document.getElementById('copy-btn-text');

    // Presets
    const presetButtons = root.querySelectorAll('.preset-btn');

    // Static Data Lookups
    const BLENDER_PARAMS: Record<string, { watts: number; rpm: number; bladeMps: number; bladeMph: number; heatingRate: number; name: string }> = {
      'commercial-high-power': { watts: 1800, rpm: 28500, bladeMps: 113.4, bladeMph: 253.7, heatingRate: 8.5, name: 'Commercial High-Power (1800W)' },
      'standard-countertop': { watts: 700, rpm: 14000, bladeMps: 51.3, bladeMph: 114.8, heatingRate: 2.2, name: 'Standard Countertop (700W)' },
      'sealed-bullet-personal': { watts: 900, rpm: 21000, bladeMps: 71.5, bladeMph: 159.9, heatingRate: 5.4, name: 'Personal Sealed Bullet (900W)' },
      'immersion-hand-blender': { watts: 400, rpm: 12000, bladeMps: 31.4, bladeMph: 70.3, heatingRate: 0.8, name: 'Immersion Hand Stick (400W)' },
      'food-processor-s-blade': { watts: 850, rpm: 2200, bladeMps: 16.7, bladeMph: 37.4, heatingRate: 1.4, name: 'Food Processor S-Blade (850W)' }
    };

    const MATERIAL_PARAMS: Record<string, { thermalLimit: number; maxTemp: number; microplastics: number; name: string; isGlass: boolean }> = {
      'tritan-copolyester': { thermalLimit: 90, maxTemp: 100, microplastics: 480, name: 'Tritan™ Copolyester (PCTG)', isGlass: false },
      'polycarbonate-vintage': { thermalLimit: 80, maxTemp: 120, microplastics: 720, name: 'Vintage Polycarbonate (BPA)', isGlass: false },
      'soda-lime-glass': { thermalLimit: 42, maxTemp: 110, microplastics: 0, name: 'Soda-Lime Tempered Glass', isGlass: true },
      'borosilicate-glass': { thermalLimit: 150, maxTemp: 300, microplastics: 0, name: 'Borosilicate Laboratory Glass', isGlass: true },
      'stainless-steel-304': { thermalLimit: 350, maxTemp: 450, microplastics: 0, name: '304 Stainless Steel', isGlass: false },
      'styrene-acrylonitrile': { thermalLimit: 45, maxTemp: 75, microplastics: 1450, name: 'SAN Polystyrene Plastic', isGlass: false }
    };

    const VISCOSITY_PARAMS: Record<string, { cp: number; viscosityFactor: number; name: string }> = {
      'water-thin-juice': { cp: 1, viscosityFactor: 0.5, name: 'Water / Thin Juice' },
      'smoothie-yogurt': { cp: 650, viscosityFactor: 1.0, name: 'Fruit & Yogurt Smoothie' },
      'hot-vegetable-soup': { cp: 2400, viscosityFactor: 1.8, name: 'Hot Vegetable Soup' },
      'nut-butter-hummus': { cp: 35000, viscosityFactor: 3.8, name: 'Thick Nut Butter / Hummus' }
    };

    function recalculate() {
      const blender = BLENDER_PARAMS[blenderSelect.value] || BLENDER_PARAMS['standard-countertop'];
      const material = MATERIAL_PARAMS[materialSelect.value] || MATERIAL_PARAMS['soda-lime-glass'];
      const lid = lidSelect.value;
      const viscosity = VISCOSITY_PARAMS[ingredientSelect.value] || VISCOSITY_PARAMS['hot-vegetable-soup'];
      const initialTemp = parseInt(tempSlider.value, 10);
      const durationSec = parseInt(durationSlider.value, 10);
      const sealCondition = sealSelect.value;

      // Update Slider Displays
      const initialTempF = Math.round((initialTemp * 9/5) + 32);
      if (tempDisplay) tempDisplay.textContent = `${initialTemp}°C (${initialTempF}°F)`;

      const durationMin = (durationSec / 60).toFixed(1);
      if (durationDisplay) durationDisplay.textContent = `${durationSec}s (${durationMin} min)`;

      // 1. Friction Temperature Rise Calculation
      // deltaT = (heatingRate * (durationSec / 60) * viscosityFactor)
      const deltaT = Math.round(blender.heatingRate * (durationSec / 60) * viscosity.viscosityFactor * 10) / 10;
      const deltaTF = Math.round(deltaT * 9/5 * 10) / 10;
      const finalTempC = Math.min(100, Math.round((initialTemp + deltaT) * 10) / 10);
      const finalTempF = Math.round((finalTempC * 9/5) + 32);

      if (tempRiseVal) tempRiseVal.textContent = `+${deltaT}°C (+${deltaTF}°F)`;
      if (finalTempVal) finalTempVal.textContent = `${finalTempC}°C (${finalTempF}°F)`;
      if (tempBar) {
        const tempPercent = Math.min(100, Math.max(10, Math.round((finalTempC / 100) * 100)));
        tempBar.style.width = `${tempPercent}%`;
        tempBar.className = finalTempC > 85 ? 'bg-rose-500 h-2 rounded-full' : (finalTempC > 65 ? 'bg-amber-500 h-2 rounded-full' : 'bg-emerald-500 h-2 rounded-full');
      }

      // 2. Internal Gauge Pressure Buildup Calculation
      // If lid is vented or open: pressure is ~0
      // If sealed bullet cup or unvented lid:
      // Air thermal expansion + saturated water vapor pressure rise
      let internalPsi = 0.1;
      let pressureNote = 'Vented / Ambient (0.1 PSI)';
      if (lid === 'sealed-bullet-threaded') {
        // High risk: closed chamber
        const kelvin1 = 293.15; // 20°C ambient
        const kelvin2 = 273.15 + finalTempC;
        const airRatio = (kelvin2 / kelvin1) - 1.0; // thermal expansion fraction
        // Vapor pressure Antoine equation approx
        const vaporPressureKpa = Math.exp(16.3872 - (3885.7 / (finalTempC + 230 - 43.15)));
        const vaporPsi = (vaporPressureKpa / 101.3) * 14.7 * 0.4; // effective vapor accumulation
        internalPsi = Math.round(((airRatio * 14.7) + vaporPsi) * 10) / 10;
        if (internalPsi > 18) internalPsi = 22.5; // rupture cap
        pressureNote = internalPsi > 5.0 ? '🚨 CATASTROPHIC BURST RISK (Thread Rupture)' : '⚠️ High Sealed Pressure Buildup';
      } else if (lid === 'unvented-snap-lid') {
        const airRatio = ((273.15 + finalTempC) / 293.15) - 1.0;
        internalPsi = Math.round((airRatio * 14.7 * 0.7) * 10) / 10;
        pressureNote = internalPsi > 3.0 ? '🚨 Lid Blowoff Hazard' : 'Elevated Air Pressure';
      } else {
        internalPsi = 0.2;
        pressureNote = 'Safe: Steam Escaping via Vented Center Port';
      }

      const internalKpa = Math.round(internalPsi * 6.89476 * 10) / 10;
      if (pressureVal) pressureVal.textContent = `${internalPsi} PSI (${internalKpa} kPa)`;
      if (pressureBar) {
        const pPercent = Math.min(100, Math.max(5, Math.round((internalPsi / 20) * 100)));
        pressureBar.style.width = `${pPercent}%`;
        pressureBar.className = internalPsi > 6 ? 'bg-rose-600 h-2 rounded-full' : (internalPsi > 2 ? 'bg-amber-500 h-2 rounded-full' : 'bg-emerald-500 h-2 rounded-full');
      }
      if (pressureStatusNote) {
        pressureStatusNote.textContent = pressureNote;
        pressureStatusNote.className = internalPsi > 5 ? 'text-[10px] text-rose-600 dark:text-rose-400 font-bold mt-1 block' : 'text-[10px] text-muted mt-1 block';
      }

      // 3. Blade Tip Speed & Tip Mach
      const tipMach = (blender.bladeMps / 343).toFixed(2);
      if (bladeSpeedVal) bladeSpeedVal.textContent = `${blender.bladeMph} mph (${blender.bladeMps} m/s • M${tipMach})`;
      if (bladeSpeedBar) {
        const speedPercent = Math.min(100, Math.round((blender.bladeMph / 260) * 100));
        bladeSpeedBar.style.width = `${speedPercent}%`;
      }

      // 4. Vortex Cavitation Index
      // Cavitation is highest with high RPM and low viscosity
      let cavIndex = Math.round((blender.rpm / 30000) * (3000 / (viscosity.cp + 100)) * 50);
      cavIndex = Math.min(98, Math.max(8, cavIndex));
      let cavLabel = cavIndex > 70 ? 'Extreme Cavitation' : (cavIndex > 40 ? 'Moderate Acoustic Vortex' : 'Damped Cavitation');
      if (cavitationVal) cavitationVal.textContent = `${cavLabel} (Index ${cavIndex})`;
      if (cavitationBar) {
        cavitationBar.style.width = `${cavIndex}%`;
        cavitationBar.className = cavIndex > 70 ? 'bg-indigo-600 h-2 rounded-full' : 'bg-indigo-400 h-2 rounded-full';
      }

      // 5. Pitcher Thermal Shock Margin
      // Delta T between ambient jar (~20°C) and hot food
      const thermalDelta = initialTemp - 20;
      const thermalLimit = material.thermalLimit;
      const isThermalExceeded = thermalDelta > thermalLimit;
      const thermalMargin = thermalLimit - thermalDelta;
      if (thermalStressVal) {
        if (isThermalExceeded) {
          thermalStressVal.textContent = `CRITICAL EXCEEDED (ΔT ${thermalDelta}°C > ${thermalLimit}°C limit)`;
          thermalStressVal.className = 'font-mono font-bold text-rose-600 dark:text-rose-400';
        } else {
          thermalStressVal.textContent = `Safe Margin (+${thermalMargin}°C headroom)`;
          thermalStressVal.className = 'font-mono font-bold text-emerald-600 dark:text-emerald-400';
        }
      }
      if (thermalStressBar) {
        const stressPercent = Math.min(100, Math.max(10, Math.round((thermalDelta / (thermalLimit || 100)) * 100)));
        thermalStressBar.style.width = `${stressPercent}%`;
        thermalStressBar.className = isThermalExceeded ? 'bg-rose-600 h-2 rounded-full' : 'bg-emerald-500 h-2 rounded-full';
      }

      // 6. Bearing Seal Degradation & Grease Migration
      let sealHazardText = 'Zero Leakage (Factory Seal)';
      let sealHazardScore = 10;
      if (sealCondition === 'cyclic-thermal-wear') {
        sealHazardText = 'Moderate Risk (Cyclic Wear • Trace Graphite)';
        sealHazardScore = 45;
      } else if (sealCondition === 'failed-blown-bearing') {
        sealHazardText = 'CRITICAL (Petroleum Sludge Leaching)';
        sealHazardScore = 95;
      }
      if (sealHazardVal) {
        sealHazardVal.textContent = sealHazardText;
        sealHazardVal.className = sealHazardScore > 70 ? 'font-mono font-bold text-rose-600' : (sealHazardScore > 30 ? 'font-mono font-bold text-amber-600' : 'font-mono font-bold text-emerald-600');
      }
      if (sealHazardBar) {
        sealHazardBar.style.width = `${sealHazardScore}%`;
        sealHazardBar.className = sealHazardScore > 70 ? 'bg-rose-600 h-2 rounded-full' : (sealHazardScore > 30 ? 'bg-amber-500 h-2 rounded-full' : 'bg-emerald-500 h-2 rounded-full');
      }

      // 7. Microplastic Shedding
      const microRate = Math.round(material.microplastics * (blender.rpm / 20000));
      if (microplasticVal) {
        if (material.microplastics === 0) {
          microplasticVal.textContent = '0 Part./min (Inert Substrate)';
        } else {
          microplasticVal.textContent = `~${microRate.toLocaleString()} Part./min (${material.name})`;
        }
      }

      // Overall Score Computation (0–100)
      let score = 100;
      if (lid === 'sealed-bullet-threaded' && initialTemp > 50) score -= 55;
      else if (lid === 'unvented-snap-lid' && initialTemp > 60) score -= 30;

      if (isThermalExceeded) score -= 40;
      if (sealCondition === 'failed-blown-bearing') score -= 35;
      else if (sealCondition === 'cyclic-thermal-wear') score -= 12;

      if (materialSelect.value === 'polycarbonate-vintage' && finalTempC > 50) score -= 30;
      if (finalTempC > 90) score -= 15;

      score = Math.max(5, Math.min(99, score));

      if (overallScoreNum) overallScoreNum.textContent = String(score);
      if (overallScoreBadge) {
        if (score >= 80) {
          overallScoreBadge.textContent = 'SAFE & OPTIMAL';
          overallScoreBadge.className = 'px-3.5 py-1.5 rounded-xl text-xs font-bold uppercase tracking-wider bg-emerald-500 text-white';
        } else if (score >= 55) {
          overallScoreBadge.textContent = 'CAUTION';
          overallScoreBadge.className = 'px-3.5 py-1.5 rounded-xl text-xs font-bold uppercase tracking-wider bg-amber-500 text-white';
        } else if (score >= 30) {
          overallScoreBadge.textContent = 'HIGH HAZARD';
          overallScoreBadge.className = 'px-3.5 py-1.5 rounded-xl text-xs font-bold uppercase tracking-wider bg-orange-600 text-white';
        } else {
          overallScoreBadge.textContent = 'EXPLOSION / SCALD ALERT';
          overallScoreBadge.className = 'px-3.5 py-1.5 rounded-xl text-xs font-bold uppercase tracking-wider bg-rose-600 text-white animate-pulse';
        }
      }

      // Alert Box Synthesis
      if (alertBox && alertTitle && alertBody && alertIcon) {
        if (lid === 'sealed-bullet-threaded' && initialTemp >= 50) {
          alertBox.className = 'p-5 sm:p-6 rounded-2xl border mb-10 transition-all bg-rose-50 dark:bg-rose-950/30 border-rose-300 dark:border-rose-800';
          alertIcon.textContent = '🚨';
          alertTitle.textContent = 'CRITICAL HAZARD: SEALED BULLET STEAM EXPLOSION RISK';
          alertTitle.className = 'text-sm font-bold text-rose-900 dark:text-rose-100 uppercase tracking-wider mb-1';
          alertBody.textContent = `Blending ${initialTemp}°C hot liquid in a hermetically sealed threaded cup has spiked internal pressure to ${internalPsi} PSI. NutriBullet/bullet blenders have zero pressure relief vents. When unscrewing or during blending, boiling liquid and steam will violently erupt across hands and face, causing severe second-degree scald burns. NEVER blend liquids above 45°C in personal bullet cups!`;
        } else if (isThermalExceeded && material.isGlass) {
          alertBox.className = 'p-5 sm:p-6 rounded-2xl border mb-10 transition-all bg-rose-50 dark:bg-rose-950/30 border-rose-300 dark:border-rose-800';
          alertIcon.textContent = '💥';
          alertTitle.textContent = 'EXPLOSIVE GLASS SHATTERING ALERT: THERMAL SHOCK LIMIT EXCEEDED';
          alertTitle.className = 'text-sm font-bold text-rose-900 dark:text-rose-100 uppercase tracking-wider mb-1';
          alertBody.textContent = `Pouring ${initialTemp}°C hot liquid into a ~20°C soda-lime glass pitcher creates a temperature differential ΔT of ${thermalDelta}°C. Standard blender glass has a safe thermal shock ceiling of only 42°C (ASTM C149). The tensile differential stress across the inner and outer glass wall exceeds 35 MPa, creating catastrophic instant shattering and projecting glass shards and scalding soup across your kitchen.`;
        } else if (sealCondition === 'failed-blown-bearing') {
          alertBox.className = 'p-5 sm:p-6 rounded-2xl border mb-10 transition-all bg-amber-50 dark:bg-amber-950/30 border-amber-300 dark:border-amber-800';
          alertIcon.textContent = '⚠️';
          alertTitle.textContent = 'TOXIC CONTAMINATION: BLOWN SHAFT BEARING & LUBRICANT SLUDGE';
          alertTitle.className = 'text-sm font-bold text-amber-900 dark:text-amber-100 uppercase tracking-wider mb-1';
          alertBody.textContent = 'The dynamic blade shaft seal has ruptured. Petroleum grease, carbon graphite dust, and metallic bearing wear particles are actively migrating around the drive spindle directly into your ingredients. The blade assembly must be immediately discarded and replaced before further food preparation.';
        } else if (materialSelect.value === 'polycarbonate-vintage' && finalTempC > 50) {
          alertBox.className = 'p-5 sm:p-6 rounded-2xl border mb-10 transition-all bg-amber-50 dark:bg-amber-950/30 border-amber-300 dark:border-amber-800';
          alertIcon.textContent = '☣️';
          alertTitle.textContent = 'ENDOCRINE DISRUPTOR LEACHING: VINTAGE POLYCARBONATE (BPA)';
          alertTitle.className = 'text-sm font-bold text-amber-900 dark:text-amber-100 uppercase tracking-wider mb-1';
          alertBody.textContent = `Operating a legacy polycarbonate jar with hot ingredients (${finalTempC}°C) accelerates hydrolytic depolymerization, releasing Bisphenol A (BPA) and microplastics into the food matrix at 50x ambient rates. Replace the pitcher with food-grade Tritan or 304 Stainless Steel.`;
        } else if (score >= 80) {
          alertBox.className = 'p-5 sm:p-6 rounded-2xl border mb-10 transition-all bg-emerald-50 dark:bg-emerald-950/30 border-emerald-300 dark:border-emerald-800';
          alertIcon.textContent = '✅';
          alertTitle.textContent = 'HYDRODYNAMIC & THERMOMECHANICAL EQUILIBRIUM: SAFE OPERATION';
          alertTitle.className = 'text-sm font-bold text-emerald-900 dark:text-emerald-100 uppercase tracking-wider mb-1';
          alertBody.textContent = `The configured setup operates safely within all thermal and physical thresholds. The vented lid accommodates fluid thermal expansion, the pitcher substrate easily handles the temperature gradient, and blade shaft seals maintain dynamic integrity.`;
        } else {
          alertBox.className = 'p-5 sm:p-6 rounded-2xl border mb-10 transition-all bg-amber-50 dark:bg-amber-950/30 border-amber-300 dark:border-amber-800';
          alertIcon.textContent = '⚠️';
          alertTitle.textContent = 'MODERATE OPERATIONAL CAUTION: ELEVATED FRICTION OR RUN TIME';
          alertTitle.className = 'text-sm font-bold text-amber-900 dark:text-amber-100 uppercase tracking-wider mb-1';
          alertBody.textContent = `Extended continuous run time (${durationSec}s) is elevating viscous blend temperature by +${deltaT}°C. Pulse in 30-second bursts to prevent ingredient scorching and motor stator overheating.`;
        }
      }
    }

    // Attach Listeners
    [blenderSelect, materialSelect, lidSelect, ingredientSelect, tempSlider, durationSlider, sealSelect].forEach(ctrl => {
      if (ctrl) ctrl.addEventListener('input', recalculate);
    });

    // Preset Buttons
    presetButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const p = btn.getAttribute('data-preset');
        if (p === 'hot-soup-bullet') {
          blenderSelect.value = 'sealed-bullet-personal';
          materialSelect.value = 'tritan-copolyester';
          lidSelect.value = 'sealed-bullet-threaded';
          ingredientSelect.value = 'hot-vegetable-soup';
          tempSlider.value = '85';
          durationSlider.value = '90';
          sealSelect.value = 'cyclic-thermal-wear';
        } else if (p === 'vitamix-nut-butter') {
          blenderSelect.value = 'commercial-high-power';
          materialSelect.value = 'tritan-copolyester';
          lidSelect.value = 'vented-2piece-cap';
          ingredientSelect.value = 'nut-butter-hummus';
          tempSlider.value = '25';
          durationSlider.value = '180';
          sealSelect.value = 'pristine-factory';
        } else if (p === 'glass-thermal-shock') {
          blenderSelect.value = 'standard-countertop';
          materialSelect.value = 'soda-lime-glass';
          lidSelect.value = 'vented-2piece-cap';
          ingredientSelect.value = 'hot-vegetable-soup';
          tempSlider.value = '90';
          durationSlider.value = '40';
          sealSelect.value = 'pristine-factory';
        } else if (p === 'worn-bearing-grease') {
          blenderSelect.value = 'standard-countertop';
          materialSelect.value = 'soda-lime-glass';
          lidSelect.value = 'vented-2piece-cap';
          ingredientSelect.value = 'smoothie-yogurt';
          tempSlider.value = '15';
          durationSlider.value = '60';
          sealSelect.value = 'failed-blown-bearing';
        } else if (p === 'safe-chef-protocol') {
          blenderSelect.value = 'standard-countertop';
          materialSelect.value = 'borosilicate-glass';
          lidSelect.value = 'vented-2piece-cap';
          ingredientSelect.value = 'hot-vegetable-soup';
          tempSlider.value = '60';
          durationSlider.value = '45';
          sealSelect.value = 'pristine-factory';
        }
        recalculate();
      });
    });

    // Copy Safety Report
    if (copyBtn && copyBtnText) {
      copyBtn.addEventListener('click', () => {
        const score = overallScoreNum ? overallScoreNum.textContent : '68';
        const finalT = finalTempVal ? finalTempVal.textContent : '82°C';
        const pressure = pressureVal ? pressureVal.textContent : '0.2 PSI';
        const speed = bladeSpeedVal ? bladeSpeedVal.textContent : '114 mph';
        const alertMsg = alertBody ? alertBody.textContent : '';

        const report = `=== IsItKitchenSafe Blender Blade Cavitation & Thermal Safety Report ===
Overall Operational Score: ${score}/100
Blender Type: ${blenderSelect.selectedOptions[0]?.text || ''}
Pitcher Material: ${materialSelect.selectedOptions[0]?.text || ''}
Lid Configuration: ${lidSelect.selectedOptions[0]?.text || ''}
Initial Temp: ${tempSlider.value}°C -> Final Temp: ${finalT}
Internal Vessel Pressure: ${pressure}
Blade Tip Velocity: ${speed}
Assessment: ${alertMsg}
Generated via https://isitkitchensafe.com/tools/blender-blade-cavitation-safety-modeler/`;

        navigator.clipboard.writeText(report).then(() => {
          const original = copyBtnText.textContent;
          copyBtnText.textContent = 'Report Copied to Clipboard!';
          setTimeout(() => {
            copyBtnText.textContent = original;
          }, 2500);
        });
      });
    }

    // Initial calculation
    recalculate();
  }

  // Run on page load and on Astro view transitions
  initBlenderSafetyModeler();
  document.addEventListener('astro:page-load', initBlenderSafetyModeler);
</script>
