  <!-- Cross-Links to Related Tools -->
  <div class="pt-6 border-t border-hairline">
    <div class="text-xs font-bold uppercase tracking-wider text-muted mb-3">
      {c.crossLinkTitle}
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      <a href={lang === 'en' ? '/tools/pressure-cooker-instant-pot-safety-simulator/' : `/${lang}/tools/pressure-cooker-instant-pot-safety-simulator/`} class="p-3.5 rounded-xl border border-hairline bg-surface hover:bg-surface-soft transition-colors flex items-center justify-between text-xs font-medium text-ink group">
        <span>{c.crossLinkPressureCooker}</span>
        <span class="text-muted group-hover:translate-x-0.5 transition-transform">&rarr;</span>
      </a>
      <a href={lang === 'en' ? '/tools/cutting-board-microplastic-pathogen-analyzer/' : `/${lang}/tools/cutting-board-microplastic-pathogen-analyzer/`} class="p-3.5 rounded-xl border border-hairline bg-surface hover:bg-surface-soft transition-colors flex items-center justify-between text-xs font-medium text-ink group">
        <span>{c.crossLinkCuttingBoard}</span>
        <span class="text-muted group-hover:translate-x-0.5 transition-transform">&rarr;</span>
      </a>
      <a href={lang === 'en' ? '/tools/thermal-shock-simulator/' : `/${lang}/tools/thermal-shock-simulator/`} class="p-3.5 rounded-xl border border-hairline bg-surface hover:bg-surface-soft transition-colors flex items-center justify-between text-xs font-medium text-ink group">
        <span>{c.crossLinkThermalShock}</span>
        <span class="text-muted group-hover:translate-x-0.5 transition-transform">&rarr;</span>
      </a>
