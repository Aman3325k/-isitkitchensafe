            </div>
            <div class="flex justify-between text-xs mb-1.5">
              <span class="text-muted font-medium">{c.finalTempLabel}</span>
              <span id="final-temp-val" class="font-mono font-bold text-amber-600 dark:text-amber-400">82.8°C (181.0°F)</span>
            </div>
            <div class="w-full bg-hairline/50 rounded-full h-2 overflow-hidden">
              <div id="temp-bar" class="bg-amber-500 h-2 rounded-full transition-all duration-300" style="width: 70%"></div>
