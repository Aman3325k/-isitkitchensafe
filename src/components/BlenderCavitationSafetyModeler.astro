    <div class="space-y-4">
      <div class="p-4 bg-surface rounded-xl border border-hairline">
        <h4 class="text-xs font-bold uppercase tracking-wider text-rose-600 dark:text-rose-400 mb-1">{c.rule1Title}</h4>
        <p class="text-xs text-body leading-relaxed">{c.rule1Text}</p>
      </div>
      <div class="p-4 bg-surface rounded-xl border border-hairline">
        <h4 class="text-xs font-bold uppercase tracking-wider text-amber-600 dark:text-amber-400 mb-1">{c.rule2Title}</h4>
        <p class="text-xs text-body leading-relaxed">{c.rule2Text}</p>
      </div>
      <div class="p-4 bg-surface rounded-xl border border-hairline">
