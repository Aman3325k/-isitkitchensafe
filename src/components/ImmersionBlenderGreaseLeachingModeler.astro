<!-- Interactive Client-Side Script -->
<script is:inline define:vars={{ blenderData }}>
  (function initBlenderModeler() {
    const archSelect = document.getElementById('blender-arch');
    const tempSlider = document.getElementById('blender-temp');
    const tempDisplay = document.getElementById('temp-display-val');
    const viscSelect = document.getElementById('blender-viscosity');
    const speedSelect = document.getElementById('blender-speed');
    const durationSelect = document.getElementById('blender-duration');
    const matrixSelect = document.getElementById('blender-matrix');
    const presetSelect = document.getElementById('blender-preset-select');

    const badgeVerdict = document.getElementById('badge-verdict');
    const valLeaching = document.getElementById('val-leaching-ppm');
    const barLeaching = document.getElementById('bar-leaching');
    const valSealStress = document.getElementById('val-seal-stress');
    const barSealStress = document.getElementById('bar-seal-stress');
    const valCavitation = document.getElementById('val-cavitation');
    const barCavitation = document.getElementById('bar-cavitation');
    const textCompliance = document.getElementById('text-compliance-status');
    const textMechanism = document.getElementById('text-mechanism-desc');
    const textGuidance = document.getElementById('text-guidance-desc');
    const btnCopy = document.getElementById('btn-copy-telemetry');
    const copyFeedback = document.getElementById('copy-feedback-msg');

    if (!archSelect || !tempSlider) return;

    function recalculate() {
      const archId = archSelect.value;
      const tempC = parseInt(tempSlider.value, 10);
      const viscId = viscSelect.value;
      const speedId = speedSelect.value;
      const durId = durationSelect.value;
      const matrixId = matrixSelect.value;

      const arch = blenderData.shaftSealArchitectures.find(a => a.id === archId) || blenderData.shaftSealArchitectures[0];
      const visc = blenderData.blendingViscosities.find(v => v.id === viscId) || blenderData.blendingViscosities[1];
      const speed = blenderData.rotorSpeeds.find(s => s.id === speedId) || blenderData.rotorSpeeds[1];
      const dur = blenderData.blendingDurations.find(d => d.id === durId) || blenderData.blendingDurations[1];
      const matrix = blenderData.foodMatrices.find(m => m.id === matrixId) || blenderData.foodMatrices[0];

      // Update temperature display label
      const tempF = Math.round((tempC * 9/5) + 32);
      let tempLabelDesc = 'Cold';
      if (tempC >= 95) tempLabelDesc = 'Rolling Boil';
      else if (tempC >= 85) tempLabelDesc = 'Simmering Stovetop Pot';
      else if (tempC >= 70) tempLabelDesc = 'Steaming Vegetable Soup';
      else if (tempC >= 45) tempLabelDesc = 'Warm Purée / Sauce';
      tempDisplay.textContent = `${tempC}°C (${tempF}°F) - ${tempLabelDesc}`;

      // Physics Calculation
      // 1. Thermal Arrhenius Acceleration
      // Activation energy for petroleum grease viscosity thinning & NBR relaxation
      const T_kelvin = tempC + 273.15;
      const thermalArrheniusFactor = Math.exp((tempC - 20) / 22.0); // Doubling every ~15°C

      // 2. Seal Thermal Stress & Creep Index
      const deltaT = Math.max(0, tempC - arch.thermalDegradationThresholdC);
      let sealStressRaw = (tempC / arch.sealTempCeilingC) * 60 + (deltaT * 2.2);
      if (matrixId === 'matrix_acidic_tomato' && arch.id.includes('nbr')) {
        sealStressRaw += 18; // Acid swelling penalty
      }
      const sealStressPercent = Math.min(100, Math.round(sealStressRaw));

      // 3. Cavitation & Shear Index
      const shearFactor = (speed.rpm / 12000) * (visc.hydrodynamicDragFactor * 0.7);
      const cavitationRaw = Math.min(100, Math.round((speed.centrifugalShearIndex * 22) + (visc.frictionalShearHeatWatts * 0.28) + (tempC > 85 ? 15 : 0)));

      // 4. Grease Leaching / Migration Calculation into 1kg of food (mg/kg / ppm)
      // Incidental food contact ceiling is 10 ppm (mg/kg) under FDA 21 CFR § 178.3570
      let baselineLeachingRate = 0.5; // mg/kg baseline weeping
      if (arch.id === 'commercial_hermetic_carbide') {
        baselineLeachingRate = 0.05; // Hermetic seal prevents weeping
      } else if (arch.id === 'aged_hardened_domestic') {
        baselineLeachingRate = 8.5; // Significant seal gap
      } else if (arch.id === 'budget_sleeve_nbr') {
        baselineLeachingRate = 2.8;
      } else if (arch.id === 'midrange_ptfe_nsfh1') {
        baselineLeachingRate = 0.8;
      }

      // Multiply by duration, thermal thinning, speed centrifugal shear, and lipid solvent extraction
      let leachingPpm = baselineLeachingRate * (dur.cumulativeStressFactor * 0.8) * (thermalArrheniusFactor * 0.6) * speed.centrifugalShearIndex * (matrix.lipophilicExtractionMultiplier * 0.75) / arch.hydrodynamicSealIntegrityFactor;

      if (arch.id === 'commercial_hermetic_carbide') {
        leachingPpm = Math.min(0.2, leachingPpm); // Capped by physical barrier
      }

      leachingPpm = Math.round(leachingPpm * 10) / 10;
      if (leachingPpm < 0.1) leachingPpm = 0.1;

      // Update UI Telemetry
      const fdaLimit = 10.0;
      const isExceeded = leachingPpm > fdaLimit;
      const isCertifiedFoodGrade = arch.isNsfH1Certified;

      // Leaching bar & value
      const leachingBarWidth = Math.min(100, Math.round((leachingPpm / 50) * 100));
      barLeaching.style.width = `${leachingBarWidth}%`;

      if (leachingPpm <= fdaLimit && isCertifiedFoodGrade) {
        valLeaching.textContent = `${leachingPpm} mg/kg (Safe • Within FDA 10 ppm Limit)`;
        valLeaching.className = "text-xs font-mono font-bold text-emerald-600 dark:text-emerald-400";
        barLeaching.className = "bg-emerald-600 h-2.5 rounded-full transition-all duration-300";
      } else if (leachingPpm <= fdaLimit && !isCertifiedFoodGrade) {
        valLeaching.textContent = `${leachingPpm} mg/kg (Industrial Petroleum • Prohibited)`;
        valLeaching.className = "text-xs font-mono font-bold text-amber-600 dark:text-amber-400";
        barLeaching.className = "bg-amber-500 h-2.5 rounded-full transition-all duration-300";
      } else {
        const ratio = (leachingPpm / fdaLimit).toFixed(1);
        valLeaching.textContent = `${leachingPpm} mg/kg (${ratio}x FDA Safe Ceiling)`;
        valLeaching.className = "text-xs font-mono font-bold text-rose-600 dark:text-rose-400";
        barLeaching.className = "bg-rose-600 h-2.5 rounded-full transition-all duration-300";
      }

      // Seal Stress Bar
      barSealStress.style.width = `${sealStressPercent}%`;
      if (sealStressPercent >= 80) {
        valSealStress.textContent = `${sealStressPercent}% (Critical Softening & Creep)`;
        valSealStress.className = "text-xs font-mono font-bold text-rose-600 dark:text-rose-400";
        barSealStress.className = "bg-rose-600 h-2.5 rounded-full transition-all duration-300";
      } else if (sealStressPercent >= 50) {
        valSealStress.textContent = `${sealStressPercent}% (Elevated Thermal Load)`;
        valSealStress.className = "text-xs font-mono font-bold text-amber-600 dark:text-amber-400";
        barSealStress.className = "bg-amber-500 h-2.5 rounded-full transition-all duration-300";
      } else {
        valSealStress.textContent = `${sealStressPercent}% (Normal Elastic Operating Envelope)`;
        valSealStress.className = "text-xs font-mono font-bold text-emerald-600 dark:text-emerald-400";
        barSealStress.className = "bg-emerald-600 h-2.5 rounded-full transition-all duration-300";
      }

      // Cavitation Bar
      barCavitation.style.width = `${cavitationRaw}%`;
      if (cavitationRaw >= 70) {
        valCavitation.textContent = `${cavitationRaw} / 100 (Micro-Jet Cavitation Active)`;
        valCavitation.className = "text-xs font-mono font-bold text-rose-600 dark:text-rose-400";
        barCavitation.className = "bg-rose-600 h-2.5 rounded-full transition-all duration-300";
      } else if (cavitationRaw >= 40) {
        valCavitation.textContent = `${cavitationRaw} / 100 (Moderate Vortex Hydrodynamic Shear)`;
        valCavitation.className = "text-xs font-mono font-bold text-amber-600 dark:text-amber-400";
        barCavitation.className = "bg-amber-500 h-2.5 rounded-full transition-all duration-300";
      } else {
        valCavitation.textContent = `${cavitationRaw} / 100 (Laminar Smooth Flow)`;
        valCavitation.className = "text-xs font-mono font-bold text-emerald-600 dark:text-emerald-400";
        barCavitation.className = "bg-emerald-600 h-2.5 rounded-full transition-all duration-300";
      }

      // Verdict Badge
      if (!isCertifiedFoodGrade || isExceeded) {
        badgeVerdict.textContent = "PROHIBITED / HAZARD";
        badgeVerdict.className = "px-2.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-rose-500/10 text-rose-700 dark:text-rose-400 border border-rose-500/20";
        textCompliance.textContent = `FDA 21 CFR § 178.3570: NON-COMPLIANT • Prohibited toxic mineral hydrocarbon migration into culinary food matrix (${leachingPpm} mg/kg vs 10 mg/kg limit).`;
      } else if (sealStressPercent >= 80) {
        badgeVerdict.textContent = "THERMAL STRESS WARNING";
        badgeVerdict.className = "px-2.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20";
        textCompliance.textContent = `FDA 21 CFR § 178.3570: COMPLIANT • Food-grade H1 lubricant within limit (${leachingPpm} mg/kg), but high thermal stress risks seal failure.`;
      } else {
        badgeVerdict.textContent = "CERTIFIED FOOD CONTACT SAFE";
        badgeVerdict.className = "px-2.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20";
        textCompliance.textContent = `FDA 21 CFR § 178.3570 & NSF/ANSI Standard 8: FULLY COMPLIANT • Zero hazardous petroleum hydrocarbon or heavy metal migration.`;
      }

      // Update Mechanism Text
      let mechText = `At ${tempC}°C in a ${matrix.name.toLowerCase()} matrix, the ${arch.sealMaterial} seal operates under ${dur.thermalSoakState.toLowerCase()}. `;
      if (tempC > arch.sealTempCeilingC) {
        mechText += `The water temperature exceeds the seal material's thermal ceiling (${arch.sealTempCeilingC}°C), triggering elastomer relaxation, loss of seal interference fit, and rapid viscosity collapse in the bearing grease. `;
      } else {
        mechText += `The seal remains below its maximum thermal threshold (${arch.sealTempCeilingC}°C), maintaining mechanical radial tension against the rotating shaft. `;
      }
      if (speed.rpm >= 16000) {
        mechText += `At ${speed.rpm.toLocaleString()} RPM, centrifugal forces generate negative suction behind the blade bell, drawing thinned grease along the shaft into the vortex. `;
      }
      if (matrixId === 'matrix_fatty_cream') {
        mechText += `Dietary butter and cream lipids act as non-polar solvents, accelerating lipophilic lubricant extraction by ${matrix.lipophilicExtractionMultiplier}x compared to aqueous broths.`;
      }
      textMechanism.textContent = mechText;

      // Update Guidance Text
      if (!isCertifiedFoodGrade || isExceeded) {
        textGuidance.textContent = `DO NOT use this blender in boiling soups. Remove the stockpot from the heat and allow the soup to cool below 70°C (158°F) before puréeing, or upgrade to a commercial NSF-certified hand blender equipped with a spring-loaded PTFE or double mechanical silicon carbide seal and NSF H1 food-grade grease.`;
      } else if (sealStressPercent >= 75) {
        textGuidance.textContent = `Limit continuous immersion to short 30-to-60 second pulses. Allow the shaft housing to cool between cycles to prevent grease liquification and seal hardening.`;
      } else {
        textGuidance.textContent = `Optimal operating parameters. Follow standard culinary hygiene: rinse the detachable blending wand immediately after use in warm soapy water and never submerge the motorized handle or place non-detachable units in the dishwasher.`;
      }
    }

    // Preset handler
    presetSelect.addEventListener('change', function () {
      const val = presetSelect.value;
      if (val === 'custom') return;
      const preset = blenderData.presets.find(p => p.id === val);
      if (preset) {
        archSelect.value = preset.architectureId;
        const tempObj = blenderData.operatingTemperatures.find(t => t.id === preset.tempId);
        if (tempObj) tempSlider.value = tempObj.celsius;
        viscSelect.value = preset.viscosityId;
        speedSelect.value = preset.speedId;
        durationSelect.value = preset.durationId;
        matrixSelect.value = preset.matrixId;
        recalculate();
      }
    });

    // Control event listeners
    [archSelect, viscSelect, speedSelect, durationSelect, matrixSelect].forEach(el => {
      el.addEventListener('change', () => {
        presetSelect.value = 'custom';
        recalculate();
      });
    });

    tempSlider.addEventListener('input', () => {
      presetSelect.value = 'custom';
      recalculate();
    });

    // Copy Telemetry Report to Clipboard
    btnCopy.addEventListener('click', function () {
      const arch = blenderData.shaftSealArchitectures.find(a => a.id === archSelect.value);
      const reportText = `[IsItKitchenSafe Diagnostic Telemetry - Immersion Blender Grease Leaching Modeler]
Timestamp: ${new Date().toISOString()}
Architecture: ${arch ? arch.name : archSelect.value}
Temperature: ${tempSlider.value}°C (${Math.round((tempSlider.value * 9/5) + 32)}°F)
Viscosity: ${viscSelect.value}
Rotor Speed: ${speedSelect.value}
Continuous Duration: ${durationSelect.value}
Food Matrix: ${matrixSelect.value}
Verdict: ${badgeVerdict.textContent.trim()}
Lubricant Migration: ${valLeaching.textContent.trim()}
Seal Thermal Stress: ${valSealStress.textContent.trim()}
Cavitation Index: ${valCavitation.textContent.trim()}
Compliance: ${textCompliance.textContent.trim()}
Guidance: ${textGuidance.textContent.trim()}
Verification: https://isitkitchensafe.com/tools/immersion-blender-grease-leaching-modeler/`;

      navigator.clipboard.writeText(reportText).then(() => {
        copyFeedback.classList.remove('hidden');
        setTimeout(() => copyFeedback.classList.add('hidden'), 3500);
      }).catch(err => {
        console.error('Failed to copy to clipboard', err);
      });
    });

    // Initial calculation
    recalculate();
  })();
</script>
