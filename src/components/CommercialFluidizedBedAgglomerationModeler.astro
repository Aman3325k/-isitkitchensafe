      </div>
      <div class="rounded-lg bg-slate-900/60 p-4 border border-slate-800">
        <h4 class="font-bold text-amber-400 mb-1 flex items-center gap-1.5">
          <span class="inline-block h-2 w-2 rounded-full bg-amber-400"></span>
          {t.rule3Title}
        </h4>
        <p class="text-slate-400 leading-relaxed">{t.rule3Text}</p>
      </div>
      <div class="rounded-lg bg-slate-900/60 p-4 border border-slate-800">
        <h4 class="font-bold text-amber-400 mb-1 flex items-center gap-1.5">
          <span class="inline-block h-2 w-2 rounded-full bg-amber-400"></span>
          {t.rule4Title}
        </h4>
        <p class="text-slate-400 leading-relaxed">{t.rule4Text}</p>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ agglomerationData }}>
(function() {
  const data = agglomerationData;

  // DOM Elements
  const selectEquipment = document.getElementById('selectEquipment');
  const selectPowder = document.getElementById('selectPowder');
  const selectBinder = document.getElementById('selectBinder');

  const inputAirTemp = document.getElementById('inputAirTemp');
  const inputVelocity = document.getElementById('inputVelocity');
  const inputAtomPress = document.getElementById('inputAtomPress');
  const inputSprayRate = document.getElementById('inputSprayRate');
  const inputGrounding = document.getElementById('inputGrounding');
  const inputO2 = document.getElementById('inputO2');

  const valAirTemp = document.getElementById('valAirTemp');
  const valVelocity = document.getElementById('valVelocity');
  const valAtomPress = document.getElementById('valAtomPress');
  const valSprayRate = document.getElementById('valSprayRate');
  const valGrounding = document.getElementById('valGrounding');
  const valO2 = document.getElementById('valO2');

  const readoutPotential = document.getElementById('readoutPotential');
  const readoutSparkEnergy = document.getElementById('readoutSparkEnergy');
  const readoutLoc = document.getElementById('readoutLoc');

  const cardD32Val = document.getElementById('cardD32Val');
  const barD32 = document.getElementById('barD32');
  const cardD32Status = document.getElementById('cardD32Status');

  const cardMoistureVal = document.getElementById('cardMoistureVal');
  const barMoisture = document.getElementById('barMoisture');
  const cardMoistureStatus = document.getElementById('cardMoistureStatus');

  const cardDissolutionVal = document.getElementById('cardDissolutionVal');
  const barDissolution = document.getElementById('barDissolution');
  const cardDissolutionStatus = document.getElementById('cardDissolutionStatus');

  const cardPredVal = document.getElementById('cardPredVal');
  const barPred = document.getElementById('barPred');
  const cardPredStatus = document.getElementById('cardPredStatus');

  const cardMieVal = document.getElementById('cardMieVal');
  const barMie = document.getElementById('barMie');
  const cardMieStatus = document.getElementById('cardMieStatus');

  const statusBanner = document.getElementById('statusBanner');
  const statusIconContainer = document.getElementById('statusIconContainer');
  const statusTitle = document.getElementById('statusTitle');
  const statusTag = document.getElementById('statusTag');
  const readoutPrimaryRisk = document.getElementById('readoutPrimaryRisk');
  const readoutMechanisms = document.getElementById('readoutMechanisms');
  const readoutMitigation = document.getElementById('readoutMitigation');

  const btnPresetInfantFormula = document.getElementById('btnPresetInfantFormula');
  const btnPresetHighThroughput = document.getElementById('btnPresetHighThroughput');
  const btnPresetCompromisedTower = document.getElementById('btnPresetCompromisedTower');
  const btnPresetDelicateCocoa = document.getElementById('btnPresetDelicateCocoa');

  const btnCopyReport = document.getElementById('btnCopyReport');
  const copyBtnText = document.getElementById('copyBtnText');

  function calculateTelemetry() {
    const equip = data.equipmentArchitectures.find(e => e.id === selectEquipment.value) || data.equipmentArchitectures[0];
    const powder = data.foodPowderSubstrates.find(p => p.id === selectPowder.value) || data.foodPowderSubstrates[0];
    const binder = data.atomizingBinderSolutions.find(b => b.id === selectBinder.value) || data.atomizingBinderSolutions[0];

    const airTemp = parseFloat(inputAirTemp.value);
    const velocity = parseFloat(inputVelocity.value);
    const atomPress = parseFloat(inputAtomPress.value);
    const sprayRate = parseFloat(inputSprayRate.value);
    const grounding = parseFloat(inputGrounding.value);
    const o2 = parseFloat(inputO2.value);

    // Update Slider Value Readouts
    valAirTemp.textContent = `${airTemp}°C (${Math.round(airTemp * 1.8 + 32)}°F)`;
    valVelocity.textContent = `${velocity.toFixed(2)} m/s`;
    valAtomPress.textContent = `${atomPress.toFixed(1)} bar`;
    valSprayRate.textContent = `${sprayRate} L/h`;
    valGrounding.textContent = `${grounding} Ω ${grounding <= 10 ? '(Bonded)' : '(High Resistance)'}`;
    valO2.textContent = `${o2.toFixed(1)}% ${o2 <= 10 ? '(Nitrogen Blanket)' : '(Ambient Air)'}`;

    // 1. Sauter Mean Droplet Diameter D32 (µm)
    // D32 is proportional to (surfaceTension / atomPress^0.6) * (viscosity^0.15) * (sprayRate^0.25)
    const baseD32 = (binder.surfaceTensionDyneCm / Math.pow(atomPress, 0.65)) * Math.pow(binder.viscosityCp, 0.16) * Math.pow(sprayRate / 35, 0.28) * 0.95;
    const D32 = Math.max(12, Math.min(85, baseD32));
    cardD32Val.textContent = D32.toFixed(1);
    barD32.style.width = `${Math.min(100, (D32 / 70) * 100)}%`;

    if (D32 < 20) {
      cardD32Status.textContent = 'Too Fine (<20µm) — Premature Fines Evaporation';
      cardD32Status.className = 'mt-1.5 block text-[10px] font-medium text-amber-400';
    } else if (D32 <= 45) {
      cardD32Status.textContent = 'Optimal Agglomeration Range (20–45 µm)';
      cardD32Status.className = 'mt-1.5 block text-[10px] font-medium text-emerald-400';
    } else {
      cardD32Status.textContent = 'Coarse Mist (>45µm) — High Bed Overwetting Risk';
      cardD32Status.className = 'mt-1.5 block text-[10px] font-medium text-rose-400';
    }

    // 2. Bed Moisture & Defluidization Risk Index (%)
    // Rate of moisture input vs drying rate (governed by airTemp, velocity, bowl volume)
    const evapCapacity = (airTemp - 40) * velocity * (equip.airflowM3H / 1000) * 0.42;
    const moistureLoad = (sprayRate * (100 - binder.solidsPercent) / 100) / Math.max(1, evapCapacity);
    const defluidRisk = Math.min(100, Math.max(5, moistureLoad * 22));
    cardMoistureVal.textContent = `${Math.round(defluidRisk)}%`;
    barMoisture.style.width = `${defluidRisk}%`;

    if (defluidRisk < 35) {
      cardMoistureStatus.textContent = 'Stable Aerated Fluid Bed';
      cardMoistureStatus.className = 'mt-1.5 block text-[10px] font-medium text-emerald-400';
      barMoisture.className = 'h-full bg-emerald-400 transition-all duration-300';
    } else if (defluidRisk < 70) {
      cardMoistureStatus.textContent = 'Elevated Moisture — Borderline Capillary Bridging';
      cardMoistureStatus.className = 'mt-1.5 block text-[10px] font-medium text-amber-400';
      barMoisture.className = 'h-full bg-amber-400 transition-all duration-300';
    } else {
      cardMoistureStatus.textContent = 'CRITICAL DEFUIDIZATION — Wet Quenching Imminent';
      cardMoistureStatus.className = 'mt-1.5 block text-[10px] font-medium text-rose-400';
      barMoisture.className = 'h-full bg-rose-500 transition-all duration-300';
    }

    // 3. Cold-Water Instant Dissolution Speed (seconds)
    // Faster with optimal D32 (30-40µm), lecithin binders, lower sticky point fouling
    const baseSink = powder.coldWaterSinkabilitySeconds;
    const agglomerationFactor = (D32 >= 22 && D32 <= 48) ? 0.12 : (D32 < 22 ? 0.35 : 0.25);
    const binderFactor = binder.id === 'soy_sunflower_lecithin_emulsion' ? 0.65 : (binder.id === 'aqueous_maltodextrin_solution' ? 0.85 : 1.1);
    const sinkSeconds = Math.max(5, Math.min(240, baseSink * agglomerationFactor * binderFactor));
    cardDissolutionVal.textContent = sinkSeconds.toFixed(1);
    barDissolution.style.width = `${Math.max(10, 100 - (sinkSeconds / 180) * 100)}%`;

    if (sinkSeconds < 18) {
      cardDissolutionStatus.textContent = 'Instant Porous Dispersion (<18s)';
      cardDissolutionStatus.className = 'mt-1.5 block text-[10px] font-medium text-sky-400';
    } else if (sinkSeconds < 45) {
      cardDissolutionStatus.textContent = 'Acceptable Dissolution (18–45s)';
      cardDissolutionStatus.className = 'mt-1.5 block text-[10px] font-medium text-emerald-400';
    } else {
      cardDissolutionStatus.textContent = 'Sluggish Wetted Agglomerate (>45s)';
      cardDissolutionStatus.className = 'mt-1.5 block text-[10px] font-medium text-amber-400';
    }

    // 4. Electrostatic Cloud Potential & Spark Energy Potential
    // Streaming current generates charge Q; V = I * R. Spark Energy E = 0.5 * C * V^2 (C ~ 100 pF)
    const streamingCurrentUa = (velocity * 25) + (sprayRate * 0.4);
    const voltageKv = Math.min(35, (streamingCurrentUa * 1e-6 * grounding * 1000) / 1000);
    const capacitancePf = 120; // typical ungrounded filter sleeve cage
    const sparkEnergyMj = 0.5 * (capacitancePf * 1e-12) * Math.pow(voltageKv * 1000, 2) * 1000;

    readoutPotential.textContent = `${voltageKv.toFixed(2)} kV`;
    readoutSparkEnergy.textContent = `${sparkEnergyMj.toFixed(2)} mJ`;

    const mieSafetyRatio = powder.mieMj / Math.max(0.001, sparkEnergyMj);
    cardMieVal.textContent = mieSafetyRatio > 500 ? '>500×' : `${mieSafetyRatio.toFixed(1)}×`;
    barMie.style.width = `${Math.min(100, Math.max(5, Math.log10(mieSafetyRatio + 1) * 35))}%`;

    if (mieSafetyRatio > 10) {
      cardMieStatus.textContent = 'Secure Static Margin (E_spark << MIE)';
      cardMieStatus.className = 'mt-1.5 block text-[10px] font-medium text-emerald-400';
      barMie.className = 'h-full bg-emerald-400 transition-all duration-300';
    } else if (mieSafetyRatio >= 1.0) {
      cardMieStatus.textContent = 'Marginal Static Safety (Risk of Brush Discharge)';
      cardMieStatus.className = 'mt-1.5 block text-[10px] font-medium text-amber-400';
      barMie.className = 'h-full bg-amber-400 transition-all duration-300';
    } else {
      cardMieStatus.textContent = 'DANGER: Spark Energy Exceeds Powder MIE!';
      cardMieStatus.className = 'mt-1.5 block text-[10px] font-medium text-rose-400';
      barMie.className = 'h-full bg-rose-500 transition-all duration-300';
    }

    // 5. Reduced Deflagration Pressure Pred (bar) vs Vessel Limit
    // If O2 <= LOC, deflagration cannot occur!
    const isNitrogenInerted = o2 < 9.5;
    let predBar = 0;
    if (!isNitrogenInerted) {
      if (equip.id === 'unprotected_vintage_powder_dryer') {
        // No vent panel -> pressure approaches Pmax (8.0-9.2 bar)
        predBar = powder.pMaxBar * 0.92;
      } else if (equip.id === 'hygienic_infant_formula_wurster_coater') {
        // High 10-bar containment vessel
        predBar = 0.08;
      } else {
        // Properly sized NFPA 68 rupture panel vents Pred to ~0.2-0.35 bar
        predBar = 0.05 + (powder.kstBarMS / 200) * 0.28;
      }
    } else {
      predBar = 0.02; // zero deflagration possible
    }

    cardPredVal.textContent = predBar.toFixed(2);
    const predPercent = (predBar / equip.vesselDesignPressureBar) * 100;
    barPred.style.width = `${Math.min(100, predPercent)}%`;

    if (predBar <= equip.vesselDesignPressureBar * 0.7) {
      cardPredStatus.textContent = `< Vessel Limit (${equip.vesselDesignPressureBar.toFixed(2)} bar) [Safe Venting]`;
      cardPredStatus.className = 'mt-1.5 block text-[10px] font-medium text-emerald-400';
      barPred.className = 'h-full bg-emerald-400 transition-all duration-300';
    } else if (predBar <= equip.vesselDesignPressureBar) {
      cardPredStatus.textContent = `Near Vessel Limit (${equip.vesselDesignPressureBar.toFixed(2)} bar)`;
      cardPredStatus.className = 'mt-1.5 block text-[10px] font-medium text-amber-400';
      barPred.className = 'h-full bg-amber-400 transition-all duration-300';
    } else {
      cardPredStatus.textContent = `EXCEEDS VESSEL LIMIT (${equip.vesselDesignPressureBar.toFixed(2)} bar) — CATASTROPHIC RUPTURE`;
      cardPredStatus.className = 'mt-1.5 block text-[10px] font-medium text-rose-400 font-bold';
      barPred.className = 'h-full bg-rose-500 transition-all duration-300';
    }

    // Overall Safety Status Assessment
    const isDeflagrationHazard = !isNitrogenInerted && (sparkEnergyMj >= powder.mieMj || grounding > 100) && predBar > equip.vesselDesignPressureBar;
    const isMarginal = !isDeflagrationHazard && (grounding > 10 || defluidRisk > 65 || o2 > 10 && mieSafetyRatio < 5);

    if (isDeflagrationHazard) {
      statusBanner.className = 'rounded-xl bg-rose-950/60 p-5 border border-rose-700/80 transition-colors';
      statusIconContainer.className = 'rounded-lg bg-rose-500/20 p-2.5 text-rose-400 mt-0.5';
      statusTitle.textContent = 'ALERT: CATASTROPHIC COMBUSTIBLE DUST DEFLAGRATION & VESSEL RUPTURE HAZARD';
      statusTitle.className = 'text-base font-bold text-rose-300';
      statusTag.textContent = 'CRITICAL DANGER';
      statusTag.className = 'rounded-full bg-rose-500/30 px-2.5 py-0.5 text-xs font-bold text-rose-300 border border-rose-500/40';

      readoutPrimaryRisk.textContent = 'Electrostatic spark energy exceeds powder MIE inside unvented/under-rated vessel; internal deflagration will rupture shell.';
      readoutMechanisms.textContent = `Cloud concentration > MEC (${powder.mecGM3} g/m³); Spark energy (${sparkEnergyMj.toFixed(2)} mJ) > MIE (${powder.mieMj} mJ); P_red (${predBar.toFixed(2)} bar) > P_vessel (${equip.vesselDesignPressureBar} bar).`;
      readoutMitigation.textContent = 'MANDATORY SHUTDOWN: Restore R ≤ 10Ω ground continuity; retrofit NFPA 68 burst panel or inert with N2 below LOC (9.5%).';
    } else if (isMarginal) {
      statusBanner.className = 'rounded-xl bg-amber-950/50 p-5 border border-amber-700/70 transition-colors';
      statusIconContainer.className = 'rounded-lg bg-amber-500/20 p-2.5 text-amber-400 mt-0.5';
      statusTitle.textContent = 'WARNING: PROCESS PARAMETERS MARGINAL — INSPECTION REQUIRED';
      statusTitle.className = 'text-base font-bold text-amber-300';
      statusTag.textContent = 'ELEVATED RISK';
      statusTag.className = 'rounded-full bg-amber-500/20 px-2.5 py-0.5 text-xs font-bold text-amber-300 border border-amber-500/30';

      readoutPrimaryRisk.textContent = grounding > 10 ? 'Degraded grounding (>10Ω) risks brush discharge; check filter sleeve continuity.' : 'Elevated bed moisture approaching defluidization sticky boundary.';
      readoutMechanisms.textContent = `Static ground resistance ${grounding}Ω exceeds NFPA 652 limit (10Ω); Bed moisture load ${Math.round(defluidRisk)}%.`;
      readoutMitigation.textContent = 'Tighten bonding clamps; adjust atomization air pressure or lower binder rate to safeguard bed fluidization.';
    } else {
      statusBanner.className = 'rounded-xl bg-emerald-950/40 p-5 border border-emerald-800/60 transition-colors';
      statusIconContainer.className = 'rounded-lg bg-emerald-500/20 p-2.5 text-emerald-400 mt-0.5';
      statusTitle.textContent = 'FULLY COMPLIANT (NFPA 652 / NFPA 68 CERTIFIED)';
      statusTitle.className = 'text-base font-bold text-emerald-300';
      statusTag.textContent = 'LOW RISK';
      statusTag.className = 'rounded-full bg-emerald-500/20 px-2.5 py-0.5 text-xs font-bold text-emerald-300 border border-emerald-500/30';

      readoutPrimaryRisk.textContent = 'Normal controlled fluidization; negligible static ignition probability; verified pressure containment.';
      readoutMechanisms.textContent = 'Optimal viscous Stokes dissipation; rapid droplet liquid bridge evaporation without wall fouling.';
      readoutMitigation.textContent = 'Continue routine annual DHA inspection; maintain R ≤ 10 Ω bond checks daily prior to batch runs.';
    }
  }

  // Event Listeners for Controls
  [selectEquipment, selectPowder, selectBinder, inputAirTemp, inputVelocity, inputAtomPress, inputSprayRate, inputGrounding, inputO2].forEach(el => {
    el.addEventListener('input', calculateTelemetry);
    el.addEventListener('change', calculateTelemetry);
  });

  // Presets Handlers
  btnPresetInfantFormula.addEventListener('click', () => {
    selectEquipment.value = 'hygienic_infant_formula_wurster_coater';
    selectPowder.value = 'whole_milk_powder_dairy';
    selectBinder.value = 'soy_sunflower_lecithin_emulsion';
    inputAirTemp.value = '65';
    inputVelocity.value = '1.6';
    inputAtomPress.value = '3.5';
    inputSprayRate.value = '45';
    inputGrounding.value = '2';
    inputO2.value = '6.5';
    calculateTelemetry();
  });

  btnPresetHighThroughput.addEventListener('click', () => {
    selectEquipment.value = 'industrial_continuous_vibro_fluidized_bed';
    selectPowder.value = 'hydrolyzed_whey_protein_isolate';
    selectBinder.value = 'aqueous_maltodextrin_solution';
    inputAirTemp.value = '75';
    inputVelocity.value = '1.8';
    inputAtomPress.value = '3.0';
    inputSprayRate.value = '65';
    inputGrounding.value = '4';
    inputO2.value = '20.9';
    calculateTelemetry();
  });

  btnPresetCompromisedTower.addEventListener('click', () => {
    selectEquipment.value = 'unprotected_vintage_powder_dryer';
    selectPowder.value = 'alkalized_cocoa_sugar_blend';
    selectBinder.value = 'sugar_gelatin_syrup';
    inputAirTemp.value = '85';
    inputVelocity.value = '2.4';
    inputAtomPress.value = '1.8';
    inputSprayRate.value = '80';
    inputGrounding.value = '420';
    inputO2.value = '20.9';
    calculateTelemetry();
  });

  btnPresetDelicateCocoa.addEventListener('click', () => {
    selectEquipment.value = 'pilot_top_spray_batch_fluidized_bed';
    selectPowder.value = 'alkalized_cocoa_sugar_blend';
    selectBinder.value = 'soy_sunflower_lecithin_emulsion';
    inputAirTemp.value = '52';
    inputVelocity.value = '1.2';
    inputAtomPress.value = '3.2';
    inputSprayRate.value = '22';
    inputGrounding.value = '3';
    inputO2.value = '20.9';
    calculateTelemetry();
  });

  // Copy Telemetry Report
  btnCopyReport.addEventListener('click', () => {
    const equip = data.equipmentArchitectures.find(e => e.id === selectEquipment.value) || data.equipmentArchitectures[0];
    const powder = data.foodPowderSubstrates.find(p => p.id === selectPowder.value) || data.foodPowderSubstrates[0];
    const binder = data.atomizingBinderSolutions.find(b => b.id === selectBinder.value) || data.atomizingBinderSolutions[0];

    const report = `=======================================================
COMMERCIAL FLUIDIZED BED AGGLOMERATION & DUST DEFLAGRATION REPORT
Timestamp: ${new Date().toISOString()}
=======================================================
Apparatus: ${equip.name}
Vessel Design Strength: ${equip.vesselDesignPressureBar} bar
Substrate: ${powder.name} (Kst: ${powder.kstBarMS} bar·m/s, MIE: ${powder.mieMj} mJ, MEC: ${powder.mecGM3} g/m³)
Binder Solution: ${binder.name}
Air Temperature: ${inputAirTemp.value}°C | Fluidizing Velocity: ${inputVelocity.value} m/s
Atomization Pressure: ${inputAtomPress.value} bar | Spray Rate: ${inputSprayRate.value} L/h
Ground Resistance: ${inputGrounding.value} Ω | Oxygen Level: ${inputO2.value}%

DIAGNOSTIC TELEMETRY:
- Sauter Mean Droplet Diameter (D32): ${cardD32Val.textContent} µm
- Bed Moisture & Defluidization Risk: ${cardMoistureVal.textContent}
- Cold-Water Instant Dissolution: ${cardDissolutionVal.textContent} sec
- Reduced Deflagration Pressure (Pred): ${cardPredVal.textContent} bar
- Spark Energy: ${readoutSparkEnergy.textContent} | MIE Margin: ${cardMieVal.textContent}
- Safety Status: ${statusTitle.textContent}
- Governing Risk: ${readoutPrimaryRisk.textContent}
=======================================================
IsItKitchenSafe Engineering Telemetry`;

    navigator.clipboard.writeText(report).then(() => {
      copyBtnText.textContent = 'Report Copied!';
      setTimeout(() => {
        copyBtnText.textContent = 'Copy Telemetry Report to Clipboard';
      }, 2500);
    });
  });

  // Initial Calculation
  calculateTelemetry();
})();
</script>
