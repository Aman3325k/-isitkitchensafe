const t = DICTIONARY[lang] || DICTIONARY.en;
const data = agglomerationData;
---

<div class="not-prose my-8 rounded-2xl bg-slate-900 border border-slate-800 p-6 md:p-8 text-slate-100 shadow-2xl">
  <!-- Header Badge & Title -->
  <div class="mb-6 flex flex-wrap items-center justify-between gap-4 border-b border-slate-800 pb-6">
    <div>
      <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-500/10 px-3 py-1 text-xs font-semibold text-amber-400 border border-amber-500/20">
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        {t.badge}
      </span>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-white md:text-3xl">
        {t.title}
      </h2>
      <p class="mt-1 text-sm text-slate-400 max-w-4xl leading-relaxed">
        {t.subtitle}
      </p>
    </div>
  </div>

  <!-- Operational Presets -->
  <div class="mb-8 rounded-xl bg-slate-800/60 p-4 border border-slate-700/60">
    <div class="flex items-center justify-between mb-3">
      <span class="text-xs font-bold uppercase tracking-wider text-amber-400">{t.presetsTitle}</span>
      <span class="text-[11px] text-slate-400">Click to load calibrated commercial configurations</span>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5">
      <button type="button" id="btnPresetInfantFormula" class="px-3 py-2 text-left rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 text-xs font-medium text-slate-200 transition-colors flex flex-col justify-between">
        <span class="font-semibold text-amber-300">Infant Formula</span>
        <span class="text-[11px] text-slate-400 mt-1 line-clamp-1">{t.presetInfantFormula}</span>
      </button>
      <button type="button" id="btnPresetHighThroughput" class="px-3 py-2 text-left rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 text-xs font-medium text-slate-200 transition-colors flex flex-col justify-between">
        <span class="font-semibold text-sky-300">Instant Protein</span>
        <span class="text-[11px] text-slate-400 mt-1 line-clamp-1">{t.presetHighThroughput}</span>
      </button>
      <button type="button" id="btnPresetCompromisedTower" class="px-3 py-2 text-left rounded-lg bg-rose-950/40 hover:bg-rose-900/60 border border-rose-800/60 text-xs font-medium text-rose-200 transition-colors flex flex-col justify-between">
        <span class="font-semibold text-rose-400">Deflagration Alert</span>
        <span class="text-[11px] text-rose-300/80 mt-1 line-clamp-1">{t.presetCompromisedTower}</span>
      </button>
      <button type="button" id="btnPresetDelicateCocoa" class="px-3 py-2 text-left rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 text-xs font-medium text-slate-200 transition-colors flex flex-col justify-between">
        <span class="font-semibold text-emerald-300">Cocoa & Sugar</span>
        <span class="text-[11px] text-slate-400 mt-1 line-clamp-1">{t.presetDelicateCocoa}</span>
      </button>
    </div>
  </div>

  <!-- Interactive Controls Grid -->
  <div class="mb-8 grid grid-cols-1 gap-6 lg:grid-cols-3">
    <!-- Left Column: Equipment, Powder & Binder Selection -->
    <div class="space-y-4 rounded-xl bg-slate-800/40 p-5 border border-slate-700/50">
      <h3 class="text-sm font-semibold uppercase tracking-wider text-amber-400 flex items-center gap-1.5">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
        </svg>
        Apparatus & Material Setup
      </h3>

      <div>
        <label for="selectEquipment" class="block text-xs font-medium text-slate-300 mb-1">{t.equipLabel}</label>
        <select id="selectEquipment" class="w-full rounded-lg bg-slate-900 border border-slate-700 px-3 py-2 text-xs text-slate-200 focus:border-amber-400 focus:outline-none focus:ring-1 focus:ring-amber-400">
          {data.equipmentArchitectures.map((eq) => (
            <option value={eq.id}>{eq.name}</option>
          ))}
        </select>
        <p class="mt-1 text-[11px] text-slate-400 leading-tight">{t.equipHelp}</p>
      </div>

      <div>
        <label for="selectPowder" class="block text-xs font-medium text-slate-300 mb-1">{t.powderLabel}</label>
        <select id="selectPowder" class="w-full rounded-lg bg-slate-900 border border-slate-700 px-3 py-2 text-xs text-slate-200 focus:border-amber-400 focus:outline-none focus:ring-1 focus:ring-amber-400">
          {data.foodPowderSubstrates.map((p) => (
            <option value={p.id}>{p.name}</option>
          ))}
        </select>
        <p class="mt-1 text-[11px] text-slate-400 leading-tight">{t.powderHelp}</p>
      </div>

      <div>
        <label for="selectBinder" class="block text-xs font-medium text-slate-300 mb-1">{t.binderLabel}</label>
