    substrateHelp: "PETボトルプリフォーム＆HDPEキャップ、無菌充填紙容器アルミラミネート原反、医薬品PTPアルミブリスター、または鶏卵・青果物搬送ラインを選択。",
    exhaustLabel: "触媒排気ガス処理＆オゾン完全分解システム:",
    exhaustHelp: "加熱型ホプカライト (Hopcalite MnO2-CuO) 触媒分解器、HEPA付き2段アルカリ湿式スクラバー、または劣化直接排気管路を選択。",
    powerLabel: "マイクロ波プラズマ吸収電力 (Watts):",
    powerHelp: "プラズマキャビティ内に供給される 2.45 GHz マイクロ波実効投入電力 (400〜3,000 W)。",
    exposureLabel: "基材暴露照射・滞留時間 (seconds):",
    exposureHelp: "非熱プラズマジェット羽流下を通過する有効照射時間 (0.1〜3.0 s)。",
    flowRateLabel: "プロセス作動ガス供給流量 (SLPM):",
    flowRateHelp: "プラズマトーチに供給される標準流量 (10〜80 SLPM)。",
    standoffLabel: "石英ノズル・基材間ギャップ距離 (mm):",
    standoffHelp: "ノズル先端から包装材料表面までの照射クリアランス (5〜40 mm)。",
    presetsTitle: "工業用インライン滅菌プロセス標準プリセット",
    presetPetPreforms: "無菌PETプリフォーム殺菌 (4灯APMPJ, 1,800W, 0.8s, Ar/O2, 35 SLPM, 15mm)",
    presetCartonWeb: "無菌カートン連続原反 (線状カーテン, 2,400W, 0.5s, N2/Air, 55 SLPM, 12mm)",
    presetMedicalBlister: "医薬品PTPアルミ滅菌 (マイクロジェット, 900W, 0.4s, He/H2O, 25 SLPM, 10mm)",
    presetProduceEgg: "鶏卵殻・種子表面消毒 (4灯APMPJ, 1,200W, 1.2s, N2/Air, 40 SLPM, 20mm)",
    presetArcingHazard: "電弧アーク発生・基材熱収縮 (劣化キャビティ, 3,000W, 2.5s, 多湿空気, 12 SLPM, 6mm)",
    diagnosticTitle: "プラズマ滅菌速度論・光子照射量・熱解析診断",
    diagnosticSub: "耐熱芽胞対数死滅率 (Log Reduction)、UV-C光子照射量、ROS/RNSラジカルフラックス、材料表面温度上昇 (ΔT)、プラズマ吸収電力密度、およびOSHA労働環境安全基準をリアルタイム算出。",
    logReductionLabel: "芽胞死滅対数減少率 (Log10)",
    uvFluenceLabel: "UV-C 光子照射エネルギー (mJ/cm²)",
    radicalFluxLabel: "ROS / RNS 活性ラジカルフラックス (ppm)",
    thermalRiseLabel: "基材表面温度上昇 ΔT (°C)",
    powerDensityLabel: "プラズマ吸収電力密度 (W/cm³)",
    oshaExhaustLabel: "触媒オゾン排気分解率 (%)",
    complianceStatusLabel: "FDA 21 CFR § 179.26 および OSHA 適合状況",
    primaryLimitationLabel: "物理的・熱力学的制限律速因子",
    mitigationActionLabel: "推奨インラインプロセス改善対策",
    diagramTitle: "2.45 GHz 連続マイクロ波プラズマジェット構造図",
    diagramSub: "マイクロ波同軸共振器、石英放電ノズル、非熱活性プラズマジェット羽流、紫外線照射、および包装搬送コンベアの動作図解。",
    scienceTitle: "マイクロ波プラズマ物理学・光子ラジカル相乗効果と非熱滅菌原理",
    scienceSub: "電子エネルギー分布関数 (EEDF)、UV-Cと活性酸素種による芽胞コートエッチング動力学、熱伝導境界層、および触媒排気分解の工学解析。",
    tableTitle: "インライン表面滅菌技術の比較および設計基準データ"
  }
};

const d = DICT[lang] || DICT.en;
---

<div class="not-prose my-8 rounded-3xl bg-surface border border-hairline p-6 sm:p-10 shadow-sm" id="microwave-plasma-modeler">
  <!-- Header Badge & Title -->
  <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-violet-950 text-violet-200 border border-violet-800">
      <svg class="w-3.5 h-3.5 text-violet-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
      </svg>
      <span>{d.badge}</span>
    </div>
    <div class="text-xs text-muted font-mono bg-surface-soft px-3 py-1 rounded-md border border-hairline">
      2.45 GHz ISM &bull; FDA 21 CFR § 179.26 &bull; OSHA 1910.1000
    </div>
  </div>

  <h2 class="text-title-lg sm:text-display-sm font-semibold text-ink tracking-tight mb-3">
    {d.title}
  </h2>
  <p class="text-body text-sm sm:text-base leading-relaxed text-muted max-w-4xl mb-8">
    {d.subtitle}
  </p>

  <!-- Controls Panel -->
  <div class="bg-surface-soft rounded-2xl border border-hairline p-6 mb-8">
    <div class="mb-5 border-b border-hairline/60 pb-3">
      <h3 class="text-base font-semibold text-ink">{d.controlsTitle}</h3>
      <p class="text-xs text-muted">{d.controlsSub}</p>
    </div>

    <!-- Dropdowns Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
      <!-- Plasma Generator -->
      <div>
        <label for="plasma-generator-sel" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1">
          {d.generatorLabel}
        </label>
        <select id="plasma-generator-sel" class="w-full text-xs sm:text-sm bg-surface border border-hairline rounded-xl px-3 py-2.5 text-ink focus:outline-none focus:ring-2 focus:ring-violet-600">
          {plasmaData.plasmaGenerators.map(gen => (
            <option value={gen.id}>{gen.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1">{d.generatorHelp}</p>
      </div>

      <!-- Working Gas Mixture -->
      <div>
        <label for="gas-mixture-sel" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1">
          {d.gasLabel}
        </label>
        <select id="gas-mixture-sel" class="w-full text-xs sm:text-sm bg-surface border border-hairline rounded-xl px-3 py-2.5 text-ink focus:outline-none focus:ring-2 focus:ring-violet-600">
          {plasmaData.workingGasMixtures.map(gas => (
            <option value={gas.id}>{gas.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1">{d.gasHelp}</p>
      </div>

      <!-- Substrate Target -->
      <div>
        <label for="substrate-sel" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1">
          {d.substrateLabel}
        </label>
        <select id="substrate-sel" class="w-full text-xs sm:text-sm bg-surface border border-hairline rounded-xl px-3 py-2.5 text-ink focus:outline-none focus:ring-2 focus:ring-violet-600">
          {plasmaData.substrateTargets.map(sub => (
            <option value={sub.id}>{sub.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1">{d.substrateHelp}</p>
      </div>

      <!-- Exhaust Scrubber -->
      <div>
        <label for="exhaust-sel" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1">
          {d.exhaustLabel}
        </label>
        <select id="exhaust-sel" class="w-full text-xs sm:text-sm bg-surface border border-hairline rounded-xl px-3 py-2.5 text-ink focus:outline-none focus:ring-2 focus:ring-violet-600">
          {plasmaData.exhaustMitigationSystems.map(ex => (
            <option value={ex.id}>{ex.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1">{d.exhaustHelp}</p>
      </div>
    </div>

    <!-- Sliders Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      <!-- Microwave Power Slider -->
      <div class="bg-surface rounded-xl p-4 border border-hairline">
        <div class="flex justify-between items-center mb-1">
          <label for="power-slider" class="text-xs font-bold uppercase text-ink">{d.powerLabel}</label>
          <span id="power-val" class="font-mono text-xs font-bold text-violet-700">1800 W</span>
        </div>
        <input type="range" id="power-slider" min="400" max="3000" step="50" value="1800" class="w-full accent-violet-600 cursor-pointer" />
        <div class="flex justify-between text-[10px] text-muted font-mono mt-1">
          <span>400 W</span>
          <span>3,000 W</span>
        </div>
        <p class="text-[10px] text-muted mt-1">{d.powerHelp}</p>
      </div>

      <!-- Residence / Dwell Time Slider -->
      <div class="bg-surface rounded-xl p-4 border border-hairline">
        <div class="flex justify-between items-center mb-1">
          <label for="exposure-slider" class="text-xs font-bold uppercase text-ink">{d.exposureLabel}</label>
          <span id="exposure-val" class="font-mono text-xs font-bold text-violet-700">0.8 s</span>
        </div>
        <input type="range" id="exposure-slider" min="0.1" max="3.0" step="0.1" value="0.8" class="w-full accent-violet-600 cursor-pointer" />
        <div class="flex justify-between text-[10px] text-muted font-mono mt-1">
          <span>0.1 s</span>
          <span>3.0 s</span>
        </div>
        <p class="text-[10px] text-muted mt-1">{d.exposureHelp}</p>
      </div>

      <!-- Gas Flow Rate Slider -->
      <div class="bg-surface rounded-xl p-4 border border-hairline">
        <div class="flex justify-between items-center mb-1">
          <label for="flow-slider" class="text-xs font-bold uppercase text-ink">{d.flowRateLabel}</label>
          <span id="flow-val" class="font-mono text-xs font-bold text-violet-700">35 SLPM</span>
        </div>
        <input type="range" id="flow-slider" min="10" max="80" step="1" value="35" class="w-full accent-violet-600 cursor-pointer" />
        <div class="flex justify-between text-[10px] text-muted font-mono mt-1">
          <span>10 SLPM</span>
          <span>80 SLPM</span>
        </div>
        <p class="text-[10px] text-muted mt-1">{d.flowRateHelp}</p>
      </div>

      <!-- Standoff Distance Slider -->
      <div class="bg-surface rounded-xl p-4 border border-hairline">
        <div class="flex justify-between items-center mb-1">
          <label for="standoff-slider" class="text-xs font-bold uppercase text-ink">{d.standoffLabel}</label>
          <span id="standoff-val" class="font-mono text-xs font-bold text-violet-700">15 mm</span>
        </div>
        <input type="range" id="standoff-slider" min="5" max="40" step="1" value="15" class="w-full accent-violet-600 cursor-pointer" />
        <div class="flex justify-between text-[10px] text-muted font-mono mt-1">
          <span>5 mm</span>
          <span>40 mm</span>
        </div>
        <p class="text-[10px] text-muted mt-1">{d.standoffHelp}</p>
      </div>
    </div>

    <!-- Presets -->
    <div class="mt-6 pt-4 border-t border-hairline/60">
      <span class="text-xs font-bold uppercase tracking-wider text-ink block mb-2">{d.presetsTitle}</span>
      <div class="flex flex-wrap gap-2">
        <button type="button" id="btn-preset-pet" class="px-3 py-1.5 rounded-lg text-xs font-medium bg-surface hover:bg-violet-50 text-violet-900 border border-violet-200 transition-colors shadow-2xs">
          {d.presetPetPreforms}
        </button>
        <button type="button" id="btn-preset-carton" class="px-3 py-1.5 rounded-lg text-xs font-medium bg-surface hover:bg-violet-50 text-violet-900 border border-violet-200 transition-colors shadow-2xs">
          {d.presetCartonWeb}
        </button>
        <button type="button" id="btn-preset-blister" class="px-3 py-1.5 rounded-lg text-xs font-medium bg-surface hover:bg-violet-50 text-violet-900 border border-violet-200 transition-colors shadow-2xs">
          {d.presetMedicalBlister}
        </button>
        <button type="button" id="btn-preset-egg" class="px-3 py-1.5 rounded-lg text-xs font-medium bg-surface hover:bg-violet-50 text-violet-900 border border-violet-200 transition-colors shadow-2xs">
          {d.presetProduceEgg}
        </button>
        <button type="button" id="btn-preset-hazard" class="px-3 py-1.5 rounded-lg text-xs font-medium bg-surface hover:bg-red-50 text-red-700 border border-red-200 transition-colors shadow-2xs">
          {d.presetArcingHazard}
        </button>
      </div>
    </div>
  </div>

  <!-- Real-Time Diagnostics Cards -->
  <div class="mb-8">
    <div class="mb-4">
      <h3 class="text-base font-semibold text-ink">{d.diagnosticTitle}</h3>
      <p class="text-xs text-muted">{d.diagnosticSub}</p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3 sm:gap-4">
      <!-- 1. Spore Inactivation Log Reduction -->
      <div class="bg-surface-soft border border-hairline rounded-2xl p-4 flex flex-col justify-between">
        <span class="text-xs font-medium text-muted leading-tight mb-1">{d.logReductionLabel}</span>
        <div id="metric-log-reduction" class="text-2xl font-mono font-extrabold text-violet-800">6.2 Log</div>
        <span id="sub-log-reduction" class="text-[10px] text-muted font-medium mt-1">≥ 6.0 Log (Sterile Commercial Standard)</span>
      </div>

      <!-- 2. UV-C Photonic Fluence -->
      <div class="bg-surface-soft border border-hairline rounded-2xl p-4 flex flex-col justify-between">
        <span class="text-xs font-medium text-muted leading-tight mb-1">{d.uvFluenceLabel}</span>
        <div id="metric-uv-fluence" class="text-2xl font-mono font-extrabold text-violet-800">92.4 mJ/cm²</div>
        <span id="sub-uv-fluence" class="text-[10px] text-muted font-medium mt-1">High Photonic DNA Thymine Dimerization</span>
      </div>

      <!-- 3. Radical Flux ROS/RNS -->
      <div class="bg-surface-soft border border-hairline rounded-2xl p-4 flex flex-col justify-between">
        <span class="text-xs font-medium text-muted leading-tight mb-1">{d.radicalFluxLabel}</span>
        <div id="metric-radical-flux" class="text-2xl font-mono font-extrabold text-violet-800">185 ppm</div>
        <span id="sub-radical-flux" class="text-[10px] text-muted font-medium mt-1">Singlet O2 &bull; •OH &bull; Ozone Etching</span>
      </div>

      <!-- 4. Substrate Surface Delta T -->
      <div class="bg-surface-soft border border-hairline rounded-2xl p-4 flex flex-col justify-between">
        <span class="text-xs font-medium text-muted leading-tight mb-1">{d.thermalRiseLabel}</span>
        <div id="metric-thermal-rise" class="text-2xl font-mono font-extrabold text-emerald-700">+8.6°C</div>
        <span id="sub-thermal-rise" class="text-[10px] text-muted font-medium mt-1">Safe Margin (ΔT &lt; 15°C Max)</span>
      </div>

      <!-- 5. Microwave Absorbed Power Density -->
      <div class="bg-surface-soft border border-hairline rounded-2xl p-4 flex flex-col justify-between">
        <span class="text-xs font-medium text-muted leading-tight mb-1">{d.powerDensityLabel}</span>
        <div id="metric-power-density" class="text-2xl font-mono font-extrabold text-violet-800">142 W/cm³</div>
        <span id="sub-power-density" class="text-[10px] text-muted font-medium mt-1">Dense Non-Thermal Glow Discharge</span>
      </div>

      <!-- 6. OSHA Ozone Destruction -->
      <div class="bg-surface-soft border border-hairline rounded-2xl p-4 flex flex-col justify-between">
        <span class="text-xs font-medium text-muted leading-tight mb-1">{d.oshaExhaustLabel}</span>
        <div id="metric-osha-exhaust" class="text-2xl font-mono font-extrabold text-emerald-700">99.98%</div>
        <span id="sub-osha-exhaust" class="text-[10px] text-muted font-medium mt-1">Stack O3 &lt; 0.02 ppm (OSHA Safe)</span>
      </div>
    </div>
  </div>

  <!-- Compliance & Process Status Banner -->
  <div class="mb-8 p-5 rounded-2xl bg-surface-soft border border-hairline">
    <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
      <span class="text-xs font-bold uppercase tracking-wider text-ink">{d.complianceStatusLabel}</span>
      <span id="badge-compliance" class="px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800">
        FDA 21 CFR § 179.26 &bull; cGMP COMPLIANT
      </span>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
      <div>
        <span class="font-semibold text-muted block mb-1">{d.primaryLimitationLabel}</span>
        <p id="limitation-text" class="text-ink leading-relaxed">
          High microbial lethality achieved via synergistic VUV/UV-C radiation and ROS radical etching. Spore reduction (6.2 Log) exceeds commercial aseptic standard (6.0 Log). Substrate surface heating (+8.6°C) remains well within polymer tolerance (limit: 15.0°C).
        </p>
      </div>
      <div>
        <span id="action-label" class="font-semibold text-muted block mb-1">{d.mitigationActionLabel}</span>
        <p id="mitigation-text" class="text-ink leading-relaxed">
          Maintain steady-state 2.45 GHz automatic impedance tuning, verify closed-loop torch jacket water cooling, and log Hopcalite catalyst temperature sensors to ensure zero ozone emissions.
        </p>
      </div>
    </div>
  </div>

  <!-- Dynamic SVG Diagram: Microwave Plasma Jet Beam Architecture -->
  <div class="bg-surface-soft rounded-2xl border border-hairline p-5 sm:p-6 mb-8">
    <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
      <div>
        <h3 class="text-base font-semibold text-ink">{d.diagramTitle}</h3>
        <p class="text-xs text-muted">{d.diagramSub}</p>
      </div>
      <div class="flex items-center gap-2 text-xs font-mono">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-violet-100 text-violet-900">
          <span class="w-2 h-2 rounded-full bg-violet-600 animate-pulse"></span>
          Plasma Plume: 2.45 GHz
        </span>
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-amber-100 text-amber-900">
          <span class="w-2 h-2 rounded-full bg-amber-500"></span>
          UV-C Flux: 180-280 nm
        </span>
      </div>
    </div>

    <div class="w-full overflow-x-auto bg-surface rounded-xl p-3 border border-hairline flex justify-center">
      <svg id="plasma-svg" viewBox="0 0 640 240" class="w-full max-w-2xl h-auto select-none" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <!-- Plasma Glow Gradient -->
          <linearGradient id="plasmaGlow" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#8b5cf6" stop-opacity="0.95" />
            <stop offset="40%" stop-color="#c084fc" stop-opacity="0.8" />
            <stop offset="85%" stop-color="#67e8f9" stop-opacity="0.4" />
            <stop offset="100%" stop-color="#38bdf8" stop-opacity="0.0" />
          </linearGradient>

          <!-- Core Microwave Beam Gradient -->
          <linearGradient id="coreBeam" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#ffffff" stop-opacity="1" />
            <stop offset="50%" stop-color="#e0e7ff" stop-opacity="0.9" />
            <stop offset="100%" stop-color="#a855f7" stop-opacity="0.3" />
          </linearGradient>

          <!-- UV Radiation Radial Flash -->
          <radialGradient id="uvFlash" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#ec4899" stop-opacity="0.6" />
            <stop offset="60%" stop-color="#a855f7" stop-opacity="0.25" />
            <stop offset="100%" stop-color="#3b82f6" stop-opacity="0" />
          </radialGradient>
        </defs>

        <!-- Background grid lines -->
        <g stroke="#e2e8f0" stroke-width="0.5" stroke-dasharray="3,3">
          <line x1="40" y1="40" x2="600" y2="40" />
          <line x1="40" y1="90" x2="600" y2="90" />
          <line x1="40" y1="140" x2="600" y2="140" />
          <line x1="40" y1="190" x2="600" y2="190" />
        </g>

        <!-- Microwave Waveguide / Coaxial Body -->
        <rect x="250" y="15" width="140" height="45" rx="6" fill="#334155" stroke="#1e293b" stroke-width="2" />
        <text x="320" y="32" font-size="10" font-family="monospace" fill="#f8fafc" font-weight="bold" text-anchor="middle">2.45 GHz Resonator</text>
        <text x="320" y="47" font-size="8" font-family="sans-serif" fill="#94a3b8" text-anchor="middle">Water-Cooled Coax Cavity</text>

        <!-- Process Gas Inlets -->
        <path d="M 215,35 L 250,35" stroke="#0ea5e9" stroke-width="4" stroke-linecap="round" />
        <text x="200" y="38" font-size="9" font-family="sans-serif" fill="#0284c7" font-weight="bold" text-anchor="end">Gas Feed (Ar/O2)</text>

        <!-- Microwave Feed Cable -->
        <path d="M 425,35 L 390,35" stroke="#eab308" stroke-width="4" stroke-linecap="round" />
        <text x="440" y="38" font-size="9" font-family="sans-serif" fill="#ca8a04" font-weight="bold">RF/MW Coax</text>

        <!-- Quartz Dielectric Nozzle Orifice -->
        <polygon points="285,60 355,60 340,95 300,95" fill="#f1f5f9" stroke="#94a3b8" stroke-width="1.5" />
        <text x="320" y="80" font-size="8" font-family="sans-serif" fill="#64748b" text-anchor="middle">Quartz Nozzle</text>

        <!-- UV-C Halo Flash -->
        <ellipse id="svg-uv-halo" cx="320" cy="135" rx="75" ry="45" fill="url(#uvFlash)" />

        <!-- Outer Reactive Plasma Plume -->
        <path id="svg-plasma-plume" d="M 300,95 C 275,130 250,165 240,178 C 300,183 340,183 400,178 C 390,165 365,130 340,95 Z" fill="url(#plasmaGlow)" />

        <!-- Intense Core Microwave Jet -->
        <path id="svg-core-jet" d="M 312,95 C 305,120 295,150 288,178 C 315,181 325,181 352,178 C 345,150 335,120 328,95 Z" fill="url(#coreBeam)" />

        <!-- Substrate Web / Conveyor Belt -->
        <rect x="60" y="178" width="520" height="12" rx="3" fill="#cbd5e1" stroke="#64748b" stroke-width="1.5" />
        <rect x="140" y="175" width="360" height="6" rx="2" fill="#0284c7" opacity="0.8" />
        <text x="320" y="205" font-size="9" font-family="sans-serif" fill="#475569" font-weight="bold" text-anchor="middle">Packaging Web Substrate (PET / Carton Laminate Foil) &rarr; Conveyor Travel</text>

        <!-- Active Treatment Zone Bracket -->
        <line x1="235" y1="172" x2="235" y2="188" stroke="#7c3aed" stroke-width="2" />
        <line x1="405" y1="172" x2="405" y2="188" stroke="#7c3aed" stroke-width="2" />
        <line x1="235" y1="168" x2="405" y2="168" stroke="#7c3aed" stroke-width="1" stroke-dasharray="2,2" />
        <text x="320" y="164" font-size="8" font-family="monospace" fill="#6d28d9" font-weight="bold" text-anchor="middle">Active Jet Decontamination Zone (Spore D-Value ≤ 0.18s)</text>

        <!-- Exhaust Extraction Canopy -->
        <path d="M 120,120 L 170,75 L 170,40" stroke="#64748b" stroke-width="2" stroke-dasharray="3,3" fill="none" />
        <path d="M 520,120 L 470,75 L 470,40" stroke="#64748b" stroke-width="2" stroke-dasharray="3,3" fill="none" />
        <text x="145" y="60" font-size="8" font-family="sans-serif" fill="#64748b" text-anchor="middle">Exhaust Hood</text>
        <text x="495" y="60" font-size="8" font-family="sans-serif" fill="#64748b" text-anchor="middle">To Hopcalite Scrubber</text>
      </svg>
    </div>
  </div>

  <!-- Scientific Principles & Engineering Math -->
  <div class="mb-8 p-6 rounded-2xl bg-surface-soft border border-hairline">
    <h3 class="text-base font-semibold text-ink mb-2">{d.scienceTitle}</h3>
    <p class="text-xs text-muted mb-4">{d.scienceSub}</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs text-muted leading-relaxed">
      <div class="p-4 rounded-xl bg-surface border border-hairline">
        <strong class="text-ink block mb-1">1. Non-Thermal Plasma Thermodynamics (Te &gt;&gt; Tg):</strong>
        At 2.45 GHz microwave excitation, free electrons absorb energy efficiently, reaching temperatures of 1.5–2.5 eV (equivalent to 15,000–25,000 K). Heavy neutral gas molecules and ions remain close to ambient temperature (35°C–60°C). This allows the generation of energetic reactive oxygen and nitrogen species without melting delicate thin-film polymers.
      </div>
      <div class="p-4 rounded-xl bg-surface border border-hairline">
        <strong class="text-ink block mb-1">2. Synergistic UV-C &amp; ROS Spore Etching Kinetics:</strong>
        Microbial spore inactivation proceeds through dual mechanisms: (1) vacuum UV/UV-C photons (180–280 nm) penetrate spore layers to induce cross-linking thymine dimers in genomic DNA; (2) ground-state atomic oxygen and hydroxyl radicals chemically etch and permeabilize the protective dipicolinic acid (DPA) spore coat, resulting in rapid collapse (D-values &lt; 0.20s).
      </div>
      <div class="p-4 rounded-xl bg-surface border border-hairline">
        <strong class="text-ink block mb-1">3. Thermal Boundary Layer &amp; Substrate Heating:</strong>
        Transient heat conduction into the moving packaging film is governed by Fourier's law with convective plume flux: &Delta;T_surf &prop; q''_therm &middot; &radic;(t_res / (&pi; &middot; k &middot; &rho; &middot; c_p)). Controlling exposure time (&le; 1.0s) and standoff distance (&ge; 12mm) guarantees substrate temperature rise remains below the polymer's glass transition temperature (Tg).
      </div>
      <div class="p-4 rounded-xl bg-surface border border-hairline">
        <strong class="text-ink block mb-1">4. Catalytic Off-Gas Destruction (OSHA 1910.1000):</strong>
        Active plasma plumes exhaust ozone (O3) and nitrogen oxides (NOx). Utilizing heated Hopcalite (manganese dioxide and copper oxide) catalytic beds catalytically decomposes ozone back into diatomic oxygen (O2) with &gt;99.98% efficiency, ensuring workplace ambient air remains far below OSHA's 0.10 ppm permissible exposure limit.
      </div>
    </div>
  </div>

  <!-- Benchmarking Table -->
  <div class="rounded-2xl bg-surface-soft border border-hairline p-5 sm:p-6">
    <h3 class="text-base font-semibold text-ink mb-3">{d.tableTitle}</h3>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs border-collapse">
        <thead>
          <tr class="border-b border-hairline text-muted font-bold uppercase tracking-wider text-[11px]">
            <th class="py-2.5 px-3">Sterilization Technology</th>
            <th class="py-2.5 px-3">Treatment Time</th>
            <th class="py-2.5 px-3">Surface &Delta;T</th>
            <th class="py-2.5 px-3">Spore Kill (Log)</th>
            <th class="py-2.5 px-3">Chemical Residue</th>
            <th class="py-2.5 px-3">Regulatory Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline/60 font-mono">
          {plasmaData.decontaminationBenchmarks.map(b => (
            <tr class="hover:bg-surface transition-colors">
              <td class="py-2 px-3 font-sans font-medium text-ink">{b.technology}</td>
              <td class="py-2 px-3">{b.treatmentTimeSeconds}</td>
              <td class="py-2 px-3 text-emerald-700 font-bold">{b.substrateThermalRiseC}</td>
              <td class="py-2 px-3 text-violet-800 font-bold">{b.sporeLogReduction}</td>
              <td class="py-2 px-3 font-sans">{b.chemicalResidue}</td>
              <td class="py-2 px-3 font-sans text-muted">{b.regulatoryStatus}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  function initMicrowavePlasmaModeler() {
    const root = document.getElementById('microwave-plasma-modeler');
    if (!root) return;

    // Elements
    const selGenerator = document.getElementById('plasma-generator-sel') as HTMLSelectElement | null;
    const selGas = document.getElementById('gas-mixture-sel') as HTMLSelectElement | null;
    const selSubstrate = document.getElementById('substrate-sel') as HTMLSelectElement | null;
    const selExhaust = document.getElementById('exhaust-sel') as HTMLSelectElement | null;

    const sliderPower = document.getElementById('power-slider') as HTMLInputElement | null;
    const sliderExposure = document.getElementById('exposure-slider') as HTMLInputElement | null;
    const sliderFlow = document.getElementById('flow-slider') as HTMLInputElement | null;
    const sliderStandoff = document.getElementById('standoff-slider') as HTMLInputElement | null;

    const valPower = document.getElementById('power-val');
    const valExposure = document.getElementById('exposure-val');
    const valFlow = document.getElementById('flow-val');
    const valStandoff = document.getElementById('standoff-val');

    const metricLogReduction = document.getElementById('metric-log-reduction');
    const subLogReduction = document.getElementById('sub-log-reduction');
    const metricUvFluence = document.getElementById('metric-uv-fluence');
    const subUvFluence = document.getElementById('sub-uv-fluence');
    const metricRadicalFlux = document.getElementById('metric-radical-flux');
    const subRadicalFlux = document.getElementById('sub-radical-flux');
    const metricThermalRise = document.getElementById('metric-thermal-rise');
    const subThermalRise = document.getElementById('sub-thermal-rise');
    const metricPowerDensity = document.getElementById('metric-power-density');
    const subPowerDensity = document.getElementById('sub-power-density');
    const metricOshaExhaust = document.getElementById('metric-osha-exhaust');
    const subOshaExhaust = document.getElementById('sub-osha-exhaust');

    const badgeCompliance = document.getElementById('badge-compliance');
    const limitationText = document.getElementById('limitation-text');
    const actionLabel = document.getElementById('action-label');
    const mitigationText = document.getElementById('mitigation-text');

    const svgPlume = document.getElementById('svg-plasma-plume');
    const svgCore = document.getElementById('svg-core-jet');
    const svgUvHalo = document.getElementById('svg-uv-halo');

    // Preset Buttons
    const btnPet = document.getElementById('btn-preset-pet');
    const btnCarton = document.getElementById('btn-preset-carton');
    const btnBlister = document.getElementById('btn-preset-blister');
    const btnEgg = document.getElementById('btn-preset-egg');
    const btnHazard = document.getElementById('btn-preset-hazard');

    function calculateDiagnostics() {
      if (!sliderPower || !sliderExposure || !sliderFlow || !sliderStandoff) return;

      const powerW = parseFloat(sliderPower.value);
      const exposureSec = parseFloat(sliderExposure.value);
      const flowSlpm = parseFloat(sliderFlow.value);
      const standoffMm = parseFloat(sliderStandoff.value);

      if (valPower) valPower.textContent = `${powerW} W`;
      if (valExposure) valExposure.textContent = `${exposureSec.toFixed(1)} s`;
      if (valFlow) valFlow.textContent = `${flowSlpm} SLPM`;
      if (valStandoff) valStandoff.textContent = `${standoffMm} mm`;

      const genId = selGenerator ? selGenerator.value : 'commercial_industrial_apmpj_skid';
      const gasId = selGas ? selGas.value : 'argon_oxygen_ros_mix';
      const subId = selSubstrate ? selSubstrate.value : 'pet_bottle_preforms_caps';
      const exhId = selExhaust ? selExhaust.value : 'catalytic_mno2_cuo_hopcalite_scrubber';

      // Physics factors
      let genEfficiency = 0.92;
      let isCompromised = false;
      if (genId === 'compromised_arcing_plasma_applicator') {
        genEfficiency = 0.45;
        isCompromised = true;
      } else if (genId === 'continuous_packaging_web_plasma_tunnel') {
        genEfficiency = 0.88;
      } else if (genId === 'precision_pharmaceutical_micro_jet_array') {
        genEfficiency = 0.90;
      }

      // Gas multipliers
      let uvGasMult = 1.0;
      let radicalGasMult = 1.0;
      let thermalGasMult = 1.0;

      if (gasId === 'argon_oxygen_ros_mix') {
        uvGasMult = 1.15;
        radicalGasMult = 1.35;
        thermalGasMult = 0.95;
      } else if (gasId === 'nitrogen_compressed_air_rns_mix') {
        uvGasMult = 0.85;
        radicalGasMult = 1.10;
        thermalGasMult = 1.15;
      } else if (gasId === 'pure_argon_uv_photonic_mix') {
        uvGasMult = 1.45;
        radicalGasMult = 0.60;
        thermalGasMult = 0.85;
      } else if (gasId === 'helium_water_vapor_cold_mix') {
        uvGasMult = 0.70;
        radicalGasMult = 1.25;
        thermalGasMult = 0.45;
      } else if (gasId === 'unfiltered_ambient_air_high_humidity') {
        uvGasMult = 0.40;
        radicalGasMult = 0.50;
        thermalGasMult = 2.40;
        isCompromised = true;
      }

      // Substrate thermal & pathogen limits
      let maxAllowableDeltaT = 15.0;
      let dValueNominal = 0.18;
      if (subId === 'pet_bottle_preforms_caps') {
        maxAllowableDeltaT = 15.0;
        dValueNominal = 0.18;
      } else if (subId === 'aseptic_carton_foil_laminate_web') {
        maxAllowableDeltaT = 22.0;
        dValueNominal = 0.14;
      } else if (subId === 'thermoformed_medical_blister_foil') {
        maxAllowableDeltaT = 8.0;
        dValueNominal = 0.10;
      } else if (subId === 'food_conveyor_shell_egg_fresh_produce') {
        maxAllowableDeltaT = 10.0;
        dValueNominal = 0.25;
      }

      // Exhaust destruction
      let destructionPct = 99.98;
      let stackO3Ppm = 0.02;
      let stackNo2Ppm = 0.15;
      if (exhId === 'dual_stage_acid_scrubber_hepa') {
        destructionPct = 99.50;
        stackO3Ppm = 0.04;
        stackNo2Ppm = 0.10;
      } else if (exhId === 'compromised_direct_exhaust_vent') {
        destructionPct = 48.0;
        stackO3Ppm = 0.95;
        stackNo2Ppm = 3.40;
      }

      // Physics Calculations:
      // 1. Power Density (W/cm3)
      const plasmaVolCm3 = (Math.PI * Math.pow(1.2, 2) * (standoffMm / 10)) * 2.5;
      const powerDensityW = ((powerW * genEfficiency) / Math.max(5.0, plasmaVolCm3));

      // 2. UV-C Photonic Fluence (mJ/cm2)
      const distanceAttenuation = Math.pow(15.0 / Math.max(5.0, standoffMm), 1.6);
      const uvIntensityMw = (powerW / 1000) * 55.0 * uvGasMult * genEfficiency * distanceAttenuation;
      const uvFluenceMj = (uvIntensityMw * exposureSec);

      // 3. Reactive Radical Flux (ppm)
      const radicalFluxPpm = (powerW / 1000) * (40 / Math.max(10, flowSlpm)) * 140.0 * radicalGasMult * (15.0 / standoffMm);

      // 4. Microbial Spore Inactivation Log Reduction
      // Synergistic D-value reduction through UV-C and radicals
      const uvFactor = Math.pow(Math.max(10, uvIntensityMw) / 50.0, 0.45);
      const radFactor = Math.pow(Math.max(20, radicalFluxPpm) / 100.0, 0.35);
      const effectiveDValue = dValueNominal / (uvFactor * radFactor);
      let logReduction = exposureSec / Math.max(0.04, effectiveDValue);
      if (isCompromised) logReduction *= 0.55;

      // 5. Substrate Surface Temperature Rise
      // Delta T = (2 * q'' * sqrt(t)) / sqrt(pi * k * rho * cp)
      const thermalHeatFlux = (powerDensityW * 0.42 * thermalGasMult) * (18.0 / Math.max(5.0, standoffMm));
      let deltaTSurf = (thermalHeatFlux * Math.sqrt(exposureSec) * 0.95);
      if (gasId === 'unfiltered_ambient_air_high_humidity') deltaTSurf *= 2.2;

      // Update DOM Diagnostics
      if (metricLogReduction) {
        metricLogReduction.textContent = `${logReduction.toFixed(1)} Log`;
        if (logReduction >= 6.0) {
          metricLogReduction.className = 'text-2xl font-mono font-extrabold text-violet-800';
          if (subLogReduction) subLogReduction.textContent = '≥ 6.0 Log (Sterile Commercial Standard)';
        } else if (logReduction >= 4.5) {
          metricLogReduction.className = 'text-2xl font-mono font-extrabold text-emerald-700';
          if (subLogReduction) subLogReduction.textContent = 'Commercial Food Sanitization Standard';
        } else {
          metricLogReduction.className = 'text-2xl font-mono font-extrabold text-amber-700';
          if (subLogReduction) subLogReduction.textContent = 'Insufficient Spore Inactivation (<4.5 Log)';
        }
      }

      if (metricUvFluence) {
        metricUvFluence.textContent = `${uvFluenceMj.toFixed(1)} mJ/cm²`;
        if (subUvFluence) subUvFluence.textContent = uvFluenceMj >= 80 ? 'High Photonic DNA Inactivation' : 'Low Photonic Fluence';
      }

      if (metricRadicalFlux) {
        metricRadicalFlux.textContent = `${radicalFluxPpm.toFixed(0)} ppm`;
        if (subRadicalFlux) subRadicalFlux.textContent = radicalFluxPpm >= 120 ? 'Active Radical Coat Oxidation' : 'Moderate Oxidative Action';
      }

      if (metricThermalRise) {
        metricThermalRise.textContent = `+${deltaTSurf.toFixed(1)}°C`;
        if (deltaTSurf > maxAllowableDeltaT) {
          metricThermalRise.className = 'text-2xl font-mono font-extrabold text-red-600';
          if (subThermalRise) subThermalRise.textContent = `EXCEEDED (Max Limit: ${maxAllowableDeltaT}°C)`;
        } else {
          metricThermalRise.className = 'text-2xl font-mono font-extrabold text-emerald-700';
          if (subThermalRise) subThermalRise.textContent = `Safe Margin (Max Limit: ${maxAllowableDeltaT}°C)`;
        }
      }

      if (metricPowerDensity) {
        metricPowerDensity.textContent = `${powerDensityW.toFixed(0)} W/cm³`;
        if (subPowerDensity) subPowerDensity.textContent = isCompromised ? 'Erratic Arcing Discharge' : 'Dense Non-Thermal Glow';
      }

      if (metricOshaExhaust) {
        metricOshaExhaust.textContent = `${destructionPct.toFixed(2)}%`;
        if (exhId === 'compromised_direct_exhaust_vent') {
          metricOshaExhaust.className = 'text-2xl font-mono font-extrabold text-red-600';
          if (subOshaExhaust) subOshaExhaust.textContent = `CRITICAL: Stack O3 ~ ${stackO3Ppm} ppm (OSHA Violation)`;
        } else {
          metricOshaExhaust.className = 'text-2xl font-mono font-extrabold text-emerald-700';
          if (subOshaExhaust) subOshaExhaust.textContent = `Stack O3 < ${stackO3Ppm} ppm (OSHA Compliant)`;
        }
      }

      // Update SVG Visuals
      const plumeWidth = Math.min(180, Math.max(60, (powerW / 1800) * 120 * (standoffMm / 15)));
      const plumeHeight = Math.min(100, Math.max(30, standoffMm * 2.8));
      const plumeYEnd = 95 + plumeHeight;

      if (svgPlume) {
        const xLeft = 320 - plumeWidth / 2;
        const xRight = 320 + plumeWidth / 2;
        svgPlume.setAttribute('d', `M 300,95 C ${xLeft + 20},${95 + plumeHeight * 0.5} ${xLeft},${plumeYEnd - 5} ${xLeft},${plumeYEnd} C 300,${plumeYEnd + 4} 340,${plumeYEnd + 4} ${xRight},${plumeYEnd} C ${xRight},${plumeYEnd - 5} ${xRight - 20},${95 + plumeHeight * 0.5} 340,95 Z`);
        if (isCompromised) {
          svgPlume.setAttribute('fill', '#f87171');
        } else if (gasId === 'pure_argon_uv_photonic_mix') {
          svgPlume.setAttribute('fill', 'url(#plasmaGlow)');
        } else {
          svgPlume.setAttribute('fill', 'url(#plasmaGlow)');
        }
      }

      if (svgUvHalo) {
        svgUvHalo.setAttribute('rx', `${Math.max(40, uvIntensityMw * 0.8)}`);
        svgUvHalo.setAttribute('ry', `${Math.max(25, uvIntensityMw * 0.45)}`);
        svgUvHalo.setAttribute('cy', `${95 + plumeHeight * 0.6}`);
      }

      // Compliance Status Evaluation
      if (deltaTSurf > maxAllowableDeltaT || isCompromised || exhId === 'compromised_direct_exhaust_vent') {
        if (badgeCompliance) {
          badgeCompliance.textContent = 'HAZARD: THERMAL RUNAWAY OR EXHAUST NON-COMPLIANCE';
          badgeCompliance.className = 'px-3 py-1 rounded-full text-xs font-bold bg-red-100 text-red-800';
        }
        if (limitationText) {
          limitationText.textContent = `Substrate thermal limit exceeded (ΔT = +${deltaTSurf.toFixed(1)}°C > ${maxAllowableDeltaT}°C limit) or exhaust ventilation violates OSHA 1910.1000 stack limits (${stackO3Ppm} ppm O3). Risk of substrate shrinkage, blistering, or personnel toxin exposure.`;
        }
        if (actionLabel) actionLabel.textContent = 'Mandatory Safety Action';
        if (mitigationText) {
          mitigationText.textContent = 'Increase line conveyor speed to reduce exposure residence time, increase nozzle standoff distance (≥15 mm), service Hopcalite catalytic off-gas destruction unit, and inspect microwave impedance matching stubs.';
        }
      } else if (logReduction < 5.0) {
        if (badgeCompliance) {
          badgeCompliance.textContent = 'SUB-OPTIMAL: INSUFFICIENT PATHOGEN LOG REDUCTION';
          badgeCompliance.className = 'px-3 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-800';
        }
        if (limitationText) {
          limitationText.textContent = `Spore inactivation (${logReduction.toFixed(1)} Log) does not meet sterile commercial packaging target (≥5.0 to 6.0 Log). UV-C photonic fluence (${uvFluenceMj.toFixed(1)} mJ/cm²) is insufficient to achieve thorough bacterial endospore lethality.`;
        }
        if (actionLabel) actionLabel.textContent = 'Process Optimization Action';
        if (mitigationText) {
          mitigationText.textContent = 'Increase microwave absorbed power, optimize carrier gas oxygen ratio (3% O2 in Argon), or decrease conveyor web speed to provide adequate photonic dwell time.';
        }
      } else {
        if (badgeCompliance) {
          badgeCompliance.textContent = 'FDA 21 CFR § 179.26 & cGMP COMPLIANT';
          badgeCompliance.className = 'px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800';
        }
        if (limitationText) {
          limitationText.textContent = `Full commercial spore lethality achieved (${logReduction.toFixed(1)} Log reduction). Photonic fluence (${uvFluenceMj.toFixed(1)} mJ/cm²) and radical flux (${radicalFluxPpm.toFixed(0)} ppm) provide rapid sterilization while keeping substrate thermal rise (+${deltaTSurf.toFixed(1)}°C) safely below polymer thresholds.`;
        }
        if (actionLabel) actionLabel.textContent = 'Recommended In-Line Operation';
        if (mitigationText) {
          mitigationText.textContent = 'Maintain steady-state microwave generator power, monitor automated impedance matchers, verify cooling water flow (2.5 L/min at 18°C), and ensure catalytic ozone stack sensor verification.';
        }
      }
    }

    // Attach Listeners
    [selGenerator, selGas, selSubstrate, selExhaust].forEach(el => {
      if (el) el.addEventListener('change', calculateDiagnostics);
    });

    [sliderPower, sliderExposure, sliderFlow, sliderStandoff].forEach(sl => {
      if (sl) sl.addEventListener('input', calculateDiagnostics);
    });

    // Preset Handlers
    if (btnPet) {
      btnPet.addEventListener('click', () => {
        if (selGenerator) selGenerator.value = 'commercial_industrial_apmpj_skid';
        if (selGas) selGas.value = 'argon_oxygen_ros_mix';
        if (selSubstrate) selSubstrate.value = 'pet_bottle_preforms_caps';
        if (selExhaust) selExhaust.value = 'catalytic_mno2_cuo_hopcalite_scrubber';
        if (sliderPower) sliderPower.value = '1800';
        if (sliderExposure) sliderExposure.value = '0.8';
        if (sliderFlow) sliderFlow.value = '35';
        if (sliderStandoff) sliderStandoff.value = '15';
        calculateDiagnostics();
      });
    }

    if (btnCarton) {
      btnCarton.addEventListener('click', () => {
        if (selGenerator) selGenerator.value = 'continuous_packaging_web_plasma_tunnel';
        if (selGas) selGas.value = 'nitrogen_compressed_air_rns_mix';
        if (selSubstrate) selSubstrate.value = 'aseptic_carton_foil_laminate_web';
        if (selExhaust) selExhaust.value = 'catalytic_mno2_cuo_hopcalite_scrubber';
        if (sliderPower) sliderPower.value = '2400';
        if (sliderExposure) sliderExposure.value = '0.5';
        if (sliderFlow) sliderFlow.value = '55';
        if (sliderStandoff) sliderStandoff.value = '12';
        calculateDiagnostics();
      });
    }

    if (btnBlister) {
      btnBlister.addEventListener('click', () => {
        if (selGenerator) selGenerator.value = 'precision_pharmaceutical_micro_jet_array';
        if (selGas) selGas.value = 'helium_water_vapor_cold_mix';
        if (selSubstrate) selSubstrate.value = 'thermoformed_medical_blister_foil';
        if (selExhaust) selExhaust.value = 'dual_stage_acid_scrubber_hepa';
        if (sliderPower) sliderPower.value = '900';
        if (sliderExposure) sliderExposure.value = '0.4';
        if (sliderFlow) sliderFlow.value = '25';
        if (sliderStandoff) sliderStandoff.value = '10';
        calculateDiagnostics();
      });
    }

    if (btnEgg) {
      btnEgg.addEventListener('click', () => {
        if (selGenerator) selGenerator.value = 'commercial_industrial_apmpj_skid';
        if (selGas) selGas.value = 'nitrogen_compressed_air_rns_mix';
        if (selSubstrate) selSubstrate.value = 'food_conveyor_shell_egg_fresh_produce';
        if (selExhaust) selExhaust.value = 'catalytic_mno2_cuo_hopcalite_scrubber';
        if (sliderPower) sliderPower.value = '1200';
        if (sliderExposure) sliderExposure.value = '1.2';
        if (sliderFlow) sliderFlow.value = '40';
        if (sliderStandoff) sliderStandoff.value = '20';
        calculateDiagnostics();
      });
    }

    if (btnHazard) {
      btnHazard.addEventListener('click', () => {
        if (selGenerator) selGenerator.value = 'compromised_arcing_plasma_applicator';
        if (selGas) selGas.value = 'unfiltered_ambient_air_high_humidity';
        if (selSubstrate) selSubstrate.value = 'pet_bottle_preforms_caps';
        if (selExhaust) selExhaust.value = 'compromised_direct_exhaust_vent';
        if (sliderPower) sliderPower.value = '3000';
        if (sliderExposure) sliderExposure.value = '2.5';
        if (sliderFlow) sliderFlow.value = '12';
        if (sliderStandoff) sliderStandoff.value = '6';
        calculateDiagnostics();
      });
    }

    // Initial run
    calculateDiagnostics();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMicrowavePlasmaModeler);
  } else {
    initMicrowavePlasmaModeler();
  }
</script>
