    tablespoons: '汤匙',
    grams: '克 (g)',
    fluidOz: '液盎司',
    minutes: '分钟',
    cycles: '轮满水箱冲洗',
    everyDays: '每 {days} 天一次'
  },
  ja: {
    kicker: 'クエン酸・ホワイトビネガー希釈エンジン',
    heading: '家電製品・ケトル・コーヒーメーカー除垢比率計算機',
    subheading: 'ドリップコーヒーメーカー、電気ケトル、ネスプレッソ、カプセル式、エスプレッソマシンのボイラーに対応。ヒーター管やゴムパッキンを傷めない食品グレードクエン酸のグラム数、5%蒸留酢、専用除石灰剤の最適比率を即座に算出します。',
    step1: '1. 除垢する家電を選択',
    step2: '2. 給水タンク／ケトル容量',
    step3: '3. 使用する除垢剤',
    step4: '4. 水道水の硬度レベル',
    resultsTitle: '正確な除垢配合と洗浄サイクル',
    doseLabel: '除垢剤の適量',
    waterLabel: '使用するぬるま湯量',
    ratioLabel: '目標酸濃度',
    soakLabel: 'つけ置き反応時間',
    rinseLabel: 'きれいな水でのすすぎ回数',
    frequencyLabel: '推奨メンテナンス頻度',
    safetyTitle: '素材相性と化学的安全性',
    stepsTitle: 'ステップ別除垢・洗浄手順',
    compatibilityTitle: 'ボイラーおよび内部加熱部の金属材質',
    cautionNotice: '注意して使用 — つけ置き時間とすすぎ回数を厳格に守ってください。',
    dangerNotice: '使用禁止 — 内部の金属ボイラーを激しく腐食またはメッキ剥離させます。',
    safeNotice: '安全確認済み — ヒーター管およびパッキン素材に適合しています。',
    printBtn: '手順を印刷／保存',
    resetBtn: '初期値に戻す',
    unitMl: 'ml',
    unitL: 'リットル',
    unitOz: 'オンス',
    unitCups: 'カップ',
    tablespoons: '大さじ',
    grams: 'g',
