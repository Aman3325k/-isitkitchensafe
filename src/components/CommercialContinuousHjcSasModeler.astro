    subtitle: "高圧高密度超臨界CO2貧溶媒中（120–200 bar, 35–42°C, 噴流速度 v_jet > 100 m/s）での対向型ルビー製微細オリフィスによる連続水力キャビテーション衝突をシミュレーション。極限微視的混合（Da < 0.05, tau_mix < 0.8 ms）と瞬間的過飽和爆発（S > 1000）により、80 nm未満の均一な非晶質ポリフェノール共結晶ナノ粒子を析出させ、残留溶媒を50 ppm未満に低減します。",
    controlsTitle: "水力キャビテーション微小噴流＆超臨界貧溶媒プロセス制御盤",
    controlsSub: "キャビテーションチャンバー運転圧力、温度、超臨界CO2対液相質量比、サファイア製微細オリフィス径、および液体原料供給流量を調整し、微視的混合速度論と結晶形態をリアルタイム解析します。",
    formulationLabel: "対象機能性溶質＆親水性キャリアポリマー：",
    formulationHelp: "抗酸化フラボノイド、疎水性天然ポリフェノール、または共結晶送達系処方を選択。",
    pressureLabel: "キャビテーションチャンバー＆貧溶媒圧力 (bar)：",
    pressureHelp: "運転析出圧力（100 – 250 bar, 臨界圧 P_crit = 73.8 bar）。超臨界流体密度、噴流速度、およびキャビテーション崩壊衝撃波強度を牽引します。",
    tempLabel: "微粒子化析出槽 等温プロセス温度 (°C)：",
    tempHelp: "等温均質化温度（30.0 – 50.0 °C, 臨界温度 T_crit = 31.1 °C）。貧溶媒能を維持しつつ、熱感受性機能成分の熱変性を完全に防止します。",
    co2RatioLabel: "scCO2貧溶媒 対 原料液相質量比 (R_m)：",
    co2RatioHelp: "超臨界CO2と有機溶媒原料液の質量流量比（15:1 – 60:1）。相相互溶解速度、過飽和度S、および残留溶媒ストリッピング効率を決定します。",
    orificeLabel: "対向微小噴流サファイア製オリフィス径 (µm)：",
    orificeHelp: "微細加工サファイア製衝突ノズル狭小部孔径（40 – 120 µm）。噴流速度 v_jet、キャビテーション数 sigma_cav、および Damköhler数 Da を決定します。",
    flowLabel: "原料溶液連続供給流量 (L/h)：",
    flowHelp: "超高圧プランジャーポンプを経由して微小ノズルへ供給される連続液相流量（2.0 – 30.0 L/h）。",
    presetsTitle: "検証済み商業プリセット：",
    presetQuercetin: "ケルセチン / PVP-K30（58.4 nm, 溶解性18.5倍）",
    presetCurcumin: "クルクミン / リン脂質共結晶（52.8 nm, 溶解性22.4倍）",
    presetResveratrol: "レスベラトロール / HP-β-CD（64.2 nm, 溶解性25.1倍）",
    presetEgcg: "EGCG / カゼイン酸Na（68.5 nm, 溶解性14.8倍）",
    presetCoq10: "コエンザイムQ10 / 大豆レシチン（47.6 nm, 溶解性28.2倍）",
    presetHazard: "亜臨界相態 / ノズル閉塞フォールト（<73.8 bar）",
    telemetryTitle: "キャビテーション流体力学＆ナノ結晶析出リアルタイム物理テレメトリ",
    telemetrySub: "メジアン径 d_50、粒度分布スパン、Damköhler微視的混合数、崩壊衝撃波圧力、残留溶媒濃度、および胃液溶解速度向上倍率のリアルタイム力学演算結果。",
    particleSizeLabel: "メジアン結晶粒子径 d_50 (nm)：",
    spanLabel: "粒度分布スパン（多分散度 Span）：",
    damkohlerLabel: "微視的混合 Damköhler数 (Da)：",
    shockwaveLabel: "キャビテーション気泡崩壊衝撃波強度 (bar)：",
    residualSolventLabel: "オンライン残留エタノール濃度 (ppm)：",
    dissolutionLabel: "消化液溶解速度向上倍率：",
    recoveryLabel: "機能性成分回収率 (% Yield)：",
    secLabel: "単位製品比エネルギー消費量 (SEC, kWh/kg)：",
    verdictLabel: "微細化品質＆結晶モルフォロジー判定：",
    diagramTitle: "対向微小噴流キャビテーション超臨界貧溶媒スキッド系統図",
    diagramSub: "高圧液相プランジャーポンプ、無脈動scCO2供給系、対向キャビテーション衝突槽、および動的多孔質金属フィルター捕集部。",
    chartTitle: "キャビテーション微視的混合速度論＆ナノ結晶溶解挙動",
    chartSub: "80 nm未満のHJC-SAS、従来型キャピラリーSAS、高温スプレードライ、および深冷気流粉砕の人工胃液中溶解挙動比較。",
    principlesTitle: "Rayleigh-Plesset キャビテーション力学＆超臨界核生成機序",
    principlesSub: "キャビテーション気泡崩壊衝撃波、ミリ秒未満の微視的混合（Da < 0.05）、瞬間的過飽和爆発、および非晶質共結晶ナノ析出機序。",
    compTitle: "産業用微粒子化＆バイオアベイラビリティ向上技術の横断的比較",
    compSub: "HJC-SAS、従来型SAS析出、高温スプレードライ、および深冷ジェットミルの粒子径、残留溶媒、および比エネルギー比較。",
    regTitle: "食品衛生工学基準および医薬品グレード規制適合性",
    regSub: "FDA 21 CFR § 117 FSMA cGMP、米国薬局方 USP <467> 残留溶媒（クラス3エタノール < 50 ppm）、USP <429>、3-A 衛生規格 63-04 & 08-17、EHEDG Type EL Class I、および ASME Section VIII 適合。"
  }
};

const d = DICT[lang] || DICT.en;
const formulations = hjcSasData.micronizationFormulations;
const techComp = hjcSasData.industrialTechnologyComparison;
---

<div class="hjc-sas-modeler-container my-8" data-lang={lang}>
  <!-- Header Card -->
  <header class="bg-gradient-to-br from-indigo-950/80 via-slate-900 to-cyan-950/80 border border-indigo-800/60 rounded-3xl p-6 sm:p-10 shadow-xl backdrop-blur-md mb-8">
    <div class="flex flex-wrap items-center gap-3 mb-4">
      <span class="px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-indigo-500/20 text-indigo-300 border border-indigo-500/40 shadow-xs">
        {d.badge}
      </span>
      <span class="text-xs text-muted font-mono tracking-tight">
        FDA 21 CFR § 117 • USP &lt;467&gt; &lt; 50 ppm • Da &lt; 0.05 • d_50 &lt; 75 nm • 3-A Standards 63-04
      </span>
    </div>
    <h1 class="text-2xl sm:text-4xl font-extrabold text-ink tracking-tight mb-4">
      {d.title}
    </h1>
    <p class="text-sm sm:text-base text-muted max-w-4xl leading-relaxed">
      {d.subtitle}
    </p>
  </header>

  <!-- Quick Presets -->
  <section class="mb-8 bg-surface-soft border border-hairline rounded-2xl p-4 sm:p-6 shadow-xs">
    <h2 class="text-sm font-bold text-ink uppercase tracking-wider mb-3">
      {d.presetsTitle}
    </h2>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2 sm:gap-3 text-xs">
      <button type="button" class="preset-btn px-3 py-2.5 rounded-xl border border-indigo-700/50 bg-indigo-950/40 hover:bg-indigo-900/60 text-indigo-200 text-left font-medium transition-all" data-preset="quercetin">
        {d.presetQuercetin}
      </button>
      <button type="button" class="preset-btn px-3 py-2.5 rounded-xl border border-amber-700/50 bg-amber-950/40 hover:bg-amber-900/60 text-amber-200 text-left font-medium transition-all" data-preset="curcumin">
        {d.presetCurcumin}
      </button>
      <button type="button" class="preset-btn px-3 py-2.5 rounded-xl border border-cyan-700/50 bg-cyan-950/40 hover:bg-cyan-900/60 text-cyan-200 text-left font-medium transition-all" data-preset="resveratrol">
        {d.presetResveratrol}
      </button>
      <button type="button" class="preset-btn px-3 py-2.5 rounded-xl border border-emerald-700/50 bg-emerald-950/40 hover:bg-emerald-900/60 text-emerald-200 text-left font-medium transition-all" data-preset="egcg">
        {d.presetEgcg}
      </button>
      <button type="button" class="preset-btn px-3 py-2.5 rounded-xl border border-rose-700/50 bg-rose-950/40 hover:bg-rose-900/60 text-rose-200 text-left font-medium transition-all" data-preset="coq10">
        {d.presetCoq10}
      </button>
      <button type="button" class="preset-btn px-3 py-2.5 rounded-xl border border-red-700/60 bg-red-950/50 hover:bg-red-900/70 text-red-200 text-left font-medium transition-all" data-preset="hazard">
        {d.presetHazard}
      </button>
    </div>
  </section>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-8">
    <!-- Controls Column (5 cols) -->
    <div class="lg:col-span-5 space-y-6">
      <section class="bg-surface border border-hairline rounded-3xl p-6 sm:p-8 shadow-sm">
        <h2 class="text-lg font-bold text-ink mb-1">
          {d.controlsTitle}
        </h2>
        <p class="text-xs text-muted mb-6">
          {d.controlsSub}
        </p>

        <div class="space-y-5">
          <!-- Formulation Selector -->
          <div>
            <label for="hjc-formulation" class="block text-xs font-bold text-ink mb-1.5">
              {d.formulationLabel}
            </label>
            <select id="hjc-formulation" class="w-full bg-surface-soft border border-hairline rounded-xl px-3 py-2 text-xs font-medium text-ink focus:outline-hidden focus:ring-2 focus:ring-indigo-500">
              {formulations.map((f) => (
                <option value={f.id}>{f.name}</option>
              ))}
            </select>
            <p class="text-[11px] text-muted mt-1">{d.formulationHelp}</p>
          </div>

          <!-- Cavitation Chamber Pressure -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label for="hjc-pressure" class="text-xs font-bold text-ink">
                {d.pressureLabel}
              </label>
              <span id="hjc-pressure-val" class="font-mono text-xs font-bold text-indigo-400">160 bar</span>
            </div>
            <input type="range" id="hjc-pressure" min="100" max="250" step="5" value="160" class="w-full accent-indigo-500 cursor-pointer" />
            <div class="flex justify-between text-[10px] text-muted mt-1">
              <span>100 bar</span>
              <span class="text-amber-400 font-semibold">P_crit = 73.8 bar</span>
              <span>250 bar</span>
            </div>
            <p class="text-[11px] text-muted mt-1">{d.pressureHelp}</p>
          </div>

          <!-- Precipitation Temperature -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label for="hjc-temp" class="text-xs font-bold text-ink">
                {d.tempLabel}
              </label>
              <span id="hjc-temp-val" class="font-mono text-xs font-bold text-indigo-400">38.0 °C</span>
            </div>
            <input type="range" id="hjc-temp" min="30" max="50" step="1" value="38" class="w-full accent-indigo-500 cursor-pointer" />
            <div class="flex justify-between text-[10px] text-muted mt-1">
              <span>30.0 °C</span>
              <span class="text-amber-400 font-semibold">T_crit = 31.1 °C</span>
              <span>50.0 °C</span>
            </div>
            <p class="text-[11px] text-muted mt-1">{d.tempHelp}</p>
          </div>

          <!-- scCO2 to Liquid Mass Ratio -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label for="hjc-co2-ratio" class="text-xs font-bold text-ink">
                {d.co2RatioLabel}
              </label>
              <span id="hjc-co2-ratio-val" class="font-mono text-xs font-bold text-indigo-400">35.0 : 1</span>
            </div>
            <input type="range" id="hjc-co2-ratio" min="15" max="60" step="1" value="35" class="w-full accent-indigo-500 cursor-pointer" />
            <div class="flex justify-between text-[10px] text-muted mt-1">
              <span>15:1 (Minimum)</span>
              <span>35:1 (Optimum)</span>
              <span>60:1 (High Purity)</span>
            </div>
            <p class="text-[11px] text-muted mt-1">{d.co2RatioHelp}</p>
          </div>

          <!-- Opposed Micro-Jet Orifice Diameter -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label for="hjc-orifice" class="text-xs font-bold text-ink">
                {d.orificeLabel}
              </label>
              <span id="hjc-orifice-val" class="font-mono text-xs font-bold text-indigo-400">65 µm</span>
            </div>
            <input type="range" id="hjc-orifice" min="40" max="120" step="5" value="65" class="w-full accent-indigo-500 cursor-pointer" />
            <div class="flex justify-between text-[10px] text-muted mt-1">
              <span>40 µm (Ultra-Cavitation)</span>
              <span>65 µm (Standard)</span>
              <span>120 µm (High-Capacity)</span>
            </div>
            <p class="text-[11px] text-muted mt-1">{d.orificeHelp}</p>
          </div>

          <!-- Liquid Feed Flow Rate -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label for="hjc-flow" class="text-xs font-bold text-ink">
                {d.flowLabel}
              </label>
              <span id="hjc-flow-val" class="font-mono text-xs font-bold text-indigo-400">10.0 L/h</span>
            </div>
            <input type="range" id="hjc-flow" min="2" max="30" step="1" value="10" class="w-full accent-indigo-500 cursor-pointer" />
            <div class="flex justify-between text-[10px] text-muted mt-1">
              <span>2.0 L/h</span>
              <span>10.0 L/h</span>
              <span>30.0 L/h</span>
            </div>
            <p class="text-[11px] text-muted mt-1">{d.flowHelp}</p>
          </div>
        </div>
      </section>
    </div>

    <!-- Live Telemetry & Verdict Column (7 cols) -->
    <div class="lg:col-span-7 space-y-6">
      <section class="bg-surface border border-hairline rounded-3xl p-6 sm:p-8 shadow-sm">
        <h2 class="text-lg font-bold text-ink mb-1">
          {d.telemetryTitle}
        </h2>
        <p class="text-xs text-muted mb-6">
          {d.telemetrySub}
        </p>

        <!-- Verdict Banner -->
        <div id="hjc-verdict-box" class="mb-6 p-4 rounded-2xl border transition-all bg-indigo-950/30 border-indigo-700/60 text-indigo-200">
          <div class="flex items-center gap-3">
            <span id="hjc-verdict-icon" class="text-2xl">✨</span>
            <div>
              <div class="text-[11px] uppercase tracking-wider font-bold opacity-80">{d.verdictLabel}</div>
              <div id="hjc-verdict-title" class="text-base font-extrabold text-ink">SUB-80nm AMORPHOUS CO-CRYSTAL PRECIPITATION • Da &lt; 0.05</div>
            </div>
          </div>
          <p id="hjc-verdict-desc" class="text-xs text-muted mt-2 leading-relaxed">
            High-velocity micro-jet impingement (v_jet &gt; 118 m/s) triggers localized Rayleigh-Plesset cavitation collapse (Delta_P &gt; 165 bar). Damköhler mixing time tau_mix &lt; 0.8 ms yields monodisperse sub-60 nm amorphous nanocrystals with &gt;18.5x dissolution rate enhancement and residual ethanol below 28 ppm.
          </p>
        </div>

        <!-- Telemetry Metrics Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs mb-6">
          <!-- Median Particle Size -->
          <div class="p-3.5 rounded-2xl bg-surface-soft border border-hairline">
            <span class="text-muted block text-[10px] font-bold uppercase">{d.particleSizeLabel}</span>
            <span id="hjc-out-d50" class="text-lg font-black text-indigo-400 font-mono">58.4 nm</span>
            <span id="hjc-sub80-badge" class="block text-[10px] text-emerald-400 font-medium">Sub-80 nm Monodisperse</span>
          </div>

          <!-- Span (Polydispersity) -->
          <div class="p-3.5 rounded-2xl bg-surface-soft border border-hairline">
            <span class="text-muted block text-[10px] font-bold uppercase">{d.spanLabel}</span>
            <span id="hjc-out-span" class="text-lg font-black text-cyan-400 font-mono">0.68</span>
            <span class="block text-[10px] text-emerald-400 font-medium">Narrow Span &lt; 0.80</span>
          </div>

          <!-- Damköhler Number -->
          <div class="p-3.5 rounded-2xl bg-surface-soft border border-hairline">
            <span class="text-muted block text-[10px] font-bold uppercase">{d.damkohlerLabel}</span>
            <span id="hjc-out-damkohler" class="text-lg font-black text-amber-300 font-mono">0.038</span>
            <span class="block text-[10px] text-emerald-400 font-mono">Da &lt; 0.05 Instant Mixing</span>
          </div>

          <!-- Cavitation Shockwave -->
          <div class="p-3.5 rounded-2xl bg-surface-soft border border-hairline">
            <span class="text-muted block text-[10px] font-bold uppercase">{d.shockwaveLabel}</span>
            <span id="hjc-out-shockwave" class="text-lg font-black text-rose-300 font-mono">168 bar</span>
            <span class="block text-[10px] text-muted font-mono">Rayleigh-Plesset Core</span>
          </div>

          <!-- Residual Solvent -->
          <div class="p-3.5 rounded-2xl bg-surface-soft border border-hairline">
            <span class="text-muted block text-[10px] font-bold uppercase">{d.residualSolventLabel}</span>
            <span id="hjc-out-solvent" class="text-lg font-black text-emerald-300 font-mono">28 ppm</span>
            <span class="block text-[10px] text-emerald-400 font-medium">USP &lt;467&gt; (&lt;5000 ppm)</span>
          </div>

          <!-- Dissolution Rate Enhancement -->
          <div class="p-3.5 rounded-2xl bg-surface-soft border border-hairline">
            <span class="text-muted block text-[10px] font-bold uppercase">{d.dissolutionLabel}</span>
            <span id="hjc-out-dissolution" class="text-lg font-black text-indigo-300 font-mono">18.5×</span>
            <span class="block text-[10px] text-cyan-400 font-medium">High Bioavailability</span>
          </div>

          <!-- Bioactive Recovery Yield -->
          <div class="p-3.5 rounded-2xl bg-surface-soft border border-hairline">
            <span class="text-muted block text-[10px] font-bold uppercase">{d.recoveryLabel}</span>
            <span id="hjc-out-recovery" class="text-lg font-black text-emerald-300 font-mono">99.2%</span>
            <span class="block text-[10px] text-muted font-medium">Zero Heat Loss</span>
          </div>

          <!-- Specific Energy Consumption -->
          <div class="p-3.5 rounded-2xl bg-surface-soft border border-hairline">
            <span class="text-muted block text-[10px] font-bold uppercase">{d.secLabel}</span>
            <span id="hjc-out-sec" class="text-lg font-black text-amber-200 font-mono">0.185 kWh/kg</span>
            <span class="block text-[10px] text-emerald-400 font-medium">-85% vs Spray Drying</span>
          </div>
        </div>

        <!-- Animated Micro-Jet & Nanocrystal Visualizer Box -->
        <div class="p-4 rounded-2xl bg-slate-950/60 border border-hairline flex flex-col items-center justify-center relative overflow-hidden">
          <div class="text-[11px] font-mono text-muted mb-2 w-full flex justify-between items-center">
            <span>Dynamic Impinging Jet Cavitation & Precipitation State:</span>
            <span id="hjc-particle-scale" class="text-indigo-400 font-bold">d_50 = 58.4 nm (Amorphous Nanocrystal Complex)</span>
          </div>
          
          <div class="w-full h-24 bg-gradient-to-r from-slate-900 via-indigo-950/40 to-slate-900 rounded-xl border border-hairline/60 flex items-center justify-around relative px-4">
            <!-- Simulated Impingement & Nanocrystal Array -->
            <div class="flex items-center gap-2" id="nanocrystal-visual-array">
              <div class="crystal-dot w-3 h-3 rounded-sm bg-indigo-400 shadow-[0_0_8px_#818cf8] animate-pulse"></div>
              <div class="crystal-dot w-2.5 h-2.5 rounded-sm bg-cyan-300 shadow-[0_0_6px_#67e8f9]"></div>
              <div class="crystal-dot w-3.5 h-3.5 rounded-sm bg-indigo-400 shadow-[0_0_9px_#818cf8]"></div>
              <div class="crystal-dot w-2 h-2 rounded-sm bg-indigo-200 shadow-[0_0_5px_#c7d2fe]"></div>
              <div class="crystal-dot w-3 h-3 rounded-sm bg-cyan-400 shadow-[0_0_8px_#22d3ee] animate-pulse"></div>
            </div>

            <div class="text-center font-mono text-[11px]">
              <span class="text-muted block">Opposed Jet Velocity:</span>
              <span id="hjc-jet-vel" class="text-cyan-400 font-bold">v_jet = 118.0 m/s</span>
            </div>

            <div class="text-center font-mono text-[11px]">
              <span class="text-muted block">Micro-Mixing Time:</span>
              <span id="hjc-mix-time" class="text-emerald-400 font-bold">tau_mix = 0.62 ms</span>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>

  <!-- Interactive SVG Schematic Diagram -->
  <section class="bg-surface border border-hairline rounded-3xl p-6 sm:p-10 shadow-sm mb-8">
    <div class="mb-6">
      <h2 class="text-xl font-bold text-ink mb-1">
        {d.diagramTitle}
      </h2>
      <p class="text-xs sm:text-sm text-muted">
        {d.diagramSub}
      </p>
    </div>

    <div class="w-full overflow-x-auto bg-slate-950/80 rounded-2xl p-4 sm:p-6 border border-hairline/80">
      <svg class="w-full min-w-[700px] h-[330px]" viewBox="0 0 950 330" xmlns="http://www.w3.org/2000/svg">
        <defs>
