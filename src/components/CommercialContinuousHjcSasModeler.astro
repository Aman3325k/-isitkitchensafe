<script>
  function initHjcSasModeler() {
    const container = document.querySelector('.hjc-sas-modeler-container');
    if (!container) return;

    // Sliders
    const formulationSelect = document.getElementById('hjc-formulation') as HTMLSelectElement | null;
    const pressureInput = document.getElementById('hjc-pressure') as HTMLInputElement | null;
    const tempInput = document.getElementById('hjc-temp') as HTMLInputElement | null;
    const co2RatioInput = document.getElementById('hjc-co2-ratio') as HTMLInputElement | null;
    const orificeInput = document.getElementById('hjc-orifice') as HTMLInputElement | null;
    const flowInput = document.getElementById('hjc-flow') as HTMLInputElement | null;

    // Value Labels
    const pressureVal = document.getElementById('hjc-pressure-val');
    const tempVal = document.getElementById('hjc-temp-val');
    const co2RatioVal = document.getElementById('hjc-co2-ratio-val');
    const orificeVal = document.getElementById('hjc-orifice-val');
    const flowVal = document.getElementById('hjc-flow-val');

    // Telemetry Outputs
    const outD50 = document.getElementById('hjc-out-d50');
    const outSpan = document.getElementById('hjc-out-span');
    const outDamkohler = document.getElementById('hjc-out-damkohler');
    const outShockwave = document.getElementById('hjc-out-shockwave');
    const outSolvent = document.getElementById('hjc-out-solvent');
    const outDissolution = document.getElementById('hjc-out-dissolution');
    const outRecovery = document.getElementById('hjc-out-recovery');
    const outSec = document.getElementById('hjc-out-sec');

    // Visuals & Charts
    const chartBar = document.getElementById('hjc-chart-bar');
    const chartBarVal = document.getElementById('hjc-chart-bar-val');
    const chartDissBar = document.getElementById('hjc-chart-diss-bar');
    const chartDissVal = document.getElementById('hjc-chart-diss-val');
    const verdictTitle = document.getElementById('hjc-verdict-title');
    const verdictDesc = document.getElementById('hjc-verdict-desc');
    const verdictBox = document.getElementById('hjc-verdict-box');
    const particleScale = document.getElementById('hjc-particle-scale');
    const jetVelText = document.getElementById('hjc-jet-vel');
    const mixTimeText = document.getElementById('hjc-mix-time');

    const presets = {
      quercetin: { form: 'quercetin_pvp_nanocrystal', p: 160, t: 38, rm: 35, orif: 65, flow: 10 },
      curcumin: { form: 'curcumin_phospholipid_cocrystal', p: 180, t: 36, rm: 42, orif: 55, flow: 8 },
      resveratrol: { form: 'resveratrol_cyclodextrin_inclusion', p: 150, t: 37, rm: 30, orif: 75, flow: 12 },
      egcg: { form: 'egcg_casein_nanoparticle', p: 170, t: 39, rm: 38, orif: 60, flow: 9 },
      coq10: { form: 'coq10_lecithin_amorphous', p: 190, t: 35, rm: 45, orif: 50, flow: 7 },
      hazard: { form: 'quercetin_pvp_nanocrystal', p: 65, t: 28, rm: 12, orif: 110, flow: 25 }
    };

    function recalculate() {
      const p = parseFloat(pressureInput?.value || '160');
      const t = parseFloat(tempInput?.value || '38');
      const rm = parseFloat(co2RatioInput?.value || '35');
      const orif = parseFloat(orificeInput?.value || '65');
      const flow = parseFloat(flowInput?.value || '10');

      if (pressureVal) pressureVal.textContent = `${p.toFixed(0)} bar`;
      if (tempVal) tempVal.textContent = `${t.toFixed(1)} °C`;
      if (co2RatioVal) co2RatioVal.textContent = `${rm.toFixed(0)} : 1`;
      if (orificeVal) orificeVal.textContent = `${orif.toFixed(0)} µm`;
      if (flowVal) flowVal.textContent = `${flow.toFixed(1)} L/h`;

      // Check supercritical state
      const isSupercritical = p >= 73.8 && t >= 31.1;

      // Hydrodynamics: Opposed Micro-Jet Velocity
      const orifM = orif * 1e-6;
      const singleNozzleFlowM3s = ((flow / 2) * 1e-3) / 3600;
      const nozzleArea = Math.PI * Math.pow(orifM / 2, 2);
      const vJet = singleNozzleFlowM3s / nozzleArea;

      // Micro-mixing time (ms) and Damköhler number
      const deltaPPa = p * 1e5;
      const rhoLiquid = 810; // kg/m3 for ethanol
      const tauMixMs = isSupercritical ? Math.max(0.25, 0.75 * Math.pow(65 / orif, 0.5) * Math.pow(160 / p, 0.6)) : 4.5;
      const tauIndMs = 15.0; // induction time ~ 15 ms
      const da = tauMixMs / tauIndMs;

      // Cavitation shockwave intensity
      const shockwaveBar = isSupercritical ? Math.min(220, 100 + (p - 100) * 0.7 + (vJet - 80) * 0.4) : 15;

      // Particle size d_50 (nm)
      let d50 = 0;
      let span = 0.68;
      let residualSolventPpm = 25.0;
      let dissolutionFactor = 18.0;
      let recovery = 99.2;

      if (isSupercritical) {
        d50 = Math.max(38.0, 58.4 * Math.pow(160 / p, 0.7) * Math.pow(orif / 65, 0.45) * Math.pow(35 / rm, 0.3));
        span = Math.min(1.2, Math.max(0.55, 0.68 + (orif - 65) * 0.003 - (rm - 35) * 0.004));
        residualSolventPpm = Math.max(12.0, 28.0 * (35 / rm) * (160 / p));
        dissolutionFactor = Math.min(30.0, Math.max(8.0, (1200 / d50) * 0.9));
        recovery = Math.max(92.0, 99.5 - (t > 44 ? (t - 44) * 0.5 : 0.1));
      } else {
        d50 = 650.0 + (100 - p) * 8.0;
        span = 2.45;
        residualSolventPpm = 1450.0;
        dissolutionFactor = 1.8;
        recovery = 85.0;
      }

      const sec = (p * 1e5 * singleNozzleFlowM3s * 2) / (flow * 0.8 * 3.6e3); // kWh/kg

      // DOM Updates
      if (outD50) outD50.textContent = `${d50.toFixed(1)} nm`;
      if (outSpan) outSpan.textContent = `${span.toFixed(2)}`;
      if (outDamkohler) outDamkohler.textContent = `${da.toFixed(3)}`;
      if (outShockwave) outShockwave.textContent = `${shockwaveBar.toFixed(0)} bar`;
      if (outSolvent) outSolvent.textContent = `${residualSolventPpm.toFixed(0)} ppm`;
      if (outDissolution) outDissolution.textContent = `${dissolutionFactor.toFixed(1)}×`;
      if (outRecovery) outRecovery.textContent = `${recovery.toFixed(1)}%`;
      if (outSec) outSec.textContent = `${Math.max(0.12, sec).toFixed(3)} kWh/kg`;

      // Live visuals
      if (jetVelText) jetVelText.textContent = `v_jet = ${vJet.toFixed(1)} m/s`;
      if (mixTimeText) mixTimeText.textContent = `tau_mix = ${tauMixMs.toFixed(2)} ms`;
      if (particleScale) {
        particleScale.textContent = `d_50 = ${d50.toFixed(1)} nm (${d50 < 80 ? 'Sub-80 nm Amorphous Nanocrystal Complex' : 'Agglomerated Micro-Particulate'})`;
      }

      // Chart updates
      if (chartBar) {
        const heightPct = Math.min(100, Math.max(10, (d50 / 300) * 100));
        chartBar.style.height = `${heightPct}%`;
      }
      if (chartBarVal) chartBarVal.textContent = `${d50.toFixed(1)}nm`;

      if (chartDissBar) {
        const heightPct = Math.min(100, Math.max(10, (dissolutionFactor / 30.0) * 100));
        chartDissBar.style.height = `${heightPct}%`;
      }
      if (chartDissVal) chartDissVal.textContent = `${dissolutionFactor.toFixed(1)}×`;

      // Verdict styling
      if (isSupercritical && d50 < 80 && da < 0.05) {
        if (verdictBox) {
          verdictBox.className = "mb-6 p-4 rounded-2xl border transition-all bg-indigo-950/40 border-indigo-500/80 text-indigo-200 shadow-md";
        }
        if (verdictTitle) verdictTitle.textContent = `OPTIMAL SUB-80nm AMORPHOUS CO-CRYSTAL PRECIPITATION (${d50.toFixed(1)} nm) • Da < 0.05`;
        if (verdictDesc) verdictDesc.textContent = `High-velocity micro-jet cavitation shockwave collapse (Delta_P = ${shockwaveBar.toFixed(0)} bar) combined with instantaneous antisolvent supersaturation (S > 1000) achieves sub-80 nm amorphous co-crystals with ${dissolutionFactor.toFixed(1)}x dissolution enhancement and residual ethanol < ${residualSolventPpm.toFixed(0)} ppm under USP <467>.`;
      } else if (!isSupercritical) {
        if (verdictBox) {
          verdictBox.className = "mb-6 p-4 rounded-2xl border transition-all bg-red-950/50 border-red-500/80 text-red-200 shadow-md";
        }
        if (verdictTitle) verdictTitle.textContent = `HAZARD: SUBCRITICAL CO2 PHASE FAULT (P < 73.8 bar / T < 31.1 °C)`;
        if (verdictDesc) verdictDesc.textContent = `CO2 antisolvent power collapsed into liquid/gas biphasic regime. Massive solute recrystallization, severe nozzle fouling, and hazardous solvent retention (>1000 ppm) violate USP <467> and FDA cGMP standards.`;
      } else {
        if (verdictBox) {
          verdictBox.className = "mb-6 p-4 rounded-2xl border transition-all bg-amber-950/40 border-amber-500/80 text-amber-200 shadow-md";
        }
        if (verdictTitle) verdictTitle.textContent = `SUB-OPTIMAL MICRONIZATION (${d50.toFixed(1)} nm) • MODERATE MIXING (Da = ${da.toFixed(3)})`;
        if (verdictDesc) verdictDesc.textContent = `Supercritical phase maintained, but lower jet velocity or insufficient scCO2 ratio R_m allows partial crystal growth. Elevate pressure or optimize orifice diameter to achieve sub-80 nm nanocrystal cutoff.`;
      }
    }

    // Attach listeners
    [pressureInput, tempInput, co2RatioInput, orificeInput, flowInput].forEach(input => {
      input?.addEventListener('input', recalculate);
    });

    formulationSelect?.addEventListener('change', () => {
      const selected = formulationSelect.value;
      if (selected === 'quercetin_pvp_nanocrystal') applyPreset('quercetin');
      else if (selected === 'curcumin_phospholipid_cocrystal') applyPreset('curcumin');
      else if (selected === 'resveratrol_cyclodextrin_inclusion') applyPreset('resveratrol');
      else if (selected === 'egcg_casein_nanoparticle') applyPreset('egcg');
      else if (selected === 'coq10_lecithin_amorphous') applyPreset('coq10');
    });

    function applyPreset(key: keyof typeof presets) {
      const data = presets[key];
      if (!data) return;
      if (formulationSelect) formulationSelect.value = data.form;
      if (pressureInput) pressureInput.value = data.p.toString();
      if (tempInput) tempInput.value = data.t.toString();
      if (co2RatioInput) co2RatioInput.value = data.rm.toString();
      if (orificeInput) orificeInput.value = data.orif.toString();
      if (flowInput) flowInput.value = data.flow.toString();
      recalculate();
    }

    document.querySelectorAll('.preset-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const presetKey = target.getAttribute('data-preset') as keyof typeof presets;
        if (presetKey) applyPreset(presetKey);
      });
    });

    // Run initial computation
    recalculate();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHjcSasModeler);
  } else {
    initHjcSasModeler();
  }
</script>
