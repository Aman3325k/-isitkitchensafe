const d = DICTIONARY[lang];
---

<div class="not-prose my-8 bg-surface-soft border border-hairline rounded-3xl p-6 md:p-8 shadow-xs" id="rotisserie-creosote-engine">
  <!-- Header Badge -->
  <div class="flex flex-wrap items-center justify-between gap-3 mb-6 pb-6 border-b border-hairline/80">
    <div class="flex items-center gap-2">
      <span class="inline-flex items-center justify-center w-8 h-8 rounded-xl bg-amber-500/10 text-amber-600 font-bold text-sm">
        🔥
      </span>
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-amber-600 block">
          {d.badge}
        </span>
        <h2 class="text-xl md:text-2xl font-black text-ink tracking-tight">
          {d.title}
        </h2>
      </div>
    </div>
    <span class="text-xs font-mono text-muted bg-surface px-3 py-1.5 rounded-lg border border-hairline">
      NFPA 96 &bull; OSHA 1910.1000 &bull; EU 835/2011
    </span>
  </div>

  <p class="text-sm md:text-base text-muted leading-relaxed mb-8">
    {d.subtitle}
  </p>

  <!-- Presets Bar -->
  <div class="mb-8 p-4 bg-surface rounded-2xl border border-hairline">
    <span class="text-xs font-bold text-ink uppercase tracking-wider block mb-3">
      🎯 {d.presetsTitle}
    </span>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2">
      <button 
        type="button"
        class="preset-btn text-left p-2.5 rounded-xl border border-hairline hover:border-emerald-500/50 hover:bg-emerald-500/5 transition-all text-xs font-medium text-ink flex flex-col gap-1 active:scale-[0.98]"
        data-preset="gold"
      >
        <span class="text-emerald-700 font-bold">1. NFPA 96 Gold Master</span>
        <span class="text-[11px] text-muted line-clamp-2">64 Birds, High-CFM Type I Hood, Hydro-Jet Cleaning</span>
      </button>

      <button 
        type="button"
        class="preset-btn text-left p-2.5 rounded-xl border border-hairline hover:border-red-500/50 hover:bg-red-500/5 transition-all text-xs font-medium text-ink flex flex-col gap-1 active:scale-[0.98]"
        data-preset="creosote"
      >
        <span class="text-red-700 font-bold">2. Long Duct Creosote Hazard</span>
        <span class="text-[11px] text-muted line-clamp-2">Low Airflow, Horizontal Run, 2.45 mm/mo Deposition</span>
      </button>

      <button 
        type="button"
        class="preset-btn text-left p-2.5 rounded-xl border border-hairline hover:border-amber-500/50 hover:bg-amber-500/5 transition-all text-xs font-medium text-ink flex flex-col gap-1 active:scale-[0.98]"
        data-preset="fracture"
      >
        <span class="text-amber-700 font-bold">3. Ceramic Flare Autoignition</span>
        <span class="text-[11px] text-muted line-clamp-2">Broken Tile, Raw Gas Blowby, >985°C Hotspot</span>
      </button>

      <button 
        type="button"
        class="preset-btn text-left p-2.5 rounded-xl border border-hairline hover:border-purple-500/50 hover:bg-purple-500/5 transition-all text-xs font-medium text-ink flex flex-col gap-1 active:scale-[0.98]"
        data-preset="bypass"
      >
        <span class="text-purple-700 font-bold">4. Deli Filter Bypass Rush</span>
        <span class="text-[11px] text-muted line-clamp-2">48 Birds, Gapped Baffle Filters, Fan Impeller Coated</span>
      </button>
    </div>
  </div>

  <!-- Interactive Control Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-8">
    <!-- Controls Column (7 cols) -->
    <div class="lg:col-span-7 space-y-6">
      <div class="bg-surface rounded-2xl p-5 border border-hairline space-y-5">
        <h3 class="text-sm font-bold text-ink uppercase tracking-wider flex items-center gap-2">
          <span>⚙️</span> {d.controlsTitle}
        </h3>

        <!-- Control 1: Rotisserie Appliance Architecture -->
        <div>
          <label for="rotisserie-select" class="block text-xs font-bold text-ink mb-1">
            {d.rotisserieLabel}
          </label>
          <select id="rotisserie-select" class="w-full text-xs font-medium bg-surface-soft border border-hairline rounded-xl px-3 py-2 text-ink focus:outline-none focus:ring-2 focus:ring-amber-500/20">
            {rotisserieData.rotisserieConfigurations.map((r) => (
              <option value={r.id}>{r.name}</option>
            ))}
          </select>
          <span class="text-[11px] text-muted block mt-1">{d.rotisserieHelp}</span>
        </div>

        <!-- Control 2: Poultry Roasting Batch Profile -->
        <div>
          <label for="batch-select" class="block text-xs font-bold text-ink mb-1">
            {d.batchLabel}
          </label>
          <select id="batch-select" class="w-full text-xs font-medium bg-surface-soft border border-hairline rounded-xl px-3 py-2 text-ink focus:outline-none focus:ring-2 focus:ring-amber-500/20">
            {rotisserieData.roastingBatchProfiles.map((b) => (
              <option value={b.id}>{b.name}</option>
            ))}
          </select>
          <span class="text-[11px] text-muted block mt-1">{d.batchHelp}</span>
        </div>

        <!-- Control 3: Exhaust Ventilation & Aerodynamics -->
        <div>
          <label for="vent-select" class="block text-xs font-bold text-ink mb-1">
            {d.ventilationLabel}
          </label>
          <select id="vent-select" class="w-full text-xs font-medium bg-surface-soft border border-hairline rounded-xl px-3 py-2 text-ink focus:outline-none focus:ring-2 focus:ring-amber-500/20">
            {rotisserieData.ventilationAndDuctworkDynamics.map((v) => (
              <option value={v.id}>{v.name}</option>
            ))}
          </select>
          <span class="text-[11px] text-muted block mt-1">{d.ventilationHelp}</span>
        </div>

        <!-- Control 4: Ceramic Radiant Tile & Shield State -->
        <div>
          <label for="burner-select" class="block text-xs font-bold text-ink mb-1">
            {d.burnerLabel}
          </label>
          <select id="burner-select" class="w-full text-xs font-medium bg-surface-soft border border-hairline rounded-xl px-3 py-2 text-ink focus:outline-none focus:ring-2 focus:ring-amber-500/20">
            {rotisserieData.ceramicBurnerAndShieldStates.map((c) => (
              <option value={c.id}>{c.name}</option>
            ))}
          </select>
          <span class="text-[11px] text-muted block mt-1">{d.burnerHelp}</span>
        </div>

        <!-- Control 5: Sanitation & NFPA 96 Fire Safety Regimen -->
        <div>
          <label for="sanitation-select" class="block text-xs font-bold text-ink mb-1">
            {d.sanitationLabel}
          </label>
          <select id="sanitation-select" class="w-full text-xs font-medium bg-surface-soft border border-hairline rounded-xl px-3 py-2 text-ink focus:outline-none focus:ring-2 focus:ring-amber-500/20">
            {rotisserieData.sanitationAndFireSafetyProtocols.map((s) => (
              <option value={s.id}>{s.name}</option>
            ))}
          </select>
          <span class="text-[11px] text-muted block mt-1">{d.sanitationHelp}</span>
        </div>

        <!-- Interactive Sliders -->
        <div class="pt-4 border-t border-hairline space-y-4">
          <!-- Slider 1: Birds on Spits -->
          <div>
            <div class="flex items-center justify-between text-xs font-bold text-ink mb-1">
              <span>{d.birdsSliderLabel}</span>
              <span id="birds-display" class="font-mono text-amber-600 bg-amber-500/10 px-2 py-0.5 rounded">64 Birds</span>
            </div>
            <input 
              type="range" 
              id="birds-slider" 
              min="8" 
              max="64" 
              step="4" 
              value="64" 
              class="w-full accent-amber-600 cursor-pointer"
            />
            <span class="text-[10px] text-muted block">{d.birdsSliderHelp}</span>
          </div>

          <!-- Slider 2: Burner Surface Temperature -->
          <div>
            <div class="flex items-center justify-between text-xs font-bold text-ink mb-1">
              <span>{d.tempSliderLabel}</span>
              <span id="temp-display" class="font-mono text-red-600 bg-red-500/10 px-2 py-0.5 rounded">880°C / 1616°F</span>
            </div>
            <input 
              type="range" 
              id="temp-slider" 
              min="650" 
              max="1000" 
              step="10" 
              value="880" 
              class="w-full accent-red-600 cursor-pointer"
            />
            <span class="text-[10px] text-muted block">{d.tempSliderHelp}</span>
          </div>

          <!-- Slider 3: Ventilation Airflow (CFM) -->
          <div>
            <div class="flex items-center justify-between text-xs font-bold text-ink mb-1">
              <span>{d.cfmSliderLabel}</span>
              <span id="cfm-display" class="font-mono text-sky-600 bg-sky-500/10 px-2 py-0.5 rounded">2,400 CFM</span>
            </div>
            <input 
              type="range" 
              id="cfm-slider" 
              min="500" 
              max="3500" 
              step="100" 
              value="2400" 
              class="w-full accent-sky-600 cursor-pointer"
            />
            <span class="text-[10px] text-muted block">{d.cfmSliderHelp}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Diagnostic & Telemetry Column (5 cols) -->
    <div class="lg:col-span-5 space-y-4">
      <div class="bg-surface rounded-2xl p-5 border border-hairline shadow-xs">
        <h3 class="text-sm font-bold text-ink uppercase tracking-wider flex items-center justify-between mb-4">
          <span class="flex items-center gap-2"><span>📊</span> {d.diagnosticTitle}</span>
          <span id="live-indicator" class="inline-flex items-center gap-1.5 text-[10px] font-bold text-emerald-600 bg-emerald-500/10 px-2 py-0.5 rounded-full">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span> LIVE
          </span>
        </h3>

        <!-- Metric 1: Flare-Up Ignition Risk -->
        <div class="p-3.5 bg-surface-soft rounded-xl border border-hairline mb-3">
          <div class="flex items-center justify-between text-xs text-muted mb-1">
            <span>{d.flareUpRiskLabel}</span>
            <span id="flare-pct-val" class="font-bold text-ink font-mono text-sm">8.5% (LOW)</span>
          </div>
          <div class="w-full h-2 bg-surface rounded-full overflow-hidden border border-hairline">
            <div id="flare-progress" class="h-full bg-emerald-500 transition-all duration-300" style="width: 8.5%;"></div>
          </div>
        </div>

        <!-- Metric 2: Monthly Creosote Deposition -->
        <div class="p-3.5 bg-surface-soft rounded-xl border border-hairline mb-3">
          <div class="flex items-center justify-between text-xs text-muted mb-1">
            <span>{d.creosoteRateLabel}</span>
            <span id="creosote-val" class="font-bold text-ink font-mono text-sm">0.12 mm / mo (0.005 in)</span>
          </div>
          <div class="w-full h-2 bg-surface rounded-full overflow-hidden border border-hairline">
            <div id="creosote-progress" class="h-full bg-sky-500 transition-all duration-300" style="width: 5%;"></div>
          </div>
          <span class="text-[10px] text-muted block mt-1">NFPA 96 Limit: 1.27 mm (50 mil / 2,000 µm depth trigger)</span>
        </div>

        <!-- Metric 3: PAH Benzo[a]pyrene Synthesis -->
        <div class="p-3.5 bg-surface-soft rounded-xl border border-hairline mb-3">
          <div class="flex items-center justify-between text-xs text-muted mb-1">
            <span>{d.pahEmissionLabel}</span>
            <span id="pah-val" class="font-bold text-ink font-mono text-sm">18.0 µg/hr</span>
          </div>
          <div class="w-full h-2 bg-surface rounded-full overflow-hidden border border-hairline">
            <div id="pah-progress" class="h-full bg-emerald-500 transition-all duration-300" style="width: 2%;"></div>
          </div>
          <span class="text-[10px] text-muted block mt-1">EU 835/2011 Ceiling: 5.0 µg/kg BaP in roasted meat</span>
        </div>

        <!-- Metric 4: NFPA 96 Compliance Status Badge -->
        <div class="p-3.5 bg-surface-soft rounded-xl border border-hairline mb-4">
          <span class="text-xs text-muted block mb-1">{d.complianceLabel}</span>
          <div id="compliance-badge" class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-bold bg-emerald-500/10 text-emerald-800 border border-emerald-500/30">
            <span>✅</span>
            <span id="compliance-text">100% COMPLIANT (UL 300 Certified)</span>
          </div>
        </div>

        <!-- Detailed Diagnostic Output -->
        <div class="space-y-3 pt-3 border-t border-hairline text-xs">
          <div>
            <span class="font-bold text-ink block mb-0.5">{d.primaryRiskLabel}</span>
            <p id="risk-text" class="text-muted leading-relaxed">
              Low baseline risk; high-velocity Type I hood maintains grease aerosols above the 140°C condensation threshold, preventing duct invert creosote accumulation.
            </p>
          </div>

          <div>
            <span class="font-bold text-ink block mb-0.5">{d.mechanismsLabel}</span>
            <p id="mechanism-text" class="text-muted leading-relaxed">
              Infrared ceramic tiles vaporize micro-droplets instantaneously through nucleate boiling; continuous water bath drain basin prevents pooled lipid thermal cracking.
            </p>
          </div>

          <div>
            <span class="font-bold text-ink block mb-0.5">{d.mitigationLabel}</span>
            <p id="mitigation-text" class="text-muted leading-relaxed">
              Execute monthly certified chemical hydro-jet washdowns, test automatic water injection solenoid weekly, and inspect ceramic matrix for hair fissures.
            </p>
          </div>
        </div>

        <!-- Copy Report Button -->
        <button 
          type="button" 
          id="copy-report-btn" 
          class="w-full mt-4 py-2.5 px-4 rounded-xl bg-amber-600 hover:bg-amber-700 text-white font-medium text-xs transition-colors flex items-center justify-center gap-2 shadow-xs active:scale-[0.98]"
        >
          <span>📋</span> {d.copyReportBtn}
        </button>
        <span id="copied-toast" class="text-[11px] text-emerald-600 font-bold text-center block mt-1.5 opacity-0 transition-opacity">
          {d.copiedFeedback}
        </span>
      </div>
    </div>
  </div>

  <!-- Hardware Specifications Table -->
  <div class="mb-10 bg-surface rounded-2xl p-5 border border-hairline overflow-x-auto">
    <div class="mb-4">
      <h3 class="text-sm font-bold text-ink uppercase tracking-wider">
        📋 {d.tableTitle}
      </h3>
      <p class="text-xs text-muted">{d.tableSub}</p>
    </div>
    <table class="w-full text-left text-xs border-collapse">
      <thead>
        <tr class="border-b border-hairline text-muted">
          <th class="py-2.5 px-3 font-semibold">{d.colRotisserie}</th>
          <th class="py-2.5 px-3 font-semibold">{d.colBtu}</th>
          <th class="py-2.5 px-3 font-semibold">{d.colBurner}</th>
          <th class="py-2.5 px-3 font-semibold">{d.colCapacity}</th>
          <th class="py-2.5 px-3 font-semibold">{d.colFireRisk}</th>
          <th class="py-2.5 px-3 font-semibold">{d.colGreaseSystem}</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-hairline text-ink">
        {rotisserieData.rotisserieConfigurations.map((r) => (
          <tr class="hover:bg-surface-soft/60 transition-colors">
            <td class="py-2.5 px-3 font-medium text-ink">{r.name.split('(')[0]}</td>
            <td class="py-2.5 px-3 font-mono">{r.btuRating.toLocaleString()} BTU/hr</td>
            <td class="py-2.5 px-3 text-muted">{r.burnerType.split('(')[0]}</td>
            <td class="py-2.5 px-3 font-mono">{r.capacityBirds} Birds</td>
            <td class="py-2.5 px-3 font-bold text-amber-700">{r.baselineFireRisk}</td>
            <td class="py-2.5 px-3 text-muted text-[11px]">{r.greaseCollectionSystem.split('(')[0]}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <!-- Golden Rules Section -->
  <div class="bg-surface rounded-2xl p-6 border border-hairline">
    <div class="mb-5">
      <h3 class="text-sm font-bold text-ink uppercase tracking-wider flex items-center gap-2">
        <span>🛡️</span> {d.rulesTitle}
      </h3>
      <p class="text-xs text-muted">{d.rulesSub}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <h4 class="text-xs font-bold text-ink mb-1.5 flex items-center gap-1.5">
          <span class="text-amber-600">1.</span> {d.rule1Title}
        </h4>
        <p class="text-[11px] text-muted leading-relaxed">{d.rule1Text}</p>
      </div>

      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <h4 class="text-xs font-bold text-ink mb-1.5 flex items-center gap-1.5">
          <span class="text-amber-600">2.</span> {d.rule2Title}
        </h4>
        <p class="text-[11px] text-muted leading-relaxed">{d.rule2Text}</p>
      </div>

      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <h4 class="text-xs font-bold text-ink mb-1.5 flex items-center gap-1.5">
          <span class="text-amber-600">3.</span> {d.rule3Title}
        </h4>
        <p class="text-[11px] text-muted leading-relaxed">{d.rule3Text}</p>
      </div>

      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <h4 class="text-xs font-bold text-ink mb-1.5 flex items-center gap-1.5">
          <span class="text-amber-600">4.</span> {d.rule4Title}
        </h4>
        <p class="text-[11px] text-muted leading-relaxed">{d.rule4Text}</p>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ rotisserieData }}>
(function() {
  const container = document.getElementById('rotisserie-creosote-engine');
  if (!container) return;

  // DOM Elements
  const rotisserieSelect = container.querySelector('#rotisserie-select');
  const batchSelect = container.querySelector('#batch-select');
  const ventSelect = container.querySelector('#vent-select');
  const burnerSelect = container.querySelector('#burner-select');
  const sanitationSelect = container.querySelector('#sanitation-select');

  const birdsSlider = container.querySelector('#birds-slider');
  const birdsDisplay = container.querySelector('#birds-display');
  const tempSlider = container.querySelector('#temp-slider');
  const tempDisplay = container.querySelector('#temp-display');
  const cfmSlider = container.querySelector('#cfm-slider');
  const cfmDisplay = container.querySelector('#cfm-display');

  const flarePctVal = container.querySelector('#flare-pct-val');
  const flareProgress = container.querySelector('#flare-progress');
  const creosoteVal = container.querySelector('#creosote-val');
  const creosoteProgress = container.querySelector('#creosote-progress');
  const pahVal = container.querySelector('#pah-val');
  const pahProgress = container.querySelector('#pah-progress');
  const complianceBadge = container.querySelector('#compliance-badge');
  const complianceText = container.querySelector('#compliance-text');

  const riskText = container.querySelector('#risk-text');
  const mechanismText = container.querySelector('#mechanism-text');
  const mitigationText = container.querySelector('#mitigation-text');

  const copyBtn = container.querySelector('#copy-report-btn');
  const copiedToast = container.querySelector('#copied-toast');

  function calculateTelemetry() {
    const rotId = rotisserieSelect.value;
    const batchId = batchSelect.value;
    const ventId = ventSelect.value;
    const burnerId = burnerSelect.value;
    const sanId = sanitationSelect.value;

    const birdsCount = parseInt(birdsSlider.value, 10);
    const burnerTempC = parseInt(tempSlider.value, 10);
    const cfm = parseInt(cfmSlider.value, 10);

    // Lookups
    const rot = rotisserieData.rotisserieConfigurations.find(r => r.id === rotId) || rotisserieData.rotisserieConfigurations[0];
    const batch = rotisserieData.roastingBatchProfiles.find(b => b.id === batchId) || rotisserieData.roastingBatchProfiles[0];
    const vent = rotisserieData.ventilationAndDuctworkDynamics.find(v => v.id === ventId) || rotisserieData.ventilationAndDuctworkDynamics[0];
    const burner = rotisserieData.ceramicBurnerAndShieldStates.find(c => c.id === burnerId) || rotisserieData.ceramicBurnerAndShieldStates[0];
    const san = rotisserieData.sanitationAndFireSafetyProtocols.find(s => s.id === sanId) || rotisserieData.sanitationAndFireSafetyProtocols[0];

    // Sliders displays
    birdsDisplay.textContent = `${birdsCount} Birds`;
    tempDisplay.textContent = `${burnerTempC}°C / ${Math.round(burnerTempC * 1.8 + 32)}°F`;
    cfmDisplay.textContent = `${cfm.toLocaleString()} CFM`;

    // 1. Flare-up probability calculation (%)
    // Baseline from burner condition + spatter frequency factor + bird volume multiplier
    let baseFlare = 5.0;
    if (burnerId === 'pristine_cordierite_ceramic_clean') baseFlare = 4.0;
    else if (burnerId === 'moderate_carbon_glaze_microcracked') baseFlare = 22.0;
    else if (burnerId === 'fractured_tile_gas_blowby_hotspot') baseFlare = 78.0;
    else if (burnerId === 'grease_soaked_radiant_shield') baseFlare = 88.0;

    if (batchId === 'blocked_drain_pool_accumulation') baseFlare += 25.0;
    if (batchId === 'high_temp_crisping_finish_phase') baseFlare += 18.0;

    // Bird scaling factor (normalize 32 birds = 1.0)
    const birdScale = birdsCount / 32.0;
    let computedFlare = Math.min(99.5, Math.max(1.0, baseFlare * birdScale));

    // 2. Creosote Deposition Rate (mm/month)
    // Base from ductwork, modulated by cfm airflow and grease generation
    const cfmFactor = Math.max(0.3, 1800.0 / Math.max(500, cfm));
    const greaseLoadFactor = (batch.greaseAerosolGenerationGramsHour / 200.0) * (birdsCount / 32.0);
    const sanMultiplier = san.id === 'gold_standard_hydrojet_daily_drain' ? 0.35 : (san.id === 'annual_duct_clean_neglected_basin' ? 2.1 : (san.id === 'zero_duct_maintenance_diy_wipe' ? 3.4 : 1.0));

    let creosoteMmMonth = vent.creosoteDepositionRateMmMonth * cfmFactor * greaseLoadFactor * sanMultiplier;
    creosoteMmMonth = Math.max(0.04, Math.round(creosoteMmMonth * 100) / 100);
    const creosoteInchesMonth = (creosoteMmMonth / 25.4).toFixed(4);

    // 3. PAH Benzo[a]pyrene formation rate (µg/hr)
    let basePah = burner.pahFormationRateUgHour;
    if (burnerTempC > 900) basePah *= 1.45;
    else if (burnerTempC < 750) basePah *= 0.65;
    let computedPah = Math.round(basePah * (birdsCount / 32.0) * (batch.greaseAerosolGenerationGramsHour / 200.0));

    // Render Telemetry
    flarePctVal.textContent = `${computedFlare.toFixed(1)}% (${computedFlare > 60 ? 'CRITICAL AUTOIGNITION' : (computedFlare > 25 ? 'ELEVATED' : 'LOW')})`;
    flareProgress.style.width = `${Math.min(100, computedFlare)}%`;
    flareProgress.className = `h-full transition-all duration-300 ${computedFlare > 60 ? 'bg-red-600' : (computedFlare > 25 ? 'bg-amber-500' : 'bg-emerald-500')}`;

    creosoteVal.textContent = `${creosoteMmMonth} mm / mo (${creosoteInchesMonth} in)`;
    const creosotePct = Math.min(100, (creosoteMmMonth / 3.0) * 100);
    creosoteProgress.style.width = `${creosotePct}%`;
    creosoteProgress.className = `h-full transition-all duration-300 ${creosoteMmMonth > 1.27 ? 'bg-red-600' : (creosoteMmMonth > 0.5 ? 'bg-amber-500' : 'bg-sky-500')}`;

    pahVal.textContent = `${computedPah} µg/hr BaP eq`;
    const pahPct = Math.min(100, (computedPah / 1000) * 100);
    pahProgress.style.width = `${pahPct}%`;
    pahProgress.className = `h-full transition-all duration-300 ${computedPah > 400 ? 'bg-red-600' : (computedPah > 100 ? 'bg-amber-500' : 'bg-emerald-500')}`;

    // Compliance Badge
    if (creosoteMmMonth > 1.27 || computedFlare > 70 || san.id.includes('annual') || san.id.includes('zero')) {
      complianceBadge.className = "inline-flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-bold bg-red-500/10 text-red-800 border border-red-500/30";
      complianceBadge.innerHTML = '<span>🚨</span> <span>NON-COMPLIANT: NFPA 96 & FIRE CODE VIOLATION</span>';
    } else if (creosoteMmMonth > 0.6 || computedFlare > 25 || san.id.includes('quarterly')) {
      complianceBadge.className = "inline-flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-bold bg-amber-500/10 text-amber-800 border border-amber-500/30";
      complianceBadge.innerHTML = '<span>⚠️</span> <span>CAUTION: CONDITIONAL COMPLIANCE (ELEVATED RISK)</span>';
    } else {
      complianceBadge.className = "inline-flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-bold bg-emerald-500/10 text-emerald-800 border border-emerald-500/30";
      complianceBadge.innerHTML = '<span>✅</span> <span>100% COMPLIANT (UL 300 Certified)</span>';
    }

    // Dynamic Texts
    if (computedFlare > 60 || batchId === 'blocked_drain_pool_accumulation') {
      riskText.textContent = "Catastrophic grease pool autoignition hazard; liquid poultry lipids reaching 360°C–390°C surface flash point will sustain an uncontrollable Class K cabinet fire.";
      mechanismText.textContent = "Incomplete fuel combustion on compromised ceramic faces combines with boiling fat spatter droplets, forming continuous flame plumes and dense polycyclic creosote.";
      mitigationText.textContent = "URGENT: Clear basin drain port immediately, activate Ansul wet chemical suppression if ignition occurs, and shut off master gas valve.";
    } else if (creosoteMmMonth > 1.27) {
      riskText.textContent = `Severe NFPA 96 violation; duct grease accumulation (${creosoteMmMonth} mm/month) exceeds the mandatory 1.27 mm (50 mil) cleaning threshold, creating a continuous fuel train in exhaust risers.`;
      mechanismText.textContent = "Low transport velocity (<1,500 FPM) allows lipid vapors to drop below 140°C dew point, driving rapid thermophoretic deposition of unoxidized fatty acids onto duct walls.";
      mitigationText.textContent = "Schedule immediate IKECA-certified chemical hydro-jet duct cleaning, adjust exhaust blower to minimum 2,000 CFM, and realign baffle filter seating.";
    } else {
      riskText.textContent = "Optimal commercial fire safety profile; high exhaust transport velocity and continuous drainage keep cabinet temperatures safely isolated from lipid autoignition.";
      mechanismText.textContent = "Micro-porous ceramic emitters radiate at 2.5–3.5 µm wavelengths; grease spatters striking the 880°C ceramic surface vaporize cleanly into combustion products.";
      mitigationText.textContent = "Maintain weekly drain flushing, inspect ceramic tiles for hairline fissures, and execute standard NFPA 96 scheduled duct inspections.";
    }
  }

  // Presets Handler
  const presetBtns = container.querySelectorAll('.preset-btn');
  presetBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const p = btn.getAttribute('data-preset');
      if (p === 'gold') {
        rotisserieSelect.value = 'heavy_duty_infrared_double_rotisserie';
        batchSelect.value = 'full_batch_high_fat_rotisserie';
        ventSelect.value = 'dedicated_type1_high_cfm_baffle';
        burnerSelect.value = 'pristine_cordierite_ceramic_clean';
        sanitationSelect.value = 'gold_standard_hydrojet_daily_drain';
        birdsSlider.value = '64';
        tempSlider.value = '880';
        cfmSlider.value = '2400';
      } else if (p === 'creosote') {
        rotisserieSelect.value = 'commercial_planetary_rear_burner';
        batchSelect.value = 'full_batch_high_fat_rotisserie';
        ventSelect.value = 'undersized_duct_long_horizontal_run';
        burnerSelect.value = 'moderate_carbon_glaze_microcracked';
        sanitationSelect.value = 'annual_duct_clean_neglected_basin';
        birdsSlider.value = '48';
        tempSlider.value = '810';
        cfmSlider.value = '900';
      } else if (p === 'fracture') {
        rotisserieSelect.value = 'unserviced_aged_rotisserie_neglect';
        batchSelect.value = 'blocked_drain_pool_accumulation';
        ventSelect.value = 'standard_shared_kitchen_hood';
        burnerSelect.value = 'fractured_tile_gas_blowby_hotspot';
        sanitationSelect.value = 'annual_duct_clean_neglected_basin';
        birdsSlider.value = '64';
        tempSlider.value = '980';
        cfmSlider.value = '1500';
      } else if (p === 'bypass') {
        rotisserieSelect.value = 'commercial_planetary_rear_burner';
        batchSelect.value = 'moderate_deli_batch_profile';
        ventSelect.value = 'compromised_filters_bypass_gaps';
        burnerSelect.value = 'grease_soaked_radiant_shield';
        sanitationSelect.value = 'quarterly_duct_clean_daily_wash';
        birdsSlider.value = '48';
        tempSlider.value = '760';
        cfmSlider.value = '1600';
      }
      calculateTelemetry();
    });
  });

  // Event Listeners
  [rotisserieSelect, batchSelect, ventSelect, burnerSelect, sanitationSelect].forEach(sel => {
    sel.addEventListener('change', calculateTelemetry);
  });
  [birdsSlider, tempSlider, cfmSlider].forEach(sld => {
    sld.addEventListener('input', calculateTelemetry);
  });

  // Copy Report
  copyBtn.addEventListener('click', () => {
    const reportText = `=== ISITKITCHENSAFE ROTISSERIE COMBUSTION & CREOSOTE AUDIT REPORT ===
Timestamp: ${new Date().toISOString()}
Standard: NFPA 96 Table 11.4 & OSHA 29 CFR 1910.1000

Rotisserie Architecture: ${rotisserieSelect.selectedOptions[0].text}
Roasting Batch Profile: ${batchSelect.selectedOptions[0].text}
Exhaust Ductwork: ${ventSelect.selectedOptions[0].text}
Ceramic Burner State: ${burnerSelect.selectedOptions[0].text}
Sanitation Regimen: ${sanitationSelect.selectedOptions[0].text}

Telemetry Parameters:
- Birds on Spits: ${birdsSlider.value} Birds
- Burner Surface Temp: ${tempSlider.value}°C / ${Math.round(tempSlider.value * 1.8 + 32)}°F
- Exhaust Airflow: ${cfmSlider.value} CFM

Diagnostic Outputs:
- Grease Spatter Flare-Up Risk: ${flarePctVal.textContent}
- Monthly Duct Creosote Deposition: ${creosoteVal.textContent}
- Benzo[a]pyrene (PAH) Formation Rate: ${pahVal.textContent}
- NFPA 96 Compliance Status: ${complianceBadge.innerText.trim()}

Engineering Evaluation:
- Primary Risk: ${riskText.textContent}
- Mechanisms: ${mechanismText.textContent}
- Mitigations: ${mitigationText.textContent}
=============================================================`;

    navigator.clipboard.writeText(reportText).then(() => {
      copiedToast.style.opacity = '1';
      setTimeout(() => { copiedToast.style.opacity = '0'; }, 3000);
    });
  });

  // Initial Calculation
  calculateTelemetry();
})();
</script>
