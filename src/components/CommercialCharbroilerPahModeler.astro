    presetBurgerShack: "高稼働バーガー店・積炭鋳鉄板＆排気低下（呼吸器重度暴露リスク）",
    presetNfpaMaster: "NFPA 96準拠Hardox偏向板＆400 CFM/ft専用フード（ゴールドマスター）",
    presetPorkInferno: "タレ漬け豚バラ脂火災・セラミック蓄熱煉瓦（熱プルーム大漏洩）",
    presetLeanSirloin: "赤身牛ステーキ・鋳鉄シェブロン網安定シアリング（最適調理）",
    diagnosticTitle: "燃焼毒性学＆熱流体プルーム診断カード",
    diagnosticSub: "肉表面ベンゾ[a]ピレン（µg/kg）、調理師呼吸帯PAH吸入濃度（mg/m³）、上昇プルーム捕集率、NFPA 96排気適合性をリアルタイム表示。",
    bapAdsorptionLabel: "肉表面ベンゾ[a]ピレン蓄積量（EU基準値 <5.0 µg/kg）",
    inhalationLabel: "調理師呼吸域PAH吸入濃度（OSHA PEL <0.20 mg/m³）",
    plumeVelocityLabel: "熱対流プルーム上昇流速＆フード捕集状態",
    flareUpSeverityLabel: "油脂落下火災フレアアップ指数",
    complianceLabel: "NFPA 96消防基準＆OSHA 1910.1000規制準拠",
    dominantSpeciesLabel: "主要有害揮発成分＆高発がん性芳香族分画",
    mechanismLabel: "脂質熱分解＆高温気相ラジカル重合キネティクス",
    mitigationLabel: "厨房エンジニアリング＆炎制御改善プロトコル",
    scienceTitle: "熱分解開裂、高温ラジカル重合、および排気流体力学",
    scienceSub: "700°Cのラジエント上で中性脂肪が熱分解し、EPA指定16大有害多環芳香族炭化水素（PAH）へと気相再合成されるプロセス。",
    tableTitle: "業務用チャーブロイラー偏向板＆焼き網比較マトリックス",
    tableSub: "熱放射率、フレアアップ火炎減衰能、排油効率、PAH吸着性を徹底比較。",
    colArch: "偏向板＆焼き網構造",
    colEmissivity: "熱放射率",
    colFlareDamping: "炎減衰能",
    colGreaseChanneling: "排油効率",
    colPahAffinity: "PAH吸着性",
    rulesTitle: "業務用チャーブロイラー運用・排気安全必須指令",
    rulesSub: "有害煙の厨房内拡散、排気ダクト火災、および過剰な発がん物質生成を防ぐための厳格な安全基準。",
    rule1Title: "グリル火炎に水スプレーを噴射することは絶対厳禁",
    rule1Text: "600°C以上の脂火災に水を吹きかけると、水が1,700倍の体積へと瞬間爆発的に蒸気化し、液状油を飛散させて巨大火球と4倍のPAH煙を放出し、重度熱傷を引き起こします。",
    rule2Title: "重負荷グリラーには400 CFM/リニアft以上の専用排気フードを配備",
    rule2Text: "開放型ガスチャーブロイラーの熱プルームは秒速1.5m以上で上昇します。250 CFM以下のフードでは気流が溢れ出し、調理師の呼吸域に危険なPAHが滞留します。",
    rule3Title: "鋳鉄偏向板に蓄積した炭化油スラッジは毎日スクレーパーで完全除去",
    rule3Text: "炭化した焦げカスは微細なスポンジ状となり、油を抱え込んで低温燻煙を起こし、肉表面のベンゾ[a]ピレン吸着量を2.5 µg/kgから38 µg/kg超へと跳ね上げます。",
    rule4Title: "傾斜焼き網により液化油脂の85%を非加熱冷水パンへ即座に誘導",
    rule4Text: "先進的なチャーブロイラーは15度の傾斜V型網を備え、肉から滴る脂が赤熱した熱板に触れる前に80〜85%を直接冷水受皿へと排出します。",
    copyReportBtn: "チャーブロイラー燃焼＆PAH放散分析レポートをコピー",
    copiedFeedback: "分析レポートをクリップボードにコピーしました！"
  }
};

const d = DICTIONARY[lang] || DICTIONARY.en;
const data = charbroilerData;
---

<div class="bg-surface-soft border border-hairline rounded-3xl p-6 md:p-8 shadow-xs mb-10" id="charbroiler-modeler-root">
  <!-- Interactive Modeler Header -->
  <div class="flex flex-wrap items-center justify-between gap-3 pb-6 border-b border-hairline/80 mb-8">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-rose-600/10 text-rose-800 dark:text-rose-300 border border-rose-600/20 mb-2">
        <span>🔥</span>
        {d.badge}
      </div>
      <h2 class="text-2xl md:text-3xl font-extrabold text-ink tracking-tight">
        {d.title}
      </h2>
      <p class="text-sm text-muted mt-1 max-w-2xl">
        {d.subtitle}
      </p>
    </div>
    <div class="flex items-center gap-2">
      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-mono font-medium bg-surface text-ink border border-hairline">
        NFPA 96 &bull; EPA 16 PAH &bull; OSHA PEL
      </span>
    </div>
  </div>

  <!-- Operational Presets -->
  <div class="mb-8">
    <div class="text-xs font-bold text-muted uppercase tracking-wider mb-3">
      {d.presetsTitle}
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5">
      <button 
        type="button" 
        class="preset-btn text-left p-3 rounded-xl border border-hairline bg-surface hover:bg-surface-alt transition-colors text-xs text-ink font-medium"
        data-preset="burger-shack"
      >
        <span class="block text-rose-600 font-bold mb-1">🍔 {lang === 'en' ? 'Burger Shack Hazard' : lang === 'es' ? 'Hamburguesería Peligro' : lang === 'pt' ? 'Hamburgueria Perigo' : lang === 'zh-cn' ? '老旧汉堡店高危' : 'バーガー店危険工況'}</span>
        <span class="text-muted leading-tight block">{d.presetBurgerShack}</span>
      </button>

      <button 
        type="button" 
        class="preset-btn text-left p-3 rounded-xl border border-hairline bg-surface hover:bg-surface-alt transition-colors text-xs text-ink font-medium"
        data-preset="nfpa-master"
      >
        <span class="block text-emerald-600 font-bold mb-1">🛡️ {lang === 'en' ? 'NFPA 96 Gold Master' : lang === 'es' ? 'NFPA 96 Maestro Oro' : lang === 'pt' ? 'NFPA 96 Padrão Ouro' : lang === 'zh-cn' ? 'NFPA 96黄金标准' : 'NFPA 96適合マスター'}</span>
        <span class="text-muted leading-tight block">{d.presetNfpaMaster}</span>
      </button>

      <button 
        type="button" 
        class="preset-btn text-left p-3 rounded-xl border border-hairline bg-surface hover:bg-surface-alt transition-colors text-xs text-ink font-medium"
        data-preset="pork-inferno"
      >
        <span class="block text-amber-600 font-bold mb-1">🥓 {lang === 'en' ? 'Pork Belly Inferno' : lang === 'es' ? 'Infierno de Panceta' : lang === 'pt' ? 'Labareda de Panceta' : lang === 'zh-cn' ? '肥五花大火爆燃' : '豚バラ脂大火災'}</span>
        <span class="text-muted leading-tight block">{d.presetPorkInferno}</span>
      </button>

      <button 
        type="button" 
        class="preset-btn text-left p-3 rounded-xl border border-hairline bg-surface hover:bg-surface-alt transition-colors text-xs text-ink font-medium"
        data-preset="lean-sirloin"
      >
        <span class="block text-blue-600 font-bold mb-1">🥩 {lang === 'en' ? 'Lean Sirloin Sear' : lang === 'es' ? 'Sellado de Solomillo' : lang === 'pt' ? 'Selagem de Alcatra' : lang === 'zh-cn' ? '精瘦牛排标准煎烤' : '赤身牛最適シアリング'}</span>
        <span class="text-muted leading-tight block">{d.presetLeanSirloin}</span>
      </button>
    </div>
  </div>

  <!-- Main Grid Controls & Diagnostic Card -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Left Column: Controls (7 cols) -->
    <div class="lg:col-span-7 space-y-6">
      <div class="border-b border-hairline/80 pb-3">
        <h3 class="text-lg font-bold text-ink tracking-tight">{d.controlsTitle}</h3>
        <p class="text-xs text-muted mt-0.5">{d.controlsSub}</p>
      </div>

      <!-- 1. Radiant Architecture -->
      <div>
        <label for="cb-radiant-select" class="block text-xs font-bold text-ink uppercase tracking-wider mb-1.5">
          {d.radiantLabel}
        </label>
        <select 
          id="cb-radiant-select" 
          class="w-full bg-surface border border-hairline rounded-xl px-3.5 py-2.5 text-sm font-medium text-ink focus:outline-none focus:ring-2 focus:ring-rose-500/50"
        >
          {data.radiantArchitectures.map((arch) => (
            <option value={arch.id} selected={arch.id === 'cast_iron_chevron'}>
              {arch.name} (Grease Drain: {arch.greaseChannelingEfficiency}%)
            </option>
          ))}
        </select>
        <p class="text-xs text-muted mt-1.5">{d.radiantHelp}</p>
      </div>

      <!-- 2. Meat / Protein Profile -->
      <div>
        <label for="cb-meat-select" class="block text-xs font-bold text-ink uppercase tracking-wider mb-1.5">
          {d.meatLabel}
        </label>
        <select 
          id="cb-meat-select" 
          class="w-full bg-surface border border-hairline rounded-xl px-3.5 py-2.5 text-sm font-medium text-ink focus:outline-none focus:ring-2 focus:ring-rose-500/50"
        >
          {data.meatProfiles.map((m) => (
            <option value={m.id} selected={m.id === 'beef_burger_80_20'}>
              {m.name} ({m.lipidContentPercent}% Fat &bull; Drip: {m.dripRatePerMinMl} mL/min)
            </option>
          ))}
        </select>
        <p class="text-xs text-muted mt-1.5">{d.meatHelp}</p>
      </div>

      <!-- 3. Radiant Temperature -->
      <div>
        <label for="cb-temp-select" class="block text-xs font-bold text-ink uppercase tracking-wider mb-1.5">
          {d.tempLabel}
        </label>
        <select 
          id="cb-temp-select" 
          class="w-full bg-surface border border-hairline rounded-xl px-3.5 py-2.5 text-sm font-medium text-ink focus:outline-none focus:ring-2 focus:ring-rose-500/50"
        >
          {data.radiantTemperatures.map((t) => (
            <option value={t.tempC} selected={t.tempC === 565}>
              {t.tempC}°C ({t.tempF}°F) &mdash; {t.regime}
            </option>
          ))}
        </select>
        <p class="text-xs text-muted mt-1.5">{d.tempHelp}</p>
      </div>

      <!-- 4. Grilling Duration Slider -->
      <div>
        <div class="flex items-center justify-between mb-1.5">
          <label for="cb-duration-slider" class="text-xs font-bold text-ink uppercase tracking-wider">
            {d.durationLabel}
          </label>
          <span class="text-xs font-mono font-bold text-rose-600" id="cb-duration-val">
            8 mins
          </span>
        </div>
        <input 
          type="range" 
          id="cb-duration-slider" 
          min="2" 
          max="20" 
          step="1" 
          value="8" 
          class="w-full accent-rose-600 bg-surface h-2 rounded-lg cursor-pointer border border-hairline"
        />
        <p class="text-xs text-muted mt-1.5">{d.durationHelp}</p>
      </div>

      <!-- 5. Ventilation Exhaust Capacity -->
      <div>
        <label for="cb-vent-select" class="block text-xs font-bold text-ink uppercase tracking-wider mb-1.5">
          {d.ventLabel}
        </label>
        <select 
          id="cb-vent-select" 
          class="w-full bg-surface border border-hairline rounded-xl px-3.5 py-2.5 text-sm font-medium text-ink focus:outline-none focus:ring-2 focus:ring-rose-500/50"
        >
          {data.ventilationProfiles.map((v) => (
            <option value={v.id} selected={v.id === 'standard_hood_degraded'}>
              {v.name} (Capture: {v.captureEfficiencyPercent}%)
            </option>
          ))}
        </select>
        <p class="text-xs text-muted mt-1.5">{d.ventHelp}</p>
      </div>

      <!-- 6. Flare-Up Suppression Technique -->
      <div>
        <label for="cb-suppression-select" class="block text-xs font-bold text-ink uppercase tracking-wider mb-1.5">
          {d.suppressionLabel}
        </label>
        <select 
          id="cb-suppression-select" 
          class="w-full bg-surface border border-hairline rounded-xl px-3.5 py-2.5 text-sm font-medium text-ink focus:outline-none focus:ring-2 focus:ring-rose-500/50"
        >
          <option value="mechanical_scraping" selected>
            {lang === 'en' ? 'Continuous Mechanical Scraping into Grease Trough (Safest)' : lang === 'es' ? 'Raspado Mecánico Continuo a Canal de Grasa (Más Seguro)' : lang === 'pt' ? 'Raspagem Mecânica Contínua para Calha de Gordura (Mais Seguro)' : lang === 'zh-cn' ? '连续机械刮油导入冷水集油槽（最安全）' : '冷水受け皿へのスクレーパー連続排油（安全）'}
          </option>
          <option value="dry_salt">
            {lang === 'en' ? 'Dry Salt / Baking Soda Blanket Quenching' : lang === 'es' ? 'Sofocación con Sal Seca / Bicarbonato' : lang === 'pt' ? 'Abafamento com Sal Seco / Bicarbonato' : lang === 'zh-cn' ? '干燥食盐 / 小苏打粉窒息灭火' : '食塩・重曹粉末による窒息消火'}
          </option>
          <option value="water_spray">
            {lang === 'en' ? 'Water Spray Bottle (CRITICAL HAZARD: Flash Steam Explosion)' : lang === 'es' ? 'Rociador de Agua (PELIGRO CRÍTICO: Explosión de Vapor)' : lang === 'pt' ? 'Borrifador de Água (PERIGO CRÍTICO: Explosão de Vapor)' : lang === 'zh-cn' ? '喷水壶喷水（极高危险：瞬间剧烈蒸汽爆燃！）' : '水スプレー散布（超危険：水蒸気爆発フラッシュ！）'}
          </option>
          <option value="unattended_burn">
            {lang === 'en' ? 'Unattended Burn-Off (Grease Fire Flare Allowed to Smolder)' : lang === 'es' ? 'Combustión Desatendida (Fuego de Grasa sin Control)' : lang === 'pt' ? 'Queima Descontrolada (Fogo de Gordura sem Intervenção)' : lang === 'zh-cn' ? '放任持续灼烧（油脂明火自然阴燃）' : '自然燃焼放置（油脂火炎の燻煙放置）'}
          </option>
        </select>
        <p class="text-xs text-muted mt-1.5">{d.suppressionHelp}</p>
      </div>
    </div>

    <!-- Right Column: Diagnostic & Regulatory Assessment Card (5 cols) -->
    <div class="lg:col-span-5 bg-surface border border-hairline rounded-2xl p-6 shadow-xs space-y-6">
      <div class="border-b border-hairline/80 pb-3">
        <h3 class="text-lg font-bold text-ink tracking-tight flex items-center justify-between">
          <span>{d.diagnosticTitle}</span>
          <span class="inline-block w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse" id="cb-pulse-dot"></span>
        </h3>
        <p class="text-xs text-muted mt-0.5">{d.diagnosticSub}</p>
      </div>

      <!-- Key Diagnostic KPI 1: Benzo[a]pyrene Meat Surface Adsorption -->
      <div class="bg-surface-soft border border-hairline rounded-xl p-4">
        <div class="text-xs text-muted font-medium mb-1">{d.bapAdsorptionLabel}</div>
        <div class="flex items-baseline gap-2">
          <span class="text-2xl md:text-3xl font-black text-ink tracking-tight" id="cb-bap-val">--</span>
          <span class="text-xs font-mono font-bold text-muted">µg/kg</span>
          <span class="text-xs font-bold px-2 py-0.5 rounded-full uppercase ml-auto" id="cb-bap-badge">--</span>
        </div>
        <div class="w-full bg-surface h-1.5 rounded-full overflow-hidden mt-3 border border-hairline">
          <div class="h-full bg-emerald-500 transition-all duration-300" id="cb-bap-bar" style="width: 20%"></div>
        </div>
      </div>

      <!-- Key Diagnostic KPI 2: Cook Breathing Zone Inhalation Exposure -->
      <div class="bg-surface-soft border border-hairline rounded-xl p-4">
        <div class="text-xs text-muted font-medium mb-1">{d.inhalationLabel}</div>
        <div class="flex items-baseline gap-2">
          <span class="text-2xl md:text-3xl font-black text-ink tracking-tight" id="cb-inhalation-val">--</span>
          <span class="text-xs font-mono font-bold text-muted">mg/m³</span>
          <span class="text-xs font-bold px-2 py-0.5 rounded-full uppercase ml-auto" id="cb-inhalation-badge">--</span>
        </div>
        <div class="w-full bg-surface h-1.5 rounded-full overflow-hidden mt-3 border border-hairline">
          <div class="h-full bg-emerald-500 transition-all duration-300" id="cb-inhalation-bar" style="width: 25%"></div>
        </div>
      </div>

      <!-- Secondary KPIs: Plume Velocity & Flare-up Severity -->
      <div class="grid grid-cols-2 gap-3">
        <div class="bg-surface-soft border border-hairline rounded-xl p-3">
          <div class="text-[11px] text-muted font-medium mb-0.5">{d.plumeVelocityLabel}</div>
          <div class="text-sm font-bold text-ink" id="cb-velocity-val">-- m/s</div>
          <div class="text-[11px] font-medium text-emerald-600 mt-1" id="cb-capture-status">--</div>
        </div>
        <div class="bg-surface-soft border border-hairline rounded-xl p-3">
          <div class="text-[11px] text-muted font-medium mb-0.5">{d.flareUpSeverityLabel}</div>
          <div class="text-sm font-bold text-ink" id="cb-flare-val">--</div>
          <div class="text-[11px] font-medium text-muted mt-1" id="cb-flare-sub">--</div>
        </div>
      </div>

      <!-- Regulatory Status: NFPA 96 & OSHA 1910.1000 -->
      <div class="bg-surface-soft border border-hairline rounded-xl p-4 space-y-1">
        <div class="text-xs text-muted font-medium">{d.complianceLabel}</div>
        <div class="text-sm font-bold text-ink" id="cb-compliance-val">--</div>
        <p class="text-xs text-muted leading-relaxed" id="cb-compliance-desc">--</p>
      </div>

      <!-- Dominant Chemical Species -->
      <div class="bg-surface-soft border border-hairline rounded-xl p-4 space-y-1">
        <div class="text-xs text-muted font-medium">{d.dominantSpeciesLabel}</div>
        <div class="text-xs font-mono text-ink font-semibold" id="cb-species-val">--</div>
      </div>

      <!-- Kinetic Mechanism Details -->
      <div class="bg-surface-soft border border-hairline rounded-xl p-4 space-y-1">
        <div class="text-xs text-muted font-medium">{d.mechanismLabel}</div>
        <p class="text-xs text-muted leading-relaxed" id="cb-mechanism-text">--</p>
      </div>

      <!-- Mitigation Protocol -->
      <div class="bg-surface-soft border border-hairline rounded-xl p-4 space-y-1">
        <div class="text-xs text-muted font-medium">{d.mitigationLabel}</div>
        <p class="text-xs text-muted leading-relaxed" id="cb-mitigation-text">--</p>
      </div>

      <!-- Copy Report Button -->
      <div>
        <button 
          type="button" 
          id="cb-copy-report-btn" 
          class="w-full py-3 px-4 rounded-xl bg-ink text-surface font-semibold text-xs tracking-wide uppercase transition-transform active:scale-95 shadow-sm hover:opacity-90"
        >
          {d.copyReportBtn}
        </button>
        <p class="text-center text-xs text-emerald-600 font-semibold mt-1.5 hidden" id="cb-copied-feedback">
          {d.copiedFeedback}
        </p>
      </div>
    </div>
  </div>

  <!-- Comparative Engineering Matrix Table -->
  <div class="mt-12 pt-8 border-t border-hairline">
    <div class="mb-4">
      <h3 class="text-lg md:text-xl font-bold text-ink tracking-tight">{d.tableTitle}</h3>
      <p class="text-xs text-muted mt-0.5">{d.tableSub}</p>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-xs">
        <thead>
          <tr class="border-b border-hairline bg-surface-soft text-muted font-semibold uppercase tracking-wider">
            <th class="py-3 px-3.5">{d.colArch}</th>
            <th class="py-3 px-3.5">{d.colEmissivity}</th>
            <th class="py-3 px-3.5">{d.colFlareDamping}</th>
            <th class="py-3 px-3.5">{d.colGreaseChanneling}</th>
            <th class="py-3 px-3.5">{d.colPahAffinity}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline text-ink">
          {data.radiantArchitectures.map((arch) => (
            <tr class="hover:bg-surface/50 transition-colors">
              <td class="py-3 px-3.5 font-bold text-ink">{arch.name}</td>
              <td class="py-3 px-3.5 font-mono">{arch.emissivity}</td>
              <td class="py-3 px-3.5 font-mono">{arch.flareUpDampingFactor}</td>
              <td class="py-3 px-3.5 font-mono">{arch.greaseChannelingEfficiency}%</td>
              <td class="py-3 px-3.5 font-semibold">
                <span class={arch.pahAdsorptionAffinity === 'MINIMAL' ? 'text-emerald-600' : arch.pahAdsorptionAffinity === 'LOW' ? 'text-blue-600' : arch.pahAdsorptionAffinity === 'HIGH' ? 'text-amber-600' : 'text-rose-600 font-bold'}>
                  {arch.pahAdsorptionAffinity}
                </span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Critical Directives Rules Cards -->
  <div class="mt-12 pt-8 border-t border-hairline">
    <div class="mb-6">
      <h3 class="text-lg md:text-xl font-bold text-ink tracking-tight">{d.rulesTitle}</h3>
      <p class="text-xs text-muted mt-0.5">{d.rulesSub}</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="bg-surface border border-hairline rounded-2xl p-5">
        <div class="flex items-center gap-2 mb-2 text-rose-600 font-bold text-sm">
          <span>🚫</span>
          <h4>{d.rule1Title}</h4>
        </div>
        <p class="text-xs text-muted leading-relaxed">{d.rule1Text}</p>
      </div>

      <div class="bg-surface border border-hairline rounded-2xl p-5">
        <div class="flex items-center gap-2 mb-2 text-amber-600 font-bold text-sm">
          <span>💨</span>
          <h4>{d.rule2Title}</h4>
        </div>
        <p class="text-xs text-muted leading-relaxed">{d.rule2Text}</p>
      </div>

      <div class="bg-surface border border-hairline rounded-2xl p-5">
        <div class="flex items-center gap-2 mb-2 text-blue-600 font-bold text-sm">
          <span>🧹</span>
          <h4>{d.rule3Title}</h4>
        </div>
        <p class="text-xs text-muted leading-relaxed">{d.rule3Text}</p>
      </div>

      <div class="bg-surface border border-hairline rounded-2xl p-5">
        <div class="flex items-center gap-2 mb-2 text-emerald-600 font-bold text-sm">
          <span>💧</span>
          <h4>{d.rule4Title}</h4>
        </div>
        <p class="text-xs text-muted leading-relaxed">{d.rule4Text}</p>
      </div>
    </div>
  </div>
</div>

<!-- Reactive Script -->
<script is:inline define:vars={{ data, currentLang: lang }}>
  (function initCharbroilerModeler() {
    const radiantSelect = document.getElementById('cb-radiant-select');
    const meatSelect = document.getElementById('cb-meat-select');
    const tempSelect = document.getElementById('cb-temp-select');
    const durationSlider = document.getElementById('cb-duration-slider');
    const durationVal = document.getElementById('cb-duration-val');
    const ventSelect = document.getElementById('cb-vent-select');
    const suppressionSelect = document.getElementById('cb-suppression-select');

    // Outputs
    const bapVal = document.getElementById('cb-bap-val');
    const bapBadge = document.getElementById('cb-bap-badge');
    const bapBar = document.getElementById('cb-bap-bar');
    const inhalationVal = document.getElementById('cb-inhalation-val');
    const inhalationBadge = document.getElementById('cb-inhalation-badge');
    const inhalationBar = document.getElementById('cb-inhalation-bar');
    const velocityVal = document.getElementById('cb-velocity-val');
    const captureStatus = document.getElementById('cb-capture-status');
    const flareVal = document.getElementById('cb-flare-val');
    const flareSub = document.getElementById('cb-flare-sub');
    const complianceVal = document.getElementById('cb-compliance-val');
    const complianceDesc = document.getElementById('cb-compliance-desc');
    const speciesVal = document.getElementById('cb-species-val');
    const mechanismText = document.getElementById('cb-mechanism-text');
    const mitigationText = document.getElementById('cb-mitigation-text');
    const pulseDot = document.getElementById('cb-pulse-dot');
    const copyReportBtn = document.getElementById('cb-copy-report-btn');
    const copiedFeedback = document.getElementById('cb-copied-feedback');

    if (!radiantSelect || !meatSelect) return;

    function recalculate() {
      const radiantId = radiantSelect.value;
      const meatId = meatSelect.value;
      const tempC = parseInt(tempSelect.value, 10);
      const durationMins = parseInt(durationSlider.value, 10);
      const ventId = ventSelect.value;
      const suppressionMode = suppressionSelect.value;

      durationVal.textContent = durationMins + ' ' + (currentLang === 'ja' ? '分' : currentLang === 'zh-cn' ? '分钟' : 'mins');

      const radiant = data.radiantArchitectures.find(r => r.id === radiantId) || data.radiantArchitectures[0];
      const meat = data.meatProfiles.find(m => m.id === meatId) || data.meatProfiles[0];
      const tempObj = data.radiantTemperatures.find(t => t.tempC === tempC) || data.radiantTemperatures[1];
      const vent = data.ventilationProfiles.find(v => v.id === ventId) || data.ventilationProfiles[1];

      // 1. Flare-up multiplier from fat drip rate vs channeling
      const unchanneledDrip = meat.dripRatePerMinMl * (1 - (radiant.greaseChannelingEfficiency / 100));
      let suppressionMultiplier = 1.0;
      if (suppressionMode === 'mechanical_scraping') suppressionMultiplier = 0.55;
      else if (suppressionMode === 'dry_salt') suppressionMultiplier = 0.70;
      else if (suppressionMode === 'water_spray') suppressionMultiplier = 2.40; // Flash steam aerosol explosion!
      else if (suppressionMode === 'unattended_burn') suppressionMultiplier = 1.85;

      const flareIndex = (unchanneledDrip * tempObj.pyrolysisRateMultiplier * suppressionMultiplier * (1 / radiant.flareUpDampingFactor)).toFixed(1);

      // 2. Benzo[a]pyrene meat surface adsorption (µg/kg)
      // EU limit is 5.0 µg/kg
      const tempExponent = Math.max(0.6, (tempC - 350) / 200);
      let calculatedBaP = (meat.basePahPotentialUgg * (durationMins / 8) * tempExponent * suppressionMultiplier * (1 - (radiant.greaseChannelingEfficiency / 140))).toFixed(1);
      calculatedBaP = Math.max(0.4, calculatedBaP);

      // 3. Convective Plume Velocity (m/s)
      const plumeVelocity = (tempObj.plumeVelocityMs * (1 + (unchanneledDrip / 30) * (suppressionMode === 'water_spray' ? 1.6 : 1.0))).toFixed(2);

      // 4. Inhalation exposure in line cook breathing zone (mg/m³)
      // OSHA PEL is 0.20 mg/m³
      const spillagePercent = (100 - vent.captureEfficiencyPercent) / 100;
      const baseEmissionRateMgMin = (meat.dripRatePerMinMl * tempObj.pyrolysisRateMultiplier * 0.45 * suppressionMultiplier);
      const ambientExposureMgM3 = Math.max(0.01, (baseEmissionRateMgMin * spillagePercent * (plumeVelocity / 1.0) * 0.38)).toFixed(3);

      // DOM Updates
      bapVal.textContent = calculatedBaP;
      if (calculatedBaP < 5.0) {
        bapBadge.textContent = currentLang === 'es' ? 'CONFORME UE' : currentLang === 'pt' ? 'CONFORME UE' : currentLang === 'zh-cn' ? '符合欧盟限量' : currentLang === 'ja' ? 'EU基準適合' : 'EU COMPLIANT';
        bapBadge.className = 'text-xs font-bold px-2 py-0.5 rounded-full uppercase ml-auto bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20';
        bapBar.className = 'h-full bg-emerald-500 transition-all duration-300';
        bapBar.style.width = Math.min(100, (calculatedBaP / 5.0) * 50) + '%';
      } else if (calculatedBaP < 15.0) {
        bapBadge.textContent = currentLang === 'es' ? 'ELEVADO' : currentLang === 'pt' ? 'ELEVADO' : currentLang === 'zh-cn' ? '中度超标' : currentLang === 'ja' ? '基準超過' : 'ELEVATED';
        bapBadge.className = 'text-xs font-bold px-2 py-0.5 rounded-full uppercase ml-auto bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20';
        bapBar.className = 'h-full bg-amber-500 transition-all duration-300';
        bapBar.style.width = Math.min(100, 50 + ((calculatedBaP - 5) / 10) * 30) + '%';
      } else {
        bapBadge.textContent = currentLang === 'es' ? 'PELIGRO TÓXICO' : currentLang === 'pt' ? 'PERIGO TÓXICO' : currentLang === 'zh-cn' ? '严重致癌高危' : currentLang === 'ja' ? '極度発癌危険' : 'SEVERE HAZARD';
        bapBadge.className = 'text-xs font-bold px-2 py-0.5 rounded-full uppercase ml-auto bg-rose-500/10 text-rose-700 dark:text-rose-400 border border-rose-500/20';
        bapBar.className = 'h-full bg-rose-500 transition-all duration-300';
        bapBar.style.width = '100%';
      }

      inhalationVal.textContent = ambientExposureMgM3;
      if (ambientExposureMgM3 <= 0.10) {
        inhalationBadge.textContent = 'OSHA OK';
        inhalationBadge.className = 'text-xs font-bold px-2 py-0.5 rounded-full uppercase ml-auto bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20';
        inhalationBar.className = 'h-full bg-emerald-500 transition-all duration-300';
        inhalationBar.style.width = Math.min(100, (ambientExposureMgM3 / 0.20) * 100) + '%';
      } else if (ambientExposureMgM3 <= 0.20) {
        inhalationBadge.textContent = 'NEAR PEL';
        inhalationBadge.className = 'text-xs font-bold px-2 py-0.5 rounded-full uppercase ml-auto bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20';
        inhalationBar.className = 'h-full bg-amber-500 transition-all duration-300';
        inhalationBar.style.width = Math.min(100, (ambientExposureMgM3 / 0.20) * 100) + '%';
      } else {
        inhalationBadge.textContent = 'OSHA BREACH';
        inhalationBadge.className = 'text-xs font-bold px-2 py-0.5 rounded-full uppercase ml-auto bg-rose-500/10 text-rose-700 dark:text-rose-400 border border-rose-500/20';
        inhalationBar.className = 'h-full bg-rose-500 transition-all duration-300';
        inhalationBar.style.width = '100%';
      }

      velocityVal.textContent = plumeVelocity + ' m/s';
      if (vent.captureEfficiencyPercent >= 90) {
        captureStatus.textContent = currentLang === 'es' ? 'Captura 96% Estable (NFPA 96 OK)' : currentLang === 'pt' ? 'Captura 96% Estável (NFPA 96 OK)' : currentLang === 'zh-cn' ? '96%稳定捕集 (NFPA 96合格)' : currentLang === 'ja' ? '96%安定捕集 (NFPA 96準拠)' : '96% Stable Capture (NFPA 96 Compliant)';
        captureStatus.className = 'text-[11px] font-medium text-emerald-600 mt-1';
      } else if (vent.captureEfficiencyPercent >= 70) {
        captureStatus.textContent = currentLang === 'es' ? 'Desbordamiento Límite 28% (Alerta)' : currentLang === 'pt' ? 'Transbordamento Limite 28% (Alerta)' : currentLang === 'zh-cn' ? '边界外溢28% (警告)' : currentLang === 'ja' ? '気流境界漏れ28% (警戒)' : 'Border Spillage 28% (Warning)';
        captureStatus.className = 'text-[11px] font-medium text-amber-600 mt-1';
      } else {
        captureStatus.textContent = currentLang === 'es' ? 'Fallo Severo de Extracción (59% Fuga)' : currentLang === 'pt' ? 'Falha Severa de Exaustão (59% Fuga)' : currentLang === 'zh-cn' ? '严重排烟失效 (59%外溢厨师呼吸区)' : currentLang === 'ja' ? '排気完全破綻 (59%厨房拡散)' : 'Severe Capture Failure (59% Spillage)';
        captureStatus.className = 'text-[11px] font-medium text-rose-600 mt-1';
      }

      flareVal.textContent = flareIndex > 25 ? (currentLang === 'ja' ? '大火炎爆燃' : currentLang === 'zh-cn' ? '剧烈起火爆燃' : 'Extreme Inferno') : flareIndex > 12 ? (currentLang === 'ja' ? '活発な炎' : currentLang === 'zh-cn' ? '显著油脂火苗' : 'Active Flare-Up') : (currentLang === 'ja' ? '制御された熱' : currentLang === 'zh-cn' ? '平稳受控' : 'Controlled Sear');
      flareSub.textContent = `Index: ${flareIndex} (Unchanneled: ${unchanneledDrip.toFixed(1)} mL/min)`;

      if (ambientExposureMgM3 <= 0.20 && calculatedBaP < 5.0 && vent.captureEfficiencyPercent >= 90) {
        complianceVal.textContent = 'PASS: NFPA 96 & OSHA 1910.1000 Compliant';
        complianceVal.className = 'text-sm font-bold text-emerald-600';
        complianceDesc.textContent = currentLang === 'es' ? 'Flujo de aire adecuado con drenaje óptimo de grasa. Las emisiones de BaP cumplen con los umbrales de seguridad alimentaria.' : currentLang === 'zh-cn' ? '排风量充沛且油脂导流顺畅，表面BaP吸附量低于欧盟食品安全标准红线。' : currentLang === 'ja' ? '十分な排気風量と適正な排油により、BaP残留量・PAH呼吸暴露ともに安全基準内。' : 'Optimal thermal capture velocity with adequate grease channeling. BaP surface deposition is within European food safety thresholds.';
        pulseDot.className = 'inline-block w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse';
      } else if (ambientExposureMgM3 > 0.20) {
        complianceVal.textContent = 'BREACH: OSHA Coal Tar Volatiles Inhalation Limit';
        complianceVal.className = 'text-sm font-bold text-rose-600';
        complianceDesc.textContent = currentLang === 'es' ? 'Alerta: La concentración de HAP en la zona de respiración del cocinero supera los 0,20 mg/m³ permitidos por OSHA.' : currentLang === 'zh-cn' ? '重大违规：后厨厨师呼吸带PAH暴露浓度突破OSHA 0.20 mg/m³法定职业安全上限！' : currentLang === 'ja' ? '重大警告：調理師呼吸域のPAH気相濃度がOSHA法定許容濃度（0.20 mg/m³）を超過！' : 'Urgent: Line cook breathing zone total PAH concentration exceeds OSHA 0.20 mg/m³ permissible exposure limit.';
        pulseDot.className = 'inline-block w-2.5 h-2.5 rounded-full bg-rose-500 animate-pulse';
      } else {
        complianceVal.textContent = 'WARNING: Elevated Dietary Carcinogen Residue';
        complianceVal.className = 'text-sm font-bold text-amber-600';
        complianceDesc.textContent = currentLang === 'es' ? 'Nivel elevado de Benzo[a]pireno en la carne (>5.0 µg/kg). Se requiere mayor frecuencia de desgrasado mecánico.' : currentLang === 'zh-cn' ? '警告：肉品表面苯并[a]芘积累量突破欧盟5.0 µg/kg警戒线，需强化刮油与导油维护。' : currentLang === 'ja' ? '警告：肉表面のベンゾ[a]ピレンがEU許容値（5.0 µg/kg）を超過。機械的スクレーパー除煙が必要。' : 'Meat surface Benzo[a]pyrene exceeds EU 5.0 µg/kg benchmark due to prolonged flare-up smoke contact.';
        pulseDot.className = 'inline-block w-2.5 h-2.5 rounded-full bg-amber-500 animate-pulse';
      }

      speciesVal.textContent = suppressionMode === 'water_spray' 
        ? 'Aerosolized Triglyceride Droplets (PM2.5) > Benzo[a]pyrene (BaP) > Acrolein > PhIP' 
        : 'Benzo[a]pyrene (BaP) > Chrysene > Benzo[b]fluoranthene > Phenanthrene';

      mechanismText.textContent = suppressionMode === 'water_spray'
        ? (currentLang === 'es' ? 'Explosión por vaporización súbita de agua sobre grasa a >600°C. La expansión volumétrica atomiza lípidos en un penacho inflamable rico en micropartículas PM2.5 y HAP.' : currentLang === 'zh-cn' ? '水在炽热熔融油脂（>600°C）上瞬间相变剧烈爆炸，体积膨胀1700倍导致油脂细雾化形成火球，产生巨量PM2.5与高浓度苯并[a]芘。' : currentLang === 'ja' ? '600°C超の高温油に水が触れ瞬間蒸気爆発（体積1700倍膨張）。油脂が超微小ミスト（PM2.5）として飛散し高濃度PAH煙を形成。' : 'Flash steam expansion (1,700x volume surge) instantly atomizes molten animal lipids into a fireball aerosol, multiplying PM2.5 aerosol plumes and respirable BaP.')
        : (currentLang === 'es' ? `Termólisis de triglicéridos a ${tempC}°C sobre deflectores con recombinación de radicales libres en fase gaseosa (pirólisis Diels-Alder), condensando sobre la carne.` : currentLang === 'zh-cn' ? `甘油三酯在${tempC}°C辐射板上发生深度热解裂解，脱氢产生的环戊二烯基自由基在气相中经Diels-Alder重组聚合为四环及五环多环芳烃（PAH），随上升烟雾凝结吸附在食材表面。` : currentLang === 'ja' ? `${tempC}°Cの放射板上で中性脂肪が熱分解開裂し、気相中でのラジカル重合（ディールス・アルダー反応）により多環芳香族炭化水素が再合成され肉表面に吸着。` : `Pyrosynthesis of C16-C22 aromatic rings via Diels-Alder free radical additions of unsaturated fatty acid fragments at ${tempC}°C, depositing on cooling meat surfaces.`);

      mitigationText.textContent = vent.captureEfficiencyPercent < 90
        ? (currentLang === 'es' ? 'Aumente el caudal de la campana a 400 CFM/pie lineal según NFPA 96 e instale rejillas con drenaje del 85% hacia bandeja con agua fría.' : currentLang === 'zh-cn' ? '立即提升排风量至NFPA 96规定的400 CFM/线性英尺，并更换为85%高效导油V形槽，将熔融油脂导入冷水收集托盘。' : currentLang === 'ja' ? 'NFPA 96準拠の400 CFM/ft専用排気へと増強し、油脂の85%を直火に触れさせず冷水パンへ誘導する傾斜V型焼き網を採用してください。' : 'Upgrade exhaust ventilation to NFPA 96 heavy-duty 400 CFM/linear ft canopy hood. Implement 85% grease-channeling V-baffles draining into an unheated water pan.')
        : (currentLang === 'es' ? 'Mantenga el raspado mecánico cada 30 minutos y asegure la limpieza diaria de los filtros de grasa para evitar sobrecargas térmicas.' : currentLang === 'zh-cn' ? '保持每30分钟机械刮除导油槽油泥，每日清洗挡火滤油网，确保排烟风道动压维持在设计工况。' : currentLang === 'ja' ? '30分ごとの機械的スクレーピング排油を維持し、バッフルフィルターの定期洗浄により安定した排気静圧を保持してください。' : 'Maintain routine 30-minute mechanical scraping of grease channels and clean grease baffle filters daily to preserve design capture velocity.');
    }

    // Attach Listeners
    radiantSelect.addEventListener('change', recalculate);
    meatSelect.addEventListener('change', recalculate);
    tempSelect.addEventListener('change', recalculate);
    durationSlider.addEventListener('input', recalculate);
    ventSelect.addEventListener('change', recalculate);
    suppressionSelect.addEventListener('change', recalculate);

    // Preset Buttons
    const presetButtons = document.querySelectorAll('.preset-btn');
    presetButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const p = btn.getAttribute('data-preset');
        if (p === 'burger-shack') {
          radiantSelect.value = 'aged_pitted_cast_iron';
          meatSelect.value = 'beef_burger_80_20';
          tempSelect.value = '700';
          durationSlider.value = '10';
          ventSelect.value = 'standard_hood_degraded';
          suppressionSelect.value = 'unattended_burn';
        } else if (p === 'nfpa-master') {
          radiantSelect.value = 'hardox_flame_shield';
          meatSelect.value = 'beef_burger_80_20';
          tempSelect.value = '565';
          durationSlider.value = '6';
          ventSelect.value = 'nfpa96_optimal';
          suppressionSelect.value = 'mechanical_scraping';
        } else if (p === 'pork-inferno') {
          radiantSelect.value = 'ceramic_briquettes';
          meatSelect.value = 'marinated_pork_ribs';
          tempSelect.value = '700';
          durationSlider.value = '12';
          ventSelect.value = 'compromised_spill';
          suppressionSelect.value = 'water_spray';
        } else if (p === 'lean-sirloin') {
          radiantSelect.value = 'cast_iron_chevron';
          meatSelect.value = 'sirloin_steak_90_10';
          tempSelect.value = '565';
          durationSlider.value = '8';
          ventSelect.value = 'nfpa96_optimal';
          suppressionSelect.value = 'mechanical_scraping';
        }
        recalculate();
      });
    });

    // Copy Report
    if (copyReportBtn) {
      copyReportBtn.addEventListener('click', () => {
        const text = `=== ISITKITCHENSAFE CHARBROILER COMBUSTION & PAH REPORT ===
Radiant Architecture: ${radiantSelect.options[radiantSelect.selectedIndex].text}
Meat Profile: ${meatSelect.options[meatSelect.selectedIndex].text}
Surface Temperature: ${tempSelect.value}°C
Duration: ${durationSlider.value} minutes
Ventilation Capacity: ${ventSelect.options[ventSelect.selectedIndex].text}
Suppression Technique: ${suppressionSelect.options[suppressionSelect.selectedIndex].text}

DIAGNOSTIC OUTCOMES:
- Surface Benzo[a]pyrene: ${bapVal.textContent} µg/kg (EU Benchmark: <5.0 µg/kg) [${bapBadge.textContent}]
- Cook Breathing Zone PAH Exposure: ${inhalationVal.textContent} mg/m³ (OSHA PEL: <0.20 mg/m³) [${inhalationBadge.textContent}]
- Plume Velocity & Hood Capture: ${velocityVal.textContent} - ${captureStatus.textContent}
- Grease Flare Severity: ${flareVal.textContent} (${flareSub.textContent})
- Regulatory Status: ${complianceVal.textContent}
- Dominant Toxicants: ${speciesVal.textContent}
- Chemical Mechanism: ${mechanismText.textContent}
- Engineering Mitigation: ${mitigationText.textContent}
Audit Engine: IsItKitchenSafe Autonomous Growth & Ops Engine v2.0
=============================================================`;

        navigator.clipboard.writeText(text).then(() => {
          copiedFeedback.classList.remove('hidden');
          setTimeout(() => {
            copiedFeedback.classList.add('hidden');
          }, 3000);
        }).catch(err => {
          console.error('Clipboard copy failed:', err);
        });
      });
    }

    // Initial calculation
    recalculate();
  })();
</script>
