---

<div class="not-prose my-8 rounded-2xl bg-slate-900 border border-slate-800 p-6 md:p-8 text-slate-100 shadow-2xl">
  <!-- Header Badge & Title -->
  <div class="mb-6 flex flex-wrap items-center justify-between gap-4 border-b border-slate-800 pb-6">
    <div>
      <span class="inline-flex items-center gap-1.5 rounded-full bg-cyan-500/10 px-3 py-1 text-xs font-semibold text-cyan-400 border border-cyan-500/20">
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
        </svg>
        {t.badge}
      </span>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-white md:text-3xl">
        {t.title}
      </h2>
      <p class="mt-1 text-sm text-slate-400 max-w-4xl leading-relaxed">
        {t.subtitle}
      </p>
    </div>
  </div>

  <!-- Operational Presets -->
  <div class="mb-8 rounded-xl bg-slate-800/60 p-4 border border-slate-700/60">
    <div class="flex items-center justify-between mb-3">
      <span class="text-xs font-bold uppercase tracking-wider text-cyan-400">{t.presetsTitle}</span>
      <span class="text-[11px] text-slate-400">Click to load calibrated industrial refrigeration profiles</span>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5">
      <button type="button" id="btnPresetIQFProduce" class="px-3 py-2 text-left rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 text-xs font-medium text-slate-200 transition-colors flex flex-col justify-between">
        <span class="font-semibold text-cyan-300">IQF Wet Strawberries</span>
        <span class="text-[11px] text-slate-400 mt-1 line-clamp-1">{t.presetIQFProduce}</span>
      </button>
      <button type="button" id="btnPresetCookedPoultry" class="px-3 py-2 text-left rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 text-xs font-medium text-slate-200 transition-colors flex flex-col justify-between">
        <span class="font-semibold text-amber-300">Steamed Poultry</span>
