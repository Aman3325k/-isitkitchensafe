  const inputFrostMm = document.getElementById('inputFrostMm');
  const inputHotGasPress = document.getElementById('inputHotGasPress');
  const inputChargeKg = document.getElementById('inputChargeKg');
  const inputVentilationCfm = document.getElementById('inputVentilationCfm');
  const inputSensorSetPpm = document.getElementById('inputSensorSetPpm');

  const valBoxTemp = document.getElementById('valBoxTemp');
  const valRuntime = document.getElementById('valRuntime');
  const valFrostMm = document.getElementById('valFrostMm');
  const valHotGasPress = document.getElementById('valHotGasPress');
  const valChargeKg = document.getElementById('valChargeKg');
  const valVentilationCfm = document.getElementById('valVentilationCfm');
  const valSensorSetPpm = document.getElementById('valSensorSetPpm');

  // Diagnostic Cards & Progress Bars
  const cardUValueVal = document.getElementById('cardUValueVal');
  const barUValue = document.getElementById('barUValue');
  const cardUValueStatus = document.getElementById('cardUValueStatus');

  const cardPressureDropVal = document.getElementById('cardPressureDropVal');
  const barPressureDrop = document.getElementById('barPressureDrop');
  const cardPressureDropStatus = document.getElementById('cardPressureDropStatus');

  const cardThermalStressVal = document.getElementById('cardThermalStressVal');
  const barThermalStress = document.getElementById('barThermalStress');
  const cardThermalStressStatus = document.getElementById('cardThermalStressStatus');

  const cardNh3LeakVal = document.getElementById('cardNh3LeakVal');
  const barNh3Leak = document.getElementById('barNh3Leak');
  const cardNh3LeakStatus = document.getElementById('cardNh3LeakStatus');

  const cardVentilationMarginVal = document.getElementById('cardVentilationMarginVal');
  const barVentilationMargin = document.getElementById('barVentilationMargin');
  const cardVentilationMarginStatus = document.getElementById('cardVentilationMarginStatus');

  // Status Banner & Readouts
  const statusBanner = document.getElementById('statusBanner');
  const statusIconContainer = document.getElementById('statusIconContainer');
  const statusTitle = document.getElementById('statusTitle');
  const statusTag = document.getElementById('statusTag');
  const readoutPrimaryRisk = document.getElementById('readoutPrimaryRisk');
  const readoutMechanisms = document.getElementById('readoutMechanisms');
  const readoutMitigation = document.getElementById('readoutMitigation');

  const readoutFrostR = document.getElementById('readoutFrostR');
  const readoutRequiredCfm = document.getElementById('readoutRequiredCfm');
  const readoutWaterHammer = document.getElementById('readoutWaterHammer');
  const readoutIdlhMargin = document.getElementById('readoutIdlhMargin');

  // Preset Buttons
  const btnPresetIQFProduce = document.getElementById('btnPresetIQFProduce');
  const btnPresetCookedPoultry = document.getElementById('btnPresetCookedPoultry');
  const btnPresetLegacyFailure = document.getElementById('btnPresetLegacyFailure');
  const btnPresetBakeryDeluge = document.getElementById('btnPresetBakeryDeluge');

  const btnCopyReport = document.getElementById('btnCopyReport');
  const lblCopyBtn = document.getElementById('lblCopyBtn');

  function calculateTelemetry() {
    const equipId = selectEquipment.value;
    const productId = selectProduct.value;
    const defrostId = selectDefrost.value;

    const equip = data.freezerArchitectures.find(e => e.id === equipId) || data.freezerArchitectures[0];
    const product = data.foodProducts.find(p => p.id === productId) || data.foodProducts[0];
    const defrost = data.defrostMethods.find(d => d.id === defrostId) || data.defrostMethods[0];

    const boxTemp = parseFloat(inputBoxTemp.value);
    const runtime = parseFloat(inputRuntime.value);
    const frostMm = parseFloat(inputFrostMm.value);
    const hotGasPress = parseFloat(inputHotGasPress.value);
    const chargeKg = parseFloat(inputChargeKg.value);
    const ventilationCfm = parseFloat(inputVentilationCfm.value);
    const sensorSetPpm = parseFloat(inputSensorSetPpm.value);

    // Dynamic slider labels
    const boxTempF = Math.round(boxTemp * 1.8 + 32);
    valBoxTemp.textContent = `${boxTemp}°C (${boxTempF}°F)`;
    valRuntime.textContent = `${runtime} hrs`;
    valFrostMm.textContent = `${frostMm.toFixed(1)} mm`;
    valHotGasPress.textContent = `${hotGasPress.toFixed(1)} bar`;
    const chargeLbs = Math.round(chargeKg * 2.20462);
    valChargeKg.textContent = `${chargeKg} kg (${chargeLbs} lbs)`;
    valVentilationCfm.textContent = `${ventilationCfm.toLocaleString()} CFM`;
    valSensorSetPpm.textContent = `${sensorSetPpm} ppm (${sensorSetPpm <= 50 ? 'Level 1' : 'Level 2'})`;

    // 1. Evaporator Overall Heat Transfer U-Value (W/m²·K)
    // Clean U ~ 38.5 W/m²·K. Frost acts as conductive thermal resistance: R_frost = x_frost / k_frost.
    // k_frost varies between 0.16 (dendritic) and 0.32 (clean/rime).
    const kFrost = (product.id === 'warm_parbaked_bakery_pastries') ? 0.16 : (product.id === 'iqf_fruits_vegetables_produce' ? 0.28 : 0.22);
    const xFrostM = frostMm / 1000;
    const rFrost = xFrostM / kFrost; // m²·K/W
    const cleanU = data.frostThermalPhysics.cleanCoilOverallUValueWm2K;
    const currentU = Math.max(6.5, 1 / ((1 / cleanU) + rFrost));
    cardUValueVal.textContent = currentU.toFixed(1);
    const uPercent = (currentU / cleanU) * 100;
    barUValue.style.width = `${Math.min(100, Math.max(10, uPercent))}%`;

    if (currentU > 28) {
      cardUValueStatus.textContent = 'Optimal Coil Heat Flux (>28 W/m²·K)';
      cardUValueStatus.className = 'mt-1.5 block text-[10px] font-medium text-emerald-400';
      barUValue.className = 'h-full bg-emerald-400 transition-all duration-300';
    } else if (currentU >= 15) {
      cardUValueStatus.textContent = 'Degraded Heat Transfer (15–28 W/m²·K)';
      cardUValueStatus.className = 'mt-1.5 block text-[10px] font-medium text-amber-400';
      barUValue.className = 'h-full bg-amber-400 transition-all duration-300';
    } else {
      cardUValueStatus.textContent = 'SEVERE FROST BLANKET (<15 W/m²·K) — Freezing Failure';
      cardUValueStatus.className = 'mt-1.5 block text-[10px] font-medium text-rose-400';
      barUValue.className = 'h-full bg-rose-500 transition-all duration-300';
    }

    // 2. Air-Side Static Pressure Drop (Pa) & Throat Choking
    // Clean pressure drop ~ 140 Pa. Exponentially increases with frostMm / finSpacing.
    const finSpacing = equip.finSpacingMm;
    const bridgingRatio = (frostMm * 2) / finSpacing;
    const baseAirDrop = data.frostThermalPhysics.airSidePressureDropCleanPa;
    const currentAirDrop = Math.min(1250, baseAirDrop * Math.pow(Math.max(1, 1 / (1 - Math.min(0.85, bridgingRatio * 0.45))), 2.4));
    cardPressureDropVal.textContent = Math.round(currentAirDrop);
    const pDropPercent = Math.min(100, (currentAirDrop / 800) * 100);
    barPressureDrop.style.width = `${pDropPercent}%`;

    if (currentAirDrop < 280) {
      cardPressureDropStatus.textContent = 'Free Airflow Path (<280 Pa)';
      cardPressureDropStatus.className = 'mt-1.5 block text-[10px] font-medium text-emerald-400';
      barPressureDrop.className = 'h-full bg-emerald-400 transition-all duration-300';
    } else if (currentAirDrop < 550) {
      cardPressureDropStatus.textContent = 'Elevated Fin Choking & Air Bypass (280–550 Pa)';
      cardPressureDropStatus.className = 'mt-1.5 block text-[10px] font-medium text-amber-400';
      barPressureDrop.className = 'h-full bg-amber-400 transition-all duration-300';
    } else {
      cardPressureDropStatus.textContent = 'CRITICAL THROAT CHOKE (>550 Pa) — Fan Surge';
      cardPressureDropStatus.className = 'mt-1.5 block text-[10px] font-medium text-rose-400';
      barPressureDrop.className = 'h-full bg-rose-500 transition-all duration-300';
    }

    // 3. Pipe Weld Thermal Expansion Stress (MPa)
    // Governed by hotGasPress, defrost method shock factor, and pipe material
    let baseThermalStress = defrost.thermalExpansionStressMpa;
    if (defrost.id === 'rapid_hot_gas_hard_shock') {
      baseThermalStress = 120 + (hotGasPress - 6) * 10;
    } else if (defrost.id === 'automated_hot_gas_soft_reversal') {
      baseThermalStress = 30 + (hotGasPress - 6) * 2.2;
    }
    if (equip.id === 'unvented_legacy_spiral_freezer') {
      baseThermalStress *= 1.45; // degraded pitted welds
    }
    const currentStressMpa = Math.min(320, baseThermalStress);
    cardThermalStressVal.textContent = Math.round(currentStressMpa);
    const stressPercent = (currentStressMpa / 250) * 100;
    barThermalStress.style.width = `${Math.min(100, stressPercent)}%`;

    if (currentStressMpa < 90) {
      cardThermalStressStatus.textContent = 'Safe Elastic Range (<90 MPa)';
      cardThermalStressStatus.className = 'mt-1.5 block text-[10px] font-medium text-emerald-400';
      barThermalStress.className = 'h-full bg-emerald-400 transition-all duration-300';
    } else if (currentStressMpa < 160) {
      cardThermalStressStatus.textContent = 'Elevated Fatigue Cycling (90–160 MPa)';
      cardThermalStressStatus.className = 'mt-1.5 block text-[10px] font-medium text-amber-400';
      barThermalStress.className = 'h-full bg-amber-400 transition-all duration-300';
    } else {
      cardThermalStressStatus.textContent = 'CRITICAL WATER-HAMMER SHOCK (>160 MPa) — Weld Rupture Risk';
      cardThermalStressStatus.className = 'mt-1.5 block text-[10px] font-medium text-rose-400 font-bold';
      barThermalStress.className = 'h-full bg-rose-500 transition-all duration-300';
    }

    // 4. Room Ammonia Concentration (ppm)
    // If stress > 160 MPa or legacy equipment with hard shock, pipe weld cracks!
    const isWeldCracked = (currentStressMpa > 150) || (defrost.id === 'rapid_hot_gas_hard_shock' && equip.id === 'unvented_legacy_spiral_freezer');
    let leakRateKgMin = 0.05; // normal minor valve stem weeping
    if (isWeldCracked) {
      leakRateKgMin = 8.5 + (chargeKg * 0.015); // massive header rupture
    } else if (currentStressMpa > 100) {
      leakRateKgMin = 0.45; // hairline fatigue fissure
    }

    // Steady-state indoor concentration: C_ppm = (Leak Rate / Ventilation)
    // 1 kg/min of NH3 ≈ 1,420 liters of pure vapor per min ≈ 50.1 CFM of pure gas
    const gasVolumeCfm = leakRateKgMin * 50.1;
    const roomConcentrationPpm = Math.max(5, Math.min(2500, (gasVolumeCfm / Math.max(100, ventilationCfm)) * 1e6));
    cardNh3LeakVal.textContent = Math.round(roomConcentrationPpm);
    const nh3Percent = (roomConcentrationPpm / 300) * 100;
    barNh3Leak.style.width = `${Math.min(100, Math.max(5, nh3Percent))}%`;

    if (roomConcentrationPpm < 25) {
      cardNh3LeakStatus.textContent = '< 25 ppm (Normal Background / Level 1 Supervisory)';
      cardNh3LeakStatus.className = 'mt-1.5 block text-[10px] font-medium text-emerald-400';
      barNh3Leak.className = 'h-full bg-emerald-400 transition-all duration-300';
    } else if (roomConcentrationPpm <= 150) {
      cardNh3LeakStatus.textContent = '25–150 ppm (Exceeds OSHA 50 ppm PEL) — Evacuate Zone';
      cardNh3LeakStatus.className = 'mt-1.5 block text-[10px] font-medium text-amber-400';
      barNh3Leak.className = 'h-full bg-amber-400 transition-all duration-300';
    } else {
      cardNh3LeakStatus.textContent = 'CRITICAL TOXIC EMERGENCY (>150 ppm) — Approaching 300 ppm IDLH';
      cardNh3LeakStatus.className = 'mt-1.5 block text-[10px] font-medium text-rose-400 font-bold';
      barNh3Leak.className = 'h-full bg-rose-500 transition-all duration-300';
    }

    // 5. IIAR 2 Chapter 6 Emergency Mechanical Ventilation Compliance (Q = 20 · √G)
    // G in lbs
    const requiredCfm = Math.round(20 * Math.sqrt(chargeLbs));
    readoutRequiredCfm.textContent = `${requiredCfm.toLocaleString()} CFM`;
    const ventilationRatio = ventilationCfm / Math.max(1, requiredCfm);
    cardVentilationMarginVal.textContent = `${ventilationRatio.toFixed(1)}×`;
    barVentilationMargin.style.width = `${Math.min(100, ventilationRatio * 35)}%`;

    if (ventilationRatio >= 1.0) {
      cardVentilationMarginStatus.textContent = 'Fully Compliant (Q_act ≥ 20·√G)';
      cardVentilationMarginStatus.className = 'mt-1.5 block text-[10px] font-medium text-emerald-400';
      barVentilationMargin.className = 'h-full bg-emerald-400 transition-all duration-300';
    } else {
      cardVentilationMarginStatus.textContent = 'DEFICIENT VENTILATION (Under IIAR 2 Mandate)';
      cardVentilationMarginStatus.className = 'mt-1.5 block text-[10px] font-medium text-rose-400 font-bold';
      barVentilationMargin.className = 'h-full bg-rose-500 transition-all duration-300';
    }

    // Overall Safety Status Determination
    const isCritical = isWeldCracked || (roomConcentrationPpm > 150) || (ventilationRatio < 0.6 && currentStressMpa > 130);
    const isElevated = !isCritical && (currentU < 18 || currentAirDrop > 450 || currentStressMpa > 95 || roomConcentrationPpm >= 25 || ventilationRatio < 1.0);

    readoutFrostR.textContent = `${rFrost.toFixed(3)} m²·K/W`;
    readoutWaterHammer.textContent = defrost.id === 'rapid_hot_gas_hard_shock' ? '> 42 bar (Violent)' : '< 4.5 bar (Soft)';
    const idlhRatio = 300 / Math.max(1, roomConcentrationPpm);
    readoutIdlhMargin.textContent = idlhRatio > 100 ? '>100× Safety' : `${idlhRatio.toFixed(1)}× Safety`;

    if (isCritical) {
      statusBanner.className = 'mb-8 rounded-xl bg-rose-950/60 p-5 border border-rose-700/80 transition-colors';
      statusIconContainer.className = 'rounded-lg bg-rose-500/20 p-2.5 text-rose-400 mt-0.5';
      statusTitle.textContent = 'ALERT: CATASTROPHIC AMMONIA LEAK & PIPE WELD RUPTURE HAZARD';
      statusTitle.className = 'text-base font-bold text-rose-300';
      statusTag.textContent = 'CRITICAL DANGER';
      statusTag.className = 'rounded-full bg-rose-500/30 px-2.5 py-0.5 text-xs font-bold text-rose-300 border border-rose-500/40';

      readoutPrimaryRisk.textContent = 'Severe hydraulic water-hammer shock sheared evaporator pipe welds; anhydrous ammonia discharging into room.';
      readoutMechanisms.textContent = `Weld stress (${Math.round(currentStressMpa)} MPa) > yield point; NH3 room concentration (${Math.round(roomConcentrationPpm)} ppm) exceeds Level 2 shutdown; ventilation deficit.`;
      readoutMitigation.textContent = 'EMERGENCY SHUTDOWN: Activate Level 2 auto-isolation valves; spool emergency exhaust fans to 100%; evacuate breathing zone immediately.';
    } else if (isElevated) {
      statusBanner.className = 'mb-8 rounded-xl bg-amber-950/50 p-5 border border-amber-700/70 transition-colors';
      statusIconContainer.className = 'rounded-lg bg-amber-500/20 p-2.5 text-amber-400 mt-0.5';
      statusTitle.textContent = 'WARNING: ELEVATED FROST RESISTANCE & THERMAL FATIGUE DETECTED';
      statusTitle.className = 'text-base font-bold text-amber-300';
      statusTag.textContent = 'ELEVATED RISK';
      statusTag.className = 'rounded-full bg-amber-500/20 px-2.5 py-0.5 text-xs font-bold text-amber-300 border border-amber-500/30';

      readoutPrimaryRisk.textContent = currentAirDrop > 450 ? 'Evaporator fin throat bridging choking air static pressure.' : 'Thermal expansion cycle stress approaching endurance limit.';
      readoutMechanisms.textContent = `U-value down to ${currentU.toFixed(1)} W/m²·K; static ΔP ${Math.round(currentAirDrop)} Pa; weld fatigue stress ${Math.round(currentStressMpa)} MPa.`;
      readoutMitigation.textContent = 'Initiate controlled soft-bleed defrost cycle; inspect header welds with ultrasonic non-destructive testing; verify sensor 25 ppm trip.';
    } else {
      statusBanner.className = 'mb-8 rounded-xl bg-emerald-950/40 p-5 border border-emerald-800/60 transition-colors';
      statusIconContainer.className = 'rounded-lg bg-emerald-500/20 p-2.5 text-emerald-400 mt-0.5';
      statusTitle.textContent = 'FULLY COMPLIANT (ANSI/IIAR 2-2021 & OSHA 1910.119 PSM VERIFIED)';
      statusTitle.className = 'text-base font-bold text-emerald-300';
      statusTag.textContent = 'LOW RISK';
      statusTag.className = 'rounded-full bg-emerald-500/20 px-2.5 py-0.5 text-xs font-bold text-emerald-300 border border-emerald-500/30';

      readoutPrimaryRisk.textContent = 'Controlled evaporator frosting within fin throat limits; minimal thermal fatigue cycle stress on carbon steel pipe welds.';
      readoutMechanisms.textContent = 'Fourier conduction frost resistance < 0.02 m²·K/W; hot-gas soft bleed prevents liquid slug shockwaves; exhaust Q ≥ 20·√G CFM.';
      readoutMitigation.textContent = 'Maintain quarterly dual-sensor electrochemical R-717 bump calibration; enforce 25 ppm supervisory and 150 ppm tripping interlocks.';
    }
  }

  // Event Listeners for Controls
  [selectEquipment, selectProduct, selectDefrost, inputBoxTemp, inputRuntime, inputFrostMm, inputHotGasPress, inputChargeKg, inputVentilationCfm, inputSensorSetPpm].forEach(el => {
    el.addEventListener('input', calculateTelemetry);
    el.addEventListener('change', calculateTelemetry);
  });

  // Presets Handlers
  btnPresetIQFProduce.addEventListener('click', () => {
    selectEquipment.value = 'high_capacity_twin_drum_spiral_freezer';
    selectProduct.value = 'iqf_fruits_vegetables_produce';
    selectDefrost.value = 'continuous_sequential_zone_defrost';
    inputBoxTemp.value = '-40';
    inputRuntime.value = '16';
    inputFrostMm.value = '3.0';
    inputHotGasPress.value = '9.5';
    inputChargeKg.value = '850';
    inputVentilationCfm.value = '38000';
    inputSensorSetPpm.value = '25';
    calculateTelemetry();
  });

  btnPresetCookedPoultry.addEventListener('click', () => {
    selectEquipment.value = 'industrial_single_drum_spiral_freezer';
    selectProduct.value = 'steamed_poultry_cooked_nuggets';
    selectDefrost.value = 'automated_hot_gas_soft_reversal';
    inputBoxTemp.value = '-36';
    inputRuntime.value = '18';
    inputFrostMm.value = '4.5';
    inputHotGasPress.value = '10.5';
    inputChargeKg.value = '320';
    inputVentilationCfm.value = '18000';
    inputSensorSetPpm.value = '25';
    calculateTelemetry();
  });

  btnPresetLegacyFailure.addEventListener('click', () => {
    selectEquipment.value = 'unvented_legacy_spiral_freezer';
    selectProduct.value = 'warm_parbaked_bakery_pastries';
    selectDefrost.value = 'rapid_hot_gas_hard_shock';
    inputBoxTemp.value = '-32';
    inputRuntime.value = '32';
    inputFrostMm.value = '8.5';
    inputHotGasPress.value = '13.5';
    inputChargeKg.value = '480';
    inputVentilationCfm.value = '2400';
    inputSensorSetPpm.value = '150';
    calculateTelemetry();
  });

  btnPresetBakeryDeluge.addEventListener('click', () => {
    selectEquipment.value = 'compact_self_stacking_spiral_freezer';
    selectProduct.value = 'warm_parbaked_bakery_pastries';
    selectDefrost.value = 'water_spray_deluge_defrost';
    inputBoxTemp.value = '-34';
    inputRuntime.value = '10';
    inputFrostMm.value = '2.5';
    inputHotGasPress.value = '7.5';
    inputChargeKg.value = '190';
    inputVentilationCfm.value = '12000';
    inputSensorSetPpm.value = '25';
    calculateTelemetry();
  });

  // Copy Report Handler
  btnCopyReport.addEventListener('click', () => {
    const reportText = `[IsItKitchenSafe Telemetry] Commercial Spiral Freezer Ammonia & Frost Diagnostic Report
--------------------------------------------------------------------------------
Architecture: ${selectEquipment.value}
Product Substrate: ${selectProduct.value}
Defrost Sequence: ${selectDefrost.value}
Freezer Temp: ${valBoxTemp.textContent} | Continuous Run: ${valRuntime.textContent}
Frost Thickness: ${valFrostMm.textContent} | Hot-Gas Pressure: ${valHotGasPress.textContent}
R-717 Charge: ${valChargeKg.textContent} | Mechanical Ventilation: ${valVentilationCfm.textContent}
Sensor Alarm Setpoint: ${valSensorSetPpm.textContent}
--------------------------------------------------------------------------------
Overall Heat Transfer U-Value: ${cardUValueVal.textContent} W/m²·K (${cardUValueStatus.textContent})
Air Static Pressure Drop: ${cardPressureDropVal.textContent} Pa (${cardPressureDropStatus.textContent})
Pipe Weld Thermal Stress: ${cardThermalStressVal.textContent} MPa (${cardThermalStressStatus.textContent})
Room NH3 Gas Concentration: ${cardNh3LeakVal.textContent} ppm (${cardNh3LeakStatus.textContent})
IIAR 2 Ventilation Margin: ${cardVentilationMarginVal.textContent} (${cardVentilationMarginStatus.textContent})
Status Assessment: ${statusTitle.textContent}
Primary Risk: ${readoutPrimaryRisk.textContent}
Remediation: ${readoutMitigation.textContent}
Timestamp: ${new Date().toISOString()}`;

    navigator.clipboard.writeText(reportText).then(() => {
      lblCopyBtn.textContent = t.copiedFeedback;
      setTimeout(() => {
        lblCopyBtn.textContent = t.copyReportBtn;
      }, 2500);
    }).catch(err => {
      console.error('Failed to copy telemetry to clipboard:', err);
    });
  });

  // Initial Calculation Run
  calculateTelemetry();
</script>
