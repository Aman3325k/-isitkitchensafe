              <div id="mwc-stir-checkpoint" class="text-sm font-bold text-signature-mint leading-snug">
                {t.stirAtPrefix} 2{t.unitMinShort} 45{t.unitSecShort}
              </div>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10 space-y-1">
              <div class="text-[11px] text-white/70 font-medium">{t.standingTimeLabel}</div>
              <div id="mwc-standing-val" class="text-sm font-bold text-white leading-snug">
                {t.defaultStandingVal}
              </div>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10 space-y-1">
              <div class="text-[11px] text-white/70 font-medium">{t.usdaTempLabel}</div>
              <div id="mwc-usda-val" class="text-sm font-bold text-signature-peach leading-snug">
                {t.defaultUsdaVal}
              </div>
            </div>
          </div>

          <!-- Inverter Note (shown dynamically when 1250W Inverter is selected) -->
          <div id="mwc-inverter-banner" class="hidden p-3 rounded-xl bg-white/10 border border-white/15 text-xs text-white/90 leading-relaxed">
            ⚡ {t.inverterNote}
          </div>
        </div>

        <!-- Contextual Special Hazard Banner (shown for Cup of Water superheating, Ground Beef defrost, Potato pierce, Popcorn steam) -->
        <div id="mwc-hazard-banner" class="hidden rounded-2xl border p-4 space-y-1.5 bg-warning-bg dark:bg-amber-950/40 border-warning-border">
          <div class="flex items-center gap-2">
            <span id="mwc-hazard-icon" aria-hidden="true" class="text-base">⚠️</span>
            <h3 id="mwc-hazard-title" class="text-xs sm:text-sm font-bold text-warning dark:text-amber-300"></h3>
          </div>
          <p id="mwc-hazard-body" class="text-xs text-ink dark:text-amber-100 leading-relaxed"></p>
        </div>

        <!-- Active Food Preset Guide Card (shown when a preset is selected) -->
        <div id="mwc-preset-card" class="hidden rounded-2xl bg-canvas border border-hairline p-4 sm:p-5 space-y-3">
          <div class="flex items-center justify-between gap-2 border-b border-hairline pb-2.5">
            <div class="flex items-center gap-2.5 min-w-0">
              <span id="mwc-preset-icon" class="text-xl shrink-0" aria-hidden="true">🍱</span>
              <div class="min-w-0">
                <span class="text-[10px] font-bold uppercase tracking-wider text-signature-coral block">
                  {t.presetGuideEyebrow}
                </span>
                <h3 id="mwc-preset-name" class="text-sm sm:text-base font-bold text-ink truncate"></h3>
              </div>
            </div>
            <span id="mwc-preset-base-pill" class="px-2.5 py-1 rounded-full text-[11px] font-mono font-bold bg-surface-soft text-ink border border-hairline shrink-0"></span>
          </div>
          <div class="space-y-2 text-xs text-body leading-relaxed">
            <div>
              <strong class="text-ink">{t.presetStirLabel}:</strong>{' '}
              <span id="mwc-preset-stir-tip"></span>
            </div>
            <div>
              <strong class="text-ink">{t.presetSafetyLabel}:</strong>{' '}
              <span id="mwc-preset-safety-note"></span>
            </div>
          </div>
        </div>

        <!-- Model Size Comparison Mini-Card -->
        <div class="rounded-2xl bg-canvas border border-hairline p-4 space-y-2">
          <div class="flex items-center justify-between gap-2 text-xs">
            <span class="font-bold text-ink" id="mwc-my-watt-heading">900W · {defaultMyObj.sizeType}</span>
            <span class="font-mono text-[11px] text-muted" id="mwc-my-volume">{defaultMyObj.typicalVolumeCuFt}</span>
          </div>
          <p id="mwc-my-watt-desc" class="text-xs text-body leading-relaxed">
            {defaultMyObj.description}
          </p>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center justify-between gap-3 pt-2">
        <button
          type="button"
          id="mwc-reset-btn"
          class="min-h-[44px] px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-canvas text-ink border border-hairline hover:border-border-strong transition-colors cursor-pointer"
        >
          {t.resetBtn}
        </button>
        <button
          type="button"
          id="mwc-copy-btn"
          class="min-h-[44px] flex-1 sm:flex-none px-5 py-2.5 rounded-xl text-xs sm:text-sm font-semibold bg-primary text-on-primary hover:bg-primary-active transition-colors cursor-pointer shadow-sm"
        >
          <span id="mwc-copy-label">{t.copyBtn}</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Full Conversion Quick Chart (600W – 1250W) -->
  <div class="border-t border-hairline p-5 sm:p-6 space-y-4">
    <div>
      <h2 class="text-title-md font-semibold text-ink">{t.chartTitle}</h2>
      <p class="text-xs text-muted mt-0.5">{t.chartSub}</p>
    </div>

    <div class="border border-hairline rounded-xl overflow-hidden bg-canvas">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead class="bg-surface-strong border-b border-hairline text-ink font-semibold">
            <tr>
              <th class="p-3">{t.chartHeaders[0]}</th>
              <th class="p-3">{t.chartHeaders[1]}</th>
              <th class="p-3">{t.chartHeaders[2]}</th>
              <th class="p-3">{t.chartHeaders[3]}</th>
              <th class="p-3">{t.chartHeaders[4]}</th>
            </tr>
          </thead>
          <tbody id="mwc-chart-tbody" class="divide-y divide-hairline">
            {initialChartRows.map((row, idx) => (
              <tr
                data-mwc-chart-row={row.watts}
                class={`mwc-chart-row cursor-pointer transition-colors hover:bg-signature-cream/40 dark:hover:bg-white/5 ${
                  row.watts === defaultMyWatts
                    ? 'ring-2 ring-inset ring-signature-coral bg-signature-cream/50 dark:bg-white/10'
                    : idx % 2 === 0
                      ? 'bg-canvas'
                      : 'bg-surface-soft'
                }`}
              >
                <td class="p-3 font-bold text-ink whitespace-nowrap">
                  <span>{row.label}</span>
                  <span
                    data-mwc-row-badge-yours={row.watts}
                    class={`ml-1.5 px-1.5 py-0.5 rounded text-[10px] font-bold bg-signature-coral text-white ${row.watts === defaultMyWatts ? '' : 'hidden'}`}
                  >
                    {t.chartBadgeYours}
                  </span>
                  <span
                    data-mwc-row-badge-pkg={row.watts}
                    class={`ml-1.5 px-1.5 py-0.5 rounded text-[10px] font-bold bg-primary text-on-primary ${row.watts === defaultPkgWatts ? '' : 'hidden'}`}
                  >
                    {t.chartBadgePkg}
                  </span>
                </td>
                <td class="p-3 text-body">
                  <span class="font-medium text-ink">{row.sizeType}</span>
                  <span class="block text-[11px] text-muted">{row.typicalVolumeCuFt}</span>
                </td>
                <td data-mwc-row-time={row.watts} class="p-3 font-mono font-bold text-ink text-sm sm:text-base whitespace-nowrap">
                  {row.adjFormatted}
                </td>
                <td data-mwc-row-diff={row.watts} class="p-3 font-mono text-xs font-semibold text-body whitespace-nowrap">
                  {row.diffFormatted}
                </td>
                <td data-mwc-row-stir={row.watts} class="p-3 font-mono text-body whitespace-nowrap">
                  {row.stirFormatted}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Essential Microwave Safety Rules Strip -->
  <div class="border-t border-hairline p-5 sm:p-6 bg-surface-soft/50 space-y-4">
    <div>
      <h2 class="text-title-md font-semibold text-ink">{t.safetyStripTitle}</h2>
      <p class="text-xs text-muted mt-0.5">{t.safetyStripSub}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {localizedSafetyRules.map((rule) => (
        <article
          class={`p-4 rounded-xl border space-y-2 ${
            rule.severity === 'hazard'
              ? 'bg-error-bg/60 dark:bg-red-950/25 border-error-border/70'
              : rule.severity === 'warning'
                ? 'bg-warning-bg/70 dark:bg-amber-950/25 border-warning-border/70'
                : 'bg-canvas border-hairline'
          }`}
        >
          <div class="flex items-center gap-2">
            <span aria-hidden="true" class="text-lg">{rule.icon}</span>
            <h3 class="text-xs sm:text-sm font-bold text-ink leading-snug">{rule.title}</h3>
          </div>
          <p class="text-xs text-body leading-relaxed">{rule.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const payloadEl = document.getElementById('mwc-payload');
    if (!payloadEl) return;

    let payload;
    try {
      payload = JSON.parse(payloadEl.textContent || '{}');
    } catch (_) {
      return;
    }

    const wattages = payload.wattages || [];
    const powerLevels = payload.powerLevels || [];
    const presets = payload.presets || [];
    const ui = payload.ui || {};

    const wattByVal = new Map(wattages.map((w) => [w.watts, w]));
    const powerByPct = new Map(powerLevels.map((pl) => [pl.pct, pl]));
    const presetById = new Map(presets.map((p) => [p.id, p]));

    // DOM references
    const pkgButtons = Array.from(document.querySelectorAll('.mwc-pkg-btn'));
    const myButtons = Array.from(document.querySelectorAll('.mwc-my-btn'));
    const powerButtons = Array.from(document.querySelectorAll('.mwc-power-btn'));
    const presetButtons = Array.from(document.querySelectorAll('.mwc-preset-btn'));
    const nudgeButtons = Array.from(document.querySelectorAll('.mwc-nudge-btn'));
    const chartRows = Array.from(document.querySelectorAll('.mwc-chart-row'));

    const swapBtn = document.getElementById('mwc-swap-btn');
    const pkgSizeLabel = document.getElementById('mwc-pkg-size-label');
    const mySizeLabel = document.getElementById('mwc-my-size-label');

    const minInput = document.getElementById('mwc-min-input');
    const secInput = document.getElementById('mwc-sec-input');

    const powerBadge = document.getElementById('mwc-power-badge');
    const powerDesc = document.getElementById('mwc-power-desc');

    const formulaPill = document.getElementById('mwc-formula-pill');
    const resultTime = document.getElementById('mwc-result-time');
    const resultDiff = document.getElementById('mwc-result-diff');
    const resultPowerLine = document.getElementById('mwc-result-power-line');
    const stirCheckpoint = document.getElementById('mwc-stir-checkpoint');
    const standingVal = document.getElementById('mwc-standing-val');
    const usdaVal = document.getElementById('mwc-usda-val');
    const inverterBanner = document.getElementById('mwc-inverter-banner');

    const hazardBanner = document.getElementById('mwc-hazard-banner');
    const hazardIcon = document.getElementById('mwc-hazard-icon');
    const hazardTitle = document.getElementById('mwc-hazard-title');
    const hazardBody = document.getElementById('mwc-hazard-body');

    const presetCard = document.getElementById('mwc-preset-card');
    const presetIcon = document.getElementById('mwc-preset-icon');
    const presetName = document.getElementById('mwc-preset-name');
    const presetBasePill = document.getElementById('mwc-preset-base-pill');
    const presetStirTip = document.getElementById('mwc-preset-stir-tip');
    const presetSafetyNote = document.getElementById('mwc-preset-safety-note');

    const myWattHeading = document.getElementById('mwc-my-watt-heading');
    const myVolume = document.getElementById('mwc-my-volume');
    const myWattDesc = document.getElementById('mwc-my-watt-desc');

    const resetBtn = document.getElementById('mwc-reset-btn');
    const copyBtn = document.getElementById('mwc-copy-btn');
    const copyLabel = document.getElementById('mwc-copy-label');

    const state = {
      pkgWatts: 1100,
      myWatts: 900,
      pkgTotalSeconds: 270, // 4:30
      basePowerPct: 100,
      selectedPowerPct: 100,
      activePresetId: null
    };

    let lastCopyText = '';

    function clamp(v, min, max) {
      return Math.min(max, Math.max(min, v));
    }

    function formatMMSS(totalSec) {
      const s = Math.max(1, Math.round(totalSec));
      const m = Math.floor(s / 60);
      const rem = s % 60;
      return m + ':' + String(rem).padStart(2, '0');
    }

    function formatReadable(totalSec) {
      const s = Math.max(0, Math.round(totalSec));
      const m = Math.floor(s / 60);
      const rem = s % 60;
      const mU = ui.unitMinShort || 'm';
      const sU = ui.unitSecShort || 's';
      if (m === 0) return rem + sU;
      return m + mU + ' ' + String(rem).padStart(2, '0') + sU;
    }

    function computeAdjusted(targetWatts) {
      const num = state.pkgTotalSeconds * state.pkgWatts * state.basePowerPct;
      const den = targetWatts * state.selectedPowerPct;
      return Math.max(1, Math.round(num / den));
    }

    function syncTimeInputs() {
      const clamped = clamp(Math.round(state.pkgTotalSeconds), 5, 3600);
      state.pkgTotalSeconds = clamped;
      const m = Math.floor(clamped / 60);
      const s = clamped % 60;
      if (minInput) minInput.value = String(m);
      if (secInput) secInput.value = String(s);
    }

    function updateButtonStates() {
      pkgButtons.forEach((btn) => {
        const w = parseInt(btn.getAttribute('data-mwc-pkg-w') || '0', 10);
        const active = w === state.pkgWatts;
        btn.setAttribute('aria-checked', active ? 'true' : 'false');
        btn.classList.toggle('bg-primary', active);
        btn.classList.toggle('text-on-primary', active);
        btn.classList.toggle('border-primary', active);
        btn.classList.toggle('shadow-sm', active);
        btn.classList.toggle('bg-canvas', !active);
        btn.classList.toggle('text-ink', !active);
        btn.classList.toggle('border-hairline', !active);
      });

      myButtons.forEach((btn) => {
        const w = parseInt(btn.getAttribute('data-mwc-my-w') || '0', 10);
        const active = w === state.myWatts;
        btn.setAttribute('aria-checked', active ? 'true' : 'false');
        btn.classList.toggle('bg-signature-coral', active);
        btn.classList.toggle('text-white', active);
        btn.classList.toggle('border-signature-coral', active);
        btn.classList.toggle('shadow-sm', active);
        btn.classList.toggle('bg-canvas', !active);
        btn.classList.toggle('text-ink', !active);
        btn.classList.toggle('border-hairline', !active);
      });

      powerButtons.forEach((btn) => {
        const p = parseInt(btn.getAttribute('data-mwc-power') || '100', 10);
        const active = p === state.selectedPowerPct;
        btn.setAttribute('aria-checked', active ? 'true' : 'false');
        btn.classList.toggle('bg-primary', active);
        btn.classList.toggle('text-on-primary', active);
        btn.classList.toggle('border-primary', active);
        btn.classList.toggle('shadow-sm', active);
        btn.classList.toggle('bg-canvas', !active);
        btn.classList.toggle('text-ink', !active);
        btn.classList.toggle('border-hairline', !active);
      });

      presetButtons.forEach((btn) => {
        const pid = btn.getAttribute('data-mwc-preset');
        const active = pid === state.activePresetId;
        btn.classList.toggle('border-signature-coral', active);
        btn.classList.toggle('bg-signature-cream/50', active);
        btn.classList.toggle('dark:bg-white/10', active);
        btn.classList.toggle('border-hairline', !active);
        btn.classList.toggle('bg-surface-soft', !active);
      });
    }

    function render() {
      updateButtonStates();

      const pkgObj = wattByVal.get(state.pkgWatts) || wattages[5];
      const myObj = wattByVal.get(state.myWatts) || wattages[3];
      const powerObj = powerByPct.get(state.selectedPowerPct) || powerLevels[0];
      const activePreset = state.activePresetId ? presetById.get(state.activePresetId) : null;

      if (pkgSizeLabel && pkgObj) pkgSizeLabel.textContent = pkgObj.sizeType;
      if (mySizeLabel && myObj) mySizeLabel.textContent = myObj.sizeType;
      if (powerBadge && powerObj) powerBadge.textContent = powerObj.name;
      if (powerDesc && powerObj) powerDesc.textContent = powerObj.useCase;

      const adjSec = computeAdjusted(state.myWatts);
      const diffSec = adjSec - state.pkgTotalSeconds;
      const stirSec = Math.max(1, Math.round(adjSec / 2));

      // Formula pill
      if (formulaPill) {
        const basePwrTag = state.basePowerPct < 100 ? ' (' + state.basePowerPct + '%)' : '';
        formulaPill.textContent =
          state.pkgWatts +
          'W' +
          basePwrTag +
          ' · ' +
          formatMMSS(state.pkgTotalSeconds) +
          ' → ' +
          state.myWatts +
          'W (' +
          state.selectedPowerPct +
          '%)';
      }

      // Main time display
      if (resultTime) resultTime.textContent = formatMMSS(adjSec);

      // Difference badge
      if (resultDiff) {
        resultDiff.className = 'inline-flex items-center px-3 py-1 rounded-full text-xs font-bold border ';
        if (diffSec === 0) {
          resultDiff.className += 'bg-white/10 text-white border-white/20';
          resultDiff.textContent = ui.diffExact;
        } else if (diffSec > 0) {
          resultDiff.className += 'bg-signature-yellow/20 text-signature-yellow border-signature-yellow/30';
          resultDiff.textContent = '+' + formatReadable(diffSec) + ' ' + ui.diffLonger;
        } else {
          resultDiff.className += 'bg-signature-mint/20 text-signature-mint border-signature-mint/30';
          resultDiff.textContent = '-' + formatReadable(Math.abs(diffSec)) + ' ' + ui.diffShorter;
        }
      }

      if (resultPowerLine && powerObj) {
        resultPowerLine.textContent = ui.effectivePowerNote + ' ' + powerObj.name;
      }

      // Stir / Rotate checkpoint
      let stirDisplayText = '';
      if (activePreset && activePreset.specialAlert === 'popcorn') {
        stirDisplayText = ui.noStirPopcorn;
      } else {
        stirDisplayText = ui.stirAtPrefix + ' ' + formatReadable(stirSec);
      }
      if (stirCheckpoint) stirCheckpoint.textContent = stirDisplayText;

      // Standing time & USDA temp
      const standingDisplay = activePreset ? activePreset.standingLabel : ui.defaultStandingVal;
      const usdaDisplay = activePreset ? activePreset.usdaLabel : ui.defaultUsdaVal;
      if (standingVal) standingVal.textContent = standingDisplay;
      if (usdaVal) usdaVal.textContent = usdaDisplay;

      // Inverter callout
      if (inverterBanner) {
        inverterBanner.classList.toggle('hidden', !(myObj && myObj.isInverter));
      }

      // Special Hazard Banner for high-risk presets
      if (hazardBanner && hazardTitle && hazardBody && hazardIcon) {
        if (activePreset && activePreset.specialAlert) {
          hazardBanner.classList.remove('hidden');
          if (activePreset.specialAlert === 'superheat') {
            hazardIcon.textContent = '⚠️';
            hazardTitle.textContent = ui.superheatBannerTitle;
          } else if (activePreset.specialAlert === 'defrost') {
            hazardIcon.textContent = '🥩';
            hazardTitle.textContent = ui.defrostBannerTitle;
          } else if (activePreset.specialAlert === 'pierce') {
            hazardIcon.textContent = '🥔';
            hazardTitle.textContent = ui.pierceBannerTitle;
          } else {
            hazardIcon.textContent = '🍿';
            hazardTitle.textContent = ui.popcornBannerTitle;
          }
          hazardBody.textContent = activePreset.safetyNote;
        } else {
          hazardBanner.classList.add('hidden');
        }
      }

      // Active preset card
      if (presetCard) {
        if (activePreset) {
          presetCard.classList.remove('hidden');
          if (presetIcon) presetIcon.textContent = activePreset.icon;
          if (presetName) presetName.textContent = activePreset.name;
          if (presetBasePill) {
            presetBasePill.textContent =
              activePreset.pkgWatts +
              'W · ' +
              formatMMSS(activePreset.pkgSeconds) +
              (activePreset.basePowerPct < 100 ? ' (' + activePreset.basePowerPct + '%)' : '');
          }
          if (presetStirTip) presetStirTip.textContent = activePreset.stirTip;
          if (presetSafetyNote) presetSafetyNote.textContent = activePreset.safetyNote;
        } else {
          presetCard.classList.add('hidden');
        }
      }

      // Selected microwave size description
      if (myObj) {
        if (myWattHeading) myWattHeading.textContent = myObj.label + ' · ' + myObj.sizeType;
        if (myVolume) myVolume.textContent = myObj.typicalVolumeCuFt;
        if (myWattDesc) myWattDesc.textContent = myObj.description;
      }

      // Update Full Conversion Quick Chart rows
      chartRows.forEach((row) => {
        const wVal = parseInt(row.getAttribute('data-mwc-chart-row') || '0', 10);
        const rowAdj = computeAdjusted(wVal);
        const rowDiff = rowAdj - state.pkgTotalSeconds;
        const rowStir = Math.max(1, Math.round(rowAdj / 2));

        const isYours = wVal === state.myWatts;
        const isPkg = wVal === state.pkgWatts;

        row.classList.toggle('ring-2', isYours);
        row.classList.toggle('ring-inset', isYours);
        row.classList.toggle('ring-signature-coral', isYours);
        row.classList.toggle('bg-signature-cream/50', isYours);
        row.classList.toggle('dark:bg-white/10', isYours);

        const yoursBadge = row.querySelector('[data-mwc-row-badge-yours]');
        const pkgBadge = row.querySelector('[data-mwc-row-badge-pkg]');
        const timeCell = row.querySelector('[data-mwc-row-time]');
        const diffCell = row.querySelector('[data-mwc-row-diff]');
        const stirCell = row.querySelector('[data-mwc-row-stir]');

        if (yoursBadge) yoursBadge.classList.toggle('hidden', !isYours);
        if (pkgBadge) pkgBadge.classList.toggle('hidden', !isPkg);
        if (timeCell) timeCell.textContent = formatMMSS(rowAdj);
        if (diffCell) {
          if (rowDiff === 0) {
            diffCell.textContent = '0' + (ui.unitSecShort || 's');
          } else {
            diffCell.textContent = (rowDiff > 0 ? '+' : '-') + formatReadable(Math.abs(rowDiff));
          }
        }
        if (stirCell) {
          stirCell.textContent =
            activePreset && activePreset.specialAlert === 'popcorn' ? '—' : formatMMSS(rowStir);
        }
      });

      // Plain-text clipboard summary (zero HTML tags)
      const diffLine =
        diffSec === 0
          ? ui.diffExact
          : (diffSec > 0 ? '+' : '-') +
            formatReadable(Math.abs(diffSec)) +
            ' ' +
            (diffSec > 0 ? ui.diffLonger : ui.diffShorter);

      lastCopyText = [
        ui.copyTitle,
        ui.copyPackageLine + ': ' + state.pkgWatts + 'W · ' + formatMMSS(state.pkgTotalSeconds),
        ui.copyAdjustedLine +
          ': ' +
          state.myWatts +
          'W (' +
          (powerObj ? powerObj.name : state.selectedPowerPct + '%') +
          ') → ' +
          formatMMSS(adjSec) +
          ' [' +
          diffLine +
          ']',
        ui.copyStirLine + ': ' + stirDisplayText,
        ui.copyStandingLine + ': ' + standingDisplay,
        ui.copyUsdaLine + ': ' + usdaDisplay
      ].join('\n');
    }

    // Event Listeners
    pkgButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const w = parseInt(btn.getAttribute('data-mwc-pkg-w') || '1100', 10);
        if (!isNaN(w)) {
          state.pkgWatts = w;
          state.activePresetId = null;
          state.basePowerPct = 100;
          render();
        }
      });
    });

    myButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const w = parseInt(btn.getAttribute('data-mwc-my-w') || '900', 10);
        if (!isNaN(w)) {
          state.myWatts = w;
          render();
        }
      });
    });

    if (swapBtn) {
      swapBtn.addEventListener('click', () => {
        const tmp = state.pkgWatts;
        state.pkgWatts = state.myWatts;
        state.myWatts = tmp;
        render();
      });
    }

    function handleTimeManualInput() {
      const m = clamp(parseInt((minInput && minInput.value) || '0', 10) || 0, 0, 60);
      const s = clamp(parseInt((secInput && secInput.value) || '0', 10) || 0, 0, 59);
      state.pkgTotalSeconds = Math.max(5, m * 60 + s);
      state.activePresetId = null;
      state.basePowerPct = 100;
      render();
    }

    if (minInput) minInput.addEventListener('input', handleTimeManualInput);
    if (secInput) secInput.addEventListener('input', handleTimeManualInput);

    nudgeButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const delta = parseInt(btn.getAttribute('data-mwc-nudge') || '0', 10);
        state.pkgTotalSeconds = clamp(state.pkgTotalSeconds + delta, 5, 3600);
        state.activePresetId = null;
        state.basePowerPct = 100;
        syncTimeInputs();
        render();
      });
    });

    powerButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const p = parseInt(btn.getAttribute('data-mwc-power') || '100', 10);
        if (!isNaN(p)) {
          state.selectedPowerPct = p;
          render();
        }
      });
    });

    presetButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const pid = btn.getAttribute('data-mwc-preset');
        const preset = pid ? presetById.get(pid) : null;
        if (!preset) return;
        state.activePresetId = preset.id;
        state.pkgWatts = preset.pkgWatts;
        state.pkgTotalSeconds = preset.pkgSeconds;
        state.basePowerPct = preset.basePowerPct || 100;
        state.selectedPowerPct = preset.basePowerPct || 100;
        syncTimeInputs();
        render();
      });
    });

    chartRows.forEach((row) => {
      row.addEventListener('click', () => {
        const w = parseInt(row.getAttribute('data-mwc-chart-row') || '0', 10);
        if (!isNaN(w) && w > 0) {
          state.myWatts = w;
          render();
        }
      });
    });

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        state.pkgWatts = 1100;
        state.myWatts = 900;
        state.pkgTotalSeconds = 270;
        state.basePowerPct = 100;
        state.selectedPowerPct = 100;
        state.activePresetId = null;
        syncTimeInputs();
        render();
      });
    }

    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        const showCopied = () => {
          if (copyLabel) copyLabel.textContent = ui.copiedBtn || 'Copied ✓';
          window.setTimeout(() => {
            if (copyLabel) copyLabel.textContent = ui.copyBtn || 'Copy Adjusted Time';
          }, 2200);
        };

        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(lastCopyText).then(showCopied).catch(() => {
            showCopied();
          });
        } else {
          const ta = document.createElement('textarea');
          ta.value = lastCopyText;
          ta.setAttribute('readonly', '');
          ta.style.position = 'absolute';
          ta.style.left = '-9999px';
          document.body.appendChild(ta);
          ta.select();
          try {
            document.execCommand('copy');
          } catch (_) {
            // ignore
          }
          document.body.removeChild(ta);
          showCopied();
        }
      });
    }

    // Initial render
    render();
  })();
</script>
