              </div>
            </div>
            <div>
              <label for="mwc-sec-input" class="block text-xs font-semibold text-ink mb-1.5">
                {t.secondsLabel}
              </label>
              <div class="relative">
                <input
                  type="number"
                  id="mwc-sec-input"
                  min="0"
                  max="59"
                  step="5"
                  value={defaultPkgSec}
