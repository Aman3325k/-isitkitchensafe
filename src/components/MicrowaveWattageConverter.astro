          <!-- Prominent Adjusted Cooking Time & Difference -->
          <div class="p-4 sm:p-5 rounded-xl bg-white/5 border border-white/10 flex flex-col sm:flex-row sm:items-end justify-between gap-3">
            <div>
              <div class="text-xs text-white/75 font-medium">{t.adjustedTimeLabel}</div>
