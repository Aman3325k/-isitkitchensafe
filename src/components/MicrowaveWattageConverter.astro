const t = UI[lang] || UI.en;

// Default initial state: 1100W -> 900W, 4m 30s (270s), 100% power => 5:30 (+1m 00s longer), Stir at 2m 45s
const defaultPkgWatts = 1100;
const defaultMyWatts = 900;
const defaultPkgMin = 4;
const defaultPkgSec = 30;
const defaultTotalSec = defaultPkgMin * 60 + defaultPkgSec; // 270
const defaultAdjSec = Math.round((defaultTotalSec * defaultPkgWatts) / defaultMyWatts); // 330 (5:30)

function formatMMSS(sec: number): string {
  const s = Math.max(1, Math.round(sec));
  const m = Math.floor(s / 60);
  const rem = s % 60;
  return `${m}:${String(rem).padStart(2, '0')}`;
}

function formatReadable(sec: number, minShort: string, secShort: string): string {
  const s = Math.max(0, Math.round(sec));
  const m = Math.floor(s / 60);
  const rem = s % 60;
  if (m === 0) return `${rem}${secShort}`;
  if (rem === 0) return `${m}${minShort} 00${secShort}`;
  return `${m}${minShort} ${String(rem).padStart(2, '0')}${secShort}`;
}

const initialChartRows = localizedWattages.map((w) => {
  const adj = Math.max(1, Math.round((defaultTotalSec * defaultPkgWatts) / w.watts));
  const diff = adj - defaultTotalSec;
  const stir = Math.max(1, Math.round(adj / 2));
  return {
    ...w,
    adjFormatted: formatMMSS(adj),
    diffFormatted:
      diff === 0
        ? '0s'
        : `${diff > 0 ? '+' : '-'}${formatReadable(Math.abs(diff), t.unitMinShort, t.unitSecShort)}`,
    diffSign: diff > 0 ? 'longer' : diff < 0 ? 'shorter' : 'exact',
    stirFormatted: formatMMSS(stir)
  };
});

const defaultPkgObj = localizedWattages.find((w) => w.watts === defaultPkgWatts) || localizedWattages[5];
const defaultMyObj = localizedWattages.find((w) => w.watts === defaultMyWatts) || localizedWattages[3];

const clientPayload = {
  lang,
  wattages: localizedWattages,
  powerLevels: localizedPowerLevels,
  presets: localizedPresets,
  ui: t
};
