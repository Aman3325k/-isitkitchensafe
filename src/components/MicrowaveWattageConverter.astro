              <div class="relative">
                <input
                  type="number"
                  id="mwc-min-input"
                  min="0"
                  max="60"
                  step="1"
                  value={defaultPkgMin}
                  class="w-full h-11 pl-3 pr-10 rounded-lg bg-canvas border border-hairline text-ink font-bold text-base focus:outline-none focus:border-info-border"
                />
                <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs font-bold text-muted pointer-events-none">
                  {t.unitMinShort}
