        </div>
      </div>

      <!-- Step 3: 10 Popular Frozen Meal & Reheating Presets -->
      <div class="space-y-2.5">
        <div>
          <h2 class="text-title-sm font-semibold text-ink">{t.presetsTitle}</h2>
          <p class="text-xs text-muted mt-0.5">{t.presetsSub}</p>
