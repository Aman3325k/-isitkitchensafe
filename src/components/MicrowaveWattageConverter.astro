            {t.swapBtn}
          </button>
        </div>

        <!-- Package / Recipe Wattage -->
        <div class="p-4 rounded-xl bg-surface-soft border border-hairline space-y-2.5">
          <div class="flex items-center justify-between gap-2">
            <span class="text-xs sm:text-sm font-semibold text-ink">{t.pkgWattLabel}</span>
            <span id="mwc-pkg-size-label" class="text-[11px] font-medium text-muted text-right">
              {defaultPkgObj.sizeType}
            </span>
          </div>
          <div class="grid grid-cols-4 gap-1.5" role="radiogroup" aria-label={t.pkgWattLabel}>
            {localizedWattages.map((w) => (
              <button
                type="button"
                role="radio"
                aria-checked={w.watts === defaultPkgWatts ? 'true' : 'false'}
                data-mwc-pkg-w={w.watts}
                class={`mwc-pkg-btn min-h-[42px] px-2 py-1.5 rounded-lg text-xs font-bold border transition-all cursor-pointer ${
                  w.watts === defaultPkgWatts
                    ? 'bg-primary text-on-primary border-primary shadow-sm'
                    : 'bg-canvas text-ink border-hairline hover:border-border-strong'
                }`}
              >
                {w.isInverter ? '1250W*' : `${w.watts}W`}
              </button>
            ))}
          </div>
        </div>

        <!-- Your Microwave Wattage -->
        <div class="p-4 rounded-xl bg-surface-soft border border-hairline space-y-2.5">
          <div class="flex items-center justify-between gap-2">
            <span class="text-xs sm:text-sm font-semibold text-ink">{t.myWattLabel}</span>
            <span id="mwc-my-size-label" class="text-[11px] font-medium text-muted text-right">
              {defaultMyObj.sizeType}
            </span>
          </div>
          <div class="grid grid-cols-4 gap-1.5" role="radiogroup" aria-label={t.myWattLabel}>
            {localizedWattages.map((w) => (
              <button
                type="button"
                role="radio"
                aria-checked={w.watts === defaultMyWatts ? 'true' : 'false'}
                data-mwc-my-w={w.watts}
                class={`mwc-my-btn min-h-[42px] px-2 py-1.5 rounded-lg text-xs font-bold border transition-all cursor-pointer ${
                  w.watts === defaultMyWatts
                    ? 'bg-signature-coral text-white border-signature-coral shadow-sm'
                    : 'bg-canvas text-ink border-hairline hover:border-border-strong'
                }`}
              >
                {w.isInverter ? '1250W*' : `${w.watts}W`}
              </button>
            ))}
          </div>

          <!-- Inside Door Sticker Tip -->
          <div class="p-3 rounded-lg bg-canvas border border-hairline text-xs text-body leading-relaxed flex items-start gap-2">
            <span aria-hidden="true" class="text-sm shrink-0 mt-0.5">🏷️</span>
            <div>
              <strong class="text-ink">{t.doorStickerTitle}</strong>{' '}
              <span>{t.doorStickerTip}</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Step 2: Cooking Time & Power Level -->
      <div class="space-y-4">
        <h2 class="text-title-sm font-semibold text-ink">{t.step2Title}</h2>

        <!-- Minutes & Seconds Inputs -->
        <div class="p-4 rounded-xl bg-surface-soft border border-hairline space-y-3">
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label for="mwc-min-input" class="block text-xs font-semibold text-ink mb-1.5">
                {t.minutesLabel}
