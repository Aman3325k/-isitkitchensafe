            <button type="button" data-mwc-nudge="-15" class="mwc-nudge-btn px-2.5 py-1 rounded-md text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral cursor-pointer">-15s</button>
            <button type="button" data-mwc-nudge="15" class="mwc-nudge-btn px-2.5 py-1 rounded-md text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral cursor-pointer">+15s</button>
            <button type="button" data-mwc-nudge="30" class="mwc-nudge-btn px-2.5 py-1 rounded-md text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral cursor-pointer">+30s</button>
            <button type="button" data-mwc-nudge="60" class="mwc-nudge-btn px-2.5 py-1 rounded-md text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral cursor-pointer">+1m</button>
