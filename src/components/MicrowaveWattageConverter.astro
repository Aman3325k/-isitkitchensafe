---
import rawData from '../data/microwave-wattage-converter-data.json';
import type { SupportedLanguage } from '../i18n/ui';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;

const localizedWattages = rawData.wattages.map((w) => {
  const tr = (w.i18n as Record<string, any>)[lang] || w.i18n.en;
  return {
    watts: w.watts,
    isInverter: w.isInverter,
    typicalVolumeCuFt: w.typicalVolumeCuFt,
    label: tr.label,
    sizeType: tr.sizeType,
    description: tr.description
  };
});

const localizedPowerLevels = rawData.powerLevels.map((pl) => {
  const tr = (pl.i18n as Record<string, any>)[lang] || pl.i18n.en;
  return {
    pct: pl.pct,
    name: tr.name,
    shortLabel: tr.shortLabel,
    useCase: tr.useCase
  };
});

const localizedPresets = rawData.presets.map((p) => {
  const tr = (p.i18n as Record<string, any>)[lang] || p.i18n.en;
  return {
    id: p.id,
    icon: p.icon,
    pkgWatts: p.pkgWatts,
    pkgSeconds: p.pkgSeconds,
    basePowerPct: p.basePowerPct,
    standingTimeMin: p.standingTimeMin,
    usdaTempF: p.usdaTempF,
    usdaTempC: p.usdaTempC,
    specialAlert: p.specialAlert,
    name: tr.name,
    standingLabel: tr.standingLabel,
    usdaLabel: tr.usdaLabel,
    stirTip: tr.stirTip,
    safetyNote: tr.safetyNote
  };
});

const localizedSafetyRules = rawData.safetyRules.map((r) => {
  const tr = (r.i18n as Record<string, any>)[lang] || r.i18n.en;
  return {
    id: r.id,
    icon: r.icon,
    severity: r.severity,
    title: tr.title,
    body: tr.body
  };
});

