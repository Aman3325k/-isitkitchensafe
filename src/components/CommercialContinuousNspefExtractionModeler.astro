    pulseWidthHelp: "半値全幅（FWHM）パルス幅（10〜100 ナノ秒）。100 ns 未満の超短パルスは外側細胞膜を迂回して細胞小器官膜を直接穿孔します。",
    freqLabel: "パルス繰り返し周波数 (f_rep):",
    freqHelp: "ナノ秒高圧放電パルスの発生周波数（100〜2,500 Hz）。",
    flowLabel: "スラリー連続処理流量 (Q_feed):",
    flowHelp: "同軸処理チャンバーを連続通過するスラリーの体積流量（500〜4,500 L/h）。",
    pressureLabel: "流路運転背圧 (P_back):",
    pressureHelp: "キャビテーション微小気泡を水力的に圧壊させ、流路内の火花放電・絶縁破壊を防ぐための陽圧（1.0〜6.0 bar）。",
    chilledJacketLabel: "低温グリコール冷却ジャケット (4°C):",
    chilledJacketHelp: "ジュール熱を直ちに排熱し、スラリー液温を 15°C 以下に保つ衛生向流冷却ジャケットを作動させます。",
    presetsTitle: "産業用高効率運転プリセット",
    presetGrape: "ブドウ搾りかすアントシアニン・レスベラトロール低温回収（60 kV/cm, 50 ns, 1200 Hz, 2500 L/h, 4.0 bar）",
    presetBerry: "ベリー搾汁残渣デルフィニジン＆ビタミン C 非加熱抽出（55 kV/cm, 40 ns, 1500 Hz, 2000 L/h, 4.5 bar）",
    presetOlive: "オリーブ残渣ヒドロキシチロソール・オレウロペイン高純度回収（65 kV/cm, 60 ns, 1800 Hz, 2800 L/h, 4.5 bar）",
    presetAlgae: "ヘマトコッカス藻体オルガネラ膜穿孔アスタキサンチン抽出（75 kV/cm, 35 ns, 2200 Hz, 1800 L/h, 5.0 bar）",
    presetHazard: "危険警告：過大電界による絶縁破壊＆アーク放電事故（78 kV/cm, 95 ns, 2500 Hz, 1.2 bar, 冷却停止）",
    diagnosticTitle: "nsPEF 生体膜透過化＆抽出リアルタイム解析テレメトリ",
    diagnosticSub: "液胞膜間電位差、有用成分抽出収率、熱失活率、投入比エネルギー、および流路絶縁破壊安全マージンをリアルタイム熱力学計算。",
    peakFieldLabel: "ピーク電界強度 (E_peak):",
    transmembraneLabel: "液胞膜間誘起電位 (ΔΨ_vac):",
    yieldLabel: "植物化学成分抽出収率 (Y_extract):",
    degradationLabel: "有用成分熱失活率 (Δ_deg):",
    energyLabel: "比投入エネルギー (W_spec):",
    tempRiseLabel: "処理チャンバー断熱温度上昇 (ΔT):",
    safetyFactorLabel: "絶縁破壊安全余裕度 (SF_breakdown):",
    overallStatusLabel: "プロセス適合性＆安全総合判定:",
    diagramTitle: "連続同軸 nsPEF オルガネラ膜穿孔抽出チャンバー断面概要図",
    diagramSub: "ナノ秒電界の空間強度分布、テイラー・クエット渦流混合機構、細胞小器官の超電穿孔および完全非加熱抽出現象の可視化。",
    scienceTitle: "科学的原理：ナノ秒生体電気工学とオルガネラ膜透過化機構",
    scienceSub: "Schwan の式による細胞膜誘電緩和充電時間、液胞膜ナノポア生成現象、水中絶縁破壊抑制技術、および 3-A サニタリー規格 45-03 準拠設計。",
    tableTitle: "連続 nsPEF と各種従来型植物成分抽出技術の性能比較"
  }
};

const d = DICT[lang] || DICT.en;
---

<div class="space-y-12">
  <!-- Header Banner -->
  <section class="bg-gradient-to-br from-slate-900 via-indigo-950 to-slate-900 border border-indigo-800/60 rounded-3xl p-6 sm:p-10 shadow-xl relative overflow-hidden">
    <div class="absolute -right-16 -bottom-16 w-80 h-80 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="relative z-10 space-y-4">
      <div class="flex flex-wrap items-center gap-3">
        <span class="px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-indigo-500/20 text-indigo-300 border border-indigo-400/30">
          {d.badge}
        </span>
        <span class="text-xs text-indigo-300/80 font-mono">
          nsPEF &bull; 10–100 ns &bull; 40–80 kV/cm &bull; 3-A 45-03 &bull; EHEDG Class I
        </span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight leading-tight">
        {d.title}
      </h1>
      <p class="text-indigo-200/90 text-sm sm:text-base leading-relaxed max-w-4xl">
        {d.subtitle}
      </p>
    </div>
  </section>

  <!-- Interactive Simulator Section -->
  <section class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Controls (Left 6 Cols) -->
    <div class="lg:col-span-6 bg-surface-soft border border-hairline rounded-3xl p-6 sm:p-8 space-y-6 shadow-sm">
      <div class="border-b border-hairline/60 pb-4">
        <h2 class="text-lg font-bold text-ink tracking-tight flex items-center gap-2">
          <svg class="w-5 h-5 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
          </svg>
          {d.controlsTitle}
        </h2>
        <p class="text-xs text-muted mt-1">{d.controlsSub}</p>
      </div>

      <!-- Presets -->
      <div class="space-y-2">
        <label class="text-xs font-bold uppercase tracking-wider text-muted block">
          {d.presetsTitle}
        </label>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <button type="button" id="btn-preset-grape" class="text-left p-2.5 rounded-xl border border-hairline bg-surface hover:border-indigo-500/50 hover:bg-indigo-500/5 transition text-xs font-medium text-ink">
            🍇 {d.presetGrape.split('(')[0]}
          </button>
          <button type="button" id="btn-preset-berry" class="text-left p-2.5 rounded-xl border border-hairline bg-surface hover:border-indigo-500/50 hover:bg-indigo-500/5 transition text-xs font-medium text-ink">
            🫐 {d.presetBerry.split('(')[0]}
          </button>
          <button type="button" id="btn-preset-olive" class="text-left p-2.5 rounded-xl border border-hairline bg-surface hover:border-indigo-500/50 hover:bg-indigo-500/5 transition text-xs font-medium text-ink">
            🫒 {d.presetOlive.split('(')[0]}
          </button>
          <button type="button" id="btn-preset-algae" class="text-left p-2.5 rounded-xl border border-hairline bg-surface hover:border-indigo-500/50 hover:bg-indigo-500/5 transition text-xs font-medium text-ink">
            🧪 {d.presetAlgae.split('(')[0]}
          </button>
        </div>
        <button type="button" id="btn-preset-hazard" class="w-full text-left p-2.5 rounded-xl border border-rose-800/40 bg-rose-950/20 hover:bg-rose-950/40 transition text-xs font-medium text-rose-300">
          ⚠️ {d.presetHazard.split('(')[0]}
        </button>
      </div>

      <!-- Form Inputs -->
      <div class="space-y-4 pt-2">
        <!-- Generator Skid -->
        <div class="space-y-1.5">
          <label for="input-generator" class="text-xs font-semibold text-ink flex justify-between">
            <span>{d.generatorLabel}</span>
          </label>
          <select id="input-generator" class="w-full rounded-xl border border-hairline bg-surface px-3 py-2 text-xs font-medium text-ink focus:outline-hidden focus:ring-2 focus:ring-indigo-500">
            {nspefData.generatorSystems.map(g => (
              <option value={g.id}>{g.name}</option>
            ))}
          </select>
          <p class="text-[11px] text-muted">{d.generatorHelp}</p>
        </div>

        <!-- Feed Matrix -->
        <div class="space-y-1.5">
          <label for="input-matrix" class="text-xs font-semibold text-ink flex justify-between">
            <span>{d.matrixLabel}</span>
          </label>
          <select id="input-matrix" class="w-full rounded-xl border border-hairline bg-surface px-3 py-2 text-xs font-medium text-ink focus:outline-hidden focus:ring-2 focus:ring-indigo-500">
            {nspefData.feedMatrices.map(m => (
              <option value={m.id}>{m.name}</option>
            ))}
          </select>
          <p class="text-[11px] text-muted">{d.matrixHelp}</p>
        </div>

        <!-- Applied Peak Electric Field -->
        <div class="space-y-1.5">
          <div class="flex items-center justify-between">
            <label for="input-field" class="text-xs font-semibold text-ink">
              {d.fieldLabel}
            </label>
            <span id="display-field" class="text-xs font-mono font-bold text-indigo-400">60.0 kV/cm</span>
          </div>
          <input type="range" id="input-field" min="30" max="80" step="1" value="60" class="w-full accent-indigo-500 cursor-pointer" />
          <p class="text-[11px] text-muted">{d.fieldHelp}</p>
        </div>

        <!-- Pulse Width (Duration) -->
        <div class="space-y-1.5">
          <div class="flex items-center justify-between">
            <label for="input-pulse-width" class="text-xs font-semibold text-ink">
              {d.pulseWidthLabel}
            </label>
            <span id="display-pulse-width" class="text-xs font-mono font-bold text-indigo-400">50 ns</span>
          </div>
          <input type="range" id="input-pulse-width" min="10" max="100" step="5" value="50" class="w-full accent-indigo-500 cursor-pointer" />
          <p class="text-[11px] text-muted">{d.pulseWidthHelp}</p>
        </div>

        <!-- Pulse Repetition Frequency -->
        <div class="space-y-1.5">
          <div class="flex items-center justify-between">
            <label for="input-freq" class="text-xs font-semibold text-ink">
              {d.freqLabel}
            </label>
            <span id="display-freq" class="text-xs font-mono font-bold text-indigo-400">1200 Hz</span>
          </div>
          <input type="range" id="input-freq" min="100" max="2500" step="50" value="1200" class="w-full accent-indigo-500 cursor-pointer" />
          <p class="text-[11px] text-muted">{d.freqHelp}</p>
        </div>

        <!-- Slurry Flow Rate -->
        <div class="space-y-1.5">
          <div class="flex items-center justify-between">
            <label for="input-flow" class="text-xs font-semibold text-ink">
              {d.flowLabel}
            </label>
            <span id="display-flow" class="text-xs font-mono font-bold text-indigo-400">2500 L/h</span>
          </div>
          <input type="range" id="input-flow" min="500" max="4500" step="100" value="2500" class="w-full accent-indigo-500 cursor-pointer" />
          <p class="text-[11px] text-muted">{d.flowHelp}</p>
        </div>

        <!-- Back Pressure -->
        <div class="space-y-1.5">
          <div class="flex items-center justify-between">
            <label for="input-pressure" class="text-xs font-semibold text-ink">
              {d.pressureLabel}
            </label>
            <span id="display-pressure" class="text-xs font-mono font-bold text-indigo-400">4.0 bar</span>
          </div>
          <input type="range" id="input-pressure" min="1.0" max="6.0" step="0.5" value="4.0" class="w-full accent-indigo-500 cursor-pointer" />
          <p class="text-[11px] text-muted">{d.pressureHelp}</p>
        </div>

        <!-- Chilled Jacket Toggle -->
        <div class="pt-2 flex items-center justify-between border-t border-hairline/60">
          <div>
            <span class="text-xs font-semibold text-ink block">{d.chilledJacketLabel}</span>
            <span class="text-[11px] text-muted">{d.chilledJacketHelp}</span>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" id="input-chilled-jacket" checked class="sr-only peer" />
            <div class="w-11 h-6 bg-slate-700 peer-focus:outline-hidden rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600"></div>
          </label>
        </div>
      </div>
    </div>

    <!-- Diagnostic Readout (Right 6 Cols) -->
    <div class="lg:col-span-6 space-y-6">
      <div class="bg-surface-soft border border-hairline rounded-3xl p-6 sm:p-8 space-y-6 shadow-sm">
        <div class="border-b border-hairline/60 pb-4">
          <h2 class="text-lg font-bold text-ink tracking-tight flex items-center gap-2">
            <svg class="w-5 h-5 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
            {d.diagnosticTitle}
          </h2>
          <p class="text-xs text-muted mt-1">{d.diagnosticSub}</p>
        </div>

        <!-- Primary KPI Cards Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Phytochemical Yield -->
          <div class="p-4 rounded-2xl bg-surface border border-hairline space-y-1">
            <span class="text-[11px] text-muted font-medium block">{d.yieldLabel}</span>
            <div class="flex items-baseline gap-2">
              <span id="res-yield" class="text-2xl font-black text-emerald-400 font-mono">94.8%</span>
              <span class="text-[10px] text-muted">Recovery</span>
            </div>
            <div class="w-full bg-slate-800 rounded-full h-1.5 mt-2 overflow-hidden">
              <div id="bar-yield" class="bg-emerald-500 h-full rounded-full transition-all" style="width: 94.8%"></div>
            </div>
          </div>

          <!-- Organelle Transmembrane Potential -->
          <div class="p-4 rounded-2xl bg-surface border border-hairline space-y-1">
            <span class="text-[11px] text-muted font-medium block">{d.transmembraneLabel}</span>
            <div class="flex items-baseline gap-2">
              <span id="res-transmembrane" class="text-2xl font-black text-indigo-400 font-mono">1.38 V</span>
              <span class="text-[10px] text-muted">&gt; 1.25 V Thresh</span>
            </div>
            <div class="w-full bg-slate-800 rounded-full h-1.5 mt-2 overflow-hidden">
              <div id="bar-transmembrane" class="bg-indigo-500 h-full rounded-full transition-all" style="width: 85%"></div>
            </div>
          </div>

          <!-- Thermal Degradation -->
          <div class="p-4 rounded-2xl bg-surface border border-hairline space-y-1">
            <span class="text-[11px] text-muted font-medium block">{d.degradationLabel}</span>
            <div class="flex items-baseline gap-2">
              <span id="res-degradation" class="text-2xl font-black text-emerald-400 font-mono">0.8%</span>
              <span class="text-[10px] text-muted">&lt; 1.2% Spec</span>
            </div>
            <div class="w-full bg-slate-800 rounded-full h-1.5 mt-2 overflow-hidden">
              <div id="bar-degradation" class="bg-emerald-500 h-full rounded-full transition-all" style="width: 15%"></div>
            </div>
          </div>

          <!-- Dielectric Breakdown Safety Factor -->
          <div class="p-4 rounded-2xl bg-surface border border-hairline space-y-1">
            <span class="text-[11px] text-muted font-medium block">{d.safetyFactorLabel}</span>
            <div class="flex items-baseline gap-2">
              <span id="res-safety-factor" class="text-2xl font-black text-indigo-400 font-mono">1.92x</span>
              <span class="text-[10px] text-muted">&gt; 1.40x Safe</span>
            </div>
            <div class="w-full bg-slate-800 rounded-full h-1.5 mt-2 overflow-hidden">
              <div id="bar-safety-factor" class="bg-indigo-500 h-full rounded-full transition-all" style="width: 80%"></div>
            </div>
          </div>
        </div>

        <!-- Secondary Technical Telemetry -->
        <div class="p-4 rounded-2xl bg-surface border border-hairline space-y-3 text-xs">
          <div class="flex justify-between items-center py-1 border-b border-hairline/40">
            <span class="text-muted">{d.energyLabel}</span>
            <span id="res-energy" class="font-mono font-bold text-ink">18.5 kJ/kg</span>
          </div>
          <div class="flex justify-between items-center py-1 border-b border-hairline/40">
            <span class="text-muted">{d.tempRiseLabel}</span>
            <span id="res-temp-rise" class="font-mono font-bold text-ink">+1.4°C (Safe Cold-Chain)</span>
          </div>
          <div class="flex justify-between items-center py-1">
            <span class="text-muted">{d.peakFieldLabel}</span>
            <span id="res-peak-field" class="font-mono font-bold text-ink">60.0 kV/cm (6.0 MV/m)</span>
          </div>
        </div>

        <!-- Overall Status Banner -->
        <div id="status-banner" class="p-4 rounded-2xl border border-emerald-500/30 bg-emerald-950/20 space-y-2">
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-bold uppercase tracking-wider text-emerald-300">
              {d.overallStatusLabel}
            </span>
            <span id="status-badge" class="px-2.5 py-0.5 rounded-full text-[10px] font-extrabold uppercase bg-emerald-500/20 text-emerald-300 border border-emerald-400/30">
              OPTIMAL BIOELECTRIC EXTRACTION
            </span>
          </div>
          <p id="status-desc" class="text-xs text-emerald-200/90 leading-relaxed">
            All operating metrics conform to high-yield organelle supra-electroporation. Liquid breakdown safety margin is optimal (&gt;1.50x), thermal degradation is negligible (&lt;1.0%), and complete 3-A Sanitary Standard 45-03 compliance is verified.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- SVG Flow & Chamber Cross-Section Diagram -->
  <section class="bg-surface-soft border border-hairline rounded-3xl p-6 sm:p-10 space-y-6 shadow-sm">
    <div class="border-b border-hairline/60 pb-4">
      <h2 class="text-lg font-bold text-ink tracking-tight flex items-center gap-2">
        <svg class="w-5 h-5 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        {d.diagramTitle}
      </h2>
      <p class="text-xs text-muted mt-1">{d.diagramSub}</p>
    </div>

    <div class="w-full overflow-x-auto bg-slate-950/80 rounded-2xl p-4 sm:p-6 border border-hairline">
      <svg class="w-full min-w-[700px] h-auto" viewBox="0 0 880 340" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Background Grid -->
        <defs>
          <pattern id="grid" width="20" height="20" patternUnits="userSpaceOnUse">
            <path d="M 20 0 L 0 0 0 20" fill="none" stroke="rgba(99, 102, 241, 0.07)" stroke-width="1"/>
          </pattern>
          <linearGradient id="hvGrad" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#4f46e5" stop-opacity="0.9"/>
            <stop offset="50%" stop-color="#818cf8" stop-opacity="0.95"/>
            <stop offset="100%" stop-color="#4f46e5" stop-opacity="0.9"/>
          </linearGradient>
          <linearGradient id="coolantGrad" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#0284c7" stop-opacity="0.4"/>
            <stop offset="100%" stop-color="#0369a1" stop-opacity="0.6"/>
          </linearGradient>
        </defs>
        <rect width="880" height="340" fill="url(#grid)" rx="12" />

        <!-- Outer Chilled Jacket Top & Bottom -->
        <rect x="180" y="30" width="520" height="30" rx="4" fill="url(#coolantGrad)" stroke="#38bdf8" stroke-width="1.5" />
        <text x="440" y="50" fill="#bae6fd" font-size="11" font-weight="bold" text-anchor="middle" font-family="monospace">
          SANITARY COUNTER-CURRENT CHILLED GLYCOL JACKET (4°C)
        </text>

        <rect x="180" y="280" width="520" height="30" rx="4" fill="url(#coolantGrad)" stroke="#38bdf8" stroke-width="1.5" />
        <text x="440" y="300" fill="#bae6fd" font-size="11" font-weight="bold" text-anchor="middle" font-family="monospace">
          CHILLED GLYCOL RETURN &bull; HEAT DISSIPATION &Delta;T &lt; 1.5°C
        </text>

        <!-- Outer Coaxial Grounded Pipe (Cathode) -->
        <rect x="200" y="70" width="480" height="200" rx="6" fill="#0f172a" stroke="#64748b" stroke-width="2" />

        <!-- Fluid Flow Slurry Zone (Upper & Lower Annulus) -->
        <rect x="210" y="80" width="460" height="65" fill="#312e81" fill-opacity="0.35" />
        <rect x="210" y="195" width="460" height="65" fill="#312e81" fill-opacity="0.35" />

        <!-- Center High-Voltage Anode Rod -->
        <rect x="170" y="145" width="540" height="50" rx="6" fill="url(#hvGrad)" stroke="#c7d2fe" stroke-width="2" />
        <text x="440" y="175" fill="#ffffff" font-size="12" font-weight="bold" text-anchor="middle" font-family="monospace">
          HIGH-VOLTAGE COAXIAL ANODE ROD (60 kV &bull; AISI 316L / Pt-IrO2 CLAD)
        </text>

        <!-- Electric Field Radial Lines (Arrows) -->
        <g stroke="#a5b4fc" stroke-width="1.5" stroke-dasharray="3,3">
          <!-- Upper Field Lines -->
          <line x1="260" y1="145" x2="260" y2="85" />
          <line x1="340" y1="145" x2="340" y2="85" />
          <line x1="440" y1="145" x2="440" y2="85" />
          <line x1="540" y1="145" x2="540" y2="85" />
          <line x1="620" y1="145" x2="620" y2="85" />

          <!-- Lower Field Lines -->
          <line x1="260" y1="195" x2="260" y2="255" />
          <line x1="340" y1="195" x2="340" y2="255" />
          <line x1="440" y1="195" x2="440" y2="255" />
          <line x1="540" y1="195" x2="540" y2="255" />
          <line x1="620" y1="195" x2="620" y2="255" />
        </g>

        <!-- Field Intensity Label -->
        <text x="440" y="120" fill="#e0e7ff" font-size="11" font-weight="bold" text-anchor="middle" font-family="monospace">
          RADIAL ELECTRIC FIELD E(r) = V / [r &bull; ln(r2/r1)] &bull; 60 kV/cm
        </text>

        <!-- Left Inlet Pipe (Biomass Feed) -->
        <path d="M 60 170 L 200 170" stroke="#10b981" stroke-width="8" stroke-linecap="round" />
        <text x="110" y="155" fill="#34d399" font-size="11" font-weight="bold" text-anchor="middle" font-family="sans-serif">
          Slurry Feed IN
        </text>
        <text x="110" y="195" fill="#94a3b8" font-size="10" text-anchor="middle" font-family="monospace">
          2,500 L/h &bull; 4.0 bar
        </text>

        <!-- Right Outlet Pipe (Permeabilized Extract) -->
        <path d="M 680 170 L 820 170" stroke="#10b981" stroke-width="8" stroke-linecap="round" />
        <text x="750" y="155" fill="#34d399" font-size="11" font-weight="bold" text-anchor="middle" font-family="sans-serif">
          Permeabilized OUT
        </text>
        <text x="750" y="195" fill="#94a3b8" font-size="10" text-anchor="middle" font-family="monospace">
          Anthocyanins 94.8%
        </text>

        <!-- Organelle Nanoporation Inset (Left Corner) -->
        <g transform="translate(40, 240)">
          <rect width="130" height="70" rx="8" fill="#1e1b4b" stroke="#818cf8" stroke-width="1.5" />
          <text x="65" y="18" fill="#c7d2fe" font-size="9" font-weight="bold" text-anchor="middle">SUB-CELLULAR SCALE</text>
          <circle cx="65" cy="42" r="18" fill="#312e81" stroke="#a5b4fc" stroke-width="1.5" />
          <circle cx="65" cy="42" r="9" fill="#4338ca" stroke="#f43f5e" stroke-width="1.5" stroke-dasharray="2,2" />
          <text x="65" y="66" fill="#fecdd3" font-size="8" text-anchor="middle">Vacuole Nanopores</text>
        </g>

        <!-- Solid-State Marx Generator Box (Right Corner) -->
        <g transform="translate(710, 40)">
          <rect width="130" height="70" rx="8" fill="#1e1b4b" stroke="#fbbf24" stroke-width="1.5" />
          <text x="65" y="18" fill="#fef08a" font-size="9" font-weight="bold" text-anchor="middle">SOLID-STATE MARX</text>
          <text x="65" y="36" fill="#e2e8f0" font-size="9" text-anchor="middle">&tau;_p = 50 ns (FWHM)</text>
          <text x="65" y="50" fill="#e2e8f0" font-size="9" text-anchor="middle">Rise Time &lt; 3.5 ns</text>
          <text x="65" y="64" fill="#a5b4fc" font-size="8" text-anchor="middle">Crowbar Fast Quench</text>
        </g>
      </svg>
    </div>
  </section>

  <!-- Scientific Principles & Engineering Rigor -->
  <section class="bg-surface-soft border border-hairline rounded-3xl p-6 sm:p-10 space-y-8 shadow-sm">
    <div class="border-b border-hairline/60 pb-4">
      <h2 class="text-xl font-bold text-ink tracking-tight flex items-center gap-2">
        <svg class="w-6 h-6 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
        </svg>
        {d.scienceTitle}
      </h2>
      <p class="text-xs text-muted mt-1">{d.scienceSub}</p>
    </div>

    <!-- 4 Scientific Columns / Principles -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- 1. Schwan Formula & Charging Time -->
      <div class="p-6 rounded-2xl bg-surface border border-hairline space-y-3">
        <div class="flex items-center gap-2">
          <span class="w-7 h-7 rounded-lg bg-indigo-500/10 text-indigo-400 font-bold flex items-center justify-center text-xs">1</span>
          <h3 class="font-bold text-ink text-sm sm:text-base">Schwan's Charging Time &amp; Organelle Permeabilization</h3>
        </div>
        <p class="text-xs text-muted leading-relaxed">
          The dielectric charging time constant (&tau;_m) of the plant cell plasma membrane is governed by Schwan's equation:
        </p>
        <div class="p-3 rounded-xl bg-slate-950 font-mono text-xs text-indigo-300 text-center border border-indigo-900/40">
          &tau;_m = r_cell &bull; C_m &bull; [ 1/&sigma;_int + 1/(2&sigma;_ext) ]
        </div>
        <p class="text-xs text-muted leading-relaxed">
          For plant cells with radius r &asymp; 20&ndash;40 &mu;m, &tau;_m &asymp; 80&ndash;120 ns. In conventional microsecond PEF (&tau;_p &ge; 1 &mu;s), the pulse charges the outer membrane until it collapses, tearing pectin walls. Nanosecond pulses (&tau;_p &le; 50 ns) are shorter than &tau;_m, allowing the electric field to penetrate the cell intact and charge interior vacuolar tonoplast membranes (&Delta;&Psi;_vac &ge; 1.25 V), inducing supra-electroporation without structural tissue maceration.
        </p>
      </div>

      <!-- 2. Coaxial Field Distribution -->
      <div class="p-6 rounded-2xl bg-surface border border-hairline space-y-3">
        <div class="flex items-center gap-2">
          <span class="w-7 h-7 rounded-lg bg-indigo-500/10 text-indigo-400 font-bold flex items-center justify-center text-xs">2</span>
          <h3 class="font-bold text-ink text-sm sm:text-base">Radial Coaxial Electric Field &amp; Taylor Vortices</h3>
        </div>
        <p class="text-xs text-muted leading-relaxed">
          The electric field intensity in an annular coaxial gap is given by Gauss's cylindrical formulation:
        </p>
        <div class="p-3 rounded-xl bg-slate-950 font-mono text-xs text-indigo-300 text-center border border-indigo-900/40">
          E(r) = V_applied / [ r &bull; ln(r_outer / r_inner) ]
        </div>
        <p class="text-xs text-muted leading-relaxed">
          Peak field E_peak occurs at r = r_inner. To prevent untreated bypass zones near the outer wall, the chamber radius ratio is constrained to r2 / r1 &le; 2.0. Helical sanitary diverters induce Taylor-Couette vortices, cyclically transporting every plant particle through the intense inner field for uniform pulse exposure (n &ge; 20 pulses).
        </p>
      </div>

      <!-- 3. Zero Thermal Degradation & Specific Energy -->
      <div class="p-6 rounded-2xl bg-surface border border-hairline space-y-3">
        <div class="flex items-center gap-2">
          <span class="w-7 h-7 rounded-lg bg-indigo-500/10 text-indigo-400 font-bold flex items-center justify-center text-xs">3</span>
          <h3 class="font-bold text-ink text-sm sm:text-base">Specific Energy Input &amp; &lt;1.2% Anthocyanin Degradation</h3>
        </div>
        <p class="text-xs text-muted leading-relaxed">
          Specific energy consumption is calculated from electrical pulse parameters:
        </p>
        <div class="p-3 rounded-xl bg-slate-950 font-mono text-xs text-indigo-300 text-center border border-indigo-900/40">
          W_spec = [ &sigma;_eff &bull; E^2 &bull; &tau;_pulse &bull; f_rep ] / [ &rho; &bull; v_flow ]
        </div>
        <p class="text-xs text-muted leading-relaxed">
          Because pulse widths are mere nanoseconds, total energy is only 10&ndash;25 kJ/kg (vs &gt;400 kJ/kg for thermal heating). The adiabatic temperature rise is limited to &Delta;T = W_spec / (&rho; &bull; C_p) &le; 1.8&deg;C, keeping heat-sensitive anthocyanin pyrylium rings intact with zero oxidative scission.
        </p>
      </div>

      <!-- 4. Dielectric Breakdown Prevention -->
      <div class="p-6 rounded-2xl bg-surface border border-hairline space-y-3">
        <div class="flex items-center gap-2">
          <span class="w-7 h-7 rounded-lg bg-indigo-500/10 text-indigo-400 font-bold flex items-center justify-center text-xs">4</span>
          <h3 class="font-bold text-ink text-sm sm:text-base">Dielectric Breakdown Prevention &amp; 3-A Sanitary Design</h3>
        </div>
        <p class="text-xs text-muted leading-relaxed">
          Electric arcing is governed by the liquid dielectric breakdown threshold (E_crit &asymp; 110&ndash;130 kV/cm):
        </p>
        <div class="p-3 rounded-xl bg-slate-950 font-mono text-xs text-indigo-300 text-center border border-indigo-900/40">
          SF_breakdown = E_crit / E_peak &ge; 1.40x (Safe Operation)
        </div>
        <p class="text-xs text-muted leading-relaxed">
          Entrained microbubbles magnify local electric fields by 1.5x. Continuous nsPEF suppresses bubble formation via an in-line centrifugal degasser and positive counter-pressure (P_back &ge; 3.5 bar). Electrodes are mirror-polished AISI 316L (Ra &le; 0.4 &mu;m) with MMO Pt/IrO2 cladding, satisfying 3-A Standard 45-03 with zero heavy metal leaching.
        </p>
      </div>
    </div>
  </section>

  <!-- Technology Comparison Table -->
  <section class="bg-surface-soft border border-hairline rounded-3xl p-6 sm:p-10 space-y-6 shadow-sm overflow-hidden">
    <div class="border-b border-hairline/60 pb-4">
      <h2 class="text-lg font-bold text-ink tracking-tight flex items-center gap-2">
        <svg class="w-5 h-5 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M3 14h18m-9-4v8m-7 0h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
        </svg>
        {d.tableTitle}
      </h2>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs border-collapse">
        <thead>
          <tr class="border-b border-hairline/60 text-muted uppercase tracking-wider font-semibold">
            <th class="py-3 px-3">Technology</th>
            <th class="py-3 px-3">Primary Mechanism</th>
            <th class="py-3 px-3">Specific Energy (kJ/kg)</th>
            <th class="py-3 px-3">Thermal Degradation</th>
            <th class="py-3 px-3">Extraction Yield</th>
            <th class="py-3 px-3">Temp Rise (&Delta;T)</th>
            <th class="py-3 px-3">Operating Cost</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline/40 font-mono">
          {nspefData.comparisons.map((c, i) => (
            <tr class={i === 0 ? "bg-indigo-500/10 font-semibold text-indigo-200" : "text-muted hover:bg-surface/50 transition"}>
              <td class="py-3 px-3 font-sans font-medium text-ink">{c.technology}</td>
              <td class="py-3 px-3 font-sans text-[11px]">{c.mechanism}</td>
              <td class="py-3 px-3">{c.energyConsumptionKJkg}</td>
              <td class="py-3 px-3 text-emerald-400">{c.thermalDegradationPct}</td>
              <td class="py-3 px-3">{c.extractionYieldPct}</td>
              <td class="py-3 px-3">{c.temperatureRise}</td>
              <td class="py-3 px-3">{c.operatingCostUSDkg}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</div>

<script is:inline define:vars={{ nspefData }}>
  function initNspefModeler() {
    const inputGen = document.getElementById('input-generator');
    const inputMatrix = document.getElementById('input-matrix');
    const inputField = document.getElementById('input-field');
    const inputPulseWidth = document.getElementById('input-pulse-width');
    const inputFreq = document.getElementById('input-freq');
    const inputFlow = document.getElementById('input-flow');
    const inputPressure = document.getElementById('input-pressure');
    const inputChilled = document.getElementById('input-chilled-jacket');

    const dispField = document.getElementById('display-field');
    const dispPulseWidth = document.getElementById('display-pulse-width');
    const dispFreq = document.getElementById('display-freq');
    const dispFlow = document.getElementById('display-flow');
    const dispPressure = document.getElementById('display-pressure');

    const resYield = document.getElementById('res-yield');
    const resTransmembrane = document.getElementById('res-transmembrane');
    const resDegradation = document.getElementById('res-degradation');
    const resSafetyFactor = document.getElementById('res-safety-factor');
    const resEnergy = document.getElementById('res-energy');
    const resTempRise = document.getElementById('res-temp-rise');
    const resPeakField = document.getElementById('res-peak-field');

    const barYield = document.getElementById('bar-yield');
    const barTransmembrane = document.getElementById('bar-transmembrane');
    const barDegradation = document.getElementById('bar-degradation');
    const barSafetyFactor = document.getElementById('bar-safety-factor');

    const statusBanner = document.getElementById('status-banner');
    const statusBadge = document.getElementById('status-badge');
    const statusDesc = document.getElementById('status-desc');

    if (!inputField) return;

    function recalculate() {
      const field = parseFloat(inputField.value); // kV/cm
      const pulseWidth = parseFloat(inputPulseWidth.value); // ns
      const freq = parseFloat(inputFreq.value); // Hz
      const flow = parseFloat(inputFlow.value); // L/h
      const pressure = parseFloat(inputPressure.value); // bar
      const chilled = inputChilled.checked;

      // Update displays
      dispField.textContent = `${field.toFixed(1)} kV/cm`;
      dispPulseWidth.textContent = `${pulseWidth} ns`;
      dispFreq.textContent = `${freq} Hz`;
      dispFlow.textContent = `${flow} L/h`;
      dispPressure.textContent = `${pressure.toFixed(1)} bar`;

      const curMatrixId = inputMatrix.value;
      const matrix = nspefData.feedMatrices.find(m => m.id === curMatrixId) || nspefData.feedMatrices[0];

      // Physical calculations:
      // 1. Organelle Transmembrane Potential ΔΨ_vac = 1.5 * r_organelle * E_field * (1 / sqrt(1 + (w*tau)^2))
      // In ns range, organelle radius is ~ 3-5 µm, E is in kV/cm.
      const r_vac_um = (matrix.meanCellDiameterMicrons * 0.45); // vacuole occupies ~45% of cell radius
      // Induced voltage approx: ΔΨ_vac = 1.5 * (r_vac * 1e-4 cm) * (E * 1e3 V/cm) * f(pulseWidth)
      const pulseFactor = Math.min(1.0, pulseWidth / (matrix.plasmaMembraneChargingTimeNs * 0.65));
      const transMembraneV = (1.5 * (r_vac_um * 1e-4) * (field * 1e3) * pulseFactor);

      // 2. Phytochemical Extraction Yield: sigmoid function of transMembraneV relative to threshold
      const ratio = transMembraneV / matrix.vacuolarMembraneThresholdV;
      let yieldPct = matrix.nominalAnthocyaninYieldPct * (1 / (1 + Math.exp(-4.5 * (ratio - 0.95))));
      yieldPct = Math.min(98.5, Math.max(25.0, yieldPct));

      // 3. Specific Energy Consumption: W_spec = (sigma * E^2 * tau * f) / (rho * v_flow)
      // in kJ/kg: approx (0.2 * field^2 * pulseWidth * 1e-9 * freq * 3600) / flow * scaling
      const energyKJkg = ((matrix.electricalConductivitySm * Math.pow(field, 2) * (pulseWidth * 1e-9) * freq * 3600) / (flow * 0.001) * 0.045);
      const clampedEnergy = Math.min(65.0, Math.max(4.0, energyKJkg));

      // 4. Adiabatic Temperature Rise ΔT = W_spec / (rho * Cp) where Cp ≈ 4.18 kJ/kg·K
      let tempRise = clampedEnergy / 4.18;
      if (chilled) {
        tempRise = tempRise * 0.28; // jacket dissipates 72% of heat
      }

      // 5. Thermal Degradation: strongly depends on tempRise and pulse duration
      let degradationPct = 0.2 + (tempRise * 0.45) + (pulseWidth > 80 ? (pulseWidth - 80) * 0.05 : 0);
      if (!chilled) degradationPct += 2.5;
      degradationPct = Math.min(35.0, Math.max(0.4, degradationPct));

      // 6. Dielectric Breakdown Safety Factor: SF = (E_crit * pressureFactor) / E_peak
      // Higher pressure collapses microbubbles and increases critical breakdown field
      const pressureBoost = Math.pow(pressure / 4.0, 0.42);
      const effectiveEcrit = matrix.criticalBreakdownFieldKVcm * pressureBoost;
      const safetyFactor = effectiveEcrit / field;

      // Update telemetry
      resYield.textContent = `${yieldPct.toFixed(1)}%`;
      resTransmembrane.textContent = `${transMembraneV.toFixed(2)} V`;
      resDegradation.textContent = `${degradationPct.toFixed(1)}%`;
      resSafetyFactor.textContent = `${safetyFactor.toFixed(2)}x`;
      resEnergy.textContent = `${clampedEnergy.toFixed(1)} kJ/kg`;
      resTempRise.textContent = `+${tempRise.toFixed(1)}°C (${chilled ? 'Chilled Glycol' : 'Uncooled'})`;
      resPeakField.textContent = `${field.toFixed(1)} kV/cm (${(field * 0.1).toFixed(2)} MV/m)`;

      // Progress bars
      barYield.style.width = `${Math.min(100, yieldPct)}%`;
      barTransmembrane.style.width = `${Math.min(100, (transMembraneV / 2.0) * 100)}%`;
      barDegradation.style.width = `${Math.min(100, (degradationPct / 10.0) * 100)}%`;
      barSafetyFactor.style.width = `${Math.min(100, (safetyFactor / 2.5) * 100)}%`;

      // Status Evaluation
      if (safetyFactor < 1.25) {
        statusBanner.className = 'p-4 rounded-2xl border border-rose-500/40 bg-rose-950/30 space-y-2';
        statusBadge.className = 'px-2.5 py-0.5 rounded-full text-[10px] font-extrabold uppercase bg-rose-500/20 text-rose-300 border border-rose-400/30';
        statusBadge.textContent = 'DIELECTRIC BREAKDOWN HAZARD';
        statusDesc.className = 'text-xs text-rose-200/90 leading-relaxed';
        statusDesc.textContent = `CRITICAL ALERT: Applied field (${field.toFixed(1)} kV/cm) dangerously approaches medium dielectric strength (${effectiveEcrit.toFixed(1)} kV/cm). Safety margin (${safetyFactor.toFixed(2)}x) is below 1.25x threshold. Risk of catastrophic arc discharge, electrode pitting, and product scorching. Increase hydraulic counter-pressure or lower peak field.`;
        resSafetyFactor.className = 'text-2xl font-black text-rose-400 font-mono';
        barSafetyFactor.className = 'bg-rose-500 h-full rounded-full transition-all';
      } else if (tempRise > 4.0 || degradationPct > 3.0) {
        statusBanner.className = 'p-4 rounded-2xl border border-amber-500/40 bg-amber-950/30 space-y-2';
        statusBadge.className = 'px-2.5 py-0.5 rounded-full text-[10px] font-extrabold uppercase bg-amber-500/20 text-amber-300 border border-amber-400/30';
        statusBadge.textContent = 'THERMAL DRIFT WARNING';
        statusDesc.className = 'text-xs text-amber-200/90 leading-relaxed';
        statusDesc.textContent = `WARNING: Chamber temperature rise (+${tempRise.toFixed(1)}°C) exceeds optimal non-thermal limit. Thermal degradation is elevated (${degradationPct.toFixed(1)}%). Enable active chilled glycol cooling and increase continuous flow rate to reduce specific energy residence time.`;
        resSafetyFactor.className = 'text-2xl font-black text-amber-400 font-mono';
        barSafetyFactor.className = 'bg-amber-500 h-full rounded-full transition-all';
      } else {
        statusBanner.className = 'p-4 rounded-2xl border border-emerald-500/30 bg-emerald-950/20 space-y-2';
        statusBadge.className = 'px-2.5 py-0.5 rounded-full text-[10px] font-extrabold uppercase bg-emerald-500/20 text-emerald-300 border border-emerald-400/30';
        statusBadge.textContent = 'OPTIMAL BIOELECTRIC EXTRACTION';
        statusDesc.className = 'text-xs text-emerald-200/90 leading-relaxed';
        statusDesc.textContent = `All operating metrics conform to high-yield organelle supra-electroporation. Liquid breakdown safety margin is optimal (${safetyFactor.toFixed(2)}x), thermal degradation is negligible (${degradationPct.toFixed(1)}%), and complete 3-A Sanitary Standard 45-03 compliance is verified.`;
        resSafetyFactor.className = 'text-2xl font-black text-emerald-400 font-mono';
        barSafetyFactor.className = 'bg-emerald-500 h-full rounded-full transition-all';
      }
    }

    // Attach listeners
    [inputGen, inputMatrix, inputField, inputPulseWidth, inputFreq, inputFlow, inputPressure, inputChilled].forEach(el => {
      if (el) el.addEventListener('input', recalculate);
    });

    // Preset handlers
    const btnGrape = document.getElementById('btn-preset-grape');
    const btnBerry = document.getElementById('btn-preset-berry');
    const btnOlive = document.getElementById('btn-preset-olive');
    const btnAlgae = document.getElementById('btn-preset-algae');
    const btnHazard = document.getElementById('btn-preset-hazard');

    if (btnGrape) {
      btnGrape.addEventListener('click', () => {
        inputMatrix.value = 'red_wine_grape_pomace_slurry';
        inputField.value = '60';
        inputPulseWidth.value = '50';
        inputFreq.value = '1200';
        inputFlow.value = '2500';
        inputPressure.value = '4.0';
        inputChilled.checked = true;
        recalculate();
      });
    }

    if (btnBerry) {
      btnBerry.addEventListener('click', () => {
        inputMatrix.value = 'blackcurrant_berry_pomace_mash';
        inputField.value = '55';
        inputPulseWidth.value = '40';
        inputFreq.value = '1500';
        inputFlow.value = '2000';
        inputPressure.value = '4.5';
        inputChilled.checked = true;
        recalculate();
      });
    }

    if (btnOlive) {
      btnOlive.addEventListener('click', () => {
        inputMatrix.value = 'olive_mill_pomace_alperujo';
        inputField.value = '65';
        inputPulseWidth.value = '60';
        inputFreq.value = '1800';
        inputFlow.value = '2800';
        inputPressure.value = '4.5';
        inputChilled.checked = true;
        recalculate();
      });
    }

    if (btnAlgae) {
      btnAlgae.addEventListener('click', () => {
        inputMatrix.value = 'microalgae_haematococcus_slurry';
        inputField.value = '75';
        inputPulseWidth.value = '35';
        inputFreq.value = '2200';
        inputFlow.value = '1800';
        inputPressure.value = '5.0';
        inputChilled.checked = true;
        recalculate();
      });
    }

    if (btnHazard) {
      btnHazard.addEventListener('click', () => {
        inputField.value = '78';
        inputPulseWidth.value = '95';
        inputFreq.value = '2500';
        inputFlow.value = '800';
        inputPressure.value = '1.2';
        inputChilled.checked = false;
        recalculate();
      });
    }

    recalculate();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNspefModeler);
  } else {
    initNspefModeler();
  }
</script>
