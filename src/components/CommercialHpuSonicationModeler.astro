    presetBrew: "クラフトビール超音波脱気＆コロイド微粒子安定化 (二周波 20/40 kHz)",
    presetCompromised: "損傷ソノトロード激しいピッティング＆金属微粒子脱落ハザード",
    diagnosticTitle: "連続音響キャビテーション＆食品安全診断指標",
    diagnosticSub: "リアルタイム物理キャビテーション衝撃波圧力、酵素不活化率、病原菌減少対数値、衛生適合性を算出。",
    intensityLabel: "音響放射強度 (I_ac)",
    energyDensityLabel: "音響エネルギー密度 (AED)",
    collapsePressureLabel: "キャビテーション気泡圧壊ピーク圧力",
    microjetVelocityLabel: "音響マイクロジェット噴流速度",
    pathogenLogLabel: "病原菌対数減少値 (Log10)",
    enzymeInactivationLabel: "対象酵素不活化率 (PPO/PME)",
    nutrientRetentionLabel: "ビタミン・生理活性成分保持率",
    tipSafetyLabel: "ソノトロード端面衛生状態",
    tempRiseLabel: "音響散逸正味流体温度上昇 (ΔT)",
    coolingLoadLabel: "フローセル冷却ジャケット必要熱負荷",
    safetyStatusLabel: "衛生基準＆ HACCP 適合判定",
    primaryLimitationLabel: "主要工学物理的制限要因",
    mitigationActionLabel: "推奨エンジニアリング対策プロトコル",
    scienceTitle: "高出力超音波の物理原理と食品衛生規制基準",
    scienceSub: "過渡的気泡圧壊物理学、微生物細胞膜ソノポレーション、酵素分子変性機構、および 3-A 衛生基準の詳解。",
    tableTitle: "商用高出力超音波スキッド技術仕様標準一覧"
  }
};

const d = DICT[lang];
---

<div class="space-y-10" id="hpu-modeler-app">
  <!-- Top Header / Meta -->
  <div class="border-b border-hairline pb-6">
    <div class="flex flex-wrap items-center gap-2 mb-3">
      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-sky-100 text-sky-800 dark:bg-sky-950 dark:text-sky-300">
        {d.badge}
      </span>
      <span class="text-xs text-muted font-mono">
        FDA 21 CFR &sect; 120 &bull; 3-A 44-03 &bull; EHEDG Doc 8
      </span>
    </div>
    <h1 class="text-title-xl sm:text-display-xs font-bold text-ink tracking-tight">
      {d.title}
    </h1>
    <p class="mt-2 text-body-base text-muted max-w-4xl leading-relaxed">
      {d.subtitle}
    </p>
  </div>

  <!-- Main Simulator Layout (Grid) -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Controls (7 Cols) -->
    <div class="lg:col-span-7 space-y-6">
      <div class="bg-surface-soft border border-hairline rounded-2xl p-5 sm:p-6 space-y-5">
        <div>
          <h2 class="text-title-sm font-semibold text-ink tracking-tight">
            {d.controlsTitle}
          </h2>
          <p class="text-xs text-muted mt-0.5">
            {d.controlsSub}
          </p>
        </div>

        <!-- 1. System Skid Selector -->
        <div>
          <label for="hpu-system-select" class="block text-xs font-medium text-ink mb-1">
            {d.systemLabel}
          </label>
          <select id="hpu-system-select" class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-xs text-ink focus:outline-none focus:ring-2 focus:ring-sky-500">
            {hpuData.hpuSystems.map(sys => (
              <option value={sys.id}>{sys.name}</option>
            ))}
          </select>
          <p class="text-[10px] text-muted mt-1" id="hpu-system-desc">
            {hpuData.hpuSystems[0].description}
          </p>
        </div>

        <!-- 2. Food Matrix Selector -->
        <div>
          <label for="hpu-matrix-select" class="block text-xs font-medium text-ink mb-1">
            {d.matrixLabel}
          </label>
          <select id="hpu-matrix-select" class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-xs text-ink focus:outline-none focus:ring-2 focus:ring-sky-500">
            {hpuData.liquidFoodMatrices.map(mat => (
              <option value={mat.id}>{mat.name}</option>
            ))}
          </select>
          <p class="text-[10px] text-muted mt-1" id="hpu-matrix-desc">
            {hpuData.liquidFoodMatrices[0].description}
          </p>
        </div>

        <!-- 3. Horn Metallurgy Selector -->
        <div>
          <label for="hpu-horn-select" class="block text-xs font-medium text-ink mb-1">
            {d.hornLabel}
          </label>
          <select id="hpu-horn-select" class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-xs text-ink focus:outline-none focus:ring-2 focus:ring-sky-500">
            {hpuData.hornMaterials.map(mat => (
              <option value={mat.id}>{mat.name}</option>
            ))}
          </select>
          <p class="text-[10px] text-muted mt-1" id="hpu-horn-desc">
            {hpuData.hornMaterials[0].description}
          </p>
        </div>

        <!-- Sliders Grid (4 Sliders) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2 border-t border-hairline">
          <!-- Acoustic Power Slider -->
          <div>
            <div class="flex justify-between items-center text-xs mb-1">
              <span class="font-medium text-ink">{d.powerLabel}</span>
              <span class="font-mono text-sky-600 dark:text-sky-400 font-bold" id="hpu-power-val">1000 W</span>
            </div>
            <input type="range" id="hpu-power-slider" min="200" max="12000" step="100" value="1000" class="w-full accent-sky-600 cursor-pointer" />
            <p class="text-[10px] text-muted mt-1">
              {d.powerHelp}
            </p>
          </div>

          <!-- Static Back-Pressure Slider -->
          <div>
            <div class="flex justify-between items-center text-xs mb-1">
              <span class="font-medium text-ink">{d.pressureLabel}</span>
              <span class="font-mono text-sky-600 dark:text-sky-400 font-bold" id="hpu-pressure-val">1.0 bar</span>
            </div>
            <input type="range" id="hpu-pressure-slider" min="1.0" max="6.0" step="0.2" value="1.0" class="w-full accent-sky-600 cursor-pointer" />
            <p class="text-[10px] text-muted mt-1">
              {d.pressureHelp}
            </p>
          </div>

          <!-- Flow Rate Slider -->
          <div>
            <div class="flex justify-between items-center text-xs mb-1">
              <span class="font-medium text-ink">{d.flowLabel}</span>
              <span class="font-mono text-sky-600 dark:text-sky-400 font-bold" id="hpu-flow-val">2.5 L/min</span>
            </div>
            <input type="range" id="hpu-flow-slider" min="0.5" max="100.0" step="0.5" value="2.5" class="w-full accent-sky-600 cursor-pointer" />
            <p class="text-[10px] text-muted mt-1">
              {d.flowHelp}
            </p>
          </div>

          <!-- Inlet Temperature Slider -->
          <div>
            <div class="flex justify-between items-center text-xs mb-1">
              <span class="font-medium text-ink">{d.tempLabel}</span>
              <span class="font-mono text-sky-600 dark:text-sky-400 font-bold" id="hpu-temp-val">20°C</span>
            </div>
            <input type="range" id="hpu-temp-slider" min="5" max="65" step="1" value="20" class="w-full accent-sky-600 cursor-pointer" />
            <p class="text-[10px] text-muted mt-1">
              {d.tempHelp}
            </p>
          </div>
        </div>

        <!-- Presets Bar -->
        <div class="pt-3 border-t border-hairline">
          <span class="block text-xs font-medium text-ink mb-2">
            {d.presetsTitle}
          </span>
          <div class="flex flex-wrap gap-1.5">
            <button type="button" class="px-2.5 py-1 text-[11px] rounded-lg bg-surface hover:bg-surface-soft border border-hairline text-ink transition-colors" id="btn-preset-cider">
              🍎 {d.presetCider}
            </button>
            <button type="button" class="px-2.5 py-1 text-[11px] rounded-lg bg-surface hover:bg-surface-soft border border-hairline text-ink transition-colors" id="btn-preset-citrus">
              🍊 {d.presetCitrus}
            </button>
            <button type="button" class="px-2.5 py-1 text-[11px] rounded-lg bg-surface hover:bg-surface-soft border border-hairline text-ink transition-colors" id="btn-preset-milk">
              🥛 {d.presetMilk}
            </button>
            <button type="button" class="px-2.5 py-1 text-[11px] rounded-lg bg-surface hover:bg-surface-soft border border-hairline text-ink transition-colors" id="btn-preset-brew">
              🍺 {d.presetBrew}
            </button>
            <button type="button" class="px-2.5 py-1 text-[11px] rounded-lg bg-rose-50 hover:bg-rose-100 dark:bg-rose-950/40 dark:hover:bg-rose-950/70 border border-rose-300 dark:border-rose-900 text-rose-700 dark:text-rose-300 transition-colors" id="btn-preset-compromised">
              ⚠️ {d.presetCompromised}
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Live Telemetry Readouts (5 Cols) -->
    <div class="lg:col-span-5 space-y-4 flex flex-col justify-between">
      <div class="bg-surface-soft/80 border border-hairline rounded-2xl p-5 sm:p-6 shadow-xs">
        <div class="flex items-center justify-between pb-3 border-b border-hairline mb-4">
          <div>
            <h2 class="text-title-sm font-semibold text-ink tracking-tight">
              {d.diagnosticTitle}
            </h2>
            <p class="text-[11px] text-muted">
              {d.diagnosticSub}
            </p>
          </div>
          <span class="inline-flex px-2.5 py-1 rounded-md text-[10px] font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300" id="hpu-status-badge">
            OPTIMAL SANITARY
          </span>
        </div>

        <!-- KPI Telemetry Cards -->
        <div class="grid grid-cols-2 gap-3 mb-4">
          <!-- Acoustic Intensity -->
          <div class="bg-surface border border-hairline rounded-xl p-3">
            <span class="block text-[10px] text-muted uppercase font-medium">{d.intensityLabel}</span>
            <span class="text-lg font-mono font-bold text-sky-600 dark:text-sky-400" id="hpu-out-intensity">263 W/cm²</span>
            <span class="block text-[10px] text-muted">Horn face acoustic flux</span>
          </div>

          <!-- Energy Density -->
          <div class="bg-surface border border-hairline rounded-xl p-3">
            <span class="block text-[10px] text-muted uppercase font-medium">{d.energyDensityLabel}</span>
            <span class="text-lg font-mono font-bold text-ink" id="hpu-out-aed">400 J/mL</span>
            <span class="block text-[10px] text-muted">Acoustic dose per volume</span>
          </div>

          <!-- Peak Collapse Pressure -->
          <div class="bg-surface border border-hairline rounded-xl p-3">
            <span class="block text-[10px] text-muted uppercase font-medium">{d.collapsePressureLabel}</span>
            <span class="text-lg font-mono font-bold text-indigo-600 dark:text-indigo-400" id="hpu-out-collapse">1,420 MPa</span>
            <span class="block text-[10px] text-muted">Rayleigh-Plesset peak</span>
          </div>

          <!-- Microjet Velocity -->
          <div class="bg-surface border border-hairline rounded-xl p-3">
            <span class="block text-[10px] text-muted uppercase font-medium">{d.microjetVelocityLabel}</span>
            <span class="text-lg font-mono font-bold text-ink" id="hpu-out-microjet">148 m/s</span>
            <span class="block text-[10px] text-muted">Cell sonoporation shear</span>
          </div>

          <!-- Pathogen Log Reduction -->
          <div class="bg-surface border border-hairline rounded-xl p-3 col-span-2">
            <div class="flex justify-between items-center mb-1">
              <span class="text-[10px] text-muted uppercase font-medium">{d.pathogenLogLabel}</span>
              <span class="text-xs font-mono font-bold text-emerald-600 dark:text-emerald-400" id="hpu-out-pathogen">5.2 Log (FDA 21 CFR § 120 Compliant)</span>
            </div>
            <div class="w-full bg-hairline rounded-full h-2 overflow-hidden">
              <div class="bg-emerald-500 h-2 rounded-full transition-all duration-300" id="hpu-pathogen-bar" style="width: 100%"></div>
            </div>
            <span class="block text-[10px] text-muted mt-1">FDA Juice HACCP target: ≥ 5.0 log reduction</span>
          </div>

          <!-- Target Enzyme Inactivation -->
          <div class="bg-surface border border-hairline rounded-xl p-3">
            <span class="block text-[10px] text-muted uppercase font-medium">{d.enzymeInactivationLabel}</span>
            <span class="text-lg font-mono font-bold text-emerald-600 dark:text-emerald-400" id="hpu-out-enzyme">94.8%</span>
            <span class="block text-[10px] text-muted">PPO / PME residual: <b id="hpu-out-residual">5.2%</b></span>
          </div>

          <!-- Bioactive / Vitamin Retention -->
          <div class="bg-surface border border-hairline rounded-xl p-3">
            <span class="block text-[10px] text-muted uppercase font-medium">{d.nutrientRetentionLabel}</span>
            <span class="text-lg font-mono font-bold text-emerald-600 dark:text-emerald-400" id="hpu-out-retention">96.5%</span>
            <span class="block text-[10px] text-muted">Ascorbate &amp; aroma safe</span>
          </div>

          <!-- Net Temperature Rise & Cooling Load -->
          <div class="bg-surface border border-hairline rounded-xl p-3">
            <span class="block text-[10px] text-muted uppercase font-medium">{d.tempRiseLabel}</span>
            <span class="text-lg font-mono font-bold text-amber-600 dark:text-amber-400" id="hpu-out-temp-rise">+5.2 °C</span>
            <span class="block text-[10px] text-muted">Bulk effluent: <b id="hpu-out-bulk-temp">25.2 °C</b></span>
          </div>

          <div class="bg-surface border border-hairline rounded-xl p-3">
            <span class="block text-[10px] text-muted uppercase font-medium">{d.coolingLoadLabel}</span>
            <span class="text-lg font-mono font-bold text-ink" id="hpu-out-cooling">0.88 kW</span>
            <span class="block text-[10px] text-muted">Counter-flow chilled water</span>
          </div>

          <!-- Sonotrode Tip Sanitary Status -->
          <div class="bg-surface border border-hairline rounded-xl p-3 col-span-2">
            <span class="block text-[10px] text-muted uppercase font-medium">{d.tipSafetyLabel}</span>
            <span class="text-sm font-semibold text-emerald-600 dark:text-emerald-400" id="hpu-out-tip-status">
              3-A Sanitary Compliant &bull; Zero Cavitation Erosion Detected (Ra &le; 0.4 &mu;m)
            </span>
          </div>
        </div>

        <!-- Diagnostic Advisory Box -->
        <div class="p-3.5 rounded-xl border border-hairline bg-surface text-xs space-y-2" id="hpu-advisory-box">
          <div>
            <span class="font-bold text-ink block mb-0.5">{d.primaryLimitationLabel}:</span>
            <span class="text-muted leading-relaxed" id="hpu-advisory-limitation">
              Acoustic energy density is optimal. Non-thermal microbial lethal threshold achieved without thermal degradation of ascorbic acid.
            </span>
          </div>
          <div class="border-t border-hairline pt-2">
            <span class="font-bold text-ink block mb-0.5">{d.mitigationActionLabel}:</span>
            <span class="text-muted leading-relaxed" id="hpu-advisory-mitigation">
              Maintain counter-current cooling jacket flow (chilled water at 10°C) to prevent thermal accumulation in prolonged continuous operations.
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Deep-Dive Science Section -->
  <div class="border-t border-hairline pt-10 space-y-6">
    <div>
      <h2 class="text-title-md font-bold text-ink tracking-tight">
        {d.scienceTitle}
      </h2>
      <p class="text-body-sm text-muted mt-1 max-w-3xl leading-relaxed">
        {d.scienceSub}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs text-muted leading-relaxed">
      <!-- 1. Rayleigh-Plesset Micro-Cavitation Physics -->
      <div class="bg-surface-soft border border-hairline rounded-2xl p-5">
        <div class="w-8 h-8 rounded-lg bg-sky-100 dark:bg-sky-950/60 text-sky-700 dark:text-sky-300 flex items-center justify-center font-bold text-sm mb-3">
          1
        </div>
        <h3 class="font-semibold text-ink text-sm mb-2">Rayleigh-Plesset Acoustic Cavitation Dynamics</h3>
        <p class="mb-2">
          High-power ultrasound (20 to 40 kHz) induces rapid sinusoidal pressure oscillations:
        </p>
        <div class="font-mono bg-surface p-2.5 rounded-lg border border-hairline text-[11px] text-ink mb-2">
          P(t) = P_static + P_A · sin(2π f t)<br />
          R R̈ + 3/2 Ṙ² = (1/ρ_L) [ P_bubble - P(t) - 4μṘ/R - 2σ/R ]
        </div>
        <p>
          During the negative acoustic pressure cycle, fluid tensile strength is exceeded, nucleating microscopic vapor bubbles. During the subsequent compression cycle, bubbles undergo violent adiabatic collapse, generating localized temperatures over <strong>5,000 K</strong> and pressures exceeding <strong>1,000 MPa</strong> with micro-jets up to <strong>200 m/s</strong>.
        </p>
      </div>

      <!-- 2. Sonoporation, Microbial Lysis & Manosonication -->
      <div class="bg-surface-soft border border-hairline rounded-2xl p-5">
        <div class="w-8 h-8 rounded-lg bg-sky-100 dark:bg-sky-950/60 text-sky-700 dark:text-sky-300 flex items-center justify-center font-bold text-sm mb-3">
          2
        </div>
        <h3 class="font-semibold text-ink text-sm mb-2">Microbial Sonoporation &amp; Manosonication (MS)</h3>
        <p class="mb-2">
          The lethal inactivation of foodborne pathogens (<em>E. coli, Salmonella, Listeria</em>) relies on acoustic shear stresses exceeding the tensile limit of cell membranes, inducing irreparable sonoporation pores and intracellular leakage:
        </p>
        <div class="font-mono bg-surface p-2.5 rounded-lg border border-hairline text-[11px] text-ink mb-2">
          Log10(N_0 / N) = t_residence / D_eff(P_static, T, I_ac)<br />
          FDA Target: ≥ 5.0 Log Inactivation
        </div>
        <p>
          Applying moderate static back-pressure (<strong>Manosonication, 1.5 to 4.0 bar</strong>) prevents premature bubble vapor cushioning, maximizing collapse energy and reducing decimal reduction time (<em>D-value</em>) by 60% to 80% at low bulk temperatures (&lt; 45°C).
        </p>
      </div>

      <!-- 3. Sonotrode Tip Cavitation Erosion & 3-A Sanitary Standards -->
      <div class="bg-surface-soft border border-hairline rounded-2xl p-5">
        <div class="w-8 h-8 rounded-lg bg-sky-100 dark:bg-sky-950/60 text-sky-700 dark:text-sky-300 flex items-center justify-center font-bold text-sm mb-3">
          3
        </div>
        <h3 class="font-semibold text-ink text-sm mb-2">Tip Erosion, Metal Particulates &amp; 3-A Sanitary 44-03</h3>
        <p class="mb-2">
          Intense acoustic cavitation erodes the sonotrode radiating face over extended operation. Pitting craters greater than <strong>50 µm</strong> cause acoustic resonance frequency drift, impedance decoupling, and risk shedding titanium micro-particulates into the food stream.
        </p>
        <p>
          Under <strong>3-A Sanitary Standard 44-03</strong> and <strong>EHEDG Document 8</strong>, food-contact sonotrodes must be fabricated from certified Grade 5 Ti-6Al-4V ELI with electropolished surfaces (<em>Ra ≤ 0.4 µm</em>), accompanied by routine profilometry inspections and scheduled horn dressing every 500 operating hours.
        </p>
      </div>
    </div>
  </div>

  <!-- Reference Data Table -->
  <div class="border-t border-hairline pt-8">
    <h2 class="text-title-sm font-semibold text-ink tracking-tight mb-4">
      {d.tableTitle}
    </h2>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs border-collapse">
        <thead>
          <tr class="border-b border-hairline bg-surface-soft text-muted font-mono uppercase text-[10px]">
            <th class="py-2.5 px-3">Skid ID</th>
            <th class="py-2.5 px-3">Acoustic Architecture</th>
            <th class="py-2.5 px-3">Frequency</th>
            <th class="py-2.5 px-3">Rated Power</th>
            <th class="py-2.5 px-3">Horn Tip Diameter</th>
            <th class="py-2.5 px-3">Nominal Flow</th>
            <th class="py-2.5 px-3">Max Pressure</th>
            <th class="py-2.5 px-3">Sanitary Certifications</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline">
          {hpuData.hpuSystems.map(sys => (
            <tr class="hover:bg-surface-soft/60 transition-colors">
              <td class="py-2.5 px-3 font-mono font-medium text-ink">{sys.id}</td>
              <td class="py-2.5 px-3 text-body">{sys.technologyType.split('with')[0]}</td>
              <td class="py-2.5 px-3 font-mono text-body">{sys.operatingFrequencyKhz} kHz</td>
              <td class="py-2.5 px-3 font-mono text-sky-600 dark:text-sky-400">{sys.maxAcousticPowerWatts} W</td>
              <td class="py-2.5 px-3 font-mono text-body">{sys.sonotrodeTipDiameterMm} mm</td>
              <td class="py-2.5 px-3 font-mono text-body">{sys.nominalFlowRateLPerMin} L/min</td>
              <td class="py-2.5 px-3 font-mono text-body">{sys.maxChamberPressureBar} bar</td>
              <td class="py-2.5 px-3 text-[11px] text-muted">{sys.sanitaryCertifications}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  // @ts-nocheck
  document.addEventListener('DOMContentLoaded', () => {
    const systems = {
      pilot_flow_through_hpu_reactor: {
        id: 'pilot_flow_through_hpu_reactor',
        freq: 24.0,
        tipDiamMm: 22.0,
        tipAreaCm2: 3.80,
        cellVolMl: 350.0,
        maxPWatts: 1000.0,
        maxPressure: 4.0,
        efficiency: 0.88,
        compromised: false,
        desc: "High-precision stepped titanium sonotrode continuous flow reactor engineered for process validation of non-thermal cold pasteurization and enzyme deactivation in artisanal juices and botanical extracts."
      },
      commercial_dual_frequency_radial_skid: {
        id: 'commercial_dual_frequency_radial_skid',
        freq: 20.0,
        tipDiamMm: 38.0,
        tipAreaCm2: 11.34,
        cellVolMl: 1850.0,
        maxPWatts: 4500.0,
        maxPressure: 6.0,
        efficiency: 0.92,
        compromised: false,
        desc: "Heavy-duty commercial radial acoustic reactor delivering uniform 360-degree cavitation fields without acoustic shadows, maximizing microbial cell membrane sonoporation in cloudy juices and dairy streams."
      },
      industrial_cascade_manosonication_train: {
        id: 'industrial_cascade_manosonication_train',
        freq: 20.0,
        tipDiamMm: 50.0,
        tipAreaCm2: 19.63,
        cellVolMl: 6200.0,
        maxPWatts: 12000.0,
        maxPressure: 10.0,
        efficiency: 0.94,
        compromised: false,
        desc: "Large-scale continuous multi-horn manosonication train combining 3.5 bar static hydraulic back-pressure with 20 kHz acoustic cavitation, producing catastrophic micro-bubble collapse shockwaves that achieve 5-log pathogen reduction at 45°C."
      },
      compromised_pitted_sonotrode_unit: {
        id: 'compromised_pitted_sonotrode_unit',
        freq: 21.8,
        tipDiamMm: 32.0,
        tipAreaCm2: 8.04,
        cellVolMl: 1200.0,
        maxPWatts: 2200.0,
        maxPressure: 2.0,
        efficiency: 0.56,
        compromised: true,
        desc: "Severely degraded ultrasonic reactor with deep cavitation pitting craters (> 350 µm) on the horn face, causing severe acoustic impedance mismatch, acoustic streaming loss, erratic power dissipation, and foreign material metal contamination."
      }
    };

    const matrices = {
      fresh_cloudy_apple_cider: {
        id: 'fresh_cloudy_apple_cider',
        ph: 3.6,
        brix: 11.8,
        viscosity: 2.1,
        density: 1048.0,
        dValueBase: 1.45,
        cavitationSensitivity: 1.25,
        enzymeLabel: 'PPO & POD',
        desc: "Raw unpasteurized apple cider with active polyphenol oxidase causing rapid enzymatic browning and sediment settling; HPU inactivates PPO and stabilizes pectin cloud without boiled-flavor off-notes."
      },
      cold_pressed_orange_juice: {
        id: 'cold_pressed_orange_juice',
        ph: 3.8,
        brix: 11.5,
        viscosity: 3.2,
        density: 1052.0,
        dValueBase: 1.80,
        cavitationSensitivity: 1.15,
        enzymeLabel: 'PME (Cloud Loss)',
        desc: "Premium freshly squeezed orange juice requiring 90%+ inactivation of pectin methylesterase to prevent clear serum separation (cloud loss) while meeting FDA 5-log pathogen reduction."
      },
      raw_bovine_whole_milk: {
        id: 'raw_bovine_whole_milk',
        ph: 6.7,
        brix: 12.8,
        viscosity: 2.8,
        density: 1032.0,
        dValueBase: 2.10,
        cavitationSensitivity: 0.92,
        enzymeLabel: 'LPL & ALP',
        desc: "High-value dairy liquid where intense acoustic micro-shearing reduces milk fat globule size from 3.5 µm to under 0.8 µm, simultaneously delivering microbial reduction and natural emulsion stability."
      },
      craft_brewing_wort_beer: {
        id: 'craft_brewing_wort_beer',
        ph: 4.3,
        brix: 12.5,
        viscosity: 1.9,
        density: 1042.0,
        dValueBase: 1.15,
        cavitationSensitivity: 1.35,
        enzymeLabel: 'Protein-Polyphenol Haze',
        desc: "Unfiltered craft brewing beverage requiring physical disruption of colloidal haze particles and removal of dissolved oxygen to maximize shelf stability without pasteurization heat damage."
      },
      botanical_adaptogen_extract: {
        id: 'botanical_adaptogen_extract',
        ph: 5.2,
        brix: 8.5,
        viscosity: 1.6,
        density: 995.0,
        dValueBase: 1.65,
        cavitationSensitivity: 1.45,
        enzymeLabel: 'Pectinase & Glucosidase',
        desc: "High-potency botanical extract where acoustic cavitation micro-jets shear rigid herbal cell walls, releasing intracellular adaptogenic phytochemicals into the continuous extraction stream."
