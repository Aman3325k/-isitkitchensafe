    powerSlider.addEventListener('input', () => {
      powerDisplay.textContent = `${powerSlider.value} W`;
      calculateDiagnostics();
    });

    pressureSlider.addEventListener('input', () => {
      pressureDisplay.textContent = `${parseFloat(pressureSlider.value).toFixed(1)} bar`;
      calculateDiagnostics();
    });

    flowSlider.addEventListener('input', () => {
      flowDisplay.textContent = `${parseFloat(flowSlider.value).toFixed(1)} L/min`;
      calculateDiagnostics();
    });

