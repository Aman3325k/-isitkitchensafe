      flowSlider.value = 18.0;
      tempSlider.value = 14;
      powerDisplay.textContent = '2200 W';
      pressureDisplay.textContent = '1.8 bar';
      flowDisplay.textContent = '18.0 L/min';
      tempDisplay.textContent = '14°C';
      systemDesc.textContent = systems.commercial_dual_frequency_radial_skid.desc;
      matrixDesc.textContent = matrices.craft_brewing_wort_beer.desc;
      hornDesc.textContent = horns.hastelloy_c276.desc;
      calculateDiagnostics();
    });

    document.getElementById('btn-preset-compromised')?.addEventListener('click', () => {
      systemSelect.value = 'compromised_pitted_sonotrode_unit';
      matrixSelect.value = 'fresh_cloudy_apple_cider';
      hornSelect.value = 'pitted_fatigued_ti';
      powerSlider.max = 2200;
      powerSlider.value = 1800;
      pressureSlider.value = 1.2;
      flowSlider.value = 15.0;
      tempSlider.value = 25;
      powerDisplay.textContent = '1800 W';
      pressureDisplay.textContent = '1.2 bar';
      flowDisplay.textContent = '15.0 L/min';
      tempDisplay.textContent = '25°C';
      systemDesc.textContent = systems.compromised_pitted_sonotrode_unit.desc;
      matrixDesc.textContent = matrices.fresh_cloudy_apple_cider.desc;
      hornDesc.textContent = horns.pitted_fatigued_ti.desc;
      calculateDiagnostics();
    });

    // Initial Execution
    calculateDiagnostics();
  });
</script>
