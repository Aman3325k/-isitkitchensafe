    const powerDisplay = document.getElementById('hpu-power-val');
    const pressureDisplay = document.getElementById('hpu-pressure-val');
    const flowDisplay = document.getElementById('hpu-flow-val');
    const tempDisplay = document.getElementById('hpu-temp-val');

    const systemDesc = document.getElementById('hpu-system-desc');
    const matrixDesc = document.getElementById('hpu-matrix-desc');
    const hornDesc = document.getElementById('hpu-horn-desc');

    // Telemetry DOM
    const statusBadge = document.getElementById('hpu-status-badge');
    const outIntensity = document.getElementById('hpu-out-intensity');
    const outAed = document.getElementById('hpu-out-aed');
    const outCollapse = document.getElementById('hpu-out-collapse');
    const outMicrojet = document.getElementById('hpu-out-microjet');
    const outPathogen = document.getElementById('hpu-out-pathogen');
    const pathogenBar = document.getElementById('hpu-pathogen-bar');
    const outEnzyme = document.getElementById('hpu-out-enzyme');
    const outResidual = document.getElementById('hpu-out-residual');
    const outRetention = document.getElementById('hpu-out-retention');
    const outTempRise = document.getElementById('hpu-out-temp-rise');
    const outBulkTemp = document.getElementById('hpu-out-bulk-temp');
    const outCooling = document.getElementById('hpu-out-cooling');
    const outTipStatus = document.getElementById('hpu-out-tip-status');
    const advisoryLimitation = document.getElementById('hpu-advisory-limitation');
    const advisoryMitigation = document.getElementById('hpu-advisory-mitigation');

    function calculateDiagnostics() {
      const sysKey = systemSelect.value;
      const matKey = matrixSelect.value;
      const hornKey = hornSelect.value;

      const sys = systems[sysKey] || systems.pilot_flow_through_hpu_reactor;
      const mat = matrices[matKey] || matrices.fresh_cloudy_apple_cider;
      const horn = horns[hornKey] || horns.ti_6al_4v_grade5;

      const powerW = parseFloat(powerSlider.value);
      const pressureBar = parseFloat(pressureSlider.value);
      const flowLMin = parseFloat(flowSlider.value);
      const tempC = parseFloat(tempSlider.value);

      // 1. Acoustic Intensity (W/cm²)
      const effectivePowerW = powerW * sys.efficiency * horn.acousticCoupling;
      const intensity = effectivePowerW / sys.tipAreaCm2;

      // 2. Residence Time & Acoustic Energy Density (AED, J/mL)
      const flowMLSec = (flowLMin * 1000.0) / 60.0;
      const residenceTimeSec = sys.cellVolMl / flowMLSec;
      const aedJPerMl = effectivePowerW / flowMLSec;

      // 3. Transient Cavitation Collapse Peak Pressure (MPa)
      // Governed by static pressure and intensity: P_collapse ~ P_static * (P_A / P_static)^(3*gamma/(3*gamma-1))
      // Manosonication amplifies collapse pressure:
      const pStaticMpa = pressureBar * 0.1;
      const basePressureMpa = 650.0 + (pStaticMpa * 350.0) + Math.sqrt(intensity) * 45.0;
      const collapsePressureMpa = horn.pitted ? basePressureMpa * 0.38 : basePressureMpa;

      // 4. Acoustic Microjet Velocity (m/s)
      const microjetVel = horn.pitted 
        ? 55.0 + Math.sqrt(intensity) * 2.1 
        : 110.0 + (pStaticMpa * 28.0) + Math.sqrt(intensity) * 3.8;

      // 5. Synergistic Microbial Inactivation (Log10 reduction)
      // Thermosonication synergy factor above 40°C:
      const thermalSynergy = tempC > 40.0 ? Math.exp((tempC - 40.0) * 0.065) : 1.0;
      // Manosonication synergy factor:
      const pressureSynergy = 1.0 + (pressureBar - 1.0) * 0.45;
      const effectiveDValSec = (mat.dValueBase * 60.0) / (mat.cavitationSensitivity * (intensity / 150.0) * pressureSynergy * thermalSynergy);
      
      let logReduction = (residenceTimeSec / effectiveDValSec) * 3.2;
      if (horn.pitted) logReduction *= 0.42;
      if (logReduction > 8.0) logReduction = 8.0;

      // 6. Target Enzyme Inactivation (PPO / PME)
      // Cavitation shear disrupts tertiary structure:
      const shearInact = 1.0 - Math.exp(-0.0035 * aedJPerMl * pressureSynergy);
      let enzymeInactPercent = Math.min(99.8, shearInact * 100.0);
      if (tempC > 45.0) enzymeInactPercent = Math.min(99.9, enzymeInactPercent + (tempC - 45.0) * 0.8);
      if (horn.pitted) enzymeInactPercent *= 0.55;
      const enzymeResidualPercent = Math.max(0.1, 100.0 - enzymeInactPercent);

      // 7. Bioactive & Vitamin Retention
      // Acoustic non-thermal preserves vitamins; thermal accumulation reduces retention
      const netThermalDegradation = tempC > 48.0 ? (tempC - 48.0) * 0.65 : 0.0;
      const acousticRadicalLoss = (aedJPerMl > 1200.0) ? (aedJPerMl - 1200.0) * 0.004 : 0.0;
      let nutrientRetention = Math.max(82.0, 98.5 - netThermalDegradation - acousticRadicalLoss);
      if (horn.pitted) nutrientRetention -= 4.5;

      // 8. Acoustic Dissipation Heating & Jacket Cooling Load
      // Bulk fluid heating: Q = m * Cp * dT -> dT = (Power * eta_thermal) / (flow * rho * Cp)
      const cpFluid = 3900.0; // J/kg·K for fruit juices/milk
      const massFlowKgSec = (flowLMin / 60.0) * (mat.density / 1000.0);
      const thermalDissipationW = effectivePowerW * 0.78; // ~78% acoustic energy degrades into heat
      const tempRiseC = thermalDissipationW / (massFlowKgSec * cpFluid);
      const bulkOutletTempC = tempC + tempRiseC;
      const coolingLoadKw = thermalDissipationW / 1000.0;

      // Update Live UI
      outIntensity.textContent = `${intensity.toFixed(0)} W/cm²`;
      outAed.textContent = `${aedJPerMl.toFixed(0)} J/mL`;
      outCollapse.textContent = `${collapsePressureMpa.toFixed(0)} MPa`;
      outMicrojet.textContent = `${microjetVel.toFixed(0)} m/s`;
      outPathogen.textContent = `${logReduction.toFixed(1)} Log (${logReduction >= 5.0 ? 'FDA Compliant' : 'Sub-5-Log'})`;
      pathogenBar.style.width = `${Math.min(100, (logReduction / 5.0) * 100)}%`;
      if (logReduction >= 5.0) {
        pathogenBar.className = "bg-emerald-500 h-2 rounded-full transition-all duration-300";
        outPathogen.className = "text-xs font-mono font-bold text-emerald-600 dark:text-emerald-400";
      } else {
        pathogenBar.className = "bg-amber-500 h-2 rounded-full transition-all duration-300";
        outPathogen.className = "text-xs font-mono font-bold text-amber-600 dark:text-amber-400";
      }

      outEnzyme.textContent = `${enzymeInactPercent.toFixed(1)}%`;
      outResidual.textContent = `${enzymeResidualPercent.toFixed(1)}%`;
      outRetention.textContent = `${nutrientRetention.toFixed(1)}%`;
      outTempRise.textContent = `+${tempRiseC.toFixed(1)} °C`;
      outBulkTemp.textContent = `${bulkOutletTempC.toFixed(1)} °C`;
      outCooling.textContent = `${coolingLoadKw.toFixed(2)} kW`;

      // Status Badge & Advisories
      if (horn.pitted || sys.compromised) {
        statusBadge.textContent = "CRITICAL HAZARD";
        statusBadge.className = "inline-flex px-2.5 py-1 rounded-md text-[10px] font-bold uppercase tracking-wider bg-rose-100 text-rose-800 dark:bg-rose-950 dark:text-rose-300";
        outTipStatus.textContent = "NON-COMPLIANT: Severe Cavitation Pitting Crater Depth > 350 µm & Titanium Particle Shedding Hazard";
        outTipStatus.className = "text-sm font-semibold text-rose-600 dark:text-rose-400";
        advisoryLimitation.textContent = "Sonotrode tip has exceeded fatigue life. Resonator frequency mismatch (> 1,200 Hz drift) impairs energy transfer while spalling titanium particulates into the product stream.";
        advisoryMitigation.textContent = "IMMEDIATE SHUTDOWN REQUIRED: Remove compromised horn for diamond profilometry inspection. Dress or replace with certified Grade 5 Ti-6Al-4V ELI resonator under 3-A Sanitary 44-03 protocols.";
      } else if (logReduction < 5.0) {
        statusBadge.textContent = "INSUFFICIENT LOG-KILL";
        statusBadge.className = "inline-flex px-2.5 py-1 rounded-md text-[10px] font-bold uppercase tracking-wider bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300";
        outTipStatus.textContent = `${horn.sanitaryGrade} • Acoustic Coupling Normal`;
        outTipStatus.className = "text-sm font-semibold text-amber-600 dark:text-amber-400";
        advisoryLimitation.textContent = `Residence time (${residenceTimeSec.toFixed(1)}s) is insufficient to achieve FDA 21 CFR § 120 5-log target (achieved ${logReduction.toFixed(1)}-log). Pathogen survival risk remains.`;
        advisoryMitigation.textContent = "Increase chamber static pressure to ≥ 2.5 bar (Manosonication) or reduce volumetric flow rate to increase residence time within the active cavitation horn zone.";
      } else if (bulkOutletTempC > 52.0) {
        statusBadge.textContent = "THERMAL WARNING";
        statusBadge.className = "inline-flex px-2.5 py-1 rounded-md text-[10px] font-bold uppercase tracking-wider bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300";
        outTipStatus.textContent = `${horn.sanitaryGrade} • Excessive Thermal Dissipation`;
        outTipStatus.className = "text-sm font-semibold text-amber-600 dark:text-amber-400";
        advisoryLimitation.textContent = `Effluent bulk temperature (${bulkOutletTempC.toFixed(1)}°C) exceeds non-thermal cold pasteurization threshold, causing initial loss of fresh aroma volatiles.`;
        advisoryMitigation.textContent = `Engage counter-current flow-cell cooling jacket with chilled glycol/water to absorb ${coolingLoadKw.toFixed(2)} kW dissipation load and maintain effluent below 45°C.`;
      } else {
        statusBadge.textContent = "OPTIMAL SANITARY";
        statusBadge.className = "inline-flex px-2.5 py-1 rounded-md text-[10px] font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300";
        outTipStatus.textContent = `${horn.sanitaryGrade} • Zero Micro-Cracks Detected (Ra ≤ 0.4 µm)`;
        outTipStatus.className = "text-sm font-semibold text-emerald-600 dark:text-emerald-400";
        advisoryLimitation.textContent = "Acoustic intensity and static back-pressure are synchronized. High-intensity micro-jets achieve 5-log pathogen reduction without thermal quality degradation.";
        advisoryMitigation.textContent = "Maintain counter-current chilled jacket circulation and conduct standard 3-A Sanitary Clean-In-Place (CIP) enzymatic wash following batch completion.";
      }
    }

    // Event Listeners for UI
    systemSelect.addEventListener('change', () => {
      const sys = systems[systemSelect.value];
