        pressureSlider.max = sys.maxPressure;
      }
      calculateDiagnostics();
    });

    matrixSelect.addEventListener('change', () => {
      const mat = matrices[matrixSelect.value];
      if (mat) matrixDesc.textContent = mat.desc;
      calculateDiagnostics();
    });

    hornSelect.addEventListener('change', () => {
      const horn = horns[hornSelect.value];
      if (horn) hornDesc.textContent = horn.desc;
      calculateDiagnostics();
