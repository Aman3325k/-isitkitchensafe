    const substrateSelect = document.getElementById('substrate-select');
    const drawSelect = document.getElementById('draw-select');
    const crystallizerSelect = document.getElementById('crystallizer-select');

    const tempSlider = document.getElementById('temp-slider');
    const tempDisplay = document.getElementById('temp-display');

    const feedFlowSlider = document.getElementById('feed-flow-slider');
    const feedFlowDisplay = document.getElementById('feed-flow-display');

    const drawPressureSlider = document.getElementById('draw-pressure-slider');
    const drawPressureDisplay = document.getElementById('draw-pressure-display');

    const targetBrixSlider = document.getElementById('target-brix-slider');
    const targetBrixDisplay = document.getElementById('target-brix-display');

    // Stats
    const statAroma = document.getElementById('stat-aroma');
    const statBioactive = document.getElementById('stat-bioactive');
    const statFlux = document.getElementById('stat-flux');
    const statIceGrowth = document.getElementById('stat-ice-growth');
    const statIceSub = document.getElementById('stat-ice-sub');
    const statReverseFlux = document.getElementById('stat-reverse-flux');
    const statSec = document.getElementById('stat-sec');

    const badgeCompliance = document.getElementById('badge-compliance');
    const statComplianceText = document.getElementById('stat-compliance-text');
    const statLimitationText = document.getElementById('stat-limitation-text');
    const statMitigationText = document.getElementById('stat-mitigation-text');

    // Presets
    const presetBerry = document.getElementById('preset-berry');
    const presetColostrum = document.getElementById('preset-colostrum');
    const presetOrange = document.getElementById('preset-orange');
    const presetRoyalJelly = document.getElementById('preset-royal-jelly');
    const presetHazard = document.getElementById('preset-hazard');

    function updateSimulation() {
      const curSys = data.fofcSystems.find(s => s.id === systemSelect.value) || data.fofcSystems[0];
      const curSub = data.thermolabileFeeds.find(s => s.id === substrateSelect.value) || data.thermolabileFeeds[0];
      const curDraw = data.drawSolutions.find(d => d.id === drawSelect.value) || data.drawSolutions[0];
      const curCryst = data.crystallizationModes.find(c => c.id === crystallizerSelect.value) || data.crystallizationModes[0];

      const temp = parseFloat(tempSlider.value);
      const feedFlow = parseFloat(feedFlowSlider.value);
      const drawPressure = parseFloat(drawPressureSlider.value);
      const targetBrix = parseFloat(targetBrixSlider.value);

      tempDisplay.textContent = temp.toFixed(0) + ' °C';
      feedFlowDisplay.textContent = feedFlow.toFixed(0) + ' L/h';
      drawPressureDisplay.textContent = drawPressure.toFixed(0) + ' bar';
      targetBrixDisplay.textContent = targetBrix.toFixed(0) + ' °Brix';

      // 1. Stage-1 FO Water Flux (J_w)
      // Driven by (drawPressure - feedOsmoticPressure)
      const feedOsmoticPressure = (curSub.initialBrix * 3.8); // approx 3.8 bar per degree Brix
      const netDrivingForce = Math.max(10, drawPressure - feedOsmoticPressure);
      const tempFluxFactor = 1.0 + (temp - 6) * 0.025;
      const baseFlux = 14.5 * (curDraw.waterFluxFactor || 1.0);
      const calculatedFlux = (baseFlux * (netDrivingForce / 70.0) * tempFluxFactor * (curSys.foMembraneAreaM2 / 100.0));
      const fluxClamped = Math.max(3.5, Math.min(26.0, calculatedFlux));
      statFlux.textContent = fluxClamped.toFixed(1) + ' LMH';

      // 2. Stage-2 Ice Crystal Growth Rate (mm/h)
      // Proportional to refrigeration capacity, inversely to target Brix viscosity
      const viscosityPenalty = 1.0 - Math.min(0.65, (targetBrix - 30) * 0.015);
      const iceGrowthRate = (2.2 * (curSys.pfcRefrigerationCapacityKw / 30.0) * viscosityPenalty * (curCryst.refrigerationCoeffPerformance / 3.5));
      statIceGrowth.textContent = iceGrowthRate.toFixed(1) + ' mm/h';

      // 3. Aroma Ester Retention (%)
      // Hybrid non-thermal retains virtually 100%
      // Minor penalty only if temperature is unusually high
      let aromaLoss = 0.0;
      if (temp > 12.0) {
        aromaLoss = (temp - 12.0) * 0.25;
      }
      const aromaRetention = Math.max(92.0, Math.min(99.8, curSub.fofcHybridAromaRetentionPercent - aromaLoss));
      statAroma.textContent = aromaRetention.toFixed(1) + '%';

      // 4. Bioactive / Vitamin C Retention (%)
      let bioactiveLoss = 0.0;
      if (temp > 10.0) {
        bioactiveLoss = (temp - 10.0) * 0.35;
      }
      const bioactiveRetention = Math.max(88.0, Math.min(99.6, (curSub.fofcHybridAromaRetentionPercent - 0.5) - bioactiveLoss));
      statBioactive.textContent = bioactiveRetention.toFixed(1) + '%';

      // 5. Reverse Draw Solute Flux (J_s)
      const reverseSolute = curSys.reverseSoluteFluxGPerM2Hr * (drawPressure / 80.0);
      statReverseFlux.textContent = reverseSolute.toFixed(3) + ' g/m²·h';

      // 6. Specific Energy Consumption (MJ/kg H2O)
      const sec = 0.72 * (3.5 / curCryst.refrigerationCoeffPerformance) * (1.0 + (targetBrix - 40) * 0.01);
      statSec.textContent = sec.toFixed(2) + ' MJ/kg';

      // 7. Hazard and Quality Audit
      if (targetBrix > 66 && iceGrowthRate > 3.0) {
        badgeCompliance.textContent = 'WARNING: DENDRITIC ICE SOLUTE ENTRAPMENT';
        badgeCompliance.className = 'px-3 py-1 rounded-full text-xs font-extrabold uppercase tracking-wider bg-amber-950 text-amber-300 border border-amber-800';
        statIceSub.textContent = 'Dendritic Matrix Risk';
        statIceSub.className = 'text-[11px] text-amber-400 font-mono';
        statComplianceText.textContent = 'High Brix viscosity (' + targetBrix + '° Brix) combined with rapid ice crystallization rate (' + iceGrowthRate.toFixed(1) + ' mm/h) exceeds the Mullins-Sekerka planar stability limit. Solutes will be trapped in microscopic ice dendrites.';
        statLimitationText.textContent = 'Concentration polarization and high juice viscosity suppress solute diffusion away from the ice boundary.';
        statMitigationText.textContent = 'Attenuate secondary refrigerant chilling rate to reduce linear ice growth speed to < 2.0 mm/h, or operate Stage 1 FO to achieve higher intermediate pre-concentration.';
      } else if (temp > 15) {
        badgeCompliance.textContent = 'WARNING: THERMAL COLD-CHAIN DRIFT';
        badgeCompliance.className = 'px-3 py-1 rounded-full text-xs font-extrabold uppercase tracking-wider bg-amber-950 text-amber-300 border border-amber-800';
        statIceSub.textContent = 'Planar Interface';
        statIceSub.className = 'text-[11px] text-emerald-400 font-mono';
        statComplianceText.textContent = 'Process temperature (' + temp + '°C) exceeds optimal non-thermal envelope (2°C–8°C). Microbial growth kinetics increase and top-note aroma ester retention drops.';
        statLimitationText.textContent = 'Elevated temperatures increase internal membrane reverse salt diffusion and accelerate vitamin C aerobic breakdown.';
        statMitigationText.textContent = 'Increase cooling water flow to heat exchangers to restore sub-ambient loop temperature between 4°C and 8°C.';
      } else {
        badgeCompliance.textContent = 'OPTIMAL FO-FC HYBRID';
        badgeCompliance.className = 'px-3 py-1 rounded-full text-xs font-extrabold uppercase tracking-wider bg-emerald-950 text-emerald-300 border border-emerald-800';
        statIceSub.textContent = 'Planar Interface (0.1% Loss)';
        statIceSub.className = 'text-[11px] text-emerald-400 font-mono';
        statComplianceText.textContent = 'Full compliance with FDA 21 CFR § 117 sanitary manufacturing and 3-A Sanitary Standards for Milk and Milk Products. Low-temperature non-thermal concentration retains 100% of native aroma volatile profile without caramelization or scorched deposits.';
        statLimitationText.textContent = 'Clean-in-place (CIP) required weekly to remove organic fouling; reverse draw solute flux stays safely below 0.05 g/m²·h.';
        statMitigationText.textContent = 'Maintain steady cross-flow velocities in both FO membrane and freeze crystallization tubes.';
      }
    }

    // Event listeners
    systemSelect.addEventListener('change', updateSimulation);
    substrateSelect.addEventListener('change', updateSimulation);
    drawSelect.addEventListener('change', updateSimulation);
    crystallizerSelect.addEventListener('change', updateSimulation);

    tempSlider.addEventListener('input', updateSimulation);
    feedFlowSlider.addEventListener('input', updateSimulation);
    drawPressureSlider.addEventListener('input', updateSimulation);
    targetBrixSlider.addEventListener('input', updateSimulation);

    // Presets
    if (presetBerry) {
      presetBerry.addEventListener('click', function() {
        systemSelect.value = 'industrial_continuous_two_stage_fofc_skid';
        substrateSelect.value = 'cold_pressed_blackcurrant_juice';
        drawSelect.value = 'concentrated_magnesium_chloride';
        crystallizerSelect.value = 'progressive_tubular_pfc';
        tempSlider.value = '4';
        feedFlowSlider.value = '1500';
        drawPressureSlider.value = '105';
        targetBrixSlider.value = '62';
        updateSimulation();
      });
    }

    if (presetColostrum) {
      presetColostrum.addEventListener('click', function() {
        systemSelect.value = 'aseptic_biopharmaceutical_hollow_fiber_fofc_system';
        substrateSelect.value = 'bovine_colostrum_serum';
        drawSelect.value = 'potassium_lactate_food_grade';
        crystallizerSelect.value = 'progressive_tubular_pfc';
        tempSlider.value = '3';
        feedFlowSlider.value = '600';
        drawPressureSlider.value = '90';
        targetBrixSlider.value = '52';
        updateSimulation();
      });
    }

    if (presetOrange) {
      presetOrange.addEventListener('click', function() {
        systemSelect.value = 'industrial_continuous_two_stage_fofc_skid';
        substrateSelect.value = 'valencia_orange_essence_juice';
        drawSelect.value = 'concentrated_magnesium_chloride';
        crystallizerSelect.value = 'suspension_scraped_surface_sfc';
        tempSlider.value = '5';
        feedFlowSlider.value = '1800';
        drawPressureSlider.value = '110';
        targetBrixSlider.value = '65';
        updateSimulation();
      });
    }

    if (presetRoyalJelly) {
      presetRoyalJelly.addEventListener('click', function() {
        systemSelect.value = 'pilot_multi_pass_rotary_drum_fofc_unit';
        substrateSelect.value = 'raw_royal_jelly_colloid';
        drawSelect.value = 'high_brix_sucrose_syrup';
        crystallizerSelect.value = 'internal_refrigerated_rotary_drum';
        tempSlider.value = '4';
        feedFlowSlider.value = '450';
        drawPressureSlider.value = '85';
        targetBrixSlider.value = '70';
        updateSimulation();
      });
    }

    if (presetHazard) {
      presetHazard.addEventListener('click', function() {
        systemSelect.value = 'compact_modular_containerized_fofc_train';
        substrateSelect.value = 'valencia_orange_essence_juice';
        drawSelect.value = 'concentrated_magnesium_chloride';
        crystallizerSelect.value = 'progressive_tubular_pfc';
        tempSlider.value = '17';
        feedFlowSlider.value = '2400';
        drawPressureSlider.value = '125';
        targetBrixSlider.value = '70';
        updateSimulation();
      });
    }

    // Initialize
    updateSimulation();
  })();
</script>
