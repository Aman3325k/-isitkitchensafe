---
import rawData from '../data/cookware-oven-temp-data.json';
import type { SupportedLanguage } from '../i18n/ui';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;
const defaultUnit = lang === 'en' ? 'F' : 'C';

interface LocalizedItem {
  id: string;
  category: string;
  categoryLabel: string;
  maxOvenTempF: number;
  maxOvenTempC: number;
  maxUncoveredTempF: number | null;
  tempRangeDisplayF: string;
  tempRangeDisplayC: string;
  broilerSafe: boolean;
  thermalRisk: string;
  searchText: string;
  name: string;
  summary: string;
  warning: string;
  lidOrHandleNote: string;
  failureMode: string;
  safeAlternative: string;
}

const categoryMap = new Map<string, string>();
const localizedCategories = rawData.categories.map((cat) => {
  const label = (cat.label as Record<string, string>)[lang] || cat.label.en;
  categoryMap.set(cat.id, label);
  return {
    id: cat.id,
    label,
    count: rawData.items.filter((i) => i.category === cat.id).length
  };
});

const localizedItems: LocalizedItem[] = rawData.items.map((item) => {
  const name = (item.name as Record<string, string>)[lang] || item.name.en;
  const summary = (item.summary as Record<string, string>)[lang] || item.summary.en;
  const warning = (item.warning as Record<string, string>)[lang] || item.warning.en;
  const lidOrHandleNote = (item.lidOrHandleNote as Record<string, string>)[lang] || item.lidOrHandleNote.en;
  const failureMode = (item.failureMode as Record<string, string>)[lang] || item.failureMode.en;
  const safeAlternative = (item.safeAlternative as Record<string, string>)[lang] || item.safeAlternative.en;
  const categoryLabel = categoryMap.get(item.category) || item.category;

  const searchParts = [
    name,
    item.name.en,
    summary,
    warning,
    lidOrHandleNote,
    categoryLabel,
    item.searchAliases || ''
  ];

  return {
    id: item.id,
    category: item.category,
    categoryLabel,
    maxOvenTempF: item.maxOvenTempF,
    maxOvenTempC: item.maxOvenTempC,
    maxUncoveredTempF: typeof (item as any).maxUncoveredTempF === 'number' ? (item as any).maxUncoveredTempF : null,
    tempRangeDisplayF: item.tempRangeDisplayF,
    tempRangeDisplayC: item.tempRangeDisplayC,
    broilerSafe: item.broilerSafe,
    thermalRisk: item.thermalRisk,
    searchText: searchParts.join(' ').toLowerCase(),
    name,
    summary,
    warning,
    lidOrHandleNote,
    failureMode,
    safeAlternative
  };
});

