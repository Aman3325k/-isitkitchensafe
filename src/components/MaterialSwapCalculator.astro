    savingsSub: "買い替えが必要な安価なフライパンを使い続ける場合と、一生物の無毒器具に乗り換えた場合の支出と健康メリットを比較。",
    savingsYearsLabel: "使用期間：10年間の日常自炊",
    savingsPansBought: "10年間で購入が必要な消耗テフロン鍋（寿命18ヶ月換算）：",
    savingsCostDisposable: "テフロン鍋の買い替え累計総費用：",
    savingsCostHeirloom: "一生物の安全な無毒性鍋の購入費用：",
    savingsTotalDollars: "10年間で節約できる総額（目安）：",
    savingsMicroplastics: "摂取を防げるマイクロプラスチック＆ナノプラスチック量：",
    copyPlanBtn: "📋 マイ健康キッチン乗り換え計画をコピー",
    copiedPlanNotice: "計画をクリップボードにコピーしました！",
    crossLinkTools: "その他の安全診断ツール：",
    crossLinkScorecard: "有害物質溶出＆PFASリスク計算機",
    crossLinkPanInspector: "AIフライパン傷診断機",
    crossLinkBrandIndex: "調理器具ブランド透明度インデックス",
    crossLinkEmergency: "キッチン緊急事態対処ツール",
    crossLinkRecalls: "バーコード＆製品リコールスキャナー"
  }
};

const d = DICT[lang] || DICT.en;
const prefix = lang === 'en' ? '' : `/${lang}`;
---

<div class="bg-surface-soft border border-hairline rounded-3xl p-6 md:p-10 shadow-sm max-w-5xl mx-auto" id="swap-calculator-app">
  <!-- Top Badge & Header -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8 pb-6 border-b border-hairline">
    <div>
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-700 text-white mb-2">
        {d.badge}
      </span>
      <h2 class="text-title-lg md:text-display-sm font-medium text-ink tracking-tight">
        {d.title}
      </h2>
      <p class="text-body text-xs md:text-sm mt-1 max-w-2xl leading-relaxed">
        {d.subtitle}
      </p>
    </div>
  </div>

  <!-- Transparent Affiliate Notice -->
  <div class="mb-8 p-4 rounded-2xl bg-canvas border border-emerald-600/30 text-xs text-body leading-relaxed flex items-start gap-3">
    <div class="text-emerald-700 text-base mt-0.5 font-bold">🛡️</div>
    <div class="flex-1">
      <strong class="text-ink font-semibold">{d.affiliateNotice.split(':')[0]}:</strong>
      {d.affiliateNotice.substring(d.affiliateNotice.indexOf(':') + 1)}
    </div>
  </div>

  <!-- Quick Scenario Presets -->
  <div class="mb-8">
    <span class="text-xs font-bold uppercase tracking-wider text-muted block mb-3">
      {d.presetsHeading}
    </span>
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
      <button type="button" class="preset-chip text-left p-2.5 rounded-xl border border-hairline bg-canvas hover:bg-surface-strong transition-all text-xs font-medium text-ink" data-src="ptfe-skillet" data-prio="delicate" data-budget="all" data-dw="any">
        {d.preset1}
      </button>
      <button type="button" class="preset-chip text-left p-2.5 rounded-xl border border-hairline bg-canvas hover:bg-surface-strong transition-all text-xs font-medium text-ink" data-src="bare-aluminum" data-prio="acidic" data-budget="all" data-dw="must">
        {d.preset2}
      </button>
      <button type="button" class="preset-chip text-left p-2.5 rounded-xl border border-hairline bg-canvas hover:bg-surface-strong transition-all text-xs font-medium text-ink" data-src="plastic-tupperware" data-prio="storage" data-budget="mid" data-dw="must">
        {d.preset3}
      </button>
      <button type="button" class="preset-chip text-left p-2.5 rounded-xl border border-hairline bg-canvas hover:bg-surface-strong transition-all text-xs font-medium text-ink" data-src="ptfe-skillet" data-prio="searing" data-budget="low" data-dw="any">
        {d.preset4}
      </button>
    </div>
  </div>

  <!-- Interactive Input Selector Matrix -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    <!-- Current Item to Replace -->
    <div class="p-4 rounded-2xl bg-canvas border border-hairline flex flex-col justify-between">
      <div>
        <label for="src-item-select" class="block text-xs font-bold uppercase tracking-wider text-muted mb-2">
          {d.selectCurrent}
        </label>
        <select id="src-item-select" class="w-full py-2 px-3 rounded-xl bg-surface-soft border border-hairline text-xs font-medium text-ink focus:outline-none focus:ring-2 focus:ring-emerald-600">
          {swapData.sourceItems.map(item => (
            <option value={item.id}>{item.name}</option>
          ))}
        </select>
      </div>
      <p id="src-item-risk-sub" class="text-[11px] text-rose-600 font-medium mt-3 leading-snug">
        Sheds up to 2.3M microplastic particles when scratched.
      </p>
    </div>

    <!-- Cooking Priority / Style -->
    <div class="p-4 rounded-2xl bg-canvas border border-hairline flex flex-col justify-between">
      <div>
        <label for="priority-select" class="block text-xs font-bold uppercase tracking-wider text-muted mb-2">
          {d.selectPriority}
        </label>
        <select id="priority-select" class="w-full py-2 px-3 rounded-xl bg-surface-soft border border-hairline text-xs font-medium text-ink focus:outline-none focus:ring-2 focus:ring-emerald-600">
          <option value="all">{d.priorityAll}</option>
          <option value="delicate">{d.priorityDelicate}</option>
          <option value="searing">{d.prioritySearing}</option>
          <option value="acidic">{d.priorityAcidic}</option>
          <option value="dishwasher">{d.priorityDishwasher}</option>
          <option value="storage">{d.priorityStorage}</option>
          <option value="chopping">{d.priorityChopping}</option>
        </select>
      </div>
      <p id="priority-sub" class="text-[11px] text-body mt-3 leading-snug">
        Balances non-toxic safety with heat dynamics.
      </p>
    </div>

    <!-- Budget Preference -->
    <div class="p-4 rounded-2xl bg-canvas border border-hairline flex flex-col justify-between">
      <div>
        <label for="budget-select" class="block text-xs font-bold uppercase tracking-wider text-muted mb-2">
          {d.selectBudget}
        </label>
        <select id="budget-select" class="w-full py-2 px-3 rounded-xl bg-surface-soft border border-hairline text-xs font-medium text-ink focus:outline-none focus:ring-2 focus:ring-emerald-600">
          <option value="all">{d.budgetAll}</option>
          <option value="low">{d.budgetLow}</option>
          <option value="mid">{d.budgetMid}</option>
          <option value="high">{d.budgetHigh}</option>
        </select>
      </div>
      <p class="text-[11px] text-body mt-3 leading-snug">
        From $19 Lodge cast iron to heirloom multi-clad steel.
      </p>
    </div>

    <!-- Dishwasher Safe Requirement -->
    <div class="p-4 rounded-2xl bg-canvas border border-hairline flex flex-col justify-between">
      <div>
        <label for="dw-select" class="block text-xs font-bold uppercase tracking-wider text-muted mb-2">
          {d.selectDishwasher}
        </label>
        <select id="dw-select" class="w-full py-2 px-3 rounded-xl bg-surface-soft border border-hairline text-xs font-medium text-ink focus:outline-none focus:ring-2 focus:ring-emerald-600">
          <option value="any">{d.dwAny}</option>
          <option value="must">{d.dwMust}</option>
        </select>
      </div>
      <p id="dw-sub" class="text-[11px] text-body mt-3 leading-snug">
        Filters materials requiring hand drying/seasoning.
      </p>
    </div>
  </div>

  <!-- Dynamic Output: Primary Recommended Material Card -->
  <div id="swap-result-card" class="mb-10 p-6 md:p-8 rounded-3xl bg-canvas border-2 border-emerald-600 shadow-md transition-all">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-6 border-b border-hairline">
      <div>
        <div class="flex items-center gap-2 mb-1.5">
          <span id="match-badge" class="px-2.5 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wider bg-emerald-700 text-white">
            Heirloom Non-Toxic Gold Standard
          </span>
          <span class="text-xs text-muted font-mono">{d.matchHeading}</span>
        </div>
        <h3 id="material-name" class="text-title-lg md:text-display-sm font-semibold text-ink tracking-tight">
          18/10 (304) or 316 Marine Stainless Steel
        </h3>
      </div>

      <!-- Quick Metrics Pill Group -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-center">
        <div class="p-2.5 rounded-xl bg-surface-soft border border-hairline">
          <span class="text-[10px] uppercase font-bold text-muted block">{d.safetyGradeLabel}</span>
          <span id="metric-grade" class="text-sm font-bold text-emerald-700">A+</span>
        </div>
        <div class="p-2.5 rounded-xl bg-surface-soft border border-hairline">
          <span class="text-[10px] uppercase font-bold text-muted block">{d.inertnessLabel}</span>
          <span id="metric-inert" class="text-sm font-bold text-ink">98/100</span>
        </div>
        <div class="p-2.5 rounded-xl bg-surface-soft border border-hairline">
          <span class="text-[10px] uppercase font-bold text-muted block">{d.durabilityLabel}</span>
          <span id="metric-durability" class="text-sm font-bold text-ink">50+ Yrs</span>
        </div>
        <div class="p-2.5 rounded-xl bg-surface-soft border border-hairline">
          <span class="text-[10px] uppercase font-bold text-muted block">{d.dishwasherLabel}</span>
          <span id="metric-dishwasher" class="text-sm font-bold text-emerald-700">100% Yes</span>
        </div>
      </div>
    </div>

    <!-- Comparison & Chemistry Section -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
      <!-- Why It Beats Current Item -->
      <div class="p-5 rounded-2xl bg-surface-soft border border-hairline space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-emerald-700 flex items-center gap-1.5">
          <span>✓</span> {d.whySwapHeading}
        </h4>
        <div class="space-y-2 text-xs">
          <div>
            <span class="font-semibold text-rose-600 block">{d.currentRisksLabel}</span>
            <ul id="current-risks-list" class="list-disc pl-4 space-y-1 text-body mt-1">
              <li>Sheds 9,100 to 2.3M microplastic particles per scratch.</li>
              <li>Degrades at >260°C (500°F) releasing toxic fluoropolymer pyrolysis fumes.</li>
            </ul>
          </div>
          <div class="pt-2 border-t border-hairline/60">
            <span class="font-semibold text-emerald-700 block">{d.toxinsEliminatedLabel}</span>
            <p id="toxins-eliminated-text" class="text-body font-mono text-[11px] mt-0.5">
              PTFE, PFOA/PFHxA traces, PFAS oligomers, fluorinated pyrolysis gas.
            </p>
          </div>
        </div>
      </div>

      <!-- Real-World Trade-Offs & Learning Curve -->
      <div class="p-5 rounded-2xl bg-surface-soft border border-hairline space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-amber-700 flex items-center gap-1.5">
          <span>⚖️</span> {d.tradeOffHeading}
        </h4>
        <p id="tradeoffs-text" class="text-xs text-body leading-relaxed">
          Requires learning the Leidenfrost water-drop preheating method to prevent delicate eggs and fish from sticking. Trace nickel leaching during first 2-3 acidic cooks (only relevant to severe nickel allergy sufferers).
        </p>
        <div class="pt-2 border-t border-hairline/60 flex items-center justify-between text-xs">
          <span class="text-muted font-medium">{d.learningCurveLabel}</span>
          <span id="learning-curve-text" class="font-semibold text-ink">Medium (Master 2-min preheat)</span>
        </div>
      </div>
    </div>

    <!-- Maintenance & Care Details -->
    <div class="p-4 rounded-xl bg-surface-soft/80 border border-hairline text-xs flex items-center justify-between gap-4">
      <div class="flex items-center gap-2">
        <span class="text-emerald-700 font-bold">🧼</span>
        <span class="font-medium text-ink">{d.maintenanceHeading}</span>
        <span id="maintenance-text" class="text-body">Dishwasher safe; Bar Keepers Friend restores mirror finish easily.</span>
      </div>
      <div class="hidden sm:flex items-center gap-2 text-muted font-mono text-[11px]">
        <span>{d.ovenSafeLabel}:</span>
        <span id="oven-safe-text" class="font-bold text-ink">600°F (315°C)</span>
      </div>
    </div>
  </div>

  <!-- Vetted Product Recommendations Grid -->
  <div class="mb-12">
    <div class="mb-6">
      <h3 class="text-title-lg font-medium text-ink tracking-tight">
        {d.productsHeading}
      </h3>
      <p class="text-body text-xs md:text-sm mt-0.5">
        {d.productsSub}
      </p>
    </div>

    <div id="products-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- Populated dynamically by script -->
    </div>
  </div>

  <!-- 10-Year Cost & Microplastic Savings Calculator -->
  <div class="mb-10 p-6 md:p-8 rounded-3xl bg-surface-strong border border-hairline">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-emerald-700 block mb-1">
          {d.savingsYearsLabel}
        </span>
        <h3 class="text-title-md md:text-title-lg font-semibold text-ink tracking-tight">
          {d.savingsHeading}
        </h3>
        <p class="text-xs text-body mt-1">
          {d.savingsSub}
        </p>
      </div>
      <div class="flex items-center gap-3">
        <button id="copy-plan-btn" type="button" class="py-2 px-4 rounded-xl bg-emerald-700 hover:bg-emerald-800 text-white font-medium text-xs transition-colors shadow-xs">
          {d.copyPlanBtn}
        </button>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-center">
      <div class="p-4 rounded-2xl bg-canvas border border-hairline">
        <span class="text-[11px] text-muted block mb-1">{d.savingsPansBought}</span>
        <span id="calc-pans-replaced" class="text-title-lg font-bold text-rose-600">6.7 Pans</span>
        <span class="text-[10px] text-muted block mt-1">@ $35.00 avg / pan</span>
      </div>
      <div class="p-4 rounded-2xl bg-canvas border border-hairline">
        <span class="text-[11px] text-muted block mb-1">{d.savingsCostDisposable}</span>
        <span id="calc-cost-disposable" class="text-title-lg font-bold text-rose-600">$234.50</span>
        <span class="text-[10px] text-muted block mt-1">Discarded to landfills</span>
      </div>
      <div class="p-4 rounded-2xl bg-canvas border border-hairline">
        <span class="text-[11px] text-muted block mb-1">{d.savingsCostHeirloom}</span>
        <span id="calc-cost-heirloom" class="text-title-lg font-bold text-emerald-700">$45.00</span>
        <span class="text-[10px] text-muted block mt-1">Single 50+ yr investment</span>
      </div>
      <div class="p-4 rounded-2xl bg-canvas border-2 border-emerald-600">
        <span class="text-[11px] text-muted block mb-1">{d.savingsTotalDollars}</span>
        <span id="calc-dollars-saved" class="text-title-lg font-bold text-emerald-700">+$189.50</span>
        <span id="calc-plastics-eliminated" class="text-[11px] font-bold text-emerald-700 block mt-1">15.4M Plastics Prevented</span>
      </div>
    </div>
  </div>

  <!-- Toast notification for copy -->
  <div id="copied-toast" class="hidden fixed bottom-6 right-6 z-50 bg-ink text-white px-5 py-3 rounded-2xl shadow-lg text-sm font-medium border border-hairline">
    ✓ {d.copiedPlanNotice}
  </div>

  <!-- Cross-link Footer with All Other 5 Tools -->
  <div class="pt-6 border-t border-hairline">
    <span class="text-xs font-bold uppercase tracking-wider text-muted block mb-3">
      {d.crossLinkTools}
    </span>
    <div class="flex flex-wrap gap-2 text-xs">
      <a href={`${prefix}/tools/toxic-leaching-scorecard/`} class="px-3 py-1.5 rounded-lg bg-canvas hover:bg-surface-strong border border-hairline text-ink transition-colors">
        🧪 {d.crossLinkScorecard} &rarr;
      </a>
      <a href={`${prefix}/tools/pan-scratch-inspector/`} class="px-3 py-1.5 rounded-lg bg-canvas hover:bg-surface-strong border border-hairline text-ink transition-colors">
        🔍 {d.crossLinkPanInspector} &rarr;
      </a>
      <a href={`${prefix}/tools/cookware-brand-transparency-index/`} class="px-3 py-1.5 rounded-lg bg-canvas hover:bg-surface-strong border border-hairline text-ink transition-colors">
        🛡️ {d.crossLinkBrandIndex} &rarr;
      </a>
      <a href={`${prefix}/tools/kitchen-hazard-emergency-triage/`} class="px-3 py-1.5 rounded-lg bg-canvas hover:bg-surface-strong border border-hairline text-ink transition-colors">
        🚨 {d.crossLinkEmergency} &rarr;
      </a>
      <a href={`${prefix}/tools/product-recalls-scanner/`} class="px-3 py-1.5 rounded-lg bg-canvas hover:bg-surface-strong border border-hairline text-ink transition-colors">
        📷 {d.crossLinkRecalls} &rarr;
      </a>
    </div>
  </div>
</div>

<script is:inline define:vars={{ swapData, d, lang }}>
  (function() {
    const srcSelect = document.getElementById('src-item-select');
    const prioSelect = document.getElementById('priority-select');
    const budgetSelect = document.getElementById('budget-select');
    const dwSelect = document.getElementById('dw-select');

    const srcRiskSub = document.getElementById('src-item-risk-sub');
    const matchBadge = document.getElementById('match-badge');
    const materialName = document.getElementById('material-name');
    const metricGrade = document.getElementById('metric-grade');
    const metricInert = document.getElementById('metric-inert');
    const metricDurability = document.getElementById('metric-durability');
    const metricDishwasher = document.getElementById('metric-dishwasher');

    const currentRisksList = document.getElementById('current-risks-list');
    const toxinsEliminatedText = document.getElementById('toxins-eliminated-text');
    const tradeoffsText = document.getElementById('tradeoffs-text');
    const learningCurveText = document.getElementById('learning-curve-text');
    const maintenanceText = document.getElementById('maintenance-text');
    const ovenSafeText = document.getElementById('oven-safe-text');

    const productsGrid = document.getElementById('products-grid');
    const copyPlanBtn = document.getElementById('copy-plan-btn');
    const copiedToast = document.getElementById('copied-toast');

    if (!srcSelect || !prioSelect || !budgetSelect || !dwSelect) return;

    function renderProducts(materialId, budgetFilter) {
      if (!productsGrid) return;

      let matchedProducts = swapData.products.filter(p => p.materialId === materialId);
      
      // If budget filter is strict and leaves 0 products, show all for that material
      if (budgetFilter !== 'all') {
        const budgetFiltered = matchedProducts.filter(p => {
          if (budgetFilter === 'low') return p.priceTier === '$';
          if (budgetFilter === 'mid') return p.priceTier === '$$';
          if (budgetFilter === 'high') return p.priceTier === '$$$';
          return true;
        });
        if (budgetFiltered.length > 0) {
          matchedProducts = budgetFiltered;
        }
      }

      // If still fewer than 2, pull top items from sibling safe materials
      if (matchedProducts.length === 0) {
        matchedProducts = swapData.products.slice(0, 3);
      }

      productsGrid.innerHTML = '';

      matchedProducts.forEach(prod => {
        const card = document.createElement('div');
        card.className = 'p-5 rounded-2xl bg-canvas border border-hairline flex flex-col justify-between shadow-xs hover:shadow-md transition-all';

        const prosHtml = prod.pros.map(pro => `<li class="text-[11px] text-body flex items-start gap-1"><span class="text-emerald-700">✓</span> <span>${pro}</span></li>`).join('');

        card.innerHTML = `
          <div>
            <div class="flex items-center justify-between gap-2 mb-2">
              <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-surface-strong text-ink border border-hairline">
                Tier ${prod.priceTier} • ${prod.priceRangeUsd}
              </span>
              <span class="text-[10px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200">
                Grade ${prod.safetyGrade}
              </span>
            </div>
            <h4 class="text-sm font-semibold text-ink tracking-tight mb-1">
              ${prod.brand} ${prod.model}
            </h4>
            <p class="text-[11px] text-emerald-700 font-medium mb-3">
              ${d.annualCostLabel} <span class="font-bold">${prod.lifetimeCostAnnual}</span>
            </p>
            <p class="text-xs text-body italic mb-3 pb-3 border-b border-hairline/60">
              "${prod.editorNote}"
            </p>
            <div class="space-y-1 mb-4">
              <span class="text-[10px] font-bold uppercase tracking-wider text-muted block mb-1">
                ${d.certificationsLabel}
              </span>
              <div class="flex flex-wrap gap-1">
                ${prod.certifications.map(c => `<span class="px-1.5 py-0.5 rounded bg-surface-soft text-[10px] text-ink font-mono">${c}</span>`).join('')}
              </div>
            </div>
            <ul class="space-y-1 mb-5">
              ${prosHtml}
            </ul>
          </div>
          <div>
            <a 
              target="_blank" 
              rel="noopener noreferrer sponsored"
              class="affiliate-buy-btn w-full py-2.5 px-4 rounded-xl bg-ink hover:bg-black text-white text-center font-medium text-xs transition-colors flex items-center justify-center gap-1.5 shadow-xs"
            >
              <span>${d.viewPriceBtn}</span>
              <span>&rarr;</span>
            </a>
          </div>
        `;
        const buyBtn = card.querySelector('.affiliate-buy-btn');
        if (buyBtn && prod.affiliateUrl) {
          buyBtn.setAttribute('href', prod.affiliateUrl);
        }
        productsGrid.appendChild(card);
      });
    }

    function calculateSwap() {
      const srcId = srcSelect.value;
      const prio = prioSelect.value;
      const budget = budgetSelect.value;
      const dw = dwSelect.value;

      const srcItem = swapData.sourceItems.find(s => s.id === srcId) || swapData.sourceItems[0];

      // Update current item risk text
      if (srcRiskSub) {
        srcRiskSub.textContent = srcItem.currentRisks[0];
      }

      // Determine Best Matching Safe Material
      let targetMaterialId = srcItem.recommendedSwaps[0];

      if (srcId === 'plastic-cutting-board') {
        targetMaterialId = 'end-grain-wood';
      } else if (srcId === 'plastic-tupperware') {
        if (prio === 'dishwasher' || dw === 'must') {
          targetMaterialId = 'borosilicate-glass';
        } else {
          targetMaterialId = 'borosilicate-glass';
        }
      } else if (prio === 'delicate') {
        targetMaterialId = 'sol-gel-ceramic';
      } else if (prio === 'searing') {
        if (dw === 'must') {
          targetMaterialId = 'tri-ply-stainless';
        } else {
          targetMaterialId = 'seasoned-cast-iron';
        }
      } else if (prio === 'acidic') {
        if (dw === 'must') {
          targetMaterialId = 'tri-ply-stainless';
        } else {
          targetMaterialId = 'enameled-cast-iron';
        }
      } else if (prio === 'dishwasher' || dw === 'must') {
        targetMaterialId = 'tri-ply-stainless';
      }

      // Fallback if dishwasher is required but selected material isn't dishwasher safe
      if (dw === 'must') {
        const testMat = swapData.materials.find(m => m.id === targetMaterialId);
        if (testMat && !testMat.dishwasherSafe) {
          if (srcId === 'plastic-cutting-board') {
            // wood is never dishwasher safe
            targetMaterialId = 'end-grain-wood';
          } else {
            targetMaterialId = 'tri-ply-stainless';
          }
        }
      }

      const mat = swapData.materials.find(m => m.id === targetMaterialId) || swapData.materials[0];

      // Populate DOM elements
      if (matchBadge) matchBadge.textContent = mat.badge;
      if (materialName) materialName.textContent = mat.name;
      if (metricGrade) metricGrade.textContent = mat.safetyGrade;
      if (metricInert) metricInert.textContent = mat.inertnessScore + '/100';
      if (metricDurability) metricDurability.textContent = mat.durabilityYears;
      if (metricDishwasher) {
        metricDishwasher.textContent = mat.dishwasherSafe ? '100% Yes' : 'Hand-Wash';
        metricDishwasher.className = mat.dishwasherSafe ? 'text-sm font-bold text-emerald-700' : 'text-sm font-bold text-amber-700';
      }

      if (currentRisksList) {
        currentRisksList.innerHTML = srcItem.currentRisks.map(r => `<li>${r}</li>`).join('');
      }

      if (toxinsEliminatedText) {
        toxinsEliminatedText.textContent = srcItem.primaryToxins;
      }

      if (tradeoffsText) {
        tradeoffsText.textContent = mat.tradeOffs;
      }

      if (learningCurveText) {
        learningCurveText.textContent = mat.learningCurve;
      }

      if (maintenanceText) {
        maintenanceText.textContent = mat.maintenance;
      }

      if (ovenSafeText) {
        ovenSafeText.textContent = mat.ovenSafeTempF > 0 ? `${mat.ovenSafeTempF}°F (${mat.ovenSafeTempC}°C)` : 'N/A';
      }

      // Render product cards
      renderProducts(mat.id, budget);
    }

    // Attach listeners
    srcSelect.addEventListener('change', calculateSwap);
    prioSelect.addEventListener('change', calculateSwap);
    budgetSelect.addEventListener('change', calculateSwap);
    dwSelect.addEventListener('change', calculateSwap);

    // Preset buttons
    document.querySelectorAll('.preset-chip').forEach(btn => {
      btn.addEventListener('click', function() {
        const s = this.getAttribute('data-src');
        const p = this.getAttribute('data-prio');
        const b = this.getAttribute('data-budget');
        const dw = this.getAttribute('data-dw');

        if (s) srcSelect.value = s;
        if (p) prioSelect.value = p;
        if (b) budgetSelect.value = b;
        if (dw) dwSelect.value = dw;

        calculateSwap();
      });
    });

    // Copy Action Plan
    if (copyPlanBtn && copiedToast) {
      copyPlanBtn.addEventListener('click', function() {
        const srcItem = swapData.sourceItems.find(s => s.id === srcSelect.value) || swapData.sourceItems[0];
        const mat = swapData.materials.find(m => m.name === materialName.textContent) || swapData.materials[0];

        const report = `=====================================================
ISITKITCHENSAFE NON-TOXIC KITCHENWARE ACTION PLAN
Source: isitkitchensafe.com/tools/material-swap-calculator/
Date: ${new Date().toISOString().split('T')[0]}
=====================================================

ITEM BEING RETIRED:
- ${srcItem.name}
- Hazards Eliminated: ${srcItem.primaryToxins}

RECOMMENDED NON-TOXIC REPLACEMENT:
- Material: ${mat.name} (${mat.badge})
- Safety Grade: ${mat.safetyGrade} (Chemical Inertness: ${mat.inertnessScore}/100)
- Durability: ${mat.durabilityYears}
- Dishwasher Safe: ${mat.dishwasherSafe ? 'Yes' : 'Hand-wash recommended'}
- Oven Ceiling: ${mat.ovenSafeTempF}°F (${mat.ovenSafeTempC}°C)

COOKING TECHNIQUE & CARE:
- ${mat.tradeOffs}
- Care: ${mat.maintenance}

10-YEAR SAVINGS PROJECTION:
- Disposable pans avoided: ~6-7 pans
- Dollars saved: ~$189.50
- Microplastics prevented: ~15,400,000 particles

Vetted Recommendations & Lab Audits:
isitkitchensafe.com/tools/material-swap-calculator/
=====================================================`;

        navigator.clipboard.writeText(report).then(() => {
          copiedToast.classList.remove('hidden');
          setTimeout(() => {
            copiedToast.classList.add('hidden');
          }, 3500);
        });
      });
    }

    // Initial calculation
    calculateSwap();
  })();
</script>
