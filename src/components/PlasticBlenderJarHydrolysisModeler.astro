    rule2Text: "洗碗机专用洗涤剂呈强碱性（pH 10–12），配合65°C热水会直接腐蚀塑料表面，形成数以万计肉眼可见的白雾微孔，使接触反应面积剧增300%以上。",
    rule3Title: "杯壁一旦出现“蜘蛛网”状微应力裂纹，必须立即强制报废",
    rule3Text: "蜘蛛网状微裂纹不仅会在碎冰碰撞中剥落大量微塑料和低聚物，而且在数万转高压涡流下杯壁极易突发物理爆裂，酿成烫伤事故。",
    rule4Title: "制作热汤、热豆浆或研磨坚果酱，务必选用高硼硅玻璃或不锈钢杯",
    rule4Text: "高硼硅无机硅酸盐玻璃与304/316不锈钢不含任何人工合成单体或增塑剂，对高温、强酸果酸与油脂拥有100%的化学耐受性与零溶出。",
    copyReportBtn: "复制破壁机塑料水解审计报告",
    copiedFeedback: "破壁机聚合物水解审计报告已成功复制至剪贴板！"
  },
  ja: {
    badge: "高分子化学＆食品接触材料動態シミュレーター",
    title: "ミキサー・ブレンダー容器微小亀裂ビスフェノールA加水分解モデラー",
    subtitle: "高速ブレンダー（破壁機）で熱湯スープや酸性スムージーを調理する際、ポリカーボネート（PC）やTritanボトルの微細亀裂とキャビテーション水力剪断により生じるビスフェノールA（BPA）およびオリゴマー溶出動態をモデル化します。",
    controlsTitle: "ブレンダー容器工学スペック＆流体力学作動パラメーター",
    controlsSub: "容器のポリマー素材、食品マトリックスの化学的性質、モーター回転速度、表面微小クラック劣化度、連続稼働時間を設定してください。",
    materialLabel: "ブレンダー容器ポリマー樹脂組成：",
    materialHelp: "BPA含有ポリカーボネート（PC・旧型/業務用） vs Eastman Tritan コポリエステル vs 脆性SAN樹脂 vs 完全不活性ホウケイ酸ガラス。",
    matrixLabel: "食品・飲料マトリックスの化学特性：",
    matrixHelp: "沸騰酸性トマトスープ（95°C、pH 3.6） vs クラッシュアイス入り柑橘・ベリー氷スムージー vs 温かい高脂肪ピーナッツバター vs 中性ミルクシェイク。",
    speedLabel: "モーター回転数＆キャビテーション水力剪断力：",
    speedHelp: "業務用ハイパワー（30,000 RPM、刃先速度 約82 m/s） vs 一般家庭用標準（16,000 RPM） vs 低速パルス乳化（8,000 RPM）。",
    degradationLabel: "容器表面の白濁＆マイクロクラック劣化度：",
    degradationHelp: "工場出荷新品（鏡面仕上げ） vs 食洗機強アルカリ白濁劣化 vs クモの巣状マイクロクラック（3年以上酷使）。",
    durationLabel: "連続ブレンド時間（秒）：",
    durationHelp: "高速回転する刃が液体に強力な剪断力を与え容器壁と接触する累積秒数。",
    presetsTitle: "実証ケーススタディ＆プリセット診断シナリオ：",
    presetBoilingSoupPc: "白濁PC製容器で沸騰トマトスープを撹拌（深刻な加水分解＆BPA溶出危機）",
    presetCitrusSmoothieTritan: "クラック入りTritan容器で毎朝フローズンスムージー調理（オリゴマー＆微細プラ）",
    presetGlassSoupSafe: "耐熱ホウケイ酸ガラス容器で熱々カボチャスープを撹拌（完全不活性基準）",
    presetNutButterFattyPc: "経年劣化したPC容器で温かいピーナッツバターを研磨（脂溶性成分溶出）",
    presetCommercialSmoothieBar: "高回転業務用ジュースバー（30,000 RPM + 白濁Tritanボトル）",
    diagnosticTitle: "ポリマー加水分解＆化学物質移行診断カード",
    diagnosticSub: "単回摂取BPA総量、欧州EFSA 2023年新基準TDI超過倍率、環状オリゴマー溶出、マイクロプラスチック脱落数のリアルタイム診断。",
    bpaLeachLabel: "食品中ビスフェノールA（BPA）溶出濃度",
    efsaTdiLabel: "欧州EFSA 2023耐容一日摂取量（TDI）超過倍率（体重70kg）",
    oligomerLabel: "環状オリゴマー・非BPAモノマー溶出総量",
    microplasticLabel: "微小プラスチック剥離粒子発生率",
    fissureAreaLabel: "微小クラック接触化学反応表面積倍率",
    safetyStatusLabel: "欧州EFSA・米国FDA食品接触安全適合判定",
    toxicologyMechanismLabel: "ポリマー鎖切断の生体物理学＆内分泌撹乱毒性機序",
    actionGuidanceLabel: "厨房ブレンダー食品安全＆工学的運用プロトコル",
    scienceTitle: "超高速キャビテーション剪断・熱加水分解・プラスチック白濁劣化の物理学",
    scienceSub: "なぜ経年劣化したプラスチック容器で熱湯スープを高速撹拌するとエステル結合が急激に解重合し、環境ホルモンが食品に注入されるのか。",
    tableTitle: "ブレンダー容器ポリマー特性＆耐加水分解性能比較マトリックス",
    tableSub: "各エンジニアリングプラスチックの熱水解速度、食洗機アルカリ耐性、クラック発生ストレス指数の詳細比較。",
    colPolymer: "容器素材",
    colCategory: "ポリマー分類",
    colCleavageRate: "加水分解速度",
    colAlkaliSensitivity: "食洗機アルカリ感受性",
    colCrackIndex: "マイクロクラック指数",
    colEstrogenic: "内分泌活性特性",
    rulesTitle: "ブレンダーの食品安全＆ポリマー保護鉄則",
    rulesSub: "内分泌撹乱物質の溶出を根絶し、超高速回転時の容器破裂事故を防ぐ科学的ガイドライン。",
    rule1Title: "ポリカーボネート容器で60°C以上の熱湯スープを撹拌しない",
    rule1Text: "炭酸エステル結合は高温で指数関数的に加水分解されます。熱湯スープを白濁したPC容器で撹拌すると、欧州EFSA安全許容量の最大500倍以上のBPAが溶出します。",
    rule2Title: "プラスチック容器は手洗い厳守（食洗機の熱風乾燥とアルカリを避ける）",
    rule2Text: "食洗機用強アルカリ洗剤（pH 10〜12）と65°Cの熱水はプラスチック表面を侵食し、表面積を3倍以上に拡大させる無数のマイクロクラックを生じさせます。",
    rule3Title: "「クモの巣状」微小クラックが発生した容器は即座に使用中止・交換する",
    rule3Text: "クモの巣状の亀裂は氷を砕く衝撃で大量の微細プラスチックとオリゴマーを剥離させるだけでなく、キャビテーションの衝撃波で容器が粉砕する危険があります。",
    rule4Title: "熱いスープや油脂分の多いペーストにはホウケイ酸ガラスまたはステンレスを選択",
    rule4Text: "ホウケイ酸ガラスおよび食品グレードステンレスは合成モノマーや可塑剤を含まず、強酸や高温油脂に対しても100%不活性で化学物質の移行が皆無です。",
    copyReportBtn: "ポリマー水解監査レポートをコピー",
    copiedFeedback: "ブレンダーポリマー水解監査レポートをクリップボードにコピーしました！"
  }
};

const d = DICTIONARY[lang] || DICTIONARY.en;
---

<div class="not-prose my-8 p-6 md:p-8 bg-surface border border-hairline rounded-3xl shadow-xs">
  <!-- Header Badge -->
  <div class="flex items-center justify-between gap-3 mb-6">
    <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-rose-500/10 text-rose-800 border border-rose-500/20">
      <span>🧪</span>
      {d.badge}
    </div>
    <span class="text-xs font-mono text-muted">EFSA 2023 TDI &bull; 0.2 ng/kg bw &bull; 21 CFR 177.1580</span>
  </div>

  <div class="mb-8">
    <h2 class="text-xl md:text-2xl font-bold text-ink tracking-tight mb-2">
      {d.title}
    </h2>
    <p class="text-xs md:text-sm text-muted leading-relaxed">
      {d.subtitle}
    </p>
  </div>

  <!-- Interactive Preset Scenarios -->
  <div class="mb-8 p-4 md:p-5 bg-surface-soft border border-hairline rounded-2xl">
    <div class="text-xs font-bold uppercase tracking-wider text-muted mb-3 flex items-center gap-1.5">
      <span>⚡</span>
      {d.presetsTitle}
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2">
      <button
        type="button"
        class="preset-btn px-3 py-2 text-left text-xs rounded-xl bg-surface hover:bg-rose-50/60 border border-hairline hover:border-rose-300 text-ink transition-all cursor-pointer font-medium"
        data-material="polycarbonate-bpa"
        data-matrix="boiling-acidic-soup"
        data-speed="commercial-vortex-30000rpm"
        data-degradation="dishwashed-cloudy-hazed"
        data-duration="120"
      >
        🍅 {d.presetBoilingSoupPc}
      </button>
      <button
        type="button"
        class="preset-btn px-3 py-2 text-left text-xs rounded-xl bg-surface hover:bg-rose-50/60 border border-hairline hover:border-rose-300 text-ink transition-all cursor-pointer font-medium"
        data-material="tritan-copolyester-tx1001"
        data-matrix="acidic-frozen-smoothie"
        data-speed="commercial-vortex-30000rpm"
        data-degradation="deeply-crazed-spiderweb"
        data-duration="90"
      >
        🫐 {d.presetCitrusSmoothieTritan}
      </button>
      <button
        type="button"
        class="preset-btn px-3 py-2 text-left text-xs rounded-xl bg-surface hover:bg-emerald-50/60 border border-hairline hover:border-emerald-300 text-ink transition-all cursor-pointer font-medium"
        data-material="borosilicate-glass"
        data-matrix="boiling-acidic-soup"
        data-speed="commercial-vortex-30000rpm"
        data-degradation="pristine-factory-new"
        data-duration="120"
      >
        🛡️ {d.presetGlassSoupSafe}
      </button>
      <button
        type="button"
        class="preset-btn px-3 py-2 text-left text-xs rounded-xl bg-surface hover:bg-amber-50/60 border border-hairline hover:border-amber-300 text-ink transition-all cursor-pointer font-medium"
        data-material="polycarbonate-bpa"
        data-matrix="hot-fatty-nutbutter"
        data-speed="standard-residential-16000rpm"
        data-degradation="deeply-crazed-spiderweb"
        data-duration="240"
      >
        🥜 {d.presetNutButterFattyPc}
      </button>
      <button
        type="button"
        class="preset-btn px-3 py-2 text-left text-xs rounded-xl bg-surface hover:bg-cyan-50/60 border border-hairline hover:border-cyan-300 text-ink transition-all cursor-pointer font-medium"
        data-material="tritan-copolyester-tx1001"
        data-matrix="acidic-frozen-smoothie"
        data-speed="commercial-vortex-30000rpm"
        data-degradation="dishwashed-cloudy-hazed"
        data-duration="60"
      >
        🥤 {d.presetCommercialSmoothieBar}
      </button>
    </div>
  </div>

  <!-- Main Grid: Engineering Controls & Real-Time Telemetry -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-10">
    <!-- Controls Column (5 cols) -->
    <div class="lg:col-span-5 space-y-5 bg-surface-soft/40 p-5 rounded-2xl border border-hairline">
      <div>
        <h3 class="text-sm font-bold text-ink uppercase tracking-wider mb-1 flex items-center gap-1.5">
          <span>⚙️</span>
          {d.controlsTitle}
        </h3>
        <p class="text-xs text-muted mb-4">{d.controlsSub}</p>
      </div>

      <!-- Control 1: Jar Polymer Material -->
      <div>
        <label for="material-select" class="block text-xs font-bold text-ink mb-1">
          {d.materialLabel}
        </label>
        <select id="material-select" class="w-full text-xs rounded-xl border border-hairline bg-surface p-2.5 font-medium text-ink focus:ring-2 focus:ring-rose-500/20 focus:border-rose-500 transition-all">
          {modelData.jarPolymerMaterials.map(m => (
            <option value={m.id} selected={m.id === 'polycarbonate-bpa'}>
              {m.name} ({m.category})
            </option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1 leading-normal">{d.materialHelp}</p>
      </div>

      <!-- Control 2: Food Matrix Chemistry -->
      <div>
        <label for="matrix-select" class="block text-xs font-bold text-ink mb-1">
          {d.matrixLabel}
        </label>
        <select id="matrix-select" class="w-full text-xs rounded-xl border border-hairline bg-surface p-2.5 font-medium text-ink focus:ring-2 focus:ring-rose-500/20 focus:border-rose-500 transition-all">
          {modelData.foodMatrixProfiles.map(fm => (
            <option value={fm.id} selected={fm.id === 'boiling-acidic-soup'}>
              {fm.name} ({fm.temperatureC}°C, pH {fm.ph})
            </option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1 leading-normal">{d.matrixHelp}</p>
      </div>

      <!-- Control 3: Motor RPM & Cavitation Velocity -->
      <div>
        <label for="speed-select" class="block text-xs font-bold text-ink mb-1">
          {d.speedLabel}
        </label>
        <select id="speed-select" class="w-full text-xs rounded-xl border border-hairline bg-surface p-2.5 font-medium text-ink focus:ring-2 focus:ring-rose-500/20 focus:border-rose-500 transition-all">
          {modelData.blenderSpeedMechanics.map(s => (
            <option value={s.id} selected={s.id === 'commercial-vortex-30000rpm'}>
              {s.name}
            </option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1 leading-normal">{d.speedHelp}</p>
      </div>

      <!-- Control 4: Jar Surface Degradation & Crazing -->
      <div>
        <label for="degradation-select" class="block text-xs font-bold text-ink mb-1">
          {d.degradationLabel}
        </label>
        <select id="degradation-select" class="w-full text-xs rounded-xl border border-hairline bg-surface p-2.5 font-medium text-ink focus:ring-2 focus:ring-rose-500/20 focus:border-rose-500 transition-all">
          {modelData.jarDegradationStates.map(deg => (
            <option value={deg.id} selected={deg.id === 'dishwashed-cloudy-hazed'}>
              {deg.name}
            </option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1 leading-normal">{d.degradationHelp}</p>
      </div>

      <!-- Control 5: Blending Duration Slider -->
      <div>
        <div class="flex items-center justify-between mb-1">
          <label for="duration-slider" class="text-xs font-bold text-ink">
            {d.durationLabel}
          </label>
          <span id="duration-val" class="text-xs font-mono font-bold text-rose-700 bg-rose-50 px-2 py-0.5 rounded border border-rose-200">
            120 seconds
          </span>
        </div>
        <input
          type="range"
          id="duration-slider"
          min="10"
          max="300"
          step="10"
          value="120"
          class="w-full accent-rose-600 cursor-pointer"
        />
        <div class="flex justify-between text-[10px] text-muted font-mono mt-1">
          <span>10s (Quick Pulse)</span>
          <span>60s (Smoothie)</span>
          <span>180s (Hot Soup Puree)</span>
          <span>300s (Nut Butter)</span>
        </div>
        <p class="text-[11px] text-muted mt-1 leading-normal">{d.durationHelp}</p>
      </div>
    </div>

    <!-- Telemetry Column (7 cols) -->
    <div class="lg:col-span-7 flex flex-col justify-between space-y-4">
      <div class="bg-surface border border-hairline rounded-2xl p-6 shadow-xs">
        <div class="flex items-center justify-between gap-3 mb-5 border-b border-hairline pb-4">
          <div>
            <h3 class="text-base font-bold text-ink flex items-center gap-2">
              <span>📊</span>
              {d.diagnosticTitle}
            </h3>
            <p class="text-xs text-muted">{d.diagnosticSub}</p>
          </div>
          <span id="status-badge" class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-rose-700 text-white shadow-xs">
            CRITICAL EFSA TDI EXCEEDANCE
          </span>
        </div>

        <!-- 4 Primary Metric Tiles -->
        <div class="grid grid-cols-2 gap-4 mb-6">
          <!-- Tile 1: BPA Concentration -->
          <div class="p-4 rounded-xl bg-rose-500/5 border border-rose-500/20">
            <div class="text-[11px] font-bold text-rose-950 uppercase tracking-wider mb-1">
              {d.bpaLeachLabel}
            </div>
            <div class="flex items-baseline gap-1.5">
              <span id="bpa-val" class="text-2xl md:text-3xl font-extrabold text-rose-800 font-mono">14.8</span>
              <span class="text-xs font-bold text-rose-900">µg/kg food</span>
            </div>
            <div class="text-[10px] text-rose-900 mt-1 font-mono">
              Single 500mL Serving: <strong id="bpa-dose-val">7.4 µg</strong>
            </div>
          </div>

          <!-- Tile 2: EFSA 2023 TDI Ratio -->
          <div class="p-4 rounded-xl bg-amber-500/5 border border-amber-500/20">
            <div class="text-[11px] font-bold text-amber-950 uppercase tracking-wider mb-1">
              {d.efsaTdiLabel}
            </div>
            <div class="flex items-baseline gap-1.5">
              <span id="efsa-ratio-val" class="text-2xl md:text-3xl font-extrabold text-amber-800 font-mono">528x</span>
              <span class="text-xs font-bold text-amber-900">above TDI</span>
            </div>
            <div class="text-[10px] text-amber-900 mt-1 font-mono">
              EFSA 2023 Limit: <strong>0.2 ng/kg bw/day</strong>
            </div>
          </div>

          <!-- Tile 3: Cyclic Oligomer Migration -->
          <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
            <div class="text-[11px] font-bold text-ink uppercase tracking-wider mb-1">
              {d.oligomerLabel}
            </div>
            <div class="flex items-baseline gap-1.5">
              <span id="oligomer-val" class="text-2xl md:text-3xl font-extrabold text-ink font-mono">22.4</span>
              <span class="text-xs text-muted">µg/L</span>
            </div>
            <div class="text-[10px] text-muted mt-1 font-mono">
              EU 10/2011 Non-Evaluated Limit: 50 µg/kg
            </div>
          </div>

          <!-- Tile 4: Microplastic Shedding -->
          <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
            <div class="text-[11px] font-bold text-ink uppercase tracking-wider mb-1">
              {d.microplasticLabel}
            </div>
            <div class="flex items-baseline gap-1.5">
              <span id="microplastic-val" class="text-2xl md:text-3xl font-extrabold text-ink font-mono">1.8e5</span>
              <span class="text-xs text-muted">particles/mL</span>
            </div>
            <div class="text-[10px] text-muted mt-1 font-mono">
              Nano &amp; Micro-debris from Cavitation Shear
            </div>
          </div>
        </div>

        <!-- Micro-Fissure Contact Area Gauge -->
        <div class="mb-6 p-4 rounded-xl bg-surface-soft/60 border border-hairline">
          <div class="flex items-center justify-between text-xs mb-2">
            <span class="font-bold text-ink">{d.fissureAreaLabel}:</span>
            <span id="area-val" class="font-mono font-bold text-rose-800">3.2x Effective Contact Expansion</span>
          </div>
          <div class="w-full bg-surface rounded-full h-3 border border-hairline overflow-hidden">
            <div id="area-bar" class="bg-rose-600 h-full rounded-full transition-all duration-300" style="width: 42%;"></div>
          </div>
          <div class="flex justify-between text-[10px] text-muted mt-1 font-mono">
            <span>1.0x (Pristine Molded Resin)</span>
            <span>3.2x (Dishwasher Hazed)</span>
            <span>7.5x (Deep Spiderweb Fissuring)</span>
          </div>
        </div>

        <!-- Toxicology Mechanism & Kitchen Protocol Narrative -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="bg-surface-soft border border-hairline rounded-xl p-4">
            <div class="text-xs font-bold text-ink uppercase tracking-wider mb-2 flex items-center gap-1.5">
              <span>🔬</span>
              {d.toxicologyMechanismLabel}
            </div>
            <p id="tox-text" class="text-xs text-muted leading-relaxed">
              At 95°C in an acidic tomato matrix, ester linkages of bisphenol-A polycarbonate undergo rapid hydrolytic depolymerization. Blade cavitation creates micro-bubble implosions that peel degraded surface layers, delivering acute endocrine-disrupting BPA doses.
            </p>
          </div>

          <div class="bg-surface-soft border border-hairline rounded-xl p-4">
            <div class="text-xs font-bold text-ink uppercase tracking-wider mb-2 flex items-center gap-1.5">
              <span>🛡️</span>
              {d.actionGuidanceLabel}
            </div>
            <p id="action-text" class="text-xs text-muted leading-relaxed">
              Cease blending boiling liquids in this container immediately. Allow hot soups to cool below 50°C before processing, or migrate to a borosilicate glass or NSF stainless steel blender jar.
            </p>
          </div>
        </div>

        <!-- Interactive Cross-Section SVG Diagram -->
        <div class="mt-6 p-4 rounded-xl bg-surface-soft border border-hairline">
          <div class="text-xs font-bold text-ink uppercase tracking-wider mb-3 flex items-center gap-1.5">
            <span>📐</span>
            Blender Cavitation Shear &amp; Polymer Wall Hydrolysis Model
          </div>
          <div class="w-full flex justify-center">
            <svg viewBox="0 0 600 240" class="w-full max-w-2xl h-auto" xmlns="http://www.w3.org/2000/svg">
              <!-- Jar Outer Outline -->
              <path d="M 120 20 L 170 190 L 430 190 L 480 20 Z" fill="#f8fafc" stroke="#94a3b8" stroke-width="3" stroke-linejoin="round"/>
              
              <!-- Fluid Body Gradient -->
              <defs>
                <linearGradient id="fluidGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop id="grad-fluid-start" offset="0%" stop-color="#f43f5e" stop-opacity="0.8" />
                  <stop id="grad-fluid-mid" offset="50%" stop-color="#fb7185" stop-opacity="0.6" />
                  <stop id="grad-fluid-end" offset="100%" stop-color="#fda4af" stop-opacity="0.4" />
                </linearGradient>
              </defs>
              <path id="svg-fluid-body" d="M 130 50 L 173 185 L 427 185 L 470 50 C 350 75 250 25 130 50 Z" fill="url(#fluidGrad)" />

              <!-- Central High-Velocity Vortex Funnel -->
              <path d="M 230 50 Q 300 140 300 170 Q 300 140 370 50 Z" fill="#ffffff" opacity="0.4" />
              <text x="300" y="70" font-size="10" text-anchor="middle" fill="#475569" font-weight="bold" font-family="sans-serif">
                Hydrodynamic Cavitation Vortex • <tspan id="svg-rpm-text">30,000 RPM</tspan>
              </text>

              <!-- Blade Assembly at Base -->
              <rect x="250" y="180" width="100" height="8" rx="3" fill="#334155" />
              <polygon points="260,180 240,165 270,178" fill="#64748b" />
              <polygon points="340,180 360,165 330,178" fill="#64748b" />
              <circle cx="300" cy="184" r="5" fill="#0f172a" />

              <!-- Cavitation Bubble Implosions -->
              <circle cx="230" cy="160" r="3" fill="#fff" stroke="#e11d48" stroke-width="1.5" />
              <circle cx="245" cy="150" r="2.5" fill="#fff" stroke="#e11d48" stroke-width="1" />
              <circle cx="365" cy="158" r="3.5" fill="#fff" stroke="#e11d48" stroke-width="1.5" />
              <circle cx="355" cy="148" r="2" fill="#fff" stroke="#e11d48" stroke-width="1" />
              <text x="210" y="145" font-size="9" fill="#be123c" font-weight="bold" font-family="sans-serif">Cavitation Micro-Jets (&gt;1000 bar)</text>

              <!-- Left Polymer Wall Crazing / Microcracks Layer -->
              <path id="svg-left-wall-fissure" d="M 125 35 L 132 45 L 126 58 L 135 70 L 128 85 L 138 100 L 131 120 L 142 140 L 137 165 L 150 185" fill="none" stroke="#e11d48" stroke-width="2.5" stroke-dasharray="4 2" />
              <text x="75" y="90" font-size="9" fill="#be123c" font-weight="bold" font-family="sans-serif">Alkali Etched</text>
              <text x="75" y="102" font-size="9" fill="#be123c" font-weight="bold" font-family="sans-serif">Micro-Fissures</text>
              <line x1="105" y1="95" x2="130" y2="95" stroke="#be123c" stroke-width="1" />

              <!-- Chemical Leaching Arrow from Wall into Fluid -->
              <defs>
                <marker id="arrow" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                  <path d="M 0 0 L 10 5 L 0 10 z" fill="#be123c"/>
                </marker>
              </defs>
              <line x1="145" y1="110" x2="190" y2="120" stroke="#be123c" stroke-width="2" marker-end="url(#arrow)" />
              <text x="180" y="138" font-size="9" fill="#9f1239" font-weight="bold" font-family="sans-serif">
                BPA / Oligomer Flux &rarr;
              </text>

              <!-- Temperature & Fluid Matrix Tag -->
              <rect x="360" y="95" width="130" height="38" rx="6" fill="#fff" stroke="#cbd5e1" stroke-width="1" />
              <text id="svg-temp-text" x="425" y="112" font-size="10" text-anchor="middle" fill="#0f172a" font-weight="bold" font-family="sans-serif">
                Soup: 95°C • pH 3.6
              </text>
              <text id="svg-polymer-tag" x="425" y="125" font-size="9" text-anchor="middle" fill="#64748b" font-family="sans-serif">
                Polycarbonate Resin
              </text>
            </svg>
          </div>
        </div>

        <!-- Copy Audit Report Button & Safety Compliance Footer -->
        <div class="mt-6 pt-4 border-t border-hairline flex flex-wrap items-center justify-between gap-3">
          <button type="button" id="copy-btn" class="px-4 py-2 text-xs font-bold rounded-xl bg-rose-700 hover:bg-rose-800 text-white transition-all shadow-xs cursor-pointer flex items-center gap-2">
            <span>📋</span>
            <span id="copy-text">{d.copyReportBtn}</span>
          </button>
          <span class="text-xs text-muted font-mono">{d.safetyStatusLabel}: <strong id="compliance-status" class="text-rose-700 font-bold">NON-COMPLIANT (528x EFSA TDI)</strong></span>
        </div>
      </div>
    </div>
  </div>

  <!-- Comparative Scientific Table -->
  <div class="mb-10">
    <div class="mb-4">
      <h3 class="text-base md:text-lg font-bold text-ink flex items-center gap-2">
        <span>📊</span>
        {d.tableTitle}
      </h3>
      <p class="text-xs text-muted">{d.tableSub}</p>
    </div>
    <div class="overflow-x-auto border border-hairline rounded-2xl bg-surface">
      <table class="w-full text-left border-collapse text-xs">
        <thead>
          <tr class="bg-surface-soft border-b border-hairline text-ink font-bold">
            <th class="p-3.5">{d.colPolymer}</th>
            <th class="p-3.5">{d.colCategory}</th>
            <th class="p-3.5">{d.colCleavageRate}</th>
            <th class="p-3.5">{d.colAlkaliSensitivity}</th>
            <th class="p-3.5">{d.colCrackIndex}</th>
            <th class="p-3.5">{d.colEstrogenic}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline">
          {modelData.jarPolymerMaterials.map(m => (
            <tr class="hover:bg-surface-soft/40 transition-colors">
              <td class="p-3.5 font-bold text-ink">
                {m.name}
                <div class="text-[10px] text-muted font-normal mt-0.5">Monomers: {m.monomers.join(', ')}</div>
              </td>
              <td class="p-3.5 font-mono">{m.category}</td>
              <td class="p-3.5 font-mono font-bold text-rose-700">{m.hydrolyticCleavageRateMultiplier}x</td>
              <td class="p-3.5 font-mono">{m.dishwasherAlkaliSensitivity * 100}%</td>
              <td class="p-3.5 font-mono">{m.microcrackStressIndex * 100}%</td>
              <td class="p-3.5 font-semibold text-ink">{m.estrogenicPotency}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Evidence-Based Golden Rules -->
  <div class="p-6 md:p-8 bg-surface-soft/60 border border-hairline rounded-2xl">
    <div class="mb-6">
      <h3 class="text-base md:text-lg font-bold text-ink flex items-center gap-2">
        <span>🛡️</span>
        {d.rulesTitle}
      </h3>
      <p class="text-xs text-muted">{d.rulesSub}</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="bg-surface border border-hairline rounded-xl p-4">
        <h4 class="text-xs font-bold text-rose-950 uppercase tracking-wider mb-1 flex items-center gap-1">
          <span>1.</span> {d.rule1Title}
        </h4>
        <p class="text-xs text-muted leading-relaxed">{d.rule1Text}</p>
      </div>
      <div class="bg-surface border border-hairline rounded-xl p-4">
        <h4 class="text-xs font-bold text-rose-950 uppercase tracking-wider mb-1 flex items-center gap-1">
          <span>2.</span> {d.rule2Title}
        </h4>
        <p class="text-xs text-muted leading-relaxed">{d.rule2Text}</p>
      </div>
      <div class="bg-surface border border-hairline rounded-xl p-4">
        <h4 class="text-xs font-bold text-rose-950 uppercase tracking-wider mb-1 flex items-center gap-1">
          <span>3.</span> {d.rule3Title}
        </h4>
        <p class="text-xs text-muted leading-relaxed">{d.rule3Text}</p>
      </div>
      <div class="bg-surface border border-hairline rounded-xl p-4">
        <h4 class="text-xs font-bold text-rose-950 uppercase tracking-wider mb-1 flex items-center gap-1">
          <span>4.</span> {d.rule4Title}
        </h4>
        <p class="text-xs text-muted leading-relaxed">{d.rule4Text}</p>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ modelData, dict: d }}>
  // Interactive client-side simulation logic for blender jar hydrolysis
  const materialSelect = document.getElementById('material-select');
  const matrixSelect = document.getElementById('matrix-select');
  const speedSelect = document.getElementById('speed-select');
  const degradationSelect = document.getElementById('degradation-select');
  const durationSlider = document.getElementById('duration-slider');
  const durationVal = document.getElementById('duration-val');

  const bpaVal = document.getElementById('bpa-val');
  const bpaDoseVal = document.getElementById('bpa-dose-val');
  const efsaRatioVal = document.getElementById('efsa-ratio-val');
  const oligomerVal = document.getElementById('oligomer-val');
  const microplasticVal = document.getElementById('microplastic-val');
  const areaVal = document.getElementById('area-val');
  const areaBar = document.getElementById('area-bar');
  const statusBadge = document.getElementById('status-badge');
  const complianceStatus = document.getElementById('compliance-status');
  const toxText = document.getElementById('tox-text');
  const actionText = document.getElementById('action-text');
  const copyBtn = document.getElementById('copy-btn');
  const copyText = document.getElementById('copy-text');

  // SVG elements
  const svgRpmText = document.getElementById('svg-rpm-text');
  const svgTempText = document.getElementById('svg-temp-text');
  const svgPolymerTag = document.getElementById('svg-polymer-tag');
  const svgLeftWallFissure = document.getElementById('svg-left-wall-fissure');

  function calculateSimulation() {
    const matId = materialSelect.value;
    const matrixId = matrixSelect.value;
    const speedId = speedSelect.value;
    const degId = degradationSelect.value;
    const durationSec = parseFloat(durationSlider.value);

    durationVal.textContent = `${durationSec.toFixed(0)} seconds`;

    const mat = modelData.jarPolymerMaterials.find(m => m.id === matId) || modelData.jarPolymerMaterials[0];
    const matrix = modelData.foodMatrixProfiles.find(fm => fm.id === matrixId) || modelData.foodMatrixProfiles[0];
    const speed = modelData.blenderSpeedMechanics.find(s => s.id === speedId) || modelData.blenderSpeedMechanics[0];
    const deg = modelData.jarDegradationStates.find(d => d.id === degId) || modelData.jarDegradationStates[0];

    // Effective Temperature under frictional shear
    const temperatureRise = (durationSec / 60) * speed.frictionalShearHeatingCPerMin;
    const effectiveTempC = matrix.temperatureC + temperatureRise;

    // Arrhenius temperature dependence for ester hydrolysis (doubles every 10°C above 40°C)
    const tempFactor = effectiveTempC > 40
      ? Math.pow(2.0, (effectiveTempC - 40) / 10.0)
      : 0.5;

    // Contact area multiplier from crazing micro-fissures
    const effectiveArea = deg.effectiveSurfaceAreaMultiplier;
    areaVal.textContent = `${effectiveArea.toFixed(1)}x Effective Contact Expansion`;
    const areaPct = Math.min(100, (effectiveArea / 7.5) * 100);
    areaBar.style.width = `${areaPct}%`;

    // Cavitation and acid acceleration factor
    const mechanicalFactor = speed.cavitationIntensityFactor;
    const acidFactor = matrix.hydrolysisAccelerationFactor;
    const fatFactor = matrix.lipophilicExtractionFactor;

    // 1. Bisphenol-A (BPA) Leaching Calculation
    let bpaConcentrationUgPerKg = 0.0;
    if (mat.id === 'polycarbonate-bpa') {
      // Baseline migration rate in µg/kg
      const baseMigration = 0.45;
      bpaConcentrationUgPerKg = baseMigration * tempFactor * acidFactor * mechanicalFactor * effectiveArea * (durationSec / 60) * fatFactor;
      bpaConcentrationUgPerKg = Math.round(bpaConcentrationUgPerKg * 10) / 10;
    } else {
      bpaConcentrationUgPerKg = 0.0;
    }

    // Serving ingestion dose (500mL serving = 0.5 kg)
    const servingDoseUg = (bpaConcentrationUgPerKg * 0.5);
    const servingDoseNg = servingDoseUg * 1000;

    // EFSA 2023 TDI is 0.2 ng/kg bw/day (for 70kg adult = 14 ng/day)
    const adultTdiNg = 70 * modelData.regulatoryThresholds.efsa2023BpaTdiNgPerKgBw;
    const efsaRatio = servingDoseNg > 0 ? (servingDoseNg / adultTdiNg) : 0;

    // 2. Cyclic Oligomer & Co-monomer Migration (Tritan & SAN)
    let oligomerUgPerL = 0.0;
    if (mat.id === 'tritan-copolyester-tx1001') {
      const baseOligomer = 1.8;
      oligomerUgPerL = Math.round(baseOligomer * tempFactor * (effectiveArea * 0.7) * (durationSec / 60) * fatFactor * 10) / 10;
    } else if (mat.id === 'san-resin') {
      const baseStyrene = 3.5;
      oligomerUgPerL = Math.round(baseStyrene * tempFactor * effectiveArea * (durationSec / 60) * fatFactor * 10) / 10;
    } else if (mat.id === 'polycarbonate-bpa') {
      oligomerUgPerL = Math.round((bpaConcentrationUgPerKg * 0.6) * 10) / 10;
    } else {
      oligomerUgPerL = 0.0; // Borosilicate glass
    }

    // 3. Microplastic Particle Shedding
    let microplasticParticlesPerMl = 0;
    if (mat.id !== 'borosilicate-glass') {
      const baseParticles = deg.microcrackDensityPerCm2 * 45;
      const shearShed = baseParticles * (speed.rpm / 10000) * (durationSec / 60);
      microplasticParticlesPerMl = Math.round(shearShed);
    } else {
      microplasticParticlesPerMl = 0;
    }

    // Update DOM Metrics
    bpaVal.textContent = bpaConcentrationUgPerKg.toFixed(1);
    bpaDoseVal.textContent = `${servingDoseUg.toFixed(1)} µg (${servingDoseNg.toFixed(0)} ng)`;
    efsaRatioVal.textContent = efsaRatio > 0 ? `${efsaRatio.toFixed(0)}x` : '0x';
    oligomerVal.textContent = oligomerUgPerL.toFixed(1);

    if (microplasticParticlesPerMl > 1000) {
      microplasticVal.textContent = microplasticParticlesPerMl.toExponential(1);
    } else {
      microplasticVal.textContent = microplasticParticlesPerMl.toString();
    }

    // SVG Updates
    svgRpmText.textContent = `${(speed.rpm).toLocaleString()} RPM`;
    svgTempText.textContent = `${matrix.name.split(' ')[0]}: ${effectiveTempC.toFixed(0)}°C • pH ${matrix.ph}`;
    svgPolymerTag.textContent = mat.name.split('(')[0].trim();

    if (deg.id === 'pristine-factory-new' || mat.id === 'borosilicate-glass') {
      svgLeftWallFissure.setAttribute('stroke', '#10b981');
      svgLeftWallFissure.setAttribute('stroke-dasharray', 'none');
    } else if (deg.id === 'dishwashed-cloudy-hazed') {
      svgLeftWallFissure.setAttribute('stroke', '#f59e0b');
      svgLeftWallFissure.setAttribute('stroke-dasharray', '4 2');
    } else {
      svgLeftWallFissure.setAttribute('stroke', '#e11d48');
      svgLeftWallFissure.setAttribute('stroke-dasharray', '2 1');
    }

    // Status Badge & Narrative Evaluation
    if (mat.id === 'borosilicate-glass') {
      statusBadge.textContent = '100% CHEMICALLY INERT (ZERO MIGRATION)';
      statusBadge.className = 'px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-700 text-white shadow-xs';
      complianceStatus.textContent = 'COMPLIANT (Zero Synthetic Monomers)';
      complianceStatus.className = 'text-emerald-700 font-bold';
      toxText.textContent = 'Tempered borosilicate glass is an inorganic mineral silicate (SiO2/B2O3). It contains zero carbon polymer chains, plasticizers, or bisphenols. It exhibits zero chemical reactivity with hot acids, ethanol, or lipids.';
      actionText.textContent = 'Optimal laboratory and culinary configuration. Borosilicate glass maintains 100% barrier integrity across boiling liquids, ice impacts, and dishwashing cycles indefinitely.';
    } else if (mat.id === 'polycarbonate-bpa' && efsaRatio > 1.0) {
      statusBadge.textContent = `CRITICAL EFSA EXCEEDANCE (${efsaRatio.toFixed(0)}x TDI)`;
      statusBadge.className = 'px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-rose-700 text-white shadow-xs';
      complianceStatus.textContent = `NON-COMPLIANT (${efsaRatio.toFixed(0)}x EFSA 2023 TDI Limit)`;
      complianceStatus.className = 'text-rose-700 font-bold';
      toxText.textContent = `At ${effectiveTempC.toFixed(0)}°C, carbonate ester linkages undergo exponential hydrolytic cleavage. The combination of acidic media and high-speed hydrodynamic cavitation drives free BPA migration (${bpaConcentrationUgPerKg.toFixed(1)} µg/kg), exceeding the revised European EFSA tolerable daily intake by ${efsaRatio.toFixed(0)}-fold.`;
      actionText.textContent = 'Do NOT blend hot liquids (>60°C) in this polycarbonate jar. Cool soups before blending or replace the jar immediately with a modern Tritan, stainless steel, or glass vessel.';
    } else if (mat.id === 'tritan-copolyester-tx1001' && deg.id === 'deeply-crazed-spiderweb') {
      statusBadge.textContent = 'BPA-FREE • ELEVATED OLIGOMER & MICROPLASTIC RISK';
      statusBadge.className = 'px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-600 text-white shadow-xs';
      complianceStatus.textContent = 'QUALIFIED PASS (Oligomer Warning)';
      complianceStatus.className = 'text-amber-700 font-bold';
      toxText.textContent = `While free of bisphenols, Eastman Tritan copolyester with severe spiderweb crazing sheds microscopic cyclic oligomers (${oligomerUgPerL.toFixed(1)} µg/L) and microplastic debris under cavitation shear. Microcracks weaken structural integrity under thermal shock.`;
      actionText.textContent = 'Retire this crazed jar to avoid potential mechanical failure during ice crushing. Wash replacement jars strictly by hand with mild detergent to prevent alkaline crazing.';
    } else {
      statusBadge.textContent = 'ACCEPTABLE RECREATIONAL USE';
      statusBadge.className = 'px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-600 text-white shadow-xs';
      complianceStatus.textContent = 'COMPLIANT WITH APPLICABLE LIMITS';
      complianceStatus.className = 'text-emerald-700 font-bold';
      toxText.textContent = 'Operating conditions produce low hydrolytic drive. Chemical migration remains below toxicological concern thresholds under standard residential exposure durations.';
      actionText.textContent = 'Continue standard hand-washing maintenance. Avoid heating liquids inside the jar and inspect annually for micro-fissuring.';
    }
  }

  // Preset Buttons Listener
  document.querySelectorAll('.preset-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      materialSelect.value = btn.dataset.material;
      matrixSelect.value = btn.dataset.matrix;
      speedSelect.value = btn.dataset.speed;
      degradationSelect.value = btn.dataset.degradation;
      durationSlider.value = btn.dataset.duration;
      calculateSimulation();
    });
  });

  // Input Listeners
  [materialSelect, matrixSelect, speedSelect, degradationSelect, durationSlider].forEach(el => {
    el.addEventListener('change', calculateSimulation);
    el.addEventListener('input', calculateSimulation);
  });

  // Copy Report Action
  copyBtn.addEventListener('click', () => {
    const report = `======================================================================
ISITKITCHENSAFE BLENDER POLYMER HYDROLYSIS & BPA AUDIT REPORT
======================================================================
Jar Material:       ${materialSelect.options[materialSelect.selectedIndex].text}
Food Matrix:        ${matrixSelect.options[matrixSelect.selectedIndex].text}
Motor Velocity:     ${speedSelect.options[speedSelect.selectedIndex].text}
Jar Condition:      ${degradationSelect.options[degradationSelect.selectedIndex].text}
Blend Duration:     ${durationSlider.value} seconds
----------------------------------------------------------------------
BPA Leaching Rate:  ${bpaVal.textContent} µg/kg food
Single Serving Dose: ${bpaDoseVal.textContent}
EFSA 2023 TDI:      ${efsaRatioVal.textContent}
Cyclic Oligomers:   ${oligomerVal.textContent} µg/L
Microplastics:      ${microplasticVal.textContent} particles/mL
Fissure Area Mult:  ${areaVal.textContent}
Compliance Status:  ${complianceStatus.textContent}
----------------------------------------------------------------------
Toxicology:
${toxText.textContent}

Action Guidance:
${actionText.textContent}
======================================================================`;

    navigator.clipboard.writeText(report).then(() => {
      const orig = copyText.textContent;
      copyText.textContent = dict.copiedFeedback;
      setTimeout(() => {
        copyText.textContent = orig;
      }, 3000);
    });
  });

  // Initial calculation
  calculateSimulation();
</script>
