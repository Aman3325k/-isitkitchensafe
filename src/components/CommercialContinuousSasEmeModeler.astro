<!-- Reactive Client-Side Simulation Script -->
<script is:inline define:vars={{ formulations }}>
  (function initSasEmeSimulator() {
    function setup() {
      const container = document.querySelector('.sas-eme-container');
      if (!container) return;

      const formulationSelect = document.getElementById('sas-formulation');
      const formulationDesc = document.getElementById('sas-formulation-desc');
      const pressureSlider = document.getElementById('sas-pressure');
      const pressureVal = document.getElementById('sas-pressure-val');
      const tempSlider = document.getElementById('sas-temp');
      const tempVal = document.getElementById('sas-temp-val');
      const voltageSlider = document.getElementById('sas-voltage');
      const voltageVal = document.getElementById('sas-voltage-val');
      const ratioSlider = document.getElementById('sas-ratio');
      const ratioVal = document.getElementById('sas-ratio-val');
      const flowSlider = document.getElementById('sas-flow');
      const flowVal = document.getElementById('sas-flow-val');

      // Telemetry elements
      const teleTaylor = document.getElementById('telemetry-taylor');
      const teleSupersat = document.getElementById('telemetry-supersat');
      const teleDiameter = document.getElementById('telemetry-diameter');
      const telePdi = document.getElementById('telemetry-pdi');
      const teleStripping = document.getElementById('telemetry-stripping');
      const teleBioavailability = document.getElementById('telemetry-bioavailability');
      const teleSolvent = document.getElementById('telemetry-solvent');
      const teleIntegrity = document.getElementById('telemetry-integrity');
      const teleSec = document.getElementById('telemetry-sec');
      const teleVerdict = document.getElementById('telemetry-verdict');

      // Presets
      const presetBtns = container.querySelectorAll('.preset-btn');
      presetBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const preset = btn.getAttribute('data-preset');
          if (preset === 'curcumin') {
            formulationSelect.value = 'curcumin_eudragit_nanocrystals';
            pressureSlider.value = 125;
            tempSlider.value = 38.0;
            voltageSlider.value = 28.5;
            ratioSlider.value = 35;
            flowSlider.value = 4.5;
          } else if (preset === 'resveratrol') {
            formulationSelect.value = 'trans_resveratrol_hpmc_nanocrystals';
            pressureSlider.value = 115;
            tempSlider.value = 36.5;
            voltageSlider.value = 32.0;
            ratioSlider.value = 42;
            flowSlider.value = 3.8;
          } else if (preset === 'quercetin') {
            formulationSelect.value = 'quercetin_pvp_nanoparticles';
            pressureSlider.value = 135;
            tempSlider.value = 39.0;
            voltageSlider.value = 35.0;
            ratioSlider.value = 48;
            flowSlider.value = 3.2;
          } else if (preset === 'cbd') {
            formulationSelect.value = 'cannabidiol_zein_encapsulates';
            pressureSlider.value = 140;
            tempSlider.value = 37.5;
            voltageSlider.value = 26.0;
            ratioSlider.value = 38;
            flowSlider.value = 5.0;
          } else if (preset === 'hazard') {
            pressureSlider.value = 82; // Near critical transition, weak antisolvent effect
            tempSlider.value = 46.5;   // Excessive temperature risking degradation
            voltageSlider.value = 14.0; // Inadequate voltage, unstable droplet drip
            ratioSlider.value = 16;     // Poor antisolvent dilution
            flowSlider.value = 11.0;    // Excessive injection causing agglomeration
          }
          updateSimulation();
        });
      });

      function updateSimulation() {
        const selectedId = formulationSelect.value;
        const currentForm = formulations.find(f => f.id === selectedId) || formulations[0];
        formulationDesc.textContent = currentForm.payloadDescription;

        const pressure = parseFloat(pressureSlider.value);
        const temp = parseFloat(tempSlider.value);
        const voltage = parseFloat(voltageSlider.value);
        const ratio = parseFloat(ratioSlider.value);
        const flow = parseFloat(flowSlider.value);

        // Update Slider value displays
        pressureVal.textContent = pressure.toFixed(1) + ' bar';
        tempVal.textContent = temp.toFixed(1) + ' °C';
        voltageVal.textContent = voltage.toFixed(1) + ' kV';
        ratioVal.textContent = ratio.toFixed(1);
        flowVal.textContent = flow.toFixed(1) + ' mL/min';

        // 1. Taylor Cone Stability Ratio (E / E_crit)
        // E_crit is approx 27.5 kV for typical ethanol-polymer solutions
        const eCrit = 27.5;
        const taylorRatio = voltage / eCrit;

        // 2. Antisolvent Supersaturation Ratio S
        // S scales with pressure (CO2 density) and mass ratio R, inversely with temperature
        const pFactor = (pressure / 120.0);
        const rFactor = (ratio / 35.0);
        const tPenalty = (temp - 35.0) * 0.015;
        let supersat = 140.0 * pFactor * rFactor * (1 - tPenalty);
        if (pressure < 90) supersat *= 0.35; // Subcritical phase collapse
        supersat = Math.max(12.0, Math.min(280.0, supersat));

        // 3. Mean Particle Diameter (d_50 in nm)
        // d_50 scales inversely with S and voltage (smaller Taylor cone droplets), directly with flow
        const flowRatio = flow / 4.5;
        let d50 = currentForm.meanParticleDiameterNm * Math.pow(flowRatio, 0.28) / (Math.pow(taylorRatio, 0.45) * Math.pow(supersat / 140.0, 0.22));
        if (pressure < 90) d50 *= 4.5; // Coarse macro-precipitation
        if (voltage < 16.0) d50 *= 2.8; // Dripping regime agglomeration
        d50 = Math.max(70.0, Math.min(850.0, d50));

        // 4. Polydispersity Index (PDI)
        let pdi = currentForm.polydispersityIndexPdi + Math.abs(taylorRatio - 1.05) * 0.025;
        if (ratio < 22) pdi += 0.045;
        if (pressure < 90) pdi += 0.12;
        pdi = Math.max(0.028, Math.min(0.48, pdi));

        // 5. Solvent Stripping Duration (tau_evap in ms)
        // Droplet diameter scales with d50, tau scales with d^2 / D
        let strippingMs = (d50 / 145.0) * (d50 / 145.0) * 12.4 * (35.0 / ratio) / (pFactor);
        strippingMs = Math.max(4.5, Math.min(85.0, strippingMs));

        // 6. Bioavailability & 15-Min In-Vitro Dissolution Rate
        // Noyes-Whitney: rate proportional to 1 / d50
        let bioavail = currentForm.dissolutionBioavailabilityPct;
        if (d50 > 250) bioavail -= ((d50 - 250) / 30.0) * 4.5;
        if (supersat < 80) bioavail -= (80 - supersat) * 0.25;
        bioavail = Math.max(22.0, Math.min(99.6, bioavail));

        // 7. Residual Organic Solvent (ppm)
        let residualPpm = currentForm.residualEthanolPpm * (35.0 / ratio) * (120.0 / pressure);
        if (strippingMs > 25.0) residualPpm += (strippingMs - 25.0) * 0.12;
        if (pressure < 90) residualPpm = 250.0;
        residualPpm = Math.max(0.3, Math.min(480.0, residualPpm));

        // 8. Chemical Integrity (thermal / oxidative loss)
        let integrity = 100.0;
        if (temp > 42.0) integrity -= (temp - 42.0) * 3.5;
        integrity = Math.max(65.0, Math.min(100.0, integrity));

        // 9. Specific Energy Consumption (SEC in kWh/kg)
        const sec = (0.32 + (pressure / 160.0) * 0.10 + (ratio / 65.0) * 0.06).toFixed(2);

        // Update Live Telemetry Display
        teleTaylor.textContent = taylorRatio.toFixed(2) + ' E/E_crit';
        teleSupersat.textContent = 'S = ' + supersat.toFixed(1);
        teleDiameter.textContent = d50.toFixed(0) + ' nm';
        telePdi.textContent = pdi.toFixed(3);
        teleStripping.textContent = strippingMs.toFixed(1) + ' ms';
        teleBioavailability.textContent = bioavail.toFixed(1) + '%';
        teleSolvent.textContent = residualPpm < 1.0 ? residualPpm.toFixed(1) + ' ppm' : residualPpm.toFixed(0) + ' ppm';
        teleIntegrity.textContent = integrity.toFixed(1) + '% Intact';
        teleSec.textContent = sec + ' kWh/kg product';

        // Styling and Verdict
        const isOptimal = (taylorRatio >= 0.90 && taylorRatio <= 1.25 && pressure >= 95 && supersat >= 100 && d50 <= 250 && bioavail >= 95.0 && residualPpm <= 5.0 && integrity >= 98.0);
        if (isOptimal) {
          teleVerdict.className = 'text-sm font-bold font-mono text-emerald-400';
          teleVerdict.textContent = '✅ STABLE TAYLOR CONE • USP <467> & <711> PHARMACOPEIAL PASS';
          teleDiameter.className = 'text-2xl font-bold font-mono text-emerald-400';
          teleTaylor.className = 'text-2xl font-bold font-mono text-emerald-400';
        } else if (pressure < 90 || voltage < 16.0) {
          teleVerdict.className = 'text-sm font-bold font-mono text-rose-400';
          teleVerdict.textContent = '🚨 TAYLOR CONE COLLAPSE / SUBCRITICAL CO2 PHASE FAILURE';
          teleDiameter.className = 'text-2xl font-bold font-mono text-rose-400';
          teleTaylor.className = 'text-2xl font-bold font-mono text-rose-400';
        } else {
          teleVerdict.className = 'text-sm font-bold font-mono text-amber-400';
          teleVerdict.textContent = '⚠️ SUB-OPTIMAL SUPERCRITICAL PRECIPITATION • PARTICLE GROWTH DETECTED';
          teleDiameter.className = 'text-2xl font-bold font-mono text-amber-400';
          teleTaylor.className = 'text-2xl font-bold font-mono text-amber-400';
        }

        renderDissolutionChart(bioavail);
      }

      function renderDissolutionChart(bioavailRate) {
        const canvas = document.getElementById('sas-dissolution-chart');
        if (!canvas) return;
        const ctx = canvas.getContext('2d');
        if (!ctx) return;

        // Retina canvas resolution handling
        const dpr = window.devicePixelRatio || 1;
        const rect = canvas.getBoundingClientRect();
        canvas.width = rect.width * dpr;
        canvas.height = rect.height * dpr;
        ctx.scale(dpr, dpr);

        const w = rect.width;
        const h = rect.height;
        const padX = 45;
        const padY = 25;
        const graphW = w - padX - 25;
        const graphH = h - padY - 35;

        ctx.clearRect(0, 0, w, h);

        // Draw Axes & Grid
        ctx.strokeStyle = '#334155';
        ctx.lineWidth = 1;

        // Horizontal Grid lines (0%, 25%, 50%, 75%, 100%)
        ctx.fillStyle = '#64748b';
        ctx.font = '10px monospace';
        ctx.textAlign = 'right';

        for (let pct = 0; pct <= 100; pct += 25) {
          const y = padY + graphH - (pct / 100) * graphH;
          ctx.beginPath();
          ctx.moveTo(padX, y);
          ctx.lineTo(padX + graphW, y);
          ctx.stroke();
          ctx.fillText(pct + '%', padX - 8, y + 3);
        }

        // Vertical Time Markers (0, 15, 30, 45, 60 min)
        ctx.textAlign = 'center';
        const times = [0, 15, 30, 45, 60];
        times.forEach(t => {
          const x = padX + (t / 60) * graphW;
          ctx.beginPath();
          ctx.moveTo(x, padY);
          ctx.lineTo(x, padY + graphH);
          ctx.stroke();
          ctx.fillText(t + 'm', x, padY + graphH + 18);
        });

        // 1. Native Crystalline Bulk Curve (Rose)
        // Slow dissolution: ~1.2% at 15m, ~4.5% at 60m
        ctx.strokeStyle = '#f43f5e';
        ctx.lineWidth = 2.5;
        ctx.beginPath();
        for (let t = 0; t <= 60; t += 2) {
          const val = Math.min(5.5, 0.08 * t + 0.001 * t * t);
          const x = padX + (t / 60) * graphW;
          const y = padY + graphH - (val / 100) * graphH;
          if (t === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        }
        ctx.stroke();

        // 2. Jet-Milled Microparticles Curve (Cyan)
        // Moderate dissolution: ~16.5% at 15m, ~35% at 60m
        ctx.strokeStyle = '#06b6d4';
        ctx.lineWidth = 2.5;
        ctx.beginPath();
        for (let t = 0; t <= 60; t += 2) {
          const val = Math.min(42.0, 1.25 * t - 0.01 * t * t);
          const x = padX + (t / 60) * graphW;
          const y = padY + graphH - (val / 100) * graphH;
          if (t === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        }
        ctx.stroke();

        // 3. SAS-EME Sub-Micron Nanospheres Curve (Emerald)
        // Explosive dissolution: reaches bioavailRate at 15m, asymptotic to 100%
        ctx.strokeStyle = '#10b981';
        ctx.lineWidth = 3.5;
        ctx.beginPath();
        for (let t = 0; t <= 60; t += 2) {
          // Asymptotic curve: 1 - exp(-k * t)
          const k = -Math.log(1 - (bioavailRate / 100) * 0.99) / 15.0;
          const val = Math.min(100.0, (1 - Math.exp(-k * t)) * 100.0);
          const x = padX + (t / 60) * graphW;
          const y = padY + graphH - (val / 100) * graphH;
          if (t === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        }
        ctx.stroke();

        // 15-Minute Benchmark Indicator Dot
        const k15 = -Math.log(1 - (bioavailRate / 100) * 0.99) / 15.0;
        const val15 = Math.min(100.0, (1 - Math.exp(-k15 * 15)) * 100.0);
        const dotX = padX + (15 / 60) * graphW;
        const dotY = padY + graphH - (val15 / 100) * graphH;

        ctx.fillStyle = '#34d399';
        ctx.beginPath();
        ctx.arc(dotX, dotY, 5, 0, Math.PI * 2);
        ctx.fill();
        ctx.strokeStyle = '#ffffff';
        ctx.lineWidth = 1.5;
        ctx.stroke();
      }

      // Event Listeners
      formulationSelect.addEventListener('change', updateSimulation);
      pressureSlider.addEventListener('input', updateSimulation);
      tempSlider.addEventListener('input', updateSimulation);
      voltageSlider.addEventListener('input', updateSimulation);
      ratioSlider.addEventListener('input', updateSimulation);
      flowSlider.addEventListener('input', updateSimulation);

      // Initial simulation render
      updateSimulation();
      window.addEventListener('resize', () => {
        updateSimulation();
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setup);
    } else {
      setup();
    }
  })();
</script>
