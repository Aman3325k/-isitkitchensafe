    pdiLabel: "多分散度指数 (PDI)：",
    strippingTimeLabel: "溶媒抽出時間 (τ_evap)：",
    bioavailabilityLabel: "15分間インビトロ溶出率：",
    residualSolventLabel: "残留有機溶媒濃度 (ppm)：",
    integrityLabel: "生体活性分子化学的完全性：",
    secLabel: "比エネルギー消費量 (SEC)：",
    verdictLabel: "沈殿判定および USP 薬局方規格適合：",
    diagramTitle: "高圧同軸静電エミッターおよび超臨界貧溶媒チャンバー",
    diagramSub: "高圧超臨界CO2内での同軸テイラーコーン静電微粒化、インラインサイクロン分離、および閉ループCO2回収。",
    chartTitle: "インビトロ溶出キネティクスと生体吸収性比較 (USP <711>)",
    chartSub: "60分間の溶出比較：SAS-EME ナノカプセル、ジェット粉砕微粒子、および粗結晶原末。",
    principlesTitle: "電気流体力学および超臨界貧溶媒相平衡原理",
    principlesSub: "支配方程式：テイラーコーン静電応力平衡、二元相互拡散、過飽和核生成、および Noyes-Whitney 溶出速度論。",
    compTitle: "産業用微粉化およびカプセル化技術ベンチマーク比較",
    compSub: "SAS-EME、高温スプレードライ、ロータリーエバポレーター結晶化、およびジェットミルの直接比較。",
    regTitle: "国際規制適合性およびサニタリーエンジニアリング基準",
    regSub: "FDA 21 CFR § 117、USP <467> 残留溶媒規格、USP <711> 溶出規格、3-Aサニタリー 63-04/08-17、EHEDG Type EL Class I、ASME Section VIII Div 1 適合。"
  }
};

const d = DICT[lang] || DICT.en;
const formulations = sasEmeData.bioactivePayloadFormulations;
const comparisonData = sasEmeData.industrialTechnologyComparison;
---

<div class="sas-eme-container space-y-12 max-w-7xl mx-auto" data-lang={lang}>
  <!-- Top Hero Header Badge & Quick Stats Banner -->
  <div class="bg-surface-soft border border-hairline rounded-3xl p-6 sm:p-8 lg:p-10 shadow-xs relative overflow-hidden">
    <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-950 text-emerald-400 border border-emerald-800/80 shadow-xs">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        {d.badge}
      </div>
      <div class="flex items-center gap-2 text-xs font-mono text-muted">
        <span>FDA 21 CFR § 117 cGMP</span>
        <span>&bull;</span>
        <span>USP &lt;467&gt; Solvents</span>
        <span>&bull;</span>
        <span class="text-emerald-400 font-semibold">USP &lt;711&gt; Bioavailability</span>
      </div>
    </div>

    <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-ink tracking-tight mb-4">
      {d.title}
    </h2>
    <p class="text-body text-sm sm:text-base leading-relaxed max-w-4xl">
      {d.subtitle}
    </p>

    <!-- Key Performance Indicator Pill Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 mt-8 pt-6 border-t border-hairline/60">
      <div class="bg-surface p-3.5 sm:p-4 rounded-2xl border border-hairline">
        <div class="text-xs text-muted mb-1 font-medium">Particle Monodispersity</div>
        <div class="text-xl sm:text-2xl font-bold font-mono text-emerald-400">PDI &lt; 0.045</div>
        <div class="text-[11px] text-muted mt-0.5">80–250 nm Sub-Micron</div>
      </div>
      <div class="bg-surface p-3.5 sm:p-4 rounded-2xl border border-hairline">
        <div class="text-xs text-muted mb-1 font-medium">15-Min Dissolution Rate</div>
        <div class="text-xl sm:text-2xl font-bold font-mono text-emerald-400">&gt; 99.1%</div>
        <div class="text-[11px] text-muted mt-0.5">&gt;120× Velocity vs Bulk</div>
      </div>
      <div class="bg-surface p-3.5 sm:p-4 rounded-2xl border border-hairline">
        <div class="text-xs text-muted mb-1 font-medium">Residual Solvent Level</div>
        <div class="text-xl sm:text-2xl font-bold font-mono text-emerald-400">&lt; 1.0 ppm</div>
        <div class="text-[11px] text-muted mt-0.5">USP &lt;467&gt; Limit 5000 ppm</div>
      </div>
      <div class="bg-surface p-3.5 sm:p-4 rounded-2xl border border-hairline">
        <div class="text-xs text-muted mb-1 font-medium">Chemical Degradation</div>
        <div class="text-xl sm:text-2xl font-bold font-mono text-emerald-400">0.0% Intact</div>
        <div class="text-[11px] text-muted mt-0.5">Isothermal 35–40°C Process</div>
      </div>
    </div>
  </div>

  <!-- Interactive Controls & Simulator Matrix -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Controls Column (5 cols) -->
    <div class="lg:col-span-5 bg-surface-soft border border-hairline rounded-3xl p-6 sm:p-7 shadow-xs space-y-6">
      <div class="border-b border-hairline/80 pb-4">
        <h3 class="text-lg sm:text-xl font-bold text-ink mb-1">{d.controlsTitle}</h3>
        <p class="text-xs text-muted leading-relaxed">{d.controlsSub}</p>
      </div>

      <!-- Presets Selector -->
      <div>
        <label class="block text-xs font-semibold uppercase tracking-wider text-muted mb-2">
          {d.presetsTitle}
        </label>
        <div class="grid grid-cols-2 gap-2 text-xs">
          <button type="button" class="preset-btn px-3 py-2 rounded-xl bg-surface border border-hairline hover:border-emerald-500/60 text-left font-medium text-ink transition-all active:scale-[0.98]" data-preset="curcumin">
            ⚡ {d.presetCurcumin}
          </button>
          <button type="button" class="preset-btn px-3 py-2 rounded-xl bg-surface border border-hairline hover:border-emerald-500/60 text-left font-medium text-ink transition-all active:scale-[0.98]" data-preset="resveratrol">
            🍇 {d.presetResveratrol}
          </button>
          <button type="button" class="preset-btn px-3 py-2 rounded-xl bg-surface border border-hairline hover:border-emerald-500/60 text-left font-medium text-ink transition-all active:scale-[0.98]" data-preset="quercetin">
            🌿 {d.presetQuercetin}
          </button>
          <button type="button" class="preset-btn px-3 py-2 rounded-xl bg-surface border border-hairline hover:border-emerald-500/60 text-left font-medium text-ink transition-all active:scale-[0.98]" data-preset="cbd">
            🌾 {d.presetCbd}
          </button>
        </div>
        <button type="button" class="preset-btn w-full mt-2 px-3 py-2 rounded-xl bg-rose-950/40 border border-rose-900/60 hover:border-rose-500/60 text-left font-medium text-rose-300 text-xs transition-all active:scale-[0.98]" data-preset="hazard">
          ⚠️ {d.presetHazard}
        </button>
      </div>

      <!-- Bioactive Formulation Selector -->
      <div>
        <div class="flex items-center justify-between mb-1.5">
          <label for="sas-formulation" class="text-xs font-semibold uppercase tracking-wider text-muted">
            {d.payloadLabel}
          </label>
        </div>
        <select id="sas-formulation" class="w-full bg-surface border border-hairline rounded-xl px-3.5 py-2.5 text-sm text-ink font-medium focus:outline-hidden focus:border-emerald-500 transition-colors">
          {formulations.map(f => (
            <option value={f.id}>{f.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1 leading-normal" id="sas-formulation-desc">
          {formulations[0].payloadDescription}
        </p>
      </div>

      <!-- Pressure Slider -->
      <div>
        <div class="flex items-center justify-between mb-1">
          <label for="sas-pressure" class="text-xs font-semibold uppercase tracking-wider text-muted">
            {d.pressureLabel}
          </label>
          <span class="font-mono text-sm font-bold text-emerald-400" id="sas-pressure-val">125.0 bar</span>
        </div>
        <input 
          type="range" 
          id="sas-pressure" 
          min="80" 
          max="160" 
          step="1" 
          value="125" 
          class="w-full h-2 bg-surface rounded-lg appearance-none cursor-pointer accent-emerald-500"
        />
        <p class="text-[11px] text-muted mt-1">{d.pressureHelp}</p>
      </div>

      <!-- Temperature Slider -->
      <div>
        <div class="flex items-center justify-between mb-1">
          <label for="sas-temp" class="text-xs font-semibold uppercase tracking-wider text-muted">
            {d.tempLabel}
          </label>
          <span class="font-mono text-sm font-bold text-emerald-400" id="sas-temp-val">38.0 °C</span>
        </div>
        <input 
          type="range" 
          id="sas-temp" 
          min="32" 
          max="48" 
          step="0.5" 
          value="38" 
          class="w-full h-2 bg-surface rounded-lg appearance-none cursor-pointer accent-emerald-500"
        />
        <p class="text-[11px] text-muted mt-1">{d.tempHelp}</p>
      </div>

      <!-- Electrostatic Voltage Slider -->
      <div>
        <div class="flex items-center justify-between mb-1">
          <label for="sas-voltage" class="text-xs font-semibold uppercase tracking-wider text-muted">
            {d.voltageLabel}
          </label>
          <span class="font-mono text-sm font-bold text-emerald-400" id="sas-voltage-val">28.5 kV</span>
        </div>
        <input 
          type="range" 
          id="sas-voltage" 
          min="12.0" 
          max="45.0" 
          step="0.5" 
          value="28.5" 
          class="w-full h-2 bg-surface rounded-lg appearance-none cursor-pointer accent-emerald-500"
        />
        <p class="text-[11px] text-muted mt-1">{d.voltageHelp}</p>
      </div>

      <!-- Antisolvent Mass Ratio R Slider -->
      <div>
        <div class="flex items-center justify-between mb-1">
          <label for="sas-ratio" class="text-xs font-semibold uppercase tracking-wider text-muted">
            {d.ratioLabel}
          </label>
          <span class="font-mono text-sm font-bold text-emerald-400" id="sas-ratio-val">35.0</span>
        </div>
        <input 
          type="range" 
          id="sas-ratio" 
          min="15" 
          max="65" 
          step="1" 
          value="35" 
          class="w-full h-2 bg-surface rounded-lg appearance-none cursor-pointer accent-emerald-500"
        />
        <p class="text-[11px] text-muted mt-1">{d.ratioHelp}</p>
      </div>

      <!-- Injection Solution Flow Rate Slider -->
      <div>
        <div class="flex items-center justify-between mb-1">
          <label for="sas-flow" class="text-xs font-semibold uppercase tracking-wider text-muted">
            {d.flowLabel}
          </label>
          <span class="font-mono text-sm font-bold text-emerald-400" id="sas-flow-val">4.5 mL/min</span>
        </div>
        <input 
          type="range" 
          id="sas-flow" 
          min="1.0" 
          max="12.0" 
          step="0.2" 
          value="4.5" 
          class="w-full h-2 bg-surface rounded-lg appearance-none cursor-pointer accent-emerald-500"
        />
        <p class="text-[11px] text-muted mt-1">{d.flowHelp}</p>
      </div>
    </div>

    <!-- Live Telemetry & Visualizer Column (7 cols) -->
    <div class="lg:col-span-7 space-y-6">
      <!-- Live Telemetry Card -->
      <div class="bg-surface-soft border border-hairline rounded-3xl p-6 sm:p-7 shadow-xs space-y-6">
        <div class="border-b border-hairline/80 pb-4">
          <h3 class="text-lg sm:text-xl font-bold text-ink mb-1">{d.telemetryTitle}</h3>
          <p class="text-xs text-muted leading-relaxed">{d.telemetrySub}</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Taylor Cone Stability -->
          <div class="bg-surface p-4 rounded-2xl border border-hairline">
            <div class="text-xs text-muted font-medium mb-1">{d.taylorConeLabel}</div>
            <div class="text-2xl font-bold font-mono text-emerald-400" id="telemetry-taylor">1.04 E/E_crit</div>
            <div class="text-[11px] text-muted mt-1">Stable harmonic Taylor cone mode</div>
          </div>

          <!-- Supersaturation Ratio -->
          <div class="bg-surface p-4 rounded-2xl border border-hairline">
            <div class="text-xs text-muted font-medium mb-1">{d.supersatLabel}</div>
            <div class="text-2xl font-bold font-mono text-cyan-400" id="telemetry-supersat">S = 142.5</div>
            <div class="text-[11px] text-muted mt-1">Explosive sub-micron nucleation</div>
          </div>

          <!-- Particle Diameter -->
          <div class="bg-surface p-4 rounded-2xl border border-hairline">
            <div class="text-xs text-muted font-medium mb-1">{d.particleDiameterLabel}</div>
            <div class="text-2xl font-bold font-mono text-amber-400" id="telemetry-diameter">145 nm</div>
            <div class="text-[11px] text-muted mt-1">Sub-micron monodisperse nanospheres</div>
          </div>

          <!-- PDI -->
          <div class="bg-surface p-4 rounded-2xl border border-hairline">
            <div class="text-xs text-muted font-medium mb-1">{d.pdiLabel}</div>
            <div class="text-2xl font-bold font-mono text-emerald-400" id="telemetry-pdi">0.038</div>
            <div class="text-[11px] text-muted mt-1">Narrow monodisperse size distribution</div>
          </div>

          <!-- Solvent Stripping Time -->
          <div class="bg-surface p-4 rounded-2xl border border-hairline">
            <div class="text-xs text-muted font-medium mb-1">{d.strippingTimeLabel}</div>
            <div class="text-2xl font-bold font-mono text-cyan-400" id="telemetry-stripping">12.4 ms</div>
            <div class="text-[11px] text-muted mt-1">Microsecond phase inversion</div>
          </div>

          <!-- 15-Min In-Vitro Dissolution -->
          <div class="bg-surface p-4 rounded-2xl border border-hairline">
            <div class="text-xs text-muted font-medium mb-1">{d.bioavailabilityLabel}</div>
            <div class="text-2xl font-bold font-mono text-emerald-400" id="telemetry-bioavailability">99.1%</div>
            <div class="text-[11px] text-muted mt-1">&gt;120× velocity vs unmicronized bulk</div>
          </div>

          <!-- Residual Solvent -->
          <div class="bg-surface p-4 rounded-2xl border border-hairline">
            <div class="text-xs text-muted font-medium mb-1">{d.residualSolventLabel}</div>
            <div class="text-2xl font-bold font-mono text-emerald-400" id="telemetry-solvent">0.8 ppm</div>
            <div class="text-[11px] text-muted mt-1">USP &lt;467&gt; compliant (&lt;5000 ppm limit)</div>
          </div>

          <!-- Bioactive Integrity -->
          <div class="bg-surface p-4 rounded-2xl border border-hairline">
            <div class="text-xs text-muted font-medium mb-1">{d.integrityLabel}</div>
            <div class="text-2xl font-bold font-mono text-emerald-400" id="telemetry-integrity">100.0% Intact</div>
            <div class="text-[11px] text-muted mt-1">0.0% Thermal or oxidative loss</div>
          </div>
        </div>

        <!-- System Energy & Verdict Box -->
        <div class="p-4 rounded-2xl bg-surface border border-hairline flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
          <div>
            <div class="text-xs text-muted font-medium">{d.secLabel}</div>
            <div class="text-lg font-bold font-mono text-ink" id="telemetry-sec">0.38 kWh/kg product</div>
          </div>
          <div class="text-left sm:text-right">
            <div class="text-xs text-muted font-medium">{d.verdictLabel}</div>
            <div class="text-sm font-bold font-mono text-emerald-400" id="telemetry-verdict">
              ✅ STABLE TAYLOR CONE • USP &lt;467&gt; &amp; &lt;711&gt; PHARMACOPEIAL PASS
            </div>
          </div>
        </div>
      </div>

      <!-- Coaxial Electrostatic Emitter & Antisolvent Autoclave Schematic (SVG) -->
      <div class="bg-surface-soft border border-hairline rounded-3xl p-6 sm:p-7 shadow-xs space-y-4">
        <div>
          <h4 class="text-base font-bold text-ink mb-1">{d.diagramTitle}</h4>
          <p class="text-xs text-muted">{d.diagramSub}</p>
        </div>

        <div class="bg-surface rounded-2xl p-4 border border-hairline overflow-hidden flex items-center justify-center">
          <svg viewBox="0 0 720 280" class="w-full h-auto max-h-[300px] text-ink select-none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="scCo2AntisolventGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#0284c7" stop-opacity="0.3" />
                <stop offset="50%" stop-color="#06b6d4" stop-opacity="0.8" />
                <stop offset="100%" stop-color="#10b981" stop-opacity="0.9" />
              </linearGradient>
              <linearGradient id="taylorConeJetGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#38bdf8" stop-opacity="1" />
                <stop offset="100%" stop-color="#f59e0b" stop-opacity="1" />
              </linearGradient>
              <pattern id="sasGridPattern" width="20" height="20" patternUnits="userSpaceOnUse">
                <path d="M 20 0 L 0 0 0 20" fill="none" stroke="currentColor" stroke-opacity="0.05" stroke-width="1" />
              </pattern>
            </defs>

            <!-- Background Grid -->
            <rect width="720" height="280" fill="url(#sasGridPattern)" />

            <!-- Vessel Outer Shell (ASME B31.3 High-Pressure Autoclave) -->
            <rect x="210" y="25" width="470" height="230" rx="20" fill="#0f172a" stroke="#334155" stroke-width="2" />
            <text x="445" y="48" fill="#94a3b8" font-size="11" font-weight="bold" text-anchor="middle" letter-spacing="1">
              ASME SECTION VIII DIV 1 scCO₂ ANTISOLVENT PRECIPITATION AUTOCLAVE (90–160 BAR)
            </text>

            <!-- High-Pressure scCO2 Antisolvent Inlet Port -->
            <rect x="240" y="8" width="60" height="20" rx="4" fill="#0284c7" stroke="#38bdf8" stroke-width="1.5" />
            <text x="270" y="21" fill="#ffffff" font-size="9" font-weight="bold" text-anchor="middle">scCO₂ IN</text>
            <path d="M 270 28 L 270 65" stroke="#38bdf8" stroke-width="2.5" stroke-dasharray="4 3" />

            <!-- High-Voltage Coaxial Emitter Assembly -->
            <!-- Outer Ground Shield -->
            <rect x="30" y="105" width="160" height="70" rx="6" fill="#1e293b" stroke="#64748b" stroke-width="2" />
            <text x="110" y="125" fill="#94a3b8" font-size="10" font-weight="bold" text-anchor="middle">HV Ground Shield</text>

            <!-- Inner High-Voltage Capillary (15–45 kV) -->
            <line x1="20" y1="140" x2="225" y2="140" stroke="#f59e0b" stroke-width="4" />
            <text x="110" y="155" fill="#f59e0b" font-size="10" font-weight="bold" text-anchor="middle">+15 – 45 kV Coaxial Needle</text>

            <!-- High-Voltage Power Supply Line -->
            <path d="M 70 80 L 70 138" stroke="#ef4444" stroke-width="2" stroke-dasharray="3 2" />
            <text x="70" y="75" fill="#ef4444" font-size="9" font-weight="bold" text-anchor="middle">HV Generator (45 kV)</text>

            <!-- Taylor Cone Formation at Nozzle Tip -->
            <polygon points="225,130 225,150 245,140" fill="#38bdf8" stroke="#0284c7" stroke-width="1.5" />
            <text x="245" y="115" fill="#38bdf8" font-size="9" font-weight="bold" text-anchor="middle">Taylor Cone (49.3°)</text>

            <!-- Micro-Jet and Rayleigh Breakup into Sub-Micron Aerosol -->
            <line x1="245" y1="140" x2="275" y2="140" stroke="#38bdf8" stroke-width="2" />

            <!-- Atomized Sub-Micron Liquid Droplets (d < 1.5 µm) -->
            <circle cx="285" cy="138" r="3.5" fill="#38bdf8" />
            <circle cx="295" cy="143" r="3" fill="#38bdf8" />
            <circle cx="305" cy="137" r="3" fill="#38bdf8" />
            <text x="295" y="165" fill="#38bdf8" font-size="9" text-anchor="middle">Coulombic Jet</text>

            <!-- Ultra-Fast Supercritical Mass Transfer Zone (CO2 dissolution & solvent stripping) -->
            <path d="M 330 90 L 330 190" stroke="#06b6d4" stroke-width="1.5" stroke-dasharray="2 3" />
            <text x="350" y="105" fill="#06b6d4" font-size="9" text-anchor="middle">Mutual Mass Transfer</text>
            <text x="350" y="120" fill="#06b6d4" font-size="9" text-anchor="middle">τ_evap &lt; 15 ms</text>

            <!-- Nucleation and Crystalline Nanospheres (d = 80–250 nm) -->
            <g fill="#10b981">
              <circle cx="410" cy="135" r="4" />
              <circle cx="425" cy="145" r="3.5" />
              <circle cx="440" cy="132" r="3.8" />
              <circle cx="455" cy="144" r="4.2" />
              <circle cx="470" cy="136" r="3.6" />
              <circle cx="485" cy="142" r="4" />
            </g>
            <text x="450" y="170" fill="#10b981" font-size="10" font-weight="bold" text-anchor="middle">
              Monodisperse Crystalline Nanospheres (PDI &lt; 0.045)
            </text>

            <!-- High-Pressure Cyclone Separator & Nanoparticle Collection Chamber -->
            <polygon points="560,95 620,95 600,185 580,185" fill="#1e293b" stroke="#10b981" stroke-width="2" />
            <text x="590" y="135" fill="#10b981" font-size="9" font-weight="bold" text-anchor="middle">Cyclone</text>

            <!-- Dry Nanopowder Discharge Port -->
            <rect x="580" y="185" width="20" height="25" fill="#059669" />
            <text x="590" y="225" fill="#34d399" font-size="9" font-weight="bold" text-anchor="middle">Nanoparticles OUT</text>
            <text x="590" y="238" fill="#94a3b8" font-size="8" text-anchor="middle">&lt; 1 ppm Residual Solvent</text>

            <!-- Supercritical CO2 Depressurization & Solvent Recovery Loop -->
            <path d="M 600 95 L 600 70 L 660 70 L 660 270 L 250 270 L 250 28" fill="none" stroke="#0284c7" stroke-width="1.5" stroke-dasharray="5 3" />
            <text x="450" y="275" fill="#38bdf8" font-size="9" text-anchor="middle">&gt;98% Closed-Loop scCO₂ &amp; Solvent Condensation Recycle</text>
          </svg>
        </div>
      </div>

      <!-- In-Vitro Dissolution Kinetics Canvas Chart -->
      <div class="bg-surface-soft border border-hairline rounded-3xl p-6 sm:p-7 shadow-xs space-y-4">
        <div>
          <h4 class="text-base font-bold text-ink mb-1">{d.chartTitle}</h4>
          <p class="text-xs text-muted">{d.chartSub}</p>
        </div>

        <div class="bg-surface rounded-2xl p-4 border border-hairline">
