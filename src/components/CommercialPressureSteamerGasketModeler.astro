const d = DICTIONARY[lang];
const steamers = steamerData.steamerModels;
const gaskets = steamerData.gasketMaterials;
const interlocks = steamerData.doorLatchInterlocks;
const drains = steamerData.condensateDrainStates;
---

<section class="my-10 p-6 md:p-8 bg-surface border border-hairline rounded-3xl shadow-xs" id="pressure-steamer-gasket-modeler-app">
  <div class="flex flex-wrap items-center justify-between gap-4 mb-6 pb-6 border-b border-hairline">
    <div>
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-500/10 text-amber-800 dark:text-amber-300 mb-2 border border-amber-500/20">
        {d.badge}
      </span>
      <h2 class="text-2xl md:text-3xl font-extrabold text-ink tracking-tight">
        {d.title}
      </h2>
      <p class="text-sm md:text-base text-muted mt-1 max-w-3xl leading-relaxed">
        {d.subtitle}
      </p>
    </div>
    <button
      id="copy-report-btn"
      type="button"
      class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-surface-soft hover:bg-surface-elevated text-ink border border-hairline text-sm font-semibold transition-all shadow-xs cursor-pointer"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
      </svg>
      <span id="copy-btn-text">{d.copyReportBtn}</span>
    </button>
  </div>

  <!-- Presets Bar -->
  <div class="mb-8 p-4 bg-surface-soft border border-hairline rounded-2xl">
    <div class="text-xs font-bold uppercase tracking-wider text-muted mb-3">
      {d.presetsTitle}
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-2.5">
      <button
        type="button"
        id="preset-gold"
        class="text-left p-3 rounded-xl bg-surface border border-emerald-500/30 hover:border-emerald-500 text-xs transition-all shadow-2xs group"
      >
        <div class="font-bold text-emerald-800 dark:text-emerald-300 mb-1 flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-500 inline-block"></span>
          Gold Standard ASME
        </div>
        <div class="text-muted line-clamp-2 leading-relaxed">
          {d.presetGoldStandard}
        </div>
      </button>

      <button
        type="button"
        id="preset-blowout"
        class="text-left p-3 rounded-xl bg-surface border border-amber-500/30 hover:border-amber-500 text-xs transition-all shadow-2xs group"
      >
        <div class="font-bold text-amber-800 dark:text-amber-300 mb-1 flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-amber-500 inline-block"></span>
          Hydrolytic Blowout
        </div>
        <div class="text-muted line-clamp-2 leading-relaxed">
          {d.presetBlowout}
        </div>
      </button>

      <button
        type="button"
        id="preset-flooded"
        class="text-left p-3 rounded-xl bg-surface border border-rose-500/30 hover:border-rose-500 text-xs transition-all shadow-2xs group"
      >
        <div class="font-bold text-rose-800 dark:text-rose-300 mb-1 flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-rose-500 inline-block"></span>
          Flooded Boiling Deluge
        </div>
        <div class="text-muted line-clamp-2 leading-relaxed">
          {d.presetFloodedDeluge}
        </div>
      </button>

      <button
        type="button"
        id="preset-interlock"
        class="text-left p-3 rounded-xl bg-surface border border-red-500/30 hover:border-red-500 text-xs transition-all shadow-2xs group"
      >
        <div class="font-bold text-red-800 dark:text-red-300 mb-1 flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-red-600 inline-block"></span>
          Defeated Interlock Blowoff
        </div>
        <div class="text-muted line-clamp-2 leading-relaxed">
          {d.presetDefeatedInterlock}
        </div>
      </button>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <!-- Left Column: Controls (7 cols) -->
    <div class="lg:col-span-7 space-y-6">
      <div class="p-5 bg-surface-soft border border-hairline rounded-2xl">
        <h3 class="text-base font-bold text-ink mb-1">{d.controlsTitle}</h3>
        <p class="text-xs text-muted mb-5 leading-relaxed">{d.controlsSub}</p>

        <div class="space-y-4">
          <!-- Steamer Architecture -->
          <div>
            <label for="steamer-model-select" class="block text-xs font-semibold text-ink mb-1">
              {d.steamerModelLabel}
            </label>
            <select
              id="steamer-model-select"
              class="w-full px-3.5 py-2.5 rounded-xl bg-surface border border-hairline text-ink text-xs md:text-sm font-medium focus:ring-2 focus:ring-amber-500 transition-all cursor-pointer"
            >
              {steamers.map(m => (
                <option value={m.id}>{m.name}</option>
              ))}
            </select>
            <p class="text-[11px] text-muted mt-1">{d.steamerModelHelp}</p>
          </div>

          <!-- Gasket Material -->
          <div>
            <label for="gasket-material-select" class="block text-xs font-semibold text-ink mb-1">
              {d.gasketMaterialLabel}
            </label>
            <select
              id="gasket-material-select"
              class="w-full px-3.5 py-2.5 rounded-xl bg-surface border border-hairline text-ink text-xs md:text-sm font-medium focus:ring-2 focus:ring-amber-500 transition-all cursor-pointer"
            >
              {gaskets.map(g => (
                <option value={g.id}>{g.name}</option>
              ))}
            </select>
            <p class="text-[11px] text-muted mt-1">{d.gasketMaterialHelp}</p>
          </div>

          <!-- Interlock Mechanism -->
          <div>
            <label for="interlock-type-select" class="block text-xs font-semibold text-ink mb-1">
              {d.interlockTypeLabel}
            </label>
            <select
              id="interlock-type-select"
              class="w-full px-3.5 py-2.5 rounded-xl bg-surface border border-hairline text-ink text-xs md:text-sm font-medium focus:ring-2 focus:ring-amber-500 transition-all cursor-pointer"
            >
              {interlocks.map(i => (
                <option value={i.id}>{i.name}</option>
              ))}
            </select>
            <p class="text-[11px] text-muted mt-1">{d.interlockTypeHelp}</p>
          </div>

          <!-- Condensate Drain State -->
          <div>
            <label for="drain-state-select" class="block text-xs font-semibold text-ink mb-1">
              {d.drainStateLabel}
            </label>
            <select
              id="drain-state-select"
              class="w-full px-3.5 py-2.5 rounded-xl bg-surface border border-hairline text-ink text-xs md:text-sm font-medium focus:ring-2 focus:ring-amber-500 transition-all cursor-pointer"
            >
              {drains.map(dr => (
                <option value={dr.id}>{dr.name}</option>
              ))}
            </select>
            <p class="text-[11px] text-muted mt-1">{d.drainStateHelp}</p>
          </div>

          <!-- Sliders Grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-3 border-t border-hairline">
            <!-- Operating Hours -->
            <div>
              <div class="flex justify-between items-center mb-1">
                <label for="hours-slider" class="text-xs font-semibold text-ink">
                  {d.hoursSliderLabel}
                </label>
                <span id="hours-val" class="text-xs font-bold font-mono text-amber-600">300 hrs</span>
              </div>
              <input
                id="hours-slider"
                type="range"
                min="0"
                max="2000"
                step="25"
                value="300"
                class="w-full accent-amber-600 cursor-pointer"
              />
              <p class="text-[10px] text-muted mt-0.5">{d.hoursSliderHelp}</p>
            </div>

            <!-- Operating Pressure -->
            <div>
              <div class="flex justify-between items-center mb-1">
                <label for="pressure-slider" class="text-xs font-semibold text-ink">
                  {d.pressureSliderLabel}
                </label>
                <span id="pressure-val" class="text-xs font-bold font-mono text-amber-600">15.0 PSI</span>
              </div>
              <input
                id="pressure-slider"
                type="range"
                min="0.0"
                max="15.0"
                step="0.5"
                value="15.0"
                class="w-full accent-amber-600 cursor-pointer"
              />
              <p class="text-[10px] text-muted mt-0.5">{d.pressureSliderHelp}</p>
            </div>

            <!-- Door Hinge Sag -->
            <div>
              <div class="flex justify-between items-center mb-1">
                <label for="sag-slider" class="text-xs font-semibold text-ink">
                  {d.sagSliderLabel}
                </label>
                <span id="sag-val" class="text-xs font-bold font-mono text-amber-600">0.4 mm</span>
              </div>
              <input
                id="sag-slider"
                type="range"
                min="0.0"
                max="5.0"
                step="0.1"
                value="0.4"
                class="w-full accent-amber-600 cursor-pointer"
              />
              <p class="text-[10px] text-muted mt-0.5">{d.sagSliderHelp}</p>
            </div>

            <!-- Operator Opening Force -->
            <div>
              <div class="flex justify-between items-center mb-1">
                <label for="door-force-slider" class="text-xs font-semibold text-ink">
                  {d.doorForceSliderLabel}
                </label>
                <span id="door-force-val" class="text-xs font-bold font-mono text-amber-600">45 N (10 lbf)</span>
              </div>
              <input
                id="door-force-slider"
                type="range"
                min="10"
                max="250"
                step="5"
                value="45"
                class="w-full accent-amber-600 cursor-pointer"
              />
              <p class="text-[10px] text-muted mt-0.5">{d.doorForceSliderHelp}</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Diagnostic Readouts & Meters (5 cols) -->
    <div class="lg:col-span-5 space-y-4">
      <div class="p-5 bg-surface-soft border border-hairline rounded-2xl">
        <h3 class="text-base font-bold text-ink mb-1">{d.diagnosticTitle}</h3>
        <p class="text-xs text-muted mb-4 leading-relaxed">{d.diagnosticSub}</p>

        <!-- Meters Grid -->
        <div class="space-y-3.5">
          <!-- Meter 1: Embrittlement -->
          <div class="bg-surface p-3.5 rounded-xl border border-hairline">
            <div class="flex justify-between items-center text-xs mb-1">
              <span class="text-muted font-medium">{d.embrittlementLabel}</span>
              <span id="meter-embrittlement-text" class="font-mono font-bold text-ink">24% (54 Shore A)</span>
            </div>
            <div class="w-full bg-surface-soft h-2.5 rounded-full overflow-hidden border border-hairline/60">
              <div id="meter-embrittlement-bar" class="h-full bg-emerald-500 transition-all duration-300" style="width: 24%"></div>
            </div>
          </div>

          <!-- Meter 2: Clearance Gap -->
          <div class="bg-surface p-3.5 rounded-xl border border-hairline">
            <div class="flex justify-between items-center text-xs mb-1">
              <span class="text-muted font-medium">{d.clearanceGapLabel}</span>
              <span id="meter-clearance-text" class="font-mono font-bold text-ink">0.22 mm (Safe Seal)</span>
            </div>
            <div class="w-full bg-surface-soft h-2.5 rounded-full overflow-hidden border border-hairline/60">
              <div id="meter-clearance-bar" class="h-full bg-emerald-500 transition-all duration-300" style="width: 18%"></div>
            </div>
          </div>

          <!-- Meter 3: Jet Velocity -->
          <div class="bg-surface p-3.5 rounded-xl border border-hairline">
            <div class="flex justify-between items-center text-xs mb-1">
              <span class="text-muted font-medium">{d.jetVelocityLabel}</span>
              <span id="meter-velocity-text" class="font-mono font-bold text-ink">0 m/s (Contained)</span>
            </div>
            <div class="w-full bg-surface-soft h-2.5 rounded-full overflow-hidden border border-hairline/60">
              <div id="meter-velocity-bar" class="h-full bg-emerald-500 transition-all duration-300" style="width: 0%"></div>
            </div>
          </div>

          <!-- Meter 4: Scald Danger Radius -->
          <div class="bg-surface p-3.5 rounded-xl border border-hairline">
            <div class="flex justify-between items-center text-xs mb-1">
              <span class="text-muted font-medium">{d.scaldRadiusLabel}</span>
              <span id="meter-radius-text" class="font-mono font-bold text-ink">0.0 m (Zero Plume)</span>
            </div>
            <div class="w-full bg-surface-soft h-2.5 rounded-full overflow-hidden border border-hairline/60">
              <div id="meter-radius-bar" class="h-full bg-emerald-500 transition-all duration-300" style="width: 0%"></div>
            </div>
          </div>

          <!-- Meter 5: Third-Degree Burn Latency -->
          <div class="bg-surface p-3.5 rounded-xl border border-hairline">
            <div class="flex justify-between items-center text-xs mb-1">
              <span class="text-muted font-medium">{d.burnLatencyLabel}</span>
              <span id="meter-latency-text" class="font-mono font-bold text-ink">&gt;60.0 s (No Jet)</span>
            </div>
            <div class="w-full bg-surface-soft h-2.5 rounded-full overflow-hidden border border-hairline/60">
              <div id="meter-latency-bar" class="h-full bg-emerald-500 transition-all duration-300" style="width: 100%"></div>
            </div>
          </div>

          <!-- Compliance Verdict Card -->
          <div id="compliance-card" class="p-3.5 rounded-xl border border-emerald-500/30 bg-emerald-500/10 text-xs">
            <div class="font-bold text-emerald-800 dark:text-emerald-300 mb-0.5 flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-emerald-500 inline-block"></span>
              {d.complianceLabel}
            </div>
            <div id="compliance-text" class="font-medium text-emerald-900 dark:text-emerald-200">
              ASME BPVC &amp; OSHA Compliant: Gasket elasticity intact, positive interlock active, zero steam scalding plume.
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Deep Dive Diagnostics & Protocols -->
  <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-6">
    <div class="p-5 bg-surface-soft border border-hairline rounded-2xl">
      <div class="text-xs font-bold uppercase tracking-wider text-rose-600 mb-2 flex items-center gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        {d.primaryRiskLabel}
      </div>
      <p id="diag-primary-risk" class="text-xs text-ink leading-relaxed">
        Normal operating state. Silicone gasket elasticity ensures tight perimeter contact; positive safety interlock prevents unlatching under pressure.
      </p>
    </div>

    <div class="p-5 bg-surface-soft border border-hairline rounded-2xl">
      <div class="text-xs font-bold uppercase tracking-wider text-amber-600 mb-2 flex items-center gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
        </svg>
        {d.mechanismsLabel}
      </div>
      <p id="diag-mechanisms" class="text-xs text-ink leading-relaxed">
        Elastomer experiences stable thermal equilibrium. Hydrolytic scission rate of siloxane backbones remains under 0.02%/hr. No compressible choked flow.
      </p>
    </div>

    <div class="p-5 bg-surface-soft border border-hairline rounded-2xl">
      <div class="text-xs font-bold uppercase tracking-wider text-emerald-600 mb-2 flex items-center gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        {d.mitigationLabel}
      </div>
      <p id="diag-mitigation" class="text-xs text-ink leading-relaxed">
        Maintain scheduled 500-hour gasket replacements, daily condensate trap flushing, weekly hinge alignment inspections, and annual ASME safety valve testing.
      </p>
    </div>
  </div>

  <!-- Technical Comparison Table -->
  <div class="mt-10 border-t border-hairline pt-8">
    <div class="mb-4">
      <h3 class="text-lg font-bold text-ink">{d.tableTitle}</h3>
      <p class="text-xs text-muted mt-0.5">{d.tableSub}</p>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs border border-hairline rounded-xl overflow-hidden">
        <thead class="bg-surface-soft border-b border-hairline text-ink font-semibold">
          <tr>
            <th class="p-3">{d.colModel}</th>
            <th class="p-3">{d.colPressure}</th>
            <th class="p-3">{d.colDoorThrust}</th>
            <th class="p-3">{d.colVolume}</th>
            <th class="p-3">{d.colLatch}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline">
          {steamers.map(m => (
            <tr class="hover:bg-surface-soft/50 transition-colors">
              <td class="p-3 font-medium text-ink">{m.name}</td>
              <td class="p-3 font-mono text-muted">{m.operatingPressurePsi} PSI ({m.steamTemperatureC}°C)</td>
              <td class="p-3 font-mono text-amber-700 dark:text-amber-400 font-bold">{m.totalDoorThrustForceLbfAtMaxPressure.toLocaleString()} lbf ({m.totalDoorThrustForceKn} kN)</td>
              <td class="p-3 font-mono text-muted">{m.compartmentVolumeLiters} L</td>
              <td class="p-3 text-muted">{m.latchType}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Safety & Regulatory Directives -->
  <div class="mt-10 border-t border-hairline pt-8">
    <div class="mb-6">
      <h3 class="text-lg font-bold text-ink">{d.rulesTitle}</h3>
      <p class="text-xs text-muted mt-0.5">{d.rulesSub}</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="p-4 bg-surface-soft border border-hairline rounded-xl">
        <h4 class="text-xs font-bold text-ink mb-1.5">{d.rule1Title}</h4>
        <p class="text-xs text-muted leading-relaxed">{d.rule1Text}</p>
      </div>
      <div class="p-4 bg-surface-soft border border-hairline rounded-xl">
        <h4 class="text-xs font-bold text-ink mb-1.5">{d.rule2Title}</h4>
        <p class="text-xs text-muted leading-relaxed">{d.rule2Text}</p>
      </div>
      <div class="p-4 bg-surface-soft border border-hairline rounded-xl">
        <h4 class="text-xs font-bold text-ink mb-1.5">{d.rule3Title}</h4>
        <p class="text-xs text-muted leading-relaxed">{d.rule3Text}</p>
      </div>
      <div class="p-4 bg-surface-soft border border-hairline rounded-xl">
        <h4 class="text-xs font-bold text-ink mb-1.5">{d.rule4Title}</h4>
        <p class="text-xs text-muted leading-relaxed">{d.rule4Text}</p>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ steamerData, lang }}>
(function() {
  const steamers = steamerData.steamerModels;
  const gaskets = steamerData.gasketMaterials;
  const interlocks = steamerData.doorLatchInterlocks;
  const drains = steamerData.condensateDrainStates;
  const benchmarks = steamerData.physicsBenchmarks;

  // DOM Elements
  const steamerSelect = document.getElementById('steamer-model-select');
  const gasketSelect = document.getElementById('gasket-material-select');
  const interlockSelect = document.getElementById('interlock-type-select');
  const drainSelect = document.getElementById('drain-state-select');

  const hoursSlider = document.getElementById('hours-slider');
  const pressureSlider = document.getElementById('pressure-slider');
  const sagSlider = document.getElementById('sag-slider');
  const doorForceSlider = document.getElementById('door-force-slider');

  const hoursVal = document.getElementById('hours-val');
  const pressureVal = document.getElementById('pressure-val');
  const sagVal = document.getElementById('sag-val');
  const doorForceVal = document.getElementById('door-force-val');

  // Meters
  const meterEmbrittlementText = document.getElementById('meter-embrittlement-text');
  const meterEmbrittlementBar = document.getElementById('meter-embrittlement-bar');
  const meterClearanceText = document.getElementById('meter-clearance-text');
  const meterClearanceBar = document.getElementById('meter-clearance-bar');
  const meterVelocityText = document.getElementById('meter-velocity-text');
  const meterVelocityBar = document.getElementById('meter-velocity-bar');
  const meterRadiusText = document.getElementById('meter-radius-text');
  const meterRadiusBar = document.getElementById('meter-radius-bar');
  const meterLatencyText = document.getElementById('meter-latency-text');
  const meterLatencyBar = document.getElementById('meter-latency-bar');

  // Diagnostics Cards
  const complianceCard = document.getElementById('compliance-card');
  const complianceText = document.getElementById('compliance-text');
  const diagPrimaryRisk = document.getElementById('diag-primary-risk');
  const diagMechanisms = document.getElementById('diag-mechanisms');
  const diagMitigation = document.getElementById('diag-mitigation');

  // Presets
  const btnPresetGold = document.getElementById('preset-gold');
  const btnPresetBlowout = document.getElementById('preset-blowout');
  const btnPresetFlooded = document.getElementById('preset-flooded');
  const btnPresetInterlock = document.getElementById('preset-interlock');

  // Copy Report
  const copyBtn = document.getElementById('copy-report-btn');
  const copyBtnText = document.getElementById('copy-btn-text');

  function calculateState() {
    const curSteamer = steamers.find(m => m.id === steamerSelect.value) || steamers[0];
    const curGasket = gaskets.find(g => g.id === gasketSelect.value) || gaskets[0];
    const curInterlock = interlocks.find(i => i.id === interlockSelect.value) || interlocks[0];
    const curDrain = drains.find(d => d.id === drainSelect.value) || drains[0];

    const hours = parseFloat(hoursSlider.value);
    const pressurePsi = parseFloat(pressureSlider.value);
    const sagMm = parseFloat(sagSlider.value);
    const doorForceN = parseFloat(doorForceSlider.value);

    // Update Slider Labels
    hoursVal.textContent = `${hours} hrs`;
    pressureVal.textContent = `${pressurePsi.toFixed(1)} PSI (${(pressurePsi * 0.0689476).toFixed(2)} bar)`;
    sagVal.textContent = `${sagMm.toFixed(1)} mm`;
    doorForceVal.textContent = `${doorForceN.toFixed(0)} N (${(doorForceN * 0.224809).toFixed(1)} lbf)`;

    // 1. Gasket Hydrolytic Embrittlement & Compression Set Kinetics
    // Embrittlement increases with dwell hours, temperature (pressure), and material vulnerability
    let hydroFactor = 1.0;
    if (curGasket.hydrolysisResistanceRating === 'EXCELLENT') hydroFactor = 0.45;
    else if (curGasket.hydrolysisResistanceRating === 'VERY_HIGH') hydroFactor = 0.60;
    else if (curGasket.hydrolysisResistanceRating === 'MODERATE') hydroFactor = 1.0;
    else if (curGasket.hydrolysisResistanceRating === 'CRITICAL_LOW') hydroFactor = 2.4;

    const pressureTempFactor = 1.0 + (pressurePsi / 15.0) * 0.5;
    const compressionSetPercent = Math.min(95.0, (hours / curGasket.recommendedReplacementHours) * 40.0 * hydroFactor * pressureTempFactor);
    const currentHardness = Math.min(curGasket.hardenedLimitShoreA, curGasket.initialHardnessShoreA + (compressionSetPercent / 100.0) * (curGasket.hardenedLimitShoreA - curGasket.initialHardnessShoreA));

    // 2. Perimeter Seal Extrusion Clearance Gap (mm)
    // Gap depends on hinge sag, door force, gasket elasticity loss, and steam thrust
    const totalThrustLbf = curSteamer.doorAreaSqInches * pressurePsi;
    const thrustN = totalThrustLbf * 4.44822;

    let interlockHoldingCapacityN = 25000; // Normal latch holds 25 kN
    if (curInterlock.burstDoorOpeningPrevention === 'ABSOLUTE_FAIL_SAFE') interlockHoldingCapacityN = 60000;
    else if (curInterlock.burstDoorOpeningPrevention === 'MODERATE_DEPENDENT_ON_SPRING') interlockHoldingCapacityN = 18000;
    else if (curInterlock.burstDoorOpeningPrevention === 'OPERATOR_DEPENDENT') interlockHoldingCapacityN = 45000;
    else if (curInterlock.burstDoorOpeningPrevention === 'COMPROMISED_ZERO_PROTECTION') interlockHoldingCapacityN = 120; // Bypassed

    // Does door pop open or gap open under pressure and operator force?
    let doorUnlatched = false;
    if ((thrustN + doorForceN) > interlockHoldingCapacityN) {
      doorUnlatched = true;
    } else if (curInterlock.burstDoorOpeningPrevention === 'COMPROMISED_ZERO_PROTECTION' && (doorForceN > 40 || totalThrustLbf > 200)) {
      doorUnlatched = true; // Bypassed interlock fails under light load
    } else if (curInterlock.burstDoorOpeningPrevention === 'MODERATE_DEPENDENT_ON_SPRING' && doorForceN > 140 && pressurePsi > 2.0) {
      doorUnlatched = true; // Slam latch pulled hard under residual pressure
    }

    let perimeterGapMm = 0.05 + (sagMm * 0.45) + (compressionSetPercent / 100.0) * 0.65;
    if (doorUnlatched) {
      perimeterGapMm += 8.5 + (pressurePsi * 0.8); // Door bursts open 8-20 mm
    } else if (compressionSetPercent > 45.0 && pressurePsi > 10.0) {
      // Gasket extrusion blowout
      perimeterGapMm += (compressionSetPercent - 45.0) * 0.05;
    }

    // 3. Compressible Saint-Venant Sonic Nozzle Jet Velocity (m/s)
    // For saturated steam discharging to atmospheric pressure (P_ratio = 101.3 / (101.3 + P_gauge_kPa))
    const pGaugeKpa = pressurePsi * 6.89476;
    const pAbsKpa = 101.325 + pGaugeKpa;
    const pRatio = 101.325 / pAbsKpa;
    const criticalPressureRatio = 0.577; // Saturated steam k = 1.30

    let jetVelocityMs = 0.0;
    if (perimeterGapMm > benchmarks.maxSafeGasketClearanceMm && pressurePsi > 0.2) {
      if (pRatio <= criticalPressureRatio) {
        // Sonic Choked Flow
        jetVelocityMs = benchmarks.soundSpeedInSteamAt121CMs; // ~475 m/s at throat
      } else {
        // Subsonic isentropic expansion
        jetVelocityMs = Math.min(420, Math.sqrt(2 * 1000 * (pGaugeKpa / benchmarks.steamDensityAt15PsiKgM3)));
      }
    }

    // 4. OSHA Boiling Scald Hazard Projection Radius (meters)
    let scaldRadiusMeters = 0.0;
    if (jetVelocityMs > 0) {
      scaldRadiusMeters = Math.min(4.8, (jetVelocityMs / 100.0) * (perimeterGapMm / 1.5) + (curDrain.condensateAccumulationLiters * 0.08));
    }

    // 5. Third-Degree Full-Thickness Scald Burn Latency (seconds)
    // Latent heat of steam = 2,257 kJ/kg; skin scald kinetics under 100°C–121°C steam
    let burnLatencySec = 99.9;
    if (scaldRadiusMeters > 0.2) {
      if (curDrain.condensateAccumulationLiters > 5.0 && doorUnlatched) {
        burnLatencySec = 0.12; // Massive boiling water flood + steam geyser
      } else if (pressurePsi >= 12.0) {
        burnLatencySec = 0.25; // High pressure steam scald
      } else if (pressurePsi >= 5.0) {
        burnLatencySec = 0.65;
      } else {
        burnLatencySec = 1.80;
      }
    }

    // Update UI Meters
    meterEmbrittlementText.textContent = `${compressionSetPercent.toFixed(0)}% (${currentHardness.toFixed(0)} Shore A)`;
    meterEmbrittlementBar.style.width = `${Math.min(100, compressionSetPercent)}%`;
    if (compressionSetPercent > 50) {
      meterEmbrittlementBar.className = 'h-full bg-rose-600 transition-all duration-300';
    } else if (compressionSetPercent > 30) {
      meterEmbrittlementBar.className = 'h-full bg-amber-500 transition-all duration-300';
    } else {
      meterEmbrittlementBar.className = 'h-full bg-emerald-500 transition-all duration-300';
    }

    meterClearanceText.textContent = `${perimeterGapMm.toFixed(2)} mm (${doorUnlatched ? 'DOOR BLOWOFF' : (perimeterGapMm > benchmarks.criticalExtrusionClearanceMm ? 'EXTRUSION BREACH' : (perimeterGapMm > benchmarks.maxSafeGasketClearanceMm ? 'LEAKING GAP' : 'SEALED'))})`;
    meterClearanceBar.style.width = `${Math.min(100, (perimeterGapMm / 3.0) * 100)}%`;
    if (perimeterGapMm > benchmarks.criticalExtrusionClearanceMm || doorUnlatched) {
      meterClearanceBar.className = 'h-full bg-rose-600 transition-all duration-300';
    } else if (perimeterGapMm > benchmarks.maxSafeGasketClearanceMm) {
      meterClearanceBar.className = 'h-full bg-amber-500 transition-all duration-300';
    } else {
      meterClearanceBar.className = 'h-full bg-emerald-500 transition-all duration-300';
    }

    meterVelocityText.textContent = `${jetVelocityMs.toFixed(0)} m/s (${jetVelocityMs >= benchmarks.soundSpeedInSteamAt121CMs ? 'CHOKED SONIC JET' : (jetVelocityMs > 50 ? 'HIGH-SPEED JET' : 'CONTAINED')})`;
    meterVelocityBar.style.width = `${Math.min(100, (jetVelocityMs / 475.0) * 100)}%`;
    if (jetVelocityMs > 250) {
      meterVelocityBar.className = 'h-full bg-rose-600 transition-all duration-300';
    } else if (jetVelocityMs > 0) {
      meterVelocityBar.className = 'h-full bg-amber-500 transition-all duration-300';
    } else {
      meterVelocityBar.className = 'h-full bg-emerald-500 transition-all duration-300';
    }

    meterRadiusText.textContent = `${scaldRadiusMeters.toFixed(1)} m (${(scaldRadiusMeters * 3.28084).toFixed(1)} ft)`;
    meterRadiusBar.style.width = `${Math.min(100, (scaldRadiusMeters / 4.5) * 100)}%`;
    if (scaldRadiusMeters > 2.0) {
      meterRadiusBar.className = 'h-full bg-rose-600 transition-all duration-300';
    } else if (scaldRadiusMeters > 0.5) {
      meterRadiusBar.className = 'h-full bg-amber-500 transition-all duration-300';
    } else {
      meterRadiusBar.className = 'h-full bg-emerald-500 transition-all duration-300';
    }

    meterLatencyText.textContent = burnLatencySec > 30 ? '>60.0 s (Safe)' : `${burnLatencySec.toFixed(2)} s (CRITICAL)`;
    meterLatencyBar.style.width = `${Math.min(100, (burnLatencySec > 30 ? 100 : (burnLatencySec / 2.0) * 100))}%`;
    if (burnLatencySec < 0.5) {
      meterLatencyBar.className = 'h-full bg-rose-600 transition-all duration-300';
    } else if (burnLatencySec < 2.0) {
      meterLatencyBar.className = 'h-full bg-amber-500 transition-all duration-300';
    } else {
      meterLatencyBar.className = 'h-full bg-emerald-500 transition-all duration-300';
    }

    // Compliance & Diagnostic Messages
    if (doorUnlatched) {
      complianceCard.className = 'p-3.5 rounded-xl border border-red-600/40 bg-red-600/15 text-xs';
      complianceText.className = 'font-bold text-red-900 dark:text-red-200';
      complianceText.textContent = 'CRITICAL ASME & OSHA VIOLATION: Door opened under positive steam pressure head. Lethal scalding geyser ejected into kitchen walkway.';
      diagPrimaryRisk.textContent = `Catastrophic scald explosion: door blown open by ${totalThrustLbf.toFixed(0)} lbf of internal steam force, discharging ${curDrain.condensateAccumulationLiters}L of boiling liquid. Full-thickness third-degree burns occur in ${burnLatencySec.toFixed(2)} seconds.`;
      diagMechanisms.textContent = `Chamber pressure exceeded interlock containment threshold. Compressible steam flow reached sonic choked velocity (${jetVelocityMs.toFixed(0)} m/s), propelling an aerosolized boiling deluge across a ${scaldRadiusMeters.toFixed(1)}m perimeter envelope.`;
      diagMitigation.textContent = 'IMMEDIATE ACTIONS: Lockout/tagout equipment immediately. Replace seized interlock switches, realign door hinge pins, restore dual pressure transducer lockout logic, and mandate safety training under OSHA 1910.212.';
    } else if (perimeterGapMm > benchmarks.criticalExtrusionClearanceMm) {
      complianceCard.className = 'p-3.5 rounded-xl border border-rose-600/40 bg-rose-600/15 text-xs';
      complianceText.className = 'font-bold text-rose-900 dark:text-rose-200';
      complianceText.textContent = 'NON-COMPLIANT (ASME SECTION VIII BREACH): Gasket extruded from retainer channel. Sonic steam scalding jet discharging across prep line.';
      diagPrimaryRisk.textContent = `Gasket blowout hazard: hardened ${currentHardness.toFixed(0)} Shore A elastomer failed to seal ${perimeterGapMm.toFixed(2)} mm gap, producing high-velocity ${jetVelocityMs.toFixed(0)} m/s steam jet with a ${scaldRadiusMeters.toFixed(1)}m injury perimeter.`;
      diagMechanisms.textContent = `Hydrolytic chain scission in saturated steam cleaved polymer crosslinks (compression set: ${compressionSetPercent.toFixed(0)}%). Steam pressure forced brittle gasket lip past retainer flange into choked sonic discharge.`;
      diagMitigation.textContent = 'Replace gasket with platinum-cured VMQ or high-temp EPDM. Ream and replace worn hinge bushings to eliminate door frame sag below 0.3 mm. Verify ASME relief valve discharge calibration.';
    } else if (perimeterGapMm > benchmarks.maxSafeGasketClearanceMm) {
      complianceCard.className = 'p-3.5 rounded-xl border border-amber-500/30 bg-amber-500/10 text-xs';
      complianceText.className = 'font-bold text-amber-900 dark:text-amber-200';
      complianceText.textContent = 'BORDERLINE / MONITORING REQUIRED: Minor perimeter steam weeping observed. Compression set approaching critical 40% threshold.';
      diagPrimaryRisk.textContent = `Perimeter steam leakage hazard: hinge sag (${sagMm.toFixed(1)} mm) and early elastomer hardening allow pressurized steam weeping. Operator facial scald risk if leaning over latch.`;
      diagMechanisms.textContent = `Localized compression loss along bottom door edge due to hinge pin play. Steam condensate accumulating on floor creates slip/fall hazard under OSHA 1910.22.`;
      diagMitigation.textContent = 'Schedule gasket replacement during next maintenance cycle. Re-torque door hinge bracket bolts and inspect thermostatic drain trap for calcium carbonate scale buildup.';
    } else {
      complianceCard.className = 'p-3.5 rounded-xl border border-emerald-500/30 bg-emerald-500/10 text-xs';
      complianceText.className = 'font-bold text-emerald-900 dark:text-emerald-200';
      complianceText.textContent = 'ASME BPVC & OSHA COMPLIANT: Gasket elasticity within nominal limits, interlock active, zero steam scalding plume.';
      diagPrimaryRisk.textContent = 'Normal operating state. Silicone gasket elasticity ensures tight perimeter contact; positive safety interlock prevents unlatching under pressure.';
      diagMechanisms.textContent = 'Elastomer experiences stable thermal equilibrium. Hydrolytic scission rate of siloxane backbones remains under 0.02%/hr. No compressible choked flow.';
      diagMitigation.textContent = 'Maintain scheduled 500-hour gasket replacements, daily condensate trap flushing, weekly hinge alignment inspections, and annual ASME safety valve testing.';
    }

    return {
      steamer: curSteamer.name,
      gasket: curGasket.name,
      interlock: curInterlock.name,
      drain: curDrain.name,
      hours,
      pressurePsi,
      sagMm,
      doorForceN,
      compressionSetPercent: compressionSetPercent.toFixed(1),
      currentHardness: currentHardness.toFixed(0),
      perimeterGapMm: perimeterGapMm.toFixed(2),
      jetVelocityMs: jetVelocityMs.toFixed(0),
      scaldRadiusMeters: scaldRadiusMeters.toFixed(1),
      burnLatencySec: burnLatencySec.toFixed(2),
      compliance: complianceText.textContent
    };
  }

  // Event Listeners
  [steamerSelect, gasketSelect, interlockSelect, drainSelect].forEach(el => {
    el.addEventListener('change', calculateState);
  });
  [hoursSlider, pressureSlider, sagSlider, doorForceSlider].forEach(el => {
    el.addEventListener('input', calculateState);
  });

  // Presets
  btnPresetGold?.addEventListener('click', () => {
    steamerSelect.value = 'cleveland_24cga10_commercial_convection';
    gasketSelect.value = 'platinum_cured_high_temp_silicone';
    interlockSelect.value = 'solenoid_dual_transducer_fail_safe';
    drainSelect.value = 'clear_gravity_thermostatic_trap';
    hoursSlider.value = 150;
    pressureSlider.value = 15.0;
    sagSlider.value = 0.1;
    doorForceSlider.value = 30;
    calculateState();
  });

  btnPresetBlowout?.addEventListener('click', () => {
    steamerSelect.value = 'cleveland_24cga10_commercial_convection';
    gasketSelect.value = 'peroxide_cured_vmq_silicone';
    interlockSelect.value = 'cam_slam_latch_microswitch';
    drainSelect.value = 'clear_gravity_thermostatic_trap';
    hoursSlider.value = 1600;
    pressureSlider.value = 15.0;
    sagSlider.value = 2.8;
    doorForceSlider.value = 45;
    calculateState();
  });

  btnPresetFlooded?.addEventListener('click', () => {
    steamerSelect.value = 'cleveland_24cga10_commercial_convection';
    gasketSelect.value = 'generic_aftermarket_silicone';
    interlockSelect.value = 'cam_slam_latch_microswitch';
    drainSelect.value = 'fully_occluded_grease_scale_trap';
    hoursSlider.value = 650;
    pressureSlider.value = 15.0;
    sagSlider.value = 1.8;
    doorForceSlider.value = 180;
    calculateState();
  });

  btnPresetInterlock?.addEventListener('click', () => {
    steamerSelect.value = 'vulcan_24pf_direct_steam';
    gasketSelect.value = 'generic_aftermarket_silicone';
    interlockSelect.value = 'bypassed_sticking_interlock';
    drainSelect.value = 'partially_scaled_orifice';
    hoursSlider.value = 900;
    pressureSlider.value = 15.0;
    sagSlider.value = 3.5;
    doorForceSlider.value = 120;
    calculateState();
  });

  // Copy Report
  copyBtn?.addEventListener('click', () => {
    const report = calculateState();
    const text = [
      `=== COMMERCIAL PRESSURE STEAMER GASKET & SCALD JET AUDIT ===`,
      `Steamer Model: ${report.steamer}`,
      `Gasket Material: ${report.gasket}`,
      `Interlock Mechanism: ${report.interlock}`,
      `Condensate Drainage: ${report.drain}`,
      `Operational Hours: ${report.hours} hrs`,
      `Chamber Steam Pressure: ${report.pressurePsi} PSI`,
      `Door Hinge Sag: ${report.sagMm} mm`,
      `Operator Latch Force: ${report.doorForceN} N`,
      `------------------------------------------------------------`,
      `Gasket Compression Set: ${report.compressionSetPercent}% (${report.currentHardness} Shore A)`,
      `Perimeter Extrusion Clearance Gap: ${report.perimeterGapMm} mm`,
      `Discharge Jet Velocity: ${report.jetVelocityMs} m/s`,
      `OSHA Scald Hazard Radius: ${report.scaldRadiusMeters} m`,
      `Third-Degree Scald Latency: ${report.burnLatencySec} s`,
      `Audit Verdict: ${report.compliance}`,
      `============================================================`
    ].join('\n');

    navigator.clipboard.writeText(text).then(() => {
      const orig = copyBtnText.textContent;
      copyBtnText.textContent = 'Copied to Clipboard!';
      setTimeout(() => {
        copyBtnText.textContent = orig;
      }, 2500);
    });
  });

  // Initial Run
  calculateState();
})();
</script>