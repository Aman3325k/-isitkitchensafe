<script>
  function initEdbmModeler() {
    const root = document.getElementById('edbm-acid-recovery-root');
    if (!root) return;

    // Control Elements
    const skidSelect = document.getElementById('edbm-skid-select') as HTMLSelectElement | null;
    const matrixSelect = document.getElementById('edbm-matrix-select') as HTMLSelectElement | null;
    const currentDensitySlider = document.getElementById('current-density-slider') as HTMLInputElement | null;
    const tempSlider = document.getElementById('temp-slider') as HTMLInputElement | null;
    const feedFlowSlider = document.getElementById('feed-flow-slider') as HTMLInputElement | null;
    const targetAcidSlider = document.getElementById('target-acid-slider') as HTMLInputElement | null;
    const chilledJacketToggle = document.getElementById('chilled-jacket-toggle') as HTMLInputElement | null;
    const pulsedCipToggle = document.getElementById('pulsed-cip-toggle') as HTMLInputElement | null;

    // Badges
    const currentDensityVal = document.getElementById('current-density-val');
    const tempVal = document.getElementById('temp-val');
    const feedFlowVal = document.getElementById('feed-flow-val');
    const targetAcidVal = document.getElementById('target-acid-val');

    // Telemetry Elements
    const metricAcidYield = document.getElementById('metric-acid-yield');
    const barAcidYield = document.getElementById('bar-acid-yield');
    const metricCurrentEfficiency = document.getElementById('metric-current-efficiency');
    const barCurrentEff = document.getElementById('bar-current-eff');
    const metricSec = document.getElementById('metric-sec');
    const metricCaustic = document.getElementById('metric-caustic');
    const metricDemineralization = document.getElementById('metric-demineralization');
    const metricGypsumAvoided = document.getElementById('metric-gypsum-avoided');
    const metricLimitingMargin = document.getElementById('metric-limiting-margin');
    const barLimitingMargin = document.getElementById('bar-limiting-margin');
    const limitingWarningTxt = document.getElementById('limiting-warning-txt');
    const overallStatusBadge = document.getElementById('overall-status-badge');
    const noticeBox = document.getElementById('diagnostic-notice-box');
    const noticeTag = document.getElementById('notice-tag');
    const noticeDesc = document.getElementById('notice-desc');

    // SVG Telemetry Elements
    const svgAcidTiter = document.getElementById('svg-acid-titer');
    const svgFeedStatus = document.getElementById('svg-feed-status');
    const svgBaseTiter = document.getElementById('svg-base-titer');

    // Preset Buttons
    const btnLactic = document.getElementById('btn-preset-lactic');
    const btnCitric = document.getElementById('btn-preset-citric');
    const btnTartaric = document.getElementById('btn-preset-tartaric');
    const btnFermentation = document.getElementById('btn-preset-fermentation');
    const btnHazard = document.getElementById('btn-preset-hazard');

    function calculateTelemetry() {
      if (!skidSelect || !matrixSelect || !currentDensitySlider || !tempSlider || !feedFlowSlider || !targetAcidSlider) return;

      const skidIdx = parseInt(skidSelect.value, 10);
      const matrixIdx = parseInt(matrixSelect.value, 10);
      const currentDensity = parseFloat(currentDensitySlider.value);
      const temp = parseFloat(tempSlider.value);
      const flow = parseFloat(feedFlowSlider.value);
      const targetAcid = parseFloat(targetAcidSlider.value);
      const isJacket = chilledJacketToggle ? chilledJacketToggle.checked : true;
      const isPulsedCip = pulsedCipToggle ? pulsedCipToggle.checked : true;

      // Update Slider Value Badges
      if (currentDensityVal) currentDensityVal.textContent = `${currentDensity.toFixed(0)} A/m²`;
      if (tempVal) tempVal.textContent = `${temp.toFixed(0)}°C`;
      if (feedFlowVal) feedFlowVal.textContent = `${flow.toLocaleString()} L/h`;
      if (targetAcidVal) targetAcidVal.textContent = `${targetAcid.toFixed(0)} g/L`;

      // Matrix Baseline Parameters
      // [Greek Yogurt, Citrus Wash, Wine Lees, Fermentation Broth, Succinate Broth]
      const baseAcidConcentration = [45.0, 58.0, 36.0, 78.0, 62.0][matrixIdx] || 45.0;
      const baseConductivity = [9.4, 11.8, 8.2, 24.5, 21.0][matrixIdx] || 10.0;
      const acidType = ['Lactic Acid', 'Citric Acid', 'Tartaric Acid', 'Lactic Acid', 'Succinic Acid'][matrixIdx] || 'Lactic Acid';
      const gypsumMultiplier = [1.42, 1.34, 1.15, 1.45, 1.46][matrixIdx] || 1.42;

      // Limiting Current Density Calculation:
      // i_lim scales with conductivity and flow velocity, decreases if fouling or high temperature
      const flowVelocityFactor = Math.pow(flow / 3200, 0.45);
      const tempViscosityFactor = 1.0 + (temp - 15) * 0.015;
      const cipFactor = isPulsedCip ? 1.0 : 0.78;
      const baselineIlim = (baseConductivity * 38.5) * flowVelocityFactor * tempViscosityFactor * cipFactor;
      const limitingMargin = baselineIlim - currentDensity;

      // Current Efficiency (Faradaic Efficiency):
      // Optimal around 250-400 A/m2. Drops if i > i_lim or if severe back-diffusion
      let currentEfficiency = 0.88;
      if (currentDensity < baselineIlim) {
        currentEfficiency = 0.88 - (currentDensity / baselineIlim) * 0.08;
      } else {
        // Over-limiting current: parasitic water dissociation at monopolar membranes
        const overRatio = currentDensity / baselineIlim;
        currentEfficiency = Math.max(0.42, 0.80 - (overRatio - 1.0) * 0.65);
      }
      if (!isPulsedCip) currentEfficiency -= 0.06;
      if (!isJacket && temp > 30) currentEfficiency -= 0.07;
      currentEfficiency = Math.max(0.35, Math.min(0.96, currentEfficiency));

      // Acid Recovery Yield (Y_acid):
      let acidYield = 0.94;
      if (currentDensity < 200) {
        acidYield = 0.75 + (currentDensity / 200) * 0.15;
      } else if (currentDensity <= baselineIlim) {
        acidYield = 0.90 + Math.min(0.06, (currentDensity - 200) / 1000);
      } else {
        acidYield = Math.max(0.55, 0.92 - (currentDensity - baselineIlim) * 0.002);
      }
      if (!isPulsedCip) acidYield -= 0.05;
      acidYield = Math.max(0.48, Math.min(0.985, acidYield));

      // Specific Energy Consumption (SEC in kWh/kg acid):
      // Voltage per cell pair: U_cell = U_dissociation (0.83 to 1.1 V) + I*R_ohmic
      const cellOhms = (1.8 / baseConductivity) * (isPulsedCip ? 1.0 : 1.35);
      const cellVoltage = 1.02 + (currentDensity / 1000) * cellOhms * (isJacket ? 1.0 : 1.25);
      let sec = (cellVoltage * 26.8) / (currentEfficiency * (acidType.includes('Citric') ? 64.0 : 90.0));
      sec = Math.max(1.15, Math.min(5.50, sec));

      // Regenerated Caustic Alkali (M NaOH/KOH):
      let causticMolarity = (targetAcid / baseAcidConcentration) * 1.85 * currentEfficiency;
      causticMolarity = Math.max(0.5, Math.min(3.2, causticMolarity));

      // Demineralization / Ash Depletion Rate:
      let demineralizationRate = acidYield * (skidIdx === 1 ? 0.88 : 0.96);
      demineralizationRate = Math.max(0.45, Math.min(0.975, demineralizationRate));

      // Gypsum Waste Avoided:
      const gypsumAvoidedKg = gypsumMultiplier * acidYield;

      // DOM Updates
      if (metricAcidYield) metricAcidYield.textContent = `${(acidYield * 100).toFixed(1)}%`;
      if (barAcidYield) barAcidYield.style.width = `${Math.min(100, acidYield * 100)}%`;

      if (metricCurrentEfficiency) metricCurrentEfficiency.textContent = `${(currentEfficiency * 100).toFixed(1)}%`;
      if (barCurrentEff) barCurrentEff.style.width = `${Math.min(100, currentEfficiency * 100)}%`;

      if (metricSec) metricSec.textContent = `${sec.toFixed(2)} kWh/kg`;
      if (metricCaustic) metricCaustic.textContent = `${causticMolarity.toFixed(2)} M Alkali`;
      if (metricDemineralization) metricDemineralization.textContent = `${(demineralizationRate * 100).toFixed(1)}% Ash`;
      if (metricGypsumAvoided) metricGypsumAvoided.textContent = `${gypsumAvoidedKg.toFixed(2)} kg/kg`;

      // Limiting Margin UI
      if (metricLimitingMargin) {
        if (limitingMargin >= 0) {
          metricLimitingMargin.textContent = `+${limitingMargin.toFixed(0)} A/m² Margin`;
          metricLimitingMargin.className = 'font-mono font-bold text-emerald-400';
          if (barLimitingMargin) {
            barLimitingMargin.className = 'bg-emerald-500 h-full rounded-full transition-all duration-300';
            barLimitingMargin.style.width = `${Math.min(100, (limitingMargin / 250) * 100)}%`;
          }
          if (limitingWarningTxt) {
            limitingWarningTxt.textContent = `Operating safely below limiting current density (i_lim = ${baselineIlim.toFixed(0)} A/m²). Zero monopolar water splitting.`;
            limitingWarningTxt.className = 'text-[11px] text-muted leading-tight';
          }
        } else {
          metricLimitingMargin.textContent = `${limitingMargin.toFixed(0)} A/m² EXCEEDED`;
          metricLimitingMargin.className = 'font-mono font-bold text-red-400';
          if (barLimitingMargin) {
            barLimitingMargin.className = 'bg-red-500 h-full rounded-full transition-all duration-300';
            barLimitingMargin.style.width = '100%';
          }
          if (limitingWarningTxt) {
            limitingWarningTxt.textContent = `CRITICAL HAZARD: Over-limiting current density! Boundary layer ion starvation causing severe Joule heating and Ca(OH)2 scaling.`;
            limitingWarningTxt.className = 'text-[11px] text-red-400 font-medium leading-tight';
          }
        }
      }

      // Overall Badge & Compliance Notice
      const isCriticalHazard = (limitingMargin < -20 || (!isJacket && temp > 38 && currentDensity > 450));
      if (isCriticalHazard) {
        if (overallStatusBadge) {
          overallStatusBadge.textContent = 'CRITICAL HAZARD';
          overallStatusBadge.className = 'px-2.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-red-950 text-red-300 border border-red-800';
        }
        if (noticeBox) {
          noticeBox.className = 'p-4 rounded-2xl border bg-red-950/30 border-red-800/80 text-xs space-y-1';
        }
        if (noticeTag) {
          noticeTag.textContent = '⚠️ OVER-LIMITING THERMAL & SCALING ALARM';
          noticeTag.className = 'font-bold text-red-400';
        }
        if (noticeDesc) {
          noticeDesc.textContent = `Applied current density exceeds hydrodynamic boundary layer replenishment rate. Parasitic water dissociation at monopolar membranes risks irreversible scorching and scaling. Engage chilled cooling jacket and activate pulsed CIP immediately.`;
        }
      } else {
        if (overallStatusBadge) {
          overallStatusBadge.textContent = 'OPTIMAL EDBM';
          overallStatusBadge.className = 'px-2.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-emerald-950 text-emerald-300 border border-emerald-800';
        }
        if (noticeBox) {
          noticeBox.className = 'p-4 rounded-2xl border bg-emerald-950/20 border-emerald-800/60 text-xs space-y-1';
        }
        if (noticeTag) {
          noticeTag.textContent = '✓ 3-A SANITARY COMPLIANT';
          noticeTag.className = 'font-bold text-emerald-300';
        }
        if (noticeDesc) {
          noticeDesc.textContent = `All fluid channels, bipolar membrane seals, and inter-membrane gaskets comply with 3-A Sanitary Standard 45-03. Continuous zero-gypsum circular valorization operating at ${sec.toFixed(2)} kWh/kg.`;
        }
      }

      // SVG Live Updates
      if (svgAcidTiter) svgAcidTiter.textContent = `HL: ${targetAcid.toFixed(0)} g/L (${(acidYield * 100).toFixed(0)}%)`;
      if (svgFeedStatus) svgFeedStatus.textContent = `${flow.toLocaleString()} L/h | ${temp.toFixed(0)}°C`;
      if (svgBaseTiter) svgBaseTiter.textContent = `${causticMolarity.toFixed(2)} M Alkali`;
    }

    // Attach Event Listeners
    [skidSelect, matrixSelect, currentDensitySlider, tempSlider, feedFlowSlider, targetAcidSlider, chilledJacketToggle, pulsedCipToggle].forEach(el => {
      if (el) {
        el.addEventListener('input', calculateTelemetry);
        el.addEventListener('change', calculateTelemetry);
      }
    });

    // Preset Handlers
    if (btnLactic) {
      btnLactic.addEventListener('click', () => {
        if (skidSelect) skidSelect.value = '0';
        if (matrixSelect) matrixSelect.value = '0';
        if (currentDensitySlider) currentDensitySlider.value = '350';
        if (tempSlider) tempSlider.value = '14';
        if (feedFlowSlider) feedFlowSlider.value = '3200';
        if (targetAcidSlider) targetAcidSlider.value = '95';
        if (chilledJacketToggle) chilledJacketToggle.checked = true;
        if (pulsedCipToggle) pulsedCipToggle.checked = true;
        calculateTelemetry();
      });
    }

    if (btnCitric) {
      btnCitric.addEventListener('click', () => {
        if (skidSelect) skidSelect.value = '0';
        if (matrixSelect) matrixSelect.value = '1';
        if (currentDensitySlider) currentDensitySlider.value = '400';
        if (tempSlider) tempSlider.value = '16';
        if (feedFlowSlider) feedFlowSlider.value = '2800';
        if (targetAcidSlider) targetAcidSlider.value = '115';
        if (chilledJacketToggle) chilledJacketToggle.checked = true;
        if (pulsedCipToggle) pulsedCipToggle.checked = true;
        calculateTelemetry();
      });
    }

    if (btnTartaric) {
      btnTartaric.addEventListener('click', () => {
        if (skidSelect) skidSelect.value = '1';
        if (matrixSelect) matrixSelect.value = '2';
        if (currentDensitySlider) currentDensitySlider.value = '300';
        if (tempSlider) tempSlider.value = '12';
        if (feedFlowSlider) feedFlowSlider.value = '2400';
        if (targetAcidSlider) targetAcidSlider.value = '75';
        if (chilledJacketToggle) chilledJacketToggle.checked = true;
        if (pulsedCipToggle) pulsedCipToggle.checked = false;
        calculateTelemetry();
      });
    }

    if (btnFermentation) {
      btnFermentation.addEventListener('click', () => {
        if (skidSelect) skidSelect.value = '0';
        if (matrixSelect) matrixSelect.value = '3';
        if (currentDensitySlider) currentDensitySlider.value = '450';
        if (tempSlider) tempSlider.value = '18';
        if (feedFlowSlider) feedFlowSlider.value = '3600';
        if (targetAcidSlider) targetAcidSlider.value = '135';
        if (chilledJacketToggle) chilledJacketToggle.checked = true;
        if (pulsedCipToggle) pulsedCipToggle.checked = true;
        calculateTelemetry();
      });
    }

    if (btnHazard) {
      btnHazard.addEventListener('click', () => {
        if (skidSelect) skidSelect.value = '0';
        if (matrixSelect) matrixSelect.value = '0';
        if (currentDensitySlider) currentDensitySlider.value = '620';
        if (tempSlider) tempSlider.value = '42';
        if (feedFlowSlider) feedFlowSlider.value = '1100';
        if (targetAcidSlider) targetAcidSlider.value = '150';
        if (chilledJacketToggle) chilledJacketToggle.checked = false;
        if (pulsedCipToggle) pulsedCipToggle.checked = false;
        calculateTelemetry();
      });
    }

    // Initial Run
    calculateTelemetry();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initEdbmModeler);
  } else {
    initEdbmModeler();
  }
</script>