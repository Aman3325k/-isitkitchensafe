    systemHelp: "商業用3室式 EDBM スキッド（BPM-AEM-CEM）、2室式カチオンバイポーラ装置、2室式アニオンバイポーラ抽出機、またはパイロット研究試験機を選択。",
    matrixLabel: "供給有機塩廃液マトリクス:",
    matrixHelp: "ギリシャヨーグルト酸性ホエー透過液、柑橘果汁果皮洗浄液、ワイン澱酒石酸塩抽出液、中和乳清発酵ブロス、またはコハク酸発酵液を選択。",
    currentDensityLabel: "印加運転電流密度 (i):",
    currentDensityHelp: "バイポーラ膜およびイオン交換膜の有効面に垂直に流れる直流電流密度（100〜650 A/m²）。",
    tempLabel: "制御スタック運転温度 (T_op):",
    tempHelp: "膜濃縮ループの受託制御温度（8℃〜50℃）。低温運転により有機高分子膜の熱劣化および加水分解を防止。",
    flowLabel: "連続供給流量 (Q_feed):",
    flowHelp: "膜間スペーサー流路を通過する原液供給液の体積流量（500〜5,000 L/h）。",
    targetAcidLabel: "目標遊離有機酸回収濃度 (g/L):",
    targetAcidHelp: "酸循環ループで生成される遊離・非解離有機酸の目標最終製品濃度（20〜180 g/L）。",
    chilledJacketLabel: "段間サニタリー低温グリコール冷却ジャケット:",
    chilledJacketHelp: "2℃〜6℃の向流グリコール冷却ジャケットを作動させ、オーム性ジュール熱を吸収して膜の長寿命化を実現。",
    pulsedCipLabel: "極性反転パルス通電防汚 CIP シーケンス:",
    pulsedCipHelp: "周期的逆パルス電場と自動スケール洗浄を併用し、コロイド状タンパク質被膜を瞬時に分解して Ca(OH)2 結垢を防止。",
    presetsTitle: "高効率商業運転プリセット",
    presetLactic: "ギリシャヨーグルト酸性ホエー循環型乳酸回収＆苛性ソーダ併産（350 A/m², 14℃, 3200 L/h, 3室システム）",
    presetCitric: "柑橘加工廃液高濃度クエン酸＆バイオ肥料 KOH 併産（400 A/m², 16℃, 2800 L/h, 3室システム）",
    presetTartaric: "ワイン澱・搾りかす洗浄液酒石酸回収＆脱塩脱カリウム（300 A/m², 12℃, 2400 L/h, 2室システム）",
    presetFermentation: "工業発酵石膏フリー完全循環型酸抽出＆苛性アルカリ還流（450 A/m², 18℃, 3600 L/h, 3室システム）",
    presetHazard: "危険アラート：限界電流密度超過・重度スケーリング膜焼損（620 A/m², 42℃, 冷却停止, CIP停止）",
    diagnosticTitle: "EDBM 電気化学水流束＆循環型経済物理テレメトリ",
    diagnosticSub: "遊離酸抽出収率、ファラデー電流効率、単位製品比エネルギー消費量、副生苛性アルカリ濃度、および石膏廃棄物削減量をリアルタイム計算。",
    acidYieldLabel: "遊離有機酸抽出収率 (Y_acid):",
    currentEfficiencyLabel: "ファラデー有効電流効率 (η_current):",
    secLabel: "製品あたり比エネルギー消費量 (SEC):",
    causticLabel: "原位併産食品グレードアルカリ (NaOH/KOH):",
    demineralizationLabel: "ミネラル灰分脱塩・脱イオン率 (R_demin):",
    gypsumAvoidedLabel: "完全削減石膏固形産業廃棄物量:",
    limitingMarginLabel: "限界電流密度安全マージン (Δi_lim):",
    overallStatusLabel: "プロセス適合性＆衛生安全分類:",
    diagramTitle: "商業用連続式3室型バイポーラ膜電気透析（EDBM）イオン移動系統図",
    diagramSub: "バイポーラ界面触媒水分解（H+/OH-）、AEM を透過するカルボン酸アニオン移動、CEM を透過する陽イオン移動、および完全循環型副産物ループを表示。",
    scienceTitle: "科学的原理：バイポーラ界面触媒的水解離機構と石膏フリー酸性化",
    scienceSub: "バイポーラ膜ナノ触媒層における水解離物理学、限界電流密度閾値計算法、石膏廃棄物全廃の化学量論的根拠、および 3-A サニタリー規格 45-03 適合性を解析。",
    tableTitle: "連続 EDBM と従来型硫酸沈殿法、通常電気透析、およびイオン交換樹脂法の比較"
  }
};

const d = DICT[lang] || DICT.en;
---

<div class="space-y-10 my-8" id="edbm-acid-recovery-root">
  <!-- Header Card -->
  <div class="p-8 rounded-3xl bg-surface-soft border border-hairline shadow-sm">
    <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
      <span class="inline-block px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-indigo-950 text-indigo-200 border border-indigo-800">
        {d.badge}
      </span>
      <span class="text-xs text-muted font-mono">
        3-A Sanitary 45-03 &bull; EHEDG Class I &bull; FDA 21 CFR § 178.3297 &bull; Zero Gypsum Waste
      </span>
    </div>
    <h1 class="text-title-xl font-bold text-ink tracking-tight mb-3">
      {d.title}
    </h1>
    <p class="text-body text-base max-w-4xl text-muted leading-relaxed">
      {d.subtitle}
    </p>
  </div>

  <!-- Presets Bar -->
  <div class="p-6 rounded-2xl bg-surface-soft border border-hairline space-y-4">
    <div class="flex items-center justify-between">
      <h2 class="text-sm font-semibold text-ink uppercase tracking-wider">
        {d.presetsTitle}
      </h2>
      <span class="text-xs text-muted font-mono">1-Click Automated Industrial Calibration</span>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
      <button 
        type="button" 
        id="btn-preset-lactic"
        class="text-left p-3.5 rounded-xl border border-hairline bg-surface hover:border-indigo-500/50 hover:bg-indigo-950/20 transition-all text-xs space-y-1.5 cursor-pointer"
      >
        <div class="font-bold text-ink flex items-center justify-between">
          <span>🧀 Greek Yogurt Lactic</span>
          <span class="text-[10px] px-1.5 py-0.5 rounded bg-indigo-900/40 text-indigo-300 font-mono">350 A/m²</span>
        </div>
        <p class="text-muted leading-tight line-clamp-2">
          {d.presetLactic}
        </p>
      </button>

      <button 
        type="button" 
        id="btn-preset-citric"
        class="text-left p-3.5 rounded-xl border border-hairline bg-surface hover:border-amber-500/50 hover:bg-amber-950/20 transition-all text-xs space-y-1.5 cursor-pointer"
      >
        <div class="font-bold text-ink flex items-center justify-between">
          <span>🍊 Citrus Peel Citric</span>
          <span class="text-[10px] px-1.5 py-0.5 rounded bg-amber-900/40 text-amber-300 font-mono">400 A/m²</span>
        </div>
        <p class="text-muted leading-tight line-clamp-2">
          {d.presetCitric}
        </p>
      </button>

      <button 
        type="button" 
        id="btn-preset-tartaric"
        class="text-left p-3.5 rounded-xl border border-hairline bg-surface hover:border-rose-500/50 hover:bg-rose-950/20 transition-all text-xs space-y-1.5 cursor-pointer"
      >
        <div class="font-bold text-ink flex items-center justify-between">
          <span>🍇 Wine Lees Tartaric</span>
          <span class="text-[10px] px-1.5 py-0.5 rounded bg-rose-900/40 text-rose-300 font-mono">300 A/m²</span>
        </div>
        <p class="text-muted leading-tight line-clamp-2">
          {d.presetTartaric}
        </p>
      </button>

      <button 
        type="button" 
        id="btn-preset-fermentation"
        class="text-left p-3.5 rounded-xl border border-hairline bg-surface hover:border-emerald-500/50 hover:bg-emerald-950/20 transition-all text-xs space-y-1.5 cursor-pointer"
      >
        <div class="font-bold text-ink flex items-center justify-between">
          <span>🔄 Closed-Loop Caustic</span>
          <span class="text-[10px] px-1.5 py-0.5 rounded bg-emerald-900/40 text-emerald-300 font-mono">450 A/m²</span>
        </div>
        <p class="text-muted leading-tight line-clamp-2">
          {d.presetFermentation}
        </p>
      </button>

      <button 
        type="button" 
        id="btn-preset-hazard"
        class="text-left p-3.5 rounded-xl border border-hairline bg-surface hover:border-red-500/50 hover:bg-red-950/20 transition-all text-xs space-y-1.5 cursor-pointer sm:col-span-2 lg:col-span-1"
      >
        <div class="font-bold text-red-400 flex items-center justify-between">
          <span>⚠️ Over-Limiting Hazard</span>
          <span class="text-[10px] px-1.5 py-0.5 rounded bg-red-900/40 text-red-300 font-mono">620 A/m²</span>
        </div>
        <p class="text-muted leading-tight line-clamp-2">
          {d.presetHazard}
        </p>
      </button>
    </div>
  </div>

  <!-- Interactive Controls & Live Telemetry Layout -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Controls (7 cols) -->
    <div class="lg:col-span-7 p-7 rounded-3xl bg-surface-soft border border-hairline space-y-6 shadow-sm">
      <div class="border-b border-hairline/60 pb-4">
        <h2 class="text-title-md font-bold text-ink">
          {d.controlsTitle}
        </h2>
        <p class="text-xs text-muted mt-1 leading-relaxed">
          {d.controlsSub}
        </p>
      </div>

      <!-- Skid Select -->
      <div class="space-y-1.5">
        <label for="edbm-skid-select" class="block text-xs font-semibold text-ink">
          {d.systemLabel}
        </label>
        <select 
          id="edbm-skid-select"
          class="w-full bg-surface border border-hairline rounded-xl px-3 py-2.5 text-xs text-ink focus:outline-none focus:border-indigo-500"
        >
          {edbmData.membraneSystems.map((sys, idx) => (
            <option value={idx}>{sys.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted leading-tight">
          {d.systemHelp}
        </p>
      </div>

      <!-- Feed Matrix Select -->
      <div class="space-y-1.5">
        <label for="edbm-matrix-select" class="block text-xs font-semibold text-ink">
          {d.matrixLabel}
        </label>
        <select 
          id="edbm-matrix-select"
          class="w-full bg-surface border border-hairline rounded-xl px-3 py-2.5 text-xs text-ink focus:outline-none focus:border-indigo-500"
        >
          {edbmData.feedEffluentMatrices.map((mat, idx) => (
            <option value={idx}>{mat.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted leading-tight">
          {d.matrixHelp}
        </p>
      </div>

      <!-- Sliders Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 pt-2">
        <!-- Current Density Slider -->
        <div class="space-y-2">
          <div class="flex items-center justify-between text-xs">
            <label for="current-density-slider" class="font-semibold text-ink">
              {d.currentDensityLabel}
            </label>
            <span id="current-density-val" class="font-mono font-bold text-indigo-400 bg-surface px-2 py-0.5 rounded border border-hairline">
              350 A/m²
            </span>
          </div>
          <input 
            type="range" 
            id="current-density-slider" 
            min="100" 
            max="650" 
            step="10" 
            value="350"
            class="w-full accent-indigo-500 cursor-pointer"
          />
          <p class="text-[11px] text-muted">
            {d.currentDensityHelp}
          </p>
        </div>

        <!-- Temperature Slider -->
        <div class="space-y-2">
          <div class="flex items-center justify-between text-xs">
            <label for="temp-slider" class="font-semibold text-ink">
              {d.tempLabel}
            </label>
            <span id="temp-val" class="font-mono font-bold text-teal-400 bg-surface px-2 py-0.5 rounded border border-hairline">
              14°C
            </span>
          </div>
          <input 
            type="range" 
            id="temp-slider" 
            min="8" 
            max="50" 
            step="1" 
            value="14"
            class="w-full accent-teal-500 cursor-pointer"
          />
          <p class="text-[11px] text-muted">
            {d.tempHelp}
          </p>
        </div>

        <!-- Feed Flow Rate Slider -->
        <div class="space-y-2">
          <div class="flex items-center justify-between text-xs">
            <label for="feed-flow-slider" class="font-semibold text-ink">
              {d.flowLabel}
            </label>
            <span id="feed-flow-val" class="font-mono font-bold text-indigo-400 bg-surface px-2 py-0.5 rounded border border-hairline">
              3,200 L/h
            </span>
          </div>
          <input 
            type="range" 
            id="feed-flow-slider" 
            min="500" 
            max="5000" 
            step="100" 
            value="3200"
            class="w-full accent-indigo-500 cursor-pointer"
          />
          <p class="text-[11px] text-muted">
            {d.flowHelp}
          </p>
        </div>

        <!-- Target Free Acid Slider -->
        <div class="space-y-2">
          <div class="flex items-center justify-between text-xs">
            <label for="target-acid-slider" class="font-semibold text-ink">
              {d.targetAcidLabel}
            </label>
            <span id="target-acid-val" class="font-mono font-bold text-amber-400 bg-surface px-2 py-0.5 rounded border border-hairline">
              95 g/L
            </span>
          </div>
          <input 
            type="range" 
            id="target-acid-slider" 
            min="20" 
            max="180" 
            step="5" 
            value="95"
            class="w-full accent-amber-500 cursor-pointer"
          />
          <p class="text-[11px] text-muted">
            {d.targetAcidHelp}
          </p>
        </div>
      </div>

      <!-- Toggles Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-3 border-t border-hairline/60">
        <!-- Chilled Jacket Toggle -->
        <div class="flex items-start gap-3 p-3.5 rounded-xl bg-surface border border-hairline">
          <input 
            type="checkbox" 
            id="chilled-jacket-toggle" 
            checked 
            class="mt-1 h-4 w-4 rounded border-hairline text-indigo-600 focus:ring-indigo-500 cursor-pointer"
          />
          <div class="space-y-0.5">
            <label for="chilled-jacket-toggle" class="text-xs font-semibold text-ink cursor-pointer">
              {d.chilledJacketLabel}
            </label>
            <p class="text-[11px] text-muted leading-tight">
              {d.chilledJacketHelp}
            </p>
          </div>
        </div>

        <!-- Pulsed CIP Toggle -->
        <div class="flex items-start gap-3 p-3.5 rounded-xl bg-surface border border-hairline">
          <input 
            type="checkbox" 
            id="pulsed-cip-toggle" 
            checked 
            class="mt-1 h-4 w-4 rounded border-hairline text-indigo-600 focus:ring-indigo-500 cursor-pointer"
          />
          <div class="space-y-0.5">
            <label for="pulsed-cip-toggle" class="text-xs font-semibold text-ink cursor-pointer">
              {d.pulsedCipLabel}
            </label>
            <p class="text-[11px] text-muted leading-tight">
              {d.pulsedCipHelp}
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Live Telemetry & Metrics (5 cols) -->
    <div class="lg:col-span-5 space-y-6">
      <div class="p-7 rounded-3xl bg-surface-soft border border-hairline space-y-5 shadow-sm">
        <div class="border-b border-hairline/60 pb-3 flex items-center justify-between">
          <div>
            <h2 class="text-title-md font-bold text-ink">
              {d.diagnosticTitle}
            </h2>
            <p class="text-xs text-muted mt-0.5">
              {d.diagnosticSub}
            </p>
          </div>
          <span id="overall-status-badge" class="px-2.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-emerald-950 text-emerald-300 border border-emerald-800">
            OPTIMAL EDBM
          </span>
        </div>

        <!-- Telemetry Cards Grid -->
        <div class="grid grid-cols-2 gap-3.5">
          <!-- Acid Yield -->
          <div class="p-3.5 rounded-2xl bg-surface border border-hairline space-y-1">
            <span class="text-[11px] text-muted block leading-tight">{d.acidYieldLabel}</span>
            <span id="metric-acid-yield" class="text-lg font-mono font-bold text-indigo-400">92.4%</span>
            <div class="w-full bg-surface-soft h-1.5 rounded-full overflow-hidden">
              <div id="bar-acid-yield" class="bg-indigo-500 h-full rounded-full" style="width: 92.4%"></div>
            </div>
          </div>

          <!-- Current Efficiency -->
          <div class="p-3.5 rounded-2xl bg-surface border border-hairline space-y-1">
            <span class="text-[11px] text-muted block leading-tight">{d.currentEfficiencyLabel}</span>
            <span id="metric-current-efficiency" class="text-lg font-mono font-bold text-teal-400">84.8%</span>
            <div class="w-full bg-surface-soft h-1.5 rounded-full overflow-hidden">
              <div id="bar-current-eff" class="bg-teal-500 h-full rounded-full" style="width: 84.8%"></div>
            </div>
          </div>

          <!-- SEC -->
          <div class="p-3.5 rounded-2xl bg-surface border border-hairline space-y-1">
            <span class="text-[11px] text-muted block leading-tight">{d.secLabel}</span>
            <span id="metric-sec" class="text-lg font-mono font-bold text-emerald-400">1.62 kWh/kg</span>
            <span class="text-[10px] text-muted block">Benchmark: 1.4–2.2</span>
          </div>

          <!-- Regenerated Caustic -->
          <div class="p-3.5 rounded-2xl bg-surface border border-hairline space-y-1">
            <span class="text-[11px] text-muted block leading-tight">{d.causticLabel}</span>
            <span id="metric-caustic" class="text-lg font-mono font-bold text-cyan-400">2.15 M NaOH</span>
            <span class="text-[10px] text-cyan-300/80 block">Circular Caustic Coproduct</span>
          </div>

          <!-- Demineralization Rate -->
          <div class="p-3.5 rounded-2xl bg-surface border border-hairline space-y-1">
            <span class="text-[11px] text-muted block leading-tight">{d.demineralizationLabel}</span>
            <span id="metric-demineralization" class="text-lg font-mono font-bold text-indigo-300">89.4% Ash</span>
            <span class="text-[10px] text-muted block">Demineralized Sugar Stream</span>
          </div>

          <!-- Gypsum Waste Avoided -->
          <div class="p-3.5 rounded-2xl bg-surface border border-hairline space-y-1">
            <span class="text-[11px] text-muted block leading-tight">{d.gypsumAvoidedLabel}</span>
            <span id="metric-gypsum-avoided" class="text-lg font-mono font-bold text-emerald-300">1.42 kg/kg</span>
            <span class="text-[10px] text-emerald-400/80 block">Zero CaSO4 Hazardous Waste</span>
          </div>
        </div>

        <!-- Limiting Current Density Safety Margin Card -->
        <div class="p-4 rounded-2xl bg-surface border border-hairline space-y-2">
          <div class="flex items-center justify-between text-xs">
            <span class="font-semibold text-ink">{d.limitingMarginLabel}</span>
            <span id="metric-limiting-margin" class="font-mono font-bold text-emerald-400">+142 A/m² Margin</span>
          </div>
          <div class="w-full bg-surface-soft h-2 rounded-full overflow-hidden">
            <div id="bar-limiting-margin" class="bg-emerald-500 h-full rounded-full transition-all duration-300" style="width: 72%"></div>
          </div>
          <p id="limiting-warning-txt" class="text-[11px] text-muted leading-tight">
            Operating safely below the limiting current density threshold (i &lt; i_lim). Zero water splitting at monopolar membranes.
          </p>
        </div>

        <!-- Compliance Banner Box -->
        <div id="diagnostic-notice-box" class="p-4 rounded-2xl border bg-emerald-950/20 border-emerald-800/60 text-xs space-y-1">
          <div class="flex items-center gap-2">
            <span id="notice-tag" class="font-bold text-emerald-300">✓ 3-A SANITARY COMPLIANT</span>
            <span class="text-muted font-mono text-[10px]">3-A Standard 45-03 &bull; EHEDG Class I</span>
          </div>
          <p id="notice-desc" class="text-muted leading-relaxed">
            All fluid channels, bipolar membrane seals, and inter-membrane gaskets comply with sanitary food-contact standards. Reversible-polarity pulsed CIP maintains clean surfaces without chemical degradation.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Interactive SVG Schematic Diagram -->
  <div class="p-8 rounded-3xl bg-surface-soft border border-hairline shadow-sm space-y-4">
    <div>
      <h2 class="text-title-md font-bold text-ink">
        {d.diagramTitle}
      </h2>
      <p class="text-xs text-muted mt-1 leading-relaxed">
        {d.diagramSub}
      </p>
    </div>

    <div class="w-full overflow-x-auto py-2">
      <svg viewBox="0 0 960 480" class="w-full min-w-[760px] h-auto select-none" xmlns="http://www.w3.org/2000/svg">
        <!-- Definitions -->
        <defs>
          <linearGradient id="gradAcid" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#818cf8" stop-opacity="0.3"/>
            <stop offset="100%" stop-color="#4f46e5" stop-opacity="0.7"/>
          </linearGradient>
          <linearGradient id="gradBase" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.3"/>
            <stop offset="100%" stop-color="#0284c7" stop-opacity="0.7"/>
          </linearGradient>
