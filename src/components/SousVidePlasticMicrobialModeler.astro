    statusBotulismHazard: "致命的危険：ボツリヌス神経毒素 産生危険ゾーン",
    statusPlasticRupture: "致命的危険：袋の熱破損・可塑剤大量溶出リスク",
    botulismAlertTitle: "⚠️ 嫌気性ボツリヌス神経毒素 増殖警告",
    botulismAlertText: "空気が抜かれた真空パック内で食材が4.4℃〜52.2℃（40°F〜126°F）に2時間以上置かれると、非タンパク分解性ボツリヌス菌芽胞が発芽し、致死性の神経毒素を生成する重大な危険があります。54.4℃（130°F）以上で調理するか、直ちに完食してください。",
    plasticAlertTitle: "⚠️ 耐熱温度超過・袋の破裂および化学溶出警告",
    plasticAlertText: "設定水温が使用する袋の耐熱限界を超えています。ポリエチレンの圧着シールが軟化・破損し、スリップ剤（エルカ酸アミド）や可塑剤、マイクロプラスチックが肉汁に大量溶出します。",
    lagLabel: "食材中心部への熱伝導遅延時間",
    coreHoldLabel: "中心部殺菌に必要な保温時間",
    minTimeLabel: "推奨される最低調理時間",
    selectedTimeLabel: "設定した合計調理時間",
    microbialTitle: "微生物殺菌分析",
    listeriaReductionLabel: "リステリア菌死滅（6D基準）",
    botulismInhibitionLabel: "ボツリヌス菌毒素・芽胞抑制",
    plasticTitle: "プラスチック劣化・化学溶出評価",
    pouchSafetyScoreLabel: "袋素材の食品衛生安全性スコア",
    microplasticYieldLabel: "マイクロプラスチック溶出量（推計）",
    plasticizerMigrationLabel: "可塑剤・添加剤の溶出度",
    lipidExtractionLabel: "油脂による親脂性溶出加速率",
    guideTitle: "公式認定・安全な低温調理袋ガイド",
    guideSub: "第三者機関で検証された安全な袋の選択肢：",
    chillingRuleTitle: "米FDA直伝・氷水急冷（アイスバス）ルール",
    chillingRuleText: "調理後すぐに食べない場合、ボツリヌス菌の増殖を防ぐため、2時間以内に50%氷水で中心温度を5℃以下まで急冷してから冷蔵庫（3.3℃以下、7日以内）または冷凍庫に保存してください。",
    copyReportBtn: "📋 低温調理安全監査レポートをコピー",
    reportCopied: "✓ 安全診断レポートをクリップボードにコピーしました！",
    crossLinkTitle: "関連する安全性・素材診断ツール：",
    crossLinkOil: "食用油の発煙点＆有害アルデヒド計算ツール",
    crossLinkMigration: "食品接触化学物質 移行予測モデル",
    crossLinkScorecard: "調理器具の有害物質溶出＆PFASリスク評価",
    crossLinkPlasticizer: "マイクロプラスチック血液負担計算機",
    crossLinkHazard: "キッチン危険緊急トリアージ"
  }
};

const d = DICT[lang] || DICT.en;
const prefix = lang === 'en' ? '' : `/${lang}`;
---

<div class="sous-vide-modeler-widget space-y-8" data-lang={lang}>
  <!-- Main Header Banner -->
  <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-indigo-950 via-slate-900 to-cyan-950 p-6 md:p-10 text-white shadow-xl border border-cyan-500/20">
    <div class="absolute -right-10 -bottom-10 w-72 h-72 rounded-full bg-cyan-500/10 blur-3xl pointer-events-none"></div>
    <div class="relative z-10 max-w-3xl space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-cyan-400/10 text-cyan-300 border border-cyan-400/20">
        <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
        {d.badge}
      </div>
      <h1 class="text-display-sm md:text-display-md font-bold tracking-tight text-white">
        {d.title}
      </h1>
      <p class="text-xs md:text-sm text-cyan-100/80 leading-relaxed max-w-2xl">
        {d.subtitle}
      </p>
    </div>
  </div>

  <!-- Interactive Simulator Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Left Column: Interactive Controls (5 cols) -->
    <div class="lg:col-span-5 bg-surface-soft border border-hairline rounded-2xl p-6 space-y-6 shadow-xs">
      <div>
        <h2 class="text-title-md font-bold text-ink tracking-tight flex items-center gap-2">
          <svg class="w-5 h-5 text-cyan-600 dark:text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
          </svg>
          {d.controlsTitle}
        </h2>
        <p class="text-xs text-muted leading-relaxed mt-1">
          {d.controlsSub}
        </p>
      </div>

      <!-- Quick Culinary Presets -->
      <div class="space-y-2">
        <span class="text-xs font-bold uppercase tracking-wider text-muted block">
          {d.presetsTitle}
        </span>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
          <button 
            type="button" 
            class="sous-vide-preset-btn p-2 rounded-xl border border-hairline bg-canvas hover:border-cyan-500 hover:bg-cyan-500/5 text-[11px] font-medium text-ink text-left transition-all"
            data-food="fatty-meat" 
            data-temp="135" 
            data-thick="1.5" 
            data-duration="150"
            data-pouch="nylon-pe-vacuum"
          >
            {d.presetSteak}
          </button>
          <button 
            type="button" 
            class="sous-vide-preset-btn p-2 rounded-xl border border-hairline bg-canvas hover:border-cyan-500 hover:bg-cyan-500/5 text-[11px] font-medium text-ink text-left transition-all"
            data-food="lean-poultry" 
            data-temp="145" 
            data-thick="1.0" 
            data-duration="90"
            data-pouch="nylon-pe-vacuum"
          >
            {d.presetChicken}
          </button>
          <button 
            type="button" 
            class="sous-vide-preset-btn p-2 rounded-xl border border-rose-500/30 bg-rose-500/5 hover:border-rose-500 text-[11px] font-medium text-rose-700 dark:text-rose-300 text-left transition-all"
            data-food="delicate-fish" 
            data-temp="118" 
            data-thick="1.0" 
            data-duration="40"
            data-pouch="platinum-silicone"
          >
            {d.presetSalmon}
          </button>
          <button 
            type="button" 
            class="sous-vide-preset-btn p-2 rounded-xl border border-hairline bg-canvas hover:border-cyan-500 hover:bg-cyan-500/5 text-[11px] font-medium text-ink text-left transition-all"
            data-food="tough-roast" 
            data-temp="135" 
            data-thick="2.0" 
            data-duration="2880"
            data-pouch="nylon-pe-vacuum"
          >
            {d.presetRibs}
          </button>
          <button 
            type="button" 
            class="sous-vide-preset-btn p-2 rounded-xl border border-hairline bg-canvas hover:border-cyan-500 hover:bg-cyan-500/5 text-[11px] font-medium text-ink text-left transition-all"
            data-food="vegetables-roots" 
            data-temp="183" 
            data-thick="0.75" 
            data-duration="60"
            data-pouch="platinum-silicone"
          >
            {d.presetCarrots}
          </button>
        </div>
      </div>

      <!-- Pouch Material Selector -->
      <div class="space-y-2">
        <label for="pouch-select" class="block text-xs font-bold uppercase tracking-wider text-ink">
          {d.pouchLabel}
        </label>
        <select 
          id="pouch-select" 
          class="w-full p-3 rounded-xl border border-hairline bg-canvas text-ink text-xs md:text-sm focus:ring-2 focus:ring-cyan-500 focus:outline-none transition-all"
        >
          {sousVideData.pouchMaterials.map(m => (
            <option value={m.id} selected={m.id === 'nylon-pe-vacuum'}>
              {m.name} ({m.safetyRating})
            </option>
          ))}
        </select>
        <p id="pouch-desc-text" class="text-[11px] text-muted leading-relaxed">
          {sousVideData.pouchMaterials.find(m => m.id === 'nylon-pe-vacuum')?.description}
        </p>
      </div>

      <!-- Food Matrix Selector -->
      <div class="space-y-2">
        <label for="food-select" class="block text-xs font-bold uppercase tracking-wider text-ink">
          {d.foodLabel}
        </label>
        <select 
          id="food-select" 
          class="w-full p-3 rounded-xl border border-hairline bg-canvas text-ink text-xs md:text-sm focus:ring-2 focus:ring-cyan-500 focus:outline-none transition-all"
        >
          {sousVideData.foodMatrices.map(f => (
            <option value={f.id} selected={f.id === 'fatty-meat'}>
              {f.name} &bull; {f.fatPercent}% Fat ({f.lipophilicMultiplier}x lipid migration)
            </option>
          ))}
        </select>
      </div>

      <!-- Slab Thickness Slider -->
      <div class="space-y-2">
        <div class="flex items-center justify-between">
          <label for="thickness-slider" class="text-xs font-bold uppercase tracking-wider text-ink">
            {d.thicknessLabel}
          </label>
          <span class="text-xs md:text-sm font-black font-mono text-cyan-600 dark:text-cyan-400">
            <span id="thickness-in-display">1.5</span>" (<span id="thickness-mm-display">38</span> mm)
          </span>
        </div>
        <input 
          id="thickness-slider" 
          type="range" 
          min="0.5" 
          max="3.0" 
          step="0.25" 
          value="1.5"
          class="w-full accent-cyan-600 cursor-pointer h-2 bg-surface-strong rounded-lg"
        />
        <div class="flex justify-between text-[10px] text-muted font-mono">
          <span>0.5" (Thin Cutlet)</span>
          <span>1.5" (Standard Steak)</span>
          <span>3.0" (Thick Roast)</span>
        </div>
      </div>

      <!-- Water Bath Temperature Slider -->
      <div class="space-y-2">
        <div class="flex items-center justify-between">
          <label for="temp-slider" class="text-xs font-bold uppercase tracking-wider text-ink">
            {d.tempLabel}
          </label>
          <span class="text-xs md:text-sm font-black font-mono text-cyan-600 dark:text-cyan-400">
            <span id="temp-f-display">135</span>°F (<span id="temp-c-display">57</span>°C)
          </span>
        </div>
        <input 
          id="temp-slider" 
          type="range" 
          min="100" 
          max="195" 
          step="1" 
          value="135"
          class="w-full accent-cyan-600 cursor-pointer h-2 bg-surface-strong rounded-lg"
        />
        <!-- Temperature Safety Bands Bar -->
        <div class="grid grid-cols-4 text-center text-[9px] font-bold rounded-lg overflow-hidden border border-hairline py-0.5">
          <div class="bg-rose-500/20 text-rose-700 dark:text-rose-300 py-0.5" title="< 122°F: Severe Botulism Proliferation">
            &lt; 122°F Botulism
          </div>
          <div class="bg-amber-500/20 text-amber-700 dark:text-amber-300 py-0.5" title="123°F-129°F: Incomplete Inhibition">
            123-129°F Caution
          </div>
          <div class="bg-emerald-500/20 text-emerald-700 dark:text-emerald-300 py-0.5" title="130°F-165°F: Safe Pasteurization">
            130-165°F Safe
          </div>
          <div class="bg-blue-500/20 text-blue-700 dark:text-blue-300 py-0.5" title="166°F-195°F: High Heat Vegetable">
            &gt; 165°F High Heat
          </div>
        </div>
      </div>

      <!-- Duration Slider -->
      <div class="space-y-2">
        <div class="flex items-center justify-between">
          <label for="duration-slider" class="text-xs font-bold uppercase tracking-wider text-ink">
            {d.durationLabel}
          </label>
          <span class="text-xs md:text-sm font-black font-mono text-cyan-600 dark:text-cyan-400">
            <span id="duration-display">2.5</span> Hours (<span id="duration-min-display">150</span> min)
          </span>
        </div>
        <input 
          id="duration-slider" 
          type="range" 
          min="15" 
          max="2880" 
          step="15" 
          value="150"
          class="w-full accent-cyan-600 cursor-pointer h-2 bg-surface-strong rounded-lg"
        />
        <div class="flex justify-between text-[10px] text-muted font-mono">
          <span>15 min</span>
          <span>4 hrs</span>
          <span>24 hrs</span>
          <span>48 hrs</span>
        </div>
      </div>
    </div>

    <!-- Right Column: Diagnostic & Analytical Output (7 cols) -->
    <div class="lg:col-span-7 space-y-6">
      <div class="bg-surface-soft border border-hairline rounded-2xl p-6 md:p-8 space-y-6 shadow-xs">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-cyan-600 dark:text-cyan-400 block mb-1">
            Diagnostic Verification
          </span>
          <h2 class="text-title-lg font-bold text-ink tracking-tight">
            {d.diagnosticTitle}
          </h2>
          <p class="text-xs text-muted leading-relaxed mt-1">
            {d.diagnosticSub}
          </p>
        </div>

        <!-- Master Status Banner -->
        <div id="status-banner" class="rounded-2xl p-5 border transition-all space-y-2 bg-emerald-500/10 border-emerald-500/30 text-emerald-950 dark:text-emerald-200">
          <div class="flex items-center justify-between gap-2">
            <span id="status-badge" class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-600 text-white">
              SAFE
            </span>
            <span id="target-pathogen-tag" class="text-[11px] font-mono opacity-80">
              Target: Listeria 6D Pasteurization
            </span>
          </div>
          <div id="status-title-text" class="text-sm md:text-base font-bold">
            {d.statusPasteurized}
          </div>
          <p id="status-explanation-text" class="text-xs leading-relaxed opacity-90">
            Water bath temperature and duration exceed the minimum Baldwin thermal conduction threshold. Vegetative pathogen log-kill is complete.
          </p>
        </div>

        <!-- Botulism Hazard Alert Banner (hidden by default) -->
        <div id="botulism-alert" class="hidden rounded-xl p-4 bg-rose-500/10 border border-rose-500/40 text-rose-900 dark:text-rose-200 space-y-1">
          <div class="text-xs font-bold uppercase tracking-wide flex items-center gap-1.5 text-rose-700 dark:text-rose-300">
            <span>{d.botulismAlertTitle}</span>
          </div>
          <p class="text-xs leading-relaxed">
            {d.botulismAlertText}
          </p>
        </div>

        <!-- Plastic Rupture Alert Banner (hidden by default) -->
        <div id="plastic-alert" class="hidden rounded-xl p-4 bg-amber-500/10 border border-amber-500/40 text-amber-900 dark:text-amber-200 space-y-1">
          <div class="text-xs font-bold uppercase tracking-wide flex items-center gap-1.5 text-amber-700 dark:text-amber-300">
            <span>{d.plasticAlertTitle}</span>
          </div>
          <p class="text-xs leading-relaxed">
            {d.plasticAlertText}
          </p>
        </div>

        <!-- Conduction & Pasteurization Time Matrix -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-center">
          <div class="bg-canvas border border-hairline rounded-xl p-3.5 space-y-1">
            <span class="text-[10px] uppercase font-bold text-muted block">{d.lagLabel}</span>
            <div id="core-lag-val" class="text-base md:text-lg font-black font-mono text-cyan-600 dark:text-cyan-400">85 min</div>
            <span class="text-[9px] text-muted block">Core conduction</span>
          </div>
          <div class="bg-canvas border border-hairline rounded-xl p-3.5 space-y-1">
            <span class="text-[10px] uppercase font-bold text-muted block">{d.coreHoldLabel}</span>
            <div id="core-hold-val" class="text-base md:text-lg font-black font-mono text-cyan-600 dark:text-cyan-400">36 min</div>
            <span class="text-[9px] text-muted block">At bath temp</span>
          </div>
          <div class="bg-canvas border border-hairline rounded-xl p-3.5 space-y-1">
            <span class="text-[10px] uppercase font-bold text-muted block">{d.minTimeLabel}</span>
            <div id="min-time-val" class="text-base md:text-lg font-black font-mono text-emerald-600 dark:text-emerald-400">121 min</div>
            <span class="text-[9px] text-muted block">Lag + Hold</span>
          </div>
          <div class="bg-canvas border border-hairline rounded-xl p-3.5 space-y-1">
            <span class="text-[10px] uppercase font-bold text-muted block">{d.selectedTimeLabel}</span>
            <div id="selected-time-val" class="text-base md:text-lg font-black font-mono text-ink">150 min</div>
            <span id="time-adequacy-tag" class="text-[9px] font-bold text-emerald-600 block">ADEQUATE ✓</span>
          </div>
        </div>

        <!-- Analytical Gauges: Microbial & Plastic Leaching -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- Microbial Safety Block -->
          <div class="bg-canvas border border-hairline rounded-xl p-4 space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-ink">{d.microbialTitle}</span>
              <span id="microbial-badge" class="px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-emerald-500/10 text-emerald-600">PASS</span>
            </div>
            
            <div class="space-y-1">
              <div class="flex justify-between text-xs">
                <span class="text-muted">{d.listeriaReductionLabel}</span>
                <span id="listeria-log-val" class="font-bold font-mono text-emerald-600">&gt; 6.5 Log (Complete)</span>
              </div>
              <div class="w-full bg-surface-strong h-1.5 rounded-full overflow-hidden">
                <div id="listeria-bar" class="h-full bg-emerald-500 transition-all duration-300" style="width: 100%;"></div>
              </div>
            </div>

            <div class="space-y-1">
              <div class="flex justify-between text-xs">
                <span class="text-muted">{d.botulismInhibitionLabel}</span>
                <span id="botulism-status-val" class="font-bold font-mono text-emerald-600">100% Inhibited (&gt;=130°F)</span>
              </div>
              <div class="w-full bg-surface-strong h-1.5 rounded-full overflow-hidden">
                <div id="botulism-bar" class="h-full bg-emerald-500 transition-all duration-300" style="width: 100%;"></div>
              </div>
            </div>
          </div>

          <!-- Chemical Leaching Block -->
          <div class="bg-canvas border border-hairline rounded-xl p-4 space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-ink">{d.plasticTitle}</span>
              <span id="plastic-badge" class="px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-cyan-500/10 text-cyan-600">GRADE A</span>
            </div>

            <div class="space-y-1">
              <div class="flex justify-between text-xs">
                <span class="text-muted">{d.pouchSafetyScoreLabel}</span>
                <span id="pouch-score-val" class="font-bold font-mono text-ink">88 / 100</span>
              </div>
              <div class="w-full bg-surface-strong h-1.5 rounded-full overflow-hidden">
                <div id="pouch-score-bar" class="h-full bg-cyan-500 transition-all duration-300" style="width: 88%;"></div>
              </div>
            </div>

            <div class="space-y-1">
              <div class="flex justify-between text-xs">
                <span class="text-muted">{d.microplasticYieldLabel}</span>
                <span id="microplastic-val" class="font-bold font-mono text-ink">18 particles/cm²</span>
              </div>
              <div class="w-full bg-surface-strong h-1.5 rounded-full overflow-hidden">
                <div id="microplastic-bar" class="h-full bg-emerald-500 transition-all duration-300" style="width: 15%;"></div>
              </div>
            </div>

            <div class="pt-1 flex items-center justify-between text-[11px] border-t border-hairline/60">
              <span class="text-muted">{d.lipidExtractionLabel}</span>
              <span id="lipid-multiplier-val" class="font-mono font-bold text-ink">3.8x (Fat-Soluble Additives)</span>
            </div>
          </div>
        </div>

        <!-- FDA Cook-Chill Rule Box -->
        <div class="bg-cyan-500/5 border border-cyan-500/20 rounded-xl p-4 space-y-1">
          <div class="text-xs font-bold text-cyan-800 dark:text-cyan-300 flex items-center gap-1.5">
            <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>{d.chillingRuleTitle}</span>
          </div>
          <p class="text-xs text-body leading-relaxed">
            {d.chillingRuleText}
          </p>
        </div>

        <!-- Copy Audit Button -->
        <button 
          id="copy-audit-btn" 
          type="button" 
          class="w-full py-3 px-4 rounded-xl bg-ink text-canvas hover:opacity-90 font-medium text-xs md:text-sm transition-all shadow-xs flex items-center justify-center gap-2"
        >
          {d.copyReportBtn}
        </button>
      </div>
    </div>
  </div>

  <!-- Certified Safe Pouches & Containers Guide -->
  <div class="bg-surface-soft border border-hairline rounded-2xl p-6 md:p-8 space-y-6">
    <div class="space-y-1">
      <span class="text-xs font-bold uppercase tracking-wider text-cyan-600 dark:text-cyan-400 block">
        Polymer Safety Standards
      </span>
      <h3 class="text-title-md font-bold text-ink">
        {d.guideTitle}
      </h3>
      <p class="text-xs md:text-sm text-body leading-relaxed">
        {d.guideSub}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="bg-canvas border border-emerald-500/30 rounded-xl p-5 space-y-2">
        <span class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-emerald-500/10 text-emerald-600">
          Gold Standard (0% Plastic)
        </span>
        <h4 class="font-bold text-ink text-sm">Platinum Silicone (Stasher)</h4>
        <p class="text-xs text-body leading-relaxed">
          100% pure silica and platinum cure. Free from phthalates, BPA, BPS, and microplastics. Rated to 425°F (218°C) with endless dishwasher reuse.
        </p>
      </div>

      <div class="bg-canvas border border-blue-500/30 rounded-xl p-5 space-y-2">
        <span class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-blue-500/10 text-blue-600">
          Commercial Standard
        </span>
        <h4 class="font-bold text-ink text-sm">Nylon/PE Vacuum Pouches (FoodSaver)</h4>
        <p class="text-xs text-body leading-relaxed">
          Co-extruded virgin polyethylene inner liner with heavy-duty polyamide nylon outer barrier. Certified BPA-free and puncture resistant up to 195°F.
        </p>
      </div>

      <div class="bg-canvas border border-amber-500/30 rounded-xl p-5 space-y-2">
        <span class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-amber-500/10 text-amber-600">
          Low-Temp Alternative
        </span>
        <h4 class="font-bold text-ink text-sm">Heavy Freezer Zipper Bags (&lt; 155°F)</h4>
        <p class="text-xs text-body leading-relaxed">
          Branded freezer bags (Ziploc) using water displacement. Safe for low temperatures, but avoid temperatures over 155°F to prevent seam softening and microplastic shedding.
        </p>
      </div>
    </div>
  </div>

  <!-- Companion Tools Navigation -->
  <div class="border-t border-hairline pt-8 space-y-4">
    <h4 class="text-xs font-bold uppercase tracking-wider text-muted">
      {d.crossLinkTitle}
    </h4>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
      <a href={`${prefix}/tools/culinary-oil-smoke-point-simulator/`} class="p-3.5 rounded-xl border border-hairline bg-surface-soft hover:border-cyan-500/50 hover:bg-canvas transition-all text-xs font-medium text-ink flex items-center justify-between">
        <span>{d.crossLinkOil}</span>
        <span class="text-muted">&rarr;</span>
      </a>
      <a href={`${prefix}/tools/food-contact-migration-predictor/`} class="p-3.5 rounded-xl border border-hairline bg-surface-soft hover:border-cyan-500/50 hover:bg-canvas transition-all text-xs font-medium text-ink flex items-center justify-between">
        <span>{d.crossLinkMigration}</span>
        <span class="text-muted">&rarr;</span>
      </a>
      <a href={`${prefix}/tools/toxic-leaching-scorecard/`} class="p-3.5 rounded-xl border border-hairline bg-surface-soft hover:border-cyan-500/50 hover:bg-canvas transition-all text-xs font-medium text-ink flex items-center justify-between">
        <span>{d.crossLinkScorecard}</span>
        <span class="text-muted">&rarr;</span>
      </a>
      <a href={`${prefix}/tools/plasticizer-microplastic-burden-estimator/`} class="p-3.5 rounded-xl border border-hairline bg-surface-soft hover:border-cyan-500/50 hover:bg-canvas transition-all text-xs font-medium text-ink flex items-center justify-between">
        <span>{d.crossLinkPlasticizer}</span>
        <span class="text-muted">&rarr;</span>
      </a>
      <a href={`${prefix}/tools/kitchen-hazard-emergency-triage/`} class="p-3.5 rounded-xl border border-hairline bg-surface-soft hover:border-cyan-500/50 hover:bg-canvas transition-all text-xs font-medium text-ink flex items-center justify-between">
        <span>{d.crossLinkHazard}</span>
        <span class="text-muted">&rarr;</span>
      </a>
    </div>
  </div>
</div>

<script define:vars={{ sousVideData, d }}>
  document.addEventListener('DOMContentLoaded', () => {
    const root = document.querySelector('.sous-vide-modeler-widget');
    if (!root) return;

    const pouchSelect = root.querySelector('#pouch-select');
    const foodSelect = root.querySelector('#food-select');
    const thicknessSlider = root.querySelector('#thickness-slider');
    const tempSlider = root.querySelector('#temp-slider');
    const durationSlider = root.querySelector('#duration-slider');

    const thicknessInDisplay = root.querySelector('#thickness-in-display');
    const thicknessMmDisplay = root.querySelector('#thickness-mm-display');
    const tempFDisplay = root.querySelector('#temp-f-display');
    const tempCDisplay = root.querySelector('#temp-c-display');
    const durationDisplay = root.querySelector('#duration-display');
    const durationMinDisplay = root.querySelector('#duration-min-display');

    const pouchDescText = root.querySelector('#pouch-desc-text');
    const statusBanner = root.querySelector('#status-banner');
    const statusBadge = root.querySelector('#status-badge');
    const statusTitleText = root.querySelector('#status-title-text');
    const statusExplanationText = root.querySelector('#status-explanation-text');
    const targetPathogenTag = root.querySelector('#target-pathogen-tag');

    const botulismAlert = root.querySelector('#botulism-alert');
    const plasticAlert = root.querySelector('#plastic-alert');

    const coreLagVal = root.querySelector('#core-lag-val');
    const coreHoldVal = root.querySelector('#core-hold-val');
    const minTimeVal = root.querySelector('#min-time-val');
    const selectedTimeVal = root.querySelector('#selected-time-val');
    const timeAdequacyTag = root.querySelector('#time-adequacy-tag');

    const microbialBadge = root.querySelector('#microbial-badge');
    const listeriaLogVal = root.querySelector('#listeria-log-val');
    const listeriaBar = root.querySelector('#listeria-bar');
    const botulismStatusVal = root.querySelector('#botulism-status-val');
    const botulismBar = root.querySelector('#botulism-bar');

    const plasticBadge = root.querySelector('#plastic-badge');
    const pouchScoreVal = root.querySelector('#pouch-score-val');
    const pouchScoreBar = root.querySelector('#pouch-score-bar');
    const microplasticVal = root.querySelector('#microplastic-val');
    const microplasticBar = root.querySelector('#microplastic-bar');
    const lipidMultiplierVal = root.querySelector('#lipid-multiplier-val');

    const copyAuditBtn = root.querySelector('#copy-audit-btn');
    const presetBtns = root.querySelectorAll('.sous-vide-preset-btn');

    // Preset button handlers
    presetBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const food = btn.getAttribute('data-food');
        const temp = btn.getAttribute('data-temp');
        const thick = btn.getAttribute('data-thick');
        const duration = btn.getAttribute('data-duration');
        const pouch = btn.getAttribute('data-pouch');

        if (food) foodSelect.value = food;
        if (temp) tempSlider.value = temp;
        if (thick) thicknessSlider.value = thick;
        if (duration) durationSlider.value = duration;
        if (pouch) pouchSelect.value = pouch;

        presetBtns.forEach(b => b.classList.remove('border-cyan-500', 'bg-cyan-500/10'));
        btn.classList.add('border-cyan-500', 'bg-cyan-500/10');

        recalculate();
      });
    });

    [pouchSelect, foodSelect, thicknessSlider, tempSlider, durationSlider].forEach(el => {
      el.addEventListener('input', recalculate);
      el.addEventListener('change', recalculate);
    });

    function recalculate() {
      const pouchId = pouchSelect.value;
      const pouch = sousVideData.pouchMaterials.find(m => m.id === pouchId) || sousVideData.pouchMaterials[0];
      const foodId = foodSelect.value;
      const food = sousVideData.foodMatrices.find(f => f.id === foodId) || sousVideData.foodMatrices[0];

      const thicknessIn = parseFloat(thicknessSlider.value);
      const thicknessMm = Math.round(thicknessIn * 25.4);
      const tempF = parseInt(tempSlider.value, 10);
      const tempC = Math.round((tempF - 32) * 5 / 9);
      const durationMin = parseInt(durationSlider.value, 10);
      const durationHours = (durationMin / 60).toFixed(1);

      // Update slider value displays
      thicknessInDisplay.textContent = thicknessIn.toFixed(2);
      thicknessMmDisplay.textContent = thicknessMm;
      tempFDisplay.textContent = tempF;
      tempCDisplay.textContent = tempC;
      durationDisplay.textContent = durationHours;
      durationMinDisplay.textContent = durationMin;
      pouchDescText.textContent = pouch.description;

      // 1. Thermal conduction core lag (Baldwin approximation: lag proportional to thickness squared)
      // T_lag ≈ 45 min for 1.0 inch; 85 min for 1.5 inch; 140 min for 2.0 inch
      let lagMinutes = Math.round(45 * Math.pow(thicknessIn, 1.65));
      coreLagVal.textContent = `${lagMinutes} min`;

      // 2. Pasteurization Hold Time at Core
      let requiredCoreHoldMin = 0;
      let targetPathogenName = "Listeria monocytogenes (6D reduction)";

      if (tempF < 130) {
        // Below 130°F: No true thermal pasteurization is possible for Listeria or Botulinum
        requiredCoreHoldMin = 999;
        targetPathogenName = "Clostridium botulinum (Anaerobic Neurotoxin Risk)";
      } else {
        // Baldwin / FSIS pasteurization equation: log10(t) = a - b * T
        // At 130°F -> 112 min; 135°F -> 36 min; 140°F -> 11.5 min; 145°F -> 3.7 min; 150°F -> 1.2 min
        const zValue = 12.5; // z-value in °F
        requiredCoreHoldMin = Math.max(0.5, Math.round(112 * Math.pow(10, -(tempF - 130) / zValue) * 10) / 10);
        if (food.id === 'lean-poultry') {
          // Salmonella requires slightly longer hold
          requiredCoreHoldMin = Math.round(requiredCoreHoldMin * 1.5 * 10) / 10;
          targetPathogenName = "Salmonella spp. (7D reduction for poultry)";
        }
      }

      if (requiredCoreHoldMin > 500) {
        coreHoldVal.textContent = "N/A (<130°F)";
      } else {
        coreHoldVal.textContent = `${requiredCoreHoldMin} min`;
      }
      targetPathogenTag.textContent = `Target: ${targetPathogenName}`;

      // 3. Minimum recommended total cooking time
      const minRecommendedTotalMin = tempF < 130 ? lagMinutes + 30 : Math.round(lagMinutes + requiredCoreHoldMin);
      minTimeVal.textContent = `${minRecommendedTotalMin} min`;
      selectedTimeVal.textContent = `${durationMin} min`;

      const isTimeAdequate = durationMin >= minRecommendedTotalMin;

      if (isTimeAdequate) {
        timeAdequacyTag.textContent = "ADEQUATE ✓";
        timeAdequacyTag.className = "text-[9px] font-bold text-emerald-600 block";
      } else {
        timeAdequacyTag.textContent = "UNDERCOOKED ✗";
        timeAdequacyTag.className = "text-[9px] font-bold text-rose-600 animate-pulse block";
      }

      // 4. Alerts & Status Determination
      const isBotulismDanger = (tempF < 130 && durationMin > 120);
      const isLowTempPalatability = (tempF < 130 && durationMin <= 120);
      const isPouchOverheated = (tempF > pouch.maxSafeTempF);

      if (isBotulismDanger) {
        botulismAlert.classList.remove('hidden');
      } else {
        botulismAlert.classList.add('hidden');
      }

      if (isPouchOverheated) {
        plasticAlert.classList.remove('hidden');
      } else {
        plasticAlert.classList.add('hidden');
      }

      // 5. Update Status Banner
      if (isPouchOverheated) {
        statusBanner.className = 'rounded-2xl p-5 border transition-all space-y-2 bg-rose-500/10 border-rose-500/40 text-rose-950 dark:text-rose-200';
        statusBadge.textContent = 'CRITICAL HAZARD';
        statusBadge.className = 'px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-rose-600 text-white';
        statusTitleText.textContent = d.statusPlasticRupture;
        statusExplanationText.textContent = `Pouch thermal limit (${pouch.maxSafeTempF}°F) exceeded. Polyethylene seams soften, risking structural failure and high polymer chemical migration into food lipids.`;
      } else if (isBotulismDanger) {
        statusBanner.className = 'rounded-2xl p-5 border transition-all space-y-2 bg-rose-500/10 border-rose-500/40 text-rose-950 dark:text-rose-200';
        statusBadge.textContent = 'DANGER';
        statusBadge.className = 'px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-rose-600 text-white';
        statusTitleText.textContent = d.statusBotulismHazard;
        statusExplanationText.textContent = d.botulismAlertText;
      } else if (isLowTempPalatability) {
        statusBanner.className = 'rounded-2xl p-5 border transition-all space-y-2 bg-amber-500/10 border-amber-500/40 text-amber-950 dark:text-amber-200';
        statusBadge.textContent = 'CAUTION';
        statusBadge.className = 'px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-600 text-white';
        statusTitleText.textContent = d.statusPalatabilityCaution;
        statusExplanationText.textContent = "Cooking below 130°F (54.4°C) tenderizes meat/fish without pasteurization. Food must be consumed immediately within 2 hours. NEVER chill, store, or serve to immunocompromised individuals.";
      } else if (isTimeAdequate) {
        statusBanner.className = 'rounded-2xl p-5 border transition-all space-y-2 bg-emerald-500/10 border-emerald-500/40 text-emerald-950 dark:text-emerald-200';
        statusBadge.textContent = 'SAFE';
        statusBadge.className = 'px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-600 text-white';
        statusTitleText.textContent = d.statusPasteurized;
        statusExplanationText.textContent = `Water bath temperature (${tempF}°F) and duration (${durationHours}h) fully satisfy Baldwin thermal conduction and USDA-FSIS pasteurization lethality standards for 6D Listeria elimination.`;
      } else {
        statusBanner.className = 'rounded-2xl p-5 border transition-all space-y-2 bg-amber-500/10 border-amber-500/40 text-amber-950 dark:text-amber-200';
        statusBadge.textContent = 'INCOMPLETE';
        statusBadge.className = 'px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-600 text-white';
        statusTitleText.textContent = 'INSUFFICIENT COOKING TIME FOR FULL PASTEURIZATION';
        statusExplanationText.textContent = `The thermal cold spot at center requires ${minRecommendedTotalMin} minutes to achieve full pathogen lethality. Current time (${durationMin} min) is too short.`;
      }

      // 6. Microbial Gauge Bars
      if (tempF >= 130 && isTimeAdequate) {
        microbialBadge.textContent = 'PASS (6D+)';
        microbialBadge.className = 'px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-emerald-500/10 text-emerald-600';
        listeriaLogVal.textContent = '> 6.5 Log (Pasteurized)';
        listeriaLogVal.className = 'font-bold font-mono text-emerald-600';
        listeriaBar.style.width = '100%';
        listeriaBar.className = 'h-full bg-emerald-500 transition-all duration-300';

        botulismStatusVal.textContent = '100% Inhibited (>=130°F)';
        botulismStatusVal.className = 'font-bold font-mono text-emerald-600';
        botulismBar.style.width = '100%';
        botulismBar.className = 'h-full bg-emerald-500 transition-all duration-300';
      } else if (tempF >= 130) {
        microbialBadge.textContent = 'PARTIAL';
        microbialBadge.className = 'px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-amber-500/10 text-amber-600';
        listeriaLogVal.textContent = '3.0 - 4.5 Log (Partial)';
        listeriaLogVal.className = 'font-bold font-mono text-amber-600';
        listeriaBar.style.width = '60%';
        listeriaBar.className = 'h-full bg-amber-500 transition-all duration-300';

        botulismStatusVal.textContent = 'Multiplication Stopped';
        botulismStatusVal.className = 'font-bold font-mono text-emerald-600';
        botulismBar.style.width = '100%';
        botulismBar.className = 'h-full bg-emerald-500 transition-all duration-300';
      } else {
        microbialBadge.textContent = isBotulismDanger ? 'CRITICAL' : 'UNPASTEURIZED';
        microbialBadge.className = isBotulismDanger ? 'px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-rose-500/10 text-rose-600' : 'px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-amber-500/10 text-amber-600';
        listeriaLogVal.textContent = '0 Log (Active Growth Zone)';
        listeriaLogVal.className = 'font-bold font-mono text-rose-600';
        listeriaBar.style.width = '15%';
        listeriaBar.className = 'h-full bg-rose-500 transition-all duration-300';

        if (isBotulismDanger) {
          botulismStatusVal.textContent = 'CRITICAL TOXIN HAZARD';
          botulismStatusVal.className = 'font-bold font-mono text-rose-600 animate-pulse';
          botulismBar.style.width = '5%';
          botulismBar.className = 'h-full bg-rose-600 transition-all duration-300';
        } else {
          botulismStatusVal.textContent = 'Window < 2h (Caution)';
          botulismStatusVal.className = 'font-bold font-mono text-amber-600';
          botulismBar.style.width = '45%';
          botulismBar.className = 'h-full bg-amber-500 transition-all duration-300';
        }
      }

      // 7. Polymer Leaching Calculations
      const baseSafetyScore = pouch.safetyScore;
      let adjustedScore = baseSafetyScore;
      if (tempF > pouch.maxSafeTempF) {
        adjustedScore = Math.max(5, adjustedScore - 40);
      } else if (tempF > 165 && pouch.id.includes('ldpe')) {
        adjustedScore = Math.max(10, adjustedScore - 25);
      }

      pouchScoreVal.textContent = `${adjustedScore} / 100`;
      pouchScoreBar.style.width = `${adjustedScore}%`;
      if (adjustedScore >= 80) {
        plasticBadge.textContent = 'GRADE A';
        plasticBadge.className = 'px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-emerald-500/10 text-emerald-600';
        pouchScoreBar.className = 'h-full bg-emerald-500 transition-all duration-300';
      } else if (adjustedScore >= 50) {
        plasticBadge.textContent = 'GRADE C';
        plasticBadge.className = 'px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-amber-500/10 text-amber-600';
        pouchScoreBar.className = 'h-full bg-amber-500 transition-all duration-300';
      } else {
        plasticBadge.textContent = 'CRITICAL';
        plasticBadge.className = 'px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-rose-500/10 text-rose-600';
        pouchScoreBar.className = 'h-full bg-rose-600 transition-all duration-300';
      }

      // Microplastic Shedding Estimate
      let microplasticParticles = 0;
      if (pouch.id === 'platinum-silicone') {
        microplasticParticles = 0;
      } else if (pouch.id === 'pvc-stretch-wrap') {
        microplasticParticles = Math.round(350 + (tempF - 100) * 4);
      } else if (pouch.id.includes('thin')) {
        microplasticParticles = Math.round(150 + (tempF - 100) * 3);
      } else if (pouch.id.includes('ldpe')) {
        microplasticParticles = Math.round(20 + (tempF > 140 ? (tempF - 140) * 2.5 : 5));
      } else {
        // High quality PA/PE vacuum pouch
        microplasticParticles = Math.round(8 + (durationMin / 180) * 6);
      }

      microplasticVal.textContent = `${microplasticParticles} particles/cm²`;
      const microplasticPercent = Math.min(100, Math.round((microplasticParticles / 200) * 100));
      microplasticBar.style.width = `${microplasticPercent}%`;
      microplasticBar.className = microplasticParticles < 30 ? 'h-full bg-emerald-500' : (microplasticParticles < 100 ? 'h-full bg-amber-500' : 'h-full bg-rose-600');

      lipidMultiplierVal.textContent = `${food.lipophilicMultiplier}x (Fat extraction acceleration)`;
    }

    // Copy audit report
    copyAuditBtn.addEventListener('click', () => {
      const pouch = sousVideData.pouchMaterials.find(m => m.id === pouchSelect.value);
      const food = sousVideData.foodMatrices.find(f => f.id === foodSelect.value);
      const thickness = thicknessSlider.value;
      const tempF = tempSlider.value;
      const durationHours = (durationSlider.value / 60).toFixed(1);

      const reportText = [
        "===========================================================",
        "SOUS VIDE BIOLOGICAL & POLYMER SAFETY AUDIT REPORT",
        "Generated via IsItKitchenSafe Science Laboratory",
        "===========================================================",
        `Water Bath Temperature: ${tempF}°F (${Math.round((tempF - 32) * 5 / 9)}°C)`,
        `Food Item: ${food.name}`,
        `Slab Thickness: ${thickness} inches (${Math.round(thickness * 25.4)} mm)`,
        `Total Immersion Duration: ${durationHours} hours (${durationSlider.value} min)`,
        `Pouch Material: ${pouch.name}`,
        `Thermal Cold Spot Lag: ${coreLagVal.textContent}`,
        `Required Pasteurization Hold: ${coreHoldVal.textContent}`,
        `Minimum Required Total Cooking Time: ${minTimeVal.textContent}`,
        `Microbiological Status: ${statusTitleText.textContent}`,
        `Pathogen Lethality: ${listeriaLogVal.textContent}`,
        `Botulinum Status: ${botulismStatusVal.textContent}`,
        `Pouch Safety Score: ${pouchScoreVal.textContent}`,
        `Estimated Microplastic Yield: ${microplasticVal.textContent}`,
        "-----------------------------------------------------------",
        "FDA Food Code § 3-502.12 Cook-Chill Standard:",
        "If not serving immediately, chill from 130°F to < 41°F within 2 hours in a 50% ice-water bath.",
        "==========================================================="
      ].join('\n');

      navigator.clipboard.writeText(reportText).then(() => {
        const originalText = copyAuditBtn.textContent;
        copyAuditBtn.textContent = d.reportCopied;
        copyAuditBtn.classList.add('bg-emerald-700', 'text-white');
        setTimeout(() => {
          copyAuditBtn.textContent = originalText;
          copyAuditBtn.classList.remove('bg-emerald-700', 'text-white');
        }, 2500);
      }).catch(err => {
        console.error('Failed to copy audit report', err);
      });
    });

    // Run initial calculation
    recalculate();
  });
</script>
