          <text x="37.5" y="60" fill="#cbd5e1" font-size="8" font-family="monospace" text-anchor="middle">Heated Orifice</text>
          <!-- Closed Loop Return to CO2 tank -->
          <path d="M 75 37.5 L 120 37.5 L 120 270 L -610 270 L -610 160 L -580 160" stroke="#10b981" stroke-width="2" stroke-dasharray="5,5" fill="none" />
          <text x="80" y="262" fill="#10b981" font-size="8" font-family="monospace" text-anchor="middle">95% CO2 Closed-Loop Recovery</text>
        </g>
