    feedstockHelp: "ヘマトコッカス藻粗オレオレジン、南極オキアミリン脂質複合体、ファフィア赤色酵母抽出物、有機溶剤抽出危険項目を選択。",
    packingLabel: "塔内規則充填物設計：",
    packingHelp: "Sulzer EX ワイヤーガーゼ規則充填物（>1,200 m²/m³）、Sulzer DX コルゲート金属板、または磁器製ラシヒリングを選択。",
    feedRateLabel: "連続供給質量流量 (F_feed)：",
    feedRateHelp: "充填塔上中部の導入ノズルへ送液される粗オレオレジンの質量流量（1.0〜120.0 kg/h）。",
    pressureLabel: "分留塔分離圧力 (P_column)：",
    pressureHelp: "向流多段充填塔内に維持される超高圧油圧圧力（150〜380 bar）。",
    tempLabel: "分留塔操作温度 (T_column)：",
    tempHelp: "超臨界CO2密度および逆溶解度転移領域を制御する塔内温度（35〜75°C）。",
    sfRatioLabel: "溶媒/原料質量比 (S/F)：",
    sfRatioHelp: "上昇超臨界CO2流体と下降液膜オレオレジンの質量流速比（10〜60 kg CO2 / kg 原料）。",
    entrainerLabel: "エタノール同伴剤添加濃度 (C_etoh)：",
    entrainerHelp: "極性を調整し遊離アスタキサンチン抽出を加速する無水エタノール濃度（0.0〜5.0% w/w）。",
    presetsTitle: "産業用クイック設定プリセット：",
    presetAlgae: "ヘマトコッカス藻天然アスタキサンチンオレオレジン（260 bar、48°C、S/F 35、純度96.5%、オールトランス>95%、溶剤ゼロ）",
    presetKrill: "南極オキアミリン脂質・カロテノイド精留（240 bar、42°C、S/F 45、中性脂肪完全分離、94.2%回収率）",
    presetPharma: "医薬グレード超高純度オールトランス (3S,3'S) フラクション（310 bar、55°C、1.5% EtOH、純度99.2%、USP <467> 適合）",
    presetBiorefinery: "微細藻類バイオリファイナリー閉ループ連続運転（220 bar、45°C、S/F 30、CO2回収率95%、1.15 kWh/kg）",
    presetHazard: "従来の化学溶剤高温浸出劣悪物（危険：120 bar、85°C、ヘキサン残留350 ppm、シス体熱劣化45%）",
    telemetryTitle: "リアルタイム超臨界分留テレメトリー＆熱力学レーダー",
    telemetrySub: "アスタキサンチンエステル純度、オールトランス異性体保持率、流体密度、残留溶剤を連続監視。",
    purityLabel: "アスタキサンチン純度：",
    transRetentionLabel: "オールトランス (3S,3'S) 保持率：",
    tagDepletionLabel: "中性トリグリセリド脱除率：",
    ffaSeparationLabel: "遊離脂肪酸分離率：",
    densityLabel: "超臨界 CO2 流体密度：",
    solventResidueLabel: "残留溶剤量 (USP <467>)：",
    energyLabel: "製品単位比消費エネルギー：",
    asmeSafetyLabel: "ASME VIII 圧力容器安全係数：",
    complianceVerdictLabel: "衛生規格＆FDA FSMA適合状況：",
    diagramTitle: "連続 scCO2-FAP 多段向流プロセスフロー模式図",
    diagramSub: "液化CO2昇圧プランジャーポンプ、予熱器、内部還流冷却器付き規則充填塔、2段サイクロン分離器、自動背圧弁 (BPR)。",
    chartTitle: "アスタキサンチン純度 vs. 超臨界操作圧力熱力学曲線",
    chartSub: "各等温線（40°C、50°C、60°C）における逆溶解度屈曲点および現在稼働状態プロット。",
    scienceTitle: "超臨界流体抽出とカロテノイドクロマトグラフィー物理学",
    scienceSub: "Chrastil 密度依存型溶解度モデル、向流分配係数、および非熱無酸素オールトランス異性体保護機構。",
    tableTitle: "サニタリーエンジニアリング、材料金属学および規制基準",
    exportAuditBtn: "検証監査証明書のエクスポート (PDF / JSON)"
  }
};

const d = DICT[lang] || DICT.en;
---

<div id="scco2-fap-modeler-root" class="bg-surface border border-hairline rounded-2xl p-6 lg:p-8 shadow-xs my-8" data-lang={lang}>
  <!-- Header Banner -->
  <div class="border-b border-hairline/80 pb-6 mb-8">
    <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-rose-950 text-rose-300 border border-rose-800 font-mono">
        <svg class="w-3.5 h-3.5 text-rose-400 animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
        </svg>
        {d.badge}
      </span>
      <span class="text-xs text-muted font-mono bg-surface-soft px-3 py-1 rounded-md border border-hairline">
        scCO2-FAP &bull; 180&ndash;350 bar &bull; 40&ndash;65&deg;C &bull; &gt;96% Pure &bull; FDA 21 CFR 73.35 &bull; ASME VIII
      </span>
    </div>
    <h1 class="text-2xl lg:text-3xl font-black text-ink tracking-tight mb-2">
      {d.title}
    </h1>
    <p class="text-sm lg:text-base text-body leading-relaxed max-w-4xl">
      {d.subtitle}
    </p>
  </div>

  <!-- Presets Strip -->
  <div class="mb-8 p-4 bg-surface-soft border border-hairline rounded-xl">
    <div class="text-xs font-bold uppercase tracking-wider text-muted mb-3 font-mono">
      ⚡ {d.presetsTitle}
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-2 text-xs">
      <button type="button" class="preset-btn text-left p-2.5 rounded-lg border border-hairline/70 hover:border-rose-600 bg-surface hover:bg-rose-950/20 text-ink transition" data-preset="algae">
        <span class="font-bold text-rose-400 block mb-0.5">🌿 Haematococcus Algal Astaxanthin</span>
        <span class="text-muted text-[11px] block leading-tight">{d.presetAlgae}</span>
      </button>
      <button type="button" class="preset-btn text-left p-2.5 rounded-lg border border-hairline/70 hover:border-amber-600 bg-surface hover:bg-amber-950/20 text-ink transition" data-preset="krill">
        <span class="font-bold text-amber-400 block mb-0.5">🦐 Antarctic Krill Refinement</span>
        <span class="text-muted text-[11px] block leading-tight">{d.presetKrill}</span>
      </button>
      <button type="button" class="preset-btn text-left p-2.5 rounded-lg border border-hairline/70 hover:border-cyan-600 bg-surface hover:bg-cyan-950/20 text-ink transition" data-preset="pharma">
        <span class="font-bold text-cyan-400 block mb-0.5">💊 Pharma Ultra-Pure All-Trans Monomer</span>
        <span class="text-muted text-[11px] block leading-tight">{d.presetPharma}</span>
      </button>
      <button type="button" class="preset-btn text-left p-2.5 rounded-lg border border-hairline/70 hover:border-emerald-600 bg-surface hover:bg-emerald-950/20 text-ink transition" data-preset="biorefinery">
        <span class="font-bold text-emerald-400 block mb-0.5">🔄 Closed-Loop Microalgae Biorefinery</span>
        <span class="text-muted text-[11px] block leading-tight">{d.presetBiorefinery}</span>
      </button>
      <button type="button" class="preset-btn text-left p-2.5 rounded-lg border border-rose-800/80 hover:border-rose-600 bg-rose-950/20 hover:bg-rose-950/40 text-rose-200 transition md:col-span-2 lg:col-span-2" data-preset="hazard">
        <span class="font-bold text-rose-400 block mb-0.5">⚠️ Conventional Chemical Hexane Extraction (CRITICAL HAZARD)</span>
        <span class="text-rose-300/80 text-[11px] block leading-tight">{d.presetHazard}</span>
      </button>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-10">
    <!-- Controls Column (5 cols) -->
    <div class="lg:col-span-5 space-y-6">
      <div class="border border-hairline rounded-xl p-5 bg-surface-soft">
        <h2 class="text-base font-bold text-ink mb-1 flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-rose-500"></span>
          {d.controlsTitle}
        </h2>
        <p class="text-xs text-muted mb-4">{d.controlsSub}</p>

        <div class="space-y-4 text-xs">
          <!-- Skid Selection -->
          <div>
            <label for="skid-select" class="block font-medium text-ink mb-1">{d.skidLabel}</label>
            <select id="skid-select" class="w-full bg-surface border border-hairline rounded-lg px-3 py-2 text-ink text-xs focus:outline-none focus:border-rose-500">
              {scco2FapData.systemArchitectures.map((skid) => (
                <option value={skid.id}>{skid.name}</option>
              ))}
            </select>
            <span class="text-[11px] text-muted block mt-1">{d.skidHelp}</span>
          </div>

          <!-- Feedstock Profile Selection -->
          <div>
            <label for="feedstock-select" class="block font-medium text-ink mb-1">{d.feedstockLabel}</label>
            <select id="feedstock-select" class="w-full bg-surface border border-hairline rounded-lg px-3 py-2 text-ink text-xs focus:outline-none focus:border-rose-500">
              {scco2FapData.feedstocks.map((feed) => (
                <option value={feed.id}>{feed.name}</option>
              ))}
            </select>
            <span class="text-[11px] text-muted block mt-1">{d.feedstockHelp}</span>
          </div>

          <!-- Column Packing Geometry -->
          <div>
            <label for="packing-select" class="block font-medium text-ink mb-1">{d.packingLabel}</label>
            <select id="packing-select" class="w-full bg-surface border border-hairline rounded-lg px-3 py-2 text-ink text-xs focus:outline-none focus:border-rose-500">
              {scco2FapData.columnPackingDesigns.map((pack) => (
                <option value={pack.id}>{pack.name}</option>
              ))}
            </select>
            <span class="text-[11px] text-muted block mt-1">{d.packingHelp}</span>
          </div>

          <!-- Feed Rate Slider -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label for="feed-rate-slider" class="font-medium text-ink">{d.feedRateLabel}</label>
              <span id="feed-rate-val" class="font-mono font-bold text-rose-400">25.0 kg/h</span>
            </div>
            <input type="range" id="feed-rate-slider" min="1" max="120" step="1" value="25" class="w-full accent-rose-500 h-1.5 bg-surface rounded-lg cursor-pointer" />
            <span class="text-[11px] text-muted block mt-1">{d.feedRateHelp}</span>
          </div>

          <!-- Pressure Slider -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label for="pressure-slider" class="font-medium text-ink">{d.pressureLabel}</label>
              <span id="pressure-val" class="font-mono font-bold text-rose-400">260 bar</span>
            </div>
            <input type="range" id="pressure-slider" min="150" max="380" step="5" value="260" class="w-full accent-rose-500 h-1.5 bg-surface rounded-lg cursor-pointer" />
            <span class="text-[11px] text-muted block mt-1">{d.pressureHelp}</span>
          </div>

          <!-- Temperature Slider -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label for="temp-slider" class="font-medium text-ink">{d.tempLabel}</label>
              <span id="temp-val" class="font-mono font-bold text-amber-400">48&deg;C</span>
            </div>
            <input type="range" id="temp-slider" min="35" max="75" step="1" value="48" class="w-full accent-amber-500 h-1.5 bg-surface rounded-lg cursor-pointer" />
            <span class="text-[11px] text-muted block mt-1">{d.tempHelp}</span>
          </div>

          <!-- Solvent-to-Feed Ratio Slider -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label for="sf-slider" class="font-medium text-ink">{d.sfRatioLabel}</label>
              <span id="sf-val" class="font-mono font-bold text-cyan-400">35.0 S/F</span>
            </div>
            <input type="range" id="sf-slider" min="10" max="60" step="1" value="35" class="w-full accent-cyan-500 h-1.5 bg-surface rounded-lg cursor-pointer" />
            <span class="text-[11px] text-muted block mt-1">{d.sfRatioHelp}</span>
          </div>

          <!-- Co-Solvent Entrainer Slider -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label for="entrainer-slider" class="font-medium text-ink">{d.entrainerLabel}</label>
              <span id="entrainer-val" class="font-mono font-bold text-emerald-400">0.0% EtOH</span>
            </div>
            <input type="range" id="entrainer-slider" min="0.0" max="5.0" step="0.5" value="0.0" class="w-full accent-emerald-500 h-1.5 bg-surface rounded-lg cursor-pointer" />
            <span class="text-[11px] text-muted block mt-1">{d.entrainerHelp}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Telemetry & Process Column (7 cols) -->
    <div class="lg:col-span-7 space-y-6">
      <!-- Live Metrics Radar Grid -->
      <div class="border border-hairline rounded-xl p-5 bg-surface-soft">
        <div class="flex items-center justify-between mb-4">
          <div>
            <h2 class="text-base font-bold text-ink flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-ping"></span>
              {d.telemetryTitle}
            </h2>
            <p class="text-xs text-muted">{d.telemetrySub}</p>
          </div>
          <span id="status-pill" class="px-2.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-emerald-950 text-emerald-300 border border-emerald-800 font-mono">
            FDA § 73.35 / USP PASS
          </span>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mb-4">
          <!-- Astaxanthin Purity -->
          <div class="p-3 rounded-lg bg-surface border border-hairline">
            <span class="text-[11px] text-muted block font-medium">{d.purityLabel}</span>
            <div class="flex items-baseline gap-1 mt-1">
              <span id="purity-metric" class="text-2xl font-black font-mono text-rose-400">96.5%</span>
            </div>
            <span id="purity-sub" class="text-[10px] text-emerald-400 font-mono block mt-1">FDA High Purity Standard</span>
          </div>

          <!-- All-Trans Retention -->
          <div class="p-3 rounded-lg bg-surface border border-hairline">
            <span class="text-[11px] text-muted block font-medium">{d.transRetentionLabel}</span>
            <div class="flex items-baseline gap-1 mt-1">
              <span id="trans-metric" class="text-2xl font-black font-mono text-emerald-400">95.8%</span>
            </div>
            <span id="trans-sub" class="text-[10px] text-emerald-400 font-mono block mt-1">Zero Cis Degradation</span>
          </div>

          <!-- Triglyceride Depletion -->
          <div class="p-3 rounded-lg bg-surface border border-hairline">
            <span class="text-[11px] text-muted block font-medium">{d.tagDepletionLabel}</span>
            <div class="flex items-baseline gap-1 mt-1">
              <span id="tag-metric" class="text-2xl font-black font-mono text-cyan-400">97.2%</span>
            </div>
            <span id="tag-sub" class="text-[10px] text-muted font-mono block mt-1">Overhead Light Extract</span>
          </div>

          <!-- Free Fatty Acid Separation -->
          <div class="p-3 rounded-lg bg-surface border border-hairline">
            <span class="text-[11px] text-muted block font-medium">{d.ffaSeparationLabel}</span>
            <div class="flex items-baseline gap-1 mt-1">
              <span id="ffa-metric" class="text-xl font-black font-mono text-indigo-300">98.4%</span>
            </div>
            <span id="ffa-sub" class="text-[10px] text-emerald-400 font-mono block mt-1">Deacidified Raffinate</span>
          </div>

          <!-- Fluid Density -->
          <div class="p-3 rounded-lg bg-surface border border-hairline">
            <span class="text-[11px] text-muted block font-medium">{d.densityLabel}</span>
            <div class="flex items-baseline gap-1 mt-1">
              <span id="density-metric" class="text-xl font-black font-mono text-amber-400">842</span>
              <span class="text-xs font-mono text-muted">kg/m³</span>
            </div>
            <span id="density-sub" class="text-[10px] text-muted font-mono block mt-1">Supercritical Liquid-Like</span>
          </div>

          <!-- Solvent Residue -->
          <div class="p-3 rounded-lg bg-surface border border-hairline">
            <span class="text-[11px] text-muted block font-medium">{d.solventResidueLabel}</span>
            <div class="flex items-baseline gap-1 mt-1">
              <span id="solvent-metric" class="text-xl font-black font-mono text-emerald-400">0.0</span>
              <span class="text-xs font-mono text-muted">ppm</span>
            </div>
            <span id="solvent-sub" class="text-[10px] text-emerald-400 font-mono block mt-1">USP Class 1/2 Undetectable</span>
          </div>
        </div>

        <div class="border-t border-hairline pt-3 space-y-2 text-xs">
          <div class="flex justify-between items-center">
            <span class="text-muted">{d.energyLabel}</span>
            <span id="sec-val" class="font-mono font-bold text-ink">1.42 kWh/kg product (68% utility savings via closed CO2 loop)</span>
          </div>
          <div class="flex justify-between items-center">
            <span class="text-muted">{d.asmeSafetyLabel}</span>
            <span id="asme-val" class="font-mono font-bold text-emerald-400">SF = 4.2 &ge; 4.0 (ASME BPVC VIII Div 1 & 2 Safe)</span>
          </div>
        </div>
      </div>

      <!-- Compliance Verdict Banner -->
      <div id="compliance-banner" class="p-4 rounded-xl border bg-emerald-950/40 border-emerald-800 text-xs text-emerald-200 flex items-start gap-3">
        <svg class="w-5 h-5 text-emerald-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <div>
          <span id="compliance-title" class="font-bold block text-sm text-emerald-300">COMPLIANT: FDA 21 CFR § 73.35 & USP &lt;467&gt; CLEAN-LABEL CERTIFIED</span>
          <span id="compliance-desc" class="text-muted block mt-0.5 leading-relaxed">
            The configured scCO2 counter-current fractionation process delivers &gt;96% pure all-trans (3S,3'S) astaxanthin mono- and di-esters with zero organic solvent residues (0.0 ppm vs. 290 ppm hexane ceiling), fully conforming to ASME BPVC Section VIII Division 1 &amp; 2 pressure codes and 3-A Sanitary Standards 60-01.
          </span>
        </div>
      </div>

      <!-- Export Action -->
      <div class="flex justify-end">
        <button type="button" id="export-audit-btn" class="px-4 py-2.5 rounded-xl bg-rose-700 hover:bg-rose-800 text-white font-medium text-xs transition shadow-xs flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          {d.exportAuditBtn}
        </button>
      </div>
    </div>
  </div>

  <!-- SVG Process Flow Schematic Section -->
  <section class="border border-hairline rounded-xl p-6 bg-surface-soft mb-10">
    <div class="mb-4">
      <h3 class="text-base font-bold text-ink">{d.diagramTitle}</h3>
      <p class="text-xs text-muted">{d.diagramSub}</p>
    </div>

    <div class="w-full overflow-x-auto bg-surface border border-hairline rounded-xl p-4">
      <svg class="w-full min-w-[720px] h-[300px]" viewBox="0 0 860 300" fill="none" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="scco2Grid" width="20" height="20" patternUnits="userSpaceOnUse">
            <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#334155" stroke-width="0.5" stroke-opacity="0.25" />
          </pattern>
          <linearGradient id="co2FlowGrad" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#38bdf8" />
            <stop offset="100%" stop-color="#0284c7" />
          </linearGradient>
          <linearGradient id="astaxGrad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#f43f5e" />
            <stop offset="100%" stop-color="#9f1239" />
          </linearGradient>
          <linearGradient id="columnGrad" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#1e293b" />
            <stop offset="50%" stop-color="#334155" />
            <stop offset="100%" stop-color="#1e293b" />
          </linearGradient>
        </defs>
        <rect width="860" height="300" fill="url(#scco2Grid)" rx="8" />

        <!-- 1. Liquid CO2 Tank & Chiller -->
        <g id="svg-co2-tank" transform="translate(30, 80)">
          <rect x="0" y="20" width="70" height="120" rx="10" fill="#0f172a" stroke="#0284c7" stroke-width="2" />
          <path d="M 5 60 Q 35 50 65 60 L 65 130 Q 35 135 5 130 Z" fill="#0284c7" fill-opacity="0.3" />
          <text x="35" y="45" fill="#94a3b8" font-size="9" font-family="monospace" text-anchor="middle">Liquid CO2</text>
