      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <h3 class="text-xs font-bold text-amber-600 dark:text-amber-400 mb-1.5">{d.rule1Title}</h3>
        <p class="text-xs text-body leading-relaxed">{d.rule1Text}</p>
      </div>
      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <h3 class="text-xs font-bold text-amber-600 dark:text-amber-400 mb-1.5">{d.rule2Title}</h3>
        <p class="text-xs text-body leading-relaxed">{d.rule2Text}</p>
      </div>
      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <h3 class="text-xs font-bold text-amber-600 dark:text-amber-400 mb-1.5">{d.rule3Title}</h3>
        <p class="text-xs text-body leading-relaxed">{d.rule3Text}</p>
      </div>
      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <h3 class="text-xs font-bold text-amber-600 dark:text-amber-400 mb-1.5">{d.rule4Title}</h3>
        <p class="text-xs text-body leading-relaxed">{d.rule4Text}</p>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ granulatorData }}>
(function() {
  // DOM Elements
  const selMachine = document.getElementById('select-machine');
  const selPowder = document.getElementById('select-powder');
  const selNozzleFilter = document.getElementById('select-nozzle-filter');

  const sAirflow = document.getElementById('slider-airflow');
  const sInletTemp = document.getElementById('slider-inlet-temp');
  const sSprayRate = document.getElementById('slider-spray-rate');
  const sAtomAir = document.getElementById('slider-atom-air');
  const sBedMoisture = document.getElementById('slider-bed-moisture');
  const sPulseInterval = document.getElementById('slider-pulse-interval');
  const sGroundResist = document.getElementById('slider-ground-resist');

  const valAirflow = document.getElementById('val-airflow');
  const valInletTemp = document.getElementById('val-inlet-temp');
  const valSprayRate = document.getElementById('val-spray-rate');
  const valAtomAir = document.getElementById('val-atom-air');
  const valBedMoisture = document.getElementById('val-bed-moisture');
  const valPulseInterval = document.getElementById('val-pulse-interval');
  const valGroundResist = document.getElementById('val-ground-resist');

  // Telemetry Outputs
  const teleFluidRatio = document.getElementById('tele-fluid-ratio');
  const teleFluidState = document.getElementById('tele-fluid-state');
  const teleDropletD32 = document.getElementById('tele-droplet-d32');
  const teleDropletState = document.getElementById('tele-droplet-state');
  const teleStokesNum = document.getElementById('tele-stokes-num');
  const teleStokesState = document.getElementById('tele-stokes-state');
  const teleEvapRate = document.getElementById('tele-evap-rate');
  const teleEvapState = document.getElementById('tele-evap-state');
  const teleExhaustRh = document.getElementById('tele-exhaust-rh');
  const teleExhaustState = document.getElementById('tele-exhaust-state');
  const teleFilterDp = document.getElementById('tele-filter-dp');
  const teleFilterState = document.getElementById('tele-filter-state');
  const teleStaticSpark = document.getElementById('tele-static-spark');
  const teleStaticState = document.getElementById('tele-static-state');
  const teleVentRatio = document.getElementById('tele-vent-ratio');
  const teleVentState = document.getElementById('tele-vent-state');
  const teleGranuleGrowth = document.getElementById('tele-granule-growth');
  const teleGranuleState = document.getElementById('tele-granule-state');

  // Status & Risk Elements
  const statusBanner = document.getElementById('status-banner');
  const statusBadge = document.getElementById('status-badge');
  const riskFactor = document.getElementById('risk-factor');
  const riskMech = document.getElementById('risk-mechanisms');
  const riskMitigation = document.getElementById('risk-mitigation');

  // SVG Elements
  const svgFlowBadge = document.getElementById('svg-flow-regime-badge');
  const svgReadoutD32 = document.getElementById('svg-readout-d32');
  const svgReadoutDp = document.getElementById('svg-readout-dp');
  const svgGroundText = document.getElementById('svg-ground-text');
  const svgVentPanel = document.getElementById('svg-vent-panel');
  const svgSprayCone = document.getElementById('svg-spray-cone');

  // Preset Buttons
  const btnInfant = document.getElementById('btn-preset-infant');
  const btnWurster = document.getElementById('btn-preset-wurster');
  const btnContinuous = document.getElementById('btn-preset-continuous');
  const btnDeflagration = document.getElementById('btn-preset-deflagration');
  const btnCopy = document.getElementById('btn-copy-telemetry');

  function calculateSimulation() {
    const machine = granulatorData.granulatorArchitectures.find(m => m.id === selMachine.value) || granulatorData.granulatorArchitectures[0];
    const powder = granulatorData.powderBinderProfiles.find(p => p.id === selPowder.value) || granulatorData.powderBinderProfiles[0];
    const nozzleFilter = granulatorData.nozzleFilterFormulations.find(nf => nf.id === selNozzleFilter.value) || granulatorData.nozzleFilterFormulations[0];

    const airflow = parseFloat(sAirflow.value);
    const inletTemp = parseFloat(sInletTemp.value);
    const sprayRate = parseFloat(sSprayRate.value); // g/min
    const atomAir = parseFloat(sAtomAir.value); // bar
    const bedMoisture = parseFloat(sBedMoisture.value); // %
    const pulseInterval = parseFloat(sPulseInterval.value); // s
    const groundResist = parseFloat(sGroundResist.value); // Ohm

    // Update Slider Displays
    valAirflow.textContent = `${airflow.toLocaleString()} m³/h`;
    valInletTemp.textContent = `${inletTemp}°C`;
    valSprayRate.textContent = `${sprayRate} g/min`;
    valAtomAir.textContent = `${atomAir.toFixed(1)} bar`;
    valBedMoisture.textContent = `${bedMoisture.toFixed(1)}%`;
    valPulseInterval.textContent = `${pulseInterval} s`;
    valGroundResist.textContent = `${groundResist.toFixed(1)} Ω`;

    // 1. Superficial Gas Velocity & Fluidization Ratio
    // Ug = Q / (3600 * A_distributor)
    const area = machine.distributorPlateAreaM2;
    const ug = airflow / (3600 * area); // m/s
    const umf = powder.minimumFluidizationVelocityUmf; // m/s
    const fluidRatio = ug / umf;

    // 2. Droplet Sauter Mean Diameter (d32) via Lefebvre Empirical Equation
    // Base diameter from atom air pressure: d32 ~ d0 * (P_atom)^(-0.65) * (viscosity)^0.2
    const baseD32 = 45.0 * Math.pow(atomAir / 2.0, -0.68) * Math.pow(powder.binderViscosityMpaS / 10.0, 0.22);
    const d32 = Math.max(12.0, Math.min(110.0, baseD32));

    // 3. Dynamic Viscous Stokes Number (St_v)
    // St_v = (2 * m_p * v_0) / (9 * pi * eta_b * R_b^2)
    const particleMassKg = (4/3) * Math.PI * Math.pow((powder.meanDiameterMicronsD50 * 1e-6) / 2, 3) * powder.particleDensityKgM3;
    const particleRelVel = Math.max(0.2, ug * 0.45);
    const binderViscosityPaS = powder.binderViscosityMpaS * 1e-3;
    const binderBridgeRadiusM = (d32 * 1e-6) * 0.35;
    const stokesNum = (2 * particleMassKg * particleRelVel) / (9 * Math.PI * binderViscosityPaS * Math.pow(binderBridgeRadiusM, 2));

    // 4. Solvent Evaporation Capacity (Psychrometric heat balance)
    // Evap capacity ~ Airflow * rho_air * Cp_air * (T_in - T_out_adiab) / Delta_H_vap
    const deltaT = Math.max(10, inletTemp - 38);
    const evapCapacityKgH = (airflow * 1.15 * 1.005 * deltaT) / 2400; // kg/h
    const sprayRateKgH = (sprayRate * 60) / 1000; // kg/h

    // 5. Exhaust Air Relative Humidity
    // Equilibrium water vapor addition
    const rhBase = 20.0 + (sprayRateKgH / Math.max(1.0, evapCapacityKgH)) * 55.0 + (bedMoisture * 0.8);
    const exhaustRh = Math.max(15.0, Math.min(98.0, rhBase));

    // 6. Filter Bag Differential Pressure (ΔP in kPa)
    // ΔP ~ v_face * cake_resistance * (pulse_interval)^0.45
    const filterFaceVelocityMMin = airflow / (machine.filterBagSurfaceAreaM2 * 60);
    const cakeFactor = Math.pow(pulseInterval / 15.0, 0.48) * (1.0 + (bedMoisture > 10 ? (bedMoisture - 10) * 0.15 : 0));
    const isDegradedFilter = machine.id.includes('aging') || nozzleFilter.id.includes('aluminized') === false && pulseInterval > 40;
    const filterDp = Math.max(0.4, (0.85 * filterFaceVelocityMMin * cakeFactor * (isDegradedFilter ? 2.4 : 1.0)));

    // 7. Electrostatic Spark Energy
    // Capacitive charge Q = I * t; V = Q / C; E = 0.5 * C * V^2
    // With grounding resistance R, voltage V ~ I_tribo * R.
    // Triboelectric current I_tribo ~ (airflow * powder.dustExplosionClass factor)
    const kstFactor = powder.explosionKstValueBarMs / 100.0;
    const triboCurrentMicroAmps = (ug * 8.5) * kstFactor; // uA
    const staticVoltageVolts = (triboCurrentMicroAmps * 1e-6) * (groundResist * 1e5); // V
    const capacitancePf = 180.0; // typical fluid bed shell capacitance
    const sparkEnergyMj = 0.5 * (capacitancePf * 1e-12) * Math.pow(staticVoltageVolts, 2) * 1e3;

    // 8. NFPA 68 Explosion Relief Venting Compliance
    // Req vent area A_v_req ~ 1e-4 * (1 + 1.54 * Pstat^1.33) * Kst * V^(0.75) * sqrt(Pmax/Pred - 1)
    const vesselVolumeM3 = machine.distributorPlateAreaM2 * machine.expansionChamberHeightM * 1.5;
    const pStat = machine.ventReliefPressurePstatBar;
    const pMax = powder.maximumExplosionPressurePmaxBar;
    const pRedAllowed = 0.45; // bar (vessel yield limit)
    const reqVentAreaM2 = 1e-4 * (1 + 1.54 * Math.pow(pStat, 1.33)) * powder.explosionKstValueBarMs * Math.pow(vesselVolumeM3, 0.75) * Math.sqrt(Math.max(1.1, (pMax / pRedAllowed) - 1));
    const ventComplianceRatio = machine.deflagrationVentAreaM2 / Math.max(0.05, reqVentAreaM2);

    // 9. Predicted Mean Granule Size (d50)
    // d50_final = d50_init * (1 + k_agglom * (spray / evap) * (1 / (1 + St_v)))
    const agglomCoeff = (stokesNum < 0.15 && exhaustRh < 75) ? (sprayRateKgH / Math.max(1, evapCapacityKgH)) * 5.5 : 0.8;
    const d50Final = Math.min(850, Math.round(powder.meanDiameterMicronsD50 * (1 + agglomCoeff)));

    // Render Telemetry
    teleFluidRatio.textContent = fluidRatio.toFixed(2);
    if (fluidRatio < 1.4) {
      teleFluidState.textContent = 'Defluidized / Inadequate Drag (Choking)';
      teleFluidState.className = 'block text-[10px] text-rose-500 font-bold mt-1';
      svgFlowBadge.textContent = 'Defluidized / Slugging';
      svgFlowBadge.className = 'px-2 py-0.5 text-[10px] font-bold rounded-full bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/20';
    } else if (fluidRatio > 5.5) {
      teleFluidState.textContent = 'Severe Slugging / Elutriation Fines Loss';
      teleFluidState.className = 'block text-[10px] text-amber-500 font-bold mt-1';
      svgFlowBadge.textContent = 'Severe Elutriation';
      svgFlowBadge.className = 'px-2 py-0.5 text-[10px] font-bold rounded-full bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20';
    } else {
      teleFluidState.textContent = 'Stable Bubbling Regime (2.0 - 4.0 Umf)';
      teleFluidState.className = 'block text-[10px] text-emerald-600 dark:text-emerald-400 font-medium mt-1';
      svgFlowBadge.textContent = 'Bubbling Bed';
      svgFlowBadge.className = 'px-2 py-0.5 text-[10px] font-bold rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20';
    }

    teleDropletD32.textContent = `${d32.toFixed(1)} μm`;
    if (d32 > 50.0) {
      teleDropletState.textContent = 'Coarse Droplets (Overwetting Risk)';
      teleDropletState.className = 'block text-[10px] text-rose-500 font-bold mt-1';
    } else {
      teleDropletState.textContent = 'Optimal Atomization (d32 < 40 μm)';
      teleDropletState.className = 'block text-[10px] text-emerald-600 dark:text-emerald-400 font-medium mt-1';
    }

    teleStokesNum.textContent = stokesNum.toFixed(3);
    if (stokesNum < 0.15) {
      teleStokesState.textContent = 'Controlled Granule Growth (St_v < 0.15)';
      teleStokesState.className = 'block text-[10px] text-emerald-600 dark:text-emerald-400 font-medium mt-1';
    } else {
      teleStokesState.textContent = 'High Rebound Velocity (Excess Dry Fines)';
      teleStokesState.className = 'block text-[10px] text-amber-500 font-bold mt-1';
    }

    teleEvapRate.textContent = `${evapCapacityKgH.toFixed(1)} kg/h`;
    const surplusKg = evapCapacityKgH - sprayRateKgH;
    teleEvapState.textContent = `Spray: ${sprayRateKgH.toFixed(1)} kg/h (Margin: ${surplusKg > 0 ? '+' : ''}${surplusKg.toFixed(1)} kg/h)`;

    teleExhaustRh.textContent = `${exhaustRh.toFixed(1)}%`;
    if (exhaustRh > 75.0) {
      teleExhaustState.textContent = 'Wet Quenching Collapse Warning (>75% RH)';
      teleExhaustState.className = 'block text-[10px] text-rose-500 font-bold mt-1';
    } else {
      teleExhaustState.textContent = 'Normal Psychrometric Evaporation';
      teleExhaustState.className = 'block text-[10px] text-emerald-600 dark:text-emerald-400 font-medium mt-1';
    }

    teleFilterDp.textContent = `${filterDp.toFixed(2)} kPa`;
    if (filterDp > 2.8) {
      teleFilterState.textContent = 'Filter Bag Blinding (ΔP > 2.8 kPa)';
      teleFilterState.className = 'block text-[10px] text-rose-500 font-bold mt-1';
    } else {
      teleFilterState.textContent = 'Permeable Dust Cake (<2.5 kPa)';
      teleFilterState.className = 'block text-[10px] text-emerald-600 dark:text-emerald-400 font-medium mt-1';
    }

    teleStaticSpark.textContent = `${sparkEnergyMj.toFixed(2)} mJ`;
    if (sparkEnergyMj >= powder.minimumIgnitionEnergyMieMj) {
      teleStaticState.textContent = `EXCEEDS MIE (${powder.minimumIgnitionEnergyMieMj} mJ) - DEFLAGRATION!`;
      teleStaticState.className = 'block text-[10px] text-rose-500 font-bold mt-1';
    } else if (sparkEnergyMj > powder.minimumIgnitionEnergyMieMj * 0.5) {
      teleStaticState.textContent = `Caution: Near MIE threshold (${powder.minimumIgnitionEnergyMieMj} mJ)`;
      teleStaticState.className = 'block text-[10px] text-amber-500 font-bold mt-1';
    } else {
      teleStaticState.textContent = `Safe Margin (MIE: ${powder.minimumIgnitionEnergyMieMj} mJ)`;
      teleStaticState.className = 'block text-[10px] text-emerald-600 dark:text-emerald-400 font-medium mt-1';
    }

    teleVentRatio.textContent = ventComplianceRatio.toFixed(2);
    if (ventComplianceRatio < 1.0) {
      teleVentState.textContent = 'Undersized Relief Area (NFPA 68 Violation)';
      teleVentState.className = 'block text-[10px] text-rose-500 font-bold mt-1';
    } else {
      teleVentState.textContent = 'NFPA 68 Vent Area Compliant (>1.0)';
      teleVentState.className = 'block text-[10px] text-emerald-600 dark:text-emerald-400 font-medium mt-1';
    }

    teleGranuleGrowth.textContent = `${d50Final} μm`;
    teleGranuleState.textContent = `Feed: ${powder.meanDiameterMicronsD50} μm (Growth: ${(d50Final / powder.meanDiameterMicronsD50).toFixed(1)}x)`;

    // SVG Readouts
    svgReadoutD32.textContent = `${d32.toFixed(1)} μm`;
    svgReadoutDp.textContent = `${filterDp.toFixed(2)} kPa`;
    svgGroundText.textContent = `Ground: ${groundResist.toFixed(1)} Ω`;

    if (ventComplianceRatio < 1.0) {
      svgVentPanel.setAttribute('fill', '#ef4444');
      svgVentPanel.setAttribute('stroke', '#b91c1c');
    } else {
      svgVentPanel.setAttribute('fill', '#10b981');
      svgVentPanel.setAttribute('stroke', '#059669');
    }

    // Multi-factor Safety Evaluation
    let isSevere = false;
    let isWarning = false;
    let title = '';
    let detail = '';
    let direct = '';

    if (sparkEnergyMj >= powder.minimumIgnitionEnergyMieMj) {
      isSevere = true;
      title = 'Critical Electrostatic Deflagration Risk (Spark > MIE)';
      detail = `High chassis ground resistance (${groundResist.toFixed(1)} Ω) allows static spark accumulation to reach ${sparkEnergyMj.toFixed(2)} mJ, exceeding the powder's Minimum Ignition Energy (${powder.minimumIgnitionEnergyMieMj} mJ). A spark discharge in the dust cloud will trigger an internal vessel explosion.`;
      direct = 'Emergency stop spray and blower. Inspect bonding jumpers to restore earth ground resistance <10 Ohms immediately. Verify nitrogen purge inerting per NFPA 69.';
    } else if (exhaustRh > 75.0 || fluidRatio < 1.4) {
      isSevere = true;
      title = 'Catastrophic Wet Quenching & Bed Defluidization Collapse';
      detail = `Binder spray rate (${sprayRate} g/min) exceeds evaporation capacity, driving exhaust humidity to ${exhaustRh.toFixed(1)}% RH. Superficial velocity ratio (Ug/Umf: ${fluidRatio.toFixed(2)}) is insufficient to fluidize heavy wet bridges, resulting in complete bed collapse and motor stall.`;
      direct = 'Instantly throttle or shut off binder peristaltic pump. Increase inlet drying air temperature and blower airflow to evaporate surface moisture and fluidize bed.';
    } else if (ventComplianceRatio < 1.0) {
      isSevere = true;
      title = 'NFPA 68 Explosion Relief Venting Violation';
      detail = `Current relief panel area (${machine.deflagrationVentAreaM2} m²) is smaller than the NFPA 68 calculated requirement (${reqVentAreaM2.toFixed(2)} m²) for Kst = ${powder.explosionKstValueBarMs} bar·m/s. Internal deflagration would rupture the vessel structure.`;
      direct = 'Upgrade explosion vent burst panel to verified NFPA 68 surface area or install active chemical explosion suppression (HRD bottles).';
    } else if (filterDp > 2.8) {
      isWarning = true;
      title = 'Severe Filter Bag Blinding & Elevated Chamber Pressure';
      detail = `Dust cake buildup has elevated filter differential pressure to ${filterDp.toFixed(2)} kPa. Blinding restricts fluidization exhaust and increases pre-ignition vessel pressure.`;
      direct = 'Shorten pulse-jet reverse blowdown interval to <10 seconds and elevate compressed air header pressure to 5.5 bar. Inspect filter media for grease blinding.';
    } else if (d32 > 50.0) {
      isWarning = true;
      title = 'Coarse Spray Droplet Atomization & Localized Caking';
      detail = `Low atomization air pressure (${atomAir.toFixed(1)} bar) produces coarse droplets (d32: ${d32.toFixed(1)} μm), creating overwet paste clumps rather than uniform porous granules.`;
      direct = 'Increase nozzle atomizing air pressure to >2.5 bar to reduce Sauter mean droplet diameter below 35 μm.';
    } else {
      title = 'Normal Operation - NFPA 68 & 3-A Sanitary Compliant';
      detail = `Geldart fluidization ratio (Ug/Umf: ${fluidRatio.toFixed(2)}), droplet atomization (d32: ${d32.toFixed(1)} μm), and viscous Stokes number (${stokesNum.toFixed(3)}) maintain optimal granule agglomeration with grounded electrostatic protection.`;
      direct = 'Maintain continuous batch operation. Log filter bag differential pressure and check grounding conductor integrity at scheduled shifts.';
    }

    if (isSevere) {
      statusBanner.className = 'p-4 rounded-xl border border-rose-500/40 bg-rose-50 dark:bg-rose-950/40';
      statusBadge.className = 'px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-rose-600 text-white';
      statusBadge.textContent = 'CRITICAL ALARM';
    } else if (isWarning) {
      statusBanner.className = 'p-4 rounded-xl border border-amber-500/40 bg-amber-50 dark:bg-amber-950/40';
      statusBadge.className = 'px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-600 text-white';
      statusBadge.textContent = 'OPERATIONAL WARNING';
    } else {
      statusBanner.className = 'p-4 rounded-xl border border-emerald-500/30 bg-emerald-50 dark:bg-emerald-950/30';
      statusBadge.className = 'px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-600 text-white';
      statusBadge.textContent = 'OPTIMAL (NFPA 68 & 652 COMPLIANT)';
    }

    riskFactor.textContent = title;
    riskMech.textContent = detail;
    riskMitigation.textContent = `Directive: ${direct}`;
  }

  // Preset Handlers
  if (btnInfant) {
    btnInfant.addEventListener('click', () => {
      selMachine.value = 'top_spray_pilot_fluid_bed_granulator';
      selPowder.value = 'infant_formula_maltodextrin_lecithin';
      selNozzleFilter.value = 'dual_fluid_binary_atomizer_ext_mix';
      sAirflow.value = '1800';
      sInletTemp.value = '55';
      sSprayRate.value = '140';
      sAtomAir.value = '2.5';
      sBedMoisture.value = '5.0';
      sPulseInterval.value = '15';
      sGroundResist.value = '4.5';
      calculateSimulation();
    });
  }

  if (btnWurster) {
    btnWurster.addEventListener('click', () => {
      selMachine.value = 'wurster_bottom_spray_coating_granulator';
      selPowder.value = 'spicy_seasoning_maltodextrin_blend';
      selNozzleFilter.value = 'ptfe_membrane_antistatic_felt';
      sAirflow.value = '3200';
      sInletTemp.value = '68';
      sSprayRate.value = '220';
      sAtomAir.value = '3.2';
      sBedMoisture.value = '4.5';
      sPulseInterval.value = '12';
      sGroundResist.value = '3.8';
      calculateSimulation();
    });
  }

  if (btnContinuous) {
    btnContinuous.addEventListener('click', () => {
      selMachine.value = 'continuous_multi_stage_fluid_bed_granulator';
      selPowder.value = 'cocoa_sugar_instant_beverage';
      selNozzleFilter.value = 'aluminized_conductive_woven_mesh';
      sAirflow.value = '4500';
      sInletTemp.value = '85';
      sSprayRate.value = '450';
      sAtomAir.value = '2.8';
      sBedMoisture.value = '6.0';
      sPulseInterval.value = '10';
      sGroundResist.value = '2.5';
      calculateSimulation();
    });
  }

  if (btnDeflagration) {
    btnDeflagration.addEventListener('click', () => {
      selMachine.value = 'aging_unbonded_fluid_bed_high_deflagration_risk';
      selPowder.value = 'modified_waxy_maize_starch';
      selNozzleFilter.value = 'internal_mix_conical_spray_nozzle';
      sAirflow.value = '1200';
      sInletTemp.value = '45';
      sSprayRate.value = '380';
      sAtomAir.value = '1.3';
      sBedMoisture.value = '14.5';
      sPulseInterval.value = '45';
      sGroundResist.value = '180.0';
      calculateSimulation();
    });
  }

  // Copy Telemetry
  if (btnCopy) {
    btnCopy.addEventListener('click', () => {
      const reportText = `[ISITKITCHENSAFE FLUIDIZED BED GRANULATOR TELEMETRY]
Timestamp: ${new Date().toISOString()}
Machine: ${selMachine.options[selMachine.selectedIndex].text}
Powder: ${selPowder.options[selPowder.selectedIndex].text}
Nozzle/Filter: ${selNozzleFilter.options[selNozzleFilter.selectedIndex].text}
Parameters: Airflow: ${sAirflow.value} m³/h | Inlet: ${sInletTemp.value}°C | Spray: ${sSprayRate.value} g/min | Atom Air: ${sAtomAir.value} bar | Bed Moisture: ${sBedMoisture.value}% | Pulse: ${sPulseInterval.value} s | Ground: ${sGroundResist.value} Ω
Telemetry:
- Fluidization Ratio (Ug/Umf): ${teleFluidRatio.textContent} (${teleFluidState.textContent})
- Droplet Sauter d32: ${teleDropletD32.textContent}
- Viscous Stokes Number: ${teleStokesNum.textContent} (${teleStokesState.textContent})
- Evaporation Capacity: ${teleEvapRate.textContent}
- Exhaust Air RH: ${teleExhaustRh.textContent}
- Filter Bag ΔP: ${teleFilterDp.textContent}
- Electrostatic Spark Energy: ${teleStaticSpark.textContent} (${teleStaticState.textContent})
- NFPA 68 Vent Compliance Ratio: ${teleVentRatio.textContent}
- Granule Size Growth: ${teleGranuleGrowth.textContent}
Safety Status: ${statusBadge.textContent}
Risk Summary: ${riskFactor.textContent}
Mechanisms: ${riskMech.textContent}
${riskMitigation.textContent}`;

      navigator.clipboard.writeText(reportText).then(() => {
        const orig = btnCopy.textContent;
        btnCopy.textContent = '✅ Copied!';
        setTimeout(() => { btnCopy.textContent = orig; }, 2000);
      }).catch(() => {});
    });
  }

  // Event Listeners for Reactive Live Calculation
  [selMachine, selPowder, selNozzleFilter].forEach(el => el.addEventListener('change', calculateSimulation));
  [sAirflow, sInletTemp, sSprayRate, sAtomAir, sBedMoisture, sPulseInterval, sGroundResist].forEach(el => el.addEventListener('input', calculateSimulation));

  // Initial Calculation Run
  calculateSimulation();
})();
</script>
