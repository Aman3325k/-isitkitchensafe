const d = DICTIONARY[lang];
---

<div class="fluidized-granulator-container space-y-8 text-ink">
  <!-- Header Card -->
  <div class="p-6 md:p-8 rounded-2xl bg-surface border border-hairline shadow-sm">
    <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
      <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20">
        {d.badge}
      </span>
      <span class="text-xs text-body font-mono">
        Standard: NFPA 68 & NFPA 652 & 3-A 32-02
      </span>
    </div>
    <h1 class="text-2xl md:text-3xl font-extrabold tracking-tight text-ink mb-3">
      {d.title}
    </h1>
    <p class="text-sm md:text-base text-body leading-relaxed max-w-4xl">
      {d.subtitle}
    </p>

    <!-- Presets Toolbar -->
    <div class="mt-6 pt-5 border-t border-hairline">
      <div class="text-xs font-bold text-ink uppercase tracking-wider mb-3">
        ⚡ {d.presetsTitle}
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5">
        <button type="button" id="btn-preset-infant" class="px-3 py-2 text-xs font-semibold rounded-lg bg-surface-soft hover:bg-surface-soft/80 border border-hairline text-left transition-colors">
          🍼 {d.presetInfant}
        </button>
        <button type="button" id="btn-preset-wurster" class="px-3 py-2 text-xs font-semibold rounded-lg bg-surface-soft hover:bg-surface-soft/80 border border-hairline text-left transition-colors">
          💊 {d.presetWurster}
        </button>
        <button type="button" id="btn-preset-continuous" class="px-3 py-2 text-xs font-semibold rounded-lg bg-surface-soft hover:bg-surface-soft/80 border border-hairline text-left transition-colors">
          🏭 {d.presetContinuous}
        </button>
        <button type="button" id="btn-preset-deflagration" class="px-3 py-2 text-xs font-semibold rounded-lg bg-rose-500/10 hover:bg-rose-500/20 border border-rose-500/30 text-rose-700 dark:text-rose-300 text-left transition-colors">
          ⚠️ {d.presetDeflagration}
        </button>
      </div>
    </div>
  </div>

  <!-- Interactive Controls & SVG Schematic Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
    <!-- Controls Panel (7 Cols) -->
    <div class="lg:col-span-7 p-6 rounded-2xl bg-surface border border-hairline shadow-sm space-y-6">
      <div>
        <h2 class="text-lg font-bold text-ink">{d.controlsTitle}</h2>
        <p class="text-xs text-body mt-0.5">{d.controlsSub}</p>
      </div>

      <!-- Selectors -->
      <div class="space-y-4">
        <div>
          <label for="select-machine" class="block text-xs font-semibold text-ink mb-1">
            {d.machineLabel}
          </label>
          <select id="select-machine" class="w-full text-xs font-medium p-2.5 rounded-lg bg-surface-soft border border-hairline text-ink focus:outline-none focus:ring-2 focus:ring-primary">
            {granulatorData.granulatorArchitectures.map((m) => (
              <option value={m.id}>{m.name}</option>
            ))}
          </select>
          <p class="text-[11px] text-body mt-1">{d.machineHelp}</p>
        </div>

        <div>
          <label for="select-powder" class="block text-xs font-semibold text-ink mb-1">
            {d.powderLabel}
          </label>
          <select id="select-powder" class="w-full text-xs font-medium p-2.5 rounded-lg bg-surface-soft border border-hairline text-ink focus:outline-none focus:ring-2 focus:ring-primary">
            {granulatorData.powderBinderProfiles.map((p) => (
              <option value={p.id}>{p.name}</option>
            ))}
          </select>
          <p class="text-[11px] text-body mt-1">{d.powderHelp}</p>
        </div>

        <div>
          <label for="select-nozzle-filter" class="block text-xs font-semibold text-ink mb-1">
            {d.nozzleFilterLabel}
          </label>
          <select id="select-nozzle-filter" class="w-full text-xs font-medium p-2.5 rounded-lg bg-surface-soft border border-hairline text-ink focus:outline-none focus:ring-2 focus:ring-primary">
            {granulatorData.nozzleFilterFormulations.map((nf) => (
              <option value={nf.id}>{nf.name}</option>
            ))}
          </select>
          <p class="text-[11px] text-body mt-1">{d.nozzleFilterHelp}</p>
        </div>
      </div>

      <!-- Sliders Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2 border-t border-hairline">
        <!-- Airflow Volume -->
        <div>
          <div class="flex justify-between items-center mb-1">
            <label for="slider-airflow" class="text-xs font-semibold text-ink">
              {d.airflowLabel}
            </label>
            <span id="val-airflow" class="text-xs font-mono font-bold text-amber-600 dark:text-amber-400">1800 m³/h</span>
          </div>
          <input type="range" id="slider-airflow" min="400" max="5000" step="50" value="1800" class="w-full accent-amber-600" />
          <p class="text-[10px] text-body mt-0.5">{d.airflowHelp}</p>
        </div>

        <!-- Inlet Air Temperature -->
        <div>
          <div class="flex justify-between items-center mb-1">
            <label for="slider-inlet-temp" class="text-xs font-semibold text-ink">
              {d.inletTempLabel}
            </label>
            <span id="val-inlet-temp" class="text-xs font-mono font-bold text-amber-600 dark:text-amber-400">65°C</span>
          </div>
