    pressureHelp: "scCO2 流体密度、溶媒抽出溶解力、および細菌芽胞に対する機械的静水圧破壊力を決定 (臨界点 Pc = 73.8 bar)。",
    tempLabel: "恒温反応区設定温度 (°C):",
    tempHelp: "等温反応管内の流体温度。scCO2 の拡散活性を高めつつ、熱変性しやすい機能性タンパク質の凝固を防ぎます。",
    flowLabel: "連続流体供給流量 (L/h):",
    flowHelp: "高圧滞留コイルを通過する液体の処理量。高圧暴露および相界面物質移動時間を決定します。",
    co2RatioLabel: "CO2 / 液体 質量比 (kg CO2 / kg Liquid):",
    co2RatioHelp: "マイクロノズルから注入される超臨界二酸化炭素の質量比率。液中への過飽和高密度相溶解を維持します。",
    presetsTitle: "標準的商業用超高圧運転プリセット",
    presetApple: "混濁リンゴ果汁 TAB 芽胞完全滅菌 (300 bar, 48°C, 35 L/h)",
    presetEgg: "液全卵 サルモネラ菌非凝固冷滅菌 (350 bar, 42°C, 45 L/h)",
    presetPlantMilk: "植物性ミルク ボツリヌス菌芽胞完全死滅 (420 bar, 52°C, 300 L/h)",
    presetPuree: "スーパーフードベリー原浆 低温滅菌アントシアニン保持 (280 bar, 40°C, 120 L/h)",
    presetHazard: "著しい圧力不足・ガスケット爆裂危険バイパス (95 bar, 32°C, 400 L/h)",
    diagnosticTitle: "超臨界溶菌熱力学＆芽胞不活化リアルタイム診断",
    diagnosticSub: "scCO2 流体密度、細胞内炭酸急速酸性化度、耐熱芽胞対数減少率、および ASME 圧力容器構造的健全性をリアルタイム解析。",
    phaseStateLabel: "CO2 熱力学的相平衡状態",
    densityLabel: "超臨界 CO2 流体密度 (ρ)",
    phDropLabel: "細胞内炭酸解離による酸性化度 (pH)",
    sporeLogLabel: "対象菌・細菌芽胞対数減少率 (Log10)",
    dpaReleaseLabel: "ジピコリン酸 (DPA) 溶出放出率",
    residenceTimeLabel: "高圧相間物質移動滞留時間 (τ)",
    asmeSafetyMarginLabel: "ASME 圧力容器 VIII-2 安全裕度係数",
    explosiveDecompressionLabel: "シール材の爆発的減圧 (RGD) 破壊リスク",
    safetyStatusLabel: "FDA 21 CFR § 113 / 120 規格適合状態",
    primaryLimitationLabel: "主要な工学力学的制限要因",
    mitigationActionLabel: "推奨対策＆保安管理プロトコル",
    scienceTitle: "超臨界 CO2 高密度相熱力学＆芽胞不活化メカニズム",
    scienceSub: "超臨界溶媒抽出、芽胞外殻透過、細胞内酸ショック致死、および超高圧圧力容器工学設計の包括的技術解説。",
    tableTitle: "商業用連続超高圧 scCO2 反応器仕様諸元"
  }
};

const d = DICT[lang] || DICT.en;
---

<div class="bg-surface border border-hairline rounded-3xl p-6 sm:p-8 lg:p-10 shadow-xs">
  
  <!-- Header Section -->
  <div class="max-w-4xl mb-8">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-purple-600/10 text-purple-700 dark:text-purple-300 border border-purple-500/20 mb-3">
      <span class="w-2 h-2 rounded-full bg-purple-600 animate-pulse"></span>
      {d.badge}
    </div>
    <h1 class="text-title-xl sm:text-headline-md font-bold text-ink tracking-tight">
      {d.title}
    </h1>
    <p class="text-body-base text-muted mt-3 leading-relaxed">
      {d.subtitle}
    </p>
  </div>

  <!-- Interactive Grid: Controls (5 cols) & Diagnostics (7 cols) -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    
    <!-- Controls Panel (Left, 5 cols) -->
    <div class="lg:col-span-5 bg-surface-soft border border-hairline rounded-2xl p-5 sm:p-6 space-y-5">
      <div>
        <h2 class="text-title-sm font-bold text-ink">{d.controlsTitle}</h2>
        <p class="text-xs text-muted mt-0.5">{d.controlsSub}</p>
      </div>

      <!-- Selector: Reactor Architecture -->
      <div class="space-y-1.5">
        <label for="scco2-sys-select" class="block text-xs font-semibold text-ink">
          {d.systemLabel}
        </label>
        <select id="scco2-sys-select" class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-xs text-ink focus:outline-none focus:ring-2 focus:ring-purple-500">
          {scCo2Data.scCo2Systems.map(sys => (
            <option value={sys.id}>{sys.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted leading-tight">{d.systemHelp}</p>
      </div>

      <!-- Selector: Food Matrix -->
      <div class="space-y-1.5">
        <label for="scco2-matrix-select" class="block text-xs font-semibold text-ink">
          {d.matrixLabel}
        </label>
        <select id="scco2-matrix-select" class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-xs text-ink focus:outline-none focus:ring-2 focus:ring-purple-500">
          {scCo2Data.foodMatrices.map(mat => (
            <option value={mat.id}>{mat.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted leading-tight">{d.matrixHelp}</p>
      </div>

      <!-- Selector: Microorganism -->
      <div class="space-y-1.5">
        <label for="scco2-microbe-select" class="block text-xs font-semibold text-ink">
          {d.microbeLabel}
        </label>
        <select id="scco2-microbe-select" class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-xs text-ink focus:outline-none focus:ring-2 focus:ring-purple-500">
          {scCo2Data.targetMicroorganisms.map(mic => (
            <option value={mic.id}>{mic.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted leading-tight">{d.microbeHelp}</p>
      </div>

      <!-- Selector: Metallurgy & Seals -->
      <div class="space-y-1.5">
        <label for="scco2-metal-select" class="block text-xs font-semibold text-ink">
          {d.metallurgyLabel}
        </label>
        <select id="scco2-metal-select" class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-xs text-ink focus:outline-none focus:ring-2 focus:ring-purple-500">
          {scCo2Data.pressureMetallurgy.map(met => (
            <option value={met.id}>{met.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted leading-tight">{d.metallurgyHelp}</p>
      </div>

      <!-- Slider 1: Pressure (bar) -->
      <div class="space-y-1.5">
        <div class="flex items-center justify-between text-xs">
          <label for="scco2-pressure-slider" class="font-semibold text-ink">{d.pressureLabel}</label>
          <span id="scco2-pressure-val" class="font-mono font-bold text-purple-700 dark:text-purple-300">350 bar</span>
        </div>
        <input 
          type="range" 
          id="scco2-pressure-slider" 
          min="60" 
          max="500" 
          step="5" 
          value="350" 
          class="w-full accent-purple-600 cursor-pointer"
        />
        <p class="text-[11px] text-muted">{d.pressureHelp}</p>
      </div>

      <!-- Slider 2: Temperature (°C) -->
      <div class="space-y-1.5">
        <div class="flex items-center justify-between text-xs">
          <label for="scco2-temp-slider" class="font-semibold text-ink">{d.tempLabel}</label>
          <span id="scco2-temp-val" class="font-mono font-bold text-purple-700 dark:text-purple-300">45 °C</span>
        </div>
        <input 
          type="range" 
          id="scco2-temp-slider" 
          min="20" 
          max="75" 
          step="1" 
          value="45" 
          class="w-full accent-purple-600 cursor-pointer"
        />
        <p class="text-[11px] text-muted">{d.tempHelp}</p>
      </div>

      <!-- Slider 3: Liquid Flow Rate (L/h) -->
      <div class="space-y-1.5">
        <div class="flex items-center justify-between text-xs">
          <label for="scco2-flow-slider" class="font-semibold text-ink">{d.flowLabel}</label>
          <span id="scco2-flow-val" class="font-mono font-bold text-purple-700 dark:text-purple-300">35 L/h</span>
        </div>
        <input 
          type="range" 
          id="scco2-flow-slider" 
          min="5" 
          max="800" 
          step="5" 
          value="35" 
          class="w-full accent-purple-600 cursor-pointer"
        />
        <p class="text-[11px] text-muted">{d.flowHelp}</p>
      </div>

      <!-- Slider 4: CO2 Mass Ratio (%) -->
      <div class="space-y-1.5">
        <div class="flex items-center justify-between text-xs">
          <label for="scco2-ratio-slider" class="font-semibold text-ink">{d.co2RatioLabel}</label>
          <span id="scco2-ratio-val" class="font-mono font-bold text-purple-700 dark:text-purple-300">12% CO2</span>
        </div>
        <input 
          type="range" 
          id="scco2-ratio-slider" 
          min="2" 
          max="20" 
          step="1" 
          value="12" 
          class="w-full accent-purple-600 cursor-pointer"
        />
        <p class="text-[11px] text-muted">{d.co2RatioHelp}</p>
      </div>
    </div>

    <!-- Diagnostics Panel (Right, 7 cols) -->
    <div class="lg:col-span-7 space-y-6">
      
      <!-- Primary Compliance Status Banner -->
      <div id="scco2-status-banner" class="border rounded-2xl p-5 transition-colors bg-emerald-500/10 border-emerald-500/30 text-emerald-950 dark:text-emerald-200">
        <div class="flex items-start gap-3">
          <div id="scco2-status-icon" class="p-2 rounded-xl bg-emerald-500/20 text-emerald-600 dark:text-emerald-300 mt-0.5">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div class="flex-1">
            <div class="flex items-center justify-between flex-wrap gap-2">
              <span class="text-xs font-bold uppercase tracking-wider text-muted">{d.safetyStatusLabel}</span>
              <span id="scco2-badge-pill" class="px-2.5 py-0.5 rounded-full text-xs font-bold uppercase bg-emerald-600 text-white">
                FDA LACF 6-LOG STERILITY
              </span>
            </div>
            <h3 id="scco2-status-heading" class="text-base font-bold text-ink mt-1">
              Fully Compliant Supercritical CO2 Spore Lethality & Structural Integrity
            </h3>
            <p id="scco2-status-desc" class="text-xs text-muted mt-1 leading-relaxed">
              Supercritical dense-phase solvation achieves complete DPA efflux and irreversible spore inactivation with ASME BPVC VIII-2 safety margin.
            </p>
          </div>
        </div>
      </div>

      <!-- Metrics 4-Card Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        
        <!-- Metric 1: Fluid Density -->
        <div class="bg-surface-soft border border-hairline rounded-2xl p-4 flex flex-col justify-between">
          <span class="text-xs font-medium text-muted">{d.densityLabel}</span>
          <div class="my-2">
            <span id="out-density-val" class="text-2xl font-bold font-mono text-ink">835</span>
            <span class="text-xs text-muted ml-1">kg/m³</span>
          </div>
          <div class="w-full bg-hairline rounded-full h-1.5 overflow-hidden">
            <div id="bar-density" class="bg-purple-600 h-full rounded-full transition-all duration-300" style="width: 83%;"></div>
          </div>
          <div class="flex justify-between items-center text-[11px] text-muted mt-2">
            <span>Phase State:</span>
            <span id="sub-phase-state" class="font-bold text-purple-600 dark:text-purple-400">Supercritical Fluid</span>
          </div>
        </div>

        <!-- Metric 2: Spore Log Reduction -->
        <div class="bg-surface-soft border border-hairline rounded-2xl p-4 flex flex-col justify-between">
          <span class="text-xs font-medium text-muted">{d.sporeLogLabel}</span>
          <div class="my-2">
            <span id="out-log-val" class="text-2xl font-bold font-mono text-emerald-600 dark:text-emerald-400">6.25</span>
            <span class="text-xs text-muted ml-1">Log10</span>
          </div>
          <div class="w-full bg-hairline rounded-full h-1.5 overflow-hidden">
            <div id="bar-log" class="bg-emerald-600 h-full rounded-full transition-all duration-300" style="width: 89%;"></div>
          </div>
          <div class="flex justify-between items-center text-[11px] text-muted mt-2">
            <span id="sub-target-microbe" class="truncate">Target: B. cereus</span>
            <span class="font-medium text-emerald-600">Complete Sterility</span>
          </div>
        </div>

        <!-- Metric 3: Cytoplasmic Acidification (pH) -->
        <div class="bg-surface-soft border border-hairline rounded-2xl p-4 flex flex-col justify-between">
          <span class="text-xs font-medium text-muted">{d.phDropLabel}</span>
          <div class="my-2">
            <span id="out-ph-val" class="text-2xl font-bold font-mono text-indigo-600 dark:text-indigo-400">2.95</span>
            <span class="text-xs text-muted ml-1">pH</span>
          </div>
          <div class="w-full bg-hairline rounded-full h-1.5 overflow-hidden">
            <div id="bar-ph" class="bg-indigo-600 h-full rounded-full transition-all duration-300" style="width: 90%;"></div>
          </div>
          <div class="flex justify-between items-center text-[11px] text-muted mt-2">
            <span>Acid Shock:</span>
            <span id="sub-ph-state" class="font-bold text-indigo-600 dark:text-indigo-400">Lethal Carbonic Collapse</span>
          </div>
        </div>

        <!-- Metric 4: Residence Time -->
        <div class="bg-surface-soft border border-hairline rounded-2xl p-4 flex flex-col justify-between">
          <span class="text-xs font-medium text-muted">{d.residenceTimeLabel}</span>
          <div class="my-2">
            <span id="out-residence-val" class="text-2xl font-bold font-mono text-ink">8.23</span>
            <span class="text-xs text-muted ml-1">minutes</span>
          </div>
          <div class="w-full bg-hairline rounded-full h-1.5 overflow-hidden">
            <div id="bar-residence" class="bg-purple-600 h-full rounded-full transition-all duration-300" style="width: 68%;"></div>
          </div>
          <div class="flex justify-between items-center text-[11px] text-muted mt-2">
            <span>Reactor Volume:</span>
            <span id="sub-reactor-vol" class="font-mono text-ink">4.8 L</span>
          </div>
        </div>
      </div>

      <!-- Secondary Telemetry Row (DPA, ASME Margin, Decompression) -->
      <div class="bg-surface-soft border border-hairline rounded-2xl p-5 space-y-3">
        <h4 class="text-xs font-bold text-ink uppercase tracking-wider">
          High-Pressure Engineering &amp; Microbiological Validation
        </h4>
        
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
          <div class="p-3 bg-surface rounded-xl border border-hairline">
            <span class="text-muted block text-[11px]">{d.dpaReleaseLabel}:</span>
            <span id="out-dpa-rate" class="font-mono font-bold text-purple-600 dark:text-purple-400 text-sm mt-0.5 block">
              99.8% Efflux
            </span>
          </div>
          <div class="p-3 bg-surface rounded-xl border border-hairline">
            <span class="text-muted block text-[11px]">{d.asmeSafetyMarginLabel}:</span>
            <span id="out-asme-margin" class="font-mono font-bold text-emerald-600 dark:text-emerald-400 text-sm mt-0.5 block">
              1.28x MAWP Margin
            </span>
          </div>
          <div class="p-3 bg-surface rounded-xl border border-hairline">
            <span class="text-muted block text-[11px]">{d.explosiveDecompressionLabel}:</span>
            <span id="out-decomp-risk" class="font-mono font-medium text-emerald-600 dark:text-emerald-400 text-sm mt-0.5 block">
              Immune (PEEK/Kalrez)
            </span>
          </div>
        </div>
      </div>

      <!-- Diagnostics Interpretation Box -->
      <div class="bg-surface-soft border border-hairline rounded-2xl p-5 space-y-3">
        <div class="space-y-1">
          <span class="text-xs font-bold uppercase tracking-wider text-muted">{d.primaryLimitationLabel}:</span>
          <p id="out-primary-limit" class="text-xs text-ink leading-relaxed">
            OPTIMAL SUPERCRITICAL PHASE: Fluid density &gt; 800 kg/m³ provides extreme micro-bubble solvation and rapid spore coat lipid dissolution without protein heat damage.
          </p>
        </div>
        <div class="border-t border-hairline pt-3 space-y-1">
          <span class="text-xs font-bold uppercase tracking-wider text-muted">{d.mitigationActionLabel}:</span>
          <p id="out-mitigation-action" class="text-xs text-muted leading-relaxed">
            Maintain isothermal holding above 40°C and verify autofrettaged vessel acoustic emission monitoring per ASME Section VIII Division 2 fatigue cycle rules.
          </p>
        </div>
      </div>

      <!-- Presets Buttons -->
      <div class="space-y-2">
        <span class="text-xs font-bold text-ink uppercase tracking-wider">{d.presetsTitle}</span>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <button 
            type="button" 
            id="btn-preset-apple" 
            class="text-left p-3 rounded-xl border border-hairline bg-surface hover:bg-surface-soft text-xs transition-colors"
          >
            <span class="font-semibold text-ink block">{d.presetApple}</span>
            <span class="text-[11px] text-muted">TAB spore lethality in apple must at 300 bar</span>
          </button>
          <button 
            type="button" 
            id="btn-preset-egg" 
            class="text-left p-3 rounded-xl border border-hairline bg-surface hover:bg-surface-soft text-xs transition-colors"
          >
            <span class="font-semibold text-ink block">{d.presetEgg}</span>
            <span class="text-[11px] text-muted">Egg salmonella inactivation at 42°C with no coagulation</span>
          </button>
          <button 
            type="button" 
            id="btn-preset-plantmilk" 
            class="text-left p-3 rounded-xl border border-hairline bg-surface hover:bg-surface-soft text-xs transition-colors"
          >
            <span class="font-semibold text-ink block">{d.presetPlantMilk}</span>
            <span class="text-[11px] text-muted">Low-acid almond milk C. botulinum spore control at 420 bar</span>
          </button>
          <button 
            type="button" 
            id="btn-preset-puree" 
            class="text-left p-3 rounded-xl border border-hairline bg-surface hover:bg-surface-soft text-xs transition-colors"
          >
            <span class="font-semibold text-ink block">{d.presetPuree}</span>
            <span class="text-[11px] text-muted">Viscous superfood puree cold stabilization at 280 bar</span>
          </button>
          <button 
            type="button" 
            id="btn-preset-hazard" 
            class="text-left p-3 rounded-xl border border-hairline bg-red-500/10 hover:bg-red-500/20 text-red-950 dark:text-red-200 text-xs transition-colors sm:col-span-2"
          >
            <span class="font-semibold block">{d.presetHazard}</span>
            <span class="text-[11px] opacity-80">Sub-critical collapse, blown gaskets &amp; live pathogen bypass</span>
          </button>
        </div>
      </div>

    </div>
  </div>

  <!-- Deep Scientific & Regulatory Engineering Section -->
  <section class="mt-16 border-t border-hairline pt-12">
    <div class="max-w-4xl mb-8">
      <h2 class="text-title-lg font-bold text-ink tracking-tight">
        {d.scienceTitle}
      </h2>
      <p class="text-body-sm text-muted mt-2 leading-relaxed">
        {d.scienceSub}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <!-- Card 1: Dense-Phase Supercritical Thermodynamics -->
      <div class="bg-surface-soft border border-hairline rounded-2xl p-6 space-y-3">
        <div class="w-10 h-10 rounded-xl bg-purple-500/10 text-purple-600 dark:text-purple-400 flex items-center justify-center font-bold">
          scCO2
        </div>
        <h3 class="text-body-base font-bold text-ink">Supercritical Solvation &amp; Micro-Bubble Mass Transfer</h3>
        <p class="text-body-xs text-muted leading-relaxed">
          Carbon dioxide reaches its supercritical state above the thermodynamic critical point (P_c = 73.8 bar, T_c = 31.1°C). In the dense supercritical regime (150 to 500 bar), scCO2 displays gas-like diffusivity (~10⁻⁸ m²/s) paired with liquid-like solvent density (750 to 950 kg/m³). High-shear Venturi injection atomizes scCO2 into sub-10 µm micro-bubbles, achieving rapid mass transfer and deep penetration through microbial peptidoglycan walls and protective lipopolysaccharide complexes.
        </p>
      </div>

      <!-- Card 2: Intracellular Carbonic Acid Spore Lysis -->
      <div class="bg-surface-soft border border-hairline rounded-2xl p-6 space-y-3">
        <div class="w-10 h-10 rounded-xl bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 flex items-center justify-center font-bold">
          pH
        </div>
        <h3 class="text-body-base font-bold text-ink">Intracellular Acid Shock &amp; DPA Membrane Efflux</h3>
        <p class="text-body-xs text-muted leading-relaxed">
          Because non-polar CO2 molecules dissolve across bacterial cell membranes hundreds of times faster than mineral acids, dissolved CO2 hydrates internally: CO₂ + H₂O ⇌ H₂CO₃ ⇌ H⁺ + HCO₃⁻. The cytoplasmic pH drops catastrophically below 3.0, irreversibly denaturing glycolytic and respiratory enzymes. Concurrently, high hydrostatic pressure induces barophilic phase transitions in bacterial endospores (Bacillus, Clostridium), prompting rapid release of protective dipicolinic acid (DPA) and structural membrane collapse.
        </p>
      </div>

      <!-- Card 3: ASME Pressure Vessel Safety & Seal Reliability -->
      <div class="bg-surface-soft border border-hairline rounded-2xl p-6 space-y-3">
        <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold">
          ASME
        </div>
        <h3 class="text-body-base font-bold text-ink">ASME VIII-2 Fatigue &amp; Rapid Gas Decompression (RGD)</h3>
        <p class="text-body-xs text-muted leading-relaxed">
          Continuous supercritical sterilizers operate under ASME BPVC Section VIII Division 2 (Alternative Rules for High Pressure Vessels). Vessels utilize autofrettaged 2205 Duplex Stainless Steel or Hastelloy C-276 to prevent stress-corrosion cracking from carbonic acid. To avoid catastrophic Rapid Gas Decompression (RGD) blistering where trapped dissolved CO2 nucleates into explosive gas pockets upon venting, sanitary joints employ spring-energized virgin PEEK, Kel-F, or specialized Kalrez 6230 perfluoroelastomers.
        </p>
      </div>
    </div>

    <!-- Technical Specifications Table -->
    <div class="mt-12 bg-surface-soft border border-hairline rounded-2xl p-6 overflow-x-auto">
      <h3 class="text-body-base font-bold text-ink mb-4">{d.tableTitle}</h3>
      <table class="w-full text-xs text-left border-collapse">
        <thead>
          <tr class="border-b border-hairline text-muted">
            <th class="py-2.5 px-3">Subsystem Architecture</th>
            <th class="py-2.5 px-3">Max Pressure (MAWP)</th>
            <th class="py-2.5 px-3">Operating Temp Range</th>
            <th class="py-2.5 px-3">Wetted Metallurgy</th>
            <th class="py-2.5 px-3">Target Microorganism</th>
            <th class="py-2.5 px-3">Sanitary Certification</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline">
          {scCo2Data.scCo2Systems.map(sys => (
            <tr class="hover:bg-surface/50 transition-colors">
              <td class="py-2.5 px-3 font-semibold text-ink">{sys.name}</td>
              <td class="py-2.5 px-3 font-mono">{sys.maxPressureBar} bar</td>
              <td class="py-2.5 px-3 font-mono">35 - {sys.maxTempC} °C</td>
              <td class="py-2.5 px-3 text-muted">{sys.metallurgy}</td>
              <td class="py-2.5 px-3 text-muted">B. cereus &amp; C. botulinum</td>
              <td class="py-2.5 px-3 font-medium text-emerald-600 dark:text-emerald-400">{sys.sanitaryCertifications}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</div>

<!-- Client-side Calculation & Interactive Script -->
<script define:vars={{ scCo2Data }}>
  document.addEventListener('DOMContentLoaded', () => {
    // DOM Selectors
    const sysSelect = document.getElementById('scco2-sys-select');
    const matrixSelect = document.getElementById('scco2-matrix-select');
    const microbeSelect = document.getElementById('scco2-microbe-select');
    const metalSelect = document.getElementById('scco2-metal-select');

    // Sliders
    const pressureSlider = document.getElementById('scco2-pressure-slider');
    const tempSlider = document.getElementById('scco2-temp-slider');
    const flowSlider = document.getElementById('scco2-flow-slider');
    const ratioSlider = document.getElementById('scco2-ratio-slider');

    // Val Labels
    const pressureVal = document.getElementById('scco2-pressure-val');
    const tempVal = document.getElementById('scco2-temp-val');
    const flowVal = document.getElementById('scco2-flow-val');
    const ratioVal = document.getElementById('scco2-ratio-val');

    // Output Metrics
    const outDensity = document.getElementById('out-density-val');
    const barDensity = document.getElementById('bar-density');
    const subPhaseState = document.getElementById('sub-phase-state');

    const outLog = document.getElementById('out-log-val');
    const barLog = document.getElementById('bar-log');
    const subTargetMicrobe = document.getElementById('sub-target-microbe');

    const outPh = document.getElementById('out-ph-val');
    const barPh = document.getElementById('bar-ph');
    const subPhState = document.getElementById('sub-ph-state');

    const outResidence = document.getElementById('out-residence-val');
    const barResidence = document.getElementById('bar-residence');
    const subReactorVol = document.getElementById('sub-reactor-vol');

    const outDpaRate = document.getElementById('out-dpa-rate');
    const outAsmeMargin = document.getElementById('out-asme-margin');
    const outDecompRisk = document.getElementById('out-decomp-risk');

    const outPrimaryLimit = document.getElementById('out-primary-limit');
    const outMitigationAction = document.getElementById('out-mitigation-action');

    // Banner
    const statusBanner = document.getElementById('scco2-status-banner');
    const statusIcon = document.getElementById('scco2-status-icon');
    const badgePill = document.getElementById('scco2-badge-pill');
    const statusHeading = document.getElementById('scco2-status-heading');
    const statusDesc = document.getElementById('scco2-status-desc');

    function calculate() {
      if (!sysSelect || !matrixSelect || !microbeSelect || !metalSelect) return;

      const currentSys = scCo2Data.scCo2Systems.find(s => s.id === sysSelect.value) || scCo2Data.scCo2Systems[0];
      const currentMatrix = scCo2Data.foodMatrices.find(m => m.id === matrixSelect.value) || scCo2Data.foodMatrices[0];
      const currentMicrobe = scCo2Data.targetMicroorganisms.find(mic => mic.id === microbeSelect.value) || scCo2Data.targetMicroorganisms[0];
      const currentMetal = scCo2Data.pressureMetallurgy.find(met => met.id === metalSelect.value) || scCo2Data.pressureMetallurgy[0];

      const pressureBar = parseFloat(pressureSlider.value);
      const tempC = parseFloat(tempSlider.value);
      const flowLph = parseFloat(flowSlider.value);
      const co2RatioPct = parseFloat(ratioSlider.value);

      // Label updates
      if (pressureVal) pressureVal.textContent = `${pressureBar.toFixed(0)} bar`;
      if (tempVal) tempVal.textContent = `${tempC.toFixed(0)} °C`;
      if (flowVal) flowVal.textContent = `${flowLph.toFixed(0)} L/h`;
      if (ratioVal) ratioVal.textContent = `${co2RatioPct.toFixed(0)}% CO2`;

      // 1. Thermodynamic Phase Determination & Density (kg/m³)
      // Supercritical point of pure CO2: Pc = 73.8 bar, Tc = 31.1°C
      const isSupercritical = pressureBar >= 73.8 && tempC >= 31.1;
      const isSubcriticalLiquid = pressureBar >= 60.0 && tempC < 31.1;
      const isGasPhase = pressureBar < 73.8 && tempC >= 31.1;

      // Approximate scCO2 density (Modified Peng-Robinson fit for 30-75°C, 60-500 bar)
      // Base density at 300 bar, 40°C ~ 840 kg/m^3
      let scDensity = 0;
      if (pressureBar < 60) {
        scDensity = (pressureBar * 44.01) / (0.08314 * (tempC + 273.15)) * 0.8; // gas density kg/m3
      } else {
        const pFactor = Math.pow(pressureBar / 300.0, 0.28);
        const tFactor = Math.pow(313.15 / (tempC + 273.15), 1.25);
        scDensity = 840.0 * pFactor * tFactor;
        if (scDensity > 1020) scDensity = 1020;
        if (scDensity < 180) scDensity = 180;
      }

      // 2. Intracellular Carbonic Acid Dissociation & Cytoplasmic pH drop
      // CO2 solubility Henry's constant and carbonic acid dissociation
      // Native pH ~ 6.5 - 7.4 inside microbe, drops down to 2.8 - 3.4
      const pDropFactor = Math.min(1.0, pressureBar / 350.0);
      const co2Saturation = (co2RatioPct / 12.0) * currentMatrix.co2SolubilityFactor;
      const phDrop = 3.65 * pDropFactor * Math.min(1.2, co2Saturation);
      const cytosolicPh = Math.max(2.65, 7.2 - phDrop);

      // 3. Spore Dipicolinic Acid (DPA) Membrane Efflux (%)
      // Endospores release DPA when compressive hydrostatic stress + scCO2 permeation occurs
      const activationP = currentMicrobe.activationPressureBar;
      const lysisP = currentMicrobe.lysisPressureBar;
      let dpaEfflux = 0;
      if (pressureBar < activationP * 0.7) {
        dpaEfflux = (pressureBar / activationP) * 15.0;
      } else if (pressureBar < lysisP) {
        const progress = (pressureBar - activationP * 0.7) / (lysisP - activationP * 0.7);
        dpaEfflux = 15.0 + progress * 75.0;
      } else {
        dpaEfflux = 90.0 + Math.min(9.99, (pressureBar - lysisP) * 0.08);
      }
      if (dpaEfflux > 99.9) dpaEfflux = 99.9;

      // 4. Hydraulic Residence Time in Reactor (minutes)
      const reactorVolL = currentSys.reactorVolumeLiters;
      const residenceTimeMin = flowLph > 0 ? (reactorVolL / flowLph) * 60.0 : 5.0;

      // 5. Endospore & Pathogen Log Reduction (Log10 N0/N)
      // Driven by pressure, residence time, temperature, and pH collapse
      const pressureContribution = Math.max(0, (pressureBar - activationP * 0.5) / 45.0);
      const timeContribution = Math.min(2.5, Math.pow(residenceTimeMin / 4.0, 0.65));
      const tempSynergy = 1.0 + Math.max(0, (tempC - 35.0) / 30.0) * 0.8;
      const acidSynergy = Math.max(0.5, (4.5 - cytosolicPh) * 0.9);

      let logReduction = (pressureContribution * timeContribution * tempSynergy * acidSynergy) / 2.2;
      if (currentMicrobe.id === 'salmonella_enteritidis') {
        logReduction = logReduction * 1.6; // vegetative bacteria much more susceptible
      }
      if (logReduction > 8.5) logReduction = 8.5;
      if (logReduction < 0.2) logReduction = 0.2;

      // 6. ASME Vessel Working Pressure Safety Margin
      const mawp = currentMetal.maxWorkingPressureBar;
      const asmeMargin = mawp / pressureBar;

      // 7. Update UI Elements
      if (outDensity) outDensity.textContent = scDensity.toFixed(0);
      if (barDensity) {
        const densityPct = Math.min(100, (scDensity / 1000.0) * 100);
        barDensity.style.width = `${densityPct}%`;
      }
      if (subPhaseState) {
        if (isSupercritical) {
          subPhaseState.textContent = 'Supercritical Dense Phase';
          subPhaseState.className = 'font-bold text-purple-600 dark:text-purple-400';
        } else if (isSubcriticalLiquid) {
          subPhaseState.textContent = 'Sub-Critical Liquid CO2';
          subPhaseState.className = 'font-bold text-sky-600 dark:text-sky-400';
        } else {
          subPhaseState.textContent = 'Sub-Critical Gas Phase (Low Solvation)';
          subPhaseState.className = 'font-bold text-amber-600 dark:text-amber-400';
        }
      }

      if (outLog) outLog.textContent = logReduction.toFixed(2);
      if (barLog) {
        const logPct = Math.min(100, (logReduction / 7.0) * 100);
        barLog.style.width = `${logPct}%`;
      }
      if (subTargetMicrobe) {
        subTargetMicrobe.textContent = `Target: ${currentMicrobe.name.split(' ')[0]} ${currentMicrobe.name.split(' ')[1] || ''}`;
      }

      if (outPh) outPh.textContent = cytosolicPh.toFixed(2);
      if (barPh) {
        const phPct = Math.max(10, Math.min(100, ((7.4 - cytosolicPh) / 4.8) * 100));
        barPh.style.width = `${phPct}%`;
      }
      if (subPhState) {
        subPhState.textContent = cytosolicPh < 3.2 ? 'Lethal Carbonic Collapse' : 'Sub-Lethal Buffer Resistance';
        subPhState.className = cytosolicPh < 3.2 
          ? 'font-bold text-indigo-600 dark:text-indigo-400' 
          : 'font-bold text-amber-600 dark:text-amber-400';
      }

      if (outResidence) outResidence.textContent = residenceTimeMin.toFixed(2);
      if (barResidence) {
        const resPct = Math.min(100, (residenceTimeMin / 15.0) * 100);
        barResidence.style.width = `${resPct}%`;
      }
      if (subReactorVol) subReactorVol.textContent = `${reactorVolL.toFixed(1)} L`;

      if (outDpaRate) outDpaRate.textContent = `${dpaEfflux.toFixed(1)}% Efflux`;
      if (outAsmeMargin) {
        outAsmeMargin.textContent = `${asmeMargin.toFixed(2)}x MAWP Margin`;
        outAsmeMargin.className = asmeMargin >= 1.25 
          ? 'font-mono font-bold text-emerald-600 dark:text-emerald-400 text-sm mt-0.5 block'
          : asmeMargin >= 1.0 
          ? 'font-mono font-bold text-amber-600 dark:text-amber-400 text-sm mt-0.5 block'
          : 'font-mono font-bold text-red-600 dark:text-red-400 text-sm mt-0.5 block';
      }

      if (outDecompRisk) {
        outDecompRisk.textContent = currentMetal.explosiveDecompressionResistance.split(' ')[0] + ' ' + (currentMetal.explosiveDecompressionResistance.split(' ')[1] || '');
      }

      // Engineering Limitations & Action Text
      if (outPrimaryLimit) {
        if (pressureBar > mawp) {
          outPrimaryLimit.textContent = `CRITICAL ASME OVERPRESSURE VIOLATION: Operating pressure (${pressureBar} bar) exceeds vessel MAWP (${mawp} bar), risking catastrophic fatigue rupture.`;
        } else if (!isSupercritical) {
          outPrimaryLimit.textContent = `SUB-CRITICAL PHASE HAZARD: Operating below critical point (73.8 bar / 31.1°C) causes phase boundary separation, liquid-gas channeling, and inadequate spore solvation.`;
        } else if (residenceTimeMin < 2.0) {
          outPrimaryLimit.textContent = `INSUFFICIENT CONTACT TIME (${residenceTimeMin.toFixed(1)} min): High flow velocity truncates supercritical mass transfer, leaving spore DPA cores intact.`;
        } else if (tempC > currentMatrix.sensoryHeatThresholdC) {
          outPrimaryLimit.textContent = `THERMAL QUALITY DEGRADATION RISK: Process temperature (${tempC}°C) exceeds food heat threshold (${currentMatrix.sensoryHeatThresholdC}°C), causing protein coagulation or antioxidant loss.`;
        } else {
          outPrimaryLimit.textContent = `OPTIMAL SUPERCRITICAL REGIME: Dense-phase scCO2 (ρ = ${scDensity.toFixed(0)} kg/m³) delivers uniform micro-bubble saturation, lethal intracellular pH drop, and high spore lethality.`;
        }
      }

      if (outMitigationAction) {
        if (pressureBar > mawp) {
          outMitigationAction.textContent = `IMMEDIATE PRESSURE REDUCTION: Reduce high-pressure pump stroke or upgrade vessel to Autofrettaged 2205 Duplex Stainless Steel per ASME Section VIII Division 2.`;
        } else if (!isSupercritical) {
          outMitigationAction.textContent = `INCREASE OPERATING PRESSURE: Elevate pressure above 180 bar and temperature above 38°C to establish homogeneous dense supercritical solvation.`;
        } else {
          outMitigationAction.textContent = `MAINTAIN STANDARD STERILITY PROTOCOL: Perform routine seal inspection for explosive decompression blistering, monitor cyclone degasser backpressure, and verify 6-log lethality.`;
        }
      }

      // Banner Status
      const isCompliant = logReduction >= currentMicrobe.targetLogLethality && asmeMargin >= 1.25 && isSupercritical;
      const isMarginal = logReduction >= (currentMicrobe.targetLogLethality - 1.5) && asmeMargin >= 1.0;

      if (statusBanner && statusIcon && badgePill && statusHeading && statusDesc) {
        if (isCompliant) {
          statusBanner.className = 'border rounded-2xl p-5 transition-colors bg-emerald-500/10 border-emerald-500/30 text-emerald-950 dark:text-emerald-200';
          statusIcon.className = 'p-2 rounded-xl bg-emerald-500/20 text-emerald-600 dark:text-emerald-300 mt-0.5';
          badgePill.className = 'px-2.5 py-0.5 rounded-full text-xs font-bold uppercase bg-emerald-600 text-white';
          badgePill.textContent = 'FDA LACF 6-LOG STERILITY';
          statusHeading.textContent = 'Fully Compliant Supercritical CO2 Spore Lethality & Structural Integrity';
          statusDesc.textContent = `Dense-phase scCO2 achieves ${logReduction.toFixed(2)} Log10 inactivation of target endospores with ${asmeMargin.toFixed(2)}x ASME vessel safety margin.`;
        } else if (isMarginal) {
          statusBanner.className = 'border rounded-2xl p-5 transition-colors bg-amber-500/10 border-amber-500/30 text-amber-950 dark:text-amber-200';
          statusIcon.className = 'p-2 rounded-xl bg-amber-500/20 text-amber-600 dark:text-amber-300 mt-0.5';
          badgePill.className = 'px-2.5 py-0.5 rounded-full text-xs font-bold uppercase bg-amber-600 text-white';
          badgePill.textContent = 'MARGINAL / SUB-STERILITY';
          statusHeading.textContent = 'Marginal Inactivation — Below 6-Log Commercial Sterility Standard';
          statusDesc.textContent = `Spore lethality (${logReduction.toFixed(2)} Log10) fails to guarantee total shelf stability for low-acid food distribution. Increase pressure or residence time.`;
        } else {
          statusBanner.className = 'border rounded-2xl p-5 transition-colors bg-red-500/10 border-red-500/30 text-red-950 dark:text-red-200';
          statusIcon.className = 'p-2 rounded-xl bg-red-500/20 text-red-600 dark:text-red-300 mt-0.5';
          badgePill.className = 'px-2.5 py-0.5 rounded-full text-xs font-bold uppercase bg-red-600 text-white';
          badgePill.textContent = 'NON-COMPLIANT / VESSEL HAZARD';
          statusHeading.textContent = 'Process Invalidation — Spore Survival or ASME Overpressure';
          statusDesc.textContent = `System operating under sub-critical phase collapse or exceeding pressure vessel rating. High microbial intoxication risk or vessel mechanical failure.`;
        }
      }
    }

    // Attach listeners
    [sysSelect, matrixSelect, microbeSelect, metalSelect, pressureSlider, tempSlider, flowSlider, ratioSlider].forEach(el => {
      el.addEventListener('input', calculate);
      el.addEventListener('change', calculate);
    });

    // Preset handlers
    const btnApple = document.getElementById('btn-preset-apple');
    const btnEgg = document.getElementById('btn-preset-egg');
    const btnPlantMilk = document.getElementById('btn-preset-plantmilk');
    const btnPuree = document.getElementById('btn-preset-puree');
    const btnHazard = document.getElementById('btn-preset-hazard');

    if (btnApple) {
      btnApple.addEventListener('click', () => {
        sysSelect.value = 'pilot_continuous_supercritical_skid';
        matrixSelect.value = 'cloudy_apple_must';
        microbeSelect.value = 'alicyclobacillus_acidoterrestris';
        metalSelect.value = 'duplex_2205_kalrez';
        pressureSlider.value = '300';
        tempSlider.value = '48';
        flowSlider.value = '35';
        ratioSlider.value = '12';
        calculate();
      });
    }

    if (btnEgg) {
      btnEgg.addEventListener('click', () => {
        sysSelect.value = 'pilot_continuous_supercritical_skid';
        matrixSelect.value = 'liquid_whole_egg';
        microbeSelect.value = 'salmonella_enteritidis';
        metalSelect.value = 'hastelloy_c276_peek';
        pressureSlider.value = '350';
        tempSlider.value = '42';
        flowSlider.value = '45';
        ratioSlider.value = '14';
        calculate();
      });
    }

    if (btnPlantMilk) {
      btnPlantMilk.addEventListener('click', () => {
        sysSelect.value = 'industrial_high_pressure_scco2_train';
        matrixSelect.value = 'plant_almond_coconut_milk';
        microbeSelect.value = 'clostridium_botulinum';
        metalSelect.value = 'duplex_2205_kalrez';
        pressureSlider.value = '420';
        tempSlider.value = '52';
        flowSlider.value = '300';
        ratioSlider.value = '15';
        calculate();
      });
    }

    if (btnPuree) {
      btnPuree.addEventListener('click', () => {
        sysSelect.value = 'modular_dense_phase_puree_line';
        matrixSelect.value = 'wild_berry_anthocyanin_puree';
        microbeSelect.value = 'bacillus_cereus';
        metalSelect.value = 'standard_316l_ptfe';
        pressureSlider.value = '280';
        tempSlider.value = '40';
        flowSlider.value = '120';
        ratioSlider.value = '10';
        calculate();
      });
    }

    if (btnHazard) {
      btnHazard.addEventListener('click', () => {
        sysSelect.value = 'compromised_depressurization_hazard_skid';
        matrixSelect.value = 'cloudy_apple_must';
        microbeSelect.value = 'bacillus_cereus';
        metalSelect.value = 'degraded_304_epdm';
        pressureSlider.value = '95';
        tempSlider.value = '32';
        flowSlider.value = '400';
        ratioSlider.value = '4';
        calculate();
      });
    }

    // Initial Calculation
    calculate();
  });
</script>
