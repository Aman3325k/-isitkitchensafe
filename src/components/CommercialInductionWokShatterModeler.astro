const d = DICTIONARY[lang] || DICTIONARY.en;
const data = wokData;
---

<div class="bg-surface-soft border border-hairline rounded-3xl p-6 md:p-8 shadow-xs mb-10" id="induction-wok-modeler-root">
  <!-- Interactive Modeler Header -->
  <div class="flex flex-wrap items-center justify-between gap-3 pb-6 border-b border-hairline/80 mb-8">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-cyan-600/10 text-cyan-800 dark:text-cyan-300 border border-cyan-600/20 mb-2">
        <span>⚡</span>
        {d.badge}
      </div>
      <h2 class="text-2xl md:text-3xl font-extrabold text-ink tracking-tight">
        {d.title}
      </h2>
      <p class="text-sm text-muted mt-1 max-w-2xl">
        {d.subtitle}
      </p>
    </div>
    <div class="flex items-center gap-2">
      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-mono font-medium bg-surface text-ink border border-hairline">
        UL 197 Sec 39 &bull; IEC 60335-2-36 &bull; DIN EN 60335
      </span>
    </div>
  </div>

  <!-- Operational Presets -->
  <div class="mb-8">
    <div class="text-xs font-bold text-muted uppercase tracking-wider mb-3">
      {d.presetsTitle}
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5">
      <button 
        type="button" 
        class="preset-btn text-left p-3 rounded-xl border border-hairline bg-surface hover:bg-surface-alt transition-colors text-xs text-ink font-medium"
        data-preset="hong-kong-turbo"
      >
        <span class="block text-rose-600 font-bold mb-1">🔥 {lang === 'en' ? 'HK 35kW Jet Shatter' : lang === 'es' ? 'Hong Kong 35kW Peligro' : lang === 'pt' ? 'Hong Kong 35kW Perigo' : lang === 'zh-cn' ? '香港35kW爆炒炸裂' : '香港35kW急冷破砕危険'}</span>
        <span class="text-muted leading-tight block">{d.presetHongKongTurbo}</span>
      </button>

      <button 
        type="button" 
        class="preset-btn text-left p-3 rounded-xl border border-hairline bg-surface hover:bg-surface-alt transition-colors text-xs text-ink font-medium"
        data-preset="ul-gold-master"
      >
        <span class="block text-emerald-600 font-bold mb-1">🛡️ {lang === 'en' ? 'UL 197 Gold Master' : lang === 'es' ? 'UL 197 Maestro Oro' : lang === 'pt' ? 'UL 197 Padrão Ouro' : lang === 'zh-cn' ? 'UL 197黄金合规' : 'UL 197適合マスター'}</span>
        <span class="text-muted leading-tight block">{d.presetUlGoldMaster}</span>
      </button>

      <button 
        type="button" 
        class="preset-btn text-left p-3 rounded-xl border border-hairline bg-surface hover:bg-surface-alt transition-colors text-xs text-ink font-medium"
        data-preset="cast-iron-pounding"
      >
        <span class="block text-amber-600 font-bold mb-1">🔨 {lang === 'en' ? 'Cast Iron Pounding' : lang === 'es' ? 'Golpeteo de Hierro Fundido' : lang === 'pt' ? 'Impacto de Ferro Fundido' : lang === 'zh-cn' ? '粗生铁锅高危猛砸' : '重量鋳鉄鍋落下衝撃'}</span>
        <span class="text-muted leading-tight block">{d.presetCastIronPounding}</span>
      </button>

      <button 
        type="button" 
        class="preset-btn text-left p-3 rounded-xl border border-hairline bg-surface hover:bg-surface-alt transition-colors text-xs text-ink font-medium"
        data-preset="cradled-elastomer"
      >
        <span class="block text-cyan-600 font-bold mb-1">✨ {lang === 'en' ? 'PEEK Damped Safe' : lang === 'es' ? 'Amortiguado PEEK Seguro' : lang === 'pt' ? 'Amortecido PEEK Seguro' : lang === 'zh-cn' ? 'PEEK阻尼安全长寿' : 'PEEK緩衝低衝撃'}</span>
        <span class="text-muted leading-tight block">{d.presetCradledElastomer}</span>
      </button>
    </div>
  </div>

  <!-- Main Grid Controls & Diagnostic Card -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Left Column: Controls (7 cols) -->
    <div class="lg:col-span-7 space-y-6">
      <div class="border-b border-hairline/80 pb-3">
        <h3 class="text-lg font-bold text-ink tracking-tight">{d.controlsTitle}</h3>
        <p class="text-xs text-muted mt-0.5">{d.controlsSub}</p>
      </div>

      <!-- 1. Ceramic Basin Substrate -->
      <div>
        <label for="iw-basin-select" class="block text-xs font-bold text-ink uppercase tracking-wider mb-1.5">
          {d.basinLabel}
        </label>
        <select 
          id="iw-basin-select" 
          class="w-full bg-surface border border-hairline rounded-xl px-3.5 py-2.5 text-sm font-medium text-ink focus:outline-none focus:ring-2 focus:ring-cyan-500/50"
        >
          {data.ceramicBasinTypes.map((b) => (
            <option value={b.id} selected={b.id === 'schott_ceran_concave'}>
              {b.name} (MOR: {b.modulusOfRuptureMpa} MPa &bull; ΔT: {b.thermalShockResistanceDeltaT}°C)
            </option>
          ))}
        </select>
        <p class="text-xs text-muted mt-1.5">{d.basinHelp}</p>
      </div>

      <!-- 2. Wok Material Profile -->
      <div>
        <label for="iw-wok-select" class="block text-xs font-bold text-ink uppercase tracking-wider mb-1.5">
          {d.wokLabel}
        </label>
        <select 
          id="iw-wok-select" 
          class="w-full bg-surface border border-hairline rounded-xl px-3.5 py-2.5 text-sm font-medium text-ink focus:outline-none focus:ring-2 focus:ring-cyan-500/50"
        >
          {data.wokProfiles.map((w) => (
            <option value={w.id} selected={w.id === 'hand_hammered_carbon_steel'}>
              {w.name} ({w.massKg} kg &bull; Coupling: {(w.eddyCurrentCouplingEfficiency * 100).toFixed(0)}%)
            </option>
          ))}
        </select>
        <p class="text-xs text-muted mt-1.5">{d.wokHelp}</p>
      </div>

      <!-- 3. Coil Power Tier -->
      <div>
        <label for="iw-power-select" class="block text-xs font-bold text-ink uppercase tracking-wider mb-1.5">
          {d.powerLabel}
        </label>
        <select 
          id="iw-power-select" 
          class="w-full bg-surface border border-hairline rounded-xl px-3.5 py-2.5 text-sm font-medium text-ink focus:outline-none focus:ring-2 focus:ring-cyan-500/50"
        >
          {data.coilPowerTiers.map((p) => (
            <option value={p.id} selected={p.id === '15kw_standard_line'}>
              {p.name} ({p.magneticFluxDensityTesla} T &bull; Rise: {p.thermalRiseRateCperSec}°C/s)
            </option>
          ))}
        </select>
        <p class="text-xs text-muted mt-1.5">{d.powerHelp}</p>
      </div>

      <!-- 4. Thermal Quench Scenario -->
      <div>
        <label for="iw-quench-select" class="block text-xs font-bold text-ink uppercase tracking-wider mb-1.5">
          {d.quenchLabel}
        </label>
        <select 
          id="iw-quench-select" 
          class="w-full bg-surface border border-hairline rounded-xl px-3.5 py-2.5 text-sm font-medium text-ink focus:outline-none focus:ring-2 focus:ring-cyan-500/50"
        >
          {data.quenchScenarios.map((q) => (
            <option value={q.id} selected={q.id === 'room_temp_sauce'}>
              {q.name} (ΔT: {q.quenchDeltaTC}°C &bull; Stress: {q.thermalStressMpa} MPa)
            </option>
          ))}
        </select>
        <p class="text-xs text-muted mt-1.5">{d.quenchHelp}</p>
      </div>

      <!-- 5. Tossing Kinematics & Rim Impact -->
      <div>
        <label for="iw-tossing-select" class="block text-xs font-bold text-ink uppercase tracking-wider mb-1.5">
          {d.tossingLabel}
        </label>
        <select 
          id="iw-tossing-select" 
          class="w-full bg-surface border border-hairline rounded-xl px-3.5 py-2.5 text-sm font-medium text-ink focus:outline-none focus:ring-2 focus:ring-cyan-500/50"
        >
          {data.tossingImpactStyles.map((t) => (
            <option value={t.id} selected={t.id === 'active_tossing_light_taps'}>
              {t.name} (Impact: {t.impactForceN} N &bull; Stress: {t.mechanicalStressMpa} MPa)
            </option>
          ))}
        </select>
        <p class="text-xs text-muted mt-1.5">{d.tossingHelp}</p>
      </div>

      <!-- 6. Service Shift Duration Slider -->
      <div>
        <div class="flex items-center justify-between mb-1.5">
          <label for="iw-duration-slider" class="text-xs font-bold text-ink uppercase tracking-wider">
            {d.cycleLabel}
          </label>
          <span class="text-xs font-mono font-bold text-cyan-600" id="iw-duration-val">
            4.0 hrs
          </span>
        </div>
        <input 
          type="range" 
          id="iw-duration-slider" 
          min="1" 
          max="12" 
          step="0.5" 
          value="4" 
          class="w-full accent-cyan-600 bg-surface h-2 rounded-lg cursor-pointer border border-hairline"
        />
        <p class="text-xs text-muted mt-1.5">{d.cycleHelp}</p>
      </div>
    </div>

    <!-- Right Column: Diagnostic & Regulatory Assessment Card (5 cols) -->
    <div class="lg:col-span-5 bg-surface border border-hairline rounded-2xl p-6 shadow-xs space-y-6">
      <div class="border-b border-hairline/80 pb-3">
        <h3 class="text-lg font-bold text-ink tracking-tight flex items-center justify-between">
          <span>{d.diagnosticTitle}</span>
          <span class="inline-block w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse" id="iw-pulse-dot"></span>
        </h3>
        <p class="text-xs text-muted mt-0.5">{d.diagnosticSub}</p>
      </div>

      <!-- Key Diagnostic KPI 1: Critical Stress Ratio (CSR) -->
      <div class="bg-surface-soft border border-hairline rounded-xl p-4">
        <div class="text-xs text-muted font-medium mb-1">{d.csrLabel}</div>
        <div class="flex items-baseline gap-2">
          <span class="text-2xl md:text-3xl font-black text-ink tracking-tight" id="iw-csr-val">--</span>
          <span class="text-xs font-mono font-bold text-muted">CSR</span>
          <span class="text-xs font-bold px-2 py-0.5 rounded-full uppercase ml-auto" id="iw-csr-badge">--</span>
        </div>
        <div class="w-full bg-surface h-1.5 rounded-full overflow-hidden mt-3 border border-hairline">
          <div class="h-full bg-emerald-500 transition-all duration-300" id="iw-csr-bar" style="width: 35%"></div>
        </div>
      </div>

      <!-- Key Diagnostic KPI 2: Combined Tensile Stress vs MOR -->
      <div class="bg-surface-soft border border-hairline rounded-xl p-4">
        <div class="text-xs text-muted font-medium mb-1">{d.totalStressLabel}</div>
        <div class="flex items-baseline gap-2">
          <span class="text-2xl md:text-3xl font-black text-ink tracking-tight" id="iw-stress-val">--</span>
          <span class="text-xs font-mono font-bold text-muted">MPa</span>
          <span class="text-xs font-bold text-muted ml-auto" id="iw-mor-baseline">/ -- MPa MOR</span>
        </div>
        <div class="w-full bg-surface h-1.5 rounded-full overflow-hidden mt-3 border border-hairline">
          <div class="h-full bg-emerald-500 transition-all duration-300" id="iw-stress-bar" style="width: 40%"></div>
        </div>
      </div>

      <!-- Secondary KPIs: Thermal Shock & Mechanical Impact Stress -->
      <div class="grid grid-cols-2 gap-3">
        <div class="bg-surface-soft border border-hairline rounded-xl p-3">
          <div class="text-[11px] text-muted font-medium mb-0.5">{d.thermalShockStressLabel}</div>
          <div class="text-sm font-bold text-ink" id="iw-thermal-val">-- MPa</div>
          <div class="text-[11px] font-medium text-cyan-600 mt-1" id="iw-thermal-rate">-- °C/s</div>
        </div>
        <div class="bg-surface-soft border border-hairline rounded-xl p-3">
          <div class="text-[11px] text-muted font-medium mb-0.5">{d.dynamicImpactLabel}</div>
          <div class="text-sm font-bold text-ink" id="iw-impact-val">-- N</div>
          <div class="text-[11px] font-medium text-muted mt-1" id="iw-impact-stress">-- MPa Hertz</div>
        </div>
      </div>

      <!-- Acoustic Cavitation Metric -->
      <div class="bg-surface-soft border border-hairline rounded-xl p-3 flex items-center justify-between">
        <div>
          <div class="text-[11px] text-muted font-medium mb-0.5">{d.acousticCavitationLabel}</div>
          <div class="text-xs font-mono text-ink font-semibold" id="iw-acoustic-val">-- dB @ -- kHz</div>
        </div>
        <span class="text-xs font-bold px-2 py-0.5 rounded-full" id="iw-acoustic-badge">--</span>
      </div>

      <!-- Regulatory Status: UL 197 & IEC 60335-2-36 -->
      <div class="bg-surface-soft border border-hairline rounded-xl p-4 space-y-1">
        <div class="text-xs text-muted font-medium">{d.complianceLabel}</div>
        <div class="text-sm font-bold text-ink" id="iw-compliance-val">--</div>
        <p class="text-xs text-muted leading-relaxed" id="iw-compliance-desc">--</p>
      </div>

      <!-- Dominant Failure Mode -->
      <div class="bg-surface-soft border border-hairline rounded-xl p-4 space-y-1">
        <div class="text-xs text-muted font-medium">{d.failureModeLabel}</div>
        <div class="text-xs font-mono text-ink font-semibold" id="iw-failure-val">--</div>
      </div>

      <!-- Mechanism Details -->
      <div class="bg-surface-soft border border-hairline rounded-xl p-4 space-y-1">
        <div class="text-xs text-muted font-medium">{d.mechanismLabel}</div>
        <p class="text-xs text-muted leading-relaxed" id="iw-mechanism-text">--</p>
      </div>

      <!-- Engineering Mitigation Protocol -->
      <div class="bg-surface-soft border border-hairline rounded-xl p-4 space-y-1">
        <div class="text-xs text-muted font-medium">{d.mitigationLabel}</div>
        <p class="text-xs text-muted leading-relaxed" id="iw-mitigation-text">--</p>
      </div>

      <!-- Copy Report Button -->
      <div>
        <button 
          type="button" 
          id="iw-copy-report-btn" 
          class="w-full py-3 px-4 rounded-xl bg-ink text-surface font-semibold text-xs tracking-wide uppercase transition-transform active:scale-95 shadow-sm hover:opacity-90"
        >
          {d.copyReportBtn}
        </button>
        <p class="text-center text-xs text-emerald-600 font-semibold mt-1.5 hidden" id="iw-copied-feedback">
          {d.copiedFeedback}
        </p>
      </div>
    </div>
  </div>

  <!-- Comparative Engineering Matrix Table -->
  <div class="mt-12 pt-8 border-t border-hairline">
    <div class="mb-4">
      <h3 class="text-lg md:text-xl font-bold text-ink tracking-tight">{d.tableTitle}</h3>
      <p class="text-xs text-muted mt-0.5">{d.tableSub}</p>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-xs">
        <thead>
          <tr class="border-b border-hairline bg-surface-soft text-muted font-semibold uppercase tracking-wider">
            <th class="py-3 px-3.5">{d.colBasin}</th>
            <th class="py-3 px-3.5">{d.colMor}</th>
            <th class="py-3 px-3.5">{d.colCte}</th>
            <th class="py-3 px-3.5">{d.colKic}</th>
            <th class="py-3 px-3.5">{d.colDeltaT}</th>
            <th class="py-3 px-3.5">{d.colSpallation}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline text-ink">
          {data.ceramicBasinTypes.map((b) => (
            <tr class="hover:bg-surface/50 transition-colors">
              <td class="py-3 px-3.5 font-bold text-ink">{b.name}</td>
              <td class="py-3 px-3.5 font-mono">{b.modulusOfRuptureMpa} MPa</td>
              <td class="py-3 px-3.5 font-mono">{b.thermalExpansionCoefficient}</td>
              <td class="py-3 px-3.5 font-mono">{b.fractureToughnessKic} MPa&bull;m<sup>&frac12;</sup></td>
              <td class="py-3 px-3.5 font-mono">{b.thermalShockResistanceDeltaT}&deg;C</td>
              <td class="py-3 px-3.5 font-semibold">
                <span class={b.flawSpallationRisk === 'MINIMAL' ? 'text-emerald-600' : b.flawSpallationRisk === 'LOW' ? 'text-blue-600' : b.flawSpallationRisk === 'CRITICAL' ? 'text-amber-600' : 'text-rose-600 font-bold'}>
                  {b.flawSpallationRisk}
                </span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Critical Directives Rules Cards -->
  <div class="mt-12 pt-8 border-t border-hairline">
    <div class="mb-6">
      <h3 class="text-lg md:text-xl font-bold text-ink tracking-tight">{d.rulesTitle}</h3>
      <p class="text-xs text-muted mt-0.5">{d.rulesSub}</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="bg-surface border border-hairline rounded-2xl p-5">
        <div class="flex items-center gap-2 mb-2 text-rose-600 font-bold text-sm">
          <span>🚫</span>
          <h4>{d.rule1Title}</h4>
        </div>
        <p class="text-xs text-muted leading-relaxed">{d.rule1Text}</p>
      </div>

      <div class="bg-surface border border-hairline rounded-2xl p-5">
        <div class="flex items-center gap-2 mb-2 text-amber-600 font-bold text-sm">
          <span>🔨</span>
          <h4>{d.rule2Title}</h4>
        </div>
        <p class="text-xs text-muted leading-relaxed">{d.rule2Text}</p>
      </div>

      <div class="bg-surface border border-hairline rounded-2xl p-5">
        <div class="flex items-center gap-2 mb-2 text-blue-600 font-bold text-sm">
          <span>🔍</span>
          <h4>{d.rule3Title}</h4>
        </div>
        <p class="text-xs text-muted leading-relaxed">{d.rule3Text}</p>
      </div>

      <div class="bg-surface border border-hairline rounded-2xl p-5">
        <div class="flex items-center gap-2 mb-2 text-emerald-600 font-bold text-sm">
          <span>🛡️</span>
          <h4>{d.rule4Title}</h4>
        </div>
        <p class="text-xs text-muted leading-relaxed">{d.rule4Text}</p>
      </div>
    </div>
  </div>
</div>

<!-- Reactive Script -->
<script is:inline define:vars={{ data, currentLang: lang }}>
  (function initInductionWokModeler() {
    const basinSelect = document.getElementById('iw-basin-select');
    const wokSelect = document.getElementById('iw-wok-select');
    const powerSelect = document.getElementById('iw-power-select');
    const quenchSelect = document.getElementById('iw-quench-select');
    const tossingSelect = document.getElementById('iw-tossing-select');
    const durationSlider = document.getElementById('iw-duration-slider');
    const durationVal = document.getElementById('iw-duration-val');

    // Outputs
    const csrVal = document.getElementById('iw-csr-val');
    const csrBadge = document.getElementById('iw-csr-badge');
    const csrBar = document.getElementById('iw-csr-bar');
    const stressVal = document.getElementById('iw-stress-val');
    const morBaseline = document.getElementById('iw-mor-baseline');
    const stressBar = document.getElementById('iw-stress-bar');
    const thermalVal = document.getElementById('iw-thermal-val');
    const thermalRate = document.getElementById('iw-thermal-rate');
    const impactVal = document.getElementById('iw-impact-val');
    const impactStress = document.getElementById('iw-impact-stress');
    const acousticVal = document.getElementById('iw-acoustic-val');
    const acousticBadge = document.getElementById('iw-acoustic-badge');
    const complianceVal = document.getElementById('iw-compliance-val');
    const complianceDesc = document.getElementById('iw-compliance-desc');
    const failureVal = document.getElementById('iw-failure-val');
    const mechanismText = document.getElementById('iw-mechanism-text');
    const mitigationText = document.getElementById('iw-mitigation-text');
    const pulseDot = document.getElementById('iw-pulse-dot');
    const copyReportBtn = document.getElementById('iw-copy-report-btn');
    const copiedFeedback = document.getElementById('iw-copied-feedback');

    if (!basinSelect || !wokSelect) return;

    function recalculate() {
      const basinId = basinSelect.value;
      const wokId = wokSelect.value;
      const powerId = powerSelect.value;
      const quenchId = quenchSelect.value;
      const tossingId = tossingSelect.value;
      const durationHours = parseFloat(durationSlider.value);

      durationVal.textContent = durationHours.toFixed(1) + ' ' + (currentLang === 'ja' ? '時間' : currentLang === 'zh-cn' ? '小时' : 'hrs');

      const basin = data.ceramicBasinTypes.find(b => b.id === basinId) || data.ceramicBasinTypes[0];
      const wok = data.wokProfiles.find(w => w.id === wokId) || data.wokProfiles[0];
      const power = data.coilPowerTiers.find(p => p.id === powerId) || data.coilPowerTiers[1];
      const quench = data.quenchScenarios.find(q => q.id === quenchId) || data.quenchScenarios[1];
      const tossing = data.tossingImpactStyles.find(t => t.id === tossingId) || data.tossingImpactStyles[1];

      // 1. Thermal Shock Stress (MPa)
      // σ_thermal = E * α * ΔT / (1 - ν) * powerMultiplier
      const thermalStress = (quench.thermalStressMpa * power.stressMultiplier * (basin.thermalExpansionCoefficient / 0.05)).toFixed(1);

      // 2. Mechanical Dynamic Impact Stress (MPa)
      // σ_mech = mechanicalStress * wokMassFactor * impactMultiplier
      const dynamicImpactForce = (tossing.impactForceN * wok.impactForceMultiplier).toFixed(0);
      const mechanicalStress = (tossing.mechanicalStressMpa * wok.impactForceMultiplier * (1 / basin.acousticDampeningFactor)).toFixed(1);

      // 3. Acoustic Magnetostriction & Cyclic Fatigue Stress (MPa)
      const fatigueFactor = Math.min(1.45, 1.0 + (durationHours / 12) * 0.35);
      const acousticStress = (8.5 * power.stressMultiplier * (1 / basin.acousticDampeningFactor)).toFixed(1);

      // 4. Combined Total Tensile Stress (MPa)
      const totalTensileStress = (parseFloat(thermalStress) + parseFloat(mechanicalStress) + parseFloat(acousticStress)) * fatigueFactor;
      const calculatedTotalStress = totalTensileStress.toFixed(1);

      // 5. Critical Stress Ratio (CSR) = Total Stress / Effective MOR
      const csr = (totalTensileStress / basin.modulusOfRuptureMpa).toFixed(2);

      // DOM Updates
      csrVal.textContent = csr;
      if (csr < 0.40) {
        csrBadge.textContent = currentLang === 'es' ? 'SEGURO' : currentLang === 'pt' ? 'SEGURO' : currentLang === 'zh-cn' ? '安全受控' : currentLang === 'ja' ? '安全良好' : 'SAFE DUTY';
        csrBadge.className = 'text-xs font-bold px-2 py-0.5 rounded-full uppercase ml-auto bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20';
        csrBar.className = 'h-full bg-emerald-500 transition-all duration-300';
        csrBar.style.width = Math.min(100, (csr / 0.40) * 40) + '%';
      } else if (csr < 0.75) {
        csrBadge.textContent = currentLang === 'es' ? 'FATIGA MODERADA' : currentLang === 'pt' ? 'FADIGA MODERADA' : currentLang === 'zh-cn' ? '中度疲劳' : currentLang === 'ja' ? '中度疲労' : 'ELEVATED FATIGUE';
        csrBadge.className = 'text-xs font-bold px-2 py-0.5 rounded-full uppercase ml-auto bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20';
        csrBar.className = 'h-full bg-amber-500 transition-all duration-300';
        csrBar.style.width = Math.min(100, 40 + ((csr - 0.40) / 0.35) * 35) + '%';
      } else if (csr < 1.0) {
        csrBadge.textContent = currentLang === 'es' ? 'ALTO RIESGO FRACTURA' : currentLang === 'pt' ? 'ALTO RISCO FRATURA' : currentLang === 'zh-cn' ? '高危裂纹扩展' : currentLang === 'ja' ? '亀裂進展警戒' : 'CRITICAL CRACK RISK';
        csrBadge.className = 'text-xs font-bold px-2 py-0.5 rounded-full uppercase ml-auto bg-rose-500/10 text-rose-700 dark:text-rose-400 border border-rose-500/20';
        csrBar.className = 'h-full bg-rose-500 transition-all duration-300';
        csrBar.style.width = '90%';
      } else {
        csrBadge.textContent = currentLang === 'es' ? 'ROTURA EXPLOSIVA' : currentLang === 'pt' ? 'RUPTURA EXPLOSIVA' : currentLang === 'zh-cn' ? '瞬间粉碎性炸裂' : currentLang === 'ja' ? '破滅的爆縮破壊' : 'CATASTROPHIC SHATTER';
        csrBadge.className = 'text-xs font-bold px-2 py-0.5 rounded-full uppercase ml-auto bg-rose-600 text-white animate-pulse border border-rose-700';
        csrBar.className = 'h-full bg-rose-600 transition-all duration-300';
        csrBar.style.width = '100%';
      }

      stressVal.textContent = calculatedTotalStress;
      morBaseline.textContent = `/ ${basin.modulusOfRuptureMpa} MPa MOR`;
      stressBar.style.width = Math.min(100, (totalTensileStress / basin.modulusOfRuptureMpa) * 100) + '%';
      stressBar.className = totalTensileStress < basin.modulusOfRuptureMpa * 0.7 
        ? 'h-full bg-emerald-500 transition-all duration-300' 
        : totalTensileStress < basin.modulusOfRuptureMpa 
          ? 'h-full bg-amber-500 transition-all duration-300' 
          : 'h-full bg-rose-600 transition-all duration-300';

      thermalVal.textContent = thermalStress + ' MPa';
      thermalRate.textContent = (quench.coolingRateCperSec * power.stressMultiplier).toFixed(0) + ' °C/s';

      impactVal.textContent = dynamicImpactForce + ' N';
      impactStress.textContent = mechanicalStress + ' MPa Hertz';

      acousticVal.textContent = `${power.acousticVibrationDb} dB @ ${power.inverterFrequencyKhz} kHz`;
      acousticBadge.textContent = power.stressMultiplier > 1.4 ? 'TURBO HARMONIC' : 'NOMINAL';
      acousticBadge.className = power.stressMultiplier > 1.4 
        ? 'text-xs font-bold px-2 py-0.5 rounded-full bg-amber-500/10 text-amber-600 border border-amber-500/20' 
        : 'text-xs font-bold px-2 py-0.5 rounded-full bg-cyan-500/10 text-cyan-600 border border-cyan-500/20';

      // Regulatory Compliance
      if (csr < 0.75 && basin.modulusOfRuptureMpa >= 140) {
        complianceVal.textContent = 'PASS: UL 197 Section 39 & IEC 60335-2-36 Compliant';
        complianceVal.className = 'text-sm font-bold text-emerald-600';
        complianceDesc.textContent = currentLang === 'es' ? 'La resistencia mecánica y térmica del tazón supera ampliamente los criterios de prueba de bola de acero de 500g y choque de 700°C.' : currentLang === 'zh-cn' ? '微晶玻璃锅盆机械与热抗震裕度充足，符合UL 197 500g钢球150mm抗冲击测试与IEC 60335绝缘完整性规范。' : currentLang === 'ja' ? '機械強度および耐熱衝撃余裕が十分に確保され、UL 197鋼球落下試験およびIEC絶縁基準をクリア。' : 'Mechanical impact tolerance and thermal shock resistance exceed UL 197 500g steel ball drop standards and IEC 60335 insulation requirements.';
        pulseDot.className = 'inline-block w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse';
      } else if (csr < 1.0) {
        complianceVal.textContent = 'WARNING: Sub-Critical Flaw Propagation & Rim Fatigue';
        complianceVal.className = 'text-sm font-bold text-amber-600';
        complianceDesc.textContent = currentLang === 'es' ? 'Alerta: El estrés combinado supera el 75% del MOR. Riesgo inminente de propagación de microfisuras subsuperficiales de Griffith.' : currentLang === 'zh-cn' ? '警告：综合拉应力突破75%断裂模量，格里菲斯亚临界微裂纹进入失稳扩展区间，存在疲劳炸盆风险。' : currentLang === 'ja' ? '警告：合成応力がMORの75%を超過。内部の微小亀裂が繰返し疲労により進展し破損リスクが増大。' : 'Elevated tensile stress exceeds 75% of Modulus of Rupture. Cyclic sub-critical Griffith microcrack growth underway.';
        pulseDot.className = 'inline-block w-2.5 h-2.5 rounded-full bg-amber-500 animate-pulse';
      } else {
        complianceVal.textContent = 'BREACH: Catastrophic Fracture & 480V Arc Flash Hazard';
        complianceVal.className = 'text-sm font-bold text-rose-600';
        complianceDesc.textContent = currentLang === 'es' ? '¡PELIGRO EXTREMO!: Fractura instantánea de la vitrocerámica. Vertido de aceite hirviendo hacia el inversor trifásico de 480V con explosión por arco eléctrico.' : currentLang === 'zh-cn' ? '重大警报：微晶锅盆瞬时粉碎性炸裂！200°C沸油与汤汁倒灌入480V三相高压逆变器舱，极度危险电弧放电等离子爆燃！' : currentLang === 'ja' ? '重大警報：結晶化ガラス椀の瞬間爆縮破壊！200°C沸騰油とスープが480V三相インバータ基板へ流入し、高圧アーク爆発の致命的危険。' : 'Catastrophic rupture imminent! Ceramic bowl breaches, spilling 200°C oil into internal 480V 3-phase electronics, causing violent electrical arc flash blowout.';
        pulseDot.className = 'inline-block w-2.5 h-2.5 rounded-full bg-rose-500 animate-pulse';
      }

      failureVal.textContent = csr >= 1.0 
        ? 'Radial Tensile Hoop Shatter + Hertzian Cone Micro-Spallation' 
        : csr > 0.60 
          ? 'Thermal Contraction Wave Shock + Acoustic Fretting Fatigue' 
          : 'Nominal Microcrystalline Solid-Solution Elastic Deflection';

      mechanismText.textContent = quench.quenchDeltaTC > 300
        ? (currentLang === 'es' ? `El desglase con líquido frío produce un gradiente térmico de ${quench.quenchDeltaTC}°C a ${thermalRate.textContent}, generando ondas de tracción radial que amplifican microfisuras superficiales.` : currentLang === 'zh-cn' ? `极冷液体淬水在炒锅接触面产生高达${quench.quenchDeltaTC}°C温差与${thermalRate.textContent}冷却速率，热收缩瞬态应力波叠加${power.magneticFluxDensityTesla}T电磁涡流共振，突破微晶玻璃断裂韧性K_Ic。` : currentLang === 'ja' ? `${quench.quenchDeltaTC}°Cの冷水急冷により秒速${thermalRate.textContent}の熱収縮波が発生。局所的な引張応力集中が破壊靭性K_Icを超過。` : `Rapid ${quench.quenchDeltaTC}°C quench induces localized thermal contraction waves at ${thermalRate.textContent}, coupling with ${power.magneticFluxDensityTesla} T magnetic flux pulses to drive crack tip stress intensity past K_Ic.`)
        : (currentLang === 'es' ? `Tensión dominada por cargas mecánicas puntuales de ${dynamicImpactForce} N y gradientes térmicos radiales estables.` : currentLang === 'zh-cn' ? `以${dynamicImpactForce} N机械撞击动能与平稳径向热阶跃为主，微晶玻璃处于微观弹性形变安全包络线内部。` : currentLang === 'ja' ? `${dynamicImpactForce} Nの機械的接触応力と緩やかな径向温度勾配にとどまり、弾性限界内に保持。` : `Low thermal shock allows mechanical contact deceleration (${dynamicImpactForce} N) to remain within the safe elastic envelope of zero-expansion ceramic.`);

      mitigationText.textContent = csr >= 0.75
        ? (currentLang === 'es' ? 'Reemplace inmediatamente el tazón cerámico rayado, reduzca la potencia a 15 kW durante desglases y utilice caldos precalentados a >80°C con juntas PEEK.' : currentLang === 'zh-cn' ? '立即停用并更换刮花老化锅盆，将大温差烹汁功率降至15 kW以下，强制采用80°C以上预热老汤，并为底座加装PEEK减震阻尼圈。' : currentLang === 'ja' ? '傷の入ったボウルを即座に交換し、注水時は出力を15 kW以下に制限。80°C以上の予熱スープとPEEK緩衝パッキンを採用してください。' : 'Immediately replace scratched basins, down-throttle coil power during liquid additions, enforce >80°C preheated stock pouring, and install PEEK perimeter dampeners.')
        : (currentLang === 'es' ? 'Mantenga el salteado suave en cuna y limpie la arena y sal de la superficie diariamente para evitar rayaduras de Griffith.' : currentLang === 'zh-cn' ? '保持贴盆平滑摇锅翻炒习惯，每日彻底清理锅盆内外硬质粗盐与金属碎屑，防止格里菲斯表面擦伤。' : currentLang === 'ja' ? 'ゆりかご旋回動作を維持し、表面の塩粒や金属バリを毎日清掃してグリフィス微細傷の発生を防止してください。' : 'Maintain continuous cradled rocking and wipe abrasive grit and salt crystals daily to prevent initiating surface Griffith microcracks.');
    }

    // Attach Listeners
    basinSelect.addEventListener('change', recalculate);
    wokSelect.addEventListener('change', recalculate);
    powerSelect.addEventListener('change', recalculate);
    quenchSelect.addEventListener('change', recalculate);
    tossingSelect.addEventListener('change', recalculate);
    durationSlider.addEventListener('input', recalculate);

    // Presets
    const presetButtons = document.querySelectorAll('.preset-btn');
    presetButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const p = btn.getAttribute('data-preset');
        if (p === 'hong-kong-turbo') {
          basinSelect.value = 'schott_ceran_concave';
          wokSelect.value = 'heavy_spun_carbon_steel';
          powerSelect.value = '35kw_extreme_jet_wok';
          quenchSelect.value = 'ice_water_deglaze';
          tossingSelect.value = 'aggressive_slamming_heavy_pounding';
          durationSlider.value = '6';
        } else if (p === 'ul-gold-master') {
          basinSelect.value = 'schott_ceran_concave';
          wokSelect.value = 'hand_hammered_carbon_steel';
          powerSelect.value = '15kw_standard_line';
          quenchSelect.value = 'preheated_master_stock';
          tossingSelect.value = 'active_tossing_light_taps';
          durationSlider.value = '4';
        } else if (p === 'cast-iron-pounding') {
          basinSelect.value = 'aged_grit_scratched_ceramic';
          wokSelect.value = 'traditional_cast_iron_wok';
          powerSelect.value = '25kw_turbo_wok';
          quenchSelect.value = 'room_temp_sauce';
          tossingSelect.value = 'aggressive_slamming_heavy_pounding';
          durationSlider.value = '5';
        } else if (p === 'cradled-elastomer') {
          basinSelect.value = 'elastomer_damped_ceramic';
          wokSelect.value = 'hand_hammered_carbon_steel';
          powerSelect.value = '15kw_standard_line';
          quenchSelect.value = 'preheated_master_stock';
          tossingSelect.value = 'cradled_rocking_no_lift';
          durationSlider.value = '3';
        }
        recalculate();
      });
    });

    // Copy Report
    if (copyReportBtn) {
      copyReportBtn.addEventListener('click', () => {
        const text = `=== ISITKITCHENSAFE COMMERCIAL INDUCTION WOK SHATTER REPORT ===
Basin Substrate: ${basinSelect.options[basinSelect.selectedIndex].text}
Wok Alloy & Gauge: ${wokSelect.options[wokSelect.selectedIndex].text}
Coil Power Tier: ${powerSelect.options[powerSelect.selectedIndex].text}
Quench Scenario: ${quenchSelect.options[quenchSelect.selectedIndex].text}
Tossing Dynamic: ${tossingSelect.options[tossingSelect.selectedIndex].text}
Service Duration: ${durationSlider.value} hours

DIAGNOSTIC OUTCOMES:
- Critical Stress Ratio (CSR): ${csrVal.textContent} [${csrBadge.textContent}]
- Combined Tensile Stress: ${stressVal.textContent} MPa vs Basin MOR: ${morBaseline.textContent}
- Localized Quench Thermal Shock: ${thermalVal.textContent} (Cooling Rate: ${thermalRate.textContent})
- Mechanical Impact Force: ${impactVal.textContent} (${impactStress.textContent})
- Acoustic Vibration & Frequency: ${acousticVal.textContent} [${acousticBadge.textContent}]
- Compliance Status: ${complianceVal.textContent}
- Failure Mechanism: ${failureVal.textContent}
- Physics Formulation: ${mechanismText.textContent}
- Engineering Mitigation: ${mitigationText.textContent}
Audit Engine: IsItKitchenSafe Autonomous Growth & Ops Engine v2.0
=============================================================`;

        navigator.clipboard.writeText(text).then(() => {
          copiedFeedback.classList.remove('hidden');
          setTimeout(() => {
            copiedFeedback.classList.add('hidden');
          }, 3000);
        }).catch(err => {
          console.error('Clipboard copy failed:', err);
        });
      });
    }

    // Initial calculation
    recalculate();
  })();
</script>
