      </div>

      <!-- Temperature Slider -->
      <div class="space-y-2 bg-canvas border border-hairline/80 rounded-xl p-4">
        <div class="flex items-center justify-between text-xs font-semibold">
          <label for="temp-slider" class="text-muted">{d.tempLabel}</label>
          <div class="flex items-center gap-1 font-mono text-ink text-sm bg-surface-soft px-2.5 py-1 rounded-md border border-hairline">
            <span id="temp-f-display" class="font-bold text-amber-600">350</span>
            <span class="text-xs text-muted">°F</span>
            <span class="text-muted/60">/</span>
            <span id="temp-c-display" class="font-bold text-amber-600">177</span>
            <span class="text-xs text-muted">°C</span>
          </div>
        </div>
        <input 
          type="range" 
          id="temp-slider" 
