    </div>

    <!-- Real-Time Diagnostic Dashboard -->
    <div class="lg:col-span-6 bg-surface-soft border border-hairline rounded-2xl p-6 space-y-6 flex flex-col justify-between">
      <div class="space-y-6">
        <div class="border-b border-hairline pb-3">
          <h2 class="text-sm font-bold uppercase tracking-wider text-ink flex items-center justify-between">
            <span>{d.diagnosticTitle}</span>
            <span class="text-xs font-normal text-muted font-mono">Kinetic Output</span>
          </h2>
          <p class="text-xs text-muted mt-1">{d.diagnosticSub}</p>
