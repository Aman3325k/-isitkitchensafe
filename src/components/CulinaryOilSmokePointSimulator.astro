        </div>

        <!-- Key Metrics Cards (Thermal Delta & TPM) -->
        <div class="grid grid-cols-2 gap-4">
          <!-- Thermal Delta -->
          <div class="bg-canvas border border-hairline rounded-xl p-4 space-y-2">
            <div class="text-[11px] font-bold text-muted uppercase tracking-wider">
              {d.thermalMarginLabel}
            </div>
            <div id="thermal-margin-val" class="text-xl md:text-2xl font-black font-mono">
              -40°F
            </div>
            <div class="text-[10px] text-muted flex items-center justify-between">
              <span>{d.smokePointLabel}:</span>
              <span id="oil-smokepoint-text" class="font-bold text-ink">390°F (199°C)</span>
            </div>
          </div>

          <!-- Total Polar Materials -->
          <div class="bg-canvas border border-hairline rounded-xl p-4 space-y-2">
            <div class="text-[11px] font-bold text-muted uppercase tracking-wider">
              {d.tpmLabel}
            </div>
            <div class="flex items-baseline gap-1">
              <span id="tpm-val" class="text-xl md:text-2xl font-black font-mono">4.2%</span>
              <span class="text-xs text-muted">TPM</span>
            </div>
            <!-- TPM Progress Bar -->
            <div class="w-full bg-hairline rounded-full h-1.5 overflow-hidden">
              <div id="tpm-bar" class="h-full bg-emerald-500 transition-all duration-300" style="width: 15%;"></div>
            </div>
            <div class="text-[9px] text-muted truncate">
