              <div class="w-full bg-hairline rounded-full h-1.5 overflow-hidden">
                <div id="hne-bar" class="h-full bg-emerald-500 transition-all duration-300" style="width: 10%;"></div>
              </div>
            </div>

            <!-- MDA -->
            <div>
              <div class="flex justify-between text-xs mb-1">
                <span class="text-body font-medium">{d.mdaLabel}</span>
                <span id="mda-val" class="font-mono font-bold text-ink">12.1 µmol/kg</span>
              </div>
              <div class="w-full bg-hairline rounded-full h-1.5 overflow-hidden">
                <div id="mda-bar" class="h-full bg-emerald-500 transition-all duration-300" style="width: 12%;"></div>
              </div>
            </div>

            <!-- Acrolein -->
            <div>
              <div class="flex justify-between text-xs mb-1">
                <span class="text-body font-medium">{d.acroleinLabel}</span>
                <span id="acrolein-val" class="font-mono font-bold text-ink">0.02 ppm</span>
              </div>
              <div class="w-full bg-hairline rounded-full h-1.5 overflow-hidden">
                <div id="acrolein-bar" class="h-full bg-emerald-500 transition-all duration-300" style="width: 8%;"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Airway Alert Box (Hidden by default, shown when acrolein > 0.1 ppm) -->
        <div id="airway-alert" class="hidden rounded-xl p-4 bg-rose-500/10 border border-rose-500/30 text-rose-800 dark:text-rose-300 space-y-1">
          <div class="text-xs font-bold uppercase tracking-wide flex items-center gap-1.5">
            <span>{d.airwayAlertTitle}</span>
          </div>
          <p class="text-xs leading-relaxed">
            {d.airwayAlertText}
          </p>
        </div>

        <!-- Smart Oil Swap Recommendation Box -->
        <div id="swap-box" class="bg-canvas border border-hairline rounded-xl p-4 space-y-2">
          <div class="text-xs font-bold uppercase tracking-wider text-amber-700 dark:text-amber-400">
            {d.swapTitle}
          </div>
          <div id="swap-list" class="flex flex-wrap gap-2 pt-1">
            <!-- Dynamic swap pills -->
          </div>
        </div>
      </div>

      <!-- Action Button -->
      <div class="pt-4 border-t border-hairline">
        <button 
          id="copy-audit-btn" 
          type="button" 
          class="w-full py-3 px-4 rounded-xl bg-ink text-canvas hover:opacity-90 font-medium text-xs md:text-sm transition-all shadow-xs flex items-center justify-center gap-2"
        >
          {d.copyReportBtn}
        </button>
      </div>
    </div>
  </div>

  <!-- Educational Insight: Smoke Point vs Oxidative Stability Paradox -->
  <div class="bg-surface-soft border border-hairline rounded-2xl p-6 md:p-8 space-y-4">
    <div class="flex items-center gap-2 text-amber-600 dark:text-amber-400">
      <svg class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <h3 class="text-base md:text-lg font-bold text-ink">
        {d.paradoxTitle}
      </h3>
    </div>
    <p class="text-body text-xs md:text-sm leading-relaxed">
      {d.paradoxText}
    </p>

    <!-- Fatty Acid Profile Comparison Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-4 border-t border-hairline/60">
      <div class="bg-canvas border border-hairline rounded-xl p-4 space-y-1">
        <span class="text-xs font-bold text-emerald-600 block">Saturated Fatty Acids (SFA)</span>
        <span class="text-[11px] text-muted block font-mono">0 double bonds &bull; Immune to oxidation</span>
        <p class="text-xs text-body">Ghee (65%), Coconut (91%), Beef Tallow (50%). Thermally unbreakable; will not form 4-HNE.</p>
      </div>
      <div class="bg-canvas border border-hairline rounded-xl p-4 space-y-1">
        <span class="text-xs font-bold text-blue-600 block">Monounsaturated (MUFA / Oleic)</span>
        <span class="text-[11px] text-muted block font-mono">1 double bond &bull; High thermal resistance</span>
        <p class="text-xs text-body">EVOO (75%), Avocado Oil (74%), High-Oleic Sunflower (82%). Ideal balance of heart health and thermal stamina.</p>
      </div>
      <div class="bg-canvas border border-hairline rounded-xl p-4 space-y-1">
        <span class="text-xs font-bold text-rose-600 block">Polyunsaturated (PUFA / Linoleic)</span>
        <span class="text-[11px] text-muted block font-mono">2+ double bonds &bull; Hyper-reactive to heat</span>
        <p class="text-xs text-body">Corn (59%), Soybean (61%), Sunflower (69%), Grapeseed (74%). Readily decomposes into cytotoxic 4-HNE, MDA, and acrolein.</p>
      </div>
    </div>
  </div>

  <!-- Companion Tools Navigation -->
  <div class="border-t border-hairline pt-8 space-y-4">
    <h4 class="text-xs font-bold uppercase tracking-wider text-muted">
      {d.crossLinkTitle}
    </h4>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
      <a href={`${prefix}/tools/food-contact-migration-predictor/`} class="p-3.5 rounded-xl border border-hairline bg-surface-soft hover:border-amber-500/50 hover:bg-canvas transition-all text-xs font-medium text-ink flex items-center justify-between">
        <span>{d.crossLinkMigration}</span>
        <span class="text-muted">&rarr;</span>
      </a>
      <a href={`${prefix}/tools/pan-scratch-inspector/`} class="p-3.5 rounded-xl border border-hairline bg-surface-soft hover:border-amber-500/50 hover:bg-canvas transition-all text-xs font-medium text-ink flex items-center justify-between">
        <span>{d.crossLinkPan}</span>
        <span class="text-muted">&rarr;</span>
      </a>
      <a href={`${prefix}/tools/toxic-leaching-scorecard/`} class="p-3.5 rounded-xl border border-hairline bg-surface-soft hover:border-amber-500/50 hover:bg-canvas transition-all text-xs font-medium text-ink flex items-center justify-between">
        <span>{d.crossLinkScorecard}</span>
        <span class="text-muted">&rarr;</span>
      </a>
      <a href={`${prefix}/tools/material-swap-calculator/`} class="p-3.5 rounded-xl border border-hairline bg-surface-soft hover:border-amber-500/50 hover:bg-canvas transition-all text-xs font-medium text-ink flex items-center justify-between">
        <span>{d.crossLinkSwap}</span>
        <span class="text-muted">&rarr;</span>
      </a>
      <a href={`${prefix}/tools/child-safety-toxic-ingestion-evaluator/`} class="p-3.5 rounded-xl border border-hairline bg-surface-soft hover:border-amber-500/50 hover:bg-canvas transition-all text-xs font-medium text-ink flex items-center justify-between">
        <span>{d.crossLinkChild}</span>
        <span class="text-muted">&rarr;</span>
      </a>
    </div>
  </div>
</div>

<script define:vars={{ oilData, d }}>
  document.addEventListener('DOMContentLoaded', () => {
    const root = document.querySelector('.culinary-oil-simulator-widget');
    if (!root) return;

    const oilSelect = root.querySelector('#oil-select');
    const tempSlider = root.querySelector('#temp-slider');
    const durationSlider = root.querySelector('#duration-slider');
    const reuseSelect = root.querySelector('#reuse-select');

    const tempFDisplay = root.querySelector('#temp-f-display');
    const tempCDisplay = root.querySelector('#temp-c-display');
    const durationDisplay = root.querySelector('#duration-display');

    const gradeBanner = root.querySelector('#grade-banner');
    const gradeBadge = root.querySelector('#grade-badge');
    const gradeStatusText = root.querySelector('#grade-status-text');
    const gradeExplanation = root.querySelector('#grade-explanation');

    const thermalMarginVal = root.querySelector('#thermal-margin-val');
    const oilSmokepointText = root.querySelector('#oil-smokepoint-text');

    const tpmVal = root.querySelector('#tpm-val');
    const tpmBar = root.querySelector('#tpm-bar');

    const hneVal = root.querySelector('#hne-val');
    const hneBar = root.querySelector('#hne-bar');

    const mdaVal = root.querySelector('#mda-val');
    const mdaBar = root.querySelector('#mda-bar');

    const acroleinVal = root.querySelector('#acrolein-val');
    const acroleinBar = root.querySelector('#acrolein-bar');

    const airwayAlert = root.querySelector('#airway-alert');
    const swapList = root.querySelector('#swap-list');
    const copyAuditBtn = root.querySelector('#copy-audit-btn');

    const presetBtns = root.querySelectorAll('.method-preset-btn');

    // Preset button click handling
    presetBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const tempF = btn.getAttribute('data-temp-f');
        const dur = btn.getAttribute('data-duration');
        if (tempF) tempSlider.value = tempF;
        if (dur) durationSlider.value = dur;
        presetBtns.forEach(b => b.classList.remove('border-amber-500', 'bg-amber-500/10'));
        btn.classList.add('border-amber-500', 'bg-amber-500/10');
        recalculate();
      });
    });

    function recalculate() {
      const selectedOilId = oilSelect.value;
      const oil = oilData.oils.find(o => o.id === selectedOilId) || oilData.oils[0];
      const tempF = parseInt(tempSlider.value, 10);
      const tempC = Math.round((tempF - 32) * 5 / 9);
      const durationMin = parseInt(durationSlider.value, 10);
      const reuseCycle = parseInt(reuseSelect.value, 10);
      const reuseMeta = oilData.reuseMultipliers.find(r => r.reuseCycle === reuseCycle) || oilData.reuseMultipliers[0];

      // Update temperature displays
      tempFDisplay.textContent = tempF;
      tempCDisplay.textContent = tempC;
      durationDisplay.textContent = durationMin;

      // Thermal Delta
      const deltaF = tempF - oil.smokePointF;
      oilSmokepointText.textContent = `${oil.smokePointF}°F (${oil.smokePointC}°C)`;

      if (deltaF > 0) {
        thermalMarginVal.textContent = `+${deltaF}°F OVER`;
        thermalMarginVal.className = 'text-xl md:text-2xl font-black font-mono text-rose-600 animate-pulse';
      } else {
        thermalMarginVal.textContent = `${deltaF}°F`;
        thermalMarginVal.className = 'text-xl md:text-2xl font-black font-mono text-emerald-600';
      }

      // Kinetic Simulation
      // Base TPM formula as a function of temperature, time, PUFA content, antioxidant protection, and reuse:
      // PUFA is ~100x more oxidizable than MUFA and ~1000x more than SFA.
      const pufaFactor = (oil.lipidProfile.pufaPercent / 100) * 3.5;
      const mufaFactor = (oil.lipidProfile.mufaPercent / 100) * 0.4;
      const sfaFactor = (oil.lipidProfile.sfaPercent / 100) * 0.05;
      const unsatScore = (pufaFactor + mufaFactor + sfaFactor);

      // Temperature factor (exponential Arrhenius scaling above 212°F / 100°C)
      const normalizedTemp = Math.max(0, tempF - 200);
      const tempKineticFactor = Math.pow(1.012, normalizedTemp);

      // Antioxidant suppression factor
      const antioxidantProtection = Math.max(0.35, 1 - (oil.antioxidantPpm / 800));

      // Time factor
      const timeFactor = Math.pow(durationMin / 15, 0.65);

      // Raw TPM accumulation
      let computedTpm = (2.2 + (unsatScore * tempKineticFactor * timeFactor * antioxidantProtection * oil.degradationRate)) * reuseMeta.factor + reuseMeta.tpmAddition;
      if (deltaF > 0) {
        // Severe pyrolysis boost if past smoke point
        computedTpm += (deltaF * 0.18);
      }
      computedTpm = Math.min(65.0, Math.max(1.5, Math.round(computedTpm * 10) / 10));

      tpmVal.textContent = `${computedTpm}%`;
      const tpmPercentWidth = Math.min(100, Math.round((computedTpm / 30) * 100));
      tpmBar.style.width = `${tpmPercentWidth}%`;

      if (computedTpm < 14) {
        tpmBar.className = 'h-full bg-emerald-500 transition-all duration-300';
      } else if (computedTpm < 24) {
        tpmBar.className = 'h-full bg-amber-500 transition-all duration-300';
      } else {
        tpmBar.className = 'h-full bg-rose-600 transition-all duration-300';
      }

      // 4-HNE Calculation (derived principally from linoleic omega-6 oxidation)
      const pufaRatio = oil.lipidProfile.pufaPercent / 100;
      let hneYield = (computedTpm * pufaRatio * 6.5 * (tempF > 320 ? 1.4 : 0.6) * reuseMeta.factor);
      if (deltaF > 0) hneYield *= 1.8;
      hneYield = Math.max(0.5, Math.round(hneYield * 10) / 10);
      hneVal.textContent = `${hneYield} µmol/kg`;
      const hneWidth = Math.min(100, Math.round((hneYield / 120) * 100));
      hneBar.style.width = `${hneWidth}%`;
      hneBar.className = hneYield < 30 ? 'h-full bg-emerald-500' : (hneYield < 80 ? 'h-full bg-amber-500' : 'h-full bg-rose-600');

      // MDA Calculation
      let mdaYield = (computedTpm * (pufaRatio * 0.8 + 0.15) * 5.2 * reuseMeta.factor);
      if (deltaF > 0) mdaYield *= 1.6;
      mdaYield = Math.max(0.8, Math.round(mdaYield * 10) / 10);
      mdaVal.textContent = `${mdaYield} µmol/kg`;
      const mdaWidth = Math.min(100, Math.round((mdaYield / 150) * 100));
      mdaBar.style.width = `${mdaWidth}%`;
      mdaBar.className = mdaYield < 40 ? 'h-full bg-emerald-500' : (mdaYield < 100 ? 'h-full bg-amber-500' : 'h-full bg-rose-600');

      // Acrolein Fume Calculation (exponentially spikes as temp approaches and passes smoke point)
      let acroleinPpm = 0.005;
      if (tempF > 300) {
        const proximityToSmoke = Math.max(0, tempF - (oil.smokePointF - 60));
        acroleinPpm = (0.01 + (proximityToSmoke * 0.003 * (oil.lipidProfile.pufaPercent > 30 ? 1.8 : 1.0)) * Math.sqrt(durationMin / 10)) * reuseMeta.factor;
      }
      if (deltaF > 0) {
        acroleinPpm += (deltaF * 0.015);
      }
      acroleinPpm = Math.min(3.5, Math.max(0.01, Math.round(acroleinPpm * 100) / 100));
      acroleinVal.textContent = `${acroleinPpm} ppm`;
      const acroleinWidth = Math.min(100, Math.round((acroleinPpm / 0.25) * 100));
      acroleinBar.style.width = `${acroleinWidth}%`;
      acroleinBar.className = acroleinPpm < 0.05 ? 'h-full bg-emerald-500' : (acroleinPpm < 0.1 ? 'h-full bg-amber-500' : 'h-full bg-rose-600');

      // Airway Hazard Alert
      if (acroleinPpm >= 0.1) {
        airwayAlert.classList.remove('hidden');
      } else {
        airwayAlert.classList.add('hidden');
      }

      // Grade Banner & Evaluation
      if (computedTpm < 12 && hneYield < 35 && deltaF <= -20 && acroleinPpm < 0.05) {
        gradeBanner.className = 'rounded-2xl p-5 border bg-emerald-500/10 border-emerald-500/30 text-emerald-950 dark:text-emerald-200 transition-all space-y-2';
        gradeBadge.className = 'px-3 py-1 rounded-full text-xs font-black tracking-wider uppercase bg-emerald-600 text-white';
        gradeBadge.textContent = 'GRADE A: OPTIMAL';
        gradeStatusText.textContent = d.statusOptimal;
        gradeExplanation.textContent = `${oil.name} is operating well within its thermal and oxidative comfort zone. Total polar materials (${computedTpm}%) are minimal, with virtually no toxic aldehydes or airway irritants formed.`;
      } else if (computedTpm < 20 && hneYield < 75 && deltaF <= 10 && acroleinPpm < 0.1) {
        gradeBanner.className = 'rounded-2xl p-5 border bg-amber-500/10 border-amber-500/30 text-amber-950 dark:text-amber-200 transition-all space-y-2';
        gradeBadge.className = 'px-3 py-1 rounded-full text-xs font-black tracking-wider uppercase bg-amber-600 text-white';
        gradeBadge.textContent = 'GRADE B: CAUTION';
        gradeStatusText.textContent = d.statusModerate;
        gradeExplanation.textContent = `${oil.name} is experiencing moderate thermal oxidation under ${tempF}°F for ${durationMin} minutes. Moderate free radical formation is occurring; consume promptly and avoid reusing this batch of oil.`;
      } else if (computedTpm < 25 && deltaF <= 25) {
        gradeBanner.className = 'rounded-2xl p-5 border bg-orange-500/10 border-orange-500/30 text-orange-950 dark:text-orange-200 transition-all space-y-2';
        gradeBadge.className = 'px-3 py-1 rounded-full text-xs font-black tracking-wider uppercase bg-orange-600 text-white';
        gradeBadge.textContent = 'GRADE C: HAZARD';
        gradeStatusText.textContent = d.statusHazard;
        gradeExplanation.textContent = `High lipid peroxidation detected. 4-HNE (${hneYield} µmol/kg) and polar materials (${computedTpm}%) are elevated. Regular dietary exposure to these oxidized lipids contributes to systemic inflammation and vascular stress.`;
      } else {
        gradeBanner.className = 'rounded-2xl p-5 border bg-rose-500/15 border-rose-500/40 text-rose-950 dark:text-rose-200 transition-all space-y-2';
        gradeBadge.className = 'px-3 py-1 rounded-full text-xs font-black tracking-wider uppercase bg-rose-700 text-white animate-pulse';
        gradeBadge.textContent = 'GRADE D/F: TOXIC';
        gradeStatusText.textContent = d.statusCritical;
        gradeExplanation.textContent = `CRITICAL DEGRADATION WARNING: ${oil.name} is actively decomposing at ${tempF}°F. Total polar compounds (${computedTpm}%) breach the EU 24% legal food safety threshold. Volatile acrolein (${acroleinPpm} ppm) and mutagenic aldehydes are flooding the kitchen air. Discard oil immediately.`;
      }

      // Smart Swaps List
      swapList.innerHTML = '';
      const recommended = oil.swapsForHighHeat && oil.swapsForHighHeat.length > 0 ? oil.swapsForHighHeat : ['avocado-refined', 'ghee'];
      recommended.forEach(swapId => {
        const swapOil = oilData.oils.find(o => o.id === swapId);
        if (swapOil) {
          const pill = document.createElement('button');
          pill.type = 'button';
          pill.className = 'px-3 py-1.5 rounded-lg bg-surface border border-hairline hover:border-amber-500 text-xs font-medium text-ink flex items-center gap-1.5 transition-all';
          pill.innerHTML = `<strong>${swapOil.name}</strong> <span class="text-muted font-mono text-[10px]">(${swapOil.smokePointF}°F / OSI ${swapOil.oxidativeStabilityHours}h)</span>`;
          pill.addEventListener('click', () => {
            oilSelect.value = swapOil.id;
            recalculate();
          });
          swapList.appendChild(pill);
        }
      });
    }

    // Event listeners
    oilSelect.addEventListener('change', recalculate);
    tempSlider.addEventListener('input', recalculate);
    durationSlider.addEventListener('input', recalculate);
    reuseSelect.addEventListener('change', recalculate);

    // Initial calculation
    recalculate();

    // Copy Audit Report button
    copyAuditBtn.addEventListener('click', () => {
      const selectedOilId = oilSelect.value;
      const oil = oilData.oils.find(o => o.id === selectedOilId) || oilData.oils[0];
      const tempF = tempSlider.value;
      const tempC = Math.round((tempF - 32) * 5 / 9);
      const durationMin = durationSlider.value;
      const reuseText = reuseSelect.options[reuseSelect.selectedIndex].text;

      const report = `=====================================================
ISITKITCHENSAFE - CULINARY OIL OXIDATION & ALDEHYDE AUDIT
=====================================================
Date: ${new Date().toISOString().split('T')[0]}
Evaluated Oil: ${oil.name}
Standard Smoke Point: ${oil.smokePointF}°F (${oil.smokePointC}°C)
Fatty Acid Profile: SFA ${oil.lipidProfile.sfaPercent}% | MUFA ${oil.lipidProfile.mufaPercent}% | PUFA ${oil.lipidProfile.pufaPercent}%
Antioxidant Content: ${oil.polyphenolAntioxidantContent} (~${oil.antioxidantPpm} ppm)
Oxidative Stability Index (OSI): ${oil.oxidativeStabilityHours} hours

COOKING PARAMETERS:
- Surface Temperature: ${tempF}°F (${tempC}°C)
- Heating Duration: ${durationMin} minutes
- Oil Reuse Cycle: ${reuseText}

DIAGNOSTIC FINDINGS:
- Thermal Margin: ${thermalMarginVal.textContent}
- Total Polar Materials (TPM): ${tpmVal.textContent} (EU Discard Limit: 24%)
- Cytotoxic 4-HNE: ${hneVal.textContent}
- Mutagenic MDA: ${mdaVal.textContent}
- Inhaled Acrolein Plume: ${acroleinVal.textContent}
- Overall Safety Status: ${gradeBadge.textContent} - ${gradeStatusText.textContent}

SCIENTIFIC VERDICT:
${gradeExplanation.textContent}

Standards Benchmarked: Codex Alimentarius CXS 210-1999, EU Regulation 2019/343, IARC Monograph Vol. 95.
Generated at: https://isitkitchensafe.com/tools/culinary-oil-smoke-point-simulator/
=====================================================`;

      navigator.clipboard.writeText(report).then(() => {
        const originalText = copyAuditBtn.textContent;
        copyAuditBtn.textContent = d.reportCopied;
        copyAuditBtn.classList.add('bg-emerald-700', 'text-white');
        setTimeout(() => {
          copyAuditBtn.textContent = originalText;
          copyAuditBtn.classList.remove('bg-emerald-700', 'text-white');
        }, 2500);
      });
    });
  });
</script>
