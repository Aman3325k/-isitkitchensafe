        <!-- Aldehydes Breakdown -->
        <div class="bg-canvas border border-hairline rounded-xl p-5 space-y-3">
          <div class="text-xs font-bold uppercase tracking-wider text-muted flex items-center justify-between">
            <span>{d.aldehydesTitle}</span>
            <span class="text-[10px] text-muted font-normal">µmol/kg &amp; ppm</span>
          </div>

          <div class="space-y-3 pt-1">
            <!-- 4-HNE -->
            <div>
              <div class="flex justify-between text-xs mb-1">
                <span class="text-body font-medium">{d.hneLabel}</span>
                <span id="hne-val" class="font-mono font-bold text-ink">8.4 µmol/kg</span>
