const prefix = lang === 'en' ? '' : `/${lang}`;
---

<div class="culinary-oil-simulator-widget bg-canvas border border-hairline rounded-3xl p-6 md:p-10 shadow-sm space-y-10" data-lang={lang}>
  <!-- Header Badge & Intro -->
  <div class="space-y-3">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20">
      <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
      <span>{d.badge}</span>
    </div>
    <h1 class="text-title-xl font-bold text-ink tracking-tight">
      {d.title}
    </h1>
    <p class="text-body text-sm md:text-base leading-relaxed max-w-4xl">
      {d.subtitle}
    </p>
  </div>

  <!-- Interactive Controls Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <div class="lg:col-span-6 bg-surface-soft border border-hairline rounded-2xl p-6 space-y-6">
      <div class="border-b border-hairline pb-3">
        <h2 class="text-sm font-bold uppercase tracking-wider text-ink flex items-center justify-between">
          <span>{d.controlsTitle}</span>
          <span class="text-xs font-normal text-muted font-mono">ASTM / Codex / IOC</span>
        </h2>
        <p class="text-xs text-muted mt-1">{d.controlsSub}</p>
      </div>

      <!-- Oil Selection -->
      <div class="space-y-2">
        <label for="oil-select" class="block text-xs font-bold uppercase tracking-wider text-muted">
          {d.oilLabel}
        </label>
        <select 
          id="oil-select" 
          class="w-full bg-canvas border border-hairline rounded-xl px-4 py-3 text-sm font-medium text-ink focus:outline-none focus:ring-2 focus:ring-amber-500 transition-all cursor-pointer"
        >
          {oilData.oils.map(oil => (
            <option value={oil.id}>
              {oil.name} — Smoke: {oil.smokePointF}°F ({oil.smokePointC}°C) [SFA {oil.lipidProfile.sfaPercent}% / MUFA {oil.lipidProfile.mufaPercent}% / PUFA {oil.lipidProfile.pufaPercent}%]
            </option>
          ))}
        </select>
      </div>

      <!-- Cooking Preset Buttons -->
      <div class="space-y-2">
        <label class="block text-xs font-bold uppercase tracking-wider text-muted">
          {d.methodLabel}
        </label>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
          {oilData.cookingMethods.map(m => (
            <button 
              type="button" 
