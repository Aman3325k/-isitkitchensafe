    presetsTitle: "店舗実運用プリセット＆代表シナリオ：",
    presetOverdueVinyl: "繁忙カフェで洗浄放置されたビニール管＆常温タワー（極めて深刻な細菌繁殖）",
    presetCertifiedNsf: "NSF/ANSI 18認証316Lステンレス本管＆隔週PAA洗浄（業界最高ゴールド標準）",
    presetWeekendDairy: "連休中にタップ内に残留したオーツミルクラテ（壊滅的な酸敗と悪臭）",
    presetOptimalEvoh: "3°C保冷庫内EVOHバリアチューブ＆混合ガス仕様（クリーン＆高品質）",
    diagnosticTitle: "配管バイオフィルム増殖＆出液衛生診断カード",
    diagnosticSub: "管内壁バイオフィルム厚（µm）、朝一番の注出液中CFU数/mL、優占微生物菌叢、および米国NSF/ANSI 18合規性を即時算出。",
    biofilmThicknessLabel: "管内バイオフィルム膜厚＆EPS密度",
    cfuPourLabel: "初杯注出液の生菌数 (CFU/mL, 衛生基準<100)",
    complianceLabel: "NSF/ANSI 18 および 米国FDAフードコード § 4-204.116 判定",
    taxaLabel: "優占微生物菌種と酸敗発酵代謝物",
    mechanismLabel: "配管生体物理機構とバイオフィルム吸着動力学",
    guidanceLabel: "店舗向けCIP化学洗浄是正プロトコル",
    scienceTitle: "配管物理学・菌体外ポリマー物質(EPS)と夜間滞留生態系",
    scienceSub: "高圧窒素ガス雰囲気、静置滞留、可塑剤表面孔隙がいかにして初期細菌付着を促し、洗浄剤に耐性を持つ強固なスライム膜へと進化させるか。",
    tableTitle: "業務用ドラフト配管材質の工学的比較マトリックス",
    tableSub: "表面粗さ、酸素透過度、耐薬品性、食品衛生認証規格の全項目比較。",
    colArch: "配管構造",
    colMat: "ポリマー / 合金素材",
    colRoughness: "表面粗さ (Ra µm)",
    colO2Perm: "酸素透過度",
    colAdhesion: "バイオフィルム付着度",
    colCompliance: "食品衛生認証",
    rulesTitle: "業務用ドラフトタップ使用における4つの絶対衛生原則",
    rulesSub: "細菌エンドトキシン誤飲、酸敗異臭、保健所による営業停止処分を防ぐための基本原則。",
    rule1Title: "1. 14日ごとの2段階CIP化学洗浄を例外なく義務付ける",
    rule1Text: "米ブルワーズ協会(BA)マニュアルおよびNSF/ANSI 18に基づき、配管は14日ごとに50〜60°Cの2〜3%苛性ソーダ溶液（油脂・タンパク質除去）と過酢酸（胞子・カビ殺菌）で洗浄しなければなりません。",
    rule2Title: "2. 非保冷配管にミルクや植物性ミルク飲料を決して通さない",
    rule2Text: "乳製品はpHを6.3以上に引き上げ、豊富な脂肪と糖分を供給します。夜間に5°Cを超える環境で放置されると、細菌数は数時間で<50から250,000 CFU/mL以上に爆発します。",
    rule3Title: "3. 変色・白濁・黒斑が生じたビニールホースは即座に新品交換する",
    rule3Text: "可塑化PVCチューブは圧力疲労で微小クラックが生じます。菌体やカビ菌糸がこの微細孔に入り込むと、薬剤による殺菌は不可能です。完全交換が必要です。",
    rule4Title: "4. 毎朝の営業開始前には初めの250〜350 mLを必ず捨て注ぎする",
    rule4Text: "非保冷のタップシャンク内に滞留したコーヒーは夜間に室温へ上昇します。開店一番の注出液は必ず廃棄し、夜間に剥離したバイオフィルム破片を洗い流してください。",
    copyReportBtn: "衛生診断レポートをクリップボードにコピー",
    copiedFeedback: "衛生診断レポートをコピーしました！"
  }
};

const d = DICTIONARY[lang];
---

<div class="cold-brew-nitro-modeler bg-surface-soft border border-hairline rounded-3xl p-6 md:p-10 mb-12 shadow-sm" id="cold-brew-nitro-modeler-app">
  <!-- Interactive Header -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-hairline/80 pb-6 mb-8">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-amber-600/10 text-amber-800 dark:text-amber-300 mb-2 border border-amber-600/20">
        <span>☕</span>
        {d.badge}
      </div>
      <h2 class="text-2xl md:text-3xl font-bold text-ink tracking-tight">
        {d.title}
      </h2>
      <p class="text-sm md:text-base text-muted mt-2 max-w-3xl leading-relaxed">
        {d.subtitle}
      </p>
    </div>

    <!-- Live Telemetry Tag -->
    <div class="flex items-center gap-2 px-4 py-2 rounded-2xl bg-surface border border-hairline shadow-xs self-start md:self-center">
      <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
      <span class="text-xs font-mono font-medium text-ink">NSF/ANSI 18 MODELER v2.0</span>
    </div>
  </div>

  <!-- Presets Bar -->
  <div class="mb-8">
    <div class="text-xs font-bold uppercase tracking-wider text-muted mb-3 flex items-center gap-2">
      <span>⚡</span> {d.presetsTitle}
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5">
      <button 
        type="button" 
        class="preset-btn text-left p-3 rounded-xl bg-surface border border-hairline hover:border-amber-500 hover:shadow-xs transition-all text-xs font-medium text-ink group" 
        data-preset="preset_overdue_vinyl_cafe"
      >
        <span class="block text-red-600 font-bold mb-1">🚨 {d.presetOverdueVinyl.split('(')[0]}</span>
        <span class="block text-[11px] text-muted line-clamp-1">{d.presetOverdueVinyl}</span>
      </button>

      <button 
        type="button" 
        class="preset-btn text-left p-3 rounded-xl bg-surface border border-hairline hover:border-amber-500 hover:shadow-xs transition-all text-xs font-medium text-ink group" 
        data-preset="preset_certified_nsf_trunk"
      >
        <span class="block text-emerald-600 font-bold mb-1">✨ {d.presetCertifiedNsf.split('(')[0]}</span>
        <span class="block text-[11px] text-muted line-clamp-1">{d.presetCertifiedNsf}</span>
      </button>

      <button 
        type="button" 
        class="preset-btn text-left p-3 rounded-xl bg-surface border border-hairline hover:border-amber-500 hover:shadow-xs transition-all text-xs font-medium text-ink group" 
        data-preset="preset_weekend_dairy_latte"
      >
        <span class="block text-amber-600 font-bold mb-1">🥛 {d.presetWeekendDairy.split('(')[0]}</span>
        <span class="block text-[11px] text-muted line-clamp-1">{d.presetWeekendDairy}</span>
      </button>

      <button 
        type="button" 
        class="preset-btn text-left p-3 rounded-xl bg-surface border border-hairline hover:border-amber-500 hover:shadow-xs transition-all text-xs font-medium text-ink group" 
        data-preset="preset_optimal_evoh_clean"
      >
        <span class="block text-blue-600 font-bold mb-1">🎯 {d.presetOptimalEvoh.split('(')[0]}</span>
        <span class="block text-[11px] text-muted line-clamp-1">{d.presetOptimalEvoh}</span>
      </button>
    </div>
  </div>

  <!-- Main Controls Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-10">
    <div class="lg:col-span-7 space-y-6">
      <div class="bg-surface rounded-2xl p-6 border border-hairline shadow-xs">
        <h3 class="text-base font-bold text-ink mb-1">{d.controlsTitle}</h3>
        <p class="text-xs text-muted mb-6">{d.controlsSub}</p>

        <div class="space-y-5">
          <!-- 1. Tubing Architecture -->
          <div>
            <label for="input-arch" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5">
              {d.archLabel}
            </label>
            <select id="input-arch" class="w-full text-xs rounded-xl bg-surface-soft border border-hairline px-3 py-2.5 text-ink font-medium focus:outline-none focus:ring-2 focus:ring-amber-500/30">
              {nitroData.draftLineArchitectures.map(a => (
                <option value={a.id}>{a.name}</option>
              ))}
            </select>
            <p class="text-[11px] text-muted mt-1 leading-normal">{d.archHelp}</p>
          </div>

          <!-- 2. Operating Temperature -->
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label for="input-temp" class="text-xs font-bold uppercase tracking-wider text-ink">
                {d.tempLabel}
              </label>
              <span id="temp-display-val" class="text-xs font-mono font-semibold text-amber-700 dark:text-amber-400">
                3°C (37.4°F)
              </span>
            </div>
            <select id="input-temp" class="w-full text-xs rounded-xl bg-surface-soft border border-hairline px-3 py-2.5 text-ink font-medium focus:outline-none focus:ring-2 focus:ring-amber-500/30">
              {nitroData.operatingTemperatures.map(t => (
                <option value={t.id}>{t.name}</option>
              ))}
            </select>
            <p class="text-[11px] text-muted mt-1 leading-normal">{d.tempHelp}</p>
          </div>

          <!-- 3. Dispensing Duty Cycle & Stagnation -->
          <div>
            <label for="input-duty" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5">
              {d.dutyLabel}
            </label>
            <select id="input-duty" class="w-full text-xs rounded-xl bg-surface-soft border border-hairline px-3 py-2.5 text-ink font-medium focus:outline-none focus:ring-2 focus:ring-amber-500/30">
              {nitroData.stagnationDutyCycles.map(dc => (
                <option value={dc.id}>{dc.name}</option>
              ))}
            </select>
            <p class="text-[11px] text-muted mt-1 leading-normal">{d.dutyHelp}</p>
          </div>

          <!-- 4. Gas Atmosphere & Pressure -->
          <div>
            <label for="input-gas" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5">
              {d.gasLabel}
            </label>
            <select id="input-gas" class="w-full text-xs rounded-xl bg-surface-soft border border-hairline px-3 py-2.5 text-ink font-medium focus:outline-none focus:ring-2 focus:ring-amber-500/30">
              {nitroData.gasAtmospheres.map(g => (
                <option value={g.id}>{g.name}</option>
              ))}
            </select>
            <p class="text-[11px] text-muted mt-1 leading-normal">{d.gasHelp}</p>
          </div>

          <!-- 5. CIP Sanitation Protocol -->
          <div>
            <label for="input-cip" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5">
              {d.cipLabel}
            </label>
            <select id="input-cip" class="w-full text-xs rounded-xl bg-surface-soft border border-hairline px-3 py-2.5 text-ink font-medium focus:outline-none focus:ring-2 focus:ring-amber-500/30">
              {nitroData.cipSanitizationProtocols.map(c => (
                <option value={c.id}>{c.name}</option>
              ))}
            </select>
            <p class="text-[11px] text-muted mt-1 leading-normal">{d.cipHelp}</p>
          </div>

          <!-- 6. Coffee Substrate & Chemistry -->
          <div>
            <label for="input-substrate" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5">
              {d.substrateLabel}
            </label>
            <select id="input-substrate" class="w-full text-xs rounded-xl bg-surface-soft border border-hairline px-3 py-2.5 text-ink font-medium focus:outline-none focus:ring-2 focus:ring-amber-500/30">
              {nitroData.coffeeSubstrates.map(s => (
                <option value={s.id}>{s.name}</option>
              ))}
            </select>
            <p class="text-[11px] text-muted mt-1 leading-normal">{d.substrateHelp}</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Output & Visualizer Column -->
    <div class="lg:col-span-5 space-y-6">
      <div class="bg-surface rounded-2xl p-6 border border-hairline shadow-xs">
        <div class="flex items-center justify-between mb-2">
          <h3 class="text-base font-bold text-ink">{d.diagnosticTitle}</h3>
          <span id="badge-compliance" class="px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20">
            COMPLIANT
          </span>
        </div>
        <p class="text-xs text-muted mb-5 leading-normal">{d.diagnosticSub}</p>

        <!-- SVG Tubing Cross-Section Dynamic Diagram -->
        <div class="bg-surface-soft rounded-2xl p-4 border border-hairline mb-5 flex flex-col items-center">
          <svg viewBox="0 0 280 180" class="w-full max-w-[260px] h-auto" id="svg-cross-section">
            <!-- Outer Tubing Wall -->
            <circle cx="140" cy="90" r="76" fill="#e2e8f0" stroke="#94a3b8" stroke-width="4" id="svg-outer-wall" />
            <!-- Inner Polymer Lumen -->
            <circle cx="140" cy="90" r="62" fill="#3b2d24" id="svg-lumen-bg" />
            <!-- Biofilm EPS Slime Annulus (Scaled dynamically) -->
            <circle cx="140" cy="90" r="62" fill="none" stroke="#22c55e" stroke-width="3" id="svg-biofilm-ring" stroke-opacity="0.8" />
            <!-- Core Fluid Stream -->
            <circle cx="140" cy="90" r="50" fill="#261a12" id="svg-core-fluid" />
            
            <!-- Micro-bubbles and bacterial dots (dynamic) -->
            <g id="svg-spore-clusters">
              <circle cx="130" cy="85" r="2.5" fill="#f59e0b" opacity="0.8" />
              <circle cx="150" cy="95" r="2" fill="#ef4444" opacity="0.8" />
              <circle cx="138" cy="105" r="1.8" fill="#10b981" opacity="0.9" />
              <circle cx="144" cy="76" r="2.2" fill="#38bdf8" opacity="0.9" />
            </g>

            <!-- Text Annotation -->
            <text x="140" y="93" text-anchor="middle" fill="#ffffff" font-size="10" font-family="monospace" font-weight="bold" id="svg-text-flow">
              COLD FLOW
            </text>
            <text x="140" y="106" text-anchor="middle" fill="#94a3b8" font-size="8" font-family="monospace" id="svg-text-pressure">
              45 PSI
            </text>
          </svg>
          <div class="text-[11px] text-muted text-center mt-2 font-mono">
            Draft Tubing Lumen • 1/4" ID Cross-Section Model
          </div>
        </div>

        <!-- Metric 1: Biofilm Thickness -->
        <div class="mb-4">
          <div class="flex items-center justify-between text-xs mb-1">
            <span class="font-bold text-ink">{d.biofilmThicknessLabel}</span>
            <span id="metric-biofilm-thick" class="font-mono font-bold text-amber-700 dark:text-amber-400">
              0.8 µm (Low EPS)
            </span>
          </div>
          <div class="w-full bg-surface-soft h-2.5 rounded-full overflow-hidden border border-hairline">
            <div id="bar-biofilm" class="bg-emerald-500 h-full rounded-full transition-all duration-300" style="width: 12%"></div>
          </div>
          <div class="flex justify-between text-[10px] text-muted mt-1 font-mono">
            <span>0 µm (Sterile)</span>
            <span>20 µm (Visible Slime)</span>
            <span>80+ µm (Clogged)</span>
          </div>
        </div>

        <!-- Metric 2: CFU in Dispensed Pour -->
        <div class="mb-5">
          <div class="flex items-center justify-between text-xs mb-1">
            <span class="font-bold text-ink">{d.cfuPourLabel}</span>
            <span id="metric-cfu-pour" class="font-mono font-bold text-emerald-600">
              18 CFU/mL
            </span>
          </div>
          <div class="w-full bg-surface-soft h-2.5 rounded-full overflow-hidden border border-hairline">
            <div id="bar-cfu" class="bg-emerald-500 h-full rounded-full transition-all duration-300" style="width: 8%"></div>
          </div>
          <div class="flex justify-between text-[10px] text-muted mt-1 font-mono">
            <span>&lt;100 CFU (Sanitary)</span>
            <span>1,000 CFU (Warning)</span>
            <span>10,000+ CFU (Hazard)</span>
          </div>
        </div>

        <!-- Summary Status Block -->
        <div class="space-y-3 border-t border-hairline pt-4 text-xs">
          <div>
            <span class="font-bold text-ink block mb-0.5">{d.complianceLabel}:</span>
            <p id="desc-compliance" class="text-muted leading-relaxed font-mono text-[11px]">
              COMPLIANT: Within NSF/ANSI 18 § 5.2 sanitation threshold.
            </p>
          </div>
          <div>
            <span class="font-bold text-ink block mb-0.5">{d.taxaLabel}:</span>
            <p id="desc-taxa" class="text-muted leading-relaxed font-mono text-[11px]">
              Pseudomonas fluorescens suppressed by 3°C cold box; minimal acetic acid fermentation.
            </p>
          </div>
          <div>
            <span class="font-bold text-ink block mb-0.5">{d.guidanceLabel}:</span>
            <p id="desc-guidance" class="text-muted leading-relaxed font-mono text-[11px]">
              Maintain scheduled bi-weekly 2% NaOH + 0.2% PAA flush; purge first 120 mL prior to opening.
            </p>
          </div>
        </div>

        <!-- Copy Telemetry Button -->
        <div class="mt-6">
          <button 
            type="button" 
            id="btn-copy-report"
            class="w-full py-2.5 px-4 rounded-xl bg-amber-700 hover:bg-amber-800 text-white font-medium text-xs transition-colors shadow-xs flex items-center justify-center gap-2"
          >
            <span>📋</span>
            <span id="copy-btn-text">{d.copyReportBtn}</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Engineering Comparison Table -->
  <div class="bg-surface rounded-2xl p-6 md:p-8 border border-hairline shadow-xs mb-10 overflow-hidden">
    <div class="mb-6">
      <h3 class="text-lg md:text-xl font-bold text-ink mb-1">{d.tableTitle}</h3>
      <p class="text-xs md:text-sm text-muted">{d.tableSub}</p>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs border-collapse">
        <thead>
          <tr class="border-b border-hairline bg-surface-soft/60">
            <th class="p-3 font-bold text-ink">{d.colArch}</th>
            <th class="p-3 font-bold text-ink">{d.colMat}</th>
            <th class="p-3 font-bold text-ink">{d.colRoughness}</th>
            <th class="p-3 font-bold text-ink">{d.colO2Perm}</th>
            <th class="p-3 font-bold text-ink">{d.colAdhesion}</th>
            <th class="p-3 font-bold text-ink">{d.colCompliance}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline">
          {nitroData.draftLineArchitectures.map((arch) => (
            <tr class="hover:bg-surface-soft/40 transition-colors">
              <td class="p-3 font-medium text-ink">{arch.name.split('(')[0]}</td>
              <td class="p-3 text-muted">{arch.materialClass}</td>
              <td class="p-3 font-mono text-ink">{arch.surfaceRoughnessRaUm}</td>
              <td class="p-3 font-mono text-ink">{arch.oxygenGasPermeabilityCcM2Day}</td>
              <td class="p-3 text-muted">{arch.biofilmAdhesionIndex.split('(')[0]}</td>
              <td class="p-3">
                <span class={`inline-block px-2 py-0.5 rounded text-[10px] font-bold ${
                  arch.nsfStandard18Certified 
                    ? 'bg-emerald-500/10 text-emerald-700 dark:text-emerald-400' 
                    : 'bg-red-500/10 text-red-700 dark:text-red-400'
                }`}>
                  {arch.nsfStandard18Certified ? 'NSF 18 APPROVED' : 'NON-COMPLIANT'}
                </span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- 4 Mandatory Rules -->
  <div class="bg-surface rounded-2xl p-6 md:p-8 border border-hairline shadow-xs">
    <div class="mb-6">
      <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-amber-600/10 text-amber-800 dark:text-amber-300 mb-2 border border-amber-600/20">
        <span>🛡️</span> FOOD SAFETY PROTOCOLS
      </div>
      <h3 class="text-lg md:text-xl font-bold text-ink mb-1">{d.rulesTitle}</h3>
      <p class="text-xs md:text-sm text-muted">{d.rulesSub}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <div class="p-5 rounded-xl bg-surface-soft border border-hairline">
        <h4 class="text-xs md:text-sm font-bold text-ink mb-2">{d.rule1Title}</h4>
        <p class="text-xs text-muted leading-relaxed">{d.rule1Text}</p>
      </div>

      <div class="p-5 rounded-xl bg-surface-soft border border-hairline">
        <h4 class="text-xs md:text-sm font-bold text-ink mb-2">{d.rule2Title}</h4>
        <p class="text-xs text-muted leading-relaxed">{d.rule2Text}</p>
      </div>

      <div class="p-5 rounded-xl bg-surface-soft border border-hairline">
        <h4 class="text-xs md:text-sm font-bold text-ink mb-2">{d.rule3Title}</h4>
        <p class="text-xs text-muted leading-relaxed">{d.rule3Text}</p>
      </div>

      <div class="p-5 rounded-xl bg-surface-soft border border-hairline">
        <h4 class="text-xs md:text-sm font-bold text-ink mb-2">{d.rule4Title}</h4>
        <p class="text-xs text-muted leading-relaxed">{d.rule4Text}</p>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ nitroData, lang, d }}>
  document.addEventListener('DOMContentLoaded', () => {
    const archSelect = document.getElementById('input-arch');
    const tempSelect = document.getElementById('input-temp');
    const dutySelect = document.getElementById('input-duty');
    const gasSelect = document.getElementById('input-gas');
    const cipSelect = document.getElementById('input-cip');
    const substrateSelect = document.getElementById('input-substrate');
    const tempDisplay = document.getElementById('temp-display-val');

    const badgeCompliance = document.getElementById('badge-compliance');
    const metricBiofilm = document.getElementById('metric-biofilm-thick');
    const metricCfu = document.getElementById('metric-cfu-pour');
    const barBiofilm = document.getElementById('bar-biofilm');
    const barCfu = document.getElementById('bar-cfu');
    const descCompliance = document.getElementById('desc-compliance');
    const descTaxa = document.getElementById('desc-taxa');
    const descGuidance = document.getElementById('desc-guidance');

    const svgBiofilmRing = document.getElementById('svg-biofilm-ring');
    const svgSporeClusters = document.getElementById('svg-spore-clusters');
    const svgTextFlow = document.getElementById('svg-text-flow');
    const svgTextPressure = document.getElementById('svg-text-pressure');
    const svgOuterWall = document.getElementById('svg-outer-wall');

    const btnCopy = document.getElementById('btn-copy-report');
    const copyBtnText = document.getElementById('copy-btn-text');

    function calculateDiagnostics() {
      const arch = nitroData.draftLineArchitectures.find(a => a.id === archSelect.value) || nitroData.draftLineArchitectures[0];
      const temp = nitroData.operatingTemperatures.find(t => t.id === tempSelect.value) || nitroData.operatingTemperatures[0];
      const duty = nitroData.stagnationDutyCycles.find(dc => dc.id === dutySelect.value) || nitroData.stagnationDutyCycles[0];
      const gas = nitroData.gasAtmospheres.find(g => g.id === gasSelect.value) || nitroData.gasAtmospheres[0];
      const cip = nitroData.cipSanitizationProtocols.find(c => c.id === cipSelect.value) || nitroData.cipSanitizationProtocols[0];
      const substrate = nitroData.coffeeSubstrates.find(s => s.id === substrateSelect.value) || nitroData.coffeeSubstrates[0];

      tempDisplay.textContent = `${temp.celsius}°C (${(temp.celsius * 1.8 + 32).toFixed(1)}°F)`;

      // Biofilm Thickness Model (µm):
      // Base roughness + temperature growth * stagnation dwell / cleanability * substrate nutrient - CIP log reduction effect
      const cleanEff = arch.cleanabilityFactor;
      const tempMult = temp.microbialGrowthMultiplier;
      const dutyMult = duty.stagnationRiskMultiplier;
      const gasMult = gas.gasBiocidalFactor;
      const nutrientMult = substrate.nutritionalBioBurdenFactor;
      const cipLogKill = cip.logReduction;

      // Base uncleaned biomass accumulation
      let rawBiomassScore = (arch.surfaceRoughnessRaUm * 12) + (tempMult * 14) * (dutyMult * 1.8) * gasMult * nutrientMult;
      
      // CIP reduction factor: log kill mitigates biomass
      let netBiofilmUm = Math.max(0.1, (rawBiomassScore / Math.max(0.5, cipLogKill * 1.6)) / cleanEff);
      netBiofilmUm = Math.min(120, netBiofilmUm);

      // Pour CFU/mL calculation:
      // Base inoculum in stagnant lines sheared into first cup
      let rawCfu = (netBiofilmUm * 85) * (tempMult * 2.2) * (nutrientMult * 1.5) / Math.max(0.2, cipLogKill);
      if (duty.id === 'duty_high_throughput') rawCfu *= 0.3; // continuous flushing dilution
      let cfuCount = Math.round(Math.max(5, rawCfu));

      // Update UI Meters
      const biofilmPercent = Math.min(100, (netBiofilmUm / 80) * 100);
      barBiofilm.style.width = `${biofilmPercent}%`;

      const cfuPercent = Math.min(100, (cfuCount / 5000) * 100);
      barCfu.style.width = `${cfuPercent}%`;

      // Color coding
      if (netBiofilmUm < 5) {
        barBiofilm.className = 'bg-emerald-500 h-full rounded-full transition-all duration-300';
        metricBiofilm.className = 'font-mono font-bold text-emerald-600';
        metricBiofilm.textContent = `${netBiofilmUm.toFixed(1)} µm (Sanitary Low)`;
      } else if (netBiofilmUm < 25) {
        barBiofilm.className = 'bg-amber-500 h-full rounded-full transition-all duration-300';
        metricBiofilm.className = 'font-mono font-bold text-amber-600';
        metricBiofilm.textContent = `${netBiofilmUm.toFixed(1)} µm (Moderate Slime)`;
      } else {
        barBiofilm.className = 'bg-red-500 h-full rounded-full transition-all duration-300';
        metricBiofilm.className = 'font-mono font-bold text-red-600';
        metricBiofilm.textContent = `${netBiofilmUm.toFixed(1)} µm (Heavy Recalcitrant Slime)`;
      }

      if (cfuCount < 100) {
        barCfu.className = 'bg-emerald-500 h-full rounded-full transition-all duration-300';
        metricCfu.className = 'font-mono font-bold text-emerald-600';
        metricCfu.textContent = `${cfuCount.toLocaleString()} CFU/mL (Clean Drink)`;
      } else if (cfuCount < 1000) {
        barCfu.className = 'bg-amber-500 h-full rounded-full transition-all duration-300';
        metricCfu.className = 'font-mono font-bold text-amber-600';
        metricCfu.textContent = `${cfuCount.toLocaleString()} CFU/mL (Spreading Colonization)`;
      } else {
        barCfu.className = 'bg-red-500 h-full rounded-full transition-all duration-300';
        metricCfu.className = 'font-mono font-bold text-red-600';
        metricCfu.textContent = `${cfuCount.toLocaleString()} CFU/mL (Critical Microbial Spoilage)`;
      }

      // Compliance Status
      const isNsfOk = arch.nsfStandard18Certified && cfuCount < 500 && cip.frequencyDays <= 14 && temp.celsius <= 5;
      if (isNsfOk) {
        badgeCompliance.textContent = 'NSF 18 COMPLIANT';
        badgeCompliance.className = 'px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20';
        descCompliance.textContent = `COMPLIANT: Operating under sanitary cold-chain (<5°C) with validated 14-day CIP log kill.`;
      } else if (cfuCount < 2000 && arch.nsfStandard18Certified) {
        badgeCompliance.textContent = 'SANITARY WARNING';
        badgeCompliance.className = 'px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20';
        descCompliance.textContent = `WARNING: Biofilm growth active. Line temperature or CIP interval exceeds NSF 18 recommendation.`;
      } else {
        badgeCompliance.textContent = 'CRITICAL HEALTH HAZARD';
        badgeCompliance.className = 'px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-red-500/10 text-red-700 dark:text-red-400 border border-red-500/20';
        descCompliance.textContent = `NON-COMPLIANT: Severe microbial contamination. Violates FDA Food Code § 4-204.116 and NSF/ANSI 18.`;
      }

      // Dynamic Taxa Description
      if (substrate.id === 'substrate_nitro_latte_dairy') {
        descTaxa.textContent = `Lactobacillus & Listeria risk: Dairy proteins & lipids buffer coffee acidity, accelerating biofilm thickness by ${nutrientMult}x.`;
      } else if (temp.celsius >= 18) {
        descTaxa.textContent = `Acetobacter & Cladosporium mold: Room temperature stagnation triggers acetic sour off-flavors and visible pellicle hyphae.`;
      } else if (cfuCount > 500) {
        descTaxa.textContent = `Pseudomonas fluorescens & Gluconobacter: Siderophore secretion and extracellular polysaccharide slime matrix established.`;
      } else {
        descTaxa.textContent = `Suppressed microbial activity: Pure cold brew matrix under nitrogen pressure maintains stable baseline flora.`;
      }

      // Corrective Guidance
      if (!arch.nsfStandard18Certified) {
        descGuidance.textContent = `IMMEDIATE ACTION: Replace non-compliant or aged vinyl line with NSF/ANSI 18 certified EVOH barrier or 316L stainless steel tubing.`;
      } else if (cip.frequencyDays > 14) {
        descGuidance.textContent = `CORRECTIVE ACTION: Execute dual-stage 2% caustic wash (60°C) followed by 0.2% PAA rinse. Shorten cleaning interval to 14 days.`;
      } else if (temp.celsius > 5) {
        descGuidance.textContent = `TEMPERATURE CONTROL: Inspect glycol chiller bath and tower insulation to bring beverage temperature back down to ≤4°C (40°F).`;
      } else {
        descGuidance.textContent = `PREVENTIVE: System operating within clean master tolerances. Purge first 150 mL (5 oz) each morning prior to customer service.`;
      }

      // Update SVG Visualization
      const strokeThickness = Math.min(18, Math.max(2, (netBiofilmUm / 80) * 16));
      svgBiofilmRing.setAttribute('stroke-width', strokeThickness.toString());
      if (netBiofilmUm < 5) {
        svgBiofilmRing.setAttribute('stroke', '#10b981');
      } else if (netBiofilmUm < 25) {
        svgBiofilmRing.setAttribute('stroke', '#f59e0b');
      } else {
        svgBiofilmRing.setAttribute('stroke', '#ef4444');
      }

      svgTextPressure.textContent = `${gas.operatingPressurePsi} PSI`;
      svgTextFlow.textContent = `${temp.celsius}°C | ${duty.name.split('(')[0].trim()}`;

      // Show/hide outer wall styling based on material
      if (arch.id === 'ss316_rigid_trunk') {
        svgOuterWall.setAttribute('fill', '#94a3b8');
        svgOuterWall.setAttribute('stroke', '#cbd5e1');
      } else if (arch.id === 'aged_cloudy_vinyl') {
        svgOuterWall.setAttribute('fill', '#ca8a04');
        svgOuterWall.setAttribute('stroke', '#713f12');
      } else {
        svgOuterWall.setAttribute('fill', '#e2e8f0');
        svgOuterWall.setAttribute('stroke', '#94a3b8');
      }
    }

    // Event listeners
    [archSelect, tempSelect, dutySelect, gasSelect, cipSelect, substrateSelect].forEach(el => {
      el.addEventListener('change', calculateDiagnostics);
    });

    // Preset Buttons
    document.querySelectorAll('.preset-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const presetKey = btn.getAttribute('data-preset');
        const preset = nitroData.presets.find(p => p.id === presetKey);
        if (preset) {
          archSelect.value = preset.architectureId;
          tempSelect.value = preset.tempId;
          dutySelect.value = preset.dutyId;
          gasSelect.value = preset.gasId;
          cipSelect.value = preset.cipId;
          substrateSelect.value = preset.substrateId;
          calculateDiagnostics();
        }
      });
    });

    // Copy Telemetry
    if (btnCopy) {
      btnCopy.addEventListener('click', () => {
        const textToCopy = `IsItKitchenSafe Diagnostic Telemetry [NSF/ANSI 18 Nitro Modeler v2.0]:
- Tubing Architecture: ${archSelect.options[archSelect.selectedIndex].text}
- Temperature: ${tempDisplay.textContent}
- Duty Cycle: ${dutySelect.options[dutySelect.selectedIndex].text}
- Gas Atmosphere: ${gasSelect.options[gasSelect.selectedIndex].text}
- CIP Protocol: ${cipSelect.options[cipSelect.selectedIndex].text}
- Substrate: ${substrateSelect.options[substrateSelect.selectedIndex].text}
- Biofilm Thickness: ${metricBiofilm.textContent}
- Dispensed CFU Count: ${metricCfu.textContent}
- Compliance Status: ${badgeCompliance.textContent}
- Taxa Evaluation: ${descTaxa.textContent}
- Corrective Guidance: ${descGuidance.textContent}`;

        navigator.clipboard.writeText(textToCopy).then(() => {
          copyBtnText.textContent = d.copiedFeedback;
          setTimeout(() => {
            copyBtnText.textContent = d.copyReportBtn;
          }, 2500);
        });
      });
    }

    // Initial calculation
    calculateDiagnostics();
  });
</script>
