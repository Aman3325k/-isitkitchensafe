---

<div class="space-y-10" id="emergency-triage-container">
  <!-- Life Safety Golden Rules Alert Banner -->
  <aside class="rounded-2xl border-2 border-red-600/30 bg-red-950/10 dark:bg-red-950/20 p-6 md:p-8 shadow-sm">
    <div class="flex items-start gap-4">
      <div class="w-10 h-10 rounded-xl bg-red-600 text-white flex items-center justify-center font-bold text-xl shrink-0 shadow-xs">
        ⚠️
      </div>
      <div class="space-y-3 flex-1">
        <div>
          <span class="text-[11px] font-bold uppercase tracking-wider text-red-600 dark:text-red-400 block mb-0.5">
            {d.badge}
          </span>
          <h2 class="text-title-lg md:text-title-xl font-medium text-ink tracking-tight">
            {d.goldenRulesTitle}
          </h2>
          <p class="text-xs md:text-sm text-body leading-relaxed">
            {d.goldenRulesSub}
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
          <div class="p-3.5 rounded-xl bg-surface-soft border border-hairline text-xs space-y-1">
            <span class="font-bold text-red-600 dark:text-red-400 uppercase tracking-wide block">1. No Water on Oil Fires</span>
            <p class="text-body leading-relaxed">{d.rule1}</p>
          </div>
          <div class="p-3.5 rounded-xl bg-surface-soft border border-hairline text-xs space-y-1">
            <span class="font-bold text-red-600 dark:text-red-400 uppercase tracking-wide block">2. Keep Appliance Doors Closed</span>
            <p class="text-body leading-relaxed">{d.rule2}</p>
          </div>
          <div class="p-3.5 rounded-xl bg-surface-soft border border-hairline text-xs space-y-1">
            <span class="font-bold text-red-600 dark:text-red-400 uppercase tracking-wide block">3. Evacuate Birds from Teflon</span>
            <p class="text-body leading-relaxed">{d.rule3}</p>
          </div>
        </div>

        <div class="pt-2 border-t border-hairline/60 flex flex-wrap items-center justify-between gap-3 text-xs">
          <div class="flex items-center gap-2 text-ink font-medium">
            <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>{d.hotlineTitle}:</span>
            <span class="text-muted font-normal">{d.poisonControl} &bull; {d.fireEmergency}</span>
          </div>
          <button
            type="button"
            id="btn-reset-all-checks"
            class="text-[11px] text-muted hover:text-ink font-medium underline cursor-pointer transition-colors"
          >
            {d.resetChecklists}
          </button>
        </div>
      </div>
    </div>
  </aside>

  <!-- Interactive Search and Filters Section -->
  <section class="space-y-4 bg-surface-soft border border-hairline rounded-2xl p-6">
    <div class="relative">
      <input
        type="search"
        id="emergency-search-input"
        placeholder={d.searchPlaceholder}
        class="w-full h-12 pl-11 pr-4 rounded-xl bg-canvas text-ink text-sm border border-hairline focus:outline-none focus:border-red-500 transition-colors shadow-xs"
        autocomplete="off"
      />
      <svg class="w-5 h-5 text-muted absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
    </div>

    <!-- Appliance Filter Buttons -->
    <div class="space-y-2">
      <span class="text-[11px] font-bold uppercase tracking-wider text-muted block">Appliance Scope:</span>
      <div class="flex flex-wrap items-center gap-2" id="appliance-filter-pills">
        <button type="button" data-appliance="all" class="app-pill active px-3.5 py-1.5 rounded-lg text-xs font-medium border border-ink bg-ink text-white transition-all cursor-pointer shadow-2xs">
          {d.filterAllApp}
        </button>
        <button type="button" data-appliance="microwave" class="app-pill px-3.5 py-1.5 rounded-lg text-xs font-medium border border-hairline bg-canvas text-body hover:text-ink hover:bg-surface-strong transition-all cursor-pointer shadow-2xs">
          {d.filterMicrowave}
        </button>
        <button type="button" data-appliance="oven" class="app-pill px-3.5 py-1.5 rounded-lg text-xs font-medium border border-hairline bg-canvas text-body hover:text-ink hover:bg-surface-strong transition-all cursor-pointer shadow-2xs">
          {d.filterOven}
        </button>
        <button type="button" data-appliance="dishwasher" class="app-pill px-3.5 py-1.5 rounded-lg text-xs font-medium border border-hairline bg-canvas text-body hover:text-ink hover:bg-surface-strong transition-all cursor-pointer shadow-2xs">
          {d.filterDishwasher}
        </button>
        <button type="button" data-appliance="freezer" class="app-pill px-3.5 py-1.5 rounded-lg text-xs font-medium border border-hairline bg-canvas text-body hover:text-ink hover:bg-surface-strong transition-all cursor-pointer shadow-2xs">
          {d.filterFreezer}
        </button>
        <button type="button" data-appliance="airfryer" class="app-pill px-3.5 py-1.5 rounded-lg text-xs font-medium border border-hairline bg-canvas text-body hover:text-ink hover:bg-surface-strong transition-all cursor-pointer shadow-2xs">
          {d.filterAirfryer}
        </button>
      </div>
    </div>

    <!-- Hazard Type Filter Buttons -->
    <div class="space-y-2 pt-2 border-t border-hairline/60">
      <span class="text-[11px] font-bold uppercase tracking-wider text-muted block">Hazard Class:</span>
      <div class="flex flex-wrap items-center gap-2" id="hazard-filter-pills">
        <button type="button" data-hazard="all" class="haz-pill active px-3 py-1 rounded-md text-xs font-medium border border-ink bg-ink text-white transition-all cursor-pointer">
          {d.filterHazAll}
        </button>
        <button type="button" data-hazard="fire-smoke" class="haz-pill px-3 py-1 rounded-md text-xs font-medium border border-hairline bg-canvas text-body hover:text-ink hover:bg-surface-strong transition-all cursor-pointer">
          {d.filterFire}
        </button>
        <button type="button" data-hazard="sparks-arcing" class="haz-pill px-3 py-1 rounded-md text-xs font-medium border border-hairline bg-canvas text-body hover:text-ink hover:bg-surface-strong transition-all cursor-pointer">
          {d.filterSparks}
        </button>
        <button type="button" data-hazard="explosion-pressure" class="haz-pill px-3 py-1 rounded-md text-xs font-medium border border-hairline bg-canvas text-body hover:text-ink hover:bg-surface-strong transition-all cursor-pointer">
          {d.filterExplosion}
        </button>
        <button type="button" data-hazard="chemical-fumes" class="haz-pill px-3 py-1 rounded-md text-xs font-medium border border-hairline bg-canvas text-body hover:text-ink hover:bg-surface-strong transition-all cursor-pointer">
          {d.filterFumes}
        </button>
        <button type="button" data-hazard="suds-volcano" class="haz-pill px-3 py-1 rounded-md text-xs font-medium border border-hairline bg-canvas text-body hover:text-ink hover:bg-surface-strong transition-all cursor-pointer">
          {d.filterSuds}
        </button>
      </div>
    </div>

    <div class="flex items-center justify-between text-xs text-muted pt-2 border-t border-hairline/60">
      <span id="results-count-text">
        {d.resultsShowing} <strong class="text-ink font-semibold" id="count-visible">12</strong> {d.resultsOf} 12 {d.resultsScenarios}
      </span>
      <span class="text-[11px] text-muted italic">Click checkboxes below to track your triage steps</span>
    </div>
  </section>

  <!-- Scenarios List -->
  <div class="space-y-8" id="scenarios-container">
    {emergenciesData.map((scenario) => {
      const isCritical = scenario.dangerLevel === 'critical';
      const isSevere = scenario.dangerLevel === 'severe';
      const isChemical = scenario.hazardType === 'chemical-fumes';

      return (
        <article 
          class="scenario-card bg-surface-soft border border-hairline rounded-2xl p-6 md:p-8 space-y-6 shadow-xs transition-all hover:border-hairline-strong"
          data-scenario-id={scenario.id}
          data-appliance={scenario.appliance}
          data-hazard={scenario.hazardType}
          data-search-terms={`${scenario.title} ${scenario.description} ${scenario.immediateAction} ${scenario.appliance} ${scenario.hazardType}`.toLowerCase()}
        >
          <!-- Top Metadata Header -->
          <div class="flex flex-wrap items-center justify-between gap-3 border-b border-hairline pb-4">
            <div class="flex flex-wrap items-center gap-2">
              <span class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider ${
                isCritical 
                  ? 'bg-red-600 text-white ring-2 ring-red-500/30' 
                  : isSevere 
                    ? 'bg-orange-600 text-white ring-2 ring-orange-500/30' 
                    : isChemical
                      ? 'bg-purple-700 text-white'
                      : 'bg-amber-600 text-white'
              }`}>
                <span class="w-2 h-2 rounded-full bg-white animate-ping"></span>
                {scenario.dangerBadge}
              </span>

              <span class="px-2.5 py-0.5 rounded-md text-xs font-medium bg-canvas border border-hairline text-ink capitalize">
                {scenario.appliance === 'airfryer' ? 'Air Fryer' : scenario.appliance}
              </span>
            </div>

            <div class="flex items-center gap-2 text-xs text-muted">
              <span class="checklist-progress font-mono font-medium text-ink" data-for={scenario.id}>
                0 / {scenario.checklist.length} {d.progressDone}
              </span>
            </div>
          </div>

          <!-- Scenario Title and Physics Description -->
          <div class="space-y-2">
            <h3 class="text-title-lg md:text-title-xl font-medium text-ink tracking-tight">
              {scenario.title}
            </h3>
            <p class="text-body text-sm leading-relaxed">
              {scenario.description}
            </p>
          </div>

          <!-- IMMEDIATE FIRST ACTION HERO CALLOUT -->
          <div class="rounded-xl border-2 border-red-500/40 bg-red-600/10 dark:bg-red-950/40 p-4 md:p-5 flex items-start gap-3.5">
            <span class="text-2xl shrink-0 mt-0.5">🛑</span>
            <div class="space-y-1">
              <span class="text-[11px] font-black uppercase tracking-wider text-red-600 dark:text-red-400 block">
                {d.actionHeader}
              </span>
              <p class="font-bold text-ink text-sm md:text-base leading-snug">
                {scenario.immediateAction}
              </p>
            </div>
          </div>

          <!-- STEP-BY-STEP CONTAINMENT CHECKLIST -->
          <div class="space-y-3">
            <h4 class="text-xs font-bold uppercase tracking-wider text-muted flex items-center gap-1.5">
              <span>📋</span> {d.checklistHeader}
            </h4>

            <div class="space-y-2.5">
              {scenario.checklist.map((item) => (
                <label 
                  class="triage-check-item flex items-start gap-3 p-3.5 rounded-xl bg-canvas border border-hairline hover:bg-surface-soft transition-all cursor-pointer group"
                >
                  <input
                    type="checkbox"
                    class="triage-checkbox mt-1 w-4 h-4 rounded text-red-600 focus:ring-red-500 border-hairline shrink-0 cursor-pointer"
                    data-scenario={scenario.id}
                    data-step={item.step}
                  />
                  <div class="space-y-0.5 text-xs flex-1">
                    <span class="font-semibold text-ink group-hover:text-red-600 transition-colors block text-[13px] check-label">
                      Step {item.step}: {item.action}
                    </span>
                    <p class="text-body leading-relaxed check-detail">
                      {item.detail}
                    </p>
                  </div>
                </label>
              ))}
            </div>
          </div>

          <!-- WHAT NEVER TO DO (DANGER BOX) -->
          <div class="rounded-xl border border-red-500/30 bg-surface-soft p-4 space-y-2.5">
            <h4 class="text-xs font-bold uppercase tracking-wider text-red-600 dark:text-red-400 flex items-center gap-1.5">
              <span>🚫</span> {d.neverHeader}
            </h4>
            <ul class="space-y-1.5 text-xs text-body">
              {scenario.whatNeverToDo.map((rule) => (
                <li class="flex items-start gap-2">
                  <span class="text-red-500 font-bold shrink-0">&times;</span>
                  <span class="leading-relaxed">{rule}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- APPLIANCE REUSABILITY & DAMAGE VERDICT -->
          <details class="rounded-xl border border-hairline bg-canvas p-4 group">
            <summary class="text-xs font-semibold text-ink flex items-center justify-between cursor-pointer select-none">
              <span class="flex items-center gap-2">
                <span>🔧</span>
                <span>{d.applianceHealthHeader}</span>
                <span class={`px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider ${
                  scenario.applianceHealth.canReuse 
                    ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300' 
                    : 'bg-red-100 text-red-800 dark:bg-red-950/60 dark:text-red-300'
                }`}>
                  {scenario.applianceHealth.canReuse ? d.canReuseYes : d.canReuseNo}
                </span>
              </span>
              <span class="text-muted transition-transform group-open:rotate-180 text-xs">&darr;</span>
            </summary>

            <div class="pt-4 border-t border-hairline mt-3 space-y-3 text-xs">
              <div>
                <span class="font-semibold text-ink block mb-1">{d.inspectionTitle}</span>
                <ul class="list-disc list-inside space-y-1 text-body">
                  {scenario.applianceHealth.inspectionSteps.map((step) => (
                    <li>{step}</li>
                  ))}
                </ul>
              </div>

              <div>
                <span class="font-semibold text-red-600 dark:text-red-400 block mb-1">{d.replacementTitle}</span>
                <p class="text-body leading-relaxed">{scenario.applianceHealth.replacementSigns}</p>
              </div>

              <div class="pt-2 border-t border-hairline/60 text-[11px] text-muted">
                <span class="font-medium text-ink">{d.authorityTitle}</span> {scenario.authorityStandard}
              </div>
            </div>
          </details>
        </article>
      );
    })}
  </div>

  <!-- Empty State -->
  <div id="no-results-box" class="hidden text-center py-12 px-6 rounded-2xl bg-surface-soft border border-hairline">
    <div class="text-3xl mb-3">🔍</div>
    <h3 class="text-title-md font-medium text-ink mb-1">{d.noResultsTitle}</h3>
    <p class="text-xs text-muted max-w-md mx-auto">{d.noResultsSub}</p>
  </div>

  <!-- Cross-link Footer Banner -->
  <aside class="rounded-2xl border border-hairline bg-surface-soft p-6 md:p-8 flex flex-col md:flex-row items-center justify-between gap-6">
    <div class="space-y-1 text-center md:text-left">
      <h3 class="text-sm md:text-base font-semibold text-ink">{d.crossLinkTools}</h3>
      <p class="text-xs text-body">Examine coating integrity, microplastics, and material safety before emergencies happen.</p>
    </div>
    <div class="flex flex-wrap items-center justify-center gap-3 shrink-0">
      <a 
        href={lang === 'en' ? '/tools/pan-scratch-inspector/' : `/${lang}/tools/pan-scratch-inspector/`}
        class="py-2.5 px-4 rounded-xl bg-ink hover:bg-black text-white text-xs font-medium transition-colors shadow-xs"
      >
        <Fragment set:html={d.crossLinkPanInspector} />
      </a>
      <a 
        href={lang === 'en' ? '/tools/cookware-brand-transparency-index/' : `/${lang}/tools/cookware-brand-transparency-index/`}
        class="py-2.5 px-4 rounded-xl bg-emerald-700 hover:bg-emerald-800 text-white text-xs font-medium transition-colors shadow-xs"
      >
        <Fragment set:html={d.crossLinkBrandIndex} />
      </a>
      <a 
        href={lang === 'en' ? '/tools/product-recalls-scanner/' : `/${lang}/tools/product-recalls-scanner/`}
        class="py-2.5 px-4 rounded-xl bg-rose-600 hover:bg-rose-700 text-white text-xs font-medium transition-colors shadow-xs"
      >
        Barcode Recalls Scanner &rarr;
      </a>
    </div>
  </aside>
</div>

<script is:inline>
(function() {
  const container = document.getElementById('emergency-triage-container');
  if (!container) return;

  const searchInput = document.getElementById('emergency-search-input');
  const appPills = document.querySelectorAll('#appliance-filter-pills .app-pill');
  const hazPills = document.querySelectorAll('#hazard-filter-pills .haz-pill');
  const cards = document.querySelectorAll('.scenario-card');
  const noResults = document.getElementById('no-results-box');
  const countVisibleEl = document.getElementById('count-visible');
  const btnReset = document.getElementById('btn-reset-all-checks');

  let currentApp = 'all';
  let currentHaz = 'all';
  let searchQuery = '';

  function filterCards() {
    let visibleCount = 0;

    cards.forEach(card => {
      const cardApp = card.getAttribute('data-appliance');
      const cardHaz = card.getAttribute('data-hazard');
      const searchTerms = card.getAttribute('data-search-terms') || '';

      const matchApp = currentApp === 'all' || cardApp === currentApp;
      const matchHaz = currentHaz === 'all' || cardHaz === currentHaz;
      const matchSearch = !searchQuery || searchTerms.includes(searchQuery);

      if (matchApp && matchHaz && matchSearch) {
        card.classList.remove('hidden');
        visibleCount++;
      } else {
        card.classList.add('hidden');
      }
    });

    if (countVisibleEl) countVisibleEl.textContent = visibleCount.toString();
    if (noResults) {
      if (visibleCount === 0) {
        noResults.classList.remove('hidden');
      } else {
        noResults.classList.add('hidden');
      }
    }
  }

  // Search input handler
  if (searchInput) {
    searchInput.addEventListener('input', function(e) {
      searchQuery = (e.target.value || '').trim().toLowerCase();
      filterCards();
    });
  }

  // Appliance pill click handlers
  appPills.forEach(pill => {
    pill.addEventListener('click', function() {
      appPills.forEach(p => {
        p.classList.remove('active', 'bg-ink', 'text-white', 'border-ink');
        p.classList.add('bg-canvas', 'text-body', 'border-hairline');
      });
      this.classList.add('active', 'bg-ink', 'text-white', 'border-ink');
      this.classList.remove('bg-canvas', 'text-body', 'border-hairline');
      currentApp = this.getAttribute('data-appliance') || 'all';
      filterCards();
    });
  });

  // Hazard pill click handlers
  hazPills.forEach(pill => {
    pill.addEventListener('click', function() {
      hazPills.forEach(p => {
        p.classList.remove('active', 'bg-ink', 'text-white', 'border-ink');
        p.classList.add('bg-canvas', 'text-body', 'border-hairline');
      });
      this.classList.add('active', 'bg-ink', 'text-white', 'border-ink');
      this.classList.remove('bg-canvas', 'text-body', 'border-hairline');
      currentHaz = this.getAttribute('data-hazard') || 'all';
      filterCards();
    });
  });

  // Checkbox interactive progress tracking
  const checkboxes = document.querySelectorAll('.triage-checkbox');
  function updateScenarioProgress(scenarioId) {
    const scenarioBoxes = document.querySelectorAll(`.triage-checkbox[data-scenario="${scenarioId}"]`);
    let checkedCount = 0;
    scenarioBoxes.forEach(cb => {
      const parentLabel = cb.closest('.triage-check-item');
      if (cb.checked) {
        checkedCount++;
        if (parentLabel) {
          parentLabel.classList.add('opacity-60', 'line-through');
        }
      } else {
        if (parentLabel) {
          parentLabel.classList.remove('opacity-60', 'line-through');
        }
      }
    });

    const progressEl = document.querySelector(`.checklist-progress[data-for="${scenarioId}"]`);
    if (progressEl) {
      const total = scenarioBoxes.length;
      progressEl.textContent = `${checkedCount} / ${total} steps completed`;
      if (checkedCount === total) {
        progressEl.classList.add('text-emerald-600', 'font-bold');
      } else {
        progressEl.classList.remove('text-emerald-600', 'font-bold');
      }
    }
  }

  checkboxes.forEach(cb => {
    cb.addEventListener('change', function() {
      const scenarioId = this.getAttribute('data-scenario');
      if (scenarioId) updateScenarioProgress(scenarioId);
    });
  });

  // Reset button
  if (btnReset) {
    btnReset.addEventListener('click', function() {
      checkboxes.forEach(cb => {
        cb.checked = false;
        const parentLabel = cb.closest('.triage-check-item');
        if (parentLabel) parentLabel.classList.remove('opacity-60', 'line-through');
      });
      document.querySelectorAll('.checklist-progress').forEach(el => {
        const scenarioId = el.getAttribute('data-for');
        const count = document.querySelectorAll(`.triage-checkbox[data-scenario="${scenarioId}"]`).length;
        el.textContent = `0 / ${count} steps completed`;
        el.classList.remove('text-emerald-600', 'font-bold');
      });
    });
  }
})();
</script>
