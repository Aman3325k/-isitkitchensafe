    colPan: "餐盆架构",
    colDepth: "深度 (mm)",
    colVolume: "公称容积",
    colDelta: "最大热分层ΔT",
    colEvapRate: "蒸发冷却因子",
    colMixing: "自然对流系数",
    rulesTitle: "商业厨房保温餐台控温与芽孢防控铁律",
    rulesSub: "基于美国公共卫生署与FDA食品安全规范的严苛准则，杜绝炒饭综合征与肉毒/梭菌集体食物中毒。",
    rule1Title: "严禁用保温餐台直接加热或重新加热冷藏食物",
    rule1Text: "保温台仅用于维持已加热食物的温度，不具备灭菌烹饪功率。冷食放入餐台会在20°C至50°C温区停留数小时，直接唤醒休眠芽孢快速萌发。",
    rule2Title: "严禁水槽在无水状态下干烧运行（必须注入足量热水）",
    rule2Text: "干烧失去水蒸气冷凝相变潜热。盆底被电热管烤焦至100°C以上，而缺乏蒸汽对流的食物表面和死角迅速降温至危险温区，成为细菌温床。",
    rule3Title: "高粘度浓稠食物（米饭、肉酱、泥状食物）必须每30分钟翻拌一次",
    rule3Text: "非牛顿流体食物缺乏流动性，导热极差。如果不经常人工上下翻拌，表层脱水结皮，皮下5厘米处温度会比盆底低15°C–20°C。",
    rule4Title: "低于57.2°C（135°F）保温超过2小时的高淀粉食物必须直接销毁",
    rule4Text: "一旦蜡样芽孢杆菌在淀粉中合成了呕吐毒素（Cereulide），随后的高温再加热、煮沸或微波均无法分解毒素（121°C耐受90分钟），必须彻底废弃。",
    copyReportBtn: "复制餐台微生物诊断报告",
    copiedFeedback: "保温餐台微生物诊断报告已成功复制至剪贴板！"
  },
  ja: {
    badge: "食品微生物学＆熱プロセス工学シミュレーター",
    title: "業務用温蔵バイキング台＆セレウス菌芽胞動態モデラー",
    subtitle: "業務用スチームテーブル（湯煎保温器）の40°C〜60°C危険温度帯における耐熱性セレウス菌（Bacillus cereus）およびウェルシュ菌（C. perfringens）の芽胞発芽動態、毒素産生、米国FDA衛生法適合性をモデル化します。",
    controlsTitle: "温蔵テーブル設計スペック及び保温運用条件パラメーター",
    controlsSub: "ガストロノームパンの深さ、食品基質の粘度、温水槽の熱力学的状態、フタの有無と攪拌頻度、保温時間、室内気流環境を設定してください。",
    panLabel: "ホテルパン規格及びガストロノーム深さ：",
    panHelp: "深型6インチ（150mm）大容量パン vs 標準4インチ（100mm）給食パン vs 浅型2.5インチ（65mm）急速熱伝導パン vs 丸型スープチューリン。",
    matrixLabel: "食品基質（デンプン・タンパク質・粘度）：",
    matrixHelp: "白米・チャーハン（嘔吐型セレウス菌セレウリド産生リスク） vs 濃厚ビーフシチュー（偏性嫌気性ウェルシュ菌） vs 澄んだチキンスープ vs マッシュポテト。",
    wellLabel: "スチームテーブル温水槽の稼働状態：",
    wellHelp: "湯煎水温80°C（NSF/FDA適正基準） vs 低温60°C限界水槽 vs 空焚きドライ運用（水なし電熱放射、底面焦げ付きと表面冷却の極度な温度差）。",
    protocolLabel: "フタの密閉度及び手動攪拌プロトコル：",
    protocolHelp: "ステンレス密閉フタ＋30分毎攪拌（ゴールド基準） vs フタあり未攪拌 vs 開放陳列＋30分毎攪拌 vs 開放陳列完全放置。",
    hoursLabel: "連続温蔵保温・陳列時間（時間）：",
    hoursHelp: "追加加熱や廃棄を行わずにバイキングラインに放置されている連続経過時間。",
    draftLabel: "厨房・バイキングラインの室内風速・気温（°C）：",
    draftHelp: "空調からの冷たい気流が食品表面を通過すると、気化熱により表層温度の急激な低下が引き起こされます。",
    presetsTitle: "実証実験プリセットシナリオ：",
    presetNsfBenchmark: "FDA/NSF適合ゴールド基準（浅型2.5\" ＋ 80°C湯煎 ＋ フタ密閉 ＋ 定期攪拌）",
    presetFriedRiceDisaster: "チャーハン症候群集団食中毒事故（深型6\" ＋ 炊飯米 ＋ フタなし ＋ 4時間放置）",
    presetMeatChiliAnaerobic: "大鍋カレー・シチュー嫌気性ウェルシュ菌暴発（深型6\" ＋ 空焚き ＋ 未攪拌）",
    presetSoupConvective: "丸型スープチューリン自然対流保温（円筒鍋 ＋ スープ ＋ 湯煎 ＋ フタ密閉）",
    presetPureeConductiveLag: "ポテトピュレ熱伝導遅延デッドゾーン（標準4\" ＋ 濃厚ポテト ＋ 未攪拌バイキング）",
    diagnosticTitle: "垂直温度成層＆芽胞発芽リスク診断カード",
    diagnosticSub: "表層と中心の実測温度差、栄養体細菌数（CFU/g）、嘔吐毒セレウリド蓄積量、米国FDA 3-501.16適合判定をリアルタイム表示。",
    surfaceTempLabel: "食品表層実測温度",
    coreTempLabel: "パン中心部実測温度",
    pathogenCountLabel: "栄養型病原細菌密度（CFU/g）",
    cereulideLabel: "蓄積セレウリド嘔吐毒素濃度（ng/g）",
    cPerfringensRiskLabel: "ウェルシュ菌増殖リスク評価",
    fdaComplianceLabel: "米国FDA食品衛生法3-501.16適合性",
    stratificationDeltaLabel: "垂直温度成層勾配（ΔT 底部から表面）",
    clinicalSymptomsLabel: "臨床病態及び毒素発症メカニズム",
    actionProtocolLabel: "義務付けられる緊急是正・廃棄プロトコル",
    scienceTitle: "スチームテーブルにおける温度成層物理学と芽胞発芽動態",
    scienceSub: "なぜ湯煎温度が十分であっても、開放パンの表面では水分蒸発により危険温度帯が生じ、耐熱性芽胞が目覚めてしまうのか。",
    tableTitle: "ホテルパン形状別熱放散＆温度成層マトリックス",
    tableSub: "各種ステンレスGNパンにおける気化冷却係数、熱伝導遅延時間、対流混合指数の比較一覧。",
    colPan: "パン構造",
    colDepth: "深さ (mm)",
    colVolume: "公称容量",
    colDelta: "最大温度差ΔT",
    colEvapRate: "気化冷却係数",
    colMixing: "自然対流混合比",
    rulesTitle: "温蔵バイキング台の衛生管理とセレウス菌予防の鉄則",
    rulesSub: "公衆衛生基準に基づき、チャーハン症候群やウェルシュ菌感染を防ぎ、安全な温蔵提供を担保するための必須手順。",
    rule1Title: "冷えた食品をスチームテーブルで再加熱してはならない",
    rule1Text: "保温台は温度維持専用であり、調理器具ではありません。冷たい食品を投入すると20°C〜50°Cの危険帯に数時間留まり、芽胞が一気に発芽します。",
    rule2Title: "温水槽には常に十分な熱湯を張る（空焚き運転の厳禁）",
    rule2Text: "水なし運転では蒸気の潜熱伝達が失われます。底面が焦げ付く一方で、表面は冷たい空気に冷やされ、上層部が細菌培養器と化します。",
    rule3Title: "粘度の高い食品（ご飯、カレー、ピュレ）は30分毎に底から攪拌する",
    rule3Text: "デンプンやピュレは熱伝導率が極めて低いです。定期的に攪拌しないと、表面温度は湯煎水温より15°C〜20°Cも低下します。",
    rule4Title: "57.2°C未満で2時間以上放置されたデンプン食品は直ちに全量廃棄する",
    rule4Text: "セレウス菌が一度セレウリド嘔吐毒を産生すると、その後の再加熱や煮沸でも毒素は分解されません（121°Cで90分耐熱）。必ず廃棄してください。",
    copyReportBtn: "保温台芽胞診断レポートをコピー",
    copiedFeedback: "微生物学芽胞診断レポートをクリップボードにコピーしました！"
  }
};

const d = DICTIONARY[lang] || DICTIONARY.en;
---

<div class="not-prose my-8 p-6 md:p-8 bg-surface border border-hairline rounded-3xl shadow-sm">
  <!-- Header Banner -->
  <div class="flex flex-wrap items-center justify-between gap-3 mb-6 pb-6 border-b border-hairline">
    <div>
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-500/10 text-amber-950 border border-amber-500/20">
        <span>♨️</span>
        {d.badge}
      </span>
      <h2 class="text-xl md:text-2xl font-extrabold text-ink tracking-tight mt-2">
        {d.title}
      </h2>
      <p class="text-xs md:text-sm text-muted mt-1 max-w-3xl leading-relaxed">
        {d.subtitle}
      </p>
    </div>
  </div>

  <!-- Presets Bar -->
  <div class="mb-8 p-4 bg-surface-soft/80 border border-hairline rounded-2xl">
    <div class="text-xs font-bold text-ink uppercase tracking-wider mb-2 flex items-center gap-1.5">
      <span>⚡</span>
      {d.presetsTitle}
    </div>
    <div class="flex flex-wrap gap-2">
      <button type="button" class="preset-btn px-3 py-1.5 rounded-xl text-xs font-semibold bg-surface border border-hairline hover:border-amber-500 hover:text-amber-900 transition-all cursor-pointer shadow-2xs" data-preset="preset-nsf-benchmark">
        {d.presetNsfBenchmark}
      </button>
      <button type="button" class="preset-btn px-3 py-1.5 rounded-xl text-xs font-semibold bg-surface border border-hairline hover:border-rose-500 hover:text-rose-900 transition-all cursor-pointer shadow-2xs" data-preset="preset-fried-rice-disaster">
        {d.presetFriedRiceDisaster}
      </button>
      <button type="button" class="preset-btn px-3 py-1.5 rounded-xl text-xs font-semibold bg-surface border border-hairline hover:border-red-500 hover:text-red-900 transition-all cursor-pointer shadow-2xs" data-preset="preset-meat-chili-anaerobic">
        {d.presetMeatChiliAnaerobic}
      </button>
      <button type="button" class="preset-btn px-3 py-1.5 rounded-xl text-xs font-semibold bg-surface border border-hairline hover:border-emerald-500 hover:text-emerald-900 transition-all cursor-pointer shadow-2xs" data-preset="preset-soup-convective">
        {d.presetSoupConvective}
      </button>
      <button type="button" class="preset-btn px-3 py-1.5 rounded-xl text-xs font-semibold bg-surface border border-hairline hover:border-orange-500 hover:text-orange-900 transition-all cursor-pointer shadow-2xs" data-preset="preset-puree-conductive-lag">
        {d.presetPureeConductiveLag}
      </button>
    </div>
  </div>

  <!-- Controls Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-10 bg-surface-soft/60 border border-hairline rounded-2xl p-6">
    <!-- 1. Pan Geometry & Depth -->
    <div>
      <label for="pan-select" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5">
        {d.panLabel}
      </label>
      <select id="pan-select" class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-sm font-medium text-ink focus:outline-none focus:ring-2 focus:ring-amber-500">
        {modelData.holdingPanArchitectures.map(p => (
          <option value={p.id} selected={p.id === 'hotel-pan-standard-4inch'}>
            {p.name}
          </option>
        ))}
      </select>
      <p class="text-[11px] text-muted mt-1 leading-snug">{d.panHelp}</p>
    </div>

    <!-- 2. Food Matrix Viscosity -->
    <div>
      <label for="matrix-select" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5">
        {d.matrixLabel}
      </label>
      <select id="matrix-select" class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-sm font-medium text-ink focus:outline-none focus:ring-2 focus:ring-amber-500">
        {modelData.foodMatrixProfiles.map(m => (
          <option value={m.id} selected={m.id === 'starchy-rice-pasta'}>
            {m.name}
          </option>
        ))}
      </select>
      <p class="text-[11px] text-muted mt-1 leading-snug">{d.matrixHelp}</p>
    </div>

    <!-- 3. Steam Table Well Operational State -->
    <div>
      <label for="well-select" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5">
        {d.wellLabel}
      </label>
      <select id="well-select" class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-sm font-medium text-ink focus:outline-none focus:ring-2 focus:ring-amber-500">
        {modelData.waterWellOperationalStates.map(w => (
          <option value={w.id} selected={w.id === 'wet-well-optimal'}>
            {w.name}
          </option>
        ))}
      </select>
      <p class="text-[11px] text-muted mt-1 leading-snug">{d.wellHelp}</p>
    </div>

    <!-- 4. Lid Coverage & Agitation Protocol -->
    <div>
      <label for="protocol-select" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5">
        {d.protocolLabel}
      </label>
      <select id="protocol-select" class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-sm font-medium text-ink focus:outline-none focus:ring-2 focus:ring-amber-500">
        {modelData.panCoverageAndStirringProtocols.map(pr => (
          <option value={pr.id} selected={pr.id === 'uncovered-stirred'}>
            {pr.name}
          </option>
        ))}
      </select>
      <p class="text-[11px] text-muted mt-1 leading-snug">{d.protocolHelp}</p>
    </div>

    <!-- 5. Continuous Holding Duration Slider -->
    <div>
      <div class="flex items-center justify-between mb-1.5">
        <label for="hours-slider" class="text-xs font-bold uppercase tracking-wider text-ink">
          {d.hoursLabel}
        </label>
        <span id="hours-val" class="text-xs font-mono font-bold text-amber-700 bg-amber-50 px-2 py-0.5 rounded-md border border-amber-200">
          2.0 hours
        </span>
      </div>
      <input type="range" id="hours-slider" min="0.5" max="8.0" step="0.5" value="2.0" class="w-full accent-amber-600 cursor-pointer" />
      <p class="text-[11px] text-muted mt-1 leading-snug">{d.hoursHelp}</p>
    </div>

    <!-- 6. Ambient Kitchen Air & Draft Temperature -->
    <div>
      <div class="flex items-center justify-between mb-1.5">
        <label for="draft-slider" class="text-xs font-bold uppercase tracking-wider text-ink">
          {d.draftLabel}
        </label>
        <span id="draft-val" class="text-xs font-mono font-bold text-amber-700 bg-amber-50 px-2 py-0.5 rounded-md border border-amber-200">
          22°C (71.6°F)
        </span>
      </div>
      <input type="range" id="draft-slider" min="16" max="36" step="1" value="22" class="w-full accent-amber-600 cursor-pointer" />
      <p class="text-[11px] text-muted mt-1 leading-snug">{d.draftHelp}</p>
    </div>
  </div>

  <!-- Real-Time Diagnostic Dashboard -->
  <div class="border border-hairline rounded-2xl p-6 bg-surface mb-10 shadow-xs">
    <div class="flex flex-wrap items-center justify-between gap-3 mb-6 pb-4 border-b border-hairline">
      <div>
        <h3 class="text-base md:text-lg font-bold text-ink flex items-center gap-2">
          <span>🔬</span>
          {d.diagnosticTitle}
        </h3>
        <p class="text-xs text-muted">{d.diagnosticSub}</p>
      </div>
      <div id="status-badge" class="px-3 py-1 rounded-full text-xs font-bold tracking-wider uppercase bg-emerald-100 text-emerald-900 border border-emerald-300">
        FDA 3-501.16 COMPLIANT (&gt;135°F / 57.2°C)
      </div>
    </div>

    <!-- Diagnostic Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
      <!-- 1. Top Layer Surface Temperature -->
      <div class="bg-surface-soft border border-hairline rounded-xl p-4 flex flex-col justify-between">
        <div class="text-[11px] font-bold uppercase tracking-wider text-muted mb-1 flex items-center justify-between">
          <span>{d.surfaceTempLabel}</span>
          <span class="text-amber-700">🌡️</span>
        </div>
        <div class="my-2">
          <div class="text-2xl md:text-3xl font-extrabold text-ink font-mono tracking-tight">
            <span id="surface-temp-val">61.4</span> <span class="text-xs font-normal text-muted">°C</span>
          </div>
          <div id="surface-badge" class="inline-block px-2 py-0.5 text-[10px] font-bold rounded mt-1 bg-emerald-100 text-emerald-800">
            Above 135°F Safe Line (142.5°F)
          </div>
        </div>
        <div class="text-[11px] text-muted">
          FDA Minimum: 57.2°C (135°F)
        </div>
      </div>

      <!-- 2. Mid-Depth Core Food Temperature -->
      <div class="bg-surface-soft border border-hairline rounded-xl p-4 flex flex-col justify-between">
        <div class="text-[11px] font-bold uppercase tracking-wider text-muted mb-1 flex items-center justify-between">
          <span>{d.coreTempLabel}</span>
          <span class="text-amber-700">🥘</span>
        </div>
        <div class="my-2">
          <div class="text-2xl md:text-3xl font-extrabold text-ink font-mono tracking-tight">
            <span id="core-temp-val">71.0</span> <span class="text-xs font-normal text-muted">°C</span>
          </div>
          <div id="core-badge" class="inline-block px-2 py-0.5 text-[10px] font-bold rounded mt-1 bg-emerald-100 text-emerald-800">
            Hot-Holding Passivated (159.8°F)
          </div>
        </div>
        <div class="text-[11px] text-muted">
          Well Bath Temp: <span id="well-bath-text">80°C (176°F)</span>
        </div>
      </div>

      <!-- 3. Vegetative Pathogen Colony Count -->
      <div class="bg-surface-soft border border-hairline rounded-xl p-4 flex flex-col justify-between">
        <div class="text-[11px] font-bold uppercase tracking-wider text-muted mb-1 flex items-center justify-between">
          <span>{d.pathogenCountLabel}</span>
          <span class="text-amber-700">🧫</span>
        </div>
        <div class="my-2">
          <div class="text-2xl md:text-3xl font-extrabold text-ink font-mono tracking-tight">
            <span id="pathogen-val">120</span> <span class="text-xs font-normal text-muted">CFU/g</span>
          </div>
          <div id="pathogen-badge" class="inline-block px-2 py-0.5 text-[10px] font-bold rounded mt-1 bg-emerald-100 text-emerald-800">
            Basal Dormant Spore Count
          </div>
        </div>
        <div class="text-[11px] text-muted">
          Toxic Growth Threshold: &gt;100,000 CFU/g
        </div>
      </div>

      <!-- 4. Cereulide Emetic Toxin Accumulation -->
      <div class="bg-surface-soft border border-hairline rounded-xl p-4 flex flex-col justify-between">
        <div class="text-[11px] font-bold uppercase tracking-wider text-muted mb-1 flex items-center justify-between">
          <span>{d.cereulideLabel}</span>
          <span class="text-amber-700">☣️</span>
        </div>
        <div class="my-2">
          <div class="text-2xl md:text-3xl font-extrabold text-ink font-mono tracking-tight">
            <span id="cereulide-val">0.0</span> <span class="text-xs font-normal text-muted">ng/g</span>
          </div>
          <div id="cereulide-badge" class="inline-block px-2 py-0.5 text-[10px] font-bold rounded mt-1 bg-emerald-100 text-emerald-800">
            Zero Toxin Detected (Safe)
          </div>
        </div>
        <div class="text-[11px] text-muted">
          Toxic Emetic Cutoff: &gt;8.0 ng/g
        </div>
      </div>
    </div>

    <!-- Thermal Stratification Gradient Visualizer Bar -->
    <div class="mb-6 p-4 rounded-xl bg-surface-soft border border-hairline">
      <div class="flex items-center justify-between text-xs font-bold text-ink mb-1.5">
        <span class="flex items-center gap-1.5">
          <span>📉</span>
          {d.stratificationDeltaLabel}:
        </span>
        <span id="delta-val" class="font-mono text-amber-700">Δ 9.6°C (Base 71°C &rarr; Surface 61.4°C)</span>
      </div>
      <div class="w-full bg-surface rounded-full h-3 border border-hairline overflow-hidden">
        <div id="delta-bar" class="bg-amber-500 h-full rounded-full transition-all duration-300" style="width: 28%;"></div>
      </div>
      <div class="flex justify-between text-[10px] text-muted mt-1 font-mono">
        <span>0°C (Uniform Isothermal)</span>
        <span>10°C (Moderate Boundary Cooling)</span>
        <span>25°C+ (Extreme Danger Zone Stratification)</span>
      </div>
    </div>

    <!-- Clinical Pathology & Action Guidance Box -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="bg-surface-soft border border-hairline rounded-xl p-4">
        <div class="text-xs font-bold text-ink uppercase tracking-wider mb-2 flex items-center gap-1.5">
          <span>🩺</span>
          {d.clinicalSymptomsLabel}
        </div>
        <p id="clinical-text" class="text-xs text-muted leading-relaxed">
          At temperatures strictly maintained above 57.2°C (135°F), Bacillus cereus and Clostridium perfringens endospores remain dormant. Zero vegetative growth or pre-formed toxin synthesis occurs. Food is safe for immediate public service.
        </p>
      </div>

      <div class="bg-surface-soft border border-hairline rounded-xl p-4">
        <div class="text-xs font-bold text-ink uppercase tracking-wider mb-2 flex items-center gap-1.5">
          <span>🛠️</span>
          {d.actionProtocolLabel}
        </div>
        <p id="action-text" class="text-xs text-muted leading-relaxed">
          Maintain current operating procedures. Keep water well filled with 80°C hot water, keep covered during non-peak intervals, and stir every 30 minutes to homogenize boundary layer temperatures.
        </p>
      </div>
    </div>

    <!-- Interactive Cross-Section SVG Diagram -->
    <div class="mt-6 p-4 rounded-xl bg-surface-soft border border-hairline">
      <div class="text-xs font-bold text-ink uppercase tracking-wider mb-3 flex items-center gap-1.5">
        <span>📐</span>
        Steam Table Pan Cross-Section &amp; Thermal Stratification Model
      </div>
      <div class="w-full flex justify-center">
        <svg viewBox="0 0 600 240" class="w-full max-w-2xl h-auto" xmlns="http://www.w3.org/2000/svg">
          <!-- Background Ambient Air Zone -->
          <rect x="20" y="10" width="560" height="40" fill="#f8fafc" stroke="#e2e8f0" stroke-width="1" rx="6" />
          <text x="300" y="32" font-size="11" text-anchor="middle" fill="#64748b" font-family="sans-serif">
            Ambient Air Layer (Evaporative Boundary Loss) • <tspan id="svg-draft-temp" font-weight="bold">22°C</tspan>
          </text>

          <!-- Water Well Base & Outer Housing -->
          <path d="M 60 70 L 80 200 L 520 200 L 540 70" fill="none" stroke="#94a3b8" stroke-width="3" stroke-linecap="round"/>
          <text x="70" y="225" font-size="10" fill="#94a3b8" font-family="sans-serif">Stainless Table Housing</text>

          <!-- Water Bath / Steam Zone -->
          <rect id="svg-water-bath" x="78" y="140" width="444" height="58" fill="#dbeafe" opacity="0.8" />
          <text id="svg-water-text" x="300" y="175" font-size="11" text-anchor="middle" fill="#1e40af" font-weight="bold" font-family="sans-serif">
            Wet Water Bath • 80°C (Convective Condensing Steam)
          </text>

          <!-- Food Pan (Gastronorm Inset) -->
          <path id="svg-pan-outline" d="M 100 65 L 120 180 L 480 180 L 500 65 Z" fill="#fff" stroke="#475569" stroke-width="2" />

          <!-- Food Bulk Body with Gradient -->
          <defs>
            <linearGradient id="foodGradient" x1="0%" y1="100%" x2="0%" y2="0%">
              <stop id="grad-base" offset="0%" stop-color="#f97316" stop-opacity="0.9" />
              <stop id="grad-core" offset="50%" stop-color="#fbbf24" stop-opacity="0.85" />
              <stop id="grad-surface" offset="100%" stop-color="#38bdf8" stop-opacity="0.8" />
            </linearGradient>
          </defs>
          <path id="svg-food-body" d="M 104 78 L 122 178 L 478 178 L 496 78 Z" fill="url(#foodGradient)" />

          <!-- Surface Crust Indicator Line -->
          <line id="svg-surface-line" x1="104" y1="78" x2="496" y2="78" stroke="#0284c7" stroke-width="4" stroke-dasharray="6 3" />
          <circle cx="300" cy="78" r="6" fill="#0284c7" />
          <text id="svg-surface-tag" x="300" y="70" font-size="11" text-anchor="middle" fill="#0369a1" font-weight="bold" font-family="sans-serif">
            Surface Layer: 61.4°C
          </text>

          <!-- Core Mid-Depth Marker -->
          <circle cx="300" cy="128" r="5" fill="#d97706" />
          <text id="svg-core-tag" x="300" y="132" font-size="10" text-anchor="middle" fill="#78350f" font-weight="bold" font-family="sans-serif">
            Core Food: 71.0°C
          </text>

          <!-- Pan Bottom Contact Marker -->
          <circle cx="300" cy="174" r="5" fill="#ea580c" />
          <text id="svg-base-tag" x="300" y="170" font-size="10" text-anchor="middle" fill="#7c2d12" font-weight="bold" font-family="sans-serif">
            Pan Base: 75.0°C
          </text>
        </svg>
      </div>
    </div>

    <!-- Copy Audit Report Button & Footer -->
    <div class="mt-6 pt-4 border-t border-hairline flex flex-wrap items-center justify-between gap-3">
      <button type="button" id="copy-btn" class="px-4 py-2 text-xs font-bold rounded-xl bg-amber-600 hover:bg-amber-700 text-white transition-all shadow-xs cursor-pointer flex items-center gap-2">
        <span>📋</span>
        <span id="copy-text">{d.copyReportBtn}</span>
      </button>
      <span class="text-xs text-muted font-mono">{d.fdaComplianceLabel}: <strong id="fda-status" class="text-emerald-700 font-bold">COMPLIANT (&gt;135°F)</strong></span>
    </div>
  </div>

  <!-- Comparative Scientific Table -->
  <div class="mb-10">
    <div class="mb-4">
      <h3 class="text-base md:text-lg font-bold text-ink flex items-center gap-2">
        <span>📊</span>
        {d.tableTitle}
      </h3>
      <p class="text-xs text-muted">{d.tableSub}</p>
    </div>
    <div class="overflow-x-auto border border-hairline rounded-2xl bg-surface">
      <table class="w-full text-left border-collapse text-xs">
        <thead>
          <tr class="bg-surface-soft border-b border-hairline text-ink font-bold">
            <th class="p-3.5">{d.colPan}</th>
            <th class="p-3.5">{d.colDepth}</th>
            <th class="p-3.5">{d.colVolume}</th>
            <th class="p-3.5">{d.colDelta}</th>
            <th class="p-3.5">{d.colEvapRate}</th>
            <th class="p-3.5">{d.colMixing}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline">
          {modelData.holdingPanArchitectures.map(p => (
            <tr class="hover:bg-surface-soft/40 transition-colors">
              <td class="p-3.5 font-bold text-ink">
                {p.name}
                <div class="text-[10px] text-muted font-normal mt-0.5">{p.category}</div>
              </td>
              <td class="p-3.5 font-mono">{p.depthMm} mm</td>
              <td class="p-3.5 font-mono">{p.volumeLiters} L</td>
              <td class="p-3.5 font-mono font-bold text-amber-700">Δ {p.thermalStratificationDeltaC}°C</td>
              <td class="p-3.5 font-mono">{p.evaporativeSurfaceCoolingRate}x</td>
              <td class="p-3.5 font-mono">{p.convectiveMixingIndex * 100}%</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Evidence-Based Golden Rules -->
  <div class="p-6 md:p-8 bg-surface-soft/60 border border-hairline rounded-2xl">
    <div class="mb-6">
      <h3 class="text-base md:text-lg font-bold text-ink flex items-center gap-2">
        <span>🛡️</span>
        {d.rulesTitle}
      </h3>
      <p class="text-xs text-muted">{d.rulesSub}</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="bg-surface border border-hairline rounded-xl p-4">
        <h4 class="text-xs font-bold text-amber-950 uppercase tracking-wider mb-1 flex items-center gap-1">
          <span>1.</span> {d.rule1Title}
        </h4>
        <p class="text-xs text-muted leading-relaxed">{d.rule1Text}</p>
      </div>
      <div class="bg-surface border border-hairline rounded-xl p-4">
        <h4 class="text-xs font-bold text-amber-950 uppercase tracking-wider mb-1 flex items-center gap-1">
          <span>2.</span> {d.rule2Title}
        </h4>
        <p class="text-xs text-muted leading-relaxed">{d.rule2Text}</p>
      </div>
      <div class="bg-surface border border-hairline rounded-xl p-4">
        <h4 class="text-xs font-bold text-amber-950 uppercase tracking-wider mb-1 flex items-center gap-1">
          <span>3.</span> {d.rule3Title}
        </h4>
        <p class="text-xs text-muted leading-relaxed">{d.rule3Text}</p>
      </div>
      <div class="bg-surface border border-hairline rounded-xl p-4">
        <h4 class="text-xs font-bold text-amber-950 uppercase tracking-wider mb-1 flex items-center gap-1">
          <span>4.</span> {d.rule4Title}
        </h4>
        <p class="text-xs text-muted leading-relaxed">{d.rule4Text}</p>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ modelData, dict: d }}>
  // Interactive client-side simulation logic for steam table kinetics
  const panSelect = document.getElementById('pan-select');
  const matrixSelect = document.getElementById('matrix-select');
  const wellSelect = document.getElementById('well-select');
  const protocolSelect = document.getElementById('protocol-select');
  const hoursSlider = document.getElementById('hours-slider');
  const hoursVal = document.getElementById('hours-val');
  const draftSlider = document.getElementById('draft-slider');
  const draftVal = document.getElementById('draft-val');

  const surfaceTempVal = document.getElementById('surface-temp-val');
  const surfaceBadge = document.getElementById('surface-badge');
  const coreTempVal = document.getElementById('core-temp-val');
  const coreBadge = document.getElementById('core-badge');
  const wellBathText = document.getElementById('well-bath-text');
  const pathogenVal = document.getElementById('pathogen-val');
  const pathogenBadge = document.getElementById('pathogen-badge');
  const cereulideVal = document.getElementById('cereulide-val');
  const cereulideBadge = document.getElementById('cereulide-badge');
  const deltaVal = document.getElementById('delta-val');
  const deltaBar = document.getElementById('delta-bar');
  const statusBadge = document.getElementById('status-badge');
  const clinicalText = document.getElementById('clinical-text');
  const actionText = document.getElementById('action-text');
  const fdaStatus = document.getElementById('fda-status');
  const copyBtn = document.getElementById('copy-btn');
  const copyText = document.getElementById('copy-text');

  // SVG elements
  const svgDraftTemp = document.getElementById('svg-draft-temp');
  const svgWaterBath = document.getElementById('svg-water-bath');
  const svgWaterText = document.getElementById('svg-water-text');
  const svgSurfaceLine = document.getElementById('svg-surface-line');
  const svgSurfaceTag = document.getElementById('svg-surface-tag');
  const svgCoreTag = document.getElementById('svg-core-tag');
  const svgBaseTag = document.getElementById('svg-base-tag');
  const gradSurface = document.getElementById('grad-surface');
  const gradCore = document.getElementById('grad-core');
  const gradBase = document.getElementById('grad-base');

  function calculateSimulation() {
    const panId = panSelect.value;
    const matrixId = matrixSelect.value;
    const wellId = wellSelect.value;
    const protocolId = protocolSelect.value;
    const hours = parseFloat(hoursSlider.value);
    const draftC = parseFloat(draftSlider.value);

    hoursVal.textContent = `${hours.toFixed(1)} hours`;
    draftVal.textContent = `${draftC.toFixed(0)}°C (${((draftC * 9/5) + 32).toFixed(1)}°F)`;

    const panObj = modelData.holdingPanArchitectures.find(p => p.id === panId) || modelData.holdingPanArchitectures[0];
    const matrixObj = modelData.foodMatrixProfiles.find(m => m.id === matrixId) || modelData.foodMatrixProfiles[0];
    const wellObj = modelData.waterWellOperationalStates.find(w => w.id === wellId) || modelData.waterWellOperationalStates[0];
    const protocolObj = modelData.panCoverageAndStirringProtocols.find(pr => pr.id === protocolId) || modelData.panCoverageAndStirringProtocols[0];

    // Thermodynamic Calculations
    const panBaseTemp = wellObj.wellTempC > 90 
      ? 105.0 // Scorch temperature in dry well
      : wellObj.wellTempC - 2.5; // Slight thermal impedance across stainless steel

    // Base thermal stratification delta
    let rawDelta = panObj.thermalStratificationDeltaC * wellObj.stratificationMultiplier;
    
    // Evaporative surface loss
    const roomDraftPenalty = (25.0 - draftC) * 0.45; // Cool room air accelerates heat loss
    const surfaceCoolingMitigation = protocolObj.surfaceCoolingReductionPercent / 100;
    const stirringMitigation = protocolObj.stratificationReductionPercent / 100;

    // Actual delta after covers and stirring
    const effectiveDelta = Math.max(1.5, (rawDelta + roomDraftPenalty) * (1 - surfaceCoolingMitigation * 0.7) * (1 - stirringMitigation * 0.75));

    // Surface temperature calculation
    let surfaceTemp = Math.round((panBaseTemp - effectiveDelta) * 10) / 10;
    // Core temperature is mid-way with thermal conduction lag
    let coreTemp = Math.round((panBaseTemp - (effectiveDelta * 0.42)) * 10) / 10;

    if (wellId === 'dry-well-unfilled') {
      // In dry well, base is scorching hot while surface is freezing
      surfaceTemp = Math.round(Math.max(draftC + 10, 42.0 - (hours * 1.5)) * 10) / 10;
      coreTemp = Math.round(Math.max(48.0, 56.0 - (hours * 2.0)) * 10) / 10;
    }

    const surfaceTempF = ((surfaceTemp * 9/5) + 32).toFixed(1);
    const coreTempF = ((coreTemp * 9/5) + 32).toFixed(1);
    const wellTempF = ((wellObj.wellTempC * 9/5) + 32).toFixed(1);

    surfaceTempVal.textContent = surfaceTemp.toFixed(1);
    coreTempVal.textContent = coreTemp.toFixed(1);
    wellBathText.textContent = `${wellObj.wellTempC}°C (${wellTempF}°F)`;

    // Microbiological Population Modeling (Gompertz Growth in Danger Zone 10°C–55°C)
    let isSurfaceInDangerZone = surfaceTemp < 57.2;
    let isCoreInDangerZone = coreTemp < 57.2;

    let vegetativeCount = matrixObj.basalSporeDensityCfuPerG;
    let cereulideNgPerG = 0.0;

    if (isSurfaceInDangerZone) {
      // Temperature growth rate factor (cardinal model: optimum ~37°C–44°C)
      let growthEfficiency = 0.0;
      if (surfaceTemp >= 35 && surfaceTemp <= 48) {
        growthEfficiency = 1.0;
      } else if (surfaceTemp > 48 && surfaceTemp < 55) {
        growthEfficiency = (55 - surfaceTemp) / 7.0; // Declining near max limit
      } else if (surfaceTemp >= 20 && surfaceTemp < 35) {
        growthEfficiency = (surfaceTemp - 15) / 20.0;
      }

      // Generation time in hours
      const effectiveDoublingHours = (matrixObj.doublingTimeMinutesAt42C / 60) / Math.max(0.1, growthEfficiency);
      const doublings = hours / effectiveDoublingHours;

      // Exponential vegetative population expansion
      vegetativeCount = Math.min(5.0e7, Math.round(matrixObj.basalSporeDensityCfuPerG * Math.pow(2, doublings)));

      // Emetic Cereulide Toxin Synthesis (Active in starchy foods at >10^5 CFU/g between 38°C–48°C)
      if (matrixObj.cereulideSynthesisPermissive && surfaceTemp >= 30 && surfaceTemp <= 50) {
        if (vegetativeCount > 100000) {
          const hoursAboveThreshold = Math.max(0.5, hours - (effectiveDoublingHours * 9.5));
          cereulideNgPerG = Math.round(Math.min(45.0, (vegetativeCount / 100000) * 1.8 * hoursAboveThreshold) * 10) / 10;
        }
      }
    }

    pathogenVal.textContent = vegetativeCount >= 10000 
      ? vegetativeCount.toExponential(2).replace('+', '')
      : vegetativeCount.toLocaleString();

    cereulideVal.textContent = cereulideNgPerG.toFixed(1);

    // Delta T Bar
    const deltaT = Math.round((panBaseTemp - surfaceTemp) * 10) / 10;
    deltaVal.textContent = `Δ ${deltaT}°C (Base ${panBaseTemp.toFixed(0)}°C → Surface ${surfaceTemp.toFixed(1)}°C)`;
    const deltaBarPercent = Math.min(100, Math.max(5, Math.round((deltaT / 25) * 100)));
    deltaBar.style.width = `${deltaBarPercent}%`;

    // Badges and Health Status
    if (surfaceTemp >= 57.2) {
      // Safe compliant
      surfaceBadge.className = 'inline-block px-2 py-0.5 text-[10px] font-bold rounded mt-1 bg-emerald-100 text-emerald-800';
      surfaceBadge.textContent = `Above 135°F Safe Line (${surfaceTempF}°F)`;
      statusBadge.className = 'px-3 py-1 rounded-full text-xs font-bold tracking-wider uppercase bg-emerald-100 text-emerald-900 border border-emerald-300';
      statusBadge.textContent = 'FDA 3-501.16 COMPLIANT (>135°F / 57.2°C)';
      fdaStatus.className = 'text-emerald-700 font-bold';
      fdaStatus.textContent = 'COMPLIANT (>135°F)';
      deltaBar.className = 'bg-emerald-500 h-full rounded-full transition-all duration-300';
    } else if (surfaceTemp >= 50.0 && hours <= 2.0) {
      // Marginal warning
      surfaceBadge.className = 'inline-block px-2 py-0.5 text-[10px] font-bold rounded mt-1 bg-amber-100 text-amber-800';
      surfaceBadge.textContent = `Marginal Drop (${surfaceTempF}°F) - Stir Immediately`;
      statusBadge.className = 'px-3 py-1 rounded-full text-xs font-bold tracking-wider uppercase bg-amber-100 text-amber-900 border border-amber-300';
      statusBadge.textContent = 'FDA 3-501.16 WARNING (Danger Zone Surface Drop)';
      fdaStatus.className = 'text-amber-700 font-bold';
      fdaStatus.textContent = 'WARNING (Temperature Abuse)';
      deltaBar.className = 'bg-amber-500 h-full rounded-full transition-all duration-300';
    } else {
      // Critical Violation
      surfaceBadge.className = 'inline-block px-2 py-0.5 text-[10px] font-bold rounded mt-1 bg-rose-100 text-rose-800';
      surfaceBadge.textContent = `CRITICAL DANGER ZONE (${surfaceTempF}°F < 135°F)`;
      statusBadge.className = 'px-3 py-1 rounded-full text-xs font-bold tracking-wider uppercase bg-rose-100 text-rose-900 border border-rose-300';
      statusBadge.textContent = 'CRITICAL FDA VIOLATION - CONDEMN & DISCARD';
      fdaStatus.className = 'text-rose-700 font-bold';
      fdaStatus.textContent = 'CRITICAL VIOLATION - CONDEMN FOOD';
      deltaBar.className = 'bg-rose-500 h-full rounded-full transition-all duration-300';
    }

    // Pathogen Badge
    if (vegetativeCount < 1000) {
      pathogenBadge.className = 'inline-block px-2 py-0.5 text-[10px] font-bold rounded mt-1 bg-emerald-100 text-emerald-800';
      pathogenBadge.textContent = 'Basal Dormant Spores (<1,000 CFU/g)';
    } else if (vegetativeCount < 100000) {
      pathogenBadge.className = 'inline-block px-2 py-0.5 text-[10px] font-bold rounded mt-1 bg-amber-100 text-amber-800';
      pathogenBadge.textContent = 'Active Vegetative Bloom (Escalating)';
    } else {
      pathogenBadge.className = 'inline-block px-2 py-0.5 text-[10px] font-bold rounded mt-1 bg-rose-100 text-rose-800';
      pathogenBadge.textContent = 'HAZARDOUS COLONY LOAD (>10^5 CFU/g)';
    }

    // Cereulide Badge
    if (cereulideNgPerG === 0.0) {
      cereulideBadge.className = 'inline-block px-2 py-0.5 text-[10px] font-bold rounded mt-1 bg-emerald-100 text-emerald-800';
      cereulideBadge.textContent = 'Zero Toxin Detected (Safe)';
    } else if (cereulideNgPerG < 8.0) {
      cereulideBadge.className = 'inline-block px-2 py-0.5 text-[10px] font-bold rounded mt-1 bg-amber-100 text-amber-800';
      cereulideBadge.textContent = `Sub-Clinical Accumulation (${cereulideNgPerG} ng/g)`;
    } else {
      cereulideBadge.className = 'inline-block px-2 py-0.5 text-[10px] font-bold rounded mt-1 bg-rose-100 text-rose-800';
      cereulideBadge.textContent = `TOXIC EMETIC THRESHOLD EXCEEDED (${cereulideNgPerG} ng/g)`;
    }

    // Clinical and Action Text Updates
    if (surfaceTemp >= 57.2) {
      clinicalText.textContent = `At temperatures strictly maintained above 57.2°C (135°F), Bacillus cereus and Clostridium perfringens endospores remain dormant. Zero vegetative growth or pre-formed toxin synthesis occurs. Food is safe for immediate public service.`;
      actionText.textContent = `Maintain current operating procedures. Keep water well filled with 80°C hot water, keep covered during non-peak intervals, and stir every 30 minutes to homogenize boundary layer temperatures.`;
    } else if (cereulideNgPerG >= 8.0) {
      clinicalText.textContent = `CRITICAL TOXIC HAZARD: Pre-formed heat-stable Cereulide toxin detected at ${cereulideNgPerG} ng/g (>8.0 ng/g clinical threshold). Ingestion triggers severe violent emesis, mitochondrial swelling, and acute liver failure within 30 minutes to 5 hours. High mortality in pediatric and elderly populations.`;
      actionText.textContent = `MANDATORY ACTION: CONDEMN AND DISCARD IMMEDIATELY. DO NOT RE-HEAT. Cereulide is a heat-stable cyclic depsipeptide that survives boiling at 121°C for 90 minutes. Re-heating will kill bacteria but leaves 100% of the active emetic poison intact.`;
    } else if (vegetativeCount >= 100000) {
      clinicalText.textContent = `ACUTE INFECTION RISK: Pathogen load has escalated to ${vegetativeCount.toExponential(1)} CFU/g. If consumed, cells will sporulate in the human small intestine, synthesizing pore-forming enterotoxins causing profuse watery diarrhea and severe abdominal cramping within 8 to 16 hours.`;
      actionText.textContent = `Time limit exceeded under FDA Food Code 3-501.19. Food has remained in the temperature danger zone beyond safe thresholds. Discard the pan contents and thoroughly sanitize the steam well and hotel pan.`;
    } else {
      clinicalText.textContent = `MILD/MODERATE RISK: Surface temperature dropped to ${surfaceTemp.toFixed(1)}°C (${surfaceTempF}°F), initiating germination of heat-shocked spores. Early vegetative multiplication is occurring, but toxic thresholds have not yet been reached.`;
      actionText.textContent = `CORRECTIVE PROTOCOL: If elapsed holding time is under 2 hours, immediately stir the pan thoroughly, increase the water well thermostat to 80°C (176°F), and fit a snug lid. Re-measure core and surface temperatures to confirm return to >57.2°C within 15 minutes.`;
    }

    // SVG Diagram Updates
    svgDraftTemp.textContent = `${draftC}°C`;
    svgSurfaceTag.textContent = `Surface: ${surfaceTemp.toFixed(1)}°C (${surfaceTempF}°F)`;
    svgCoreTag.textContent = `Core: ${coreTemp.toFixed(1)}°C (${coreTempF}°F)`;
    svgBaseTag.textContent = `Pan Base: ${panBaseTemp.toFixed(0)}°C`;

    if (wellId === 'dry-well-unfilled') {
      svgWaterBath.setAttribute('fill', '#fecaca');
      svgWaterText.textContent = 'DRY WELL ABUSE • 95°C Radiant Air (No Water Steam)';
      svgWaterText.setAttribute('fill', '#991b1b');
    } else {
      svgWaterBath.setAttribute('fill', '#dbeafe');
      svgWaterText.textContent = `Wet Water Bath • ${wellObj.wellTempC}°C (Convective Condensing Steam)`;
      svgWaterText.setAttribute('fill', '#1e40af');
    }

    if (surfaceTemp >= 57.2) {
      gradSurface.setAttribute('stop-color', '#34d399');
      gradCore.setAttribute('stop-color', '#fbbf24');
      gradBase.setAttribute('stop-color', '#f97316');
      svgSurfaceLine.setAttribute('stroke', '#059669');
    } else if (surfaceTemp >= 50.0) {
      gradSurface.setAttribute('stop-color', '#f59e0b');
      gradCore.setAttribute('stop-color', '#fbbf24');
      gradBase.setAttribute('stop-color', '#f97316');
      svgSurfaceLine.setAttribute('stroke', '#d97706');
    } else {
      gradSurface.setAttribute('stop-color', '#38bdf8'); // Cold blue indicates cold surface danger zone
      gradCore.setAttribute('stop-color', '#fbbf24');
      gradBase.setAttribute('stop-color', '#ef4444');
      svgSurfaceLine.setAttribute('stroke', '#0284c7');
    }
  }

  // Presets handling
  document.querySelectorAll('.preset-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const pId = btn.getAttribute('data-preset');
      const preset = modelData.presetScenarios.find(p => p.id === pId);
      if (!preset) return;

      panSelect.value = preset.panId;
      matrixSelect.value = preset.matrixId;
      wellSelect.value = preset.wellId;
      protocolSelect.value = preset.protocolId;
      hoursSlider.value = preset.holdingHours;
      draftSlider.value = preset.ambientDraftTempC;

      calculateSimulation();
    });
  });

  // Copy report handler
  copyBtn.addEventListener('click', async () => {
    const reportText = `[IsItKitchenSafe Steam Table Spore & Kinetics Audit Report]
Timestamp: ${new Date().toISOString()}
Pan Architecture: ${panSelect.options[panSelect.selectedIndex].text}
Food Matrix: ${matrixSelect.options[matrixSelect.selectedIndex].text}
Water Well Status: ${wellSelect.options[wellSelect.selectedIndex].text}
Lid & Stirring Protocol: ${protocolSelect.options[protocolSelect.selectedIndex].text}
Holding Duration: ${hoursSlider.value} hours | Room Draft: ${draftSlider.value}°C

Diagnostic Results:
- Surface Temperature: ${surfaceTempVal.textContent}°C (${((parseFloat(surfaceTempVal.textContent) * 9/5) + 32).toFixed(1)}°F)
- Core Temperature: ${coreTempVal.textContent}°C
- Thermal Stratification ΔT: ${deltaVal.textContent}
- Pathogen Density: ${pathogenVal.textContent} CFU/g
- Cereulide Emetic Toxin: ${cereulideVal.textContent} ng/g
- FDA Food Code Status: ${statusBadge.textContent}
- Action Guidance: ${actionText.textContent}`;

    try {
      await navigator.clipboard.writeText(reportText);
      const originalText = copyText.textContent;
      copyText.textContent = dict.copiedFeedback;
      setTimeout(() => {
        copyText.textContent = originalText;
      }, 3000);
    } catch (e) {
      console.error('Failed to copy report:', e);
    }
  });

  // Listeners
  panSelect.addEventListener('change', calculateSimulation);
  matrixSelect.addEventListener('change', calculateSimulation);
  wellSelect.addEventListener('change', calculateSimulation);
  protocolSelect.addEventListener('change', calculateSimulation);
  hoursSlider.addEventListener('input', calculateSimulation);
  draftSlider.addEventListener('input', calculateSimulation);

  // Initial execution
  calculateSimulation();
</script>
