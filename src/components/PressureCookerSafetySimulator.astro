    crossLinkThermalShock: "調理器具・耐熱ガラス熱衝撃破裂シミュレーター"
  },
  'zh-cn': {
    badge: "流体力学与热力学厨房安全模拟器",
    title: "高压锅与电压力锅爆炸风险、密封圈老化及蒸汽烫伤模拟器",
    subtitle: "实时模拟锅体表压（10–15 PSI）、蒸汽爆炸动能、淀粉气泡堵塞防堵罩、硅胶密封圈硬化疲劳，以及低酸罐头肉毒杆菌致死灭菌安全标准。",
    controlsTitle: "压力锅及烹饪参数配置",
    controlsSub: "配置压力锅型号、食材起泡特性、装料液位及密封圈老化状态。",
    cookerLabel: "压力锅型号及结构方式",
    foodLabel: "烹饪食材与起泡膨胀特性",
    fillLabel: "锅内液体与食材填充比例",
    gasketLabel: "密封圈材质与物理老化周期",
    ventLabel: "排气阀孔与防堵罩工作状态",
    releaseLabel: "泄压排气操作协议",
    interlockLabel: "锅盖安全锁销与机械咬合状态",
    presetsTitle: "高危典型实验预设",
    presetSplitPea: "电压力锅豌豆浓汤起泡堵塞事故",
    presetCanningHazard: "电压力锅低酸罐头肉毒杆菌致死风险",
    presetSafeStew: "安全牛肉炖汤自然缓慢泄压（NPR）",
    presetForcedLid: "带压强行旋开锅盖烫伤事故",
    presetVintageBlowout: "老式老款重锤高压锅安全塞喷爆",
