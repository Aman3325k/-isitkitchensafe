    overallStatusLabel: "综合运行威胁级别",
    statusSafe: "安全操作区间（正常）",
    statusElevated: "中轻度起泡与蒸汽烫伤隐患",
    statusHigh: "高排气孔堵塞与喷溅威胁",
    statusCatastrophic: "极度危险：爆炸性减压与蒸汽喷爆",
    alertCanningTitle: "肉毒杆菌（CLOSTRIDIUM BOTULINUM）灭菌不全致命警告",
    alertCanningText: "电压力锅缺乏高海拔压力反馈校准，且在10.1至11.6 PSI（115-117°C）间循环波动。美国农业部（USDA）及国家家庭食品保藏中心（NCHFP）严禁使用普通电压力锅制作肉类、蔬菜等低酸罐头。致命肉毒杆菌孢子可在低于121°C环境下存活。",
    alertVentClogTitle: "淀粉气泡糊死防堵罩：锅内排气完全失效",
    alertVentClogText: "淀粉发泡已超出安全容积线。浓稠泡沫涌入排气管道并迅速硬化结痂，导致浮子阀无法下落，锅内形成无法正常排气的超压陷阱。",
    alertLidForcedTitle: "带压强拧锅盖：剪切力致锅盖崩飞爆开",
    alertLidForcedText: "在浮子阀升起时强力拧开锅盖会导致卡齿断裂。在11.6 PSI下，6夸脱锅盖承受超过130公斤向上推力，过早松脱将引发360度沸腾热液喷爆。",
    alertGasketTitle: "密封圈严重硬化：边缘高压蒸汽喷射",
    alertGasketText: "密封圈肖氏A硬度过高、弹性流失，在高压下容易局部脱位，形成侧向超高温蒸汽喷流，数秒内造成深二度烫伤。",
    metricsTitle: "工程力学与热力学安全指标",
    dangerScoreLabel: "爆炸与失效风险指数",
    kineticEnergyLabel: "蒸汽动能膨胀释放能",
    scaldRiskLabel: "蒸汽深度烫伤危险度",
    clogProbLabel: "排气管道堵塞概率",
    gasketHealthLabel: "密封圈残存弹性比率",
    canningVerdictLabel: "USDA低酸罐头合规判定",
    triageTitle: "锅盖卡住或异响时的应急处置标准指南",
    triageSub: "压力锅发出异常尖鸣、喷涌泡沫或锅盖无法开启时的标准工程处置规范。",
    step1Title: "1. 立即切断电源与热源，迅速撤离",
    step1Text: "立即拔掉电压力锅插头或关闭燃气灶阀门，切勿正对排气孔，保持至少2米安全观察距离。",
    step2Title: "2. 严禁强行撬动、拧开锅盖",
    step2Text: "若锅盖转动阻力大，严禁用蛮力强拧。有阻力说明内部仍有危险余压，强行旋开会瞬间崩飞锅盖喷出热液。",
    step3Title: "3. 保持静置，完全自然冷却泄压（45-60分钟）",
    step3Text: "让锅体在室温下静置自然冷却。温度降至100°C以下后蒸汽凝结为水，内部压力归零，浮子阀会自动完全跌落。",
    step4Title: "4. 彻底清洗防堵罩与排气通道",
    step4Text: "安全开盖后，取下防堵罩、密封圈和浮子阀橡胶帽，用温水和毛刷彻底刷除所有结焦淀粉硬块再行使用。",
    recallTitle: "美国CPSC官方召回与集体诉讼案例库",
    recallSub: "收录多款知名压力锅因锅盖脱落导致严重烫伤的官方召回案卷。",
    copyReportBtn: "复制完整热力学诊断报告",
    reportCopied: "✓ 诊断报告已成功复制到剪贴板！",
    crossLinkTitle: "探索更多厨房热力学与安全模拟器",
    crossLinkSlowCooker: "慢炖锅重金属釉面溶出与细菌孢子模拟器",
    crossLinkSousVide: "低温真空烹饪塑料迁移与肉毒杆菌致死模型",
    crossLinkThermalShock: "厨房餐具与耐热玻璃热冲击破裂模拟器"
  }
};

const t = dict[lang] || dict.en;
---

<div class="bg-white border border-hairline rounded-2xl p-6 md:p-10 shadow-sm mb-12" id="pressure-cooker-simulator">
  <!-- Top Badge & Header -->
  <div class="mb-8 border-b border-hairline pb-6">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-red-100 text-red-900 mb-3">
      <span class="w-2 h-2 rounded-full bg-red-600 animate-pulse"></span>
      {t.badge}
    </div>
    <h2 class="text-2xl md:text-3xl font-bold text-ink mb-3">{t.title}</h2>
    <p class="text-body text-sm md:text-base leading-relaxed max-w-4xl">{t.subtitle}</p>
  </div>

  <!-- Presets Bar -->
  <div class="mb-8 bg-surface-soft p-4 rounded-xl border border-hairline">
    <span class="text-xs font-bold text-muted uppercase tracking-wider block mb-2">{t.presetsTitle}</span>
    <div class="flex flex-wrap gap-2">
      <button type="button" class="preset-btn px-3 py-1.5 text-xs font-semibold bg-white border border-hairline hover:border-ink rounded-lg shadow-2xs transition-colors" data-preset="split-pea">
        🚨 {t.presetSplitPea}
      </button>
      <button type="button" class="preset-btn px-3 py-1.5 text-xs font-semibold bg-white border border-hairline hover:border-ink rounded-lg shadow-2xs transition-colors" data-preset="canning-hazard">
        ☣️ {t.presetCanningHazard}
      </button>
      <button type="button" class="preset-btn px-3 py-1.5 text-xs font-semibold bg-white border border-hairline hover:border-ink rounded-lg shadow-2xs transition-colors" data-preset="forced-lid">
        💥 {t.presetForcedLid}
      </button>
      <button type="button" class="preset-btn px-3 py-1.5 text-xs font-semibold bg-white border border-hairline hover:border-ink rounded-lg shadow-2xs transition-colors" data-preset="vintage-blowout">
        ⚠️ {t.presetVintageBlowout}
      </button>
      <button type="button" class="preset-btn px-3 py-1.5 text-xs font-semibold bg-white border border-hairline hover:border-ink rounded-lg shadow-2xs transition-colors" data-preset="safe-stew">
        🛡️ {t.presetSafeStew}
      </button>
    </div>
  </div>

  <!-- Main Grid: Controls vs Live Diagnostics -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-10">
    <!-- Controls Column (7 cols) -->
    <div class="lg:col-span-7 space-y-6">
      <div class="border-b border-hairline pb-2">
        <h3 class="text-base font-bold text-ink">{t.controlsTitle}</h3>
        <p class="text-xs text-muted">{t.controlsSub}</p>
      </div>

      <!-- Cooker Model Select -->
      <div>
        <label for="select-cooker" class="block text-xs font-bold text-ink uppercase tracking-wider mb-2">
          {t.cookerLabel}
        </label>
        <select id="select-cooker" class="w-full text-sm bg-surface-soft border border-hairline rounded-lg p-2.5 text-ink focus:outline-hidden focus:border-ink">
          {pressureData.cookerModels.map(m => (
            <option value={m.id}>{m.name} ({m.operatingPsi} PSI / {m.chamberTempF}°F)</option>
          ))}
        </select>
      </div>

      <!-- Food Type Select -->
      <div>
        <label for="select-food" class="block text-xs font-bold text-ink uppercase tracking-wider mb-2">
          {t.foodLabel}
        </label>
        <select id="select-food" class="w-full text-sm bg-surface-soft border border-hairline rounded-lg p-2.5 text-ink focus:outline-hidden focus:border-ink">
          {pressureData.foodTypes.map(f => (
            <option value={f.id}>{f.name} (Foaming Index: {f.foamingIndex}x)</option>
          ))}
        </select>
      </div>

      <!-- Fill Level Slider -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <label for="range-fill" class="text-xs font-bold text-ink uppercase tracking-wider">
            {t.fillLabel}
          </label>
          <span id="label-fill-val" class="text-xs font-semibold px-2 py-0.5 bg-surface-soft rounded border border-hairline text-ink">
            2/3 Full (Max Normal Line)
          </span>
        </div>
        <input type="range" id="range-fill" min="0" max="4" step="1" value="2" class="w-full accent-ink cursor-pointer" />
        <div class="flex justify-between text-[10px] text-muted mt-1">
          <span>1/3 (Safe)</span>
          <span>1/2 (Beans)</span>
          <span>2/3 (Max)</span>
          <span>3/4 (Overfilled)</span>
          <span>9/10 (Critical)</span>
        </div>
      </div>

      <!-- Gasket Condition Select -->
      <div>
        <label for="select-gasket" class="block text-xs font-bold text-ink uppercase tracking-wider mb-2">
          {t.gasketLabel}
        </label>
        <select id="select-gasket" class="w-full text-sm bg-surface-soft border border-hairline rounded-lg p-2.5 text-ink focus:outline-hidden focus:border-ink">
          {pressureData.gaskets.map(g => (
            <option value={g.id}>{g.name} — Shore A: {g.shoreHardness}</option>
          ))}
        </select>
      </div>

      <!-- Vent Pipe & Shield Condition -->
      <div>
        <label for="select-vent" class="block text-xs font-bold text-ink uppercase tracking-wider mb-2">
          {t.ventLabel}
        </label>
        <select id="select-vent" class="w-full text-sm bg-surface-soft border border-hairline rounded-lg p-2.5 text-ink focus:outline-hidden focus:border-ink">
          {pressureData.ventStatuses.map(v => (
            <option value={v.id}>{v.name}</option>
          ))}
        </select>
      </div>

      <!-- Depressurization Release Method -->
      <div>
        <label for="select-release" class="block text-xs font-bold text-ink uppercase tracking-wider mb-2">
          {t.releaseLabel}
        </label>
        <select id="select-release" class="w-full text-sm bg-surface-soft border border-hairline rounded-lg p-2.5 text-ink focus:outline-hidden focus:border-ink">
          {pressureData.releaseMethods.map(r => (
            <option value={r.id}>{r.name}</option>
          ))}
        </select>
      </div>

      <!-- Lid Interlock Status -->
      <div>
        <label for="select-interlock" class="block text-xs font-bold text-ink uppercase tracking-wider mb-2">
          {t.interlockLabel}
        </label>
        <select id="select-interlock" class="w-full text-sm bg-surface-soft border border-hairline rounded-lg p-2.5 text-ink focus:outline-hidden focus:border-ink">
          {pressureData.lidInterlockStatuses.map(i => (
            <option value={i.id}>{i.name}</option>
          ))}
        </select>
      </div>
    </div>

    <!-- Live Diagnostics Column (5 cols) -->
    <div class="lg:col-span-5 space-y-5">
      <div class="border-b border-hairline pb-2">
        <h3 class="text-base font-bold text-ink">{t.diagnosticTitle}</h3>
        <p class="text-xs text-muted">{t.diagnosticSub}</p>
      </div>

      <!-- Main Status Card -->
      <div id="status-card" class="p-5 rounded-xl border bg-emerald-50 border-emerald-300 transition-colors">
        <span class="text-[11px] font-bold text-muted uppercase tracking-wider block mb-1">
          {t.overallStatusLabel}
        </span>
        <div id="status-text" class="text-lg md:text-xl font-extrabold text-emerald-900 leading-tight">
          {t.statusSafe}
        </div>
      </div>

      <!-- Dynamic High-Priority Alerts -->
      <div id="alert-canning" class="hidden p-4 rounded-xl bg-red-50 border border-red-300">
        <div class="flex items-start gap-2.5">
          <span class="text-red-600 text-lg">☣️</span>
          <div>
            <h4 class="text-xs font-bold text-red-900 uppercase tracking-wide">{t.alertCanningTitle}</h4>
            <p class="text-xs text-red-800 mt-1 leading-relaxed">{t.alertCanningText}</p>
          </div>
        </div>
      </div>

      <div id="alert-vent-clog" class="hidden p-4 rounded-xl bg-amber-50 border border-amber-300">
        <div class="flex items-start gap-2.5">
          <span class="text-amber-600 text-lg">⚠️</span>
          <div>
            <h4 class="text-xs font-bold text-amber-900 uppercase tracking-wide">{t.alertVentClogTitle}</h4>
            <p class="text-xs text-amber-800 mt-1 leading-relaxed">{t.alertVentClogText}</p>
          </div>
        </div>
      </div>

      <div id="alert-lid-forced" class="hidden p-4 rounded-xl bg-red-50 border border-red-300">
        <div class="flex items-start gap-2.5">
          <span class="text-red-600 text-lg">💥</span>
          <div>
            <h4 class="text-xs font-bold text-red-900 uppercase tracking-wide">{t.alertLidForcedTitle}</h4>
            <p class="text-xs text-red-800 mt-1 leading-relaxed">{t.alertLidForcedText}</p>
          </div>
        </div>
      </div>

      <div id="alert-gasket" class="hidden p-4 rounded-xl bg-amber-50 border border-amber-300">
        <div class="flex items-start gap-2.5">
          <span class="text-amber-600 text-lg">💨</span>
          <div>
            <h4 class="text-xs font-bold text-amber-900 uppercase tracking-wide">{t.alertGasketTitle}</h4>
            <p class="text-xs text-amber-800 mt-1 leading-relaxed">{t.alertGasketText}</p>
          </div>
        </div>
      </div>

      <!-- Metrics Telemetry Grid -->
      <div class="bg-surface-soft p-4 rounded-xl border border-hairline space-y-3">
        <span class="text-[11px] font-bold text-muted uppercase tracking-wider block border-b border-hairline pb-1">
          {t.metricsTitle}
        </span>

        <div class="flex justify-between items-center text-xs">
          <span class="text-muted">{t.dangerScoreLabel}:</span>
          <span id="metric-danger-score" class="font-bold text-ink">14% (Low)</span>
        </div>

        <div class="flex justify-between items-center text-xs">
          <span class="text-muted">{t.kineticEnergyLabel}:</span>
          <span id="metric-kinetic-energy" class="font-mono font-bold text-ink">4,820 Joules</span>
        </div>

        <div class="flex justify-between items-center text-xs">
          <span class="text-muted">{t.scaldRiskLabel}:</span>
          <span id="metric-scald-risk" class="font-bold text-emerald-800">Minor (&lt;140°F dissipated)</span>
        </div>

        <div class="flex justify-between items-center text-xs">
          <span class="text-muted">{t.clogProbLabel}:</span>
          <span id="metric-clog-prob" class="font-bold text-ink">3.5% (Nominal)</span>
        </div>

        <div class="flex justify-between items-center text-xs">
          <span class="text-muted">{t.gasketHealthLabel}:</span>
          <span id="metric-gasket-health" class="font-bold text-emerald-800">98% (Optimal)</span>
        </div>

        <div class="flex justify-between items-center text-xs">
          <span class="text-muted">{t.canningVerdictLabel}:</span>
          <span id="metric-canning-verdict" class="font-bold text-ink">Not Applicable</span>
        </div>
      </div>

      <!-- Copy Report Button -->
      <div>
        <button type="button" id="btn-copy-report" class="w-full py-2.5 px-4 text-xs font-bold text-white bg-ink hover:bg-body rounded-xl shadow-2xs transition-colors flex items-center justify-center gap-2">
          <span>📋</span>
          <span id="btn-copy-text">{t.copyReportBtn}</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Emergency Triage Accordion / Card -->
  <div class="mb-10 p-6 rounded-2xl bg-surface-soft border border-hairline">
    <div class="flex items-center gap-2 mb-2">
      <span class="text-xl">🛠️</span>
      <h3 class="text-lg font-bold text-ink">{t.triageTitle}</h3>
    </div>
    <p class="text-xs text-muted mb-6">{t.triageSub}</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="p-4 bg-white rounded-xl border border-hairline">
        <h4 class="text-xs font-bold text-ink uppercase tracking-wide mb-1">{t.step1Title}</h4>
        <p class="text-xs text-body leading-relaxed">{t.step1Text}</p>
      </div>
      <div class="p-4 bg-white rounded-xl border border-hairline border-l-4 border-l-red-500">
        <h4 class="text-xs font-bold text-red-900 uppercase tracking-wide mb-1">{t.step2Title}</h4>
        <p class="text-xs text-body leading-relaxed">{t.step2Text}</p>
      </div>
      <div class="p-4 bg-white rounded-xl border border-hairline">
        <h4 class="text-xs font-bold text-ink uppercase tracking-wide mb-1">{t.step3Title}</h4>
        <p class="text-xs text-body leading-relaxed">{t.step3Text}</p>
      </div>
      <div class="p-4 bg-white rounded-xl border border-hairline">
        <h4 class="text-xs font-bold text-ink uppercase tracking-wide mb-1">{t.step4Title}</h4>
        <p class="text-xs text-body leading-relaxed">{t.step4Text}</p>
      </div>
    </div>
  </div>

  <!-- Official CPSC Recall Registry -->
  <div class="mb-10">
    <div class="flex items-center gap-2 mb-2">
      <span class="text-xl">⚖️</span>
      <h3 class="text-lg font-bold text-ink">{t.recallTitle}</h3>
    </div>
    <p class="text-xs text-muted mb-4">{t.recallSub}</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {pressureData.recallDatabase.map(rec => (
        <div class="p-4 rounded-xl border border-hairline bg-white shadow-2xs">
          <div class="flex justify-between items-start mb-1">
            <span class="text-xs font-bold text-ink">{rec.brand}</span>
            <span class="text-[10px] font-mono px-2 py-0.5 bg-red-100 text-red-900 rounded font-semibold">{rec.recallNumber}</span>
          </div>
          <div class="text-xs font-semibold text-body mb-2">{rec.model}</div>
          <div class="text-[11px] text-muted space-y-1">
            <div><strong>Affected Units:</strong> {rec.unitsAffected}</div>
            <div><strong>Incidents / Injuries:</strong> {rec.incidentCount}</div>
            <div class="text-red-900 bg-red-50/50 p-2 rounded mt-1"><strong>Failure Mode:</strong> {rec.defect}</div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Cross Links -->
  <div class="border-t border-hairline pt-6">
    <span class="text-xs font-bold text-muted uppercase tracking-wider block mb-3">{t.crossLinkTitle}</span>
    <div class="flex flex-wrap gap-3">
      <a href="/tools/slow-cooker-safety-simulator/" class="text-xs font-semibold text-ink bg-surface-soft hover:bg-surface-strong px-3 py-1.5 rounded-lg border border-hairline transition-colors">
        🍲 {t.crossLinkSlowCooker} →
      </a>
      <a href="/tools/sous-vide-plastic-microbial-modeler/" class="text-xs font-semibold text-ink bg-surface-soft hover:bg-surface-strong px-3 py-1.5 rounded-lg border border-hairline transition-colors">
        🥩 {t.crossLinkSousVide} →
      </a>
      <a href="/tools/thermal-shock-simulator/" class="text-xs font-semibold text-ink bg-surface-soft hover:bg-surface-strong px-3 py-1.5 rounded-lg border border-hairline transition-colors">
        💥 {t.crossLinkThermalShock} →
      </a>
    </div>
  </div>
</div>

<script is:inline define:vars={{ pressureData, t }}>
  (function initPressureCookerSimulator() {
    const cookerSelect = document.getElementById('select-cooker');
    const foodSelect = document.getElementById('select-food');
    const fillRange = document.getElementById('range-fill');
    const fillValLabel = document.getElementById('label-fill-val');
    const gasketSelect = document.getElementById('select-gasket');
    const ventSelect = document.getElementById('select-vent');
    const releaseSelect = document.getElementById('select-release');
    const interlockSelect = document.getElementById('select-interlock');

    const statusCard = document.getElementById('status-card');
    const statusText = document.getElementById('status-text');

    const alertCanning = document.getElementById('alert-canning');
    const alertVentClog = document.getElementById('alert-vent-clog');
    const alertLidForced = document.getElementById('alert-lid-forced');
    const alertGasket = document.getElementById('alert-gasket');

    const metricDangerScore = document.getElementById('metric-danger-score');
    const metricKineticEnergy = document.getElementById('metric-kinetic-energy');
    const metricScaldRisk = document.getElementById('metric-scald-risk');
    const metricClogProb = document.getElementById('metric-clog-prob');
    const metricGasketHealth = document.getElementById('metric-gasket-health');
    const metricCanningVerdict = document.getElementById('metric-canning-verdict');

    const btnCopy = document.getElementById('btn-copy-report');
    const btnCopyText = document.getElementById('btn-copy-text');

    const fillLabels = [
      "1/3 Full (Safe Batch)",
      "1/2 Full (Max Beans/Grains)",
      "2/3 Full (Max Normal Foods)",
      "3/4 Full (Overfilled Hazard)",
      "9/10 Full (Critical Overfill)"
    ];

    function calculateDiagnostics() {
      const cookerId = cookerSelect.value;
      const foodId = foodSelect.value;
      const fillIdx = parseInt(fillRange.value, 10);
      const gasketId = gasketSelect.value;
      const ventId = ventSelect.value;
      const releaseId = releaseSelect.value;
      const interlockId = interlockSelect.value;

      fillValLabel.textContent = fillLabels[fillIdx];

      const cooker = pressureData.cookerModels.find(c => c.id === cookerId) || pressureData.cookerModels[0];
      const food = pressureData.foodTypes.find(f => f.id === foodId) || pressureData.foodTypes[0];
      const fillObj = pressureData.fillLevels[fillIdx] || pressureData.fillLevels[2];
      const gasket = pressureData.gaskets.find(g => g.id === gasketId) || pressureData.gaskets[0];
      const vent = pressureData.ventStatuses.find(v => v.id === ventId) || pressureData.ventStatuses[0];
      const release = pressureData.releaseMethods.find(r => r.id === releaseId) || pressureData.releaseMethods[0];
      const interlock = pressureData.lidInterlockStatuses.find(i => i.id === interlockId) || pressureData.lidInterlockStatuses[0];

      // 1. Kinetic energy calculation E = P * V * factor
      const gaugePascals = cooker.operatingPsi * 6894.76;
      const chamberVolumeCubicMeters = (cooker.volumeLiters * (1 - fillObj.fraction)) / 1000;
      const rawJoules = Math.round(gaugePascals * chamberVolumeCubicMeters * 1.5);

      // 2. Clog Probability
      const foodClogBaseline = (food.foamingIndex - 1.0) * 18;
      const fillPenalty = (fillObj.fraction > food.safeMaxFillFraction) ? (fillObj.fraction - food.safeMaxFillFraction) * 120 : 0;
      const ventMultiplier = vent.riskMultiplier;
      const releaseClogAdd = (releaseId === 'instant-quick-release') ? 25 : 0;
      let clogProb = Math.min(99, Math.max(1, Math.round((foodClogBaseline + fillPenalty) * ventMultiplier * 0.4 + releaseClogAdd)));

      // 3. Danger Score (0-100)
      let baseRisk = 10;
      if (cooker.type === 'electric-multicooker' && foodId === 'canning-low-acid') {
        baseRisk += 65; // lethal canning
      }
      if (interlock.tamperRisk > 0) {
        baseRisk += interlock.tamperRisk;
      }
      if (fillObj.fraction > food.safeMaxFillFraction) {
        baseRisk += (fillObj.fraction - food.safeMaxFillFraction) * 90;
      }
      if (ventId === 'blocked-pipe') baseRisk += 50;
      if (gasket.retainedElasticityPct < 60) baseRisk += 25;
      if (release.scaldThreat > 50 && clogProb > 40) baseRisk += 30;

      const dangerScore = Math.min(100, Math.max(5, Math.round(baseRisk)));

      // Scald Severity Index
      let scaldVerdict = "Minor (<140°F dissipated)";
      let scaldColor = "text-emerald-800";
      if (releaseId === 'instant-quick-release' && (clogProb > 30 || fillObj.fraction > 0.6)) {
        scaldVerdict = "CRITICAL: 240°F Liquid Eruption (3rd Degree in 120ms)";
        scaldColor = "text-red-700";
      } else if (interlockId === 'forced-manual-opening') {
        scaldVerdict = "LETHAL: 360° Boiling Geyser Explosive Scald";
        scaldColor = "text-red-900";
      } else if (releaseId === 'timed-npr-10min') {
        scaldVerdict = "Moderate: Steam Vent Jet (Maintain 3ft radius)";
        scaldColor = "text-amber-800";
      }

      // Alerts Visibility
      const isCanningTrap = (foodId === 'canning-low-acid' && !cooker.canningApproved);
      alertCanning.classList.toggle('hidden', !isCanningTrap);

      const isVentClogged = (clogProb >= 60 || ventId === 'blocked-pipe');
      alertVentClog.classList.toggle('hidden', !isVentClogged);

      const isLidForced = (interlockId === 'forced-manual-opening');
      alertLidForced.classList.toggle('hidden', !isLidForced);

      const isGasketCompromised = (gasket.retainedElasticityPct <= 58);
      alertGasket.classList.toggle('hidden', !isGasketCompromised);

      // Status Card Styling
      statusCard.className = "p-5 rounded-xl border transition-colors";
      if (dangerScore >= 80 || isLidForced || isCanningTrap) {
        statusCard.classList.add('bg-red-100', 'border-red-400');
        statusText.className = "text-lg md:text-xl font-extrabold text-red-950 leading-tight";
        statusText.textContent = t.statusCatastrophic;
      } else if (dangerScore >= 50 || isVentClogged) {
        statusCard.classList.add('bg-amber-100', 'border-amber-400');
        statusText.className = "text-lg md:text-xl font-extrabold text-amber-950 leading-tight";
        statusText.textContent = t.statusHigh;
      } else if (dangerScore >= 25) {
        statusCard.classList.add('bg-yellow-50', 'border-yellow-300');
        statusText.className = "text-lg md:text-xl font-extrabold text-yellow-900 leading-tight";
        statusText.textContent = t.statusElevated;
      } else {
        statusCard.classList.add('bg-emerald-50', 'border-emerald-300');
        statusText.className = "text-lg md:text-xl font-extrabold text-emerald-900 leading-tight";
        statusText.textContent = t.statusSafe;
      }

      // Telemetry Values
      metricDangerScore.textContent = `${dangerScore}% (${dangerScore >= 80 ? 'CRITICAL' : dangerScore >= 50 ? 'HIGH' : dangerScore >= 25 ? 'ELEVATED' : 'NOMINAL'})`;
      metricKineticEnergy.textContent = `${rawJoules.toLocaleString()} Joules`;
      metricScaldRisk.textContent = scaldVerdict;
      metricScaldRisk.className = `font-bold ${scaldColor}`;
      metricClogProb.textContent = `${clogProb}% (${clogProb > 60 ? 'HIGH RISK' : clogProb > 25 ? 'MODERATE' : 'NOMINAL'})`;
      metricGasketHealth.textContent = `${gasket.retainedElasticityPct}% (${gasket.degradationRate})`;
      
      if (foodId === 'canning-low-acid') {
        if (cooker.canningApproved) {
          metricCanningVerdict.textContent = "✅ USDA Approved (True 15 PSI Canner)";
          metricCanningVerdict.className = "font-bold text-emerald-800";
        } else {
          metricCanningVerdict.textContent = "❌ LETHAL: Prohibited (Botulism Risk)";
          metricCanningVerdict.className = "font-bold text-red-700";
        }
      } else {
        metricCanningVerdict.textContent = "Not Applicable (Standard Cooking)";
        metricCanningVerdict.className = "font-bold text-muted";
      }

      return {
        cooker: cooker.name,
        food: food.name,
        fill: fillObj.label,
        gasket: gasket.name,
        vent: vent.name,
        release: release.name,
        interlock: interlock.name,
        dangerScore,
        rawJoules,
        scaldVerdict,
        clogProb,
        gasketElasticity: gasket.retainedElasticityPct
      };
    }

    // Attach Event Listeners
    cookerSelect.addEventListener('change', calculateDiagnostics);
    foodSelect.addEventListener('change', calculateDiagnostics);
    fillRange.addEventListener('input', calculateDiagnostics);
    gasketSelect.addEventListener('change', calculateDiagnostics);
    ventSelect.addEventListener('change', calculateDiagnostics);
    releaseSelect.addEventListener('change', calculateDiagnostics);
    interlockSelect.addEventListener('change', calculateDiagnostics);

    // Preset Buttons
    document.querySelectorAll('.preset-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const p = btn.getAttribute('data-preset');
        if (p === 'split-pea') {
          cookerSelect.value = 'instant-pot-6qt';
          foodSelect.value = 'split-peas-lentils';
          fillRange.value = 3; // 3/4 full
          gasketSelect.value = 'silicone-aging';
          ventSelect.value = 'slight-residue';
          releaseSelect.value = 'instant-quick-release';
          interlockSelect.value = 'intact-pin-lock';
        } else if (p === 'canning-hazard') {
          cookerSelect.value = 'instant-pot-6qt';
          foodSelect.value = 'canning-low-acid';
          fillRange.value = 3;
          gasketSelect.value = 'silicone-new';
          ventSelect.value = 'clean-shield-intact';
          releaseSelect.value = 'natural-npr';
          interlockSelect.value = 'intact-pin-lock';
        } else if (p === 'forced-lid') {
          cookerSelect.value = 'crockpot-express';
          foodSelect.value = 'pot-roast-meats';
          fillRange.value = 2;
          gasketSelect.value = 'silicone-worn';
          ventSelect.value = 'clean-shield-intact';
          releaseSelect.value = 'instant-quick-release';
          interlockSelect.value = 'forced-manual-opening';
        } else if (p === 'vintage-blowout') {
          cookerSelect.value = 'vintage-jiggle-weight';
          foodSelect.value = 'oatmeal-grains';
          fillRange.value = 4; // 9/10 full
          gasketSelect.value = 'vintage-rubber';
          ventSelect.value = 'blocked-pipe';
          releaseSelect.value = 'instant-quick-release';
          interlockSelect.value = 'worn-bayonet-lugs';
        } else if (p === 'safe-stew') {
          cookerSelect.value = 'instant-pot-6qt';
          foodSelect.value = 'pot-roast-meats';
          fillRange.value = 1; // 1/2 full
          gasketSelect.value = 'silicone-new';
          ventSelect.value = 'clean-shield-intact';
          releaseSelect.value = 'natural-npr';
          interlockSelect.value = 'intact-pin-lock';
        }
        calculateDiagnostics();
      });
    });

    // Copy Report Handler
    if (btnCopy) {
      btnCopy.addEventListener('click', () => {
        const report = calculateDiagnostics();
        const text = `=== ISITKITCHENSAFE PRESSURE COOKER SAFETY REPORT ===\n` +
          `Date: ${new Date().toISOString()}\n` +
          `Cooker: ${report.cooker}\n` +
          `Food Item: ${report.food}\n` +
          `Fill Level: ${report.fill}\n` +
          `Gasket Condition: ${report.gasket} (${report.gasketElasticity}% Elasticity)\n` +
          `Vent Tube Status: ${report.vent}\n` +
          `Release Method: ${report.release}\n` +
          `Mechanical Interlock: ${report.interlock}\n\n` +
          `DIAGNOSTIC TELEMETRY:\n` +
          `- Overall Threat Score: ${report.dangerScore} / 100\n` +
          `- Kinetic Expansion Energy: ${report.rawJoules.toLocaleString()} Joules\n` +
          `- Scald Severity: ${report.scaldVerdict}\n` +
          `- Vent Foam Clog Probability: ${report.clogProb}%\n\n` +
          `Verified per USDA-NCHFP & CPSC Safety Guidelines.\n` +
          `URL: https://isitkitchensafe.com/tools/pressure-cooker-instant-pot-safety-simulator/`;

        navigator.clipboard.writeText(text).then(() => {
          btnCopyText.textContent = t.reportCopied;
          setTimeout(() => {
            btnCopyText.textContent = t.copyReportBtn;
          }, 3000);
        });
      });
    }

    // Initial run
    calculateDiagnostics();
  })();
</script>
