<script>
  import scwMccData from '../data/scw-mcc-extraction-fractionation-data.json';

  function initScwMccModeler() {
    const container = document.querySelector('.scw-mcc-modeler-container');
    if (!container) return;

    const form = document.getElementById('scw-mcc-controls-form');
    const formulationSelect = document.getElementById('scw-mcc-formulation-select') as HTMLSelectElement | null;
    const tempSlider = document.getElementById('scw-mcc-temp-slider') as HTMLInputElement | null;
    const tempVal = document.getElementById('scw-mcc-temp-val');
    const pressureSlider = document.getElementById('scw-mcc-pressure-slider') as HTMLInputElement | null;
    const pressureVal = document.getElementById('scw-mcc-pressure-val');
    const lsSlider = document.getElementById('scw-mcc-ls-slider') as HTMLInputElement | null;
    const lsVal = document.getElementById('scw-mcc-ls-val');
    const particleSlider = document.getElementById('scw-mcc-particle-slider') as HTMLInputElement | null;
    const particleVal = document.getElementById('scw-mcc-particle-val');
    const stagesSlider = document.getElementById('scw-mcc-stages-slider') as HTMLInputElement | null;
    const stagesVal = document.getElementById('scw-mcc-stages-val');

    // Telemetry outputs
    const outPermittivity = document.getElementById('scw-mcc-out-permittivity');
    const outYield = document.getElementById('scw-mcc-out-yield');
    const outAntioxidant = document.getElementById('scw-mcc-out-antioxidant');
    const outHmf = document.getElementById('scw-mcc-out-hmf');
    const outResidence = document.getElementById('scw-mcc-out-residence');
    const outFlux = document.getElementById('scw-mcc-out-flux');
    const barYield = document.getElementById('scw-mcc-bar-yield');
    const barYieldVal = document.getElementById('scw-mcc-bar-yield-val');
    const barAntioxidant = document.getElementById('scw-mcc-bar-antioxidant');
    const barAntioxidantVal = document.getElementById('scw-mcc-bar-antioxidant-val');

    // Verdict elements
    const verdictBanner = document.getElementById('scw-mcc-verdict-banner');
    const verdictIcon = document.getElementById('scw-mcc-verdict-icon');
    const verdictTitle = document.getElementById('scw-mcc-verdict-title');
    const verdictDesc = document.getElementById('scw-mcc-verdict-desc');

    const formulations = scwMccData.formulations;

    function recalculate() {
      if (!formulationSelect || !tempSlider || !pressureSlider || !lsSlider || !particleSlider || !stagesSlider) return;

      const fId = formulationSelect.value;
      const baseF = formulations.find(f => f.id === fId) || formulations[0];

      const tempC = parseFloat(tempSlider.value);
      const pressureBar = parseFloat(pressureSlider.value);
      const lsRatio = parseFloat(lsSlider.value);
      const particleMicrons = parseFloat(particleSlider.value);
      const stages = parseInt(stagesSlider.value, 10);

      if (tempVal) tempVal.textContent = `${tempC.toFixed(1)} °C`;
      if (pressureVal) pressureVal.textContent = `${pressureBar.toFixed(1)} bar`;
      if (lsVal) lsVal.textContent = `${lsRatio.toFixed(1)} L/kg`;
      if (particleVal) particleVal.textContent = `${particleMicrons.toFixed(0)} µm`;
      if (stagesVal) stagesVal.textContent = `${stages} Stages`;

      // 1. Water dielectric constant (permittivity) calculation via Uematsu-Franck approximation
      // At 25°C: ~78.5; At 100°C: ~55; At 140°C: ~44; At 180°C: ~35; At 220°C: ~28
      const calculatedEps = Math.max(22.0, 78.5 - 0.285 * (tempC - 25.0) + 0.00035 * Math.pow(tempC - 25.0, 2) + (pressureBar - 25.0) * 0.04);

      // Saturated vapor pressure check (Antoine equation for water)
      // P_sat in bar ≈ 10^(5.11564 - 1687.537 / (T + 230.17))
      const pSatBar = Math.pow(10, 5.11564 - 1687.537 / (tempC + 230.17));
      const isCavitationRisk = pressureBar < (pSatBar * 1.15);

      // 2. Multi-stage counter-current yield calculation
      // Driven by stages, L/S ratio, and particle size diffusion factor
      const stageFactor = 1.0 - Math.pow(0.58, stages);
      const lsFactor = Math.min(1.08, Math.pow(lsRatio / baseF.liquidToSolidRatio, 0.25));
      const particleFactor = Math.pow(baseF.particleSizeMicrons / particleMicrons, 0.2);
      const tempSolubilityFactor = Math.exp(-Math.pow((tempC - baseF.extractionTempCelsius) / 45.0, 2));

      let calculatedYield = baseF.recoveryYieldPct * stageFactor * lsFactor * particleFactor * (0.85 + 0.15 * tempSolubilityFactor);
      if (tempC > 200.0) {
        // Pyrolytic degradation penalty
        calculatedYield *= Math.max(0.2, 1.0 - (tempC - 200.0) * 0.04);
      }
      calculatedYield = Math.min(98.5, Math.max(15.0, calculatedYield));

      // 3. Antioxidant retention & HMF byproduct formation (Arrhenius thermal degradation)
      let antioxidantRet = baseF.antioxidantRetentionPct;
      let calculatedHmf = baseF.hmfDegradationPpm;
      const residenceMinutes = (baseF.residenceTimeMinutes * (baseF.liquidToSolidRatio / lsRatio) * (stages / baseF.theoreticalStages));

      if (tempC > 165.0) {
        const deltaT = tempC - 165.0;
        const thermalDegradation = (deltaT * 0.55 + Math.pow(deltaT / 12.0, 2.5)) * (residenceMinutes / 6.0);
        antioxidantRet = Math.max(12.0, antioxidantRet - thermalDegradation);
        calculatedHmf = baseF.hmfDegradationPpm + Math.pow(deltaT / 5.0, 2.2) * (residenceMinutes / 6.0);
      } else {
        antioxidantRet = Math.min(98.8, antioxidantRet + (stages >= 5 ? 1.0 : 0));
        calculatedHmf = Math.max(0.2, baseF.hmfDegradationPpm * (6.0 / Math.max(3.0, residenceMinutes)));
      }

      // 4. Ceramic membrane permeate flux (LMH)
      // Viscosity drops with temperature, increasing flux: J ∝ 1/μ
      const viscosityRel = Math.exp(-0.015 * (tempC - 100.0));
      let calculatedFlux = baseF.ceramicMembraneFluxLmh / Math.max(0.3, viscosityRel);
      if (tempC > 205.0 || calculatedHmf > 50.0) {
        // Severe membrane fouling due to humin formation
        calculatedFlux *= 0.15;
      }
      calculatedFlux = Math.min(130.0, Math.max(5.0, calculatedFlux));

      // Update UI outputs
      if (outPermittivity) outPermittivity.textContent = `${calculatedEps.toFixed(1)} ε_r`;
      if (outYield) outYield.textContent = `${calculatedYield.toFixed(1)}%`;
      if (outAntioxidant) outAntioxidant.textContent = `${antioxidantRet.toFixed(1)}%`;
      if (outHmf) outHmf.textContent = `${calculatedHmf.toFixed(1)} ppm`;
      if (outResidence) outResidence.textContent = `${residenceMinutes.toFixed(1)} min`;
      if (outFlux) outFlux.textContent = `${calculatedFlux.toFixed(1)} LMH`;

      if (barYield && barYieldVal) {
        barYield.style.width = `${calculatedYield}%`;
        barYieldVal.textContent = `${calculatedYield.toFixed(1)}%`;
        barYield.className = `h-2.5 rounded-full transition-all duration-300 ${calculatedYield > 90 ? 'bg-emerald-500' : calculatedYield > 70 ? 'bg-amber-500' : 'bg-rose-500'}`;
      }

      if (barAntioxidant && barAntioxidantVal) {
        barAntioxidant.style.width = `${antioxidantRet}%`;
        barAntioxidantVal.textContent = `${antioxidantRet.toFixed(1)}%`;
        barAntioxidant.className = `h-2.5 rounded-full transition-all duration-300 ${antioxidantRet > 90 ? 'bg-teal-500' : antioxidantRet > 70 ? 'bg-amber-500' : 'bg-rose-500'}`;
      }

      // Verdict Logic
      if (verdictBanner && verdictIcon && verdictTitle && verdictDesc) {
        if (isCavitationRisk) {
          verdictBanner.className = 'p-5 rounded-2xl border transition-all bg-rose-950/40 border-rose-800 text-rose-200';
          verdictIcon.textContent = '🚨';
          verdictTitle.textContent = 'HIGH RISK: FLASH STEAM CAVITATION HAZARD';
          verdictDesc.textContent = `Hydrostatic pressure (${pressureBar.toFixed(1)} bar) is below saturation safety margin (P_sat ≈ ${pSatBar.toFixed(1)} bar at ${tempC.toFixed(0)}°C). Immediate steam flashing will cause column channelling, dry-out, and pressure relief valve trip.`;
        } else if (tempC > 210.0 || calculatedHmf > 25.0 || fId === 'pyrolysis_hmf_fouling_hazard') {
          verdictBanner.className = 'p-5 rounded-2xl border transition-all bg-rose-950/40 border-rose-800 text-rose-200';
          verdictIcon.textContent = '🚨';
          verdictTitle.textContent = 'SEVERE PYROLYSIS & CERAMIC MEMBRANE FOULING';
          verdictDesc.textContent = `Excessive hydrothermal temperature (${tempC.toFixed(0)}°C) has triggered pentose/hexose caramelization into 5-HMF (${calculatedHmf.toFixed(1)} ppm). Thermal breakdown has destroyed >${(100 - antioxidantRet).toFixed(0)}% of antioxidants, and polymerized humins are blinding ceramic membrane pores.`;
        } else if (calculatedYield < 75.0) {
          verdictBanner.className = 'p-5 rounded-2xl border transition-all bg-amber-950/40 border-amber-800 text-amber-200';
          verdictIcon.textContent = '⚠️';
          verdictTitle.textContent = 'SUB-OPTIMAL RECOVERY: INSUFFICIENT EXTRACTION FACTOR';
          verdictDesc.textContent = 'Yield is restricted by low temperature, insufficient counter-current stages, or large particle milling size. Increase stages to ≥5 or milling fineness to ≤350 µm.';
        } else {
          verdictBanner.className = 'p-5 rounded-2xl border transition-all bg-emerald-950/40 border-emerald-800 text-emerald-200';
          verdictIcon.textContent = '✅';
          verdictTitle.textContent = 'OPTIMAL SUBCRITICAL GREEN EXTRACTION (USDA ORGANIC & FDA COMPLIANT)';
          verdictDesc.textContent = `Flawless continuous counter-current recovery. Water dielectric constant tuned to ε_r ${calculatedEps.toFixed(1)} matches target solvent polarity while zero organic solvent residues guarantee 100% organic certification with ${calculatedYield.toFixed(1)}% polyphenol recovery.`;
        }
      }
    }

    // Attach event listeners
    if (form) {
      form.addEventListener('input', recalculate);
      form.addEventListener('change', recalculate);
    }

    // Presets handler
    const presetButtons = document.querySelectorAll('.scw-mcc-preset-btn');
    presetButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const presetId = target.getAttribute('data-preset');
        if (!presetId) return;

        const p = formulations.find(f => f.id === presetId);
        if (p && formulationSelect && tempSlider && pressureSlider && lsSlider && particleSlider && stagesSlider) {
          formulationSelect.value = p.id;
          tempSlider.value = p.extractionTempCelsius.toString();
          pressureSlider.value = p.operatingPressureBar.toString();
          lsSlider.value = p.liquidToSolidRatio.toString();
          particleSlider.value = p.particleSizeMicrons.toString();
          stagesSlider.value = p.theoreticalStages.toString();
          recalculate();
        }
      });
    });

    recalculate();
  }

  // Lifecycle initialization
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initScwMccModeler);
  } else {
    initScwMccModeler();
  }
</script>
