    regSub: "严格通过 FDA 21 CFR § 117 FSMA cGMP、USDA 7 CFR Part 205 有机标准、欧盟 (EU) 2018/848 有机农业规范、3-A 卫生标准 63-04 & 08-17 与 ASME Section VIII Div 1 承压容器认证。"
  },
  ja: {
    badge: "マイルストーン 175 • 旗艦診断ツール",
    title: "商用連続式 亜臨界水動的多段向流抽出＆オンラインセラミックナノ濾過（SCW-MCC）モデラー",
    subtitle: "高温高圧亜臨界水（T = 110〜190°C, P = 25〜60 bar）連続多段向流抽出塔とオンライン管状セラミックナノ濾過膜（TiO2/ZrO2, 200〜500 Da MWCO, 15〜30 bar TMP）の統合システムを解析。有機溶剤を一切使わず、単一工程でポリフェノールやフラボノイドを94%以上の高回収率で抽出し、4〜8倍に濃縮します（FDA 21 CFR § 117 および USDA オーガニック規格適合）。",
    controlsTitle: "亜臨界水熱力学＆多段向流抽出プロセス制御盤",
    controlsSub: "亜臨界水抽出温度、背圧、向流液固比、バイオマス粉砕粒径、および理論段数を調整し、水の比誘電率変化、溶質分配平衡、およびセラミック膜透過フラックスをシミュレーションします。",
    formulationLabel: "対象植物バイオマス原料＆目的ポリフェノール：",
    formulationHelp: "農業・食品副産物原料を選択：ワイン醸造ブドウ搾りかす、オリーブ残渣・葉、柑橘類果皮、緑茶茶葉、またはベリー類残渣。",
    tempLabel: "亜臨界水抽出反応温度 (°C)：",
    tempHelp: "運転温度（100 〜 210 °C）。Uematsu-Franck式に従い水の比誘電率 ε_r を 78.5 から 34.8（エタノール/メタノールと同等）まで低下させ、難水溶性成分を急速抽出。",
    pressureLabel: "静水圧窒素加圧運転圧力 (bar)：",
    pressureHelp: "運転背圧（20 〜 70 bar）。水を蒸気圧以上に加圧して液体の亜臨界状態を完全に維持し、フラッシュ蒸気キャビテーションを防止。",
    lsRatioLabel: "向流液固質量流量比 (L/kg)：",
    lsRatioHelp: "水/原料比（3.0 〜 15.0 L/kg）。向流接触により回分抽出比で水使用量を大幅削減しながら、全段で高い濃度勾配を維持。",
    particleSizeLabel: "バイオマス平均粉砕粒径 (µm)：",
    particleSizeHelp: "微粉砕粒径（150 〜 1000 µm）。小粒径化により粒子内拡散距離を短縮し、物質移動抵抗を低減。",
    stagesLabel: "向流抽出塔理論平衡段数 N：",
    stagesHelp: "向流接触段数（2 〜 8 段）。段数の増加によりKremser式に従って抽出回収率が指数関数的に向上します。",
    presetsTitle: "検証済み商業産業プリセット：",
    presetGrape: "ブドウ搾りかすアントシアニン（140°C, 35 bar, 回収率94.8%）",
    presetOlive: "オリーブ残渣オレウロペイン＆ヒドロキシチロソール（160°C, 93.6%）",
    presetCitrus: "柑橘果皮ノビレチン＆ヘスペリジン（175°C, 50 bar, 92.4%）",
    presetTea: "緑茶生体内未エピ化EGCGカテキン（125°C, 30 bar, 95.8%）",
    presetBerry: "エルダーベリーアントシアニン配糖体（132°C, 32 bar, 95.1%）",
    presetHazard: "熱分解カラメル化＆セラミック膜閉塞障害（>215°C）",
    telemetryTitle: "亜臨界水流体移動＆ナノ濾過リアルタイムテレメトリ",
    telemetrySub: "水比誘電率（ε_r）、ポリフェノール回収率、抗酸化活性保持率、5-HMF副産物濃度、塔内滞留時間、およびセラミック膜透過流束のリアルタイム計算値。",
    permittivityLabel: "水の比誘電率 ε_r（Uematsu-Franck 推算値）：",
    yieldLabel: "ポリフェノール総合抽出回収率 (%)：",
    antioxidantLabel: "抗酸化ラジカル消去活性保持率 (%)：",
    hmfLabel: "5-HMF＆フルフラール熱変性副産物濃度 (ppm)：",
    residenceLabel: "抽出塔内平均滞留時間（分）：",
    secLabel: "抽出物単位比熱エネルギー消費量（SEC, kWh/kg）：",
    membraneFluxLabel: "セラミックナノ濾過膜透過フラックス（LMH, L/m²·h）：",
    verdictLabel: "グリーン熱水抽出安全性＆品質判定：",
    diagramTitle: "連続式亜臨界水多段向流抽出スキッド系統図",
    diagramSub: "高圧スラリーポンプ、多段向流棚段抽出塔、熱回収熱交換器、管状セラミックナノ濾過ユニット、および冷却抽出液受槽。",
    chartTitle: "抽出速度論＆生体活性保持プロファイル比較",
    chartSub: "SCW-MCC、エタノール還流抽出、ソックスレー抽出、超臨界CO2抽出、および熱湯浸出法の抽出効率、残留溶剤、環境適合性の直接比較。",
    principlesTitle: "亜臨界水の熱力学、誘電率制御＆多段向流物質移動工学",
    principlesSub: "基礎物理方程式：温度上昇による比誘電率低下、自己イオン積（Kw）増大による酸触媒作用、Kremser向流平衡段数理論、およびクロスフロー型セラミックナノ濾過特性。",
    compTitle: "産業用植物抽出・精製技術の横断的比較ベンチマーク",
    compSub: "溶剤毒性リスク、抽出収率、消費電力量、および処理時間の直接定量比較。",
    regTitle: "衛生工学、USDA/EUオーガニック認証および高圧容器安全基準",
    regSub: "FDA 21 CFR § 117 FSMA cGMP、USDA 7 CFR Part 205 オーガニック、EU 2018/848 規格、3-A 衛生規格 63-04 & 08-17、およびASME Section VIII Div 1 圧力容器規格適合。"
  }
};

const d = DICT[lang] || DICT.en;
const formulations = scwMccData.formulations;
---

<div class="scw-mcc-modeler-container my-8" data-lang={lang}>
  <!-- Header Card -->
  <header class="bg-gradient-to-br from-teal-950/80 via-slate-900 to-emerald-950/80 border border-teal-800/60 rounded-3xl p-6 sm:p-10 shadow-xl backdrop-blur-md mb-8">
    <div class="flex flex-wrap items-center gap-3 mb-4">
      <span class="px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-teal-500/20 text-teal-300 border border-teal-500/40 shadow-xs">
        {d.badge}
      </span>
      <span class="text-xs text-muted font-mono tracking-tight">
        FDA 21 CFR § 117 • USDA Organic • 110–190°C • 25–60 bar • Zero Organic Solvents • ASME B31.3
      </span>
    </div>
    <h1 class="text-2xl sm:text-4xl font-extrabold text-ink tracking-tight mb-4">
      {d.title}
    </h1>
    <p class="text-sm sm:text-base text-muted max-w-4xl leading-relaxed">
      {d.subtitle}
    </p>
  </header>

  <!-- Main Grid: Controls + Telemetry -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mb-12">
    <!-- Left Column: Controls (7 cols) -->
    <section class="lg:col-span-7 bg-surface border border-hairline rounded-3xl p-6 sm:p-8 shadow-sm">
      <div class="border-b border-hairline/80 pb-4 mb-6">
        <h2 class="text-xl font-bold text-ink tracking-tight flex items-center gap-2">
          <span class="text-teal-400">💧</span>
          {d.controlsTitle}
        </h2>
        <p class="text-xs sm:text-sm text-muted mt-1 leading-relaxed">
          {d.controlsSub}
        </p>
      </div>

      <!-- Presets Selector -->
      <div class="mb-6 p-4 rounded-2xl bg-surface-soft border border-hairline">
        <label class="block text-xs font-bold uppercase tracking-wider text-muted mb-2">
          {d.presetsTitle}
        </label>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
          <button type="button" class="scw-mcc-preset-btn text-xs py-2 px-2.5 rounded-xl border border-hairline bg-surface hover:border-teal-500/60 text-ink font-medium transition-all text-left truncate" data-preset="grape_pomace_anthocyanins">
            {d.presetGrape}
          </button>
          <button type="button" class="scw-mcc-preset-btn text-xs py-2 px-2.5 rounded-xl border border-hairline bg-surface hover:border-teal-500/60 text-ink font-medium transition-all text-left truncate" data-preset="olive_pomace_oleuropein">
            {d.presetOlive}
          </button>
          <button type="button" class="scw-mcc-preset-btn text-xs py-2 px-2.5 rounded-xl border border-hairline bg-surface hover:border-teal-500/60 text-ink font-medium transition-all text-left truncate" data-preset="citrus_peel_pmf_flavonoids">
            {d.presetCitrus}
          </button>
          <button type="button" class="scw-mcc-preset-btn text-xs py-2 px-2.5 rounded-xl border border-hairline bg-surface hover:border-teal-500/60 text-ink font-medium transition-all text-left truncate" data-preset="green_tea_egcg_catechins">
            {d.presetTea}
          </button>
          <button type="button" class="scw-mcc-preset-btn text-xs py-2 px-2.5 rounded-xl border border-hairline bg-surface hover:border-teal-500/60 text-ink font-medium transition-all text-left truncate" data-preset="berry_pomace_cyanidin">
            {d.presetBerry}
          </button>
          <button type="button" class="scw-mcc-preset-btn text-xs py-2 px-2.5 rounded-xl border border-rose-900/60 bg-rose-950/20 hover:border-rose-600 text-rose-300 font-medium transition-all text-left truncate" data-preset="pyrolysis_hmf_fouling_hazard">
            {d.presetHazard}
          </button>
        </div>
      </div>

      <!-- Controls Form -->
      <form class="space-y-5" id="scw-mcc-controls-form" onsubmit="return false;">
        <!-- 1. Formulation Selection -->
        <div>
          <label for="scw-mcc-formulation-select" class="block text-xs font-semibold text-ink mb-1">
            {d.formulationLabel}
          </label>
          <select id="scw-mcc-formulation-select" class="w-full text-xs sm:text-sm bg-surface-soft border border-hairline rounded-xl px-3 py-2.5 text-ink focus:outline-none focus:border-teal-500 transition-colors">
            {formulations.map(f => (
              <option value={f.id}>{f.name}</option>
            ))}
          </select>
          <p class="text-[11px] text-muted mt-1">{d.formulationHelp}</p>
        </div>

        <!-- 2. Temperature Slider -->
        <div>
          <div class="flex items-center justify-between text-xs font-semibold text-ink mb-1">
            <span>{d.tempLabel}</span>
            <span class="font-mono text-teal-400 font-bold" id="scw-mcc-temp-val">140.0 °C</span>
          </div>
          <input type="range" id="scw-mcc-temp-slider" min="100" max="220" step="1" value="140" class="w-full accent-teal-500 cursor-pointer" />
          <p class="text-[11px] text-muted mt-1">{d.tempHelp}</p>
        </div>

        <!-- 3. Pressure Slider -->
        <div>
          <div class="flex items-center justify-between text-xs font-semibold text-ink mb-1">
            <span>{d.pressureLabel}</span>
            <span class="font-mono text-teal-400 font-bold" id="scw-mcc-pressure-val">35.0 bar</span>
          </div>
          <input type="range" id="scw-mcc-pressure-slider" min="20" max="70" step="1" value="35" class="w-full accent-teal-500 cursor-pointer" />
          <p class="text-[11px] text-muted mt-1">{d.pressureHelp}</p>
        </div>

        <!-- 4. Liquid-to-Solid Ratio Slider -->
        <div>
          <div class="flex items-center justify-between text-xs font-semibold text-ink mb-1">
            <span>{d.lsRatioLabel}</span>
            <span class="font-mono text-teal-400 font-bold" id="scw-mcc-ls-val">6.5 L/kg</span>
          </div>
          <input type="range" id="scw-mcc-ls-slider" min="3.0" max="15.0" step="0.5" value="6.5" class="w-full accent-teal-500 cursor-pointer" />
          <p class="text-[11px] text-muted mt-1">{d.lsRatioHelp}</p>
        </div>

        <!-- 5. Particle Size Slider -->
        <div>
          <div class="flex items-center justify-between text-xs font-semibold text-ink mb-1">
            <span>{d.particleSizeLabel}</span>
            <span class="font-mono text-teal-400 font-bold" id="scw-mcc-particle-val">350 µm</span>
          </div>
          <input type="range" id="scw-mcc-particle-slider" min="150" max="1000" step="25" value="350" class="w-full accent-teal-500 cursor-pointer" />
          <p class="text-[11px] text-muted mt-1">{d.particleSizeHelp}</p>
        </div>

        <!-- 6. Counter-Current Stages Slider -->
        <div>
          <div class="flex items-center justify-between text-xs font-semibold text-ink mb-1">
            <span>{d.stagesLabel}</span>
            <span class="font-mono text-teal-400 font-bold" id="scw-mcc-stages-val">5 Stages</span>
          </div>
          <input type="range" id="scw-mcc-stages-slider" min="2" max="8" step="1" value="5" class="w-full accent-teal-500 cursor-pointer" />
          <p class="text-[11px] text-muted mt-1">{d.stagesHelp}</p>
        </div>
      </form>
    </section>

    <!-- Right Column: Live Telemetry & Verdict (5 cols) -->
    <section class="lg:col-span-5 bg-surface border border-hairline rounded-3xl p-6 sm:p-8 shadow-sm flex flex-col justify-between">
      <div>
        <div class="border-b border-hairline/80 pb-4 mb-6">
          <h2 class="text-xl font-bold text-ink tracking-tight flex items-center gap-2">
            <span class="text-teal-400">📊</span>
            {d.telemetryTitle}
          </h2>
          <p class="text-xs sm:text-sm text-muted mt-1 leading-relaxed">
            {d.telemetrySub}
          </p>
        </div>

        <!-- Telemetry Data Cards -->
        <div class="grid grid-cols-2 gap-3 mb-6">
          <div class="p-3.5 rounded-2xl bg-surface-soft border border-hairline">
            <span class="text-[11px] text-muted block mb-1">{d.permittivityLabel}</span>
            <span class="text-lg sm:text-xl font-extrabold text-cyan-400 font-mono" id="scw-mcc-out-permittivity">43.8 ε_r</span>
          </div>

          <div class="p-3.5 rounded-2xl bg-surface-soft border border-hairline">
            <span class="text-[11px] text-muted block mb-1">{d.yieldLabel}</span>
            <span class="text-lg sm:text-xl font-extrabold text-emerald-400 font-mono" id="scw-mcc-out-yield">94.8%</span>
          </div>

          <div class="p-3.5 rounded-2xl bg-surface-soft border border-hairline">
            <span class="text-[11px] text-muted block mb-1">{d.antioxidantLabel}</span>
            <span class="text-lg sm:text-xl font-extrabold text-teal-400 font-mono" id="scw-mcc-out-antioxidant">96.2%</span>
          </div>

          <div class="p-3.5 rounded-2xl bg-surface-soft border border-hairline">
            <span class="text-[11px] text-muted block mb-1">{d.hmfLabel}</span>
            <span class="text-lg sm:text-xl font-extrabold text-indigo-400 font-mono" id="scw-mcc-out-hmf">1.2 ppm</span>
          </div>

          <div class="p-3.5 rounded-2xl bg-surface-soft border border-hairline">
            <span class="text-[11px] text-muted block mb-1">{d.residenceLabel}</span>
            <span class="text-lg sm:text-xl font-extrabold text-amber-400 font-mono" id="scw-mcc-out-residence">6.5 min</span>
          </div>

          <div class="p-3.5 rounded-2xl bg-surface-soft border border-hairline">
            <span class="text-[11px] text-muted block mb-1">{d.membraneFluxLabel}</span>
            <span class="text-lg sm:text-xl font-extrabold text-blue-400 font-mono" id="scw-mcc-out-flux">68.5 LMH</span>
          </div>
        </div>

        <!-- Progress Bars for Quality & Recovery -->
        <div class="space-y-4 mb-6">
          <div>
            <div class="flex justify-between text-xs text-muted mb-1 font-mono">
              <span>{d.yieldLabel}</span>
              <span id="scw-mcc-bar-yield-val">94.8%</span>
            </div>
            <div class="w-full bg-surface-soft rounded-full h-2.5 overflow-hidden border border-hairline">
              <div id="scw-mcc-bar-yield" class="bg-emerald-500 h-2.5 rounded-full transition-all duration-300" style="width: 94.8%"></div>
            </div>
          </div>

          <div>
            <div class="flex justify-between text-xs text-muted mb-1 font-mono">
              <span>{d.antioxidantLabel}</span>
              <span id="scw-mcc-bar-antioxidant-val">96.2%</span>
            </div>
            <div class="w-full bg-surface-soft rounded-full h-2.5 overflow-hidden border border-hairline">
              <div id="scw-mcc-bar-antioxidant" class="bg-teal-500 h-2.5 rounded-full transition-all duration-300" style="width: 96.2%"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Verdict Card -->
      <div id="scw-mcc-verdict-banner" class="p-5 rounded-2xl border transition-all bg-emerald-950/40 border-emerald-800 text-emerald-200">
        <div class="flex items-center gap-3 mb-2">
          <span id="scw-mcc-verdict-icon" class="text-2xl">✅</span>
          <h3 id="scw-mcc-verdict-title" class="text-sm font-bold tracking-tight">
            OPTIMAL SUBCRITICAL GREEN EXTRACTION (USDA ORGANIC & FDA COMPLIANT)
          </h3>
        </div>
        <p id="scw-mcc-verdict-desc" class="text-xs text-emerald-300/90 leading-relaxed">
          Flawless continuous counter-current recovery. Water dielectric constant tuned to ε_r 43.8 matches solvent polarity while zero organic solvent residues guarantee 100% organic certification with >94% polyphenol yield.
        </p>
      </div>
    </section>
  </div>

  <!-- Interactive SVG Process Flow Architecture -->
  <section class="bg-surface border border-hairline rounded-3xl p-6 sm:p-10 shadow-sm mb-12">
    <div class="border-b border-hairline/80 pb-4 mb-6">
      <h2 class="text-xl sm:text-2xl font-bold text-ink tracking-tight flex items-center gap-2">
        <span class="text-teal-400">🔄</span>
        {d.diagramTitle}
      </h2>
      <p class="text-xs sm:text-sm text-muted mt-1 leading-relaxed">
        {d.diagramSub}
      </p>
    </div>

    <div class="w-full overflow-x-auto p-4 rounded-2xl bg-slate-950 border border-slate-800 flex justify-center">
      <svg class="w-full max-w-4xl h-auto" viewBox="0 0 920 380" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Background Grid -->
        <defs>
          <pattern id="scw-grid" width="20" height="20" patternUnits="userSpaceOnUse">
            <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#1e293b" stroke-width="0.5" />
          </pattern>
          <linearGradient id="column-grad" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#0f766e" />
            <stop offset="50%" stop-color="#0e7490" />
            <stop offset="100%" stop-color="#1e293b" />
          </linearGradient>
          <linearGradient id="membrane-grad" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#0369a1" />
            <stop offset="100%" stop-color="#0891b2" />
          </linearGradient>
        </defs>
        <rect width="920" height="380" fill="#090d16" />
        <rect width="920" height="380" fill="url(#scw-grid)" />

        <!-- 1. Feed Slurry Hopper & High-Pressure Pump -->
        <rect x="30" y="80" width="110" height="130" rx="12" fill="#1e293b" stroke="#334155" stroke-width="1.5" />
        <path d="M 45 80 L 125 80 L 105 130 L 65 130 Z" fill="#0f172a" stroke="#0ea5e9" stroke-width="1" />
        <text x="85" y="65" text-anchor="middle" fill="#38bdf8" font-size="11" font-weight="bold" font-family="monospace">Biomass Slurry</text>
        <circle cx="85" cy="170" r="22" fill="#0369a1" stroke="#38bdf8" stroke-width="1.5" />
        <path d="M 75 170 L 95 170 M 85 160 L 85 180" stroke="#ffffff" stroke-width="2" />
        <text x="85" y="225" text-anchor="middle" fill="#94a3b8" font-size="9" font-family="monospace">HP Slurry Pump</text>
        <text x="85" y="238" text-anchor="middle" fill="#64748b" font-size="8" font-family="monospace">P = 25–60 bar</text>

        <!-- Pipeline: Pump to Top of Column -->
        <path d="M 107 170 L 220 170 L 220 70 L 260 70" stroke="#38bdf8" stroke-width="2.5" stroke-dasharray="4 2" />
        <polygon points="255,66 265,70 255,74" fill="#38bdf8" />
        <text x="180" y="155" text-anchor="middle" fill="#38bdf8" font-size="8" font-family="monospace">Cold Feed Slurry ↓</text>

        <!-- 2. Subcritical Pressurized Water Preheater & Economizer -->
        <rect x="70" y="270" width="120" height="70" rx="10" fill="#1e293b" stroke="#14b8a6" stroke-width="1.5" />
        <text x="130" y="295" text-anchor="middle" fill="#2dd4bf" font-size="10" font-weight="bold" font-family="monospace">Water Boiler &amp;</text>
        <text x="130" y="310" text-anchor="middle" fill="#2dd4bf" font-size="10" font-weight="bold" font-family="monospace">HP Preheater</text>
