const c = DICTIONARY[lang];
---

<div class="my-8 rounded-3xl bg-surface border border-hairline shadow-md overflow-hidden" id="ventless-esp-tool-root">
  <!-- Interactive Header -->
  <div class="p-6 sm:p-8 bg-surface-card border-b border-hairline">
    <div class="flex flex-wrap items-center justify-between gap-3 mb-2">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-indigo-600 text-white shadow-xs">
        {c.badge}
      </span>
      <span class="text-xs font-mono font-medium text-muted">
        UL 710B &bull; NFPA 96 Ch 13 &bull; OSHA 29 CFR 1910.1000
      </span>
    </div>
    <h2 class="text-2xl sm:text-3xl font-extrabold text-ink tracking-tight mb-2">
      {c.title}
    </h2>
    <p class="text-sm sm:text-base text-muted max-w-4xl leading-relaxed">
      {c.subtitle}
    </p>

    <!-- Simulation Presets -->
    <div class="mt-6 pt-5 border-t border-hairline/70">
      <div class="text-xs font-bold uppercase tracking-wider text-muted mb-3">
        {c.presetsTitle}
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
        <button 
          type="button" 
          id="preset-clean"
          class="px-3.5 py-2.5 rounded-xl border border-hairline bg-surface hover:bg-surface-soft text-ink text-xs font-medium transition-all text-left flex flex-col justify-between hover:border-indigo-500 shadow-xs cursor-pointer"
        >
          <span class="font-bold text-emerald-600 dark:text-emerald-400">✓ {c.presetClean}</span>
          <span class="text-[10px] text-muted mt-0.5">12 kV / 6 kV &bull; 0 hrs &bull; 98.6% Eff</span>
        </button>
        <button 
          type="button" 
          id="preset-fouled"
          class="px-3.5 py-2.5 rounded-xl border border-hairline bg-surface hover:bg-surface-soft text-ink text-xs font-medium transition-all text-left flex flex-col justify-between hover:border-amber-500 shadow-xs cursor-pointer"
        >
          <span class="font-bold text-amber-600 dark:text-amber-400">⚠️ {c.presetFouled}</span>
          <span class="text-[10px] text-muted mt-0.5">540 hrs &bull; Coated Wires &bull; Smoke Spill</span>
        </button>
        <button 
          type="button" 
          id="preset-arcing"
          class="px-3.5 py-2.5 rounded-xl border border-hairline bg-surface hover:bg-surface-soft text-ink text-xs font-medium transition-all text-left flex flex-col justify-between hover:border-rose-500 shadow-xs cursor-pointer"
        >
          <span class="font-bold text-rose-600 dark:text-rose-400">🚨 {c.presetArcing}</span>
          <span class="text-[10px] text-muted mt-0.5">Dielectric Arc-Over &bull; Fire Risk</span>
        </button>
        <button 
          type="button" 
          id="preset-ozone"
          class="px-3.5 py-2.5 rounded-xl border border-hairline bg-surface hover:bg-surface-soft text-ink text-xs font-medium transition-all text-left flex flex-col justify-between hover:border-purple-500 shadow-xs cursor-pointer"
        >
          <span class="font-bold text-purple-600 dark:text-purple-400">⚡ {c.presetOzone}</span>
          <span class="text-[10px] text-muted mt-0.5">Spent Carbon &bull; &gt;0.10 ppm OSHA PEL</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Primary Modeler Grid -->
  <div class="p-6 sm:p-8 grid grid-cols-1 lg:grid-cols-12 gap-8">
    <!-- Controls Column (5 cols) -->
    <div class="lg:col-span-5 space-y-5">
      <div class="border-b border-hairline pb-2">
        <h3 class="text-sm font-extrabold uppercase tracking-wider text-ink">
          {c.controlsTitle}
        </h3>
        <p class="text-xs text-muted mt-0.5">{c.controlsSub}</p>
      </div>

      <!-- Select Hood Model -->
      <div>
        <label for="hood-select" class="block text-xs font-bold text-ink uppercase tracking-wider mb-1">
          {c.hoodLabel}
        </label>
        <select 
          id="hood-select" 
          class="w-full px-3.5 py-2.5 rounded-xl bg-surface border border-hairline text-ink text-xs font-medium focus:ring-2 focus:ring-indigo-500 focus:outline-hidden transition-colors"
        >
          {hoodData.hoodConfigurations.map(h => (
            <option value={h.id}>{h.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1">{c.hoodHelp}</p>
      </div>

      <!-- Select Cooking Appliance Effluent -->
      <div>
        <label for="appliance-select" class="block text-xs font-bold text-ink uppercase tracking-wider mb-1">
          {c.applianceLabel}
        </label>
        <select 
          id="appliance-select" 
          class="w-full px-3.5 py-2.5 rounded-xl bg-surface border border-hairline text-ink text-xs font-medium focus:ring-2 focus:ring-indigo-500 focus:outline-hidden transition-colors"
        >
          {hoodData.applianceEffluents.map(a => (
            <option value={a.id}>{a.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1">{c.applianceHelp}</p>
      </div>

      <!-- Ionizer Voltage Slider -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <label for="ionizer-slider" class="text-xs font-bold text-ink uppercase tracking-wider">
            {c.ionizerVoltageLabel}
          </label>
          <span id="ionizer-val" class="text-xs font-mono font-bold text-indigo-600 bg-surface px-2 py-0.5 rounded border border-hairline">
            12.0 kV DC
          </span>
        </div>
        <input 
          type="range" 
          id="ionizer-slider" 
          min="8.0" 
          max="14.0" 
          step="0.5" 
          value="12.0" 
          class="w-full accent-indigo-600 cursor-pointer"
        />
        <p class="text-[11px] text-muted mt-1">{c.ionizerVoltageHelp}</p>
      </div>

      <!-- Collector Voltage Slider -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <label for="collector-slider" class="text-xs font-bold text-ink uppercase tracking-wider">
            {c.collectorVoltageLabel}
          </label>
          <span id="collector-val" class="text-xs font-mono font-bold text-indigo-600 bg-surface px-2 py-0.5 rounded border border-hairline">
            6.0 kV DC
          </span>
        </div>
        <input 
          type="range" 
          id="collector-slider" 
          min="4.0" 
          max="8.0" 
          step="0.5" 
          value="6.0" 
          class="w-full accent-indigo-600 cursor-pointer"
        />
        <p class="text-[11px] text-muted mt-1">{c.collectorVoltageHelp}</p>
      </div>

      <!-- Airflow CFM Slider -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <label for="airflow-slider" class="text-xs font-bold text-ink uppercase tracking-wider">
            {c.airflowLabel}
          </label>
          <span id="airflow-val" class="text-xs font-mono font-bold text-ink bg-surface px-2 py-0.5 rounded border border-hairline">
            1,450 CFM
          </span>
        </div>
        <input 
          type="range" 
          id="airflow-slider" 
          min="300" 
          max="2500" 
          step="50" 
          value="1450" 
          class="w-full accent-indigo-600 cursor-pointer"
        />
        <p class="text-[11px] text-muted mt-1">{c.airflowHelp}</p>
      </div>

      <!-- Runtime Hours Since Wash Slider -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <label for="runtime-slider" class="text-xs font-bold text-ink uppercase tracking-wider">
            {c.runtimeLabel}
          </label>
          <span id="runtime-val" class="text-xs font-mono font-bold text-amber-600 bg-surface px-2 py-0.5 rounded border border-hairline">
            48 Hours
          </span>
        </div>
        <input 
          type="range" 
          id="runtime-slider" 
          min="0" 
          max="720" 
          step="24" 
          value="48" 
          class="w-full accent-indigo-600 cursor-pointer"
        />
        <p class="text-[11px] text-muted mt-1">{c.runtimeHelp}</p>
      </div>

      <!-- Carbon Filter Saturation Slider -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <label for="carbon-slider" class="text-xs font-bold text-ink uppercase tracking-wider">
            {c.carbonSatLabel}
          </label>
          <span id="carbon-val" class="text-xs font-mono font-bold text-purple-600 bg-surface px-2 py-0.5 rounded border border-hairline">
            15% Saturated
          </span>
        </div>
        <input 
          type="range" 
          id="carbon-slider" 
          min="0" 
          max="100" 
          step="5" 
          value="15" 
          class="w-full accent-indigo-600 cursor-pointer"
        />
        <p class="text-[11px] text-muted mt-1">{c.carbonSatHelp}</p>
      </div>

      <!-- Scullery Room ACH Slider -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <label for="ach-slider" class="text-xs font-bold text-ink uppercase tracking-wider">
            {c.roomAchLabel}
          </label>
          <span id="ach-val" class="text-xs font-mono font-bold text-cyan-600 bg-surface px-2 py-0.5 rounded border border-hairline">
            8 ACH
          </span>
        </div>
        <input 
          type="range" 
          id="ach-slider" 
          min="1" 
          max="25" 
          step="1" 
          value="8" 
          class="w-full accent-indigo-600 cursor-pointer"
        />
        <p class="text-[11px] text-muted mt-1">{c.roomAchHelp}</p>
      </div>
    </div>

    <!-- Live Simulation & Canvas Column (7 cols) -->
    <div class="lg:col-span-7 flex flex-col justify-between space-y-6">
      <!-- Thermodynamic & Electrostatic Canvas -->
      <div class="bg-surface-soft p-5 rounded-2xl border border-hairline flex flex-col">
        <div class="flex items-center justify-between mb-3">
          <div class="text-xs font-bold uppercase tracking-wider text-ink flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-indigo-600 animate-pulse"></span>
            Dynamic Ventless Hood Multi-Stage Recirculating Airflow
          </div>
          <span id="canvas-badge" class="text-[11px] font-mono px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300 font-bold">
            UL 710B: Compliant Clean Flow
          </span>
        </div>
        
        <div class="relative w-full aspect-16/10 rounded-xl overflow-hidden bg-slate-950 border border-slate-800 flex items-center justify-center">
          <canvas id="ventlessHoodCanvas" width="700" height="437" class="w-full h-full block"></canvas>
        </div>

        <div class="flex flex-wrap items-center justify-between text-[11px] text-muted mt-3 pt-3 border-t border-hairline gap-2 font-mono">
          <span>● Brown: Cooking Grease Aerosols</span>
          <span>● Purple Glow: Corona Ionizer (12kV)</span>
          <span>● Blue Plates: Electrostatic Collector</span>
          <span>● Teal/Green: Catalytic Ozone Destruct (O3->O2)</span>
        </div>
      </div>

      <!-- Primary Telemetry Cards -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <!-- Card 1: Capture Efficiency -->
        <div class="p-3.5 rounded-xl bg-surface-soft border border-hairline flex flex-col justify-between">
          <span class="text-[11px] text-muted font-medium">{c.efficiencyLabel}</span>
          <div class="mt-2">
            <span id="metric-efficiency" class="text-xl sm:text-2xl font-black font-mono text-emerald-600">
              98.6%
            </span>
          </div>
          <span id="metric-efficiency-sub" class="text-[10px] text-muted mt-1">Deutsch-Anderson &gt;95%</span>
        </div>

        <!-- Card 2: Corona Field Strength -->
        <div class="p-3.5 rounded-xl bg-surface-soft border border-hairline flex flex-col justify-between">
          <span class="text-[11px] text-muted font-medium">{c.foulingLabel}</span>
          <div class="mt-2">
            <span id="metric-field" class="text-xl sm:text-2xl font-black font-mono text-indigo-600">
              92.4%
            </span>
          </div>
          <span id="metric-field-sub" class="text-[10px] text-muted mt-1">Clean Corona Emitter</span>
        </div>

        <!-- Card 3: Ozone Concentration -->
        <div class="p-3.5 rounded-xl bg-surface-soft border border-hairline flex flex-col justify-between">
          <span class="text-[11px] text-muted font-medium">{c.ozoneLabel}</span>
          <div class="mt-2">
            <span id="metric-ozone" class="text-xl sm:text-2xl font-black font-mono text-emerald-600">
              0.018 ppm
            </span>
          </div>
          <span id="metric-ozone-sub" class="text-[10px] text-muted mt-1">&lt;0.05 ppm OSHA Target</span>
        </div>

        <!-- Card 4: Arc-Over Risk -->
        <div class="p-3.5 rounded-xl bg-surface-soft border border-hairline flex flex-col justify-between">
          <span class="text-[11px] text-muted font-medium">{c.arcingLabel}</span>
          <div class="mt-2">
            <span id="metric-arcing" class="text-xl sm:text-2xl font-black font-mono text-emerald-600">
              2.1%
            </span>
          </div>
          <span id="metric-arcing-sub" class="text-[10px] text-muted mt-1">Normal Dielectric Margin</span>
        </div>
      </div>

      <!-- Secondary Metric Bar -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <!-- UL 710B Interlock Status -->
        <div class="p-3.5 rounded-xl bg-surface-soft border border-hairline flex justify-between items-center">
          <div>
            <div class="text-[11px] text-muted">{c.interlockLabel}</div>
            <div id="metric-interlock" class="text-sm font-bold text-emerald-600 font-mono mt-0.5">ENERGIZED (OK)</div>
          </div>
          <div class="w-8 h-8 rounded-lg bg-emerald-100 dark:bg-emerald-950 flex items-center justify-center text-emerald-600 font-bold text-xs">
            ✓
          </div>
        </div>

        <!-- Escaped Grease Emissions -->
        <div class="p-3.5 rounded-xl bg-surface-soft border border-hairline flex justify-between items-center">
          <div>
            <div class="text-[11px] text-muted">{c.greaseOutputLabel}</div>
            <div id="metric-escaped" class="text-sm font-bold text-ink font-mono mt-0.5">0.24 lb/day (EPA Met 202)</div>
          </div>
          <div class="w-8 h-8 rounded-lg bg-indigo-100 dark:bg-indigo-950 flex items-center justify-center text-indigo-600 font-bold text-xs">
            ⚖
          </div>
        </div>

        <!-- Clean Cell Life Remaining -->
        <div class="p-3.5 rounded-xl bg-surface-soft border border-hairline flex justify-between items-center">
          <div>
            <div class="text-[11px] text-muted">{c.filterLifeLabel}</div>
            <div id="metric-life" class="text-sm font-bold text-indigo-600 font-mono mt-0.5">288 Hours Remaining</div>
          </div>
          <div class="w-8 h-8 rounded-lg bg-indigo-100 dark:bg-indigo-950 flex items-center justify-center text-indigo-600 font-bold text-xs">
            ⏱
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Deep Diagnostic Report Box -->
  <div class="p-6 sm:p-8 bg-surface-soft border-t border-hairline">
    <div class="flex flex-wrap items-center justify-between gap-3 mb-4 pb-3 border-b border-hairline">
      <div>
        <div class="text-xs font-bold uppercase tracking-wider text-indigo-600 mb-1">
          {c.diagnosticTitle}
        </div>
        <div class="text-base font-extrabold text-ink">
          {c.failureRiskLabel}: <span id="report-risk-badge" class="text-emerald-600">SAFE OPERATING CONDITION</span>
        </div>
      </div>
      <button 
        type="button" 
        id="copy-report-btn" 
        class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-medium transition-colors shadow-xs cursor-pointer"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
        </svg>
        <span id="copy-btn-text">{c.copyReportBtn}</span>
      </button>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs text-muted">
      <div>
        <div class="font-bold text-ink mb-1">{c.primaryRiskLabel}</div>
        <p id="report-primary-risk" class="leading-relaxed">
          Corona wires maintain nominal unipolar electron emission. Submicron grease smoke is captured at 98.6% efficiency, compliant with EPA Method 202 and UL 710B particulate ceilings.
        </p>
      </div>
      <div>
        <div class="font-bold text-ink mb-1">{c.mechanismsLabel}</div>
        <p id="report-mechanisms" class="leading-relaxed font-mono text-[11px]">
          Deutsch-Anderson migration w = 0.118 m/s; Peek corona onset Vc = 9.4 kV; Catalytic ozone conversion rate 98.2%; Airflow delta-P = 0.42 in. w.g.
        </p>
      </div>
      <div>
        <div class="font-bold text-ink mb-1">{c.mitigationLabel}</div>
        <p id="report-mitigation" class="leading-relaxed">
          Maintain standard weekly cell detergent ultrasonic soaking. Replace manganese dioxide catalytic carbon canisters at 70% saturation. Keep room scullery air changes above 6 ACH.
        </p>
      </div>
    </div>
  </div>

  <!-- Engineering Architecture Matrix Table -->
  <div class="p-6 sm:p-8 bg-surface border-t border-hairline">
    <div class="mb-4">
      <h3 class="text-base font-bold text-ink mb-1">{c.tableTitle}</h3>
      <p class="text-xs text-muted">{c.tableSub}</p>
    </div>

    <div class="overflow-x-auto rounded-xl border border-hairline">
      <table class="w-full text-left text-xs">
        <thead class="bg-surface-soft text-muted font-bold uppercase tracking-wider border-b border-hairline">
          <tr>
            <th class="p-3">{c.colModel}</th>
            <th class="p-3">{c.colClass}</th>
            <th class="p-3">{c.colAirflow}</th>
            <th class="p-3">{c.colEspStage}</th>
            <th class="p-3">{c.colPlateArea}</th>
            <th class="p-3">{c.colCarbon}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline">
          {hoodData.hoodConfigurations.map(h => (
            <tr class="hover:bg-surface-soft/60 transition-colors">
              <td class="p-3 font-semibold text-ink">{h.name}</td>
              <td class="p-3 text-muted font-mono">{h.classification}</td>
              <td class="p-3 text-indigo-600 font-mono font-bold">{h.designAirflowCfm} CFM</td>
              <td class="p-3 text-muted font-mono">{h.espStages}</td>
              <td class="p-3 text-muted font-mono">{h.collectorPlateAreaSqFt} sq ft</td>
              <td class="p-3 text-muted">{h.odorOzoneFilter}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Life-Safety & Engineering Directives -->
  <div class="p-6 sm:p-8 bg-surface-soft border-t border-hairline">
    <div class="mb-5">
      <h3 class="text-base font-bold text-ink mb-1">{c.rulesTitle}</h3>
      <p class="text-xs text-muted">{c.rulesSub}</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="p-4 rounded-xl bg-surface border border-hairline shadow-xs">
        <div class="text-xs font-bold text-indigo-600 mb-1">{c.rule1Title}</div>
        <p class="text-[11px] text-muted leading-relaxed">{c.rule1Text}</p>
      </div>
      <div class="p-4 rounded-xl bg-surface border border-hairline shadow-xs">
        <div class="text-xs font-bold text-indigo-600 mb-1">{c.rule2Title}</div>
        <p class="text-[11px] text-muted leading-relaxed">{c.rule2Text}</p>
      </div>
      <div class="p-4 rounded-xl bg-surface border border-hairline shadow-xs">
        <div class="text-xs font-bold text-indigo-600 mb-1">{c.rule3Title}</div>
        <p class="text-[11px] text-muted leading-relaxed">{c.rule3Text}</p>
      </div>
      <div class="p-4 rounded-xl bg-surface border border-hairline shadow-xs">
        <div class="text-xs font-bold text-indigo-600 mb-1">{c.rule4Title}</div>
        <p class="text-[11px] text-muted leading-relaxed">{c.rule4Text}</p>
      </div>
    </div>
  </div>
</div>

<script>
  import hoodData from '../data/ventless-hood-esp-data.json';

  function initVentlessEspModeler() {
    const root = document.getElementById('ventless-esp-tool-root');
    if (!root) return;

    // Elements
    const hoodSelect = document.getElementById('hood-select') as HTMLSelectElement | null;
    const applianceSelect = document.getElementById('appliance-select') as HTMLSelectElement | null;
    const ionizerSlider = document.getElementById('ionizer-slider') as HTMLInputElement | null;
    const collectorSlider = document.getElementById('collector-slider') as HTMLInputElement | null;
    const airflowSlider = document.getElementById('airflow-slider') as HTMLInputElement | null;
    const runtimeSlider = document.getElementById('runtime-slider') as HTMLInputElement | null;
    const carbonSlider = document.getElementById('carbon-slider') as HTMLInputElement | null;
    const achSlider = document.getElementById('ach-slider') as HTMLInputElement | null;

    const ionizerVal = document.getElementById('ionizer-val');
    const collectorVal = document.getElementById('collector-val');
    const airflowVal = document.getElementById('airflow-val');
    const runtimeVal = document.getElementById('runtime-val');
    const carbonVal = document.getElementById('carbon-val');
    const achVal = document.getElementById('ach-val');

    const metricEff = document.getElementById('metric-efficiency');
    const metricEffSub = document.getElementById('metric-efficiency-sub');
    const metricField = document.getElementById('metric-field');
    const metricFieldSub = document.getElementById('metric-field-sub');
    const metricOzone = document.getElementById('metric-ozone');
    const metricOzoneSub = document.getElementById('metric-ozone-sub');
    const metricArcing = document.getElementById('metric-arcing');
    const metricArcingSub = document.getElementById('metric-arcing-sub');
    const metricInterlock = document.getElementById('metric-interlock');
    const metricEscaped = document.getElementById('metric-escaped');
    const metricLife = document.getElementById('metric-life');

    const reportRiskBadge = document.getElementById('report-risk-badge');
    const reportPrimaryRisk = document.getElementById('report-primary-risk');
    const reportMechanisms = document.getElementById('report-mechanisms');
    const reportMitigation = document.getElementById('report-mitigation');
    const canvasBadge = document.getElementById('canvas-badge');
    const copyBtn = document.getElementById('copy-report-btn');
    const copyBtnText = document.getElementById('copy-btn-text');

    const presetClean = document.getElementById('preset-clean');
    const presetFouled = document.getElementById('preset-fouled');
    const presetArcing = document.getElementById('preset-arcing');
    const presetOzone = document.getElementById('preset-ozone');

    const canvas = document.getElementById('ventlessHoodCanvas') as HTMLCanvasElement | null;
    const ctx = canvas ? canvas.getContext('2d') : null;

    // Simulation state
    let simState = {
      hoodId: hoodSelect ? hoodSelect.value : 'commercial_ventless_high_volume_esp',
      applianceId: applianceSelect ? applianceSelect.value : 'commercial_electric_charbroiler',
      ionizerKv: 12.0,
      collectorKv: 6.0,
      airflowCfm: 1450,
      runtimeHours: 48,
      carbonSat: 15,
      roomAch: 8,
      animFrame: 0,
      sparks: [] as Array<{ x: number; y: number; life: number; maxLife: number }>
    };

    function recalculate() {
      if (!hoodSelect || !applianceSelect || !ionizerSlider || !collectorSlider || !airflowSlider || !runtimeSlider || !carbonSlider || !achSlider) return;

      const currentHood = hoodData.hoodConfigurations.find(h => h.id === simState.hoodId) || hoodData.hoodConfigurations[0];
      const currentAppliance = hoodData.applianceEffluents.find(a => a.id === simState.applianceId) || hoodData.applianceEffluents[0];

      simState.ionizerKv = parseFloat(ionizerSlider.value);
      simState.collectorKv = parseFloat(collectorSlider.value);
      simState.airflowCfm = parseFloat(airflowSlider.value);
      simState.runtimeHours = parseFloat(runtimeSlider.value);
      simState.carbonSat = parseFloat(carbonSlider.value);
      simState.roomAch = parseFloat(achSlider.value);

      if (ionizerVal) ionizerVal.textContent = `${simState.ionizerKv.toFixed(1)} kV DC`;
      if (collectorVal) collectorVal.textContent = `${simState.collectorKv.toFixed(1)} kV DC`;
      if (airflowVal) airflowVal.textContent = `${simState.airflowCfm.toLocaleString()} CFM`;
      if (runtimeVal) runtimeVal.textContent = `${simState.runtimeHours} Hours`;
      if (carbonVal) carbonVal.textContent = `${simState.carbonSat}% Saturated`;
      if (achVal) achVal.textContent = `${simState.roomAch} ACH`;

      // 1. Corona Wire Fouling & Field Strength Degradation (Peek's Law effect)
      // As grease accumulates, effective wire radius increases and surface roughness decreases
      const hoursFactor = simState.runtimeHours / 300.0;
      const wireFouling = Math.min(0.85, (currentAppliance.greaseEmissionRateLbHr / 10.0) * hoursFactor * 0.45);
      const fieldStrengthPct = Math.max(15, (1.0 - wireFouling) * 100);

      // 2. Deutsch-Anderson Collection Efficiency
      // eta = 1 - exp(- (w * A) / Q)
      // Particle migration velocity w proportional to Ionizer voltage * Collector voltage * Field Strength
      const baseW = 0.095; // m/s nominal migration velocity
      const voltageMultiplier = (simState.ionizerKv / 12.0) * (simState.collectorKv / 6.0);
      const effectiveW = baseW * voltageMultiplier * (fieldStrengthPct / 100);
      
      const plateAreaM2 = currentHood.collectorPlateAreaSqFt * 0.092903;
      const airflowM3s = (simState.airflowCfm * 0.000471947);
      
      const exponent = (effectiveW * plateAreaM2) / airflowM3s;
      let rawEfficiency = (1.0 - Math.exp(-exponent)) * 100;
      
      // Secondary filter polish (MERV/HEPA) adds 3-5% to residual
      const postFilterBonus = currentHood.secondaryFilter.includes('HEPA') ? 0.95 : 0.60;
      const finalEfficiency = Math.min(99.9, rawEfficiency + (100 - rawEfficiency) * postFilterBonus * 0.5);

      // 3. Ozone Generation and Catalytic Decomposition
      // Raw ozone is generated by corona wire voltage and current (kV * wireCount)
      const rawOzonePpm = (simState.ionizerKv * 0.12 * (currentHood.ionizerWireCount / 12.0)) * (1000.0 / Math.max(400, simState.airflowCfm));
      
      // Catalytic MnO2 carbon destruction efficiency decreases as carbon saturates
      const catalyticDestructEff = Math.max(0.10, 0.99 - (simState.carbonSat / 100.0) * 0.88);
      const exhaustOzonePpm = rawOzonePpm * (1.0 - catalyticDestructEff);
      
      // Dilution in kitchen breathing zone based on scullery ACH
      const roomDilutionFactor = Math.max(0.04, 1.0 / (simState.roomAch * 1.8));
      const ambientOzonePpm = exhaustOzonePpm * roomDilutionFactor * 4.2;

      // 4. Arc-Over and Flashover Risk
      // Flashover occurs when grease film thickness + high collector voltage triggers dielectric breakdown
      const greaseFilmFactor = (simState.runtimeHours / 400.0) * (currentAppliance.greaseEmissionRateLbHr / 12.0);
      const voltageStress = Math.max(0, (simState.collectorKv - 5.5) / 2.5);
      const arcingProbability = Math.min(98.5, Math.max(0.5, (greaseFilmFactor * 48.0) + (voltageStress * 32.0)));

      // 5. Total Daily Grease Captured vs Escaped
      const dailyGreaseLb = currentAppliance.greaseEmissionRateLbHr * 16.0; // 16 hr day
      const escapedGreaseLb = dailyGreaseLb * (1.0 - (finalEfficiency / 100.0));

      // 6. UL 710B Interlock Status
      const airflowShortfall = simState.airflowCfm < (currentHood.designAirflowCfm * 0.85);
      const severeArcingTrip = arcingProbability > 75.0;
      const severeOzoneTrip = ambientOzonePpm > 0.15;
      const isInterlockTripped = airflowShortfall || severeArcingTrip || severeOzoneTrip;

      // 7. Remaining Clean Cell Life
      const maxLifeHours = Math.max(40, 480 - (currentAppliance.greaseEmissionRateLbHr * 22));
      const remainingLifeHours = Math.max(0, Math.round(maxLifeHours - simState.runtimeHours));

      // Update Telemetry Display
      if (metricEff) {
        metricEff.textContent = `${finalEfficiency.toFixed(1)}%`;
        metricEff.className = `text-xl sm:text-2xl font-black font-mono ${finalEfficiency >= 95.0 ? 'text-emerald-600' : finalEfficiency >= 85.0 ? 'text-amber-600' : 'text-rose-600'}`;
      }
      if (metricEffSub) {
        metricEffSub.textContent = finalEfficiency >= 95.0 ? 'Deutsch-Anderson >95% (Pass)' : 'Submicron Smoke Escape';
      }

      if (metricField) {
        metricField.textContent = `${fieldStrengthPct.toFixed(1)}%`;
        metricField.className = `text-xl sm:text-2xl font-black font-mono ${fieldStrengthPct >= 75 ? 'text-indigo-600' : fieldStrengthPct >= 45 ? 'text-amber-600' : 'text-rose-600'}`;
      }
      if (metricFieldSub) {
        metricFieldSub.textContent = fieldStrengthPct >= 75 ? 'Clean Corona Emitter' : fieldStrengthPct >= 45 ? 'Grease Fouled Wires' : 'Severe Field Quench';
      }

      if (metricOzone) {
        metricOzone.textContent = `${ambientOzonePpm.toFixed(3)} ppm`;
        metricOzone.className = `text-xl sm:text-2xl font-black font-mono ${ambientOzonePpm < 0.05 ? 'text-emerald-600' : ambientOzonePpm < 0.10 ? 'text-amber-600' : 'text-rose-600'}`;
      }
      if (metricOzoneSub) {
        metricOzoneSub.textContent = ambientOzonePpm < 0.05 ? '<0.05 ppm OSHA Target' : ambientOzonePpm < 0.10 ? '0.05-0.10 ppm Warning' : 'EXCEEDS 0.10 ppm PEL';
      }

      if (metricArcing) {
        metricArcing.textContent = `${arcingProbability.toFixed(1)}%`;
        metricArcing.className = `text-xl sm:text-2xl font-black font-mono ${arcingProbability < 15.0 ? 'text-emerald-600' : arcingProbability < 45.0 ? 'text-amber-600' : 'text-rose-600'}`;
      }
      if (metricArcingSub) {
        metricArcingSub.textContent = arcingProbability < 15.0 ? 'Normal Dielectric Margin' : arcingProbability < 45.0 ? 'Intermittent Micro-Arcs' : 'Continuous Flashover Risk';
      }

      if (metricInterlock) {
        metricInterlock.textContent = isInterlockTripped ? 'FAULT (SHUTDOWN TRIPPED)' : 'ENERGIZED (OK)';
        metricInterlock.className = `text-sm font-bold font-mono mt-0.5 ${isInterlockTripped ? 'text-rose-600' : 'text-emerald-600'}`;
      }

      if (metricEscaped) {
        metricEscaped.textContent = `${escapedGreaseLb.toFixed(2)} lb/day (EPA Met 202)`;
      }

      if (metricLife) {
        metricLife.textContent = `${remainingLifeHours} Hours Remaining`;
      }

      // Diagnostic Report Updates
      if (reportRiskBadge && reportPrimaryRisk && reportMechanisms && reportMitigation && canvasBadge) {
        if (isInterlockTripped) {
          reportRiskBadge.textContent = 'CRITICAL SAFETY LOCKOUT (UL 710B)';
          reportRiskBadge.className = 'text-rose-600';
          canvasBadge.textContent = 'UL 710B: EMERGENCY SHUTDOWN';
          canvasBadge.className = 'text-[11px] font-mono px-2 py-0.5 rounded bg-rose-100 text-rose-800 dark:bg-rose-950 dark:text-rose-300 font-bold';

          reportPrimaryRisk.textContent = airflowShortfall 
            ? 'Airflow proving pressure switch tripped: Volumetric flow fell below 85% rated CFM due to severe filter clogging or blower fault.'
            : severeArcingTrip
            ? 'High-voltage collector arc-over trip: Continuous electrical dielectric breakdown sparks detected across grease-coated collector plates. Fire suppression alert initiated.'
            : 'Hazardous ozone breakthrough: Ambient breathing zone ozone exceeds 0.15 ppm ceiling, creating acute respiratory toxicity hazard for scullery workers.';

          reportMechanisms.textContent = `Migration w = ${effectiveW.toFixed(3)} m/s; Peek corona Vc = ${(9.2 + wireFouling * 4).toFixed(1)} kV; Raw O3 = ${rawOzonePpm.toFixed(2)} ppm; Ambient O3 = ${ambientOzonePpm.toFixed(3)} ppm; Arc probability = ${arcingProbability.toFixed(1)}%; Interlock Status = TRIPPED.`;
          reportMitigation.textContent = 'Immediately de-energize cooking equipment. Remove ESP cell and soak in hot alkaline degreaser bath. Replace saturated MnO2 activated carbon canister. Verify differential pressure switch before resetting relay.';
        } else if (finalEfficiency < 90.0 || ambientOzonePpm >= 0.05 || arcingProbability > 30.0) {
          reportRiskBadge.textContent = 'DEGRADED / ATTENTION REQUIRED';
          reportRiskBadge.className = 'text-amber-600';
          canvasBadge.textContent = 'UL 710B: Degraded Collection / Warning';
          canvasBadge.className = 'text-[11px] font-mono px-2 py-0.5 rounded bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300 font-bold';

          reportPrimaryRisk.textContent = finalEfficiency < 90.0
            ? 'Polymerized grease accumulation on corona wires has depressed unipolar electron emission, allowing fine aerosol smoke to escape into the kitchen.'
            : ambientOzonePpm >= 0.05
            ? 'Catalytic ozone destruct bed is reaching saturation; ozone concentration approaching the 0.05 ppm NIOSH recommended limit.'
            : 'Accumulated grease film on collector plates is narrowing dielectric breakdown margin, producing audible micro-arcing snaps.';

          reportMechanisms.textContent = `Migration w = ${effectiveW.toFixed(3)} m/s; Corona Field = ${fieldStrengthPct.toFixed(1)}%; Raw O3 = ${rawOzonePpm.toFixed(2)} ppm; Ambient O3 = ${ambientOzonePpm.toFixed(3)} ppm; Daily Escaped Grease = ${escapedGreaseLb.toFixed(2)} lb/day.`;
          reportMitigation.textContent = 'Schedule immediate wash cycle for 2-stage ESP cell. Inspect corona wires for bent pins or broken springs. Order replacement activated carbon filter before breakthrough reaches 0.10 ppm OSHA PEL.';
        } else {
          reportRiskBadge.textContent = 'SAFE OPERATING CONDITION (UL 710B COMPLIANT)';
          reportRiskBadge.className = 'text-emerald-600';
          canvasBadge.textContent = 'UL 710B: Compliant Clean Flow';
          canvasBadge.className = 'text-[11px] font-mono px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300 font-bold';

          reportPrimaryRisk.textContent = 'Corona wires maintain nominal unipolar electron emission. Submicron grease smoke is captured at >95% efficiency, fully compliant with EPA Method 202 and UL 710B particulate ceilings.';
          reportMechanisms.textContent = `Migration w = ${effectiveW.toFixed(3)} m/s; Peek corona onset = 9.4 kV; Catalytic ozone conversion rate = ${(catalyticDestructEff * 100).toFixed(1)}%; Ambient O3 = ${ambientOzonePpm.toFixed(3)} ppm (<0.05 target); Arc risk = ${arcingProbability.toFixed(1)}%.`;
          reportMitigation.textContent = 'Maintain standard scheduled preventative maintenance. Inspect high-voltage contact spring finger seating. Monitor kitchen ventilation air changes (keep ≥6 ACH).';
        }
      }
    }

    // Canvas Rendering Loop
    function renderCanvas() {
      if (!ctx || !canvas) return;

      const width = canvas.width;
      const height = canvas.height;
      simState.animFrame++;

      // Background
      ctx.fillStyle = '#090d16';
      ctx.fillRect(0, 0, width, height);

      // Section Boundaries (X coords)
      const xPlenumInlet = 70;
      const xBaffles = 160;
      const xIonizer = 280;
      const xCollector = 420;
      const xMerv = 520;
      const xCarbon = 610;
      const xExhaust = 680;

      // Draw Duct Housing Frame
      ctx.strokeStyle = '#334155';
      ctx.lineWidth = 3;
      ctx.strokeRect(30, 40, width - 60, height - 80);

      // Stage Divider Labels
      ctx.fillStyle = '#64748b';
      ctx.font = '10px monospace';
      ctx.textAlign = 'center';
      ctx.fillText('INLET', 70, 30);
      ctx.fillText('BAFFLES', 160, 30);
      ctx.fillText('IONIZER (12kV)', 280, 30);
      ctx.fillText('COLLECTOR (6kV)', 420, 30);
      ctx.fillText('POST-FILTER', 520, 30);
      ctx.fillText('CATALYTIC O3', 610, 30);

      // 1. Draw Baffles
      ctx.strokeStyle = '#94a3b8';
      ctx.lineWidth = 5;
      for (let y = 60; y < height - 60; y += 35) {
        ctx.beginPath();
        ctx.moveTo(xBaffles - 15, y);
        ctx.lineTo(xBaffles - 5, y + 20);
        ctx.lineTo(xBaffles - 15, y + 40);
        ctx.stroke();

        ctx.beginPath();
        ctx.moveTo(xBaffles + 10, y + 15);
        ctx.lineTo(xBaffles, y + 35);
        ctx.lineTo(xBaffles + 10, y + 55);
        ctx.stroke();
      }

      // 2. Draw Corona Ionizer Wires (Glowing purple)
      const fieldPrc = parseFloat(metricField?.textContent || '90') / 100.0;
      for (let y = 80; y < height - 80; y += 45) {
        // Corona glow gradient
        const glowRad = 18 * (simState.ionizerKv / 12.0) * fieldPrc;
        const grad = ctx.createRadialGradient(xIonizer, y, 2, xIonizer, y, glowRad);
        grad.addColorStop(0, 'rgba(216, 180, 254, 0.95)');
        grad.addColorStop(0.5, 'rgba(168, 85, 247, 0.4)');
        grad.addColorStop(1, 'rgba(147, 51, 234, 0.0)');

        ctx.fillStyle = grad;
        ctx.beginPath();
        ctx.arc(xIonizer, y, glowRad, 0, Math.PI * 2);
        ctx.fill();

        // Wire core
        ctx.fillStyle = '#ffffff';
        ctx.beginPath();
        ctx.arc(xIonizer, y, 2.5, 0, Math.PI * 2);
        ctx.fill();

        // Field lines
        ctx.strokeStyle = 'rgba(192, 132, 252, 0.25)';
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(xIonizer - 20, y);
        ctx.lineTo(xIonizer + 20, y);
        ctx.stroke();
      }

      // 3. Draw Collector Plates (Alternating Charged and Grounded)
      const plateSpacing = 28;
      const numPlates = 9;
      const startY = 70;
      for (let i = 0; i < numPlates; i++) {
        const py = startY + i * plateSpacing;
        const isCharged = (i % 2 === 0);

        ctx.strokeStyle = isCharged ? '#38bdf8' : '#94a3b8';
        ctx.lineWidth = 4;
        ctx.beginPath();
        ctx.moveTo(xCollector - 60, py);
        ctx.lineTo(xCollector + 40, py);
        ctx.stroke();

        // Grease coating accumulation visualization
        const greaseThickness = Math.min(8, (simState.runtimeHours / 720.0) * 8.0);
        if (greaseThickness > 0.5) {
          ctx.strokeStyle = '#b45309';
          ctx.lineWidth = greaseThickness;
          ctx.beginPath();
          ctx.moveTo(xCollector - 55, py - 2);
          ctx.lineTo(xCollector + 35, py - 2);
          ctx.stroke();
        }
      }

      // 4. Draw Post-Filter (MERV/HEPA)
      ctx.strokeStyle = '#cbd5e1';
      ctx.lineWidth = 3;
      ctx.strokeRect(xMerv - 8, 48, 16, height - 96);
      ctx.fillStyle = 'rgba(203, 213, 225, 0.15)';
      ctx.fillRect(xMerv - 8, 48, 16, height - 96);

      // 5. Draw Catalytic Carbon Bed
      ctx.fillStyle = '#1e293b';
      ctx.fillRect(xCarbon - 15, 48, 30, height - 96);
      ctx.strokeStyle = '#475569';
      ctx.lineWidth = 2;
      ctx.strokeRect(xCarbon - 15, 48, 30, height - 96);

      // Carbon granulate dots
      ctx.fillStyle = simState.carbonSat > 60 ? '#a855f7' : '#0284c7';
      for (let i = 0; i < 40; i++) {
        const cx = xCarbon - 10 + ((i * 13) % 20);
        const cy = 60 + ((i * 29) % (height - 120));
        ctx.beginPath();
        ctx.arc(cx, cy, 2, 0, Math.PI * 2);
        ctx.fill();
      }

      // 6. Arc-Over Sparks Generation
      const arcingRisk = parseFloat(metricArcing?.textContent || '0');
      if (arcingRisk > 25 && Math.random() < (arcingRisk / 250)) {
        simState.sparks.push({
          x: xCollector - 40 + Math.random() * 70,
          y: startY + Math.floor(Math.random() * (numPlates - 1)) * plateSpacing + 14,
          life: 0,
          maxLife: 6 + Math.random() * 8
        });
      }

      // Render Active Sparks
      for (let i = simState.sparks.length - 1; i >= 0; i--) {
        const sp = simState.sparks[i];
        sp.life++;

        ctx.strokeStyle = '#f43f5e';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(sp.x - 4, sp.y - 10);
        ctx.lineTo(sp.x + 3, sp.y - 2);
        ctx.lineTo(sp.x - 3, sp.y + 4);
        ctx.lineTo(sp.x + 4, sp.y + 10);
        ctx.stroke();

        ctx.fillStyle = '#ffffff';
        ctx.beginPath();
        ctx.arc(sp.x, sp.y, 4, 0, Math.PI * 2);
        ctx.fill();

        if (sp.life >= sp.maxLife) {
          simState.sparks.splice(i, 1);
        }
      }

      // 7. Dynamic Flow Particles
      const speed = Math.max(1.5, simState.airflowCfm / 350.0);
      const particleCount = 45;
      const eff = parseFloat(metricEff?.textContent || '95') / 100.0;

      for (let i = 0; i < particleCount; i++) {
        const t = (simState.animFrame * speed + i * 40) % (width - 80);
        const px = 40 + t;
        const py = 65 + ((i * 23) % (height - 130));

        let color = '#d97706'; // Raw brown grease
        let radius = 3.5;

        if (px > xBaffles && px < xIonizer) {
          color = '#f59e0b'; // Post-baffle fine aerosol
          radius = 2.8;
        } else if (px >= xIonizer && px < xCollector) {
          color = '#c084fc'; // Ionized charged aerosol (purple)
          radius = 2.5;
        } else if (px >= xCollector && px < xMerv) {
          // If captured, particle terminates onto plate
          if (i % 10 < eff * 10) {
            continue; // captured
          }
          color = '#fb7185'; // escaped particle
          radius = 2.0;
        } else if (px >= xMerv && px < xCarbon) {
          if (i % 10 < eff * 10) continue;
          color = '#38bdf8';
          radius = 1.8;
        } else if (px >= xCarbon) {
          // Ozone or clean exhaust air
          const ambientOzone = parseFloat(metricOzone?.textContent || '0.02');
          color = ambientOzone > 0.08 ? '#c084fc' : '#34d399';
          radius = ambientOzone > 0.08 ? 2.5 : 1.5;
        }

        ctx.fillStyle = color;
        ctx.beginPath();
        ctx.arc(px, py, radius, 0, Math.PI * 2);
        ctx.fill();
      }

      requestAnimationFrame(renderCanvas);
    }

    // Event Listeners
    [hoodSelect, applianceSelect, ionizerSlider, collectorSlider, airflowSlider, runtimeSlider, carbonSlider, achSlider].forEach(el => {
      el?.addEventListener('input', () => {
        if (hoodSelect) simState.hoodId = hoodSelect.value;
        if (applianceSelect) simState.applianceId = applianceSelect.value;
        recalculate();
      });
      el?.addEventListener('change', () => {
        if (hoodSelect) simState.hoodId = hoodSelect.value;
        if (applianceSelect) simState.applianceId = applianceSelect.value;
        recalculate();
      });
    });

    // Preset Handlers
    presetClean?.addEventListener('click', () => {
      if (ionizerSlider) ionizerSlider.value = '12.0';
      if (collectorSlider) collectorSlider.value = '6.0';
      if (runtimeSlider) runtimeSlider.value = '24';
      if (carbonSlider) carbonSlider.value = '10';
      if (achSlider) achSlider.value = '8';
      recalculate();
    });

    presetFouled?.addEventListener('click', () => {
      if (ionizerSlider) ionizerSlider.value = '9.5';
      if (collectorSlider) collectorSlider.value = '5.0';
      if (runtimeSlider) runtimeSlider.value = '540';
      if (carbonSlider) carbonSlider.value = '65';
      if (achSlider) achSlider.value = '4';
      recalculate();
    });

    presetArcing?.addEventListener('click', () => {
      if (ionizerSlider) ionizerSlider.value = '13.5';
      if (collectorSlider) collectorSlider.value = '7.5';
      if (runtimeSlider) runtimeSlider.value = '480';
      if (carbonSlider) carbonSlider.value = '40';
      if (achSlider) achSlider.value = '6';
      recalculate();
    });

    presetOzone?.addEventListener('click', () => {
      if (ionizerSlider) ionizerSlider.value = '14.0';
      if (collectorSlider) collectorSlider.value = '6.5';
      if (runtimeSlider) runtimeSlider.value = '120';
      if (carbonSlider) carbonSlider.value = '95';
      if (achSlider) achSlider.value = '2';
      recalculate();
    });

    // Copy Telemetry Report Handler
    copyBtn?.addEventListener('click', () => {
      const hood = hoodData.hoodConfigurations.find(h => h.id === simState.hoodId)?.name || 'Ventless Hood';
      const appliance = hoodData.applianceEffluents.find(a => a.id === simState.applianceId)?.name || 'Appliance';
      const eff = metricEff?.textContent || '0%';
      const field = metricField?.textContent || '0%';
      const ozone = metricOzone?.textContent || '0 ppm';
      const arcing = metricArcing?.textContent || '0%';
      const interlock = metricInterlock?.textContent || 'OK';
      const escaped = metricEscaped?.textContent || '0 lb/day';
      const risk = reportRiskBadge?.textContent || 'NORMAL';

      const reportText = [
        `======================================================================`,
        `ISITKITCHENSAFE TELEMETRY: COMMERCIAL VENTLESS HOOD ESP & OZONE MODEL`,
        `Timestamp: ${new Date().toISOString()}`,
        `Standards: UL 710B | NFPA 96 Chapter 13 | OSHA 29 CFR 1910.1000 | EPA 202`,
        `======================================================================`,
        `Hood Configuration: ${hood}`,
        `Cooking Appliance: ${appliance}`,
        `ESP Ionizer Voltage: ${simState.ionizerKv} kV DC`,
        `ESP Collector Voltage: ${simState.collectorKv} kV DC`,
        `Operating Airflow: ${simState.airflowCfm} CFM`,
        `Accumulated Runtime: ${simState.runtimeHours} Hours`,
        `Carbon/MnO2 Saturation: ${simState.carbonSat}%`,
        `Scullery Ventilation: ${simState.roomAch} ACH`,
        `----------------------------------------------------------------------`,
        `DIAGNOSTIC TELEMETRY:`,
        `- ESP Collection Efficiency: ${eff}`,
        `- Corona Field Maintenance: ${field}`,
        `- Kitchen Breathing Zone Ozone: ${ozone} (OSHA Limit: 0.10 ppm / NIOSH: 0.05 ppm)`,
        `- Dielectric Arc-Over Flashover Risk: ${arcing}`,
        `- UL 710B Safety Relay Status: ${interlock}`,
        `- Escaped Grease Particulate: ${escaped}`,
        `- Compliance Verdict: ${risk}`,
        `======================================================================`
      ].join('\n');

      navigator.clipboard.writeText(reportText).then(() => {
        if (copyBtnText) copyBtnText.textContent = 'Copied!';
        setTimeout(() => {
          if (copyBtnText) copyBtnText.textContent = 'Copy Telemetry Report';
        }, 2000);
      });
    });

    // Initial Trigger & Start Canvas Loop
    recalculate();
    renderCanvas();
  }

  // Initialize on load and on Astro page transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initVentlessEspModeler);
  } else {
    initVentlessEspModeler();
  }
  document.addEventListener('astro:page-load', initVentlessEspModeler);
</script>
