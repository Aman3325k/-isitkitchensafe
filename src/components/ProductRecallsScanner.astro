    actionHeading: "直ちに行うべき行動および無償救済措置",
    verificationHeading: "定格銘板およびロット番号の確認方法",
    chemicalHeading: "毒性物質・材料化学リスクの解説",
    hotlineHeading: "メーカー問い合わせ窓口・公式サイト",
    officialDocBtn: "米当局 (CPSC/FDA) 公式リコール文書を見る &rarr;",
    howToCheckTitle: "製品銘板・バーコード・ロット番号の調べ方",
    howToCheckSub: "公式リコールは特定の製造年・ロット・UPCコードに限定されます。以下の手順でご確認ください：",
    checkStep1Title: "1. 底面の定格銘板（ラベル）を確認",
    checkStep1Desc: "ノンフライヤーやマルチクッカーの底面にある銀色ラベルに、正式な型番（Model）と製造シリアルが刻印されています。",
    checkStep2Title: "2. 箱や製品の12桁UPCバーコードを確認",
    checkStep2Desc: "パッケージ外箱や底面シールの12桁または13桁の数字をそのままスキャナーに入力して検索できます。",
    checkStep3Title: "3. 電源プラグの金属端子に刻印された製造年週",
    checkStep3Desc: "電気圧力鍋など一部の家電製品は、電源プラグの金属端子に直接製造年コード（K160TS等）が打刻されています。",
    testingTitle: "調理器具に潜む重大な物理・化学的危険のサイン",
    testingLead: "鉛の溶出：低温焼成された手作業陶器や伝統食器は、熱いコーヒーや酸味のあるスープに触れると基準値を大幅に超える鉛が溶出します。",
    testingThermal: "熱衝撃破壊：ソーダライム強化ガラスの蓋は、オーブン加熱後に冷えた濡れた調理台に置くと内部応力で破裂飛散する危険があります。",
    testingBlades: "刃の金属疲労：リベット留めされたフードプロセッサーの刃は、経年劣化でリベット部から金属破片が欠落し食材に混入します。",
    clearSearch: "検索条件をクリア",
    crossLinkTools: "関連する調理器具安全ツール",
    crossLinkPanInspector: "AI フライパン傷診断",
    crossLinkBrandIndex: "調理器具ブランド 透明度調査名鑑",
    crossLinkEmergency: "キッチン危険緊急トリアージ"
  }
};

const d = DICT[lang] || DICT.en;
---

<div class="product-recalls-scanner bg-surface-soft border border-hairline rounded-3xl p-6 md:p-10 shadow-sm" id="recallsApp">
  <!-- Top Tool Header -->
  <div class="mb-8 border-b border-hairline/80 pb-6">
    <div class="flex flex-wrap items-center justify-between gap-3 mb-2">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-rose-600 text-white">
        <span class="w-2 h-2 rounded-full bg-white animate-pulse"></span>
        {d.badge}
      </span>
      <span class="text-xs text-muted font-mono font-medium">
        CPSC &bull; FDA &bull; Health Canada &bull; RAPEX
      </span>
    </div>
    <h2 class="text-title-lg md:text-display-sm font-medium text-ink tracking-tight mb-2">
      {d.title}
    </h2>
    <p class="text-body text-sm md:text-[15px] leading-relaxed max-w-3xl">
      {d.subtitle}
    </p>
  </div>

  <!-- Search & Barcode Camera Scanner Controls -->
  <div class="space-y-4 mb-8">
    <div class="flex flex-col sm:flex-row gap-3">
      <!-- Search Input -->
      <div class="relative flex-1">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-muted">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>
        <input 
          type="text" 
          id="recallSearchInput"
          placeholder={d.searchPlaceholder}
          class="w-full pl-11 pr-10 py-3.5 rounded-xl bg-white border border-hairline text-ink text-sm focus:outline-none focus:ring-2 focus:ring-rose-500 focus:border-transparent transition-all shadow-xs"
        />
        <button 
          type="button" 
          id="clearSearchBtn" 
          class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-muted hover:text-ink hidden"
          title={d.clearSearch}
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <!-- Camera Barcode Scan Toggle Button -->
      <button 
        type="button" 
        id="cameraScanToggleBtn"
        class="inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-xl bg-ink hover:bg-black text-white font-medium text-sm transition-colors shadow-xs whitespace-nowrap cursor-pointer"
      >
        <span id="cameraBtnIcon">📷</span>
        <span id="cameraBtnText">{d.scanCameraBtn}</span>
      </button>
    </div>

    <!-- Live Video Viewport (Initially hidden) -->
    <div id="cameraViewportContainer" class="hidden bg-slate-950 border border-slate-800 rounded-2xl p-4 text-center relative overflow-hidden transition-all">
      <div class="max-w-md mx-auto relative rounded-xl overflow-hidden bg-black aspect-video flex items-center justify-center">
        <video id="barcodeVideo" class="w-full h-full object-cover" playsinline muted></video>
        <!-- Targeting Reticle -->
        <div class="absolute inset-0 border-2 border-dashed border-rose-500/80 rounded-xl m-6 pointer-events-none flex flex-col items-center justify-between p-3">
          <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-white bg-black/70 px-2 py-0.5 rounded">
            SCANNING FOR BARCODE
          </span>
          <div class="w-full h-0.5 bg-rose-500 shadow-[0_0_8px_#f43f5e] animate-pulse"></div>
          <span class="text-[10px] text-white/80 font-sans">
            UPC-A / EAN-13 / CODE-128
          </span>
        </div>
      </div>
      <p class="text-xs text-slate-400 mt-3" id="cameraStatusMsg">
        {d.cameraPrompt}
      </p>
    </div>

    <!-- Quick Example Recall Samples -->
    <div class="flex flex-wrap items-center gap-2 pt-1 text-xs">
      <span class="text-muted font-medium">{d.quickSamplesLabel}</span>
      <button type="button" class="sample-chip px-3 py-1.5 rounded-lg bg-surface hover:bg-surface-strong border border-hairline text-ink transition-colors" data-query="817915025703">
        🔥 Cosori (817915025703)
      </button>
      <button type="button" class="sample-chip px-3 py-1.5 rounded-lg bg-surface hover:bg-surface-strong border border-hairline text-ink transition-colors" data-query="850011833005">
        ⚡ BlendJet 2 (850011833005)
      </button>
      <button type="button" class="sample-chip px-3 py-1.5 rounded-lg bg-surface hover:bg-surface-strong border border-hairline text-ink transition-colors" data-query="SCCPPC600">
        ⚠️ Crock-Pot (SCCPPC600)
      </button>
      <button type="button" class="sample-chip px-3 py-1.5 rounded-lg bg-surface hover:bg-surface-strong border border-hairline text-ink transition-colors" data-query="Cupkin">
        🥛 Cupkin Lead Cup
      </button>
      <button type="button" class="sample-chip px-3 py-1.5 rounded-lg bg-surface hover:bg-surface-strong border border-hairline text-ink transition-colors" data-query="Cuisinart">
        🔪 Cuisinart Riveted Blade
      </button>
      <button type="button" class="sample-chip px-3 py-1.5 rounded-lg bg-surface hover:bg-surface-strong border border-hairline text-ink transition-colors" data-query="TJX Lead">
        🧪 Lead Glazed Ceramics
      </button>
    </div>
  </div>

  <!-- Category & Severity Filters -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 mb-8">
    <!-- Category Filter -->
    <div>
      <label for="categorySelect" class="block text-xs font-semibold uppercase tracking-wider text-muted mb-1.5">
        Product Category
      </label>
      <select id="categorySelect" class="w-full px-3 py-2.5 rounded-xl bg-white border border-hairline text-ink text-sm focus:outline-none focus:ring-2 focus:ring-rose-500">
        <option value="all">{d.filterAllCats}</option>
        <option value="air-fryers">{d.filterAirFryers}</option>
        <option value="blenders">{d.filterBlenders}</option>
        <option value="pressure-cookers">{d.filterPressureCookers}</option>
        <option value="drinkware-bottles">{d.filterDrinkware}</option>
        <option value="cookware-bakeware">{d.filterCookware}</option>
        <option value="tableware-ceramics">{d.filterTableware}</option>
        <option value="small-appliances">{d.filterSmallApp}</option>
      </select>
    </div>

    <!-- Severity Filter -->
    <div>
      <label for="severitySelect" class="block text-xs font-semibold uppercase tracking-wider text-muted mb-1.5">
        Hazard Severity Level
      </label>
      <select id="severitySelect" class="w-full px-3 py-2.5 rounded-xl bg-white border border-hairline text-ink text-sm focus:outline-none focus:ring-2 focus:ring-rose-500">
        <option value="all">{d.filterAllSeverities}</option>
        <option value="critical">{d.filterCritical}</option>
        <option value="high">{d.filterHigh}</option>
        <option value="moderate">{d.filterModerate}</option>
      </select>
    </div>

    <!-- Regulatory Agency Filter -->
    <div>
      <label for="agencySelect" class="block text-xs font-semibold uppercase tracking-wider text-muted mb-1.5">
        Regulatory Agency
      </label>
      <select id="agencySelect" class="w-full px-3 py-2.5 rounded-xl bg-white border border-hairline text-ink text-sm focus:outline-none focus:ring-2 focus:ring-rose-500">
        <option value="all">All Regulatory Agencies (CPSC / FDA / RAPEX)</option>
        <option value="CPSC">CPSC (Consumer Product Safety Commission)</option>
        <option value="FDA">FDA (Food &amp; Drug Administration)</option>
        <option value="RAPEX">EU RAPEX Safety Gate</option>
      </select>
    </div>
  </div>

  <!-- Direct Barcode Match Banner (Dynamic) -->
  <div id="barcodeMatchAlertBanner" class="hidden mb-8 p-5 rounded-2xl bg-rose-50 border-2 border-rose-600 text-rose-950 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 animate-bounce">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-rose-600 text-white font-bold flex items-center justify-center shrink-0 text-xl">
        ⚠️
      </div>
      <div>
        <h4 class="font-bold text-base text-rose-900 tracking-tight">
          {d.matchAlertTitle}
        </h4>
        <p class="text-xs text-rose-800 leading-relaxed" id="matchAlertDesc">
          {d.matchAlertSub}
        </p>
      </div>
    </div>
    <span class="inline-block px-3 py-1 rounded-full text-xs font-extrabold uppercase tracking-wider bg-rose-700 text-white shrink-0">
      URGENT SAFETY RECALL
    </span>
  </div>

  <!-- Results Count Bar -->
  <div class="flex items-center justify-between text-xs text-muted mb-6 pb-2 border-b border-hairline">
    <div>
      {d.resultsShowing} <strong id="visibleCount" class="text-ink font-semibold">{recallsData.length}</strong> {d.resultsOf} <span class="font-semibold">{recallsData.length}</span> {d.resultsRecalls}
    </div>
    <button type="button" id="resetFiltersBtn" class="text-rose-600 hover:text-rose-800 font-medium underline cursor-pointer hidden">
      {d.clearSearch}
    </button>
  </div>

  <!-- Recalls Cards Grid -->
  <div class="space-y-6" id="recallsListContainer">
    {recallsData.map((item) => (
      <article 
        class="recall-card bg-surface border border-hairline hover:border-hairline/80 rounded-2xl p-6 md:p-8 transition-all shadow-xs"
        data-id={item.id}
        data-brand={item.brand.toLowerCase()}
        data-category={item.category}
        data-severity={item.hazardSeverity}
        data-agency={item.recallAgency}
        data-search={`${item.productName} ${item.brand} ${item.recallId} ${item.modelNumbers.join(' ')} ${item.barcodes.join(' ')} ${item.hazardSummary} ${item.hazardType}`.toLowerCase()}
        data-barcodes={item.barcodes.join(',')}
      >
        <!-- Card Header -->
        <div class="flex flex-wrap items-start justify-between gap-3 mb-4">
          <div class="space-y-1 max-w-2xl">
            <div class="flex flex-wrap items-center gap-2">
              <span class={`inline-block px-2.5 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wider text-white ${
                item.hazardSeverity === 'critical' ? 'bg-rose-600' :
                item.hazardSeverity === 'high' ? 'bg-amber-600' : 'bg-slate-700'
              }`}>
                {item.hazardType}
              </span>
              <span class="text-xs font-mono font-semibold text-ink bg-surface-soft px-2 py-0.5 rounded border border-hairline">
                {item.recallId}
              </span>
              <span class="text-xs text-muted">
                &bull; {item.recallDate}
              </span>
            </div>
            <h3 class="text-title-md md:text-title-lg font-medium text-ink tracking-tight">
              {item.productName}
            </h3>
            <p class="text-xs text-muted font-medium">
              Manufacturer / Brand: <span class="text-ink font-semibold">{item.brand}</span>
            </p>
          </div>

          <div class="text-right sm:text-right shrink-0">
            <span class="text-xs text-muted block mb-0.5">{d.unitsLabel}</span>
            <span class="inline-block px-3 py-1 rounded-xl bg-surface-soft border border-hairline font-mono text-xs font-bold text-ink">
              {item.unitsAffected.split('(')[0].trim()}
            </span>
          </div>
        </div>

        <!-- Hazard Summary Callout -->
        <div class="p-4 rounded-xl bg-rose-50/70 border border-rose-200/80 mb-5">
          <h4 class="text-xs font-bold uppercase tracking-wider text-rose-900 mb-1">
            {d.hazardHeading}
          </h4>
          <p class="text-xs md:text-sm text-rose-950 leading-relaxed">
            {item.hazardSummary}
          </p>
          {item.incidentsReported && (
            <div class="mt-2 pt-2 border-t border-rose-200/60 text-[11px] text-rose-800 font-medium">
              <strong>Official Incident Record:</strong> {item.incidentsReported}
            </div>
          )}
        </div>

        <!-- Spec Pills: Barcodes & Models -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-5 text-xs">
          <!-- Recalled Models -->
          <div class="p-3.5 rounded-xl bg-surface-soft border border-hairline">
            <span class="font-bold uppercase tracking-wider text-muted text-[10px] block mb-1.5">
              {d.modelsLabel}
            </span>
            <div class="flex flex-wrap gap-1.5">
              {item.modelNumbers.map((m) => (
                <span class="px-2 py-0.5 rounded bg-white border border-hairline font-mono text-ink text-[11px]">
                  {m}
                </span>
              ))}
            </div>
          </div>

          <!-- Recalled Barcodes -->
          <div class="p-3.5 rounded-xl bg-surface-soft border border-hairline">
            <span class="font-bold uppercase tracking-wider text-muted text-[10px] block mb-1.5">
              {d.barcodesLabel}
            </span>
            <div class="flex flex-wrap gap-1.5">
              {item.barcodes.map((bc) => (
                <span class="barcode-tag px-2 py-0.5 rounded bg-white border border-hairline font-mono text-ink text-[11px]" data-bc={bc}>
                  {bc}
                </span>
              ))}
            </div>
          </div>
        </div>

        <!-- Consumer Action & Remedy Box -->
        <div class="p-4 rounded-xl bg-surface-soft border border-hairline mb-5 space-y-2">
          <div class="flex items-center justify-between">
            <h4 class="text-xs font-bold uppercase tracking-wider text-ink">
              {d.actionHeading}
            </h4>
            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-emerald-700 text-white">
              {item.remedyType}
            </span>
          </div>
          <p class="text-xs text-body leading-relaxed">
            {item.consumerAction}
          </p>
          <div class="text-xs text-muted pt-2 border-t border-hairline flex flex-wrap items-center justify-between gap-2">
            <div>
              <span class="font-semibold text-ink">{d.hotlineHeading}:</span> {item.contactInfo}
            </div>
            <a 
              href={item.officialUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="inline-flex items-center gap-1 font-semibold text-rose-600 hover:text-rose-800 text-xs"
            >
              <Fragment set:html={d.officialDocBtn} />
            </a>
          </div>
        </div>

        <!-- Verification Tip Toggle/Guidance -->
        <div class="text-xs border-t border-hairline/80 pt-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-muted">
          <div>
            <strong class="text-ink font-semibold">{d.verificationHeading}:</strong> {item.verificationTip}
          </div>
          <div class="shrink-0 text-[11px] font-mono text-muted">
            Agency: <span class="text-ink font-semibold">{item.recallAgency}</span>
          </div>
        </div>
      </article>
    ))}
  </div>

  <!-- Empty State -->
  <div id="noResultsState" class="hidden text-center py-16 px-4 bg-surface rounded-2xl border border-hairline">
    <div class="w-12 h-12 rounded-full bg-surface-soft text-muted flex items-center justify-center mx-auto mb-3 text-2xl">
      🔍
    </div>
    <h3 class="text-title-md font-medium text-ink mb-1">
      {d.noResultsTitle}
    </h3>
    <p class="text-body text-xs max-w-md mx-auto mb-4 leading-relaxed">
      {d.noResultsSub}
    </p>
    <button 
      type="button" 
      id="resetFromEmptyBtn" 
      class="px-4 py-2 rounded-xl bg-ink text-white text-xs font-medium hover:bg-black transition-colors"
    >
      {d.clearSearch}
    </button>
  </div>

  <!-- Educational Guide: Rating Plates & Barcodes -->
  <div class="mt-12 border-t border-hairline pt-10">
    <div class="max-w-3xl mb-8">
      <span class="text-caption text-muted uppercase tracking-wider text-xs block mb-1">
        Consumer Protection Protocols &bull; Regulatory Compliance
      </span>
      <h3 class="text-title-lg font-medium text-ink tracking-tight mb-2">
        {d.howToCheckTitle}
      </h3>
      <p class="text-body text-sm leading-relaxed">
        {d.howToCheckSub}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
      <div class="p-5 rounded-2xl bg-surface-soft border border-hairline space-y-2">
        <div class="w-7 h-7 rounded-lg bg-ink text-white font-bold flex items-center justify-center text-xs">
          1
        </div>
        <h4 class="font-semibold text-ink text-sm">{d.checkStep1Title}</h4>
        <p class="text-xs text-body leading-relaxed">{d.checkStep1Desc}</p>
      </div>

      <div class="p-5 rounded-2xl bg-surface-soft border border-hairline space-y-2">
        <div class="w-7 h-7 rounded-lg bg-ink text-white font-bold flex items-center justify-center text-xs">
          2
        </div>
        <h4 class="font-semibold text-ink text-sm">{d.checkStep2Title}</h4>
        <p class="text-xs text-body leading-relaxed">{d.checkStep2Desc}</p>
      </div>

      <div class="p-5 rounded-2xl bg-surface-soft border border-hairline space-y-2">
        <div class="w-7 h-7 rounded-lg bg-ink text-white font-bold flex items-center justify-center text-xs">
          3
        </div>
        <h4 class="font-semibold text-ink text-sm">{d.checkStep3Title}</h4>
        <p class="text-xs text-body leading-relaxed">{d.checkStep3Desc}</p>
      </div>
    </div>

    <!-- Safety Warning Signs -->
    <div class="p-6 rounded-2xl bg-canvas border border-hairline space-y-4">
      <h4 class="text-sm font-bold text-ink uppercase tracking-wider">
        {d.testingTitle}
      </h4>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs text-body">
        <div class="p-3.5 rounded-xl bg-surface-soft border border-hairline">
          <strong class="text-rose-600 block mb-1">🧪 Lead Poisoning Risk</strong>
          {d.testingLead}
        </div>
        <div class="p-3.5 rounded-xl bg-surface-soft border border-hairline">
          <strong class="text-amber-600 block mb-1">💥 Explosive Shattering</strong>
          {d.testingThermal}
        </div>
        <div class="p-3.5 rounded-xl bg-surface-soft border border-hairline">
          <strong class="text-blue-600 block mb-1">🔪 Metal Sliver Ingestion</strong>
          {d.testingBlades}
        </div>
      </div>
    </div>
  </div>

  <!-- Internal Cross Links to other tools -->
  <div class="mt-10 pt-8 border-t border-hairline flex flex-wrap items-center justify-between gap-4 text-xs">
    <span class="text-muted font-medium">{d.crossLinkTools}:</span>
    <div class="flex flex-wrap gap-2">
      <a href="/tools/pan-scratch-inspector/" class="px-3 py-1.5 rounded-lg bg-surface hover:bg-surface-strong border border-hairline font-medium text-ink transition-colors">
        {d.crossLinkPanInspector} &rarr;
      </a>
      <a href="/tools/cookware-brand-transparency-index/" class="px-3 py-1.5 rounded-lg bg-surface hover:bg-surface-strong border border-hairline font-medium text-ink transition-colors">
        {d.crossLinkBrandIndex} &rarr;
      </a>
      <a href={lang === 'en' ? "/tools/kitchen-hazard-emergency-triage/" : `/${lang}/tools/kitchen-hazard-emergency-triage/`} class="px-3 py-1.5 rounded-lg bg-surface hover:bg-surface-strong border border-hairline font-medium text-ink transition-colors">
        {d.crossLinkEmergency} &rarr;
      </a>
      <a href={lang === 'en' ? "/tools/toxic-leaching-scorecard/" : `/${lang}/tools/toxic-leaching-scorecard/`} class="px-3 py-1.5 rounded-lg bg-surface hover:bg-surface-strong border border-hairline font-medium text-ink transition-colors">
        🧪 {lang === 'es' ? 'Calculadora de Lixiviación Tóxica' : lang === 'pt' ? 'Calculadora de Liberação Tóxica' : lang === 'zh-cn' ? '有毒溶出与 PFAS 测评' : lang === 'ja' ? '有害物質溶出カリキュレーター' : 'Toxic Leaching & PFAS Scorecard'} &rarr;
      </a>
      <a href={lang === 'en' ? "/tools/material-swap-calculator/" : `/${lang}/tools/material-swap-calculator/`} class="px-3 py-1.5 rounded-lg bg-surface hover:bg-surface-strong border border-hairline font-medium text-ink transition-colors">
        🔄 {lang === 'es' ? 'Calculadora de Sustitución Segura' : lang === 'pt' ? 'Calculadora de Troca Segura' : lang === 'zh-cn' ? '无毒材质替换计算器' : lang === 'ja' ? '素材乗り換え計算機' : 'Material Swap Calculator'} &rarr;
      </a>
    </div>
  </div>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('recallSearchInput');
    const clearBtn = document.getElementById('clearSearchBtn');
    const categorySelect = document.getElementById('categorySelect');
    const severitySelect = document.getElementById('severitySelect');
    const agencySelect = document.getElementById('agencySelect');
    const resetFiltersBtn = document.getElementById('resetFiltersBtn');
    const resetFromEmptyBtn = document.getElementById('resetFromEmptyBtn');
    const visibleCount = document.getElementById('visibleCount');
    const noResultsState = document.getElementById('noResultsState');
    const barcodeMatchAlertBanner = document.getElementById('barcodeMatchAlertBanner');
    const matchAlertDesc = document.getElementById('matchAlertDesc');
    const cards = Array.from(document.querySelectorAll('.recall-card'));
    const sampleChips = document.querySelectorAll('.sample-chip');

    // Camera Barcode Scanning Elements
    const cameraToggleBtn = document.getElementById('cameraScanToggleBtn');
    const cameraViewport = document.getElementById('cameraViewportContainer');
    const barcodeVideo = document.getElementById('barcodeVideo');
    const cameraStatusMsg = document.getElementById('cameraStatusMsg');
    const cameraBtnIcon = document.getElementById('cameraBtnIcon');
    const cameraBtnText = document.getElementById('cameraBtnText');

    let isScanning = false;
    let cameraStream = null;
    let scanInterval = null;
    let barcodeDetector = null;

    // Check BarcodeDetector support
    if ('BarcodeDetector' in window) {
      try {
        barcodeDetector = new window.BarcodeDetector({
          formats: ['qr_code', 'ean_13', 'ean_8', 'upc_a', 'upc_e', 'code_128', 'code_39']
        });
      } catch (err) {
        console.warn('BarcodeDetector format error:', err);
      }
    }

    async function startCameraScanner() {
      if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
        alert('Camera access is not supported by your browser.');
        return;
      }

      try {
        cameraStream = await navigator.mediaDevices.getUserMedia({
          video: { facingMode: 'environment' }
        });
        barcodeVideo.srcObject = cameraStream;
        await barcodeVideo.play();

        isScanning = true;
        cameraViewport.classList.remove('hidden');
        cameraBtnIcon.textContent = '⏹';
        cameraBtnText.textContent = 'Stop Camera Scanner';

        if (barcodeDetector) {
          scanInterval = setInterval(async () => {
            if (!isScanning) return;
            try {
              const barcodes = await barcodeDetector.detect(barcodeVideo);
              if (barcodes.length > 0) {
                const detectedVal = barcodes[0].rawValue;
                if (detectedVal) {
                  stopCameraScanner();
                  searchInput.value = detectedVal;
                  filterRecalls();
                  // Vibrate if supported
                  if (navigator.vibrate) navigator.vibrate(200);
                }
              }
            } catch (scanErr) {
              // Frame dropped or decoding error, ignore
            }
          }, 300);
        } else {
          cameraStatusMsg.textContent = 'Camera active. For browsers without native BarcodeDetector, please type the barcode into the search box.';
        }
      } catch (camErr) {
        console.error('Camera access error:', camErr);
        alert('Could not access camera. Please allow camera permissions or enter barcode manually.');
      }
    }

    function stopCameraScanner() {
      isScanning = false;
      if (scanInterval) clearInterval(scanInterval);
      if (cameraStream) {
        cameraStream.getTracks().forEach(t => t.stop());
        cameraStream = null;
      }
      if (barcodeVideo) barcodeVideo.srcObject = null;
      cameraViewport.classList.add('hidden');
      cameraBtnIcon.textContent = '📷';
      cameraBtnText.textContent = 'Scan Barcode with Camera';
    }

    if (cameraToggleBtn) {
      cameraToggleBtn.addEventListener('click', () => {
        if (isScanning) {
          stopCameraScanner();
        } else {
          startCameraScanner();
        }
      });
    }

    function filterRecalls() {
      const query = (searchInput.value || '').trim().toLowerCase();
      const cleanDigits = query.replace(/[^0-9]/g, '');
      const selectedCategory = categorySelect.value;
      const selectedSeverity = severitySelect.value;
      const selectedAgency = agencySelect.value;

      if (query.length > 0) {
        clearBtn.classList.remove('hidden');
        resetFiltersBtn.classList.remove('hidden');
      } else {
        clearBtn.classList.add('hidden');
        if (selectedCategory === 'all' && selectedSeverity === 'all' && selectedAgency === 'all') {
          resetFiltersBtn.classList.add('hidden');
        } else {
          resetFiltersBtn.classList.remove('hidden');
        }
      }

      let matchCount = 0;
      let directBarcodeMatchItem = null;

      cards.forEach(card => {
        const itemSearch = card.getAttribute('data-search') || '';
        const itemCategory = card.getAttribute('data-category') || '';
        const itemSeverity = card.getAttribute('data-severity') || '';
        const itemAgency = card.getAttribute('data-agency') || '';
        const itemBarcodes = (card.getAttribute('data-barcodes') || '').split(',');

        let matchesSearch = true;
        if (query) {
          // Check text query
          const textMatch = itemSearch.includes(query);
          // Check exact or partial barcode digit match
          const barcodeMatch = cleanDigits.length >= 4 && itemBarcodes.some(b => b.includes(cleanDigits));
          matchesSearch = textMatch || barcodeMatch;

          // Check if exact barcode hit
          if (cleanDigits.length >= 8 && itemBarcodes.some(b => b === cleanDigits || b.endsWith(cleanDigits))) {
            directBarcodeMatchItem = card;
          }
        }

        const matchesCategory = selectedCategory === 'all' || itemCategory === selectedCategory;
        const matchesSeverity = selectedSeverity === 'all' || itemSeverity === selectedSeverity;
        const matchesAgency = selectedAgency === 'all' || itemAgency === selectedAgency;

        const isVisible = matchesSearch && matchesCategory && matchesSeverity && matchesAgency;

        if (isVisible) {
          card.classList.remove('hidden');
          matchCount++;

          // Highlight matching barcode tag if digits match
          const tags = card.querySelectorAll('.barcode-tag');
          tags.forEach(t => {
            const bcVal = t.getAttribute('data-bc') || '';
            if (cleanDigits.length >= 6 && bcVal.includes(cleanDigits)) {
              t.classList.add('bg-rose-600', 'text-white', 'font-bold');
              t.classList.remove('bg-white', 'text-ink');
            } else {
              t.classList.remove('bg-rose-600', 'text-white', 'font-bold');
              t.classList.add('bg-white', 'text-ink');
            }
          });
        } else {
          card.classList.add('hidden');
        }
      });

      // Update visible count
      visibleCount.textContent = matchCount.toString();

      // Toggle Empty State
      if (matchCount === 0) {
        noResultsState.classList.remove('hidden');
      } else {
        noResultsState.classList.add('hidden');
      }

      // Toggle Direct Barcode Match Banner
      if (directBarcodeMatchItem) {
        const prodName = directBarcodeMatchItem.querySelector('h3')?.textContent || 'Kitchenware Item';
        matchAlertDesc.textContent = `Your scanned code matches the active recall for "${prodName}". Cease use immediately.`;
        barcodeMatchAlertBanner.classList.remove('hidden');
      } else {
        barcodeMatchAlertBanner.classList.add('hidden');
      }
    }

    // Input & Change listeners
    searchInput.addEventListener('input', filterRecalls);
    categorySelect.addEventListener('change', filterRecalls);
    severitySelect.addEventListener('change', filterRecalls);
    agencySelect.addEventListener('change', filterRecalls);

    // Clear Search button
    clearBtn.addEventListener('click', () => {
      searchInput.value = '';
      searchInput.focus();
      filterRecalls();
    });

    // Reset filters
    function resetAllFilters() {
      searchInput.value = '';
      categorySelect.value = 'all';
      severitySelect.value = 'all';
      agencySelect.value = 'all';
      filterRecalls();
    }
    resetFiltersBtn.addEventListener('click', resetAllFilters);
    resetFromEmptyBtn.addEventListener('click', resetAllFilters);

    // Sample chips clickers
    sampleChips.forEach(chip => {
      chip.addEventListener('click', () => {
        const query = chip.getAttribute('data-query');
        if (query) {
          searchInput.value = query;
          categorySelect.value = 'all';
          severitySelect.value = 'all';
          agencySelect.value = 'all';
          filterRecalls();
          searchInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      });
    });
  });
</script>
