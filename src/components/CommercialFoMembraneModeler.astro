  function calculateModel() {
    if (!systemSelect || !matrixSelect || !drawSoluteSelect || !drawOsmoticSlider || 
        !targetBrixSlider || !crossflowVelocitySlider || !membraneSSlider || !tempSlider) {
      return;
    }

    const systemKey = systemSelect.value;
    const matrixKey = matrixSelect.value;
    const drawKey = drawSoluteSelect.value;

    const sys = foSystemsData[systemKey] || foSystemsData.commercial_multi_stage_fo_1200l;
    const mat = foodMatricesData[matrixKey] || foodMatricesData.cold_pressed_orange_juice;
    const draw = drawSolutionsData[drawKey] || drawSolutionsData.nacl_brine;

    const piDrawBulk = parseFloat(drawOsmoticSlider.value);
    const targetBrix = parseFloat(targetBrixSlider.value);
    const vCross = parseFloat(crossflowVelocitySlider.value);
    const sValueMicrons = parseFloat(membraneSSlider.value);
    const tempC = parseFloat(tempSlider.value);

    // Update Slider Displays
    if (drawOsmoticValue) drawOsmoticValue.textContent = `${piDrawBulk.toFixed(0)} bar`;
    if (targetBrixValue) targetBrixValue.textContent = `${targetBrix.toFixed(1)} °Brix`;
    if (crossflowVelocityValue) crossflowVelocityValue.textContent = `${vCross.toFixed(2)} m/s`;
    if (membraneSValue) membraneSValue.textContent = `${sValueMicrons.toFixed(0)} µm`;
    if (tempValue) tempValue.textContent = `${tempC.toFixed(0)} °C`;

    // Descriptions
    if (systemDescriptionText) systemDescriptionText.textContent = sys.desc;
    if (matrixDescriptionText) matrixDescriptionText.textContent = mat.desc;
    if (drawSoluteDescriptionText) drawSoluteDescriptionText.textContent = draw.desc;

    // 1. Osmotic Pressure of Feed Stream at Target Brix
    // pi_feed = a * Brix + b * Brix^2 * (T_abs / 298.15)
    const tAbs = tempC + 273.15;
    const piFeedBulk = (1.25 * targetBrix + 0.082 * Math.pow(targetBrix, 1.85)) * (tAbs / 298.15);

    // 2. Mass Transfer Boundary Layer Coefficient (k_feed)
    // Sherwood correlation: Sh = 0.04 * Re^0.75 * Sc^0.33
    const feedViscosityCp = 1.0 + (targetBrix / 10.0) * 1.8;
    const dHydraulic = 0.002; // 2 mm channel
    const feedDiffusivity = mat.diffusivity * (tAbs / 298.15) * (1.0 / (feedViscosityCp / 1.2));
    const reynolds = (mat.density * vCross * dHydraulic) / (feedViscosityCp * 1e-3);
    const schmidt = (feedViscosityCp * 1e-3) / (mat.density * feedDiffusivity);
    const sherwood = Math.max(3.66, 0.04 * Math.pow(reynolds, 0.75) * Math.pow(schmidt, 0.33));
    const kFeed = (sherwood * feedDiffusivity) / dHydraulic; // m/s
    const kFeedLmh = kFeed * 3600 * 1000; // LMH equivalent

    // 3. Structural Parameter & Diffusion in Porous Support Layer (ICP)
    const sValueM = sValueMicrons * 1e-6;
    const drawDiffusivity = draw.diffusivity * (tAbs / 298.15) * (1.0 / (draw.viscosity / 1.2));
    const icpSoluteResistanceK = sValueM / drawDiffusivity; // s/m
    const kDrawLmh = (drawDiffusivity / sValueM) * 3600 * 1000; // LMH equivalent

    // 4. Initial Iterative Flux Calculation
    // Jw = A * [ (pi_draw * exp(-Jw/k_draw) - pi_feed * exp(Jw/k_feed)) / (1 + (B/Jw)*(exp(-Jw/k_draw) - exp(Jw/k_feed))) ]
    let jw = 12.0; // Initial guess LMH
    const aVal = sys.aValue * (1.0 + 0.02 * (tempC - 20.0));
    const bVal = sys.bValue * (1.0 + 0.03 * (tempC - 20.0));

    for (let iter = 0; iter < 10; iter++) {
      const expIcp = Math.exp(- (jw / kDrawLmh));
      const expEcp = Math.exp(jw / kFeedLmh);
      const piDrawMembrane = piDrawBulk * expIcp;
      const piFeedMembrane = piFeedBulk * expEcp;
      const deltaPiEff = Math.max(0, piDrawMembrane - piFeedMembrane);
      const denom = 1.0 + (bVal / Math.max(0.1, jw)) * (expIcp - expEcp);
      const jwNext = aVal * (deltaPiEff / Math.max(0.8, denom));
      jw = 0.5 * jw + 0.5 * jwNext;
    }

    jw = Math.max(0.2, jw);

    // Factors
    const expIcp = Math.exp(- (jw / kDrawLmh));
    const expEcp = Math.exp(jw / kFeedLmh);
    const piDrawMembrane = piDrawBulk * expIcp;
    const piFeedMembrane = piFeedBulk * expEcp;
    const deltaPiEff = Math.max(0, piDrawMembrane - piFeedMembrane);

    // 5. Reverse Solute Flux Js (g/L extracted)
    const jsSpecific = (bVal / (aVal * 0.08314 * tAbs)) * (drawKey === 'mgcl2_brine' ? 0.65 : 1.0);

    // 6. Volatile Aroma & Vitamin C Retention
    const aromaRetention = Math.max(88.0, mat.aromaTarget - (tempC > 25 ? (tempC - 25) * 0.45 : 0) - (targetBrix > 50 ? (targetBrix - 50) * 0.15 : 0));
    const vitCRetention = Math.max(85.0, mat.vitCTarget - (tempC > 25 ? (tempC - 25) * 0.35 : 0));

    // 7. Water Removal & Concentrated Yield
    const totalMembraneArea = sys.area;
    const hourlyPermeateLh = jw * totalMembraneArea;
    const feedCapacity = sys.capacity;
    const waterExtractionFraction = Math.max(0.1, Math.min(0.85, 1.0 - (mat.baselineBrix / targetBrix)));
    const actualFeedTreated = hourlyPermeateLh / waterExtractionFraction;
    const concentratedOutputLh = Math.max(10, actualFeedTreated - hourlyPermeateLh);

    // 8. Projected CIP Cleaning Interval
    const foulingRate = (targetBrix / 25.0) * (sValueMicrons / 300.0) * (1.2 / Math.max(0.3, vCross));
    const cipDays = Math.max(0.8, 14.0 / Math.max(0.5, foulingRate));

    // Update Metric Displays
    if (metricWaterFlux) metricWaterFlux.textContent = `${jw.toFixed(1)} LMH`;
    if (metricIcpFactor) metricIcpFactor.textContent = `${(expIcp * 100).toFixed(1)} %`;
    if (metricEcpFactor) metricEcpFactor.textContent = `${expEcp.toFixed(2)}x`;
    if (metricEffectiveDrive) metricEffectiveDrive.textContent = `${deltaPiEff.toFixed(1)} bar`;
    if (metricReverseSalt) metricReverseSalt.textContent = `${jsSpecific.toFixed(2)} g/L`;
    if (metricAromaRetention) metricAromaRetention.textContent = `${aromaRetention.toFixed(1)} % (Vit C: ${vitCRetention.toFixed(0)}%)`;
    if (metricWaterRemoval) metricWaterRemoval.textContent = `${hourlyPermeateLh.toFixed(0)} L/h`;
    if (metricCipInterval) metricCipInterval.textContent = `${cipDays.toFixed(1)} Days`;

    // Operational Status Evaluation
    let statusClass = "bg-teal-50 dark:bg-teal-950/40 border-teal-200 dark:border-teal-800 text-teal-900 dark:text-teal-100";
    let badgeClass = "bg-teal-100 dark:bg-teal-900/60 text-teal-800 dark:text-teal-200 border-teal-300";
    let statusIcon = "✅";
    let statusTitle = "Optimal Forward Osmosis Cold Concentration";
    let complianceText = "FDA 21 CFR § 177.2550 & 3-A 45-03 COMPLIANT";
    let primaryLim = "Low dilutive ICP; high effective osmotic driving gradient sustained.";
    let foulingMech = "Loose, hydraulically reversible pectin cake easily scoured by crossflow.";
    let mitAction = "Maintain crossflow velocity ≥ 1.0 m/s and scheduled osmotic backwash.";

    const isSevereIcp = expIcp < 0.35 || sValueMicrons > 900;
    const isHighSalt = jsSpecific > draw.safeLimitJsJw;
    const isFluxStarved = jw < 4.0;
    const isEcpStagnant = vCross < 0.5;

    if (isSevereIcp && isHighSalt) {
      statusClass = "bg-rose-50 dark:bg-rose-950/40 border-rose-300 dark:border-rose-800 text-rose-900 dark:text-rose-100";
      badgeClass = "bg-rose-100 dark:bg-rose-900/60 text-rose-800 dark:text-rose-200 border-rose-300";
      statusIcon = "🚨";
      statusTitle = "Severe Dilutive ICP Choke & Product Salt Contamination";
      complianceText = "NON-COMPLIANT (Codex STAN 247 Saline Adulteration & ICP Failure)";
      primaryLim = `Extreme dilutive ICP in thick support layer (S = ${sValueMicrons.toFixed(0)} µm) drops active driving force by ${((1 - expIcp)*100).toFixed(0)}%.`;
      foulingMech = "Severe irreversible salt crystallization within support layer and active layer delamination.";
      mitAction = "Replace compacted CTA membrane with sub-250 µm TFC polyamide hollow fibers immediately.";
    } else if (isHighSalt) {
      statusClass = "bg-amber-50 dark:bg-amber-950/40 border-amber-300 dark:border-amber-800 text-amber-900 dark:text-amber-100";
      badgeClass = "bg-amber-100 dark:bg-amber-900/60 text-amber-800 dark:text-amber-200 border-amber-300";
      statusIcon = "⚠️";
      statusTitle = "Elevated Reverse Draw Solute Permeation";
      complianceText = "BORDERLINE TASTE WARNING (Js/Jw Exceeds Sensory Threshold)";
      primaryLim = `Reverse solute flux (${jsSpecific.toFixed(2)} g/L) exceeds recommended taste threshold (${draw.safeLimitJsJw} g/L).`;
      foulingMech = "Active layer micro-pore widening allowing unhindered draw solute diffusion.";
      mitAction = "Switch to divalent MgCl2 or food-grade organic sucrose/citrate draw solution.";
    } else if (isEcpStagnant || isFluxStarved) {
      statusClass = "bg-amber-50 dark:bg-amber-950/40 border-amber-300 dark:border-amber-800 text-amber-900 dark:text-amber-100";
      badgeClass = "bg-amber-100 dark:bg-amber-900/60 text-amber-800 dark:text-amber-200 border-amber-300";
      statusIcon = "⚠️";
      statusTitle = "External Concentration Polarization Boundary Layer Stagnation";
      complianceText = "HYDRAULIC WARNING (Low Scouring Velocity)";
      primaryLim = `Crossflow velocity (${vCross.toFixed(2)} m/s) is insufficient to scour sugar/pectin boundary layer (cECP = ${expEcp.toFixed(2)}x).`;
      foulingMech = "Dense gel polarization layer adhering to feed active layer.";
      mitAction = "Increase feed recirculation pump speed to elevate crossflow velocity above 1.2 m/s.";
    }

    if (statusHeroCard) {
      statusHeroCard.className = `p-6 rounded-2xl border mb-6 transition-all ${statusClass}`;
    }
    if (complianceBadge) {
      complianceBadge.className = `px-4 py-2 rounded-xl text-xs font-bold tracking-wider uppercase border ${badgeClass}`;
      complianceBadge.textContent = complianceText;
    }
    if (safetyStatusIcon) safetyStatusIcon.textContent = statusIcon;
    if (safetyStatusTitle) safetyStatusTitle.textContent = statusTitle;
    if (primaryLimitationText) primaryLimitationText.textContent = primaryLim;
    if (foulingMechanismText) foulingMechanismText.textContent = foulingMech;
    if (mitigationActionText) mitigationActionText.textContent = mitAction;

    // Update SVG Diagram
    if (svgDiagramScale) {
      svgDiagramScale.textContent = `S = ${sValueMicrons.toFixed(0)} µm • v_cross = ${vCross.toFixed(2)} m/s • η_ICP = ${(expIcp * 100).toFixed(0)}%`;
    }
    if (svgFeedLabel) {
      svgFeedLabel.textContent = `${mat.name.split(' (')[0]} • ${targetBrix.toFixed(0)}° Brix (π = ${piFeedBulk.toFixed(0)} bar)`;
    }
    if (svgSupportLabel) {
      svgSupportLabel.textContent = `Dilutive ICP Zone • S = ${sValueMicrons.toFixed(0)} µm • η_ICP = ${(expIcp * 100).toFixed(0)}%`;
    }
    if (svgDrawLabel) {
      svgDrawLabel.textContent = `${draw.name.split(' (')[0]} • π_bulk = ${piDrawBulk.toFixed(0)} bar`;
    }
    if (svgJwVectorText) {
      svgJwVectorText.textContent = `Forward Water Flux Jw = ${jw.toFixed(1)} LMH →`;
    }
    if (svgJsVectorText) {
      svgJsVectorText.textContent = `← Reverse Solute Flux Js = ${jsSpecific.toFixed(2)} g/L (${jsSpecific <= draw.safeLimitJsJw ? 'Food-Safe' : 'Taste Penalty'})`;
    }
    if (svgDeltaPiEffText) {
      svgDeltaPiEffText.textContent = `Δπ_eff = ${deltaPiEff.toFixed(1)} bar`;
    }
  }

  // Preset Handlers
  if (presetCitrusBtn) {
    presetCitrusBtn.addEventListener('click', () => {
      if (systemSelect) systemSelect.value = 'commercial_multi_stage_fo_1200l';
      if (matrixSelect) matrixSelect.value = 'cold_pressed_orange_juice';
      if (drawSoluteSelect) drawSoluteSelect.value = 'nacl_brine';
      if (drawOsmoticSlider) drawOsmoticSlider.value = '195';
      if (targetBrixSlider) targetBrixSlider.value = '42';
      if (crossflowVelocitySlider) crossflowVelocitySlider.value = '1.2';
      if (membraneSSlider) membraneSSlider.value = '280';
      if (tempSlider) tempSlider.value = '18';
      calculateModel();
    });
  }

  if (presetGrapeBtn) {
    presetGrapeBtn.addEventListener('click', () => {
      if (systemSelect) systemSelect.value = 'industrial_high_tonnage_fo_4500l';
      if (matrixSelect) matrixSelect.value = 'raw_concord_grape_juice';
      if (drawSoluteSelect) drawSoluteSelect.value = 'mgcl2_brine';
      if (drawOsmoticSlider) drawOsmoticSlider.value = '240';
      if (targetBrixSlider) targetBrixSlider.value = '58';
      if (crossflowVelocitySlider) crossflowVelocitySlider.value = '1.4';
      if (membraneSSlider) membraneSSlider.value = '185';
      if (tempSlider) tempSlider.value = '20';
      calculateModel();
    });
  }

  if (presetOrganicBtn) {
    presetOrganicBtn.addEventListener('click', () => {
      if (systemSelect) systemSelect.value = 'pilot_hollow_fiber_fo_150l';
      if (matrixSelect) matrixSelect.value = 'cold_brew_coffee_extract';
      if (drawSoluteSelect) drawSoluteSelect.value = 'sucrose_hfcs_syrup';
      if (drawOsmoticSlider) drawOsmoticSlider.value = '110';
      if (targetBrixSlider) targetBrixSlider.value = '35';
      if (crossflowVelocitySlider) crossflowVelocitySlider.value = '1.0';
      if (membraneSSlider) membraneSSlider.value = '210';
      if (tempSlider) tempSlider.value = '15';
      calculateModel();
    });
  }

  if (presetIcpHazardBtn) {
    presetIcpHazardBtn.addEventListener('click', () => {
      if (systemSelect) systemSelect.value = 'compromised_legacy_fo_unit';
      if (matrixSelect) matrixSelect.value = 'cold_pressed_orange_juice';
      if (drawSoluteSelect) drawSoluteSelect.value = 'nacl_brine';
      if (drawOsmoticSlider) drawOsmoticSlider.value = '160';
      if (targetBrixSlider) targetBrixSlider.value = '45';
      if (crossflowVelocitySlider) crossflowVelocitySlider.value = '0.35';
      if (membraneSSlider) membraneSSlider.value = '1450';
      if (tempSlider) tempSlider.value = '28';
      calculateModel();
    });
  }

  // Event Listeners for Live Calculation
  const inputs = [
    systemSelect, matrixSelect, drawSoluteSelect, drawOsmoticSlider,
    targetBrixSlider, crossflowVelocitySlider, membraneSSlider, tempSlider
  ];

  inputs.forEach(input => {
    if (input) {
      input.addEventListener('input', calculateModel);
      input.addEventListener('change', calculateModel);
    }
  });

  // Initial Calculation on Load
  calculateModel();
</script>
