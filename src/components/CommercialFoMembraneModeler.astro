    drawSoluteHelp: "浸透圧駆動溶質（食品グレードNaCl、MgCl2高濃度塩水、ショ糖・異性化糖シロップ、またはクエン酸カリウム緩衝液）を選択します。",
    drawOsmoticLabel: "バルクドロー溶液熱力学的浸透圧 (bar):",
    drawOsmoticHelp: "ドロー流体の熱力学的浸透圧（モル濃度、ファントホッフ係数、浸透圧係数により決定）。",
    targetBrixLabel: "目標製品濃縮糖度 (°Brix):",
    targetBrixHelp: "最終可溶性固形分濃度。Brixが上昇すると、原料側の逆浸透圧および見掛け粘度が著しく増大します。",
    crossflowVelocityLabel: "原料側膜面クロスフロー洗浄流速 (m/s):",
    crossflowVelocityHelp: "活性分離層表面のクロスフロー剪断流速。高速クロスフローは濃縮性外部濃度分極（cECP）の形成を抑制します。",
    membraneSValueLabel: "膜支持層構造パラメータ S値 (µm):",
    membraneSValueHelp: "支持層の物理的厚み × 屈曲度 / 空隙率（S = t·τ/ε）。S値が小さいほど、多孔質層内での希釈性ICPを排除できます。",
    feedTempLabel: "プロセス運転流体温度 (°C):",
    feedTempHelp: "冷時濃縮温度（10〜30°C）。熱に弱い芳香成分やビタミンを完全保護しながら拡散係数と粘度を最適化します。",
    presetsTitle: "標準産業用運転プリセット",
    presetCitrusAroma: "高級コールドプレス柑橘アロマ保持濃縮 (TFC中空糸, NaCl 4M, Δπ = 195 bar, 18°C, v = 1.2 m/s, 目標 42° Brix)",
    presetGrapeBrix: "高糖度コンコード葡萄ポリフェノール超濃縮 (アクアポリンスキッド, MgCl2 2.8M, Δπ = 240 bar, 20°C, 目標 58° Brix)",
    presetSafeOrganic: "有機ジュース完全無塩・安全濃縮 (ショ糖/クエン酸塩ドロー, Δπ = 110 bar, 15°C, 塩分混入リスクゼロ, 目標 35° Brix)",
    presetIcpHazard: "重度内部濃度分極（ICP）閉塞・塩分逆拡散重大リスク (従来型CTA板枠式, S = 1,450 µm, 低流速 0.35 m/s, Js > 0.45 g/L)",
    diagnosticTitle: "リアルタイム膜熱力学・物質移動工学診断",
    diagnosticSub: "正浸透水透過流束 (Jw)、希釈性ICP保持率、有効浸透圧駆動力、ドロー溶質比逆拡散流束 (Js/Jw)、アロマ保持率の計算結果。",
    waterFluxLabel: "正浸透純水透過流束 (Jw):",
    icpAttenuationLabel: "希釈性 ICP 流束減衰保持率 (η_ICP):",
    ecpFactorLabel: "濃縮性外部濃度分極係数 (cECP):",
    effectiveDriveLabel: "有効膜間浸透圧駆動力 (Δπ_eff):",
    reverseSaltFluxLabel: "ドロー溶質比逆拡散透過流束 (Js/Jw):",
    aromaRetentionLabel: "揮発性香気成分・ビタミンC保持率:",
    waterRemovalLabel: "時間当たり純水脱水抽出量:",
    cipIntervalLabel: "CIP定置洗浄予測推奨サイクル:",
    safetyStatusLabel: "プロセス総合運転健全性:",
    primaryLimitationLabel: "主要物質移動ボトルネック要因:",
    foulingMechanismLabel: "活性分離層表面の主導的膜ファウリング機構:",
    mitigationActionLabel: "推奨エンジニアリング対策:",
    scienceTitle: "正浸透膜物質移動・境膜熱力学理論",
    scienceSub: "非対称膜における水・溶質輸送方程式、内外濃度分極ダイナミクス、および逆溶質拡散挙動の物理化学的根拠。",
    tableTitle: "正浸透冷時濃縮 vs 減圧加熱蒸発濃縮 性能比較マトリクス"
  }
};

const d = DICT[lang] || DICT.en;
---

<div class="bg-surface rounded-3xl border border-hairline p-6 md:p-10 shadow-sm max-w-5xl mx-auto my-8 font-sans text-ink">
  <!-- Header Badge & Title -->
  <div class="mb-8">
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-teal-600 text-white mb-3">
      <span>💧</span>
      <span>{d.badge}</span>
    </div>
    <h1 class="text-2xl md:text-4xl font-extrabold tracking-tight mb-4 text-ink">
      {d.title}
    </h1>
    <p class="text-body text-sm md:text-base leading-relaxed text-muted">
      {d.subtitle}
    </p>
  </div>

  <!-- Operational Presets -->
  <div class="mb-10 p-5 bg-surface-soft border border-hairline/80 rounded-2xl">
    <div class="flex items-center gap-2 mb-3">
      <span class="text-sm font-bold text-ink uppercase tracking-wide">⚡ {d.presetsTitle}</span>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
      <button 
        type="button" 
        id="presetCitrusBtn"
        class="text-left px-3.5 py-2.5 text-xs font-medium rounded-xl border border-hairline bg-surface hover:bg-teal-50 dark:hover:bg-teal-950/40 hover:border-teal-400 text-ink transition-colors flex items-center justify-between"
      >
        <span>🍊 {d.presetCitrusAroma}</span>
        <span class="text-teal-600 font-bold ml-2">Load &rarr;</span>
      </button>
      <button 
        type="button" 
        id="presetGrapeBtn"
        class="text-left px-3.5 py-2.5 text-xs font-medium rounded-xl border border-hairline bg-surface hover:bg-indigo-50 dark:hover:bg-indigo-950/40 hover:border-indigo-400 text-ink transition-colors flex items-center justify-between"
      >
        <span>🍇 {d.presetGrapeBrix}</span>
        <span class="text-indigo-600 font-bold ml-2">Load &rarr;</span>
      </button>
      <button 
        type="button" 
        id="presetOrganicBtn"
        class="text-left px-3.5 py-2.5 text-xs font-medium rounded-xl border border-hairline bg-surface hover:bg-emerald-50 dark:hover:bg-emerald-950/40 hover:border-emerald-400 text-ink transition-colors flex items-center justify-between"
      >
        <span>🌿 {d.presetSafeOrganic}</span>
        <span class="text-emerald-600 font-bold ml-2">Load &rarr;</span>
      </button>
      <button 
        type="button" 
        id="presetIcpHazardBtn"
        class="text-left px-3.5 py-2.5 text-xs font-medium rounded-xl border border-hairline bg-surface hover:bg-rose-50 dark:hover:bg-rose-950/40 hover:border-rose-400 text-ink transition-colors flex items-center justify-between"
      >
        <span>⚠️ {d.presetIcpHazard}</span>
        <span class="text-rose-600 font-bold ml-2">Load &rarr;</span>
      </button>
    </div>
  </div>

  <!-- Interactive Controls Section -->
  <div class="mb-10">
    <div class="mb-6">
      <h2 class="text-lg md:text-xl font-bold tracking-tight text-ink flex items-center gap-2">
        <span>🎛️</span>
        <span>{d.controlsTitle}</span>
      </h2>
      <p class="text-xs md:text-sm text-muted mt-1">
        {d.controlsSub}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 bg-surface-soft p-6 rounded-2xl border border-hairline">
      <!-- 1. System Selection -->
      <div>
        <label for="systemSelect" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1">
          {d.systemLabel}
        </label>
        <select 
          id="systemSelect" 
          class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-xs md:text-sm text-ink focus:ring-2 focus:ring-teal-500 font-medium"
        >
          {foData.foSystems.map((sys) => (
            <option value={sys.id} selected={sys.id === 'commercial_multi_stage_fo_1200l'}>
              {sys.name}
            </option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1 leading-normal" id="systemDescriptionText">
          {d.systemHelp}
        </p>
      </div>

      <!-- 2. Matrix Selection -->
      <div>
        <label for="matrixSelect" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1">
          {d.matrixLabel}
        </label>
        <select 
          id="matrixSelect" 
          class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-xs md:text-sm text-ink focus:ring-2 focus:ring-teal-500 font-medium"
        >
          {foData.foodMatrices.map((mat) => (
            <option value={mat.id} selected={mat.id === 'cold_pressed_orange_juice'}>
              {mat.name}
            </option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1 leading-normal" id="matrixDescriptionText">
          {d.matrixHelp}
        </p>
      </div>

      <!-- 3. Draw Solute Selection -->
      <div>
        <label for="drawSoluteSelect" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1">
          {d.drawSoluteLabel}
        </label>
        <select 
          id="drawSoluteSelect" 
          class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-xs md:text-sm text-ink focus:ring-2 focus:ring-teal-500 font-medium"
        >
          {foData.drawSolutions.map((sol) => (
            <option value={sol.id} selected={sol.id === 'nacl_brine'}>
              {sol.name}
            </option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1 leading-normal" id="drawSoluteDescriptionText">
          {d.drawSoluteHelp}
        </p>
      </div>

      <!-- 4. Bulk Draw Osmotic Pressure Slider -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <label for="drawOsmoticSlider" class="text-xs font-bold uppercase tracking-wider text-ink">
            {d.drawOsmoticLabel}
          </label>
          <span class="text-xs font-mono font-bold px-2 py-0.5 rounded bg-teal-100 dark:bg-teal-900/60 text-teal-800 dark:text-teal-200" id="drawOsmoticValue">
            195 bar
          </span>
        </div>
        <input 
          type="range" 
          id="drawOsmoticSlider" 
          min="50" 
          max="350" 
          step="5" 
          value="195"
          class="w-full h-2 bg-hairline rounded-lg appearance-none cursor-pointer accent-teal-600"
        />
        <div class="flex justify-between text-[10px] text-muted font-mono mt-0.5">
          <span>50 bar (Dilute)</span>
          <span class="text-teal-600 font-bold">Optimal Δπ: 150-250 bar</span>
          <span>350 bar (Extreme)</span>
        </div>
        <p class="text-[11px] text-muted mt-1 leading-normal">
          {d.drawOsmoticHelp}
        </p>
      </div>

      <!-- 5. Target Product Brix Slider -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <label for="targetBrixSlider" class="text-xs font-bold uppercase tracking-wider text-ink">
            {d.targetBrixLabel}
          </label>
          <span class="text-xs font-mono font-bold px-2 py-0.5 rounded bg-amber-100 dark:bg-amber-900/60 text-amber-800 dark:text-amber-200" id="targetBrixValue">
            42.0 °Brix
          </span>
        </div>
        <input 
          type="range" 
          id="targetBrixSlider" 
          min="15" 
          max="65" 
          step="1" 
          value="42"
          class="w-full h-2 bg-hairline rounded-lg appearance-none cursor-pointer accent-amber-600"
        />
        <div class="flex justify-between text-[10px] text-muted font-mono mt-0.5">
          <span>15 °Brix (Single Strength)</span>
          <span>42 °Brix (Standard)</span>
          <span>65 °Brix (Heavy Concentrate)</span>
        </div>
        <p class="text-[11px] text-muted mt-1 leading-normal">
          {d.targetBrixHelp}
        </p>
      </div>

      <!-- 6. Crossflow Velocity Slider -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <label for="crossflowVelocitySlider" class="text-xs font-bold uppercase tracking-wider text-ink">
            {d.crossflowVelocityLabel}
          </label>
          <span class="text-xs font-mono font-bold px-2 py-0.5 rounded bg-indigo-100 dark:bg-indigo-900/60 text-indigo-800 dark:text-indigo-200" id="crossflowVelocityValue">
            1.20 m/s
          </span>
        </div>
        <input 
          type="range" 
          id="crossflowVelocitySlider" 
          min="0.2" 
          max="2.5" 
          step="0.05" 
          value="1.2"
          class="w-full h-2 bg-hairline rounded-lg appearance-none cursor-pointer accent-indigo-600"
        />
        <div class="flex justify-between text-[10px] text-muted font-mono mt-0.5">
          <span>0.2 m/s (Laminar Stagnation)</span>
          <span class="text-indigo-600 font-bold">1.2 m/s (Turbulent Shear)</span>
          <span>2.5 m/s (High Shear)</span>
        </div>
        <p class="text-[11px] text-muted mt-1 leading-normal">
          {d.crossflowVelocityHelp}
        </p>
      </div>

      <!-- 7. Membrane Structural Parameter S-Value Slider -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <label for="membraneSSlider" class="text-xs font-bold uppercase tracking-wider text-ink">
            {d.membraneSValueLabel}
          </label>
          <span class="text-xs font-mono font-bold px-2 py-0.5 rounded bg-purple-100 dark:bg-purple-900/60 text-purple-800 dark:text-purple-200" id="membraneSValue">
            280 µm
          </span>
        </div>
        <input 
          type="range" 
          id="membraneSSlider" 
          min="120" 
          max="1500" 
          step="20" 
          value="280"
          class="w-full h-2 bg-hairline rounded-lg appearance-none cursor-pointer accent-purple-600"
        />
        <div class="flex justify-between text-[10px] text-muted font-mono mt-0.5">
          <span>120 µm (Ultra-Thin TFC)</span>
          <span>350 µm (Standard TFC)</span>
          <span>1,500 µm (Compacted CTA)</span>
        </div>
        <p class="text-[11px] text-muted mt-1 leading-normal">
          {d.membraneSValueHelp}
        </p>
      </div>

      <!-- 8. Operating Temperature Slider -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <label for="tempSlider" class="text-xs font-bold uppercase tracking-wider text-ink">
            {d.feedTempLabel}
          </label>
          <span class="text-xs font-mono font-bold px-2 py-0.5 rounded bg-sky-100 dark:bg-sky-900/60 text-sky-800 dark:text-sky-200" id="tempValue">
            18 °C
          </span>
        </div>
        <input 
          type="range" 
          id="tempSlider" 
          min="8" 
          max="40" 
          step="1" 
          value="18"
          class="w-full h-2 bg-hairline rounded-lg appearance-none cursor-pointer accent-sky-600"
        />
        <div class="flex justify-between text-[10px] text-muted font-mono mt-0.5">
          <span>8 °C (Chilled)</span>
          <span class="text-sky-600 font-bold">15-20 °C (Optimal Aroma)</span>
          <span>40 °C (Max Sanitary)</span>
        </div>
        <p class="text-[11px] text-muted mt-1 leading-normal">
          {d.feedTempHelp}
        </p>
      </div>
    </div>
  </div>

  <!-- Real-Time Diagnostic Dashboard -->
  <div class="mb-10">
    <div class="mb-6">
      <h2 class="text-lg md:text-xl font-bold tracking-tight text-ink flex items-center gap-2">
        <span>🔬</span>
        <span>{d.diagnosticTitle}</span>
      </h2>
      <p class="text-xs md:text-sm text-muted mt-1">
        {d.diagnosticSub}
      </p>
    </div>

    <!-- Status Hero Card -->
    <div class="p-6 rounded-2xl border mb-6 transition-all" id="statusHeroCard">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-4">
        <div>
          <div class="text-xs font-bold uppercase tracking-wider text-muted mb-1">
            {d.safetyStatusLabel}
          </div>
          <div class="text-2xl md:text-3xl font-extrabold flex items-center gap-2" id="safetyStatusText">
            <span id="safetyStatusIcon">✅</span>
            <span id="safetyStatusTitle">Optimal Forward Osmosis Cold Concentration</span>
          </div>
        </div>
        <div class="px-4 py-2 rounded-xl text-xs font-bold tracking-wider uppercase border" id="complianceBadge">
          FDA 21 CFR § 177.2550 &amp; 3-A 45-03 COMPLIANT
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 border-t border-hairline/60 pt-4 text-xs">
        <div>
          <span class="font-bold text-muted block mb-0.5">{d.primaryLimitationLabel}</span>
          <span class="font-medium text-ink" id="primaryLimitationText">Low dilutive ICP; high effective osmotic driving gradient sustained.</span>
        </div>
        <div>
          <span class="font-bold text-muted block mb-0.5">{d.foulingMechanismLabel}</span>
          <span class="font-medium text-ink" id="foulingMechanismText">Loose, hydraulically reversible pectin cake easily scoured by crossflow.</span>
        </div>
        <div>
          <span class="font-bold text-muted block mb-0.5">{d.mitigationActionLabel}</span>
          <span class="font-medium text-ink" id="mitigationActionText">Maintain crossflow velocity ≥ 1.0 m/s and scheduled osmotic backwash.</span>
        </div>
      </div>
    </div>

    <!-- Visual Interactive Membrane Mass Transfer SVG Diagram -->
    <div class="p-5 bg-surface-soft border border-hairline rounded-2xl mb-6">
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-bold uppercase tracking-wider text-ink flex items-center gap-2">
          <span>🔬</span>
          <span>Dynamic Asymmetric Membrane Transport Profile (AL-FS Mode)</span>
        </span>
        <span class="text-[11px] font-mono text-muted" id="svgDiagramScale">
          S = 280 µm • v_cross = 1.2 m/s
        </span>
      </div>

      <div class="w-full overflow-hidden rounded-xl border border-hairline bg-surface p-2">
        <svg viewBox="0 0 800 240" class="w-full h-auto text-ink font-sans select-none" id="membraneTransportSvg">
          <!-- Background Zones -->
          <!-- Zone 1: Feed Channel (AL-FS) -->
          <rect x="20" y="20" width="240" height="200" rx="8" fill="rgba(245, 158, 11, 0.08)" stroke="rgba(245, 158, 11, 0.3)" stroke-width="1.5" />
          <text x="140" y="45" text-anchor="middle" font-size="12" font-weight="bold" fill="#d97706">FEED CHANNEL (AL-FS)</text>
          <text x="140" y="65" text-anchor="middle" font-size="10" fill="#92400e" id="svgFeedLabel">Valencia Orange Juice • 42° Brix</text>

          <!-- Zone 2: Thin Dense Active Layer (AL) -->
          <rect x="260" y="20" width="40" height="200" rx="2" fill="rgba(14, 165, 233, 0.25)" stroke="#0284c7" stroke-width="2" />
          <text x="280" y="115" text-anchor="middle" font-size="10" font-weight="bold" fill="#0369a1" transform="rotate(-90 280 115)">ACTIVE LAYER (Polyamide, ~0.2 µm)</text>

          <!-- Zone 3: Porous Support Layer (SL - Dilutive ICP Zone) -->
          <rect x="300" y="20" width="220" height="200" rx="4" fill="rgba(139, 92, 246, 0.10)" stroke="#8b5cf6" stroke-dasharray="4,4" stroke-width="1.5" />
          <text x="410" y="45" text-anchor="middle" font-size="12" font-weight="bold" fill="#7c3aed">POROUS SUPPORT LAYER</text>
          <text x="410" y="65" text-anchor="middle" font-size="10" fill="#6d28d9" id="svgSupportLabel">Dilutive ICP Zone • S = 280 µm</text>

          <!-- Zone 4: Draw Solution Channel -->
          <rect x="520" y="20" width="260" height="200" rx="8" fill="rgba(20, 184, 166, 0.08)" stroke="rgba(20, 184, 166, 0.3)" stroke-width="1.5" />
          <text x="650" y="45" text-anchor="middle" font-size="12" font-weight="bold" fill="#0d9488">DRAW SOLUTION CHANNEL</text>
          <text x="650" y="65" text-anchor="middle" font-size="10" fill="#0f766e" id="svgDrawLabel">NaCl Brine • π_bulk = 195 bar</text>

          <!-- Flux Vectors -->
          <!-- Forward Water Flux Jw Arrow -->
          <g id="svgWaterFluxGroup">
            <line x1="180" y1="120" x2="620" y2="120" stroke="#0284c7" stroke-width="4" stroke-linecap="round" />
            <polygon points="620,113 635,120 620,127" fill="#0284c7" />
            <text x="410" y="108" text-anchor="middle" font-size="11" font-weight="bold" fill="#0369a1" id="svgJwVectorText">
              Forward Water Flux Jw = 18.4 LMH &rarr;
            </text>
          </g>

          <!-- Reverse Solute Flux Js Arrow -->
          <g id="svgSoluteFluxGroup">
            <line x1="600" y1="165" x2="220" y2="165" stroke="#ef4444" stroke-width="2.5" stroke-dasharray="4,3" stroke-linecap="round" />
            <polygon points="220,160 205,165 220,170" fill="#ef4444" />
            <text x="410" y="185" text-anchor="middle" font-size="10" font-weight="bold" fill="#dc2626" id="svgJsVectorText">
              &larr; Reverse Solute Flux Js = 0.18 g/L (Food-Safe)
            </text>
          </g>

          <!-- Dynamic Profile Line inside Support Layer -->
          <!-- Osmotic Pressure Drop Profile Curve -->
          <path d="M 260,140 Q 350,148 520,132" fill="none" stroke="#7c3aed" stroke-width="2.5" id="svgOsmoticCurve" />
          <circle cx="300" cy="144" r="4" fill="#7c3aed" />
          <text x="310" y="156" font-size="9" font-family="monospace" fill="#6d28d9" id="svgDeltaPiEffText">π_m,i = 98.4 bar</text>
        </svg>
      </div>
    </div>

    <!-- Metrics Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <!-- 1. Forward Water Permeate Flux -->
      <div class="p-4 bg-surface-soft border border-hairline rounded-xl">
        <div class="text-[11px] font-bold text-muted uppercase tracking-wider mb-1">
          {d.waterFluxLabel}
        </div>
        <div class="text-lg md:text-xl font-extrabold text-teal-700 dark:text-teal-300 font-mono" id="metricWaterFlux">
          18.4 LMH
        </div>
        <div class="text-[10px] text-muted mt-1 font-mono" id="metricWaterFluxSub">
          Jw = A • Δπ_eff (L/m²·h)
        </div>
      </div>

