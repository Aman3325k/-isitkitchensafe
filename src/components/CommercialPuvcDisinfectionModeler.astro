    flashHelp: "キセノン放電パルス発振レート。周波数を高めることで液流内の照射死角を完全に排除し、高密度な重畳照射を実現。",
    foulingLabel: "石英スリーブ表面ファウリング率 (% 透過光損耗):",
    foulingHelp: "連続運転に伴うミルクスケール、リン酸カルシウム、熱変性タンパク質の外壁付着による 254 nm 紫外線透過遮断率。",
    presetsTitle: "標準的商業運転プリセット",
    presetCider: "混濁リンゴ果汁 5-Log 大腸菌 HACCP 目標 (アニュラー 0.8 mm, 3.0 L/min)",
    presetMust: "清澄ブドウ果汁 非加熱品質安定化 (Dean 渦流螺旋管, 42 L/min)",
    presetDairy: "乳清パーミエイト リステリア制御 (高出力アマルガムアレイ, 180 L/min)",
    presetKombucha: "クラフトコンブチャ 野生酵母増殖抑制 (螺旋スキッド, 25 L/min)",
    presetFouled: "重度石英スケーリングによる病原体すり抜け危険状態 (> 65% 遮断)",
    diagnosticTitle: "連続光分解殺菌ダイナミクス＆食品安全診断",
    diagnosticSub: "実効紫外線フルエンス量 (H)、ピリミジン二量体形成率、流体力学的混合状態、および FDA 法規制適合性メトリクス。",
    deliveredFluenceLabel: "実効 UV-C 殺菌照射フルエンス線量 (H)",
    meanIrradianceLabel: "チャンバー平均体積紫外線照度",
    residenceTimeLabel: "平均水力滞留時間 (Residence Time)",
    pathogenLogLabel: "対象病原菌対数減少値 (Log10)",
    dimerPhotolysisLabel: "シクロブタンピリミジン二量体 (CPD) 光分解率",
    photoreactivationLabel: "光回復酵素 (Photolyase) 暗修復リスク",
    hydrodynamicRegimeLabel: "水力流動形態＆ Dean 渦流強度",
    tempRiseLabel: "処理液温度上昇値 (ΔT)",
    sensorTransmissionLabel: "実効紫外線透過率",
    safetyStatusLabel: "FDA 21 CFR § 179.39 適合ステータス",
    primaryLimitationLabel: "主要エンジニアリング制約要因",
    mitigationActionLabel: "推奨緩和対策＆アクションプロトコル",
    scienceTitle: "短波紫外線光生物学原理＆ 3-A サニタリー設計基準",
    scienceSub: "殺菌光子吸収ダイナミクス、核酸二量体致死架橋、二次 Dean 渦流混合、および 3-A サニタリー規格の技術詳説。",
    tableTitle: "商業用連続 UV-C リアクター技術仕様比較"
  }
};

const d = DICT[lang] || DICT.en;
---

<div class="space-y-10" id="puvc-modeler-container">
  <!-- Header Title Banner -->
  <div class="border-b border-hairline pb-6">
    <div class="flex items-center gap-2 mb-3">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-sky-600/10 text-sky-700 dark:text-sky-300 border border-sky-600/20">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        {d.badge}
      </span>
      <span class="text-xs text-muted font-mono">FDA 21 CFR § 179.39 • 3-A Standard 54-02 • NSF/ANSI 55</span>
    </div>
    <h1 class="text-2xl sm:text-3xl font-bold text-ink tracking-tight">
      {d.title}
    </h1>
    <p class="mt-2 text-body-base text-muted max-w-4xl leading-relaxed">
      {d.subtitle}
    </p>
  </div>

  <!-- Operational Presets -->
  <div class="bg-surface-soft border border-hairline rounded-2xl p-5">
    <h2 class="text-xs font-bold uppercase tracking-wider text-muted mb-3 flex items-center gap-2">
      <svg class="w-4 h-4 text-sky-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
      </svg>
      {d.presetsTitle}
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-2.5">
      <button type="button" id="btn-preset-cider" class="preset-btn text-left p-3 rounded-xl border border-hairline bg-surface hover:border-sky-500 hover:shadow-xs transition-all text-xs">
        <div class="font-semibold text-ink mb-1 text-sky-700 dark:text-sky-300">🍎 Cloudy Cider</div>
        <div class="text-muted text-[11px] leading-snug">{d.presetCider}</div>
      </button>
      <button type="button" id="btn-preset-must" class="preset-btn text-left p-3 rounded-xl border border-hairline bg-surface hover:border-sky-500 hover:shadow-xs transition-all text-xs">
        <div class="font-semibold text-ink mb-1 text-sky-700 dark:text-sky-300">🍇 Grape Must</div>
        <div class="text-muted text-[11px] leading-snug">{d.presetMust}</div>
      </button>
      <button type="button" id="btn-preset-dairy" class="preset-btn text-left p-3 rounded-xl border border-hairline bg-surface hover:border-sky-500 hover:shadow-xs transition-all text-xs">
        <div class="font-semibold text-ink mb-1 text-sky-700 dark:text-sky-300">🥛 Dairy Permeate</div>
        <div class="text-muted text-[11px] leading-snug">{d.presetDairy}</div>
      </button>
      <button type="button" id="btn-preset-kombucha" class="preset-btn text-left p-3 rounded-xl border border-hairline bg-surface hover:border-sky-500 hover:shadow-xs transition-all text-xs">
        <div class="font-semibold text-ink mb-1 text-sky-700 dark:text-sky-300">🍵 Raw Kombucha</div>
        <div class="text-muted text-[11px] leading-snug">{d.presetKombucha}</div>
      </button>
      <button type="button" id="btn-preset-fouled" class="preset-btn text-left p-3 rounded-xl border border-red-300 dark:border-red-900/50 bg-red-500/5 hover:border-red-500 hover:shadow-xs transition-all text-xs">
        <div class="font-semibold text-red-600 dark:text-red-400 mb-1">⚠️ Severely Fouled</div>
        <div class="text-muted text-[11px] leading-snug">{d.presetFouled}</div>
      </button>
    </div>
  </div>

  <!-- Interactive Controls & Diagnostics Dual Panel Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    
    <!-- Controls Panel (Left, 5 cols) -->
    <div class="lg:col-span-5 bg-surface-soft border border-hairline rounded-2xl p-6 space-y-6">
      <div>
        <h2 class="text-title-base font-semibold text-ink">
          {d.controlsTitle}
        </h2>
        <p class="text-xs text-muted mt-1">
          {d.controlsSub}
        </p>
      </div>

      <!-- Selector: Reactor Architecture -->
      <div class="space-y-1.5">
        <label for="puvc-system-select" class="block text-xs font-semibold text-ink">
          {d.systemLabel}
        </label>
        <select id="puvc-system-select" class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-xs text-ink focus:outline-none focus:ring-2 focus:ring-sky-500">
          {puvcData.puvcSystems.map(sys => (
            <option value={sys.id}>{sys.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted leading-tight">{d.systemHelp}</p>
      </div>

      <!-- Selector: Food Substrate -->
      <div class="space-y-1.5">
        <label for="puvc-fluid-select" class="block text-xs font-semibold text-ink">
          {d.fluidLabel}
        </label>
        <select id="puvc-fluid-select" class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-xs text-ink focus:outline-none focus:ring-2 focus:ring-sky-500">
          {puvcData.fluidSubstrates.map(fl => (
            <option value={fl.id}>{fl.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted leading-tight">{d.fluidHelp}</p>
      </div>

      <!-- Selector: Sleeve Material -->
      <div class="space-y-1.5">
        <label for="puvc-sleeve-select" class="block text-xs font-semibold text-ink">
          {d.sleeveLabel}
        </label>
        <select id="puvc-sleeve-select" class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-xs text-ink focus:outline-none focus:ring-2 focus:ring-sky-500">
          {puvcData.quartzSleeveMaterials.map(mat => (
            <option value={mat.id}>{mat.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted leading-tight">{d.sleeveHelp}</p>
      </div>

      <!-- Slider 1: Electrical Power -->
      <div class="space-y-1.5">
        <div class="flex items-center justify-between text-xs">
          <label for="puvc-power-slider" class="font-semibold text-ink">{d.powerLabel}</label>
          <span id="puvc-power-val" class="font-mono font-bold text-sky-700 dark:text-sky-300">1200 W</span>
        </div>
        <input 
          type="range" 
          id="puvc-power-slider" 
          min="200" 
          max="12000" 
          step="100" 
          value="1200" 
          class="w-full accent-sky-600 cursor-pointer"
        />
        <p class="text-[11px] text-muted">{d.powerHelp}</p>
      </div>

      <!-- Slider 2: Fluid Flow Rate -->
      <div class="space-y-1.5">
        <div class="flex items-center justify-between text-xs">
          <label for="puvc-flow-slider" class="font-semibold text-ink">{d.flowLabel}</label>
          <span id="puvc-flow-val" class="font-mono font-bold text-sky-700 dark:text-sky-300">3.0 L/min</span>
        </div>
        <input 
          type="range" 
          id="puvc-flow-slider" 
          min="0.5" 
          max="250.0" 
          step="0.5" 
          value="3.0" 
          class="w-full accent-sky-600 cursor-pointer"
        />
        <p class="text-[11px] text-muted">{d.flowHelp}</p>
      </div>

      <!-- Slider 3: Pulse Repetition Rate -->
      <div class="space-y-1.5">
        <div class="flex items-center justify-between text-xs">
          <label for="puvc-flash-slider" class="font-semibold text-ink">{d.flashLabel}</label>
          <span id="puvc-flash-val" class="font-mono font-bold text-sky-700 dark:text-sky-300">30 Hz</span>
        </div>
        <input 
          type="range" 
          id="puvc-flash-slider" 
          min="5" 
          max="100" 
          step="5" 
          value="30" 
          class="w-full accent-sky-600 cursor-pointer"
        />
        <p class="text-[11px] text-muted">{d.flashHelp}</p>
      </div>

      <!-- Slider 4: Sleeve Fouling Accumulation -->
      <div class="space-y-1.5">
        <div class="flex items-center justify-between text-xs">
          <label for="puvc-fouling-slider" class="font-semibold text-ink">{d.foulingLabel}</label>
          <span id="puvc-fouling-val" class="font-mono font-bold text-sky-700 dark:text-sky-300">0% (Pristine Clean)</span>
        </div>
        <input 
          type="range" 
          id="puvc-fouling-slider" 
          min="0" 
          max="80" 
          step="5" 
          value="0" 
          class="w-full accent-sky-600 cursor-pointer"
        />
        <p class="text-[11px] text-muted">{d.foulingHelp}</p>
      </div>
    </div>

    <!-- Diagnostics Panel (Right, 7 cols) -->
    <div class="lg:col-span-7 space-y-6">
      
      <!-- Primary Compliance Status Banner -->
      <div id="puvc-status-banner" class="border rounded-2xl p-5 transition-colors bg-emerald-500/10 border-emerald-500/30 text-emerald-950 dark:text-emerald-200">
        <div class="flex items-start gap-3">
          <div id="puvc-status-icon" class="p-2 rounded-xl bg-emerald-500/20 text-emerald-600 dark:text-emerald-300 mt-0.5">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div class="flex-1">
            <div class="flex items-center justify-between flex-wrap gap-2">
              <span class="text-xs font-bold uppercase tracking-wider text-muted">{d.safetyStatusLabel}</span>
              <span id="puvc-badge-pill" class="px-2.5 py-0.5 rounded-full text-xs font-bold uppercase bg-emerald-600 text-white">
                FDA 5-LOG VALIDATED
              </span>
            </div>
            <h3 id="puvc-status-heading" class="text-base font-bold text-ink mt-1">
              Fully Compliant FDA 21 CFR § 179.39 Disinfection & Lethality
            </h3>
            <p id="puvc-status-desc" class="text-xs text-muted mt-1 leading-relaxed">
              Delivered UV-C germicidal fluence exceeds the 5.0 log10 reduction threshold for target foodborne pathogens with zero heat denaturation.
            </p>
          </div>
        </div>
      </div>

      <!-- Metrics 4-Card Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        
        <!-- Metric 1: Fluence Dose -->
        <div class="bg-surface-soft border border-hairline rounded-2xl p-4 flex flex-col justify-between">
          <span class="text-xs font-medium text-muted">{d.deliveredFluenceLabel}</span>
          <div class="my-2">
            <span id="out-fluence-val" class="text-2xl font-bold font-mono text-ink">38.4</span>
            <span class="text-xs text-muted ml-1">mJ/cm²</span>
          </div>
          <div class="w-full bg-hairline rounded-full h-1.5 overflow-hidden">
            <div id="bar-fluence" class="bg-sky-600 h-full rounded-full transition-all duration-300" style="width: 76%;"></div>
          </div>
          <span id="sub-fluence-target" class="text-[11px] text-muted mt-2">HACCP 5-Log Target: ≥ 25.0 mJ/cm²</span>
        </div>

        <!-- Metric 2: Pathogen Log Reduction -->
        <div class="bg-surface-soft border border-hairline rounded-2xl p-4 flex flex-col justify-between">
          <span class="text-xs font-medium text-muted">{d.pathogenLogLabel}</span>
          <div class="my-2">
            <span id="out-log-val" class="text-2xl font-bold font-mono text-emerald-600 dark:text-emerald-400">5.82</span>
            <span class="text-xs text-muted ml-1">Log10 (99.9998%)</span>
          </div>
          <div class="w-full bg-hairline rounded-full h-1.5 overflow-hidden">
            <div id="bar-log" class="bg-emerald-600 h-full rounded-full transition-all duration-300" style="width: 95%;"></div>
          </div>
          <span id="sub-target-pathogen" class="text-[11px] text-muted mt-2">Target: E. coli O157:H7 & Cryptosporidium</span>
        </div>

        <!-- Metric 3: Irradiance & Optical Transmission -->
        <div class="bg-surface-soft border border-hairline rounded-2xl p-4 flex flex-col justify-between">
          <span class="text-xs font-medium text-muted">{d.meanIrradianceLabel}</span>
          <div class="my-2">
            <span id="out-irradiance-val" class="text-2xl font-bold font-mono text-ink">142.6</span>
            <span class="text-xs text-muted ml-1">mW/cm²</span>
          </div>
          <div class="w-full bg-hairline rounded-full h-1.5 overflow-hidden">
            <div id="bar-irradiance" class="bg-sky-600 h-full rounded-full transition-all duration-300" style="width: 65%;"></div>
          </div>
          <span id="sub-sleeve-trans" class="text-[11px] text-muted mt-2">Effective Transmittance: 88.2%</span>
        </div>

        <!-- Metric 4: Residence Time & Flow Regime -->
        <div class="bg-surface-soft border border-hairline rounded-2xl p-4 flex flex-col justify-between">
          <span class="text-xs font-medium text-muted">{d.residenceTimeLabel}</span>
          <div class="my-2">
            <span id="out-residence-val" class="text-2xl font-bold font-mono text-ink">1.84</span>
            <span class="text-xs text-muted ml-1">seconds</span>
          </div>
          <div class="w-full bg-hairline rounded-full h-1.5 overflow-hidden">
            <div id="bar-residence" class="bg-sky-600 h-full rounded-full transition-all duration-300" style="width: 45%;"></div>
          </div>
          <span id="sub-hydro-regime" class="text-[11px] text-muted mt-2">Flow Regime: Dean Vortical (De ≈ 240)</span>
        </div>
      </div>

      <!-- Secondary Physics Readouts Table -->
      <div class="bg-surface-soft border border-hairline rounded-2xl p-5 space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-muted">
          Photobiological & Fluid Thermal Parameters
        </h4>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-y-2.5 gap-x-6 text-xs">
          <div class="flex items-center justify-between border-b border-hairline/60 pb-1.5">
            <span class="text-muted">{d.dimerPhotolysisLabel}:</span>
            <span id="out-dimer-rate" class="font-mono font-medium text-ink">99.98% Photolysis</span>
          </div>
          <div class="flex items-center justify-between border-b border-hairline/60 pb-1.5">
            <span class="text-muted">{d.photoreactivationLabel}:</span>
            <span id="out-photoreact-risk" class="font-mono font-medium text-emerald-600 dark:text-emerald-400">Low / Fully Suppressed</span>
          </div>
          <div class="flex items-center justify-between border-b border-hairline/60 pb-1.5">
            <span class="text-muted">{d.tempRiseLabel}:</span>
            <span id="out-temp-rise" class="font-mono font-medium text-ink">+0.42 °C (Cold Treatment)</span>
          </div>
          <div class="flex items-center justify-between border-b border-hairline/60 pb-1.5">
            <span class="text-muted">{d.sensorTransmissionLabel}:</span>
            <span id="out-sensor-trans" class="font-mono font-medium text-ink">91.5% of Baseline</span>
          </div>
        </div>
      </div>

      <!-- Engineering Limitations & Mitigation Protocol Card -->
      <div class="bg-surface-soft border border-hairline rounded-2xl p-5 space-y-3">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-amber-600 dark:text-amber-400">
            {d.primaryLimitationLabel}
          </span>
          <p id="out-primary-limit" class="text-xs text-ink mt-1 font-medium leading-relaxed">
            High optical absorption coefficient (α_254 = 28.5 cm⁻¹) restricts 90% photon penetration depth to less than 0.8 mm.
          </p>
        </div>
        <div class="border-t border-hairline/60 pt-2.5">
          <span class="text-xs font-bold uppercase tracking-wider text-sky-700 dark:text-sky-300">
            {d.mitigationActionLabel}
          </span>
          <p id="out-mitigation-action" class="text-xs text-muted mt-1 leading-relaxed">
            Maintain annular gap ≤ 1.0 mm or enforce turbulent secondary Dean vortex mixing (Dean number De &gt; 150) to transport fluid particles from the outer shell to the quartz sleeve radiation interface.
          </p>
        </div>
      </div>

    </div>
  </div>

  <!-- Deep Scientific & Regulatory Principles Section -->
  <section class="border-t border-hairline pt-10 space-y-8">
    <div>
      <h2 class="text-title-lg font-bold text-ink tracking-tight">
        {d.scienceTitle}
      </h2>
      <p class="text-body-sm text-muted mt-1">
        {d.scienceSub}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm">
      <div class="bg-surface-soft border border-hairline rounded-2xl p-6 space-y-3">
        <h3 class="text-base font-semibold text-ink flex items-center gap-2">
          <span class="w-6 h-6 rounded-lg bg-sky-600/10 text-sky-600 flex items-center justify-center text-xs font-bold">1</span>
          Beer-Lambert Law & Optical Penetration in Turbid Liquids
        </h3>
        <p class="text-body text-xs text-muted leading-relaxed">
          The fundamental bottleneck of liquid food UV disinfection is light extinction. In clear municipal water, the absorption coefficient α_254 is typically below 0.05 cm⁻¹, allowing photons to penetrate several centimeters. In contrast, cloudy fruit juices, milk, and broths exhibit α_254 values between 15 and 45 cm⁻¹ due to dissolved polyphenols, vitamins (especially riboflavin), and suspended colloids.
        </p>
        <p class="text-body text-xs text-muted leading-relaxed">
          According to the Beer-Lambert equation, irradiance decays exponentially with distance: <code>I(x) = I_0 · 10^(-α_254 · x)</code>. At α_254 = 30 cm⁻¹, over 90% of germicidal photons are absorbed within the first 330 micrometers (0.33 mm) from the quartz sleeve. Consequently, conventional broad-bore water UV chambers completely fail in liquid foods due to unexposed fluid bypass. Commercial continuous systems must utilize sub-millimeter annular thin films or secondary helical Dean vortices.
        </p>
      </div>

      <div class="bg-surface-soft border border-hairline rounded-2xl p-6 space-y-3">
        <h3 class="text-base font-semibold text-ink flex items-center gap-2">
          <span class="w-6 h-6 rounded-lg bg-sky-600/10 text-sky-600 flex items-center justify-center text-xs font-bold">2</span>
          Cyclobutane Pyrimidine Dimers (CPD) & Lethality Kinetics
        </h3>
        <p class="text-body text-xs text-muted leading-relaxed">
          Short-wave ultraviolet radiation in the germicidal C-band (200 to 280 nm, with peak absorption at 254-260 nm) is selectively absorbed by the conjugated pyrimidine bases of nucleic acids (thymine and cytosine in DNA; uracil in RNA). Photochemical excitation induces covalent dimerization between adjacent pyrimidines, generating Cyclobutane Pyrimidine Dimers (CPDs) and pyrimidine (6-4) pyrimidone photoproducts (6-4PPs).
        </p>
        <p class="text-body text-xs text-muted leading-relaxed">
          These bulky covalent lesions distort the DNA double helix backbone by ~30°, arresting DNA polymerase during transcription and replication. Under FDA 21 CFR § 179.39 and the Juice HACCP rule (21 CFR § 120), commercial UV processors must validate a minimum 5.0 log10 reduction of the most resistant pertinent microorganism (typically <em>Escherichia coli</em> O157:H7 or <em>Cryptosporidium parvum</em>).
        </p>
      </div>

      <div class="bg-surface-soft border border-hairline rounded-2xl p-6 space-y-3">
        <h3 class="text-base font-semibold text-ink flex items-center gap-2">
          <span class="w-6 h-6 rounded-lg bg-sky-600/10 text-sky-600 flex items-center justify-center text-xs font-bold">3</span>
          Enzymatic Photoreactivation vs. Dark Repair Suppression
        </h3>
        <p class="text-body text-xs text-muted leading-relaxed">
          Many enteric foodborne bacteria possess enzymatic repair mechanisms capable of reversing UV-induced DNA lesions. The primary pathway is enzymatic photoreactivation catalyzed by the photolyase enzyme (encoded by the <em>phr</em> gene in <em>E. coli</em> and <em>Salmonella</em>). When exposed to near-UV/visible blue light photons (300 to 500 nm), photolyase absorbs light energy via a folate or deazaflavin cofactor and transfers an electron to the pyrimidine dimer, splitting the cyclobutane ring and restoring the native bases without excision.
        </p>
        <p class="text-body text-xs text-muted leading-relaxed">
          To prevent bacterial resuscitation, commercial juice operations employ two critical safeguards: delivering an overpowering lethal UV dose (≥ 30-35 mJ/cm²) that saturates repair capacity and induces irreparable strand breaks, and immediately packaging the beverage into light-shielded amber/opaque containers or holding in dark cold rooms (4°C) for at least 48 hours post-treatment.
        </p>
      </div>

      <div class="bg-surface-soft border border-hairline rounded-2xl p-6 space-y-3">
        <h3 class="text-base font-semibold text-ink flex items-center gap-2">
          <span class="w-6 h-6 rounded-lg bg-sky-600/10 text-sky-600 flex items-center justify-center text-xs font-bold">4</span>
          3-A Sanitary Standard 54-02 & Quartz Sleeve Fouling Control
        </h3>
        <p class="text-body text-xs text-muted leading-relaxed">
          Because ultraviolet lamps operate at elevated surface temperatures (40°C to 120°C on the quartz sleeve wall), thermal denaturation of milk proteins (β-lactoglobulin) and precipitation of inverse-solubility minerals (calcium phosphate and calcium oxalate "milk-stone") readily form an opaque, baked-on mineral-organic fouling film on the fluid-contacting outer sleeve face.
        </p>
        <p class="text-body text-xs text-muted leading-relaxed">
          Under 3-A Sanitary Standard 54-02 (Equipment for Farm Milk and Liquid Food UV Treatment) and EHEDG guidelines, UV reactors must incorporate automated mechanical wiper assemblies (pneumatic or motorized food-grade PTFE/Viton wipers) and automated Clean-In-Place (CIP) nitric/phosphoric acid circulation cycles. Calibrated germicidal UV sensors (GFDMs) must continuously monitor sleeve transmittance; any drop below 70% triggers an immediate safety interlock diversion valve.
        </p>
      </div>
    </div>

    <!-- Technical Specifications Table -->
    <div class="bg-surface-soft border border-hairline rounded-2xl p-6 overflow-hidden">
      <h3 class="text-base font-semibold text-ink mb-4">
        {d.tableTitle}
      </h3>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs border-collapse">
          <thead>
            <tr class="border-b border-hairline text-muted font-semibold uppercase tracking-wider">
              <th class="py-2.5 px-3">Reactor System Architecture</th>
              <th class="py-2.5 px-3">Optical Gap / Tube ID</th>
              <th class="py-2.5 px-3">Lamp Technology</th>
              <th class="py-2.5 px-3">Typical Throughput</th>
              <th class="py-2.5 px-3">Flow Hydrodynamics</th>
              <th class="py-2.5 px-3">Sanitary Certification</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-hairline/60 font-mono text-ink">
            {puvcData.puvcSystems.map(sys => (
              <tr class="hover:bg-surface transition-colors">
                <td class="py-3 px-3 font-sans font-medium text-ink">{sys.name}</td>
                <td class="py-3 px-3">{sys.annularGapWidthMm} mm ({sys.opticalPathLengthCm} cm)</td>
                <td class="py-3 px-3 text-sky-700 dark:text-sky-300">{sys.lampType}</td>
                <td class="py-3 px-3">{sys.nominalFlowRateLPerMin} L/min (max {sys.maxOperatingPressureBar} bar)</td>
                <td class="py-3 px-3">{sys.technologyType.includes('Dean') ? 'Helical Dean Vortices' : 'Thin-Film Annular'}</td>
                <td class="py-3 px-3 text-[11px] font-sans text-muted">{sys.sanitaryCertifications}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</div>

<script>
  // Client-side Interactive Simulation Controller
  import puvcData from '../data/puvc-disinfection-data.json';

  function initPuvcModeler() {
    const sysSelect = document.getElementById('puvc-system-select') as HTMLSelectElement | null;
    const fluidSelect = document.getElementById('puvc-fluid-select') as HTMLSelectElement | null;
    const sleeveSelect = document.getElementById('puvc-sleeve-select') as HTMLSelectElement | null;
    const powerSlider = document.getElementById('puvc-power-slider') as HTMLInputElement | null;
    const flowSlider = document.getElementById('puvc-flow-slider') as HTMLInputElement | null;
    const flashSlider = document.getElementById('puvc-flash-slider') as HTMLInputElement | null;
    const foulingSlider = document.getElementById('puvc-fouling-slider') as HTMLInputElement | null;

    const powerVal = document.getElementById('puvc-power-val');
    const flowVal = document.getElementById('puvc-flow-val');
    const flashVal = document.getElementById('puvc-flash-val');
    const foulingVal = document.getElementById('puvc-fouling-val');

    // Outputs
    const outFluence = document.getElementById('out-fluence-val');
    const barFluence = document.getElementById('bar-fluence');
    const outLog = document.getElementById('out-log-val');
    const barLog = document.getElementById('bar-log');
    const outIrradiance = document.getElementById('out-irradiance-val');
    const barIrradiance = document.getElementById('bar-irradiance');
    const outResidence = document.getElementById('out-residence-val');
    const barResidence = document.getElementById('bar-residence');

    const subTargetPathogen = document.getElementById('sub-target-pathogen');
    const subSleeveTrans = document.getElementById('sub-sleeve-trans');
    const subHydroRegime = document.getElementById('sub-hydro-regime');
    const outDimerRate = document.getElementById('out-dimer-rate');
    const outPhotoreactRisk = document.getElementById('out-photoreact-risk');
    const outTempRise = document.getElementById('out-temp-rise');
    const outSensorTrans = document.getElementById('out-sensor-trans');
    const outPrimaryLimit = document.getElementById('out-primary-limit');
    const outMitigationAction = document.getElementById('out-mitigation-action');

    const statusBanner = document.getElementById('puvc-status-banner');
    const statusIcon = document.getElementById('puvc-status-icon');
    const badgePill = document.getElementById('puvc-badge-pill');
    const statusHeading = document.getElementById('puvc-status-heading');
    const statusDesc = document.getElementById('puvc-status-desc');

    if (!sysSelect || !fluidSelect || !sleeveSelect || !powerSlider || !flowSlider || !flashSlider || !foulingSlider) {
      return;
    }

    function calculate() {
      const currentSys = puvcData.puvcSystems.find(s => s.id === sysSelect!.value) || puvcData.puvcSystems[0];
      const currentFluid = puvcData.fluidSubstrates.find(f => f.id === fluidSelect!.value) || puvcData.fluidSubstrates[0];
      const currentSleeve = puvcData.quartzSleeveMaterials.find(m => m.id === sleeveSelect!.value) || puvcData.quartzSleeveMaterials[0];

      const powerW = parseFloat(powerSlider!.value);
      const flowLpm = parseFloat(flowSlider!.value);
      const flashHz = parseFloat(flashSlider!.value);
      const foulingPct = parseFloat(foulingSlider!.value);

      // Label updates
      if (powerVal) powerVal.textContent = `${powerW.toFixed(0)} W`;
      if (flowVal) flowVal.textContent = `${flowLpm.toFixed(1)} L/min`;
      if (flashVal) flashVal.textContent = `${flashHz.toFixed(0)} Hz`;
      if (foulingVal) foulingVal.textContent = foulingPct === 0 ? `0% (Pristine Clean)` : `${foulingPct.toFixed(0)}% Light Attenuation`;

      // 1. Effective sleeve transmission factoring material and mineral fouling
      const baseSleeveTrans = currentSleeve.transmittanceAt254NmPercent / 100.0;
      const foulingFactor = (100.0 - foulingPct) / 100.0;
      const effectiveSleeveTrans = baseSleeveTrans * foulingFactor;

      // 2. Optical path length and fluid Beer-Lambert absorption
      const gapCm = currentSys.opticalPathLengthCm; // e.g. 0.08 cm to 0.32 cm
      const alpha254 = currentFluid.absorptionCoeffAlpha254; // e.g. 3.4 to 42.0 cm^-1
      
      // Average path extinction factor = (1 - 10^(-alpha * gap)) / (2.303 * alpha * gap)
      const opticalDensity = alpha254 * gapCm;
      const transmissionFluidFraction = Math.pow(10, -opticalDensity);
      const averagePathFactor = opticalDensity > 0.001 
        ? (1.0 - transmissionFluidFraction) / (2.30258 * opticalDensity)
        : 1.0;

      // 3. Volumetric Irradiance (mW/cm^2)
      // UV-C output power = electrical power * efficiency * pulse factor
      const uvcOpticalPowerW = powerW * (currentSys.uvcOpticalEfficiencyPercent / 100.0);
      const pulseFrequencyFactor = Math.min(1.4, 0.6 + (flashHz / 50.0) * 0.4);
      const effectiveUvcPowerW = uvcOpticalPowerW * pulseFrequencyFactor;

      // Approximate quartz surface area (cm^2) based on volume and gap
      // Volume = SurfaceArea * gapCm  => SurfaceArea = Volume / gapCm
      const reactorVolumeCm3 = currentSys.reactorVolumeMl;
      const quartzSurfaceAreaCm2 = reactorVolumeCm3 / gapCm;
      
      const surfaceIrradianceWPerCm2 = quartzSurfaceAreaCm2 > 0 ? (effectiveUvcPowerW / quartzSurfaceAreaCm2) : 0.5;
      const meanVolumetricIrradianceMwPerCm2 = (surfaceIrradianceWPerCm2 * 1000.0) * effectiveSleeveTrans * averagePathFactor;

      // 4. Mean hydraulic residence time (seconds)
      // Flow in cm^3/s = (flowLpm * 1000) / 60
      const flowRateCm3PerSec = (flowLpm * 1000.0) / 60.0;
      const residenceTimeSec = flowRateCm3PerSec > 0 ? (reactorVolumeCm3 / flowRateCm3PerSec) : 1.0;

      // 5. Delivered UV Fluence Dose (mJ/cm^2) = Irradiance (mW/cm^2) * Time (s)
      const deliveredFluence = meanVolumetricIrradianceMwPerCm2 * residenceTimeSec;

      // 6. Pathogen Inactivation Kinetics (Log10 reduction = k * Fluence)
      const k = currentFluid.pathogenSensitivityK; // cm^2 / mJ
      let logReduction = k * deliveredFluence;
      if (logReduction > 8.5) logReduction = 8.5; // practical analytical limit
      if (logReduction < 0.1) logReduction = 0.1;

      // 7. Photolysis rate of CPDs (%)
      const dimerPhotolysisPct = (1.0 - Math.pow(10, -logReduction)) * 100.0;

      // 8. Fluid temperature rise (Delta T = P_dissipated / (m_dot * Cp))
      // Specific heat of juice approx 3.9 kJ/(kg*K) = 3900 J/(kg*K)
      const massFlowKgPerSec = (flowLpm * 1.04) / 60.0; // density ~ 1.04 kg/L
      const thermalLossW = powerW * (1.0 - (currentSys.uvcOpticalEfficiencyPercent / 100.0) * 0.8);
      const tempRiseC = massFlowKgPerSec > 0 ? (thermalLossW * 0.25) / (massFlowKgPerSec * 3900.0) : 0.2;

      // 9. Hydrodynamic Flow Regime & Dean Vortex Number
      const isHelical = currentSys.technologyType.includes('Dean') || currentSys.id.includes('helical');
      const deanNumber = isHelical ? Math.min(480, Math.round(flowLpm * 8.5)) : 0;

      // 10. Update DOM elements
      if (outFluence) outFluence.textContent = deliveredFluence.toFixed(1);
      if (barFluence) {
        const fluencePct = Math.min(100, (deliveredFluence / 60.0) * 100);
        barFluence.style.width = `${fluencePct}%`;
      }

      if (outLog) outLog.textContent = logReduction.toFixed(2);
      if (barLog) {
        const logPct = Math.min(100, (logReduction / 6.0) * 100);
        barLog.style.width = `${logPct}%`;
      }

      if (outIrradiance) outIrradiance.textContent = meanVolumetricIrradianceMwPerCm2.toFixed(1);
      if (barIrradiance) {
        const irrPct = Math.min(100, (meanVolumetricIrradianceMwPerCm2 / 300.0) * 100);
        barIrradiance.style.width = `${irrPct}%`;
      }

      if (outResidence) outResidence.textContent = residenceTimeSec.toFixed(2);
      if (barResidence) {
        const resPct = Math.min(100, (residenceTimeSec / 6.0) * 100);
        barResidence.style.width = `${resPct}%`;
      }

      if (subTargetPathogen) {
        subTargetPathogen.textContent = `Target: ${currentFluid.targetPathogen}`;
      }

      if (subSleeveTrans) {
        subSleeveTrans.textContent = `Effective Sleeve Trans: ${(effectiveSleeveTrans * 100).toFixed(1)}%`;
      }

      if (subHydroRegime) {
        subHydroRegime.textContent = isHelical 
          ? `Dean Vortical Mixing (De ≈ ${deanNumber} • Secondary Dean Vortices Active)`
          : `Thin-Film Annular Laminar-to-Turbulent Shear (Gap = ${currentSys.annularGapWidthMm} mm)`;
      }

      if (outDimerRate) {
        outDimerRate.textContent = `${dimerPhotolysisPct.toFixed(2)}% Dimer Formation`;
      }

      if (outTempRise) {
        outTempRise.textContent = `+${tempRiseC.toFixed(2)} °C (Cold Non-Thermal)`;
      }

      if (outSensorTrans) {
        outSensorTrans.textContent = `${(effectiveSleeveTrans * 100).toFixed(1)}% Baseline`;
      }

      // Photoreactivation Risk Assessment
      if (outPhotoreactRisk) {
        if (deliveredFluence >= 32.0 && currentFluid.ph <= 4.0) {
          outPhotoreactRisk.textContent = 'Low / Irreversibly Suppressed';
          outPhotoreactRisk.className = 'font-mono font-medium text-emerald-600 dark:text-emerald-400';
        } else if (deliveredFluence >= 22.0) {
          outPhotoreactRisk.textContent = 'Moderate (Requires 24h Dark Holding)';
          outPhotoreactRisk.className = 'font-mono font-medium text-amber-600 dark:text-amber-400';
        } else {
          outPhotoreactRisk.textContent = 'High (Active Photolyase Resuscitation Risk)';
          outPhotoreactRisk.className = 'font-mono font-medium text-red-600 dark:text-red-400';
        }
      }

      // Engineering Limitations & Mitigation Texts
      if (outPrimaryLimit) {
        if (effectiveSleeveTrans < 0.45) {
          outPrimaryLimit.textContent = `CRITICAL SLEEVE FOULING: Severe calcium phosphate scale or protein film blocking ${(100 - effectiveSleeveTrans * 100).toFixed(0)}% of germicidal photons, inducing catastrophic pathogen bypass.`;
        } else if (alpha254 > 25.0) {
          outPrimaryLimit.textContent = `HIGH OPTICAL ABSORPTION (α_254 = ${alpha254.toFixed(1)} cm⁻¹): Dense polyphenols and particulate cloud restrict 90% photon penetration depth to less than ${(1.0 / alpha254 * 23.0).toFixed(1)} mm.`;
        } else if (residenceTimeSec < 0.5) {
          outPrimaryLimit.textContent = `SHORT HYDRAULIC RESIDENCE TIME (${residenceTimeSec.toFixed(2)} s): Excessive volumetric flow rate reduces photon exposure time below the lethal threshold for resistant parasites.`;
        } else {
          outPrimaryLimit.textContent = `OPTIMAL OPERATING WINDOW: High surface irradiance and balanced residence time achieve uniform fluence distribution across the flow channel.`;
        }
      }

      if (outMitigationAction) {
        if (effectiveSleeveTrans < 0.45) {
          outMitigationAction.textContent = `INITIATE CIP CYCLE: Circulate 1.5% phosphoric acid at 60°C for 20 minutes to dissolve mineral milk-stone, inspect pneumatic wiper blades, and verify GFDM sensor zero-drift calibration.`;
        } else if (alpha254 > 25.0) {
          outMitigationAction.textContent = `ENFORCE DEAN VORTEX MIXING: Ensure flow velocity maintains Dean number De > 150 to radially transport fluid from outer shadow zones to the active quartz surface, or reduce annular gap to ≤ 0.8 mm.`;
        } else {
          outMitigationAction.textContent = `MAINTAIN STANDARD CIP PROTOCOL: Perform daily automated wiper checks, log hourly optical transmission sensor values, and stage post-treatment liquid in light-tight silos.`;
        }
      }

      // Compliance Status Banner Logic
      const isCompliant = logReduction >= 5.0 && deliveredFluence >= currentFluid.requiredDoseMilliJoulesPerCm2 && effectiveSleeveTrans >= 0.50;
      const isMarginal = logReduction >= 4.0 && deliveredFluence >= 18.0 && effectiveSleeveTrans >= 0.40;

      if (statusBanner && statusIcon && badgePill && statusHeading && statusDesc) {
        if (isCompliant) {
          statusBanner.className = 'border rounded-2xl p-5 transition-colors bg-emerald-500/10 border-emerald-500/30 text-emerald-950 dark:text-emerald-200';
          statusIcon.className = 'p-2 rounded-xl bg-emerald-500/20 text-emerald-600 dark:text-emerald-300 mt-0.5';
          badgePill.className = 'px-2.5 py-0.5 rounded-full text-xs font-bold uppercase bg-emerald-600 text-white';
          badgePill.textContent = 'FDA 5-LOG VALIDATED';
          statusHeading.textContent = 'Fully Compliant FDA 21 CFR § 179.39 Disinfection & Lethality';
          statusDesc.textContent = `Delivered UV-C germicidal fluence (${deliveredFluence.toFixed(1)} mJ/cm²) satisfies FDA Juice HACCP 5-log pathogen lethality standard with zero heat degradation.`;
        } else if (isMarginal) {
          statusBanner.className = 'border rounded-2xl p-5 transition-colors bg-amber-500/10 border-amber-500/30 text-amber-950 dark:text-amber-200';
          statusIcon.className = 'p-2 rounded-xl bg-amber-500/20 text-amber-600 dark:text-amber-300 mt-0.5';
          badgePill.className = 'px-2.5 py-0.5 rounded-full text-xs font-bold uppercase bg-amber-600 text-white';
          badgePill.textContent = 'MARGINAL / SUB-5-LOG';
          statusHeading.textContent = 'Marginal Fluence — Fails FDA 5-Log Mandate';
          statusDesc.textContent = `Pathogen log reduction (${logReduction.toFixed(2)} Log10) is below the mandatory 5.0 log threshold. Increase lamp power or reduce fluid flow rate.`;
        } else {
          statusBanner.className = 'border rounded-2xl p-5 transition-colors bg-red-500/10 border-red-500/30 text-red-950 dark:text-red-200';
          statusIcon.className = 'p-2 rounded-xl bg-red-500/20 text-red-600 dark:text-red-300 mt-0.5';
          badgePill.className = 'px-2.5 py-0.5 rounded-full text-xs font-bold uppercase bg-red-600 text-white';
          badgePill.textContent = 'NON-COMPLIANT / RECALL HAZARD';
          statusHeading.textContent = 'Severe Process Failure — Active Microbial Survival';
          statusDesc.textContent = `Inadequate UV-C fluence (${deliveredFluence.toFixed(1)} mJ/cm²) caused by excessive flow rate, opaque matrix shielding, or fouled quartz sleeves. High food safety risk.`;
        }
      }
    }

    // Attach listeners
    [sysSelect, fluidSelect, sleeveSelect, powerSlider, flowSlider, flashSlider, foulingSlider].forEach(el => {
      el.addEventListener('input', calculate);
      el.addEventListener('change', calculate);
    });

    // Preset Handlers
    const btnCider = document.getElementById('btn-preset-cider');
    const btnMust = document.getElementById('btn-preset-must');
    const btnDairy = document.getElementById('btn-preset-dairy');
    const btnKombucha = document.getElementById('btn-preset-kombucha');
    const btnFouled = document.getElementById('btn-preset-fouled');

    if (btnCider) {
      btnCider.addEventListener('click', () => {
        sysSelect.value = 'pilot_thin_film_annular_reactor';
        fluidSelect.value = 'cloudy_apple_juice';
        sleeveSelect.value = 'synthetic_fused_silica_suprasil';
        powerSlider.value = '900';
        flowSlider.value = '3.0';
        flashSlider.value = '35';
        foulingSlider.value = '0';
        calculate();
      });
    }

    if (btnMust) {
      btnMust.addEventListener('click', () => {
        sysSelect.value = 'industrial_multi_lamp_helical_skid';
        fluidSelect.value = 'clarified_white_grape_must';
        sleeveSelect.value = 'standard_type_214_fused_quartz';
        powerSlider.value = '3800';
        flowSlider.value = '42.0';
        flashSlider.value = '50';
        foulingSlider.value = '5';
        calculate();
      });
    }

    if (btnDairy) {
      btnDairy.addEventListener('click', () => {
        sysSelect.value = 'high_throughput_parallel_annular_train';
        fluidSelect.value = 'skim_bovine_milk_permeate';
        sleeveSelect.value = 'synthetic_fused_silica_suprasil';
        powerSlider.value = '9600';
        flowSlider.value = '180.0';
        flashSlider.value = '60';
        foulingSlider.value = '10';
        calculate();
      });
    }

    if (btnKombucha) {
      btnKombucha.addEventListener('click', () => {
        sysSelect.value = 'industrial_multi_lamp_helical_skid';
        fluidSelect.value = 'craft_raw_kombucha_tea';
        sleeveSelect.value = 'fep_fluoropolymer_encapsulated_sleeve';
        powerSlider.value = '2400';
        flowSlider.value = '25.0';
        flashSlider.value = '40';
        foulingSlider.value = '0';
        calculate();
      });
    }

    if (btnFouled) {
      btnFouled.addEventListener('click', () => {
        sysSelect.value = 'compromised_fouled_sleeve_unit';
        fluidSelect.value = 'cloudy_apple_juice';
        sleeveSelect.value = 'heavily_scaled_fouled_sleeve';
        powerSlider.value = '1200';
        flowSlider.value = '30.0';
        flashSlider.value = '20';
        foulingSlider.value = '70';
        calculate();
      });
    }

    // Initial run
    calculate();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPuvcModeler);
  } else {
    initPuvcModeler();
  }
</script>
