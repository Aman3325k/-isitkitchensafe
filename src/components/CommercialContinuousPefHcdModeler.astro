    const passesSlider = document.getElementById('passes-slider') as HTMLInputElement;

    const feedRateVal = document.getElementById('feed-rate-val');
    const biomassDensityVal = document.getElementById('biomass-density-val');
    const fieldIntensityVal = document.getElementById('field-intensity-val');
    const cavitationPressureVal = document.getElementById('cavitation-pressure-val');
    const pulseWidthVal = document.getElementById('pulse-width-val');
    const passesVal = document.getElementById('passes-val');

    // Telemetry output metrics
    const disruptionMetric = document.getElementById('disruption-metric');
    const disruptionSub = document.getElementById('disruption-sub');
    const proteinMetric = document.getElementById('protein-metric');
    const proteinSub = document.getElementById('protein-sub');
