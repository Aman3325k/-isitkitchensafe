    scienceTitle: "跨膜电穿孔机理与水动力学微射流激波物理学",
    scienceSub: "深入解析细胞膜跨膜电位充电极化、空化气泡非对称崩溃微射流激波及热敏活性物保真机理。",
    tableTitle: "微藻破壁技术综合工程参数对照矩阵",
    exportAuditBtn: "导出完整 PEF-HCD 工程审计 JSON 报告"
  },
  ja: {
    badge: "エレクトロポレーション物理学＆微細藻類流体キャビテーション破砕技術",
    title: "連続式パルス高圧電界放電＆流体キャビテーション微細藻類破砕抽出 (PEF-HCD) シミュレーター",
    subtitle: "連続非加熱パルス高圧電界（15–40 kV/cm、10–50 µs）と多孔流体キャビテーション（6–20 bar、σ < 0.22）の相乗作用を解算し、ビーズ摩耗や有害有機溶剤ゼロでクロレラ・スピルリナ・ヘマトコッカス等の堅牢な細胞壁を常温破壊して活性タンパク質を高収率回収。FDA 21 CFR § 170.36 GRAS、USP <467>、ASME BPVC Section VIII、IEEE Std 510 に完全適合。",
    controlsTitle: "PEF-HCD 破砕スキッド運転パラメータ",
    controlsSub: "スラリー流量、藻類乾燥菌体濃度、電界強度、キャビテーション圧力、パルス幅、処理パス数を設定します。",
    skidLabel: "電界キャビテーションスキッド構成：",
    skidHelp: "商業生産スキッド、無菌クリーンルーム医薬品用フィコビリン単離ユニット、高処理バイオ燃料抽出機、研究開発パイロット機から選択。",
    speciesLabel: "微細藻類種と細胞壁形態：",
    speciesHelp: "クロレラ（Chlorella）、スピルリナ（Spirulina）、ヘマトコッカス厚壁胞子（Haematococcus）、ナンノクロロプシス、または従来基準を選択。",
    cavitatorLabel: "流体キャビテーションチャンバー幾何構造：",
    cavitatorHelp: "レーザー多孔ハステロイオリフィス板、ASME 収束・発散ベンチュリノズル、高剪断渦流キャビテーションチャンバーから選択。",
    feedRateLabel: "連続スラリー質量流量 (F_slurry)：",
    feedRateHelp: "チャンバーを通過する微細藻類懸濁液の総質量流量（10〜600 kg/h）。",
    biomassDensityLabel: "乾燥菌体濃度 (C_dry)：",
    biomassDensityHelp: "懸濁液中の微細藻類乾燥重量濃度（10〜120 g dry/L）。",
    fieldIntensityLabel: "パルス電界強度 (E_pef)：",
    fieldIntensityHelp: "電極間に印加され細胞膜にナノ細孔を穿孔する電界強度（10〜45 kV/cm）。",
    cavitationPressureLabel: "キャビテーション入口液圧 (P_in)：",
    cavitationPressureHelp: "微小気泡群と超音速マイクロジェット衝撃波を誘起する入口圧力（4〜24 bar）。",
    pulseWidthLabel: "パルス幅持続時間 (τ_pulse)：",
    pulseWidthHelp: "高速 IGBT スイッチによる矩形波パルス幅（5〜50 µs）。",
    passesLabel: "相乗処理パス回数 (N_passes)：",
    passesHelp: "結合型 PEF-HCD チャンバーを通過する循環パス数（1〜4 回）。",
    presetsTitle: "産業用クイック運転プリセット：",
    presetChlorella: "クロレラ高機能ヴィーガンプロテイン＆ルテイン（32 kV/cm、14.5 bar、25 µs、細胞破砕率 >93.8%、比エネルギー 0.34 kWh/kg、ビーズミル比 86% 省エネ）",
    presetSpirulina: "スピルリナ高活性天然青色色素 C-フィコシアニン（20 kV/cm、8.5 bar、18 µs、品温 19.5°C、A620/A280 ≥ 2.95 医薬グレード、回収率 97.2%）",
    presetHaematococcus: "ヘマトコッカス厚壁シスト胞子アスタキサンチン破砕（36 kV/cm、18.0 bar、32 µs、シスト壁破壊率 92.4%、溶剤フリー高純度オレオレジン）",
    presetNanno: "ナンノクロロプシス EPA オメガ-3 脂質抽出（38 kV/cm、16.5 bar、30 µs、細胞溶解率 95.1%、遠心分離による清澄水・油相分離）",
    presetBeadHazard: "従来の高速ビーズミル破砕の重大リスク（0 kV/cm、0 bar、ジルコニア摩耗混入、温度上昇 ΔT > 25°C、2.45 kWh/kg、熱変性）",
    presetSolventHazard: "従来の有毒ヘキサン／メタノール抽出基準（可燃性 VOC 蒸気爆発リスク、300 ppm 超の残留溶剤 USP <467> 違反、有害廃液）",
    telemetryTitle: "リアルタイム電界キャビテーション・破砕動力学レーダー",
    telemetrySub: "細胞破壊率、タンパク質溶出率、フィコシアニン純度比、エネルギー消費量、流体温度をリアルタイム解析。",
    disruptionLabel: "微細藻類細胞破砕率 (D_cell)：",
    proteinLabel: "水溶性タンパク質回収率：",
    phycocyaninLabel: "C-フィコシアニン純度比 (A620/A280)：",
    tempLabel: "スラリー出口品温 (T_exit)：",
    secLabel: "比エネルギー消費量 (SEC)：",
    savingsLabel: "ビーズミル比省エネルギー率：",
    solventResidueLabel: "有機溶剤残留量 (USP <467>)：",
    asmeSafetyLabel: "ASME Section VIII 安全率：",
    complianceVerdictLabel: "サニタリー＆ FDA FSMA 判定：",
    diagramTitle: "連続式 PEF-HCD 微細藻類フロー模式図",
    diagramSub: "同軸高圧パルス電穿孔室、流体キャビテーションベンチュリノズル、衛生冷却ジャケットを示すエンジニアリング断面図。",
    chartTitle: "細胞破砕率動力学 vs 比エネルギー消費特性",
    chartSub: "PEF-HCD 相乗効果による極低エネルギー指数関数破砕特性と、従来の直線的ビーズミル高エネルギー消費の比較。",
    scienceTitle: "エレクトロポレーション機構とキャビテーション微小衝撃波物理学",
    scienceSub: "膜電位過渡充電、キャビテーション気泡非対称崩壊マイクロジェット、熱変性防止に関する科学的原理。",
    tableTitle: "微細藻類細胞破砕工学総合比較マトリクス",
    exportAuditBtn: "完全な PEF-HCD 監査 JSON レポートを出力"
  }
};

const d = DICT[lang] || DICT.en;
---

<div id="pef-hcd-modeler-root" class="bg-surface border border-hairline rounded-2xl p-6 lg:p-8 shadow-xs my-8" data-lang={lang}>
  <!-- Header Banner -->
  <div class="border-b border-hairline/80 pb-6 mb-8">
    <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-violet-950 text-violet-300 border border-violet-800 font-mono">
        <svg class="w-3.5 h-3.5 text-violet-400 animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        {d.badge}
      </span>
      <span class="text-xs text-muted font-mono bg-surface-soft px-3 py-1 rounded-md border border-hairline">
        PEF-HCD &bull; 15&ndash;40 kV/cm &bull; 6&ndash;20 bar &bull; &gt;94% Lysis &bull; 0.0 ppm Solvent &bull; FDA GRAS
      </span>
    </div>
    <h1 class="text-2xl lg:text-3xl font-black text-ink tracking-tight mb-2">
      {d.title}
    </h1>
    <p class="text-sm lg:text-base text-body leading-relaxed max-w-4xl">
      {d.subtitle}
    </p>
  </div>

  <!-- Presets Strip -->
  <div class="mb-8 p-4 bg-surface-soft border border-hairline rounded-xl">
    <div class="text-xs font-bold uppercase tracking-wider text-muted mb-3 font-mono">
      ⚡ {d.presetsTitle}
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-2 text-xs">
      <button type="button" class="preset-btn text-left p-2.5 rounded-lg border border-hairline/70 hover:border-emerald-600 bg-surface hover:bg-emerald-950/20 text-ink transition" data-preset="chlorella">
        <span class="font-bold text-emerald-400 block mb-0.5">🌱 Chlorella vulgaris (Rigid Protein Matrix)</span>
        <span class="text-muted text-[11px] block leading-tight">{d.presetChlorella}</span>
      </button>
      <button type="button" class="preset-btn text-left p-2.5 rounded-lg border border-hairline/70 hover:border-cyan-600 bg-surface hover:bg-cyan-950/20 text-ink transition" data-preset="spirulina">
        <span class="font-bold text-cyan-400 block mb-0.5">🌊 Spirulina Blue C-Phycocyanin (Gentle Extraction)</span>
        <span class="text-muted text-[11px] block leading-tight">{d.presetSpirulina}</span>
      </button>
      <button type="button" class="preset-btn text-left p-2.5 rounded-lg border border-hairline/70 hover:border-amber-600 bg-surface hover:bg-amber-950/20 text-ink transition" data-preset="haematococcus">
        <span class="font-bold text-amber-400 block mb-0.5">🦐 Haematococcus Astaxanthin Cysts</span>
        <span class="text-muted text-[11px] block leading-tight">{d.presetHaematococcus}</span>
      </button>
      <button type="button" class="preset-btn text-left p-2.5 rounded-lg border border-hairline/70 hover:border-indigo-600 bg-surface hover:bg-indigo-950/20 text-ink transition" data-preset="nanno">
        <span class="font-bold text-indigo-400 block mb-0.5">🐟 Nannochloropsis EPA Omega-3 Lipids</span>
        <span class="text-muted text-[11px] block leading-tight">{d.presetNanno}</span>
      </button>
      <button type="button" class="preset-btn text-left p-2.5 rounded-lg border border-rose-800/80 hover:border-rose-600 bg-rose-950/20 hover:bg-rose-950/40 text-rose-200 transition" data-preset="hazard_bead">
        <span class="font-bold text-rose-400 block mb-0.5">⚠️ Conventional Agitated Bead Mill (HAZARD)</span>
        <span class="text-rose-300/80 text-[11px] block leading-tight">{d.presetBeadHazard}</span>
      </button>
      <button type="button" class="preset-btn text-left p-2.5 rounded-lg border border-rose-800/80 hover:border-rose-600 bg-rose-950/20 hover:bg-rose-950/40 text-rose-200 transition" data-preset="hazard_solvent">
        <span class="font-bold text-rose-400 block mb-0.5">⚠️ Conventional Hexane/Methanol Solvent (HAZARD)</span>
        <span class="text-rose-300/80 text-[11px] block leading-tight">{d.presetSolventHazard}</span>
      </button>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-10">
    <!-- Controls Column (5 cols) -->
    <div class="lg:col-span-5 space-y-6">
      <div class="border border-hairline rounded-xl p-5 bg-surface-soft">
        <h2 class="text-base font-bold text-ink mb-1 flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-violet-500"></span>
          {d.controlsTitle}
        </h2>
        <p class="text-xs text-muted mb-4">{d.controlsSub}</p>

        <div class="space-y-4 text-xs">
          <!-- Skid Selection -->
          <div>
            <label for="skid-select" class="block font-medium text-ink mb-1">{d.skidLabel}</label>
            <select id="skid-select" class="w-full bg-surface border border-hairline rounded-lg px-3 py-2 text-ink text-xs focus:outline-none focus:border-violet-500">
              {pefHcdData.systemArchitectures.map((skid) => (
                <option value={skid.id}>{skid.name}</option>
              ))}
            </select>
            <span class="text-[11px] text-muted block mt-1">{d.skidHelp}</span>
          </div>

          <!-- Microalgae Species Selection -->
          <div>
            <label for="species-select" class="block font-medium text-ink mb-1">{d.speciesLabel}</label>
            <select id="species-select" class="w-full bg-surface border border-hairline rounded-lg px-3 py-2 text-ink text-xs focus:outline-none focus:border-violet-500">
              {pefHcdData.microalgaeSpecies.map((sp) => (
                <option value={sp.id}>{sp.name}</option>
              ))}
            </select>
            <span class="text-[11px] text-muted block mt-1">{d.speciesHelp}</span>
          </div>

          <!-- Cavitation Geometry Selection -->
          <div>
            <label for="cavitator-select" class="block font-medium text-ink mb-1">{d.cavitatorLabel}</label>
            <select id="cavitator-select" class="w-full bg-surface border border-hairline rounded-lg px-3 py-2 text-ink text-xs focus:outline-none focus:border-violet-500">
              {pefHcdData.reactorCavitationGeometries.map((cav) => (
                <option value={cav.id}>{cav.name}</option>
              ))}
            </select>
            <span class="text-[11px] text-muted block mt-1">{d.cavitatorHelp}</span>
          </div>

          <!-- Slurry Feed Rate Slider -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label for="feed-rate-slider" class="font-medium text-ink">{d.feedRateLabel}</label>
              <span id="feed-rate-val" class="font-mono font-bold text-violet-400">100.0 kg/h</span>
            </div>
            <input type="range" id="feed-rate-slider" min="15" max="500" step="5" value="100" class="w-full accent-violet-500 h-1.5 bg-surface rounded-lg cursor-pointer" />
            <span class="text-[11px] text-muted block mt-1">{d.feedRateHelp}</span>
          </div>

          <!-- Dry Biomass Density Slider -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label for="biomass-density-slider" class="font-medium text-ink">{d.biomassDensityLabel}</label>
              <span id="biomass-density-val" class="font-mono font-bold text-cyan-400">50.0 g/L</span>
            </div>
            <input type="range" id="biomass-density-slider" min="10" max="120" step="5" value="50" class="w-full accent-cyan-500 h-1.5 bg-surface rounded-lg cursor-pointer" />
            <span class="text-[11px] text-muted block mt-1">{d.biomassDensityHelp}</span>
          </div>

          <!-- Electric Field Intensity Slider -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label for="field-intensity-slider" class="font-medium text-ink">{d.fieldIntensityLabel}</label>
              <span id="field-intensity-val" class="font-mono font-bold text-violet-400">30.0 kV/cm</span>
            </div>
            <input type="range" id="field-intensity-slider" min="10" max="45" step="1" value="30" class="w-full accent-violet-500 h-1.5 bg-surface rounded-lg cursor-pointer" />
            <span class="text-[11px] text-muted block mt-1">{d.fieldIntensityHelp}</span>
          </div>

          <!-- Cavitation Inlet Pressure Slider -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label for="cavitation-pressure-slider" class="font-medium text-ink">{d.cavitationPressureLabel}</label>
              <span id="cavitation-pressure-val" class="font-mono font-bold text-amber-400">12.0 bar</span>
            </div>
            <input type="range" id="cavitation-pressure-slider" min="4" max="24" step="0.5" value="12" class="w-full accent-amber-500 h-1.5 bg-surface rounded-lg cursor-pointer" />
            <span class="text-[11px] text-muted block mt-1">{d.cavitationPressureHelp}</span>
          </div>

          <!-- Pulse Width Slider -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label for="pulse-width-slider" class="font-medium text-ink">{d.pulseWidthLabel}</label>
              <span id="pulse-width-val" class="font-mono font-bold text-emerald-400">25.0 µs</span>
            </div>
            <input type="range" id="pulse-width-slider" min="5" max="50" step="1" value="25" class="w-full accent-emerald-500 h-1.5 bg-surface rounded-lg cursor-pointer" />
            <span class="text-[11px] text-muted block mt-1">{d.pulseWidthHelp}</span>
          </div>

          <!-- Treatment Passes Slider -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label for="passes-slider" class="font-medium text-ink">{d.passesLabel}</label>
              <span id="passes-val" class="font-mono font-bold text-indigo-400">1 Pass</span>
            </div>
            <input type="range" id="passes-slider" min="1" max="4" step="1" value="1" class="w-full accent-indigo-500 h-1.5 bg-surface rounded-lg cursor-pointer" />
            <span class="text-[11px] text-muted block mt-1">{d.passesHelp}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Telemetry & Process Column (7 cols) -->
    <div class="lg:col-span-7 space-y-6">
      <!-- Live Metrics Radar Grid -->
      <div class="border border-hairline rounded-xl p-5 bg-surface-soft">
        <div class="flex items-center justify-between mb-4">
          <div>
            <h2 class="text-base font-bold text-ink flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-violet-500 animate-ping"></span>
              {d.telemetryTitle}
            </h2>
            <p class="text-xs text-muted">{d.telemetrySub}</p>
          </div>
          <span id="status-pill" class="px-2.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-emerald-950 text-emerald-300 border border-emerald-800 font-mono">
            FDA GRAS / USP PASS
          </span>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mb-4">
          <!-- Cell Disruption Rate -->
          <div class="p-3 rounded-lg bg-surface border border-hairline">
            <span class="text-[11px] text-muted block font-medium">{d.disruptionLabel}</span>
            <div class="flex items-baseline gap-1 mt-1">
              <span id="disruption-metric" class="text-2xl font-black font-mono text-violet-400">94.8%</span>
            </div>
            <span id="disruption-sub" class="text-[10px] text-violet-400 font-mono block mt-1">Nanoscale Electroporation Lysis</span>
          </div>

          <!-- Soluble Protein Recovery -->
          <div class="p-3 rounded-lg bg-surface border border-hairline">
            <span class="text-[11px] text-muted block font-medium">{d.proteinLabel}</span>
            <div class="flex items-baseline gap-1 mt-1">
              <span id="protein-metric" class="text-2xl font-black font-mono text-emerald-400">92.4%</span>
            </div>
            <span id="protein-sub" class="text-[10px] text-emerald-400 font-mono block mt-1">High-Bioactivity Intact State</span>
          </div>

          <!-- C-Phycocyanin Purity Ratio -->
          <div class="p-3 rounded-lg bg-surface border border-hairline">
            <span class="text-[11px] text-muted block font-medium">{d.phycocyaninLabel}</span>
            <div class="flex items-baseline gap-1 mt-1">
              <span id="phycocyanin-metric" class="text-2xl font-black font-mono text-cyan-400">2.95</span>
            </div>
            <span id="phycocyanin-sub" class="text-[10px] text-muted font-mono block mt-1">A620/A280 Pure Grade</span>
          </div>

          <!-- Slurry Exit Temperature -->
          <div class="p-3 rounded-lg bg-surface border border-hairline">
            <span class="text-[11px] text-muted block font-medium">{d.tempLabel}</span>
            <div class="flex items-baseline gap-1 mt-1">
              <span id="temp-metric" class="text-xl font-black font-mono text-emerald-400">24.5&deg;C</span>
            </div>
            <span id="temp-sub" class="text-[10px] text-emerald-400 font-mono block mt-1">Safe Non-Thermal (&lt;38&deg;C)</span>
          </div>

          <!-- Specific Energy Consumption (SEC) -->
          <div class="p-3 rounded-lg bg-surface border border-hairline">
            <span class="text-[11px] text-muted block font-medium">{d.secLabel}</span>
            <div class="flex items-baseline gap-1 mt-1">
              <span id="sec-metric" class="text-xl font-black font-mono text-amber-400">0.32</span>
              <span class="text-xs font-mono text-muted">kWh/kg</span>
            </div>
            <span id="sec-sub" class="text-[10px] text-muted font-mono block mt-1">Ultra-Low Power Input</span>
          </div>

          <!-- Energy Savings vs Bead Milling -->
          <div class="p-3 rounded-lg bg-surface border border-hairline">
            <span class="text-[11px] text-muted block font-medium">{d.savingsLabel}</span>
            <div class="flex items-baseline gap-1 mt-1">
              <span id="savings-metric" class="text-xl font-black font-mono text-emerald-400">86.4%</span>
            </div>
            <span id="savings-sub" class="text-[10px] text-emerald-400 font-mono block mt-1">Direct OPEX Reduction</span>
          </div>
        </div>

        <div class="border-t border-hairline pt-3 space-y-2 text-xs">
          <div class="flex justify-between items-center">
            <span class="text-muted">{d.solventResidueLabel}</span>
            <span id="solvent-metric" class="font-mono font-bold text-emerald-400">0.0 ppm &bull; USP &lt;467&gt; Pass &bull; 100% Aqueous Clean Green</span>
          </div>
          <div class="flex justify-between items-center">
            <span class="text-muted">{d.asmeSafetyLabel}</span>
            <span id="asme-metric" class="font-mono font-bold text-emerald-400">SF = 4.8 &ge; 4.0 (ASME BPVC VIII Div 1 &amp; 2 Safe) &bull; IEEE 510 Crowbar OK</span>
          </div>
        </div>
      </div>

      <!-- Compliance Verdict Banner -->
      <div id="compliance-banner" class="p-4 rounded-xl border bg-emerald-950/40 border-emerald-800 text-xs text-emerald-200 flex items-start gap-3">
