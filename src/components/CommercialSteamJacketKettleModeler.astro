const d = DICTIONARY[lang];
---

<div class="bg-surface border border-hairline rounded-3xl p-6 md:p-10 shadow-sm max-w-5xl mx-auto my-8">
  <!-- Header Badge -->
  <div class="flex items-center gap-2 mb-4">
    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-red-600/10 text-red-700 dark:text-red-400 border border-red-600/20">
      <span class="w-2 h-2 rounded-full bg-red-600 animate-pulse"></span>
      {d.badge}
    </span>
    <span class="text-xs text-muted font-mono">ASME Section VIII Div 1 &bull; NBBI NB-23 &bull; OSHA 1910.169</span>
  </div>

  <h2 class="text-2xl md:text-3xl font-extrabold text-ink tracking-tight mb-3">
    {d.title}
  </h2>
  <p class="text-body text-sm md:text-base leading-relaxed mb-8 max-w-3xl">
    {d.subtitle}
  </p>

  <!-- Scenario Presets -->
  <div class="mb-8 p-4 md:p-5 rounded-2xl bg-surface-soft border border-hairline">
    <div class="text-xs font-bold text-muted uppercase tracking-wider mb-3">
      {d.presetsTitle}
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
      <button
        type="button"
        id="preset-gold"
        class="text-left text-xs p-3 rounded-xl border border-emerald-500/30 bg-emerald-500/5 hover:bg-emerald-500/10 text-emerald-900 dark:text-emerald-300 transition-all flex items-start gap-2"
      >
        <span class="text-emerald-600 text-sm leading-none mt-0.5">✓</span>
        <span>{d.presetGoldStandard}</span>
      </button>

      <button
        type="button"
        id="preset-overpressure"
        class="text-left text-xs p-3 rounded-xl border border-amber-500/30 bg-amber-500/5 hover:bg-amber-500/10 text-amber-900 dark:text-amber-300 transition-all flex items-start gap-2"
      >
        <span class="text-amber-600 text-sm leading-none mt-0.5">⚠️</span>
        <span>{d.presetOverpressureChoke}</span>
      </button>

      <button
        type="button"
        id="preset-implosion"
        class="text-left text-xs p-3 rounded-xl border border-blue-500/30 bg-blue-500/5 hover:bg-blue-500/10 text-blue-900 dark:text-blue-300 transition-all flex items-start gap-2"
      >
        <span class="text-blue-600 text-sm leading-none mt-0.5">❄️</span>
        <span>{d.presetLinerImplosion}</span>
      </button>

      <button
        type="button"
        id="preset-bleve"
        class="text-left text-xs p-3 rounded-xl border border-rose-500/30 bg-rose-500/5 hover:bg-rose-500/10 text-rose-900 dark:text-rose-300 transition-all flex items-start gap-2"
      >
        <span class="text-rose-600 text-sm leading-none mt-0.5">💥</span>
        <span>{d.presetDryFireBleve}</span>
      </button>
    </div>
  </div>

  <!-- Interactive Controls Section -->
  <div class="mb-10">
    <div class="border-b border-hairline pb-3 mb-6">
      <h3 class="text-lg font-bold text-ink">
        {d.controlsTitle}
      </h3>
      <p class="text-xs text-muted">
        {d.controlsSub}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
      <!-- Select 1: Kettle Model -->
      <div>
        <label for="kettle-model" class="block text-xs font-bold text-ink mb-1.5">
          {d.kettleModelLabel}
        </label>
        <select
          id="kettle-model"
          class="w-full text-xs rounded-xl bg-surface border border-hairline p-3 text-ink focus:outline-none focus:ring-2 focus:ring-red-500"
        >
          {kettleData.kettleArchitectures.map((m) => (
            <option value={m.id}>{m.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1 leading-normal">
          {d.kettleModelHelp}
        </p>
      </div>

      <!-- Select 2: SRV Condition -->
      <div>
        <label for="srv-condition" class="block text-xs font-bold text-ink mb-1.5">
          {d.srvConditionLabel}
        </label>
        <select
          id="srv-condition"
          class="w-full text-xs rounded-xl bg-surface border border-hairline p-3 text-ink focus:outline-none focus:ring-2 focus:ring-red-500"
        >
          {kettleData.safetyReliefValveConditions.map((s) => (
            <option value={s.id}>{s.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1 leading-normal">
          {d.srvConditionHelp}
        </p>
      </div>

      <!-- Select 3: Food Product Rheology -->
      <div>
