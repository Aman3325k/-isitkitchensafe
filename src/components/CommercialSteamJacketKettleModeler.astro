<script define:vars={{ kettleData, lang }}>
  (function() {
    // DOM Element References
    const kettleModelSelect = document.getElementById('kettle-model');
    const srvConditionSelect = document.getElementById('srv-condition');
    const foodMatrixSelect = document.getElementById('food-matrix');
    const vacuumBreakerSelect = document.getElementById('vacuum-breaker');
    const lowWaterProbeSelect = document.getElementById('low-water-probe');

    const firingRateSlider = document.getElementById('firing-rate-slider');
    const dwellSlider = document.getElementById('dwell-slider');
    const chargeSlider = document.getElementById('charge-slider');
    const batchVolumeSlider = document.getElementById('batch-volume-slider');

    const firingRateVal = document.getElementById('firing-rate-val');
    const dwellVal = document.getElementById('dwell-val');
    const chargeVal = document.getElementById('charge-val');
    const batchVolumeVal = document.getElementById('batch-volume-val');

    // Telemetry Elements
    const telePressure = document.getElementById('tele-pressure');
    const teleTemp = document.getElementById('tele-temp');
    const telePressureBadge = document.getElementById('tele-pressure-badge');
    const telePressureStatus = document.getElementById('tele-pressure-status');

    const teleRelieving = document.getElementById('tele-relieving');
    const teleRelievingSub = document.getElementById('tele-relieving-sub');
    const teleRelievingBadge = document.getElementById('tele-relieving-badge');
    const teleRelievingStatus = document.getElementById('tele-relieving-status');

    const teleVacuum = document.getElementById('tele-vacuum');
    const teleVacuumSub = document.getElementById('tele-vacuum-sub');
    const teleVacuumBadge = document.getElementById('tele-vacuum-badge');
    const teleVacuumStatus = document.getElementById('tele-vacuum-status');

    const teleLowWater = document.getElementById('tele-lowwater');
    const teleLowWaterSub = document.getElementById('tele-lowwater-sub');
    const teleLowWaterBadge = document.getElementById('tele-lowwater-badge');
    const teleLowWaterStatus = document.getElementById('tele-lowwater-status');

    const teleBleve = document.getElementById('tele-bleve');
    const teleBleveSub = document.getElementById('tele-bleve-sub');
    const teleBleveBadge = document.getElementById('tele-bleve-badge');
    const teleBleveStatus = document.getElementById('tele-bleve-status');

    const teleCompliance = document.getElementById('tele-compliance');
    const teleComplianceBadge = document.getElementById('tele-compliance-badge');
    const teleComplianceStatus = document.getElementById('tele-compliance-status');

    const analysisPrimaryHazard = document.getElementById('analysis-primary-hazard');
    const analysisMechanisms = document.getElementById('analysis-mechanisms');
    const analysisMitigation = document.getElementById('analysis-mitigation');

    const btnCopyReport = document.getElementById('btn-copy-report');
    const copyFeedback = document.getElementById('copy-feedback');

    // Presets
    const presetGold = document.getElementById('preset-gold');
    const presetOverpressure = document.getElementById('preset-overpressure');
    const presetImplosion = document.getElementById('preset-implosion');
    const presetBleve = document.getElementById('preset-bleve');

    function calculateModel() {
      const modelId = kettleModelSelect.value;
      const srvId = srvConditionSelect.value;
      const foodId = foodMatrixSelect.value;
      const vacuumId = vacuumBreakerSelect.value;
      const lowWaterId = lowWaterProbeSelect.value;

      const firingRate = parseFloat(firingRateSlider.value);
      const dwellMins = parseFloat(dwellSlider.value);
      const chargePct = parseFloat(chargeSlider.value);
      const batchVol = parseFloat(batchVolumeSlider.value);

      // Display Slider Values
      firingRateVal.textContent = firingRate.toLocaleString() + ' BTU/hr';
      dwellVal.textContent = dwellMins + ' min';
      chargeVal.textContent = chargePct + ' %';
      batchVolumeVal.textContent = batchVol + ' gal (' + Math.round(batchVol * 3.785) + ' L)';

      const model = kettleData.kettleArchitectures.find(m => m.id === modelId) || kettleData.kettleArchitectures[0];
      const srv = kettleData.safetyReliefValveConditions.find(s => s.id === srvId) || kettleData.safetyReliefValveConditions[0];
      const food = kettleData.foodProductMatrices.find(f => f.id === foodId) || kettleData.foodProductMatrices[0];
      const vacuum = kettleData.vacuumBreakerStates.find(v => v.id === vacuumId) || kettleData.vacuumBreakerStates[0];
      const lowWater = kettleData.lowWaterProbeConditions.find(p => p.id === lowWaterId) || kettleData.lowWaterProbeConditions[0];

      // 1. Steam Production Rate from Burner (lbs/hr)
      // Burner thermal efficiency ~75% in commercial kettles; Latent heat of vaporization ~910 BTU/lb at ~50 PSI
      const burnerEff = 0.75;
      const hfgBtuLb = 910.0;
      const steamGenRateLbsHr = (firingRate * burnerEff) / hfgBtuLb;

      // 2. Heat dissipation into food product
      // U value governs dissipation. High U (broth) = rapid dissipation, low jacket pressure. Low U (polenta) = thermal choke.
      const uFactor = food.overallHeatTransferCoeff / 1850.0; // 1.0 for broth, 0.05 for polenta
      const thermalChokeRatio = 1.0 - Math.min(uFactor * (batchVol / 35.0), 0.90);

      // 3. Low Water Cutoff Check
      let isDryFiring = false;
      let lowWaterStatusText = "NORMAL (Water Level Safe)";
      let lowWaterColor = "text-emerald-600 dark:text-emerald-400";
      if (chargePct < 30) {
        if (lowWater.cutoffReliabilityPercent > 80) {
          lowWaterStatusText = "CUTOFF ACTIVE (Burner Interlock Tripped)";
          lowWaterColor = "text-blue-600 dark:text-blue-400";
        } else {
          isDryFiring = true;
          lowWaterStatusText = "DRY-FIRING HAZARD (Burner Firing on Empty Jacket)";
          lowWaterColor = "text-rose-600 dark:text-rose-400";
        }
      }

      // 4. Pressure Accumulation
      let jacketPressure = 0.0;
      if (isDryFiring) {
        jacketPressure = 2.0 + (chargePct * 0.15); // residual steam
      } else {
        // Normal to elevated steam pressure
        const baselineOperating = model.mawpPsi * 0.55; // normal simmering ~25-30 PSI
        const chokePressureRise = (dwellMins * 1.8) * thermalChokeRatio * (firingRate / 140000.0);
        jacketPressure = baselineOperating + chokePressureRise;

        // If pressure exceeds SRV set pressure:
        if (jacketPressure > srv.setPressurePsi) {
          if (srv.flowRestrictionPercent >= 100) {
            // Plugged valve: unchecked accumulation
            jacketPressure = srv.setPressurePsi + (dwellMins * 2.4);
          } else {
            // Relieving valve vents steam
            const effectiveRelieving = srv.relievingCapacityLbsHr * (1.0 - (srv.flowRestrictionPercent / 100.0));
            if (effectiveRelieving >= steamGenRateLbsHr) {
              jacketPressure = srv.setPressurePsi * 1.03; // well regulated within 3% accumulation
            } else {
              // Undersized or choked relief: pressure accumulates past setpoint
              const deficit = steamGenRateLbsHr - effectiveRelieving;
              jacketPressure = srv.setPressurePsi + (deficit * 0.05 * (dwellMins / 10.0));
            }
          }
        }
      }

      // Cap simulated pressure at realistic physical bursting limit (~95 PSI)
      jacketPressure = Math.min(Math.max(jacketPressure, 0.0), 95.0);

      // Saturated Steam Temperature (°C and °F)
      // Approximation formula around 0–95 PSI
      const tempC = jacketPressure > 0.5 
        ? 100.0 + (1.28 * jacketPressure) - (0.0038 * jacketPressure * jacketPressure)
        : 100.0;
      const tempF = (tempC * 9/5) + 32;

      // 5. Relieving Flow Capacity vs Required
      const requiredFlow = steamGenRateLbsHr;
      const actualFlow = srv.flowRestrictionPercent >= 100 
        ? 0.0 
        : srv.relievingCapacityLbsHr * (1.0 - (srv.flowRestrictionPercent / 100.0));
      const relievingMarginPct = requiredFlow > 0 ? (actualFlow / requiredFlow) * 100.0 : 100.0;

      // 6. Vacuum Breaker & Shell Implosion
      // If cooking cycle ends and vacuum pulls:
      const vacuumInHg = Math.abs(vacuum.crackingVacuumPsi) * 2.036;
      const shellBucklingMarginPsi = 12.5 - Math.abs(vacuum.crackingVacuumPsi); // 12.5 PSI critical buckling threshold

      // 7. BLEVE Blast Potential
      let bleveKj = 0.0;
      if (jacketPressure > 40.0) {
        // High pressure steam + superheated water flash energy
        bleveKj = (jacketPressure / 50.0) * (model.jacketWaterVolumeLiters * (chargePct / 100.0)) * 14.5;
      }
      if (isDryFiring && chargePct < 25) {
        // Superheated bare metal flash upon recharge
        bleveKj = 420.0;
      }

      // 8. Compliance & Status Verdicts
      const mawp = model.mawpPsi;
      const maxAllowedAccumulation = mawp * 1.10; // 110% per ASME Section VIII
      let complianceVerdict = "COMPLIANT";
      let complianceColor = "text-emerald-600 dark:text-emerald-400";
      let complianceDetail = "100% ASME Section VIII & OSHA Compliant";

      if (srv.flowRestrictionPercent >= 100) {
        complianceVerdict = "FATAL VIOLATION";
        complianceColor = "text-rose-600 dark:text-rose-400";
        complianceDetail = "CRITICAL: Plugged Relief Valve Violates ASME BPVC § UG-125";
      } else if (jacketPressure > maxAllowedAccumulation) {
        complianceVerdict = "NON-COMPLIANT (OVERPRESSURE)";
        complianceColor = "text-rose-600 dark:text-rose-400";
        complianceDetail = "Exceeds 110% MAWP Accumulation Limit (ASME § UG-133)";
      } else if (vacuum.implosionRiskPercent > 60) {
        complianceVerdict = "IMMINENT IMPLOSION RISK";
        complianceColor = "text-blue-600 dark:text-blue-400";
        complianceDetail = "Vacuum Breaker Failure Exceeds Critical Buckling Pressure";
      } else if (isDryFiring) {
        complianceVerdict = "DRY-FIRE BURNOUT HAZARD";
        complianceColor = "text-amber-600 dark:text-amber-400";
        complianceDetail = "Low Water Cutoff Bypassed or Scale-Bridged";
      }

      // Update DOM
      telePressure.textContent = jacketPressure.toFixed(1) + ' PSI (' + (jacketPressure * 6.895).toFixed(0) + ' kPa)';
      teleTemp.textContent = tempC.toFixed(1) + '°C / ' + tempF.toFixed(1) + '°F Saturated Steam';

      if (jacketPressure > maxAllowedAccumulation) {
        telePressureStatus.textContent = "OVERPRESSURE HAZARD (>110% MAWP)";
        telePressureBadge.className = "mt-3 text-[11px] font-semibold flex items-center gap-1.5 text-rose-600 dark:text-rose-400";
      } else if (jacketPressure > mawp) {
        telePressureStatus.textContent = "AT RELIEF VALVE SETPOINT";
        telePressureBadge.className = "mt-3 text-[11px] font-semibold flex items-center gap-1.5 text-amber-600 dark:text-amber-400";
      } else {
        telePressureStatus.textContent = "WITHIN DESIGN OPERATING RANGE";
        telePressureBadge.className = "mt-3 text-[11px] font-semibold flex items-center gap-1.5 text-emerald-600 dark:text-emerald-400";
      }

      teleRelieving.textContent = relievingMarginPct.toFixed(0) + '% Capacity';
      teleRelievingSub.textContent = actualFlow.toFixed(0) + ' lbs/hr actual vs ' + requiredFlow.toFixed(0) + ' lbs/hr req';
      if (relievingMarginPct < 100) {
        teleRelievingStatus.textContent = "RELIEVING DEFICIT (CHOKED DISCHARGE)";
        teleRelievingBadge.className = "mt-3 text-[11px] font-semibold flex items-center gap-1.5 text-rose-600 dark:text-rose-400";
      } else {
        teleRelievingStatus.textContent = "ADEQUATE RELIEF MARGIN (ASME UG-125)";
        teleRelievingBadge.className = "mt-3 text-[11px] font-semibold flex items-center gap-1.5 text-emerald-600 dark:text-emerald-400";
      }

      teleVacuum.textContent = vacuumInHg.toFixed(1) + ' inHg Vacuum';
      teleVacuumSub.textContent = vacuum.airIngressFlowCfm + ' CFM Air Flow | ' + Math.max(shellBucklingMarginPsi, 0).toFixed(1) + ' PSI Margin';
      if (vacuum.implosionRiskPercent > 60) {
        teleVacuumStatus.textContent = "HIGH IMPLOSION / BUCKLING RISK";
        teleVacuumBadge.className = "mt-3 text-[11px] font-semibold flex items-center gap-1.5 text-rose-600 dark:text-rose-400";
      } else {
        teleVacuumStatus.textContent = "VACUUM BREAKER ADEQUATE";
        teleVacuumBadge.className = "mt-3 text-[11px] font-semibold flex items-center gap-1.5 text-emerald-600 dark:text-emerald-400";
      }

      teleLowWater.textContent = chargePct + '% Charge';
      teleLowWaterSub.textContent = lowWaterStatusText;
      teleLowWaterStatus.textContent = isDryFiring ? "BURNER DRY-FIRING ON BARE STEEL" : "LOW WATER INTERLOCK OK";
      teleLowWaterBadge.className = "mt-3 text-[11px] font-semibold flex items-center gap-1.5 " + lowWaterColor;

      teleBleve.textContent = bleveKj > 0 ? bleveKj.toFixed(0) + ' kJ' : '0 kJ';
      teleBleveSub.textContent = (bleveKj / 4184.0).toFixed(3) + ' kg TNT Explosive Equivalent';
      if (bleveKj > 250) {
        teleBleveStatus.textContent = "SEVERE BLEVE BLAST THRESHOLD";
        teleBleveBadge.className = "mt-3 text-[11px] font-semibold flex items-center gap-1.5 text-rose-600 dark:text-rose-400";
      } else {
        teleBleveStatus.textContent = "NOMINAL EXPLOSION HAZARD";
        teleBleveBadge.className = "mt-3 text-[11px] font-semibold flex items-center gap-1.5 text-emerald-600 dark:text-emerald-400";
      }

      teleCompliance.textContent = complianceVerdict;
      teleCompliance.className = "text-xl md:text-2xl font-extrabold tracking-tight " + complianceColor;
      teleComplianceSub.textContent = complianceDetail;
      teleComplianceStatus.textContent = complianceVerdict.includes("COMPLIANT") && !complianceVerdict.includes("NON") ? "OSHA & ASME ACCEPTABLE" : "IMMEDIATE SHUTDOWN MANDATED";
      teleComplianceBadge.className = "mt-3 text-[11px] font-semibold flex items-center gap-1.5 " + complianceColor;

      // Analysis Text
      if (srv.flowRestrictionPercent >= 100) {
        analysisPrimaryHazard.textContent = "Catastrophic Pressure Vessel Rupture & Scald Blast: Plugged safety relief valve prevents steam discharge, causing uncontrollable pressure accumulation to metal bursting threshold (>85 PSI).";
        analysisMechanisms.textContent = "With zero relieving aperture, burner energy continuously converts water to steam. At 80+ PSI, tensile hoop stress across the jacket welds exceeds the ultimate tensile strength of fatigued 304 stainless steel, initiating energetic BLEVE explosive fracture.";
        analysisMitigation.textContent = "IMMEDIATE EMERGENCY SHUTDOWN: Cut gas supply shutoff valve. Clear kitchen personnel from the blast perimeter. Never attempt to remove a pipe plug under pressure. Replace entire relief valve with factory-certified ASME UV-stamped 50 PSI unit.";
      } else if (vacuum.implosionRiskPercent > 60) {
        analysisPrimaryHazard.textContent = "Atmospheric Pressure Vacuum Implosion & Inner Liner Collapse: Collapsing steam creates deep vacuum (-28 inHg) that crushes the thin hemispherical cooking liner inward.";
        analysisMechanisms.textContent = "Steam undergoes a 1,600-to-1 volumetric phase collapse during cooling. With the vacuum breaker calcified shut, external 14.7 PSI atmospheric pressure exceeds the elastic buckling threshold of the 0.1875\" stainless liner, warping the vessel permanently.";
        analysisMitigation.textContent = "Disassemble and de-lime vacuum relief breaker assembly. Clean internal seat with food-grade citric acid. Replace deformed vacuum disc or install new 1/2\" NPT bronze vacuum breaker.";
      } else if (isDryFiring) {
        analysisPrimaryHazard.textContent = "Bare-Metal Thermal Burnout & Thermal Shock Steam Flash: Low-water sensor defeated by scale allows burner to heat dry jacket steel past 550°C.";
        analysisMechanisms.textContent = "Mineral scale conducts current across the low-water probe, blinding the safety control board. The burner fires on dry stainless steel, causing severe micro-structural sensitization, grain coarsening, and catastrophic steam flash if cold water is introduced.";
        analysisMitigation.textContent = "De-energize kettle burner immediately. Allow vessel to cool naturally to ambient temperature (never add cold water to hot dry kettle). Pull low-water probe, remove scale with fine abrasive cloth, and inspect control relay.";
      } else {
        analysisPrimaryHazard.textContent = "Nominal Operating Status: Steam jacket pressure, relieving capacity, vacuum protection, and low-water cutoff operate within ASME Section VIII safety envelopes.";
        analysisMechanisms.textContent = "Natural convective circulation in the food matrix absorbs heat at design rates. Safety relief valve provides 100% discharge margin over burner steam generation with zero accumulation overshoot.";
        analysisMitigation.textContent = "Maintain routine monthly manual lift-lever testing of the safety relief valve. Verify distilled water charge sight glass level. Inspect low water cutoff probes annually.";
      }
    }

    // Presets Handlers
    presetGold.addEventListener('click', function() {
      kettleModelSelect.value = 'cleveland_kgl40_tilting';
      srvConditionSelect.value = 'pristine_asme_50psi';
      foodMatrixSelect.value = 'thin_aqueous_stock';
      vacuumBreakerSelect.value = 'operational_spring_loaded';
      lowWaterProbeSelect.value = 'clean_dual_electrode';
      firingRateSlider.value = '140000';
      dwellSlider.value = '5';
      chargeSlider.value = '85';
      batchVolumeSlider.value = '35';
      calculateModel();
    });

    presetOverpressure.addEventListener('click', function() {
      kettleModelSelect.value = 'vulcan_gl60_high_capacity';
      srvConditionSelect.value = 'severe_scale_choking';
      foodMatrixSelect.value = 'high_starch_polenta';
      vacuumBreakerSelect.value = 'partially_gummed_valve';
      lowWaterProbeSelect.value = 'clean_dual_electrode';
      firingRateSlider.value = '150000';
      dwellSlider.value = '25';
      chargeSlider.value = '90';
      batchVolumeSlider.value = '50';
      calculateModel();
    });

    presetImplosion.addEventListener('click', function() {
      kettleModelSelect.value = 'groen_ah1_40_stationary';
      srvConditionSelect.value = 'pristine_asme_50psi';
      foodMatrixSelect.value = 'thin_aqueous_stock';
      vacuumBreakerSelect.value = 'frozen_calcified_shut';
      lowWaterProbeSelect.value = 'clean_dual_electrode';
      firingRateSlider.value = '40000';
      dwellSlider.value = '0';
      chargeSlider.value = '80';
      batchVolumeSlider.value = '5';
      calculateModel();
    });

    presetBleve.addEventListener('click', function() {
      kettleModelSelect.value = 'aged_20yr_neglected_kettle';
      srvConditionSelect.value = 'plugged_seized_valve';
      foodMatrixSelect.value = 'high_starch_polenta';
      vacuumBreakerSelect.value = 'frozen_calcified_shut';
      lowWaterProbeSelect.value = 'mineral_scale_bridged';
      firingRateSlider.value = '140000';
      dwellSlider.value = '35';
      chargeSlider.value = '15';
      batchVolumeSlider.value = '20';
      calculateModel();
    });

    // Copy Report Handler
    btnCopyReport.addEventListener('click', function() {
      const reportText = [
        "==================================================================",
        "COMMERCIAL STEAM JACKET KETTLE ASME OVERPRESSURE & RELIEVING REPORT",
        "Generated by IsItKitchenSafe Autonomous Growth & Ops Engine",
        "==================================================================",
        "Kettle Model: " + kettleModelSelect.options[kettleModelSelect.selectedIndex].text,
        "ASME Relief Valve: " + srvConditionSelect.options[srvConditionSelect.selectedIndex].text,
        "Food Matrix: " + foodMatrixSelect.options[foodMatrixSelect.selectedIndex].text,
        "Vacuum Breaker: " + vacuumBreakerSelect.options[vacuumBreakerSelect.selectedIndex].text,
        "Low Water Probe: " + lowWaterProbeSelect.options[lowWaterProbeSelect.selectedIndex].text,
        "Burner Firing Input: " + firingRateVal.textContent,
        "Dwell Time (Closed Draw-off): " + dwellVal.textContent,
        "Water Charge Level: " + chargeVal.textContent,
        "Batch Fill Volume: " + batchVolumeVal.textContent,
        "------------------------------------------------------------------",
        "Operating Steam Pressure: " + telePressure.textContent,
        "Saturated Steam Temp: " + teleTemp.textContent,
        "Relieving Capacity Margin: " + teleRelieving.textContent + " (" + teleRelievingSub.textContent + ")",
        "Vacuum Protection: " + teleVacuum.textContent + " (" + teleVacuumSub.textContent + ")",
        "Low Water Cutoff Status: " + teleLowWater.textContent + " (" + teleLowWaterSub.textContent + ")",
        "BLEVE Blast Hazard Index: " + teleBleve.textContent + " (" + teleBleveSub.textContent + ")",
        "ASME & OSHA Compliance: " + teleCompliance.textContent + " - " + teleComplianceSub.textContent,
        "------------------------------------------------------------------",
        "Primary Risk: " + analysisPrimaryHazard.textContent,
        "Mechanism: " + analysisMechanisms.textContent,
        "Mitigation: " + analysisMitigation.textContent,
        "=================================================================="
      ].join('\n');

      navigator.clipboard.writeText(reportText).then(function() {
        copyFeedback.classList.remove('hidden');
        setTimeout(function() {
          copyFeedback.classList.add('hidden');
        }, 3000);
      });
    });

    // Attach Change Listeners
    [kettleModelSelect, srvConditionSelect, foodMatrixSelect, vacuumBreakerSelect, lowWaterProbeSelect].forEach(el => {
      el.addEventListener('change', calculateModel);
    });

    [firingRateSlider, dwellSlider, chargeSlider, batchVolumeSlider].forEach(el => {
      el.addEventListener('input', calculateModel);
    });

    // Initial calculation
    calculateModel();
  })();
</script>
