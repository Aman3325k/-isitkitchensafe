const d = DICTIONARY[lang];
---

<div class="not-prose my-8 p-6 sm:p-8 rounded-3xl bg-surface-card border border-hairline shadow-sm" id="conveyor-smoker-tool-root">
  <!-- Header Bar -->
  <div class="flex flex-wrap items-center justify-between gap-4 pb-6 border-b border-hairline">
    <div>
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-rose-600 text-white mb-2">
        {d.badge}
      </span>
      <h2 class="text-xl sm:text-2xl font-extrabold text-ink tracking-tight">
        {d.title}
      </h2>
      <p class="text-xs sm:text-sm text-muted mt-1 max-w-3xl leading-relaxed">
        {d.subtitle}
      </p>
    </div>

    <!-- Presets Selector -->
    <div class="w-full sm:w-auto">
      <label class="block text-xs font-bold uppercase tracking-wider text-muted mb-1">
        {d.presetsTitle}
      </label>
      <div class="grid grid-cols-2 sm:flex sm:flex-wrap gap-2">
        <button type="button" data-preset="brisket" class="px-3 py-1.5 rounded-lg bg-surface-soft hover:bg-surface-hover text-xs font-medium text-ink border border-hairline transition-colors">
          {d.presetBrisk}
        </button>
        <button type="button" data-preset="fouled" class="px-3 py-1.5 rounded-lg bg-surface-soft hover:bg-surface-hover text-xs font-medium text-ink border border-hairline transition-colors">
          {d.presetFouled}
        </button>
        <button type="button" data-preset="creosote" class="px-3 py-1.5 rounded-lg bg-surface-soft hover:bg-surface-hover text-xs font-medium text-ink border border-hairline transition-colors">
          {d.presetCreosote}
        </button>
        <button type="button" data-preset="poultry" class="px-3 py-1.5 rounded-lg bg-surface-soft hover:bg-surface-hover text-xs font-medium text-ink border border-hairline transition-colors">
          {d.presetPoultry}
        </button>
      </div>
    </div>
  </div>

  <!-- Interactive Controls Grid -->
  <div class="my-8">
    <div class="mb-4">
      <h3 class="text-base font-bold text-ink">
        {d.controlsTitle}
      </h3>
      <p class="text-xs text-muted">
        {d.controlsSub}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- 1. Smoker Architecture -->
      <div class="space-y-1">
        <label for="smoker-model-select" class="block text-xs font-bold text-ink">
          {d.smokerLabel}
        </label>
        <select id="smoker-model-select" class="w-full p-2.5 rounded-xl bg-surface-soft border border-hairline text-xs font-medium text-ink focus:ring-2 focus:ring-rose-500">
          {smokerData.smokerArchitectures.map(s => (
            <option value={s.id}>{s.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted leading-tight">{d.smokerHelp}</p>
      </div>

      <!-- 2. Wood Pellet Species -->
      <div class="space-y-1">
        <label for="wood-pellet-select" class="block text-xs font-bold text-ink">
          {d.woodLabel}
        </label>
        <select id="wood-pellet-select" class="w-full p-2.5 rounded-xl bg-surface-soft border border-hairline text-xs font-medium text-ink focus:ring-2 focus:ring-rose-500">
          {smokerData.woodPelletProfiles.map(w => (
            <option value={w.id}>{w.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted leading-tight">{d.woodHelp}</p>
      </div>

      <!-- 3. Smoking Chamber Temperature -->
      <div class="space-y-1">
        <div class="flex justify-between items-center text-xs">
          <label for="chamber-temp-input" class="font-bold text-ink">{d.tempLabel}</label>
          <span id="chamber-temp-val" class="font-mono font-bold text-rose-600">225 °F</span>
        </div>
        <input type="range" id="chamber-temp-input" min="180" max="325" step="5" value="225" class="w-full accent-rose-600 cursor-pointer" />
        <p class="text-[11px] text-muted leading-tight">{d.tempHelp}</p>
      </div>

      <!-- 4. Conveyor Transit Dwell Time -->
      <div class="space-y-1">
        <div class="flex justify-between items-center text-xs">
          <label for="transit-time-input" class="font-bold text-ink">{d.timeLabel}</label>
          <span id="transit-time-val" class="font-mono font-bold text-rose-600">6.0 hrs</span>
        </div>
        <input type="range" id="transit-time-input" min="1.0" max="14.0" step="0.5" value="6.0" class="w-full accent-rose-600 cursor-pointer" />
        <p class="text-[11px] text-muted leading-tight">{d.timeHelp}</p>
      </div>

      <!-- 5. Air-Fuel Stoichiometry (Lambda) -->
      <div class="space-y-1">
        <div class="flex justify-between items-center text-xs">
          <label for="lambda-input" class="font-bold text-ink">{d.lambdaLabel}</label>
          <span id="lambda-val" class="font-mono font-bold text-rose-600">1.10 (Lean)</span>
        </div>
        <input type="range" id="lambda-input" min="0.60" max="1.40" step="0.05" value="1.10" class="w-full accent-rose-600 cursor-pointer" />
        <p class="text-[11px] text-muted leading-tight">{d.lambdaHelp}</p>
      </div>

      <!-- 6. Meat Fat Cap Thickness -->
      <div class="space-y-1">
        <div class="flex justify-between items-center text-xs">
          <label for="fat-cap-input" class="font-bold text-ink">{d.fatCapLabel}</label>
          <span id="fat-cap-val" class="font-mono font-bold text-rose-600">6 mm</span>
        </div>
        <input type="range" id="fat-cap-input" min="0" max="15" step="1" value="6" class="w-full accent-rose-600 cursor-pointer" />
        <p class="text-[11px] text-muted leading-tight">{d.fatCapHelp}</p>
      </div>

      <!-- 7. Operating Days Without Flue Cleanout -->
      <div class="space-y-1">
        <div class="flex justify-between items-center text-xs">
          <label for="creosote-days-input" class="font-bold text-ink">{d.creosoteDaysLabel}</label>
          <span id="creosote-days-val" class="font-mono font-bold text-rose-600">14 days</span>
        </div>
        <input type="range" id="creosote-days-input" min="0" max="180" step="2" value="14" class="w-full accent-rose-600 cursor-pointer" />
        <p class="text-[11px] text-muted leading-tight">{d.creosoteDaysHelp}</p>
      </div>

      <!-- 8. Spark Arrestor & Quench State -->
      <div class="space-y-1">
        <label for="spark-arrestor-select" class="block text-xs font-bold text-ink">
          {d.sparkArrestorLabel}
        </label>
        <select id="spark-arrestor-select" class="w-full p-2.5 rounded-xl bg-surface-soft border border-hairline text-xs font-medium text-ink focus:ring-2 focus:ring-rose-500">
          <option value="clean_mist">Clean UL 1046 Baffle + Water Mist Header (Compliant)</option>
          <option value="tar_clogged">Tar-Clogged Baffle Screen (50% Airflow Choked)</option>
          <option value="bypassed_missing">Missing / Tampered Spark Screen (Illegal Bypass)</option>
        </select>
        <p class="text-[11px] text-muted leading-tight">{d.sparkArrestorHelp}</p>
      </div>
    </div>
  </div>

  <!-- Telemetry Cards Grid -->
  <div class="my-8 pt-6 border-t border-hairline">
    <div class="flex items-center justify-between gap-4 mb-4">
      <div>
        <h3 class="text-base font-bold text-ink">
          {d.diagnosticTitle}
        </h3>
        <p class="text-xs text-muted">
          {d.diagnosticSub}
        </p>
      </div>
      <button type="button" id="copy-telemetry-btn" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-surface-soft hover:bg-surface-hover text-xs font-semibold text-ink border border-hairline transition-colors">
        <svg class="w-4 h-4 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
        </svg>
        <span id="copy-btn-text">{d.copyReportBtn}</span>
      </button>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
      <!-- Metric 1: BaP -->
      <div class="p-4 rounded-2xl bg-surface-soft border border-hairline">
        <span class="block text-[11px] font-bold text-muted uppercase tracking-wider mb-1">
          {d.bapLabel}
        </span>
        <div class="flex items-baseline gap-1">
          <span id="metric-bap" class="text-2xl font-black text-ink">0.82</span>
          <span class="text-xs font-medium text-muted">μg/kg</span>
        </div>
        <span id="badge-bap" class="inline-block mt-2 px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/10 text-emerald-600">
          PASS (&lt;2.0 μg/kg)
        </span>
      </div>

      <!-- Metric 2: EFSA 4 Sum -->
      <div class="p-4 rounded-2xl bg-surface-soft border border-hairline">
        <span class="block text-[11px] font-bold text-muted uppercase tracking-wider mb-1">
          {d.efsa4Label}
        </span>
        <div class="flex items-baseline gap-1">
          <span id="metric-efsa4" class="text-2xl font-black text-ink">4.95</span>
          <span class="text-xs font-medium text-muted">μg/kg</span>
        </div>
        <span id="badge-efsa4" class="inline-block mt-2 px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/10 text-emerald-600">
          PASS (&lt;12.0 μg/kg)
        </span>
      </div>

      <!-- Metric 3: Chamber PAH Plume -->
      <div class="p-4 rounded-2xl bg-surface-soft border border-hairline">
        <span class="block text-[11px] font-bold text-muted uppercase tracking-wider mb-1">
          {d.chamberPahLabel}
        </span>
        <div class="flex items-baseline gap-1">
          <span id="metric-chamber-pah" class="text-2xl font-black text-ink">145</span>
          <span class="text-xs font-medium text-muted">μg/m³</span>
        </div>
        <span id="badge-chamber-pah" class="inline-block mt-2 px-2 py-0.5 rounded text-[10px] font-bold bg-blue-500/10 text-blue-600">
          OPTIMAL
        </span>
      </div>

      <!-- Metric 4: Flue Creosote Stage -->
      <div class="p-4 rounded-2xl bg-surface-soft border border-hairline">
        <span class="block text-[11px] font-bold text-muted uppercase tracking-wider mb-1">
          {d.creosoteLabel}
        </span>
        <div class="flex items-baseline gap-1">
          <span id="metric-creosote-mm" class="text-2xl font-black text-ink">0.8</span>
          <span class="text-xs font-medium text-muted">mm</span>
        </div>
        <span id="badge-creosote-stage" class="inline-block mt-2 px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/10 text-emerald-600">
          Stage 1 Soot
        </span>
      </div>

      <!-- Metric 5: NFPA 96 Fire Hazard -->
      <div class="p-4 rounded-2xl bg-surface-soft border border-hairline">
        <span class="block text-[11px] font-bold text-muted uppercase tracking-wider mb-1">
          {d.fireRiskLabel}
        </span>
        <div class="flex items-baseline gap-1">
          <span id="metric-fire-index" class="text-xl font-black text-emerald-600">LOW</span>
        </div>
        <span id="badge-spark-status" class="inline-block mt-2 px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/10 text-emerald-600">
          Arrestor Active
        </span>
      </div>

      <!-- Metric 6: Operator PPOM -->
      <div class="p-4 rounded-2xl bg-surface-soft border border-hairline">
        <span class="block text-[11px] font-bold text-muted uppercase tracking-wider mb-1">
          {d.workerPpomLabel}
        </span>
        <div class="flex items-baseline gap-1">
          <span id="metric-worker-ppom" class="text-2xl font-black text-ink">0.06</span>
          <span class="text-xs font-medium text-muted">mg/m³</span>
        </div>
        <span id="badge-worker-ppom" class="inline-block mt-2 px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/10 text-emerald-600">
          OSHA PEL OK
        </span>
      </div>
    </div>
  </div>

  <!-- Diagnostic Evaluation Callout Box -->
  <div class="my-6 p-5 sm:p-6 rounded-2xl bg-surface-soft border border-hairline">
    <div class="flex items-center justify-between gap-2 mb-3">
      <span class="text-xs font-bold text-muted uppercase tracking-wider">
        {d.complianceStatusLabel}
      </span>
      <span id="banner-compliance-badge" class="px-3 py-1 rounded-full text-xs font-bold bg-emerald-600 text-white">
        FULL COMPLIANCE (EFSA 2015/1125 &amp; NFPA 96)
      </span>
    </div>

    <div class="space-y-2 text-xs sm:text-sm text-ink leading-relaxed">
      <p>
        <strong class="text-rose-600">{d.primaryRiskLabel}</strong>
        <span id="diag-primary-risk" class="text-muted">
          Controlled combustion; Benzo[a]pyrene and EFSA 4 sum remain safely beneath European Food Safety Authority limits. Flue soot accumulation within normal monthly maintenance envelope.
        </span>
      </p>
      <p>
        <strong class="text-ink">{d.mechanismsLabel}</strong>
        <span id="diag-mechanisms" class="text-muted">
          Forced-draft excess air promotes oxidative cleavage of volatile lignin fragments. Syringol and guaiacol flavor profiles dominate over cyclized HACA pyrosynthesis. Thermophoretic soot deposition onto rendered surface lipid layer is moderated.
        </span>
      </p>
      <p>
        <strong class="text-ink">{d.mitigationLabel}</strong>
        <span id="diag-mitigation" class="text-muted">
          Maintain forced-draft pellet pot airflow (λ ≥ 1.05). Perform standard weekly spark baffle washing and schedule monthly rotary flue scraping per NFPA 96 Chapter 14.
        </span>
      </p>
    </div>
  </div>

  <!-- Scientific Reference & Formula Deep Dive -->
  <div class="my-8 pt-8 border-t border-hairline">
    <div class="mb-4">
      <h3 class="text-lg font-bold text-ink">
        {d.scienceTitle}
      </h3>
      <p class="text-xs text-muted">
        {d.scienceSub}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-6">
      <div class="p-5 rounded-2xl bg-surface-soft border border-hairline">
        <h4 class="text-sm font-bold text-ink mb-1">
          HACA Pyrosynthesis Ring-Closure Kinetics
        </h4>
        <div class="p-3 my-2 rounded-xl bg-surface font-mono text-xs text-ink border border-hairline/60">
          R<sub>HACA</sub> = k<sub>0</sub> &middot; exp(-E<sub>a</sub> / RT) &middot; [C<sub>2</sub>H<sub>2</sub>] &middot; [Aromatic&bull;] &middot; (1 - &lambda;)
        </div>
        <p class="text-xs text-muted leading-relaxed">
          The Hydrogen Abstraction C2H2 Addition (HACA) mechanism governs the sequential formation of 4-ring (Chrysene) and 5-ring (Benzo[a]pyrene) aromatic hydrocarbons from acetylene during oxygen-starved wood pellet pyrolysis above 350°C.
        </p>
      </div>

      <div class="p-5 rounded-2xl bg-surface-soft border border-hairline">
        <h4 class="text-sm font-bold text-ink mb-1">
          Junge-Pankow Gas-to-Particle Partitioning
        </h4>
        <div class="p-3 my-2 rounded-xl bg-surface font-mono text-xs text-ink border border-hairline/60">
          &Phi; = c &middot; &theta; / (p<sub>L</sub><sup>0</sup> + c &middot; &theta;) &emsp; &theta; = S<sub>part</sub> / V
        </div>
        <p class="text-xs text-muted leading-relaxed">
          As smoke cools from 400°C firebox to 110°C conveyor chamber, semi-volatile PAHs with low subcooled liquid vapor pressures (p<sub>L</sub><sup>0</sup>) rapidly condense onto submicron soot particulate surfaces, driving subsequent mass transfer into the meat bark fat layer.
        </p>
      </div>
    </div>

    <!-- Engineering Matrix Table -->
    <div class="mt-8">
      <h4 class="text-sm font-bold text-ink mb-1">
        {d.tableTitle}
      </h4>
      <p class="text-xs text-muted mb-3">
        {d.tableSub}
      </p>
      <div class="overflow-x-auto rounded-2xl border border-hairline">
        <table class="w-full text-left text-xs">
          <thead class="bg-surface-soft border-b border-hairline text-muted font-bold uppercase tracking-wider text-[11px]">
            <tr>
              <th class="p-3">{d.colModel}</th>
              <th class="p-3">{d.colClass}</th>
              <th class="p-3">{d.colVolume}</th>
              <th class="p-3">{d.colBelt}</th>
              <th class="p-3">{d.colBurner}</th>
              <th class="p-3">{d.colAirflow}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-hairline">
            {smokerData.smokerArchitectures.map(s => (
              <tr class="hover:bg-surface-hover/50 transition-colors">
                <td class="p-3 font-semibold text-ink">{s.name}</td>
                <td class="p-3 text-muted">{s.classification}</td>
                <td class="p-3 font-mono text-ink">{s.chamberVolumeCuFt} ft³</td>
                <td class="p-3 text-muted">{s.beltWidthInches}" &times; {s.beltTravelLengthFt} ft</td>
                <td class="p-3 text-muted">{s.burners}</td>
                <td class="p-3 font-mono text-ink">{s.airflowCfm} CFM</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Mandatory Directives Grid -->
    <div class="mt-8 pt-6 border-t border-hairline">
      <h4 class="text-sm font-bold text-ink mb-1">
        {d.rulesTitle}
      </h4>
      <p class="text-xs text-muted mb-4">
        {d.rulesSub}
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
          <h5 class="text-xs font-bold text-ink mb-1">{d.rule1Title}</h5>
          <p class="text-xs text-muted leading-relaxed">{d.rule1Text}</p>
        </div>
        <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
          <h5 class="text-xs font-bold text-ink mb-1">{d.rule2Title}</h5>
          <p class="text-xs text-muted leading-relaxed">{d.rule2Text}</p>
        </div>
        <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
          <h5 class="text-xs font-bold text-ink mb-1">{d.rule3Title}</h5>
          <p class="text-xs text-muted leading-relaxed">{d.rule3Text}</p>
        </div>
        <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
          <h5 class="text-xs font-bold text-ink mb-1">{d.rule4Title}</h5>
          <p class="text-xs text-muted leading-relaxed">{d.rule4Text}</p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import smokerData from '../data/conveyor-smoker-pah-data.json';

  function initSmokerModeler() {
    const root = document.getElementById('conveyor-smoker-tool-root');
    if (!root) return;

    // Elements
    const smokerSelect = document.getElementById('smoker-model-select') as HTMLSelectElement;
    const woodSelect = document.getElementById('wood-pellet-select') as HTMLSelectElement;
    const tempInput = document.getElementById('chamber-temp-input') as HTMLInputElement;
    const tempVal = document.getElementById('chamber-temp-val');
    const timeInput = document.getElementById('transit-time-input') as HTMLInputElement;
    const timeVal = document.getElementById('transit-time-val');
    const lambdaInput = document.getElementById('lambda-input') as HTMLInputElement;
    const lambdaVal = document.getElementById('lambda-val');
    const fatCapInput = document.getElementById('fat-cap-input') as HTMLInputElement;
    const fatCapVal = document.getElementById('fat-cap-val');
    const creosoteDaysInput = document.getElementById('creosote-days-input') as HTMLInputElement;
    const creosoteDaysVal = document.getElementById('creosote-days-val');
    const sparkSelect = document.getElementById('spark-arrestor-select') as HTMLSelectElement;

    // Metrics
    const metricBap = document.getElementById('metric-bap');
    const badgeBap = document.getElementById('badge-bap');
    const metricEfsa4 = document.getElementById('metric-efsa4');
    const badgeEfsa4 = document.getElementById('badge-efsa4');
    const metricChamberPah = document.getElementById('metric-chamber-pah');
    const badgeChamberPah = document.getElementById('badge-chamber-pah');
    const metricCreosoteMm = document.getElementById('metric-creosote-mm');
    const badgeCreosoteStage = document.getElementById('badge-creosote-stage');
    const metricFireIndex = document.getElementById('metric-fire-index');
    const badgeSparkStatus = document.getElementById('badge-spark-status');
    const metricWorkerPpom = document.getElementById('metric-worker-ppom');
    const badgeWorkerPpom = document.getElementById('badge-worker-ppom');

    // Diagnostic Banner
    const complianceBadge = document.getElementById('banner-compliance-badge');
    const diagPrimaryRisk = document.getElementById('diag-primary-risk');
    const diagMechanisms = document.getElementById('diag-mechanisms');
    const diagMitigation = document.getElementById('diag-mitigation');

    // Copy Button
    const copyBtn = document.getElementById('copy-telemetry-btn');
    const copyText = document.getElementById('copy-btn-text');

    function calculate() {
      const smokerId = smokerSelect.value;
      const woodId = woodSelect.value;
      const chamberTempF = parseFloat(tempInput.value);
      const transitHours = parseFloat(timeInput.value);
      const lambda = parseFloat(lambdaInput.value);
      const fatCapMm = parseFloat(fatCapInput.value);
      const creosoteDays = parseFloat(creosoteDaysInput.value);
      const sparkState = sparkSelect.value;

      // Update Labels
      if (tempVal) tempVal.textContent = `${chamberTempF} °F`;
      if (timeVal) timeVal.textContent = `${transitHours.toFixed(1)} hrs`;
      if (lambdaVal) {
        let label = 'Stoichiometric';
        if (lambda < 0.95) label = 'Rich / Smoldering';
        else if (lambda > 1.05) label = 'Lean / Forced Draft';
        lambdaVal.textContent = `${lambda.toFixed(2)} (${label})`;
      }
      if (fatCapVal) fatCapVal.textContent = `${fatCapMm} mm`;
      if (creosoteDaysVal) creosoteDaysVal.textContent = `${creosoteDays} days`;

      // Find datasets
      const smoker = smokerData.smokerArchitectures.find(s => s.id === smokerId) || smokerData.smokerArchitectures[0];
      const wood = smokerData.woodPelletProfiles.find(w => w.id === woodId) || smokerData.woodPelletProfiles[0];

      // 1. Firebox PAH Generation (HACA Mechanism)
      // Lignin multiplier relative to baseline 24%
      const ligninFactor = wood.ligninContentPct / 24.0;
      // Oxygen starvation factor: if lambda < 1.0, formation multiplies exponentially
      let oxygenFactor = 1.0;
      if (lambda < 1.0) {
        oxygenFactor = 1.0 + Math.pow((1.0 - lambda) * 4.2, 1.8);
      } else {
        oxygenFactor = Math.max(0.4, 1.0 - (lambda - 1.0) * 0.7);
      }

      // Pyrolysis temperature response curve centered around 420°C
      const fireboxTempC = wood.pyrolysisTempOptimalC;
      const thermalFactor = Math.exp(-Math.pow(fireboxTempC - 410, 2) / 32000);

      // Raw smoke chamber PAH aerosol concentration (μg/m³)
      const baseChamberPah = 120.0;
      const chamberPah = baseChamberPah * ligninFactor * oxygenFactor * thermalFactor * (smoker.smokeRecirculationPct / 45.0);

      // 2. Meat Bark Deposition & Partitioning
      // Chamber temp effect: lower temp increases gas-to-particle condensation (Junge-Pankow)
      const condensationFactor = 1.0 + Math.max(0, (260 - chamberTempF) / 100);
      // Fat cap lipophilic uptake: fat absorbs PAHs with high partition coefficient
      const fatFactor = 1.0 + (fatCapMm / 15.0) * 1.35;
      // Transit time accumulation (saturation curve)
      const timeSaturation = 1.0 - Math.exp(-transitHours / 5.2);

      // Meat BaP concentration (μg/kg wet weight) - EFSA limit is 2.0 μg/kg
      const baseBaP = 0.42;
      const meatBaP = baseBaP * (chamberPah / 100.0) * condensationFactor * fatFactor * (timeSaturation * 2.8);
      
      // Sum of EFSA 4 PAHs: typically 5.4x to 6.8x BaP depending on wood resin
      const efsa4Ratio = 5.2 + (wood.ligninContentPct / 10.0);
      const meatEfsa4 = meatBaP * efsa4Ratio;

      // 3. Flue Creosote Accumulation
      // Creosote accumulation rate in oz/hr
      const baseCreosoteOzHr = smoker.creosoteAccumulationRateOzHr;
      const creosoteWoodFactor = wood.ligninContentPct / 22.0;
      const creosoteSmokeFactor = (lambda < 1.0) ? (1.0 + (1.0 - lambda) * 2.0) : 0.85;
      const dailyOzAccum = baseCreosoteOzHr * 14.0 * creosoteWoodFactor * creosoteSmokeFactor;
      const totalOzAccum = (dailyOzAccum * creosoteDays) / 16.0; // lbs

      // Thickness in mm (approx 0.12 mm per operating week under standard load)
      let creosoteThicknessMm = (creosoteDays * 0.055) * (creosoteWoodFactor * creosoteSmokeFactor);
      if (smoker.id === 'unmaintained_soot_choked_conveyor_pit') {
        creosoteThicknessMm += 2.8;
      }

      // Stage classification
      let creosoteStage = 'Stage 1: Flaky Soot';
      let creosoteColor = 'emerald';
      if (creosoteThicknessMm >= 3.18) {
        creosoteStage = 'Stage 3: Glazed Pitch (Hazard)';
        creosoteColor = 'rose';
      } else if (creosoteThicknessMm >= 1.27) {
        creosoteStage = 'Stage 2: Tarry Crust (Warning)';
        creosoteColor = 'amber';
      }

      // 4. Fire Hazard Rating
      let fireHazard = 'LOW';
      let fireColor = 'emerald';
      let sparkBadgeText = 'Arrestor Active';
      let sparkBadgeColor = 'emerald';

      if (sparkState === 'bypassed_missing') {
        sparkBadgeText = 'ARRESTOR MISSING';
        sparkBadgeColor = 'rose';
        fireHazard = creosoteThicknessMm > 1.27 ? 'CRITICAL DEFECT' : 'HIGH';
        fireColor = 'rose';
      } else if (sparkState === 'tar_clogged') {
        sparkBadgeText = 'Arrestor Clogged';
        sparkBadgeColor = 'amber';
        fireHazard = creosoteThicknessMm > 2.0 ? 'SEVERE RISK' : 'MODERATE';
        fireColor = 'amber';
      } else {
        if (creosoteThicknessMm >= 3.18) {
          fireHazard = 'HIGH FLUE RISK';
          fireColor = 'amber';
        }
      }

      // 5. Worker Breathing Zone PPOM (mg/m³) - OSHA PEL is 0.20 mg/m³
      const roomDraftLoss = (4500 - smoker.airflowCfm) / 4500;
      const workerPpom = Math.max(0.02, 0.04 + (chamberPah / 2500.0) * Math.max(0.2, roomDraftLoss) * (lambda < 0.9 ? 1.8 : 1.0));

      // Render Telemetry
      if (metricBap) metricBap.textContent = meatBaP.toFixed(2);
      if (badgeBap) {
        if (meatBaP > 2.0) {
          badgeBap.textContent = 'FAIL (>2.0 μg/kg)';
          badgeBap.className = 'inline-block mt-2 px-2 py-0.5 rounded text-[10px] font-bold bg-rose-500/10 text-rose-600';
        } else if (meatBaP > 1.5) {
          badgeBap.textContent = 'MARGINAL (<2.0 μg/kg)';
          badgeBap.className = 'inline-block mt-2 px-2 py-0.5 rounded text-[10px] font-bold bg-amber-500/10 text-amber-600';
        } else {
          badgeBap.textContent = 'PASS (<2.0 μg/kg)';
          badgeBap.className = 'inline-block mt-2 px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/10 text-emerald-600';
        }
      }

      if (metricEfsa4) metricEfsa4.textContent = meatEfsa4.toFixed(2);
      if (badgeEfsa4) {
        if (meatEfsa4 > 12.0) {
          badgeEfsa4.textContent = 'FAIL (>12.0 μg/kg)';
          badgeEfsa4.className = 'inline-block mt-2 px-2 py-0.5 rounded text-[10px] font-bold bg-rose-500/10 text-rose-600';
        } else if (meatEfsa4 > 9.0) {
          badgeEfsa4.textContent = 'MARGINAL (<12.0 μg/kg)';
          badgeEfsa4.className = 'inline-block mt-2 px-2 py-0.5 rounded text-[10px] font-bold bg-amber-500/10 text-amber-600';
        } else {
          badgeEfsa4.textContent = 'PASS (<12.0 μg/kg)';
          badgeEfsa4.className = 'inline-block mt-2 px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/10 text-emerald-600';
        }
      }

      if (metricChamberPah) metricChamberPah.textContent = Math.round(chamberPah).toString();
      if (badgeChamberPah) {
        if (chamberPah > 300) {
          badgeChamberPah.textContent = 'HEAVY SOOT DENSE';
          badgeChamberPah.className = 'inline-block mt-2 px-2 py-0.5 rounded text-[10px] font-bold bg-rose-500/10 text-rose-600';
        } else if (chamberPah > 180) {
          badgeChamberPah.textContent = 'ELEVATED PLUME';
          badgeChamberPah.className = 'inline-block mt-2 px-2 py-0.5 rounded text-[10px] font-bold bg-amber-500/10 text-amber-600';
        } else {
          badgeChamberPah.textContent = 'CLEAN SMOKE PLUME';
          badgeChamberPah.className = 'inline-block mt-2 px-2 py-0.5 rounded text-[10px] font-bold bg-blue-500/10 text-blue-600';
        }
      }

      if (metricCreosoteMm) metricCreosoteMm.textContent = creosoteThicknessMm.toFixed(2);
      if (badgeCreosoteStage) {
        badgeCreosoteStage.textContent = creosoteStage;
        badgeCreosoteStage.className = `inline-block mt-2 px-2 py-0.5 rounded text-[10px] font-bold bg-${creosoteColor}-500/10 text-${creosoteColor}-600`;
      }

      if (metricFireIndex) {
        metricFireIndex.textContent = fireHazard;
        metricFireIndex.className = `text-xl font-black text-${fireColor}-600`;
      }
      if (badgeSparkStatus) {
        badgeSparkStatus.textContent = sparkBadgeText;
        badgeSparkStatus.className = `inline-block mt-2 px-2 py-0.5 rounded text-[10px] font-bold bg-${sparkBadgeColor}-500/10 text-${sparkBadgeColor}-600`;
      }

      if (metricWorkerPpom) metricWorkerPpom.textContent = workerPpom.toFixed(2);
      if (badgeWorkerPpom) {
        if (workerPpom > 0.20) {
          badgeWorkerPpom.textContent = 'OSHA PEL EXCEEDED';
          badgeWorkerPpom.className = 'inline-block mt-2 px-2 py-0.5 rounded text-[10px] font-bold bg-rose-500/10 text-rose-600';
        } else {
          badgeWorkerPpom.textContent = 'OSHA PEL OK';
          badgeWorkerPpom.className = 'inline-block mt-2 px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/10 text-emerald-600';
        }
      }

      // Comprehensive Compliance Banner & Diagnostic Guidance
      const isEfsaPassing = meatBaP <= 2.0 && meatEfsa4 <= 12.0;
      const isFireSafe = fireHazard === 'LOW' && creosoteThicknessMm < 3.18 && sparkState === 'clean_mist';
      const isWorkerSafe = workerPpom <= 0.20;

      if (complianceBadge) {
        if (isEfsaPassing && isFireSafe && isWorkerSafe) {
          complianceBadge.textContent = 'FULL COMPLIANCE (EFSA 2015/1125 & NFPA 96)';
          complianceBadge.className = 'px-3 py-1 rounded-full text-xs font-bold bg-emerald-600 text-white';
        } else if (!isEfsaPassing && isFireSafe) {
          complianceBadge.textContent = 'NON-COMPLIANT: TOXICOLOGICAL PAH EXCEEDANCE';
          complianceBadge.className = 'px-3 py-1 rounded-full text-xs font-bold bg-rose-600 text-white';
        } else if (!isFireSafe) {
          complianceBadge.textContent = 'NON-COMPLIANT: NFPA 96 CHIMNEY FIRE HAZARD';
          complianceBadge.className = 'px-3 py-1 rounded-full text-xs font-bold bg-rose-700 text-white';
        } else {
          complianceBadge.textContent = 'WARNING: OCCUPATIONAL HEALTH THRESHOLD BREACH';
          complianceBadge.className = 'px-3 py-1 rounded-full text-xs font-bold bg-amber-600 text-white';
        }
      }

      if (diagPrimaryRisk && diagMechanisms && diagMitigation) {
        if (!isEfsaPassing) {
          diagPrimaryRisk.textContent = `Carcinogenic Benzo[a]pyrene (${meatBaP.toFixed(2)} μg/kg) or EFSA 4 sum (${meatEfsa4.toFixed(2)} μg/kg) exceeds statutory EU limits. Product violates food safety standards.`;
          diagMechanisms.textContent = `Severe oxygen starvation (λ = ${lambda.toFixed(2)}) drives radical acetylene HACA cyclization in ${wood.name}. High fat cap (${fatCapMm} mm) acts as a lipophilic sink for condensable aromatic aerosols over ${transitHours.toFixed(1)} transit hours.`;
          diagMitigation.textContent = 'Immediately increase forced-draft blower air (λ ≥ 1.05), reduce dwell time under direct smoke, trim excessive subcutaneous fat, or transition to lower-lignin hardwood pellets (e.g. Texas Post Oak or Applewood).';
        } else if (!isFireSafe) {
          diagPrimaryRisk.textContent = `Chimney autoignition hazard detected. Flue creosote thickness (${creosoteThicknessMm.toFixed(2)} mm) exceeds NFPA 96 Chapter 14 limits or spark arrestor is compromised.`;
          diagMechanisms.textContent = `Condensed pyroligneous acids and wood tar have accumulated over ${creosoteDays} operating days. Saturated creosote auto-ignites at 450°C and can ignite roof structures with 1,100°C flue fires.`;
          diagMitigation.textContent = 'Shut down conveyor smoker immediately. Perform complete mechanical rotary duct scraping and restore UL 1046 certified spark arrestor with functioning water mist quench header.';
        } else {
          diagPrimaryRisk.textContent = 'Controlled combustion; Benzo[a]pyrene and EFSA 4 sum remain safely beneath European Food Safety Authority limits. Flue soot accumulation within normal monthly maintenance envelope.';
          diagMechanisms.textContent = 'Forced-draft excess air promotes oxidative cleavage of volatile lignin fragments. Syringol and guaiacol flavor profiles dominate over cyclized HACA pyrosynthesis. Thermophoretic soot deposition onto rendered surface lipid layer is moderated.';
          diagMitigation.textContent = 'Maintain forced-draft pellet pot airflow (λ ≥ 1.05). Perform standard weekly spark baffle washing and schedule monthly rotary flue scraping per NFPA 96 Chapter 14.';
        }
      }
    }

    // Attach Event Listeners
    [smokerSelect, woodSelect, tempInput, timeInput, lambdaInput, fatCapInput, creosoteDaysInput, sparkSelect].forEach(el => {
      if (el) el.addEventListener('input', calculate);
    });

    // Preset handlers
    const presetBtns = root.querySelectorAll('button[data-preset]');
    presetBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const p = btn.getAttribute('data-preset');
        if (p === 'brisket') {
          smokerSelect.value = 'industrial_continuous_mesh_conveyor_smoker';
          woodSelect.value = 'post_oak_hardwood_pellets';
          tempInput.value = '225';
          timeInput.value = '8.0';
          lambdaInput.value = '1.15';
          fatCapInput.value = '6';
          creosoteDaysInput.value = '10';
          sparkSelect.value = 'clean_mist';
        } else if (p === 'fouled') {
          smokerSelect.value = 'commercial_carousel_rotary_conveyor_smoker';
          woodSelect.value = 'hickory_hardwood_pellets';
          tempInput.value = '210';
          timeInput.value = '12.0';
          lambdaInput.value = '0.65';
          fatCapInput.value = '12';
          creosoteDaysInput.value = '45';
          sparkSelect.value = 'clean_mist';
        } else if (p === 'creosote') {
          smokerSelect.value = 'unmaintained_soot_choked_conveyor_pit';
          woodSelect.value = 'mesquite_hardwood_pellets';
          tempInput.value = '260';
          timeInput.value = '6.0';
          lambdaInput.value = '0.75';
          fatCapInput.value = '8';
          creosoteDaysInput.value = '90';
          sparkSelect.value = 'tar_clogged';
        } else if (p === 'poultry') {
          smokerSelect.value = 'compact_countertop_conveyor_charcuterie_smoker';
          woodSelect.value = 'applewood_fruitwood_pellets';
          tempInput.value = '240';
          timeInput.value = '2.5';
          lambdaInput.value = '1.20';
          fatCapInput.value = '1';
          creosoteDaysInput.value = '5';
          sparkSelect.value = 'clean_mist';
        }
        calculate();
      });
    });

    // Copy Telemetry
    if (copyBtn && copyText) {
      copyBtn.addEventListener('click', () => {
        const report = `=== COMMERCIAL CONVEYOR SMOKER PAH & CREOSOTE TELEMETRY ===
Smoker Model: ${smokerSelect.options[smokerSelect.selectedIndex].text}
Wood Pellet Fuel: ${woodSelect.options[woodSelect.selectedIndex].text}
Chamber Temperature: ${tempInput.value} °F
Transit Dwell Time: ${timeInput.value} Hours
Air-Fuel Stoichiometry (Lambda): ${lambdaInput.value}
Meat Fat Cap: ${fatCapInput.value} mm
Days Since Flue Sweep: ${creosoteDaysInput.value} Days
Spark Arrestor: ${sparkSelect.options[sparkSelect.selectedIndex].text}

-- RESULTS --
Meat Bark Benzo[a]pyrene (BaP): ${metricBap?.textContent} μg/kg (EFSA Limit: 2.0 μg/kg)
Sum of EFSA 4 PAHs: ${metricEfsa4?.textContent} μg/kg (EFSA Limit: 12.0 μg/kg)
Chamber Smoke Plume PAH: ${metricChamberPah?.textContent} μg/m³
Flue Creosote Thickness: ${metricCreosoteMm?.textContent} mm (${badgeCreosoteStage?.textContent})
Flue Fire Hazard Rating: ${metricFireIndex?.textContent}
Worker Breathing Zone PPOM: ${metricWorkerPpom?.textContent} mg/m³ (OSHA PEL: 0.20 mg/m³)
Compliance Status: ${complianceBadge?.textContent}
===========================================================`;

        navigator.clipboard.writeText(report).then(() => {
          const original = copyText.textContent;
          copyText.textContent = 'Copied!';
          setTimeout(() => {
            copyText.textContent = original;
          }, 2000);
        });
      });
    }

    // Initial run
    calculate();
  }

  document.addEventListener('DOMContentLoaded', initSmokerModeler);
  initSmokerModeler();
</script>
