---
import rawData from '../data/moldy-food-safety-data.json';
import type { SupportedLanguage } from '../i18n/ui';
import { useTranslatedPath } from '../i18n/utils';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;
const translatePath = useTranslatedPath(lang);

const pantryUrl = translatePath('/tools/pantry-dry-goods-shelf-life-checker/');
const fridgeZoneUrl = translatePath('/tools/fridge-organization-zone-planner/');
const leftoverUrl = translatePath('/tools/leftover-shelf-life-calculator/');
const methodologyUrl = translatePath('/methodology/');
const allToolsUrl = translatePath('/tools/');

type MoldCategory = 'cheeses-dairy' | 'meats-deli' | 'bread-baked' | 'produce-fruits' | 'pantry-spreads';
type MoldVerdict = 'cut-around' | 'discard';
type MoistureLevel = 'low-dense' | 'medium-porous' | 'high-moisture';
type MycotoxinRisk = 'low-surface' | 'moderate' | 'high';

interface LocalizedFood {
  id: string;
  icon: string;
  category: MoldCategory;
  verdict: MoldVerdict;
  moistureLevel: MoistureLevel;
  mycotoxinRisk: MycotoxinRisk;
  keywords: string;
  name: string;
  examples: string;
  verdictHeadline: string;
  usdaScience: string;
  handlingSteps: string[];
  ateABiteNote: string;
}

interface SafetyRule {
  icon: string;
  title: string;
  body: string;
}

const safetyBanner =
  (rawData.safetyRulesBanner as Record<string, { badge: string; headline: string; rules: SafetyRule[] }>)[lang] ||
  rawData.safetyRulesBanner.en;

const localizedFoods: LocalizedFood[] = rawData.foods.map((item) => {
  const tr = (item.i18n as Record<string, any>)[lang] || item.i18n.en;
  return {
    id: item.id,
    icon: item.icon,
    category: item.category as MoldCategory,
    verdict: item.verdict as MoldVerdict,
    moistureLevel: item.moistureLevel as MoistureLevel,
    mycotoxinRisk: item.mycotoxinRisk as MycotoxinRisk,
    keywords: `${item.keywords} ${tr.name} ${tr.examples} ${tr.verdictHeadline} ${tr.usdaScience}`.toLowerCase(),
    name: tr.name,
    examples: tr.examples,
    verdictHeadline: tr.verdictHeadline,
    usdaScience: tr.usdaScience,
    handlingSteps: tr.handlingSteps as string[],
    ateABiteNote: tr.ateABiteNote
  };
});

const localizedFaqs: Array<{ question: string; answer: string }> =
  (rawData.faqs as Record<string, Array<{ question: string; answer: string }>>)[lang] ||
  rawData.faqs.en;

const counts = {
  all: localizedFoods.length,
  cutAround: localizedFoods.filter((f) => f.verdict === 'cut-around').length,
  discard: localizedFoods.filter((f) => f.verdict === 'discard').length,
  cheesesDairy: localizedFoods.filter((f) => f.category === 'cheeses-dairy').length,
  meatsDeli: localizedFoods.filter((f) => f.category === 'meats-deli').length,
  breadBaked: localizedFoods.filter((f) => f.category === 'bread-baked').length,
  produceFruits: localizedFoods.filter((f) => f.category === 'produce-fruits').length,
  pantrySpreads: localizedFoods.filter((f) => f.category === 'pantry-spreads').length
};

