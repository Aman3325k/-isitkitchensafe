  }
};

const t = UI[lang] || UI.en;
const defaultFood = localizedFoods[0];

function getCategoryLabel(cat: MoldCategory): string {
  if (cat === 'cheeses-dairy') return t.catCheeses;
  if (cat === 'meats-deli') return t.catMeats;
  if (cat === 'bread-baked') return t.catBread;
  if (cat === 'produce-fruits') return t.catProduce;
  return t.catPantry;
}

function getVerdictPillClass(verdict: MoldVerdict): string {
  return verdict === 'cut-around' ? 'badge-yes' : 'badge-no';
}

function getVerdictLabel(verdict: MoldVerdict): string {
  return verdict === 'cut-around' ? t.verdictCutBadge : t.verdictDiscardBadge;
}

function getMoistureLabel(level: MoistureLevel): string {
  if (level === 'low-dense') return t.moistureLowDense;
  if (level === 'medium-porous') return t.moistureMediumPorous;
  return t.moistureHigh;
}

function getMycotoxinLabel(risk: MycotoxinRisk): string {
  if (risk === 'low-surface') return t.mycotoxinLow;
  if (risk === 'moderate') return t.mycotoxinModerate;
  return t.mycotoxinHigh;
}

function getMycotoxinBadgeClass(risk: MycotoxinRisk): string {
  if (risk === 'low-surface') return 'bg-emerald-500/20 text-emerald-200 border-emerald-400/40';
  if (risk === 'moderate') return 'bg-amber-500/20 text-amber-200 border-amber-400/40';
  return 'bg-red-500/20 text-red-200 border-red-400/40';
}

function getCardBorderAccent(verdict: MoldVerdict): string {
  return verdict === 'cut-around'
    ? 'border-l-4 border-l-success-border'
    : 'border-l-4 border-l-error-border';
}

const clientPayload = {
  totalCount: localizedFoods.length,
  foods: localizedFoods,
  rules: safetyBanner.rules,
  ui: {
    copyBtn: t.copyBtn,
    copiedBtn: t.copiedBtn,
    verdictCutBadge: t.verdictCutBadge,
    verdictDiscardBadge: t.verdictDiscardBadge,
    moistureLabel: t.moistureLabel,
    moistureLowDense: t.moistureLowDense,
    moistureMediumPorous: t.moistureMediumPorous,
    moistureHigh: t.moistureHigh,
    mycotoxinLabel: t.mycotoxinLabel,
    mycotoxinLow: t.mycotoxinLow,
    mycotoxinModerate: t.mycotoxinModerate,
    mycotoxinHigh: t.mycotoxinHigh,
    showingPrefix: t.showingPrefix,
    showingOf: t.showingOf,
    showingSuffix: t.showingSuffix,
    cardInspectHint: t.cardInspectHint,
    cardSelectedLabel: t.cardSelectedLabel,
    chartHeader: t.chartHeader,
    chartSafeHeading: t.chartSafeHeading,
    chartDiscardHeading: t.chartDiscardHeading,
    chartRulesHeading: t.chartRulesHeading,
    chartSelectedHeading: t.chartSelectedHeading
  }
};
---

<div id="moldy-food-checker-root" class="space-y-12">
  <!-- Critical USDA Safety Rules Banner -->
  <aside
    class="p-5 sm:p-6 rounded-2xl bg-error-bg/65 dark:bg-red-950/35 border-2 border-error-border/80 shadow-sm space-y-4"
    role="note"
    aria-label={safetyBanner.badge}
  >
    <div class="space-y-1">
      <span class="inline-block px-2.5 py-0.5 rounded-full text-[11px] font-extrabold uppercase tracking-wider bg-error-border text-white">
        ⚠️ {safetyBanner.badge}
      </span>
      <h2 class="text-base sm:text-lg font-extrabold text-ink leading-snug">
        {safetyBanner.headline}
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      {safetyBanner.rules.map((rule) => (
        <div class="p-3.5 rounded-xl bg-canvas border border-hairline shadow-xs space-y-1.5">
          <div class="flex items-start gap-2">
            <span aria-hidden="true" class="text-lg leading-none mt-0.5 shrink-0">{rule.icon}</span>
            <h3 class="text-xs sm:text-[13px] font-extrabold text-ink leading-snug">{rule.title}</h3>
          </div>
          <p class="text-xs text-body leading-relaxed">{rule.body}</p>
        </div>
      ))}
    </div>
  </aside>

  <!-- Main Interactive Checker Card -->
  <section
    id="moldy-food-safety-checker"
    class="bg-canvas border border-hairline rounded-2xl shadow-sm overflow-hidden"
    aria-label={t.ariaLabel}
  >
    <script type="application/json" id="mfsc-payload" set:html={JSON.stringify(clientPayload)} />

    <!-- PART 1: Header Actions + High-Contrast Dark USDA Mold Verdict Inspector -->
    <div class="p-5 sm:p-6 border-b border-hairline bg-surface-soft/50 space-y-5">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div class="space-y-1 max-w-2xl">
          <span class="inline-block px-2.5 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wider bg-signature-coral text-white">
            🔬 {t.inspectorBadge}
          </span>
          <h2 class="text-title-md font-bold text-ink">{t.inspectorTitle}</h2>
          <p class="text-xs sm:text-[13px] text-muted leading-relaxed">{t.inspectorSub}</p>
        </div>

        <div class="flex flex-wrap items-center gap-2 print:hidden">
          <button
            type="button"
            id="mfsc-copy-btn"
            class="min-h-[40px] px-3.5 py-2 rounded-xl text-xs font-semibold bg-primary text-on-primary hover:bg-primary-active transition-colors cursor-pointer shadow-sm"
          >
            <span id="mfsc-copy-label">📋 {t.copyBtn}</span>
          </button>
          <button
            type="button"
            id="mfsc-print-btn"
            class="min-h-[40px] px-3.5 py-2 rounded-xl text-xs font-semibold bg-canvas text-ink border border-hairline hover:border-signature-coral transition-colors cursor-pointer"
          >
            🖨️ {t.printBtn}
          </button>
          <button
            type="button"
            id="mfsc-reset-btn"
            class="min-h-[40px] px-3 py-2 rounded-xl text-xs font-semibold bg-canvas text-muted border border-hairline hover:border-border-strong hover:text-ink transition-colors cursor-pointer"
          >
            {t.resetBtn}
          </button>
        </div>
      </div>

      <!-- High-Contrast Dark USDA Mold Verdict Inspector -->
      <div
        id="mfsc-verdict-inspector"
        aria-live="polite"
        class={`w-full rounded-2xl bg-surface-dark text-on-dark p-5 sm:p-6 space-y-4 shadow-sm border-l-4 ${
          defaultFood.verdict === 'cut-around' ? 'border-success-border' : 'border-error-border'
        }`}
      >
        <div class="flex flex-wrap items-center justify-between gap-2.5">
          <div class="flex flex-wrap items-center gap-2">
            <span id="mfsc-dash-pill" class={getVerdictPillClass(defaultFood.verdict)}>
              {getVerdictLabel(defaultFood.verdict)}
            </span>
            <span
              id="mfsc-dash-moisture"
              class="inline-flex items-center px-2.5 py-0.5 rounded-md border text-[11px] font-bold bg-white/10 text-white/90 border-white/20"
            >
              💧 {t.moistureLabel}: {getMoistureLabel(defaultFood.moistureLevel)}
            </span>
            <span
              id="mfsc-dash-mycotoxin"
              class={`inline-flex items-center px-2.5 py-0.5 rounded-md border text-[11px] font-bold ${getMycotoxinBadgeClass(defaultFood.mycotoxinRisk)}`}
            >
              ☣️ {t.mycotoxinLabel}: {getMycotoxinLabel(defaultFood.mycotoxinRisk)}
            </span>
          </div>
        </div>

        <div class="flex items-start gap-3">
          <span id="mfsc-dash-icon" aria-hidden="true" class="text-3xl leading-none mt-0.5 shrink-0">
            {defaultFood.icon}
          </span>
          <div class="space-y-1">
            <h3 id="mfsc-dash-name" class="text-lg sm:text-xl font-extrabold tracking-tight text-white leading-snug">
              {defaultFood.name}
            </h3>
            <p id="mfsc-dash-examples" class="text-xs text-white/75 leading-relaxed">
              {defaultFood.examples}
            </p>
            <p
              id="mfsc-dash-headline"
              class={`text-xs sm:text-sm font-extrabold leading-snug pt-0.5 ${
                defaultFood.verdict === 'cut-around' ? 'text-signature-mint' : 'text-red-300'
              }`}
            >
              {defaultFood.verdictHeadline}
            </p>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-4">
          <!-- Left: USDA Science + What If I Ate a Bite -->
          <div class="lg:col-span-6 space-y-3">
            <div class="p-3.5 rounded-xl bg-white/6 border border-white/12">
              <span class="block text-[10.5px] font-bold uppercase tracking-wider text-signature-peach">
                🧪 {t.usdaScienceLabel}
              </span>
              <p id="mfsc-dash-science" class="text-xs sm:text-[13px] text-white/92 leading-relaxed mt-1.5">
                {defaultFood.usdaScience}
              </p>
            </div>

            <div class="p-3.5 rounded-xl bg-amber-500/12 border border-amber-400/35">
              <span class="block text-[10.5px] font-bold uppercase tracking-wider text-amber-200">
                🩺 {t.ateABiteLabel}
              </span>
              <p id="mfsc-dash-bite" class="text-xs sm:text-[13px] text-white/95 leading-relaxed mt-1.5">
                {defaultFood.ateABiteNote}
              </p>
            </div>
          </div>

          <!-- Right: Safe Handling Steps -->
          <div class="lg:col-span-6 p-4 rounded-xl bg-white/6 border border-white/12 flex flex-col justify-between">
            <div class="space-y-2">
              <span class="block text-[10.5px] font-bold uppercase tracking-wider text-signature-mint">
                ✅ {t.handlingStepsLabel}
              </span>
              <ol id="mfsc-dash-steps" class="space-y-2 text-xs sm:text-[13px] text-white/95 list-decimal list-outside pl-5">
                {defaultFood.handlingSteps.map((step) => (
                  <li class="leading-relaxed">{step}</li>
                ))}
              </ol>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- PART 2: Search, Category Pills, Verdict Filter & 24 Clickable Food Cards -->
    <div class="p-5 sm:p-6 space-y-5">
      <div class="space-y-1">
        <h2 class="text-title-md font-semibold text-ink">{t.catalogTitle}</h2>
        <p class="text-xs sm:text-[13px] text-muted">{t.catalogSub}</p>
      </div>

      <!-- Search + Filters -->
      <div class="space-y-3.5 print:hidden">
        <!-- Search Row -->
        <div class="flex flex-col sm:flex-row gap-2.5">
          <div class="relative flex-1">
            <label for="mfsc-search-input" class="sr-only">{t.searchLabel}</label>
            <span aria-hidden="true" class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-sm text-muted">
              🔎
            </span>
            <input
              id="mfsc-search-input"
              type="search"
              autocomplete="off"
              placeholder={t.searchPlaceholder}
              class="w-full min-h-[44px] pl-10 pr-4 py-2 rounded-xl bg-surface-soft border border-hairline text-sm text-ink placeholder:text-muted focus:outline-none focus:border-signature-coral focus:ring-2 focus:ring-signature-coral/25 transition-all"
            />
          </div>
          <button
            type="button"
            id="mfsc-clear-btn"
            class="min-h-[44px] px-4 py-2 rounded-xl text-xs font-semibold bg-canvas text-ink border border-hairline hover:border-signature-coral transition-colors cursor-pointer shrink-0"
          >
            {t.clearFiltersBtn}
          </button>
        </div>

        <!-- Category Filter Pills -->
        <div class="space-y-1.5">
          <span class="block text-[11px] font-bold uppercase tracking-wider text-muted">
            {t.categoryGroupLabel}
          </span>
          <div class="flex flex-wrap gap-2" role="group" aria-label={t.categoryGroupLabel}>
            <button
              type="button"
              data-mfsc-cat="all"
              aria-pressed="true"
              class="mfsc-cat-btn px-3.5 py-1.5 rounded-full text-xs font-bold border transition-all cursor-pointer bg-primary text-on-primary border-primary shadow-sm"
            >
              {t.catAll} ({counts.all})
            </button>
            <button
              type="button"
              data-mfsc-cat="cheeses-dairy"
              aria-pressed="false"
              class="mfsc-cat-btn px-3.5 py-1.5 rounded-full text-xs font-bold border transition-all cursor-pointer bg-canvas text-ink border-hairline hover:border-border-strong"
            >
              🧀 {t.catCheeses} ({counts.cheesesDairy})
            </button>
            <button
              type="button"
              data-mfsc-cat="meats-deli"
              aria-pressed="false"
              class="mfsc-cat-btn px-3.5 py-1.5 rounded-full text-xs font-bold border transition-all cursor-pointer bg-canvas text-ink border-hairline hover:border-border-strong"
            >
              🥩 {t.catMeats} ({counts.meatsDeli})
            </button>
            <button
              type="button"
              data-mfsc-cat="bread-baked"
              aria-pressed="false"
              class="mfsc-cat-btn px-3.5 py-1.5 rounded-full text-xs font-bold border transition-all cursor-pointer bg-canvas text-ink border-hairline hover:border-border-strong"
            >
              🍞 {t.catBread} ({counts.breadBaked})
            </button>
            <button
              type="button"
              data-mfsc-cat="produce-fruits"
              aria-pressed="false"
              class="mfsc-cat-btn px-3.5 py-1.5 rounded-full text-xs font-bold border transition-all cursor-pointer bg-canvas text-ink border-hairline hover:border-border-strong"
            >
              🍓 {t.catProduce} ({counts.produceFruits})
            </button>
            <button
              type="button"
              data-mfsc-cat="pantry-spreads"
              aria-pressed="false"
              class="mfsc-cat-btn px-3.5 py-1.5 rounded-full text-xs font-bold border transition-all cursor-pointer bg-canvas text-ink border-hairline hover:border-border-strong"
            >
              🫙 {t.catPantry} ({counts.pantrySpreads})
            </button>
          </div>
        </div>

        <!-- Verdict Filter + Count Readout -->
        <div class="flex flex-wrap items-center justify-between gap-3 pt-1">
          <div class="flex flex-wrap items-center gap-2" role="group" aria-label={t.verdictGroupLabel}>
            <span class="text-[11px] font-bold uppercase tracking-wider text-muted mr-1">
              {t.verdictGroupLabel}:
            </span>
            <button
              type="button"
              data-mfsc-verdict="all"
              aria-pressed="true"
              class="mfsc-verdict-btn px-3 py-1.5 rounded-full text-xs font-bold border transition-all cursor-pointer bg-primary text-on-primary border-primary shadow-sm"
            >
              {t.verdictAll} ({counts.all})
            </button>
            <button
              type="button"
              data-mfsc-verdict="cut-around"
              aria-pressed="false"
              class="mfsc-verdict-btn px-3 py-1.5 rounded-full text-xs font-bold border transition-all cursor-pointer bg-canvas text-ink border-hairline hover:border-success-border"
            >
              ✅ {t.verdictCutFilter} ({counts.cutAround})
            </button>
            <button
              type="button"
              data-mfsc-verdict="discard"
              aria-pressed="false"
              class="mfsc-verdict-btn px-3 py-1.5 rounded-full text-xs font-bold border transition-all cursor-pointer bg-canvas text-ink border-hairline hover:border-error-border"
            >
              🚫 {t.verdictDiscardFilter} ({counts.discard})
            </button>
          </div>

          <p id="mfsc-count-readout" aria-live="polite" class="text-xs font-semibold text-muted">
            {t.showingPrefix} {counts.all} {t.showingOf} {counts.all} {t.showingSuffix}
          </p>
        </div>
      </div>

      <!-- Empty Search State -->
      <div
        id="mfsc-empty-state"
        class="hidden p-8 rounded-2xl bg-surface-soft border border-hairline text-center space-y-2"
      >
        <p class="text-sm font-bold text-ink">{t.noResultsTitle}</p>
        <p class="text-xs text-muted">{t.noResultsSub}</p>
        <button
          type="button"
          id="mfsc-empty-reset-btn"
          class="mt-2 px-4 py-2 rounded-xl text-xs font-bold bg-primary text-on-primary hover:bg-primary-active transition-colors cursor-pointer"
        >
          {t.clearFiltersBtn}
        </button>
      </div>

      <!-- 24 Clickable Food Cards -->
      <div id="mfsc-cards-grid" class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {localizedFoods.map((food, idx) => (
          <button
            type="button"
            data-mfsc-card={food.id}
            data-mfsc-cat={food.category}
            data-mfsc-verdict={food.verdict}
            data-mfsc-search={food.keywords}
            aria-pressed={idx === 0 ? 'true' : 'false'}
            class={`mfsc-card text-left w-full p-4 sm:p-5 rounded-2xl bg-surface-soft/55 border border-hairline hover:border-signature-coral ${getCardBorderAccent(food.verdict)} flex flex-col justify-between gap-3 transition-all cursor-pointer ${
              idx === 0 ? 'ring-2 ring-signature-coral bg-canvas shadow-sm' : ''
            }`}
          >
            <div class="space-y-2 w-full">
              <div class="flex items-start justify-between gap-2.5">
                <div class="flex items-start gap-2.5 min-w-0">
                  <span aria-hidden="true" class="text-xl leading-none mt-0.5 shrink-0">{food.icon}</span>
                  <div class="min-w-0">
                    <h3 class="text-sm sm:text-[15px] font-bold text-ink leading-snug">{food.name}</h3>
                    <p class="text-[11px] font-semibold text-muted mt-0.5">
                      {getCategoryLabel(food.category)}
                    </p>
                  </div>
                </div>
                <span class={`shrink-0 ${getVerdictPillClass(food.verdict)}`}>
                  {getVerdictLabel(food.verdict)}
                </span>
              </div>

              <p class="text-xs text-muted leading-snug">
                {food.examples}
              </p>

              <p class="text-xs sm:text-[13px] font-semibold text-ink leading-snug">
                {food.verdictHeadline}
              </p>
            </div>

            <div class="w-full pt-2 border-t border-hairline/70 flex items-center justify-between gap-2">
              <span class="text-[11px] font-semibold text-muted">
                💧 {getMoistureLabel(food.moistureLevel)}
              </span>
              <span
                data-mfsc-card-hint
                class={`text-[11px] font-bold ${idx === 0 ? 'text-signature-coral' : 'text-muted'}`}
              >
                {idx === 0 ? t.cardSelectedLabel : t.cardInspectHint}
              </span>
            </div>
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Related Companion Tools -->
  <section class="space-y-4 print:hidden">
    <h2 class="text-title-md font-semibold text-ink">{t.relatedHeading}</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      <a
        href={pantryUrl}
        class="p-6 rounded-2xl bg-surface-soft border border-hairline hover:border-signature-coral transition-all group block"
      >
        <span class="text-[11px] font-bold uppercase tracking-wider text-signature-coral block mb-1.5">
          {t.relatedPantryTag}
        </span>
        <h3 class="text-title-sm font-semibold text-ink group-hover:text-signature-coral transition-colors mb-1.5">
          {t.relatedPantryTitle}
        </h3>
        <p class="text-[13.5px] text-body leading-relaxed">{t.relatedPantryDesc}</p>
      </a>

      <a
        href={fridgeZoneUrl}
        class="p-6 rounded-2xl bg-surface-soft border border-hairline hover:border-signature-coral transition-all group block"
      >
        <span class="text-[11px] font-bold uppercase tracking-wider text-signature-coral block mb-1.5">
          {t.relatedFridgeTag}
        </span>
        <h3 class="text-title-sm font-semibold text-ink group-hover:text-signature-coral transition-colors mb-1.5">
          {t.relatedFridgeTitle}
        </h3>
        <p class="text-[13.5px] text-body leading-relaxed">{t.relatedFridgeDesc}</p>
      </a>

      <a
        href={leftoverUrl}
        class="p-6 rounded-2xl bg-surface-soft border border-hairline hover:border-signature-coral transition-all group block"
      >
        <span class="text-[11px] font-bold uppercase tracking-wider text-signature-coral block mb-1.5">
          {t.relatedLeftoverTag}
        </span>
        <h3 class="text-title-sm font-semibold text-ink group-hover:text-signature-coral transition-colors mb-1.5">
          {t.relatedLeftoverTitle}
        </h3>
        <p class="text-[13.5px] text-body leading-relaxed">{t.relatedLeftoverDesc}</p>
      </a>
    </div>
  </section>

  <!-- Methodology & Hub Strip -->
  <section class="p-6 rounded-2xl bg-surface-soft border border-hairline print:hidden">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <h2 class="text-title-sm font-semibold text-ink mb-1">{t.methodologyStripTitle}</h2>
        <p class="text-[13px] text-muted">
          {t.methodologyStripPrefix}{' '}
          <a href={methodologyUrl} class="text-link underline hover:text-link-active">{t.methodologyLabel}</a>.
        </p>
      </div>
      <div class="flex flex-wrap gap-2">
        <a
          href={leftoverUrl}
          class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral transition-colors"
        >
          {t.leftoverQuickLabel}
        </a>
        <a
          href={methodologyUrl}
          class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral transition-colors"
        >
          {t.methodologyLabel}
        </a>
        <a
          href={allToolsUrl}
          class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-primary text-on-primary hover:bg-primary-active transition-colors"
        >
          {t.allToolsLabel}
        </a>
      </div>
    </div>
  </section>

  <!-- Visible FAQ Accordion (Matches JSON-LD 1:1) -->
  <section class="print:hidden">
    <h2 class="text-title-lg font-medium text-ink tracking-tight mb-6">
      {t.faqTitle}
    </h2>
    <div class="space-y-4">
      {localizedFaqs.map((faq) => (
        <details class="group p-5 bg-surface-soft border border-hairline rounded-xl" open>
          <summary class="text-title-sm font-semibold text-ink cursor-pointer list-none flex items-center justify-between gap-3">
            <span>{faq.question}</span>
            <span class="text-muted text-sm transition-transform group-open:rotate-180 shrink-0" aria-hidden="true">&#9662;</span>
          </summary>
          <p class="text-[14px] text-body leading-relaxed mt-3 pt-3 border-t border-hairline/70">
            {faq.answer}
          </p>
        </details>
      ))}
    </div>
  </section>
</div>

<script is:inline>
  (function () {
    var payloadEl = document.getElementById('mfsc-payload');
    if (!payloadEl) return;

    var payload;
    try {
      payload = JSON.parse(payloadEl.textContent || '{}');
    } catch (_) {
      return;
    }

    var foods = Array.isArray(payload.foods) ? payload.foods : [];
    var rules = Array.isArray(payload.rules) ? payload.rules : [];
    var ui = payload.ui || {};
    var totalCount = Number(payload.totalCount || foods.length || 24);

    var foodMap = {};
    foods.forEach(function (f) {
      if (f && f.id) foodMap[f.id] = f;
    });

    // Verdict inspector elements
    var elInspector = document.getElementById('mfsc-verdict-inspector');
    var elDashPill = document.getElementById('mfsc-dash-pill');
    var elDashMoisture = document.getElementById('mfsc-dash-moisture');
    var elDashMycotoxin = document.getElementById('mfsc-dash-mycotoxin');
    var elDashIcon = document.getElementById('mfsc-dash-icon');
    var elDashName = document.getElementById('mfsc-dash-name');
    var elDashExamples = document.getElementById('mfsc-dash-examples');
    var elDashHeadline = document.getElementById('mfsc-dash-headline');
    var elDashScience = document.getElementById('mfsc-dash-science');
    var elDashBite = document.getElementById('mfsc-dash-bite');
    var elDashSteps = document.getElementById('mfsc-dash-steps');

    // Catalog controls
    var searchInput = document.getElementById('mfsc-search-input');
    var clearBtn = document.getElementById('mfsc-clear-btn');
    var emptyResetBtn = document.getElementById('mfsc-empty-reset-btn');
    var catBtns = Array.from(document.querySelectorAll('.mfsc-cat-btn'));
    var verdictBtns = Array.from(document.querySelectorAll('.mfsc-verdict-btn'));
    var cards = Array.from(document.querySelectorAll('.mfsc-card'));
    var countReadout = document.getElementById('mfsc-count-readout');
    var emptyState = document.getElementById('mfsc-empty-state');
    var cardsGrid = document.getElementById('mfsc-cards-grid');

    // Top action buttons
    var copyBtn = document.getElementById('mfsc-copy-btn');
    var copyLabel = document.getElementById('mfsc-copy-label');
    var printBtn = document.getElementById('mfsc-print-btn');
    var resetBtn = document.getElementById('mfsc-reset-btn');

    var state = {
      foodId: foods[0] ? foods[0].id : 'hard-cheeses',
      category: 'all',
      verdict: 'all',
      query: ''
    };

    function getVerdictLabel(verdict) {
      return verdict === 'cut-around'
        ? (ui.verdictCutBadge || 'CUT 1 INCH (2.5 CM) AROUND')
        : (ui.verdictDiscardBadge || 'DISCARD ENTIRE ITEM');
    }

    function getMoistureText(level) {
      if (level === 'low-dense') return ui.moistureLowDense || 'Low Moisture · Dense';
      if (level === 'medium-porous') return ui.moistureMediumPorous || 'Porous / Emulsified';
      return ui.moistureHigh || 'High Moisture';
    }

    function getMycotoxinText(risk) {
      if (risk === 'low-surface') return ui.mycotoxinLow || 'Low (Surface Only)';
      if (risk === 'moderate') return ui.mycotoxinModerate || 'Moderate';
      return ui.mycotoxinHigh || 'High (Invisible Spread)';
    }

    function setMycotoxinClasses(el, risk) {
      if (!el) return;
      el.classList.remove(
        'bg-emerald-500/20',
        'text-emerald-200',
        'border-emerald-400/40',
        'bg-amber-500/20',
        'text-amber-200',
        'border-amber-400/40',
        'bg-red-500/20',
        'text-red-200',
        'border-red-400/40'
      );
      if (risk === 'low-surface') {
        el.classList.add('bg-emerald-500/20', 'text-emerald-200', 'border-emerald-400/40');
      } else if (risk === 'moderate') {
        el.classList.add('bg-amber-500/20', 'text-amber-200', 'border-amber-400/40');
      } else {
        el.classList.add('bg-red-500/20', 'text-red-200', 'border-red-400/40');
      }
    }

    function renderInspector() {
      var food = foodMap[state.foodId] || foods[0];
      if (!food) return;

      var isCut = food.verdict === 'cut-around';

      if (elDashPill) {
        elDashPill.className = isCut ? 'badge-yes' : 'badge-no';
        elDashPill.textContent = getVerdictLabel(food.verdict);
      }

      if (elDashMoisture) {
        elDashMoisture.textContent = '💧 ' + (ui.moistureLabel || 'Texture / Moisture') + ': ' + getMoistureText(food.moistureLevel);
      }

      if (elDashMycotoxin) {
        elDashMycotoxin.textContent = '☣️ ' + (ui.mycotoxinLabel || 'Mycotoxin Risk') + ': ' + getMycotoxinText(food.mycotoxinRisk);
        setMycotoxinClasses(elDashMycotoxin, food.mycotoxinRisk);
      }

      if (elDashIcon) elDashIcon.textContent = food.icon || '';
      if (elDashName) elDashName.textContent = food.name || '';
      if (elDashExamples) elDashExamples.textContent = food.examples || '';

      if (elDashHeadline) {
        elDashHeadline.textContent = food.verdictHeadline || '';
        elDashHeadline.classList.toggle('text-signature-mint', isCut);
        elDashHeadline.classList.toggle('text-red-300', !isCut);
      }

      if (elDashScience) elDashScience.textContent = food.usdaScience || '';
      if (elDashBite) elDashBite.textContent = food.ateABiteNote || '';

      if (elDashSteps) {
        while (elDashSteps.firstChild) {
          elDashSteps.removeChild(elDashSteps.firstChild);
        }
        var steps = Array.isArray(food.handlingSteps) ? food.handlingSteps : [];
        steps.forEach(function (stepText) {
          var li = document.createElement('li');
          li.className = 'leading-relaxed';
          li.textContent = stepText;
          elDashSteps.appendChild(li);
        });
      }

      if (elInspector) {
        elInspector.classList.remove('border-success-border', 'border-error-border');
        elInspector.classList.add(isCut ? 'border-success-border' : 'border-error-border');
      }

      cards.forEach(function (card) {
        var active = card.getAttribute('data-mfsc-card') === food.id;
        card.setAttribute('aria-pressed', active ? 'true' : 'false');
        card.classList.toggle('ring-2', active);
        card.classList.toggle('ring-signature-coral', active);
        card.classList.toggle('bg-canvas', active);
        card.classList.toggle('shadow-sm', active);
        card.classList.toggle('bg-surface-soft/55', !active);
        var hint = card.querySelector('[data-mfsc-card-hint]');
        if (hint) {
          hint.textContent = active
            ? (ui.cardSelectedLabel || 'Viewing Verdict ↑')
            : (ui.cardInspectHint || 'Click to inspect USDA verdict ↑');
          hint.classList.toggle('text-signature-coral', active);
          hint.classList.toggle('text-muted', !active);
        }
      });
    }

    function togglePillActive(btn, active) {
      btn.setAttribute('aria-pressed', active ? 'true' : 'false');
      btn.classList.toggle('bg-primary', active);
      btn.classList.toggle('text-on-primary', active);
      btn.classList.toggle('border-primary', active);
      btn.classList.toggle('shadow-sm', active);
      btn.classList.toggle('bg-canvas', !active);
      btn.classList.toggle('text-ink', !active);
      btn.classList.toggle('border-hairline', !active);
    }

    function renderCatalog() {
      var q = (state.query || '').trim().toLowerCase();
      var visibleCount = 0;

      catBtns.forEach(function (btn) {
        var cVal = btn.getAttribute('data-mfsc-cat');
        togglePillActive(btn, cVal === state.category);
      });

      verdictBtns.forEach(function (btn) {
        var vVal = btn.getAttribute('data-mfsc-verdict');
        togglePillActive(btn, vVal === state.verdict);
      });

      cards.forEach(function (card) {
        var cat = card.getAttribute('data-mfsc-cat') || '';
        var verdict = card.getAttribute('data-mfsc-verdict') || '';
        var haystack = card.getAttribute('data-mfsc-search') || '';
        var catMatch = state.category === 'all' || cat === state.category;
        var verdictMatch = state.verdict === 'all' || verdict === state.verdict;
        var queryMatch = !q || haystack.indexOf(q) !== -1;
        var show = catMatch && verdictMatch && queryMatch;
        card.classList.toggle('hidden', !show);
        if (show) visibleCount += 1;
      });

      if (countReadout) {
        countReadout.textContent =
          (ui.showingPrefix || 'Showing') +
          ' ' +
          visibleCount +
          ' ' +
          (ui.showingOf || 'of') +
          ' ' +
          totalCount +
          ' ' +
          (ui.showingSuffix || 'foods');
      }

      var isEmpty = visibleCount === 0;
      if (emptyState) emptyState.classList.toggle('hidden', !isEmpty);
      if (cardsGrid) cardsGrid.classList.toggle('hidden', isEmpty);
    }

    function buildChartText() {
      var selected = foodMap[state.foodId] || foods[0];
      var lines = [];
      lines.push(ui.chartHeader || 'IsItKitchenSafe — Official USDA FSIS Moldy Food Chart');
      lines.push('');

      if (selected) {
        lines.push((ui.chartSelectedHeading || 'SELECTED FOOD PROTOCOL') + ': ' + selected.name + ' [' + getVerdictLabel(selected.verdict) + ']');
        lines.push('- ' + selected.verdictHeadline);
        if (Array.isArray(selected.handlingSteps)) {
          selected.handlingSteps.forEach(function (step, i) {
            lines.push('  ' + (i + 1) + ') ' + step);
          });
        }
        lines.push('');
      }

      lines.push(ui.chartSafeHeading || 'SAFE TO CUT 1 INCH (2.5 CM) AROUND & BELOW:');
      foods.forEach(function (f) {
        if (f.verdict === 'cut-around') {
          lines.push('  [SAFE CUT] ' + f.name + ' — ' + f.examples);
        }
      });
      lines.push('');

      lines.push(ui.chartDiscardHeading || 'ALWAYS DISCARD ENTIRE ITEM:');
      foods.forEach(function (f) {
        if (f.verdict === 'discard') {
          lines.push('  [DISCARD] ' + f.name + ' — ' + f.examples);
        }
      });
      lines.push('');

      lines.push(ui.chartRulesHeading || '3 CRITICAL USDA MOLD SAFETY RULES:');
      rules.forEach(function (r, idx) {
        lines.push('  ' + (idx + 1) + '. ' + r.title + ' — ' + r.body);
      });

      return lines.join('\n');
    }

    function clearCatalogFilters() {
      state.category = 'all';
      state.verdict = 'all';
      state.query = '';
      if (searchInput) searchInput.value = '';
      renderCatalog();
    }

    cards.forEach(function (card) {
      card.addEventListener('click', function () {
        var id = card.getAttribute('data-mfsc-card');
        if (id && foodMap[id]) {
          state.foodId = id;
          renderInspector();
          if (elInspector && typeof elInspector.scrollIntoView === 'function') {
            var rect = elInspector.getBoundingClientRect();
            if (rect.top < 0 || rect.top > window.innerHeight * 0.65) {
              elInspector.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
          }
        }
      });
    });

    catBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var val = btn.getAttribute('data-mfsc-cat');
        if (val) {
          state.category = val;
          renderCatalog();
        }
      });
    });

    verdictBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var val = btn.getAttribute('data-mfsc-verdict');
        if (val) {
          state.verdict = val;
          renderCatalog();
        }
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', function () {
        state.query = searchInput.value || '';
        renderCatalog();
      });
    }

    if (clearBtn) {
      clearBtn.addEventListener('click', clearCatalogFilters);
    }
    if (emptyResetBtn) {
      emptyResetBtn.addEventListener('click', clearCatalogFilters);
    }

    if (copyBtn) {
      copyBtn.addEventListener('click', function () {
        var chartText = buildChartText();
        var showCopied = function () {
          if (copyLabel) copyLabel.textContent = ui.copiedBtn || 'USDA Chart Copied ✓';
          window.setTimeout(function () {
            if (copyLabel) copyLabel.textContent = '📋 ' + (ui.copyBtn || 'Copy USDA Mold Chart');
          }, 2200);
        };

        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(chartText).then(showCopied).catch(showCopied);
        } else {
          var ta = document.createElement('textarea');
          ta.value = chartText;
          ta.setAttribute('readonly', '');
          ta.style.position = 'absolute';
          ta.style.left = '-9999px';
          document.body.appendChild(ta);
          ta.select();
          try {
            document.execCommand('copy');
          } catch (_) {
            // ignore
          }
          document.body.removeChild(ta);
          showCopied();
        }
      });
    }

    if (printBtn) {
      printBtn.addEventListener('click', function () {
        window.print();
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', function () {
        state.foodId = foods[0] ? foods[0].id : 'hard-cheeses';
        clearCatalogFilters();
        renderInspector();
      });
    }

    renderInspector();
    renderCatalog();
  })();
</script>
