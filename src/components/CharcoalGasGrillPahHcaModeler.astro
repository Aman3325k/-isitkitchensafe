    rule2Text: "烤前用黑啤酒或新鲜迷迭香碎腌制30分钟。鼠尾草酸与类黑精能捕获自由基，阻断肌酸热缩合，降低杂环胺（HCA）达88%。",
    rule3Title: "3. 糖类酱料后置涂抹法则",
    rule3Text: "切勿在烧烤初期刷涂含蜂蜜、糖蜜或高果糖浆的酱料。糖分在160°C以上剧烈碳化，会使焦皮致癌物暴增。仅在出炉前最后3至5分钟涂抹。",
    rule4Title: "4. 高频频繁翻动技术",
    rule4Text: "每隔60秒翻动一次肉块，使肉表面温度降低50°C–80°C，显著阻断美拉德致癌缩合反应，减少杂环胺65%。",
    rule5Title: "5. 修剪多余脂肪与彻底刮净烤网碳垢",
    rule5Text: "将肉块边缘脂肪层修剪至3毫米以内以减少油脂溢出，并在烤肉前刮净烤网残留积碳，防止陈旧致癌炭黑黏附。",
    copyReportBtn: "📋 复制毒理诊断评估报告",
    reportCopied: "✅ 完整诊断报告已复制到剪贴板！",
    crossLinkTitle: "相关高温烹饪安全工具",
    crossLinkAcrylamide: "空气炸锅丙烯酰胺与美拉德反应计算器",
    crossLinkSmokePoint: "烹饪食用油发烟点与致癌醛类模拟器",
    crossLinkRangeHood: "厨房油烟抽油烟机 PM2.5 抽吸效率模型"
  },
  ja: {
    badge: "燃焼毒性学＆熱変異原動力学",
    title: "木炭・ガスグリル PAH＆HCA 発がん性物質モデラー",
    subtitle: "750°C炭火への油脂滴下熱分解、揮発性ベンゾ[a]ピレン煙凝縮、クレアチン・アミノ酸メイラード縮合（PhIP/MeIQx）、およびEU 835/2011基準を解析。",
    controlsTitle: "燃料基材、肉質組成、熱力学的配置パラメータ",
    controlsSub: "燃料熱源、肉部位、焼き加減、抗酸化マリネ化学、焼き網高さを設定し、変異原性物質の暴露量をリアルタイム算出します。",
    fuelLabel: "グリル熱源＆燃料タイプ",
    fuelHelp: "木炭や成形炭は750°C〜850°Cに達し脂質の熱分解を急加速させます。ガスグリルは煤を約60%抑制し、無煙電気グリルは直火熱分解をほぼ排除します。",
    meatLabel: "肉の種類＆内因性前駆物質",
    meatHelp: "高脂肪ひき肉は炎上煙を多発させます。鶏皮はPhIP生成に必要なフェニルアラニンが最も豊富です。植物性肉は動物性クレアチンを全く含みません。",
    donenessLabel: "焼き加減＆表面炭化クラスト",
    donenessHelp: "ウェルダンや焦げ目が強い場合、表面温度が200°Cを超えヘテロサイクリックアミン（HCA）生成量がミディアムの4倍〜9倍に激増します。",
    marinadeLabel: "抗酸化マリネ＆ラジカル捕捉化学",
    marinadeHelp: "黒ビールのポリフェノール（-68% PAH）やローズマリーのカルノシン酸（-88% HCA）がラジカルを捕捉。早い段階の甘いBBQソースは焦げ付き倍増を招きます。",
    geometryLabel: "焼き網高さ＆2ゾーン間接配置",
    geometryHelp: "2ゾーン間接焼きは炭火から離れた位置に水受け皿を配置し、脂が火に落ちるのを防ぐことでPAH煙エアロゾルを90%以上遮断します。",
    portionLabel: "摂取量（調理後のグラム数）",
    portionHelp: "1食あたりの推定摂取重量。変異原物質の総マイクログラム摂取量を算出します。",
    consumerLabel: "喫食者プロファイル＆肝臓CYP1A2代謝",
    consumerHelp: "肝臓の解毒酵素処理能力および小児の体重あたりの脆弱性を考慮してリスクを評価します。",
    presetsTitle: "クイックシミュレーション",
    presetSafe: "🏆 ゴールド水準：ローズマリー鶏肉（間接2ゾーン焼き、ミディアム）",
    presetCharcoalBurger: "🍔 高リスク：炭火直火ビーフバーガー（直火、ウェルダン、マリネなし）",
    presetWellDoneChicken: "🍗 HCA極大：焦げ目つきBBQチキン（強火、早期甘口タレ塗布）",
    presetSmokedRibs: "💨 ペレットスモーク：低温スローリブ（間接対流、黒ビールマリネ）",
    diagnosticTitle: "発がん物質暴露診断＆EU安全基準評価",
    diagnosticSub: "欧州委員会規則 (EU) No 835/2011 および国際がん研究機関 (IARC) モノグラフに基づく動力学解析。",
    overallScoreLabel: "毒性学的安全性スコア",
    pahConcentrationLabel: "総PAH（多環芳香族炭化水素）",
    hcaConcentrationLabel: "総HCA（PhIP、MeIQx 変異原物質）",
    bapComparisonLabel: "ベンゾ[a]ピレン vs EU基準上限 (2.0 µg/kg)",
    mealDoseLabel: "1食あたりの変異原物質総摂取量",
    carcinogenGradeLabel: "危険性分類",
    alertTitle: "臨床・変異原性医学的評価",
    tableTitle: "グリル燃料基材＆熱分解マトリックス",
    tableSub: "燃焼炎温度、熱分解乗数、および煙粒子エアロゾルの比較。",
    colFuel: "燃料熱源",
    colClass: "燃焼分類",
    colTemp: "最高温度",
    colPahFactor: "PAH 乗数",
    colHcaFactor: "HCA 乗数",
    colSmokeDensity: "煙エアロゾル動態",
    rulesTitle: "科学的エビデンスに基づくグリル安全原則",
    rulesSub: "美味しさを損なわずに食事由来の発がん物質を最大90%削減する5つの調理プロトコル。",
    rule1Title: "1. 2ゾーン間接焼き（インダイレクト）法",
    rule1Text: "炭火やバーナーをグリルの片側のみに配置し、肉は水受け皿を置いた反対側で調理します。脂が直接火に落ちるのを防ぎ、揮発性ベンゾ[a]ピレン沈着を92%阻止します。",
    rule2Title: "2. ローズマリーまたは黒ビールの30分マリネ",
    rule2Text: "焼く前に黒ビールや刻んだ生ローズマリーに30分漬け込みます。カルノシン酸やメラノイジンがラジカルを中和し、ヘテロサイクリックアミン（HCA）を最大88%抑制します。",
    rule3Title: "3. 甘いタレの後塗りルール",
    rule3Text: "ハチミツや糖分を含むBBQソースを焼き始めに塗ってはいけません。160°C以上で激しく炭化し発がん物質が倍増するため、焼き上がりの最後の3〜5分にのみ塗布します。",
    rule4Title: "4. 60秒ごとの高頻度反転焼き",
    rule4Text: "肉を頻繁に（約1分ごと）裏返すことで、表面温度を50°C〜80°C低く保ち、メイラード変異原物質の合成を65%カットできます。",
    rule5Title: "5. 余分な脂のトリミング＆焼き網のカーボン除去",
    rule5Text: "肉の外周脂肪を3mm以下に切り落として脂垂れを抑え、調理前には必ず網の古い焦げをワイヤーブラシ等で完全に削り落とします。",
    copyReportBtn: "📋 毒性診断レポートをコピー",
    reportCopied: "✅ 完全な診断レポートをクリップボードにコピーしました！",
    crossLinkTitle: "関連する高温調理安全性ツール",
    crossLinkAcrylamide: "ノンフライヤー アクリルアミド＆メイラード計算ツール",
    crossLinkSmokePoint: "食用油発煙点＆有毒アルデヒド生成シミュレーター",
    crossLinkRangeHood: "キッチン換気扇 VOC・PM2.5 排気効率モデラー"
  }
};

const c = dict[lang];
---

<div class="bg-surface border border-hairline rounded-3xl p-6 md:p-10 shadow-xs mb-12">
  <!-- Interactive Header Badge -->
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-hairline/80 pb-6 mb-8">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold uppercase tracking-wider bg-rose-100 text-rose-900 border border-rose-200">
      <span class="inline-block w-2 h-2 rounded-full bg-rose-600 animate-pulse"></span>
      {c.badge}
    </div>
    <span class="text-xs text-muted font-mono">
      EU 835/2011 &bull; IARC Monograph Group 1 &bull; PhIP Kinetics
    </span>
  </div>

  <!-- Presets Bar -->
  <div class="mb-8">
    <label class="block text-xs font-bold uppercase tracking-wider text-muted mb-3">
      {c.presetsTitle}
    </label>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5">
      <button 
        type="button" 
        id="preset-safe" 
        class="text-left p-3 rounded-xl border border-hairline bg-surface-soft hover:bg-emerald-50 hover:border-emerald-300 text-xs font-medium text-ink transition-all"
      >
        {c.presetSafe}
      </button>
      <button 
        type="button" 
        id="preset-charcoal" 
        class="text-left p-3 rounded-xl border border-hairline bg-surface-soft hover:bg-rose-50 hover:border-rose-300 text-xs font-medium text-ink transition-all"
      >
        {c.presetCharcoalBurger}
      </button>
      <button 
        type="button" 
        id="preset-welldone" 
        class="text-left p-3 rounded-xl border border-hairline bg-surface-soft hover:bg-amber-50 hover:border-amber-300 text-xs font-medium text-ink transition-all"
      >
        {c.presetWellDoneChicken}
      </button>
      <button 
        type="button" 
        id="preset-smoked" 
        class="text-left p-3 rounded-xl border border-hairline bg-surface-soft hover:bg-blue-50 hover:border-blue-300 text-xs font-medium text-ink transition-all"
      >
        {c.presetSmokedRibs}
      </button>
    </div>
  </div>

  <!-- Main Controls Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-10">
    <div class="lg:col-span-7 space-y-6">
      <div class="border-b border-hairline pb-4">
        <h3 class="text-lg font-bold text-ink mb-1">{c.controlsTitle}</h3>
        <p class="text-xs text-body leading-relaxed">{c.controlsSub}</p>
      </div>

      <!-- Fuel Selector -->
      <div>
        <label for="grill-fuel-select" class="block text-sm font-semibold text-ink mb-1">
          {c.fuelLabel}
        </label>
        <select 
          id="grill-fuel-select" 
          class="w-full bg-surface-soft border border-hairline rounded-xl px-4 py-2.5 text-sm font-medium text-ink focus:ring-2 focus:ring-rose-500 focus:outline-none"
        >
          {grillData.grillFuelTypes.map((fuel) => (
            <option value={fuel.id} selected={fuel.id === 'charcoal-briquettes'}>
              {fuel.name}
            </option>
          ))}
        </select>
        <p class="text-xs text-muted mt-1.5 leading-relaxed">{c.fuelHelp}</p>
      </div>

      <!-- Meat Selector -->
      <div>
        <label for="meat-profile-select" class="block text-sm font-semibold text-ink mb-1">
          {c.meatLabel}
        </label>
        <select 
          id="meat-profile-select" 
          class="w-full bg-surface-soft border border-hairline rounded-xl px-4 py-2.5 text-sm font-medium text-ink focus:ring-2 focus:ring-rose-500 focus:outline-none"
        >
          {grillData.meatProfiles.map((meat) => (
            <option value={meat.id} selected={meat.id === 'beef-ribeye-burger'}>
              {meat.name}
            </option>
          ))}
        </select>
        <p class="text-xs text-muted mt-1.5 leading-relaxed">{c.meatHelp}</p>
      </div>

      <!-- Doneness Selector -->
      <div>
        <label for="doneness-select" class="block text-sm font-semibold text-ink mb-1">
          {c.donenessLabel}
        </label>
        <select 
          id="doneness-select" 
          class="w-full bg-surface-soft border border-hairline rounded-xl px-4 py-2.5 text-sm font-medium text-ink focus:ring-2 focus:ring-rose-500 focus:outline-none"
        >
          {grillData.cookingDoneness.map((done) => (
            <option value={done.id} selected={done.id === 'medium'}>
              {done.name}
            </option>
          ))}
        </select>
        <p class="text-xs text-muted mt-1.5 leading-relaxed">{c.donenessHelp}</p>
      </div>

      <!-- Marinade Selector -->
      <div>
        <label for="marinade-select" class="block text-sm font-semibold text-ink mb-1">
          {c.marinadeLabel}
        </label>
        <select 
          id="marinade-select" 
          class="w-full bg-surface-soft border border-hairline rounded-xl px-4 py-2.5 text-sm font-medium text-ink focus:ring-2 focus:ring-rose-500 focus:outline-none"
        >
          {grillData.marinadeMitigations.map((mari) => (
            <option value={mari.id} selected={mari.id === 'no-marinade-unseasoned'}>
              {mari.name}
            </option>
          ))}
        </select>
        <p class="text-xs text-muted mt-1.5 leading-relaxed">{c.marinadeHelp}</p>
      </div>

      <!-- Grilling Geometry -->
      <div>
        <label for="geometry-select" class="block text-sm font-semibold text-ink mb-1">
          {c.geometryLabel}
        </label>
        <select 
          id="geometry-select" 
          class="w-full bg-surface-soft border border-hairline rounded-xl px-4 py-2.5 text-sm font-medium text-ink focus:ring-2 focus:ring-rose-500 focus:outline-none"
        >
          {grillData.grillingGeometry.map((geo) => (
            <option value={geo.id} selected={geo.id === 'direct-elevated-grate'}>
              {geo.name}
            </option>
          ))}
        </select>
        <p class="text-xs text-muted mt-1.5 leading-relaxed">{c.geometryHelp}</p>
      </div>

      <!-- Portion Size & Consumer Profile Row -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <div class="flex items-center justify-between mb-1">
            <label for="portion-size-input" class="text-sm font-semibold text-ink">
              {c.portionLabel}
            </label>
            <span id="portion-display" class="font-mono text-xs font-bold text-rose-600 bg-rose-50 px-2 py-0.5 rounded">
              200g
            </span>
          </div>
          <input 
            type="range" 
            id="portion-size-input" 
            min="50" 
            max="600" 
            step="25" 
            value="200"
            class="w-full accent-rose-600 cursor-pointer"
          />
          <p class="text-xs text-muted mt-1 leading-relaxed">{c.portionHelp}</p>
        </div>

        <div>
          <label for="consumer-select" class="block text-sm font-semibold text-ink mb-1">
            {c.consumerLabel}
          </label>
          <select 
            id="consumer-select" 
            class="w-full bg-surface-soft border border-hairline rounded-xl px-4 py-2 text-sm font-medium text-ink focus:ring-2 focus:ring-rose-500 focus:outline-none"
          >
            {grillData.consumerProfiles.map((con) => (
              <option value={con.id} selected={con.id === 'adult-70kg'}>
                {con.name}
              </option>
            ))}
          </select>
          <p class="text-xs text-muted mt-1 leading-relaxed">{c.consumerHelp}</p>
        </div>
      </div>
    </div>

    <!-- Diagnostic Results Panel -->
    <div class="lg:col-span-5 bg-surface-soft border border-hairline rounded-2xl p-6 md:p-8 flex flex-col justify-between">
      <div>
        <div class="border-b border-hairline/80 pb-4 mb-6">
          <div class="text-xs font-mono font-semibold uppercase tracking-wider text-muted">
            {c.diagnosticTitle}
          </div>
          <div class="text-xs text-body mt-1">
            {c.diagnosticSub}
          </div>
        </div>

        <!-- Safety Grade Card -->
        <div id="safety-grade-card" class="p-4 rounded-xl border mb-6 transition-colors bg-rose-50 border-rose-200">
          <div class="flex items-center justify-between mb-1">
            <span class="text-xs font-bold uppercase tracking-wider text-rose-900">{c.overallScoreLabel}</span>
            <span id="safety-grade-badge" class="px-2.5 py-1 rounded-md text-xs font-extrabold uppercase bg-rose-600 text-white">
              GRADE C (HIGH MUTAGEN HAZARD)
            </span>
          </div>
          <div id="safety-grade-desc" class="text-xs text-rose-800 leading-relaxed mt-2">
            Elevated polycyclic aromatic hydrocarbons from fat dripping on radiant coals, with moderate heterocyclic amine formation in surface meat crust.
          </div>
        </div>

        <!-- Telemetry Stats Grid -->
        <div class="space-y-4 mb-6">
          <div class="flex items-center justify-between p-3 rounded-xl bg-surface border border-hairline">
            <span class="text-xs text-body font-medium">{c.pahConcentrationLabel}</span>
            <span id="stat-pah-conc" class="font-mono text-sm font-bold text-ink">
              18.4 µg/kg
            </span>
          </div>

          <div class="flex items-center justify-between p-3 rounded-xl bg-surface border border-hairline">
            <span class="text-xs text-body font-medium">{c.hcaConcentrationLabel}</span>
            <span id="stat-hca-conc" class="font-mono text-sm font-bold text-ink">
              32.5 ng/g
            </span>
          </div>

          <div class="flex items-center justify-between p-3 rounded-xl bg-surface border border-hairline">
            <span class="text-xs text-body font-medium">{c.bapComparisonLabel}</span>
            <span id="stat-bap-ratio" class="font-mono text-sm font-bold text-rose-600">
              184% of EU Limit
            </span>
          </div>

          <div class="flex items-center justify-between p-3 rounded-xl bg-surface border border-hairline">
            <span class="text-xs text-body font-medium">{c.mealDoseLabel}</span>
            <span id="stat-meal-dose" class="font-mono text-sm font-bold text-ink">
              3.68 µg PAHs / 6.50 µg HCAs
            </span>
          </div>
        </div>

        <!-- Alert Box -->
        <div id="diagnostic-alert-box" class="p-4 rounded-xl bg-surface border border-hairline text-xs space-y-2 text-body leading-relaxed mb-6">
          <div class="font-bold text-ink flex items-center gap-1.5">
            <span>⚠️</span> {c.alertTitle}
          </div>
          <p id="diagnostic-alert-text">
            Standard direct grilling of high-fat ground beef over commercial briquettes generates dense rising Benzo[a]pyrene smoke aerosols. Marinading with dark ale or rosemary extract reduces mutagen synthesis up to 88%.
          </p>
        </div>
      </div>

      <!-- Action Button -->
      <div>
        <button 
          type="button" 
          id="btn-copy-report" 
          class="w-full py-3 px-4 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-medium text-xs transition-colors shadow-xs flex items-center justify-center gap-2"
        >
          {c.copyReportBtn}
        </button>
        <p id="copy-confirmation" class="text-[11px] text-emerald-600 font-semibold text-center mt-2 hidden">
          {c.reportCopied}
        </p>
      </div>
    </div>
  </div>

  <!-- Reference Data Table -->
  <div class="border-t border-hairline pt-8 mb-10">
    <div class="mb-4">
      <h4 class="text-sm font-bold text-ink">{c.tableTitle}</h4>
      <p class="text-xs text-muted mt-0.5">{c.tableSub}</p>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs border border-hairline rounded-xl">
        <thead class="bg-surface-soft border-b border-hairline text-muted uppercase font-mono tracking-wider">
          <tr>
            <th class="p-3">{c.colFuel}</th>
            <th class="p-3">{c.colClass}</th>
            <th class="p-3">{c.colTemp}</th>
            <th class="p-3">{c.colPahFactor}</th>
            <th class="p-3">{c.colHcaFactor}</th>
            <th class="p-3">{c.colSmokeDensity}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline">
          {grillData.grillFuelTypes.map((fuel) => (
            <tr class="hover:bg-surface-soft/60 transition-colors">
              <td class="p-3 font-semibold text-ink">{fuel.name}</td>
              <td class="p-3 text-body">{fuel.fuelClass}</td>
              <td class="p-3 font-mono font-medium">{fuel.flameTempC}°C</td>
              <td class="p-3 font-mono text-rose-600 font-bold">{fuel.pahPyrolysisFactor}x</td>
              <td class="p-3 font-mono text-amber-600 font-bold">{fuel.hcaRadiantFactor}x</td>
              <td class="p-3 text-body leading-relaxed max-w-xs">{fuel.smokeParticulateDensity}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Evidence-Based Protocols -->
  <div class="border-t border-hairline pt-8 mb-10">
    <div class="mb-6">
      <h4 class="text-sm font-bold text-ink">{c.rulesTitle}</h4>
      <p class="text-xs text-muted mt-0.5">{c.rulesSub}</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 text-xs">
      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <div class="font-bold text-ink mb-1">{c.rule1Title}</div>
        <p class="text-body leading-relaxed">{c.rule1Text}</p>
      </div>
      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <div class="font-bold text-ink mb-1">{c.rule2Title}</div>
        <p class="text-body leading-relaxed">{c.rule2Text}</p>
      </div>
      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <div class="font-bold text-ink mb-1">{c.rule3Title}</div>
        <p class="text-body leading-relaxed">{c.rule3Text}</p>
      </div>
      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <div class="font-bold text-ink mb-1">{c.rule4Title}</div>
        <p class="text-body leading-relaxed">{c.rule4Text}</p>
      </div>
      <div class="p-4 rounded-xl bg-surface-soft border border-hairline lg:col-span-2">
        <div class="font-bold text-ink mb-1">{c.rule5Title}</div>
        <p class="text-body leading-relaxed">{c.rule5Text}</p>
      </div>
    </div>
  </div>

  <!-- Related Tools Cross-Links -->
  <div class="border-t border-hairline pt-8">
    <div class="text-xs font-bold uppercase tracking-wider text-muted mb-3">
      {c.crossLinkTitle}
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
      <a 
        href={lang === 'en' ? "/tools/air-fryer-acrylamide-calculator/" : `/${lang}/tools/air-fryer-acrylamide-calculator/`}
        class="p-3 rounded-xl bg-surface-soft hover:bg-surface-strong border border-hairline transition-colors block"
      >
        <span class="font-semibold text-ink block mb-0.5">{c.crossLinkAcrylamide} &rarr;</span>
        <span class="text-muted text-[11px]">Maillard thermal byproduct threshold modeling</span>
      </a>
      <a 
        href={lang === 'en' ? "/tools/culinary-oil-smoke-point-simulator/" : `/${lang}/tools/culinary-oil-smoke-point-simulator/`}
        class="p-3 rounded-xl bg-surface-soft hover:bg-surface-strong border border-hairline transition-colors block"
      >
        <span class="font-semibold text-ink block mb-0.5">{c.crossLinkSmokePoint} &rarr;</span>
        <span class="text-muted text-[11px]">Lipid breakdown &amp; cytotoxic aldehyde fumes</span>
      </a>
      <a 
        href={lang === 'en' ? "/tools/range-hood-extraction-efficiency-modeler/" : `/${lang}/tools/range-hood-extraction-efficiency-modeler/`}
        class="p-3 rounded-xl bg-surface-soft hover:bg-surface-strong border border-hairline transition-colors block"
      >
        <span class="font-semibold text-ink block mb-0.5">{c.crossLinkRangeHood} &rarr;</span>
        <span class="text-muted text-[11px]">Exhaust ventilation &amp; PM2.5 aerosol removal</span>
      </a>
    </div>
  </div>
</div>

<script define:vars={{ grillData, lang }}>
  // Interactive Simulation Logic
  const fuelSelect = document.getElementById('grill-fuel-select');
  const meatSelect = document.getElementById('meat-profile-select');
  const donenessSelect = document.getElementById('doneness-select');
  const marinadeSelect = document.getElementById('marinade-select');
  const geometrySelect = document.getElementById('geometry-select');
  const portionInput = document.getElementById('portion-size-input');
  const portionDisplay = document.getElementById('portion-display');
  const consumerSelect = document.getElementById('consumer-select');

  const statPahConc = document.getElementById('stat-pah-conc');
  const statHcaConc = document.getElementById('stat-hca-conc');
  const statBapRatio = document.getElementById('stat-bap-ratio');
  const statMealDose = document.getElementById('stat-meal-dose');
  const gradeCard = document.getElementById('safety-grade-card');
  const gradeBadge = document.getElementById('safety-grade-badge');
  const gradeDesc = document.getElementById('safety-grade-desc');
  const alertText = document.getElementById('diagnostic-alert-text');
  const btnCopy = document.getElementById('btn-copy-report');
  const copyConfirm = document.getElementById('copy-confirmation');

  function calculateExposure() {
    const fuel = grillData.grillFuelTypes.find(f => f.id === fuelSelect.value) || grillData.grillFuelTypes[0];
    const meat = grillData.meatProfiles.find(m => m.id === meatSelect.value) || grillData.meatProfiles[0];
    const doneness = grillData.cookingDoneness.find(d => d.id === donenessSelect.value) || grillData.cookingDoneness[0];
    const marinade = grillData.marinadeMitigations.find(m => m.id === marinadeSelect.value) || grillData.marinadeMitigations[0];
    const geometry = grillData.grillingGeometry.find(g => g.id === geometrySelect.value) || grillData.grillingGeometry[0];
    const portionG = parseInt(portionInput.value, 10);
    const consumer = grillData.consumerProfiles.find(c => c.id === consumerSelect.value) || grillData.consumerProfiles[0];

    portionDisplay.textContent = `${portionG}g`;

    // Mathematical modeling
    // Base PAH calculation: meat base * fuel pyrolysis * doneness multiplier * geometry multiplier * marinade multiplier
    const totalPahUgKg = (meat.basePahYield * (fuel.pahPyrolysisFactor / 3.0) * doneness.donenessPahMultiplier * geometry.pahMultiplier * marinade.pahMultiplier);
    
    // Benzo[a]pyrene is ~20% of total 4-PAH sum in high-temperature grill smoke
    const bapUgKg = totalPahUgKg * 0.20;
    const euBapLimit = 2.0; // µg/kg EU safe ceiling
    const bapPercentageOfLimit = Math.round((bapUgKg / euBapLimit) * 100);

    // Base HCA calculation: meat base * fuel radiant factor * doneness HCA multiplier * geometry HCA multiplier * marinade multiplier
    const totalHcaNgG = (meat.baseHcaYield * fuel.hcaRadiantFactor * doneness.donenessHcaMultiplier * geometry.hcaMultiplier * marinade.hcaMultiplier);

    // Total ingested per meal in micrograms
    const totalPahIngestedUg = (totalPahUgKg * (portionG / 1000)).toFixed(2);
    const totalHcaIngestedUg = (totalHcaNgG * (portionG / 1000)).toFixed(2);

    // Render Stats
    statPahConc.textContent = `${totalPahUgKg.toFixed(1)} µg/kg`;
    statHcaConc.textContent = `${totalHcaNgG.toFixed(1)} ng/g (µg/kg)`;
    statBapRatio.textContent = `${bapPercentageOfLimit}% of EU Limit (${bapUgKg.toFixed(2)} µg/kg)`;
    statMealDose.textContent = `${totalPahIngestedUg} µg PAHs / ${totalHcaIngestedUg} µg HCAs`;

    // Grade and color coding
    let grade = 'A';
    let gradeLabel = 'GRADE A (MINIMAL CARCINOGEN RISK)';
    let gradeColor = 'bg-emerald-600';
    let cardBg = 'bg-emerald-50 border-emerald-200 text-emerald-900';
    let desc = 'Outstanding safety configuration. PAH smoke aerosol and HCA formation are well below EU regulatory thresholds.';

    if (bapPercentageOfLimit > 300 || totalHcaNgG > 80) {
      grade = 'D';
      gradeLabel = 'GRADE D (CRITICAL CARCINOGEN HAZARD)';
      gradeColor = 'bg-rose-700';
      cardBg = 'bg-rose-50 border-rose-300 text-rose-950';
      desc = 'Extreme mutagen concentration. Charred meat bark contains massive concentrations of PhIP and Benzo[a]pyrene exceeding 3x the EU ceiling.';
    } else if (bapPercentageOfLimit > 150 || totalHcaNgG > 40) {
      grade = 'C';
      gradeLabel = 'GRADE C (HIGH MUTAGEN HAZARD)';
      gradeColor = 'bg-rose-600';
      cardBg = 'bg-rose-50 border-rose-200 text-rose-900';
      desc = 'Elevated polycyclic aromatic hydrocarbons from fat dripping on radiant coals, with moderate heterocyclic amine formation in surface meat crust.';
    } else if (bapPercentageOfLimit > 75 || totalHcaNgG > 15) {
      grade = 'B';
      gradeLabel = 'GRADE B (MODERATE EXPOSURE)';
      gradeColor = 'bg-amber-600';
      cardBg = 'bg-amber-50 border-amber-200 text-amber-900';
      desc = 'Acceptable single-meal exposure, but frequent consumption creates cumulative hepatic metabolic burden.';
    }

    gradeCard.className = `p-4 rounded-xl border mb-6 transition-colors ${cardBg}`;
    gradeBadge.className = `px-2.5 py-1 rounded-md text-xs font-extrabold uppercase text-white ${gradeColor}`;
    gradeBadge.textContent = gradeLabel;
    gradeDesc.textContent = desc;

    // Detailed alert narrative
    let narrative = '';
    if (geometry.id === 'indirect-two-zone') {
      narrative += 'Indirect two-zone setup effectively eliminates 92% of fat dripping flare-ups. ';
    }
    if (marinade.id.includes('rosemary') || marinade.id.includes('beer')) {
      narrative += 'Antioxidant marinade neutralizes free radical intermediates, halting heterocyclic amine assembly. ';
    } else if (marinade.id.includes('sugary')) {
      narrative += '⚠️ Early application of sugary glaze causes rapid surface caramelization and burnt carbon crust, multiplying carcinogens. ';
    }
    if (doneness.id === 'heavily-charred') {
      narrative += '⚠️ Heavily charred bark contains pyrolyzed polycyclic aromatics classified by the WHO IARC as Group 1 human carcinogens.';
    } else {
      narrative += 'Cooked to an optimal temperature profile minimizing thermal mutagen condensation.';
    }
    alertText.textContent = narrative;
  }

  // Event Listeners
  [fuelSelect, meatSelect, donenessSelect, marinadeSelect, geometrySelect, portionInput, consumerSelect].forEach(el => {
    el.addEventListener('change', calculateExposure);
    el.addEventListener('input', calculateExposure);
  });

  // Presets
  document.getElementById('preset-safe')?.addEventListener('click', () => {
    fuelSelect.value = 'propane-gas';
    meatSelect.value = 'chicken-thigh-skin';
    donenessSelect.value = 'medium';
    marinadeSelect.value = 'rosemary-herb-oil';
    geometrySelect.value = 'indirect-two-zone';
    portionInput.value = '200';
    consumerSelect.value = 'adult-70kg';
    calculateExposure();
  });

  document.getElementById('preset-charcoal')?.addEventListener('click', () => {
    fuelSelect.value = 'charcoal-briquettes';
    meatSelect.value = 'beef-ribeye-burger';
    donenessSelect.value = 'well-done';
    marinadeSelect.value = 'no-marinade-unseasoned';
    geometrySelect.value = 'direct-close-embers';
    portionInput.value = '250';
    consumerSelect.value = 'adult-70kg';
    calculateExposure();
  });

  document.getElementById('preset-welldone')?.addEventListener('click', () => {
    fuelSelect.value = 'hardwood-lump';
    meatSelect.value = 'chicken-thigh-skin';
    donenessSelect.value = 'heavily-charred';
    marinadeSelect.value = 'sugary-bbq-sauce-early';
    geometrySelect.value = 'direct-close-embers';
    portionInput.value = '300';
    consumerSelect.value = 'adult-70kg';
    calculateExposure();
  });

  document.getElementById('preset-smoked')?.addEventListener('click', () => {
    fuelSelect.value = 'wood-pellet-smoker';
    meatSelect.value = 'beef-ribeye-burger';
    donenessSelect.value = 'medium';
    marinadeSelect.value = 'dark-beer-marinade';
    geometrySelect.value = 'indirect-two-zone';
    portionInput.value = '350';
    consumerSelect.value = 'adult-70kg';
    calculateExposure();
  });

  // Copy Report
  btnCopy?.addEventListener('click', () => {
    const reportText = `[ISITKITCHENSAFE TOXICOLOGY REPORT: GRILL PAH & HCA AUDIT]
Date: ${new Date().toISOString()}
Heat Source: ${fuelSelect.options[fuelSelect.selectedIndex].text}
Meat Substrate: ${meatSelect.options[meatSelect.selectedIndex].text}
Surface Doneness: ${donenessSelect.options[donenessSelect.selectedIndex].text}
Marinade Chemistry: ${marinadeSelect.options[marinadeSelect.selectedIndex].text}
Grilling Geometry: ${geometrySelect.options[geometrySelect.selectedIndex].text}
Portion: ${portionInput.value}g
Consumer: ${consumerSelect.options[consumerSelect.selectedIndex].text}

DIAGNOSTIC TELEMETRY:
- Total PAHs: ${statPahConc.textContent}
- Total HCAs (PhIP/MeIQx): ${statHcaConc.textContent}
- Benzo[a]pyrene Status: ${statBapRatio.textContent}
- Ingested Mutagen Dose: ${statMealDose.textContent}
- Safety Grade: ${gradeBadge.textContent}
- Summary: ${gradeDesc.textContent}

Evidence-Based Action:
1. Use 2-Zone indirect grilling with a water drip pan to prevent fat drip pyrolysis.
2. Marinate with dark beer or fresh rosemary for 30 min (-85% HCAs).
3. Apply sweet glazes only in the final 3-5 minutes of grilling.`;

    navigator.clipboard.writeText(reportText).then(() => {
      copyConfirm.classList.remove('hidden');
      setTimeout(() => copyConfirm.classList.add('hidden'), 3500);
    });
  });

  // Initial Calculation
  calculateExposure();
</script>
