    inletPressureHelp: "反応器流入前の流体駆動静圧。局所流速とキャビテーション初生条件を直接支配します。",
    backpressureLabel: "下流側制御背圧 (bar)：",
    backpressureHelp: "下流調整弁による制御背圧。キャビテーション数（σ）と気泡圧壊の局所衝撃強度を決定します。",
    tempLabel: "流体プロセス処理温度 (°C)：",
    tempHelp: "キャビテーションチャンバー流入温度。タンパク質変性を防止する厳格な非加熱域（<50°C）を維持。",
    flowRateLabel: "連続処理体積流量 (L/h)：",
    flowRateHelp: "水力キャビテーションスキッドを通過する連続時間あたり処理流量。",
    presetsTitle: "サニタリー水力キャビテーション標準バリデーションプリセット",
    presetDairy: "全脂乳ナノ均質化＆非加熱低温殺菌 (ローター・ステーター, 18 bar, 3.5 bar, 25°C, リステリア菌)",
    presetJuice: "コールドプレス柑橘果汁の非加熱常温安定化 (ベンチュリ孔板, 45 bar, 4.0 bar, 18°C, 大腸菌)",
    presetOat: "バリスタ用オーツミルクのナノ乳化テクスチャー制御 (ヘリカル音響, 22 bar, 3.0 bar, 22°C, 酵母)",
    presetPuree: "高粘度トマトピューレの繊維微細化・増粘 (ベンチュリ孔板, 60 bar, 5.0 bar, 32°C, サルモネラ菌)",
    presetHazard: "激しい壊食ピッティング＆水撃失控状態 (摩耗絞り弁, 15 bar, 0.2 bar, 58°C, 背圧喪失)",
    diagnosticTitle: "キャビテーション速度論・殺菌能・レオロジー総合診断",
    diagnosticSub: "無次元キャビテーション数（σ）、気泡圧壊衝撃圧力、OHラジカル発生束、病原菌対数減少率、エマルションナノ粒子径、およびCIP/SIP状態をリアルタイム計算。",
    cavitationNumberLabel: "無次元水力キャビテーション数 (σ)",
    collapsePressureLabel: "気泡圧壊過渡衝撃圧力 (P_shock)",
    radicalFluxLabel: "ソノケミカルヒドロキシラジカル束 (•OH)",
    logReductionLabel: "対象菌対数減少値 (Log10 Kill)",
    particleSizeLabel: "エマルション体積平均粒子径 (D_4,3)",
    bulkTempRiseLabel: "断熱粘性散逸温度上昇 (ΔT)",
    acousticNoiseLabel: "運転音圧レベル騒音 (SPL)",
    complianceStatusLabel: "衛生規格認証＆プロセス信頼性状態",
    primaryLimitationLabel: "主要流体力学限界＆物性制約",
    mitigationActionLabel: "推奨衛生エンジニアリング対策",
    scienceTitle: "水力キャビテーション流体力学、気泡動態＆非加熱殺菌工学",
    scienceSub: "Rayleigh-Plesset気泡非線形振動論、チョークドキャビテーション限界、ソノケミカル水解離ラジカル反応、マイクロジェット機械的穿孔およびナノ均質化メカニズムの技術的詳解。",
    tableTitle: "水力キャビテーション反応システムおよび代表的食品流体物性仕様表"
  }
};

const d = DICT[lang] || DICT.en;
---

<div class="bg-surface border border-hairline rounded-3xl p-6 sm:p-10 shadow-xs mb-12">
  <!-- Header Bar -->
  <div class="flex flex-wrap items-center justify-between gap-4 border-b border-hairline pb-6 mb-8">
    <div>
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-cyan-700 text-white mb-3">
        {d.badge}
      </span>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-ink tracking-tight">
        {d.title}
      </h1>
      <p class="text-body text-sm sm:text-base mt-2 max-w-4xl leading-relaxed">
        {d.subtitle}
      </p>
    </div>
  </div>

  <!-- Presets Bar -->
  <div class="mb-10 bg-surface-soft border border-hairline rounded-2xl p-5">
    <h3 class="text-xs font-bold uppercase tracking-wider text-muted mb-3">
      {d.presetsTitle}
    </h3>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-2.5">
      <button
        type="button"
        id="btn-preset-dairy"
        class="text-left px-3.5 py-2.5 rounded-xl border border-hairline bg-surface hover:border-cyan-600 hover:text-cyan-700 text-xs font-medium text-ink transition-all shadow-2xs"
      >
        🥛 {d.presetDairy}
      </button>
      <button
        type="button"
        id="btn-preset-juice"
        class="text-left px-3.5 py-2.5 rounded-xl border border-hairline bg-surface hover:border-cyan-600 hover:text-cyan-700 text-xs font-medium text-ink transition-all shadow-2xs"
      >
        🍊 {d.presetJuice}
      </button>
      <button
        type="button"
        id="btn-preset-oat"
        class="text-left px-3.5 py-2.5 rounded-xl border border-hairline bg-surface hover:border-cyan-600 hover:text-cyan-700 text-xs font-medium text-ink transition-all shadow-2xs"
      >
        🌾 {d.presetOat}
      </button>
      <button
        type="button"
        id="btn-preset-puree"
        class="text-left px-3.5 py-2.5 rounded-xl border border-hairline bg-surface hover:border-cyan-600 hover:text-cyan-700 text-xs font-medium text-ink transition-all shadow-2xs"
      >
        🍅 {d.presetPuree}
      </button>
      <button
        type="button"
        id="btn-preset-hazard"
        class="text-left px-3.5 py-2.5 rounded-xl border border-rose-300 bg-rose-50/70 hover:bg-rose-100/80 text-xs font-medium text-rose-800 transition-all shadow-2xs"
      >
        ⚠️ {d.presetHazard}
      </button>
    </div>
  </div>

  <!-- Interactive Grid: Controls & Real-Time Engine -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-12">
    <!-- Left Column: Controls (5 Cols) -->
    <div class="lg:col-span-5 space-y-6">
      <div class="bg-surface-soft border border-hairline rounded-2xl p-6">
        <h2 class="text-base font-bold text-ink mb-1">
          {d.controlsTitle}
        </h2>
        <p class="text-xs text-muted mb-6 leading-relaxed">
          {d.controlsSub}
        </p>

        <div class="space-y-5 text-sm">
          <!-- Reactor Selection -->
          <div>
            <label for="chc-reactor" class="block font-semibold text-ink text-xs mb-1">
              {d.reactorLabel}
            </label>
            <select
              id="chc-reactor"
              class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-xs text-ink focus:outline-hidden focus:ring-2 focus:ring-cyan-600"
            >
              {chcData.cavitationReactors.map(r => (
                <option value={r.id}>{r.name}</option>
              ))}
            </select>
            <span class="block text-2xs text-muted mt-1 leading-tight">{d.reactorHelp}</span>
          </div>

          <!-- Fluid Selection -->
          <div>
            <label for="chc-fluid" class="block font-semibold text-ink text-xs mb-1">
              {d.fluidLabel}
            </label>
            <select
              id="chc-fluid"
              class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-xs text-ink focus:outline-hidden focus:ring-2 focus:ring-cyan-600"
            >
              {chcData.fluidMedia.map(f => (
                <option value={f.id}>{f.name}</option>
              ))}
            </select>
            <span class="block text-2xs text-muted mt-1 leading-tight">{d.fluidHelp}</span>
          </div>

          <!-- Pathogen Selection -->
          <div>
            <label for="chc-pathogen" class="block font-semibold text-ink text-xs mb-1">
              {d.pathogenLabel}
            </label>
            <select
              id="chc-pathogen"
              class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-xs text-ink focus:outline-hidden focus:ring-2 focus:ring-cyan-600"
            >
              {chcData.targetPathogens.map(p => (
                <option value={p.id}>{p.name}</option>
              ))}
            </select>
            <span class="block text-2xs text-muted mt-1 leading-tight">{d.pathogenHelp}</span>
          </div>

          <!-- Sanitary Skid Selection -->
          <div>
            <label for="chc-sanitary" class="block font-semibold text-ink text-xs mb-1">
              {d.sanitaryLabel}
            </label>
            <select
              id="chc-sanitary"
              class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-xs text-ink focus:outline-hidden focus:ring-2 focus:ring-cyan-600"
            >
              {chcData.sanitaryConfigurations.map(s => (
                <option value={s.id}>{s.name}</option>
              ))}
            </select>
            <span class="block text-2xs text-muted mt-1 leading-tight">{d.sanitaryHelp}</span>
          </div>

          <!-- Sliders -->
          <!-- Upstream Inlet Pressure -->
          <div class="pt-2 border-t border-hairline/60">
            <div class="flex justify-between items-center mb-1">
              <label for="slider-inlet-pressure" class="font-semibold text-ink text-xs">
                {d.inletPressureLabel}
              </label>
              <span id="val-inlet-pressure" class="font-mono text-xs font-bold text-cyan-800 bg-cyan-50 px-2 py-0.5 rounded-md">
                18.0 bar
              </span>
            </div>
            <input
              type="range"
              id="slider-inlet-pressure"
              min="5"
              max="80"
              step="1"
              value="18"
              class="w-full accent-cyan-700 cursor-pointer"
            />
            <span class="block text-2xs text-muted mt-0.5">{d.inletPressureHelp}</span>
          </div>

          <!-- Downstream Backpressure -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label for="slider-backpressure" class="font-semibold text-ink text-xs">
                {d.backpressureLabel}
              </label>
              <span id="val-backpressure" class="font-mono text-xs font-bold text-cyan-800 bg-cyan-50 px-2 py-0.5 rounded-md">
                3.5 bar
              </span>
            </div>
            <input
              type="range"
              id="slider-backpressure"
              min="0.2"
              max="12.0"
              step="0.1"
              value="3.5"
              class="w-full accent-cyan-700 cursor-pointer"
            />
            <span class="block text-2xs text-muted mt-0.5">{d.backpressureHelp}</span>
          </div>

          <!-- Process Temperature -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label for="slider-temp" class="font-semibold text-ink text-xs">
                {d.tempLabel}
              </label>
              <span id="val-temp" class="font-mono text-xs font-bold text-cyan-800 bg-cyan-50 px-2 py-0.5 rounded-md">
                25.0 °C
              </span>
            </div>
            <input
              type="range"
              id="slider-temp"
              min="10"
              max="65"
              step="1"
              value="25"
              class="w-full accent-cyan-700 cursor-pointer"
            />
            <span class="block text-2xs text-muted mt-0.5">{d.tempHelp}</span>
          </div>

          <!-- Flow Rate -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label for="slider-flow" class="font-semibold text-ink text-xs">
                {d.flowRateLabel}
              </label>
              <span id="val-flow" class="font-mono text-xs font-bold text-cyan-800 bg-cyan-50 px-2 py-0.5 rounded-md">
                5,000 L/h
              </span>
            </div>
            <input
              type="range"
              id="slider-flow"
              min="500"
              max="12000"
              step="250"
              value="5000"
              class="w-full accent-cyan-700 cursor-pointer"
            />
            <span class="block text-2xs text-muted mt-0.5">{d.flowRateHelp}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Diagnostics, Gauges & Physics (7 Cols) -->
    <div class="lg:col-span-7 space-y-6">
      <div class="bg-surface-soft border border-hairline rounded-2xl p-6">
        <div class="flex items-center justify-between border-b border-hairline/60 pb-3 mb-6">
          <div>
            <h2 class="text-base font-bold text-ink">
              {d.diagnosticTitle}
            </h2>
            <p class="text-xs text-muted mt-0.5">
              {d.diagnosticSub}
            </p>
          </div>
          <span id="live-indicator" class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-2xs font-bold uppercase bg-emerald-100 text-emerald-800">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 animate-pulse"></span>
            ACTIVE CAVITATION REGIME
          </span>
        </div>

        <!-- 6 Core Metric Badges Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3.5 mb-6">
          <!-- Cavitation Number -->
          <div class="bg-surface border border-hairline rounded-xl p-3.5 flex flex-col justify-between">
            <span class="text-2xs font-semibold text-muted leading-tight">{d.cavitationNumberLabel}</span>
            <div class="mt-2">
              <span id="metric-cavitation-number" class="text-lg font-black text-ink font-mono">0.14</span>
              <span class="text-xs text-muted font-normal ml-0.5">σ</span>
            </div>
            <span id="sub-cavitation-number" class="text-2xs text-emerald-600 font-medium mt-1">Super-Cavitation (σ &lt; 0.20)</span>
          </div>

          <!-- Bubble Collapse Shock Pressure -->
          <div class="bg-surface border border-hairline rounded-xl p-3.5 flex flex-col justify-between">
            <span class="text-2xs font-semibold text-muted leading-tight">{d.collapsePressureLabel}</span>
            <div class="mt-2">
              <span id="metric-collapse-pressure" class="text-lg font-black text-cyan-800 font-mono">2,350</span>
              <span class="text-xs text-muted font-normal ml-0.5">bar</span>
            </div>
            <span id="sub-collapse-pressure" class="text-2xs text-emerald-600 font-medium mt-1">Extreme Micro-Jet Shear</span>
          </div>

          <!-- Hydroxyl Radical Flux -->
          <div class="bg-surface border border-hairline rounded-xl p-3.5 flex flex-col justify-between">
            <span class="text-2xs font-semibold text-muted leading-tight">{d.radicalFluxLabel}</span>
            <div class="mt-2">
              <span id="metric-radical-flux" class="text-lg font-black text-ink font-mono">18.2</span>
              <span class="text-xs text-muted font-normal ml-0.5">µmol/L</span>
            </div>
            <span id="sub-radical-flux" class="text-2xs text-emerald-600 font-medium mt-1">Sonochemical Water Sonolysis</span>
          </div>

          <!-- Pathogen Log10 Reduction -->
          <div class="bg-surface border border-hairline rounded-xl p-3.5 flex flex-col justify-between">
            <span class="text-2xs font-semibold text-muted leading-tight">{d.logReductionLabel}</span>
            <div class="mt-2">
              <span id="metric-log-reduction" class="text-lg font-black text-emerald-600 font-mono">5.42</span>
              <span class="text-xs text-muted font-normal ml-0.5">log₁₀</span>
            </div>
            <span id="sub-log-reduction" class="text-2xs text-emerald-600 font-medium mt-1">FDA 5-log Target Met</span>
          </div>

          <!-- Nano-Particle Droplet Size -->
          <div class="bg-surface border border-hairline rounded-xl p-3.5 flex flex-col justify-between">
            <span class="text-2xs font-semibold text-muted leading-tight">{d.particleSizeLabel}</span>
            <div class="mt-2">
              <span id="metric-particle-size" class="text-lg font-black text-cyan-800 font-mono">168</span>
              <span class="text-xs text-muted font-normal ml-0.5">nm</span>
            </div>
            <span id="sub-particle-size" class="text-2xs text-emerald-600 font-medium mt-1">Sub-Micron Nano-Emulsion</span>
          </div>

          <!-- Bulk Adiabatic Temp Rise -->
          <div class="bg-surface border border-hairline rounded-xl p-3.5 flex flex-col justify-between">
            <span class="text-2xs font-semibold text-muted leading-tight">{d.bulkTempRiseLabel}</span>
            <div class="mt-2">
              <span id="metric-temp-rise" class="text-lg font-black text-ink font-mono">+3.8</span>
              <span class="text-xs text-muted font-normal ml-0.5">°C</span>
            </div>
            <span id="sub-temp-rise" class="text-2xs text-emerald-600 font-medium mt-1">Non-Thermal (&lt; 50°C Safe)</span>
          </div>
        </div>

        <!-- Dynamic Cavitation Reactor & Micro-Bubble SVG Diagram -->
        <div class="bg-surface border border-hairline rounded-2xl p-5 mb-6">
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-bold text-ink uppercase tracking-wider">
              Hydrodynamic Cavitation Chamber &amp; Bubble Collapse Dynamics
            </span>
            <span id="flow-status-tag" class="text-2xs font-semibold text-cyan-700 bg-cyan-50 px-2 py-0.5 rounded-full">
              Stable Vortex Cavitation
            </span>
          </div>
          
          <div class="w-full bg-slate-950 rounded-xl p-4 overflow-hidden flex items-center justify-center">
            <svg viewBox="0 0 540 220" class="w-full h-auto max-h-56 select-none" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <linearGradient id="chcFluidGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                  <stop offset="0%" stop-color="#0284c7" stop-opacity="0.9" />
                  <stop offset="35%" stop-color="#06b6d4" stop-opacity="0.95" />
                  <stop offset="70%" stop-color="#0284c7" stop-opacity="0.9" />
                  <stop offset="100%" stop-color="#0369a1" stop-opacity="0.95" />
                </linearGradient>
                <radialGradient id="bubbleCollapseGrad" cx="50%" cy="50%" r="50%">
                  <stop offset="0%" stop-color="#ffffff" stop-opacity="1" />
                  <stop offset="40%" stop-color="#fef08a" stop-opacity="0.9" />
                  <stop offset="80%" stop-color="#06b6d4" stop-opacity="0.4" />
                  <stop offset="100%" stop-color="#0891b2" stop-opacity="0" />
                </radialGradient>
                <filter id="chcGlow" x="-20%" y="-20%" width="140%" height="140%">
                  <feGaussianBlur stdDeviation="3" result="blur" />
                  <feComposite in="SourceGraphic" in2="blur" operator="over" />
                </filter>
              </defs>

              <!-- Reactor Housing Wall (Sanitary 316L SS) -->
              <rect x="20" y="25" width="500" height="170" rx="14" fill="#0f172a" stroke="#334155" stroke-width="3" />
              
              <!-- Inlet Nozzle -->
              <rect x="5" y="80" width="30" height="60" rx="3" fill="#1e293b" stroke="#475569" stroke-width="2" />
              <text x="18" y="115" fill="#94a3b8" font-size="10" font-family="monospace" text-anchor="middle" transform="rotate(-90 18 115)">FEED</text>

              <!-- Fluid Flow Stream -->
              <path d="M 30,85 L 140,85 Q 170,105 210,105 L 340,105 Q 380,85 410,85 L 505,85 L 505,135 L 410,135 Q 380,115 340,115 L 210,115 Q 170,135 140,135 L 30,135 Z" fill="url(#chcFluidGrad)" opacity="0.85" />

              <!-- Cavitation Orifice / Rotor Constriction -->
              <rect id="svg-constriction-top" x="180" y="35" width="28" height="58" rx="4" fill="#334155" stroke="#64748b" stroke-width="2" />
              <rect id="svg-constriction-bottom" x="180" y="127" width="28" height="58" rx="4" fill="#334155" stroke="#64748b" stroke-width="2" />
              
              <!-- High-Speed Cavitation Jet Throat -->
              <rect x="182" y="93" width="24" height="34" fill="#38bdf8" opacity="0.3" />
              
              <!-- Cavitation Bubble Cloud Generation Zone -->
              <g id="svg-bubble-cloud">
                <!-- Growing Micro-Bubbles -->
                <circle cx="225" cy="100" r="4.5" fill="#e0f2fe" stroke="#38bdf8" stroke-width="1.5" />
                <circle cx="238" cy="118" r="6" fill="#e0f2fe" stroke="#38bdf8" stroke-width="1.5" />
                <circle cx="255" cy="98" r="8.5" fill="#bae6fd" stroke="#0284c7" stroke-width="1.8" />
                <circle cx="270" cy="115" r="11" fill="#bae6fd" stroke="#0284c7" stroke-width="2" />
                
                <!-- Maximum Expansion & Violent Asymmetric Collapse Hotspot -->
                <circle cx="300" cy="108" r="14" fill="url(#bubbleCollapseGrad)" stroke="#fef08a" stroke-width="2.5" filter="url(#chcGlow)" />
                <circle cx="328" cy="102" r="10" fill="url(#bubbleCollapseGrad)" stroke="#fef08a" stroke-width="2" />

                <!-- Shockwave Wavefronts -->
                <ellipse cx="300" cy="108" rx="22" ry="18" fill="none" stroke="#fef08a" stroke-width="1.5" stroke-dasharray="3,3" opacity="0.8" />
                <ellipse cx="300" cy="108" rx="32" ry="26" fill="none" stroke="#38bdf8" stroke-width="1" stroke-dasharray="4,4" opacity="0.6" />
                
                <!-- Sonochemical Micro-Jets -->
                <line x1="292" y1="108" x2="308" y2="108" stroke="#ffffff" stroke-width="3" stroke-linecap="round" />
                <line x1="300" y1="100" x2="300" y2="116" stroke="#ffffff" stroke-width="3" stroke-linecap="round" />
              </g>

              <!-- Downstream Nano-Homogenized Stream -->
              <g id="svg-nano-droplets">
                <circle cx="380" cy="95" r="2" fill="#ffffff" opacity="0.9" />
                <circle cx="395" cy="112" r="1.8" fill="#ffffff" opacity="0.9" />
                <circle cx="415" cy="104" r="2.2" fill="#ffffff" opacity="0.9" />
                <circle cx="435" cy="98" r="1.5" fill="#ffffff" opacity="0.9" />
                <circle cx="455" cy="118" r="2" fill="#ffffff" opacity="0.9" />
                <circle cx="475" cy="105" r="1.8" fill="#ffffff" opacity="0.9" />
              </g>

              <!-- Discharge Outlet Nozzle -->
              <rect x="505" y="80" width="30" height="60" rx="3" fill="#1e293b" stroke="#475569" stroke-width="2" />
              <text x="522" y="115" fill="#94a3b8" font-size="10" font-family="monospace" text-anchor="middle" transform="rotate(90 522 115)">OUTLET</text>

              <!-- Annotations -->
              <text x="75" y="55" fill="#38bdf8" font-size="11" font-weight="bold" font-family="sans-serif">P_in (Feed Pressure)</text>
              <text x="180" y="22" fill="#cbd5e1" font-size="10" font-family="monospace">Vena Contracta</text>
              <text x="260" y="160" fill="#fef08a" font-size="11" font-weight="bold" font-family="sans-serif">Collapse: &gt;1,000 bar • •OH Radicals</text>
              <text x="420" y="55" fill="#38bdf8" font-size="11" font-weight="bold" font-family="sans-serif">P_back (Backpressure)</text>
              <text x="420" y="165" fill="#94a3b8" font-size="10" font-family="sans-serif">Sub-Micron Nano-Emulsion</text>
            </svg>
          </div>
        </div>

        <!-- Compliance & Engineering Status Banner -->
        <div class="bg-surface border border-hairline rounded-2xl p-5 space-y-4">
          <div>
            <span class="text-2xs font-bold text-muted uppercase tracking-wider block mb-1">
              {d.complianceStatusLabel}
            </span>
            <div id="compliance-badge" class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl text-xs font-bold bg-emerald-50 border border-emerald-300 text-emerald-800">
              <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
              <span id="compliance-text">FULL COMPLIANCE: 3-A Sanitary 04-05 &bull; EHEDG Class 1 Aseptic &bull; FDA Juice HACCP 5-log</span>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-3 border-t border-hairline/60 text-xs">
            <div>
              <span class="font-bold text-ink block mb-0.5">{d.primaryLimitationLabel}</span>
              <p id="limitation-text" class="text-muted leading-relaxed">
                Rotor cavitation shear is optimal. Backpressure safely confines bubble collapse inside fluid core, preventing cavitation pitting on 316L chamber walls.
              </p>
            </div>
            <div>
              <span class="font-bold text-ink block mb-0.5">{d.mitigationActionLabel}</span>
              <p id="mitigation-text" class="text-muted leading-relaxed">
                Maintain downstream backpressure &gt; 3.0 bar to avoid vapor flashing. Inspect sanitary mechanical seal face during scheduled 1,500-hour CIP cycle.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Deep Engineering Science Section -->
  <div class="border-t border-hairline pt-10 mb-12">
    <div class="max-w-3xl mb-8">
      <h2 class="text-xl sm:text-2xl font-bold text-ink tracking-tight">
        {d.scienceTitle}
      </h2>
      <p class="text-body text-sm mt-2 leading-relaxed">
        {d.scienceSub}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-sm">
      <div class="bg-surface-soft border border-hairline rounded-2xl p-6">
        <div class="w-8 h-8 rounded-lg bg-cyan-100 text-cyan-800 font-bold flex items-center justify-center mb-4 text-sm font-mono">
          01
        </div>
        <h3 class="font-bold text-ink text-base mb-2">
          Hydrodynamic Cavitation Number (σ) &amp; Rayleigh-Plesset Bubble Kinetics
        </h3>
        <p class="text-body text-xs leading-relaxed mb-3">
          Hydrodynamic cavitation occurs when fluid static pressure falls below its vapor pressure (<span class="font-mono font-semibold">P_v</span>) in constriction zones:
        </p>
        <div class="bg-surface border border-hairline rounded-xl p-3 font-mono text-2xs text-ink mb-3 overflow-x-auto">
          σ = (P_down - P_v) / (0.5 · ρ · v²)
        </div>
        <p class="text-muted text-xs leading-relaxed">
          When <span class="font-mono text-ink">σ &lt; 0.20</span>, intense cloud cavitation develops. Micro-bubbles expand radially according to the Rayleigh-Plesset differential equation and subsequently collapse asymmetrically, producing liquid micro-jets exceeding <span class="font-semibold text-ink">100 m/s</span> and shock pressures over <span class="font-semibold text-ink">1,500 bar</span>.
        </p>
      </div>

      <div class="bg-surface-soft border border-hairline rounded-2xl p-6">
        <div class="w-8 h-8 rounded-lg bg-cyan-100 text-cyan-800 font-bold flex items-center justify-center mb-4 text-sm font-mono">
          02
        </div>
        <h3 class="font-bold text-ink text-base mb-2">
          Sonochemical Hydroxyl Radical (•OH) Water Homolysis &amp; Pathogen Lethality
        </h3>
        <p class="text-body text-xs leading-relaxed mb-3">
          Adiabatic compression inside collapsing cavitation cavities creates transient thermal hotspots (<span class="font-mono font-semibold">T &gt; 3,500 K</span>):
        </p>
        <div class="bg-surface border border-hairline rounded-xl p-3 font-mono text-2xs text-ink mb-3 overflow-x-auto">
          H₂O + Cavitation Shock → •H + •OH
        </div>
        <p class="text-muted text-xs leading-relaxed">
          Highly reactive hydroxyl radicals (<span class="font-mono text-ink">•OH</span>) react instantaneously with unsaturated lipids in microbial cell membranes, causing lipid peroxidation. Concurrently, intense hydraulic shear stress mechanically cleaves cell walls of <span class="italic text-ink">L. monocytogenes</span>, <span class="italic text-ink">E. coli</span>, and spoilage yeasts without bulk thermal heat.
        </p>
      </div>

      <div class="bg-surface-soft border border-hairline rounded-2xl p-6">
        <div class="w-8 h-8 rounded-lg bg-cyan-100 text-cyan-800 font-bold flex items-center justify-center mb-4 text-sm font-mono">
          03
        </div>
        <h3 class="font-bold text-ink text-base mb-2">
          Sub-Micron Nano-Emulsification &amp; Native Protein Preservation
        </h3>
        <p class="text-body text-xs leading-relaxed mb-3">
          Extreme turbulent shear strain rates (<span class="font-mono font-semibold">γ̇ &gt; 10⁵ s⁻¹</span>) disrupt colloidal fat globules and macromolecular aggregates:
        </p>
        <div class="bg-surface border border-hairline rounded-xl p-3 font-mono text-2xs text-ink mb-3 overflow-x-auto">
          D_4,3 ∝ (We_crit · γ / ρ_c)^0.6 · (ε_diss)^-0.4
        </div>
        <p class="text-muted text-xs leading-relaxed">
          In dairy and plant-based emulsions, lipid droplet diameters drop below <span class="font-semibold text-ink">180 nm</span>, preventing creaming sedimentation. Because bulk process temperature remains below <span class="font-semibold text-ink">45°C</span>, immunoglobulins, lactoferrin, and Vitamin C retain &gt;95% of native bioactivity without Maillard browning.
        </p>
      </div>
    </div>
  </div>

  <!-- Technical Specs Reference Table -->
  <div class="border-t border-hairline pt-8">
    <h3 class="text-sm font-bold text-ink uppercase tracking-wider mb-4">
      {d.tableTitle}
    </h3>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs border border-hairline rounded-xl overflow-hidden">
        <thead class="bg-surface-soft text-muted font-bold border-b border-hairline">
          <tr>
            <th class="p-3">Reactor Model</th>
            <th class="p-3">Cavitation Mechanism</th>
            <th class="p-3">Max Pressure</th>
            <th class="p-3">Cavitation Number (σ)</th>
            <th class="p-3">Throughput (L/h)</th>
            <th class="p-3">Sanitary Certification</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline">
          {chcData.cavitationReactors.map(r => (
            <tr class="hover:bg-surface-soft/50 transition-colors">
              <td class="p-3 font-semibold text-ink">{r.name}</td>
              <td class="p-3 text-muted">{r.classification}</td>
              <td class="p-3 font-mono">{r.maxDischargePressureBar} bar</td>
              <td class="p-3 font-mono font-semibold text-cyan-800">{r.cavitationNumberSigma}</td>
              <td class="p-3 font-mono">{r.maxThroughputLitersPerHour.toLocaleString()} L/h</td>
              <td class="p-3 text-2xs text-muted">{r.sanitaryCertifications}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</div>

<script is:inline define:vars={{ chcData }}>
  document.addEventListener('DOMContentLoaded', () => {
    // Controls
    const selReactor = document.getElementById('chc-reactor');
    const selFluid = document.getElementById('chc-fluid');
    const selPathogen = document.getElementById('chc-pathogen');
    const selSanitary = document.getElementById('chc-sanitary');

    // Sliders
    const sliderInletPressure = document.getElementById('slider-inlet-pressure');
    const sliderBackpressure = document.getElementById('slider-backpressure');
    const sliderTemp = document.getElementById('slider-temp');
    const sliderFlow = document.getElementById('slider-flow');

    // Value Badges
    const valInletPressure = document.getElementById('val-inlet-pressure');
    const valBackpressure = document.getElementById('val-backpressure');
    const valTemp = document.getElementById('val-temp');
    const valFlow = document.getElementById('val-flow');

    // Diagnostic Metrics
    const metricCavitationNumber = document.getElementById('metric-cavitation-number');
    const subCavitationNumber = document.getElementById('sub-cavitation-number');
    const metricCollapsePressure = document.getElementById('metric-collapse-pressure');
    const subCollapsePressure = document.getElementById('sub-collapse-pressure');
    const metricRadicalFlux = document.getElementById('metric-radical-flux');
    const subRadicalFlux = document.getElementById('sub-radical-flux');
    const metricLogReduction = document.getElementById('metric-log-reduction');
    const subLogReduction = document.getElementById('sub-log-reduction');
    const metricParticleSize = document.getElementById('metric-particle-size');
    const subParticleSize = document.getElementById('sub-particle-size');
    const metricTempRise = document.getElementById('metric-temp-rise');
    const subTempRise = document.getElementById('sub-temp-rise');

    // Status Tags & Compliance
    const flowStatusTag = document.getElementById('flow-status-tag');
    const complianceBadge = document.getElementById('compliance-badge');
    const complianceText = document.getElementById('compliance-text');
    const limitationText = document.getElementById('limitation-text');
    const mitigationText = document.getElementById('mitigation-text');

    // Preset Buttons
    const btnDairy = document.getElementById('btn-preset-dairy');
    const btnJuice = document.getElementById('btn-preset-juice');
    const btnOat = document.getElementById('btn-preset-oat');
    const btnPuree = document.getElementById('btn-preset-puree');
    const btnHazard = document.getElementById('btn-preset-hazard');

    function applyPreset(reactorId, fluidId, pathogenId, sanitaryId, inletP, backP, tempC, flowLh) {
      if (selReactor) selReactor.value = reactorId;
      if (selFluid) selFluid.value = fluidId;
      if (selPathogen) selPathogen.value = pathogenId;
      if (selSanitary) selSanitary.value = sanitaryId;
      if (sliderInletPressure) sliderInletPressure.value = inletP;
      if (sliderBackpressure) sliderBackpressure.value = backP;
      if (sliderTemp) sliderTemp.value = tempC;
      if (sliderFlow) sliderFlow.value = flowLh;
      recalculate();
    }

    if (btnDairy) {
      btnDairy.addEventListener('click', () => {
        applyPreset('rotor_stator_shockwave_reactor', 'dairy_whole_milk_wpc', 'listeria_monocytogenes', 'sanitary_3a_ehedg_skid', 18, 3.5, 25, 5000);
      });
    }

    if (btnJuice) {
      btnJuice.addEventListener('click', () => {
        applyPreset('multi_orifice_venturi_plate', 'cold_pressed_citrus_juice', 'escherichia_coli_o157h7', 'sanitary_3a_ehedg_skid', 45, 4.0, 18, 4000);
      });
    }

    if (btnOat) {
      btnOat.addEventListener('click', () => {
        applyPreset('swirl_vortex_acoustic_cavitator', 'plant_based_oat_almond_emulsion', 'saccharomyces_cerevisiae_yeast', 'sanitary_3a_ehedg_skid', 22, 3.0, 22, 3500);
      });
    }

    if (btnPuree) {
      btnPuree.addEventListener('click', () => {
        applyPreset('multi_orifice_venturi_plate', 'high_viscosity_tomato_puree', 'salmonella_enterica_typhimurium', 'standard_industrial_sanitary_skid', 60, 5.0, 32, 2500);
      });
    }

    if (btnHazard) {
      btnHazard.addEventListener('click', () => {
        applyPreset('eroded_pitted_throttle_cavitator', 'high_viscosity_tomato_puree', 'listeria_monocytogenes', 'unbuffered_eroded_line', 15, 0.2, 58, 1500);
      });
    }

    function recalculate() {
      const inletP = parseFloat(sliderInletPressure.value);
      const backP = parseFloat(sliderBackpressure.value);
      const tempC = parseFloat(sliderTemp.value);
      const flowLh = parseFloat(sliderFlow.value);

      valInletPressure.textContent = `${inletP.toFixed(1)} bar`;
      valBackpressure.textContent = `${backP.toFixed(1)} bar`;
      valTemp.textContent = `${tempC.toFixed(1)} °C`;
      valFlow.textContent = `${flowLh.toLocaleString()} L/h`;

      const reactor = chcData.cavitationReactors.find(r => r.id === selReactor.value) || chcData.cavitationReactors[0];
      const fluid = chcData.fluidMedia.find(f => f.id === selFluid.value) || chcData.fluidMedia[0];
      const pathogen = chcData.targetPathogens.find(p => p.id === selPathogen.value) || chcData.targetPathogens[0];
      const sanitary = chcData.sanitaryConfigurations.find(s => s.id === selSanitary.value) || chcData.sanitaryConfigurations[0];

      const isEroded = reactor.id === 'eroded_pitted_throttle_cavitator';
      const isUnbuffered = sanitary.id === 'unbuffered_eroded_line';

      // 1. Cavitation Number (σ)
      // σ = (P_back - P_vapor) / (0.5 * rho * v²)
      // Effective differential pressure deltaP = inletP - backP
      const deltaP = Math.max(1.0, inletP - backP);
      let sigma = (backP * 100.0) / (deltaP * 120.0 + 10.0);
      if (isEroded) sigma = 0.04;
      sigma = Math.max(0.03, Math.min(0.85, sigma));

      // 2. Bubble Collapse Shockwave Pressure (bar)
      let baseCollapseP = reactor.cavitationCollapsePressureBar * (deltaP / 25.0) * (1.0 / (sigma + 0.1));
      if (isEroded) baseCollapseP = 350.0;
      const collapseP = Math.max(200.0, Math.min(5500.0, baseCollapseP));

      // 3. Hydroxyl Radical Flux (•OH in µmol/L)
      let radicalFlux = (reactor.hydroxylRadicalFluxMicroMolPerL * (collapseP / 2000.0) * pathogen.hydroxylSensitivityIndex);
      if (isEroded) radicalFlux = 1.8;
      radicalFlux = Math.max(0.5, Math.min(45.0, radicalFlux));

      // 4. Pathogen Log10 Reduction
      // Passes based on flow rate and reactor residence
      const passes = Math.max(1.0, (reactor.maxThroughputLitersPerHour / flowLh) * 1.3);
      let logReduction = (passes / pathogen.passesForOneLogKill) * (collapseP / 1500.0) * fluid.cavitationYieldFactor;
      if (isEroded || isUnbuffered) logReduction *= 0.35;
      logReduction = Math.max(0.2, Math.min(8.5, logReduction));

      // 5. Emulsion Nano-Droplet Size (nm)
      let particleSize = fluid.targetNanoParticleSizeNm * Math.pow(1500.0 / collapseP, 0.45);
      if (isEroded) particleSize = 850.0;
      particleSize = Math.max(65.0, Math.min(1200.0, particleSize));

      // 6. Bulk Adiabatic Temperature Rise (°C)
      // deltaT = (deltaP_bar * 1e5) / (rho * Cp)
      // 1 bar ~ 0.024°C rise for water-like liquids
      const tempRise = (deltaP * 0.18) * (1.0 + (fluid.viscosityCentipoise / 50.0));
      const finalTemp = tempC + tempRise;

      // Update Metrics Displays
      metricCavitationNumber.textContent = sigma.toFixed(2);
      if (sigma < 0.15) {
        subCavitationNumber.textContent = 'Choked / Super-Cavitation';
        subCavitationNumber.className = 'text-2xs text-cyan-700 font-semibold mt-1';
      } else if (sigma <= 0.30) {
        subCavitationNumber.textContent = 'Optimal Active Cavitation';
        subCavitationNumber.className = 'text-2xs text-emerald-600 font-medium mt-1';
      } else {
        subCavitationNumber.textContent = 'Incipient / Weak Cavitation';
        subCavitationNumber.className = 'text-2xs text-amber-600 font-medium mt-1';
      }

      metricCollapsePressure.textContent = Math.round(collapseP).toLocaleString();
      if (collapseP >= 1500.0) {
        metricCollapsePressure.className = 'text-lg font-black text-cyan-800 font-mono';
        subCollapsePressure.textContent = 'Cell Wall Rupture Threshold Met';
        subCollapsePressure.className = 'text-2xs text-emerald-600 font-medium mt-1';
      } else {
        metricCollapsePressure.className = 'text-lg font-black text-amber-700 font-mono';
        subCollapsePressure.textContent = 'Sub-Lethal Shockwaves';
        subCollapsePressure.className = 'text-2xs text-amber-600 font-medium mt-1';
      }

      metricRadicalFlux.textContent = radicalFlux.toFixed(1);
      subRadicalFlux.textContent = radicalFlux > 15.0 ? 'Intense Water Sonolysis' : 'Moderate Radical Flux';

      metricLogReduction.textContent = logReduction.toFixed(2);
      if (logReduction >= pathogen.targetRegulatoryLogReduction) {
        metricLogReduction.className = 'text-lg font-black text-emerald-600 font-mono';
        subLogReduction.textContent = `Target Met (≥ ${pathogen.targetRegulatoryLogReduction}-log₁₀)`;
        subLogReduction.className = 'text-2xs text-emerald-600 font-medium mt-1';
      } else if (logReduction >= 3.0) {
        metricLogReduction.className = 'text-lg font-black text-amber-600 font-mono';
        subLogReduction.textContent = `Partial Kill (< ${pathogen.targetRegulatoryLogReduction}-log₁₀)`;
        subLogReduction.className = 'text-2xs text-amber-600 font-medium mt-1';
      } else {
        metricLogReduction.className = 'text-lg font-black text-rose-600 font-mono';
        subLogReduction.textContent = 'Deficient Disinfection';
        subLogReduction.className = 'text-2xs text-rose-600 font-medium mt-1';
      }

      metricParticleSize.textContent = Math.round(particleSize);
      if (particleSize <= 200.0) {
        subParticleSize.textContent = 'Sub-200nm True Nano-Emulsion';
        subParticleSize.className = 'text-2xs text-emerald-600 font-medium mt-1';
      } else if (particleSize <= 450.0) {
        subParticleSize.textContent = 'Fine Micro-Dispersion';
        subParticleSize.className = 'text-2xs text-cyan-700 font-medium mt-1';
      } else {
        subParticleSize.textContent = 'Coarse Aggregates (> 450 nm)';
        subParticleSize.className = 'text-2xs text-amber-600 font-medium mt-1';
      }

      metricTempRise.textContent = `+${tempRise.toFixed(1)}`;
      if (finalTemp <= fluid.maxNonThermalTempLimitC) {
        subTempRise.textContent = `Non-Thermal (Final: ${finalTemp.toFixed(1)}°C < ${fluid.maxNonThermalTempLimitC}°C)`;
        subTempRise.className = 'text-2xs text-emerald-600 font-medium mt-1';
      } else {
        subTempRise.textContent = `OVERHEAT WARNING (Final: ${finalTemp.toFixed(1)}°C > ${fluid.maxNonThermalTempLimitC}°C)`;
        subTempRise.className = 'text-2xs text-rose-600 font-medium mt-1';
      }

      // Compliance & Status Logic
      if (isEroded || isUnbuffered) {
        flowStatusTag.textContent = 'CRITICAL CAVITATION PITTING & WATER HAMMER';
        flowStatusTag.className = 'text-2xs font-semibold text-rose-700 bg-rose-50 px-2 py-0.5 rounded-full';

        complianceBadge.className = 'inline-flex items-center gap-2 px-3 py-1.5 rounded-xl text-xs font-bold bg-rose-50 border border-rose-300 text-rose-800';
        complianceText.textContent = 'NON-COMPLIANT: Severe Cavitation Pitting • Metal Shedding • Biofilm Harboring';
        limitationText.textContent = 'Unregulated backpressure allows vapor cavities to collapse directly onto stainless steel walls, causing deep pitting (>200 µm) and catastrophic water hammer vibration.';
        mitigationText.textContent = 'IMMEDIATE SHUTDOWN REQUIRED: Replace pitted throttle valve with hardened tungsten-carbide insert venturi. Install sanitary closed-loop backpressure diaphragm valve.';
      } else if (finalTemp > fluid.maxNonThermalTempLimitC) {
        flowStatusTag.textContent = 'Thermal Limit Exceeded';
        flowStatusTag.className = 'text-2xs font-semibold text-amber-700 bg-amber-50 px-2 py-0.5 rounded-full';

        complianceBadge.className = 'inline-flex items-center gap-2 px-3 py-1.5 rounded-xl text-xs font-bold bg-amber-50 border border-amber-300 text-amber-800';
        complianceText.textContent = 'THERMAL BOUNDARY WARNING: Bulk Temp Exceeds Non-Thermal Denaturation Ceiling';
        limitationText.textContent = `Bulk process temperature (${finalTemp.toFixed(1)}°C) exceeds the ${fluid.maxNonThermalTempLimitC}°C critical threshold, risking protein denaturation or vitamin loss.`;
        mitigationText.textContent = 'Increase cooling chiller capacity or reduce inlet pressure to keep discharge fluid below 45°C.';
      } else {
        flowStatusTag.textContent = 'Stable Vortex Cavitation';
        flowStatusTag.className = 'text-2xs font-semibold text-cyan-700 bg-cyan-50 px-2 py-0.5 rounded-full';

        complianceBadge.className = 'inline-flex items-center gap-2 px-3 py-1.5 rounded-xl text-xs font-bold bg-emerald-50 border border-emerald-300 text-emerald-800';
        complianceText.textContent = 'FULL COMPLIANCE: 3-A Sanitary 04-05 • EHEDG Class 1 Aseptic • FDA FSMA & Juice HACCP 5-log';
        limitationText.textContent = 'Cavitation shear is balanced. Micro-bubble clouds collapse within the liquid core without wall impingement, ensuring zero alloy erosion.';
        mitigationText.textContent = 'Operate according to validated CIP/SIP cycle (85°C caustic wash, peracetic acid sanitization). Verify elastomer seals every 1,500 run hours.';
      }
    }

    // Event Listeners
    [selReactor, selFluid, selPathogen, selSanitary].forEach(el => {
      if (el) el.addEventListener('change', recalculate);
    });

    [sliderInletPressure, sliderBackpressure, sliderTemp, sliderFlow].forEach(el => {
      if (el) el.addEventListener('input', recalculate);
    });

    // Initial Calculation
    recalculate();
  });
</script>