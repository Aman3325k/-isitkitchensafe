<script>
  // Dynamic Interactivity & Calculation Engine
  function initScco2EsnSimulator() {
    const root = document.querySelector('.scco2-esn-simulator') as HTMLElement;
    if (!root) return;

    // Controls
    const skidSelect = root.querySelector('#esn-skid') as HTMLSelectElement;
    const feedstockSelect = root.querySelector('#esn-feedstock') as HTMLSelectElement;
    const voltageInput = root.querySelector('#esn-voltage') as HTMLInputElement;
    const distanceInput = root.querySelector('#esn-distance') as HTMLInputElement;
    const pressureInput = root.querySelector('#esn-pressure') as HTMLInputElement;
    const tempInput = root.querySelector('#esn-temp') as HTMLInputElement;
    const flowRateInput = root.querySelector('#esn-flowrate') as HTMLInputElement;

    // Value Labels
    const voltageVal = root.querySelector('#esn-voltage-val') as HTMLElement;
    const distanceVal = root.querySelector('#esn-distance-val') as HTMLElement;
    const pressureVal = root.querySelector('#esn-pressure-val') as HTMLElement;
    const tempVal = root.querySelector('#esn-temp-val') as HTMLElement;
    const flowRateVal = root.querySelector('#esn-flowrate-val') as HTMLElement;

    // Telemetry Outputs
    const telDiameter = root.querySelector('#tel-diameter') as HTMLElement;
    const telField = root.querySelector('#tel-field') as HTMLElement;
    const telViability = root.querySelector('#tel-viability') as HTMLElement;
    const telGastric = root.querySelector('#tel-gastric') as HTMLElement;
    const telViscosity = root.querySelector('#tel-viscosity') as HTMLElement;
    const telSolvent = root.querySelector('#tel-solvent') as HTMLElement;
    const telSec = root.querySelector('#tel-sec') as HTMLElement;
    const telSavings = root.querySelector('#tel-savings') as HTMLElement;
    const telSpark = root.querySelector('#tel-spark') as HTMLElement;
    const telSparkBar = root.querySelector('#tel-spark-bar') as HTMLElement;
    const telVerdictText = root.querySelector('#tel-verdict-text') as HTMLElement;
    const verdictBanner = root.querySelector('#verdict-banner') as HTMLElement;

    // SVG Displays
    const svgPressure = root.querySelector('#svg-pressure-display') as SVGTextElement;
    const svgVoltage = root.querySelector('#svg-voltage-display') as SVGTextElement;
    const svgFlowRate = root.querySelector('#svg-flowrate-display') as SVGTextElement;
    const svgDistance = root.querySelector('#svg-distance-display') as SVGTextElement;
    const svgWebSpec = root.querySelector('#svg-web-spec') as SVGTextElement;
    const svgNanoWebLayer = root.querySelector('#svg-nanoweb-layer') as SVGRectElement;

    function recalculate() {
      const voltage = parseFloat(voltageInput.value);
      const distance = parseFloat(distanceInput.value);
      const pressure = parseFloat(pressureInput.value);
      const temp = parseFloat(tempInput.value);
      const flowRate = parseFloat(flowRateInput.value);
      const isHazard = feedstockSelect.value === 'conventional_toxic_solvent_electrospinning_hazard';

      // Update Labels
      voltageVal.textContent = `${voltage.toFixed(1)} kV`;
      distanceVal.textContent = `${distance.toFixed(1)} cm`;
      pressureVal.textContent = `${pressure.toFixed(1)} bar`;
      tempVal.textContent = `${temp.toFixed(1)}°C`;
      flowRateVal.textContent = `${flowRate.toFixed(1)} mL/h`;

      // 1. Electric Field Strength E = V / d (kV/cm)
      const fieldStrength = voltage / distance;
      telField.textContent = `${fieldStrength.toFixed(2)} kV/cm`;

      // 2. Dissolved scCO2 & Viscosity Reduction
      // Solubility of CO2 in biopolymer increases with P, decreases with T
      const co2Solubility = isHazard ? 0.0 : Math.min(18.5, Math.max(3.0, (pressure / 100.0) * 11.5 * (35.0 / temp)));
      const viscosityReductionPct = isHazard ? 0.0 : Math.min(88.0, co2Solubility * 5.2);
      telViscosity.textContent = isHazard ? "0.0% (Toxic Solvent)" : `${viscosityReductionPct.toFixed(1)}%`;

      // 3. Nanofiber Diameter Scaling Law
      // d ~ C * (Q^3 / (E^2 * co2_factor))^(1/6)
      let calculatedDiameter = 220;
      if (isHazard) {
        calculatedDiameter = 450 + (voltage - 25) * 4;
      } else {
        const flowFactor = Math.pow(flowRate / 4.5, 0.5);
        const fieldFactor = Math.pow(2.11 / Math.max(0.8, fieldStrength), 0.4);
        const plasticFactor = Math.pow(100.0 / Math.max(50.0, 100.0 - viscosityReductionPct), -0.2);
        calculatedDiameter = Math.round(210 * flowFactor * fieldFactor * plasticFactor);
      }
      telDiameter.textContent = `${calculatedDiameter} nm`;

      // 4. Bioactive / Probiotic Viability Retention
      let viability = 98.4;
      if (isHazard) {
        viability = 0.0;
      } else {
        const tempPenalty = temp > 38.0 ? (temp - 38.0) * 1.8 : 0.0;
        const pressurePenalty = pressure > 140.0 ? (pressure - 140.0) * 0.08 : 0.0;
        viability = Math.max(88.0, Math.min(99.8, 99.2 - tempPenalty - pressurePenalty));
      }
      telViability.textContent = `${viability.toFixed(1)}%`;
      telViability.className = viability > 90 ? "text-xl font-bold font-mono text-emerald-400" : (viability > 0 ? "text-xl font-bold font-mono text-amber-400" : "text-xl font-bold font-mono text-rose-500");

      // 5. Enteric Gastric Bypass Survival (pH 2.0)
      let gastricSurvival = 96.2;
      if (isHazard) {
        gastricSurvival = 15.0;
      } else {
        // Thicker sub-micron core-shell fibers provide higher diffusion path resistance
        gastricSurvival = Math.min(99.0, Math.max(85.0, 92.0 + (calculatedDiameter / 300.0) * 4.5));
      }
      telGastric.textContent = `${gastricSurvival.toFixed(1)}%`;

      // 6. Residual Toxic Organic Solvents
      const residualPpm = isHazard ? 485.0 : 0.0;
      telSolvent.textContent = `${residualPpm.toFixed(1)} ppm`;
      telSolvent.className = residualPpm === 0.0 ? "text-xl font-bold font-mono text-emerald-400" : "text-xl font-bold font-mono text-rose-500";

      // 7. Specific Electrical Energy Consumption
      const sec = isHazard ? 1.85 : (0.42 + (voltage / 60.0) * 0.18 + (pressure / 160.0) * 0.15);
      telSec.textContent = `${sec.toFixed(2)} kWh/kg`;
      const savingsPct = isHazard ? 52.0 : (((3.85 - sec) / 3.85) * 100.0);
      telSavings.textContent = `${savingsPct.toFixed(1)}%`;

      // 8. Spark & Arc-Quench Status
      if (fieldStrength > 3.8) {
        telSpark.textContent = "WARNING: HIGH FIELD BREAKDOWN RISK";
        telSpark.className = "text-xs font-bold font-mono text-amber-400 uppercase tracking-wide";
        telSparkBar.className = "bg-amber-500 h-full rounded-full transition-all duration-300";
        telSparkBar.style.width = "45%";
      } else if (isHazard) {
        telSpark.textContent = "CRITICAL: VOC FLAMMABILITY RISK (DCM/HFIP)";
        telSpark.className = "text-xs font-bold font-mono text-rose-500 uppercase tracking-wide";
        telSparkBar.className = "bg-rose-500 h-full rounded-full transition-all duration-300";
        telSparkBar.style.width = "15%";
      } else {
        telSpark.textContent = "ACTIVE (<0.2 µs ARC-QUENCH)";
        telSpark.className = "text-xs font-bold font-mono text-emerald-400 uppercase tracking-wide";
        telSparkBar.className = "bg-emerald-500 h-full rounded-full transition-all duration-300";
        telSparkBar.style.width = "100%";
      }

      // 9. Overall Quality Verdict
      if (isHazard) {
        verdictBanner.className = "p-4 rounded-xl border border-rose-800 bg-rose-950/40 text-rose-300";
        telVerdictText.textContent = "CRITICAL CONTAMINATION HAZARD: Residual organic solvents (485 ppm HFIP/DCM) exceed USP <467> Class 2 limit of 60 ppm by >800%. Probiotic viability is 0.0% due to cellular lysis. UNFIT FOR HUMAN CONSUMPTION.";
      } else if (fieldStrength < 1.2) {
        verdictBanner.className = "p-4 rounded-xl border border-amber-800 bg-amber-950/40 text-amber-300";
        telVerdictText.textContent = `SUB-OPTIMAL FIELD STRENGTH: Applied field (${fieldStrength.toFixed(2)} kV/cm) is insufficient to overcome surface tension at Taylor cone meniscus, risking micro-droplet electrospraying instead of continuous nanofiber formation. Increase voltage or decrease working distance.`;
      } else {
        verdictBanner.className = "p-4 rounded-xl border border-emerald-800 bg-emerald-950/40 text-emerald-300";
        telVerdictText.textContent = `100% CLEAN-LABEL ASEPTIC NANOFIBER ENCAPSULATE: High electric field (${fieldStrength.toFixed(2)} kV/cm) produces uniform sub-micron core-shell fibers (${calculatedDiameter} nm) with ${viability.toFixed(1)}% live bioactive retention and zero toxic organic solvent residues (0.0 ppm), fully certified under FDA 21 CFR § 170.36 GRAS and ASME BPVC Section VIII.`;
      }

      // Update SVG Displays
      if (svgPressure) svgPressure.textContent = `${pressure.toFixed(1)} bar`;
      if (svgVoltage) svgVoltage.textContent = `+${voltage.toFixed(1)} kV`;
      if (svgFlowRate) svgFlowRate.textContent = `${flowRate.toFixed(1)} mL/h per needle`;
      if (svgDistance) svgDistance.textContent = `Working Distance: ${distance.toFixed(1)} cm (E = ${fieldStrength.toFixed(2)} kV/cm)`;
      if (svgWebSpec) svgWebSpec.textContent = `Sub-micron Web: ${calculatedDiameter} nm`;
      if (svgNanoWebLayer) {
        const thickness = Math.max(3, Math.min(10, Math.round(calculatedDiameter / 40)));
        svgNanoWebLayer.setAttribute('width', String(thickness));
      }
    }

    // Attach Event Listeners to Sliders
    [voltageInput, distanceInput, pressureInput, tempInput, flowRateInput].forEach((slider) => {
      slider?.addEventListener('input', recalculate);
    });

    skidSelect?.addEventListener('change', recalculate);
    feedstockSelect?.addEventListener('change', recalculate);

    // Preset Buttons
    const presetButtons = root.querySelectorAll('.preset-btn');
    presetButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const preset = btn.getAttribute('data-preset');
        if (preset === 'probiotic') {
          feedstockSelect.value = 'probiotic_whey_pullulan_scco2_nanofiber';
          voltageInput.value = '38';
          distanceInput.value = '18';
          pressureInput.value = '110';
          tempInput.value = '34';
          flowRateInput.value = '4.5';
        } else if (preset === 'anthocyanin') {
          feedstockSelect.value = 'anthocyanin_zein_sodium_caseinate_nanoweb';
          voltageInput.value = '42';
          distanceInput.value = '20';
          pressureInput.value = '135';
          tempInput.value = '38';
          flowRateInput.value = '5.0';
        } else if (preset === 'peptide') {
          feedstockSelect.value = 'peptide_glutathione_chitosan_hyaluronan_nanomatrix';
          voltageInput.value = '34';
          distanceInput.value = '15';
          pressureInput.value = '95';
          tempInput.value = '33';
          flowRateInput.value = '3.5';
        } else if (preset === 'resveratrol') {
          feedstockSelect.value = 'resveratrol_curcumin_resistant_starch_nanofiber';
          voltageInput.value = '45';
          distanceInput.value = '22';
          pressureInput.value = '140';
          tempInput.value = '40';
          flowRateInput.value = '6.0';
        } else if (preset === 'hazard') {
          feedstockSelect.value = 'conventional_toxic_solvent_electrospinning_hazard';
          voltageInput.value = '25';
          distanceInput.value = '15';
          pressureInput.value = '75';
          tempInput.value = '30';
          flowRateInput.value = '3.0';
        }
        recalculate();
      });
    });

    // Export Audit Report
    const exportBtn = root.querySelector('#btn-export-audit') as HTMLButtonElement;
    exportBtn?.addEventListener('click', () => {
      const report = {
        tool: "Commercial Continuous High-Pressure Supercritical CO2 Assisted Electrospinning (scCO2-ESN) Modeler",
        timestamp: new Date().toISOString(),
        skid: skidSelect.value,
        feedstock: feedstockSelect.value,
        parameters: {
          voltageKv: parseFloat(voltageInput.value),
          distanceCm: parseFloat(distanceInput.value),
          electricFieldKvPerCm: parseFloat((parseFloat(voltageInput.value) / parseFloat(distanceInput.value)).toFixed(2)),
          pressureBar: parseFloat(pressureInput.value),
          temperatureCelsius: parseFloat(tempInput.value),
          flowRateMlPerH: parseFloat(flowRateInput.value)
        },
        telemetry: {
          meanNanofiberDiameterNm: telDiameter.textContent,
          cellViabilityPct: telViability.textContent,
          gastricSurvivalPct: telGastric.textContent,
          viscosityReductionPct: telViscosity.textContent,
          residualSolventPpm: telSolvent.textContent,
          specificEnergyKwhPerKg: telSec.textContent,
          energySavingsPct: telSavings.textContent,
          sparkArcQuenchSafety: telSpark.textContent
        },
        regulatoryCompliance: {
          fda21Cfr170: "Compliant GRAS (Zero toxic solvents)",
          asmeBpvcSectionViii: "Certified 250 Bar Design Pressure",
          ieeeStd510: "Certified Arc-Quench Suppressed",
          usp467ResidualSolvents: telSolvent.textContent === "0.0 ppm" ? "0.0 ppm Gold Master" : "EXCEEDED LIMIT"
        }
      };

      const blob = new Blob([JSON.stringify(report, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `scCO2-ESN-electrospinning-audit-${Date.now()}.json`;
      a.click();
      URL.revokeObjectURL(url);
    });

    // Initial Execution
    recalculate();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initScco2EsnSimulator);
  } else {
    initScco2EsnSimulator();
  }
</script>