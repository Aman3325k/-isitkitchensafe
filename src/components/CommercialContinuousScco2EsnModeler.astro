    flowRateLabel: "单针喷头微量输送流量 (Q_needle):",
    flowRateHelp: "连续供给泰勒锥弯月面的单针孔体积流速（1.0至10.0 mL/h）。",
    presetsTitle: "核心活性封装工况预设:",
    presetProbiotic: "活性益生菌核壳纳米纤维网 (乳杆菌与双歧杆菌, 38 kV, 18 cm, 110 bar, 34°C, 210 nm, 存活率98.4%)",
    presetAnthocyanin: "黑加仑花青素玉米醇溶蛋白纳米纤维 (强抗氧化多酚, 42 kV, 20 cm, 135 bar, 38°C, 280 nm, 保持率97.8%)",
    presetPeptide: "谷胱甘肽与胶原三肽壳聚糖生物粘附膜 (34 kV, 15 cm, 95 bar, 33°C, 165 nm, 保持率99.5%)",
    presetResveratrol: "白藜芦醇姜黄素RS-4抗性淀粉肠溶颗粒 (45 kV, 22 cm, 140 bar, 40°C, 340 nm, 溶解度提升4,200倍)",
    presetSolventHazard: "传统有毒有机溶剂电纺危险对照 (HFIP/DCM基准, 25 kV, 0 bar, 残留溶剂485 ppm, 活菌存活率0.0%)",
    telemetryTitle: "实时动电学遥测与纳米纤维雷达",
    telemetrySub: "连续监测纤维直径、电场强度、活菌存活率、胃酸耐受率及零化学溶剂合规指标。",
    fiberDiameterLabel: "平均纳米纤维直径 (d_fiber):",
    fieldStrengthLabel: "极间电场强度 (E_field):",
    viabilityLabel: "生物活性物 / 益生菌活菌保留率:",
    gastricSurvivalLabel: "模拟胃酸过境存活率 (pH 2.0):",
    viscosityReductionLabel: "超临界CO2熔体表观粘度降低率:",
    solventPpmLabel: "残留有毒有机溶剂浓度:",
    secLabel: "单位质量电能单耗 (SEC):",
    energySavingsLabel: "相比热力喷雾干燥节能降碳率:",
    sparkSafetyLabel: "IEEE Std 510 快速电弧猝灭安全认证:",
    verdictLabel: "纳米纤维品质与法规符合性判定:",
    diagramTitle: "scCO2-ESN 连续式多针高压静电纺丝示意图",
    diagramSub: "直观展示高压CO2塑化、同轴泰勒锥射流挤出、静电鞭动拉伸以及接地皮带连续卷取过程。",
    chartTitle: "封装技术横向综合对比雷达",
    chartSub: "对比scCO2-ESN与有机溶剂电纺、热力喷雾干燥、喷雾冷冻干燥及脂质体挤出技术。",
    scienceTitle: "电水动力学物理原理、泰勒锥力学与超临界塑化理论",
    scienceSub: "麦克斯韦电正应力平衡方程、密相CO2粘度衰减方程及纳米级细化缩聚动力学。",
    tableTitle: "微纳封装技术综合对比矩阵",
    exportAuditBtn: "导出工程合规审计报告"
  }
};

const d = DICT[lang];
---

<div class="scco2-esn-simulator bg-surface rounded-3xl border border-hairline p-6 sm:p-8 lg:p-10 shadow-sm" data-lang={lang}>
  <!-- Header Badge & Intro -->
  <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-950 text-emerald-300 border border-emerald-800">
      <span>{d.badge}</span>
    </div>
    <div class="flex items-center gap-2 text-xs text-muted font-mono">
      <span>FDA GRAS &bull; ASME 250 Bar &bull; IEEE Std 510 &bull; 0.0 ppm Solvents</span>
    </div>
  </div>

  <div class="mb-8">
    <h2 class="text-2xl sm:text-3xl font-extrabold text-ink tracking-tight mb-3">
      {d.title}
    </h2>
    <p class="text-sm sm:text-base text-muted leading-relaxed max-w-4xl">
      {d.subtitle}
    </p>
  </div>

  <!-- Presets -->
  <div class="mb-8 bg-surface-soft p-5 rounded-2xl border border-hairline">
    <h3 class="text-xs font-bold uppercase tracking-wider text-ink mb-3 flex items-center gap-2">
      <svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
      </svg>
      {d.presetsTitle}
    </h3>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-2.5">
      <button type="button" class="preset-btn text-left p-3 rounded-xl bg-surface hover:bg-emerald-950/30 border border-hairline hover:border-emerald-600 transition-all text-xs" data-preset="probiotic">
        <div class="font-bold text-ink mb-0.5">🧬 Probiotic Core-Shell Nanoweb</div>
        <div class="text-muted leading-tight">38 kV &bull; 18 cm &bull; 110 bar &bull; 34°C &bull; 210 nm &bull; 98.4% Viability</div>
      </button>

      <button type="button" class="preset-btn text-left p-3 rounded-xl bg-surface hover:bg-emerald-950/30 border border-hairline hover:border-emerald-600 transition-all text-xs" data-preset="anthocyanin">
        <div class="font-bold text-ink mb-0.5">🍇 Anthocyanin Zein Nanoweb</div>
        <div class="text-muted leading-tight">42 kV &bull; 20 cm &bull; 135 bar &bull; 38°C &bull; 280 nm &bull; 97.8% Retention</div>
      </button>

      <button type="button" class="preset-btn text-left p-3 rounded-xl bg-surface hover:bg-emerald-950/30 border border-hairline hover:border-emerald-600 transition-all text-xs" data-preset="peptide">
        <div class="font-bold text-ink mb-0.5">💊 Glutathione &amp; Collagen Matrix</div>
        <div class="text-muted leading-tight">34 kV &bull; 15 cm &bull; 95 bar &bull; 33°C &bull; 165 nm &bull; 99.5% Retention</div>
      </button>

      <button type="button" class="preset-btn text-left p-3 rounded-xl bg-surface hover:bg-emerald-950/30 border border-hairline hover:border-emerald-600 transition-all text-xs" data-preset="resveratrol">
        <div class="font-bold text-ink mb-0.5">🌾 Resveratrol RS-4 Nanofibers</div>
        <div class="text-muted leading-tight">45 kV &bull; 22 cm &bull; 140 bar &bull; 40°C &bull; 340 nm &bull; 4,200x Solubility</div>
      </button>

      <button type="button" class="preset-btn text-left p-3 rounded-xl bg-surface hover:bg-rose-950/30 border border-hairline hover:border-rose-600 transition-all text-xs lg:col-span-2" data-preset="hazard">
        <div class="font-bold text-rose-400 mb-0.5">⚠️ Conventional Solvent Hazard Benchmark</div>
        <div class="text-muted leading-tight">HFIP/DCM benchmark &bull; 25 kV &bull; 0 bar &bull; 485 ppm Toxic Solvents &bull; 0% Viability</div>
      </button>
    </div>
  </div>

  <!-- Interactive Controls Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-10">
    <div class="lg:col-span-6 space-y-6">
      <div class="bg-surface-soft p-5 sm:p-6 rounded-2xl border border-hairline">
        <div class="border-b border-hairline pb-4 mb-5">
          <h3 class="text-base font-bold text-ink">{d.controlsTitle}</h3>
          <p class="text-xs text-muted">{d.controlsSub}</p>
        </div>

        <div class="space-y-4">
          <!-- Skid Selection -->
          <div>
            <label for="esn-skid" class="block text-xs font-semibold text-ink mb-1">{d.skidLabel}</label>
            <select id="esn-skid" class="w-full text-xs font-medium bg-surface border border-hairline rounded-xl px-3 py-2 text-ink focus:outline-none focus:border-emerald-500">
              {esnData.systemArchitectures.map((arch) => (
                <option value={arch.id}>{arch.name}</option>
              ))}
            </select>
            <p class="text-[11px] text-muted mt-1">{d.skidHelp}</p>
          </div>

          <!-- Feedstock Selection -->
          <div>
            <label for="esn-feedstock" class="block text-xs font-semibold text-ink mb-1">{d.feedstockLabel}</label>
            <select id="esn-feedstock" class="w-full text-xs font-medium bg-surface border border-hairline rounded-xl px-3 py-2 text-ink focus:outline-none focus:border-emerald-500">
              {esnData.feedstockBiopolymersAndBioactives.map((feed) => (
                <option value={feed.id}>{feed.name}</option>
              ))}
            </select>
            <p class="text-[11px] text-muted mt-1">{d.feedstockHelp}</p>
          </div>

          <!-- Voltage Slider -->
          <div>
            <div class="flex justify-between items-center text-xs mb-1">
              <label for="esn-voltage" class="font-semibold text-ink">{d.voltageLabel}</label>
              <span id="esn-voltage-val" class="font-mono text-emerald-400 font-bold">38.0 kV</span>
            </div>
            <input type="range" id="esn-voltage" min="20" max="60" step="0.5" value="38" class="w-full accent-emerald-500 cursor-pointer" />
            <p class="text-[11px] text-muted mt-0.5">{d.voltageHelp}</p>
          </div>

          <!-- Working Distance Slider -->
          <div>
            <div class="flex justify-between items-center text-xs mb-1">
              <label for="esn-distance" class="font-semibold text-ink">{d.distanceLabel}</label>
              <span id="esn-distance-val" class="font-mono text-emerald-400 font-bold">18.0 cm</span>
            </div>
            <input type="range" id="esn-distance" min="10" max="28" step="0.5" value="18" class="w-full accent-emerald-500 cursor-pointer" />
            <p class="text-[11px] text-muted mt-0.5">{d.distanceHelp}</p>
          </div>

          <!-- Supercritical CO2 Pressure Slider -->
          <div>
            <div class="flex justify-between items-center text-xs mb-1">
              <label for="esn-pressure" class="font-semibold text-ink">{d.pressureLabel}</label>
              <span id="esn-pressure-val" class="font-mono text-emerald-400 font-bold">110.0 bar</span>
            </div>
            <input type="range" id="esn-pressure" min="75" max="160" step="1" value="110" class="w-full accent-emerald-500 cursor-pointer" />
            <p class="text-[11px] text-muted mt-0.5">{d.pressureHelp}</p>
          </div>

          <!-- Process Temperature Slider -->
          <div>
            <div class="flex justify-between items-center text-xs mb-1">
              <label for="esn-temp" class="font-semibold text-ink">{d.tempLabel}</label>
              <span id="esn-temp-val" class="font-mono text-emerald-400 font-bold">34.0°C</span>
            </div>
            <input type="range" id="esn-temp" min="30" max="45" step="0.5" value="34" class="w-full accent-emerald-500 cursor-pointer" />
            <p class="text-[11px] text-muted mt-0.5">{d.tempHelp}</p>
          </div>

          <!-- Nozzle Flow Rate Slider -->
          <div>
            <div class="flex justify-between items-center text-xs mb-1">
              <label for="esn-flowrate" class="font-semibold text-ink">{d.flowRateLabel}</label>
              <span id="esn-flowrate-val" class="font-mono text-emerald-400 font-bold">4.5 mL/h</span>
            </div>
            <input type="range" id="esn-flowrate" min="1.0" max="10.0" step="0.1" value="4.5" class="w-full accent-emerald-500 cursor-pointer" />
            <p class="text-[11px] text-muted mt-0.5">{d.flowRateHelp}</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Live Telemetry Display -->
    <div class="lg:col-span-6 space-y-6">
      <div class="bg-surface-soft p-5 sm:p-6 rounded-2xl border border-hairline">
        <div class="border-b border-hairline pb-4 mb-5">
          <h3 class="text-base font-bold text-ink">{d.telemetryTitle}</h3>
          <p class="text-xs text-muted">{d.telemetrySub}</p>
        </div>

        <div class="grid grid-cols-2 gap-3 mb-5">
          <!-- Fiber Diameter Card -->
          <div class="bg-surface p-3.5 rounded-xl border border-hairline">
            <span class="text-[11px] text-muted block mb-0.5">{d.fiberDiameterLabel}</span>
            <span id="tel-diameter" class="text-xl font-bold font-mono text-emerald-400">215 nm</span>
            <span class="text-[10px] text-muted block mt-0.5">Target: 150–300 nm Sub-micron</span>
          </div>

          <!-- Electric Field Strength Card -->
          <div class="bg-surface p-3.5 rounded-xl border border-hairline">
            <span class="text-[11px] text-muted block mb-0.5">{d.fieldStrengthLabel}</span>
            <span id="tel-field" class="text-xl font-bold font-mono text-ink">2.11 kV/cm</span>
            <span class="text-[10px] text-muted block mt-0.5">Optimal: 1.8–2.5 kV/cm</span>
          </div>

          <!-- Viability Retention Card -->
          <div class="bg-surface p-3.5 rounded-xl border border-hairline">
            <span class="text-[11px] text-muted block mb-0.5">{d.viabilityLabel}</span>
            <span id="tel-viability" class="text-xl font-bold font-mono text-emerald-400">98.4%</span>
            <span class="text-[10px] text-muted block mt-0.5">Zero thermal denature</span>
          </div>

          <!-- Enteric Gastric Bypass Card -->
          <div class="bg-surface p-3.5 rounded-xl border border-hairline">
            <span class="text-[11px] text-muted block mb-0.5">{d.gastricSurvivalLabel}</span>
            <span id="tel-gastric" class="text-xl font-bold font-mono text-emerald-400">96.2%</span>
            <span class="text-[10px] text-muted block mt-0.5">pH 2.0 Gastric Resistance</span>
          </div>

          <!-- Viscosity Reduction Card -->
          <div class="bg-surface p-3.5 rounded-xl border border-hairline">
            <span class="text-[11px] text-muted block mb-0.5">{d.viscosityReductionLabel}</span>
            <span id="tel-viscosity" class="text-xl font-bold font-mono text-ink">78.5%</span>
            <span class="text-[10px] text-muted block mt-0.5">scCO2 Molecular Spacer</span>
          </div>

          <!-- Residual Solvent Card -->
          <div class="bg-surface p-3.5 rounded-xl border border-hairline">
            <span class="text-[11px] text-muted block mb-0.5">{d.solventPpmLabel}</span>
            <span id="tel-solvent" class="text-xl font-bold font-mono text-emerald-400">0.0 ppm</span>
            <span class="text-[10px] text-muted block mt-0.5">USP &lt;467&gt; Gold Master</span>
          </div>

          <!-- Specific Energy Consumption -->
          <div class="bg-surface p-3.5 rounded-xl border border-hairline">
            <span class="text-[11px] text-muted block mb-0.5">{d.secLabel}</span>
            <span id="tel-sec" class="text-xl font-bold font-mono text-ink">0.52 kWh/kg</span>
            <span class="text-[10px] text-muted block mt-0.5">High Efficiency Electric</span>
          </div>

          <!-- Energy Savings Card -->
          <div class="bg-surface p-3.5 rounded-xl border border-hairline">
            <span class="text-[11px] text-muted block mb-0.5">{d.energySavingsLabel}</span>
            <span id="tel-savings" class="text-xl font-bold font-mono text-emerald-400">86.5%</span>
            <span class="text-[10px] text-muted block mt-0.5">vs Spray Drying (3.85 kWh/kg)</span>
          </div>
        </div>

        <!-- IEEE Spark Safety Status Card -->
        <div class="bg-surface p-4 rounded-xl border border-hairline mb-4">
          <div class="flex items-center justify-between mb-1">
            <span class="text-xs font-semibold text-muted">{d.sparkSafetyLabel}</span>
            <span id="tel-spark" class="text-xs font-bold font-mono text-emerald-400 uppercase tracking-wide">ACTIVE (&lt;0.2 µs ARC-QUENCH)</span>
          </div>
          <div class="w-full bg-surface-soft rounded-full h-2 overflow-hidden border border-hairline">
            <div id="tel-spark-bar" class="bg-emerald-500 h-full rounded-full transition-all duration-300" style="width: 100%;"></div>
          </div>
          <p class="text-[11px] text-muted mt-1.5 leading-relaxed">
            Automatic active multi-point grounding and high-speed crowbar circuit prevent flammable discharge or arcing.
          </p>
        </div>

        <!-- Comprehensive Quality & Compliance Verdict -->
        <div id="verdict-banner" class="p-4 rounded-xl border border-emerald-800 bg-emerald-950/40 text-emerald-300">
          <div class="flex items-center gap-2 mb-1">
            <svg class="w-5 h-5 text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span class="font-bold text-xs uppercase tracking-wider">{d.verdictLabel}</span>
          </div>
          <p id="tel-verdict-text" class="text-xs text-emerald-200 leading-relaxed">
            100% CLEAN-LABEL ASEPTIC NANOFIBER ENCAPSULATE: High electric field strength (2.11 kV/cm) produces uniform sub-micron fibers (215 nm) with 98.4% live probiotic retention and zero toxic organic solvent residues (0.0 ppm), fully compliant with FDA 21 CFR § 170.36 GRAS and ASME BPVC Section VIII.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Interactive Dynamic SVG Schematic Diagram -->
  <div class="mb-10 bg-surface-soft p-5 sm:p-8 rounded-3xl border border-hairline">
    <div class="mb-4">
      <h3 class="text-base sm:text-lg font-bold text-ink">{d.diagramTitle}</h3>
      <p class="text-xs text-muted">{d.diagramSub}</p>
    </div>

    <div class="w-full overflow-x-auto">
      <svg id="esn-schematic-svg" viewBox="0 0 920 380" class="w-full min-w-[720px] max-w-full h-auto rounded-2xl bg-surface border border-hairline/80 shadow-xs">
        <defs>
          <linearGradient id="co2Gradient" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#059669" />
            <stop offset="100%" stop-color="#10b981" />
          </linearGradient>
          <linearGradient id="hvGradient" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#f59e0b" />
            <stop offset="100%" stop-color="#ef4444" />
          </linearGradient>
          <linearGradient id="nanoWebGradient" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#047857" stop-opacity="0.2" />
            <stop offset="50%" stop-color="#10b981" stop-opacity="0.8" />
            <stop offset="100%" stop-color="#34d399" stop-opacity="0.9" />
          </linearGradient>
          <pattern id="gridPattern" width="20" height="20" patternUnits="userSpaceOnUse">
            <path d="M 20 0 L 0 0 0 20" fill="none" stroke="currentColor" stroke-width="0.5" class="text-hairline/30" />
          </pattern>
        </defs>

        <!-- Background Grid -->
        <rect width="100%" height="100%" fill="url(#gridPattern)" />

        <!-- Supercritical CO2 Vessel & Syringe Pump Block (Left) -->
        <g transform="translate(40, 60)">
          <!-- High-Pressure Vessel -->
          <rect x="0" y="0" width="130" height="180" rx="14" fill="#064e3b" stroke="#059669" stroke-width="2" />
          <rect x="15" y="15" width="100" height="150" rx="8" fill="#022c22" stroke="#10b981" stroke-width="1" />
          <!-- Pressure Gauge Graphic -->
          <circle cx="65" cy="55" r="22" fill="#0f172a" stroke="#10b981" stroke-width="1.5" />
          <line x1="65" y1="55" x2="78" y2="44" stroke="#34d399" stroke-width="2" stroke-linecap="round" />
          <circle cx="65" cy="55" r="3" fill="#34d399" />
          <!-- Vessel Text -->
          <text x="65" y="95" text-anchor="middle" fill="#6ee7b7" font-size="11" font-weight="bold">scCO2 PUMP</text>
          <text id="svg-pressure-display" x="65" y="112" text-anchor="middle" fill="#a7f3d0" font-size="10" font-family="monospace">110.0 bar</text>
          <text x="65" y="128" text-anchor="middle" fill="#6ee7b7" font-size="9">Dense Phase (T_c > 31°C)</text>
          <text x="65" y="142" text-anchor="middle" fill="#34d399" font-size="8">ASME BPVC 250 Bar</text>
        </g>

        <!-- High-Pressure Transfer Line -->
        <path d="M 170 150 L 250 150 L 250 120 L 290 120" fill="none" stroke="url(#co2Gradient)" stroke-width="4" stroke-linecap="round" />
        <!-- Injection Valve -->
        <circle cx="250" cy="120" r="7" fill="#10b981" />

        <!-- Biopolymer Solution Header & Coaxial Spinneret (Center Left) -->
        <g transform="translate(290, 70)">
          <rect x="0" y="0" width="140" height="100" rx="10" fill="#1e293b" stroke="#475569" stroke-width="1.5" />
          <text x="70" y="24" text-anchor="middle" fill="#f8fafc" font-size="11" font-weight="bold">COAXIAL SPINNERET</text>
          <text x="70" y="40" text-anchor="middle" fill="#94a3b8" font-size="9">64 Coaxial Needles Array</text>
          <text id="svg-flowrate-display" x="70" y="56" text-anchor="middle" fill="#38bdf8" font-size="10" font-family="monospace">4.5 mL/h per needle</text>
          <text x="70" y="72" text-anchor="middle" fill="#10b981" font-size="9">100% Aqueous Plasticization</text>

          <!-- High-Voltage Electrode Connection -->
          <circle cx="70" cy="95" r="5" fill="#ef4444" stroke="#fca5a5" stroke-width="1.5" />
          <text x="70" y="116" text-anchor="middle" fill="#f87171" font-size="10" font-weight="bold">HV+ BUS</text>
          <text id="svg-voltage-display" x="70" y="130" text-anchor="middle" fill="#fbbf24" font-size="11" font-family="monospace" font-weight="bold">+38.0 kV</text>
        </g>

        <!-- High Voltage Power Supply Unit (Top Center) -->
        <g transform="translate(300, 10)">
          <rect x="0" y="0" width="120" height="38" rx="6" fill="#450a0a" stroke="#b91c1c" stroke-width="1" />
          <text x="60" y="16" text-anchor="middle" fill="#fca5a5" font-size="9" font-weight="bold">HV GENERATOR</text>
          <text x="60" y="30" text-anchor="middle" fill="#fef08a" font-size="8">IEEE Std 510 Arc-Quench</text>
        </g>
        <line x1="360" y1="48" x2="360" y2="70" stroke="#ef4444" stroke-width="2" stroke-dasharray="3,3" />

        <!-- Coaxial Spinneret Needles & Taylor Cone Formation -->
        <g transform="translate(430, 90)">
          <!-- Needles -->
