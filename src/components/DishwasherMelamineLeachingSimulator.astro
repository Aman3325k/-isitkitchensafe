    legalLimits: 'Límites UE (LME): Formaldehído 15 mg/kg · Melamina 2.5 mg/kg · Límite infantil BfR 0.3 mg/kg',
    verdictSafe: 'BAJO RIESGO · APTO PARA ALIMENTOS FRÍOS',
    verdictCaution: 'MIGRACIÓN ELEVADA · EVITAR EN NIÑOS',
    verdictHazard: 'ALERTA · LÍMITE LEGAL SUPERADO (LIXIVIACIÓN)',
    verdictCritical: 'PELIGRO CRÍTICO · DESECHAR INMEDIATAMENTE',
