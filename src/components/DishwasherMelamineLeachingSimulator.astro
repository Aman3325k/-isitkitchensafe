    verdictHazard: 'WARNING · SML EXCEEDED (IRREVERSIBLE LEACHING)',
    verdictCritical: 'CRITICAL TOXIC HAZARD · IMMEDIATE DISPOSAL',
    mechanismTitle: 'Biochemical & Polymer Degradation Mechanism',
    actionTitle: 'Safe Tableware Protocol & Practical Kitchen Rules',
    copyBtn: 'Copy Safety Verdict & Migration Report',
    copySuccess: 'Copied to Clipboard!',
    printBtn: 'Print / Save PDF Report',
    relatedToolsTitle: 'Related Lab Tools & Safe Cookware Calculators'
  },
  es: {
    selectSectionTitle: 'Laboratorio Interactivo de Migración y Estrés Térmico',
    step1: '1. Composición y Estado de la Vajilla',
    step2: '2. Temperatura y Ciclo del Lavavajillas',
    step3: '3. Química del Detergente y Aclarado',
    step4: '4. Uso Posterior: Alimento y Temperatura',
    hint1: 'Las microfisuras multiplican el área de contacto químico',
    hint2: 'Límite térmico: >70°C activa la rotura molecular (BfR)',
    hint3: 'El pH alcalino >10 ataca los puentes de metileno',
    hint4: 'Los líquidos ácidos calientes extraen monómeros libres',
    resultsTitle: 'Evaluación Toxicológica y Métricas de Migración',
    formaldehydeLabel: 'Migración Estimada de Formaldehído',
