  },
  pt: {
    selectSectionTitle: 'Laboratório Interativo de Migração e Estresse Térmico',
    step1: '1. Composição e Desgaste da Louça',
    step2: '2. Temperatura e Ciclo da Máquina de Lavar',
    step3: '3. Química do Detergente e Enxágue',
