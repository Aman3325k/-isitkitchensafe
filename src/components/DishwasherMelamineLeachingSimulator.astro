    verdictHazard: 'ALERTA · LIMITE LEGAL ULTRAPASSADO',
    verdictCritical: 'PERIGO TÓXICO CRÍTICO · DESCARTE IMEDIATO',
    mechanismTitle: 'Mecanismo Bioquímico de Degradação do Polímero',
    actionTitle: 'Protocolo de Segurança e Regras para Cozinha',
    copyBtn: 'Copiar Laudo de Segurança Toxicológica',
    copySuccess: 'Copiado para a Área de Transferência!',
    printBtn: 'Imprimir / Salvar Relatório em PDF',
    relatedToolsTitle: 'Calculadoras Científicas e Comparativos Relacionados'
  },
  'zh-cn': {
    selectSectionTitle: '密胺餐具化学迁移与热解应力交互实验室',
    step1: '1. 餐具材质结构与表面磨损程度',
    step2: '2. 洗碗机清洗水温与烘干程序',
    step3: '3. 洗涤剂酸碱化学属性与漂洗剂',
    step4: '4. 盛装食物酸碱度与使用场景',
    hint1: '表面划痕与微细裂纹成倍放大化学溶出接触面积',
    hint2: '关键热力学阈值：>70°C 触发德国 BfR 树脂加速分解',
    hint3: '强碱性（pH > 10）水解进攻树脂亚甲基醚键',
    hint4: '滚烫酸性汤汁（pH < 4.0）对游离单体具有极强萃取性',
    resultsTitle: '毒理学定量评估与单体迁移预测',
    formaldehydeLabel: '甲醛溶出预估浓度 (Formaldehyde)',
    melamineLabel: '三聚氰胺单体迁移浓度 (Melamine)',
    crazingLabel: '树脂水解裂解度与表面微裂纹指数',
    legalLimits: '国家/欧盟特定迁移限量（SML）：甲醛 15.0 mg/kg · 三聚氰胺 2.5 mg/kg · 德国BfR婴幼儿预警线 0.3 mg/kg',
    verdictSafe: '低迁移风险 · 仅限盛放冷食与常温点心',
    verdictCaution: '中度溶出预警 · 严禁儿童与婴幼儿长期进食',
    verdictHazard: '严重超标预警 · 突破法定限值（不可逆老化析出）',
    verdictCritical: '致癌剧毒极高风险 · 严禁使用并立即淘汰销毁',
    mechanismTitle: '高分子降解化学机理与肾脏毒理学深度解析',
    actionTitle: '密胺餐具黄金安全守则与换新淘汰标准',
    copyBtn: '复制毒理检测报告与安全裁决',
    copySuccess: '已成功复制到剪贴板！',
    printBtn: '打印 / 保存 PDF 安全报告',
    relatedToolsTitle: '相关食品接触安全检测工具与对比报告'
  },
  ja: {
    selectSectionTitle: 'メラミン樹脂の化学溶出＆熱応力シミュレーター',
    step1: '1. 食器の材質構成と表面の経年劣化',
    step2: '2. 食洗機の洗浄温度と乾燥コース',
    step3: '3. 洗剤のpHアルカリ度と仕上げ剤',
    step4: '4. 盛り付ける食品の温度と酸性度',
    hint1: 'カトラリー傷が溶出反応表面積を劇的に増加させます',
    hint2: '臨界温度：70°C以上でドイツBfR加水分解が急速進行',
    hint3: '強アルカリ性（pH 10以上）が架橋エーテル結合を切断',
    hint4: '高温の酸性スープは未反応モノマーを一気に溶出させます',
    resultsTitle: '毒性学定量的リスク評価と溶出予測値',
    formaldehydeLabel: 'ホルムアルデヒド溶出予測値',
    melamineLabel: 'メラミン単量体（モノマー）溶出量',
    crazingLabel: '表面クラック＆ポリマー水解損傷指数',
    legalLimits: 'EU特定移行限度量（SML）：ホルムアルデヒド 15 mg/kg · メラミン 2.5 mg/kg · ドイツBfR乳幼児推奨値 0.3 mg/kg',
    verdictSafe: '低リスク基準内 · 常温・冷菜での使用に限定',
    verdictCaution: '溶出警戒域 · 乳幼児や子供の日常使用は回避',
    verdictHazard: '法定基準値超過 · 著しい化学物質溶出（使用中止推奨）',
    verdictCritical: '極めて危険な毒性レベル · 直ちに廃棄してください',
    mechanismTitle: '生化学的ポリマー崩壊メカニズムと腎機能影響',
    actionTitle: '安全運用プロトコルと交換・破棄の判定基準',
    copyBtn: '判定結果と安全プロトコルをコピー',
    copySuccess: 'クリップボードにコピーしました！',
    printBtn: '印刷 / PDFレポート保存',
    relatedToolsTitle: '関連する食品衛生計算ツールと安全比較ガイド'
  }
};

const t = ui[currentLocale] || ui.en;
---

<div class="melamine-simulator-wrapper bg-surface rounded-2xl border border-hairline shadow-sm overflow-hidden" data-locale={currentLocale}>
  <!-- Safety Banner -->
  <div class="bg-amber-500/10 border-b border-amber-500/20 px-6 py-4 flex items-start gap-3">
    <span class="text-amber-600 text-xl font-bold flex-shrink-0 mt-0.5">⚠️</span>
    <div>
      <h3 class="text-xs font-bold uppercase tracking-wider text-amber-800">{bannerData.title}</h3>
      <p class="text-xs text-amber-900/90 mt-1 leading-relaxed">{bannerData.text}</p>
    </div>
  </div>

  <div class="p-6 md:p-8">
    <div class="mb-6">
      <h2 class="text-xl md:text-2xl font-bold text-ink tracking-tight">{t.selectSectionTitle}</h2>
      <p class="text-sm text-body-subtle mt-1">{t.legalLimits}</p>
    </div>

    <!-- 4-Column Parameter Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-8">
      <!-- Step 1: Tableware Type -->
      <div class="bg-surface-soft p-4 rounded-xl border border-hairline">
        <label for="tableware-select" class="block text-sm font-semibold text-ink mb-1">{t.step1}</label>
        <span class="block text-xs text-body-subtle mb-2">{t.hint1}</span>
        <select id="tableware-select" class="w-full bg-surface border border-hairline rounded-lg px-3 py-2.5 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-signature-coral">
          {localizedTableware.map((item: any, idx: number) => (
            <option value={item.id} selected={idx === 0}>{item.name}</option>
          ))}
        </select>
      </div>

      <!-- Step 2: Wash Cycle -->
      <div class="bg-surface-soft p-4 rounded-xl border border-hairline">
        <label for="cycle-select" class="block text-sm font-semibold text-ink mb-1">{t.step2}</label>
        <span class="block text-xs text-body-subtle mb-2">{t.hint2}</span>
        <select id="cycle-select" class="w-full bg-surface border border-hairline rounded-lg px-3 py-2.5 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-signature-coral">
          {localizedCycles.map((item: any, idx: number) => (
            <option value={item.id} selected={idx === 1}>{item.name}</option>
          ))}
        </select>
      </div>

      <!-- Step 3: Detergent Chemistry -->
      <div class="bg-surface-soft p-4 rounded-xl border border-hairline">
        <label for="detergent-select" class="block text-sm font-semibold text-ink mb-1">{t.step3}</label>
        <span class="block text-xs text-body-subtle mb-2">{t.hint3}</span>
        <select id="detergent-select" class="w-full bg-surface border border-hairline rounded-lg px-3 py-2.5 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-signature-coral">
          {localizedDetergents.map((item: any, idx: number) => (
            <option value={item.id} selected={idx === 1}>{item.name}</option>
          ))}
        </select>
      </div>

      <!-- Step 4: Food Contact Scenario -->
      <div class="bg-surface-soft p-4 rounded-xl border border-hairline">
        <label for="food-select" class="block text-sm font-semibold text-ink mb-1">{t.step4}</label>
        <span class="block text-xs text-body-subtle mb-2">{t.hint4}</span>
        <select id="food-select" class="w-full bg-surface border border-hairline rounded-lg px-3 py-2.5 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-signature-coral">
          {localizedFoodScenarios.map((item: any, idx: number) => (
            <option value={item.id} selected={idx === 1}>{item.name}</option>
          ))}
        </select>
      </div>
    </div>

    <!-- Dynamic Results Display Card -->
    <div id="results-card" class="bg-surface-soft border border-hairline rounded-2xl p-6 md:p-8 mb-8 transition-all duration-300">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-hairline pb-5 mb-6">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-body-subtle">{t.resultsTitle}</span>
          <div id="verdict-badge" class="mt-2 inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-extrabold uppercase tracking-wider bg-emerald-100 text-emerald-800 border border-emerald-300">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span id="verdict-text">{t.verdictSafe}</span>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <button id="copy-verdict-btn" class="px-3.5 py-2 bg-surface hover:bg-surface-soft border border-hairline rounded-lg text-xs font-medium text-ink flex items-center gap-1.5 transition-colors">
            <span>📋</span>
            <span id="copy-text">{t.copyBtn}</span>
          </button>
          <button id="print-verdict-btn" class="px-3.5 py-2 bg-surface hover:bg-surface-soft border border-hairline rounded-lg text-xs font-medium text-ink flex items-center gap-1.5 transition-colors">
            <span>🖨️</span>
            <span>{t.printBtn}</span>
          </button>
        </div>
      </div>

      <!-- 3 Metrics Gauge Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-6">
        <!-- Formaldehyde Metric -->
        <div class="bg-surface p-4 rounded-xl border border-hairline">
          <span class="text-xs font-medium text-body-subtle block mb-1">{t.formaldehydeLabel}</span>
          <div class="flex items-baseline gap-1.5">
            <span id="metric-formaldehyde" class="text-2xl font-black text-ink">3.2</span>
            <span class="text-xs font-bold text-body-subtle">mg/kg</span>
          </div>
          <div class="w-full bg-surface-soft h-2 rounded-full overflow-hidden mt-3">
            <div id="bar-formaldehyde" class="bg-emerald-500 h-full rounded-full transition-all duration-500" style="width: 21%;"></div>
          </div>
          <span id="sub-formaldehyde" class="text-[11px] text-body-subtle block mt-2">EU SML: 15.0 mg/kg max</span>
        </div>

        <!-- Melamine Metric -->
        <div class="bg-surface p-4 rounded-xl border border-hairline">
          <span class="text-xs font-medium text-body-subtle block mb-1">{t.melamineLabel}</span>
          <div class="flex items-baseline gap-1.5">
            <span id="metric-melamine" class="text-2xl font-black text-ink">0.4</span>
            <span class="text-xs font-bold text-body-subtle">mg/kg</span>
          </div>
          <div class="w-full bg-surface-soft h-2 rounded-full overflow-hidden mt-3">
            <div id="bar-melamine" class="bg-emerald-500 h-full rounded-full transition-all duration-500" style="width: 16%;"></div>
          </div>
          <span id="sub-melamine" class="text-[11px] text-body-subtle block mt-2">EU SML: 2.5 mg/kg max</span>
        </div>

        <!-- Degradation / Crazing Metric -->
        <div class="bg-surface p-4 rounded-xl border border-hairline">
          <span class="text-xs font-medium text-body-subtle block mb-1">{t.crazingLabel}</span>
          <div class="flex items-baseline gap-1.5">
            <span id="metric-crazing" class="text-2xl font-black text-ink">28%</span>
            <span class="text-xs font-bold text-body-subtle">damage</span>
          </div>
          <div class="w-full bg-surface-soft h-2 rounded-full overflow-hidden mt-3">
            <div id="bar-crazing" class="bg-emerald-500 h-full rounded-full transition-all duration-500" style="width: 28%;"></div>
          </div>
          <span id="sub-crazing" class="text-[11px] text-body-subtle block mt-2">Micro-fissure surface breakdown</span>
        </div>
      </div>

      <!-- Biochemical Mechanism Box -->
      <div class="bg-surface p-5 rounded-xl border border-hairline mb-4">
        <h3 class="text-xs font-bold uppercase tracking-wider text-ink flex items-center gap-1.5 mb-2">
          <span>🔬</span>
          <span>{t.mechanismTitle}</span>
        </h3>
        <p id="mechanism-text" class="text-xs md:text-sm text-body leading-relaxed">
          Loading mechanism analysis...
        </p>
      </div>

      <!-- Actionable Protocol Box -->
      <div class="bg-surface p-5 rounded-xl border border-hairline">
        <h3 class="text-xs font-bold uppercase tracking-wider text-ink flex items-center gap-1.5 mb-2">
          <span>🛡️</span>
          <span>{t.actionTitle}</span>
        </h3>
        <p id="action-text" class="text-xs md:text-sm text-body leading-relaxed">
          Loading actionable recommendations...
        </p>
      </div>
    </div>

    <!-- Related Cross-Linking Tools -->
    <div class="border-t border-hairline pt-6">
      <h3 class="text-xs font-bold uppercase tracking-wider text-body-subtle mb-3">{t.relatedToolsTitle}</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        <a href={plasticCheckerUrl} class="p-3 rounded-lg border border-hairline bg-surface hover:bg-surface-soft transition-colors block">
          <span class="text-xs font-bold text-ink block">Kitchen Plastic Leaching Checker</span>
          <span class="text-[11px] text-body-subtle mt-0.5 block">Codes #1–#7 food safety thresholds</span>
        </a>
        <a href={rinseAidUrl} class="p-3 rounded-lg border border-hairline bg-surface hover:bg-surface-soft transition-colors block">
          <span class="text-xs font-bold text-ink block">Dishwasher Rinse Aid Troubleshooter</span>
          <span class="text-[11px] text-body-subtle mt-0.5 block">Surfactants, gut barrier & acid film</span>
        </a>
        <a href={microwaveCoverUrl} class="p-3 rounded-lg border border-hairline bg-surface hover:bg-surface-soft transition-colors block">
          <span class="text-xs font-bold text-ink block">Microwave Steam Splash Simulator</span>
          <span class="text-[11px] text-body-subtle mt-0.5 block">Plastic steam cover reflux risks</span>
        </a>
        <a href={brandIndexUrl} class="p-3 rounded-lg border border-hairline bg-surface hover:bg-surface-soft transition-colors block">
          <span class="text-xs font-bold text-ink block">Brand Transparency Index</span>
          <span class="text-[11px] text-body-subtle mt-0.5 block">Audit safe non-toxic dinnerware</span>
        </a>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ rawData, currentLocale, ui }}>
  (function () {
    const tablewareMap = {};
    rawData.tablewareTypes.forEach(function (t) { tablewareMap[t.id] = t; });

    const cycleMap = {};
    rawData.washCycles.forEach(function (c) { cycleMap[c.id] = c; });

    const detergentMap = {};
    rawData.detergentTypes.forEach(function (d) { detergentMap[d.id] = d; });

    const foodMap = {};
    rawData.foodContactScenarios.forEach(function (f) { foodMap[f.id] = f; });

    const t = ui[currentLocale] || ui.en;

    function initSimulator() {
      const tablewareSelect = document.getElementById('tableware-select');
      const cycleSelect = document.getElementById('cycle-select');
      const detergentSelect = document.getElementById('detergent-select');
      const foodSelect = document.getElementById('food-select');

      const verdictBadge = document.getElementById('verdict-badge');
      const verdictText = document.getElementById('verdict-text');
      const metricFormaldehyde = document.getElementById('metric-formaldehyde');
      const metricMelamine = document.getElementById('metric-melamine');
      const metricCrazing = document.getElementById('metric-crazing');
      const barFormaldehyde = document.getElementById('bar-formaldehyde');
      const barMelamine = document.getElementById('bar-melamine');
      const barCrazing = document.getElementById('bar-crazing');
      const mechanismText = document.getElementById('mechanism-text');
      const actionText = document.getElementById('action-text');

      const copyBtn = document.getElementById('copy-verdict-btn');
      const copyText = document.getElementById('copy-text');
      const printBtn = document.getElementById('print-verdict-btn');

      if (!tablewareSelect || !cycleSelect || !detergentSelect || !foodSelect) return;

      function calculate() {
        const tw = tablewareMap[tablewareSelect.value] || rawData.tablewareTypes[0];
        const cy = cycleMap[cycleSelect.value] || rawData.washCycles[0];
        const dt = detergentMap[detergentSelect.value] || rawData.detergentTypes[0];
        const fd = foodMap[foodSelect.value] || rawData.foodContactScenarios[0];

        // Kinetic calculations
        const degradationFactor = cy.tempMultiplier * dt.chemicalFactor;
        const totalFormaldehyde = parseFloat((tw.baselineFormaldehyde * degradationFactor * fd.exposureMultiplier).toFixed(2));
        const totalMelamine = parseFloat((tw.baselineMelamine * degradationFactor * fd.exposureMultiplier).toFixed(2));
        
        let crazingPct = Math.min(100, Math.round(tw.porosityIndex * 22 * degradationFactor));
        if (fd.id === 'microwave_reheat') crazingPct = 100;

        metricFormaldehyde.textContent = totalFormaldehyde.toFixed(1);
        metricMelamine.textContent = totalMelamine.toFixed(1);
        metricCrazing.textContent = crazingPct + '%';

        // Update progress bar widths (capped at 100%)
        const formBarWidth = Math.min(100, Math.round((totalFormaldehyde / 25.0) * 100));
        const melBarWidth = Math.min(100, Math.round((totalMelamine / 5.0) * 100));
        barFormaldehyde.style.width = formBarWidth + '%';
        barMelamine.style.width = melBarWidth + '%';
        barCrazing.style.width = crazingPct + '%';

        // Verdict logic
        let verdict = t.verdictSafe;
        let badgeColor = 'bg-emerald-100 text-emerald-800 border-emerald-300';
        let barColor = 'bg-emerald-500';

        if (fd.id === 'microwave_reheat' || tw.id === 'cheap_uf_blend' && totalFormaldehyde > 20) {
          verdict = t.verdictCritical;
          badgeColor = 'bg-red-200 text-red-950 border-red-400 font-black';
          barColor = 'bg-red-600';
        } else if (totalFormaldehyde > 15.0 || totalMelamine > 2.5) {
          verdict = t.verdictHazard;
          badgeColor = 'bg-red-100 text-red-800 border-red-300';
          barColor = 'bg-red-500';
        } else if (totalFormaldehyde > 0.3 || crazingPct > 40) {
          verdict = t.verdictCaution;
          badgeColor = 'bg-amber-100 text-amber-800 border-amber-300';
          barColor = 'bg-amber-500';
        }

        verdictBadge.className = 'mt-2 inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-extrabold uppercase tracking-wider border ' + badgeColor;
        verdictText.textContent = verdict;
        barFormaldehyde.className = 'h-full rounded-full transition-all duration-500 ' + barColor;
        barMelamine.className = 'h-full rounded-full transition-all duration-500 ' + barColor;
        barCrazing.className = 'h-full rounded-full transition-all duration-500 ' + barColor;

        // Dynamic mechanism explanations
        if (fd.id === 'microwave_reheat') {
          mechanismText.innerHTML = '<strong>Extreme Dielectric Superheating Alert:</strong> Melamine-formaldehyde resin exhibits a high dielectric loss tangent (tan δ ≈ 0.05). Unlike microwave-safe borosilicate glass, the resin directly absorbs 2.45 GHz radiation, heating itself past 140°C in seconds. Polymer crosslinks violently rupture, releasing gaseous formaldehyde (IARC Group 1 carcinogen) and monomeric triazines directly into food.';
          actionText.innerHTML = '<strong>Immediate Directive:</strong> NEVER microwave melamine dishes. Discard this item if blisters, warping, or scorched discolored rings appear on the base. Reheat food only in certified borosilicate glass or high-fired unglazed ceramic.';
        } else if (tw.id === 'bamboo_composite') {
          mechanismText.innerHTML = '<strong>Hydrophilic Fiber Swelling & Matrix Breakdown:</strong> Ground bamboo sawdust embedded in the synthetic resin absorbs wash water and hot food steam. Swelling cellulosic fibers exert internal physical hydrostatic pressure, creating microscopic fissures that allow formaldehyde to migrate up to 30× above EU safety limits.';
          actionText.innerHTML = '<strong>EU Recall Standard:</strong> Bamboo-melamine composite tableware is officially banned in the European Union. Replace all bamboo-blend plates and cups with inert vitrified porcelain, bone china, or food-grade 304 stainless steel.';
        } else if (totalFormaldehyde > 15.0) {
          mechanismText.innerHTML = '<strong>Alkaline-Thermal Cleavage of Ether Bridges:</strong> Dishwasher temperatures exceeding 70°C combined with caustic alkaline silicates (pH > 10.5) hydrolyze the methylol ether links (-NH-CH2-O-CH2-NH-). When acidic soup (pH < 4.0) contacts the damaged surface, solvated formaldehyde spikes past the EU Specific Migration Limit (15 mg/kg).';
          actionText.innerHTML = '<strong>Retire Tableware:</strong> This dish has surpassed safe food contact limits. Do not use for hot, acidic, or fatty foods. Restrict exclusively to dry, room-temperature snacks (bread, fruit slices) or safely recycle.';
        } else if (totalFormaldehyde > 0.3) {
          mechanismText.innerHTML = '<strong>Pediatric Precaution Threshold:</strong> Formaldehyde leaching is below the adult industrial EU limit (15 mg/kg) but exceeds the German Federal Institute for Risk Assessment (BfR) infant threshold of 0.3 mg/kg. Repeated exposure can cause mucosal irritation and contact sensitization in toddlers.';
          actionText.innerHTML = '<strong>Safe Washing Protocol:</strong> Wash melamine on the top rack only at 45°C–50°C using neutral enzyme gel (pH 7.5–8.5). Disallow the bottom rack heated dry cycle. Never serve hot boiling soups (>70°C) to young children in melamine bowls.';
        } else {
          mechanismText.innerHTML = '<strong>Intact Passivated Surface:</strong> The glossy resin barrier remains dense and unetched. Monomer migration stays comfortably within the strictest international standards when dishes are kept away from boiling temperatures and microwave fields.';
          actionText.innerHTML = '<strong>Maintenance Guidelines:</strong> Maintain hand-washing or low-temperature eco-washing. Use soft non-scratch sponges. Inspect annually for cutlery knife scratches and retire dishes once surface gloss fades.';
        }
      }

      tablewareSelect.addEventListener('change', calculate);
      cycleSelect.addEventListener('change', calculate);
      detergentSelect.addEventListener('change', calculate);
      foodSelect.addEventListener('change', calculate);

      if (copyBtn) {
        copyBtn.addEventListener('click', function () {
          const report = 'IsItKitchenSafe Melamine Leaching Report:\n' +
            '- Tableware: ' + tablewareSelect.options[tablewareSelect.selectedIndex].text + '\n' +
            '- Wash Cycle: ' + cycleSelect.options[cycleSelect.selectedIndex].text + '\n' +
            '- Detergent: ' + detergentSelect.options[detergentSelect.selectedIndex].text + '\n' +
            '- Food Re-Use: ' + foodSelect.options[foodSelect.selectedIndex].text + '\n' +
            '- Verdict: ' + verdictText.textContent + '\n' +
            '- Formaldehyde Migration: ' + metricFormaldehyde.textContent + ' mg/kg (EU Limit: 15.0)\n' +
            '- Melamine Monomer: ' + metricMelamine.textContent + ' mg/kg (EU Limit: 2.5)\n' +
            '- Surface Damage: ' + metricCrazing.textContent + '\n' +
            'Generated at: https://isitkitchensafe.com/tools/dishwasher-melamine-leaching-simulator/';
          navigator.clipboard.writeText(report).then(function () {
            copyText.textContent = t.copySuccess;
            setTimeout(function () { copyText.textContent = t.copyBtn; }, 2500);
          });
        });
      }

      if (printBtn) {
        printBtn.addEventListener('click', function () {
          window.print();
        });
      }

      calculate();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSimulator);
    } else {
      initSimulator();
    }
    document.addEventListener('astro:page-load', initSimulator);
  })();
</script>