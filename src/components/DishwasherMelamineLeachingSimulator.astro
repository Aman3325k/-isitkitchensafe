    melamineLabel: 'Melamine Monomer Migration',
    crazingLabel: 'Surface Hydrolysis & Micro-Crazing Index',
    legalLimits: 'EU Specific Migration Limits (SML): Formaldehyde 15.0 mg/kg · Melamine 2.5 mg/kg · BfR Child Limit 0.3 mg/kg',
