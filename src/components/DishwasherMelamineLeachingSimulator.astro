---
import rawData from '../data/dishwasher-melamine-leaching-data.json';
import type { SupportedLanguage } from '../i18n/ui';
import { useTranslatedPath } from '../i18n/utils';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;
const translatePath = useTranslatedPath(lang);

const plasticCheckerUrl = translatePath('/tools/kitchen-plastic-leaching-checker/');
const rinseAidUrl = translatePath('/tools/dishwasher-rinse-aid-scale-troubleshooter/');
const microwaveCoverUrl = translatePath('/tools/microwave-steam-splash-simulator/');
const brandIndexUrl = translatePath('/tools/cookware-brand-transparency-index/');
const comparePlatesUrl = translatePath('/compare/borosilicate-vs-soda-lime-glass-measuring-cup/');
const allToolsUrl = translatePath('/tools/');

const currentLocale = (['en', 'es', 'pt', 'zh-cn', 'ja'].includes(lang) ? lang : 'en') as 'en' | 'es' | 'pt' | 'zh-cn' | 'ja';
const bannerData = rawData.safetyBanner[currentLocale] || rawData.safetyBanner.en;

const localizedTableware = rawData.tablewareTypes.map((t: any) => ({
  id: t.id,
  name: t.name[currentLocale] || t.name.en,
  baselineFormaldehyde: t.baselineFormaldehyde,
  baselineMelamine: t.baselineMelamine,
  porosityIndex: t.porosityIndex,
  durabilityRating: t.durabilityRating
}));

const localizedCycles = rawData.washCycles.map((c: any) => ({
  id: c.id,
  name: c.name[currentLocale] || c.name.en,
  tempMultiplier: c.tempMultiplier,
  thermalDegradation: c.thermalDegradation
}));

const localizedDetergents = rawData.detergentTypes.map((d: any) => ({
  id: d.id,
  name: d.name[currentLocale] || d.name.en,
  chemicalFactor: d.chemicalFactor,
  corrosiveness: d.corrosiveness
}));

const localizedFoodScenarios = rawData.foodContactScenarios.map((f: any) => ({
  id: f.id,
  name: f.name[currentLocale] || f.name.en,
  exposureMultiplier: f.exposureMultiplier,
  riskCategory: f.riskCategory
}));

const ui = {
  en: {
    selectSectionTitle: 'Interactive Migration & Thermal Stress Laboratory',
    step1: '1. Tableware Composition & Physical Age',
    step2: '2. Dishwasher Temperature & Cycle',
