    melamineLabel: 'Migração de Monômero de Melamina',
    crazingLabel: 'Índice de Hidrólise e Microfissuras',
    legalLimits: 'Limites UE (LME): Formaldeído 15 mg/kg · Melamina 2.5 mg/kg · Recomendação infantil BfR 0.3 mg/kg',
