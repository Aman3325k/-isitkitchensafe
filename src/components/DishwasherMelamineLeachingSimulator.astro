      action: '<strong>日常养护与淘汰标准：</strong>建议手洗或洗碗机低温轻柔洗，使用柔软海绵清洁以避免划伤表面。每年定期透光检查餐具，一旦发现表面光泽发乌褪色或出现磨损发白，即达到淘汰使用年限。'
    }
  },
  ja: {
    critical: {
      mechanism: '<strong>誘電加熱による熱暴走アラート：</strong>メラミン樹脂は誘電損失係数が高く（tan δ ≈ 0.05）、2.45 GHzのマイクロ波を直接吸収して数秒で140°C以上に達します。ポリマー架橋が激しく熱分解を起こし、IARCグループ1発がん性物質であるホルムアルデヒドガスとモノマーが食品へ直接噴出します。',
      action: '<strong>緊急注意事項：</strong>メラミン食器は絶対に電子レンジで使用しないでください。発泡、ゆがみ、焦げた変色がある場合は即座に破棄してください。加熱調理には耐熱ボロシリケイトガラスまたは磁器のみを使用してください。'
    },
    bamboo: {
      mechanism: '<strong>親水性繊維の膨潤と樹脂母材の破断：</strong>樹脂に配合された竹粉末が洗浄熱水や湯気を吸収して膨張します。内部応力により微細な亀裂が多発し、EU安全基準値の最大30倍という極めて高濃度のホルムアルデヒドが溶出します。',
      action: '<strong>EU販売禁止リコール基準：</strong>竹繊維入りメラミン食器は欧州連合（EU）で公式に全面販売禁止となっています。耐熱強化磁器、ボーンチャイナ、または食品衛生規格304ステンレス食器に交換してください。'
    },
    hazard: {
      mechanism: '<strong>アルカリ・熱によるエーテル架橋の切断加水分解：</strong>70°C以上の熱湯と強アルカリ洗剤（pH 10.5以上）がメチロールエーテル結合を加水分解します。酸性スープ（pH 4.0未満）と接触すると、EU特定移行限度量（15 mg/kg）を超えるホルムアルデヒドが溶出します。',
      action: '<strong>食器の廃棄・用途制限：</strong>食品接触安全基準を超過しています。熱い料理、酸性食品、油物には使用しないでください。常温の乾燥スナック専用とするか、安全に破棄・リサイクルしてください。'
    },
    caution: {
      mechanism: '<strong>乳幼児予防医学基準アラート：</strong>溶出量は成人向けEU上限（15 mg/kg）内ですが、ドイツBfRが推奨する乳幼児安全基準値（0.3 mg/kg）を超過しています。反復曝露により小児の消化管粘膜やアレルギーリスクを高める懸念があります。',
      action: '<strong>安全洗浄プロトコル：</strong>上段カゴで45°C〜50°Cの低温コースを選択し、中性ジェル洗剤を使用してください。下段ヒーター乾燥は停止してください。乳幼児に熱いスープ（70°C超）をメラミン食器で与えないでください。'
    },
    safe: {
      mechanism: '<strong>保護釉薬層の維持状態：</strong>表面の緻密な架橋バリアが無傷で維持されています。沸騰高温や電子レンジ加熱を避けている限り、モノマー溶出量は国際的な最高水準の食品衛生基準を完全に満たしています。',
      action: '<strong>メンテナンス推奨事項：</strong>手洗いまたは低温エコ洗浄を推奨し、柔らかいスポンジをご使用ください。年に一度カトラリー傷の有無を確認し、表面の光沢が失われた食器は更新してください。'
    }
  }
};

const t = ui[currentLocale] || ui.en;
const localizedExpl = explanations[currentLocale] || explanations.en;

// SSR calculation of default selected state (index 0 tableware, index 1 cycle, index 1 detergent, index 1 food)
// Eliminates cumulative layout shift (CLS) by rendering the exact initial calculation on the server.
const defaultTw = localizedTableware[0];
const defaultCy = localizedCycles[1];
const defaultDt = localizedDetergents[1];
const defaultFd = localizedFoodScenarios[1];

const initDegradationFactor = defaultCy.tempMultiplier * defaultDt.chemicalFactor;
const initTotalFormaldehyde = parseFloat((defaultTw.baselineFormaldehyde * initDegradationFactor * defaultFd.exposureMultiplier).toFixed(2));
const initTotalMelamine = parseFloat((defaultTw.baselineMelamine * initDegradationFactor * defaultFd.exposureMultiplier).toFixed(2));
let initCrazingPct = Math.min(100, Math.round(defaultTw.porosityIndex * 22 * initDegradationFactor));
if (defaultFd.id === 'microwave_reheat') initCrazingPct = 100;

let initCondition = 'safe';
if (defaultFd.id === 'microwave_reheat' || (defaultTw.id === 'cheap_uf_blend' && initTotalFormaldehyde > 20)) {
  initCondition = 'critical';
} else if (defaultTw.id === 'bamboo_composite') {
  initCondition = 'bamboo';
} else if (initTotalFormaldehyde > 15.0 || initTotalMelamine > 2.5) {
  initCondition = 'hazard';
} else if (initTotalFormaldehyde > 0.3 || initCrazingPct > 40) {
  initCondition = 'caution';
}

const initVerdict = initCondition === 'critical' ? t.verdictCritical
  : initCondition === 'hazard' ? t.verdictHazard
  : (initCondition === 'caution' || initCondition === 'bamboo') ? t.verdictCaution
  : t.verdictSafe;

const initBadgeColor = initCondition === 'critical' ? 'bg-red-200 text-red-950 border-red-400 font-black dark:bg-red-900/80 dark:text-red-50 dark:border-red-600'
  : (initCondition === 'hazard' || initCondition === 'bamboo') ? 'bg-red-100 text-red-900 border-red-300 dark:bg-red-950/60 dark:text-red-200 dark:border-red-700'
  : initCondition === 'caution' ? 'bg-amber-100 text-amber-950 border-amber-300 dark:bg-amber-950/60 dark:text-amber-200 dark:border-amber-700'
  : 'bg-emerald-100 text-emerald-900 border-emerald-300 dark:bg-emerald-950/60 dark:text-emerald-200 dark:border-emerald-700';

const initDotColor = initCondition === 'critical' ? 'bg-red-600'
  : (initCondition === 'hazard' || initCondition === 'bamboo') ? 'bg-red-600'
  : initCondition === 'caution' ? 'bg-amber-600'
  : 'bg-emerald-600';

const initBarColor = initDotColor;

const initFormBarWidth = Math.min(100, Math.round((initTotalFormaldehyde / 25.0) * 100));
const initMelBarWidth = Math.min(100, Math.round((initTotalMelamine / 5.0) * 100));
const initExplanation = localizedExpl[initCondition] || localizedExpl.caution;
---

<div class="melamine-simulator-wrapper bg-surface rounded-2xl border border-hairline shadow-sm overflow-hidden" data-locale={currentLocale}>
  <!-- Safety Banner -->
  <div class="bg-amber-500/10 border-b border-amber-500/20 px-6 py-4 flex items-start gap-3">
    <span class="text-amber-700 dark:text-amber-300 text-xl font-bold flex-shrink-0 mt-0.5" aria-hidden="true">⚠️</span>
    <div>
      <h3 class="text-xs font-bold uppercase tracking-wider text-amber-900 dark:text-amber-200">{bannerData.title}</h3>
      <p class="text-xs text-amber-950/90 dark:text-amber-100/90 mt-1 leading-relaxed">{bannerData.text}</p>
    </div>
  </div>

  <div class="p-6 md:p-8">
    <div class="mb-6">
      <h2 class="text-xl md:text-2xl font-bold text-ink tracking-tight">{t.selectSectionTitle}</h2>
      <p class="text-sm text-muted mt-1">{t.legalLimits}</p>
    </div>

    <!-- 4-Column Parameter Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-8">
      <!-- Step 1: Tableware Type -->
      <div class="bg-surface-soft p-4 rounded-xl border border-hairline min-h-[96px]">
        <label for="tableware-select" id="label-tableware" class="block text-sm font-semibold text-ink mb-1">{t.step1}</label>
        <span id="hint-tableware" class="block text-xs text-muted mb-2">{t.hint1}</span>
        <select id="tableware-select" aria-labelledby="label-tableware" aria-describedby="hint-tableware" class="w-full bg-surface border border-hairline rounded-lg px-3 py-2.5 text-sm text-ink cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-signature-coral focus-visible:border-signature-coral transition-colors">
          {localizedTableware.map((item: any, idx: number) => (
            <option value={item.id} selected={idx === 0}>{item.name}</option>
          ))}
        </select>
      </div>

      <!-- Step 2: Wash Cycle -->
      <div class="bg-surface-soft p-4 rounded-xl border border-hairline min-h-[96px]">
        <label for="cycle-select" id="label-cycle" class="block text-sm font-semibold text-ink mb-1">{t.step2}</label>
        <span id="hint-cycle" class="block text-xs text-muted mb-2">{t.hint2}</span>
        <select id="cycle-select" aria-labelledby="label-cycle" aria-describedby="hint-cycle" class="w-full bg-surface border border-hairline rounded-lg px-3 py-2.5 text-sm text-ink cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-signature-coral focus-visible:border-signature-coral transition-colors">
          {localizedCycles.map((item: any, idx: number) => (
            <option value={item.id} selected={idx === 1}>{item.name}</option>
          ))}
        </select>
      </div>

      <!-- Step 3: Detergent Chemistry -->
      <div class="bg-surface-soft p-4 rounded-xl border border-hairline min-h-[96px]">
        <label for="detergent-select" id="label-detergent" class="block text-sm font-semibold text-ink mb-1">{t.step3}</label>
        <span id="hint-detergent" class="block text-xs text-muted mb-2">{t.hint3}</span>
        <select id="detergent-select" aria-labelledby="label-detergent" aria-describedby="hint-detergent" class="w-full bg-surface border border-hairline rounded-lg px-3 py-2.5 text-sm text-ink cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-signature-coral focus-visible:border-signature-coral transition-colors">
          {localizedDetergents.map((item: any, idx: number) => (
            <option value={item.id} selected={idx === 1}>{item.name}</option>
          ))}
        </select>
      </div>

      <!-- Step 4: Food Contact Scenario -->
      <div class="bg-surface-soft p-4 rounded-xl border border-hairline min-h-[96px]">
        <label for="food-select" id="label-food" class="block text-sm font-semibold text-ink mb-1">{t.step4}</label>
        <span id="hint-food" class="block text-xs text-muted mb-2">{t.hint4}</span>
        <select id="food-select" aria-labelledby="label-food" aria-describedby="hint-food" class="w-full bg-surface border border-hairline rounded-lg px-3 py-2.5 text-sm text-ink cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-signature-coral focus-visible:border-signature-coral transition-colors">
          {localizedFoodScenarios.map((item: any, idx: number) => (
            <option value={item.id} selected={idx === 1}>{item.name}</option>
          ))}
        </select>
      </div>
    </div>

    <!-- Dynamic Results Display Card (min-height prevents CLS jumps during calculations) -->
    <div id="results-card" role="region" aria-labelledby="results-card-title" class="bg-surface-soft border border-hairline rounded-2xl p-6 md:p-8 mb-8 transition-all duration-300 min-h-[580px]">
      <!-- Screen Reader Live Status Announcer -->
      <div id="sr-announcements" class="sr-only" aria-live="polite" aria-atomic="true"></div>

      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-hairline pb-5 mb-6">
        <div>
          <span id="results-card-title" class="text-xs font-bold uppercase tracking-wider text-muted">{t.resultsTitle}</span>
          <div class="min-h-[38px] flex items-center">
            <div id="verdict-badge" aria-live="polite" aria-atomic="true" class={`mt-2 inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-extrabold uppercase tracking-wider border min-h-[32px] ${initBadgeColor}`}>
              <span id="verdict-dot" aria-hidden="true" class={`w-2 h-2 rounded-full animate-pulse motion-reduce:animate-none ${initDotColor}`}></span>
              <span id="verdict-text">{initVerdict}</span>
            </div>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <button id="copy-verdict-btn" type="button" class="px-3.5 py-2 bg-surface hover:bg-surface-soft border border-hairline rounded-lg text-xs font-medium text-ink flex items-center gap-1.5 transition-colors cursor-pointer select-none focus:outline-none focus-visible:ring-2 focus-visible:ring-link focus-visible:ring-offset-2">
            <span aria-hidden="true">📋</span>
            <span id="copy-text">{t.copyBtn}</span>
          </button>
          <button id="print-verdict-btn" type="button" class="px-3.5 py-2 bg-surface hover:bg-surface-soft border border-hairline rounded-lg text-xs font-medium text-ink flex items-center gap-1.5 transition-colors cursor-pointer select-none focus:outline-none focus-visible:ring-2 focus-visible:ring-link focus-visible:ring-offset-2">
            <span aria-hidden="true">🖨️</span>
            <span>{t.printBtn}</span>
          </button>
        </div>
      </div>

      <!-- 3 Metrics Gauge Grid (min-height on each card stabilizes height across value changes) -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-6">
        <!-- Formaldehyde Metric -->
        <div class="bg-surface p-4 rounded-xl border border-hairline min-h-[120px] flex flex-col justify-between">
          <div>
            <span id="label-formaldehyde" class="text-xs font-medium text-muted block mb-1">{t.formaldehydeLabel}</span>
            <div class="flex items-baseline gap-1.5">
              <span id="metric-formaldehyde" class="text-2xl font-black text-ink">{initTotalFormaldehyde.toFixed(1)}</span>
              <span class="text-xs font-bold text-muted">mg/kg</span>
            </div>
          </div>
          <div>
            <div class="w-full bg-surface-soft h-2 rounded-full overflow-hidden mt-3 border border-hairline/60">
              <div id="bar-formaldehyde" role="progressbar" aria-labelledby="label-formaldehyde" aria-valuenow={initTotalFormaldehyde.toFixed(1)} aria-valuemin="0" aria-valuemax="25.0" class={`h-full rounded-full transition-all duration-500 ${initBarColor}`} style={`width: ${initFormBarWidth}%;`}></div>
            </div>
            <span id="sub-formaldehyde" class="text-[11px] text-muted block mt-2">EU SML: 15.0 mg/kg max</span>
          </div>
        </div>

        <!-- Melamine Metric -->
        <div class="bg-surface p-4 rounded-xl border border-hairline min-h-[120px] flex flex-col justify-between">
          <div>
            <span id="label-melamine" class="text-xs font-medium text-muted block mb-1">{t.melamineLabel}</span>
            <div class="flex items-baseline gap-1.5">
              <span id="metric-melamine" class="text-2xl font-black text-ink">{initTotalMelamine.toFixed(1)}</span>
              <span class="text-xs font-bold text-muted">mg/kg</span>
            </div>
          </div>
          <div>
            <div class="w-full bg-surface-soft h-2 rounded-full overflow-hidden mt-3 border border-hairline/60">
              <div id="bar-melamine" role="progressbar" aria-labelledby="label-melamine" aria-valuenow={initTotalMelamine.toFixed(1)} aria-valuemin="0" aria-valuemax="5.0" class={`h-full rounded-full transition-all duration-500 ${initBarColor}`} style={`width: ${initMelBarWidth}%;`}></div>
            </div>
            <span id="sub-melamine" class="text-[11px] text-muted block mt-2">EU SML: 2.5 mg/kg max</span>
          </div>
        </div>

        <!-- Degradation / Crazing Metric -->
        <div class="bg-surface p-4 rounded-xl border border-hairline min-h-[120px] flex flex-col justify-between">
          <div>
            <span id="label-crazing" class="text-xs font-medium text-muted block mb-1">{t.crazingLabel}</span>
            <div class="flex items-baseline gap-1.5">
              <span id="metric-crazing" class="text-2xl font-black text-ink">{initCrazingPct}%</span>
              <span class="text-xs font-bold text-muted">damage</span>
            </div>
          </div>
          <div>
            <div class="w-full bg-surface-soft h-2 rounded-full overflow-hidden mt-3 border border-hairline/60">
              <div id="bar-crazing" role="progressbar" aria-labelledby="label-crazing" aria-valuenow={initCrazingPct} aria-valuemin="0" aria-valuemax="100" class={`h-full rounded-full transition-all duration-500 ${initBarColor}`} style={`width: ${initCrazingPct}%;`}></div>
            </div>
            <span id="sub-crazing" class="text-[11px] text-muted block mt-2">Micro-fissure surface breakdown</span>
          </div>
        </div>
      </div>

      <!-- Biochemical Mechanism Box (min-height prevents layout shifts when explanations change) -->
      <div class="bg-surface p-5 rounded-xl border border-hairline mb-4 min-h-[105px] sm:min-h-[85px] flex flex-col justify-center">
        <h3 class="text-xs font-bold uppercase tracking-wider text-ink flex items-center gap-1.5 mb-2 shrink-0">
          <span aria-hidden="true">🔬</span>
          <span>{t.mechanismTitle}</span>
        </h3>
        <p id="mechanism-text" class="text-xs md:text-sm text-body leading-relaxed" set:html={initExplanation.mechanism} />
      </div>

      <!-- Actionable Protocol Box (min-height prevents layout shifts when recommendations change) -->
      <div class="bg-surface p-5 rounded-xl border border-hairline min-h-[90px] sm:min-h-[75px] flex flex-col justify-center">
        <h3 class="text-xs font-bold uppercase tracking-wider text-ink flex items-center gap-1.5 mb-2 shrink-0">
          <span aria-hidden="true">🛡️</span>
          <span>{t.actionTitle}</span>
        </h3>
        <p id="action-text" class="text-xs md:text-sm text-body leading-relaxed" set:html={initExplanation.action} />
      </div>
    </div>

    <!-- Related Cross-Linking Tools -->
    <div class="border-t border-hairline pt-6">
      <h3 class="text-xs font-bold uppercase tracking-wider text-muted mb-3">{t.relatedToolsTitle}</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        <a href={plasticCheckerUrl} class="p-3 rounded-lg border border-hairline bg-surface hover:bg-surface-soft transition-colors block focus:outline-none focus-visible:ring-2 focus-visible:ring-link focus-visible:ring-offset-2">
          <span class="text-xs font-bold text-ink block">Kitchen Plastic Leaching Checker</span>
          <span class="text-[11px] text-muted mt-0.5 block">Codes #1–#7 food safety thresholds</span>
        </a>
        <a href={rinseAidUrl} class="p-3 rounded-lg border border-hairline bg-surface hover:bg-surface-soft transition-colors block focus:outline-none focus-visible:ring-2 focus-visible:ring-link focus-visible:ring-offset-2">
          <span class="text-xs font-bold text-ink block">Dishwasher Rinse Aid Troubleshooter</span>
          <span class="text-[11px] text-muted mt-0.5 block">Surfactants, gut barrier & acid film</span>
        </a>
        <a href={microwaveCoverUrl} class="p-3 rounded-lg border border-hairline bg-surface hover:bg-surface-soft transition-colors block focus:outline-none focus-visible:ring-2 focus-visible:ring-link focus-visible:ring-offset-2">
          <span class="text-xs font-bold text-ink block">Microwave Steam Splash Simulator</span>
          <span class="text-[11px] text-muted mt-0.5 block">Plastic steam cover reflux risks</span>
        </a>
        <a href={brandIndexUrl} class="p-3 rounded-lg border border-hairline bg-surface hover:bg-surface-soft transition-colors block focus:outline-none focus-visible:ring-2 focus-visible:ring-link focus-visible:ring-offset-2">
          <span class="text-xs font-bold text-ink block">Brand Transparency Index</span>
          <span class="text-[11px] text-muted mt-0.5 block">Audit safe non-toxic dinnerware</span>
        </a>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ rawData, currentLocale, ui, explanations }}>
  (function () {
    const tablewareMap = {};
    rawData.tablewareTypes.forEach(function (t) { tablewareMap[t.id] = t; });

    const cycleMap = {};
    rawData.washCycles.forEach(function (c) { cycleMap[c.id] = c; });

    const detergentMap = {};
    rawData.detergentTypes.forEach(function (d) { detergentMap[d.id] = d; });

    const foodMap = {};
    rawData.foodContactScenarios.forEach(function (f) { foodMap[f.id] = f; });

    const t = ui[currentLocale] || ui.en;
    const localizedExpl = explanations[currentLocale] || explanations.en;

    function initSimulator() {
      const tablewareSelect = document.getElementById('tableware-select');
      const cycleSelect = document.getElementById('cycle-select');
      const detergentSelect = document.getElementById('detergent-select');
      const foodSelect = document.getElementById('food-select');

      if (!tablewareSelect || !cycleSelect || !detergentSelect || !foodSelect) return;

      // Guard against duplicate listener binding on astro:page-load or re-inits
      if (tablewareSelect.dataset.bound === 'true') return;
      tablewareSelect.dataset.bound = 'true';

      const verdictBadge = document.getElementById('verdict-badge');
      const verdictDot = document.getElementById('verdict-dot');
      const verdictText = document.getElementById('verdict-text');
      const metricFormaldehyde = document.getElementById('metric-formaldehyde');
      const metricMelamine = document.getElementById('metric-melamine');
      const metricCrazing = document.getElementById('metric-crazing');
      const barFormaldehyde = document.getElementById('bar-formaldehyde');
      const barMelamine = document.getElementById('bar-melamine');
      const barCrazing = document.getElementById('bar-crazing');
      const mechanismText = document.getElementById('mechanism-text');
      const actionText = document.getElementById('action-text');

      const copyBtn = document.getElementById('copy-verdict-btn');
      const copyText = document.getElementById('copy-text');
      const printBtn = document.getElementById('print-verdict-btn');

      let rafId = null;

      function calculate() {
        if (rafId) cancelAnimationFrame(rafId);
        rafId = requestAnimationFrame(function () {
          const tw = tablewareMap[tablewareSelect.value] || rawData.tablewareTypes[0];
          const cy = cycleMap[cycleSelect.value] || rawData.washCycles[0];
          const dt = detergentMap[detergentSelect.value] || rawData.detergentTypes[0];
          const fd = foodMap[foodSelect.value] || rawData.foodContactScenarios[0];

          // Kinetic calculations
          const degradationFactor = cy.tempMultiplier * dt.chemicalFactor;
          const totalFormaldehyde = parseFloat((tw.baselineFormaldehyde * degradationFactor * fd.exposureMultiplier).toFixed(2));
          const totalMelamine = parseFloat((tw.baselineMelamine * degradationFactor * fd.exposureMultiplier).toFixed(2));
          
          let crazingPct = Math.min(100, Math.round(tw.porosityIndex * 22 * degradationFactor));
          if (fd.id === 'microwave_reheat') crazingPct = 100;

          if (metricFormaldehyde) metricFormaldehyde.textContent = totalFormaldehyde.toFixed(1);
          if (metricMelamine) metricMelamine.textContent = totalMelamine.toFixed(1);
          if (metricCrazing) metricCrazing.textContent = crazingPct + '%';

          // Update progress bar widths (capped at 100%) and ARIA attributes
          const formBarWidth = Math.min(100, Math.round((totalFormaldehyde / 25.0) * 100));
          const melBarWidth = Math.min(100, Math.round((totalMelamine / 5.0) * 100));
          if (barFormaldehyde) {
            barFormaldehyde.style.width = formBarWidth + '%';
            barFormaldehyde.setAttribute('aria-valuenow', totalFormaldehyde.toFixed(1));
          }
          if (barMelamine) {
            barMelamine.style.width = melBarWidth + '%';
            barMelamine.setAttribute('aria-valuenow', totalMelamine.toFixed(1));
          }
          if (barCrazing) {
            barCrazing.style.width = crazingPct + '%';
            barCrazing.setAttribute('aria-valuenow', crazingPct.toString());
          }

          // Verdict & explanation condition logic (WCAG 2.1 AA compliant contrast)
          let condition = 'safe';
          let verdict = t.verdictSafe;
          let badgeColor = 'bg-emerald-100 text-emerald-900 border-emerald-300 dark:bg-emerald-950/60 dark:text-emerald-200 dark:border-emerald-700';
          let dotColor = 'bg-emerald-600';
          let barColor = 'bg-emerald-600';

          if (fd.id === 'microwave_reheat' || (tw.id === 'cheap_uf_blend' && totalFormaldehyde > 20)) {
            condition = 'critical';
            verdict = t.verdictCritical;
            badgeColor = 'bg-red-200 text-red-950 border-red-400 font-black dark:bg-red-900/80 dark:text-red-50 dark:border-red-600';
            dotColor = 'bg-red-600';
            barColor = 'bg-red-600';
          } else if (tw.id === 'bamboo_composite') {
            condition = 'bamboo';
            verdict = totalFormaldehyde > 15.0 ? t.verdictHazard : t.verdictCaution;
            badgeColor = totalFormaldehyde > 15.0 ? 'bg-red-100 text-red-900 border-red-300 dark:bg-red-950/60 dark:text-red-200 dark:border-red-700' : 'bg-amber-100 text-amber-950 border-amber-300 dark:bg-amber-950/60 dark:text-amber-200 dark:border-amber-700';
            dotColor = totalFormaldehyde > 15.0 ? 'bg-red-600' : 'bg-amber-600';
            barColor = dotColor;
          } else if (totalFormaldehyde > 15.0 || totalMelamine > 2.5) {
            condition = 'hazard';
            verdict = t.verdictHazard;
            badgeColor = 'bg-red-100 text-red-900 border-red-300 dark:bg-red-950/60 dark:text-red-200 dark:border-red-700';
            dotColor = 'bg-red-600';
            barColor = 'bg-red-600';
          } else if (totalFormaldehyde > 0.3 || crazingPct > 40) {
            condition = 'caution';
            verdict = t.verdictCaution;
            badgeColor = 'bg-amber-100 text-amber-950 border-amber-300 dark:bg-amber-950/60 dark:text-amber-200 dark:border-amber-700';
            dotColor = 'bg-amber-600';
            barColor = 'bg-amber-600';
          }

          if (verdictBadge) {
            verdictBadge.className = 'mt-2 inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-extrabold uppercase tracking-wider border min-h-[32px] ' + badgeColor;
          }
          if (verdictDot) {
            verdictDot.className = 'w-2 h-2 rounded-full animate-pulse motion-reduce:animate-none ' + dotColor;
          }
          if (verdictText) {
            verdictText.textContent = verdict;
          }

          if (barFormaldehyde) barFormaldehyde.className = 'h-full rounded-full transition-all duration-500 ' + barColor;
          if (barMelamine) barMelamine.className = 'h-full rounded-full transition-all duration-500 ' + barColor;
          if (barCrazing) barCrazing.className = 'h-full rounded-full transition-all duration-500 ' + barColor;

          // Screen reader live status announcement
          const srAnnouncements = document.getElementById('sr-announcements');
          if (srAnnouncements) {
            srAnnouncements.textContent = verdict + '. ' +
              t.formaldehydeLabel + ': ' + totalFormaldehyde.toFixed(1) + ' mg/kg. ' +
              t.melamineLabel + ': ' + totalMelamine.toFixed(1) + ' mg/kg. ' +
              t.crazingLabel + ': ' + crazingPct + '%.';
          }

          function setSafeMessage(element, rawText) {
            if (!element) return;
            element.textContent = '';
            if (!rawText) return;
            const match = String(rawText).match(/^<strong>(.*?)<\/strong>(.*)$/s);
            if (match) {
              const strong = document.createElement('strong');
              strong.textContent = match[1];
              element.appendChild(strong);
              element.appendChild(document.createTextNode(match[2]));
            } else {
              element.textContent = rawText;
            }
          }

          // Localized dynamic mechanism explanations
          const expl = localizedExpl[condition] || localizedExpl.safe;
          if (mechanismText && expl) {
            setSafeMessage(mechanismText, expl.mechanism);
          }
          if (actionText && expl) {
            setSafeMessage(actionText, expl.action);
          }
        });
      }

      tablewareSelect.addEventListener('change', calculate);
      cycleSelect.addEventListener('change', calculate);
      detergentSelect.addEventListener('change', calculate);
      foodSelect.addEventListener('change', calculate);

      tablewareSelect.addEventListener('input', calculate);
      cycleSelect.addEventListener('input', calculate);
      detergentSelect.addEventListener('input', calculate);
      foodSelect.addEventListener('input', calculate);

      if (copyBtn) {
        copyBtn.addEventListener('click', function () {
          const report = 'IsItKitchenSafe Melamine Leaching Report:\n' +
            '- Tableware: ' + tablewareSelect.options[tablewareSelect.selectedIndex].text + '\n' +
            '- Wash Cycle: ' + cycleSelect.options[cycleSelect.selectedIndex].text + '\n' +
            '- Detergent: ' + detergentSelect.options[detergentSelect.selectedIndex].text + '\n' +
            '- Food Re-Use: ' + foodSelect.options[foodSelect.selectedIndex].text + '\n' +
            '- Verdict: ' + (verdictText ? verdictText.textContent : '') + '\n' +
            '- Formaldehyde Migration: ' + (metricFormaldehyde ? metricFormaldehyde.textContent : '') + ' mg/kg (EU Limit: 15.0)\n' +
            '- Melamine Monomer: ' + (metricMelamine ? metricMelamine.textContent : '') + ' mg/kg (EU Limit: 2.5)\n' +
            '- Surface Damage: ' + (metricCrazing ? metricCrazing.textContent : '') + '\n' +
            'Generated at: https://isitkitchensafe.com/tools/dishwasher-melamine-leaching-simulator/';
          navigator.clipboard.writeText(report).then(function () {
            if (copyText) {
              copyText.textContent = t.copySuccess;
              const srAnnouncements = document.getElementById('sr-announcements');
              if (srAnnouncements) {
                srAnnouncements.textContent = t.copySuccess;
              }
              setTimeout(function () { copyText.textContent = t.copyBtn; }, 2500);
            }
          });
        });
      }

      if (printBtn) {
        printBtn.addEventListener('click', function () {
          window.print();
        });
      }

      calculate();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSimulator);
    } else {
      initSimulator();
    }
    document.addEventListener('astro:page-load', initSimulator);
  })();
</script>
