    rule3Text: "乙酸会与铜和铅发生剧烈化学反应生成易溶的乙酸铜（铜绿）和高毒性乙酸铅（铅糖），且酸味会永久渗入硅胶与三元乙丙橡胶密封圈中。",
    rule4Title: "除垢冲洗后必须萃取并丢弃前3至4杯咖啡测试饼",
    rule4Text: "即使用清水彻底冲洗，9 Bar高压咖啡水流仍会冲刷脱落被酸软化的微观氧化物粉末。萃取并舍弃3杯咖啡能利用咖啡天然油脂重新钝化黄铜水路。",
    copyReportBtn: "复制咖啡机重金属析出审计报告",
    copiedFeedback: "咖啡机水路重金属与除垢毒理学审计报告已成功复制至剪贴板！"
  },
  ja: {
    badge: "金属工学＆流体ダイナミクス毒性モデラー",
    title: "エスプレッソマシン金属溶出＆スケール除去鉛リスクモデラー",
    subtitle: "真鍮製ボイラーやサーモブロックからの鉛・銅イオン溶出を、9気圧高温（92°C〜96°C）抽出およびクエン酸・スルファミン酸洗浄条件下でモデル化。NSF/ANSI 372基準およびWHO基準に準拠。",
    controlsTitle: "エスプレッソマシン水路金属スペック＆除垢パラメーター",
    controlsSub: "ボイラー合金組成、除垢薬剤の種類と温度、抽出水動力学、洗浄後のすすぎプロトコル、機械の稼働年数を設定してください。",
    boilerLabel: "ボイラー・サーモブロック水路金属材質：",
    boilerHelp: "伝統的な快削鉛入り真鍮（CW614N） vs 低鉛表面処理TEA真鍮 vs アルミダイキャストサーモブロック vs デュアル316L外科用ステンレス。",
    descalerLabel: "スケール除去剤の種類と洗浄温度：",
    descalerHelp: "90°C高温クエン酸洗浄 vs 60°C業務用スルファミン酸 vs 25°C常温クエン酸 vs 5%穀物酢（危険な裏技） vs 標準SCA基準抽出水。",
    hydroLabel: "水圧ダイナミクス＆通水モード：",
    hydroHelp: "9気圧バイブレーションポンプ（脈動せん断） vs 業務用ロータリーポンプ vs 一晩12時間滞留 vs スチームボイラー濃縮ブロー。",
    flushLabel: "スケール洗浄後すすぎ・中和プロトコル：",
    flushHelp: "すすぎゼロ即時抽出（極めて危険） vs 1タンク1.5L簡易すすぎ vs 認証基準3タンク4.5L以上完全フラッシュ vs 重曹バッファー中和。",
    ageLabel: "マシンの稼働年数＆熱サイクル疲労（年）：",
    ageHelp: "長年の加熱サイクルと酸洗浄により結晶粒界の脱亜鉛・脱鉛が進行し、鉛の溶出速度が上昇します。",
    presetsTitle: "実証ケーススタディ＆プリセット診断シナリオ：",
    presetHotCitricBrass: "高温クエン酸＋真鍮ボイラー＋すすぎゼロ（危険な急性鉛溶出サージ）",
    presetOvernightDwell: "伝統的イタリアン真鍮機の一晩12時間滞留（朝イチ1杯目の鉛ピーク）",
    presetVinegarAluminum: "アルミ加熱ブロックに穀物酢を使用（腐食孔食と毒性酢酸塩）",
    presetSulfamicCertifiedPurge: "業務用スルファミン酸＋3タンク4.5L完全通水すすぎ（安全推奨基準）",
    presetStainlessBaseline: "316L外科用ステンレスボイラー基準抽出（重金属ゼロの理想基準）",
    diagnosticTitle: "水路重金属溶出＆抽出毒性診断カード",
    diagnosticSub: "抽出液中の鉛（Pb）および銅（Cu）濃度をリアルタイム算定し、WHO、欧州水質指令、NSF/ANSI 372基準と比較評価。",
    leadLabel: "流出液鉛（Pb）重金属濃度",
    copperLabel: "流出液銅（Cu）イオン濃度",
    phLabel: "水路残留酸液pH値・酸性度",
    hazardScoreLabel: "経口摂取毒性リスク指数",
    safetyStatusLabel: "抽出水質の衛生安全性ステータス",
    mechanismLabel: "金属腐食電気化学＆重金属溶出メカニズム",
    actionGuidanceLabel: "マシン除垢安全管理エンジニアリング手順",
    scienceTitle: "脱亜鉛カイネティクス、独BfR研究、およびNSF/ANSI 372規格の科学",
    scienceSub: "なぜ強力な酸性洗浄剤が保護酸化皮膜を剥ぎ取り、朝のエスプレッソに毒性金属を溶出させてしまうのか。",
    tableTitle: "エスプレッソマシンボイラー金属材質の比較性能表",
    tableSub: "合金の元素構成、遊離鉛相の分布、耐酸腐食性、再不動態化に要する時間を一覧比較。",
    colBoiler: "水路金属材質 / 基材",
    colCategory: "マシン区分",
    colLeadContent: "鉛（Pb）含有率%",
    colCopperContent: "銅（Cu）含有率%",
    colVulnerability: "酸浸食脆弱性",
    colPassivation: "再不動態化時間",
    rulesTitle: "エスプレッソマシンスケール除去の安全鉄則",
    rulesSub: "金属工学に基づき、鉛や重金属の体内摂取を完全に防止するための必須ガイドライン。",
    rule1Title: "ボイラーが熱い状態（>60°C）で酸洗浄を行わないこと",
    rule1Text: "高温下ではクエン酸による鉛・銅のキレート溶出反応が爆発的に加速します。スケール洗浄は必ずマシンが冷えた状態（<30°C）で行ってください。",
    rule2Title: "除垢後は必ず最低3タンク（4.5リットル以上）の完全通水を行う",
    rule2Text: "1回だけのすすぎでは内部の死角に酸や微粒子が残ります。抽出ヘッド1.5L、スチーム1.5L、給湯ノズル1.5Lを均等に通水してください。",
    rule3Title: "食酢（酢酸）をエスプレッソマシンに絶対に使用しない",
    rule3Text: "酢酸は真鍮や銅と反応して有害な酢酸銅や神経毒性のある酢酸鉛を生成します。また、シリコンパッキンに臭いが長期間染み付きます。",
    rule4Title: "除垢後の最初の3〜4杯のエスプレッソは飲まずに廃棄する",
    rule4Text: "水ですすいだ後でも、9気圧の圧力抽出で遊離した微粒子が削り落とされます。3杯抽出して捨てることで、コーヒーの油分が真鍮表面を再コーティングします。",
    copyReportBtn: "エスプレッソマシン金属監査レポートをコピー",
    copiedFeedback: "金属工学＆毒性監査レポートをクリップボードにコピーしました！"
  }
};

const d = DICTIONARY[lang] || DICTIONARY.en;
---

<div class="my-10 bg-surface border border-hairline rounded-3xl p-6 md:p-8 shadow-sm">
  <!-- Header -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-hairline pb-6">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-amber-500/10 text-amber-800 border border-amber-500/20 mb-2">
        <span>☕</span>
        {d.badge}
      </div>
      <h2 class="text-2xl md:text-3xl font-bold text-ink tracking-tight">
        {d.title}
      </h2>
      <p class="text-sm md:text-base text-muted mt-1 max-w-3xl">
        {d.subtitle}
      </p>
    </div>
    <div class="shrink-0 flex items-center gap-2">
      <button
        id="copy-report-btn"
        class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-surface-soft hover:bg-surface-elevated text-xs font-semibold text-ink border border-hairline transition-all shadow-xs cursor-pointer"
        type="button"
      >
        <span>📋</span>
        <span id="copy-btn-text">{d.copyReportBtn}</span>
      </button>
    </div>
  </div>

  <!-- Presets -->
  <div class="py-6 border-b border-hairline">
    <div class="text-xs font-bold uppercase tracking-wider text-muted mb-3">
      {d.presetsTitle}
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2.5">
      <button
        type="button"
        class="preset-btn text-left p-3 rounded-xl bg-surface-soft hover:bg-rose-500/10 hover:border-rose-300 border border-hairline transition-all text-xs"
        data-boiler="leaded-free-cutting-brass"
        data-descaler="citric-acid-hot-descaling"
        data-hydro="vibratory-pump-9bar"
        data-flush="zero-flush-first-shot"
        data-age="6"
      >
        <span class="font-bold text-rose-800 block mb-0.5">🚨 {d.presetHotCitricBrass.split('(')[0]}</span>
        <span class="text-muted text-[11px] leading-tight block">{d.presetHotCitricBrass.includes('(') ? `(${d.presetHotCitricBrass.split('(')[1]}` : ''}</span>
      </button>

      <button
        type="button"
        class="preset-btn text-left p-3 rounded-xl bg-surface-soft hover:bg-amber-500/10 hover:border-amber-300 border border-hairline transition-all text-xs"
        data-boiler="leaded-free-cutting-brass"
        data-descaler="baseline-sca-potable-water"
        data-hydro="stagnant-overnight-dwell"
        data-flush="zero-flush-first-shot"
        data-age="5"
      >
        <span class="font-bold text-amber-800 block mb-0.5">🌅 {d.presetOvernightDwell.split('(')[0]}</span>
        <span class="text-muted text-[11px] leading-tight block">{d.presetOvernightDwell.includes('(') ? `(${d.presetOvernightDwell.split('(')[1]}` : ''}</span>
      </button>

      <button
        type="button"
        class="preset-btn text-left p-3 rounded-xl bg-surface-soft hover:bg-orange-500/10 hover:border-orange-300 border border-hairline transition-all text-xs"
        data-boiler="die-cast-aluminum-thermoblock"
        data-descaler="vinegar-acetic-acid-hazard"
        data-hydro="vibratory-pump-9bar"
        data-flush="single-reservoir-flush"
        data-age="3"
      >
        <span class="font-bold text-orange-800 block mb-0.5">⚠️ {d.presetVinegarAluminum.split('(')[0]}</span>
        <span class="text-muted text-[11px] leading-tight block">{d.presetVinegarAluminum.includes('(') ? `(${d.presetVinegarAluminum.split('(')[1]}` : ''}</span>
      </button>

      <button
        type="button"
        class="preset-btn text-left p-3 rounded-xl bg-surface-soft hover:bg-blue-500/10 hover:border-blue-300 border border-hairline transition-all text-xs"
        data-boiler="tea-coated-brass"
        data-descaler="sulfamic-acid-commercial"
        data-hydro="rotary-vane-commercial"
        data-flush="certified-three-reservoir-purge"
        data-age="2"
      >
        <span class="font-bold text-blue-800 block mb-0.5">🛡️ {d.presetSulfamicCertifiedPurge.split('(')[0]}</span>
        <span class="text-muted text-[11px] leading-tight block">{d.presetSulfamicCertifiedPurge.includes('(') ? `(${d.presetSulfamicCertifiedPurge.split('(')[1]}` : ''}</span>
      </button>

      <button
        type="button"
        class="preset-btn text-left p-3 rounded-xl bg-surface-soft hover:bg-emerald-500/10 hover:border-emerald-300 border border-hairline transition-all text-xs"
        data-boiler="marine-grade-316l-stainless"
        data-descaler="baseline-sca-potable-water"
        data-hydro="rotary-vane-commercial"
        data-flush="certified-three-reservoir-purge"
        data-age="1"
      >
        <span class="font-bold text-emerald-800 block mb-0.5">✨ {d.presetStainlessBaseline.split('(')[0]}</span>
        <span class="text-muted text-[11px] leading-tight block">{d.presetStainlessBaseline.includes('(') ? `(${d.presetStainlessBaseline.split('(')[1]}` : ''}</span>
      </button>
    </div>
  </div>

  <!-- Interactive Controls & Diagnostic Layout -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 py-8">
    <!-- Controls Column (7 cols) -->
    <div class="lg:col-span-7 space-y-6">
      <div>
        <h3 class="text-lg font-bold text-ink mb-1">{d.controlsTitle}</h3>
        <p class="text-xs text-muted">{d.controlsSub}</p>
      </div>

      <!-- Boiler Metallurgy Select -->
      <div>
        <label for="select-boiler" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5">
          {d.boilerLabel}
        </label>
        <select
          id="select-boiler"
          class="w-full bg-surface-soft border border-hairline rounded-xl px-3.5 py-2.5 text-xs text-ink focus:outline-hidden focus:ring-2 focus:ring-amber-500/40"
        >
          {modelData.boilerMetallurgies.map(b => (
            <option value={b.id}>
              {b.name}
            </option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1">{d.boilerHelp}</p>
      </div>

      <!-- Descaler Regime Select -->
      <div>
        <label for="select-descaler" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5">
          {d.descalerLabel}
        </label>
        <select
          id="select-descaler"
          class="w-full bg-surface-soft border border-hairline rounded-xl px-3.5 py-2.5 text-xs text-ink focus:outline-hidden focus:ring-2 focus:ring-amber-500/40"
        >
          {modelData.descalingRegimes.map(r => (
            <option value={r.id}>
              {r.name}
            </option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1">{d.descalerHelp}</p>
      </div>

      <!-- Hydrodynamic Scenario Select -->
      <div>
        <label for="select-hydro" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5">
          {d.hydroLabel}
        </label>
        <select
          id="select-hydro"
          class="w-full bg-surface-soft border border-hairline rounded-xl px-3.5 py-2.5 text-xs text-ink focus:outline-hidden focus:ring-2 focus:ring-amber-500/40"
        >
          {modelData.hydrodynamicScenarios.map(h => (
            <option value={h.id}>
              {h.name}
            </option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1">{d.hydroHelp}</p>
      </div>

      <!-- Flush Protocol Select -->
      <div>
        <label for="select-flush" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5">
          {d.flushLabel}
        </label>
        <select
          id="select-flush"
          class="w-full bg-surface-soft border border-hairline rounded-xl px-3.5 py-2.5 text-xs text-ink focus:outline-hidden focus:ring-2 focus:ring-amber-500/40"
        >
          {modelData.flushingProtocols.map(f => (
            <option value={f.id}>
              {f.name}
            </option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1">{d.flushHelp}</p>
      </div>

      <!-- Machine Age Slider -->
      <div>
        <div class="flex items-center justify-between mb-1.5">
          <label for="slider-age" class="text-xs font-bold uppercase tracking-wider text-ink">
            {d.ageLabel}
          </label>
          <span id="val-age" class="text-xs font-mono font-bold text-amber-800 bg-amber-500/10 px-2 py-0.5 rounded-md border border-amber-500/20">
            3.0 Years
          </span>
        </div>
        <input
          type="range"
          id="slider-age"
          min="0"
          max="10"
          step="0.5"
          value="3"
          class="w-full accent-amber-700 cursor-pointer"
        />
        <p class="text-[11px] text-muted mt-1">{d.ageHelp}</p>
      </div>
    </div>

    <!-- Live Diagnostics Column (5 cols) -->
    <div class="lg:col-span-5 flex flex-col justify-between">
      <div id="status-card" class="p-6 rounded-2xl border transition-all duration-300 bg-surface-soft border-hairline space-y-6">
        <div>
          <div class="flex items-center justify-between gap-2 mb-3">
            <span class="text-xs font-bold uppercase tracking-wider text-muted">{d.diagnosticTitle}</span>
            <span id="status-pill" class="text-xs font-extrabold uppercase px-3 py-1 rounded-full tracking-wider border">
              SAFE
            </span>
          </div>
          <h4 id="status-headline" class="text-base font-bold text-ink leading-snug mb-1.5">
            Optimal Operating Envelope
          </h4>
          <p id="status-desc" class="text-xs text-muted leading-relaxed">
            Metal migration and fluid pH comply with potable standards.
          </p>
        </div>

        <!-- 4 Critical Metrics Grid -->
        <div class="grid grid-cols-2 gap-3 pt-2">
          <!-- Metric 1: Lead (Pb) Concentration -->
          <div class="p-3 rounded-xl bg-surface border border-hairline">
            <div class="text-[11px] font-semibold text-muted uppercase tracking-wider mb-1 flex items-center justify-between">
              <span>{d.leadLabel}</span>
              <span class="text-rose-700 font-bold">Pb</span>
            </div>
            <div id="out-lead" class="text-xl font-mono font-extrabold text-ink">0.0 µg/L</div>
            <div id="out-lead-sub" class="text-[10px] text-muted font-mono mt-0.5">WHO Limit: 10 µg/L</div>
          </div>

          <!-- Metric 2: Copper (Cu) Concentration -->
          <div class="p-3 rounded-xl bg-surface border border-hairline">
            <div class="text-[11px] font-semibold text-muted uppercase tracking-wider mb-1 flex items-center justify-between">
              <span>{d.copperLabel}</span>
              <span class="text-amber-700 font-bold">Cu</span>
            </div>
            <div id="out-copper" class="text-xl font-mono font-extrabold text-ink">0.0 µg/L</div>
            <div id="out-copper-sub" class="text-[10px] text-muted font-mono mt-0.5">Limit: 1,000 µg/L</div>
          </div>

          <!-- Metric 3: Solution pH -->
          <div class="p-3 rounded-xl bg-surface border border-hairline">
            <div class="text-[11px] font-semibold text-muted uppercase tracking-wider mb-1">
              {d.phLabel}
            </div>
            <div id="out-ph" class="text-xl font-mono font-extrabold text-ink">7.2 pH</div>
            <div id="out-ph-sub" class="text-[10px] text-muted font-mono mt-0.5">Neutral Potable</div>
          </div>

          <!-- Metric 4: Ingestion Hazard Score -->
          <div class="p-3 rounded-xl bg-surface border border-hairline">
            <div class="text-[11px] font-semibold text-muted uppercase tracking-wider mb-1">
              {d.hazardScoreLabel}
            </div>
            <div id="out-hazard" class="text-xl font-mono font-extrabold text-ink">0 / 100</div>
            <div id="out-hazard-sub" class="text-[10px] text-muted font-mono mt-0.5">Low Ingestion Risk</div>
          </div>
        </div>

        <!-- Mechanism & Action Box -->
        <div class="space-y-3 pt-2 border-t border-hairline text-xs">
          <div>
            <div class="font-bold text-ink mb-1 flex items-center gap-1.5">
              <span>🔬</span>
              <span>{d.mechanismLabel}</span>
            </div>
            <p id="out-mechanism" class="text-muted leading-relaxed text-[11px]">
              Loading biophysics mechanism...
            </p>
          </div>
          <div>
            <div class="font-bold text-ink mb-1 flex items-center gap-1.5">
              <span>🛡️</span>
              <span>{d.actionGuidanceLabel}</span>
            </div>
            <p id="out-action" class="text-muted leading-relaxed text-[11px]">
              Loading clearance protocol...
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Comparative Metallurgy Table -->
  <div class="mt-8 pt-8 border-t border-hairline">
    <div class="mb-4">
      <h3 class="text-lg font-bold text-ink">{d.tableTitle}</h3>
      <p class="text-xs text-muted">{d.tableSub}</p>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs border border-hairline rounded-2xl overflow-hidden">
        <thead class="bg-surface-soft border-b border-hairline text-muted uppercase font-bold text-[10px]">
          <tr>
            <th class="p-3">{d.colBoiler}</th>
            <th class="p-3">{d.colCategory}</th>
            <th class="p-3 text-center">{d.colLeadContent}</th>
            <th class="p-3 text-center">{d.colCopperContent}</th>
            <th class="p-3">{d.colVulnerability}</th>
            <th class="p-3 text-center">{d.colPassivation}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline">
          {modelData.boilerMetallurgies.map(b => (
            <tr class="hover:bg-surface-soft/60 transition-colors">
              <td class="p-3 font-semibold text-ink">{b.name}</td>
              <td class="p-3 text-muted">{b.category}</td>
              <td class="p-3 text-center font-mono font-bold text-rose-800">{b.leadContentPercent}%</td>
              <td class="p-3 text-center font-mono text-amber-800">{b.copperContentPercent}%</td>
              <td class="p-3 text-muted">{b.corrosionVulnerability}</td>
              <td class="p-3 text-center font-mono">{b.passivationRateHrs}h</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- 4 Golden Engineering Rules -->
  <div class="mt-8 pt-8 border-t border-hairline">
    <div class="mb-6">
      <h3 class="text-lg font-bold text-ink">{d.rulesTitle}</h3>
      <p class="text-xs text-muted">{d.rulesSub}</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="p-4 rounded-2xl bg-surface-soft border border-hairline">
        <div class="text-xs font-bold text-ink mb-1.5 flex items-center gap-2">
          <span class="w-5 h-5 rounded-full bg-amber-500/20 text-amber-900 flex items-center justify-center text-[10px]">1</span>
          <span>{d.rule1Title}</span>
        </div>
        <p class="text-xs text-muted leading-relaxed">{d.rule1Text}</p>
      </div>

      <div class="p-4 rounded-2xl bg-surface-soft border border-hairline">
        <div class="text-xs font-bold text-ink mb-1.5 flex items-center gap-2">
          <span class="w-5 h-5 rounded-full bg-amber-500/20 text-amber-900 flex items-center justify-center text-[10px]">2</span>
          <span>{d.rule2Title}</span>
        </div>
        <p class="text-xs text-muted leading-relaxed">{d.rule2Text}</p>
      </div>

      <div class="p-4 rounded-2xl bg-surface-soft border border-hairline">
        <div class="text-xs font-bold text-ink mb-1.5 flex items-center gap-2">
          <span class="w-5 h-5 rounded-full bg-amber-500/20 text-amber-900 flex items-center justify-center text-[10px]">3</span>
          <span>{d.rule3Title}</span>
        </div>
        <p class="text-xs text-muted leading-relaxed">{d.rule3Text}</p>
      </div>

      <div class="p-4 rounded-2xl bg-surface-soft border border-hairline">
        <div class="text-xs font-bold text-ink mb-1.5 flex items-center gap-2">
          <span class="w-5 h-5 rounded-full bg-amber-500/20 text-amber-900 flex items-center justify-center text-[10px]">4</span>
          <span>{d.rule4Title}</span>
        </div>
        <p class="text-xs text-muted leading-relaxed">{d.rule4Text}</p>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ modelData, d }}>
  (() => {
    const boilerSelect = document.getElementById('select-boiler');
    const descalerSelect = document.getElementById('select-descaler');
    const hydroSelect = document.getElementById('select-hydro');
    const flushSelect = document.getElementById('select-flush');
    const ageSlider = document.getElementById('slider-age');
    const ageVal = document.getElementById('val-age');

    const outLead = document.getElementById('out-lead');
    const outLeadSub = document.getElementById('out-lead-sub');
    const outCopper = document.getElementById('out-copper');
    const outCopperSub = document.getElementById('out-copper-sub');
    const outPh = document.getElementById('out-ph');
    const outPhSub = document.getElementById('out-ph-sub');
    const outHazard = document.getElementById('out-hazard');
    const outHazardSub = document.getElementById('out-hazard-sub');

    const statusCard = document.getElementById('status-card');
    const statusPill = document.getElementById('status-pill');
    const statusHeadline = document.getElementById('status-headline');
    const statusDesc = document.getElementById('status-desc');
    const outMechanism = document.getElementById('out-mechanism');
    const outAction = document.getElementById('out-action');
    const copyReportBtn = document.getElementById('copy-report-btn');
    const copyBtnText = document.getElementById('copy-btn-text');

    function calculate() {
      if (!boilerSelect || !descalerSelect || !hydroSelect || !flushSelect || !ageSlider) return;

      const boilerId = boilerSelect.value;
      const descalerId = descalerSelect.value;
      const hydroId = hydroSelect.value;
      const flushId = flushSelect.value;
      const ageYears = parseFloat(ageSlider.value);

      if (ageVal) ageVal.textContent = ageYears.toFixed(1) + ' Years';

      const boiler = modelData.boilerMetallurgies.find(b => b.id === boilerId) || modelData.boilerMetallurgies[0];
      const descaler = modelData.descalingRegimes.find(r => r.id === descalerId) || modelData.descalingRegimes[0];
      const hydro = modelData.hydrodynamicScenarios.find(h => h.id === hydroId) || modelData.hydrodynamicScenarios[0];
      const flush = modelData.flushingProtocols.find(f => f.id === flushId) || modelData.flushingProtocols[0];

      // 1. Base Leaching Kinetics
      // Lead leaching depends on % Pb in alloy, acid chelation, temperature, and age factor
      const ageMultiplier = 1 + (ageYears * 0.12);
      const thermalFactor = descaler.solutionTempC > 60 ? (1 + (descaler.solutionTempC - 60) * 0.05) : 1.0;
      const acidFactor = descaler.chelationEfficiencyMultiplier;
      const hydroShearFactor = hydro.interfacialShearVelocityMs > 1.0 ? 1.3 : 1.0;

      // Base un-flushed lead spike (µg/L)
      let rawLeadUgL = (boiler.leadContentPercent * 280.0) * acidFactor * thermalFactor * ageMultiplier * hydroShearFactor;

      // Baseline potable water or 316L stainless has virtually zero lead
      if (descalerId === 'baseline-sca-potable-water') {
        if (hydroId === 'stagnant-overnight-dwell') {
          // Stagnant overnight water accumulates dissolved lead from brass (BfR study finding)
          rawLeadUgL = boiler.leadContentPercent * 18.0 * ageMultiplier;
        } else {
          rawLeadUgL = boiler.leadContentPercent * 1.8;
        }
      }
      if (boilerId === 'marine-grade-316l-stainless') {
        rawLeadUgL = 0.2;
      }

      // Apply flush clearance
      const effectiveLeadUgL = Math.max(0.1, rawLeadUgL * (1 - (flush.leadClearancePercent / 100.0)));

      // 2. Copper Leaching Kinetics (µg/L)
      let rawCopperUgL = (boiler.copperContentPercent * 45.0) * acidFactor * thermalFactor * ageMultiplier * 0.5;
      if (descalerId === 'baseline-sca-potable-water') {
        rawCopperUgL = boiler.copperContentPercent * 3.5;
      }
      if (boilerId === 'marine-grade-316l-stainless') {
        rawCopperUgL = 5.0;
      }
      const effectiveCopperUgL = Math.max(1.0, rawCopperUgL * (1 - (flush.leadClearancePercent / 100.0)));

      // 3. Solution pH calculation
      let residualPh = descaler.phValue;
      if (flush.flushVolumeLiters >= 4.5 || flushId === 'bicarbonate-neutralization-flush') {
        residualPh = 7.1;
      } else if (flush.flushVolumeLiters >= 1.5) {
        residualPh = Math.min(6.5, descaler.phValue + 2.8);
      } else if (flush.flushVolumeLiters === 0) {
        residualPh = descaler.phValue;
      }

      // 4. Ingestion Hazard Score (0 to 100)
      // Benchmarks: WHO Lead = 10 µg/L; Copper Limit = 1,000 µg/L; pH threshold = < 5.0
      let hazardScore = 0;
      if (effectiveLeadUgL > 10.0) {
        hazardScore += Math.min(60, Math.round((effectiveLeadUgL / 10.0) * 8));
      } else {
        hazardScore += Math.round((effectiveLeadUgL / 10.0) * 10);
      }
      if (effectiveCopperUgL > 1000.0) {
        hazardScore += Math.min(30, Math.round((effectiveCopperUgL / 1000.0) * 15));
      }
      if (residualPh < 4.0) {
        hazardScore += 20;
      }
      hazardScore = Math.min(100, Math.max(1, hazardScore));

      // Update UI Metrics
      if (outLead) outLead.textContent = effectiveLeadUgL.toFixed(1) + ' µg/L';
      if (outLeadSub) {
        const leadRatio = (effectiveLeadUgL / 10.0).toFixed(1);
        outLeadSub.textContent = effectiveLeadUgL > 10.0 ? `⚠️ ${leadRatio}x WHO Limit (10 µg/L)` : '✅ Below WHO Guideline';
      }

      if (outCopper) outCopper.textContent = Math.round(effectiveCopperUgL) + ' µg/L';
      if (outCopperSub) {
        outCopperSub.textContent = effectiveCopperUgL > 1000.0 ? '🚨 Exceeds 1,000 µg/L Limit' : 'Complies with EPA/WHO';
      }

      if (outPh) outPh.textContent = residualPh.toFixed(1) + ' pH';
      if (outPhSub) {
        outPhSub.textContent = residualPh < 4.5 ? 'Corrosive Acid Carryover' : 'Neutral Drinkable Range';
      }

      if (outHazard) outHazard.textContent = hazardScore + ' / 100';
      if (outHazardSub) {
        outHazardSub.textContent = hazardScore >= 70 ? 'Extreme Ingestion Risk' : (hazardScore >= 35 ? 'Moderate Metal Burden' : 'Minimal Ingestion Risk');
      }

      // 5. Safety Classification & Status
      let statusKey = 'SAFE_POTABLE';
      let pillBg = 'bg-emerald-500/10 text-emerald-800 border-emerald-500/20';
      let cardBorder = 'bg-emerald-500/5 border-emerald-200';
      let headline = 'Safe Potable Extraction — Metal Migration Well Within Standards';
      let desc = 'Lead and copper effluent concentrations strictly meet WHO, EU 2020/2184, and NSF/ANSI 372 potable thresholds.';
      let mechanism = `Passive oxide passivation layer intact. Effluent lead (${effectiveLeadUgL.toFixed(1)} µg/L) and copper (${Math.round(effectiveCopperUgL)} µg/L) remain safely below regulatory action thresholds.`;
      let action = 'Maintain regular preventive maintenance with SCA-balanced water. If descaling is required, use manufacturer-approved descalers at room temperature followed by a 3-tank purge.';

      if (hazardScore >= 70 || effectiveLeadUgL > 100.0) {
        statusKey = 'CRITICAL_TOXIC_SPIKE';
        pillBg = 'bg-rose-500/10 text-rose-800 border-rose-500/20';
        cardBorder = 'bg-rose-500/5 border-rose-300';
        headline = '🚨 DANGER: Severe Heavy Metal & Lead Contamination Spike';
        desc = 'Effluent contains dangerous concentrations of bioavailable lead and acidic descaling residues capable of causing acute gastrointestinal and neurological toxicity.';
        mechanism = `Acidic chelation (pH ${residualPh.toFixed(1)}) and high thermal kinetics stripped the protective cuprous oxide patina, selectively leaching grain-boundary lead from the ${boiler.name}. Unflushed dead legs discharge ${effectiveLeadUgL.toFixed(1)} µg/L Pb into the cup.`;
        action = 'MANDATORY ABORT: Do NOT drink this shot! Immediately dump this extraction. Execute a minimum 3-tank (4.5L) clean water purge through the grouphead, steam wand, and hot water spout, and discard 3 test shots.';
      } else if (hazardScore >= 35 || effectiveLeadUgL > 10.0 || residualPh < 5.0) {
        statusKey = 'ELEVATED_HEAVY_METALS';
        pillBg = 'bg-amber-500/10 text-amber-800 border-amber-500/20';
        cardBorder = 'bg-amber-500/5 border-amber-300';
        headline = '⚠️ WARNING: Elevated Lead or Acid Carryover Detected';
        desc = 'Lead levels exceed the WHO 10 µg/L benchmark or residual acid creates an unpalatable and mildly corrosive extraction.';
        mechanism = `Insufficient flushing or overnight stagnant diffusion elevated dissolved metal ions (${effectiveLeadUgL.toFixed(1)} µg/L Pb). Partial dezincification of brass surfaces observed.`;
        action = 'Run an additional 1.5L reservoir flush through all fluid ports. If drawing first-morning espresso from a brass machine, flush 100 mL of water before brewing.';
      }

      if (statusPill) {
        statusPill.className = `text-xs font-extrabold uppercase px-3 py-1 rounded-full tracking-wider border ${pillBg}`;
        statusPill.textContent = statusKey.replace(/_/g, ' ');
      }
      if (statusCard) statusCard.className = `p-6 rounded-2xl border transition-all duration-300 ${cardBorder} space-y-6`;
      if (statusHeadline) statusHeadline.textContent = headline;
      if (statusDesc) statusDesc.textContent = desc;
      if (outMechanism) outMechanism.textContent = mechanism;
      if (outAction) outAction.textContent = action;
    }

    // Preset click handlers
    const presetButtons = document.querySelectorAll('.preset-btn');
    presetButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        if (boilerSelect) boilerSelect.value = btn.getAttribute('data-boiler');
        if (descalerSelect) descalerSelect.value = btn.getAttribute('data-descaler');
        if (hydroSelect) hydroSelect.value = btn.getAttribute('data-hydro');
        if (flushSelect) flushSelect.value = btn.getAttribute('data-flush');
        if (ageSlider) ageSlider.value = btn.getAttribute('data-age');
        calculate();
      });
    });

    [boilerSelect, descalerSelect, hydroSelect, flushSelect, ageSlider].forEach(el => {
      if (el) el.addEventListener('input', calculate);
    });

    // Copy audit report
    if (copyReportBtn) {
      copyReportBtn.addEventListener('click', () => {
        const report = [
          `======================================================================`,
          `ISITKITCHENSAFE ESPRESSO MACHINE HEAVY METAL & DESCALING AUDIT`,
          `======================================================================`,
          `Boiler Metallurgy : ${boilerSelect.options[boilerSelect.selectedIndex].text}`,
          `Descaling Regime  : ${descalerSelect.options[descalerSelect.selectedIndex].text}`,
          `Hydrodynamic Flow : ${hydroSelect.options[hydroSelect.selectedIndex].text}`,
          `Flush Protocol    : ${flushSelect.options[flushSelect.selectedIndex].text}`,
          `Equipment Age     : ${ageSlider.value} Years`,
          `----------------------------------------------------------------------`,
          `Effluent Lead (Pb): ${outLead ? outLead.textContent : 'N/A'}`,
          `Effluent Copper   : ${outCopper ? outCopper.textContent : 'N/A'}`,
          `Effluent pH       : ${outPh ? outPh.textContent : 'N/A'}`,
          `Hazard Score      : ${outHazard ? outHazard.textContent : 'N/A'}`,
          `Potable Status    : ${statusPill ? statusPill.textContent : 'N/A'}`,
          `----------------------------------------------------------------------`,
          `Biophysics Mechanism: ${outMechanism ? outMechanism.textContent : ''}`,
          `Mandatory Protocol  : ${outAction ? outAction.textContent : ''}`,
          `======================================================================`,
          `Audited via IsItKitchenSafe Autonomous Growth & Ops Engine v2.0`
        ].join('\n');

        navigator.clipboard.writeText(report).then(() => {
          if (copyBtnText) copyBtnText.textContent = d.copiedFeedback;
          setTimeout(() => {
            if (copyBtnText) copyBtnText.textContent = d.copyReportBtn;
          }, 3000);
        }).catch(err => {
          console.error('Clipboard copy failed:', err);
        });
      });
    }

    // Initial calculation
    calculate();
  })();
</script>
