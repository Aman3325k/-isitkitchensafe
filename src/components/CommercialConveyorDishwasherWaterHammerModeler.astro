const d = DICTIONARY[lang] || DICTIONARY.en;
---

<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 sm:p-8 shadow-xl">
  <!-- Header Badge & Intro -->
  <div class="mb-8">
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-semibold bg-blue-100 text-blue-800 dark:bg-blue-950/70 dark:text-blue-300 border border-blue-200 dark:border-blue-800/80 mb-3">
      <svg class="w-4 h-4 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
      </svg>
      <span>{d.badge}</span>
    </div>
    <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">{d.title}</h2>
    <p class="mt-2 text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed">{d.subtitle}</p>
  </div>

  <!-- Presets Bar -->
  <div class="mb-8 p-4 bg-slate-50 dark:bg-slate-800/60 rounded-xl border border-slate-200 dark:border-slate-700/70">
    <div class="flex items-center gap-2 mb-3">
      <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">⚡ {d.presetsTitle}</span>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2">
      <button type="button" data-preset="compliant" class="preset-btn px-3 py-2 text-xs font-semibold rounded-lg bg-white dark:bg-slate-700 text-slate-700 dark:text-slate-200 border border-slate-300 dark:border-slate-600 hover:bg-blue-50 dark:hover:bg-blue-900/30 hover:border-blue-400 transition text-left">
        🛡️ {d.presetCompliant}
      </button>
      <button type="button" data-preset="severe_hammer" class="preset-btn px-3 py-2 text-xs font-semibold rounded-lg bg-white dark:bg-slate-700 text-slate-700 dark:text-slate-200 border border-slate-300 dark:border-slate-600 hover:bg-red-50 dark:hover:bg-red-900/30 hover:border-red-400 transition text-left">
        💥 {d.presetSevereHammer}
      </button>
      <button type="button" data-preset="cavitation" class="preset-btn px-3 py-2 text-xs font-semibold rounded-lg bg-white dark:bg-slate-700 text-slate-700 dark:text-slate-200 border border-slate-300 dark:border-slate-600 hover:bg-amber-50 dark:hover:bg-amber-900/30 hover:border-amber-400 transition text-left">
        🫧 {d.presetCavitation}
      </button>
      <button type="button" data-preset="fatigue_failure" class="preset-btn px-3 py-2 text-xs font-semibold rounded-lg bg-white dark:bg-slate-700 text-slate-700 dark:text-slate-200 border border-slate-300 dark:border-slate-600 hover:bg-purple-50 dark:hover:bg-purple-900/30 hover:border-purple-400 transition text-left">
        🔩 {d.presetFatigueFailure}
      </button>
    </div>
  </div>

  <!-- Interactive Controls Section -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-8">
    <div class="lg:col-span-6 space-y-5">
      <div class="border-b border-slate-200 dark:border-slate-800 pb-2">
        <h3 class="text-base font-bold text-slate-900 dark:text-white">{d.controlsTitle}</h3>
        <p class="text-xs text-slate-500 dark:text-slate-400">{d.controlsSub}</p>
      </div>

      <!-- Equipment Select -->
      <div>
        <label for="cwhm-dishwasher" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1">
          {d.dishwasherLabel}
        </label>
        <select id="cwhm-dishwasher" class="w-full text-xs sm:text-sm rounded-lg border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 shadow-sm focus:border-blue-500 focus:ring-blue-500">
          {dishwasherData.dishwasherBoosterConfigs.map((cfg) => (
            <option value={cfg.id}>{cfg.name}</option>
          ))}
        </select>
        <p class="mt-1 text-[11px] text-slate-500 dark:text-slate-400">{d.dishwasherHelp}</p>
      </div>

      <!-- Solenoid Valve Select -->
      <div>
        <label for="cwhm-solenoid" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1">
          {d.solenoidLabel}
        </label>
        <select id="cwhm-solenoid" class="w-full text-xs sm:text-sm rounded-lg border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 shadow-sm focus:border-blue-500 focus:ring-blue-500">
          {dishwasherData.solenoidValveClasses.map((sol) => (
            <option value={sol.id}>{sol.name}</option>
          ))}
        </select>
        <p class="mt-1 text-[11px] text-slate-500 dark:text-slate-400">{d.solenoidHelp}</p>
      </div>

      <!-- Arrester Option Select -->
      <div>
        <label for="cwhm-arrester" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1">
          {d.arresterLabel}
        </label>
        <select id="cwhm-arrester" class="w-full text-xs sm:text-sm rounded-lg border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 shadow-sm focus:border-blue-500 focus:ring-blue-500">
          {dishwasherData.waterHammerArresterOptions.map((arr) => (
            <option value={arr.id} selected={arr.id === 'pdi_size_b'}>{arr.name}</option>
          ))}
        </select>
        <p class="mt-1 text-[11px] text-slate-500 dark:text-slate-400">{d.arresterHelp}</p>
      </div>

      <!-- Plumbing Geometry Select -->
      <div>
        <label for="cwhm-geometry" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1">
          {d.geometryLabel}
        </label>
        <select id="cwhm-geometry" class="w-full text-xs sm:text-sm rounded-lg border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 shadow-sm focus:border-blue-500 focus:ring-blue-500">
          {dishwasherData.plumbingGeometryProfiles.map((geo) => (
            <option value={geo.id}>{geo.name}</option>
          ))}
        </select>
        <p class="mt-1 text-[11px] text-slate-500 dark:text-slate-400">{d.geometryHelp}</p>
      </div>
    </div>

    <!-- Sliders Column -->
    <div class="lg:col-span-6 space-y-5">
      <div class="border-b border-slate-200 dark:border-slate-800 pb-2">
        <h3 class="text-base font-bold text-slate-900 dark:text-white">Dynamic Hydraulic Operating Parameters</h3>
        <p class="text-xs text-slate-500 dark:text-slate-400">Live calibration of flow rate, physical run distance, supply pressure & booster temperature.</p>
      </div>

      <!-- Flow Rate Slider -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <label for="cwhm-flow" class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">{d.flowSliderLabel}</label>
          <span id="cwhm-flow-val" class="text-xs font-extrabold text-blue-600 dark:text-blue-400 font-mono">3.8 GPM</span>
        </div>
        <input id="cwhm-flow" type="range" min="1.5" max="10.0" step="0.1" value="3.8" class="w-full accent-blue-600 dark:accent-blue-400 cursor-pointer" />
        <p class="mt-1 text-[11px] text-slate-500 dark:text-slate-400">{d.flowSliderHelp}</p>
      </div>

      <!-- Pipe Length Slider -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <label for="cwhm-length" class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">{d.lengthSliderLabel}</label>
          <span id="cwhm-length-val" class="text-xs font-extrabold text-blue-600 dark:text-blue-400 font-mono">28 ft</span>
        </div>
        <input id="cwhm-length" type="range" min="5" max="60" step="1" value="28" class="w-full accent-blue-600 dark:accent-blue-400 cursor-pointer" />
        <p class="mt-1 text-[11px] text-slate-500 dark:text-slate-400">{d.lengthSliderHelp}</p>
      </div>

      <!-- Static Supply Pressure Slider -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <label for="cwhm-pressure" class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">{d.pressureSliderLabel}</label>
          <span id="cwhm-pressure-val" class="text-xs font-extrabold text-blue-600 dark:text-blue-400 font-mono">22 PSI</span>
        </div>
        <input id="cwhm-pressure" type="range" min="15" max="80" step="1" value="22" class="w-full accent-blue-600 dark:accent-blue-400 cursor-pointer" />
        <p class="mt-1 text-[11px] text-slate-500 dark:text-slate-400">{d.pressureSliderHelp}</p>
      </div>

      <!-- Booster Temperature Slider -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <label for="cwhm-temp" class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">{d.tempSliderLabel}</label>
          <span id="cwhm-temp-val" class="text-xs font-extrabold text-blue-600 dark:text-blue-400 font-mono">182 °F</span>
        </div>
        <input id="cwhm-temp" type="range" min="160" max="195" step="1" value="182" class="w-full accent-blue-600 dark:accent-blue-400 cursor-pointer" />
        <p class="mt-1 text-[11px] text-slate-500 dark:text-slate-400">{d.tempSliderHelp}</p>
      </div>
    </div>
  </div>

  <!-- Dynamic SVG Schematic Visualizer -->
  <div class="mb-8 p-5 bg-slate-900 rounded-xl border border-slate-800 text-white shadow-inner">
    <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-blue-500 animate-pulse"></span>
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-300">Sanitary Booster & Shock Wave Propagation Visualizer</h4>
      </div>
      <div class="text-[11px] font-mono text-slate-400">
        Acoustic Travel Time 2L/c: <span id="cwhm-crit-time" class="text-blue-400 font-bold">14.0 ms</span>
      </div>
    </div>

    <!-- SVG Graphic Canvas -->
    <div class="relative w-full h-48 bg-slate-950 rounded-lg overflow-hidden border border-slate-800/80 flex items-center justify-center">
      <svg class="w-full h-full" viewBox="0 0 800 200" preserveAspectRatio="xMidYMid meet">
        <defs>
          <linearGradient id="boosterGradient" x1="0%" y1="0%" x2="100%" y2="100%">
