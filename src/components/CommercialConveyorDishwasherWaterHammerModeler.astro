<!-- Reactive Client-Side Hydraulic Simulation Engine -->
<script is:inline define:vars={{ dishwasherData }}>
  (function initCommercialWaterHammerEngine() {
    const dishSel = document.getElementById('cwhm-dishwasher');
    const solSel = document.getElementById('cwhm-solenoid');
    const arrSel = document.getElementById('cwhm-arrester');
    const geoSel = document.getElementById('cwhm-geometry');

    const flowSlider = document.getElementById('cwhm-flow');
    const lengthSlider = document.getElementById('cwhm-length');
    const pressureSlider = document.getElementById('cwhm-pressure');
    const tempSlider = document.getElementById('cwhm-temp');

    const flowVal = document.getElementById('cwhm-flow-val');
    const lengthVal = document.getElementById('cwhm-length-val');
    const pressureVal = document.getElementById('cwhm-pressure-val');
    const tempVal = document.getElementById('cwhm-temp-val');

    // Display elements
    const resPeakPsi = document.getElementById('cwhm-res-peak-psi');
    const resPeakBadge = document.getElementById('cwhm-res-peak-badge');
    const resStaticPsi = document.getElementById('cwhm-res-static-psi');
    const resSurgePsi = document.getElementById('cwhm-res-surge-psi');
    const resWaveSpeed = document.getElementById('cwhm-res-wave-speed');
    const resDensity = document.getElementById('cwhm-res-density');
    const resVelocity = document.getElementById('cwhm-res-velocity');
    const resHoopStress = document.getElementById('cwhm-res-hoop-stress');
    const resHoopBadge = document.getElementById('cwhm-res-hoop-badge');
    const resCavitation = document.getElementById('cwhm-res-cavitation');
    const resCavBadge = document.getElementById('cwhm-res-cav-badge');
    const resFatigueCycles = document.getElementById('cwhm-res-fatigue-cycles');
    const resFatigueYears = document.getElementById('cwhm-res-fatigue-years');
    const resNoiseDb = document.getElementById('cwhm-res-noise-db');
    const resNoiseBadge = document.getElementById('cwhm-res-noise-badge');
    const resNoiseDesc = document.getElementById('cwhm-res-noise-desc');

    const critTimeVal = document.getElementById('cwhm-crit-time');
    const diagCompliance = document.getElementById('cwhm-diag-compliance');
    const diagRisk = document.getElementById('cwhm-diag-risk');
    const diagMechanisms = document.getElementById('cwhm-diag-mechanisms');
    const diagMitigation = document.getElementById('cwhm-diag-mitigation');

    // SVG elements
    const svgBoosterTemp = document.getElementById('svg-booster-temp');
    const svgShockWave = document.getElementById('svg-shock-wave');
    const svgArresterGroup = document.getElementById('svg-arrester-group');
    const svgArresterPiston = document.getElementById('svg-arrester-piston');
    const svgValveClosure = document.getElementById('svg-valve-closure');
    const svgSolenoidLed = document.getElementById('svg-solenoid-led');

    function calculateHydraulics() {
      if (!dishSel || !solSel || !arrSel || !geoSel) return;

      const dish = dishwasherData.dishwasherBoosterConfigs.find(c => c.id === dishSel.value) || dishwasherData.dishwasherBoosterConfigs[0];
      const sol = dishwasherData.solenoidValveClasses.find(s => s.id === solSel.value) || dishwasherData.solenoidValveClasses[0];
      const arr = dishwasherData.waterHammerArresterOptions.find(a => a.id === arrSel.value) || dishwasherData.waterHammerArresterOptions[0];
      const geo = dishwasherData.plumbingGeometryProfiles.find(g => g.id === geoSel.value) || dishwasherData.plumbingGeometryProfiles[0];

      const flowGpm = parseFloat(flowSlider.value);
      const pipeLengthFt = parseFloat(lengthSlider.value);
      const supplyPressurePsi = parseFloat(pressureSlider.value);
      const boosterTempF = parseFloat(tempSlider.value);

      flowVal.textContent = flowGpm.toFixed(1) + ' GPM';
      lengthVal.textContent = pipeLengthFt.toFixed(0) + ' ft';
      pressureVal.textContent = supplyPressurePsi.toFixed(0) + ' PSI';
      tempVal.textContent = boosterTempF.toFixed(0) + ' °F';

      if (svgBoosterTemp) svgBoosterTemp.textContent = boosterTempF.toFixed(0) + '°F';
      if (svgValveClosure) svgValveClosure.textContent = sol.closureTimeMs + ' ms';

      // 1. Fluid density as function of temperature (160°F - 195°F)
      // At 60°F = 62.4 lb/ft³ (1000 kg/m³), at 180°F = 60.6 lb/ft³ (970.5 kg/m³)
      const tempC = (boosterTempF - 32) * (5 / 9);
      const densityKgM3 = 1000 * (1 - ((tempC + 288.9414) / (508929.2 * (tempC + 68.12963))) * Math.pow(tempC - 3.9863, 2));
      const densityLbFt3 = densityKgM3 * 0.062428;

      // 2. Pipe internal diameter (Type L 3/4" = 0.785", 1/2" = 0.545", 1" = 1.025")
      let internalDiameterIn = dish.pipeDiameterIn;
      if (internalDiameterIn === 0.75) internalDiameterIn = 0.785;
      else if (internalDiameterIn === 0.5) internalDiameterIn = 0.545;
      else if (internalDiameterIn === 1.0) internalDiameterIn = 1.025;

      const internalDiameterFt = internalDiameterIn / 12;
      const pipeAreaSqFt = (Math.PI / 4) * Math.pow(internalDiameterFt, 2);

      // Flow velocity: Q (ft³/s) / Area (ft²)
      const flowCuFtSec = (flowGpm / 7.48052) / 60;
      const velocityFtSec = flowCuFtSec / pipeAreaSqFt;
      const velocityMSec = velocityFtSec * 0.3048;

      // 3. Acoustic wave speed in elastic pipe: c (approx 4,000 ft/s in copper)
      // c = sqrt((K/rho) / (1 + (K/E)*(D/e)))
      const waveSpeedFtSec = 4050 - (boosterTempF - 160) * 2.2;
      const waveSpeedMSec = waveSpeedFtSec * 0.3048;

      // 4. Critical valve closure time tcrit = 2L / c
      const critTimeSec = (2 * pipeLengthFt) / waveSpeedFtSec;
      const critTimeMs = critTimeSec * 1000;
      if (critTimeVal) critTimeVal.textContent = critTimeMs.toFixed(1) + ' ms';

      // 5. Unattenuated Joukowsky Pressure Spike: Delta P = rho * c * Delta v
      // Delta P (Pa) = densityKgM3 * waveSpeedMSec * velocityMSec
      const deltaP_Pa = densityKgM3 * waveSpeedMSec * velocityMSec;
      const deltaP_Psi = deltaP_Pa * 0.000145038;

      // Valve closure attenuation:
      const valveClosureSec = sol.closureTimeMs / 1000;
      let attenuationFactor = 1.0;
      if (valveClosureSec > critTimeSec) {
        attenuationFactor = critTimeSec / valveClosureSec;
      }
      attenuationFactor = Math.min(1.0, Math.max(0.08, attenuationFactor));

      // Effective surge before arrester damping:
      let rawSurgePsi = deltaP_Psi * attenuationFactor * (1 - sol.snubbingFactor);

      // 6. Arrester absorption damping
      const arresterDamping = arr.cushionDamping;
      const netSurgePsi = rawSurgePsi * (1 - arresterDamping);
      const peakPressurePsi = supplyPressurePsi + netSurgePsi;

      // 7. Pipe Hoop Stress: sigma = (P * D) / (2 * wall_thickness)
      // Wall thickness: Type L 3/4" = 0.045", 1/2" = 0.040", 1" = 0.050"
      let wallThicknessIn = 0.045;
      if (dish.pipeDiameterIn === 0.5) wallThicknessIn = 0.040;
      else if (dish.pipeDiameterIn === 1.0) wallThicknessIn = 0.050;

      const hoopStressPsi = (peakPressurePsi * internalDiameterIn) / (2 * wallThicknessIn);

      // 8. Cavitation Index (Negative Reflected Wave vs Water Vapor Pressure at Temp)
      // Water vapor pressure: Antoine equation for water at 160°F - 195°F
      // Pv approx 7.37 psia at 182°F (15 in. Hg vacuum)
      const vaporPressurePsia = Math.exp(16.5362 - 3985.44 / (tempC + 234.0)) * 0.145038;
      const minReflectedPressurePsia = (supplyPressurePsi + 14.696) - (netSurgePsi * 0.85);

      let cavitationIndex = 0.0;
      if (minReflectedPressurePsia <= vaporPressurePsia) {
        cavitationIndex = Math.min(1.0, ((vaporPressurePsia - minReflectedPressurePsia) / vaporPressurePsia) + 0.35);
      } else {
        cavitationIndex = Math.max(0.05, 1.0 - (minReflectedPressurePsia / 35.0));
      }

      // 9. Solder Joint Fatigue Cycles
      // Empirical Basquin-Manson-Coffin fatigue relation for Sn-Sb 95/5 solder
      let fatigueCycles = 0;
      if (hoopStressPsi <= 2500) {
        fatigueCycles = 750000;
      } else if (hoopStressPsi <= 4500) {
        fatigueCycles = 250000;
      } else if (hoopStressPsi <= 6000) {
        fatigueCycles = 85000;
      } else if (hoopStressPsi <= 8500) {
        fatigueCycles = 22000;
      } else {
        fatigueCycles = 3500;
      }

      const cyclesPerDay = dish.operatingCyclesPerHour * 8;
      const fatigueYears = (fatigueCycles / (cyclesPerDay * 300)).toFixed(1);

      // 10. Acoustic Decibel Generation
      let noiseDb = geo.acousticResonanceDb + (netSurgePsi > 120 ? (netSurgePsi - 120) * 0.22 : 0) - (arr.cushionDamping * 24);
      noiseDb = Math.max(40, Math.min(105, Math.round(noiseDb)));

      // Update UI Metrics
      resPeakPsi.textContent = Math.round(peakPressurePsi) + ' PSI';
      resStaticPsi.textContent = Math.round(supplyPressurePsi) + ' PSI';
      resSurgePsi.textContent = Math.round(netSurgePsi) + ' PSI';
      resWaveSpeed.textContent = Math.round(waveSpeedFtSec).toLocaleString() + ' ft/s';
      resDensity.textContent = densityLbFt3.toFixed(1) + ' lb/ft³';
      resVelocity.textContent = velocityFtSec.toFixed(1) + ' ft/s';
      resHoopStress.textContent = Math.round(hoopStressPsi).toLocaleString() + ' PSI';
      resCavitation.textContent = cavitationIndex.toFixed(2);
      resFatigueCycles.textContent = fatigueCycles > 500000 ? '> 500,000' : fatigueCycles.toLocaleString();
      resFatigueYears.textContent = fatigueYears > 12 ? '> 12 Years' : `${fatigueYears} Years`;
      resNoiseDb.textContent = noiseDb + ' dB';

      // Badges & Status Coloring
      if (peakPressurePsi < 125) {
        resPeakBadge.className = 'px-2 py-0.5 text-[10px] font-bold rounded-full bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300';
        resPeakBadge.textContent = 'SAFE';
        if (svgShockWave) svgShockWave.style.opacity = '0.2';
      } else if (peakPressurePsi < 200) {
        resPeakBadge.className = 'px-2 py-0.5 text-[10px] font-bold rounded-full bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300';
        resPeakBadge.textContent = 'ELEVATED SURGE';
        if (svgShockWave) svgShockWave.style.opacity = '0.6';
      } else {
        resPeakBadge.className = 'px-2 py-0.5 text-[10px] font-bold rounded-full bg-red-100 text-red-800 dark:bg-red-950 dark:text-red-300';
        resPeakBadge.textContent = 'CRITICAL WATER HAMMER';
        if (svgShockWave) svgShockWave.style.opacity = '1.0';
      }

      if (hoopStressPsi < 3500) {
        resHoopBadge.className = 'px-2 py-0.5 text-[10px] font-bold rounded-full bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300';
        resHoopBadge.textContent = 'LOW STRESS';
      } else if (hoopStressPsi < 6000) {
        resHoopBadge.className = 'px-2 py-0.5 text-[10px] font-bold rounded-full bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300';
        resHoopBadge.textContent = 'FATIGUE REGION';
      } else {
        resHoopBadge.className = 'px-2 py-0.5 text-[10px] font-bold rounded-full bg-red-100 text-red-800 dark:bg-red-950 dark:text-red-300';
        resHoopBadge.textContent = 'YIELD DANGER';
      }

      if (cavitationIndex < 0.25) {
        resCavBadge.className = 'px-2 py-0.5 text-[10px] font-bold rounded-full bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300';
        resCavBadge.textContent = 'MINIMAL';
      } else if (cavitationIndex < 0.55) {
        resCavBadge.className = 'px-2 py-0.5 text-[10px] font-bold rounded-full bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300';
        resCavBadge.textContent = 'MICRO-BUBBLE';
      } else {
        resCavBadge.className = 'px-2 py-0.5 text-[10px] font-bold rounded-full bg-red-100 text-red-800 dark:bg-red-950 dark:text-red-300';
        resCavBadge.textContent = 'SEVERE CAVITATION';
      }

      if (noiseDb < 60) {
        resNoiseBadge.className = 'px-2 py-0.5 text-[10px] font-bold rounded-full bg-blue-100 text-blue-800 dark:bg-blue-950 dark:text-blue-300';
        resNoiseBadge.textContent = 'DAMPENED';
        resNoiseDesc.textContent = 'Muffled click (unobtrusive)';
      } else if (noiseDb < 78) {
        resNoiseBadge.className = 'px-2 py-0.5 text-[10px] font-bold rounded-full bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300';
        resNoiseBadge.textContent = 'AUDIBLE CLATTER';
        resNoiseDesc.textContent = 'Noticeable metallic thumping';
      } else {
        resNoiseBadge.className = 'px-2 py-0.5 text-[10px] font-bold rounded-full bg-red-100 text-red-800 dark:bg-red-950 dark:text-red-300';
        resNoiseBadge.textContent = 'VIOLENT SLAM';
        resNoiseDesc.textContent = 'Severe pipe concussion / rattle';
      }

      // Visual SVG Arrester Piston state
      if (svgArresterPiston) {
        if (arr.id === 'none_bare_pipe' || arr.id === 'waterlogged_air_chamber') {
          svgArresterPiston.style.display = 'none';
          if (svgArresterGroup) svgArresterGroup.style.opacity = '0.3';
        } else {
          svgArresterPiston.style.display = 'block';
          if (svgArresterGroup) svgArresterGroup.style.opacity = '1.0';
          // Move piston slightly on high pressure
          const pistonY = 25 - Math.min(15, (netSurgePsi / 200) * 15);
          svgArresterPiston.setAttribute('y', pistonY.toString());
        }
      }

      // Compliance Narrative
      const isSanitizing = boosterTempF >= 180.0;
      const isDynamicPressureCompliant = supplyPressurePsi >= 15.0 && supplyPressurePsi <= 25.0;
      const hasArrester = arr.id !== 'none_bare_pipe' && arr.id !== 'waterlogged_air_chamber';

      if (isSanitizing && hasArrester && peakPressurePsi < 150) {
        diagCompliance.className = 'text-sm font-semibold text-emerald-400 flex items-center gap-2';
        diagCompliance.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg><span>FULL COMPLIANCE: ASME A112.26.1 / PDI-WH 201 Arrester Active | NSF/ANSI 3 (180°F+ Thermal Sanitization).</span>';
      } else if (!isSanitizing) {
        diagCompliance.className = 'text-sm font-semibold text-red-400 flex items-center gap-2';
        diagCompliance.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg><span>NSF SANITATION BREACH: Booster temp (' + boosterTempF + '°F) falls below 180°F minimum pathogen lethality threshold.</span>';
      } else if (!hasArrester) {
        diagCompliance.className = 'text-sm font-semibold text-red-400 flex items-center gap-2';
        diagCompliance.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg><span>PLUMBING CODE VIOLATION: IPC Section 604.9 requires water hammer arresters on quick-closing solenoid valves.</span>';
      } else {
        diagCompliance.className = 'text-sm font-semibold text-amber-400 flex items-center gap-2';
        diagCompliance.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg><span>ELEVATED STRESS: Pressure surges (' + Math.round(peakPressurePsi) + ' PSI) exceed optimal commercial operating window.</span>';
      }

      // Detailed Risk Breakdown
      if (peakPressurePsi > 220) {
        diagRisk.textContent = 'HIGH-RISK HYDRAULIC HAMMER: Uncushioned pressure wave peak of ' + Math.round(peakPressurePsi) + ' PSI places extreme cyclical hoop stress (' + Math.round(hoopStressPsi) + ' PSI) on solder joints, risking sudden fracture and scullery flooding.';
      } else if (cavitationIndex > 0.5) {
        diagRisk.textContent = 'VAPOR CAVITATION HAZARD: Low supply pressure combined with 180°F+ hot water causes localized flash vapor pocket formation. Microjet implosions accelerate valve seat erosion and booster weld pitting.';
      } else {
        diagRisk.textContent = 'NOMINAL SYSTEM DYNAMICS: Arrester absorbs ' + Math.round(arr.surgeAbsorptionPercent) + '% of kinetic momentum. Pipe hoop stress remains well below the 6,000 PSI fatigue threshold.';
      }

      // Physics Equation Breakdown
      diagMechanisms.textContent = 'ΔP = ρ·c·Δv = (' + densityKgM3.toFixed(0) + ' kg/m³)·(' + Math.round(waveSpeedMSec) + ' m/s)·(' + velocityMSec.toFixed(2) + ' m/s) = ' + (deltaP_Pa / 1e6).toFixed(2) + ' MPa (' + Math.round(deltaP_Psi) + ' PSI). Valve closure tc=' + sol.closureTimeMs + 'ms vs critical tcrit=' + critTimeMs.toFixed(1) + 'ms.';

      // Mitigation Action
      if (!hasArrester) {
        diagMitigation.textContent = 'URGENT: Install an ASME A112.26.1 / PDI Size B stainless steel bellows arrester within 6 pipe-diameters upstream of solenoid valve to suppress shock wave.';
      } else if (pipeLengthFt > 35 && geo.id === 'unsupported_span_flopping') {
        diagMitigation.textContent = 'Install engineered clevis hangers with neoprene vibration isolators every 5 feet to eliminate acoustic pipe whipping and prevent mechanical joint fatigue.';
      } else {
        diagMitigation.textContent = 'Perform semi-annual nitrogen pre-charge check on water hammer arrester; replace pilot solenoid diaphragm annually to prevent calcification chattering.';
      }
    }

    // Attach listeners
    [dishSel, solSel, arrSel, geoSel, flowSlider, lengthSlider, pressureSlider, tempSlider].forEach(el => {
      if (el) el.addEventListener('input', calculateHydraulics);
    });

    // Preset Buttons
    const presetBtns = document.querySelectorAll('.preset-btn');
    presetBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const p = btn.getAttribute('data-preset');
        if (p === 'compliant') {
          dishSel.value = 'conveyor_dual_tank_electric';
          solSel.value = 'pilot_operated_rapid';
          arrSel.value = 'pdi_size_b';
          geoSel.value = 'rigid_clevis_anchored';
          flowSlider.value = '3.8';
          lengthSlider.value = '25';
          pressureSlider.value = '22';
          tempSlider.value = '182';
        } else if (p === 'severe_hammer') {
          dishSel.value = 'aging_institutional_scullery';
          solSel.value = 'direct_acting_spring_snap';
          arrSel.value = 'none_bare_pipe';
          geoSel.value = 'unsupported_span_flopping';
          flowSlider.value = '5.5';
          lengthSlider.value = '42';
          pressureSlider.value = '35';
          tempSlider.value = '185';
        } else if (p === 'cavitation') {
          dishSel.value = 'underbar_high_temp_chemical_hybrid';
          solSel.value = 'pilot_operated_rapid';
          arrSel.value = 'waterlogged_air_chamber';
          geoSel.value = 'standard_drop_wire_hangers';
          flowSlider.value = '4.2';
          lengthSlider.value = '30';
          pressureSlider.value = '16';
          tempSlider.value = '192';
        } else if (p === 'fatigue_failure') {
          dishSel.value = 'compact_single_tank_conveyor';
          solSel.value = 'worn_calcified_shuttle';
          arrSel.value = 'none_bare_pipe';
          geoSel.value = 'unsupported_span_flopping';
          flowSlider.value = '4.8';
          lengthSlider.value = '38';
          pressureSlider.value = '28';
          tempSlider.value = '184';
        }
        calculateHydraulics();
      });
    });

    // Copy Report Button
    const copyBtn = document.getElementById('cwhm-copy-btn');
    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        const dish = dishwasherData.dishwasherBoosterConfigs.find(c => c.id === dishSel.value) || dishwasherData.dishwasherBoosterConfigs[0];
        const sol = dishwasherData.solenoidValveClasses.find(s => s.id === solSel.value) || dishwasherData.solenoidValveClasses[0];
        const arr = dishwasherData.waterHammerArresterOptions.find(a => a.id === arrSel.value) || dishwasherData.waterHammerArresterOptions[0];

        const reportText = [
          '=== COMMERCIAL CONVEYOR DISHWASHER WATER-HAMMER & HYDRAULIC REPORT ===',
          `Equipment Model: ${dish.name}`,
          `Solenoid Valve Class: ${sol.name} (${sol.closureTimeMs} ms)`,
          `Water Hammer Arrester: ${arr.name}`,
          `Rinse Flow: ${flowSlider.value} GPM | Pipe Length: ${lengthSlider.value} ft`,
          `Supply Pressure: ${pressureSlider.value} PSI | Booster Temp: ${tempSlider.value}°F`,
          '----------------------------------------------------------------------',
          `Peak Joukowsky Pressure: ${resPeakPsi.textContent}`,
          `Acoustic Wave Velocity: ${resWaveSpeed.textContent}`,
          `Copper Pipe Hoop Stress: ${resHoopStress.textContent}`,
          `Cavitation Risk Index: ${resCavitation.textContent}`,
          `Estimated Fatigue Cycles: ${resFatigueCycles.textContent} (${resFatigueYears.textContent})`,
          `Impact Noise Level: ${resNoiseDb.textContent}`,
          '----------------------------------------------------------------------',
          `Compliance: ${diagCompliance.textContent.trim()}`,
          `Primary Risk: ${diagRisk.textContent.trim()}`,
          `Physics Formula: ${diagMechanisms.textContent.trim()}`,
          `Engineering Mitigation: ${diagMitigation.textContent.trim()}`,
          '======================================================================'
        ].join('\n');

        navigator.clipboard.writeText(reportText).then(() => {
          const original = copyBtn.innerHTML;
          copyBtn.innerHTML = '<span>✓ Copied!</span>';
          copyBtn.classList.add('bg-emerald-600');
          setTimeout(() => {
            copyBtn.innerHTML = original;
            copyBtn.classList.remove('bg-emerald-600');
          }, 2500);
        });
      });
    }

    // Initial calculation
    calculateHydraulics();
  })();
</script>
