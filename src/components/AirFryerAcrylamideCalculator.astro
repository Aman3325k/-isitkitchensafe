    stepTempText: "設定温度を160℃〜170℃（320°F〜340°F）に抑え、時間を2〜3分延ばすことで焦がさずにサクサクに仕上げます。",
    stepColorText: "ゴールデンカラーを目指す（Go for Golden）：全体が明るい黄金色になった時点で加熱を止め、焦げた部分は食べずに取り除きます。",
    stepOilText: "高オレイン酸オイル（アボカド油や精製オリーブ油）をごく薄くスプレーすることで、熱を均一に伝え表面の焦げ付きを防ぎます。",
    guideTitle: "アクリルアミドの真実、AGEsとノンフライヤー安全科学",
    guideSub: "EU規制 2017/2158 と家庭での科学的温度管理の要点：",
    copyReportBtn: "📋 ノンフライヤー有害物質診断カルテをコピー",
    reportCopied: "✓ 診断カルテがクリップボードにコピーされました！",
    crossLinkTitle: "他のキッチン安全性診断ツールを試す：",
    crossLinkWater: "逆浸透膜（RO）浄水器効率＆フッ素診断ツール",
    crossLinkSousVide: "低温調理プラスチック溶出診断ツール",
    crossLinkOil: "食用油発煙点シミュレーター",
    crossLinkMigration: "食品接触化学物質移行予測ツール",
    crossLinkScorecard: "調理器具PFAS溶出カルテ"
  }
};

const d = DICT[lang] || DICT.en;
const prefix = lang === 'en' ? '' : `/${lang}`;
---

<div class="air-fryer-acrylamide-widget space-y-8" data-lang={lang}>
  <!-- Header Banner -->
  <div class="bg-gradient-to-r from-amber-500/10 via-orange-500/10 to-rose-500/10 border border-amber-500/30 rounded-3xl p-6 md:p-8 space-y-3">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-600 text-white shadow-xs">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343a7.975 7.975 0 010 11.314z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        {d.badge}
      </span>
      <span class="text-xs font-mono text-muted">
        EU 2017/2158 &bull; EFSA 2015 &bull; FDA 2016 &bull; IARC Group 2A
      </span>
    </div>
    <div>
      <h1 class="text-title-xl md:text-title-2xl font-bold text-ink tracking-tight">
        {d.title}
      </h1>
      <p class="text-body text-xs md:text-sm leading-relaxed max-w-4xl mt-2">
        {d.subtitle}
      </p>
    </div>
  </div>

  <!-- Interactive Grid: Controls (5 cols) & Analytics (7 cols) -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Left Column: Interactive Controls -->
    <div class="lg:col-span-5 bg-surface-soft border border-hairline rounded-2xl p-6 space-y-6 shadow-xs">
      <div>
        <h2 class="text-title-md font-bold text-ink tracking-tight flex items-center gap-2">
          <svg class="w-5 h-5 text-amber-600 dark:text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
          </svg>
          {d.controlsTitle}
        </h2>
        <p class="text-xs text-muted leading-relaxed mt-1">
          {d.controlsSub}
        </p>
      </div>

      <!-- Quick Culinary Presets -->
      <div class="space-y-2">
        <span class="text-xs font-bold uppercase tracking-wider text-muted block">
          {d.presetsTitle}
        </span>
        <div class="grid grid-cols-2 gap-2">
          <button 
            type="button" 
            class="af-preset-btn p-2.5 rounded-xl border border-hairline bg-canvas hover:border-amber-500 hover:bg-amber-500/5 text-[11px] font-medium text-ink text-left transition-all"
            data-food="russet-potatoes"
            data-temp="340"
            data-time="20"
            data-pretreat="cold-soak"
            data-doneness="golden-yellow"
          >
            {d.presetHomemadeFries}
          </button>
          <button 
            type="button" 
            class="af-preset-btn p-2.5 rounded-xl border border-hairline bg-canvas hover:border-amber-500 hover:bg-amber-500/5 text-[11px] font-medium text-ink text-left transition-all"
            data-food="frozen-parfried-fries"
            data-temp="360"
            data-time="15"
            data-pretreat="none"
            data-doneness="golden-yellow"
          >
            {d.presetFrozenFries}
          </button>
          <button 
            type="button" 
            class="af-preset-btn p-2.5 rounded-xl border border-hairline bg-canvas hover:border-amber-500 hover:bg-amber-500/5 text-[11px] font-medium text-ink text-left transition-all"
            data-food="sweet-potatoes"
            data-temp="330"
            data-time="18"
            data-pretreat="none"
            data-doneness="golden-yellow"
          >
            {d.presetSweetPotato}
          </button>
          <button 
            type="button" 
            class="af-preset-btn p-2.5 rounded-xl border border-hairline bg-canvas hover:border-amber-500 hover:bg-amber-500/5 text-[11px] font-medium text-ink text-left transition-all"
            data-food="breaded-chicken-tenders"
            data-temp="375"
            data-time="14"
            data-pretreat="none"
            data-doneness="golden-yellow"
          >
            {d.presetBreadedChicken}
          </button>
          <button 
            type="button" 
            class="af-preset-btn p-2.5 rounded-xl border border-hairline bg-canvas hover:border-amber-500 hover:bg-amber-500/5 text-[11px] font-medium text-ink text-left transition-all"
            data-food="white-bread-croutons"
            data-temp="310"
            data-time="8"
            data-pretreat="none"
            data-doneness="golden-yellow"
          >
            {d.presetCroutons}
          </button>
          <button 
            type="button" 
            class="af-preset-btn p-2.5 rounded-xl border border-rose-500/30 bg-rose-500/5 hover:border-rose-500 text-[11px] font-medium text-rose-800 dark:text-rose-200 text-left transition-all"
            data-food="bacon-pork-belly"
            data-temp="350"
            data-time="10"
            data-pretreat="none"
            data-doneness="golden-amber"
          >
            {d.presetBacon}
          </button>
        </div>
      </div>

      <!-- Food Selection Dropdown -->
      <div class="space-y-2">
        <label for="af-food-select" class="text-xs font-bold uppercase tracking-wider text-muted block">
          {d.foodSelectLabel}
        </label>
        <select 
          id="af-food-select" 
          class="w-full p-3 rounded-xl border border-hairline bg-canvas text-sm font-medium text-ink focus:outline-hidden focus:ring-2 focus:ring-amber-500 transition-all cursor-pointer"
        >
          {acrylamideData.foods.map(f => (
            <option value={f.id} selected={f.id === 'russet-potatoes'}>
              {f.name} ({f.category})
            </option>
          ))}
        </select>
        <p id="af-food-description" class="text-xs text-muted italic leading-relaxed pt-1">
          {acrylamideData.foods[0].description}
        </p>
      </div>

      <!-- Temperature Slider -->
      <div class="space-y-2">
        <div class="flex items-center justify-between">
          <label for="af-temp-slider" class="text-xs font-bold uppercase tracking-wider text-muted">
            {d.tempLabel}
          </label>
          <span id="af-temp-display" class="font-mono text-sm font-bold text-amber-600 dark:text-amber-400">
            350°F / 177°C
          </span>
        </div>
        <input 
          type="range" 
          id="af-temp-slider" 
          min="250" 
          max="400" 
          step="5" 
          value="350"
          class="w-full accent-amber-600 cursor-pointer"
        />
        <div class="flex justify-between text-[10px] text-muted font-mono">
          <span>250°F (120°C - Low)</span>
          <span>340°F (170°C - Sweet Spot)</span>
          <span>400°F (204°C - Max)</span>
        </div>
      </div>

      <!-- Time Slider -->
      <div class="space-y-2">
        <div class="flex items-center justify-between">
          <label for="af-time-slider" class="text-xs font-bold uppercase tracking-wider text-muted">
            {d.timeLabel}
          </label>
          <span id="af-time-display" class="font-mono text-sm font-bold text-amber-600 dark:text-amber-400">
            18 min
          </span>
        </div>
        <input 
          type="range" 
          id="af-time-slider" 
          min="4" 
          max="35" 
          step="1" 
          value="18"
          class="w-full accent-amber-600 cursor-pointer"
        />
        <div class="flex justify-between text-[10px] text-muted font-mono">
          <span>4 min (Flash crisp)</span>
          <span>15 min (Standard)</span>
          <span>35 min (Dense roots)</span>
        </div>
      </div>

      <!-- Pre-Treatment Radio Selection -->
      <div class="space-y-2">
        <label class="text-xs font-bold uppercase tracking-wider text-muted block">
          {d.preTreatmentLabel}
        </label>
        <div class="space-y-2">
          {acrylamideData.preTreatments.map((pt, idx) => (
            <label class="flex items-start gap-3 p-2.5 rounded-xl border border-hairline hover:border-amber-500/50 bg-canvas cursor-pointer transition-all">
              <input 
                type="radio" 
                name="af-pretreatment" 
                value={pt.id} 
                checked={idx === 1}
                class="mt-1 accent-amber-600"
              />
              <div class="flex-1 text-xs">
                <div class="flex items-center justify-between gap-2">
                  <span class="font-bold text-ink">{pt.name}</span>
                  <span class={`text-[10px] font-bold px-2 py-0.5 rounded-full ${
                    pt.badgeColor === 'emerald' ? 'bg-emerald-500/10 text-emerald-700 dark:text-emerald-300' :
                    pt.badgeColor === 'cyan' ? 'bg-cyan-500/10 text-cyan-700 dark:text-cyan-300' :
                    pt.badgeColor === 'rose' ? 'bg-rose-500/10 text-rose-700 dark:text-rose-300' :
                    'bg-zinc-500/10 text-muted'
                  }`}>
                    {pt.badge}
                  </span>
                </div>
                <p class="text-muted text-[11px] mt-0.5">{pt.description}</p>
              </div>
            </label>
          ))}
        </div>
      </div>

      <!-- Doneness / Browning Level Selection -->
      <div class="space-y-2">
        <label class="text-xs font-bold uppercase tracking-wider text-muted block">
          {d.donenessLabel}
        </label>
        <div class="grid grid-cols-2 gap-2">
          {acrylamideData.browningDonenessLevels.map((b, idx) => (
            <label class="flex items-center gap-2.5 p-2 rounded-xl border border-hairline hover:border-amber-500/50 bg-canvas cursor-pointer transition-all">
              <input 
                type="radio" 
                name="af-doneness" 
                value={b.id} 
                checked={idx === 1}
                class="accent-amber-600"
              />
              <span class="w-3.5 h-3.5 rounded-full border border-black/20 shrink-0" style={`background-color: ${b.visualColor};`}></span>
              <div class="text-[11px] leading-tight font-medium text-ink">
                <span>{b.name}</span>
              </div>
            </label>
          ))}
        </div>
      </div>
    </div>

    <!-- Right Column: Toxicological Diagnostic Scorecard -->
    <div class="lg:col-span-7 space-y-6">
      <!-- Verdict Banner -->
      <div id="af-verdict-card" class="rounded-2xl border p-6 space-y-3 transition-all duration-300 bg-amber-500/10 border-amber-500/30 text-amber-950 dark:text-amber-100">
        <div class="flex items-center justify-between gap-2">
          <span class="text-xs font-bold uppercase tracking-wider text-muted">
            {d.overallStatusLabel}
          </span>
          <span id="af-grade-badge" class="px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-amber-600 text-white shadow-xs">
            GRADE B
          </span>
        </div>
        <h3 id="af-verdict-title" class="text-title-md font-bold tracking-tight">
          {d.statusAcceptable}
        </h3>
        <p id="af-verdict-desc" class="text-xs md:text-sm leading-relaxed text-body">
          Acrylamide accumulation remains within reasonable bounds. The outer crust has achieved safe convective crisping while minimizing carcinogenic volatile condensation.
        </p>
      </div>

      <!-- Real-time Alerts Stack -->
      <div id="af-alerts-container" class="space-y-3">
        <!-- Refrigerator sweetening alert (hidden by default) -->
        <div id="af-alert-fridge" class="hidden rounded-xl border border-rose-500/40 bg-rose-500/10 p-4 text-rose-900 dark:text-rose-200 text-xs leading-relaxed space-y-1">
          <div class="font-bold flex items-center gap-1.5">
            {d.fridgeAlertTitle}
          </div>
          <p>{d.fridgeAlertText}</p>
        </div>

        <!-- Scorched char alert (hidden by default) -->
        <div id="af-alert-scorched" class="hidden rounded-xl border border-orange-500/40 bg-orange-500/10 p-4 text-orange-900 dark:text-orange-200 text-xs leading-relaxed space-y-1">
          <div class="font-bold flex items-center gap-1.5">
            {d.scorchedAlertTitle}
          </div>
          <p>{d.scorchedAlertText}</p>
        </div>

        <!-- Meat / Breaded Protein HCA alert (hidden by default) -->
        <div id="af-alert-meat" class="hidden rounded-xl border border-indigo-500/40 bg-indigo-500/10 p-4 text-indigo-900 dark:text-indigo-200 text-xs leading-relaxed space-y-1">
          <div class="font-bold flex items-center gap-1.5">
            {d.meatHcaAlertTitle}
          </div>
          <p>{d.meatHcaAlertText}</p>
        </div>

        <!-- Pre-treatment mitigation active -->
        <div id="af-alert-mitigation" class="rounded-xl border border-emerald-500/40 bg-emerald-500/10 p-4 text-emerald-900 dark:text-emerald-200 text-xs leading-relaxed space-y-1">
          <div class="font-bold flex items-center gap-1.5">
            {d.mitigationSuccessTitle}
          </div>
          <p>{d.mitigationSuccessText}</p>
        </div>
      </div>

      <!-- Quantitative Metrics Grid -->
      <div class="bg-surface-soft border border-hairline rounded-2xl p-6 space-y-6 shadow-xs">
        <h4 class="text-xs font-bold uppercase tracking-wider text-muted">
          {d.metricsTitle}
        </h4>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
          <!-- Acrylamide Value -->
          <div class="p-3.5 rounded-xl border border-hairline bg-canvas space-y-1">
            <span class="text-[11px] text-muted block">{d.acrylamideLabel}</span>
            <div class="flex items-baseline gap-1">
              <span id="af-metric-acrylamide" class="text-title-lg font-mono font-bold text-ink">
                245
              </span>
              <span class="text-xs text-muted font-mono">µg/kg (ppb)</span>
            </div>
            <div class="w-full bg-zinc-200 dark:bg-zinc-700 h-1.5 rounded-full overflow-hidden mt-1">
              <div id="af-bar-acrylamide" class="bg-amber-500 h-full transition-all duration-300" style="width: 49%;"></div>
            </div>
          </div>

          <!-- EFSA Benchmark Comparison -->
          <div class="p-3.5 rounded-xl border border-hairline bg-canvas space-y-1">
            <span class="text-[11px] text-muted block">{d.efsaBenchmarkLabel}</span>
            <div class="flex items-baseline gap-1">
              <span id="af-metric-benchmark-percent" class="text-title-lg font-mono font-bold text-emerald-600 dark:text-emerald-400">
                49%
              </span>
              <span class="text-xs text-muted font-mono">of 500 ppb limit</span>
            </div>
            <span id="af-metric-benchmark-status" class="text-[10px] font-bold text-emerald-700 dark:text-emerald-300 block">
              ✓ Complies with EU 2017/2158
            </span>
          </div>

          <!-- Dietary AGEs Index -->
          <div class="p-3.5 rounded-xl border border-hairline bg-canvas space-y-1">
            <span class="text-[11px] text-muted block">{d.agesLabel}</span>
            <div class="flex items-baseline gap-1">
              <span id="af-metric-ages" class="text-title-lg font-mono font-bold text-ink">
                1,850
              </span>
              <span class="text-xs text-muted font-mono">kU / 100g</span>
            </div>
            <span id="af-metric-ages-level" class="text-[10px] text-muted block">
              Low-to-Moderate Glycation
            </span>
          </div>

          <!-- HCA Risk Level -->
          <div class="p-3.5 rounded-xl border border-hairline bg-canvas space-y-1">
            <span class="text-[11px] text-muted block">{d.hcaRiskLabel}</span>
            <span id="af-metric-hca" class="text-title-sm font-bold text-ink block mt-1">
              Negligible
            </span>
            <span class="text-[10px] text-muted block">Vegetable / Starch Matrix</span>
          </div>

          <!-- Safe Temp Margin -->
          <div class="p-3.5 rounded-xl border border-hairline bg-canvas space-y-1">
            <span class="text-[11px] text-muted block">{d.safeTempDeltaLabel}</span>
            <span id="af-metric-temp-delta" class="text-title-sm font-bold text-emerald-600 dark:text-emerald-400 block mt-1">
              +10°F Safe Range
            </span>
            <span id="af-metric-recommended-temp" class="text-[10px] text-muted block">Target: 300°F-330°F</span>
          </div>

          <!-- Surface Crust Desiccation -->
          <div class="p-3.5 rounded-xl border border-hairline bg-canvas space-y-1">
            <span class="text-[11px] text-muted block">{d.crustMoistureLabel}</span>
            <span id="af-metric-crust" class="text-title-sm font-bold text-ink block mt-1">
              Crisp (aw &lt; 0.35)
            </span>
            <span class="text-[10px] text-muted block">Optimal Texture Zone</span>
          </div>
        </div>

        <!-- Actionable Mitigation Steps -->
        <div class="border-t border-hairline pt-4 space-y-2">
          <h5 class="text-xs font-bold uppercase tracking-wider text-ink flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            {d.mitigationStepsTitle}
          </h5>
          <ul class="text-xs text-body space-y-1.5 list-disc list-inside leading-relaxed pl-1">
            <li>{d.stepSoakText}</li>
            <li>{d.stepTempText}</li>
            <li>{d.stepColorText}</li>
            <li>{d.stepOilText}</li>
          </ul>
        </div>

        <!-- Copy Report Button -->
        <div class="pt-2">
          <button 
            type="button" 
            id="af-copy-btn" 
            class="w-full py-3 px-4 rounded-xl bg-amber-600 hover:bg-amber-700 text-white font-medium text-xs md:text-sm transition-all shadow-xs flex items-center justify-center gap-2 cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
            </svg>
            <span>{d.copyReportBtn}</span>
          </button>
          <span id="af-copy-toast" class="hidden text-xs text-emerald-600 dark:text-emerald-400 font-bold text-center block mt-2">
            {d.reportCopied}
          </span>
        </div>
      </div>
    </div>
  </div>

  <!-- Educational Reference Cards Section -->
  <div class="bg-surface-soft border border-hairline rounded-3xl p-6 md:p-8 space-y-6">
    <div>
      <span class="text-xs font-bold uppercase tracking-wider text-amber-800 dark:text-amber-400 block mb-1">
        {d.guideTitle}
      </span>
      <h3 class="text-title-lg font-bold text-ink tracking-tight">
        {d.guideSub}
      </h3>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      {acrylamideData.toxicByproducts.map(t => (
        <div class="p-4 rounded-2xl border border-hairline bg-canvas space-y-2">
          <div class="flex items-center justify-between gap-1">
            <span class="text-xs font-bold text-ink">{t.name}</span>
          </div>
          <span class="inline-block px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-500/10 text-amber-800 dark:text-amber-200">
            {t.iarcClass}
          </span>
          <p class="text-[11px] text-muted leading-relaxed">
            <strong>Source:</strong> {t.source}
          </p>
          <p class="text-[11px] text-muted leading-relaxed">
            <strong>Target:</strong> {t.primaryTarget}
          </p>
        </div>
      ))}
    </div>
  </div>

  <!-- Cross Navigation to Companion Tools -->
  <div class="p-6 rounded-2xl border border-hairline bg-surface-soft space-y-4">
    <h4 class="text-xs font-bold uppercase tracking-wider text-muted">
      {d.crossLinkTitle}
    </h4>
    <div class="flex flex-wrap gap-2.5 text-xs">
      <a 
        href={`${prefix}/tools/water-filter-efficiency-analyzer/`}
        class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl border border-hairline bg-canvas hover:border-cyan-500 hover:text-cyan-600 transition-colors"
      >
        <span>💧 {d.crossLinkWater}</span>
        <span class="text-muted">&rarr;</span>
      </a>
      <a 
        href={`${prefix}/tools/sous-vide-plastic-microbial-modeler/`}
        class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl border border-hairline bg-canvas hover:border-cyan-500 hover:text-cyan-600 transition-colors"
      >
        <span>🥩 {d.crossLinkSousVide}</span>
        <span class="text-muted">&rarr;</span>
      </a>
      <a 
        href={`${prefix}/tools/culinary-oil-smoke-point-simulator/`}
        class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl border border-hairline bg-canvas hover:border-amber-500 hover:text-amber-600 transition-colors"
      >
        <span>🍳 {d.crossLinkOil}</span>
        <span class="text-muted">&rarr;</span>
      </a>
      <a 
        href={`${prefix}/tools/food-contact-migration-predictor/`}
        class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl border border-hairline bg-canvas hover:border-indigo-500 hover:text-indigo-600 transition-colors"
      >
        <span>🔬 {d.crossLinkMigration}</span>
        <span class="text-muted">&rarr;</span>
      </a>
      <a 
        href={`${prefix}/tools/toxic-leaching-scorecard/`}
        class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl border border-hairline bg-canvas hover:border-rose-500 hover:text-rose-600 transition-colors"
      >
        <span>🧪 {d.crossLinkScorecard}</span>
        <span class="text-muted">&rarr;</span>
      </a>
    </div>
  </div>
</div>

<!-- Embedded JSON Raw Data for Client-Side Computation -->
<script type="application/json" id="af-data-raw" set:html={JSON.stringify(acrylamideData)} />

<!-- Client-side Calculation & Interactive Controller -->
<script is:inline>
(function() {
  const root = document.querySelector('.air-fryer-acrylamide-widget');
  if (!root) return;

  const dataScript = document.getElementById('af-data-raw');
  if (!dataScript) return;
  const data = JSON.parse(dataScript.textContent || '{}');

  const lang = root.dataset.lang || 'en';

  // Elements
  const foodSelect = document.getElementById('af-food-select');
  const foodDesc = document.getElementById('af-food-description');
  const tempSlider = document.getElementById('af-temp-slider');
  const tempDisplay = document.getElementById('af-temp-display');
  const timeSlider = document.getElementById('af-time-slider');
  const timeDisplay = document.getElementById('af-time-display');

  // Outputs
  const verdictCard = document.getElementById('af-verdict-card');
  const gradeBadge = document.getElementById('af-grade-badge');
  const verdictTitle = document.getElementById('af-verdict-title');
  const verdictDesc = document.getElementById('af-verdict-desc');

  const alertFridge = document.getElementById('af-alert-fridge');
  const alertScorched = document.getElementById('af-alert-scorched');
  const alertMeat = document.getElementById('af-alert-meat');
  const alertMitigation = document.getElementById('af-alert-mitigation');

  const metricAcrylamide = document.getElementById('af-metric-acrylamide');
  const barAcrylamide = document.getElementById('af-bar-acrylamide');
  const metricBenchmarkPercent = document.getElementById('af-metric-benchmark-percent');
  const metricBenchmarkStatus = document.getElementById('af-metric-benchmark-status');
  const metricAges = document.getElementById('af-metric-ages');
  const metricAgesLevel = document.getElementById('af-metric-ages-level');
  const metricHca = document.getElementById('af-metric-hca');
  const metricTempDelta = document.getElementById('af-metric-temp-delta');
  const metricRecommendedTemp = document.getElementById('af-metric-recommended-temp');
  const metricCrust = document.getElementById('af-metric-crust');

  const copyBtn = document.getElementById('af-copy-btn');
  const copyToast = document.getElementById('af-copy-toast');
  const presetBtns = document.querySelectorAll('.af-preset-btn');

  function calculate() {
    const foodId = foodSelect.value;
    const food = data.foods.find(f => f.id === foodId) || data.foods[0];
    const tempF = parseInt(tempSlider.value, 10);
    const timeMins = parseInt(timeSlider.value, 10);

    const pretreatRadio = document.querySelector('input[name="af-pretreatment"]:checked');
    const pretreatId = pretreatRadio ? pretreatRadio.value : 'none';
    const pretreat = data.preTreatments.find(p => p.id === pretreatId) || data.preTreatments[0];

    const donenessRadio = document.querySelector('input[name="af-doneness"]:checked');
    const donenessId = donenessRadio ? donenessRadio.value : 'golden-yellow';
    const doneness = data.browningDonenessLevels.find(b => b.id === donenessId) || data.browningDonenessLevels[1];

    // Temperature in Celsius
    const tempC = Math.round((tempF - 32) * 5 / 9);
    tempDisplay.textContent = `${tempF}°F / ${tempC}°C`;
    timeDisplay.textContent = `${timeMins} min`;

    if (foodDesc) {
      foodDesc.textContent = food.description;
    }

    // Mathematical Kinetic Model:
    // Rate k = A * exp(-Ea / (R * T))
    // Standard baseline at 320°F (160°C / 433.15 K) for 15 min
    const T_kelvin = tempC + 273.15;
    const T_ref = 160 + 273.15; // 433.15 K
    const R = 8.314; // J/(mol*K)
    const Ea = food.activationEnergyKjMol * 1000; // J/mol

    // Thermal kinetic factor
    const tempFactor = Math.exp((-Ea / R) * (1 / T_kelvin - 1 / T_ref));
    
    // Time scaling (non-linear: incubation + crust desiccation curve)
    // Minimal formation in first 5 min while moisture evaporates
    const effectiveTime = Math.max(0, timeMins - 4);
    const timeFactor = Math.pow(effectiveTime / 11, 1.25);

    // Baseline acrylamide
    let acrylamide = food.baseAcrylamidePpb * tempFactor * timeFactor;

    // Apply Pre-treatment modifier
    acrylamide *= pretreat.acrylamideModifier;

    // Apply Browning / Doneness multiplier
    acrylamide *= doneness.multiplier;

    // Floor and rounding
    acrylamide = Math.max(5, Math.round(acrylamide));

    // EFSA Benchmark comparison
    const benchmark = food.efsaBenchmarkPpb || 500;
    const benchmarkRatio = (acrylamide / benchmark) * 100;
    const benchmarkPercentStr = `${Math.round(benchmarkRatio)}%`;

    // Advanced Glycation End-products (AGEs) Model
    let agesBase = 800;
    if (food.category.includes('Proteins') || food.category.includes('Meats')) {
      agesBase = 4200;
    } else if (food.id === 'bacon-pork-belly') {
      agesBase = 7500;
    } else if (food.id === 'white-bread-croutons') {
      agesBase = 1200;
    }
    let ages = Math.round(agesBase * (tempF / 320) * (timeMins / 15) * (doneness.multiplier * 0.8));
    if (food.id === 'bacon-pork-belly' && donenessId === 'dark-scorched') {
      ages = Math.min(18500, Math.round(ages * 1.5));
    }

    // Heterocyclic Amines (HCAs) for meats
    let hcaLevel = 'Negligible';
    if (food.hcaRisk === 'moderate' || food.hcaRisk === 'high') {
      if (tempF < 350) {
        hcaLevel = 'Low (< 1.5 ng/g)';
      } else if (tempF <= 375 && donenessId !== 'dark-scorched') {
        hcaLevel = 'Moderate (2 - 5 ng/g)';
      } else {
        hcaLevel = 'Elevated (> 8 ng/g PhIP/MeIQx)';
      }
    }

    // Determine Risk Grade
    let grade = 'A';
    let cardClass = 'bg-emerald-500/10 border-emerald-500/30 text-emerald-950 dark:text-emerald-100';
    let badgeClass = 'bg-emerald-600 text-white';
    let title = 'GRADE A: MINIMAL ACRYLAMIDE — WELL BELOW REGULATORY BENCHMARKS';
    let desc = 'Acrylamide and thermal oxidation products remain at minimal, healthy levels. Convective crisping achieved without hazardous cellular degradation.';

    if (pretreatId === 'fridge-stored' || donenessId === 'dark-scorched' || acrylamide > 1200) {
      grade = 'E';
      cardClass = 'bg-rose-500/15 border-rose-500/40 text-rose-950 dark:text-rose-100';
      badgeClass = 'bg-rose-600 text-white';
      title = 'GRADE E: CRITICAL DANGER — CHARRED / COLD-SWEETENED TOXIC LOAD';
      desc = 'Extremely high concentration of thermal byproducts. Severe Maillard degradation has produced heavy acrylamide, dietary AGEs, and potential mutagenic pyrolysis products. Do not consume charred portions.';
    } else if (acrylamide > benchmark * 1.3 || (tempF >= 390 && timeMins >= 22)) {
      grade = 'D';
      cardClass = 'bg-orange-500/15 border-orange-500/40 text-orange-950 dark:text-orange-100';
      badgeClass = 'bg-orange-600 text-white';
      title = 'GRADE D: HIGH HAZARD — HEAVY ACCUMULATION OF THERMAL BYPRODUCTS';
      desc = 'Thermal byproducts significantly exceed European Food Safety Authority (EFSA) guidance benchmarks. Extended exposure at high convective heat has degraded surface nutrients.';
    } else if (acrylamide > benchmark || donenessId === 'golden-amber') {
      grade = 'C';
      cardClass = 'bg-amber-500/15 border-amber-500/40 text-amber-950 dark:text-amber-100';
      badgeClass = 'bg-amber-600 text-white';
      title = 'GRADE C: CAUTION — ELEVATED ACRYLAMIDE EXCEEDING BENCHMARK';
      desc = 'Acrylamide level has crossed the target regulatory benchmark. Consider reducing cooking temperature by 25°F or applying a 20-minute cold water pre-soak.';
    } else if (acrylamide >= 150) {
      grade = 'B';
      cardClass = 'bg-blue-500/10 border-blue-500/30 text-blue-950 dark:text-blue-100';
      badgeClass = 'bg-blue-600 text-white';
      title = 'GRADE B: ACCEPTABLE — COMPLIANT WITH EFSA SAFETY LIMITS';
      desc = 'Acrylamide accumulation remains within safe regulatory parameters. The food achieves desirable golden crispness with controlled Maillard byproducts.';
    }

    // Localized status overrides if applicable
    const dict = {
      es: {
        'A': 'GRADO A: ACRILAMIDA MÍNIMA — MUY POR DEBAJO DE LÍMITES EUROPEOS',
        'B': 'GRADO B: ACEPTABLE — DENTRO DE LOS MÁRGENES DE SEGURIDAD EFSA',
        'C': 'GRADO C: PRECAUCIÓN — ACRILAMIDA ELEVADA QUE SUPERA EL BENCHMARK',
        'D': 'GRADO D: ALTO PELIGRO — ACUMULACIÓN SEVERA DE TÓXICOS TÉRMICOS',
        'E': 'GRADO E: PELIGRO CRÍTICO — CARGA TÓXICA POR QUEMADO O ALMIDÓN ENFRIADO'
      },
      pt: {
        'A': 'GRAU A: ACRILAMIDA MÍNIMA — MUITO ABAIXO DAS NORMAS EUROPEIAS',
        'B': 'GRAU B: ACEITÁVEL — EM CONFORMIDADE COM LIMITES DA EFSA',
        'C': 'GRAU C: ATENÇÃO — ACRILAMIDA ELEVADA ACIMA DA META RECOMENDADA',
        'D': 'GRAU D: ALTO RISCO — ACÚMULO SEVERO DE SUBPRODUTOS TÉRMICOS',
        'E': 'GRAU E: RISCO CRÍTICO — TOXICIDADE EXTREMA POR QUEIMADO OU AMIDO REFRIGERADO'
      },
      'zh-cn': {
        'A': '等级 A：极佳安全 — 丙烯酰胺极低，远低于欧盟严苛限值',
        'B': '等级 B：合格达标 — 处于欧盟 EFSA 推荐基准安全范围内',
        'C': '等级 C：警惕超标 — 表面过度褐变，丙烯酰胺已超出基准线',
        'D': '等级 D：高度危险 — 高温剧烈热解，有害副产物显著蓄积',
        'E': '等级 E：极高致癌毒理负荷 — 焦黑炭化或冷藏致糖剧增爆表'
      },
      ja: {
        'A': 'グレード A：極めて安全 — アクリルアミド極小、欧州基準値を大幅に下回る',
        'B': 'グレード B：安全許容範囲 — EFSA 推奨基準に適合',
        'C': 'グレード C：注意 — 焼き色が濃くアクリルアミド基準値を超過',
        'D': 'グレード D：高危険度 — 高温熱分解により有害物質が顕著に蓄積',
        'E': 'グレード E：危険・毒性多大 — 焦げ付き炭化または冷蔵による糖化爆発'
      }
    };

    if (dict[lang] && dict[lang][grade]) {
      title = dict[lang][grade];
    }

    // Apply Verdict styling
    verdictCard.className = `rounded-2xl border p-6 space-y-3 transition-all duration-300 ${cardClass}`;
    gradeBadge.className = `px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider ${badgeClass}`;
    gradeBadge.textContent = `GRADE ${grade}`;
    verdictTitle.textContent = title;
    verdictDesc.textContent = desc;

    // Update Alerts
    alertFridge.classList.toggle('hidden', pretreatId !== 'fridge-stored');
    alertScorched.classList.toggle('hidden', donenessId !== 'dark-scorched');
    alertMeat.classList.toggle('hidden', !(food.hcaRisk === 'moderate' || food.hcaRisk === 'high'));
    alertMitigation.classList.toggle('hidden', pretreatId === 'none' || pretreatId === 'fridge-stored');

    // Update Metrics
    metricAcrylamide.textContent = acrylamide.toLocaleString();
    const barWidth = Math.min(100, Math.round((acrylamide / (benchmark * 1.5)) * 100));
    barAcrylamide.style.width = `${barWidth}%`;
    if (acrylamide > benchmark) {
      barAcrylamide.className = 'bg-rose-500 h-full transition-all duration-300';
    } else if (acrylamide > benchmark * 0.7) {
      barAcrylamide.className = 'bg-amber-500 h-full transition-all duration-300';
    } else {
      barAcrylamide.className = 'bg-emerald-500 h-full transition-all duration-300';
    }

    metricBenchmarkPercent.textContent = benchmarkPercentStr;
    if (acrylamide <= benchmark) {
      metricBenchmarkPercent.className = 'text-title-lg font-mono font-bold text-emerald-600 dark:text-emerald-400';
      metricBenchmarkStatus.textContent = `✓ Meets EU benchmark (${benchmark} ppb limit)`;
      metricBenchmarkStatus.className = 'text-[10px] font-bold text-emerald-700 dark:text-emerald-300 block';
    } else {
      metricBenchmarkPercent.className = 'text-title-lg font-mono font-bold text-rose-600 dark:text-rose-400';
      metricBenchmarkStatus.textContent = `⚠️ Exceeds EU benchmark (${benchmark} ppb limit)`;
      metricBenchmarkStatus.className = 'text-[10px] font-bold text-rose-700 dark:text-rose-300 block';
    }

    metricAges.textContent = ages.toLocaleString();
    metricHca.textContent = hcaLevel;
    metricRecommendedTemp.textContent = `Target: ${food.safeTempRangeF}`;

    // Temperature Delta
    const safeMaxTemp = parseInt(food.safeTempRangeF.slice(0, 3), 10) + 30;
    if (tempF <= safeMaxTemp) {
      metricTempDelta.textContent = `✓ Safe Range (${tempF}°F)`;
      metricTempDelta.className = 'text-title-sm font-bold text-emerald-600 dark:text-emerald-400 block mt-1';
    } else {
      metricTempDelta.textContent = `+${tempF - safeMaxTemp}°F High Heat`;
      metricTempDelta.className = 'text-title-sm font-bold text-rose-600 dark:text-rose-400 block mt-1';
    }
  }

  // Event Listeners
  foodSelect.addEventListener('change', calculate);
  tempSlider.addEventListener('input', calculate);
  timeSlider.addEventListener('input', calculate);

  document.querySelectorAll('input[name="af-pretreatment"]').forEach(r => {
    r.addEventListener('change', calculate);
  });

  document.querySelectorAll('input[name="af-doneness"]').forEach(r => {
    r.addEventListener('change', calculate);
  });

  // Preset Buttons
  presetBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const food = btn.dataset.food;
      const temp = btn.dataset.temp;
      const time = btn.dataset.time;
      const pretreat = btn.dataset.pretreat;
      const doneness = btn.dataset.doneness;

      if (food) foodSelect.value = food;
      if (temp) tempSlider.value = temp;
      if (time) timeSlider.value = time;
      if (pretreat) {
        const pt = document.querySelector(`input[name="af-pretreatment"][value="${pretreat}"]`);
        if (pt) pt.checked = true;
      }
      if (doneness) {
        const dn = document.querySelector(`input[name="af-doneness"][value="${doneness}"]`);
        if (dn) dn.checked = true;
      }
      calculate();
    });
  });

  // Clipboard Report Generation
  if (copyBtn) {
    copyBtn.addEventListener('click', () => {
      const food = data.foods.find(f => f.id === foodSelect.value) || data.foods[0];
      const pretreatRadio = document.querySelector('input[name="af-pretreatment"]:checked');
      const donenessRadio = document.querySelector('input[name="af-doneness"]:checked');
      const doneness = data.browningDonenessLevels.find(b => b.id === (donenessRadio ? donenessRadio.value : 'golden-yellow'));

      const reportText = `=====================================================
AIR FRYER ACRYLAMIDE & MAILLARD TOXICITY REPORT
IsItKitchenSafe Clinical Food Safety & Thermal Laboratory
=====================================================
Food Selected: ${food.name} (${food.category})
Operating Temperature: ${tempSlider.value}°F
Convection Duration: ${timeSlider.value} minutes
Pre-Treatment: ${pretreatRadio ? pretreatRadio.value : 'none'}
Target Browning: ${doneness ? doneness.name : 'Golden Yellow'}

DIAGNOSTIC TOXICOLOGICAL METRICS:
- Overall Verdict: ${verdictTitle.textContent.trim()}
- Estimated Acrylamide: ${metricAcrylamide.textContent.trim()} µg/kg (ppb)
- EU Benchmark Status: ${metricBenchmarkPercent.textContent.trim()} (${metricBenchmarkStatus.textContent.trim()})
- Dietary AGEs Index: ${metricAges.textContent.trim()} kU/100g
- Heterocyclic Amines: ${metricHca.textContent.trim()}
- Safe Cooking Guidance: ${food.safeTempRangeF}

ACTIONABLE MITIGATION PROTOCOL:
1. Soak raw potatoes in cold water for 25-30 min (-42% acrylamide).
2. Never store raw potatoes in the refrigerator (prevents cold-induced sweetening).
3. Aim for 'Golden Yellow' crust and discard charred black edges.
4. Keep air fryer temperature under 360°F (180°C).
=====================================================
Verified against EU Commission Regulation (EU) 2017/2158 & EFSA 2015.
Audit generated at: https://isitkitchensafe.com/tools/air-fryer-acrylamide-calculator/`;

      navigator.clipboard.writeText(reportText).then(() => {
        if (copyToast) {
          copyToast.classList.remove('hidden');
          setTimeout(() => {
            copyToast.classList.add('hidden');
          }, 4000);
        }
      });
    });
  }

  // Initial Calculation
  calculate();
})();
</script>
