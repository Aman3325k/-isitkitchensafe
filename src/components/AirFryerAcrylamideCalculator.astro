    foodSelectLabel: "食材マトリクスと生化学組成",
    tempLabel: "ノンフライヤー設定温度：",
    timeLabel: "熱風対流加熱時間：",
    preTreatmentLabel: "事前デンプン・還元糖溶出処理",
