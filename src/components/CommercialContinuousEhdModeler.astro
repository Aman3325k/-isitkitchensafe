    polarityHelp: "正極性DCコロナ (安定グロー放電)、負極性DCコロナ (Trichelパルス、風速+30%)、またはバイポーラパルスAC (静電気蓄積防止) を選択。",
    scrubberLabel: "触媒オゾン排気分解＆循環スクラバー：",
    scrubberHelp: "閉鎖循環式MnO2-CuOハニカム触媒分解装置、単流活性炭吸着床、または未処理開放排気を選択。",
    voltageLabel: "印加コロナ高電圧 (kV DC)：",
    voltageHelp: "放電電極と接地コンベアメッシュ間に印加する直流高電位 (15.0〜42.0 kV DC)。",
    standoffLabel: "放電電極-食品表面間隙距離 (mm)：",
    standoffHelp: "ワイヤー/針先端と接地食品表面間の垂直間隔 (15〜80 mm)。火花放電破壊を確実に回避。",
    tempLabel: "乾燥室管理環境温度 (°C)：",
    tempHelp: "制御された乾燥室の雰囲気温度 (15°C〜40°C)。熱変性を生じさせずに熱感受性分子を保護。",
    timeLabel: "コンベア脱水滞留時間 (分)：",
    timeHelp: "高圧イオン風プレナムチャンバー内での総通過乾燥時間 (15〜180 分)。",
    presetsTitle: "工業 EHD イオン風脱水プリセット条件",
    presetStrawberry: "生苺スライス高残存脱水 (多条ワイヤー, 28 kV, 30mm, 22°C, 45分, 正極性)",
    presetApple: "生リンゴ褐変抑制乾燥 (針状マトリクス, 32 kV, 35mm, 25°C, 60分, 負極性)",
    presetMushroom: "薬用椎茸グルカン活性保持 (多条ワイヤー, 26 kV, 40mm, 20°C, 90分, 正極性)",
    presetProbiotic: "生菌プロバイオティクス非加熱乾燥 (ブレード極, 22 kV, 25mm, 18°C, 40分, 正極性)",
    presetHazard: "火花放電・焦げ付損耗ハザード (劣化機組, 42 kV, 15mm, 35°C, 120分, オゾン漏洩)",
    diagnosticTitle: "電気流体力学風速＆生体活性成分保持診断",
    diagnosticSub: "コロナイオン風速、シャーウッド数 (Sherwood) 境界膜減薄率、水分蒸発加速比、アスコルビン酸保持率、比エネルギー消費量 (SEC)、および OSHA オゾン作業環境適合性をリアルタイム算出。",
    ionicWindLabel: "イオン風垂直気流速度 (m/s)",
    dryingRateLabel: "乾燥蒸発加速比 (対静止空気)",
    vitaminCRetentionLabel: "アスコルビン酸 (ビタミンC) 残存率 (%)",
    energyConsumptionLabel: "比エネルギー消費量 (MJ/kg H2O)",
    boundaryLayerLabel: "飽和蒸気境界層厚み減薄率 (%)",
    ozoneLevelLabel: "作業環境残留オゾン濃度 (ppm)",
    complianceStatusLabel: "FDA 21 CFR § 117 cGMP ＆ OSHA 1910.1000 適合状況",
    primaryLimitationLabel: "電気流体力学・温度制約要因",
    mitigationActionLabel: "推奨インラインプロセス改善策",
    diagramTitle: "高圧コロナイオン風脱水流体力学アーキテクチャ",
    diagramSub: "高圧放電金属線、タウンゼント電子雪崩電離層、垂直イオン風噴流、接地ステンレスメッシュベルト、および触媒オゾン分解装置の動的模式図。",
    scienceTitle: "電気流体力学、コロナ運動量移行＆非加熱成分保全メカニズム",
    scienceSub: "ピークの放電開始則 (Peek's law)、電場体積力運動量結合、層流境界膜乱流剥離、およびアレニウス非加熱反応速度論の工学的詳解。",
    tableTitle: "各種乾燥脱水技術と熱感受性活性成分保持率の比較"
  }
};

const d = DICT[lang] || DICT.en;
---

<section class="max-w-6xl mx-auto px-4 py-8 text-ink">
  <!-- Header Badge & Titles -->
  <div class="mb-8">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-teal-950 text-teal-200 border border-teal-800 mb-3 shadow-xs">
      <span class="w-2 h-2 rounded-full bg-teal-400 animate-pulse"></span>
      {d.badge}
    </div>
    <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold tracking-tight text-ink mb-3">
      {d.title}
    </h1>
    <p class="text-body text-base md:text-lg leading-relaxed text-muted max-w-5xl">
      {d.subtitle}
    </p>
  </div>

  <!-- Interactive Simulator Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mb-12">
    <!-- Controls Column (5 cols) -->
    <div class="lg:col-span-5 bg-surface-soft border border-hairline rounded-2xl p-6 shadow-sm space-y-6">
      <div class="border-b border-hairline pb-4">
        <h2 class="text-title-md font-bold text-ink tracking-tight flex items-center gap-2">
          <svg class="w-5 h-5 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path>
          </svg>
          {d.controlsTitle}
        </h2>
        <p class="text-xs text-muted mt-1 leading-normal">
          {d.controlsSub}
        </p>
      </div>

      <!-- Presets Selector -->
      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-muted mb-2">
          {d.presetsTitle}
        </label>
        <div class="grid grid-cols-1 gap-2">
          <button type="button" class="ehd-preset-btn text-left text-xs p-2.5 rounded-lg border border-hairline bg-surface hover:bg-teal-50 dark:hover:bg-teal-950/40 text-ink transition-colors font-medium" data-preset="strawberry">
            🍓 {d.presetStrawberry}
          </button>
          <button type="button" class="ehd-preset-btn text-left text-xs p-2.5 rounded-lg border border-hairline bg-surface hover:bg-teal-50 dark:hover:bg-teal-950/40 text-ink transition-colors font-medium" data-preset="apple">
            🍏 {d.presetApple}
          </button>
          <button type="button" class="ehd-preset-btn text-left text-xs p-2.5 rounded-lg border border-hairline bg-surface hover:bg-teal-50 dark:hover:bg-teal-950/40 text-ink transition-colors font-medium" data-preset="mushroom">
            🍄 {d.presetMushroom}
          </button>
          <button type="button" class="ehd-preset-btn text-left text-xs p-2.5 rounded-lg border border-hairline bg-surface hover:bg-teal-50 dark:hover:bg-teal-950/40 text-ink transition-colors font-medium" data-preset="probiotic">
            🦠 {d.presetProbiotic}
          </button>
          <button type="button" class="ehd-preset-btn text-left text-xs p-2.5 rounded-lg border border-red-300 dark:border-red-900 bg-red-50/50 dark:bg-red-950/20 hover:bg-red-100/60 dark:hover:bg-red-950/40 text-red-900 dark:text-red-200 transition-colors font-medium" data-preset="hazard">
            ⚡ {d.presetHazard}
          </button>
        </div>
      </div>

      <!-- Control Form -->
      <form id="ehd-calc-form" class="space-y-4 text-xs">
        <!-- EHD System -->
        <div>
          <label for="ehd-system-select" class="block font-semibold text-ink mb-1">
            {d.systemLabel}
          </label>
          <select id="ehd-system-select" class="w-full bg-surface border border-hairline rounded-lg p-2.5 text-ink text-xs focus:ring-2 focus:ring-teal-500">
            {ehdData.ehdSystems.map(sys => (
              <option value={sys.id} data-voltage={sys.operatingVoltageKv} data-power={sys.totalElectricPowerWatts} data-ozone={sys.ozoneEmissionRateMgPerHour}>
                {sys.name}
              </option>
            ))}
          </select>
          <p class="text-[11px] text-muted mt-1">{d.systemHelp}</p>
        </div>

        <!-- Food Substrate -->
        <div>
          <label for="ehd-substrate-select" class="block font-semibold text-ink mb-1">
            {d.substrateLabel}
          </label>
          <select id="ehd-substrate-select" class="w-full bg-surface border border-hairline rounded-lg p-2.5 text-ink text-xs focus:ring-2 focus:ring-teal-500">
            {ehdData.foodSubstrates.map(sub => (
              <option value={sub.id} data-moisture={sub.initialMoisturePercentWetBasis} data-ascorbic={sub.initialAscorbicAcidMgPer100g} data-retention={sub.ascorbicAcidRetentionEhdPercent} data-time={sub.ehdDryingTimeHours}>
                {sub.name}
              </option>
            ))}
          </select>
          <p class="text-[11px] text-muted mt-1">{d.substrateHelp}</p>
        </div>

        <!-- Discharge Polarity -->
        <div>
          <label for="ehd-polarity-select" class="block font-semibold text-ink mb-1">
            {d.polarityLabel}
          </label>
          <select id="ehd-polarity-select" class="w-full bg-surface border border-hairline rounded-lg p-2.5 text-ink text-xs focus:ring-2 focus:ring-teal-500">
            {ehdData.dischargePolarities.map(pol => (
              <option value={pol.id}>
                {pol.name}
              </option>
            ))}
          </select>
          <p class="text-[11px] text-muted mt-1">{d.polarityHelp}</p>
        </div>

        <!-- Scrubber Type -->
        <div>
          <label for="ehd-scrubber-select" class="block font-semibold text-ink mb-1">
            {d.scrubberLabel}
          </label>
          <select id="ehd-scrubber-select" class="w-full bg-surface border border-hairline rounded-lg p-2.5 text-ink text-xs focus:ring-2 focus:ring-teal-500">
            {ehdData.exhaustOzoneScrubbers.map(sc => (
              <option value={sc.id} data-efficiency={sc.ozoneRemovalEfficiencyPercent}>
                {sc.name}
              </option>
            ))}
          </select>
          <p class="text-[11px] text-muted mt-1">{d.scrubberHelp}</p>
        </div>

        <!-- Sliders: Applied Voltage -->
        <div class="space-y-1">
          <div class="flex justify-between font-semibold">
            <label for="ehd-voltage-slider">{d.voltageLabel}</label>
            <span id="ehd-voltage-val" class="font-mono text-teal-700 dark:text-teal-300">28.0 kV</span>
          </div>
          <input type="range" id="ehd-voltage-slider" min="15.0" max="42.0" step="0.5" value="28.0" class="w-full accent-teal-600 cursor-pointer" />
          <p class="text-[11px] text-muted">{d.voltageHelp}</p>
        </div>

        <!-- Sliders: Standoff Gap -->
        <div class="space-y-1">
          <div class="flex justify-between font-semibold">
            <label for="ehd-standoff-slider">{d.standoffLabel}</label>
            <span id="ehd-standoff-val" class="font-mono text-teal-700 dark:text-teal-300">30 mm</span>
          </div>
          <input type="range" id="ehd-standoff-slider" min="15" max="80" step="1" value="30" class="w-full accent-teal-600 cursor-pointer" />
          <p class="text-[11px] text-muted">{d.standoffHelp}</p>
        </div>

        <!-- Sliders: Temperature -->
        <div class="space-y-1">
          <div class="flex justify-between font-semibold">
            <label for="ehd-temp-slider">{d.tempLabel}</label>
            <span id="ehd-temp-val" class="font-mono text-teal-700 dark:text-teal-300">22°C</span>
          </div>
          <input type="range" id="ehd-temp-slider" min="15" max="40" step="1" value="22" class="w-full accent-teal-600 cursor-pointer" />
          <p class="text-[11px] text-muted">{d.tempHelp}</p>
        </div>

        <!-- Sliders: Residence Time -->
        <div class="space-y-1">
          <div class="flex justify-between font-semibold">
            <label for="ehd-time-slider">{d.timeLabel}</label>
            <span id="ehd-time-val" class="font-mono text-teal-700 dark:text-teal-300">45 min</span>
          </div>
          <input type="range" id="ehd-time-slider" min="15" max="180" step="5" value="45" class="w-full accent-teal-600 cursor-pointer" />
          <p class="text-[11px] text-muted">{d.timeHelp}</p>
        </div>
      </form>
    </div>

    <!-- Output & Diagnostics Column (7 cols) -->
    <div class="lg:col-span-7 space-y-6">
      <!-- Diagnostics Box -->
      <div class="bg-surface-soft border border-hairline rounded-2xl p-6 shadow-sm space-y-6">
        <div>
          <h2 class="text-title-md font-bold text-ink tracking-tight flex items-center gap-2">
            <svg class="w-5 h-5 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
            </svg>
            {d.diagnosticTitle}
          </h2>
          <p class="text-xs text-muted mt-1">
            {d.diagnosticSub}
          </p>
        </div>

        <!-- 6 Metrics Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
          <div class="bg-surface border border-hairline rounded-xl p-3 text-center">
            <div class="text-[11px] font-medium text-muted mb-1">{d.ionicWindLabel}</div>
            <div id="ehd-out-wind" class="text-lg md:text-xl font-bold font-mono text-teal-700 dark:text-teal-300">
              3.85 m/s
            </div>
          </div>
          <div class="bg-surface border border-hairline rounded-xl p-3 text-center">
            <div class="text-[11px] font-medium text-muted mb-1">{d.dryingRateLabel}</div>
            <div id="ehd-out-acceleration" class="text-lg md:text-xl font-bold font-mono text-ink">
              3.4x Faster
            </div>
          </div>
          <div class="bg-surface border border-hairline rounded-xl p-3 text-center">
            <div class="text-[11px] font-medium text-muted mb-1">{d.vitaminCRetentionLabel}</div>
            <div id="ehd-out-vitc" class="text-lg md:text-xl font-bold font-mono text-emerald-600 dark:text-emerald-400">
              96.4%
            </div>
          </div>
          <div class="bg-surface border border-hairline rounded-xl p-3 text-center">
            <div class="text-[11px] font-medium text-muted mb-1">{d.energyConsumptionLabel}</div>
            <div id="ehd-out-sec" class="text-lg md:text-xl font-bold font-mono text-ink">
              1.65 MJ/kg
            </div>
          </div>
          <div class="bg-surface border border-hairline rounded-xl p-3 text-center">
            <div class="text-[11px] font-medium text-muted mb-1">{d.boundaryLayerLabel}</div>
            <div id="ehd-out-boundary" class="text-lg md:text-xl font-bold font-mono text-ink">
              -68.5%
            </div>
          </div>
          <div class="bg-surface border border-hairline rounded-xl p-3 text-center">
            <div class="text-[11px] font-medium text-muted mb-1">{d.ozoneLevelLabel}</div>
            <div id="ehd-out-ozone" class="text-lg md:text-xl font-bold font-mono text-teal-700 dark:text-teal-300">
              0.012 ppm
            </div>
          </div>
        </div>

        <!-- Compliance & Engineering Status -->
        <div class="border-t border-hairline pt-4 space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold text-ink">{d.complianceStatusLabel}:</span>
            <span id="ehd-status-badge" class="px-3 py-1 rounded-full text-xs font-bold tracking-wide bg-emerald-100 text-emerald-800 dark:bg-emerald-950/80 dark:text-emerald-200 border border-emerald-300 dark:border-emerald-800">
              COMPLIANT / OPTIMAL EHD
            </span>
          </div>
          <div class="text-xs space-y-1.5 bg-surface border border-hairline rounded-xl p-3.5">
            <div class="flex flex-col sm:flex-row sm:justify-between gap-1">
              <span class="font-medium text-muted">{d.primaryLimitationLabel}:</span>
              <span id="ehd-limitation-text" class="text-ink font-medium">Boundary Layer Diffusion Limited (Sherwood Sh = 14.2)</span>
            </div>
            <div class="flex flex-col sm:flex-row sm:justify-between gap-1 pt-1.5 border-t border-hairline/60">
              <span class="font-medium text-muted">{d.mitigationActionLabel}:</span>
              <span id="ehd-mitigation-text" class="text-teal-700 dark:text-teal-300 font-medium">Maintain 28 kV at 30mm standoff with catalytic Hopcalite recirculation.</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Dynamic Interactive SVG Architecture Diagram -->
      <div class="bg-surface-soft border border-hairline rounded-2xl p-6 shadow-sm">
        <div class="mb-4">
          <h3 class="text-title-sm font-bold text-ink tracking-tight flex items-center gap-2">
            <svg class="w-4 h-4 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
            {d.diagramTitle}
          </h3>
          <p class="text-xs text-muted mt-0.5">
            {d.diagramSub}
          </p>
        </div>

        <div class="w-full bg-slate-950 rounded-xl p-4 overflow-hidden border border-slate-800">
          <svg viewBox="0 0 600 240" class="w-full h-auto" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="coronaGlow" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.9" />
                <stop offset="30%" stop-color="#2dd4bf" stop-opacity="0.6" />
                <stop offset="100%" stop-color="#0f172a" stop-opacity="0.1" />
              </linearGradient>
              <linearGradient id="windJet" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#2dd4bf" stop-opacity="0.8" />
                <stop offset="100%" stop-color="#0284c7" stop-opacity="0.2" />
              </linearGradient>
              <pattern id="conveyorGrid" width="10" height="10" patternUnits="userSpaceOnUse">
                <path d="M 10 0 L 0 0 0 10" fill="none" stroke="#475569" stroke-width="0.8" />
              </pattern>
            </defs>

            <!-- Background & Plenum Chamber -->
            <rect x="20" y="15" width="560" height="210" rx="8" fill="#090d16" stroke="#1e293b" stroke-width="1.5" />
            
            <!-- High-Voltage Bus Bar (Top) -->
            <rect x="50" y="30" width="400" height="10" rx="3" fill="#e2e8f0" stroke="#94a3b8" />
            <text x="250" y="24" fill="#38bdf8" font-size="10" font-weight="bold" text-anchor="middle" font-family="monospace">+28.0 kV DC High-Voltage Corona Bus</text>

            <!-- 5 Emitter Wires / Pins with Corona Glow Plumes -->
            <g id="svg-emitters">
              <!-- Pin 1 -->
              <line x1="90" y1="40" x2="90" y2="60" stroke="#f8fafc" stroke-width="2.5" />
              <polygon points="85,60 95,60 90,70" fill="#f8fafc" />
              <path d="M 70,70 L 110,70 L 125,160 L 55,160 Z" fill="url(#coronaGlow)" />
              <circle cx="90" cy="70" r="8" fill="#38bdf8" opacity="0.6" class="animate-pulse" />

              <!-- Pin 2 -->
              <line x1="170" y1="40" x2="170" y2="60" stroke="#f8fafc" stroke-width="2.5" />
              <polygon points="165,60 175,60 170,70" fill="#f8fafc" />
              <path d="M 150,70 L 190,70 L 205,160 L 135,160 Z" fill="url(#coronaGlow)" />
              <circle cx="170" cy="70" r="8" fill="#38bdf8" opacity="0.6" class="animate-pulse" />

              <!-- Pin 3 -->
              <line x1="250" y1="40" x2="250" y2="60" stroke="#f8fafc" stroke-width="2.5" />
              <polygon points="245,60 255,60 250,70" fill="#f8fafc" />
              <path d="M 230,70 L 270,70 L 285,160 L 215,160 Z" fill="url(#coronaGlow)" />
              <circle cx="250" cy="70" r="8" fill="#38bdf8" opacity="0.6" class="animate-pulse" />

              <!-- Pin 4 -->
              <line x1="330" y1="40" x2="330" y2="60" stroke="#f8fafc" stroke-width="2.5" />
              <polygon points="325,60 335,60 330,70" fill="#f8fafc" />
              <path d="M 310,70 L 350,70 L 365,160 L 295,160 Z" fill="url(#coronaGlow)" />
              <circle cx="330" cy="70" r="8" fill="#38bdf8" opacity="0.6" class="animate-pulse" />

              <!-- Pin 5 -->
              <line x1="410" y1="40" x2="410" y2="60" stroke="#f8fafc" stroke-width="2.5" />
              <polygon points="405,60 415,60 410,70" fill="#f8fafc" />
              <path d="M 390,70 L 430,70 L 445,160 L 375,160 Z" fill="url(#coronaGlow)" />
              <circle cx="410" cy="70" r="8" fill="#38bdf8" opacity="0.6" class="animate-pulse" />
            </g>

            <!-- Ionic Wind Streamlines -->
            <g stroke="#2dd4bf" stroke-width="1.2" stroke-dasharray="3,3" opacity="0.7">
              <line x1="90" y1="75" x2="90" y2="155" />
              <line x1="170" y1="75" x2="170" y2="155" />
              <line x1="250" y1="75" x2="250" y2="155" />
              <line x1="330" y1="75" x2="330" y2="155" />
              <line x1="410" y1="75" x2="410" y2="155" />
            </g>

            <!-- Standoff Gap Marker -->
            <line x1="445" y1="70" x2="445" y2="160" stroke="#fbbf24" stroke-width="1.5" />
            <polygon points="442,75 448,75 445,70" fill="#fbbf24" />
