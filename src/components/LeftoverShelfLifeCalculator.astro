const t = UI[lang] || UI.en;
const defaultFood = localizedFoods[0];
const clientPayload = JSON.stringify({
  lang,
  foods: localizedFoods,
  ui: t
});
---

<section
  id="leftover-shelf-life-calculator"
  class="rounded-2xl border border-hairline bg-canvas shadow-sm overflow-hidden"
  aria-label={t.dashboardBadge}
>
  <script type="application/json" id="lsl-payload" is:inline set:html={clientPayload} />

  <div class="grid grid-cols-1 lg:grid-cols-12">
    <!-- LEFT COLUMN: INTERACTIVE CONTROLS -->
    <div class="lg:col-span-6 p-5 sm:p-7 bg-surface-soft border-b lg:border-b-0 lg:border-r border-hairline space-y-6">
      <!-- STEP 1: FOOD SELECTION -->
      <div class="space-y-4">
        <div class="flex items-center justify-between gap-2">
          <h2 class="text-[15px] font-semibold text-ink tracking-tight">{t.step1Title}</h2>
          <button
            type="button"
            id="lsl-reset-btn"
            class="text-xs font-semibold text-muted hover:text-signature-coral transition-colors cursor-pointer"
          >
            {t.resetBtn}
          </button>
        </div>

        <!-- Quick Presets (Top 6 Queries) -->
        <div>
          <span class="text-[11px] font-bold uppercase tracking-wider text-muted block mb-2">
            {t.quickPresetsLabel}
          </span>
          <div class="flex flex-wrap gap-1.5">
            {quickPresets.map((preset) => (
              <button
                type="button"
                data-lsl-preset={preset.id}
                class={`lsl-preset-btn px-2.5 py-1.5 rounded-lg text-xs font-semibold border transition-all cursor-pointer ${
                  preset.id === defaultFood.id
                    ? 'bg-primary text-on-primary border-primary shadow-xs'
                    : 'bg-canvas text-ink border-hairline hover:border-signature-coral'
                }`}
              >
                {preset.name.split('(')[0].trim()}
              </button>
            ))}
          </div>
        </div>

        <!-- Category Tabs -->
        <div class="flex flex-wrap gap-1.5" role="tablist" aria-label="Food Categories">
          {(['all', 'poultry-meat', 'seafood', 'cooked-leftovers', 'dairy-eggs', 'produce-bakery'] as CategoryKey[]).map((cat) => (
            <button
              type="button"
              role="tab"
              aria-selected={cat === 'all' ? 'true' : 'false'}
              data-lsl-cat={cat}
              class={`lsl-cat-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold border transition-all cursor-pointer ${
                cat === 'all'
                  ? 'bg-signature-coral text-white border-signature-coral'
                  : 'bg-canvas text-body border-hairline hover:border-border-strong'
              }`}
            >
              <span>{t.categories[cat]}</span>
              <span class={`px-1.5 py-0.2 rounded-full text-[10px] font-bold ${cat === 'all' ? 'bg-white/20 text-white' : 'bg-surface-soft text-muted'}`}>
                {categoryCounts[cat]}
              </span>
            </button>
          ))}
        </div>

        <!-- Search + Select Dropdown -->
        <div class="space-y-2.5">
          <div class="relative">
            <svg
              class="w-4 h-4 text-muted absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <circle cx="11" cy="11" r="8" />
              <path d="m21 21-4.3-4.3" />
            </svg>
            <input
              id="lsl-search-input"
              type="search"
              placeholder={t.searchPlaceholder}
              aria-label={t.searchAria}
              class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-canvas border border-hairline text-ink text-sm placeholder:text-muted/70 focus:outline-none focus:ring-2 focus:ring-signature-coral/40 focus:border-signature-coral transition-all"
            />
          </div>

          <div>
            <label for="lsl-food-select" class="block text-xs font-semibold text-muted mb-1">
              {t.selectFoodLabel}
            </label>
            <select
              id="lsl-food-select"
              class="w-full px-3.5 py-2.5 rounded-xl bg-canvas border border-hairline text-ink text-sm font-medium focus:outline-none focus:ring-2 focus:ring-signature-coral/40 focus:border-signature-coral cursor-pointer"
            >
              {localizedFoods.map((food) => (
                <option value={food.id} selected={food.id === defaultFood.id}>
                  {food.name} ({food.fridgeDaysMin}–{food.fridgeDaysMax}{t.units.days} {t.units.fridgeShort})
                </option>
              ))}
            </select>
          </div>
        </div>
      </div>

      <hr class="border-hairline" />

      <!-- STEP 2: STORAGE & TIME CONDITIONS -->
      <div class="space-y-5">
        <h2 class="text-[15px] font-semibold text-ink tracking-tight">{t.step2Title}</h2>

        <!-- Storage Location Cards -->
        <div>
          <span class="block text-xs font-semibold text-muted mb-2">{t.storageLabel}</span>
          <div class="grid grid-cols-3 gap-2">
            <button
              type="button"
              data-lsl-storage="fridge"
              aria-pressed="true"
              class="lsl-storage-btn p-3 rounded-xl border text-left transition-all cursor-pointer bg-primary text-on-primary border-primary shadow-xs"
            >
              <div class="text-lg leading-none mb-1" aria-hidden="true">🧊</div>
              <div class="text-xs font-bold leading-tight">{t.storageOptions.fridge.title}</div>
              <div class="text-[10.5px] opacity-80 mt-0.5">{t.storageOptions.fridge.sub}</div>
            </button>
            <button
              type="button"
              data-lsl-storage="freezer"
              aria-pressed="false"
              class="lsl-storage-btn p-3 rounded-xl border text-left transition-all cursor-pointer bg-canvas text-ink border-hairline hover:border-signature-coral"
            >
              <div class="text-lg leading-none mb-1" aria-hidden="true">❄️</div>
              <div class="text-xs font-bold leading-tight">{t.storageOptions.freezer.title}</div>
              <div class="text-[10.5px] text-muted mt-0.5">{t.storageOptions.freezer.sub}</div>
            </button>
            <button
              type="button"
              data-lsl-storage="counter"
              aria-pressed="false"
              class="lsl-storage-btn p-3 rounded-xl border text-left transition-all cursor-pointer bg-canvas text-ink border-hairline hover:border-signature-coral"
            >
              <div class="text-lg leading-none mb-1" aria-hidden="true">🍽️</div>
              <div class="text-xs font-bold leading-tight">{t.storageOptions.counter.title}</div>
              <div class="text-[10.5px] text-muted mt-0.5">{t.storageOptions.counter.sub}</div>
            </button>
          </div>
        </div>

        <!-- When Cooked / Opened -->
        <div class="p-4 rounded-xl bg-canvas border border-hairline space-y-3">
          <div class="flex items-center justify-between gap-2">
            <label for="lsl-age-slider" class="text-xs font-semibold text-ink">
              {t.whenCookedLabel}
            </label>
            <span id="lsl-age-readout" class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-surface-soft border border-hairline text-ink">
              {t.units.yesterday}
            </span>
          </div>

          <!-- Quick Age Chips -->
          <div id="lsl-age-chips" class="flex flex-wrap gap-1.5">
            {t.ageChips.map((chip) => (
              <button
                type="button"
                data-lsl-age={chip.days}
                class={`lsl-age-chip px-2.5 py-1 rounded-lg text-xs font-semibold border transition-all cursor-pointer ${
                  chip.days === 1
                    ? 'bg-primary text-on-primary border-primary'
                    : 'bg-surface-soft text-body border-hairline hover:border-signature-coral'
                }`}
              >
                {chip.label}
              </button>
            ))}
          </div>

          <input
            id="lsl-age-slider"
            type="range"
            min="0"
            max="10"
            step="0.5"
            value="1"
            class="w-full accent-signature-coral cursor-pointer"
          />
          <div class="flex justify-between text-[11px] text-muted font-medium">
            <span id="lsl-age-min-label">0 {t.units.days}</span>
            <span id="lsl-age-mid-label">5 {t.units.days}</span>
            <span id="lsl-age-max-label">10 {t.units.days}</span>
          </div>
        </div>

        <!-- Room Temperature Exposure + >90°F Rule -->
        <div class="p-4 rounded-xl bg-canvas border border-hairline space-y-3">
          <div class="flex items-center justify-between gap-2">
            <label for="lsl-room-slider" class="text-xs font-semibold text-ink">
              {t.roomTempLabel}
            </label>
            <span id="lsl-room-readout" class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-surface-soft border border-hairline text-ink">
              0.5 {t.units.hours}
            </span>
          </div>

          <input
            id="lsl-room-slider"
            type="range"
            min="0"
            max="4.5"
            step="0.5"
            value="0.5"
            class="w-full accent-signature-coral cursor-pointer"
          />
          <div class="flex justify-between text-[11px] text-muted font-medium">
            <span>0 {t.units.hours}</span>
            <span class="text-warning font-semibold">1 {t.units.hour}</span>
            <span class="text-error font-semibold">2 {t.units.hours}</span>
            <span>3 {t.units.hours}</span>
            <span>{t.units.hoursPlus}</span>
          </div>
          <p class="text-[11.5px] text-muted">{t.roomTempHint}</p>

          <!-- >90°F / 32°C Checkbox -->
          <label class="flex items-start gap-2.5 p-2.5 rounded-lg bg-surface-soft border border-hairline cursor-pointer hover:border-signature-coral transition-colors">
            <input
              id="lsl-hot-checkbox"
              type="checkbox"
              class="mt-0.5 w-4 h-4 rounded accent-signature-coral cursor-pointer shrink-0"
            />
            <span class="text-xs leading-snug">
              <strong class="text-ink block">{t.above90Label}</strong>
              <span class="text-muted text-[11px]">{t.above90Hint}</span>
            </span>
          </label>
        </div>
      </div>
    </div>

    <!-- RIGHT COLUMN: LIVE VERDICT & COUNTDOWN DASHBOARD -->
    <div id="lsl-dashboard" class="lg:col-span-6 p-5 sm:p-7 bg-canvas flex flex-col justify-between space-y-5">
      <div class="space-y-5">
        <!-- Prominent Verdict Banner -->
        <div
          id="lsl-verdict-banner"
          class="p-5 rounded-2xl border-2 bg-emerald-50 dark:bg-emerald-950/40 border-emerald-500 transition-colors"
          role="status"
          aria-live="polite"
        >
          <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
            <span class="text-[10.5px] font-bold uppercase tracking-wider text-muted">
              {t.dashboardBadge}
            </span>
            <span
              id="lsl-verdict-pill"
              class="inline-flex items-center px-3 py-1 rounded-full text-xs font-extrabold tracking-wide bg-emerald-600 text-white"
            >
              {t.verdicts.safe.badge}
            </span>
          </div>

          <h3 id="lsl-verdict-food" class="text-xl sm:text-2xl font-semibold text-ink leading-tight mb-1">
            {defaultFood.name}
          </h3>
          <p id="lsl-verdict-reason" class="text-[13.5px] text-body leading-relaxed">
            {t.reasons.fridgeSafe
              .replace('{min}', String(defaultFood.fridgeDaysMin))
              .replace('{max}', String(defaultFood.fridgeDaysMax))}
          </p>
        </div>

        <!-- Safe Until & Live Countdown Row -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
            <div class="text-[11px] font-bold uppercase tracking-wider text-muted mb-1">
              {t.safeUntilLabel}
            </div>
            <div id="lsl-safe-until" class="text-[15px] font-bold text-ink leading-snug">
              —
            </div>
          </div>
          <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
            <div class="text-[11px] font-bold uppercase tracking-wider text-muted mb-1">
              {t.timeRemainingLabel}
            </div>
            <div id="lsl-countdown" class="text-[15px] font-bold text-ink leading-snug tabular-nums">
              —
            </div>
          </div>
        </div>

        <!-- Visual Shelf-Life Elapsed Bar -->
        <div class="space-y-1.5">
          <div class="flex items-center justify-between text-xs">
            <span class="font-semibold text-muted">{t.gaugeLabel}</span>
            <span id="lsl-gauge-pct" class="font-bold text-ink tabular-nums">25%</span>
          </div>
          <div class="w-full h-2.5 rounded-full bg-surface-strong overflow-hidden">
            <div
              id="lsl-gauge-fill"
              class="h-full rounded-full bg-emerald-500 transition-all duration-300"
              style="width: 25%"
            />
          </div>
        </div>

        <!-- 4 Key Safety Metric Cards -->
        <div class="grid grid-cols-2 gap-3">
          <div class="p-3.5 rounded-xl bg-surface-soft border border-hairline">
            <div class="text-[11px] font-bold uppercase tracking-wider text-muted mb-1">
              {t.metrics.reheatTitle}
            </div>
            <div id="lsl-reheat-val" class="text-sm font-bold text-ink">
              {defaultFood.reheatTempF}°F / {defaultFood.reheatTempC}°C
            </div>
          </div>
          <div class="p-3.5 rounded-xl bg-surface-soft border border-hairline">
            <div class="text-[11px] font-bold uppercase tracking-wider text-muted mb-1">
              {t.metrics.freezerTitle}
            </div>
            <div id="lsl-freezer-val" class="text-sm font-bold text-ink">
              {defaultFood.freezerMonths} {t.units.months}
            </div>
          </div>
          <div class="p-3.5 rounded-xl bg-surface-soft border border-hairline">
            <div class="text-[11px] font-bold uppercase tracking-wider text-muted mb-1">
              {t.metrics.fridgeWindowTitle}
            </div>
            <div id="lsl-fridge-val" class="text-sm font-bold text-ink">
              {defaultFood.fridgeDaysMin}–{defaultFood.fridgeDaysMax} {t.units.days}
            </div>
          </div>
          <div class="p-3.5 rounded-xl bg-surface-soft border border-hairline">
            <div class="text-[11px] font-bold uppercase tracking-wider text-muted mb-1">
              {t.metrics.dangerZoneTitle}
            </div>
            <div id="lsl-danger-val" class="text-sm font-bold text-ink">
              {t.units.standardRule}
            </div>
          </div>
        </div>

        <!-- Primary Pathogen Risk -->
        <div class="p-4 rounded-xl bg-warning-bg border border-warning-border/60 space-y-1">
          <div class="text-[11px] font-bold uppercase tracking-wider text-warning">
            🦠 {t.pathogenHeading}
          </div>
          <p id="lsl-pathogen-val" class="text-[13.5px] font-semibold text-ink leading-snug">
            {defaultFood.keyPathogenRisk}
          </p>
        </div>

        <!-- Refreeze Guidance -->
        <div class="p-4 rounded-xl bg-surface-soft border border-hairline space-y-1">
          <div class="text-[11px] font-bold uppercase tracking-wider text-muted">
            ❄️ {t.metrics.refreezeTitle}
          </div>
          <p id="lsl-refreeze-val" class="text-[13px] text-body leading-relaxed">
            {defaultFood.canRefreeze}
          </p>
        </div>

        <!-- Interactive Spoilage Checklist -->
        <div class="p-4 rounded-xl bg-surface-soft border border-hairline space-y-2.5">
          <div>
            <div class="text-[11px] font-bold uppercase tracking-wider text-ink">
              👃 {t.spoilageHeading}
            </div>
            <p class="text-[11.5px] text-muted mt-0.5">{t.spoilageSub}</p>
          </div>
          <div id="lsl-spoilage-list" class="space-y-1.5">
            {defaultFood.spoilageSigns.map((sign) => (
              <label class="flex items-start gap-2 text-[13px] text-body cursor-pointer">
                <input type="checkbox" class="lsl-spoilage-chk mt-0.5 w-4 h-4 rounded accent-error cursor-pointer shrink-0" />
                <span>{sign}</span>
              </label>
            ))}
          </div>
        </div>

        <!-- Storage Best Practice -->
        <div class="p-4 rounded-xl bg-surface-soft border border-hairline space-y-1">
          <div class="text-[11px] font-bold uppercase tracking-wider text-signature-coral">
            💡 {t.storageTipHeading}
          </div>
          <p id="lsl-tip-val" class="text-[13px] text-body leading-relaxed">
            {defaultFood.storageTip}
          </p>
        </div>
      </div>

      <!-- Action Footer -->
      <div class="pt-4 border-t border-hairline flex flex-wrap items-center justify-between gap-2.5">
        <a
          id="lsl-hub-link"
          href={defaultFood.relatedHub}
          class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl text-xs font-bold bg-primary text-on-primary hover:bg-primary-active transition-colors"
        >
          <span>{t.readHubBtn}</span>
          <span aria-hidden="true">&rarr;</span>
        </a>

        <button
          type="button"
          id="lsl-copy-btn"
          class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl text-xs font-semibold bg-surface-soft border border-hairline text-ink hover:border-signature-coral transition-colors cursor-pointer"
        >
          <span id="lsl-copy-label">{t.copyBtn}</span>
        </button>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const payloadEl = document.getElementById('lsl-payload');
    if (!payloadEl) return;

    let payload;
    try {
      payload = JSON.parse(payloadEl.textContent || '{}');
    } catch (_) {
      return;
    }

    const foods = payload.foods || [];
    const ui = payload.ui || {};
    const byId = new Map(foods.map((f) => [f.id, f]));
    if (!foods.length) return;

    const searchInput = document.getElementById('lsl-search-input');
    const foodSelect = document.getElementById('lsl-food-select');
    const ageSlider = document.getElementById('lsl-age-slider');
    const ageReadout = document.getElementById('lsl-age-readout');
    const ageChipsWrap = document.getElementById('lsl-age-chips');
    const ageMinLabel = document.getElementById('lsl-age-min-label');
    const ageMidLabel = document.getElementById('lsl-age-mid-label');
    const ageMaxLabel = document.getElementById('lsl-age-max-label');
    const roomSlider = document.getElementById('lsl-room-slider');
    const roomReadout = document.getElementById('lsl-room-readout');
    const hotCheckbox = document.getElementById('lsl-hot-checkbox');
    const resetBtn = document.getElementById('lsl-reset-btn');
    const copyBtn = document.getElementById('lsl-copy-btn');
    const copyLabel = document.getElementById('lsl-copy-label');

    const catButtons = Array.from(document.querySelectorAll('.lsl-cat-btn'));
    const presetButtons = Array.from(document.querySelectorAll('.lsl-preset-btn'));
    const storageButtons = Array.from(document.querySelectorAll('.lsl-storage-btn'));

    const verdictBanner = document.getElementById('lsl-verdict-banner');
    const verdictPill = document.getElementById('lsl-verdict-pill');
    const verdictFood = document.getElementById('lsl-verdict-food');
    const verdictReason = document.getElementById('lsl-verdict-reason');
    const safeUntilEl = document.getElementById('lsl-safe-until');
    const countdownEl = document.getElementById('lsl-countdown');
    const gaugePctEl = document.getElementById('lsl-gauge-pct');
    const gaugeFillEl = document.getElementById('lsl-gauge-fill');
    const reheatValEl = document.getElementById('lsl-reheat-val');
    const freezerValEl = document.getElementById('lsl-freezer-val');
    const fridgeValEl = document.getElementById('lsl-fridge-val');
    const dangerValEl = document.getElementById('lsl-danger-val');
    const pathogenValEl = document.getElementById('lsl-pathogen-val');
    const refreezeValEl = document.getElementById('lsl-refreeze-val');
    const spoilageListEl = document.getElementById('lsl-spoilage-list');
    const tipValEl = document.getElementById('lsl-tip-val');
    const hubLinkEl = document.getElementById('lsl-hub-link');

    let state = {
      category: 'all',
      search: '',
      foodId: foods[0].id,
      storage: 'fridge',
      ageDays: 1,
      roomHours: 0.5,
      above90F: false,
      spoilageChecked: false
    };

    function normalizeText(str) {
      return (str || '')
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '');
    }

    function formatDate(dateObj) {
      try {
        return new Intl.DateTimeFormat(ui.localeCode || 'en-US', {
          weekday: 'short',
          month: 'short',
          day: 'numeric',
          hour: 'numeric',
          minute: '2-digit'
        }).format(dateObj);
      } catch (_) {
        return dateObj.toLocaleString();
      }
    }

    function formatDayOnly(dateObj) {
      try {
        return new Intl.DateTimeFormat(ui.localeCode || 'en-US', {
          month: 'short',
          day: 'numeric',
          year: 'numeric'
        }).format(dateObj);
      } catch (_) {
        return dateObj.toLocaleDateString();
      }
    }

    function formatDurationMs(ms) {
      const absMs = Math.abs(ms);
      const totalMins = Math.round(absMs / 60000);
      const days = Math.floor(totalMins / 1440);
      const hours = Math.floor((totalMins % 1440) / 60);
      const mins = totalMins % 60;
      const u = ui.units;
      const parts = [];
      if (days > 0) parts.push(`${days} ${days === 1 ? u.day : u.days}`);
      if (hours > 0) parts.push(`${hours} ${hours === 1 ? u.hour : u.hours}`);
      if (days === 0 && mins > 0) parts.push(`${mins} ${mins === 1 ? u.min : u.mins}`);
      if (!parts.length) parts.push(`0 ${u.mins}`);
      return parts.join(' ');
    }

    function formatAgeReadout(daysVal) {
      const u = ui.units;
      if (daysVal === 0) return u.today;
      if (daysVal === 1) return u.yesterday;
      if (daysVal >= 30 && daysVal % 30 === 0) {
        const mo = daysVal / 30;
        return `${mo} ${mo === 1 ? u.month : u.months} ${u.agoSuffix}`;
      }
      const dLabel = daysVal === 1 ? u.day : u.days;
      return `${daysVal} ${dLabel} ${u.agoSuffix}`;
    }

    function rebuildFoodOptions() {
      const q = normalizeText(state.search.trim());
      const filtered = foods.filter((f) => {
        const catOk = state.category === 'all' || f.category === state.category;
        const qOk = !q || normalizeText(f.searchText).includes(q);
        return catOk && qOk;
      });

      if (!foodSelect) return;
      foodSelect.innerHTML = '';

      if (!filtered.length) {
        const opt = document.createElement('option');
        opt.value = '';
        opt.textContent = ui.noMatchOption || 'No match';
        opt.disabled = true;
        foodSelect.appendChild(opt);
        return;
      }

      const stillExists = filtered.some((f) => f.id === state.foodId);
      if (!stillExists) {
        state.foodId = filtered[0].id;
        rebuildSpoilageChecklist();
      }

      filtered.forEach((f) => {
        const opt = document.createElement('option');
        opt.value = f.id;
        opt.textContent = `${f.name} (${f.fridgeDaysMin}–${f.fridgeDaysMax}${ui.units.days} ${ui.units.fridgeShort})`;
        if (f.id === state.foodId) opt.selected = true;
        foodSelect.appendChild(opt);
      });
    }

    function rebuildAgeChipsAndSlider() {
      const food = byId.get(state.foodId) || foods[0];
      const isFreezer = state.storage === 'freezer';
      const chips = isFreezer ? ui.freezerChips : ui.ageChips;
      const maxDays = isFreezer ? Math.max(180, (food.freezerMonths || 6) * 30 + 30) : Math.max(10, food.fridgeDaysMax + 4);
      const stepVal = isFreezer ? 1 : 0.5;

      if (ageSlider) {
        ageSlider.max = String(maxDays);
        ageSlider.step = String(stepVal);
        if (state.ageDays > maxDays) state.ageDays = maxDays;
        ageSlider.value = String(state.ageDays);
      }

      if (ageMinLabel) ageMinLabel.textContent = `0 ${ui.units.days}`;
      if (ageMidLabel) ageMidLabel.textContent = `${Math.round(maxDays / 2)} ${ui.units.days}`;
      if (ageMaxLabel) ageMaxLabel.textContent = `${maxDays} ${ui.units.days}`;

      if (ageChipsWrap) {
        ageChipsWrap.innerHTML = '';
        chips.forEach((chip) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.setAttribute('data-lsl-age', String(chip.days));
          const isAct = state.ageDays === chip.days;
          btn.className = isAct
            ? 'lsl-age-chip px-2.5 py-1 rounded-lg text-xs font-semibold border transition-all cursor-pointer bg-primary text-on-primary border-primary'
            : 'lsl-age-chip px-2.5 py-1 rounded-lg text-xs font-semibold border transition-all cursor-pointer bg-surface-soft text-body border-hairline hover:border-signature-coral';
          btn.textContent = chip.label;
          btn.addEventListener('click', () => {
            state.ageDays = chip.days;
            if (ageSlider) ageSlider.value = String(chip.days);
            updateAgeChipHighlight();
            computeAndRender();
          });
          ageChipsWrap.appendChild(btn);
        });
      }
    }

    function updateAgeChipHighlight() {
      if (!ageChipsWrap) return;
      Array.from(ageChipsWrap.querySelectorAll('.lsl-age-chip')).forEach((btn) => {
        const val = parseFloat(btn.getAttribute('data-lsl-age') || '-1');
        const isAct = val === state.ageDays;
        if (isAct) {
          btn.classList.add('bg-primary', 'text-on-primary', 'border-primary');
          btn.classList.remove('bg-surface-soft', 'text-body', 'border-hairline');
        } else {
          btn.classList.remove('bg-primary', 'text-on-primary', 'border-primary');
          btn.classList.add('bg-surface-soft', 'text-body', 'border-hairline');
        }
      });
    }

    function rebuildSpoilageChecklist() {
      const food = byId.get(state.foodId) || foods[0];
      state.spoilageChecked = false;
      if (!spoilageListEl) return;
      spoilageListEl.innerHTML = '';
      (food.spoilageSigns || []).forEach((sign) => {
        const label = document.createElement('label');
        label.className = 'flex items-start gap-2 text-[13px] text-body cursor-pointer';
        const input = document.createElement('input');
        input.type = 'checkbox';
        input.className = 'lsl-spoilage-chk mt-0.5 w-4 h-4 rounded accent-error cursor-pointer shrink-0';
        input.addEventListener('change', () => {
          const allChks = Array.from(spoilageListEl.querySelectorAll('.lsl-spoilage-chk'));
          state.spoilageChecked = allChks.some((el) => el.checked);
          computeAndRender();
        });
        const span = document.createElement('span');
        span.textContent = sign;
        label.appendChild(input);
        label.appendChild(span);
        spoilageListEl.appendChild(label);
      });
    }

    function updatePresetButtons() {
      presetButtons.forEach((btn) => {
        const isAct = btn.getAttribute('data-lsl-preset') === state.foodId;
        if (isAct) {
          btn.classList.add('bg-primary', 'text-on-primary', 'border-primary', 'shadow-xs');
          btn.classList.remove('bg-canvas', 'text-ink', 'border-hairline');
        } else {
          btn.classList.remove('bg-primary', 'text-on-primary', 'border-primary', 'shadow-xs');
          btn.classList.add('bg-canvas', 'text-ink', 'border-hairline');
        }
      });
    }

    function updateStorageButtons() {
      storageButtons.forEach((btn) => {
        const isAct = btn.getAttribute('data-lsl-storage') === state.storage;
        btn.setAttribute('aria-pressed', isAct ? 'true' : 'false');
        const subEl = btn.querySelector('div:last-child');
        if (isAct) {
          btn.classList.add('bg-primary', 'text-on-primary', 'border-primary', 'shadow-xs');
          btn.classList.remove('bg-canvas', 'text-ink', 'border-hairline');
          if (subEl) {
            subEl.classList.add('opacity-80');
            subEl.classList.remove('text-muted');
          }
        } else {
          btn.classList.remove('bg-primary', 'text-on-primary', 'border-primary', 'shadow-xs');
          btn.classList.add('bg-canvas', 'text-ink', 'border-hairline');
          if (subEl) {
            subEl.classList.remove('opacity-80');
            subEl.classList.add('text-muted');
          }
        }
      });
    }

    function applyBannerTheme(level) {
      if (!verdictBanner || !verdictPill || !gaugeFillEl) return;
      verdictBanner.className = 'p-5 rounded-2xl border-2 transition-colors ';
      verdictPill.className = 'inline-flex items-center px-3 py-1 rounded-full text-xs font-extrabold tracking-wide ';
      gaugeFillEl.className = 'h-full rounded-full transition-all duration-300 ';

      if (level === 'discard') {
        verdictBanner.className += 'bg-red-50 dark:bg-red-950/40 border-red-600';
        verdictPill.className += 'bg-red-600 text-white';
        gaugeFillEl.className += 'bg-red-600';
      } else if (level === 'warn') {
        verdictBanner.className += 'bg-amber-50 dark:bg-amber-950/40 border-amber-500';
        verdictPill.className += 'bg-amber-500 text-slate-950';
        gaugeFillEl.className += 'bg-amber-500';
      } else {
        verdictBanner.className += 'bg-emerald-50 dark:bg-emerald-950/40 border-emerald-500';
        verdictPill.className += 'bg-emerald-600 text-white';
        gaugeFillEl.className += 'bg-emerald-500';
      }
    }

    let lastVerdictSummary = '';

    function computeAndRender() {
      const food = byId.get(state.foodId) || foods[0];
      if (!food) return;

      // Update readouts
      if (ageReadout) ageReadout.textContent = formatAgeReadout(state.ageDays);
      if (roomReadout) {
        roomReadout.textContent = state.roomHours >= 4.5
          ? ui.units.hoursPlus
          : `${state.roomHours} ${state.roomHours === 1 ? ui.units.hour : ui.units.hours}`;
      }

      // Danger Zone effective limit
      const baseCounterHrs = food.counterMaxHours || 2;
      const effectiveCounterLimit = baseCounterHrs <= 2
        ? (state.above90F ? 1 : baseCounterHrs)
        : (state.above90F ? Math.round(baseCounterHrs / 2) : baseCounterHrs);

      const effectiveRoomHrs = state.storage === 'counter'
        ? Math.max(state.roomHours, state.ageDays * 24)
        : state.roomHours;

      const nowMs = Date.now();
      let level = 'safe';
      let reason = '';
      let safeUntilText = '—';
      let countdownText = '—';
      let pct = 0;

      if (state.spoilageChecked) {
        level = 'discard';
        reason = ui.reasons.spoilageDetected;
        safeUntilText = ui.expiredText;
        countdownText = ui.expiredText;
        pct = 100;
      } else if (effectiveRoomHrs > effectiveCounterLimit) {
        level = 'discard';
        reason = ui.reasons.dangerZoneBreach.replace('{limit}', String(effectiveCounterLimit));
        safeUntilText = ui.expiredText;
        const overMs = (effectiveRoomHrs - effectiveCounterLimit) * 3600000;
        countdownText = `${formatDurationMs(overMs)} ${ui.units.overSuffix}`;
        pct = 100;
      } else if (state.storage === 'counter') {
        const remHrs = Math.max(0, effectiveCounterLimit - effectiveRoomHrs);
        const remMs = remHrs * 3600000;
        pct = Math.min(100, Math.round((effectiveRoomHrs / effectiveCounterLimit) * 100));
        const deadline = new Date(nowMs + remMs);
        safeUntilText = formatDate(deadline);
        countdownText = `${formatDurationMs(remMs)} ${ui.units.leftSuffix}`;

        if (remHrs <= (effectiveCounterLimit <= 2 ? 0.5 : 6)) {
          level = 'warn';
          reason = ui.reasons.counterLimitNear.replace('{limit}', String(effectiveCounterLimit));
        } else {
          level = 'safe';
          reason = ui.reasons.counterSafe.replace('{limit}', String(effectiveCounterLimit));
        }
      } else if (state.storage === 'fridge') {
        const maxDays = food.fridgeDaysMax;
        const minDays = food.fridgeDaysMin;
        const remDays = maxDays - state.ageDays;
        pct = Math.min(100, Math.max(0, Math.round((state.ageDays / maxDays) * 100)));

        if (state.ageDays > maxDays) {
          level = 'discard';
          reason = ui.reasons.fridgeExpired.replace('{max}', String(maxDays));
          safeUntilText = ui.expiredText;
          countdownText = `${formatDurationMs((state.ageDays - maxDays) * 86400000)} ${ui.units.overSuffix}`;
          pct = 100;
        } else {
          const remMs = remDays * 86400000;
          const deadline = new Date(nowMs + remMs);
          safeUntilText = formatDate(deadline);
          countdownText = remDays === 0
            ? ui.verdicts.warn.badge
            : `${formatDurationMs(remMs)} ${ui.units.leftSuffix}`;

          if (remDays <= 1 || state.ageDays >= minDays) {
            level = 'warn';
            reason = ui.reasons.fridgeFinalWindow
              .replace('{min}', String(minDays))
              .replace('{max}', String(maxDays));
          } else {
            level = 'safe';
            reason = ui.reasons.fridgeSafe
              .replace('{min}', String(minDays))
              .replace('{max}', String(maxDays));
          }
        }
      } else {
        // Freezer mode (0°F / -18°C)
        const freezerDays = (food.freezerMonths || 0) * 30;
        if (!food.freezerMonths || food.freezerMonths === 0) {
          level = 'warn';
          reason = ui.reasons.freezerNotRecommended;
          safeUntilText = ui.metrics.freezerNo;
          countdownText = ui.indefiniteSafeText;
          pct = 100;
        } else {
          pct = Math.min(100, Math.max(0, Math.round((state.ageDays / freezerDays) * 100)));
          const remDays = freezerDays - state.ageDays;
          if (state.ageDays > freezerDays) {
            level = 'warn';
            reason = ui.reasons.freezerPastQuality.replace('{months}', String(food.freezerMonths));
            safeUntilText = ui.indefiniteSafeText;
            countdownText = `${formatDurationMs((state.ageDays - freezerDays) * 86400000)} ${ui.units.overSuffix}`;
          } else {
            level = 'safe';
            reason = ui.reasons.freezerSafe.replace('{months}', String(food.freezerMonths));
            const deadline = new Date(nowMs + remDays * 86400000);
            safeUntilText = `${ui.qualityUntilPrefix} ${formatDayOnly(deadline)}`;
            countdownText = `${formatDurationMs(remDays * 86400000)} ${ui.units.leftSuffix}`;
          }
        }
      }

      applyBannerTheme(level);
      if (verdictPill) verdictPill.textContent = ui.verdicts[level].badge;
      if (verdictFood) verdictFood.textContent = food.name;
      if (verdictReason) verdictReason.textContent = reason;
      if (safeUntilEl) safeUntilEl.textContent = safeUntilText;
      if (countdownEl) countdownEl.textContent = countdownText;
      if (gaugePctEl) gaugePctEl.textContent = `${pct}%`;
      if (gaugeFillEl) gaugeFillEl.style.width = `${pct}%`;

      if (reheatValEl) {
        reheatValEl.textContent = food.reheatTempF > 0
          ? `${food.reheatTempF}°F / ${food.reheatTempC}°C`
          : ui.metrics.reheatCold;
      }
      if (freezerValEl) {
        freezerValEl.textContent = food.freezerMonths > 0
          ? `${food.freezerMonths} ${food.freezerMonths === 1 ? ui.units.month : ui.units.months}`
          : ui.metrics.freezerNo;
      }
      if (fridgeValEl) {
        fridgeValEl.textContent = `${food.fridgeDaysMin}–${food.fridgeDaysMax} ${ui.units.days}`;
      }
      if (dangerValEl) {
        if (baseCounterHrs > 2) {
          dangerValEl.textContent = `${effectiveCounterLimit} ${ui.units.hours}`;
        } else {
          dangerValEl.textContent = state.above90F ? ui.units.hotRule : ui.units.standardRule;
        }
      }

      if (pathogenValEl) pathogenValEl.textContent = food.keyPathogenRisk;
      if (refreezeValEl) refreezeValEl.textContent = food.canRefreeze;
      if (tipValEl) tipValEl.textContent = food.storageTip;
      if (hubLinkEl) hubLinkEl.setAttribute('href', food.relatedHub || '/how-long/');

      updatePresetButtons();

      lastVerdictSummary = `${food.name} — ${ui.verdicts[level].badge}\n` +
        `${ui.safeUntilLabel}: ${safeUntilText} | ${ui.timeRemainingLabel}: ${countdownText}\n` +
        `${ui.metrics.reheatTitle}: ${reheatValEl ? reheatValEl.textContent : ''}\n` +
        `${reason}\n${window.location.href}`;
    }

    // Event bindings
    catButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = btn.getAttribute('data-lsl-cat') || 'all';
        state.category = cat;
        catButtons.forEach((b) => {
          const isAct = b.getAttribute('data-lsl-cat') === cat;
          b.setAttribute('aria-selected', isAct ? 'true' : 'false');
          const badge = b.querySelector('span:last-child');
          if (isAct) {
            b.classList.add('bg-signature-coral', 'text-white', 'border-signature-coral');
            b.classList.remove('bg-canvas', 'text-body', 'border-hairline');
            if (badge) {
              badge.classList.add('bg-white/20', 'text-white');
              badge.classList.remove('bg-surface-soft', 'text-muted');
            }
          } else {
            b.classList.remove('bg-signature-coral', 'text-white', 'border-signature-coral');
            b.classList.add('bg-canvas', 'text-body', 'border-hairline');
            if (badge) {
              badge.classList.remove('bg-white/20', 'text-white');
              badge.classList.add('bg-surface-soft', 'text-muted');
            }
          }
        });
        rebuildFoodOptions();
        rebuildAgeChipsAndSlider();
        computeAndRender();
      });
    });

    presetButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-lsl-preset');
        if (!id || !byId.has(id)) return;
        state.category = 'all';
        state.search = '';
        if (searchInput) searchInput.value = '';
        catButtons.forEach((b) => {
          const isAct = b.getAttribute('data-lsl-cat') === 'all';
          b.setAttribute('aria-selected', isAct ? 'true' : 'false');
          const badge = b.querySelector('span:last-child');
          if (isAct) {
            b.classList.add('bg-signature-coral', 'text-white', 'border-signature-coral');
            b.classList.remove('bg-canvas', 'text-body', 'border-hairline');
            if (badge) {
              badge.classList.add('bg-white/20', 'text-white');
              badge.classList.remove('bg-surface-soft', 'text-muted');
            }
          } else {
            b.classList.remove('bg-signature-coral', 'text-white', 'border-signature-coral');
            b.classList.add('bg-canvas', 'text-body', 'border-hairline');
            if (badge) {
              badge.classList.remove('bg-white/20', 'text-white');
              badge.classList.add('bg-surface-soft', 'text-muted');
            }
          }
        });
        state.foodId = id;
        rebuildFoodOptions();
        rebuildAgeChipsAndSlider();
        rebuildSpoilageChecklist();
        computeAndRender();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        state.search = e.target.value || '';
        rebuildFoodOptions();
        rebuildAgeChipsAndSlider();
        computeAndRender();
      });
    }

    if (foodSelect) {
      foodSelect.addEventListener('change', (e) => {
        const val = e.target.value;
        if (val && byId.has(val)) {
          state.foodId = val;
          rebuildAgeChipsAndSlider();
          rebuildSpoilageChecklist();
          computeAndRender();
        }
      });
    }

    storageButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const st = btn.getAttribute('data-lsl-storage');
        if (!st) return;
        state.storage = st;
        if (st === 'counter' && state.ageDays > 2) {
          state.ageDays = 0;
        }
        updateStorageButtons();
        rebuildAgeChipsAndSlider();
        computeAndRender();
      });
    });

    if (ageSlider) {
      ageSlider.addEventListener('input', (e) => {
        state.ageDays = parseFloat(e.target.value || '0');
        updateAgeChipHighlight();
        computeAndRender();
      });
    }

    if (roomSlider) {
      roomSlider.addEventListener('input', (e) => {
        state.roomHours = parseFloat(e.target.value || '0');
        computeAndRender();
      });
    }

    if (hotCheckbox) {
      hotCheckbox.addEventListener('change', (e) => {
        state.above90F = Boolean(e.target.checked);
        computeAndRender();
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        state = {
          category: 'all',
          search: '',
          foodId: foods[0].id,
          storage: 'fridge',
          ageDays: 1,
          roomHours: 0.5,
          above90F: false,
          spoilageChecked: false
        };
        if (searchInput) searchInput.value = '';
        if (roomSlider) roomSlider.value = '0.5';
        if (hotCheckbox) hotCheckbox.checked = false;
        catButtons.forEach((b) => {
          const isAct = b.getAttribute('data-lsl-cat') === 'all';
          b.setAttribute('aria-selected', isAct ? 'true' : 'false');
          const badge = b.querySelector('span:last-child');
          if (isAct) {
            b.classList.add('bg-signature-coral', 'text-white', 'border-signature-coral');
            b.classList.remove('bg-canvas', 'text-body', 'border-hairline');
            if (badge) {
              badge.classList.add('bg-white/20', 'text-white');
              badge.classList.remove('bg-surface-soft', 'text-muted');
            }
          } else {
            b.classList.remove('bg-signature-coral', 'text-white', 'border-signature-coral');
            b.classList.add('bg-canvas', 'text-body', 'border-hairline');
            if (badge) {
              badge.classList.remove('bg-white/20', 'text-white');
              badge.classList.add('bg-surface-soft', 'text-muted');
            }
          }
        });
        updateStorageButtons();
        rebuildFoodOptions();
        rebuildAgeChipsAndSlider();
        rebuildSpoilageChecklist();
        computeAndRender();
      });
    }

    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        if (!lastVerdictSummary || !navigator.clipboard || !navigator.clipboard.writeText) return;
        navigator.clipboard.writeText(lastVerdictSummary).then(() => {
          if (copyLabel) {
            copyLabel.textContent = ui.copiedBtn;
            setTimeout(() => {
              copyLabel.textContent = ui.copyBtn;
            }, 2000);
          }
        }).catch(() => {});
      });
    }

    // URL query support (?food=cooked-rice)
    try {
      const params = new URLSearchParams(window.location.search);
      const qFood = params.get('food');
      if (qFood && byId.has(qFood)) {
        state.foodId = qFood;
      }
    } catch (_) {}

    rebuildFoodOptions();
    rebuildAgeChipsAndSlider();
    rebuildSpoilageChecklist();
    computeAndRender();

    // Live countdown refresh every 60s
    setInterval(computeAndRender, 60000);
  })();
</script>
