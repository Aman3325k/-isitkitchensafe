---
import rawData from '../data/leftover-shelf-life-data.json';
import type { SupportedLanguage } from '../i18n/ui';
import { getApplianceUrl, getDirectoryUrl } from '../i18n/utils';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;

type CategoryKey = 'all' | 'poultry-meat' | 'seafood' | 'cooked-leftovers' | 'dairy-eggs' | 'produce-bakery';

function resolveHubUrl(hubPath: string, currentLang: SupportedLanguage): string {
  const clean = (hubPath || '').replace(/^\/+|\/+$/g, '');
  if (clean === 'how-long' || clean === 'refreeze' || clean === 'tools') {
    return getDirectoryUrl(clean, currentLang);
  }
  if (clean === 'refrigerator' || clean === 'freezer') {
    return getApplianceUrl(clean, currentLang);
  }
  return hubPath || '/';
}

interface LocalizedFood {
  id: string;
  name: string;
  category: Exclude<CategoryKey, 'all'>;
  fridgeDaysMin: number;
  fridgeDaysMax: number;
  freezerMonths: number;
  counterMaxHours: number;
  reheatTempF: number;
  reheatTempC: number;
  canRefreeze: string;
  keyPathogenRisk: string;
  spoilageSigns: string[];
  storageTip: string;
  relatedHub: string;
  searchText: string;
}

const localizedFoods: LocalizedFood[] = rawData.foods.map((item) => {
  const tr = lang !== 'en' && item.i18n && (item.i18n as Record<string, any>)[lang]
    ? (item.i18n as Record<string, any>)[lang]
    : null;

  const name = tr?.name || item.name;
  const canRefreeze = tr?.canRefreeze || item.canRefreeze;
  const keyPathogenRisk = tr?.keyPathogenRisk || item.keyPathogenRisk;
  const spoilageSigns = tr?.spoilageSigns || item.spoilageSigns;
  const storageTip = tr?.storageTip || item.storageTip;

  return {
    id: item.id,
    name,
    category: item.category as Exclude<CategoryKey, 'all'>,
    fridgeDaysMin: item.fridgeDaysMin,
    fridgeDaysMax: item.fridgeDaysMax,
    freezerMonths: item.freezerMonths,
    counterMaxHours: item.counterMaxHours,
    reheatTempF: item.reheatTempF,
    reheatTempC: item.reheatTempC,
    canRefreeze,
    keyPathogenRisk,
    spoilageSigns,
    storageTip,
    relatedHub: resolveHubUrl(item.relatedHub, lang),
    searchText: [item.name, name, item.id, keyPathogenRisk].join(' ').toLowerCase()
  };
});

const categoryCounts: Record<CategoryKey, number> = {
  all: localizedFoods.length,
  'poultry-meat': localizedFoods.filter((f) => f.category === 'poultry-meat').length,
  seafood: localizedFoods.filter((f) => f.category === 'seafood').length,
  'cooked-leftovers': localizedFoods.filter((f) => f.category === 'cooked-leftovers').length,
  'dairy-eggs': localizedFoods.filter((f) => f.category === 'dairy-eggs').length,
  'produce-bakery': localizedFoods.filter((f) => f.category === 'produce-bakery').length
};

const quickPresets = rawData.quickPresets
  .map((id) => localizedFoods.find((f) => f.id === id))
  .filter((f): f is LocalizedFood => Boolean(f));

