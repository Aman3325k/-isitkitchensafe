const d = DICTIONARY[lang];
---

<div class="bg-surface-card border border-hairline rounded-3xl p-6 md:p-10 shadow-sm transition-all" id="pizza-oven-modeler-root">
  <!-- Header -->
  <div class="border-b border-hairline/80 pb-6 mb-8">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-amber-600/10 text-amber-800 dark:text-amber-300 mb-3 border border-amber-600/20">
      <span>🔥</span>
      {d.badge}
    </div>
    <h2 class="text-2xl md:text-3xl font-extrabold text-ink tracking-tight mb-2">
      {d.title}
    </h2>
    <p class="text-sm md:text-base text-muted leading-relaxed max-w-4xl">
      {d.subtitle}
    </p>
  </div>

  <!-- Operational Presets -->
  <div class="mb-10 bg-surface-soft/60 border border-hairline/70 rounded-2xl p-5 md:p-6">
    <div class="text-xs font-bold text-muted uppercase tracking-wider mb-3">
      {d.presetsTitle}
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
      <button 
        type="button" 
        data-preset="triple-stack-gold" 
        class="preset-btn text-left p-3.5 rounded-xl border border-hairline bg-surface hover:border-amber-600/50 hover:bg-amber-600/5 transition-all text-xs font-medium text-ink flex flex-col justify-between gap-2 shadow-2xs"
      >
        <span class="font-bold text-amber-700 dark:text-amber-400">🏆 {lang === 'zh-cn' ? '三层大负荷黄金标准' : lang === 'ja' ? '3段大型FC黄金基準' : 'Franchise Triple-Stack'}</span>
        <span class="text-muted leading-tight">{d.presetFranchiseTripleStack}</span>
      </button>

      <button 
        type="button" 
        data-preset="backdraft-danger" 
        class="preset-btn text-left p-3.5 rounded-xl border border-hairline bg-surface hover:border-red-600/50 hover:bg-red-600/5 transition-all text-xs font-medium text-ink flex flex-col justify-between gap-2 shadow-2xs"
      >
        <span class="font-bold text-red-600 dark:text-red-400">⚠️ {lang === 'zh-cn' ? '后厨负压烟道倒灌' : lang === 'ja' ? '厨房負圧・CO逆流危険' : 'Negative-Pressure Backdraft'}</span>
        <span class="text-muted leading-tight">{d.presetNegativePressureBackdraft}</span>
      </button>

      <button 
        type="button" 
        data-preset="neapolitan-pyrolysis" 
        class="preset-btn text-left p-3.5 rounded-xl border border-hairline bg-surface hover:border-purple-600/50 hover:bg-purple-600/5 transition-all text-xs font-medium text-ink flex flex-col justify-between gap-2 shadow-2xs"
      >
        <span class="font-bold text-purple-600 dark:text-purple-400">🍕 {lang === 'zh-cn' ? '那不勒斯高温热解' : lang === 'ja' ? '480°C石英熱分解煙' : '900°F Quartz Neapolitan'}</span>
        <span class="text-muted leading-tight">{d.presetHighTempNeapolitanQuartz}</span>
      </button>

      <button 
        type="button" 
        data-preset="ventless-mall" 
        class="preset-btn text-left p-3.5 rounded-xl border border-hairline bg-surface hover:border-cyan-600/50 hover:bg-cyan-600/5 transition-all text-xs font-medium text-ink flex flex-col justify-between gap-2 shadow-2xs"
      >
        <span class="font-bold text-cyan-600 dark:text-cyan-400">🏬 {lang === 'zh-cn' ? '商场无烟催化热蓄积' : lang === 'ja' ? '密閉モール触媒ダクトレス' : 'Ventless Catalytic Mall'}</span>
        <span class="text-muted leading-tight">{d.presetVentlessCatalyticMall}</span>
      </button>
    </div>
  </div>

  <!-- Interactive Controls Form -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-10">
    <!-- Left Configuration Panel (7 Cols) -->
    <div class="lg:col-span-7 space-y-6">
      <div class="border-b border-hairline pb-2">
        <h3 class="text-base font-bold text-ink tracking-tight">{d.controlsTitle}</h3>
        <p class="text-xs text-muted">{d.controlsSub}</p>
      </div>

      <!-- 1. Oven Configuration -->
      <div>
        <label for="oven-config" class="block text-xs font-bold uppercase tracking-wider text-muted mb-1.5">
          {d.ovenConfigLabel}
        </label>
        <select id="oven-config" class="w-full text-xs font-medium bg-surface border border-hairline rounded-xl px-3.5 py-2.5 text-ink focus:outline-none focus:ring-2 focus:ring-amber-600/50">
          {ovenData.ovenConfigurations.map(cfg => (
            <option value={cfg.id} selected={cfg.id === 'double_stack_gas_impingement'}>
              {cfg.name} ({cfg.thermalOutputBtuHr.toLocaleString()} BTU/hr)
            </option>
          ))}
        </select>
        <p class="text-xs text-muted mt-1 leading-normal">{d.ovenConfigHelp}</p>
      </div>

      <!-- 2. Kitchen Ventilation Hood Tier -->
      <div>
        <label for="hood-tier" class="block text-xs font-bold uppercase tracking-wider text-muted mb-1.5">
          {d.hoodLabel}
        </label>
        <select id="hood-tier" class="w-full text-xs font-medium bg-surface border border-hairline rounded-xl px-3.5 py-2.5 text-ink focus:outline-none focus:ring-2 focus:ring-amber-600/50">
          {ovenData.hoodVentilationTiers.map(hd => (
            <option value={hd.id} selected={hd.id === 'nfpa96_type1_engineered'}>
              {hd.name} [Capture: {hd.captureEfficiencyPct}%]
            </option>
          ))}
        </select>
        <p class="text-xs text-muted mt-1 leading-normal">{d.hoodHelp}</p>
      </div>

      <!-- 3. Burner Combustion Air Condition -->
      <div>
        <label for="combustion-condition" class="block text-xs font-bold uppercase tracking-wider text-muted mb-1.5">
          {d.combustionLabel}
        </label>
        <select id="combustion-condition" class="w-full text-xs font-medium bg-surface border border-hairline rounded-xl px-3.5 py-2.5 text-ink focus:outline-none focus:ring-2 focus:ring-amber-600/50">
          {ovenData.combustionAirConditions.map(c => (
            <option value={c.id} selected={c.id === 'optimal_stoichiometric'}>
              {c.name} [Flue CO: {c.coFlueConcentrationPpm} ppm]
            </option>
          ))}
        </select>
        <p class="text-xs text-muted mt-1 leading-normal">{d.combustionHelp}</p>
      </div>

      <!-- 4. Crust Flour & Grease Loading -->
      <div>
        <label for="crust-flour" class="block text-xs font-bold uppercase tracking-wider text-muted mb-1.5">
          {d.crustFlourLabel}
        </label>
        <select id="crust-flour" class="w-full text-xs font-medium bg-surface border border-hairline rounded-xl px-3.5 py-2.5 text-ink focus:outline-none focus:ring-2 focus:ring-amber-600/50">
          {ovenData.flourParticulateAndFatLoads.map(f => (
            <option value={f.id} selected={f.id === 'heavy_semolina_fatty_meats'}>
              {f.name} [PM2.5: {f.pm25EmissionRateMgMin} mg/min]
            </option>
          ))}
        </select>
        <p class="text-xs text-muted mt-1 leading-normal">{d.crustFlourHelp}</p>
      </div>

      <!-- Sliders Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 pt-2">
        <!-- Chamber Temperature Slider -->
        <div class="bg-surface-soft/60 border border-hairline rounded-xl p-3.5">
          <div class="flex justify-between items-center mb-1">
            <label for="temp-slider" class="text-xs font-bold text-ink">{d.tempSliderLabel}</label>
            <span id="temp-val" class="text-xs font-mono font-bold text-amber-700 dark:text-amber-400">260°C (500°F)</span>
          </div>
          <input 
            type="range" 
            id="temp-slider" 
            min="200" 
            max="480" 
            step="5" 
            value="260" 
            class="w-full accent-amber-600 cursor-pointer"
          />
          <p class="text-2xs text-muted mt-1">{d.tempSliderHelp}</p>
        </div>

        <!-- Hood Exhaust CFM Slider -->
        <div class="bg-surface-soft/60 border border-hairline rounded-xl p-3.5">
          <div class="flex justify-between items-center mb-1">
            <label for="exhaust-slider" class="text-xs font-bold text-ink">{d.exhaustSliderLabel}</label>
            <span id="exhaust-val" class="text-xs font-mono font-bold text-amber-700 dark:text-amber-400">1,800 CFM</span>
          </div>
          <input 
            type="range" 
            id="exhaust-slider" 
            min="400" 
            max="3500" 
            step="50" 
            value="1800" 
            class="w-full accent-amber-600 cursor-pointer"
          />
          <p class="text-2xs text-muted mt-1">{d.exhaustSliderHelp}</p>
        </div>

        <!-- MUA Balance Slider -->
        <div class="bg-surface-soft/60 border border-hairline rounded-xl p-3.5">
          <div class="flex justify-between items-center mb-1">
            <label for="mua-slider" class="text-xs font-bold text-ink">{d.muaSliderLabel}</label>
            <span id="mua-val" class="text-xs font-mono font-bold text-amber-700 dark:text-amber-400">90%</span>
          </div>
          <input 
            type="range" 
            id="mua-slider" 
            min="30" 
            max="100" 
            step="5" 
            value="90" 
            class="w-full accent-amber-600 cursor-pointer"
          />
          <p class="text-2xs text-muted mt-1">{d.muaSliderHelp}</p>
        </div>

        <!-- Kitchen Duty Cycle Select -->
        <div class="bg-surface-soft/60 border border-hairline rounded-xl p-3.5">
          <label for="duty-cycle" class="text-xs font-bold text-ink block mb-1">{d.dutyCycleLabel}</label>
          <select id="duty-cycle" class="w-full text-xs font-medium bg-surface border border-hairline rounded-lg px-2.5 py-1.5 text-ink focus:outline-none">
            {ovenData.operationalDutyCycles.map(dc => (
              <option value={dc.id} selected={dc.id === 'peak_friday_rush'}>
                {dc.name}
              </option>
            ))}
          </select>
          <p class="text-2xs text-muted mt-1">{d.dutyCycleHelp}</p>
        </div>
      </div>
    </div>

    <!-- Right Live Telemetry Card (5 Cols) -->
    <div class="lg:col-span-5 flex flex-col justify-between">
      <div class="bg-surface-soft border border-hairline rounded-2xl p-6 shadow-xs relative overflow-hidden space-y-5">
        <div class="flex items-center justify-between border-b border-hairline pb-3">
          <h4 class="text-sm font-bold text-ink uppercase tracking-wider">{d.diagnosticTitle}</h4>
          <span id="risk-badge" class="px-2.5 py-0.5 rounded-full text-xs font-extrabold uppercase tracking-wider bg-emerald-600 text-white">
            COMPLIANT
          </span>
        </div>

        <!-- 1. Carbon Monoxide Concentration Gauge -->
        <div>
          <div class="flex justify-between items-baseline mb-1">
            <span class="text-xs text-muted font-medium">{d.coEquilibriumLabel}</span>
            <span id="co-ppm-val" class="text-2xl font-black font-mono text-emerald-600 dark:text-emerald-400">8.4 ppm</span>
          </div>
          <!-- Progress bar -->
          <div class="w-full bg-surface border border-hairline rounded-full h-2.5 overflow-hidden">
            <div id="co-progress" class="bg-emerald-600 h-2.5 rounded-full transition-all duration-300" style="width: 16.8%;"></div>
          </div>
          <div class="flex justify-between text-2xs text-muted font-mono mt-1">
            <span>0 ppm (Ambient)</span>
            <span>25 ppm (ACGIH)</span>
            <span>35 ppm (NIOSH)</span>
            <span>50 ppm (OSHA PEL)</span>
          </div>
        </div>

        <!-- Secondary Metrics Grid -->
        <div class="grid grid-cols-2 gap-3 text-xs border-y border-hairline/80 py-3">
          <div>
            <span class="text-muted block text-2xs uppercase tracking-wider">{d.plumeVelocityLabel}</span>
            <span id="plume-velocity-val" class="font-bold font-mono text-ink text-sm">345 FPM (680 CFM)</span>
          </div>
          <div>
            <span class="text-muted block text-2xs uppercase tracking-wider">{d.heatSpillageLabel}</span>
            <span id="heat-spillage-val" class="font-bold font-mono text-ink text-sm">3.8 kW (13k BTU/h)</span>
          </div>
          <div>
            <span class="text-muted block text-2xs uppercase tracking-wider">{d.pm25Label}</span>
            <span id="pm25-val" class="font-bold font-mono text-ink text-sm">22.4 µg/m³</span>
          </div>
          <div>
            <span class="text-muted block text-2xs uppercase tracking-wider">{d.complianceLabel}</span>
            <span id="compliance-status-val" class="font-bold font-mono text-emerald-600 dark:text-emerald-400 text-sm">NFPA 96 PASS</span>
          </div>
        </div>

        <!-- Diagnostic Text Feedback -->
        <div class="space-y-3 text-xs">
          <div>
            <span class="font-bold text-ink block mb-0.5">{d.primaryRiskLabel}:</span>
            <p id="risk-desc" class="text-muted leading-relaxed">
              Standard optimal operation. 98.5% capture efficiency captures combustion effluent and conveyor convective plume.
            </p>
          </div>

          <div>
            <span class="font-bold text-ink block mb-0.5">{d.mechanismsLabel}:</span>
            <p id="mechanism-desc" class="text-muted leading-relaxed font-mono text-2xs">
              Q_plume = C · A_portal · √(g · H · ΔT / T_amb) | CO_ss = (G_CO · (1 - η_cap)) / (V_room · ACH)
            </p>
          </div>

          <div>
            <span class="font-bold text-ink block mb-0.5">{d.mitigationLabel}:</span>
            <p id="mitigation-desc" class="text-muted leading-relaxed">
              Maintain quarterly hood duct grease scraper sweeps and semi-annual primary burner orifice cleaning.
            </p>
          </div>
        </div>

        <!-- Copy Report Button -->
        <div class="pt-2">
          <button 
            type="button" 
            id="copy-report-btn" 
            class="w-full py-2.5 px-4 rounded-xl bg-amber-700 hover:bg-amber-800 text-white font-medium text-xs text-center transition-colors shadow-xs flex items-center justify-center gap-2"
          >
            <span>📋</span>
            <span id="copy-btn-text">{d.copyReportBtn}</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Scientific Reference Table -->
  <div class="border-t border-hairline pt-8 mb-10">
    <div class="mb-4">
      <h3 class="text-lg font-bold text-ink">{d.tableTitle}</h3>
      <p class="text-xs text-muted">{d.tableSub}</p>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs border border-hairline rounded-xl overflow-hidden">
        <thead class="bg-surface-soft border-b border-hairline text-ink font-bold uppercase tracking-wider">
          <tr>
            <th class="p-3">{d.colOven}</th>
            <th class="p-3">{d.colBtu}</th>
            <th class="p-3">{d.colPower}</th>
            <th class="p-3">{d.colTempRange}</th>
            <th class="p-3">{d.colSensibleGain}</th>
            <th class="p-3">{d.colCoRisk}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline bg-surface font-mono">
          {ovenData.ovenConfigurations.map(o => (
            <tr class="hover:bg-surface-soft/40 transition-colors">
              <td class="p-3 font-sans font-medium text-ink">{o.name}</td>
              <td class="p-3">{o.thermalOutputBtuHr.toLocaleString()} BTU/hr</td>
              <td class="p-3 font-sans">{o.powerType}</td>
              <td class="p-3">{o.chamberTempRangeC[0]}°C – {o.chamberTempRangeC[1]}°C</td>
              <td class="p-3">{(o.sensibleHeatGainBtuHr / 1000).toFixed(0)}k BTU/hr</td>
              <td class="p-3 font-sans">
                <span class={`inline-block px-2 py-0.5 rounded text-2xs font-bold ${
                  o.coGenerationRateMgHr > 5000 ? 'bg-red-600/10 text-red-700 dark:text-red-400' :
                  o.coGenerationRateMgHr > 1000 ? 'bg-amber-600/10 text-amber-700 dark:text-amber-400' :
                  'bg-emerald-600/10 text-emerald-700 dark:text-emerald-400'
                }`}>
                  {o.coGenerationRateMgHr > 5000 ? 'HIGH' : o.coGenerationRateMgHr > 1000 ? 'MODERATE' : 'LOW / ZERO'}
                </span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Operational Engineering Rules -->
  <div class="bg-surface-soft/40 border border-hairline rounded-2xl p-6">
    <div class="mb-4">
      <h3 class="text-base font-bold text-ink">{d.rulesTitle}</h3>
      <p class="text-xs text-muted">{d.rulesSub}</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="p-4 rounded-xl bg-surface border border-hairline/70">
        <div class="flex items-center gap-2 mb-1.5">
          <span class="w-5 h-5 rounded-full bg-red-600/10 text-red-700 dark:text-red-400 text-xs font-bold flex items-center justify-center">1</span>
          <h4 class="text-xs font-bold text-ink">{d.rule1Title}</h4>
        </div>
        <p class="text-xs text-muted leading-relaxed">{d.rule1Text}</p>
      </div>

      <div class="p-4 rounded-xl bg-surface border border-hairline/70">
        <div class="flex items-center gap-2 mb-1.5">
          <span class="w-5 h-5 rounded-full bg-amber-600/10 text-amber-700 dark:text-amber-400 text-xs font-bold flex items-center justify-center">2</span>
          <h4 class="text-xs font-bold text-ink">{d.rule2Title}</h4>
        </div>
        <p class="text-xs text-muted leading-relaxed">{d.rule2Text}</p>
      </div>

      <div class="p-4 rounded-xl bg-surface border border-hairline/70">
        <div class="flex items-center gap-2 mb-1.5">
          <span class="w-5 h-5 rounded-full bg-blue-600/10 text-blue-700 dark:text-blue-400 text-xs font-bold flex items-center justify-center">3</span>
          <h4 class="text-xs font-bold text-ink">{d.rule3Title}</h4>
        </div>
        <p class="text-xs text-muted leading-relaxed">{d.rule3Text}</p>
      </div>

      <div class="p-4 rounded-xl bg-surface border border-hairline/70">
        <div class="flex items-center gap-2 mb-1.5">
          <span class="w-5 h-5 rounded-full bg-emerald-600/10 text-emerald-700 dark:text-emerald-400 text-xs font-bold flex items-center justify-center">4</span>
          <h4 class="text-xs font-bold text-ink">{d.rule4Title}</h4>
        </div>
        <p class="text-xs text-muted leading-relaxed">{d.rule4Text}</p>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ ovenData, d }}>
  document.addEventListener('DOMContentLoaded', () => {
    const root = document.getElementById('pizza-oven-modeler-root');
    if (!root) return;

    // Elements
    const ovenSelect = root.querySelector('#oven-config');
    const hoodSelect = root.querySelector('#hood-tier');
    const combustionSelect = root.querySelector('#combustion-condition');
    const flourSelect = root.querySelector('#crust-flour');
    const dutySelect = root.querySelector('#duty-cycle');

    const tempSlider = root.querySelector('#temp-slider');
    const exhaustSlider = root.querySelector('#exhaust-slider');
    const muaSlider = root.querySelector('#mua-slider');

    const tempVal = root.querySelector('#temp-val');
    const exhaustVal = root.querySelector('#exhaust-val');
    const muaVal = root.querySelector('#mua-val');

    const riskBadge = root.querySelector('#risk-badge');
    const coPpmVal = root.querySelector('#co-ppm-val');
    const coProgress = root.querySelector('#co-progress');
    const plumeVelocityVal = root.querySelector('#plume-velocity-val');
    const heatSpillageVal = root.querySelector('#heat-spillage-val');
    const pm25Val = root.querySelector('#pm25-val');
    const complianceStatusVal = root.querySelector('#compliance-status-val');

    const riskDesc = root.querySelector('#risk-desc');
    const mechanismDesc = root.querySelector('#mechanism-desc');
    const mitigationDesc = root.querySelector('#mitigation-desc');
    const copyBtn = root.querySelector('#copy-report-btn');
    const copyBtnText = root.querySelector('#copy-btn-text');

    function calculate() {
      const ovenId = ovenSelect.value;
      const hoodId = hoodSelect.value;
      const combustionId = combustionSelect.value;
      const flourId = flourSelect.value;
      const dutyId = dutySelect.value;

      const chamberTemp = parseFloat(tempSlider.value);
      const exhaustCfm = parseFloat(exhaustSlider.value);
      const muaPct = parseFloat(muaSlider.value);

      // Lookups
      const oven = ovenData.ovenConfigurations.find(o => o.id === ovenId) || ovenData.ovenConfigurations[0];
      const hood = ovenData.hoodVentilationTiers.find(h => h.id === hoodId) || ovenData.hoodVentilationTiers[0];
      const combustion = ovenData.combustionAirConditions.find(c => c.id === combustionId) || ovenData.combustionAirConditions[0];
      const flour = ovenData.flourParticulateAndFatLoads.find(f => f.id === flourId) || ovenData.flourParticulateAndFatLoads[0];
      const duty = ovenData.operationalDutyCycles.find(d => d.id === dutyId) || ovenData.operationalDutyCycles[0];

      // Sliders label sync
      const tempF = Math.round((chamberTemp * 9/5) + 32);
      tempVal.textContent = `${chamberTemp}°C (${tempF}°F)`;
      exhaustVal.textContent = `${exhaustCfm.toLocaleString()} CFM`;
      muaVal.textContent = `${muaPct}%`;

      // 1. Plume Velocity & Convective Spillage
      const ambientTempK = 295; // 22°C
      const chamberTempK = chamberTemp + 273.15;
      const deltaT = Math.max(10, chamberTempK - ambientTempK);
      // Thermal buoyancy draft velocity (FPM)
      const basePortalVelocity = Math.sqrt(2 * 9.81 * 0.45 * (deltaT / chamberTempK)) * 196.85; // m/s to FPM
      const effectivePlumeVelocity = Math.round(basePortalVelocity * (oven.fingerVelocityFpm / 2000));
      const grossPortalCfm = Math.round(effectivePlumeVelocity * oven.portalApertureSqFt);

      // Hood capture & spillage
      const captureRatio = (hood.captureEfficiencyPct / 100) * Math.min(1.0, exhaustCfm / Math.max(500, grossPortalCfm * 1.4));
      const spillagePct = Math.max(0, 1.0 - captureRatio);
      const spilledCfm = Math.round(grossPortalCfm * spillagePct);

      // Sensible heat spillage (kW and BTU/hr)
      const totalSensibleBtu = oven.sensibleHeatGainBtuHr * duty.heatStressFactor;
      const spilledSensibleBtu = Math.round(totalSensibleBtu * (spillagePct * 0.85 + 0.15));
      const spilledSensibleKw = (spilledSensibleBtu / 3412.142).toFixed(1);

      // 2. Carbon Monoxide Generation & Equilibrium PPM
      // Base generation in mg/hr
      let rawCoMgHr = oven.coGenerationRateMgHr * combustion.multiplier * duty.heatStressFactor;
      // High temp flour pyrolysis also generates CO (up to 3,500 mg/hr at 450°C)
      if (chamberTemp > 350) {
        rawCoMgHr += (chamberTemp - 350) * 35 * (flour.crustSpallationGramsPerPizza / 8);
      }

      // Negative pressure backdraft multiplier
      let backdraftMultiplier = 1.0;
      if (muaPct < 75 && oven.powerType.includes('Gas')) {
        backdraftMultiplier = 1.0 + ((75 - muaPct) / 10); // Spikes exponentially
      }
      if (hood.id === 'negative_pressure_unhooded_failure') {
        backdraftMultiplier = 4.2;
      }

      const netCoSpilledMgHr = (rawCoMgHr * (1 - (hood.coDispersionReductionPct / 100) * captureRatio)) * backdraftMultiplier;
      // Standard commercial kitchen volume: 200 m3, ACH (Air changes per hour) based on exhaust and MUA
      const kitchenVolM3 = 220;
      const effectiveAch = Math.max(2, (exhaustCfm * 60 * 0.0283168) / kitchenVolM3 * (muaPct / 100));
      // Steady state CO mg/m3 -> ppm (1 ppm CO ≈ 1.15 mg/m3 at standard temp)
      const coMgM3 = netCoSpilledMgHr / (kitchenVolM3 * effectiveAch);
      const coPpm = Math.max(0.5, Math.round((coMgM3 / 1.15) * 10) / 10);

      // 3. PM2.5 Flour Pyrolysis particulate
      const rawPm25MgMin = flour.pm25EmissionRateMgMin * (duty.pizzasPerHour / 60) * (chamberTemp / 260);
      const netPm25MgMin = rawPm25MgMin * (1 - captureRatio * 0.92);
      const pm25UgM3 = Math.max(2, Math.round((netPm25MgMin * 1000) / (kitchenVolM3 * (effectiveAch / 60))));

      // 4. Update UI Outputs
      coPpmVal.textContent = `${coPpm.toFixed(1)} ppm`;
      plumeVelocityVal.textContent = `${effectivePlumeVelocity} FPM (${spilledCfm} CFM Spill)`;
      heatSpillageVal.textContent = `${spilledSensibleKw} kW (${(spilledSensibleBtu / 1000).toFixed(0)}k BTU/h)`;
      pm25Val.textContent = `${pm25UgM3} µg/m³`;

      // Progress bar width (max 100 ppm scale)
      const progressWidth = Math.min(100, (coPpm / 60) * 100);
      coProgress.style.width = `${progressWidth}%`;

      // Status & Badges
      let statusClass = 'bg-emerald-600 text-white';
      let statusText = 'COMPLIANT';
      let coColorClass = 'text-emerald-600 dark:text-emerald-400';
      let complianceCode = 'NFPA 96 PASS • OSHA COMPLIANT';

      if (coPpm >= 50 || muaPct < 50 && oven.powerType.includes('Gas')) {
        statusClass = 'bg-red-600 text-white animate-pulse';
        statusText = 'CRITICAL HAZARD';
        coColorClass = 'text-red-600 dark:text-red-400';
        complianceCode = 'OSHA PEL EXCEEDED • SEVERE VIOLATION';
        coProgress.className = 'bg-red-600 h-2.5 rounded-full transition-all duration-300';
        riskDesc.textContent = `CRITICAL DANGER: Equilibrium carbon monoxide (${coPpm} ppm) exceeds the OSHA Permissible Exposure Limit (50 ppm). Line cooks are at immediate risk of carboxyhemoglobin saturation, disorientation, and syncope.`;
        mitigationDesc.textContent = `MANDATORY: Immediately shut off gas fuel supply. Rebalance Make-Up Air to minimum 85% and inspect draft diverters for catastrophic flue gas backdrafting.`;
      } else if (coPpm >= 25 || spillagePct > 0.35) {
        statusClass = 'bg-amber-600 text-white';
        statusText = 'MARGINAL WARNING';
        coColorClass = 'text-amber-600 dark:text-amber-400';
        complianceCode = 'ACGIH TLV CONCERN • PLUME SPILLAGE';
        coProgress.className = 'bg-amber-600 h-2.5 rounded-full transition-all duration-300';
        riskDesc.textContent = `ELEVATED RISK: Worker breathing zone CO (${coPpm} ppm) exceeds ACGIH threshold (25 ppm) or thermal convective spillage (${spilledSensibleKw} kW) violates ASHRAE 154 worker comfort limits.`;
        mitigationDesc.textContent = `Clean clogged burner lint screens to restore 10.5:1 stoichiometric flame and extend canopy hood overhang to 12 inches beyond open portals.`;
      } else {
        statusClass = 'bg-emerald-600 text-white';
        statusText = 'OPTIMAL COMPLIANT';
        coColorClass = 'text-emerald-600 dark:text-emerald-400';
        complianceCode = 'NFPA 96 TYPE I • OSHA COMPLIANT';
        coProgress.className = 'bg-emerald-600 h-2.5 rounded-full transition-all duration-300';
        riskDesc.textContent = `SAFE OPERATION: Equilibrium carbon monoxide (${coPpm} ppm) is well below OSHA 50 ppm limits. Effective hood capture prevents convective portal spillage into kitchen space.`;
        mitigationDesc.textContent = `Maintain bi-weekly primary air blower dusting and daily crumb tray emptying to prevent pyrolytic cornmeal smoke generation.`;
      }

      riskBadge.className = `px-2.5 py-0.5 rounded-full text-xs font-extrabold uppercase tracking-wider ${statusClass}`;
      riskBadge.textContent = statusText;
      coPpmVal.className = `text-2xl font-black font-mono ${coColorClass}`;
      complianceStatusVal.textContent = complianceCode;
      complianceStatusVal.className = `font-bold font-mono text-sm ${coColorClass}`;

      mechanismDesc.textContent = `V_plume = √[2·g·H·(ΔT/T_amb)] = ${effectivePlumeVelocity} FPM | CO_flue = ${combustion.coFlueConcentrationPpm} ppm | Spillage = ${(spillagePct * 100).toFixed(1)}%`;
    }

    // Attach listeners
    [ovenSelect, hoodSelect, combustionSelect, flourSelect, dutySelect].forEach(el => {
      el.addEventListener('change', calculate);
    });

    [tempSlider, exhaustSlider, muaSlider].forEach(sl => {
      sl.addEventListener('input', calculate);
    });

    // Presets
    const presetBtns = root.querySelectorAll('.preset-btn');
    presetBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const type = btn.getAttribute('data-preset');
        if (type === 'triple-stack-gold') {
          ovenSelect.value = 'triple_stack_high_volume_gas';
          hoodSelect.value = 'nfpa96_type1_engineered';
          combustionSelect.value = 'optimal_stoichiometric';
          flourSelect.value = 'moderate_cornmeal_standard_cheese';
          dutySelect.value = 'peak_friday_rush';
          tempSlider.value = 265;
          exhaustSlider.value = 2800;
          muaSlider.value = 90;
        } else if (type === 'backdraft-danger') {
          ovenSelect.value = 'double_stack_gas_impingement';
          hoodSelect.value = 'undersized_deficient_hood';
          combustionSelect.value = 'severe_air_starvation';
          flourSelect.value = 'heavy_semolina_fatty_meats';
          dutySelect.value = 'peak_friday_rush';
          tempSlider.value = 280;
          exhaustSlider.value = 800;
          muaSlider.value = 40;
        } else if (type === 'neapolitan-pyrolysis') {
          ovenSelect.value = 'high_temp_quartz_neapolitan';
          hoodSelect.value = 'type2_heat_moisture_standard';
          combustionSelect.value = 'optimal_stoichiometric';
          flourSelect.value = 'heavy_semolina_fatty_meats';
          dutySelect.value = 'peak_friday_rush';
          tempSlider.value = 460;
          exhaustSlider.value = 1400;
          muaSlider.value = 80;
        } else if (type === 'ventless-mall') {
          ovenSelect.value = 'ventless_catalytic_single_deck';
          hoodSelect.value = 'type2_heat_moisture_standard';
          combustionSelect.value = 'optimal_stoichiometric';
          flourSelect.value = 'screen_baked_lean_crust';
          dutySelect.value = 'standard_lunch_shift';
          tempSlider.value = 240;
          exhaustSlider.value = 600;
          muaSlider.value = 85;
        }
        calculate();
      });
    });

    // Copy Report
    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        const report = `=== ISITKITCHENSAFE CONVEYOR PIZZA OVEN VENTILATION REPORT ===
Oven Architecture: ${ovenSelect.options[ovenSelect.selectedIndex].text}
Hood Ventilation: ${hoodSelect.options[hoodSelect.selectedIndex].text}
Combustion Stoichiometry: ${combustionSelect.options[combustionSelect.selectedIndex].text}
Crust Dusting: ${flourSelect.options[flourSelect.selectedIndex].text}
Chamber Temperature: ${tempSlider.value}°C (${tempVal.textContent})
Exhaust Airflow: ${exhaustSlider.value} CFM | MUA Balance: ${muaSlider.value}%

DIAGNOSTIC RESULTS:
Breathing Zone CO: ${coPpmVal.textContent}
Thermal Plume Velocity: ${plumeVelocityVal.textContent}
Sensible Heat Spillage: ${heatSpillageVal.textContent}
Airborne PM2.5: ${pm25Val.textContent}
Compliance Status: ${complianceStatusVal.textContent}
Risk Summary: ${riskDesc.textContent.trim()}
Engineering Protocols: ${mitigationDesc.textContent.trim()}
Standard References: NFPA 96 • ANSI Z83.11 • OSHA 29 CFR 1910.1000 • ASHRAE 154
Generated via IsItKitchenSafe Autonomous Growth & Ops Engine v2.0`;

        navigator.clipboard.writeText(report).then(() => {
          const original = copyBtnText.textContent;
          copyBtnText.textContent = d.copiedFeedback;
          setTimeout(() => {
            copyBtnText.textContent = original;
          }, 2500);
        });
      });
    }

    // Initial run
    calculate();
  });
</script>
