---
import rawData from '../data/oven-rack-bakeware-heat-data.json';
import type { SupportedLanguage } from '../i18n/ui';
import { useTranslatedPath } from '../i18n/utils';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;
const translatePath = useTranslatedPath(lang);

const cookwareLookupUrl = translatePath('/tools/cookware-oven-temp-lookup/');
const airFryerUrl = translatePath('/tools/air-fryer-oven-converter/');
const internalTempUrl = translatePath('/tools/internal-cooking-temp-chart/');
const methodologyUrl = translatePath('/methodology/');
const allToolsUrl = translatePath('/tools/');

type ThermalShockRisk = 'none' | 'low' | 'moderate' | 'high' | 'extreme';

interface SafetyRule {
  icon: string;
  title: string;
  body: string;
}

interface LocalizedMaterial {
  id: string;
  icon: string;
  tempDeltaF: number;
  timeDeltaMin: number;
  cautionTempF: number;
  maxSafeTempF: number;
  broilerSafe: boolean;
  thermalShockRisk: ThermalShockRisk;
  browningLevel: string;
  name: string;
  shortName: string;
  examples: string;
  tempRuleBadge: string;
  browningProfile: string;
  scienceNote: string;
  safetyNote: string;
  careTip: string;
}

interface LocalizedRack {
  id: string;
  slotNumber: number;
  heatZoneColor: string;
  broilerZone: boolean;
  name: string;
  shortName: string;
  zoneBadge: string;
  bestFor: string;
  airflowNote: string;
  warning: string;
}

interface LocalizedDish {
  id: string;
  icon: string;
  rackId: string;
  baseTempF: number;
  baseTimeMin: number;
  broiler: boolean;
  recommendedMaterialId: string;
  name: string;
  tip: string;
}

const safetyBanner =
  (rawData.safetyBanner as Record<string, { badge: string; headline: string; rules: SafetyRule[] }>)[lang] ||
  rawData.safetyBanner.en;

const localizedMaterials: LocalizedMaterial[] = rawData.materials.map((item) => {
  const tr = (item.i18n as Record<string, any>)[lang] || item.i18n.en;
  return {
    id: item.id,
    icon: item.icon,
    tempDeltaF: item.tempDeltaF,
    timeDeltaMin: item.timeDeltaMin,
    cautionTempF: item.cautionTempF,
    maxSafeTempF: item.maxSafeTempF,
    broilerSafe: item.broilerSafe,
    thermalShockRisk: item.thermalShockRisk as ThermalShockRisk,
    browningLevel: item.browningLevel,
    name: tr.name,
    shortName: tr.shortName,
    examples: tr.examples,
    tempRuleBadge: tr.tempRuleBadge,
    browningProfile: tr.browningProfile,
    scienceNote: tr.scienceNote,
    safetyNote: tr.safetyNote,
    careTip: tr.careTip
  };
});

const localizedRacks: LocalizedRack[] = rawData.racks.map((item) => {
  const tr = (item.i18n as Record<string, any>)[lang] || item.i18n.en;
  return {
    id: item.id,
    slotNumber: item.slotNumber,
    heatZoneColor: item.heatZoneColor,
    broilerZone: item.broilerZone,
    name: tr.name,
    shortName: tr.shortName,
    zoneBadge: tr.zoneBadge,
    bestFor: tr.bestFor,
    airflowNote: tr.airflowNote,
    warning: tr.warning
  };
});

const localizedDishes: LocalizedDish[] = rawData.dishes.map((item) => {
  const tr = (item.i18n as Record<string, any>)[lang] || item.i18n.en;
  return {
    id: item.id,
    icon: item.icon,
    rackId: item.rackId,
    baseTempF: item.baseTempF,
    baseTimeMin: item.baseTimeMin,
    broiler: item.broiler,
    recommendedMaterialId: item.recommendedMaterialId,
    name: tr.name,
    tip: tr.tip
  };
});

const localizedFaqs: Array<{ question: string; answer: string }> =
