    copyHeader: 'IsItKitchenSafe — オーブン段位置・コンベクション・焼き型調整設定',
    copyDishLine: '料理プリセット：',
    copyMaterialLine: '焼き型材質：',
    copyModeLine: '加熱モード：',
    copyTempLine: '調整後オーブン温度：',
    copyTimeLine: '焼き加減チェック目安：',
    copyRackLine: 'オーブン段位置：',
    copyAlertsLine: '安全アラート：',
    copySafeLine: '安全ステータス：材質・温度・段位置すべて安全範囲内です。',
    relatedHeading: '関連するオーブン・調理器具・食品温度ツール',
    relatedCookwareTag: '器具の耐熱上限',
    relatedCookwareTitle: '調理器具オーブン耐熱温度検索 →',
    relatedCookwareDesc: 'Pyrex、ル・クルーゼ、HexClad、All-Clad、シリコンマット、クッキングシート、蓋ツマミの耐熱上限を確認。',
    relatedAirFryerTag: '熱風換算ツール',
    relatedAirFryerTitle: 'エアフライヤー ↔ オーブン換算機 →',
    relatedAirFryerDesc: '通常オーブンレシピをエアフライヤーの温度・時間へ（および逆方向へ）瞬時に換算。',
    relatedInternalTag: 'USDA 安全加熱温度',
    relatedInternalTitle: '食品別・安全中心温度チャート →',
    relatedInternalDesc: '丸鶏・七面鳥・サーモン・ステーキ・グラタンのUSDA最低安全中心温度（63℃ / 71℃ / 74℃）を確認。',
    methodologyStripTitle: '調理熱力学および主要メーカー安全基準に基づく設計',
    methodologyStripPrefix: 'すべての-15℃調整ルール、コンベクション上限、グリル制限、熱衝撃ガイドはPyrex/Corning、Nordic Ware、Silpat、Lodge、King Arthur Bakingの公式指針に準拠しています。詳細は',
    methodologyLabel: '検証メソドロジー',
    internalQuickLabel: '中心温度チャート',
    allToolsLabel: 'すべてのツールを見る →',
    faqTitle: 'よくある質問：オーブン段位置・コンベクション・焼き型の安全性'
  }
};

const t = UI[lang] || UI.en;
const defaultUnit: 'F' | 'C' = lang === 'en' ? 'F' : 'C';
const defaultDish = localizedDishes[0];
const defaultMaterial = localizedMaterials[0];
const defaultRack = localizedRacks.find((r) => r.id === defaultDish.rackId) || localizedRacks[2];

function fToC(f: number): number {
  return Math.round(((f - 32) * 5) / 9);
}

const initialInputTemp = defaultUnit === 'F' ? defaultDish.baseTempF : fToC(defaultDish.baseTempF);
const initialTempC = fToC(defaultDish.baseTempF);
const initialCheckLow = Math.max(3, defaultDish.baseTimeMin - 1);

function getZoneBadgeClasses(color: string): string {
  if (color === 'red') return 'bg-red-500/20 text-red-200 border-red-400/40';
  if (color === 'amber') return 'bg-amber-500/20 text-amber-200 border-amber-400/40';
  if (color === 'emerald') return 'bg-emerald-500/20 text-emerald-200 border-emerald-400/40';
  if (color === 'sky') return 'bg-sky-500/20 text-sky-200 border-sky-400/40';
  return 'bg-orange-500/20 text-orange-200 border-orange-400/40';
}

const clientPayload = {
  lang,
  defaultUnit,
  defaultDishId: defaultDish.id,
  defaultMaterialId: defaultMaterial.id,
  materials: localizedMaterials,
  racks: localizedRacks,
  dishes: localizedDishes,
  ui: {
    copyBtn: t.copyBtn,
    copiedBtn: t.copiedBtn,
    minutesUnit: t.minutesUnit,
    modeConventional: t.modeConventional,
    modeConvection: t.modeConvection,
    broilerOff: t.broilerOff,
    broilerOn: t.broilerOn,
    slotPrefix: t.slotPrefix,
    activeRackTag: t.activeRackTag,
    recommendedRackTag: t.recommendedRackTag,
    unsafeBroilTag: t.unsafeBroilTag,
    outRecipePrefix: t.outRecipePrefix,
    outCheckEarlySuffix: t.outCheckEarlySuffix,
    outBroilHeadline: t.outBroilHeadline,
    outBroilSub: t.outBroilSub,
    outBroilTimeSub: t.outBroilTimeSub,
    outNoTempChange: t.outNoTempChange,
    outSiliconeTimeNote: t.outSiliconeTimeNote,
    outConvectionTimeNote: t.outConvectionTimeNote,
    outEarlyCheckNote: t.outEarlyCheckNote,
    outStandardTimeNote: t.outStandardTimeNote,
    statusSafeBadge: t.statusSafeBadge,
    statusCautionBadge: t.statusCautionBadge,
    statusDangerBadge: t.statusDangerBadge,
    alertBroilerTitle: t.alertBroilerTitle,
    alertBroilerBodyPrefix: t.alertBroilerBodyPrefix,
    alertBroilerBodySuffix: t.alertBroilerBodySuffix,
    alertMaxTempTitle: t.alertMaxTempTitle,
    alertMaxTempBodyPrefix: t.alertMaxTempBodyPrefix,
    alertMaxTempBodyMid: t.alertMaxTempBodyMid,
    alertMaxTempBodySuffix: t.alertMaxTempBodySuffix,
    alertCautionTempTitle: t.alertCautionTempTitle,
    alertCautionTempBodyPrefix: t.alertCautionTempBodyPrefix,
    alertCautionTempBodySuffix: t.alertCautionTempBodySuffix,
    alertThermalExtremeTitle: t.alertThermalExtremeTitle,
    alertThermalExtremeBody: t.alertThermalExtremeBody,
    alertThermalHighTitle: t.alertThermalHighTitle,
    alertThermalHighBody: t.alertThermalHighBody,
    alertDoubleDropTitle: t.alertDoubleDropTitle,
    alertDoubleDropBody: t.alertDoubleDropBody,
    alertBottomFoilTitle: t.alertBottomFoilTitle,
    alertBottomFoilBody: t.alertBottomFoilBody,
    alertCustardTitle: t.alertCustardTitle,
    alertCustardBody: t.alertCustardBody,
    matBrowningLabel: t.matBrowningLabel,
    copyHeader: t.copyHeader,
    copyDishLine: t.copyDishLine,
    copyMaterialLine: t.copyMaterialLine,
    copyModeLine: t.copyModeLine,
    copyTempLine: t.copyTempLine,
    copyTimeLine: t.copyTimeLine,
    copyRackLine: t.copyRackLine,
    copyAlertsLine: t.copyAlertsLine,
    copySafeLine: t.copySafeLine
  }
};
---

<div id="oven-rack-adjuster-root" class="space-y-12">
  <!-- Critical Oven & Bakeware Safety Rules Banner -->
  <aside
    class="p-5 sm:p-6 rounded-2xl bg-error-bg/65 dark:bg-red-950/35 border-2 border-error-border/80 shadow-sm space-y-4"
    role="note"
    aria-label={safetyBanner.badge}
  >
    <div class="space-y-1">
      <span class="inline-block px-2.5 py-0.5 rounded-full text-[11px] font-extrabold uppercase tracking-wider bg-error-border text-white">
        ⚠️ {safetyBanner.badge}
      </span>
      <h2 class="text-base sm:text-lg font-extrabold text-ink leading-snug">
        {safetyBanner.headline}
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      {safetyBanner.rules.map((rule) => (
        <div class="p-3.5 rounded-xl bg-canvas border border-hairline shadow-xs space-y-1.5">
          <div class="flex items-start gap-2">
            <span aria-hidden="true" class="text-lg leading-none mt-0.5 shrink-0">{rule.icon}</span>
            <h3 class="text-xs sm:text-[13px] font-extrabold text-ink leading-snug">{rule.title}</h3>
          </div>
          <p class="text-xs text-body leading-relaxed">{rule.body}</p>
        </div>
      ))}
    </div>
  </aside>

  <!-- Main Interactive Oven Rack & Bakeware Heat Adjuster Card -->
  <section
    id="oven-rack-bakeware-heat-adjuster"
    class="bg-canvas border border-hairline rounded-2xl shadow-sm overflow-hidden"
    aria-label={t.ariaLabel}
  >
    <script type="application/json" id="orbha-payload" set:html={JSON.stringify(clientPayload)} />

    <!-- PART 1: Header Actions + High-Contrast Dark Live Output Dashboard -->
    <div class="p-5 sm:p-6 border-b border-hairline bg-surface-soft/50 space-y-5">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div class="space-y-1 max-w-2xl">
          <span class="inline-block px-2.5 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wider bg-signature-coral text-white">
            🔥 {t.dashboardBadge}
          </span>
          <h2 class="text-title-md font-bold text-ink">{t.dashboardTitle}</h2>
          <p class="text-xs sm:text-[13px] text-muted leading-relaxed">{t.dashboardSub}</p>
        </div>

        <div class="flex flex-wrap items-center gap-2 print:hidden">
          <button
            type="button"
            id="orbha-copy-btn"
            class="min-h-[40px] px-3.5 py-2 rounded-xl text-xs font-semibold bg-primary text-on-primary hover:bg-primary-active transition-colors cursor-pointer shadow-sm"
          >
            <span id="orbha-copy-label">📋 {t.copyBtn}</span>
          </button>
          <button
            type="button"
            id="orbha-print-btn"
            class="min-h-[40px] px-3.5 py-2 rounded-xl text-xs font-semibold bg-canvas text-ink border border-hairline hover:border-signature-coral transition-colors cursor-pointer"
          >
            🖨️ {t.printBtn}
          </button>
          <button
            type="button"
            id="orbha-reset-btn"
            class="min-h-[40px] px-3 py-2 rounded-xl text-xs font-semibold bg-canvas text-muted border border-hairline hover:border-border-strong hover:text-ink transition-colors cursor-pointer"
          >
            {t.resetBtn}
          </button>
        </div>
      </div>

      <!-- High-Contrast Dark Output Dashboard -->
      <div
        id="orbha-dashboard"
        aria-live="polite"
        class="w-full rounded-2xl bg-surface-dark text-on-dark p-5 sm:p-6 space-y-5 shadow-sm border-l-4 border-success-border"
      >
        <!-- Status Row -->
        <div class="flex flex-wrap items-center justify-between gap-2.5">
          <div class="flex flex-wrap items-center gap-2">
            <span id="orbha-status-pill" class="badge-yes">
              {t.statusSafeBadge}
            </span>
            <span
              id="orbha-active-combo-badge"
              class="inline-flex items-center px-2.5 py-0.5 rounded-md border text-[11px] font-bold bg-white/10 text-white/90 border-white/20"
            >
              {defaultDish.icon} {defaultDish.name} · {defaultMaterial.icon} {defaultMaterial.shortName}
            </span>
          </div>
          <span
            id="orbha-mode-pill"
            class="inline-flex items-center px-2.5 py-0.5 rounded-md border text-[11px] font-bold bg-white/10 text-signature-mint border-white/20"
          >
            {t.modeConventional}
          </span>
        </div>

        <!-- Dynamic Active Safety Alerts Stack -->
        <div id="orbha-alerts-container" class="space-y-2.5 hidden" role="status"></div>

        <!-- 3 Live Output Metric Tiles -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-3.5">
          <!-- Adjusted Temp -->
          <div class="p-4 rounded-xl bg-white/6 border border-white/12 space-y-1.5">
            <span class="block text-[10.5px] font-bold uppercase tracking-wider text-signature-peach">
              🌡️ {t.outTempLabel}
            </span>
            <div class="flex items-baseline flex-wrap gap-2">
              <p id="orbha-out-temp-main" class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white">
                {defaultDish.baseTempF}°F / {initialTempC}°C
              </p>
            </div>
            <p id="orbha-out-temp-delta" class="text-xs font-bold text-signature-mint">
              {t.outNoTempChange}
            </p>
            <p id="orbha-out-temp-sub" class="text-[11.5px] text-white/75">
              {t.outRecipePrefix} {defaultDish.baseTempF}°F ({initialTempC}°C)
            </p>
          </div>

          <!-- Check-Early Time Window -->
          <div class="p-4 rounded-xl bg-white/6 border border-white/12 space-y-1.5">
            <span class="block text-[10.5px] font-bold uppercase tracking-wider text-signature-mint">
              ⏱️ {t.outTimeLabel}
            </span>
            <p id="orbha-out-time-main" class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white">
              {initialCheckLow}–{defaultDish.baseTimeMin} {t.minutesUnit}
            </p>
            <p id="orbha-out-time-note" class="text-xs font-semibold text-white/90">
              {t.outStandardTimeNote}
            </p>
            <p id="orbha-out-time-sub" class="text-[11.5px] text-white/75">
              {t.outRecipePrefix} {defaultDish.baseTimeMin} {t.minutesUnit}
            </p>
          </div>

          <!-- Recommended Rack Position -->
          <div class="p-4 rounded-xl bg-white/6 border border-white/12 space-y-1.5">
            <span class="block text-[10.5px] font-bold uppercase tracking-wider text-sky-300">
              📐 {t.outRackLabel}
            </span>
            <p id="orbha-out-rack-main" class="text-lg sm:text-xl font-extrabold tracking-tight text-white leading-snug">
              {defaultRack.shortName}
            </p>
            <span
              id="orbha-out-rack-zone"
              class={`inline-flex items-center px-2 py-0.5 rounded-md border text-[10.5px] font-bold ${getZoneBadgeClasses(defaultRack.heatZoneColor)}`}
            >
              {defaultRack.zoneBadge}
            </span>
            <p id="orbha-out-rack-slot" class="text-[11.5px] text-white/75">
              {t.slotPrefix} {defaultRack.slotNumber} / 5
            </p>
          </div>
        </div>

        <!-- Material Thermal Science + Dish Pro Tip Strip -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-3.5">
          <div class="lg:col-span-7 p-4 rounded-xl bg-white/6 border border-white/12 space-y-2">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span class="text-[10.5px] font-bold uppercase tracking-wider text-signature-peach">
                🧪 {t.matScienceLabel}: <span id="orbha-mat-title" class="text-white">{defaultMaterial.name}</span>
              </span>
              <span
                id="orbha-mat-rule-pill"
                class="px-2 py-0.5 rounded-md text-[10.5px] font-bold bg-white/10 text-signature-mint border border-white/15"
              >
                {defaultMaterial.tempRuleBadge}
              </span>
            </div>
            <p id="orbha-mat-browning" class="text-xs font-bold text-white/95">
              {t.matBrowningLabel}: {defaultMaterial.browningProfile}
            </p>
            <p id="orbha-mat-science" class="text-xs text-white/85 leading-relaxed">
              {defaultMaterial.scienceNote}
            </p>
          </div>

          <div class="lg:col-span-5 p-4 rounded-xl bg-white/6 border border-white/12 space-y-2.5">
            <div>
              <span class="block text-[10.5px] font-bold uppercase tracking-wider text-amber-200">
                🛡️ {t.matSafetyLabel}
              </span>
              <p id="orbha-mat-safety" class="text-xs text-white/90 leading-relaxed mt-1">
                {defaultMaterial.safetyNote}
              </p>
            </div>
            <div class="pt-2 border-t border-white/12">
              <span class="block text-[10.5px] font-bold uppercase tracking-wider text-signature-mint">
                💡 {t.dishTipLabel}
              </span>
              <p id="orbha-dish-tip" class="text-xs text-white/90 leading-relaxed mt-1">
                {defaultDish.tip}
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- PART 2: Interactive Controls (Presets, Temp/Time/Fan/Broiler, 6 Bakeware Cards, 5-Rack Oven Schematic) -->
    <div class="p-5 sm:p-6 space-y-8">
      <!-- Step 1: 10 Popular Dish Presets -->
      <div class="space-y-3 print:hidden">
        <div class="space-y-0.5">
          <h3 class="text-sm sm:text-[15px] font-bold text-ink">{t.presetsLabel}</h3>
          <p class="text-xs text-muted">{t.presetsHint}</p>
        </div>
        <div class="flex flex-wrap gap-2" role="group" aria-label={t.presetsLabel}>
          {localizedDishes.map((dish, idx) => (
            <button
              type="button"
              data-orbha-dish={dish.id}
              aria-pressed={idx === 0 ? 'true' : 'false'}
              class={`orbha-dish-btn min-h-[38px] px-3 py-1.5 rounded-xl text-xs font-bold border transition-all cursor-pointer flex items-center gap-1.5 ${
                idx === 0
                  ? 'bg-primary text-on-primary border-primary shadow-sm'
                  : 'bg-surface-soft text-ink border-hairline hover:border-signature-coral'
              }`}
            >
              <span aria-hidden="true">{dish.icon}</span>
              <span>{dish.name}</span>
            </button>
          ))}
        </div>
      </div>

      <!-- Step 2: Recipe Temp, Time, Convection & Broiler Controls -->
      <div class="space-y-3.5 pt-2 border-t border-hairline print:hidden">
        <h3 class="text-sm sm:text-[15px] font-bold text-ink">{t.inputsHeading}</h3>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <!-- Recipe Temperature + °F / °C Toggle -->
          <div class="p-4 rounded-xl bg-surface-soft border border-hairline space-y-2.5">
            <div class="flex items-center justify-between gap-2">
              <label for="orbha-temp-input" class="text-xs font-bold text-ink">
                {t.recipeTempLabel}
              </label>
              <div class="inline-flex rounded-lg border border-hairline bg-canvas p-0.5" role="group" aria-label="Temperature unit">
                <button
                  type="button"
                  data-orbha-unit="F"
                  aria-pressed={defaultUnit === 'F' ? 'true' : 'false'}
                  class={`orbha-unit-btn px-2 py-0.5 rounded-md text-[11px] font-extrabold cursor-pointer transition-colors ${
                    defaultUnit === 'F' ? 'bg-primary text-on-primary' : 'text-muted hover:text-ink'
                  }`}
                >
                  °F
                </button>
                <button
                  type="button"
                  data-orbha-unit="C"
                  aria-pressed={defaultUnit === 'C' ? 'true' : 'false'}
                  class={`orbha-unit-btn px-2 py-0.5 rounded-md text-[11px] font-extrabold cursor-pointer transition-colors ${
                    defaultUnit === 'C' ? 'bg-primary text-on-primary' : 'text-muted hover:text-ink'
                  }`}
                >
                  °C
                </button>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <input
                id="orbha-temp-input"
                type="number"
                min={defaultUnit === 'F' ? 200 : 95}
                max={defaultUnit === 'F' ? 525 : 275}
                step={5}
                value={initialInputTemp}
                class="w-full min-h-[42px] px-3 py-1.5 rounded-xl bg-canvas border border-hairline text-base font-extrabold text-ink focus:outline-none focus:border-signature-coral focus:ring-2 focus:ring-signature-coral/25"
              />
              <span id="orbha-temp-unit-suffix" class="text-sm font-extrabold text-muted shrink-0">
                °{defaultUnit}
              </span>
            </div>
            <input
              id="orbha-temp-slider"
              type="range"
              min="200"
              max="525"
              step="5"
              value={defaultDish.baseTempF}
              aria-label={t.recipeTempLabel}
              class="w-full accent-signature-coral cursor-pointer"
            />
          </div>

          <!-- Recipe Bake Time (5–240 min) -->
          <div class="p-4 rounded-xl bg-surface-soft border border-hairline space-y-2.5">
            <label for="orbha-time-input" class="block text-xs font-bold text-ink">
              {t.recipeTimeLabel}
            </label>
            <div class="flex items-center gap-2">
              <input
                id="orbha-time-input"
                type="number"
                min="5"
                max="240"
                step="1"
                value={defaultDish.baseTimeMin}
                class="w-full min-h-[42px] px-3 py-1.5 rounded-xl bg-canvas border border-hairline text-base font-extrabold text-ink focus:outline-none focus:border-signature-coral focus:ring-2 focus:ring-signature-coral/25"
              />
              <span class="text-xs font-bold text-muted shrink-0">{t.minutesUnit}</span>
            </div>
            <input
              id="orbha-time-slider"
              type="range"
              min="5"
              max="240"
              step="1"
              value={defaultDish.baseTimeMin}
              aria-label={t.recipeTimeLabel}
              class="w-full accent-signature-coral cursor-pointer"
            />
          </div>

          <!-- Convection Fan Mode Toggle -->
          <div class="p-4 rounded-xl bg-surface-soft border border-hairline space-y-2.5">
            <span class="block text-xs font-bold text-ink">{t.ovenModeLabel}</span>
            <div class="grid grid-cols-1 gap-2" role="group" aria-label={t.ovenModeLabel}>
              <button
                type="button"
                id="orbha-conv-off-btn"
                aria-pressed="true"
                class="min-h-[38px] px-3 py-1.5 rounded-xl text-xs font-bold border transition-all cursor-pointer text-left bg-primary text-on-primary border-primary shadow-sm"
              >
                🔥 {t.modeConventional}
              </button>
              <button
                type="button"
                id="orbha-conv-on-btn"
                aria-pressed="false"
                class="min-h-[38px] px-3 py-1.5 rounded-xl text-xs font-bold border transition-all cursor-pointer text-left bg-canvas text-ink border-hairline hover:border-signature-coral"
              >
                🌀 {t.modeConvection}
              </button>
            </div>
          </div>

          <!-- Broiler Mode Toggle -->
          <div class="p-4 rounded-xl bg-surface-soft border border-hairline space-y-2.5">
            <span class="block text-xs font-bold text-ink">{t.broilerToggleLabel}</span>
            <div class="grid grid-cols-1 gap-2" role="group" aria-label={t.broilerToggleLabel}>
              <button
                type="button"
                id="orbha-broil-off-btn"
                aria-pressed="true"
                class="min-h-[38px] px-3 py-1.5 rounded-xl text-xs font-bold border transition-all cursor-pointer text-left bg-primary text-on-primary border-primary shadow-sm"
              >
                ✅ {t.broilerOff}
              </button>
              <button
                type="button"
                id="orbha-broil-on-btn"
                aria-pressed="false"
                class="min-h-[38px] px-3 py-1.5 rounded-xl text-xs font-bold border transition-all cursor-pointer text-left bg-canvas text-ink border-hairline hover:border-error-border"
              >
                🔥 {t.broilerOn}
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Step 3: 6 Bakeware Material Cards -->
      <div class="space-y-3 pt-2 border-t border-hairline">
        <div class="space-y-0.5">
          <h3 class="text-sm sm:text-[15px] font-bold text-ink">{t.materialHeading}</h3>
          <p class="text-xs text-muted">{t.materialSub}</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3.5" role="group" aria-label={t.materialHeading}>
          {localizedMaterials.map((mat, idx) => (
            <button
              type="button"
              data-orbha-mat={mat.id}
              aria-pressed={idx === 0 ? 'true' : 'false'}
              class={`orbha-mat-card text-left w-full p-4 rounded-2xl border transition-all cursor-pointer flex flex-col justify-between gap-2.5 ${
                idx === 0
                  ? 'bg-canvas border-signature-coral ring-2 ring-signature-coral shadow-sm'
                  : 'bg-surface-soft/65 border-hairline hover:border-signature-coral'
              }`}
            >
              <div class="space-y-2">
                <div class="flex items-start justify-between gap-2">
                  <div class="flex items-start gap-2 min-w-0">
                    <span aria-hidden="true" class="text-xl leading-none mt-0.5 shrink-0">{mat.icon}</span>
                    <div class="min-w-0">
                      <h4 class="text-sm font-bold text-ink leading-snug">{mat.name}</h4>
                      <span class="inline-block mt-1 px-2 py-0.5 rounded-md text-[10.5px] font-extrabold bg-surface-soft border border-hairline text-ink">
                        {mat.tempRuleBadge}
                      </span>
                    </div>
                  </div>
                </div>
                <p class="text-[11.5px] text-muted leading-snug">{mat.examples}</p>
              </div>

              <div class="pt-2 border-t border-hairline/70 flex flex-wrap items-center justify-between gap-1.5 text-[11px] font-bold">
                <span class="text-muted">
                  🌡️ {t.maxTempPrefix}: {mat.maxSafeTempF >= 550 ? '500°F+ (260°C+)' : `${mat.cautionTempF}–${mat.maxSafeTempF}°F (${fToC(mat.cautionTempF)}–${fToC(mat.maxSafeTempF)}°C)`}
                </span>
                <span class={mat.broilerSafe ? 'text-emerald-700 dark:text-emerald-300' : 'text-red-700 dark:text-red-300'}>
                  {mat.broilerSafe ? `✓ ${t.broilerSafeYes}` : `✕ ${t.broilerSafeNo}`}
                </span>
              </div>
            </button>
          ))}
        </div>
      </div>

      <!-- Step 4: Interactive Visual 5-Rack Oven Cavity Diagram + Rack Physics Inspector -->
      <div class="space-y-4 pt-2 border-t border-hairline">
        <div class="space-y-0.5">
          <h3 class="text-sm sm:text-[15px] font-bold text-ink">{t.rackDiagramHeading}</h3>
          <p class="text-xs text-muted">{t.rackDiagramSub}</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-stretch">
          <!-- Left: Visual Stacked Oven Cavity Schematic -->
          <div class="lg:col-span-7 rounded-2xl bg-surface-dark text-on-dark p-4 sm:p-5 border-2 border-white/15 shadow-sm flex flex-col justify-between gap-3">
            <!-- Top Broiler Heating Coil Visual -->
            <div
              id="orbha-broiler-coil"
              class="rounded-xl px-3.5 py-2.5 border text-center transition-all bg-red-500/12 border-red-400/35 text-red-200"
            >
              <div class="flex items-center justify-center gap-2 text-[11px] font-extrabold uppercase tracking-wider">
                <span aria-hidden="true">〰️🔥〰️</span>
                <span>{t.topBroilerElement}</span>
                <span aria-hidden="true">〰️🔥〰️</span>
              </div>
            </div>

            <!-- 5 Stacked Interactive Oven Rack Slots -->
            <div class="space-y-2.5" role="group" aria-label={t.rackDiagramHeading}>
              {localizedRacks.map((rack) => {
                const isSelected = rack.id === defaultRack.id;
                return (
                  <button
                    type="button"
                    data-orbha-rack={rack.id}
                    aria-pressed={isSelected ? 'true' : 'false'}
                    class={`orbha-rack-btn w-full text-left rounded-xl p-3 border transition-all cursor-pointer ${
                      isSelected
                        ? 'bg-white/14 border-signature-coral ring-2 ring-signature-coral shadow-sm'
                        : 'bg-white/5 border-white/12 hover:bg-white/10 hover:border-white/30'
                    }`}
                  >
                    <div class="flex flex-wrap items-center justify-between gap-2 mb-1.5">
                      <div class="flex items-center gap-2">
                        <span class="inline-flex items-center justify-center w-6 h-6 rounded-md bg-white/12 text-[11px] font-extrabold text-white shrink-0">
                          {rack.slotNumber}
                        </span>
                        <span class="text-xs sm:text-[13px] font-extrabold text-white">
                          {rack.shortName}
                        </span>
                      </div>

                      <div class="flex flex-wrap items-center gap-1.5">
                        <span class={`px-2 py-0.5 rounded-md border text-[10px] font-bold ${getZoneBadgeClasses(rack.heatZoneColor)}`}>
                          {rack.zoneBadge}
                        </span>
                        <span
                          data-orbha-rack-status={rack.id}
                          class={`px-2 py-0.5 rounded-md text-[10px] font-extrabold uppercase tracking-wider ${
                            isSelected ? 'bg-signature-coral text-white' : 'hidden'
                          }`}
                        >
                          {t.activeRackTag}
                        </span>
                      </div>
                    </div>

                    <!-- Metallic Wire Rack Bar Graphic -->
                    <div class="w-full h-1.5 rounded-full bg-white/15 overflow-hidden relative">
                      <div
                        data-orbha-rack-bar={rack.id}
                        class={`h-full transition-all ${isSelected ? 'w-full bg-signature-coral' : 'w-1/4 bg-white/30'}`}
                      />
                    </div>
                  </button>
                );
              })}
            </div>

            <!-- Oven Floor Warning Bar -->
            <div class="rounded-xl px-3.5 py-2.5 bg-amber-500/12 border border-amber-400/35 text-center">
              <p class="text-[11px] font-extrabold uppercase tracking-wider text-amber-200">
                🚫 {t.ovenFloorWarning}
              </p>
            </div>
          </div>

          <!-- Right: Selected Rack Thermodynamics & Safety Details -->
          <div class="lg:col-span-5 rounded-2xl bg-surface-soft border border-hairline p-5 flex flex-col justify-between gap-4">
            <div class="space-y-4">
              <div class="space-y-1.5">
                <div class="flex flex-wrap items-center gap-2">
                  <span
                    id="orbha-rack-detail-slot"
                    class="inline-block px-2.5 py-0.5 rounded-full text-[11px] font-extrabold uppercase tracking-wider bg-primary text-on-primary"
                  >
                    {t.slotPrefix} {defaultRack.slotNumber} / 5
                  </span>
                  <span
                    id="orbha-rack-detail-zone"
                    class="inline-block px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-canvas border border-hairline text-ink"
                  >
                    {defaultRack.zoneBadge}
                  </span>
                </div>
                <h4 id="orbha-rack-detail-name" class="text-base sm:text-lg font-extrabold text-ink leading-snug">
                  {defaultRack.name}
                </h4>
              </div>

              <div class="p-3.5 rounded-xl bg-canvas border border-hairline space-y-1">
                <span class="block text-[11px] font-extrabold uppercase tracking-wider text-signature-coral">
                  🍽️ {t.rackBestForLabel}
                </span>
                <p id="orbha-rack-detail-best" class="text-xs sm:text-[13px] text-body leading-relaxed">
                  {defaultRack.bestFor}
                </p>
              </div>

              <div class="p-3.5 rounded-xl bg-canvas border border-hairline space-y-1">
                <span class="block text-[11px] font-extrabold uppercase tracking-wider text-ink">
                  💨 {t.rackAirflowLabel}
                </span>
                <p id="orbha-rack-detail-airflow" class="text-xs sm:text-[13px] text-body leading-relaxed">
                  {defaultRack.airflowNote}
                </p>
              </div>
            </div>

            <div class="p-3.5 rounded-xl bg-error-bg/55 dark:bg-red-950/35 border border-error-border/70 space-y-1">
              <span class="block text-[11px] font-extrabold uppercase tracking-wider text-error-border dark:text-red-300">
                ⚠️ {t.rackWarningLabel}
              </span>
              <p id="orbha-rack-detail-warning" class="text-xs sm:text-[13px] font-semibold text-ink leading-relaxed">
                {defaultRack.warning}
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Related Companion Tools -->
  <section class="space-y-4 print:hidden">
    <h2 class="text-title-md font-semibold text-ink">{t.relatedHeading}</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      <a
        href={cookwareLookupUrl}
        class="p-6 rounded-2xl bg-surface-soft border border-hairline hover:border-signature-coral transition-all group block"
      >
        <span class="text-[11px] font-bold uppercase tracking-wider text-signature-coral block mb-1.5">
          {t.relatedCookwareTag}
        </span>
        <h3 class="text-title-sm font-semibold text-ink group-hover:text-signature-coral transition-colors mb-1.5">
          {t.relatedCookwareTitle}
        </h3>
        <p class="text-[13.5px] text-body leading-relaxed">{t.relatedCookwareDesc}</p>
      </a>

      <a
        href={airFryerUrl}
        class="p-6 rounded-2xl bg-surface-soft border border-hairline hover:border-signature-coral transition-all group block"
      >
        <span class="text-[11px] font-bold uppercase tracking-wider text-signature-coral block mb-1.5">
          {t.relatedAirFryerTag}
        </span>
        <h3 class="text-title-sm font-semibold text-ink group-hover:text-signature-coral transition-colors mb-1.5">
          {t.relatedAirFryerTitle}
        </h3>
        <p class="text-[13.5px] text-body leading-relaxed">{t.relatedAirFryerDesc}</p>
      </a>

      <a
        href={internalTempUrl}
        class="p-6 rounded-2xl bg-surface-soft border border-hairline hover:border-signature-coral transition-all group block"
      >
        <span class="text-[11px] font-bold uppercase tracking-wider text-signature-coral block mb-1.5">
          {t.relatedInternalTag}
        </span>
        <h3 class="text-title-sm font-semibold text-ink group-hover:text-signature-coral transition-colors mb-1.5">
          {t.relatedInternalTitle}
        </h3>
        <p class="text-[13.5px] text-body leading-relaxed">{t.relatedInternalDesc}</p>
      </a>
    </div>
  </section>

  <!-- Methodology & Hub Strip -->
  <section class="p-6 rounded-2xl bg-surface-soft border border-hairline print:hidden">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <h2 class="text-title-sm font-semibold text-ink mb-1">{t.methodologyStripTitle}</h2>
        <p class="text-[13px] text-muted">
          {t.methodologyStripPrefix}{' '}
          <a href={methodologyUrl} class="text-link underline hover:text-link-active">{t.methodologyLabel}</a>.
        </p>
      </div>
      <div class="flex flex-wrap gap-2">
        <a
          href={internalTempUrl}
          class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral transition-colors"
        >
          {t.internalQuickLabel}
        </a>
        <a
          href={methodologyUrl}
          class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral transition-colors"
        >
          {t.methodologyLabel}
        </a>
        <a
          href={allToolsUrl}
          class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-primary text-on-primary hover:bg-primary-active transition-colors"
        >
          {t.allToolsLabel}
        </a>
      </div>
    </div>
  </section>

  <!-- Visible FAQ Accordion (Matches JSON-LD 1:1) -->
  <section class="print:hidden">
    <h2 class="text-title-lg font-medium text-ink tracking-tight mb-6">
      {t.faqTitle}
    </h2>
    <div class="space-y-4">
      {localizedFaqs.map((faq) => (
        <details class="group p-5 bg-surface-soft border border-hairline rounded-xl" open>
          <summary class="text-title-sm font-semibold text-ink cursor-pointer list-none flex items-center justify-between gap-3">
            <span>{faq.question}</span>
            <span class="text-muted text-sm transition-transform group-open:rotate-180 shrink-0" aria-hidden="true">&#9662;</span>
          </summary>
          <p class="text-[14px] text-body leading-relaxed mt-3 pt-3 border-t border-hairline/70">
            {faq.answer}
          </p>
        </details>
      ))}
    </div>
  </section>
</div>

<script is:inline>
  (function () {
    var payloadEl = document.getElementById('orbha-payload');
    if (!payloadEl) return;

    var payload;
    try {
      payload = JSON.parse(payloadEl.textContent || '{}');
    } catch (_) {
      return;
    }

    var materials = Array.isArray(payload.materials) ? payload.materials : [];
    var racks = Array.isArray(payload.racks) ? payload.racks : [];
    var dishes = Array.isArray(payload.dishes) ? payload.dishes : [];
    var ui = payload.ui || {};

    var materialMap = {};
    materials.forEach(function (m) {
      if (m && m.id) materialMap[m.id] = m;
    });

    var rackMap = {};
    racks.forEach(function (r) {
      if (r && r.id) rackMap[r.id] = r;
    });

    var dishMap = {};
    dishes.forEach(function (d) {
      if (d && d.id) dishMap[d.id] = d;
    });

    // Elements
    var elDashboard = document.getElementById('orbha-dashboard');
    var elStatusPill = document.getElementById('orbha-status-pill');
    var elComboBadge = document.getElementById('orbha-active-combo-badge');
    var elModePill = document.getElementById('orbha-mode-pill');
    var elAlerts = document.getElementById('orbha-alerts-container');

    var elOutTempMain = document.getElementById('orbha-out-temp-main');
    var elOutTempDelta = document.getElementById('orbha-out-temp-delta');
    var elOutTempSub = document.getElementById('orbha-out-temp-sub');
    var elOutTimeMain = document.getElementById('orbha-out-time-main');
    var elOutTimeNote = document.getElementById('orbha-out-time-note');
    var elOutTimeSub = document.getElementById('orbha-out-time-sub');
    var elOutRackMain = document.getElementById('orbha-out-rack-main');
    var elOutRackZone = document.getElementById('orbha-out-rack-zone');
    var elOutRackSlot = document.getElementById('orbha-out-rack-slot');

    var elMatTitle = document.getElementById('orbha-mat-title');
    var elMatRulePill = document.getElementById('orbha-mat-rule-pill');
    var elMatBrowning = document.getElementById('orbha-mat-browning');
    var elMatScience = document.getElementById('orbha-mat-science');
    var elMatSafety = document.getElementById('orbha-mat-safety');
    var elDishTip = document.getElementById('orbha-dish-tip');

    var elBroilerCoil = document.getElementById('orbha-broiler-coil');
    var elRackDetailSlot = document.getElementById('orbha-rack-detail-slot');
    var elRackDetailZone = document.getElementById('orbha-rack-detail-zone');
    var elRackDetailName = document.getElementById('orbha-rack-detail-name');
    var elRackDetailBest = document.getElementById('orbha-rack-detail-best');
    var elRackDetailAirflow = document.getElementById('orbha-rack-detail-airflow');
    var elRackDetailWarning = document.getElementById('orbha-rack-detail-warning');

    var dishBtns = Array.from(document.querySelectorAll('.orbha-dish-btn'));
    var unitBtns = Array.from(document.querySelectorAll('.orbha-unit-btn'));
    var matCards = Array.from(document.querySelectorAll('.orbha-mat-card'));
    var rackBtns = Array.from(document.querySelectorAll('.orbha-rack-btn'));

    var tempInput = document.getElementById('orbha-temp-input');
    var tempSlider = document.getElementById('orbha-temp-slider');
    var tempUnitSuffix = document.getElementById('orbha-temp-unit-suffix');
    var timeInput = document.getElementById('orbha-time-input');
    var timeSlider = document.getElementById('orbha-time-slider');

    var convOffBtn = document.getElementById('orbha-conv-off-btn');
    var convOnBtn = document.getElementById('orbha-conv-on-btn');
    var broilOffBtn = document.getElementById('orbha-broil-off-btn');
    var broilOnBtn = document.getElementById('orbha-broil-on-btn');

    var copyBtn = document.getElementById('orbha-copy-btn');
    var copyLabel = document.getElementById('orbha-copy-label');
    var printBtn = document.getElementById('orbha-print-btn');
    var resetBtn = document.getElementById('orbha-reset-btn');

    var initialDish = dishMap[payload.defaultDishId] || dishes[0];
    var initialMat = materialMap[payload.defaultMaterialId] || materials[0];

    var state = {
      dishId: initialDish ? initialDish.id : 'cookies',
      materialId: initialMat ? initialMat.id : 'bright-aluminum',
      rackId: initialDish ? initialDish.rackId : 'center',
      recipeTempF: initialDish ? Number(initialDish.baseTempF) : 350,
      recipeTimeMin: initialDish ? Number(initialDish.baseTimeMin) : 11,
      unit: payload.defaultUnit === 'C' ? 'C' : 'F',
      convection: false,
      broiler: initialDish ? Boolean(initialDish.broiler) : false
    };

    function fToC(f) {
      return Math.round(((f - 32) * 5) / 9);
    }

    function cToF(c) {
      return Math.round((c * 9) / 5 + 32);
    }

    function clamp(val, min, max) {
      if (isNaN(val)) return min;
      return Math.max(min, Math.min(max, val));
    }

    function roundTo5(n) {
      return Math.round(n / 5) * 5;
    }

    function formatTempPair(f) {
      var c = fToC(f);
      if (state.unit === 'C') {
        return c + '°C / ' + f + '°F';
      }
      return f + '°F / ' + c + '°C';
    }

    function formatDeltaPair(deltaF) {
      if (deltaF === 0) return ui.outNoTempChange || '0°F (0°C) baseline';
      var deltaC = Math.round((deltaF * 5) / 9);
      var sign = deltaF > 0 ? '+' : '';
      if (state.unit === 'C') {
        return sign + deltaC + '°C (' + sign + deltaF + '°F)';
      }
      return sign + deltaF + '°F (' + sign + deltaC + '°C)';
    }

    function getZoneClasses(color) {
      if (color === 'red') return 'bg-red-500/20 text-red-200 border-red-400/40';
      if (color === 'amber') return 'bg-amber-500/20 text-amber-200 border-amber-400/40';
      if (color === 'emerald') return 'bg-emerald-500/20 text-emerald-200 border-emerald-400/40';
      if (color === 'sky') return 'bg-sky-500/20 text-sky-200 border-sky-400/40';
      return 'bg-orange-500/20 text-orange-200 border-orange-400/40';
    }

    function setToggleBtnState(btn, active, activeDanger) {
      if (!btn) return;
      btn.setAttribute('aria-pressed', active ? 'true' : 'false');
      btn.classList.remove(
        'bg-primary',
        'text-on-primary',
        'border-primary',
        'bg-error-border',
        'text-white',
        'border-error-border',
        'shadow-sm',
        'bg-canvas',
        'text-ink',
        'border-hairline'
      );
      if (active) {
        if (activeDanger) {
          btn.classList.add('bg-error-border', 'text-white', 'border-error-border', 'shadow-sm');
        } else {
          btn.classList.add('bg-primary', 'text-on-primary', 'border-primary', 'shadow-sm');
        }
      } else {
        btn.classList.add('bg-canvas', 'text-ink', 'border-hairline');
      }
    }

    function computeResult() {
      var mat = materialMap[state.materialId] || materials[0];
      var rack = rackMap[state.rackId] || racks[2];
      var dish = dishMap[state.dishId] || dishes[0];

      var baseTempF = clamp(Number(state.recipeTempF), 200, 525);
      var baseTime = clamp(Number(state.recipeTimeMin), 5, 240);

      var totalDeltaF = 0;
      var doubleDropCapped = false;
      var adjustedTempF = baseTempF;
      var effectiveTempF = baseTempF;
      var timeLow = baseTime;
      var timeHigh = baseTime;
      var timeNote = ui.outStandardTimeNote || '';

      if (state.broiler) {
        effectiveTempF = 525;
        adjustedTempF = 525;
        timeLow = Math.max(2, Math.round(baseTime * 0.6));
        timeHigh = baseTime;
        timeNote = ui.outBroilTimeSub || '';
      } else {
        var matDelta = Number(mat.tempDeltaF || 0);
        var convDelta = state.convection ? -25 : 0;
        var rawDelta = matDelta + convDelta;

        if (state.convection && matDelta < 0) {
          totalDeltaF = -35;
          doubleDropCapped = true;
        } else {
          totalDeltaF = rawDelta;
        }

        adjustedTempF = Math.max(175, roundTo5(baseTempF + totalDeltaF));
        effectiveTempF = adjustedTempF;

        if (state.convection) {
          if (doubleDropCapped) {
            timeLow = Math.max(3, Math.round(baseTime * 0.75));
            timeHigh = Math.max(timeLow + 1, Math.round(baseTime * 0.9));
            timeNote = ui.outConvectionTimeNote || '';
          } else if (mat.id === 'silicone') {
            timeLow = Math.max(3, Math.round(baseTime * 0.85));
            timeHigh = baseTime + 2;
            timeNote = ui.outSiliconeTimeNote || '';
          } else {
            timeLow = Math.max(3, Math.round(baseTime * 0.8));
            timeHigh = Math.max(timeLow + 1, Math.round(baseTime * 0.95));
            timeNote = ui.outConvectionTimeNote || '';
          }
        } else {
          if (mat.id === 'silicone') {
            timeLow = baseTime + 3;
            timeHigh = baseTime + 5;
            timeNote = ui.outSiliconeTimeNote || '';
          } else if (Number(mat.timeDeltaMin || 0) < 0) {
            var earlyShift = Math.min(Math.abs(Number(mat.timeDeltaMin)), Math.max(1, Math.round(baseTime * 0.2)));
            timeLow = Math.max(3, baseTime - earlyShift);
            timeHigh = baseTime;
            timeNote = ui.outEarlyCheckNote || '';
          } else {
            timeLow = Math.max(3, baseTime - (baseTime >= 20 ? 2 : 1));
            timeHigh = baseTime;
            timeNote = ui.outStandardTimeNote || '';
          }
        }
      }

      var alerts = [];
      var severity = 'safe'; // 'safe' | 'caution' | 'danger'

      var isBroilerUnsafe = (state.broiler || rack.id === 'top-broil') && !mat.broilerSafe;
      if (isBroilerUnsafe) {
        severity = 'danger';
        alerts.push({
          level: 'danger',
          icon: '🚨',
          title: ui.alertBroilerTitle || 'UNSAFE FOR BROILER!',
          body: mat.name + ' ' + (ui.alertBroilerBodyPrefix || '') + ' ' + (ui.alertBroilerBodySuffix || '')
        });
      }

      var isMaxExceeded = !state.broiler && effectiveTempF > Number(mat.maxSafeTempF || 500);
      var isCautionTemp = !state.broiler && !isMaxExceeded && effectiveTempF > Number(mat.cautionTempF || 500);

      if (isMaxExceeded) {
        severity = 'danger';
        alerts.push({
          level: 'danger',
          icon: '🔥',
          title: ui.alertMaxTempTitle || 'MAX BAKEWARE TEMP EXCEEDED!',
          body:
            (ui.alertMaxTempBodyPrefix || '') +
            ' (' +
            formatTempPair(effectiveTempF) +
            ') ' +
            (ui.alertMaxTempBodyMid || '') +
            ' ' +
            mat.name +
            ' (' +
            formatTempPair(Number(mat.maxSafeTempF)) +
            '). ' +
            (ui.alertMaxTempBodySuffix || '')
        });
      } else if (isCautionTemp) {
        if (severity !== 'danger') severity = 'caution';
        alerts.push({
          level: 'caution',
          icon: '⚠️',
          title: ui.alertCautionTempTitle || 'APPROACHING MAX TEMP',
          body:
            (ui.alertCautionTempBodyPrefix || '') +
            ' ' +
            mat.name +
            ' (' +
            formatTempPair(Number(mat.cautionTempF)) +
            '–' +
            formatTempPair(Number(mat.maxSafeTempF)) +
            '). ' +
            (ui.alertCautionTempBodySuffix || '')
        });
      }

      if (mat.thermalShockRisk === 'extreme') {
        if (severity === 'safe') severity = 'caution';
        alerts.push({
          level: 'caution',
          icon: '💥',
          title: ui.alertThermalExtremeTitle || 'EXTREME THERMAL SHOCK WARNING',
          body: ui.alertThermalExtremeBody || ''
        });
      } else if (mat.thermalShockRisk === 'high') {
        alerts.push({
          level: 'info',
          icon: '🏺',
          title: ui.alertThermalHighTitle || 'THERMAL SHOCK CAUTION',
          body: ui.alertThermalHighBody || ''
        });
      }

      if (doubleDropCapped) {
        alerts.push({
          level: 'info',
          icon: '🧠',
          title: ui.alertDoubleDropTitle || 'DOUBLE-DROP CAP ACTIVE',
          body: ui.alertDoubleDropBody || ''
        });
      }

      if (rack.id === 'bottom') {
        alerts.push({
          level: 'info',
          icon: '🚫',
          title: ui.alertBottomFoilTitle || 'NEVER PUT FOIL ON OVEN FLOOR',
          body: ui.alertBottomFoilBody || ''
        });
      }

      if (dish && dish.id === 'cheesecake-custard' && state.convection && !state.broiler) {
        alerts.push({
          level: 'info',
          icon: '🍮',
          title: ui.alertCustardTitle || 'CUSTARD TIP',
          body: ui.alertCustardBody || ''
        });
      }

      return {
        mat: mat,
        rack: rack,
        dish: dish,
        baseTempF: baseTempF,
        baseTime: baseTime,
        adjustedTempF: adjustedTempF,
        totalDeltaF: totalDeltaF,
        doubleDropCapped: doubleDropCapped,
        timeLow: timeLow,
        timeHigh: timeHigh,
        timeNote: timeNote,
        severity: severity,
        alerts: alerts,
        isBroilerUnsafe: isBroilerUnsafe
      };
    }

    function syncInputs(skipField) {
      if (tempUnitSuffix) tempUnitSuffix.textContent = '°' + state.unit;

      if (tempInput && skipField !== 'tempInput') {
        if (state.unit === 'C') {
          tempInput.min = '95';
          tempInput.max = '275';
          tempInput.value = String(fToC(state.recipeTempF));
        } else {
          tempInput.min = '200';
          tempInput.max = '525';
          tempInput.value = String(state.recipeTempF);
        }
      }
      if (tempSlider && skipField !== 'tempSlider') {
        tempSlider.value = String(state.recipeTempF);
      }
      if (timeInput && skipField !== 'timeInput') {
        timeInput.value = String(state.recipeTimeMin);
      }
      if (timeSlider && skipField !== 'timeSlider') {
        timeSlider.value = String(state.recipeTimeMin);
      }

      unitBtns.forEach(function (btn) {
        var u = btn.getAttribute('data-orbha-unit');
        var active = u === state.unit;
        btn.setAttribute('aria-pressed', active ? 'true' : 'false');
        btn.classList.toggle('bg-primary', active);
        btn.classList.toggle('text-on-primary', active);
        btn.classList.toggle('text-muted', !active);
      });

      setToggleBtnState(convOffBtn, !state.convection, false);
      setToggleBtnState(convOnBtn, state.convection, false);
      setToggleBtnState(broilOffBtn, !state.broiler, false);
      setToggleBtnState(broilOnBtn, state.broiler, true);
    }

    function renderAlerts(alerts) {
      if (!elAlerts) return;
      while (elAlerts.firstChild) {
        elAlerts.removeChild(elAlerts.firstChild);
      }
      if (!alerts || alerts.length === 0) {
        elAlerts.classList.add('hidden');
        return;
      }
      elAlerts.classList.remove('hidden');

      alerts.forEach(function (alert) {
        var box = document.createElement('div');
        var colorClasses =
          alert.level === 'danger'
            ? 'bg-red-500/20 border-red-400/70 text-red-100'
            : alert.level === 'caution'
              ? 'bg-amber-500/18 border-amber-400/55 text-amber-100'
              : 'bg-sky-500/15 border-sky-400/40 text-sky-100';
        box.className = 'p-3.5 rounded-xl border space-y-1 ' + colorClasses;

        var titleEl = document.createElement('p');
        titleEl.className = 'text-xs font-extrabold tracking-wide uppercase';
        titleEl.textContent = (alert.icon ? alert.icon + ' ' : '') + alert.title;

        var bodyEl = document.createElement('p');
        bodyEl.className = 'text-xs leading-relaxed text-white/95';
        bodyEl.textContent = alert.body;

        box.appendChild(titleEl);
        box.appendChild(bodyEl);
        elAlerts.appendChild(box);
      });
    }

    function render(skipField) {
      syncInputs(skipField);
      var res = computeResult();

      // Dashboard border & status pill
      if (elDashboard) {
        elDashboard.classList.remove('border-success-border', 'border-amber-400', 'border-error-border');
        if (res.severity === 'danger') {
          elDashboard.classList.add('border-error-border');
        } else if (res.severity === 'caution') {
          elDashboard.classList.add('border-amber-400');
        } else {
          elDashboard.classList.add('border-success-border');
        }
      }

      if (elStatusPill) {
        if (res.severity === 'danger') {
          elStatusPill.className = 'badge-no';
          elStatusPill.textContent = ui.statusDangerBadge || 'HAZARD';
        } else if (res.severity === 'caution') {
          elStatusPill.className = 'inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-extrabold uppercase tracking-wider bg-amber-500 text-slate-950';
          elStatusPill.textContent = ui.statusCautionBadge || 'CAUTION';
        } else {
          elStatusPill.className = 'badge-yes';
          elStatusPill.textContent = ui.statusSafeBadge || 'SAFE';
        }
      }

      if (elComboBadge) {
        elComboBadge.textContent = res.dish.icon + ' ' + res.dish.name + ' · ' + res.mat.icon + ' ' + res.mat.shortName;
      }

      if (elModePill) {
        if (state.broiler) {
          elModePill.textContent = '🔥 ' + (ui.broilerOn || 'Broiler ON');
        } else if (state.convection) {
          elModePill.textContent = '🌀 ' + (ui.modeConvection || 'Convection');
        } else {
          elModePill.textContent = '🔥 ' + (ui.modeConventional || 'Conventional');
        }
      }

      renderAlerts(res.alerts);

      // Output Temp Tile
      if (elOutTempMain) {
        elOutTempMain.textContent = state.broiler
          ? (ui.outBroilHeadline || 'HIGH BROIL')
          : formatTempPair(res.adjustedTempF);
      }
      if (elOutTempDelta) {
        elOutTempDelta.textContent = state.broiler
          ? (ui.outBroilSub || '~500–550°F (260–290°C)')
          : formatDeltaPair(res.totalDeltaF);
      }
      if (elOutTempSub) {
        elOutTempSub.textContent = (ui.outRecipePrefix || 'Recipe:') + ' ' + formatTempPair(res.baseTempF);
      }

      // Output Time Tile
      if (elOutTimeMain) {
        elOutTimeMain.textContent = res.timeLow + '–' + res.timeHigh + ' ' + (ui.minutesUnit || 'min');
      }
      if (elOutTimeNote) {
        elOutTimeNote.textContent = res.timeNote;
      }
      if (elOutTimeSub) {
        elOutTimeSub.textContent = (ui.outRecipePrefix || 'Recipe:') + ' ' + res.baseTime + ' ' + (ui.minutesUnit || 'min');
      }

      // Output Rack Tile
      if (elOutRackMain) {
        elOutRackMain.textContent = res.rack.shortName;
      }
      if (elOutRackZone) {
        elOutRackZone.textContent = res.rack.zoneBadge;
        elOutRackZone.className = 'inline-flex items-center px-2 py-0.5 rounded-md border text-[10.5px] font-bold ' + getZoneClasses(res.rack.heatZoneColor);
      }
      if (elOutRackSlot) {
        elOutRackSlot.textContent = (ui.slotPrefix || 'Slot') + ' ' + res.rack.slotNumber + ' / 5';
      }

      // Material + Dish Info Strip
      if (elMatTitle) elMatTitle.textContent = res.mat.name;
      if (elMatRulePill) elMatRulePill.textContent = res.mat.tempRuleBadge;
      if (elMatBrowning) elMatBrowning.textContent = (ui.matBrowningLabel || 'Browning Profile') + ': ' + res.mat.browningProfile;
      if (elMatScience) elMatScience.textContent = res.mat.scienceNote;
      if (elMatSafety) elMatSafety.textContent = res.mat.safetyNote;
      if (elDishTip) elDishTip.textContent = res.dish.tip;

      // Highlight active dish preset button
      dishBtns.forEach(function (btn) {
        var active = btn.getAttribute('data-orbha-dish') === state.dishId;
        btn.setAttribute('aria-pressed', active ? 'true' : 'false');
        btn.classList.toggle('bg-primary', active);
        btn.classList.toggle('text-on-primary', active);
        btn.classList.toggle('border-primary', active);
        btn.classList.toggle('shadow-sm', active);
        btn.classList.toggle('bg-surface-soft', !active);
        btn.classList.toggle('text-ink', !active);
        btn.classList.toggle('border-hairline', !active);
      });

      // Highlight active material card
      matCards.forEach(function (card) {
        var active = card.getAttribute('data-orbha-mat') === state.materialId;
        card.setAttribute('aria-pressed', active ? 'true' : 'false');
        card.classList.toggle('bg-canvas', active);
        card.classList.toggle('border-signature-coral', active);
        card.classList.toggle('ring-2', active);
        card.classList.toggle('ring-signature-coral', active);
        card.classList.toggle('shadow-sm', active);
        card.classList.toggle('bg-surface-soft/65', !active);
        card.classList.toggle('border-hairline', !active);
      });

      // Top Broiler Element glow
      if (elBroilerCoil) {
        elBroilerCoil.classList.toggle('bg-red-600/35', state.broiler);
        elBroilerCoil.classList.toggle('border-red-400', state.broiler);
        elBroilerCoil.classList.toggle('text-white', state.broiler);
        elBroilerCoil.classList.toggle('shadow-sm', state.broiler);
        elBroilerCoil.classList.toggle('bg-red-500/12', !state.broiler);
        elBroilerCoil.classList.toggle('border-red-400/35', !state.broiler);
        elBroilerCoil.classList.toggle('text-red-200', !state.broiler);
      }

      // 5-Rack Oven Schematic highlight
      rackBtns.forEach(function (btn) {
        var rId = btn.getAttribute('data-orbha-rack');
        var isSelected = rId === state.rackId;
        var isDishRecommended = rId === res.dish.rackId;
        var isDangerTop = rId === 'top-broil' && !res.mat.broilerSafe && (isSelected || state.broiler);

        btn.setAttribute('aria-pressed', isSelected ? 'true' : 'false');
        btn.classList.remove(
          'bg-white/14',
          'bg-red-500/20',
          'bg-white/5',
          'border-signature-coral',
          'border-red-400',
          'border-white/12',
          'ring-2',
          'ring-signature-coral',
          'ring-red-400',
          'shadow-sm'
        );

        if (isSelected && isDangerTop) {
          btn.classList.add('bg-red-500/20', 'border-red-400', 'ring-2', 'ring-red-400', 'shadow-sm');
        } else if (isSelected) {
          btn.classList.add('bg-white/14', 'border-signature-coral', 'ring-2', 'ring-signature-coral', 'shadow-sm');
        } else {
          btn.classList.add('bg-white/5', 'border-white/12');
        }

        var statusBadge = btn.querySelector('[data-orbha-rack-status]');
        if (statusBadge) {
          statusBadge.className = 'px-2 py-0.5 rounded-md text-[10px] font-extrabold uppercase tracking-wider';
          if (isDangerTop) {
            statusBadge.classList.add('bg-error-border', 'text-white');
            statusBadge.textContent = ui.unsafeBroilTag || 'UNSAFE PAN HERE';
          } else if (isSelected) {
            statusBadge.classList.add('bg-signature-coral', 'text-white');
            statusBadge.textContent = ui.activeRackTag || 'SELECTED RACK';
          } else if (isDishRecommended) {
            statusBadge.classList.add('bg-emerald-500/25', 'text-emerald-200', 'border', 'border-emerald-400/40');
            statusBadge.textContent = ui.recommendedRackTag || 'IDEAL FOR DISH';
          } else {
            statusBadge.classList.add('hidden');
            statusBadge.textContent = '';
          }
        }

        var bar = btn.querySelector('[data-orbha-rack-bar]');
        if (bar) {
          bar.classList.remove('w-full', 'w-1/4', 'bg-signature-coral', 'bg-error-border', 'bg-white/30');
          if (isSelected && isDangerTop) {
            bar.classList.add('w-full', 'bg-error-border');
          } else if (isSelected) {
            bar.classList.add('w-full', 'bg-signature-coral');
          } else {
            bar.classList.add('w-1/4', 'bg-white/30');
          }
        }
      });

      // Right Rack Details Inspector
      if (elRackDetailSlot) elRackDetailSlot.textContent = (ui.slotPrefix || 'Slot') + ' ' + res.rack.slotNumber + ' / 5';
      if (elRackDetailZone) elRackDetailZone.textContent = res.rack.zoneBadge;
      if (elRackDetailName) elRackDetailName.textContent = res.rack.name;
      if (elRackDetailBest) elRackDetailBest.textContent = res.rack.bestFor;
      if (elRackDetailAirflow) elRackDetailAirflow.textContent = res.rack.airflowNote;
      if (elRackDetailWarning) elRackDetailWarning.textContent = res.rack.warning;
    }

    function buildCopySummary() {
      var res = computeResult();
      var lines = [];
      lines.push(ui.copyHeader || 'IsItKitchenSafe — Adjusted Oven Settings');
      lines.push('');
      lines.push((ui.copyDishLine || 'Dish:') + ' ' + res.dish.name);
      lines.push((ui.copyMaterialLine || 'Bakeware:') + ' ' + res.mat.name + ' (' + res.mat.tempRuleBadge + ')');
      lines.push(
        (ui.copyModeLine || 'Mode:') +
          ' ' +
          (state.broiler
            ? (ui.broilerOn || 'Broiler ON')
            : state.convection
              ? (ui.modeConvection || 'Convection')
              : (ui.modeConventional || 'Conventional'))
      );
      lines.push(
        (ui.copyTempLine || 'Adjusted Temp:') +
          ' ' +
          (state.broiler ? (ui.outBroilHeadline || 'HIGH BROIL') : formatTempPair(res.adjustedTempF)) +
          ' (' +
          (ui.outRecipePrefix || 'Recipe:') +
          ' ' +
          formatTempPair(res.baseTempF) +
          ')'
      );
      lines.push(
        (ui.copyTimeLine || 'Check-Early Window:') +
          ' ' +
          res.timeLow +
          '–' +
          res.timeHigh +
          ' ' +
          (ui.minutesUnit || 'min') +
          ' (' +
          res.timeNote +
          ')'
      );
      lines.push(
        (ui.copyRackLine || 'Oven Rack:') +
          ' ' +
          res.rack.name +
          ' [' +
          (ui.slotPrefix || 'Slot') +
          ' ' +
          res.rack.slotNumber +
          '/5]'
      );
      lines.push('');

      if (res.alerts.length > 0) {
        lines.push(ui.copyAlertsLine || 'ACTIVE SAFETY ALERTS:');
        res.alerts.forEach(function (a, i) {
          lines.push('  ' + (i + 1) + ') ' + a.title + ' — ' + a.body);
        });
      } else {
        lines.push(ui.copySafeLine || 'Safety Status: Safe.');
      }

      return lines.join('\n');
    }

    // Event Listeners
    dishBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var dId = btn.getAttribute('data-orbha-dish');
        var d = dishMap[dId];
        if (!d) return;
        state.dishId = d.id;
        state.recipeTempF = Number(d.baseTempF);
        state.recipeTimeMin = Number(d.baseTimeMin);
        state.rackId = d.rackId;
        state.broiler = Boolean(d.broiler);
        if (state.broiler) {
          state.convection = false;
        }
        render();
      });
    });

    unitBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var u = btn.getAttribute('data-orbha-unit');
        if (u === 'F' || u === 'C') {
          state.unit = u;
          render();
        }
      });
    });

    if (tempInput) {
      tempInput.addEventListener('input', function () {
        var raw = Number(tempInput.value);
        if (isNaN(raw) || tempInput.value === '') return;
        if (state.unit === 'C') {
          state.recipeTempF = clamp(cToF(raw), 200, 525);
        } else {
          state.recipeTempF = clamp(raw, 200, 525);
        }
        render('tempInput');
      });
      tempInput.addEventListener('change', function () {
        render();
      });
    }

    if (tempSlider) {
      tempSlider.addEventListener('input', function () {
        state.recipeTempF = clamp(Number(tempSlider.value), 200, 525);
        render('tempSlider');
      });
    }

    if (timeInput) {
      timeInput.addEventListener('input', function () {
        var raw = Number(timeInput.value);
        if (isNaN(raw) || timeInput.value === '') return;
        state.recipeTimeMin = clamp(Math.round(raw), 5, 240);
        render('timeInput');
      });
      timeInput.addEventListener('change', function () {
        render();
      });
    }

    if (timeSlider) {
      timeSlider.addEventListener('input', function () {
        state.recipeTimeMin = clamp(Math.round(Number(timeSlider.value)), 5, 240);
        render('timeSlider');
      });
    }

    if (convOffBtn) {
      convOffBtn.addEventListener('click', function () {
        state.convection = false;
        render();
      });
    }

    if (convOnBtn) {
      convOnBtn.addEventListener('click', function () {
        state.convection = true;
        state.broiler = false;
        render();
      });
    }

    if (broilOffBtn) {
      broilOffBtn.addEventListener('click', function () {
        state.broiler = false;
        var currentDish = dishMap[state.dishId];
        if (state.rackId === 'top-broil' && currentDish && !currentDish.broiler) {
          state.rackId = currentDish.rackId;
        }
        render();
      });
    }

    if (broilOnBtn) {
      broilOnBtn.addEventListener('click', function () {
        state.broiler = true;
        state.convection = false;
        state.rackId = 'top-broil';
        render();
      });
    }

    matCards.forEach(function (card) {
      card.addEventListener('click', function () {
        var mId = card.getAttribute('data-orbha-mat');
        if (mId && materialMap[mId]) {
          state.materialId = mId;
          render();
        }
      });
    });

    rackBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var rId = btn.getAttribute('data-orbha-rack');
        if (rId && rackMap[rId]) {
          state.rackId = rId;
          render();
        }
      });
    });

    if (copyBtn) {
      copyBtn.addEventListener('click', function () {
        var text = buildCopySummary();
        var showCopied = function () {
          if (copyLabel) copyLabel.textContent = ui.copiedBtn || 'Settings Copied ✓';
          window.setTimeout(function () {
            if (copyLabel) copyLabel.textContent = '📋 ' + (ui.copyBtn || 'Copy Adjusted Settings');
          }, 2200);
        };

        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(showCopied).catch(showCopied);
        } else {
          var ta = document.createElement('textarea');
          ta.value = text;
          ta.setAttribute('readonly', '');
          ta.style.position = 'absolute';
          ta.style.left = '-9999px';
          document.body.appendChild(ta);
          ta.select();
          try {
            document.execCommand('copy');
          } catch (_) {
            // ignore
          }
          document.body.removeChild(ta);
          showCopied();
        }
      });
    }

    if (printBtn) {
      printBtn.addEventListener('click', function () {
        window.print();
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', function () {
        var d = dishMap[payload.defaultDishId] || dishes[0];
        var m = materialMap[payload.defaultMaterialId] || materials[0];
        state.dishId = d ? d.id : 'cookies';
        state.materialId = m ? m.id : 'bright-aluminum';
        state.rackId = d ? d.rackId : 'center';
        state.recipeTempF = d ? Number(d.baseTempF) : 350;
        state.recipeTimeMin = d ? Number(d.baseTimeMin) : 11;
        state.unit = payload.defaultUnit === 'C' ? 'C' : 'F';
        state.convection = false;
        state.broiler = false;
        render();
      });
    }

    render();
  })();
</script>
