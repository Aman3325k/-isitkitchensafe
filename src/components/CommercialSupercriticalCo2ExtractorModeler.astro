const d = DICTIONARY[lang];
---

<div class="bg-surface border border-hairline rounded-2xl p-6 sm:p-8 shadow-xs mb-10 text-ink">
  <!-- Header Badge & Title -->
  <div class="mb-8">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-orange-600 text-white mb-3">
      <span>{d.badge}</span>
      <span class="opacity-75">•</span>
      <span>ASME VIII • NORSOK M-710 • API 520</span>
    </div>
    <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight mb-3 text-ink">
      {d.title}
    </h2>
    <p class="text-sm sm:text-base text-muted leading-relaxed max-w-4xl">
      {d.subtitle}
    </p>
  </div>

  <!-- Presets -->
  <div class="mb-8 bg-surface-soft border border-hairline rounded-xl p-4 sm:p-5">
    <div class="text-xs font-bold uppercase tracking-wider text-muted mb-3 flex items-center gap-2">
      <svg class="w-4 h-4 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
      </svg>
      {d.presetsTitle}
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2">
      <button type="button" id="co2-preset-hop" class="text-left px-3 py-2 rounded-lg bg-surface border border-hairline hover:border-orange-500 hover:bg-orange-50/30 text-xs font-medium text-ink transition-all">
        🍺 {d.presetHop}
      </button>
      <button type="button" id="co2-preset-coffee" class="text-left px-3 py-2 rounded-lg bg-surface border border-hairline hover:border-orange-500 hover:bg-orange-50/30 text-xs font-medium text-ink transition-all">
        ☕ {d.presetCoffee}
      </button>
      <button type="button" id="co2-preset-oleoresin" class="text-left px-3 py-2 rounded-lg bg-surface border border-hairline hover:border-orange-500 hover:bg-orange-50/30 text-xs font-medium text-ink transition-all">
        🌿 {d.presetOleoresin}
      </button>
      <button type="button" id="co2-preset-catastrophic" class="text-left px-3 py-2 rounded-lg bg-surface border border-hairline hover:border-rose-500 hover:bg-rose-50/40 text-xs font-medium text-rose-700 transition-all">
        🚨 {d.presetCatastrophic}
      </button>
    </div>
  </div>

  <!-- Interactive Controls Form -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-8 mb-8">
    <!-- Column 1: Hardware & Substrate -->
    <div class="space-y-5 bg-surface-soft/60 border border-hairline rounded-xl p-5">
      <h3 class="text-sm font-bold uppercase tracking-wider text-ink border-b border-hairline pb-2 flex items-center justify-between">
        <span>{d.controlsTitle}</span>
        <span class="text-xs font-normal text-muted lowercase">step 1 / 2</span>
      </h3>

      <!-- Vessel Architecture -->
      <div>
        <label for="co2-machine-select" class="block text-xs font-semibold text-ink mb-1.5">
          {d.machineLabel}
        </label>
        <select id="co2-machine-select" class="w-full bg-surface border border-hairline rounded-lg px-3 py-2 text-xs text-ink focus:outline-none focus:ring-2 focus:ring-orange-500 font-medium">
          {extractorData.extractorArchitectures.map((arch) => (
            <option value={arch.id}>{arch.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1">{d.machineHelp}</p>
      </div>

      <!-- Substrate -->
      <div>
        <label for="co2-substrate-select" class="block text-xs font-semibold text-ink mb-1.5">
          {d.substrateLabel}
        </label>
        <select id="co2-substrate-select" class="w-full bg-surface border border-hairline rounded-lg px-3 py-2 text-xs text-ink focus:outline-none focus:ring-2 focus:ring-orange-500 font-medium">
          {extractorData.extractionSubstrates.map((sub) => (
            <option value={sub.id}>{sub.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1">{d.substrateHelp}</p>
      </div>

      <!-- Seal Material -->
      <div>
        <label for="co2-seal-select" class="block text-xs font-semibold text-ink mb-1.5">
          {d.sealLabel}
        </label>
        <select id="co2-seal-select" class="w-full bg-surface border border-hairline rounded-lg px-3 py-2 text-xs text-ink focus:outline-none focus:ring-2 focus:ring-orange-500 font-medium">
          {extractorData.sealPolymerProfiles.map((seal) => (
            <option value={seal.id}>{seal.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1">{d.sealHelp}</p>
      </div>

      <!-- Heat Tracing Toggle -->
      <div class="pt-2">
        <label class="flex items-center gap-3 cursor-pointer">
          <input type="checkbox" id="co2-heat-tracing" checked class="w-4 h-4 text-orange-600 rounded border-hairline focus:ring-orange-500" />
          <span class="text-xs font-semibold text-ink">{d.heatTracingLabel}</span>
        </label>
        <p class="text-[11px] text-muted mt-1 pl-7">{d.heatTracingHelp}</p>
      </div>
    </div>

    <!-- Column 2: Thermodynamic Sliders -->
    <div class="space-y-5 bg-surface-soft/60 border border-hairline rounded-xl p-5">
      <h3 class="text-sm font-bold uppercase tracking-wider text-ink border-b border-hairline pb-2 flex items-center justify-between">
        <span>Process Thermodynamics & Rates</span>
        <span class="text-xs font-normal text-muted lowercase">step 2 / 2</span>
      </h3>

      <!-- Operating Pressure -->
      <div>
        <div class="flex justify-between items-center text-xs mb-1.5">
          <label for="co2-pressure-input" class="font-semibold text-ink">{d.pressureLabel}</label>
          <span id="co2-pressure-val" class="font-mono text-orange-600 font-bold">350 bar</span>
        </div>
        <input type="range" id="co2-pressure-input" min="200" max="650" step="5" value="350" class="w-full accent-orange-600 cursor-pointer" />
        <p class="text-[11px] text-muted mt-1">{d.pressureHelp}</p>
      </div>

      <!-- Temperature -->
      <div>
        <div class="flex justify-between items-center text-xs mb-1.5">
          <label for="co2-temp-input" class="font-semibold text-ink">{d.tempLabel}</label>
          <span id="co2-temp-val" class="font-mono text-orange-600 font-bold">45 °C</span>
        </div>
        <input type="range" id="co2-temp-input" min="35" max="100" step="1" value="45" class="w-full accent-orange-600 cursor-pointer" />
        <p class="text-[11px] text-muted mt-1">{d.tempHelp}</p>
      </div>

      <!-- Depressurization Rate -->
      <div>
        <div class="flex justify-between items-center text-xs mb-1.5">
          <label for="co2-depress-input" class="font-semibold text-ink">{d.depressRateLabel}</label>
          <span id="co2-depress-val" class="font-mono text-orange-600 font-bold">25 bar/min</span>
        </div>
        <input type="range" id="co2-depress-input" min="2" max="150" step="2" value="25" class="w-full accent-orange-600 cursor-pointer" />
        <p class="text-[11px] text-muted mt-1">{d.depressRateHelp}</p>
      </div>

      <!-- CO2 Continuous Flow -->
      <div>
        <div class="flex justify-between items-center text-xs mb-1.5">
          <label for="co2-flow-input" class="font-semibold text-ink">{d.co2FlowLabel}</label>
          <span id="co2-flow-val" class="font-mono text-orange-600 font-bold">250 kg/h</span>
        </div>
        <input type="range" id="co2-flow-input" min="10" max="1500" step="10" value="250" class="w-full accent-orange-600 cursor-pointer" />
        <p class="text-[11px] text-muted mt-1">{d.co2FlowHelp}</p>
      </div>
    </div>
  </div>

  <!-- Telemetry Diagnostic Dashboard -->
  <div class="bg-surface border border-hairline rounded-xl p-5 sm:p-6 mb-8 shadow-xs">
    <div class="border-b border-hairline pb-3 mb-5 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
      <div>
        <h3 class="text-base sm:text-lg font-bold text-ink">{d.diagnosticTitle}</h3>
        <p class="text-xs text-muted">{d.diagnosticSub}</p>
      </div>
      <div class="flex items-center gap-2">
        <button id="co2-copy-report-btn" class="px-3 py-1.5 rounded-lg bg-orange-600 hover:bg-orange-700 text-white text-xs font-semibold transition-colors flex items-center gap-1.5 shadow-xs">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          <span>{d.copyReportBtn}</span>
        </button>
        <span id="co2-copy-feedback" class="text-xs text-emerald-600 font-medium hidden">
          ✓ {d.copiedFeedback}
        </span>
      </div>
    </div>

    <!-- Diagnostic Cards Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4 mb-6">
      <!-- Card 1: CO2 Density -->
      <div class="bg-surface-soft p-3 sm:p-4 rounded-xl border border-hairline">
        <div class="text-[11px] text-muted font-medium mb-1">{d.densityLabel}</div>
        <div id="co2-res-density" class="text-lg sm:text-xl font-bold font-mono text-ink">0.864 g/cm³</div>
        <div class="text-[10px] text-muted mt-1 font-mono">ρ_CO2 (Supercritical)</div>
      </div>

      <!-- Card 2: Hoop Stress & ASME Margin -->
      <div class="bg-surface-soft p-3 sm:p-4 rounded-xl border border-hairline">
        <div class="text-[11px] text-muted font-medium mb-1">{d.hoopStressLabel}</div>
        <div id="co2-res-hoop" class="text-lg sm:text-xl font-bold font-mono text-ink">112.5 MPa</div>
        <div id="co2-res-margin" class="text-[10px] text-emerald-600 font-mono mt-1 font-semibold">ASME SF: 2.85x (PASS)</div>
      </div>

      <!-- Card 3: Joule-Thomson Vent Chilling -->
      <div class="bg-surface-soft p-3 sm:p-4 rounded-xl border border-hairline">
        <div class="text-[11px] text-muted font-medium mb-1">{d.jtTempLabel}</div>
        <div id="co2-res-jttemp" class="text-lg sm:text-xl font-bold font-mono text-ink">-8.5 °C</div>
        <div id="co2-res-dryice" class="text-[10px] text-emerald-600 font-mono mt-1 font-semibold">Dry Ice: NONE (Clear)</div>
      </div>

      <!-- Card 4: RGD Blistering Damage Index -->
      <div class="bg-surface-soft p-3 sm:p-4 rounded-xl border border-hairline">
        <div class="text-[11px] text-muted font-medium mb-1">{d.rgdDamageLabel}</div>
        <div id="co2-res-rgd" class="text-lg sm:text-xl font-bold font-mono text-ink">0.42 / 1.0</div>
        <div id="co2-res-deptime" class="text-[10px] text-muted font-mono mt-1">Est. Time: 14.0 min</div>
      </div>
    </div>

    <!-- Status Banner -->
    <div id="co2-status-banner" class="rounded-xl p-4 sm:p-5 border mb-5 transition-all bg-emerald-50 border-emerald-200 text-emerald-900">
      <div class="flex items-start gap-3">
        <span id="co2-status-icon" class="text-2xl mt-0.5">✅</span>
        <div class="flex-1">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-1">
            <h4 class="font-bold text-sm sm:text-base">{d.safetyStatusLabel}</h4>
            <span id="co2-status-badge" class="px-2.5 py-0.5 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-600 text-white w-fit">
              OPTIMAL (COMPLIANT)
            </span>
          </div>
          <p id="co2-status-desc" class="text-xs sm:text-sm leading-relaxed opacity-90">
            Process operates well within ASME Section VIII cylinder yield limits. Operating depressurization rate is safe for the selected NORSOK M-710 AED elastomer. Heated discharge horn prevents Joule-Thomson dry-ice freeze plugging.
          </p>
        </div>
      </div>
    </div>

    <!-- Deep Mechanical Details -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
      <div class="bg-surface-soft/80 p-4 rounded-xl border border-hairline">
        <div class="font-bold text-ink uppercase tracking-wider mb-2 flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-orange-600"></span>
          {d.mechanismsLabel}
        </div>
        <p id="co2-res-mechanism" class="text-muted leading-relaxed">
          Isenthalpic throttling across pressure-reducing orifices produces steady gas expansion. Supercritical density maintains robust solvating power without phase transition flashing inside the extraction bed.
        </p>
      </div>

      <div class="bg-surface-soft/80 p-4 rounded-xl border border-hairline">
        <div class="font-bold text-ink uppercase tracking-wider mb-2 flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-orange-600"></span>
          {d.mitigationLabel}
        </div>
        <p id="co2-res-mitigation" class="text-muted leading-relaxed">
          Maintain vent rate ≤25 bar/min. Ensure electric heat tracing on safety relief valve discharge horn remains energized above 45°C during blowdown to avoid dry-ice snow crystallization.
        </p>
      </div>
    </div>
  </div>

  <!-- Engineering Data Table -->
  <div class="mb-10">
    <div class="border-b border-hairline pb-2 mb-4">
      <h3 class="text-lg font-bold text-ink">{d.tableTitle}</h3>
      <p class="text-xs text-muted">{d.tableSub}</p>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs text-ink border border-hairline rounded-xl overflow-hidden">
        <thead class="bg-surface-soft border-b border-hairline font-bold text-muted uppercase tracking-wider">
          <tr>
            <th class="p-3">{d.colModel}</th>
            <th class="p-3">{d.colClass}</th>
            <th class="p-3">{d.colVolume}</th>
            <th class="p-3">{d.colPressure}</th>
            <th class="p-3">{d.colSeal}</th>
            <th class="p-3">{d.colRelief}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline">
          {extractorData.extractorArchitectures.map((arch) => (
            <tr class="hover:bg-surface-soft/50 transition-colors">
              <td class="p-3 font-semibold text-ink">{arch.name}</td>
              <td class="p-3 text-muted">{arch.classification}</td>
              <td class="p-3 text-muted font-mono">{arch.vesselVolumeLiters} L (Ø{arch.internalDiameterMm}mm × t={arch.wallThicknessMm}mm)</td>
              <td class="p-3 font-mono font-medium text-ink">{arch.designPressureBar} bar (Burst: {arch.burstDiscPressureBar} bar)</td>
              <td class="p-3 text-muted">{arch.sealConfiguration}</td>
              <td class="p-3 text-muted">{arch.reliefValveType}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Critical Safety Rules -->
  <div class="bg-surface-soft border border-hairline rounded-xl p-6 sm:p-7">
    <div class="mb-6">
      <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-md text-xs font-bold uppercase tracking-wider bg-rose-600 text-white mb-2">
        <span>MANDATORY DIRECTIVES</span>
      </div>
      <h3 class="text-xl font-bold text-ink tracking-tight">{d.rulesTitle}</h3>
      <p class="text-xs sm:text-sm text-muted">{d.rulesSub}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 text-xs sm:text-sm">
      <div class="bg-surface p-4 rounded-xl border border-hairline">
        <h4 class="font-bold text-ink mb-1.5 text-sm">{d.rule1Title}</h4>
        <p class="text-muted leading-relaxed">{d.rule1Text}</p>
      </div>

      <div class="bg-surface p-4 rounded-xl border border-hairline">
        <h4 class="font-bold text-ink mb-1.5 text-sm">{d.rule2Title}</h4>
        <p class="text-muted leading-relaxed">{d.rule2Text}</p>
      </div>

      <div class="bg-surface p-4 rounded-xl border border-hairline">
        <h4 class="font-bold text-ink mb-1.5 text-sm">{d.rule3Title}</h4>
        <p class="text-muted leading-relaxed">{d.rule3Text}</p>
      </div>

      <div class="bg-surface p-4 rounded-xl border border-hairline">
        <h4 class="font-bold text-ink mb-1.5 text-sm">{d.rule4Title}</h4>
        <p class="text-muted leading-relaxed">{d.rule4Text}</p>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ extractorData }}>
  (function initSupercriticalCo2Modeler() {
    const machineSelect = document.getElementById('co2-machine-select');
    const substrateSelect = document.getElementById('co2-substrate-select');
    const sealSelect = document.getElementById('co2-seal-select');
    const heatTracingCheckbox = document.getElementById('co2-heat-tracing');

    const pressureInput = document.getElementById('co2-pressure-input');
    const tempInput = document.getElementById('co2-temp-input');
    const depressInput = document.getElementById('co2-depress-input');
    const flowInput = document.getElementById('co2-flow-input');

    const pressureVal = document.getElementById('co2-pressure-val');
    const tempVal = document.getElementById('co2-temp-val');
    const depressVal = document.getElementById('co2-depress-val');
    const flowVal = document.getElementById('co2-flow-val');

    const resDensity = document.getElementById('co2-res-density');
    const resHoop = document.getElementById('co2-res-hoop');
    const resMargin = document.getElementById('co2-res-margin');
    const resJtTemp = document.getElementById('co2-res-jttemp');
    const resDryIce = document.getElementById('co2-res-dryice');
    const resRgd = document.getElementById('co2-res-rgd');
    const resDepTime = document.getElementById('co2-res-deptime');

    const statusBanner = document.getElementById('co2-status-banner');
    const statusIcon = document.getElementById('co2-status-icon');
    const statusBadge = document.getElementById('co2-status-badge');
    const statusDesc = document.getElementById('co2-status-desc');
    const resMechanism = document.getElementById('co2-res-mechanism');
    const resMitigation = document.getElementById('co2-res-mitigation');

    const copyBtn = document.getElementById('co2-copy-report-btn');
    const copyFeedback = document.getElementById('co2-copy-feedback');

    function calculateTelemetry() {
      if (!machineSelect || !pressureInput) return;

      const machId = machineSelect.value;
      const subId = substrateSelect.value;
      const sealId = sealSelect.value;
      const heatTracing = heatTracingCheckbox.checked;

      const pressureBar = parseFloat(pressureInput.value);
      const tempC = parseFloat(tempInput.value);
      const depressRate = parseFloat(depressInput.value);
      const flowKgH = parseFloat(flowInput.value);

      pressureVal.textContent = pressureBar + ' bar';
      tempVal.textContent = tempC + ' °C';
      depressVal.textContent = depressRate + ' bar/min';
      flowVal.textContent = flowKgH + ' kg/h';

      const arch = extractorData.extractorArchitectures.find(a => a.id === machId) || extractorData.extractorArchitectures[0];
      const seal = extractorData.sealPolymerProfiles.find(s => s.id === sealId) || extractorData.sealPolymerProfiles[0];
      const substrate = extractorData.extractionSubstrates.find(s => s.id === subId) || extractorData.extractionSubstrates[0];

      // 1. Supercritical CO2 Density Equation approximation (Span & Wagner simplified)
      // Base around 350 bar / 45°C ~ 0.88 g/cm3
      let density = 0.88 + ((pressureBar - 350) * 0.00065) - ((tempC - 45) * 0.0042);
      if (density < 0.35) density = 0.35;
      if (density > 1.05) density = 1.05;

      // 2. Lamé Thick-Walled Cylinder Inner Surface Hoop Stress
      // r_i = internalDiameter / 2; r_o = r_i + wallThickness
      const ri = arch.internalDiameterMm / 2;
      const ro = ri + arch.wallThicknessMm;
      const ri2 = ri * ri;
      const ro2 = ro * ro;
      // Pressure in MPa = bar * 0.1
      const pMpa = pressureBar * 0.1;
      const hoopStressMpa = pMpa * ((ro2 + ri2) / (ro2 - ri2));

      // Allowable yield stress based on material
      let materialYieldMpa = 290; // 316L
      if (arch.id.includes('2205')) materialYieldMpa = 480; // 2205 Duplex
      else if (arch.id.includes('nitronic')) materialYieldMpa = 620; // Nitronic 50
      else if (arch.id.includes('aging') || arch.id.includes('compromised')) materialYieldMpa = 205; // Sensitized 304

      const safetyFactor = materialYieldMpa / hoopStressMpa;

      // 3. Joule-Thomson Expansion Chilling
      // mu_JT ≈ 0.16 °C/bar for CO2 expansion to atmospheric
      let jtDeltaT = 0.16 * pressureBar;
      let ventTempC = tempC - jtDeltaT;
      if (heatTracing) {
        // Active electric heat tracing boosts vent gas temp by +55°C
        ventTempC += 55.0;
      }

      // CO2 Triple Point is -56.6°C at 5.18 bar
      const dryIceOccurs = ventTempC <= -56.6;

      // 4. Rapid Gas Decompression (RGD) Damage Index
      // Proportional to depressurization rate, operating pressure, and elastomer swell
      let sealModulusFactor = 1.0;
      if (seal.id === 'aed_hnbr_90') sealModulusFactor = 3.5;
      else if (seal.id === 'spring_ptfe_peek') sealModulusFactor = 8.0;
      else if (seal.id === 'standard_fkm_viton') sealModulusFactor = 0.8;
      else if (seal.id === 'standard_nbr_nitrile') sealModulusFactor = 0.3;

      const rgdIndex = (depressRate / 20.0) * (pressureBar / 300.0) * (seal.co2SwellingPercent / 10.0) / sealModulusFactor;

      // Depressurization Duration
      const safeTimeMinutes = (pressureBar / depressRate).toFixed(1);

      // Render Dashboard Cards
      resDensity.textContent = density.toFixed(3) + ' g/cm³';
      resHoop.textContent = hoopStressMpa.toFixed(1) + ' MPa';

      if (safetyFactor >= 2.5) {
        resMargin.textContent = 'ASME SF: ' + safetyFactor.toFixed(2) + 'x (OPTIMAL)';
        resMargin.className = 'text-[10px] text-emerald-600 font-mono mt-1 font-semibold';
      } else if (safetyFactor >= 1.5) {
        resMargin.textContent = 'ASME SF: ' + safetyFactor.toFixed(2) + 'x (CAUTION)';
        resMargin.className = 'text-[10px] text-amber-600 font-mono mt-1 font-semibold';
      } else {
        resMargin.textContent = 'ASME SF: ' + safetyFactor.toFixed(2) + 'x (CRITICAL YIELD)';
        resMargin.className = 'text-[10px] text-rose-600 font-mono mt-1 font-bold';
      }

      resJtTemp.textContent = ventTempC.toFixed(1) + ' °C';
      if (dryIceOccurs) {
        resDryIce.textContent = '🚨 DRY ICE CHOKE (< -56.6°C)';
        resDryIce.className = 'text-[10px] text-rose-600 font-mono mt-1 font-bold animate-pulse';
      } else if (ventTempC < 0) {
        resDryIce.textContent = '❄️ SUB-ZERO CHILL (Clear)';
        resDryIce.className = 'text-[10px] text-amber-600 font-mono mt-1 font-semibold';
      } else {
        resDryIce.textContent = '✓ DRY ICE: NONE (Heated)';
        resDryIce.className = 'text-[10px] text-emerald-600 font-mono mt-1 font-semibold';
      }

      resRgd.textContent = rgdIndex.toFixed(2) + ' / 1.0';
      resDepTime.textContent = 'Blowdown Time: ' + safeTimeMinutes + ' min';

      // Status Evaluation
      let statusState = 'OPTIMAL';
      let statusTitle = 'OPTIMAL (ASME & NORSOK COMPLIANT)';
      let icon = '✅';
      let bannerClass = 'bg-emerald-50 border-emerald-200 text-emerald-900';
      let badgeClass = 'bg-emerald-600 text-white';
      let desc = 'Autoclave operates well within ASME Section VIII cylinder yield limits. Operating depressurization rate is safe for the selected NORSOK M-710 AED elastomer. Heated discharge horn prevents Joule-Thomson dry-ice freeze plugging.';
      let mech = 'Isenthalpic throttling across pressure-reducing orifices produces steady gas expansion. Supercritical density maintains robust solvating power without phase transition flashing inside the extraction bed.';
      let mit = 'Maintain vent rate ≤25 bar/min. Ensure electric heat tracing on safety relief valve discharge horn remains energized above 45°C during blowdown to avoid dry-ice snow crystallization.';

      if (safetyFactor < 1.3 || (arch.id.includes('compromised') && pressureBar > 350)) {
        statusState = 'CATASTROPHIC_OVERPRESSURE';
        statusTitle = 'CRITICAL OVERPRESSURE & CYLINDER YIELD HAZARD';
        icon = '🚨';
        bannerClass = 'bg-rose-50 border-rose-200 text-rose-900';
        badgeClass = 'bg-rose-600 text-white';
        desc = 'Calculated Lamé inner wall hoop stress (' + hoopStressMpa.toFixed(1) + ' MPa) violates ASME Section VIII allowable limits (Safety Factor: ' + safetyFactor.toFixed(2) + 'x). High risk of vessel rupture or thread flank shearing!';
        mech = 'Excessive internal pressure induces plastic hoop deformation across the inner cylinder wall. In sensitized or corroded vessels, microscopic stress-corrosion cracks propagate catastrophically.';
        mit = 'Immediately reduce pressure below ' + (arch.designPressureBar * 0.85).toFixed(0) + ' bar. Perform ultrasonic shear-wave testing on vessel closure threads and requalify under ASME Section VIII.';
      } else if (dryIceOccurs && !heatTracing) {
        statusState = 'DRY_ICE_CHOKE';
        statusTitle = 'CRITICAL JOULE-THOMSON DRY-ICE ORIFICE CHOKE';
        icon = '🧊';
        bannerClass = 'bg-rose-50 border-rose-200 text-rose-900';
        badgeClass = 'bg-rose-600 text-white';
        desc = 'Rapid blowdown expansion without active heat tracing causes Joule-Thomson vent temperatures to drop to ' + ventTempC.toFixed(1) + '°C, far below the CO2 triple point (-56.6°C). Solid dry-ice snow plugs the relief orifice, trapping high residual pressure!';
        mech = 'Isenthalpic gas expansion forces the CO2 fluid state directly across the sublimation curve into solid dry-ice crystals. Cryogenic packing blocks the 3 mm vent orifice, leading to violent secondary pressure surges.';
        mit = 'Energize electric heat tracing along all relief discharge lines immediately (maintain >45°C). Reduce depressurization rate below 15 bar/min to prevent dry-ice crystal nucleation.';
      } else if (rgdIndex > 1.8) {
        statusState = 'SEVERE_RGD_FAILURE';
        statusTitle = 'SEVERE RAPID GAS DECOMPRESSION SEAL BLOWOUT';
        icon = '💥';
        bannerClass = 'bg-rose-50 border-rose-200 text-rose-900';
        badgeClass = 'bg-rose-600 text-white';
        desc = 'RGD damage index (' + rgdIndex.toFixed(2) + ') indicates catastrophic internal micro-cavitation and elastomer shredding. High depressurization rate (' + depressRate + ' bar/min) forces dissolved supercritical CO2 to rupture the polymer matrix!';
        mech = 'Supercritical CO2 highly saturates the elastomer at ' + pressureBar + ' bar. Rapid blowdown causes gas outgassing velocity to exceed the polymer diffusion rate, nucleating internal micro-voids and ripping the seal apart.';
        mit = 'Replace seal with NORSOK M-710 certified AED HNBR or spring-energized PTFE with PEEK backup rings. Cap vessel depressurization rate at ≤10 bar/min.';
      } else if (rgdIndex > 1.0 || safetyFactor < 2.0 || ventTempC < 0) {
        statusState = 'CAUTION_DEGRADED';
        statusTitle = 'MODERATE PROCESS STRESS & CHILLING CAUTION';
        icon = '⚠️';
        bannerClass = 'bg-amber-50 border-amber-200 text-amber-900';
        badgeClass = 'bg-amber-600 text-white';
        desc = 'Process operates with elevated seal fatigue or sub-zero discharge chilling. RGD stress index (' + rgdIndex.toFixed(2) + ') is near the blistering limit. Sub-zero vent chilling (' + ventTempC.toFixed(1) + '°C) requires active monitoring.';
        mech = 'Moderate elastomer plasticization combined with fast cycle depressurization accelerates cyclic seal wear. Expansion cooling creates heavy frost on external relief piping.';
        mit = 'Maintain depressurization rate below ' + (depressRate * 0.7).toFixed(0) + ' bar/min. Inspect O-rings every 50 extraction cycles for surface micro-pitting.';
      }

      statusBanner.className = 'rounded-xl p-4 sm:p-5 border mb-5 transition-all ' + bannerClass;
      statusIcon.textContent = icon;
      statusBadge.textContent = statusTitle;
      statusBadge.className = 'px-2.5 py-0.5 rounded-full text-xs font-bold uppercase tracking-wider ' + badgeClass;
      statusDesc.textContent = desc;
      resMechanism.textContent = mech;
      resMitigation.textContent = mit;
    }

    // Presets
    document.getElementById('co2-preset-hop')?.addEventListener('click', () => {
      machineSelect.value = 'pilot_scale_5l_autoclave';
      substrateSelect.value = 'hop_pellets_essential_oils';
      sealSelect.value = 'aed_hnbr_90';
      heatTracingCheckbox.checked = true;
      pressureInput.value = '300';
      tempInput.value = '45';
      depressInput.value = '20';
      flowInput.value = '25';
      calculateTelemetry();
    });

    document.getElementById('co2-preset-coffee')?.addEventListener('click', () => {
      machineSelect.value = 'ultra_cascade_500l_nitronic';
      substrateSelect.value = 'green_coffee_decaffeination';
      sealSelect.value = 'spring_ptfe_peek';
      heatTracingCheckbox.checked = true;
      pressureInput.value = '420';
      tempInput.value = '70';
      depressInput.value = '35';
      flowInput.value = '900';
      calculateTelemetry();
    });

    document.getElementById('co2-preset-oleoresin')?.addEventListener('click', () => {
      machineSelect.value = 'industrial_dual_100l_skid';
      substrateSelect.value = 'botanical_oleoresins_flavonoids';
      sealSelect.value = 'spring_ptfe_peek';
      heatTracingCheckbox.checked = true;
      pressureInput.value = '500';
      tempInput.value = '55';
      depressInput.value = '25';
      flowInput.value = '450';
      calculateTelemetry();
    });

    document.getElementById('co2-preset-catastrophic')?.addEventListener('click', () => {
      machineSelect.value = 'compromised_aging_autoclave';
      substrateSelect.value = 'defatted_cocoa_specialty_lipids';
      sealSelect.value = 'standard_nbr_nitrile';
      heatTracingCheckbox.checked = false;
      pressureInput.value = '520';
      tempInput.value = '75';
      depressInput.value = '110';
      flowInput.value = '80';
      calculateTelemetry();
    });

    // Event Listeners
    machineSelect?.addEventListener('change', calculateTelemetry);
    substrateSelect?.addEventListener('change', calculateTelemetry);
    sealSelect?.addEventListener('change', calculateTelemetry);
    heatTracingCheckbox?.addEventListener('change', calculateTelemetry);

    pressureInput?.addEventListener('input', calculateTelemetry);
    tempInput?.addEventListener('input', calculateTelemetry);
    depressInput?.addEventListener('input', calculateTelemetry);
    flowInput?.addEventListener('input', calculateTelemetry);

    // Copy Report
    copyBtn?.addEventListener('click', () => {
      const arch = extractorData.extractorArchitectures.find(a => a.id === machineSelect.value);
      const sub = extractorData.extractionSubstrates.find(s => s.id === substrateSelect.value);
      const seal = extractorData.sealPolymerProfiles.find(s => s.id === sealSelect.value);

      const report = [
        '=== COMMERCIAL SUPERCRITICAL CO2 EXTRACTOR OPS REPORT ===',
        'Timestamp: ' + new Date().toISOString(),
        'Autoclave Model: ' + (arch ? arch.name : machineSelect.value),
        'Substrate: ' + (sub ? sub.name : substrateSelect.value),
        'Seal Polymer: ' + (seal ? seal.name : sealSelect.value),
        'Operating Pressure: ' + pressureInput.value + ' bar',
        'Process Temperature: ' + tempInput.value + ' °C',
        'Depressurization Rate: ' + depressInput.value + ' bar/min',
        'Relief Line Heat Tracing: ' + (heatTracingCheckbox.checked ? 'ACTIVE (Heated)' : 'DISABLED (Unheated)'),
        '-------------------------------------------------------',
        'Supercritical CO2 Density: ' + resDensity.textContent,
        'Inner Wall Lamé Hoop Stress: ' + resHoop.textContent,
        'ASME Design Safety Margin: ' + resMargin.textContent,
        'Joule-Thomson Vent Temp: ' + resJtTemp.textContent,
        'Dry-Ice Orifice Choke Risk: ' + resDryIce.textContent,
        'RGD Elastomer Damage Index: ' + resRgd.textContent,
        'Safety Status: ' + statusBadge.textContent,
        '-------------------------------------------------------',
        'Primary Engineering Risk: ' + statusDesc.textContent,
        'Mitigation Directive: ' + resMitigation.textContent
      ].join('\n');

      navigator.clipboard.writeText(report).then(() => {
        if (copyFeedback) {
          copyFeedback.classList.remove('hidden');
          setTimeout(() => copyFeedback.classList.add('hidden'), 3500);
        }
      });
    });

    // Initial run
    calculateTelemetry();
  })();
</script>
