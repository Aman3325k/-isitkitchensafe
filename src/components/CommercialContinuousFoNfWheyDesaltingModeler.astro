    drawHelp: "食品グレード塩化ナトリウム（NaCl 3.0M）、乳酸カリウム（2.5M）、塩化マグネシウム（MgCl2 1.8M）、または高純度スクロース／デキストリンを選択。",
    feedFlowLabel: "連続供給流量 (Q_feed):",
    feedFlowHelp: "中空糸ルーメンを通過するホエー供給液の体積流量（500〜6,000 L/h）。",
    tempLabel: "制御運転温度 (T_op):",
    tempHelp: "膜濃縮ループの受託制御温度（4℃〜45℃）。低温運転により熱変性を防止し三次元構造を保護。",
    solidsLabel: "濃縮液目標固形分濃度 (°Brix):",
    solidsHelp: "脱塩濃縮ホエーの最終目標固形分（10°Bx〜35°Bx）。",
    looseNfLabel: "複合ルーズナノ濾過（NF）ステージ:",
    looseNfHelp: "ポリピペラジン製ルーズ NF ステージ（分画分子量 400–600 Da）を起動し、透過液側へ一価・二価塩を精密排流。",
    chilledJacketLabel: "サニタリー低温グリコール冷却ジャケット:",
    chilledJacketHelp: "2℃〜6℃のサニタリー向流冷却ジャケットを稼働させ、浸透摩擦熱を吸収してタンパク質の熱失活を防止。",
    presetsTitle: "高効率商業運転プリセット",
    presetD90: "スイートホエー脱塩 90% (D90) 乳児用調製粉乳グレード（4500 L/h, 10℃, 24.5°Bx, NF作動）",
    presetAcid: "ギリシャヨーグルト酸性ホエー高カルシウム脱塩＆乳酸回収（2800 L/h, 12℃, 22°Bx, 乳酸カリウム）",
    presetColostrum: "ウシ初乳天然 IgG・ラクトフェリン非加熱極低温濃縮（1800 L/h, 6℃, スクロースドロー）",
    presetUf: "脱タンパク UF 透過液高 Brix 乳糖結晶化原料濃縮（4800 L/h, 15℃, 28°Bx）",
    presetHazard: "危険アラート：タンパク質熱変性失活＆ドロー塩逆拡散汚染（1200 L/h, 38℃, 高固形分, 冷却停止）",
    diagnosticTitle: "FO-NF 浸透水流束＆分画物理テレメトリ",
    diagnosticSub: "正浸透水流束、ミネラル脱塩効率、天然生理活性タンパク質保持率、逆溶質拡散流束、および単位体積あたり比エネルギー消費量をリアルタイム計算。",
    waterFluxLabel: "正浸透純水流束 (J_w):",
    desaltingRateLabel: "ミネラル灰分脱塩効率 (R_ash):",
    bioactiveRetentionLabel: "天然ラクトフェリン＆IgG 保持率:",
    reverseSaltFluxLabel: "ドロー溶質逆拡散流束 (J_s):",
    energyConsumptionLabel: "比エネルギー消費量 (SEC):",
    foulingSafetyLabel: "膜水力ファウリング・スケール裕度:",
    solidsRecoveryLabel: "濃縮倍率＆到達固形分:",
    overallStatusLabel: "プロセス適合性＆衛生安全分類:",
    diagramTitle: "連続式正浸透・ルーズナノ濾過流動プロセス系統図",
    diagramSub: "中空糸 FO 膜モジュール向流ドロー循環、ルーズ NF ミネラル透過排流、低温グリコールチラー、および CIP 自動洗浄ループを表示。",
    scienceTitle: "科学的原理：非加熱正浸透分画動力学とミネラル選択透過性",
    scienceSub: "膜多孔質支持層における内部濃度分極（ICP）、ルーズナノ濾過イオン透過動態、低温生理活性保護機構、および 3-A サニタリー規格 45-03 適合性を解析。",
    tableTitle: "連続 FO-NF と従来型多重効用蒸発、高圧逆浸透、電気透析技術の比較"
  }
};

const d = DICT[lang] || DICT.en;
---

<div class="space-y-10 my-8" id="fo-nf-whey-desalting-root">
  <!-- Header Card -->
  <div class="p-8 rounded-3xl bg-surface-soft border border-hairline shadow-sm">
    <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
      <span class="inline-block px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-teal-950 text-teal-200 border border-teal-800">
        {d.badge}
      </span>
      <span class="text-xs text-muted font-mono">
        3-A Sanitary 45-03 &bull; EHEDG Class I &bull; FDA 21 CFR § 117 &bull; D90 Grade
      </span>
    </div>
    <h1 class="text-title-xl font-bold text-ink tracking-tight mb-3">
      {d.title}
    </h1>
    <p class="text-body text-base max-w-4xl text-muted leading-relaxed">
      {d.subtitle}
    </p>
  </div>

  <!-- Presets Bar -->
  <div class="p-6 rounded-2xl bg-surface-soft border border-hairline space-y-3">
    <div class="text-xs font-bold text-ink uppercase tracking-wider">
      {d.presetsTitle}
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-2.5">
      <button
        type="button"
        id="btn-preset-d90"
        class="text-left px-3.5 py-2.5 rounded-xl border border-teal-800/60 bg-teal-950/40 hover:bg-teal-900/50 text-teal-200 text-xs font-medium transition-all"
      >
        🍼 {d.presetD90}
      </button>
      <button
        type="button"
        id="btn-preset-acid"
        class="text-left px-3.5 py-2.5 rounded-xl border border-sky-800/60 bg-sky-950/40 hover:bg-sky-900/50 text-sky-200 text-xs font-medium transition-all"
      >
        🥣 {d.presetAcid}
      </button>
      <button
        type="button"
        id="btn-preset-colostrum"
        class="text-left px-3.5 py-2.5 rounded-xl border border-amber-800/60 bg-amber-950/40 hover:bg-amber-900/50 text-amber-200 text-xs font-medium transition-all"
      >
        🛡️ {d.presetColostrum}
      </button>
      <button
        type="button"
        id="btn-preset-uf"
        class="text-left px-3.5 py-2.5 rounded-xl border border-purple-800/60 bg-purple-950/40 hover:bg-purple-900/50 text-purple-200 text-xs font-medium transition-all"
      >
        💎 {d.presetUf}
      </button>
      <button
        type="button"
        id="btn-preset-hazard"
        class="text-left px-3.5 py-2.5 rounded-xl border border-rose-800/60 bg-rose-950/40 hover:bg-rose-900/50 text-rose-200 text-xs font-medium transition-all md:col-span-2 lg:col-span-1"
      >
        ⚠️ {d.presetHazard}
      </button>
    </div>
  </div>

  <!-- Interactive Controls & Live Telemetry Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <!-- Controls Column (5 cols) -->
    <div class="lg:col-span-5 p-7 rounded-3xl bg-surface-soft border border-hairline space-y-6">
      <div>
        <h2 class="text-title-md font-bold text-ink tracking-tight">
          {d.controlsTitle}
        </h2>
        <p class="text-xs text-muted mt-1 leading-relaxed">
          {d.controlsSub}
        </p>
      </div>

      <!-- Skid Select -->
      <div class="space-y-1.5">
        <label for="fo-skid-select" class="block text-xs font-bold text-ink uppercase tracking-wider">
          {d.systemLabel}
        </label>
        <select
          id="fo-skid-select"
          class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-xs text-ink focus:outline-none focus:ring-2 focus:ring-teal-500"
        >
          {foNfData.membraneSystems.map((sys, idx) => (
            <option value={idx}>{sys.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted">{d.systemHelp}</p>
      </div>

      <!-- Feed Matrix Select -->
      <div class="space-y-1.5">
        <label for="fo-matrix-select" class="block text-xs font-bold text-ink uppercase tracking-wider">
          {d.matrixLabel}
        </label>
        <select
          id="fo-matrix-select"
          class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-xs text-ink focus:outline-none focus:ring-2 focus:ring-teal-500"
        >
          {foNfData.wheyFeedMatrices.map((mat, idx) => (
            <option value={idx}>{mat.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted">{d.matrixHelp}</p>
      </div>

      <!-- Draw Solute Select -->
      <div class="space-y-1.5">
        <label for="fo-draw-select" class="block text-xs font-bold text-ink uppercase tracking-wider">
          {d.drawLabel}
        </label>
        <select
          id="fo-draw-select"
          class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-xs text-ink focus:outline-none focus:ring-2 focus:ring-teal-500"
        >
          {foNfData.drawSolutions.map((draw, idx) => (
            <option value={idx}>{draw.solute}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted">{d.drawHelp}</p>
      </div>

      <!-- Feed Flow Rate Slider -->
      <div class="space-y-2">
        <div class="flex justify-between items-center text-xs">
          <span class="font-bold text-ink uppercase tracking-wider">{d.feedFlowLabel}</span>
          <span id="feed-flow-val" class="font-mono text-teal-400 font-bold">4500 L/h</span>
        </div>
        <input
          type="range"
          id="feed-flow-slider"
          min="500"
          max="6000"
          step="100"
          value="4500"
          class="w-full accent-teal-500 cursor-pointer"
        />
        <p class="text-[11px] text-muted">{d.feedFlowHelp}</p>
      </div>

      <!-- Operating Temperature Slider -->
      <div class="space-y-2">
        <div class="flex justify-between items-center text-xs">
          <span class="font-bold text-ink uppercase tracking-wider">{d.tempLabel}</span>
          <span id="temp-val" class="font-mono text-teal-400 font-bold">10°C</span>
        </div>
        <input
          type="range"
          id="temp-slider"
          min="4"
          max="45"
          step="1"
          value="10"
          class="w-full accent-teal-500 cursor-pointer"
        />
        <p class="text-[11px] text-muted">{d.tempHelp}</p>
      </div>

      <!-- Target Concentration Slider -->
      <div class="space-y-2">
        <div class="flex justify-between items-center text-xs">
          <span class="font-bold text-ink uppercase tracking-wider">{d.solidsLabel}</span>
          <span id="solids-val" class="font-mono text-teal-400 font-bold">24.5 °Bx</span>
        </div>
        <input
          type="range"
          id="solids-slider"
          min="10"
          max="35"
          step="0.5"
          value="24.5"
          class="w-full accent-teal-500 cursor-pointer"
        />
        <p class="text-[11px] text-muted">{d.solidsHelp}</p>
      </div>

      <!-- Toggles Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
        <!-- Loose NF Toggle -->
        <label class="flex items-start gap-2.5 p-3 rounded-xl bg-surface border border-hairline cursor-pointer select-none">
          <input
            type="checkbox"
            id="loose-nf-toggle"
            checked
            class="mt-0.5 accent-teal-500 h-4 w-4 rounded"
          />
          <div>
            <div class="text-xs font-bold text-ink">{d.looseNfLabel}</div>
            <div class="text-[10px] text-muted mt-0.5 leading-snug">{d.looseNfHelp}</div>
          </div>
        </label>

        <!-- Chilled Jacket Toggle -->
        <label class="flex items-start gap-2.5 p-3 rounded-xl bg-surface border border-hairline cursor-pointer select-none">
          <input
            type="checkbox"
            id="chilled-jacket-toggle"
            checked
            class="mt-0.5 accent-teal-500 h-4 w-4 rounded"
          />
          <div>
            <div class="text-xs font-bold text-ink">{d.chilledJacketLabel}</div>
            <div class="text-[10px] text-muted mt-0.5 leading-snug">{d.chilledJacketHelp}</div>
          </div>
        </label>
      </div>
    </div>

    <!-- Live Telemetry Column (7 cols) -->
    <div class="lg:col-span-7 p-7 rounded-3xl bg-surface-soft border border-hairline flex flex-col justify-between space-y-6">
      <div>
        <div class="flex items-center justify-between gap-3 mb-2">
          <h2 class="text-title-md font-bold text-ink tracking-tight">
            {d.diagnosticTitle}
          </h2>
          <span id="overall-status-badge" class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-950 text-emerald-300 border border-emerald-800">
            OPTIMAL_FRACTIONATION
          </span>
        </div>
        <p class="text-xs text-muted leading-relaxed">
          {d.diagnosticSub}
        </p>
      </div>

      <!-- Metrics 2x4 Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-3.5">
        <!-- Metric 1: Water Flux -->
        <div class="p-4 rounded-2xl bg-surface border border-hairline/70">
          <div class="text-[10px] font-bold text-muted uppercase tracking-wider">
            {d.waterFluxLabel}
          </div>
          <div id="metric-water-flux" class="text-xl font-mono font-bold text-teal-400 mt-1">
            21.4 LMH
          </div>
          <div class="text-[10px] text-muted mt-0.5">
            L/(m²·h) Net Osmotic
          </div>
        </div>

        <!-- Metric 2: Demineralization -->
        <div class="p-4 rounded-2xl bg-surface border border-hairline/70">
          <div class="text-[10px] font-bold text-muted uppercase tracking-wider">
            {d.desaltingRateLabel}
          </div>
          <div id="metric-desalting" class="text-xl font-mono font-bold text-teal-400 mt-1">
            88.6 %
          </div>
          <div class="text-[10px] text-muted mt-0.5">
            Mineral Ash Extracted
          </div>
        </div>

        <!-- Metric 3: Bioactive Retention -->
        <div class="p-4 rounded-2xl bg-surface border border-hairline/70">
          <div class="text-[10px] font-bold text-muted uppercase tracking-wider">
            {d.bioactiveRetentionLabel}
          </div>
          <div id="metric-bioactive" class="text-xl font-mono font-bold text-teal-400 mt-1">
            99.6 %
          </div>
          <div class="text-[10px] text-muted mt-0.5">
            Native Lactoferrin/IgG
          </div>
        </div>

        <!-- Metric 4: Reverse Salt Flux -->
        <div class="p-4 rounded-2xl bg-surface border border-hairline/70">
          <div class="text-[10px] font-bold text-muted uppercase tracking-wider">
            {d.reverseSaltFluxLabel}
          </div>
          <div id="metric-reverse-salt" class="text-xl font-mono font-bold text-teal-400 mt-1">
            0.08 g/L
          </div>
          <div class="text-[10px] text-muted mt-0.5">
            Js/Jw &lt; 0.15 g/L Limit
          </div>
        </div>

        <!-- Metric 5: Energy Footprint -->
        <div class="p-4 rounded-2xl bg-surface border border-hairline/70">
          <div class="text-[10px] font-bold text-muted uppercase tracking-wider">
            {d.energyConsumptionLabel}
          </div>
          <div id="metric-energy" class="text-xl font-mono font-bold text-teal-400 mt-1">
            2.15 kWh/m³
          </div>
          <div class="text-[10px] text-muted mt-0.5">
            vs 28 kWh/m³ Evap
          </div>
        </div>

        <!-- Metric 6: Fouling Margin -->
        <div class="p-4 rounded-2xl bg-surface border border-hairline/70">
          <div class="text-[10px] font-bold text-muted uppercase tracking-wider">
            {d.foulingSafetyLabel}
          </div>
          <div id="metric-fouling" class="text-xl font-mono font-bold text-teal-400 mt-1">
            94.2 %
          </div>
          <div class="text-[10px] text-muted mt-0.5">
            Zero Hydraulic Cake
          </div>
        </div>

        <!-- Metric 7: Solids Recovery -->
        <div class="p-4 rounded-2xl bg-surface border border-hairline/70">
          <div class="text-[10px] font-bold text-muted uppercase tracking-wider">
            {d.solidsRecoveryLabel}
          </div>
          <div id="metric-solids-recovery" class="text-xl font-mono font-bold text-teal-400 mt-1">
            3.95x Fold
          </div>
          <div class="text-[10px] text-muted mt-0.5">
            24.5 °Bx Retentate
          </div>
        </div>

        <!-- Metric 8: Overall Status -->
        <div class="p-4 rounded-2xl bg-surface border border-hairline/70">
          <div class="text-[10px] font-bold text-muted uppercase tracking-wider">
            {d.overallStatusLabel}
          </div>
          <div id="metric-pmo-status" class="text-sm font-mono font-bold text-emerald-400 mt-1.5">
            D90 INFANT PASS
          </div>
          <div class="text-[10px] text-muted mt-0.5">
            3-A 45-03 Verified
          </div>
        </div>
      </div>

      <!-- Real-Time Diagnostic Feed & Warning Box -->
      <div id="diagnostic-notice-box" class="p-4 rounded-2xl bg-teal-950/40 border border-teal-800/60 text-xs leading-relaxed space-y-1">
        <div class="font-bold text-teal-300 flex items-center gap-2">
          <span>🔬 Process Engineering Evaluation:</span>
          <span id="notice-tag" class="text-[10px] uppercase font-mono px-2 py-0.5 rounded bg-teal-900 text-teal-200">OPTIMAL</span>
        </div>
        <p id="notice-desc" class="text-teal-200/90 text-[11px]">
          Operating at 10°C with 4,500 L/h feed flow and coupled loose NF stage. Osmotic driving gradient (Δπ = 137.8 bar) extracts water smoothly without mechanical shear heating. Native lactoferrin and IgG tertiary conformation preserved at &gt;99.5%. Monovalent salts permeate cleanly, meeting D90 pediatric formula standards.
        </p>
      </div>
    </div>
  </div>

  <!-- Interactive SVG Flow Diagram -->
  <div class="p-8 rounded-3xl bg-surface-soft border border-hairline space-y-4">
    <div>
      <h2 class="text-title-md font-bold text-ink tracking-tight">
        {d.diagramTitle}
      </h2>
      <p class="text-xs text-muted mt-1 leading-relaxed">
        {d.diagramSub}
      </p>
    </div>

    <div class="w-full overflow-x-auto bg-surface rounded-2xl border border-hairline p-4">
      <svg
        viewBox="0 0 960 380"
        class="w-full h-auto min-w-[750px] font-sans"
        xmlns="http://www.w3.org/2000/svg"
      >
        <!-- Background Grid -->
        <defs>
          <pattern id="diag-grid" width="20" height="20" patternUnits="userSpaceOnUse">
            <path d="M 20 0 L 0 0 0 20" fill="none" stroke="rgba(255,255,255,0.04)" stroke-width="1" />
          </pattern>
          <linearGradient id="foGradient" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#0f766e" stop-opacity="0.8" />
            <stop offset="100%" stop-color="#14b8a6" stop-opacity="0.8" />
          </linearGradient>
          <linearGradient id="drawGradient" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#0284c7" stop-opacity="0.8" />
            <stop offset="100%" stop-color="#38bdf8" stop-opacity="0.8" />
          </linearGradient>
          <linearGradient id="nfGradient" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#7e22ce" stop-opacity="0.8" />
            <stop offset="100%" stop-color="#a855f7" stop-opacity="0.8" />
          </linearGradient>
        </defs>

        <rect width="960" height="380" fill="transparent" />
        <rect width="960" height="380" fill="url(#diag-grid)" />

        <!-- 1. FEED INLET STREAM -->
        <g transform="translate(30, 110)">
          <rect width="140" height="70" rx="10" fill="#1e293b" stroke="#334155" stroke-width="1.5" />
          <text x="70" y="28" fill="#f8fafc" font-size="11" font-weight="bold" text-anchor="middle">WHEY FEED INLET</text>
          <text x="70" y="46" fill="#94a3b8" font-size="9" text-anchor="middle">Sweet / Acid Whey</text>
          <text id="svg-feed-txt" x="70" y="60" fill="#2dd4bf" font-size="9" font-family="monospace" text-anchor="middle">4500 L/h • 10°C</text>
        </g>

        <!-- Feed Flow Line into FO -->
        <path d="M 170 145 L 260 145" fill="none" stroke="#2dd4bf" stroke-width="3" stroke-dasharray="5 3" />
        <polygon points="260,145 252,140 252,150" fill="#2dd4bf" />

        <!-- 2. FORWARD OSMOSIS (FO) HOLLOW-FIBER MODULE -->
        <g transform="translate(260, 60)">
          <!-- Outer Membrane Housing -->
          <rect width="280" height="170" rx="16" fill="#0f172a" stroke="#0d9488" stroke-width="2" />
          <rect x="15" y="30" width="250" height="110" rx="10" fill="url(#foGradient)" opacity="0.15" />
          
          <!-- Hollow-Fiber Bundle Lines -->
          <line x1="25" y1="50" x2="255" y2="50" stroke="#2dd4bf" stroke-width="1.5" stroke-dasharray="8 4" opacity="0.6" />
          <line x1="25" y1="65" x2="255" y2="65" stroke="#2dd4bf" stroke-width="1.5" stroke-dasharray="8 4" opacity="0.6" />
          <line x1="25" y1="80" x2="255" y2="80" stroke="#2dd4bf" stroke-width="2" stroke-dasharray="8 4" opacity="0.8" />
          <line x1="25" y1="95" x2="255" y2="95" stroke="#2dd4bf" stroke-width="2" stroke-dasharray="8 4" opacity="0.8" />
          <line x1="25" y1="110" x2="255" y2="110" stroke="#2dd4bf" stroke-width="1.5" stroke-dasharray="8 4" opacity="0.6" />
          <line x1="25" y1="125" x2="255" y2="125" stroke="#2dd4bf" stroke-width="1.5" stroke-dasharray="8 4" opacity="0.6" />

          <text x="140" y="24" fill="#5eead4" font-size="12" font-weight="bold" text-anchor="middle">FO HOLLOW-FIBER CONTACTOR</text>
          <text x="140" y="90" fill="#ffffff" font-size="10" font-weight="bold" text-anchor="middle">Osmotic Gradient (Δπ &gt; 130 bar)</text>
          <text id="svg-flux-txt" x="140" y="106" fill="#99f6e4" font-size="9" font-family="monospace" text-anchor="middle">J_w = 21.4 LMH • No Pressure Compaction</text>

          <!-- Glycol Jacket Indicator -->
          <rect id="svg-jacket-box" x="20" y="146" width="240" height="18" rx="6" fill="#0284c7" opacity="0.3" stroke="#38bdf8" stroke-width="1" />
          <text id="svg-jacket-txt" x="140" y="159" fill="#bae6fd" font-size="8.5" font-weight="bold" text-anchor="middle">COUNTER-CURRENT GLYCOL JACKET (ACTIVE 10°C)</text>
        </g>

        <!-- DRAW SOLUTION LOOP -->
        <!-- Draw Inlet (Bottom to Top counter-current) -->
        <path d="M 500 310 L 500 230" fill="none" stroke="#38bdf8" stroke-width="2.5" stroke-dasharray="4 2" />
        <polygon points="500,230 496,238 504,238" fill="#38bdf8" />
        <text x="500" y="325" fill="#38bdf8" font-size="9" font-weight="bold" text-anchor="middle">DRAW INLET (CONC. 3.0M NaCl)</text>

        <!-- Draw Outlet (Diluted) -->
        <path d="M 300 60 L 300 25 L 430 25" fill="none" stroke="#38bdf8" stroke-width="2.5" stroke-dasharray="4 2" />
        <polygon points="430,25 422,21 422,29" fill="#38bdf8" />
        <text x="435" y="18" fill="#7dd3fc" font-size="9" font-weight="bold">DILUTED DRAW TO RO/NF REGEN</text>

        <!-- FO Retentate to Loose NF -->
        <path d="M 540 145 L 620 145" fill="none" stroke="#2dd4bf" stroke-width="3" />
        <polygon points="620,145 612,140 612,150" fill="#2dd4bf" />
        <text x="580" y="137" fill="#94a3b8" font-size="8" text-anchor="middle">CONC. WHEY</text>

        <!-- 3. LOOSE NANOFILTRATION (NF) STAGE -->
        <g id="svg-nf-group" transform="translate(620, 70)">
          <rect width="150" height="150" rx="14" fill="#1e1b4b" stroke="#8b5cf6" stroke-width="2" />
          <rect x="15" y="25" width="120" height="100" rx="8" fill="url(#nfGradient)" opacity="0.2" />
          
          <text x="75" y="20" fill="#c4b5fd" font-size="11" font-weight="bold" text-anchor="middle">LOOSE NF STAGE</text>
          <text x="75" y="55" fill="#e9d5ff" font-size="9" text-anchor="middle">MWCO 400–600 Da</text>
          <text x="75" y="75" fill="#a78bfa" font-size="8.5" text-anchor="middle">Polypiperazine Membrane</text>
          <text id="svg-desalt-txt" x="75" y="105" fill="#22c55e" font-size="9.5" font-weight="bold" font-family="monospace" text-anchor="middle">R_ash: 88.6%</text>
        </g>

        <!-- NF Permeate Stream (Mineral Saline discharge) -->
        <path id="svg-perm-line" d="M 695 220 L 695 290" fill="none" stroke="#a855f7" stroke-width="2" stroke-dasharray="4 2" />
        <polygon id="svg-perm-arrow" points="695,290 691,282 699,282" fill="#a855f7" />
        <g id="svg-perm-box" transform="translate(630, 290)">
          <rect width="130" height="45" rx="8" fill="#1e1b4b" stroke="#7c3aed" stroke-width="1.2" />
          <text x="65" y="20" fill="#d8b4fe" font-size="8.5" font-weight="bold" text-anchor="middle">MINERAL PERMEATE</text>
          <text x="65" y="34" fill="#a78bfa" font-size="8" text-anchor="middle">Na+, K+, Cl-, Lactate Saline</text>
        </g>

        <!-- NF Retentate Stream (Final D90 Product) -->
        <path d="M 770 145 L 830 145" fill="none" stroke="#22c55e" stroke-width="3" />
        <polygon points="830,145 822,140 822,150" fill="#22c55e" />

        <!-- 4. FINAL PRODUCT OUTLET -->
        <g transform="translate(830, 105)">
          <rect width="115" height="80" rx="12" fill="#064e3b" stroke="#10b981" stroke-width="2" />
          <text x="57" y="24" fill="#a7f3d0" font-size="10" font-weight="bold" text-anchor="middle">DESALTED WPC</text>
          <text x="57" y="42" fill="#6ee7b7" font-size="9" text-anchor="middle">D90 Protein / Lactose</text>
          <text id="svg-prod-brix" x="57" y="58" fill="#ffffff" font-size="9" font-family="monospace" text-anchor="middle">24.5°Bx Solids</text>
          <text id="svg-prod-bio" x="57" y="72" fill="#34d399" font-size="8.5" font-family="monospace" text-anchor="middle">99.6% Bioactive</text>
        </g>
      </svg>
    </div>
  </div>

  <!-- Scientific Principles & Engineering Foundations -->
  <div class="p-8 rounded-3xl bg-surface-soft border border-hairline space-y-6">
    <div>
      <h2 class="text-title-md font-bold text-ink tracking-tight">
        {d.scienceTitle}
      </h2>
      <p class="text-xs text-muted mt-1 leading-relaxed">
        {d.scienceSub}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {foNfData.transportMechanisms.map(mech => (
        <div class="p-5 rounded-2xl bg-surface border border-hairline/80 space-y-2">
          <div class="text-xs font-bold text-teal-300 uppercase tracking-wider">
            {mech.phenomenon}
          </div>
          <div class="p-2.5 rounded-lg bg-surface-soft font-mono text-[11px] text-teal-200/90 border border-teal-900/40">
            {mech.equation}
          </div>
          <p class="text-xs text-muted leading-relaxed">
            {mech.description}
          </p>
        </div>
      ))}
    </div>

    <!-- Sanitation & Standards Grid -->
    <div class="pt-4 border-t border-hairline/60">
      <div class="text-xs font-bold text-ink uppercase tracking-wider mb-4">
        Sanitary Certifications, FDA/USDA Dairy Regulations & CIP Standards
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {foNfData.safetyAndSanitationStandards.map(std => (
          <div class="p-4 rounded-xl bg-surface border border-hairline space-y-1.5">
            <div class="text-xs font-bold text-ink">
              {std.standard}
            </div>
            <div class="text-[11px] text-muted leading-snug">
              <span class="font-medium text-ink/80">Req:</span> {std.requirement}
            </div>
            <div class="text-[10px] text-teal-400/90 font-mono">
              ✓ {std.compliance}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Comparative Technology Benchmark Table -->
  <div class="p-8 rounded-3xl bg-surface-soft border border-hairline space-y-4">
    <div>
      <h2 class="text-title-md font-bold text-ink tracking-tight">
        {d.tableTitle}
      </h2>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-xs text-left border-collapse">
        <thead>
          <tr class="border-b border-hairline text-muted uppercase text-[10px] tracking-wider">
            <th class="py-3 px-4">Technology Architecture</th>
            <th class="py-3 px-4">Operating Temp</th>
            <th class="py-3 px-4">Lactoferrin / IgG Retention</th>
            <th class="py-3 px-4">Demineralization (Ash)</th>
            <th class="py-3 px-4">Energy (kWh/m³)</th>
            <th class="py-3 px-4">Hydraulic Cake Compaction</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline/60 text-ink">
          <tr class="bg-teal-950/20 font-medium">
            <td class="py-3.5 px-4 text-teal-300 font-bold">Continuous FO-NF System (This Model)</td>
            <td class="py-3.5 px-4 font-mono text-teal-200">6°C to 12°C</td>
            <td class="py-3.5 px-4 font-mono text-emerald-400 font-bold">&gt; 99.5% Native</td>
            <td class="py-3.5 px-4 font-mono text-teal-300">&gt; 85% to 92%</td>
            <td class="py-3.5 px-4 font-mono text-emerald-400 font-bold">1.8 to 2.4</td>
            <td class="py-3.5 px-4 text-teal-200">Zero (Osmotic Drive)</td>
          </tr>
          <tr>
            <td class="py-3.5 px-4 font-medium">Multi-Effect Vacuum Thermal Evaporator (MVR)</td>
            <td class="py-3.5 px-4 font-mono text-rose-300">55°C to 75°C</td>
            <td class="py-3.5 px-4 font-mono text-rose-400">&lt; 45% (High Thermal Loss)</td>
            <td class="py-3.5 px-4 font-mono">0% (Concentrates Ash)</td>
            <td class="py-3.5 px-4 font-mono text-rose-300">24.0 to 38.0</td>
            <td class="py-3.5 px-4 text-muted">Thermal Scaling On Tubes</td>
          </tr>
          <tr>
            <td class="py-3.5 px-4 font-medium">High-Pressure Reverse Osmosis (RO, 65 bar)</td>
            <td class="py-3.5 px-4 font-mono">10°C to 18°C</td>
            <td class="py-3.5 px-4 font-mono text-amber-300">82% to 88% (Shear Loss)</td>
            <td class="py-3.5 px-4 font-mono">&lt; 10% (Rejects Salts)</td>
            <td class="py-3.5 px-4 font-mono">6.5 to 9.2</td>
            <td class="py-3.5 px-4 text-amber-300">Severe Cake Layer Fouling</td>
          </tr>
          <tr>
            <td class="py-3.5 px-4 font-medium">Electrodialysis Demineralization (EDR)</td>
            <td class="py-3.5 px-4 font-mono">15°C to 25°C</td>
            <td class="py-3.5 px-4 font-mono">88% to 93%</td>
            <td class="py-3.5 px-4 font-mono text-teal-300">75% to 90%</td>
            <td class="py-3.5 px-4 font-mono">8.5 to 14.0</td>
            <td class="py-3.5 px-4 text-muted">Electrode Scale &amp; High Waste</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  function initFoNfModeler() {
    const root = document.getElementById('fo-nf-whey-desalting-root');
    if (!root) return;

    // Elements
    const skidSelect = document.getElementById('fo-skid-select') as HTMLSelectElement | null;
    const matrixSelect = document.getElementById('fo-matrix-select') as HTMLSelectElement | null;
    const drawSelect = document.getElementById('fo-draw-select') as HTMLSelectElement | null;
    const feedFlowSlider = document.getElementById('feed-flow-slider') as HTMLInputElement | null;
    const tempSlider = document.getElementById('temp-slider') as HTMLInputElement | null;
    const solidsSlider = document.getElementById('solids-slider') as HTMLInputElement | null;
    const looseNfToggle = document.getElementById('loose-nf-toggle') as HTMLInputElement | null;
    const chilledJacketToggle = document.getElementById('chilled-jacket-toggle') as HTMLInputElement | null;

    // Value Badges
    const feedFlowVal = document.getElementById('feed-flow-val');
    const tempVal = document.getElementById('temp-val');
    const solidsVal = document.getElementById('solids-val');

    // Metrics
    const metricWaterFlux = document.getElementById('metric-water-flux');
    const metricDesalting = document.getElementById('metric-desalting');
    const metricBioactive = document.getElementById('metric-bioactive');
    const metricReverseSalt = document.getElementById('metric-reverse-salt');
    const metricEnergy = document.getElementById('metric-energy');
    const metricFouling = document.getElementById('metric-fouling');
    const metricSolidsRecovery = document.getElementById('metric-solids-recovery');
    const metricPmoStatus = document.getElementById('metric-pmo-status');
    const overallStatusBadge = document.getElementById('overall-status-badge');
    const noticeBox = document.getElementById('diagnostic-notice-box');
    const noticeTag = document.getElementById('notice-tag');
    const noticeDesc = document.getElementById('notice-desc');

    // SVG elements
    const svgFeedTxt = document.getElementById('svg-feed-txt');
    const svgFluxTxt = document.getElementById('svg-flux-txt');
    const svgDesaltTxt = document.getElementById('svg-desalt-txt');
    const svgProdBrix = document.getElementById('svg-prod-brix');
    const svgProdBio = document.getElementById('svg-prod-bio');
    const svgJacketBox = document.getElementById('svg-jacket-box');
    const svgJacketTxt = document.getElementById('svg-jacket-txt');
    const svgNfGroup = document.getElementById('svg-nf-group');
    const svgPermLine = document.getElementById('svg-perm-line');
    const svgPermArrow = document.getElementById('svg-perm-arrow');
    const svgPermBox = document.getElementById('svg-perm-box');

    // Preset Buttons
    const btnD90 = document.getElementById('btn-preset-d90');
    const btnAcid = document.getElementById('btn-preset-acid');
    const btnColostrum = document.getElementById('btn-preset-colostrum');
    const btnUf = document.getElementById('btn-preset-uf');
    const btnHazard = document.getElementById('btn-preset-hazard');

    function calculateTelemetry() {
      if (!skidSelect || !matrixSelect || !drawSelect || !feedFlowSlider || !tempSlider || !solidsSlider) return;

      const skidIdx = parseInt(skidSelect.value, 10);
      const matrixIdx = parseInt(matrixSelect.value, 10);
      const drawIdx = parseInt(drawSelect.value, 10);
      const flow = parseFloat(feedFlowSlider.value);
      const temp = parseFloat(tempSlider.value);
      const targetBrix = parseFloat(solidsSlider.value);
      const isLooseNf = looseNfToggle ? looseNfToggle.checked : true;
      const isJacket = chilledJacketToggle ? chilledJacketToggle.checked : true;

      // Update Slider value tags
      if (feedFlowVal) feedFlowVal.textContent = `${flow.toLocaleString()} L/h`;
      if (tempVal) tempVal.textContent = `${temp.toFixed(0)}°C`;
      if (solidsVal) solidsVal.textContent = `${targetBrix.toFixed(1)} °Bx`;

      // Matrix Baseline Parameters
      // [Sweet Cheddar, Greek Yogurt Acid, Cottage Cheese, UF Permeate, Bovine Colostrum]
      const baseSolids = [6.2, 5.8, 6.0, 5.4, 11.5][matrixIdx] || 6.2;
      const baseOsmotic = [7.2, 8.9, 8.4, 6.8, 10.5][matrixIdx] || 7.2;
      const baseBioactiveRate = [99.7, 99.4, 99.5, 99.8, 99.9][matrixIdx] || 99.6;

      // Draw Solute Parameters
      // [NaCl 3.0M, Potassium Lactate 2.5M, MgCl2 1.8M, Sucrose 55%]
      const drawOsmotic = [145.0, 118.0, 162.0, 78.0][drawIdx] || 145.0;
      const drawRsrBase = [0.12, 0.05, 0.08, 0.01][drawIdx] || 0.10;
      const drawEnergyBase = [1.85, 2.10, 1.95, 3.40][drawIdx] || 2.0;

      // Skid Permeability Multiplier
      // [185m2 TFC, 120m2 CTA, 95m2 Aquaporin, 0.75m2 Pilot]
      const skidWaterPerm = [9.4, 6.8, 12.2, 8.1][skidIdx] || 9.4;

      // Concentration Fold
      const concFold = Math.max(1.0, targetBrix / baseSolids);

      // Temperature Effect on Flux (Arrhenius viscosity compensation ~ 2.5% per °C above 10°C)
      const tempFactor = 1.0 + (temp - 10.0) * 0.024;
      const effectiveDeltaPi = Math.max(20.0, drawOsmotic - (baseOsmotic * Math.pow(concFold, 0.85)));

      // Net Water Flux J_w (LMH)
      let waterFlux = (skidWaterPerm * (effectiveDeltaPi / 65.0) * tempFactor * (isJacket ? 1.0 : 0.92));
      waterFlux = Math.min(38.0, Math.max(4.2, waterFlux));

      // Reverse Salt Flux J_s (g/L)
      let reverseSalt = drawRsrBase * (1.0 + (temp - 10.0) * 0.035) * (concFold * 0.45);
      if (!isJacket && temp > 25.0) reverseSalt *= 1.8;

      // Desalting / Mineral Removal (R_ash %)
      let desaltingRate = 0;
      if (isLooseNf) {
        // High loose NF mineral permeation
        desaltingRate = 88.5 - (targetBrix - 20.0) * 0.45 + (flow / 6000.0) * 3.5;
        if (matrixIdx === 1) desaltingRate += 2.8; // Acid whey lactate permeates easily
        desaltingRate = Math.min(94.5, Math.max(68.0, desaltingRate));
      } else {
        // FO alone retains most minerals with proteins
        desaltingRate = 12.0 + (matrixIdx === 1 ? 8.0 : 4.0);
      }

      // Native Bioactive Retention (%)
      let bioactiveRetention = baseBioactiveRate;
      if (temp > 15.0) {
        // Thermal denaturation kicks in above 15°C, accelerates above 30°C
        const tempPenalty = (temp - 15.0) * 0.45 + (temp > 30.0 ? Math.pow(temp - 30.0, 1.4) : 0);
        bioactiveRetention -= tempPenalty;
      }
      if (!isJacket) {
        bioactiveRetention -= 3.2; // Lack of cooling jacket causes localized boundary layer shear heating
      }
      bioactiveRetention = Math.min(99.9, Math.max(42.0, bioactiveRetention));

      // Specific Energy Consumption (kWh/m3)
      let sec = drawEnergyBase + (flow / 4500.0) * 0.25 + (isLooseNf ? 0.35 : 0.0) + (isJacket ? 0.20 : 0.0);

      // Fouling Safety Margin (%)
      let foulingSafety = 96.0 - (targetBrix - 10.0) * 0.8 - (temp > 30.0 ? (temp - 30.0) * 1.5 : 0.0);
      if (matrixIdx === 1) foulingSafety -= 4.0; // Acid whey calcium phosphate scaling risk
      foulingSafety = Math.min(99.0, Math.max(35.0, foulingSafety));

      // Classification & Warnings
      let isHazard = false;
      let statusTag = 'OPTIMAL_FRACTIONATION';
      let statusClass = 'bg-emerald-950 text-emerald-300 border-emerald-800';
      let pmoText = 'D90 INFANT PASS';
      let pmoColor = 'text-emerald-400';
      let noticeMsg = '';

      if (temp >= 35.0 || bioactiveRetention < 80.0 || reverseSalt > 0.35) {
        isHazard = true;
        statusTag = 'HAZARD_THERMAL_DEGRADATION';
        statusClass = 'bg-rose-950 text-rose-300 border-rose-800';
        pmoText = 'PMO REJECTED';
        pmoColor = 'text-rose-400';
        noticeMsg = `CRITICAL HAZARD: Operating temperature (${temp}°C) exceeds safe limits. Lactoferrin and IgG tertiary structure denatured (${bioactiveRetention.toFixed(1)}% retention). Elevated reverse salt leakage (${reverseSalt.toFixed(2)} g/L) contaminates dairy stream with draw solute. Activate Chilled Glycol Jacket immediately.`;
      } else if (!isLooseNf) {
        statusTag = 'WPC_CONCENTRATE_HIGH_ASH';
        statusClass = 'bg-amber-950 text-amber-300 border-amber-800';
        pmoText = 'WPC-35/50 COMPLIANT';
        pmoColor = 'text-amber-400';
        noticeMsg = `NOTICE: Loose NF mineral bypass is active. Concentrates lactose and whey protein to ${targetBrix.toFixed(1)}°Bx, but ash demineralization is limited (${desaltingRate.toFixed(1)}%). Suitable for standard WPC-34/50 ingredients, but does not meet D90 infant-formula demineralized criteria.`;
      } else if (targetBrix > 30.0) {
        statusTag = 'HIGH_BRIX_VISCOSITY_WARN';
        statusClass = 'bg-purple-950 text-purple-300 border-purple-800';
        pmoText = 'CRYSTALLIZATION SYRUP';
        pmoColor = 'text-purple-400';
        noticeMsg = `HIGH SOLIDS ADVISORY: Target retentate reaches ${targetBrix.toFixed(1)}°Bx. Water flux dampens due to internal concentration polarization (ICP). High lactose supersaturation provides excellent crystallization feed for pharmaceutical-grade lactose recovery.`;
      } else {
        statusTag = 'OPTIMAL_D90_FRACTIONATION';
        statusClass = 'bg-emerald-950 text-emerald-300 border-emerald-800';
        pmoText = 'D90 INFANT PASS';
        pmoColor = 'text-emerald-400';
        noticeMsg = `OPTIMAL PERFORMANCE: Operating at ${temp}°C with ${flow.toLocaleString()} L/h feed flow and coupled loose NF polishing. Osmotic driving gradient extracts water with zero hydraulic cake compaction. Native lactoferrin and IgG tertiary folding preserved at ${bioactiveRetention.toFixed(1)}%. Meets 3-A Standard 45-03 and USDA D90 pediatric standards.`;
      }

      // Update Telemetry Elements
      if (metricWaterFlux) metricWaterFlux.textContent = `${waterFlux.toFixed(1)} LMH`;
      if (metricDesalting) metricDesalting.textContent = `${desaltingRate.toFixed(1)} %`;
      if (metricBioactive) {
        metricBioactive.textContent = `${bioactiveRetention.toFixed(1)} %`;
        metricBioactive.className = `text-xl font-mono font-bold mt-1 ${bioactiveRetention >= 95 ? 'text-teal-400' : bioactiveRetention >= 80 ? 'text-amber-400' : 'text-rose-400'}`;
      }
      if (metricReverseSalt) {
        metricReverseSalt.textContent = `${reverseSalt.toFixed(2)} g/L`;
        metricReverseSalt.className = `text-xl font-mono font-bold mt-1 ${reverseSalt <= 0.15 ? 'text-teal-400' : 'text-rose-400'}`;
      }
      if (metricEnergy) metricEnergy.textContent = `${sec.toFixed(2)} kWh/m³`;
      if (metricFouling) metricFouling.textContent = `${foulingSafety.toFixed(1)} %`;
      if (metricSolidsRecovery) metricSolidsRecovery.textContent = `${concFold.toFixed(2)}x Fold`;
      if (metricPmoStatus) {
        metricPmoStatus.textContent = pmoText;
        metricPmoStatus.className = `text-sm font-mono font-bold mt-1.5 ${pmoColor}`;
      }
      if (overallStatusBadge) {
        overallStatusBadge.textContent = statusTag;
        overallStatusBadge.className = `px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider ${statusClass}`;
      }
      if (noticeBox && noticeTag && noticeDesc) {
        noticeTag.textContent = statusTag.split('_')[0];
        noticeDesc.textContent = noticeMsg;
        if (isHazard) {
          noticeBox.className = 'p-4 rounded-2xl bg-rose-950/40 border border-rose-800/60 text-xs leading-relaxed space-y-1';
          noticeTag.className = 'text-[10px] uppercase font-mono px-2 py-0.5 rounded bg-rose-900 text-rose-200';
        } else if (!isLooseNf) {
          noticeBox.className = 'p-4 rounded-2xl bg-amber-950/40 border border-amber-800/60 text-xs leading-relaxed space-y-1';
          noticeTag.className = 'text-[10px] uppercase font-mono px-2 py-0.5 rounded bg-amber-900 text-amber-200';
        } else {
          noticeBox.className = 'p-4 rounded-2xl bg-teal-950/40 border border-teal-800/60 text-xs leading-relaxed space-y-1';
          noticeTag.className = 'text-[10px] uppercase font-mono px-2 py-0.5 rounded bg-teal-900 text-teal-200';
        }
      }

      // Update SVG Interactive Elements
      if (svgFeedTxt) svgFeedTxt.textContent = `${flow.toLocaleString()} L/h • ${temp}°C`;
      if (svgFluxTxt) svgFluxTxt.textContent = `J_w = ${waterFlux.toFixed(1)} LMH • No Pressure Compaction`;
      if (svgDesaltTxt) svgDesaltTxt.textContent = isLooseNf ? `R_ash: ${desaltingRate.toFixed(1)}%` : 'NF BYPASSED';
      if (svgProdBrix) svgProdBrix.textContent = `${targetBrix.toFixed(1)}°Bx Solids`;
      if (svgProdBio) svgProdBio.textContent = `${bioactiveRetention.toFixed(1)}% Bioactive`;

      if (svgJacketBox && svgJacketTxt) {
        if (isJacket) {
          svgJacketBox.setAttribute('opacity', '0.35');
          svgJacketBox.setAttribute('fill', '#0284c7');
          svgJacketTxt.textContent = `COUNTER-CURRENT GLYCOL JACKET (ACTIVE ${temp}°C)`;
        } else {
          svgJacketBox.setAttribute('opacity', '0.15');
          svgJacketBox.setAttribute('fill', '#475569');
          svgJacketTxt.textContent = 'GLYCOL JACKET OFF (ADIABATIC EXP)';
        }
      }

      if (svgNfGroup && svgPermLine && svgPermArrow && svgPermBox) {
        if (isLooseNf) {
          svgNfGroup.setAttribute('opacity', '1.0');
          svgPermLine.setAttribute('stroke', '#a855f7');
          svgPermArrow.setAttribute('fill', '#a855f7');
          svgPermBox.setAttribute('opacity', '1.0');
        } else {
          svgNfGroup.setAttribute('opacity', '0.45');
          svgPermLine.setAttribute('stroke', '#64748b');
          svgPermArrow.setAttribute('fill', '#64748b');
          svgPermBox.setAttribute('opacity', '0.4');
        }
      }
    }

    // Attach Listeners
    [skidSelect, matrixSelect, drawSelect, feedFlowSlider, tempSlider, solidsSlider, looseNfToggle, chilledJacketToggle].forEach(el => {
      if (el) el.addEventListener('input', calculateTelemetry);
      if (el) el.addEventListener('change', calculateTelemetry);
    });

    // Preset handlers
    if (btnD90) {
      btnD90.addEventListener('click', () => {
        if (skidSelect) skidSelect.value = '0';
        if (matrixSelect) matrixSelect.value = '0';
        if (drawSelect) drawSelect.value = '0';
        if (feedFlowSlider) feedFlowSlider.value = '4500';
        if (tempSlider) tempSlider.value = '10';
        if (solidsSlider) solidsSlider.value = '24.5';
        if (looseNfToggle) looseNfToggle.checked = true;
        if (chilledJacketToggle) chilledJacketToggle.checked = true;
        calculateTelemetry();
      });
    }

    if (btnAcid) {
      btnAcid.addEventListener('click', () => {
        if (skidSelect) skidSelect.value = '1';
        if (matrixSelect) matrixSelect.value = '1';
        if (drawSelect) drawSelect.value = '1';
        if (feedFlowSlider) feedFlowSlider.value = '2800';
        if (tempSlider) tempSlider.value = '12';
        if (solidsSlider) solidsSlider.value = '22.0';
        if (looseNfToggle) looseNfToggle.checked = true;
        if (chilledJacketToggle) chilledJacketToggle.checked = true;
        calculateTelemetry();
      });
    }

    if (btnColostrum) {
      btnColostrum.addEventListener('click', () => {
        if (skidSelect) skidSelect.value = '2';
        if (matrixSelect) matrixSelect.value = '4';
        if (drawSelect) drawSelect.value = '3';
        if (feedFlowSlider) feedFlowSlider.value = '1800';
        if (tempSlider) tempSlider.value = '6';
        if (solidsSlider) solidsSlider.value = '26.0';
        if (looseNfToggle) looseNfToggle.checked = false;
        if (chilledJacketToggle) chilledJacketToggle.checked = true;
        calculateTelemetry();
      });
    }

    if (btnUf) {
      btnUf.addEventListener('click', () => {
        if (skidSelect) skidSelect.value = '0';
        if (matrixSelect) matrixSelect.value = '3';
        if (drawSelect) drawSelect.value = '0';
        if (feedFlowSlider) feedFlowSlider.value = '4800';
        if (tempSlider) tempSlider.value = '15';
        if (solidsSlider) solidsSlider.value = '28.0';
        if (looseNfToggle) looseNfToggle.checked = true;
        if (chilledJacketToggle) chilledJacketToggle.checked = true;
        calculateTelemetry();
      });
    }

    if (btnHazard) {
      btnHazard.addEventListener('click', () => {
        if (skidSelect) skidSelect.value = '0';
        if (matrixSelect) matrixSelect.value = '0';
        if (drawSelect) drawSelect.value = '0';
        if (feedFlowSlider) feedFlowSlider.value = '1200';
        if (tempSlider) tempSlider.value = '38';
        if (solidsSlider) solidsSlider.value = '32.0';
        if (looseNfToggle) looseNfToggle.checked = false;
        if (chilledJacketToggle) chilledJacketToggle.checked = false;
        calculateTelemetry();
      });
    }

    // Initial run
    calculateTelemetry();
  }

  // Run on DOM load and Astro page transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFoNfModeler);
  } else {
    initFoNfModeler();
  }
  document.addEventListener('astro:page-load', initFoNfModeler);
</script>
