const t = UI[lang] || UI.en;

const defaultKnife = knives[0];
const defaultBoard = boards[0];
const defaultVerdict: VerdictKey = defaultBoard.compatByKnife[defaultKnife.id] || 'perfect';
const defaultVerdictInfo = verdictMeta[defaultVerdict] || verdictMeta.perfect;

function getVerdictDarkPillClass(v: VerdictKey): string {
  if (v === 'blade-killer') return 'bg-red-500 text-white';
  if (v === 'dulls-fast') return 'bg-amber-400 text-slate-950';
  if (v === 'good') return 'bg-sky-400 text-slate-950';
  return 'bg-emerald-400 text-slate-950';
}

function getVerdictBorderClass(v: VerdictKey): string {
  if (v === 'blade-killer') return 'border-red-400';
  if (v === 'dulls-fast') return 'border-amber-400';
  if (v === 'good') return 'border-sky-400';
  return 'border-emerald-400';
}

function getBoardCardPillClass(rating: BladeRatingKey): string {
  if (rating === 'unsafe') return 'bg-red-500/15 text-red-800 dark:text-red-200 border-red-500/45';
  if (rating === 'caution') return 'bg-amber-500/15 text-amber-900 dark:text-amber-200 border-amber-500/45';
  if (rating === 'great') return 'bg-sky-500/15 text-sky-800 dark:text-sky-200 border-sky-500/40';
  return 'bg-emerald-500/15 text-emerald-800 dark:text-emerald-200 border-emerald-500/40';
}

function getHoningPillClass(status: HoningStatusKey): string {
  if (status === 'never-rod') return 'bg-red-500/20 text-red-100 border-red-400/45';
  if (status === 'ceramic-only') return 'bg-amber-500/20 text-amber-100 border-amber-400/45';
  return 'bg-emerald-500/20 text-emerald-100 border-emerald-400/45';
}

function getCategoryLabel(cat: BoardCategoryKey): string {
  if (cat === 'wood') return t.catWood;
  if (cat === 'synthetic') return t.catSynthetic;
  if (cat === 'composite') return t.catComposite;
  return t.catUnsafe;
}

const categoryDefs: Array<{ key: 'all' | BoardCategoryKey; label: string }> = [
  { key: 'all', label: t.catAll },
  { key: 'wood', label: t.catWood },
  { key: 'synthetic', label: t.catSynthetic },
  { key: 'composite', label: t.catComposite },
  { key: 'unsafe-hard', label: t.catUnsafe }
];

const ratingDefs: Array<{ key: 'all' | 'friendly' | 'caution' | 'unsafe'; label: string }> = [
  { key: 'all', label: t.ratingAll },
  { key: 'friendly', label: t.ratingFriendly },
  { key: 'caution', label: t.ratingCaution },
  { key: 'unsafe', label: t.ratingUnsafe }
];

const clientPayload = {
  lang,
  defaultKnifeId: defaultKnife.id,
  defaultBoardId: defaultBoard.id,
  knives,
  boards,
  verdictMeta,
  honingData,
  safetyRules: safetyBanner.rules,
  ui: {
    copyBtn: t.copyBtn,
    copiedBtn: t.copiedBtn,
    bevelPillPrefix: t.bevelPillPrefix,
    whetstonePillPrefix: t.whetstonePillPrefix,
    showingPrefix: t.showingPrefix,
    showingSuffix: t.showingSuffix,
    copyHeader: t.copyHeader,
    copyPairingLabel: t.copyPairingLabel,
    copyVerdictLabel: t.copyVerdictLabel,
    copyBevelLabel: t.copyBevelLabel,
    copyHoningLabel: t.copyHoningLabel,
    copySharpeningLabel: t.copySharpeningLabel,
    copyDishwasherLabel: t.copyDishwasherLabel,
    copySanitationLabel: t.copySanitationLabel,
    copyRulesHeader: t.copyRulesHeader,
    knifeLabelPrefix: t.knifeLabelPrefix,
    boardLabelPrefix: t.boardLabelPrefix
  }
};
---

<div id="knife-board-matcher-root" class="space-y-12">
  <!-- Top 3-Rule Critical Knife & Board Safety Banner -->
  <aside
    class="p-5 sm:p-6 rounded-2xl bg-error-bg/80 dark:bg-red-950/45 border-2 border-error-border shadow-sm space-y-4"
    role="alert"
    aria-label={safetyBanner.badge}
  >
    <div class="space-y-1.5 max-w-4xl">
      <span class="inline-block px-3 py-0.5 rounded-full text-[11px] font-extrabold uppercase tracking-wider bg-error-border text-white">
        ⚠️ {safetyBanner.badge}
      </span>
      <h2 class="text-base sm:text-xl font-extrabold text-ink leading-snug">
        {safetyBanner.headline}
      </h2>
      <p class="text-xs sm:text-[13.5px] font-medium text-body leading-relaxed">
        {safetyBanner.subline}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      {safetyBanner.rules.map((rule) => (
        <div class="p-3.5 rounded-xl bg-canvas border border-hairline shadow-xs space-y-1">
          <div class="flex items-start gap-2">
            <span aria-hidden="true" class="text-lg leading-none mt-0.5 shrink-0">{rule.icon}</span>
            <h3 class="text-xs sm:text-[13px] font-extrabold text-ink leading-snug">{rule.title}</h3>
          </div>
          <p class="text-xs text-body leading-relaxed">{rule.body}</p>
        </div>
      ))}
    </div>
  </aside>

  <!-- Main Interactive Knife Care & Cutting Board Matcher Card -->
  <section
    id="knife-care-cutting-board-matcher"
    class="bg-canvas border border-hairline rounded-2xl shadow-sm overflow-hidden"
    aria-label={t.ariaLabel}
  >
    <script type="application/json" id="kcbm-payload" set:html={JSON.stringify(clientPayload)} />

    <!-- Header + Step 1 Compatibility Simulator -->
    <div class="p-5 sm:p-6 border-b border-hairline bg-surface-soft/50 space-y-6">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div class="space-y-1 max-w-2xl">
          <span class="inline-block px-2.5 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wider bg-signature-coral text-white">
            🔪 {t.toolBadge}
          </span>
          <h2 class="text-title-md font-bold text-ink">{t.toolTitle}</h2>
          <p class="text-xs sm:text-[13px] text-muted leading-relaxed">{t.toolSub}</p>
        </div>

