            {knives.map((k) => (
              <tr class="border-b border-hairline/60 break-inside-avoid">
                <td class="py-1.5 pr-2 font-bold text-ink">{k.shortName}</td>
                <td class="py-1.5 px-2 text-ink">{k.hrc} · {k.bevelAngle}</td>
                <td class="py-1.5 px-2 text-body">{k.honingBadge}</td>
                <td class="py-1.5 pl-2 text-body">{k.sharpeningRule}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="space-y-2">
        <h4 class="text-xs font-extrabold uppercase tracking-wider text-ink">{t.printBoardsHeading}</h4>
        <table class="w-full text-left border-collapse text-[10px]">
          <thead>
            <tr class="border-b border-hairline">
              <th class="py-1.5 pr-2 font-extrabold text-ink">{t.printColBoard}</th>
              <th class="py-1.5 px-2 font-extrabold text-ink">{t.printColRating}</th>
              <th class="py-1.5 px-2 font-extrabold text-ink">{t.printColDishwasher}</th>
              <th class="py-1.5 pl-2 font-extrabold text-ink">{t.printColMaint}</th>
            </tr>
          </thead>
          <tbody>
            {boards.map((b) => (
              <tr class="border-b border-hairline/60 break-inside-avoid">
                <td class="py-1.5 pr-2 font-bold text-ink">{b.shortName}</td>
                <td class="py-1.5 px-2 font-bold text-ink">{b.ratingBadge}</td>
                <td class="py-1.5 px-2 text-body">{b.dishwasherBadge}</td>
                <td class="py-1.5 pl-2 text-body">{b.oilRule}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Related Companion Tools (Localized via useTranslatedPath) -->
  <section class="space-y-4 print:hidden">
    <h2 class="text-title-md font-semibold text-ink">{t.relatedHeading}</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <a
        href={allergyUrl}
        class="p-5 rounded-2xl bg-surface-soft border border-hairline hover:border-signature-coral transition-all group block"
      >
        <span class="text-[11px] font-bold uppercase tracking-wider text-signature-coral block mb-1.5">
          {t.relatedAllergyTag}
        </span>
        <h3 class="text-title-sm font-semibold text-ink group-hover:text-signature-coral transition-colors mb-1.5">
          {t.relatedAllergyTitle}
        </h3>
        <p class="text-[13px] text-body leading-relaxed">{t.relatedAllergyDesc}</p>
      </a>

      <a
        href={dishwasherUrl}
        class="p-5 rounded-2xl bg-surface-soft border border-hairline hover:border-signature-coral transition-all group block"
      >
        <span class="text-[11px] font-bold uppercase tracking-wider text-signature-coral block mb-1.5">
          {t.relatedDishTag}
        </span>
        <h3 class="text-title-sm font-semibold text-ink group-hover:text-signature-coral transition-colors mb-1.5">
          {t.relatedDishTitle}
        </h3>
        <p class="text-[13px] text-body leading-relaxed">{t.relatedDishDesc}</p>
      </a>

      <a
        href={symbolUrl}
        class="p-5 rounded-2xl bg-surface-soft border border-hairline hover:border-signature-coral transition-all group block"
      >
        <span class="text-[11px] font-bold uppercase tracking-wider text-signature-coral block mb-1.5">
          {t.relatedSymbolTag}
        </span>
        <h3 class="text-title-sm font-semibold text-ink group-hover:text-signature-coral transition-colors mb-1.5">
          {t.relatedSymbolTitle}
        </h3>
        <p class="text-[13px] text-body leading-relaxed">{t.relatedSymbolDesc}</p>
      </a>
    </div>
  </section>

  <!-- Methodology & Hub Strip -->
  <section class="p-6 rounded-2xl bg-surface-soft border border-hairline print:hidden">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <h2 class="text-title-sm font-semibold text-ink mb-1">{t.methodologyStripTitle}</h2>
        <p class="text-[13px] text-muted">
          {t.methodologyStripPrefix}{' '}
          <a href={methodologyUrl} class="text-link underline hover:text-link-active">{t.methodologyLabel}</a>.
        </p>
      </div>
      <div class="flex flex-wrap gap-2">
        <a
          href={symbolUrl}
          class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral transition-colors"
        >
          {t.symbolQuickLabel}
        </a>
        <a
          href={methodologyUrl}
          class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral transition-colors"
        >
          {t.methodologyLabel}
        </a>
        <a
          href={allToolsUrl}
          class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-primary text-on-primary hover:bg-primary-active transition-colors"
        >
          {t.allToolsLabel}
        </a>
      </div>
    </div>
  </section>

  <!-- Visible 5-Item FAQ Accordion (Matches FAQPage JSON-LD 1:1) -->
  <section class="print:hidden">
    <h2 class="text-title-lg font-medium text-ink tracking-tight mb-6">
      {t.faqTitle}
    </h2>
    <div class="space-y-4">
      {localizedFaqs.map((faq) => (
        <details class="group p-5 bg-surface-soft border border-hairline rounded-xl" open>
          <summary class="text-title-sm font-semibold text-ink cursor-pointer list-none flex items-center justify-between gap-3">
            <span>{faq.question}</span>
            <span class="text-muted text-sm transition-transform group-open:rotate-180 shrink-0" aria-hidden="true">&#9662;</span>
          </summary>
          <p class="text-[14px] text-body leading-relaxed mt-3 pt-3 border-t border-hairline/70">
            {faq.answer}
          </p>
        </details>
      ))}
    </div>
  </section>
</div>

<script is:inline>
  (function () {
    var payloadEl = document.getElementById('kcbm-payload');
    if (!payloadEl) return;

    var payload;
    try {
      payload = JSON.parse(payloadEl.textContent || '{}');
    } catch (_) {
      return;
    }

    var knives = Array.isArray(payload.knives) ? payload.knives : [];
    var boards = Array.isArray(payload.boards) ? payload.boards : [];
    var verdictMeta = payload.verdictMeta || {};
    var safetyRules = Array.isArray(payload.safetyRules) ? payload.safetyRules : [];
    var ui = payload.ui || {};

    var knifeMap = {};
    knives.forEach(function (k) {
      if (k && k.id) knifeMap[k.id] = k;
    });

    var boardMap = {};
    boards.forEach(function (b) {
      if (b && b.id) boardMap[b.id] = b;
    });

    var state = {
      knifeId: payload.defaultKnifeId || (knives[0] ? knives[0].id : ''),
      boardId: payload.defaultBoardId || (boards[0] ? boards[0].id : ''),
      mode: 'honing',
      category: 'all',
      ratingFilter: 'all',
      query: ''
    };

    var knifeBtns = Array.from(document.querySelectorAll('.kcbm-knife-btn'));
    var boardBtns = Array.from(document.querySelectorAll('.kcbm-board-btn'));
    var modeBtns = Array.from(document.querySelectorAll('.kcbm-mode-btn'));
    var catBtns = Array.from(document.querySelectorAll('.kcbm-cat-btn'));
    var ratingBtns = Array.from(document.querySelectorAll('.kcbm-rating-btn'));
    var gridCards = Array.from(document.querySelectorAll('.kcbm-grid-card'));

    var elDashboard = document.getElementById('kcbm-dashboard');
    var elVerdictBadge = document.getElementById('kcbm-verdict-badge');
    var elBevelPill = document.getElementById('kcbm-bevel-pill');
    var elStonePill = document.getElementById('kcbm-stone-pill');
    var elPairTitle = document.getElementById('kcbm-pair-title');
    var elVerdictHeadline = document.getElementById('kcbm-verdict-headline');
    var elVerdictAdvice = document.getElementById('kcbm-verdict-advice');
    var elBoardRatingPill = document.getElementById('kcbm-board-rating-pill');
    var elBoardEffect = document.getElementById('kcbm-board-effect');
    var elKnifeCare = document.getElementById('kcbm-knife-care');
    var elHoningBadge = document.getElementById('kcbm-honing-badge');
    var elHoningRule = document.getElementById('kcbm-honing-rule');
    var elSharpeningRule = document.getElementById('kcbm-sharpening-rule');
    var elBoardDwPill = document.getElementById('kcbm-board-dw-pill');
    var elKnifeDw = document.getElementById('kcbm-knife-dw');
    var elBoardMaint = document.getElementById('kcbm-board-maint');
    var elBoardSanitation = document.getElementById('kcbm-board-sanitation');
    var elBoardOil = document.getElementById('kcbm-board-oil');

    var elHsKnifeName = document.getElementById('kcbm-hs-knife-name');
    var elHsActiveText = document.getElementById('kcbm-hs-active-text');
    var elHsBevelChip = document.getElementById('kcbm-hs-bevel-chip');
    var elHsGritChip = document.getElementById('kcbm-hs-grit-chip');
    var elCardHoning = document.getElementById('kcbm-card-honing');
    var elCardSharpening = document.getElementById('kcbm-card-sharpening');
    var elCardCarbide = document.getElementById('kcbm-card-carbide');

    var elSearch = document.getElementById('kcbm-search');
    var elSearchClear = document.getElementById('kcbm-search-clear');
    var elCount = document.getElementById('kcbm-count');
    var elEmpty = document.getElementById('kcbm-empty');
    var elResetBtn = document.getElementById('kcbm-reset-btn');

    var copyBtn = document.getElementById('kcbm-copy-btn');
    var copyLabel = document.getElementById('kcbm-copy-label');
    var printBtn = document.getElementById('kcbm-print-btn');

    function styleSelectorButtons(btns, attrName, selectedId) {
      btns.forEach(function (btn) {
        var active = btn.getAttribute(attrName) === selectedId;
        btn.setAttribute('aria-pressed', active ? 'true' : 'false');
        btn.classList.toggle('bg-primary', active);
        btn.classList.toggle('text-on-primary', active);
        btn.classList.toggle('border-primary', active);
        btn.classList.toggle('ring-2', active);
        btn.classList.toggle('ring-signature-coral/60', active);
        btn.classList.toggle('shadow-xs', active);
        btn.classList.toggle('bg-surface-soft/70', !active);
        btn.classList.toggle('text-ink', !active);
        btn.classList.toggle('border-hairline', !active);

        var sub = btn.querySelector('[data-kcbm-sub]');
        if (sub) {
          sub.classList.toggle('text-white/85', active);
          sub.classList.toggle('text-muted', !active);
        }

        var pill = btn.querySelector('[data-kcbm-pill]');
        if (pill) {
          pill.classList.toggle('bg-white/20', active);
          pill.classList.toggle('text-white', active);
          pill.classList.toggle('bg-canvas', !active);
          pill.classList.toggle('text-muted', !active);
          pill.classList.toggle('border', !active);
          pill.classList.toggle('border-hairline', !active);
        }
      });
    }

    function getVerdictDarkPillClass(v) {
      var base = 'inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-extrabold uppercase tracking-wider ';
      if (v === 'blade-killer') return base + 'bg-red-500 text-white';
      if (v === 'dulls-fast') return base + 'bg-amber-400 text-slate-950';
      if (v === 'good') return base + 'bg-sky-400 text-slate-950';
      return base + 'bg-emerald-400 text-slate-950';
    }

    function getHoningPillClass(status) {
      var base = 'inline-flex items-center px-2 py-0.5 rounded-md border text-[10px] font-extrabold uppercase tracking-wider ';
      if (status === 'never-rod') return base + 'bg-red-500/20 text-red-100 border-red-400/45';
      if (status === 'ceramic-only') return base + 'bg-amber-500/20 text-amber-100 border-amber-400/45';
      return base + 'bg-emerald-500/20 text-emerald-100 border-emerald-400/45';
    }

    function applyDashboardBorder(v) {
      if (!elDashboard) return;
      elDashboard.classList.toggle('border-red-400', v === 'blade-killer');
      elDashboard.classList.toggle('border-amber-400', v === 'dulls-fast');
      elDashboard.classList.toggle('border-sky-400', v === 'good');
      elDashboard.classList.toggle('border-emerald-400', v === 'perfect');
    }

    function renderHoningPanel() {
      var knife = knifeMap[state.knifeId] || knives[0];
      if (!knife) return;

      modeBtns.forEach(function (btn) {
        var active = btn.getAttribute('data-kcbm-mode') === state.mode;
        btn.setAttribute('aria-pressed', active ? 'true' : 'false');
        btn.classList.toggle('bg-primary', active);
        btn.classList.toggle('text-on-primary', active);
        btn.classList.toggle('border-primary', active);
        btn.classList.toggle('bg-surface-soft', !active);
        btn.classList.toggle('text-ink', !active);
        btn.classList.toggle('border-hairline', !active);
      });

      if (elHsKnifeName) elHsKnifeName.textContent = knife.name || '';
      if (elHsBevelChip) elHsBevelChip.textContent = '📐 ' + (knife.bevelLabel || '');
      if (elHsGritChip) elHsGritChip.textContent = '🪨 ' + (knife.whetstoneGrit || '');

      if (elHsActiveText) {
        if (state.mode === 'sharpening') {
          elHsActiveText.textContent = knife.sharpeningRule || '';
        } else if (state.mode === 'carbide') {
          elHsActiveText.textContent = knife.pullThroughWarning || '';
        } else {
          elHsActiveText.textContent = knife.honingRule || '';
        }
      }

      if (elCardHoning) {
        var hActive = state.mode === 'honing';
        elCardHoning.classList.toggle('border-2', hActive);
        elCardHoning.classList.toggle('border-signature-coral', hActive);
        elCardHoning.classList.toggle('bg-canvas', hActive);
        elCardHoning.classList.toggle('shadow-xs', hActive);
        elCardHoning.classList.toggle('border', !hActive);
        elCardHoning.classList.toggle('border-hairline', !hActive);
        elCardHoning.classList.toggle('bg-surface-soft/65', !hActive);
      }

      if (elCardSharpening) {
        var sActive = state.mode === 'sharpening';
        elCardSharpening.classList.toggle('border-2', sActive);
        elCardSharpening.classList.toggle('border-signature-coral', sActive);
        elCardSharpening.classList.toggle('bg-canvas', sActive);
        elCardSharpening.classList.toggle('shadow-xs', sActive);
        elCardSharpening.classList.toggle('border', !sActive);
        elCardSharpening.classList.toggle('border-hairline', !sActive);
        elCardSharpening.classList.toggle('bg-surface-soft/65', !sActive);
      }

      if (elCardCarbide) {
        var cActive = state.mode === 'carbide';
        elCardCarbide.classList.toggle('ring-2', cActive);
        elCardCarbide.classList.toggle('ring-error-border', cActive);
        elCardCarbide.classList.toggle('shadow-xs', cActive);
      }
    }

    function renderSimulator() {
      var knife = knifeMap[state.knifeId] || knives[0];
      var board = boardMap[state.boardId] || boards[0];
      if (!knife || !board) return;

      styleSelectorButtons(knifeBtns, 'data-kcbm-knife', knife.id);
      styleSelectorButtons(boardBtns, 'data-kcbm-board', board.id);

      gridCards.forEach(function (card) {
        var active = card.getAttribute('data-kcbm-grid-board') === board.id;
        card.setAttribute('aria-pressed', active ? 'true' : 'false');
        card.classList.toggle('bg-canvas', active);
        card.classList.toggle('border-signature-coral', active);
        card.classList.toggle('ring-2', active);
        card.classList.toggle('ring-signature-coral', active);
        card.classList.toggle('shadow-sm', active);
        card.classList.toggle('bg-surface-soft/65', !active);
        card.classList.toggle('border-hairline', !active);
      });

      var compatMap = board.compatByKnife || {};
      var verdict = compatMap[knife.id] || 'good';
      var vInfo = verdictMeta[verdict] || verdictMeta.good || { badge: '', headline: '', advice: '' };

      applyDashboardBorder(verdict);

      if (elVerdictBadge) {
        elVerdictBadge.textContent = vInfo.badge || '';
        elVerdictBadge.className = getVerdictDarkPillClass(verdict);
      }
      if (elBevelPill) {
        elBevelPill.textContent = '📐 ' + (ui.bevelPillPrefix || 'Bevel:') + ' ' + (knife.bevelAngle || '') + ' (' + (knife.hrc || '') + ')';
      }
      if (elStonePill) {
        elStonePill.textContent = '🪨 ' + (ui.whetstonePillPrefix || 'Stone:') + ' ' + (knife.whetstoneGrit || '');
      }
      if (elPairTitle) {
        elPairTitle.textContent = (knife.icon ? knife.icon + ' ' : '') + (knife.shortName || '') + ' × ' + (board.icon ? board.icon + ' ' : '') + (board.shortName || '');
      }
      if (elVerdictHeadline) elVerdictHeadline.textContent = vInfo.headline || '';
      if (elVerdictAdvice) elVerdictAdvice.textContent = vInfo.advice || '';
      if (elBoardRatingPill) elBoardRatingPill.textContent = board.ratingBadge || '';
      if (elBoardEffect) elBoardEffect.textContent = board.bladeEffect || '';
      if (elKnifeCare) elKnifeCare.textContent = knife.careRule || '';
      if (elHoningBadge) {
        elHoningBadge.textContent = knife.honingBadge || '';
        elHoningBadge.className = getHoningPillClass(knife.honingStatus);
      }
      if (elHoningRule) elHoningRule.textContent = knife.honingRule || '';
      if (elSharpeningRule) elSharpeningRule.textContent = knife.sharpeningRule || '';
      if (elBoardDwPill) elBoardDwPill.textContent = board.dishwasherBadge || '';
      if (elKnifeDw) elKnifeDw.textContent = knife.dishwasherRule || '';
      if (elBoardMaint) elBoardMaint.textContent = board.maintenanceRule || '';
      if (elBoardSanitation) elBoardSanitation.textContent = board.foodSafetyNote || '';
      if (elBoardOil) elBoardOil.textContent = board.oilRule || '';

      renderHoningPanel();
    }

    function applyFilters() {
      var q = (state.query || '').trim().toLowerCase();
      var visibleCount = 0;

      catBtns.forEach(function (btn) {
        var active = btn.getAttribute('data-kcbm-cat') === state.category;
        btn.setAttribute('aria-pressed', active ? 'true' : 'false');
        btn.classList.toggle('bg-primary', active);
        btn.classList.toggle('text-on-primary', active);
        btn.classList.toggle('border-primary', active);
        btn.classList.toggle('bg-surface-soft', !active);
        btn.classList.toggle('text-ink', !active);
        btn.classList.toggle('border-hairline', !active);
      });

      ratingBtns.forEach(function (btn) {
        var active = btn.getAttribute('data-kcbm-rating') === state.ratingFilter;
        btn.setAttribute('aria-pressed', active ? 'true' : 'false');
        btn.classList.toggle('bg-signature-coral', active);
        btn.classList.toggle('text-white', active);
        btn.classList.toggle('border-signature-coral', active);
        btn.classList.toggle('bg-canvas', !active);
        btn.classList.toggle('text-ink', !active);
        btn.classList.toggle('border-hairline', !active);
      });

      if (elSearchClear) {
        elSearchClear.classList.toggle('hidden', q.length === 0);
      }

      gridCards.forEach(function (card) {
        var id = card.getAttribute('data-kcbm-grid-board') || '';
        var board = boardMap[id];
        if (!board) return;

        var matchCat = state.category === 'all' || board.category === state.category;
        var matchRating = true;
        if (state.ratingFilter === 'friendly') {
          matchRating = board.bladeRating === 'gold' || board.bladeRating === 'great';
        } else if (state.ratingFilter === 'caution') {
          matchRating = board.bladeRating === 'caution';
        } else if (state.ratingFilter === 'unsafe') {
          matchRating = board.bladeRating === 'unsafe';
        }

        var matchQuery = true;
        if (q.length > 0) {
          var haystack = (
            (board.shortName || '') + ' ' +
            (board.name || '') + ' ' +
            (board.ratingBadge || '') + ' ' +
            (board.dishwasherBadge || '') + ' ' +
            (board.summary || '') + ' ' +
            (board.bladeEffect || '') + ' ' +
            (board.foodSafetyNote || '') + ' ' +
            (board.maintenanceRule || '') + ' ' +
            (board.oilRule || '')
          ).toLowerCase();
          matchQuery = haystack.indexOf(q) !== -1;
        }

        var show = matchCat && matchRating && matchQuery;
        card.classList.toggle('hidden', !show);
        if (show) visibleCount += 1;
      });

      if (elCount) {
        elCount.textContent = (ui.showingPrefix || 'Showing') + ' ' + String(visibleCount) + ' ' + (ui.showingSuffix || 'of 8 boards');
      }

      if (elEmpty) {
        elEmpty.classList.toggle('hidden', visibleCount > 0);
      }
    }

    function buildCopyCard() {
      var knife = knifeMap[state.knifeId] || knives[0];
      var board = boardMap[state.boardId] || boards[0];
      if (!knife || !board) return '';

      var compatMap = board.compatByKnife || {};
      var verdict = compatMap[knife.id] || 'good';
      var vInfo = verdictMeta[verdict] || verdictMeta.good || { badge: '', headline: '', advice: '' };
      var lines = [];

      lines.push(ui.copyHeader || 'IsItKitchenSafe — Knife Care & Cutting Board Compatibility Card');
      lines.push('');
      lines.push((ui.copyPairingLabel || 'PAIRING:') + ' ' + knife.name + ' × ' + board.name);
      lines.push((ui.copyVerdictLabel || 'COMPATIBILITY VERDICT:') + ' [' + (vInfo.badge || '') + '] ' + (vInfo.headline || ''));
      lines.push((ui.copyBevelLabel || 'BEVEL & HRC:') + ' ' + knife.bevelLabel + ' | ' + knife.hrc);
      lines.push((ui.copyHoningLabel || 'HONING RULE:') + ' ' + knife.honingBadge + ' — ' + knife.honingRule);
      lines.push((ui.copySharpeningLabel || 'WHETSTONE / SHARPENING:') + ' ' + knife.whetstoneGrit + ' — ' + knife.sharpeningRule);
      lines.push((ui.copyDishwasherLabel || 'DISHWASHER SAFETY:') + ' ' + (ui.knifeLabelPrefix || 'Knife:') + ' ' + knife.dishwasherRule + ' | ' + (ui.boardLabelPrefix || 'Board:') + ' ' + board.dishwasherBadge + ' — ' + board.maintenanceRule);
      lines.push((ui.copySanitationLabel || 'USDA SANITATION & OIL CARE:') + ' ' + board.foodSafetyNote + ' ' + board.oilRule);

      if (safetyRules.length > 0) {
        lines.push('');
        lines.push(ui.copyRulesHeader || '3 CRITICAL KNIFE & BOARD SAFETY RULES:');
        safetyRules.forEach(function (r, idx) {
          lines.push('  ' + String(idx + 1) + '. ' + r.title + ' — ' + r.body);
        });
      }

      return lines.join('\n');
    }

    knifeBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var id = btn.getAttribute('data-kcbm-knife');
        if (id && knifeMap[id]) {
          state.knifeId = id;
          renderSimulator();
        }
      });
    });

    boardBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var id = btn.getAttribute('data-kcbm-board');
        if (id && boardMap[id]) {
          state.boardId = id;
          renderSimulator();
        }
      });
    });

    modeBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var m = btn.getAttribute('data-kcbm-mode');
        if (m) {
          state.mode = m;
          renderHoningPanel();
        }
      });
    });

    catBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var cat = btn.getAttribute('data-kcbm-cat');
        if (cat) {
          state.category = cat;
          applyFilters();
        }
      });
    });

    ratingBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var r = btn.getAttribute('data-kcbm-rating');
        if (r) {
          state.ratingFilter = r;
          applyFilters();
        }
      });
    });

    if (elSearch) {
      elSearch.addEventListener('input', function () {
        state.query = elSearch.value || '';
        applyFilters();
      });
    }

    if (elSearchClear) {
      elSearchClear.addEventListener('click', function () {
        state.query = '';
        if (elSearch) elSearch.value = '';
        applyFilters();
        if (elSearch) elSearch.focus();
      });
    }

    if (elResetBtn) {
      elResetBtn.addEventListener('click', function () {
        state.category = 'all';
        state.ratingFilter = 'all';
        state.query = '';
        if (elSearch) elSearch.value = '';
        applyFilters();
      });
    }

    gridCards.forEach(function (card) {
      card.addEventListener('click', function () {
        var id = card.getAttribute('data-kcbm-grid-board');
        if (id && boardMap[id]) {
          state.boardId = id;
          renderSimulator();
          if (elDashboard && elDashboard.getBoundingClientRect) {
            var rect = elDashboard.getBoundingClientRect();
            if (rect.top < 16 || rect.top > window.innerHeight) {
              elDashboard.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
          }
        }
      });
    });

    if (copyBtn) {
      copyBtn.addEventListener('click', function () {
        var text = buildCopyCard();
        var showCopied = function () {
          if (copyLabel) copyLabel.textContent = ui.copiedBtn || 'Care Card Copied ✓';
          window.setTimeout(function () {
            if (copyLabel) copyLabel.textContent = '📋 ' + (ui.copyBtn || 'Copy Knife & Board Care Card');
          }, 2200);
        };

        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(showCopied).catch(showCopied);
        } else {
          var ta = document.createElement('textarea');
          ta.value = text;
          ta.setAttribute('readonly', '');
          ta.style.position = 'absolute';
          ta.style.left = '-9999px';
          document.body.appendChild(ta);
          ta.select();
          try {
            document.execCommand('copy');
          } catch (_) {
            // ignore
          }
          document.body.removeChild(ta);
          showCopied();
        }
      });
    }

    if (printBtn) {
      printBtn.addEventListener('click', function () {
        window.print();
      });
    }

    renderSimulator();
    applyFilters();
  })();
</script>
