---
import rawData from '../data/knife-care-cutting-board-data.json';
import type { SupportedLanguage } from '../i18n/ui';
import { useTranslatedPath } from '../i18n/utils';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;
const translatePath = useTranslatedPath(lang);

const allergyUrl = translatePath('/tools/food-allergy-cross-contact-checker/');
const dishwasherUrl = translatePath('/tools/dishwasher-detergent-dosage-calculator/');
const symbolUrl = translatePath('/tools/kitchen-symbol-decoder/');
const methodologyUrl = translatePath('/methodology/');
const allToolsUrl = translatePath('/tools/');

type BoardCategoryKey = 'wood' | 'synthetic' | 'composite' | 'unsafe-hard';
type BladeRatingKey = 'gold' | 'great' | 'caution' | 'unsafe';
type VerdictKey = 'perfect' | 'good' | 'dulls-fast' | 'blade-killer';
type HoningStatusKey = 'steel-or-ceramic' | 'ceramic-only' | 'never-rod';
type DishwasherStatusKey = 'never' | 'check-model' | 'yes' | 'never-cut';

interface BannerRule {
  icon: string;
  title: string;
  body: string;
}

interface SafetyBannerData {
  badge: string;
  headline: string;
  subline: string;
  rules: BannerRule[];
}

interface LocalizedKnife {
  id: string;
  icon: string;
  hrc: string;
  bevelAngle: string;
  honingStatus: HoningStatusKey;
  dishwasherSafe: boolean;
  rustRisk: string;
  whetstoneGrit: string;
  shortName: string;
  name: string;
  examples: string;
  bevelLabel: string;
  honingBadge: string;
  honingRule: string;
  sharpeningRule: string;
  pullThroughWarning: string;
  dishwasherRule: string;
  careRule: string;
}

interface LocalizedBoard {
  id: string;
  icon: string;
  category: BoardCategoryKey;
  bladeRating: BladeRatingKey;
  dishwasherStatus: DishwasherStatusKey;
  compatByKnife: Record<string, VerdictKey>;
  shortName: string;
  name: string;
  ratingBadge: string;
  dishwasherBadge: string;
  summary: string;
  bladeEffect: string;
  foodSafetyNote: string;
  maintenanceRule: string;
  oilRule: string;
}

interface VerdictInfo {
  badge: string;
  headline: string;
  advice: string;
}

interface HoningVsSharpeningData {
  honingTitle: string;
  honingSubtitle: string;
  honingSummary: string;
  honingFrequency: string;
  honingTools: string;
  sharpeningTitle: string;
  sharpeningSubtitle: string;
  sharpeningSummary: string;
  sharpeningFrequency: string;
  sharpeningTools: string;
  carbideTitle: string;
  carbideSubtitle: string;
  carbideSummary: string;
  carbideDanger: string;
}

const safetyBanner: SafetyBannerData =
  (rawData.safetyBanner as Record<string, SafetyBannerData>)[lang] ||
  rawData.safetyBanner.en;

const knives: LocalizedKnife[] = rawData.knives.map((k) => {
  const tr = (k.i18n as Record<string, any>)[lang] || k.i18n.en;
  return {
    id: k.id,
    icon: k.icon,
    hrc: k.hrc,
    bevelAngle: k.bevelAngle,
    honingStatus: k.honingStatus as HoningStatusKey,
    dishwasherSafe: Boolean(k.dishwasherSafe),
    rustRisk: k.rustRisk,
    whetstoneGrit: k.whetstoneGrit,
    shortName: tr.shortName,
    name: tr.name,
    examples: tr.examples,
    bevelLabel: tr.bevelLabel,
    honingBadge: tr.honingBadge,
    honingRule: tr.honingRule,
    sharpeningRule: tr.sharpeningRule,
    pullThroughWarning: tr.pullThroughWarning,
    dishwasherRule: tr.dishwasherRule,
    careRule: tr.careRule
  };
});

const boards: LocalizedBoard[] = rawData.boards.map((b) => {
  const tr = (b.i18n as Record<string, any>)[lang] || b.i18n.en;
  return {
    id: b.id,
    icon: b.icon,
    category: b.category as BoardCategoryKey,
    bladeRating: b.bladeRating as BladeRatingKey,
    dishwasherStatus: b.dishwasherStatus as DishwasherStatusKey,
    compatByKnife: b.compatByKnife as Record<string, VerdictKey>,
    shortName: tr.shortName,
    name: tr.name,
    ratingBadge: tr.ratingBadge,
    dishwasherBadge: tr.dishwasherBadge,
    summary: tr.summary,
    bladeEffect: tr.bladeEffect,
    foodSafetyNote: tr.foodSafetyNote,
    maintenanceRule: tr.maintenanceRule,
    oilRule: tr.oilRule
  };
});

const verdictMeta: Record<VerdictKey, VerdictInfo> =
  (rawData.verdictMeta as Record<string, Record<VerdictKey, VerdictInfo>>)[lang] ||
  (rawData.verdictMeta.en as Record<VerdictKey, VerdictInfo>);

const honingData: HoningVsSharpeningData =
  (rawData.honingVsSharpening as Record<string, HoningVsSharpeningData>)[lang] ||
  rawData.honingVsSharpening.en;

const localizedFaqs: Array<{ question: string; answer: string }> =
  (rawData.faqs as Record<string, Array<{ question: string; answer: string }>>)[lang] ||
  rawData.faqs.en;

