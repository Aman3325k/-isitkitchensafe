</div>

<script define:vars={{ data, d }}>
  document.addEventListener('DOMContentLoaded', () => {
    // Select elements
    const retortSelect = document.getElementById('retort-select');
    const canSelect = document.getElementById('can-select');
    const alloySelect = document.getElementById('alloy-select');

    const tempSlider = document.getElementById('temp-slider');
    const legHeightSlider = document.getElementById('leg-height-slider');
    const waterTempSlider = document.getElementById('water-temp-slider');
    const bleederSlider = document.getElementById('bleeder-slider');
    const dwellSlider = document.getElementById('dwell-slider');
    const chainHoursSlider = document.getElementById('chain-hours-slider');

    // Display labels
    const tempVal = document.getElementById('temp-val');
    const legHeightVal = document.getElementById('leg-height-val');
    const waterTempVal = document.getElementById('water-temp-val');
    const bleederVal = document.getElementById('bleeder-val');
    const dwellVal = document.getElementById('dwell-val');
    const chainHoursVal = document.getElementById('chain-hours-val');

    // Outputs
    const outReqHeight = document.getElementById('out-req-height');
    const outSealMargin = document.getElementById('out-seal-margin');
    const outSteamPressure = document.getElementById('out-steam-pressure');
    const outAirFraction = document.getElementById('out-air-fraction');
    const outLethalityFo = document.getElementById('out-lethality-fo');
    const outCanStress = document.getElementById('out-can-stress');

    // Visual Bars
    const reqBar = document.getElementById('req-bar');
    const sealBar = document.getElementById('seal-bar');
    const pressureBar = document.getElementById('pressure-bar');
    const airBar = document.getElementById('air-bar');
    const foBar = document.getElementById('fo-bar');
    const stressBar = document.getElementById('stress-bar');

    // Status Footers
    const reqStatus = document.getElementById('req-status');
    const sealStatus = document.getElementById('seal-status');
    const pressureStatus = document.getElementById('pressure-status');
    const airStatus = document.getElementById('air-status');
    const foStatus = document.getElementById('fo-status');
    const stressStatus = document.getElementById('stress-status');

    // Badges & Details
    const safetyBadge = document.getElementById('safety-badge');
    const safetyBadgeText = document.getElementById('safety-badge-text');
    const hazardDetail = document.getElementById('hazard-detail');
    const mechanismsDetail = document.getElementById('mechanisms-detail');
    const mitigationDetail = document.getElementById('mitigation-detail');

    // Clipboard Copy
    const copyBtn = document.getElementById('copy-report-btn');
    const copyBtnText = document.getElementById('copy-btn-text');

    function recalculate() {
      if (!retortSelect || !canSelect || !alloySelect) return;

      const retort = data.hydrostaticArchitectures.find(r => r.id === retortSelect.value) || data.hydrostaticArchitectures[0];
      const can = data.containerFoodProfiles.find(c => c.id === canSelect.value) || data.containerFoodProfiles[0];
      const alloy = data.chainAlloys.find(a => a.id === alloySelect.value) || data.chainAlloys[0];

      const tempC = parseFloat(tempSlider.value);
      const legHeightM = parseFloat(legHeightSlider.value);
      const waterTempC = parseFloat(waterTempSlider.value);
      const bleederSetting = parseInt(bleederSlider.value, 10);
      const dwellMin = parseFloat(dwellSlider.value);
      const chainHours = parseFloat(chainHoursSlider.value);

      // Text labels
      if (tempVal) {
        const tempF = Math.round(tempC * 9/5 + 32);
        tempVal.textContent = `${tempC.toFixed(1)}°C (${tempF}°F)`;
      }
      if (legHeightVal) {
        const legFt = (legHeightM * 3.28084).toFixed(1);
        legHeightVal.textContent = `${legHeightM.toFixed(1)} m (${legFt} ft)`;
      }
      if (waterTempVal) {
        const waterTempF = Math.round(waterTempC * 9/5 + 32);
        waterTempVal.textContent = `${Math.round(waterTempC)}°C (${waterTempF}°F)`;
      }
      if (bleederVal) {
        const labels = ['0% Closed [Critical]', '15% Scaled/Choked', '50% Restricted', '100% Fully Open'];
        bleederVal.textContent = labels[bleederSetting] || '100% Open';
        bleederVal.className = `font-bold font-mono ${bleederSetting <= 1 ? 'text-red-700' : (bleederSetting === 2 ? 'text-amber-700' : 'text-emerald-700')}`;
      }
      if (dwellVal) dwellVal.textContent = `${Math.round(dwellMin)} min`;
      if (chainHoursVal) chainHoursVal.textContent = `${chainHours.toLocaleString()} hrs`;

      // 1. Saturated Steam Pressure (Antoine Equation for Water 100°C to 140°C)
      // log10(P_mmHg) = A - B / (C + T_C)
      // For water: A = 8.14019, B = 1810.94, C = 244.485 (valid 99-374°C)
      const pMmHg = Math.pow(10, 8.14019 - (1810.94 / (244.485 + tempC)));
      const pAbsKpa = (pMmHg * 101.325) / 760.0;
      const pGaugeKpa = Math.max(0, pAbsKpa - 101.325);
      const pGaugePsig = pGaugeKpa * 0.145038;

      // 2. Liquid Water Density in Hydrostatic Leg (Accounting for thermal expansion)
      // rho(T) approx = 1000 - 0.0178 * |T - 4|^1.7
      const waterDensityKgM3 = 1000 - 0.0178 * Math.pow(Math.abs(waterTempC - 4), 1.7);
      const g = 9.80665;

      // 3. Theoretical Required Hydrostatic Water Column Height:
      // Delta_P = rho * g * H_req  =>  H_req = Delta_P / (rho * g)
      // Delta_P in Pascals: pGaugeKpa * 1000
      const hReqM = (pGaugeKpa * 1000.0) / (waterDensityKgM3 * g);
      const hReqFt = (hReqM * 3.28084).toFixed(1);

      // 4. Net Water Seal Elevation Margin:
      const sealMarginM = legHeightM - hReqM;
      const sealMarginFt = (sealMarginM * 3.28084).toFixed(1);

      // 5. Steam Dome Air Fraction & Temperature Deficit:
      // Bleeder setting 3: 0.05% air
      // Bleeder setting 2: 0.8% air
      // Bleeder setting 1: 3.2% air
      // Bleeder setting 0: 8.5% air
      const airFractions = [0.085, 0.032, 0.008, 0.0005];
      let airFraction = airFractions[bleederSetting] || 0.0005;
      if (retort.id === 'aging_legacy_hydrostatic_cooker_choked_bleeders') {
        airFraction = Math.max(airFraction, 0.042);
      }
      // Temperature deficit due to Dalton's Partial Pressure of Air:
      // P_steam = (1 - airFraction) * P_total
      // Effective steam temp T_eff = T_sat(P_steam)
      const pSteamPartKpa = (1 - airFraction) * pAbsKpa;
      const pSteamPartMmHg = (pSteamPartKpa * 760.0) / 101.325;
      const tEffC = (1810.94 / (8.14019 - Math.log10(pSteamPartMmHg))) - 244.485;
      const deltaTempC = Math.max(0, tempC - tEffC);

      // 6. Thermal Sterilization Lethality (Bigelow Fo calculation)
      // Fo = Dwell_min * 10^((T_eff - 121.11) / z)
      const lethalRate = Math.pow(10, (tEffC - 121.11) / can.zValueC);
      const calculatedFo = Math.round((dwellMin * lethalRate) * 10) / 10;

      // 7. Container Net Differential Pressure & Peaking Hoop Stress:
      // Internal can pressure = vapor pressure at food core temp + heated expanded headspace air
      // Headspace thermal expansion adds approx 8 to 16 psi
      const foodInternalTempC = Math.min(tempC, tEffC - 1.5);
      const canVaporKpa = Math.max(0, (Math.pow(10, 8.14019 - (1810.94 / (244.485 + foodInternalTempC))) * 101.325 / 760.0) - 101.325);
      const headspaceAirPsi = 10.5 * (1 - can.internalHeadspaceFraction);
      const canInternalPsi = (canVaporKpa * 0.145038) + headspaceAirPsi;
      // Retort chamber pressure in psi:
      const chamberPsi = pGaugePsig;
      const netCanStressPsi = Math.max(0, Math.round((canInternalPsi - chamberPsi * 0.45) * 10) / 10);
      const stressMarginPsi = Math.round((can.canPeakingThresholdPsi - netCanStressPsi) * 10) / 10;

      // 8. Conveyor Chain Pitch Elongation:
      // Wear rate per 1,000 hrs * pitch wear factor
      const wearRatePer1000 = 0.18 * alloy.pitchWearFactor;
      const thermalElongationPct = alloy.thermalExpansionCoeff * (tempC - 20) * 100;
      const mechanicalWearPct = (chainHours / 1000.0) * wearRatePer1000;
      const totalPitchElongationPct = Math.round((mechanicalWearPct + thermalElongationPct) * 100) / 100;

      // UPDATE TELEMETRY OUTPUTS
      // Card 1: Required Height
      if (outReqHeight) outReqHeight.textContent = `${hReqM.toFixed(2)} m (${hReqFt} ft)`;
      if (reqBar) {
        const reqPct = Math.min(100, Math.round((hReqM / retort.towerHeightM) * 100));
        reqBar.style.width = `${reqPct}%`;
      }
      if (reqStatus) {
        reqStatus.textContent = `P_steam = ${pGaugeKpa.toFixed(1)} kPa (${pGaugePsig.toFixed(1)} psig)`;
      }

      // Card 2: Seal Head Margin
      if (outSealMargin) {
        const sign = sealMarginM >= 0 ? '+' : '';
        outSealMargin.textContent = `${sign}${sealMarginM.toFixed(2)} m (${sign}${sealMarginFt} ft)`;
        outSealMargin.className = `text-2xl font-black font-mono ${sealMarginM < 0 ? 'text-red-700 animate-pulse' : (sealMarginM < 0.8 ? 'text-amber-700' : 'text-emerald-700')}`;
      }
      if (sealBar) {
        const sealPct = Math.max(0, Math.min(100, Math.round(((sealMarginM + 3) / 8) * 100)));
        sealBar.style.width = `${sealPct}%`;
        sealBar.className = `h-2 rounded-full transition-all duration-300 ${sealMarginM < 0 ? 'bg-red-600' : (sealMarginM < 0.8 ? 'bg-amber-500' : 'bg-emerald-600')}`;
      }
      if (sealStatus) {
        if (sealMarginM < 0) {
          sealStatus.textContent = '🚨 STEAM BLOWOUT GEYSER HAZARD!';
          sealStatus.className = 'text-[11px] font-bold text-red-600';
        } else if (sealMarginM < 0.8) {
          sealStatus.textContent = 'Marginal Head (Min 1.2m Required)';
          sealStatus.className = 'text-[11px] font-medium text-amber-600';
        } else {
          sealStatus.textContent = 'Safe Barometric Head Reserve';
          sealStatus.className = 'text-[11px] text-muted';
        }
      }

      // Card 3: Steam Pressure
      if (outSteamPressure) {
        outSteamPressure.textContent = `${pGaugeKpa.toFixed(1)} kPa (${pGaugePsig.toFixed(1)} psig)`;
      }
      if (pressureBar) {
        const pressPct = Math.min(100, Math.round((pGaugeKpa / retort.maxOperatingSteamKpa) * 100));
        pressureBar.style.width = `${pressPct}%`;
        pressureBar.className = `h-2 rounded-full transition-all duration-300 ${pGaugeKpa > retort.maxOperatingSteamKpa ? 'bg-red-600' : 'bg-blue-600'}`;
      }
      if (pressureStatus) {
        pressureStatus.textContent = `Design MAWP: ${retort.maxOperatingSteamKpa} kPa gauge`;
      }

      // Card 4: Non-Condensable Air Fraction
      if (outAirFraction) {
        outAirFraction.textContent = `${(airFraction * 100).toFixed(2)}% (ΔT: -${deltaTempC.toFixed(1)}°C)`;
        outAirFraction.className = `text-2xl font-black font-mono ${airFraction > 0.02 ? 'text-red-700' : (airFraction > 0.005 ? 'text-amber-700' : 'text-emerald-700')}`;
      }
      if (airBar) {
        const airPct = Math.min(100, Math.round((airFraction / 0.08) * 100));
        airBar.style.width = `${airPct}%`;
        airBar.className = `h-2 rounded-full transition-all duration-300 ${airFraction > 0.02 ? 'bg-red-600' : (airFraction > 0.005 ? 'bg-amber-500' : 'bg-emerald-600')}`;
      }
      if (airStatus) {
        airStatus.textContent = airFraction > 0.02 ? 'Cold Spot Air Pockets Forming' : 'Pure Saturated Steam Atmosphere';
      }

      // Card 5: Thermal Lethality Fo
      if (outLethalityFo) {
        outLethalityFo.textContent = `${calculatedFo.toFixed(1)} min`;
        outLethalityFo.className = `text-2xl font-black font-mono ${calculatedFo < 3.0 ? 'text-red-700 animate-pulse' : (calculatedFo < can.targetFoMinutes ? 'text-amber-700' : 'text-emerald-700')}`;
      }
      if (foBar) {
        const foPct = Math.min(100, Math.round((calculatedFo / (can.targetFoMinutes * 1.5)) * 100));
        foBar.style.width = `${foPct}%`;
        foBar.className = `h-2 rounded-full transition-all duration-300 ${calculatedFo < 3.0 ? 'bg-red-600' : (calculatedFo < can.targetFoMinutes ? 'bg-amber-500' : 'bg-emerald-600')}`;
      }
      if (foStatus) {
        if (calculatedFo < 3.0) {
          foStatus.textContent = 'UNDER-PROCESSING VIOLATION (Fo < 3.0m)';
          foStatus.className = 'text-[11px] font-bold text-red-600';
        } else if (calculatedFo < can.targetFoMinutes) {
          foStatus.textContent = `Commercial Target: Fo >= ${can.targetFoMinutes} min`;
          foStatus.className = 'text-[11px] text-amber-600';
        } else {
          foStatus.textContent = `12D Botulinum Sterilization Exceeded`;
          foStatus.className = 'text-[11px] text-muted';
        }
      }

      // Card 6: Can Differential Stress
      if (outCanStress) {
        outCanStress.textContent = `${netCanStressPsi.toFixed(1)} psi (Margin: ${stressMarginPsi >= 0 ? '+' : ''}${stressMarginPsi.toFixed(1)} psi)`;
        outCanStress.className = `text-2xl font-black font-mono ${stressMarginPsi < 0 ? 'text-red-700' : (stressMarginPsi < 5.0 ? 'text-amber-700' : 'text-emerald-700')}`;
      }
      if (stressBar) {
        const stressPct = Math.min(100, Math.round((netCanStressPsi / can.canPeakingThresholdPsi) * 100));
        stressBar.style.width = `${stressPct}%`;
        stressBar.className = `h-2 rounded-full transition-all duration-300 ${stressMarginPsi < 0 ? 'bg-red-600' : (stressMarginPsi < 5.0 ? 'bg-amber-500' : 'bg-emerald-600')}`;
      }
      if (stressStatus) {
        if (stressMarginPsi < 0) {
          stressStatus.textContent = 'CAN PEAKING / BURST HAZARD!';
          stressStatus.className = 'text-[11px] font-bold text-red-600';
        } else {
          stressStatus.textContent = `Peaking Limit: ${can.canPeakingThresholdPsi} psi`;
          stressStatus.className = 'text-[11px] text-muted';
        }
      }

      // SAFETY BADGE & TRIAGE CALLOUTS
      if (sealMarginM < 0) {
        safetyBadge.className = 'self-start sm:self-auto inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-red-100 text-red-800 border border-red-300 animate-pulse';
        safetyBadgeText.textContent = 'CRITICAL: STEAM BLOWOUT / SCALD HAZARD';
        if (hazardDetail) hazardDetail.textContent = 'Hydrostatic water column head is insufficient to balance chamber steam pressure. Steam is blowing past the bottom seal, causing violent geysering of scalding water onto plant floors.';
        if (mechanismsDetail) mechanismsDetail.textContent = `Required head is ${hReqM.toFixed(2)}m, but actual leg is only ${legHeightM.toFixed(1)}m. Negative pressure differential (-${Math.abs(sealMarginM).toFixed(2)}m) creates steam discharge velocities exceeding 45 m/s.`;
        if (mitigationDetail) mitigationDetail.textContent = 'Emergency trip: Modulate boiler steam supply valve closed immediately. Restore infeed water makeup pumps to elevate barometric seal height above 12.0 meters.';
      } else if (calculatedFo < 3.0) {
        safetyBadge.className = 'self-start sm:self-auto inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-red-100 text-red-800 border border-red-300';
        safetyBadgeText.textContent = 'CRITICAL: BOTULINUM UNDER-PROCESSING (Fo < 3.0m)';
        if (hazardDetail) hazardDetail.textContent = 'Sterilization lethality fails mandatory FDA 21 CFR § 113.40 12D commercial sterility standard. C. botulinum proteolytic endospores survive, risking deadly botulinum toxin neurotoxicity.';
        if (mechanismsDetail) mechanismsDetail.textContent = `Trapped non-condensable air (${(airFraction * 100).toFixed(1)}%) depresses effective steam temperature by -${deltaTempC.toFixed(1)}°C, collapsing logarithmic lethality rate from 1.0 to ${lethalRate.toFixed(3)}.`;
        if (mitigationDetail) mitigationDetail.textContent = 'Open continuous 1/4" steam bleeders fully. Re-evaluate dwell timer and quarantine all processed lot pallets for thermal death time (TDT) spoilage evaluation.';
      } else if (stressMarginPsi < 0) {
        safetyBadge.className = 'self-start sm:self-auto inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-100 text-amber-800 border border-amber-300';
        safetyBadgeText.textContent = 'WARNING: CONTAINER PEAKING / SEAM LEAKAGE';
        if (hazardDetail) hazardDetail.textContent = `Internal container hoop stress (${netCanStressPsi.toFixed(1)} psi) exceeds double-seam peaking threshold (${can.canPeakingThresholdPsi} psi), causing permanent end-plate deformation and micro-leakage.`;
        if (mechanismsDetail) mechanismsDetail.textContent = 'Excessive internal vapor pressure from unvented headspace expansion overcomes external counter-pressure as cans exit the steam dome into the cooling leg.';
        if (mitigationDetail) mitigationDetail.textContent = 'Increase compressed air overpressure in the transition cooling leg or decrease initial filling temperature headspace volume.';
      } else if (totalPitchElongationPct > 1.5) {
        safetyBadge.className = 'self-start sm:self-auto inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-100 text-amber-800 border border-amber-300';
        safetyBadgeText.textContent = 'WARNING: CHAIN PITCH ELONGATION EXCEEDED (1.5%)';
        if (hazardDetail) hazardDetail.textContent = `Conveyor chain cumulative pitch elongation (${totalPitchElongationPct.toFixed(2)}%) exceeds ISO 1977 maximum limit. Risk of drive sprocket tooth climb and catastrophic carrier jam.`;
        if (mechanismsDetail) mechanismsDetail.textContent = `High service hours (${chainHours.toLocaleString()} hrs) under corrosive steam condensate has accelerated pin bushing abrasive-adhesive wear.`;
        if (mitigationDetail) mitigationDetail.textContent = 'Schedule immediate carrier chain section replacement. Upgrade to AISI 316L or nickel-plated case-hardened alloy links with automatic oil-mist lubrication.';
      } else {
        safetyBadge.className = 'self-start sm:self-auto inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800 border border-emerald-300';
        safetyBadgeText.textContent = '100% FDA 21 CFR 113 COMPLIANT';
        if (hazardDetail) hazardDetail.textContent = 'Hydrostatic column head provides positive counter-pressure seal. Saturated steam purity exceeds 99.9%, eliminating cold spot risks and securing commercial sterility.';
        if (mechanismsDetail) mechanismsDetail.textContent = `Hydrostatic equilibrium ΔP = ρ·g·H balances ${pGaugeKpa.toFixed(1)} kPa steam pressure against ${legHeightM.toFixed(1)}m water column at ${waterTempC}°C (density ${Math.round(waterDensityKgM3)} kg/m³). Net safety head is +${sealMarginM.toFixed(2)}m.`;
        if (mitigationDetail) mitigationDetail.textContent = 'Maintain continuous 1/4" bleeders open to atmosphere. Verify water seal level ultrasonic transmitters quarterly per 21 CFR § 113.40.';
      }
    }

    // Attach Event Listeners
    [retortSelect, canSelect, alloySelect].forEach(sel => {
      sel?.addEventListener('change', recalculate);
    });

    [tempSlider, legHeightSlider, waterTempSlider, bleederSlider, dwellSlider, chainHoursSlider].forEach(sld => {
      sld?.addEventListener('input', recalculate);
    });

    // Presets Click Handlers
    document.getElementById('preset-soup')?.addEventListener('click', () => {
      retortSelect.value = 'industrial_high_capacity_quad_leg_hydrostatic_retort';
      canSelect.value = 'tinplate_soup_can_300x407';
      alloySelect.value = 'aisi_316l_stainless_steel';
      tempSlider.value = '121.1';
      legHeightSlider.value = '12.2';
      waterTempSlider.value = '85';
      bleederSlider.value = '3';
      dwellSlider.value = '32';
      chainHoursSlider.value = '1800';
      recalculate();
    });

    document.getElementById('preset-aluminum')?.addEventListener('click', () => {
      retortSelect.value = 'medium_tower_dual_leg_hydrostatic_cooker_cooler';
      canSelect.value = 'lightweight_aluminum_beverage_can_202x504';
      alloySelect.value = 'aisi_316l_stainless_steel';
      tempSlider.value = '121.1';
      legHeightSlider.value = '11.8';
      waterTempSlider.value = '80';
      bleederSlider.value = '3';
      dwellSlider.value = '22';
      chainHoursSlider.value = '1200';
      recalculate();
    });

    document.getElementById('preset-air-pocket')?.addEventListener('click', () => {
      retortSelect.value = 'aging_legacy_hydrostatic_cooker_choked_bleeders';
      canSelect.value = 'tinplate_soup_can_300x407';
      alloySelect.value = 'standard_carbon_steel_worn';
      tempSlider.value = '121.1';
      legHeightSlider.value = '11.0';
      waterTempSlider.value = '90';
      bleederSlider.value = '1';
      dwellSlider.value = '25';
      chainHoursSlider.value = '6500';
      recalculate();
    });

    document.getElementById('preset-blowout')?.addEventListener('click', () => {
      retortSelect.value = 'industrial_high_capacity_quad_leg_hydrostatic_retort';
      canSelect.value = 'tinplate_soup_can_300x407';
      alloySelect.value = 'aisi_316l_stainless_steel';
      tempSlider.value = '125.0';
      legHeightSlider.value = '9.0';
      waterTempSlider.value = '95';
      bleederSlider.value = '3';
      dwellSlider.value = '28';
      chainHoursSlider.value = '3200';
      recalculate();
    });

    // Copy to Clipboard
    copyBtn?.addEventListener('click', () => {
      const report = `=== ISITKITCHENSAFE HYDROSTATIC RETORT COOKER-COOLER TELEMETRY ===
Timestamp: ${new Date().toISOString()}
Retort: ${retortSelect.options[retortSelect.selectedIndex]?.text}
Container: ${canSelect.options[canSelect.selectedIndex]?.text}
Conveyor Chain Alloy: ${alloySelect.options[alloySelect.selectedIndex]?.text}
Saturated Steam Temp: ${tempSlider.value}°C
Hydrostatic Water Leg Height: ${legHeightSlider.value} m
Water Column Temperature: ${waterTempSlider.value}°C
Bleeder Status: ${bleederSlider.value} / 3
Sterilizing Dwell Time: ${dwellSlider.value} min
Chain Operating Hours: ${chainHoursSlider.value} hrs
------------------------------------------------------------------
Required Water Head: ${outReqHeight?.textContent}
Seal Elevation Margin: ${outSealMargin?.textContent}
Steam Chamber Pressure: ${outSteamPressure?.textContent}
Non-Condensable Air: ${outAirFraction?.textContent}
Sterilization Lethality (Fo): ${outLethalityFo?.textContent}
Container Net Hoop Stress: ${outCanStress?.textContent}
Compliance Status: ${safetyBadgeText?.textContent}
Primary Hazard: ${hazardDetail?.textContent}
Fluid Mechanisms: ${mechanismsDetail?.textContent}
Engineering Controls: ${mitigationDetail?.textContent}
Standards: FDA 21 CFR § 113.40 | ASME BPVC Section VIII | NFPA 86`;

      navigator.clipboard.writeText(report).then(() => {
        const originalText = copyBtnText?.textContent;
        if (copyBtnText) copyBtnText.textContent = d.copiedFeedback;
        setTimeout(() => {
          if (copyBtnText) copyBtnText.textContent = originalText;
        }, 2500);
      });
    });

    // Initial run
    recalculate();
  });
</script>
