const d = DICTIONARY[lang] || DICTIONARY.en;
const data = hydrostaticData;
---

<div class="bg-surface-soft border border-hairline rounded-3xl p-6 sm:p-8 md:p-10 shadow-sm max-w-5xl mx-auto my-8 font-sans">
  <!-- Header Banner -->
  <div class="mb-8 border-b border-hairline/80 pb-6">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold tracking-wide uppercase bg-blue-700/10 text-blue-900 mb-3 border border-blue-700/20">
      <span class="w-2 h-2 rounded-full bg-blue-600 animate-pulse"></span>
      {d.badge}
    </div>
    <h2 class="text-display-xs sm:text-display-sm font-bold text-ink tracking-tight mb-2">
      {d.title}
    </h2>
    <p class="text-body text-sm sm:text-base text-muted max-w-4xl leading-relaxed">
      {d.subtitle}
    </p>
  </div>

  <!-- Operational Presets -->
  <div class="mb-8 bg-surface rounded-2xl p-4 sm:p-5 border border-hairline">
    <div class="text-xs font-bold uppercase tracking-wider text-muted mb-3 flex items-center gap-2">
      <svg class="w-4 h-4 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
      </svg>
      {d.presetsTitle}
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
      <button 
        type="button" 
        id="preset-soup"
        class="text-left text-xs p-3 rounded-xl border border-hairline bg-surface-soft hover:bg-surface hover:border-blue-700/50 transition-all font-medium text-ink flex items-center justify-between group cursor-pointer"
      >
        <span>{d.presetSoup}</span>
        <span class="text-blue-700 opacity-0 group-hover:opacity-100 transition-opacity ml-2">&rarr;</span>
      </button>
      <button 
        type="button" 
        id="preset-aluminum"
        class="text-left text-xs p-3 rounded-xl border border-hairline bg-surface-soft hover:bg-surface hover:border-blue-700/50 transition-all font-medium text-ink flex items-center justify-between group cursor-pointer"
      >
        <span>{d.presetAluminum}</span>
        <span class="text-blue-700 opacity-0 group-hover:opacity-100 transition-opacity ml-2">&rarr;</span>
      </button>
      <button 
        type="button" 
        id="preset-air-pocket"
        class="text-left text-xs p-3 rounded-xl border border-hairline bg-surface-soft hover:bg-surface hover:border-amber-700/50 transition-all font-medium text-ink flex items-center justify-between group cursor-pointer"
      >
        <span>{d.presetAirPocket}</span>
        <span class="text-amber-700 opacity-0 group-hover:opacity-100 transition-opacity ml-2">&rarr;</span>
      </button>
      <button 
        type="button" 
        id="preset-blowout"
        class="text-left text-xs p-3 rounded-xl border border-hairline bg-surface-soft hover:bg-surface hover:border-red-700/50 transition-all font-medium text-ink flex items-center justify-between group cursor-pointer"
      >
        <span>{d.presetBlowout}</span>
        <span class="text-red-700 opacity-0 group-hover:opacity-100 transition-opacity ml-2">&rarr;</span>
      </button>
    </div>
  </div>

  <!-- Interactive Controls Section -->
  <div class="space-y-6 mb-8">
    <div class="border-b border-hairline/60 pb-2">
      <h3 class="text-title-sm sm:text-title font-semibold text-ink tracking-tight">
        {d.controlsTitle}
      </h3>
      <p class="text-xs text-muted">
        {d.controlsSub}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      <!-- Retort Architecture Selection -->
      <div>
        <label for="retort-select" class="block text-xs font-semibold text-ink mb-1.5">
          {d.retortLabel}
        </label>
        <select 
          id="retort-select"
          class="w-full text-xs font-medium rounded-xl border border-hairline bg-surface px-3 py-2.5 text-ink focus:outline-hidden focus:ring-2 focus:ring-blue-600 transition-all cursor-pointer"
        >
          {data.hydrostaticArchitectures.map(retort => (
            <option value={retort.id}>{retort.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1 leading-snug">
          {d.retortHelp}
        </p>
      </div>

      <!-- Container Selection -->
      <div>
        <label for="can-select" class="block text-xs font-semibold text-ink mb-1.5">
          {d.canLabel}
        </label>
        <select 
          id="can-select"
