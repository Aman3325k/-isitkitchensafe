<script>
  // Client-side Interactive Simulation Logic for MAI-SBR Modeler
  document.addEventListener('DOMContentLoaded', () => {
    const systemSelect = document.getElementById('mai-system-select') as HTMLSelectElement | null;
    const feedSelect = document.getElementById('mai-feed-select') as HTMLSelectElement | null;
    const mwSelect = document.getElementById('mai-mw-select') as HTMLSelectElement | null;
    const indSelect = document.getElementById('mai-ind-select') as HTMLSelectElement | null;

    const tempSlider = document.getElementById('mai-temp-slider') as HTMLInputElement | null;
    const mwPowerSlider = document.getElementById('mai-mw-power-slider') as HTMLInputElement | null;
    const indPowerSlider = document.getElementById('mai-ind-power-slider') as HTMLInputElement | null;
    const airSlider = document.getElementById('mai-air-slider') as HTMLInputElement | null;
    const feedSlider = document.getElementById('mai-feed-slider') as HTMLInputElement | null;

    const tempVal = document.getElementById('mai-temp-val');
    const mwPowerVal = document.getElementById('mai-mw-power-val');
    const indPowerVal = document.getElementById('mai-ind-power-val');
    const airVal = document.getElementById('mai-air-val');
    const feedVal = document.getElementById('mai-feed-val');

    const secMetric = document.getElementById('mai-sec-metric');
    const energySavingMetric = document.getElementById('mai-energy-saving-metric');
    const uniformityMetric = document.getElementById('mai-uniformity-metric');
    const mycotoxinMetric = document.getElementById('mai-mycotoxin-metric');
    const pathogenMetric = document.getElementById('mai-pathogen-metric');
    const scorchMetric = document.getElementById('mai-scorch-metric');
    const moistureMetric = document.getElementById('mai-moisture-metric');
    const complianceMetric = document.getElementById('mai-compliance-metric');
    const safetyBadge = document.getElementById('mai-safety-badge');
    const hazardBanner = document.getElementById('mai-hazard-banner');

    function updateSimulation() {
      if (!tempSlider || !mwPowerSlider || !indPowerSlider || !airSlider || !feedSlider) return;

      const temp = parseFloat(tempSlider.value);
      const mwPower = parseFloat(mwPowerSlider.value);
      const indPower = parseFloat(indPowerSlider.value);
      const airVelocity = parseFloat(airSlider.value);
      const feedRate = parseFloat(feedSlider.value);

      if (tempVal) tempVal.innerHTML = `${temp.toFixed(1)} &deg;C`;
      if (mwPowerVal) mwPowerVal.innerText = `${mwPower.toFixed(1)} kW`;
      if (indPowerVal) indPowerVal.innerText = `${indPower.toFixed(1)} kW`;
      if (airVal) airVal.innerText = `${airVelocity.toFixed(2)} m/s`;
      if (feedVal) feedVal.innerText = `${Math.round(feedRate).toLocaleString()} kg/h`;

      const isMwHazard = mwSelect?.value === 'unshielded_direct_radiation_hazard';
      const isIndHazard = indSelect?.value === 'conventional_gas_flame_hot_spot_hazard';
      const isSevereHazard = isMwHazard || isIndHazard;

      if (isSevereHazard) {
        if (hazardBanner) hazardBanner.classList.remove('hidden');
        if (safetyBadge) {
          safetyBadge.className = 'px-3.5 py-1.5 rounded-full text-xs font-bold tracking-wide bg-rose-950 text-rose-300 border border-rose-800 animate-pulse';
          safetyBadge.innerText = 'NON-COMPLIANT / SEVERE HAZARD';
        }
        if (complianceMetric) {
          complianceMetric.className = 'text-xs font-bold font-mono text-rose-400';
          complianceMetric.innerText = 'FAIL (RF RADIATION / GAS HOT-SPOT VIOLATION)';
        }
        if (secMetric) secMetric.innerText = isIndHazard ? '0.68 kWh/kg' : '0.52 kWh/kg';
        if (energySavingMetric) energySavingMetric.innerText = '0.0%';
        if (uniformityMetric) uniformityMetric.innerText = '&plusmn;38.5 \u00B0C';
        if (mycotoxinMetric) mycotoxinMetric.innerText = '32.0%';
        if (pathogenMetric) pathogenMetric.innerText = '2.4 Log';
        if (scorchMetric) scorchMetric.innerText = isIndHazard ? '5.80%' : '3.40%';
        if (moistureMetric) moistureMetric.innerText = '4.8% (Uneven Moisture)';
        return;
      }

      if (hazardBanner) hazardBanner.classList.add('hidden');

      // Authentic physics calculation:
      // Minimum spouting velocity check (approx 1.8 m/s for coffee/nuts)
      const isSpoutingOptimal = airVelocity >= 1.6;
      const totalPowerKw = mwPower + indPower;
      const sec = Math.max(0.18, Math.min(0.48, (totalPowerKw / (feedRate || 1)) * 3.6));
      const energySaving = Math.max(35.0, Math.min(68.0, ((0.68 - sec) / 0.68) * 100));

      // Thermal radial parity depends on microwave proportion:
      const mwRatio = mwPower / totalPowerKw;
      const uniformityDelta = Math.max(0.6, 3.8 - (mwRatio * 3.2) - (isSpoutingOptimal ? 0.4 : -1.2));

      // Mycotoxin reduction based on temperature and microwave field:
      const tempFactor = (temp - 100) / 90; // 0 to 1
      const mycotoxinRed = Math.min(98.5, Math.max(78.0, 75.0 + (tempFactor * 18.0) + (mwRatio * 6.5)));

      // Pathogen lethality:
      const lethalityLog = Math.min(7.8, Math.max(4.5, 4.0 + (tempFactor * 3.2) + (mwRatio * 0.8)));

      // Scorched spot defect:
      const scorch = isSpoutingOptimal ? Math.max(0.01, 0.08 - (mwRatio * 0.06)) : 0.85;

      // Residual moisture:
      const resMoisture = Math.max(1.1, 4.5 - (tempFactor * 2.8) - (mwRatio * 0.6));

      if (safetyBadge) {
        safetyBadge.className = 'px-3.5 py-1.5 rounded-full text-xs font-bold tracking-wide bg-emerald-950 text-emerald-300 border border-emerald-800';
        safetyBadge.innerText = 'OPTIMAL / FULL PARITY';
      }
      if (complianceMetric) {
        complianceMetric.className = 'text-xs font-bold font-mono text-emerald-400';
        complianceMetric.innerText = 'PASS \u2022 ASME BPVC VIII \u2022 FCC Part 18 \u2022 3-A 73-01 \u2022 NFPA 652';
      }

      if (secMetric) secMetric.innerText = `${sec.toFixed(2)} kWh/kg`;
      if (energySavingMetric) energySavingMetric.innerText = `${energySaving.toFixed(1)}%`;
      if (uniformityMetric) uniformityMetric.innerText = `\u00B1${uniformityDelta.toFixed(1)} \u00B0C`;
      if (mycotoxinMetric) mycotoxinMetric.innerText = `${mycotoxinRed.toFixed(1)}%`;
      if (pathogenMetric) pathogenMetric.innerText = `${lethalityLog.toFixed(1)} Log`;
      if (scorchMetric) scorchMetric.innerText = `${scorch.toFixed(2)}%`;
      if (moistureMetric) moistureMetric.innerText = `${resMoisture.toFixed(1)}% Moisture`;
    }

    // Attach listeners
    [tempSlider, mwPowerSlider, indPowerSlider, airSlider, feedSlider].forEach(slider => {
      slider?.addEventListener('input', updateSimulation);
    });

    [systemSelect, feedSelect, mwSelect, indSelect].forEach(select => {
      select?.addEventListener('change', updateSimulation);
    });

    // Preset handlers
    document.getElementById('mai-preset-coffee')?.addEventListener('click', () => {
      if (tempSlider) tempSlider.value = '155.0';
      if (mwPowerSlider) mwPowerSlider.value = '28.0';
      if (indPowerSlider) indPowerSlider.value = '32.0';
      if (airSlider) airSlider.value = '2.20';
      if (feedSlider) feedSlider.value = '1200.0';
      if (feedSelect) feedSelect.value = 'green_arabica_coffee_beans';
      if (mwSelect) mwSelect.value = 'solid_state_245ghz_waveguide';
      if (indSelect) indSelect.value = 'high_frequency_magnetic_flux_induction';
      updateSimulation();
    });

    document.getElementById('mai-preset-cacao')?.addEventListener('click', () => {
      if (tempSlider) tempSlider.value = '132.0';
      if (mwPowerSlider) mwPowerSlider.value = '18.0';
      if (indPowerSlider) indPowerSlider.value = '24.0';
      if (airSlider) airSlider.value = '2.40';
      if (feedSlider) feedSlider.value = '800.0';
      if (feedSelect) feedSelect.value = 'fermented_trinitario_cacao_beans';
      if (mwSelect) mwSelect.value = 'solid_state_245ghz_waveguide';
      if (indSelect) indSelect.value = 'high_frequency_magnetic_flux_induction';
      updateSimulation();
    });

    document.getElementById('mai-preset-almonds')?.addEventListener('click', () => {
      if (tempSlider) tempSlider.value = '145.0';
      if (mwPowerSlider) mwPowerSlider.value = '35.0';
      if (indPowerSlider) indPowerSlider.value = '38.0';
      if (airSlider) airSlider.value = '2.60';
      if (feedSlider) feedSlider.value = '1500.0';
      if (feedSelect) feedSelect.value = 'whole_shelled_raw_almonds';
      if (mwSelect) mwSelect.value = 'solid_state_245ghz_waveguide';
      if (indSelect) indSelect.value = 'high_frequency_magnetic_flux_induction';
      updateSimulation();
    });

    document.getElementById('mai-preset-sesame')?.addEventListener('click', () => {
      if (tempSlider) tempSlider.value = '160.0';
      if (mwPowerSlider) mwPowerSlider.value = '15.0';
      if (indPowerSlider) indPowerSlider.value = '22.0';
      if (airSlider) airSlider.value = '1.40';
      if (feedSlider) feedSlider.value = '650.0';
      if (feedSelect) feedSelect.value = 'organic_sesame_seeds';
      if (mwSelect) mwSelect.value = 'solid_state_245ghz_waveguide';
      if (indSelect) indSelect.value = 'high_frequency_magnetic_flux_induction';
      updateSimulation();
    });

    document.getElementById('mai-preset-hazard')?.addEventListener('click', () => {
      if (tempSlider) tempSlider.value = '185.0';
      if (mwPowerSlider) mwPowerSlider.value = '10.0';
      if (indPowerSlider) indPowerSlider.value = '10.0';
      if (airSlider) airSlider.value = '1.10';
      if (mwSelect) mwSelect.value = 'unshielded_direct_radiation_hazard';
      if (indSelect) indSelect.value = 'conventional_gas_flame_hot_spot_hazard';
      updateSimulation();
    });

    // Initial calculation
    updateSimulation();
  });
</script>
