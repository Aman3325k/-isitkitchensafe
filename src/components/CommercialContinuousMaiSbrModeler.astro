    subtitle: "ASME Section VIII Div 1 & 2、FCC Part 18 ISM、3-A 衛生規格 73-01、NFPA 652 基準に準拠。豆類・ナッツ・穀物向けに、2.45 GHz マイクロ波体積加熱と高周波磁束誘導加熱をハイブリッド統合した連続式噴流層プロセス（120–185°C）をシミュレート。内外温度差ゼロ、焦げ斑点不良ゼロ、92％以上のマイコトキシン熱分解を実現。",
    controlsTitle: "MAI-SBR 噴流層焙煎操作パネル",
    controlsSub: "噴流層操作温度、マイクロ波導波管パワー、壁面高周波誘導磁束加熱、噴流ノズル空塔空気流速、連続原料供給流量を設定します。",
    systemLabel: "噴流層焙煎機システム構造:",
    systemHelp: "商用連続式 MAI-SBR スキッド、スペシャルティコーヒー＆カカオ高精度焙煎機、大口径穀物連続殺菌機、研究用モジュール機から選択。",
    matrixLabel: "農産物原料＆食品マトリックス:",
    matrixHelp: "高品質生アラビカコーヒー豆、発酵トリニタリオカカオ豆、カリフォルニア産生アーモンド、有機天然白ごま、皮なし大麦全粒から選択。",
    microwaveLabel: "マイクロ波共振器＆RF導波管ステージ:",
    microwaveHelp: "2.45 GHz 半導体アジャイル導波管、工業用 915 MHz 深部浸透空洞、パルス共振空洞、未シールド電波漏洩危険モードから選択。",
    inductionLabel: "壁面電磁誘導加熱コイル構成:",
    inductionHelp: "高周波磁束誘導コイル（25〜40 kHz）、中周波同心ジャケット（10〜20 kHz）、局所過熱を伴う危険な従来ガスバーナーから選択。",
    tempLabel: "噴流層操作平衡温度 (T_bed):",
    tempHelp: "粒子層の熱平衡中心温度（100.0〜190.0 °C）。メイラード反応、香気成分生成、マイコトキシン熱分解を支配します。",
    mwPowerLabel: "マイクロ波体積加熱出力 (P_mw):",
    mwPowerHelp: "石英窓から内部水分に直接カップリングするマイクロ波パワー（5.0〜60.0 kW）。内外同時の均一加熱を実現。",
    indPowerLabel: "壁面誘導加熱出力 (P_ind):",
    indPowerHelp: "コーン壁面に渦電流を発生させる高周波誘導電力（5.0〜70.0 kW）。周囲からの効率的な対流伝熱を供給。",
    airVelocityLabel: "噴流ノズル空塔空気流速 (u_spout):",
    airVelocityHelp: "底部ノズルから噴射される流動空気の流速（1.0〜4.0 m/s）。最小噴流化速度（u_ms）を超えて噴泉循環を維持。",
    feedRateLabel: "連続原料供給流量 (Q_feed):",
    feedRateHelp: "連続噴流層チャンバー内へ供給される穀物・ナッツの質量流量（100〜3,500 kg/h）。",
    presetsTitle: "工業用 MAI-SBR クイック運転プリセット:",
    presetCoffee: "スペシャルティ生アラビカコーヒー豆焙煎（155°C、焦げ付きゼロ、オクラトキシンA 94％分解）",
    presetCacao: "発酵トリニタリオカカオ豆アロマ生成（132°C、外皮割れ防止、メイラードピラジン香気）",
    presetAlmonds: "カリフォルニア生アーモンド殺菌脱毒（145°C、サルモネラ菌 6.5-Log 殺菌実証）",
    presetSesame: "有機ごま＆キヌア高速渦流トースト（160°C、85秒超短時間保持、焦げ苦味ゼロ）",
    presetHazard: "従来型直火式回転ドラム焙煎機（激しい局所接触熱、焦げ率5.2％、一酸化炭素排出リスク）",
    diagnosticTitle: "リアルタイム MAI-SBR 焙煎熱力学速度論＆空気力学テレメトリー",
    diagnosticSub: "比消費電力量（SEC）、内外温度差（ΔT）、マイコトキシン分解率、病原菌死滅対数、ASME/FCC 適合性をリアルタイム解析。",
    secLabel: "単位処理あたり比消費電力量 (SEC):",
    energySavingLabel: "従来のガスドラム焙煎機に対する省エネ率:",
    uniformityLabel: "粒子中心-表面径方向温度差 (ΔT):",
    mycotoxinLabel: "マイコトキシン（オクラトキシンA・アフラトキシン）分解率:",
    pathogenLabel: "病原菌・真菌耐熱胞子不活性化率 (Log10):",
    scorchDefectLabel: "豆表面焦げ斑点・端部焦げ不良率:",
    residualMoistureLabel: "焙煎仕上がり最終残留水分値:",
    statusLabel: "ASME BPVC VIII / FCC Part 18 / 3-A 73-01 準拠状態:",
    diagramTitle: "マイクロ波アシスト誘導加熱噴流層プロセス系統図",
    diagramSub: "倒円錐噴流チャンバー、高速噴流ノズル、噴泉循環粒子流、2.45 GHz 導波管、水冷誘導コイル、サイクロン捕集器。",
    scienceTitle: "電磁流動化理論＆噴流層伝熱生体物理学",
    scienceSub: "Mathur-Gishler の最小噴流化速度式、マイクロ波誘電損失による内部発熱散逸、高周波表皮効果伝熱、非加熱電穿孔相乗殺菌機構。",
    tableTitle: "技術比較マトリックス：MAI-SBR 対 従来型ガスドラム・標準流動層・遠赤外線トンネル焙煎"
  }
};

const d = DICT[lang] || DICT.en;
const systems = maiSbrData.systemArchitectures;
const feeds = maiSbrData.feedMatrices;
const microwaves = maiSbrData.microwaveCavityConditions;
const inductions = maiSbrData.inductionHeatingStages;
---

<div class="my-10 p-6 md:p-8 bg-surface border border-hairline rounded-3xl shadow-xs">
  <!-- Header Badge & Title -->
  <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
    <span class="inline-block px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-orange-950 text-orange-300 border border-orange-800">
      {d.badge}
    </span>
    <span class="text-xs text-muted font-mono">
      MAI-SBR &bull; 2.45 GHz &bull; 120&ndash;185&deg;C &bull; ASME BPVC Sec VIII &bull; FCC Part 18 &bull; 3-A 73-01 &bull; NFPA 652
    </span>
  </div>

  <h2 class="text-title-lg md:text-headline-sm font-medium text-ink tracking-tight mb-3">
    {d.title}
  </h2>
  <p class="text-body text-sm leading-relaxed mb-8 max-w-4xl text-muted">
    {d.subtitle}
  </p>

  <!-- Industrial Presets Row -->
  <div class="mb-8 p-5 bg-surface-soft border border-hairline rounded-2xl">
    <div class="text-xs font-bold uppercase tracking-wider text-ink mb-3 flex items-center gap-2">
      <svg class="w-4 h-4 text-orange-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
      </svg>
      {d.presetsTitle}
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2.5">
      <button 
        type="button" 
        id="mai-preset-coffee"
        class="text-left p-3 rounded-xl bg-surface border border-hairline hover:border-orange-500 hover:bg-orange-950/20 transition-all text-xs text-body"
      >
        <span class="font-bold text-orange-400 block mb-1">☕ {d.presetCoffee.split('(')[0]}</span>
        <span class="text-muted text-[11px] block leading-tight">{d.presetCoffee}</span>
      </button>

      <button 
        type="button" 
        id="mai-preset-cacao"
        class="text-left p-3 rounded-xl bg-surface border border-hairline hover:border-orange-500 hover:bg-orange-950/20 transition-all text-xs text-body"
      >
        <span class="font-bold text-orange-400 block mb-1">🍫 {d.presetCacao.split('(')[0]}</span>
        <span class="text-muted text-[11px] block leading-tight">{d.presetCacao}</span>
      </button>

      <button 
        type="button" 
        id="mai-preset-almonds"
        class="text-left p-3 rounded-xl bg-surface border border-hairline hover:border-orange-500 hover:bg-orange-950/20 transition-all text-xs text-body"
      >
        <span class="font-bold text-orange-400 block mb-1">🥜 {d.presetAlmonds.split('(')[0]}</span>
        <span class="text-muted text-[11px] block leading-tight">{d.presetAlmonds}</span>
      </button>

      <button 
        type="button" 
        id="mai-preset-sesame"
        class="text-left p-3 rounded-xl bg-surface border border-hairline hover:border-orange-500 hover:bg-orange-950/20 transition-all text-xs text-body"
      >
        <span class="font-bold text-orange-400 block mb-1">🌾 {d.presetSesame.split('(')[0]}</span>
        <span class="text-muted text-[11px] block leading-tight">{d.presetSesame}</span>
      </button>

      <button 
        type="button" 
        id="mai-preset-hazard"
        class="text-left p-3 rounded-xl bg-rose-950/30 border border-rose-800/80 hover:border-rose-500 hover:bg-rose-950/50 transition-all text-xs text-body sm:col-span-2 lg:col-span-2"
      >
        <span class="font-bold text-rose-400 block mb-1">⚠️ {d.presetHazard.split('(')[0]}</span>
        <span class="text-rose-200/80 text-[11px] block leading-tight">{d.presetHazard}</span>
      </button>
    </div>
  </div>

  <!-- Interactive Controls Section -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-8">
    <div class="lg:col-span-7 space-y-6">
      <div class="border-b border-hairline pb-3">
        <h3 class="text-base font-bold text-ink">
          {d.controlsTitle}
        </h3>
        <p class="text-xs text-muted mt-1">
          {d.controlsSub}
        </p>
      </div>

      <!-- System Selector -->
      <div>
        <label for="mai-system-select" class="block text-xs font-bold text-ink mb-1.5">
          {d.systemLabel}
        </label>
        <select 
          id="mai-system-select" 
          class="w-full text-xs rounded-xl bg-surface-soft border border-hairline p-3 text-ink focus:outline-none focus:border-orange-500 font-medium"
        >
          {systems.map((s) => (
            <option value={s.id}>{s.name} ({s.minOperatingTempC}–{s.maxOperatingTempC}°C, max {s.maxThroughputKgPerHour} kg/h)</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1.5 leading-normal">
          {d.systemHelp}
        </p>
      </div>

      <!-- Feedstock Selector -->
      <div>
        <label for="mai-feed-select" class="block text-xs font-bold text-ink mb-1.5">
          {d.matrixLabel}
        </label>
        <select 
          id="mai-feed-select" 
          class="w-full text-xs rounded-xl bg-surface-soft border border-hairline p-3 text-ink focus:outline-none focus:border-orange-500 font-medium"
        >
          {feeds.map((f) => (
            <option value={f.id}>{f.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1.5 leading-normal">
          {d.matrixHelp}
        </p>
      </div>

      <!-- Microwave & Induction Condition Selectors -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="mai-mw-select" class="block text-xs font-bold text-ink mb-1.5">
            {d.microwaveLabel}
          </label>
          <select 
            id="mai-mw-select" 
            class="w-full text-xs rounded-xl bg-surface-soft border border-hairline p-3 text-ink focus:outline-none focus:border-orange-500 font-medium"
          >
            {microwaves.map((m) => (
              <option value={m.id}>{m.name}</option>
            ))}
          </select>
          <p class="text-[11px] text-muted mt-1.5 leading-normal">
            {d.microwaveHelp}
          </p>
        </div>

        <div>
          <label for="mai-ind-select" class="block text-xs font-bold text-ink mb-1.5">
            {d.inductionLabel}
          </label>
          <select 
            id="mai-ind-select" 
            class="w-full text-xs rounded-xl bg-surface-soft border border-hairline p-3 text-ink focus:outline-none focus:border-orange-500 font-medium"
          >
            {inductions.map((ind) => (
              <option value={ind.id}>{ind.name}</option>
            ))}
          </select>
          <p class="text-[11px] text-muted mt-1.5 leading-normal">
            {d.inductionHelp}
          </p>
        </div>
      </div>

      <!-- Sliders -->
      <div class="space-y-4 pt-2">
        <!-- Operating Temp -->
        <div>
          <div class="flex justify-between items-center text-xs font-bold text-ink mb-1.5">
            <label for="mai-temp-slider">{d.tempLabel}</label>
            <span id="mai-temp-val" class="text-orange-400 font-mono">155.0 &deg;C</span>
          </div>
          <input 
            type="range" 
            id="mai-temp-slider" 
            min="100.0" 
            max="190.0" 
            step="1.0" 
            value="155.0"
            class="w-full accent-orange-500 cursor-pointer h-2 bg-surface-soft rounded-lg"
          />
          <p class="text-[11px] text-muted mt-1">
            {d.tempHelp}
          </p>
        </div>

        <!-- Microwave Power -->
        <div>
          <div class="flex justify-between items-center text-xs font-bold text-ink mb-1.5">
            <label for="mai-mw-power-slider">{d.mwPowerLabel}</label>
            <span id="mai-mw-power-val" class="text-orange-400 font-mono">28.0 kW</span>
          </div>
          <input 
            type="range" 
            id="mai-mw-power-slider" 
            min="5.0" 
            max="60.0" 
            step="1.0" 
            value="28.0"
            class="w-full accent-orange-500 cursor-pointer h-2 bg-surface-soft rounded-lg"
          />
          <p class="text-[11px] text-muted mt-1">
            {d.mwPowerHelp}
          </p>
        </div>

        <!-- Induction Power -->
        <div>
          <div class="flex justify-between items-center text-xs font-bold text-ink mb-1.5">
            <label for="mai-ind-power-slider">{d.indPowerLabel}</label>
            <span id="mai-ind-power-val" class="text-orange-400 font-mono">32.0 kW</span>
          </div>
          <input 
            type="range" 
            id="mai-ind-power-slider" 
            min="5.0" 
            max="70.0" 
            step="1.0" 
            value="32.0"
            class="w-full accent-orange-500 cursor-pointer h-2 bg-surface-soft rounded-lg"
          />
          <p class="text-[11px] text-muted mt-1">
            {d.indPowerHelp}
          </p>
        </div>

        <!-- Spouting Air Velocity -->
        <div>
          <div class="flex justify-between items-center text-xs font-bold text-ink mb-1.5">
            <label for="mai-air-slider">{d.airVelocityLabel}</label>
            <span id="mai-air-val" class="text-orange-400 font-mono">2.20 m/s</span>
          </div>
          <input 
            type="range" 
            id="mai-air-slider" 
            min="1.0" 
            max="4.0" 
            step="0.05" 
            value="2.20"
            class="w-full accent-orange-500 cursor-pointer h-2 bg-surface-soft rounded-lg"
          />
          <p class="text-[11px] text-muted mt-1">
            {d.airVelocityHelp}
          </p>
        </div>

        <!-- Feed Rate -->
        <div>
          <div class="flex justify-between items-center text-xs font-bold text-ink mb-1.5">
            <label for="mai-feed-slider">{d.feedRateLabel}</label>
            <span id="mai-feed-val" class="text-orange-400 font-mono">1,200 kg/h</span>
          </div>
          <input 
            type="range" 
            id="mai-feed-slider" 
            min="100.0" 
            max="3500.0" 
            step="50.0" 
            value="1200.0"
            class="w-full accent-orange-500 cursor-pointer h-2 bg-surface-soft rounded-lg"
          />
          <p class="text-[11px] text-muted mt-1">
            {d.feedRateHelp}
          </p>
        </div>
      </div>
    </div>

    <!-- Live Telemetry Column -->
    <div class="lg:col-span-5 flex flex-col justify-between space-y-6 bg-surface-soft border border-hairline p-6 rounded-2xl">
      <div>
        <div class="flex items-center justify-between gap-2 mb-4 border-b border-hairline pb-3">
          <div>
            <h3 class="text-base font-bold text-ink">
              {d.diagnosticTitle}
            </h3>
            <p class="text-xs text-muted mt-0.5">
              {d.diagnosticSub}
            </p>
          </div>
          <span id="mai-safety-badge" class="px-3.5 py-1.5 rounded-full text-xs font-bold tracking-wide bg-emerald-950 text-emerald-300 border border-emerald-800">
            OPTIMAL / FULL PARITY
          </span>
        </div>

        <!-- Hazard Warning Banner -->
        <div id="mai-hazard-banner" class="hidden mb-4 p-4 rounded-xl bg-rose-950/80 border border-rose-700 text-rose-200 text-xs space-y-1">
          <div class="font-bold flex items-center gap-1.5 text-rose-300">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            CRITICAL SAFETY FAILURE: HAZARDOUS OPERATION DETECTED
          </div>
          <p class="text-[11px] leading-relaxed">
            Unshielded microwave radiation or direct fossil flame hot spots violate OSHA 29 CFR § 1910.97, FCC Part 18, and NFPA 652 dust safety standards, risking intense beam scorching, toxic emissions, and explosion.
          </p>
        </div>

        <!-- Telemetry Meters Grid -->
        <div class="grid grid-cols-2 gap-3.5">
          <!-- SEC -->
          <div class="p-3.5 rounded-xl bg-surface border border-hairline">
            <div class="text-[11px] text-muted font-medium mb-1">
              {d.secLabel}
            </div>
            <div id="mai-sec-metric" class="text-lg md:text-xl font-bold font-mono text-orange-400">
              0.28 kWh/kg
            </div>
            <div class="text-[10px] text-muted mt-1 font-mono">
              Electromagnetic Hybrid
            </div>
          </div>

          <!-- Energy Savings -->
          <div class="p-3.5 rounded-xl bg-surface border border-hairline">
            <div class="text-[11px] text-muted font-medium mb-1">
              {d.energySavingLabel}
            </div>
            <div id="mai-energy-saving-metric" class="text-lg md:text-xl font-bold font-mono text-emerald-400">
              58.4%
            </div>
            <div class="text-[10px] text-muted mt-1 font-mono">
              vs Gas Drum Roaster
            </div>
          </div>

          <!-- Uniformity -->
          <div class="p-3.5 rounded-xl bg-surface border border-hairline">
            <div class="text-[11px] text-muted font-medium mb-1">
              {d.uniformityLabel}
            </div>
            <div id="mai-uniformity-metric" class="text-lg md:text-xl font-bold font-mono text-cyan-400">
              &plusmn;1.4 &deg;C
            </div>
            <div class="text-[10px] text-muted mt-1 font-mono">
              Core-to-Shell Parity
            </div>
          </div>

          <!-- Mycotoxin Destruction -->
          <div class="p-3.5 rounded-xl bg-surface border border-hairline">
            <div class="text-[11px] text-muted font-medium mb-1">
              {d.mycotoxinLabel}
            </div>
            <div id="mai-mycotoxin-metric" class="text-lg md:text-xl font-bold font-mono text-emerald-400">
              93.5%
            </div>
            <div class="text-[10px] text-muted mt-1 font-mono">
              Ochratoxin A Pyrolysis
            </div>
          </div>

          <!-- Pathogen Lethality -->
          <div class="p-3.5 rounded-xl bg-surface border border-hairline">
            <div class="text-[11px] text-muted font-medium mb-1">
              {d.pathogenLabel}
            </div>
            <div id="mai-pathogen-metric" class="text-lg md:text-xl font-bold font-mono text-emerald-400">
              6.8 Log
            </div>
            <div class="text-[10px] text-muted mt-1 font-mono">
              Validated Sterilization
            </div>
          </div>

          <!-- Scorched Spot Defect -->
          <div class="p-3.5 rounded-xl bg-surface border border-hairline">
            <div class="text-[11px] text-muted font-medium mb-1">
              {d.scorchDefectLabel}
            </div>
            <div id="mai-scorch-metric" class="text-lg md:text-xl font-bold font-mono text-emerald-400">
              0.02%
            </div>
            <div class="text-[10px] text-muted mt-1 font-mono">
              Zero Bean Tipping
            </div>
          </div>

          <!-- Residual Moisture -->
          <div class="p-3.5 rounded-xl bg-surface border border-hairline col-span-2">
            <div class="text-[11px] text-muted font-medium mb-1">
              {d.residualMoistureLabel}
            </div>
            <div id="mai-moisture-metric" class="text-lg md:text-xl font-bold font-mono text-ink">
              2.1% Moisture
            </div>
            <div class="text-[10px] text-muted mt-1 font-mono">
              Shelf-Stable Activity (a_w &lt; 0.28)
            </div>
          </div>
        </div>
      </div>

      <!-- Compliance Footer -->
      <div class="pt-4 border-t border-hairline">
        <div class="text-[11px] text-muted font-medium mb-1">
          {d.statusLabel}
        </div>
        <div id="mai-compliance-metric" class="text-xs font-bold font-mono text-emerald-400">
