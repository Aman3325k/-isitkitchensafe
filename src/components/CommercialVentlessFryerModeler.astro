const d = DICTIONARY[lang];
---

<div class="bg-surface border border-hairline rounded-3xl p-6 md:p-8 shadow-sm space-y-8 my-8" id="ventless-fryer-modeler-container">
  <!-- Controls Section -->
  <div>
    <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
      <div>
        <h2 class="text-xl md:text-2xl font-bold text-ink tracking-tight flex items-center gap-2">
          <span>🔥</span>
          {d.controlsTitle}
        </h2>
        <p class="text-sm text-muted mt-1">{d.controlsSub}</p>
      </div>
      <span class="px-3 py-1 bg-amber-500/10 text-amber-700 dark:text-amber-300 font-mono text-xs rounded-full border border-amber-500/20">
        UL 710B &bull; NFPA 96 § 13 &bull; NFPA 17A
      </span>
    </div>

    <!-- Dropdowns Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
      <!-- Fryer Architecture -->
      <div class="bg-surface-soft border border-hairline rounded-2xl p-4">
        <label for="fryer-model-select" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1">
          {d.fryerModelLabel}
        </label>
        <select id="fryer-model-select" class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-amber-500">
          {fryerData.fryerArchitectures.map(fryer => (
            <option value={fryer.id}>{fryer.name}</option>
          ))}
        </select>
        <p class="text-xs text-muted mt-2">{d.fryerModelHelp}</p>
      </div>

      <!-- Filter Train Configuration -->
      <div class="bg-surface-soft border border-hairline rounded-2xl p-4">
        <label for="filter-train-select" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1">
          {d.filterTrainLabel}
        </label>
        <select id="filter-train-select" class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-amber-500">
          {fryerData.filterTrainConfigurations.map(filter => (
            <option value={filter.id}>{filter.name}</option>
          ))}
        </select>
        <p class="text-xs text-muted mt-2">{d.filterTrainHelp}</p>
      </div>

      <!-- Oil Formulation & Degradation -->
      <div class="bg-surface-soft border border-hairline rounded-2xl p-4">
        <label for="oil-type-select" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1">
          {d.oilTypeLabel}
        </label>
        <select id="oil-type-select" class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-amber-500">
          {fryerData.oilFormulations.map(oil => (
            <option value={oil.id}>{oil.name}</option>
          ))}
        </select>
        <p class="text-xs text-muted mt-2">{d.oilTypeHelp}</p>
      </div>

      <!-- Fire Suppression System -->
      <div class="bg-surface-soft border border-hairline rounded-2xl p-4">
        <label for="fire-system-select" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1">
          {d.fireSystemLabel}
        </label>
        <select id="fire-system-select" class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-amber-500">
          {fryerData.fireSuppressionSystems.map(sys => (
            <option value={sys.id}>{sys.name}</option>
          ))}
        </select>
        <p class="text-xs text-muted mt-2">{d.fireSystemHelp}</p>
      </div>
    </div>

    <!-- Interactive Sliders Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 mb-6">
      <!-- Oil Temperature Slider -->
      <div class="bg-surface-soft border border-hairline rounded-2xl p-4">
        <div class="flex justify-between items-center mb-1">
          <label for="temp-slider" class="text-xs font-bold text-ink">{d.tempSliderLabel}</label>
          <span id="temp-val-display" class="font-mono text-sm font-semibold text-amber-600">175°C (347°F)</span>
        </div>
        <input type="range" id="temp-slider" min="160" max="215" step="1" value="175" class="w-full accent-amber-600 cursor-pointer" />
        <p class="text-xs text-muted mt-1">{d.tempSliderHelp}</p>
      </div>

      <!-- Throughput Slider -->
      <div class="bg-surface-soft border border-hairline rounded-2xl p-4">
        <div class="flex justify-between items-center mb-1">
          <label for="throughput-slider" class="text-xs font-bold text-ink">{d.throughputSliderLabel}</label>
          <span id="throughput-val-display" class="font-mono text-sm font-semibold text-amber-600">25 kg/h</span>
        </div>
        <input type="range" id="throughput-slider" min="5" max="65" step="1" value="25" class="w-full accent-amber-600 cursor-pointer" />
        <p class="text-xs text-muted mt-1">{d.throughputSliderHelp}</p>
      </div>

      <!-- ESP Filter Operating Hours Slider -->
      <div class="bg-surface-soft border border-hairline rounded-2xl p-4">
        <div class="flex justify-between items-center mb-1">
          <label for="esp-hours-slider" class="text-xs font-bold text-ink">{d.espHoursSliderLabel}</label>
          <span id="esp-hours-val-display" class="font-mono text-sm font-semibold text-amber-600">8 hrs</span>
        </div>
        <input type="range" id="esp-hours-slider" min="0" max="120" step="1" value="8" class="w-full accent-amber-600 cursor-pointer" />
        <p class="text-xs text-muted mt-1">{d.espHoursSliderHelp}</p>
      </div>

      <!-- Airflow Blower Slider -->
      <div class="bg-surface-soft border border-hairline rounded-2xl p-4">
        <div class="flex justify-between items-center mb-1">
          <label for="airflow-slider" class="text-xs font-bold text-ink">{d.airflowSliderLabel}</label>
          <span id="airflow-val-display" class="font-mono text-sm font-semibold text-amber-600">450 CFM</span>
        </div>
        <input type="range" id="airflow-slider" min="100" max="550" step="5" value="450" class="w-full accent-amber-600 cursor-pointer" />
        <p class="text-xs text-muted mt-1">{d.airflowSliderHelp}</p>
      </div>

      <!-- Operator Response Time Slider -->
      <div class="bg-surface-soft border border-hairline rounded-2xl p-4 md:col-span-2 lg:col-span-2">
        <div class="flex justify-between items-center mb-1">
          <label for="operator-delay-slider" class="text-xs font-bold text-ink">{d.operatorDelaySliderLabel}</label>
          <span id="operator-delay-val-display" class="font-mono text-sm font-semibold text-amber-600">4 sec</span>
        </div>
        <input type="range" id="operator-delay-slider" min="1" max="45" step="1" value="4" class="w-full accent-amber-600 cursor-pointer" />
        <p class="text-xs text-muted mt-1">{d.operatorDelaySliderHelp}</p>
      </div>
    </div>

    <!-- Presets -->
    <div class="bg-surface-soft border border-hairline rounded-2xl p-4">
      <div class="text-xs font-bold uppercase tracking-wider text-muted mb-2">{d.presetsTitle}</div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2">
        <button type="button" id="preset-gold" class="text-left px-3 py-2 rounded-xl bg-surface hover:bg-surface-hover border border-hairline text-xs font-medium text-ink transition-colors">
          ✨ {d.presetGoldStandard}
        </button>
        <button type="button" id="preset-arc" class="text-left px-3 py-2 rounded-xl bg-surface hover:bg-surface-hover border border-hairline text-xs font-medium text-ink transition-colors">
          ⚡ {d.presetArcFlash}
        </button>
        <button type="button" id="preset-cavitation" class="text-left px-3 py-2 rounded-xl bg-surface hover:bg-surface-hover border border-hairline text-xs font-medium text-ink transition-colors">
          🍟 {d.presetSteamCavitation}
        </button>
        <button type="button" id="preset-autoignition" class="text-left px-3 py-2 rounded-xl bg-surface hover:bg-surface-hover border border-hairline text-xs font-medium text-ink transition-colors">
          💥 {d.presetAutoignition}
        </button>
      </div>
    </div>
  </div>

  <!-- Telemetry Diagnostic Cards -->
  <div class="border-t border-hairline pt-6">
    <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
      <div>
        <h3 class="text-lg md:text-xl font-bold text-ink tracking-tight flex items-center gap-2">
          <span>📊</span>
          {d.diagnosticTitle}
        </h3>
        <p class="text-xs text-muted mt-0.5">{d.diagnosticSub}</p>
      </div>
      <button type="button" id="copy-telemetry-btn" class="px-4 py-2 rounded-xl bg-surface-soft hover:bg-surface-hover border border-hairline text-xs font-bold text-ink transition-colors flex items-center gap-1.5 shadow-xs">
        <span>📋</span>
        <span id="copy-btn-text">{d.copyReportBtn}</span>
      </button>
    </div>

    <!-- Key Metrics Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-6">
      <!-- 1. Aerosol Concentration -->
      <div class="bg-surface-soft border border-hairline rounded-2xl p-4 flex flex-col justify-between">
        <span class="text-xs font-bold text-muted uppercase tracking-wider">{d.aerosolLabel}</span>
        <div class="my-2">
          <span id="out-aerosol-val" class="text-2xl md:text-3xl font-mono font-extrabold text-ink">1.12</span>
          <span class="text-xs text-muted ml-1 font-mono">mg/m³</span>
        </div>
        <div class="flex items-center justify-between text-xs font-mono">
          <span class="text-muted">UL 710B Ceiling:</span>
          <span id="out-aerosol-limit" class="font-bold text-emerald-600">5.0 mg/m³ (PASS)</span>
        </div>
      </div>

      <!-- 2. ESP Sparking Risk -->
      <div class="bg-surface-soft border border-hairline rounded-2xl p-4 flex flex-col justify-between">
        <span class="text-xs font-bold text-muted uppercase tracking-wider">{d.sparkRiskLabel}</span>
        <div class="my-2">
          <span id="out-spark-val" class="text-2xl md:text-3xl font-mono font-extrabold text-ink">1.2%</span>
          <span class="text-xs text-muted ml-1 font-mono">Corona Spark Risk</span>
        </div>
        <div class="flex items-center justify-between text-xs font-mono">
          <span class="text-muted">Collector Status:</span>
          <span id="out-spark-status" class="font-bold text-emerald-600">Normal Dielectric</span>
        </div>
      </div>

      <!-- 3. Saponification Blanket -->
      <div class="bg-surface-soft border border-hairline rounded-2xl p-4 flex flex-col justify-between">
        <span class="text-xs font-bold text-muted uppercase tracking-wider">{d.saponificationLabel}</span>
        <div class="my-2">
          <span id="out-sapon-val" class="text-2xl md:text-3xl font-mono font-extrabold text-ink">27.5</span>
          <span class="text-xs text-muted ml-1 font-mono">minutes</span>
        </div>
        <div class="flex items-center justify-between text-xs font-mono">
          <span class="text-muted">K-Soap Stability:</span>
          <span id="out-sapon-status" class="font-bold text-emerald-600">Dense Foam Oxygen Seal</span>
        </div>
      </div>

      <!-- 4. Fire Risk Index -->
      <div class="bg-surface-soft border border-hairline rounded-2xl p-4 flex flex-col justify-between">
        <span class="text-xs font-bold text-muted uppercase tracking-wider">{d.fireRiskLabel}</span>
        <div class="my-2">
          <span id="out-fire-val" class="text-2xl md:text-3xl font-mono font-extrabold text-ink">4.2%</span>
          <span class="text-xs text-muted ml-1 font-mono">Thermal Runaway Index</span>
        </div>
        <div class="flex items-center justify-between text-xs font-mono">
          <span class="text-muted">Autoignition Headroom:</span>
          <span id="out-fire-headroom" class="font-bold text-emerald-600">+190°C Headroom</span>
        </div>
      </div>

      <!-- 5. VOC / Acrolein Breakthrough -->
      <div class="bg-surface-soft border border-hairline rounded-2xl p-4 flex flex-col justify-between">
        <span class="text-xs font-bold text-muted uppercase tracking-wider">{d.vocLabel}</span>
        <div class="my-2">
          <span id="out-voc-val" class="text-2xl md:text-3xl font-mono font-extrabold text-ink">0.02</span>
          <span class="text-xs text-muted ml-1 font-mono">PPM Acrolein</span>
        </div>
        <div class="flex items-center justify-between text-xs font-mono">
          <span class="text-muted">OSHA PEL (0.10 PPM):</span>
          <span id="out-voc-status" class="font-bold text-emerald-600">80% Below Limit</span>
        </div>
      </div>

      <!-- 6. Regulatory Verdict -->
      <div class="bg-surface-soft border border-hairline rounded-2xl p-4 flex flex-col justify-between">
        <span class="text-xs font-bold text-muted uppercase tracking-wider">{d.complianceLabel}</span>
        <div class="my-2">
          <span id="out-compliance-badge" class="px-2.5 py-1 text-sm font-bold rounded-lg bg-emerald-500/20 text-emerald-700 dark:text-emerald-300 border border-emerald-500/30">
            100% COMPLIANT
          </span>
        </div>
        <div class="flex items-center justify-between text-xs font-mono">
          <span class="text-muted">Interlock State:</span>
          <span id="out-interlock-status" class="font-bold text-emerald-600">Closed-Loop Armed</span>
        </div>
      </div>
    </div>

    <!-- Diagnostic Narrative Box -->
    <div class="bg-surface-soft border border-hairline rounded-2xl p-5 space-y-4">
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-amber-700 dark:text-amber-400 mb-1">
          {d.primaryRiskLabel}
        </h4>
        <p id="narrative-risk" class="text-sm text-ink font-medium leading-relaxed">
          Standard operational conditions: submicron oil aerosol droplets are aerodynamically captured by the 4-stage filter train, keeping restaurant exhaust clean.
        </p>
      </div>

      <div class="border-t border-hairline pt-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-muted mb-1">
          {d.mechanismsLabel}
        </h4>
        <p id="narrative-mechanisms" class="text-xs text-muted leading-relaxed">
          Stokes' settling velocity, particle Brownian diffusion, corona discharge wire charging, and electrostatic precipitation kinetics ensure full containment.
        </p>
      </div>

      <div class="border-t border-hairline pt-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-muted mb-1">
          {d.mitigationLabel}
        </h4>
        <p id="narrative-mitigations" class="text-xs text-muted leading-relaxed">
          Maintain strict 24-hour caustic degreasing soak cycles for ESP collector plates, monitor HEPA static backpressure differential, and verify semi-annual wet chemical certification.
        </p>
      </div>
    </div>
  </div>

  <!-- Scientific Physics Deep Dive -->
  <div class="border-t border-hairline pt-6">
    <div class="mb-4">
      <h3 class="text-lg md:text-xl font-bold text-ink tracking-tight flex items-center gap-2">
        <span>🔬</span>
        {d.scienceTitle}
      </h3>
      <p class="text-xs text-muted mt-0.5">{d.scienceSub}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
      <div class="bg-surface-soft border border-hairline rounded-2xl p-4">
        <h4 class="font-bold text-ink mb-1">1. Cavitation Oil Atomization</h4>
        <p class="text-muted leading-relaxed">
          When moisture in foods contacts 180°C oil, rapid flash vaporization causes explosive steam bubble growth. Bubble rupture at the oil-air interface generates submicron droplets (0.1–2.5 μm) that easily bypass coarse baffle filters.
        </p>
      </div>
      <div class="bg-surface-soft border border-hairline rounded-2xl p-4">
        <h4 class="font-bold text-ink mb-1">2. Debye Electrostatic Precipitation</h4>
        <p class="text-muted leading-relaxed">
          High-voltage ionizing wires (10–14 kV DC) generate a negative corona discharge that bombards passing oil droplets with electrons. Charged droplets migrate laterally toward grounded collector plates under strong electrostatic fields.
        </p>
      </div>
      <div class="bg-surface-soft border border-hairline rounded-2xl p-4">
        <h4 class="font-bold text-ink mb-1">3. Saponification Alkaline Quench</h4>
        <p class="text-muted leading-relaxed">
          NFPA 17A wet chemical agents (potassium carbonate / potassium acetate) undergo an endothermic saponification reaction with free fatty acids, producing potassium soap foam that cuts off oxygen and prevents vapor re-flash.
        </p>
      </div>
    </div>
  </div>

  <!-- Technical Engineering Matrix Table -->
  <div class="border-t border-hairline pt-6">
    <div class="mb-4">
      <h3 class="text-lg md:text-xl font-bold text-ink tracking-tight flex items-center gap-2">
        <span>📐</span>
        {d.tableTitle}
      </h3>
      <p class="text-xs text-muted mt-0.5">{d.tableSub}</p>
    </div>

    <div class="overflow-x-auto rounded-2xl border border-hairline">
      <table class="w-full text-left text-xs">
        <thead class="bg-surface-soft border-b border-hairline font-bold text-ink uppercase tracking-wider">
          <tr>
            <th class="p-3">{d.colModel}</th>
            <th class="p-3">{d.colPower}</th>
            <th class="p-3">{d.colAirflow}</th>
            <th class="p-3">{d.colEsp}</th>
            <th class="p-3">{d.colEmission}</th>
            <th class="p-3">{d.colInterlock}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline">
          {fryerData.engineeringMatrix.map((item, idx) => (
            <tr class={idx % 2 === 0 ? 'bg-surface' : 'bg-surface-soft/40'}>
              <td class="p-3 font-semibold text-ink">{item.model}</td>
              <td class="p-3 font-mono">{item.inductionPower}</td>
              <td class="p-3 font-mono">{item.airflow}</td>
              <td class="p-3 font-mono">{item.espVoltage}</td>
              <td class="p-3 font-mono text-amber-700 dark:text-amber-400 font-semibold">{item.greaseEmission}</td>
              <td class="p-3 text-muted">{item.interlockProving}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Safety Rules & Directives Section -->
  <div class="border-t border-hairline pt-6">
    <div class="mb-4">
      <h3 class="text-lg md:text-xl font-bold text-ink tracking-tight flex items-center gap-2">
        <span>⚖️</span>
        {d.rulesTitle}
      </h3>
      <p class="text-xs text-muted mt-0.5">{d.rulesSub}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="bg-surface-soft border border-hairline rounded-2xl p-4">
        <h4 class="font-bold text-sm text-ink mb-1">{d.rule1Title}</h4>
        <p class="text-xs text-muted leading-relaxed">{d.rule1Text}</p>
      </div>
      <div class="bg-surface-soft border border-hairline rounded-2xl p-4">
        <h4 class="font-bold text-sm text-ink mb-1">{d.rule2Title}</h4>
        <p class="text-xs text-muted leading-relaxed">{d.rule2Text}</p>
      </div>
      <div class="bg-surface-soft border border-hairline rounded-2xl p-4">
        <h4 class="font-bold text-sm text-ink mb-1">{d.rule3Title}</h4>
        <p class="text-xs text-muted leading-relaxed">{d.rule3Text}</p>
      </div>
      <div class="bg-surface-soft border border-hairline rounded-2xl p-4">
        <h4 class="font-bold text-sm text-ink mb-1">{d.rule4Title}</h4>
        <p class="text-xs text-muted leading-relaxed">{d.rule4Text}</p>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ fryerData }}>
  function initVentlessFryerModeler() {
    // DOM Elements
    const modelSelect = document.getElementById('fryer-model-select');
    const filterSelect = document.getElementById('filter-train-select');
    const oilSelect = document.getElementById('oil-type-select');
    const fireSelect = document.getElementById('fire-system-select');

    const tempSlider = document.getElementById('temp-slider');
    const throughputSlider = document.getElementById('throughput-slider');
    const espHoursSlider = document.getElementById('esp-hours-slider');
    const airflowSlider = document.getElementById('airflow-slider');
    const operatorDelaySlider = document.getElementById('operator-delay-slider');

    const tempValDisplay = document.getElementById('temp-val-display');
    const throughputValDisplay = document.getElementById('throughput-val-display');
    const espHoursValDisplay = document.getElementById('esp-hours-val-display');
    const airflowValDisplay = document.getElementById('airflow-val-display');
    const operatorDelayValDisplay = document.getElementById('operator-delay-val-display');

    // Preset Buttons
    const presetGoldBtn = document.getElementById('preset-gold');
    const presetArcBtn = document.getElementById('preset-arc');
    const presetCavitationBtn = document.getElementById('preset-cavitation');
    const presetAutoignitionBtn = document.getElementById('preset-autoignition');

    // Outputs
    const outAerosolVal = document.getElementById('out-aerosol-val');
    const outAerosolLimit = document.getElementById('out-aerosol-limit');
    const outSparkVal = document.getElementById('out-spark-val');
    const outSparkStatus = document.getElementById('out-spark-status');
    const outSaponVal = document.getElementById('out-sapon-val');
    const outSaponStatus = document.getElementById('out-sapon-status');
    const outFireVal = document.getElementById('out-fire-val');
    const outFireHeadroom = document.getElementById('out-fire-headroom');
    const outVocVal = document.getElementById('out-voc-val');
    const outVocStatus = document.getElementById('out-voc-status');
    const outComplianceBadge = document.getElementById('out-compliance-badge');
    const outInterlockStatus = document.getElementById('out-interlock-status');

    const narrativeRisk = document.getElementById('narrative-risk');
    const narrativeMechanisms = document.getElementById('narrative-mechanisms');
    const narrativeMitigations = document.getElementById('narrative-mitigations');

    const copyBtn = document.getElementById('copy-telemetry-btn');
    const copyBtnText = document.getElementById('copy-btn-text');

    if (!modelSelect || !filterSelect || !oilSelect || !fireSelect) return;

    function recalculate() {
      const selectedModel = fryerData.fryerArchitectures.find(f => f.id === modelSelect.value) || fryerData.fryerArchitectures[0];
      const selectedFilter = fryerData.filterTrainConfigurations.find(f => f.id === filterSelect.value) || fryerData.filterTrainConfigurations[0];
      const selectedOil = fryerData.oilFormulations.find(f => f.id === oilSelect.value) || fryerData.oilFormulations[0];
      const selectedFire = fryerData.fireSuppressionSystems.find(f => f.id === fireSelect.value) || fryerData.fireSuppressionSystems[0];

      const tempC = parseFloat(tempSlider.value);
      const tempF = Math.round(tempC * 9 / 5 + 32);
      const throughputKg = parseFloat(throughputSlider.value);
      const espHours = parseFloat(espHoursSlider.value);
      const airflowCfm = parseFloat(airflowSlider.value);
      const operatorDelaySec = parseFloat(operatorDelaySlider.value);

      // Slider Display Updates
      tempValDisplay.textContent = `${tempC}°C (${tempF}°F)`;
      throughputValDisplay.textContent = `${throughputKg} kg/h`;
      espHoursValDisplay.textContent = `${espHours} hrs`;
      airflowValDisplay.textContent = `${airflowCfm} CFM`;
      operatorDelayValDisplay.textContent = `${operatorDelaySec} sec`;

      // 1. Aerosol Generation & Pass-Through Calculation (EPA Method 202)
      // Baseline generation depends on temperature, oil thermal breakdown factor, and moisture load
      const thermalFactor = Math.pow(Math.max(1.0, tempC / 175.0), 2.8);
      const rawAerosolMgM3 = (2.2 * thermalFactor * selectedOil.aerosolGenerationFactor * (throughputKg / 25.0) * (400.0 / airflowCfm));
      
      // Filter filtration efficiency decay based on unwashed ESP hours and filter type
      let espEfficiency = (selectedFilter.espCollectionEfficiency / 100.0);
      if (espHours > 24) {
        espEfficiency *= Math.max(0.2, 1.0 - ((espHours - 24) / 96) * 0.75);
      }
      const totalCaptureEfficiency = (selectedFilter.stage1Efficiency / 100.0) * 0.4 + espEfficiency * 0.5 + (selectedFilter.hepaEfficiency / 100.0) * 0.1;
      const netAerosolMgM3 = Math.max(0.4, rawAerosolMgM3 * (1.0 - totalCaptureEfficiency * 0.92));

      // 2. High-Voltage ESP Sparking & Arc Flashover Risk (%)
      let sparkRisk = selectedFilter.sparkingRiskPercent;
      if (espHours > 16) {
        sparkRisk += Math.min(75.0, (espHours - 16) * 0.9);
      }
      if (tempC > 190) {
        sparkRisk += (tempC - 190) * 0.8;
      }
      sparkRisk = Math.min(99.0, Math.max(0.2, sparkRisk));

      // 3. Wet Chemical Saponification Foam Stability
      let saponMinutes = selectedFire.foamBlanketStabilityMinutes;
      // High induction coil heat flux without power cutoff boils the foam away
      if (selectedFire.powerCutoffReliabilityPercent < 50) {
        saponMinutes *= 0.12;
      } else if (tempC > 195) {
        saponMinutes *= Math.max(0.3, 1.0 - ((tempC - 195) / 30));
      }
      saponMinutes = Math.max(1.0, saponMinutes);

      // 4. Auto-Ignition & Flash Fire Vulnerability Index
      const autoIgnitionC = selectedOil.autoIgnitionPointC;
      const headroomC = autoIgnitionC - tempC;
      let fireRiskIndex = 0.0;
      if (headroomC <= 0) {
        fireRiskIndex = 99.9;
      } else if (headroomC < 80) {
        fireRiskIndex = Math.min(98.0, 50.0 + (80 - headroomC) * 0.6);
      } else {
        fireRiskIndex = Math.max(0.5, (tempC / autoIgnitionC) * 12.0 * (sparkRisk / 30.0));
      }

      // 5. VOC / Acrolein Breakthrough (PPM)
      let vocPpm = 0.015 * selectedOil.acroleinYieldFactor * (tempC / 175.0) * ((100.0 - selectedFilter.vocAdsorptionCapacityPercent) / 100.0) * 4.0;
      vocPpm = Math.max(0.005, vocPpm);

      // Render Outputs
      outAerosolVal.textContent = netAerosolMgM3.toFixed(2);
      if (netAerosolMgM3 <= 5.0) {
        outAerosolLimit.textContent = '5.0 mg/m³ (PASS)';
        outAerosolLimit.className = 'font-bold text-emerald-600';
      } else {
        outAerosolLimit.textContent = `EXCEEDS by ${((netAerosolMgM3 / 5.0 - 1) * 100).toFixed(0)}% (FAIL)`;
        outAerosolLimit.className = 'font-bold text-rose-600';
      }

      outSparkVal.textContent = `${sparkRisk.toFixed(1)}%`;
      if (sparkRisk < 15) {
        outSparkStatus.textContent = 'Normal Dielectric';
        outSparkStatus.className = 'font-bold text-emerald-600';
      } else if (sparkRisk < 50) {
        outSparkStatus.textContent = 'Moderate Corona Leak';
        outSparkStatus.className = 'font-bold text-amber-600';
      } else {
        outSparkStatus.textContent = 'High Arc Flashover Risk';
        outSparkStatus.className = 'font-bold text-rose-600';
      }

      outSaponVal.textContent = saponMinutes.toFixed(1);
      if (saponMinutes > 18) {
        outSaponStatus.textContent = 'Dense Foam Oxygen Seal';
        outSaponStatus.className = 'font-bold text-emerald-600';
      } else if (saponMinutes > 8) {
        outSaponStatus.textContent = 'Marginal Quench Barrier';
        outSaponStatus.className = 'font-bold text-amber-600';
      } else {
        outSaponStatus.textContent = 'Foam Vapor Boiloff (Reignition Risk)';
        outSaponStatus.className = 'font-bold text-rose-600';
      }

      outFireVal.textContent = `${fireRiskIndex.toFixed(1)}%`;
      if (headroomC > 120) {
        outFireHeadroom.textContent = `+${Math.round(headroomC)}°C Headroom`;
        outFireHeadroom.className = 'font-bold text-emerald-600';
      } else if (headroomC > 50) {
        outFireHeadroom.textContent = `+${Math.round(headroomC)}°C Headroom (Caution)`;
        outFireHeadroom.className = 'font-bold text-amber-600';
      } else {
        outFireHeadroom.textContent = `CRITICAL: +${Math.round(headroomC)}°C to Auto-Ignition`;
        outFireHeadroom.className = 'font-bold text-rose-600';
      }

      outVocVal.textContent = vocPpm.toFixed(3);
      if (vocPpm <= 0.10) {
        outVocStatus.textContent = `${Math.round((1 - vocPpm / 0.10) * 100)}% Below OSHA PEL`;
        outVocStatus.className = 'font-bold text-emerald-600';
      } else {
        outVocStatus.textContent = `EXCEEDS OSHA PEL 0.1 PPM (${(vocPpm / 0.10).toFixed(1)}x)`;
        outVocStatus.className = 'font-bold text-rose-600';
      }

      // Compliance Verdict
      const isCompliant = (netAerosolMgM3 <= 5.0) && (sparkRisk < 40) && (fireRiskIndex < 40) && (selectedFire.powerCutoffReliabilityPercent > 90);
      if (isCompliant) {
        outComplianceBadge.textContent = '100% COMPLIANT';
        outComplianceBadge.className = 'px-2.5 py-1 text-sm font-bold rounded-lg bg-emerald-500/20 text-emerald-700 dark:text-emerald-300 border border-emerald-500/30';
        outInterlockStatus.textContent = 'Closed-Loop Armed';
        outInterlockStatus.className = 'font-bold text-emerald-600';
      } else if (fireRiskIndex >= 70 || sparkRisk >= 70) {
        outComplianceBadge.textContent = 'CRITICAL FIRE HAZARD';
        outComplianceBadge.className = 'px-2.5 py-1 text-sm font-bold rounded-lg bg-rose-500/20 text-rose-700 dark:text-rose-300 border border-rose-500/30 animate-pulse';
        outInterlockStatus.textContent = 'INTERLOCK TRIPPED / VIOLATED';
        outInterlockStatus.className = 'font-bold text-rose-600';
      } else {
        outComplianceBadge.textContent = 'WARNING: CODE DEFICIENT';
        outComplianceBadge.className = 'px-2.5 py-1 text-sm font-bold rounded-lg bg-amber-500/20 text-amber-700 dark:text-amber-300 border border-amber-500/30';
        outInterlockStatus.textContent = 'Degraded Filtration State';
        outInterlockStatus.className = 'font-bold text-amber-600';
      }

      // Narratives
      if (fireRiskIndex >= 70) {
        narrativeRisk.textContent = `CRITICAL COMBUSTION THREAT: Bulk oil temperature is approaching autoignition (${autoIgnitionC}°C). High-voltage electrostatic sparking (${sparkRisk.toFixed(0)}%) in the unwashed plenum provides an instantaneous ignition source, while continuous induction heat injection defeats saponification foam.`;
        narrativeMechanisms.textContent = `Thermal cracking generates volatile low-flash hydrocarbons and acrolein. Saturated ESP grease bridges act as conductive pathways causing corona arc discharges directly across flammable aerosol clouds.`;
        narrativeMitigations.textContent = `Immediately trip the manual fuel cutoff contactor to de-energize induction coils. Trigger the UL 300 wet chemical suppression system, evacuate personnel, and do NOT apply water to burning oil.`;
      } else if (netAerosolMgM3 > 5.0) {
        narrativeRisk.textContent = `UL 710B GREASE EMISSION VIOLATION: Net aerosol discharge of ${netAerosolMgM3.toFixed(2)} mg/m³ exceeds the maximum permitted ceiling of 5.0 mg/m³ by ${((netAerosolMgM3 / 5.0 - 1) * 100).toFixed(0)}%, accelerating grease accumulation in kitchen ceiling plenums.`;
        narrativeMechanisms.textContent = `Explosive flash vaporization from high-moisture frozen products violently atomizes submicron oil mists (0.2–2.0 μm) that penetrate degraded electrostatic fields and clogged HEPA stages.`;
        narrativeMitigations.textContent = `Reduce hourly product throughput, perform an immediate deep caustic degreasing cycle on ESP collector plates, and replace loaded HEPA filters to restore air differential pressure.`;
      } else {
        narrativeRisk.textContent = `OPTIMAL OPERATING ENVELOPE: Submicron oil aerosol concentration (${netAerosolMgM3.toFixed(2)} mg/m³) is well below the UL 710B 5.0 mg/m³ threshold. Clean electrostatic precipitator cells at ${selectedModel.espVoltageKv} kV maintain robust dielectric insulation with minimal spark risk.`;
        narrativeMechanisms.textContent = `Centrifugal baffle pre-separation captures coarse droplets (>10 μm), while negative corona discharge provides efficient electrostatic migration (Debye length) of submicron aerosols onto grounded collector plates.`;
        narrativeMitigations.textContent = `Continue standard daily 24-hour caustic soak cycles for ESP plates, check differential pressure switch calibration monthly, and maintain semi-annual certified wet chemical inspections.`;
      }
    }

    // Presets
    presetGoldBtn?.addEventListener('click', () => {
      modelSelect.value = 'giles_vhx50_induction_ventless';
      filterSelect.value = 'pristine_4stage_ul710b';
      oilSelect.value = 'high_oleic_canola_fresh';
      fireSelect.value = 'ansul_r102_wet_chemical_active';
      tempSlider.value = '175';
      throughputSlider.value = '25';
      espHoursSlider.value = '6';
      airflowSlider.value = '480';
      operatorDelaySlider.value = '3';
      recalculate();
    });

    presetArcBtn?.addEventListener('click', () => {
      modelSelect.value = 'pitco_vf35_high_efficiency';
      filterSelect.value = 'esp_grease_saturated';
      oilSelect.value = 'standard_commercial_shortening';
      fireSelect.value = 'amerex_kp_restaurant_system';
      tempSlider.value = '190';
      throughputSlider.value = '35';
      espHoursSlider.value = '80';
      airflowSlider.value = '360';
      operatorDelaySlider.value = '5';
      recalculate();
    });

    presetCavitationBtn?.addEventListener('click', () => {
      modelSelect.value = 'perfect_fry_pfc570_automated';
      filterSelect.value = 'hepa_filter_loaded';
      oilSelect.value = 'frozen_batch_high_moisture';
      fireSelect.value = 'ansul_r102_wet_chemical_active';
      tempSlider.value = '192';
      throughputSlider.value = '60';
      espHoursSlider.value = '36';
      airflowSlider.value = '240';
      operatorDelaySlider.value = '6';
      recalculate();
    });

    presetAutoignitionBtn?.addEventListener('click', () => {
      modelSelect.value = 'aged_unmaintained_ventless_fryer';
      filterSelect.value = 'esp_grease_saturated';
      oilSelect.value = 'degraded_rancid_high_tpm_oil';
      fireSelect.value = 'bypassed_electrical_contactor';
      tempSlider.value = '215';
      throughputSlider.value = '45';
      espHoursSlider.value = '110';
      airflowSlider.value = '115';
      operatorDelaySlider.value = '25';
      recalculate();
    });

    // Copy Telemetry
    copyBtn?.addEventListener('click', async () => {
      const report = `=== IsItKitchenSafe Ventless Induction Fryer Telemetry ===
Model: ${modelSelect.options[modelSelect.selectedIndex]?.text}
Filter Train: ${filterSelect.options[filterSelect.selectedIndex]?.text}
Oil Formulation: ${oilSelect.options[oilSelect.selectedIndex]?.text}
Fire Suppression: ${fireSelect.options[fireSelect.selectedIndex]?.text}
Operating Temperature: ${tempSlider.value}°C (${Math.round(parseFloat(tempSlider.value) * 9 / 5 + 32)}°F)
Hourly Product Throughput: ${throughputSlider.value} kg/h
ESP Unwashed Service Hours: ${espHoursSlider.value} hrs
Recirculating Blower Airflow: ${airflowSlider.value} CFM
Operator Reaction Time: ${operatorDelaySlider.value} sec
--------------------------------------------------
Submicron Aerosol Emission: ${outAerosolVal.textContent} mg/m³ [${outAerosolLimit.textContent}]
ESP Arc Flashover Spark Risk: ${outSparkVal.textContent} [${outSparkStatus.textContent}]
Wet Chemical Saponification Stability: ${outSaponVal.textContent} min [${outSaponStatus.textContent}]
Thermal Runaway / Fire Risk Index: ${outFireVal.textContent} [${outFireHeadroom.textContent}]
Acrolein VOC Concentration: ${outVocVal.textContent} PPM [${outVocStatus.textContent}]
Regulatory Compliance Verdict: ${outComplianceBadge.textContent.trim()}
Safety Interlock State: ${outInterlockStatus.textContent}
Primary Hazard: ${narrativeRisk.textContent}
==================================================`;

      try {
        await navigator.clipboard.writeText(report);
        const originalText = copyBtnText.textContent;
        copyBtnText.textContent = 'Copied to Clipboard!';
        setTimeout(() => {
          copyBtnText.textContent = originalText;
        }, 2000);
      } catch (err) {
        console.error('Failed to copy report:', err);
      }
    });

    // Event Listeners
    [modelSelect, filterSelect, oilSelect, fireSelect].forEach(el => el.addEventListener('change', recalculate));
    [tempSlider, throughputSlider, espHoursSlider, airflowSlider, operatorDelaySlider].forEach(el => el.addEventListener('input', recalculate));

    // Initial calculation
    recalculate();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initVentlessFryerModeler);
  } else {
    initVentlessFryerModeler();
  }
</script>
