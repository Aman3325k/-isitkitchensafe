---

<div class="bg-surface-soft border border-hairline rounded-3xl p-6 md:p-10 shadow-sm" id="energy-calculator-root" data-lang={lang}>
  <!-- Top Header / Banner -->
  <div class="mb-8">
    <div class="flex items-center gap-2 mb-2">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-600 text-white">
        {d.badge}
      </span>
      <span class="text-xs text-muted font-mono">DOE 10 CFR 430 &bull; ENERGY STAR v7.0</span>
    </div>
    <h2 class="text-display-sm md:text-display-md font-medium text-ink tracking-tight mb-3">
      {d.title}
    </h2>
    <p class="text-body text-sm md:text-base leading-relaxed max-w-3xl">
      {d.subtitle}
    </p>
  </div>

  <!-- Interactive Controls (Left 7 Cols, Right 5 Cols) -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-10">
    <!-- Left Column: Inputs & Scenario Selection (7 cols) -->
    <div class="lg:col-span-7 space-y-6">
      <!-- Step 1: Cooking Task Selection -->
      <div class="p-5 rounded-2xl bg-surface border border-hairline shadow-xs">
        <label class="block text-xs font-bold uppercase tracking-wider text-muted mb-2">
          {d.step1}: <span class="text-ink font-semibold">{d.taskLabel}</span>
        </label>
        <select 
          id="task-select" 
          class="w-full bg-surface-soft border border-hairline rounded-xl px-4 py-3 text-sm font-medium text-ink focus:outline-none focus:ring-2 focus:ring-emerald-500 transition-all cursor-pointer"
        >
          {energyData.tasks.map((task, idx) => (
            <option value={task.id} selected={idx === 0}>
              {task.title} ({task.category})
            </option>
          ))}
        </select>
        <p class="text-xs text-muted mt-2 leading-relaxed" id="task-description">
          {energyData.tasks[0].description}
        </p>
      </div>

      <!-- Step 2: Current Appliance Selection -->
      <div class="p-5 rounded-2xl bg-surface border border-hairline shadow-xs">
        <div class="flex items-center justify-between mb-2">
          <label class="block text-xs font-bold uppercase tracking-wider text-muted">
            {d.step2}: <span class="text-ink font-semibold">{d.applianceLabel}</span>
          </label>
          <span class="text-xs text-emerald-700 dark:text-emerald-400 font-medium" id="recommended-appliance-badge"></span>
        </div>
        <select 
          id="appliance-select" 
          class="w-full bg-surface-soft border border-hairline rounded-xl px-4 py-3 text-sm font-medium text-ink focus:outline-none focus:ring-2 focus:ring-emerald-500 transition-all cursor-pointer"
        >
          {energyData.appliances.map((app) => (
            <option value={app.id}>
              {app.name} ({app.thermalEfficiencyPct}% Thermal Eff.)
            </option>
          ))}
        </select>
