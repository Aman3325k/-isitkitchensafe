<!-- Embedded JSON Data for Client Script -->
<script id="energy-raw-data" type="application/json" set:html={JSON.stringify(energyData)} />
<script id="energy-dict-data" type="application/json" set:html={JSON.stringify(d)} />

<!-- Client-Side Reactive Simulation Script -->
<script is:inline>
(function() {
  const root = document.getElementById('energy-calculator-root');
  if (!root) return;

  const rawDataEl = document.getElementById('energy-raw-data');
  const dictDataEl = document.getElementById('energy-dict-data');
  if (!rawDataEl || !dictDataEl) return;

  const DATA = JSON.parse(rawDataEl.textContent || '{}');
  const DICT = JSON.parse(dictDataEl.textContent || '{}');

  const taskSelect = document.getElementById('task-select');
  const applianceSelect = document.getElementById('appliance-select');
  const regionSelect = document.getElementById('region-select');
  const freqButtons = document.querySelectorAll('.freq-btn');

  const taskDescEl = document.getElementById('task-description');
  const recommendedBadge = document.getElementById('recommended-appliance-badge');
  const applianceSummaryEl = document.getElementById('appliance-summary');
  const gridIntensityText = document.getElementById('grid-intensity-text');
  const utilityRateText = document.getElementById('utility-rate-text');

  const gaugeCircle = document.getElementById('gauge-circle');
  const gaugePercent = document.getElementById('gauge-percent');
  const efficiencyGradeBadge = document.getElementById('efficiency-grade-badge');
  const verdictBanner = document.getElementById('verdict-banner');
  const verdictText = document.getElementById('verdict-text');

  const statEnergyKwh = document.getElementById('stat-energy-kwh');
  const statCostMeal = document.getElementById('stat-cost-meal');
  const statCarbonMeal = document.getElementById('stat-carbon-meal');
  const statCookTime = document.getElementById('stat-cook-time');
  const statAirQuality = document.getElementById('stat-air-quality');
  const airQualityIcon = document.getElementById('air-quality-icon');

  const matrixBody = document.getElementById('appliance-matrix-body');
  const matrixTaskSubtitle = document.getElementById('matrix-task-subtitle');

  const annualMoneyEl = document.getElementById('annual-stat-money');
  const annualCarbonEl = document.getElementById('annual-stat-carbon');
  const annualKwhEl = document.getElementById('annual-stat-kwh');
  const annualMilesEl = document.getElementById('annual-stat-miles');
  const annualTreesEl = document.getElementById('annual-stat-trees');
  const annualPhonesEl = document.getElementById('annual-stat-phones');
  const annualSubtitleEl = document.getElementById('annual-impact-subtitle');

  let currentTaskId = taskSelect ? taskSelect.value : 'boil_water_1l';
  let currentApplianceId = applianceSelect ? applianceSelect.value : 'induction_cooktop';
  let currentRegionId = regionSelect ? regionSelect.value : 'us_national_avg';
  let currentFrequency = 365; // days per year

  // Helper to find task, appliance, and region
  function getTask(id) {
    return DATA.tasks.find(t => t.id === id) || DATA.tasks[0];
  }

  function getAppliance(id) {
    return DATA.appliances.find(a => a.id === id) || DATA.appliances[0];
  }

  function getRegion(id) {
    return DATA.regionalGrids.find(r => r.id === id) || DATA.regionalGrids[0];
  }

  // Populate appliance dropdown options based on current task
  function syncApplianceDropdown() {
    const task = getTask(currentTaskId);
    if (!task) return;

    const availableApplianceIds = task.applianceOptions.map(o => o.applianceId);
    
    // Clear and rebuild options
    applianceSelect.innerHTML = '';
    availableApplianceIds.forEach(appId => {
      const app = getAppliance(appId);
      if (!app) return;
      const opt = document.createElement('option');
      opt.value = app.id;
      const optData = task.applianceOptions.find(o => o.applianceId === appId);
      const isBest = task.bestApplianceId === app.id;
      opt.textContent = `${app.name} (${optData ? optData.durationMinutes : app.typicalWatts} min • ${optData ? optData.kwhConsumed : ''} kWh)${isBest ? ' ★ ' + DICT.bestChoiceBadge : ''}`;
      applianceSelect.appendChild(opt);
    });

    // If current selected appliance is not in options, default to best or first
    if (!availableApplianceIds.includes(currentApplianceId)) {
      currentApplianceId = task.bestApplianceId || availableApplianceIds[0];
    }
    applianceSelect.value = currentApplianceId;
  }

  function update() {
    const task = getTask(currentTaskId);
    const region = getRegion(currentRegionId);
    const app = getAppliance(currentApplianceId);

    if (taskDescEl) taskDescEl.textContent = task.description;

    // Grid stats
    if (gridIntensityText) gridIntensityText.textContent = `${region.emissionFactorGramsCO2PerKWh} g CO₂/kWh`;
    if (utilityRateText) utilityRateText.textContent = `${region.currencySymbol}${region.electricityPriceUSD} / kWh`;

    // Recommended badge
    const bestApp = getAppliance(task.bestApplianceId);
    if (recommendedBadge && bestApp) {
      recommendedBadge.textContent = `★ ${DICT.bestChoiceBadge}: ${bestApp.name}`;
    }

    // Current appliance summary
    if (applianceSummaryEl && app) {
      applianceSummaryEl.textContent = app.summary;
    }

    // Find task specific stats for current appliance
    const taskOption = task.applianceOptions.find(o => o.applianceId === currentApplianceId) || task.applianceOptions[0];
    const bestOption = task.applianceOptions.find(o => o.applianceId === task.bestApplianceId) || task.applianceOptions[0];

    const kwh = taskOption.kwhConsumed;
    const duration = taskOption.durationMinutes;
    const eff = taskOption.efficiencyPct;

    // Cost & Carbon calculations
    let cost = 0;
    if (app.fuel === 'natural_gas') {
      cost = kwh * region.gasPriceEqUSD;
    } else {
      cost = kwh * region.electricityPriceUSD;
    }

    let carbonGrams = 0;
    if (app.fuel === 'natural_gas') {
      // Natural gas combustion: ~205 g CO2eq/kWh eq
      carbonGrams = kwh * 205;
    } else {
      carbonGrams = kwh * region.emissionFactorGramsCO2PerKWh;
    }

    // Update live metric cards
    if (statEnergyKwh) statEnergyKwh.textContent = `${kwh.toFixed(3)} kWh`;
    if (statCostMeal) statCostMeal.textContent = `${region.currencySymbol}${cost.toFixed(3)}`;
    if (statCarbonMeal) statCarbonMeal.textContent = `${carbonGrams.toFixed(1)} g CO₂`;
    if (statCookTime) statCookTime.textContent = `${duration.toFixed(1)} min`;

    // Efficiency Gauge
    const circumference = 314.159; // 2 * pi * 50
    const offset = circumference - (eff / 100) * circumference;
    if (gaugeCircle) {
      gaugeCircle.style.strokeDashoffset = offset.toString();
      if (eff >= 80) {
        gaugeCircle.style.stroke = '#059669'; // Emerald
      } else if (eff >= 60) {
        gaugeCircle.style.stroke = '#2563eb'; // Blue
      } else if (eff >= 40) {
        gaugeCircle.style.stroke = '#d97706'; // Amber
      } else {
        gaugeCircle.style.stroke = '#dc2626'; // Red
      }
    }
    if (gaugePercent) gaugePercent.textContent = `${eff}%`;

    // Efficiency Grade Badge
    if (efficiencyGradeBadge) {
      efficiencyGradeBadge.textContent = app.energyStarGrade;
      if (eff >= 80) {
        efficiencyGradeBadge.className = 'font-mono text-xs px-2.5 py-0.5 rounded-full font-bold bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300';
      } else if (eff >= 50) {
        efficiencyGradeBadge.className = 'font-mono text-xs px-2.5 py-0.5 rounded-full font-bold bg-blue-100 text-blue-800 dark:bg-blue-950 dark:text-blue-300';
      } else {
        efficiencyGradeBadge.className = 'font-mono text-xs px-2.5 py-0.5 rounded-full font-bold bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300';
      }
    }

    // Verdict text & banner
    if (verdictText && verdictBanner) {
      if (eff >= 80) {
        verdictText.textContent = "High-Efficiency Thermal Transfer — Minimal Heat Loss";
        verdictBanner.className = "w-full p-3.5 rounded-xl text-center text-xs font-semibold mt-2 border transition-all bg-emerald-50 text-emerald-900 border-emerald-200 dark:bg-emerald-950/60 dark:text-emerald-200 dark:border-emerald-800";
      } else if (eff >= 50) {
        verdictText.textContent = "Moderate Energy Transfer — Acceptable Convection / Conduction";
        verdictBanner.className = "w-full p-3.5 rounded-xl text-center text-xs font-semibold mt-2 border transition-all bg-blue-50 text-blue-900 border-blue-200 dark:bg-blue-950/60 dark:text-blue-200 dark:border-blue-800";
      } else {
        verdictText.textContent = "High Thermal Waste — Majority of Energy Escapes into Ambient Air";
        verdictBanner.className = "w-full p-3.5 rounded-xl text-center text-xs font-semibold mt-2 border transition-all bg-amber-50 text-amber-900 border-amber-200 dark:bg-amber-950/60 dark:text-amber-200 dark:border-amber-800";
      }
    }

    // Indoor Air Quality
    if (statAirQuality && airQualityIcon) {
      if (app.fuel === 'natural_gas') {
        statAirQuality.textContent = DICT.airQualityHazard;
        airQualityIcon.textContent = "!";
        airQualityIcon.className = "w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300";
      } else {
        statAirQuality.textContent = DICT.airQualityClean;
        airQualityIcon.textContent = "✓";
        airQualityIcon.className = "w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300";
      }
    }

    // Matrix Table Populate
    if (matrixTaskSubtitle) matrixTaskSubtitle.textContent = task.title;
    if (matrixBody) {
      matrixBody.innerHTML = '';
      task.applianceOptions.forEach(opt => {
        const itemApp = getAppliance(opt.applianceId);
        if (!itemApp) return;

        const isCurrent = opt.applianceId === currentApplianceId;
        const isBest = opt.applianceId === task.bestApplianceId;

        const row = document.createElement('tr');
        row.className = isCurrent 
          ? 'bg-emerald-50/70 dark:bg-emerald-950/30 font-semibold' 
          : 'hover:bg-surface-soft/60 transition-colors';

        let rowCost = 0;
        let rowCarbon = 0;
        if (itemApp.fuel === 'natural_gas') {
          rowCost = opt.kwhConsumed * region.gasPriceEqUSD;
          rowCarbon = opt.kwhConsumed * 205;
        } else {
          rowCost = opt.kwhConsumed * region.electricityPriceUSD;
          rowCarbon = opt.kwhConsumed * region.emissionFactorGramsCO2PerKWh;
        }

        row.innerHTML = `
          <td class="py-3 px-4">
            <div class="flex items-center gap-2">
              <span class="text-ink">${itemApp.name}</span>
              ${isBest ? `<span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-emerald-600 text-white">${DICT.bestChoiceBadge}</span>` : ''}
              ${isCurrent ? `<span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-ink text-surface">${DICT.selectedBadge}</span>` : ''}
            </div>
            <div class="text-[11px] text-muted font-normal mt-0.5">${opt.notes}</div>
          </td>
          <td class="py-3 px-3 font-mono text-ink">${opt.durationMinutes} min</td>
          <td class="py-3 px-3 font-mono text-ink">${opt.kwhConsumed.toFixed(3)}</td>
          <td class="py-3 px-3 font-mono text-ink">${region.currencySymbol}${rowCost.toFixed(3)}</td>
          <td class="py-3 px-3 font-mono text-ink">${rowCarbon.toFixed(1)} g</td>
          <td class="py-3 px-3 font-mono">
            <span class="px-2 py-0.5 rounded font-bold ${opt.efficiencyPct >= 80 ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300' : opt.efficiencyPct >= 50 ? 'bg-blue-100 text-blue-800 dark:bg-blue-950 dark:text-blue-300' : 'bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300'}">
              ${opt.efficiencyPct}%
            </span>
          </td>
        `;
        matrixBody.appendChild(row);
      });
    }

    // Annual Projection calculations (comparing current appliance vs best appliance)
    const kwhDifference = Math.max(0, kwh - bestOption.kwhConsumed);
    const annualKwhSaved = kwhDifference * currentFrequency;

    let costDifference = 0;
    let carbonDifference = 0;

    let currentCost = app.fuel === 'natural_gas' ? kwh * region.gasPriceEqUSD : kwh * region.electricityPriceUSD;
    let bestCost = bestApp.fuel === 'natural_gas' ? bestOption.kwhConsumed * region.gasPriceEqUSD : bestOption.kwhConsumed * region.electricityPriceUSD;
    costDifference = Math.max(0, currentCost - bestCost);
    const annualMoneySaved = costDifference * currentFrequency;

    let currentCarbonG = app.fuel === 'natural_gas' ? kwh * 205 : kwh * region.emissionFactorGramsCO2PerKWh;
    let bestCarbonG = bestApp.fuel === 'natural_gas' ? bestOption.kwhConsumed * 205 : bestOption.kwhConsumed * region.emissionFactorGramsCO2PerKWh;
    carbonDifference = Math.max(0, currentCarbonG - bestCarbonG);
    const annualKgCO2Saved = (carbonDifference * currentFrequency) / 1000;

    // Equivalencies (EPA formulas)
    const milesDriven = annualKgCO2Saved * 2.5; // 1 kg CO2 ≈ 2.5 miles passenger car
    const treesGrown = annualKgCO2Saved / 22; // 1 urban tree sequesters ~22 kg CO2/year
    const phonesCharged = Math.round(annualKgCO2Saved * 121); // 1 kg CO2 ≈ 121 smartphone charges

    if (annualMoneyEl) annualMoneyEl.textContent = `${region.currencySymbol}${annualMoneySaved.toFixed(2)}`;
    if (annualCarbonEl) annualCarbonEl.textContent = `${annualKgCO2Saved.toFixed(1)} kg`;
    if (annualKwhEl) annualKwhEl.textContent = `${annualKwhSaved.toFixed(0)} kWh`;
    if (annualMilesEl) annualMilesEl.textContent = `${Math.round(milesDriven)} mi`;
    if (annualTreesEl) annualTreesEl.textContent = `${treesGrown.toFixed(1)} trees`;
    if (annualPhonesEl) annualPhonesEl.textContent = `${phonesCharged.toLocaleString()}x`;

    if (annualSubtitleEl) {
      if (currentApplianceId === task.bestApplianceId) {
        annualSubtitleEl.textContent = `You are already using the most efficient appliance (${bestApp.name})! Displaying lifetime annual benchmarks.`;
      } else {
        annualSubtitleEl.textContent = `Projected annual savings by switching from ${app.name} to ${bestApp.name} (${currentFrequency}x/year).`;
      }
    }
  }

  // Event Listeners
  if (taskSelect) {
    taskSelect.addEventListener('change', function(e) {
      currentTaskId = e.target.value;
      syncApplianceDropdown();
      update();
    });
  }

  if (applianceSelect) {
    applianceSelect.addEventListener('change', function(e) {
      currentApplianceId = e.target.value;
      update();
    });
  }

  if (regionSelect) {
    regionSelect.addEventListener('change', function(e) {
      currentRegionId = e.target.value;
      update();
    });
  }

  freqButtons.forEach(btn => {
    btn.addEventListener('click', function() {
      freqButtons.forEach(b => {
        b.classList.remove('active', 'bg-emerald-600', 'text-white');
        b.classList.add('bg-surface-soft', 'text-ink');
      });
      this.classList.add('active', 'bg-emerald-600', 'text-white');
      this.classList.remove('bg-surface-soft', 'text-ink');
      currentFrequency = parseInt(this.getAttribute('data-freq') || '365', 10);
      update();
    });
  });

  // Initial Boot
  syncApplianceDropdown();
  update();
})();
</script>
