<script define:vars={{ dryerData }}>
  (function() {
    const container = document.getElementById('spray-dryer-modeler-container');
    if (!container) return;

    // Controls
    const dryerSelect = document.getElementById('dryer-select');
    const feedSelect = document.getElementById('feed-select');
    const safetySelect = document.getElementById('safety-select');
    const rpmSlider = document.getElementById('rpm-slider');
    const rpmVal = document.getElementById('rpm-val');
    const tempSlider = document.getElementById('temp-slider');
    const tempVal = document.getElementById('temp-val');
    const feedRateSlider = document.getElementById('feed-rate-slider');
    const feedRateVal = document.getElementById('feed-rate-val');
    const depositSlider = document.getElementById('deposit-slider');
    const depositVal = document.getElementById('deposit-val');
    const hoursSlider = document.getElementById('hours-slider');
    const hoursVal = document.getElementById('hours-val');
    const knockersToggle = document.getElementById('knockers-toggle');
    const coToggle = document.getElementById('co-toggle');
    const copyBtn = document.getElementById('copy-report-btn');
    const copyText = document.getElementById('copy-text');

    // Outputs
    const valTipSpeed = document.getElementById('val-tip-speed');
    const subTipSpeed = document.getElementById('sub-tip-speed');
    const valDropletSize = document.getElementById('val-droplet-size');
    const subDropletSize = document.getElementById('sub-droplet-size');
    const valFlightTime = document.getElementById('val-flight-time');
    const subFlightTime = document.getElementById('sub-flight-time');
    const valDryTime = document.getElementById('val-dry-time');
    const subDryTime = document.getElementById('sub-dry-time');
    const valWallDep = document.getElementById('val-wall-dep');
    const subWallDep = document.getElementById('sub-wall-dep');
    const valStickyDelta = document.getElementById('val-sticky-delta');
    const subStickyDelta = document.getElementById('sub-sticky-delta');
    const valScorchRisk = document.getElementById('val-scorch-risk');
    const subScorchRisk = document.getElementById('sub-scorch-risk');
    const valCoLevel = document.getElementById('val-co-level');
    const subCoLevel = document.getElementById('sub-co-level');
    const safetyBadge = document.getElementById('safety-badge');
    const statusDot = document.getElementById('status-indicator-dot');
    const headlineEl = document.getElementById('narrative-headline');
    const bodyEl = document.getElementById('narrative-body');
    const mechEl = document.getElementById('narrative-mechanisms');
    const mitEl = document.getElementById('narrative-mitigation');

    function calculateTelemetry() {
      const dryerId = dryerSelect.value;
      const feedId = feedSelect.value;
      const safetyId = safetySelect.value;

      const dryer = dryerData.dryerArchitectures.find(d => d.id === dryerId) || dryerData.dryerArchitectures[1];
      const feed = dryerData.feedstockProfiles.find(f => f.id === feedId) || dryerData.feedstockProfiles[0];
      const safety = dryerData.safetySystems.find(s => s.id === safetyId) || dryerData.safetySystems[0];

      const rpm = parseFloat(rpmSlider.value);
      const inletTemp = parseFloat(tempSlider.value);
      const feedRate = parseFloat(feedRateSlider.value);
      const depositMm = parseFloat(depositSlider.value);
      const hours = parseFloat(hoursSlider.value);
      const knockersActive = knockersToggle.checked;
      const coActive = coToggle.checked;

      // Update slider labels
      rpmVal.textContent = `${rpm.toLocaleString()} RPM`;
      tempVal.textContent = `${inletTemp} °C`;
      feedRateVal.textContent = `${feedRate.toLocaleString()} kg/h`;
      depositVal.textContent = `${depositMm.toFixed(1)} mm`;
      hoursVal.textContent = `${hours} Hours`;

      // 1. Tip speed: v = pi * D_wheel * RPM / 60
      const wheelDiameterM = (dryer.wheelDiameterMm || 180) / 1000;
      const tipSpeed = (Math.PI * wheelDiameterM * rpm) / 60; // m/s
      valTipSpeed.textContent = `${tipSpeed.toFixed(1)} m/s`;
      const machNumber = tipSpeed / 343;
      subTipSpeed.textContent = `Sonic Mach ~${machNumber.toFixed(2)} (${tipSpeed > 150 ? 'High Shear' : 'Moderate Shear'})`;

      // 2. Sauter Mean Droplet Diameter Dv50 (approximate Dombrowski-Masters correlation)
      // Dv50 proportional to (feedRate / rpm^0.8 * (viscosity^0.1))
      const baseDiameter = 70; // microns
      const rpmFactor = Math.pow(18000 / rpm, 0.85);
      const feedFactor = Math.pow(feedRate / (dryer.maxEvaporationKgH || 1000), 0.22);
      const viscFactor = Math.pow(feed.feedViscosityCp / 50, 0.15);
      const dv50 = Math.max(20, Math.min(180, Math.round(baseDiameter * rpmFactor * feedFactor * viscFactor)));
      valDropletSize.textContent = `${dv50} μm`;
      const dv10 = Math.round(dv50 * 0.45);
      const dv90 = Math.round(dv50 * 1.85);
      subDropletSize.textContent = `Dv10: ${dv10} μm | Dv90: ${dv90} μm`;

      // 3. Radial flight time to chamber wall: t_flight = (R_chamber - R_wheel) / v_radial
      const chamberRadius = (dryer.chamberDiameterM || 4.5) / 2;
      const radialDistance = chamberRadius - (wheelDiameterM / 2);
      // radial velocity decelerates exponentially due to aerodynamic drag
      // average radial drift velocity ~ tipSpeed * 0.08 / air swirl
      const vRadialAvg = Math.max(1.2, tipSpeed * 0.035);
      const flightTime = Math.max(0.15, radialDistance / vRadialAvg);
      valFlightTime.textContent = `${flightTime.toFixed(2)} s`;
      subFlightTime.textContent = `Chamber Radius: ${chamberRadius.toFixed(2)} m (Distance: ${radialDistance.toFixed(2)} m)`;

      // 4. Droplet Surface Drying Time (Skin crusting time)
      // t_dry is proportional to (dv50^1.8) / (inletTemp - wetBulbTemp)
      const wetBulb = 48 + (feed.solidsContentPercent * 0.2); // approx wet bulb in spray dryer
      const tempDelta = Math.max(40, inletTemp - wetBulb);
      const dryTime = (Math.pow(dv50 / 50, 1.7) * 22) / tempDelta;
      valDryTime.textContent = `${dryTime.toFixed(2)} s`;
      subDryTime.textContent = `Wet Bulb Core: ~${wetBulb.toFixed(0)}°C (Temp Drive: ${tempDelta.toFixed(0)}°C)`;

      // 5. Wall Deposition Impingement Ratio
      // Ratio = dryTime / flightTime. If > 1.0, droplet is still wet and sticky when impacting the wall!
      const depRatio = dryTime / flightTime;
      valWallDep.textContent = `${depRatio.toFixed(2)} (${depRatio > 1.05 ? 'High Wall Risk' : depRatio > 0.85 ? 'Borderline' : 'Low Risk'})`;
      if (depRatio > 1.05) {
        valWallDep.className = 'text-lg font-mono font-extrabold text-red-600 dark:text-red-400';
        subWallDep.textContent = 'Droplet Hits Wall BEFORE Surface Dries';
      } else if (depRatio > 0.85) {
        valWallDep.className = 'text-lg font-mono font-extrabold text-amber-600 dark:text-amber-400';
        subWallDep.textContent = 'Semi-Dry Droplets Touch Air Veil Edge';
      } else {
        valWallDep.className = 'text-lg font-mono font-extrabold text-emerald-600 dark:text-emerald-400';
        subWallDep.textContent = 'Dries Before Impinging Wall';
      }

      // 6. Sticky Point Thermal Margin: Droplet Surface Temp vs Sticky Point
      // When wet droplet dries, its surface temp rises from wetBulb towards outlet air temp (~85-95°C)
      const estimatedSurfaceTemp = wetBulb + (tempDelta * Math.min(1.0, flightTime / dryTime) * 0.4);
      const stickyMargin = estimatedSurfaceTemp - feed.stickyPointTempC;
      valStickyDelta.textContent = `${stickyMargin >= 0 ? '+' : ''}${stickyMargin.toFixed(1)} °C`;
      if (stickyMargin > 5) {
        valStickyDelta.className = 'text-lg font-mono font-extrabold text-red-600 dark:text-red-400';
        subStickyDelta.textContent = `Above Sticky Point (${feed.stickyPointTempC}°C) - Sticky Adhesion`;
      } else if (stickyMargin > 0) {
        valStickyDelta.className = 'text-lg font-mono font-extrabold text-amber-600 dark:text-amber-400';
        subStickyDelta.textContent = `At Sticky Threshold (${feed.stickyPointTempC}°C)`;
      } else {
        valStickyDelta.className = 'text-lg font-mono font-extrabold text-ink';
        subStickyDelta.textContent = `Below Sticky Point (${feed.stickyPointTempC}°C)`;
      }

      // 7. Deposit Layer Scorching & Smoldering Risk (0 to 100 index)
      // Driven by deposit thickness, inlet air temp, dwell hours, and knockers active
      let effectiveDeposit = depositMm;
      if (knockersActive) {
        effectiveDeposit = Math.max(0.5, effectiveDeposit * 0.35); // knockers prevent thick cake
      }
      const thermalFactor = Math.pow(Math.max(1.0, inletTemp / 180), 2.2);
      const timeFactor = Math.log10(hours + 1) * 1.5;
      const cakeFactor = effectiveDeposit * 3.5;
      let scorchIndex = Math.min(100, Math.round(cakeFactor * thermalFactor * timeFactor));
      if (dryerId === 'compromised_aging_dryer') scorchIndex = Math.min(100, scorchIndex + 25);

      valScorchRisk.textContent = `${scorchIndex} / 100 (${scorchIndex >= 70 ? 'CRITICAL CHAR' : scorchIndex >= 40 ? 'ELEVATED' : 'MINIMAL'})`;
      if (scorchIndex >= 70) {
        valScorchRisk.className = 'text-lg font-mono font-extrabold text-red-600 dark:text-red-400';
        subScorchRisk.textContent = `Self-Heating Smolder (Thickness: ${effectiveDeposit.toFixed(1)} mm)`;
      } else if (scorchIndex >= 40) {
        valScorchRisk.className = 'text-lg font-mono font-extrabold text-amber-600 dark:text-amber-400';
        subScorchRisk.textContent = `Maillard Caramelization Accelerated`;
      } else {
        valScorchRisk.className = 'text-lg font-mono font-extrabold text-ink';
        subScorchRisk.textContent = `Deposit Dwell: ${hours}h | Stable Cake`;
      }

      // 8. Predicted Exhaust CO Level (PPM)
      // Normal background: 0.8 - 2.0 ppm. Smoldering deposit releases CO.
      let coPpm = 1.0 + (scorchIndex / 100) * 28;
      if (!coActive) {
        // sensor turned off, can't measure
        valCoLevel.textContent = `UNMONITORED (${coPpm.toFixed(1)} ppm)`;
        valCoLevel.className = 'text-lg font-mono font-extrabold text-red-600 dark:text-red-400';
        subCoLevel.textContent = 'Blind to Internal Smoldering Embers!';
      } else {
        valCoLevel.textContent = `${coPpm.toFixed(1)} ppm`;
        if (coPpm >= 15) {
          valCoLevel.className = 'text-lg font-mono font-extrabold text-red-600 dark:text-red-400';
          subCoLevel.textContent = 'ALARM: Smoldering Fire Embers Detected!';
        } else if (coPpm >= 5) {
          valCoLevel.className = 'text-lg font-mono font-extrabold text-amber-600 dark:text-amber-400';
          subCoLevel.textContent = 'WARNING: Deposit Thermal Off-Gassing';
        } else {
          valCoLevel.className = 'text-lg font-mono font-extrabold text-ink';
          subCoLevel.textContent = 'Normal Clean Combustion Baseline';
        }
      }

      // 9. Overall Safety Status & Narrative Evaluation
      let status = 'OPTIMAL';
      let headline = 'AEROSOL ATOMIZATION & THERMAL CLEARANCE OPTIMAL';
      let bodyText = `The rotary atomizer wheel operates with an expansive peripheral velocity of ${tipSpeed.toFixed(1)} m/s, delivering high centrifugal shear that atomizes feed droplets down to Dv50 = ${dv50} μm. Radial flight trajectory confirms droplet surfaces solidify in ${dryTime.toFixed(2)}s, well before reaching the chamber wall (${flightTime.toFixed(2)}s). Deposit accumulation remains below self-heating thresholds with active pneumatic knockers.`;
      let mechText = `Rapid moisture evaporation keeps wet bulb droplet core temperature below ${wetBulb.toFixed(0)}°C, safely below the ${feed.stickyPointTempC}°C sticky threshold.`;
      let mitText = `Maintain programmed 15-minute interval pneumatic wall knocker strikes and verify dual CO infrared sensor calibration under NFPA 652 and 3-A Sanitary standard 607-05.`;

      if (scorchIndex >= 70 || (coPpm >= 15 && !coActive) || depRatio > 1.25 || dryerId === 'compromised_aging_dryer') {
        status = 'CATASTROPHIC_HAZARD';
        headline = '🚨 DANGER: SEVERE WALL CAKE SCORCHING & COMBUSTIBLE DUST DEFLAGRATION HAZARD';
        bodyText = `Severe operational imbalance detected: Atomizer wheel speed is insufficient to disperse droplets prior to chamber wall impact (flight time ${flightTime.toFixed(2)}s < dry time ${dryTime.toFixed(2)}s). Thick insulating product deposits (${depositMm} mm) under ${inletTemp}°C inlet air have entered exothermic self-heating runaway, releasing combustible volatiles and dangerous CO gas (${coPpm.toFixed(1)} ppm). Any glowing ember dislodged into the air stream risks triggering a dust cloud explosion (Kst = ${feed.combustibleDustKst} bar·m/s).`;
        mechText = `Insulating wall cake undergoes Frank-Kamenetskii pyrophoric thermal explosion. Lack of automated clearing produces glowing char capable of igniting St 1 combustible dust clouds.`;
        mitText = `Trip emergency interlock: Instantly cut liquid concentrate feed, activate high-rate nitrogen inerting or NFPA 69 chemical suppressor cannons, and shut down drying air fans. Execute complete chamber washdown.`;

        safetyBadge.textContent = 'CRITICAL_FIRE_EXPLOSION_HAZARD';
        safetyBadge.className = 'px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-red-500/10 text-red-600 dark:text-red-400 border border-red-500/20';
        statusDot.className = 'w-2.5 h-2.5 rounded-full bg-red-500';
      } else if (scorchIndex >= 40 || depRatio > 0.95 || stickyMargin > 0 || !knockersActive || !coActive) {
        status = 'ELEVATED_RISK';
        headline = '⚠️ WARNING: ELEVATED WALL DEPOSITION & ACCELERATED CARAMELIZATION';
        bodyText = `Process margins are constricted: Droplets land near the chamber boundary while surface moisture remains elevated. The product surface temperature approaches or exceeds the sticky point (${feed.stickyPointTempC}°C), accelerating wall cake formation. Without active pneumatic knockers or continuous CO telemetry, deposit self-heating will progress into smoldering char.`;
        mechText = `Droplet impingement occurs in the sticky rubbery zone (T > Tg + 15°C). Wall deposition rate increases linearly, forming a thermal barrier that traps heat.`;
        mitText = `Increase rotary atomizer speed by 1,500-2,500 RPM, reduce feed flow rate by 15%, re-engage pneumatic wall knockers, and inspect exhaust CO spectrometer optics.`;

        safetyBadge.textContent = 'ELEVATED_PROCESS_RISK';
        safetyBadge.className = 'px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20';
        statusDot.className = 'w-2.5 h-2.5 rounded-full bg-amber-500';
      } else {
        safetyBadge.textContent = 'STABLE_AERODYNAMIC_DRYING';
        safetyBadge.className = 'px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20';
        statusDot.className = 'w-2.5 h-2.5 rounded-full bg-emerald-500';
      }

      headlineEl.textContent = headline;
      bodyEl.textContent = bodyText;
      mechEl.textContent = mechText;
      mitEl.textContent = mitText;
    }

    // Event Listeners for Controls
    [dryerSelect, feedSelect, safetySelect, rpmSlider, tempSlider, feedRateSlider, depositSlider, hoursSlider, knockersToggle, coToggle].forEach(el => {
      el.addEventListener('input', calculateTelemetry);
      el.addEventListener('change', calculateTelemetry);
    });

    // Preset Buttons
    const presetButtons = container.querySelectorAll('.preset-btn');
    presetButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const p = btn.getAttribute('data-preset');
        if (p === 'milk') {
          dryerSelect.value = 'dairy_tall_form_industrial';
          feedSelect.value = 'whole_milk_infant_formula';
          safetySelect.value = 'full_nfpa_suppression';
          rpmSlider.value = '18000';
          tempSlider.value = '195';
          feedRateSlider.value = '1200';
          depositSlider.value = '3';
          hoursSlider.value = '12';
          knockersToggle.checked = true;
          coToggle.checked = true;
        } else if (p === 'whey') {
          dryerSelect.value = 'dairy_tall_form_industrial';
          feedSelect.value = 'whey_protein_isolate';
          safetySelect.value = 'full_nfpa_suppression';
          rpmSlider.value = '20000';
          tempSlider.value = '165';
          feedRateSlider.value = '850';
          depositSlider.value = '2';
          hoursSlider.value = '8';
          knockersToggle.checked = true;
          coToggle.checked = true;
        } else if (p === 'malto') {
          dryerSelect.value = 'infant_formula_hygienic';
          feedSelect.value = 'maltodextrin_starch_carrier';
          safetySelect.value = 'full_nfpa_suppression';
          rpmSlider.value = '22000';
          tempSlider.value = '210';
          feedRateSlider.value = '2200';
          depositSlider.value = '4';
          hoursSlider.value = '16';
          knockersToggle.checked = true;
          coToggle.checked = true;
        } else if (p === 'catastrophic') {
          dryerSelect.value = 'compromised_aging_dryer';
          feedSelect.value = 'fruit_juice_glucose_fructose';
          safetySelect.value = 'compromised_uninspected';
          rpmSlider.value = '9500';
          tempSlider.value = '235';
          feedRateSlider.value = '1600';
          depositSlider.value = '28';
          hoursSlider.value = '36';
          knockersToggle.checked = false;
          coToggle.checked = false;
        }
        calculateTelemetry();
      });
    });

    // Copy Telemetry Report
    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        const reportText = `======================================================================
ISITKITCHENSAFE SPRAY DRYER ROTARY ATOMIZER TELEMETRY REPORT
======================================================================
Timestamp: ${new Date().toISOString()}
Dryer Architecture: ${dryerSelect.value}
Feedstock Profile: ${feedSelect.value}
Safety Mitigation Suite: ${safetySelect.value}

OPERATING PARAMETERS:
- Rotary Atomizer Speed: ${rpmSlider.value} RPM
- Inlet Hot Air Temperature: ${tempSlider.value} °C
- Liquid Concentrate Feed Rate: ${feedRateSlider.value} kg/h
- Wall Deposit Cake Thickness: ${depositSlider.value} mm
- Continuous Run Duration: ${hoursSlider.value} Hours
- Pneumatic Wall Knockers Active: ${knockersToggle.checked ? 'YES' : 'NO'}
- Continuous Exhaust CO Monitoring: ${coToggle.checked ? 'YES' : 'NO'}

AERODYNAMIC & SAFETY TELEMETRY:
- Wheel Peripheral Tip Speed: ${valTipSpeed.textContent}
- Sauter Mean Droplet Size (Dv50): ${valDropletSize.textContent}
- Wall Flight Transit Time: ${valFlightTime.textContent}
- Droplet Skin Solidification Time: ${valDryTime.textContent}
- Wall Deposition Impingement Index: ${valWallDep.textContent}
- Sticky Point Thermal Delta: ${valStickyDelta.textContent}
- Deposit Scorching & Self-Heating Index: ${valScorchRisk.textContent}
- Predicted Exhaust CO Level: ${valCoLevel.textContent}
- Safety & Compliance Status: ${safetyBadge.textContent}

DIAGNOSTIC SUMMARY:
${headlineEl.textContent}
${bodyEl.textContent}

ENGINEERING DIRECTIVE:
${mitEl.textContent}
======================================================================`;

        navigator.clipboard.writeText(reportText).then(() => {
          const original = copyText.textContent;
          copyText.textContent = 'Copied!';
          setTimeout(() => {
            copyText.textContent = original;
          }, 2000);
        });
      });
    }

    // Initial run
    calculateTelemetry();
  })();
</script>
