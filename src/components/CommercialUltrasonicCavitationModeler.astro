            <!-- Submerged Cookware Pan Target -->
            <g id="svg-cookware" transform="translate(140, 85)">
              <rect x="0" y="10" width="120" height="25" rx="3" fill="#cbd5e1" stroke="#334155" stroke-width="2" id="svg-cookware-body" />
              <line x1="120" y1="18" x2="160" y2="8" stroke="#475569" stroke-width="5" stroke-linecap="round" />
              <text x="60" y="27" fill="#0f172a" font-size="9" font-family="sans-serif" font-weight="bold" text-anchor="middle" id="svg-cookware-label">
                316L Cookware
              </text>
            </g>

            <!-- Cavitation Bubbles & Micro-jets -->
            <g id="svg-cavitation-cloud">
              <circle cx="100" cy="160" r="3" fill="#ffffff" opacity="0.8" />
              <circle cx="160" cy="140" r="4" fill="#ffffff" opacity="0.9" />
              <circle cx="210" cy="170" r="5" fill="#facc15" opacity="0.95" id="svg-hotspot-bubble" />
              <circle cx="240" cy="130" r="3" fill="#ffffff" opacity="0.85" />
              <circle cx="290" cy="165" r="4" fill="#ffffff" opacity="0.8" />
              <circle cx="180" cy="180" r="3.5" fill="#ffffff" opacity="0.85" />
            </g>

            <!-- Transducer Array Under Basin -->
            <g id="svg-transducer-array">
              <!-- Transducer 1 -->
              <rect x="75" y="210" width="50" height="20" rx="2" fill="#64748b" stroke="#38bdf8" stroke-width="1.5" id="svg-transducer-1" />
              <rect x="80" y="207" width="40" height="3" fill="#10b981" id="svg-bond-1" />
              <!-- Transducer 2 (Center) -->
              <rect x="175" y="210" width="50" height="20" rx="2" fill="#64748b" stroke="#38bdf8" stroke-width="1.5" id="svg-transducer-2" />
              <rect x="180" y="207" width="40" height="3" fill="#10b981" id="svg-bond-2" />
              <!-- Transducer 3 -->
              <rect x="275" y="210" width="50" height="20" rx="2" fill="#64748b" stroke="#38bdf8" stroke-width="1.5" id="svg-transducer-3" />
              <rect x="280" y="207" width="40" height="3" fill="#10b981" id="svg-bond-3" />
            </g>

            <!-- Basin Wall Pitting Indicators -->
            <g id="svg-erosion-pits">
              <circle cx="195" cy="207" r="1.5" fill="#ef4444" id="pit-1" />
              <circle cx="205" cy="207" r="1.8" fill="#ef4444" id="pit-2" />
            </g>

            <!-- Technical Legend -->
            <text x="50" y="47" fill="#38bdf8" font-size="8" font-family="monospace">Liquid: 55°C | pH 10.8</text>
            <text x="345" y="47" fill="#cbd5e1" font-size="8" font-family="monospace" text-anchor="end" id="svg-freq-text">40 kHz &plusmn;1.5 kHz</text>
            <text x="200" y="245" fill="#94a3b8" font-size="8" font-family="sans-serif" text-anchor="middle">
              Langevin PZT-8 Transducer Array &bull; Epoxy Bondline
            </text>
            <text x="200" y="265" fill="#facc15" font-size="9" font-family="monospace" font-weight="bold" text-anchor="middle" id="svg-shockwave-text">
              Peak Shockwave: 1,420 bar | Micro-jet: 450 m/s
            </text>
          </svg>
        </div>

        <!-- Telemetry Pill Summaries -->
        <div class="grid grid-cols-2 gap-2 text-xs font-mono mt-3">
          <div class="bg-surface p-2 rounded-lg border border-hairline/80">
            <span class="text-muted block text-[10px]">Acoustic Micro-Jet:</span>
            <span id="telemetry-jet-speed" class="font-bold text-ink">450 m/s</span>
          </div>
          <div class="bg-surface p-2 rounded-lg border border-hairline/80">
            <span class="text-muted block text-[10px]">Epoxy Bond Shear:</span>
            <span id="telemetry-bond-shear" class="font-bold text-ink">4.2 MPa (Safe)</span>
          </div>
          <div class="bg-surface p-2 rounded-lg border border-hairline/80">
            <span class="text-muted block text-[10px]">Reflected Power:</span>
            <span id="telemetry-reflected-power" class="font-bold text-ink">&lt; 3.0% (Matched)</span>
          </div>
          <div class="bg-surface p-2 rounded-lg border border-hairline/80">
            <span class="text-muted block text-[10px]">Basin Metal Loss:</span>
            <span id="telemetry-metal-loss" class="font-bold text-ink">0.08 mm (3.2%)</span>
          </div>
        </div>
      </div>

      <!-- Quick Action: Copy Report -->
      <div class="mt-4 pt-3 border-t border-hairline/80">
        <button 
          type="button" 
          id="copy-report-btn"
          class="w-full py-2.5 px-4 rounded-xl text-xs font-semibold bg-violet-700 hover:bg-violet-800 text-white transition-colors flex items-center justify-center gap-2 shadow-xs cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
          </svg>
          <span id="copy-btn-text">{d.copyReportBtn}</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Live Diagnostic Gauges (6 Grid Cards) -->
  <div class="border-t border-hairline/60 pt-8 mb-8">
    <div class="mb-6">
      <h3 class="text-title-md font-semibold text-ink">{d.diagnosticTitle}</h3>
      <p class="text-xs text-muted">{d.diagnosticSub}</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <!-- 1. Cavitation Shockwave Intensity -->
      <div class="bg-surface-soft border border-hairline rounded-2xl p-4 flex flex-col justify-between shadow-2xs">
        <div>
          <span class="text-xs font-semibold text-muted block mb-1">{d.shockwaveIntensityLabel}</span>
          <div class="flex items-baseline gap-2 mb-2">
            <span id="gauge-shockwave-val" class="text-2xl font-bold font-mono text-ink">1,420 bar</span>
            <span id="gauge-shockwave-sub" class="text-xs text-muted font-mono">(142 MPa)</span>
          </div>
          <div class="w-full bg-hairline rounded-full h-2 overflow-hidden mb-2">
            <div id="gauge-shockwave-bar" class="h-full bg-violet-600 transition-all duration-300" style="width: 45%;"></div>
          </div>
        </div>
        <span id="gauge-shockwave-status" class="text-[11px] font-bold text-violet-700 bg-violet-50 px-2 py-0.5 rounded self-start">
          Energetic Transient Cavitation
        </span>
      </div>

      <!-- 2. Basin Cavitation Pit Erosion Rate -->
      <div class="bg-surface-soft border border-hairline rounded-2xl p-4 flex flex-col justify-between shadow-2xs">
        <div>
          <span class="text-xs font-semibold text-muted block mb-1">{d.erosionRateLabel}</span>
          <div class="flex items-baseline gap-2 mb-2">
            <span id="gauge-erosion-val" class="text-2xl font-bold font-mono text-ink">32.5 µm</span>
            <span class="text-xs text-muted font-mono">/ 1,000 hrs</span>
          </div>
          <div class="w-full bg-hairline rounded-full h-2 overflow-hidden mb-2">
            <div id="gauge-erosion-bar" class="h-full bg-emerald-600 transition-all duration-300" style="width: 28%;"></div>
          </div>
        </div>
        <span id="gauge-erosion-status" class="text-[11px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded self-start">
          Low Pitting Wear (ASTM G32 Safe)
        </span>
      </div>

      <!-- 3. PZT Transducer Delamination Risk -->
      <div class="bg-surface-soft border border-hairline rounded-2xl p-4 flex flex-col justify-between shadow-2xs">
        <div>
          <span class="text-xs font-semibold text-muted block mb-1">{d.delaminationRiskLabel}</span>
          <div class="flex items-baseline gap-2 mb-2">
            <span id="gauge-delam-val" class="text-2xl font-bold font-mono text-ink">12%</span>
            <span id="gauge-delam-sub" class="text-xs text-muted font-mono">Fatigue Index</span>
          </div>
          <div class="w-full bg-hairline rounded-full h-2 overflow-hidden mb-2">
            <div id="gauge-delam-bar" class="h-full bg-emerald-600 transition-all duration-300" style="width: 12%;"></div>
          </div>
        </div>
        <span id="gauge-delam-status" class="text-[11px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded self-start">
          Bond Intact &bull; Stud Preloaded
        </span>
      </div>

      <!-- 4. Cleaning Efficacy Index -->
      <div class="bg-surface-soft border border-hairline rounded-2xl p-4 flex flex-col justify-between shadow-2xs">
        <div>
          <span class="text-xs font-semibold text-muted block mb-1">{d.cleaningEfficacyLabel}</span>
          <div class="flex items-baseline gap-2 mb-2">
            <span id="gauge-cleaning-val" class="text-2xl font-bold font-mono text-ink">94%</span>
            <span class="text-xs text-muted font-mono">Stripping Rate</span>
          </div>
          <div class="w-full bg-hairline rounded-full h-2 overflow-hidden mb-2">
            <div id="gauge-cleaning-bar" class="h-full bg-violet-600 transition-all duration-300" style="width: 94%;"></div>
          </div>
        </div>
        <span id="gauge-cleaning-status" class="text-[11px] font-bold text-violet-700 bg-violet-50 px-2 py-0.5 rounded self-start">
          Rapid Baked Grease Inversion
        </span>
      </div>

      <!-- 5. Scullery Acoustic Noise -->
      <div class="bg-surface-soft border border-hairline rounded-2xl p-4 flex flex-col justify-between shadow-2xs">
        <div>
          <span class="text-xs font-semibold text-muted block mb-1">{d.noiseLevelLabel}</span>
          <div class="flex items-baseline gap-2 mb-2">
            <span id="gauge-noise-val" class="text-2xl font-bold font-mono text-ink">76.5 dBA</span>
            <span class="text-xs text-muted font-mono">(1m Distance)</span>
          </div>
          <div class="w-full bg-hairline rounded-full h-2 overflow-hidden mb-2">
            <div id="gauge-noise-bar" class="h-full bg-emerald-600 transition-all duration-300" style="width: 48%;"></div>
          </div>
        </div>
        <span id="gauge-noise-status" class="text-[11px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded self-start">
          OSHA Safe (&lt; 85 dBA Action Level)
        </span>
      </div>

      <!-- 6. Basin Wall Lifespan -->
      <div class="bg-surface-soft border border-hairline rounded-2xl p-4 flex flex-col justify-between shadow-2xs">
        <div>
          <span class="text-xs font-semibold text-muted block mb-1">{d.basinLifespanLabel}</span>
          <div class="flex items-baseline gap-2 mb-2">
            <span id="gauge-lifespan-val" class="text-2xl font-bold font-mono text-ink">&gt; 12,000 hrs</span>
            <span class="text-xs text-muted font-mono">(~6.5 Yrs)</span>
          </div>
          <div class="w-full bg-hairline rounded-full h-2 overflow-hidden mb-2">
            <div id="gauge-lifespan-bar" class="h-full bg-emerald-600 transition-all duration-300" style="width: 85%;"></div>
          </div>
        </div>
        <span id="gauge-lifespan-status" class="text-[11px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded self-start">
          Nominal 2.5mm Wall Retention
        </span>
      </div>
    </div>
  </div>

  <!-- Compliance Callout & Actionable Root Cause Card -->
  <div id="compliance-card" class="bg-emerald-50/70 border border-emerald-200 rounded-2xl p-6 mb-8 transition-colors">
    <div class="flex items-center gap-3 mb-3">
      <span id="compliance-badge" class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-700 text-white">
        NSF/ANSI 3 &amp; IEC 61161 COMPLIANT
      </span>
      <span class="text-xs text-emerald-800 font-semibold">{d.complianceStatusLabel}</span>
    </div>

    <div class="space-y-3 text-xs sm:text-sm text-ink leading-relaxed">
      <div>
        <strong class="text-emerald-950 font-semibold">{d.primaryRiskLabel}</strong>
        <span id="callout-risk" class="ml-1 text-emerald-900">
          Controlled acoustic cavitation; acoustic sweep suppresses standing wave burns. Transducer epoxy shear fatigue remains well within safety envelope.
        </span>
      </div>
      <div>
        <strong class="text-emerald-950 font-semibold">{d.mechanismsLabel}</strong>
        <span id="callout-mechanisms" class="ml-1 text-emerald-900">
          Rayleigh-Plesset bubble collapse generates 1,420 bar localized shockwaves with micro-jets impinging at 450 m/s; silicate passivation inhibits intergranular caustic attack.
        </span>
      </div>
      <div>
        <strong class="text-emerald-950 font-semibold">{d.mitigationLabel}</strong>
        <span id="callout-mitigation" class="ml-1 text-emerald-900">
          Maintain bath temperature below 62°C to prevent thermal degradation of transducer bondlines; perform monthly reflected power impedance checks per IEC 61161.
        </span>
      </div>
    </div>
  </div>

  <!-- Scientific Reference Cards -->
  <div class="border-t border-hairline/60 pt-8 mb-8">
    <div class="mb-6">
      <h3 class="text-title-md font-semibold text-ink">{d.scienceTitle}</h3>
      <p class="text-xs text-muted">{d.scienceSub}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="bg-surface-soft/80 border border-hairline rounded-2xl p-5">
        <h4 class="text-sm font-bold text-ink uppercase tracking-wider mb-2 flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-violet-600"></span>
          Rayleigh-Plesset Acoustic Cavitation Dynamics
        </h4>
        <p class="text-xs text-body leading-relaxed mb-3">
          The non-linear expansion and inertial collapse of microscopic gas nuclei in an ultrasonic acoustic pressure field are governed by the Rayleigh-Plesset equation:
        </p>
        <div class="bg-surface p-3 rounded-xl border border-hairline font-mono text-[11px] text-ink overflow-x-auto mb-3">
          R&middot;R&uml; + (3/2)&middot;R&#775;&sup2; = (1/&rho;) &middot; [ p_B(R) - p_&infin;(t) - 2&sigma;/R - 4&mu;&middot;R&#775;/R ]
        </div>
        <p class="text-xs text-muted leading-relaxed">
          At 25 kHz, acoustic resonance produces larger equilibrium bubbles (R₀ &approx; 130 µm), collapsing violently with localized water-hammer impact pressures exceeding 2,500 bar. At 80 kHz, smaller bubbles (R₀ &approx; 40 µm) collapse with lower kinetic micro-jet velocity, minimizing metallurgical fatigue.
        </p>
      </div>

      <div class="bg-surface-soft/80 border border-hairline rounded-2xl p-5">
        <h4 class="text-sm font-bold text-ink uppercase tracking-wider mb-2 flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-violet-600"></span>
          Transducer Epoxy Shear Fatigue &amp; Delamination Mechanics
        </h4>
        <p class="text-xs text-body leading-relaxed mb-3">
          Piezoelectric PZT-8 ceramic discs oscillate longitudinally, imparting high-frequency cyclic shear stress (&tau;_bond) onto the basin bonding epoxy:
        </p>
        <div class="bg-surface p-3 rounded-xl border border-hairline font-mono text-[11px] text-ink overflow-x-auto mb-3">
          &tau;_bond = G_epoxy &middot; (&Delta;L / t_bond) &middot; [ 1 + &alpha;_thermal &middot; (T_bath - 25&deg;C) ]
        </div>
        <p class="text-xs text-muted leading-relaxed">
          When bath temperatures exceed 65°C, structural epoxies cross their glass transition threshold (T_g), causing polymer chain relaxation, acoustic impedance mismatch, and rapid resonant debonding (&gt;35% reflected electrical power).
        </p>
      </div>
    </div>
  </div>

  <!-- Architectures Technical Table -->
  <div class="border-t border-hairline/60 pt-8 mb-8">
    <div class="mb-4">
      <h3 class="text-title-md font-semibold text-ink">{d.tableTitle}</h3>
      <p class="text-xs text-muted">{d.tableSub}</p>
    </div>

    <div class="overflow-x-auto rounded-2xl border border-hairline">
      <table class="w-full text-left border-collapse text-xs">
        <thead>
          <tr class="bg-surface-soft border-b border-hairline text-ink font-semibold">
            <th class="p-3 sm:p-4">{d.colModel}</th>
            <th class="p-3 sm:p-4">{d.colClass}</th>
            <th class="p-3 sm:p-4">{d.colVolume}</th>
            <th class="p-3 sm:p-4">{d.colMetallurgy}</th>
            <th class="p-3 sm:p-4">{d.colTransducers}</th>
            <th class="p-3 sm:p-4">{d.colMounting}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline">
          {data.tankArchitectures.map((t) => (
            <tr class="hover:bg-surface-soft/50 transition-colors">
              <td class="p-3 sm:p-4 font-medium text-ink">{t.name}</td>
              <td class="p-3 sm:p-4 text-muted font-mono">{t.classification}</td>
              <td class="p-3 sm:p-4 text-ink font-mono">{t.workingVolumeLiters} L</td>
              <td class="p-3 sm:p-4 text-muted">{t.metallurgy}</td>
              <td class="p-3 sm:p-4 text-ink font-mono">{t.totalAcousticWatts} W</td>
              <td class="p-3 sm:p-4 text-muted">{t.transducerMounting}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Mandatory Regulatory Rules Grid (4 Rules) -->
  <div class="border-t border-hairline/60 pt-8">
    <div class="mb-6">
      <h3 class="text-title-md font-semibold text-ink">{d.rulesTitle}</h3>
      <p class="text-xs text-muted">{d.rulesSub}</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="bg-surface-soft/80 border border-hairline rounded-2xl p-4">
        <span class="text-xs font-bold text-violet-700 block mb-1">{d.rule1Title}</span>
        <p class="text-xs text-body leading-relaxed">{d.rule1Text}</p>
      </div>

      <div class="bg-surface-soft/80 border border-hairline rounded-2xl p-4">
        <span class="text-xs font-bold text-violet-700 block mb-1">{d.rule2Title}</span>
        <p class="text-xs text-body leading-relaxed">{d.rule2Text}</p>
      </div>

      <div class="bg-surface-soft/80 border border-hairline rounded-2xl p-4">
        <span class="text-xs font-bold text-violet-700 block mb-1">{d.rule3Title}</span>
        <p class="text-xs text-body leading-relaxed">{d.rule3Text}</p>
      </div>

      <div class="bg-surface-soft/80 border border-hairline rounded-2xl p-4">
        <span class="text-xs font-bold text-violet-700 block mb-1">{d.rule4Title}</span>
        <p class="text-xs text-body leading-relaxed">{d.rule4Text}</p>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ ultrasonicData, lang }}>
  (function() {
    const data = ultrasonicData;

    // Elements
    const tankSelect = document.getElementById('tank-arch-select');
    const chemSelect = document.getElementById('chem-select');
    const matSelect = document.getElementById('mat-select');
    const freqSelect = document.getElementById('freq-select');
    const powerSlider = document.getElementById('power-slider');
    const powerVal = document.getElementById('power-val');
    const tempSlider = document.getElementById('temp-slider');
    const tempVal = document.getElementById('temp-val');
    const sweepToggle = document.getElementById('sweep-toggle');
    const hoursSlider = document.getElementById('hours-slider');
    const hoursVal = document.getElementById('hours-val');

    // SVG Elements
    const svgResonanceBadge = document.getElementById('sim-resonance-badge');
    const svgCookwareLabel = document.getElementById('svg-cookware-label');
    const svgFreqText = document.getElementById('svg-freq-text');
    const svgShockwaveText = document.getElementById('svg-shockwave-text');
    const svgBond1 = document.getElementById('svg-bond-1');
    const svgBond2 = document.getElementById('svg-bond-2');
    const svgBond3 = document.getElementById('svg-bond-3');
    const svgBasinWall = document.getElementById('svg-basin-wall');

    // Telemetry Pills
    const telJetSpeed = document.getElementById('telemetry-jet-speed');
    const telBondShear = document.getElementById('telemetry-bond-shear');
    const telReflected = document.getElementById('telemetry-reflected-power');
    const telMetalLoss = document.getElementById('telemetry-metal-loss');

    // Gauges
    const gaugeShockwaveVal = document.getElementById('gauge-shockwave-val');
    const gaugeShockwaveSub = document.getElementById('gauge-shockwave-sub');
    const gaugeShockwaveBar = document.getElementById('gauge-shockwave-bar');
    const gaugeShockwaveStatus = document.getElementById('gauge-shockwave-status');

    const gaugeErosionVal = document.getElementById('gauge-erosion-val');
    const gaugeErosionBar = document.getElementById('gauge-erosion-bar');
    const gaugeErosionStatus = document.getElementById('gauge-erosion-status');

    const gaugeDelamVal = document.getElementById('gauge-delam-val');
    const gaugeDelamSub = document.getElementById('gauge-delam-sub');
    const gaugeDelamBar = document.getElementById('gauge-delam-bar');
    const gaugeDelamStatus = document.getElementById('gauge-delam-status');

    const gaugeCleaningVal = document.getElementById('gauge-cleaning-val');
    const gaugeCleaningBar = document.getElementById('gauge-cleaning-bar');
    const gaugeCleaningStatus = document.getElementById('gauge-cleaning-status');

    const gaugeNoiseVal = document.getElementById('gauge-noise-val');
    const gaugeNoiseBar = document.getElementById('gauge-noise-bar');
    const gaugeNoiseStatus = document.getElementById('gauge-noise-status');

    const gaugeLifespanVal = document.getElementById('gauge-lifespan-val');
    const gaugeLifespanBar = document.getElementById('gauge-lifespan-bar');
    const gaugeLifespanStatus = document.getElementById('gauge-lifespan-status');

    // Callout
    const complianceCard = document.getElementById('compliance-card');
    const complianceBadge = document.getElementById('compliance-badge');
    const calloutRisk = document.getElementById('callout-risk');
    const calloutMechanisms = document.getElementById('callout-mechanisms');
    const calloutMitigation = document.getElementById('callout-mitigation');

    // Presets
    const presetBtns = document.querySelectorAll('[data-preset]');
    const copyReportBtn = document.getElementById('copy-report-btn');
    const copyBtnText = document.getElementById('copy-btn-text');

    function calculateSimulation() {
      const tankId = tankSelect.value;
      const chemId = chemSelect.value;
      const matId = matSelect.value;
      const freqKhz = parseFloat(freqSelect.value);
      const powerDensity = parseFloat(powerSlider.value);
      const tempC = parseFloat(tempSlider.value);
      const sweepActive = sweepToggle.checked;
      const operatingHours = parseFloat(hoursSlider.value);

      const tank = data.tankArchitectures.find(t => t.id === tankId) || data.tankArchitectures[0];
      const chem = data.cleaningChemistries.find(c => c.id === chemId) || data.cleaningChemistries[0];
      const mat = data.targetMaterials.find(m => m.id === matId) || data.targetMaterials[0];

      // 1. Temperature Cavitation Intensity Factor (Peaked at 55°C, drops near 20°C and 85°C)
      let tempFactor = 1.0;
      if (tempC <= 55) {
        tempFactor = 0.4 + 0.6 * ((tempC - 20) / 35);
      } else {
        tempFactor = 1.0 - 0.75 * ((tempC - 55) / 30);
      }
      tempFactor = Math.max(0.2, Math.min(1.0, tempFactor));

      // 2. Frequency scaling: Bubble radius ~ 1/f; Shockwave pressure scales with bubble collapse velocity
      // Reference at 40 kHz: ~1,400 bar
      const freqFactor = Math.pow(40 / freqKhz, 0.65);
      const powerFactor = Math.pow(powerDensity / 15, 0.7);

      // Peak bubble collapse pressure (bar)
      let peakShockwaveBar = 1400 * freqFactor * powerFactor * tempFactor * (chem.surfaceTensionDyneCm / 45);
      if (tankId === 'aged_compromised_degreaser_tank') {
        peakShockwaveBar *= 0.65; // Loss of resonant coupling
      }
      peakShockwaveBar = Math.round(Math.max(250, peakShockwaveBar));
      const microJetSpeed = Math.round(180 + (peakShockwaveBar / 4.5));

      // 3. Basin Cavitation Pit Erosion Rate (µm / 1,000 hrs)
      // ASTM G32 base: ~45 µm/1000h at 15 W/L, 40 kHz, 304 inox.
      const metallurgyErosionResist = mat.cavitationErosionResistanceFactor;
      const sweepErosionFactor = sweepActive ? 0.42 : 1.35; // Sweep diffuses standing waves
      const chemSynergy = chem.synergyFactor; // Chemical erosion-corrosion synergy
      
      let basinErosionRateUm = 45 * Math.pow(powerDensity / 15, 1.4) * Math.pow(40 / freqKhz, 0.8) * tempFactor * chemSynergy * sweepErosionFactor;
      if (tank.metallurgy.includes('316L')) {
        basinErosionRateUm *= 0.45; // 316L high Mo resistance
      }
      if (tankId === 'aged_compromised_degreaser_tank') {
        basinErosionRateUm *= 2.2; // Pre-existing pitted micro-cavities
      }
      basinErosionRateUm = Math.round(basinErosionRateUm * 10) / 10;

      // Cumulative Metal Loss in Basin Wall
      const wallThicknessMm = tank.basinWallThicknessMm;
      const metalLossMm = Math.round((basinErosionRateUm * (operatingHours / 1000) / 1000) * 100) / 100;
      const wallRetentionPct = Math.max(0, Math.round(((wallThicknessMm - metalLossMm) / wallThicknessMm) * 100));
      const hoursToPerforation = Math.round((wallThicknessMm * 1000 / Math.max(1, basinErosionRateUm)) * 1000);

      // 4. Transducer Epoxy Shear Fatigue & Delamination Risk (%)
      // Higher temp (>65°C) degrades epoxy drastically; high power & lack of sweep increase cyclic fatigue
      let thermalStress = tempC > 65 ? Math.pow((tempC - 65) / 5, 1.8) * 12 : 0;
      let acousticFatigue = (operatingHours / 15000) * 40 * Math.pow(powerDensity / 15, 0.8);
      let bondDesignQuality = tank.transducerMounting.includes('Stud') ? 0.35 : (tank.transducerMounting.includes('Brazed') ? 0.05 : 0.85);
      
      let delamRiskPct = Math.min(100, Math.round((thermalStress + acousticFatigue) * bondDesignQuality));
      if (tankId === 'aged_compromised_degreaser_tank') {
        delamRiskPct = Math.max(68, delamRiskPct);
      }

      // Reflected electrical power (%): increases with delamination
      const reflectedPowerPct = Math.min(45, Math.round((1.8 + (delamRiskPct * 0.38)) * 10) / 10);
      const epoxyBondShearMpa = Math.round((2.5 + (powerDensity * 0.15) + (tempC > 60 ? (tempC - 60) * 0.2 : 0)) * 10) / 10;

      // 5. Cleaning Efficacy Index (%)
      // Combines temperature chemical reaction rate (Arrhenius) + cavitation micro-scrub
      let chemicalActivity = Math.min(1.2, 0.3 + (tempC / 65));
      let mechanicalScrub = Math.min(1.2, (powerDensity / 15) * Math.pow(freqKhz / 40, 0.3) * tempFactor);
      if (sweepActive) mechanicalScrub *= 1.15;
      if (delamRiskPct > 50) mechanicalScrub *= 0.6; // Power not coupling into bath
      
      let cleaningEfficacy = Math.min(100, Math.round(mechanicalScrub * chemicalActivity * 82));

      // 6. Scullery Acoustic Noise (dBA)
      // Violent 25 kHz unswept generates highest subharmonic cavitation noise
      let baseNoise = 68 + (powerDensity * 0.25);
      if (freqKhz === 25) baseNoise += 14;
      else if (freqKhz === 40) baseNoise += 7;
      else if (freqKhz === 80) baseNoise += 2;
      if (!sweepActive) baseNoise += 4.5;
      const noiseDba = Math.round(baseNoise * 10) / 10;

      // Update UI Text & Sliders
      powerVal.textContent = `${powerDensity} W/L`;
      const tempF = Math.round(tempC * 1.8 + 32);
      tempVal.textContent = `${tempC}°C (${tempF}°F)`;
      hoursVal.textContent = `${operatingHours.toLocaleString()} Hrs`;

      // Update Telemetry Pills
      telJetSpeed.textContent = `${microJetSpeed} m/s`;
      telBondShear.textContent = `${epoxyBondShearMpa} MPa (${delamRiskPct > 40 ? 'FATIGUED' : 'STABLE'})`;
      telReflected.textContent = `${reflectedPowerPct}% (${reflectedPowerPct > 15 ? 'MISMATCH' : 'MATCHED'})`;
      telMetalLoss.textContent = `${metalLossMm} mm (${wallRetentionPct}% Intact)`;

      // Update Gauges
      gaugeShockwaveVal.textContent = `${peakShockwaveBar.toLocaleString()} bar`;
      gaugeShockwaveSub.textContent = `(${Math.round(peakShockwaveBar / 10)} MPa)`;
      gaugeShockwaveBar.style.width = `${Math.min(100, Math.round((peakShockwaveBar / 3000) * 100))}%`;
      
      if (peakShockwaveBar > 2200) {
        gaugeShockwaveStatus.textContent = "Violent Collapse (Substrate Damage Hazard)";
        gaugeShockwaveStatus.className = "text-[11px] font-bold text-rose-700 bg-rose-50 px-2 py-0.5 rounded self-start";
        gaugeShockwaveBar.className = "h-full bg-rose-600 transition-all duration-300";
      } else if (peakShockwaveBar > 1200) {
        gaugeShockwaveStatus.textContent = "Energetic Transient Cavitation";
        gaugeShockwaveStatus.className = "text-[11px] font-bold text-violet-700 bg-violet-50 px-2 py-0.5 rounded self-start";
        gaugeShockwaveBar.className = "h-full bg-violet-600 transition-all duration-300";
      } else {
        gaugeShockwaveStatus.textContent = "Gentle Stable Cavitation Cloud";
        gaugeShockwaveStatus.className = "text-[11px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded self-start";
        gaugeShockwaveBar.className = "h-full bg-emerald-600 transition-all duration-300";
      }

      gaugeErosionVal.textContent = `${basinErosionRateUm} µm`;
      gaugeErosionBar.style.width = `${Math.min(100, Math.round((basinErosionRateUm / 150) * 100))}%`;
      if (basinErosionRateUm > 80) {
        gaugeErosionStatus.textContent = "Accelerated Pit Erosion (Wall Thinning Alert)";
        gaugeErosionStatus.className = "text-[11px] font-bold text-rose-700 bg-rose-50 px-2 py-0.5 rounded self-start";
        gaugeErosionBar.className = "h-full bg-rose-600 transition-all duration-300";
      } else if (basinErosionRateUm > 40) {
        gaugeErosionStatus.textContent = "Moderate Synergistic Micro-Pitting";
        gaugeErosionStatus.className = "text-[11px] font-bold text-amber-700 bg-amber-50 px-2 py-0.5 rounded self-start";
        gaugeErosionBar.className = "h-full bg-amber-600 transition-all duration-300";
      } else {
        gaugeErosionStatus.textContent = "Low Pitting Wear (ASTM G32 Safe)";
        gaugeErosionStatus.className = "text-[11px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded self-start";
        gaugeErosionBar.className = "h-full bg-emerald-600 transition-all duration-300";
      }

      gaugeDelamVal.textContent = `${delamRiskPct}%`;
      gaugeDelamBar.style.width = `${delamRiskPct}%`;
      if (delamRiskPct > 60) {
        gaugeDelamStatus.textContent = "Critical Debonding (Impedance Fault)";
        gaugeDelamStatus.className = "text-[11px] font-bold text-rose-700 bg-rose-50 px-2 py-0.5 rounded self-start";
        gaugeDelamBar.className = "h-full bg-rose-600 transition-all duration-300";
      } else if (delamRiskPct > 30) {
        gaugeDelamStatus.textContent = "Epoxy Thermal Fatigue Accumulating";
        gaugeDelamStatus.className = "text-[11px] font-bold text-amber-700 bg-amber-50 px-2 py-0.5 rounded self-start";
        gaugeDelamBar.className = "h-full bg-amber-600 transition-all duration-300";
      } else {
        gaugeDelamStatus.textContent = "Bond Intact &bull; High Shear Safety";
        gaugeDelamStatus.className = "text-[11px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded self-start";
        gaugeDelamBar.className = "h-full bg-emerald-600 transition-all duration-300";
      }

      gaugeCleaningVal.textContent = `${cleaningEfficacy}%`;
      gaugeCleaningBar.style.width = `${cleaningEfficacy}%`;
      if (cleaningEfficacy >= 85) {
        gaugeCleaningStatus.textContent = "Rapid Baked Grease Inversion";
        gaugeCleaningStatus.className = "text-[11px] font-bold text-violet-700 bg-violet-50 px-2 py-0.5 rounded self-start";
      } else if (cleaningEfficacy >= 65) {
        gaugeCleaningStatus.textContent = "Adequate Soil Removal";
        gaugeCleaningStatus.className = "text-[11px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded self-start";
      } else {
        gaugeCleaningStatus.textContent = "Sub-Standard Grease Residue Left";
        gaugeCleaningStatus.className = "text-[11px] font-bold text-rose-700 bg-rose-50 px-2 py-0.5 rounded self-start";
      }

      gaugeNoiseVal.textContent = `${noiseDba} dBA`;
      gaugeNoiseBar.style.width = `${Math.min(100, Math.round(((noiseDba - 60) / 45) * 100))}%`;
      if (noiseDba >= 85) {
        gaugeNoiseStatus.textContent = "OSHA Hearing PPE Action Limit Exceeded";
        gaugeNoiseStatus.className = "text-[11px] font-bold text-rose-700 bg-rose-50 px-2 py-0.5 rounded self-start";
        gaugeNoiseBar.className = "h-full bg-rose-600 transition-all duration-300";
      } else {
        gaugeNoiseStatus.textContent = "OSHA Safe (< 85 dBA Action Level)";
        gaugeNoiseStatus.className = "text-[11px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded self-start";
        gaugeNoiseBar.className = "h-full bg-emerald-600 transition-all duration-300";
      }

      gaugeLifespanVal.textContent = hoursToPerforation > 20000 ? "> 20,000 hrs" : `${hoursToPerforation.toLocaleString()} hrs`;
      gaugeLifespanBar.style.width = `${Math.min(100, Math.round((hoursToPerforation / 20000) * 100))}%`;
      if (hoursToPerforation < 4000) {
        gaugeLifespanStatus.textContent = "Imminent Basin Perforation Pinhole";
        gaugeLifespanStatus.className = "text-[11px] font-bold text-rose-700 bg-rose-50 px-2 py-0.5 rounded self-start";
        gaugeLifespanBar.className = "h-full bg-rose-600 transition-all duration-300";
      } else {
        gaugeLifespanStatus.textContent = `Nominal ${wallThicknessMm}mm Wall Retention`;
        gaugeLifespanStatus.className = "text-[11px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded self-start";
        gaugeLifespanBar.className = "h-full bg-emerald-600 transition-all duration-300";
      }

      // Update SVG Visuals
      svgFreqText.textContent = `${freqKhz} kHz ${sweepActive ? '±1.5 kHz' : 'Fixed Node'}`;
      svgShockwaveText.textContent = `Peak Shock: ${peakShockwaveBar.toLocaleString()} bar | Jet: ${microJetSpeed} m/s`;
      svgCookwareLabel.textContent = mat.name.split(' ')[0] + ' ' + (mat.name.split(' ')[1] || 'Cookware');

      if (sweepActive) {
        svgResonanceBadge.textContent = "RESONANT SWEEP";
        svgResonanceBadge.className = "text-[11px] font-mono px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 font-bold";
      } else {
        svgResonanceBadge.textContent = "STANDING WAVE NODES";
        svgResonanceBadge.className = "text-[11px] font-mono px-2 py-0.5 rounded bg-amber-100 text-amber-800 font-bold";
      }

      // Transducer Bond Fill
      const bondColor = delamRiskPct > 60 ? '#ef4444' : (delamRiskPct > 30 ? '#f59e0b' : '#10b981');
      if (svgBond1) svgBond1.setAttribute('fill', bondColor);
      if (svgBond2) svgBond2.setAttribute('fill', bondColor);
      if (svgBond3) svgBond3.setAttribute('fill', bondColor);

      // Basin wall stroke color
      if (svgBasinWall) {
        svgBasinWall.setAttribute('stroke', wallRetentionPct < 70 ? '#ef4444' : '#94a3b8');
      }

      // Update Callout Status Card
      if (delamRiskPct > 60 || wallRetentionPct < 50 || noiseDba >= 85) {
        complianceCard.className = "bg-rose-50/80 border border-rose-300 rounded-2xl p-6 mb-8 transition-colors";
        complianceBadge.className = "px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-rose-700 text-white";
        complianceBadge.textContent = "NON-COMPLIANT / EQUIPMENT BREAKDOWN ALERT";
        
        calloutRisk.textContent = delamRiskPct > 60 
          ? "Critical transducer bondline delamination detected! Reflected electrical power threatens generator burnout and produces uneven cavitation shadow zones."
          : (noiseDba >= 85 
            ? "Acoustic cavitation noise exceeds OSHA 1910.95 permissible sound level (85 dBA TWA) without engineered acoustic baffling."
            : "Excessive basin wall erosion threatens through-thickness pinhole perforation and chemical wash flooding.");
        
        calloutMechanisms.textContent = "High-cycle shear stresses (&tau; > 12 MPa) combined with thermal softening of epoxy (>65°C) induce interfacial adhesive fracture, shifting electrical impedance and causing resonant decoupling.";
        calloutMitigation.textContent = "Immediately lower bath temperature below 60°C. Perform ultrasonic impedance analysis per IEC 61161, inspect basin wall thickness with ultrasonic thickness gauging (UT), and fit an acoustic baffled lid.";
      } else if (delamRiskPct > 30 || basinErosionRateUm > 50 || !sweepActive) {
        complianceCard.className = "bg-amber-50/80 border border-amber-300 rounded-2xl p-6 mb-8 transition-colors";
        complianceBadge.className = "px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-700 text-white";
        complianceBadge.textContent = "OPERATIONAL WARNING: ELEVATED STRESS";
        
        calloutRisk.textContent = !sweepActive 
          ? "Fixed-frequency operation creates persistent standing-wave antinodes, driving severe localized pitting wear directly over transducer centers."
          : "Elevated caustic synergy and temperature are accelerating basin erosion-corrosion. Transducer epoxy fatigue accumulating.";
        
        calloutMechanisms.textContent = "Constructive acoustic wave interference concentrates cavitation micro-jets in fixed geometric bands; hydroxide ions (pH > 13) actively strip protective passive oxide films from newly pitted micro-craters.";
        calloutMitigation.textContent = "Engage ±1.5 kHz digital frequency sweep to disperse acoustic energy. Transition to a silicated or neutral enzymatic cleaning chemistry to reduce erosion-corrosion synergy.";
      } else {
        complianceCard.className = "bg-emerald-50/70 border border-emerald-200 rounded-2xl p-6 mb-8 transition-colors";
        complianceBadge.className = "px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-700 text-white";
        complianceBadge.textContent = "NSF/ANSI 3 & IEC 61161 COMPLIANT";
        
        calloutRisk.textContent = "Controlled acoustic cavitation; acoustic sweep suppresses standing wave burns. Transducer epoxy shear fatigue remains well within safety envelope.";
        calloutMechanisms.textContent = `Rayleigh-Plesset bubble collapse generates ${peakShockwaveBar.toLocaleString()} bar localized shockwaves with micro-jets impinging at ${microJetSpeed} m/s; silicate passivation inhibits intergranular caustic attack.`;
        calloutMitigation.textContent = "Maintain bath temperature below 62°C to prevent thermal degradation of transducer bondlines; perform monthly reflected power impedance checks per IEC 61161.";
      }
    }

    // Attach Event Listeners
    tankSelect.addEventListener('change', calculateSimulation);
    chemSelect.addEventListener('change', calculateSimulation);
    matSelect.addEventListener('change', calculateSimulation);
    freqSelect.addEventListener('change', calculateSimulation);
    powerSlider.addEventListener('input', calculateSimulation);
    tempSlider.addEventListener('input', calculateSimulation);
    sweepToggle.addEventListener('change', calculateSimulation);
    hoursSlider.addEventListener('input', calculateSimulation);

    // Presets Handlers
    presetBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const preset = btn.getAttribute('data-preset');
        if (preset === 'standard') {
          tankSelect.value = 'heavy_duty_multi_frequency_immersion_tank';
          chemSelect.value = 'mild_alkaline_silicated_cleaner';
          matSelect.value = 'commercial_316l_stainless';
          freqSelect.value = '40';
          powerSlider.value = '18';
          tempSlider.value = '55';
          sweepToggle.checked = true;
          hoursSlider.value = '2500';
        } else if (preset === 'violent') {
          tankSelect.value = 'heavy_duty_multi_frequency_immersion_tank';
          chemSelect.value = 'heavy_alkaline_caustic_degreaser';
          matSelect.value = 'commercial_304_stainless';
          freqSelect.value = '25';
          powerSlider.value = '40';
          tempSlider.value = '65';
          sweepToggle.checked = false;
          hoursSlider.value = '6000';
        } else if (preset === 'failure') {
          tankSelect.value = 'aged_compromised_degreaser_tank';
          chemSelect.value = 'mild_citric_acidic_descaler';
          matSelect.value = 'commercial_304_stainless';
          freqSelect.value = '40';
          powerSlider.value = '30';
          tempSlider.value = '75';
          sweepToggle.checked = false;
          hoursSlider.value = '12000';
        } else if (preset === 'delicate') {
          tankSelect.value = 'high_frequency_precision_cookware_finishing_tank';
          chemSelect.value = 'neutral_enzymatic_surfactant_wash';
          matSelect.value = 'commercial_aluminum_5052';
          freqSelect.value = '80';
          powerSlider.value = '12';
          tempSlider.value = '48';
          sweepToggle.checked = true;
          hoursSlider.value = '1200';
        }
        calculateSimulation();
      });
    });

    // Copy Technical Report
    if (copyReportBtn) {
      copyReportBtn.addEventListener('click', () => {
        const report = `================================================================================
ISITKITCHENSAFE TECHNICAL REPORT: COMMERCIAL ULTRASONIC DEGREASING SIMULATION
Standard: ASTM G32, IEC 61161, NSF/ANSI Standard 3, OSHA 1910.95
Timestamp: ${new Date().toISOString()}
================================================================================

1. EQUIPMENT & OPERATIONAL CONFIGURATION
- Ultrasonic Tank Architecture : ${tankSelect.options[tankSelect.selectedIndex].text}
- Aqueous Cleaning Chemistry  : ${chemSelect.options[chemSelect.selectedIndex].text}
- Cookware Substrate Material : ${matSelect.options[matSelect.selectedIndex].text}
- Drive Frequency             : ${freqSelect.value} kHz
- Acoustic Power Density      : ${powerSlider.value} W/L
- Aqueous Bath Temperature    : ${tempSlider.value}°C (${Math.round(tempSlider.value * 1.8 + 32)}°F)
- Frequency Sweep Active      : ${sweepToggle.checked ? 'YES (±1.5 kHz Sweep)' : 'NO (Fixed Node/Antinode)'}
- Cumulative Service Hours    : ${hoursSlider.value} Hours

2. ACOUSTIC DYNAMICS & SURFACE INTEGRITY TELEMETRY
- Rayleigh-Plesset Shockwave  : ${gaugeShockwaveVal.textContent} ${gaugeShockwaveSub.textContent}
- Collapse Micro-Jet Velocity : ${telJetSpeed.textContent}
- Basin Pit Erosion Rate      : ${gaugeErosionVal.textContent} / 1,000 hrs
- Basin Cumulative Metal Loss : ${telMetalLoss.textContent}
- Estimated Basin Lifespan    : ${gaugeLifespanVal.textContent}
- PZT Transducer Delamination : ${gaugeDelamVal.textContent} (${gaugeDelamStatus.textContent.trim()})
- Epoxy Bond Shear Stress     : ${telBondShear.textContent}
- Generator Reflected Power   : ${telReflected.textContent}
- Cleaning Efficacy Index     : ${gaugeCleaningVal.textContent} (${gaugeCleaningStatus.textContent.trim()})
- Scullery Noise Level (OSHA) : ${gaugeNoiseVal.textContent} (${gaugeNoiseStatus.textContent.trim()})

3. REGULATORY COMPLIANCE & ROOT CAUSE FINDINGS
- Compliance Status           : ${complianceBadge.textContent.trim()}
- Primary Risk Assessment     : ${calloutRisk.textContent.trim()}
- Governing Mechanisms        : ${calloutMechanisms.textContent.trim()}
- Remediation Controls        : ${calloutMitigation.textContent.trim()}
================================================================================`;

        navigator.clipboard.writeText(report).then(() => {
          const original = copyBtnText.textContent;
          copyBtnText.textContent = "Technical Report Copied to Clipboard!";
          setTimeout(() => {
            copyBtnText.textContent = original;
          }, 3000);
        }).catch(() => {
          alert("Simulation report generated and ready in console.");
        });
      });
    }

    // Initial run
    calculateSimulation();
  })();
</script>
