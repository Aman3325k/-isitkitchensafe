            <!-- Outer Tank Structure -->
            <rect x="35" y="25" width="330" height="195" rx="4" fill="#1e293b" stroke="#475569" stroke-width="2" />
            
            <!-- Stainless Steel Basin Wall -->
            <rect x="45" y="35" width="310" height="175" rx="3" fill="#0f172a" stroke="#94a3b8" stroke-width="3" id="svg-basin-wall" />
            
            <!-- Liquid Volume -->
            <rect x="50" y="55" width="300" height="152" fill="url(#liquidGrad)" />

            <!-- Acoustic Wavefront Beams -->
            <g id="svg-acoustic-waves">
              <path d="M 70 205 Q 110 130 70 60" stroke="#c084fc" stroke-width="1.5" fill="none" opacity="0.6" stroke-dasharray="4 2" />
              <path d="M 130 205 Q 170 130 130 60" stroke="#c084fc" stroke-width="2" fill="none" opacity="0.8" stroke-dasharray="4 2" />
              <path d="M 200 205 Q 240 130 200 60" stroke="#c084fc" stroke-width="2.5" fill="none" opacity="0.9" />
              <path d="M 270 205 Q 310 130 270 60" stroke="#c084fc" stroke-width="2" fill="none" opacity="0.8" stroke-dasharray="4 2" />
              <path d="M 330 205 Q 370 130 330 60" stroke="#c084fc" stroke-width="1.5" fill="none" opacity="0.6" stroke-dasharray="4 2" />
