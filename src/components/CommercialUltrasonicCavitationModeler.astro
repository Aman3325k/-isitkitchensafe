const d = DICTIONARY[lang] || DICTIONARY.en;
const data = ultrasonicData;
---

<div class="not-prose my-8 bg-surface border border-hairline rounded-3xl p-6 sm:p-8 shadow-sm">
  <!-- Header -->
  <div class="border-b border-hairline/60 pb-6 mb-8">
    <div class="flex flex-wrap items-center gap-2 mb-3">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-violet-700 text-white">
        {d.badge}
      </span>
      <span class="text-xs text-muted font-mono">
        ASTM G32 &bull; IEC 61161 &bull; NSF/ANSI Standard 3 &bull; OSHA 1910.95
      </span>
    </div>
    <h2 class="text-title-xl sm:text-title-2xl font-semibold text-ink tracking-tight mb-2">
      {d.title}
    </h2>
    <p class="text-body-sm sm:text-body text-muted leading-relaxed">
      {d.subtitle}
    </p>
  </div>

  <!-- Presets -->
  <div class="bg-surface-soft/80 border border-hairline/70 rounded-2xl p-4 sm:p-5 mb-8">
    <span class="text-xs font-semibold uppercase tracking-wider text-muted block mb-3">
      {d.presetsTitle}
    </span>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5">
      <button 
        type="button" 
        data-preset="standard"
        class="px-3.5 py-2.5 rounded-xl text-xs font-medium bg-surface border border-hairline/80 hover:border-violet-600 hover:text-violet-700 hover:bg-violet-50/50 text-ink transition-all text-left flex flex-col gap-0.5 shadow-2xs"
      >
        <span class="font-bold text-violet-700">{d.presetStandardScullery}</span>
      </button>

      <button 
        type="button" 
        data-preset="violent"
        class="px-3.5 py-2.5 rounded-xl text-xs font-medium bg-surface border border-hairline/80 hover:border-amber-600 hover:text-amber-700 hover:bg-amber-50/50 text-ink transition-all text-left flex flex-col gap-0.5 shadow-2xs"
      >
        <span class="font-bold text-amber-700">{d.presetViolentDegreasing}</span>
      </button>

      <button 
        type="button" 
        data-preset="failure"
        class="px-3.5 py-2.5 rounded-xl text-xs font-medium bg-surface border border-hairline/80 hover:border-rose-600 hover:text-rose-700 hover:bg-rose-50/50 text-ink transition-all text-left flex flex-col gap-0.5 shadow-2xs"
      >
        <span class="font-bold text-rose-700">{d.presetDelaminatedFailure}</span>
      </button>

      <button 
        type="button" 
        data-preset="delicate"
        class="px-3.5 py-2.5 rounded-xl text-xs font-medium bg-surface border border-hairline/80 hover:border-emerald-600 hover:text-emerald-700 hover:bg-emerald-50/50 text-ink transition-all text-left flex flex-col gap-0.5 shadow-2xs"
      >
        <span class="font-bold text-emerald-700">{d.presetDelicateAluminum}</span>
      </button>
    </div>
  </div>

  <!-- Interactive Controls & SVG Simulation -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-8">
    <!-- Left: Controls (7 cols) -->
    <div class="lg:col-span-7 space-y-6">
      <div class="border-b border-hairline/60 pb-3">
        <h3 class="text-title-sm font-semibold text-ink">{d.controlsTitle}</h3>
        <p class="text-xs text-muted">{d.controlsSub}</p>
      </div>

      <!-- Control 1: Tank Architecture -->
      <div>
        <label for="tank-arch-select" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-1.5">
          {d.tankLabel}
        </label>
        <select 
          id="tank-arch-select"
          class="w-full bg-surface-soft border border-hairline rounded-xl px-3.5 py-2.5 text-sm text-ink focus:outline-hidden focus:ring-2 focus:ring-violet-500 transition-all"
        >
          {data.tankArchitectures.map((t) => (
            <option value={t.id}>{t.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1 leading-normal">{d.tankHelp}</p>
      </div>

      <!-- Control 2: Chemistry -->
      <div>
        <label for="chem-select" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-1.5">
          {d.chemLabel}
        </label>
        <select 
          id="chem-select"
          class="w-full bg-surface-soft border border-hairline rounded-xl px-3.5 py-2.5 text-sm text-ink focus:outline-hidden focus:ring-2 focus:ring-violet-500 transition-all"
        >
          {data.cleaningChemistries.map((c) => (
            <option value={c.id}>{c.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1 leading-normal">{d.chemHelp}</p>
      </div>

      <!-- Control 3: Cookware / Part Material -->
      <div>
        <label for="mat-select" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-1.5">
          {d.materialLabel}
        </label>
        <select 
          id="mat-select"
          class="w-full bg-surface-soft border border-hairline rounded-xl px-3.5 py-2.5 text-sm text-ink focus:outline-hidden focus:ring-2 focus:ring-violet-500 transition-all"
        >
          {data.targetMaterials.map((m) => (
            <option value={m.id}>{m.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1 leading-normal">{d.materialHelp}</p>
      </div>

      <!-- Control 4 & 5: Frequency & Power Density -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <div class="flex justify-between items-center mb-1.5">
            <label for="freq-select" class="text-xs font-semibold text-ink uppercase tracking-wider">
              {d.freqLabel}
            </label>
          </div>
          <select 
            id="freq-select"
            class="w-full bg-surface-soft border border-hairline rounded-xl px-3.5 py-2 text-sm text-ink focus:outline-hidden focus:ring-2 focus:ring-violet-500 transition-all"
          >
            <option value="25">25 kHz (Heavy Degreasing, ~130 µm Bubbles)</option>
            <option value="40" selected>40 kHz (Commercial Scullery Standard, ~80 µm)</option>
            <option value="80">80 kHz (Precision Micro-Scrub, ~40 µm)</option>
            <option value="130">130 kHz (Megasonic Gentle Finishing, ~15 µm)</option>
          </select>
          <p class="text-[11px] text-muted mt-1">{d.freqHelp}</p>
        </div>

        <div>
          <div class="flex justify-between items-center mb-1.5">
            <label for="power-slider" class="text-xs font-semibold text-ink uppercase tracking-wider">
              {d.powerLabel}
            </label>
            <span id="power-val" class="text-xs font-mono font-bold text-violet-700 bg-violet-50 px-2 py-0.5 rounded-md">
              18 W/L
            </span>
          </div>
          <input 
            type="range" 
            id="power-slider" 
            min="5" 
            max="50" 
            step="1" 
            value="18"
            class="w-full accent-violet-600 cursor-pointer"
          />
          <p class="text-[11px] text-muted mt-1">{d.powerHelp}</p>
        </div>
      </div>

      <!-- Control 6 & 7: Temperature & Sweep -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <div class="flex justify-between items-center mb-1.5">
            <label for="temp-slider" class="text-xs font-semibold text-ink uppercase tracking-wider">
              {d.tempLabel}
            </label>
            <span id="temp-val" class="text-xs font-mono font-bold text-violet-700 bg-violet-50 px-2 py-0.5 rounded-md">
              55°C (131°F)
            </span>
          </div>
          <input 
            type="range" 
            id="temp-slider" 
            min="20" 
            max="85" 
            step="1" 
            value="55"
            class="w-full accent-violet-600 cursor-pointer"
          />
          <p class="text-[11px] text-muted mt-1">{d.tempHelp}</p>
        </div>

        <div class="flex flex-col justify-between">
          <label class="text-xs font-semibold text-ink uppercase tracking-wider mb-1.5">
            {d.sweepLabel}
          </label>
          <div class="flex items-center gap-3 bg-surface-soft border border-hairline rounded-xl px-3.5 py-2">
            <input 
              type="checkbox" 
              id="sweep-toggle" 
              checked
              class="w-4 h-4 accent-violet-600 rounded cursor-pointer"
            />
            <label for="sweep-toggle" class="text-xs font-medium text-ink cursor-pointer select-none">
              Frequency Sweep Active (&plusmn;1.5 kHz)
            </label>
          </div>
          <p class="text-[11px] text-muted mt-1">{d.sweepHelp}</p>
        </div>
      </div>

      <!-- Control 8: Cumulative Operating Hours -->
      <div>
        <div class="flex justify-between items-center mb-1.5">
          <label for="hours-slider" class="text-xs font-semibold text-ink uppercase tracking-wider">
            {d.hoursLabel}
          </label>
          <span id="hours-val" class="text-xs font-mono font-bold text-violet-700 bg-violet-50 px-2 py-0.5 rounded-md">
            2,500 Hrs
          </span>
        </div>
        <input 
          type="range" 
          id="hours-slider" 
          min="100" 
          max="15000" 
          step="100" 
          value="2500"
          class="w-full accent-violet-600 cursor-pointer"
        />
        <p class="text-[11px] text-muted mt-1 leading-normal">{d.hoursHelp}</p>
      </div>
    </div>

    <!-- Right: Live SVG Acoustic & Tank Cross-Section Simulation (5 cols) -->
    <div class="lg:col-span-5 flex flex-col justify-between bg-surface-soft/60 border border-hairline/80 rounded-2xl p-5 shadow-2xs">
      <div>
        <div class="flex justify-between items-center mb-2">
          <span class="text-xs font-bold uppercase tracking-wider text-ink flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-violet-600 animate-pulse"></span>
            Acoustic Field & Tank Dynamics
          </span>
          <span id="sim-resonance-badge" class="text-[11px] font-mono px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 font-bold">
            RESONANT SWEEP
          </span>
        </div>

        <!-- SVG Visualizer -->
        <div class="w-full bg-ink/95 rounded-xl p-3 border border-hairline my-2 relative overflow-hidden">
          <svg viewBox="0 0 400 280" class="w-full h-auto" id="ultrasonic-svg">
