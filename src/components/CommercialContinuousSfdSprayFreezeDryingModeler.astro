<!-- Client-side Interactive Simulation Script -->
<script is:inline define:vars={{ sfdData }}>
  (function initSfdModeler() {
    const elSystem = document.getElementById('input-system');
    const elFeedstock = document.getElementById('input-feedstock');
    const elPressure = document.getElementById('input-pressure');
    const elTemp = document.getElementById('input-temp');
    const elGlr = document.getElementById('input-glr');
    const elCryo = document.getElementById('input-cryo');
    const elVacuum = document.getElementById('input-vacuum');
    const elShelf = document.getElementById('input-shelf');
    const elRecovery = document.getElementById('input-recovery');

    const dispPressure = document.getElementById('display-pressure');
    const dispTemp = document.getElementById('display-temp');
    const dispGlr = document.getElementById('display-glr');
    const dispCryo = document.getElementById('display-cryo');
    const dispVacuum = document.getElementById('display-vacuum');
    const dispShelf = document.getElementById('display-shelf');

    const resActivity = document.getElementById('res-activity');
    const barActivity = document.getElementById('bar-activity');
    const resDroplet = document.getElementById('res-droplet');
    const barDroplet = document.getElementById('bar-droplet');
    const resSolubility = document.getElementById('res-solubility');
    const barSolubility = document.getElementById('bar-solubility');
    const resCollapse = document.getElementById('res-collapse');
    const barCollapse = document.getElementById('bar-collapse');

    const resSsa = document.getElementById('res-ssa');
    const resMoisture = document.getElementById('res-moisture');
    const resFlux = document.getElementById('res-flux');

    const statusCard = document.getElementById('status-card');
    const statusBadge = document.getElementById('status-badge');
    const statusDesc = document.getElementById('status-desc');

    if (!elSystem || !elFeedstock) return;

    function recalculate() {
      const pBar = parseFloat(elPressure.value);
      const tMixC = parseFloat(elTemp.value);
      const glr = parseFloat(elGlr.value);
      const tCryoC = parseFloat(elCryo.value);
      const pVacMbar = parseFloat(elVacuum.value);
      const tShelfC = parseFloat(elShelf.value);
      const isRecovery = elRecovery.checked;

      // Update Slider Display Labels
      dispPressure.textContent = pBar.toFixed(0) + ' bar';
      dispTemp.textContent = tMixC.toFixed(0) + ' °C';
      dispGlr.textContent = glr.toFixed(1) + ' kg/kg';
      dispCryo.textContent = tCryoC.toFixed(0) + ' °C';
      dispVacuum.textContent = pVacMbar.toFixed(2) + ' mbar';
      dispShelf.textContent = (tShelfC > 0 ? '+' : '') + tShelfC.toFixed(0) + ' °C';

      // Lookup selected feedstock properties
      const selectedFeedstock = sfdData.bioproductFeedstocks.find(f => f.id === elFeedstock.value) || sfdData.bioproductFeedstocks[0];
      const selectedSystem = sfdData.systemArchitectures.find(s => s.id === elSystem.value) || sfdData.systemArchitectures[0];

      // 1. Sauter Mean Diameter D32 Calculation (Effervescent scCO2 atomization)
      // D32 decreases with increasing pressure (P_scCO2) and increasing GLR:
      // Base d0 = 22 microns at 140 bar and 1.8 GLR
      const pFactor = Math.pow(140 / Math.max(pBar, 70), 0.45);
      const glrFactor = Math.pow(1.8 / Math.max(glr, 0.4), 0.35);
      const viscFactor = Math.pow(selectedFeedstock.feedViscosityCentipoise / 20.0, 0.25);
      let d32 = 18.5 * pFactor * glrFactor * viscFactor;
      d32 = Math.max(6.0, Math.min(85.0, d32));

      // 2. Glass Transition Collapse Margin: DeltaT_margin = T_collapse - T_product
      // Sublimation product temperature estimated from vacuum pressure & shelf temp:
      // Clausius-Clapeyron sublimation temp at chamber vacuum + radiative delta:
      const tSublimationEst = -38.0 + (pVacMbar * 35.0) + (Math.max(0, tShelfC + 20) * 0.32);
      const collapseMargin = selectedFeedstock.collapseTempCelsius - tSublimationEst;

      // 3. Retained Biological Activity:
      // Denaturation occurs if T_mix is too high, or if collapse occurs (collapseMargin < 0), or if freezing is too slow (tCryo > -80)
      let baseActivity = 99.4;
      if (tMixC > selectedFeedstock.criticalHeatSensitivityMaxCelsius) {
        baseActivity -= Math.pow(tMixC - selectedFeedstock.criticalHeatSensitivityMaxCelsius, 1.4) * 2.2;
      }
      if (collapseMargin < 0) {
        // Severe cake collapse and thermal meltback
        baseActivity -= Math.abs(collapseMargin) * 5.8;
      }
      if (tCryoC > -90) {
        // Slow cooling rate allows intracellular ice crystal damage
        baseActivity -= Math.pow((-90 - tCryoC) / 10, 1.5) * 4.5;
      }
      if (pBar < 90) {
        // Inadequate scCO2 dissolution causes coarse dripping
        baseActivity -= (90 - pBar) * 0.15;
      }
      const retainedActivity = Math.max(35.0, Math.min(99.6, baseActivity));

      // 4. Reconstitution Dissolution Speed (seconds):
      // Rapid dissolution is promoted by fine D32, open meso-porosity (positive collapse margin), and low moisture
      let reconTime = 2.8 * Math.pow(d32 / 18.5, 0.65);
      if (collapseMargin < 0) {
        reconTime += Math.pow(Math.abs(collapseMargin), 1.8) * 6.5; // dense glassy crust delays wetting
      }
      reconTime = Math.max(1.8, Math.min(95.0, reconTime));

      // 5. Specific Surface Area (m2/g):
      // Inversely proportional to D32, reduced severely if collapse occurs:
      let ssa = (1600.0 / (d32 * 0.95)) * (collapseMargin >= 0 ? 1.0 : Math.max(0.1, 1.0 - Math.abs(collapseMargin) * 0.15));
      ssa = Math.max(4.5, Math.min(135.0, ssa));

      // 6. Residual Moisture (%):
      let resMoist = 0.9 + (pVacMbar * 1.8) - (tShelfC * 0.025);
      if (collapseMargin < 0) resMoist += 2.5; // trapped water
      resMoist = Math.max(0.65, Math.min(5.8, resMoist));

      // 7. Ice Sublimation Flux (kg/m2·h):
      let flux = selectedSystem.iceSublimationFluxKgM2H * (0.08 / Math.max(0.04, pVacMbar)) * Math.pow((tShelfC + 35) / 20.0, 0.5);
      flux = Math.max(0.85, Math.min(4.8, flux));

      // Update KPI Elements
      resActivity.textContent = retainedActivity.toFixed(1) + '%';
      barActivity.style.width = Math.min(100, retainedActivity) + '%';
      if (retainedActivity >= 96.0) {
        resActivity.className = 'text-2xl font-black text-emerald-400 font-mono';
        barActivity.className = 'bg-emerald-500 h-full rounded-full transition-all';
      } else if (retainedActivity >= 85.0) {
        resActivity.className = 'text-2xl font-black text-amber-400 font-mono';
        barActivity.className = 'bg-amber-500 h-full rounded-full transition-all';
      } else {
        resActivity.className = 'text-2xl font-black text-rose-400 font-mono';
        barActivity.className = 'bg-rose-500 h-full rounded-full transition-all';
      }

      resDroplet.textContent = d32.toFixed(1) + ' µm';
      barDroplet.style.width = Math.min(100, (d32 / 50.0) * 100) + '%';

      resSolubility.textContent = reconTime.toFixed(1) + ' s';
      barSolubility.style.width = Math.min(100, Math.max(10, 100 - reconTime * 1.5)) + '%';

      resCollapse.textContent = (collapseMargin > 0 ? '+' : '') + collapseMargin.toFixed(1) + ' °C';
      if (collapseMargin >= 2.0) {
        resCollapse.className = 'text-2xl font-black text-emerald-400 font-mono';
        barCollapse.className = 'bg-emerald-500 h-full rounded-full transition-all';
        barCollapse.style.width = '90%';
      } else if (collapseMargin >= 0.0) {
        resCollapse.className = 'text-2xl font-black text-amber-400 font-mono';
        barCollapse.className = 'bg-amber-500 h-full rounded-full transition-all';
        barCollapse.style.width = '50%';
      } else {
        resCollapse.className = 'text-2xl font-black text-rose-400 font-mono';
        barCollapse.className = 'bg-rose-500 h-full rounded-full transition-all';
        barCollapse.style.width = '20%';
      }

      resSsa.textContent = ssa.toFixed(1) + ' m²/g';
      resMoisture.textContent = resMoist.toFixed(2) + '%';
      resFlux.textContent = flux.toFixed(2) + ' kg/m²·h';

      // Status Classification Logic
      if (collapseMargin >= 2.0 && retainedActivity >= 96.0 && d32 <= 30.0) {
        statusCard.className = 'p-4 rounded-2xl border border-emerald-500/30 bg-emerald-950/20 space-y-2 transition-all';
        statusBadge.className = 'px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-emerald-900/60 text-emerald-300 border border-emerald-700/50';
        statusBadge.textContent = 'OPTIMAL ASEPTIC VITRIFICATION & SUBLIMATION';
        statusDesc.textContent = 'Process operates inside peak vitrification and sub-collapse freeze-drying boundaries. Monodisperse micro-droplets preserve >98% protein and live cell viability with complete water reconstitution in under 4 seconds.';
      } else if (collapseMargin >= 0.0 && retainedActivity >= 85.0) {
        statusCard.className = 'p-4 rounded-2xl border border-amber-500/30 bg-amber-950/20 space-y-2 transition-all';
        statusBadge.className = 'px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-amber-900/60 text-amber-300 border border-amber-700/50';
        statusBadge.textContent = 'ACCEPTABLE COMMERCIAL DRYING (MARGINAL SAFETY)';
        statusBadge.className = 'px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-amber-900/60 text-amber-300 border border-amber-700/50';
        statusDesc.textContent = 'Operation is stable but operating close to the glass transition collapse threshold (ΔT_margin < 2.0°C). Minor vacuum fluctuations could trigger micro-collapse. Recommend lowering shelf heating or deepening chamber vacuum.';
      } else {
        statusCard.className = 'p-4 rounded-2xl border border-rose-500/30 bg-rose-950/30 space-y-2 transition-all';
        statusBadge.className = 'px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-rose-900/80 text-rose-300 border border-rose-700/50';
        statusBadge.textContent = 'CATASTROPHIC CAKE COLLAPSE & BIOACTIVE DENATURATION';
        statusDesc.textContent = 'CRITICAL PROCESS VIOLATION: Sublimation product temperature exceeds the glass transition temperature (ΔT_margin < 0°C), triggering cake collapse, dense glassy skin formation, trapped residual water, and irreversible active-site protein denaturation.';
      }
    }

    // Attach Listeners
    [elSystem, elFeedstock, elPressure, elTemp, elGlr, elCryo, elVacuum, elShelf, elRecovery].forEach(input => {
      input.addEventListener('input', recalculate);
      input.addEventListener('change', recalculate);
    });

    // Preset Buttons
    function applyPreset(presetId) {
      const p = sfdData.presets.find(item => item.id === presetId);
      if (!p) return;
      elSystem.value = p.systemId;
      elFeedstock.value = p.feedstockId;
      elPressure.value = p.scCo2PressureBar;
      elTemp.value = p.scCo2TemperatureCelsius;
      elGlr.value = p.gasToLiquidRatio;
      elCryo.value = p.cryoFreezingTempCelsius;
      elVacuum.value = p.vacuumPressureMbar;
      elShelf.value = p.sublimationShelfTempCelsius;
      recalculate();
    }

    const btnProbiotic = document.getElementById('btn-preset-probiotic');
    const btnImmuno = document.getElementById('btn-preset-immuno');
    const btnPolyphenol = document.getElementById('btn-preset-polyphenol');
    const btnLiposomal = document.getElementById('btn-preset-liposomal');
    const btnHazard = document.getElementById('btn-preset-hazard');

    if (btnProbiotic) btnProbiotic.addEventListener('click', () => applyPreset('preset_probiotic'));
    if (btnImmuno) btnImmuno.addEventListener('click', () => applyPreset('preset_immunoglobulin'));
    if (btnPolyphenol) btnPolyphenol.addEventListener('click', () => applyPreset('preset_polyphenol'));
    if (btnLiposomal) btnLiposomal.addEventListener('click', () => applyPreset('preset_liposomal'));
    if (btnHazard) btnHazard.addEventListener('click', () => applyPreset('preset_hazard_collapse'));

    // Initial calculation run
    recalculate();
  })();
</script>
