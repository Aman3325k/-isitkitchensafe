    controlsSub: "超臨界CO2溶解圧力、温度、気液比（GLR）、極低温冷媒温度、真空昇華チャンバー圧、昇華熱板温度、およびCO2クローズドループ回収を調整。",
    systemLabel: "SFD システム機構＆連続昇華ドライヤー:",
    systemHelp: "産業用連続真空ベルト式トンネル、無菌振動流動層ユニット、クリーンルーム用パイロット機、連続極低温ドラム式ユニットから選択。",
    feedstockLabel: "熱失活性バイオ原料 / 栄養マトリクス:",
    feedstockHelp: "生きたプロバイオティクス菌液、初乳由来免疫グロブリン（IgG）、ベリーポリフェノール複合体、酵素液、リポソームエマルジョンから選択。",
    pressureLabel: "超臨界CO2溶解圧力 (P_scCO2):",
    pressureHelp: "同軸微細ノズル前のCO2飽和圧力（80〜220 bar）。高圧ほどCO2溶解度が向上し、微細な液滴径を生成。",
    tempLabel: "超臨界CO2混合温度 (T_scCO2):",
    tempHelp: "飽和チャンバー内温度（31〜45°C）。臨界点（31.1°C）を超えつつ、タンパク質変性温度以下を維持。",
    glrLabel: "気液質量比 (GLR):",
    glrHelp: "超臨界CO2質量流量と原料液流量の比（0.5〜3.0 kg CO2 / kg 原料）。発泡膨張剪断力を決定。",
    cryoLabel: "極低温凍結ゾーン温度 (T_cryo):",
    cryoHelp: "液体窒素または極低温ガスプルーム温度（-60°C〜-196°C）。冷却速度と非晶質ガラス化を支配。",
    vacuumLabel: "昇華室絶対真空度 (P_vac):",
    vacuumHelp: "一次昇華時の絶対チャンバー圧（0.04〜0.40 mbar）。氷昇華水蒸気圧勾配の駆動パラメータ。",
    shelfLabel: "一次昇華伝熱棚温度 (T_shelf):",
    shelfHelp: "一次昇華工程における輻射・伝導加熱棚設定温度（-25°C〜+20°C）。ガラス転移崩壊温度以下を厳守。",
    recoveryLabel: "クローズドループ scCO2 液化再圧縮回収:",
    recoveryHelp: "減圧膨張したCO2ガスの96%以上を液化再圧縮して回収し、ガス消費量とコストを削減。",
    presetsTitle: "高効率商業生産プリセット",
    presetProbiotic: "生プロバイオティクス生残性最大化モード (140 bar, 35°C, GLR 1.8, -160°C, 0.08 mbar, -15°C)",
    presetImmuno: "初乳IgG活性抗体保持モード (120 bar, 34°C, GLR 1.5, -170°C, 0.07 mbar, -12°C)",
    presetPolyphenol: "野生ベリーアントシアニン速溶ナノパウダー (160 bar, 36°C, GLR 2.2, -150°C, 0.09 mbar, -18°C)",
    presetLiposomal: "リポソームビタミンD3/K2 MCT保護モード (110 bar, 33°C, GLR 1.4, -185°C, 0.06 mbar, -22°C)",
    presetHazard: "熱溶融＆凍結ケーキ構造崩壊ハザード警告モード (75 bar, 44°C, GLR 0.5, -60°C, 0.35 mbar, +8°C)",
    diagnosticTitle: "連続 SFD プロセステレメトリ＆品質指標",
    diagnosticSub: "生理活性残存率、ザウター平均粒子径（D32）、水への完全再溶解時間、ガラス転移崩壊マージン、比表面積、昇華乾燥フラックスをリアルタイム算出。",
    activityLabel: "生理活性物質残存率 (A_ret):",
    dropletLabel: "微小液滴ザウター平均径 (D_32):",
    solubilityLabel: "完全再溶解・復元時間 (t_sol):",
    collapseMarginLabel: "ガラス転移崩壊安全余裕度 (ΔT_margin):",
    ssaLabel: "多孔質微粒子比表面積 (SSA):",
    moistureLabel: "製品最終残留水分率 (w_res):",
    sublimationFluxLabel: "氷昇華乾燥質量フラックス (J_sub):",
    overallStatusLabel: "プロセス安全性＆品質総合判定:",
    diagramTitle: "連続式超臨界CO2スプレーフリーズドライ全系統図",
    diagramSub: "同軸scCO2微小噴霧、液体窒素急速ガラス化、連続真空昇華トンネル、CO2循環回収ループを可視化。",
    scienceTitle: "科学的基礎: 超臨界発泡微粒化＆極低温真空メソ多孔昇華速度論",
    scienceSub: "超臨界CO2爆発微粒化機構、細胞内氷晶破壊を防ぐ極超急冷ガラス化、凍結ケーキ崩壊防止理論、3-A 45-03衛生基準適合性。",
    tableTitle: "超臨界 scCO2-SFD と主要産業乾燥技術の性能比較"
  }
};

const d = DICT[lang] || DICT.en;
---

<div class="space-y-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8" id="sfd-modeler-app">
  <!-- Header Banner -->
  <header class="space-y-4 text-center sm:text-left border-b border-hairline/60 pb-8">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-950 text-emerald-300 border border-emerald-800">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      {d.badge}
    </div>
    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-ink">
      {d.title}
    </h1>
    <p class="text-base sm:text-lg text-muted max-w-4xl leading-relaxed">
      {d.subtitle}
    </p>
  </header>

  <!-- Main Simulator Layout (2 Columns) -->
  <main class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Controls (Left 6 Cols) -->
    <div class="lg:col-span-6 bg-surface-soft border border-hairline rounded-3xl p-6 sm:p-8 space-y-6 shadow-sm">
      <div class="border-b border-hairline/60 pb-4">
        <h2 class="text-lg font-bold text-ink tracking-tight flex items-center gap-2">
          <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
          </svg>
          {d.controlsTitle}
        </h2>
        <p class="text-xs text-muted mt-1">{d.controlsSub}</p>
      </div>

      <!-- Presets Selector -->
      <div class="space-y-2">
        <label class="text-xs font-bold uppercase tracking-wider text-muted block">
          {d.presetsTitle}
        </label>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <button type="button" id="btn-preset-probiotic" class="text-left p-2.5 rounded-xl border border-hairline bg-surface hover:border-emerald-500/50 hover:bg-emerald-500/5 transition text-xs font-medium text-ink">
            🦠 {d.presetProbiotic.split('(')[0]}
          </button>
          <button type="button" id="btn-preset-immuno" class="text-left p-2.5 rounded-xl border border-hairline bg-surface hover:border-emerald-500/50 hover:bg-emerald-500/5 transition text-xs font-medium text-ink">
            🥛 {d.presetImmuno.split('(')[0]}
          </button>
          <button type="button" id="btn-preset-polyphenol" class="text-left p-2.5 rounded-xl border border-hairline bg-surface hover:border-emerald-500/50 hover:bg-emerald-500/5 transition text-xs font-medium text-ink">
            🫐 {d.presetPolyphenol.split('(')[0]}
          </button>
          <button type="button" id="btn-preset-liposomal" class="text-left p-2.5 rounded-xl border border-hairline bg-surface hover:border-emerald-500/50 hover:bg-emerald-500/5 transition text-xs font-medium text-ink">
            🧪 {d.presetLiposomal.split('(')[0]}
          </button>
        </div>
        <button type="button" id="btn-preset-hazard" class="w-full text-left p-2.5 rounded-xl border border-rose-800/40 bg-rose-950/20 hover:bg-rose-950/40 transition text-xs font-medium text-rose-300">
          ⚠️ {d.presetHazard.split('(')[0]}
        </button>
      </div>

      <!-- Parameter Inputs -->
      <div class="space-y-4 pt-2">
        <!-- System Architecture -->
        <div class="space-y-1.5">
          <label for="input-system" class="text-xs font-semibold text-ink flex justify-between">
            <span>{d.systemLabel}</span>
          </label>
          <select id="input-system" class="w-full rounded-xl border border-hairline bg-surface px-3 py-2 text-xs font-medium text-ink focus:outline-hidden focus:ring-2 focus:ring-emerald-500">
            {sfdData.systemArchitectures.map(s => (
              <option value={s.id}>{s.name}</option>
            ))}
          </select>
          <p class="text-[11px] text-muted">{d.systemHelp}</p>
        </div>

        <!-- Feedstock Biomaterial -->
        <div class="space-y-1.5">
          <label for="input-feedstock" class="text-xs font-semibold text-ink flex justify-between">
            <span>{d.feedstockLabel}</span>
          </label>
          <select id="input-feedstock" class="w-full rounded-xl border border-hairline bg-surface px-3 py-2 text-xs font-medium text-ink focus:outline-hidden focus:ring-2 focus:ring-emerald-500">
            {sfdData.bioproductFeedstocks.map(f => (
              <option value={f.id}>{f.name}</option>
            ))}
          </select>
          <p class="text-[11px] text-muted">{d.feedstockHelp}</p>
        </div>

        <!-- scCO2 Pressure -->
        <div class="space-y-1.5">
          <div class="flex items-center justify-between">
            <label for="input-pressure" class="text-xs font-semibold text-ink">
              {d.pressureLabel}
            </label>
            <span id="display-pressure" class="text-xs font-mono font-bold text-emerald-400">140 bar</span>
          </div>
          <input type="range" id="input-pressure" min="80" max="220" step="5" value="140" class="w-full accent-emerald-500 cursor-pointer" />
          <p class="text-[11px] text-muted">{d.pressureHelp}</p>
        </div>

        <!-- scCO2 Mixing Temperature -->
        <div class="space-y-1.5">
          <div class="flex items-center justify-between">
            <label for="input-temp" class="text-xs font-semibold text-ink">
              {d.tempLabel}
            </label>
            <span id="display-temp" class="text-xs font-mono font-bold text-emerald-400">35 °C</span>
          </div>
          <input type="range" id="input-temp" min="31" max="45" step="1" value="35" class="w-full accent-emerald-500 cursor-pointer" />
          <p class="text-[11px] text-muted">{d.tempHelp}</p>
        </div>

        <!-- Gas to Liquid Ratio (GLR) -->
        <div class="space-y-1.5">
          <div class="flex items-center justify-between">
            <label for="input-glr" class="text-xs font-semibold text-ink">
              {d.glrLabel}
            </label>
            <span id="display-glr" class="text-xs font-mono font-bold text-emerald-400">1.8 kg/kg</span>
          </div>
          <input type="range" id="input-glr" min="0.5" max="3.0" step="0.1" value="1.8" class="w-full accent-emerald-500 cursor-pointer" />
          <p class="text-[11px] text-muted">{d.glrHelp}</p>
        </div>

        <!-- Cryogenic Freezing Temperature -->
        <div class="space-y-1.5">
          <div class="flex items-center justify-between">
            <label for="input-cryo" class="text-xs font-semibold text-ink">
              {d.cryoLabel}
            </label>
            <span id="display-cryo" class="text-xs font-mono font-bold text-emerald-400">-160 °C</span>
          </div>
          <input type="range" id="input-cryo" min="-196" max="-60" step="5" value="-160" class="w-full accent-emerald-500 cursor-pointer" />
          <p class="text-[11px] text-muted">{d.cryoHelp}</p>
        </div>

        <!-- Sublimation Vacuum Chamber Pressure -->
        <div class="space-y-1.5">
          <div class="flex items-center justify-between">
            <label for="input-vacuum" class="text-xs font-semibold text-ink">
              {d.vacuumLabel}
            </label>
            <span id="display-vacuum" class="text-xs font-mono font-bold text-emerald-400">0.08 mbar</span>
          </div>
          <input type="range" id="input-vacuum" min="0.04" max="0.40" step="0.01" value="0.08" class="w-full accent-emerald-500 cursor-pointer" />
          <p class="text-[11px] text-muted">{d.vacuumHelp}</p>
        </div>

        <!-- Primary Sublimation Shelf Temperature -->
        <div class="space-y-1.5">
          <div class="flex items-center justify-between">
            <label for="input-shelf" class="text-xs font-semibold text-ink">
              {d.shelfLabel}
            </label>
            <span id="display-shelf" class="text-xs font-mono font-bold text-emerald-400">-15 °C</span>
          </div>
          <input type="range" id="input-shelf" min="-25" max="20" step="1" value="-15" class="w-full accent-emerald-500 cursor-pointer" />
          <p class="text-[11px] text-muted">{d.shelfHelp}</p>
        </div>

        <!-- CO2 Recovery Toggle -->
        <div class="pt-2 flex items-center justify-between border-t border-hairline/60">
          <div>
            <span class="text-xs font-semibold text-ink block">{d.recoveryLabel}</span>
            <span class="text-[11px] text-muted">{d.recoveryHelp}</span>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" id="input-recovery" checked class="sr-only peer" />
            <div class="w-11 h-6 bg-slate-700 peer-focus:outline-hidden rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-600"></div>
          </label>
        </div>
      </div>
    </div>

    <!-- Diagnostic Readout (Right 6 Cols) -->
    <div class="lg:col-span-6 space-y-6">
      <div class="bg-surface-soft border border-hairline rounded-3xl p-6 sm:p-8 space-y-6 shadow-sm">
        <div class="border-b border-hairline/60 pb-4">
          <h2 class="text-lg font-bold text-ink tracking-tight flex items-center gap-2">
            <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
            {d.diagnosticTitle}
          </h2>
          <p class="text-xs text-muted mt-1">{d.diagnosticSub}</p>
        </div>

        <!-- Primary KPI Cards Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Retained Bioactivity -->
          <div class="p-4 rounded-2xl bg-surface border border-hairline space-y-1">
            <span class="text-[11px] text-muted font-medium block">{d.activityLabel}</span>
            <div class="flex items-baseline gap-2">
              <span id="res-activity" class="text-2xl font-black text-emerald-400 font-mono">98.8%</span>
              <span class="text-[10px] text-muted">&gt; 96% Target</span>
            </div>
            <div class="w-full bg-slate-800 rounded-full h-1.5 mt-2 overflow-hidden">
              <div id="bar-activity" class="bg-emerald-500 h-full rounded-full transition-all" style="width: 98.8%"></div>
            </div>
          </div>

          <!-- Droplet Sauter Mean Diameter -->
          <div class="p-4 rounded-2xl bg-surface border border-hairline space-y-1">
            <span class="text-[11px] text-muted font-medium block">{d.dropletLabel}</span>
            <div class="flex items-baseline gap-2">
              <span id="res-droplet" class="text-2xl font-black text-cyan-400 font-mono">16.5 µm</span>
              <span class="text-[10px] text-muted">10–30 µm Ideal</span>
            </div>
            <div class="w-full bg-slate-800 rounded-full h-1.5 mt-2 overflow-hidden">
              <div id="bar-droplet" class="bg-cyan-500 h-full rounded-full transition-all" style="width: 55%"></div>
            </div>
          </div>

          <!-- Reconstitution Solubility Rate -->
          <div class="p-4 rounded-2xl bg-surface border border-hairline space-y-1">
            <span class="text-[11px] text-muted font-medium block">{d.solubilityLabel}</span>
            <div class="flex items-baseline gap-2">
              <span id="res-solubility" class="text-2xl font-black text-emerald-400 font-mono">3.1 s</span>
              <span class="text-[10px] text-muted">&lt; 5.0 s Instant</span>
            </div>
            <div class="w-full bg-slate-800 rounded-full h-1.5 mt-2 overflow-hidden">
              <div id="bar-solubility" class="bg-emerald-500 h-full rounded-full transition-all" style="width: 80%"></div>
            </div>
          </div>

          <!-- Glass Transition Collapse Margin -->
          <div class="p-4 rounded-2xl bg-surface border border-hairline space-y-1">
            <span class="text-[11px] text-muted font-medium block">{d.collapseMarginLabel}</span>
            <div class="flex items-baseline gap-2">
              <span id="res-collapse" class="text-2xl font-black text-emerald-400 font-mono">+3.5 °C</span>
              <span class="text-[10px] text-muted">&gt; +2.0 °C Safe</span>
            </div>
            <div class="w-full bg-slate-800 rounded-full h-1.5 mt-2 overflow-hidden">
              <div id="bar-collapse" class="bg-emerald-500 h-full rounded-full transition-all" style="width: 85%"></div>
            </div>
          </div>
        </div>

        <!-- Secondary Metrics Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 border-t border-hairline/60 pt-4">
          <div class="p-3 rounded-xl bg-surface border border-hairline space-y-1">
            <span class="text-[10px] text-muted block">{d.ssaLabel}</span>
            <span id="res-ssa" class="text-sm font-bold font-mono text-ink">92.4 m²/g</span>
          </div>
          <div class="p-3 rounded-xl bg-surface border border-hairline space-y-1">
            <span class="text-[10px] text-muted block">{d.moistureLabel}</span>
            <span id="res-moisture" class="text-sm font-bold font-mono text-ink">1.15%</span>
          </div>
          <div class="p-3 rounded-xl bg-surface border border-hairline space-y-1">
            <span class="text-[10px] text-muted block">{d.sublimationFluxLabel}</span>
            <span id="res-flux" class="text-sm font-bold font-mono text-ink">2.48 kg/m²·h</span>
          </div>
        </div>

        <!-- Overall Status Banner -->
        <div id="status-card" class="p-4 rounded-2xl border border-emerald-500/30 bg-emerald-950/20 space-y-2 transition-all">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-muted">{d.overallStatusLabel}</span>
            <span id="status-badge" class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-emerald-900/60 text-emerald-300 border border-emerald-700/50">
              OPTIMAL ASEPTIC VITRIFICATION & SUBLIMATION
            </span>
          </div>
          <p id="status-desc" class="text-xs text-ink/80 leading-relaxed">
            The process operates within optimal cryogenic vitrification and sub-collapse vacuum sublimation zones. Droplet size ensures uniform meso-porosity, protein folding is preserved (>98%), and reconstitution solubility occurs in under 4 seconds without cake meltback.
          </p>
        </div>
      </div>

      <!-- Compliance Badges -->
      <div class="p-4 rounded-2xl bg-surface-soft border border-hairline flex flex-wrap gap-2 text-xs">
        <span class="px-2.5 py-1 rounded-lg bg-surface border border-hairline font-mono text-muted">3-A Sanitary Standard 45-03 & 74-07</span>
        <span class="px-2.5 py-1 rounded-lg bg-surface border border-hairline font-mono text-muted">EHEDG Class I Aseptic</span>
        <span class="px-2.5 py-1 rounded-lg bg-surface border border-hairline font-mono text-muted">ASME Section VIII Div 1</span>
        <span class="px-2.5 py-1 rounded-lg bg-surface border border-hairline font-mono text-muted">FDA 21 CFR § 111 & § 117 cGMP</span>
      </div>
    </div>
  </main>

  <!-- Interactive Diagram Section -->
  <section class="bg-surface-soft border border-hairline rounded-3xl p-6 sm:p-8 space-y-6 shadow-sm">
    <div class="border-b border-hairline/60 pb-4">
      <h2 class="text-lg font-bold text-ink tracking-tight flex items-center gap-2">
        <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
        </svg>
        {d.diagramTitle}
      </h2>
      <p class="text-xs text-muted mt-1">{d.diagramSub}</p>
    </div>

    <!-- SVG Flow Diagram -->
    <div class="w-full overflow-x-auto">
      <svg class="w-full min-w-[760px] h-auto text-ink font-sans" viewBox="0 0 920 440" fill="none" xmlns="http://www.w3.org/2000/svg">
