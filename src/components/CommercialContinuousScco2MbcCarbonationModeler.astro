    co2DoseHelp: "飲料1リットルあたりに注入される食品グレード炭酸ガス質量 (2.0〜9.0 g/L)。最終炭酸ガスボリュームを決定します。",
    presetsTitle: "産業用クイックプリセット：",
    presetCider: "クラフトサイダー：非加熱酵母殺菌＆精密炭酸ガス注入",
    presetBeer: "ノンアルコールクラフトビール：乳酸菌・変敗菌完全死滅",
    presetJuice: "コールドプレス果汁：FDA HACCP 5-Log病原菌不活性化",
    presetTonic: "強炭酸ボタニカルアダプトゲントニック (高刺激ガス圧)",
    presetHazard: "低圧亜臨界マクロバブル空化＆水撃破損ハザード警告",
    diagnosticTitle: "リアルタイム scCO2-MBC テレメトリ＆殺菌動力学評価",
    diagnosticSub: "炭酸充填ガスボリューム、微生物対数減少値、残存溶存酸素、温度上昇、香気保持率、ASME耐圧安全率を連続計算します。",
    carbonationLabel: "溶存炭酸ガスボリューム (Volumes CO2)：",
    logReductionLabel: "変敗酵母・耐酸性細菌対数減少値：",
    doResidualLabel: "残存溶存酸素量 (DO)：",
    thermalDeltaLabel: "飲料料液の温度上昇 (ΔT_beverage)：",
    retentionLabel: "アロマテルペン・ビタミンC保持率：",
    energyLabel: "比エネルギー消費量：",
    throughputLabel: "連続無菌充填能力：",
    overallStatusLabel: "衛生規格＆無菌総合判定：",
    diagramTitle: "超臨界CO2マイクロバブル溶解＆インライン無菌化システム構成図",
    diagramSub: "高圧プランジャー昇圧、焼結微孔スパージャー、プラグフロー接触管、自動電子背圧弁 (BPR)、低温製缶ラインの模式図。",
    scienceTitle: "scCO2-MBC プロセスの熱力学原理と生体物理学的殺菌機構",
    scienceSub: "高圧稠密流体のヘンリー則修正、Epstein-Plesset気泡物質移動動力学、細胞質内急激酸性化による膜融解、および向流脱気機構の詳解。",
    tableTitle: "商用設備仕様および微生物不活性化基準データ"
  }
};

const d = DICT[lang] || DICT.en;
---

<section class="max-w-6xl mx-auto px-4 py-8 text-ink">
  <!-- Top Badge -->
  <div class="mb-4">
    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-teal-950 text-teal-200 border border-teal-800">
      <svg class="w-3.5 h-3.5 text-teal-400" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/>
      </svg>
      {d.badge}
    </span>
  </div>

  <!-- Header -->
  <div class="mb-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-ink mb-3">
      {d.title}
    </h1>
    <p class="text-base sm:text-lg text-muted max-w-4xl leading-relaxed">
      {d.subtitle}
    </p>
  </div>

  <!-- Interactive Simulator Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mb-12">
    <!-- Controls Column (5 cols) -->
    <div class="lg:col-span-5 bg-surface-soft border border-hairline rounded-2xl p-6 shadow-xs space-y-6">
      <div>
        <h2 class="text-xl font-bold text-ink mb-1">{d.controlsTitle}</h2>
        <p class="text-xs text-muted leading-relaxed">{d.controlsSub}</p>
      </div>

      <!-- Presets -->
      <div class="space-y-2">
        <label class="text-xs font-semibold uppercase tracking-wider text-muted block">{d.presetsTitle}</label>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <button type="button" id="preset-cider" class="text-left text-xs font-medium p-2.5 rounded-lg border border-hairline bg-surface hover:bg-surface-elevated hover:border-teal-600 transition-colors">
            🍏 {d.presetCider}
          </button>
          <button type="button" id="preset-beer" class="text-left text-xs font-medium p-2.5 rounded-lg border border-hairline bg-surface hover:bg-surface-elevated hover:border-teal-600 transition-colors">
            🍺 {d.presetBeer}
          </button>
          <button type="button" id="preset-juice" class="text-left text-xs font-medium p-2.5 rounded-lg border border-hairline bg-surface hover:bg-surface-elevated hover:border-teal-600 transition-colors">
            🍊 {d.presetJuice}
          </button>
          <button type="button" id="preset-tonic" class="text-left text-xs font-medium p-2.5 rounded-lg border border-hairline bg-surface hover:bg-surface-elevated hover:border-teal-600 transition-colors">
            🌿 {d.presetTonic}
          </button>
        </div>
        <button type="button" id="preset-hazard" class="w-full text-left text-xs font-medium p-2.5 rounded-lg border border-rose-800/60 bg-rose-950/20 text-rose-300 hover:bg-rose-950/40 transition-colors mt-1">
          ⚠️ {d.presetHazard}
        </button>
      </div>

      <div class="border-t border-hairline/60 pt-4 space-y-4">
        <!-- Architecture Dropdown -->
        <div>
          <label for="system-select" class="block text-xs font-semibold text-ink mb-1">{d.systemLabel}</label>
          <select id="system-select" class="w-full bg-surface border border-hairline rounded-lg px-3 py-2 text-xs text-ink focus:outline-none focus:border-teal-500">
            {scco2Data.systemArchitectures.map(s => (
              <option value={s.id}>{s.name}</option>
            ))}
          </select>
          <p class="text-[11px] text-muted mt-1">{d.systemHelp}</p>
        </div>

        <!-- Target Beverage Matrix Dropdown -->
        <div>
          <label for="matrix-select" class="block text-xs font-semibold text-ink mb-1">{d.matrixLabel}</label>
          <select id="matrix-select" class="w-full bg-surface border border-hairline rounded-lg px-3 py-2 text-xs text-ink focus:outline-none focus:border-teal-500">
            {scco2Data.beverageMatrices.map(b => (
              <option value={b.id}>{b.name}</option>
            ))}
          </select>
          <p class="text-[11px] text-muted mt-1">{d.matrixHelp}</p>
        </div>

        <!-- Micro-Bubble Sparger Dropdown -->
        <div>
          <label for="sparger-select" class="block text-xs font-semibold text-ink mb-1">{d.spargerLabel}</label>
          <select id="sparger-select" class="w-full bg-surface border border-hairline rounded-lg px-3 py-2 text-xs text-ink focus:outline-none focus:border-teal-500">
            {scco2Data.microbubbleGenerators.map(m => (
              <option value={m.id}>{m.name}</option>
            ))}
          </select>
          <p class="text-[11px] text-muted mt-1">{d.spargerHelp}</p>
        </div>

        <!-- Sliders -->
        <!-- Pressure Slider -->
        <div>
          <div class="flex justify-between items-center text-xs font-semibold text-ink mb-1">
            <label for="pressure-slider">{d.pressureLabel}</label>
            <span id="pressure-val" class="font-mono text-teal-400 font-bold">120.0 bar</span>
          </div>
          <input type="range" id="pressure-slider" min="40.0" max="160.0" step="1.0" value="120.0" class="w-full accent-teal-500" />
          <p class="text-[11px] text-muted mt-1">{d.pressureHelp}</p>
        </div>

        <!-- Temperature Slider -->
        <div>
          <div class="flex justify-between items-center text-xs font-semibold text-ink mb-1">
            <label for="temp-slider">{d.tempLabel}</label>
            <span id="temp-val" class="font-mono text-teal-400 font-bold">32.0 °C</span>
          </div>
          <input type="range" id="temp-slider" min="15.0" max="45.0" step="0.5" value="32.0" class="w-full accent-teal-500" />
          <p class="text-[11px] text-muted mt-1">{d.tempHelp}</p>
        </div>

        <!-- Dwell Time Slider -->
        <div>
          <div class="flex justify-between items-center text-xs font-semibold text-ink mb-1">
            <label for="dwell-slider">{d.dwellLabel}</label>
            <span id="dwell-val" class="font-mono text-teal-400 font-bold">3.5 s</span>
          </div>
          <input type="range" id="dwell-slider" min="0.5" max="15.0" step="0.1" value="3.5" class="w-full accent-teal-500" />
          <p class="text-[11px] text-muted mt-1">{d.dwellHelp}</p>
        </div>

        <!-- Flow Rate Slider -->
        <div>
          <div class="flex justify-between items-center text-xs font-semibold text-ink mb-1">
            <label for="flow-slider">{d.flowLabel}</label>
            <span id="flow-val" class="font-mono text-teal-400 font-bold">4,500 L/h</span>
          </div>
          <input type="range" id="flow-slider" min="500" max="8000" step="100" value="4500" class="w-full accent-teal-500" />
          <p class="text-[11px] text-muted mt-1">{d.flowHelp}</p>
        </div>

        <!-- CO2 Dosing Ratio Slider -->
        <div>
          <div class="flex justify-between items-center text-xs font-semibold text-ink mb-1">
            <label for="co2-dose-slider">{d.co2DoseLabel}</label>
            <span id="co2-dose-val" class="font-mono text-teal-400 font-bold">5.8 g/L</span>
          </div>
          <input type="range" id="co2-dose-slider" min="2.0" max="9.0" step="0.1" value="5.8" class="w-full accent-teal-500" />
          <p class="text-[11px] text-muted mt-1">{d.co2DoseHelp}</p>
        </div>
      </div>
    </div>

    <!-- Telemetry & Diagnostic Column (7 cols) -->
    <div class="lg:col-span-7 space-y-6">
      <div class="bg-surface-soft border border-hairline rounded-2xl p-6 shadow-xs">
        <div class="flex items-center justify-between mb-4">
          <div>
            <h2 class="text-xl font-bold text-ink mb-1">{d.diagnosticTitle}</h2>
            <p class="text-xs text-muted">{d.diagnosticSub}</p>
          </div>
          <span id="status-pill" class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-950 text-emerald-300 border border-emerald-800">
            OPTIMAL • ASEPTIC COLD PASS
          </span>
        </div>

        <!-- Telemetry Cards Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mb-6">
          <!-- Carbonation Level -->
          <div class="bg-surface border border-hairline/80 rounded-xl p-3 flex flex-col justify-between">
            <span class="text-[11px] text-muted font-medium">{d.carbonationLabel}</span>
            <div class="mt-2">
              <span id="out-carbonation" class="text-xl font-mono font-bold text-ink">2.95</span>
              <span class="text-xs text-muted ml-1">vols CO2</span>
            </div>
            <div id="out-carbonation-sub" class="text-[10px] text-teal-400 mt-1">5.8 g/L • Crisp Fizz</div>
          </div>

          <!-- Microbial Log Reduction -->
          <div class="bg-surface border border-hairline/80 rounded-xl p-3 flex flex-col justify-between">
            <span class="text-[11px] text-muted font-medium">{d.logReductionLabel}</span>
            <div class="mt-2">
              <span id="out-log-red" class="text-xl font-mono font-bold text-emerald-400">&gt; 6.8</span>
              <span class="text-xs text-muted ml-1">log kill</span>
            </div>
            <div id="out-log-red-sub" class="text-[10px] text-emerald-400 mt-1">FDA Juice HACCP PASS</div>
          </div>

          <!-- Dissolved Oxygen Residual -->
          <div class="bg-surface border border-hairline/80 rounded-xl p-3 flex flex-col justify-between">
            <span class="text-[11px] text-muted font-medium">{d.doResidualLabel}</span>
            <div class="mt-2">
              <span id="out-do-residual" class="text-xl font-mono font-bold text-ink">8.2</span>
              <span class="text-xs text-muted ml-1">ppb DO</span>
            </div>
            <div id="out-do-residual-sub" class="text-[10px] text-emerald-400 mt-1">Target &lt; 15 ppb OK</div>
          </div>

          <!-- Thermal Delta -->
          <div class="bg-surface border border-hairline/80 rounded-xl p-3 flex flex-col justify-between">
            <span class="text-[11px] text-muted font-medium">{d.thermalDeltaLabel}</span>
            <div class="mt-2">
              <span id="out-thermal-delta" class="text-xl font-mono font-bold text-teal-400">0.0</span>
              <span class="text-xs text-muted ml-1">°C rise</span>
            </div>
            <div class="text-[10px] text-teal-400 mt-1">Pure Non-Thermal</div>
          </div>

          <!-- Aroma / Vitamin Retention -->
          <div class="bg-surface border border-hairline/80 rounded-xl p-3 flex flex-col justify-between">
            <span class="text-[11px] text-muted font-medium">{d.retentionLabel}</span>
            <div class="mt-2">
              <span id="out-retention" class="text-xl font-mono font-bold text-emerald-400">99.6%</span>
            </div>
            <div id="out-retention-sub" class="text-[10px] text-emerald-400 mt-1">Zero Cooked Notes</div>
          </div>

          <!-- Energy Consumption -->
          <div class="bg-surface border border-hairline/80 rounded-xl p-3 flex flex-col justify-between">
            <span class="text-[11px] text-muted font-medium">{d.energyLabel}</span>
            <div class="mt-2">
              <span id="out-energy" class="text-xl font-mono font-bold text-ink">1.42</span>
              <span class="text-xs text-muted ml-1">kWh/hL</span>
            </div>
            <div class="text-[10px] text-teal-400 mt-1">68% Less Than Steam</div>
          </div>
        </div>

        <!-- Packaging Throughput & Machine Telemetry -->
        <div class="border-t border-hairline/60 pt-4 space-y-3">
          <div class="flex items-center justify-between text-xs">
            <span class="text-muted">{d.throughputLabel}</span>
            <span id="out-throughput-metric" class="font-mono font-bold text-ink">4,500 L/h (211 cans/min 355mL)</span>
          </div>
          <div class="flex items-center justify-between text-xs">
            <span class="text-muted">CO2 Phase Regime & Micro-Bubble Size:</span>
            <span id="out-phase-metric" class="font-mono font-medium text-teal-300">Supercritical scCO2 (ρ = 712 kg/m³) • d32 = 2.4 µm</span>
          </div>
          <div class="flex items-center justify-between text-xs">
            <span class="text-muted">Interfacial Mass Transfer Surface Area:</span>
            <span id="out-interfacial-metric" class="font-mono font-medium text-ink">28,500 m²/m³ contact area</span>
          </div>
          <div class="flex items-center justify-between text-xs">
            <span class="text-muted">ASME & 3-A Sanitary Pressure Safety Factor:</span>
            <span id="out-safety-metric" class="font-mono font-bold text-emerald-400">SF = 2.45 (MAWP 185 bar • Overpressure OK)</span>
          </div>
        </div>
      </div>

      <!-- Architectural SVG Diagram -->
      <div class="bg-surface-soft border border-hairline rounded-2xl p-6 shadow-xs">
        <div class="mb-4">
          <h3 class="text-base font-bold text-ink mb-0.5">{d.diagramTitle}</h3>
          <p class="text-xs text-muted">{d.diagramSub}</p>
        </div>

        <div class="relative w-full aspect-[16/9] bg-surface rounded-xl border border-hairline overflow-hidden flex items-center justify-center p-2">
          <svg viewBox="0 0 800 450" class="w-full h-full text-slate-300 font-sans select-none">
            <defs>
              <linearGradient id="scGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#0d9488" stop-opacity="0.8"/>
                <stop offset="100%" stop-color="#042f2e" stop-opacity="0.9"/>
              </linearGradient>
              <linearGradient id="bubbleGradient" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#2dd4bf" stop-opacity="0.9"/>
                <stop offset="100%" stop-color="#0f766e" stop-opacity="0.4"/>
              </linearGradient>
              <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
                <feGaussianBlur stdDeviation="3" result="glow"/>
                <feComposite in="SourceGraphic" in2="glow" operator="over"/>
              </filter>
            </defs>

            <!-- Background Grid Lines -->
            <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
              <path d="M 40 0 L 0 0 0 40" fill="none" stroke="currentColor" stroke-opacity="0.05" stroke-width="1"/>
            </pattern>
            <rect width="800" height="450" fill="url(#grid)"/>

            <!-- High Pressure Liquid Infeed Pump -->
            <rect x="50" y="190" width="110" height="90" rx="8" fill="#1e293b" stroke="#334155" stroke-width="2"/>
            <text x="105" y="225" text-anchor="middle" fill="#f8fafc" font-size="11" font-weight="bold">HIGH-PRESSURE</text>
            <text x="105" y="240" text-anchor="middle" fill="#94a3b8" font-size="9">Liquid Beverage Feed</text>
            <text x="105" y="255" text-anchor="middle" fill="#2dd4bf" font-size="10" font-family="monospace">P = 120 bar</text>

            <!-- CO2 Booster Storage & Compressor -->
            <rect x="50" y="60" width="110" height="80" rx="8" fill="#042f2e" stroke="#0d9488" stroke-width="2"/>
            <text x="105" y="95" text-anchor="middle" fill="#2dd4bf" font-size="11" font-weight="bold">scCO2 BOOSTER</text>
            <text x="105" y="110" text-anchor="middle" fill="#99f6e4" font-size="9">Supercritical Density</text>
            <text x="105" y="125" text-anchor="middle" fill="#5eead4" font-size="9" font-family="monospace">712 kg/m³ • 32°C</text>

            <!-- Arrow from CO2 to Sparger -->
            <path d="M 160 100 L 230 100 L 230 190" fill="none" stroke="#2dd4bf" stroke-width="2.5" stroke-dasharray="4 2"/>

            <!-- Arrow from Beverage Feed to Chamber -->
            <path d="M 160 235 L 210 235" fill="none" stroke="#38bdf8" stroke-width="3"/>

            <!-- Main High-Pressure Micro-Bubble Contactor Vessel -->
            <rect x="210" y="170" width="280" height="130" rx="12" fill="url(#scGradient)" stroke="#14b8a6" stroke-width="2.5" filter="url(#glow)"/>
            
            <!-- Sintered Nano-Porous Titanium Sparger Element -->
            <rect x="225" y="215" width="40" height="40" rx="4" fill="#334155" stroke="#94a3b8" stroke-width="1.5"/>
            <text x="245" y="238" text-anchor="middle" fill="#f1f5f9" font-size="8" font-weight="bold">Ti-SPARGER</text>
            <text x="245" y="248" text-anchor="middle" fill="#67e8f9" font-size="7">0.8 µm</text>

            <!-- Dispersed Micro-Bubbles Visual Cloud -->
            <circle cx="280" cy="220" r="4" fill="#ccfbf1"/>
            <circle cx="300" cy="245" r="3" fill="#99f6e4"/>
            <circle cx="320" cy="205" r="5" fill="#5eead4"/>
            <circle cx="340" cy="235" r="3.5" fill="#ccfbf1"/>
            <circle cx="365" cy="215" r="4" fill="#99f6e4"/>
            <circle cx="390" cy="245" r="4.5" fill="#5eead4"/>
            <circle cx="410" cy="210" r="3" fill="#ccfbf1"/>
            <circle cx="435" cy="235" r="5" fill="#99f6e4"/>
            <circle cx="460" cy="225" r="3.5" fill="#5eead4"/>

            <text x="360" y="195" text-anchor="middle" fill="#f0fdfa" font-size="12" font-weight="bold">PLUG-FLOW DENSE-PHASE CONTACTOR</text>
            <text x="360" y="275" text-anchor="middle" fill="#99f6e4" font-size="9">Instant Henry's Law Dissolution • Membrane Cell Lysis &gt;6.5 Log</text>
            <text x="360" y="290" text-anchor="middle" fill="#a7f3d0" font-size="9" font-family="monospace">t_dwell: 3.5s • ΔT: 0.0°C • DO &lt; 10 ppb</text>

            <!-- ASME Rupture Disk Safety Valve -->
            <path d="M 350 170 L 350 135" fill="none" stroke="#f43f5e" stroke-width="2"/>
            <rect x="325" y="110" width="50" height="25" rx="4" fill="#881337" stroke="#f43f5e" stroke-width="1.5"/>
            <text x="350" y="126" text-anchor="middle" fill="#ffe4e6" font-size="8" font-weight="bold">ASME DISK</text>

            <!-- Piping to Back-Pressure Regulator (BPR) -->
            <path d="M 490 235 L 540 235" fill="none" stroke="#2dd4bf" stroke-width="3"/>

            <!-- Electronic Sanitary Back-Pressure Regulator Valve (BPR) -->
            <polygon points="540,215 570,235 540,255" fill="#1e293b" stroke="#38bdf8" stroke-width="2"/>
            <polygon points="600,215 570,235 600,255" fill="#1e293b" stroke="#38bdf8" stroke-width="2"/>
            <rect x="560" y="190" width="20" height="25" fill="#0284c7"/>
            <text x="570" y="180" text-anchor="middle" fill="#e0f2fe" font-size="10" font-weight="bold">AUTO BPR</text>
            <text x="570" y="275" text-anchor="middle" fill="#94a3b8" font-size="8">Controlled Depressurization</text>

            <!-- Cold Aseptic Packaging / Canning Filler Line -->
            <path d="M 600 235 L 650 235" fill="none" stroke="#34d399" stroke-width="3"/>
            <rect x="650" y="190" width="110" height="90" rx="8" fill="#064e3b" stroke="#059669" stroke-width="2"/>
            <text x="705" y="225" text-anchor="middle" fill="#a7f3d0" font-size="11" font-weight="bold">COLD CAN FILLER</text>
            <text x="705" y="240" text-anchor="middle" fill="#d1fae5" font-size="9">Aseptic Counter-Pressure</text>
            <text x="705" y="255" text-anchor="middle" fill="#34d399" font-size="10" font-family="monospace">2.95 vols • DO &lt; 10 ppb</text>

            <!-- Legend and Standards -->
            <rect x="50" y="340" width="710" height="75" rx="8" fill="#0f172a" stroke="#1e293b" stroke-width="1.5"/>
            <text x="70" y="365" fill="#38bdf8" font-size="10" font-weight="bold">Process Integrity:</text>
            <text x="180" y="365" fill="#cbd5e1" font-size="10">ASME Section VIII Div 1 (185 bar rating) • 3-A Sanitary Standard 04-05 &amp; 44-03 • EHEDG Class I Aseptic</text>
            <text x="70" y="392" fill="#34d399" font-size="10" font-weight="bold">Sanitary Validation:</text>
            <text x="180" y="392" fill="#cbd5e1" font-size="10">FDA 21 CFR § 120 Juice HACCP (5-log reduction) • GRAS Direct Food Substance (FDA 21 CFR § 184.1240)</text>
          </svg>
        </div>
      </div>
    </div>
  </div>

  <!-- Scientific Biophysical Foundations -->
  <div class="border-t border-hairline pt-12 max-w-4xl mx-auto space-y-8">
    <div class="text-center">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-ink tracking-tight">{d.scienceTitle}</h2>
      <p class="text-sm text-muted mt-2">{d.scienceSub}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="bg-surface-soft border border-hairline rounded-2xl p-6 shadow-xs">
        <h3 class="text-base font-bold text-ink mb-2">1. Dense-Phase CO2 Solubility &amp; Henry's Law</h3>
        <p class="text-xs text-body leading-relaxed">
          At elevated pressures exceeding the supercritical transition (Pc = 73.8 bar, Tc = 31.1°C), carbon dioxide behaves as a dense-phase fluid with liquid-like density (ρ ≈ 650–800 kg/m³) and gas-like diffusivity (D ≈ 10⁻⁷ m²/s). Dissolution into aqueous beverage streams deviates from ideal Henry's law and is governed by fugacity coefficients:
        </p>
        <div class="my-3 p-3 bg-surface rounded-lg font-mono text-[11px] text-teal-300 overflow-x-auto border border-hairline">
          f_CO2(P, T) = y_CO2 · P · φ_CO2(P, T) = H(T) · x_CO2 · γ_CO2
        </div>
        <p class="text-xs text-body leading-relaxed">
          By dispersing supercritical CO2 through sub-micron titanium pores (Sauter mean diameter d32 &lt; 3.0 µm), the interfacial surface area exceeds 28,000 m²/m³. This eliminates the standard 12-to-24-hour brite tank carbonation bottleneck down to an instantaneous 3.5-second in-line transit.
        </p>
      </div>

      <div class="bg-surface-soft border border-hairline rounded-2xl p-6 shadow-xs">
        <h3 class="text-base font-bold text-ink mb-2">2. Non-Thermal Microbial Lysis Mechanics</h3>
        <p class="text-xs text-body leading-relaxed">
          Unlike thermal pasteurization which denatures proteins and produces cooked off-flavors, scCO2-MBC pasteurizes via five simultaneous non-thermal physical and biochemical mechanisms:
        </p>
        <ul class="text-xs text-body leading-relaxed list-disc list-inside space-y-1 mt-2">
          <li><strong>Fluid Bilayer Solubilization:</strong> scCO2 readily dissolves into hydrophobic fatty acid acyl chains of fungal/bacterial membranes, increasing fluidity and permeability.</li>
          <li><strong>Cytoplasmic Acidification:</strong> Diffused CO2 forms intracellular carbonic acid (H2CO3 ⇌ H⁺ + HCO3⁻), driving internal pH below 4.2 and inactivating vital decarboxylase enzymes.</li>
          <li><strong>Explosive Micro-Depressurization:</strong> Rapid transit across the automatic back-pressure regulator causes rapid expansion of intracellular gas pockets, mechanically rupturing cell walls.</li>
          <li><strong>Cellular De-energization:</strong> Collapse of the trans-membrane proton-motive force inhibits ATP synthesis in yeasts (<em>Zygosaccharomyces bailii</em>) and acid-tolerant spoilage bacilli.</li>
        </ul>
      </div>

      <div class="bg-surface-soft border border-hairline rounded-2xl p-6 shadow-xs">
        <h3 class="text-base font-bold text-ink mb-2">3. Dissolved Oxygen (DO) Stripping</h3>
        <p class="text-xs text-body leading-relaxed">
          Dissolved oxygen is the principal catalyst of oxidative degradation, causing browning, loss of fresh hop terpenes (myrcene, humulene), and rapid ascorbic acid (Vitamin C) oxidation in juices and ciders. In scCO2-MBC, dense-phase CO2 micro-bubbles establish an immense chemical potential gradient:
        </p>
        <div class="my-3 p-3 bg-surface rounded-lg font-mono text-[11px] text-teal-300 overflow-x-auto border border-hairline">
          J_O2 = k_L · a · (C_O2,bulk - C_O2,interface)
        </div>
        <p class="text-xs text-body leading-relaxed">
          Because the injected CO2 micro-bubbles contain zero oxygen, oxygen molecules rapidly desorb from the liquid bulk into the micro-bubbles and are vented, stripping residual DO to below 10 ppb without needing vacuum deaeration tanks.
        </p>
      </div>

      <div class="bg-surface-soft border border-hairline rounded-2xl p-6 shadow-xs">
        <h3 class="text-base font-bold text-ink mb-2">4. ASME &amp; 3-A Sanitary Engineering Compliance</h3>
        <p class="text-xs text-body leading-relaxed">
          High-pressure supercritical food contact equipment requires rigorous mechanical certification:
        </p>
        <ul class="text-xs text-body leading-relaxed list-disc list-inside space-y-1 mt-2">
          <li><strong>ASME Section VIII Div 1:</strong> All pressure vessels, tubes, and manifolds constructed with a 4:1 design factor on tensile strength and 100% full penetration radiographic weld inspection.</li>
          <li><strong>3-A Sanitary Standard 04-05 &amp; 44-03:</strong> Contact surfaces electropolished to Ra ≤ 0.38 µm (15 µ-in) in AISI 316L or Hastelloy C-276, with full Clean-In-Place (CIP) self-drainability.</li>
          <li><strong>FDA Juice HACCP 21 CFR § 120:</strong> Validated &gt;5-log non-thermal reduction of target pathogens (<em>E. coli</em> O157:H7, <em>Salmonella enterica</em>, <em>Listeria monocytogenes</em>).</li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Reference Specifications Table -->
  <div class="border-t border-hairline mt-12 pt-12 max-w-4xl mx-auto">
    <h3 class="text-lg font-bold text-ink mb-4">{d.tableTitle}</h3>
    <div class="overflow-x-auto border border-hairline rounded-xl">
      <table class="w-full text-xs text-left text-body">
        <thead class="bg-surface-soft text-ink uppercase font-semibold border-b border-hairline">
          <tr>
            <th class="px-4 py-3">Beverage Matrix</th>
            <th class="px-4 py-3">Critical Spoilage Target</th>
            <th class="px-4 py-3">Target CO2 Vol</th>
            <th class="px-4 py-3">Pressure (bar)</th>
            <th class="px-4 py-3">D-Value (min)</th>
            <th class="px-4 py-3">Log Inactivation</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline bg-surface">
          {scco2Data.beverageMatrices.map((m, i) => (
            <tr class="hover:bg-surface-soft/50 transition-colors">
              <td class="px-4 py-3 font-semibold text-ink">{m.name}</td>
              <td class="px-4 py-3 font-mono text-muted">{m.spoilageTargetOrganisms.split(',')[0]}</td>
              <td class="px-4 py-3 font-mono text-teal-400 font-bold">{m.targetCarbonationVols} vols</td>
              <td class="px-4 py-3 font-mono">110 - 140 bar</td>
              <td class="px-4 py-3 font-mono">{m.dValueMinAt120Bar32C} min</td>
              <td class="px-4 py-3 font-mono text-emerald-400 font-bold">&gt; 6.2 log</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- Reactive Client Script -->
<script is:inline define:vars={{ scco2Data }}>
  (function initScco2Modeler() {
    const sysSelect = document.getElementById('system-select');
    const matSelect = document.getElementById('matrix-select');
    const sparSelect = document.getElementById('sparger-select');

    const pressureSlider = document.getElementById('pressure-slider');
    const tempSlider = document.getElementById('temp-slider');
    const dwellSlider = document.getElementById('dwell-slider');
    const flowSlider = document.getElementById('flow-slider');
    const co2DoseSlider = document.getElementById('co2-dose-slider');

    const pressureVal = document.getElementById('pressure-val');
    const tempVal = document.getElementById('temp-val');
    const dwellVal = document.getElementById('dwell-val');
    const flowVal = document.getElementById('flow-val');
    const co2DoseVal = document.getElementById('co2-dose-val');

    // Outputs
    const outCarbonation = document.getElementById('out-carbonation');
    const outCarbonationSub = document.getElementById('out-carbonation-sub');
    const outLogRed = document.getElementById('out-log-red');
    const outLogRedSub = document.getElementById('out-log-red-sub');
    const outDoResidual = document.getElementById('out-do-residual');
    const outDoResidualSub = document.getElementById('out-do-residual-sub');
    const outThermalDelta = document.getElementById('out-thermal-delta');
    const outRetention = document.getElementById('out-retention');
    const outRetentionSub = document.getElementById('out-retention-sub');
    const outEnergy = document.getElementById('out-energy');
    const outThroughputMetric = document.getElementById('out-throughput-metric');
    const outPhaseMetric = document.getElementById('out-phase-metric');
    const outInterfacialMetric = document.getElementById('out-interfacial-metric');
    const outSafetyMetric = document.getElementById('out-safety-metric');
    const statusPill = document.getElementById('status-pill');

    function updateSimulation() {
      const P = parseFloat(pressureSlider.value);
      const T = parseFloat(tempSlider.value);
      const t = parseFloat(dwellSlider.value);
      const Q = parseFloat(flowSlider.value);
      const dose = parseFloat(co2DoseSlider.value);

      // Display inputs
      pressureVal.textContent = P.toFixed(1) + ' bar';
      tempVal.textContent = T.toFixed(1) + ' °C';
      dwellVal.textContent = t.toFixed(1) + ' s';
      flowVal.textContent = Math.round(Q).toLocaleString() + ' L/h';
      co2DoseVal.textContent = dose.toFixed(1) + ' g/L';

      const currentSys = scco2Data.systemArchitectures.find(s => s.id === sysSelect.value) || scco2Data.systemArchitectures[0];
      const currentMat = scco2Data.beverageMatrices.find(m => m.id === matSelect.value) || scco2Data.beverageMatrices[0];
      const currentSpar = scco2Data.microbubbleGenerators.find(m => m.id === sparSelect.value) || scco2Data.microbubbleGenerators[0];

      // Carbonation volume conversion: 1 vol CO2 ≈ 1.96 g/L CO2 at STP
      const theoreticalVols = dose / 1.96;
      const dissolutionEfficiency = (currentSpar.co2DissolutionEfficiencyPct / 100) * (P >= 73.8 ? 1.0 : Math.max(0.4, P / 73.8));
      const actualVols = theoreticalVols * dissolutionEfficiency;

      outCarbonation.textContent = actualVols.toFixed(2);
      if (actualVols < 2.0) {
        outCarbonationSub.textContent = dose.toFixed(1) + ' g/L • Still / Soft Fizz';
      } else if (actualVols <= 3.2) {
        outCarbonationSub.textContent = dose.toFixed(1) + ' g/L • Standard Craft Sparkling';
      } else {
        outCarbonationSub.textContent = dose.toFixed(1) + ' g/L • High Sparkling Seltzer';
      }

      // Microbial Inactivation Kinetics
      // D-value scaling: D(P, T) = D_ref * 10^((120 - P)/z_P) * 10^((32 - T)/z_T)
      const dRef = currentMat.dValueMinAt120Bar32C; // in minutes
      const zP = 45.0; // bar required for 10-fold change in D-value
      const zT = 18.0; // °C required for 10-fold change in D-value
      const effD = dRef * Math.pow(10, (120.0 - P) / zP) * Math.pow(10, (32.0 - T) / zT);
      const tMin = t / 60.0;
      
      let spargerFactor = 1.0;
      if (currentSpar.id === 'coarse_drilled_pipe_diffuser') {
        spargerFactor = 0.08; // macro-bubbles fail to lyse cells
      } else if (currentSpar.id === 'ceramic_multi_channel_membrane_contactor') {
        spargerFactor = 1.15;
      }

      let logReduction = (tMin / effD) * spargerFactor;
      if (P < 60.0) {
        logReduction *= (P / 60.0);
      }

      if (logReduction >= 6.5) {
        outLogRed.textContent = '> 6.5';
        outLogRed.className = 'text-xl font-mono font-bold text-emerald-400';
        outLogRedSub.textContent = 'FDA Juice HACCP PASS • Aseptic Commercial Sterility';
        outLogRedSub.className = 'text-[10px] text-emerald-400 mt-1';
      } else if (logReduction >= 5.0) {
        outLogRed.textContent = logReduction.toFixed(1);
        outLogRed.className = 'text-xl font-mono font-bold text-emerald-400';
        outLogRedSub.textContent = 'FDA 5-Log Juice HACCP Compliance Achieved';
        outLogRedSub.className = 'text-[10px] text-emerald-400 mt-1';
      } else if (logReduction >= 3.0) {
        outLogRed.textContent = logReduction.toFixed(1);
        outLogRed.className = 'text-xl font-mono font-bold text-amber-400';
        outLogRedSub.textContent = 'Partial Inactivation • Requires Refrigerated Cold Chain';
        outLogRedSub.className = 'text-[10px] text-amber-400 mt-1';
      } else {
        outLogRed.textContent = logReduction.toFixed(1);
        outLogRed.className = 'text-xl font-mono font-bold text-rose-400';
        outLogRedSub.textContent = 'FAIL • Spoilage Risk (Yeasts / Lactic Bacteria Survive)';
        outLogRedSub.className = 'text-[10px] text-rose-400 mt-1';
      }

      // Dissolved Oxygen Stripping
      let baseDo = currentSys.dissolvedOxygenStrippingPpb;
      if (currentSpar.id === 'coarse_drilled_pipe_diffuser') {
        baseDo = 120.0; // severe poor stripping
      } else {
        baseDo = baseDo * (120.0 / Math.max(60.0, P)) * (4.0 / Math.max(1.0, actualVols));
      }
      outDoResidual.textContent = Math.max(2.5, baseDo).toFixed(1);
      if (baseDo <= 15.0) {
        outDoResidualSub.textContent = 'Pristine De-Aeration (DO < 15 ppb OK)';
        outDoResidualSub.className = 'text-[10px] text-emerald-400 mt-1';
      } else if (baseDo <= 30.0) {
        outDoResidualSub.textContent = 'Moderate DO • Extended Shelf Life';
        outDoResidualSub.className = 'text-[10px] text-amber-400 mt-1';
      } else {
        outDoResidualSub.textContent = 'HIGH OXYGEN INGRESS (Risk of Staling)';
        outDoResidualSub.className = 'text-[10px] text-rose-400 mt-1';
      }

      // Thermal Delta & Retention
      outThermalDelta.textContent = '0.0';
      if (P >= 75.0 && currentSpar.id !== 'coarse_drilled_pipe_diffuser') {
        outRetention.textContent = '99.6%';
        outRetentionSub.textContent = '100% Native Esters, Terpenes & Vitamin C';
      } else {
        outRetention.textContent = '96.2%';
        outRetentionSub.textContent = 'Subcritical Fluid • Slight Gas Pocket Shear';
      }

      // Specific Energy Consumption
      const baseKwh = currentSys.specificEnergyKwhPerHl;
      const calculatedEnergy = baseKwh * (P / 120.0) * (Q / 4500.0 > 1.0 ? 0.92 : 1.05);
      outEnergy.textContent = calculatedEnergy.toFixed(2);

      // Packaging Throughput
      const cansPerMin = Math.round((Q / 0.355) / 60.0);
      outThroughputMetric.textContent = Math.round(Q).toLocaleString() + ' L/h (' + cansPerMin + ' cans/min 355mL)';

      // Phase & Density
      const isSupercritical = P >= 73.8 && T >= 31.1;
      let density = 712;
      if (isSupercritical) {
        density = Math.round(450 + (P - 73.8) * 3.2);
        outPhaseMetric.textContent = 'Supercritical scCO2 (ρ = ' + density + ' kg/m³) • d32 = ' + currentSpar.sauterMeanDiameterUm + ' µm';
      } else if (P >= 50.0) {
        density = Math.round(780 + (P - 50.0) * 4.0);
        outPhaseMetric.textContent = 'Subcritical Liquid CO2 (ρ = ' + density + ' kg/m³) • d32 = ' + currentSpar.sauterMeanDiameterUm + ' µm';
      } else {
        density = Math.round(15 + P * 1.5);
        outPhaseMetric.textContent = 'Low-Pressure Dense Gas (ρ = ' + density + ' kg/m³) • Macro-Bubbles';
      }

      outInterfacialMetric.textContent = currentSpar.interfacialAreaM2PerM3.toLocaleString() + ' m²/m³ contact area';

      // Safety Factor
      const mawp = 185.0; // Maximum Allowable Working Pressure bar
      const sf = (mawp / P).toFixed(2);
      if (P <= 145.0) {
        outSafetyMetric.textContent = 'SF = ' + sf + ' (MAWP ' + mawp + ' bar • ASME Compliant)';
        outSafetyMetric.className = 'font-mono font-bold text-emerald-400';
      } else if (P <= 160.0) {
        outSafetyMetric.textContent = 'SF = ' + sf + ' (Near MAWP Ceiling • ASME Monitored)';
        outSafetyMetric.className = 'font-mono font-bold text-amber-400';
      } else {
        outSafetyMetric.textContent = 'OVERPRESSURE ALERT (Rupture Disk Trip Threshold)';
        outSafetyMetric.className = 'font-mono font-bold text-rose-400';
      }

      // Status Pill
      if (currentSpar.id === 'coarse_drilled_pipe_diffuser') {
        statusPill.textContent = 'HAZARD • MACRO-BUBBLE CAVITATION / STERILITY FAIL';
        statusPill.className = 'inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-rose-950 text-rose-300 border border-rose-800';
      } else if (logReduction >= 5.0 && baseDo <= 15.0 && P <= 145.0) {
        statusPill.textContent = 'OPTIMAL • ASEPTIC COLD PASS';
        statusPill.className = 'inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-950 text-emerald-300 border border-emerald-800';
      } else {
        statusPill.textContent = 'WARNING • SUB-OPTIMAL PARAMETERS';
        statusPill.className = 'inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-950 text-amber-300 border border-amber-800';
      }
    }

    // Attach listeners
    [sysSelect, matSelect, sparSelect].forEach(el => el.addEventListener('change', updateSimulation));
    [pressureSlider, tempSlider, dwellSlider, flowSlider, co2DoseSlider].forEach(el => el.addEventListener('input', updateSimulation));

    // Preset Handlers
    document.getElementById('preset-cider')?.addEventListener('click', () => {
      sysSelect.value = 'commercial_continuous_rotary_scco2_carbonation_sterilizer';
      matSelect.value = 'craft_hard_cider_perry';
      sparSelect.value = 'sintered_porous_titanium_sparger';
      pressureSlider.value = '120.0';
      tempSlider.value = '32.0';
      dwellSlider.value = '3.5';
      flowSlider.value = '4500';
      co2DoseSlider.value = '5.8';
      updateSimulation();
    });

    document.getElementById('preset-beer')?.addEventListener('click', () => {
      sysSelect.value = 'commercial_continuous_rotary_scco2_carbonation_sterilizer';
      matSelect.value = 'non_alcoholic_craft_beer';
      sparSelect.value = 'sintered_porous_titanium_sparger';
      pressureSlider.value = '130.0';
      tempSlider.value = '34.0';
      dwellSlider.value = '4.0';
      flowSlider.value = '5000';
      co2DoseSlider.value = '5.2';
      updateSimulation();
    });

    document.getElementById('preset-juice')?.addEventListener('click', () => {
      sysSelect.value = 'industrial_continuous_tubular_countercurrent_scco2_contactor';
      matSelect.value = 'cold_pressed_cloudy_citrus_juice';
      sparSelect.value = 'micro_orifice_venturi_vortex_nozzle';
      pressureSlider.value = '140.0';
      tempSlider.value = '35.0';
      dwellSlider.value = '4.5';
      flowSlider.value = '6000';
      co2DoseSlider.value = '4.2';
      updateSimulation();
    });

    document.getElementById('preset-tonic')?.addEventListener('click', () => {
      sysSelect.value = 'sanitary_high_shear_static_mixer_scco2_infuser';
      matSelect.value = 'botanical_herbal_adaptogen_tonic';
      sparSelect.value = 'ceramic_multi_channel_membrane_contactor';
      pressureSlider.value = '110.0';
      tempSlider.value = '28.0';
      dwellSlider.value = '3.0';
      flowSlider.value = '3200';
      co2DoseSlider.value = '7.5';
      updateSimulation();
    });

    document.getElementById('preset-hazard')?.addEventListener('click', () => {
      sysSelect.value = 'commercial_continuous_rotary_scco2_carbonation_sterilizer';
      matSelect.value = 'craft_hard_cider_perry';
      sparSelect.value = 'coarse_drilled_pipe_diffuser';
      pressureSlider.value = '45.0';
      tempSlider.value = '20.0';
      dwellSlider.value = '1.2';
      flowSlider.value = '6500';
      co2DoseSlider.value = '4.0';
      updateSimulation();
    });

    // Initial simulation run
    updateSimulation();
  })();
</script>
