<script>
  interface SystemArch {
    id: string;
    name: string;
    maxOperatingPressureMpa: number;
    pulsedUvPeakFluenceJcm2: number;
    flashPulseFrequencyHz: number;
    continuousThroughputLitersPerHour: number;
    annularGapMm: number;
    typicalSporeLogReduction: number;
    thermalDeltaC: number;
    proteinDenaturationPct: number;
    vitaminCRetentionPct: number;
    specificEnergyKwhPerHl: number;
  }

  interface TargetMatrix {
    id: string;
    name: string;
    turbidityNtu: number;
    viscosityCp: number;
    opticalAbsorbanceA254Cm: number;
    targetPathogen: string;
    homogenizationPressureMpa: number;
    pulsedUvFluenceJcm2: number;
    baselineSporeLogKill: number;
    flavorRetentionPct: number;
  }

  interface HomogenizerNozzle {
    id: string;
    name: string;
    microGapUm: number;
    shearRateSec: number;
    clumpDisruptionEfficiencyPct: number;
  }

  interface PuvcGeometry {
    id: string;
    name: string;
    gapThicknessMm: number;
    uvTransmittancePct: number;
    reynoldsNumber: number;
    peakIrradianceWcm2: number;
  }

  function initDhphModeler() {
    // Selectors
    const sysSelect = document.getElementById('dhph-system-select') as HTMLSelectElement | null;
    const matSelect = document.getElementById('dhph-matrix-select') as HTMLSelectElement | null;
    const nozSelect = document.getElementById('dhph-nozzle-select') as HTMLSelectElement | null;
    const puvcSelect = document.getElementById('dhph-puvc-select') as HTMLSelectElement | null;

    const pressureInput = document.getElementById('dhph-pressure') as HTMLInputElement | null;
    const fluenceInput = document.getElementById('dhph-fluence') as HTMLInputElement | null;
    const freqInput = document.getElementById('dhph-freq') as HTMLInputElement | null;
    const gapInput = document.getElementById('dhph-gap') as HTMLInputElement | null;
    const flowInput = document.getElementById('dhph-flow') as HTMLInputElement | null;
    const tempInput = document.getElementById('dhph-temp') as HTMLInputElement | null;

    const pressureVal = document.getElementById('dhph-pressure-val');
    const fluenceVal = document.getElementById('dhph-fluence-val');
    const freqVal = document.getElementById('dhph-freq-val');
    const gapVal = document.getElementById('dhph-gap-val');
    const flowVal = document.getElementById('dhph-flow-val');
    const tempVal = document.getElementById('dhph-temp-val');

    // Outputs
    const statKill = document.getElementById('dhph-stat-kill');
    const statKillSub = document.getElementById('dhph-stat-kill-sub');
    const barKill = document.getElementById('dhph-bar-kill');
    const statTrans = document.getElementById('dhph-stat-trans');
    const barTrans = document.getElementById('dhph-bar-trans');
    const statShear = document.getElementById('dhph-stat-shear');
    const statShearSub = document.getElementById('dhph-stat-shear-sub');
    const statTemp = document.getElementById('dhph-stat-temp');
    const statTempSub = document.getElementById('dhph-stat-temp-sub');
    const statRetention = document.getElementById('dhph-stat-retention');
    const statEnergy = document.getElementById('dhph-stat-energy');
    const statFlow = document.getElementById('dhph-stat-flow');
    const statStatus = document.getElementById('dhph-stat-status');

    if (!pressureInput || !fluenceInput || !freqInput || !gapInput || !flowInput || !tempInput) return;

    function recalculate() {
      const pVal = parseFloat(pressureInput?.value || '180');
      const fVal = parseFloat(fluenceInput?.value || '25');
      const freqValNum = parseInt(freqInput?.value || '20', 10);
      const gapValNum = parseFloat(gapInput?.value || '0.35');
      const qVal = parseInt(flowInput?.value || '3200', 10);
      const tVal = parseFloat(tempInput?.value || '20');

      if (pressureVal) pressureVal.textContent = `${pVal.toFixed(1)} MPa`;
      if (fluenceVal) fluenceVal.textContent = `${fVal.toFixed(1)} J/cm²`;
      if (freqVal) freqVal.textContent = `${freqValNum} Hz`;
      if (gapVal) gapVal.textContent = `${gapValNum.toFixed(2)} mm`;
      if (flowVal) flowVal.textContent = `${qVal} L/h`;
      if (tempVal) tempVal.textContent = `${tVal.toFixed(1)} °C`;

      const nozId = nozSelect?.value || 'diamond_interaction_chamber';
      const puvcId = puvcSelect?.value || 'annular_thin_film_suprasil';
      const matId = matSelect?.value || 'cloudy_citrus_juice';

      // Nozzle modifier
      let nozzleMultiplier = 1.0;
      let nozzleShearBase = 1.5e7;
      let nozzleName = 'PCD Micro-Nozzle';
      if (nozId === 'ceramic_z_channel_nozzle') {
        nozzleMultiplier = 0.92;
        nozzleShearBase = 9.8e6;
        nozzleName = 'YSZ Z-Valve';
      } else if (nozId === 'tungsten_carbide_radial_seat') {
        nozzleMultiplier = 0.78;
        nozzleShearBase = 4.5e6;
        nozzleName = 'Tungsten Carbide';
      } else if (nozId === 'coarse_spring_poppet_valve') {
        nozzleMultiplier = 0.35;
        nozzleShearBase = 2.5e5;
        nozzleName = 'Coarse Spring Valve';
      }

      // PUVC geometry modifier
      let puvcEfficiency = 1.0;
      let baseTrans = 92.5;
      if (puvcId === 'helical_vortex_quartz_tube') {
        puvcEfficiency = 0.98;
        baseTrans = 89.0;
      } else if (puvcId === 'coaxial_double_jacket_quartz') {
        puvcEfficiency = 0.85;
        baseTrans = 82.0;
      } else if (puvcId === 'wide_bore_static_pipe') {
        puvcEfficiency = 0.20;
        baseTrans = 12.0;
      }

      // Matrix absorbance modifier
      let matrixAbsorbanceFactor = 1.0;
      if (matId === 'liquid_whole_egg') matrixAbsorbanceFactor = 0.88;
      else if (matId === 'plant_based_oat_milk') matrixAbsorbanceFactor = 0.92;
      else if (matId === 'raw_coconut_water') matrixAbsorbanceFactor = 1.08;
      else if (matId === 'dairy_skim_milk') matrixAbsorbanceFactor = 0.94;

      // Calculate optical transmittance through thin film
      // Transmittance decays exponentially with gap thickness
      const effGap = Math.max(0.2, gapValNum);
      const gapPenalty = Math.exp(-1.4 * (effGap - 0.35));
      const calcTransmittance = Math.min(99.5, Math.max(5.0, baseTrans * gapPenalty * (pVal / 180.0) ** 0.15));

      // Calculate actual shear rate
      const actualShearRate = (nozzleShearBase * (pVal / 180.0) ** 0.85);

      // Synergistic Endospore Log Reduction calculation
      // Base DHPH kill: (P / 100)^1.2 * 1.5 * nozzleMultiplier
      const dhphKill = Math.max(0.2, (pVal / 100.0) ** 1.25 * 1.6 * nozzleMultiplier);
      // Base PUVC kill: (Fluence / 10) * (calcTransmittance / 100) * (freq / 20)^0.3 * puvcEfficiency
      const puvcKill = Math.max(0.2, (fVal / 8.0) * (calcTransmittance / 100.0) * (freqValNum / 20.0) ** 0.35 * puvcEfficiency * matrixAbsorbanceFactor);
      // Synergistic interaction term
      const synergyBonus = 0.22 * Math.sqrt(dhphKill * puvcKill);
      const totalLogKill = Math.min(8.5, dhphKill + puvcKill + synergyBonus);

      // Fluid temperature rise
      // P in MPa -> approx 2.0 to 2.5 °C rise per 100 MPa in adiabatic, but with cooling jacket ΔT is muted
      const tempDelta = Math.max(0.8, (pVal / 100.0) * 1.45 + (fVal / 45.0) * 0.85);
      const exitTemp = tVal + tempDelta;

      // Retention of Vitamin C and freshness
      let retentionVal = 99.8 - (tempDelta * 0.25) - ((pVal - 100) * 0.003);
      if (matId === 'raw_coconut_water' && exitTemp > 35.0) retentionVal -= 3.0;
      retentionVal = Math.min(99.9, Math.max(88.0, retentionVal));

      // Specific energy consumption (kWh/hL)
      const secVal = (pVal * 0.0075 + (fVal / 25.0) * 0.65).toFixed(2);

      // Update DOM
      if (statKill) statKill.textContent = `${totalLogKill.toFixed(2)} log`;
      if (statKillSub) {
        if (totalLogKill >= 6.0) {
          statKillSub.textContent = '> 99.9999% Inactivation (Aseptic)';
          statKillSub.className = 'text-xs font-semibold text-emerald-400';
          if (statKill) statKill.className = 'text-2xl sm:text-3xl font-extrabold text-emerald-400 font-mono';
        } else if (totalLogKill >= 5.0) {
          statKillSub.textContent = '> 99.999% FDA Juice HACCP Met';
          statKillSub.className = 'text-xs font-semibold text-emerald-300';
          if (statKill) statKill.className = 'text-2xl sm:text-3xl font-extrabold text-emerald-300 font-mono';
        } else {
          statKillSub.textContent = 'Sub-Sterile (<5.0 log Spore Kill)';
          statKillSub.className = 'text-xs font-semibold text-rose-400';
          if (statKill) statKill.className = 'text-2xl sm:text-3xl font-extrabold text-rose-400 font-mono';
        }
      }
      if (barKill) {
        const killPct = Math.min(100, (totalLogKill / 7.0) * 100);
        barKill.style.width = `${killPct}%`;
        barKill.className = totalLogKill >= 6.0 ? 'bg-emerald-500 h-full rounded-full transition-all duration-300' : (totalLogKill >= 5.0 ? 'bg-amber-500 h-full rounded-full transition-all duration-300' : 'bg-rose-500 h-full rounded-full transition-all duration-300');
      }

      if (statTrans) statTrans.textContent = `${calcTransmittance.toFixed(1)}%`;
      if (barTrans) barTrans.style.width = `${calcTransmittance}%`;

      if (statShear) {
        const expStr = actualShearRate >= 1e7 ? `${(actualShearRate / 1e7).toFixed(2)} × 10⁷ s⁻¹` : `${(actualShearRate / 1e6).toFixed(2)} × 10⁶ s⁻¹`;
        statShear.textContent = expStr;
      }
      if (statShearSub) statShearSub.textContent = nozzleName;

      if (statTemp) statTemp.textContent = `+${tempDelta.toFixed(1)}°C (T_exit = ${exitTemp.toFixed(1)}°C)`;
      if (statTempSub) {
        if (matId === 'liquid_whole_egg') {
          if (exitTemp >= 52.0) {
            statTempSub.textContent = 'CRITICAL: Egg Protein Coagulating!';
            statTempSub.className = 'text-xs text-rose-400 font-bold';
          } else {
            statTempSub.textContent = 'Egg Coagulation Risk: 0.0% (Safe)';
            statTempSub.className = 'text-xs text-emerald-400 font-semibold';
          }
        } else {
          statTempSub.textContent = exitTemp < 40.0 ? 'Cold Processing Mode' : 'Mild Thermal Assist';
          statTempSub.className = 'text-xs text-teal-300 font-semibold';
        }
      }

      if (statRetention) statRetention.textContent = `${retentionVal.toFixed(1)}%`;
      if (statEnergy) statEnergy.textContent = `${secVal} kWh/hL`;
      if (statFlow) statFlow.textContent = `${qVal.toLocaleString()} L/h`;

      if (statStatus) {
        if (totalLogKill >= 6.0 && (matId !== 'liquid_whole_egg' || exitTemp < 52.0)) {
          statStatus.innerHTML = '<span class="inline-block w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span> ASME SEC VIII &bull; 3-A 04-05 &bull; FDA 21 CFR § 120 COMPLIANT';
          statStatus.className = 'text-xs font-bold text-emerald-400 flex items-center gap-2';
        } else if (totalLogKill >= 5.0) {
          statStatus.innerHTML = '<span class="inline-block w-2.5 h-2.5 rounded-full bg-amber-400"></span> FDA JUICE HACCP VALIDATED (5-LOG MET, NON-COMMERCIAL SPORE STERILE)';
          statStatus.className = 'text-xs font-bold text-amber-300 flex items-center gap-2';
        } else {
          statStatus.innerHTML = '<span class="inline-block w-2.5 h-2.5 rounded-full bg-rose-500"></span> NON-COMPLIANT: INSUFFICIENT LETHALITY / HAZARDOUS PROCESS';
          statStatus.className = 'text-xs font-bold text-rose-400 flex items-center gap-2';
        }
      }
    }

    // Attach Event Listeners
    [pressureInput, fluenceInput, freqInput, gapInput, flowInput, tempInput].forEach(inp => {
      inp?.addEventListener('input', recalculate);
    });

    [sysSelect, matSelect, nozSelect, puvcSelect].forEach(sel => {
      sel?.addEventListener('change', recalculate);
    });

    // Presets
    document.getElementById('dhph-preset-citrus')?.addEventListener('click', () => {
      if (sysSelect) sysSelect.value = 'industrial_continuous_dhph_puvc_skid';
      if (matSelect) matSelect.value = 'cloudy_citrus_juice';
      if (nozSelect) nozSelect.value = 'diamond_interaction_chamber';
      if (puvcSelect) puvcSelect.value = 'annular_thin_film_suprasil';
      if (pressureInput) pressureInput.value = '180.0';
      if (fluenceInput) fluenceInput.value = '25.0';
      if (freqInput) freqInput.value = '20';
      if (gapInput) gapInput.value = '0.35';
      if (flowInput) flowInput.value = '3500';
      if (tempInput) tempInput.value = '20.0';
      recalculate();
    });

    document.getElementById('dhph-preset-egg')?.addEventListener('click', () => {
      if (sysSelect) sysSelect.value = 'aseptic_liquid_egg_cold_pasteurizer';
      if (matSelect) matSelect.value = 'liquid_whole_egg';
      if (nozSelect) nozSelect.value = 'ceramic_z_channel_nozzle';
      if (puvcSelect) puvcSelect.value = 'annular_thin_film_suprasil';
      if (pressureInput) pressureInput.value = '150.0';
      if (fluenceInput) fluenceInput.value = '22.0';
      if (freqInput) freqInput.value = '15';
      if (gapInput) gapInput.value = '0.40';
      if (flowInput) flowInput.value = '2500';
      if (tempInput) tempInput.value = '15.0';
      recalculate();
    });

    document.getElementById('dhph-preset-oat')?.addEventListener('click', () => {
      if (sysSelect) sysSelect.value = 'sanitary_thin_film_vortex_dhph_puvc_reactor';
      if (matSelect) matSelect.value = 'plant_based_oat_milk';
      if (nozSelect) nozSelect.value = 'diamond_interaction_chamber';
      if (puvcSelect) puvcSelect.value = 'helical_vortex_quartz_tube';
      if (pressureInput) pressureInput.value = '200.0';
      if (fluenceInput) fluenceInput.value = '30.0';
      if (freqInput) freqInput.value = '25';
      if (gapInput) gapInput.value = '0.50';
      if (flowInput) flowInput.value = '3200';
      if (tempInput) tempInput.value = '22.0';
      recalculate();
    });

    document.getElementById('dhph-preset-coconut')?.addEventListener('click', () => {
      if (sysSelect) sysSelect.value = 'sanitary_thin_film_vortex_dhph_puvc_reactor';
      if (matSelect) matSelect.value = 'raw_coconut_water';
      if (nozSelect) nozSelect.value = 'ceramic_z_channel_nozzle';
      if (puvcSelect) puvcSelect.value = 'annular_thin_film_suprasil';
      if (pressureInput) pressureInput.value = '120.0';
      if (fluenceInput) fluenceInput.value = '18.0';
      if (freqInput) freqInput.value = '18';
      if (gapInput) gapInput.value = '0.35';
      if (flowInput) flowInput.value = '4000';
      if (tempInput) tempInput.value = '18.0';
      recalculate();
    });

    document.getElementById('dhph-preset-hazard')?.addEventListener('click', () => {
      if (sysSelect) sysSelect.value = 'industrial_continuous_dhph_puvc_skid';
      if (matSelect) matSelect.value = 'liquid_whole_egg';
      if (nozSelect) nozSelect.value = 'coarse_spring_poppet_valve';
      if (puvcSelect) puvcSelect.value = 'wide_bore_static_pipe';
      if (pressureInput) pressureInput.value = '50.0';
      if (fluenceInput) fluenceInput.value = '5.0';
      if (freqInput) freqInput.value = '5';
      if (gapInput) gapInput.value = '2.00';
      if (flowInput) flowInput.value = '5500';
      if (tempInput) tempInput.value = '35.0';
      recalculate();
    });

    // Initial calculation
    recalculate();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDhphModeler);
  } else {
    initDhphModeler();
  }
</script>
