const d = DICTIONARY[lang] || DICTIONARY.en;
---

<section class="bg-surface border border-hairline rounded-3xl p-6 md:p-10 shadow-sm transition-all" id="refrigerator-contamination-tool">
  <!-- Top Badge & Title -->
  <div class="mb-8">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-rose-500/10 text-rose-900 border border-rose-500/20 mb-3">
      <span>🦠</span>
      {d.badge}
    </div>
    <h2 class="text-2xl md:text-4xl font-extrabold text-ink tracking-tight mb-3">
      {d.title}
    </h2>
    <p class="text-muted text-sm md:text-base leading-relaxed max-w-4xl">
      {d.subtitle}
    </p>
  </div>

  <!-- Presets Bar -->
  <div class="bg-surface-soft border border-hairline rounded-2xl p-4 md:p-5 mb-8">
    <div class="text-xs font-bold uppercase tracking-wider text-muted mb-3 flex items-center gap-1.5">
      <span>⚡</span>
      {d.presetsTitle}
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2.5 text-xs font-medium">
      <button type="button" class="preset-btn text-left p-3 rounded-xl border border-rose-500/30 bg-rose-500/5 hover:bg-rose-500/15 text-rose-950 transition-colors" data-preset="poultry-wire">
        ⚠️ {d.presetPoultryWire}
      </button>
      <button type="button" class="preset-btn text-left p-3 rounded-xl border border-amber-500/30 bg-amber-500/5 hover:bg-amber-500/15 text-amber-950 transition-colors" data-preset="beef-glass">
        🥩 {d.presetGroundBeefGlass}
      </button>
      <button type="button" class="preset-btn text-left p-3 rounded-xl border border-purple-500/30 bg-purple-500/5 hover:bg-purple-500/15 text-purple-950 transition-colors" data-preset="seafood-melon">
        🍈 {d.presetSeafoodMelonFan}
      </button>
      <button type="button" class="preset-btn text-left p-3 rounded-xl border border-orange-500/30 bg-orange-500/5 hover:bg-orange-500/15 text-orange-950 transition-colors" data-preset="vinegar-fail">
        🧴 {d.presetVinegarFailure}
      </button>
      <button type="button" class="preset-btn text-left p-3 rounded-xl border border-emerald-500/30 bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-950 transition-colors font-semibold" data-preset="usda-gold">
        🛡️ {d.presetUsdaGoldStandard}
      </button>
    </div>
  </div>

  <!-- Interactive Grid: Controls & Diagnostics -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mb-10">
    <!-- Controls (7 Cols) -->
    <div class="lg:col-span-7 bg-surface-soft border border-hairline rounded-2xl p-6 space-y-6">
      <div class="border-b border-hairline pb-4">
        <h3 class="text-lg font-bold text-ink mb-1">{d.controlsTitle}</h3>
        <p class="text-xs text-muted">{d.controlsSub}</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <!-- 1. Protein Purge Source -->
        <div>
          <label for="rc-protein" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5">
            {d.proteinLabel}
          </label>
          <select id="rc-protein" class="w-full bg-surface border border-hairline rounded-xl px-3.5 py-2.5 text-xs text-ink font-medium focus:ring-2 focus:ring-rose-500 focus:outline-none">
            {modelData.rawProteinPurgeSources.map(p => (
              <option value={p.id}>{p.name}</option>
            ))}
          </select>
          <p class="text-[11px] text-muted mt-1 leading-snug">{d.proteinHelp}</p>
        </div>

        <!-- 2. Elevation / Zone -->
        <div>
          <label for="rc-elevation" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5">
            {d.elevationLabel}
          </label>
          <select id="rc-elevation" class="w-full bg-surface border border-hairline rounded-xl px-3.5 py-2.5 text-xs text-ink font-medium focus:ring-2 focus:ring-rose-500 focus:outline-none">
            {modelData.refrigeratorZoning.map(z => (
              <option value={z.id} selected={z.id === 'top-shelf'}>{z.name}</option>
            ))}
          </select>
          <p class="text-[11px] text-muted mt-1 leading-snug">{d.elevationHelp}</p>
        </div>

        <!-- 3. Shelf Design -->
        <div>
          <label for="rc-shelf" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5">
            {d.shelfLabel}
          </label>
          <select id="rc-shelf" class="w-full bg-surface border border-hairline rounded-xl px-3.5 py-2.5 text-xs text-ink font-medium focus:ring-2 focus:ring-rose-500 focus:outline-none">
            {modelData.shelfDesigns.map(s => (
              <option value={s.id}>{s.name}</option>
            ))}
          </select>
          <p class="text-[11px] text-muted mt-1 leading-snug">{d.shelfHelp}</p>
        </div>

        <!-- 4. Fan Profile -->
        <div>
          <label for="rc-fan" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5">
            {d.fanLabel}
          </label>
          <select id="rc-fan" class="w-full bg-surface border border-hairline rounded-xl px-3.5 py-2.5 text-xs text-ink font-medium focus:ring-2 focus:ring-rose-500 focus:outline-none">
            {modelData.convectionFanDispersal.map(f => (
              <option value={f.id}>{f.name}</option>
            ))}
          </select>
          <p class="text-[11px] text-muted mt-1 leading-snug">{d.fanHelp}</p>
        </div>

        <!-- 5. Exposed Receptor Food -->
        <div>
          <label for="rc-food" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5">
            {d.foodLabel}
          </label>
          <select id="rc-food" class="w-full bg-surface border border-hairline rounded-xl px-3.5 py-2.5 text-xs text-ink font-medium focus:ring-2 focus:ring-rose-500 focus:outline-none">
            {modelData.targetReceptorFoods.map(f => (
              <option value={f.id}>{f.name}</option>
            ))}
          </select>
          <p class="text-[11px] text-muted mt-1 leading-snug">{d.foodHelp}</p>
        </div>

        <!-- 6. Disinfectant Agent -->
        <div>
          <label for="rc-disinfectant" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1.5">
            {d.disinfectantLabel}
          </label>
          <select id="rc-disinfectant" class="w-full bg-surface border border-hairline rounded-xl px-3.5 py-2.5 text-xs text-ink font-medium focus:ring-2 focus:ring-rose-500 focus:outline-none">
            {modelData.disinfectantEfficacy.map(m => (
              <option value={m.id} selected={m.id === 'white-vinegar-5pct'}>{m.name}</option>
            ))}
          </select>
          <p class="text-[11px] text-muted mt-1 leading-snug">{d.disinfectantHelp}</p>
        </div>
      </div>

      <!-- Sliders: Purge Volume & Duration -->
      <div class="space-y-4 pt-2 border-t border-hairline">
        <!-- Purge Volume Slider -->
        <div>
          <div class="flex justify-between items-center mb-1 text-xs font-bold">
            <span class="text-ink">{d.purgeVolumeLabel}</span>
            <span class="font-mono text-rose-800 font-extrabold text-sm" id="volume-val">40 mL</span>
          </div>
          <input type="range" id="rc-volume" min="5" max="80" step="5" value="40" class="w-full accent-rose-600 cursor-pointer" />
          <div class="flex justify-between text-[10px] text-muted font-mono mt-0.5">
            <span>5 mL (Minor drip)</span>
            <span>40 mL (Typical poultry tray)</span>
            <span>80 mL (Heavy thaw flood)</span>
          </div>
        </div>

        <!-- Duration Slider -->
        <div>
          <div class="flex justify-between items-center mb-1 text-xs font-bold">
            <span class="text-ink">{d.durationLabel}</span>
            <span class="font-mono text-rose-800 font-extrabold text-sm" id="duration-val">24 hrs</span>
          </div>
          <input type="range" id="rc-duration" min="1" max="72" step="1" value="24" class="w-full accent-rose-600 cursor-pointer" />
          <div class="flex justify-between text-[10px] text-muted font-mono mt-0.5">
            <span>1 hr (Prompt notice)</span>
            <span>24 hrs (Overnight leak)</span>
            <span>72 hrs (Weekend incubation)</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Diagnostics Scorecard (5 Cols) -->
    <div class="lg:col-span-5 bg-surface-soft border border-hairline rounded-2xl p-6 flex flex-col justify-between">
      <div>
        <div class="border-b border-hairline pb-3 mb-5">
          <div class="flex items-center justify-between">
            <h3 class="text-lg font-bold text-ink">{d.diagnosticTitle}</h3>
            <span class="px-2.5 py-0.5 rounded-full text-[11px] font-extrabold uppercase font-mono tracking-wider" id="hazard-badge">
              CRITICAL BIOHAZARD
            </span>
          </div>
          <p class="text-xs text-muted mt-0.5">{d.diagnosticSub}</p>
        </div>

        <!-- Key Metrics Cards -->
        <div class="space-y-4">
          <!-- Cascade & Overflow Metric -->
          <div class="bg-surface border border-hairline rounded-xl p-3.5">
            <div class="flex justify-between items-center text-xs mb-1">
              <span class="font-bold text-muted uppercase tracking-wider">{d.cascadeRiskLabel}</span>
              <span class="font-mono font-bold text-ink text-sm" id="cascade-stat">100% Cascade (40 mL Leak)</span>
            </div>
            <div class="w-full bg-hairline/40 rounded-full h-2 overflow-hidden">
              <div class="bg-rose-600 h-2 rounded-full transition-all duration-300" id="cascade-bar" style="width: 100%;"></div>
            </div>
            <div class="text-[11px] text-muted mt-1.5" id="cascade-detail">Direct gravity fall across 3 lower food zones</div>
          </div>

          <!-- Bio-Aerosol Deposition -->
          <div class="bg-surface border border-hairline rounded-xl p-3.5">
            <div class="flex justify-between items-center text-xs mb-1">
              <span class="font-bold text-muted uppercase tracking-wider">{d.aerosolDepositionLabel}</span>
              <span class="font-mono font-bold text-ink text-sm" id="aerosol-stat">680 CFU/cm²</span>
            </div>
            <div class="w-full bg-hairline/40 rounded-full h-2 overflow-hidden">
              <div class="bg-purple-600 h-2 rounded-full transition-all duration-300" id="aerosol-bar" style="width: 82%;"></div>
            </div>
            <div class="text-[11px] text-muted mt-1.5" id="aerosol-detail">High convection fan velocity disperses droplets to melon</div>
          </div>

          <!-- Psychrotrophic Growth Multiplier -->
          <div class="bg-surface border border-hairline rounded-xl p-3.5">
            <div class="flex justify-between items-center text-xs mb-1">
              <span class="font-bold text-muted uppercase tracking-wider">{d.pathogenGrowthLabel}</span>
              <span class="font-mono font-bold text-ink text-sm" id="growth-stat">+2.8 Log10 (630x Growth)</span>
            </div>
            <div class="text-[11px] text-muted mt-1" id="growth-detail">Listeria actively replicating in neutral fruit sugars</div>
          </div>

          <!-- Disinfectant Kill & Residual Pathogens -->
          <div class="bg-surface border border-hairline rounded-xl p-3.5">
            <div class="flex justify-between items-center text-xs mb-1">
              <span class="font-bold text-muted uppercase tracking-wider">{d.disinfectantKillLabel}</span>
              <span class="font-mono font-bold text-amber-700 text-sm" id="kill-stat">1.6 Log10 (97.5% Kill)</span>
            </div>
            <div class="text-xs font-bold text-ink mt-2 flex justify-between">
              <span class="text-muted">{d.residualOrganismsLabel}:</span>
              <span class="font-mono text-rose-800" id="residual-stat">~450,000 Live CFU Remaining</span>
            </div>
            <div class="text-[11px] text-rose-700 font-semibold mt-1" id="residual-warning">⚠️ Vinegar leaves millions of active Salmonella cells!</div>
          </div>
        </div>

        <!-- Failure Mode Box -->
        <div class="mt-4 bg-rose-50 border border-rose-200 rounded-xl p-3 text-xs text-rose-950">
          <div class="font-bold uppercase tracking-wider text-[10px] text-rose-800 mb-0.5">{d.primaryFailureModeLabel}</div>
          <div class="font-semibold leading-snug" id="failure-mode-text">
            Catastrophic vertical drip inoculation onto exposed salad greens followed by sub-lethal vinegar cleaning failure.
          </div>
        </div>

        <!-- Action Protocol Box -->
        <div class="mt-3 bg-surface border border-hairline rounded-xl p-3 text-xs text-ink">
          <div class="font-bold uppercase tracking-wider text-[10px] text-muted mb-0.5">{d.actionProtocolLabel}</div>
          <div class="leading-relaxed text-muted text-[11px]" id="protocol-text">
            Immediately discard contaminated receptor food. Prepare 200 ppm dilute bleach (1 tbsp/gallon). Wipe ABS plastic liner with 2-minute wet dwell. Transfer raw proteins to a rimmed tray on the bottom shelf.
          </div>
        </div>
      </div>

      <!-- Copy Report Button -->
      <div class="mt-6 pt-4 border-t border-hairline">
        <button type="button" id="copy-report-btn" class="w-full py-2.5 px-4 rounded-xl bg-ink hover:bg-ink/90 text-surface text-xs font-bold transition-all shadow-xs flex items-center justify-center gap-2">
          <span>{d.copyReportBtn}</span>
        </button>
        <div id="copy-feedback" class="text-center text-[11px] text-emerald-800 font-bold mt-1.5 hidden">
          {d.copiedFeedback}
        </div>
      </div>
    </div>
  </div>

  <!-- Refrigerator Shelf Engineering Comparison Table -->
  <div class="border-t border-hairline pt-8 mb-10">
    <div class="mb-4">
      <h3 class="text-lg md:text-xl font-bold text-ink">{d.tableTitle}</h3>
      <p class="text-xs md:text-sm text-muted">{d.tableSub}</p>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs border-collapse">
        <thead>
          <tr class="border-b border-hairline bg-surface-soft text-muted uppercase text-[10px] tracking-wider">
            <th class="py-3 px-4 font-bold">{d.colShelf}</th>
            <th class="py-3 px-4 font-bold">{d.colCapacity}</th>
            <th class="py-3 px-4 font-bold">{d.colCascade}</th>
            <th class="py-3 px-4 font-bold">{d.colCapillarity}</th>
            <th class="py-3 px-4 font-bold">{d.colCleanability}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline">
          {modelData.shelfDesigns.map(s => (
            <tr class="hover:bg-surface-soft/50 transition-colors">
              <td class="py-3 px-4 font-semibold text-ink">{s.name}</td>
              <td class="py-3 px-4 font-mono font-bold text-rose-800">{s.fluidContainmentCapacity_mL} mL</td>
              <td class="py-3 px-4 font-mono font-bold">{s.verticalCascadePassThroughPct}%</td>
              <td class="py-3 px-4 text-muted">{s.capillarySpreadRisk}</td>
              <td class="py-3 px-4 text-muted">{s.cleanabilityIndex}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- 4 Non-Negotiable Refrigerator Safety Rules -->
  <div class="border-t border-hairline pt-8">
    <div class="mb-6">
      <h3 class="text-xl md:text-2xl font-bold text-ink tracking-tight">{d.rulesTitle}</h3>
      <p class="text-xs md:text-sm text-muted">{d.rulesSub}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <div class="bg-surface-soft border border-hairline rounded-2xl p-5">
        <h4 class="font-bold text-rose-950 text-sm mb-2">{d.rule1Title}</h4>
        <p class="text-xs text-muted leading-relaxed">{d.rule1Text}</p>
      </div>
      <div class="bg-surface-soft border border-hairline rounded-2xl p-5">
        <h4 class="font-bold text-rose-950 text-sm mb-2">{d.rule2Title}</h4>
        <p class="text-xs text-muted leading-relaxed">{d.rule2Text}</p>
      </div>
      <div class="bg-surface-soft border border-hairline rounded-2xl p-5">
        <h4 class="font-bold text-rose-950 text-sm mb-2">{d.rule3Title}</h4>
        <p class="text-xs text-muted leading-relaxed">{d.rule3Text}</p>
      </div>
      <div class="bg-surface-soft border border-hairline rounded-2xl p-5">
        <h4 class="font-bold text-rose-950 text-sm mb-2">{d.rule4Title}</h4>
        <p class="text-xs text-muted leading-relaxed">{d.rule4Text}</p>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ modelData }}>
  (function() {
    const proteinSelect = document.getElementById('rc-protein');
    const elevationSelect = document.getElementById('rc-elevation');
    const shelfSelect = document.getElementById('rc-shelf');
    const fanSelect = document.getElementById('rc-fan');
    const foodSelect = document.getElementById('rc-food');
    const disinfectantSelect = document.getElementById('rc-disinfectant');
    const volumeSlider = document.getElementById('rc-volume');
    const durationSlider = document.getElementById('rc-duration');
    const volumeVal = document.getElementById('volume-val');
    const durationVal = document.getElementById('duration-val');

    const hazardBadge = document.getElementById('hazard-badge');
    const cascadeStat = document.getElementById('cascade-stat');
    const cascadeBar = document.getElementById('cascade-bar');
    const cascadeDetail = document.getElementById('cascade-detail');
    const aerosolStat = document.getElementById('aerosol-stat');
    const aerosolBar = document.getElementById('aerosol-bar');
    const aerosolDetail = document.getElementById('aerosol-detail');
    const growthStat = document.getElementById('growth-stat');
    const growthDetail = document.getElementById('growth-detail');
    const killStat = document.getElementById('kill-stat');
    const residualStat = document.getElementById('residual-stat');
    const residualWarning = document.getElementById('residual-warning');
    const failureModeText = document.getElementById('failure-mode-text');
    const protocolText = document.getElementById('protocol-text');
    const copyReportBtn = document.getElementById('copy-report-btn');
    const copyFeedback = document.getElementById('copy-feedback');

    function updateCalculations() {
      if (!proteinSelect || !shelfSelect) return;

      const protein = modelData.rawProteinPurgeSources.find(p => p.id === proteinSelect.value);
      const elevation = modelData.refrigeratorZoning.find(z => z.id === elevationSelect.value);
      const shelf = modelData.shelfDesigns.find(s => s.id === shelfSelect.value);
      const fan = modelData.convectionFanDispersal.find(f => f.id === fanSelect.value);
      const food = modelData.targetReceptorFoods.find(f => f.id === foodSelect.value);
      const disinfectant = modelData.disinfectantEfficacy.find(m => m.id === disinfectantSelect.value);

      const volume = parseInt(volumeSlider.value, 10);
      const duration = parseInt(durationSlider.value, 10);

      volumeVal.textContent = volume + ' mL';
      durationVal.textContent = duration + ' hrs';

      // 1. Drip Cascade Calculation
      const capacity = shelf.fluidContainmentCapacity_mL;
      let cascadePct = 0;
      let spilledVolume = 0;

      if (shelf.id === 'open-wire-racks') {
        cascadePct = 100;
        spilledVolume = volume;
      } else if (volume > capacity) {
        spilledVolume = volume - capacity;
        cascadePct = Math.min(100, Math.round((spilledVolume / volume) * shelf.verticalCascadePassThroughPct));
      } else {
        cascadePct = 0;
        spilledVolume = 0;
      }

      // Elevation multiplier
      let elevationImpact = 1.0;
      if (elevation.id === 'top-shelf') elevationImpact = 3.0;
      else if (elevation.id === 'middle-shelf') elevationImpact = 2.0;
      else if (elevation.id === 'bottom-shelf') elevationImpact = 0.2;
      else if (elevation.id === 'door-bins') elevationImpact = 2.2;

      // 2. Aerosol Deposition Calculation
      let fanSpeed = fan.airVelocity_ms;
      let aerosolDensity = 0;
      if (food.id === 'sealed-glass-container') {
        aerosolDensity = 0;
      } else {
        const baseAerosol = (protein.initialPathogenCFU_per_mL / 1000) * (volume / 20) * 0.05;
        aerosolDensity = Math.round(baseAerosol * (fanSpeed / 1.5) * Math.min(duration / 12, 2.5));
      }

      // 3. Microbial Proliferation Multiplier
      let zoneTemp = elevation.typicalTempC;
      let growthFactor = 1.0;
      let logGrowth = 0;

      if (food.id === 'sealed-glass-container') {
        growthFactor = 0;
        logGrowth = 0;
      } else {
        if (zoneTemp > 4.4) {
          // Temperature abuse zone (door bins / warm top)
          logGrowth = (duration / 12) * 1.4;
        } else if (zoneTemp >= 2.0) {
          // Normal fridge zone
          logGrowth = (duration / 24) * 0.7;
        } else {
          // Cold bottom shelf
          logGrowth = (duration / 48) * 0.2;
        }
        growthFactor = Math.pow(10, Math.min(logGrowth, 4.5));
      }

      // 4. Disinfectant Residual
      const initialCFU = protein.initialPathogenCFU_per_mL * volume;
      const killLog = disinfectant.logReduction_5min;
      const killPercent = disinfectant.percentKill;
      const survivingFraction = Math.max(0.000001, Math.pow(10, -killLog));
      const residualCFU = Math.round(initialCFU * survivingFraction);

      // 5. Total Hazard Index (0 to 100)
      let hazardScore = 0;
      if (food.id === 'sealed-glass-container' && elevation.id === 'bottom-shelf' && capacity >= volume && disinfectant.epaRegistered) {
        hazardScore = 12; // Perfectly safe protocol
      } else {
        if (cascadePct > 0 && elevation.id !== 'bottom-shelf') hazardScore += 45;
        if (aerosolDensity > 200) hazardScore += 25;
        if (food.id === 'cut-cantaloupe-melon' || food.id === 'soft-cheeses-deli') hazardScore += 20;
        if (!disinfectant.epaRegistered) hazardScore += 20;
        if (duration > 18) hazardScore += 10;
      }
      hazardScore = Math.min(100, hazardScore);

      // Render UI
      if (hazardScore >= 75) {
        hazardBadge.textContent = 'CRITICAL BIOHAZARD';
        hazardBadge.className = 'px-2.5 py-0.5 rounded-full text-[11px] font-extrabold uppercase font-mono tracking-wider bg-rose-600 text-white animate-pulse';
      } else if (hazardScore >= 40) {
        hazardBadge.textContent = 'ELEVATED RISK';
        hazardBadge.className = 'px-2.5 py-0.5 rounded-full text-[11px] font-extrabold uppercase font-mono tracking-wider bg-amber-500 text-amber-950 font-bold';
      } else {
        hazardBadge.textContent = 'LOW RISK / SAFE';
        hazardBadge.className = 'px-2.5 py-0.5 rounded-full text-[11px] font-extrabold uppercase font-mono tracking-wider bg-emerald-600 text-white font-bold';
      }

      cascadeStat.textContent = cascadePct === 0 ? '0% (Fully Contained)' : `${cascadePct}% Cascade (${spilledVolume} mL Overspill)`;
      cascadeBar.style.width = Math.max(4, cascadePct) + '%';
      if (cascadePct === 0) {
        cascadeBar.className = 'bg-emerald-500 h-2 rounded-full transition-all duration-300';
        cascadeDetail.textContent = `Shelf holds ${capacity} mL; safely contained without lower tier dripping.`;
      } else {
        cascadeBar.className = 'bg-rose-600 h-2 rounded-full transition-all duration-300';
        cascadeDetail.textContent = `Gravity drains ${spilledVolume} mL down through ${elevation.name.toLowerCase()} onto foods below.`;
      }

      aerosolStat.textContent = food.id === 'sealed-glass-container' ? '0 CFU/cm² (Barrier Protected)' : `${aerosolDensity.toLocaleString()} CFU/cm²`;
      aerosolBar.style.width = Math.min(100, Math.max(5, (aerosolDensity / 1200) * 100)) + '%';
      if (food.id === 'sealed-glass-container') {
        aerosolBar.className = 'bg-emerald-500 h-2 rounded-full transition-all duration-300';
        aerosolDetail.textContent = 'Hermetic container prevents all airborne particulate colonization.';
      } else {
        aerosolBar.className = 'bg-purple-600 h-2 rounded-full transition-all duration-300';
        aerosolDetail.textContent = `${fan.name}: micro-aerosols circulate across compartment and deposit on ${food.name.toLowerCase()}.`;
      }

      growthStat.textContent = food.id === 'sealed-glass-container' ? '0x (No Substrate Access)' : `+${logGrowth.toFixed(1)} Log10 (~${Math.round(growthFactor)}x Multiplication)`;
      growthDetail.textContent = `${protein.primaryPathogens.split('&')[0].trim()} at ${zoneTemp}°C (${elevation.typicalTempF}°F) in ${food.name.split('(')[0].trim()}.`;

      killStat.textContent = `${killLog.toFixed(1)} Log10 (${killPercent.toFixed(2)}% Kill)`;
      residualStat.textContent = residualCFU < 10 ? '< 10 CFU (Safe Sanitize)' : `~${residualCFU.toLocaleString()} Live CFU Remaining`;

      if (disinfectant.id === 'white-vinegar-5pct') {
        residualWarning.textContent = '⚠️ Vinegar myth: Leaves thousands of active Salmonella cells on plastic walls!';
        residualWarning.className = 'text-[11px] text-rose-700 font-semibold mt-1 block';
      } else if (disinfectant.id === 'warm-soapy-water') {
        residualWarning.textContent = '⚠️ Soap wipe mobilizes live bacteria across cleaning rag without chemical kill!';
        residualWarning.className = 'text-[11px] text-rose-700 font-semibold mt-1 block';
      } else {
        residualWarning.textContent = '✓ EPA-compliant chemical sanitizer destroys vegetative bacterial membrane.';
        residualWarning.className = 'text-[11px] text-emerald-800 font-semibold mt-1 block';
      }

      // Predicted Failure Mode
      if (elevation.id !== 'bottom-shelf' && cascadePct > 0) {
        failureModeText.textContent = `Vertical gravitational cascade: Purge from ${protein.name.split('/')[0].trim()} on ${elevation.name.split('(')[0].trim()} drips through ${shelf.name.split('(')[0].trim()} into ${food.name.split('(')[0].trim()}.`;
      } else if (aerosolDensity > 350) {
        failureModeText.textContent = `Aerosol transmission: Forced convection fan pulls drying poultry juices into turbulent airstream, settling on exposed ${food.name.split('(')[0].trim()}.`;
      } else if (!disinfectant.epaRegistered) {
        failureModeText.textContent = `Chemical sanitization failure: Using ${disinfectant.name.split('(')[0].trim()} fails to achieve 5-log kill, spreading live ${protein.primaryPathogens.split('&')[0].trim()} across shelf surfaces.`;
      } else {
        failureModeText.textContent = 'Controlled containment: Leak-proof tray placement and EPA-registered sanitizer eliminate cross-contamination pathways.';
      }

      // Protocol recommendation
      if (hazardScore >= 75) {
        protocolText.textContent = `URGENT ACTION: 1) Immediately discard ${food.name.split('(')[0].trim()} (no kill step before ingestion). 2) Remove all affected shelves and wash with hot soapy water, followed by dilute bleach (200 ppm) with a 2-minute wet dwell. 3) Move raw meats to the BOTTOM shelf in a dedicated rimmed catch pan.`;
      } else if (hazardScore >= 40) {
        protocolText.textContent = `CORRECTIVE ACTION: 1) Inspect and wash exterior packaging of adjacent items. 2) Apply 3% hydrogen peroxide or hospital-grade Quat spray to contaminated shelf. 3) Seal all produce and cut melons in airtight containers.`;
      } else {
        protocolText.textContent = `OPTIMAL HYGIENE: Continue storing raw proteins in a dedicated rimmed container on the bottom shelf (33°F–36°F). Verify temperature with an appliance thermometer weekly.`;
      }
    }

    // Attach Preset Handlers
    document.querySelectorAll('.preset-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        const preset = this.getAttribute('data-preset');
        if (preset === 'poultry-wire') {
          proteinSelect.value = 'raw-poultry';
          elevationSelect.value = 'top-shelf';
          shelfSelect.value = 'open-wire-racks';
          fanSelect.value = 'fan-continuous-high';
          foodSelect.value = 'washed-leafy-greens';
          disinfectantSelect.value = 'white-vinegar-5pct';
          volumeSlider.value = '45';
          durationSlider.value = '24';
        } else if (preset === 'beef-glass') {
          proteinSelect.value = 'raw-ground-beef';
          elevationSelect.value = 'middle-shelf';
          shelfSelect.value = 'flat-tempered-glass';
          fanSelect.value = 'fan-intermittent-standard';
          foodSelect.value = 'soft-cheeses-deli';
          disinfectantSelect.value = 'warm-soapy-water';
          volumeSlider.value = '35';
          durationSlider.value = '18';
        } else if (preset === 'seafood-melon') {
          proteinSelect.value = 'raw-seafood-shellfish';
          elevationSelect.value = 'top-shelf';
          shelfSelect.value = 'flat-tempered-glass';
          fanSelect.value = 'fan-continuous-high';
          foodSelect.value = 'cut-cantaloupe-melon';
          disinfectantSelect.value = 'hydrogen-peroxide-3pct';
          volumeSlider.value = '25';
          durationSlider.value = '36';
        } else if (preset === 'vinegar-fail') {
          proteinSelect.value = 'raw-poultry';
          elevationSelect.value = 'middle-shelf';
          shelfSelect.value = 'open-wire-racks';
          fanSelect.value = 'fan-continuous-high';
          foodSelect.value = 'washed-leafy-greens';
          disinfectantSelect.value = 'white-vinegar-5pct';
          volumeSlider.value = '30';
          durationSlider.value = '12';
        } else if (preset === 'usda-gold') {
          proteinSelect.value = 'raw-poultry';
          elevationSelect.value = 'bottom-shelf';
          shelfSelect.value = 'spill-proof-rimmed-glass';
          fanSelect.value = 'fan-intermittent-standard';
          foodSelect.value = 'sealed-glass-container';
          disinfectantSelect.value = 'sodium-hypochlorite-bleach';
          volumeSlider.value = '40';
          durationSlider.value = '24';
        }
        updateCalculations();
      });
    });

    // Copy Report Event
    if (copyReportBtn) {
      copyReportBtn.addEventListener('click', function() {
        const text = `=== IsItKitchenSafe Refrigerator Cross-Contamination Report ===\n` +
          `Date: ${new Date().toISOString()}\n` +
          `Protein Source: ${proteinSelect.options[proteinSelect.selectedIndex].text}\n` +
          `Shelf Zone: ${elevationSelect.options[elevationSelect.selectedIndex].text}\n` +
          `Shelf Design: ${shelfSelect.options[shelfSelect.selectedIndex].text}\n` +
          `Fan Profile: ${fanSelect.options[fanSelect.selectedIndex].text}\n` +
          `Target Receptor: ${foodSelect.options[foodSelect.selectedIndex].text}\n` +
          `Purge Volume: ${volumeSlider.value} mL | Duration: ${durationSlider.value} hrs\n` +
          `Hazard Rating: ${hazardBadge.textContent.trim()}\n` +
          `Drip Cascade: ${cascadeStat.textContent}\n` +
          `Bio-Aerosol Density: ${aerosolStat.textContent}\n` +
          `Sanitizer Efficacy: ${killStat.textContent} | Residual CFU: ${residualStat.textContent}\n` +
          `Failure Mode: ${failureModeText.textContent.trim()}\n` +
          `Required Action: ${protocolText.textContent.trim()}\n` +
          `Evidence Standard: USDA FSIS & CDC Cross-Contamination Guidelines\n` +
          `https://isitkitchensafe.com/tools/refrigerator-cross-contamination-modeler/`;

        navigator.clipboard.writeText(text).then(() => {
          copyFeedback.classList.remove('hidden');
          setTimeout(() => {
            copyFeedback.classList.add('hidden');
          }, 3500);
        });
      });
    }

    [proteinSelect, elevationSelect, shelfSelect, fanSelect, foodSelect, disinfectantSelect].forEach(el => {
      if (el) el.addEventListener('change', updateCalculations);
    });
    [volumeSlider, durationSlider].forEach(el => {
      if (el) el.addEventListener('input', updateCalculations);
    });

    updateCalculations();
  })();
</script>
