---
import rawData from '../data/kitchen-fire-emergency-guide-data.json';
import type { SupportedLanguage } from '../i18n/ui';
import { useTranslatedPath } from '../i18n/utils';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;
const translatePath = useTranslatedPath(lang);

const oilSmokePointUrl = translatePath('/tools/cooking-oil-smoke-point-finder/');
const cleanerMixingUrl = translatePath('/tools/cleaner-mixing-danger-checker/');
const ovenRackUrl = translatePath('/tools/oven-rack-bakeware-heat-adjuster/');
const methodologyUrl = translatePath('/methodology/');
const allToolsUrl = translatePath('/tools/');

type RatingLevel = 'safe' | 'caution' | 'deadly';

interface EmergencyNumber {
  region: string;
  code: string;
}

interface BannerTrigger {
  icon: string;
  title: string;
  body: string;
}

interface EmergencyBannerData {
  badge: string;
  headline: string;
  subline: string;
  numbers: EmergencyNumber[];
  triggers: BannerTrigger[];
}

interface PassStep {
  letter: string;
  word: string;
  detail: string;
}

interface PassData {
  badge: string;
  title: string;
  subtitle: string;
  steps: PassStep[];
}

interface LocalizedScenario {
  id: string;
  icon: string;
  severity: string;
  showPass: boolean;
  sourceTag: string;
  recommendedToolIds: string[];
  shortName: string;
  name: string;
  urgencyTag: string;
  summary: string;
  doSteps: string[];
  neverDo: string[];
  rationale: string;
  evacuateTrigger: string;
}

interface LocalizedTool {
  id: string;
  icon: string;
  verdictLevel: string;
  ratings: {
    grease: RatingLevel;
    electrical: RatingLevel;
    oven: RatingLevel;
    paper: RatingLevel;
  };
  shortName: string;
  name: string;
  verdictBadge: string;
  distanceRule: string;
  bestUse: string;
  criticalWarning: string;
  cleanupNote: string;
  fireNotes: {
    grease: string;
    electrical: string;
    oven: string;
    paper: string;
  };
}

const emergencyBanner: EmergencyBannerData =
  (rawData.emergencyBanner as Record<string, EmergencyBannerData>)[lang] ||
  rawData.emergencyBanner.en;

const passTechnique: PassData =
  (rawData.passTechnique as Record<string, PassData>)[lang] ||
  rawData.passTechnique.en;

const localizedScenarios: LocalizedScenario[] = rawData.scenarios.map((item) => {
  const tr = (item.i18n as Record<string, any>)[lang] || item.i18n.en;
  return {
    id: item.id,
    icon: item.icon,
    severity: item.severity,
    showPass: item.showPass,
    sourceTag: item.sourceTag,
    recommendedToolIds: item.recommendedToolIds,
    shortName: tr.shortName,
    name: tr.name,
    urgencyTag: tr.urgencyTag,
    summary: tr.summary,
    doSteps: tr.doSteps,
    neverDo: tr.neverDo,
    rationale: tr.rationale,
    evacuateTrigger: tr.evacuateTrigger
  };
});

const localizedTools: LocalizedTool[] = rawData.tools.map((item) => {
  const tr = (item.i18n as Record<string, any>)[lang] || item.i18n.en;
  return {
    id: item.id,
    icon: item.icon,
    verdictLevel: item.verdictLevel,
    ratings: item.ratings as LocalizedTool['ratings'],
    shortName: tr.shortName,
    name: tr.name,
    verdictBadge: tr.verdictBadge,
    distanceRule: tr.distanceRule,
    bestUse: tr.bestUse,
    criticalWarning: tr.criticalWarning,
    cleanupNote: tr.cleanupNote,
    fireNotes: tr.fireNotes
  };
});

const localizedFaqs: Array<{ question: string; answer: string }> =
  (rawData.faqs as Record<string, Array<{ question: string; answer: string }>>)[lang] ||
  rawData.faqs.en;

