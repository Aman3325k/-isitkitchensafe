const t = UI[lang] || UI.en;

const defaultScenario = localizedScenarios[0];
const defaultTool = localizedTools[0];

const toolMapById: Record<string, LocalizedTool> = {};
localizedTools.forEach((item) => {
  toolMapById[item.id] = item;
});

function getRatingBadgeClasses(rating: RatingLevel): string {
  if (rating === 'safe') {
    return 'bg-emerald-500/20 text-emerald-800 dark:text-emerald-200 border-emerald-500/40';
  }
  if (rating === 'caution') {
    return 'bg-amber-500/20 text-amber-900 dark:text-amber-200 border-amber-500/45';
  }
  return 'bg-red-500/20 text-red-800 dark:text-red-200 border-red-500/50';
}

function getRatingLabel(rating: RatingLevel): string {
  if (rating === 'safe') return t.ratingSafe;
  if (rating === 'caution') return t.ratingCaution;
  return t.ratingDeadly;
}

function getRatingCardClasses(rating: RatingLevel): string {
  if (rating === 'safe') {
    return 'bg-emerald-500/8 border-emerald-500/35';
  }
  if (rating === 'caution') {
    return 'bg-amber-500/8 border-amber-500/40';
  }
  return 'bg-red-500/10 border-red-500/45';
}

function getToolVerdictPillClasses(level: string): string {
  if (level === 'best') return 'bg-emerald-500/20 text-emerald-200 border-emerald-400/40';
  if (level === 'good') return 'bg-amber-500/20 text-amber-200 border-amber-400/40';
  return 'bg-red-500/25 text-red-100 border-red-400/55';
}

const fireTypeDefs: Array<{ key: 'grease' | 'electrical' | 'oven' | 'paper'; icon: string; label: string }> = [
  { key: 'grease', icon: '🍳', label: t.fireTypeGrease },
  { key: 'electrical', icon: '🔌', label: t.fireTypeElectrical },
  { key: 'oven', icon: '🚪', label: t.fireTypeOven },
  { key: 'paper', icon: '📄', label: t.fireTypePaper }
];

const clientPayload = {
  lang,
  defaultScenarioId: defaultScenario.id,
  defaultToolId: defaultTool.id,
  scenarios: localizedScenarios,
  tools: localizedTools,
  passSteps: passTechnique.steps,
  ui: {
    copyBtn: t.copyBtn,
    copiedBtn: t.copiedBtn,
    ratingSafe: t.ratingSafe,
    ratingCaution: t.ratingCaution,
    ratingDeadly: t.ratingDeadly,
    noFireToolNote: t.noFireToolNote,
    passApplicableTag: t.passApplicableTag,
    passAlwaysNote: t.passAlwaysNote,
    fireTypeGrease: t.fireTypeGrease,
    fireTypeElectrical: t.fireTypeElectrical,
    fireTypeOven: t.fireTypeOven,
    fireTypePaper: t.fireTypePaper,
    copyHeader: t.copyHeader,
    copyEmergencyLine: t.copyEmergencyLine,
    copyScenarioLine: t.copyScenarioLine,
    copyDoHeader: t.copyDoHeader,
    copyNeverHeader: t.copyNeverHeader,
    copyEvacuateLine: t.copyEvacuateLine,
    copyToolHeader: t.copyToolHeader,
    copyPassHeader: t.copyPassHeader
  }
};
---

<div id="kitchen-fire-emergency-root" class="space-y-12">
  <!-- Top High-Contrast Evacuate First / Emergency 911-112-119-193 Banner -->
  <aside
    class="p-5 sm:p-6 rounded-2xl bg-error-bg/80 dark:bg-red-950/45 border-2 border-error-border shadow-sm space-y-4"
    role="alert"
    aria-label={emergencyBanner.badge}
  >
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div class="space-y-1.5 max-w-3xl">
        <span class="inline-block px-3 py-0.5 rounded-full text-[11px] font-extrabold uppercase tracking-wider bg-error-border text-white">
          🚨 {emergencyBanner.badge}
        </span>
        <h2 class="text-base sm:text-xl font-extrabold text-ink leading-snug">
          {emergencyBanner.headline}
        </h2>
        <p class="text-xs sm:text-[13.5px] font-medium text-body leading-relaxed">
          {emergencyBanner.subline}
        </p>
      </div>

      <div class="flex flex-wrap gap-2 shrink-0">
        {emergencyBanner.numbers.map((num) => (
          <div class="px-3 py-1.5 rounded-xl bg-surface-dark text-on-dark border border-white/15 text-center min-w-[78px]">
            <span class="block text-[10px] font-bold uppercase tracking-wider text-white/75 leading-tight">
              {num.region}
            </span>
            <span class="block text-base font-extrabold tracking-tight text-signature-peach">
              {num.code}
            </span>
          </div>
        ))}
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      {emergencyBanner.triggers.map((trig) => (
        <div class="p-3.5 rounded-xl bg-canvas border border-hairline shadow-xs space-y-1">
          <div class="flex items-start gap-2">
            <span aria-hidden="true" class="text-lg leading-none mt-0.5 shrink-0">{trig.icon}</span>
            <h3 class="text-xs sm:text-[13px] font-extrabold text-ink leading-snug">{trig.title}</h3>
          </div>
          <p class="text-xs text-body leading-relaxed">{trig.body}</p>
        </div>
      ))}
    </div>
  </aside>

  <!-- Main Interactive Emergency Triage & Extinguisher Matcher Card -->
  <section
    id="kitchen-fire-emergency-guide"
    class="bg-canvas border border-hairline rounded-2xl shadow-sm overflow-hidden"
    aria-label={t.ariaLabel}
  >
    <script type="application/json" id="kfeg-payload" set:html={JSON.stringify(clientPayload)} />

    <!-- Header & Utility Action Buttons -->
    <div class="p-5 sm:p-6 border-b border-hairline bg-surface-soft/50 space-y-5">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div class="space-y-1 max-w-2xl">
          <span class="inline-block px-2.5 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wider bg-signature-coral text-white">
            🚒 {t.triageBadge}
          </span>
          <h2 class="text-title-md font-bold text-ink">{t.triageTitle}</h2>
          <p class="text-xs sm:text-[13px] text-muted leading-relaxed">{t.triageSub}</p>
        </div>

        <div class="flex flex-wrap items-center gap-2 print:hidden">
          <button
            type="button"
            id="kfeg-copy-btn"
            class="min-h-[40px] px-3.5 py-2 rounded-xl text-xs font-semibold bg-primary text-on-primary hover:bg-primary-active transition-colors cursor-pointer shadow-sm"
          >
            <span id="kfeg-copy-label">📋 {t.copyBtn}</span>
          </button>
          <button
            type="button"
            id="kfeg-print-btn"
            class="min-h-[40px] px-3.5 py-2 rounded-xl text-xs font-semibold bg-canvas text-ink border border-hairline hover:border-signature-coral transition-colors cursor-pointer"
          >
            🖨️ {t.printBtn}
          </button>
        </div>
      </div>

      <!-- Step 1: 6-Scenario Emergency Triage Selector -->
      <div class="space-y-2.5 print:hidden">
        <div class="space-y-0.5">
          <h3 class="text-xs sm:text-sm font-extrabold uppercase tracking-wider text-ink">
            {t.scenarioStepLabel}
          </h3>
          <p class="text-xs text-muted">{t.scenarioStepHint}</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2.5" role="group" aria-label={t.scenarioStepLabel}>
          {localizedScenarios.map((sc, idx) => (
            <button
              type="button"
              data-kfeg-scenario={sc.id}
              aria-pressed={idx === 0 ? 'true' : 'false'}
              class={`kfeg-scenario-btn text-left p-3.5 rounded-xl border transition-all cursor-pointer flex items-start gap-2.5 ${
                idx === 0
                  ? 'bg-primary text-on-primary border-primary ring-2 ring-signature-coral/60 shadow-sm'
                  : 'bg-canvas text-ink border-hairline hover:border-signature-coral'
              }`}
            >
              <span aria-hidden="true" class="text-xl leading-none mt-0.5 shrink-0">{sc.icon}</span>
              <span class="min-w-0 block">
                <span class="block text-xs sm:text-[13px] font-extrabold leading-snug">{sc.shortName}</span>
                <span
                  data-kfeg-scenario-sub
                  class={`block text-[10.5px] font-bold uppercase tracking-wider mt-0.5 ${
                    idx === 0 ? 'text-white/80' : 'text-muted'
                  }`}
                >
                  {sc.urgencyTag}
                </span>
              </span>
            </button>
          ))}
        </div>
      </div>

      <!-- High-Contrast Live DO vs. NEVER DO Action Dashboard -->
      <div
        id="kfeg-dashboard"
        aria-live="polite"
        class="w-full rounded-2xl bg-surface-dark text-on-dark p-5 sm:p-6 space-y-5 shadow-sm border-l-4 border-error-border"
      >
        <!-- Active Scenario Status Header -->
        <div class="space-y-2">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div class="flex flex-wrap items-center gap-2">
              <span
                id="kfeg-urgency-pill"
                class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-extrabold uppercase tracking-wider bg-error-border text-white"
              >
                {defaultScenario.urgencyTag}
              </span>
              <span
                id="kfeg-source-pill"
                class="inline-flex items-center px-2.5 py-0.5 rounded-md border text-[11px] font-bold bg-white/10 text-signature-mint border-white/20"
              >
                {defaultScenario.sourceTag}
              </span>
            </div>
            <span
              id="kfeg-pass-badge"
              class="inline-flex items-center px-2.5 py-0.5 rounded-md border text-[10.5px] font-extrabold uppercase tracking-wider bg-amber-500/20 text-amber-200 border-amber-400/40"
            >
              🧯 {t.passApplicableTag}
            </span>
          </div>

          <h3 id="kfeg-scenario-title" class="text-xl sm:text-2xl font-extrabold tracking-tight text-white leading-snug">
            {defaultScenario.icon} {defaultScenario.name}
          </h3>
          <p id="kfeg-scenario-summary" class="text-xs sm:text-[13.5px] text-white/85 leading-relaxed">
            {defaultScenario.summary}
          </p>
        </div>

        <!-- Split DO vs. NEVER DO Columns -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
          <!-- DO IMMEDIATELY (Emerald / Green) -->
          <div class="p-4 sm:p-5 rounded-xl bg-emerald-500/12 border-2 border-emerald-400/45 space-y-3">
            <div class="flex flex-wrap items-center justify-between gap-2 pb-2 border-b border-emerald-400/30">
              <h4 class="text-sm font-extrabold uppercase tracking-wide text-emerald-200">
                ✅ {t.doHeading}
              </h4>
              <span class="px-2 py-0.5 rounded-md text-[10px] font-extrabold uppercase tracking-wider bg-emerald-500 text-slate-950">
                {t.doBadge}
              </span>
            </div>
            <ol id="kfeg-do-list" class="space-y-2.5">
              {defaultScenario.doSteps.map((step, i) => (
                <li class="flex items-start gap-2.5 text-xs sm:text-[13.5px] text-white/95 leading-relaxed">
                  <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-emerald-500 text-slate-950 text-xs font-extrabold shrink-0 mt-0.5">
                    {i + 1}
                  </span>
                  <span>{step}</span>
                </li>
              ))}
            </ol>
          </div>

          <!-- NEVER DO (Coral / Red) -->
          <div class="p-4 sm:p-5 rounded-xl bg-red-500/14 border-2 border-red-400/55 space-y-3">
            <div class="flex flex-wrap items-center justify-between gap-2 pb-2 border-b border-red-400/35">
              <h4 class="text-sm font-extrabold uppercase tracking-wide text-red-200">
                🚫 {t.neverHeading}
              </h4>
              <span class="px-2 py-0.5 rounded-md text-[10px] font-extrabold uppercase tracking-wider bg-error-border text-white">
                {t.neverBadge}
              </span>
            </div>
            <ul id="kfeg-never-list" class="space-y-2.5">
              {defaultScenario.neverDo.map((mistake) => (
                <li class="flex items-start gap-2.5 text-xs sm:text-[13.5px] text-white/95 leading-relaxed">
                  <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-error-border text-white text-xs font-extrabold shrink-0 mt-0.5">
                    ✕
                  </span>
                  <span>{mistake}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Evacuate Trigger + Official Rationale Strip -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-3.5">
          <div class="lg:col-span-6 p-4 rounded-xl bg-amber-500/15 border border-amber-400/50 space-y-1.5">
            <span class="block text-[11px] font-extrabold uppercase tracking-wider text-amber-200">
              🚨 {t.evacuateHeading}
            </span>
            <p id="kfeg-evacuate-text" class="text-xs sm:text-[13px] font-semibold text-white leading-relaxed">
              {defaultScenario.evacuateTrigger}
            </p>
          </div>

          <div class="lg:col-span-6 p-4 rounded-xl bg-white/6 border border-white/14 space-y-1.5">
            <span class="block text-[11px] font-extrabold uppercase tracking-wider text-signature-mint">
              🧪 {t.rationaleHeading}
            </span>
            <p id="kfeg-rationale-text" class="text-xs sm:text-[13px] text-white/90 leading-relaxed">
              {defaultScenario.rationale}
            </p>
          </div>
        </div>

        <!-- Recommended Tools Quick-Inspect Bar -->
        <div class="p-3.5 rounded-xl bg-white/6 border border-white/12 flex flex-wrap items-center gap-2 print:hidden">
          <span class="text-[11px] font-extrabold uppercase tracking-wider text-signature-peach mr-1">
            🧰 {t.recommendedToolsLabel}
          </span>
          <div id="kfeg-rec-tools" class="flex flex-wrap items-center gap-2">
            {defaultScenario.recommendedToolIds.map((toolId) => {
              const matchedTool = toolMapById[toolId];
              return matchedTool ? (
                <button
                  type="button"
                  data-kfeg-jump-tool={matchedTool.id}
                  class="px-2.5 py-1 rounded-lg text-[11.5px] font-bold bg-white/12 hover:bg-signature-coral text-white border border-white/20 transition-colors cursor-pointer"
                >
                  {matchedTool.icon} {matchedTool.shortName} ↓
                </button>
              ) : null;
            })}
          </div>
        </div>

        <!-- P.A.S.S. Fire Extinguisher Technique Strip -->
        <div
          id="kfeg-pass-panel"
          class="p-4 sm:p-5 rounded-xl bg-white/6 border border-amber-400/40 space-y-3"
        >
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div>
              <span class="inline-block text-[10.5px] font-extrabold uppercase tracking-wider text-amber-200">
                🧯 {passTechnique.badge}
              </span>
              <h4 class="text-sm sm:text-base font-extrabold text-white">{passTechnique.title}</h4>
            </div>
          </div>
          <p class="text-xs text-white/85 leading-relaxed">{passTechnique.subtitle}</p>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5">
            {passTechnique.steps.map((step) => (
              <div class="p-3 rounded-xl bg-white/8 border border-white/14 space-y-1">
                <div class="flex items-center gap-2">
                  <span class="inline-flex items-center justify-center w-7 h-7 rounded-lg bg-signature-coral text-white text-sm font-extrabold shrink-0">
                    {step.letter}
                  </span>
                  <span class="text-xs sm:text-[13px] font-extrabold text-white">{step.word}</span>
                </div>
                <p class="text-[11.5px] text-white/85 leading-relaxed">{step.detail}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- PART 2: Interactive Fire Extinguisher & Kitchen Tool Matcher -->
    <div id="kfeg-matcher-section" class="p-5 sm:p-6 space-y-6">
      <div class="space-y-1">
        <span class="inline-block px-2.5 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wider bg-primary text-on-primary">
          🧯 {t.matcherBadge}
        </span>
        <h3 class="text-base sm:text-lg font-bold text-ink">{t.matcherHeading}</h3>
        <p class="text-xs sm:text-[13px] text-muted leading-relaxed">{t.matcherSub}</p>
      </div>

      <!-- 6 Clickable Home Fire Tool Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 print:hidden" role="group" aria-label={t.matcherHeading}>
        {localizedTools.map((tool, idx) => (
          <button
            type="button"
            data-kfeg-tool={tool.id}
            aria-pressed={idx === 0 ? 'true' : 'false'}
            class={`kfeg-tool-card text-left w-full p-4 rounded-2xl border transition-all cursor-pointer flex flex-col justify-between gap-2.5 ${
              idx === 0
                ? 'bg-canvas border-signature-coral ring-2 ring-signature-coral shadow-sm'
                : 'bg-surface-soft/65 border-hairline hover:border-signature-coral'
            }`}
          >
            <div class="space-y-1.5">
              <div class="flex items-start gap-2.5">
                <span aria-hidden="true" class="text-xl leading-none mt-0.5 shrink-0">{tool.icon}</span>
                <div class="min-w-0">
                  <h4 class="text-sm font-extrabold text-ink leading-snug">{tool.shortName}</h4>
                  <span
                    class={`inline-block mt-1 px-2 py-0.5 rounded-md text-[10px] font-extrabold uppercase tracking-wider border ${
                      tool.verdictLevel === 'deadly'
                        ? 'bg-red-500/15 text-red-800 dark:text-red-200 border-red-500/40'
                        : tool.verdictLevel === 'best'
                          ? 'bg-emerald-500/15 text-emerald-800 dark:text-emerald-200 border-emerald-500/40'
                          : 'bg-amber-500/15 text-amber-900 dark:text-amber-200 border-amber-500/40'
                    }`}
                  >
                    {tool.verdictBadge}
                  </span>
                </div>
              </div>
            </div>

            <!-- Compact 4-Fire Mini Status Dots -->
            <div class="pt-2 border-t border-hairline/70 grid grid-cols-2 gap-1.5 text-[10.5px] font-bold">
              {fireTypeDefs.map((ft) => {
                const r = tool.ratings[ft.key];
                const dotColor =
                  r === 'safe'
                    ? 'text-emerald-700 dark:text-emerald-300'
                    : r === 'caution'
                      ? 'text-amber-800 dark:text-amber-300'
                      : 'text-red-700 dark:text-red-300';
                const mark = r === 'safe' ? '✓' : r === 'caution' ? '!' : '✕';
                return (
                  <span class={`truncate ${dotColor}`}>
                    {mark} {ft.label}
                  </span>
                );
              })}
            </div>
          </button>
        ))}
      </div>

      <!-- Active Tool Live Compatibility Breakdown Panel -->
      <div
        id="kfeg-tool-panel"
        aria-live="polite"
        class="rounded-2xl bg-surface-soft border border-hairline p-5 sm:p-6 space-y-5"
      >
        <!-- Tool Header Banner -->
        <div class="rounded-xl bg-surface-dark text-on-dark p-4 sm:p-5 flex flex-wrap items-center justify-between gap-3">
          <div class="space-y-1">
            <span
              id="kfeg-tool-verdict-pill"
              class={`inline-flex items-center px-2.5 py-0.5 rounded-md border text-[10.5px] font-extrabold uppercase tracking-wider ${getToolVerdictPillClasses(defaultTool.verdictLevel)}`}
            >
              {defaultTool.verdictBadge}
            </span>
            <h4 id="kfeg-tool-title" class="text-base sm:text-lg font-extrabold text-white leading-snug">
              {defaultTool.icon} {defaultTool.name}
            </h4>
          </div>
          <div class="p-3 rounded-xl bg-white/8 border border-white/15 max-w-md">
            <span class="block text-[10px] font-extrabold uppercase tracking-wider text-signature-peach">
              📏 {t.distanceRuleLabel}
            </span>
            <p id="kfeg-tool-distance" class="text-xs font-semibold text-white/95 leading-relaxed mt-0.5">
              {defaultTool.distanceRule}
            </p>
          </div>
        </div>

        <!-- 4 Fire Types Rating Cards -->
        <div class="space-y-2.5">
          <h5 class="text-xs font-extrabold uppercase tracking-wider text-ink">
            🎯 {t.matrixHeading}
          </h5>
          <div id="kfeg-tool-matrix" class="grid grid-cols-1 md:grid-cols-2 gap-3">
            {fireTypeDefs.map((ft) => {
              const rating = defaultTool.ratings[ft.key];
              const note = defaultTool.fireNotes[ft.key];
              return (
                <div class={`p-4 rounded-xl border space-y-2 ${getRatingCardClasses(rating)}`}>
                  <div class="flex items-center justify-between gap-2">
                    <span class="text-xs sm:text-[13px] font-extrabold text-ink">
                      {ft.icon} {ft.label}
                    </span>
                    <span
                      class={`inline-flex items-center px-2.5 py-0.5 rounded-full border text-[10.5px] font-extrabold uppercase tracking-wider ${getRatingBadgeClasses(rating)}`}
                    >
                      {getRatingLabel(rating)}
                    </span>
                  </div>
                  <p class="text-xs text-body leading-relaxed">{note}</p>
                </div>
              );
            })}
          </div>
        </div>

        <!-- Best Use / Critical Warning / Cleanup Trio -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
          <div class="p-4 rounded-xl bg-canvas border border-hairline space-y-1">
            <span class="block text-[11px] font-extrabold uppercase tracking-wider text-emerald-700 dark:text-emerald-300">
              ✅ {t.bestUseLabel}
            </span>
            <p id="kfeg-tool-best" class="text-xs text-body leading-relaxed">
              {defaultTool.bestUse}
            </p>
          </div>

          <div class="p-4 rounded-xl bg-error-bg/50 dark:bg-red-950/35 border border-error-border/65 space-y-1">
            <span class="block text-[11px] font-extrabold uppercase tracking-wider text-error-border dark:text-red-300">
              ⚠️ {t.criticalWarningLabel}
            </span>
            <p id="kfeg-tool-warning" class="text-xs font-semibold text-ink leading-relaxed">
              {defaultTool.criticalWarning}
            </p>
          </div>

          <div class="p-4 rounded-xl bg-canvas border border-hairline space-y-1">
            <span class="block text-[11px] font-extrabold uppercase tracking-wider text-ink">
              🧹 {t.cleanupLabel}
            </span>
            <p id="kfeg-tool-cleanup" class="text-xs text-body leading-relaxed">
              {defaultTool.cleanupNote}
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Print-Only Complete 6-Scenario Fridge Safety Poster Summary -->
    <div class="hidden print:block p-5 border-t border-hairline space-y-4">
      <div class="text-center border-b border-hairline pb-2">
        <h3 class="text-sm font-extrabold uppercase tracking-wider text-ink">{t.printPosterTitle}</h3>
        <p class="text-[11px] text-muted">{t.printPosterSub}</p>
      </div>
      <div class="grid grid-cols-2 gap-3">
        {localizedScenarios.map((sc) => (
          <div class="p-3 rounded-lg border border-hairline space-y-1.5 break-inside-avoid">
            <h4 class="text-xs font-extrabold text-ink">
              {sc.icon} {sc.shortName}
            </h4>
            <p class="text-[11px] text-ink">
              <strong>✅</strong> {sc.doSteps[0]} {sc.doSteps[1] || ''}
            </p>
            <p class="text-[11px] text-ink">
              <strong>🚫</strong> {sc.neverDo[0]}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Related Companion Tools -->
  <section class="space-y-4 print:hidden">
    <h2 class="text-title-md font-semibold text-ink">{t.relatedHeading}</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      <a
        href={oilSmokePointUrl}
        class="p-6 rounded-2xl bg-surface-soft border border-hairline hover:border-signature-coral transition-all group block"
      >
        <span class="text-[11px] font-bold uppercase tracking-wider text-signature-coral block mb-1.5">
          {t.relatedOilTag}
        </span>
        <h3 class="text-title-sm font-semibold text-ink group-hover:text-signature-coral transition-colors mb-1.5">
          {t.relatedOilTitle}
        </h3>
        <p class="text-[13.5px] text-body leading-relaxed">{t.relatedOilDesc}</p>
      </a>

      <a
        href={cleanerMixingUrl}
        class="p-6 rounded-2xl bg-surface-soft border border-hairline hover:border-signature-coral transition-all group block"
      >
        <span class="text-[11px] font-bold uppercase tracking-wider text-signature-coral block mb-1.5">
          {t.relatedCleanerTag}
        </span>
        <h3 class="text-title-sm font-semibold text-ink group-hover:text-signature-coral transition-colors mb-1.5">
          {t.relatedCleanerTitle}
        </h3>
        <p class="text-[13.5px] text-body leading-relaxed">{t.relatedCleanerDesc}</p>
      </a>

      <a
        href={ovenRackUrl}
        class="p-6 rounded-2xl bg-surface-soft border border-hairline hover:border-signature-coral transition-all group block"
      >
        <span class="text-[11px] font-bold uppercase tracking-wider text-signature-coral block mb-1.5">
          {t.relatedOvenTag}
        </span>
        <h3 class="text-title-sm font-semibold text-ink group-hover:text-signature-coral transition-colors mb-1.5">
          {t.relatedOvenTitle}
        </h3>
        <p class="text-[13.5px] text-body leading-relaxed">{t.relatedOvenDesc}</p>
      </a>
    </div>
  </section>

  <!-- Methodology & Hub Strip -->
  <section class="p-6 rounded-2xl bg-surface-soft border border-hairline print:hidden">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <h2 class="text-title-sm font-semibold text-ink mb-1">{t.methodologyStripTitle}</h2>
        <p class="text-[13px] text-muted">
          {t.methodologyStripPrefix}{' '}
          <a href={methodologyUrl} class="text-link underline hover:text-link-active">{t.methodologyLabel}</a>.
        </p>
      </div>
      <div class="flex flex-wrap gap-2">
        <a
          href={oilSmokePointUrl}
          class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral transition-colors"
        >
          {t.oilQuickLabel}
        </a>
        <a
          href={methodologyUrl}
          class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral transition-colors"
        >
          {t.methodologyLabel}
        </a>
        <a
          href={allToolsUrl}
          class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-primary text-on-primary hover:bg-primary-active transition-colors"
        >
          {t.allToolsLabel}
        </a>
      </div>
    </div>
  </section>

  <!-- Visible FAQ Accordion (Matches JSON-LD 1:1) -->
  <section class="print:hidden">
    <h2 class="text-title-lg font-medium text-ink tracking-tight mb-6">
      {t.faqTitle}
    </h2>
    <div class="space-y-4">
      {localizedFaqs.map((faq) => (
        <details class="group p-5 bg-surface-soft border border-hairline rounded-xl" open>
          <summary class="text-title-sm font-semibold text-ink cursor-pointer list-none flex items-center justify-between gap-3">
            <span>{faq.question}</span>
            <span class="text-muted text-sm transition-transform group-open:rotate-180 shrink-0" aria-hidden="true">&#9662;</span>
          </summary>
          <p class="text-[14px] text-body leading-relaxed mt-3 pt-3 border-t border-hairline/70">
            {faq.answer}
          </p>
        </details>
      ))}
    </div>
  </section>
</div>

<script is:inline>
  (function () {
    var payloadEl = document.getElementById('kfeg-payload');
    if (!payloadEl) return;

    var payload;
    try {
      payload = JSON.parse(payloadEl.textContent || '{}');
    } catch (_) {
      return;
    }

    var scenarios = Array.isArray(payload.scenarios) ? payload.scenarios : [];
    var tools = Array.isArray(payload.tools) ? payload.tools : [];
    var passSteps = Array.isArray(payload.passSteps) ? payload.passSteps : [];
    var ui = payload.ui || {};

    var scenarioMap = {};
    scenarios.forEach(function (sc) {
      if (sc && sc.id) scenarioMap[sc.id] = sc;
    });

    var toolMap = {};
    tools.forEach(function (tl) {
      if (tl && tl.id) toolMap[tl.id] = tl;
    });

    var state = {
      scenarioId: payload.defaultScenarioId || (scenarios[0] ? scenarios[0].id : ''),
      toolId: payload.defaultToolId || (tools[0] ? tools[0].id : '')
    };

    var fireTypes = [
      { key: 'grease', icon: '🍳', label: ui.fireTypeGrease || 'Grease / Oil Pan Fire' },
      { key: 'electrical', icon: '🔌', label: ui.fireTypeElectrical || 'Electrical / Appliance' },
      { key: 'oven', icon: '🚪', label: ui.fireTypeOven || 'Closed Oven / Microwave' },
      { key: 'paper', icon: '📄', label: ui.fireTypePaper || 'Paper / Wood / Trash' }
    ];

    // DOM References
    var scenarioBtns = Array.from(document.querySelectorAll('.kfeg-scenario-btn'));
    var toolCards = Array.from(document.querySelectorAll('.kfeg-tool-card'));

    var elDashboard = document.getElementById('kfeg-dashboard');
    var elUrgencyPill = document.getElementById('kfeg-urgency-pill');
    var elSourcePill = document.getElementById('kfeg-source-pill');
    var elPassBadge = document.getElementById('kfeg-pass-badge');
    var elScenarioTitle = document.getElementById('kfeg-scenario-title');
    var elScenarioSummary = document.getElementById('kfeg-scenario-summary');
    var elDoList = document.getElementById('kfeg-do-list');
    var elNeverList = document.getElementById('kfeg-never-list');
    var elEvacuateText = document.getElementById('kfeg-evacuate-text');
    var elRationaleText = document.getElementById('kfeg-rationale-text');
    var elRecTools = document.getElementById('kfeg-rec-tools');
    var elPassPanel = document.getElementById('kfeg-pass-panel');

    var elMatcherSection = document.getElementById('kfeg-matcher-section');
    var elToolVerdictPill = document.getElementById('kfeg-tool-verdict-pill');
    var elToolTitle = document.getElementById('kfeg-tool-title');
    var elToolDistance = document.getElementById('kfeg-tool-distance');
    var elToolMatrix = document.getElementById('kfeg-tool-matrix');
    var elToolBest = document.getElementById('kfeg-tool-best');
    var elToolWarning = document.getElementById('kfeg-tool-warning');
    var elToolCleanup = document.getElementById('kfeg-tool-cleanup');

    var copyBtn = document.getElementById('kfeg-copy-btn');
    var copyLabel = document.getElementById('kfeg-copy-label');
    var printBtn = document.getElementById('kfeg-print-btn');

    function clearChildren(node) {
      if (!node) return;
      while (node.firstChild) {
        node.removeChild(node.firstChild);
      }
    }

    function getRatingLabel(rating) {
      if (rating === 'safe') return ui.ratingSafe || 'SAFE';
      if (rating === 'caution') return ui.ratingCaution || 'CAUTION';
      return ui.ratingDeadly || 'DEADLY / NO';
    }

    function getRatingBadgeClass(rating) {
      if (rating === 'safe') {
        return 'inline-flex items-center px-2.5 py-0.5 rounded-full border text-[10.5px] font-extrabold uppercase tracking-wider bg-emerald-500/20 text-emerald-800 dark:text-emerald-200 border-emerald-500/40';
      }
      if (rating === 'caution') {
        return 'inline-flex items-center px-2.5 py-0.5 rounded-full border text-[10.5px] font-extrabold uppercase tracking-wider bg-amber-500/20 text-amber-900 dark:text-amber-200 border-amber-500/45';
      }
      return 'inline-flex items-center px-2.5 py-0.5 rounded-full border text-[10.5px] font-extrabold uppercase tracking-wider bg-red-500/20 text-red-800 dark:text-red-200 border-red-500/50';
    }

    function getRatingCardClass(rating) {
      if (rating === 'safe') return 'p-4 rounded-xl border space-y-2 bg-emerald-500/8 border-emerald-500/35';
      if (rating === 'caution') return 'p-4 rounded-xl border space-y-2 bg-amber-500/8 border-amber-500/40';
      return 'p-4 rounded-xl border space-y-2 bg-red-500/10 border-red-500/45';
    }

    function getVerdictPillClass(level) {
      var base = 'inline-flex items-center px-2.5 py-0.5 rounded-md border text-[10.5px] font-extrabold uppercase tracking-wider ';
      if (level === 'best') return base + 'bg-emerald-500/20 text-emerald-200 border-emerald-400/40';
      if (level === 'good') return base + 'bg-amber-500/20 text-amber-200 border-amber-400/40';
      return base + 'bg-red-500/25 text-red-100 border-red-400/55';
    }

    function renderScenario() {
      var sc = scenarioMap[state.scenarioId] || scenarios[0];
      if (!sc) return;

      // Update selector buttons
      scenarioBtns.forEach(function (btn) {
        var active = btn.getAttribute('data-kfeg-scenario') === sc.id;
        btn.setAttribute('aria-pressed', active ? 'true' : 'false');
        btn.classList.toggle('bg-primary', active);
        btn.classList.toggle('text-on-primary', active);
        btn.classList.toggle('border-primary', active);
        btn.classList.toggle('ring-2', active);
        btn.classList.toggle('ring-signature-coral/60', active);
        btn.classList.toggle('shadow-sm', active);
        btn.classList.toggle('bg-canvas', !active);
        btn.classList.toggle('text-ink', !active);
        btn.classList.toggle('border-hairline', !active);

        var sub = btn.querySelector('[data-kfeg-scenario-sub]');
        if (sub) {
          sub.classList.toggle('text-white/80', active);
          sub.classList.toggle('text-muted', !active);
        }
      });

      // Dashboard left accent border
      if (elDashboard) {
        elDashboard.classList.remove('border-error-border', 'border-amber-400', 'border-sky-400');
        if (sc.severity === 'medical') {
          elDashboard.classList.add('border-sky-400');
        } else if (sc.severity === 'high') {
          elDashboard.classList.add('border-amber-400');
        } else {
          elDashboard.classList.add('border-error-border');
        }
      }

      if (elUrgencyPill) {
        elUrgencyPill.textContent = sc.urgencyTag || '';
        elUrgencyPill.className = 'inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-extrabold uppercase tracking-wider ' + (
          sc.severity === 'medical'
            ? 'bg-sky-500 text-slate-950'
            : sc.severity === 'high'
              ? 'bg-amber-500 text-slate-950'
              : 'bg-error-border text-white'
        );
      }

      if (elSourcePill) elSourcePill.textContent = sc.sourceTag || '';
      if (elScenarioTitle) elScenarioTitle.textContent = (sc.icon ? sc.icon + ' ' : '') + (sc.name || '');
      if (elScenarioSummary) elScenarioSummary.textContent = sc.summary || '';
      if (elEvacuateText) elEvacuateText.textContent = sc.evacuateTrigger || '';
      if (elRationaleText) elRationaleText.textContent = sc.rationale || '';

      if (elPassBadge) {
        if (sc.showPass) {
          elPassBadge.textContent = '🧯 ' + (ui.passApplicableTag || 'P.A.S.S. APPLICABLE');
          elPassBadge.className = 'inline-flex items-center px-2.5 py-0.5 rounded-md border text-[10.5px] font-extrabold uppercase tracking-wider bg-amber-500/20 text-amber-200 border-amber-400/40';
        } else {
          elPassBadge.textContent = 'ℹ️ ' + (ui.passAlwaysNote || 'P.A.S.S. FOR SMALL FIRES ONLY');
          elPassBadge.className = 'inline-flex items-center px-2.5 py-0.5 rounded-md border text-[10.5px] font-bold bg-white/8 text-white/80 border-white/15';
        }
      }

      if (elPassPanel) {
        elPassPanel.classList.toggle('border-amber-400/50', Boolean(sc.showPass));
        elPassPanel.classList.toggle('border-white/12', !sc.showPass);
      }

      // Render numbered DO steps
      clearChildren(elDoList);
      if (elDoList && Array.isArray(sc.doSteps)) {
        sc.doSteps.forEach(function (step, idx) {
          var li = document.createElement('li');
          li.className = 'flex items-start gap-2.5 text-xs sm:text-[13.5px] text-white/95 leading-relaxed';

          var badge = document.createElement('span');
          badge.className = 'inline-flex items-center justify-center w-6 h-6 rounded-full bg-emerald-500 text-slate-950 text-xs font-extrabold shrink-0 mt-0.5';
          badge.textContent = String(idx + 1);

          var textSpan = document.createElement('span');
          textSpan.textContent = step;

          li.appendChild(badge);
          li.appendChild(textSpan);
          elDoList.appendChild(li);
        });
      }

      // Render NEVER DO lethal mistakes
      clearChildren(elNeverList);
      if (elNeverList && Array.isArray(sc.neverDo)) {
        sc.neverDo.forEach(function (mistake) {
          var li = document.createElement('li');
          li.className = 'flex items-start gap-2.5 text-xs sm:text-[13.5px] text-white/95 leading-relaxed';

          var badge = document.createElement('span');
          badge.className = 'inline-flex items-center justify-center w-6 h-6 rounded-full bg-error-border text-white text-xs font-extrabold shrink-0 mt-0.5';
          badge.textContent = '✕';

          var textSpan = document.createElement('span');
          textSpan.textContent = mistake;

          li.appendChild(badge);
          li.appendChild(textSpan);
          elNeverList.appendChild(li);
        });
      }

      // Render recommended tool jump buttons
      clearChildren(elRecTools);
      if (elRecTools) {
        var recIds = Array.isArray(sc.recommendedToolIds) ? sc.recommendedToolIds : [];
        if (recIds.length === 0) {
          var noteSpan = document.createElement('span');
          noteSpan.className = 'text-xs text-white/80 font-medium';
          noteSpan.textContent = ui.noFireToolNote || 'Follow immediate evacuation or cool-water first aid strictly.';
          elRecTools.appendChild(noteSpan);
        } else {
          recIds.forEach(function (tId) {
            var matched = toolMap[tId];
            if (!matched) return;
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.setAttribute('data-kfeg-jump-tool', matched.id);
            btn.className = 'px-2.5 py-1 rounded-lg text-[11.5px] font-bold bg-white/12 hover:bg-signature-coral text-white border border-white/20 transition-colors cursor-pointer';
            btn.textContent = matched.icon + ' ' + matched.shortName + ' ↓';
            btn.addEventListener('click', function () {
              state.toolId = matched.id;
              renderTool();
              if (elMatcherSection && elMatcherSection.scrollIntoView) {
                elMatcherSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
              }
            });
            elRecTools.appendChild(btn);
          });
        }
      }
    }

    function renderTool() {
      var tl = toolMap[state.toolId] || tools[0];
      if (!tl) return;

      // Update tool selection cards
      toolCards.forEach(function (card) {
        var active = card.getAttribute('data-kfeg-tool') === tl.id;
        card.setAttribute('aria-pressed', active ? 'true' : 'false');
        card.classList.toggle('bg-canvas', active);
        card.classList.toggle('border-signature-coral', active);
        card.classList.toggle('ring-2', active);
        card.classList.toggle('ring-signature-coral', active);
        card.classList.toggle('shadow-sm', active);
        card.classList.toggle('bg-surface-soft/65', !active);
        card.classList.toggle('border-hairline', !active);
      });

      if (elToolVerdictPill) {
        elToolVerdictPill.textContent = tl.verdictBadge || '';
        elToolVerdictPill.className = getVerdictPillClass(tl.verdictLevel);
      }
      if (elToolTitle) elToolTitle.textContent = (tl.icon ? tl.icon + ' ' : '') + (tl.name || '');
      if (elToolDistance) elToolDistance.textContent = tl.distanceRule || '';
      if (elToolBest) elToolBest.textContent = tl.bestUse || '';
      if (elToolWarning) elToolWarning.textContent = tl.criticalWarning || '';
      if (elToolCleanup) elToolCleanup.textContent = tl.cleanupNote || '';

      // Render 4 fire-type compatibility cards
      clearChildren(elToolMatrix);
      if (elToolMatrix && tl.ratings && tl.fireNotes) {
        fireTypes.forEach(function (ft) {
          var rating = tl.ratings[ft.key] || 'caution';
          var note = tl.fireNotes[ft.key] || '';

          var card = document.createElement('div');
          card.className = getRatingCardClass(rating);

          var topRow = document.createElement('div');
          topRow.className = 'flex items-center justify-between gap-2';

          var nameSpan = document.createElement('span');
          nameSpan.className = 'text-xs sm:text-[13px] font-extrabold text-ink';
          nameSpan.textContent = ft.icon + ' ' + ft.label;

          var badgeSpan = document.createElement('span');
          badgeSpan.className = getRatingBadgeClass(rating);
          badgeSpan.textContent = getRatingLabel(rating);

          topRow.appendChild(nameSpan);
          topRow.appendChild(badgeSpan);

          var bodyP = document.createElement('p');
          bodyP.className = 'text-xs text-body leading-relaxed';
          bodyP.textContent = note;

          card.appendChild(topRow);
          card.appendChild(bodyP);
          elToolMatrix.appendChild(card);
        });
      }
    }

    function buildCopySummary() {
      var sc = scenarioMap[state.scenarioId] || scenarios[0];
      var tl = toolMap[state.toolId] || tools[0];
      var lines = [];

      lines.push(ui.copyHeader || 'IsItKitchenSafe — Kitchen Fire & Burn Emergency Card');
      lines.push(ui.copyEmergencyLine || 'IF FIRE SPREADS: EVACUATE & CALL 911 / 112 / 119 / 193!');
      lines.push('');

      if (sc) {
        lines.push((ui.copyScenarioLine || 'ACTIVE SCENARIO:') + ' ' + sc.name + ' [' + sc.sourceTag + ']');
        lines.push('');
        lines.push(ui.copyDoHeader || 'DO IMMEDIATELY:');
        (sc.doSteps || []).forEach(function (step, i) {
          lines.push('  ' + (i + 1) + '. ' + step);
        });
        lines.push('');
        lines.push(ui.copyNeverHeader || 'NEVER DO:');
        (sc.neverDo || []).forEach(function (mistake) {
          lines.push('  - ' + mistake);
        });
        lines.push('');
        lines.push((ui.copyEvacuateLine || 'EVACUATE:') + ' ' + (sc.evacuateTrigger || ''));
      }

      if (tl) {
        lines.push('');
        lines.push((ui.copyToolHeader || 'SELECTED TOOL:') + ' ' + tl.name + ' (' + tl.verdictBadge + ')');
        lines.push('  ' + (tl.distanceRule || ''));
        fireTypes.forEach(function (ft) {
          var r = tl.ratings ? tl.ratings[ft.key] : '';
          lines.push('  * ' + ft.label + ': [' + getRatingLabel(r) + '] ' + (tl.fireNotes ? tl.fireNotes[ft.key] : ''));
        });
      }

      if (passSteps.length > 0) {
        lines.push('');
        lines.push(ui.copyPassHeader || 'P.A.S.S. EXTINGUISHER TECHNIQUE:');
        passSteps.forEach(function (st) {
          lines.push('  ' + st.letter + ' - ' + st.word + ': ' + st.detail);
        });
      }

      return lines.join('\n');
    }

    // Bind Scenario Buttons
    scenarioBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var id = btn.getAttribute('data-kfeg-scenario');
        if (id && scenarioMap[id]) {
          state.scenarioId = id;
          renderScenario();
        }
      });
    });

    // Bind Tool Cards
    toolCards.forEach(function (card) {
      card.addEventListener('click', function () {
        var id = card.getAttribute('data-kfeg-tool');
        if (id && toolMap[id]) {
          state.toolId = id;
          renderTool();
        }
      });
    });

    // Bind Initial Jump Tool Buttons
    Array.from(document.querySelectorAll('[data-kfeg-jump-tool]')).forEach(function (btn) {
      btn.addEventListener('click', function () {
        var tId = btn.getAttribute('data-kfeg-jump-tool');
        if (tId && toolMap[tId]) {
          state.toolId = tId;
          renderTool();
          if (elMatcherSection && elMatcherSection.scrollIntoView) {
            elMatcherSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }
      });
    });

    // Bind Copy Button
    if (copyBtn) {
      copyBtn.addEventListener('click', function () {
        var text = buildCopySummary();
        var showCopied = function () {
          if (copyLabel) copyLabel.textContent = ui.copiedBtn || 'Reference Card Copied ✓';
          window.setTimeout(function () {
            if (copyLabel) copyLabel.textContent = '📋 ' + (ui.copyBtn || 'Copy Emergency Reference Card');
          }, 2200);
        };

        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(showCopied).catch(showCopied);
        } else {
          var ta = document.createElement('textarea');
          ta.value = text;
          ta.setAttribute('readonly', '');
          ta.style.position = 'absolute';
          ta.style.left = '-9999px';
          document.body.appendChild(ta);
          ta.select();
          try {
            document.execCommand('copy');
          } catch (_) {
            // ignore
          }
          document.body.removeChild(ta);
          showCopied();
        }
      });
    }

    // Bind Print Button
    if (printBtn) {
      printBtn.addEventListener('click', function () {
        window.print();
      });
    }

    renderScenario();
    renderTool();
  })();
</script>
