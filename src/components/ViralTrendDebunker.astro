const d = DICT[lang] || DICT.en;

// Preset trending topics
const presets = [
  { id: 'microwave-hard-boiled-eggs', label: '🍳 Exploding Microwave Eggs' },
  { id: 'dishwasher-poached-salmon', label: '🐟 Dishwasher Poached Salmon' },
  { id: 'toaster-horizontal-grilled-cheese', label: '🥪 Horizontal Toaster Fire' },
  { id: 'air-fryer-popcorn', label: '🍿 Air Fryer Popcorn Hazard' },
  { id: 'oven-glass-ice-bath', label: '💥 Hot Pyrex Ice Shock' },
  { id: 'dish-soap-in-dishwasher', label: '🧼 Dawn Soap Dishwasher Flood' }
];

const basePath = lang === 'en' ? '' : `/${lang}`;
---

<div id="viral-debunker-app" class="space-y-10" data-lang={lang}>
  <!-- Top Search & Filter Bar -->
  <div class="bg-surface-soft border border-hairline rounded-2xl p-6 md:p-8 space-y-6 shadow-xs">
    <!-- Search Input -->
    <div class="relative">
      <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-muted">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
      <input 
        type="search" 
        id="myth-search-input"
        placeholder={d.searchPlaceholder}
        class="w-full pl-11 pr-4 py-3.5 bg-canvas border border-hairline rounded-xl text-ink placeholder:text-muted focus:outline-none focus:ring-2 focus:ring-signature-coral text-sm md:text-base transition-all"
      />
    </div>

    <!-- Appliance & Danger Filter Dropdowns / Pills -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
      <div>
        <label for="appliance-filter" class="block text-xs font-semibold text-muted uppercase tracking-wider mb-2">
          {lang === 'en' ? 'Filter by Appliance' : 'Electrodoméstico / 家电'}
        </label>
        <select 
          id="appliance-filter" 
          class="w-full bg-canvas border border-hairline rounded-xl px-3.5 py-2.5 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-signature-coral"
        >
          <option value="all">{d.allAppliances}</option>
          <option value="microwave">{d.microwave}</option>
          <option value="air-fryer">{d.airFryer}</option>
          <option value="dishwasher">{d.dishwasher}</option>
          <option value="oven">{d.oven}</option>
          <option value="toaster">{d.toaster}</option>
          <option value="freezer">{d.freezer}</option>
        </select>
      </div>

      <div>
        <label for="verdict-filter" class="block text-xs font-semibold text-muted uppercase tracking-wider mb-2">
          {lang === 'en' ? 'Filter by Danger Severity' : 'Nivel de Riesgo / 危险等级'}
        </label>
        <select 
          id="verdict-filter" 
          class="w-full bg-canvas border border-hairline rounded-xl px-3.5 py-2.5 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-signature-coral"
        >
          <option value="all">{d.allVerdicts}</option>
          <option value="critical">{d.verdictCritical}</option>
          <option value="high">{d.verdictHigh}</option>
          <option value="ineffective">{d.verdictIneffective}</option>
          <option value="plausible">{d.verdictPlausible}</option>
        </select>
      </div>

      <div class="flex items-end">
        <button 
          id="reset-filters-btn"
          type="button"
          class="w-full py-2.5 px-4 rounded-xl border border-hairline bg-surface hover:bg-surface-strong text-xs font-medium text-ink transition-colors flex items-center justify-center gap-1.5"
        >
          <svg class="w-3.5 h-3.5 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          {d.resetFiltersBtn}
        </button>
      </div>
    </div>

    <!-- Quick Trending Presets -->
    <div class="pt-2 border-t border-hairline/60">
      <span class="text-xs font-medium text-muted mr-2 block sm:inline mb-2 sm:mb-0">
        {d.trendingHeading}
      </span>
      <div class="inline-flex flex-wrap gap-2">
        {presets.map(p => (
          <button 
            type="button" 
            data-preset={p.id}
            class="preset-pill px-3 py-1 rounded-full text-xs bg-canvas hover:bg-signature-coral/10 hover:text-signature-coral border border-hairline transition-colors text-ink font-medium"
          >
            {p.label}
          </button>
        ))}
      </div>
    </div>
  </div>

  <!-- Live Counter and Emergency Callout -->
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 py-2 border-b border-hairline">
    <div class="flex items-center gap-2">
      <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-signature-coral/15 text-signature-coral font-bold text-xs" id="active-count">
        {mythsData.length}
      </span>
      <span class="text-xs md:text-sm font-semibold text-ink">
        {d.resultsCount}
      </span>
    </div>

    <a 
      href={`${basePath}/tools/kitchen-hazard-emergency-triage/`}
      class="inline-flex items-center gap-1.5 text-xs font-bold text-red-600 hover:text-red-700 hover:underline bg-red-50 dark:bg-red-950/40 border border-red-200 dark:border-red-900/60 px-3 py-1.5 rounded-lg transition-colors"
    >
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-red-600"></span>
      </span>
      {d.emergencyCrossLink} &rarr;
    </a>
  </div>

  <!-- Zero Results Message -->
  <div id="zero-results" class="hidden p-12 text-center rounded-2xl bg-surface-soft border border-hairline">
    <div class="w-12 h-12 mx-auto mb-3 rounded-full bg-muted/10 flex items-center justify-center text-muted">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    </div>
    <h3 class="text-base font-semibold text-ink mb-1">{d.noResultsTitle}</h3>
    <p class="text-xs text-muted max-w-md mx-auto">{d.noResultsDesc}</p>
  </div>

  <!-- Myths Cards Grid -->
  <div id="myths-container" class="space-y-8">
    {mythsData.map((myth) => {
      const isCritical = myth.dangerScore >= 90;
      const isHigh = myth.dangerScore >= 75 && myth.dangerScore < 90;
      const isModerate = myth.dangerScore >= 40 && myth.dangerScore < 75;

      const scoreColor = isCritical 
        ? 'bg-red-600 text-white' 
        : isHigh 
          ? 'bg-amber-600 text-white' 
          : isModerate 
            ? 'bg-yellow-500 text-black' 
            : 'bg-emerald-600 text-white';

      const borderAccent = isCritical 
        ? 'border-red-500/40 dark:border-red-800/60' 
        : 'border-hairline';

      return (
        <article 
          class={`myth-card bg-surface-soft border ${borderAccent} rounded-2xl p-6 md:p-8 space-y-6 shadow-xs transition-all`}
          data-id={myth.id}
          data-appliance={myth.appliance}
          data-danger={myth.dangerScore}
          data-verdict={myth.verdict.toLowerCase()}
          data-tags={myth.tags.join(' ')}
          data-title={myth.title.toLowerCase()}
          data-claim={myth.viralClaim.toLowerCase()}
        >
          <!-- Card Header -->
          <div class="flex flex-wrap items-start justify-between gap-3 border-b border-hairline/60 pb-4">
            <div class="space-y-1.5">
              <div class="flex flex-wrap items-center gap-2">
                <span class="inline-block px-2.5 py-0.5 rounded-md text-[11px] font-bold uppercase tracking-wider bg-surface border border-hairline text-ink">
                  {myth.applianceName}
                </span>
                <span class="inline-block px-2.5 py-0.5 rounded-md text-[11px] font-semibold text-muted bg-canvas border border-hairline">
                  {myth.platformTrend}
                </span>
                {isCritical && (
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-md text-[11px] font-extrabold bg-red-600/10 text-red-600 border border-red-500/30">
                    <span class="w-1.5 h-1.5 rounded-full bg-red-600 animate-pulse"></span>
                    {myth.dangerBadge}
                  </span>
                )}
              </div>
              <h2 class="text-title-lg md:text-title-xl font-bold text-ink tracking-tight">
                {myth.title}
              </h2>
            </div>

            <!-- Danger Score Pill -->
            <div class="flex items-center gap-2 bg-canvas border border-hairline rounded-xl px-3.5 py-1.5">
              <span class="text-xs text-muted font-medium">{d.dangerScoreLabel}:</span>
              <span class={`px-2 py-0.5 rounded-md font-mono text-xs font-black ${scoreColor}`}>
                {myth.dangerScore}/100
              </span>
            </div>
          </div>

          <!-- The Viral Claim vs The Scientific Reality Comparison -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <!-- Viral Claim Box -->
            <div class="p-4 md:p-5 rounded-xl bg-canvas border border-amber-500/30 dark:border-amber-900/50 space-y-2">
              <div class="flex items-center gap-2 text-amber-700 dark:text-amber-400 font-bold text-xs uppercase tracking-wider">
                <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                </svg>
                {d.viralClaimLabel}
              </div>
              <p class="text-sm text-body leading-relaxed italic">
                "{myth.viralClaim}"
              </p>
            </div>

            <!-- Scientific Reality Box -->
            <div class="p-4 md:p-5 rounded-xl bg-canvas border border-red-500/30 dark:border-red-900/50 space-y-2">
              <div class="flex items-center gap-2 text-red-600 dark:text-red-400 font-bold text-xs uppercase tracking-wider">
                <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                </svg>
                {d.scientificRealityLabel}
              </div>
              <p class="text-sm text-ink leading-relaxed font-medium">
                {myth.scientificReality}
              </p>
            </div>
          </div>

          <!-- Expandable Technical Breakdown Section -->
          <div class="technical-details hidden pt-4 border-t border-hairline/60 space-y-6">
            <!-- 1. Physics / Chemistry Details -->
            <div class="p-4 rounded-xl bg-canvas border border-hairline space-y-3">
              <h3 class="text-xs font-bold text-muted uppercase tracking-wider flex items-center gap-1.5">
                <svg class="w-4 h-4 text-signature-coral" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                </svg>
                {d.physicsHeading}
              </h3>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
                <div class="p-3 rounded-lg bg-surface-soft border border-hairline">
                  <span class="text-muted block mb-1">Core Principle:</span>
                  <span class="font-semibold text-ink">{myth.physicsThermodynamics.principle}</span>
                </div>
                <div class="p-3 rounded-lg bg-surface-soft border border-hairline">
                  <span class="text-muted block mb-1">Temperature Threshold:</span>
                  <span class="font-semibold text-ink">{myth.physicsThermodynamics.temperatureReached}</span>
                </div>
                <div class="p-3 rounded-lg bg-surface-soft border border-hairline">
                  <span class="text-muted block mb-1">Point of Failure:</span>
                  <span class="font-semibold text-ink">{myth.physicsThermodynamics.pointOfFailure}</span>
                </div>
              </div>
            </div>

            <!-- 2. Step-by-Step Breakdown Timeline -->
            <div class="space-y-3">
              <h3 class="text-xs font-bold text-muted uppercase tracking-wider">
                {d.timelineHeading}
              </h3>
              <div class="space-y-2">
                {myth.timelineBreakdown.map((t, idx) => (
                  <div class="flex items-start gap-3 p-3 rounded-xl bg-canvas border border-hairline text-xs">
                    <span class="px-2 py-0.5 rounded bg-surface border border-hairline font-mono font-bold text-ink shrink-0">
                      {t.time}
                    </span>
                    <div>
                      <strong class="text-ink mr-1 font-semibold">{t.stage}:</strong>
                      <span class="text-body">{t.phenomenon}</span>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <!-- 3. Real World Harm & Authority Warnings -->
            <div class="p-4 rounded-xl bg-red-500/5 border border-red-500/20 space-y-2 text-xs">
              <h3 class="font-bold text-red-600 dark:text-red-400 uppercase tracking-wider">
                {d.realWorldDamageHeading}
              </h3>
              <p class="text-body leading-relaxed">
                <strong class="text-ink">Injuries & Clinical Evidence:</strong> {myth.realWorldDamage.injuriesReported}
              </p>
              <p class="text-body leading-relaxed">
                <strong class="text-ink">Appliance Destruction:</strong> {myth.realWorldDamage.applianceImpact}
              </p>
              <p class="text-body leading-relaxed">
                <strong class="text-ink">Authority Warnings:</strong> {myth.realWorldDamage.regulatoryWarnings}
              </p>
            </div>

            <!-- 4. Verified Safe Alternative -->
            <div class="p-4 rounded-xl bg-emerald-500/5 border border-emerald-500/20 space-y-3 text-xs">
              <div class="flex items-center justify-between">
                <h3 class="font-bold text-emerald-700 dark:text-emerald-400 uppercase tracking-wider">
                  {d.safeAlternativeHeading}: {myth.safeAlternative.title}
                </h3>
                <span class="font-mono text-muted text-[11px]">
                  {myth.safeAlternative.timeRequired}
                </span>
              </div>
              <ol class="list-decimal list-inside space-y-1.5 text-body">
                {myth.safeAlternative.steps.map((st) => (
                  <li class="leading-relaxed">
                    <span class="text-ink font-medium">{st}</span>
                  </li>
                ))}
              </ol>
            </div>
          </div>

          <!-- Card Actions Bar -->
          <div class="flex flex-wrap items-center justify-between gap-3 pt-2">
            <button 
              type="button" 
              class="toggle-details-btn py-2 px-4 rounded-xl border border-hairline bg-surface hover:bg-surface-strong text-ink font-medium text-xs transition-colors flex items-center gap-1.5"
            >
              <svg class="w-3.5 h-3.5 transition-transform icon-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
              <span class="btn-label">{d.viewScienceBtn}</span>
            </button>

            <button 
              type="button" 
              class="copy-debunk-btn py-2 px-4 rounded-xl bg-ink hover:bg-black text-white text-xs font-semibold transition-colors flex items-center gap-1.5"
              data-title={myth.title}
              data-score={myth.dangerScore}
              data-reality={myth.scientificReality}
              data-alternative={myth.safeAlternative.title}
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
              </svg>
              {d.copyDebunkBtn}
            </button>
          </div>
        </article>
      );
    })}
  </div>

  <!-- Toast Notification -->
  <div 
    id="toast-notification" 
    class="fixed bottom-6 right-6 z-50 bg-ink text-white px-5 py-3 rounded-xl shadow-lg font-medium text-xs flex items-center gap-2 transform translate-y-24 opacity-0 transition-all duration-300 pointer-events-none"
  >
    <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
    </svg>
    <span id="toast-text">{d.copiedNotice}</span>
  </div>

  <!-- Related Kitchen Diagnostic Suite Links -->
  <section class="border-t border-hairline pt-10 space-y-4">
    <div class="max-w-2xl">
      <h3 class="text-base font-semibold text-ink">
        {d.relatedToolsHeading}
      </h3>
      <p class="text-xs text-muted leading-relaxed">
        {d.relatedToolsDesc}
      </p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
      <a href={`${basePath}/tools/kitchen-hazard-emergency-triage/`} class="p-3.5 rounded-xl bg-surface-soft hover:bg-surface-strong border border-hairline transition-colors text-xs font-semibold text-ink flex items-center justify-between">
        <span>{d.toolEmergency}</span>
        <span class="text-muted">&rarr;</span>
      </a>
      <a href={`${basePath}/tools/toxic-leaching-scorecard/`} class="p-3.5 rounded-xl bg-surface-soft hover:bg-surface-strong border border-hairline transition-colors text-xs font-semibold text-ink flex items-center justify-between">
        <span>{d.toolScorecard}</span>
        <span class="text-muted">&rarr;</span>
      </a>
      <a href={`${basePath}/tools/material-swap-calculator/`} class="p-3.5 rounded-xl bg-surface-soft hover:bg-surface-strong border border-hairline transition-colors text-xs font-semibold text-ink flex items-center justify-between">
        <span>{d.toolSwap}</span>
        <span class="text-muted">&rarr;</span>
      </a>
      <a href={`${basePath}/tools/product-recalls-scanner/`} class="p-3.5 rounded-xl bg-surface-soft hover:bg-surface-strong border border-hairline transition-colors text-xs font-semibold text-ink flex items-center justify-between">
        <span>{d.toolRecalls}</span>
        <span class="text-muted">&rarr;</span>
      </a>
      <a href={`${basePath}/tools/pan-scratch-inspector/`} class="p-3.5 rounded-xl bg-surface-soft hover:bg-surface-strong border border-hairline transition-colors text-xs font-semibold text-ink flex items-center justify-between">
        <span>{d.toolInspector}</span>
        <span class="text-muted">&rarr;</span>
      </a>
      <a href={`${basePath}/tools/thermal-shock-simulator/`} class="p-3.5 rounded-xl bg-surface-soft hover:bg-surface-strong border border-hairline transition-colors text-xs font-semibold text-ink flex items-center justify-between">
        <span>{d.toolThermal}</span>
        <span class="text-muted">&rarr;</span>
      </a>
      <a href={`${basePath}/tools/`} class="p-3.5 rounded-xl bg-signature-coral/10 hover:bg-signature-coral/20 border border-signature-coral/30 transition-colors text-xs font-bold text-signature-coral flex items-center justify-between">
        <span>{lang === 'en' ? 'All 8 Interactive Tools Hub' : lang === 'es' ? 'Centro de las 8 Herramientas' : lang === 'pt' ? 'Hub de 8 Ferramentas' : lang === 'zh-cn' ? '全部8大实用工具中心' : '全8大ツールハブ'}</span>
        <span>&rarr;</span>
      </a>
    </div>
  </section>
</div>

<script>
  function setupViralDebunker() {
    const root = document.getElementById('viral-debunker-app');
    if (!root) return;

    const searchInput = document.getElementById('myth-search-input') as HTMLInputElement | null;
    const applianceFilter = document.getElementById('appliance-filter') as HTMLSelectElement | null;
    const verdictFilter = document.getElementById('verdict-filter') as HTMLSelectElement | null;
    const resetBtn = document.getElementById('reset-filters-btn');
    const activeCountEl = document.getElementById('active-count');
    const zeroResultsEl = document.getElementById('zero-results');
    const cards = Array.from(root.querySelectorAll<HTMLElement>('.myth-card'));
    const presetButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('.preset-pill'));
    const toast = document.getElementById('toast-notification');

    function applyFilters() {
      const q = (searchInput?.value || '').trim().toLowerCase();
      const selectedAppliance = applianceFilter?.value || 'all';
      const selectedVerdict = verdictFilter?.value || 'all';

      let visibleCount = 0;

      cards.forEach(card => {
        const title = card.getAttribute('data-title') || '';
        const claim = card.getAttribute('data-claim') || '';
        const tags = card.getAttribute('data-tags') || '';
        const app = card.getAttribute('data-appliance') || '';
        const danger = parseInt(card.getAttribute('data-danger') || '0', 10);
        const verdict = card.getAttribute('data-verdict') || '';

        // Text query match
        const matchesQuery = !q || title.includes(q) || claim.includes(q) || tags.includes(q) || app.includes(q);

        // Appliance match
        const matchesAppliance = selectedAppliance === 'all' || app === selectedAppliance;

        // Verdict / Danger match
        let matchesVerdict = true;
        if (selectedVerdict === 'critical') {
          matchesVerdict = danger >= 90;
        } else if (selectedVerdict === 'high') {
          matchesVerdict = danger >= 75 && danger < 90;
        } else if (selectedVerdict === 'ineffective') {
          matchesVerdict = verdict.includes('ineffective');
        } else if (selectedVerdict === 'plausible') {
          matchesVerdict = verdict.includes('plausible') || verdict.includes('verified');
        }

        if (matchesQuery && matchesAppliance && matchesVerdict) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (activeCountEl) {
        activeCountEl.textContent = String(visibleCount);
      }

      if (zeroResultsEl) {
        if (visibleCount === 0) {
          zeroResultsEl.classList.remove('hidden');
        } else {
          zeroResultsEl.classList.add('hidden');
        }
      }
    }

    searchInput?.addEventListener('input', applyFilters);
    applianceFilter?.addEventListener('change', applyFilters);
    verdictFilter?.addEventListener('change', applyFilters);

    resetBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      if (applianceFilter) applianceFilter.value = 'all';
      if (verdictFilter) verdictFilter.value = 'all';
      applyFilters();
    });

    presetButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const presetId = btn.getAttribute('data-preset');
        if (searchInput && presetId) {
          const matchedCard = cards.find(c => c.getAttribute('data-id') === presetId);
          if (matchedCard) {
            const title = matchedCard.getAttribute('data-title') || '';
            const firstTwoWords = title.split(' ').slice(0, 3).join(' ');
            searchInput.value = firstTwoWords;
            if (applianceFilter) applianceFilter.value = 'all';
            if (verdictFilter) verdictFilter.value = 'all';
            applyFilters();
            matchedCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
            // Auto open details
            const detailSection = matchedCard.querySelector('.technical-details');
            const toggleBtn = matchedCard.querySelector('.toggle-details-btn');
            if (detailSection?.classList.contains('hidden')) {
              toggleBtn?.dispatchEvent(new Event('click'));
            }
          }
        }
      });
    });

    // Expand / collapse details
    cards.forEach(card => {
      const toggleBtn = card.querySelector<HTMLButtonElement>('.toggle-details-btn');
      const details = card.querySelector<HTMLElement>('.technical-details');
      const label = toggleBtn?.querySelector<HTMLElement>('.btn-label');
      const chevron = toggleBtn?.querySelector<HTMLElement>('.icon-chevron');

      toggleBtn?.addEventListener('click', () => {
        if (!details) return;
        const isHidden = details.classList.contains('hidden');
        if (isHidden) {
          details.classList.remove('hidden');
          if (label) label.textContent = root.getAttribute('data-lang') === 'en' ? 'Hide Technical Breakdown' : 'Ocultar / 收起 / 閉じる';
          if (chevron) chevron.classList.add('rotate-180');
        } else {
          details.classList.add('hidden');
          if (label) label.textContent = root.getAttribute('data-lang') === 'en' ? 'Inspect Physics & Timeline' : 'Ver Detalles / 查看详情 / 詳細を見る';
          if (chevron) chevron.classList.remove('rotate-180');
        }
      });

      // Copy debunk summary
      const copyBtn = card.querySelector<HTMLButtonElement>('.copy-debunk-btn');
      copyBtn?.addEventListener('click', () => {
        const title = copyBtn.getAttribute('data-title') || '';
        const score = copyBtn.getAttribute('data-score') || '';
        const reality = copyBtn.getAttribute('data-reality') || '';
        const alt = copyBtn.getAttribute('data-alternative') || '';

        const text = `🧪 [DEBUNKED] ${title}\n🚨 Danger Rating: ${score}/100\n\n🔬 Scientific Reality: ${reality}\n\n✅ Verified Safe Method: ${alt}\n\nFact-checked by IsItKitchenSafe: https://isitkitchensafe.com/tools/viral-trend-debunker/`;

        navigator.clipboard.writeText(text).then(() => {
          showToast();
        });
      });
    });

    function showToast() {
      if (!toast) return;
      toast.classList.remove('translate-y-24', 'opacity-0', 'pointer-events-none');
      toast.classList.add('translate-y-0', 'opacity-100');
      setTimeout(() => {
        toast.classList.add('translate-y-24', 'opacity-0', 'pointer-events-none');
        toast.classList.remove('translate-y-0', 'opacity-100');
      }, 3000);
    }
  }

  setupViralDebunker();
  document.addEventListener('astro:page-load', setupViralDebunker);
</script>
