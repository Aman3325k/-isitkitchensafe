    carrierLabel: "エアロゾルフォグキャリアガス＆インライン雰囲気：",
    carrierHelp: "超高純度窒素マイクロフォグ (<0.02% O2)、窒素・アルゴンハイブリッドカスケード、環境空気ミスト（オゾン生成危険）を選択します。",
    shieldingLabel: "制動放射 (Bremsstrahlung) X線ラビリンス遮蔽：",
    shieldingHelp: "鉛ライニング316Lステンレス製ラビリンス、タングステンポリマー複合バリア、未遮蔽アルミ板（被曝危険）を選択します。",
    voltageLabel: "ピークパルス加速電圧 (V_pulse)：",
    voltageHelp: "カソード加速電圧 (40.0〜95.0 kV)。微霧中の電子初期運動エネルギーと表面侵入深さを決定します。",
    pulseWidthLabel: "パルス幅半値全幅 (t_pulse)：",
    pulseWidthHelp: "ナノ秒パルス幅 (40.0〜200.0 ns)。過度な熱放散を抑えながら瞬間的なピーク電流密度を精密制御します。",
    freqLabel: "パルス繰り返し周波数 (f_rep)：",
    freqHelp: "連続パルス周波数 (1.0〜10.0 kHz)。単位表面積あたりの積算吸収線量を周波数倍で高めます。",
    dwellLabel: "コンベア照射滞留時間 (t_dwell)：",
    dwellHelp: "パルス電子フォグカーテン下の有効通過時間 (0.05〜0.80 秒)。",
    curtainFlowLabel: "不活性窒素カーテン流量 (Q_N2)：",
    curtainFlowHelp: "O2 < 0.05% を維持し微霧液滴を基材表面に高速輸送するための不活性ガスパージ流量 (10〜150 Nm³/h)。",
    presetsTitle: "産業用クイックプリセット：",
    presetPreform: "高速 PET プリフォーム無菌充填ライン (48,000 BPH)",
    presetPowder: "育児用粉乳バルク粉末非加熱芽胞殺菌",
    presetCarton: "無菌カートンウェブ＆ポリエチレンスパウト連続除染",
    presetEgg: "全卵・卵白粉末サルモネラ非加熱低温殺菌",
    presetHazard: "酸素混入オゾン酸化＆制動放射線漏洩ハザード",
    diagnosticTitle: "リアルタイム P-HVEF テレメトリ＆殺菌動力学評価",
    diagnosticSub: "吸収線量、細菌芽胞対数減少値、基材温度上昇、化学薬品残留、放射線遮蔽マージンを連続計算します。",
    doseLabel: "表面吸収線量 (D_abs)：",
    logReductionLabel: "病原菌・芽胞対数減少値 (Log Reduction)：",
    thermalDeltaLabel: "基材表面温度上昇 (ΔT_sub)：",
    chemicalResidueLabel: "液体殺菌剤（過酢酸・過酸化水素）残留：",
    radiationLeakageLabel: "外部漏洩 X 線線量率：",
    salLabel: "無菌保証水準 (SAL)：",
    retentionLabel: "ビタミン・生理活性成分保持率：",
    energyLabel: "比エネルギー消費量：",
    throughputLabel: "連続処理能力：",
    overallStatusLabel: "衛生規格＆放射線防護総合判定：",
    diagramTitle: "大気圧パルス高電圧電子フォグ＆放射線遮蔽システム構造図",
    diagramSub: "冷陰極電子放出部、窒素マイクロフォグ発生機構、搬送ライン、多段ラビリンス鉛遮蔽の模式図。",
    scienceTitle: "P-HVEF 滅菌の科学的基礎と生体物理学的殺菌機構",
    scienceSub: "大気圧電子気動拡散、水和電子 (e_aq⁻) ラジカル連鎖反応、非加熱 DNA 二本鎖切断、制動放射遮蔽設計の詳解。",
    tableTitle: "商用設備仕様および微生物不活性化基準データ"
  }
};

const d = DICT[lang] || DICT.en;
---

<section class="max-w-6xl mx-auto px-4 py-8 text-ink">
  <!-- Top Badge -->
  <div class="mb-4">
    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-cyan-950 text-cyan-200 border border-cyan-800">
      <svg class="w-3.5 h-3.5 text-cyan-400" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 2L1 21h22L12 2zm0 3.99L19.53 19H4.47L12 5.99zM11 16h2v2h-2zm0-6h2v4h-2z"/>
      </svg>
      {d.badge}
    </span>
  </div>

  <!-- Header -->
  <div class="mb-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-ink mb-3">
      {d.title}
    </h1>
    <p class="text-base sm:text-lg text-muted max-w-4xl leading-relaxed">
      {d.subtitle}
    </p>
  </div>

  <!-- Interactive Simulator Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mb-12">
    <!-- Controls Column (5 cols) -->
    <div class="lg:col-span-5 bg-surface-soft border border-hairline rounded-2xl p-6 shadow-xs space-y-6">
      <div>
        <h2 class="text-xl font-bold text-ink mb-1">{d.controlsTitle}</h2>
        <p class="text-xs text-muted leading-relaxed">{d.controlsSub}</p>
      </div>

      <!-- Presets -->
      <div class="space-y-2">
        <label class="text-xs font-semibold uppercase tracking-wider text-muted block">{d.presetsTitle}</label>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <button type="button" id="preset-preform" class="text-left text-xs font-medium p-2.5 rounded-lg border border-hairline bg-surface hover:bg-surface-elevated hover:border-cyan-600 transition-colors">
            🍾 {d.presetPreform}
          </button>
          <button type="button" id="preset-powder" class="text-left text-xs font-medium p-2.5 rounded-lg border border-hairline bg-surface hover:bg-surface-elevated hover:border-cyan-600 transition-colors">
            🥛 {d.presetPowder}
          </button>
          <button type="button" id="preset-carton" class="text-left text-xs font-medium p-2.5 rounded-lg border border-hairline bg-surface hover:bg-surface-elevated hover:border-cyan-600 transition-colors">
            🧃 {d.presetCarton}
          </button>
          <button type="button" id="preset-egg" class="text-left text-xs font-medium p-2.5 rounded-lg border border-hairline bg-surface hover:bg-surface-elevated hover:border-cyan-600 transition-colors">
            🥚 {d.presetEgg}
          </button>
        </div>
        <button type="button" id="preset-hazard" class="w-full text-left text-xs font-medium p-2.5 rounded-lg border border-rose-800/60 bg-rose-950/20 text-rose-300 hover:bg-rose-950/40 transition-colors mt-1">
          ⚠️ {d.presetHazard}
        </button>
      </div>

      <div class="border-t border-hairline/60 pt-4 space-y-4">
        <!-- Architecture Dropdown -->
        <div>
          <label for="system-select" class="block text-xs font-semibold text-ink mb-1">{d.systemLabel}</label>
          <select id="system-select" class="w-full bg-surface border border-hairline rounded-lg px-3 py-2 text-xs text-ink focus:outline-none focus:border-cyan-500">
            {phvefData.systemArchitectures.map(s => (
              <option value={s.id}>{s.name}</option>
            ))}
          </select>
          <p class="text-[11px] text-muted mt-1">{d.systemHelp}</p>
        </div>

        <!-- Target Substrate Dropdown -->
        <div>
          <label for="substrate-select" class="block text-xs font-semibold text-ink mb-1">{d.substrateLabel}</label>
          <select id="substrate-select" class="w-full bg-surface border border-hairline rounded-lg px-3 py-2 text-xs text-ink focus:outline-none focus:border-cyan-500">
            {phvefData.targetSubstrates.map(b => (
              <option value={b.id}>{b.name}</option>
            ))}
          </select>
          <p class="text-[11px] text-muted mt-1">{d.substrateHelp}</p>
        </div>

        <!-- Carrier Gas Dropdown -->
        <div>
          <label for="carrier-select" class="block text-xs font-semibold text-ink mb-1">{d.carrierLabel}</label>
          <select id="carrier-select" class="w-full bg-surface border border-hairline rounded-lg px-3 py-2 text-xs text-ink focus:outline-none focus:border-cyan-500">
            {phvefData.fogMistCarriers.map(f => (
              <option value={f.id}>{f.name}</option>
            ))}
          </select>
          <p class="text-[11px] text-muted mt-1">{d.carrierHelp}</p>
        </div>

        <!-- Shielding Material Dropdown -->
        <div>
          <label for="shielding-select" class="block text-xs font-semibold text-ink mb-1">{d.shieldingLabel}</label>
          <select id="shielding-select" class="w-full bg-surface border border-hairline rounded-lg px-3 py-2 text-xs text-ink focus:outline-none focus:border-cyan-500">
            {phvefData.shieldingMaterials.map(s => (
              <option value={s.id}>{s.name}</option>
            ))}
          </select>
          <p class="text-[11px] text-muted mt-1">{d.shieldingHelp}</p>
        </div>

        <!-- Voltage Slider -->
        <div>
          <div class="flex justify-between items-center mb-1">
            <label for="voltage-slider" class="text-xs font-semibold text-ink">{d.voltageLabel}</label>
            <span id="voltage-val" class="text-xs font-mono font-bold text-cyan-400">75.0 kV</span>
          </div>
          <input type="range" id="voltage-slider" min="40" max="95" step="1" value="75" class="w-full accent-cyan-500 cursor-pointer" />
          <p class="text-[11px] text-muted mt-1">{d.voltageHelp}</p>
        </div>

        <!-- Pulse Width Slider -->
        <div>
          <div class="flex justify-between items-center mb-1">
            <label for="pulse-width-slider" class="text-xs font-semibold text-ink">{d.pulseWidthLabel}</label>
            <span id="pulse-width-val" class="text-xs font-mono font-bold text-cyan-400">80.0 ns</span>
          </div>
          <input type="range" id="pulse-width-slider" min="40" max="200" step="5" value="80" class="w-full accent-cyan-500 cursor-pointer" />
          <p class="text-[11px] text-muted mt-1">{d.pulseWidthHelp}</p>
        </div>

        <!-- Frequency Slider -->
        <div>
          <div class="flex justify-between items-center mb-1">
            <label for="freq-slider" class="text-xs font-semibold text-ink">{d.freqLabel}</label>
            <span id="freq-val" class="text-xs font-mono font-bold text-cyan-400">5.0 kHz</span>
          </div>
          <input type="range" id="freq-slider" min="1" max="10" step="0.5" value="5" class="w-full accent-cyan-500 cursor-pointer" />
          <p class="text-[11px] text-muted mt-1">{d.freqHelp}</p>
        </div>

        <!-- Dwell Time Slider -->
        <div>
          <div class="flex justify-between items-center mb-1">
            <label for="dwell-slider" class="text-xs font-semibold text-ink">{d.dwellLabel}</label>
            <span id="dwell-val" class="text-xs font-mono font-bold text-cyan-400">0.18 s</span>
          </div>
          <input type="range" id="dwell-slider" min="0.05" max="0.80" step="0.01" value="0.18" class="w-full accent-cyan-500 cursor-pointer" />
          <p class="text-[11px] text-muted mt-1">{d.dwellHelp}</p>
        </div>

        <!-- Nitrogen Curtain Flow Slider -->
        <div>
          <div class="flex justify-between items-center mb-1">
            <label for="curtain-slider" class="text-xs font-semibold text-ink">{d.curtainFlowLabel}</label>
            <span id="curtain-val" class="text-xs font-mono font-bold text-cyan-400">65 Nm³/h</span>
          </div>
          <input type="range" id="curtain-slider" min="10" max="150" step="5" value="65" class="w-full accent-cyan-500 cursor-pointer" />
          <p class="text-[11px] text-muted mt-1">{d.curtainFlowHelp}</p>
        </div>
      </div>
    </div>

    <!-- Diagnostic & Visualization Column (7 cols) -->
    <div class="lg:col-span-7 space-y-6">
      <!-- Status & Primary KPIs Banner -->
      <div id="status-card" class="bg-surface-soft border border-hairline rounded-2xl p-6 shadow-xs transition-all">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-muted block mb-1">{d.overallStatusLabel}</span>
            <span id="overall-status-pill" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wide bg-emerald-950 text-emerald-300 border border-emerald-700">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              FDA 21 CFR § 179.26 &amp; 3-A VALIDATED ASEPTIC
            </span>
          </div>
          <div class="text-right">
            <span class="text-xs font-bold uppercase tracking-wider text-muted block mb-1">{d.salLabel}</span>
            <span id="sal-val" class="text-xl font-extrabold font-mono text-cyan-400">&le; 10⁻⁶ SAL</span>
          </div>
        </div>

        <!-- Primary KPI Metrics Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-3 border-t border-hairline/60">
          <div class="bg-surface p-3 rounded-xl border border-hairline">
            <span class="text-[11px] text-muted block truncate">{d.doseLabel}</span>
            <span id="dose-val" class="text-base sm:text-lg font-bold font-mono text-ink">22.5 kGy</span>
          </div>
          <div class="bg-surface p-3 rounded-xl border border-hairline">
            <span class="text-[11px] text-muted block truncate">{d.logReductionLabel}</span>
            <span id="log-red-val" class="text-base sm:text-lg font-bold font-mono text-emerald-400">&gt; 6.4 log</span>
          </div>
          <div class="bg-surface p-3 rounded-xl border border-hairline">
            <span class="text-[11px] text-muted block truncate">{d.thermalDeltaLabel}</span>
            <span id="temp-delta-val" class="text-base sm:text-lg font-bold font-mono text-ink">+2.4 &deg;C</span>
          </div>
          <div class="bg-surface p-3 rounded-xl border border-hairline">
            <span class="text-[11px] text-muted block truncate">{d.radiationLeakageLabel}</span>
            <span id="radiation-leak-val" class="text-base sm:text-lg font-bold font-mono text-emerald-400">0.15 &micro;Sv/h</span>
          </div>
        </div>

        <!-- Secondary Diagnostics Row -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-3 mt-3 border-t border-hairline/60">
          <div>
            <span class="text-[11px] text-muted block">{d.chemicalResidueLabel}</span>
            <span id="chem-residue-val" class="text-xs font-bold font-mono text-emerald-400">0.00 ppm VOCs</span>
          </div>
          <div>
            <span class="text-[11px] text-muted block">{d.retentionLabel}</span>
            <span id="retention-val" class="text-xs font-bold font-mono text-cyan-400">98.8% Retained</span>
          </div>
          <div>
            <span class="text-[11px] text-muted block">{d.energyLabel}</span>
            <span id="energy-val" class="text-xs font-bold font-mono text-ink">0.42 kWh/kU</span>
          </div>
          <div>
            <span class="text-[11px] text-muted block">{d.throughputLabel}</span>
            <span id="throughput-val" class="text-xs font-bold font-mono text-ink">48,000 U/h</span>
          </div>
        </div>
      </div>

      <!-- Interactive Dynamic SVG Diagram -->
      <div class="bg-surface-soft border border-hairline rounded-2xl p-6 shadow-xs">
        <div class="flex items-center justify-between mb-4">
          <div>
            <h2 class="text-sm font-bold text-ink">{d.diagramTitle}</h2>
            <p class="text-xs text-muted">{d.diagramSub}</p>
          </div>
          <span class="text-[11px] font-mono text-cyan-400 bg-cyan-950/80 px-2.5 py-1 rounded border border-cyan-800">
            N2 Micro-Fog &bull; Cold Cathode
          </span>
        </div>

        <div class="w-full overflow-hidden rounded-xl border border-hairline bg-slate-950 p-2">
          <svg viewBox="0 0 760 380" class="w-full h-auto select-none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="beamGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#22d3ee" stop-opacity="0.9" />
                <stop offset="60%" stop-color="#38bdf8" stop-opacity="0.4" />
                <stop offset="100%" stop-color="#818cf8" stop-opacity="0.05" />
              </linearGradient>
              <linearGradient id="fogGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#06b6d4" stop-opacity="0.1" />
                <stop offset="50%" stop-color="#06b6d4" stop-opacity="0.45" />
                <stop offset="100%" stop-color="#06b6d4" stop-opacity="0.1" />
              </linearGradient>
              <linearGradient id="shieldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#334155" />
                <stop offset="100%" stop-color="#0f172a" />
              </linearGradient>
              <pattern id="gridPattern" width="20" height="20" patternUnits="userSpaceOnUse">
                <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#1e293b" stroke-width="0.5" />
              </pattern>
            </defs>

            <!-- Grid Background -->
            <rect width="760" height="380" fill="#020617" />
            <rect width="760" height="380" fill="url(#gridPattern)" />

            <!-- Outer Shielding Enclosure with Labyrinth -->
            <rect x="40" y="30" width="680" height="320" rx="14" fill="url(#shieldGrad)" stroke="#475569" stroke-width="3" stroke-dasharray="8 4" />
            <text x="55" y="55" fill="#94a3b8" font-size="11" font-family="monospace" font-weight="bold">LEAD-LINED SANITARY LABYRINTH ENCLOSURE (3.0 mm Pb eq)</text>

            <!-- Nitrogen Fog Curtain Envelope -->
            <rect x="220" y="100" width="320" height="210" rx="8" fill="url(#fogGrad)" stroke="#0891b2" stroke-width="1.5" stroke-dasharray="4 2" />
            <text x="235" y="125" fill="#67e8f9" font-size="10" font-family="monospace">N2 Micro-Fog Atmosphere (O2 &lt; 0.02% &bull; SMD 1.8 &mu;m)</text>

            <!-- Pulsed Cold-Cathode High-Voltage Emitter Head -->
            <rect x="270" y="70" width="220" height="50" rx="6" fill="#1e293b" stroke="#38bdf8" stroke-width="2" />
            <text x="290" y="93" fill="#e2e8f0" font-size="11" font-weight="bold">PULSED FIELD-EMISSION GUN</text>
            <text x="315" y="110" id="svg-voltage-label" fill="#38bdf8" font-size="10" font-family="monospace">75.0 kV &bull; 80 ns &bull; 5.0 kHz</text>

            <!-- Electron Fog Cloud / Ionizing Rays -->
            <polygon id="svg-electron-beam" points="300,120 460,120 520,270 240,270" fill="url(#beamGrad)" opacity="0.85" />

            <!-- Micro-Fog In-Line Nozzles -->
            <circle cx="240" cy="115" r="5" fill="#22d3ee" />
            <circle cx="520" cy="115" r="5" fill="#22d3ee" />
            <line x1="240" y1="115" x2="270" y2="135" stroke="#22d3ee" stroke-width="1.5" stroke-dasharray="2 2" />
            <line x1="520" y1="115" x2="490" y2="135" stroke="#22d3ee" stroke-width="1.5" stroke-dasharray="2 2" />
            <text x="175" y="118" fill="#22d3ee" font-size="9" font-family="monospace">Fog Nozzle</text>
            <text x="532" y="118" fill="#22d3ee" font-size="9" font-family="monospace">Fog Nozzle</text>

            <!-- Continuous Conveyor Track / Carousel -->
            <rect x="70" y="270" width="620" height="14" rx="4" fill="#334155" stroke="#64748b" stroke-width="1.5" />
            <line x1="70" y1="277" x2="690" y2="277" stroke="#94a3b8" stroke-width="1" stroke-dasharray="10 6" />

            <!-- Conveyor Items (e.g. Bottle Preforms) -->
            <!-- Item 1 (Entering) -->
            <g transform="translate(130, 215)">
              <rect x="0" y="0" width="18" height="50" rx="3" fill="#64748b" stroke="#94a3b8" stroke-width="1" />
              <rect x="3" y="-5" width="12" height="5" fill="#94a3b8" />
              <text x="-12" y="65" fill="#94a3b8" font-size="8" font-family="monospace">Pre-Treatment</text>
            </g>

            <!-- Item 2 (In Micro-Fog) -->
            <g transform="translate(270, 215)">
              <rect x="0" y="0" width="18" height="50" rx="3" fill="#0284c7" stroke="#38bdf8" stroke-width="1.5" />
              <rect x="3" y="-5" width="12" height="5" fill="#38bdf8" />
              <circle cx="9" cy="25" r="14" fill="#38bdf8" opacity="0.35" />
            </g>

            <!-- Item 3 (Under Direct Peak Pulse) -->
            <g transform="translate(370, 215)">
              <rect x="0" y="0" width="18" height="50" rx="3" fill="#0369a1" stroke="#22d3ee" stroke-width="2" />
              <rect x="3" y="-5" width="12" height="5" fill="#67e8f9" />
              <circle cx="9" cy="25" r="18" fill="#22d3ee" opacity="0.45" />
              <text x="-15" y="65" fill="#22d3ee" font-size="8" font-weight="bold" font-family="monospace">>6.4-log Inact.</text>
            </g>

            <!-- Item 4 (Exiting Sterile) -->
            <g transform="translate(470, 215)">
              <rect x="0" y="0" width="18" height="50" rx="3" fill="#047857" stroke="#10b981" stroke-width="1.5" />
              <rect x="3" y="-5" width="12" height="5" fill="#10b981" />
              <circle cx="9" cy="25" r="12" fill="#10b981" opacity="0.25" />
            </g>

            <!-- Item 5 (Aseptic Discharge) -->
            <g transform="translate(600, 215)">
              <rect x="0" y="0" width="18" height="50" rx="3" fill="#065f46" stroke="#34d399" stroke-width="1.5" />
              <rect x="3" y="-5" width="12" height="5" fill="#34d399" />
              <text x="-8" y="65" fill="#34d399" font-size="8" font-family="monospace">Sterile Cold-Fill</text>
            </g>

            <!-- Labyrinth Bremsstrahlung Attenuation Callouts -->
            <g transform="translate(560, 60)">
              <rect x="0" y="0" width="140" height="42" rx="5" fill="#1e293b" stroke="#10b981" stroke-width="1.2" />
              <text x="8" y="16" fill="#10b981" font-size="9" font-weight="bold">Bremsstrahlung Leakage</text>
              <text x="8" y="32" id="svg-leakage-text" fill="#6ee7b7" font-size="11" font-family="monospace">&lt; 0.15 &micro;Sv/h (OSHA OK)</text>
            </g>

            <!-- Animated Flow Arrows -->
            <path d="M 170 295 L 210 295" stroke="#38bdf8" stroke-width="2" marker-end="url(#arrow)" />
            <path d="M 520 295 L 560 295" stroke="#34d399" stroke-width="2" />
          </svg>
        </div>
      </div>
    </div>
  </div>

  <!-- Deep Scientific & Engineering Analysis Section -->
  <div class="mt-12 bg-surface-soft border border-hairline rounded-2xl p-6 sm:p-8 shadow-xs">
    <div class="mb-6">
      <h2 class="text-2xl font-bold text-ink mb-2">{d.scienceTitle}</h2>
      <p class="text-sm text-muted leading-relaxed">{d.scienceSub}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-sm leading-relaxed text-body">
      <div class="space-y-4">
        <h3 class="text-base font-bold text-ink flex items-center gap-2">
          <span class="w-6 h-6 rounded-md bg-cyan-950 text-cyan-400 flex items-center justify-center text-xs font-mono">01</span>
          Atmospheric Pulsed Electron Aerodynamics &amp; Mean Free Path
        </h3>
        <p>
          Conventional high-energy electron beam (e-beam) sterilization systems operate under high vacuum (10⁻⁴ to 10⁻⁶ Pa) and require fragile titanium foil windows (10–15 µm thickness) to extract accelerated electrons into ambient air. These windows are vulnerable to pinhole rupture, thermal foil oxidation, and intense bremsstrahlung scattering. Pulsed High-Voltage Electron Fog (P-HVEF) bypasses vacuum extraction entirely by generating cold-cathode field emission electrons directly at atmospheric pressure within a dense inert micro-mist carrier.
        </p>
        <p>
          At 75 kV acceleration, the electron mean free path in dry air is under 8 cm due to elastic and inelastic collisions with diatomic oxygen and nitrogen molecules. By deploying an aerodynamic clean nitrogen micro-fog envelope (droplet Sauter Mean Diameter SMD 1.2–2.0 µm), low-energy secondary electrons are guided along electrostatic field lines directly to the substrate surface without runaway air ionization, delivering high surface dose rates (>100 kGy/s) in under 200 milliseconds.
        </p>

        <h3 class="text-base font-bold text-ink flex items-center gap-2">
          <span class="w-6 h-6 rounded-md bg-cyan-950 text-cyan-400 flex items-center justify-center text-xs font-mono">02</span>
          Non-Thermal Dual Lethality: DNA Scission &amp; Solvated Electrons (e_aq⁻)
        </h3>
        <p>
          Traditional aseptic chemical sterilizers rely on hot hydrogen peroxide vapor (35% H2O2 at >130°C) or peracetic acid (PAA) rinses, which consume millions of gallons of sterile rinse water and risk toxic chemical carryover into baby food or pure juices. P-HVEF operates via a completely clean, zero-chemical dual biophysical mechanism:
        </p>
        <ul class="list-disc pl-5 space-y-2 text-xs">
          <li><strong>Direct Relativistic &amp; Secondary Electron DNA Rupture:</strong> Accelerated primary and secondary avalanche electrons penetrate bacterial endospores (e.g., <em>Bacillus atrophaeus</em>, <em>Clostridium botulinum</em>), causing lethal double-strand DNA scission and pyrimidine cross-linking at kinetic energy thresholds exceeding molecular covalent bond dissociation energies (C-C ~3.6 eV, P-O ~4.2 eV).</li>
          <li><strong>In-Situ Hydrated Solvated Electrons (e_aq⁻) &amp; Radical Bursts:</strong> The sub-micron nitrogen micro-fog captures stray secondary electrons, producing short-lived hydrated electrons (e_aq⁻) with high reduction potentials (E° = -2.87 V) and transient reactive nitrogen species (RNS: •NO, ONOO⁻). These species instantaneously lyse outer spore coat proteins without leaving persistent chemical residues.</li>
        </ul>
      </div>

      <div class="space-y-4">
        <h3 class="text-base font-bold text-ink flex items-center gap-2">
          <span class="w-6 h-6 rounded-md bg-cyan-950 text-cyan-400 flex items-center justify-center text-xs font-mono">03</span>
          Substrate Thermal Budget &amp; Bottle Preform Geometry
        </h3>
        <p>
          In high-speed aseptic bottling (up to 48,000 bottles/hour), plastic preforms made of polyethylene terephthalate (PET) or 100% recycled PET (rPET) have a low glass transition temperature (Tg ≈ 68–72°C). Exposure to hot chemical vapor (>85°C) causes catastrophic thermal shrinkage of the precision injection-molded neck thread finish, compromising cap torque seal integrity.
        </p>
        <p>
          Because P-HVEF transfers ionizing energy selectively to electronic orbital excitations rather than atomic vibrational modes, the bulk thermal dissipation is microscopic. For a delivered surface dose of 22.5 kGy, the specific heat capacity of PET (Cp ≈ 1.3 kJ/kg·K) yields a substrate temperature rise of:
        </p>
        <div class="p-3 bg-surface rounded-xl border border-hairline font-mono text-xs text-cyan-300">
          &Delta;T = D_abs / C_p = 22.5 kJ/kg / 1.3 kJ/kg&middot;K &approx; +2.4 &deg;C
        </div>
        <p>
          This negligible &Delta;T prevents any neck finish ovalization or thread distortion, allowing immediate cold-aseptic filling at ambient temperatures.
        </p>

        <h3 class="text-base font-bold text-ink flex items-center gap-2">
          <span class="w-6 h-6 rounded-md bg-cyan-950 text-cyan-400 flex items-center justify-center text-xs font-mono">04</span>
          Bremsstrahlung X-Ray Labyrinth Shielding &amp; OSHA Compliance
        </h3>
        <p>
          When electrons decelerate rapidly in matter, a portion of their kinetic energy is converted into continuous bremsstrahlung electromagnetic radiation (X-rays). The fraction of electron energy converted to X-rays scales as &eta; &approx; 1.1 &times; 10⁻⁹ &times; Z &times; V, where Z is the atomic number of the absorbing target and V is acceleration voltage in volts.
        </p>
        <p>
          At 75 kV against low-Z substrates (carbon, nitrogen, hydrogen; Z_avg &approx; 6–7), less than 0.05% of energy generates soft X-rays. A high-Z sanitary labyrinth baffle lined with 3.0 mm lead equivalent (Pb eq) or flexible tungsten-polymer composite attenuates radiation intensity by more than six orders of magnitude (half-value layer HVL for 75 kV X-rays in lead is ~0.15 mm Pb). Outside the equipment enclosure, the stray dose rate remains &lt; 0.15 µSv/h—well below the strict 0.50 µSv/h non-restricted workplace limit enforced by OSHA 29 CFR 1910.1096 and NRC 10 CFR 20.
        </p>
      </div>
    </div>
  </div>

  <!-- Reference Specifications Table -->
  <div class="mt-8 bg-surface-soft border border-hairline rounded-2xl p-6 shadow-xs overflow-x-auto">
    <h2 class="text-lg font-bold text-ink mb-4">{d.tableTitle}</h2>
    <table class="w-full text-xs text-left border-collapse">
      <thead>
        <tr class="border-b border-hairline text-muted uppercase tracking-wider">
          <th class="py-2.5 px-3">System Architecture</th>
          <th class="py-2.5 px-3">Max Voltage</th>
          <th class="py-2.5 px-3">Pulse Width</th>
          <th class="py-2.5 px-3">Nominal Dose</th>
          <th class="py-2.5 px-3">Target Substrate</th>
          <th class="py-2.5 px-3">Log Inact.</th>
          <th class="py-2.5 px-3">Lead Shielding</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-hairline/60">
        {phvefData.systemArchitectures.map(sys => (
          <tr class="hover:bg-surface transition-colors">
            <td class="py-3 px-3 font-medium text-ink">{sys.name}</td>
            <td class="py-3 px-3 font-mono text-cyan-400">{sys.peakPulseVoltageKv} kV</td>
            <td class="py-3 px-3 font-mono">{sys.pulseDurationNs} ns</td>
            <td class="py-3 px-3 font-mono text-ink">{sys.surfaceDoseKGy} kGy</td>
            <td class="py-3 px-3 text-muted">{sys.classification}</td>
            <td class="py-3 px-3 font-mono text-emerald-400">&gt; {sys.typicalLogReduction} log</td>
            <td class="py-3 px-3 text-muted">{sys.shieldingType}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<script is:inline define:vars={{ phvefData }}>
  (function() {
    // DOM Elements
    const systemSelect = document.getElementById('system-select');
    const substrateSelect = document.getElementById('substrate-select');
    const carrierSelect = document.getElementById('carrier-select');
    const shieldingSelect = document.getElementById('shielding-select');

    const voltageSlider = document.getElementById('voltage-slider');
    const pulseWidthSlider = document.getElementById('pulse-width-slider');
    const freqSlider = document.getElementById('freq-slider');
    const dwellSlider = document.getElementById('dwell-slider');
    const curtainSlider = document.getElementById('curtain-slider');

    const voltageVal = document.getElementById('voltage-val');
    const pulseWidthVal = document.getElementById('pulse-width-val');
    const freqVal = document.getElementById('freq-val');
    const dwellVal = document.getElementById('dwell-val');
    const curtainVal = document.getElementById('curtain-val');

    const statusCard = document.getElementById('status-card');
    const statusPill = document.getElementById('overall-status-pill');
    const salVal = document.getElementById('sal-val');
    const doseVal = document.getElementById('dose-val');
    const logRedVal = document.getElementById('log-red-val');
    const tempDeltaVal = document.getElementById('temp-delta-val');
    const radiationLeakVal = document.getElementById('radiation-leak-val');
    const chemResidueVal = document.getElementById('chem-residue-val');
    const retentionVal = document.getElementById('retention-val');
    const energyVal = document.getElementById('energy-val');
    const throughputVal = document.getElementById('throughput-val');

    const svgVoltageLabel = document.getElementById('svg-voltage-label');
    const svgElectronBeam = document.getElementById('svg-electron-beam');
    const svgLeakageText = document.getElementById('svg-leakage-text');

    // Preset buttons
    const presetPreform = document.getElementById('preset-preform');
    const presetPowder = document.getElementById('preset-powder');
    const presetCarton = document.getElementById('preset-carton');
    const presetEgg = document.getElementById('preset-egg');
    const presetHazard = document.getElementById('preset-hazard');

    function calculateModel() {
      if (!systemSelect || !substrateSelect || !carrierSelect || !shieldingSelect) return;

      const currentSys = phvefData.systemArchitectures.find(s => s.id === systemSelect.value) || phvefData.systemArchitectures[0];
      const currentSub = phvefData.targetSubstrates.find(b => b.id === substrateSelect.value) || phvefData.targetSubstrates[0];
      const currentCarrier = phvefData.fogMistCarriers.find(f => f.id === carrierSelect.value) || phvefData.fogMistCarriers[0];
      const currentShielding = phvefData.shieldingMaterials.find(s => s.id === shieldingSelect.value) || phvefData.shieldingMaterials[0];

      const V = parseFloat(voltageSlider.value); // kV
      const t_p = parseFloat(pulseWidthSlider.value); // ns
      const f = parseFloat(freqSlider.value); // kHz
      const t_dwell = parseFloat(dwellSlider.value); // s
      const Q_N2 = parseFloat(curtainSlider.value); // Nm3/h

      // Update slider value displays
      voltageVal.textContent = V.toFixed(1) + ' kV';
      pulseWidthVal.textContent = t_p.toFixed(1) + ' ns';
      freqVal.textContent = f.toFixed(1) + ' kHz';
      dwellVal.textContent = t_dwell.toFixed(2) + ' s';
      curtainVal.textContent = Math.round(Q_N2) + ' Nm³/h';

      if (svgVoltageLabel) {
        svgVoltageLabel.textContent = `${V.toFixed(1)} kV • ${t_p.toFixed(0)} ns • ${f.toFixed(1)} kHz`;
      }

      // Physics Calculation:
      // 1. Absorbed Dose D_abs (kGy):
      // Dose is proportional to V^1.5 * (t_p/100) * (f * 1000) * t_dwell * carrier_enhancement
      // At baseline 75kV, 80ns, 5kHz, 0.18s -> D_abs ~ 22.5 kGy
      const baseDoseFactor = (Math.pow(V / 75.0, 1.45)) * (t_p / 80.0) * (f / 5.0) * (t_dwell / 0.18);
      let carrierMultiplier = 1.0;
      if (currentCarrier.id === 'nitrogen_argon_hybrid_inert_fog') carrierMultiplier = 1.15;
      else if (currentCarrier.id === 'ambient_filtered_air_mist_warning') carrierMultiplier = 0.85;

      const absorbedDose = 22.5 * baseDoseFactor * carrierMultiplier;

      // 2. Pathogen Log Reduction:
      // Inactivation kinetics: Log Reduction = D_abs / D10
      // Non-linear tailing at high dose
      const D10 = currentSub.inactivationD10KGy;
      let logReduction = absorbedDose / D10;
      if (currentCarrier.id === 'ambient_filtered_air_mist_warning') {
        // High ozone adds chemical inactivation but damages quality
        logReduction = Math.min(8.0, logReduction + 0.5);
      } else {
        logReduction = Math.min(7.5, logReduction);
      }

      // 3. Substrate Thermal Rise:
      // Delta T = D_abs / (rho * Cp)
      // For plastics / organic powders, ~ 22.5 kGy -> ~ 2.4 °C
      const deltaT = (absorbedDose * 0.108);

      // 4. Stray Radiation Leakage Rate:
      // Bremsstrahlung generation ~ V^2 * I_peak * shielding_attenuation
      const unshieldedRate = 85.0 * Math.pow(V / 75.0, 2.2);
      let externalRadiationRate = 0.15;
      if (currentShielding.id === 'lead_lined_316l_labyrinth') {
        externalRadiationRate = 0.12 * (V / 75.0);
      } else if (currentShielding.id === 'tungsten_polymer_composite_barrier') {
        externalRadiationRate = 0.18 * (V / 75.0);
      } else {
        // Unshielded aluminum breach
        externalRadiationRate = unshieldedRate;
      }

      // 5. Vitamin & Bioactive Retention (%):
      // If inert: high retention (>97%), if air/ozone: drops severely
      let retentionPct = 99.2 - (absorbedDose * 0.08);
      if (currentCarrier.id === 'ambient_filtered_air_mist_warning') {
        retentionPct = 71.5 - (absorbedDose * 0.25);
      }
      retentionPct = Math.max(50.0, Math.min(99.9, retentionPct));

      // 6. Specific Energy Consumption:
      // P = V * I_peak * t_p * f
      const specificEnergy = (0.35 * (V / 75.0) * (f / 5.0) * (t_p / 80.0));

      // 7. Throughput:
      let throughput = currentSys.throughputUnitsPerHour;
      if (t_dwell > 0.18) {
        throughput = Math.round(currentSys.throughputUnitsPerHour * (0.18 / t_dwell));
      }

      // Update DOM Metrics
      doseVal.textContent = absorbedDose.toFixed(1) + ' kGy';
      logRedVal.textContent = '> ' + logReduction.toFixed(1) + ' log';
      tempDeltaVal.textContent = '+' + deltaT.toFixed(1) + ' °C';
      radiationLeakVal.textContent = externalRadiationRate < 1.0
        ? externalRadiationRate.toFixed(2) + ' µSv/h'
        : externalRadiationRate.toFixed(1) + ' µSv/h';

      if (currentCarrier.id === 'ambient_filtered_air_mist_warning') {
        chemResidueVal.textContent = '> 180 ppm O3 (HAZARD)';
        chemResidueVal.className = 'text-xs font-bold font-mono text-rose-400';
      } else {
        chemResidueVal.textContent = '0.00 ppm VOCs / PAA';
        chemResidueVal.className = 'text-xs font-bold font-mono text-emerald-400';
      }

      retentionVal.textContent = retentionPct.toFixed(1) + '% Retained';
      energyVal.textContent = specificEnergy.toFixed(2) + ' kWh/kU';
      throughputVal.textContent = throughput.toLocaleString() + ' U/h';

      // SAL Level
      if (logReduction >= 6.0) {
        salVal.textContent = '≤ 10⁻⁶ SAL (Aseptic)';
        salVal.className = 'text-xl font-extrabold font-mono text-emerald-400';
      } else if (logReduction >= 4.0) {
        salVal.textContent = '10⁻⁴ (Sub-Aseptic)';
        salVal.className = 'text-xl font-extrabold font-mono text-amber-400';
      } else {
        salVal.textContent = 'INSUFFICIENT LETHALITY';
        salVal.className = 'text-xl font-extrabold font-mono text-rose-400';
      }

      // Overall Compliance Status
      const isRadiationSafe = externalRadiationRate <= 0.50;
      const isAseptic = logReduction >= 6.0;
      const isInert = currentCarrier.id !== 'ambient_filtered_air_mist_warning';
      const isThermalSafe = deltaT <= currentSub.maxPermissibleDeltaTC;

      if (isRadiationSafe && isAseptic && isInert && isThermalSafe) {
        statusPill.innerHTML = '<span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span> FDA 21 CFR § 179.26 & 3-A VALIDATED ASEPTIC';
        statusPill.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wide bg-emerald-950 text-emerald-300 border border-emerald-700';
        statusCard.className = 'bg-surface-soft border border-emerald-800/40 rounded-2xl p-6 shadow-xs transition-all';
      } else if (!isRadiationSafe) {
        statusPill.innerHTML = '<span class="w-2 h-2 rounded-full bg-rose-500 animate-ping"></span> OSHA RADIATION LEAKAGE HAZARD (>0.5 µSv/h)';
        statusPill.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wide bg-rose-950 text-rose-300 border border-rose-700';
        statusCard.className = 'bg-surface-soft border border-rose-800/60 rounded-2xl p-6 shadow-xs transition-all';
      } else if (!isInert) {
        statusPill.innerHTML = '<span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span> OXYGEN INGRESS OZONE RANCIDITY HAZARD';
        statusPill.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wide bg-amber-950 text-amber-300 border border-amber-700';
        statusCard.className = 'bg-surface-soft border border-amber-800/60 rounded-2xl p-6 shadow-xs transition-all';
      } else {
        statusPill.innerHTML = '<span class="w-2 h-2 rounded-full bg-amber-400"></span> SUB-ASEPTIC PARAMETERS (LOG < 6.0)';
        statusPill.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wide bg-amber-950 text-amber-300 border border-amber-700';
        statusCard.className = 'bg-surface-soft border border-amber-800/40 rounded-2xl p-6 shadow-xs transition-all';
      }

      // SVG Updates
      if (svgLeakageText) {
        if (isRadiationSafe) {
          svgLeakageText.textContent = `< ${externalRadiationRate.toFixed(2)} µSv/h (OSHA OK)`;
          svgLeakageText.setAttribute('fill', '#6ee7b7');
        } else {
          svgLeakageText.textContent = `🚨 ${externalRadiationRate.toFixed(1)} µSv/h (LEAK!)`;
          svgLeakageText.setAttribute('fill', '#f87171');
        }
      }

      if (svgElectronBeam) {
        const opacity = Math.min(0.95, 0.4 + (absorbedDose / 40.0));
        svgElectronBeam.setAttribute('opacity', opacity.toString());
      }
    }

    // Attach Event Listeners
    [systemSelect, substrateSelect, carrierSelect, shieldingSelect].forEach(el => {
      if (el) el.addEventListener('change', calculateModel);
    });

    [voltageSlider, pulseWidthSlider, freqSlider, dwellSlider, curtainSlider].forEach(slider => {
      if (slider) slider.addEventListener('input', calculateModel);
    });

    // Preset Handlers
    if (presetPreform) {
      presetPreform.addEventListener('click', () => {
        systemSelect.value = 'commercial_continuous_rotary_phvef_preform_sterilizer';
        substrateSelect.value = 'pet_rpet_bottle_preforms';
        carrierSelect.value = 'pure_nitrogen_ultrafine_mist';
        shieldingSelect.value = 'lead_lined_316l_labyrinth';
        voltageSlider.value = '75';
        pulseWidthSlider.value = '80';
        freqSlider.value = '5.0';
        dwellSlider.value = '0.18';
        curtainSlider.value = '65';
        calculateModel();
      });
    }

    if (presetPowder) {
      presetPowder.addEventListener('click', () => {
        systemSelect.value = 'industrial_continuous_fluidized_bulk_powder_phvef_tunnel';
        substrateSelect.value = 'dry_infant_formula_milk_powder';
        carrierSelect.value = 'pure_nitrogen_ultrafine_mist';
        shieldingSelect.value = 'lead_lined_316l_labyrinth';
        voltageSlider.value = '90';
        pulseWidthSlider.value = '120';
        freqSlider.value = '8.0';
        dwellSlider.value = '0.35';
        curtainSlider.value = '85';
        calculateModel();
      });
    }

    if (presetCarton) {
      presetCarton.addEventListener('click', () => {
        systemSelect.value = 'continuous_aseptic_carton_web_spout_phvef_applicator';
        substrateSelect.value = 'aseptic_carton_multi_laminate_web';
        carrierSelect.value = 'nitrogen_argon_hybrid_inert_fog';
        shieldingSelect.value = 'tungsten_polymer_composite_barrier';
        voltageSlider.value = '60';
        pulseWidthSlider.value = '65';
        freqSlider.value = '4.0';
        dwellSlider.value = '0.12';
        curtainSlider.value = '50';
        calculateModel();
      });
    }

    if (presetEgg) {
      presetEgg.addEventListener('click', () => {
        systemSelect.value = 'industrial_continuous_fluidized_bulk_powder_phvef_tunnel';
        substrateSelect.value = 'whole_egg_powder_albumen';
        carrierSelect.value = 'pure_nitrogen_ultrafine_mist';
        shieldingSelect.value = 'lead_lined_316l_labyrinth';
        voltageSlider.value = '70';
        pulseWidthSlider.value = '90';
        freqSlider.value = '4.5';
        dwellSlider.value = '0.22';
        curtainSlider.value = '70';
        calculateModel();
      });
    }

    if (presetHazard) {
      presetHazard.addEventListener('click', () => {
        systemSelect.value = 'modular_pilot_phvef_research_decontamination_skid';
        substrateSelect.value = 'pet_rpet_bottle_preforms';
        carrierSelect.value = 'ambient_filtered_air_mist_warning';
        shieldingSelect.value = 'unshielded_aluminum_hazard';
        voltageSlider.value = '95';
        pulseWidthSlider.value = '150';
        freqSlider.value = '7.5';
        dwellSlider.value = '0.45';
        curtainSlider.value = '20';
        calculateModel();
      });
    }

    // Initial Run
    calculateModel();
  })();
</script>
