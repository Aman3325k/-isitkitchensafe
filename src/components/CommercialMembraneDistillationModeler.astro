      ptfe_expanded: { angle: 138, lepClean: 3.2, mult: 1.15 },
      pvdf_electrospun: { angle: 124, lepClean: 2.5, mult: 1.05 },
      pp_microporous: { angle: 115, lepClean: 1.8, mult: 0.90 },
      ceramic_silylated: { angle: 145, lepClean: 4.8, mult: 1.25 }
    };

    // DOM Elements
    const systemSelect = document.getElementById('md-system-select');
    const matrixSelect = document.getElementById('md-matrix-select');
    const materialSelect = document.getElementById('md-material-select');
    const feedTempSlider = document.getElementById('md-feed-temp-slider');
    const coolTempSlider = document.getElementById('md-cool-temp-slider');
    const velocitySlider = document.getElementById('md-velocity-slider');
    const brixSlider = document.getElementById('md-brix-slider');

    const feedTempDisplay = document.getElementById('md-feed-temp-val');
    const coolTempDisplay = document.getElementById('md-cool-temp-val');
    const velocityDisplay = document.getElementById('md-velocity-val');
    const brixDisplay = document.getElementById('md-brix-val');
    const systemDesc = document.getElementById('md-system-desc');
    const matrixDesc = document.getElementById('md-matrix-desc');

    // Outputs
    const outFlux = document.getElementById('md-out-flux');
    const outThroughput = document.getElementById('md-out-throughput');
    const outTpc = document.getElementById('md-out-tpc');
    const outEffDt = document.getElementById('md-out-eff-dt');
    const outCpc = document.getElementById('md-out-cpc');
    const outViscosity = document.getElementById('md-out-viscosity');
    const outWettingText = document.getElementById('md-out-wetting-text');
    const outWettingBar = document.getElementById('md-wetting-bar');
    const outRetention = document.getElementById('md-out-retention');
    const outVolatileNote = document.getElementById('md-out-volatile-note');
    const statusBadge = document.getElementById('md-status-badge');
    const outLimitation = document.getElementById('md-out-limitation');
    const outAction = document.getElementById('md-out-action');

    function calculateSaturationPressure(tempC) {
      // Antoine equation for water saturation pressure in kPa
      // ln(P_sat) = 23.1964 - 3816.44 / (T_K - 46.13)
      const T_K = tempC + 273.15;
      return Math.exp(23.1964 - (3816.44 / (T_K - 46.13)));
    }

    function recalculate() {
      const sysKey = systemSelect?.value || 'pilot_dcmd_hollow_fiber_ptfe';
      const matKey = matrixSelect?.value || 'cold_pressed_orange_juice';
      const polyKey = materialSelect?.value || 'ptfe_expanded';

      const sys = systems[sysKey] || systems.pilot_dcmd_hollow_fiber_ptfe;
      const mat = matrices[matKey] || matrices.cold_pressed_orange_juice;
      const poly = materials[polyKey] || materials.ptfe_expanded;

      const Tf = parseFloat(feedTempSlider?.value || '55');
      const Tp = parseFloat(coolTempSlider?.value || '20');
      const velocity = parseFloat(velocitySlider?.value || '0.65');
      const targetBrix = parseFloat(brixSlider?.value || '55');

      // Update Slider value displays
      if (feedTempDisplay) feedTempDisplay.textContent = `${Tf.toFixed(0)} °C`;
      if (coolTempDisplay) coolTempDisplay.textContent = `${Tp.toFixed(0)} °C`;
      if (velocityDisplay) velocityDisplay.textContent = `${velocity.toFixed(2)} m/s`;
      if (brixDisplay) brixDisplay.textContent = `${targetBrix.toFixed(1)} °Brix`;

      if (systemDesc) systemDesc.textContent = sys.desc;
      if (matrixDesc) matrixDesc.textContent = mat.desc;

      // 1. Water activity coefficient aw as a function of Brix (Norrish equation approximation)
      // aw drops as soluble sugars increase
      const sucroseMassFraction = targetBrix / 100.0;
      const aw = Math.max(0.68, 1.0 - (0.28 * sucroseMassFraction) - (0.35 * Math.pow(sucroseMassFraction, 2)));

      // 2. Temperature Polarization Coefficient (TPC)
      // Higher crossflow velocity improves Reynolds number and heat transfer, raising TPC toward 0.85
      let tpc = 0.52 + (0.24 * Math.min(1.0, velocity / 1.0));
      if (sys.type === 'VMD') tpc += 0.06; // VMD has lower conductive loss
      if (sys.type === 'AGMD') tpc -= 0.05; // Air gap adds conduction resistance
      if (sys.compromised) tpc = 0.35;
      tpc = Math.min(0.88, Math.max(0.30, tpc));

      const deltaTBulk = Math.max(5, Tf - Tp);
      const deltaTMembrane = deltaTBulk * tpc;

      const Tf_membrane = Tp + deltaTMembrane;
      const Tp_membrane = Tp;

      // 3. Vapor Pressure Calculations
      const Psat_feed = calculateSaturationPressure(Tf_membrane) * aw;
      const Psat_cool = calculateSaturationPressure(Tp_membrane);
      const deltaP_kPa = Math.max(0.5, Psat_feed - Psat_cool);

      // 4. Trans-Membrane Vapor Flux (kg/m²·h)
      let cMd = sys.baseCmd * poly.mult;
      if (sys.type === 'VMD') cMd *= 1.35; // Vacuum eliminates air diffusion resistance
      if (sys.compromised) cMd *= 0.40;

      // Concentration factor & dynamic viscosity penalty
      const concentrationFactor = targetBrix / mat.initialBrix;
      const dynamicViscosity = mat.initialViscosity * Math.exp(0.045 * targetBrix);

      // Viscosity resistance boundary layer attenuation
      const viscosityPenalty = 1.0 / (1.0 + (0.015 * Math.max(0, dynamicViscosity - 5)));
      let flux = cMd * deltaP_kPa * 10.0 * viscosityPenalty * mat.foulingResistance;
      if (flux < 1.0) flux = 1.0;

      // Total hourly throughput (L/h = kg/h)
      const hourlyThroughput = flux * sys.area;

      // 5. Concentration Polarization Coefficient (CPC = Cm / Cb)
      // High flux and low velocity drive solute accumulation at membrane interface
      const massTransferK = 0.00015 * Math.pow(velocity, 0.75);
      const fluxMPerSec = (flux / 1000.0) / 3600.0;
      let cpc = Math.exp(Math.min(0.8, fluxMPerSec / (massTransferK + 1e-6)));
      if (cpc < 1.02) cpc = 1.02;
      if (cpc > 2.2) cpc = 2.2;

      // 6. Liquid Entry Pressure of Water (LEP) & Wetting Safety Margin
      // Clean LEP modified by actual liquid surface tension (72 mN/m pure water reference)
      const effectiveSurfaceTensionRatio = mat.surfaceTension / 72.8;
      let effectiveLep = poly.lepClean * effectiveSurfaceTensionRatio;
      if (sys.compromised) effectiveLep = 0.45;

      // Hydraulic pressure in module channel
      const hydraulicP_bar = 0.25 + (0.35 * Math.pow(velocity, 1.6)) + (0.01 * (dynamicViscosity / 10.0));
      const wettingRatio = hydraulicP_bar / (effectiveLep + 1e-5);
      const wettingMarginPercent = Math.max(0, Math.min(100, (1.0 - wettingRatio) * 100));

      // 7. Aroma Volatiles & Vitamin C Retention
      // Lower temperatures and shorter residence preserve thermolabile compounds
      let thermalStressScore = Math.max(0, (Tf - 40) * 0.85);
      if (sys.type === 'VMD') thermalStressScore += 5; // Light volatile stripping in vacuum
      let retention = 99.2 - thermalStressScore - (targetBrix > mat.criticalPectinBrix ? 4.5 : 0);
      if (sys.compromised) retention -= 25.0;
      retention = Math.max(50.0, Math.min(98.8, retention));

      // Update Telemetry Elements
      if (outFlux) outFlux.textContent = `${flux.toFixed(1)} kg/m²·h`;
      if (outThroughput) outThroughput.textContent = `${hourlyThroughput.toFixed(1)} L/h`;
      if (outTpc) outTpc.textContent = tpc.toFixed(2);
      if (outEffDt) outEffDt.textContent = `${deltaTMembrane.toFixed(1)}°C`;
      if (outCpc) outCpc.textContent = cpc.toFixed(2);
      if (outViscosity) outViscosity.textContent = `${dynamicViscosity.toFixed(1)} cP`;
      if (outRetention) outRetention.textContent = `${retention.toFixed(1)}%`;

      if (outVolatileNote) {
        const esterEst = Math.max(60, retention - 3.2).toFixed(0);
        const vitEst = Math.min(99, retention + 2.1).toFixed(0);
        outVolatileNote.textContent = `Esters: ${esterEst}% | Vit C: ${vitEst}%`;
      }

      // Update Wetting Bar & Text
      if (outWettingBar && outWettingText) {
        const barWidth = Math.min(100, Math.max(5, wettingRatio * 100));
        outWettingBar.style.width = `${barWidth}%`;

        if (wettingRatio >= 0.90 || sys.compromised) {
          outWettingBar.className = 'bg-rose-600 h-2 rounded-full transition-all duration-300';
          outWettingText.textContent = `CRITICAL BREAKTHROUGH RISK (ΔP ${hydraulicP_bar.toFixed(2)} / LEP ${effectiveLep.toFixed(2)} bar)`;
          outWettingText.className = 'text-xs font-mono font-bold text-rose-600 dark:text-rose-400';
        } else if (wettingRatio >= 0.65) {
          outWettingBar.className = 'bg-amber-500 h-2 rounded-full transition-all duration-300';
          outWettingText.textContent = `MODERATE RISK (${wettingMarginPercent.toFixed(0)}% Margin - Watch Surfactants)`;
          outWettingText.className = 'text-xs font-mono font-bold text-amber-600 dark:text-amber-400';
        } else {
          outWettingBar.className = 'bg-emerald-500 h-2 rounded-full transition-all duration-300';
          outWettingText.textContent = `${wettingMarginPercent.toFixed(0)}% SAFE (ΔP ${hydraulicP_bar.toFixed(2)} / LEP ${effectiveLep.toFixed(2)} bar)`;
          outWettingText.className = 'text-xs font-mono font-bold text-emerald-600 dark:text-emerald-400';
        }
      }

      // Operational Status Badge & Limitations
      if (statusBadge && outLimitation && outAction) {
        if (sys.compromised || wettingRatio >= 0.95) {
          statusBadge.textContent = 'CRITICAL PORE WETTING';
          statusBadge.className = 'inline-flex px-2.5 py-1 rounded-md text-[10px] font-bold uppercase tracking-wider bg-rose-100 text-rose-800 dark:bg-rose-950 dark:text-rose-300';
          outLimitation.textContent = 'Membrane pore wetting failure: hydraulic trans-membrane pressure exceeds Cantor-Laplace LEP limit, flooding raw concentrate into pure distillate.';
          outAction.textContent = 'Emergency halt: isolate module. Replace compromised membrane elements and verify liquid surface tension above 45 mN/m before restart.';
        } else if (targetBrix >= mat.criticalPectinBrix) {
          statusBadge.textContent = 'GEL LAYER FOULING';
          statusBadge.className = 'inline-flex px-2.5 py-1 rounded-md text-[10px] font-bold uppercase tracking-wider bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300';
          outLimitation.textContent = `Concentrate viscosity exceeds ${dynamicViscosity.toFixed(0)} cP at ${targetBrix}°Brix, inducing severe concentration polarization and boundary gelation.`;
          outAction.textContent = 'Increase cross-flow velocity to > 1.0 m/s or perform periodic forward flush. Target intermediate concentration (< 60 °Brix) before secondary polishing.';
        } else if (Tf > 65) {
          statusBadge.textContent = 'THERMAL STRESS WARNING';
          statusBadge.className = 'inline-flex px-2.5 py-1 rounded-md text-[10px] font-bold uppercase tracking-wider bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300';
          outLimitation.textContent = 'Feed inlet temperature Tf > 65°C causes accelerated degradation of heat-labile polyphenols, anthocyanins, and native protein denaturation.';
          outAction.textContent = 'Reduce Tf to 50–55°C. Utilize Vacuum Membrane Distillation (VMD) to sustain high trans-membrane vapor flux at reduced thermal impact.';
        } else {
          statusBadge.textContent = 'OPTIMAL SANITARY (3-A 45-03)';
          statusBadge.className = 'inline-flex px-2.5 py-1 rounded-md text-[10px] font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300';
          outLimitation.textContent = 'Mild boundary layer thermal polarization (TPC ~0.70-0.80); flow hydrodynamic shear effectively suppresses particulate concentration polarization.';
          outAction.textContent = 'Normal continuous operation. Execute standard 3-A enzymatic and mild caustic clean-in-place (CIP) cycle every 8 hours.';
        }
      }
    }

    // Attach Event Listeners
    [systemSelect, matrixSelect, materialSelect, feedTempSlider, coolTempSlider, velocitySlider, brixSlider].forEach(el => {
      el?.addEventListener('input', recalculate);
      el?.addEventListener('change', recalculate);
    });

    // Preset Buttons
    document.querySelectorAll('.md-preset-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget;
        const preset = target?.getAttribute('data-preset');

        if (preset === 'citrus') {
          if (systemSelect) systemSelect.value = 'commercial_vmd_spiral_pvdf_skid';
          if (matrixSelect) matrixSelect.value = 'cold_pressed_orange_juice';
          if (materialSelect) materialSelect.value = 'ptfe_expanded';
          if (feedTempSlider) feedTempSlider.value = '55';
          if (coolTempSlider) coolTempSlider.value = '18';
          if (velocitySlider) velocitySlider.value = '0.85';
          if (brixSlider) brixSlider.value = '62';
        } else if (preset === 'berry') {
          if (systemSelect) systemSelect.value = 'commercial_vmd_spiral_pvdf_skid';
          if (matrixSelect) matrixSelect.value = 'wild_blueberry_anthocyanin_extract';
          if (materialSelect) materialSelect.value = 'pvdf_electrospun';
          if (feedTempSlider) feedTempSlider.value = '48';
          if (coolTempSlider) coolTempSlider.value = '15';
          if (velocitySlider) velocitySlider.value = '0.70';
          if (brixSlider) brixSlider.value = '45';
        } else if (preset === 'apple') {
          if (systemSelect) systemSelect.value = 'industrial_agmd_flat_sheet_cascade';
          if (matrixSelect) matrixSelect.value = 'clarified_apple_cider_concentrate';
          if (materialSelect) materialSelect.value = 'ceramic_silylated';
          if (feedTempSlider) feedTempSlider.value = '52';
          if (coolTempSlider) coolTempSlider.value = '20';
          if (velocitySlider) velocitySlider.value = '0.90';
          if (brixSlider) brixSlider.value = '65';
        } else if (preset === 'whey') {
          if (systemSelect) systemSelect.value = 'pilot_dcmd_hollow_fiber_ptfe';
          if (matrixSelect) matrixSelect.value = 'cheese_whey_protein_concentrate';
          if (materialSelect) materialSelect.value = 'ptfe_expanded';
          if (feedTempSlider) feedTempSlider.value = '42';
          if (coolTempSlider) coolTempSlider.value = '15';
          if (velocitySlider) velocitySlider.value = '0.60';
          if (brixSlider) brixSlider.value = '35';
        } else if (preset === 'wetting') {
          if (systemSelect) systemSelect.value = 'compromised_wetted_membrane_unit';
          if (matrixSelect) matrixSelect.value = 'fermented_botanical_infusion';
          if (materialSelect) materialSelect.value = 'pp_microporous';
          if (feedTempSlider) feedTempSlider.value = '68';
          if (coolTempSlider) coolTempSlider.value = '25';
          if (velocitySlider) velocitySlider.value = '1.40';
          if (brixSlider) brixSlider.value = '38';
        }

        recalculate();
      });
    });

    // Initial Execution
    recalculate();
  });
</script>
