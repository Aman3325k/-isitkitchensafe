  function initSfeModeler() {
    const colSelect = document.getElementById('sfe-column-select') as HTMLSelectElement | null;
    const feedSelect = document.getElementById('sfe-feedstock-select') as HTMLSelectElement | null;

    const pressureSlider = document.getElementById('sfe-pressure-slider') as HTMLInputElement | null;
    const tempSlider = document.getElementById('sfe-temp-slider') as HTMLInputElement | null;
    const sfSlider = document.getElementById('sfe-sf-slider') as HTMLInputElement | null;
    const refluxSlider = document.getElementById('sfe-reflux-slider') as HTMLInputElement | null;
    const feedSlider = document.getElementById('sfe-feed-slider') as HTMLInputElement | null;

    const pressureVal = document.getElementById('sfe-pressure-val');
    const tempVal = document.getElementById('sfe-temp-val');
    const sfVal = document.getElementById('sfe-sf-val');
    const refluxVal = document.getElementById('sfe-reflux-val');
    const feedVal = document.getElementById('sfe-feed-val');

    const outDensity = document.getElementById('sfe-out-density');
    const outSelectivity = document.getElementById('sfe-out-selectivity');
    const outStripping = document.getElementById('sfe-out-stripping');
    const outFold = document.getElementById('sfe-out-fold');
    const outAroma = document.getElementById('sfe-out-aroma');
    const outFlooding = document.getElementById('sfe-out-flooding');
    const outThermal = document.getElementById('sfe-out-thermal');
    const outAsme = document.getElementById('sfe-out-asme');

    const statusPill = document.getElementById('sfe-status-pill');
    const activeFeedName = document.getElementById('sfe-active-feed-name');
    const activeDesc = document.getElementById('sfe-active-desc');

    if (!pressureSlider || !tempSlider || !sfSlider || !refluxSlider || !feedSlider) return;

    function recalculate() {
      const pCol = parseFloat(pressureSlider?.value || '92');
      const tCol = parseFloat(tempSlider?.value || '48.0');
      const sfRatio = parseFloat(sfSlider?.value || '35.0');
      const rReflux = parseFloat(refluxSlider?.value || '1.2');
      const qFeed = parseFloat(feedSlider?.value || '12.0');
      const feedKey = feedSelect?.value || 'valencia_orange_peel_oil';
      const feedInfo = FEEDSTOCK_MAP[feedKey] || FEEDSTOCK_MAP['valencia_orange_peel_oil'];

      // Update text displays
      if (pressureVal) pressureVal.textContent = `${Math.round(pCol)} bar`;
      if (tempVal) tempVal.textContent = `${tCol.toFixed(1)} °C`;
      if (sfVal) sfVal.textContent = `${sfRatio.toFixed(1)} kg/kg`;
      if (refluxVal) refluxVal.textContent = rReflux.toFixed(2);
      if (feedVal) feedVal.textContent = `${qFeed.toFixed(1)} kg/h`;

      if (activeFeedName) activeFeedName.textContent = feedInfo.name;
      if (activeDesc) activeDesc.textContent = feedInfo.notes;

      // 1. Empirical Supercritical CO2 Density via Span-Wagner modified EOS:
      // Critical constants for CO2: Pc = 73.8 bar, Tc = 31.05 °C (304.2 K)
      const tKelvin = tCol + 273.15;
      const reducedP = pCol / 73.8;
      const reducedT = tKelvin / 304.2;
      
      // Approximation for CO2 density in kg/m³
      let rhoCo2 = 468.0 * Math.pow(reducedP, 0.65) / Math.pow(reducedT, 1.85);
      if (pCol < 80) rhoCo2 = Math.max(180, rhoCo2 * 0.85);
      if (pCol > 160) rhoCo2 = Math.min(880, rhoCo2 * 1.15);

      // 2. Terpene / Oxygenated Separation Selectivity Factor (alpha)
      // High selectivity occurs at lower densities (320-420 kg/m³)
      // At higher densities, selectivity drops because CO2 dissolves everything non-selectively
      let selectivityAlpha = 4.8 - 0.0055 * Math.max(0, rhoCo2 - 280);
      selectivityAlpha = Math.max(1.15, Math.min(6.2, selectivityAlpha));

      // 3. Monoterpene Stripping Efficiency (%)
      // Driven by S/F ratio and column NTU stages boosted by reflux
      const effectiveStages = 8.5 * (1.0 + 0.35 * rReflux);
      const strippingFactor = (sfRatio / 30.0) * (selectivityAlpha / 3.0);
      let strippingPercent = 100.0 * (1.0 - Math.exp(-0.85 * strippingFactor));
      strippingPercent = Math.min(99.6, Math.max(45.0, strippingPercent));

      // 4. Fold Concentration Factor (X-Fold)
      // Fold = 1 / (1 - (terpeneContent * strippingPercent / 100))
      const terpeneFraction = feedInfo.monoterpeneContentPercent / 100.0;
      const massExtractedFraction = terpeneFraction * (strippingPercent / 100.0);
      let foldLevel = 1.0 / Math.max(0.04, 1.0 - massExtractedFraction);
      foldLevel = Math.min(22.0, foldLevel);

      // 5. Oxygenated Aroma Recovery (%)
      // High reflux protects oxygenated compounds from escaping overhead
      // But excessive S/F can strip some light aldehydes
      let aromaLossRate = (sfRatio / 120.0) / (1.0 + 1.2 * rReflux);
      let aromaRecoveryPercent = (1.0 - aromaLossRate) * 100.0;
      aromaRecoveryPercent = Math.min(99.4, Math.max(78.0, aromaRecoveryPercent));

      // 6. Column Hydraulic Flooding Margin (%)
      // High gas density or high liquid feed rate increases flooding risk
      const gasVelocityFactor = (sfRatio * qFeed) / 350.0;
      const densityFloodingFactor = rhoCo2 / 500.0;
      let floodingPercent = 25.0 * gasVelocityFactor * Math.pow(densityFloodingFactor, 1.2);
      floodingPercent = Math.min(100.0, Math.max(12.0, floodingPercent));

      // 7. Thermal Degradation Index (%)
      // Strictly 0.0% if T_col < sensitivity threshold, minor if T_col elevated
      let thermalDegradation = 0.0;
      if (tCol > feedInfo.thermalSensitivityThresholdC) {
        thermalDegradation = (tCol - feedInfo.thermalSensitivityThresholdC) * 0.45;
      }

      // 8. ASME Overpressure Safety Margin
      const maxDesignPressure = 250.0;
      const asmeMargin = maxDesignPressure - pCol;

      // Update Output Displays
      if (outDensity) outDensity.textContent = `${Math.round(rhoCo2)} kg/m³`;
      if (outSelectivity) outSelectivity.textContent = `${selectivityAlpha.toFixed(2)} α`;
      if (outStripping) outStripping.textContent = `${strippingPercent.toFixed(1)}%`;
      if (outFold) outFold.textContent = `${foldLevel.toFixed(1)}-Fold`;
      if (outAroma) outAroma.textContent = `${aromaRecoveryPercent.toFixed(1)}%`;
      if (outFlooding) {
        outFlooding.textContent = `${floodingPercent.toFixed(1)}%`;
        outFlooding.className = floodingPercent > 80 
          ? "text-xl sm:text-2xl font-bold font-mono text-rose-500" 
          : "text-xl sm:text-2xl font-bold font-mono text-ink";
      }
      if (outThermal) {
        outThermal.textContent = `${thermalDegradation.toFixed(1)}%`;
        outThermal.className = thermalDegradation > 2.0 
          ? "text-xl sm:text-2xl font-bold font-mono text-amber-500" 
          : "text-xl sm:text-2xl font-bold font-mono text-emerald-500";
      }
      if (outAsme) {
        outAsme.textContent = `+${Math.round(asmeMargin)} bar`;
        outAsme.className = asmeMargin < 40 
          ? "text-xl sm:text-2xl font-bold font-mono text-amber-500" 
          : "text-xl sm:text-2xl font-bold font-mono text-emerald-500";
      }

      // Status Pill State
      if (statusPill) {
        if (floodingPercent >= 80) {
          statusPill.textContent = "COLUMN FLOODING HAZARD";
          statusPill.className = "px-3 py-1 rounded-full text-xs font-bold font-mono bg-rose-950 text-rose-300 border border-rose-800 animate-pulse";
        } else if (asmeMargin < 35) {
          statusPill.textContent = "HIGH PRESSURE WARNING";
          statusPill.className = "px-3 py-1 rounded-full text-xs font-bold font-mono bg-amber-950 text-amber-300 border border-amber-800";
        } else if (thermalDegradation > 2.0) {
          statusPill.textContent = "THERMAL OFF-FLAVOR RISK";
          statusPill.className = "px-3 py-1 rounded-full text-xs font-bold font-mono bg-amber-950 text-amber-300 border border-amber-800";
        } else {
          statusPill.textContent = "OPTIMAL EXTRACTION";
          statusPill.className = "px-3 py-1 rounded-full text-xs font-bold font-mono bg-emerald-950 text-emerald-300 border border-emerald-800";
        }
      }
    }

    // Attach Event Listeners
    [pressureSlider, tempSlider, sfSlider, refluxSlider, feedSlider].forEach(slider => {
      slider.addEventListener('input', recalculate);
    });

    colSelect?.addEventListener('change', recalculate);
    feedSelect?.addEventListener('change', recalculate);

    // Attach Preset Buttons
    document.getElementById('sfe-preset-orange')?.addEventListener('click', () => {
      if (pressureSlider) pressureSlider.value = '92';
      if (tempSlider) tempSlider.value = '48.0';
      if (sfSlider) sfSlider.value = '35';
      if (refluxSlider) refluxSlider.value = '1.2';
      if (feedSlider) feedSlider.value = '12.0';
      if (feedSelect) feedSelect.value = 'valencia_orange_peel_oil';
      recalculate();
    });

    document.getElementById('sfe-preset-lemon')?.addEventListener('click', () => {
      if (pressureSlider) pressureSlider.value = '88';
      if (tempSlider) tempSlider.value = '44.0';
      if (sfSlider) sfSlider.value = '28';
      if (refluxSlider) refluxSlider.value = '1.5';
      if (feedSlider) feedSlider.value = '8.0';
      if (feedSelect) feedSelect.value = 'sicilian_lemon_essence_oil';
      recalculate();
    });

    document.getElementById('sfe-preset-bergamot')?.addEventListener('click', () => {
      if (pressureSlider) pressureSlider.value = '105';
      if (tempSlider) tempSlider.value = '50.0';
      if (sfSlider) sfSlider.value = '45';
      if (refluxSlider) refluxSlider.value = '2.0';
      if (feedSlider) feedSlider.value = '10.0';
      if (feedSelect) feedSelect.value = 'calabrian_bergamot_peel_oil';
      recalculate();
    });

    document.getElementById('sfe-preset-hop')?.addEventListener('click', () => {
      if (pressureSlider) pressureSlider.value = '110';
      if (tempSlider) tempSlider.value = '42.0';
      if (sfSlider) sfSlider.value = '40';
      if (refluxSlider) refluxSlider.value = '0.8';
      if (feedSlider) feedSlider.value = '15.0';
      if (feedSelect) feedSelect.value = 'supercritical_raw_hop_extract';
      recalculate();
    });

    document.getElementById('sfe-preset-hazard')?.addEventListener('click', () => {
      if (pressureSlider) pressureSlider.value = '165';
      if (tempSlider) tempSlider.value = '36.0';
      if (sfSlider) sfSlider.value = '55';
      if (refluxSlider) refluxSlider.value = '3.5';
      if (feedSlider) feedSlider.value = '25.0';
      if (feedSelect) feedSelect.value = 'valencia_orange_peel_oil';
      recalculate();
    });

    // Initial calculation
    recalculate();
  }

  // Initialize on DOM load and Astro page swaps
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSfeModeler);
  } else {
    initSfeModeler();
  }
  document.addEventListener('astro:page-load', initSfeModeler);
</script>
