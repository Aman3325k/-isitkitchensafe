    },
    persian_lime_cold_pressed_oil: {
      id: 'persian_lime_cold_pressed_oil',
      name: 'Persian Tahiti Lime Peel Oil',
      monoterpeneContentPercent: 91.0,
      primaryTerpene: 'D-Limonene (52.0%) + beta-Pinene (14.0%)',
      oxygenatedAromaContentPercent: 5.2,
      keyAromaCompounds: 'alpha-Terpineol, Citral, Bisabolene',
      waxAndResinContentPercent: 3.8,
      targetFoldLevel: '8-Fold Supercritical Terpene-Stripped Lime',
      thermalSensitivityThresholdC: 44.0,
      notes: 'High concentration of bisabolenes and sesquiterpenes requires fine-tuned CO2 density (380–420 kg/m³) to avoid premature stripping of lime character.'
    },
    supercritical_raw_hop_extract: {
      id: 'supercritical_raw_hop_extract',
      name: 'Raw Supercritical CO2 Hop Extract (Cascade/Citra)',
      monoterpeneContentPercent: 38.0,
      primaryTerpene: 'Myrcene (22.0%) + alpha-Humulene (9.5%)',
      oxygenatedAromaContentPercent: 4.5,
      keyAromaCompounds: 'Linalool, Geraniol, 2-Methylbutyl Isobutyrate',
      waxAndResinContentPercent: 57.5,
      targetFoldLevel: 'Pure Cold-Hop Aroma Fraction (Zero Alpha-Acids)',
      thermalSensitivityThresholdC: 52.0,
      notes: 'Extracts floral myrcene, humulene, and caryophyllene aroma volatiles without carrying over bitter alpha-acids (cohumulone/humulone), producing zero-IBU dry-hop aroma extracts.'
    }
