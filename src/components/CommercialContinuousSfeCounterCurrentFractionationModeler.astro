    diagramSub: "高圧循環CO2ループ、ステンレス金網規則充填床、気液連続向流接触相界面、塔頂還流分配器、カスケード減圧分離槽群を可視化。",
    scienceTitle: "科学原理の解説: 超臨界相平衡と非加熱脱テルペン分離工学",
    scienceSub: "Chrastil状態方程式による密度チューニング、規則充填物におけるHETP物質移動速度論、熱変性ゼロのシトラール保護、光毒性フロクマリン結晶分離を網羅。",
    tableTitle: "精油濃縮＆脱テルペン主要技術ベンチマーク比較"
  }
};

const d = DICT[lang] || DICT['en'];
---

<div class="space-y-12">
  <!-- Header / Title Banner -->
  <section class="bg-surface-soft border border-hairline rounded-3xl p-6 sm:p-10 shadow-xs relative overflow-hidden">
    <div class="max-w-4xl space-y-4">
      <div class="flex flex-wrap items-center gap-3">
        <span class="inline-block px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-950 text-amber-200 border border-amber-800">
          {d.badge}
        </span>
        <span class="inline-block px-3 py-0.5 rounded-md text-xs font-mono bg-surface-elevated text-muted border border-hairline">
          80–220 bar • 35–65°C • ASME Section VIII Div 1 &amp; 2
        </span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold text-ink tracking-tight">
        {d.title}
      </h1>
      <p class="text-body text-sm sm:text-base leading-relaxed">
        {d.subtitle}
      </p>
    </div>
  </section>

  <!-- Interactive Simulator Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    
    <!-- Controls Panel (Left / 5 cols) -->
    <div class="lg:col-span-5 bg-surface-soft border border-hairline rounded-3xl p-6 sm:p-7 shadow-xs space-y-6">
      <div class="border-b border-hairline pb-4">
        <h2 class="text-lg font-bold text-ink">{d.controlsTitle}</h2>
        <p class="text-xs text-muted mt-1">{d.controlsSub}</p>
      </div>

      <!-- Presets Selector Buttons -->
      <div class="space-y-2">
        <label class="text-xs font-bold uppercase tracking-wider text-muted block">{d.presetsTitle}</label>
        <div class="grid grid-cols-1 gap-1.5">
          <button 
            type="button" 
            id="sfe-preset-orange"
            class="text-left px-3 py-2 rounded-xl text-xs font-medium bg-amber-950/30 hover:bg-amber-900/50 text-amber-200 border border-amber-800/40 transition-colors"
          >
            🍊 {d.presetOrange}
          </button>
          <button 
            type="button" 
            id="sfe-preset-lemon"
            class="text-left px-3 py-2 rounded-xl text-xs font-medium bg-surface-elevated hover:bg-surface-elevated/80 text-ink border border-hairline transition-colors"
          >
            🍋 {d.presetLemon}
          </button>
          <button 
            type="button" 
            id="sfe-preset-bergamot"
            class="text-left px-3 py-2 rounded-xl text-xs font-medium bg-surface-elevated hover:bg-surface-elevated/80 text-ink border border-hairline transition-colors"
          >
            🌿 {d.presetBergamot}
          </button>
          <button 
            type="button" 
            id="sfe-preset-hop"
            class="text-left px-3 py-2 rounded-xl text-xs font-medium bg-surface-elevated hover:bg-surface-elevated/80 text-ink border border-hairline transition-colors"
          >
            🍺 {d.presetHop}
          </button>
          <button 
            type="button" 
            id="sfe-preset-hazard"
            class="text-left px-3 py-2 rounded-xl text-xs font-medium bg-rose-950/30 hover:bg-rose-900/50 text-rose-200 border border-rose-800/40 transition-colors"
          >
            ⚠️ {d.presetHazard}
          </button>
        </div>
      </div>

      <!-- Column Architecture Selection -->
      <div class="space-y-1.5">
        <label for="sfe-column-select" class="text-xs font-semibold text-ink flex items-center justify-between">
          <span>{d.columnLabel}</span>
        </label>
        <select 
          id="sfe-column-select"
          class="w-full bg-surface-elevated border border-hairline rounded-xl px-3 py-2 text-xs text-ink focus:outline-hidden focus:ring-2 focus:ring-amber-500 font-medium"
        >
          {sfeData.sfeColumnSystems.map((col) => (
            <option value={col.id}>{col.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted">{d.columnHelp}</p>
      </div>

      <!-- Feedstock Selection -->
      <div class="space-y-1.5">
        <label for="sfe-feedstock-select" class="text-xs font-semibold text-ink flex items-center justify-between">
          <span>{d.feedstockLabel}</span>
        </label>
        <select 
          id="sfe-feedstock-select"
          class="w-full bg-surface-elevated border border-hairline rounded-xl px-3 py-2 text-xs text-ink focus:outline-hidden focus:ring-2 focus:ring-amber-500 font-medium"
        >
          {sfeData.processingFeedstocks.map((feed) => (
            <option value={feed.id}>{feed.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted">{d.feedstockHelp}</p>
      </div>

      <!-- Slider 1: Column Operating Pressure -->
      <div class="space-y-2 pt-2 border-t border-hairline/60">
        <div class="flex justify-between items-center text-xs">
          <label for="sfe-pressure-slider" class="font-semibold text-ink">{d.pressureLabel}</label>
          <span id="sfe-pressure-val" class="font-mono font-bold text-amber-500">92 bar</span>
        </div>
        <input 
          type="range" 
          id="sfe-pressure-slider" 
          min="75" 
          max="220" 
          step="1" 
          value="92" 
          class="w-full accent-amber-500 cursor-pointer"
        />
        <p class="text-[11px] text-muted">{d.pressureHelp}</p>
      </div>

      <!-- Slider 2: Column Temperature -->
      <div class="space-y-2">
        <div class="flex justify-between items-center text-xs">
          <label for="sfe-temp-slider" class="font-semibold text-ink">{d.tempLabel}</label>
          <span id="sfe-temp-val" class="font-mono font-bold text-amber-500">48.0 °C</span>
        </div>
        <input 
          type="range" 
          id="sfe-temp-slider" 
          min="32" 
          max="70" 
          step="0.5" 
          value="48.0" 
          class="w-full accent-amber-500 cursor-pointer"
        />
        <p class="text-[11px] text-muted">{d.tempHelp}</p>
      </div>

      <!-- Slider 3: Solvent-to-Feed (S/F) Ratio -->
      <div class="space-y-2">
        <div class="flex justify-between items-center text-xs">
          <label for="sfe-sf-slider" class="font-semibold text-ink">{d.sfRatioLabel}</label>
          <span id="sfe-sf-val" class="font-mono font-bold text-amber-500">35.0 kg/kg</span>
        </div>
        <input 
          type="range" 
          id="sfe-sf-slider" 
          min="10" 
          max="60" 
          step="1" 
          value="35" 
          class="w-full accent-amber-500 cursor-pointer"
        />
        <p class="text-[11px] text-muted">{d.sfRatioHelp}</p>
      </div>

      <!-- Slider 4: Top Reflux Ratio -->
      <div class="space-y-2">
        <div class="flex justify-between items-center text-xs">
          <label for="sfe-reflux-slider" class="font-semibold text-ink">{d.refluxLabel}</label>
          <span id="sfe-reflux-val" class="font-mono font-bold text-amber-500">1.20</span>
        </div>
        <input 
          type="range" 
          id="sfe-reflux-slider" 
          min="0.0" 
          max="3.5" 
          step="0.1" 
          value="1.2" 
          class="w-full accent-amber-500 cursor-pointer"
        />
        <p class="text-[11px] text-muted">{d.refluxHelp}</p>
      </div>

      <!-- Slider 5: Raw Feed Flow Rate -->
      <div class="space-y-2">
        <div class="flex justify-between items-center text-xs">
          <label for="sfe-feed-slider" class="font-semibold text-ink">{d.feedRateLabel}</label>
          <span id="sfe-feed-val" class="font-mono font-bold text-amber-500">12.0 kg/h</span>
        </div>
        <input 
          type="range" 
          id="sfe-feed-slider" 
          min="1.0" 
          max="30.0" 
          step="0.5" 
          value="12.0" 
          class="w-full accent-amber-500 cursor-pointer"
        />
        <p class="text-[11px] text-muted">{d.feedRateHelp}</p>
      </div>

    </div>

    <!-- Live Telemetry & Interactive Visuals (Right / 7 cols) -->
    <div class="lg:col-span-7 space-y-6">
      
      <!-- Telemetry Cards Box -->
      <div class="bg-surface-soft border border-hairline rounded-3xl p-6 sm:p-7 shadow-xs space-y-6">
        <div class="flex items-center justify-between border-b border-hairline pb-4">
          <div>
            <h2 class="text-lg font-bold text-ink">{d.diagnosticTitle}</h2>
            <p class="text-xs text-muted mt-0.5">{d.diagnosticSub}</p>
          </div>
          <div id="sfe-status-pill" class="px-3 py-1 rounded-full text-xs font-bold font-mono bg-emerald-950 text-emerald-300 border border-emerald-800">
            OPTIMAL EXTRACTION
          </div>
        </div>

        <!-- 8 Diagnostic Key Output Cards Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          
          <!-- Card 1: CO2 Density -->
          <div class="bg-surface-elevated border border-hairline rounded-2xl p-4 flex flex-col justify-between">
            <span class="text-[11px] text-muted font-medium leading-tight">{d.densityLabel}</span>
            <div class="mt-2">
              <span id="sfe-out-density" class="text-xl sm:text-2xl font-bold font-mono text-amber-500">362 kg/m³</span>
              <p class="text-[10px] text-muted mt-0.5">Span-Wagner Gas Phase</p>
            </div>
          </div>

          <!-- Card 2: Selectivity Factor -->
          <div class="bg-surface-elevated border border-hairline rounded-2xl p-4 flex flex-col justify-between">
            <span class="text-[11px] text-muted font-medium leading-tight">{d.selectivityLabel}</span>
            <div class="mt-2">
              <span id="sfe-out-selectivity" class="text-xl sm:text-2xl font-bold font-mono text-cyan-600 dark:text-cyan-400">4.18 α</span>
              <p class="text-[10px] text-muted mt-0.5">Terpene / Ester Ratio</p>
            </div>
          </div>

          <!-- Card 3: Terpene Stripping -->
          <div class="bg-surface-elevated border border-hairline rounded-2xl p-4 flex flex-col justify-between">
            <span class="text-[11px] text-muted font-medium leading-tight">{d.terpeneStrippingLabel}</span>
            <div class="mt-2">
              <span id="sfe-out-stripping" class="text-xl sm:text-2xl font-bold font-mono text-emerald-500">95.4%</span>
              <p class="text-[10px] text-muted mt-0.5">Overhead Bio-Solvent</p>
            </div>
          </div>

          <!-- Card 4: Fold Concentration Level -->
          <div class="bg-surface-elevated border border-hairline rounded-2xl p-4 flex flex-col justify-between">
            <span class="text-[11px] text-muted font-medium leading-tight">{d.foldLevelLabel}</span>
            <div class="mt-2">
              <span id="sfe-out-fold" class="text-xl sm:text-2xl font-bold font-mono text-indigo-500">9.8-Fold</span>
              <p class="text-[10px] text-muted mt-0.5">Raffinate Folding</p>
            </div>
          </div>

          <!-- Card 5: Aroma Ester & Aldehyde Recovery -->
          <div class="bg-surface-elevated border border-hairline rounded-2xl p-4 flex flex-col justify-between">
            <span class="text-[11px] text-muted font-medium leading-tight">{d.aromaRecoveryLabel}</span>
            <div class="mt-2">
              <span id="sfe-out-aroma" class="text-xl sm:text-2xl font-bold font-mono text-emerald-500">96.8%</span>
              <p class="text-[10px] text-muted mt-0.5">Octanal / Citral Retained</p>
            </div>
          </div>

          <!-- Card 6: Flooding Margin -->
          <div class="bg-surface-elevated border border-hairline rounded-2xl p-4 flex flex-col justify-between">
            <span class="text-[11px] text-muted font-medium leading-tight">{d.floodingMarginLabel}</span>
            <div class="mt-2">
              <span id="sfe-out-flooding" class="text-xl sm:text-2xl font-bold font-mono text-ink">46.5%</span>
              <p class="text-[10px] text-muted mt-0.5">Hydraulic Limit: &lt; 80%</p>
            </div>
          </div>

          <!-- Card 7: Thermal Degradation -->
          <div class="bg-surface-elevated border border-hairline rounded-2xl p-4 flex flex-col justify-between">
            <span class="text-[11px] text-muted font-medium leading-tight">{d.thermalDegradationLabel}</span>
            <div class="mt-2">
              <span id="sfe-out-thermal" class="text-xl sm:text-2xl font-bold font-mono text-emerald-500">0.0%</span>
              <p class="text-[10px] text-muted mt-0.5">Non-Thermal Processing</p>
            </div>
          </div>

          <!-- Card 8: ASME Overpressure Safety Margin -->
          <div class="bg-surface-elevated border border-hairline rounded-2xl p-4 flex flex-col justify-between">
            <span class="text-[11px] text-muted font-medium leading-tight">{d.asmeSafetyLabel}</span>
            <div class="mt-2">
              <span id="sfe-out-asme" class="text-xl sm:text-2xl font-bold font-mono text-emerald-500">+158 bar</span>
              <p class="text-[10px] text-muted mt-0.5">Relief Valve Set: 250 bar</p>
            </div>
          </div>

        </div>

        <!-- Separation Insights Callout Box -->
        <div class="p-4 rounded-2xl bg-surface-elevated border border-hairline space-y-2">
          <div class="flex items-center justify-between text-xs">
            <span class="font-bold text-ink">Active Feedstock Evaluation:</span>
            <span id="sfe-active-feed-name" class="font-mono text-amber-600 dark:text-amber-400 font-semibold">Cold-Pressed Valencia Orange Peel Oil</span>
          </div>
          <p id="sfe-active-desc" class="text-xs text-body leading-relaxed">
            High monoterpene citrus oil (94.5% D-limonene). Counter-current supercritical CO2 strips 95% of monoterpenes overhead into bio-solvent storage while concentrating oxygenated aldehydes (octanal, decanal, citral) into a rich 10-fold beverage concentrate.
          </p>
          <div class="flex flex-wrap gap-2 pt-1 text-[11px]">
            <span class="px-2 py-0.5 rounded-md bg-amber-950/40 text-amber-300 border border-amber-800/40">
              Zero Chemical Solvents (100% Green CO2)
            </span>
            <span class="px-2 py-0.5 rounded-md bg-emerald-950/40 text-emerald-300 border border-emerald-800/40">
              FDA 21 CFR § 182.20 GRAS Compliant
            </span>
            <span class="px-2 py-0.5 rounded-md bg-cyan-950/40 text-cyan-300 border border-cyan-800/40">
              Sulzer CY Structured Packing HETP &lt; 15 cm
            </span>
          </div>
        </div>
      </div>

      <!-- High-Fidelity SVG Schematic Diagram Box -->
      <div class="bg-surface-soft border border-hairline rounded-3xl p-6 sm:p-7 shadow-xs space-y-4">
        <div>
          <h3 class="text-base font-bold text-ink">{d.diagramTitle}</h3>
          <p class="text-xs text-muted mt-0.5">{d.diagramSub}</p>
        </div>

        <div class="w-full overflow-hidden rounded-2xl bg-surface-elevated border border-hairline p-4">
          <svg viewBox="0 0 760 300" class="w-full h-auto text-ink select-none" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="sfe-col-grad" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#f59e0b" stop-opacity="0.3"/>
                <stop offset="50%" stop-color="#3b82f6" stop-opacity="0.2"/>
                <stop offset="100%" stop-color="#10b981" stop-opacity="0.4"/>
              </linearGradient>
              <linearGradient id="sfe-co2-stream" x1="0%" y1="100%" x2="0%" y2="0%">
                <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.9"/>
                <stop offset="100%" stop-color="#818cf8" stop-opacity="0.9"/>
              </linearGradient>
              <pattern id="sfe-wire-gauze" width="12" height="12" patternUnits="userSpaceOnUse">
                <path d="M0 6 L6 0 L12 6 L6 12 Z" fill="none" stroke="#64748b" stroke-width="0.75" stroke-opacity="0.4"/>
              </pattern>
            </defs>

            <!-- Background Grid lines -->
            <line x1="40" y1="260" x2="720" y2="260" stroke="#334155" stroke-width="1" stroke-dasharray="4 4" opacity="0.3"/>
            
            <!-- 1. Raw Oil Feed System (Left) -->
            <rect x="30" y="60" width="90" height="70" rx="8" fill="#1e293b" stroke="#f59e0b" stroke-width="1.5"/>
            <text x="75" y="85" text-anchor="middle" fill="#f59e0b" font-size="10" font-weight="bold">RAW FEED TANK</text>
            <text x="75" y="100" text-anchor="middle" fill="#94a3b8" font-size="8.5">Valencia Orange</text>
            <text x="75" y="115" text-anchor="middle" fill="#cbd5e1" font-size="8" font-family="monospace">12.0 kg/h</text>

            <!-- Feed Pipe to Column Upper Section -->
            <path d="M120 95 L220 95" stroke="#f59e0b" stroke-width="2.5" fill="none"/>
            <polygon points="218,91 228,95 218,99" fill="#f59e0b"/>
            <text x="170" y="88" text-anchor="middle" fill="#f59e0b" font-size="8" font-weight="bold">FEED INLET</text>

            <!-- 2. Main Vertical Packed Column (Center: x=230 to 330, y=20 to 260) -->
            <rect x="230" y="25" width="100" height="235" rx="14" fill="url(#sfe-col-grad)" stroke="#94a3b8" stroke-width="2.5"/>
            
            <!-- Column Flange Closures (Top & Bottom Bridgman Clamps) -->
            <rect x="222" y="20" width="116" height="8" rx="2" fill="#475569" stroke="#94a3b8" stroke-width="1"/>
            <rect x="222" y="255" width="116" height="8" rx="2" fill="#475569" stroke="#94a3b8" stroke-width="1"/>

            <!-- Structured Packing Beds (Sulzer CY Wire Gauze) -->
            <!-- Bed 1 (Rectifying Section, Top) -->
            <rect x="238" y="55" width="84" height="60" rx="4" fill="url(#sfe-wire-gauze)" stroke="#0284c7" stroke-width="1"/>
            <text x="280" y="88" text-anchor="middle" fill="#38bdf8" font-size="9" font-weight="bold" opacity="0.85">RECTIFYING BED</text>
            <text x="280" y="100" text-anchor="middle" fill="#94a3b8" font-size="7.5">Sulzer CY Gauze</text>

            <!-- Feed Liquid Distributor Nozzle -->
            <line x1="230" y1="120" x2="330" y2="120" stroke="#f59e0b" stroke-width="2"/>
            <circle cx="250" cy="120" r="3" fill="#f59e0b"/>
            <circle cx="280" cy="120" r="3" fill="#f59e0b"/>
            <circle cx="310" cy="120" r="3" fill="#f59e0b"/>

            <!-- Bed 2 (Stripping Section, Bottom) -->
            <rect x="238" y="130" width="84" height="80" rx="4" fill="url(#sfe-wire-gauze)" stroke="#0284c7" stroke-width="1"/>
            <text x="280" y="165" text-anchor="middle" fill="#38bdf8" font-size="9" font-weight="bold" opacity="0.85">STRIPPING BED</text>
            <text x="280" y="178" text-anchor="middle" fill="#94a3b8" font-size="7.5">900 m²/m³ Area</text>
            <text x="280" y="190" text-anchor="middle" fill="#94a3b8" font-size="7.5">HETP = 12.5 cm</text>

            <!-- Ascending CO2 Stream (Blue upward arrows) -->
            <path d="M260 220 L260 45" stroke="url(#sfe-co2-stream)" stroke-width="2" stroke-dasharray="3 3"/>
            <polygon points="257,47 260,39 263,47" fill="#38bdf8"/>
            <text x="268" y="235" fill="#38bdf8" font-size="7.5" font-family="monospace">SC-CO2 ↑</text>

            <!-- Descending Liquid Droplets (Amber downward dots) -->
            <circle cx="295" cy="135" r="2" fill="#f59e0b"/>
            <circle cx="300" cy="155" r="2.5" fill="#f59e0b"/>
            <circle cx="292" cy="180" r="2" fill="#f59e0b"/>
            <circle cx="298" cy="205" r="3" fill="#10b981"/>
            <text x="306" y="215" fill="#10b981" font-size="7.5" font-family="monospace">Raffinate ↓</text>

            <!-- 3. Top Distillate & Reflux Loop (Upper Right) -->
            <!-- Overhead vapor pipe -->
            <path d="M280 20 L280 10 L410 10 L410 40" stroke="#818cf8" stroke-width="2.5" fill="none"/>
            <polygon points="406,35 410,43 414,35" fill="#818cf8"/>
            <text x="350" y="8" fill="#818cf8" font-size="8" font-weight="bold">SC-CO2 + MONOTERPENES</text>

            <!-- Reflux Condenser & Divider -->
            <rect x="375" y="42" width="70" height="42" rx="6" fill="#1e293b" stroke="#818cf8" stroke-width="1.5"/>
            <text x="410" y="58" text-anchor="middle" fill="#818cf8" font-size="8.5" font-weight="bold">REFLUX DIVIDER</text>
            <text x="410" y="72" text-anchor="middle" fill="#cbd5e1" font-size="7.5" font-family="monospace">Ratio R = 1.20</text>

            <!-- Reflux Return Pipe back to Column Top -->
            <path d="M375 60 L310 60 L310 32" stroke="#818cf8" stroke-width="1.5" stroke-dasharray="2 2" fill="none"/>
            <polygon points="307,35 310,27 313,35" fill="#818cf8"/>

            <!-- 4. Cascaded Multi-Stage Separator Units (Far Right) -->
            <!-- Separator 1: Heavy Wax & Furocoumarin Cut (Top Right) -->
            <rect x="470" y="50" width="95" height="65" rx="8" fill="#1e293b" stroke="#eab308" stroke-width="1.5"/>
            <text x="517" y="70" text-anchor="middle" fill="#eab308" font-size="9" font-weight="bold">SEPARATOR 1</text>
            <text x="517" y="84" text-anchor="middle" fill="#94a3b8" font-size="7.5">110 bar • 45°C</text>
            <text x="517" y="98" text-anchor="middle" fill="#eab308" font-size="8">Wax / 5-MOP Cut</text>

            <path d="M445 60 L470 60" stroke="#818cf8" stroke-width="2" fill="none"/>

            <!-- Separator 2: Terpene Flash Recovery (Middle Right) -->
            <rect x="600" y="50" width="110" height="85" rx="8" fill="#1e293b" stroke="#10b981" stroke-width="1.5"/>
            <text x="655" y="72" text-anchor="middle" fill="#10b981" font-size="9" font-weight="bold">SEPARATOR 2 (FLASH)</text>
            <text x="655" y="86" text-anchor="middle" fill="#94a3b8" font-size="7.5">52 bar • 22°C</text>
            <text x="655" y="100" text-anchor="middle" fill="#10b981" font-size="8">D-Limonene (98.5%)</text>
            <text x="655" y="114" text-anchor="middle" fill="#38bdf8" font-size="7.5" font-family="monospace">Green Bio-Solvent</text>

            <path d="M565 75 L600 75" stroke="#818cf8" stroke-width="2" fill="none"/>

