    skidHelp: "商用生産スキッド、無菌クリーンルーム医薬グレード多糖精製機組、農業バイオリファイナリー、分析パイロット試験装置を選択。",
    feedstockLabel: "農業加工バイオマス原料種別：",
    feedstockHelp: "サトウキビバガス、ビール粕（BSG）、果実絞り粕（リンゴ・柑橘）、硫酸高温加熱危険項目を選択。",
    coilLabel: "水熱反応管流路ジオメトリ：",
    coilHelp: "高剪断マイクロチューブヘリカルコイル（ディーン二次渦 De > 450）、アニュラー型スタティックミキサー、従来型直管を選択。",
    feedRateLabel: "連続スラリー供給質量流量 (F_slurry)：",
    feedRateHelp: "高圧ポンプにより反応管入口へ連続供給されるバイオマススラリーの質量流量（10.0〜300.0 kg/h）。",
    pressureLabel: "水熱反応器油圧作動圧力 (P_reactor)：",
    pressureHelp: "亜臨界水を飽和蒸気圧以上の高密度液体状態に維持する作動圧力（120〜280 bar）。",
    tempLabel: "水熱反応温度 (T_reactor)：",
    tempHelp: "水の自己解離イオン積 (pKw) およびグリコシド結合の選択的加水分解を制御する反応温度（140〜260°C）。",
    residenceTimeLabel: "水熱反応管内滞留時間 (t_res)：",
    residenceTimeHelp: "スラリーが加熱反応ゾーン内に留まり反応する精密滞留時間（30〜300秒）。",
    wbRatioLabel: "水/バイオマス溶媒比 (W/B)：",
    wbRatioHelp: "亜臨界水溶媒と乾燥リグノセルロース固形分の質量希釈比（6:1〜25:1 L/kg）。",
    presetsTitle: "産業用クイック設定プリセット：",
    presetBagasse: "サトウキビバガス高純度キシロオリゴ糖（180°C、180 bar、90秒、W/B 12、XOS DP 2〜6 >86%、フルフラール <0.05%、鉱物酸ゼロ）",
    presetBsg: "ビール粕アラビノキシラン＆機能性ペプチド（170°C、160 bar、75秒、W/B 10、83.5% プレバイオティクス回収率）",
    presetPomace: "リンゴ・柑橘果皮ペクチンオリゴ糖抽出（165°C、150 bar、60秒、W/B 15、89.2% 水溶性オリゴ糖収率）",
    presetHtc: "農業残渣高エネルギー水熱炭化（230°C、220 bar、240秒、W/B 8、固体炭素回収率72%、高位発熱量 > 24 MJ/kg）",
    presetHazard: "従来の濃硫酸高温煮沸危険モード（130°C、15 bar、1800秒、フルフラール4.85%、酸腐食、有害廃液）",
    telemetryTitle: "リアルタイム水熱反応テレメトリー＆動力学レーダー",
    telemetrySub: "プレバイオティクス XOS 収率、フルフラール副生濃度、水の自己電離積、ASME 構造安全率を連続監視。",
    xosYieldLabel: "キシロオリゴ糖収率 (XOS DP 2–6)：",
    furfuralLabel: "フルフラール副生分解率：",
    solubilizationLabel: "ヘミセルロース総可溶化率：",
    pkwLabel: "水の自己解離イオン積 (pKw)：",
    dielectricLabel: "比誘電率 (ε_r)：",
    solventResidueLabel: "酸・溶剤残留濃度 (USP <467>)：",
    energyLabel: "製品単位比熱エネルギー消費量：",
    asmeSafetyLabel: "ASME VIII 圧力容器安全係数：",
    complianceVerdictLabel: "衛生規格＆FDA FSMA適合状況：",
    diagramTitle: "連続 SCW-DME マイクロチューブ水熱プロセスフロー模式図",
    diagramSub: "セラミック高圧スラリープランジャーポンプ、誘導予熱器、ディーン渦流ヘリカル反応管、超高速冷却熱交換器（<1.5秒）、セラミックBPR背圧弁。",
    chartTitle: "水熱厳格度指数 (Log R0) vs. キシロオリゴ糖収率＆フルフラール生成動力学曲線",
    chartSub: "各等温線（160°C、180°C、200°C）における最適オリゴ糖ピーク領域および現在稼働状態プロット。",
    scienceTitle: "亜臨界水熱流体物理学＆自己触媒分解機構",
    scienceSub: "Marshall-Franck 水の自己電離積モデル、比誘電率の急減メカニズム、Overend-Chornet 厳格度係数、およびディーン渦流伝熱促進。",
    tableTitle: "サニタリーエンジニアリング、材料金属学および規制基準",
    exportAuditBtn: "検証監査証明書のエクスポート (PDF / JSON)"
  }
};

const d = DICT[lang] || DICT.en;
---

<div id="scw-dme-modeler-root" class="bg-surface border border-hairline rounded-2xl p-6 lg:p-8 shadow-xs my-8" data-lang={lang}>
  <!-- Header Banner -->
  <div class="border-b border-hairline/80 pb-6 mb-8">
    <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-950 text-emerald-300 border border-emerald-800 font-mono">
        <svg class="w-3.5 h-3.5 text-emerald-400 animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
        </svg>
        {d.badge}
      </span>
      <span class="text-xs text-muted font-mono bg-surface-soft px-3 py-1 rounded-md border border-hairline">
        SCW-DME &bull; 150&ndash;250 bar &bull; 160&ndash;240&deg;C &bull; XOS DP 2&ndash;6 &bull; FDA 170.36 GRAS &bull; ASME VIII
      </span>
    </div>
    <h1 class="text-2xl lg:text-3xl font-black text-ink tracking-tight mb-2">
      {d.title}
    </h1>
    <p class="text-sm lg:text-base text-body leading-relaxed max-w-4xl">
      {d.subtitle}
    </p>
  </div>

  <!-- Presets Strip -->
  <div class="mb-8 p-4 bg-surface-soft border border-hairline rounded-xl">
    <div class="text-xs font-bold uppercase tracking-wider text-muted mb-3 font-mono">
      ⚡ {d.presetsTitle}
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-2 text-xs">
      <button type="button" class="preset-btn text-left p-2.5 rounded-lg border border-hairline/70 hover:border-emerald-600 bg-surface hover:bg-emerald-950/20 text-ink transition" data-preset="bagasse">
        <span class="font-bold text-emerald-400 block mb-0.5">🌾 Sugarcane Bagasse Prebiotic XOS</span>
        <span class="text-muted text-[11px] block leading-tight">{d.presetBagasse}</span>
      </button>
      <button type="button" class="preset-btn text-left p-2.5 rounded-lg border border-hairline/70 hover:border-amber-600 bg-surface hover:bg-amber-950/20 text-ink transition" data-preset="bsg">
        <span class="font-bold text-amber-400 block mb-0.5">🍺 Brewer's Spent Grain Arabinoxylan</span>
        <span class="text-muted text-[11px] block leading-tight">{d.presetBsg}</span>
      </button>
      <button type="button" class="preset-btn text-left p-2.5 rounded-lg border border-hairline/70 hover:border-cyan-600 bg-surface hover:bg-cyan-950/20 text-ink transition" data-preset="pomace">
        <span class="font-bold text-cyan-400 block mb-0.5">🍏 Citrus & Apple Pomace Pectin Oligosaccharides</span>
        <span class="text-muted text-[11px] block leading-tight">{d.presetPomace}</span>
      </button>
      <button type="button" class="preset-btn text-left p-2.5 rounded-lg border border-hairline/70 hover:border-indigo-600 bg-surface hover:bg-indigo-950/20 text-ink transition" data-preset="htc">
        <span class="font-bold text-indigo-400 block mb-0.5">🔥 Hydrochar Bio-Coal HTC Run</span>
        <span class="text-muted text-[11px] block leading-tight">{d.presetHtc}</span>
      </button>
      <button type="button" class="preset-btn text-left p-2.5 rounded-lg border border-rose-800/80 hover:border-rose-600 bg-rose-950/20 hover:bg-rose-950/40 text-rose-200 transition md:col-span-2 lg:col-span-2" data-preset="hazard">
        <span class="font-bold text-rose-400 block mb-0.5">⚠️ Conventional Sulfuric Acid Hydrolysis (CRITICAL HAZARD)</span>
        <span class="text-rose-300/80 text-[11px] block leading-tight">{d.presetHazard}</span>
      </button>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-10">
    <!-- Controls Column (5 cols) -->
    <div class="lg:col-span-5 space-y-6">
      <div class="border border-hairline rounded-xl p-5 bg-surface-soft">
        <h2 class="text-base font-bold text-ink mb-1 flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
          {d.controlsTitle}
        </h2>
        <p class="text-xs text-muted mb-4">{d.controlsSub}</p>

        <div class="space-y-4 text-xs">
          <!-- Skid Selection -->
          <div>
            <label for="skid-select" class="block font-medium text-ink mb-1">{d.skidLabel}</label>
            <select id="skid-select" class="w-full bg-surface border border-hairline rounded-lg px-3 py-2 text-ink text-xs focus:outline-none focus:border-emerald-500">
              {scwDmeData.systemArchitectures.map((skid) => (
                <option value={skid.id}>{skid.name}</option>
              ))}
            </select>
            <span class="text-[11px] text-muted block mt-1">{d.skidHelp}</span>
          </div>

          <!-- Feedstock Profile Selection -->
          <div>
            <label for="feedstock-select" class="block font-medium text-ink mb-1">{d.feedstockLabel}</label>
            <select id="feedstock-select" class="w-full bg-surface border border-hairline rounded-lg px-3 py-2 text-ink text-xs focus:outline-none focus:border-emerald-500">
              {scwDmeData.feedstocks.map((feed) => (
                <option value={feed.id}>{feed.name}</option>
              ))}
            </select>
            <span class="text-[11px] text-muted block mt-1">{d.feedstockHelp}</span>
          </div>

          <!-- Reactor Coil Geometry -->
          <div>
            <label for="coil-select" class="block font-medium text-ink mb-1">{d.coilLabel}</label>
            <select id="coil-select" class="w-full bg-surface border border-hairline rounded-lg px-3 py-2 text-ink text-xs focus:outline-none focus:border-emerald-500">
              {scwDmeData.reactorCoilDesigns.map((coil) => (
                <option value={coil.id}>{coil.name}</option>
              ))}
            </select>
            <span class="text-[11px] text-muted block mt-1">{d.coilHelp}</span>
          </div>

          <!-- Feed Flow Rate Slider -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label for="feed-rate-slider" class="font-medium text-ink">{d.feedRateLabel}</label>
              <span id="feed-rate-val" class="font-mono font-bold text-emerald-400">50.0 kg/h</span>
            </div>
            <input type="range" id="feed-rate-slider" min="10" max="300" step="5" value="50" class="w-full accent-emerald-500 h-1.5 bg-surface rounded-lg cursor-pointer" />
            <span class="text-[11px] text-muted block mt-1">{d.feedRateHelp}</span>
          </div>

          <!-- Pressure Slider -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label for="pressure-slider" class="font-medium text-ink">{d.pressureLabel}</label>
              <span id="pressure-val" class="font-mono font-bold text-emerald-400">180 bar</span>
            </div>
            <input type="range" id="pressure-slider" min="120" max="280" step="5" value="180" class="w-full accent-emerald-500 h-1.5 bg-surface rounded-lg cursor-pointer" />
            <span class="text-[11px] text-muted block mt-1">{d.pressureHelp}</span>
          </div>

          <!-- Temperature Slider -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label for="temp-slider" class="font-medium text-ink">{d.tempLabel}</label>
              <span id="temp-val" class="font-mono font-bold text-amber-400">180&deg;C</span>
            </div>
            <input type="range" id="temp-slider" min="140" max="260" step="2" value="180" class="w-full accent-amber-500 h-1.5 bg-surface rounded-lg cursor-pointer" />
            <span class="text-[11px] text-muted block mt-1">{d.tempHelp}</span>
          </div>

          <!-- Residence Time Slider -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label for="residence-slider" class="font-medium text-ink">{d.residenceTimeLabel}</label>
              <span id="residence-val" class="font-mono font-bold text-cyan-400">90 s</span>
            </div>
            <input type="range" id="residence-slider" min="30" max="300" step="5" value="90" class="w-full accent-cyan-500 h-1.5 bg-surface rounded-lg cursor-pointer" />
            <span class="text-[11px] text-muted block mt-1">{d.residenceTimeHelp}</span>
          </div>

          <!-- Water-to-Biomass Ratio Slider -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label for="wb-slider" class="font-medium text-ink">{d.wbRatioLabel}</label>
              <span id="wb-val" class="font-mono font-bold text-indigo-400">12.0 L/kg</span>
            </div>
            <input type="range" id="wb-slider" min="6.0" max="25.0" step="0.5" value="12.0" class="w-full accent-indigo-500 h-1.5 bg-surface rounded-lg cursor-pointer" />
            <span class="text-[11px] text-muted block mt-1">{d.wbRatioHelp}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Telemetry & Process Column (7 cols) -->
    <div class="lg:col-span-7 space-y-6">
      <!-- Live Metrics Radar Grid -->
      <div class="border border-hairline rounded-xl p-5 bg-surface-soft">
        <div class="flex items-center justify-between mb-4">
          <div>
            <h2 class="text-base font-bold text-ink flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-ping"></span>
              {d.telemetryTitle}
            </h2>
            <p class="text-xs text-muted">{d.telemetrySub}</p>
          </div>
          <span id="status-pill" class="px-2.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-emerald-950 text-emerald-300 border border-emerald-800 font-mono">
            FDA § 170.36 GRAS / USP PASS
          </span>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mb-4">
          <!-- Prebiotic XOS Yield -->
          <div class="p-3 rounded-lg bg-surface border border-hairline">
            <span class="text-[11px] text-muted block font-medium">{d.xosYieldLabel}</span>
            <div class="flex items-baseline gap-1 mt-1">
              <span id="xos-metric" class="text-2xl font-black font-mono text-emerald-400">86.8%</span>
            </div>
            <span id="xos-sub" class="text-[10px] text-emerald-400 font-mono block mt-1">High-DP 2-6 Prebiotic Grade</span>
          </div>

          <!-- Furfural Degradation -->
          <div class="p-3 rounded-lg bg-surface border border-hairline">
            <span class="text-[11px] text-muted block font-medium">{d.furfuralLabel}</span>
            <div class="flex items-baseline gap-1 mt-1">
              <span id="furfural-metric" class="text-2xl font-black font-mono text-emerald-400">0.04%</span>
            </div>
            <span id="furfural-sub" class="text-[10px] text-emerald-400 font-mono block mt-1">Far Below 0.10% Toxic Limit</span>
          </div>

          <!-- Hemicellulose Solubilization -->
          <div class="p-3 rounded-lg bg-surface border border-hairline">
            <span class="text-[11px] text-muted block font-medium">{d.solubilizationLabel}</span>
            <div class="flex items-baseline gap-1 mt-1">
              <span id="solubilization-metric" class="text-2xl font-black font-mono text-cyan-400">92.4%</span>
            </div>
            <span id="solubilization-sub" class="text-[10px] text-muted font-mono block mt-1">Dynamic Water Extraction</span>
          </div>

          <!-- Water Auto-Ionization (pKw) -->
          <div class="p-3 rounded-lg bg-surface border border-hairline">
            <span class="text-[11px] text-muted block font-medium">{d.pkwLabel}</span>
            <div class="flex items-baseline gap-1 mt-1">
              <span id="pkw-metric" class="text-xl font-black font-mono text-amber-400">11.45</span>
            </div>
            <span id="pkw-sub" class="text-[10px] text-emerald-400 font-mono block mt-1">[H3O+] Self-Catalytic Boost</span>
          </div>

          <!-- Dielectric Permittivity (ε_r) -->
          <div class="p-3 rounded-lg bg-surface border border-hairline">
            <span class="text-[11px] text-muted block font-medium">{d.dielectricLabel}</span>
            <div class="flex items-baseline gap-1 mt-1">
              <span id="dielectric-metric" class="text-xl font-black font-mono text-indigo-300">38.2</span>
            </div>
            <span id="dielectric-sub" class="text-[10px] text-muted font-mono block mt-1">Organic-Like Solvent Phase</span>
          </div>

          <!-- Acid / Solvent Residue -->
          <div class="p-3 rounded-lg bg-surface border border-hairline">
            <span class="text-[11px] text-muted block font-medium">{d.solventResidueLabel}</span>
            <div class="flex items-baseline gap-1 mt-1">
              <span id="solvent-metric" class="text-xl font-black font-mono text-emerald-400">0.0</span>
              <span class="text-xs font-mono text-muted">ppm</span>
            </div>
            <span id="solvent-sub" class="text-[10px] text-emerald-400 font-mono block mt-1">USP <467> Solvent-Free</span>
          </div>
        </div>

        <div class="border-t border-hairline pt-3 space-y-2 text-xs">
          <div class="flex justify-between items-center">
            <span class="text-muted">{d.energyLabel}</span>
            <span id="sec-val" class="font-mono font-bold text-ink">0.42 kWh/kg dry feed (74% savings via counter-current economizer)</span>
          </div>
          <div class="flex justify-between items-center">
            <span class="text-muted">{d.asmeSafetyLabel}</span>
            <span id="asme-val" class="font-mono font-bold text-emerald-400">SF = 4.4 &ge; 4.0 (ASME BPVC VIII Div 1 & 2 Safe)</span>
          </div>
        </div>
      </div>

      <!-- Compliance Verdict Banner -->
      <div id="compliance-banner" class="p-4 rounded-xl border bg-emerald-950/40 border-emerald-800 text-xs text-emerald-200 flex items-start gap-3">
        <svg class="w-5 h-5 text-emerald-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <div>
          <span id="compliance-title" class="font-bold block text-sm text-emerald-300">COMPLIANT: FDA 21 CFR § 170.36 GRAS & USP &lt;467&gt; CLEAN-LABEL CERTIFIED</span>
          <span id="compliance-desc" class="text-muted block mt-0.5 leading-relaxed">
            The configured SCW-DME subcritical hydrothermal process delivers &gt;86% pure prebiotic xylooligosaccharides (XOS DP 2–6) with negligible furfural (<0.05%) and zero added mineral acids or organic solvents (0.0 ppm), fully conforming to ASME BPVC Section VIII Division 1 &amp; 2 and 3-A Sanitary Standards 60-01.
          </span>
        </div>
      </div>

      <!-- Export Action -->
      <div class="flex justify-end">
        <button type="button" id="export-audit-btn" class="px-4 py-2.5 rounded-xl bg-emerald-700 hover:bg-emerald-800 text-white font-medium text-xs transition shadow-xs flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          {d.exportAuditBtn}
        </button>
      </div>
    </div>
  </div>

  <!-- SVG Process Flow Schematic Section -->
  <section class="border border-hairline rounded-xl p-6 bg-surface-soft mb-10">
    <div class="mb-4">
      <h3 class="text-base font-bold text-ink">{d.diagramTitle}</h3>
      <p class="text-xs text-muted">{d.diagramSub}</p>
    </div>

    <div class="w-full overflow-x-auto bg-surface border border-hairline rounded-xl p-4">
      <svg class="w-full min-w-[760px] h-[310px]" viewBox="0 0 880 310" fill="none" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="scwGrid" width="20" height="20" patternUnits="userSpaceOnUse">
            <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#334155" stroke-width="0.5" stroke-opacity="0.25" />
          </pattern>
          <linearGradient id="scwFluidGrad" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#38bdf8" />
            <stop offset="50%" stop-color="#f59e0b" />
            <stop offset="100%" stop-color="#10b981" />
          </linearGradient>
          <linearGradient id="coilGrad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#f97316" />
            <stop offset="100%" stop-color="#ea580c" />
          </linearGradient>
        </defs>
        <rect width="880" height="310" fill="url(#scwGrid)" rx="8" />

        <!-- 1. Biomass Slurry Feed Tank & High-Pressure Ceramic Piston Pump -->
