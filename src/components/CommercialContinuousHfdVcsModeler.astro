<div class="bg-surface border border-hairline rounded-3xl p-6 sm:p-10 shadow-sm max-w-7xl mx-auto my-8 font-sans">
  <!-- Header Bar -->
  <div class="flex flex-wrap items-center justify-between gap-4 border-b border-hairline pb-6 mb-8">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-950 text-emerald-300 border border-emerald-800 mb-2">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        {d.badge}
      </div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-ink tracking-tight">
        {d.title}
      </h2>
      <p class="text-muted text-sm sm:text-base mt-2 max-w-4xl leading-relaxed">
        {d.subtitle}
      </p>
    </div>
    <div class="flex items-center gap-3 text-xs font-mono bg-surface-soft px-4 py-2.5 rounded-xl border border-hairline">
      <span class="text-muted">RF ISM:</span>
      <span class="text-ink font-bold">27.12 MHz</span>
      <span class="text-muted">|</span>
      <span class="text-muted">Vacuum:</span>
      <span class="text-ink font-bold">&lt; 1.5 mbar</span>
      <span class="text-muted">|</span>
      <span class="text-emerald-500 font-bold">3-A / USDA-FSIS</span>
    </div>
  </div>

  <!-- Presets Strip -->
  <div class="mb-8 p-4 bg-surface-soft/80 border border-hairline/80 rounded-2xl">
    <div class="text-xs font-bold text-muted uppercase tracking-wider mb-3">
      {d.presetsTitle}
    </div>
    <div class="flex flex-wrap gap-2.5">
      <button type="button" id="hfd-preset-bovine" class="px-3.5 py-1.5 rounded-lg text-xs font-medium bg-surface border border-hairline hover:border-emerald-600 hover:text-emerald-400 transition-colors shadow-2xs">
        {d.presetBovine}
      </button>
      <button type="button" id="hfd-preset-avian" class="px-3.5 py-1.5 rounded-lg text-xs font-medium bg-surface border border-hairline hover:border-emerald-600 hover:text-emerald-400 transition-colors shadow-2xs">
        {d.presetAvian}
      </button>
      <button type="button" id="hfd-preset-tuna" class="px-3.5 py-1.5 rounded-lg text-xs font-medium bg-surface border border-hairline hover:border-emerald-600 hover:text-emerald-400 transition-colors shadow-2xs">
        {d.presetTuna}
      </button>
      <button type="button" id="hfd-preset-porcine" class="px-3.5 py-1.5 rounded-lg text-xs font-medium bg-surface border border-hairline hover:border-emerald-600 hover:text-emerald-400 transition-colors shadow-2xs">
        {d.presetPorcine}
      </button>
      <button type="button" id="hfd-preset-collapse" class="px-3.5 py-1.5 rounded-lg text-xs font-medium bg-rose-950/40 text-rose-300 border border-rose-800/60 hover:bg-rose-900/50 transition-colors shadow-2xs">
        {d.presetCollapseHazard}
      </button>
    </div>
  </div>

  <!-- Interactive Grid: Controls & Live Telemetry -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-10">
    <!-- Controls Column (5 cols) -->
    <div class="lg:col-span-5 bg-surface-soft border border-hairline rounded-2xl p-6 flex flex-col justify-between">
      <div>
        <h3 class="text-base font-bold text-ink mb-1 flex items-center gap-2">
          <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
          </svg>
          {d.controlsTitle}
        </h3>
        <p class="text-xs text-muted mb-5 leading-relaxed">
          {d.controlsSub}
        </p>

        <!-- Matrix Dropdown -->
        <div class="mb-5">
          <label for="hfd-matrix-select" class="block text-xs font-bold text-ink uppercase tracking-wider mb-1.5">
            {d.matrixLabel}
          </label>
          <select id="hfd-matrix-select" class="w-full bg-surface border border-hairline text-ink text-xs rounded-xl p-3 focus:outline-none focus:ring-2 focus:ring-emerald-500">
            {matrices.map(m => (
              <option value={m.id}>
                {m.name} ({m.targetBiomaterial})
              </option>
            ))}
          </select>
          <p class="text-[11px] text-muted mt-1 leading-normal">
            {d.matrixHelp}
          </p>
        </div>

        <!-- Slider 1: RF Sintering Power -->
        <div class="mb-4">
          <div class="flex justify-between items-center text-xs mb-1">
            <span class="font-bold text-ink">{d.rfPowerLabel}</span>
            <span id="hfd-rf-power-val" class="font-mono text-emerald-400 font-bold">22.5 kW</span>
          </div>
          <input type="range" id="hfd-rf-power-slider" min="5.0" max="45.0" step="0.5" value="22.5" class="w-full h-1.5 bg-surface rounded-lg appearance-none cursor-pointer accent-emerald-500" />
          <p class="text-[11px] text-muted mt-0.5 leading-normal">{d.rfPowerHelp}</p>
        </div>

        <!-- Slider 2: Volumetric Sintering Target Temp -->
        <div class="mb-4">
          <div class="flex justify-between items-center text-xs mb-1">
            <span class="font-bold text-ink">{d.rfTempLabel}</span>
            <span id="hfd-rf-temp-val" class="font-mono text-emerald-400 font-bold">44.5 °C</span>
          </div>
          <input type="range" id="hfd-rf-temp-slider" min="35.0" max="58.0" step="0.5" value="44.5" class="w-full h-1.5 bg-surface rounded-lg appearance-none cursor-pointer accent-emerald-500" />
          <p class="text-[11px] text-muted mt-0.5 leading-normal">{d.rfTempHelp}</p>
        </div>

        <!-- Slider 3: Flash Vacuum Chamber Pressure -->
        <div class="mb-4">
          <div class="flex justify-between items-center text-xs mb-1">
            <span class="font-bold text-ink">{d.vacuumLabel}</span>
            <span id="hfd-vacuum-val" class="font-mono text-emerald-400 font-bold">1.2 mbar</span>
          </div>
          <input type="range" id="hfd-vacuum-slider" min="0.2" max="5.0" step="0.1" value="1.2" class="w-full h-1.5 bg-surface rounded-lg appearance-none cursor-pointer accent-emerald-500" />
          <p class="text-[11px] text-muted mt-0.5 leading-normal">{d.vacuumHelp}</p>
        </div>

        <!-- Slider 4: Liquid Nitrogen Cold-Plate Sink Temp -->
        <div class="mb-4">
          <div class="flex justify-between items-center text-xs mb-1">
            <span class="font-bold text-ink">{d.cryoTempLabel}</span>
            <span id="hfd-cryo-temp-val" class="font-mono text-emerald-400 font-bold">-100 °C</span>
          </div>
          <input type="range" id="hfd-cryo-temp-slider" min="-140" max="-60" step="5" value="-100" class="w-full h-1.5 bg-surface rounded-lg appearance-none cursor-pointer accent-emerald-500" />
          <p class="text-[11px] text-muted mt-0.5 leading-normal">{d.cryoTempHelp}</p>
        </div>

        <!-- Slider 5: Matrix Thickness -->
        <div class="mb-4">
          <div class="flex justify-between items-center text-xs mb-1">
            <span class="font-bold text-ink">{d.thicknessLabel}</span>
            <span id="hfd-thickness-val" class="font-mono text-emerald-400 font-bold">32 mm</span>
          </div>
          <input type="range" id="hfd-thickness-slider" min="10" max="65" step="1" value="32" class="w-full h-1.5 bg-surface rounded-lg appearance-none cursor-pointer accent-emerald-500" />
          <p class="text-[11px] text-muted mt-0.5 leading-normal">{d.thicknessHelp}</p>
        </div>

        <!-- Slider 6: Conveyor Speed -->
        <div class="mb-2">
          <div class="flex justify-between items-center text-xs mb-1">
            <span class="font-bold text-ink">{d.speedLabel}</span>
            <span id="hfd-speed-val" class="font-mono text-emerald-400 font-bold">0.65 m/min</span>
          </div>
          <input type="range" id="hfd-speed-slider" min="0.2" max="2.0" step="0.05" value="0.65" class="w-full h-1.5 bg-surface rounded-lg appearance-none cursor-pointer accent-emerald-500" />
          <p class="text-[11px] text-muted mt-0.5 leading-normal">{d.speedHelp}</p>
        </div>
      </div>
    </div>

    <!-- Live Telemetry Column (7 cols) -->
    <div class="lg:col-span-7 flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between mb-4">
          <div>
            <h3 class="text-base font-bold text-ink flex items-center gap-2">
              <span class="relative flex h-2.5 w-2.5">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
              </span>
              {d.telemetryTitle}
            </h3>
            <p class="text-xs text-muted mt-0.5">
              {d.telemetrySub}
            </p>
          </div>
          <span class="text-[10px] font-mono px-2 py-1 rounded bg-surface-soft border border-hairline text-muted">
            LIVE COMPUTE
          </span>
        </div>

        <!-- 6 Metrics Cards Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3.5 mb-5">
          <!-- Card 1: RF Penetration Depth -->
          <div class="p-3.5 rounded-xl bg-surface-soft border border-hairline">
            <span class="text-[11px] text-muted block mb-1 font-medium">{d.penetrationLabel}</span>
            <span id="hfd-out-penetration" class="text-lg font-mono font-bold text-emerald-400">280 mm</span>
            <span class="text-[10px] text-muted block mt-0.5 font-mono">dp &gt; 8× slab depth</span>
          </div>

          <!-- Card 2: Cryo Flash Freezing Rate -->
          <div class="p-3.5 rounded-xl bg-surface-soft border border-hairline">
            <span class="text-[11px] text-muted block mb-1 font-medium">{d.freezingRateLabel}</span>
            <span id="hfd-out-freezing-rate" class="text-lg font-mono font-bold text-cyan-400">52.0 °C/min</span>
            <span class="text-[10px] text-muted block mt-0.5 font-mono">Ultra-fast vitrification</span>
          </div>

          <!-- Card 3: Ice Crystal Nucleation Diameter -->
          <div class="p-3.5 rounded-xl bg-surface-soft border border-hairline">
            <span class="text-[11px] text-muted block mb-1 font-medium">{d.iceCrystalLabel}</span>
            <span id="hfd-out-crystal-diam" class="text-lg font-mono font-bold text-indigo-400">1.4 µm</span>
            <span class="text-[10px] text-muted block mt-0.5 font-mono">Zero pore shear rupture</span>
          </div>

          <!-- Card 4: Open Porosity Retention -->
          <div class="p-3.5 rounded-xl bg-surface-soft border border-hairline">
            <span class="text-[11px] text-muted block mb-1 font-medium">{d.porosityLabel}</span>
            <span id="hfd-out-porosity" class="text-lg font-mono font-bold text-emerald-400">88.5%</span>
            <span class="text-[10px] text-muted block mt-0.5 font-mono">Δpore &lt; 1.2%</span>
          </div>

          <!-- Card 5: Cell Adhesion & Protein Fidelity -->
          <div class="p-3.5 rounded-xl bg-surface-soft border border-hairline">
            <span class="text-[11px] text-muted block mb-1 font-medium">{d.cellAdhesionLabel}</span>
            <span id="hfd-out-cell-fidelity" class="text-lg font-mono font-bold text-emerald-400">99.4%</span>
            <span class="text-[10px] text-muted block mt-0.5 font-mono">Denaturation &lt; 0.4%</span>
          </div>

          <!-- Card 6: SEC Energy Consumption -->
          <div class="p-3.5 rounded-xl bg-surface-soft border border-hairline">
            <span class="text-[11px] text-muted block mb-1 font-medium">{d.secLabel}</span>
            <span id="hfd-out-sec" class="text-lg font-mono font-bold text-amber-400">0.46 kWh/kg</span>
            <span class="text-[10px] text-muted block mt-0.5 font-mono">&gt;68% energy savings</span>
          </div>
        </div>

        <!-- Throughput Banner -->
        <div class="p-3.5 rounded-xl bg-surface-soft border border-hairline flex items-center justify-between mb-5">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            <span class="text-xs font-bold text-ink">{d.throughputLabel}</span>
          </div>
          <span id="hfd-out-throughput" class="text-sm font-mono font-extrabold text-ink">380 kg/h</span>
        </div>

        <!-- Dynamic Safety Verdict Panel -->
        <div id="hfd-verdict-box" class="p-4 rounded-xl bg-emerald-950/30 border border-emerald-800/60 transition-all">
          <div class="flex items-center gap-2 mb-1.5">
            <span id="hfd-verdict-badge" class="px-2.5 py-0.5 rounded-md text-xs font-bold uppercase tracking-wider bg-emerald-900 text-emerald-200 border border-emerald-700">
              OPTIMAL SOLIDIFICATION &amp; HIGH FIDELITY
            </span>
          </div>
          <p id="hfd-verdict-text" class="text-xs text-emerald-100 leading-relaxed font-sans">
            The 27.12 MHz RF volumetric power achieves rapid, homogeneous molecular sintering without surface scorching. Ultra-fast sublimative flash cooling drives the matrix past the glass transition at &gt;50 °C/min, keeping micro-ice crystals under 1.5 µm and preserving 99.4% of cellular adhesion ligands and interconnected 3D perfusion porosity with full FDA 21 CFR § 170 compliance.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Dual Schematic & Diagnostic Canvas Visualization -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-10">
    <!-- SVG Schematic 1: Continuous HFD-VCS System Skid Architecture -->
    <div class="bg-surface-soft border border-hairline rounded-2xl p-6 flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between mb-3">
          <h3 class="text-sm font-bold text-ink">{d.diagramTitle}</h3>
          <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-surface border border-hairline text-muted">27.12 MHz + CRYOGENIC</span>
        </div>
        <p class="text-xs text-muted mb-4">{d.diagramSub}</p>

        <div class="w-full bg-surface/80 rounded-xl p-3 border border-hairline/80 overflow-hidden">
          <svg viewBox="0 0 540 250" class="w-full h-auto" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="rfFieldGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#10b981" stop-opacity="0.35"/>
                <stop offset="50%" stop-color="#059669" stop-opacity="0.1"/>
                <stop offset="100%" stop-color="#10b981" stop-opacity="0.35"/>
              </linearGradient>
              <linearGradient id="cryoGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#0284c7" stop-opacity="0.35"/>
                <stop offset="100%" stop-color="#0369a1" stop-opacity="0.15"/>
              </linearGradient>
            </defs>

            <!-- Conveyor Line -->
            <rect x="20" y="145" width="500" height="8" rx="4" fill="#334155" />
            <circle cx="28" cy="149" r="6" fill="#64748b" />
            <circle cx="512" cy="149" r="6" fill="#64748b" />

            <!-- RF Sintering Enclosure -->
            <rect x="40" y="30" width="160" height="155" rx="8" fill="#1e293b" stroke="#10b981" stroke-width="1.5" stroke-dasharray="4,2"/>
            <text x="120" y="48" fill="#34d399" font-size="10" font-family="monospace" text-anchor="middle" font-weight="bold">27.12 MHz RF RESONATOR</text>

            <!-- RF Top Electrode Plate -->
            <rect x="60" y="60" width="120" height="10" rx="3" fill="#10b981" />
            <!-- RF Bottom Electrode Plate -->
            <rect x="60" y="130" width="120" height="10" rx="3" fill="#10b981" />
            <!-- RF Dielectric Field Rays -->
            <rect x="65" y="70" width="110" height="60" fill="url(#rfFieldGrad)" />
            <line x1="85" y1="70" x2="85" y2="130" stroke="#34d399" stroke-width="1" stroke-dasharray="2,2"/>
            <line x1="120" y1="70" x2="120" y2="130" stroke="#34d399" stroke-width="1" stroke-dasharray="2,2"/>
            <line x1="155" y1="70" x2="155" y2="130" stroke="#34d399" stroke-width="1" stroke-dasharray="2,2"/>
            <text x="120" y="102" fill="#a7f3d0" font-size="9" font-family="monospace" text-anchor="middle">Volumetric Pv (W/m³)</text>

            <!-- Vacuum Transition Airlock -->
            <rect x="210" y="45" width="50" height="125" rx="6" fill="#0f172a" stroke="#64748b" stroke-width="1.2"/>
            <text x="235" y="85" fill="#94a3b8" font-size="8" font-family="monospace" text-anchor="middle">VACUUM</text>
            <text x="235" y="98" fill="#94a3b8" font-size="8" font-family="monospace" text-anchor="middle">AIRLOCK</text>
            <text x="235" y="125" fill="#38bdf8" font-size="8" font-family="monospace" text-anchor="middle">1.2 mbar</text>

            <!-- Deep Vacuum Cryo Vitrification Chamber -->
            <rect x="270" y="30" width="160" height="155" rx="8" fill="#0c4a6e" stroke="#38bdf8" stroke-width="1.5"/>
            <text x="350" y="48" fill="#7dd3fc" font-size="10" font-family="monospace" text-anchor="middle" font-weight="bold">LN2 CRYO-VITRIFICATION</text>
            <rect x="285" y="60" width="130" height="80" rx="4" fill="url(#cryoGrad)" />
            <!-- Cryo Cold Plate Heat Sink -->
            <rect x="285" y="130" width="130" height="10" rx="3" fill="#0284c7" />
            <text x="350" y="100" fill="#bae6fd" font-size="9" font-family="monospace" text-anchor="middle">Cold Plate: -100 °C</text>
            <text x="350" y="115" fill="#e0f2fe" font-size="8" font-family="monospace" text-anchor="middle">dT/dt &gt; 50 °C/min</text>

            <!-- Matrix Slabs on Conveyor -->
            <!-- Slab 1 Entering RF -->
            <rect x="100" y="112" width="40" height="16" rx="2" fill="#f59e0b" stroke="#b45309" stroke-width="1"/>
            <text x="120" y="124" fill="#451a03" font-size="8" font-weight="bold" text-anchor="middle">Slab</text>

            <!-- Slab 2 in Cryo Chamber -->
            <rect x="330" y="112" width="40" height="16" rx="2" fill="#38bdf8" stroke="#0284c7" stroke-width="1"/>
            <text x="350" y="124" fill="#0c4a6e" font-size="8" font-weight="bold" text-anchor="middle">Vitrified</text>

            <!-- Laser Triangulation Matrix Quality Sensor -->
            <rect x="445" y="80" width="55" height="35" rx="4" fill="#1e293b" stroke="#f43f5e" stroke-width="1.2"/>
            <line x1="472" y1="115" x2="472" y2="145" stroke="#f43f5e" stroke-width="1.5" stroke-dasharray="2,2"/>
            <text x="472" y="98" fill="#fda4af" font-size="8" font-family="monospace" text-anchor="middle">LASER QC</text>
            <text x="472" y="108" fill="#f43f5e" font-size="7" font-family="monospace" text-anchor="middle">POROSITY</text>

            <!-- Output Scaffold Matrix Slab -->
            <rect x="455" y="129" width="40" height="16" rx="2" fill="#10b981" stroke="#047857" stroke-width="1"/>
            <text x="475" y="141" fill="#022c22" font-size="8" font-weight="bold" text-anchor="middle">Ready</text>

            <!-- Bottom Pipeline Annotations -->
            <text x="270" y="215" fill="#94a3b8" font-size="9" font-family="sans-serif" text-anchor="middle">
              Continuous Feedstock Conveyor &bull; Zero Consumable Toxic Cross-Linkers &bull; 3-A Sanitary 74-07
            </text>
          </svg>
        </div>
      </div>
    </div>

    <!-- Diagnostic Canvas 2: Ice Crystal Size vs Pore Integrity Chart -->
    <div class="bg-surface-soft border border-hairline rounded-2xl p-6 flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between mb-3">
          <h3 class="text-sm font-bold text-ink">{d.chartTitle}</h3>
          <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-surface border border-hairline text-cyan-400">VITRIFICATION KINETICS</span>
        </div>
        <p class="text-xs text-muted mb-4">{d.chartSub}</p>

        <div class="w-full bg-surface/80 rounded-xl p-4 border border-hairline/80 flex flex-col justify-center">
          <div class="h-44 flex items-end gap-5 justify-around px-4 border-b border-l border-hairline pb-2">
            <!-- Col 1: Traditional Blast Freezer (-30C) -->
            <div class="flex flex-col items-center gap-1.5 w-16">
              <span class="text-[10px] font-mono text-rose-400 font-bold">85 µm</span>
              <div class="w-full bg-rose-900/60 border border-rose-500 rounded-t-lg h-36 flex items-center justify-center">
                <span class="text-[9px] text-rose-200 rotate-90 whitespace-nowrap font-mono">Damaging</span>
              </div>
              <span class="text-[9px] text-muted text-center font-sans">Slow Blast (-30°C)</span>
            </div>

            <!-- Col 2: High Airflow Cryo Tunnel (-50C) -->
            <div class="flex flex-col items-center gap-1.5 w-16">
              <span class="text-[10px] font-mono text-amber-400 font-bold">32 µm</span>
              <div class="w-full bg-amber-900/60 border border-amber-500 rounded-t-lg h-24 flex items-center justify-center">
                <span class="text-[9px] text-amber-200 rotate-90 whitespace-nowrap font-mono">Moderate</span>
              </div>
              <span class="text-[9px] text-muted text-center font-sans">Cryo Tunnel</span>
            </div>

            <!-- Col 3: HFD-VCS Flash Vitrification (Current Simulation) -->
            <div class="flex flex-col items-center gap-1.5 w-16">
              <span id="hfd-chart-crystal-val" class="text-[10px] font-mono text-emerald-400 font-bold">1.4 µm</span>
              <div id="hfd-chart-crystal-bar" class="w-full bg-emerald-500/80 border border-emerald-300 rounded-t-lg h-6 flex items-center justify-center transition-all duration-300 shadow-sm shadow-emerald-500/20">
              </div>
              <span class="text-[9px] text-emerald-400 font-bold text-center font-sans">HFD-VCS Flash</span>
            </div>
          </div>

          <div class="mt-4 grid grid-cols-2 gap-3 text-xs">
            <div class="p-2.5 rounded-lg bg-surface border border-hairline">
              <span class="text-[11px] text-muted block mb-0.5">Slow Freezing Risk:</span>
              <span class="text-rose-400 font-semibold text-[11px]">Ice puncture shears cell walls &amp; collapses matrix porosity (&gt;45% syneresis)</span>
            </div>
            <div class="p-2.5 rounded-lg bg-surface border border-hairline">
              <span class="text-[11px] text-muted block mb-0.5">HFD-VCS Benefit:</span>
              <span class="text-emerald-400 font-semibold text-[11px]">Sub-micron vitrified crystals preserve 99.4% pore channels for dynamic cell perfusion</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Engineering Principles & Math Formulations -->
  <div class="bg-surface-soft border border-hairline rounded-2xl p-6 sm:p-8 mb-10">
    <h3 class="text-base font-bold text-ink mb-1">{d.principlesTitle}</h3>
    <p class="text-xs text-muted mb-6">{d.principlesSub}</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {hfdData.engineeringPrinciples.map(ep => (
        <div class="p-4 rounded-xl bg-surface border border-hairline flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-2 mb-2">
              <span class="text-xs font-bold text-ink">{ep.parameter}</span>
            </div>
            <div class="p-2 rounded-lg bg-surface-soft font-mono text-xs text-emerald-400 mb-3 border border-hairline">
              {ep.equation}
            </div>
            <p class="text-xs text-muted leading-relaxed">
              {ep.significance}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Comparative Technology Benchmark Matrix -->
  <div class="bg-surface-soft border border-hairline rounded-2xl p-6 sm:p-8 mb-10">
    <h3 class="text-base font-bold text-ink mb-1">{d.compTitle}</h3>
    <p class="text-xs text-muted mb-6">{d.compSub}</p>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs border-collapse">
        <thead>
          <tr class="border-b border-hairline bg-surface/50 text-muted uppercase tracking-wider text-[10px]">
            <th class="p-3">Processing Method</th>
            <th class="p-3">Cross-Linking Mechanism</th>
            <th class="p-3">Ice Crystal Diameter</th>
            <th class="p-3">Pore Retention</th>
            <th class="p-3">Chemical Residues</th>
            <th class="p-3">Energy (kWh/kg)</th>
            <th class="p-3">Regulatory Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline">
          <tr class="bg-emerald-950/20 font-medium">
            <td class="p-3 font-bold text-emerald-400">Continuous HFD-VCS (This System)</td>
            <td class="p-3 text-ink">27.12 MHz RF Volumetric Dipolar Friction</td>
            <td class="p-3 font-mono text-emerald-400">&lt; 1.5 µm (Vitrified)</td>
            <td class="p-3 font-mono text-emerald-400">88 – 95%</td>
            <td class="p-3 text-emerald-400 font-bold">0.0% (Zero Consumables)</td>
            <td class="p-3 font-mono text-emerald-400">0.38 – 0.52</td>
            <td class="p-3 text-emerald-400">FDA 21 CFR § 170 / FSMA cGMP</td>
          </tr>
          <tr>
            <td class="p-3 font-semibold text-ink">Chemical Glutaraldehyde / Genipin</td>
            <td class="p-3 text-muted">Covalent Dialdehyde Cross-Linking</td>
            <td class="p-3 font-mono text-muted">N/A (Liquid phase)</td>
            <td class="p-3 font-mono text-muted">60 – 75% (Collapse)</td>
            <td class="p-3 text-rose-400 font-bold">Severe Aldehyde Leaching</td>
            <td class="p-3 font-mono text-muted">0.85 (Slow agitation)</td>
            <td class="p-3 text-rose-400">Prohibited in Food Contact Tissue</td>
          </tr>
          <tr>
            <td class="p-3 font-semibold text-ink">High-Temp Thermal Steaming (&gt;85°C)</td>
            <td class="p-3 text-muted">Thermal Denaturation &amp; Coagulation</td>
            <td class="p-3 font-mono text-muted">N/A (Heat set)</td>
            <td class="p-3 font-mono text-rose-400">40 – 55% (Pore sealing)</td>
            <td class="p-3 text-ink">Zero Chemicals</td>
            <td class="p-3 font-mono text-amber-400">1.25 – 1.80</td>
            <td class="p-3 text-amber-400">Permitted (Destroys Seed Cells)</td>
          </tr>
          <tr>
            <td class="p-3 font-semibold text-ink">Batch Lyophilization (Freeze-Drying)</td>
            <td class="p-3 text-muted">Shelf Sublimation Ice Templating</td>
            <td class="p-3 font-mono text-amber-400">15 – 35 µm</td>
            <td class="p-3 font-mono text-amber-400">70 – 82%</td>
            <td class="p-3 text-ink">Zero Chemicals</td>
            <td class="p-3 font-mono text-rose-400">2.40 – 3.80</td>
            <td class="p-3 text-amber-400">Permitted (36-hr Batch Bottleneck)</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Regulatory Compliance Matrix -->
  <div class="bg-surface-soft border border-hairline rounded-2xl p-6 sm:p-8">
    <h3 class="text-base font-bold text-ink mb-1">{d.regTitle}</h3>
    <p class="text-xs text-muted mb-6">{d.regSub}</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {hfdData.regulatoryComplianceMatrix.map(rc => (
        <div class="p-4 rounded-xl bg-surface border border-hairline flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-2 mb-1.5">
              <span class="text-xs font-bold text-emerald-400 font-mono">{rc.standard}</span>
              <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-950 text-emerald-300 border border-emerald-800">
                CERTIFIED
              </span>
            </div>
            <div class="text-xs font-semibold text-ink mb-2">{rc.mandate}</div>
            <p class="text-xs text-muted leading-relaxed">
              {rc.conformanceMethod}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<script is:inline define:vars={{ matrices }}>
  function initHfdVcsModeler() {
    // DOM Elements
    const matrixSelect = document.getElementById('hfd-matrix-select');
    const rfPowerSlider = document.getElementById('hfd-rf-power-slider');
    const rfPowerVal = document.getElementById('hfd-rf-power-val');
    const rfTempSlider = document.getElementById('hfd-rf-temp-slider');
    const rfTempVal = document.getElementById('hfd-rf-temp-val');
    const vacuumSlider = document.getElementById('hfd-vacuum-slider');
    const vacuumVal = document.getElementById('hfd-vacuum-val');
    const cryoTempSlider = document.getElementById('hfd-cryo-temp-slider');
    const cryoTempVal = document.getElementById('hfd-cryo-temp-val');
    const thicknessSlider = document.getElementById('hfd-thickness-slider');
    const thicknessVal = document.getElementById('hfd-thickness-val');
    const speedSlider = document.getElementById('hfd-speed-slider');
    const speedVal = document.getElementById('hfd-speed-val');

    // Outputs
    const outPenetration = document.getElementById('hfd-out-penetration');
    const outFreezingRate = document.getElementById('hfd-out-freezing-rate');
    const outCrystalDiam = document.getElementById('hfd-out-crystal-diam');
    const outPorosity = document.getElementById('hfd-out-porosity');
    const outCellFidelity = document.getElementById('hfd-out-cell-fidelity');
    const outSec = document.getElementById('hfd-out-sec');
    const outThroughput = document.getElementById('hfd-out-throughput');

    // Chart & Verdict
    const chartCrystalVal = document.getElementById('hfd-chart-crystal-val');
    const chartCrystalBar = document.getElementById('hfd-chart-crystal-bar');
    const verdictBox = document.getElementById('hfd-verdict-box');
    const verdictBadge = document.getElementById('hfd-verdict-badge');
    const verdictText = document.getElementById('hfd-verdict-text');

    if (!matrixSelect || !rfPowerSlider) return;

    function getActiveMatrix() {
      const id = matrixSelect.value;
      return matrices.find(m => m.id === id) || matrices[0];
    }

    function calculateModel() {
      const m = getActiveMatrix();
      const rfKw = parseFloat(rfPowerSlider.value);
      const rfTemp = parseFloat(rfTempSlider.value);
      const vacMbar = parseFloat(vacuumSlider.value);
      const cryoT = parseFloat(cryoTempSlider.value);
      const thickMm = parseFloat(thicknessSlider.value);
      const speed = parseFloat(speedSlider.value);

      // 1. Text Labels
      rfPowerVal.textContent = rfKw.toFixed(1) + ' kW';
      rfTempVal.textContent = rfTemp.toFixed(1) + ' °C';
      vacuumVal.textContent = vacMbar.toFixed(1) + ' mbar';
      cryoTempVal.textContent = cryoT.toFixed(0) + ' °C';
      thicknessVal.textContent = thickMm.toFixed(0) + ' mm';
      speedVal.textContent = speed.toFixed(2) + ' m/min';

      // 2. Physical Equations
      // Penetration depth dp in mm: dp = c / (2pi * f * sqrt(2*e'))
      // Scales with matrix loss factor and inversely with moisture concentration
      const lossFactor = m.initialDielectricLossFactor;
      const dp = Math.max(80, Math.min(380, Math.round(m.penetrationDepthMm * (22.5 / rfKw)**0.15 * (30 / thickMm)**0.1)));

      // Freezing Rate: driven by vacuum flash sublimation delta + LN2 temperature gradient
      // dt/dt = (T_sinter - T_cryo) * (k_sub / vacMbar) * speed
      const tempDelta = rfTemp - cryoT;
      const flashRate = Math.max(10, Math.min(95, ((tempDelta / 2.5) * (1.2 / vacMbar)**0.65 * (speed / 0.65)**0.4).toFixed(1)));

      // Mean Ice Crystal Diameter (µm): d_crystal = C * (dT/dt)^(-0.42) * (vacMbar / 1.0)^0.3
      const crystalDiam = Math.max(0.4, Math.min(18.5, (m.iceCrystalDiameterMicrons * (50.0 / flashRate)**0.42 * (vacMbar / 1.2)**0.3).toFixed(1)));

      // Porosity Retention: intact unless crystalDiam > 8µm or rfTemp > 50°C
      let poreDamage = 0;
      if (crystalDiam > 5.0) {
        poreDamage += (crystalDiam - 5.0) * 2.8;
      }
      if (rfTemp > 48.0) {
        poreDamage += (rfTemp - 48.0) * 3.5;
      }
      const porosity = Math.max(45.0, Math.min(96.0, (m.scaffoldPorosityPct - poreDamage).toFixed(1)));

      // Cell Adhesion & Protein Fidelity:
      let cellDamage = 0;
      if (rfTemp > 46.0) {
        cellDamage += (rfTemp - 46.0) * 4.2;
      }
      if (crystalDiam > 4.0) {
        cellDamage += (crystalDiam - 4.0) * 3.1;
      }
      const cellFidelity = Math.max(25.0, Math.min(99.9, (m.cellAdhesionIntegrityPct - cellDamage).toFixed(1)));

      // Throughput: Q = width(0.6m) * thickness * speed * bulk_density(1050 kg/m3) * 60
      const throughputKgH = Math.round(0.6 * (thickMm / 1000) * speed * 1050 * 60);

      // Specific Energy SEC (kWh/kg): (rfKw + vacKw + cryoKw) / (throughput / 1000)
      const vacKw = 4.5 * (1.5 / vacMbar)**0.4;
      const cryoKw = 8.0 * (Math.abs(cryoT) / 100)**1.2;
      const sec = Math.max(0.25, Math.min(1.85, ((rfKw + vacKw + cryoKw) / (throughputKgH || 1)).toFixed(2)));

      // DOM Updates
      outPenetration.textContent = dp + ' mm';
      outFreezingRate.textContent = flashRate + ' °C/min';
      outCrystalDiam.textContent = crystalDiam + ' µm';
      outPorosity.textContent = porosity + '%';
      outCellFidelity.textContent = cellFidelity + '%';
      outSec.textContent = sec + ' kWh/kg';
      outThroughput.textContent = throughputKgH + ' kg/h';

      // Chart Bar Height Update
      if (chartCrystalVal && chartCrystalBar) {
        chartCrystalVal.textContent = crystalDiam + ' µm';
        // Height proportional to crystal size (1.4um ~ 12px, 15um ~ 100px)
        const barPx = Math.min(130, Math.max(8, Math.round(crystalDiam * 8)));
        chartCrystalBar.style.height = barPx + 'px';
      }

      // Verdict Logic
      if (rfTemp > 52.0) {
        verdictBox.className = 'p-4 rounded-xl bg-rose-950/40 border border-rose-800 transition-all';
        verdictBadge.className = 'px-2.5 py-0.5 rounded-md text-xs font-bold uppercase tracking-wider bg-rose-900 text-rose-200 border border-rose-700';
        verdictBadge.textContent = 'THERMAL COLLAPSE HAZARD: EXCEEDS CELLULAR CEILING (>52°C)';
        verdictText.textContent = `CRITICAL WARNING: At ${rfTemp}°C, thermal coagulation of actin-myosin proteins and cell lysis occur immediately. Structural cell fidelity dropped to ${cellFidelity}%. Lower RF generator power or increase line conveyor speed to maintain core sintering below 48°C.`;
      } else if (crystalDiam > 6.0) {
        verdictBox.className = 'p-4 rounded-xl bg-amber-950/40 border border-amber-800 transition-all';
        verdictBadge.className = 'px-2.5 py-0.5 rounded-md text-xs font-bold uppercase tracking-wider bg-amber-900 text-amber-200 border border-amber-700';
        verdictBadge.textContent = 'ICE SHEAR WARNING: CRYSTAL GROWTH EXCEEDS 6 µm';
        verdictText.textContent = `CAUTION: Flash freezing rate (${flashRate} °C/min) is insufficient, permitting extra-cellular ice crystals to grow to ${crystalDiam} µm. This puncturing tears open scaffold micropores (porosity reduced to ${porosity}%). Increase chamber vacuum (< 1.5 mbar) or lower cold-plate temperature to accelerate vitrification.`;
      } else {
        verdictBox.className = 'p-4 rounded-xl bg-emerald-950/30 border border-emerald-800/60 transition-all';
        verdictBadge.className = 'px-2.5 py-0.5 rounded-md text-xs font-bold uppercase tracking-wider bg-emerald-900 text-emerald-200 border border-emerald-700';
        verdictBadge.textContent = 'OPTIMAL SOLIDIFICATION & FDA/USDA COMPLIANT';
        verdictText.textContent = `CONFIRMED: The 27.12 MHz RF volumetric power achieves rapid, homogeneous molecular sintering without surface scorching. Ultra-fast sublimative flash cooling drives the matrix past the glass transition at ${flashRate} °C/min, keeping micro-ice crystals under ${crystalDiam} µm and preserving ${cellFidelity}% of cellular adhesion ligands and interconnected 3D perfusion porosity with full FDA 21 CFR § 170 compliance.`;
      }
    }

    // Event Listeners
    matrixSelect.addEventListener('change', () => {
      const m = getActiveMatrix();
      rfPowerSlider.value = m.recommendedRfPowerKw;
      rfTempSlider.value = m.rfSinteringTempCelsius;
      vacuumSlider.value = m.vacuumCryoPressureMbar;
      thicknessSlider.value = m.matrixThicknessMm;
      speedSlider.value = m.recommendedConveyorSpeedMPerMin;
      calculateModel();
    });

    [rfPowerSlider, rfTempSlider, vacuumSlider, cryoTempSlider, thicknessSlider, speedSlider].forEach(slider => {
      slider.addEventListener('input', calculateModel);
    });

    // Preset Buttons
    document.getElementById('hfd-preset-bovine')?.addEventListener('click', () => {
      matrixSelect.value = 'cultivated_bovine_myoblast_scaffold';
      rfPowerSlider.value = 22.5;
      rfTempSlider.value = 44.5;
      vacuumSlider.value = 1.2;
      cryoTempSlider.value = -100;
      thicknessSlider.value = 32;
      speedSlider.value = 0.65;
      calculateModel();
    });

    document.getElementById('hfd-preset-avian')?.addEventListener('click', () => {
      matrixSelect.value = 'cultivated_avian_pectoral_scaffold';
      rfPowerSlider.value = 18.0;
      rfTempSlider.value = 42.0;
      vacuumSlider.value = 0.8;
      cryoTempSlider.value = -110;
      thicknessSlider.value = 25;
      speedSlider.value = 0.80;
      calculateModel();
    });

    document.getElementById('hfd-preset-tuna')?.addEventListener('click', () => {
      matrixSelect.value = 'cultivated_bluefin_tuna_myotome';
      rfPowerSlider.value = 15.5;
      rfTempSlider.value = 39.5;
      vacuumSlider.value = 0.6;
      cryoTempSlider.value = -120;
      thicknessSlider.value = 18;
      speedSlider.value = 0.95;
      calculateModel();
    });

    document.getElementById('hfd-preset-porcine')?.addEventListener('click', () => {
      matrixSelect.value = 'cultivated_porcine_myofibrillar_matrix';
      rfPowerSlider.value = 26.0;
      rfTempSlider.value = 46.0;
      vacuumSlider.value = 1.5;
      cryoTempSlider.value = -95;
      thicknessSlider.value = 40;
      speedSlider.value = 0.55;
      calculateModel();
    });

    document.getElementById('hfd-preset-collapse')?.addEventListener('click', () => {
      matrixSelect.value = 'cultivated_bovine_myoblast_scaffold';
      rfPowerSlider.value = 42.0;
      rfTempSlider.value = 56.5;
      vacuumSlider.value = 4.5;
      cryoTempSlider.value = -60;
      thicknessSlider.value = 55;
      speedSlider.value = 0.25;
      calculateModel();
    });

    // Initial run
    calculateModel();
  }

  // Run on page load & Astro view transitions
  initHfdVcsModeler();
  document.addEventListener('astro:page-load', initHfdVcsModeler);
</script>
