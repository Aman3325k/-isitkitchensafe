<script is:inline define:vars={{ scfxDataJson: JSON.stringify(scfxData) }}>
  (function() {
    const data = JSON.parse(scfxDataJson);

    // Elements
    const inputSystem = document.getElementById('input-system');
    const inputFeedstock = document.getElementById('input-feedstock');
    const inputPressure = document.getElementById('input-pressure');
    const inputTemp = document.getElementById('input-temp');
    const inputCo2Dose = document.getElementById('input-co2-dose');
    const inputScrewSpeed = document.getElementById('input-screw-speed');
    const inputMoisture = document.getElementById('input-moisture');
    const inputDpdt = document.getElementById('input-dpdt');
    const inputRecovery = document.getElementById('input-recovery');

    const displayPressure = document.getElementById('display-pressure');
    const displayTemp = document.getElementById('display-temp');
    const displayCo2Dose = document.getElementById('display-co2-dose');
    const displayScrewSpeed = document.getElementById('display-screw-speed');
    const displayMoisture = document.getElementById('display-moisture');
    const displayDpdt = document.getElementById('display-dpdt');

    const resExpansion = document.getElementById('res-expansion');
    const resCellDensity = document.getElementById('res-cell-density');
    const resPoreDiameter = document.getElementById('res-pore-diameter');
    const resBioactivity = document.getElementById('res-bioactivity');
    const resSme = document.getElementById('res-sme');
    const resViscosity = document.getElementById('res-viscosity');
    const resVoid = document.getElementById('res-void');

    const barExpansion = document.getElementById('bar-expansion');
    const barCellDensity = document.getElementById('bar-cell-density');
    const barPoreDiameter = document.getElementById('bar-pore-diameter');
    const barBioactivity = document.getElementById('bar-bioactivity');

    const statusCard = document.getElementById('status-card');
    const statusBadge = document.getElementById('status-badge');
    const statusDesc = document.getElementById('status-desc');

    function calculate() {
      const p = parseFloat(inputPressure.value);
      const t = parseFloat(inputTemp.value);
      const dose = parseFloat(inputCo2Dose.value);
      const rpm = parseFloat(inputScrewSpeed.value);
      const moisture = parseFloat(inputMoisture.value);
      const dpdt = parseFloat(inputDpdt.value);
      const recovery = inputRecovery.checked;

      // Update Slider Displays
      displayPressure.textContent = `${p} bar`;
      displayTemp.textContent = `${t} °C`;
      displayCo2Dose.textContent = `${dose.toFixed(1)} wt%`;
      displayScrewSpeed.textContent = `${rpm} RPM`;
      displayMoisture.textContent = `${moisture.toFixed(1)} %`;
      displayDpdt.textContent = `${dpdt.toFixed(1)} GPa/s`;

      const feedstock = data.bioproductFeedstocks.find(f => f.id === inputFeedstock.value) || data.bioproductFeedstocks[0];
      const system = data.systemArchitectures.find(s => s.id === inputSystem.value) || data.systemArchitectures[0];

      // 1. Viscosity reduction via scCO2 plasticization
      // Viscosity reduction scales with dissolved CO2 and temperature
      const plasticizationFactor = Math.min(78, (dose * 18.5) + ((t - 40) * 0.22) + ((p - 80) * 0.08));
      const finalViscosity = Math.max(45, feedstock.initialViscosityPaS * (1 - plasticizationFactor / 100));

      // 2. Sectional Expansion Ratio (SEI / ER)
      // Expansion increases with CO2 dose & pressure up to an optimal ceiling, drops if overheated (>95°C) or starved (<0.8%)
      let expansion = 2.0 + (dose * 1.5) + ((p - 80) * 0.012) + ((dpdt - 1.0) * 0.45);
      if (t > 90) {
        // Overheat causes cell rupture & collapse
        expansion -= (t - 90) * 0.08;
      }
      if (moisture < 18) {
        expansion -= (18 - moisture) * 0.15;
      }
      expansion = Math.max(1.8, Math.min(7.5, expansion));

      // 3. Cell Density (cells/cm³)
      // Homogeneous nucleation driven by (P_scCO2 - P_sat) and dpdt
      const logDensity = 5.0 + ((p - 80) / 200) * 2.2 + ((dpdt - 1.0) / 4.0) * 1.2 - (t > 95 ? (t - 95) * 0.04 : 0);
      const cellDensityVal = Math.pow(10, Math.max(4.2, Math.min(8.2, logDensity)));

      // 4. Mean Micro-Pore Diameter (microns)
      // High cell density + high expansion creates uniform micro-cells (20-60 µm); low cell density causes coarse cells (>300 µm)
      const voidFraction = Math.max(50, Math.min(88, 55 + (expansion - 2.0) * 6.0));
      let poreDiameter = Math.pow((6 * (voidFraction / 100)) / (Math.PI * cellDensityVal), 1/3) * 10000;
      if (poreDiameter < 22) poreDiameter = 22;
      if (poreDiameter > 520) poreDiameter = 520;

      // 5. Retained Bioactivity (%)
      // Thermally sensitive; drops above feedstock.thermalSensitivityThresholdCelsius
      let bioactivity = 99.5;
      if (t > feedstock.thermalSensitivityThresholdCelsius) {
        const excessHeat = t - feedstock.thermalSensitivityThresholdCelsius;
        bioactivity -= Math.pow(excessHeat, 1.35) * 1.2;
      }
      // High screw shear can cause minor degradation
      if (rpm > 350) {
        bioactivity -= (rpm - 350) * 0.02;
      }
      bioactivity = Math.max(38.0, Math.min(99.6, bioactivity));

      // 6. Specific Mechanical Energy (SME, Wh/kg)
      // SME = (Torque * RPM) / Throughput; reduced by plasticization
      const baseSme = system.specificMechanicalEnergyWhPerKg;
      let smeVal = baseSme * (rpm / 260) * (1 - plasticizationFactor / 180);
      if (moisture < 20) smeVal += (20 - moisture) * 2.5;
      smeVal = Math.max(32, Math.min(185, smeVal));

      // Update DOM
      resExpansion.textContent = `${expansion.toFixed(1)}x`;
      resCellDensity.textContent = cellDensityVal >= 1e6 ? `${(cellDensityVal / 1e6).toFixed(1)} × 10⁶` : `${(cellDensityVal / 1e3).toFixed(0)} × 10³`;
      resPoreDiameter.textContent = `${poreDiameter.toFixed(1)} µm`;
      resBioactivity.textContent = `${bioactivity.toFixed(1)}%`;
      resSme.textContent = `${smeVal.toFixed(1)} Wh/kg`;
      resViscosity.textContent = `${plasticizationFactor.toFixed(1)}%`;
      resVoid.textContent = `${voidFraction.toFixed(1)}%`;

      barExpansion.style.width = `${Math.min(100, (expansion / 7.2) * 100)}%`;
      barCellDensity.style.width = `${Math.min(100, (logDensity / 8.2) * 100)}%`;
      barPoreDiameter.style.width = `${Math.min(100, Math.max(15, 100 - (poreDiameter / 500) * 100))}%`;
      barBioactivity.style.width = `${Math.min(100, bioactivity)}%`;

      // Status Assessment
      if (t > 95 || bioactivity < 75.0) {
        statusCard.className = "p-4 rounded-2xl border border-rose-800/50 bg-rose-950/25 space-y-2 transition-all";
        statusBadge.className = "px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-rose-900/60 text-rose-300 border border-rose-700/50";
        statusBadge.textContent = "THERMAL SCORCH & VOLATILE BIOACTIVE DEGRADATION HAZARD";
        statusDesc.textContent = `Melt temperature (${t}°C) exceeds thermal stability thresholds for ${feedstock.name}. Active bioactives are denaturing rapidly (retention: ${bioactivity.toFixed(1)}%), and bubble walls are rupturing into irregular, coarse macro-pores (${poreDiameter.toFixed(0)} µm) with Maillard off-flavors. Immediate barrel cooling and scCO2 pressure increase required.`;
      } else if (dose < 0.8 || p < 110) {
        statusCard.className = "p-4 rounded-2xl border border-amber-800/50 bg-amber-950/25 space-y-2 transition-all";
        statusBadge.className = "px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-amber-900/60 text-amber-300 border border-amber-700/50";
        statusBadge.textContent = "INSUFFICIENT scCO2 DOSING & HIGH SME ENERGY HAZARD";
        statusDesc.textContent = `Low scCO2 dosing (${dose.toFixed(1)} wt%) or injection pressure (${p} bar) provides inadequate molecular plasticization. The dough remains viscous, driving high motor load (SME: ${smeVal.toFixed(1)} Wh/kg) with limited micro-cellular expansion (${expansion.toFixed(1)}x). Increase scCO2 injection to ≥1.5 wt%.`;
      } else {
        statusCard.className = "p-4 rounded-2xl border border-emerald-500/30 bg-emerald-950/20 space-y-2 transition-all";
        statusBadge.className = "px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-emerald-900/60 text-emerald-300 border border-emerald-700/50";
        statusBadge.textContent = "OPTIMAL MICRO-CELLULAR BIOACTIVE SUPERCRITICAL EXTRUSION";
        statusDesc.textContent = `The process operates within optimal supercritical dissolution and explosive micro-cellular nucleation regimes. Rapid die decompression (dP/dt = ${dpdt.toFixed(1)} GPa/s) yields uniform closed-cell micro-pores (${poreDiameter.toFixed(1)} µm) with smooth texture. Low melt temperature (${t}°C) preserves ${bioactivity.toFixed(1)}% of bioactive integrity under 3-A Sanitary Standards 45-03 & 74-07.`;
      }
    }

    // Attach Listeners
    [inputSystem, inputFeedstock, inputPressure, inputTemp, inputCo2Dose, inputScrewSpeed, inputMoisture, inputDpdt, inputRecovery].forEach(el => {
      if (el) el.addEventListener('input', calculate);
    });

    // Presets
