<script define:vars={{ currentUi, currentExp }}>
  function initKettleSimulator() {
    const matSelect = document.getElementById('kettle-material');
    const ageSelect = document.getElementById('kettle-age');
    const expSelect = document.getElementById('kettle-exposure');
    const chemSelect = document.getElementById('kettle-chemistry');

    const badgeEl = document.getElementById('verdict-badge');
    const mpValEl = document.getElementById('metric-mp');
    const niValEl = document.getElementById('metric-ni');
    const crackValEl = document.getElementById('metric-crack');

    const barMp = document.getElementById('bar-mp');
    const barNi = document.getElementById('bar-ni');
    const barCrack = document.getElementById('bar-crack');

    const descMech = document.getElementById('desc-mechanism');
    const descAction = document.getElementById('desc-action');

    const btnCopy = document.getElementById('btn-copy-report');
    const btnPrint = document.getElementById('btn-print-report');
    const copyStatus = document.getElementById('copy-status');

    if (!matSelect || !ageSelect || !expSelect || !chemSelect) return;

    function recalculate() {
      const matOpt = matSelect.options[matSelect.selectedIndex];
      const ageOpt = ageSelect.options[ageSelect.selectedIndex];
      const expOpt = expSelect.options[expSelect.selectedIndex];
      const chemOpt = chemSelect.options[chemSelect.selectedIndex];

      const baseMp = parseFloat(matOpt.getAttribute('data-mp') || '0');
      const baseNi = parseFloat(matOpt.getAttribute('data-ni') || '0');
      const crackRate = parseFloat(matOpt.getAttribute('data-crack') || '0');
      const riskWeight = parseFloat(matOpt.getAttribute('data-risk') || '0');

      const ageMult = parseFloat(ageOpt.getAttribute('data-mult') || '1');
      const crazeScore = parseFloat(ageOpt.getAttribute('data-craze') || '0');

      const expMult = parseFloat(expOpt.getAttribute('data-mult') || '1');

      const chemFactor = parseFloat(chemOpt.getAttribute('data-chem') || '1');
      const niFactor = parseFloat(chemOpt.getAttribute('data-ni') || '1');
      const scaleFactor = parseFloat(chemOpt.getAttribute('data-scale') || '0');

      // Microplastics calculation
      let totalMp = Math.round(baseMp * ageMult * expMult * chemFactor);
      if (totalMp < 5000) totalMp = 5000;

      // Nickel calculation
      let totalNi = Math.round((baseNi * ageMult * (0.8 + expMult * 0.2) * niFactor) * 10) / 10;

      // Micro-crack & craze score (0 - 100)
      let crackIndex = Math.round(crazeScore + (crackRate * 7.5) + (scaleFactor * 12));
      if (matOpt.value === 'seamless-stainless') crackIndex = 0;
      if (matOpt.value === 'glass-stainless') crackIndex = Math.min(crackIndex, 8);
      crackIndex = Math.min(Math.max(crackIndex, 0), 100);

      // Render metrics
      if (totalMp >= 1000000) {
        mpValEl.textContent = (totalMp / 1000000).toFixed(2) + 'M';
      } else {
        mpValEl.textContent = (totalMp / 1000).toFixed(0) + 'k';
      }

      niValEl.textContent = totalNi.toFixed(1);
      crackValEl.textContent = crackIndex.toString();

      // Update progress bar widths
      const mpPercent = Math.min(Math.max((totalMp / 25000000) * 100, 3), 100);
      barMp.style.width = mpPercent + '%';

      const niPercent = Math.min(Math.max((totalNi / 80) * 100, 3), 100);
      barNi.style.width = niPercent + '%';

      const crackPercent = Math.min(Math.max(crackIndex, 3), 100);
      barCrack.style.width = crackPercent + '%';

      // Determine Safety Tier
      let tier = 'safe';
      if (totalNi >= 60 || totalMp >= 22000000 || (crackIndex >= 80 && riskWeight >= 2.5)) {
        tier = 'critical';
      } else if (totalMp >= 8000000 || totalNi >= 25 || crackIndex >= 55) {
        tier = 'hazard';
      } else if (totalMp >= 1000000 || totalNi >= 12 || crackIndex >= 25) {
        tier = 'caution';
      } else {
        tier = 'safe';
      }

      // Special override: Glass & seamless stainless are always safe
      if (matOpt.value === 'glass-stainless' || matOpt.value === 'seamless-stainless') {
        tier = (totalNi >= 50) ? 'caution' : 'safe';
      }

      // Style badge & verdict
      badgeEl.className = 'px-4 py-2 rounded-xl text-xs sm:text-sm font-black tracking-wide uppercase transition-all duration-300 ';
      if (tier === 'critical') {
        badgeEl.textContent = currentUi.verdictCritical;
        badgeEl.className += 'bg-red-500/20 text-red-300 border border-red-500/40 shadow-lg shadow-red-950/40';
        barMp.className = 'bg-red-500 h-full rounded-full transition-all duration-500';
        barNi.className = 'bg-red-500 h-full rounded-full transition-all duration-500';
      } else if (tier === 'hazard') {
        badgeEl.textContent = currentUi.verdictHazard;
        badgeEl.className += 'bg-orange-500/20 text-orange-300 border border-orange-500/40 shadow-lg shadow-orange-950/40';
        barMp.className = 'bg-orange-400 h-full rounded-full transition-all duration-500';
        barNi.className = 'bg-orange-400 h-full rounded-full transition-all duration-500';
      } else if (tier === 'caution') {
        badgeEl.textContent = currentUi.verdictCaution;
        badgeEl.className += 'bg-amber-500/20 text-amber-300 border border-amber-500/40 shadow-lg shadow-amber-950/40';
        barMp.className = 'bg-amber-400 h-full rounded-full transition-all duration-500';
        barNi.className = 'bg-amber-400 h-full rounded-full transition-all duration-500';
      } else {
        badgeEl.textContent = currentUi.verdictSafe;
        badgeEl.className += 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 shadow-lg shadow-emerald-950/40';
        barMp.className = 'bg-emerald-400 h-full rounded-full transition-all duration-500';
        barNi.className = 'bg-emerald-400 h-full rounded-full transition-all duration-500';
      }

      // Inject Explanation
      const exp = currentExp[tier] || currentExp.safe;
      descMech.innerHTML = exp.mechanism;
      descAction.innerHTML = exp.action;
    }

    matSelect.addEventListener('change', recalculate);
    ageSelect.addEventListener('change', recalculate);
    expSelect.addEventListener('change', recalculate);
    chemSelect.addEventListener('change', recalculate);

    // Initial calculation
    recalculate();

    // Copy to clipboard
    if (btnCopy) {
      btnCopy.addEventListener('click', () => {
        const mat = matSelect.options[matSelect.selectedIndex].text;
        const mp = mpValEl.textContent;
        const ni = niValEl.textContent;
        const crack = crackValEl.textContent;
        const verdict = badgeEl.textContent.trim();

        const reportText = [
          '--- ISITKITCHENSAFE KETTLE TOXICOLOGY REPORT ---',
          'Appliance / Material: ' + mat,
          'Estimated Microplastic Release: ' + mp + ' particles/L',
          'Estimated Nickel (Ni) Leaching: ' + ni + ' µg/L (WHO Limit: 70 µg/L)',
          'Polymer Micro-Crack & Craze Index: ' + crack + ' / 100',
          'Safety Verdict: ' + verdict,
          'Reference Standard: Nature Food (2020) & WHO Drinking Water Standards',
          'Audit URL: https://isitkitchensafe.com/tools/plastic-water-kettle-microplastic-simulator/',
          '------------------------------------------------'
        ].join('\n');

        navigator.clipboard.writeText(reportText).then(() => {
          if (copyStatus) {
            copyStatus.classList.remove('hidden');
            setTimeout(() => {
              copyStatus.classList.add('hidden');
            }, 3500);
          }
        }).catch(err => {
          console.error('Copy failed:', err);
        });
      });
    }

    // Print / PDF
    if (btnPrint) {
      btnPrint.addEventListener('click', () => {
        window.print();
      });
    }
  }

  // Run on DOM loaded & Astro page swaps
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initKettleSimulator);
  } else {
    initKettleSimulator();
  }
  document.addEventListener('astro:page-load', initKettleSimulator);
</script>

