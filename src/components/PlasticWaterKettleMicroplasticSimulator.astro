const currentLocale = (['en', 'es', 'pt', 'zh-cn', 'ja'].includes(lang) ? lang : 'en') as 'en' | 'es' | 'pt' | 'zh-cn' | 'ja';
const bannerData = rawData.safetyBanner[currentLocale] || rawData.safetyBanner.en;

const localizedMaterials = rawData.kettleMaterials.map((m: any) => ({
  id: m.id,
  name: m.name[currentLocale] || m.name.en,
  baselineMicroplastics: m.baselineMicroplastics,
  baselineNickel: m.baselineNickel,
  microcrackRate: m.microcrackRate,
  materialCategory: m.materialCategory,
  riskWeight: m.riskWeight
}));

const localizedAges = rawData.kettleAges.map((a: any) => ({
  id: a.id,
  name: a.name[currentLocale] || a.name.en,
  multiplier: a.multiplier,
  crazeScore: a.crazeScore
}));

const localizedExposures = rawData.waterExposure.map((e: any) => ({
  id: e.id,
  name: e.name[currentLocale] || e.name.en,
  multiplier: e.multiplier,
  description: e.description
}));

const localizedChemistries = rawData.waterChemistry.map((c: any) => ({
  id: c.id,
  name: c.name[currentLocale] || c.name.en,
  chemFactor: c.chemFactor,
  nickelFactor: c.nickelFactor,
  scaleFactor: c.scaleFactor
}));

