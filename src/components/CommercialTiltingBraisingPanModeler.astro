---

<div class="commercial-tilting-pan-modeler w-full max-w-5xl mx-auto my-8 font-sans" id="tilting-pan-app">
  <!-- Interactive Engine Header Card -->
  <div class="bg-surface border border-hairline rounded-3xl p-6 md:p-8 shadow-sm mb-8">
    <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-orange-500/10 text-orange-800 dark:text-orange-300 border border-orange-500/20">
        <span>⚙️</span>
        {dict.badge}
      </div>
      <span class="text-xs font-mono text-muted">NSF/ANSI 4 &bull; ASME Sec VIII &bull; OSHA 1910.22</span>
    </div>
    <h2 class="text-2xl md:text-3xl font-extrabold text-ink tracking-tight mb-2">
      {dict.title}
    </h2>
    <p class="text-sm md:text-base text-muted leading-relaxed max-w-3xl">
      {dict.subtitle}
    </p>

    <!-- Operational Presets Grid -->
    <div class="mt-6 pt-6 border-t border-hairline">
      <div class="text-xs font-bold uppercase tracking-wider text-muted mb-3">
        {dict.presetsTitle}
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-2.5">
        <button 
          type="button" 
          class="preset-btn text-left p-3 rounded-xl border border-emerald-500/30 bg-emerald-500/5 hover:bg-emerald-500/10 transition-colors text-xs"
          data-preset="gold_standard"
        >
          <div class="font-bold text-emerald-800 dark:text-emerald-300 mb-1 flex items-center gap-1.5">
            <span>🛡️</span> {dict.presetGoldStandard.split(':')[0]}
          </div>
          <div class="text-muted leading-tight line-clamp-2">
            {dict.presetGoldStandard.split(':').slice(1).join(':')}
          </div>
        </button>

        <button 
          type="button" 
          class="preset-btn text-left p-3 rounded-xl border border-amber-500/30 bg-amber-500/5 hover:bg-amber-500/10 transition-colors text-xs"
          data-preset="thermal_shock"
        >
          <div class="font-bold text-amber-800 dark:text-amber-300 mb-1 flex items-center gap-1.5">
            <span>⚡</span> {dict.presetThermalShock.split(':')[0]}
          </div>
          <div class="text-muted leading-tight line-clamp-2">
            {dict.presetThermalShock.split(':').slice(1).join(':')}
          </div>
        </button>

        <button 
          type="button" 
          class="preset-btn text-left p-3 rounded-xl border border-rose-500/30 bg-rose-500/5 hover:bg-rose-500/10 transition-colors text-xs"
          data-preset="seal_blowout"
        >
          <div class="font-bold text-rose-800 dark:text-rose-300 mb-1 flex items-center gap-1.5">
            <span>💥</span> {dict.presetSealBlowout.split(':')[0]}
          </div>
          <div class="text-muted leading-tight line-clamp-2">
            {dict.presetSealBlowout.split(':').slice(1).join(':')}
          </div>
        </button>

        <button 
          type="button" 
