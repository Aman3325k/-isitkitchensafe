<!-- Reactive Client-Side Simulation Script -->
<script is:inline define:vars={{ skilletDataJSON: JSON.stringify(data) }}>
  const data = JSON.parse(skilletDataJSON);

  // DOM Elements
  const skilletSelect = document.getElementById('skillet-model');
  const metallurgySelect = document.getElementById('pan-metallurgy');
  const liquidSelect = document.getElementById('deglaze-liquid');
  const sealSelect = document.getElementById('seal-material');
  const fluidSelect = document.getElementById('hydraulic-fluid');

  const panTempSlider = document.getElementById('pan-temp-slider');
  const liquidVolSlider = document.getElementById('liquid-vol-slider');
  const tiltAngleSlider = document.getElementById('tilt-angle-slider');
  const tiltSpeedSlider = document.getElementById('tilt-speed-slider');

  const panTempVal = document.getElementById('pan-temp-val');
  const liquidVolVal = document.getElementById('liquid-vol-val');
  const tiltAngleVal = document.getElementById('tilt-angle-val');
  const tiltSpeedVal = document.getElementById('tilt-speed-val');

  const statusPill = document.getElementById('status-pill');
  const telemetryDeltaT = document.getElementById('telemetry-delta-t');
  const telemetryWarp = document.getElementById('telemetry-warp');
  const telemetrySealRisk = document.getElementById('telemetry-seal-risk');
  const telemetryScaldSplash = document.getElementById('telemetry-scald-splash');
  const telemetrySteamFlash = document.getElementById('telemetry-steam-flash');
  const telemetryVerdict = document.getElementById('telemetry-verdict');

  const narrativeRisk = document.getElementById('narrative-risk');
  const narrativeMech = document.getElementById('narrative-mech');
  const narrativeMitigate = document.getElementById('narrative-mitigate');

  const svgPanGroup = document.getElementById('svg-pan-group');
  const svgWarpCurve = document.getElementById('svg-warp-curve');
  const svgHydraulicRam = document.getElementById('svg-hydraulic-ram');
  const svgSplashEnvelope = document.getElementById('svg-splash-envelope');
  const vizAngleText = document.getElementById('viz-angle-text');
  const vizWarpText = document.getElementById('viz-warp-text');

  const copyReportBtn = document.getElementById('copy-report-btn');
  const copyBtnText = document.getElementById('copy-btn-text');
  const copyFeedback = document.getElementById('copy-feedback');
  const presetButtons = document.querySelectorAll('.preset-btn');

  function calculateModel() {
    const model = data.braisingPanModels.find(m => m.id === skilletSelect.value) || data.braisingPanModels[0];
    const metallurgy = data.panBaseMetallurgies.find(m => m.id === metallurgySelect.value) || data.panBaseMetallurgies[0];
    const liquid = data.deglazingLiquids.find(l => l.id === liquidSelect.value) || data.deglazingLiquids[0];
    const seal = data.hydraulicTiltSeals.find(s => s.id === sealSelect.value) || data.hydraulicTiltSeals[0];
    const fluid = data.hydraulicFluids.find(f => f.id === fluidSelect.value) || data.hydraulicFluids[0];

    const panTempC = parseFloat(panTempSlider.value);
    const liquidVolGal = parseFloat(liquidVolSlider.value);
    const tiltAngleDeg = parseFloat(tiltAngleSlider.value);
    const tiltSpeedDegSec = parseFloat(tiltSpeedSlider.value);

    // Update Slider text displays
    panTempVal.textContent = `${panTempC}°C (${Math.round(panTempC * 1.8 + 32)}°F)`;
    liquidVolVal.textContent = `${liquidVolGal.toFixed(1)} Gal (${(liquidVolGal * 3.78541).toFixed(1)} L)`;
    tiltAngleVal.textContent = `${tiltAngleDeg}° Tilt`;
    tiltSpeedVal.textContent = `${tiltSpeedDegSec.toFixed(1)}° / sec`;

    // 1. Thermal Shock Delta T
    const deltaT = panTempC - liquid.temperatureC;
    const deltaTF = Math.round(deltaT * 1.8);

    // 2. Thermal Stress & Permanent Warp Calculation
    // σ = (E · α · ΔT) / (1 - ν)
    const E = metallurgy.youngsModulusGpa * 1e3; // MPa
    const alpha = metallurgy.thermalExpansionAlphaSS; // 1/K
    const nu = metallurgy.poissonsRatio;
    const thermalStressMpa = (E * alpha * deltaT) / (1 - nu);

    // Permanent warp deflection approximation based on yield ratio & plate thickness
    let permanentWarpMm = 0;
    if (metallurgy.id === 'pearlitic_cast_iron_basin') {
      // Cast iron does not warp platically; it suffers micro-cracking
      if (deltaT > metallurgy.criticalWarpThresholdDeltaC) {
        permanentWarpMm = 9.99; // Indicator for fracture
      } else if (deltaT > metallurgy.maxSafeDeltaTempC) {
        permanentWarpMm = 1.2;
      }
    } else {
      const stressRatio = thermalStressMpa / metallurgy.yieldStrengthMpa;
      if (stressRatio > 1.0) {
        const excessStress = thermalStressMpa - metallurgy.yieldStrengthMpa;
        const thicknessFactor = 15.0 / metallurgy.spreaderMaterial ? (model.basePlateThicknessMm || 15) : 15;
        permanentWarpMm = (excessStress * 0.018 * (liquidVolGal / 3.0) * (15.0 / thicknessFactor));
        if (model.id === 'skillet_legacy_aged_15yr') permanentWarpMm += 1.8;
      }
    }

    // 3. Hydraulic Tilt Cylinder Breakdown Risk
    // Depends on radiant heat from pan skirt, operating pressure, seal rating, and tilt speed
    let sealRiskPercent = seal.annualFailureRatePercent;
    const radiantTempEstimate = 65 + (panTempC - 150) * 0.35; // °C around cylinder
    if (radiantTempEstimate > seal.continuousThermalRatingC) {
      sealRiskPercent += (radiantTempEstimate - seal.continuousThermalRatingC) * 2.8;
    }
    if (!fluid.foodGradeCertified) sealRiskPercent += 12;
    if (tiltSpeedDegSec > 3.0) sealRiskPercent += (tiltSpeedDegSec - 3.0) * 8;
    if (model.id === 'skillet_legacy_aged_15yr') sealRiskPercent += 32;
    if (model.hydraulicOperatingPressureBar === 0) sealRiskPercent = 0; // Mechanical
    sealRiskPercent = Math.min(99.9, Math.max(0.2, sealRiskPercent));

    // 4. Scald Splash Radius from Pour Lip
    // Kinetic surge d = v_lip * sqrt(2*h/g) + wave slosh
    const lipHeightM = model.pourLipHeightMm / 1000;
    const vTilt = (tiltSpeedDegSec * (Math.PI / 180)) * 0.7; // m/s rim velocity
    const sloshFactor = (tiltAngleDeg / 45) * (tiltSpeedDegSec / 2.0);
    const scaldRadiusM = Math.min(2.8, Math.max(0.15, (vTilt * Math.sqrt((2 * lipHeightM) / 9.81) * 2.2 + sloshFactor * 0.35)));

    // 5. Flash Steam Expansion Volume
    const flashFraction = Math.min(0.35, Math.max(0.02, (deltaT - 80) / 400));
    const evaporatedKg = (liquidVolGal * 3.785) * flashFraction;
    const steamVolumeM3 = evaporatedKg * (liquid.steamExpansionRatio / 1000);

    // 6. UI Updates
    telemetryDeltaT.textContent = `${Math.round(deltaT)}°C (${deltaTF}°F)`;

    if (permanentWarpMm >= 9.0) {
      telemetryWarp.textContent = `BRITTLE FRACTURE (CATASTROPHIC)`;
      telemetryWarp.className = 'font-mono font-bold text-rose-600 dark:text-rose-400';
    } else if (permanentWarpMm > 2.0) {
      telemetryWarp.textContent = `${permanentWarpMm.toFixed(1)} mm [SEVERE WARP]`;
      telemetryWarp.className = 'font-mono font-bold text-rose-600 dark:text-rose-400';
    } else if (permanentWarpMm > 0.8) {
      telemetryWarp.textContent = `${permanentWarpMm.toFixed(1)} mm [MODERATE BOW]`;
      telemetryWarp.className = 'font-mono font-bold text-amber-600 dark:text-amber-400';
    } else {
      telemetryWarp.textContent = `${permanentWarpMm.toFixed(1)} mm [SAFE]`;
      telemetryWarp.className = 'font-mono font-bold text-emerald-600 dark:text-emerald-400';
    }

    if (sealRiskPercent > 60) {
      telemetrySealRisk.textContent = `${sealRiskPercent.toFixed(1)}% [CRITICAL DANGER]`;
      telemetrySealRisk.className = 'font-mono font-bold text-rose-600 dark:text-rose-400';
    } else if (sealRiskPercent > 20) {
      telemetrySealRisk.textContent = `${sealRiskPercent.toFixed(1)}% [ELEVATED RISK]`;
      telemetrySealRisk.className = 'font-mono font-bold text-amber-600 dark:text-amber-400';
    } else {
      telemetrySealRisk.textContent = `${sealRiskPercent.toFixed(1)}% [OPTIMAL]`;
      telemetrySealRisk.className = 'font-mono font-bold text-emerald-600 dark:text-emerald-400';
    }

    telemetryScaldSplash.textContent = `${scaldRadiusM.toFixed(2)} m (${(scaldRadiusM * 3.28084).toFixed(1)} ft)`;
    telemetrySteamFlash.textContent = `${steamVolumeM3.toFixed(2)} m³ (${liquid.steamExpansionRatio}x Ratio)`;

    // Compliance Verdict
    const isCompliant = permanentWarpMm < 1.5 && sealRiskPercent < 25 && tiltSpeedDegSec <= 3.0 && fluid.foodGradeCertified;
    const isMarginal = permanentWarpMm < 2.5 && sealRiskPercent < 50;

    if (isCompliant) {
      statusPill.textContent = 'OPTIMAL & COMPLIANT';
      statusPill.className = 'px-2.5 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wider bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 border border-emerald-500/20';
      telemetryVerdict.textContent = 'PASS (NSF 4 & OSHA Compliant)';
      telemetryVerdict.className = 'font-mono font-bold text-emerald-600 dark:text-emerald-400';
    } else if (isMarginal) {
      statusPill.textContent = 'CAUTION - OPERATIONAL WEAR';
      statusPill.className = 'px-2.5 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wider bg-amber-500/10 text-amber-700 dark:text-amber-300 border border-amber-500/20';
      telemetryVerdict.textContent = 'WARN (Marginal Compliance)';
      telemetryVerdict.className = 'font-mono font-bold text-amber-600 dark:text-amber-400';
    } else {
      statusPill.textContent = 'CRITICAL HAZARD DETECTED';
      statusPill.className = 'px-2.5 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wider bg-rose-500/10 text-rose-700 dark:text-rose-300 border border-rose-500/20';
      telemetryVerdict.textContent = 'FAIL (OSHA Scald / Warp Violation)';
      telemetryVerdict.className = 'font-mono font-bold text-rose-600 dark:text-rose-400';
    }

    // Dynamic SVG Visualization Updates
    const svgTiltAngle = Math.min(75, tiltAngleDeg * 0.8);
    svgPanGroup.setAttribute('transform', `rotate(${-svgTiltAngle}, 80, 80)`);
    vizAngleText.textContent = `${tiltAngleDeg}°`;

    // Dynamic warp curve
    const warpDisplayFactor = Math.min(18, permanentWarpMm * 3.5);
    svgWarpCurve.setAttribute('d', `M80 85 Q140 ${85 - warpDisplayFactor} 200 85`);
    vizWarpText.textContent = `${permanentWarpMm.toFixed(1)} mm`;

    // Splash arc
    const splashArcScale = (scaldRadiusM / 1.5);
    svgSplashEnvelope.setAttribute('d', `M225 35 Q${235 + 40 * splashArcScale} ${45 + 20 * splashArcScale} ${240 + 50 * splashArcScale} 105`);

    // Narrative Updates
    if (permanentWarpMm >= 9.0) {
      narrativeRisk.textContent = `Catastrophic brittle tensile fracture: Rapid thermal quench of pearlitic cast iron creates tensile surface stress exceeding 240 MPa ultimate tensile strength, splitting the basin with violent crack propagation.`;
      narrativeMech.textContent = `Zero plastic ductility in gray cast iron matrix prevents stress redistribution; localized thermal contraction triggers immediate macroscopic fracture and boiling broth containment loss.`;
      narrativeMitigate.textContent = `Immediately condemn skillet; never apply liquid colder than 120°C to heated cast iron basins. Modernize facility with composite 304/aluminum clad skillets.`;
    } else if (permanentWarpMm > 2.0) {
      narrativeRisk.textContent = `Severe permanent plate warping (${permanentWarpMm.toFixed(1)} mm): Bottom plate crowns upward, decoupling heat spreader from gas burner flame tubes and creating severe cold-spots.`;
      narrativeMech.textContent = `Thermal stress (${Math.round(thermalStressMpa)} MPa) massively exceeds 205 MPa yield strength; differential strain between austenitic stainless and aluminum creates irreversible plastic deformation.`;
      narrativeMitigate.textContent = `Re-machine or replace pan bottom plate. Enforce standard culinary protocol of pre-heating all deglazing stocks to ≥85°C (185°F).`;
    } else {
      narrativeRisk.textContent = `Thermal stresses remain within design safety factor; localized contraction relaxes elastically upon liquid temperature equilibration.`;
      narrativeMech.textContent = `Controlled temperature differential (ΔT = ${Math.round(deltaT)}°C) keeps thermal expansion differential within the 205 MPa elastic limit of composite plate.`;
      narrativeMitigate.textContent = `Continue current operating SOP; conduct semiannual cylinder seal checks and enforce 3°/s tilt rate limit.`;
    }

    return {
      model: model.name,
      metallurgy: metallurgy.name,
      liquid: liquid.name,
      seal: seal.name,
      fluid: fluid.name,
      panTempC,
      liquidVolGal,
      tiltAngleDeg,
      tiltSpeedDegSec,
      deltaT,
      thermalStressMpa,
      permanentWarpMm,
      sealRiskPercent,
      scaldRadiusM,
      steamVolumeM3,
      verdict: isCompliant ? 'PASS' : (isMarginal ? 'WARN' : 'FAIL')
    };
  }

  // Preset Configurations Handler
  presetButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const p = btn.getAttribute('data-preset');
      if (p === 'gold_standard') {
        skilletSelect.value = 'skillet_40gal_hydraulic_floor';
        metallurgySelect.value = 'clad_304_aluminum_composite';
        liquidSelect.value = 'liquid_preheated_hot_stock';
        sealSelect.value = 'seal_viton_fkm_fluorocarbon';
        fluidSelect.value = 'fluid_nsf_h1_synthetic_pao';
        panTempSlider.value = 180;
        liquidVolSlider.value = 3.0;
        tiltAngleSlider.value = 35;
        tiltSpeedSlider.value = 1.5;
      } else if (p === 'thermal_shock') {
        skilletSelect.value = 'skillet_40gal_hydraulic_floor';
        metallurgySelect.value = 'clad_304_aluminum_composite';
        liquidSelect.value = 'liquid_ice_stock_slurry';
        sealSelect.value = 'seal_foodgrade_polyurethane';
        fluidSelect.value = 'fluid_nsf_h1_synthetic_pao';
        panTempSlider.value = 320;
        liquidVolSlider.value = 5.0;
        tiltAngleSlider.value = 45;
        tiltSpeedSlider.value = 2.5;
      } else if (p === 'seal_blowout') {
        skilletSelect.value = 'skillet_legacy_aged_15yr';
        metallurgySelect.value = 'clad_304_aluminum_composite';
        liquidSelect.value = 'liquid_chilled_wine_tap';
        sealSelect.value = 'seal_standard_nitrile_nbr';
        fluidSelect.value = 'fluid_mineral_industrial';
        panTempSlider.value = 280;
        liquidVolSlider.value = 6.0;
        tiltAngleSlider.value = 90;
        tiltSpeedSlider.value = 5.0;
      } else if (p === 'brittle_fracture') {
        skilletSelect.value = 'skillet_40gal_hydraulic_floor';
        metallurgySelect.value = 'pearlitic_cast_iron_basin';
        liquidSelect.value = 'liquid_ice_stock_slurry';
        sealSelect.value = 'seal_foodgrade_polyurethane';
        fluidSelect.value = 'fluid_nsf_h1_synthetic_pao';
        panTempSlider.value = 345;
        liquidVolSlider.value = 4.0;
        tiltAngleSlider.value = 40;
        tiltSpeedSlider.value = 2.0;
      }
      calculateModel();
    });
  });

  // Attach Event Listeners
  [skilletSelect, metallurgySelect, liquidSelect, sealSelect, fluidSelect].forEach(el => el.addEventListener('change', calculateModel));
  [panTempSlider, liquidVolSlider, tiltAngleSlider, tiltSpeedSlider].forEach(el => el.addEventListener('input', calculateModel));

  // Copy JSON telemetry to clipboard
  copyReportBtn.addEventListener('click', () => {
    const reportData = calculateModel();
    const telemetryJSON = JSON.stringify({
      auditTool: "Commercial Tilting Braising Pan Hydraulic Seal & Thermal Shock Warp Modeler",
      version: "2.0.0",
      timestamp: new Date().toISOString(),
      standards: ["NSF/ANSI 4", "ASME Section VIII Div 1", "OSHA 29 CFR 1910.22", "NFPA 96"],
      telemetry: reportData
    }, null, 2);

    navigator.clipboard.writeText(telemetryJSON).then(() => {
      copyFeedback.classList.remove('hidden');
      setTimeout(() => {
        copyFeedback.classList.add('hidden');
      }, 3500);
    });
  });

  // Initial Calculation on load
  calculateModel();
</script>
