    copiedFeedback: "レポートがクリップボードにコピーされました！"
  }
};

const d = DICTIONARY[lang] || DICTIONARY.en;
---

<div class="mats-modeler bg-surface-soft border border-hairline rounded-2xl p-6 sm:p-8 shadow-xs my-8" data-lang={lang}>
  <!-- Header Badge & Intro -->
  <div class="mb-6">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 mb-2">
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 2v4m0 12v4M4.93 4.93l2.83 2.83m8.48 8.48l2.83 2.83M2 12h4m12 0h4M4.93 19.07l2.83-2.83m8.48-8.48l2.83-2.83"></path>
        <circle cx="12" cy="12" r="4"></circle>
      </svg>
      {d.badge}
    </div>
    <h2 class="text-2xl sm:text-3xl font-extrabold text-ink tracking-tight mb-2">
      {d.title}
    </h2>
    <p class="text-sm sm:text-base text-muted leading-relaxed max-w-4xl">
      {d.subtitle}
    </p>
  </div>

  <!-- Presets -->
  <div class="mb-8 p-4 bg-surface rounded-xl border border-hairline">
    <div class="text-xs font-bold text-muted uppercase tracking-wider mb-3">
      {d.presetsTitle}
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5">
      <button type="button" class="preset-btn px-3 py-2 text-xs font-medium rounded-lg bg-surface-soft border border-hairline hover:border-indigo-500 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors text-left" data-preset="stew">
        🥩 {d.presetStew}
      </button>
      <button type="button" class="preset-btn px-3 py-2 text-xs font-medium rounded-lg bg-surface-soft border border-hairline hover:border-indigo-500 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors text-left" data-preset="salmon">
        🐟 {d.presetSalmon}
      </button>
      <button type="button" class="preset-btn px-3 py-2 text-xs font-medium rounded-lg bg-surface-soft border border-hairline hover:border-indigo-500 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors text-left" data-preset="potato">
        🥔 {d.presetPotato}
      </button>
      <button type="button" class="preset-btn px-3 py-2 text-xs font-medium rounded-lg bg-surface-soft border border-hairline hover:border-red-500 hover:text-red-600 dark:hover:text-red-400 transition-colors text-left" data-preset="catastrophic">
        💥 {d.presetCatastrophic}
      </button>
    </div>
  </div>

  <!-- Interactive Controls Form -->
  <div class="mb-8 p-6 bg-surface rounded-xl border border-hairline">
    <div class="mb-6">
      <h3 class="text-lg font-bold text-ink mb-1">{d.controlsTitle}</h3>
      <p class="text-xs sm:text-sm text-muted">{d.controlsSub}</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
      <!-- Select Architecture -->
      <div>
        <label for="machine-select" class="block text-xs font-bold text-ink uppercase tracking-wider mb-1.5">
          {d.machineLabel}
        </label>
        <select id="machine-select" class="w-full text-xs sm:text-sm p-2.5 rounded-lg bg-surface-soft border border-hairline text-ink focus:outline-none focus:ring-2 focus:ring-indigo-500">
          {matsData.matsSystems.map(m => (
            <option value={m.id} selected={m.id === 'commercial_industrial_mats'}>{m.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1 leading-snug">{d.machineHelp}</p>
      </div>

      <!-- Select Food Matrix -->
      <div>
        <label for="food-select" class="block text-xs font-bold text-ink uppercase tracking-wider mb-1.5">
          {d.foodLabel}
        </label>
        <select id="food-select" class="w-full text-xs sm:text-sm p-2.5 rounded-lg bg-surface-soft border border-hairline text-ink focus:outline-none focus:ring-2 focus:ring-indigo-500">
          {matsData.foodMatrices.map(f => (
            <option value={f.id} selected={f.id === 'low_acid_beef_stew'}>{f.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1 leading-snug">{d.foodHelp}</p>
      </div>

      <!-- Select Packaging Format -->
      <div>
        <label for="package-select" class="block text-xs font-bold text-ink uppercase tracking-wider mb-1.5">
          {d.packageLabel}
        </label>
        <select id="package-select" class="w-full text-xs sm:text-sm p-2.5 rounded-lg bg-surface-soft border border-hairline text-ink focus:outline-none focus:ring-2 focus:ring-indigo-500">
          {matsData.packagingProfiles.map(p => (
            <option value={p.id} selected={p.id === 'retort_pouch_evoh'}>{p.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1 leading-snug">{d.packageHelp}</p>
      </div>
    </div>

    <!-- Sliders Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-6">
      <!-- Applied Power Slider -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <label for="power-range" class="text-xs font-bold text-ink">{d.powerLabel}</label>
          <span id="power-val" class="font-mono text-xs font-bold text-indigo-600 dark:text-indigo-400">75 kW</span>
        </div>
        <input id="power-range" type="range" min="10" max="120" step="5" value="75" class="w-full accent-indigo-600" />
        <p class="text-[11px] text-muted mt-0.5">{d.powerHelp}</p>
      </div>

      <!-- Counter-Pressure Slider -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <label for="pressure-range" class="text-xs font-bold text-ink">{d.pressureLabel}</label>
          <span id="pressure-val" class="font-mono text-xs font-bold text-indigo-600 dark:text-indigo-400">3.8 bar</span>
        </div>
        <input id="pressure-range" type="range" min="1.0" max="5.0" step="0.1" value="3.8" class="w-full accent-indigo-600" />
        <p class="text-[11px] text-muted mt-0.5">{d.pressureHelp}</p>
      </div>

      <!-- Circulating Water Temp Slider -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <label for="watertemp-range" class="text-xs font-bold text-ink">{d.waterTempLabel}</label>
          <span id="watertemp-val" class="font-mono text-xs font-bold text-indigo-600 dark:text-indigo-400">118 °C</span>
        </div>
        <input id="watertemp-range" type="range" min="85" max="125" step="1" value="118" class="w-full accent-indigo-600" />
        <p class="text-[11px] text-muted mt-0.5">{d.waterTempHelp}</p>
      </div>

      <!-- Residence Time Slider -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <label for="time-range" class="text-xs font-bold text-ink">{d.timeLabel}</label>
          <span id="time-val" class="font-mono text-xs font-bold text-indigo-600 dark:text-indigo-400">140 s</span>
        </div>
        <input id="time-range" type="range" min="60" max="300" step="5" value="140" class="w-full accent-indigo-600" />
        <p class="text-[11px] text-muted mt-0.5">{d.timeHelp}</p>
      </div>

      <!-- Package Thickness Slider -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <label for="thickness-range" class="text-xs font-bold text-ink">{d.thicknessLabel}</label>
          <span id="thickness-val" class="font-mono text-xs font-bold text-indigo-600 dark:text-indigo-400">25 mm</span>
        </div>
        <input id="thickness-range" type="range" min="15" max="45" step="1" value="25" class="w-full accent-indigo-600" />
        <p class="text-[11px] text-muted mt-0.5">{d.thicknessHelp}</p>
      </div>

      <!-- Salt / Electrolyte Slider -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <label for="salt-range" class="text-xs font-bold text-ink">{d.saltLabel}</label>
          <span id="salt-val" class="font-mono text-xs font-bold text-indigo-600 dark:text-indigo-400">1.2 %</span>
        </div>
        <input id="salt-range" type="range" min="0.2" max="2.5" step="0.1" value="1.2" class="w-full accent-indigo-600" />
        <p class="text-[11px] text-muted mt-0.5">{d.saltHelp}</p>
      </div>
    </div>

    <!-- Toggles Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4 border-t border-hairline">
      <div class="flex items-start gap-3">
        <input id="flow-toggle" type="checkbox" checked class="mt-1 h-4 w-4 rounded border-hairline text-indigo-600 focus:ring-indigo-500 accent-indigo-600" />
        <div>
          <label for="flow-toggle" class="text-xs font-bold text-ink block cursor-pointer">
            {d.flowToggleLabel}
          </label>
          <p class="text-[11px] text-muted leading-relaxed">{d.flowToggleHelp}</p>
        </div>
      </div>

      <div class="flex items-start gap-3">
        <input id="tuner-toggle" type="checkbox" checked class="mt-1 h-4 w-4 rounded border-hairline text-indigo-600 focus:ring-indigo-500 accent-indigo-600" />
        <div>
          <label for="tuner-toggle" class="text-xs font-bold text-ink block cursor-pointer">
            {d.tunerToggleLabel}
          </label>
          <p class="text-[11px] text-muted leading-relaxed">{d.tunerToggleHelp}</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Telemetry & Diagnostic Dashboards -->
  <div class="mb-8 p-6 bg-surface rounded-xl border border-hairline">
    <div class="flex flex-col sm:flex-row justify-between sm:items-center gap-3 mb-6">
      <div>
        <h3 class="text-lg font-bold text-ink mb-1">{d.diagnosticTitle}</h3>
        <p class="text-xs sm:text-sm text-muted">{d.diagnosticSub}</p>
      </div>
      <button id="copy-report-btn" type="button" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white transition-colors self-start sm:self-auto">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
        <span id="copy-btn-text">{d.copyReportBtn}</span>
      </button>
    </div>

    <!-- Status Banner -->
    <div id="safety-banner" class="mb-6 p-4 rounded-xl border flex items-start gap-3 bg-emerald-500/10 border-emerald-500/30 text-emerald-800 dark:text-emerald-300">
      <span class="text-xl">✅</span>
      <div>
        <div class="text-xs font-bold uppercase tracking-wider">{d.safetyStatusLabel}</div>
        <div id="safety-status-text" class="text-sm font-extrabold mt-0.5">OPTIMAL - FDA 21 CFR § 113 &amp; ASME SECTION VIII COMPLIANT</div>
      </div>
    </div>

    <!-- Telemetry Cards Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
      <div class="p-3.5 bg-surface-soft rounded-lg border border-hairline">
        <div class="text-[11px] text-muted font-medium mb-1">{d.penDepthLabel}</div>
        <div id="telemetry-pendepth" class="font-mono text-base sm:text-lg font-extrabold text-ink">18.2 mm</div>
        <div class="text-[10px] text-muted mt-0.5">915 MHz Single-Mode</div>
      </div>

      <div class="p-3.5 bg-surface-soft rounded-lg border border-hairline">
        <div class="text-[11px] text-muted font-medium mb-1">{d.f0LethalityLabel}</div>
        <div id="telemetry-f0" class="font-mono text-base sm:text-lg font-extrabold text-emerald-600 dark:text-emerald-400">8.4 min</div>
        <div class="text-[10px] text-muted mt-0.5">Target: &ge; 6.0 min (12D)</div>
      </div>

      <div class="p-3.5 bg-surface-soft rounded-lg border border-hairline">
        <div class="text-[11px] text-muted font-medium mb-1">{d.centerTempLabel}</div>
        <div id="telemetry-tcenter" class="font-mono text-base sm:text-lg font-extrabold text-ink">122.4 °C</div>
        <div class="text-[10px] text-muted mt-0.5">Core Cold Spot</div>
      </div>

      <div class="p-3.5 bg-surface-soft rounded-lg border border-hairline">
        <div class="text-[11px] text-muted font-medium mb-1">{d.edgeTempLabel}</div>
        <div id="telemetry-tedge" class="font-mono text-base sm:text-lg font-extrabold text-amber-600 dark:text-amber-400">127.8 °C</div>
        <div class="text-[10px] text-muted mt-0.5">Max Allowable: 134.0 °C</div>
      </div>

      <div class="p-3.5 bg-surface-soft rounded-lg border border-hairline">
        <div class="text-[11px] text-muted font-medium mb-1">{d.inversionRatioLabel}</div>
        <div id="telemetry-inversion" class="font-mono text-base sm:text-lg font-extrabold text-ink">1.04</div>
        <div class="text-[10px] text-muted mt-0.5">Edge-to-Center Inversion</div>
      </div>

      <div class="p-3.5 bg-surface-soft rounded-lg border border-hairline">
        <div class="text-[11px] text-muted font-medium mb-1">{d.packagePressureLabel}</div>
        <div id="telemetry-ppackage" class="font-mono text-base sm:text-lg font-extrabold text-ink">2.48 bar</div>
        <div class="text-[10px] text-muted mt-0.5">Saturated Vapor Pressure</div>
      </div>

      <div class="p-3.5 bg-surface-soft rounded-lg border border-hairline">
        <div class="text-[11px] text-muted font-medium mb-1">{d.deltaPLabel}</div>
        <div id="telemetry-deltap" class="font-mono text-base sm:text-lg font-extrabold text-emerald-600 dark:text-emerald-400">-1.32 bar</div>
        <div class="text-[10px] text-muted mt-0.5">Burst Margin &gt; 1.5 bar</div>
      </div>

      <div class="p-3.5 bg-surface-soft rounded-lg border border-hairline">
        <div class="text-[11px] text-muted font-medium mb-1">{d.rfLeakageLabel}</div>
        <div id="telemetry-rf" class="font-mono text-base sm:text-lg font-extrabold text-emerald-600 dark:text-emerald-400">0.4 mW/cm²</div>
        <div class="text-[10px] text-muted mt-0.5">OSHA / FCC &lt; 5.0 mW/cm²</div>
      </div>
    </div>

    <!-- Diagnostic Details Callouts -->
    <div class="space-y-3">
      <div class="p-3.5 bg-surface-soft rounded-lg border border-hairline">
        <span class="text-xs font-bold text-ink block mb-0.5">{d.primaryRiskLabel}</span>
        <span id="diagnostic-risk" class="text-xs text-muted leading-relaxed">
          None detected. Overpressure is sufficient to compress internal vapor pressure and water boundary velocity moderates edge heating.
        </span>
      </div>

      <div class="p-3.5 bg-surface-soft rounded-lg border border-hairline">
        <span class="text-xs font-bold text-ink block mb-0.5">{d.mechanismsLabel}</span>
        <span id="diagnostic-mechanisms" class="text-xs text-muted leading-relaxed">
          Incident 915 MHz electromagnetic waves penetrate 18.2 mm into the 25 mm food matrix. Water immersion overpressure (3.8 bar) counteracts package steam pressure (2.48 bar), resulting in net compressive hydrostatic stress on pouch seals.
        </span>
      </div>

      <div class="p-3.5 bg-surface-soft rounded-lg border border-hairline">
        <span class="text-xs font-bold text-ink block mb-0.5">{d.mitigationLabel}</span>
        <span id="diagnostic-mitigation" class="text-xs text-muted leading-relaxed">
          Maintain 3.8 bar counter-pressure throughout cooling cycle until product core reaches &lt;80°C to prevent post-sterilization seam creep.
        </span>
      </div>
    </div>
  </div>

  <!-- Engineering Specs Table -->
  <div class="mb-8 p-6 bg-surface rounded-xl border border-hairline">
    <div class="mb-4">
      <h3 class="text-lg font-bold text-ink mb-1">{d.tableTitle}</h3>
      <p class="text-xs sm:text-sm text-muted">{d.tableSub}</p>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs border-collapse">
        <thead>
          <tr class="border-b border-hairline text-muted">
            <th class="py-2.5 px-3 font-semibold">{d.colModel}</th>
            <th class="py-2.5 px-3 font-semibold">{d.colClass}</th>
            <th class="py-2.5 px-3 font-semibold">{d.colPower}</th>
            <th class="py-2.5 px-3 font-semibold">{d.colPressure}</th>
            <th class="py-2.5 px-3 font-semibold">{d.colPump}</th>
            <th class="py-2.5 px-3 font-semibold">{d.colShielding}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline">
          {matsData.matsSystems.map(m => (
            <tr class="hover:bg-surface-soft/60 transition-colors">
              <td class="py-2.5 px-3 font-medium text-ink">{m.name}</td>
              <td class="py-2.5 px-3 text-muted">{m.classification}</td>
              <td class="py-2.5 px-3 font-mono text-ink">{m.maxMicrowavePowerKw} kW ({m.microwaveFrequencyMhz} MHz)</td>
              <td class="py-2.5 px-3 font-mono text-ink">{m.maxChamberPressureBar} bar</td>
              <td class="py-2.5 px-3 text-muted">{m.circulationPumpType}</td>
              <td class="py-2.5 px-3 text-muted">{m.rfLeakageShielding}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Scientific Physics Deep Dive -->
  <div class="mb-8 p-6 bg-surface rounded-xl border border-hairline">
    <div class="mb-4">
      <h3 class="text-lg font-bold text-ink mb-1">{d.scienceTitle}</h3>
      <p class="text-xs sm:text-sm text-muted">{d.scienceSub}</p>
    </div>
    <div class="prose dark:prose-invert max-w-none text-xs sm:text-sm leading-relaxed text-muted space-y-4">
      <p>
        <strong>1. Single-Mode 915 MHz Microwave Cavity Electromagnetics vs. 2,450 MHz Domestic Ovens:</strong>
        Industrial MATS systems operate at 915 MHz (ISM frequency band) rather than the standard 2,450 MHz used in consumer microwaves. At 915 MHz, the free-space wavelength (&lambda; = 32.8 cm) is approximately 2.7 times longer than at 2,450 MHz (&lambda; = 12.2 cm). According to von Hippel's dielectric attenuation formulations, microwave penetration depth ($d_p$) is given by:
      </p>
      <div class="p-3 bg-surface-soft rounded-lg font-mono text-xs text-ink overflow-x-auto text-center">
        d_p = c / (2 &pi; f &radic;[2 &epsilon;'] * &radic;[&radic;(1 + (&epsilon;'' / &epsilon;')&sup2;) - 1])
      </div>
      <p>
        Where $c$ is the speed of light, $f = 915 \times 10^6$ Hz, $\epsilon'$ is the dielectric constant (ability to store electrical energy), and $\epsilon''$ is the dielectric loss factor (dissipation of electrical energy into thermal kinetic energy). At 915 MHz, $d_p$ in high-moisture foods reaches 15 to 25 mm, compared to only 4 to 8 mm at 2,450 MHz. This allows microwave energy to penetrate directly through both faces of a 25 to 40 mm retort pouch or meal tray, converting energy to heat volumetrically and eliminating the slow conductive heat transfer bottleneck of conventional steam retorts.
      </p>
      <p>
        <strong>2. Dielectric Corner Focusing, Thermal Inversion &amp; High-Velocity Water Immersion:</strong>
        When packaged food is immersed in pressurized water inside a microwave cavity, refraction and reflection occurs at the package-water interface. The electrical field ($E$) is governed by continuity of the displacement field ($D = \epsilon_0 \epsilon^* E$). At sharp package corners and edges, electromagnetic field lines converge, resulting in dielectric edge focusing (E_edge / E_center &approx; 1.3&ndash;2.0). Furthermore, in high-salt foods, ionic conduction ($\sigma$) increases with temperature ($\epsilon'' = \epsilon''_d + \sigma / (\epsilon_0 \omega)$), initiating localized thermal runaway. Without high-velocity pressurized circulating water (Re &gt; 10,000) stripping heat from the pouch exterior, corner temperatures can exceed 138°C while the core cold spot lags at 116°C.
      </p>
      <p>
        <strong>3. Clostridium botulinum Sterilization Kinetics &amp; Thermal Lethality ($F_0$):</strong>
        Under FDA 21 CFR § 113 for low-acid canned and retort foods, the sterilization process must deliver a minimum $F_0 \ge 6.0$ minutes (12D reduction of <em>Clostridium botulinum</em> spores with D_121.1 = 0.21 min and $z = 10.0$°C):
      </p>
      <div class="p-3 bg-surface-soft rounded-lg font-mono text-xs text-ink overflow-x-auto text-center">
        F_0 = &int; 10^((T(t) - 121.1) / 10) dt
      </div>
      <p>
        Conventional retorts require 35 to 60 minutes to deliver $F_0 = 7.0$ min to the center of a package, severely overcooking the outer layers and degrading heat-sensitive vitamins (thiamine, riboflavin), texture, and color. By coupling 915 MHz volumetric microwave heating with pressurized water immersion, MATS achieves $F_0 \ge 7.0$ min within 4 to 8 minutes total processing time, preserving culinary quality and nutritional integrity.
      </p>
    </div>
  </div>

  <!-- Mandatory Engineering Rules -->
  <div class="p-6 bg-surface rounded-xl border border-hairline">
    <div class="mb-4">
      <h3 class="text-lg font-bold text-ink mb-1">{d.rulesTitle}</h3>
      <p class="text-xs sm:text-sm text-muted">{d.rulesSub}</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="p-4 bg-surface-soft rounded-lg border border-hairline">
        <h4 class="text-xs font-bold text-ink mb-1">{d.rule1Title}</h4>
        <p class="text-xs text-muted leading-relaxed">{d.rule1Text}</p>
      </div>
      <div class="p-4 bg-surface-soft rounded-lg border border-hairline">
        <h4 class="text-xs font-bold text-ink mb-1">{d.rule2Title}</h4>
        <p class="text-xs text-muted leading-relaxed">{d.rule2Text}</p>
      </div>
      <div class="p-4 bg-surface-soft rounded-lg border border-hairline">
        <h4 class="text-xs font-bold text-ink mb-1">{d.rule3Title}</h4>
        <p class="text-xs text-muted leading-relaxed">{d.rule3Text}</p>
      </div>
      <div class="p-4 bg-surface-soft rounded-lg border border-hairline">
        <h4 class="text-xs font-bold text-ink mb-1">{d.rule4Title}</h4>
        <p class="text-xs text-muted leading-relaxed">{d.rule4Text}</p>
      </div>
    </div>
  </div>
</div>

<script>
  // Dynamic Simulation Engine for MATS Modeler
  function initMatsModeler() {
    const root = document.querySelector('.mats-modeler');
    if (!root) return;

    // Form Inputs
    const machineSelect = document.getElementById('machine-select');
    const foodSelect = document.getElementById('food-select');
    const packageSelect = document.getElementById('package-select');

    const powerRange = document.getElementById('power-range');
    const pressureRange = document.getElementById('pressure-range');
    const waterTempRange = document.getElementById('watertemp-range');
    const timeRange = document.getElementById('time-range');
    const thicknessRange = document.getElementById('thickness-range');
    const saltRange = document.getElementById('salt-range');

    const flowToggle = document.getElementById('flow-toggle');
    const tunerToggle = document.getElementById('tuner-toggle');

    // Value Labels
    const powerVal = document.getElementById('power-val');
    const pressureVal = document.getElementById('pressure-val');
    const waterTempVal = document.getElementById('watertemp-val');
    const timeVal = document.getElementById('time-val');
    const thicknessVal = document.getElementById('thickness-val');
    const saltVal = document.getElementById('salt-val');

    // Telemetry Outputs
    const banner = document.getElementById('safety-banner');
    const statusText = document.getElementById('safety-status-text');

    const telPenDepth = document.getElementById('telemetry-pendepth');
    const telF0 = document.getElementById('telemetry-f0');
    const telTCenter = document.getElementById('telemetry-tcenter');
    const telTEdge = document.getElementById('telemetry-tedge');
    const telInversion = document.getElementById('telemetry-inversion');
    const telPPackage = document.getElementById('telemetry-ppackage');
    const telDeltaP = document.getElementById('telemetry-deltap');
    const telRf = document.getElementById('telemetry-rf');

    const diagRisk = document.getElementById('diagnostic-risk');
    const diagMech = document.getElementById('diagnostic-mechanisms');
    const diagMitigation = document.getElementById('diagnostic-mitigation');

    // Presets Buttons
    const presetBtns = root.querySelectorAll('.preset-btn');
    const copyReportBtn = document.getElementById('copy-report-btn');
    const copyBtnText = document.getElementById('copy-btn-text');

    // Raw datasets lookup
    const FOOD_DATA = {
      low_acid_beef_stew: { epsReal: 56.4, epsLoss: 32.8, baseDp: 18.2, f0Req: 7.5, name: "Low-Acid Beef Stew" },
      mashed_potato_dairy: { epsReal: 62.1, epsLoss: 22.4, baseDp: 24.5, f0Req: 6.5, name: "Mashed Potatoes" },
      salmon_fillet_brine: { epsReal: 48.7, epsLoss: 44.5, baseDp: 12.8, f0Req: 8.0, name: "Wild Salmon in Brine" },
      lentil_bean_curry: { epsReal: 54.0, epsLoss: 36.2, baseDp: 16.4, f0Req: 7.0, name: "Lentil Curry" }
    };

    const PACKAGE_DATA = {
      retort_pouch_evoh: { burstDiff: 2.8, maxEdgeTemp: 134.0, name: "4-Layer EVOH Pouch" },
      barrier_tray_alox: { burstDiff: 3.6, maxEdgeTemp: 138.0, name: "AlOx Rigid Tray" },
      thin_barrier_compromised: { burstDiff: 1.4, maxEdgeTemp: 126.0, name: "Compromised Thin Pouch" }
    };

    function recalculate() {
      if (!powerRange || !pressureRange || !waterTempRange || !timeRange || !thicknessRange || !saltRange) return;

      const powerKw = parseFloat(powerRange.value);
      const chamberPressureBar = parseFloat(pressureRange.value);
      const waterTempC = parseFloat(waterTempRange.value);
      const residenceSec = parseFloat(timeRange.value);
      const thicknessMm = parseFloat(thicknessRange.value);
      const saltPct = parseFloat(saltRange.value);

      const isFlowActive = flowToggle.checked;
      const isTunerActive = tunerToggle.checked;
      const machineId = machineSelect.value;
      const foodId = foodSelect.value;
      const packageId = packageSelect.value;

      // Update Slider Label Displays
      powerVal.textContent = `${powerKw} kW`;
      pressureVal.textContent = `${chamberPressureBar.toFixed(1)} bar`;
      waterTempVal.textContent = `${waterTempC.toFixed(0)} °C`;
      timeVal.textContent = `${residenceSec.toFixed(0)} s`;
      thicknessVal.textContent = `${thicknessMm.toFixed(0)} mm`;
      saltVal.textContent = `${saltPct.toFixed(1)} %`;

      const food = FOOD_DATA[foodId] || FOOD_DATA.low_acid_beef_stew;
      const pkg = PACKAGE_DATA[packageId] || PACKAGE_DATA.retort_pouch_evoh;

      // 1. Calculate dielectric penetration depth at 915 MHz with salt scaling
      // Higher salt increases loss factor epsLoss directly (ionic conduction sigma)
      const adjustedEpsLoss = food.epsLoss * (0.6 + 0.35 * saltPct);
      const penetrationDepthMm = Math.max(8.0, (food.baseDp * Math.sqrt(food.epsLoss / adjustedEpsLoss)));

      // 2. Heating rate and core cold spot temperature
      // Penetration ratio: how well microwave energy reaches geometric center
      const corePenetrationRatio = Math.min(1.0, (penetrationDepthMm * 2) / thicknessMm);
      const effectiveCavityPowerFactor = (machineId === 'compromised_unbalanced_mats') ? 0.65 : 1.0;
      const tunerEfficiency = isTunerActive ? 1.0 : 0.82; // reflection losses if un-tuned

      // Volumetric thermal power absorption (kW/kg)
      const specificHeatingRate = (powerKw / 40.0) * corePenetrationRatio * effectiveCavityPowerFactor * tunerEfficiency;
      
      // Cold-Spot Temperature calculation (°C)
      // Approaches water temperature plus microwave volumetric heating boost
      const deltaTVolumetric = specificHeatingRate * (residenceSec / 60.0) * 12.5;
      const centerTempC = Math.min(135.0, waterTempC + deltaTVolumetric);

      // 3. Edge temperature (Dielectric Corner Focusing & Thermal Inversion)
      // Edge electric field intensification factor
      let edgeFocusingMultiplier = 1.08 + (saltPct * 0.08);
      if (!isFlowActive) {
        edgeFocusingMultiplier += 0.14; // no water convection to strip surface heat
      }
      if (!isTunerActive) {
        edgeFocusingMultiplier += 0.09; // standing wave hotspotting
      }
      if (machineId === 'compromised_unbalanced_mats') {
        edgeFocusingMultiplier += 0.15;
      }

      const edgeTempC = Math.min(150.0, centerTempC * edgeFocusingMultiplier);
      const thermalInversionRatio = (edgeTempC / Math.max(1.0, centerTempC)).toFixed(2);

      // 4. Fo Sterilization Lethality (Clostridium botulinum z=10°C, Tref=121.1°C)
      // Simplified trapezoidal / integral estimation over residence dwell time
      let lethalRate = Math.pow(10, (centerTempC - 121.1) / 10.0);
      if (centerTempC < 100.0) lethalRate = 0.0;
      const f0Lethality = Math.max(0.0, (lethalRate * (residenceSec / 60.0) * 0.85)); // 0.85 accounting for heating ramp

      // 5. Internal Package Vapor Pressure & Seam Stress
      // Antoine-style approximation for water saturated vapor pressure (bar absolute)
      // ln(P) = A - B/(T+C) -> P_sat(120°C) ≈ 1.98 bar abs, P_sat(130°C) ≈ 2.70 bar abs
      const pSatAbs = Math.exp(11.6834 - (3816.44 / (edgeTempC + 227.02)));
      const pAirExpansion = 1.013 * ((edgeTempC + 273.15) / 293.15); // headspace air expansion
      const pPackageAbs = pSatAbs + (pAirExpansion * 0.25); // partial headspace
      const pPackageGauge = Math.max(0.0, pPackageAbs - 1.013);

      // Differential pressure on pouch seam: ΔP = P_package - P_chamber
      // Positive ΔP pushes pouch outward against seal; negative ΔP compresses pouch
      const deltaPSeam = (pPackageGauge - chamberPressureBar);

      // 6. External RF Leakage (mW/cm² at 5 cm)
      let rfLeakage = 0.3;
      if (machineId === 'compromised_unbalanced_mats') {
        rfLeakage = 8.8 + (powerKw * 0.02);
      } else {
        rfLeakage = 0.2 + (powerKw * 0.003);
      }

      // Update Telemetry Displays
      telPenDepth.textContent = `${penetrationDepthMm.toFixed(1)} mm`;
      telF0.textContent = `${f0Lethality.toFixed(1)} min`;
      telTCenter.textContent = `${centerTempC.toFixed(1)} °C`;
      telTEdge.textContent = `${edgeTempC.toFixed(1)} °C`;
      telInversion.textContent = `${thermalInversionRatio}`;
      telPPackage.textContent = `${pPackageGauge.toFixed(2)} bar`;
      telDeltaP.textContent = `${deltaPSeam > 0 ? '+' : ''}${deltaPSeam.toFixed(2)} bar`;
      telRf.textContent = `${rfLeakage.toFixed(1)} mW/cm²`;

      // Color coding & Evaluation
      const isLethalityOk = f0Lethality >= food.f0Req;
      const isEdgeTempOk = edgeTempC <= pkg.maxEdgeTemp;
      const isDeltaPOk = deltaPSeam <= (pkg.burstDiff * 0.5); // 2x safety factor
      const isBurst = deltaPSeam > pkg.burstDiff;
      const isRfOk = rfLeakage < 5.0; // OSHA / FCC limit

      telF0.className = `font-mono text-base sm:text-lg font-extrabold ${isLethalityOk ? 'text-emerald-600 dark:text-emerald-400' : 'text-amber-600 dark:text-amber-400'}`;
      telTEdge.className = `font-mono text-base sm:text-lg font-extrabold ${isEdgeTempOk ? 'text-ink' : 'text-red-600 dark:text-red-400'}`;
      telDeltaP.className = `font-mono text-base sm:text-lg font-extrabold ${!isBurst && isDeltaPOk ? 'text-emerald-600 dark:text-emerald-400' : isBurst ? 'text-red-600 dark:text-red-400 font-black' : 'text-amber-600 dark:text-amber-400'}`;
      telRf.className = `font-mono text-base sm:text-lg font-extrabold ${isRfOk ? 'text-emerald-600 dark:text-emerald-400' : 'text-red-600 dark:text-red-400'}`;

      // Status Decision
      if (isBurst || !isRfOk) {
        banner.className = 'mb-6 p-4 rounded-xl border flex items-start gap-3 bg-red-500/10 border-red-500/40 text-red-800 dark:text-red-300';
        banner.querySelector('span').textContent = '🚨';
        statusText.textContent = isBurst
          ? `CATASTROPHIC POACH BURST: Differential Pressure (${deltaPSeam.toFixed(2)} bar) exceeds package seam threshold (${pkg.burstDiff} bar)!`
          : `CRITICAL RF HAZARD: Microwave Radiation Leakage (${rfLeakage.toFixed(1)} mW/cm²) violates FCC Part 18 / OSHA occupational limits!`;
        diagRisk.textContent = isBurst
          ? "Explosive packaging seam failure and internal product ejection into circulating process water."
          : "Severe occupational exposure to 915 MHz deep-tissue microwave radiation due to compromised waveguide choke gaskets.";
        diagMech.textContent = `Internal saturated steam pressure inside package reaches ${pPackageGauge.toFixed(2)} bar while chamber overpressure is only ${chamberPressureBar.toFixed(1)} bar. The resulting positive net outward pressure differential of ${deltaPSeam.toFixed(2)} bar shatters the pouch seam.`;
        diagMitigation.textContent = `Immediately increase chamber counter-pressure to $\\ge$ ${(pPackageGauge + 0.8).toFixed(1)} bar gauge, inspect RF chokes with a certified microwave survey meter, and reject contaminated process water.`;
      } else if (!isLethalityOk) {
        banner.className = 'mb-6 p-4 rounded-xl border flex items-start gap-3 bg-amber-500/10 border-amber-500/40 text-amber-800 dark:text-amber-300';
        banner.querySelector('span').textContent = '⚠️';
        statusText.textContent = `INSUFFICIENT STERILIZATION LETHALITY: Cold-spot Fo (${f0Lethality.toFixed(1)} min) below Clostridium botulinum threshold (${food.f0Req} min)!`;
        diagRisk.textContent = "Potential survival of proteolytic Clostridium botulinum spores in package geometric cold spot, risking neurotoxin production in shelf-stable storage.";
        diagMech.textContent = `Microwave residence time (${residenceSec}s) and power (${powerKw} kW) are insufficient to raise package core temperature (${centerTempC.toFixed(1)}°C) for adequate dwell time at 121.1°C equivalent lethality.`;
        diagMitigation.textContent = `Increase microwave exposure time to $\\ge$ ${Math.ceil(residenceSec * (food.f0Req / Math.max(0.1, f0Lethality)))} seconds, increase microwave power, or increase water preheat temperature to achieve Fo $\\ge$ ${food.f0Req} min under FDA 21 CFR § 113.`;
      } else if (!isEdgeTempOk) {
        banner.className = 'mb-6 p-4 rounded-xl border flex items-start gap-3 bg-amber-500/10 border-amber-500/40 text-amber-800 dark:text-amber-300';
        banner.querySelector('span').textContent = '⚠️';
        statusText.textContent = `THERMAL INVERSION OVERHEATING: Edge temperature (${edgeTempC.toFixed(1)}°C) exceeds package barrier integrity limit (${pkg.maxEdgeTemp}°C)!`;
        diagRisk.textContent = "Localized EVOH / polymer matrix degradation, scorching of high-salt food periphery, off-flavor generation, and package corner delamination.";
        diagMech.textContent = `Dielectric lens corner focusing intensifies local electrical field (${thermalInversionRatio}x core). Inadequate boundary layer water agitation allows corner hot spots to build up.`;
        diagMitigation.textContent = "Engage high-velocity circulating water sweep, activate automatic waveguide phase tuner, or reduce formulation salt concentration to moderate ionic loss factor (ε'').";
      } else {
        banner.className = 'mb-6 p-4 rounded-xl border flex items-start gap-3 bg-emerald-500/10 border-emerald-500/30 text-emerald-800 dark:text-emerald-300';
        banner.querySelector('span').textContent = '✅';
        statusText.textContent = "OPTIMAL - FDA 21 CFR § 113 & ASME SECTION VIII FULLY COMPLIANT";
        diagRisk.textContent = "None detected. Process operates within proven commercial operating envelope for shelf-stable continuous sterilization.";
        diagMech.textContent = `Incident 915 MHz waves penetrate ${penetrationDepthMm.toFixed(1)} mm into ${thicknessMm} mm matrix. Hydrostatic counter-pressure (${chamberPressureBar.toFixed(1)} bar) firmly balances internal vapor pressure (${pPackageGauge.toFixed(2)} bar), delivering clean compressive pouch stabilization while achieving Fo = ${f0Lethality.toFixed(1)} min.`;
        diagMitigation.textContent = "Maintain verified overpressure during rapid chilled water cooling step until product core drops below 80°C to guarantee seam hermeticity.";
      }
    }

    // Bind event listeners
    [machineSelect, foodSelect, packageSelect].forEach(sel => sel?.addEventListener('change', recalculate));
    [powerRange, pressureRange, waterTempRange, timeRange, thicknessRange, saltRange].forEach(inp => inp?.addEventListener('input', recalculate));
    [flowToggle, tunerToggle].forEach(tog => tog?.addEventListener('change', recalculate));

    // Preset handlers
    presetBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const type = btn.dataset.preset;
        if (type === 'stew') {
          machineSelect.value = 'commercial_industrial_mats';
          foodSelect.value = 'low_acid_beef_stew';
          packageSelect.value = 'retort_pouch_evoh';
          powerRange.value = '75';
          pressureRange.value = '3.8';
          waterTempRange.value = '118';
          timeRange.value = '150';
          thicknessRange.value = '25';
          saltRange.value = '1.2';
          flowToggle.checked = true;
          tunerToggle.checked = true;
        } else if (type === 'salmon') {
          machineSelect.value = 'high_throughput_aseptic_mats';
          foodSelect.value = 'salmon_fillet_brine';
          packageSelect.value = 'barrier_tray_alox';
          powerRange.value = '85';
          pressureRange.value = '4.0';
          waterTempRange.value = '116';
          timeRange.value = '130';
          thicknessRange.value = '20';
          saltRange.value = '1.8';
          flowToggle.checked = true;
          tunerToggle.checked = true;
        } else if (type === 'potato') {
          machineSelect.value = 'commercial_industrial_mats';
          foodSelect.value = 'mashed_potato_dairy';
          packageSelect.value = 'barrier_tray_alox';
          powerRange.value = '90';
          pressureRange.value = '3.5';
          waterTempRange.value = '120';
          timeRange.value = '180';
          thicknessRange.value = '32';
          saltRange.value = '0.8';
          flowToggle.checked = true;
          tunerToggle.checked = true;
        } else if (type === 'catastrophic') {
          machineSelect.value = 'compromised_unbalanced_mats';
          foodSelect.value = 'salmon_fillet_brine';
          packageSelect.value = 'thin_barrier_compromised';
          powerRange.value = '115';
          pressureRange.value = '1.5';
          waterTempRange.value = '124';
          timeRange.value = '280';
          thicknessRange.value = '40';
          saltRange.value = '2.4';
          flowToggle.checked = false;
          tunerToggle.checked = false;
        }
        recalculate();
      });
    });

    // Copy Telemetry Report to Clipboard
    if (copyReportBtn) {
      copyReportBtn.addEventListener('click', () => {
        const report = `=== ISITKITCHENSAFE MATS STERILIZATION TELEMETRY REPORT ===
Timestamp: ${new Date().toISOString()}
System: ${machineSelect.selectedOptions[0].text}
Food Matrix: ${foodSelect.selectedOptions[0].text}
Packaging: ${packageSelect.selectedOptions[0].text}
Parameters: Power=${powerRange.value} kW | Counter-Pressure=${pressureRange.value} bar | Water Temp=${waterTempRange.value}°C | Time=${timeRange.value}s | Thickness=${thicknessRange.value}mm | Salt=${saltRange.value}%
Telemetry:
- 915 MHz Penetration Depth: ${telPenDepth.textContent}
- Center Fo Lethality: ${telF0.textContent} (Clostridium botulinum 12D)
- Center Cold-Spot Temp: ${telTCenter.textContent}
- Corner/Edge Hot-Spot Temp: ${telTEdge.textContent}
- Thermal Inversion Ratio: ${telInversion.textContent}
- Internal Pouch Pressure: ${telPPackage.textContent}
- Seam Differential ΔP: ${telDeltaP.textContent}
- RF Radiation Leakage: ${telRf.textContent}
Compliance: ${statusText.textContent}
==========================================================`;

        navigator.clipboard.writeText(report).then(() => {
          const original = copyBtnText.textContent;
          copyBtnText.textContent = "Copied!";
          setTimeout(() => { copyBtnText.textContent = original; }, 2000);
        });
      });
    }

    // Initial calculation
    recalculate();
  }

  // Run on DOM load and Astro page swap
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMatsModeler);
  } else {
    initMatsModeler();
  }
  document.addEventListener('astro:page-load', initMatsModeler);
</script>
