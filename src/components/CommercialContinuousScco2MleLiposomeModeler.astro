    presetResveratrol: "クリーンラベル・トランスレスベラトロール (200 bar, 40°C, 20 wt%, FRR 8:1, d_h 62 nm, PDI 0.082, 包摂率 97.2%, 非GMO)",
    presetVitaminC: "高処理果汁用アスコルビン酸ナノ強化 (160 bar, 36°C, 15 wt%, FRR 6:1, d_h 68 nm, PDI 0.095, 包摂率 93.8%, 850 L/h)",
    presetHazard: "非合焦ノズル欠陥・有毒残留溶媒事故 (70 bar, 55°C, 5 wt%, FRR 2:1, d_h 380 nm, PDI 0.42, USP <467> 違反)",
    telemetryTitle: "リアルタイムナノキネティクステレメトリ＆診断レーダー",
    telemetrySub: "平均粒子径、多分散度 (PDI)、包摂効率、法規制準拠性の連続算出。",
    vesicleSizeLabel: "平均流体力学的直径 (d_h):",
    pdiLabel: "多分散指数 (PDI):",
    encapsulationEfficiencyLabel: "包摂効率 (EE %):",
    bioavailabilityLabel: "生体利用率向上倍率:",
    gastricSurvivalLabel: "胃酸通過残存率 (pH 1.8):",
    residualSolventLabel: "有機残留溶媒量:",
    colloidalStabilityLabel: "常温分散安定保存期間:",
    secLabel: "比エネルギー消費量 (SEC kWh/L):",
    co2RecycleLabel: "CO2クローズドループ回収率:",
    complianceVerdictLabel: "FDA cGMP & USP <467> 判定:",
    diagramTitle: "連続scCO2-MLEマイクロ流体水力学＆脱気系統図",
    diagramSub: "デュアルシース水流合流、超臨界CO2脂質可塑化、ミリ秒単位小胞形成、無剪切マイルド減圧分離。",
    scienceTitle: "超臨界マイクロ流体工学と自己組織化理論",
    scienceSub: "界面張力消失現象、Rayleigh-Taylor拡散速度論、無溶媒小胞自己核生成。",
    tableTitle: "サニタリーエンジニアリング＆法規制準拠マトリックス",
    exportAuditBtn: "適合性監査証書の発行 (PDF / JSON)"
  }
};

const d = DICT[lang] || DICT.en;
---

<div class="scco2-mle-modeler-container space-y-10" id="scco2-mle-modeler">
  <!-- Header Badge & Intro -->
  <header class="border-b border-hairline/60 pb-6">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-sky-950 text-sky-300 border border-sky-800 mb-3">
      <span class="inline-block w-2 h-2 rounded-full bg-sky-400 animate-pulse"></span>
      {d.badge}
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-ink tracking-tight mb-3">
      {d.title}
    </h1>
    <p class="text-body text-base leading-relaxed text-muted max-w-4xl">
      {d.subtitle}
    </p>
  </header>

  <!-- Industrial Presets Bar -->
  <section class="bg-surface-soft border border-hairline rounded-2xl p-5 shadow-xs">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 mb-3">
      <h2 class="text-sm font-bold text-ink uppercase tracking-wider flex items-center gap-2">
        <svg class="w-4 h-4 text-sky-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        {d.presetsTitle}
      </h2>
      <span class="text-xs text-muted font-mono">1-Click cGMP Validated Setup</span>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-2">
      <button type="button" data-preset="curcumin" class="preset-btn text-left p-3 rounded-xl border border-hairline/80 bg-surface hover:bg-amber-950/20 hover:border-amber-700 transition text-xs font-medium text-ink flex flex-col gap-1">
        <span class="text-amber-400 font-bold">🟡 Curcumin Nanoliposomes</span>
        <span class="text-muted line-clamp-1">{d.presetCurcumin}</span>
      </button>
      <button type="button" data-preset="glutathione" class="preset-btn text-left p-3 rounded-xl border border-hairline/80 bg-surface hover:bg-sky-950/20 hover:border-sky-700 transition text-xs font-medium text-ink flex flex-col gap-1">
        <span class="text-sky-400 font-bold">💧 GSH Gastric Shield</span>
        <span class="text-muted line-clamp-1">{d.presetGlutathione}</span>
      </button>
      <button type="button" data-preset="resveratrol" class="preset-btn text-left p-3 rounded-xl border border-hairline/80 bg-surface hover:bg-purple-950/20 hover:border-purple-700 transition text-xs font-medium text-ink flex flex-col gap-1">
        <span class="text-purple-400 font-bold">🍇 Trans-Resveratrol Non-GMO</span>
        <span class="text-muted line-clamp-1">{d.presetResveratrol}</span>
      </button>
      <button type="button" data-preset="vitaminc" class="preset-btn text-left p-3 rounded-xl border border-hairline/80 bg-surface hover:bg-emerald-950/20 hover:border-emerald-700 transition text-xs font-medium text-ink flex flex-col gap-1">
        <span class="text-emerald-400 font-bold">🍊 High-Speed Vitamin C</span>
        <span class="text-muted line-clamp-1">{d.presetVitaminC}</span>
      </button>
      <button type="button" data-preset="hazard" class="preset-btn text-left p-3 rounded-xl border border-red-900/60 bg-red-950/20 hover:bg-red-950/40 hover:border-red-600 transition text-xs font-medium text-red-200 flex flex-col gap-1">
        <span class="text-red-400 font-bold">🚨 Solvent Hazard Failure</span>
        <span class="text-red-300/80 line-clamp-1">{d.presetHazard}</span>
      </button>
    </div>
  </section>

  <!-- Interactive Simulator Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Controls Form (Left Column, 7 Cols) -->
    <div class="lg:col-span-7 bg-surface-soft border border-hairline rounded-2xl p-6 sm:p-7 shadow-xs space-y-6">
      <div class="border-b border-hairline/60 pb-4">
        <h2 class="text-lg font-bold text-ink tracking-tight flex items-center gap-2">
          <svg class="w-5 h-5 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/></svg>
          {d.controlsTitle}
        </h2>
        <p class="text-xs text-muted mt-1">{d.controlsSub}</p>
      </div>

      <!-- Selectors Group -->
      <div class="space-y-4">
        <!-- Skid Architecture -->
        <div>
          <label for="skid-select" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-1">
            {d.skidLabel}
          </label>
          <select id="skid-select" class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-xs font-medium text-ink focus:outline-hidden focus:border-sky-500">
            {scco2MleData.systemArchitectures.map(s => (
              <option value={s.id}>{s.name} ({s.minOperatingPressureBar}–{s.maxOperatingPressureBar} bar)</option>
            ))}
          </select>
          <p class="text-[11px] text-muted mt-1">{d.skidHelp}</p>
        </div>

        <!-- Bioactive Payload -->
        <div>
          <label for="payload-select" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-1">
            {d.payloadLabel}
          </label>
          <select id="payload-select" class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-xs font-medium text-ink focus:outline-hidden focus:border-sky-500">
            {scco2MleData.bioactivePayloads.map(b => (
              <option value={b.id}>{b.name}</option>
            ))}
          </select>
          <p class="text-[11px] text-muted mt-1">{d.payloadHelp}</p>
        </div>

        <!-- Lipid Matrix -->
        <div>
          <label for="lipid-select" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-1">
            {d.lipidLabel}
          </label>
          <select id="lipid-select" class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-xs font-medium text-ink focus:outline-hidden focus:border-sky-500">
            {scco2MleData.lipidMatrices.map(l => (
              <option value={l.id}>{l.name}</option>
            ))}
          </select>
          <p class="text-[11px] text-muted mt-1">{d.lipidHelp}</p>
        </div>

        <!-- Chamber & Letdown Mechanism -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="chamber-select" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-1">
              {d.chamberLabel}
            </label>
            <select id="chamber-select" class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-xs font-medium text-ink focus:outline-hidden focus:border-sky-500">
              {scco2MleData.microfluidicChambers.map(c => (
                <option value={c.id}>{c.name}</option>
              ))}
            </select>
            <p class="text-[11px] text-muted mt-1">{d.chamberHelp}</p>
          </div>

          <div>
            <label for="letdown-select" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-1">
              {d.letdownLabel}
            </label>
            <select id="letdown-select" class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-xs font-medium text-ink focus:outline-hidden focus:border-sky-500">
              {scco2MleData.letdownMechanisms.map(m => (
                <option value={m.id}>{m.name}</option>
              ))}
            </select>
            <p class="text-[11px] text-muted mt-1">{d.letdownHelp}</p>
          </div>
        </div>
      </div>

      <!-- Sliders Group -->
      <div class="space-y-5 pt-4 border-t border-hairline/60">
        <!-- Operating Pressure -->
        <div>
          <div class="flex justify-between items-center mb-1">
            <label for="pressure-slider" class="text-xs font-semibold text-ink">{d.pressureLabel}</label>
            <span id="pressure-val" class="font-mono text-xs font-bold text-sky-400 bg-sky-950/60 px-2 py-0.5 rounded-md border border-sky-800">220.0 bar</span>
          </div>
          <input type="range" id="pressure-slider" min="100.0" max="280.0" step="1.0" value="220.0" class="w-full accent-sky-500 cursor-pointer" />
          <div class="flex justify-between text-[10px] text-muted font-mono mt-0.5">
            <span>100.0 bar</span>
            <span>180.0 bar</span>
            <span>280.0 bar</span>
          </div>
        </div>

        <!-- Temperature -->
        <div>
          <div class="flex justify-between items-center mb-1">
            <label for="temp-slider" class="text-xs font-semibold text-ink">{d.tempLabel}</label>
            <span id="temp-val" class="font-mono text-xs font-bold text-amber-400 bg-amber-950/60 px-2 py-0.5 rounded-md border border-amber-800">42.0 °C</span>
          </div>
          <input type="range" id="temp-slider" min="35.0" max="52.0" step="0.5" value="42.0" class="w-full accent-amber-500 cursor-pointer" />
          <div class="flex justify-between text-[10px] text-muted font-mono mt-0.5">
            <span>35.0 °C</span>
            <span>42.0 °C (Optimal)</span>
            <span>52.0 °C</span>
          </div>
        </div>

        <!-- scCO2 Mass Ratio -->
        <div>
          <div class="flex justify-between items-center mb-1">
            <label for="co2-slider" class="text-xs font-semibold text-ink">{d.co2RatioLabel}</label>
            <span id="co2-val" class="font-mono text-xs font-bold text-teal-400 bg-teal-950/60 px-2 py-0.5 rounded-md border border-teal-800">22.0 wt%</span>
          </div>
          <input type="range" id="co2-slider" min="10.0" max="30.0" step="0.5" value="22.0" class="w-full accent-teal-500 cursor-pointer" />
          <div class="flex justify-between text-[10px] text-muted font-mono mt-0.5">
            <span>10.0 wt%</span>
            <span>20.0 wt%</span>
            <span>30.0 wt%</span>
          </div>
        </div>

        <!-- Flow Rate Ratio (FRR) -->
        <div>
          <div class="flex justify-between items-center mb-1">
            <label for="frr-slider" class="text-xs font-semibold text-ink">{d.frrLabel}</label>
            <span id="frr-val" class="font-mono text-xs font-bold text-purple-400 bg-purple-950/60 px-2 py-0.5 rounded-md border border-purple-800">9.0 : 1</span>
          </div>
          <input type="range" id="frr-slider" min="3.0" max="15.0" step="0.5" value="9.0" class="w-full accent-purple-500 cursor-pointer" />
          <div class="flex justify-between text-[10px] text-muted font-mono mt-0.5">
            <span>3.0 : 1</span>
            <span>9.0 : 1 (Target)</span>
            <span>15.0 : 1</span>
          </div>
        </div>

        <!-- Throughput -->
        <div>
          <div class="flex justify-between items-center mb-1">
            <label for="throughput-slider" class="text-xs font-semibold text-ink">{d.throughputLabel}</label>
            <span id="throughput-val" class="font-mono text-xs font-bold text-sky-300 bg-sky-950/60 px-2 py-0.5 rounded-md border border-sky-800">750 L/h</span>
          </div>
          <input type="range" id="throughput-slider" min="20" max="1800" step="10" value="750" class="w-full accent-sky-500 cursor-pointer" />
          <div class="flex justify-between text-[10px] text-muted font-mono mt-0.5">
            <span>20 L/h</span>
            <span>750 L/h</span>
            <span>1800 L/h</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Telemetry Radar & KPI Dashboard (Right Column, 5 Cols) -->
    <div class="lg:col-span-5 space-y-6">
      <div class="bg-surface-soft border border-hairline rounded-2xl p-6 sm:p-7 shadow-xs">
        <div class="border-b border-hairline/60 pb-3 mb-5 flex items-center justify-between">
          <div>
            <h2 class="text-lg font-bold text-ink tracking-tight flex items-center gap-2">
              <svg class="w-5 h-5 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
              {d.telemetryTitle}
            </h2>
            <p class="text-xs text-muted mt-0.5">{d.telemetrySub}</p>
          </div>
          <span id="status-pill" class="px-2.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-sky-950 text-sky-300 border border-sky-800 font-mono">
            OPTIMAL
          </span>
        </div>

        <!-- Key Metrics Cards -->
        <div class="space-y-3.5">
          <!-- Vesicle Size & PDI -->
          <div class="grid grid-cols-2 gap-3">
            <div class="p-3.5 rounded-xl bg-surface border border-hairline">
              <span class="text-[11px] text-muted block mb-1">{d.vesicleSizeLabel}</span>
              <div class="flex items-baseline gap-1">
                <span id="vesicle-size-metric" class="text-2xl font-black font-mono text-sky-400">54.0</span>
                <span class="text-xs text-muted font-mono">nm</span>
              </div>
              <span id="vesicle-size-sub" class="text-[10px] text-emerald-400 font-mono block mt-1">Sub-100nm Unilamellar</span>
            </div>

            <div class="p-3.5 rounded-xl bg-surface border border-hairline">
              <span class="text-[11px] text-muted block mb-1">{d.pdiLabel}</span>
              <div class="flex items-baseline gap-1">
                <span id="pdi-metric" class="text-2xl font-black font-mono text-teal-400">0.078</span>
              </div>
              <span id="pdi-sub" class="text-[10px] text-emerald-400 font-mono block mt-1">Ultra-Monodisperse</span>
            </div>
          </div>

          <!-- Encapsulation Efficiency & Bioavailability -->
          <div class="grid grid-cols-2 gap-3">
            <div class="p-3.5 rounded-xl bg-surface border border-hairline">
              <span class="text-[11px] text-muted block mb-1">{d.encapsulationEfficiencyLabel}</span>
              <div class="flex items-baseline gap-1">
                <span id="ee-metric" class="text-2xl font-black font-mono text-emerald-400">97.8</span>
                <span class="text-xs text-muted font-mono">%</span>
              </div>
              <span id="ee-sub" class="text-[10px] text-muted font-mono block mt-1">&gt;95% Target Met</span>
            </div>

            <div class="p-3.5 rounded-xl bg-surface border border-hairline">
              <span class="text-[11px] text-muted block mb-1">{d.bioavailabilityLabel}</span>
              <div class="flex items-baseline gap-1">
                <span id="bioavail-metric" class="text-2xl font-black font-mono text-amber-400">18.5</span>
                <span class="text-xs text-muted font-mono">x</span>
              </div>
              <span id="bioavail-sub" class="text-[10px] text-amber-400 font-mono block mt-1">Elevated GI Absorption</span>
            </div>
