          <text x="625" y="105" fill="#34d399" font-size="9" text-anchor="middle" font-family="monospace">Controlled Letdown (12 bar/s)</text>
          
          <!-- Upward CO2 Recovery Path -->
          <path d="M 625 125 L 625 45" stroke="#2dd4bf" stroke-width="2" stroke-dasharray="3 3"/>
          <polygon points="625,35 621,46 629,46" fill="#2dd4bf"/>
          <text x="625" y="28" fill="#2dd4bf" font-size="9.5" font-weight="bold" text-anchor="middle" font-family="monospace">&gt;95.5% CO2 Recycled</text>

          <text x="625" y="150" fill="#a7f3d0" font-size="9.5" text-anchor="middle">Zero Cavitation Shear</text>
          <text x="625" y="168" fill="#6ee7b7" font-size="9" font-family="monospace" text-anchor="middle">Residual Solvent: 0.0 ppm</text>
          <text x="625" y="186" fill="#94a3b8" font-size="8.5" text-anchor="middle">Induction Anti-Freeze Shield</text>
        </g>

        <!-- Output Arrow to Packaging -->
        <line x1="710" y1="140" x2="760" y2="140" stroke="#10b981" stroke-width="3"/>
        <polygon points="768,140 758,135 758,145" fill="#10b981"/>

        <!-- Finished Formulation Reservoir -->
        <g id="finished-dispersion">
          <rect x="770" y="95" width="90" height="90" rx="10" fill="#0f172a" stroke="#38bdf8" stroke-width="1.5"/>
          <text x="815" y="122" fill="#38bdf8" font-size="10" font-weight="bold" text-anchor="middle">Finished Bulk</text>
          <text x="815" y="138" fill="#f8fafc" font-size="11" font-weight="bold" font-family="monospace" text-anchor="middle">Nanoliposomes</text>
          <text x="815" y="154" fill="#a7f3d0" font-size="9" text-anchor="middle" font-family="monospace">EE: 97.8%</text>
          <text x="815" y="168" fill="#94a3b8" font-size="8" text-anchor="middle">Aseptic Fill Loop</text>
        </g>
      </svg>
    </div>
  </section>

  <!-- Science & Thermodynamic Principles -->
  <section class="bg-surface-soft border border-hairline rounded-2xl p-6 sm:p-7 shadow-xs space-y-4">
    <div class="border-b border-hairline/60 pb-3">
      <h2 class="text-lg font-bold text-ink tracking-tight flex items-center gap-2">
        <svg class="w-5 h-5 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
        {d.scienceTitle}
      </h2>
      <p class="text-xs text-muted mt-1">{d.scienceSub}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 text-xs text-body leading-relaxed">
      <div class="p-4 rounded-xl bg-surface border border-hairline space-y-2">
        <h3 class="font-bold text-ink text-sm text-sky-400">1. Supercritical Bilayer Plasticization</h3>
        <p class="text-muted">
          Supercritical CO2 (T_c = 31.1°C, P_c = 73.8 bar) acts as a high-density, lipophilic solvent that easily permeates phospholipid bilayers. It lowers the acyl chain phase transition temperature (Tm), dissolving phospholipid aggregates into a plasticized, low-viscosity fluid without requiring toxic chlorinated or alkane co-solvents like chloroform or hexane.
        </p>
      </div>

      <div class="p-4 rounded-xl bg-surface border border-hairline space-y-2">
        <h3 class="font-bold text-ink text-sm text-teal-400">2. Hydrodynamic Focusing Self-Assembly</h3>
        <p class="text-muted">
          In planar and staggered herringbone microchannels, aqueous buffer sheaths compress the lipid/scCO2 center stream into a liquid lamella less than 5 µm thick. Intermolecular mutual diffusion occurs on a sub-millisecond timescale (Rayleigh-Taylor diffusion time &tau; &lt; 1.2 ms), driving spontaneous thermodynamically favored bilayer curvature and vesicle closure into monodisperse unilamellar liposomes (PDI &lt; 0.08).
        </p>
      </div>

      <div class="p-4 rounded-xl bg-surface border border-hairline space-y-2">
        <h3 class="font-bold text-ink text-sm text-emerald-400">3. Non-Cavitative Capillary Letdown</h3>
        <p class="text-muted">
          Unlike high-pressure homogenizers that induce ultrasonic cavitation and shockwave shear (destroying up to 45% of encapsulated macromolecules), scCO2-MLE uses heated capillary letdown restrictors (dP/dt &approx; 12 bar/s). Carbon dioxide desorbs smoothly as harmless gas, leaving 0.0 ppm volatile organic residues while retaining &gt;97% payload integrity.
        </p>
      </div>
    </div>
  </section>

  <!-- Regulatory Compliance Table -->
  <section class="bg-surface-soft border border-hairline rounded-2xl p-6 sm:p-7 shadow-xs space-y-4">
    <div class="border-b border-hairline/60 pb-3">
      <h2 class="text-lg font-bold text-ink tracking-tight flex items-center gap-2">
        <svg class="w-5 h-5 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        {d.tableTitle}
      </h2>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs border-collapse">
        <thead>
          <tr class="border-b border-hairline text-muted uppercase tracking-wider font-mono">
            <th class="py-2.5 px-3">Regulatory Code</th>
            <th class="py-2.5 px-3">Agency</th>
            <th class="py-2.5 px-3">Compliance Scope</th>
            <th class="py-2.5 px-3">Engineering Mandate</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline/60 text-ink">
          {scco2MleData.regulatoryStandards.map(r => (
            <tr class="hover:bg-surface/50 transition">
              <td class="py-2.5 px-3 font-bold font-mono text-sky-400 whitespace-nowrap">{r.standard}</td>
              <td class="py-2.5 px-3 text-muted">{r.authority}</td>
              <td class="py-2.5 px-3">{r.scope}</td>
              <td class="py-2.5 px-3 text-muted text-[11px] leading-relaxed">{r.requirement}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</div>

<script>
  function initScco2MleModeler() {
    const root = document.getElementById('scco2-mle-modeler');
    if (!root) return;

    // Controls
    const skidSelect = document.getElementById('skid-select') as HTMLSelectElement;
    const payloadSelect = document.getElementById('payload-select') as HTMLSelectElement;
    const lipidSelect = document.getElementById('lipid-select') as HTMLSelectElement;
    const chamberSelect = document.getElementById('chamber-select') as HTMLSelectElement;
    const letdownSelect = document.getElementById('letdown-select') as HTMLSelectElement;

    const pressureSlider = document.getElementById('pressure-slider') as HTMLInputElement;
    const tempSlider = document.getElementById('temp-slider') as HTMLInputElement;
    const co2Slider = document.getElementById('co2-slider') as HTMLInputElement;
    const frrSlider = document.getElementById('frr-slider') as HTMLInputElement;
    const throughputSlider = document.getElementById('throughput-slider') as HTMLInputElement;

    // Value Labels
    const pressureVal = document.getElementById('pressure-val');
    const tempVal = document.getElementById('temp-val');
    const co2Val = document.getElementById('co2-val');
    const frrVal = document.getElementById('frr-val');
    const throughputVal = document.getElementById('throughput-val');

    // Telemetry Outputs
    const vesicleSizeMetric = document.getElementById('vesicle-size-metric');
    const vesicleSizeSub = document.getElementById('vesicle-size-sub');
    const pdiMetric = document.getElementById('pdi-metric');
    const pdiSub = document.getElementById('pdi-sub');
    const eeMetric = document.getElementById('ee-metric');
    const eeSub = document.getElementById('ee-sub');
    const bioavailMetric = document.getElementById('bioavail-metric');
    const gastricMetric = document.getElementById('gastric-metric');
    const solventMetric = document.getElementById('solvent-metric');
    const stabilityVal = document.getElementById('stability-val');
    const secVal = document.getElementById('sec-val');
    const co2RecycleVal = document.getElementById('co2-recycle-val');
    const statusPill = document.getElementById('status-pill');
    const complianceBanner = document.getElementById('compliance-banner');
    const complianceTitle = document.getElementById('compliance-title');
    const complianceDesc = document.getElementById('compliance-desc');
    const exportBtn = document.getElementById('export-audit-btn');

    function calculateMetrics() {
      const p = parseFloat(pressureSlider.value);
      const t = parseFloat(tempSlider.value);
      const wCO2 = parseFloat(co2Slider.value);
      const frr = parseFloat(frrSlider.value);
      const q = parseFloat(throughputSlider.value);

      const payloadId = payloadSelect.value;
      const lipidId = lipidSelect.value;
      const chamberId = chamberSelect.value;
      const letdownId = letdownSelect.value;

      // Label Updates
      if (pressureVal) pressureVal.textContent = `${p.toFixed(1)} bar`;
      if (tempVal) tempVal.textContent = `${t.toFixed(1)} °C`;
      if (co2Val) co2Val.textContent = `${wCO2.toFixed(1)} wt%`;
      if (frrVal) frrVal.textContent = `${frr.toFixed(1)} : 1`;
      if (throughputVal) throughputVal.textContent = `${q} L/h`;

      // Hazard Check
      const isHazardPayload = payloadId === 'degraded_residual_solvent_slurry_hazard';
      const isHazardChamber = chamberId === 'unfocused_turbulent_orifice_bypass_hazard';

      if (isHazardPayload || isHazardChamber || p < 110 || wCO2 < 12) {
        // Severe defect / violation state
        const size = isHazardChamber ? (380 + (p - 100) * 0.4) : (310 + (280 - p) * 0.3);
        const pdi = isHazardChamber ? 0.44 : 0.38;
        const ee = isHazardPayload ? 34.0 : 52.0;
        const bioavail = 1.0;
        const gastric = 28.0;
        const solvent = isHazardPayload ? 680.0 : 12.0;

        if (vesicleSizeMetric) vesicleSizeMetric.textContent = size.toFixed(1);
        if (vesicleSizeSub) {
          vesicleSizeSub.textContent = 'Large Polydisperse Aggregates';
          vesicleSizeSub.className = 'text-[10px] text-red-400 font-mono block mt-1';
        }
        if (pdiMetric) {
          pdiMetric.textContent = pdi.toFixed(3);
          pdiMetric.className = 'text-2xl font-black font-mono text-red-400';
        }
        if (pdiSub) {
          pdiSub.textContent = 'Severe Broad Size Dispersion (PDI > 0.3)';
          pdiSub.className = 'text-[10px] text-red-400 font-mono block mt-1';
        }
        if (eeMetric) {
          eeMetric.textContent = ee.toFixed(1);
          eeMetric.className = 'text-2xl font-black font-mono text-red-400';
        }
        if (eeSub) eeSub.textContent = 'High Payload Leakage';
        if (bioavailMetric) bioavailMetric.textContent = bioavail.toFixed(1);
        if (gastricMetric) gastricMetric.textContent = `${gastric.toFixed(1)}%`;
        if (solventMetric) {
          solventMetric.textContent = solvent.toFixed(1);
          solventMetric.className = 'text-xl font-black font-mono text-red-400';
        }
        if (stabilityVal) stabilityVal.textContent = '< 1 Month (Precipitation)';
        if (secVal) secVal.textContent = '0.78 kWh / L (Excess Pump Heat)';
        if (co2RecycleVal) co2RecycleVal.textContent = '62.0% (Vented Lost)';

        if (statusPill) {
          statusPill.textContent = 'CRITICAL DEFECT';
          statusPill.className = 'px-2.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-red-950 text-red-300 border border-red-800 font-mono';
        }
        if (complianceBanner) {
          complianceBanner.className = 'p-4 rounded-xl border bg-red-950/40 border-red-800 text-xs text-red-200 flex items-start gap-3';
        }
        if (complianceTitle) {
          complianceTitle.textContent = 'FAILS FDA cGMP & USP <467> SOLVENT SPECIFICATION';
          complianceTitle.className = 'font-bold block text-sm text-red-300';
        }
        if (complianceDesc) {
          complianceDesc.textContent = `CRITICAL VIOLATION: Residual solvent levels (${solvent.toFixed(1)} ppm) exceed USP <467> statutory limit. Broad polydispersity (PDI ${pdi.toFixed(2)}) and vesicle shear collapse violate FDA 21 CFR § 111 cGMP rules.`;
        }
        return;
      }

      // Normal Optimal / High Performance Calculation
      // 1. Vesicle Size (d_h nm): Governed by FRR and pressure
      // Higher FRR -> smaller lamella -> smaller diameter (45 - 85 nm)
      let baseDiameter = 82.0 - (frr - 3.0) * 2.8 - (p - 100.0) * 0.08;
      if (lipidId === 'hydrogenated_soy_pc_cholesterol_matrix') baseDiameter += 6.0;
      if (chamberId === 'staggered_herringbone_grooved_mixer') baseDiameter -= 4.0;
      const finalDiameter = Math.max(45.0, Math.min(95.0, baseDiameter));

      // 2. Polydispersity Index (PDI): 0.055 to 0.110
      let basePdi = 0.098 - (p - 100.0) * 0.00015 - (frr - 3.0) * 0.002;
      if (chamberId === 'staggered_herringbone_grooved_mixer') basePdi -= 0.018;
      if (chamberId === 'coaxial_3d_annular_capillary_injector') basePdi -= 0.012;
      const finalPdi = Math.max(0.052, Math.min(0.120, basePdi));

      // 3. Encapsulation Efficiency (EE %): 92.5% to 98.8%
      let baseEE = 94.0 + (p - 100.0) * 0.02 + (wCO2 - 10.0) * 0.12;
      if (payloadId === 'curcumin_lipophilic_polyphenol') baseEE += 1.5;
      if (payloadId === 'trans_resveratrol_stilbene') baseEE += 1.2;
      if (letdownId === 'multi_stage_capillary_letdown_restrictor') baseEE += 0.8;
      const finalEE = Math.max(90.0, Math.min(98.8, baseEE));

      // 4. Bioavailability enhancement
      let bioFactor = 12.0;
      if (payloadId === 'curcumin_lipophilic_polyphenol') bioFactor = 18.5;
      else if (payloadId === 'quercetin_flavonol') bioFactor = 22.0;
      else if (payloadId === 'trans_resveratrol_stilbene') bioFactor = 14.2;
      else if (payloadId === 'glutathione_hydrophilic_tripeptide') bioFactor = 9.4;
      else if (payloadId === 'pure_l_ascorbic_acid_vitamin_c') bioFactor = 4.8;

      // 5. Gastric acid bypass survival
      let gastricSurvival = 94.0;
      if (lipidId === 'hydrogenated_soy_pc_cholesterol_matrix') gastricSurvival = 97.8;
      else if (lipidId === 'dppc_dmpg_anionic_stealth_matrix') gastricSurvival = 96.5;

      // 6. Specific Energy Consumption SEC
      const sec = (0.26 + (p / 280.0) * 0.14).toFixed(2);
      const co2Recycle = (94.0 + (wCO2 / 30.0) * 2.2).toFixed(1);

      // DOM Updates
      if (vesicleSizeMetric) vesicleSizeMetric.textContent = finalDiameter.toFixed(1);
      if (vesicleSizeSub) {
        vesicleSizeSub.textContent = 'Sub-100nm Monodisperse';
        vesicleSizeSub.className = 'text-[10px] text-emerald-400 font-mono block mt-1';
      }
      if (pdiMetric) {
        pdiMetric.textContent = finalPdi.toFixed(3);
        pdiMetric.className = 'text-2xl font-black font-mono text-teal-400';
      }
      if (pdiSub) {
        pdiSub.textContent = 'Near-Zero Polydispersity (PDI < 0.1)';
        pdiSub.className = 'text-[10px] text-emerald-400 font-mono block mt-1';
      }
      if (eeMetric) {
        eeMetric.textContent = finalEE.toFixed(1);
        eeMetric.className = 'text-2xl font-black font-mono text-emerald-400';
      }
      if (eeSub) eeSub.textContent = '>95% Target Met';
      if (bioavailMetric) bioavailMetric.textContent = bioFactor.toFixed(1);
      if (gastricMetric) gastricMetric.textContent = `${gastricSurvival.toFixed(1)}%`;
      if (solventMetric) {
        solventMetric.textContent = '0.0';
        solventMetric.className = 'text-xl font-black font-mono text-emerald-400';
      }
      if (stabilityVal) stabilityVal.textContent = '18–24 Months (Colloidal Intact)';
      if (secVal) secVal.textContent = `${sec} kWh / L`;
      if (co2RecycleVal) co2RecycleVal.textContent = `${co2Recycle}% Recompressed`;

      if (statusPill) {
        statusPill.textContent = 'cGMP OPTIMAL';
        statusPill.className = 'px-2.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-emerald-950 text-emerald-300 border border-emerald-800 font-mono';
      }
      if (complianceBanner) {
        complianceBanner.className = 'p-4 rounded-xl border bg-emerald-950/30 border-emerald-800 text-xs text-emerald-200 flex items-start gap-3';
      }
      if (complianceTitle) {
        complianceTitle.textContent = 'FDA 21 CFR § 111/117 & USP <467> COMPLIANT';
        complianceTitle.className = 'font-bold block text-sm text-emerald-300';
      }
      if (complianceDesc) {
        complianceDesc.textContent = `Solvent-free nanoliposomes (d_h ${finalDiameter.toFixed(1)} nm, PDI ${finalPdi.toFixed(3)}) satisfy USP <467> clean-label rules with 0.0 ppm volatile organic solvents, >${finalEE.toFixed(1)}% encapsulation efficiency, and validated aseptic cGMP stability.`;
      }
    }

    // Event Listeners
    [skidSelect, payloadSelect, lipidSelect, chamberSelect, letdownSelect].forEach(sel => {
      sel?.addEventListener('change', calculateMetrics);
    });

    [pressureSlider, tempSlider, co2Slider, frrSlider, throughputSlider].forEach(sld => {
      sld?.addEventListener('input', calculateMetrics);
    });

    // Preset Buttons
    root.querySelectorAll('.preset-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const p = btn.getAttribute('data-preset');
        if (p === 'curcumin') {
          payloadSelect.value = 'curcumin_lipophilic_polyphenol';
          lipidSelect.value = 'purified_soy_pc_95';
          chamberSelect.value = 'planar_hydrodynamic_focusing_nozzle';
          letdownSelect.value = 'multi_stage_capillary_letdown_restrictor';
          pressureSlider.value = '220.0';
          tempSlider.value = '42.0';
          co2Slider.value = '22.0';
          frrSlider.value = '9.0';
          throughputSlider.value = '750';
        } else if (p === 'glutathione') {
          payloadSelect.value = 'glutathione_hydrophilic_tripeptide';
          lipidSelect.value = 'hydrogenated_soy_pc_cholesterol_matrix';
          chamberSelect.value = 'staggered_herringbone_grooved_mixer';
          letdownSelect.value = 'multi_stage_capillary_letdown_restrictor';
          pressureSlider.value = '180.0';
          tempSlider.value = '38.0';
          co2Slider.value = '18.0';
          frrSlider.value = '11.0';
          throughputSlider.value = '350';
        } else if (p === 'resveratrol') {
          payloadSelect.value = 'trans_resveratrol_stilbene';
          lipidSelect.value = 'sunflower_non_gmo_lecithin_dopc';
          chamberSelect.value = 'planar_hydrodynamic_focusing_nozzle';
          letdownSelect.value = 'counter_current_bubble_stripping_column';
          pressureSlider.value = '200.0';
          tempSlider.value = '40.0';
          co2Slider.value = '20.0';
          frrSlider.value = '8.0';
          throughputSlider.value = '600';
        } else if (p === 'vitaminc') {
          payloadSelect.value = 'pure_l_ascorbic_acid_vitamin_c';
          lipidSelect.value = 'purified_soy_pc_95';
          chamberSelect.value = 'coaxial_3d_annular_capillary_injector';
          letdownSelect.value = 'multi_stage_capillary_letdown_restrictor';
          pressureSlider.value = '160.0';
          tempSlider.value = '36.0';
          co2Slider.value = '15.0';
          frrSlider.value = '6.0';
          throughputSlider.value = '850';
        } else if (p === 'hazard') {
          payloadSelect.value = 'degraded_residual_solvent_slurry_hazard';
          lipidSelect.value = 'purified_soy_pc_95';
          chamberSelect.value = 'unfocused_turbulent_orifice_bypass_hazard';
          letdownSelect.value = 'supersonic_isenthalpic_flash_nozzle';
          pressureSlider.value = '100.0';
          tempSlider.value = '52.0';
          co2Slider.value = '10.0';
          frrSlider.value = '3.0';
          throughputSlider.value = '1200';
        }
        calculateMetrics();
      });
    });

    // Export Audit Certificate
    exportBtn?.addEventListener('click', () => {
      const p = pressureSlider.value;
      const t = tempSlider.value;
      const w = co2Slider.value;
      const frr = frrSlider.value;
      const size = vesicleSizeMetric?.textContent || '54.0';
      const pdi = pdiMetric?.textContent || '0.078';
      const ee = eeMetric?.textContent || '97.8';

      const cert = {
        certificateType: "Continuous scCO2-MLE Nanoliposome cGMP Process Verification",
        standard: "FDA 21 CFR § 111 & 117 / USP <467> / ASME BPVC Section VIII",
        timestamp: new Date().toISOString(),
        operatingParameters: {
          supercriticalPressureBar: p,
          processTemperatureC: t,
          co2MassRatioPct: w,
          flowRateRatioFRR: frr
        },
        nanokineticResults: {
          hydrodynamicDiameterNm: size,
          polydispersityIndex: pdi,
          encapsulationEfficiencyPct: ee,
          residualSolventsPpm: "0.0 ppm (Clean-Label Solvent Free)"
        },
        regulatoryVerdict: "VALIDATED_COMPLIANT"
      };

      const blob = new Blob([JSON.stringify(cert, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `scCO2_MLE_Liposome_Audit_Certificate_${Date.now()}.json`;
      a.click();
      URL.revokeObjectURL(url);
    });

    // Initial calculation
    calculateMetrics();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initScco2MleModeler);
  } else {
    initScco2MleModeler();
  }
</script>
