    flatSourRiskLabel: "平酸（フラットサワー）変敗リスク指数",
    nutrientRetentionLabel: "水溶性栄養素・テクスチャー保持率",
    trunnionSanitationLabel: "回転軸受メカニカルシールサニタリー度",
    complianceStatusLabel: "法規制適合判定・常温保存安定性評価",
    primaryRiskLabel: "最重要品質・微生物リスク:",
    mechanismsLabel: "支配的伝熱・殺菌速度論メカニズム:",
    mitigationLabel: "工学的制御・21 CFR § 113 是正措置:",
    scienceTitle: "酵素熱失活動力学と好熱性芽胞菌平酸変敗速度論",
    scienceSub: "Bigelow熱致死積分値モデル、Geobacillus菌D値特性、およびスクリュードラム内滞留時間分布（RTD）。",
    tableTitle: "業務用連続式ロータリーブランチング機仕様比較",
    tableSub: "缶詰および冷凍野菜加工ラインにおける主要ブランチング装置の設計諸元一覧。",
    colModel: "ブランチング機型番",
    colClass: "適合基準",
    colLength: "ドラム全長",
    colDiameter: "ドラム直径",
    colThroughput: "処理能力 (kg/h)",
    colCip: "CIPカバー率",
    rulesTitle: "低酸性缶詰熱処理基準および重要予防管理規則",
    rulesSub: "FDA、EHEDG、およびコーデックス委員会が定める連続加熱処理の必須遵守基準。",
    rule1Title: "FDA 21 CFR § 113.83 および § 113.88",
    rule1Text: "連続加熱ブランチング機は野菜組織を均一に加熱し、品質劣化酵素を失活させ、組織内遊離酸素を脱気して密封前の芽胞菌数を低減しなければならない。",
    rule2Title: "FDA 21 CFR § 117 (FSMA サニタリー機器設計)",
    rule2Text: "回転ドラムは液溜まりのない300系ステンレス鋼製とし、軸貫通部は無菌バリア水フラッシュを備えてバイオフィルム形成を阻止しなければならない。",
    rule3Title: "EHEDG ガイドライン Doc 8 および Doc 10",
    rule3Text: "回転軸には加圧サニタリーメカニカルシールを使用し、内部CIPスプレーマニホールドはスクリュー羽根の全面に360度噴射しなければならない。",
    rule4Title: "Codex Alimentarius CXC 40-1993 規範",
    rule4Text: "ブランチング後の冷却は飲料水基準を満たす清浄水で急速に行い、好熱性菌が増殖する40°C〜65°Cの温度域に滞留させてはならない。",
    copyReportBtn: "ブランチング熱工シミュレーション報告書をコピー",
    copiedFeedback: "シミュレーション報告書をクリップボードにコピーしました！"
  }
};

const d = DICTIONARY[lang] || DICTIONARY.en;
---

<div class="bg-surface border border-hairline rounded-3xl p-6 sm:p-8 shadow-xs my-8">
  <!-- Header / Badge -->
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-hairline pb-6 mb-8">
    <div>
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-700 text-white mb-2">
        {d.badge}
      </span>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-ink tracking-tight">
        {d.title}
      </h2>
      <p class="text-xs sm:text-sm text-muted mt-1 max-w-4xl leading-relaxed">
        {d.subtitle}
      </p>
    </div>
  </div>

  <!-- Operational Presets -->
  <div class="mb-8 p-4 rounded-2xl bg-surface-soft border border-hairline">
    <div class="flex items-center gap-2 mb-3">
      <span class="w-2 h-2 rounded-full bg-emerald-600 animate-pulse"></span>
      <h3 class="text-xs font-bold text-ink uppercase tracking-wider">
        {d.presetsTitle}
      </h3>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5">
      <button 
        type="button" 
        id="btn-preset-compliant"
        class="text-left px-3.5 py-2.5 rounded-xl border border-hairline bg-surface hover:bg-emerald-50/60 hover:border-emerald-300 text-xs font-medium text-ink transition-all shadow-2xs"
      >
        <span class="block font-bold text-emerald-800 mb-0.5">✓ 21 CFR § 113 Validated</span>
        <span class="text-[11px] text-muted line-clamp-1">{d.presetCompliant}</span>
      </button>

      <button 
        type="button" 
        id="btn-preset-flat-sour"
        class="text-left px-3.5 py-2.5 rounded-xl border border-hairline bg-surface hover:bg-rose-50/60 hover:border-rose-300 text-xs font-medium text-ink transition-all shadow-2xs"
      >
        <span class="block font-bold text-rose-700 mb-0.5">⚠️ Flat-Sour Spoilage</span>
        <span class="text-[11px] text-muted line-clamp-1">{d.presetFlatSour}</span>
      </button>

      <button 
        type="button" 
        id="btn-preset-over-blanch"
        class="text-left px-3.5 py-2.5 rounded-xl border border-hairline bg-surface hover:bg-amber-50/60 hover:border-amber-300 text-xs font-medium text-ink transition-all shadow-2xs"
      >
        <span class="block font-bold text-amber-700 mb-0.5">⚡ Over-Blanch & Leaching</span>
        <span class="text-[11px] text-muted line-clamp-1">{d.presetOverBlanch}</span>
      </button>

      <button 
        type="button" 
        id="btn-preset-biofilm"
        class="text-left px-3.5 py-2.5 rounded-xl border border-hairline bg-surface hover:bg-purple-50/60 hover:border-purple-300 text-xs font-medium text-ink transition-all shadow-2xs"
      >
        <span class="block font-bold text-purple-700 mb-0.5">☣️ Trunnion Biofilm</span>
        <span class="text-[11px] text-muted line-clamp-1">{d.presetBiofilm}</span>
      </button>
    </div>
  </div>

  <!-- Main Grid: Controls (7 cols) vs Telemetry & Visuals (5 cols) -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-10">
    <!-- Controls Column (7 cols) -->
    <div class="lg:col-span-7 space-y-6">
      <div class="border-b border-hairline pb-2">
        <h3 class="text-sm font-bold text-ink uppercase tracking-wider">
          {d.controlsTitle}
        </h3>
        <p class="text-xs text-muted mt-0.5">
          {d.controlsSub}
        </p>
      </div>

      <!-- 1. Rotary Drum Blancher Architecture Selection -->
      <div class="p-4 rounded-2xl bg-surface-soft border border-hairline space-y-2">
        <label for="select-blancher-arch" class="block text-xs font-bold text-ink">
          {d.blancherLabel}
        </label>
        <select 
          id="select-blancher-arch"
          class="w-full text-xs rounded-xl bg-surface border border-hairline p-2.5 font-medium text-ink focus:outline-none focus:ring-2 focus:ring-emerald-600"
        >
          {blancherData.blancherArchitectures.map((arch) => (
            <option value={arch.id}>{arch.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted leading-relaxed">
          {d.blancherHelp}
        </p>
      </div>

      <!-- 2. Commodity / Vegetable Substrate Selection -->
      <div class="p-4 rounded-2xl bg-surface-soft border border-hairline space-y-2">
        <label for="select-commodity" class="block text-xs font-bold text-ink">
          {d.commodityLabel}
        </label>
        <select 
          id="select-commodity"
          class="w-full text-xs rounded-xl bg-surface border border-hairline p-2.5 font-medium text-ink focus:outline-none focus:ring-2 focus:ring-emerald-600"
        >
          {blancherData.commodityProfiles.map((item) => (
            <option value={item.id}>{item.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted leading-relaxed">
          {d.commodityHelp}
        </p>
      </div>

      <!-- 3. Target Spoilage Organism Selection -->
      <div class="p-4 rounded-2xl bg-surface-soft border border-hairline space-y-2">
        <label for="select-microbial-target" class="block text-xs font-bold text-ink">
          {d.pathogenLabel}
        </label>
        <select 
          id="select-microbial-target"
          class="w-full text-xs rounded-xl bg-surface border border-hairline p-2.5 font-medium text-ink focus:outline-none focus:ring-2 focus:ring-emerald-600"
        >
          {blancherData.microbialSpoilagePathogens.map((pathogen) => (
            <option value={pathogen.id}>{pathogen.scientificName} ({pathogen.spoilageSyndrome})</option>
          ))}
        </select>
        <p class="text-[11px] text-muted leading-relaxed">
          {d.pathogenHelp}
        </p>
      </div>

      <!-- Sliders Grid (2-col) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- 4. Blancher Bulk Temperature Slider -->
        <div class="p-4 rounded-2xl bg-surface-soft border border-hairline space-y-2">
          <div class="flex items-center justify-between text-xs">
            <label for="range-blanch-temp" class="font-bold text-ink">
              {d.blanchTempLabel}
            </label>
            <span id="disp-blanch-temp" class="font-mono font-bold text-emerald-700 bg-emerald-100/80 px-2 py-0.5 rounded-lg text-xs">
              96.0°C / 204.8°F
            </span>
          </div>
          <input 
            type="range" 
            id="range-blanch-temp" 
            min="80.0" 
            max="100.0" 
            step="0.5" 
            value="96.0" 
            class="w-full accent-emerald-600 cursor-pointer"
          />
          <p class="text-[11px] text-muted leading-relaxed mt-1">
            {d.blanchTempHelp}
          </p>
        </div>

        <!-- 5. Product Retention Hold Time Slider -->
        <div class="p-4 rounded-2xl bg-surface-soft border border-hairline space-y-2">
          <div class="flex items-center justify-between text-xs">
            <label for="range-hold-time" class="font-bold text-ink">
              {d.holdTimeLabel}
            </label>
            <span id="disp-hold-time" class="font-mono font-bold text-emerald-700 bg-emerald-100/80 px-2 py-0.5 rounded-lg text-xs">
              210 sec (3.5 min)
            </span>
          </div>
          <input 
            type="range" 
            id="range-hold-time" 
            min="60" 
            max="600" 
            step="15" 
            value="210" 
            class="w-full accent-emerald-600 cursor-pointer"
          />
          <p class="text-[11px] text-muted leading-relaxed mt-1">
            {d.holdTimeHelp}
          </p>
        </div>

        <!-- 6. Infeed Spore Load Slider -->
        <div class="p-4 rounded-2xl bg-surface-soft border border-hairline space-y-2">
          <div class="flex items-center justify-between text-xs">
            <label for="range-infeed-spores" class="font-bold text-ink">
              {d.infeedSporesLabel}
            </label>
            <span id="disp-infeed-spores" class="font-mono font-bold text-emerald-700 bg-emerald-100/80 px-2 py-0.5 rounded-lg text-xs">
              3.0 log₁₀ CFU/g
            </span>
          </div>
          <input 
            type="range" 
            id="range-infeed-spores" 
            min="1.0" 
            max="6.0" 
            step="0.2" 
            value="3.0" 
            class="w-full accent-emerald-600 cursor-pointer"
          />
          <p class="text-[11px] text-muted leading-relaxed mt-1">
            {d.infeedSporesHelp}
          </p>
        </div>

        <!-- 7. Drum Thermal Stratification Gradient Slider -->
        <div class="p-4 rounded-2xl bg-surface-soft border border-hairline space-y-2">
          <div class="flex items-center justify-between text-xs">
            <label for="range-stratification" class="font-bold text-ink">
              {d.stratificationLabel}
            </label>
            <span id="disp-stratification" class="font-mono font-bold text-emerald-700 bg-emerald-100/80 px-2 py-0.5 rounded-lg text-xs">
              ΔT = 2.0°C (Uniform)
            </span>
          </div>
          <input 
            type="range" 
            id="range-stratification" 
            min="0.0" 
            max="18.0" 
            step="0.5" 
            value="2.0" 
            class="w-full accent-emerald-600 cursor-pointer"
          />
          <p class="text-[11px] text-muted leading-relaxed mt-1">
            {d.stratificationHelp}
          </p>
        </div>
      </div>

      <!-- 8. Trunnion Seal Wear & CIP Hygiene Factor Slider -->
      <div class="p-4 rounded-2xl bg-surface-soft border border-hairline space-y-2">
        <div class="flex items-center justify-between text-xs">
          <label for="range-cip-score" class="font-bold text-ink">
            {d.cipScoreLabel}
          </label>
          <span id="disp-cip-score" class="font-mono font-bold text-emerald-700 bg-emerald-100/80 px-2.5 py-0.5 rounded-lg text-xs">
            95% (Hygienic Flush Active)
          </span>
        </div>
        <input 
          type="range" 
          id="range-cip-score" 
          min="40" 
          max="100" 
          step="5" 
          value="95" 
          class="w-full accent-emerald-600 cursor-pointer"
        />
        <p class="text-[11px] text-muted leading-relaxed mt-1">
          {d.cipScoreHelp}
        </p>
      </div>
    </div>

    <!-- Telemetry & Diagnostic Visuals (5 cols) -->
    <div class="lg:col-span-5 space-y-6">
      <div class="border-b border-hairline pb-2">
        <h3 class="text-sm font-bold text-ink uppercase tracking-wider">
          {d.diagnosticTitle}
        </h3>
        <p class="text-xs text-muted mt-0.5">
          {d.diagnosticSub}
        </p>
      </div>

      <!-- Dynamic SVG Rotary Blancher Cross-Section -->
      <div class="p-4 rounded-2xl bg-slate-900 border border-slate-800 text-white shadow-inner relative overflow-hidden">
        <div class="flex items-center justify-between text-[11px] font-mono text-emerald-300 mb-2 border-b border-slate-800 pb-1.5">
          <span>ROTARY DRUM THERMAL PROCESS</span>
          <span id="svg-status-indicator" class="text-emerald-400 font-bold">● LETHALITY ADEQUATE</span>
        </div>

        <svg viewBox="0 0 400 240" class="w-full h-auto" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="blancherShell" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#334155" />
              <stop offset="100%" stop-color="#1e293b" />
            </linearGradient>
            <linearGradient id="steamPlume" x1="0%" y1="100%" x2="0%" y2="0%">
              <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.85" />
              <stop offset="100%" stop-color="#e0f2fe" stop-opacity="0.1" />
            </linearGradient>
            <linearGradient id="veggieKernels" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#facc15" />
              <stop offset="100%" stop-color="#eab308" />
            </linearGradient>
            <linearGradient id="drumPerforations" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#475569" />
              <stop offset="100%" stop-color="#0f172a" />
            </linearGradient>
          </defs>

          <!-- Outer Stationary Stainless Hood & Basin (316L) -->
