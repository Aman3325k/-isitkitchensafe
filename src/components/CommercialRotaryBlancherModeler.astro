          <span class="font-bold text-ink text-sm">{d.rule2Title}</span>
          <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-sky-100 text-sky-800 uppercase">FSMA § 117</span>
        </div>
        <p class="text-muted leading-relaxed">
          {d.rule2Text}
        </p>
      </div>

      <div class="p-4 rounded-2xl bg-surface-soft border border-hairline space-y-1.5">
        <div class="flex items-center justify-between">
          <span class="font-bold text-ink text-sm">{d.rule3Title}</span>
          <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-purple-100 text-purple-800 uppercase">EHEDG Doc 8/10</span>
        </div>
        <p class="text-muted leading-relaxed">
          {d.rule3Text}
        </p>
      </div>

      <div class="p-4 rounded-2xl bg-surface-soft border border-hairline space-y-1.5">
        <div class="flex items-center justify-between">
          <span class="font-bold text-ink text-sm">{d.rule4Title}</span>
          <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-100 text-amber-800 uppercase">Codex CXC 40</span>
