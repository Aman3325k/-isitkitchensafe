              <td class="p-3.5 font-mono">{item.drumLengthMeters} m</td>
              <td class="p-3.5 font-mono">{item.drumDiameterMeters} m</td>
              <td class="p-3.5 font-mono">{item.maxThroughputKgHr} kg/hr</td>
              <td class="p-3.5 font-mono">{item.cipSprayCoveragePct}%</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Preventive Controls & Critical Regulatory Rules (4 Cards) -->
  <div class="border-t border-hairline pt-10 mb-8">
    <div class="mb-6">
      <h3 class="text-lg sm:text-xl font-bold text-ink tracking-tight mb-1">
        {d.rulesTitle}
      </h3>
      <p class="text-xs sm:text-sm text-muted">
        {d.rulesSub}
