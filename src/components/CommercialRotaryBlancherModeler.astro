    >
      <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
      </svg>
      <span id="btn-copy-blancher-text">{d.copyReportBtn}</span>
    </button>
  </div>
</div>

<script is:inline define:vars={{ rawBlancherData: blancherData }}>
  (function initCommercialRotaryBlancherModeler() {
    // DOM Inputs
    const selBlancherArch = document.getElementById('select-blancher-arch');
    const selCommodity = document.getElementById('select-commodity');
    const selPathogen = document.getElementById('select-microbial-target');

    const rngBlanchTemp = document.getElementById('range-blanch-temp');
    const rngHoldTime = document.getElementById('range-hold-time');
    const rngInfeedSpores = document.getElementById('range-infeed-spores');
    const rngStratification = document.getElementById('range-stratification');
    const rngCipScore = document.getElementById('range-cip-score');

    const dispBlanchTemp = document.getElementById('disp-blanch-temp');
    const dispHoldTime = document.getElementById('disp-hold-time');
    const dispInfeedSpores = document.getElementById('disp-infeed-spores');
    const dispStratification = document.getElementById('disp-stratification');
    const dispCipScore = document.getElementById('disp-cip-score');

    // Telemetry Elements
    const metricEnzymePct = document.getElementById('metric-enzyme-pct');
    const metricEnzymeTarget = document.getElementById('metric-enzyme-target');
    const badgeEnzyme = document.getElementById('badge-enzyme');
    const barEnzyme = document.getElementById('bar-enzyme');

    const metricLethalityBv = document.getElementById('metric-lethality-bv');
    const metricLethalityRef = document.getElementById('metric-lethality-ref');
    const badgeLethality = document.getElementById('badge-lethality');

    const metricSporeReduction = document.getElementById('metric-spore-reduction');
    const metricSporeResidual = document.getElementById('metric-spore-residual');
    const badgeSpore = document.getElementById('badge-spore');

    const metricFlatSourRisk = document.getElementById('metric-flat-sour-risk');
    const metricSpoilageProb = document.getElementById('metric-spoilage-prob');
    const badgeFlatSour = document.getElementById('badge-flat-sour');

    const metricNutrientRetention = document.getElementById('metric-nutrient-retention');
    const metricLeachingRate = document.getElementById('metric-leaching-rate');
    const badgeNutrient = document.getElementById('badge-nutrient');

    const metricTrunnionScore = document.getElementById('metric-trunnion-score');
    const metricBiofilmStatus = document.getElementById('metric-biofilm-status');
    const badgeTrunnion = document.getElementById('badge-trunnion');

    // Banner Elements
    const banner = document.getElementById('diagnostic-banner');
    const bannerTitle = document.getElementById('banner-status-title');
    const bannerBadge = document.getElementById('banner-status-badge');
    const bannerRiskDesc = document.getElementById('banner-risk-desc');
    const bannerMechanismsDesc = document.getElementById('banner-mechanisms-desc');
    const bannerMitigationDesc = document.getElementById('banner-mitigation-desc');

    // SVG Elements
    const svgStatusIndicator = document.getElementById('svg-status-indicator');
    const svgMetricText1 = document.getElementById('svg-metric-text-1');
    const svgBedInfeed = document.getElementById('svg-bed-infeed');
    const svgBedMid = document.getElementById('svg-bed-mid');
    const svgBedDischarge = document.getElementById('svg-bed-discharge');
    const svgTrunnionLeft = document.getElementById('svg-trunnion-seal-left');
    const svgTrunnionRight = document.getElementById('svg-trunnion-seal-right');

    // Presets
    const btnPresetCompliant = document.getElementById('btn-preset-compliant');
    const btnPresetFlatSour = document.getElementById('btn-preset-flat-sour');
    const btnPresetOverBlanch = document.getElementById('btn-preset-over-blanch');
    const btnPresetBiofilm = document.getElementById('btn-preset-biofilm');

    // Copy Button
    const btnCopyReport = document.getElementById('btn-copy-blancher-report');
    const btnCopyText = document.getElementById('btn-copy-blancher-text');

    function calculateBlancherTelemetry() {
      if (!selBlancherArch || !selCommodity || !selPathogen) return;

      const archId = selBlancherArch.value;
      const commodityId = selCommodity.value;
      const pathogenId = selPathogen.value;

      const blanchTemp = parseFloat(rngBlanchTemp.value);
      const holdTimeSec = parseFloat(rngHoldTime.value);
      const infeedSpores = parseFloat(rngInfeedSpores.value);
      const stratDelta = parseFloat(rngStratification.value);
      const cipScore = parseFloat(rngCipScore.value);

      // Lookups
      const arch = rawBlancherData.blancherArchitectures.find(a => a.id === archId) || rawBlancherData.blancherArchitectures[0];
      const commodity = rawBlancherData.commodityProfiles.find(c => c.id === commodityId) || rawBlancherData.commodityProfiles[0];
      const pathogen = rawBlancherData.microbialSpoilagePathogens.find(p => p.id === pathogenId) || rawBlancherData.microbialSpoilagePathogens[0];

      // Sliders label displays
      const fahrenheit = (blanchTemp * 9/5 + 32).toFixed(1);
      dispBlanchTemp.textContent = `${blanchTemp.toFixed(1)}°C / ${fahrenheit}°F`;
      dispHoldTime.textContent = `${holdTimeSec.toFixed(0)} sec (${(holdTimeSec / 60).toFixed(1)} min)`;
      dispInfeedSpores.textContent = `${infeedSpores.toFixed(1)} log₁₀ CFU/g`;
      dispStratification.textContent = `ΔT = ${stratDelta.toFixed(1)}°C (${stratDelta > 8 ? 'Severe Cold Spots' : stratDelta > 4 ? 'Moderate' : 'Uniform'})`;
      dispCipScore.textContent = `${cipScore.toFixed(0)}% (${cipScore >= 90 ? 'Hygienic Flush Active' : cipScore >= 70 ? 'Moderate Deposition' : 'Biofilm Harborage'})`;

      // Effective Temperature calculation:
      // Thermal stratification causes upper headspace/floating particles to experience lower temperatures
      // Deficient equipment accentuates thermal gradient
      const archStratPenalty = arch.id === 'fouled_maintenance_deficient_blancher' ? 1.4 :
                               arch.id === 'direct_steam_screw_blancher' ? 1.15 : 0.9;
      const effectiveTemp = blanchTemp - (stratDelta * 0.5 * archStratPenalty);

      // 1. Core Conduction Thermal Inactivation:
      // Thermal diffusivity and kernel size govern time to reach core temperature
      // t_half = (r^2) / (alpha * pi^2)
      const radiusM = (commodity.typicalKernelDiameterMm / 2000.0);
      const conductionTimeConst = (radiusM * radiusM) / (commodity.thermalDiffusivityM2s * Math.PI * Math.PI);
      const coreFraction = 1 - Math.exp(-holdTimeSec / (conductionTimeConst * 15.0));
      const coreTemp = 20.0 + (effectiveTemp - 20.0) * Math.min(1.0, coreFraction);

      // 2. Bigelow Lethality (B_v value in equivalent minutes at 100°C, z = 10°C):
      // B_v = (holdTimeSec / 60) * 10^((coreTemp - 100) / 10)
      const lethalityBv = (holdTimeSec / 60.0) * Math.pow(10, (coreTemp - 100.0) / 10.0);

      // 3. Enzyme Inactivation %:
      // Inactivation follows first-order kinetics k = k_ref * 10^((T - T_ref)/z_enzyme)
      // Peroxidase requires ~B_v >= 1.2 min for 99.9% kill
      const enzymeLogKill = (lethalityBv / 0.35);
      const enzymeInactPct = Math.min(99.999, Math.max(20.0, 100.0 - (100.0 * Math.pow(10, -enzymeLogKill))));

      // 4. Spore Inactivation:
      // D_T = D_100 * 10^((100 - coreTemp) / z)
      const dValueSec = pathogen.dValue100CSec * Math.pow(10, (100.0 - coreTemp) / pathogen.zValueC);
      const sporeLogReduction = Math.max(0.01, holdTimeSec / dValueSec);
      
      // Biofilm re-inoculation penalty from failing trunnion seals
      const biofilmInoculation = (100 - cipScore) * 0.025;
      const netResidualSpores = Math.max(0.0, infeedSpores - sporeLogReduction + biofilmInoculation);

      // 5. Spoilage Probability & Flat-Sour Risk Index:
      // Probability of can receiving >= 1 viable spore: P = 1 - exp(-10^netResidualSpores * 0.1)
      const canSporeCount = Math.pow(10, netResidualSpores) * 0.15;
      let flatSourRiskPct = Math.min(100.0, Math.max(0.001, (1 - Math.exp(-canSporeCount)) * 100.0));
      if (coreTemp < 85.0 || enzymeInactPct < 98.0) {
        flatSourRiskPct = Math.min(100.0, flatSourRiskPct * 2.5);
      }

      // 6. Soluble Nutrient & Texture Retention:
      // Over-blanching and hot water immersion leach vitamins and soften cell walls
      const leachingMultiplier = arch.id === 'atmospheric_water_immersion_blancher' ? 1.5 : 1.0;
      const thermalDegradation = (holdTimeSec / 60.0) * 2.8 * Math.pow(1.08, Math.max(0, blanchTemp - 85)) * leachingMultiplier;
      const nutrientRetentionPct = Math.max(45.0, Math.min(98.0, 96.0 - thermalDegradation));

      // 7. Trunnion Seal Sanitary Score:
      const trunnionScore = Math.max(10, Math.min(100, Math.round(cipScore * (arch.cipSprayCoveragePct / 100.0))));

      // --- Update DOM Metrics ---
      // Enzyme Card
      metricEnzymePct.textContent = `${enzymeInactPct.toFixed(2)}%`;
      if (enzymeInactPct >= commodity.targetPeroxidaseInactivationPct) {
        metricEnzymePct.className = 'text-lg font-black text-emerald-700';
        badgeEnzyme.textContent = 'COMPLETE';
        badgeEnzyme.className = 'px-1.5 py-0.2 rounded font-bold bg-emerald-100 text-emerald-800 text-[9px]';
        barEnzyme.className = 'bg-emerald-600 h-1.5 rounded-full transition-all duration-300';
      } else if (enzymeInactPct >= 95.0) {
        metricEnzymePct.className = 'text-lg font-black text-amber-700';
        badgeEnzyme.textContent = 'PARTIAL';
        badgeEnzyme.className = 'px-1.5 py-0.2 rounded font-bold bg-amber-100 text-amber-800 text-[9px]';
        barEnzyme.className = 'bg-amber-600 h-1.5 rounded-full transition-all duration-300';
      } else {
        metricEnzymePct.className = 'text-lg font-black text-rose-700';
        badgeEnzyme.textContent = 'INSUFFICIENT';
        badgeEnzyme.className = 'px-1.5 py-0.2 rounded font-bold bg-rose-100 text-rose-800 text-[9px]';
        barEnzyme.className = 'bg-rose-600 h-1.5 rounded-full transition-all duration-300';
      }
      barEnzyme.style.width = `${Math.min(100, enzymeInactPct)}%`;

      // Lethality Card
      metricLethalityBv.textContent = `${lethalityBv.toFixed(2)} min`;
      if (lethalityBv >= 1.5) {
        metricLethalityBv.className = 'text-lg font-black text-emerald-700';
        badgeLethality.textContent = 'ADEQUATE';
        badgeLethality.className = 'px-1.5 py-0.2 rounded font-bold bg-emerald-100 text-emerald-800 text-[9px]';
      } else if (lethalityBv >= 0.8) {
        metricLethalityBv.className = 'text-lg font-black text-amber-700';
        badgeLethality.textContent = 'MARGINAL';
        badgeLethality.className = 'px-1.5 py-0.2 rounded font-bold bg-amber-100 text-amber-800 text-[9px]';
      } else {
        metricLethalityBv.className = 'text-lg font-black text-rose-700';
        badgeLethality.textContent = 'SUB-LETHAL';
        badgeLethality.className = 'px-1.5 py-0.2 rounded font-bold bg-rose-100 text-rose-800 text-[9px]';
      }

      // Spore Reduction Card
      metricSporeReduction.textContent = `${sporeReductionLog(sporeLogReduction)} log₁₀`;
      metricSporeResidual.textContent = `Surviving: ${netResidualSpores.toFixed(2)} log₁₀`;
      if (sporeLogReduction >= 2.0) {
        badgeSpore.textContent = 'CONTROLLED';
        badgeSpore.className = 'px-1.5 py-0.2 rounded font-bold bg-emerald-100 text-emerald-800 text-[9px]';
      } else {
        badgeSpore.textContent = 'PERSISTENT';
        badgeSpore.className = 'px-1.5 py-0.2 rounded font-bold bg-amber-100 text-amber-800 text-[9px]';
      }

      // Flat-Sour Risk Card
      metricFlatSourRisk.textContent = `${flatSourRiskPct.toFixed(2)}%`;
      if (flatSourRiskPct <= 0.1) {
        metricFlatSourRisk.className = 'text-lg font-black text-emerald-700';
        badgeFlatSour.textContent = 'LOW RISK';
        badgeFlatSour.className = 'px-1.5 py-0.2 rounded font-bold bg-emerald-100 text-emerald-800 text-[9px]';
        metricSpoilageProb.textContent = '< 1 in 10,000 Cans';
      } else if (flatSourRiskPct <= 3.0) {
        metricFlatSourRisk.className = 'text-lg font-black text-amber-700';
        badgeFlatSour.textContent = 'MODERATE';
        badgeFlatSour.className = 'px-1.5 py-0.2 rounded font-bold bg-amber-100 text-amber-800 text-[9px]';
        metricSpoilageProb.textContent = '≈ 1 in 200 Cans';
      } else {
        metricFlatSourRisk.className = 'text-lg font-black text-rose-700';
        badgeFlatSour.textContent = 'HIGH RISK';
        badgeFlatSour.className = 'px-1.5 py-0.2 rounded font-bold bg-rose-100 text-rose-800 text-[9px]';
        metricSpoilageProb.textContent = `> 1 in ${(100 / flatSourRiskPct).toFixed(0)} Cans Spoil`;
      }

      // Nutrient Retention Card
      metricNutrientRetention.textContent = `${nutrientRetentionPct.toFixed(1)}%`;
      metricLeachingRate.textContent = `Leaching: ${(100 - nutrientRetentionPct).toFixed(1)}%`;
      if (nutrientRetentionPct >= 80.0) {
        badgeNutrient.textContent = 'OPTIMAL';
        badgeNutrient.className = 'px-1.5 py-0.2 rounded font-bold bg-emerald-100 text-emerald-800 text-[9px]';
      } else {
        badgeNutrient.textContent = 'DEGRADED';
        badgeNutrient.className = 'px-1.5 py-0.2 rounded font-bold bg-amber-100 text-amber-800 text-[9px]';
      }

      // Trunnion Card
      metricTrunnionScore.textContent = `${trunnionScore} / 100`;
      if (trunnionScore >= 85) {
        metricTrunnionScore.className = 'text-lg font-black text-emerald-700';
        badgeTrunnion.textContent = 'SANITARY';
        badgeTrunnion.className = 'px-1.5 py-0.2 rounded font-bold bg-emerald-100 text-emerald-800 text-[9px]';
        metricBiofilmStatus.textContent = 'EHEDG Doc 8 Compliant';
      } else if (trunnionScore >= 60) {
        metricTrunnionScore.className = 'text-lg font-black text-amber-700';
        badgeTrunnion.textContent = 'WARN';
        badgeTrunnion.className = 'px-1.5 py-0.2 rounded font-bold bg-amber-100 text-amber-800 text-[9px]';
        metricBiofilmStatus.textContent = 'Starch Film Accumulation';
      } else {
        metricTrunnionScore.className = 'text-lg font-black text-rose-700';
        badgeTrunnion.textContent = 'BIOFILM';
        badgeTrunnion.className = 'px-1.5 py-0.2 rounded font-bold bg-rose-100 text-rose-800 text-[9px]';
        metricBiofilmStatus.textContent = 'Chronic Spore Harborage';
      }

      // --- SVG Diagram Updates ---
      svgMetricText1.textContent = `CORE TEMP: ${coreTemp.toFixed(1)}°C | LETHALITY B_v: ${lethalityBv.toFixed(2)} min | SPORES: ${netResidualSpores.toFixed(1)} log`;

      if (enzymeInactPct >= 99.8 && lethalityBv >= 1.2 && trunnionScore >= 75) {
        svgStatusIndicator.textContent = '● PROCESS NORMAL (FDA COMPLIANT)';
        svgStatusIndicator.className = 'text-emerald-400 font-bold';
        svgBedDischarge.setAttribute('fill', '#eab308');
        svgTrunnionLeft.setAttribute('fill', '#10b981');
        svgTrunnionRight.setAttribute('fill', '#10b981');
      } else if (enzymeInactPct < 98.0 || lethalityBv < 0.8) {
        svgStatusIndicator.textContent = '🚨 SUB-LETHAL BLANCHING ALERT';
        svgStatusIndicator.className = 'text-rose-400 font-bold';
        svgBedDischarge.setAttribute('fill', '#ef4444');
      } else {
        svgStatusIndicator.textContent = '⚠️ MARGINAL PROCESS PARAMETERS';
        svgStatusIndicator.className = 'text-amber-400 font-bold';
        svgBedDischarge.setAttribute('fill', '#f59e0b');
      }

      if (trunnionScore < 60) {
        svgTrunnionLeft.setAttribute('fill', '#ef4444');
        svgTrunnionRight.setAttribute('fill', '#ef4444');
      }

      // --- Diagnostic Banner Verdict ---
      if (enzymeInactPct >= commodity.targetPeroxidaseInactivationPct && lethalityBv >= 1.2 && trunnionScore >= 80 && flatSourRiskPct <= 0.5) {
        banner.className = 'p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-900 space-y-2';
        bannerBadge.className = 'px-2 py-0.5 rounded-full text-[10px] font-black bg-emerald-700 text-white uppercase';
        bannerBadge.textContent = 'FDA 21 CFR § 113 COMPLIANT';
        bannerTitle.textContent = 'Blanching thermal lethality is validated: Complete peroxidase inactivation achieved with negligible flat-sour risk.';
        bannerRiskDesc.textContent = `${commodity.name}: Native enzymes fully destroyed; core reached ${coreTemp.toFixed(1)}°C without structural cellular damage.`;
        bannerMechanismsDesc.textContent = 'Direct culinary steam condensation provides uniform conductive penetration; helical flights maintain near-ideal plug-flow.';
        bannerMitigationDesc.textContent = 'Maintain automated CIP flush cycles; calibrate dual resistance temperature detectors (RTD) every 6 months.';
      } else if (flatSourRiskPct > 3.0 || enzymeInactPct < 95.0) {
        banner.className = 'p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-900 space-y-2';
        bannerBadge.className = 'px-2 py-0.5 rounded-full text-[10px] font-black bg-rose-700 text-white uppercase';
        bannerBadge.textContent = '21 CFR § 113 PROCESS DEVIATION';
        bannerTitle.textContent = 'Critical Spoilage Alert: Thermal cold spots allow massive Geobacillus stearothermophilus spore survival.';
        bannerRiskDesc.textContent = `Severe Flat-Sour Spoilage Hazard: Acidification without gas swelling. Food will turn sour (pH < 4.8) in warehouse storage.`;
        bannerMechanismsDesc.textContent = `Thermal stratification ΔT of ${stratDelta.toFixed(1)}°C created cold core temperatures (${coreTemp.toFixed(1)}°C), falling below lethality threshold.`;
        bannerMitigationDesc.textContent = 'Increase steam sparge header pressure; clean calcified steam orifices; slow drum RPM to increase dwell time above 240 seconds.';
      } else {
        banner.className = 'p-4 rounded-2xl bg-amber-50 border border-amber-200 text-amber-900 space-y-2';
        bannerBadge.className = 'px-2 py-0.5 rounded-full text-[10px] font-black bg-amber-700 text-white uppercase';
        bannerBadge.textContent = 'WARNING: MARGINAL RETENTION';
        bannerTitle.textContent = 'Sub-optimal processing parameters detected: High nutrient leaching or minor enzyme residuals present.';
        bannerRiskDesc.textContent = 'Soluble vitamin leaching or mild texture softening observed. Monitor finished container vacuum.';
        bannerMechanismsDesc.textContent = 'Excessive dwell time or hot water immersion leaches soluble solids while failing to provide extra spore destruction.';
        bannerMitigationDesc.textContent = 'Trim dwell time to optimal point; lower bulk temperature to 94°C; verify post-blanch hydro-cooling water temperature < 15°C.';
      }
    }

    function sporeReductionLog(val) {
      return val > 9.99 ? '> 10.0' : val.toFixed(2);
    }

    // Event Listeners for inputs
    [selBlancherArch, selCommodity, selPathogen].forEach(sel => {
      sel?.addEventListener('change', calculateBlancherTelemetry);
    });

    [rngBlanchTemp, rngHoldTime, rngInfeedSpores, rngStratification, rngCipScore].forEach(rng => {
      rng?.addEventListener('input', calculateBlancherTelemetry);
    });

    // Preset Handlers
    btnPresetCompliant?.addEventListener('click', () => {
      selBlancherArch.value = 'hydro_chill_rotary_drum_blancher';
      selCommodity.value = 'sweet_corn_cut_kernels';
      selPathogen.value = 'geobacillus_stearothermophilus';
      rngBlanchTemp.value = '96.0';
      rngHoldTime.value = '210';
      rngInfeedSpores.value = '3.0';
      rngStratification.value = '1.5';
      rngCipScore.value = '95';
      calculateBlancherTelemetry();
    });

    btnPresetFlatSour?.addEventListener('click', () => {
      selBlancherArch.value = 'direct_steam_screw_blancher';
      selCommodity.value = 'sweet_corn_cut_kernels';
      selPathogen.value = 'geobacillus_stearothermophilus';
      rngBlanchTemp.value = '84.0';
      rngHoldTime.value = '120';
      rngInfeedSpores.value = '4.5';
      rngStratification.value = '12.0';
      rngCipScore.value = '65';
      calculateBlancherTelemetry();
    });

    btnPresetOverBlanch?.addEventListener('click', () => {
      selBlancherArch.value = 'atmospheric_water_immersion_blancher';
      selCommodity.value = 'green_peas_legumes';
      selPathogen.value = 'bacillus_coagulans';
      rngBlanchTemp.value = '99.5';
      rngHoldTime.value = '480';
      rngInfeedSpores.value = '2.5';
      rngStratification.value = '1.0';
      rngCipScore.value = '85';
      calculateBlancherTelemetry();
    });

    btnPresetBiofilm?.addEventListener('click', () => {
      selBlancherArch.value = 'fouled_maintenance_deficient_blancher';
      selCommodity.value = 'diced_carrots_root_vegetables';
      selPathogen.value = 'thermoanaerobacterium_thermosaccharolyticum';
      rngBlanchTemp.value = '88.0';
      rngHoldTime.value = '180';
      rngInfeedSpores.value = '5.0';
      rngStratification.value = '14.0';
      rngCipScore.value = '45';
      calculateBlancherTelemetry();
    });

    // Copy Simulation Report Handler
    btnCopyReport?.addEventListener('click', () => {
      const archName = selBlancherArch.options[selBlancherArch.selectedIndex].text;
      const commodityName = selCommodity.options[selCommodity.selectedIndex].text;
      const pathogenName = selPathogen.options[selPathogen.selectedIndex].text;

      const reportText = [
        "=======================================================================",
        "COMMERCIAL ROTARY BLANCHER STEAM INVERSION & SPORE SIMULATION REPORT",
        "Source: IsItKitchenSafe Continuous Ops & Canning Microbiology Engine",
        "Standards: FDA 21 CFR § 113.83, 21 CFR § 117, EHEDG Doc 8 & Doc 10",
        "=======================================================================",
        `Timestamp: ${new Date().toISOString()}`,
        `Blancher Architecture: ${archName}`,
        `Commodity Substrate: ${commodityName}`,
        `Target Spoilage Pathogen: ${pathogenName}`,
        `Bulk Steam/Water Temp: ${dispBlanchTemp.textContent}`,
        `Retention Hold Time: ${dispHoldTime.textContent}`,
        `Thermal Stratification: ${dispStratification.textContent}`,
        `Infeed Spore Load: ${dispInfeedSpores.textContent}`,
        `Sanitary Trunnion CIP Factor: ${dispCipScore.textContent}`,
        "-----------------------------------------------------------------------",
        "CALCULATED DIAGNOSTIC TELEMETRY:",
        `• Enzyme Inactivation (Peroxidase): ${metricEnzymePct.textContent} (${badgeEnzyme.textContent})`,
        `• Equivalent Blanching Lethality (B_v): ${metricLethalityBv.textContent} (${badgeLethality.textContent})`,
        `• Spore Log Reduction: ${metricSporeReduction.textContent} (${metricSporeResidual.textContent})`,
        `• Flat-Sour Spoilage Risk Index: ${metricFlatSourRisk.textContent} (${metricSpoilageProb.textContent})`,
        `• Soluble Nutrient Retention: ${metricNutrientRetention.textContent} (${metricLeachingRate.textContent})`,
        `• Trunnion Sanitary Score: ${metricTrunnionScore.textContent} (${metricBiofilmStatus.textContent})`,
        "-----------------------------------------------------------------------",
        `REGULATORY VERDICT: ${bannerBadge.textContent}`,
        `SUMMARY: ${bannerTitle.textContent}`,
        "======================================================================="
      ].join('\n');

      navigator.clipboard.writeText(reportText).then(() => {
        const originalText = btnCopyText.textContent;
        btnCopyText.textContent = "✓ Report Copied!";
        setTimeout(() => {
          btnCopyText.textContent = originalText;
        }, 2500);
      }).catch(err => {
        console.error('Failed to copy report to clipboard:', err);
      });
    });

    // Initial Calculation Run
    calculateBlancherTelemetry();
  })();
</script>
