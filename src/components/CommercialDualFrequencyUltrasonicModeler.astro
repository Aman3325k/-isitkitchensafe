    substrateHelp: "316L 電解研磨衛生管（Ra < 0.38 µm）、304 機械研磨標準管、チタン Grade 5 流通セル、または塩素孔食劣化した 304 配管を選択。",
    solutionLabel: "洗浄化学液および流体処方：",
    solutionHelp: "中性複合酵素界面活性剤製剤、マイルドなアルカリ性苛性洗浄液（NaOH＋キレート剤）、過酢酸（PAA）殺菌液、または冷脱イオン水機械リンスを選択。",
    powerLabel: "体積音響パワー密度 (W/L)：",
    powerHelp: "流体体積へ注入される音響出力。過渡キャビテーション気泡の核生成密度と局所マイクロジェットの衝撃速度を決定します。",
    velocityLabel: "配管内平均液流速 (m/s)：",
    velocityHelp: "衛生配管内を流れる液体の線流速。境界層の流体力学的せん断と超音波滞留時間のバランスを調整します。",
    tempLabel: "洗浄液動作温度 (°C)：",
    tempHelp: "液体の飽和蒸気圧と粘度を制御。高温は化学反応を促進しますが、気泡の蒸気クッション効果により衝撃波強度が軟化します。",
    timeLabel: "超音波照射滞留時間 (秒)：",
    timeHelp: "高エネルギー振動子ゾーンを通過する際に管壁バイオフィルムが直接受ける超音波微小せん断の総暴露時間。",
    presetsTitle: "標準産業洗浄＆バリデーションプリセット",
    presetListeria: "チルド製品ライン・リステリア完全脱離 (28/40 kHz, 85 W/L, 1.2 m/s, 45°C 酵素)",
    presetMilkstone: "乳業高硬度乳石・セレウス菌芽胞破砕 (28/80 kHz, 140 W/L, 0.8 m/s, 60°C アルカリ)",
    presetPseudomonas: "飲料配管シュードモナス粘液スライム脱離 (28/40 kHz, 75 W/L, 1.5 m/s, 25°C PAA)",
    presetPilot: "FSMA § 117 洗浄性パイロット実証 (24/40 kHz, 60 W/L, 1.0 m/s, 50°C 中性洗浄)",
    presetHazard: "音響失調ノード死角バイパス危険状態 (失調スキッド, 35 W/L, 2.8 m/s, 20°C 冷水)",
    diagnosticTitle: "キャビテーション力学＆バイオフィルム剥離診断",
    diagnosticSub: "過渡キャビテーションエネルギー密度、EPS 膜剥離率、病原菌 Log10 減少量、音響均一度、および ASTM G32 配管侵食マージンをリアルタイム算出。",
    cavitationEnergyLabel: "過渡キャビテーションエネルギー密度",
    biofilmRemovalLabel: "バイオフィルム基質脱離・剥離率",
    microbeLogLabel: "生存菌 Log10 殺菌除去量",
    uniformityLabel: "音場定在波均一性インデックス",
    shearStressLabel: "音響マイクロストリーミング壁面せん断応力",
    erosionMarginLabel: "ASTM G32 耐キャビテーション侵食安全余裕度",
    ehedgStatusLabel: "EHEDG 衛生配管洗浄性評価基準",
    safetyStatusLabel: "3-A / EHEDG 衛生規格適合ステータス",
    primaryLimitationLabel: "主要な物理・流体力学的制限ボトルネック",
    mitigationActionLabel: "推奨されるエンジニアリング改善プロトコル",
    scienceTitle: "デュアル周波数キャビテーション物理と非熱的脱離速度論",
    scienceSub: "直交音響周波数による定在波解消、マイクロジェット破壊力学、EPS の粘弾性降伏、および衛生配管侵食防止規格の詳細解説。",
    tableTitle: "超音波共振配管機器仕様および境界条件パラメーター"
  }
};

const d = DICT[lang] || DICT.en;
---

<div class="space-y-10">
  <!-- Interactive Modeler Header -->
  <div class="border-b border-hairline pb-6">
    <div class="flex items-center gap-2 mb-3">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-cyan-600 text-white">
        {d.badge}
      </span>
      <span class="text-xs text-muted font-mono">EHEDG Doc 2 &amp; 8 &bull; 3-A Sanitary 63-04 &bull; ASTM G32</span>
    </div>
    <h2 class="text-2xl sm:text-3xl font-bold text-ink tracking-tight">
      {d.title}
    </h2>
    <p class="mt-2 text-sm sm:text-base text-body leading-relaxed max-w-4xl">
      {d.subtitle}
    </p>
  </div>

  <!-- Main Calculator Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    
    <!-- Left Column: Controls (5 Cols) -->
    <div class="lg:col-span-5 space-y-6 bg-surface-soft border border-hairline rounded-3xl p-6 sm:p-7 shadow-xs">
      <div>
        <h3 class="text-base font-bold text-ink tracking-tight">{d.controlsTitle}</h3>
        <p class="text-xs text-muted mt-1">{d.controlsSub}</p>
      </div>

      <!-- Control 1: System Selection -->
      <div class="space-y-1.5">
        <label for="us-sys-select" class="block text-xs font-semibold text-ink">
          {d.systemLabel}
        </label>
        <select 
          id="us-sys-select" 
          class="w-full text-xs rounded-xl border border-hairline bg-surface text-ink p-3 focus:outline-none focus:ring-2 focus:ring-cyan-500 transition-shadow"
        >
          {ultrasonicData.ultrasonicSystems.map(sys => (
            <option value={sys.id}>{sys.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted leading-tight">{d.systemHelp}</p>
      </div>

      <!-- Control 2: Biofilm Challenge -->
      <div class="space-y-1.5">
        <label for="us-biofilm-select" class="block text-xs font-semibold text-ink">
          {d.biofilmLabel}
        </label>
        <select 
          id="us-biofilm-select" 
          class="w-full text-xs rounded-xl border border-hairline bg-surface text-ink p-3 focus:outline-none focus:ring-2 focus:ring-cyan-500 transition-shadow"
        >
          {ultrasonicData.biofilmTypes.map(bio => (
            <option value={bio.id}>{bio.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted leading-tight">{d.biofilmHelp}</p>
      </div>

      <!-- Control 3: Pipe Substrate -->
      <div class="space-y-1.5">
        <label for="us-substrate-select" class="block text-xs font-semibold text-ink">
          {d.substrateLabel}
        </label>
        <select 
          id="us-substrate-select" 
          class="w-full text-xs rounded-xl border border-hairline bg-surface text-ink p-3 focus:outline-none focus:ring-2 focus:ring-cyan-500 transition-shadow"
        >
          {ultrasonicData.pipeSubstrates.map(sub => (
            <option value={sub.id}>{sub.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted leading-tight">{d.substrateHelp}</p>
      </div>

      <!-- Control 4: Cleaning Solution -->
      <div class="space-y-1.5">
        <label for="us-solution-select" class="block text-xs font-semibold text-ink">
          {d.solutionLabel}
        </label>
        <select 
          id="us-solution-select" 
          class="w-full text-xs rounded-xl border border-hairline bg-surface text-ink p-3 focus:outline-none focus:ring-2 focus:ring-cyan-500 transition-shadow"
        >
          {ultrasonicData.cleaningSolutions.map(sol => (
            <option value={sol.id}>{sol.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted leading-tight">{d.solutionHelp}</p>
      </div>

      <!-- Slider 1: Acoustic Power Density (W/L) -->
      <div class="space-y-2 pt-2 border-t border-hairline">
        <div class="flex justify-between items-center text-xs">
          <label for="us-power-slider" class="font-semibold text-ink">{d.powerLabel}</label>
          <span id="us-power-val" class="font-mono font-bold text-cyan-600 dark:text-cyan-400">85 W/L</span>
        </div>
        <input 
          type="range" 
          id="us-power-slider" 
          min="10" 
          max="180" 
          step="5" 
          value="85"
          class="w-full h-1.5 bg-hairline rounded-lg appearance-none cursor-pointer accent-cyan-600"
        />
        <p class="text-[11px] text-muted leading-tight">{d.powerHelp}</p>
      </div>

      <!-- Slider 2: Liquid Flow Velocity (m/s) -->
      <div class="space-y-2">
        <div class="flex justify-between items-center text-xs">
          <label for="us-velocity-slider" class="font-semibold text-ink">{d.velocityLabel}</label>
          <span id="us-velocity-val" class="font-mono font-bold text-cyan-600 dark:text-cyan-400">1.2 m/s</span>
        </div>
        <input 
          type="range" 
          id="us-velocity-slider" 
          min="0.2" 
          max="3.5" 
          step="0.1" 
          value="1.2"
          class="w-full h-1.5 bg-hairline rounded-lg appearance-none cursor-pointer accent-cyan-600"
        />
        <p class="text-[11px] text-muted leading-tight">{d.velocityHelp}</p>
      </div>

      <!-- Slider 3: Cleaning Fluid Temperature (°C) -->
      <div class="space-y-2">
        <div class="flex justify-between items-center text-xs">
          <label for="us-temp-slider" class="font-semibold text-ink">{d.tempLabel}</label>
          <span id="us-temp-val" class="font-mono font-bold text-cyan-600 dark:text-cyan-400">45 °C</span>
        </div>
        <input 
          type="range" 
          id="us-temp-slider" 
          min="15" 
          max="80" 
          step="1" 
          value="45"
          class="w-full h-1.5 bg-hairline rounded-lg appearance-none cursor-pointer accent-cyan-600"
        />
        <p class="text-[11px] text-muted leading-tight">{d.tempHelp}</p>
      </div>

      <!-- Slider 4: Sonication Exposure Duration (seconds) -->
      <div class="space-y-2">
        <div class="flex justify-between items-center text-xs">
          <label for="us-time-slider" class="font-semibold text-ink">{d.timeLabel}</label>
          <span id="us-time-val" class="font-mono font-bold text-cyan-600 dark:text-cyan-400">45 s</span>
        </div>
        <input 
          type="range" 
          id="us-time-slider" 
          min="5" 
          max="180" 
          step="5" 
          value="45"
          class="w-full h-1.5 bg-hairline rounded-lg appearance-none cursor-pointer accent-cyan-600"
        />
        <p class="text-[11px] text-muted leading-tight">{d.timeHelp}</p>
      </div>
    </div>

    <!-- Right Column: Diagnostics & Real-Time Output (7 Cols) -->
    <div class="lg:col-span-7 space-y-6">
      
      <!-- Primary Status Banner -->
      <div id="us-status-banner" class="rounded-3xl p-6 sm:p-7 border border-emerald-500/20 bg-emerald-500/5 transition-all duration-300">
        <div class="flex items-start gap-4">
          <div id="us-status-icon" class="w-10 h-10 rounded-2xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0 font-bold text-lg">
            ✓
          </div>
          <div class="space-y-1">
            <div class="flex items-center gap-2">
              <span id="us-badge-pill" class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-emerald-500/20 text-emerald-700 dark:text-emerald-300">
                EHEDG Class 1 Clean
              </span>
              <span class="text-xs text-muted font-mono">ASTM G32 Compliant</span>
            </div>
            <h3 id="us-status-heading" class="text-lg font-bold text-ink">
              100% Biofilm Desorption &bull; Complete Micro-Jet Shearing
            </h3>
            <p id="us-status-desc" class="text-xs text-muted leading-relaxed">
              Orthogonal dual-frequency fields eliminate standing wave dead zones. Transient cavitation collapses exceed biofilm adhesion threshold with zero substrate erosion.
            </p>
          </div>
        </div>
      </div>

      <!-- Core Metrics 4-Pack Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        
        <!-- Metric 1: Cavitation Energy Density -->
        <div class="bg-surface-soft border border-hairline rounded-2xl p-4 flex flex-col justify-between">
          <span class="text-xs font-medium text-muted">{d.cavitationEnergyLabel}</span>
          <div class="my-2">
            <span id="out-energy-val" class="text-2xl font-bold font-mono text-cyan-600 dark:text-cyan-400">114.8</span>
            <span class="text-xs text-muted ml-1">J/cm²</span>
          </div>
          <div class="w-full bg-hairline rounded-full h-1.5 overflow-hidden">
            <div id="bar-energy" class="bg-cyan-600 h-full rounded-full transition-all duration-300" style="width: 75%;"></div>
          </div>
          <div class="flex justify-between items-center text-[11px] text-muted mt-2">
            <span>Micro-Jet Velocity:</span>
            <span id="sub-jet-vel" class="font-mono text-ink">135 m/s</span>
          </div>
        </div>

        <!-- Metric 2: Biofilm Desorption % -->
        <div class="bg-surface-soft border border-hairline rounded-2xl p-4 flex flex-col justify-between">
          <span class="text-xs font-medium text-muted">{d.biofilmRemovalLabel}</span>
          <div class="my-2">
            <span id="out-desorption-val" class="text-2xl font-bold font-mono text-emerald-600 dark:text-emerald-400">99.98</span>
            <span class="text-xs text-muted ml-1">% Detached</span>
          </div>
          <div class="w-full bg-hairline rounded-full h-1.5 overflow-hidden">
            <div id="bar-desorption" class="bg-emerald-600 h-full rounded-full transition-all duration-300" style="width: 99%;"></div>
          </div>
          <div class="flex justify-between items-center text-[11px] text-muted mt-2">
            <span>Adhesion Shear Margin:</span>
            <span id="sub-shear-margin" class="font-bold text-emerald-600 dark:text-emerald-400">2.4x Over Yield</span>
          </div>
        </div>

        <!-- Metric 3: Log10 Microbial Reduction -->
        <div class="bg-surface-soft border border-hairline rounded-2xl p-4 flex flex-col justify-between">
          <span class="text-xs font-medium text-muted">{d.microbeLogLabel}</span>
          <div class="my-2">
            <span id="out-log-val" class="text-2xl font-bold font-mono text-indigo-600 dark:text-indigo-400">5.42</span>
            <span class="text-xs text-muted ml-1">Log10 CFU</span>
          </div>
          <div class="w-full bg-hairline rounded-full h-1.5 overflow-hidden">
            <div id="bar-log" class="bg-indigo-600 h-full rounded-full transition-all duration-300" style="width: 82%;"></div>
          </div>
          <div class="flex justify-between items-center text-[11px] text-muted mt-2">
            <span>Target Challenge:</span>
            <span id="sub-target-microbe" class="font-mono text-ink text-[10px] truncate max-w-[140px]">L. monocytogenes</span>
          </div>
        </div>

        <!-- Metric 4: Field Uniformity Index -->
        <div class="bg-surface-soft border border-hairline rounded-2xl p-4 flex flex-col justify-between">
          <span class="text-xs font-medium text-muted">{d.uniformityLabel}</span>
          <div class="my-2">
            <span id="out-uniformity-val" class="text-2xl font-bold font-mono text-ink">94.5</span>
            <span class="text-xs text-muted ml-1">% Uniform</span>
          </div>
          <div class="w-full bg-hairline rounded-full h-1.5 overflow-hidden">
            <div id="bar-uniformity" class="bg-cyan-600 h-full rounded-full transition-all duration-300" style="width: 94%;"></div>
          </div>
          <div class="flex justify-between items-center text-[11px] text-muted mt-2">
            <span>Nodal Shadowing:</span>
            <span id="sub-shadow-state" class="font-bold text-emerald-600 dark:text-emerald-400">Zero Dead Zones</span>
          </div>
        </div>
      </div>

      <!-- Secondary Telemetry Row (Wall Shear, Erosion Margin, EHEDG Status) -->
      <div class="bg-surface-soft border border-hairline rounded-2xl p-5 space-y-3">
        <h4 class="text-xs font-bold text-ink uppercase tracking-wider">
          Acoustic Cavitation Tribology &amp; Mechanical Integrity
        </h4>
        
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
          <div class="p-3 bg-surface rounded-xl border border-hairline">
            <span class="text-muted block text-[11px]">{d.shearStressLabel}:</span>
            <span id="out-wall-shear" class="font-mono font-bold text-cyan-600 dark:text-cyan-400 text-sm mt-0.5 block">
              1,150 Pa
            </span>
          </div>
          <div class="p-3 bg-surface rounded-xl border border-hairline">
            <span class="text-muted block text-[11px]">{d.erosionMarginLabel}:</span>
            <span id="out-erosion-margin" class="font-mono font-bold text-emerald-600 dark:text-emerald-400 text-sm mt-0.5 block">
              1.94x Margin (ASTM G32 Safe)
            </span>
          </div>
          <div class="p-3 bg-surface rounded-xl border border-hairline">
            <span class="text-muted block text-[11px]">{d.ehedgStatusLabel}:</span>
            <span id="out-ehedg-class" class="font-mono font-medium text-emerald-600 dark:text-emerald-400 text-sm mt-0.5 block">
              Class 1 Fully Cleanable
            </span>
          </div>
        </div>
      </div>

      <!-- Diagnostics Interpretation Box -->
      <div class="bg-surface-soft border border-hairline rounded-2xl p-5 space-y-3">
        <div class="space-y-1">
          <span class="text-xs font-bold uppercase tracking-wider text-muted">{d.primaryLimitationLabel}:</span>
          <p id="out-primary-limit" class="text-xs text-ink leading-relaxed">
            OPTIMAL DUAL-FREQUENCY COUPLING: Orthogonal 28 kHz macro-streaming combined with 40 kHz micro-cavitation delivers high wall shear with no standing wave cancellation.
          </p>
        </div>
        <div class="border-t border-hairline pt-3 space-y-1">
          <span class="text-xs font-bold uppercase tracking-wider text-muted">{d.mitigationActionLabel}:</span>
          <p id="out-mitigation-action" class="text-xs text-muted leading-relaxed">
            Maintain bulk liquid flow between 0.8 and 1.5 m/s to rapidly sweep desorbed biomass out of the acoustic reaction zone without redeposition.
          </p>
        </div>
      </div>

      <!-- Presets Buttons -->
      <div class="space-y-2">
        <span class="text-xs font-bold text-ink uppercase tracking-wider">{d.presetsTitle}</span>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <button 
            type="button" 
            id="btn-preset-listeria" 
            class="text-left p-3 rounded-xl border border-hairline bg-surface hover:bg-surface-soft text-xs transition-colors"
          >
            <span class="font-semibold text-ink block">{d.presetListeria}</span>
            <span class="text-[11px] text-muted">Listeria EPS detachment at 85 W/L, 45°C enzymatic</span>
          </button>
          <button 
            type="button" 
            id="btn-preset-milkstone" 
            class="text-left p-3 rounded-xl border border-hairline bg-surface hover:bg-surface-soft text-xs transition-colors"
          >
            <span class="font-semibold text-ink block">{d.presetMilkstone}</span>
            <span class="text-[11px] text-muted">Dairy mineralized milkstone shatter at 140 W/L, 60°C alkaline</span>
          </button>
          <button 
            type="button" 
            id="btn-preset-pseudomonas" 
            class="text-left p-3 rounded-xl border border-hairline bg-surface hover:bg-surface-soft text-xs transition-colors"
          >
            <span class="font-semibold text-ink block">{d.presetPseudomonas}</span>
            <span class="text-[11px] text-muted">Alginate slime stripping at 75 W/L, 25°C PAA</span>
          </button>
          <button 
            type="button" 
            id="btn-preset-pilot" 
            class="text-left p-3 rounded-xl border border-hairline bg-surface hover:bg-surface-soft text-xs transition-colors"
          >
            <span class="font-semibold text-ink block">{d.presetPilot}</span>
            <span class="text-[11px] text-muted">FSMA § 117 multi-frequency cleanability validation</span>
          </button>
          <button 
            type="button" 
            id="btn-preset-hazard" 
            class="text-left p-3 rounded-xl border border-rose-500/30 bg-rose-500/5 hover:bg-rose-500/10 text-xs transition-colors sm:col-span-2"
          >
            <span class="font-semibold text-rose-600 dark:text-rose-400 block">{d.presetHazard}</span>
            <span class="text-[11px] text-rose-500">Severe standing wave dead zones, biofilm bypass &amp; cavitation pitting</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Engineering Specifications & Science Deep Dive -->
  <div class="mt-12 space-y-8 border-t border-hairline pt-10">
    <div>
      <h3 class="text-xl font-bold text-ink tracking-tight">{d.scienceTitle}</h3>
      <p class="text-sm text-muted mt-1 max-w-3xl">{d.scienceSub}</p>
    </div>

    <!-- Science Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-surface-soft border border-hairline rounded-2xl p-5 space-y-3">
        <div class="w-8 h-8 rounded-lg bg-cyan-500/10 text-cyan-600 flex items-center justify-center font-bold text-xs">
          01
        </div>
        <h4 class="text-sm font-bold text-ink">Orthogonal Dual-Frequency Acoustic Synergy</h4>
        <p class="text-xs text-muted leading-relaxed">
          Single-frequency ultrasonic tubes generate stationary acoustic standing waves with nodal pressure nulls (&lambda;/2 intervals) where cavitation energy drops to zero, creating uncleaned biofilm refuges. By combining lower-frequency 28 kHz waves (macro-bubble transient cavitation, large shockwave radius) with 40 kHz or 80 kHz high-frequency fields (intense micro-streaming and acoustic fountain jets), acoustic nulls are continuously eliminated, ensuring 100% surface irradiation.
        </p>
      </div>

      <div class="bg-surface-soft border border-hairline rounded-2xl p-5 space-y-3">
        <div class="w-8 h-8 rounded-lg bg-emerald-500/10 text-emerald-600 flex items-center justify-center font-bold text-xs">
          02
        </div>
        <h4 class="text-sm font-bold text-ink">EPS Hydrogel Viscoelastic Shearing Mechanics</h4>
        <p class="text-xs text-muted leading-relaxed">
          Bacterial biofilms are viscoelastic cross-linked polymer hydrogels composed of extracellular polysaccharides, proteins, and eDNA. High-velocity asymmetric cavitation micro-jets (&gt;100 m/s) generate localized transient wall shear stresses exceeding 1,000 Pa, far surpassing the critical yield stress of bacterial adhesion matrices (typically 400-900 Pa). This mechanical shockwave peels the biofilm cleanly off stainless steel grain boundaries.
        </p>
      </div>

      <div class="bg-surface-soft border border-hairline rounded-2xl p-5 space-y-3">
        <div class="w-8 h-8 rounded-lg bg-indigo-500/10 text-indigo-600 flex items-center justify-center font-bold text-xs">
          03
        </div>
        <h4 class="text-sm font-bold text-ink">ASTM G32 Cavitation Erosion Thresholds</h4>
        <p class="text-xs text-muted leading-relaxed">
          Excessive acoustic power density without fluid flow can induce acoustic micro-pitting on stainless steel surfaces, creating microscopic crevices that actually accelerate bacterial re-colonization. To comply with ASTM G32 and EHEDG Document 8 cleanability standards, acoustic power density is dynamically balanced against fluid velocity to ensure bubble collapse occurs in the fluid boundary layer rather than directly eroding the passivated Cr₂O₃ oxide film.
        </p>
      </div>
    </div>

    <!-- Technical Specifications Table -->
    <div class="space-y-4">
      <h4 class="text-base font-bold text-ink tracking-tight">{d.tableTitle}</h4>
      <div class="overflow-x-auto rounded-2xl border border-hairline bg-surface">
        <table class="w-full text-left text-xs border-collapse">
          <thead>
            <tr class="border-b border-hairline bg-surface-soft text-muted">
              <th class="p-3.5 font-semibold">Resonator Architecture</th>
              <th class="p-3.5 font-semibold">Dual Frequencies</th>
              <th class="p-3.5 font-semibold">Max Power Density</th>
              <th class="p-3.5 font-semibold">Pipe Diameter</th>
              <th class="p-3.5 font-semibold">Standards &amp; Certifications</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-hairline text-ink">
            {ultrasonicData.ultrasonicSystems.map(sys => (
              <tr class="hover:bg-surface-soft/50 transition-colors">
                <td class="p-3.5 font-medium">{sys.name}</td>
                <td class="p-3.5 font-mono">{sys.frequency1Khz} kHz / {sys.frequency2Khz} kHz</td>
                <td class="p-3.5 font-mono text-cyan-600 dark:text-cyan-400">{sys.maxPowerDensityWPerL} W/L</td>
                <td class="p-3.5 font-mono">{sys.pipeDiameterMm} mm ({sys.pipeVolumeLiters} L)</td>
                <td class="p-3.5 text-muted">{sys.sanitaryCertifications}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
  import ultrasonicData from '../data/dual-frequency-ultrasonic-data.json';

  function initUltrasonicModeler() {
    // Selects
    const sysSelect = document.getElementById('us-sys-select') as HTMLSelectElement | null;
    const biofilmSelect = document.getElementById('us-biofilm-select') as HTMLSelectElement | null;
    const substrateSelect = document.getElementById('us-substrate-select') as HTMLSelectElement | null;
    const solutionSelect = document.getElementById('us-solution-select') as HTMLSelectElement | null;

    // Sliders
    const powerSlider = document.getElementById('us-power-slider') as HTMLInputElement | null;
    const velocitySlider = document.getElementById('us-velocity-slider') as HTMLInputElement | null;
    const tempSlider = document.getElementById('us-temp-slider') as HTMLInputElement | null;
    const timeSlider = document.getElementById('us-time-slider') as HTMLInputElement | null;

    // Value Labels
    const powerVal = document.getElementById('us-power-val');
    const velocityVal = document.getElementById('us-velocity-val');
    const tempVal = document.getElementById('us-temp-val');
    const timeVal = document.getElementById('us-time-val');

    // Outputs
    const outEnergy = document.getElementById('out-energy-val');
    const barEnergy = document.getElementById('bar-energy');
    const subJetVel = document.getElementById('sub-jet-vel');

    const outDesorption = document.getElementById('out-desorption-val');
    const barDesorption = document.getElementById('bar-desorption');
    const subShearMargin = document.getElementById('sub-shear-margin');

    const outLog = document.getElementById('out-log-val');
    const barLog = document.getElementById('bar-log');
    const subTargetMicrobe = document.getElementById('sub-target-microbe');

    const outUniformity = document.getElementById('out-uniformity-val');
    const barUniformity = document.getElementById('bar-uniformity');
    const subShadowState = document.getElementById('sub-shadow-state');

    const outWallShear = document.getElementById('out-wall-shear');
    const outErosionMargin = document.getElementById('out-erosion-margin');
    const outEhedgClass = document.getElementById('out-ehedg-class');

    const outPrimaryLimit = document.getElementById('out-primary-limit');
    const outMitigationAction = document.getElementById('out-mitigation-action');

    // Status Banner
    const statusBanner = document.getElementById('us-status-banner');
    const statusIcon = document.getElementById('us-status-icon');
    const badgePill = document.getElementById('us-badge-pill');
    const statusHeading = document.getElementById('us-status-heading');
    const statusDesc = document.getElementById('us-status-desc');

    function calculate() {
      if (!sysSelect || !biofilmSelect || !substrateSelect || !solutionSelect || 
          !powerSlider || !velocitySlider || !tempSlider || !timeSlider) return;

      const currentSys = ultrasonicData.ultrasonicSystems.find(s => s.id === sysSelect.value) || ultrasonicData.ultrasonicSystems[0];
      const currentBiofilm = ultrasonicData.biofilmTypes.find(b => b.id === biofilmSelect.value) || ultrasonicData.biofilmTypes[0];
      const currentSubstrate = ultrasonicData.pipeSubstrates.find(sub => sub.id === substrateSelect.value) || ultrasonicData.pipeSubstrates[0];
      const currentSolution = ultrasonicData.cleaningSolutions.find(sol => sol.id === solutionSelect.value) || ultrasonicData.cleaningSolutions[0];

      const powerWPerL = parseFloat(powerSlider.value);
      const velocityMps = parseFloat(velocitySlider.value);
      const tempC = parseFloat(tempSlider.value);
      const timeSec = parseFloat(timeSlider.value);

      // Label updates
      if (powerVal) powerVal.textContent = `${powerWPerL.toFixed(0)} W/L`;
      if (velocityVal) velocityVal.textContent = `${velocityMps.toFixed(1)} m/s`;
      if (tempVal) tempVal.textContent = `${tempC.toFixed(0)} °C`;
      if (timeVal) timeVal.textContent = `${timeSec.toFixed(0)} s`;

      // 1. Acoustic Field Uniformity Index (%)
      // Single frequency / detuned systems suffer destructive standing wave interference
      let baseUniformity = 94.0;
      if (currentSys.id === 'compromised_detuned_transducer_skid') {
        baseUniformity = 32.0; // Severe nodal cancellation
      } else if (currentSys.id === 'high_intensity_axial_sonochamber') {
        baseUniformity = 96.5; // Axial + megasonic dual coupling
      } else if (currentSys.id === 'clamp_on_radial_flow_reactor') {
        baseUniformity = 94.5;
      } else {
        baseUniformity = 91.0;
      }
      // Velocity smoothing effect on acoustic shadows
      const velocitySmoothing = Math.min(4.0, (velocityMps - 0.5) * 2.0);
      const uniformityPct = Math.min(99.5, Math.max(25.0, baseUniformity + velocitySmoothing));

      // 2. Transient Cavitation Energy Density (J/cm²)
      // E_cav = Power * Time / Surface_Area * Cavitation_Yield_Factor
      // Temperature effect: peak cavitation collapse occurs around 40-55°C for aqueous CIP
      let tempCavFactor = 1.0;
      if (tempC < 40) {
        tempCavFactor = 0.75 + (tempC / 40.0) * 0.25;
      } else if (tempC <= 58) {
        tempCavFactor = 1.0 + ((58 - tempC) / 18.0) * 0.15;
      } else {
        // Vapor cushioning softening bubble collapse
        tempCavFactor = Math.max(0.45, 1.15 - ((tempC - 58) / 22.0) * 0.65);
      }

      const surfaceFactor = currentSubstrate.acousticReflectivity;
      const energyJPerCm2 = (powerWPerL * 0.028) * (timeSec / 20.0) * currentSolution.cavitationYieldFactor * tempCavFactor * surfaceFactor * (uniformityPct / 100.0);

      // Micro-jet velocity (m/s)
      const microJetVelocity = Math.min(220, Math.max(30, 60.0 + Math.sqrt(powerWPerL) * 7.5 * tempCavFactor));

      // 3. Acoustic Micro-Streaming Wall Shear Stress (Pa)
      // Hydrodynamic shear + acoustic micro-streaming shear
      const hydrodynamicShear = 8.0 * (1000.0 * Math.pow(velocityMps, 1.75)) * 0.003; // ~15 - 120 Pa
      const acousticStreamingShear = (powerWPerL * 9.5) * (uniformityPct / 100.0) * currentSolution.cavitationYieldFactor;
      const totalWallShearPa = hydrodynamicShear + acousticStreamingShear;

      // 4. Biofilm Desorption & Detachment (%)
      // Compares Wall Shear & Cavitation Energy against Biofilm Adhesion Threshold
      const reqEnergy = currentBiofilm.cavitationDesorptionEnergyJPerCm2;
      const reqShear = currentBiofilm.adhesionShearStrengthPa;

      const energyRatio = energyJPerCm2 / reqEnergy;
      const shearRatio = totalWallShearPa / reqShear;
      const chemBoost = currentSolution.epsHydrolysisFactor;

      let desorptionPct = 0;
      if (currentSys.id === 'compromised_detuned_transducer_skid') {
        desorptionPct = Math.min(68.0, 35.0 + shearRatio * 15.0);
      } else {
        const combinedYield = (energyRatio * 0.55 + shearRatio * 0.45) * chemBoost;
        if (combinedYield < 0.6) {
          desorptionPct = combinedYield * 75.0;
        } else if (combinedYield < 1.0) {
          desorptionPct = 75.0 + (combinedYield - 0.6) * 45.0;
        } else {
          desorptionPct = 95.0 + Math.min(4.99, (combinedYield - 1.0) * 3.5);
        }
      }
      if (desorptionPct > 99.99) desorptionPct = 99.99;
      if (desorptionPct < 5.0) desorptionPct = 5.0;

      // 5. Viable Pathogen Log10 Reduction
      let logReduction = 0;
      if (desorptionPct < 70) {
        logReduction = (desorptionPct / 70.0) * 1.8;
      } else if (desorptionPct < 95) {
        logReduction = 1.8 + ((desorptionPct - 70.0) / 25.0) * 2.2;
      } else {
        logReduction = 4.0 + ((desorptionPct - 95.0) / 4.99) * 2.5;
      }
      if (currentSolution.id === 'peracetic_acid_sanitizer') {
        logReduction += 0.9; // Oxidizer synergy
      }
      if (currentSys.id === 'compromised_detuned_transducer_skid') {
        logReduction = Math.min(1.85, logReduction);
      }
      if (logReduction > 7.2) logReduction = 7.2;

      // 6. Substrate Cavitation Erosion Margin (ASTM G32)
      // Allowable threshold vs actual power density
      const allowPower = currentSubstrate.cavitationErosionThresholdWPerL;
      const erosionRatio = allowPower / powerWPerL;

      // 7. Update Output UI
      if (outEnergy) outEnergy.textContent = energyJPerCm2.toFixed(1);
      if (barEnergy) {
        const energyBarPct = Math.min(100, (energyJPerCm2 / 160.0) * 100);
        barEnergy.style.width = `${energyBarPct}%`;
      }
      if (subJetVel) subJetVel.textContent = `${microJetVelocity.toFixed(0)} m/s`;

      if (outDesorption) outDesorption.textContent = desorptionPct.toFixed(2);
      if (barDesorption) {
        barDesorption.style.width = `${Math.min(100, desorptionPct)}%`;
      }
      if (subShearMargin) {
        subShearMargin.textContent = `${shearRatio.toFixed(1)}x Adhesion Yield`;
        if (shearRatio >= 1.2) {
          subShearMargin.className = 'font-bold text-emerald-600 dark:text-emerald-400';
        } else if (shearRatio >= 0.9) {
          subShearMargin.className = 'font-bold text-amber-600 dark:text-amber-400';
        } else {
          subShearMargin.className = 'font-bold text-rose-600 dark:text-rose-400';
        }
      }

      if (outLog) outLog.textContent = logReduction.toFixed(2);
      if (barLog) {
        const logPct = Math.min(100, (logReduction / 6.0) * 100);
        barLog.style.width = `${logPct}%`;
      }
      if (subTargetMicrobe) subTargetMicrobe.textContent = currentBiofilm.microbe;

      if (outUniformity) outUniformity.textContent = uniformityPct.toFixed(1);
      if (barUniformity) {
        barUniformity.style.width = `${uniformityPct}%`;
      }
      if (subShadowState) {
        if (uniformityPct >= 90) {
          subShadowState.textContent = 'Zero Nodal Dead Zones';
          subShadowState.className = 'font-bold text-emerald-600 dark:text-emerald-400';
        } else if (uniformityPct >= 75) {
          subShadowState.textContent = 'Minor Acoustic Ripple';
          subShadowState.className = 'font-bold text-amber-600 dark:text-amber-400';
        } else {
          subShadowState.textContent = 'Severe Nodal Shadows';
          subShadowState.className = 'font-bold text-rose-600 dark:text-rose-400';
        }
      }

      if (outWallShear) outWallShear.textContent = `${totalWallShearPa.toFixed(0)} Pa`;
      if (outErosionMargin) {
        outErosionMargin.textContent = `${erosionRatio.toFixed(2)}x Margin (${erosionRatio >= 1.0 ? 'ASTM G32 Safe' : 'ASTM G32 Violation'})`;
        if (erosionRatio >= 1.15) {
          outErosionMargin.className = 'font-mono font-bold text-emerald-600 dark:text-emerald-400 text-sm mt-0.5 block';
        } else if (erosionRatio >= 1.0) {
          outErosionMargin.className = 'font-mono font-bold text-amber-600 dark:text-amber-400 text-sm mt-0.5 block';
        } else {
          outErosionMargin.className = 'font-mono font-bold text-rose-600 dark:text-rose-400 text-sm mt-0.5 block';
        }
      }

      if (outEhedgClass) {
        if (currentSys.id === 'compromised_detuned_transducer_skid' || currentSubstrate.id === 'corroded_pitted_ss304') {
          outEhedgClass.textContent = 'NON-COMPLIANT (Harbor Site)';
          outEhedgClass.className = 'font-mono font-medium text-rose-600 dark:text-rose-400 text-sm mt-0.5 block';
        } else if (desorptionPct >= 99.9 && erosionRatio >= 1.0) {
          outEhedgClass.textContent = 'EHEDG Class 1 Fully Cleanable';
          outEhedgClass.className = 'font-mono font-medium text-emerald-600 dark:text-emerald-400 text-sm mt-0.5 block';
        } else {
          outEhedgClass.textContent = 'EHEDG Class 2 (Requires Inspection)';
          outEhedgClass.className = 'font-mono font-medium text-amber-600 dark:text-amber-400 text-sm mt-0.5 block';
        }
      }

      // 8. Primary Limitation and Action Protocol
      if (outPrimaryLimit && outMitigationAction) {
        if (currentSys.id === 'compromised_detuned_transducer_skid') {
          outPrimaryLimit.textContent = 'SEVERE ACOUSTIC CANCELLATION: Transducer detuning creates stationary acoustic pressure nulls where biofilm remains entirely untouched by micro-jets.';
          outMitigationAction.textContent = 'Shut down line, replace cracked Langevin piezoceramic rings, and re-tune swept-frequency auto-tracking generator under 3-A Sanitary standard protocol.';
        } else if (currentSubstrate.id === 'corroded_pitted_ss304') {
          outPrimaryLimit.textContent = 'SUBSTRATE MICRO-PITTING: Pitted surface crevices shelter bacteria from boundary shear; high acoustic power density causes rapid pit cavitation erosion.';
          outMitigationAction.textContent = 'Decommission pitted 304 pipe spool. Replace with electropolished 316L sanitary tubing (Ra < 0.38 µm) passivated with citric/nitric acid per ASTM A967.';
        } else if (erosionRatio < 1.0) {
          outPrimaryLimit.textContent = 'CAVITATION EROSION HAZARD: Power density exceeds substrate acoustic endurance limit (ASTM G32), threatening grain boundary spalling.';
          outMitigationAction.textContent = 'Reduce acoustic power density below substrate threshold or upgrade flow cell to Titanium Grade 5 sonotrode.';
        } else if (tempC > 65) {
          outPrimaryLimit.textContent = 'VAPOR CUSHIONING ATTENUATION: High fluid vapor pressure cushions bubble implosions, softening micro-jet shockwave velocity.';
          outMitigationAction.textContent = 'Lower cleaning fluid temperature to 45-55°C to maximize water acoustic impedance and collapse impulse.';
        } else if (desorptionPct >= 99.9) {
          outPrimaryLimit.textContent = 'OPTIMAL DUAL-FREQUENCY DESORPTION: Orthogonal 28 kHz macro-cavitation and 40 kHz micro-streaming peel EPS matrices with zero substrate pitting.';
          outMitigationAction.textContent = 'Maintain bulk liquid flow between 0.8 and 1.5 m/s to continuously flush detached biomass downstream without redeposition.';
        } else {
          outPrimaryLimit.textContent = 'INSUFFICIENT ACOUSTIC ENERGY: Power density or exposure duration is below the critical threshold required to sever adhesive curli/EPS fibrils.';
          outMitigationAction.textContent = 'Increase power density by 20-30% or introduce multi-enzyme surfactant chemistry to lower biofilm cohesive strength.';
        }
      }

      // 9. Status Banner Updates
      if (statusBanner && statusIcon && badgePill && statusHeading && statusDesc) {
        if (currentSys.id === 'compromised_detuned_transducer_skid' || currentSubstrate.id === 'corroded_pitted_ss304' || erosionRatio < 0.9 || desorptionPct < 70) {
          statusBanner.className = 'rounded-3xl p-6 sm:p-7 border border-rose-500/20 bg-rose-500/5 transition-all duration-300';
          statusIcon.className = 'w-10 h-10 rounded-2xl bg-rose-500/10 text-rose-600 dark:text-rose-400 flex items-center justify-center shrink-0 font-bold text-lg';
          statusIcon.textContent = '✕';
          badgePill.className = 'px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-rose-500/20 text-rose-700 dark:text-rose-300';
          badgePill.textContent = 'Unsanitary Bypass / Erosion Hazard';
          statusHeading.textContent = 'Biofilm Retention or Severe Cavitation Pitting Detected';
          statusDesc.textContent = 'Acoustic field suffers from standing wave cancellation dead zones, surface pit harborage, or substrate mechanical damage failing EHEDG Doc 8.';
        } else if (desorptionPct < 99.0 || erosionRatio < 1.1) {
          statusBanner.className = 'rounded-3xl p-6 sm:p-7 border border-amber-500/20 bg-amber-500/5 transition-all duration-300';
          statusIcon.className = 'w-10 h-10 rounded-2xl bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center shrink-0 font-bold text-lg';
          statusIcon.textContent = '⚠';
          badgePill.className = 'px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-amber-500/20 text-amber-700 dark:text-amber-300';
          badgePill.textContent = 'Partial Biofilm Desorption';
          statusHeading.textContent = 'Marginal Desorption Rate &bull; Elevate Acoustic Power or Time';
          statusDesc.textContent = 'Biofilm detachment is incomplete or erosion safety margin is narrow. Adjust fluid temperature to 45-55°C and verify enzymatic chemistry.';
        } else {
          statusBanner.className = 'rounded-3xl p-6 sm:p-7 border border-emerald-500/20 bg-emerald-500/5 transition-all duration-300';
          statusIcon.className = 'w-10 h-10 rounded-2xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0 font-bold text-lg';
          statusIcon.textContent = '✓';
          badgePill.className = 'px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-emerald-500/20 text-emerald-700 dark:text-emerald-300';
          badgePill.textContent = 'EHEDG Class 1 Clean &bull; ASTM G32 Safe';
          statusHeading.textContent = 'Complete Dual-Frequency Desorption &bull; Zero Dead Zones';
          statusDesc.textContent = 'Acoustic micro-jets overcome biofilm adhesive shear strength. Biomass is continuously desorbed and purged with zero grain boundary pitting.';
        }
      }
    }

    // Attach Event Listeners
    sysSelect?.addEventListener('change', calculate);
    biofilmSelect?.addEventListener('change', calculate);
    substrateSelect?.addEventListener('change', calculate);
    solutionSelect?.addEventListener('change', calculate);

    powerSlider?.addEventListener('input', calculate);
    velocitySlider?.addEventListener('input', calculate);
    tempSlider?.addEventListener('input', calculate);
    timeSlider?.addEventListener('input', calculate);

    // Preset Handlers
    document.getElementById('btn-preset-listeria')?.addEventListener('click', () => {
      if (sysSelect) sysSelect.value = 'clamp_on_radial_flow_reactor';
      if (biofilmSelect) biofilmSelect.value = 'listeria_monocytogenes_eps';
      if (substrateSelect) substrateSelect.value = 'ss316l_electropolished';
      if (solutionSelect) solutionSelect.value = 'neutral_enzymatic_surfactant';
      if (powerSlider) powerSlider.value = '85';
      if (velocitySlider) velocitySlider.value = '1.2';
      if (tempSlider) tempSlider.value = '45';
      if (timeSlider) timeSlider.value = '45';
      calculate();
    });

    document.getElementById('btn-preset-milkstone')?.addEventListener('click', () => {
      if (sysSelect) sysSelect.value = 'high_intensity_axial_sonochamber';
      if (biofilmSelect) biofilmSelect.value = 'bacillus_cereus_endospore_matrix';
      if (substrateSelect) substrateSelect.value = 'ss316l_electropolished';
      if (solutionSelect) solutionSelect.value = 'mild_alkaline_caustic';
      if (powerSlider) powerSlider.value = '140';
      if (velocitySlider) velocitySlider.value = '0.8';
      if (tempSlider) tempSlider.value = '60';
      if (timeSlider) timeSlider.value = '60';
      calculate();
    });

    document.getElementById('btn-preset-pseudomonas')?.addEventListener('click', () => {
      if (sysSelect) sysSelect.value = 'clamp_on_radial_flow_reactor';
      if (biofilmSelect) biofilmSelect.value = 'pseudomonas_aeruginosa_alginate';
      if (substrateSelect) substrateSelect.value = 'ss304_mill_finish';
      if (solutionSelect) solutionSelect.value = 'peracetic_acid_sanitizer';
      if (powerSlider) powerSlider.value = '75';
      if (velocitySlider) velocitySlider.value = '1.5';
      if (tempSlider) tempSlider.value = '25';
      if (timeSlider) timeSlider.value = '30';
      calculate();
    });

    document.getElementById('btn-preset-pilot')?.addEventListener('click', () => {
      if (sysSelect) sysSelect.value = 'pilot_multi_frequency_loop';
      if (biofilmSelect) biofilmSelect.value = 'salmonella_curli_fimbriae';
      if (substrateSelect) substrateSelect.value = 'titanium_gr5_sonotrode';
      if (solutionSelect) solutionSelect.value = 'neutral_enzymatic_surfactant';
      if (powerSlider) powerSlider.value = '60';
      if (velocitySlider) velocitySlider.value = '1.0';
      if (tempSlider) tempSlider.value = '50';
      if (timeSlider) timeSlider.value = '45';
      calculate();
    });

    document.getElementById('btn-preset-hazard')?.addEventListener('click', () => {
      if (sysSelect) sysSelect.value = 'compromised_detuned_transducer_skid';
      if (biofilmSelect) biofilmSelect.value = 'listeria_monocytogenes_eps';
      if (substrateSelect) substrateSelect.value = 'corroded_pitted_ss304';
      if (solutionSelect) solutionSelect.value = 'cold_deionized_water';
      if (powerSlider) powerSlider.value = '35';
      if (velocitySlider) velocitySlider.value = '2.8';
      if (tempSlider) tempSlider.value = '20';
      if (timeSlider) timeSlider.value = '20';
      calculate();
    });

    // Initial calculation
    calculate();
  }

  // Support Astro view transitions / initial load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initUltrasonicModeler);
  } else {
    initUltrasonicModeler();
  }
  document.addEventListener('astro:page-load', initUltrasonicModeler);
</script>
