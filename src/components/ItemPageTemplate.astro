    </section>

    <!-- Contextual Consumer Tool Recommendation Card -->
    <section id="recommended-tool-card" class="mb-8 bg-surface-soft border border-hairline rounded-lg p-5 sm:p-6 shadow-xs no-print">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="min-w-0 flex-1">
