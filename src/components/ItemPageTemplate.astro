              <a href={savedSheetUrl} class="text-ink hover:text-link hover:underline font-semibold no-print">
                {lang === 'es' ? 'Ver Hoja de Referencia Imprimible para el Refrigerador →' :
                 lang === 'pt' ? 'Ver Folha Imprimível para a Geladeira →' :
                 lang === 'zh-cn' ? '查看可打印冰箱安全速查表 →' :
                 lang === 'ja' ? '印刷用キッチン安全早見表を見る →' :
                 'View Printable Fridge Cheat Sheet →'}
