            </p>
            <div class="mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-[12px]">
              <a href={methodologyUrl} class="text-link hover:underline font-medium">
                {lang === 'es' ? 'Metodología de Verificación' :
                 lang === 'pt' ? 'Metodologia de Verificação' :
                 lang === 'zh-cn' ? '查看安全核验方法论' :
                 lang === 'ja' ? '安全検証メソドロジーを見る' :
                 'Read Safety Methodology'} &rarr;
              </a>
              <span class="text-hairline hidden sm:inline">•</span>
              <a href={savedSheetUrl} class="text-ink hover:text-link hover:underline font-semibold no-print">
                {lang === 'es' ? 'Ver Hoja de Referencia Imprimible para el Refrigerador →' :
                 lang === 'pt' ? 'Ver Folha Imprimível para a Geladeira →' :
                 lang === 'zh-cn' ? '查看可打印冰箱安全速查表 →' :
                 lang === 'ja' ? '印刷用キッチン安全早見表を見る →' :
                 'View Printable Fridge Cheat Sheet →'}
              </a>
            </div>
          </div>
        </div>
      </div>
      <div class="pt-3">
        <span>{t('page.sourceNotice')} {t('page.spottedError')} <a href={getDirectoryUrl('contact', lang)} class="hover:underline font-semibold text-ink">{t('page.contactUs')}</a></span>
      </div>
    </section>

    <!-- FAQ Section -->
    <section id="faq-section" class="border-t border-hairline pt-12 mb-16 content-visibility-auto">
      <h2 class="text-title-lg text-ink font-medium tracking-tight mb-8">{t('page.faqTitle')}</h2>
      <div class="flex flex-col">
        {data.faqs.map((faq: { question: string; answer: string }) => (
          <details class="group border-b border-hairline py-5">
            <summary class="flex items-center justify-between text-title-sm text-ink font-medium cursor-pointer list-none [&::-webkit-details-marker]:hidden select-none">
              <span>{faq.question}</span>
              <span class="text-muted group-open:rotate-180 transition-transform duration-200">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </summary>
            <div class="mt-4 text-body-md text-body leading-relaxed pl-1">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- Direct Cross-linking Guides Box -->
    {lang === 'en' && (allGuides.howLongGuides.length > 0 || allGuides.refreezeGuides.length > 0 || allGuides.whatHappensGuides.length > 0 || allGuides.comparisonGuides.length > 0) && (
      <section id="cross-refs-section" class="mb-12 border-t border-hairline pt-12 content-visibility-auto">
        <h2 class="text-title-lg text-ink font-medium tracking-tight mb-6">Cross-Reference Safety Guides for {data.item}</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {allGuides.howLongGuides.map((g: any) => (
            <a href={g.url} class="p-4 bg-canvas border border-hairline rounded-md hover:border-border-strong text-body-md text-link flex justify-between items-center gap-3 transition-colors shadow-xs">
              <span class="font-medium min-w-0 flex-1 break-words">⏱ Shelf Life: {g.duration}</span>
              <span class="text-xs text-muted shrink-0 whitespace-nowrap">{t('page.readGuide')} &rarr;</span>
            </a>
          ))}
          {allGuides.refreezeGuides.map((g: any) => (
            <a href={g.url} class="p-4 bg-canvas border border-hairline rounded-md hover:border-border-strong text-body-md text-link flex justify-between items-center gap-3 transition-colors shadow-xs">
              <span class="font-medium min-w-0 flex-1 break-words">❄️ Refreezing Safety Rules</span>
              <span class="text-xs text-muted shrink-0 whitespace-nowrap">{t('page.readGuide')} &rarr;</span>
            </a>
          ))}
          {allGuides.whatHappensGuides.map((g: any) => (
            <a href={g.url} class="p-4 bg-canvas border border-hairline rounded-md hover:border-border-strong text-body-md text-link flex justify-between items-center gap-3 transition-colors shadow-xs">
              <span class="font-medium min-w-0 flex-1 break-words">⚠️ Accident Hazards & Danger</span>
              <span class="text-xs text-muted shrink-0 whitespace-nowrap">{t('page.readGuide')} &rarr;</span>
            </a>
          ))}
          {allGuides.comparisonGuides.map((g: any) => (
            <a href={g.url} class="p-4 bg-canvas border border-hairline rounded-md hover:border-border-strong text-body-md text-link flex justify-between items-center gap-3 transition-colors shadow-xs">
              <span class="font-medium min-w-0 flex-1 break-words">⚔️ Comparison: {g.item1} vs {g.item2}</span>
              <span class="text-xs text-muted shrink-0 whitespace-nowrap">Compare &rarr;</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- People Also Ask Section -->
    {lang === 'en' && paaList.length > 0 && (
      <section id="paa-section" class="border-t border-hairline pt-12 mb-16 content-visibility-auto">
        <h2 class="text-title-lg text-ink font-medium tracking-tight mb-8">{t('page.peopleAlsoAsk')}</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {paaList.map((paa: any) => (
            <a 
              href={paa.url} 
              class="bg-canvas border border-hairline hover:border-border-strong rounded-md p-5 flex flex-col justify-between shadow-xs transition-colors active:scale-[0.98]"
            >
              <div>
                <span class="text-[11px] text-muted uppercase tracking-wider block mb-2">Related Question</span>
                <h3 class="text-title-sm text-ink mb-2 leading-snug">
                  {paa.question}
                </h3>
              </div>
              <span class="text-[12px] font-medium text-link mt-4 block">View Answer &rarr;</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Related Items -->
    {relatedItems.length > 0 && (
      <section id="related-items-section" class="border-t border-hairline pt-12 mb-16 content-visibility-auto">
        <h2 class="text-title-lg text-ink font-medium tracking-tight mb-8">{t('page.relatedGuides')}</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {relatedItems.map((item: any) => (
            <a 
              href={translatePath(`/${item.appliance}/${item.slug}/`)} 
              class="bg-canvas border border-hairline hover:border-border-strong rounded-md p-5 flex flex-col justify-between shadow-xs transition-colors active:scale-[0.98]"
            >
              <div>
                <div class="flex items-center justify-between mb-3">
                  <span class="text-[11px] text-muted uppercase tracking-wider">{item.appliance}</span>
                  {item.safe === 'yes' && <span class="badge-yes text-[10px] px-2 py-0.5">{t('verdict.yes')}</span>}
                  {item.safe === 'no' && <span class="badge-no text-[10px] px-2 py-0.5">{t('verdict.no')}</span>}
                  {item.safe === 'depends' && <span class="badge-depends text-[10px] px-2 py-0.5">{t('verdict.depends')}</span>}
                </div>
                <h3 class="text-title-sm text-ink mb-1">
                  {item.item}
                </h3>
                <p class="text-[13px] text-muted line-clamp-2 leading-relaxed">
                  {item.shortAnswer}
                </p>
              </div>
              <span class="text-[12px] font-medium text-link mt-4 block">{t('page.readGuide')} &rarr;</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Back to Appliance Link -->
    <div class="mt-12 pt-8 border-t border-hairline text-center">
      <a 
        href={getApplianceUrl(data.appliance, lang)} 
        class="text-link text-[14px] font-medium hover:text-link-active transition-colors min-h-[44px] inline-flex items-center gap-1.5 active:scale-[0.98] transition-transform py-2.5 px-4 rounded-md hover:bg-surface-soft"
      >
        &larr; {t('home.viewAll')} {formattedAppliance} {t('page.guideSuffix')}
      </a>
    </div>
  </article>

  <script is:inline>
    (function() {
      function initItemInteractions() {
        // 1. Share Verdict & Copy to Clipboard
        var shareBtn = document.getElementById('share-verdict-btn');
        var shareBtnText = document.getElementById('share-btn-text');
        if (shareBtn && shareBtnText) {
          shareBtn.onclick = async function() {
            var title = shareBtn.getAttribute('data-share-title') || document.title;
            var text = shareBtn.getAttribute('data-share-text') || '';
            var copiedMsg = shareBtn.getAttribute('data-copied-text') || 'Copied!';
            var url = window.location.href;

            if (navigator.share) {
              try {
                await navigator.share({ title: title, text: text, url: url });
                return;
              } catch (err) {
                if (err.name === 'AbortError') return;
              }
            }

            // Fallback: Copy to clipboard
            try {
              await navigator.clipboard.writeText(text + '\n' + url);
              var prevText = shareBtnText.textContent;
              shareBtnText.textContent = '✓ ' + copiedMsg;
              shareBtn.classList.add('bg-success-bg', 'text-success', 'border-success-border/40');
              setTimeout(function() {
                shareBtnText.textContent = prevText;
                shareBtn.classList.remove('bg-success-bg', 'text-success', 'border-success-border/40');
              }, 2500);
            } catch (err) {
              console.error('Clipboard copy failed:', err);
            }
          };
        }

        // 2. Save / Bookmark Guide in LocalStorage
        var bookmarkBtn = document.getElementById('bookmark-item-btn');
        var bookmarkIcon = document.getElementById('bookmark-icon');
        var bookmarkText = document.getElementById('bookmark-btn-text');

        if (bookmarkBtn && bookmarkIcon && bookmarkText) {
          var slug = bookmarkBtn.getAttribute('data-item-slug');
          var name = bookmarkBtn.getAttribute('data-item-name');
          var appliance = bookmarkBtn.getAttribute('data-item-appliance');
          var safe = bookmarkBtn.getAttribute('data-item-safe');
          var saveMsg = bookmarkBtn.getAttribute('data-save-text') || 'Save Guide';
          var savedMsg = bookmarkBtn.getAttribute('data-saved-text') || 'Saved';

          function getSavedItems() {
            try {
              return JSON.parse(localStorage.getItem('kitchen_saved_items') || '[]');
            } catch (e) {
              return [];
            }
          }

          function updateBookmarkUI() {
            var items = getSavedItems();
            var isSaved = items.some(function(i) { return i.slug === slug && i.appliance === appliance; });
            if (isSaved) {
              bookmarkText.textContent = savedMsg;
              bookmarkBtn.classList.add('bg-warning-bg', 'text-warning', 'border-warning-border/40');
              bookmarkIcon.setAttribute('fill', 'currentColor');
              bookmarkIcon.classList.remove('text-muted');
              bookmarkIcon.classList.add('text-warning');
            } else {
              bookmarkText.textContent = saveMsg;
              bookmarkBtn.classList.remove('bg-warning-bg', 'text-warning', 'border-warning-border/40');
              bookmarkIcon.setAttribute('fill', 'none');
              bookmarkIcon.classList.remove('text-warning');
              bookmarkIcon.classList.add('text-muted');
            }
          }

          updateBookmarkUI();

          bookmarkBtn.onclick = function() {
            var items = getSavedItems();
            var existingIdx = items.findIndex(function(i) { return i.slug === slug && i.appliance === appliance; });
            if (existingIdx >= 0) {
              items.splice(existingIdx, 1);
            } else {
              items.push({
                slug: slug,
                name: name,
                item: name,
                appliance: appliance,
                safe: safe,
                url: window.location.pathname,
                timestamp: Date.now()
              });
            }
            try {
              localStorage.setItem('kitchen_saved_items', JSON.stringify(items));
            } catch (e) {}
            updateBookmarkUI();
          };
        }

        // 3. Print Kitchen Safety Card
        var printBtn = document.getElementById('print-card-btn');
        if (printBtn) {
          printBtn.onclick = function() {
            window.print();
          };
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initItemInteractions);
      } else {
        initItemInteractions();
      }
      document.addEventListener('astro:page-load', initItemInteractions);
    })();
  </script>
</Layout>
