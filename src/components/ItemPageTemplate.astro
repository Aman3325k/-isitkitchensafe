---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import TechnicalSpecs from './TechnicalSpecs.astro';
import itemsData from '../data/items.json';
import itemsEs from '../data/items.es.json';
import itemsPt from '../data/items.pt.json';
import itemsZh from '../data/items.zh-cn.json';
import itemsJa from '../data/items.ja.json';
import { generateMetaDescription } from '../utils/seoHelper.js';
import { resolveAllGuidesForItem, getPeopleAlsoAsk, getSmartRelatedItems } from '../utils/linkingHelper.js';
import { getCategoryForMaterial } from '../utils/materialCategories';
import { useTranslations, useTranslatedPath, getApplianceIn, getApplianceUrl, getDirectoryUrl, isDirectoryTranslatedInLocale } from '../i18n/utils';
import type { SupportedLanguage } from '../i18n/ui';

interface Props {
  data: any;
  lang?: SupportedLanguage;
  availableLocales?: SupportedLanguage[];
}

const { data, lang = 'en', availableLocales } = Astro.props;

const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

// Format appliance name
const appKey = `appliance.${data.appliance}` as any;
const formattedAppliance = t(appKey) || (data.appliance.charAt(0).toUpperCase() + data.appliance.slice(1));
const applianceInPhrase = getApplianceIn(data.appliance, lang);

// Select localized items dataset based on lang
const currentItemsDataset = lang === 'es' ? itemsEs : lang === 'pt' ? itemsPt : lang === 'zh-cn' ? itemsZh : lang === 'ja' ? itemsJa : itemsData;

// Find all other appliances containing this same item (All-Appliance Matrix Switcher)
const siblingApplianceItems: any[] = [];
const seenSiblingAppliances = new Set<string>();

for (const item of currentItemsDataset) {
  if (item.appliance === data.appliance) continue;
  if (seenSiblingAppliances.has(item.appliance)) continue;
  
  const matchesSlug = item.slug === data.slug;
  const matchesName = item.item && data.item && item.item.toLowerCase() === data.item.toLowerCase();
  
  if (matchesSlug || matchesName) {
    siblingApplianceItems.push(item);
    seenSiblingAppliances.add(item.appliance);
  }
}

// Get smart, topically-clustered related items (guaranteed minimum 5 relevant guides)
const relatedItems = getSmartRelatedItems(data, currentItemsDataset);

const allGuides = resolveAllGuidesForItem(data.item, data.slug);
const paaList = getPeopleAlsoAsk(data.item, data.slug, allGuides, data.relatedItems || []);

const formattedAnswer = data.safe.toUpperCase(); // "YES", "NO", or "DEPENDS"

// Format natural question heading per locale grammar
let questionHeading = `${t('page.canYouPut')} ${data.item} ${applianceInPhrase}?`;
if (lang === 'zh-cn') {
  questionHeading = `${data.item}可以${applianceInPhrase}吗？`;
} else if (lang === 'ja') {
  questionHeading = `${data.item}は${applianceInPhrase}入れても大丈夫？`;
}

// SEO title and description
let pageTitle = `Can You Put ${data.item} in the ${formattedAppliance}? | IsItKitchenSafe`;
let pageDescription = data.shortAnswer;

if (lang === 'es') {
  pageTitle = `¿Se puede meter ${data.item} ${applianceInPhrase}? | ¿Es Seguro en la Cocina?`;
  pageDescription = `${data.shortAnswer} Descubre advertencias de seguridad, consejos de cocina y reglas de compatibilidad.`;
} else if (lang === 'pt') {
  pageTitle = `Pode colocar ${data.item} ${applianceInPhrase}? | É Seguro na Cozinha?`;
  pageDescription = `${data.shortAnswer} Saiba mais sobre avisos de segurança, dicas de cozinha e regras de compatibilidade.`;
} else if (lang === 'zh-cn') {
  pageTitle = `${questionHeading} | 厨房安全指南`;
  pageDescription = `${data.shortAnswer} 查看安全使用注意事项、操作技巧与材质禁忌。`;
} else if (lang === 'ja') {
  pageTitle = `${questionHeading} | キッチン安全チェッカー`;
  pageDescription = `${data.shortAnswer} 安全上の注意点、冷凍のコツ、失敗しない保存方法を徹底解説。`;
} else {
  pageDescription = generateMetaDescription(data.item, formattedAppliance, formattedAnswer, data.shortAnswer);
}


const speakableSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": [".quick-answer", ".short-answer", "h1"]
  }
};

const howToSchema = (data.safe === 'yes' || data.safe === 'depends') ? {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": questionHeading,
  "description": data.shortAnswer,
  "step": data.tips.map((tip: string, idx: number) => ({
    "@type": "HowToStep",
    "position": idx + 1,
    "text": tip
  }))
} : null;

// AI-Ready Quick-Reference Summary Table Labels & Values
const summaryLabels = {
  heading: lang === 'es' ? 'Resumen de Seguridad de Referencia Rápida' :
           lang === 'pt' ? 'Resumo de Segurança de Referência Rápida' :
           lang === 'zh-cn' ? '安全速查摘要表' :
           lang === 'ja' ? 'クイック安全早見表' :
           'Quick-Reference Safety Summary',
  item: lang === 'es' ? 'Artículo' : lang === 'pt' ? 'Item' : lang === 'zh-cn' ? '物品' : lang === 'ja' ? '対象アイテム' : 'Item',
  appliance: lang === 'es' ? 'Electrodoméstico' : lang === 'pt' ? 'Eletrodoméstico' : lang === 'zh-cn' ? '适用电器' : lang === 'ja' ? '対象家電' : 'Appliance',
  verdict: lang === 'es' ? 'Veredicto de Seguridad' : lang === 'pt' ? 'Veredito de Segurança' : lang === 'zh-cn' ? '安全结论' : lang === 'ja' ? '安全判定' : 'Safety Verdict',
  materialRisk: lang === 'es' ? 'Material / Riesgo Principal' : lang === 'pt' ? 'Material / Risco Principal' : lang === 'zh-cn' ? '主要材质与风险' : lang === 'ja' ? '主な材質・リスク' : 'Primary Material / Risk',
  quickAction: lang === 'es' ? 'Acción Recomendada' : lang === 'pt' ? 'Ação Recomendada' : lang === 'zh-cn' ? '建议操作' : lang === 'ja' ? '推奨アクション' : 'Quick Action'
};

const primaryRiskText = data.keyRisk || data.specific_warning || (data.warnings && data.warnings[0]) || '';
const primaryMaterialRiskDisplay = data.material && primaryRiskText
  ? `${data.material} — ${primaryRiskText}`
  : (data.material || primaryRiskText || formattedAppliance);
const quickActionText = data.tip || (data.tips && data.tips[0]) || (data.instructions && data.instructions[0]) || data.shortAnswer;

// Contextual Consumer Tool Recommendation
const matchContext = `${data.slug || ''} ${data.item || ''} ${data.material || ''}`.toLowerCase();
type RecommendedToolKey =
  | 'cleaner'
  | 'descaling'
  | 'pan'
  | 'plastic'
  | 'thawing'
  | 'cookingTemp'
  | 'leftover'
  | 'ovenTemp'
  | 'airfryer'
  | 'oil'
  | 'symbol';

let recommendedToolKey: RecommendedToolKey = 'symbol';

if (/\b(bleach|vinegar|ammonia|peroxide|cleaners?|detergents?|baking[- ]soda|soaps?|sanitizers?|disinfectants?|drain[- ]cleaners?|lye|caustic|rinse[- ]aid|dishwasher[- ]pods?)\b/i.test(matchContext)) {
  recommendedToolKey = 'cleaner';
} else if (/\b(coffee|espresso|kettles?|keurig|nespresso|carafes?|ice[- ]makers?|steamers?|descal(?:e|ing))\b/i.test(matchContext)) {
  recommendedToolKey = 'descaling';
} else if (/\b(nonstick|non[- ]stick|teflon|ptfe|ceramic[- ]pans?|hexclad|caraway|fry(?:ing)?[- ]pans?|skillets?|cast[- ]iron|carbon[- ]steel|woks?)\b/i.test(matchContext)) {
  recommendedToolKey = 'pan';
} else if (/\b(plastics?|tupperware|styrofoam|polystyrene|polypropylene|pet|hdpe|pvc|silicone[- ]bags?|ziploc|water[- ]bottles?|takeout|cling|wraps?)\b/i.test(matchContext)) {
  recommendedToolKey = 'plastic';
} else if (
  data.appliance === 'freezer' &&
  /\b(chicken|turkey|beef|pork|steaks?|meats?|ham|lamb|fish|salmon|shrimp|seafood|bacon|sausages?|ground)\b/i.test(matchContext)
) {
  recommendedToolKey = 'thawing';
} else if (
  (data.appliance === 'oven' || data.appliance === 'airfryer') &&
  /\b(chicken|turkey|beef|pork|steaks?|meats?|ham|lamb|fish|salmon|shrimp|seafood|eggs?|casseroles?)\b/i.test(matchContext)
) {
  recommendedToolKey = 'cookingTemp';
} else if (
  (data.appliance === 'refrigerator' || data.appliance === 'freezer') &&
  /\b(milk|cheese|yogurt|cream|eggs?|leftovers?|rice|pasta|pizza|soups?|stews?|bread|fruits?|avocados?|berr(?:y|ies)|potato(?:es)?|tomato(?:es)?|onions?|meats?|chicken|fish|broth|pies?|salads?)\b/i.test(matchContext)
) {
  recommendedToolKey = 'leftover';
} else if (
  data.appliance === 'oven' &&
  /\b(pyrex|glass|ceramic|stoneware|cast[- ]iron|dutch[- ]ovens?|le[- ]creuset|lodge|stainless|parchment|wax[- ]paper|foil|silicone|bakeware|baking[- ]sheets?|pans?|pots?|lids?)\b/i.test(matchContext)
) {
  recommendedToolKey = 'ovenTemp';
} else if (data.appliance === 'airfryer') {
  recommendedToolKey = 'airfryer';
} else if (/\b(oils?|butter|ghee|lard|shortening)\b/i.test(matchContext)) {
  recommendedToolKey = 'oil';
}

const interactiveToolBadge =
  lang === 'es' ? 'Herramienta Interactiva' :
  lang === 'pt' ? 'Ferramenta Interativa' :
  lang === 'zh-cn' ? '互动工具' :
  lang === 'ja' ? 'インタラクティブツール' :
  'Interactive Tool';

const toolCatalog: Record<RecommendedToolKey, {
  path: string;
  icon: string;
  badge: string;
  title: string;
  description: string;
  cta: string;
}> = {
  cleaner: {
    path: '/tools/cleaner-mixing-danger-checker/',
    icon: '🧪',
    badge: interactiveToolBadge,
    title: lang === 'es' ? 'Verificador de Peligro al Mezclar Limpiadores de Cocina' :
           lang === 'pt' ? 'Verificador de Perigo ao Misturar Produtos de Limpeza' :
           lang === 'zh-cn' ? '厨房清洁剂混用危险检测器' :
           lang === 'ja' ? 'キッチン洗剤の危険な混合チェッカー' :
           'Kitchen Cleaner Mixing Danger Checker',
    description: lang === 'es' ? 'Comprueba dos limpiadores domésticos antes de mezclarlos para detectar al instante gas cloro tóxico, cloramina o reacciones peligrosas.' :
                 lang === 'pt' ? 'Verifique dois produtos de limpeza antes de misturá-los para detectar instantaneamente gás cloro tóxico, cloramina ou reações perigosas.' :
                 lang === 'zh-cn' ? '混合清洁剂前一键排查两种化学成分，即时识别氯气、氯胺中毒与剧烈放热反应风险。' :
                 lang === 'ja' ? '2種類の家庭用洗剤を混ぜる前にチェックし、有毒な塩素ガスやクロラミン発生、発熱反応の危険を瞬時に判定します。' :
                 'Check two household cleaners before mixing to detect toxic chlorine gas, chloramine, or exothermic reaction hazards instantly.',
    cta: lang === 'es' ? 'Verificar Mezcla' : lang === 'pt' ? 'Verificar Mistura' : lang === 'zh-cn' ? '检测混用风险' : lang === 'ja' ? '混合の危険を確認' : 'Check Cleaner Mix'
  },
  descaling: {
    path: '/tools/appliance-descaling-calculator/',
    icon: '☕',
    badge: interactiveToolBadge,
    title: lang === 'es' ? 'Calculadora de Descalcificación para Cafeteras y Hervidores' :
           lang === 'pt' ? 'Calculadora de Descalcificação para Cafeteiras e Chaleiras' :
           lang === 'zh-cn' ? '咖啡机与水壶除垢比例计算器' :
           lang === 'ja' ? 'コーヒーメーカー・ケトル水垢除去比率計算ツール' :
           'Coffee Maker & Kettle Descaling Ratio Calculator',
    description: lang === 'es' ? 'Calcula la proporción exacta de ácido cítrico o vinagre blanco y los ciclos de enjuague para tu cafetera, máquina de espresso o hervidor.' :
                 lang === 'pt' ? 'Calcule a proporção exata de ácido cítrico ou vinagre branco e ciclos de enxágue para sua cafeteira, máquina de espresso ou chaleira.' :
                 lang === 'zh-cn' ? '根据咖啡机、意式机或电水壶容量，精准计算柠檬酸或白醋除垢配比与安全冲洗次数。' :
                 lang === 'ja' ? 'コーヒーメーカー・エスプレッソマシン・電気ケトルの容量に合わせて、クエン酸や酢の安全な配合比とすすぎ回数を計算します。' :
                 'Calculate exact citric acid or white vinegar descaling ratios and rinse cycles tailored to your coffee maker, espresso machine, or kettle.',
    cta: lang === 'es' ? 'Calcular Proporción' : lang === 'pt' ? 'Calcular Proporção' : lang === 'zh-cn' ? '计算除垢比例' : lang === 'ja' ? '除垢比率を計算' : 'Calculate Descaling Ratio'
  },
  pan: {
    path: '/tools/pan-scratch-inspector/',
    icon: '🍳',
    badge: interactiveToolBadge,
    title: lang === 'es' ? 'Inspector IA de Rayones y Daño de Recubrimiento en Sartenes' :
           lang === 'pt' ? 'Inspetor IA de Riscos e Danos no Revestimento de Panelas' :
           lang === 'zh-cn' ? 'AI 不粘锅划痕与涂层损伤检测器' :
           lang === 'ja' ? 'AIフライパン傷・コーティング劣化診断ツール' :
           'AI Pan Scratch & Coating Damage Inspector',
    description: lang === 'es' ? 'Evalúa si tu sartén antiadherente, de teflón o cerámica con rayones sigue siendo segura o si debes reemplazarla para evitar desprendimiento.' :
                 lang === 'pt' ? 'Avalie se sua panela antiaderente, de teflon ou cerâmica riscada ainda é segura para cozinhar ou deve ser substituída para evitar descamação.' :
                 lang === 'zh-cn' ? '评估不粘锅、特氟龙或陶瓷涂层的划伤与剥落程度，判断是继续安全使用还是应立即更换。' :
                 lang === 'ja' ? '傷ついたフッ素樹脂・テフロン・セラミック製フライパンがそのまま使えるか、剥がれリスクのため買い替えるべきかを診断します。' :
                 'Assess whether your scratched nonstick, Teflon, or ceramic pan is still safe to cook with or should be replaced to avoid coating flaking.',
    cta: lang === 'es' ? 'Inspeccionar Sartén' : lang === 'pt' ? 'Inspecionar Panela' : lang === 'zh-cn' ? '开始检测锅具' : lang === 'ja' ? 'フライパンを診断' : 'Inspect Your Pan'
  },
  plastic: {
    path: '/tools/plastic-code-checker/',
    icon: '♻️',
    badge: interactiveToolBadge,
    title: lang === 'es' ? 'Verificador de Seguridad de Códigos de Plástico #1–#7' :
           lang === 'pt' ? 'Verificador de Segurança de Códigos de Plástico #1–#7' :
           lang === 'zh-cn' ? '塑料回收编号 #1–#7 安全查询器' :
           lang === 'ja' ? 'プラスチック識別番号 #1〜#7 安全性チェッカー' :
           'Plastic Recycling Code #1–#7 Safety Checker',
    description: lang === 'es' ? 'Consulta cualquier código de resina #1–#7 (PET, HDPE, PVC, PP, PS) para comprobar si es apto para microondas, lavavajillas, congelador y libre de BPA.' :
                 lang === 'pt' ? 'Consulte qualquer código de resina #1–#7 (PET, HDPE, PVC, PP, PS) para verificar segurança em micro-ondas, lava-louças, freezer e risco de BPA.' :
                 lang === 'zh-cn' ? '一键查询 #1–#7 塑料树脂代码（PET、HDPE、PVC、PP、PS 等），快速核对微波炉、洗碗机、冷冻耐受度与化学析出风险。' :
                 lang === 'ja' ? '#1〜#7のプラスチック材質番号（PET・HDPE・PVC・PP・PS等）から電子レンジ・食洗機・冷凍適性と溶出リスクを瞬時に確認できます。' :
                 'Look up any resin code #1–#7 (PET, HDPE, PVC, LDPE, PP, PS, Other) to check microwave, dishwasher, freezer, and BPA/leaching safety.',
    cta: lang === 'es' ? 'Verificar Código #1–#7' : lang === 'pt' ? 'Verificar Código #1–#7' : lang === 'zh-cn' ? '查询塑料编号' : lang === 'ja' ? 'プラ番号を確認' : 'Check Plastic Code'
  },
  thawing: {
    path: '/tools/meat-thawing-calculator/',
    icon: '❄️',
    badge: interactiveToolBadge,
    title: lang === 'es' ? 'Calculadora USDA de Descongelación Segura de Carne y Pavo' :
           lang === 'pt' ? 'Calculadora USDA de Descongelamento Seguro de Carne e Peru' :
           lang === 'zh-cn' ? 'USDA 肉类与火鸡安全解冻时间计算器' :
           lang === 'ja' ? 'USDA 肉・七面鳥の安全な解凍時間計算ツール' :
           'USDA Meat & Turkey Safe Thawing Calculator',
    description: lang === 'es' ? 'Calcula los tiempos exactos del USDA para descongelar en refrigerador o agua fría según peso y corte, evitando la zona de peligro bacteriano.' :
                 lang === 'pt' ? 'Calcule os tempos exatos do USDA para descongelar na geladeira ou em água fria por peso e corte, mantendo carnes fora da zona de perigo.' :
                 lang === 'zh-cn' ? '按重量与肉类部位精准计算 USDA 冷藏与冷水安全解冻时长，让禽肉、牛猪肉与海鲜远离细菌危险温区。' :
                 lang === 'ja' ? '重量と部位からUSDA基準の冷蔵解凍・冷水解凍時間を正確に計算し、食中毒の危険温度帯を避けて安全に解凍できます。' :
                 'Calculate exact USDA refrigerator and cold-water thawing times by weight and cut so poultry, beef, pork, and seafood stay out of the danger zone.',
    cta: lang === 'es' ? 'Calcular Descongelación' : lang === 'pt' ? 'Calcular Descongelamento' : lang === 'zh-cn' ? '计算解冻时间' : lang === 'ja' ? '解凍時間を計算' : 'Calculate Thaw Time'
  },
  cookingTemp: {
    path: '/tools/internal-cooking-temp-chart/',
    icon: '🌡️',
    badge: interactiveToolBadge,
    title: lang === 'es' ? 'Tabla USDA de Temperaturas Internas Seguras de Cocción' :
           lang === 'pt' ? 'Tabela USDA de Temperaturas Internas Seguras de Cozimento' :
           lang === 'zh-cn' ? 'USDA 安全烹饪中心温度速查表' :
           lang === 'ja' ? 'USDA 安全な調理中心温度チャート' :
           'USDA Safe Internal Cooking Temp Chart',
    description: lang === 'es' ? 'Consulta las temperaturas internas mínimas oficiales del USDA (°F y °C) y tiempos de reposo para aves, res, cerdo, mariscos, huevos y cazuelas.' :
                 lang === 'pt' ? 'Confira as temperaturas internas mínimas oficiais do USDA (°F e °C) e tempos de descanso para aves, boi, porco, frutos do mar, ovos e assados.' :
                 lang === 'zh-cn' ? '查阅 USDA 官方最低安全中心温度（°F 与 °C）及静置时间，覆盖禽肉、牛羊猪肉、海鲜、蛋类与烘焙砂锅菜。' :
                 lang === 'ja' ? '鶏肉・牛肉・豚肉・魚介・卵・キャセロールのUSDA公式最低中心温度（°F・°C）と休ませ時間を一覧で確認できます。' :
                 'Check official USDA minimum internal temperatures (°F & °C) and required rest times for poultry, beef, pork, seafood, eggs, and casseroles.',
    cta: lang === 'es' ? 'Ver Temperaturas' : lang === 'pt' ? 'Ver Temperaturas' : lang === 'zh-cn' ? '查看安全温度' : lang === 'ja' ? '中心温度を確認' : 'Check Safe Temps'
  },
  leftover: {
    path: '/tools/leftover-shelf-life-calculator/',
    icon: '🗓️',
    badge: interactiveToolBadge,
    title: lang === 'es' ? 'Calculadora USDA de Vida Útil de Sobras y Refrigerador' :
           lang === 'pt' ? 'Calculadora USDA de Validade de Sobras na Geladeira' :
           lang === 'zh-cn' ? 'USDA 剩菜与冰箱保质期倒计时计算器' :
           lang === 'ja' ? 'USDA 残り物・冷蔵保存期限カウントダウン計算ツール' :
           'USDA Leftover & Fridge Shelf-Life Countdown Calculator',
    description: lang === 'es' ? 'Ingresa cuándo cocinaste o abriste un alimento para obtener su fecha límite exacta del USDA en refrigerador y congelador.' :
                 lang === 'pt' ? 'Informe quando cozinhou ou abriu um alimento para obter a data limite exata do USDA na geladeira e no congelador.' :
                 lang === 'zh-cn' ? '输入烹饪或开封日期，即时生成剩菜、乳制品、肉类与果蔬的 USDA 冰箱冷藏与冷冻安全食用截止日。' :
                 lang === 'ja' ? '調理日や開封日を入力するだけで、残り物・乳製品・肉・野菜のUSDA基準による冷蔵・冷凍の安全消費期限を算出します。' :
                 'Enter when you cooked or opened an item to get its exact USDA refrigerator and freezer eat-by date for leftovers, dairy, meat, and produce.',
    cta: lang === 'es' ? 'Calcular Caducidad' : lang === 'pt' ? 'Calcular Validade' : lang === 'zh-cn' ? '计算保质期' : lang === 'ja' ? '保存期限を確認' : 'Check Shelf Life'
  },
  ovenTemp: {
    path: '/tools/cookware-oven-temp-lookup/',
    icon: '♨️',
    badge: interactiveToolBadge,
    title: lang === 'es' ? 'Buscador de Temperatura Segura de Horno para Ollas y Moldes' :
           lang === 'pt' ? 'Consulta de Temperatura Segura no Forno para Panelas e Formas' :
           lang === 'zh-cn' ? '厨具与烤盘烤箱耐热上限查询器' :
           lang === 'ja' ? '調理器具・耐熱皿のオーブン耐熱温度検索ツール' :
           'Cookware & Bakeware Safe Oven Temp Lookup',
    description: lang === 'es' ? 'Comprueba los límites exactos de temperatura en horno y grill para Pyrex, vidrio, gres, hierro fundido, Le Creuset, silicona, papel horno y tapas.' :
                 lang === 'pt' ? 'Verifique os limites exatos de temperatura no forno e grill para Pyrex, vidro, cerâmica, ferro fundido, Le Creuset, silicone, papel manteiga e tampas.' :
                 lang === 'zh-cn' ? '速查 Pyrex 玻璃、陶瓷炻器、铸铁锅、Le Creuset、硅胶模具、烘焙纸及锅盖的烤箱与炙烤最高耐热温度。' :
                 lang === 'ja' ? 'Pyrex・ガラス・陶器・鋳鉄・ル・クルーゼ・シリコン・クッキングシート・蓋のオーブンおよびグリル耐熱上限を検索できます。' :
                 'Check exact max safe oven and broiler temperature limits for Pyrex, glass, stoneware, cast iron, Le Creuset, silicone, parchment, and lids.',
    cta: lang === 'es' ? 'Buscar Límite de Horno' : lang === 'pt' ? 'Consultar Limite no Forno' : lang === 'zh-cn' ? '查询耐热上限' : lang === 'ja' ? '耐熱上限を調べる' : 'Lookup Max Oven Temp'
  },
  airfryer: {
    path: '/tools/air-fryer-oven-converter/',
    icon: '🔥',
    badge: interactiveToolBadge,
    title: lang === 'es' ? 'Conversor de Freidora de Aire, Horno de Convección y Gas Mark' :
           lang === 'pt' ? 'Conversor de Air Fryer, Forno de Convecção e Gas Mark' :
           lang === 'zh-cn' ? '空气炸锅、对流烤箱与燃气档位换算器' :
           lang === 'ja' ? 'ノンフライヤー・コンベクション・ガスマーク変換ツール' :
           'Air Fryer, Convection Oven & Gas Mark Converter',
    description: lang === 'es' ? 'Convierte al instante cualquier receta de horno convencional a temperatura (°F/°C) y tiempo reducido para freidora de aire sin quemar la comida.' :
                 lang === 'pt' ? 'Converta na hora qualquer receita de forno convencional para temperatura (°F/°C) e tempo reduzido na air fryer evitando queimar os alimentos.' :
                 lang === 'zh-cn' ? '将传统烤箱食谱一键换算为空气炸锅安全温度（°F/°C）与缩短后的烹饪时长，避免焦糊与过热。' :
                 lang === 'ja' ? '通常のオーブンレシピをノンフライヤー用の安全な温度（°F/°C）と短縮時間に瞬時に変換し、焦げ付きを防ぎます。' :
                 'Convert any conventional oven recipe into safe air fryer temperature (°F/°C) and reduced cook time instantly to prevent burning.',
    cta: lang === 'es' ? 'Convertir Temperatura' : lang === 'pt' ? 'Converter Temperatura' : lang === 'zh-cn' ? '换算炸锅温时' : lang === 'ja' ? '温度・時間を変換' : 'Convert Oven to Air Fryer'
  },
  oil: {
    path: '/tools/culinary-oil-smoke-point-simulator/',
    icon: '🫒',
    badge: interactiveToolBadge,
    title: lang === 'es' ? 'Simulador de Punto de Humo de Aceites' :
           lang === 'pt' ? 'Simulador de Ponto de Fumaça de Óleos' :
           lang === 'zh-cn' ? '食用油烟点安全模拟器' :
           lang === 'ja' ? '調理油の発煙点シミュレーター' :
           'Culinary Oil Smoke Point Simulator',
    description: lang === 'es' ? 'Compara los puntos de humo y la estabilidad térmica de aceites, mantequilla y ghee para evitar humo tóxico e incendios por grasa.' :
                 lang === 'pt' ? 'Compare os pontos de fumaça e a estabilidade térmica de óleos, manteiga e ghee para evitar fumaça tóxica e superaquecimento.' :
                 lang === 'zh-cn' ? '对比各类食用油、黄油与酥油的烟点及高温氧化稳定性，避免油烟有害物质与厨房起火隐患。' :
                 lang === 'ja' ? '調理油・バター・ギーの発煙点と熱安定性を比較し、有害な煙や過熱トラブルを防ぎます。' :
                 'Compare cooking oil, butter, and ghee smoke points and thermal oxidation thresholds to prevent toxic fumes and grease flare-ups.',
    cta: lang === 'es' ? 'Comparar Aceites' : lang === 'pt' ? 'Comparar Óleos' : lang === 'zh-cn' ? '模拟油温烟点' : lang === 'ja' ? '発煙点を確認' : 'Check Oil Smoke Points'
  },
  symbol: {
    path: '/tools/kitchen-symbol-decoder/',
    icon: '🔍',
    badge: interactiveToolBadge,
    title: lang === 'es' ? 'Decodificador de Símbolos de Cocina' :
           lang === 'pt' ? 'Decodificador de Símbolos de Cozinha' :
           lang === 'zh-cn' ? '厨具底部安全标志识别器' :
           lang === 'ja' ? 'キッチン用品マーク解読ツール' :
           'Kitchen Bottom Symbol Decoder',
    description: lang === 'es' ? '¿No estás seguro de los íconos en la base de tu recipiente? Identifica al instante los símbolos de lavavajillas, microondas y plásticos.' :
                 lang === 'pt' ? 'Não tem certeza sobre os ícones no fundo do recipiente? Identifique na hora símbolos de lava-louças, micro-ondas e plásticos.' :
                 lang === 'zh-cn' ? '不确定容器底部的符号含义？即时识别洗碗机、微波炉、耐热与塑料回收标志。' :
                 lang === 'ja' ? '容器の底にあるマークの意味がわからない時は、食洗機・電子レンジ・耐熱マークを瞬時に判定できます。' :
                 'Unsure about the icons stamped on the bottom of your container or cookware? Decode dishwasher, microwave, oven, and plastic resin symbols instantly.',
    cta: lang === 'es' ? 'Abrir Decodificador' : lang === 'pt' ? 'Abrir Decodificador' : lang === 'zh-cn' ? '打开标志识别器' : lang === 'ja' ? 'マークを調べる' : 'Decode Bottom Symbols'
  }
};

const recommendedTool = toolCatalog[recommendedToolKey];
const recommendedToolUrl = translatePath(recommendedTool.path);
const methodologyUrl = getDirectoryUrl('methodology', lang);
const savedSheetUrl = getDirectoryUrl('saved', lang);

// Shareable 4:5 PNG Safety Card localized labels & tips
const safeTipsList: string[] = Array.isArray(data.tips) ? data.tips.filter(Boolean) : [];
const safeWarningsList: string[] = Array.isArray(data.warnings) ? data.warnings.filter(Boolean) : [];
const cardTip1 = safeTipsList[0] || data.tip || safeWarningsList[0] || '';
const cardTip2 = safeTipsList[1] || (safeWarningsList[0] && safeWarningsList[0] !== cardTip1 ? safeWarningsList[0] : (data.specific_warning || ''));

const cardVerdictLabel = data.safe === 'yes'
  ? (lang === 'es' ? 'SÍ — SEGURO' : lang === 'pt' ? 'SIM — SEGURO' : lang === 'zh-cn' ? '安全 — 可以使用' : lang === 'ja' ? '安全 — 使用OK' : 'YES — SAFE')
  : data.safe === 'no'
  ? (lang === 'es' ? 'NO — NO SEGURO' : lang === 'pt' ? 'NÃO — INSEGURO' : lang === 'zh-cn' ? '危险 — 切勿使用' : lang === 'ja' ? '危険 — 使用NG' : 'NO — UNSAFE')
  : (lang === 'es' ? 'DEPENDE — CON PRECAUCIÓN' : lang === 'pt' ? 'DEPENDE — COM CAUTELA' : lang === 'zh-cn' ? '视情况 — 需谨慎' : lang === 'ja' ? '条件付き — 注意' : 'DEPENDS — WITH CAUTION');

const cardCopy = {
  buttonLabel: lang === 'es' ? 'Descargar Tarjeta' :
               lang === 'pt' ? 'Baixar Cartão' :
               lang === 'zh-cn' ? '保存安全卡片' :
               lang === 'ja' ? '画像カードを保存' :
               'Save Image Card',
  downloadedLabel: lang === 'es' ? 'Descargada ✓' :
                   lang === 'pt' ? 'Baixado ✓' :
                   lang === 'zh-cn' ? '已下载 ✓' :
                   lang === 'ja' ? '保存しました ✓' :
                   'Downloaded ✓',
  quickAnswerLabel: lang === 'es' ? 'VEREDICTO RÁPIDO' :
                    lang === 'pt' ? 'VEREDITO RÁPIDO' :
                    lang === 'zh-cn' ? '快速安全结论' :
                    lang === 'ja' ? 'クイック結論' :
                    'QUICK ANSWER',
  tipsHeading: lang === 'es' ? 'CONSEJOS CLAVE DE SEGURIDAD' :
               lang === 'pt' ? 'PRINCIPAIS DICAS DE SEGURANÇA' :
               lang === 'zh-cn' ? '核心实用安全建议' :
               lang === 'ja' ? '実用的な安全ポイント' :
               'TOP PRACTICAL SAFETY TIPS',
  footerVerified: lang === 'es' ? 'Verificado según USDA/FDA y manuales OEM' :
                  lang === 'pt' ? 'Verificado conforme USDA/FDA e manuais OEM' :
                  lang === 'zh-cn' ? '依据 USDA/FDA 规范与原厂手册核验' :
                  lang === 'ja' ? 'USDA/FDA基準・メーカー仕様に基づき検証済み' :
                  'Verified against USDA/FDA & OEM Appliance Specs',
  verifiedBadge: lang === 'es' ? 'VERIFICADO' :
                 lang === 'pt' ? 'VERIFICADO' :
                 lang === 'zh-cn' ? '已核验' :
                 lang === 'ja' ? '検証済み' :
                 'VERIFIED',
  howToShareLabel: lang === 'es' ? 'Cómo Compartir / Guardar en Pinterest' :
                   lang === 'pt' ? 'Como Compartilhar / Salvar no Pinterest' :
                   lang === 'zh-cn' ? '如何分享 / 保存卡片' :
                   lang === 'ja' ? '共有・ピン保存の方法' :
                   'How to Share / Pin',
  howToShareDesc: lang === 'es' ? 'Haz clic en "Descargar Tarjeta" para guardar un PNG 4:5 listo para Pinterest, Instagram Stories, WhatsApp o imprimir en el refrigerador.' :
                  lang === 'pt' ? 'Clique em "Baixar Cartão" para salvar um PNG 4:5 pronto para Pinterest, Instagram Stories, WhatsApp ou imprimir na geladeira.' :
                  lang === 'zh-cn' ? '点击“保存安全卡片”即可下载 4:5 高清 PNG 图片，适合分享至微信、小红书、Pinterest 或打印贴在冰箱上。' :
                  lang === 'ja' ? '「画像カードを保存」をクリックすると、Pinterest・Instagramストーリーズ・LINE共有や冷蔵庫への印刷に最適な4:5 PNG画像を保存できます。' :
                  'Click "Save Image Card" to download a crisp 4:5 PNG ready for Pinterest, Instagram Stories, WhatsApp, or fridge printing.',
  fridgeSheetLink: lang === 'es' ? 'Abrir Hoja para el Refrigerador →' :
                   lang === 'pt' ? 'Abrir Folha para a Geladeira →' :
                   lang === 'zh-cn' ? '打开冰箱速查表 →' :
                   lang === 'ja' ? '冷蔵庫用早見表を開く →' :
                   'Open Fridge Cheat Sheet →'
};

---

<Layout title={pageTitle} description={pageDescription} faqs={data.faqs} lang={lang} availableLocales={availableLocales}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(speakableSchema)} />
    {howToSchema && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
    )}
  </Fragment>
  <article class="max-w-[800px] mx-auto px-6 py-[48px] md:py-[64px]">
    <!-- Breadcrumbs -->
    <Breadcrumbs 
      items={[
        { label: t('nav.home'), href: translatePath('/') },
        { label: formattedAppliance, href: getApplianceUrl(data.appliance, lang) },
        { label: data.item }
      ]}
    />

    <!-- Header Section -->
    <header class="mb-10 text-center md:text-left">
      <span class="text-caption text-muted uppercase tracking-wider text-xs block mb-2">{formattedAppliance} {t('page.guideSuffix')}</span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-6 leading-tight">
        {questionHeading}
      </h1>

      <!-- Trust Signal Badge (Above the fold) -->
      <div class="inline-flex items-center gap-3">
        {data.safe === 'yes' && (
          <div class="badge-yes quick-answer px-6 py-2 text-sm">
            <span class="mr-1.5">✓</span> {t('verdict.yes')}
          </div>
        )}
        {data.safe === 'no' && (
          <div class="badge-no quick-answer px-6 py-2 text-sm">
            <span class="mr-1.5">✗</span> {t('verdict.no')}
          </div>
        )}
        {data.safe === 'depends' && (
          <div class="badge-depends quick-answer px-6 py-2 text-sm">
            <span class="mr-1.5">⚠</span> {t('verdict.depends')}
          </div>
        )}
      </div>

      <!-- E-E-A-T Editorial Review & Safety Standard Attribution -->
      <div class="mt-4 flex flex-wrap items-center justify-center md:justify-start gap-x-3 gap-y-1.5 text-[12px] text-muted">
        <span class="inline-flex items-center gap-1.5 font-medium text-ink">
          <svg class="w-3.5 h-3.5 text-success shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
          </svg>
          <a href={getDirectoryUrl('about', lang)} class="hover:text-link transition-colors">
            {lang === 'es' ? 'Revisado por el Comité Editorial' :
             lang === 'pt' ? 'Revisado pelo Comitê Editorial' :
             lang === 'zh-cn' ? '已由厨房安全编辑委员会审核' :
             lang === 'ja' ? '編集委員会による検証済み' :
             'Reviewed by Editorial Board'}
          </a>
        </span>
        <span class="text-hairline hidden sm:inline">•</span>
        <span>
          {lang === 'es' ? 'Normas USDA/FDA y Manuales OEM' :
           lang === 'pt' ? 'Normas USDA/FDA e Manuais OEM' :
           lang === 'zh-cn' ? '参考 USDA/FDA 规范与 OEM 手册' :
           lang === 'ja' ? 'USDA/FDA基準および各社仕様準拠' :
           'USDA/FDA & OEM Specs'}
        </span>
        <span class="text-hairline hidden sm:inline">•</span>
        <a href={getDirectoryUrl('disclaimer', lang)} class="text-link hover:underline">
          {lang === 'es' ? 'Aviso de Seguridad' :
           lang === 'pt' ? 'Aviso de Segurança' :
           lang === 'zh-cn' ? '安全免责声明' :
           lang === 'ja' ? '安全免責事項' :
           'Safety Disclaimer'}
        </a>
      </div>

      <!-- Interactive Quick Action Buttons Bar -->
      <div class="mt-6 flex flex-wrap items-center justify-center md:justify-start gap-2.5 no-print">
        <!-- Share / Copy Verdict Button -->
        <button
          id="share-verdict-btn"
          type="button"
          class="min-h-[40px] px-4 py-2 bg-canvas hover:bg-surface-soft active:scale-[0.98] text-ink border border-hairline rounded-md text-xs font-medium inline-flex items-center gap-2 shadow-xs transition-all cursor-pointer"
          data-share-title={pageTitle}
          data-share-text={`${data.item} in ${formattedAppliance}: ${formattedAnswer} - ${data.shortAnswer}`}
          data-copied-text={t('page.copied')}
        >
          <svg class="w-4 h-4 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
          </svg>
          <span id="share-btn-text">{t('action.shareVerdict')}</span>
        </button>

        <!-- Save to Kitchen / Bookmark Button -->
        <button
          id="bookmark-item-btn"
          type="button"
          class="min-h-[40px] px-4 py-2 bg-canvas hover:bg-surface-soft active:scale-[0.98] text-ink border border-hairline rounded-md text-xs font-medium inline-flex items-center gap-2 shadow-xs transition-all cursor-pointer"
          data-item-slug={data.slug}
          data-item-name={data.item}
          data-item-appliance={data.appliance}
          data-item-safe={data.safe}
          data-save-text={t('action.saveGuide')}
          data-saved-text={t('action.saved')}
        >
          <svg id="bookmark-icon" class="w-4 h-4 text-muted transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
          </svg>
          <span id="bookmark-btn-text">{t('action.saveGuide')}</span>
        </button>

        <!-- Download Shareable PNG Safety Card Button -->
        <button
          id="download-card-btn"
          type="button"
          class="min-h-[40px] px-4 py-2 bg-canvas hover:bg-surface-soft active:scale-[0.98] text-ink border border-hairline rounded-md text-xs font-medium inline-flex items-center gap-2 shadow-xs transition-all cursor-pointer no-print"
          data-card-title={questionHeading}
          data-card-verdict={data.safe}
          data-card-appliance={formattedAppliance}
          data-card-appliance-slug={data.appliance}
          data-card-short={data.shortAnswer}
          data-card-tip1={cardTip1}
          data-card-tip2={cardTip2}
          data-card-slug={data.slug}
          data-card-lang={lang}
          data-card-verdict-label={cardVerdictLabel}
          data-card-quick-label={cardCopy.quickAnswerLabel}
          data-card-tips-label={cardCopy.tipsHeading}
          data-card-footer-tagline={cardCopy.footerVerified}
          data-card-verified-badge={cardCopy.verifiedBadge}
          data-default-text={cardCopy.buttonLabel}
          data-downloaded-text={cardCopy.downloadedLabel}
        >
          <svg class="w-4 h-4 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          <span id="download-card-btn-text">{cardCopy.buttonLabel}</span>
        </button>

        <!-- Print Kitchen Safety Card Button -->
        <button
          id="print-card-btn"
          type="button"
          class="min-h-[40px] px-4 py-2 bg-canvas hover:bg-surface-soft active:scale-[0.98] text-ink border border-hairline rounded-md text-xs font-medium inline-flex items-center gap-2 shadow-xs transition-all cursor-pointer"
        >
          <svg class="w-4 h-4 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4H7v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
          </svg>
          <span>{t('action.printCard')}</span>
        </button>
      </div>

      <!-- Compact How to Share / Pin Hint -->
      <details class="mt-2.5 inline-block text-left no-print">
        <summary class="text-[11px] text-muted hover:text-link cursor-pointer list-none [&::-webkit-details-marker]:hidden inline-flex items-center gap-1 select-none transition-colors">
          <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>{cardCopy.howToShareLabel}</span>
        </summary>
        <p class="mt-1.5 text-[11px] text-muted bg-surface-soft border border-hairline rounded-md px-3 py-2 max-w-[560px] leading-relaxed">
          {cardCopy.howToShareDesc}{' '}
          <a href={savedSheetUrl} class="text-link hover:underline font-medium">{cardCopy.fridgeSheetLink}</a>
        </p>
      </details>
    </header>

    <!-- Quick Answer & Explanation Card -->
    <section class="mb-12">
      <div class={`p-8 rounded-lg ${
        data.safe === 'yes' ? 'bg-success-bg border border-success-border/20' : 
        data.safe === 'no' ? 'bg-error-bg border border-error-border/20' : 
        'bg-warning-bg border border-warning-border/20'
      }`}>
        <h2 class="text-title-sm text-ink font-medium mb-3">{t('page.quickVerdict')}: {questionHeading}</h2>
        <p class="short-answer text-title-md font-bold leading-relaxed text-ink mb-5">
          {data.shortAnswer}
        </p>

        <!-- AI-Ready Quick-Reference Summary Table -->
        <div class="overflow-x-auto bg-canvas border border-hairline rounded-md shadow-2xs my-5" id="quick-reference-summary">
          <table class="w-full text-left border-collapse text-[13px]">
            <caption class="sr-only">{summaryLabels.heading}: {data.item} ({formattedAppliance})</caption>
            <tbody class="divide-y divide-hairline">
              <tr>
                <th scope="row" class="py-2.5 px-3.5 bg-surface-soft text-muted font-semibold w-[36%] sm:w-[30%] align-top">{summaryLabels.item}</th>
                <td class="py-2.5 px-3.5 text-ink font-medium align-top">{data.item}</td>
              </tr>
              <tr>
                <th scope="row" class="py-2.5 px-3.5 bg-surface-soft text-muted font-semibold align-top">{summaryLabels.appliance}</th>
                <td class="py-2.5 px-3.5 text-ink align-top">{formattedAppliance}</td>
              </tr>
              <tr>
                <th scope="row" class="py-2.5 px-3.5 bg-surface-soft text-muted font-semibold align-top">{summaryLabels.verdict}</th>
                <td class="py-2.5 px-3.5 align-top">
                  {data.safe === 'yes' && <span class="badge-yes px-2.5 py-0.5 text-[11px]">✓ {t('verdict.yes')}</span>}
                  {data.safe === 'no' && <span class="badge-no px-2.5 py-0.5 text-[11px]">✗ {t('verdict.no')}</span>}
                  {data.safe === 'depends' && <span class="badge-depends px-2.5 py-0.5 text-[11px]">⚠ {t('verdict.depends')}</span>}
                </td>
              </tr>
              <tr>
                <th scope="row" class="py-2.5 px-3.5 bg-surface-soft text-muted font-semibold align-top">{summaryLabels.materialRisk}</th>
                <td class="py-2.5 px-3.5 text-body align-top">{primaryMaterialRiskDisplay}</td>
              </tr>
              <tr>
                <th scope="row" class="py-2.5 px-3.5 bg-surface-soft text-muted font-semibold align-top">{summaryLabels.quickAction}</th>
                <td class="py-2.5 px-3.5 text-ink font-medium align-top">{quickActionText}</td>
              </tr>
            </tbody>
          </table>
        </div>
        
        {data.material ? (
          <div>
            <div class="border-t border-hairline my-4 opacity-50"></div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 my-6">
              <div class="bg-canvas/60 border border-hairline rounded-md p-4 shadow-xs">
                <span class="text-caption text-muted uppercase tracking-wider text-[11px] block mb-1">{t('page.materialComposition')}</span>
                {(() => {
                  const catSlug = getCategoryForMaterial(data.material);
                  return catSlug ? (
