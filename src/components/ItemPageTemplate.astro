          >
            <span>{recommendedTool.cta}</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Editorial Verification & Primary Sources Trust Bar + Saved Cheat Sheet Link -->
    <section id="editorial-trust-bar" class="bg-surface-soft border border-hairline rounded-lg p-5 mb-12 text-xs text-muted leading-relaxed">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-3.5 border-b border-hairline">
        <div class="flex items-start gap-2.5 min-w-0 flex-1">
          <svg class="w-4 h-4 text-success shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
          </svg>
          <div>
            <p class="text-ink font-medium text-[13px] leading-snug">
              {lang === 'es' ? 'Verificado según USDA FSIS, FDA 21 CFR y manuales de electrodomésticos del fabricante' :
               lang === 'pt' ? 'Verificado conforme USDA FSIS, FDA 21 CFR e manuais de eletrodomésticos do fabricante' :
               lang === 'zh-cn' ? '依据 USDA FSIS、FDA 21 CFR 规范及家电原厂使用手册交叉核验' :
               lang === 'ja' ? 'USDA FSIS・FDA 21 CFR基準および各家電メーカー取扱説明書に基づき検証済み' :
