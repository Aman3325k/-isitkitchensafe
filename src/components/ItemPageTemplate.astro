  : data.safe === 'no'
  ? (lang === 'es' ? 'NO — NO SEGURO' : lang === 'pt' ? 'NÃO — INSEGURO' : lang === 'zh-cn' ? '危险 — 切勿使用' : lang === 'ja' ? '危険 — 使用NG' : 'NO — UNSAFE')
  : (lang === 'es' ? 'DEPENDE — CON PRECAUCIÓN' : lang === 'pt' ? 'DEPENDE — COM CAUTELA' : lang === 'zh-cn' ? '视情况 — 需谨慎' : lang === 'ja' ? '条件付き — 注意' : 'DEPENDS — WITH CAUTION');

const cardCopy = {
  buttonLabel: lang === 'es' ? 'Descargar Tarjeta' :
               lang === 'pt' ? 'Baixar Cartão' :
               lang === 'zh-cn' ? '保存安全卡片' :
               lang === 'ja' ? '画像カードを保存' :
               'Save Image Card',
  downloadedLabel: lang === 'es' ? 'Descargada ✓' :
                   lang === 'pt' ? 'Baixado ✓' :
                   lang === 'zh-cn' ? '已下载 ✓' :
                   lang === 'ja' ? '保存しました ✓' :
                   'Downloaded ✓',
  quickAnswerLabel: lang === 'es' ? 'VEREDICTO RÁPIDO' :
                    lang === 'pt' ? 'VEREDITO RÁPIDO' :
                    lang === 'zh-cn' ? '快速安全结论' :
                    lang === 'ja' ? 'クイック結論' :
                    'QUICK ANSWER',
  tipsHeading: lang === 'es' ? 'CONSEJOS CLAVE DE SEGURIDAD' :
               lang === 'pt' ? 'PRINCIPAIS DICAS DE SEGURANÇA' :
               lang === 'zh-cn' ? '核心实用安全建议' :
               lang === 'ja' ? '実用的な安全ポイント' :
               'TOP PRACTICAL SAFETY TIPS',
  footerVerified: lang === 'es' ? 'Verificado según USDA/FDA y manuales OEM' :
                  lang === 'pt' ? 'Verificado conforme USDA/FDA e manuais OEM' :
                  lang === 'zh-cn' ? '依据 USDA/FDA 规范与原厂手册核验' :
                  lang === 'ja' ? 'USDA/FDA基準・メーカー仕様に基づき検証済み' :
                  'Verified against USDA/FDA & OEM Appliance Specs',
  verifiedBadge: lang === 'es' ? 'VERIFICADO' :
                 lang === 'pt' ? 'VERIFICADO' :
                 lang === 'zh-cn' ? '已核验' :
                 lang === 'ja' ? '検証済み' :
                 'VERIFIED',
  howToShareLabel: lang === 'es' ? 'Cómo Compartir / Guardar en Pinterest' :
                   lang === 'pt' ? 'Como Compartilhar / Salvar no Pinterest' :
                   lang === 'zh-cn' ? '如何分享 / 保存卡片' :
                   lang === 'ja' ? '共有・ピン保存の方法' :
                   'How to Share / Pin',
  howToShareDesc: lang === 'es' ? 'Haz clic en "Descargar Tarjeta" para guardar un PNG 4:5 listo para Pinterest, Instagram Stories, WhatsApp o imprimir en el refrigerador.' :
                  lang === 'pt' ? 'Clique em "Baixar Cartão" para salvar um PNG 4:5 pronto para Pinterest, Instagram Stories, WhatsApp ou imprimir na geladeira.' :
                  lang === 'zh-cn' ? '点击“保存安全卡片”即可下载 4:5 高清 PNG 图片，适合分享至微信、小红书、Pinterest 或打印贴在冰箱上。' :
                  lang === 'ja' ? '「画像カードを保存」をクリックすると、Pinterest・Instagramストーリーズ・LINE共有や冷蔵庫への印刷に最適な4:5 PNG画像を保存できます。' :
                  'Click "Save Image Card" to download a crisp 4:5 PNG ready for Pinterest, Instagram Stories, WhatsApp, or fridge printing.',
  fridgeSheetLink: lang === 'es' ? 'Abrir Hoja para el Refrigerador →' :
                   lang === 'pt' ? 'Abrir Folha para a Geladeira →' :
                   lang === 'zh-cn' ? '打开冰箱速查表 →' :
                   lang === 'ja' ? '冷蔵庫用早見表を開く →' :
                   'Open Fridge Cheat Sheet →'
};

// Dynamic per-page OG social preview card (/api/og.svg)
function truncateOgText(text: string, maxLen: number): string {
  const clean = String(text || '').replace(/\s+/g, ' ').trim();
  if (clean.length <= maxLen) return clean;
  const sliced = clean.slice(0, maxLen - 1);
  const lastSpace = sliced.lastIndexOf(' ');
  const cut = lastSpace > Math.floor(maxLen * 0.6) ? sliced.slice(0, lastSpace) : sliced;
  return `${cut.replace(/[\s,;:\-—–/]+$/, '')}…`;
}

const isCjkLocale = lang === 'zh-cn' || lang === 'ja';
const ogTitle = truncateOgText(questionHeading, isCjkLocale ? 44 : 70);
const ogVerdict = data.safe === 'yes' ? 'YES' : data.safe === 'no' ? 'NO' : 'DEPENDS';
const ogAppliance = truncateOgText(formattedAppliance, isCjkLocale ? 18 : 32);
const ogSummary = truncateOgText(data.shortAnswer || '', isCjkLocale ? 64 : 115);
const ogParams = new URLSearchParams({
  title: ogTitle,
  verdict: ogVerdict,
  appliance: ogAppliance,
  summary: ogSummary,
});
const ogImage = `/api/og.svg?${ogParams.toString()}`;

---

<Layout title={pageTitle} description={pageDescription} faqs={data.faqs} lang={lang} availableLocales={availableLocales} ogImage={ogImage}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(speakableSchema)} />
    {howToSchema && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
    )}
  </Fragment>
  <article class="max-w-[800px] mx-auto px-6 py-[48px] md:py-[64px]">
    <!-- Breadcrumbs -->
    <Breadcrumbs 
      items={[
        { label: t('nav.home'), href: translatePath('/') },
        { label: formattedAppliance, href: getApplianceUrl(data.appliance, lang) },
        { label: data.item }
      ]}
    />

    <!-- Header Section -->
    <header class="mb-10 text-center md:text-left">
      <span class="text-caption text-muted uppercase tracking-wider text-xs block mb-2">{formattedAppliance} {t('page.guideSuffix')}</span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-6 leading-tight">
        {questionHeading}
      </h1>

      <!-- Trust Signal Badge (Above the fold) -->
      <div class="inline-flex items-center gap-3">
        {data.safe === 'yes' && (
          <div class="badge-yes quick-answer px-6 py-2 text-sm">
            <span class="mr-1.5">✓</span> {t('verdict.yes')}
          </div>
        )}
        {data.safe === 'no' && (
          <div class="badge-no quick-answer px-6 py-2 text-sm">
            <span class="mr-1.5">✗</span> {t('verdict.no')}
          </div>
        )}
        {data.safe === 'depends' && (
          <div class="badge-depends quick-answer px-6 py-2 text-sm">
            <span class="mr-1.5">⚠</span> {t('verdict.depends')}
          </div>
        )}
      </div>

      <!-- E-E-A-T Editorial Review & Safety Standard Attribution -->
      <div class="mt-4 flex flex-wrap items-center justify-center md:justify-start gap-x-3 gap-y-1.5 text-[12px] text-muted">
        <span class="inline-flex items-center gap-1.5 font-medium text-ink">
          <svg class="w-3.5 h-3.5 text-success shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
          </svg>
          <a href={getDirectoryUrl('about', lang)} class="hover:text-link transition-colors">
            {lang === 'es' ? 'Revisado por el Comité Editorial' :
             lang === 'pt' ? 'Revisado pelo Comitê Editorial' :
             lang === 'zh-cn' ? '已由厨房安全编辑委员会审核' :
             lang === 'ja' ? '編集委員会による検証済み' :
             'Reviewed by Editorial Board'}
          </a>
        </span>
        <span class="text-hairline hidden sm:inline">•</span>
        <span>
          {lang === 'es' ? 'Normas USDA/FDA y Manuales OEM' :
           lang === 'pt' ? 'Normas USDA/FDA e Manuais OEM' :
           lang === 'zh-cn' ? '参考 USDA/FDA 规范与 OEM 手册' :
           lang === 'ja' ? 'USDA/FDA基準および各社仕様準拠' :
           'USDA/FDA & OEM Specs'}
        </span>
        <span class="text-hairline hidden sm:inline">•</span>
        <a href={getDirectoryUrl('disclaimer', lang)} class="text-link hover:underline">
          {lang === 'es' ? 'Aviso de Seguridad' :
           lang === 'pt' ? 'Aviso de Segurança' :
           lang === 'zh-cn' ? '安全免责声明' :
           lang === 'ja' ? '安全免責事項' :
           'Safety Disclaimer'}
        </a>
      </div>

      <!-- Interactive Quick Action Buttons Bar -->
      <div class="mt-6 flex flex-wrap items-center justify-center md:justify-start gap-2.5 no-print">
        <!-- Share / Copy Verdict Button -->
        <button
          id="share-verdict-btn"
          type="button"
          class="min-h-[40px] px-4 py-2 bg-canvas hover:bg-surface-soft active:scale-[0.98] text-ink border border-hairline rounded-md text-xs font-medium inline-flex items-center gap-2 shadow-xs transition-all cursor-pointer"
          data-share-title={pageTitle}
          data-share-text={`${data.item} in ${formattedAppliance}: ${formattedAnswer} - ${data.shortAnswer}`}
          data-copied-text={t('page.copied')}
        >
          <svg class="w-4 h-4 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
          </svg>
          <span id="share-btn-text">{t('action.shareVerdict')}</span>
        </button>

        <!-- Save to Kitchen / Bookmark Button -->
        <button
          id="bookmark-item-btn"
          type="button"
          class="min-h-[40px] px-4 py-2 bg-canvas hover:bg-surface-soft active:scale-[0.98] text-ink border border-hairline rounded-md text-xs font-medium inline-flex items-center gap-2 shadow-xs transition-all cursor-pointer"
          data-item-slug={data.slug}
          data-item-name={data.item}
          data-item-appliance={data.appliance}
          data-item-safe={data.safe}
          data-save-text={t('action.saveGuide')}
          data-saved-text={t('action.saved')}
        >
          <svg id="bookmark-icon" class="w-4 h-4 text-muted transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
          </svg>
          <span id="bookmark-btn-text">{t('action.saveGuide')}</span>
        </button>

        <!-- Download Shareable PNG Safety Card Button -->
        <button
          id="download-card-btn"
          type="button"
          class="min-h-[40px] px-4 py-2 bg-canvas hover:bg-surface-soft active:scale-[0.98] text-ink border border-hairline rounded-md text-xs font-medium inline-flex items-center gap-2 shadow-xs transition-all cursor-pointer no-print"
          data-card-title={questionHeading}
          data-card-verdict={data.safe}
          data-card-appliance={formattedAppliance}
          data-card-appliance-slug={data.appliance}
          data-card-short={data.shortAnswer}
          data-card-tip1={cardTip1}
          data-card-tip2={cardTip2}
          data-card-slug={data.slug}
          data-card-lang={lang}
          data-card-verdict-label={cardVerdictLabel}
          data-card-quick-label={cardCopy.quickAnswerLabel}
          data-card-tips-label={cardCopy.tipsHeading}
          data-card-footer-tagline={cardCopy.footerVerified}
          data-card-verified-badge={cardCopy.verifiedBadge}
          data-default-text={cardCopy.buttonLabel}
          data-downloaded-text={cardCopy.downloadedLabel}
        >
          <svg class="w-4 h-4 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          <span id="download-card-btn-text">{cardCopy.buttonLabel}</span>
        </button>

        <!-- Print Kitchen Safety Card Button -->
        <button
          id="print-card-btn"
          type="button"
          class="min-h-[40px] px-4 py-2 bg-canvas hover:bg-surface-soft active:scale-[0.98] text-ink border border-hairline rounded-md text-xs font-medium inline-flex items-center gap-2 shadow-xs transition-all cursor-pointer"
        >
          <svg class="w-4 h-4 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4H7v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
          </svg>
          <span>{t('action.printCard')}</span>
        </button>
      </div>

      <!-- Compact How to Share / Pin Hint -->
      <details class="mt-2.5 inline-block text-left no-print">
        <summary class="text-[11px] text-muted hover:text-link cursor-pointer list-none [&::-webkit-details-marker]:hidden inline-flex items-center gap-1 select-none transition-colors">
          <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>{cardCopy.howToShareLabel}</span>
        </summary>
        <p class="mt-1.5 text-[11px] text-muted bg-surface-soft border border-hairline rounded-md px-3 py-2 max-w-[560px] leading-relaxed">
          {cardCopy.howToShareDesc}{' '}
          <a href={savedSheetUrl} class="text-link hover:underline font-medium">{cardCopy.fridgeSheetLink}</a>
        </p>
      </details>
    </header>

    <!-- Quick Answer & Explanation Card -->
    <section class="mb-12">
      <div class={`p-8 rounded-lg ${
        data.safe === 'yes' ? 'bg-success-bg border border-success-border/20' : 
        data.safe === 'no' ? 'bg-error-bg border border-error-border/20' : 
        'bg-warning-bg border border-warning-border/20'
      }`}>
        <h2 class="text-title-sm text-ink font-medium mb-3">{t('page.quickVerdict')}: {questionHeading}</h2>
        <p class="short-answer text-title-md font-bold leading-relaxed text-ink mb-5">
          {data.shortAnswer}
        </p>

        <!-- AI-Ready Quick-Reference Summary Table -->
        <div class="overflow-x-auto bg-canvas border border-hairline rounded-md shadow-2xs my-5" id="quick-reference-summary">
          <table class="w-full text-left border-collapse text-[13px]">
            <caption class="sr-only">{summaryLabels.heading}: {data.item} ({formattedAppliance})</caption>
            <tbody class="divide-y divide-hairline">
              <tr>
                <th scope="row" class="py-2.5 px-3.5 bg-surface-soft text-muted font-semibold w-[36%] sm:w-[30%] align-top">{summaryLabels.item}</th>
                <td class="py-2.5 px-3.5 text-ink font-medium align-top">{data.item}</td>
              </tr>
              <tr>
                <th scope="row" class="py-2.5 px-3.5 bg-surface-soft text-muted font-semibold align-top">{summaryLabels.appliance}</th>
                <td class="py-2.5 px-3.5 text-ink align-top">{formattedAppliance}</td>
              </tr>
              <tr>
                <th scope="row" class="py-2.5 px-3.5 bg-surface-soft text-muted font-semibold align-top">{summaryLabels.verdict}</th>
                <td class="py-2.5 px-3.5 align-top">
                  {data.safe === 'yes' && <span class="badge-yes px-2.5 py-0.5 text-[11px]">✓ {t('verdict.yes')}</span>}
                  {data.safe === 'no' && <span class="badge-no px-2.5 py-0.5 text-[11px]">✗ {t('verdict.no')}</span>}
                  {data.safe === 'depends' && <span class="badge-depends px-2.5 py-0.5 text-[11px]">⚠ {t('verdict.depends')}</span>}
                </td>
              </tr>
              <tr>
                <th scope="row" class="py-2.5 px-3.5 bg-surface-soft text-muted font-semibold align-top">{summaryLabels.materialRisk}</th>
                <td class="py-2.5 px-3.5 text-body align-top">{primaryMaterialRiskDisplay}</td>
              </tr>
              <tr>
                <th scope="row" class="py-2.5 px-3.5 bg-surface-soft text-muted font-semibold align-top">{summaryLabels.quickAction}</th>
                <td class="py-2.5 px-3.5 text-ink font-medium align-top">{quickActionText}</td>
              </tr>
            </tbody>
          </table>
        </div>
        
        {data.material ? (
          <div>
            <div class="border-t border-hairline my-4 opacity-50"></div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 my-6">
              <div class="bg-canvas/60 border border-hairline rounded-md p-4 shadow-xs">
                <span class="text-caption text-muted uppercase tracking-wider text-[11px] block mb-1">{t('page.materialComposition')}</span>
                {(() => {
                  const catSlug = getCategoryForMaterial(data.material);
                  return catSlug ? (
                    <a href={getDirectoryUrl(`material/${catSlug}`, lang)} class="text-link hover:underline font-semibold text-[15px] inline-flex items-center gap-1.5">
                      <span>{data.material}</span>
                      {lang !== 'en' && !isDirectoryTranslatedInLocale(`material/${catSlug}`, lang) && (
                        <span class="text-[9px] font-semibold text-muted bg-surface-soft border border-hairline px-1 py-0.5 rounded tracking-wider uppercase" title="Available in English only">EN</span>
                      )}
                    </a>
                  ) : (
                    <strong class="text-ink text-[15px] font-semibold">{data.material}</strong>
                  );
                })()}
              </div>
              <div class="bg-canvas/60 border border-hairline rounded-md p-4 shadow-xs">
                <span class="text-caption text-muted uppercase tracking-wider text-[11px] block mb-1">{t('page.primaryRisk')}</span>
                <strong class="text-signature-coral text-[15px] font-semibold">{data.keyRisk || (data.warnings && data.warnings[0]) || data.specific_warning}</strong>
              </div>
              <div class="bg-canvas/60 border border-hairline rounded-md p-4 shadow-xs">
                <span class="text-caption text-muted uppercase tracking-wider text-[11px] block mb-1">{t('page.safetyInstruction')}</span>
                <strong class="text-success text-[15px] font-semibold">{data.tip || (data.tips && data.tips[0]) || (data.instructions && data.instructions[0])}</strong>
              </div>
            </div>
            <div class="border-t border-hairline my-4 opacity-50"></div>
            <div class="mt-6 text-body-md text-body leading-relaxed">
              <h3 class="text-caption text-muted uppercase tracking-wider text-[11px] mb-3">{t('page.detailedExplanation')}</h3>
              {data.learnMore && <p class="mb-4 font-medium">{data.learnMore}</p>}
              {data.reason.split('\n\n').map((para: string) => (
                <p class="mb-4 last:mb-0">
                  {para}
                </p>
              ))}
            </div>
          </div>
        ) : (
          <div>
            <div class="border-t border-hairline my-4 opacity-50"></div>
            <h3 class="text-caption text-muted mb-2">{t('page.detailedExplanation')}</h3>
            {data.reason.split('\n\n').map((para: string) => (
              <p class="text-body-md text-body leading-relaxed mb-4 last:mb-0">
                {para}
              </p>
            ))}
          </div>
        )}
      </div>
    </section>

    <!-- All-Appliance Quick Switcher (Matrix Pills) -->
    {siblingApplianceItems.length > 0 && (
      <section class="mb-12 bg-surface-soft border border-hairline rounded-lg p-5 shadow-xs">
        <div class="flex items-center justify-between mb-3">
          <span class="text-caption text-ink font-semibold text-[13px] inline-flex items-center gap-2">
            <span>🔄</span> {t('action.otherAppliances')}
          </span>
          <span class="text-[11px] text-muted">{siblingApplianceItems.length + 1} {lang === 'es' ? 'electrodomésticos' : lang === 'pt' ? 'eletrodomésticos' : lang === 'zh-cn' ? '个电器' : lang === 'ja' ? '家電' : 'appliances'}</span>
        </div>
        <div class="flex flex-wrap gap-2.5">
          <!-- Current Appliance (Active) -->
          <span class="px-3.5 py-2 rounded-md text-xs font-semibold bg-canvas text-ink border-2 border-primary shadow-xs inline-flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-primary"></span>
            {formattedAppliance} ({formattedAnswer})
          </span>

          <!-- Sibling Appliances -->
          {siblingApplianceItems.map((sibling: any) => {
            const sibAppKey = `appliance.${sibling.appliance}` as any;
            const sibFormatted = t(sibAppKey) || (sibling.appliance.charAt(0).toUpperCase() + sibling.appliance.slice(1));
            const sibUrl = translatePath(`/${sibling.appliance}/${sibling.slug}/`);
            return (
              <a
                href={sibUrl}
                class={`px-3.5 py-2 rounded-md text-xs font-medium border transition-all hover:scale-105 active:scale-95 inline-flex items-center gap-1.5 shadow-2xs ${
                  sibling.safe === 'yes' ? 'bg-success-bg/80 text-success border-success-border/40 hover:bg-success-bg' :
                  sibling.safe === 'no' ? 'bg-error-bg/80 text-error border-error-border/40 hover:bg-error-bg' :
                  'bg-warning-bg/80 text-warning border-warning-border/40 hover:bg-warning-bg'
                }`}
              >
                <span>{sibling.safe === 'yes' ? '✓' : sibling.safe === 'no' ? '✗' : '⚠'}</span>
                <span>{sibFormatted}</span>
                <span class="text-[10px] opacity-75 uppercase">({sibling.safe.toUpperCase()})</span>
              </a>
            );
          })}
        </div>
      </section>
    )}

    <!-- Technical & Safety Specifications -->
    <TechnicalSpecs specs={data.technicalSpecs} lang={lang} />

    <!-- Tips and Warnings -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
      <!-- Tips -->
      <div class="bg-surface-soft rounded-md p-6 border border-hairline/50">
        <h2 class="text-title-sm text-ink font-medium mb-4 flex items-center gap-2">
          💡 {t('page.crucialTips')} - {data.item} & {formattedAppliance}
        </h2>
        <ul class="flex flex-col gap-3">
          {data.tips.map((tip: string) => (
            <li class="text-body-md text-body flex gap-2.5 items-start leading-relaxed">
              <span class="text-success font-bold mt-0.5">✓</span>
              <span>{tip}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Warnings -->
      <div class="bg-surface-soft rounded-md p-6 border border-hairline/50">
