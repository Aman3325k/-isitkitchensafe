---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import TechnicalSpecs from './TechnicalSpecs.astro';
import itemsData from '../data/items.json';
import itemsEs from '../data/items.es.json';
import itemsPt from '../data/items.pt.json';
import itemsZh from '../data/items.zh-cn.json';
import itemsJa from '../data/items.ja.json';
import { generateMetaDescription } from '../utils/seoHelper.js';
import { resolveAllGuidesForItem, getPeopleAlsoAsk, getSmartRelatedItems } from '../utils/linkingHelper.js';
import { getCategoryForMaterial } from '../utils/materialCategories';
import { useTranslations, useTranslatedPath, getApplianceIn, getApplianceUrl, getDirectoryUrl, isDirectoryTranslatedInLocale } from '../i18n/utils';
import type { SupportedLanguage } from '../i18n/ui';

interface Props {
  data: any;
  lang?: SupportedLanguage;
  availableLocales?: SupportedLanguage[];
}

const { data, lang = 'en', availableLocales } = Astro.props;

const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

// Format appliance name
const appKey = `appliance.${data.appliance}` as any;
const formattedAppliance = t(appKey) || (data.appliance.charAt(0).toUpperCase() + data.appliance.slice(1));
const applianceInPhrase = getApplianceIn(data.appliance, lang);

// Select localized items dataset based on lang
const currentItemsDataset = lang === 'es' ? itemsEs : lang === 'pt' ? itemsPt : lang === 'zh-cn' ? itemsZh : lang === 'ja' ? itemsJa : itemsData;

// Find all other appliances containing this same item (All-Appliance Matrix Switcher)
const siblingApplianceItems: any[] = [];
const seenSiblingAppliances = new Set<string>();

for (const item of currentItemsDataset) {
  if (item.appliance === data.appliance) continue;
  if (seenSiblingAppliances.has(item.appliance)) continue;
  
  const matchesSlug = item.slug === data.slug;
  const matchesName = item.item && data.item && item.item.toLowerCase() === data.item.toLowerCase();
  
  if (matchesSlug || matchesName) {
    siblingApplianceItems.push(item);
    seenSiblingAppliances.add(item.appliance);
  }
}

// Get smart, topically-clustered related items (guaranteed minimum 5 relevant guides)
const relatedItems = getSmartRelatedItems(data, currentItemsDataset);

const allGuides = resolveAllGuidesForItem(data.item, data.slug);
const paaList = getPeopleAlsoAsk(data.item, data.slug, allGuides, data.relatedItems || []);

const formattedAnswer = data.safe.toUpperCase(); // "YES", "NO", or "DEPENDS"

// Format natural question heading per locale grammar
let questionHeading = `${t('page.canYouPut')} ${data.item} ${applianceInPhrase}?`;
if (lang === 'zh-cn') {
  questionHeading = `${data.item}可以${applianceInPhrase}吗？`;
} else if (lang === 'ja') {
  questionHeading = `${data.item}は${applianceInPhrase}入れても大丈夫？`;
}

// SEO title and description
let pageTitle = `Can You Put ${data.item} in the ${formattedAppliance}? | IsItKitchenSafe`;
let pageDescription = data.shortAnswer;

if (lang === 'es') {
  pageTitle = `¿Se puede meter ${data.item} ${applianceInPhrase}? | ¿Es Seguro en la Cocina?`;
  pageDescription = `${data.shortAnswer} Descubre advertencias de seguridad, consejos de cocina y reglas de compatibilidad.`;
} else if (lang === 'pt') {
  pageTitle = `Pode colocar ${data.item} ${applianceInPhrase}? | É Seguro na Cozinha?`;
  pageDescription = `${data.shortAnswer} Saiba mais sobre avisos de segurança, dicas de cozinha e regras de compatibilidade.`;
} else if (lang === 'zh-cn') {
  pageTitle = `${questionHeading} | 厨房安全指南`;
  pageDescription = `${data.shortAnswer} 查看安全使用注意事项、操作技巧与材质禁忌。`;
} else if (lang === 'ja') {
  pageTitle = `${questionHeading} | キッチン安全チェッカー`;
  pageDescription = `${data.shortAnswer} 安全上の注意点、冷凍のコツ、失敗しない保存方法を徹底解説。`;
} else {
  pageDescription = generateMetaDescription(data.item, formattedAppliance, formattedAnswer, data.shortAnswer);
}


const speakableSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": [".quick-answer", ".short-answer", "h1"]
  }
};

const howToSchema = (data.safe === 'yes' || data.safe === 'depends') ? {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": questionHeading,
  "description": data.shortAnswer,
  "step": data.tips.map((tip: string, idx: number) => ({
    "@type": "HowToStep",
    "position": idx + 1,
    "text": tip
  }))
} : null;

// AI-Ready Quick-Reference Summary Table Labels & Values
const summaryLabels = {
  heading: lang === 'es' ? 'Resumen de Seguridad de Referencia Rápida' :
           lang === 'pt' ? 'Resumo de Segurança de Referência Rápida' :
           lang === 'zh-cn' ? '安全速查摘要表' :
           lang === 'ja' ? 'クイック安全早見表' :
           'Quick-Reference Safety Summary',
  item: lang === 'es' ? 'Artículo' : lang === 'pt' ? 'Item' : lang === 'zh-cn' ? '物品' : lang === 'ja' ? '対象アイテム' : 'Item',
  appliance: lang === 'es' ? 'Electrodoméstico' : lang === 'pt' ? 'Eletrodoméstico' : lang === 'zh-cn' ? '适用电器' : lang === 'ja' ? '対象家電' : 'Appliance',
  verdict: lang === 'es' ? 'Veredicto de Seguridad' : lang === 'pt' ? 'Veredito de Segurança' : lang === 'zh-cn' ? '安全结论' : lang === 'ja' ? '安全判定' : 'Safety Verdict',
  materialRisk: lang === 'es' ? 'Material / Riesgo Principal' : lang === 'pt' ? 'Material / Risco Principal' : lang === 'zh-cn' ? '主要材质与风险' : lang === 'ja' ? '主な材質・リスク' : 'Primary Material / Risk',
  quickAction: lang === 'es' ? 'Acción Recomendada' : lang === 'pt' ? 'Ação Recomendada' : lang === 'zh-cn' ? '建议操作' : lang === 'ja' ? '推奨アクション' : 'Quick Action'
};

const primaryRiskText = data.keyRisk || data.specific_warning || (data.warnings && data.warnings[0]) || '';
const primaryMaterialRiskDisplay = data.material && primaryRiskText
  ? `${data.material} — ${primaryRiskText}`
  : (data.material || primaryRiskText || formattedAppliance);
const quickActionText = data.tip || (data.tips && data.tips[0]) || (data.instructions && data.instructions[0]) || data.shortAnswer;

// Contextual Consumer Tool Recommendation (Smart 25-Tool Router across EN/ES/PT/ZH-CN/JA)
type RecommendedToolKey =
  | 'babyBottle'
  | 'kitchenFire'
  | 'castIron'
  | 'induction'
  | 'descaling'
  | 'instantPot'
  | 'foodAllergy'
  | 'cleaner'
  | 'oil'
  | 'dishwasherDosage'
  | 'dishwasherRinseAid'
  | 'pan'
  | 'ovenRack'
  | 'ovenTemp'
  | 'plastic'
  | 'powerOutage'
  | 'thawing'
  | 'moldyFood'
  | 'pantry'
  | 'fridgeZone'
  | 'leftover'
  | 'cookingTemp'
  | 'airfryer'
  | 'microwaveWattage'
  | 'symbol';

function selectRecommendedTool(slugRaw: unknown, itemNameRaw: unknown, applianceRaw: unknown): RecommendedToolKey {
  const itemSlugLower = String(slugRaw || '').toLowerCase();
  const itemNameLower = String(itemNameRaw || '').toLowerCase();
  const itemMatchText = `${itemSlugLower} ${itemNameLower}`;
  const itemApplianceLower = String(applianceRaw || '').toLowerCase();

  const isMeatOrProteinItem = /\b(chicken|turkey|beef|pork|steaks?|meats?|meatballs?|hamburger|burgers?|ham|lamb|duck|veal|organ|fish|salmon|tuna|cod|tilapia|shrimp|scallops?|lobster|crab|mussels?|clams?|seafood|bacon|sausages?|hot[- ]dogs?|ground|eggs?|casseroles?|lasagna)\b/i.test(itemSlugLower);
  const isCookedLeftoverItem = /\b(cooked|leftover|soup|broth|stew|chili|lasagna|casserole|stir[- ]fry|curry|macaroni[- ]and[- ]cheese|enchiladas|mashed[- ]potatoes|deli[- ]sliced|rotisserie|canned|opened|hummus|pesto|salsa|guacamole|jam|jelly|mayonnaise|ketchup|mustard|sauce|dressing|pickles|kimchi|sauerkraut|olives|capers|marinated|miso|gochujang|tahini|custard|cheesecake|tiramisu|tart|pie|frosting|salami|prosciutto|pepperoni|hot[- ]dogs|anchovy|sardines)\b/i.test(itemSlugLower);
  const isMicrowaveNonFoodItem = /\b(foil|metal|aluminum|fork|spoon|gold[- ]rimmed|silverware|ceramic[- ]mug|ceramic[- ]plate|fine[- ]china|glass[- ]bowl|wine[- ]glass|mason[- ]jar|travel[- ]mug|yeti|hydro[- ]flask|stanley|stainless|paper|cardboard|newspaper|wax[- ]paper|parchment|wood|silicone|muffin[- ]tin|baking[- ]sheet|bundt|instant[- ]pot|hand[- ]warmers|candle|memory[- ]foam|crocs|shoes|sweater)\b/i.test(itemSlugLower);

  if (/\b(baby[- ]bottles?|sippy[- ]cups?|pacifiers?|teethers?|breast[- ]?milk|baby[- ]food|formula|nipples?|steriliz(?:er|e)|kids[- ]plates?|bamboo[- ]kids|melamine[- ]kids|infant|nursery|biber[oó]n|mamadeira|chupeta|奶瓶|学饮杯|安抚奶嘴|哺乳瓶|おしゃぶり)\b/i.test(itemMatchText)) {
    return 'babyBottle';
  }
  if (
    /\b(kitchen[- ]fire|grease[- ]fire|burning[- ]oil|sparking|oil[- ]soaked|cooking[- ]oil[- ]towels?|grease[- ]stained|motor[- ]oil|wax[- ]stained|candle[- ]wax)\b/i.test(itemSlugLower) ||
    (itemApplianceLower === 'microwave' && /\b(aluminum[- ]foil|tin[- ]foil|foil|aluminum[- ]pan|metal[- ]spoon|fork[- ]in[- ]microwave|gold[- ]rimmed|gold[- ]silverware|silver[- ]silverware|metal[- ]twist[- ]ties?|steel[- ]wool|hand[- ]warmers?|candles?|paper[- ]bags?|brown[- ]paper[- ]bag|newspaper|cardboard[- ]box|cardboard[- ]pizza[- ]box)\b/i.test(itemSlugLower)) ||
    ((itemApplianceLower === 'oven' || itemApplianceLower === 'airfryer') && /\b(cooking[- ]spray[- ]aerosol|parchment[- ]paper[- ]unweighted|aluminum[- ]foil[- ]loose|newspaper|cardboard|pizza[- ]box|paper[- ]bags?|paper[- ]towels?|tissue[- ]paper|wax[- ]paper|steel[- ]wool)\b/i.test(itemSlugLower))
  ) {
    return 'kitchenFire';
  }
  if (/\b(cast[- ]iron|carbon[- ]steel|dutch[- ]ovens?|le[- ]creuset|staub|lodge|skillets?|seasoning|rust)\b/i.test(itemSlugLower)) {
    return 'castIron';
  }
  if (
    /\b(induction|moka[- ]pots?|copper|tri[- ]ply|magnetic|all[- ]clad|ferromagnetic|woks?)\b/i.test(itemSlugLower) ||
    (itemApplianceLower !== 'oven' && /\b(stainless[- ]steel[- ]pans?|steel[- ]pans?)\b/i.test(itemSlugLower))
  ) {
    return 'induction';
  }
  if (/\b(coffee[- ]pot|coffee[- ]maker|espresso|kettles?|keurig|nespresso|carafes?|ice[- ]makers?|steamers?|descal(?:e|ing))\b/i.test(itemSlugLower)) {
    return 'descaling';
  }
  if (
    /\b(instant[- ]pot|pressure[- ]cooker|bone[- ]broth|vegetable[- ]soup[- ]broth|chili[- ]con[- ]carne|dried[- ]beans?|dry[- ]beans?|cooked[- ]beans[- ]chickpeas|cooked[- ]lentils[- ]dal|lentils?|chickpeas?|split[- ]peas?|steel[- ]cut[- ]oats?)\b/i.test(itemSlugLower) ||
    (/\bchili\b/i.test(itemSlugLower) && !/\b(paste|sauce|oil|pepper)\b/i.test(itemSlugLower))
  ) {
    return 'instantPot';
  }
  if (
    /\b(cutting[- ]boards?|butcher[- ]block|wooden[- ]spoons?|bamboo[- ]spoons?|wooden[- ]utensils?|toasters?|colanders?|strainers?|sponges?|dishcloths?|waffle[- ]makers?|waffle[- ]irons?|waffle[- ]weave[- ]kitchen[- ]towel|microfiber[- ]cleaning[- ]cloths?|shared[- ]fryers?|deep[- ]fryers?|allergen|cheese[- ]grater|garlic[- ]press)\b/i.test(itemSlugLower)
  ) {
    return 'foodAllergy';
  }
  if (
    /\b(bleach|ammonia|peroxide|cleaners?|soaps?|sanitizers?|disinfectants?|drain[- ]cleaners?|lye|caustic|acetone|paint[- ]thinner|gasoline|steel[- ]wool)\b/i.test(itemSlugLower)
  ) {
    return 'cleaner';
  }
  if (
    /\b(olive[- ]oil|vegetable[- ]oil|coconut[- ]oil|avocado[- ]oil|cooking[- ]oil|canola[- ]oil|sesame[- ]oil|sunflower[- ]oil|peanut[- ]oil|cooking[- ]spray|ghee|lard|tallow|shortening)\b/i.test(itemSlugLower) ||
    (/\bbutter\b/i.test(itemSlugLower) && !/\b(peanut[- ]butter|almond[- ]butter|butter[- ]paper|buttercream|butter[- ]stain)\b/i.test(itemSlugLower))
  ) {
    return 'oil';
  }
  if (
    itemApplianceLower === 'dishwasher' &&
    /\b(rinse[- ]aid|cloudy[- ]glass(?:es)?|white[- ]film|etching|hard[- ]water|limescale|scale[- ]buildup|calcification|water[- ]hardness)\b/i.test(itemSlugLower)
  ) {
    return 'dishwasherRinseAid';
  }
  if (
    itemApplianceLower === 'dishwasher' &&
    /\b(glass(?:es|ware)?|crystal|wine[- ]glass(?:es)?|champagne[- ]flutes?|mason[- ]jars?|pyrex|silicone|stasher|owala|yeti|stanley|hydroflask|nalgene|contigo|swell|klean[- ]kanteen|camelbak|thermos|ninja[- ]creami|ninja[- ]blender|nutribullet|vitamix|air[- ]fryer[- ]basket|cuisinart|aluminum|baking[- ]sheet|muffin[- ]tin|bundt|springform|pods?|detergents?|rinse[- ]aid|silverware|pewter|antique|corelle|acrylic|travel[- ]mug|knives|knife|shears)\b/i.test(itemSlugLower)
  ) {
    return 'dishwasherDosage';
  }
  if (
    itemApplianceLower !== 'oven' &&
    /\b(nonstick|non[- ]stick|teflon|ptfe|ceramic[- ]pans?|hexclad|caraway|fry(?:ing)?[- ]pans?)\b/i.test(itemSlugLower)
  ) {
    return 'pan';
  }
  if (
    (itemApplianceLower === 'oven' && /\b(baking[- ]sheets?|cookie[- ]sheets?|sheet[- ]pans?|muffin[- ]tins?|cupcake[- ]pans?|cake[- ]pans?|bread[- ]pans?|loaf[- ]pans?|springform[- ]pans?|bundt[- ]pans?|pie[- ]pans?|pie[- ]dishes?|tart[- ]pans?|pizza[- ]stones?|baking[- ]stones?|broilers?|roasting[- ]pans?|wire[- ]rack|glass[- ]dish|ceramic[- ]dish|casserole[- ]dishes?|glass[- ]baking|silicone[- ]molds?|paper[- ]baking[- ]cups?|foil[- ]cupcake[- ]liners?|cookie[- ]cutters?|frozen[- ]pizza[- ]directly|pizza[- ]dough|cookie[- ]dough|chocolate[- ]chip[- ]cookies|cake|muffin|pie|brownie)\b/i.test(itemSlugLower)) ||
    (itemApplianceLower !== 'dishwasher' && /\b(baking[- ]sheets?|cookie[- ]sheets?|muffin[- ]tins?|cake[- ]pans?|pie[- ]dishes?|pie[- ]pans?|pizza[- ]stones?|baking[- ]stones?|bundt[- ]pans?|springform[- ]pans?|broilers?)\b/i.test(itemSlugLower))
  ) {
    return 'ovenRack';
  }
  if (
    /\b(always[- ]pan)\b/i.test(itemSlugLower) ||
    (itemApplianceLower === 'oven' && /\b(pyrex|glass|ceramic|stoneware|corningware|pampered[- ]chef|terracotta|china|porcelain|ramekin|non[- ]stick|nonstick|stainless|aluminum|steel[- ]pan|parchment|foil|silicone|rubber|bakeware|skewers|twine|handles|paper|mason[- ]jar|travel[- ]mug|yeti|hydro[- ]flask|stanley|silverware|lids?|pots?|pans?|dishes?|bowls?|mugs?|plates?|butter[- ]paper)\b/i.test(itemSlugLower)) ||
    (itemApplianceLower !== 'dishwasher' && /\b(pyrex|corningware|stoneware)\b/i.test(itemSlugLower))
  ) {
    return 'ovenTemp';
  }
  if (/\b(plastics?|tupperware|styrofoam|foam[- ]cup|polystyrene|polypropylene|pet|hdpe|pvc|tritan|ziploc|takeout|bento[- ]box|solo[- ]cup|deli[- ]container|vacuum[- ]seal|compostable[- ]pla|cling|protein[- ]shaker|silicone[- ]storage[- ]bag|silicone[- ]bag|melamine)\b/i.test(itemSlugLower)) {
    return 'plastic';
  }
  if (
    /\b(power[- ]outage|blackout|spoil(?:age|ed)|rot(?:ten)?|sour[- ]milk|bad[- ]meat|danger[- ]zone|warm[- ]fridge|warm[- ]freezer|power[- ]cut|storm|refreez(?:e|ing)|ice[- ]cream[- ]refreezing)\b/i.test(itemSlugLower) ||
    (itemApplianceLower === 'freezer' && /\b(milk|cream|yogurt|cheese|ice[- ]cream|mayonnaise|hummus|pesto|salsa|guacamole|deli[- ]meat)\b/i.test(itemSlugLower))
  ) {
    return 'powerOutage';
  }
  if (
    (itemApplianceLower === 'freezer' || /\bfrozen[- ](meat|raw[- ]chicken)\b/i.test(itemSlugLower) || /\bthaw/i.test(itemSlugLower)) &&
    isMeatOrProteinItem
  ) {
    return 'thawing';
  }
  if (
    /\b(mold|mould)\b/i.test(itemSlugLower) ||
    (itemApplianceLower !== 'airfryer' && itemApplianceLower !== 'microwave' &&
      /\b(cheddar[- ]cheese|parmesan|mozzarella|cream[- ]cheese|cottage[- ]cheese|soft[- ]cheese|hard[- ]cheese|brie|blue[- ]cheese|shredded[- ]cheese|cheese|white[- ]bread|whole[- ]wheat[- ]bread|sourdough[- ]bread|pita[- ]bread|bread|bagels?|tortillas?|croissants?|strawberr(?:y|ies)|blueberr(?:y|ies)|raspberr(?:y|ies)|blackberr(?:y|ies)|berries|jam|jelly|preserves?|yogurt|salami|prosciutto|pepperoni|deli[- ]sliced|deli[- ]meat|deli[- ]slices|hummus)\b/i.test(itemSlugLower) &&
      !/\b(cheese[- ]grater|macaroni[- ]and[- ]cheese|cheesecake|bread[- ]knife|bread[- ]pan|bread[- ]dough|bread[- ]crumbs|sourdough[- ]starter)\b/i.test(itemSlugLower))
  ) {
    return 'moldyFood';
  }
  if (
    itemApplianceLower !== 'microwave' &&
    /\b(flour|white[- ]rice|brown[- ]rice|dry[- ]rice|spices?|dried[- ]herbs?|herbs[- ]in[- ]oil|honey|maple[- ]syrup|canned|condensed[- ]milk[- ]can|evaporated[- ]milk[- ]can|baking[- ]powder|baking[- ]soda|cornstarch|yeast|dry[- ]pasta|spaghetti|macaroni|oats?|oatmeal|granola|quinoa|coffee[- ]beans?|peanut[- ]butter|almond[- ]butter|nutella|nuts|almonds?|walnuts?|pecans?|peanuts?|cashews?|pistachios?|pumpkin[- ]seeds?|sunflower[- ]seeds?|sesame[- ]seeds?|vinegar|sugar|salt)\b/i.test(itemSlugLower) &&
    !/\b(cooked|leftover|macaroni[- ]and[- ]cheese|almond[- ]milk|oat[- ]milk|bread[- ]dough|biscuit[- ]dough|hot[- ]sauce[- ]vinegar|salad[- ]dressing|butter[- ]salted|butter[- ]unsalted)\b/i.test(itemSlugLower)
  ) {
    return 'pantry';
  }
  if (itemApplianceLower === 'refrigerator') {
    return isCookedLeftoverItem ? 'leftover' : 'fridgeZone';
  }
  if (
    itemApplianceLower === 'freezer' &&
    (isCookedLeftoverItem || /\b(rice|pasta|bread|cake|cookies|muffin|pie|brownie|avocado|watermelon|pineapple|apple|banana|orange|strawberry|blueberry|raspberry|blackberry|grape|cantaloupe|honeydew|peach|plum|nectarine|cherry|mango|tomato|cucumber|pepper|spinach|lettuce|broccoli|celery|cabbage|zucchini|carrot|onion|garlic|potato|mushroom|tofu|tempeh|egg|nut|herb|honey|syrup|juice|wine|beer|coffee|tea|soda|kombucha|smoothie|shake|pizza|dough|ginger|lemon|lime|squash|eggplant|asparagus|peas|corn|quinoa|lentils|oatmeal|spaghetti|macaroni|croissant|bagel|tortilla|chocolate|maple|peanut|almond|nutella)\b/i.test(itemSlugLower))
  ) {
    return 'leftover';
  }
  if ((itemApplianceLower === 'oven' || itemApplianceLower === 'airfryer') && isMeatOrProteinItem) {
    return 'cookingTemp';
  }
  if (itemApplianceLower === 'airfryer') {
    return 'airfryer';
  }
  if (itemApplianceLower === 'microwave' && !isMicrowaveNonFoodItem) {
    return 'microwaveWattage';
  }
  return 'symbol';
}

const recommendedToolKey: RecommendedToolKey = selectRecommendedTool(data.slug, data.item, data.appliance);

const interactiveToolBadge =
  lang === 'es' ? 'Herramienta Interactiva' :
  lang === 'pt' ? 'Ferramenta Interativa' :
  lang === 'zh-cn' ? '互动工具' :
  lang === 'ja' ? 'インタラクティブツール' :
  'Interactive Tool';

const toolCatalog: Record<RecommendedToolKey, {
  path: string;
  icon: string;
  badge: string;
  title: string;
  description: string;
  cta: string;
}> = {
  cleaner: {
    path: '/tools/cleaner-mixing-danger-checker/',
    icon: '🧪',
    badge: interactiveToolBadge,
    title: lang === 'es' ? 'Verificador de Peligro al Mezclar Limpiadores de Cocina' :
           lang === 'pt' ? 'Verificador de Perigo ao Misturar Produtos de Limpeza' :
           lang === 'zh-cn' ? '厨房清洁剂混用危险检测器' :
           lang === 'ja' ? 'キッチン洗剤の危険な混合チェッカー' :
           'Kitchen Cleaner Mixing Danger Checker',
    description: lang === 'es' ? 'Comprueba dos limpiadores domésticos antes de mezclarlos para detectar al instante gas cloro tóxico, cloramina o reacciones peligrosas.' :
                 lang === 'pt' ? 'Verifique dois produtos de limpeza antes de misturá-los para detectar instantaneamente gás cloro tóxico, cloramina ou reações perigosas.' :
                 lang === 'zh-cn' ? '混合清洁剂前一键排查两种化学成分，即时识别氯气、氯胺中毒与剧烈放热反应风险。' :
                 lang === 'ja' ? '2種類の家庭用洗剤を混ぜる前にチェックし、有毒な塩素ガスやクロラミン発生、発熱反応の危険を瞬時に判定します。' :
                 'Check two household cleaners before mixing to detect toxic chlorine gas, chloramine, or exothermic reaction hazards instantly.',
    cta: lang === 'es' ? 'Verificar Mezcla' : lang === 'pt' ? 'Verificar Mistura' : lang === 'zh-cn' ? '检测混用风险' : lang === 'ja' ? '混合の危険を確認' : 'Check Cleaner Mix'
  },
  descaling: {
    path: '/tools/appliance-descaling-calculator/',
    icon: '☕',
