    <!-- Direct Cross-linking Guides Box -->
    {lang === 'en' && (allGuides.howLongGuides.length > 0 || allGuides.refreezeGuides.length > 0 || allGuides.whatHappensGuides.length > 0 || allGuides.comparisonGuides.length > 0) && (
      <section id="cross-refs-section" class="mb-12 border-t border-hairline pt-12 content-visibility-auto">
        <h2 class="text-title-lg text-ink font-medium tracking-tight mb-6">Cross-Reference Safety Guides for {data.item}</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {allGuides.howLongGuides.map((g: any) => (
            <a href={g.url} class="p-4 bg-canvas border border-hairline rounded-md hover:border-border-strong text-body-md text-link flex justify-between items-center gap-3 transition-colors shadow-xs">
              <span class="font-medium min-w-0 flex-1 break-words">⏱ Shelf Life: {g.duration}</span>
              <span class="text-xs text-muted shrink-0 whitespace-nowrap">{t('page.readGuide')} &rarr;</span>
            </a>
          ))}
          {allGuides.refreezeGuides.map((g: any) => (
            <a href={g.url} class="p-4 bg-canvas border border-hairline rounded-md hover:border-border-strong text-body-md text-link flex justify-between items-center gap-3 transition-colors shadow-xs">
              <span class="font-medium min-w-0 flex-1 break-words">❄️ Refreezing Safety Rules</span>
