---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import TechnicalSpecs from './TechnicalSpecs.astro';
import itemsData from '../data/items.json';
import itemsEs from '../data/items.es.json';
import itemsPt from '../data/items.pt.json';
import itemsZh from '../data/items.zh-cn.json';
import itemsJa from '../data/items.ja.json';
import { generateMetaDescription } from '../utils/seoHelper.js';
import { resolveAllGuidesForItem, getPeopleAlsoAsk, getSmartRelatedItems } from '../utils/linkingHelper.js';
import { getCategoryForMaterial } from '../utils/materialCategories';
import { useTranslations, useTranslatedPath, getApplianceIn, getApplianceUrl, getDirectoryUrl, isDirectoryTranslatedInLocale } from '../i18n/utils';
import type { SupportedLanguage } from '../i18n/ui';

interface Props {
  data: any;
  lang?: SupportedLanguage;
  availableLocales?: SupportedLanguage[];
}

const { data, lang = 'en', availableLocales } = Astro.props;

const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

// Format appliance name
const appKey = `appliance.${data.appliance}` as any;
const formattedAppliance = t(appKey) || (data.appliance.charAt(0).toUpperCase() + data.appliance.slice(1));
const applianceInPhrase = getApplianceIn(data.appliance, lang);

// Select localized items dataset based on lang
const currentItemsDataset = lang === 'es' ? itemsEs : lang === 'pt' ? itemsPt : lang === 'zh-cn' ? itemsZh : lang === 'ja' ? itemsJa : itemsData;

// Find all other appliances containing this same item (All-Appliance Matrix Switcher)
const siblingApplianceItems: any[] = [];
const seenSiblingAppliances = new Set<string>();

for (const item of currentItemsDataset) {
  if (item.appliance === data.appliance) continue;
  if (seenSiblingAppliances.has(item.appliance)) continue;
  
  const matchesSlug = item.slug === data.slug;
  const matchesName = item.item && data.item && item.item.toLowerCase() === data.item.toLowerCase();
  
  if (matchesSlug || matchesName) {
    siblingApplianceItems.push(item);
    seenSiblingAppliances.add(item.appliance);
  }
}

// Get smart, topically-clustered related items (guaranteed minimum 5 relevant guides)
const relatedItems = getSmartRelatedItems(data, currentItemsDataset);

const allGuides = resolveAllGuidesForItem(data.item, data.slug);
const paaList = getPeopleAlsoAsk(data.item, data.slug, allGuides, data.relatedItems || []);

const formattedAnswer = data.safe.toUpperCase(); // "YES", "NO", or "DEPENDS"

// Format natural question heading per locale grammar
let questionHeading = `${t('page.canYouPut')} ${data.item} ${applianceInPhrase}?`;
if (lang === 'zh-cn') {
  questionHeading = `${data.item}可以${applianceInPhrase}吗？`;
} else if (lang === 'ja') {
  questionHeading = `${data.item}は${applianceInPhrase}入れても大丈夫？`;
}

// SEO title and description
let pageTitle = `Can You Put ${data.item} in the ${formattedAppliance}? | IsItKitchenSafe`;
let pageDescription = data.shortAnswer;

if (lang === 'es') {
  pageTitle = `¿Se puede meter ${data.item} ${applianceInPhrase}? | ¿Es Seguro en la Cocina?`;
  pageDescription = `${data.shortAnswer} Descubre advertencias de seguridad, consejos de cocina y reglas de compatibilidad.`;
} else if (lang === 'pt') {
  pageTitle = `Pode colocar ${data.item} ${applianceInPhrase}? | É Seguro na Cozinha?`;
  pageDescription = `${data.shortAnswer} Saiba mais sobre avisos de segurança, dicas de cozinha e regras de compatibilidade.`;
} else if (lang === 'zh-cn') {
  pageTitle = `${questionHeading} | 厨房安全指南`;
  pageDescription = `${data.shortAnswer} 查看安全使用注意事项、操作技巧与材质禁忌。`;
} else if (lang === 'ja') {
  pageTitle = `${questionHeading} | キッチン安全チェッカー`;
  pageDescription = `${data.shortAnswer} 安全上の注意点、冷凍のコツ、失敗しない保存方法を徹底解説。`;
} else {
  pageDescription = generateMetaDescription(data.item, formattedAppliance, formattedAnswer, data.shortAnswer);
}


const speakableSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": [".quick-answer", ".short-answer", "h1"]
  }
};

const howToSchema = (data.safe === 'yes' || data.safe === 'depends') ? {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": questionHeading,
  "description": data.shortAnswer,
  "step": data.tips.map((tip: string, idx: number) => ({
    "@type": "HowToStep",
    "position": idx + 1,
    "text": tip
  }))
} : null;

// AI-Ready Quick-Reference Summary Table Labels & Values
const summaryLabels = {
  heading: lang === 'es' ? 'Resumen de Seguridad de Referencia Rápida' :
           lang === 'pt' ? 'Resumo de Segurança de Referência Rápida' :
           lang === 'zh-cn' ? '安全速查摘要表' :
           lang === 'ja' ? 'クイック安全早見表' :
           'Quick-Reference Safety Summary',
  item: lang === 'es' ? 'Artículo' : lang === 'pt' ? 'Item' : lang === 'zh-cn' ? '物品' : lang === 'ja' ? '対象アイテム' : 'Item',
  appliance: lang === 'es' ? 'Electrodoméstico' : lang === 'pt' ? 'Eletrodoméstico' : lang === 'zh-cn' ? '适用电器' : lang === 'ja' ? '対象家電' : 'Appliance',
  verdict: lang === 'es' ? 'Veredicto de Seguridad' : lang === 'pt' ? 'Veredito de Segurança' : lang === 'zh-cn' ? '安全结论' : lang === 'ja' ? '安全判定' : 'Safety Verdict',
  materialRisk: lang === 'es' ? 'Material / Riesgo Principal' : lang === 'pt' ? 'Material / Risco Principal' : lang === 'zh-cn' ? '主要材质与风险' : lang === 'ja' ? '主な材質・リスク' : 'Primary Material / Risk',
  quickAction: lang === 'es' ? 'Acción Recomendada' : lang === 'pt' ? 'Ação Recomendada' : lang === 'zh-cn' ? '建议操作' : lang === 'ja' ? '推奨アクション' : 'Quick Action'
};

const primaryRiskText = data.keyRisk || data.specific_warning || (data.warnings && data.warnings[0]) || '';
const primaryMaterialRiskDisplay = data.material && primaryRiskText
  ? `${data.material} — ${primaryRiskText}`
  : (data.material || primaryRiskText || formattedAppliance);
const quickActionText = data.tip || (data.tips && data.tips[0]) || (data.instructions && data.instructions[0]) || data.shortAnswer;

// Contextual Consumer Tool Recommendation
const matchContext = `${data.slug || ''} ${data.item || ''} ${data.material || ''}`.toLowerCase();
let recommendedToolKey: 'symbol' | 'pan' | 'airfryer' | 'oil' = 'symbol';

if (/\b(nonstick|non-stick|teflon|ptfe|pan|skillet|frying pan|fry pan)\b/i.test(matchContext)) {
  recommendedToolKey = 'pan';
} else if (/\b(oil|oils)\b/i.test(matchContext)) {
  recommendedToolKey = 'oil';
} else if (data.appliance === 'airfryer') {
  recommendedToolKey = 'airfryer';
} else if (data.appliance === 'dishwasher' || /\b(plastic|container|tupperware|bottle|tumbler|flask)\b/i.test(matchContext)) {
  recommendedToolKey = 'symbol';
}

const toolCatalog = {
  symbol: {
    path: '/tools/kitchen-symbol-decoder/',
    icon: '🔍',
    badge: lang === 'es' ? 'Herramienta Interactiva' : lang === 'pt' ? 'Ferramenta Interativa' : lang === 'zh-cn' ? '互动工具' : lang === 'ja' ? 'インタラクティブツール' : 'Interactive Tool',
    title: lang === 'es' ? 'Decodificador de Símbolos de Cocina' :
           lang === 'pt' ? 'Decodificador de Símbolos de Cozinha' :
           lang === 'zh-cn' ? '厨具底部安全标志识别器' :
           lang === 'ja' ? 'キッチン用品マーク解読ツール' :
           'Kitchen Bottom Symbol Decoder',
    description: lang === 'es' ? '¿No estás seguro de los íconos en la base de tu recipiente? Identifica al instante los símbolos de lavavajillas, microondas y plásticos.' :
                 lang === 'pt' ? 'Não tem certeza sobre os ícones no fundo do recipiente? Identifique na hora símbolos de lava-louças, micro-ondas e plásticos.' :
                 lang === 'zh-cn' ? '不确定容器底部的符号含义？即时识别洗碗机、微波炉、耐热与塑料回收标志。' :
                 lang === 'ja' ? '容器の底にあるマークの意味がわからない時は、食洗機・電子レンジ・耐熱マークを瞬時に判定できます。' :
                 'Unsure about the icons stamped on the bottom of your container or cookware? Decode dishwasher, microwave, oven, and plastic resin symbols instantly.',
    cta: lang === 'es' ? 'Abrir Decodificador' : lang === 'pt' ? 'Abrir Decodificador' : lang === 'zh-cn' ? '打开标志识别器' : lang === 'ja' ? 'マークを調べる' : 'Decode Bottom Symbols'
  },
  pan: {
    path: '/tools/pan-scratch-inspector/',
    icon: '🍳',
    badge: lang === 'es' ? 'Herramienta Interactiva' : lang === 'pt' ? 'Ferramenta Interativa' : lang === 'zh-cn' ? '互动工具' : lang === 'ja' ? 'インタラクティブツール' : 'Interactive Tool',
    title: lang === 'es' ? 'Inspector de Rayones en Sartenes Antiadherentes' :
           lang === 'pt' ? 'Inspetor de Riscos em Panelas Antiaderentes' :
           lang === 'zh-cn' ? '不粘锅划痕安全检测器' :
           lang === 'ja' ? 'テフロン・フライパン傷診断ツール' :
           'Nonstick Pan Scratch Inspector',
    description: lang === 'es' ? 'Evalúa si tu sartén antiadherente o de teflón sigue siendo segura para cocinar o si debes reemplazarla por riesgo de PTFE/PFAS.' :
                 lang === 'pt' ? 'Avalie se sua panela antiaderente ainda é segura para cozinhar ou se deve ser substituída devido ao desgaste do revestimento.' :
                 lang === 'zh-cn' ? '评估不粘锅或特氟龙涂层划伤程度，判断是继续安全使用还是应立即更换。' :
                 lang === 'ja' ? 'フッ素樹脂加工フライパンの傷の深さを診断し、使い続けて安全か買い替えるべきかを判定します。' :
                 'Check whether your scratched nonstick skillet or pan is still safe to cook with or should be replaced to avoid coating flaking.',
    cta: lang === 'es' ? 'Inspeccionar Sartén' : lang === 'pt' ? 'Inspecionar Panela' : lang === 'zh-cn' ? '开始检测锅具' : lang === 'ja' ? 'フライパンを診断' : 'Inspect Your Pan'
  },
  airfryer: {
    path: '/tools/air-fryer-acrylamide-calculator/',
    icon: '🔥',
    badge: lang === 'es' ? 'Herramienta Interactiva' : lang === 'pt' ? 'Ferramenta Interativa' : lang === 'zh-cn' ? '互动工具' : lang === 'ja' ? 'インタラクティブツール' : 'Interactive Tool',
    title: lang === 'es' ? 'Calculadora de Acrilamida en Freidora de Aire' :
           lang === 'pt' ? 'Calculadora de Acrilamida na Air Fryer' :
           lang === 'zh-cn' ? '空气炸锅丙烯酰胺温度计算器' :
           lang === 'ja' ? 'ノンフライヤー アクリルアミド計算ツール' :
           'Air Fryer Acrylamide & Temp Calculator',
    description: lang === 'es' ? 'Optimiza el tiempo y la temperatura de tu freidora de aire para reducir la formación de acrilamida y evitar el sobrecalentamiento.' :
                 lang === 'pt' ? 'Ajuste a temperatura e o tempo na air fryer para reduzir a formação de acrilamida e cozinhar com mais segurança.' :
                 lang === 'zh-cn' ? '科学评估空气炸锅温度与时间组合，降低高温美拉德反应产生的丙烯酰胺风险。' :
                 lang === 'ja' ? 'ノンフライヤーの加熱温度と時間からアクリルアミド生成リスクを評価し、安全な調理条件を見つけます。' :
                 'Dial in safer air-fryer temperatures and cook times to minimize acrylamide formation and prevent overheating.',
    cta: lang === 'es' ? 'Abrir Calculadora' : lang === 'pt' ? 'Abrir Calculadora' : lang === 'zh-cn' ? '打开计算器' : lang === 'ja' ? 'ツールを開く' : 'Run Air Fryer Calculator'
  },
  oil: {
    path: '/tools/culinary-oil-smoke-point-simulator/',
    icon: '🫒',
    badge: lang === 'es' ? 'Herramienta Interactiva' : lang === 'pt' ? 'Ferramenta Interativa' : lang === 'zh-cn' ? '互动工具' : lang === 'ja' ? 'インタラクティブツール' : 'Interactive Tool',
    title: lang === 'es' ? 'Simulador de Punto de Humo de Aceites' :
           lang === 'pt' ? 'Simulador de Ponto de Fumaça de Óleos' :
           lang === 'zh-cn' ? '食用油烟点安全模拟器' :
           lang === 'ja' ? '調理油の発煙点シミュレーター' :
           'Culinary Oil Smoke Point Simulator',
    description: lang === 'es' ? 'Compara los puntos de humo y la estabilidad térmica de los aceites de cocina para evitar humo tóxico e incendios por grasa.' :
                 lang === 'pt' ? 'Compare os pontos de fumaça e a estabilidade térmica dos óleos culinários para evitar fumaça tóxica e superaquecimento.' :
                 lang === 'zh-cn' ? '对比各类食用油的烟点与高温氧化稳定性，避免油烟有害物质与厨房起火隐患。' :
                 lang === 'ja' ? '調理油ごとの発煙点と熱安定性を比較し、有害な煙や過熱トラブルを防ぎます。' :
                 'Compare cooking oil smoke points and thermal oxidation thresholds to prevent toxic fumes and grease flare-ups.',
    cta: lang === 'es' ? 'Comparar Aceites' : lang === 'pt' ? 'Comparar Óleos' : lang === 'zh-cn' ? '模拟油温烟点' : lang === 'ja' ? '発煙点を確認' : 'Check Oil Smoke Points'
  }
};

const recommendedTool = toolCatalog[recommendedToolKey];
const recommendedToolUrl = translatePath(recommendedTool.path);
const methodologyUrl = getDirectoryUrl('methodology', lang);
const savedSheetUrl = getDirectoryUrl('saved', lang);

---

<Layout title={pageTitle} description={pageDescription} faqs={data.faqs} lang={lang} availableLocales={availableLocales}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(speakableSchema)} />
    {howToSchema && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
    )}
  </Fragment>
  <article class="max-w-[800px] mx-auto px-6 py-[48px] md:py-[64px]">
    <!-- Breadcrumbs -->
    <Breadcrumbs 
      items={[
        { label: t('nav.home'), href: translatePath('/') },
        { label: formattedAppliance, href: getApplianceUrl(data.appliance, lang) },
        { label: data.item }
      ]}
    />

    <!-- Header Section -->
    <header class="mb-10 text-center md:text-left">
      <span class="text-caption text-muted uppercase tracking-wider text-xs block mb-2">{formattedAppliance} {t('page.guideSuffix')}</span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-6 leading-tight">
        {questionHeading}
      </h1>

      <!-- Trust Signal Badge (Above the fold) -->
      <div class="inline-flex items-center gap-3">
        {data.safe === 'yes' && (
          <div class="badge-yes quick-answer px-6 py-2 text-sm">
            <span class="mr-1.5">✓</span> {t('verdict.yes')}
          </div>
        )}
        {data.safe === 'no' && (
          <div class="badge-no quick-answer px-6 py-2 text-sm">
            <span class="mr-1.5">✗</span> {t('verdict.no')}
          </div>
        )}
        {data.safe === 'depends' && (
          <div class="badge-depends quick-answer px-6 py-2 text-sm">
            <span class="mr-1.5">⚠</span> {t('verdict.depends')}
          </div>
        )}
      </div>

      <!-- E-E-A-T Editorial Review & Safety Standard Attribution -->
      <div class="mt-4 flex flex-wrap items-center justify-center md:justify-start gap-x-3 gap-y-1.5 text-[12px] text-muted">
        <span class="inline-flex items-center gap-1.5 font-medium text-ink">
          <svg class="w-3.5 h-3.5 text-success shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
          </svg>
          <a href={getDirectoryUrl('about', lang)} class="hover:text-link transition-colors">
            {lang === 'es' ? 'Revisado por el Comité Editorial' :
             lang === 'pt' ? 'Revisado pelo Comitê Editorial' :
             lang === 'zh-cn' ? '已由厨房安全编辑委员会审核' :
             lang === 'ja' ? '編集委員会による検証済み' :
             'Reviewed by Editorial Board'}
          </a>
        </span>
        <span class="text-hairline hidden sm:inline">•</span>
        <span>
          {lang === 'es' ? 'Normas USDA/FDA y Manuales OEM' :
           lang === 'pt' ? 'Normas USDA/FDA e Manuais OEM' :
           lang === 'zh-cn' ? '参考 USDA/FDA 规范与 OEM 手册' :
           lang === 'ja' ? 'USDA/FDA基準および各社仕様準拠' :
           'USDA/FDA & OEM Specs'}
        </span>
        <span class="text-hairline hidden sm:inline">•</span>
        <a href={getDirectoryUrl('disclaimer', lang)} class="text-link hover:underline">
          {lang === 'es' ? 'Aviso de Seguridad' :
           lang === 'pt' ? 'Aviso de Segurança' :
           lang === 'zh-cn' ? '安全免责声明' :
           lang === 'ja' ? '安全免責事項' :
           'Safety Disclaimer'}
        </a>
      </div>

      <!-- Interactive Quick Action Buttons Bar -->
      <div class="mt-6 flex flex-wrap items-center justify-center md:justify-start gap-2.5 no-print">
        <!-- Share / Copy Verdict Button -->
        <button
          id="share-verdict-btn"
          type="button"
          class="min-h-[40px] px-4 py-2 bg-canvas hover:bg-surface-soft active:scale-[0.98] text-ink border border-hairline rounded-md text-xs font-medium inline-flex items-center gap-2 shadow-xs transition-all cursor-pointer"
          data-share-title={pageTitle}
          data-share-text={`${data.item} in ${formattedAppliance}: ${formattedAnswer} - ${data.shortAnswer}`}
          data-copied-text={t('page.copied')}
        >
          <svg class="w-4 h-4 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
          </svg>
          <span id="share-btn-text">{t('action.shareVerdict')}</span>
        </button>

        <!-- Save to Kitchen / Bookmark Button -->
        <button
          id="bookmark-item-btn"
          type="button"
          class="min-h-[40px] px-4 py-2 bg-canvas hover:bg-surface-soft active:scale-[0.98] text-ink border border-hairline rounded-md text-xs font-medium inline-flex items-center gap-2 shadow-xs transition-all cursor-pointer"
          data-item-slug={data.slug}
          data-item-name={data.item}
          data-item-appliance={data.appliance}
          data-item-safe={data.safe}
          data-save-text={t('action.saveGuide')}
          data-saved-text={t('action.saved')}
        >
          <svg id="bookmark-icon" class="w-4 h-4 text-muted transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
          </svg>
          <span id="bookmark-btn-text">{t('action.saveGuide')}</span>
        </button>

        <!-- Print Kitchen Safety Card Button -->
        <button
          id="print-card-btn"
          type="button"
          class="min-h-[40px] px-4 py-2 bg-canvas hover:bg-surface-soft active:scale-[0.98] text-ink border border-hairline rounded-md text-xs font-medium inline-flex items-center gap-2 shadow-xs transition-all cursor-pointer"
        >
          <svg class="w-4 h-4 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4H7v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
          </svg>
          <span>{t('action.printCard')}</span>
        </button>
      </div>
    </header>

    <!-- Quick Answer & Explanation Card -->
    <section class="mb-12">
      <div class={`p-8 rounded-lg ${
        data.safe === 'yes' ? 'bg-success-bg border border-success-border/20' : 
        data.safe === 'no' ? 'bg-error-bg border border-error-border/20' : 
        'bg-warning-bg border border-warning-border/20'
      }`}>
        <h2 class="text-title-sm text-ink font-medium mb-3">{t('page.quickVerdict')}: {questionHeading}</h2>
        <p class="short-answer text-title-md font-bold leading-relaxed text-ink mb-5">
          {data.shortAnswer}
        </p>

        <!-- AI-Ready Quick-Reference Summary Table -->
        <div class="overflow-x-auto bg-canvas border border-hairline rounded-md shadow-2xs my-5" id="quick-reference-summary">
          <table class="w-full text-left border-collapse text-[13px]">
            <caption class="sr-only">{summaryLabels.heading}: {data.item} ({formattedAppliance})</caption>
            <tbody class="divide-y divide-hairline">
              <tr>
                <th scope="row" class="py-2.5 px-3.5 bg-surface-soft text-muted font-semibold w-[36%] sm:w-[30%] align-top">{summaryLabels.item}</th>
                <td class="py-2.5 px-3.5 text-ink font-medium align-top">{data.item}</td>
              </tr>
              <tr>
                <th scope="row" class="py-2.5 px-3.5 bg-surface-soft text-muted font-semibold align-top">{summaryLabels.appliance}</th>
                <td class="py-2.5 px-3.5 text-ink align-top">{formattedAppliance}</td>
              </tr>
              <tr>
                <th scope="row" class="py-2.5 px-3.5 bg-surface-soft text-muted font-semibold align-top">{summaryLabels.verdict}</th>
                <td class="py-2.5 px-3.5 align-top">
                  {data.safe === 'yes' && <span class="badge-yes px-2.5 py-0.5 text-[11px]">✓ {t('verdict.yes')}</span>}
                  {data.safe === 'no' && <span class="badge-no px-2.5 py-0.5 text-[11px]">✗ {t('verdict.no')}</span>}
                  {data.safe === 'depends' && <span class="badge-depends px-2.5 py-0.5 text-[11px]">⚠ {t('verdict.depends')}</span>}
                </td>
              </tr>
              <tr>
                <th scope="row" class="py-2.5 px-3.5 bg-surface-soft text-muted font-semibold align-top">{summaryLabels.materialRisk}</th>
                <td class="py-2.5 px-3.5 text-body align-top">{primaryMaterialRiskDisplay}</td>
              </tr>
              <tr>
                <th scope="row" class="py-2.5 px-3.5 bg-surface-soft text-muted font-semibold align-top">{summaryLabels.quickAction}</th>
                <td class="py-2.5 px-3.5 text-ink font-medium align-top">{quickActionText}</td>
              </tr>
            </tbody>
          </table>
        </div>
        
        {data.material ? (
          <div>
            <div class="border-t border-hairline my-4 opacity-50"></div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 my-6">
              <div class="bg-canvas/60 border border-hairline rounded-md p-4 shadow-xs">
                <span class="text-caption text-muted uppercase tracking-wider text-[11px] block mb-1">{t('page.materialComposition')}</span>
                {(() => {
                  const catSlug = getCategoryForMaterial(data.material);
                  return catSlug ? (
                    <a href={getDirectoryUrl(`material/${catSlug}`, lang)} class="text-link hover:underline font-semibold text-[15px] inline-flex items-center gap-1.5">
                      <span>{data.material}</span>
                      {lang !== 'en' && !isDirectoryTranslatedInLocale(`material/${catSlug}`, lang) && (
                        <span class="text-[9px] font-semibold text-muted bg-surface-soft border border-hairline px-1 py-0.5 rounded tracking-wider uppercase" title="Available in English only">EN</span>
                      )}
                    </a>
                  ) : (
                    <strong class="text-ink text-[15px] font-semibold">{data.material}</strong>
                  );
                })()}
              </div>
              <div class="bg-canvas/60 border border-hairline rounded-md p-4 shadow-xs">
                <span class="text-caption text-muted uppercase tracking-wider text-[11px] block mb-1">{t('page.primaryRisk')}</span>
                <strong class="text-signature-coral text-[15px] font-semibold">{data.keyRisk || (data.warnings && data.warnings[0]) || data.specific_warning}</strong>
              </div>
              <div class="bg-canvas/60 border border-hairline rounded-md p-4 shadow-xs">
                <span class="text-caption text-muted uppercase tracking-wider text-[11px] block mb-1">{t('page.safetyInstruction')}</span>
                <strong class="text-success text-[15px] font-semibold">{data.tip || (data.tips && data.tips[0]) || (data.instructions && data.instructions[0])}</strong>
              </div>
            </div>
            <div class="border-t border-hairline my-4 opacity-50"></div>
            <div class="mt-6 text-body-md text-body leading-relaxed">
              <h3 class="text-caption text-muted uppercase tracking-wider text-[11px] mb-3">{t('page.detailedExplanation')}</h3>
              {data.learnMore && <p class="mb-4 font-medium">{data.learnMore}</p>}
              {data.reason.split('\n\n').map((para: string) => (
                <p class="mb-4 last:mb-0">
                  {para}
                </p>
              ))}
            </div>
          </div>
        ) : (
          <div>
            <div class="border-t border-hairline my-4 opacity-50"></div>
            <h3 class="text-caption text-muted mb-2">{t('page.detailedExplanation')}</h3>
            {data.reason.split('\n\n').map((para: string) => (
              <p class="text-body-md text-body leading-relaxed mb-4 last:mb-0">
                {para}
              </p>
            ))}
          </div>
        )}
      </div>
    </section>

    <!-- All-Appliance Quick Switcher (Matrix Pills) -->
    {siblingApplianceItems.length > 0 && (
      <section class="mb-12 bg-surface-soft border border-hairline rounded-lg p-5 shadow-xs">
        <div class="flex items-center justify-between mb-3">
          <span class="text-caption text-ink font-semibold text-[13px] inline-flex items-center gap-2">
            <span>🔄</span> {t('action.otherAppliances')}
          </span>
          <span class="text-[11px] text-muted">{siblingApplianceItems.length + 1} {lang === 'es' ? 'electrodomésticos' : lang === 'pt' ? 'eletrodomésticos' : lang === 'zh-cn' ? '个电器' : lang === 'ja' ? '家電' : 'appliances'}</span>
        </div>
        <div class="flex flex-wrap gap-2.5">
          <!-- Current Appliance (Active) -->
          <span class="px-3.5 py-2 rounded-md text-xs font-semibold bg-canvas text-ink border-2 border-primary shadow-xs inline-flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-primary"></span>
            {formattedAppliance} ({formattedAnswer})
          </span>

          <!-- Sibling Appliances -->
          {siblingApplianceItems.map((sibling: any) => {
            const sibAppKey = `appliance.${sibling.appliance}` as any;
            const sibFormatted = t(sibAppKey) || (sibling.appliance.charAt(0).toUpperCase() + sibling.appliance.slice(1));
            const sibUrl = translatePath(`/${sibling.appliance}/${sibling.slug}/`);
            return (
              <a
                href={sibUrl}
                class={`px-3.5 py-2 rounded-md text-xs font-medium border transition-all hover:scale-105 active:scale-95 inline-flex items-center gap-1.5 shadow-2xs ${
                  sibling.safe === 'yes' ? 'bg-success-bg/80 text-success border-success-border/40 hover:bg-success-bg' :
                  sibling.safe === 'no' ? 'bg-error-bg/80 text-error border-error-border/40 hover:bg-error-bg' :
                  'bg-warning-bg/80 text-warning border-warning-border/40 hover:bg-warning-bg'
