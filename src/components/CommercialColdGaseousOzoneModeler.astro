    presetBakery: "乾燥製パン無菌カートン表面殺菌 (セラミックDBD, 160 ppm, 35秒, 82% RH, セレウス菌)",
    presetCitrus: "柑橘・ベリー類収穫後カビ抑制 (光化学UV, 45 ppm, 60秒, 86% RH, 緑かび病菌)",
    presetPoultry: "生鶏肉用プラスチックモジュールベルト衛生 (電暈放電, 120 ppm, 75秒, 88% RH, クロストリジウム)",
    presetGrain: "製粉・穀物高負荷胞子汚染コンベア (セラミックDBD, 200 ppm, 45秒, 85% RH, 黒麹カビ)",
    presetHazard: "亀裂石英管による重度オゾン漏洩事故 (破損石英管, 飽和活性炭, 25 ppm, 15秒, 40% RH)",
    diagnosticTitle: "オゾン酸化速度論・芽胞殺滅率・作業環境安全診断",
    diagnosticSub: "CT曝露量（ppm · min）、芽胞対数殺滅率（Log10）、湿度膨潤活性化係数、触媒分解効率、作業場漏洩オゾン濃度、ベルトオゾンクラック応力指数をリアルタイム算出。",
    ctValueLabel: "有効 CT 曝露量 (ppm · min)",
    logReductionLabel: "対象芽胞対数殺滅率 (Log10)",
    rhActivationLabel: "湿度芽胞膨潤活性化係数",
    destructEfficiencyLabel: "排オゾン触媒分解効率",
    ambientFugitiveLabel: "作業環境漏洩オゾン濃度",
    beltDegradationLabel: "コンベアベルトオゾン劣化応力",
    complianceStatusLabel: "衛生規格適合性および OSHA 安全基準",
    primaryLimitationLabel: "主要速度論および環境制約",
    mitigationActionLabel: "推奨衛生工学対策",
    scienceTitle: "気体オゾン芽胞殺滅機構・ラジカル物理学・ホプカライト触媒",
    scienceSub: "修正Chick-Watson酸化動力学、高湿度による芽胞殻膨潤とラジカル浸透、Hopcalite（MnO2-CuO）触媒分解反応、OSHA作業環境基準の技術的解説。",
    tableTitle: "連続気体オゾン発生器およびコンベア材質技術仕様一覧"
  }
};

const d = DICT[lang];
---

<div class="bg-surface border border-hairline rounded-3xl p-6 sm:p-10 shadow-xs mb-12">
  <!-- Header Badge & Title -->
  <div class="mb-8">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-cyan-100 text-cyan-900 mb-3 border border-cyan-200">
      <span class="w-2 h-2 rounded-full bg-cyan-600 animate-pulse"></span>
      {d.badge}
    </div>
    <h1 class="text-2xl sm:text-3xl font-bold text-ink tracking-tight mb-3">
      {d.title}
    </h1>
    <p class="text-body text-sm sm:text-base leading-relaxed max-w-4xl">
      {d.subtitle}
    </p>
  </div>

  <!-- Presets -->
  <div class="mb-8 p-4 bg-surface-soft border border-hairline rounded-2xl">
    <span class="block text-xs font-bold text-ink uppercase tracking-wider mb-2">
      {d.presetsTitle}
    </span>
    <div class="flex flex-wrap gap-2">
      <button
        type="button"
        id="preset-bakery"
        class="px-3 py-1.5 rounded-lg text-xs font-medium bg-surface border border-hairline hover:bg-surface-soft hover:border-cyan-600 text-ink transition-colors cursor-pointer"
      >
        🍞 {d.presetBakery}
      </button>
      <button
        type="button"
        id="preset-citrus"
        class="px-3 py-1.5 rounded-lg text-xs font-medium bg-surface border border-hairline hover:bg-surface-soft hover:border-cyan-600 text-ink transition-colors cursor-pointer"
      >
        🍊 {d.presetCitrus}
      </button>
      <button
        type="button"
        id="preset-poultry"
        class="px-3 py-1.5 rounded-lg text-xs font-medium bg-surface border border-hairline hover:bg-surface-soft hover:border-cyan-600 text-ink transition-colors cursor-pointer"
      >
        🍗 {d.presetPoultry}
      </button>
      <button
        type="button"
        id="preset-grain"
        class="px-3 py-1.5 rounded-lg text-xs font-medium bg-surface border border-hairline hover:bg-surface-soft hover:border-cyan-600 text-ink transition-colors cursor-pointer"
      >
        🌾 {d.presetGrain}
      </button>
      <button
        type="button"
        id="preset-hazard"
        class="px-3 py-1.5 rounded-lg text-xs font-medium bg-red-50 border border-red-200 hover:bg-red-100 text-red-900 transition-colors cursor-pointer"
      >
        ⚠️ {d.presetHazard}
      </button>
    </div>
  </div>

  <!-- Interactive Grid: Controls & Diagnostics -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-10">
    <!-- Controls Column (5 cols) -->
    <div class="lg:col-span-5 space-y-5">
      <div class="bg-surface-soft border border-hairline rounded-2xl p-5">
        <h2 class="text-sm font-bold text-ink uppercase tracking-wider mb-1">
          {d.controlsTitle}
        </h2>
        <p class="text-xs text-muted mb-4">
          {d.controlsSub}
        </p>

        <div class="space-y-4">
          <!-- Ozone Plasma Generator -->
          <div>
            <label for="ozone-generator" class="block font-semibold text-ink text-xs mb-1">
              {d.generatorLabel}
            </label>
            <select
              id="ozone-generator"
              class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-xs text-ink focus:outline-hidden focus:ring-2 focus:ring-cyan-600"
            >
              {ozoneData.ozoneGenerators.map(g => (
                <option value={g.id}>{g.name}</option>
              ))}
            </select>
            <span class="block text-2xs text-muted mt-1 leading-tight">{d.generatorHelp}</span>
          </div>

          <!-- Conveyor Substrate -->
          <div>
            <label for="ozone-substrate" class="block font-semibold text-ink text-xs mb-1">
              {d.substrateLabel}
            </label>
            <select
              id="ozone-substrate"
              class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-xs text-ink focus:outline-hidden focus:ring-2 focus:ring-cyan-600"
            >
              {ozoneData.conveyorSubstrates.map(s => (
                <option value={s.id}>{s.name}</option>
              ))}
            </select>
            <span class="block text-2xs text-muted mt-1 leading-tight">{d.substrateHelp}</span>
          </div>

          <!-- Target Microorganism -->
          <div>
            <label for="ozone-microorganism" class="block font-semibold text-ink text-xs mb-1">
              {d.microorganismLabel}
            </label>
            <select
              id="ozone-microorganism"
              class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-xs text-ink focus:outline-hidden focus:ring-2 focus:ring-cyan-600"
            >
              {ozoneData.targetMicroorganisms.map(m => (
                <option value={m.id}>{m.name}</option>
              ))}
            </select>
            <span class="block text-2xs text-muted mt-1 leading-tight">{d.microorganismHelp}</span>
          </div>

          <!-- Off-Gas Destruction -->
          <div>
            <label for="ozone-destruct" class="block font-semibold text-ink text-xs mb-1">
              {d.destructLabel}
            </label>
            <select
              id="ozone-destruct"
              class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-xs text-ink focus:outline-hidden focus:ring-2 focus:ring-cyan-600"
            >
              {ozoneData.offGasDestructionSystems.map(cat => (
                <option value={cat.id}>{cat.name}</option>
              ))}
            </select>
            <span class="block text-2xs text-muted mt-1 leading-tight">{d.destructHelp}</span>
          </div>

          <!-- Sliders -->
          <!-- Ozone Concentration (ppm) -->
          <div class="pt-2 border-t border-hairline/60">
            <div class="flex justify-between items-center mb-1">
              <label for="slider-ozone-conc" class="font-semibold text-ink text-xs">
                {d.ozoneConcLabel}
              </label>
              <span id="val-ozone-conc" class="font-mono text-xs font-bold text-cyan-800 bg-cyan-50 px-2 py-0.5 rounded-md">
                160 ppm
              </span>
            </div>
            <input
              type="range"
              id="slider-ozone-conc"
              min="10"
              max="250"
              step="5"
              value="160"
              class="w-full accent-cyan-700 cursor-pointer"
            />
            <span class="block text-2xs text-muted mt-0.5">{d.ozoneConcHelp}</span>
          </div>

          <!-- Contact Residence Time (seconds) -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label for="slider-residence-time" class="font-semibold text-ink text-xs">
                {d.residenceTimeLabel}
              </label>
              <span id="val-residence-time" class="font-mono text-xs font-bold text-cyan-800 bg-cyan-50 px-2 py-0.5 rounded-md">
                35 s
              </span>
            </div>
            <input
              type="range"
              id="slider-residence-time"
              min="5"
              max="180"
              step="5"
              value="35"
              class="w-full accent-cyan-700 cursor-pointer"
            />
            <span class="block text-2xs text-muted mt-0.5">{d.residenceTimeHelp}</span>
          </div>

          <!-- Relative Humidity (% RH) -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label for="slider-humidity" class="font-semibold text-ink text-xs">
                {d.humidityLabel}
              </label>
              <span id="val-humidity" class="font-mono text-xs font-bold text-cyan-800 bg-cyan-50 px-2 py-0.5 rounded-md">
                82 % RH
              </span>
            </div>
            <input
              type="range"
              id="slider-humidity"
              min="30"
              max="95"
              step="1"
              value="82"
              class="w-full accent-cyan-700 cursor-pointer"
            />
            <span class="block text-2xs text-muted mt-0.5">{d.humidityHelp}</span>
          </div>

          <!-- Linear Belt Velocity (m/min) -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label for="slider-belt-speed" class="font-semibold text-ink text-xs">
                {d.beltSpeedLabel}
              </label>
              <span id="val-belt-speed" class="font-mono text-xs font-bold text-cyan-800 bg-cyan-50 px-2 py-0.5 rounded-md">
                6.0 m/min
              </span>
            </div>
            <input
              type="range"
              id="slider-belt-speed"
              min="1.0"
              max="25.0"
              step="0.5"
              value="6.0"
              class="w-full accent-cyan-700 cursor-pointer"
            />
            <span class="block text-2xs text-muted mt-0.5">{d.beltSpeedHelp}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Diagnostics Column (7 cols) -->
    <div class="lg:col-span-7 space-y-5">
      <div class="bg-surface-soft border border-hairline rounded-2xl p-5">
        <h2 class="text-sm font-bold text-ink uppercase tracking-wider mb-1">
          {d.diagnosticTitle}
        </h2>
        <p class="text-xs text-muted mb-4">
          {d.diagnosticSub}
        </p>

        <!-- Metric Cards Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-5">
          <!-- CT Value -->
          <div class="bg-surface border border-hairline rounded-xl p-4">
            <span class="block text-2xs font-semibold uppercase text-muted tracking-wider mb-1">
              {d.ctValueLabel}
            </span>
            <div id="metric-ct-value" class="text-xl sm:text-2xl font-mono font-bold text-cyan-800">
              93.3 ppm·min
            </div>
            <span id="sub-ct-value" class="text-2xs text-muted block mt-1">
              Optimal Spore Oxidation Range (>80 ppm·min)
            </span>
          </div>

          <!-- Spore Log10 Reduction -->
          <div class="bg-surface border border-hairline rounded-xl p-4">
            <span class="block text-2xs font-semibold uppercase text-muted tracking-wider mb-1">
              {d.logReductionLabel}
            </span>
            <div id="metric-log-reduction" class="text-xl sm:text-2xl font-mono font-bold text-emerald-700">
              4.62 log₁₀
            </div>
            <span id="sub-log-reduction" class="text-2xs text-muted block mt-1">
              >99.99% Microbial Lethality Met
            </span>
          </div>

          <!-- Humidity Activation -->
          <div class="bg-surface border border-hairline rounded-xl p-4">
            <span class="block text-2xs font-semibold uppercase text-muted tracking-wider mb-1">
              {d.rhActivationLabel}
            </span>
            <div id="metric-rh-factor" class="text-xl sm:text-2xl font-mono font-bold text-cyan-800">
              1.18x (High)
            </div>
            <span id="sub-rh-factor" class="text-2xs text-muted block mt-1">
              Spore Coat Swelling Active (>80% RH)
            </span>
          </div>

          <!-- Off-Gas Destruct Efficiency -->
          <div class="bg-surface border border-hairline rounded-xl p-4">
            <span class="block text-2xs font-semibold uppercase text-muted tracking-wider mb-1">
              {d.destructEfficiencyLabel}
            </span>
            <div id="metric-destruct-eff" class="text-xl sm:text-2xl font-mono font-bold text-emerald-700">
              99.98 %
            </div>
            <span id="sub-destruct-eff" class="text-2xs text-muted block mt-1">
              Hopcalite MnO₂-CuO Honeycomb (<0.02 ppm exhaust)
            </span>
          </div>

          <!-- Fugitive Workplace Concentration -->
          <div class="bg-surface border border-hairline rounded-xl p-4">
            <span class="block text-2xs font-semibold uppercase text-muted tracking-wider mb-1">
              {d.ambientFugitiveLabel}
            </span>
            <div id="metric-fugitive-ozone" class="text-xl sm:text-2xl font-mono font-bold text-emerald-700">
              0.03 ppm
            </div>
            <span id="sub-fugitive-ozone" class="text-2xs text-muted block mt-1">
              Complies with OSHA PEL (<0.10 ppm 8-hr TWA)
            </span>
          </div>

          <!-- Conveyor Belt Ozonolysis Stress -->
          <div class="bg-surface border border-hairline rounded-xl p-4">
            <span class="block text-2xs font-semibold uppercase text-muted tracking-wider mb-1">
              {d.beltDegradationLabel}
            </span>
            <div id="metric-belt-stress" class="text-xl sm:text-2xl font-mono font-bold text-cyan-800">
              Low (Grade A)
            </div>
            <span id="sub-belt-stress" class="text-2xs text-muted block mt-1">
              Expected Belt Service Life: >4,500 Operating Hours
            </span>
          </div>
        </div>

        <!-- Compliance & Engineering Status -->
        <div class="bg-surface border border-hairline rounded-xl p-4 space-y-3">
          <div class="flex items-center justify-between pb-2 border-b border-hairline">
            <span class="text-xs font-semibold text-ink">{d.complianceStatusLabel}</span>
            <span id="badge-compliance" class="px-2.5 py-0.5 rounded-full text-2xs font-bold bg-emerald-100 text-emerald-800">
              FULLY COMPLIANT (OSHA & FDA 21 CFR § 173.368)
            </span>
          </div>

          <div class="text-xs space-y-2">
            <div>
              <span class="font-bold text-ink block mb-0.5">{d.primaryLimitationLabel}</span>
              <p id="limitation-text" class="text-muted leading-relaxed">
                Relative humidity (82% RH) ensures rapid spore coat swelling and hydroxyl radical penetration. Chamber negative pressure prevents workplace fugitive leakage.
              </p>
            </div>
            <div>
              <span class="font-bold text-ink block mb-0.5">{d.mitigationActionLabel}</span>
              <p id="mitigation-text" class="text-muted leading-relaxed">
                Maintain catalytic bed temperature above 60°C to prevent moisture condensation. Verify ambient ambient electro-chemical ozone sensor calibration monthly.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Deep Engineering Science Section -->
  <div class="border-t border-hairline pt-10 mb-12">
    <div class="max-w-3xl mb-8">
      <h2 class="text-xl sm:text-2xl font-bold text-ink tracking-tight">
        {d.scienceTitle}
      </h2>
      <p class="text-body text-sm mt-2 leading-relaxed">
        {d.scienceSub}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-sm">
      <div class="bg-surface-soft border border-hairline rounded-2xl p-6">
        <div class="w-8 h-8 rounded-lg bg-cyan-100 text-cyan-800 font-bold flex items-center justify-center mb-4 text-sm font-mono">
          01
        </div>
        <h3 class="font-bold text-ink text-base mb-2">
          Chick-Watson CT Spore Lethality &amp; Dipicolinic Acid Oxidation
        </h3>
        <p class="text-body text-xs leading-relaxed mb-3">
          Microbial spore disinfection kinetics follow the integrated Chick-Watson exposure model:
        </p>
        <div class="bg-surface border border-hairline rounded-xl p-3 font-mono text-2xs text-ink mb-3 overflow-x-auto">
          Log₁₀(N₀ / N) = k · (C_ozone)^n · t · f_RH · f_sub
        </div>
        <p class="text-muted text-xs leading-relaxed">
          Gaseous ozone (<span class="font-mono text-ink">O₃</span>) oxidizes outer coat cysteine and dipicolinic acid (<span class="font-mono text-ink">DPA</span>) core complexes. Bacterial endospores (<span class="italic text-ink">C. botulinum</span>, <span class="italic text-ink">B. cereus</span>) require high CT thresholds (<span class="font-semibold text-ink">&gt;80 ppm·min</span>) compared to vegetative pathogens.
        </p>
      </div>

      <div class="bg-surface-soft border border-hairline rounded-2xl p-6">
        <div class="w-8 h-8 rounded-lg bg-cyan-100 text-cyan-800 font-bold flex items-center justify-center mb-4 text-sm font-mono">
          02
        </div>
        <h3 class="font-bold text-ink text-base mb-2">
          Relative Humidity Spore Coat Hydration &amp; Free Radical Cascade
        </h3>
        <p class="text-body text-xs leading-relaxed mb-3">
          Dry endospores are highly impermeable to dry gaseous ozone below 50% RH:
        </p>
        <div class="bg-surface border border-hairline rounded-xl p-3 font-mono text-2xs text-ink mb-3 overflow-x-auto">
          O₃(g) + H₂O(film) → •OH + •O₂⁻ + O₂  (at RH &gt; 80%)
        </div>
        <p class="text-muted text-xs leading-relaxed">
          Elevated chamber relative humidity (<span class="font-semibold text-ink">&gt;80% RH</span>) rehydrates and swells dense spore coats, dissolving gaseous ozone into the condensed surface nanolayer to unleash short-lived hydroxyl (<span class="font-mono text-ink">•OH</span>) and superoxide radicals for irreversible wall rupture.
        </p>
      </div>

      <div class="bg-surface-soft border border-hairline rounded-2xl p-6">
        <div class="w-8 h-8 rounded-lg bg-cyan-100 text-cyan-800 font-bold flex items-center justify-center mb-4 text-sm font-mono">
          03
        </div>
        <h3 class="font-bold text-ink text-base mb-2">
          Hopcalite MnO₂-CuO Catalysis &amp; OSHA 29 CFR § 1910.1000 Compliance
        </h3>
        <p class="text-body text-xs leading-relaxed mb-3">
          Exhaust gas contains residual ozone that must be destroyed prior to atmospheric release:
        </p>
        <div class="bg-surface border border-hairline rounded-xl p-3 font-mono text-2xs text-ink mb-3 overflow-x-auto">
          2 O₃ + [MnO₂-CuO Catalyst] → 3 O₂ + ΔH_exothermic
        </div>
        <p class="text-muted text-xs leading-relaxed">
          Hopcalite catalytic beds operate at space velocities up to <span class="font-semibold text-ink">25,000 h⁻¹</span>, converting ozone with <span class="font-semibold text-ink">&gt;99.98% efficiency</span>. Negative pressure containment (<span class="font-mono text-ink">ΔP &lt; -25 Pa</span>) ensures workplace concentrations remain strictly below the OSHA PEL (<span class="font-semibold text-ink">&lt;0.10 ppm 8-hr TWA</span>).
        </p>
      </div>
    </div>
  </div>

  <!-- Technical Specs Reference Table -->
  <div class="border-t border-hairline pt-8">
    <h3 class="text-sm font-bold text-ink uppercase tracking-wider mb-4">
      {d.tableTitle}
    </h3>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs border border-hairline rounded-xl overflow-hidden">
        <thead class="bg-surface-soft text-muted font-bold border-b border-hairline">
          <tr>
            <th class="p-3">Ozone Generator Model</th>
            <th class="p-3">Feed Gas Type</th>
            <th class="p-3">Max Output (ppm)</th>
            <th class="p-3">Dielectric Material</th>
            <th class="p-3">NOx Byproduct</th>
            <th class="p-3">Safety &amp; Sanitation Standard</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline">
          {ozoneData.ozoneGenerators.map(g => (
            <tr class="hover:bg-surface-soft/50 transition-colors">
              <td class="p-3 font-semibold text-ink">{g.name}</td>
              <td class="p-3 text-muted">{g.feedGasType}</td>
              <td class="p-3 font-mono font-semibold text-cyan-800">{g.maxOzoneOutputPpm} ppm</td>
              <td class="p-3 font-mono">{g.dielectricMaterial}</td>
              <td class="p-3 font-mono">{g.noxByproductRatioPercent}%</td>
              <td class="p-3 text-2xs text-muted">{g.classification}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</div>

<script is:inline define:vars={{ ozoneData }}>
  document.addEventListener('DOMContentLoaded', () => {
    // Select Elements
    const selGenerator = document.getElementById('ozone-generator');
    const selSubstrate = document.getElementById('ozone-substrate');
    const selMicroorganism = document.getElementById('ozone-microorganism');
    const selDestruct = document.getElementById('ozone-destruct');

    // Sliders
    const sliderOzoneConc = document.getElementById('slider-ozone-conc');
    const sliderResidenceTime = document.getElementById('slider-residence-time');
    const sliderHumidity = document.getElementById('slider-humidity');
    const sliderBeltSpeed = document.getElementById('slider-belt-speed');

    // Value Badges
    const valOzoneConc = document.getElementById('val-ozone-conc');
    const valResidenceTime = document.getElementById('val-residence-time');
    const valHumidity = document.getElementById('val-humidity');
    const valBeltSpeed = document.getElementById('val-belt-speed');

    // Diagnostic Metrics
    const metricCtValue = document.getElementById('metric-ct-value');
    const subCtValue = document.getElementById('sub-ct-value');
    const metricLogReduction = document.getElementById('metric-log-reduction');
    const subLogReduction = document.getElementById('sub-log-reduction');
    const metricRhFactor = document.getElementById('metric-rh-factor');
    const subRhFactor = document.getElementById('sub-rh-factor');
    const metricDestructEff = document.getElementById('metric-destruct-eff');
    const subDestructEff = document.getElementById('sub-destruct-eff');
    const metricFugitiveOzone = document.getElementById('metric-fugitive-ozone');
    const subFugitiveOzone = document.getElementById('sub-fugitive-ozone');
    const metricBeltStress = document.getElementById('metric-belt-stress');
    const subBeltStress = document.getElementById('sub-belt-stress');

    // Compliance & Notes
    const badgeCompliance = document.getElementById('badge-compliance');
    const limitationText = document.getElementById('limitation-text');
    const mitigationText = document.getElementById('mitigation-text');

    // Preset Buttons
    const btnBakery = document.getElementById('preset-bakery');
    const btnCitrus = document.getElementById('preset-citrus');
    const btnPoultry = document.getElementById('preset-poultry');
    const btnGrain = document.getElementById('preset-grain');
    const btnHazard = document.getElementById('preset-hazard');

    function calculateDiagnostics() {
      if (!selGenerator || !selSubstrate || !selMicroorganism || !selDestruct) return;

      const genId = selGenerator.value;
      const subId = selSubstrate.value;
      const orgId = selMicroorganism.value;
      const desId = selDestruct.value;

      const generator = ozoneData.ozoneGenerators.find(g => g.id === genId) || ozoneData.ozoneGenerators[0];
      const substrate = ozoneData.conveyorSubstrates.find(s => s.id === subId) || ozoneData.conveyorSubstrates[0];
      const organism = ozoneData.targetMicroorganisms.find(o => o.id === orgId) || ozoneData.targetMicroorganisms[0];
      const destruct = ozoneData.offGasDestructionSystems.find(d => d.id === desId) || ozoneData.offGasDestructionSystems[0];

      let ozonePpm = parseFloat(sliderOzoneConc.value);
      const residenceSeconds = parseFloat(sliderResidenceTime.value);
      const humidityRh = parseFloat(sliderHumidity.value);
      const beltSpeed = parseFloat(sliderBeltSpeed.value);

      // Generator max output clamp
      if (ozonePpm > generator.maxOzoneOutputPpm) {
        ozonePpm = generator.maxOzoneOutputPpm;
      }

      valOzoneConc.textContent = `${ozonePpm.toFixed(0)} ppm`;
      valResidenceTime.textContent = `${residenceSeconds.toFixed(0)} s`;
      valHumidity.textContent = `${humidityRh.toFixed(0)} % RH`;
      valBeltSpeed.textContent = `${beltSpeed.toFixed(1)} m/min`;

      // 1. CT Exposure Value (ppm · min)
      const residenceMinutes = residenceSeconds / 60.0;
      const ctValue = ozonePpm * residenceMinutes;

      // 2. Relative Humidity Activation Factor
      // Dry spore coats impermeable < 50% RH. Sharp sigmoidal jump > 75-80% RH
      let rhFactor = 0.15;
      if (humidityRh >= 85) {
        rhFactor = 1.0 + (humidityRh - 85) * 0.02; // Up to ~1.20
      } else if (humidityRh >= 75) {
        rhFactor = 0.75 + (humidityRh - 75) * 0.025; // 0.75 to 1.0
      } else if (humidityRh >= 55) {
        rhFactor = 0.35 + (humidityRh - 55) * 0.02; // 0.35 to 0.75
      } else {
        rhFactor = 0.15 + (humidityRh - 30) * 0.008; // 0.15 to 0.35
      }

      // 3. Substrate Quenching / Organic Load Factor
      const substrateFactor = substrate.materialCompatibilityScore / 100.0;

      // 4. Pathogen Log10 Reduction
      // Log10 = (CT / D_value) * rhFactor * substrateFactor
      let logReduction = (ctValue / organism.dValueCtPpmMin) * rhFactor * (0.65 + 0.35 * substrateFactor);

      // Generator penalty if leaking or degraded
      if (generator.id === 'compromised_leaking_quartz_generator') {
        logReduction *= 0.35;
      }

      if (logReduction > 7.5) logReduction = 7.5;
      if (logReduction < 0.05) logReduction = 0.05;

      // 5. Off-Gas Destruct & Fugitive Emission
      let destructEff = destruct.destructionEfficiencyPercent;
      let exhaustResidualPpm = (ozonePpm * (100.0 - destructEff)) / 100.0;

      // Fugitive workplace ambient estimate
      // Based on negative pressure seal and exhaust efficiency
      let fugitivePpm = 0.01 + (exhaustResidualPpm * 0.04);
      if (generator.id === 'compromised_leaking_quartz_generator') {
        fugitivePpm += 0.85; // Massive housing seal breach
      }
      if (destruct.id === 'compromised_bypass_carbon_bed') {
        fugitivePpm += 0.45; // Bypass duct breakthrough
      }

      // 6. Belt Ozonolysis Stress
      let beltStressScore = (ozonePpm * residenceMinutes * 0.8) / (substrate.materialCompatibilityScore || 50);
      if (subId === 'degraded_neoprene_rubber_belt') beltStressScore *= 4.5;

      // Update UI Metrics
      metricCtValue.textContent = `${ctValue.toFixed(1)} ppm·min`;
      if (ctValue >= organism.dValueCtPpmMin * 1.5) {
        metricCtValue.className = 'text-xl sm:text-2xl font-mono font-bold text-cyan-800';
        subCtValue.textContent = `Exceeds target spore D-value (${organism.dValueCtPpmMin} ppm·min)`;
      } else {
        metricCtValue.className = 'text-xl sm:text-2xl font-mono font-bold text-amber-700';
        subCtValue.textContent = `Marginal CT exposure for ${organism.name.split(' ')[0]}`;
      }

      metricLogReduction.textContent = `${logReduction.toFixed(2)} log₁₀`;
      if (logReduction >= organism.targetLog10Reduction) {
        metricLogReduction.className = 'text-xl sm:text-2xl font-mono font-bold text-emerald-700';
        subLogReduction.textContent = `Exceeds target ${organism.targetLog10Reduction} log₁₀ lethality requirement`;
      } else {
        metricLogReduction.className = 'text-xl sm:text-2xl font-mono font-bold text-red-600';
        subLogReduction.textContent = `Under-lethal! Needs ${organism.targetLog10Reduction} log₁₀ reduction`;
      }

      metricRhFactor.textContent = `${rhFactor.toFixed(2)}x (${humidityRh >= 80 ? 'Optimal' : (humidityRh >= 70 ? 'Moderate' : 'Deficient')})`;
      if (humidityRh >= 80) {
        metricRhFactor.className = 'text-xl sm:text-2xl font-mono font-bold text-cyan-800';
        subRhFactor.textContent = 'Spore coat fully hydrated; rapid hydroxyl oxidation active';
      } else {
        metricRhFactor.className = 'text-xl sm:text-2xl font-mono font-bold text-amber-700';
        subRhFactor.textContent = 'Dry spore coat inhibits ozone penetration (<80% RH)';
      }

      metricDestructEff.textContent = `${destructEff.toFixed(2)} %`;
      if (destructEff >= 99.9) {
        metricDestructEff.className = 'text-xl sm:text-2xl font-mono font-bold text-emerald-700';
        subDestructEff.textContent = `${destruct.catalystType.split('(')[0].trim()}`;
      } else {
        metricDestructEff.className = 'text-xl sm:text-2xl font-mono font-bold text-red-600';
        subDestructEff.textContent = 'High breakthrough risk; non-compliant exhaust';
      }

      metricFugitiveOzone.textContent = `${fugitivePpm.toFixed(3)} ppm`;
      if (fugitivePpm <= 0.05) {
        metricFugitiveOzone.className = 'text-xl sm:text-2xl font-mono font-bold text-emerald-700';
        subFugitiveOzone.textContent = 'Meets ACGIH TLV (<0.05 ppm) & OSHA PEL (<0.10 ppm)';
      } else if (fugitivePpm <= 0.10) {
        metricFugitiveOzone.className = 'text-xl sm:text-2xl font-mono font-bold text-amber-700';
        subFugitiveOzone.textContent = 'Approaching OSHA PEL ceiling limit (0.10 ppm)';
      } else {
        metricFugitiveOzone.className = 'text-xl sm:text-2xl font-mono font-bold text-red-600 animate-pulse';
        subFugitiveOzone.textContent = 'HAZARDOUS BREACH: Exceeds OSHA 29 CFR § 1910.1000 PEL!';
      }

      if (beltStressScore < 1.0) {
        metricBeltStress.textContent = 'Low (Grade A)';
        metricBeltStress.className = 'text-xl sm:text-2xl font-mono font-bold text-cyan-800';
        subBeltStress.textContent = 'Expected service life: >5,000 continuous hours';
      } else if (beltStressScore < 2.5) {
        metricBeltStress.textContent = 'Moderate (Grade B)';
        metricBeltStress.className = 'text-xl sm:text-2xl font-mono font-bold text-amber-700';
        subBeltStress.textContent = 'Monitor belt surface microcracking at 1,500-hour CIP';
      } else {
        metricBeltStress.textContent = 'CRITICAL (Grade D)';
        metricBeltStress.className = 'text-xl sm:text-2xl font-mono font-bold text-red-600';
        subBeltStress.textContent = 'Rapid elastomeric chain scission; replace with Intralox PP belt';
      }

      // Compliance and Guidance Update
      if (fugitivePpm > 0.10 || generator.id === 'compromised_leaking_quartz_generator' || destruct.id === 'compromised_bypass_carbon_bed') {
        badgeCompliance.textContent = 'NON-COMPLIANT (OSHA 1910.1000 PEL EXCEEDED)';
        badgeCompliance.className = 'px-2.5 py-0.5 rounded-full text-2xs font-bold bg-red-100 text-red-800';
        limitationText.textContent = 'Occupational safety breach: Fugitive gaseous ozone concentrations exceed OSHA permissible exposure limits (0.10 ppm 8-hr TWA), creating severe respiratory health risks.';
        mitigationActionLabel.textContent = 'Emergency Shutdown & Engineering Action';
        mitigationText.textContent = 'Halt conveyor immediately. Inspect quartz dielectric seals, verify tunnel negative differential pressure (ΔP < -25 Pa), and recharge Hopcalite MnO2-CuO catalytic bed.';
      } else if (logReduction < organism.targetLog10Reduction) {
        badgeCompliance.textContent = 'SUB-LETHAL SANITATION (INCREASE CT / RH)';
        badgeCompliance.className = 'px-2.5 py-0.5 rounded-full text-2xs font-bold bg-amber-100 text-amber-800';
        limitationText.textContent = `Inactivation deficit: Calculated log10 reduction (${logReduction.toFixed(2)}) fails target ${organism.targetLog10Reduction} log10 specification for ${organism.name.split(' ')[0]}.`;
        mitigationText.textContent = 'Increase chamber relative humidity to >82% to facilitate spore coat hydration, or reduce belt speed to extend contact residence time.';
      } else {
        badgeCompliance.textContent = 'FULLY COMPLIANT (OSHA & FDA 21 CFR § 173.368)';
        badgeCompliance.className = 'px-2.5 py-0.5 rounded-full text-2xs font-bold bg-emerald-100 text-emerald-800';
        limitationText.textContent = `Validated lethality achieved (${logReduction.toFixed(2)} log10). Relative humidity (${humidityRh}% RH) provides optimal spore coat hydration without moisture puddling.`;
        mitigationText.textContent = 'Maintain steady gas flow rate, monitor catalytic destruct inlet temperature, and verify weekly automated ambient electrochemical ozone sensor calibration.';
      }
    }

    // Attach listeners
    [selGenerator, selSubstrate, selMicroorganism, selDestruct].forEach(el => {
      if (el) el.addEventListener('change', calculateDiagnostics);
    });

    [sliderOzoneConc, sliderResidenceTime, sliderHumidity, sliderBeltSpeed].forEach(sl => {
      if (sl) sl.addEventListener('input', calculateDiagnostics);
    });

    // Preset handlers
    if (btnBakery) {
      btnBakery.addEventListener('click', () => {
        selGenerator.value = 'ceramic_dbd_plasma_generator';
        selSubstrate.value = 'bakery_carton_packaging_sleeve';
        selMicroorganism.value = 'bacillus_cereus_endospores';
        selDestruct.value = 'hopcalite_catalytic_destructor';
        sliderOzoneConc.value = '160';
        sliderResidenceTime.value = '35';
        sliderHumidity.value = '82';
        sliderBeltSpeed.value = '6.0';
        calculateDiagnostics();
      });
    }

    if (btnCitrus) {
      btnCitrus.addEventListener('click', () => {
        selGenerator.value = 'dual_wavelength_photochemical_uv_generator';
        selSubstrate.value = 'post_harvest_berry_citrus_fruit';
        selMicroorganism.value = 'penicillium_digitatum_citrus_mold';
        selDestruct.value = 'hopcalite_catalytic_destructor';
        sliderOzoneConc.value = '45';
        sliderResidenceTime.value = '60';
        sliderHumidity.value = '86';
        sliderBeltSpeed.value = '4.0';
        calculateDiagnostics();
      });
    }

    if (btnPoultry) {
      btnPoultry.addEventListener('click', () => {
        selGenerator.value = 'tubular_corona_dry_air_generator';
        selSubstrate.value = 'fresh_poultry_meat_polypropylene_belt';
        selMicroorganism.value = 'clostridium_botulinum_spores';
        selDestruct.value = 'thermal_dissociation_oxidizer';
        sliderOzoneConc.value = '120';
        sliderResidenceTime.value = '75';
        sliderHumidity.value = '88';
        sliderBeltSpeed.value = '3.5';
        calculateDiagnostics();
      });
    }

    if (btnGrain) {
      btnGrain.addEventListener('click', () => {
        selGenerator.value = 'ceramic_dbd_plasma_generator';
        selSubstrate.value = 'bakery_carton_packaging_sleeve';
        selMicroorganism.value = 'aspergillus_niger_conidia';
        selDestruct.value = 'hopcalite_catalytic_destructor';
        sliderOzoneConc.value = '200';
        sliderResidenceTime.value = '45';
        sliderHumidity.value = '85';
        sliderBeltSpeed.value = '5.0';
        calculateDiagnostics();
      });
    }

    if (btnHazard) {
      btnHazard.addEventListener('click', () => {
        selGenerator.value = 'compromised_leaking_quartz_generator';
        selSubstrate.value = 'degraded_neoprene_rubber_belt';
        selMicroorganism.value = 'aspergillus_niger_conidia';
        selDestruct.value = 'compromised_bypass_carbon_bed';
        sliderOzoneConc.value = '25';
        sliderResidenceTime.value = '15';
        sliderHumidity.value = '40';
        sliderBeltSpeed.value = '12.0';
        calculateDiagnostics();
      });
    }

    // Initial calculation
    calculateDiagnostics();
  });
</script>
