    systemHelp: "商用連続式 ASH-DD スキッド、チーズホエー廃スラッジ解離機、植物乳清澄化装置、研究用モジュール機から選択。",
    matrixLabel: "乳清流体原料＆エマルションマトリックス:",
    matrixHelp: "新鮮全乳生乳、工業用スイートバターミルク、チーズホエー遠心残渣、ヨーグルト酸性ホエー、酵素分解オーツ麦飲料原液から選択。",
    acousticLabel: "音響衝撃波＆チタン振動子ホーン構成:",
    acousticHelp: "対向型 28 kHz チタンホーン、40 kHz 収束メガソニックアレイ、ベンチュリ流体スリット複合型、未遮音過剰キャビテーション危険モードから選択。",
    separatorLabel: "遠心相分離ハイドロサイクロン構造:",
    separatorHelp: "3段式衛生型マイクロハイドロサイクロン群、向流2段式サイクロン、または滞留腐敗リスクを伴う無制御重力槽から選択。",
    pressureLabel: "チャンバー内流体圧力 (P_chamber):",
    pressureHelp: "音響キャビテーションホーン上流の流体静圧（10.0〜40.0 bar）。キャビテーション気泡圧壊時の微小噴流破壊力を決定。",
    powerLabel: "音響振動子入力電力 (P_acoustic):",
    powerHelp: "チタンホーンに印加される高周波超音波電力（5.0〜55.0 kW）。",
    freqLabel: "音響共振駆動周波数 (f_acoustic):",
    freqHelp: "超音波励起周波数（20.0〜45.0 kHz）。気泡共振径と音響放射力（アコーストフォレシス）を制御。",
    tempLabel: "原料流体運転温度 (T_feed):",
    tempHelp: "流体供給温度（10.0〜45.0 °C）。低温処理によりホエータンパク質の熱変性を完全防止。",
    flowLabel: "連続流体供給流量 (Q_flow):",
    flowHelp: "音響キャビテーション反応セルへ供給される原料の体積流量（1,000〜15,000 L/h）。",
    presetsTitle: "工業用 ASH-DD クイック運転プリセット:",
    presetMilk: "生乳低温脱脂・クリーム分離（24 bar、22°C、脱脂効率 96.8％、残留脂肪 <0.035％）",
    presetButtermilk: "バターミルク極性脂質抽出（20 bar、25°C、MFGM リン脂質回収率 96.5％）",
    presetWhey: "チーズホエーカーカス脱脂・WPI 精製（26 bar、24°C、UF 膜寿命 4.2倍延伸）",
    presetOat: "オーツ麦飲料非加熱清澄安定化（22 bar、25°C、脂質凝集防止・酸化抑制）",
    presetHazard: "無遮音過剰空化・重力滞留槽（チタン粒子剥離混入、騒音 >108 dBA 労働安全違反）",
    diagnosticTitle: "リアルタイム ASH-DD 音響脱脂テレメトリー＆解離流体力学",
    diagnosticSub: "クリーム分離率、残留脂肪率、極性リン脂質回収率、タンパク質熱変性率、3-A 衛生規格適合性をリアルタイム解析。",
    efficiencyLabel: "クリーム遠心分離・脱脂精製効率:",
    residualFatLabel: "脱脂乳出口流体中残留脂肪率:",
    phospholipidLabel: "生体活性 MFGM 極性リン脂質回収率:",
    denaturationLabel: "天然ホエータンパク質（β-Lg）熱変性率:",
    secLabel: "単位処理体積あたり比消費電力量 (SEC):",
    energySavingLabel: "従来のディスク型遠心分離機に対する省エネ率:",
    tempRiseLabel: "非加熱プロセス流体連続上昇温度 (ΔT):",
    statusLabel: "3-A 衛生規格 60-01 / ASME BPVC VIII / EHEDG 準拠状態:",
    diagramTitle: "音響衝撃波流体脱脂（ASH-DD）プロセス系統図",
    diagramSub: "高圧供給ポンプ、対向型チタンホーン音響キャビテーションチャンバー、ベンチュリ絞り流路、3段式サニタリーハイドロサイクロン。",
    scienceTitle: "音響キャビテーション動力学＆乳脂肪球皮膜（MFGM）分子解離生体物理学",
    scienceSub: "Rayleigh-Plesset 気泡圧壊方程式、ナノ秒スケール音響微小噴流剪断、音響放射力（音泳）、クリーンラベル非加熱脱脂技術の理論。",
    tableTitle: "技術比較マトリックス：ASH-DD 対 従来型ディスクスタック遠心機・熱破乳処理・溶媒抽出"
  }
};

const d = DICT[lang] || DICT.en;
const systems = ashDdData.systemArchitectures;
const feeds = ashDdData.feedMatrices;
const acoustics = ashDdData.acousticShockwaveStages;
const separators = ashDdData.hydrocycloneSeparationStages;
---

<div class="my-10 p-6 md:p-8 bg-surface border border-hairline rounded-3xl shadow-xs">
  <!-- Header Badge & Title -->
  <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
    <span class="inline-block px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-sky-950 text-sky-300 border border-sky-800">
      {d.badge}
    </span>
    <span class="text-xs text-muted font-mono">
      ASH-DD &bull; 20&ndash;45 kHz &bull; 15&ndash;35 bar &bull; 3-A 60-01 &bull; ASME Sec VIII &bull; EHEDG Doc 8 &bull; OSHA 1910.95
    </span>
  </div>

  <h2 class="text-title-lg md:text-headline-sm font-medium text-ink tracking-tight mb-3">
    {d.title}
  </h2>
  <p class="text-body text-sm leading-relaxed mb-8 max-w-4xl text-muted">
    {d.subtitle}
  </p>

  <!-- Industrial Presets Row -->
  <div class="mb-8 p-5 bg-surface-soft border border-hairline rounded-2xl">
    <div class="text-xs font-bold uppercase tracking-wider text-ink mb-3 flex items-center gap-2">
      <svg class="w-4 h-4 text-sky-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
      </svg>
      {d.presetsTitle}
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2.5">
      <button 
        type="button" 
        id="ash-preset-milk"
        class="text-left p-3 rounded-xl bg-surface border border-hairline hover:border-sky-500 hover:bg-sky-950/20 transition-all text-xs text-body"
      >
        <span class="font-bold text-sky-400 block mb-1">🥛 {d.presetMilk.split('(')[0]}</span>
        <span class="text-muted text-[11px] block leading-tight">{d.presetMilk}</span>
      </button>

      <button 
        type="button" 
        id="ash-preset-buttermilk"
        class="text-left p-3 rounded-xl bg-surface border border-hairline hover:border-sky-500 hover:bg-sky-950/20 transition-all text-xs text-body"
      >
        <span class="font-bold text-sky-400 block mb-1">🧈 {d.presetButtermilk.split('(')[0]}</span>
        <span class="text-muted text-[11px] block leading-tight">{d.presetButtermilk}</span>
      </button>

      <button 
        type="button" 
        id="ash-preset-whey"
        class="text-left p-3 rounded-xl bg-surface border border-hairline hover:border-sky-500 hover:bg-sky-950/20 transition-all text-xs text-body"
      >
        <span class="font-bold text-sky-400 block mb-1">🧀 {d.presetWhey.split('(')[0]}</span>
        <span class="text-muted text-[11px] block leading-tight">{d.presetWhey}</span>
      </button>

      <button 
        type="button" 
        id="ash-preset-oat"
        class="text-left p-3 rounded-xl bg-surface border border-hairline hover:border-sky-500 hover:bg-sky-950/20 transition-all text-xs text-body"
      >
        <span class="font-bold text-sky-400 block mb-1">🌾 {d.presetOat.split('(')[0]}</span>
        <span class="text-muted text-[11px] block leading-tight">{d.presetOat}</span>
      </button>

      <button 
        type="button" 
        id="ash-preset-hazard"
        class="text-left p-3 rounded-xl bg-rose-950/30 border border-rose-800/80 hover:border-rose-500 hover:bg-rose-950/50 transition-all text-xs text-body sm:col-span-2 lg:col-span-2"
      >
        <span class="font-bold text-rose-400 block mb-1">⚠️ {d.presetHazard.split('(')[0]}</span>
        <span class="text-rose-200/80 text-[11px] block leading-tight">{d.presetHazard}</span>
      </button>
    </div>
  </div>

  <!-- Interactive Controls Section -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-8">
    <div class="lg:col-span-7 space-y-6">
      <div class="border-b border-hairline pb-3">
        <h3 class="text-base font-bold text-ink">
          {d.controlsTitle}
        </h3>
        <p class="text-xs text-muted mt-1">
          {d.controlsSub}
        </p>
      </div>

      <!-- System Selector -->
      <div>
        <label for="ash-system-select" class="block text-xs font-bold text-ink mb-1.5">
          {d.systemLabel}
        </label>
        <select 
          id="ash-system-select" 
          class="w-full text-xs rounded-xl bg-surface-soft border border-hairline p-3 text-ink focus:outline-none focus:border-sky-500 font-medium"
        >
          {systems.map((s) => (
            <option value={s.id}>{s.name} ({s.minOperatingPressureBar}–{s.maxOperatingPressureBar} bar, max {s.maxThroughputLitersPerHour} L/h)</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1.5 leading-normal">
          {d.systemHelp}
        </p>
      </div>

      <!-- Feedstock Selector -->
      <div>
        <label for="ash-feed-select" class="block text-xs font-bold text-ink mb-1.5">
          {d.matrixLabel}
        </label>
        <select 
          id="ash-feed-select" 
          class="w-full text-xs rounded-xl bg-surface-soft border border-hairline p-3 text-ink focus:outline-none focus:border-sky-500 font-medium"
        >
          {feeds.map((f) => (
            <option value={f.id}>{f.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1.5 leading-normal">
          {d.matrixHelp}
        </p>
      </div>

      <!-- Acoustic Shockwave & Hydrocyclone Selectors -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="ash-acoustic-select" class="block text-xs font-bold text-ink mb-1.5">
            {d.acousticLabel}
          </label>
          <select 
            id="ash-acoustic-select" 
            class="w-full text-xs rounded-xl bg-surface-soft border border-hairline p-3 text-ink focus:outline-none focus:border-sky-500 font-medium"
          >
            {acoustics.map((a) => (
              <option value={a.id}>{a.name}</option>
            ))}
          </select>
          <p class="text-[11px] text-muted mt-1.5 leading-normal">
            {d.acousticHelp}
          </p>
        </div>

        <div>
          <label for="ash-sep-select" class="block text-xs font-bold text-ink mb-1.5">
            {d.separatorLabel}
          </label>
          <select 
            id="ash-sep-select" 
            class="w-full text-xs rounded-xl bg-surface-soft border border-hairline p-3 text-ink focus:outline-none focus:border-sky-500 font-medium"
          >
            {separators.map((sep) => (
              <option value={sep.id}>{sep.name}</option>
            ))}
          </select>
          <p class="text-[11px] text-muted mt-1.5 leading-normal">
            {d.separatorHelp}
          </p>
        </div>
      </div>

      <!-- Sliders -->
      <div class="space-y-4 pt-2">
        <!-- Chamber Pressure -->
        <div>
          <div class="flex justify-between items-center text-xs font-bold text-ink mb-1.5">
            <label for="ash-pressure-slider">{d.pressureLabel}</label>
            <span id="ash-pressure-val" class="text-sky-400 font-mono">24.0 bar</span>
          </div>
          <input 
            type="range" 
            id="ash-pressure-slider" 
            min="10.0" 
            max="40.0" 
            step="0.5" 
            value="24.0"
            class="w-full accent-sky-500 cursor-pointer h-2 bg-surface-soft rounded-lg"
          />
          <p class="text-[11px] text-muted mt-1">
            {d.pressureHelp}
          </p>
        </div>

        <!-- Acoustic Power -->
        <div>
          <div class="flex justify-between items-center text-xs font-bold text-ink mb-1.5">
            <label for="ash-power-slider">{d.powerLabel}</label>
            <span id="ash-power-val" class="text-sky-400 font-mono">28.0 kW</span>
          </div>
          <input 
            type="range" 
            id="ash-power-slider" 
            min="5.0" 
            max="55.0" 
            step="1.0" 
            value="28.0"
            class="w-full accent-sky-500 cursor-pointer h-2 bg-surface-soft rounded-lg"
          />
          <p class="text-[11px] text-muted mt-1">
            {d.powerHelp}
          </p>
        </div>

        <!-- Acoustic Frequency -->
        <div>
          <div class="flex justify-between items-center text-xs font-bold text-ink mb-1.5">
            <label for="ash-freq-slider">{d.freqLabel}</label>
            <span id="ash-freq-val" class="text-sky-400 font-mono">28.0 kHz</span>
          </div>
          <input 
            type="range" 
            id="ash-freq-slider" 
            min="20.0" 
            max="45.0" 
            step="0.5" 
            value="28.0"
            class="w-full accent-sky-500 cursor-pointer h-2 bg-surface-soft rounded-lg"
          />
          <p class="text-[11px] text-muted mt-1">
            {d.freqHelp}
          </p>
        </div>

        <!-- Operating Temp -->
        <div>
          <div class="flex justify-between items-center text-xs font-bold text-ink mb-1.5">
            <label for="ash-temp-slider">{d.tempLabel}</label>
            <span id="ash-temp-val" class="text-sky-400 font-mono">22.0 &deg;C</span>
          </div>
          <input 
            type="range" 
            id="ash-temp-slider" 
            min="10.0" 
            max="45.0" 
            step="1.0" 
            value="22.0"
            class="w-full accent-sky-500 cursor-pointer h-2 bg-surface-soft rounded-lg"
          />
          <p class="text-[11px] text-muted mt-1">
            {d.tempHelp}
          </p>
        </div>

        <!-- Flow Rate -->
        <div>
          <div class="flex justify-between items-center text-xs font-bold text-ink mb-1.5">
            <label for="ash-flow-slider">{d.flowLabel}</label>
            <span id="ash-flow-val" class="text-sky-400 font-mono">8,500 L/h</span>
          </div>
          <input 
            type="range" 
            id="ash-flow-slider" 
            min="1000.0" 
            max="15000.0" 
            step="250.0" 
            value="8500.0"
            class="w-full accent-sky-500 cursor-pointer h-2 bg-surface-soft rounded-lg"
          />
          <p class="text-[11px] text-muted mt-1">
            {d.flowHelp}
          </p>
        </div>
      </div>
    </div>

    <!-- Live Telemetry Column -->
    <div class="lg:col-span-5 flex flex-col justify-between space-y-6 bg-surface-soft border border-hairline p-6 rounded-2xl">
      <div>
        <div class="flex items-center justify-between gap-2 mb-4 border-b border-hairline pb-3">
          <div>
            <h3 class="text-base font-bold text-ink">
              {d.diagnosticTitle}
            </h3>
            <p class="text-xs text-muted mt-0.5">
              {d.diagnosticSub}
            </p>
          </div>
          <span id="ash-safety-badge" class="px-3.5 py-1.5 rounded-full text-xs font-bold tracking-wide bg-emerald-950 text-emerald-300 border border-emerald-800">
            OPTIMAL / FULL PARITY
          </span>
        </div>

        <!-- Hazard Warning Banner -->
        <div id="ash-hazard-banner" class="hidden mb-4 p-4 rounded-xl bg-rose-950/80 border border-rose-700 text-rose-200 text-xs space-y-1">
          <div class="font-bold flex items-center gap-1.5 text-rose-300">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            CRITICAL SAFETY FAILURE: HAZARDOUS OPERATION DETECTED
          </div>
          <p class="text-[11px] leading-relaxed">
            Unshielded ultrasonic overcavitation or stagnant weir tanks violate OSHA 29 CFR § 1910.95 (noise > 108 dBA) and 3-A Sanitary Standards 60-01, risking titanium cavitation pit spalling, protein thermal denaturation, and microbial growth.
          </p>
        </div>

        <!-- Telemetry Meters Grid -->
        <div class="grid grid-cols-2 gap-3.5">
          <!-- Defatting Efficiency -->
          <div class="p-3.5 rounded-xl bg-surface border border-hairline">
            <div class="text-[11px] text-muted font-medium mb-1">
              {d.efficiencyLabel}
            </div>
            <div id="ash-eff-metric" class="text-lg md:text-xl font-bold font-mono text-sky-400">
              96.8%
            </div>
            <div class="text-[10px] text-muted mt-1 font-mono">
              Cream Phase Demulsification
            </div>
          </div>

          <!-- Residual Fat -->
          <div class="p-3.5 rounded-xl bg-surface border border-hairline">
            <div class="text-[11px] text-muted font-medium mb-1">
              {d.residualFatLabel}
            </div>
            <div id="ash-fat-metric" class="text-lg md:text-xl font-bold font-mono text-emerald-400">
              0.035%
            </div>
            <div class="text-[10px] text-muted mt-1 font-mono">
              Ultra-Skim Underflow
            </div>
          </div>

          <!-- Polar Phospholipid Recovery -->
          <div class="p-3.5 rounded-xl bg-surface border border-hairline">
            <div class="text-[11px] text-muted font-medium mb-1">
              {d.phospholipidLabel}
            </div>
            <div id="ash-phospho-metric" class="text-lg md:text-xl font-bold font-mono text-emerald-400">
              94.5%
            </div>
            <div class="text-[10px] text-muted mt-1 font-mono">
              MFGM Sphingomyelins
            </div>
          </div>

          <!-- Whey Protein Denaturation -->
          <div class="p-3.5 rounded-xl bg-surface border border-hairline">
            <div class="text-[11px] text-muted font-medium mb-1">
              {d.denaturationLabel}
            </div>
            <div id="ash-denat-metric" class="text-lg md:text-xl font-bold font-mono text-emerald-400">
              0.12%
            </div>
            <div class="text-[10px] text-muted mt-1 font-mono">
              Native Bioactivity Intact
            </div>
          </div>

          <!-- SEC -->
          <div class="p-3.5 rounded-xl bg-surface border border-hairline">
            <div class="text-[11px] text-muted font-medium mb-1">
              {d.secLabel}
            </div>
            <div id="ash-sec-metric" class="text-lg md:text-xl font-bold font-mono text-sky-400">
              3.4 kWh/m&sup3;
            </div>
            <div class="text-[10px] text-muted mt-1 font-mono">
              Cavitation &amp; Hydrocyclone
            </div>
          </div>

          <!-- Energy Savings -->
          <div class="p-3.5 rounded-xl bg-surface border border-hairline">
            <div class="text-[11px] text-muted font-medium mb-1">
              {d.energySavingLabel}
            </div>
            <div id="ash-energy-saving-metric" class="text-lg md:text-xl font-bold font-mono text-emerald-400">
              44.5%
            </div>
            <div class="text-[10px] text-muted mt-1 font-mono">
              vs Disk Stack Centrifuges
            </div>
          </div>

          <!-- Temp Rise -->
          <div class="p-3.5 rounded-xl bg-surface border border-hairline col-span-2">
            <div class="text-[11px] text-muted font-medium mb-1">
              {d.tempRiseLabel}
            </div>
            <div id="ash-temp-rise-metric" class="text-lg md:text-xl font-bold font-mono text-cyan-400">
              +1.8 &deg;C
            </div>
            <div class="text-[10px] text-muted mt-1 font-mono">
              Ambient Clean-Label Operation (Non-Thermal Integrity)
            </div>
          </div>
        </div>
      </div>

      <!-- Compliance Footer -->
      <div class="pt-4 border-t border-hairline">
        <div class="text-[11px] text-muted font-medium mb-1">
          {d.statusLabel}
        </div>
        <div id="ash-compliance-metric" class="text-xs font-bold font-mono text-emerald-400">
          PASS &bull; 3-A Sanitary 60-01 &bull; ASME BPVC VIII &bull; EHEDG &bull; OSHA 1910.95
        </div>
      </div>
    </div>
  </div>

  <!-- Dynamic Process Flow SVG Diagram -->
  <div class="mb-8 p-6 bg-surface-soft border border-hairline rounded-3xl">
    <h3 class="text-base font-bold text-ink mb-1">
      {d.diagramTitle}
    </h3>
    <p class="text-xs text-muted mb-6">
      {d.diagramSub}
    </p>

    <div class="w-full overflow-hidden flex justify-center py-4 bg-surface rounded-2xl border border-hairline">
      <svg class="w-full max-w-3xl h-auto" viewBox="0 0 800 420" fill="none" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="ashLiquidGrad" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.8" />
            <stop offset="50%" stop-color="#0284c7" stop-opacity="0.5" />
            <stop offset="100%" stop-color="#0369a1" stop-opacity="0.2" />
          </linearGradient>
          <linearGradient id="ashCavitationGrad" x1="0%" y1="50%" x2="100%" y2="50%">
            <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.9" />
            <stop offset="50%" stop-color="#e0f2fe" stop-opacity="0.95" />
