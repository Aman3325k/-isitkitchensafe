<script>
  // Client-side Interactive Simulation Logic for ASH-DD Modeler
  document.addEventListener('DOMContentLoaded', () => {
    const systemSelect = document.getElementById('ash-system-select') as HTMLSelectElement | null;
    const feedSelect = document.getElementById('ash-feed-select') as HTMLSelectElement | null;
    const acousticSelect = document.getElementById('ash-acoustic-select') as HTMLSelectElement | null;
    const sepSelect = document.getElementById('ash-sep-select') as HTMLSelectElement | null;

    const pressureSlider = document.getElementById('ash-pressure-slider') as HTMLInputElement | null;
    const powerSlider = document.getElementById('ash-power-slider') as HTMLInputElement | null;
    const freqSlider = document.getElementById('ash-freq-slider') as HTMLInputElement | null;
    const tempSlider = document.getElementById('ash-temp-slider') as HTMLInputElement | null;
    const flowSlider = document.getElementById('ash-flow-slider') as HTMLInputElement | null;

    const pressureVal = document.getElementById('ash-pressure-val');
    const powerVal = document.getElementById('ash-power-val');
    const freqVal = document.getElementById('ash-freq-val');
    const tempVal = document.getElementById('ash-temp-val');
    const flowVal = document.getElementById('ash-flow-val');

    const effMetric = document.getElementById('ash-eff-metric');
    const fatMetric = document.getElementById('ash-fat-metric');
    const phosphoMetric = document.getElementById('ash-phospho-metric');
    const denatMetric = document.getElementById('ash-denat-metric');
    const secMetric = document.getElementById('ash-sec-metric');
    const energySavingMetric = document.getElementById('ash-energy-saving-metric');
    const tempRiseMetric = document.getElementById('ash-temp-rise-metric');
    const complianceMetric = document.getElementById('ash-compliance-metric');
    const safetyBadge = document.getElementById('ash-safety-badge');
    const hazardBanner = document.getElementById('ash-hazard-banner');

    function updateSimulation() {
      if (!pressureSlider || !powerSlider || !freqSlider || !tempSlider || !flowSlider) return;

      const pressure = parseFloat(pressureSlider.value);
      const power = parseFloat(powerSlider.value);
      const freq = parseFloat(freqSlider.value);
      const temp = parseFloat(tempSlider.value);
      const flow = parseFloat(flowSlider.value);

      if (pressureVal) pressureVal.innerText = `${pressure.toFixed(1)} bar`;
      if (powerVal) powerVal.innerText = `${power.toFixed(1)} kW`;
      if (freqVal) freqVal.innerText = `${freq.toFixed(1)} kHz`;
      if (tempVal) tempVal.innerHTML = `${temp.toFixed(1)} &deg;C`;
      if (flowVal) flowVal.innerText = `${Math.round(flow).toLocaleString()} L/h`;

      const isAcousticHazard = acousticSelect?.value === 'unshielded_destructive_overcavitation_hazard';
      const isSepHazard = sepSelect?.value === 'single_stage_gravity_weir_choke_hazard';
      const isSevereHazard = isAcousticHazard || isSepHazard;

      if (isSevereHazard) {
        if (hazardBanner) hazardBanner.classList.remove('hidden');
        if (safetyBadge) {
          safetyBadge.className = 'px-3.5 py-1.5 rounded-full text-xs font-bold tracking-wide bg-rose-950 text-rose-300 border border-rose-800 animate-pulse';
          safetyBadge.innerText = 'NON-COMPLIANT / SEVERE HAZARD';
        }
        if (complianceMetric) {
          complianceMetric.className = 'text-xs font-bold font-mono text-rose-400';
          complianceMetric.innerText = 'FAIL (OVERCAVITATION PIT SPALLING / STAGNANT STOOL SPOILAGE)';
        }
        if (effMetric) effMetric.innerText = '64.5%';
        if (fatMetric) fatMetric.innerText = '0.450%';
        if (phosphoMetric) phosphoMetric.innerText = '32.0%';
        if (denatMetric) denatMetric.innerText = '8.50% (Thermal & Shear Damage)';
        if (secMetric) secMetric.innerText = '9.2 kWh/m\u00B3';
        if (energySavingMetric) energySavingMetric.innerText = '0.0%';
        if (tempRiseMetric) tempRiseMetric.innerText = '+12.5 \u00B0C (Thermal Curdling Risk)';
        return;
      }

      if (hazardBanner) hazardBanner.classList.add('hidden');

      // Authentic physics calculations:
      // Acoustic intensity & pressure ratio
      const pressureRatio = pressure / 24.0;
      const powerDensityKwPerM3 = power / (flow / 1000.0);
      
      // Defatting efficiency:
      const baseEff = 95.0 + Math.min(3.2, (pressure - 15.0) * 0.12) + Math.min(1.5, (power - 10.0) * 0.05);
      const defattingEff = Math.min(98.5, Math.max(88.0, baseEff));

      // Residual fat in skim:
      const residualFat = Math.max(0.015, Math.min(0.085, 0.075 - (defattingEff - 90.0) * 0.005));

      // Polar phospholipid recovery:
      const phosphoRec = Math.min(97.8, Math.max(85.0, 91.0 + (powerDensityKwPerM3 * 0.8) + (temp > 20 ? 1.5 : -1.0)));

      // Native protein denaturation:
      const tempStress = Math.max(0, temp - 30);
      const denatRate = Math.max(0.05, 0.08 + (tempStress * 0.03) + (powerDensityKwPerM3 * 0.02));

      // Specific energy consumption:
      const sec = Math.max(1.8, Math.min(5.8, (power / (flow / 1000.0)) + (pressure * 0.06)));
      const energySaving = Math.max(25.0, Math.min(58.0, ((6.1 - sec) / 6.1) * 100));

      // Temperature rise:
      const tempRise = Math.max(0.8, Math.min(3.8, powerDensityKwPerM3 * 0.65));

      if (safetyBadge) {
        safetyBadge.className = 'px-3.5 py-1.5 rounded-full text-xs font-bold tracking-wide bg-emerald-950 text-emerald-300 border border-emerald-800';
        safetyBadge.innerText = 'OPTIMAL / FULL PARITY';
      }
      if (complianceMetric) {
        complianceMetric.className = 'text-xs font-bold font-mono text-emerald-400';
        complianceMetric.innerText = 'PASS \u2022 3-A Sanitary 60-01 \u2022 ASME BPVC VIII \u2022 EHEDG \u2022 OSHA 1910.95';
      }

      if (effMetric) effMetric.innerText = `${defattingEff.toFixed(1)}%`;
      if (fatMetric) fatMetric.innerText = `${residualFat.toFixed(3)}%`;
      if (phosphoMetric) phosphoMetric.innerText = `${phosphoRec.toFixed(1)}%`;
      if (denatMetric) denatMetric.innerText = `${denatRate.toFixed(2)}%`;
      if (secMetric) secMetric.innerText = `${sec.toFixed(1)} kWh/m\u00B3`;
      if (energySavingMetric) energySavingMetric.innerText = `${energySaving.toFixed(1)}%`;
      if (tempRiseMetric) tempRiseMetric.innerText = `+${tempRise.toFixed(1)} \u00B0C`;
    }

    // Attach listeners
    [pressureSlider, powerSlider, freqSlider, tempSlider, flowSlider].forEach(slider => {
      slider?.addEventListener('input', updateSimulation);
    });

    [systemSelect, feedSelect, acousticSelect, sepSelect].forEach(select => {
      select?.addEventListener('change', updateSimulation);
    });

    // Preset handlers
    document.getElementById('ash-preset-milk')?.addEventListener('click', () => {
      if (pressureSlider) pressureSlider.value = '24.0';
      if (powerSlider) powerSlider.value = '28.0';
      if (freqSlider) freqSlider.value = '28.0';
      if (tempSlider) tempSlider.value = '22.0';
      if (flowSlider) flowSlider.value = '8500.0';
      if (feedSelect) feedSelect.value = 'whole_bovine_raw_milk';
      if (systemSelect) systemSelect.value = 'industrial_continuous_ash_dd_skid';
      if (acousticSelect) acousticSelect.value = 'high_intensity_dual_transducer_28khz';
      if (sepSelect) sepSelect.value = 'triple_stage_sanitary_hydrocyclone_cluster';
      updateSimulation();
    });

    document.getElementById('ash-preset-buttermilk')?.addEventListener('click', () => {
      if (pressureSlider) pressureSlider.value = '20.0';
      if (powerSlider) powerSlider.value = '24.0';
      if (freqSlider) freqSlider.value = '40.0';
      if (tempSlider) tempSlider.value = '25.0';
      if (flowSlider) flowSlider.value = '6500.0';
      if (feedSelect) feedSelect.value = 'industrial_sweet_cream_buttermilk';
      if (systemSelect) systemSelect.value = 'dairy_whey_sludge_valorization_skid';
      if (acousticSelect) acousticSelect.value = 'focused_piezoelectric_megasonic_40khz';
      if (sepSelect) sepSelect.value = 'triple_stage_sanitary_hydrocyclone_cluster';
      updateSimulation();
    });

    document.getElementById('ash-preset-whey')?.addEventListener('click', () => {
      if (pressureSlider) pressureSlider.value = '26.0';
      if (powerSlider) powerSlider.value = '32.0';
      if (freqSlider) freqSlider.value = '24.0';
      if (tempSlider) tempSlider.value = '24.0';
      if (flowSlider) flowSlider.value = '7200.0';
      if (feedSelect) feedSelect.value = 'cheese_whey_centrifuge_sludge';
      if (systemSelect) systemSelect.value = 'dairy_whey_sludge_valorization_skid';
      if (acousticSelect) acousticSelect.value = 'hydrodynamic_venturi_cavitation_hybrid';
      if (sepSelect) sepSelect.value = 'triple_stage_sanitary_hydrocyclone_cluster';
      updateSimulation();
    });

    document.getElementById('ash-preset-oat')?.addEventListener('click', () => {
      if (pressureSlider) pressureSlider.value = '22.0';
      if (powerSlider) powerSlider.value = '30.0';
      if (freqSlider) freqSlider.value = '32.0';
      if (tempSlider) tempSlider.value = '25.0';
      if (flowSlider) flowSlider.value = '9000.0';
      if (feedSelect) feedSelect.value = 'hydrolyzed_oat_dairy_alternative';
      if (systemSelect) systemSelect.value = 'plant_milk_emulsion_destabilization_skid';
      if (acousticSelect) acousticSelect.value = 'high_intensity_dual_transducer_28khz';
      if (sepSelect) sepSelect.value = 'two_stage_counter_current_hydrocyclone';
      updateSimulation();
    });

    document.getElementById('ash-preset-hazard')?.addEventListener('click', () => {
      if (pressureSlider) pressureSlider.value = '38.0';
      if (powerSlider) powerSlider.value = '52.0';
      if (freqSlider) freqSlider.value = '20.0';
      if (tempSlider) tempSlider.value = '38.0';
      if (acousticSelect) acousticSelect.value = 'unshielded_destructive_overcavitation_hazard';
      if (sepSelect) sepSelect.value = 'single_stage_gravity_weir_choke_hazard';
      updateSimulation();
    });

    // Initial calculation
    updateSimulation();
  });
</script>
