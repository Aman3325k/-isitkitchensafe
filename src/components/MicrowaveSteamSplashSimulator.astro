  ja: {
    tabSimulator: '電子レンジ蒸気圧・変形溶出シミュレーター',
    tabWarpageMatrix: '劣化プラスチック容器の変形・損傷診断表',
    tabScience: '科学的解説：過熱蒸気と凝縮水滴還流',
