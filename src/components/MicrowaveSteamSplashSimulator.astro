    lidLabel: '3. 蓋の密閉・通気状態を選択：',
    durationLabel: '4. 電子レンジの加熱時間を選択：',
    hazardScoreLabel: '総合ハザードスコア',
    burnRiskLabel: '突沸・爆発・蒸気火傷リスク',
    chemicalIndexLabel: '化学物質＆マイクロプラスチック溶出指数',
    mechanismHeader: '科学的熱力学メカニズムの分析',
    actionHeader: '直ちに行うべき安全対策・通気プロトコル',
    copyBtn: '安全診断結果をコピー',
    copySuccess: '診断結果をコピーしました！',
    printBtn: '印刷 / PDF保存',
    faqHeading: 'よくある質問：電子レンジ蒸気とプラスチックの安全性',
    relatedHeading: '関連するキッチン化学安全・食品接触テストツール',
    badgeSafe: '安全・理想的な加熱環境',
    badgeCaution: '中等度注意・通気方法の改善推奨',
    badgeDanger: '化学物質溶出の危険性が高い状態',
    badgeCritical: '極めて危険・突沸火傷＆有害物質溶出の恐れ'
  }
};

const t = uiStrings[currentLocale] || uiStrings.en;
---

<div class="space-y-10" id="microwave-steam-simulator-app">
  <!-- Top Scientific Alert Banner -->
  <aside class="p-5 md:p-6 rounded-2xl bg-gradient-to-r from-amber-500/10 via-amber-600/10 to-red-500/10 border-2 border-amber-500/30 text-ink shadow-sm" aria-label="Scientific Alert">
    <div class="flex items-start gap-4">
      <div class="p-2.5 rounded-xl bg-amber-500 text-white font-black text-xl shrink-0">
        &#9888;
      </div>
      <div>
        <h2 class="text-base md:text-lg font-bold text-amber-900 dark:text-amber-200 mb-1">
          {bannerData.title}
        </h2>
        <p class="text-xs md:text-sm text-ink/80 leading-relaxed">
          {bannerData.body}
        </p>
      </div>
    </div>
  </aside>

  <!-- Interactive Navigation Tabs -->
  <nav class="flex flex-wrap gap-2 border-b border-edge/30 pb-3" role="tablist" aria-label="Tool Navigation">
    <button
      type="button"
      role="tab"
      aria-selected="true"
      data-target="tab-simulator"
      class="tab-btn px-4 py-2.5 rounded-xl font-bold text-xs md:text-sm transition-all duration-200 bg-signature-coral text-white shadow-sm"
    >
      {t.tabSimulator}
    </button>
    <button
      type="button"
      role="tab"
      aria-selected="false"
      data-target="tab-warpage-matrix"
      class="tab-btn px-4 py-2.5 rounded-xl font-bold text-xs md:text-sm transition-all duration-200 bg-surface-soft text-ink hover:bg-surface-soft/80"
    >
      {t.tabWarpageMatrix}
    </button>
    <button
      type="button"
      role="tab"
      aria-selected="false"
      data-target="tab-science"
      class="tab-btn px-4 py-2.5 rounded-xl font-bold text-xs md:text-sm transition-all duration-200 bg-surface-soft text-ink hover:bg-surface-soft/80"
    >
      {t.tabScience}
    </button>
    <button
      type="button"
      role="tab"
      aria-selected="false"
      data-target="tab-protocols"
      class="tab-btn px-4 py-2.5 rounded-xl font-bold text-xs md:text-sm transition-all duration-200 bg-surface-soft text-ink hover:bg-surface-soft/80"
    >
      {t.tabProtocols}
    </button>
  </nav>

  <!-- TAB 1: Simulator -->
  <div id="tab-simulator" class="tab-panel space-y-8" role="tabpanel">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Input Controls -->
      <section class="lg:col-span-6 space-y-6 bg-surface-soft p-6 md:p-8 rounded-3xl border border-edge/40 shadow-sm" aria-label="Simulation Parameters">
        <h3 class="text-base md:text-lg font-bold text-ink border-b border-edge/20 pb-3">
          Configure Microwave Heating Scenario
        </h3>

        <!-- 1. Container -->
        <div class="space-y-2">
          <label for="container-select" class="block text-xs md:text-sm font-bold text-ink">
            {t.containerLabel}
          </label>
          <select id="container-select" class="w-full px-4 py-3 rounded-xl bg-surface border border-edge/60 text-ink text-xs md:text-sm focus:ring-2 focus:ring-signature-coral focus:outline-none">
            {localizedContainers.map((c: any) => (
              <option value={c.id}>
                {c.name} ({c.code})
              </option>
            ))}
          </select>
          <p id="container-detail" class="text-[11px] md:text-xs text-ink/70 italic"></p>
        </div>

        <!-- 2. Food Matrix -->
        <div class="space-y-2">
          <label for="food-select" class="block text-xs md:text-sm font-bold text-ink">
            {t.foodLabel}
          </label>
          <select id="food-select" class="w-full px-4 py-3 rounded-xl bg-surface border border-edge/60 text-ink text-xs md:text-sm focus:ring-2 focus:ring-signature-coral focus:outline-none">
            {localizedFoods.map((f: any) => (
              <option value={f.id}>
                {f.name}
              </option>
            ))}
          </select>
          <p id="food-detail" class="text-[11px] md:text-xs text-ink/70 italic"></p>
        </div>

        <!-- 3. Lid / Sealing State -->
        <div class="space-y-2">
          <label for="lid-select" class="block text-xs md:text-sm font-bold text-ink">
            {t.lidLabel}
          </label>
          <select id="lid-select" class="w-full px-4 py-3 rounded-xl bg-surface border border-edge/60 text-ink text-xs md:text-sm focus:ring-2 focus:ring-signature-coral focus:outline-none">
            {localizedLids.map((l: any) => (
              <option value={l.id}>
                {l.name}
              </option>
            ))}
          </select>
          <p id="lid-detail" class="text-[11px] md:text-xs text-ink/70 italic"></p>
        </div>

        <!-- 4. Duration -->
        <div class="space-y-2">
          <label for="duration-select" class="block text-xs md:text-sm font-bold text-ink">
            {t.durationLabel}
          </label>
          <select id="duration-select" class="w-full px-4 py-3 rounded-xl bg-surface border border-edge/60 text-ink text-xs md:text-sm focus:ring-2 focus:ring-signature-coral focus:outline-none">
            {localizedDurations.map((d: any) => (
              <option value={d.id}>
                {d.name}
              </option>
            ))}
          </select>
        </div>
      </section>

      <!-- Results Display Panel -->
      <section class="lg:col-span-6 space-y-6" aria-label="Risk Assessment Results">
        <div id="result-card" class="p-6 md:p-8 rounded-3xl border-2 transition-all duration-300 shadow-md bg-surface">
          <!-- Dynamic Status Badge -->
          <div class="flex items-center justify-between gap-3 mb-4">
            <span id="result-badge" class="px-3.5 py-1.5 rounded-full text-xs font-black tracking-wider uppercase bg-emerald-600 text-white">
              {t.badgeSafe}
            </span>
            <span class="text-xs font-mono text-ink/60" id="result-code-tag">PP #5</span>
          </div>

          <h4 id="result-title" class="text-lg md:text-xl font-bold text-ink mb-4">
            Calculating heating risk...
          </h4>

          <!-- Metric Gauges -->
          <div class="grid grid-cols-2 gap-4 my-6">
            <div class="p-4 rounded-2xl bg-surface-soft border border-edge/30">
              <span class="text-[11px] md:text-xs font-bold text-ink/70 block mb-1">
                {t.burnRiskLabel}
              </span>
              <div class="flex items-baseline gap-2">
                <span id="burn-percentage" class="text-2xl md:text-3xl font-black text-ink">10%</span>
                <span id="burn-level" class="text-xs font-bold text-emerald-600">Low</span>
              </div>
              <div class="w-full bg-edge/30 h-2 rounded-full overflow-hidden mt-2">
                <div id="burn-bar" class="h-full bg-emerald-500 transition-all duration-300" style="width: 10%"></div>
              </div>
            </div>

            <div class="p-4 rounded-2xl bg-surface-soft border border-edge/30">
              <span class="text-[11px] md:text-xs font-bold text-ink/70 block mb-1">
                {t.chemicalIndexLabel}
              </span>
              <div class="flex items-baseline gap-2">
                <span id="chemical-rating" class="text-2xl md:text-3xl font-black text-ink">Low</span>
              </div>
              <p id="microplastic-estimate" class="text-[11px] text-ink/60 mt-2 truncate"></p>
            </div>
          </div>

          <!-- Mechanism Breakdown -->
          <div class="space-y-2 border-t border-edge/20 pt-4 mb-4">
            <h5 class="text-xs font-bold text-ink uppercase tracking-wide">
              {t.mechanismHeader}
            </h5>
            <p id="mechanism-text" class="text-xs md:text-sm text-ink/80 leading-relaxed"></p>
          </div>

          <!-- Safe Protocol / Recommended Action -->
          <div class="p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-ink space-y-1" id="action-container">
            <h5 class="text-xs font-bold text-emerald-900 dark:text-emerald-300 uppercase tracking-wide flex items-center gap-1.5">
              <span>&#10003;</span> {t.actionHeader}
            </h5>
            <p id="action-text" class="text-xs md:text-sm leading-relaxed"></p>
          </div>

          <!-- Action Buttons -->
          <div class="flex flex-wrap gap-3 pt-6 border-t border-edge/20 mt-6">
            <button
              type="button"
              id="copy-verdict-btn"
              class="px-4 py-2.5 rounded-xl bg-surface-soft hover:bg-surface-soft/80 border border-edge text-ink text-xs font-bold transition-all flex items-center gap-2"
            >
              <span>&#128203;</span>
              <span id="copy-text">{t.copyBtn}</span>
            </button>
            <button
              type="button"
              onclick="window.print()"
              class="px-4 py-2.5 rounded-xl bg-surface-soft hover:bg-surface-soft/80 border border-edge text-ink text-xs font-bold transition-all flex items-center gap-2"
            >
              <span>&#128438;</span>
              <span>{t.printBtn}</span>
            </button>
          </div>
        </div>
      </section>
    </div>
  </div>

  <!-- TAB 2: Warped Container Damage Matrix -->
  <div id="tab-warpage-matrix" class="tab-panel hidden space-y-6" role="tabpanel">
    <div class="bg-surface-soft p-6 md:p-8 rounded-3xl border border-edge/40">
      <h3 class="text-lg md:text-xl font-bold text-ink mb-2">
        {t.tabWarpageMatrix}
      </h3>
      <p class="text-xs md:text-sm text-ink/70 mb-6">
        Inspect your kitchen plastics for these 6 irreversible degradation patterns. Heat distortion, chemical cracking, and lipid pitting permanently destroy food-contact safety.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {localizedWarpage.map((w: any) => {
          const badgeClass = w.severity === 'critical' ? 'bg-red-600 text-white' : w.severity === 'high' ? 'bg-amber-600 text-white' : 'bg-blue-600 text-white';
          return (
            <div class="p-5 rounded-2xl bg-surface border border-edge/30 shadow-sm flex flex-col justify-between space-y-4">
              <div>
                <div class="flex items-center justify-between gap-2 mb-2">
                  <span class={`px-2.5 py-1 rounded-full text-[10px] font-black uppercase ${badgeClass}`}>
                    {w.severity}
                  </span>
                </div>
                <h4 class="text-sm md:text-base font-bold text-ink mb-2">
                  {w.name}
                </h4>
                <p class="text-xs text-ink/80 leading-relaxed mb-3">
                  <strong class="text-ink">Root Cause:</strong> {w.cause}
                </p>
                <p class="text-xs text-ink/70 leading-relaxed">
                  <strong class="text-ink">Structural Status:</strong> {w.structuralIntegrity}
                </p>
              </div>
              <div class="p-3 rounded-xl bg-surface-soft border border-edge/20 text-xs font-medium text-ink/90">
                <span class="block font-bold text-[11px] uppercase tracking-wider mb-1 text-signature-coral">
                  Verdict & Action:
                </span>
                {w.retirementAction}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>

  <!-- TAB 3: Science of Steam & Reflux -->
  <div id="tab-science" class="tab-panel hidden space-y-8" role="tabpanel">
    <div class="bg-surface-soft p-6 md:p-8 rounded-3xl border border-edge/40 space-y-6">
      <h3 class="text-lg md:text-xl font-bold text-ink">
        The Physics & Toxicology of Microwave Steam Condensation
      </h3>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs md:text-sm text-ink/80 leading-relaxed">
        <div class="p-5 rounded-2xl bg-surface border border-edge/30 space-y-3">
          <h4 class="font-bold text-sm md:text-base text-ink flex items-center gap-2">
            <span class="text-signature-coral">&#9762;</span> The Droplet Reflux Effect (Steam Distillation)
          </h4>
          <p>
            When liquid boils in a microwave, the rising steam reaches 100°C–120°C (212°F–248°F). As this superheated vapor strikes the underside of a plastic lid or cling film, it undergoes partial condensation.
          </p>
          <p>
            During this contact, hot water vapor acts as an organic solvent extraction medium. It leaches low-molecular-weight oligomers, antioxidant additives (such as Irganox), and slip agents from the plastic resin. These chemicals dissolve into the droplets clinging to the ceiling of the lid.
          </p>
          <p class="font-semibold text-amber-900 dark:text-amber-200">
            Once surface tension is exceeded, these chemical-laden droplets drip directly back into your soup, chili, or stew—a continuous chemical reflux cycle.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-surface border border-edge/30 space-y-3">
          <h4 class="font-bold text-sm md:text-base text-ink flex items-center gap-2">
            <span class="text-signature-coral">&#9881;</span> The Vacuum Warping Collapse Mechanism
          </h4>
          <p>
            Water expands over 1,600-fold when converted to steam. When food is microwaved with a sealed lid, expanding steam builds positive internal pressure. Polypropylene softens above its glass transition threshold.
          </p>
          <p>
            Upon shutdown, steam cools rapidly. The phase change from vapor back to liquid creates an acute vacuum within seconds. Atmospheric pressure (14.7 psi) violently pushes against the softened plastic exterior, sucking the base inward into a concave bowl shape.
          </p>
          <p class="font-semibold text-amber-900 dark:text-amber-200">
            Once polypropylene is deformed under heat and vacuum, its crystalline lamellae are permanently disorganized, multiplying microplastic shedding rates up to 10-fold.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-surface border border-edge/30 space-y-3">
          <h4 class="font-bold text-sm md:text-base text-ink flex items-center gap-2">
            <span class="text-signature-coral">&#128293;</span> Fatty Hotspot Dielectric Pitting
          </h4>
          <p>
            While water boils at 100°C, dietary lipids (butter, bacon grease, cooking oil) have significantly lower specific heat capacities and lack evaporative cooling. In a microwave, localized oil pockets readily reach 160°C–200°C (320°F–392°F).
          </p>
          <p>
            The heat deflection temperature of food-grade Polypropylene (PP #5) is between 100°C and 120°C. Splattering oil droplets literally melt through the inner container skin, creating permanent white, pitted, frosted rings.
          </p>
          <p class="font-semibold text-red-900 dark:text-red-200">
            Pitted plastic is structurally decomposed. Polymer chain ends are exposed directly to food contact, causing severe ongoing microplastic shedding.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-surface border border-edge/30 space-y-3">
          <h4 class="font-bold text-sm md:text-base text-ink flex items-center gap-2">
            <span class="text-signature-coral">&#128300;</span> ACS Nano 2023 Microplastic Quantification
          </h4>
          <p>
            In a landmark study published by the American Chemical Society (ACS Nano 2023), researchers at the University of Nebraska-Lincoln subjected commercial polypropylene containers to 3 minutes of microwave heating.
          </p>
          <p>
            The findings were alarming: up to <strong>4.22 million microplastic particles</strong> and <strong>2.11 billion nanoplastic particles</strong> were released per square centimeter of plastic surface area.
          </p>
          <p class="font-semibold text-red-900 dark:text-red-200">
            In vitro human embryonic kidney cell testing demonstrated a 75% reduction in cell viability within 48 to 72 hours of exposure to these microwaved plastic extracts.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- TAB 4: Safe Protocols & Swaps -->
  <div id="tab-protocols" class="tab-panel hidden space-y-8" role="tabpanel">
    <div class="bg-surface-soft p-6 md:p-8 rounded-3xl border border-edge/40 space-y-6">
