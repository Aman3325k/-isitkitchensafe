    burnRiskLabel: 'Risco de Explosão e Queimadura por Vapor',
    chemicalIndexLabel: 'Índice de Migração Química e Microplásticos',
    mechanismHeader: 'Mecanismo Científico e Termodinâmico',
    actionHeader: 'Protocolo Imediato de Ventilação Segura',
    copyBtn: 'Copiar Veredito de Segurança',
    copySuccess: 'Veredito Copiado com Sucesso!',
    printBtn: 'Imprimir / Salvar PDF',
    faqHeading: 'Perguntas Frequentes: Vapor de Micro-ondas e Plásticos',
    relatedHeading: 'Ferramentas Relacionadas de Segurança Química na Cozinha',
    badgeSafe: 'AQUECIMENTO SEGURO E IDEAL',
    badgeCaution: 'ATENÇÃO MODERADA',
    badgeDanger: 'RISCO ELEVADO DE MIGRAÇÃO',
