  foodLabel: string;
  lidLabel: string;
  durationLabel: string;
  hazardScoreLabel: string;
  burnRiskLabel: string;
  chemicalIndexLabel: string;
  mechanismHeader: string;
  actionHeader: string;
  copyBtn: string;
  copySuccess: string;
  printBtn: string;
  faqHeading: string;
  relatedHeading: string;
  badgeSafe: string;
  badgeCaution: string;
  badgeDanger: string;
  badgeCritical: string;
}> = {
  en: {
    tabSimulator: 'Steam & Warping Simulator',
    tabWarpageMatrix: 'Warped Container Damage Matrix',
    tabScience: 'The Science: Steam & Reflux',
    tabProtocols: 'Safe Venting & Swaps Protocol',
    containerLabel: '1. Select Container Material & Condition:',
    foodLabel: '2. Select Food Matrix & Chemistry:',
    lidLabel: '3. Select Lid & Cover Sealing State:',
    durationLabel: '4. Select Microwave Exposure Duration:',
    hazardScoreLabel: 'Overall Hazard Score',
    burnRiskLabel: 'Explosion & Splash Scald Risk',
    chemicalIndexLabel: 'Chemical & Microplastic Leaching Index',
    mechanismHeader: 'Scientific Mechanism Breakdown',
    actionHeader: 'Immediate Action & Safe Venting Protocol',
    copyBtn: 'Copy Safety Verdict',
    copySuccess: 'Safety Verdict Copied!',
    printBtn: 'Print / Save PDF',
