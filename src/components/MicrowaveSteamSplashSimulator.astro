---
import rawData from '../data/microwave-steam-splash-data.json';
import type { SupportedLanguage } from '../i18n/ui';
import { useTranslatedPath } from '../i18n/utils';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;
const translatePath = useTranslatedPath(lang);

const plasticLeachingUrl = translatePath('/tools/kitchen-plastic-leaching-checker/');
const plasticCodeCheckerUrl = translatePath('/tools/plastic-code-checker/');
const migrationPredictorUrl = translatePath('/tools/food-contact-migration-predictor/');
const plasticizerEstimatorUrl = translatePath('/tools/plasticizer-microplastic-burden-estimator/');
const panScratchUrl = translatePath('/tools/pan-scratch-inspector/');
const methodologyUrl = translatePath('/methodology/');
const allToolsUrl = translatePath('/tools/');

const currentLocale = (['en', 'es', 'pt', 'zh-cn', 'ja'].includes(lang) ? lang : 'en') as 'en' | 'es' | 'pt' | 'zh-cn' | 'ja';

const bannerData = rawData.safetyBanner[currentLocale] || rawData.safetyBanner.en;

const localizedContainers = rawData.containers.map((c: any) => ({
  id: c.id,
  name: c.name[currentLocale] || c.name.en,
  code: c.code,
  heatDeflectionTemp: c.heatDeflectionTemp,
  baseRisk: c.baseRisk,
  microplasticReleaseLevel: c.microplasticReleaseLevel
}));

const localizedFoods = rawData.foodMatrices.map((f: any) => ({
  id: f.id,
  name: f.name[currentLocale] || f.name.en,
  peakTemp: f.peakTemp,
  solventPower: f.solventPower,
  hazardMultiplier: f.hazardMultiplier
}));

const localizedLids = rawData.lidStates.map((l: any) => ({
  id: l.id,
  name: l.name[currentLocale] || l.name.en,
  pressureRisk: l.pressureRisk,
  refluxRisk: l.refluxRisk,
  riskScoreBoost: l.riskScoreBoost
}));

const localizedDurations = rawData.microwaveDurations.map((d: any) => ({
  id: d.id,
  name: d.name[currentLocale] || d.name.en,
  thermalLoad: d.thermalLoad
}));

const localizedWarpage = rawData.warpageMatrix.map((w: any) => ({
  id: w.id,
  name: w.name[currentLocale] || w.name.en,
  cause: w.cause[currentLocale] || w.cause.en,
  structuralIntegrity: w.structuralIntegrity,
  retirementAction: w.retirementAction[currentLocale] || w.retirementAction.en,
  severity: w.severity
}));

const localizedFaqs = rawData.faqs[currentLocale] || rawData.faqs.en;

const uiStrings: Record<'en' | 'es' | 'pt' | 'zh-cn' | 'ja', {
  tabSimulator: string;
  tabWarpageMatrix: string;
  tabScience: string;
  tabProtocols: string;
