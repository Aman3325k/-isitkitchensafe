<script is:inline define:vars={{ rawData, currentLocale, t }}>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Tab Navigation
    const tabButtons = document.querySelectorAll('.tab-btn');
    const tabPanels = document.querySelectorAll('.tab-panel');

    tabButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        tabButtons.forEach(b => {
          b.setAttribute('aria-selected', 'false');
          b.classList.remove('bg-signature-coral', 'text-white', 'shadow-sm');
          b.classList.add('bg-surface-soft', 'text-ink');
        });
        tabPanels.forEach(p => p.classList.add('hidden'));

        btn.setAttribute('aria-selected', 'true');
        btn.classList.add('bg-signature-coral', 'text-white', 'shadow-sm');
        btn.classList.remove('bg-surface-soft', 'text-ink');

        const activePanel = document.getElementById(targetId);
        if (activePanel) {
          activePanel.classList.remove('hidden');
        }
      });
    });

    // 2. Interactive Simulator
    const containerSelect = document.getElementById('container-select');
    const foodSelect = document.getElementById('food-select');
    const lidSelect = document.getElementById('lid-select');
    const durationSelect = document.getElementById('duration-select');

    const containerDetail = document.getElementById('container-detail');
    const foodDetail = document.getElementById('food-detail');
    const lidDetail = document.getElementById('lid-detail');

    const resultBadge = document.getElementById('result-badge');
    const resultCodeTag = document.getElementById('result-code-tag');
    const resultTitle = document.getElementById('result-title');
    const burnPercentage = document.getElementById('burn-percentage');
    const burnLevel = document.getElementById('burn-level');
    const burnBar = document.getElementById('burn-bar');
    const chemicalRating = document.getElementById('chemical-rating');
    const microplasticEstimate = document.getElementById('microplastic-estimate');
    const mechanismText = document.getElementById('mechanism-text');
    const actionText = document.getElementById('action-text');
    const resultCard = document.getElementById('result-card');
    const actionContainer = document.getElementById('action-container');

    function updateSimulation() {
      if (!containerSelect || !foodSelect || !lidSelect || !durationSelect) return;

      const cId = containerSelect.value;
      const fId = foodSelect.value;
      const lId = lidSelect.value;
      const dId = durationSelect.value;

      const container = rawData.containers.find(c => c.id === cId) || rawData.containers[0];
      const food = rawData.foodMatrices.find(f => f.id === fId) || rawData.foodMatrices[0];
      const lid = rawData.lidStates.find(l => l.id === lId) || rawData.lidStates[0];
      const duration = rawData.microwaveDurations.find(d => d.id === dId) || rawData.microwaveDurations[0];

      // Update helper hints
      if (containerDetail) containerDetail.textContent = 'Heat Deflection: ' + container.heatDeflectionTemp;
      if (foodDetail) foodDetail.textContent = 'Peak Food Hotspot Temp: ' + food.peakTemp;
      if (lidDetail) lidDetail.textContent = 'Ventilation Impact: ' + lid.pressureRisk;

      // Calculate Risks
      let burnScore = 5;
      if (lid.id === 'sealed_tight') burnScore += 65;
      else if (lid.id === 'cling_film_tight') burnScore += 55;
      else if (lid.id === 'vent_popped') burnScore += 10;
      else if (lid.id === 'loose_ajar') burnScore += 5;
      else burnScore += 0;

      if (food.id === 'high_fat') burnScore += 20;
      else if (food.id === 'acidic_fatty') burnScore += 15;

      if (duration.id === 'long') burnScore += 15;
      else if (duration.id === 'medium') burnScore += 8;

      burnScore = Math.min(100, Math.max(0, burnScore));

      // Calculate Chemical / Leaching Risk
      let chemLevel = 'Low';
      if (container.baseRisk === 'safe') {
        chemLevel = 'ZERO (Inert)';
      } else if (container.baseRisk === 'critical' || container.baseRisk === 'severe' || container.id === 'pp_warped') {
        chemLevel = (food.hazardMultiplier >= 3.0 || duration.id === 'long') ? 'Extreme Severe' : 'High';
      } else {
        if (food.hazardMultiplier >= 3.0 && duration.id !== 'short') chemLevel = 'High';
        else if (food.hazardMultiplier >= 2.0 || duration.id === 'long') chemLevel = 'Moderate';
        else chemLevel = 'Low';
      }

      // Overall Score
      let overallScore = 10;
      if (container.baseRisk === 'safe') {
        overallScore = Math.round(burnScore * 0.4);
      } else {
        let baseC = container.baseRisk === 'critical' ? 45 : container.baseRisk === 'severe' ? 40 : container.baseRisk === 'high' ? 30 : 15;
        overallScore = Math.min(100, Math.round(baseC * food.hazardMultiplier * 0.3 + burnScore * 0.4 + (lid.riskScoreBoost || 0) * 0.3));
      }

      // Display Updates
      if (resultCodeTag) resultCodeTag.textContent = container.code;
      if (burnPercentage) burnPercentage.textContent = burnScore + '%';
      if (burnBar) {
        burnBar.style.width = burnScore + '%';
        burnBar.className = burnScore > 60 ? 'h-full bg-red-600 transition-all duration-300' : burnScore > 30 ? 'h-full bg-amber-500 transition-all duration-300' : 'h-full bg-emerald-500 transition-all duration-300';
      }
      if (burnLevel) {
        burnLevel.textContent = burnScore > 60 ? 'CRITICAL DANGER' : burnScore > 30 ? 'ELEVATED' : 'MINIMAL';
        burnLevel.className = burnScore > 60 ? 'text-xs font-bold text-red-600' : burnScore > 30 ? 'text-xs font-bold text-amber-600' : 'text-xs font-bold text-emerald-600';
      }

      if (chemicalRating) {
        chemicalRating.textContent = chemLevel;
        chemicalRating.className = chemLevel.indexOf('Extreme') > -1 || chemLevel.indexOf('High') > -1 ? 'text-xl md:text-2xl font-black text-red-600' : chemLevel.indexOf('Moderate') > -1 ? 'text-xl md:text-2xl font-black text-amber-600' : 'text-xl md:text-2xl font-black text-emerald-600';
      }

      if (microplasticEstimate) {
        microplasticEstimate.textContent = container.microplasticReleaseLevel;
      }

      // Overall status styling
      if (container.baseRisk === 'safe' && burnScore < 40) {
        resultBadge.textContent = t.badgeSafe;
        resultBadge.className = 'px-3.5 py-1.5 rounded-full text-xs font-black tracking-wider uppercase bg-emerald-600 text-white';
        resultTitle.textContent = currentLocale === 'es' ? 'Condición Óptima: Calentamiento 100% Inerte y Seguro' : currentLocale === 'pt' ? 'Condição Ideal: Aquecimento Inerte e 100% Seguro' : currentLocale === 'zh-cn' ? '理想安全环境：完全无化学物质溶出与微塑料风险' : currentLocale === 'ja' ? '理想的な加熱環境：化学物質溶出ゼロ・極めて安全' : 'Optimal Safe Heating: Zero Plasticizer & Microplastic Leaching';
        resultCard.className = 'p-6 md:p-8 rounded-3xl border-2 border-emerald-500/40 shadow-md bg-surface';
        actionContainer.className = 'p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-ink space-y-1';
      } else if (overallScore >= 70 || burnScore >= 70) {
        resultBadge.textContent = t.badgeCritical;
        resultBadge.className = 'px-3.5 py-1.5 rounded-full text-xs font-black tracking-wider uppercase bg-red-600 text-white animate-pulse';
        resultTitle.textContent = currentLocale === 'es' ? '¡PELIGRO CRÍTICO! Riesgo de Explosión, Quemadura y Migración Tóxica' : currentLocale === 'pt' ? 'PERIGO CRÍTICO! Risco de Explosão, Queimadura e Migração Tóxica' : currentLocale === 'zh-cn' ? '严重危险！存在高温爆沸烫伤与剧烈塑化剂迁移隐患' : currentLocale === 'ja' ? '極めて危険！突沸火傷・容器変形・有害化学物質の大量溶出の恐れ' : 'CRITICAL HAZARD! Scald Explosion & Severe Chemical Migration';
        resultCard.className = 'p-6 md:p-8 rounded-3xl border-2 border-red-500 shadow-md bg-surface';
        actionContainer.className = 'p-4 rounded-2xl bg-red-500/10 border border-red-500/30 text-ink space-y-1';
      } else if (overallScore >= 45) {
        resultBadge.textContent = t.badgeDanger;
        resultBadge.className = 'px-3.5 py-1.5 rounded-full text-xs font-black tracking-wider uppercase bg-amber-600 text-white';
        resultTitle.textContent = currentLocale === 'es' ? 'Riesgo Elevado: Deformación Térmica y Reflujo Químico' : currentLocale === 'pt' ? 'Risco Elevado: Deformação Térmica e Refluxo Químico' : currentLocale === 'zh-cn' ? '较高风险：容器局部软化与冷凝液滴回流污染' : currentLocale === 'ja' ? '高リスク：熱変形と凝縮水滴による化学物質還流の恐れ' : 'Elevated Risk: Thermal Distortion & Condensation Chemical Reflux';
        resultCard.className = 'p-6 md:p-8 rounded-3xl border-2 border-amber-500/40 shadow-md bg-surface';
        actionContainer.className = 'p-4 rounded-2xl bg-amber-500/10 border border-amber-500/30 text-ink space-y-1';
      } else {
        resultBadge.textContent = t.badgeCaution;
        resultBadge.className = 'px-3.5 py-1.5 rounded-full text-xs font-black tracking-wider uppercase bg-blue-600 text-white';
        resultTitle.textContent = currentLocale === 'es' ? 'Precaución Moderada: Asegurar Ventilación Adecuada' : currentLocale === 'pt' ? 'Atenção Moderada: Assegure Ventilação Adequada' : currentLocale === 'zh-cn' ? '中度预警：需确保蒸汽顺畅排出并缩短加热时间' : currentLocale === 'ja' ? '中等度注意：通気口の確保と短時間加熱を推奨' : 'Moderate Caution: Ensure Continuous Steam Venting';
        resultCard.className = 'p-6 md:p-8 rounded-3xl border-2 border-blue-500/40 shadow-md bg-surface';
        actionContainer.className = 'p-4 rounded-2xl bg-blue-500/10 border border-blue-500/30 text-ink space-y-1';
      }

      // Mechanism explanation
      if (mechanismText) {
        if (container.baseRisk === 'safe') {
          mechanismText.textContent = 'Inert mineral substrate (' + container.code + ') does not undergo polymer scission or plasticizer extraction. Moisture from ' + food.id + ' vaporizes safely without chemical carryover.';
        } else {
          mechanismText.textContent = 'Heating ' + food.id + ' creates hot spots approaching ' + food.peakTemp + '. With lid state \'' + lid.id + '\', ' + lid.refluxRisk.toLowerCase() + '. Polypropylene/plastic matrix sheds microplastics into hot droplets falling back into the food (ACS Nano 2023).';
        }
      }

      // Action recommendations
      if (actionText) {
        if (lid.id === 'sealed_tight') {
          actionText.textContent = currentLocale === 'es' ? '¡NUNCA cierres la tapa por completo! Abre la válvula de vapor o retira la tapa y cúbrela con papel toalla o plato cerámico antes de encender el microondas.' : currentLocale === 'pt' ? 'NUNCA ligue o micro-ondas com a tampa travada! Destrave as 4 abas ou use papel toalha para evitar vácuo e queimaduras graves.' : currentLocale === 'zh-cn' ? '严禁四边扣死直接微波！请立即将盒盖排气阀拔起，或取下塑料盖改用倒扣瓷盘或原色厨房纸巾覆盖。' : currentLocale === 'ja' ? '絶対に完全密閉したまま加熱しないでください！蒸気弁を全開にするか、蓋を外して裏返した陶器皿を被せてください。' : 'NEVER microwave with an airtight sealed lid! Pop open the steam release valve immediately or replace the lid with an inverted ceramic plate or unbleached paper towel.';
        } else if (container.id === 'pp_warped' || container.id === 'takeout_tub') {
          actionText.textContent = currentLocale === 'es' ? 'Este recipiente está dañado o no es apto. Transfiere la comida de inmediato a un plato de cerámica o tazón de vidrio antes de recalentar.' : currentLocale === 'pt' ? 'Este recipiente está degradado ou inadequado. Transfira a refeição imediatamente para louça de cerâmica ou vidro antes de aquecer.' : currentLocale === 'zh-cn' ? '该塑料盒已老化受损或属于一次性制品。请立即将食物转移至无铅陶瓷碗或高硼硅玻璃保鲜盒中再行加热。' : currentLocale === 'ja' ? 'この容器は劣化または使い捨て用です。加熱前に必ず耐熱ガラスまたは陶器の器に移し替えてください。' : 'This container is physically degraded or single-use. Immediately transfer food into a ceramic bowl or borosilicate glass container before heating.';
        } else if (food.id === 'high_fat') {
          actionText.textContent = currentLocale === 'es' ? 'Los aceites superan los 160 °C y derretirán el plástico. Usa recipientes de vidrio borosilicato o cerámica con cubierta de silicona para alimentos grasosos.' : currentLocale === 'pt' ? 'Gorduras ultrapassam 160 °C e fundem o plástico. Utilize exclusivamente travessas de vidro ou cerâmica para reaquecer pratos gordurosos.' : currentLocale === 'zh-cn' ? '高油脂食物局部油温极易超过 160°C 熔蚀塑料。请务必使用高硼硅耐热玻璃或陶瓷碗盛装加热，切勿使用任何塑料盒。' : currentLocale === 'ja' ? '油分は160℃を超えて樹脂を溶融させます。高油分の料理は必ず耐熱ガラスまたは陶器容器で加熱してください。' : 'Fatty foods superheat beyond 160°C and will melt polypropylene. Always reheat gravies, bacon, and curry in ceramic or borosilicate glass dishes.';
        } else {
          actionText.textContent = currentLocale === 'es' ? 'Mantén la ventilación abierta y espera 30 segundos tras terminar el ciclo antes de retirar la tapa para prevenir quemaduras de vapor.' : currentLocale === 'pt' ? 'Mantenha a tampa semiaberta e aguarde 30 segundos após o término para que o vapor estabilize antes de abrir.' : currentLocale === 'zh-cn' ? '保持排气口通畅，加热完毕后请静置等待 30 秒再开盖，以避免高温蒸汽烫伤面部和手部。' : currentLocale === 'ja' ? '蒸気の逃げ道を確保し、加熱終了後は蒸気圧が抜けるまで30秒待ってから蓋を開けてください。' : 'Ensure continuous steam ventilation and wait 30 seconds after heating stops before lifting the cover to allow internal pressure to equalize.';
        }
      }
    }

    if (containerSelect) containerSelect.addEventListener('change', updateSimulation);
    if (foodSelect) foodSelect.addEventListener('change', updateSimulation);
    if (lidSelect) lidSelect.addEventListener('change', updateSimulation);
    if (durationSelect) durationSelect.addEventListener('change', updateSimulation);

    updateSimulation();

    // 3. Copy Verdict
    const copyBtn = document.getElementById('copy-verdict-btn');
    const copyText = document.getElementById('copy-text');
    if (copyBtn && copyText) {
      copyBtn.addEventListener('click', async () => {
        const textToCopy = 'IsItKitchenSafe: Microwave Steam & Plastic Leaching Verdict\\n- Container: ' + containerSelect.value + '\\n- Food: ' + foodSelect.value + '\\n- Lid: ' + lidSelect.value + '\\n- Scald Risk: ' + burnPercentage.textContent + '\\n- Chemical Index: ' + chemicalRating.textContent + '\\n- Recommendation: ' + actionText.textContent + '\\nVerified via ACS Nano 2023 & FDA Standards: https://isitkitchensafe.com/tools/microwave-steam-splash-simulator/';
        try {
          await navigator.clipboard.writeText(textToCopy);
          copyText.textContent = t.copySuccess;
          setTimeout(() => { copyText.textContent = t.copyBtn; }, 2500);
        } catch (e) {
          console.error('Clipboard copy failed', e);
        }
      });
    }
  });
</script>
