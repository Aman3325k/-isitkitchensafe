<div id="power-outage-checker-root" class="space-y-12">
  <!-- Main Interactive Checker Card -->
  <section
    id="power-outage-food-safety-checker"
    class="bg-canvas border border-hairline rounded-2xl shadow-sm overflow-hidden"
    aria-label={t.ariaLabel}
  >
    <script type="application/json" id="pofs-payload" set:html={JSON.stringify(clientPayload)} />

    <div class="grid grid-cols-1 lg:grid-cols-12 divide-y lg:divide-y-0 lg:divide-x divide-hairline">
      <!-- Left Column: Interactive Outage Controls -->
      <div class="lg:col-span-6 p-5 sm:p-6 space-y-6 print:hidden">
        <!-- Step 1: Compartment Mode -->
        <div class="space-y-3">
          <h2 class="text-title-sm font-semibold text-ink">{t.step1Title}</h2>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2" role="radiogroup" aria-label={t.step1Title}>
            <button
              type="button"
              role="radio"
              aria-checked="true"
              data-pofs-mode="fridge"
              class="pofs-mode-btn min-h-[68px] p-3 rounded-xl border text-left transition-all cursor-pointer bg-primary text-on-primary border-primary shadow-sm"
            >
              <span class="block text-sm font-bold leading-snug">🧊 {t.modeFridge}</span>
              <span class="block text-[11px] opacity-85 mt-0.5 leading-tight">{t.modeFridgeSub}</span>
            </button>
            <button
              type="button"
              role="radio"
              aria-checked="false"
              data-pofs-mode="freezer-full"
              class="pofs-mode-btn min-h-[68px] p-3 rounded-xl border text-left transition-all cursor-pointer bg-canvas text-ink border-hairline hover:border-border-strong"
            >
              <span class="block text-sm font-bold leading-snug">❄️ {t.modeFreezerFull}</span>
              <span class="block text-[11px] opacity-80 mt-0.5 leading-tight">{t.modeFreezerFullSub}</span>
            </button>
            <button
              type="button"
              role="radio"
              aria-checked="false"
              data-pofs-mode="freezer-half"
              class="pofs-mode-btn min-h-[68px] p-3 rounded-xl border text-left transition-all cursor-pointer bg-canvas text-ink border-hairline hover:border-border-strong"
            >
              <span class="block text-sm font-bold leading-snug">🧊 {t.modeFreezerHalf}</span>
              <span class="block text-[11px] opacity-80 mt-0.5 leading-tight">{t.modeFreezerHalfSub}</span>
            </button>
          </div>
        </div>

        <!-- Step 2: Hours Without Power Slider + Quick Presets -->
        <div class="p-4 rounded-xl bg-surface-soft border border-hairline space-y-3">
          <div class="flex items-center justify-between gap-2">
            <label for="pofs-hours-slider" class="text-xs sm:text-sm font-semibold text-ink">
              {t.step2Title}
            </label>
            <span
              id="pofs-hours-display"
              class="px-3 py-1 rounded-full text-sm font-mono font-extrabold bg-signature-coral text-white"
            >
              {defaultHours} {t.hoursUnit}
            </span>
          </div>

          <input
            type="range"
            id="pofs-hours-slider"
