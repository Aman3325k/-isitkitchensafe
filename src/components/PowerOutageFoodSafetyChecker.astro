<script is:inline>
  (function () {
    const payloadEl = document.getElementById('pofs-payload');
    if (!payloadEl) return;

    let payload;
    try {
      payload = JSON.parse(payloadEl.textContent || '{}');
    } catch (_) {
      return;
    }

    const foods = payload.foods || [];
    const ui = payload.ui || {};
    const foodById = new Map(foods.map((f) => [f.id, f]));

    // Controls
    const modeBtns = Array.from(document.querySelectorAll('.pofs-mode-btn'));
    const hourBtns = Array.from(document.querySelectorAll('.pofs-hour-btn'));
    const doorBtns = Array.from(document.querySelectorAll('.pofs-door-btn'));
    const roomBtns = Array.from(document.querySelectorAll('.pofs-room-btn'));
    const thermoModeBtns = Array.from(document.querySelectorAll('.pofs-thermo-mode-btn'));
    const unitBtns = Array.from(document.querySelectorAll('.pofs-unit-btn'));
    const scopeBtns = Array.from(document.querySelectorAll('.pofs-scope-btn'));
    const filterBtns = Array.from(document.querySelectorAll('.pofs-filter-btn'));
    const cardEls = Array.from(document.querySelectorAll('.pofs-food-card'));
    const checkboxEls = Array.from(document.querySelectorAll('.pofs-item-checkbox'));

    const hoursSlider = document.getElementById('pofs-hours-slider');
    const hoursDisplay = document.getElementById('pofs-hours-display');
    const thermoPanel = document.getElementById('pofs-thermo-panel');
    const tempInput = document.getElementById('pofs-temp-input');
    const searchInput = document.getElementById('pofs-search-input');

    // Dashboard elements
    const verdictBanner = document.getElementById('pofs-verdict-banner');
    const conditionPill = document.getElementById('pofs-condition-pill');
    const bannerIcon = document.getElementById('pofs-banner-icon');
    const bannerTitle = document.getElementById('pofs-banner-title');
    const bannerSub = document.getElementById('pofs-banner-sub');
    const windowRatio = document.getElementById('pofs-window-ratio');
    const windowBar = document.getElementById('pofs-window-bar');

    const countKeepEl = document.getElementById('pofs-count-keep');
    const countCookEl = document.getElementById('pofs-count-cook');
    const countCheckEl = document.getElementById('pofs-count-check');
    const countDiscardEl = document.getElementById('pofs-count-discard');

    const pillAllEl = document.getElementById('pofs-pill-all');
    const pillKeepEl = document.getElementById('pofs-pill-keep');
    const pillCookEl = document.getElementById('pofs-pill-cook');
    const pillCheckEl = document.getElementById('pofs-pill-check');
    const pillDiscardEl = document.getElementById('pofs-pill-discard');
    const emptyStateEl = document.getElementById('pofs-empty-state');

    const copyBtn = document.getElementById('pofs-copy-btn');
    const copyLabel = document.getElementById('pofs-copy-label');
    const printBtn = document.getElementById('pofs-print-btn');
    const resetBtn = document.getElementById('pofs-reset-btn');

    const state = {
      mode: 'fridge',
      hours: 6,
      doorOpened: false,
      roomTemp: 'normal',
      useThermometer: false,
      tempUnit: payload.defaultTempUnit || 'F',
      tempValue: (payload.defaultTempUnit || 'F') === 'F' ? 45 : 7,
      scope: 'current',
      filter: 'all',
      query: '',
      checkedIds: new Set()
    };

    let lastChecklistText = '';

    function getSafeWindowHours(mode, doorOpened, roomTemp) {
      const isHeat = roomTemp === 'heatwave';
      if (mode === 'fridge') {
        if (isHeat) return doorOpened ? 1 : 2;
        return doorOpened ? 2 : 4;
      }
      if (mode === 'freezer-full') {
        if (isHeat) return doorOpened ? 24 : 36;
        return doorOpened ? 36 : 48;
      }
      if (isHeat) return doorOpened ? 12 : 18;
      return doorOpened ? 18 : 24;
    }

    function toTempF(val, unit) {
      return unit === 'C' ? (val * 9) / 5 + 32 : val;
    }

    function evaluateFood(food) {
      const isFreezer = state.mode !== 'fridge';
      const safeWindow = getSafeWindowHours(state.mode, state.doorOpened, state.roomTemp);
      const dangerLimit = state.roomTemp === 'heatwave' ? 1 : 2;
      const rt = food.ruleType;

      if (rt === 'shelf-stable' || rt === 'shelf-stable-juice' || rt === 'shelf-stable-frozen') {
        return 'keep';
      }

      if (rt === 'mayo-condiment') {
        if (state.useThermometer) {
          const tempF = toTempF(state.tempValue, state.tempUnit);
          if (tempF <= 50) return 'keep';
          return state.hours > 8 ? 'discard' : 'keep';
        }
        return state.hours > safeWindow + 8 ? 'discard' : 'keep';
      }

      if (state.useThermometer) {
        const tempF = toTempF(state.tempValue, state.tempUnit);

        if (rt === 'frozen-ice-cream') {
          return tempF <= 20 ? 'keep' : 'discard';
        }

        if (rt === 'infant-strict') {
          if (isFreezer) {
            if (tempF <= 28) return 'keep';
            if (tempF <= 40) return 'cook';
            return state.hours <= dangerLimit ? 'cook' : 'discard';
          }
          if (tempF <= 40) return 'keep';
          return state.hours <= dangerLimit ? 'cook' : 'discard';
        }

        if (isFreezer || rt === 'frozen-perishable' || rt === 'frozen-veg') {
          if (tempF <= 32) return 'keep';
          if (tempF <= 40) return 'cook';
          if (rt === 'frozen-veg') {
            return state.hours <= 6 ? 'cook' : 'discard';
          }
          return state.hours <= dangerLimit ? 'cook' : 'discard';
        }

        if (tempF <= 40) return 'keep';
        return state.hours <= dangerLimit ? 'cook' : 'discard';
      }

      if (isFreezer || rt === 'frozen-perishable' || rt === 'frozen-veg' || rt === 'frozen-ice-cream') {
        if (rt === 'frozen-ice-cream') {
          if (state.mode === 'fridge') return state.hours <= 1 ? 'check-ice' : 'discard';
          if (state.hours <= Math.round(safeWindow * 0.35)) return 'keep';
          if (state.hours <= Math.round(safeWindow * 0.5)) return 'check-ice';
          return 'discard';
        }

        const effWindow = state.mode === 'fridge' ? (state.roomTemp === 'heatwave' ? 12 : 24) : safeWindow;
        if (state.hours <= Math.round(effWindow * 0.5)) return 'keep';
        if (state.hours <= effWindow) return 'check-ice';
        if (rt === 'frozen-veg' && state.hours <= effWindow + 6) return 'check-ice';
        if (state.hours <= effWindow + 4) return 'check-ice';
        return 'discard';
      }

      if (state.hours < safeWindow) return 'keep';
      if (state.hours === safeWindow) {
        return rt === 'perishable-cookable' ? 'cook' : 'keep';
      }
      return 'discard';
    }

    function getModeLabel(mode) {
      if (mode === 'freezer-full') return ui.modeFreezerFull || 'Freezer (Full)';
      if (mode === 'freezer-half') return ui.modeFreezerHalf || 'Freezer (Half-Full)';
      return ui.modeFridge || 'Refrigerator';
    }

    function getNoteForVerdict(food, verdict) {
      if (verdict === 'keep') return food.keepNote;
      if (verdict === 'cook') return food.cookNote;
      if (verdict === 'check-ice') return food.checkIceNote;
      return food.discardNote;
    }

    function getPillText(verdict) {
      if (verdict === 'keep') return ui.verdictKeep || 'SAFE TO KEEP';
      if (verdict === 'cook') return ui.verdictCook || 'COOK / USE NOW';
      if (verdict === 'check-ice') return ui.verdictCheckIce || 'CHECK ICE CRYSTALS';
      return ui.verdictDiscard || 'DISCARD';
    }

    function applyButtonStyles() {
      modeBtns.forEach((btn) => {
        const active = btn.getAttribute('data-pofs-mode') === state.mode;
        btn.setAttribute('aria-checked', active ? 'true' : 'false');
        btn.classList.toggle('bg-primary', active);
        btn.classList.toggle('text-on-primary', active);
        btn.classList.toggle('border-primary', active);
        btn.classList.toggle('shadow-sm', active);
        btn.classList.toggle('bg-canvas', !active);
        btn.classList.toggle('text-ink', !active);
        btn.classList.toggle('border-hairline', !active);
      });

      hourBtns.forEach((btn) => {
        const h = parseInt(btn.getAttribute('data-pofs-hour-preset') || '-1', 10);
        const active = h === state.hours;
        btn.classList.toggle('bg-signature-coral', active);
        btn.classList.toggle('text-white', active);
        btn.classList.toggle('border-signature-coral', active);
        btn.classList.toggle('shadow-sm', active);
        btn.classList.toggle('bg-canvas', !active);
        btn.classList.toggle('text-ink', !active);
        btn.classList.toggle('border-hairline', !active);
      });

      doorBtns.forEach((btn) => {
        const isOpenedBtn = btn.getAttribute('data-pofs-door') === 'opened';
        const active = isOpenedBtn === state.doorOpened;
        btn.setAttribute('aria-checked', active ? 'true' : 'false');
        btn.classList.toggle('bg-primary', active);
        btn.classList.toggle('text-on-primary', active);
        btn.classList.toggle('border-primary', active);
        btn.classList.toggle('shadow-sm', active);
        btn.classList.toggle('bg-canvas', !active);
        btn.classList.toggle('text-ink', !active);
        btn.classList.toggle('border-hairline', !active);
      });

      roomBtns.forEach((btn) => {
        const active = btn.getAttribute('data-pofs-room') === state.roomTemp;
        btn.setAttribute('aria-checked', active ? 'true' : 'false');
        btn.classList.toggle('bg-primary', active);
        btn.classList.toggle('text-on-primary', active);
        btn.classList.toggle('border-primary', active);
        btn.classList.toggle('shadow-sm', active);
        btn.classList.toggle('bg-canvas', !active);
        btn.classList.toggle('text-ink', !active);
        btn.classList.toggle('border-hairline', !active);
      });

      thermoModeBtns.forEach((btn) => {
        const isOn = btn.getAttribute('data-pofs-thermo-mode') === 'on';
        const active = isOn === state.useThermometer;
        btn.setAttribute('aria-checked', active ? 'true' : 'false');
        btn.classList.toggle('bg-primary', active);
        btn.classList.toggle('text-on-primary', active);
        btn.classList.toggle('text-ink', !active);
      });

      if (thermoPanel) {
        thermoPanel.classList.toggle('hidden', !state.useThermometer);
      }

      unitBtns.forEach((btn) => {
        const active = btn.getAttribute('data-pofs-unit') === state.tempUnit;
        btn.setAttribute('aria-checked', active ? 'true' : 'false');
        btn.classList.toggle('bg-signature-coral', active);
        btn.classList.toggle('text-white', active);
        btn.classList.toggle('text-ink', !active);
      });

      scopeBtns.forEach((btn) => {
        const active = btn.getAttribute('data-pofs-scope') === state.scope;
        btn.setAttribute('aria-checked', active ? 'true' : 'false');
        btn.classList.toggle('bg-primary', active);
        btn.classList.toggle('text-on-primary', active);
        btn.classList.toggle('text-ink', !active);
      });

      filterBtns.forEach((btn) => {
        const active = btn.getAttribute('data-pofs-filter') === state.filter;
        btn.setAttribute('aria-pressed', active ? 'true' : 'false');
        btn.classList.toggle('bg-primary', active);
        btn.classList.toggle('text-on-primary', active);
        btn.classList.toggle('border-primary', active);
        btn.classList.toggle('bg-canvas', !active);
        btn.classList.toggle('text-ink', !active);
        btn.classList.toggle('border-hairline', !active);
      });
    }

    function updateCardVisuals(cardEl, verdict, noteText, isChecked) {
      cardEl.setAttribute('data-pofs-verdict', verdict);
      cardEl.classList.remove(
        'border-success-border/60',
        'bg-canvas',
        'border-warning-border/80',
        'bg-warning-bg/35',
        'dark:bg-amber-950/20',
        'border-info-border/70',
        'bg-blue-50/40',
        'dark:bg-blue-950/20',
        'border-error-border/70',
        'bg-error-bg/45',
        'dark:bg-red-950/20',
        'opacity-60'
      );

      if (verdict === 'keep') {
        cardEl.classList.add('border-success-border/60', 'bg-canvas');
      } else if (verdict === 'cook') {
        cardEl.classList.add('border-warning-border/80', 'bg-warning-bg/35', 'dark:bg-amber-950/20');
      } else if (verdict === 'check-ice') {
        cardEl.classList.add('border-info-border/70', 'bg-blue-50/40', 'dark:bg-blue-950/20');
      } else {
        cardEl.classList.add('border-error-border/70', 'bg-error-bg/45', 'dark:bg-red-950/20');
      }

      if (isChecked) {
        cardEl.classList.add('opacity-60');
      }

      const titleEl = cardEl.querySelector('.pofs-card-title');
      if (titleEl) {
        titleEl.classList.toggle('line-through', isChecked);
      }

      const pillEl = cardEl.querySelector('[data-pofs-card-pill]');
      if (pillEl) {
        pillEl.className = 'shrink-0 ' + (
          verdict === 'keep'
            ? 'badge-yes'
            : verdict === 'cook'
              ? 'badge-depends'
              : verdict === 'check-ice'
                ? 'badge-time'
                : 'badge-no'
        );
        pillEl.textContent = getPillText(verdict);
      }

      const noteEl = cardEl.querySelector('[data-pofs-card-note]');
      if (noteEl) {
        noteEl.textContent = noteText;
      }
    }

    function render() {
      applyButtonStyles();

      if (hoursSlider) hoursSlider.value = String(state.hours);
      if (hoursDisplay) hoursDisplay.textContent = state.hours + ' ' + (ui.hoursUnit || 'hrs');

      const safeWindow = getSafeWindowHours(state.mode, state.doorOpened, state.roomTemp);
      const isFreezer = state.mode !== 'fridge';
      const targetCompKey = isFreezer ? 'freezer' : 'fridge';
      const queryLower = state.query.trim().toLowerCase();

      const counts = { all: 0, keep: 0, cook: 0, checkIce: 0, discard: 0 };
      const buckets = { keep: [], cook: [], checkIce: [], discard: [] };
      let visibleCount = 0;

      cardEls.forEach((cardEl) => {
        const fid = cardEl.getAttribute('data-pofs-card') || '';
        const food = foodById.get(fid);
        if (!food) return;

        const verdict = evaluateFood(food);
        const noteText = getNoteForVerdict(food, verdict);
        const isChecked = state.checkedIds.has(fid);
        updateCardVisuals(cardEl, verdict, noteText, isChecked);

        const inCompartment = food.compartments.includes(targetCompKey);
        const inScope = state.scope === 'all' || queryLower.length > 0 || inCompartment;

        if (inScope) {
          counts.all += 1;
          if (verdict === 'keep') {
            counts.keep += 1;
            buckets.keep.push(food.name);
          } else if (verdict === 'cook') {
            counts.cook += 1;
            buckets.cook.push(food.name);
          } else if (verdict === 'check-ice') {
            counts.checkIce += 1;
            buckets.checkIce.push(food.name);
          } else {
            counts.discard += 1;
            buckets.discard.push(food.name);
          }
        }

        const matchesFilter = state.filter === 'all' || state.filter === verdict;
        const matchesQuery =
          queryLower.length === 0 ||
          food.name.toLowerCase().includes(queryLower) ||
          food.examples.toLowerCase().includes(queryLower) ||
          noteText.toLowerCase().includes(queryLower);

        const showCard = inScope && matchesFilter && matchesQuery;
        cardEl.classList.toggle('hidden', !showCard);
        if (showCard) visibleCount += 1;
      });

      if (emptyStateEl) {
        emptyStateEl.classList.toggle('hidden', visibleCount > 0);
      }

      // Update counts
      if (countKeepEl) countKeepEl.textContent = String(counts.keep);
      if (countCookEl) countCookEl.textContent = String(counts.cook);
      if (countCheckEl) countCheckEl.textContent = String(counts.checkIce);
      if (countDiscardEl) countDiscardEl.textContent = String(counts.discard);

      if (pillAllEl) pillAllEl.textContent = String(counts.all);
      if (pillKeepEl) pillKeepEl.textContent = String(counts.keep);
      if (pillCookEl) pillCookEl.textContent = String(counts.cook);
      if (pillCheckEl) pillCheckEl.textContent = String(counts.checkIce);
      if (pillDiscardEl) pillDiscardEl.textContent = String(counts.discard);

      // Condition pill text
      if (conditionPill) {
        const doorText = state.doorOpened ? (ui.copyDoorYes || 'Door opened') : (ui.copyDoorNo || 'Door closed');
        const thermoTag = state.useThermometer ? ' · ' + state.tempValue + '°' + state.tempUnit : '';
        conditionPill.textContent = getModeLabel(state.mode) + ' · ' + state.hours + (ui.hoursUnit || 'h') + ' · ' + doorText + thermoTag;
      }

      // Progress gauge
      const pct = Math.min(100, Math.round((state.hours / Math.max(1, safeWindow)) * 100));
      if (windowRatio) {
        windowRatio.textContent =
          state.hours + 'h / ' + safeWindow + 'h (' + (ui.safeWindowLabel || 'Safe window') + ': ' + safeWindow + 'h)';
      }

      // Banner state (color, icon, headline, progress bar color)
      let tone = 'safe';
      let bIcon = '✅';
      let bTitle = ui.bannerSafeTitle;
      let bSub = ui.bannerSafeSub;

      if (state.useThermometer) {
        const tempF = toTempF(state.tempValue, state.tempUnit);
        if (tempF <= 40) {
          tone = 'safe';
          bIcon = '✅';
          bTitle = ui.bannerThermoSafeTitle;
          bSub = ui.bannerThermoSafeSub;
        } else {
          tone = 'danger';
          bIcon = '🚨';
          bTitle = ui.bannerThermoDangerTitle;
          bSub = ui.bannerThermoDangerSub;
        }
      } else if (isFreezer) {
        if (state.hours <= Math.round(safeWindow * 0.5)) {
          tone = 'safe';
          bIcon = '❄️';
          bTitle = ui.bannerSafeTitle;
          bSub = ui.bannerSafeSub;
        } else if (state.hours <= safeWindow + 4) {
          tone = 'info';
          bIcon = '🧊';
          bTitle = ui.bannerCheckIceTitle;
          bSub = ui.bannerCheckIceSub;
        } else {
          tone = 'danger';
          bIcon = '🚨';
          bTitle = ui.bannerDangerTitle;
          bSub = ui.bannerDangerSub;
        }
      } else {
        if (state.hours < safeWindow) {
          tone = 'safe';
          bIcon = '✅';
          bTitle = ui.bannerSafeTitle;
          bSub = ui.bannerSafeSub;
        } else if (state.hours === safeWindow) {
          tone = 'warn';
          bIcon = '⚠️';
          bTitle = ui.bannerLimitTitle;
          bSub = ui.bannerLimitSub;
        } else {
          tone = 'danger';
          bIcon = '🚨';
          bTitle = ui.bannerDangerTitle;
          bSub = ui.bannerDangerSub;
        }
      }

      if (bannerIcon) bannerIcon.textContent = bIcon;
      if (bannerTitle) bannerTitle.textContent = bTitle || '';
      if (bannerSub) bannerSub.textContent = bSub || '';

      if (verdictBanner) {
        verdictBanner.classList.remove('border-success-border', 'border-warning-border', 'border-info-border', 'border-error-border');
        verdictBanner.classList.add(
          tone === 'safe'
            ? 'border-success-border'
            : tone === 'warn'
              ? 'border-warning-border'
              : tone === 'info'
                ? 'border-info-border'
                : 'border-error-border'
        );
      }

      if (windowBar) {
        windowBar.style.width = pct + '%';
        windowBar.classList.remove('bg-success-border', 'bg-warning-border', 'bg-info-border', 'bg-error-border');
        windowBar.classList.add(
          tone === 'safe'
            ? 'bg-success-border'
            : tone === 'warn'
              ? 'bg-warning-border'
              : tone === 'info'
                ? 'bg-info-border'
                : 'bg-error-border'
        );
      }

      // Build plain-text Outage Discard Checklist (zero HTML tags)
      const doorCopy = state.doorOpened ? (ui.copyDoorYes || 'Door opened') : (ui.copyDoorNo || 'Door closed');
      const roomCopy = state.roomTemp === 'heatwave' ? (ui.roomHeatwaveLabel || 'Heatwave >=90F') : (ui.roomNormalLabel || 'Normal <90F');
      const thermoCopy = state.useThermometer ? state.tempValue + '°' + state.tempUnit : (ui.copyThermoNone || 'No thermometer');

      const lines = [
        ui.copyHeader || 'Power Outage Food Safety Checklist',
        (ui.copyConditionLine || 'Conditions') + ': ' + getModeLabel(state.mode) + ' | ' + state.hours + 'h | ' + doorCopy + ' | ' + roomCopy + ' | ' + thermoCopy,
        '',
        ui.copyDiscardSection || 'DISCARD:',
        buckets.discard.length > 0 ? buckets.discard.map((n) => '  [ ] ' + n).join('\n') : '  - ' + (ui.copyNone || 'None')
      ];

      if (buckets.checkIce.length > 0) {
        lines.push('', ui.copyCheckSection || 'CHECK ICE CRYSTALS:', buckets.checkIce.map((n) => '  [ ] ' + n).join('\n'));
      }
      if (buckets.cook.length > 0) {
        lines.push('', ui.copyCookSection || 'COOK / USE NOW:', buckets.cook.map((n) => '  [ ] ' + n).join('\n'));
      }
      lines.push(
        '',
        ui.copyKeepSection || 'SAFE TO KEEP:',
        buckets.keep.length > 0 ? buckets.keep.map((n) => '  [x] ' + n).join('\n') : '  - ' + (ui.copyNone || 'None')
      );

      lastChecklistText = lines.join('\n');
    }

    // Event bindings
    modeBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const m = btn.getAttribute('data-pofs-mode');
        if (m) {
          state.mode = m;
          state.filter = 'all';
          render();
        }
      });
    });

    if (hoursSlider) {
      hoursSlider.addEventListener('input', () => {
        const v = parseInt(hoursSlider.value || '0', 10);
        if (!isNaN(v)) {
          state.hours = Math.max(0, Math.min(72, v));
          render();
        }
      });
    }

    hourBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const h = parseInt(btn.getAttribute('data-pofs-hour-preset') || '0', 10);
        if (!isNaN(h)) {
          state.hours = h;
          render();
        }
      });
    });

    doorBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        state.doorOpened = btn.getAttribute('data-pofs-door') === 'opened';
        render();
      });
    });

    roomBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        state.roomTemp = btn.getAttribute('data-pofs-room') === 'heatwave' ? 'heatwave' : 'normal';
        render();
      });
    });

    thermoModeBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        state.useThermometer = btn.getAttribute('data-pofs-thermo-mode') === 'on';
        render();
      });
    });

    if (tempInput) {
      tempInput.addEventListener('input', () => {
        const parsed = parseFloat(tempInput.value);
        if (!isNaN(parsed)) {
          state.tempValue = parsed;
          render();
        }
      });
    }

    unitBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const nextUnit = btn.getAttribute('data-pofs-unit') === 'C' ? 'C' : 'F';
        if (nextUnit !== state.tempUnit) {
          if (nextUnit === 'C') {
            state.tempValue = Math.round(((state.tempValue - 32) * 5) / 9);
          } else {
            state.tempValue = Math.round((state.tempValue * 9) / 5 + 32);
          }
          state.tempUnit = nextUnit;
          if (tempInput) tempInput.value = String(state.tempValue);
          render();
        }
      });
    });

    scopeBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        state.scope = btn.getAttribute('data-pofs-scope') === 'all' ? 'all' : 'current';
        render();
      });
    });

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        state.filter = btn.getAttribute('data-pofs-filter') || 'all';
        render();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', () => {
        state.query = searchInput.value || '';
        render();
      });
    }

    checkboxEls.forEach((cb) => {
      cb.addEventListener('change', () => {
        const fid = cb.getAttribute('data-pofs-check') || '';
        if (cb.checked) {
          state.checkedIds.add(fid);
        } else {
          state.checkedIds.delete(fid);
        }
        render();
      });
    });

    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        const showCopied = () => {
          if (copyLabel) copyLabel.textContent = ui.copiedChecklistBtn || 'Checklist Copied ✓';
          window.setTimeout(() => {
            if (copyLabel) copyLabel.textContent = '📋 ' + (ui.copyChecklistBtn || 'Copy Discard Checklist');
          }, 2200);
        };

        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(lastChecklistText).then(showCopied).catch(showCopied);
        } else {
          const ta = document.createElement('textarea');
          ta.value = lastChecklistText;
          ta.setAttribute('readonly', '');
          ta.style.position = 'absolute';
          ta.style.left = '-9999px';
          document.body.appendChild(ta);
          ta.select();
          try {
            document.execCommand('copy');
          } catch (_) {
            // ignore
          }
          document.body.removeChild(ta);
          showCopied();
        }
      });
    }

    if (printBtn) {
      printBtn.addEventListener('click', () => {
        window.print();
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        state.mode = 'fridge';
        state.hours = 6;
        state.doorOpened = false;
        state.roomTemp = 'normal';
        state.useThermometer = false;
        state.tempUnit = payload.defaultTempUnit || 'F';
        state.tempValue = state.tempUnit === 'F' ? 45 : 7;
        state.scope = 'current';
        state.filter = 'all';
        state.query = '';
        state.checkedIds.clear();
        if (tempInput) tempInput.value = String(state.tempValue);
        if (searchInput) searchInput.value = '';
        checkboxEls.forEach((cb) => {
          cb.checked = false;
        });
        render();
      });
    }

    render();
  })();
</script>
