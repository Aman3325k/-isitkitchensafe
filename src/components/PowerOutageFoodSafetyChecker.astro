import rawData from '../data/power-outage-food-safety-data.json';
import type { SupportedLanguage } from '../i18n/ui';
import { useTranslatedPath } from '../i18n/utils';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;
const translatePath = useTranslatedPath(lang);

const leftoverUrl = translatePath('/tools/leftover-shelf-life-calculator/');
const thawingUrl = translatePath('/tools/meat-thawing-calculator/');
const refreezeUrl = translatePath('/refreeze/');
const methodologyUrl = translatePath('/methodology/');
const allToolsUrl = translatePath('/tools/');

type CompartmentMode = 'fridge' | 'freezer-full' | 'freezer-half';
type RoomTempMode = 'normal' | 'heatwave';
type VerdictType = 'keep' | 'cook' | 'check-ice' | 'discard';

interface LocalizedFood {
  id: string;
  icon: string;
  compartments: string[];
  ruleType: string;
  name: string;
  examples: string;
  keepNote: string;
  cookNote: string;
  checkIceNote: string;
  discardNote: string;
}

const localizedFoods: LocalizedFood[] = rawData.foods.map((f) => {
  const tr = (f.i18n as Record<string, any>)[lang] || f.i18n.en;
  return {
    id: f.id,
    icon: f.icon,
    compartments: f.compartments,
    ruleType: f.ruleType,
    name: tr.name,
    examples: tr.examples,
    keepNote: tr.keepNote,
    cookNote: tr.cookNote,
    checkIceNote: tr.checkIceNote,
    discardNote: tr.discardNote
  };
});

const localizedFaqs: Array<{ question: string; answer: string }> =
  (rawData.faqs as Record<string, Array<{ question: string; answer: string }>>)[lang] ||
  rawData.faqs.en;

