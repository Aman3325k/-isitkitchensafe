const t = UI[lang] || UI.en;
const presetHours = [1, 2, 4, 6, 12, 24, 48, 72];

// Default SSR state: Refrigerator, 6 hours closed, normal room temp, no thermometer
const defaultMode: CompartmentMode = 'fridge';
const defaultHours = 6;
const defaultDoorOpened = false;
const defaultRoomTemp: RoomTempMode = 'normal';
const defaultTempUnit: 'F' | 'C' = lang === 'en' ? 'F' : 'C';
const defaultTempVal = defaultTempUnit === 'F' ? 45 : 7;

function getSafeWindowHours(mode: CompartmentMode, doorOpened: boolean, roomTemp: RoomTempMode): number {
  const isHeat = roomTemp === 'heatwave';
  if (mode === 'fridge') {
    if (isHeat) return doorOpened ? 1 : 2;
    return doorOpened ? 2 : 4;
  }
  if (mode === 'freezer-full') {
    if (isHeat) return doorOpened ? 24 : 36;
    return doorOpened ? 36 : 48;
  }
  if (isHeat) return doorOpened ? 12 : 18;
  return doorOpened ? 18 : 24;
}

function evaluateFoodSSR(food: LocalizedFood): VerdictType {
  const safeWindow = getSafeWindowHours(defaultMode, defaultDoorOpened, defaultRoomTemp);
  const rt = food.ruleType;
  if (rt === 'shelf-stable' || rt === 'shelf-stable-juice' || rt === 'shelf-stable-frozen') return 'keep';
  if (rt === 'mayo-condiment') return defaultHours > safeWindow + 8 ? 'discard' : 'keep';
  if (rt === 'frozen-ice-cream') return defaultHours <= 1 ? 'check-ice' : 'discard';
  if (rt === 'frozen-perishable' || rt === 'frozen-veg') return 'keep';
  if (defaultHours < safeWindow) return 'keep';
  if (defaultHours === safeWindow) return rt === 'perishable-cookable' ? 'cook' : 'keep';
  return 'discard';
}

const initialFoodStates = localizedFoods.map((food) => {
  const verdict = evaluateFoodSSR(food);
  const note =
    verdict === 'keep'
      ? food.keepNote
      : verdict === 'cook'
        ? food.cookNote
        : verdict === 'check-ice'
          ? food.checkIceNote
          : food.discardNote;
  const inDefaultComp = food.compartments.includes('fridge');
  return { ...food, verdict, note, inDefaultComp };
});

const initialActiveFoods = initialFoodStates.filter((f) => f.inDefaultComp);
const initialCounts = {
  all: initialActiveFoods.length,
  keep: initialActiveFoods.filter((f) => f.verdict === 'keep').length,
  cook: initialActiveFoods.filter((f) => f.verdict === 'cook').length,
  checkIce: initialActiveFoods.filter((f) => f.verdict === 'check-ice').length,
  discard: initialActiveFoods.filter((f) => f.verdict === 'discard').length
};

const clientPayload = {
  lang,
  defaultTempUnit,
  foods: localizedFoods,
  ui: t
};

function getVerdictCardClasses(verdict: VerdictType): string {
  if (verdict === 'keep') {
    return 'border-success-border/60 bg-canvas';
  }
  if (verdict === 'cook') {
    return 'border-warning-border/80 bg-warning-bg/35 dark:bg-amber-950/20';
  }
  if (verdict === 'check-ice') {
    return 'border-info-border/70 bg-blue-50/40 dark:bg-blue-950/20';
  }
  return 'border-error-border/70 bg-error-bg/45 dark:bg-red-950/20';
}

function getVerdictPillClasses(verdict: VerdictType): string {
  if (verdict === 'keep') return 'badge-yes';
  if (verdict === 'cook') return 'badge-depends';
  if (verdict === 'check-ice') return 'badge-time';
  return 'badge-no';
}

function getVerdictLabel(verdict: VerdictType): string {
  if (verdict === 'keep') return t.verdictKeep;
  if (verdict === 'cook') return t.verdictCook;
  if (verdict === 'check-ice') return t.verdictCheckIce;
  return t.verdictDiscard;
}

function getCompBadgeLabel(compartments: string[]): string {
  if (compartments.includes('fridge') && compartments.includes('freezer')) return t.compBadgeBoth;
  if (compartments.includes('freezer')) return t.compBadgeFreezer;
  return t.compBadgeFridge;
}
