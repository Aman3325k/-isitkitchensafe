---

<div class="scwh-modeler-container my-8 font-sans">
  <!-- Header Card -->
  <div class="bg-gradient-to-br from-amber-950 via-slate-900 to-emerald-950 border border-amber-500/30 rounded-2xl p-6 sm:p-8 shadow-xl text-white mb-8">
    <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold tracking-wide uppercase bg-amber-500/20 text-amber-300 border border-amber-500/40">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        {d.badge}
      </span>
      <span class="text-xs font-mono text-amber-200/80 bg-black/40 px-3 py-1 rounded-lg border border-white/10">
        ASME BPVC VIII &bull; 120°C–240°C &bull; 100% Solvent-Free
      </span>
    </div>
    <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-white mb-3">
      {d.title}
    </h1>
    <p class="text-slate-300 text-sm sm:text-base leading-relaxed max-w-4xl">
      {d.subtitle}
    </p>
  </div>

  <!-- Presets -->
  <div class="bg-surface-soft border border-hairline rounded-2xl p-5 mb-8 shadow-xs">
    <div class="text-xs font-bold uppercase tracking-wider text-muted mb-3 flex items-center gap-2">
      <svg class="w-4 h-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
      </svg>
      {d.presetsTitle}
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-2.5">
      <button 
        type="button" 
        data-preset="bsg" 
        class="scwh-preset-btn text-left p-3 rounded-xl border border-hairline/80 bg-surface hover:border-amber-500/50 hover:bg-amber-500/5 transition-all text-xs"
      >
        <span class="block font-semibold text-ink mb-1">🌾 {d.presetBsg.split('(')[0]}</span>
        <span class="block text-[11px] text-muted">{d.presetBsg.match(/\((.*?)\)/)?.[0] || '185°C, 6.5m'}</span>
      </button>

      <button 
        type="button" 
        data-preset="collagen" 
