  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
    <!-- Scientific Explanations -->
    <div class="bg-surface-soft border border-hairline rounded-2xl p-6 shadow-xs">
      <h3 class="text-base font-bold text-ink tracking-tight mb-3 flex items-center gap-2">
        <svg class="w-5 h-5 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
        </svg>
        {d.scienceTitle}
      </h3>
      <p class="text-xs text-muted mb-4">{d.scienceSub}</p>

      <div class="space-y-4 text-xs text-muted leading-relaxed">
        <div class="p-3 bg-surface rounded-xl border border-hairline">
          <span class="font-bold text-ink block mb-1">1. Dielectric Constant (ε) Tuning & Green Extraction</span>
          Under ambient conditions (25°C, 1 bar), water has a high dielectric constant (ε ≈ 78.5) that dissolves only highly polar ionic salts. As water is pressurized above its boiling point into the subcritical state (150°C–220°C), hydrogen bonds weaken significantly, causing ε to plummet from 78.5 down to ~31.4—identical to methanol and ethanol. This enables water to dissolve hydrophobic flavonoids, ferulate esters, and non-polar amino acids without requiring explosive or toxic petro-solvents.
        </div>

        <div class="p-3 bg-surface rounded-xl border border-hairline">
          <span class="font-bold text-ink block mb-1">2. Auto-Ionization (Kw) Self-Catalytic Proteolysis</span>
          The ion product of water, Kw = [H⁺][OH⁻], increases by nearly 1,000-fold between 25°C (pKw = 14.0) and 200°C–240°C (pKw ≈ 11.2). At 200°C, the concentration of active hydronium and hydroxide ions is ~30 times higher than at room temperature. The pressurized hot water acts as an intrinsic, self-neutralizing acid-base catalyst that rapidly cleaves peptide bonds without requiring mineral acids (HCl) or chemical alkalis (NaOH), eliminating downstream desalination.
        </div>

        <div class="p-3 bg-surface rounded-xl border border-hairline">
          <span class="font-bold text-ink block mb-1">3. Kinetic Temperature Limits & 5-HMF Degradation</span>
          While higher temperatures accelerate peptide cleavage under Arrhenius kinetics (activation energy Ea ≈ 65–85 kJ/mol), temperatures exceeding 210°C–220°C trigger rapid sugar dehydration and Maillard pyrolysis, synthesizing 5-hydroxymethylfurfural (5-HMF) and furfural. Maintaining reactor residence time under 7 minutes and incorporating millisecond quench cooling below 60°C guarantees 5-HMF concentrations remain well below the 25 mg/kg regulatory ceiling.
        </div>
      </div>
    </div>

    <!-- Polarity & Benchmarks Scale -->
    <div class="bg-surface-soft border border-hairline rounded-2xl p-6 shadow-xs">
      <h3 class="text-base font-bold text-ink tracking-tight mb-3 flex items-center gap-2">
        <svg class="w-5 h-5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" />
        </svg>
        {d.tableTitle}
      </h3>
      <p class="text-xs text-muted mb-4">Comparison of subcritical water hydrolysis versus conventional enzymatic and chemical technologies.</p>

      <div class="overflow-x-auto">
        <table class="w-full text-[11px] text-left border-collapse">
          <thead>
            <tr class="border-b border-hairline text-ink font-semibold">
              <th class="py-2 pr-2">Technology</th>
              <th class="py-2 px-2">Chemicals</th>
              <th class="py-2 px-2">Time</th>
              <th class="py-2 px-2">Peptides &lt; 3kDa</th>
              <th class="py-2 pl-2">Clean Label</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-hairline/60 text-muted">
            {benchmarks.map(b => (
              <tr class={b.technology.includes('Subcritical') ? 'bg-amber-500/10 font-medium text-ink' : ''}>
                <td class="py-2.5 pr-2 font-semibold">{b.technology.split('(')[0]}</td>
                <td class="py-2.5 px-2">{b.chemicalReagents}</td>
                <td class="py-2.5 px-2 font-mono">{b.reactionDuration}</td>
                <td class="py-2.5 px-2 font-mono">{b.peptideYieldUnder3kDaPercent}</td>
                <td class="py-2.5 pl-2">{b.regulatoryCleanLabelStatus.split('/')[0]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
  // Client-side dynamic simulation and telemetry calculation
  document.addEventListener('DOMContentLoaded', () => {
    const tempSlider = document.getElementById('scwh-temp-slider') as HTMLInputElement;
    const tempVal = document.getElementById('scwh-temp-val');
    const pressureSlider = document.getElementById('scwh-pressure-slider') as HTMLInputElement;
    const pressureVal = document.getElementById('scwh-pressure-val');
    const residenceSlider = document.getElementById('scwh-residence-slider') as HTMLInputElement;
    const residenceVal = document.getElementById('scwh-residence-val');
    const solidsSlider = document.getElementById('scwh-solids-slider') as HTMLInputElement;
    const solidsVal = document.getElementById('scwh-solids-val');
    const feedstockSelect = document.getElementById('scwh-feedstock-select') as HTMLSelectElement;

    // Telemetry DOM elements
    const telDielectric = document.getElementById('telemetry-dielectric');
    const telEquivalentSolvent = document.getElementById('telemetry-equivalent-solvent');
    const telKw = document.getElementById('telemetry-kw');
    const telAutocatalysis = document.getElementById('telemetry-autocatalysis');
    const telDh = document.getElementById('telemetry-dh');
    const telDhBar = document.getElementById('telemetry-dh-bar');
    const telLowMw = document.getElementById('telemetry-lowmw');
    const telAce = document.getElementById('telemetry-ace');
    const telOrac = document.getElementById('telemetry-orac');
    const telHmfBadge = document.getElementById('telemetry-hmf-badge');
    const telHmfDesc = document.getElementById('telemetry-hmf-desc');
    const telEnergy = document.getElementById('telemetry-energy');
    const telMargin = document.getElementById('telemetry-margin');

    // Preset Buttons
    const presetButtons = document.querySelectorAll('.scwh-preset-btn');

    function updateSimulation() {
      if (!tempSlider || !pressureSlider || !residenceSlider || !solidsSlider) return;

      const T = parseFloat(tempSlider.value);
      const P = parseFloat(pressureSlider.value);
      const tr = parseFloat(residenceSlider.value);
      const solids = parseFloat(solidsSlider.value);
      const feedType = feedstockSelect ? feedstockSelect.value : 'spent_brewers_grain';

      if (tempVal) tempVal.textContent = `${T.toFixed(0)}°C`;
      if (pressureVal) pressureVal.textContent = `${P.toFixed(0)} bar`;
      if (residenceVal) residenceVal.textContent = `${tr.toFixed(1)} min`;
      if (solidsVal) solidsVal.textContent = `${solids.toFixed(1)}%`;

      // 1. Dielectric Constant epsilon(T) empirical polynomial fit
      // e(25) = 78.5, e(100) = 55.3, e(200) = 34.5, e(240) = 28.2
      const epsilon = Math.max(26.0, 78.5 - 0.28 * (T - 25) + 0.00035 * Math.pow(T - 25, 2));
      if (telDielectric) telDielectric.textContent = epsilon.toFixed(1);

      let equivSolvent = 'Pure Water (Polar)';
      if (epsilon < 30) equivSolvent = 'Ethanol / Propanol Mixture';
      else if (epsilon < 33) equivSolvent = 'Acetone / Isopropanol (ε ≈ 21–30)';
      else if (epsilon < 36) equivSolvent = 'Pure Ethanol (ε ≈ 24.3 to 32)';
      else if (epsilon < 42) equivSolvent = 'Acetonitrile / Methanol Blend';
      else if (epsilon < 50) equivSolvent = 'Methanol / Ethylene Glycol';
      else equivSolvent = 'Formamide / DMSO Polarity';
      if (telEquivalentSolvent) telEquivalentSolvent.textContent = equivSolvent;

      // 2. Ionization constant pKw: drops from 14.0 at 25°C to 11.2 at 220°C
      // pKw(T) ≈ 14.0 - 0.024*(T - 25) + 0.00005*(T - 25)^2
      const pKw = Math.max(11.18, 14.0 - 0.024 * (T - 25) + 0.00005 * Math.pow(T - 25, 2));
      if (telKw) telKw.textContent = pKw.toFixed(2);
      const ionDensityRatio = Math.pow(10, (14.0 - pKw) / 2);
      if (telAutocatalysis) telAutocatalysis.textContent = `${ionDensityRatio.toFixed(1)}× Room Water`;

      // 3. Degree of Hydrolysis (DH %)
      // DH = baseRate * [1 - exp(-k * tr)]
      let baseFeedFactor = 1.0;
      let feedHmfThreshold = 210;
      if (feedType === 'marine_fish_collagen_skin') { baseFeedFactor = 1.35; feedHmfThreshold = 220; }
      else if (feedType === 'soy_protein_isolate_slurry') { baseFeedFactor = 1.15; feedHmfThreshold = 215; }
      else if (feedType === 'apple_citrus_pomace') { baseFeedFactor = 0.85; feedHmfThreshold = 190; }
      else if (feedType === 'wheat_bran_aleurone') { baseFeedFactor = 0.95; feedHmfThreshold = 205; }

      const k = 0.04 * Math.exp(0.028 * (T - 120)) * baseFeedFactor;
      const maxDh = Math.min(48.0, 18.0 + 0.18 * (T - 120));
      const dh = Math.min(maxDh, maxDh * (1.0 - Math.exp(-k * tr)));

      if (telDh) telDh.textContent = `${dh.toFixed(1)}%`;
      if (telDhBar) telDhBar.style.width = `${Math.min(100, (dh / 50.0) * 100)}%`;

      // 4. Low-MW Peptides (< 3 kDa) fraction & Bioactivities
      const lowMwPercent = Math.min(94.0, Math.max(35.0, 42.0 + dh * 1.35 - (tr > 10 ? (tr - 10) * 1.2 : 0)));
      if (telLowMw) telLowMw.textContent = `${lowMwPercent.toFixed(1)}%`;

      // ACE-Inhibitory IC50 (mg/mL): lower is more potent. Optimal around 180°C–200°C
      let aceIc50 = 0.85;
      if (T >= 160 && T <= 205) {
        aceIc50 = Math.max(0.12, 0.55 - (dh / 100) * 0.95);
      } else if (T > 205) {
        aceIc50 = 0.25 + (T - 205) * 0.025; // degradation
      }
      if (telAce) telAce.textContent = `${aceIc50.toFixed(2)} mg/mL`;

      // Antioxidant ORAC: higher is better
      const oracVal = Math.round((210 + dh * 8.5 + (T - 120) * 1.8) * (solids / 12.0));
      if (telOrac) telOrac.textContent = `${oracVal} µmol TE/g`;

      // 5. 5-HMF & Degradation Risk
      if (T > feedHmfThreshold + 15 || (T > feedHmfThreshold && tr > 8.0)) {
        if (telHmfBadge) {
          telHmfBadge.className = 'px-2 py-0.5 rounded text-[11px] font-bold uppercase bg-red-500/20 text-red-400 border border-red-500/40';
          telHmfBadge.textContent = 'HIGH PYROLYSIS HAZARD';
        }
        if (telHmfDesc) {
          telHmfDesc.textContent = `5-HMF > 35 mg/kg! High furfural & acrylamide generation. Quench immediately and lower reactor temperature.`;
        }
      } else if (T > feedHmfThreshold || tr > 11.0) {
        if (telHmfBadge) {
          telHmfBadge.className = 'px-2 py-0.5 rounded text-[11px] font-bold uppercase bg-amber-500/20 text-amber-400 border border-amber-500/40';
          telHmfBadge.textContent = 'ELEVATED MAILLARD WARNING';
        }
        if (telHmfDesc) {
          telHmfDesc.textContent = `5-HMF 12–25 mg/kg. Maillard browning present. Safe for technical feed, nearing food-grade limit.`;
        }
      } else {
        if (telHmfBadge) {
          telHmfBadge.className = 'px-2 py-0.5 rounded text-[11px] font-bold uppercase bg-emerald-500/20 text-emerald-400 border border-emerald-500/40';
          telHmfBadge.textContent = 'CLEAN / OPTIMAL';
        }
        if (telHmfDesc) {
          telHmfDesc.textContent = `5-HMF < 4.5 mg/kg. 100% Clean-label food compliant with zero pyrolysis.`;
        }
      }

      // 6. Net Specific Energy (MJ/kg dry wt) with 82.5% heat recovery
      const netEnergy = Math.max(0.38, 0.35 + 0.0022 * (T - 120) + (1.0 / (solids / 10.0)) * 0.12);
      if (telEnergy) telEnergy.textContent = `${netEnergy.toFixed(2)} MJ/kg dry wt`;

      // 7. Saturated Vapor Pressure Psat(T) via Antoine equation approximation:
      // Psat(120°C) ≈ 1.98 bar, Psat(180°C) ≈ 10.0 bar, Psat(200°C) ≈ 15.5 bar, Psat(240°C) ≈ 33.4 bar
      const pSat = Math.exp(11.78 - 3816.4 / (T + 227.0));
      const margin = P - pSat;
      if (telMargin) {
        if (margin < 3.0) {
          telMargin.className = 'font-bold font-mono text-red-500';
          telMargin.textContent = `${margin.toFixed(1)} bar (CRITICAL FLASH VAPOR HAZARD!)`;
        } else {
          telMargin.className = 'font-bold font-mono text-cyan-500';
          telMargin.textContent = `+${margin.toFixed(1)} bar (No Flashing &bull; Stable Liquid)`;
        }
      }
    }

    // Attach listeners
    tempSlider?.addEventListener('input', updateSimulation);
    pressureSlider?.addEventListener('input', updateSimulation);
    residenceSlider?.addEventListener('input', updateSimulation);
    solidsSlider?.addEventListener('input', updateSimulation);
    feedstockSelect?.addEventListener('change', updateSimulation);

    // Preset configurations
    presetButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const preset = btn.getAttribute('data-preset');
        if (preset === 'bsg') {
          if (tempSlider) tempSlider.value = '185';
          if (pressureSlider) pressureSlider.value = '35';
          if (residenceSlider) residenceSlider.value = '6.5';
          if (solidsSlider) solidsSlider.value = '12.0';
          if (feedstockSelect) feedstockSelect.value = 'spent_brewers_grain';
        } else if (preset === 'collagen') {
          if (tempSlider) tempSlider.value = '165';
          if (pressureSlider) pressureSlider.value = '30';
          if (residenceSlider) residenceSlider.value = '4.5';
          if (solidsSlider) solidsSlider.value = '8.0';
          if (feedstockSelect) feedstockSelect.value = 'marine_fish_collagen_skin';
        } else if (preset === 'soy') {
          if (tempSlider) tempSlider.value = '195';
          if (pressureSlider) pressureSlider.value = '42';
          if (residenceSlider) residenceSlider.value = '5.0';
          if (solidsSlider) solidsSlider.value = '10.0';
          if (feedstockSelect) feedstockSelect.value = 'soy_protein_isolate_slurry';
        } else if (preset === 'pomace') {
          if (tempSlider) tempSlider.value = '150';
          if (pressureSlider) pressureSlider.value = '25';
          if (residenceSlider) residenceSlider.value = '8.0';
          if (solidsSlider) solidsSlider.value = '15.0';
          if (feedstockSelect) feedstockSelect.value = 'apple_citrus_pomace';
        } else if (preset === 'hazard') {
          if (tempSlider) tempSlider.value = '235';
          if (pressureSlider) pressureSlider.value = '36';
          if (residenceSlider) residenceSlider.value = '12.0';
          if (solidsSlider) solidsSlider.value = '20.0';
          if (feedstockSelect) feedstockSelect.value = 'wheat_bran_aleurone';
        }
        updateSimulation();
      });
    });

    // Initial run
    updateSimulation();
  });
</script>
