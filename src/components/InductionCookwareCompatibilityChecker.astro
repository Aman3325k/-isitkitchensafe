---
import rawData from '../data/induction-cookware-compatibility-data.json';
import type { SupportedLanguage } from '../i18n/ui';
import { useTranslatedPath } from '../i18n/utils';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;
const translatePath = useTranslatedPath(lang);

const cookwareOvenUrl = translatePath('/tools/cookware-oven-temp-lookup/');
const castIronUrl = translatePath('/tools/cast-iron-seasoning-troubleshooter/');
const inductionEmfUrl = translatePath('/tools/induction-cooktop-emf-safety-modeler/');
const methodologyUrl = translatePath('/methodology/');
const allToolsUrl = translatePath('/tools/');

type StatusType = 'works-great' | 'model-dependent' | 'incompatible';
type MagnetType = 'strong' | 'check-base' | 'none';
type EfficiencyType = 'high' | 'medium' | 'none';
type ScratchRiskType = 'low' | 'medium' | 'high';

interface LocalizedCookware {
  id: string;
  icon: string;
  status: StatusType;
  magnetTest: MagnetType;
  heatingEfficiency: EfficiencyType;
  glassScratchRisk: ScratchRiskType;
  keywords: string;
  name: string;
  brands: string;
  maxPowerTip: string;
  verdict: string;
  buyerTip: string;
}

const localizedCookware: LocalizedCookware[] = rawData.cookware.map((item) => {
  const tr = (item.i18n as Record<string, any>)[lang] || item.i18n.en;
  return {
    id: item.id,
    icon: item.icon,
    status: item.status as StatusType,
    magnetTest: item.magnetTest as MagnetType,
    heatingEfficiency: item.heatingEfficiency as EfficiencyType,
    glassScratchRisk: item.glassScratchRisk as ScratchRiskType,
    keywords: `${item.keywords} ${tr.name} ${tr.brands} ${tr.verdict}`.toLowerCase(),
    name: tr.name,
    brands: tr.brands,
    maxPowerTip: tr.maxPowerTip,
    verdict: tr.verdict,
    buyerTip: tr.buyerTip
  };
});

const localizedFaqs: Array<{ question: string; answer: string }> =
  (rawData.faqs as Record<string, Array<{ question: string; answer: string }>>)[lang] ||
  rawData.faqs.en;

const counts = {
  all: localizedCookware.length,
  worksGreat: localizedCookware.filter((c) => c.status === 'works-great').length,
  modelDependent: localizedCookware.filter((c) => c.status === 'model-dependent').length,
  incompatible: localizedCookware.filter((c) => c.status === 'incompatible').length,
  scratchRisk: localizedCookware.filter((c) => c.glassScratchRisk === 'high' || c.glassScratchRisk === 'medium').length
};

interface SimVerdict {
  status: StatusType;
  pill: string;
  headline: string;
  summary: string;
  efficiency: string;
  powerLimit: string;
  tip: string;
}

