        powerLimit: '強火での無理な使用は避けてください。',
        tip: 'オーブン専用にするか、平底のIH対応鍋に置き換えましょう。'
      },
      'none|flat-wide': {
        status: 'incompatible',
        pill: 'IH非対応',
        headline: '非磁性素材のため家庭用IHでは加熱できません',
        summary: '磁石が落ちた場合、底面はアルミ・純銅・単層304ステンレス・純チタン・ガラス・陶器であり標準IHには反応しません。',
        efficiency: '0%（磁気結合なし）',
        powerLimit: '鍋なしエラーが表示され加熱されません。',
        tip: '普段使いはIH対応鍋へ移行を。変換プレートは短時間・弱火限定（ガラス鍋・土鍋には絶対使用不可）。'
      },
      'none|flat-small': {
        status: 'incompatible',
        pill: 'IH非対応',
        headline: '非磁性の小型容器（アルミ製マキネッタ等）',
        summary: '磁性がゼロのため、IH天板上で直接渦電流を発生させることができません。',
        efficiency: '0%（磁気結合なし）',
        powerLimit: 'ステンレス製IH対応品への買い替え、または純正プレート弱火運用が必要。',
        tip: 'マキネッタなら4カップ以上のステンレス製（ビアレッティ ヴィーナス等）が一番手軽で安全です。'
      },
      'none|uneven': {
        status: 'incompatible',
        pill: 'IH非対応',
        headline: '非磁性＆底面不整 — IH天板では使用しないでください',
        summary: '強磁性金属を含まず、ガラストップに安定して接地することもできません。',
        efficiency: '0%（磁気結合なし）',
        powerLimit: 'ガラス・陶器・土鍋は変換プレート上でも使用厳禁。',
        tip: '素材に応じてガスコンロ・オーブン・電子レンジ専用としてご使用ください。'
      }
    }
  }
};

const t = UI[lang] || UI.en;
const defaultSim = t.simResults['strong|flat-wide'];

function getStatusPillClass(status: StatusType): string {
  if (status === 'works-great') return 'badge-yes';
  if (status === 'model-dependent') return 'badge-depends';
  return 'badge-no';
}

function getStatusLabel(status: StatusType): string {
  if (status === 'works-great') return t.statusWorks;
  if (status === 'model-dependent') return t.statusCheck;
  return t.statusNo;
}

function getMagnetLabel(m: MagnetType): string {
  if (m === 'strong') return t.magnetStrong;
  if (m === 'check-base') return t.magnetCheck;
  return t.magnetNone;
}

function getEffLabel(e: EfficiencyType): string {
  if (e === 'high') return t.effHigh;
  if (e === 'medium') return t.effMed;
  return t.effNone;
}

function getScratchLabel(s: ScratchRiskType): string {
  if (s === 'high') return t.scratchHigh;
  if (s === 'medium') return t.scratchMed;
  return t.scratchLow;
}

function getScratchBadgeClass(s: ScratchRiskType): string {
  if (s === 'high') return 'bg-red-500/15 text-red-800 dark:text-red-300 border-red-500/40';
  if (s === 'medium') return 'bg-amber-500/15 text-amber-800 dark:text-amber-300 border-amber-500/40';
  return 'bg-emerald-500/15 text-emerald-800 dark:text-emerald-300 border-emerald-500/35';
}

function getCardBorderAccent(status: StatusType): string {
  if (status === 'works-great') return 'border-l-4 border-l-success-border';
  if (status === 'model-dependent') return 'border-l-4 border-l-warning-border';
  return 'border-l-4 border-l-error-border';
}

const clientPayload = {
  totalCount: localizedCookware.length,
  simResults: t.simResults,
  ui: {
    copyBtn: t.copyBtn,
    copiedBtn: t.copiedBtn,
    copyChecklistText: t.copyChecklistText,
    showingPrefix: t.showingPrefix,
    showingOf: t.showingOf,
    showingSuffix: t.showingSuffix
  }
};
---

<div id="induction-compatibility-checker-root" class="space-y-12">
  <!-- Main Interactive Checker Card -->
  <section
    id="induction-cookware-compatibility-checker"
    class="bg-canvas border border-hairline rounded-2xl shadow-sm overflow-hidden"
    aria-label={t.ariaLabel}
  >
    <script type="application/json" id="icc-payload" set:html={JSON.stringify(clientPayload)} />

    <!-- PART 1: Interactive 3-Second Magnet Test Simulator -->
    <div class="p-5 sm:p-6 border-b border-hairline bg-surface-soft/50 space-y-5">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div class="space-y-1 max-w-2xl">
          <span class="inline-block px-2.5 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wider bg-signature-coral text-white">
            🧲 {t.simBadge}
          </span>
          <h2 class="text-title-md font-bold text-ink">{t.simTitle}</h2>
          <p class="text-xs sm:text-[13px] text-muted leading-relaxed">{t.simSub}</p>
        </div>

        <div class="flex flex-wrap items-center gap-2 print:hidden">
          <button
            type="button"
            id="icc-copy-btn"
            class="min-h-[40px] px-3.5 py-2 rounded-xl text-xs font-semibold bg-primary text-on-primary hover:bg-primary-active transition-colors cursor-pointer shadow-sm"
          >
            <span id="icc-copy-label">📋 {t.copyBtn}</span>
          </button>
          <button
            type="button"
            id="icc-print-btn"
            class="min-h-[40px] px-3.5 py-2 rounded-xl text-xs font-semibold bg-canvas text-ink border border-hairline hover:border-signature-coral transition-colors cursor-pointer"
          >
            🖨️ {t.printBtn}
          </button>
          <button
            type="button"
            id="icc-reset-btn"
            class="min-h-[40px] px-3 py-2 rounded-xl text-xs font-semibold bg-canvas text-muted border border-hairline hover:border-border-strong hover:text-ink transition-colors cursor-pointer"
          >
            {t.resetBtn}
          </button>
        </div>
      </div>

      <!-- 2-Column Simulator Controls + Live Verdict Banner -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-stretch">
        <!-- Left Controls: Magnet Pull + Flat/Width -->
        <div class="lg:col-span-6 space-y-4 print:hidden">
          <!-- Question 1: Magnet Stick -->
          <div class="space-y-2">
            <p class="text-xs sm:text-[13px] font-bold text-ink">{t.q1Label}</p>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2" role="radiogroup" aria-label={t.q1Label}>
              <button
                type="button"
                role="radio"
                aria-checked="true"
                data-icc-magnet="strong"
                class="icc-magnet-btn p-3 rounded-xl border text-left transition-all cursor-pointer bg-primary text-on-primary border-primary shadow-sm"
              >
                <span class="block text-xs font-bold leading-snug">🧲 {t.q1Strong}</span>
                <span class="block text-[11px] opacity-85 mt-0.5 leading-tight">{t.q1StrongSub}</span>
              </button>
              <button
                type="button"
                role="radio"
                aria-checked="false"
                data-icc-magnet="weak"
                class="icc-magnet-btn p-3 rounded-xl border text-left transition-all cursor-pointer bg-canvas text-ink border-hairline hover:border-border-strong"
              >
                <span class="block text-xs font-bold leading-snug">〰️ {t.q1Weak}</span>
                <span class="block text-[11px] opacity-80 mt-0.5 leading-tight">{t.q1WeakSub}</span>
              </button>
              <button
                type="button"
                role="radio"
                aria-checked="false"
                data-icc-magnet="none"
                class="icc-magnet-btn p-3 rounded-xl border text-left transition-all cursor-pointer bg-canvas text-ink border-hairline hover:border-border-strong"
              >
                <span class="block text-xs font-bold leading-snug">🚫 {t.q1None}</span>
                <span class="block text-[11px] opacity-80 mt-0.5 leading-tight">{t.q1NoneSub}</span>
              </button>
            </div>
          </div>

          <!-- Question 2: Flatness & Diameter -->
          <div class="space-y-2">
            <p class="text-xs sm:text-[13px] font-bold text-ink">{t.q2Label}</p>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2" role="radiogroup" aria-label={t.q2Label}>
              <button
                type="button"
                role="radio"
                aria-checked="true"
                data-icc-base="flat-wide"
                class="icc-base-btn p-3 rounded-xl border text-left transition-all cursor-pointer bg-primary text-on-primary border-primary shadow-sm"
              >
                <span class="block text-xs font-bold leading-snug">✅ {t.q2FlatWide}</span>
                <span class="block text-[11px] opacity-85 mt-0.5 leading-tight">{t.q2FlatWideSub}</span>
              </button>
              <button
                type="button"
                role="radio"
                aria-checked="false"
                data-icc-base="flat-small"
                class="icc-base-btn p-3 rounded-xl border text-left transition-all cursor-pointer bg-canvas text-ink border-hairline hover:border-border-strong"
              >
                <span class="block text-xs font-bold leading-snug">📏 {t.q2Small}</span>
                <span class="block text-[11px] opacity-80 mt-0.5 leading-tight">{t.q2SmallSub}</span>
              </button>
              <button
                type="button"
                role="radio"
                aria-checked="false"
                data-icc-base="uneven"
                class="icc-base-btn p-3 rounded-xl border text-left transition-all cursor-pointer bg-canvas text-ink border-hairline hover:border-border-strong"
              >
                <span class="block text-xs font-bold leading-snug">⚠️ {t.q2Uneven}</span>
                <span class="block text-[11px] opacity-80 mt-0.5 leading-tight">{t.q2UnevenSub}</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Right Output: High-Contrast Dark Instant Verdict Card -->
        <div class="lg:col-span-6 flex">
          <div
            id="icc-sim-banner"
            aria-live="polite"
            class="w-full rounded-2xl bg-surface-dark text-on-dark p-5 sm:p-6 space-y-4 shadow-sm border-l-4 border-success-border flex flex-col justify-between"
          >
            <div class="space-y-2.5">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <span class="text-[11px] font-bold uppercase tracking-wider text-signature-peach">
                  {t.simBadge}
                </span>
                <span id="icc-sim-pill" class={getStatusPillClass(defaultSim.status)}>
                  {defaultSim.pill}
                </span>
              </div>

              <h3 id="icc-sim-headline" class="text-base sm:text-lg font-extrabold tracking-tight text-white leading-snug">
                {defaultSim.headline}
              </h3>
              <p id="icc-sim-summary" class="text-xs sm:text-[13px] text-white/90 leading-relaxed">
                {defaultSim.summary}
              </p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
              <div class="p-3 rounded-xl bg-white/5 border border-white/10">
                <span class="block text-[10.5px] font-medium text-white/70">{t.simEfficiencyLabel}</span>
                <span id="icc-sim-efficiency" class="block text-xs font-bold text-signature-mint mt-0.5 leading-snug">
                  {defaultSim.efficiency}
                </span>
              </div>
              <div class="p-3 rounded-xl bg-white/5 border border-white/10">
                <span class="block text-[10.5px] font-medium text-white/70">{t.simPowerLabel}</span>
                <span id="icc-sim-power" class="block text-xs font-bold text-signature-yellow mt-0.5 leading-snug">
                  {defaultSim.powerLimit}
                </span>
              </div>
            </div>

            <div class="p-3 rounded-xl bg-white/8 border border-white/15">
              <span class="block text-[10.5px] font-bold uppercase tracking-wider text-signature-peach">
                💡 {t.simTipLabel}
              </span>
              <p id="icc-sim-tip" class="text-xs text-white/95 leading-relaxed mt-1">
                {defaultSim.tip}
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- PART 2: Searchable & Filterable 24-Item Cookware & Brand Database -->
    <div class="p-5 sm:p-6 space-y-5">
      <div class="space-y-1">
        <h2 class="text-title-md font-semibold text-ink">{t.catalogTitle}</h2>
        <p class="text-xs sm:text-[13px] text-muted">{t.catalogSub}</p>
      </div>

      <!-- Search Input + Filter Pills -->
      <div class="space-y-3 print:hidden">
        <div class="flex flex-col sm:flex-row gap-2.5">
          <div class="relative flex-1">
            <label for="icc-search-input" class="sr-only">{t.searchLabel}</label>
            <span aria-hidden="true" class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-sm text-muted">
              🔎
            </span>
            <input
              id="icc-search-input"
              type="search"
              autocomplete="off"
              placeholder={t.searchPlaceholder}
              class="w-full min-h-[44px] pl-10 pr-4 py-2 rounded-xl bg-surface-soft border border-hairline text-sm text-ink placeholder:text-muted focus:outline-none focus:border-signature-coral focus:ring-2 focus:ring-signature-coral/25 transition-all"
            />
          </div>
          <button
            type="button"
            id="icc-clear-btn"
            class="min-h-[44px] px-4 py-2 rounded-xl text-xs font-semibold bg-canvas text-ink border border-hairline hover:border-signature-coral transition-colors cursor-pointer shrink-0"
          >
            {t.clearSearchBtn}
          </button>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-3">
          <div class="flex flex-wrap gap-2" role="group" aria-label={t.catalogTitle}>
            <button
              type="button"
              data-icc-filter="all"
              aria-pressed="true"
              class="icc-filter-btn px-3.5 py-1.5 rounded-full text-xs font-bold border transition-all cursor-pointer bg-primary text-on-primary border-primary shadow-sm"
            >
              {t.filterAll} ({counts.all})
            </button>
            <button
              type="button"
              data-icc-filter="works-great"
              aria-pressed="false"
              class="icc-filter-btn px-3.5 py-1.5 rounded-full text-xs font-bold border transition-all cursor-pointer bg-canvas text-ink border-hairline hover:border-success-border"
            >
              ✅ {t.filterWorks} ({counts.worksGreat})
            </button>
            <button
              type="button"
              data-icc-filter="model-dependent"
              aria-pressed="false"
              class="icc-filter-btn px-3.5 py-1.5 rounded-full text-xs font-bold border transition-all cursor-pointer bg-canvas text-ink border-hairline hover:border-warning-border"
            >
              🔍 {t.filterCheck} ({counts.modelDependent})
            </button>
            <button
              type="button"
              data-icc-filter="incompatible"
              aria-pressed="false"
              class="icc-filter-btn px-3.5 py-1.5 rounded-full text-xs font-bold border transition-all cursor-pointer bg-canvas text-ink border-hairline hover:border-error-border"
            >
              🚫 {t.filterNo} ({counts.incompatible})
            </button>
            <button
              type="button"
              data-icc-filter="scratch-risk"
              aria-pressed="false"
              class="icc-filter-btn px-3.5 py-1.5 rounded-full text-xs font-bold border transition-all cursor-pointer bg-warning-bg/50 dark:bg-amber-950/25 text-ink border-warning-border/80 hover:border-error-border"
            >
              ⚠️ {t.filterScratch} ({counts.scratchRisk})
            </button>
          </div>

          <p id="icc-count-readout" aria-live="polite" class="text-xs font-semibold text-muted">
            {t.showingPrefix} {counts.all} {t.showingOf} {counts.all} {t.showingSuffix}
          </p>
        </div>
      </div>

      <!-- Empty Search State -->
      <div
        id="icc-empty-state"
        class="hidden p-8 rounded-2xl bg-surface-soft border border-hairline text-center space-y-2"
      >
        <p class="text-sm font-bold text-ink">{t.noResultsTitle}</p>
        <p class="text-xs text-muted">{t.noResultsSub}</p>
        <button
          type="button"
          id="icc-empty-reset-btn"
          class="mt-2 px-4 py-2 rounded-xl text-xs font-bold bg-primary text-on-primary hover:bg-primary-active transition-colors cursor-pointer"
        >
          {t.clearSearchBtn}
        </button>
      </div>

      <!-- 24 Color-Coded Cookware / Brand Cards -->
      <div id="icc-cards-grid" class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {localizedCookware.map((item) => (
          <article
            data-icc-card={item.id}
            data-icc-status={item.status}
            data-icc-scratch={item.glassScratchRisk}
            data-icc-search={item.keywords}
            class={`icc-card p-4 sm:p-5 rounded-2xl bg-surface-soft/55 border border-hairline ${getCardBorderAccent(item.status)} flex flex-col justify-between gap-3.5 transition-all`}
          >
            <div class="space-y-3">
              <!-- Card Header -->
              <div class="flex items-start justify-between gap-3">
                <div class="flex items-start gap-2.5 min-w-0">
                  <span aria-hidden="true" class="text-xl leading-none mt-0.5 shrink-0">{item.icon}</span>
                  <div class="min-w-0">
                    <h3 class="text-sm sm:text-[15px] font-bold text-ink leading-snug">{item.name}</h3>
                    <p class="text-[11.5px] text-muted mt-0.5 leading-snug">{item.brands}</p>
                  </div>
                </div>
                <span class={`shrink-0 ${getStatusPillClass(item.status)}`}>
                  {getStatusLabel(item.status)}
                </span>
              </div>

              <!-- Spec Badges Strip: Magnet / Efficiency / Scratch Risk -->
              <div class="flex flex-wrap gap-1.5">
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md border border-hairline bg-canvas text-[11px] font-semibold text-ink">
                  🧲 {t.cardMagnetPrefix}: {getMagnetLabel(item.magnetTest)}
                </span>
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md border border-hairline bg-canvas text-[11px] font-semibold text-ink">
                  ⚡ {t.cardEffPrefix}: {getEffLabel(item.heatingEfficiency)}
                </span>
                <span class={`inline-flex items-center gap-1 px-2 py-0.5 rounded-md border text-[11px] font-bold ${getScratchBadgeClass(item.glassScratchRisk)}`}>
                  🛡️ {t.cardScratchPrefix}: {getScratchLabel(item.glassScratchRisk)}
                </span>
              </div>

              <!-- Verdict -->
              <p class="text-xs sm:text-[13px] text-body leading-relaxed">
                {item.verdict}
              </p>
            </div>

            <!-- Boost / Warping Tip + Buyer Tip -->
            <div class="space-y-2 pt-2 border-t border-hairline/70">
              <div class="p-2.5 rounded-xl bg-warning-bg/45 dark:bg-amber-950/25 border border-warning-border/60">
                <span class="block text-[10.5px] font-extrabold uppercase tracking-wider text-ink">
                  🔥 {t.cardBoostTitle}
                </span>
                <p class="text-[12px] text-body leading-relaxed mt-0.5">{item.maxPowerTip}</p>
              </div>
              <div class="p-2.5 rounded-xl bg-canvas border border-hairline">
                <span class="block text-[10.5px] font-extrabold uppercase tracking-wider text-muted">
                  💡 {t.cardBuyerTitle}
                </span>
                <p class="text-[12px] text-body leading-relaxed mt-0.5">{item.buyerTip}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>

    <!-- PART 3: Dedicated Pacemaker / ICD EMF Clearance & Glass Cooktop Protection Card -->
    <div class="border-t border-hairline p-5 sm:p-6 bg-surface-soft/50 space-y-4">
      <div>
        <h2 class="text-title-md font-semibold text-ink">{t.safetySectionTitle}</h2>
        <p class="text-xs sm:text-[13px] text-muted mt-0.5">{t.safetySectionSub}</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
        <!-- Pacemaker / ICD EMF Clearance Card -->
        <article class="p-5 rounded-2xl bg-canvas border border-hairline space-y-3 flex flex-col justify-between">
          <div class="space-y-2.5">
            <span class="inline-block px-2.5 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wider bg-primary text-on-primary">
              ❤️ {t.emfCardBadge}
            </span>
            <h3 class="text-title-sm font-bold text-ink leading-snug">{t.emfCardTitle}</h3>
            <p class="text-xs sm:text-[13px] text-body leading-relaxed">{t.emfCardBody}</p>
            <ul class="space-y-1.5 text-xs sm:text-[13px] text-body list-disc list-outside pl-5">
              {t.emfCardPoints.map((pt) => (
                <li class="leading-relaxed">{pt}</li>
              ))}
            </ul>
          </div>
          <div class="pt-2 print:hidden">
            <a
              href={inductionEmfUrl}
              class="inline-flex items-center text-xs font-bold text-signature-coral hover:underline"
            >
              {t.emfCardCta}
            </a>
          </div>
        </article>

        <!-- Glass Cooktop Protection Card -->
        <article class="p-5 rounded-2xl bg-warning-bg/50 dark:bg-amber-950/25 border border-warning-border/80 space-y-2.5">
          <span class="inline-block px-2.5 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wider bg-error-border text-white">
            🛡️ {t.glassCardBadge}
          </span>
          <h3 class="text-title-sm font-bold text-ink leading-snug">{t.glassCardTitle}</h3>
          <p class="text-xs sm:text-[13px] text-body leading-relaxed">{t.glassCardBody}</p>
          <ul class="space-y-1.5 text-xs sm:text-[13px] text-body list-disc list-outside pl-5">
            {t.glassCardPoints.map((pt) => (
              <li class="leading-relaxed">{pt}</li>
            ))}
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- Related Companion Tools -->
  <section class="space-y-4 print:hidden">
    <h2 class="text-title-md font-semibold text-ink">{t.relatedHeading}</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      <a
        href={cookwareOvenUrl}
        class="p-6 rounded-2xl bg-surface-soft border border-hairline hover:border-signature-coral transition-all group block"
      >
        <span class="text-[11px] font-bold uppercase tracking-wider text-signature-coral block mb-1.5">
          {t.relatedOvenTag}
        </span>
        <h3 class="text-title-sm font-semibold text-ink group-hover:text-signature-coral transition-colors mb-1.5">
          {t.relatedOvenTitle}
        </h3>
        <p class="text-[13.5px] text-body leading-relaxed">{t.relatedOvenDesc}</p>
      </a>

      <a
        href={castIronUrl}
        class="p-6 rounded-2xl bg-surface-soft border border-hairline hover:border-signature-coral transition-all group block"
      >
        <span class="text-[11px] font-bold uppercase tracking-wider text-signature-coral block mb-1.5">
          {t.relatedCastTag}
        </span>
        <h3 class="text-title-sm font-semibold text-ink group-hover:text-signature-coral transition-colors mb-1.5">
          {t.relatedCastTitle}
        </h3>
        <p class="text-[13.5px] text-body leading-relaxed">{t.relatedCastDesc}</p>
      </a>

      <a
        href={inductionEmfUrl}
        class="p-6 rounded-2xl bg-surface-soft border border-hairline hover:border-signature-coral transition-all group block"
      >
        <span class="text-[11px] font-bold uppercase tracking-wider text-signature-coral block mb-1.5">
          {t.relatedEmfTag}
        </span>
        <h3 class="text-title-sm font-semibold text-ink group-hover:text-signature-coral transition-colors mb-1.5">
          {t.relatedEmfTitle}
        </h3>
        <p class="text-[13.5px] text-body leading-relaxed">{t.relatedEmfDesc}</p>
      </a>
    </div>
  </section>

  <!-- Methodology & Hub Strip -->
  <section class="p-6 rounded-2xl bg-surface-soft border border-hairline print:hidden">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <h2 class="text-title-sm font-semibold text-ink mb-1">{t.methodologyStripTitle}</h2>
        <p class="text-[13px] text-muted">
          {t.methodologyStripPrefix}{' '}
          <a href={methodologyUrl} class="text-link underline hover:text-link-active">{t.methodologyLabel}</a>.
        </p>
      </div>
      <div class="flex flex-wrap gap-2">
        <a
          href={inductionEmfUrl}
          class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral transition-colors"
        >
          {t.emfQuickLabel}
        </a>
        <a
          href={methodologyUrl}
          class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral transition-colors"
        >
          {t.methodologyLabel}
        </a>
        <a
          href={allToolsUrl}
          class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-primary text-on-primary hover:bg-primary-active transition-colors"
        >
          {t.allToolsLabel}
        </a>
      </div>
    </div>
  </section>

  <!-- Visible FAQ Accordion (Matches JSON-LD 1:1) -->
  <section class="print:hidden">
    <h2 class="text-title-lg font-medium text-ink tracking-tight mb-6">
      {t.faqTitle}
    </h2>
    <div class="space-y-4">
      {localizedFaqs.map((faq) => (
        <details class="group p-5 bg-surface-soft border border-hairline rounded-xl" open>
          <summary class="text-title-sm font-semibold text-ink cursor-pointer list-none flex items-center justify-between gap-3">
            <span>{faq.question}</span>
            <span class="text-muted text-sm transition-transform group-open:rotate-180 shrink-0" aria-hidden="true">&#9662;</span>
          </summary>
          <p class="text-[14px] text-body leading-relaxed mt-3 pt-3 border-t border-hairline/70">
            {faq.answer}
          </p>
        </details>
      ))}
    </div>
  </section>
</div>

<script is:inline>
  (function () {
    const payloadEl = document.getElementById('icc-payload');
    if (!payloadEl) return;

    let payload;
    try {
      payload = JSON.parse(payloadEl.textContent || '{}');
    } catch (_) {
      return;
    }

    const simResults = payload.simResults || {};
    const ui = payload.ui || {};
    const totalCount = Number(payload.totalCount || 24);

    // Simulator controls & outputs
    const magnetBtns = Array.from(document.querySelectorAll('.icc-magnet-btn'));
    const baseBtns = Array.from(document.querySelectorAll('.icc-base-btn'));
    const simBanner = document.getElementById('icc-sim-banner');
    const simPill = document.getElementById('icc-sim-pill');
    const simHeadline = document.getElementById('icc-sim-headline');
    const simSummary = document.getElementById('icc-sim-summary');
    const simEfficiency = document.getElementById('icc-sim-efficiency');
    const simPower = document.getElementById('icc-sim-power');
    const simTip = document.getElementById('icc-sim-tip');

    // Catalog search & filter controls
    const searchInput = document.getElementById('icc-search-input');
    const clearBtn = document.getElementById('icc-clear-btn');
    const emptyResetBtn = document.getElementById('icc-empty-reset-btn');
    const filterBtns = Array.from(document.querySelectorAll('.icc-filter-btn'));
    const cards = Array.from(document.querySelectorAll('.icc-card'));
    const countReadout = document.getElementById('icc-count-readout');
    const emptyState = document.getElementById('icc-empty-state');
    const cardsGrid = document.getElementById('icc-cards-grid');

    // Top action buttons
    const copyBtn = document.getElementById('icc-copy-btn');
    const copyLabel = document.getElementById('icc-copy-label');
    const printBtn = document.getElementById('icc-print-btn');
    const resetBtn = document.getElementById('icc-reset-btn');

    const state = {
      magnet: 'strong',
      base: 'flat-wide',
      filter: 'all',
      query: ''
    };

    function getStatusPillClass(status) {
      if (status === 'works-great') return 'badge-yes';
      if (status === 'model-dependent') return 'badge-depends';
      return 'badge-no';
    }

    function renderSimulator() {
      const key = state.magnet + '|' + state.base;
      const res = simResults[key] || simResults['strong|flat-wide'];
      if (!res) return;

      magnetBtns.forEach(function (btn) {
        const active = btn.getAttribute('data-icc-magnet') === state.magnet;
        btn.setAttribute('aria-checked', active ? 'true' : 'false');
        btn.classList.toggle('bg-primary', active);
        btn.classList.toggle('text-on-primary', active);
        btn.classList.toggle('border-primary', active);
        btn.classList.toggle('shadow-sm', active);
        btn.classList.toggle('bg-canvas', !active);
        btn.classList.toggle('text-ink', !active);
        btn.classList.toggle('border-hairline', !active);
      });

      baseBtns.forEach(function (btn) {
        const active = btn.getAttribute('data-icc-base') === state.base;
        btn.setAttribute('aria-checked', active ? 'true' : 'false');
        btn.classList.toggle('bg-primary', active);
        btn.classList.toggle('text-on-primary', active);
        btn.classList.toggle('border-primary', active);
        btn.classList.toggle('shadow-sm', active);
        btn.classList.toggle('bg-canvas', !active);
        btn.classList.toggle('text-ink', !active);
        btn.classList.toggle('border-hairline', !active);
      });

      if (simPill) {
        simPill.className = getStatusPillClass(res.status);
        simPill.textContent = res.pill || '';
      }
      if (simHeadline) simHeadline.textContent = res.headline || '';
      if (simSummary) simSummary.textContent = res.summary || '';
      if (simEfficiency) simEfficiency.textContent = res.efficiency || '';
      if (simPower) simPower.textContent = res.powerLimit || '';
      if (simTip) simTip.textContent = res.tip || '';

      if (simBanner) {
        simBanner.classList.remove('border-success-border', 'border-warning-border', 'border-error-border');
        simBanner.classList.add(
          res.status === 'works-great'
            ? 'border-success-border'
            : res.status === 'model-dependent'
              ? 'border-warning-border'
              : 'border-error-border'
        );
      }
    }

    function renderCatalog() {
      const q = (state.query || '').trim().toLowerCase();
      let visibleCount = 0;

      filterBtns.forEach(function (btn) {
        const fVal = btn.getAttribute('data-icc-filter');
        const active = fVal === state.filter;
        const isScratchPill = fVal === 'scratch-risk';

        btn.setAttribute('aria-pressed', active ? 'true' : 'false');
        btn.classList.remove(
          'bg-primary',
          'text-on-primary',
          'border-primary',
          'shadow-sm',
          'bg-canvas',
          'text-ink',
          'border-hairline',
          'bg-warning-bg/50',
          'dark:bg-amber-950/25',
          'border-warning-border/80'
        );

        if (active) {
          btn.classList.add('bg-primary', 'text-on-primary', 'border-primary', 'shadow-sm');
        } else if (isScratchPill) {
          btn.classList.add('bg-warning-bg/50', 'dark:bg-amber-950/25', 'text-ink', 'border-warning-border/80');
        } else {
          btn.classList.add('bg-canvas', 'text-ink', 'border-hairline');
        }
      });

      cards.forEach(function (card) {
        const status = card.getAttribute('data-icc-status') || '';
        const scratch = card.getAttribute('data-icc-scratch') || '';
        const haystack = card.getAttribute('data-icc-search') || '';

        let filterMatch = true;
        if (state.filter === 'works-great' || state.filter === 'model-dependent' || state.filter === 'incompatible') {
          filterMatch = status === state.filter;
        } else if (state.filter === 'scratch-risk') {
          filterMatch = scratch === 'high' || scratch === 'medium';
        }

        const queryMatch = !q || haystack.indexOf(q) !== -1;
        const show = filterMatch && queryMatch;

        card.classList.toggle('hidden', !show);
        if (show) visibleCount += 1;
      });

      if (countReadout) {
        countReadout.textContent =
          (ui.showingPrefix || 'Showing') +
          ' ' +
          visibleCount +
          ' ' +
          (ui.showingOf || 'of') +
          ' ' +
          totalCount +
          ' ' +
          (ui.showingSuffix || 'cookware types');
      }

      const isEmpty = visibleCount === 0;
      if (emptyState) emptyState.classList.toggle('hidden', !isEmpty);
      if (cardsGrid) cardsGrid.classList.toggle('hidden', isEmpty);
    }

    function clearCatalogFilters() {
      state.filter = 'all';
      state.query = '';
      if (searchInput) searchInput.value = '';
      renderCatalog();
    }

    // Event listeners
    magnetBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        const val = btn.getAttribute('data-icc-magnet');
        if (val === 'strong' || val === 'weak' || val === 'none') {
          state.magnet = val;
          renderSimulator();
        }
      });
    });

    baseBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        const val = btn.getAttribute('data-icc-base');
        if (val === 'flat-wide' || val === 'flat-small' || val === 'uneven') {
          state.base = val;
          renderSimulator();
        }
      });
    });

    filterBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        const val = btn.getAttribute('data-icc-filter');
        if (val) {
          state.filter = val;
          renderCatalog();
        }
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', function () {
        state.query = searchInput.value || '';
        renderCatalog();
      });
    }

    if (clearBtn) {
      clearBtn.addEventListener('click', clearCatalogFilters);
    }
    if (emptyResetBtn) {
      emptyResetBtn.addEventListener('click', clearCatalogFilters);
    }

    if (copyBtn) {
      copyBtn.addEventListener('click', function () {
        const checklistText = ui.copyChecklistText || '';
        const showCopied = function () {
          if (copyLabel) copyLabel.textContent = ui.copiedBtn || 'Checklist Copied ✓';
          window.setTimeout(function () {
            if (copyLabel) copyLabel.textContent = '📋 ' + (ui.copyBtn || 'Copy Buying Checklist');
          }, 2200);
        };

        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(checklistText).then(showCopied).catch(showCopied);
        } else {
          const ta = document.createElement('textarea');
          ta.value = checklistText;
          ta.setAttribute('readonly', '');
          ta.style.position = 'absolute';
          ta.style.left = '-9999px';
          document.body.appendChild(ta);
          ta.select();
          try {
            document.execCommand('copy');
          } catch (_) {
            // ignore
          }
          document.body.removeChild(ta);
          showCopied();
        }
      });
    }

    if (printBtn) {
      printBtn.addEventListener('click', function () {
        window.print();
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', function () {
        state.magnet = 'strong';
        state.base = 'flat-wide';
        clearCatalogFilters();
        renderSimulator();
      });
    }

    renderSimulator();
    renderCatalog();
  })();
</script>
