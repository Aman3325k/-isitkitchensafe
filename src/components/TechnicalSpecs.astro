---
interface Props {
  specs?: {
    materialThermal?: {
      property?: string;
      threshold: string;
      details: string;
    };
    safetyStandard?: {
      organization?: string;
      standard: string;
      citation: string;
    };
    applianceSpecs?: {
      parameter: string;
      guideline: string;
    };
  };
  lang?: string;
}

const { specs } = Astro.props;
const hasSpecs = specs && (specs.materialThermal || specs.safetyStandard || specs.applianceSpecs);
---

{hasSpecs && (
  <section class="bg-surface-soft border border-hairline rounded-md p-6 mb-12 shadow-xs" id="technical-specs">
    <div class="flex items-center justify-between mb-4 pb-3 border-b border-hairline">
      <h2 class="text-title-sm text-ink font-semibold flex items-center gap-2">
        <span class="text-signature-coral">🔬</span> Technical & Safety Reference Specs
      </h2>
      <span class="text-[11px] font-mono text-muted uppercase tracking-wider bg-canvas px-2 py-0.5 rounded border border-hairline">
        Verified Reference
      </span>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {specs.materialThermal && (
        <div class="bg-canvas border border-hairline/80 rounded p-4 flex flex-col justify-between">
          <div>
            <span class="text-[11px] font-medium text-muted uppercase tracking-wider block mb-1">
              {specs.materialThermal.property || "Thermal / Material Limit"}
            </span>
            <strong class="text-ink text-[14px] font-semibold block mb-1">
              {specs.materialThermal.threshold}
            </strong>
          </div>
          <p class="text-[12px] text-body leading-relaxed mt-2">
            {specs.materialThermal.details}
          </p>
        </div>
      )}

      {specs.safetyStandard && (
        <div class="bg-canvas border border-hairline/80 rounded p-4 flex flex-col justify-between">
          <div>
            <span class="text-[11px] font-medium text-muted uppercase tracking-wider block mb-1">
              {specs.safetyStandard.organization ? `${specs.safetyStandard.organization} Guideline` : "Official Safety Standard"}
            </span>
            <strong class="text-ink text-[14px] font-semibold block mb-1">
              {specs.safetyStandard.standard}
            </strong>
          </div>
          <p class="text-[12px] text-body leading-relaxed mt-2">
            {specs.safetyStandard.citation}
          </p>
        </div>
      )}

      {specs.applianceSpecs && (
        <div class="bg-canvas border border-hairline/80 rounded p-4 flex flex-col justify-between">
          <div>
            <span class="text-[11px] font-medium text-muted uppercase tracking-wider block mb-1">
              Appliance Operating Range
            </span>
            <strong class="text-ink text-[14px] font-semibold block mb-1">
              {specs.applianceSpecs.parameter}
            </strong>
          </div>
          <p class="text-[12px] text-body leading-relaxed mt-2">
            {specs.applianceSpecs.guideline}
          </p>
        </div>
      )}
    </div>
  </section>
)}
