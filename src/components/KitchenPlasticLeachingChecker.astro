---
import rawData from '../data/kitchen-plastic-leaching-data.json';
import type { SupportedLanguage } from '../i18n/ui';
import { useTranslatedPath } from '../i18n/utils';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;
const translatePath = useTranslatedPath(lang);

const plasticCodeCheckerUrl = translatePath('/tools/plastic-code-checker/');
const migrationPredictorUrl = translatePath('/tools/food-contact-migration-predictor/');
const plasticizerEstimatorUrl = translatePath('/tools/plasticizer-microplastic-burden-estimator/');
const cuttingBoardUrl = translatePath('/tools/cutting-board-microplastic-pathogen-analyzer/');
const panScratchUrl = translatePath('/tools/pan-scratch-inspector/');
const methodologyUrl = translatePath('/methodology/');
const allToolsUrl = translatePath('/tools/');

const currentLocale = (['en', 'es', 'pt', 'zh-cn', 'ja'].includes(lang) ? lang : 'en') as 'en' | 'es' | 'pt' | 'zh-cn' | 'ja';

const bannerData = rawData.safetyBanner[currentLocale] || rawData.safetyBanner.en;

const localizedResins = rawData.resins.map((resin: any) => ({
  code: resin.code,
  name: resin.name,
  fullName: resin.fullName,
  maxTempC: resin.maxTempC,
  maxTempF: resin.maxTempF,
  microwaveSafe: resin.microwaveSafe,
  dishwasherSafe: resin.dishwasherSafe,
  commonUses: resin.commonUses,
  leachingHazards: resin.leachingHazards,
  title: resin.i18n[currentLocale]?.title || resin.i18n.en.title,
  summary: resin.i18n[currentLocale]?.summary || resin.i18n.en.summary,
  bestUse: resin.i18n[currentLocale]?.bestUse || resin.i18n.en.bestUse,
  avoid: resin.i18n[currentLocale]?.avoid || resin.i18n.en.avoid
}));

const localizedFoods = rawData.simulator.foodTypes.map((f: any) => ({
  id: f.id,
  multiplier: f.multiplier,
  name: f.i18n[currentLocale]?.name || f.i18n.en.name,
  desc: f.i18n[currentLocale]?.desc || f.i18n.en.desc
}));

const localizedTemps = rawData.simulator.temps.map((t: any) => ({
  id: t.id,
  tempC: t.tempC,
  tempF: t.tempF,
  multiplier: t.multiplier,
  name: t.i18n[currentLocale]?.name || t.i18n.en.name,
  desc: t.i18n[currentLocale]?.desc || t.i18n.en.desc
}));

const localizedWearStates = rawData.simulator.wearStates.map((w: any) => ({
  id: w.id,
  multiplier: w.multiplier,
  name: w.i18n[currentLocale]?.name || w.i18n.en.name,
  desc: w.i18n[currentLocale]?.desc || w.i18n.en.desc
}));

const localizedFaqs = rawData.faqs[currentLocale] || rawData.faqs.en;

const uiStrings: Record<'en' | 'es' | 'pt' | 'zh-cn' | 'ja', {
  tabSimulator: string;
  tabResinMatrix: string;
  tabScience: string;
  tabSafeSwaps: string;
  resinLabel: string;
  foodLabel: string;
  tempLabel: string;
  wearLabel: string;
  verdictSafe: string;
  verdictCaution: string;
  verdictDanger: string;
  riskScoreLabel: string;
  chemicalsHeader: string;
  microplasticsHeader: string;
  mechanismHeader: string;
  actionHeader: string;
  copyBtn: string;
  copySuccess: string;
  printBtn: string;
  faqHeading: string;
  relatedHeading: string;
  quickChecklistHeader: string;
}> = {
  en: {
    tabSimulator: 'Interactive Leaching Calculator',
    tabResinMatrix: 'Resin #1–#7 Master Table',
    tabScience: 'The Science: Microwave & Fats',
    tabSafeSwaps: 'Safe Swaps & Triage Protocol',
    resinLabel: '1. Select Container Plastic Resin (#1 to #7):',
    foodLabel: '2. Select Food Type & Chemistry:',
    tempLabel: '3. Select Heating & Temperature Exposure:',
    wearLabel: '4. Select Container Physical Condition:',
    verdictSafe: 'LOW LEACHING RISK · RELATIVELY STABLE',
    verdictCaution: 'CONDITIONAL / ELEVATED MIGRATION',
    verdictDanger: 'HIGH CHEMICAL & NANOPLASTIC MIGRATION · DO NOT MICROWAVE',
    riskScoreLabel: 'Overall Chemical & Microplastic Migration Index:',
    chemicalsHeader: 'Primary Chemical Additives Leached:',
    microplasticsHeader: 'Estimated Particle Release (ACS Nano 2023 Scale):',
    mechanismHeader: 'Scientific Leaching Mechanism:',
    actionHeader: 'Actionable Safe Protocol:',
    copyBtn: '📋 Copy Safety Assessment',
    copySuccess: 'Copied to clipboard!',
    printBtn: '🖨️ Print Safe Kitchen Summary',
    faqHeading: 'Scientific FAQs & Peer-Reviewed Evidence',
    relatedHeading: 'Related Verified Diagnostic Tools',
    quickChecklistHeader: '4 Signs Your Plastic Container Must Be Recycled'
  },
  es: {
    tabSimulator: 'Calculadora de Migración Química',
    tabResinMatrix: 'Tabla de Resinas #1 al #7',
    tabScience: 'La Ciencia: Microondas y Grasas',
    tabSafeSwaps: 'Sustitutos Seguros y Protocolo',
    resinLabel: '1. Selecciona la resina plástica (#1 al #7):',
    foodLabel: '2. Selecciona el tipo de comida y acidez:',
    tempLabel: '3. Selecciona la temperatura y calentamiento:',
    wearLabel: '4. Selecciona el desgaste del recipiente:',
    verdictSafe: 'BAJO RIESGO DE MIGRACIÓN · ESTABLE',
    verdictCaution: 'PRECAUCIÓN / MIGRACIÓN MODERADA',
    verdictDanger: 'ALTO RIESGO QUÍMICO Y NANOPLÁSTICOS · NO CALENTAR EN MICROONDAS',
    riskScoreLabel: 'Índice de Migración Química y Microplásticos:',
    chemicalsHeader: 'Principales aditivos químicos liberados:',
    microplasticsHeader: 'Desprendimiento estimado de microplásticos (ACS Nano 2023):',
    mechanismHeader: 'Mecanismo físico-químico:',
    actionHeader: 'Protocolo seguro recomendado:',
    copyBtn: '📋 Copiar evaluación de seguridad',
    copySuccess: '¡Copiado al portapapeles!',
    printBtn: '🖨️ Imprimir resumen de seguridad',
    faqHeading: 'Preguntas Frecuentes y Evidencia Científica',
    relatedHeading: 'Herramientas Diagnósticas Relacionadas',
    quickChecklistHeader: '4 Señales de que tu recipiente de plástico debe ser retirado'
  },
  pt: {
    tabSimulator: 'Calculadora de Migração Química',
    tabResinMatrix: 'Tabela de Resinas #1 a #7',
    tabScience: 'A Ciência: Micro-ondas e Gorduras',
    tabSafeSwaps: 'Substitutos Seguros e Protocolo',
    resinLabel: '1. Selecione a resina plástica (#1 a #7):',
    foodLabel: '2. Selecione o tipo de alimento e acidez:',
    tempLabel: '3. Selecione a temperatura de aquecimento:',
    wearLabel: '4. Selecione o estado de conservação do pote:',
    verdictSafe: 'BAIXO RISCO DE MIGRAÇÃO · ESTÁVEL',
    verdictCaution: 'CUIDADO / MIGRAÇÃO MODERADA',
    verdictDanger: 'ALTO RISCO QUÍMICO E NANOPLÁSTICOS · NÃO LEVE AO MICRO-ONDAS',
    riskScoreLabel: 'Índice de Migração Química e Microplásticos:',
    chemicalsHeader: 'Principais aditivos químicos liberados:',
    microplasticsHeader: 'Desprendimento estimado de partículas (ACS Nano 2023):',
    mechanismHeader: 'Mecanismo científico de migração:',
    actionHeader: 'Protocolo de segurança imediato:',
    copyBtn: '📋 Copiar avaliação de segurança',
    copySuccess: 'Copiado para a área de transferência!',
    printBtn: '🖨️ Imprimir resumo de segurança',
    faqHeading: 'Perguntas Frequentes e Evidências Científicas',
    relatedHeading: 'Ferramentas Diagnósticas Relacionadas',
    quickChecklistHeader: '4 Sinais de que seu pote plástico deve ser descartado'
  },
  'zh-cn': {
    tabSimulator: '塑料化学迁移与微塑料测算器',
    tabResinMatrix: '#1 至 #7 塑料材质全景速查表',
    tabScience: '科学机理：微波辐射与高脂超温',
    tabSafeSwaps: '安全平替材质与报废自检',
    resinLabel: '1. 选择食品塑料容器编号（#1 至 #7）：',
    foodLabel: '2. 选择食物类型与化学性质：',
    tempLabel: '3. 选择接触温度与加热方式：',
    wearLabel: '4. 选择容器内壁磨损与使用状态：',
    verdictSafe: '低化学迁移风险 · 结构相对稳定',
    verdictCaution: '需谨慎使用 · 存在中度化学迁移风险',
    verdictDanger: '高化学溶出与纳米塑料脱落危险 · 严禁微波加热',
    riskScoreLabel: '化学物质与微塑料综合迁移指数：',
    chemicalsHeader: '潜在析出化学添加剂：',
    microplasticsHeader: '估算微塑料与纳米颗粒释放量（基于 ACS Nano 2023 标尺）：',
    mechanismHeader: '微观物理与化学反应机理：',
    actionHeader: '权威安全操作指引：',
    copyBtn: '📋 复制安全评估报告',
    copySuccess: '已成功复制到剪贴板！',
    printBtn: '🖨️ 打印厨房容器安全指南',
    faqHeading: '同行评审学术证据与深度解答',
    relatedHeading: '相关厨房安全诊断工具',
    quickChecklistHeader: '塑料保鲜盒必须立即淘汰报废的 4 大特征'
  },
  ja: {
    tabSimulator: '化学溶出・マイクロプラスチック計算機',
    tabResinMatrix: '#1〜#7 プラスチック樹脂早見表',
    tabScience: '科学の真実：マイクロ波と油分の過熱',
    tabSafeSwaps: '安全な代替素材と廃棄診断',
    resinLabel: '1. 容器のプラスチック識別番号（#1〜#7）を選択：',
    foodLabel: '2. 食品の種類と油分・酸性を選択：',
    tempLabel: '3. 加熱温度・調理条件を選択：',
    wearLabel: '4. 容器の内壁劣化・傷の状態を選択：',
    verdictSafe: '溶出リスク低 · 比較的安定',
    verdictCaution: '条件付き注意 · 中程度の化学物質移行あり',
    verdictDanger: '高リスク・有害化学物質＆ナノプラスチック溶出 · レンジ加熱厳禁',
    riskScoreLabel: '化学物質・マイクロプラスチック総合溶出指数：',
    chemicalsHeader: '溶出が懸念される主たる添加剤：',
    microplasticsHeader: '推定微小粒子放出量（ACS Nano 2023論文基準）：',
    mechanismHeader: '物理・化学的溶出メカニズム：',
    actionHeader: '推奨される安全対策手順：',
    copyBtn: '📋 診断結果をコピー',
    copySuccess: 'クリップボードにコピーしました！',
    printBtn: '🖨️ 診断サマリーを印刷',
    faqHeading: '査読論文エビデンスに基づくFAQ',
    relatedHeading: '関連キッチン安全ツール',
    quickChecklistHeader: 'プラスチック保存容器を直ちに廃棄すべき4大サイン'
  }
};

const t = uiStrings[currentLocale];
---

<div class="space-y-10" id="plastic-leaching-app">
  <!-- Top Safety Banner -->
  <div class="bg-amber-50 border border-amber-200 rounded-2xl p-6 text-amber-950">
    <div class="flex items-start gap-3">
      <span class="text-2xl" aria-hidden="true">⚠️</span>
      <div>
        <h2 class="text-base font-bold text-amber-900 mb-1">{bannerData.title}</h2>
        <p class="text-sm leading-relaxed text-amber-900/90">{bannerData.text}</p>
      </div>
    </div>
  </div>

  <!-- Tab Navigation -->
  <div class="flex flex-wrap gap-2 border-b border-hairline pb-4" role="tablist" aria-label="Tool Navigation">
    <button
      type="button"
      role="tab"
      aria-selected="true"
      aria-controls="tab-panel-simulator"
      id="tab-btn-simulator"
      class="tab-btn px-4 py-2 rounded-xl text-sm font-semibold transition-all bg-signature-coral text-white shadow-sm"
      data-target="tab-panel-simulator"
    >
      🧮 {t.tabSimulator}
    </button>
    <button
      type="button"
      role="tab"
      aria-selected="false"
      aria-controls="tab-panel-matrix"
      id="tab-btn-matrix"
      class="tab-btn px-4 py-2 rounded-xl text-sm font-semibold transition-all bg-surface-soft hover:bg-neutral-200 text-ink"
      data-target="tab-panel-matrix"
    >
      📋 {t.tabResinMatrix}
    </button>
    <button
      type="button"
      role="tab"
      aria-selected="false"
      aria-controls="tab-panel-science"
      id="tab-btn-science"
      class="tab-btn px-4 py-2 rounded-xl text-sm font-semibold transition-all bg-surface-soft hover:bg-neutral-200 text-ink"
      data-target="tab-panel-science"
    >
      🔬 {t.tabScience}
    </button>
    <button
      type="button"
      role="tab"
      aria-selected="false"
      aria-controls="tab-panel-swaps"
      id="tab-btn-swaps"
      class="tab-btn px-4 py-2 rounded-xl text-sm font-semibold transition-all bg-surface-soft hover:bg-neutral-200 text-ink"
      data-target="tab-panel-swaps"
    >
      🔄 {t.tabSafeSwaps}
    </button>
  </div>

  <!-- TAB 1: INTERACTIVE CALCULATOR PANEL -->
  <section id="tab-panel-simulator" role="tabpanel" aria-labelledby="tab-btn-simulator" class="tab-panel space-y-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      <!-- Input Controls -->
      <div class="lg:col-span-6 space-y-6 bg-white p-6 rounded-2xl border border-hairline shadow-sm">
        <h2 class="text-lg font-bold text-ink">Configure Container & Heating Scenario</h2>

        <!-- 1. Resin Picker -->
        <div>
          <label for="resin-select" class="block text-xs font-bold uppercase tracking-wider text-neutral-600 mb-2">
            {t.resinLabel}
          </label>
          <select id="resin-select" class="w-full p-3 rounded-xl border border-hairline bg-surface-soft text-ink font-medium focus:ring-2 focus:ring-signature-coral focus:outline-none">
            {localizedResins.map((r: any) => (
              <option value={r.code} selected={r.code === 5}>
                #{r.code} {r.name} - {r.fullName} (Max: {r.maxTempC}°C / {r.maxTempF}°F)
              </option>
            ))}
          </select>
        </div>

        <!-- 2. Food Type Picker -->
        <div>
          <label for="food-select" class="block text-xs font-bold uppercase tracking-wider text-neutral-600 mb-2">
            {t.foodLabel}
          </label>
          <select id="food-select" class="w-full p-3 rounded-xl border border-hairline bg-surface-soft text-ink font-medium focus:ring-2 focus:ring-signature-coral focus:outline-none">
            {localizedFoods.map((f: any) => (
              <option value={f.id} selected={f.id === 'oily'}>
                {f.name}
              </option>
            ))}
          </select>
          <p id="food-desc" class="text-xs text-neutral-500 mt-1.5 leading-relaxed"></p>
        </div>

        <!-- 3. Temperature Picker -->
        <div>
          <label for="temp-select" class="block text-xs font-bold uppercase tracking-wider text-neutral-600 mb-2">
            {t.tempLabel}
          </label>
          <select id="temp-select" class="w-full p-3 rounded-xl border border-hairline bg-surface-soft text-ink font-medium focus:ring-2 focus:ring-signature-coral focus:outline-none">
            {localizedTemps.map((tm: any) => (
              <option value={tm.id} selected={tm.id === 'microwave'}>
                {tm.name}
              </option>
            ))}
          </select>
          <p id="temp-desc" class="text-xs text-neutral-500 mt-1.5 leading-relaxed"></p>
        </div>

        <!-- 4. Wear State Picker -->
        <div>
          <label for="wear-select" class="block text-xs font-bold uppercase tracking-wider text-neutral-600 mb-2">
            {t.wearLabel}
          </label>
          <select id="wear-select" class="w-full p-3 rounded-xl border border-hairline bg-surface-soft text-ink font-medium focus:ring-2 focus:ring-signature-coral focus:outline-none">
            {localizedWearStates.map((w: any) => (
              <option value={w.id} selected={w.id === 'scratched'}>
                {w.name}
              </option>
            ))}
          </select>
          <p id="wear-desc" class="text-xs text-neutral-500 mt-1.5 leading-relaxed"></p>
        </div>
      </div>

      <!-- Live Results Card -->
      <div class="lg:col-span-6 flex flex-col justify-between bg-surface-soft p-6 md:p-8 rounded-2xl border border-hairline shadow-sm space-y-6">
        <div>
          <!-- Verdict Badge -->
          <div id="verdict-badge" class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider mb-4 bg-red-100 text-red-800 border border-red-200">
            <span class="inline-block w-2.5 h-2.5 rounded-full bg-red-600 animate-pulse"></span>
            <span id="verdict-text">{t.verdictDanger}</span>
          </div>

          <h3 id="result-headline" class="text-xl md:text-2xl font-bold text-ink mb-2">
            Polypropylene Reheated with Hot Oils
          </h3>
          <p id="result-summary" class="text-sm text-body leading-relaxed mb-6">
            Localized oil superheating creates thermal pits, accelerating microplastic shedding and additive migration.
          </p>

          <!-- Leaching Risk Score Gauge -->
          <div class="space-y-2 mb-6">
            <div class="flex justify-between items-center text-xs font-bold">
              <span class="text-neutral-600 uppercase tracking-wider">{t.riskScoreLabel}</span>
              <span id="risk-score-value" class="text-base text-red-700 font-extrabold">85 / 100</span>
            </div>
            <div class="w-full h-3 rounded-full bg-neutral-200 overflow-hidden">
              <div id="risk-score-bar" class="h-full bg-red-600 rounded-full transition-all duration-500" style="width: 85%;"></div>
            </div>
          </div>

          <!-- Microplastic & Chemical Details -->
          <div class="space-y-4 pt-4 border-t border-hairline">
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-neutral-500 block mb-1">
                {t.chemicalsHeader}
              </span>
              <p id="chemicals-list" class="text-sm font-medium text-ink bg-white p-2.5 rounded-xl border border-hairline">
                Phthalate esters, slip agents (erucamide), hindered amine light stabilizers (HALS), cyclic oligomers.
              </p>
            </div>

            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-neutral-500 block mb-1">
                {t.microplasticsHeader}
              </span>
              <p id="microplastics-estimate" class="text-sm font-medium text-ink bg-white p-2.5 rounded-xl border border-hairline">
                ~1,200,000 to 4,200,000 microplastics + ~2.1 billion nanoplastics / cm²
              </p>
            </div>

            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-neutral-500 block mb-1">
                {t.mechanismHeader}
              </span>
              <p id="mechanism-text" class="text-xs text-body leading-relaxed">
                Lipids act as non-polar extraction solvents while microwave dielectric hot spots exceed 150°C, causing surface melting.
              </p>
            </div>

            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-neutral-500 block mb-1">
                {t.actionHeader}
              </span>
              <p id="action-text" class="text-xs font-semibold text-signature-coral leading-relaxed">
                Transfer to a lead-free ceramic bowl or borosilicate glass container before heating. Never microwave oily foods in plastic.
              </p>
            </div>
          </div>
        </div>

        <!-- Buttons -->
        <div class="flex flex-wrap gap-3 pt-4 border-t border-hairline">
          <button
            type="button"
            id="copy-report-btn"
            class="px-4 py-2.5 rounded-xl bg-white hover:bg-neutral-100 text-ink border border-hairline text-xs font-bold transition-all shadow-sm flex items-center gap-2"
          >
            {t.copyBtn}
          </button>
          <button
            type="button"
            onclick="window.print()"
            class="px-4 py-2.5 rounded-xl bg-white hover:bg-neutral-100 text-ink border border-hairline text-xs font-bold transition-all shadow-sm flex items-center gap-2"
          >
            {t.printBtn}
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- TAB 2: RESIN MATRIX PANEL -->
  <section id="tab-panel-matrix" role="tabpanel" aria-labelledby="tab-btn-matrix" class="tab-panel hidden space-y-6">
    <div class="bg-white rounded-2xl border border-hairline shadow-sm overflow-hidden">
      <div class="p-6 border-b border-hairline">
        <h2 class="text-lg font-bold text-ink mb-1">Resin Identification Code (RIC #1 to #7) Safety Matrix</h2>
        <p class="text-xs text-body leading-relaxed">
          Standardized under ASTM D7611 and ISO 1043. Review each polymer's exact maximum heat tolerance, microwave safety, and dishwasher suitability.
        </p>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs border-collapse">
          <thead>
            <tr class="bg-surface-soft border-b border-hairline text-ink font-bold">
              <th class="p-3.5">Code & Polymer</th>
              <th class="p-3.5">Max Safe Temp</th>
              <th class="p-3.5">Microwave</th>
              <th class="p-3.5">Dishwasher</th>
              <th class="p-3.5">Common Products</th>
              <th class="p-3.5">Primary Leaching Hazard</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-hairline">
            {localizedResins.map((r: any) => (
              <tr class="hover:bg-neutral-50 transition-colors">
                <td class="p-3.5 font-bold text-ink whitespace-nowrap">
                  <span class="inline-block px-2 py-0.5 rounded bg-neutral-100 font-mono text-xs mr-1.5 border border-hairline">#{r.code}</span>
                  {r.name}
                </td>
                <td class="p-3.5 whitespace-nowrap font-medium text-ink">
                  {r.maxTempC}°C / {r.maxTempF}°F
                </td>
                <td class="p-3.5">
                  <span class={`inline-block px-2 py-0.5 rounded text-[11px] font-bold ${
                    r.microwaveSafe === 'safe'
                      ? 'bg-green-100 text-green-800'
                      : r.microwaveSafe === 'conditional'
                      ? 'bg-amber-100 text-amber-800'
                      : 'bg-red-100 text-red-800'
                  }`}>
                    {r.microwaveSafe.toUpperCase()}
                  </span>
                </td>
                <td class="p-3.5">
                  <span class={`inline-block px-2 py-0.5 rounded text-[11px] font-bold ${
                    r.dishwasherSafe === 'top-rack'
                      ? 'bg-green-100 text-green-800'
                      : r.dishwasherSafe === 'conditional'
                      ? 'bg-amber-100 text-amber-800'
                      : 'bg-red-100 text-red-800'
                  }`}>
                    {r.dishwasherSafe.toUpperCase()}
                  </span>
                </td>
                <td class="p-3.5 text-neutral-600 max-w-xs">{r.commonUses}</td>
                <td class="p-3.5 text-neutral-600 max-w-xs">{r.leachingHazards}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
