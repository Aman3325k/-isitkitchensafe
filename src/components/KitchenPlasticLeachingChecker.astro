<!-- Reactive Client-Side Simulation Script -->
<script is:inline define:vars={{ rawData, currentLocale, t }}>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Tab switching
    const tabButtons = document.querySelectorAll('.tab-btn');
    const tabPanels = document.querySelectorAll('.tab-panel');

    tabButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        tabButtons.forEach(b => {
          b.setAttribute('aria-selected', 'false');
          b.classList.remove('bg-signature-coral', 'text-white', 'shadow-sm');
          b.classList.add('bg-surface-soft', 'text-ink');
        });
        tabPanels.forEach(p => p.classList.add('hidden'));

        btn.setAttribute('aria-selected', 'true');
        btn.classList.add('bg-signature-coral', 'text-white', 'shadow-sm');
        btn.classList.remove('bg-surface-soft', 'text-ink');

        const activePanel = document.getElementById(targetId);
        if (activePanel) {
          activePanel.classList.remove('hidden');
        }
      });
    });

    // 2. Simulator Logic
    const resinSelect = document.getElementById('resin-select');
    const foodSelect = document.getElementById('food-select');
    const tempSelect = document.getElementById('temp-select');
    const wearSelect = document.getElementById('wear-select');

    const foodDesc = document.getElementById('food-desc');
    const tempDesc = document.getElementById('temp-desc');
    const wearDesc = document.getElementById('wear-desc');

    const verdictBadge = document.getElementById('verdict-badge');
    const verdictText = document.getElementById('verdict-text');
    const resultHeadline = document.getElementById('result-headline');
    const resultSummary = document.getElementById('result-summary');
    const riskScoreValue = document.getElementById('risk-score-value');
    const riskScoreBar = document.getElementById('risk-score-bar');
    const chemicalsList = document.getElementById('chemicals-list');
    const microplasticsEstimate = document.getElementById('microplastics-estimate');
    const mechanismText = document.getElementById('mechanism-text');
    const actionText = document.getElementById('action-text');

    function updateSimulation() {
      const resinCode = parseInt(resinSelect.value, 10);
      const foodId = foodSelect.value;
      const tempId = tempSelect.value;
      const wearId = wearSelect.value;

      const resinObj = rawData.resins.find(r => r.code === resinCode) || rawData.resins[4];
      const foodObj = rawData.simulator.foodTypes.find(f => f.id === foodId) || rawData.simulator.foodTypes[0];
      const tempObj = rawData.simulator.temps.find(t => t.id === tempId) || rawData.simulator.temps[0];
      const wearObj = rawData.simulator.wearStates.find(w => w.id === wearId) || rawData.simulator.wearStates[0];

      // Update helper description texts
      if (foodDesc) foodDesc.textContent = foodObj.i18n[currentLocale]?.desc || foodObj.i18n.en.desc;
      if (tempDesc) tempDesc.textContent = tempObj.i18n[currentLocale]?.desc || tempObj.i18n.en.desc;
      if (wearDesc) wearDesc.textContent = wearObj.i18n[currentLocale]?.desc || wearObj.i18n.en.desc;

      // Calculate composite score
      let baseResinFactor = 20;
      if (resinCode === 1) baseResinFactor = 55; // PET
      else if (resinCode === 2) baseResinFactor = 15; // HDPE
      else if (resinCode === 3) baseResinFactor = 75; // PVC
      else if (resinCode === 4) baseResinFactor = 25; // LDPE
      else if (resinCode === 5) baseResinFactor = 18; // PP
      else if (resinCode === 6) baseResinFactor = 85; // PS
      else if (resinCode === 7) baseResinFactor = 65; // Other / PC / Melamine

      const composite = Math.min(100, Math.round(
        baseResinFactor * 0.35 +
        (foodObj.multiplier * 6.5) +
        (tempObj.multiplier * 3.2) +
        (wearObj.multiplier * 4.0)
      ));

      // Overheating override
      const isOverheated = (tempObj.tempC > resinObj.maxTempC);
      let finalScore = composite;
      if (isOverheated) {
        finalScore = Math.max(finalScore, 82);
      }
      if (resinCode === 6 && (tempId === 'boiling' || tempId === 'microwave')) {
        finalScore = 98; // Styrofoam heated
      }
      if (resinCode === 3 && (tempId === 'boiling' || tempId === 'microwave')) {
        finalScore = 95; // PVC heated
      }
      finalScore = Math.min(100, finalScore);

      // Render Badge & Colors
      if (finalScore >= 75) {
        verdictBadge.className = 'inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider mb-4 bg-red-100 text-red-800 border border-red-200';
        verdictText.textContent = t.verdictDanger;
        riskScoreValue.className = 'text-base text-red-700 font-extrabold';
        riskScoreBar.className = 'h-full bg-red-600 rounded-full transition-all duration-500';
      } else if (finalScore >= 40) {
        verdictBadge.className = 'inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider mb-4 bg-amber-100 text-amber-800 border border-amber-200';
        verdictText.textContent = t.verdictCaution;
        riskScoreValue.className = 'text-base text-amber-700 font-extrabold';
        riskScoreBar.className = 'h-full bg-amber-500 rounded-full transition-all duration-500';
      } else {
        verdictBadge.className = 'inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider mb-4 bg-green-100 text-green-800 border border-green-200';
        verdictText.textContent = t.verdictSafe;
        riskScoreValue.className = 'text-base text-green-700 font-extrabold';
        riskScoreBar.className = 'h-full bg-green-600 rounded-full transition-all duration-500';
      }

      riskScoreValue.textContent = `${finalScore} / 100`;
      riskScoreBar.style.width = `${finalScore}%`;

      // Headline & Details
      const resinTitle = resinObj.i18n[currentLocale]?.title || resinObj.i18n.en.title;
      resultHeadline.textContent = `${resinTitle} — ${foodObj.i18n[currentLocale]?.name || foodObj.i18n.en.name}`;

      if (isOverheated) {
        resultSummary.textContent = `CRITICAL WARNING: Temperature (${tempObj.tempC}°C / ${tempObj.tempF}°F) exceeds maximum resin stability limit (${resinObj.maxTempC}°C / ${resinObj.maxTempF}°F). Polymer melting and chemical structural breakdown occur.`;
      } else {
        resultSummary.textContent = resinObj.i18n[currentLocale]?.summary || resinObj.i18n.en.summary;
      }

      // Microplastics estimate text
      let particleEst = '~500 to 25,000 particles / cm² (cold/dry baseline)';
      if (tempId === 'warm') particleEst = '~50,000 to 350,000 microplastics / cm²';
      else if (tempId === 'boiling') particleEst = '~850,000 to 2,100,000 microplastics + nanoplastics / cm²';
      else if (tempId === 'microwave') particleEst = '~1,200,000 to 4,220,000 microplastics + >2.1 billion nanoplastics / cm²';
      if (wearId === 'degraded') particleEst += ' (× 5.0 multiplier due to surface micro-cracking)';
      microplasticsEstimate.textContent = particleEst;

      chemicalsList.textContent = resinObj.leachingHazards;

      if (isOverheated) {
        mechanismText.textContent = `Thermal energy exceeds secondary polymer van der Waals bonds. Matrix relaxation allows volatile organic compounds, unreacted monomers, and catalyst residue to migrate into the food.`;
        actionText.textContent = `DO NOT CONSUME food heated past resin tolerance. Discard or transfer remaining portions immediately to borosilicate glass or lead-free ceramic.`;
      } else if (tempId === 'microwave') {
        mechanismText.textContent = `Dielectric hot-spotting causes localized molten fat interface temperatures (>160°C). Non-polar fatty acids rapidly solvate lipophilic plastic additives.`;
        actionText.textContent = `Plate before heating! Always transfer refrigerated leftovers to a ceramic plate or glass bowl prior to microwaving.`;
      } else {
        mechanismText.textContent = `Aqueous diffusion at low temperature remains below regulatory migration limits. Minimal chemical transfer occurs into non-fatty neutral food.`;
        actionText.textContent = `Safe for storage. Hand wash or place on top rack of dishwasher away from heating elements. Avoid metal fork scratches.`;
      }
    }

    resinSelect.addEventListener('change', updateSimulation);
    foodSelect.addEventListener('change', updateSimulation);
    tempSelect.addEventListener('change', updateSimulation);
    wearSelect.addEventListener('change', updateSimulation);

    // Initial run
    updateSimulation();

    // Copy report
    const copyBtn = document.getElementById('copy-report-btn');
    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        const textToCopy = `IsItKitchenSafe Plastic Leaching Assessment\n` +
          `-----------------------------------------\n` +
          `Resin: ${resinSelect.options[resinSelect.selectedIndex].text}\n` +
          `Food: ${foodSelect.options[foodSelect.selectedIndex].text}\n` +
          `Exposure: ${tempSelect.options[tempSelect.selectedIndex].text}\n` +
          `Condition: ${wearSelect.options[wearSelect.selectedIndex].text}\n` +
          `Verdict: ${verdictText.textContent}\n` +
          `Migration Index: ${riskScoreValue.textContent}\n` +
          `Chemicals: ${chemicalsList.textContent}\n` +
          `Microplastics: ${microplasticsEstimate.textContent}\n` +
          `Protocol: ${actionText.textContent}\n` +
          `Verified at: https://isitkitchensafe.com/tools/kitchen-plastic-leaching-checker/`;

        navigator.clipboard.writeText(textToCopy).then(() => {
          const originalText = copyBtn.innerHTML;
          copyBtn.innerHTML = `✅ ${t.copySuccess}`;
          setTimeout(() => {
            copyBtn.innerHTML = originalText;
          }, 2500);
        });
      });
    }
  });
</script>
