  <!-- Regulatory Compliance & Standards -->
  <div class="bg-surface-soft p-6 rounded-3xl border border-hairline">
    <h3 class="text-sm font-bold text-ink uppercase tracking-wider mb-2">{d.regTitle}</h3>
    <p class="text-xs text-muted leading-relaxed">{d.regSub}</p>
