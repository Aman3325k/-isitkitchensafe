              <td class="py-3 px-3">{c.highPressureHomogenization}</td>
              <td class="py-3 px-3">{c.ultrasonicProbeSonication}</td>
              <td class="py-3 px-3">{c.thinFilmEthanolInjection}</td>
            </tr>
          ))}
        </tbody>
      </table>
