<script>
  // Client-side interactive telemetry engine for RESOLV Skid
  const container = document.querySelector('.resolv-modeler');
  if (container) {
    const payloadSelect = document.getElementById('resolv-payload-select') as HTMLSelectElement;
    const payloadDesc = document.getElementById('resolv-payload-desc');
    const pressureSlider = document.getElementById('resolv-pressure-slider') as HTMLInputElement;
    const pressureVal = document.getElementById('resolv-pressure-val');
    const tempSlider = document.getElementById('resolv-temp-slider') as HTMLInputElement;
    const tempVal = document.getElementById('resolv-temp-val');
    const orificeSlider = document.getElementById('resolv-orifice-slider') as HTMLInputElement;
    const orificeVal = document.getElementById('resolv-orifice-val');
    const modifierSlider = document.getElementById('resolv-modifier-slider') as HTMLInputElement;
    const modifierVal = document.getElementById('resolv-modifier-val');
    const flowSlider = document.getElementById('resolv-flow-slider') as HTMLInputElement;
    const flowVal = document.getElementById('resolv-flow-val');

    // Telemetry displays
    const teleMach = document.getElementById('telemetry-mach');
    const teleDecomp = document.getElementById('telemetry-decomp');
    const teleDiameter = document.getElementById('telemetry-diameter');
    const telePdi = document.getElementById('telemetry-pdi');
    const teleEntrapment = document.getElementById('telemetry-entrapment');
    const teleStability = document.getElementById('telemetry-stability');
    const teleSolvent = document.getElementById('telemetry-solvent');
    const teleIntegrity = document.getElementById('telemetry-integrity');
    const teleSec = document.getElementById('telemetry-sec');
    const teleVerdict = document.getElementById('telemetry-verdict');

    const presets = {
      astaxanthin: { payload: 'astaxanthin_hspc_nanoliposomes', p: 260, t: 42.0, d: 65, m: 3.5, f: 85 },
      coq10: { payload: 'coenzyme_q10_dopc_nanoliposomes', p: 240, t: 40.0, d: 75, m: 4.0, f: 90 },
      curcumin: { payload: 'curcumin_soy_pc_nanoliposomes', p: 280, t: 44.0, d: 60, m: 5.0, f: 75 },
      cbd: { payload: 'cannabidiol_egg_pc_nanoliposomes', p: 220, t: 39.0, d: 80, m: 3.0, f: 100 },
      hazard: { payload: 'astaxanthin_hspc_nanoliposomes', p: 155, t: 33.0, d: 135, m: 1.0, f: 35 }
    };

    function recalculate() {
      const p = parseFloat(pressureSlider.value);
      const t = parseFloat(tempSlider.value);
      const dNozzle = parseFloat(orificeSlider.value);
      const modifier = parseFloat(modifierSlider.value);
      const flow = parseFloat(flowSlider.value);

      if (pressureVal) pressureVal.textContent = `${p} bar`;
      if (tempVal) tempVal.textContent = `${t.toFixed(1)} °C`;
      if (orificeVal) orificeVal.textContent = `${dNozzle} µm`;
      if (modifierVal) modifierVal.textContent = `${modifier.toFixed(1)} %`;
      if (flowVal) flowVal.textContent = `${flow} mL/min`;

      // Check subcritical hazard
      const isSubcritical = p < 170 || t < 35.0;

      // Physics model:
      // Mach number M scales with pressure ratio P_0 / P_receiver (P_rec = 1.013 bar)
      const pr = p / 1.013;
      const mach = isSubcritical ? 0.95 : Math.min(3.2, 1.2 + 0.45 * Math.log10(pr));
      const jetVelocity = mach * 585.0; // speed of sound in scCO2 ~ 585 m/s

      // Characteristic decompression duration tau = L_nozzle / v_jet, with L/D = 10 -> L = 10 * dNozzle
      const lengthM = 10 * dNozzle * 1e-6;
      const tauMicrosec = Math.max(0.15, (lengthM / Math.max(200, jetVelocity)) * 1e6);

      // Mean vesicle diameter d_50: higher pressure -> faster expansion -> smaller vesicles
      // Smaller nozzle orifice -> faster quenching -> smaller vesicles
      let d50 = (dNozzle * 0.75) * Math.pow(250 / p, 0.65) * (1 - (modifier - 2.0) * 0.03);
      if (isSubcritical) d50 = 180 + (170 - p) * 1.5;
      d50 = Math.max(45.0, Math.min(220.0, d50));

      // Polydispersity Index
      let pdi = 0.032 + (dNozzle / 120) * 0.010 + (Math.abs(t - 41) / 30) * 0.008;
      if (isSubcritical) pdi = 0.28 + (170 - p) * 0.005;
      pdi = Math.min(0.45, Math.max(0.025, pdi));

      // Entrapment efficiency
      let ee = 99.2 - (d50 / 150) * 2.5 - Math.max(0, (t - 45) * 0.4);
      if (isSubcritical) ee = 62.0 - (170 - p) * 0.5;
      ee = Math.max(40.0, Math.min(99.4, ee));

      // Stability half-life (days)
      let stability = Math.round(420 * (65 / d50) * (0.040 / pdi));
      if (isSubcritical) stability = Math.round(18 + p * 0.2);

      // Residual solvent & integrity
      const solventPpm = (modifier * 0.12).toFixed(1);
      const integrity = isSubcritical ? '88.5 %' : '100.0 %';
      const secKwh = (0.35 + (p / 300) * 0.08 + (flow / 150) * 0.04).toFixed(2);

      // Update UI elements
      if (teleMach) {
        teleMach.textContent = `M = ${mach.toFixed(2)}`;
        teleMach.className = isSubcritical ? 'text-xl font-black font-mono text-rose-400 mt-1' : 'text-xl font-black font-mono text-emerald-400 mt-1';
      }
      if (teleDecomp) teleDecomp.textContent = `${tauMicrosec.toFixed(2)} µs`;
      if (teleDiameter) {
        teleDiameter.textContent = `${d50.toFixed(1)} nm`;
        teleDiameter.className = d50 < 85 ? 'text-xl font-black font-mono text-emerald-400 mt-1' : 'text-xl font-black font-mono text-amber-400 mt-1';
      }
      if (telePdi) {
        telePdi.textContent = pdi.toFixed(3);
        telePdi.className = pdi < 0.045 ? 'text-xl font-black font-mono text-emerald-400 mt-1' : 'text-xl font-black font-mono text-amber-400 mt-1';
      }
      if (teleEntrapment) teleEntrapment.textContent = `${ee.toFixed(1)} %`;
      if (teleStability) teleStability.textContent = `${stability} Days`;
      if (teleSolvent) teleSolvent.textContent = `< ${solventPpm} ppm`;
      if (teleIntegrity) teleIntegrity.textContent = integrity;
      if (teleSec) teleSec.textContent = `${secKwh} kWh/kg (>86% Energy Savings vs Drying Towers)`;

      if (teleVerdict) {
        if (isSubcritical) {
          teleVerdict.className = 'text-xs font-bold text-rose-400 flex items-center gap-1.5';
          teleVerdict.innerHTML = '<span class="inline-block w-2 h-2 rounded-full bg-rose-500 animate-ping"></span> HAZARD DETECTED: Subcritical Pressure/Temperature Regime - Incomplete Expansion & Micro-Orifice Freeze Risk (USP &lt;729&gt; Fail)';
        } else if (d50 > 85 || pdi > 0.045) {
          teleVerdict.className = 'text-xs font-bold text-amber-400 flex items-center gap-1.5';
          teleVerdict.innerHTML = '<span class="inline-block w-2 h-2 rounded-full bg-amber-500"></span> MODERATE VESICLE GROWTH: Unilamellar Quality Compromised by Large Orifice Diameter or Low Pressure';
        } else {
          teleVerdict.className = 'text-xs font-bold text-emerald-400 flex items-center gap-1.5';
          teleVerdict.innerHTML = '<span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> OPTIMAL RESOLV NANO-LIPOSOME REGIME: High-Yield Unilamellar Vesicles (USP &lt;729&gt; &amp; &lt;711&gt; cGMP Certified)';
        }
      }
    }

    [pressureSlider, tempSlider, orificeSlider, modifierSlider, flowSlider].forEach(input => {
      input?.addEventListener('input', recalculate);
    });

    payloadSelect?.addEventListener('change', () => {
      const selected = (window as any).RESOLV_DATA?.bioactivePayloadFormulations?.find((f: any) => f.id === payloadSelect.value);
      if (selected && payloadDesc) {
        payloadDesc.textContent = selected.payloadDescription;
        pressureSlider.value = selected.operatingPressureBar.toString();
        tempSlider.value = selected.operatingTemperatureCelsius.toString();
        orificeSlider.value = selected.orificeDiameterMicrons.toString();
        modifierSlider.value = selected.modifierEthanolPct.toString();
        flowSlider.value = selected.aqueousFlowRateMlMin.toString();
        recalculate();
      }
    });

    document.querySelectorAll('.preset-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const presetKey = (e.currentTarget as HTMLElement).getAttribute('data-preset');
        if (presetKey && presets[presetKey as keyof typeof presets]) {
          const cfg = presets[presetKey as keyof typeof presets];
          if (payloadSelect) payloadSelect.value = cfg.payload;
          if (pressureSlider) pressureSlider.value = cfg.p.toString();
          if (tempSlider) tempSlider.value = cfg.t.toString();
          if (orificeSlider) orificeSlider.value = cfg.d.toString();
          if (modifierSlider) modifierSlider.value = cfg.m.toString();
          if (flowSlider) flowSlider.value = cfg.f.toString();
          recalculate();
        }
      });
    });

    recalculate();
  }
</script>
