    flowHelp: "水下衝突膨張反応チャンバーを通過する水相安定化液の連続体積流量。",
    presetsTitle: "クイックシミュレーションプリセット：",
    presetAstaxanthin: "アスタキサンチンナノリポソーム (65 nm)",
    presetCoq10: "コエンザイムQ10ナノリポソーム (72 nm)",
    presetCurcumin: "クルクミンナノリポソーム (58 nm)",
    presetCbd: "ブロードスペクトラムCBD (82 nm)",
    presetHazard: "亜臨界状態/ノズル凍結閉塞ハザード",
    telemetryTitle: "リアルタイム RESOLV 超音速流体動力学およびナノリポソームテレメトリ",
    telemetrySub: "即時物理熱力学計算：超音速膨張マッハ数、瞬間減圧持続時間、平均小胞粒径、PDI、封入効率、および USP <729> 安定性。",
    machLabel: "超音速膨張マッハ数 (M)：",
    decompTimeLabel: "特徴的超高速減圧持続時間 (τ_exp)：",
    vesicleDiameterLabel: "平均小胞粒径 (d_50)：",
    pdiLabel: "多分散度指数 (PDI)：",
    entrapmentLabel: "生体活性物質封入効率 (EE)：",
    stabilityLabel: "水相分散物理的安定性半減期：",
    residualSolventLabel: "残留有機溶媒濃度 (ppm)：",
    integrityLabel: "生体活性分子完全性：",
    secLabel: "比消費電力量 (SEC)：",
    verdictLabel: "ナノリポソーム合成判定および USP 適合等級：",
    diagramTitle: "サファイア微細ノズルおよび水中超音速膨張チャンバー",
    diagramSub: "超臨界流体がサファイア微細ノズルから水相受容液中へ直接噴射され超音速減圧気化と自己組織化が進行、サイクロン気液分離器および閉ループCO2循環系へ送られます。",
    chartTitle: "180日間物理的安定性および活性物質保持キネティクス比較",
    chartSub: "長期安定性と小胞サイズ均一性の比較：RESOLV 単室ナノリポソーム、高圧ホモジナイザー法、および超音波プローブ分散製剤。",
    principlesTitle: "熱力学および超臨界急速膨張物理メカニズム",
    principlesSub: "支配方程式：等エントロピー臨界チョーク膨張流速、リン脂質臨界パッキングパラメータ、二重層曲率弾性エネルギー、および Noyes-Whitney 溶解キネティクス。",
    compTitle: "工業用ナノリポソーム製造技術総合比較",
    compSub: "RESOLV 技術と高圧ホモジナイザー、超音波プローブ破砕、および薄膜水化/エタノール注入法との直接比較。",
    regTitle: "規制遵守およびサニタリーエンジニアリング基準",
    regSub: "FDA 21 CFR § 117 FSMA cGMP、USP <729> 脂質エマルジョン粒子径分布基準、USP <711> 溶出、3-A サニタリー基準 63-04/08-17、EHEDG Type EL Class I、および ASME Section VIII Div 1 に完全適合。"
  }
};

const d = DICT[lang] || DICT.en;
const formulations = resolvData.bioactivePayloadFormulations;
const comparisons = resolvData.industrialTechnologyComparison;
---

<div class="resolv-modeler bg-surface border border-hairline rounded-3xl p-6 sm:p-8 md:p-10 shadow-sm transition-all" data-lang={lang}>
  <!-- Header -->
  <div class="mb-8 border-b border-hairline/80 pb-6">
    <div class="flex flex-wrap items-center gap-2 mb-3">
      <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-950 text-emerald-300 border border-emerald-800">
        {d.badge}
      </span>
      <span class="text-xs text-muted font-mono">RESOLV • scCO2 Supersonic • d &lt; 85 nm • EE &gt; 94.5% • USP &lt;729&gt;/&lt;711&gt;</span>
    </div>
    <h2 class="text-2xl sm:text-3xl font-extrabold text-ink tracking-tight mb-2">
      {d.title}
    </h2>
    <p class="text-body text-sm sm:text-base leading-relaxed text-muted max-w-4xl">
      {d.subtitle}
    </p>
  </div>

  <!-- Presets -->
  <div class="mb-8 bg-surface-soft p-4 rounded-2xl border border-hairline">
    <div class="text-xs font-bold uppercase text-muted tracking-wider mb-3">
      {d.presetsTitle}
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-2">
      <button type="button" class="preset-btn px-3 py-2 rounded-xl text-xs font-medium bg-surface text-ink border border-hairline hover:border-emerald-600 hover:text-emerald-500 transition-all text-center" data-preset="astaxanthin">
        {d.presetAstaxanthin}
      </button>
      <button type="button" class="preset-btn px-3 py-2 rounded-xl text-xs font-medium bg-surface text-ink border border-hairline hover:border-emerald-600 hover:text-emerald-500 transition-all text-center" data-preset="coq10">
        {d.presetCoq10}
      </button>
      <button type="button" class="preset-btn px-3 py-2 rounded-xl text-xs font-medium bg-surface text-ink border border-hairline hover:border-emerald-600 hover:text-emerald-500 transition-all text-center" data-preset="curcumin">
        {d.presetCurcumin}
      </button>
      <button type="button" class="preset-btn px-3 py-2 rounded-xl text-xs font-medium bg-surface text-ink border border-hairline hover:border-emerald-600 hover:text-emerald-500 transition-all text-center" data-preset="cbd">
        {d.presetCbd}
      </button>
      <button type="button" class="preset-btn px-3 py-2 rounded-xl text-xs font-medium bg-surface text-rose-400 border border-hairline hover:border-rose-500 transition-all text-center" data-preset="hazard">
        {d.presetHazard}
      </button>
    </div>
  </div>

  <!-- Controls Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-10">
    <div class="lg:col-span-6 space-y-6">
      <div class="border-b border-hairline pb-2">
        <h3 class="text-lg font-bold text-ink">{d.controlsTitle}</h3>
        <p class="text-xs text-muted leading-relaxed">{d.controlsSub}</p>
      </div>

      <!-- Formulation Selector -->
      <div>
        <label for="resolv-payload-select" class="block text-xs font-bold text-ink uppercase tracking-wider mb-1">
          {d.payloadLabel}
        </label>
        <select id="resolv-payload-select" class="w-full bg-surface-soft border border-hairline rounded-xl px-3 py-2.5 text-xs text-ink focus:outline-none focus:border-emerald-500">
          {formulations.map(f => (
            <option value={f.id}>{f.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1" id="resolv-payload-desc">{formulations[0].payloadDescription}</p>
      </div>

      <!-- Pressure -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <label for="resolv-pressure-slider" class="text-xs font-semibold text-ink">{d.pressureLabel}</label>
          <span id="resolv-pressure-val" class="font-mono text-xs font-bold text-emerald-400">260 bar</span>
        </div>
        <input id="resolv-pressure-slider" type="range" min="150" max="350" step="5" value="260" class="w-full accent-emerald-500 cursor-pointer" />
        <p class="text-[11px] text-muted mt-0.5">{d.pressureHelp}</p>
      </div>

      <!-- Temperature -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <label for="resolv-temp-slider" class="text-xs font-semibold text-ink">{d.tempLabel}</label>
          <span id="resolv-temp-val" class="font-mono text-xs font-bold text-emerald-400">42.0 °C</span>
        </div>
        <input id="resolv-temp-slider" type="range" min="32.0" max="55.0" step="0.5" value="42.0" class="w-full accent-emerald-500 cursor-pointer" />
        <p class="text-[11px] text-muted mt-0.5">{d.tempHelp}</p>
      </div>

      <!-- Orifice Diameter -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <label for="resolv-orifice-slider" class="text-xs font-semibold text-ink">{d.orificeLabel}</label>
          <span id="resolv-orifice-val" class="font-mono text-xs font-bold text-emerald-400">65 µm</span>
        </div>
        <input id="resolv-orifice-slider" type="range" min="40" max="140" step="5" value="65" class="w-full accent-emerald-500 cursor-pointer" />
        <p class="text-[11px] text-muted mt-0.5">{d.orificeHelp}</p>
      </div>

      <!-- Ethanol Modifier -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <label for="resolv-modifier-slider" class="text-xs font-semibold text-ink">{d.modifierLabel}</label>
          <span id="resolv-modifier-val" class="font-mono text-xs font-bold text-emerald-400">3.5 %</span>
        </div>
        <input id="resolv-modifier-slider" type="range" min="1.0" max="10.0" step="0.5" value="3.5" class="w-full accent-emerald-500 cursor-pointer" />
        <p class="text-[11px] text-muted mt-0.5">{d.modifierHelp}</p>
      </div>

      <!-- Aqueous Receiver Flow -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <label for="resolv-flow-slider" class="text-xs font-semibold text-ink">{d.flowLabel}</label>
          <span id="resolv-flow-val" class="font-mono text-xs font-bold text-emerald-400">85 mL/min</span>
        </div>
        <input id="resolv-flow-slider" type="range" min="30" max="180" step="5" value="85" class="w-full accent-emerald-500 cursor-pointer" />
        <p class="text-[11px] text-muted mt-0.5">{d.flowHelp}</p>
      </div>
    </div>

    <!-- Telemetry Cards -->
    <div class="lg:col-span-6 space-y-6">
      <div class="border-b border-hairline pb-2">
        <h3 class="text-lg font-bold text-ink">{d.telemetryTitle}</h3>
        <p class="text-xs text-muted leading-relaxed">{d.telemetrySub}</p>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <!-- Mach Number -->
        <div class="bg-surface-soft p-3.5 rounded-2xl border border-hairline">
          <div class="text-[11px] font-semibold text-muted uppercase tracking-wider">{d.machLabel}</div>
          <div id="telemetry-mach" class="text-xl font-black font-mono text-emerald-400 mt-1">M = 2.42</div>
          <div class="text-[10px] text-muted mt-0.5">v_jet ≈ 1,415 m/s (Choked)</div>
        </div>

        <!-- Decompression Duration -->
        <div class="bg-surface-soft p-3.5 rounded-2xl border border-hairline">
          <div class="text-[11px] font-semibold text-muted uppercase tracking-wider">{d.decompTimeLabel}</div>
          <div id="telemetry-decomp" class="text-xl font-black font-mono text-emerald-400 mt-1">0.46 µs</div>
          <div class="text-[10px] text-muted mt-0.5">&lt; 0.8 µs (Explosive Phase)</div>
        </div>

        <!-- Mean Vesicle Diameter -->
        <div class="bg-surface-soft p-3.5 rounded-2xl border border-hairline">
          <div class="text-[11px] font-semibold text-muted uppercase tracking-wider">{d.vesicleDiameterLabel}</div>
          <div id="telemetry-diameter" class="text-xl font-black font-mono text-emerald-400 mt-1">65.0 nm</div>
          <div class="text-[10px] text-muted mt-0.5">Unilamellar (Target &lt;85 nm)</div>
        </div>

        <!-- PDI -->
        <div class="bg-surface-soft p-3.5 rounded-2xl border border-hairline">
          <div class="text-[11px] font-semibold text-muted uppercase tracking-wider">{d.pdiLabel}</div>
          <div id="telemetry-pdi" class="text-xl font-black font-mono text-emerald-400 mt-1">0.038</div>
          <div class="text-[10px] text-muted mt-0.5">Monodisperse (&lt; 0.045)</div>
        </div>

        <!-- Entrapment Efficiency -->
        <div class="bg-surface-soft p-3.5 rounded-2xl border border-hairline">
          <div class="text-[11px] font-semibold text-muted uppercase tracking-wider">{d.entrapmentLabel}</div>
          <div id="telemetry-entrapment" class="text-xl font-black font-mono text-emerald-400 mt-1">98.4 %</div>
          <div class="text-[10px] text-muted mt-0.5">In-Situ Core Enclosure</div>
        </div>

        <!-- Physical Stability Half-Life -->
        <div class="bg-surface-soft p-3.5 rounded-2xl border border-hairline">
          <div class="text-[11px] font-semibold text-muted uppercase tracking-wider">{d.stabilityLabel}</div>
          <div id="telemetry-stability" class="text-xl font-black font-mono text-emerald-400 mt-1">365 Days</div>
          <div class="text-[10px] text-muted mt-0.5">4°C Storage (&gt;12 Months)</div>
        </div>

        <!-- Residual Solvent -->
        <div class="bg-surface-soft p-3.5 rounded-2xl border border-hairline">
          <div class="text-[11px] font-semibold text-muted uppercase tracking-wider">{d.residualSolventLabel}</div>
          <div id="telemetry-solvent" class="text-xl font-black font-mono text-emerald-400 mt-1">&lt; 0.5 ppm</div>
          <div class="text-[10px] text-muted mt-0.5">USP &lt;467&gt; Limit = 5,000 ppm</div>
        </div>

        <!-- Chemical Integrity -->
        <div class="bg-surface-soft p-3.5 rounded-2xl border border-hairline">
          <div class="text-[11px] font-semibold text-muted uppercase tracking-wider">{d.integrityLabel}</div>
          <div id="telemetry-integrity" class="text-xl font-black font-mono text-emerald-400 mt-1">100.0 %</div>
          <div class="text-[10px] text-muted mt-0.5">0.0% Thermal / Shear Loss</div>
        </div>
      </div>

      <!-- Specific Energy Consumption & Status Banner -->
      <div class="bg-surface-soft p-4 rounded-2xl border border-hairline space-y-2">
        <div class="flex justify-between items-center text-xs">
          <span class="text-muted font-medium">{d.secLabel}</span>
          <span id="telemetry-sec" class="font-mono font-bold text-ink">0.42 kWh/kg (>88% Energy Savings vs Spray Drying)</span>
        </div>
        <div class="border-t border-hairline/60 pt-2">
          <div class="text-[11px] font-semibold text-muted uppercase tracking-wider mb-1">{d.verdictLabel}</div>
          <div id="telemetry-verdict" class="text-xs font-bold text-emerald-400 flex items-center gap-1.5">
            <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            OPTIMAL RESOLV NANO-LIPOSOME REGIME: High-Yield Unilamellar Vesicles (USP &lt;729&gt; &amp; &lt;711&gt; cGMP Certified)
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- SVG Diagram: Skid & Supersonic Expansion Chamber -->
  <div class="mb-10 bg-surface-soft p-6 rounded-3xl border border-hairline">
    <div class="mb-4">
      <h3 class="text-base font-bold text-ink">{d.diagramTitle}</h3>
      <p class="text-xs text-muted">{d.diagramSub}</p>
    </div>
    <div class="w-full overflow-x-auto">
      <svg class="w-full min-w-[700px] h-[320px]" viewBox="0 0 850 320" fill="none" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="scCo2FlowGrad" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#059669" stop-opacity="0.8"/>
            <stop offset="100%" stop-color="#10b981" stop-opacity="0.9"/>
          </linearGradient>
          <linearGradient id="supersonicJetGrad" x1="0%" y1="50%" x2="100%" y2="50%">
            <stop offset="0%" stop-color="#34d399" stop-opacity="1"/>
            <stop offset="40%" stop-color="#60a5fa" stop-opacity="0.9"/>
            <stop offset="100%" stop-color="#38bdf8" stop-opacity="0.4"/>
          </linearGradient>
          <linearGradient id="aqueousReceiverGrad" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#0284c7" stop-opacity="0.2"/>
            <stop offset="100%" stop-color="#0369a1" stop-opacity="0.5"/>
          </linearGradient>
        </defs>

        <!-- Background grid -->
        <rect width="850" height="320" fill="#090d16" rx="16"/>
        <g stroke="#1e293b" stroke-width="0.5">
          <line x1="50" y1="0" x2="50" y2="320"/>
          <line x1="200" y1="0" x2="200" y2="320"/>
          <line x1="400" y1="0" x2="400" y2="320"/>
          <line x1="600" y1="0" x2="600" y2="320"/>
          <line x1="750" y1="0" x2="750" y2="320"/>
          <line x1="0" y1="80" x2="850" y2="80"/>
          <line x1="0" y1="160" x2="850" y2="160"/>
          <line x1="0" y1="240" x2="850" y2="240"/>
        </g>

        <!-- Unit 1: Pre-Expansion High-Pressure Saturator -->
        <rect x="40" y="50" width="150" height="220" rx="12" fill="#111827" stroke="#374151" stroke-width="2"/>
        <rect x="50" y="70" width="130" height="180" rx="8" fill="url(#scCo2FlowGrad)"/>
        <text x="115" y="40" fill="#e5e7eb" font-size="12" font-weight="bold" text-anchor="middle">Pre-Expansion Saturator</text>
        <text x="115" y="105" fill="#ffffff" font-size="11" font-weight="bold" text-anchor="middle">Supercritical CO2</text>
        <text x="115" y="125" fill="#e5e7eb" font-size="10" text-anchor="middle">+ Phospholipids</text>
        <text x="115" y="145" fill="#e5e7eb" font-size="10" text-anchor="middle">+ Bioactive Active</text>
        <text x="115" y="175" fill="#fef08a" font-size="11" font-family="monospace" text-anchor="middle">P = 180–320 bar</text>
        <text x="115" y="195" fill="#fef08a" font-size="11" font-family="monospace" text-anchor="middle">T = 38–45 °C</text>

        <!-- High-Pressure Feed Pipe to Sapphire Nozzle -->
        <path d="M 190 160 L 290 160" stroke="#10b981" stroke-width="8" stroke-linecap="round"/>
        <polygon points="265,153 285,160 265,167" fill="#34d399"/>
        <text x="240" y="145" fill="#34d399" font-size="10" font-family="monospace" text-anchor="middle">scCO2 Solution</text>

        <!-- Unit 2: Sapphire Nozzle & Submerged Expansion Receiver -->
        <rect x="290" y="30" width="310" height="260" rx="16" fill="#0c172a" stroke="#0284c7" stroke-width="2"/>
        <text x="445" y="24" fill="#38bdf8" font-size="12" font-weight="bold" text-anchor="middle">Submerged Supersonic Expansion Chamber</text>

        <!-- Aqueous Liquid Fill -->
        <rect x="300" y="70" width="290" height="210" rx="10" fill="url(#aqueousReceiverGrad)"/>
        <text x="445" y="90" fill="#bae6fd" font-size="11" font-weight="semibold" text-anchor="middle">Aqueous Receiving Stabilizer Phase (Ambient, 22°C)</text>

        <!-- Sapphire Nozzle Assembly -->
        <rect x="290" y="145" width="40" height="30" rx="4" fill="#1e293b" stroke="#94a3b8" stroke-width="1.5"/>
        <polygon points="330,148 350,157 350,163 330,172" fill="#ef4444" stroke="#f87171" stroke-width="1.5"/>
        <circle cx="350" cy="160" r="3" fill="#ffffff"/>
        <text x="325" y="135" fill="#f87171" font-size="10" font-weight="bold" text-anchor="middle">Sapphire Nozzle</text>
        <text x="325" y="195" fill="#fca5a5" font-size="9" font-family="monospace" text-anchor="middle">d = 50–120 µm</text>

        <!-- Supersonic Jet Plume with Shock Diamonds -->
        <path d="M 350 160 Q 420 135 520 120 L 520 200 Q 420 185 350 160 Z" fill="url(#supersonicJetGrad)"/>
        <!-- Shock diamond diamonds -->
        <polygon points="370,160 380,154 390,160 380,166" fill="#ffffff" opacity="0.9"/>
        <polygon points="405,160 417,152 429,160 417,168" fill="#ffffff" opacity="0.8"/>
        <polygon points="445,160 460,150 475,160 460,170" fill="#ffffff" opacity="0.7"/>
        <text x="430" y="140" fill="#ffffff" font-size="9" font-weight="bold" text-anchor="middle">Mach 2.4 Shock Diamond Plume</text>

        <!-- Formed Nano-Liposomes floating in receiving phase -->
        <g stroke="#34d399" stroke-width="1.5" fill="#047857">
          <circle cx="490" cy="150" r="6"/>
          <circle cx="490" cy="150" r="2.5" fill="#10b981"/>
          <circle cx="530" cy="130" r="7"/>
          <circle cx="530" cy="130" r="3" fill="#10b981"/>
          <circle cx="545" cy="175" r="5.5"/>
          <circle cx="545" cy="175" r="2" fill="#10b981"/>
          <circle cx="510" cy="220" r="6"/>
          <circle cx="510" cy="220" r="2.5" fill="#10b981"/>
          <circle cx="560" cy="240" r="6.5"/>
          <circle cx="560" cy="240" r="3" fill="#10b981"/>
          <circle cx="450" cy="250" r="5"/>
          <circle cx="450" cy="250" r="2" fill="#10b981"/>
        </g>
        <text x="520" y="110" fill="#6ee7b7" font-size="10" font-weight="bold" text-anchor="middle">Self-Assembled Nano-Liposomes</text>
        <text x="520" y="270" fill="#a7f3d0" font-size="9" font-family="monospace" text-anchor="middle">d_50 = 50–85 nm (PDI &lt; 0.045)</text>

        <!-- Slurry Output Pipe to Cyclone Degasser -->
        <path d="M 600 160 L 670 160" stroke="#0284c7" stroke-width="6" stroke-linecap="round"/>
        <polygon points="650,154 668,160 650,166" fill="#38bdf8"/>
        <text x="635" y="148" fill="#38bdf8" font-size="9" font-family="monospace" text-anchor="middle">Liposome Slurry</text>

        <!-- Unit 3: Cyclone Gas-Liquid Degasser -->
        <path d="M 670 90 L 770 90 L 770 180 L 720 250 L 720 270 L 670 180 Z" fill="#1e293b" stroke="#475569" stroke-width="2"/>
        <text x="720" y="75" fill="#e5e7eb" font-size="11" font-weight="bold" text-anchor="middle">Cyclone Degasser</text>

        <!-- Top Gas Exhaust to Recirculation Loop -->
        <path d="M 720 90 L 720 40 L 115 40 L 115 50" stroke="#10b981" stroke-width="3" stroke-dasharray="6 4" fill="none"/>
        <polygon points="120,48 115,56 110,48" fill="#10b981"/>
        <text x="420" y="36" fill="#34d399" font-size="9" font-family="monospace" text-anchor="middle">Closed-Loop CO2 Re-Compression (99.8% Recovery)</text>

        <!-- Bottom Product Discharge -->
        <path d="M 720 270 L 720 305" stroke="#38bdf8" stroke-width="6" stroke-linecap="round"/>
