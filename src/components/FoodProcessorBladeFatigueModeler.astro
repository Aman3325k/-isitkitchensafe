const d = DICTIONARY[lang] || DICTIONARY.en;
---

<div class="not-prose bg-surface-soft border border-hairline rounded-3xl p-6 md:p-10 shadow-xs mb-12" id="fp-modeler-app">
  <!-- Header Badge -->
  <div class="flex flex-wrap items-center justify-between gap-3 mb-6 border-b border-hairline/60 pb-5">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-amber-500/10 text-amber-950 border border-amber-500/20">
      <span>⚙️</span>
      {d.badge}
    </div>
    <span class="text-xs font-mono text-muted tracking-wide">ISO 6892-1 &bull; ASTM D638 &bull; 1,000g Centrifugal Dynamics</span>
  </div>

  <!-- Title & Subtitle -->
  <h2 class="text-2xl md:text-3xl font-extrabold text-ink tracking-tight mb-3">
    {d.title}
  </h2>
  <p class="text-sm md:text-base text-muted leading-relaxed mb-8 max-w-4xl">
    {d.subtitle}
  </p>

  <!-- High-Risk Household Presets -->
  <div class="mb-8 p-5 bg-canvas/80 border border-hairline rounded-2xl">
    <div class="text-xs font-bold uppercase tracking-wider text-ink mb-3 flex items-center gap-2">
      <span>⚡</span>
      {d.presetsTitle}
    </div>
    <div class="flex flex-wrap gap-2 text-xs">
      <button 
        type="button" 
        class="preset-btn px-3 py-2 rounded-xl bg-surface-soft hover:bg-rose-500/10 hover:text-rose-950 hover:border-rose-400 border border-hairline font-medium text-ink transition-all text-left"
        data-preset="ice-hazard"
      >
        ⚠️ {d.presetIceHazard}
      </button>
      <button 
        type="button" 
        class="preset-btn px-3 py-2 rounded-xl bg-surface-soft hover:bg-amber-500/10 hover:text-amber-950 hover:border-amber-400 border border-hairline font-medium text-ink transition-all text-left"
        data-preset="dough-torsion"
      >
        🍞 {d.presetDoughTorsion}
      </button>
      <button 
        type="button" 
        class="preset-btn px-3 py-2 rounded-xl bg-surface-soft hover:bg-emerald-500/10 hover:text-emerald-950 hover:border-emerald-400 border border-hairline font-medium text-ink transition-all text-left"
        data-preset="mirepoix-safe"
      >
        🥕 {d.presetMirepoixSafe}
      </button>
      <button 
        type="button" 
        class="preset-btn px-3 py-2 rounded-xl bg-surface-soft hover:bg-red-500/10 hover:text-red-950 hover:border-red-400 border border-hairline font-medium text-ink transition-all text-left"
        data-preset="pit-collision"
      >
        💥 {d.presetPitCollision}
      </button>
      <button 
        type="button" 
        class="preset-btn px-3 py-2 rounded-xl bg-surface-soft hover:bg-teal-500/10 hover:text-teal-950 hover:border-teal-400 border border-hairline font-medium text-ink transition-all text-left"
        data-preset="tritan-longlife"
      >
        🛡️ {d.presetTritanLongLife}
      </button>
    </div>
  </div>

  <!-- Interactive Controls Grid -->
  <div class="bg-canvas border border-hairline rounded-2xl p-6 md:p-8 mb-8 shadow-xs">
    <div class="mb-6">
      <h3 class="text-base md:text-lg font-bold text-ink mb-1 flex items-center gap-2">
        <span>🎛️</span>
        {d.controlsTitle}
      </h3>
      <p class="text-xs md:text-sm text-muted">{d.controlsSub}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- 1. Work Bowl Material -->
      <div>
        <label for="fp-bowl-material" class="block text-xs font-bold uppercase tracking-wider text-ink mb-2">
          {d.bowlLabel}
        </label>
        <select id="fp-bowl-material" class="w-full bg-surface-soft border border-hairline rounded-xl px-3 py-2.5 text-xs text-ink focus:outline-hidden focus:ring-2 focus:ring-amber-500">
          {modelData.bowlMaterials.map((mat) => (
            <option value={mat.id}>{mat.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1.5 leading-snug">{d.bowlHelp}</p>
      </div>

      <!-- 2. Blade Metallurgy -->
      <div>
        <label for="fp-blade-alloy" class="block text-xs font-bold uppercase tracking-wider text-ink mb-2">
          {d.bladeLabel}
        </label>
        <select id="fp-blade-alloy" class="w-full bg-surface-soft border border-hairline rounded-xl px-3 py-2.5 text-xs text-ink focus:outline-hidden focus:ring-2 focus:ring-amber-500">
          {modelData.bladeMetallurgies.map((b) => (
            <option value={b.id}>{b.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1.5 leading-snug">{d.bladeHelp}</p>
      </div>

      <!-- 3. Food Resistance & Shock Matrix -->
      <div>
        <label for="fp-food-matrix" class="block text-xs font-bold uppercase tracking-wider text-ink mb-2">
          {d.foodLabel}
        </label>
        <select id="fp-food-matrix" class="w-full bg-surface-soft border border-hairline rounded-xl px-3 py-2.5 text-xs text-ink focus:outline-hidden focus:ring-2 focus:ring-amber-500">
          {modelData.foodMatrices.map((f) => (
            <option value={f.id}>{f.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1.5 leading-snug">{d.foodHelp}</p>
      </div>

      <!-- 4. Dishwasher Aging -->
      <div>
        <label for="fp-dishwasher-aging" class="block text-xs font-bold uppercase tracking-wider text-ink mb-2">
          {d.dishwasherLabel}
        </label>
        <select id="fp-dishwasher-aging" class="w-full bg-surface-soft border border-hairline rounded-xl px-3 py-2.5 text-xs text-ink focus:outline-hidden focus:ring-2 focus:ring-amber-500">
          {modelData.dishwasherAging.map((dw) => (
            <option value={dw.id}>{dw.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1.5 leading-snug">{d.dishwasherHelp}</p>
      </div>

      <!-- 5. Motor RPM & Speed -->
      <div>
        <label for="fp-motor-speed" class="block text-xs font-bold uppercase tracking-wider text-ink mb-2">
          {d.speedLabel}
        </label>
        <select id="fp-motor-speed" class="w-full bg-surface-soft border border-hairline rounded-xl px-3 py-2.5 text-xs text-ink focus:outline-hidden focus:ring-2 focus:ring-amber-500">
          {modelData.motorSpeeds.map((s) => (
            <option value={s.id}>{s.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1.5 leading-snug">{d.speedHelp}</p>
      </div>

      <!-- 6. Blade Fatigue Service History -->
      <div>
        <label for="fp-blade-history" class="block text-xs font-bold uppercase tracking-wider text-ink mb-2">
          {d.historyLabel}
        </label>
        <select id="fp-blade-history" class="w-full bg-surface-soft border border-hairline rounded-xl px-3 py-2.5 text-xs text-ink focus:outline-hidden focus:ring-2 focus:ring-amber-500">
          {modelData.bladeFatigueHistory.map((h) => (
            <option value={h.id}>{h.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1.5 leading-snug">{d.historyHelp}</p>
      </div>
    </div>
  </div>

  <!-- Real-Time Diagnostic Scorecard -->
  <div class="bg-canvas border border-hairline rounded-2xl p-6 md:p-8 mb-8 shadow-xs">
    <div class="flex flex-wrap items-center justify-between gap-3 mb-6 pb-4 border-b border-hairline">
      <div>
        <h3 class="text-lg md:text-xl font-bold text-ink flex items-center gap-2">
          <span>📊</span>
          {d.diagnosticTitle}
        </h3>
        <p class="text-xs text-muted">{d.diagnosticSub}</p>
      </div>
      <button 
        type="button" 
        id="fp-copy-report-btn"
        class="inline-flex items-center gap-2 px-3 py-2 rounded-xl bg-surface-soft hover:bg-surface border border-hairline text-xs font-medium text-ink transition-colors cursor-pointer"
      >
        <span>{d.copyReportBtn}</span>
      </button>
    </div>

    <!-- Metrics Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-6">
      <!-- 1. Fatigue Safety Factor -->
      <div class="bg-surface-soft border border-hairline rounded-xl p-4">
        <div class="text-[11px] font-bold uppercase tracking-wider text-muted mb-1">{d.safetyFactorLabel}</div>
        <div class="flex items-baseline gap-2">
          <span id="metric-safety-factor" class="text-2xl md:text-3xl font-black text-ink">3.45</span>
          <span id="metric-safety-tag" class="text-xs font-bold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-900">SAFE</span>
        </div>
        <div class="w-full bg-hairline/60 rounded-full h-1.5 mt-3 overflow-hidden">
          <div id="meter-safety-factor" class="bg-emerald-700 h-1.5 rounded-full transition-all duration-300" style="width: 85%;"></div>
        </div>
      </div>

      <!-- 2. Bowl Shatter Risk -->
      <div class="bg-surface-soft border border-hairline rounded-xl p-4">
        <div class="text-[11px] font-bold uppercase tracking-wider text-muted mb-1">{d.shatterRiskLabel}</div>
        <div class="flex items-baseline gap-2">
          <span id="metric-shatter-risk" class="text-2xl md:text-3xl font-black text-ink">4%</span>
          <span id="metric-shatter-tag" class="text-xs font-bold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-900">LOW</span>
        </div>
        <div class="w-full bg-hairline/60 rounded-full h-1.5 mt-3 overflow-hidden">
          <div id="meter-shatter-risk" class="bg-emerald-700 h-1.5 rounded-full transition-all duration-300" style="width: 4%;"></div>
        </div>
      </div>

      <!-- 3. Tip Speed & Velocity -->
      <div class="bg-surface-soft border border-hairline rounded-xl p-4">
        <div class="text-[11px] font-bold uppercase tracking-wider text-muted mb-1">{d.tipSpeedLabel}</div>
        <div class="flex items-baseline gap-2">
          <span id="metric-tip-speed" class="text-2xl md:text-3xl font-black text-ink">15.6 m/s</span>
          <span id="metric-tip-mph" class="text-xs font-mono text-muted">(34.9 mph)</span>
        </div>
        <div class="text-[11px] text-muted mt-2" id="metric-tip-energy">Kinetic Energy: 4.8 J/blade</div>
      </div>

      <!-- 4. Centrifugal g-Force -->
      <div class="bg-surface-soft border border-hairline rounded-xl p-4">
        <div class="text-[11px] font-bold uppercase tracking-wider text-muted mb-1">{d.centrifugalGLabel}</div>
        <div class="flex items-baseline gap-2">
          <span id="metric-g-force" class="text-2xl md:text-3xl font-black text-ink">292 g</span>
          <span class="text-xs font-mono text-muted">vs 1g Earth</span>
        </div>
        <div class="text-[11px] text-muted mt-2" id="metric-centrifugal-force">Centrifugal Outward Force: 14.6 N</div>
      </div>

      <!-- 5. Metal Micro-Chipping -->
      <div class="bg-surface-soft border border-hairline rounded-xl p-4">
        <div class="text-[11px] font-bold uppercase tracking-wider text-muted mb-1">{d.microChippingLabel}</div>
        <div class="flex items-baseline gap-2">
          <span id="metric-chipping" class="text-lg md:text-xl font-bold text-emerald-900">NEGLIGIBLE</span>
        </div>
        <div class="text-[11px] text-muted mt-2" id="metric-chipping-sub">Edge stress below martensitic yield</div>
      </div>

      <!-- 6. Hub Spline Fatigue -->
      <div class="bg-surface-soft border border-hairline rounded-xl p-4">
        <div class="text-[11px] font-bold uppercase tracking-wider text-muted mb-1">{d.hubFatigueLabel}</div>
        <div class="flex items-baseline gap-2">
          <span id="metric-hub-creep" class="text-lg md:text-xl font-bold text-ink">STABLE</span>
        </div>
        <div class="text-[11px] text-muted mt-2" id="metric-hub-sub">Shaft temp &lt; 50°C; zero spline slip</div>
      </div>
    </div>

    <!-- Failure Mode & Action Protocol Callout -->
    <div id="callout-box" class="border border-emerald-300 bg-emerald-50/50 rounded-xl p-5 mb-2 transition-colors">
      <div class="flex items-start gap-3">
        <span id="callout-icon" class="text-2xl mt-0.5">✅</span>
        <div class="space-y-2 text-xs md:text-sm">
          <div>
            <span class="font-bold text-ink uppercase tracking-wide">{d.failureModeLabel}:</span>
            <span id="callout-failure-mode" class="text-ink ml-1 font-medium">None. Operational stresses are well below the material endurance limit.</span>
          </div>
          <div>
            <span class="font-bold text-ink uppercase tracking-wide">{d.actionProtocolLabel}:</span>
            <span id="callout-action-protocol" class="text-muted ml-1 leading-relaxed">Appliance is operating inside certified design limits. Hand wash work bowl and inspect S-blade every 6 months under magnification.</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Engineering Comparison Table -->
  <div class="bg-canvas border border-hairline rounded-2xl p-6 md:p-8 mb-8 shadow-xs">
    <div class="mb-5">
      <h3 class="text-base md:text-lg font-bold text-ink mb-1 flex items-center gap-2">
        <span>🔬</span>
        {d.tableTitle}
      </h3>
      <p class="text-xs text-muted">{d.tableSub}</p>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-xs">
        <thead>
          <tr class="border-b border-hairline text-muted uppercase tracking-wider text-[11px]">
            <th class="py-2.5 px-3 font-bold">{d.colMaterial}</th>
            <th class="py-2.5 px-3 font-bold">{d.colTensile}</th>
            <th class="py-2.5 px-3 font-bold">{d.colIzod}</th>
            <th class="py-2.5 px-3 font-bold">{d.colCrazing}</th>
            <th class="py-2.5 px-3 font-bold">{d.colDishwasher}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline/60">
          {modelData.bowlMaterials.map((mat) => (
            <tr class="hover:bg-surface-soft/60 transition-colors">
              <td class="py-3 px-3 font-medium text-ink">{mat.name}</td>
              <td class="py-3 px-3 font-mono text-muted">{mat.tensileStrengthMPa} MPa</td>
              <td class="py-3 px-3 font-mono text-muted">{mat.notchedIzodJ_m} J/m</td>
              <td class="py-3 px-3 text-muted">{mat.crazingSensitivity}</td>
              <td class="py-3 px-3 font-bold">
                {mat.dishwasherSafe ? (
                  <span class="text-emerald-900 bg-emerald-100 px-2 py-0.5 rounded-full text-[10px]">YES (Safe)</span>
                ) : (
                  <span class="text-rose-950 bg-rose-100 px-2 py-0.5 rounded-full text-[10px]">NO (Hand Wash Only)</span>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- 4 Critical Kitchen Warewashing & Operating Rules -->
  <div class="bg-canvas border border-hairline rounded-2xl p-6 md:p-8 shadow-xs">
    <div class="mb-6">
      <h3 class="text-base md:text-lg font-bold text-ink mb-1 flex items-center gap-2">
        <span>🛡️</span>
        {d.rulesTitle}
      </h3>
      <p class="text-xs text-muted">{d.rulesSub}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 text-xs">
      <div class="bg-surface-soft border border-hairline rounded-xl p-5">
        <div class="font-bold text-ink mb-2 text-sm flex items-center gap-2">
          <span>🚫</span>
          {d.rule1Title}
        </div>
        <p class="text-muted leading-relaxed">{d.rule1Text}</p>
      </div>

      <div class="bg-surface-soft border border-hairline rounded-xl p-5">
        <div class="font-bold text-ink mb-2 text-sm flex items-center gap-2">
          <span>🧊</span>
          {d.rule2Title}
        </div>
        <p class="text-muted leading-relaxed">{d.rule2Text}</p>
      </div>

      <div class="bg-surface-soft border border-hairline rounded-xl p-5">
        <div class="font-bold text-ink mb-2 text-sm flex items-center gap-2">
          <span>⏱️</span>
          {d.rule3Title}
        </div>
        <p class="text-muted leading-relaxed">{d.rule3Text}</p>
      </div>

      <div class="bg-surface-soft border border-hairline rounded-xl p-5">
        <div class="font-bold text-ink mb-2 text-sm flex items-center gap-2">
          <span>🔍</span>
          {d.rule4Title}
        </div>
        <p class="text-muted leading-relaxed">{d.rule4Text}</p>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ modelData, copiedFeedback: d.copiedFeedback }}>
  document.addEventListener('DOMContentLoaded', () => {
    const bowlSelect = document.getElementById('fp-bowl-material');
    const bladeSelect = document.getElementById('fp-blade-alloy');
    const foodSelect = document.getElementById('fp-food-matrix');
    const dwSelect = document.getElementById('fp-dishwasher-aging');
    const speedSelect = document.getElementById('fp-motor-speed');
    const historySelect = document.getElementById('fp-blade-history');
    const copyBtn = document.getElementById('fp-copy-report-btn');

    if (!bowlSelect || !bladeSelect || !foodSelect || !dwSelect || !speedSelect || !historySelect) return;

    // Presets Handlers
    const presets = {
      'ice-hazard': {
        bowl: 'bpa-polycarbonate',
        blade: 'martensitic-420',
        food: 'frozen-ice',
        dw: 'severe-cycles',
        speed: 'turbo-high',
        history: 'heavily-fatigued'
      },
      'dough-torsion': {
        bowl: 'tritan-copolyester',
        blade: 'nylon-overmold-hub',
        food: 'heavy-dough',
        dw: 'moderate-cycles',
        speed: 'standard-continuous',
        history: 'moderate-service'
      },
      'mirepoix-safe': {
        bowl: 'tritan-copolyester',
        blade: 'martensitic-420',
        food: 'fibrous-vegetables',
        dw: 'hand-wash-only',
        speed: 'standard-continuous',
        history: 'brand-new'
      },
      'pit-collision': {
        bowl: 'bpa-polycarbonate',
        blade: 'martensitic-420',
        food: 'foreign-metal-pit',
        dw: 'moderate-cycles',
        speed: 'turbo-high',
        history: 'moderate-service'
      },
      'tritan-longlife': {
        bowl: 'tritan-copolyester',
        blade: 'tin-coated-440c',
        food: 'fibrous-vegetables',
        dw: 'hand-wash-only',
        speed: 'standard-continuous',
        history: 'brand-new'
      }
    };

    document.querySelectorAll('.preset-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const key = btn.getAttribute('data-preset');
        const p = presets[key];
        if (p) {
          bowlSelect.value = p.bowl;
          bladeSelect.value = p.blade;
          foodSelect.value = p.food;
          dwSelect.value = p.dw;
          speedSelect.value = p.speed;
          historySelect.value = p.history;
          recalculate();
        }
      });
    });

    function recalculate() {
      const bowl = modelData.bowlMaterials.find(m => m.id === bowlSelect.value) || modelData.bowlMaterials[0];
      const blade = modelData.bladeMetallurgies.find(b => b.id === bladeSelect.value) || modelData.bladeMetallurgies[0];
      const food = modelData.foodMatrices.find(f => f.id === foodSelect.value) || modelData.foodMatrices[0];
      const dw = modelData.dishwasherAging.find(d => d.id === dwSelect.value) || modelData.dishwasherAging[0];
      const speed = modelData.motorSpeeds.find(s => s.id === speedSelect.value) || modelData.motorSpeeds[0];
      const history = modelData.bladeFatigueHistory.find(h => h.id === historySelect.value) || modelData.bladeFatigueHistory[0];

      // Physical calculations
      const tipSpeed = speed.tipSpeedMs; // m/s
      const tipMph = (tipSpeed * 2.23694).toFixed(1);
      const gForce = Math.round(speed.centrifugalG);

      // Centrifugal force of a 0.05kg blade tip section
      const massTipKg = 0.05;
      const centForceN = (massTipKg * speed.centrifugalG * 9.80665).toFixed(1);
      const kineticEnergyJ = (0.5 * massTipKg * tipSpeed * tipSpeed).toFixed(1);

      // Dynamic root stress = Centrifugal base + Drag moment + Shock load
      const baseRootStressMPa = (speed.rpm / 1000) * 45; 
      const dragStressMPa = baseRootStressMPa * food.viscousDragMultiplier;
      const shockStressMPa = (food.impactShockPeakN / 12); // sectional modulus scaling
      const peakStressMPa = (dragStressMPa + shockStressMPa) * history.notchStressFactor;

      // Safety Factor
      const fatigueLimit = blade.fatigueLimitMPa || (blade.yieldStrengthMPa * 0.45);
      const safetyFactor = Math.max(0.1, (fatigueLimit / peakStressMPa)).toFixed(2);

      // Bowl Shatter Risk calculation
      let baseShatterPercent = 2;
      if (bowl.id === 'bpa-polycarbonate') {
        baseShatterPercent = (dw.crazingSeverityFactor * 8) + (food.impactShockPeakN / 50);
      } else if (bowl.id === 'san-styrene') {
        baseShatterPercent = (dw.crazingSeverityFactor * 14) + (food.impactShockPeakN / 30);
      } else if (bowl.id === 'borosilicate-glass') {
        baseShatterPercent = (food.impactShockPeakN > 500) ? 75 : 5;
      } else if (bowl.id === 'tritan-copolyester') {
        baseShatterPercent = (dw.crazingSeverityFactor * 1.5) + (food.impactShockPeakN / 150);
      }
      const shatterRisk = Math.min(99, Math.max(1, Math.round(baseShatterPercent)));

      // Chipping risk
      let chippingStatus = 'NEGLIGIBLE';
      let chippingColor = 'text-emerald-700';
      let chippingSub = 'Edge stress below martensitic yield';
      if (food.id === 'foreign-metal-pit' || (food.id === 'frozen-ice' && blade.id === 'martensitic-420')) {
        chippingStatus = 'CRITICAL DANGER';
        chippingColor = 'text-rose-950 font-black';
        chippingSub = 'Brittle cleavage shedding 0.5–2mm steel shards into food!';
      } else if (food.id === 'frozen-ice' || history.id === 'heavily-fatigued') {
        chippingStatus = 'ELEVATED RISK';
        chippingColor = 'text-amber-950 font-bold';
        chippingSub = 'Micro-spalling occurring along serration root';
      }

      // Hub Spline creep
      let hubStatus = 'STABLE';
      let hubSub = 'Shaft temp < 50°C; zero spline slip';
      if (blade.id === 'nylon-overmold-hub' && food.id === 'heavy-dough') {
        hubStatus = 'THERMAL SOFTENING RISK';
        hubSub = 'Shaft friction exceeding 75°C; nylon spline creep imminent';
      } else if (food.id === 'heavy-dough') {
        hubStatus = 'HIGH TORSION';
        hubSub = 'Continuous motor torque at 85% continuous capacity';
      }

      // Update UI Metrics
      document.getElementById('metric-safety-factor').textContent = safetyFactor;
      const sfTag = document.getElementById('metric-safety-tag');
      const sfMeter = document.getElementById('meter-safety-factor');
      if (safetyFactor >= 2.0) {
        sfTag.textContent = 'SAFE';
        sfTag.className = 'text-xs font-bold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-900';
        sfMeter.className = 'bg-emerald-700 h-1.5 rounded-full transition-all duration-300';
        sfMeter.style.width = Math.min(100, safetyFactor * 25) + '%';
      } else if (safetyFactor >= 1.0) {
        sfTag.textContent = 'MARGINAL';
        sfTag.className = 'text-xs font-bold px-2 py-0.5 rounded-full bg-amber-100 text-amber-900';
        sfMeter.className = 'bg-amber-600 h-1.5 rounded-full transition-all duration-300';
        sfMeter.style.width = (safetyFactor * 40) + '%';
      } else {
        sfTag.textContent = 'FAILURE IMMINENT';
        sfTag.className = 'text-xs font-bold px-2 py-0.5 rounded-full bg-rose-100 text-rose-950';
        sfMeter.className = 'bg-rose-600 h-1.5 rounded-full transition-all duration-300';
        sfMeter.style.width = '15%';
      }

      // Shatter Risk
      document.getElementById('metric-shatter-risk').textContent = shatterRisk + '%';
      const shTag = document.getElementById('metric-shatter-tag');
      const shMeter = document.getElementById('meter-shatter-risk');
      if (shatterRisk < 15) {
        shTag.textContent = 'LOW';
        shTag.className = 'text-xs font-bold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-900';
        shMeter.className = 'bg-emerald-700 h-1.5 rounded-full transition-all duration-300';
      } else if (shatterRisk < 50) {
        shTag.textContent = 'MODERATE';
        shTag.className = 'text-xs font-bold px-2 py-0.5 rounded-full bg-amber-100 text-amber-900';
        shMeter.className = 'bg-amber-600 h-1.5 rounded-full transition-all duration-300';
      } else {
        shTag.textContent = 'EXTREME DANGER';
        shTag.className = 'text-xs font-bold px-2 py-0.5 rounded-full bg-rose-100 text-rose-950';
        shMeter.className = 'bg-rose-600 h-1.5 rounded-full transition-all duration-300';
      }
      shMeter.style.width = shatterRisk + '%';

      // Speed & Centrifugal
      document.getElementById('metric-tip-speed').textContent = tipSpeed.toFixed(1) + ' m/s';
      document.getElementById('metric-tip-mph').textContent = `(${tipMph} mph)`;
      document.getElementById('metric-tip-energy').textContent = `Kinetic Energy: ${kineticEnergyJ} J/blade`;
      document.getElementById('metric-g-force').textContent = `${gForce} g`;
      document.getElementById('metric-centrifugal-force').textContent = `Centrifugal Outward Force: ${centForceN} N`;

      // Chipping & Hub
      const chipEl = document.getElementById('metric-chipping');
      chipEl.textContent = chippingStatus;
      chipEl.className = `text-lg md:text-xl font-bold ${chippingColor}`;
      document.getElementById('metric-chipping-sub').textContent = chippingSub;

      document.getElementById('metric-hub-creep').textContent = hubStatus;
      document.getElementById('metric-hub-sub').textContent = hubSub;

      // Callout Box
      const callout = document.getElementById('callout-box');
      const icon = document.getElementById('callout-icon');
      const failMode = document.getElementById('callout-failure-mode');
      const action = document.getElementById('callout-action-protocol');

      if (shatterRisk >= 50 || safetyFactor < 1.0 || chippingStatus.includes('CRITICAL')) {
        callout.className = 'border border-rose-300 bg-rose-50/70 rounded-xl p-5 mb-2 transition-colors';
        icon.textContent = '🚨';
        failMode.textContent = `CRITICAL FAILURE RISK: ${shatterRisk >= 50 ? bowl.shatterFailureMode : blade.microChippingRisk}.`;
        action.textContent = 'STOP OPERATION IMMEDIATELY. Do not run appliance with solid ice, pit foreign objects, or damaged polycarbonate work bowls. Inspect food for shed metal fragments.';
      } else if (shatterRisk >= 20 || safetyFactor < 2.0 || hubStatus.includes('RISK')) {
        callout.className = 'border border-amber-300 bg-amber-50/70 rounded-xl p-5 mb-2 transition-colors';
        icon.textContent = '⚠️';
        failMode.textContent = `ELEVATED FATIGUE HAZARD: High cyclic cantilever deflection and localized polymer micro-crazing.`;
        action.textContent = 'Limit continuous motor runtime to under 45 seconds. Restrict food batch size. Hand wash work bowl and inspect blade bevel with magnification.';
      } else {
        callout.className = 'border border-emerald-300 bg-emerald-50/50 rounded-xl p-5 mb-2 transition-colors';
        icon.textContent = '✅';
        failMode.textContent = 'None. Operational stresses are well below the material endurance limit.';
        action.textContent = 'Appliance is operating safely inside certified design envelope. Hand wash work bowl and inspect S-blade every 6 months under magnification.';
      }
    }

    [bowlSelect, bladeSelect, foodSelect, dwSelect, speedSelect, historySelect].forEach(sel => {
      sel.addEventListener('change', recalculate);
    });

    recalculate();

    // Copy report
    copyBtn.addEventListener('click', () => {
      const sf = document.getElementById('metric-safety-factor').textContent;
      const sr = document.getElementById('metric-shatter-risk').textContent;
      const ts = document.getElementById('metric-tip-speed').textContent;
      const gf = document.getElementById('metric-g-force').textContent;
      const chip = document.getElementById('metric-chipping').textContent;
      const text = `=== Food Processor Centrifugal Stress & Blade Fatigue Report ===
- Work Bowl: ${bowlSelect.options[bowlSelect.selectedIndex].text}
- Blade Metallurgy: ${bladeSelect.options[bladeSelect.selectedIndex].text}
- Food Resistance Matrix: ${foodSelect.options[foodSelect.selectedIndex].text}
- Dishwasher Aging: ${dwSelect.options[dwSelect.selectedIndex].text}
- Motor RPM: ${speedSelect.options[speedSelect.selectedIndex].text}
- Blade Fatigue Safety Factor: ${sf}
- Bowl Shatter & Crazing Risk: ${sr}
- Blade Tip Speed: ${ts}
- Centripetal Acceleration: ${gf}
- Metal Chipping Hazard: ${chip}
- Primary Failure Mode: ${document.getElementById('callout-failure-mode').textContent}
- Recommended Protocol: ${document.getElementById('callout-action-protocol').textContent}
Generated via IsItKitchenSafe.com (Materials Physics Engine)`;

      navigator.clipboard.writeText(text).then(() => {
        const originalText = copyBtn.innerHTML;
        copyBtn.innerHTML = `<span>${copiedFeedback}</span>`;
        copyBtn.classList.add('bg-emerald-100', 'text-emerald-900', 'border-emerald-300');
        setTimeout(() => {
          copyBtn.innerHTML = originalText;
          copyBtn.classList.remove('bg-emerald-100', 'text-emerald-900', 'border-emerald-300');
        }, 2500);
      });
    });
  });
</script>
