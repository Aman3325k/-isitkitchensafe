    tableSub: "拉伸屈服强度、悬臂梁缺口冲击韧性、耐洗碗机性能及化学开裂机理对比。",
    colMaterial: "杯体材质 / 聚合物",
    colTensile: "拉伸屈服强度 (MPa)",
    colIzod: "缺口冲击韧性 (J/m)",
    colCrazing: "碱性热化学银纹敏感度",
