const d = DICTIONARY[lang] || DICTIONARY.en;
---

<div class="bg-surface border border-hairline rounded-3xl p-6 sm:p-8 md:p-10 shadow-sm max-w-6xl mx-auto my-8">
  <!-- Header & Badges -->
  <div class="border-b border-hairline pb-6 mb-8">
    <div class="flex flex-wrap items-center gap-2 mb-3">
      <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-sky-700 text-white">
        {d.badge}
      </span>
      <span class="text-xs text-muted font-mono">
        ASTM C149 &bull; ANSI/PMMI B155.1 &bull; FDA 21 CFR § 117 &bull; OSHA 1910.94
      </span>
    </div>
    <h2 class="text-2xl sm:text-3xl font-black text-ink tracking-tight mb-2">
      {d.title}
    </h2>
    <p class="text-sm sm:text-base text-muted leading-relaxed max-w-4xl">
      {d.subtitle}
    </p>
  </div>

  <!-- Operational Presets -->
  <div class="mb-8 p-4 rounded-2xl bg-surface-soft border border-hairline">
    <div class="text-xs font-bold uppercase tracking-wider text-ink mb-3 flex items-center gap-2">
      <svg class="w-4 h-4 text-sky-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
      </svg>
      {d.presetsTitle}
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2">
      <button 
        type="button" 
        id="btn-preset-compliant"
        class="text-left text-xs p-3 rounded-xl border border-sky-300 bg-sky-50/80 hover:bg-sky-100/90 text-sky-950 font-medium transition-all shadow-2xs"
      >
        <span class="font-bold block text-sky-900 mb-0.5">✓ {d.presetCompliant}</span>
        <span class="text-[11px] text-sky-800">Graduated 4-zone, 316L, PETG, ΔT 35°C</span>
      </button>

      <button 
        type="button" 
        id="btn-preset-thermal-shock"
        class="text-left text-xs p-3 rounded-xl border border-rose-300 bg-rose-50/80 hover:bg-rose-100/90 text-rose-950 font-medium transition-all shadow-2xs"
      >
        <span class="font-bold block text-rose-900 mb-0.5">💥 {d.presetThermalShock}</span>
        <span class="text-[11px] text-rose-800">Cold Glass 12°C entering 105°C steam (ΔT 93°C)</span>
      </button>

      <button 
        type="button" 
        id="btn-preset-pet-paneling"
        class="text-left text-xs p-3 rounded-xl border border-amber-300 bg-amber-50/80 hover:bg-amber-100/90 text-amber-950 font-medium transition-all shadow-2xs"
      >
        <span class="font-bold block text-amber-900 mb-0.5">⚠️ {d.presetPetPaneling}</span>
        <span class="text-[11px] text-amber-800">Thin PET bottle, high dwell, wall softens >68°C</span>
      </button>

      <button 
        type="button" 
        id="btn-preset-pvc-corrosion"
        class="text-left text-xs p-3 rounded-xl border border-purple-300 bg-purple-50/80 hover:bg-purple-100/90 text-purple-950 font-medium transition-all shadow-2xs"
      >
        <span class="font-bold block text-purple-900 mb-0.5">☣️ {d.presetPvcCorrosion}</span>
        <span class="text-[11px] text-purple-800">PVC film release HCl, 304 plenum pitting</span>
      </button>
    </div>
  </div>

  <!-- Interactive Controls & Diagnostic Visuals Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mb-10">
    <!-- Controls (7 cols) -->
    <div class="lg:col-span-7 space-y-6">
      <div class="border-b border-hairline pb-2">
        <h3 class="text-sm font-bold text-ink uppercase tracking-wider">
          {d.controlsTitle}
        </h3>
        <p class="text-xs text-muted mt-0.5">
          {d.controlsSub}
        </p>
      </div>

      <!-- 1. Tunnel Architecture -->
      <div class="space-y-1.5">
        <label for="select-tunnel-arch" class="block text-xs font-bold text-ink">
          {d.tunnelLabel}
        </label>
        <select 
          id="select-tunnel-arch" 
          class="w-full text-xs p-3 rounded-xl border border-hairline bg-surface-soft text-ink font-medium focus:ring-2 focus:ring-sky-500 focus:outline-hidden transition-all"
        >
          {steamTunnelData.steamTunnelArchitectures.map(t => (
            <option value={t.id}>{t.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted leading-relaxed">
          {d.tunnelHelp}
        </p>
      </div>

      <!-- 2. Container Substrate & Geometry -->
      <div class="space-y-1.5">
        <label for="select-container-substrate" class="block text-xs font-bold text-ink">
          {d.substrateLabel}
        </label>
        <select 
          id="select-container-substrate" 
          class="w-full text-xs p-3 rounded-xl border border-hairline bg-surface-soft text-ink font-medium focus:ring-2 focus:ring-sky-500 focus:outline-hidden transition-all"
        >
          {steamTunnelData.containerSubstrates.map(s => (
            <option value={s.id}>{s.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted leading-relaxed">
          {d.substrateHelp}
        </p>
      </div>

      <!-- 3. Shrink Sleeve Film Profile -->
      <div class="space-y-1.5">
        <label for="select-shrink-film" class="block text-xs font-bold text-ink">
          {d.filmLabel}
        </label>
        <select 
          id="select-shrink-film" 
          class="w-full text-xs p-3 rounded-xl border border-hairline bg-surface-soft text-ink font-medium focus:ring-2 focus:ring-sky-500 focus:outline-hidden transition-all"
        >
          {steamTunnelData.shrinkFilmProfiles.map(f => (
            <option value={f.id}>{f.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted leading-relaxed">
          {d.filmHelp}
        </p>
      </div>

      <!-- 4. Sanitizing Chemistry Residuals -->
      <div class="space-y-1.5">
        <label for="select-sanitizer-chem" class="block text-xs font-bold text-ink">
          {d.sanitizerLabel}
        </label>
        <select 
          id="select-sanitizer-chem" 
          class="w-full text-xs p-3 rounded-xl border border-hairline bg-surface-soft text-ink font-medium focus:ring-2 focus:ring-sky-500 focus:outline-hidden transition-all"
        >
          {steamTunnelData.sanitizingChemistries.map(c => (
            <option value={c.id}>{c.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted leading-relaxed">
          {d.sanitizerHelp}
        </p>
      </div>

      <!-- 5. Initial Container Ambient Temperature Slider -->
      <div class="p-4 rounded-2xl bg-surface-soft border border-hairline space-y-2">
        <div class="flex items-center justify-between text-xs">
          <label for="range-ambient-temp" class="font-bold text-ink">
            {d.ambientTempLabel}
          </label>
          <span id="disp-ambient-temp" class="font-mono font-bold text-sky-700 bg-sky-100/80 px-2.5 py-0.5 rounded-lg text-xs">
            18.0°C (64.4°F)
          </span>
        </div>
        <input 
          type="range" 
          id="range-ambient-temp" 
          min="5" 
          max="45" 
          step="0.5" 
          value="18" 
          class="w-full accent-sky-600 cursor-pointer"
        />
        <p class="text-[11px] text-muted leading-relaxed mt-1">
          {d.ambientTempHelp}
        </p>
      </div>

      <!-- 6. Steam Tunnel Zone 1 Temperature Slider -->
      <div class="p-4 rounded-2xl bg-surface-soft border border-hairline space-y-2">
        <div class="flex items-center justify-between text-xs">
          <label for="range-steam-temp" class="font-bold text-ink">
            {d.steamTempLabel}
          </label>
          <span id="disp-steam-temp" class="font-mono font-bold text-sky-700 bg-sky-100/80 px-2.5 py-0.5 rounded-lg text-xs">
            98.0°C (208.4°F)
          </span>
        </div>
        <input 
          type="range" 
          id="range-steam-temp" 
          min="65" 
          max="115" 
          step="0.5" 
          value="98" 
          class="w-full accent-sky-600 cursor-pointer"
        />
        <p class="text-[11px] text-muted leading-relaxed mt-1">
          {d.steamTempHelp}
        </p>
      </div>

      <!-- 7. Conveyor Bottling Line Speed Slider -->
      <div class="p-4 rounded-2xl bg-surface-soft border border-hairline space-y-2">
        <div class="flex items-center justify-between text-xs">
          <label for="range-line-speed" class="font-bold text-ink">
            {d.lineSpeedLabel}
          </label>
          <span id="disp-line-speed" class="font-mono font-bold text-sky-700 bg-sky-100/80 px-2.5 py-0.5 rounded-lg text-xs">
            300 BPM (5.0 bottles/sec)
          </span>
        </div>
        <input 
          type="range" 
          id="range-line-speed" 
          min="30" 
          max="750" 
          step="10" 
          value="300" 
          class="w-full accent-sky-600 cursor-pointer"
        />
        <p class="text-[11px] text-muted leading-relaxed mt-1">
          {d.lineSpeedHelp}
        </p>
      </div>

      <!-- 8. Tunnel Exhaust Blower Volumetric Draft Slider -->
      <div class="p-4 rounded-2xl bg-surface-soft border border-hairline space-y-2">
        <div class="flex items-center justify-between text-xs">
          <label for="range-exhaust-cfm" class="font-bold text-ink">
            {d.exhaustLabel}
          </label>
          <span id="disp-exhaust-cfm" class="font-mono font-bold text-sky-700 bg-sky-100/80 px-2.5 py-0.5 rounded-lg text-xs">
            1,450 CFM (Negative Draft)
          </span>
        </div>
        <input 
          type="range" 
          id="range-exhaust-cfm" 
          min="200" 
          max="2000" 
          step="25" 
          value="1450" 
