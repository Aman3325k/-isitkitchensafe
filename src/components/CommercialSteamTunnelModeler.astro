        {d.rulesTitle}
      </h3>
      <p class="text-xs sm:text-sm text-muted">
        {d.rulesSub}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
      <div class="p-4 rounded-2xl bg-surface-soft border border-hairline space-y-1.5">
        <div class="flex items-center justify-between">
          <span class="font-bold text-ink text-sm">{d.rule1Title}</span>
          <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-sky-100 text-sky-800 uppercase">Glass Shock</span>
        </div>
        <p class="text-muted leading-relaxed">
          {d.rule1Text}
        </p>
      </div>

      <div class="p-4 rounded-2xl bg-surface-soft border border-hairline space-y-1.5">
        <div class="flex items-center justify-between">
          <span class="font-bold text-ink text-sm">{d.rule2Title}</span>
          <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-100 text-amber-800 uppercase">OSHA Exhaust</span>
        </div>
        <p class="text-muted leading-relaxed">
          {d.rule2Text}
        </p>
      </div>

      <div class="p-4 rounded-2xl bg-surface-soft border border-hairline space-y-1.5">
        <div class="flex items-center justify-between">
          <span class="font-bold text-ink text-sm">{d.rule3Title}</span>
          <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-800 uppercase">Anti-Drip</span>
        </div>
        <p class="text-muted leading-relaxed">
          {d.rule3Text}
        </p>
      </div>

      <div class="p-4 rounded-2xl bg-surface-soft border border-hairline space-y-1.5">
        <div class="flex items-center justify-between">
          <span class="font-bold text-ink text-sm">{d.rule4Title}</span>
          <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-purple-100 text-purple-800 uppercase">ASME Boiler</span>
        </div>
        <p class="text-muted leading-relaxed">
          {d.rule4Text}
        </p>
      </div>
    </div>
  </div>

  <!-- Technical Simulation Copy Report Button -->
  <div class="flex justify-end pt-4">
    <button
      type="button"
      id="btn-copy-tunnel-report"
      class="px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-medium text-xs flex items-center gap-2 transition-all shadow-sm active:scale-95"
    >
      <svg class="w-4 h-4 text-sky-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
      </svg>
      <span id="btn-copy-tunnel-text">{d.copyReportBtn}</span>
    </button>
  </div>
</div>

<script is:inline define:vars={{ rawTunnelData: steamTunnelData }}>
  (function initCommercialSteamTunnelModeler() {
    // DOM Elements
    const selTunnelArch = document.getElementById('select-tunnel-arch');
    const selContainerSubstrate = document.getElementById('select-container-substrate');
    const selShrinkFilm = document.getElementById('select-shrink-film');
    const selSanitizerChem = document.getElementById('select-sanitizer-chem');

    const rngAmbientTemp = document.getElementById('range-ambient-temp');
    const rngSteamTemp = document.getElementById('range-steam-temp');
    const rngLineSpeed = document.getElementById('range-line-speed');
    const rngExhaustCfm = document.getElementById('range-exhaust-cfm');

    const dispAmbientTemp = document.getElementById('disp-ambient-temp');
    const dispSteamTemp = document.getElementById('disp-steam-temp');
    const dispLineSpeed = document.getElementById('disp-line-speed');
    const dispExhaustCfm = document.getElementById('disp-exhaust-cfm');

    // Telemetry Elements
    const metricDeltaT = document.getElementById('metric-delta-t');
    const metricAstmMargin = document.getElementById('metric-astm-margin');
    const badgeDeltaT = document.getElementById('badge-delta-t');
    const barDeltaT = document.getElementById('bar-delta-t');

    const metricHoopStress = document.getElementById('metric-hoop-stress');
    const metricStressFactor = document.getElementById('metric-stress-factor');
    const badgeHoopStress = document.getElementById('badge-hoop-stress');

    const metricResidenceTime = document.getElementById('metric-residence-time');
    const metricHeatDeflection = document.getElementById('metric-heat-deflection');
    const badgeDwell = document.getElementById('badge-dwell');

    const metricCondensateFlux = document.getElementById('metric-condensate-flux');
    const metricAirKnife = document.getElementById('metric-air-knife');

    const metricCorrosionRate = document.getElementById('metric-corrosion-rate');
    const metricMetallurgyVerdict = document.getElementById('metric-metallurgy-verdict');
    const badgeCorrosion = document.getElementById('badge-corrosion');

    const metricExhaustRatio = document.getElementById('metric-exhaust-ratio');
    const metricPlumeVerdict = document.getElementById('metric-plume-verdict');
    const badgeExhaust = document.getElementById('badge-exhaust');

    // Banner Elements
    const banner = document.getElementById('diagnostic-banner');
    const bannerTitle = document.getElementById('banner-status-title');
    const bannerBadge = document.getElementById('banner-status-badge');
    const bannerIcon = document.getElementById('banner-status-icon');
    const bannerRisk = document.getElementById('banner-risk-text');
    const bannerMech = document.getElementById('banner-mechanisms-text');
    const bannerMit = document.getElementById('banner-mitigation-text');

    // SVG elements
    const svgIndicator = document.getElementById('svg-status-indicator');
    const svgAstmDisp = document.getElementById('svg-astm-disp');
    const svgDraftDisp = document.getElementById('svg-draft-disp');
    const svgHazardOverlay = document.getElementById('svg-hazard-overlay');

    // Preset Buttons
    const btnPresetCompliant = document.getElementById('btn-preset-compliant');
    const btnPresetThermalShock = document.getElementById('btn-preset-thermal-shock');
    const btnPresetPetPaneling = document.getElementById('btn-preset-pet-paneling');
    const btnPresetPvcCorrosion = document.getElementById('btn-preset-pvc-corrosion');
    const btnCopyReport = document.getElementById('btn-copy-tunnel-report');
    const btnCopyText = document.getElementById('btn-copy-tunnel-text');

    if (!selTunnelArch || !rngAmbientTemp) return;

    function recalculate() {
      const tunnel = rawTunnelData.steamTunnelArchitectures.find(t => t.id === selTunnelArch.value) || rawTunnelData.steamTunnelArchitectures[0];
      const substrate = rawTunnelData.containerSubstrates.find(s => s.id === selContainerSubstrate.value) || rawTunnelData.containerSubstrates[0];
      const film = rawTunnelData.shrinkFilmProfiles.find(f => f.id === selShrinkFilm.value) || rawTunnelData.shrinkFilmProfiles[0];
      const sanitizer = rawTunnelData.sanitizingChemistries.find(c => c.id === selSanitizerChem.value) || rawTunnelData.sanitizingChemistries[0];

      const ambientTemp = parseFloat(rngAmbientTemp.value);
      const steamTemp = parseFloat(rngSteamTemp.value);
      const lineSpeedBpm = parseFloat(rngLineSpeed.value);
      const exhaustCfm = parseFloat(rngExhaustCfm.value);

      // Update Slider Display Badges
      dispAmbientTemp.textContent = `${ambientTemp.toFixed(1)}°C (${((ambientTemp * 9/5) + 32).toFixed(1)}°F)`;
      dispSteamTemp.textContent = `${steamTemp.toFixed(1)}°C (${((steamTemp * 9/5) + 32).toFixed(1)}°F)`;
      dispLineSpeed.textContent = `${lineSpeedBpm} BPM (${(lineSpeedBpm / 60).toFixed(1)} bottles/sec)`;
      dispExhaustCfm.textContent = `${exhaustCfm.toLocaleString()} CFM (${exhaustCfm >= 1000 ? 'Negative Draft' : 'Weak Draft'})`;

      // 1. Thermal Shock Gradient Calculation (ASTM C149)
      // In a multi-zone tunnel, the initial zone delivers a controlled temperature ramp.
      // In a single-zone or fouled tunnel, the bottle experiences 100% of the temperature difference abruptly.
      let effectiveDeltaT = 0;
      if (tunnel.zoneCount >= 4) {
        effectiveDeltaT = (steamTemp - ambientTemp) * 0.45; // 45% initial ramp in zone 1
      } else if (tunnel.zoneCount === 3) {
        effectiveDeltaT = (steamTemp - ambientTemp) * 0.65;
      } else if (tunnel.zoneCount === 2) {
        effectiveDeltaT = (steamTemp - ambientTemp) * 0.82;
      } else {
        effectiveDeltaT = steamTemp - ambientTemp; // 100% full thermal shock step
      }

      const astmDeltaTLimit = substrate.maxThermalShockDeltaTC || 42.0;
      const astmMargin = astmDeltaTLimit - effectiveDeltaT;

      // 2. Tensile Hoop Stress Calculation (σ_tensile = E * α * ΔT / (1 - ν) * Φ)
      const E = substrate.youngsModulusGpa * 1000; // MPa
      const alpha = substrate.thermalExpansionCoeffPpmK * 1e-6; // /K
      const nu = substrate.poissonsRatio;
      const geometricFactor = 0.72; // wall restraint factor for cylindrical containers

      const tensileHoopStressMpa = (E * alpha * effectiveDeltaT / (1 - nu)) * geometricFactor;
      const burstLimitMpa = substrate.tensileBurstStressLimitMpa || 45.0;
      const stressSafetyFactor = burstLimitMpa / Math.max(tensileHoopStressMpa, 0.1);

      // 3. Residence Time & Heating Dwell Calculation
      // Conveyor velocity v (m/s) = (BPM / 60) * (container pitch in meters approx 0.08m)
      const pitchMeters = 0.085;
      const conveyorSpeedMs = Math.max((lineSpeedBpm / 60) * pitchMeters, 0.05);
      const residenceTimeSec = tunnel.tunnelLengthMeters / conveyorSpeedMs;

      // Heat transfer wall temperature rise calculation
      const h_cond = 8500; // W/m²·K (saturated steam condensation)
      const heatFluxKwM2 = (h_cond * (steamTemp - ambientTemp)) / 1000;
      const condensateGramsPerBottle = (heatFluxKwM2 * 0.025 * residenceTimeSec) / 2.257;

      // 4. Plenum Corrosion Penetration Rate (mm/year)
      let baseCorrosionMmYr = 0.008;
      if (tunnel.metallurgy.includes('304')) baseCorrosionMmYr = 0.085;
      if (tunnel.metallurgy.includes('Pitted')) baseCorrosionMmYr = 0.280;

      if (film.id === 'pvc_traditional_film' && steamTemp > 85) {
        baseCorrosionMmYr *= 3.8; // HCl acid outgassing accelerate pitting
      }
      if (sanitizer.id === 'peracetic_acid_quaternary') {
        baseCorrosionMmYr *= 2.2; // Acidic PAA accelerated attack
      } else if (sanitizer.id === 'chlorinated_alkaline_foam') {
        baseCorrosionMmYr *= 2.9; // Chloride stress corrosion
      }

      // 5. Exhaust Capture Efficiency vs Steam Generation
      const steamKgHr = tunnel.steamConsumptionKgHr || 180;
      // Steam volume at atmospheric pressure ~ 1.67 m³/kg. 1 CFM = 1.699 m³/hr
      const requiredExhaustCfm = (steamKgHr * 1.67 / 1.699) * 1.35; // OSHA 135% factor
      const exhaustCapturePct = (exhaustCfm / requiredExhaustCfm) * 100;

      // Update Telemetry Displays
      metricDeltaT.textContent = `${effectiveDeltaT.toFixed(1)}°C`;
      barDeltaT.style.width = `${Math.min(Math.max((effectiveDeltaT / 60) * 100, 5), 100)}%`;

      if (astmMargin >= 5) {
        badgeDeltaT.className = 'px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800';
        badgeDeltaT.textContent = `Compliant • ΔT ≤ ${astmDeltaTLimit.toFixed(0)}°C`;
        metricAstmMargin.className = 'font-bold font-mono text-emerald-700';
        metricAstmMargin.textContent = `+${astmMargin.toFixed(1)}°C Below Critical Shatter Threshold`;
        barDeltaT.className = 'bg-emerald-500 h-1.5 rounded-full transition-all';
      } else if (astmMargin >= 0) {
        badgeDeltaT.className = 'px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-amber-100 text-amber-800';
        badgeDeltaT.textContent = 'Caution • Near ASTM Limit';
        metricAstmMargin.className = 'font-bold font-mono text-amber-700';
        metricAstmMargin.textContent = `+${astmMargin.toFixed(1)}°C Warning Margin`;
        barDeltaT.className = 'bg-amber-500 h-1.5 rounded-full transition-all';
      } else {
        badgeDeltaT.className = 'px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-rose-100 text-rose-800 animate-pulse';
        badgeDeltaT.textContent = 'CRITICAL • ASTM C149 EXCEEDED';
        metricAstmMargin.className = 'font-bold font-mono text-rose-700';
        metricAstmMargin.textContent = `${astmMargin.toFixed(1)}°C Thermal Shock Shatter Hazard!`;
        barDeltaT.className = 'bg-rose-500 h-1.5 rounded-full transition-all';
      }

      metricHoopStress.textContent = `${tensileHoopStressMpa.toFixed(1)} MPa`;
      if (stressSafetyFactor >= 1.3) {
        badgeHoopStress.className = 'px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800';
        badgeHoopStress.textContent = 'Elastic Range (Safe)';
        metricStressFactor.className = 'font-bold font-mono text-emerald-700';
        metricStressFactor.textContent = `${stressSafetyFactor.toFixed(2)}x Safety Factor (Limit: ${burstLimitMpa} MPa)`;
      } else if (stressSafetyFactor >= 1.0) {
        badgeHoopStress.className = 'px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-amber-100 text-amber-800';
        badgeHoopStress.textContent = 'Elevated Micro-Crack Risk';
        metricStressFactor.className = 'font-bold font-mono text-amber-700';
        metricStressFactor.textContent = `${stressSafetyFactor.toFixed(2)}x Marginal Safety Factor`;
      } else {
        badgeHoopStress.className = 'px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-rose-100 text-rose-800 animate-pulse';
        badgeHoopStress.textContent = 'HOOP STRESS BURST HAZARD';
        metricStressFactor.className = 'font-bold font-mono text-rose-700';
        metricStressFactor.textContent = `${stressSafetyFactor.toFixed(2)}x Over-Stress Shatter Failure!`;
      }

      metricResidenceTime.textContent = `${residenceTimeSec.toFixed(2)} sec`;
      metricCondensateFlux.textContent = `${heatFluxKwM2.toFixed(1)} kW/m²`;
      metricCorrosionRate.textContent = `${baseCorrosionMmYr.toFixed(3)} mm/yr`;
      metricExhaustRatio.textContent = `${exhaustCapturePct.toFixed(0)}% Draft`;

      // SVG Disps
      svgAstmDisp.textContent = `${astmMargin >= 0 ? '+' : ''}${astmMargin.toFixed(1)}°C ${astmMargin >= 0 ? 'SAFE' : 'FAIL'}`;
      svgDraftDisp.textContent = `${exhaustCapturePct >= 100 ? 'NEGATIVE DRAFT' : 'POSITIVE PLUME LEAK'}`;

      // Diagnostics & Banner Logic
      const isGlassBurst = substrate.id === 'soda_lime_glass_bottle' && (astmMargin < 0 || stressSafetyFactor < 1.0);
      const isPetPaneling = (substrate.id === 'pet_lightweight_beverage_bottle' || substrate.id === 'hdpe_squeeze_condiment_bottle') && steamTemp > substrate.heatDeflectionTempC && residenceTimeSec > 4.5;
      const isCorrosionCrisis = baseCorrosionMmYr > 0.15;
      const isExhaustSpill = exhaustCapturePct < 90;

      if (isGlassBurst) {
        banner.className = 'mb-10 p-6 rounded-2xl border transition-all bg-rose-50/95 border-rose-300 text-rose-950 shadow-md';
        bannerIcon.textContent = '💥';
        bannerTitle.textContent = 'CRITICAL THERMAL SHOCK BURST: Explosive Glass Shattering Hazard on Conveyor';
        bannerTitle.className = 'text-base font-bold text-rose-900';
        bannerBadge.className = 'px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-rose-200 text-rose-900';
        bannerBadge.textContent = 'ASTM C149 VIOLATION • LIFE-SAFETY HAZARD';
        bannerRisk.textContent = 'Catastrophic glass container fracture. Outer surface tensile hoop stress exceeds the glass brittle tensile limit, creating projectile glass shards and extensive product line contamination.';
        bannerMech.textContent = `Cold bottle infeed (${ambientTemp}°C) entering aggressive steam zone generates ΔT = ${effectiveDeltaT.toFixed(1)}°C (limit ${astmDeltaTLimit}°C), inducing ${tensileHoopStressMpa.toFixed(1)} MPa surface tensile stress.`;
        bannerMit.textContent = 'Immediately switch to a 4-zone graduated temperature steam tunnel, increase infeed container pre-warming, or reduce initial manifold steam temperature below 75°C.';
        svgIndicator.textContent = '● SHATTER EXPLOSION';
        svgIndicator.className = 'text-rose-400 font-bold animate-pulse';
        svgHazardOverlay.setAttribute('opacity', '1');
      } else if (isPetPaneling) {
        banner.className = 'mb-10 p-6 rounded-2xl border transition-all bg-amber-50/95 border-amber-300 text-amber-950 shadow-md';
        bannerIcon.textContent = '⚠️';
        bannerTitle.textContent = 'PLASTIC WALL SOFTENING & PANELING: Container Creep Buckling Risk';
        bannerTitle.className = 'text-base font-bold text-amber-900';
        bannerBadge.className = 'px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-200 text-amber-900';
        bannerBadge.textContent = 'HEAT DEFLECTION EXCEEDED';
        bannerRisk.textContent = 'Lightweight bottle wall temperature surpasses the polymer heat deflection temperature (HDT), causing vacuum paneling, bottom rocker instability, or neck finish ovalization.';
        bannerMech.textContent = `Prolonged residence time (${residenceTimeSec.toFixed(2)}s) in high steam temperatures (${steamTemp}°C) softens semi-crystalline PET walls beyond their glass transition temperature (Tg ≈ 68°C).`;
        bannerMit.textContent = 'Increase conveyor line speed (BPM) to reduce steam exposure dwell below 3.0 seconds, or adjust nozzle orientation toward label bands rather than empty headspace walls.';
        svgIndicator.textContent = '● THERMAL WARP';
        svgIndicator.className = 'text-amber-400 font-bold';
        svgHazardOverlay.setAttribute('opacity', '0');
      } else if (isCorrosionCrisis) {
        banner.className = 'mb-10 p-6 rounded-2xl border transition-all bg-purple-50/95 border-purple-300 text-purple-950 shadow-md';
        bannerIcon.textContent = '☣️';
        bannerTitle.textContent = 'SEVERE PLENUM CORROSION: Acidic Pitting & Halogen Stress Cracking Warning';
        bannerTitle.className = 'text-base font-bold text-purple-900';
        bannerBadge.className = 'px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-purple-200 text-purple-900';
        bannerBadge.textContent = 'PREN DEFICIENT • FDA MOLD RISK';
        bannerRisk.textContent = 'Aggressive chemical corrosion liquor in the steam plenum. Pitting creates microscopic crevices that harbor microbial biofilms and cause structural perforation of tunnel walls.';
        bannerMech.textContent = `PVC film dehydrochlorination releases HCl vapor, forming hydrochloric acid condensate in the moist 304 stainless plenum (penetration rate ${baseCorrosionMmYr.toFixed(3)} mm/yr).`;
        bannerMit.textContent = 'Upgrade tunnel plenum and manifold to 316L or 2205 duplex stainless steel (PREN ≥ 25), replace PVC films with halogen-free PETG, and install heated roof anti-drip canopies.';
        svgIndicator.textContent = '● CORROSION WARNING';
        svgIndicator.className = 'text-purple-400 font-bold';
        svgHazardOverlay.setAttribute('opacity', '0');
      } else if (isExhaustSpill) {
        banner.className = 'mb-10 p-6 rounded-2xl border transition-all bg-sky-50/95 border-sky-300 text-sky-950 shadow-md';
        bannerIcon.textContent = '💨';
        bannerTitle.textContent = 'INADEQUATE EXHAUST: Steam Plume Migration into Facility Packaging Cleanroom';
        bannerTitle.className = 'text-base font-bold text-sky-900';
        bannerBadge.className = 'px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-sky-200 text-sky-900';
        bannerBadge.textContent = 'OSHA 1910.94 DEFICIENT';
        bannerRisk.textContent = 'Positive steam pressure causes vapor plume blowout at tunnel infeed and exit vestibules. Condensation on packaging room ceilings promotes mold harborage and slippery floors.';
        bannerMech.textContent = `Exhaust blower draft (${exhaustCfm} CFM) fails to achieve the OSHA 135% gross steam generation volumetric capture requirement (${requiredExhaustCfm.toFixed(0)} CFM).`;
        bannerMit.textContent = 'Increase exhaust blower variable frequency drive (VFD) setpoint to achieve minimum 100 FPM (0.5 m/s) inward face velocity at all tunnel entry and discharge portals.';
        svgIndicator.textContent = '● PLUME ESCAPE';
        svgIndicator.className = 'text-sky-400 font-bold';
        svgHazardOverlay.setAttribute('opacity', '0');
      } else {
        banner.className = 'mb-10 p-6 rounded-2xl border transition-all bg-emerald-50/90 border-emerald-300 text-emerald-950';
        bannerIcon.textContent = '✅';
        bannerTitle.textContent = 'PROCESS COMPLIANT: Saturated Steam Profile & Container Integrity Verified';
        bannerTitle.className = 'text-base font-bold text-emerald-900';
        bannerBadge.className = 'px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-200 text-emerald-900';
        bannerBadge.textContent = 'ASTM C149 • PMMI B155.1 • FDA 21 CFR § 117';
        bannerRisk.textContent = 'None detected. Saturated steam heat flux, thermal shock margins, line speed dwell, and plenum negative draft operate completely within certified engineering tolerances.';
        bannerMech.textContent = `Graduated heating ramp bounds outer tensile stress to ${tensileHoopStressMpa.toFixed(1)} MPa (${stressSafetyFactor.toFixed(2)}x safety factor below rupture threshold).`;
        bannerMit.textContent = 'Maintain standard PMMI preventive maintenance: calibrate quarterly steam PRV valves, clean boiler feed water filters, and verify air knife water-stripping efficacy.';
        svgIndicator.textContent = '● PROCESS NORMAL';
        svgIndicator.className = 'text-emerald-400 font-bold';
        svgHazardOverlay.setAttribute('opacity', '0');
      }
    }

    // Attach Event Listeners
    [selTunnelArch, selContainerSubstrate, selShrinkFilm, selSanitizerChem].forEach(el => {
      el.addEventListener('change', recalculate);
    });

    [rngAmbientTemp, rngSteamTemp, rngLineSpeed, rngExhaustCfm].forEach(el => {
      el.addEventListener('input', recalculate);
    });

    // Preset Handlers
    btnPresetCompliant.addEventListener('click', () => {
      selTunnelArch.value = 'multi_zone_precision_sanitary_tunnel';
      selContainerSubstrate.value = 'soda_lime_glass_bottle';
      selShrinkFilm.value = 'petg_high_shrink_film';
      selSanitizerChem.value = 'pure_softened_steam_condensate';
      rngAmbientTemp.value = '22';
      rngSteamTemp.value = '96';
      rngLineSpeed.value = '350';
      rngExhaustCfm.value = '1450';
      recalculate();
    });

    btnPresetThermalShock.addEventListener('click', () => {
      selTunnelArch.value = 'compact_craft_artisan_tunnel';
      selContainerSubstrate.value = 'soda_lime_glass_bottle';
      selShrinkFilm.value = 'petg_high_shrink_film';
      selSanitizerChem.value = 'pure_softened_steam_condensate';
      rngAmbientTemp.value = '12';
      rngSteamTemp.value = '105';
      rngLineSpeed.value = '100';
      rngExhaustCfm.value = '350';
      recalculate();
    });

    btnPresetPetPaneling.addEventListener('click', () => {
      selTunnelArch.value = 'high_speed_beverage_monobloc_tunnel';
      selContainerSubstrate.value = 'pet_lightweight_beverage_bottle';
      selShrinkFilm.value = 'petg_high_shrink_film';
      selSanitizerChem.value = 'pure_softened_steam_condensate';
      rngAmbientTemp.value = '25';
      rngSteamTemp.value = '102';
      rngLineSpeed.value = '60'; // slow line speed = high residence time
      rngExhaustCfm.value = '980';
      recalculate();
    });

    btnPresetPvcCorrosion.addEventListener('click', () => {
      selTunnelArch.value = 'substandard_fouled_tunnel';
      selContainerSubstrate.value = 'hdpe_squeeze_condiment_bottle';
      selShrinkFilm.value = 'pvc_traditional_film';
      selSanitizerChem.value = 'peracetic_acid_quaternary';
      rngAmbientTemp.value = '20';
      rngSteamTemp.value = '104';
      rngLineSpeed.value = '220';
      rngExhaustCfm.value = '450';
      recalculate();
    });

    // Copy Report Handler
    btnCopyReport.addEventListener('click', () => {
      const summary = `ISITKITCHENSAFE PACKAGING TELEMETRY REPORT:
======================================================
Tool: Commercial Steam Tunnel Shrink Sleeve Condensate & Burst Modeler
Standards: ASTM C149 | ANSI/PMMI B155.1 | FDA 21 CFR § 117 | OSHA 1910.94
Timestamp: ${new Date().toISOString()}

TUNNEL & PACKAGING LINE PARAMETERS:
- Architecture: ${selTunnelArch.options[selTunnelArch.selectedIndex].text}
