    pressureHelp: "カラム内部で超臨界CO2の高密度状態を維持するシステム作動圧力 (100〜350 bar)。",
    tempLabel: "カラムオーブン加熱温度 (°C):",
    tempHelp: "カラム恒温加熱温度 (32°C〜65°C; CO2臨界温度 Tc = 31.1°C)。",
    modifierPctLabel: "有機改質剤共溶媒添加比率 (% v/v):",
    modifierPctHelp: "極性と溶出能力を制御するために添加するエタノール等の体積分率 (0%〜30%)。",
    flowRateLabel: "全移動相送液流量 (mL/min):",
    flowRateHelp: "加圧超臨界CO2および有機改質剤の合計送液流量 (50〜800 mL/min)。",
    presetsTitle: "工業用 SFC 精製・脱毒標準プリセット",
    presetCannabinoid: "ブロードスペクトラムヘンプTHC完全除去 (分取4本, 220 bar, 45°C, 12% EtOH, 350 mL/min, 2-EP)",
    presetAstaxanthin: "微細藻類アスタキサンチン幾何異性体分離 (SMB-SFC 8本, 260 bar, 40°C, 8% EtOH, 280 mL/min, Diol)",
    presetOmega3: "医薬品グレードEPA/DHAエチルエステル分離 (パイロット機, 180 bar, 50°C, 純CO2, 180 mL/min, C18-PFP)",
    presetPolyphenol: "高処理量植物ポリフェノール分取分餾 (分取4本, 280 bar, 42°C, 20% EtOH, 500 mL/min, 2-EP)",
    presetOverpressureHazard: "固定相偏流・ガスケット押し出し過圧噴出 (劣化カラム, 340 bar, 35°C, 25% 含水EtOH, 750 mL/min)",
    diagnosticTitle: "クロマトグラフィー分離能・純度・熱力学診断",
    diagnosticSub: "ピーク分離度 (Rs)、精製活性物純度、超臨界混合流体密度、カラム流動圧力損失 (ΔP)、ASME過圧放出安全マージン、およびCO2循環回収率をリアルタイム算出。",
    resolutionLabel: "クロマトグラフィーピーク分離度 (Rs)",
    purityLabel: "目的生理活性物質純度 (%)",
    densityLabel: "超臨界混合流体密度 (g/mL)",
    deltaPLabel: "カラム流動圧力損失 ΔP (bar)",
    reliefMarginLabel: "ASME VIII 放出安全マージン (bar)",
    co2RecycleLabel: "CO2 気液分離回収率 (%)",
    complianceStatusLabel: "cGMP 医薬食品適合および ASME 圧力安全規格適合性",
    primaryLimitationLabel: "主要な熱力学・流動伝熱制限因子",
    mitigationActionLabel: "推奨衛生プロセス工学対策",
    chromatogramTitle: "リアルタイムクロマトグラム溶出プロファイル",
    chromatogramSub: "目的活性物質ピークと共溶出不純物/THCピークの分離動態を表示し、完全ベースライン分離基準 (Rs ≥ 1.5) の達成を検証。",
    scienceTitle: "超臨界流体クロマトグラフィーの物理学と ASME 圧力安全設計",
    scienceSub: "超臨界流体密度の制御性、Van Deemter段高物質移動速度論、グリーン溶媒クローズドループ回収系、および安全ラプチャーディスクの設計工学解説。",
    tableTitle: "SFC カラム仕様および生理活性物質分離エンジニアリング仕様"
  }
};

const d = DICT[lang] || DICT.en;
const isRtl = false;
---

<div class="sfc-modeler bg-surface rounded-2xl border border-hairline p-6 sm:p-8 max-w-7xl mx-auto my-8 shadow-xs" dir={isRtl ? 'rtl' : 'ltr'}>
  <!-- Header Badge & Titles -->
  <div class="mb-8">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-800 text-white mb-3 shadow-2xs">
      <span>🌿</span>
      <span>{d.badge}</span>
    </div>
    <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-ink tracking-tight mb-3">
      {d.title}
    </h1>
    <p class="text-body text-sm sm:text-base leading-relaxed text-muted max-w-4xl">
      {d.subtitle}
    </p>
  </div>

  <!-- Presets Bar -->
  <div class="bg-surface-soft border border-hairline rounded-xl p-4 sm:p-5 mb-8">
    <div class="flex items-center gap-2 mb-3">
      <span class="text-xs font-bold uppercase tracking-wider text-ink font-mono">⚡ {d.presetsTitle}</span>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-2.5">
      <button 
        type="button" 
        id="sfc-preset-cannabinoid" 
        class="text-left text-xs p-2.5 rounded-lg border border-hairline bg-surface hover:bg-emerald-50 hover:border-emerald-300 transition-all font-medium text-ink shadow-2xs"
      >
        🌿 {d.presetCannabinoid}
      </button>
      <button 
        type="button" 
        id="sfc-preset-astaxanthin" 
        class="text-left text-xs p-2.5 rounded-lg border border-hairline bg-surface hover:bg-emerald-50 hover:border-emerald-300 transition-all font-medium text-ink shadow-2xs"
      >
        🦐 {d.presetAstaxanthin}
      </button>
      <button 
        type="button" 
        id="sfc-preset-omega3" 
        class="text-left text-xs p-2.5 rounded-lg border border-hairline bg-surface hover:bg-emerald-50 hover:border-emerald-300 transition-all font-medium text-ink shadow-2xs"
      >
        🐟 {d.presetOmega3}
      </button>
      <button 
        type="button" 
        id="sfc-preset-polyphenol" 
        class="text-left text-xs p-2.5 rounded-lg border border-hairline bg-surface hover:bg-emerald-50 hover:border-emerald-300 transition-all font-medium text-ink shadow-2xs"
      >
        🍇 {d.presetPolyphenol}
      </button>
      <button 
        type="button" 
        id="sfc-preset-hazard" 
        class="text-left text-xs p-2.5 rounded-lg border border-red-200 bg-red-50/50 hover:bg-red-100 hover:border-red-400 transition-all font-medium text-red-900 shadow-2xs"
      >
        🚨 {d.presetOverpressureHazard}
      </button>
    </div>
  </div>

  <!-- Main Grid: Controls (Left) & Diagnostics (Right) -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-8">
    <!-- Controls Column (5 cols) -->
    <div class="lg:col-span-5 bg-surface-soft border border-hairline rounded-xl p-5 sm:p-6 space-y-5">
      <div>
        <h2 class="text-base font-bold text-ink mb-1 flex items-center gap-2">
          <span>⚙️</span>
          <span>{d.controlsTitle}</span>
        </h2>
        <p class="text-xs text-muted mb-4">{d.controlsSub}</p>
      </div>

      <!-- SFC Skid Assembly -->
      <div class="space-y-1.5">
        <label for="sfc-system" class="block text-xs font-bold text-ink">
          {d.systemLabel}
        </label>
        <select id="sfc-system" class="w-full text-xs rounded-lg border border-hairline bg-surface p-2.5 text-ink focus:ring-2 focus:ring-emerald-500 font-medium">
          {sfcData.sfcSystems.map(sys => (
            <option value={sys.id}>{sys.name}</option>
          ))}
        </select>
        <p class="text-2xs text-muted leading-tight">{d.systemHelp}</p>
      </div>

      <!-- Feedstock Bioactive -->
      <div class="space-y-1.5">
        <label for="sfc-feedstock" class="block text-xs font-bold text-ink">
          {d.feedstockLabel}
        </label>
        <select id="sfc-feedstock" class="w-full text-xs rounded-lg border border-hairline bg-surface p-2.5 text-ink focus:ring-2 focus:ring-emerald-500 font-medium">
          {sfcData.feedstockBioactives.map(feed => (
            <option value={feed.id}>{feed.name}</option>
          ))}
        </select>
        <p class="text-2xs text-muted leading-tight">{d.feedstockHelp}</p>
      </div>

      <!-- Modifier Co-Solvent -->
      <div class="space-y-1.5">
        <label for="sfc-modifier" class="block text-xs font-bold text-ink">
          {d.modifierLabel}
        </label>
        <select id="sfc-modifier" class="w-full text-xs rounded-lg border border-hairline bg-surface p-2.5 text-ink focus:ring-2 focus:ring-emerald-500 font-medium">
          {sfcData.modifierSolvents.map(mod => (
            <option value={mod.id}>{mod.name}</option>
          ))}
        </select>
        <p class="text-2xs text-muted leading-tight">{d.modifierHelp}</p>
      </div>

      <!-- ASME Relief Assembly -->
      <div class="space-y-1.5">
        <label for="sfc-relief" class="block text-xs font-bold text-ink">
          {d.reliefLabel}
        </label>
        <select id="sfc-relief" class="w-full text-xs rounded-lg border border-hairline bg-surface p-2.5 text-ink focus:ring-2 focus:ring-emerald-500 font-medium">
          {sfcData.reliefOverpressureSystems.map(rel => (
            <option value={rel.id}>{rel.name}</option>
          ))}
        </select>
        <p class="text-2xs text-muted leading-tight">{d.reliefHelp}</p>
      </div>

      <div class="pt-2 border-t border-hairline space-y-4">
        <!-- Backpressure Slider -->
        <div class="space-y-1">
          <div class="flex justify-between items-center text-xs">
            <label for="sfc-pressure" class="font-bold text-ink">{d.pressureLabel}</label>
            <span id="sfc-pressure-val" class="font-mono font-bold text-emerald-800">220 bar</span>
          </div>
          <input 
            type="range" 
            id="sfc-pressure" 
            min="100" 
            max="350" 
            step="5" 
            value="220" 
            class="w-full accent-emerald-700 cursor-pointer"
          />
          <p class="text-2xs text-muted">{d.pressureHelp}</p>
        </div>

        <!-- Temperature Slider -->
        <div class="space-y-1">
          <div class="flex justify-between items-center text-xs">
            <label for="sfc-temp" class="font-bold text-ink">{d.tempLabel}</label>
            <span id="sfc-temp-val" class="font-mono font-bold text-emerald-800">45°C</span>
          </div>
          <input 
            type="range" 
            id="sfc-temp" 
            min="32" 
            max="65" 
            step="1" 
            value="45" 
            class="w-full accent-emerald-700 cursor-pointer"
          />
          <p class="text-2xs text-muted">{d.tempHelp}</p>
        </div>

        <!-- Modifier % Slider -->
        <div class="space-y-1">
          <div class="flex justify-between items-center text-xs">
            <label for="sfc-modifier-pct" class="font-bold text-ink">{d.modifierPctLabel}</label>
            <span id="sfc-modifier-pct-val" class="font-mono font-bold text-emerald-800">12%</span>
          </div>
          <input 
            type="range" 
            id="sfc-modifier-pct" 
            min="0" 
            max="30" 
            step="1" 
            value="12" 
            class="w-full accent-emerald-700 cursor-pointer"
          />
          <p class="text-2xs text-muted">{d.modifierPctHelp}</p>
        </div>

        <!-- Total Flow Rate Slider -->
        <div class="space-y-1">
          <div class="flex justify-between items-center text-xs">
            <label for="sfc-flow-rate" class="font-bold text-ink">{d.flowRateLabel}</label>
            <span id="sfc-flow-rate-val" class="font-mono font-bold text-emerald-800">350 mL/min</span>
          </div>
          <input 
            type="range" 
            id="sfc-flow-rate" 
            min="50" 
            max="800" 
            step="25" 
            value="350" 
            class="w-full accent-emerald-700 cursor-pointer"
          />
          <p class="text-2xs text-muted">{d.flowRateHelp}</p>
        </div>
      </div>
    </div>

    <!-- Diagnostic Cards Column (7 cols) -->
    <div class="lg:col-span-7 space-y-6">
      <div class="border-b border-hairline pb-3">
        <h2 class="text-base font-bold text-ink mb-1 flex items-center gap-2">
          <span>📊</span>
          <span>{d.diagnosticTitle}</span>
        </h2>
        <p class="text-xs text-muted">{d.diagnosticSub}</p>
      </div>

      <!-- 6 Metrics Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        <!-- Metric 1: Peak Resolution (Rs) -->
        <div class="bg-surface-soft border border-hairline rounded-xl p-4 flex flex-col justify-between">
          <div class="text-2xs font-bold uppercase tracking-wider text-muted mb-1">{d.resolutionLabel}</div>
          <div id="metric-resolution" class="text-2xl font-mono font-extrabold text-emerald-800">2.15</div>
          <div id="sub-resolution" class="text-2xs text-muted mt-1 font-medium">Baseline Separation (Rs ≥ 1.5)</div>
        </div>

        <!-- Metric 2: Purity (%) -->
        <div class="bg-surface-soft border border-hairline rounded-xl p-4 flex flex-col justify-between">
          <div class="text-2xs font-bold uppercase tracking-wider text-muted mb-1">{d.purityLabel}</div>
          <div id="metric-purity" class="text-2xl font-mono font-extrabold text-emerald-800">99.4%</div>
          <div id="sub-purity" class="text-2xs text-muted mt-1 font-medium">THC &lt; 0.01% (ND)</div>
        </div>

        <!-- Metric 3: Mobile Phase Density -->
        <div class="bg-surface-soft border border-hairline rounded-xl p-4 flex flex-col justify-between">
          <div class="text-2xs font-bold uppercase tracking-wider text-muted mb-1">{d.densityLabel}</div>
          <div id="metric-density" class="text-2xl font-mono font-extrabold text-emerald-800">0.825 g/mL</div>
          <div id="sub-density" class="text-2xs text-muted mt-1 font-medium">Optimal Liquid-Like Solvation</div>
        </div>

        <!-- Metric 4: Pressure Drop ΔP -->
        <div class="bg-surface-soft border border-hairline rounded-xl p-4 flex flex-col justify-between">
          <div class="text-2xs font-bold uppercase tracking-wider text-muted mb-1">{d.deltaPLabel}</div>
          <div id="metric-delta-p" class="text-2xl font-mono font-extrabold text-emerald-800">32.4 bar</div>
          <div id="sub-delta-p" class="text-2xs text-muted mt-1 font-medium">Inlet: 252.4 bar (Well within limits)</div>
        </div>

        <!-- Metric 5: ASME VIII Relief Margin -->
        <div class="bg-surface-soft border border-hairline rounded-xl p-4 flex flex-col justify-between">
          <div class="text-2xs font-bold uppercase tracking-wider text-muted mb-1">{d.reliefMarginLabel}</div>
          <div id="metric-relief-margin" class="text-2xl font-mono font-extrabold text-emerald-800">+97.6 bar</div>
          <div id="sub-relief-margin" class="text-2xs text-muted mt-1 font-medium">Rupture Disc Safe Envelope</div>
        </div>

        <!-- Metric 6: CO2 Recovery Efficiency -->
        <div class="bg-surface-soft border border-hairline rounded-xl p-4 flex flex-col justify-between">
          <div class="text-2xs font-bold uppercase tracking-wider text-muted mb-1">{d.co2RecycleLabel}</div>
          <div id="metric-co2-recycle" class="text-2xl font-mono font-extrabold text-emerald-800">98.5%</div>
          <div id="sub-co2-recycle" class="text-2xs text-muted mt-1 font-medium">Zero-VOC Closed Loop</div>
        </div>
      </div>

      <!-- Real-Time Chromatogram Visualization -->
      <div class="bg-surface-soft border border-hairline rounded-xl p-4 sm:p-5">
        <div class="flex items-center justify-between mb-3">
          <div>
            <h3 class="text-xs font-bold text-ink uppercase tracking-wider font-mono">📈 {d.chromatogramTitle}</h3>
            <p class="text-2xs text-muted">{d.chromatogramSub}</p>
          </div>
          <div class="flex items-center gap-3 text-2xs">
            <span class="flex items-center gap-1 font-medium text-emerald-800">
              <span class="w-3 h-1 bg-emerald-700 rounded-full inline-block"></span> Target Bioactive
            </span>
            <span class="flex items-center gap-1 font-medium text-amber-700">
              <span class="w-3 h-1 bg-amber-600 rounded-full inline-block"></span> Impurity / THC
            </span>
          </div>
        </div>

        <!-- Dynamic SVG Canvas -->
        <div class="w-full overflow-hidden bg-surface border border-hairline rounded-lg p-2">
          <svg id="sfc-chromatogram-svg" viewBox="0 0 600 200" class="w-full h-44 sm:h-52">
            <!-- Grid Lines -->
            <line x1="50" y1="170" x2="570" y2="170" stroke="#cbd5e1" stroke-width="1.5" />
            <line x1="50" y1="20" x2="50" y2="170" stroke="#cbd5e1" stroke-width="1.5" />
            
            <line x1="50" y1="130" x2="570" y2="130" stroke="#f1f5f9" stroke-width="1" stroke-dasharray="3 3" />
            <line x1="50" y1="90" x2="570" y2="90" stroke="#f1f5f9" stroke-width="1" stroke-dasharray="3 3" />
            <line x1="50" y1="50" x2="570" y2="50" stroke="#f1f5f9" stroke-width="1" stroke-dasharray="3 3" />

            <!-- Axis Labels -->
            <text x="310" y="192" font-size="10" fill="#64748b" text-anchor="middle" font-family="monospace">Retention Time t_R (minutes)</text>
            <text x="18" y="100" font-size="10" fill="#64748b" text-anchor="middle" transform="rotate(-90 18 100)" font-family="monospace">Absorbance (mAU)</text>

            <!-- Base Time Markers -->
            <text x="50" y="182" font-size="9" fill="#94a3b8" text-anchor="middle">0m</text>
            <text x="180" y="182" font-size="9" fill="#94a3b8" text-anchor="middle">2m</text>
            <text x="310" y="182" font-size="9" fill="#94a3b8" text-anchor="middle">4m</text>
            <text x="440" y="182" font-size="9" fill="#94a3b8" text-anchor="middle">6m</text>
            <text x="570" y="182" font-size="9" fill="#94a3b8" text-anchor="middle">8m</text>

            <!-- Peak 1 Path (Target Bioactive) -->
            <path id="svg-peak-target" d="M 50,170 Q 180,170 200,165 Q 220,150 240,40 Q 260,150 280,165 Q 300,170 570,170" fill="rgba(16, 185, 129, 0.15)" stroke="#059669" stroke-width="2.5" />

            <!-- Peak 2 Path (Impurity / THC) -->
            <path id="svg-peak-impurity" d="M 50,170 Q 280,170 310,165 Q 330,150 350,55 Q 370,150 390,165 Q 420,170 570,170" fill="rgba(217, 119, 6, 0.15)" stroke="#d97706" stroke-width="2" stroke-dasharray="2 2" />

            <!-- Peak Annotation Tags -->
            <g id="svg-tag-target" transform="translate(240, 30)">
              <rect x="-45" y="-14" width="90" height="16" rx="4" fill="#065f46" />
              <text x="0" y="-3" font-size="9" font-weight="bold" fill="#ffffff" text-anchor="middle" font-family="sans-serif">CBD / Bioactive</text>
            </g>

            <g id="svg-tag-impurity" transform="translate(350, 45)">
              <rect x="-40" y="-14" width="80" height="16" rx="4" fill="#92400e" />
              <text x="0" y="-3" font-size="9" font-weight="bold" fill="#ffffff" text-anchor="middle" font-family="sans-serif">THC / Isomer</text>
            </g>
          </svg>
        </div>
      </div>

      <!-- Compliance & Advisory Cards -->
      <div class="space-y-3">
        <!-- Status Banner -->
        <div class="bg-surface border border-hairline rounded-xl p-4 flex items-center justify-between">
          <span class="text-xs font-bold text-ink uppercase tracking-wider">{d.complianceStatusLabel}:</span>
          <span id="badge-compliance" class="px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800">
            cGMP COMPLIANT &amp; ASME SECTION VIII VERIFIED
          </span>
        </div>

        <!-- Limitation Analysis -->
        <div class="bg-surface border border-hairline rounded-xl p-4">
          <div class="text-2xs font-bold uppercase tracking-wider text-muted mb-1">{d.primaryLimitationLabel}</div>
          <p id="limitation-text" class="text-xs text-ink leading-relaxed font-medium">
            Optimal mobile phase density (0.825 g/mL) and modifier fraction (12% v/v) achieve clean baseline resolution (Rs = 2.15). Residual THC concentration is suppressed below detectable thresholds (&lt;0.01% w/w) meeting 2018 Farm Bill and EU pharmacopeial standards.
          </p>
        </div>

        <!-- Mitigation / Action -->
        <div class="bg-surface border border-hairline rounded-xl p-4">
          <div id="action-label" class="text-2xs font-bold uppercase tracking-wider text-muted mb-1">{d.mitigationActionLabel}</div>
          <p id="mitigation-text" class="text-xs text-ink leading-relaxed font-medium">
            Maintain isothermal oven temperature at 45°C. Periodically verify backpressure regulator diaphragm seal integrity and inspect Coriolis mass flow meter calibration every 500 operating hours.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Deep Scientific Principles Breakdown -->
  <div class="border-t border-hairline pt-8 my-8 space-y-6">
    <div>
      <h2 class="text-lg font-bold text-ink mb-1 flex items-center gap-2">
        <span>🔬</span>
        <span>{d.scienceTitle}</span>
      </h2>
      <p class="text-xs text-muted">{d.scienceSub}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 text-xs">
      <div class="bg-surface-soft border border-hairline rounded-xl p-4">
        <h3 class="font-bold text-ink mb-2 text-xs flex items-center gap-1.5">
          <span class="text-emerald-700">1.</span> Peng-Robinson Fluid Density
        </h3>
        <p class="text-muted leading-relaxed">
          Near the critical point (Tc = 31.1°C, Pc = 73.8 bar), supercritical CO2 exhibits liquid-like density (0.65–0.92 g/mL) combined with gas-like diffusivity and low viscosity. Small adjustments in backpressure or temperature produce profound shifts in solvating power, allowing fine-tuned selectivity without hazardous chlorinated solvents.
        </p>
      </div>

      <div class="bg-surface-soft border border-hairline rounded-xl p-4">
        <h3 class="font-bold text-ink mb-2 text-xs flex items-center gap-1.5">
          <span class="text-emerald-700">2.</span> Van Deemter Mass Transfer
        </h3>
        <p class="text-muted leading-relaxed">
          Because binary diffusion coefficients in supercritical fluids are 10-fold higher than in liquid chromatography (D_12 ~ 10^-4 cm^2/s), the resistance to mass transfer in mobile and stationary phases (C-term) is drastically diminished. This allows 3x to 5x higher linear velocities (u) with minimal plate height loss.
        </p>
      </div>

      <div class="bg-surface-soft border border-hairline rounded-xl p-4">
        <h3 class="font-bold text-ink mb-2 text-xs flex items-center gap-1.5">
          <span class="text-emerald-700">3.</span> Co-Solvent Polarity Control
        </h3>
        <p class="text-muted leading-relaxed">
          Adding food-grade anhydrous ethanol (5% to 25% v/v) modulates the dielectric constant of the mobile phase. Ethanol dynamically deactivates silanol sites on bonded silica stationary phases (such as 2-ethylpyridine or diol), accelerating elution of poly-hydroxylated cannabinoids and polar carotenoid isomers.
        </p>
      </div>

      <div class="bg-surface-soft border border-hairline rounded-xl p-4">
        <h3 class="font-bold text-ink mb-2 text-xs flex items-center gap-1.5">
          <span class="text-emerald-700">4.</span> ASME Section VIII Safety Sizing
        </h3>
        <p class="text-muted leading-relaxed">
          Operating at 200–350 bar mandates strict adherence to ASME Boiler and Pressure Vessel Code (BPVC) Section VIII. Dual Inconel rupture discs backed by sanitary high-flow safety relief valves prevent catastrophic vessel failure during bed compaction, while closed-loop cyclonic flash chambers recover >98% of CO2 gas.
        </p>
      </div>
    </div>
  </div>

  <!-- Engineering Data Specifications Table -->
  <div class="border-t border-hairline pt-8 space-y-4">
    <h2 class="text-base font-bold text-ink flex items-center gap-2">
      <span>📋</span>
      <span>{d.tableTitle}</span>
    </h2>

    <div class="overflow-x-auto border border-hairline rounded-xl bg-surface">
      <table class="w-full text-left border-collapse text-xs">
        <thead>
          <tr class="bg-surface-soft border-b border-hairline font-bold text-ink">
            <th class="p-3">SFC Hardware Assembly</th>
            <th class="p-3">Stationary Phase</th>
            <th class="p-3">Max Pressure (bar)</th>
            <th class="p-3">Max Flow Rate</th>
            <th class="p-3">CO2 Recovery (%)</th>
            <th class="p-3">Sanitary Certification</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline text-muted">
          {sfcData.sfcSystems.map(sys => (
            <tr class="hover:bg-surface-soft/50 transition-colors">
              <td class="p-3 font-semibold text-ink">{sys.name}</td>
              <td class="p-3">{sys.stationaryPhase}</td>
              <td class="p-3 font-mono">{sys.maxPressureBar} bar</td>
              <td class="p-3 font-mono">{sys.maxFlowRateMlPerMin} mL/min</td>
              <td class="p-3 font-mono text-emerald-800 font-bold">{sys.co2RecycleEfficiencyPercent}%</td>
              <td class="p-3 text-2xs">{sys.classification}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  // Client-side real-time calculation and SVG chromatogram animation engine
  document.addEventListener('DOMContentLoaded', () => {
    // Systems & Feedstock datasets
    const sfcSystems = {
      preparative_multi_column_sfc_skid: {
        maxPressureBar: 350.0,
        columnDiameterMm: 50.0,
        columnLengthMm: 250.0,
        numberOfColumns: 4,
        particleSizeMicrons: 5.0,
        co2RecyclePercent: 98.5,
        bprStability: 0.5,
        basePlates: 12500,
        darcyPermeability: 1.2e-13
      },
      simulated_moving_bed_smb_sfc_skid: {
        maxPressureBar: 300.0,
        columnDiameterMm: 30.0,
        columnLengthMm: 150.0,
        numberOfColumns: 8,
        particleSizeMicrons: 7.0,
        co2RecyclePercent: 99.2,
        bprStability: 0.3,
        basePlates: 16000,
        darcyPermeability: 2.1e-13
      },
      pilot_high_pressure_fractionation_skid: {
        maxPressureBar: 280.0,
        columnDiameterMm: 20.0,
        columnLengthMm: 250.0,
        numberOfColumns: 2,
        particleSizeMicrons: 5.0,
        co2RecyclePercent: 96.0,
        bprStability: 0.8,
        basePlates: 10500,
        darcyPermeability: 1.1e-13
      },
      compromised_channeling_overpressure_column: {
        maxPressureBar: 380.0,
        columnDiameterMm: 50.0,
        columnLengthMm: 250.0,
        numberOfColumns: 1,
        particleSizeMicrons: 10.0,
        co2RecyclePercent: 74.0,
        bprStability: 8.5,
        basePlates: 1200,
        darcyPermeability: 0.3e-13
      }
    };

    const feedstockData = {
      broad_spectrum_cannabinoid_extract: {
        selectivityAlpha: 1.48,
        targetRetentionK: 2.85,
        viscosityCp: 4.5,
        targetName: 'CBD / CBG',
        impurityName: 'Δ9-THC (<0.01%)'
      },
      marine_astaxanthin_carotenoid_extract: {
        selectivityAlpha: 1.62,
        targetRetentionK: 3.40,
        viscosityCp: 3.8,
        targetName: 'All-Trans Astaxanthin',
        impurityName: '13-Cis Isomer'
      },
      marine_omega3_ethyl_ester_oil: {
        selectivityAlpha: 1.38,
        targetRetentionK: 4.10,
        viscosityCp: 2.2,
        targetName: 'EPA Ethyl Ester',
        impurityName: 'DHA / C16 Esters'
      },
      unwinterized_crude_waxy_resin: {
        selectivityAlpha: 1.08,
        targetRetentionK: 1.85,
        viscosityCp: 14.5,
        targetName: 'Crude Botanical',
        impurityName: 'Cuticular Waxes'
      }
    };

    const modifierData = {
      usp_food_grade_anhydrous_ethanol: {
        density: 0.789,
        viscosity: 1.20,
        waterPct: 0.15,
        elutionPower: 1.0
      },
      pharma_grade_isopropanol_modifier: {
        density: 0.785,
        viscosity: 2.04,
        waterPct: 0.10,
        elutionPower: 0.92
      },
      supercritical_co2_neat_zero_solvent: {
        density: 0.820,
        viscosity: 0.065,
        waterPct: 0.001,
        elutionPower: 0.45
      },
      hydrated_recycled_ethanol_contaminated: {
        density: 0.815,
        viscosity: 1.85,
        waterPct: 8.50,
        elutionPower: 1.15
      }
    };

    const reliefData = {
      dual_inconel_rupture_disc_bpv_skid: {
        burstPressureBar: 350.0,
        status: 'OPTIMAL'
      },
      pilot_operated_proportional_relief_valve: {
        burstPressureBar: 320.0,
        status: 'OPTIMAL'
      },
      corroded_blocked_relief_vent_assembly: {
        burstPressureBar: 440.0,
        status: 'HAZARDOUS'
      }
    };

    // DOM Elements
    const selSystem = document.getElementById('sfc-system');
    const selFeedstock = document.getElementById('sfc-feedstock');
    const selModifier = document.getElementById('sfc-modifier');
    const selRelief = document.getElementById('sfc-relief');

    const sliderPressure = document.getElementById('sfc-pressure');
    const sliderTemp = document.getElementById('sfc-temp');
    const sliderModifierPct = document.getElementById('sfc-modifier-pct');
    const sliderFlowRate = document.getElementById('sfc-flow-rate');

    const valPressure = document.getElementById('sfc-pressure-val');
    const valTemp = document.getElementById('sfc-temp-val');
    const valModifierPct = document.getElementById('sfc-modifier-pct-val');
    const valFlowRate = document.getElementById('sfc-flow-rate-val');

    // Diagnostic metrics
    const metricResolution = document.getElementById('metric-resolution');
    const subResolution = document.getElementById('sub-resolution');
    const metricPurity = document.getElementById('metric-purity');
    const subPurity = document.getElementById('sub-purity');
    const metricDensity = document.getElementById('metric-density');
    const subDensity = document.getElementById('sub-density');
    const metricDeltaP = document.getElementById('metric-delta-p');
    const subDeltaP = document.getElementById('sub-delta-p');
    const metricReliefMargin = document.getElementById('metric-relief-margin');
    const subReliefMargin = document.getElementById('sub-relief-margin');
    const metricCo2Recycle = document.getElementById('metric-co2-recycle');
    const subCo2Recycle = document.getElementById('sub-co2-recycle');

    const badgeCompliance = document.getElementById('badge-compliance');
    const limitationText = document.getElementById('limitation-text');
    const mitigationText = document.getElementById('mitigation-text');
    const actionLabel = document.getElementById('action-label');

    // SVG Elements
    const svgPeakTarget = document.getElementById('svg-peak-target');
    const svgPeakImpurity = document.getElementById('svg-peak-impurity');
    const svgTagTarget = document.getElementById('svg-tag-target');
    const svgTagImpurity = document.getElementById('svg-tag-impurity');

    // Preset buttons
    const btnCannabinoid = document.getElementById('sfc-preset-cannabinoid');
    const btnAstaxanthin = document.getElementById('sfc-preset-astaxanthin');
    const btnOmega3 = document.getElementById('sfc-preset-omega3');
    const btnPolyphenol = document.getElementById('sfc-preset-polyphenol');
    const btnHazard = document.getElementById('sfc-preset-hazard');

    function calculateDiagnostics() {
      const sysId = selSystem ? selSystem.value : 'preparative_multi_column_sfc_skid';
      const feedId = selFeedstock ? selFeedstock.value : 'broad_spectrum_cannabinoid_extract';
      const modId = selModifier ? selModifier.value : 'usp_food_grade_anhydrous_ethanol';
      const reliefId = selRelief ? selRelief.value : 'dual_inconel_rupture_disc_bpv_skid';

      const sys = sfcSystems[sysId] || sfcSystems.preparative_multi_column_sfc_skid;
      const feed = feedstockData[feedId] || feedstockData.broad_spectrum_cannabinoid_extract;
      const mod = modifierData[modId] || modifierData.usp_food_grade_anhydrous_ethanol;
      const rel = reliefData[reliefId] || reliefData.dual_inconel_rupture_disc_bpv_skid;

      const pressureBar = parseFloat(sliderPressure.value);
      const tempC = parseFloat(sliderTemp.value);
      const modifierPct = parseFloat(sliderModifierPct.value);
      const flowRateMlMin = parseFloat(sliderFlowRate.value);

      // Update Slider Value Displays
      if (valPressure) valPressure.textContent = `${pressureBar} bar`;
      if (valTemp) valTemp.textContent = `${tempC}°C`;
      if (valModifierPct) valModifierPct.textContent = `${modifierPct}%`;
      if (valFlowRate) valFlowRate.textContent = `${flowRateMlMin} mL/min`;

      // 1. Supercritical Fluid Density Estimation (Peng-Robinson EOS approximation)
      // Pure CO2 density in g/mL at (P, T)
      // At 40°C, 100 bar -> ~0.63 g/mL; 200 bar -> ~0.84 g/mL; 300 bar -> ~0.91 g/mL
      const tempK = tempC + 273.15;
      const co2DensityBase = 0.468 + (0.00185 * pressureBar) - (0.0031 * (tempC - 31.1));
      const co2Density = Math.max(0.45, Math.min(0.98, co2DensityBase));
      // Mixture Density accounting for organic modifier fraction
      const modFrac = modifierPct / 100.0;
      const mixDensity = ((1.0 - modFrac) * co2Density) + (modFrac * mod.density);

      // 2. Linear Interstitial Velocity & Column Pressure Drop (Darcy)
      // Column cross section in cm2
      const radiusCm = (sys.columnDiameterMm / 10.0) / 2.0;
      const colAreaCm2 = Math.PI * radiusCm * radiusCm;
      const totalColLengthCm = (sys.columnLengthMm / 10.0) * sys.numberOfColumns;
      // Flow rate in cm3/s
      const flowCm3Sec = flowRateMlMin / 60.0;
      const linearVelocityCmSec = flowCm3Sec / (colAreaCm2 * 0.65); // 0.65 bed porosity
      
      // Fluid viscosity mixture (cP to Pa.s: 1 cP = 1e-3 Pa.s)
      const co2ViscosityCp = 0.055 + (0.00012 * pressureBar);
      const mixViscosityCp = ((1.0 - modFrac) * co2ViscosityCp) + (modFrac * mod.viscosity);
      const viscosityPaS = mixViscosityCp * 1e-3;

      // Darcy Pressure Drop ΔP (bar): ΔP = (u * η * L) / K
      const dpMeters = (sys.particleSizeMicrons * 1e-6);
      let permeability = (dpMeters * dpMeters * 0.65 * 0.65 * 0.65) / (180 * (1 - 0.65) * (1 - 0.65));
      if (sysId === 'compromised_channeling_overpressure_column') {
        permeability = permeability * 0.25; // compacted / plugged bed
      }
      if (feedId === 'unwinterized_crude_waxy_resin') {
        permeability = permeability * 0.40; // wax plugging
      }

      const velocityMSec = linearVelocityCmSec * 1e-2;
      const lengthMeters = totalColLengthCm * 1e-2;
      const deltaPPa = (velocityMSec * viscosityPaS * lengthMeters) / permeability;
      const deltaPBar = Math.max(2.5, Math.min(180.0, deltaPPa / 1e5));
      const inletPressureBar = pressureBar + deltaPBar;

      // 3. Van Deemter Plate Count & Resolution (Purnell Equation)
      // Plates N:
      let plates = sys.basePlates;
      if (linearVelocityCmSec > 1.2) {
        plates = plates * (1.2 / linearVelocityCmSec);
      }
      if (mod.waterPct > 5.0) {
        plates = plates * 0.35; // water strips stationary phase
      }
      if (feedId === 'unwinterized_crude_waxy_resin') {
        plates = plates * 0.45;
      }
      plates = Math.max(300, Math.round(plates));

      // Retention factors k1 and k2
      // As density increases and modifier% increases, k decreases
      const elutionFactor = Math.pow(0.80 / mixDensity, 2.2) * (1.0 / (1.0 + (modFrac * 4.5 * mod.elutionPower)));
      const k1 = Math.max(0.3, feed.targetRetentionK * elutionFactor);
      const k2 = k1 * feed.selectivityAlpha;

      // Purnell Resolution Rs: Rs = (sqrt(N) / 4) * ((alpha - 1) / alpha) * (k2 / (1 + k2))
      const alpha = feed.selectivityAlpha;
      let Rs = (Math.sqrt(plates) / 4.0) * ((alpha - 1.0) / alpha) * (k2 / (1.0 + k2));
      if (sysId === 'compromised_channeling_overpressure_column') {
        Rs = Rs * 0.22; // severe channeling broadens peaks
      }
      Rs = Math.max(0.15, Rs);

      // Target Purity (%)
      let purity = 99.8;
      if (Rs >= 1.5) {
        purity = Math.min(99.9, 98.5 + (Rs - 1.5) * 0.7);
      } else if (Rs >= 1.0) {
        purity = 92.0 + (Rs - 1.0) * 12.0;
      } else {
        purity = Math.max(52.0, 60.0 + Rs * 30.0);
      }
      if (feedId === 'unwinterized_crude_waxy_resin') purity = Math.min(purity, 78.5);
      if (modId === 'hydrated_recycled_ethanol_contaminated') purity = Math.min(purity, 82.0);

      // ASME Section VIII Overpressure Relief Margin
      const reliefLimitBar = rel.burstPressureBar;
      const reliefMarginBar = reliefLimitBar - inletPressureBar;

      // CO2 Recovery Efficiency
      let co2Recovery = sys.co2RecyclePercent;
      if (pressureBar > 300) co2Recovery = Math.min(99.8, co2Recovery + 0.3);
      if (sysId === 'compromised_channeling_overpressure_column') co2Recovery = 72.5;

      // Render Metrics
      if (metricResolution) {
        metricResolution.textContent = Rs.toFixed(2);
        if (Rs >= 1.5) {
          metricResolution.className = 'text-2xl font-mono font-extrabold text-emerald-800';
          subResolution.textContent = 'Baseline Separation (Rs ≥ 1.5)';
        } else if (Rs >= 1.0) {
          metricResolution.textContent = Rs.toFixed(2);
          metricResolution.className = 'text-2xl font-mono font-extrabold text-amber-700';
          subResolution.textContent = 'Partial Overlap (1.0 ≤ Rs < 1.5)';
        } else {
          metricResolution.className = 'text-2xl font-mono font-extrabold text-red-600';
          subResolution.textContent = 'Critical Co-Elution (Rs < 1.0)';
        }
      }

      if (metricPurity) {
        metricPurity.textContent = `${purity.toFixed(1)}%`;
        if (purity >= 98.0) {
          metricPurity.className = 'text-2xl font-mono font-extrabold text-emerald-800';
          subPurity.textContent = 'THC < 0.01% (ND) • Pharma Grade';
        } else if (purity >= 90.0) {
          metricPurity.className = 'text-2xl font-mono font-extrabold text-amber-700';
          subPurity.textContent = 'THC ~ 0.15% • Food Grade Minimum';
        } else {
          metricPurity.className = 'text-2xl font-mono font-extrabold text-red-600';
          subPurity.textContent = 'NON-COMPLIANT • High Residual Impurity';
        }
      }

      if (metricDensity) {
        metricDensity.textContent = `${mixDensity.toFixed(3)} g/mL`;
        subDensity.textContent = mixDensity > 0.80 ? 'Optimal Liquid-Like Solvation' : 'Low Solvation (Increase Bar)';
      }

      if (metricDeltaP) {
        metricDeltaP.textContent = `${deltaPBar.toFixed(1)} bar`;
        subDeltaP.textContent = `Inlet: ${inletPressureBar.toFixed(1)} bar (Limit: ${sys.maxPressureBar} bar)`;
        if (inletPressureBar > sys.maxPressureBar) {
          metricDeltaP.className = 'text-2xl font-mono font-extrabold text-red-600';
        } else {
          metricDeltaP.className = 'text-2xl font-mono font-extrabold text-emerald-800';
        }
      }

      if (metricReliefMargin) {
        metricReliefMargin.textContent = `${reliefMarginBar >= 0 ? '+' : ''}${reliefMarginBar.toFixed(1)} bar`;
        if (reliefMarginBar > 50.0) {
          metricReliefMargin.className = 'text-2xl font-mono font-extrabold text-emerald-800';
          subReliefMargin.textContent = 'Safe ASME Working Envelope';
        } else if (reliefMarginBar > 0) {
          metricReliefMargin.className = 'text-2xl font-mono font-extrabold text-amber-700';
          subReliefMargin.textContent = 'Approaching Rupture Disc Threshold';
        } else {
          metricReliefMargin.className = 'text-2xl font-mono font-extrabold text-red-600';
          subReliefMargin.textContent = 'OVERPRESSURE SURGE / BURST DISK ACTIVATED';
        }
      }

      if (metricCo2Recycle) {
        metricCo2Recycle.textContent = `${co2Recovery.toFixed(1)}%`;
        subCo2Recycle.textContent = co2Recovery >= 95.0 ? 'Zero-VOC Closed Loop Recovery' : 'High Solvent Loss / Off-Gas';
      }

      // Update SVG Chromatogram
      // Retention times in minutes
      const t0 = (colAreaCm2 * totalColLengthCm * 0.65) / flowRateMlMin;
      const tR1 = t0 * (1 + k1);
      const tR2 = t0 * (1 + k2);

      // Map time (0 to 8 min) to SVG x coordinate (50 to 570)
      const scaleX = (valMin) => 50 + (valMin / 8.0) * 520;
      const x1 = Math.max(80, Math.min(520, scaleX(tR1)));
      const x2 = Math.max(100, Math.min(540, scaleX(tR2)));

      // Peak widths based on plate count N: W = 4 * tR / sqrt(N)
      const w1 = Math.max(15, (4 * tR1 / Math.sqrt(plates)) * 65);
      const w2 = Math.max(18, (4 * tR2 / Math.sqrt(plates)) * 65);

      const h1 = Math.min(140, Math.max(30, 110 - (w1 * 0.5)));
      const h2 = Math.min(125, Math.max(25, 95 - (w2 * 0.5)));

      // Generate smooth Gaussian-like paths
      const yBase = 170;
      const yPeak1 = yBase - h1;
      const yPeak2 = yBase - h2;

      if (svgPeakTarget) {
        const d1 = `M 50,${yBase} L ${Math.max(50, x1 - w1 * 1.8)},${yBase} Q ${x1 - w1 * 0.5},${yBase} ${x1},${yPeak1} Q ${x1 + w1 * 0.5},${yBase} ${Math.min(570, x1 + w1 * 1.8)},${yBase} L 570,${yBase}`;
        svgPeakTarget.setAttribute('d', d1);
      }

      if (svgPeakImpurity) {
        const d2 = `M 50,${yBase} L ${Math.max(50, x2 - w2 * 1.8)},${yBase} Q ${x2 - w2 * 0.5},${yBase} ${x2},${yPeak2} Q ${x2 + w2 * 0.5},${yBase} ${Math.min(570, x2 + w2 * 1.8)},${yBase} L 570,${yBase}`;
        svgPeakImpurity.setAttribute('d', d2);
      }

      if (svgTagTarget) {
        svgTagTarget.setAttribute('transform', `translate(${x1}, ${yPeak1 - 10})`);
      }
      if (svgTagImpurity) {
        svgTagImpurity.setAttribute('transform', `translate(${x2}, ${yPeak2 - 10})`);
      }

      // Compliance & Engineering Advisory Logic
      if (reliefMarginBar <= 0 || inletPressureBar > sys.maxPressureBar || rel.status === 'HAZARDOUS' || sysId === 'compromised_channeling_overpressure_column') {
        badgeCompliance.textContent = 'ASME BPVC HAZARD: PRESSURE EXCURSION / RELIEF RISK';
        badgeCompliance.className = 'px-3 py-1 rounded-full text-xs font-bold bg-red-100 text-red-800';
        limitationText.textContent = `Severe overpressure excursion: Column inlet pressure (${inletPressureBar.toFixed(1)} bar) exceeds vessel MAWP or approaches rupture limit. Risk of catastrophic PEEK gasket extrusion or vessel failure under ASME Section VIII.`;
        if (actionLabel) actionLabel.textContent = 'Emergency Process Action';
        mitigationText.textContent = 'Initiate automated BPR slow-vent bleed, halt high-pressure CO2 booster pumps, replace extruded end-fitting seals, and verify rupture disc inter-space pressure sensors.';
      } else if (Rs < 1.5) {
        badgeCompliance.textContent = 'SUB-OPTIMAL SEPARATION: INCOMPLETE BASELINE RESOLUTION';
        badgeCompliance.className = 'px-3 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-800';
        limitationText.textContent = `Resolution deficit: Chromatographic peak resolution (Rs = ${Rs.toFixed(2)}) is below baseline standard (1.50). Co-elution of target bioactive and impurity reduces product recovery purity to ${purity.toFixed(1)}%.`;
        if (actionLabel) actionLabel.textContent = 'Process Optimization Action';
        mitigationText.textContent = 'Decrease modifier co-solvent percentage (lower elution strength to sharpen selectivity), or reduce volumetric flow rate to lower mobile phase linear velocity.';
      } else {
        badgeCompliance.textContent = 'cGMP COMPLIANT & ASME SECTION VIII VERIFIED';
        badgeCompliance.className = 'px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800';
        limitationText.textContent = `Validated baseline resolution achieved (Rs = ${Rs.toFixed(2)} ≥ 1.5). Purity is maintained at ${purity.toFixed(1)}% with residual impurity/THC below detection limits (<0.01% w/w). Mobile phase density (${mixDensity.toFixed(3)} g/mL) provides high solubility.`;
        if (actionLabel) actionLabel.textContent = 'Recommended Continuous Operation';
        mitigationText.textContent = 'Maintain steady-state backpressure regulation, monitor Coriolis CO2 mass flow meter stability, and cycle automated multi-column carousel valves according to optimized retention windows.';
      }
    }

    // Attach Event Listeners
    [selSystem, selFeedstock, selModifier, selRelief].forEach(el => {
      if (el) el.addEventListener('change', calculateDiagnostics);
    });

    [sliderPressure, sliderTemp, sliderModifierPct, sliderFlowRate].forEach(sl => {
      if (sl) sl.addEventListener('input', calculateDiagnostics);
    });

    // Preset Handlers
    if (btnCannabinoid) {
      btnCannabinoid.addEventListener('click', () => {
        selSystem.value = 'preparative_multi_column_sfc_skid';
        selFeedstock.value = 'broad_spectrum_cannabinoid_extract';
        selModifier.value = 'usp_food_grade_anhydrous_ethanol';
        selRelief.value = 'dual_inconel_rupture_disc_bpv_skid';
        sliderPressure.value = '220';
        sliderTemp.value = '45';
        sliderModifierPct.value = '12';
        sliderFlowRate.value = '350';
        calculateDiagnostics();
      });
    }

    if (btnAstaxanthin) {
      btnAstaxanthin.addEventListener('click', () => {
        selSystem.value = 'simulated_moving_bed_smb_sfc_skid';
        selFeedstock.value = 'marine_astaxanthin_carotenoid_extract';
        selModifier.value = 'usp_food_grade_anhydrous_ethanol';
        selRelief.value = 'dual_inconel_rupture_disc_bpv_skid';
        sliderPressure.value = '260';
        sliderTemp.value = '40';
        sliderModifierPct.value = '8';
        sliderFlowRate.value = '280';
        calculateDiagnostics();
      });
    }

    if (btnOmega3) {
      btnOmega3.addEventListener('click', () => {
        selSystem.value = 'pilot_high_pressure_fractionation_skid';
        selFeedstock.value = 'marine_omega3_ethyl_ester_oil';
        selModifier.value = 'supercritical_co2_neat_zero_solvent';
        selRelief.value = 'pilot_operated_proportional_relief_valve';
        sliderPressure.value = '180';
        sliderTemp.value = '50';
        sliderModifierPct.value = '0';
        sliderFlowRate.value = '180';
        calculateDiagnostics();
      });
    }

    if (btnPolyphenol) {
      btnPolyphenol.addEventListener('click', () => {
        selSystem.value = 'preparative_multi_column_sfc_skid';
        selFeedstock.value = 'broad_spectrum_cannabinoid_extract';
        selModifier.value = 'usp_food_grade_anhydrous_ethanol';
        selRelief.value = 'dual_inconel_rupture_disc_bpv_skid';
        sliderPressure.value = '280';
        sliderTemp.value = '42';
        sliderModifierPct.value = '20';
        sliderFlowRate.value = '500';
        calculateDiagnostics();
      });
    }

    if (btnHazard) {
      btnHazard.addEventListener('click', () => {
        selSystem.value = 'compromised_channeling_overpressure_column';
        selFeedstock.value = 'unwinterized_crude_waxy_resin';
        selModifier.value = 'hydrated_recycled_ethanol_contaminated';
        selRelief.value = 'corroded_blocked_relief_vent_assembly';
        sliderPressure.value = '340';
        sliderTemp.value = '35';
        sliderModifierPct.value = '25';
        sliderFlowRate.value = '750';
        calculateDiagnostics();
      });
    }

    // Run Initial Calculation
    calculateDiagnostics();
  });
</script>