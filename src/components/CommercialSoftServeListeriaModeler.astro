};

const d = DICTIONARY[lang] || DICTIONARY.en;
---

<div id="soft-serve-listeria-modeler-root" class="w-full">
  <!-- Operational Presets -->
  <div class="mb-10 bg-surface-soft/60 border border-hairline/70 rounded-2xl p-5 md:p-6">
    <div class="text-xs font-bold text-muted uppercase tracking-wider mb-3">
      {d.presetsTitle}
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
      <button 
        type="button" 
        data-preset="gold-standard" 
        class="preset-btn text-left p-3.5 rounded-xl border border-hairline bg-surface hover:border-emerald-600/50 hover:bg-emerald-600/5 transition-all text-xs font-medium text-ink flex flex-col justify-between gap-2 shadow-2xs"
      >
        <span class="font-bold text-emerald-700 dark:text-emerald-400">🏆 {lang === 'zh-cn' ? 'FDA A级黄金杀菌标准' : lang === 'ja' ? 'FDA基準適合ゴールド' : 'FDA Grade A Master'}</span>
        <span class="text-muted leading-tight">{d.presetFdaGoldStandard}</span>
      </button>

      <button 
        type="button" 
        data-preset="tacoma-outbreak" 
        class="preset-btn text-left p-3.5 rounded-xl border border-hairline bg-surface hover:border-red-600/50 hover:bg-red-600/5 transition-all text-xs font-medium text-ink flex flex-col justify-between gap-2 shadow-2xs"
      >
        <span class="font-bold text-red-600 dark:text-red-400">⚠️ {lang === 'zh-cn' ? '塔科马重度疫情模式' : lang === 'ja' ? 'タコマ感染症致死モデル' : 'Tacoma Outbreak Profile'}</span>
        <span class="text-muted leading-tight">{d.presetTacomaOutbreak}</span>
      </button>

      <button 
        type="button" 
        data-preset="summer-condenser" 
        class="preset-btn text-left p-3.5 rounded-xl border border-hairline bg-surface hover:border-amber-600/50 hover:bg-amber-600/5 transition-all text-xs font-medium text-ink flex flex-col justify-between gap-2 shadow-2xs"
      >
        <span class="font-bold text-amber-700 dark:text-amber-400">☀️ {lang === 'zh-cn' ? '酷暑冷凝器积尘窒息' : lang === 'ja' ? '酷暑凝縮器目詰まり遅延' : 'Choked Condenser Summer'}</span>
        <span class="text-muted leading-tight">{d.presetChokedCondenserSummer}</span>
      </button>

      <button 
        type="button" 
        data-preset="hospital-stagnant" 
        class="preset-btn text-left p-3.5 rounded-xl border border-hairline bg-surface hover:border-purple-600/50 hover:bg-purple-600/5 transition-all text-xs font-medium text-ink flex flex-col justify-between gap-2 shadow-2xs"
      >
        <span class="font-bold text-purple-600 dark:text-purple-400">🏥 {lang === 'zh-cn' ? '医院奶浆滞留高危' : lang === 'ja' ? '病院72時間原料停滞' : 'Healthcare Stagnant Mix'}</span>
        <span class="text-muted leading-tight">{d.presetHospitalStagnantMix}</span>
      </button>
    </div>
  </div>

  <!-- Interactive Controls Form -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-10">
    <!-- Left Configuration Panel (7 Cols) -->
    <div class="lg:col-span-7 space-y-6">
      <div class="border-b border-hairline pb-2">
        <h3 class="text-base font-bold text-ink tracking-tight">{d.controlsTitle}</h3>
        <p class="text-xs text-muted">{d.controlsSub}</p>
      </div>

      <!-- 1. Freezer Architecture -->
      <div>
        <label for="machine-config" class="block text-xs font-bold uppercase tracking-wider text-muted mb-1.5">
          {d.machineLabel}
        </label>
        <select id="machine-config" class="w-full text-xs font-medium bg-surface border border-hairline rounded-xl px-3.5 py-2.5 text-ink focus:outline-none focus:ring-2 focus:ring-amber-600/50">
          {softServeData.machineConfigurations.map(cfg => (
            <option value={cfg.id} selected={cfg.id === 'heat_treatment_multi_flavor'}>
              {cfg.name}
            </option>
          ))}
        </select>
        <p class="text-xs text-muted mt-1 leading-normal">{d.machineHelp}</p>
      </div>

      <!-- 2. Overnight Pasteurization Profile -->
      <div>
        <label for="pasteurization-phase" class="block text-xs font-bold uppercase tracking-wider text-muted mb-1.5">
          {d.phaseLabel}
        </label>
        <select id="pasteurization-phase" class="w-full text-xs font-medium bg-surface border border-hairline rounded-xl px-3.5 py-2.5 text-ink focus:outline-none focus:ring-2 focus:ring-amber-600/50">
          {softServeData.pasteurizationCyclePhases.map(ph => (
            <option value={ph.id} selected={ph.id === 'optimal_fda_pasteurization'}>
              {ph.name}
            </option>
          ))}
        </select>
        <p class="text-xs text-muted mt-1 leading-normal">{d.phaseHelp}</p>
      </div>

      <!-- 3. Cylinder & Scraper Wear Level -->
      <div>
        <label for="wear-level" class="block text-xs font-bold uppercase tracking-wider text-muted mb-1.5">
          {d.wearLabel}
        </label>
        <select id="wear-level" class="w-full text-xs font-medium bg-surface border border-hairline rounded-xl px-3.5 py-2.5 text-ink focus:outline-none focus:ring-2 focus:ring-amber-600/50">
          {softServeData.biofilmAndComponentWearLevels.map(w => (
            <option value={w.id} selected={w.id === 'routine_wear_3_months'}>
              {w.name}
            </option>
          ))}
        </select>
        <p class="text-xs text-muted mt-1 leading-normal">{d.wearHelp}</p>
      </div>

      <!-- 4. CIP Chemical Protocol -->
      <div>
        <label for="cleaning-regimen" class="block text-xs font-bold uppercase tracking-wider text-muted mb-1.5">
          {d.cleaningLabel}
        </label>
        <select id="cleaning-regimen" class="w-full text-xs font-medium bg-surface border border-hairline rounded-xl px-3.5 py-2.5 text-ink focus:outline-none focus:ring-2 focus:ring-amber-600/50">
          {softServeData.cleaningAndSanitizerRegimens.map(c => (
            <option value={c.id} selected={c.id === 'full_cip_chlorine_protocol'}>
              {c.name}
            </option>
          ))}
        </select>
        <p class="text-xs text-muted mt-1 leading-normal">{d.cleaningHelp}</p>
      </div>

      <!-- 5. Duty Cycle & Formulation -->
      <div>
        <label for="duty-cycle" class="block text-xs font-bold uppercase tracking-wider text-muted mb-1.5">
          {d.dutyLabel}
        </label>
        <select id="duty-cycle" class="w-full text-xs font-medium bg-surface border border-hairline rounded-xl px-3.5 py-2.5 text-ink focus:outline-none focus:ring-2 focus:ring-amber-600/50">
          {softServeData.dairyMixAndDutyCycles.map(dc => (
            <option value={dc.id} selected={dc.id === 'high_volume_quick_service'}>
              {dc.name}
            </option>
          ))}
        </select>
        <p class="text-xs text-muted mt-1 leading-normal">{d.dutyHelp}</p>
      </div>

      <!-- Sliders -->
      <div class="space-y-4 pt-2">
        <!-- Slider 1: Peak Pasteurization Temp -->
        <div>
          <div class="flex justify-between items-center mb-1">
            <label for="temp-slider" class="text-xs font-bold uppercase tracking-wider text-muted">
              {d.tempSliderLabel}
            </label>
            <span id="temp-val" class="font-mono text-xs font-bold text-amber-700 dark:text-amber-400">
              66.7°C (152°F)
            </span>
          </div>
          <input 
            type="range" 
            id="temp-slider" 
            min="50" 
            max="75" 
            step="0.5" 
            value="66.7" 
            class="w-full h-2 bg-surface-soft border border-hairline rounded-lg appearance-none cursor-pointer accent-amber-600"
          />
          <p class="text-xs text-muted mt-0.5">{d.tempSliderHelp}</p>
        </div>

        <!-- Slider 2: Cooling Pull-Down Duration -->
        <div>
          <div class="flex justify-between items-center mb-1">
            <label for="pulldown-slider" class="text-xs font-bold uppercase tracking-wider text-muted">
              {d.pullDownSliderLabel}
            </label>
            <span id="pulldown-val" class="font-mono text-xs font-bold text-amber-700 dark:text-amber-400">
              85 min
            </span>
          </div>
          <input 
            type="range" 
            id="pulldown-slider" 
            min="30" 
            max="360" 
            step="5" 
            value="85" 
            class="w-full h-2 bg-surface-soft border border-hairline rounded-lg appearance-none cursor-pointer accent-amber-600"
          />
          <p class="text-xs text-muted mt-0.5">{d.pullDownSliderHelp}</p>
        </div>

        <!-- Slider 3: Days Since Teardown -->
        <div>
          <div class="flex justify-between items-center mb-1">
            <label for="teardown-slider" class="text-xs font-bold uppercase tracking-wider text-muted">
              {d.teardownSliderLabel}
            </label>
            <span id="teardown-val" class="font-mono text-xs font-bold text-amber-700 dark:text-amber-400">
              14 days
            </span>
          </div>
          <input 
            type="range" 
            id="teardown-slider" 
            min="1" 
            max="60" 
            step="1" 
            value="14" 
            class="w-full h-2 bg-surface-soft border border-hairline rounded-lg appearance-none cursor-pointer accent-amber-600"
          />
          <p class="text-xs text-muted mt-0.5">{d.teardownSliderHelp}</p>
        </div>
      </div>
    </div>

    <!-- Right Diagnostic & Telemetry Panel (5 Cols) -->
    <div class="lg:col-span-5 flex flex-col justify-between bg-surface border border-hairline rounded-2xl p-6 shadow-sm">
      <div>
        <div class="flex items-center justify-between gap-2 border-b border-hairline pb-3 mb-4">
          <div>
            <h3 class="text-base font-bold text-ink">{d.diagnosticTitle}</h3>
            <p class="text-xs text-muted">{d.diagnosticSub}</p>
          </div>
          <span id="risk-badge" class="px-2.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-600/10 text-emerald-700 dark:text-emerald-400 border border-emerald-600/20">
            OPTIMAL / SAFE
          </span>
        </div>

        <!-- Key Metrics Grid -->
        <div class="space-y-4 mb-6">
          <!-- Metric 1: Log Kill -->
          <div>
            <div class="flex justify-between items-center text-xs mb-1">
              <span class="text-muted font-medium">{d.listeriaLogLabel}</span>
              <span id="log-kill-val" class="font-mono font-bold text-sm text-emerald-700 dark:text-emerald-400">
                6.5 Log (99.9999% Kill)
              </span>
            </div>
            <div class="w-full h-2 rounded-full bg-surface-soft overflow-hidden border border-hairline">
              <div id="log-kill-progress" class="h-full bg-emerald-600 transition-all duration-300" style="width: 90%;"></div>
            </div>
          </div>

          <!-- Metric 2: Recalcitrance Factor -->
          <div class="flex items-center justify-between text-xs py-1.5 border-b border-hairline/60">
            <span class="text-muted">{d.recalcitranceFactorLabel}</span>
            <span id="recalcitrance-val" class="font-mono font-bold text-ink">3.2x Sanitizer Resistance</span>
          </div>

          <!-- Metric 3: Danger Zone Pull-Down -->
          <div class="flex items-center justify-between text-xs py-1.5 border-b border-hairline/60">
            <span class="text-muted">{d.pullDownDangerLabel}</span>
            <span id="pulldown-danger-val" class="font-mono font-bold text-ink">85 min (&lt;120 min Compliant)</span>
          </div>

          <!-- Metric 4: Micro-Crevice Harbor Risk -->
          <div class="flex items-center justify-between text-xs py-1.5 border-b border-hairline/60">
            <span class="text-muted">{d.harborScoreLabel}</span>
            <span id="harbor-val" class="font-mono font-bold text-ink">15 / 100 (Low Harborage)</span>
          </div>

          <!-- Metric 5: FDA Regulatory Compliance -->
          <div class="flex items-center justify-between text-xs py-1.5 border-b border-hairline/60">
            <span class="text-muted">{d.complianceLabel}</span>
            <span id="compliance-val" class="font-mono font-bold text-emerald-600 dark:text-emerald-400">
              COMPLIANT (§ 4-402.12 Validated)
            </span>
          </div>
        </div>

        <!-- Mechanism & Remediation Box -->
        <div class="space-y-3 p-4 rounded-xl bg-surface-soft/80 border border-hairline text-xs mb-6">
          <div>
            <span class="font-bold text-ink block mb-0.5">{d.primaryRiskLabel}</span>
            <p id="risk-desc" class="text-muted leading-relaxed">
              Low microbiological risk. Overnight 152°F heating in combination with intact scraper blades achieves sufficient thermal lethality across both planktonic and sessile bacterial cells.
            </p>
          </div>
          <div class="pt-2 border-t border-hairline/70">
            <span class="font-bold text-ink block mb-0.5">{d.mechanismsLabel}</span>
            <p id="mechanism-desc" class="text-muted leading-relaxed">
              Thermal denaturation of Listeria membrane lipoproteins and RNA polymerase exceeds 6-log lethality. Fresh Delrin scraper blade geometry minimizes stagnant butterfat boundary niches.
            </p>
          </div>
          <div class="pt-2 border-t border-hairline/70">
            <span class="font-bold text-amber-700 dark:text-amber-400 block mb-0.5">{d.mitigationLabel}</span>
            <p id="mitigation-desc" class="text-muted leading-relaxed">
              Maintain strict 14-day full disassembly brush cleaning cycle. Inspect draw spigots, relief valves, and air metering tubes with food-grade lubricant reapplication.
            </p>
          </div>
        </div>
      </div>

      <!-- Action Button -->
      <div>
        <button 
          id="copy-report-btn" 
          type="button" 
          class="w-full py-3 px-4 rounded-xl bg-amber-800 hover:bg-amber-900 text-white font-medium text-xs transition-colors shadow-sm flex items-center justify-center gap-2"
        >
          <span>📋</span>
          <span id="copy-btn-text">{d.copyReportBtn}</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Comparative Scientific Table -->
  <div class="mb-10 bg-surface border border-hairline rounded-2xl p-6">
    <div class="mb-4">
      <h3 class="text-base font-bold text-ink">{d.tableTitle}</h3>
      <p class="text-xs text-muted">{d.tableSub}</p>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-xs text-left text-muted">
        <thead class="text-muted uppercase border-b border-hairline bg-surface-soft/50 font-semibold">
          <tr>
            <th class="py-2.5 px-3">{d.colMachine}</th>
            <th class="py-2.5 px-3">{d.colMethod}</th>
            <th class="py-2.5 px-3">{d.colAlloy}</th>
            <th class="py-2.5 px-3">{d.colCapacity}</th>
            <th class="py-2.5 px-3">{d.colBiofilmRisk}</th>
            <th class="py-2.5 px-3">{d.colInterval}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline">
          {softServeData.machineConfigurations.map(m => (
            <tr class="hover:bg-surface-soft/30 transition-colors">
              <td class="py-3 px-3 font-medium text-ink">{m.name}</td>
              <td class="py-3 px-3">{m.pasteurizationMethod}</td>
              <td class="py-3 px-3 font-mono">{m.cylinderAlloy}</td>
              <td class="py-3 px-3">{m.dailyMixCapacityLiters} L / day</td>
              <td class="py-3 px-3">
                <span class={`inline-block px-2 py-0.5 rounded text-2xs font-bold ${
                  m.baselineBiofilmRisk.includes('LOW') ? 'bg-emerald-600/10 text-emerald-700 dark:text-emerald-400' :
                  m.baselineBiofilmRisk.includes('MODERATE') ? 'bg-amber-600/10 text-amber-700 dark:text-amber-400' :
                  'bg-red-600/10 text-red-700 dark:text-red-400'
                }`}>
                  {m.baselineBiofilmRisk}
                </span>
              </td>
              <td class="py-3 px-3 font-semibold text-ink">{m.mandatoryDisassemblyIntervalDays} days</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Operational Engineering Rules -->
  <div class="bg-surface-soft/40 border border-hairline rounded-2xl p-6">
    <div class="mb-4">
      <h3 class="text-base font-bold text-ink">{d.rulesTitle}</h3>
      <p class="text-xs text-muted">{d.rulesSub}</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="p-4 rounded-xl bg-surface border border-hairline/70">
        <div class="flex items-center gap-2 mb-1.5">
          <span class="w-5 h-5 rounded-full bg-red-600/10 text-red-700 dark:text-red-400 text-xs font-bold flex items-center justify-center">1</span>
          <h4 class="text-xs font-bold text-ink">{d.rule1Title}</h4>
        </div>
        <p class="text-xs text-muted leading-relaxed">{d.rule1Text}</p>
      </div>

      <div class="p-4 rounded-xl bg-surface border border-hairline/70">
        <div class="flex items-center gap-2 mb-1.5">
          <span class="w-5 h-5 rounded-full bg-amber-600/10 text-amber-700 dark:text-amber-400 text-xs font-bold flex items-center justify-center">2</span>
          <h4 class="text-xs font-bold text-ink">{d.rule2Title}</h4>
        </div>
        <p class="text-xs text-muted leading-relaxed">{d.rule2Text}</p>
      </div>

      <div class="p-4 rounded-xl bg-surface border border-hairline/70">
        <div class="flex items-center gap-2 mb-1.5">
          <span class="w-5 h-5 rounded-full bg-blue-600/10 text-blue-700 dark:text-blue-400 text-xs font-bold flex items-center justify-center">3</span>
          <h4 class="text-xs font-bold text-ink">{d.rule3Title}</h4>
        </div>
        <p class="text-xs text-muted leading-relaxed">{d.rule3Text}</p>
      </div>

      <div class="p-4 rounded-xl bg-surface border border-hairline/70">
        <div class="flex items-center gap-2 mb-1.5">
          <span class="w-5 h-5 rounded-full bg-emerald-600/10 text-emerald-700 dark:text-emerald-400 text-xs font-bold flex items-center justify-center">4</span>
          <h4 class="text-xs font-bold text-ink">{d.rule4Title}</h4>
        </div>
        <p class="text-xs text-muted leading-relaxed">{d.rule4Text}</p>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ softServeData, d }}>
  document.addEventListener('DOMContentLoaded', () => {
    const root = document.getElementById('soft-serve-listeria-modeler-root');
    if (!root) return;

    // Elements
    const machineSelect = root.querySelector('#machine-config');
    const phaseSelect = root.querySelector('#pasteurization-phase');
    const wearSelect = root.querySelector('#wear-level');
    const cleaningSelect = root.querySelector('#cleaning-regimen');
    const dutySelect = root.querySelector('#duty-cycle');

    const tempSlider = root.querySelector('#temp-slider');
    const pulldownSlider = root.querySelector('#pulldown-slider');
    const teardownSlider = root.querySelector('#teardown-slider');

    const tempVal = root.querySelector('#temp-val');
    const pulldownVal = root.querySelector('#pulldown-val');
    const teardownVal = root.querySelector('#teardown-val');

    const riskBadge = root.querySelector('#risk-badge');
    const logKillVal = root.querySelector('#log-kill-val');
    const logKillProgress = root.querySelector('#log-kill-progress');
    const recalcitranceVal = root.querySelector('#recalcitrance-val');
    const pulldownDangerVal = root.querySelector('#pulldown-danger-val');
    const harborVal = root.querySelector('#harbor-val');
    const complianceVal = root.querySelector('#compliance-val');

    const riskDesc = root.querySelector('#risk-desc');
    const mechanismDesc = root.querySelector('#mechanism-desc');
    const mitigationDesc = root.querySelector('#mitigation-desc');
    const copyBtn = root.querySelector('#copy-report-btn');
    const copyBtnText = root.querySelector('#copy-btn-text');

    function calculate() {
      const machineId = machineSelect.value;
      const phaseId = phaseSelect.value;
      const wearId = wearSelect.value;
      const cleaningId = cleaningSelect.value;
      const dutyId = dutySelect.value;

      const peakTemp = parseFloat(tempSlider.value);
      const pullDownMinutes = parseFloat(pulldownSlider.value);
      const teardownDays = parseInt(teardownSlider.value, 10);

      // Lookups
      const machine = softServeData.machineConfigurations.find(m => m.id === machineId) || softServeData.machineConfigurations[0];
      const phase = softServeData.pasteurizationCyclePhases.find(p => p.id === phaseId) || softServeData.pasteurizationCyclePhases[0];
      const wear = softServeData.biofilmAndComponentWearLevels.find(w => w.id === wearId) || softServeData.biofilmAndComponentWearLevels[0];
      const cleaning = softServeData.cleaningAndSanitizerRegimens.find(c => c.id === cleaningId) || softServeData.cleaningAndSanitizerRegimens[0];
      const duty = softServeData.dairyMixAndDutyCycles.find(d => d.id === dutyId) || softServeData.dairyMixAndDutyCycles[0];

      // Update slider labels
      const tempF = Math.round((peakTemp * 9/5) + 32);
      tempVal.textContent = `${peakTemp}°C (${tempF}°F)`;
      pulldownVal.textContent = `${pullDownMinutes} min`;
      teardownVal.textContent = `${teardownDays} days`;

      // 1. Nominal Thermal Log Kill
      // Ref D60C for Listeria monocytogenes in dairy = 2.4 min, z = 7.0 C.
      let nominalLogKill = 0;
      if (peakTemp >= 55) {
        const lethalRate = Math.pow(10, (peakTemp - 60) / 7.0);
        // Base holding time of 30 min scaled by phase
        const effectiveHoldMin = phase.holdTimeMinutes;
        nominalLogKill = (lethalRate * effectiveHoldMin) / 2.4;
      } else {
        nominalLogKill = 0.2;
      }
      nominalLogKill = Math.min(8.0, nominalLogKill);

      // 2. Recalcitrance & Biofilm Protection
      let recalcitranceMultiplier = wear.biofilmRecalcitranceMultiplier;
      // Sanitizer deficit
      if (cleaning.id === 'quaternary_ammonium_soak') recalcitranceMultiplier *= 2.2;
      if (cleaning.id === 'delayed_manual_breakdown') recalcitranceMultiplier *= 4.5;
      if (cleaning.id === 'lukewarm_water_rinse') recalcitranceMultiplier *= 12.0;

      // Teardown overdue multiplier
      if (teardownDays > machine.mandatoryDisassemblyIntervalDays) {
        const daysOver = teardownDays - machine.mandatoryDisassemblyIntervalDays;
        recalcitranceMultiplier *= (1 + (daysOver / 10));
      }

      // Effective Biofilm Log Kill
      let netBiofilmLogKill = Math.max(0, nominalLogKill / Math.pow(recalcitranceMultiplier, 0.42));

      // 3. Cooling Pull-Down Regrowth Penalty
      // If pull-down exceeds 120 minutes in 5°C-49°C danger zone
      let pullDownPenalty = 0;
      if (pullDownMinutes > 120) {
        pullDownPenalty = ((pullDownMinutes - 120) / 60) * 0.95 * (duty.ambientRoomTempC / 24);
      }
      netBiofilmLogKill = Math.max(0.1, netBiofilmLogKill - pullDownPenalty);

      // 4. Scraper Blade Micro-Crevice Harbor Score (0-100)
      let harborScore = Math.min(100, Math.round(
        (wear.bladeWearDepthMicrons / 140) * 60 + 
        (teardownDays / 30) * 25 + 
        (100 - cleaning.biofilmPenetrationPct) * 0.15
      ));

      // Display Log Kill
      const killPct = netBiofilmLogKill >= 6.0 ? "99.9999%" :
                      netBiofilmLogKill >= 4.0 ? "99.99%" :
                      netBiofilmLogKill >= 2.0 ? "99.0%" :
                      netBiofilmLogKill >= 1.0 ? "90.0%" : "<50% Survival Risk";
      logKillVal.textContent = `${netBiofilmLogKill.toFixed(1)} Log (${killPct} Kill)`;
      logKillProgress.style.width = `${Math.min(100, (netBiofilmLogKill / 7.0) * 100)}%`;

      if (netBiofilmLogKill >= 5.5) {
        logKillProgress.className = "h-full bg-emerald-600 transition-all duration-300";
        logKillVal.className = "font-mono font-bold text-sm text-emerald-700 dark:text-emerald-400";
      } else if (netBiofilmLogKill >= 3.0) {
        logKillProgress.className = "h-full bg-amber-500 transition-all duration-300";
        logKillVal.className = "font-mono font-bold text-sm text-amber-700 dark:text-amber-400";
      } else {
        logKillProgress.className = "h-full bg-red-600 transition-all duration-300";
        logKillVal.className = "font-mono font-bold text-sm text-red-600 dark:text-red-400";
      }

      // Display Recalcitrance
      recalcitranceVal.textContent = `${recalcitranceMultiplier.toFixed(1)}x Sanitizer Tolerance`;
      pulldownDangerVal.textContent = `${pullDownMinutes} min ${pullDownMinutes <= 120 ? '(Compliant <120m)' : '(DANGER: Warm Incubator)'}`;
      harborVal.textContent = `${harborScore} / 100 (${harborScore < 30 ? 'Low Harborage' : harborScore < 65 ? 'Elevated Niche' : 'Critical Biofilm Harbor'})`;

      // 5. Compliance & Risk Status
      let complianceText = "";
      let isCompliant = true;
      let riskLevel = "SAFE";

      if (machine.id === 'non_heat_treatment_manual' && teardownDays > 1) {
        isCompliant = false;
        complianceText = "VIOLATION: Non-Heat Dispenser Requires 24-Hr Teardown";
        riskLevel = "CRITICAL";
      } else if (peakTemp < 65.6) {
        isCompliant = false;
        complianceText = "VIOLATION: Sub-150°F Inadequate Pasteurization Temp";
        riskLevel = "CRITICAL";
      } else if (pullDownMinutes > 240) {
        isCompliant = false;
        complianceText = "VIOLATION: Dangerous Slow Cooling Curve (>4 Hours)";
        riskLevel = "CRITICAL";
      } else if (teardownDays > 28) {
        isCompliant = false;
        complianceText = "VIOLATION: 28-Day Maximum Teardown Interval Exceeded";
        riskLevel = "HIGH";
      } else if (netBiofilmLogKill < 4.0) {
        isCompliant = false;
        complianceText = "WARNING: Insufficient Log Reduction in Biofilm Niche";
        riskLevel = "ELEVATED";
      } else {
        complianceText = "COMPLIANT: FDA Food Code § 4-402.12 Validated";
        riskLevel = "SAFE";
      }

      complianceVal.textContent = complianceText;
      if (isCompliant) {
        complianceVal.className = "font-mono font-bold text-emerald-600 dark:text-emerald-400";
      } else {
        complianceVal.className = "font-mono font-bold text-red-600 dark:text-red-400";
      }

      // Risk Badge and Explanations
      if (riskLevel === "SAFE") {
        riskBadge.textContent = "OPTIMAL / SAFE";
        riskBadge.className = "px-2.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-600/10 text-emerald-700 dark:text-emerald-400 border border-emerald-600/20";
        riskDesc.textContent = "Minimal microbiological risk. High-temperature pasteurization (>=150°F) combined with rapid pull-down (<120m) achieves over 6-log lethality.";
        mechanismDesc.textContent = "Thermal denaturation destroys cell membranes and ribosomal subunits of Listeria monocytogenes. Polished cylinder walls and intact scraper blades leave no micro-niche for biofilm persistence.";
        mitigationDesc.textContent = "Maintain verified 14-day teardown schedule. Lubricate draw valves and prime plugs with food-grade Petro-Gel/Haynes silicone lubricant.";
      } else if (riskLevel === "ELEVATED") {
        riskBadge.textContent = "ELEVATED RISK";
        riskBadge.className = "px-2.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-600/10 text-amber-700 dark:text-amber-400 border border-amber-600/20";
        riskDesc.textContent = "Elevated biofilm persistence risk. Micro-crevices on worn scraper blades or prolonged mix residence reduce net lethality below 5-log kill.";
        mechanismDesc.textContent = "Sub-lethal exposure induces heat-shock protein expression (GroEL/DnaK), allowing phenotypic persister cells to survive within extracellular polymeric substance (EPS) matrices.";
        mitigationDesc.textContent = "Perform prompt manual brush teardown within 48 hours. Replace Delrin scraper blades and execute full alkaline milkstone wash.";
      } else {
        riskBadge.textContent = "CRITICAL CONTAMINATION";
        riskBadge.className = "px-2.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-red-600/10 text-red-700 dark:text-red-400 border border-red-600/20";
        riskDesc.textContent = "Extreme outbreak hazard (Tacoma outbreak profile). Pasteurization failure, scratched cylinder barrels, or overdue teardown creates persistent Listeria colonisation.";
        mechanismDesc.textContent = "Psychrotolerant Listeria monocytogenes multiplies during slow pull-down or sub-lethal warm hold. Sessile cells exhibit 100x–300x resistance to sanitizers under protective butterfat layers.";
        mitigationDesc.textContent = "IMMEDIATE EQUIPMENT LOCKOUT. Discard all dairy mix immediately. Perform full chemical descaling, replace beater assembly and O-rings, and verify 0 CFU/mL swab clearance before restarting.";
      }
    }

    // Presets Click Handler
    root.querySelectorAll('.preset-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const p = btn.getAttribute('data-preset');
        if (p === 'gold-standard') {
          machineSelect.value = 'heat_treatment_multi_flavor';
          phaseSelect.value = 'optimal_fda_pasteurization';
          wearSelect.value = 'factory_fresh_polished';
          cleaningSelect.value = 'full_cip_chlorine_protocol';
          dutySelect.value = 'high_volume_quick_service';
          tempSlider.value = 66.7;
          pulldownSlider.value = 85;
          teardownSlider.value = 14;
        } else if (p === 'tacoma-outbreak') {
          machineSelect.value = 'heat_treatment_multi_flavor';
          phaseSelect.value = 'sublethal_heat_thermal_shock';
          wearSelect.value = 'chronic_unserviced_biofilm';
          cleaningSelect.value = 'delayed_manual_breakdown';
          dutySelect.value = 'high_volume_quick_service';
          tempSlider.value = 61.1;
          pulldownSlider.value = 140;
          teardownSlider.value = 45;
        } else if (p === 'summer-condenser') {
          machineSelect.value = 'compact_countertop_commercial';
          phaseSelect.value = 'choked_condenser_cooling_failure';
          wearSelect.value = 'worn_scored_barrel_blades';
          cleaningSelect.value = 'quaternary_ammonium_soak';
          dutySelect.value = 'extreme_summer_mall_patio';
          tempSlider.value = 66.0;
          pulldownSlider.value = 260;
          teardownSlider.value = 21;
        } else if (p === 'hospital-stagnant') {
          machineSelect.value = 'gravity_fed_commercial';
          phaseSelect.value = 'sublethal_heat_thermal_shock';
          wearSelect.value = 'routine_wear_3_months';
          cleaningSelect.value = 'quaternary_ammonium_soak';
          dutySelect.value = 'low_turnover_hospital_elderly';
          tempSlider.value = 63.0;
          pulldownSlider.value = 110;
          teardownSlider.value = 28;
        }
        calculate();
      });
    });

    // Listeners
    [machineSelect, phaseSelect, wearSelect, cleaningSelect, dutySelect].forEach(el => el.addEventListener('change', calculate));
    [tempSlider, pulldownSlider, teardownSlider].forEach(el => el.addEventListener('input', calculate));

    // Copy Audit Report
    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        const report = `=== ISITKITCHENSAFE COMMERCIAL SOFT-SERVE LISTERIA PERSISTENCE AUDIT ===\n` +
          `Date: ${new Date().toISOString()}\n` +
          `Freezer Architecture: ${machineSelect.options[machineSelect.selectedIndex].text}\n` +
          `Pasteurization Phase: ${phaseSelect.options[phaseSelect.selectedIndex].text}\n` +
          `Wear & Topography: ${wearSelect.options[wearSelect.selectedIndex].text}\n` +
          `Sanitizer Regimen: ${cleaningSelect.options[cleaningSelect.selectedIndex].text}\n` +
          `Peak Pasteurization Temp: ${tempVal.textContent}\n` +
          `Cooling Pull-Down: ${pulldownVal.textContent}\n` +
          `Days Since Teardown: ${teardownVal.textContent}\n` +
          `--------------------------------------------------\n` +
          `Net Listeria Kill: ${logKillVal.textContent}\n` +
          `Biofilm Recalcitrance: ${recalcitranceVal.textContent}\n` +
          `Pull-Down Status: ${pulldownDangerVal.textContent}\n` +
          `Harborage Risk Score: ${harborVal.textContent}\n` +
          `FDA Food Code Status: ${complianceVal.textContent}\n` +
          `Risk Classification: ${riskBadge.textContent.trim()}\n` +
          `--------------------------------------------------\n` +
          `Audit standard: FDA Food Code 2022 § 4-402.12 | NSF/ANSI 6 | CDC Outbreak Protocol`;

        navigator.clipboard.writeText(report).then(() => {
          const original = copyBtnText.textContent;
          copyBtnText.textContent = d.copiedFeedback;
          setTimeout(() => {
            copyBtnText.textContent = original;
          }, 2500);
        });
      });
    }

    calculate();
  });
</script>
