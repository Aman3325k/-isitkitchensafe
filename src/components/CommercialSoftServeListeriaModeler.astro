    primaryRiskLabel: "主たる病原汚染リスク経路：",
    mechanismsLabel: "微生物生理学＆熱伝達速度論メカニズム：",
    mitigationLabel: "法令上必須の衛生改善および技術的対策指令：",
    scienceTitle: "乳製品微生物学＆シリンダー冷却伝熱物理学",
    scienceSub: "なぜリステリア菌は業務用ソフトクリームフリーザーにおいて特異的に危険なのか。",
    tableTitle: "業務用ソフトクリームフリーザー衛生工学スペック比較",
    tableSub: "冷却方式、シリンダー材質合金、バイオフィルム脆弱性、および法定メンテナンス周期の比較。",
    colMachine: "フリーザー機種構造",
    colMethod: "衛生殺菌方式",
    colAlloy: "シリンダー合金",
    colCapacity: "原料タンク容量",
    colBiofilmRisk: "バイオフィルムリスク",
    colInterval: "法定分解洗浄間隔",
    rulesTitle: "業務用フリーザー衛生管理の4大エンジニアリング原則",
