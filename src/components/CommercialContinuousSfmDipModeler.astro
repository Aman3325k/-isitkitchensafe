<script>
  function initSfmDipModeler() {
    const container = document.querySelector('.sfm-dip-modeler-container');
    if (!container) return;

    // Controls
    const formulationSelect = document.getElementById('sfm-formulation') as HTMLSelectElement | null;
    const pressureInput = document.getElementById('sfm-pressure') as HTMLInputElement | null;
    const tempInput = document.getElementById('sfm-temp') as HTMLInputElement | null;
    const gasRatioInput = document.getElementById('sfm-gas-ratio') as HTMLInputElement | null;
    const thicknessInput = document.getElementById('sfm-thickness') as HTMLInputElement | null;
    const airVelInput = document.getElementById('sfm-air-vel') as HTMLInputElement | null;

    // Labels
    const pressureVal = document.getElementById('sfm-pressure-val');
    const tempVal = document.getElementById('sfm-temp-val');
    const gasRatioVal = document.getElementById('sfm-gas-ratio-val');
    const thicknessVal = document.getElementById('sfm-thickness-val');
    const airVelVal = document.getElementById('sfm-air-vel-val');

    // Telemetry Outputs
    const outPorosity = document.getElementById('sfm-out-porosity');
    const outPoreSize = document.getElementById('sfm-out-pore-size');
    const outAcoustic = document.getElementById('sfm-out-acoustic');
    const outDryingTime = document.getElementById('sfm-out-drying-time');
    const outAw = document.getElementById('sfm-out-aw');
    const outRetention = document.getElementById('sfm-out-retention');
    const outProbiotic = document.getElementById('sfm-out-probiotic');
    const outSec = document.getElementById('sfm-out-sec');

    // Visuals & Verdict
    const verdictBox = document.getElementById('sfm-verdict-box');
    const verdictTitle = document.getElementById('sfm-verdict-title');
    const verdictDesc = document.getElementById('sfm-verdict-desc');
    const foamScale = document.getElementById('sfm-foam-scale');
    const dpDtText = document.getElementById('sfm-dp-dt');
    const resFreqText = document.getElementById('sfm-res-freq');

    const presets = {
      strawberry: { form: 'strawberry_probiotic_puree', p: 120, t: 36, gr: 3.2, th: 2.0, vel: 2.2 },
      mango: { form: 'mango_prebiotic_puree', p: 135, t: 38, gr: 3.5, th: 2.2, vel: 2.5 },
      acai: { form: 'acai_anthocyanin_extract', p: 145, t: 34, gr: 3.8, th: 1.8, vel: 2.4 },
      yogurt: { form: 'greek_yogurt_culture', p: 110, t: 35, gr: 3.0, th: 2.5, vel: 2.0 },
      spirulina: { form: 'spirulina_phycocyanin', p: 125, t: 33, gr: 3.4, th: 1.9, vel: 2.1 },
      hazard: { form: 'subcritical_collapse_hazard', p: 45, t: 58, gr: 0.8, th: 4.5, vel: 1.0 }
    };

    function recalculate() {
      const p = parseFloat(pressureInput?.value || '120');
      const t = parseFloat(tempInput?.value || '36');
      const gr = parseFloat(gasRatioInput?.value || '3.2');
      const th = parseFloat(thicknessInput?.value || '2.0');
      const vel = parseFloat(airVelInput?.value || '2.2');

      if (pressureVal) pressureVal.textContent = `${p.toFixed(0)} bar`;
      if (tempVal) tempVal.textContent = `${t.toFixed(1)} °C`;
      if (gasRatioVal) gasRatioVal.textContent = `${gr.toFixed(1)} wt%`;
      if (thicknessVal) thicknessVal.textContent = `${th.toFixed(1)} mm`;
      if (airVelVal) airVelVal.textContent = `${vel.toFixed(1)} m/s`;

      const isSupercritical = p >= 73.8 && t >= 31.1;

      // Foam Porosity ε (%)
      let porosity = 0;
      let poreSizeUm = 0;
      let acousticAtten = 0;
      let dryingTimeMin = 0;
      let finalAw = 0;
      let retention = 0;
      let probioticSurvival = 0;
      let sec = 0.85;

      if (isSupercritical) {
        porosity = Math.min(95.0, Math.max(82.0, 85.0 + (gr * 2.1) + ((p - 100) * 0.05) - ((th - 2.0) * 1.2)));
        poreSizeUm = Math.max(14.0, Math.min(48.0, 35.0 - ((p - 80) * 0.12) + (gr * 2.2)));
        acousticAtten = 10.5 + ((porosity - 85.0) * 0.85) + ((40.0 - poreSizeUm) * 0.15);
        dryingTimeMin = Math.max(5.0, Math.min(15.0, (th * 3.2) * (2.2 / vel) * (90.0 / porosity)));
        finalAw = Math.max(0.18, Math.min(0.28, 0.20 + (th * 0.015) - (vel * 0.008)));
        retention = Math.min(99.4, Math.max(92.0, 99.0 - (t > 38 ? (t - 38) * 0.45 : 0.1)));
        probioticSurvival = Math.min(96.5, Math.max(85.0, 95.0 - (t > 36 ? (t - 36) * 0.6 : 0.1)));
        sec = 0.72 + (th * 0.06) + (0.15 / vel);
      } else {
        // Subcritical failure mode
        porosity = Math.max(35.0, 48.0 - ((73.8 - p) * 0.5));
        poreSizeUm = 160.0 + ((73.8 - p) * 2.0);
        acousticAtten = 3.5;
        dryingTimeMin = 45.0 + ((5.0 - th) * 2.0);
        finalAw = 0.58;
        retention = 42.0;
        probioticSurvival = 11.5;
        sec = 3.85;
      }

      const dpDt = isSupercritical ? Math.round(350 + (p - 80) * 2.2) : 40;
      const resFreq = isSupercritical ? (380 + (porosity - 85) * 3.5).toFixed(1) : '95.0';

      // Telemetry DOM updates
      if (outPorosity) outPorosity.textContent = `${porosity.toFixed(1)}%`;
      if (outPoreSize) outPoreSize.textContent = `${poreSizeUm.toFixed(1)} µm`;
      if (outAcoustic) outAcoustic.textContent = `${acousticAtten.toFixed(1)} dB/cm`;
      if (outDryingTime) outDryingTime.textContent = `${dryingTimeMin.toFixed(1)} min`;
      if (outAw) outAw.textContent = `${finalAw.toFixed(2)} a_w`;
      if (outRetention) outRetention.textContent = `${retention.toFixed(1)}%`;
      if (outProbiotic) outProbiotic.textContent = `${probioticSurvival.toFixed(1)}%`;
      if (outSec) outSec.textContent = `${sec.toFixed(2)} kWh/kg`;

      if (dpDtText) dpDtText.textContent = `ΔP/Δt = ${dpDt} bar/s`;
      if (resFreqText) resFreqText.textContent = `f_res = ${resFreq} kHz`;
      if (foamScale) {
        foamScale.textContent = `Porosity ε = ${porosity.toFixed(1)}% (${porosity > 88 ? 'Micro-Cellular Open Foam Mat' : 'Dense Semi-Collapsed Slurry'})`;
      }

      // Verdict styling
      if (isSupercritical && porosity >= 88.0 && finalAw <= 0.25) {
        if (verdictBox) {
          verdictBox.className = "mb-6 p-4 rounded-2xl border transition-all bg-teal-950/40 border-teal-500/80 text-teal-200 shadow-md";
        }
        if (verdictTitle) verdictTitle.textContent = `OPTIMAL SUPERCRITICAL MICRO-CELLULAR FOAM EXPANSION (${porosity.toFixed(1)}% POROSITY)`;
        if (verdictDesc) verdictDesc.textContent = `Rapid slit-die depressurization (ΔP/Δt = ${dpDt} bar/s) generates stable open-cell foam (mean cell size ${poreSizeUm.toFixed(1)} µm). Convective drying completes in ${dryingTimeMin.toFixed(1)} min with ${retention.toFixed(1)}% vitamin C retention and a_w = ${finalAw.toFixed(2)}.`;
      } else if (!isSupercritical) {
        if (verdictBox) {
          verdictBox.className = "mb-6 p-4 rounded-2xl border transition-all bg-red-950/50 border-red-500/80 text-red-200 shadow-md";
        }
        if (verdictTitle) verdictTitle.textContent = `HAZARD: SUBCRITICAL CO2 PHASE COLLAPSE (P < 73.8 bar / T < 31.1 °C)`;
        if (verdictDesc) verdictDesc.textContent = `CO2 density and solubility collapsed into liquid slugging regime. Foam drained and collapsed (porosity < 50%), drying cycle stalled, and moisture activity (a_w = ${finalAw.toFixed(2)}) promotes rapid mold proliferation in violation of FDA 21 CFR § 117.`;
      } else {
        if (verdictBox) {
          verdictBox.className = "mb-6 p-4 rounded-2xl border transition-all bg-amber-950/40 border-amber-500/80 text-amber-200 shadow-md";
        }
        if (verdictTitle) verdictTitle.textContent = `SUB-OPTIMAL FOAM EXPANSION (${porosity.toFixed(1)}% POROSITY) • EXTENDED DRYING CYCLE`;
        if (verdictDesc) verdictDesc.textContent = `Supercritical phase maintained, but thicker mat (${th.toFixed(1)} mm) or lower gas ratio (${gr.toFixed(1)} wt%) slows moisture diffusion. Elevate pressure or decrease thickness to achieve sub-10 minute drying.`;
      }
    }

    [pressureInput, tempInput, gasRatioInput, thicknessInput, airVelInput].forEach(input => {
      input?.addEventListener('input', recalculate);
    });

    formulationSelect?.addEventListener('change', () => {
      const selected = formulationSelect.value;
      if (selected === 'strawberry_probiotic_puree') applyPreset('strawberry');
      else if (selected === 'mango_prebiotic_puree') applyPreset('mango');
      else if (selected === 'acai_anthocyanin_extract') applyPreset('acai');
      else if (selected === 'greek_yogurt_culture') applyPreset('yogurt');
      else if (selected === 'spirulina_phycocyanin') applyPreset('spirulina');
      else if (selected === 'subcritical_collapse_hazard') applyPreset('hazard');
    });

    function applyPreset(key: keyof typeof presets) {
      const data = presets[key];
      if (!data) return;
      if (formulationSelect) formulationSelect.value = data.form;
      if (pressureInput) pressureInput.value = data.p.toString();
      if (tempInput) tempInput.value = data.t.toString();
      if (gasRatioInput) gasRatioInput.value = data.gr.toString();
      if (thicknessInput) thicknessInput.value = data.th.toString();
      if (airVelInput) airVelInput.value = data.vel.toString();
      recalculate();
    }

    document.querySelectorAll('.preset-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const presetKey = target.getAttribute('data-preset') as keyof typeof presets;
        if (presetKey) applyPreset(presetKey);
      });
    });

    recalculate();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSfmDipModeler);
  } else {
    initSfmDipModeler();
  }
</script>
