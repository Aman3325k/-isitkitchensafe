    regSub: "通过 FDA 21 CFR § 117 FSMA cGMP、3-A 卫生标准 63-04 & 08-17、EHEDG Type EL Class I CIP 在线清洗认证与 ASME Section VIII 超高压压力容器标准。"
  },
  ja: {
    badge: "マイルストーン 173 • 旗艦診断ツール",
    title: "商用連続式 超臨界CO2フォームマット乾燥＆オンライン音響ポロシメトリー（SFM-DIP）モデラー",
    subtitle: "高圧高密度超臨界CO2の微小溶解（80–160 bar, 35–42°C）を高粘度食品ヒドロコロイドピューレに適用し、スリットダイノズルでの減圧膨張により微小気泡フォームマット（気孔率 ε > 90%, 気孔径 15–45 µm, 開気孔率 >92%）を連続成形。400 kHz非接触超音波音響ポロシメトリーと10分以内の低温通風乾燥（32–40°C）を統合し、水分活性 a_w < 0.25、ビタミンC保持率 >97.5%、プロバイオティクス生菌残存率 >92% を実現します（FDA 21 CFR § 117 および 3-A 衛生規格適合）。",
    controlsTitle: "超臨界CO2発泡成形＆低温乾燥プロセス制御盤",
    controlsSub: "超臨界溶解圧力、プロセス温度、scCO2気相注入質量比、スリットダイ発泡層厚、および乾燥風速を調整し、微細気泡膨張動力学と熱感受性成分保持率をシミュレーションします。",
    formulationLabel: "対象高粘度ピューレ＆生体機能基質：",
    formulationHelp: "フルーツピューレ、生きたプロバイオティクス菌液、または高機能藻類バイオマスを選択。",
    pressureLabel: "scCO2飽和溶解圧力 (bar)：",
    pressureHelp: "運転飽和圧力（60 – 180 bar, 臨界圧 P_crit = 73.8 bar）。超臨界流体密度と減圧時の気泡核生成密度を決定します。",
    tempLabel: "微小発泡＆低温乾燥室運転温度 (°C)：",
    tempHelp: "等温プロセス温度（25.0 – 55.0 °C）。熱感受性プロバイオティクスやビタミンCの変性を防ぎつつ、穏やかな脱水乾燥を促進します。",
    gasRatioLabel: "超臨界CO2注入質量比 (wt%)：",
    gasRatioHelp: "ピューレ原料に溶解させる超臨界CO2の質量分率（1.0 – 6.0 wt%）。気泡壁の厚みと最終気孔率を左右します。",
    thicknessLabel: "スリットダイ押出フォームマット層厚 (mm)：",
    thicknessHelp: "乾燥コンベア上に連続展張されるフォームマットの厚さ（1.0 – 5.0 mm）。薄層化により拡散律速乾燥時間を短縮。",
    airVelLabel: "低温除湿通風乾燥風速 (m/s)：",
    airVelHelp: "フォーム表面を通過する層流除湿乾燥空気流速（0.8 – 4.0 m/s, 相対湿度 < 12%）。",
    presetsTitle: "検証済み商業プリセット：",
    presetStrawberry: "イチゴ原浆＆プロバイオティクス LA-5（気孔率91.2%, 7.8分）",
    presetMango: "アルフォンソマンゴー＆アカシア繊維（気孔率92.4%, 8.2分）",
    presetAcai: "野生アサイー＆エンドウ豆タンパク（気孔率93.5%, 6.9分）",
    presetYogurt: "高プロテイン発酵ギリシャヨーグルトクリスプ（気孔率89.8%, 9.4分）",
    presetSpirulina: "スピルリナ＆フィコシアニン色素（色素残存98.7%, 7.4分）",
    presetHazard: "亜臨界相態発泡崩壊＆カビ汚染障害（<73.8 bar）",
    telemetryTitle: "気泡物理＆低温脱水リアルタイム物理テレメトリ",
    telemetrySub: "気孔率 ε、平均気泡径、超音波音響減衰係数、乾燥完了所要時間、最終水分活性 a_w、およびプロバイオティクス生存率のリアルタイム演算値。",
    porosityLabel: "微細気泡フォーム気孔率 ε (%)：",
    poreSizeLabel: "平均気泡気孔径 (µm)：",
    acousticLabel: "オンライン超音波減衰係数（400 kHz, dB/cm）：",
    dryingTimeLabel: "水分活性 a_w < 0.25 到達乾燥時間（分）：",
    waterActivityLabel: "製品最終水分活性 (a_w)：",
    retentionLabel: "ビタミンC＆アントシアニン保持率 (%)：",
    probioticLabel: "プロバイオティクス生菌残存率 (%)：",
    secLabel: "水分蒸発比エネルギー消費量（SEC, kWh/kg H2O）：",
    verdictLabel: "フォーム安定性＆低温脱水品質判定：",
    diagramTitle: "連続式超臨界フォームマット乾燥＆音響ポロシメトリースキッド系統図",
    diagramSub: "食品ペースト高圧ポンプ、無脈動scCO2注入器、スリットダイ微細発泡ノズル、非接触超音波センサー、および温和な除湿乾燥トンネル。",
    chartTitle: "フォーム脱水速度論＆熱感受性栄養素保持プロファイル",
    chartSub: "SFM-DIP、従来型温風乾燥庫、ロータリードラム乾燥、および真空凍結乾燥の水分低減曲線と栄養残存率比較。",
    principlesTitle: "高圧高密度CO2溶解度＆音響共鳴ポロシメトリー機序",
    principlesSub: "ヘンリーの法則逆温度溶解、急速減圧核生成（ΔP/Δt > 400 bar/s）、Biot音響減衰式、および開気孔薄層水分昇華動力学。",
    compTitle: "産業用食品脱水技術の横断的比較ベンチマーク",
    compSub: "処理所要時間、機能性栄養素保持率、テクスチャー復元性、および単位消費電力量の直接比較。",
    regTitle: "衛生工学基準および食品製造規制適合性",
    regSub: "FDA 21 CFR § 117 FSMA cGMP、3-A 衛生規格 63-04 & 08-17、EHEDG Type EL Class I 定置洗浄（CIP）適合、および ASME Section VIII 圧力容器規格適合。"
  }
};

const d = DICT[lang] || DICT.en;
const formulations = sfmDipData.foamMatFormulations;
---

<div class="sfm-dip-modeler-container my-8" data-lang={lang}>
  <!-- Header Card -->
  <header class="bg-gradient-to-br from-teal-950/80 via-slate-900 to-emerald-950/80 border border-teal-800/60 rounded-3xl p-6 sm:p-10 shadow-xl backdrop-blur-md mb-8">
    <div class="flex flex-wrap items-center gap-3 mb-4">
      <span class="px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-teal-500/20 text-teal-300 border border-teal-500/40 shadow-xs">
        {d.badge}
      </span>
      <span class="text-xs text-muted font-mono tracking-tight">
        FDA 21 CFR § 117 • 3-A Sanitary 63-04 • Porosity ε &gt; 90% • Sub-10 min • SEC &lt; 0.95 kWh/kg
      </span>
    </div>
    <h1 class="text-2xl sm:text-4xl font-extrabold text-ink tracking-tight mb-4">
      {d.title}
    </h1>
    <p class="text-sm sm:text-base text-muted max-w-4xl leading-relaxed">
      {d.subtitle}
    </p>
  </header>

  <!-- Main Grid: Controls + Telemetry -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-12">
    <!-- Left Column: Controls (5 Cols) -->
    <div class="lg:col-span-5 space-y-6">
      <section class="bg-surface border border-hairline rounded-3xl p-6 shadow-sm space-y-6">
        <div>
          <h2 class="text-lg font-bold text-ink mb-1">
            {d.controlsTitle}
          </h2>
          <p class="text-xs text-muted">
            {d.controlsSub}
          </p>
        </div>

        <!-- Preset Formulation Selector -->
        <div>
          <label for="sfm-formulation" class="block text-xs font-bold text-ink uppercase tracking-wider mb-2">
            {d.formulationLabel}
          </label>
          <select 
            id="sfm-formulation" 
            class="w-full bg-surface-soft border border-hairline rounded-xl px-3.5 py-2.5 text-xs text-ink focus:outline-none focus:ring-2 focus:ring-teal-500/40 font-medium"
          >
            {formulations.map(f => (
              <option value={f.id}>{f.name}</option>
            ))}
          </select>
          <p class="text-[11px] text-muted mt-1.5 leading-normal">
            {d.formulationHelp}
          </p>
        </div>

        <!-- Slider 1: scCO2 Pressure -->
        <div>
          <div class="flex justify-between items-center mb-1.5">
            <label for="sfm-pressure" class="text-xs font-bold text-ink">
              {d.pressureLabel}
            </label>
            <span id="sfm-pressure-val" class="text-xs font-mono font-bold text-teal-400 bg-teal-950/60 px-2 py-0.5 rounded-md border border-teal-800/40">
              120 bar
            </span>
          </div>
          <input 
            type="range" 
            id="sfm-pressure" 
            min="50" 
            max="180" 
            step="1" 
            value="120"
            class="w-full accent-teal-500 cursor-pointer"
          />
          <p class="text-[10px] text-muted mt-1">
            {d.pressureHelp}
          </p>
        </div>

        <!-- Slider 2: Process Temperature -->
        <div>
          <div class="flex justify-between items-center mb-1.5">
            <label for="sfm-temp" class="text-xs font-bold text-ink">
              {d.tempLabel}
            </label>
            <span id="sfm-temp-val" class="text-xs font-mono font-bold text-teal-400 bg-teal-950/60 px-2 py-0.5 rounded-md border border-teal-800/40">
              36.0 °C
            </span>
          </div>
          <input 
            type="range" 
            id="sfm-temp" 
            min="25" 
            max="55" 
            step="0.5" 
            value="36"
            class="w-full accent-teal-500 cursor-pointer"
          />
          <p class="text-[10px] text-muted mt-1">
            {d.tempHelp}
          </p>
        </div>

        <!-- Slider 3: scCO2 Injection Ratio -->
        <div>
          <div class="flex justify-between items-center mb-1.5">
            <label for="sfm-gas-ratio" class="text-xs font-bold text-ink">
              {d.gasRatioLabel}
            </label>
            <span id="sfm-gas-ratio-val" class="text-xs font-mono font-bold text-teal-400 bg-teal-950/60 px-2 py-0.5 rounded-md border border-teal-800/40">
              3.2 wt%
            </span>
          </div>
          <input 
            type="range" 
            id="sfm-gas-ratio" 
            min="0.5" 
            max="6.0" 
            step="0.1" 
            value="3.2"
            class="w-full accent-teal-500 cursor-pointer"
          />
          <p class="text-[10px] text-muted mt-1">
            {d.gasRatioHelp}
          </p>
        </div>

        <!-- Slider 4: Slit-Die Mat Thickness -->
        <div>
          <div class="flex justify-between items-center mb-1.5">
            <label for="sfm-thickness" class="text-xs font-bold text-ink">
              {d.thicknessLabel}
            </label>
            <span id="sfm-thickness-val" class="text-xs font-mono font-bold text-teal-400 bg-teal-950/60 px-2 py-0.5 rounded-md border border-teal-800/40">
              2.0 mm
            </span>
          </div>
          <input 
            type="range" 
            id="sfm-thickness" 
            min="1.0" 
            max="5.0" 
            step="0.1" 
            value="2.0"
            class="w-full accent-teal-500 cursor-pointer"
          />
          <p class="text-[10px] text-muted mt-1">
            {d.thicknessHelp}
          </p>
        </div>

        <!-- Slider 5: Drying Air Velocity -->
        <div>
          <div class="flex justify-between items-center mb-1.5">
            <label for="sfm-air-vel" class="text-xs font-bold text-ink">
              {d.airVelLabel}
            </label>
            <span id="sfm-air-vel-val" class="text-xs font-mono font-bold text-teal-400 bg-teal-950/60 px-2 py-0.5 rounded-md border border-teal-800/40">
              2.2 m/s
            </span>
          </div>
          <input 
            type="range" 
            id="sfm-air-vel" 
            min="0.8" 
            max="4.0" 
            step="0.1" 
            value="2.2"
            class="w-full accent-teal-500 cursor-pointer"
          />
          <p class="text-[10px] text-muted mt-1">
            {d.airVelHelp}
          </p>
        </div>

        <!-- Commercial Presets Grid -->
        <div class="pt-2 border-t border-hairline/60">
          <span class="block text-xs font-bold text-ink uppercase tracking-wider mb-2.5">
            {d.presetsTitle}
          </span>
          <div class="grid grid-cols-2 gap-2 text-xs">
            <button type="button" class="preset-btn px-2.5 py-2 rounded-xl bg-surface-soft hover:bg-teal-950/40 border border-hairline hover:border-teal-700/60 text-left transition-all" data-preset="strawberry">
              <span class="font-bold text-ink block">{d.presetStrawberry}</span>
            </button>
            <button type="button" class="preset-btn px-2.5 py-2 rounded-xl bg-surface-soft hover:bg-teal-950/40 border border-hairline hover:border-teal-700/60 text-left transition-all" data-preset="mango">
              <span class="font-bold text-ink block">{d.presetMango}</span>
            </button>
            <button type="button" class="preset-btn px-2.5 py-2 rounded-xl bg-surface-soft hover:bg-teal-950/40 border border-hairline hover:border-teal-700/60 text-left transition-all" data-preset="acai">
              <span class="font-bold text-ink block">{d.presetAcai}</span>
            </button>
            <button type="button" class="preset-btn px-2.5 py-2 rounded-xl bg-surface-soft hover:bg-teal-950/40 border border-hairline hover:border-teal-700/60 text-left transition-all" data-preset="yogurt">
              <span class="font-bold text-ink block">{d.presetYogurt}</span>
            </button>
            <button type="button" class="preset-btn px-2.5 py-2 rounded-xl bg-surface-soft hover:bg-teal-950/40 border border-hairline hover:border-teal-700/60 text-left transition-all" data-preset="spirulina">
              <span class="font-bold text-ink block">{d.presetSpirulina}</span>
            </button>
            <button type="button" class="preset-btn px-2.5 py-2 rounded-xl bg-red-950/20 hover:bg-red-950/40 border border-red-800/40 hover:border-red-600/60 text-left text-red-300 transition-all" data-preset="hazard">
              <span class="font-bold block">{d.presetHazard}</span>
            </button>
          </div>
        </div>
      </section>
    </div>

    <!-- Right Column: Live Physics Telemetry & Visualizer (7 Cols) -->
    <div class="lg:col-span-7 space-y-6">
      <section class="bg-surface border border-hairline rounded-3xl p-6 sm:p-8 shadow-sm">
        <div class="mb-6">
          <h2 class="text-lg font-bold text-ink mb-1">
            {d.telemetryTitle}
          </h2>
          <p class="text-xs text-muted">
            {d.telemetrySub}
          </p>
        </div>

        <!-- Primary Verdict Banner -->
        <div id="sfm-verdict-box" class="mb-6 p-4 rounded-2xl border transition-all bg-teal-950/40 border-teal-500/80 text-teal-200 shadow-md">
          <div class="flex items-start gap-3">
            <span class="text-xl">⚡</span>
            <div>
              <h3 id="sfm-verdict-title" class="font-extrabold text-sm tracking-tight mb-1">
                OPTIMAL SUPERCRITICAL MICRO-CELLULAR FOAM EXPANSION (91.2% POROSITY)
              </h3>
              <p id="sfm-verdict-desc" class="text-xs leading-relaxed text-teal-300/90">
                Controlled decompression at 450 bar/s generates uniform open-cell foam (cell diameter 28.5 µm). Desorption kinetics achieve finished water activity a_w = 0.21 in 7.8 minutes at 36°C with 98.4% vitamin C retention and 93.8% probiotic culture viability.
              </p>
            </div>
          </div>
        </div>

        <!-- 8-Card Telemetry Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3.5 mb-6">
          <!-- Foam Porosity -->
          <div class="p-3.5 rounded-2xl bg-surface-soft border border-hairline">
            <span class="text-muted block text-[10px] font-bold uppercase">{d.porosityLabel}</span>
            <span id="sfm-out-porosity" class="text-lg font-black text-teal-300 font-mono">91.2%</span>
            <span class="block text-[10px] text-emerald-400 font-mono">Target: 88–94%</span>
          </div>

          <!-- Mean Cell Diameter -->
          <div class="p-3.5 rounded-2xl bg-surface-soft border border-hairline">
            <span class="text-muted block text-[10px] font-bold uppercase">{d.poreSizeLabel}</span>
            <span id="sfm-out-pore-size" class="text-lg font-black text-cyan-300 font-mono">28.5 µm</span>
            <span class="block text-[10px] text-muted font-mono">Open-Cell &gt; 92%</span>
          </div>

          <!-- Ultrasonic Attenuation -->
          <div class="p-3.5 rounded-2xl bg-surface-soft border border-hairline">
            <span class="text-muted block text-[10px] font-bold uppercase">{d.acousticLabel}</span>
            <span id="sfm-out-acoustic" class="text-lg font-black text-emerald-300 font-mono">14.2 dB/cm</span>
            <span class="block text-[10px] text-teal-400 font-mono">400 kHz Acoustic DIP</span>
          </div>

          <!-- Drying Time -->
          <div class="p-3.5 rounded-2xl bg-surface-soft border border-hairline">
            <span class="text-muted block text-[10px] font-bold uppercase">{d.dryingTimeLabel}</span>
            <span id="sfm-out-drying-time" class="text-lg font-black text-amber-300 font-mono">7.8 min</span>
            <span class="block text-[10px] text-emerald-400 font-medium">Sub-10 min Cycle</span>
          </div>

          <!-- Water Activity -->
          <div class="p-3.5 rounded-2xl bg-surface-soft border border-hairline">
            <span class="text-muted block text-[10px] font-bold uppercase">{d.waterActivityLabel}</span>
            <span id="sfm-out-aw" class="text-lg font-black text-emerald-300 font-mono">0.21 a_w</span>
            <span class="block text-[10px] text-emerald-400 font-medium">Safe Shelf-Stable</span>
          </div>

          <!-- Vitamin C Retention -->
          <div class="p-3.5 rounded-2xl bg-surface-soft border border-hairline">
            <span class="text-muted block text-[10px] font-bold uppercase">{d.retentionLabel}</span>
            <span id="sfm-out-retention" class="text-lg font-black text-teal-300 font-mono">98.4%</span>
            <span class="block text-[10px] text-cyan-400 font-medium">Thermolabile Preserved</span>
          </div>

          <!-- Probiotic Viability -->
          <div class="p-3.5 rounded-2xl bg-surface-soft border border-hairline">
            <span class="text-muted block text-[10px] font-bold uppercase">{d.probioticLabel}</span>
            <span id="sfm-out-probiotic" class="text-lg font-black text-cyan-300 font-mono">93.8%</span>
            <span class="block text-[10px] text-emerald-400 font-medium">&gt;10^8 CFU/g Viable</span>
          </div>

          <!-- Specific Energy Consumption -->
          <div class="p-3.5 rounded-2xl bg-surface-soft border border-hairline">
            <span class="text-muted block text-[10px] font-bold uppercase">{d.secLabel}</span>
            <span id="sfm-out-sec" class="text-lg font-black text-amber-200 font-mono">0.88 kWh/kg</span>
            <span class="block text-[10px] text-emerald-400 font-medium">-75% vs Freeze Drying</span>
          </div>
        </div>

        <!-- Live Foam Bubble Geometry & In-Line Porosimeter State -->
        <div class="p-4 rounded-2xl bg-slate-950/60 border border-hairline flex flex-col items-center justify-center relative overflow-hidden">
          <div class="text-[11px] font-mono text-muted mb-2 w-full flex justify-between items-center">
            <span>In-Line Acoustic Porosimeter &amp; Foam Structure State:</span>
            <span id="sfm-foam-scale" class="text-teal-400 font-bold">Porosity ε = 91.2% (Micro-Cellular Open Foam)</span>
          </div>
          
          <div class="w-full h-24 bg-gradient-to-r from-slate-900 via-teal-950/40 to-slate-900 rounded-xl border border-hairline/60 flex items-center justify-around relative px-4">
            <!-- Simulated Foam Cell Bubble Array -->
            <div class="flex items-center gap-1.5" id="foam-bubble-visual-array">
              <div class="w-6 h-6 rounded-full border-2 border-teal-400/80 bg-teal-500/20 shadow-[0_0_8px_#14b8a6] animate-pulse"></div>
              <div class="w-5 h-5 rounded-full border-2 border-emerald-400/80 bg-emerald-500/20 shadow-[0_0_6px_#10b981]"></div>
              <div class="w-7 h-7 rounded-full border-2 border-cyan-400/80 bg-cyan-500/20 shadow-[0_0_10px_#06b6d4]"></div>
              <div class="w-5.5 h-5.5 rounded-full border-2 border-teal-300/80 bg-teal-400/20 shadow-[0_0_7px_#2dd4bf] animate-pulse"></div>
              <div class="w-6.5 h-6.5 rounded-full border-2 border-emerald-300/80 bg-emerald-400/20 shadow-[0_0_9px_#34d399]"></div>
            </div>

            <div class="text-center font-mono text-[11px]">
              <span class="text-muted block">Depressurization Rate:</span>
              <span id="sfm-dp-dt" class="text-cyan-400 font-bold">ΔP/Δt = 450 bar/s</span>
            </div>

            <div class="text-center font-mono text-[11px]">
              <span class="text-muted block">Acoustic Resonance:</span>
              <span id="sfm-res-freq" class="text-emerald-400 font-bold">f_res = 398.5 kHz</span>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>

  <!-- Interactive SVG Schematic Diagram -->
  <section class="bg-surface border border-hairline rounded-3xl p-6 sm:p-10 shadow-sm mb-8">
    <div class="mb-6">
