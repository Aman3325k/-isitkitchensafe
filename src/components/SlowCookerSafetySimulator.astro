<!-- Embedded JSON Raw Data for Client-Side Computation -->
<script type="application/json" id="sc-data-raw" set:html={JSON.stringify(slowCookerData)} />

<!-- Client-side Calculation & Interactive Controller -->
<script is:inline>
(function() {
  const root = document.querySelector('.slow-cooker-safety-widget');
  if (!root) return;

  const dataScript = document.getElementById('sc-data-raw');
  if (!dataScript) return;
  const data = JSON.parse(dataScript.textContent || '{}');

  const lang = root.dataset.lang || 'en';

  // Elements
  const crockSelect = document.getElementById('sc-crock-select');
  const crockDesc = document.getElementById('sc-crock-desc');
  const recipeSelect = document.getElementById('sc-recipe-select');
  const recipeDesc = document.getElementById('sc-recipe-desc');
  const settingSelect = document.getElementById('sc-setting-select');
  const settingDesc = document.getElementById('sc-setting-desc');
  const startTempSelect = document.getElementById('sc-start-temp-select');
  const timeSlider = document.getElementById('sc-time-slider');
  const timeDisplay = document.getElementById('sc-time-display');

  // Outputs
  const verdictCard = document.getElementById('sc-verdict-card');
  const gradeBadge = document.getElementById('sc-grade-badge');
  const verdictTitle = document.getElementById('sc-verdict-title');
  const verdictDesc = document.getElementById('sc-verdict-desc');

  const alertKidneyBean = document.getElementById('sc-alert-kidney-bean');
  const alertLead = document.getElementById('sc-alert-lead');
  const alertFrozenMeat = document.getElementById('sc-alert-frozen-meat');
  const alertWarmDanger = document.getElementById('sc-alert-warm-danger');

  const metricLead = document.getElementById('sc-metric-lead');
  const barLead = document.getElementById('sc-bar-lead');
  const metricFdaPercent = document.getElementById('sc-metric-fda-percent');
  const metricFdaStatus = document.getElementById('sc-metric-fda-status');
  const metricProp65 = document.getElementById('sc-metric-prop65');
  const metricProp65Status = document.getElementById('sc-metric-prop65-status');
  const metricDangerHours = document.getElementById('sc-metric-danger-hours');
  const metricDangerStatus = document.getElementById('sc-metric-danger-status');
  const metricSporeRisk = document.getElementById('sc-metric-spore-risk');
  const metricPhaToxin = document.getElementById('sc-metric-pha-toxin');
  const metricPhaStatus = document.getElementById('sc-metric-pha-status');

  const copyBtn = document.getElementById('sc-copy-btn');
  const copyToast = document.getElementById('sc-copy-toast');
  const presetBtns = document.querySelectorAll('.sc-preset-btn');

  function calculate() {
    const crockId = crockSelect.value;
    const crock = data.crockMaterials.find(c => c.id === crockId) || data.crockMaterials[0];
    const recipeId = recipeSelect.value;
    const recipe = data.recipeAcidityProfiles.find(r => r.id === recipeId) || data.recipeAcidityProfiles[0];
    const settingId = settingSelect.value;
    const setting = data.applianceSettings.find(s => s.id === settingId) || data.applianceSettings[0];
    const startTempId = startTempSelect.value;
    const startTemp = data.startingTemperatures.find(st => st.id === startTempId) || data.startingTemperatures[0];
    const hours = parseInt(timeSlider.value, 10);

    timeDisplay.textContent = `${hours} Hours`;

    if (crockDesc) crockDesc.textContent = crock.description;
    if (recipeDesc) recipeDesc.textContent = recipe.description;
    if (settingDesc) settingDesc.textContent = setting.description;

    // 1. Heavy Metal Leaching Calculation
    // Kinetics: M(t) = Baseline * AcidityMult * (t / 6)^0.85 * SettingFactor
    let settingFactor = 1.0;
    if (setting.id === 'high-setting') settingFactor = 1.35;
    else if (setting.id === 'keep-warm-proper') settingFactor = 0.65;
    else if (setting.id === 'keep-warm-faulty') settingFactor = 0.40;

    const timeFactor = Math.pow(hours / 6, 0.85);
    let leadPpb = Math.round(crock.leadBaselinePpb * recipe.leachMultiplier * timeFactor * settingFactor);
    let cadmiumPpb = Math.round(crock.cadmiumBaselinePpb * recipe.leachMultiplier * timeFactor * settingFactor);

    if (crock.id === 'stainless-steel-insert') {
      leadPpb = 0;
      cadmiumPpb = 0;
    }

    // Lead per 350ml serving in micrograms (µg)
    // 1 ppb = 1 µg/L. A 350ml bowl = 0.35 L.
    const leadServingUg = ((leadPpb * 0.35) / 1000) * 1000; // in µg
    const leadServingFormatted = leadServingUg < 0.01 ? (leadServingUg === 0 ? "0.000" : "< 0.01") : leadServingUg.toFixed(2);

    metricLead.textContent = leadPpb.toLocaleString();
    const leadBarWidth = Math.min(100, Math.round((leadPpb / 1000) * 100));
    barLead.style.width = `${Math.max(2, leadBarWidth)}%`;
    if (leadPpb > 1000) {
      barLead.className = "bg-rose-600 h-full transition-all duration-300";
    } else if (leadPpb > 150) {
      barLead.className = "bg-amber-500 h-full transition-all duration-300";
    } else {
      barLead.className = "bg-emerald-500 h-full transition-all duration-300";
    }

    // FDA Benchmark (1,000 ppb)
    const fdaPercent = Math.round((leadPpb / 1000) * 100);
    metricFdaPercent.textContent = `${fdaPercent}%`;
    if (leadPpb > 1000) {
      metricFdaPercent.className = "text-title-lg font-mono font-bold text-rose-600 dark:text-rose-400";
      metricFdaStatus.textContent = "✗ EXCEEDS FDA CPG 545.450 Limit";
      metricFdaStatus.className = "text-[10px] font-bold text-rose-700 dark:text-rose-300 block";
    } else {
      metricFdaPercent.className = "text-title-lg font-mono font-bold text-emerald-600 dark:text-emerald-400";
      metricFdaStatus.textContent = "✓ Complies with FDA CPG Limit";
      metricFdaStatus.className = "text-[10px] font-bold text-emerald-700 dark:text-emerald-300 block";
    }

    // Prop 65
    metricProp65.textContent = leadServingFormatted;
    if (leadServingUg > 0.5) {
      metricProp65Status.textContent = `Exceeds Prop 65 MADL (${(leadServingUg / 0.5).toFixed(1)}x limit)`;
      metricProp65Status.className = "text-[10px] font-bold text-rose-700 dark:text-rose-300 block";
    } else {
      metricProp65Status.textContent = "Under 0.5 µg/day MADL";
      metricProp65Status.className = "text-[10px] text-muted block";
    }

    // 2. Microbial Spore Incubation & Danger Zone
    let rampHours = setting.rampHoursToSafe + startTemp.dangerZonePenaltyHours;
    if (setting.id === 'keep-warm-faulty') {
      rampHours = hours; // Entire cook is inside danger zone!
    } else {
      rampHours = Math.min(hours, parseFloat(rampHours.toFixed(1)));
    }

    metricDangerHours.textContent = rampHours.toFixed(1);
    if (rampHours > 4.0 || setting.id === 'keep-warm-faulty') {
      metricDangerStatus.textContent = "VIOLATES USDA 4-Hour Rule";
      metricDangerStatus.className = "text-[10px] font-bold text-rose-700 dark:text-rose-300 block";
      metricSporeRisk.textContent = "CRITICAL / Germination";
      metricSporeRisk.className = "text-title-sm font-bold text-rose-600 dark:text-rose-400 block mt-1";
    } else if (rampHours > 2.5) {
      metricDangerStatus.textContent = "Moderate danger window";
      metricDangerStatus.className = "text-[10px] text-amber-700 dark:text-amber-300 block";
      metricSporeRisk.textContent = "Moderate / Elevated";
      metricSporeRisk.className = "text-title-sm font-bold text-amber-600 dark:text-amber-400 block mt-1";
    } else {
      metricDangerStatus.textContent = "USDA 4-Hour Rule: Compliant";
      metricDangerStatus.className = "text-[10px] text-muted block";
      metricSporeRisk.textContent = "Low / Inhibited";
      metricSporeRisk.className = "text-title-sm font-bold text-emerald-600 dark:text-emerald-400 block mt-1";
    }

    // 3. Phytohaemagglutinin (PHA) Toxicity (Kidney Beans)
    let phaUnits = 0;
    if (recipe.kidneyBeanRisk) {
      // Raw beans = ~35,000 HAU
      // If cooked sub-boiling (Low setting or Warm) = multiplies by up to 5x (up to 120,000 HAU!)
      // If cooked on High for >= 6h with gentle boil, might partially reduce, but slow cookers rarely reach rolling 212°F
      if (setting.id === 'low-setting' || setting.id === 'keep-warm-proper' || setting.id === 'keep-warm-faulty') {
        phaUnits = Math.round(35000 * 3.8); // ~133,000 HAU (extreme toxicity spike)
      } else {
        phaUnits = Math.round(35000 * 1.5); // Still highly toxic (~52,500 HAU)
      }
      metricPhaToxin.textContent = `${phaUnits.toLocaleString()} HAU`;
      metricPhaToxin.className = "text-title-sm font-bold text-rose-600 dark:text-rose-400 block mt-1 animate-pulse";
      metricPhaStatus.textContent = "⚠️ Extreme Biotoxin Spike (+380%)";
      metricPhaStatus.className = "text-[10px] font-bold text-rose-700 dark:text-rose-300 block";
    } else {
      metricPhaToxin.textContent = "0 HAU";
      metricPhaToxin.className = "text-title-sm font-bold text-ink block mt-1";
      metricPhaStatus.textContent = "No kidney beans in recipe";
      metricPhaStatus.className = "text-[10px] text-muted block";
    }

    // Context alerts visibility
    alertKidneyBean.classList.toggle('hidden', !recipe.kidneyBeanRisk);
    alertLead.classList.toggle('hidden', leadPpb <= 1000);
    alertFrozenMeat.classList.toggle('hidden', startTemp.id !== 'frozen-solid-block');
    alertWarmDanger.classList.toggle('hidden', setting.id !== 'keep-warm-faulty');

    // 4. Overall Triage Grade Determination
    let grade = 'A';
    if (recipe.kidneyBeanRisk || leadPpb > 1000 || setting.id === 'keep-warm-faulty') {
      grade = 'E';
    } else if (startTemp.id === 'frozen-solid-block' || leadPpb > 200 || rampHours > 4.0) {
      grade = 'D';
    } else if (crock.id === 'modern-crazed-ceramic' || leadPpb > 80 || rampHours > 3.0) {
      grade = 'C';
    } else if (leadPpb > 25) {
      grade = 'B';
    } else {
      grade = 'A';
    }

    // Update UI styling for Grade
    gradeBadge.textContent = `GRADE ${grade}`;
    if (grade === 'A') {
      gradeBadge.className = "px-3 py-1 rounded-full text-xs font-mono font-bold text-white bg-emerald-600";
      verdictCard.className = "rounded-3xl border border-emerald-500/30 bg-emerald-500/5 p-6 md:p-8 space-y-4 shadow-xs transition-colors";
      verdictTitle.textContent = getLocalizedText('statusOptimal', grade);
      verdictDesc.textContent = getLocalizedText('safeProtocolText', grade);
    } else if (grade === 'B') {
      gradeBadge.className = "px-3 py-1 rounded-full text-xs font-mono font-bold text-white bg-teal-600";
      verdictCard.className = "rounded-3xl border border-teal-500/30 bg-teal-500/5 p-6 md:p-8 space-y-4 shadow-xs transition-colors";
      verdictTitle.textContent = getLocalizedText('statusAcceptable', grade);
      verdictDesc.textContent = getLocalizedText('safeProtocolText', grade);
    } else if (grade === 'C') {
      gradeBadge.className = "px-3 py-1 rounded-full text-xs font-mono font-bold text-white bg-amber-600";
      verdictCard.className = "rounded-3xl border border-amber-500/30 bg-amber-500/5 p-6 md:p-8 space-y-4 shadow-xs transition-colors";
      verdictTitle.textContent = getLocalizedText('statusCaution', grade);
      verdictDesc.textContent = "Caution: Elevated heavy metal extraction into cooking broth or borderline thermal ramp through the bacterial danger zone. Follow mitigation steps below.";
    } else if (grade === 'D') {
      gradeBadge.className = "px-3 py-1 rounded-full text-xs font-mono font-bold text-white bg-orange-600";
      verdictCard.className = "rounded-3xl border border-orange-500/40 bg-orange-500/10 p-6 md:p-8 space-y-4 shadow-xs transition-colors";
      verdictTitle.textContent = getLocalizedText('statusHighHazard', grade);
      verdictDesc.textContent = "Hazard: Serious danger of foodborne bacterial spore outgrowth (Clostridium perfringens) due to excessive time in danger zone, or significant lead migration.";
    } else {
      gradeBadge.className = "px-3 py-1 rounded-full text-xs font-mono font-bold text-white bg-rose-700 animate-pulse";
      verdictCard.className = "rounded-3xl border border-rose-600/50 bg-rose-600/15 p-6 md:p-8 space-y-4 shadow-xs transition-colors";
      verdictTitle.textContent = getLocalizedText('statusCritical', grade);
      verdictDesc.textContent = "CRITICAL HEALTH HAZARD: Acute heavy metal poisoning risk from lead-leaching glaze, dangerous microbial incubation, or raw red kidney bean PHA lectin toxicity.";
    }
  }

  function getLocalizedText(key, grade) {
    const dict = {
      en: {
        statusOptimal: "GRADE A: MINIMAL HAZARD — CERTIFIED LEAD-FREE & MICROBIALLY COMPLIANT",
        statusAcceptable: "GRADE B: ACCEPTABLE — COMPLIES WITH FDA STANDARDS WITH PROPER HYGIENE",
        statusCaution: "GRADE C: CAUTION — ELEVATED HEAVY METAL LEACHING OR EXTENDED DANGER ZONE",
        statusHighHazard: "GRADE D: HIGH HAZARD — CRITICAL SPORE GERMINATION OR EXCEEDED FDA LIMITS",
        statusCritical: "GRADE E: CRITICAL TOXIC EMERGENCY — ACUTE HEAVY METAL POISONING OR SEVERE BIOTOXIN",
        safeProtocolText: "Vessel features certified lead-free vitrified glaze, ingredients are fully thawed, and thermal curve safely traverses the microbial danger zone well within USDA limits."
      },
      es: {
        statusOptimal: "GRADO A: MÁXIMA SEGURIDAD — SIN PLOMO Y MICROBIOLÓGICAMENTE SEGURO",
        statusAcceptable: "GRADO B: ACEPTABLE — CUMPLE NORMAS DE LA FDA CON MANEJO ADECUADO",
        statusCaution: "GRADO C: PRECAUCIÓN — LIXIVIACIÓN ELEVADA O TIEMPO PROLONGADO EN ZONA DE PELIGRO",
        statusHighHazard: "GRADO D: ALTO PELIGRO — GERMINACIÓN BACTERIANA O LÍMITES DE PLOMO EXCEDIDOS",
        statusCritical: "GRADO E: EMERGENCIA TÓXICA — INTOXICACIÓN AGUDA POR METALES O BIOTOXINAS",
        safeProtocolText: "Recipiente con esmalte vitrificado libre de plomo certificado, ingredientes descongelados y curva térmica segura."
      },
      pt: {
        statusOptimal: "GRAU A: SEGURANÇA MÁXIMA — ISENTO DE CHUMBO E MICROBIOLOGICAMENTE CONFORME",
        statusAcceptable: "GRAU B: ACEITÁVEL — CUMPRE AS NORMAS DA FDA COM MANUSEIO CORRETO",
        statusCaution: "GRAU C: ATENÇÃO — LIXIVIAÇÃO ELEVADA OU ZONA DE PERIGO PROLONGADA",
        statusHighHazard: "GRAU D: ALTO RISCO — GERMINAÇÃO DE ESPOROS OU CHUMBO ACIMA DOS LIMITES",
        statusCritical: "GRAU E: EMERGÊNCIA TÓXICA — INTOXICAÇÃO AGUDA POR METAIS OU BIOTOXINAS",
        safeProtocolText: "Recipiente com esmalte vitrificado livre de chumbo, ingredientes totalmente descongelados e curva térmica segura."
      },
      "zh-cn": {
        statusOptimal: "等级 A：极佳安全 — 经认证无铅内胆，微生物完全达标",
        statusAcceptable: "等级 B：合格达标 — 规范操作下符合美国 FDA 卫生标准",
        statusCaution: "等级 C：警惕风险 — 重金属微量溶出增加或处于危险温区时间偏长",
        statusHighHazard: "等级 D：高度危险 — 致病芽孢大量孵化或铅溶出明显超标",
        statusCritical: "等级 E：极度危险 — 急性重金属中毒隐患或烈性植物凝集素毒素",
        safeProtocolText: "内胆采用经认证的无铅玻化陶瓷，食材完全解冻，升温曲线在安全时间内快速跨越微生物危险温区。"
      },
      ja: {
        statusOptimal: "グレード A：極めて安全 — 認証済み無鉛内鍋・細菌リスクなし",
        statusAcceptable: "グレード B：安全許容範囲 — 正しい調理手順で FDA 基準に適合",
        statusCaution: "グレード C：注意 — 重金属溶出増加または危険温度帯滞留が長期化",
        statusHighHazard: "グレード D：高危険度 — 耐熱芽胞菌の急増または鉛基準値超過",
        statusCritical: "グレード E：緊急危険 — 急性鉛中毒リスクまたは強毒性植物レクチン",
        safeProtocolText: "内鍋は無鉛認証ガラス質釉薬を使用し、食材は完全に解冻され、安全な時間内に危険温度帯を通過しています。"
      }
    };
    const current = dict[lang] || dict.en;
    return current[key] || dict.en[key] || "";
  }

  // Event Listeners
  [crockSelect, recipeSelect, settingSelect, startTempSelect, timeSlider].forEach(el => {
    if (el) el.addEventListener('input', calculate);
    if (el) el.addEventListener('change', calculate);
  });

  // Presets
  presetBtns.forEach(btn => {
    btn.addEventListener('click', function() {
      const pId = this.dataset.preset;
      const preset = data.presets.find(p => p.id === pId);
      if (!preset) return;

      crockSelect.value = preset.crock;
      recipeSelect.value = preset.recipe;
      settingSelect.value = preset.setting;
      startTempSelect.value = preset.startTemp;
      timeSlider.value = preset.hours;

      calculate();
    });
  });

  // Copy diagnostic report
  if (copyBtn) {
    copyBtn.addEventListener('click', function() {
      const summaryText = `[IsItKitchenSafe Slow Cooker Safety Diagnostic Report]
Overall Safety Grade: ${gradeBadge.textContent}
Vessel Liner: ${crockSelect.options[crockSelect.selectedIndex].text}
Recipe Matrix: ${recipeSelect.options[recipeSelect.selectedIndex].text}
Setting: ${settingSelect.options[settingSelect.selectedIndex].text}
Initial Temp: ${startTempSelect.options[startTempSelect.selectedIndex].text}
Duration: ${timeSlider.value} Hours

Quantitative Metrics:
- Estimated Lead (Pb) Leaching: ${metricLead.textContent} ppb (FDA CPG Limit: 1,000 ppb)
- FDA CPG Compliance: ${metricFdaPercent.textContent}
- Lead Intake per 350ml Bowl: ${metricProp65.textContent} µg (Cal Prop 65 MADL: 0.5 µg/day)
- Danger Zone Time (40°F-140°F): ${metricDangerHours.textContent} Hours (USDA 4-Hour Rule)
- C. perfringens Spore Risk: ${metricSporeRisk.textContent}
- PHA Lectin Toxicity: ${metricPhaToxin.textContent}

Diagnostic Verdict:
${verdictTitle.textContent}
${verdictDesc.textContent}

Verified via FDA CPG Sec 545.450 & USDA-FSIS Protocols.
https://isitkitchensafe.com/tools/slow-cooker-safety-simulator/`;

      navigator.clipboard.writeText(summaryText).then(() => {
        if (copyToast) {
          copyToast.classList.remove('hidden');
          setTimeout(() => {
            copyToast.classList.add('hidden');
          }, 4000);
        }
      });
    });
  }

  // Initial calculation
  calculate();
})();
</script>
