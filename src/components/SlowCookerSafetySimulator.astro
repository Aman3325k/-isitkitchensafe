    stepThawText: "肉類は必ず冷蔵庫で完全解凍：大きな肉のかたまりや丸鶏は、調理前に必ず冷蔵庫で完全に解凍し、冷凍のまま投入して中心部を長時間ぬるま湯状態にしないでください。",
    stepCrockText: "貫入（ひび割れ）陶器や古い年代物の破棄：1980年以前の古い鍋や未認証の土鍋は使用を避け、釉薬表面にクモの巣状の細かいひび割れ（貫入）が生じた内鍋は細菌や重金属のリスクがあるため交換してください。",
    stepTempCheckText: "保温温度を温度計で確認：食品用温度計を使用し、保温設定時にスープが常に 63℃（145°F）以上を保っていることを確認してください。",
    guideTitle: "スロークッカーの毒性学・釉薬冶金学・芽胞動力学",
    guideSub: "FDA 陶磁器規制値、ウェルシュ菌芽胞の熱抵抗性、およびレクチン失活メカニズム：",
    copyReportBtn: "📋 スロークッカー安全診断カルテをコピー",
    reportCopied: "✓ 診断カルテがクリップボードにコピーされました！",
    crossLinkTitle: "他のキッチン安全性診断ツールを試す：",
    crossLinkAirFryer: "ノンフライヤー・アクリルアミド生成計算機",
    crossLinkSousVide: "低温調理プラスチック溶出診断ツール",
    crossLinkWater: "逆浸透膜（RO）浄水器効率＆フッ素診断ツール",
    crossLinkOil: "食用油発煙点シミュレーター",
    crossLinkScorecard: "調理器具PFAS溶出カルテ"
  }
};

const d = DICT[lang] || DICT.en;
const prefix = lang === 'en' ? '' : `/${lang}`;
---

<div class="slow-cooker-safety-widget space-y-12" data-lang={lang}>
  <!-- Hero / Header Card -->
  <div class="rounded-3xl border border-hairline bg-surface p-6 md:p-10 shadow-xs relative overflow-hidden">
    <div class="absolute -right-16 -top-16 w-64 h-64 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="relative z-10 max-w-3xl space-y-4">
      <div class="flex flex-wrap items-center gap-2">
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-700 text-white">
          {d.badge}
        </span>
        <span class="text-xs text-muted font-mono">FDA CPG 545.450 &bull; C. perfringens &bull; PHA Lectin</span>
      </div>

      <h2 class="text-display-sm md:text-display-md font-medium text-ink tracking-tight">
        {d.title}
      </h2>

      <p class="text-body text-sm md:text-base leading-relaxed">
        {d.subtitle}
      </p>

      <!-- Quick Preset Buttons -->
      <div class="pt-2">
        <span class="text-xs font-bold uppercase tracking-wider text-muted block mb-2">
          {d.presetsTitle}
        </span>
        <div class="flex flex-wrap gap-2">
          <button type="button" class="sc-preset-btn px-3 py-1.5 rounded-lg border border-hairline bg-surface-soft hover:bg-surface-strong text-xs font-medium text-ink transition-colors cursor-pointer" data-preset="preset-beef-stew">
            {d.presetBeefStew}
          </button>
          <button type="button" class="sc-preset-btn px-3 py-1.5 rounded-lg border border-hairline bg-surface-soft hover:bg-surface-strong text-xs font-medium text-ink transition-colors cursor-pointer" data-preset="preset-pulled-pork">
            {d.presetPulledPork}
          </button>
          <button type="button" class="sc-preset-btn px-3 py-1.5 rounded-lg border border-rose-500/30 bg-rose-500/10 hover:bg-rose-500/20 text-xs font-medium text-rose-800 dark:text-rose-300 transition-colors cursor-pointer" data-preset="preset-grandma">
            {d.presetGrandma}
          </button>
          <button type="button" class="sc-preset-btn px-3 py-1.5 rounded-lg border border-rose-600/40 bg-rose-600/15 hover:bg-rose-600/25 text-xs font-bold text-rose-900 dark:text-rose-200 transition-colors cursor-pointer" data-preset="preset-kidney-beans">
            {d.presetKidneyBeans}
          </button>
          <button type="button" class="sc-preset-btn px-3 py-1.5 rounded-lg border border-amber-500/30 bg-amber-500/10 hover:bg-amber-500/20 text-xs font-medium text-amber-800 dark:text-amber-300 transition-colors cursor-pointer" data-preset="preset-frozen-roast">
            {d.presetFrozenRoast}
          </button>
          <button type="button" class="sc-preset-btn px-3 py-1.5 rounded-lg border border-rose-700/40 bg-rose-700/15 hover:bg-rose-700/25 text-xs font-bold text-rose-950 dark:text-rose-100 transition-colors cursor-pointer" data-preset="preset-barro-beans">
            {d.presetArtisanalBarro}
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Interactive Simulator Grid: Left Controls / Right Results -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Left Column: Controls (5 Cols) -->
    <div class="lg:col-span-5 bg-surface border border-hairline rounded-3xl p-6 md:p-8 space-y-6 shadow-xs">
      <div>
        <h3 class="text-title-md font-medium text-ink tracking-tight">
          {d.controlsTitle}
        </h3>
        <p class="text-xs text-muted mt-1 leading-relaxed">
          {d.controlsSub}
        </p>
      </div>

      <!-- 1. Crock Material & Age -->
      <div class="space-y-2">
        <label for="sc-crock-select" class="text-xs font-bold uppercase tracking-wider text-muted block">
          {d.crockLabel}
        </label>
        <select id="sc-crock-select" class="w-full bg-surface-soft border border-hairline rounded-xl px-3.5 py-2.5 text-xs md:text-sm text-ink focus:outline-hidden focus:ring-2 focus:ring-amber-500/40 transition-shadow">
          {slowCookerData.crockMaterials.map(m => (
            <option value={m.id}>{m.name}</option>
          ))}
        </select>
        <p id="sc-crock-desc" class="text-[11px] text-muted leading-relaxed">
          {slowCookerData.crockMaterials[0].description}
        </p>
      </div>

      <!-- 2. Recipe Acidity Profile -->
      <div class="space-y-2">
        <label for="sc-recipe-select" class="text-xs font-bold uppercase tracking-wider text-muted block">
          {d.recipeLabel}
        </label>
        <select id="sc-recipe-select" class="w-full bg-surface-soft border border-hairline rounded-xl px-3.5 py-2.5 text-xs md:text-sm text-ink focus:outline-hidden focus:ring-2 focus:ring-amber-500/40 transition-shadow">
          {slowCookerData.recipeAcidityProfiles.map(r => (
            <option value={r.id}>{r.name}</option>
          ))}
        </select>
        <p id="sc-recipe-desc" class="text-[11px] text-muted leading-relaxed">
          {slowCookerData.recipeAcidityProfiles[0].description}
        </p>
      </div>

      <!-- 3. Operating Heat Setting -->
      <div class="space-y-2">
        <label for="sc-setting-select" class="text-xs font-bold uppercase tracking-wider text-muted block">
          {d.settingLabel}
        </label>
        <select id="sc-setting-select" class="w-full bg-surface-soft border border-hairline rounded-xl px-3.5 py-2.5 text-xs md:text-sm text-ink focus:outline-hidden focus:ring-2 focus:ring-amber-500/40 transition-shadow">
          {slowCookerData.applianceSettings.map(s => (
            <option value={s.id}>{s.name}</option>
          ))}
        </select>
        <p id="sc-setting-desc" class="text-[11px] text-muted leading-relaxed">
          {slowCookerData.applianceSettings[0].description}
        </p>
      </div>

      <!-- 4. Initial Temperature State -->
      <div class="space-y-2">
        <label for="sc-start-temp-select" class="text-xs font-bold uppercase tracking-wider text-muted block">
          {d.startTempLabel}
        </label>
        <select id="sc-start-temp-select" class="w-full bg-surface-soft border border-hairline rounded-xl px-3.5 py-2.5 text-xs md:text-sm text-ink focus:outline-hidden focus:ring-2 focus:ring-amber-500/40 transition-shadow">
          {slowCookerData.startingTemperatures.map(st => (
            <option value={st.id}>{st.name}</option>
          ))}
        </select>
      </div>

      <!-- 5. Cooking Duration Slider -->
      <div class="space-y-2 pt-2">
        <div class="flex items-center justify-between text-xs">
          <label for="sc-time-slider" class="font-bold uppercase tracking-wider text-muted">
            {d.timeLabel}
          </label>
          <span id="sc-time-display" class="font-mono font-bold text-ink bg-surface-soft px-2.5 py-1 rounded-md border border-hairline">
            8 Hours
          </span>
        </div>
        <input 
          id="sc-time-slider" 
          type="range" 
          min="2" 
          max="14" 
          step="1" 
          value="8" 
          class="w-full h-2 bg-zinc-200 dark:bg-zinc-700 rounded-lg appearance-none cursor-pointer accent-amber-600"
        />
        <div class="flex justify-between text-[10px] text-muted font-mono">
          <span>2 hrs (Quick warm)</span>
          <span>8 hrs (Standard)</span>
          <span>14 hrs (Overnight)</span>
        </div>
      </div>
    </div>

    <!-- Right Column: Diagnostic Output Card & Metrics (7 Cols) -->
    <div class="lg:col-span-7 space-y-6">
      <!-- Main Status Card -->
      <div id="sc-verdict-card" class="rounded-3xl border border-hairline bg-surface p-6 md:p-8 space-y-4 shadow-xs transition-colors">
        <div class="flex items-center justify-between gap-2 border-b border-hairline/60 pb-3">
          <span class="text-xs font-bold uppercase tracking-wider text-muted">
            {d.overallStatusLabel}
          </span>
          <span id="sc-grade-badge" class="px-3 py-1 rounded-full text-xs font-mono font-bold text-white bg-emerald-600">
