    presetBeefStew: "🍲 定番ビーフシチュー",
    presetPulledPork: "🍖 リンゴ酢プルドポーク",
    presetGrandma: "🏺 1970年代アンティーク陶器鍋",
    presetKidneyBeans: "⚠️ 生赤インゲン豆チリ",
