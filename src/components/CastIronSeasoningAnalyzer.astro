      <!-- Critical Warnings Banner (Dynamic) -->
      <div id="ci-warning-box" class="hidden rounded-xl p-4 border text-xs leading-relaxed transition-all">
        <div class="flex items-center gap-2 font-bold mb-1" id="ci-warning-heading">
          <span>⚠️</span>
