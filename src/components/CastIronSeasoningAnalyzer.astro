          </div>
          <p class="text-[11px] text-muted leading-tight">Thermal bake within covalent bonding threshold without smoke breakdown.</p>
        </div>
      </div>

      <!-- Iron Leaching Simulation Output -->
      <div class="bg-amber-50/60 border border-amber-200/80 rounded-2xl p-5">
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-bold uppercase tracking-wider text-amber-900">
            {d.ironLeachLabel}
          </span>
          <span id="ci-iron-mg" class="text-lg font-black font-mono text-amber-900">
            0.3 mg Fe
          </span>
        </div>
        <div class="w-full bg-amber-200/50 rounded-full h-2 overflow-hidden mb-2">
          <div id="ci-iron-bar" class="bg-amber-600 h-2 rounded-full transition-all" style="width: 4%;"></div>
        </div>
        <div class="flex items-center justify-between text-xs text-amber-900">
          <span>{d.rdaPercentageLabel}</span>
          <span id="ci-iron-pct" class="font-mono font-bold">3.8% of RDA</span>
        </div>
        <p id="ci-iron-note" class="text-[11px] text-amber-800/90 mt-2 leading-relaxed">
          Neutral cooking foods (steaks, burgers) deposit protective lipid monolayers and release virtually zero dietary iron.
        </p>
      </div>
    </div>
  </div>

  <!-- Comparison Table: 10 Seasoning Fats -->
  <div class="bg-white border border-hairline rounded-2xl p-6 md:p-8 shadow-2xs mb-12">
    <div class="mb-6">
      <h3 class="text-lg md:text-xl font-bold text-ink mb-1">
        {d.oilComparisonTitle}
      </h3>
      <p class="text-xs md:text-sm text-muted">
        {d.oilComparisonSub}
      </p>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-xs">
        <thead>
          <tr class="border-b border-hairline text-ink font-bold bg-surface-soft">
            <th class="py-3 px-3">{d.colOil}</th>
            <th class="py-3 px-3">{d.colIodine}</th>
            <th class="py-3 px-3">{d.colSmokePoint}</th>
            <th class="py-3 px-3">{d.colFattyAcids}</th>
            <th class="py-3 px-3">{d.colDurability}</th>
            <th class="py-3 px-3">{d.colVerdict}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline">
          {seasoningData.oils.map(o => (
            <tr class="hover:bg-surface-soft/60 transition-colors">
              <td class="py-3 px-3 font-semibold text-ink whitespace-nowrap">
                {o.name}
                {o.recommended && <span class="ml-1.5 text-[10px] font-bold text-emerald-800 bg-emerald-100 px-1.5 py-0.5 rounded">Top Choice</span>}
              </td>
              <td class="py-3 px-3 font-mono font-medium">{o.iodineValue}</td>
              <td class="py-3 px-3 font-mono">{o.smokePointF}°F ({o.smokePointC}°C)</td>
              <td class="py-3 px-3 text-muted text-[11px]">
                {o.fattyAcids.polyunsaturated}% Poly | {o.fattyAcids.monounsaturated}% Mono | {o.fattyAcids.saturated}% Sat
              </td>
              <td class="py-3 px-3 font-mono font-bold">
                <span class={o.durabilityScore >= 85 ? 'text-emerald-700' : (o.durabilityScore >= 60 ? 'text-amber-700' : 'text-red-700')}>
                  {o.durabilityScore}/100
                </span>
              </td>
              <td class="py-3 px-3 text-body text-[11px] max-w-xs">{o.chefVerdict}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Culinary Protocols & Chemistry Rules -->
  <div class="bg-canvas border border-hairline rounded-2xl p-6 md:p-8">
    <div class="mb-6">
      <h3 class="text-lg md:text-xl font-bold text-ink mb-1">
        {d.culinaryProtocolsTitle}
      </h3>
      <p class="text-xs md:text-sm text-muted">
        {d.culinaryProtocolsSub}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="p-5 rounded-xl bg-surface-soft border border-hairline/80">
        <h4 class="text-sm font-bold text-ink mb-2">{d.rule1Title}</h4>
        <p class="text-xs text-body leading-relaxed">{d.rule1Text}</p>
      </div>
      <div class="p-5 rounded-xl bg-surface-soft border border-hairline/80">
        <h4 class="text-sm font-bold text-ink mb-2">{d.rule2Title}</h4>
        <p class="text-xs text-body leading-relaxed">{d.rule2Text}</p>
      </div>
      <div class="p-5 rounded-xl bg-surface-soft border border-hairline/80">
        <h4 class="text-sm font-bold text-ink mb-2">{d.rule3Title}</h4>
        <p class="text-xs text-body leading-relaxed">{d.rule3Text}</p>
      </div>
      <div class="p-5 rounded-xl bg-surface-soft border border-hairline/80">
        <h4 class="text-sm font-bold text-ink mb-2">{d.rule4Title}</h4>
        <p class="text-xs text-body leading-relaxed">{d.rule4Text}</p>
      </div>
    </div>
  </div>

  <!-- Cross Links -->
  <div class="mt-8 pt-6 border-t border-hairline/80">
    <span class="text-xs font-bold uppercase tracking-wider text-muted block mb-3">{d.crossLinkTitle}</span>
    <div class="flex flex-wrap gap-3">
      <a href="/tools/culinary-oil-smoke-point-simulator/" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-surface-soft hover:bg-surface-strong border border-hairline text-xs font-medium text-ink transition-colors">
        🔥 {d.crossLinkCulinaryOil} &rarr;
      </a>
      <a href="/tools/toxic-leaching-scorecard/" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-surface-soft hover:bg-surface-strong border border-hairline text-xs font-medium text-ink transition-colors">
        🧪 {d.crossLinkToxicLeaching} &rarr;
      </a>
      <a href="/tools/pan-scratch-inspector/" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-surface-soft hover:bg-surface-strong border border-hairline text-xs font-medium text-ink transition-colors">
        🍳 {d.crossLinkPanScratch} &rarr;
      </a>
    </div>
  </div>
</div>

<script>
  function initCastIronAnalyzer() {
    const root = document.querySelector('.ci-seasoning-tool');
    if (!root) return;

    const dataAttr = root.getAttribute('data-ci-payload');
    const lang = root.getAttribute('data-lang') || 'en';
    if (!dataAttr) return;

    let dataset;
    try {
      dataset = JSON.parse(dataAttr);
    } catch (e) {
      console.error('Failed to parse seasoning data:', e);
      return;
    }

    const oilSelect = document.getElementById('ci-oil-select') as HTMLSelectElement | null;
    const substrateSelect = document.getElementById('ci-substrate-select') as HTMLSelectElement | null;
    const tempSlider = document.getElementById('ci-temp-slider') as HTMLInputElement | null;
    const tempVal = document.getElementById('ci-temp-val');
    const thicknessSelect = document.getElementById('ci-thickness-select') as HTMLSelectElement | null;
    const foodSelect = document.getElementById('ci-food-select') as HTMLSelectElement | null;
    const dwellSlider = document.getElementById('ci-dwell-slider') as HTMLInputElement | null;
    const dwellVal = document.getElementById('ci-dwell-val');

    // Telemetry output elements
    const bakeDeltaPill = document.getElementById('ci-bake-delta-pill');
    const statusCard = document.getElementById('ci-status-card');
    const statusTitle = document.getElementById('ci-status-title');
    const statusDesc = document.getElementById('ci-status-desc');
    const scoreNum = document.getElementById('ci-score-number');

    const warningBox = document.getElementById('ci-warning-box');
    const warningText = document.getElementById('ci-warning-text');

    const hardnessVal = document.getElementById('ci-hardness-val');
    const hardnessBar = document.getElementById('ci-hardness-bar');
    const flexVal = document.getElementById('ci-flex-val');
    const flexBar = document.getElementById('ci-flex-bar');
    const flakingVal = document.getElementById('ci-flaking-val');
    const flakingBar = document.getElementById('ci-flaking-bar');
    const peroxideVal = document.getElementById('ci-peroxide-val');
    const peroxideBar = document.getElementById('ci-peroxide-bar');

    const ironMg = document.getElementById('ci-iron-mg');
    const ironBar = document.getElementById('ci-iron-bar');
    const ironPct = document.getElementById('ci-iron-pct');
    const ironNote = document.getElementById('ci-iron-note');

    const copyBtn = document.getElementById('ci-copy-btn');
    const copyText = document.getElementById('ci-copy-text');

    function calculate() {
      if (!oilSelect || !substrateSelect || !tempSlider || !thicknessSelect || !foodSelect || !dwellSlider) return;

      const oilId = oilSelect.value;
      const substrateId = substrateSelect.value;
      const tempF = parseInt(tempSlider.value, 10);
      const tempC = Math.round((tempF - 32) * (5 / 9));
      const thickness = thicknessSelect.value;
      const foodId = foodSelect.value;
      const dwellMins = parseInt(dwellSlider.value, 10);

      if (tempVal) tempVal.textContent = `${tempF}°F (${tempC}°C)`;
      if (dwellVal) dwellVal.textContent = `${dwellMins} min`;

      const oil = dataset.oils.find((o: any) => o.id === oilId) || dataset.oils[0];
      const sub = dataset.cookwareSubstrates.find((s: any) => s.id === substrateId) || dataset.cookwareSubstrates[0];
      const food = dataset.acidicFoods.find((f: any) => f.id === foodId) || dataset.acidicFoods[0];

      const tempDelta = tempF - oil.smokePointF;

      // Delta Pill formatting
      if (bakeDeltaPill) {
        if (tempDelta < -10) {
          bakeDeltaPill.className = 'text-[11px] font-mono px-2 py-0.5 rounded font-semibold bg-amber-100 text-amber-900 border border-amber-200';
          bakeDeltaPill.textContent = `${tempDelta}°F Below Smoke Point (Underheated)`;
        } else if (tempDelta <= 60) {
          bakeDeltaPill.className = 'text-[11px] font-mono px-2 py-0.5 rounded font-semibold bg-emerald-100 text-emerald-900 border border-emerald-200';
          bakeDeltaPill.textContent = `+${tempDelta}°F Over Smoke Point (Optimal)`;
        } else {
          bakeDeltaPill.className = 'text-[11px] font-mono px-2 py-0.5 rounded font-semibold bg-red-100 text-red-900 border border-red-200';
          bakeDeltaPill.textContent = `+${tempDelta}°F Over Smoke Point (Pyrolysis/Char Risk)`;
        }
      }

      // Special Check 1: Enameled Cast Iron
      if (substrateId === 'enameled-cast-iron') {
        if (statusCard) statusCard.className = 'rounded-2xl p-5 border transition-all bg-red-50 border-red-300';
        if (statusTitle) statusTitle.textContent = 'INCOMPATIBLE: ENAMELED CAST IRON';
        if (statusDesc) statusDesc.textContent = 'Enameled cookware is fused with impervious vitreous glass enamel. DO NOT SEASON. Oil baked onto enamel scorches a sticky burnt varnish.';
        if (scoreNum) {
          scoreNum.textContent = '0';
          scoreNum.className = 'text-4xl md:text-5xl font-black font-mono text-red-800';
        }
        if (warningBox && warningText) {
          warningBox.className = 'rounded-xl p-4 border bg-red-50 border-red-300 text-red-950 block';
          warningText.textContent = 'Never apply seasoning oils to enameled cast iron (Le Creuset, Staub). It damages non-stick release and requires heavy baking soda / lye restoration.';
        }
        return;
      }

      // Special Check 2: Non-drying oils (Coconut Oil)
      if (oil.iodineValue < 25) {
        if (statusCard) statusCard.className = 'rounded-2xl p-5 border transition-all bg-amber-50 border-amber-300';
        if (statusTitle) statusTitle.textContent = 'INERT NON-POLYMERIZING FAT (ZERO DRYING CAPACITY)';
        if (statusDesc) statusDesc.textContent = 'Coconut oil is 90%+ saturated fat without double bonds. It cannot undergo radical cross-linking and melts into liquid grease at 76°F.';
        if (scoreNum) {
          scoreNum.textContent = '20';
          scoreNum.className = 'text-4xl md:text-5xl font-black font-mono text-amber-800';
        }
        if (warningBox && warningText) {
          warningBox.className = 'rounded-xl p-4 border bg-amber-50 border-amber-200 text-amber-950 block';
          warningText.textContent = 'Saturated fats like coconut oil cannot form a polymer. The pan will wash clean down to bare iron upon first contact with warm water.';
        }
        return;
      }

      // Base quality score calculation
      let score = oil.durabilityScore;

      // Temperature adjustment
      if (tempF < oil.smokePointF) {
        score -= 35; // Severe underheating penalty
      } else if (tempF > 520 && oil.smokePointF < 420) {
        score -= 30; // Severe pyrolysis penalty
      }

      // Thickness adjustment
      if (thickness === 'light-coat') {
        score -= 8;
      } else if (thickness === 'heavy-pooled') {
        score -= 35; // Gummy alligator skin
      }

      // Substrate bonus / penalty
      if (sub.porosityLevel === 'Low' && thickness === 'heavy-pooled') {
        score -= 10;
      }

      score = Math.max(15, Math.min(98, score));

      // Flaking hazard
      let flakingPercent = 100 - oil.flakingResistance;
      if (oil.id === 'flaxseed-oil') flakingPercent = 65; // Flaxseed brittle glass paradox
      if (thickness === 'heavy-pooled') flakingPercent += 20;
      if (sub.id === 'vintage-smooth-machined-iron') flakingPercent += 10;
      flakingPercent = Math.min(95, Math.max(5, flakingPercent));

      // Hardness & Flexibility
      let hardness = oil.polymerHardness;
      let flex = oil.crosslinkFlexibility;
      if (tempF < oil.smokePointF) {
        hardness = Math.round(hardness * 0.4);
        flex = Math.round(flex * 0.5);
      }

      // Peroxide / Acrolein
      let peroxideStr = 'Low';
      let peroxidePct = 10;
      if (tempF >= 500 && oil.smokePointF <= 380) {
        peroxideStr = 'Severe (Acrolein Irritant)';
        peroxidePct = 85;
      } else if (tempF >= 475) {
        peroxideStr = 'Moderate';
        peroxidePct = 40;
      }

      // Status Title & Desc
      if (score >= 85) {
        if (statusCard) statusCard.className = 'rounded-2xl p-5 border transition-all bg-emerald-50 border-emerald-200';
        if (statusTitle) statusTitle.textContent = 'OPTIMAL CROSS-LINKED POLYMER (RESILIENT DUCTILE MATRIX)';
        if (statusDesc) statusDesc.textContent = 'Superb fatty acid cross-linking. Covalently anchors to iron micropores, resisting flaking and thermal expansion stress.';
        if (scoreNum) {
          scoreNum.textContent = score.toString();
          scoreNum.className = 'text-4xl md:text-5xl font-black font-mono text-emerald-800';
        }
      } else if (oil.id === 'flaxseed-oil' && score > 50) {
        if (statusCard) statusCard.className = 'rounded-2xl p-5 border transition-all bg-rose-50 border-rose-300';
        if (statusTitle) statusTitle.textContent = 'HIGH-STRESS BRITTLE GLASS (SEVERE FLAKING DELAMINATION)';
        if (statusDesc) statusDesc.textContent = 'Excessive alpha-linolenic cross-linking generates hyper-hard but brittle crystalline sheets that delaminate in black flakes after several thermal cycles.';
        if (scoreNum) {
          scoreNum.textContent = score.toString();
          scoreNum.className = 'text-4xl md:text-5xl font-black font-mono text-rose-800';
        }
      } else if (thickness === 'heavy-pooled' || tempF < oil.smokePointF) {
        if (statusCard) statusCard.className = 'rounded-2xl p-5 border transition-all bg-amber-50 border-amber-300';
        if (statusTitle) statusTitle.textContent = 'UNDER-POLYMERIZED STICKY GUM (UNREACTED TRIGLYCERIDES)';
        if (statusDesc) statusDesc.textContent = 'Unreacted liquid triglycerides formed viscous sticky oligomers. Requires high-heat upside-down oven cure to prevent dust trapping and rancidity.';
        if (scoreNum) {
          scoreNum.textContent = score.toString();
          scoreNum.className = 'text-4xl md:text-5xl font-black font-mono text-amber-800';
        }
      } else {
        if (statusCard) statusCard.className = 'rounded-2xl p-5 border transition-all bg-red-50 border-red-300';
        if (statusTitle) statusTitle.textContent = 'THERMAL PYROLYSIS & CHAR (ACROLEIN & PAH FORMATION)';
        if (statusDesc) statusDesc.textContent = 'Excessive temperatures pyrolyzed oil into brittle carbon ash and volatile eye/mucosal irritants rather than cross-linked polymers.';
        if (scoreNum) {
          scoreNum.textContent = score.toString();
          scoreNum.className = 'text-4xl md:text-5xl font-black font-mono text-red-800';
        }
      }

      // Warnings
      if (warningBox && warningText) {
        if (oil.id === 'flaxseed-oil') {
          warningBox.className = 'rounded-xl p-4 border bg-rose-50 border-rose-300 text-rose-950 block';
          warningText.textContent = "Flaxseed oil's extreme iodine value (185) creates a hyper-cross-linked polymer with excessive internal shear strain. Under thermal cycling or metal utensil shear, it shatters and flakes off in black scales.";
        } else if (oil.id === 'bacon-grease') {
          warningBox.className = 'rounded-xl p-4 border bg-amber-50 border-amber-300 text-amber-950 block';
          warningText.textContent = "Bacon grease contains table salt (NaCl) and curing nitrates. Halide ions catalyze localized pitting corrosion on bare iron, and meat protein solids scorch into abrasive carbon crust.";
        } else if (oil.id === 'avocado-oil' && tempF < 500) {
          warningBox.className = 'rounded-xl p-4 border bg-amber-50 border-amber-300 text-amber-950 block';
          warningText.textContent = "Refined avocado oil's 520°F smoke point requires a 550°F oven to polymerize oleic acid. At lower baking temperatures, unreacted triglycerides form a tacky, gummy varnish that ruins food release.";
        } else if (food.pH < 4.2 && dwellMins >= 30) {
          warningBox.className = 'rounded-xl p-4 border bg-red-50 border-red-300 text-red-950 block';
          warningText.textContent = "Simmering acidic sauces (pH < 4.2) for over 30 minutes in cast iron leaches excessive iron (20-40+ mg/serving) and dissolves the polymer layer. Contraindicated for individuals with Hereditary Hemochromatosis.";
        } else {
          warningBox.className = 'hidden';
        }
      }

      // Gauges Update
      if (hardnessVal) hardnessVal.textContent = `${hardness} / 100`;
      if (hardnessBar) hardnessBar.style.width = `${hardness}%`;
      if (flexVal) flexVal.textContent = `${flex} / 100`;
      if (flexBar) flexBar.style.width = `${flex}%`;
      if (flakingVal) flakingVal.textContent = `${flakingPercent}% (${flakingPercent > 50 ? 'High' : (flakingPercent > 20 ? 'Moderate' : 'Low')})`;
      if (flakingBar) {
        flakingBar.style.width = `${flakingPercent}%`;
        flakingBar.className = flakingPercent > 50 ? 'bg-red-500 h-2 rounded-full transition-all' : (flakingPercent > 20 ? 'bg-amber-500 h-2 rounded-full transition-all' : 'bg-emerald-500 h-2 rounded-full transition-all');
      }
      if (peroxideVal) peroxideVal.textContent = peroxideStr;
      if (peroxideBar) {
        peroxideBar.style.width = `${peroxidePct}%`;
        peroxideBar.className = peroxidePct > 50 ? 'bg-red-500 h-2 rounded-full transition-all' : 'bg-emerald-500 h-2 rounded-full transition-all';
      }

      // Iron Leaching Simulation
      let ironLeached = (food.ironLeachRateMgPerHour * (dwellMins / 60));
      if (score < 70) ironLeached *= 1.8; // weak seasoning leaches faster
      ironLeached = Math.round(ironLeached * 10) / 10;

      const rdaMale = 8.0;
      const pctRDA = Math.round((ironLeached / rdaMale) * 100);

      if (ironMg) ironMg.textContent = `${ironLeached} mg Fe`;
      if (ironPct) ironPct.textContent = `${pctRDA}% of Adult Male RDA (8 mg)`;
      if (ironBar) {
        const barW = Math.min(100, Math.round((ironLeached / 45.0) * 100));
        ironBar.style.width = `${barW}%`;
        ironBar.className = ironLeached > 30 ? 'bg-red-600 h-2 rounded-full transition-all' : (ironLeached > 10 ? 'bg-amber-600 h-2 rounded-full transition-all' : 'bg-emerald-600 h-2 rounded-full transition-all');
      }
      if (ironNote) {
        if (ironLeached > 25) {
          ironNote.textContent = `ALERT: High iron extraction (${ironLeached} mg). Turns sauces dark metallic brown. Exceeds standard daily requirements. Avoid if managing iron storage diseases.`;
        } else if (ironLeached > 5) {
          ironNote.textContent = `Moderate iron transfer (${ironLeached} mg). Beneficial nutritional fortification for individuals with iron-deficiency anemia.`;
        } else {
          ironNote.textContent = `Minimal iron extraction (${ironLeached} mg). Fully cured seasoning protects both cookware and delicate food flavors.`;
        }
      }
    }

    // Attach listeners
    oilSelect?.addEventListener('change', calculate);
    substrateSelect?.addEventListener('change', calculate);
    tempSlider?.addEventListener('input', calculate);
    thicknessSelect?.addEventListener('change', calculate);
    foodSelect?.addEventListener('change', calculate);
    dwellSlider?.addEventListener('input', calculate);

    // Preset Buttons
    document.querySelectorAll('.ci-preset-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const preset = target.getAttribute('data-preset');
        if (!preset) return;

        if (preset === 'lodge') {
          if (oilSelect) oilSelect.value = 'soybean-oil';
          if (substrateSelect) substrateSelect.value = 'modern-sand-cast-iron';
          if (tempSlider) tempSlider.value = '475';
          if (thicknessSelect) thicknessSelect.value = 'micro-thin';
          if (foodSelect) foodSelect.value = 'pan-seared-steak-burgers';
          if (dwellSlider) dwellSlider.value = '15';
        } else if (preset === 'chef') {
          if (oilSelect) oilSelect.value = 'grapeseed-oil';
          if (substrateSelect) substrateSelect.value = 'vintage-smooth-machined-iron';
          if (tempSlider) tempSlider.value = '450';
          if (thicknessSelect) thicknessSelect.value = 'micro-thin';
          if (foodSelect) foodSelect.value = 'eggs-cornbread-pancakes';
          if (dwellSlider) dwellSlider.value = '10';
        } else if (preset === 'flaxseed') {
          if (oilSelect) oilSelect.value = 'flaxseed-oil';
          if (substrateSelect) substrateSelect.value = 'modern-sand-cast-iron';
          if (tempSlider) tempSlider.value = '475';
          if (thicknessSelect) thicknessSelect.value = 'micro-thin';
          if (foodSelect) foodSelect.value = 'pan-seared-steak-burgers';
          if (dwellSlider) dwellSlider.value = '20';
        } else if (preset === 'sticky') {
          if (oilSelect) oilSelect.value = 'avocado-oil';
          if (substrateSelect) substrateSelect.value = 'modern-sand-cast-iron';
          if (tempSlider) tempSlider.value = '400';
          if (thicknessSelect) thicknessSelect.value = 'heavy-pooled';
          if (foodSelect) foodSelect.value = 'pan-seared-steak-burgers';
          if (dwellSlider) dwellSlider.value = '15';
        } else if (preset === 'tomato') {
          if (oilSelect) oilSelect.value = 'canola-oil';
          if (substrateSelect) substrateSelect.value = 'modern-sand-cast-iron';
          if (tempSlider) tempSlider.value = '425';
          if (thicknessSelect) thicknessSelect.value = 'light-coat';
          if (foodSelect) foodSelect.value = 'tomato-marinara-sauce';
          if (dwellSlider) dwellSlider.value = '90';
        }
        calculate();
      });
    });

    // Copy Report Handler
    copyBtn?.addEventListener('click', () => {
      const oilName = oilSelect?.selectedOptions[0]?.text || '';
      const subName = substrateSelect?.selectedOptions[0]?.text || '';
      const temp = tempSlider?.value || '450';
      const score = scoreNum?.textContent?.trim() || '0';
      const status = statusTitle?.textContent?.trim() || '';
      const iron = ironMg?.textContent?.trim() || '';

      const reportText = [
        `=========================================================`,
        `ISITKITCHENSAFE CAST IRON SEASONING & PEROXIDE REPORT`,
        `=========================================================`,
        `Oil / Fat: ${oilName}`,
        `Substrate: ${subName}`,
        `Bake Temperature: ${temp}°F`,
        `Polymerization Quality Score: ${score}/100`,
        `Status: ${status}`,
        `Estimated Iron Leached: ${iron}`,
        `Generated: ${new Date().toISOString()}`,
        `https://isitkitchensafe.com/tools/cast-iron-seasoning-polymerization-analyzer/`,
        `=========================================================`
      ].join('\n');

      navigator.clipboard.writeText(reportText).then(() => {
        if (copyText) {
          const original = copyText.textContent;
          copyText.textContent = 'Diagnostic Copied!';
          setTimeout(() => {
            if (copyText) copyText.textContent = original;
          }, 2500);
        }
      });
    });

    // Run initial calculation
    calculate();
  }

  document.addEventListener('DOMContentLoaded', initCastIronAnalyzer);
  if (document.readyState === 'interactive' || document.readyState === 'complete') {
    initCastIronAnalyzer();
  }
</script>
