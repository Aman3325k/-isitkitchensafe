const d = dict[lang] || dict.en;
const dataJsonStr = JSON.stringify(seasoningData);
---

<div class="ci-seasoning-tool bg-surface-soft border border-hairline rounded-3xl p-6 md:p-10 shadow-xs mb-16" data-ci-payload={dataJsonStr} data-lang={lang}>
  <!-- Top Badge & Header -->
  <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-900 border border-amber-200">
      <span class="w-2 h-2 rounded-full bg-amber-600 animate-pulse"></span>
      {d.badge}
    </div>
    <div class="flex items-center gap-2">
      <button 
        type="button" 
        id="ci-copy-btn" 
        class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-ink bg-white hover:bg-surface-strong border border-hairline rounded-lg transition-colors cursor-pointer shadow-2xs"
      >
        <svg class="w-3.5 h-3.5 text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
        </svg>
        <span id="ci-copy-text">{d.copyReportBtn}</span>
      </button>
    </div>
  </div>

  <div class="max-w-3xl mb-8">
    <h2 class="text-2xl md:text-3xl font-extrabold text-ink tracking-tight mb-2">
      {d.title}
    </h2>
    <p class="text-sm md:text-base text-body leading-relaxed">
      {d.subtitle}
    </p>
  </div>

  <!-- Presets Bar -->
  <div class="bg-white border border-hairline rounded-2xl p-4 mb-8 shadow-2xs">
    <div class="text-xs font-bold uppercase tracking-wider text-muted mb-2.5">
      {d.presetsTitle}
    </div>
    <div class="flex flex-wrap gap-2">
      <button type="button" class="ci-preset-btn px-2.5 py-1 text-xs font-medium rounded-lg bg-surface-soft hover:bg-amber-50 hover:text-amber-900 border border-hairline transition-all text-body cursor-pointer" data-preset="lodge">
        🏆 {d.presetLodge}
      </button>
      <button type="button" class="ci-preset-btn px-2.5 py-1 text-xs font-medium rounded-lg bg-surface-soft hover:bg-emerald-50 hover:text-emerald-900 border border-hairline transition-all text-body cursor-pointer" data-preset="chef">
        ✨ {d.presetChefsGold}
      </button>
      <button type="button" class="ci-preset-btn px-2.5 py-1 text-xs font-medium rounded-lg bg-surface-soft hover:bg-rose-50 hover:text-rose-900 border border-hairline transition-all text-body cursor-pointer" data-preset="flaxseed">
        ⚠️ {d.presetFlaxseed}
      </button>
      <button type="button" class="ci-preset-btn px-2.5 py-1 text-xs font-medium rounded-lg bg-surface-soft hover:bg-amber-50 hover:text-amber-900 border border-hairline transition-all text-body cursor-pointer" data-preset="sticky">
        🍯 {d.presetSticky}
      </button>
      <button type="button" class="ci-preset-btn px-2.5 py-1 text-xs font-medium rounded-lg bg-surface-soft hover:bg-red-50 hover:text-red-900 border border-hairline transition-all text-body cursor-pointer" data-preset="tomato">
        🍅 {d.presetTomatoDisaster}
      </button>
    </div>
  </div>

  <!-- Main 2-Column Grid: Left Controls, Right Diagnostic -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mb-12">
    <!-- Left Column: Controls (5 Cols) -->
    <div class="lg:col-span-5 bg-white border border-hairline rounded-2xl p-6 shadow-2xs space-y-6">
      <div class="border-b border-hairline/80 pb-3">
        <h3 class="text-base font-bold text-ink">{d.controlsTitle}</h3>
        <p class="text-xs text-muted mt-0.5">{d.controlsSub}</p>
      </div>

      <!-- 1. Oil Selection -->
      <div>
        <label for="ci-oil-select" class="block text-xs font-semibold text-ink mb-1.5">
          {d.oilLabel}
        </label>
        <select id="ci-oil-select" class="w-full bg-surface-soft border border-hairline rounded-xl px-3 py-2 text-xs font-medium text-ink focus:outline-none focus:ring-2 focus:ring-amber-500">
          {seasoningData.oils.map(oil => (
            <option value={oil.id} selected={oil.id === 'grapeseed-oil'}>
              {oil.name} (IV: {oil.iodineValue} | Smoke: {oil.smokePointF}°F / {oil.smokePointC}°C)
            </option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1 leading-tight">{d.oilHelp}</p>
      </div>

      <!-- 2. Substrate Selection -->
      <div>
        <label for="ci-substrate-select" class="block text-xs font-semibold text-ink mb-1.5">
          {d.substrateLabel}
        </label>
        <select id="ci-substrate-select" class="w-full bg-surface-soft border border-hairline rounded-xl px-3 py-2 text-xs font-medium text-ink focus:outline-none focus:ring-2 focus:ring-amber-500">
          {seasoningData.cookwareSubstrates.map(sub => (
            <option value={sub.id} selected={sub.id === 'modern-sand-cast-iron'}>
              {sub.name} (Ra: {sub.roughnessRaMicrons}µm)
            </option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1 leading-tight">{d.substrateHelp}</p>
      </div>

      <!-- 3. Oven Temperature Slider -->
      <div>
        <div class="flex items-center justify-between mb-1.5">
          <label for="ci-temp-slider" class="text-xs font-semibold text-ink">
            {d.tempLabel}
          </label>
