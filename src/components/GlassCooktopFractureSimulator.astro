};

const d = DICTIONARY[lang] || DICTIONARY.en;
const substrates = glassCooktopData.cooktopSubstrates;
const impactHazards = glassCooktopData.impactHazards;
const abrasionHazards = glassCooktopData.abrasionHazards;
const chemicalHazards = glassCooktopData.chemicalHazards;
const thermalShockDeltas = glassCooktopData.thermalShockDeltas;
const emergencyProtocols = glassCooktopData.emergencySafetyProtocols;
---

<div class="glass-cooktop-simulator-container my-8" data-lang={lang}>
  <!-- Main Simulator Card -->
  <div class="bg-surface border border-hairline rounded-3xl p-6 md:p-10 shadow-sm">
    <!-- Header -->
    <div class="mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-amber-100 text-amber-900 mb-3 border border-amber-200">
        <span>🔬</span>
        {d.badge}
      </div>
      <h2 class="text-2xl md:text-4xl font-extrabold text-ink tracking-tight mb-2">
        {d.title}
      </h2>
      <p class="text-sm md:text-base text-muted max-w-3xl leading-relaxed">
        {d.subtitle}
      </p>
    </div>

    <!-- Presets Bar -->
    <div class="mb-8 p-4 bg-surface-soft border border-hairline rounded-2xl">
      <div class="text-xs font-bold text-ink uppercase tracking-wider mb-3 flex items-center gap-1.5">
        <span>⚡</span>
        {d.presetsTitle}
      </div>
      <div class="flex flex-wrap gap-2">
        <button type="button" class="preset-btn px-3 py-1.5 text-xs font-medium rounded-xl bg-canvas border border-hairline text-ink hover:border-amber-500 hover:text-amber-700 transition-colors" data-preset="preset-dropped-can">
          🥫 {d.presetDroppedCan}
        </button>
        <button type="button" class="preset-btn px-3 py-1.5 text-xs font-medium rounded-xl bg-canvas border border-hairline text-ink hover:border-amber-500 hover:text-amber-700 transition-colors" data-preset="preset-cast-iron-grit">
          🍳 {d.presetCastIronGrit}
        </button>
        <button type="button" class="preset-btn px-3 py-1.5 text-xs font-medium rounded-xl bg-canvas border border-hairline text-ink hover:border-amber-500 hover:text-amber-700 transition-colors" data-preset="preset-caramel-spall">
          🍯 {d.presetCaramelSpall}
        </button>
        <button type="button" class="preset-btn px-3 py-1.5 text-xs font-medium rounded-xl bg-canvas border border-hairline text-ink hover:border-amber-500 hover:text-amber-700 transition-colors" data-preset="preset-ice-water-radiant">
          ❄️ {d.presetIceWaterRadiant}
        </button>
        <button type="button" class="preset-btn px-3 py-1.5 text-xs font-medium rounded-xl bg-canvas border border-hairline text-ink hover:border-amber-500 hover:text-amber-700 transition-colors" data-preset="preset-safe-induction-cooking">
          ✨ {d.presetSafeInduction}
        </button>
      </div>
    </div>

    <!-- Controls & Inputs Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-10">
      <!-- Left Column: Materials & Incident Settings -->
      <div class="space-y-6">
        <div class="border-b border-hairline pb-2 mb-4">
          <h3 class="text-base font-bold text-ink">{d.controlsTitle}</h3>
          <p class="text-xs text-muted">{d.controlsSub}</p>
        </div>

        <!-- Cooktop Substrate -->
        <div>
          <label for="substrateSelect" class="block text-xs font-bold text-ink uppercase tracking-wider mb-1">
            {d.substrateLabel}
          </label>
          <p class="text-xs text-muted mb-2">{d.substrateHelp}</p>
          <select id="substrateSelect" class="w-full bg-surface-soft border border-hairline rounded-xl px-3 py-2.5 text-xs md:text-sm text-ink focus:outline-none focus:border-amber-500 font-medium">
            {substrates.map(sub => (
              <option value={sub.id}>{sub.name} (Toughness: {sub.fractureToughnessKIc} MPa·m½)</option>
            ))}
          </select>
        </div>

        <!-- Physical Impact Event -->
        <div>
          <label for="impactSelect" class="block text-xs font-bold text-ink uppercase tracking-wider mb-1">
            {d.impactLabel}
          </label>
          <p class="text-xs text-muted mb-2">{d.impactHelp}</p>
          <select id="impactSelect" class="w-full bg-surface-soft border border-hairline rounded-xl px-3 py-2.5 text-xs md:text-sm text-ink focus:outline-none focus:border-amber-500 font-medium">
            {impactHazards.map(imp => (
              <option value={imp.id}>{imp.name} [{imp.kineticEnergyJoules} Joules]</option>
            ))}
          </select>
        </div>

        <!-- Cookware Dragging Abrasion & Surface Scratches -->
        <div>
          <label for="abrasionSelect" class="block text-xs font-bold text-ink uppercase tracking-wider mb-1">
            {d.abrasionLabel}
          </label>
          <p class="text-xs text-muted mb-2">{d.abrasionHelp}</p>
          <select id="abrasionSelect" class="w-full bg-surface-soft border border-hairline rounded-xl px-3 py-2.5 text-xs md:text-sm text-ink focus:outline-none focus:border-amber-500 font-medium">
            {abrasionHazards.map(abr => (
              <option value={abr.id}>{abr.name}</option>
            ))}
          </select>
        </div>
      </div>

      <!-- Right Column: Environmental & Sliders -->
      <div class="space-y-6">
        <!-- Chemical Boilover & Sugar Spalling -->
        <div>
          <label for="chemicalSelect" class="block text-xs font-bold text-ink uppercase tracking-wider mb-1">
            {d.chemicalLabel}
          </label>
          <p class="text-xs text-muted mb-2">{d.chemicalHelp}</p>
          <select id="chemicalSelect" class="w-full bg-surface-soft border border-hairline rounded-xl px-3 py-2.5 text-xs md:text-sm text-ink focus:outline-none focus:border-amber-500 font-medium">
            {chemicalHazards.map(chem => (
              <option value={chem.id}>{chem.name} (Tension: {chem.spallingTensionMPa} MPa)</option>
            ))}
          </select>
        </div>

        <!-- Thermal Shock Temperature Delta -->
        <div>
          <label for="thermalSelect" class="block text-xs font-bold text-ink uppercase tracking-wider mb-1">
            {d.thermalLabel}
          </label>
          <p class="text-xs text-muted mb-2">{d.thermalHelp}</p>
          <select id="thermalSelect" class="w-full bg-surface-soft border border-hairline rounded-xl px-3 py-2.5 text-xs md:text-sm text-ink focus:outline-none focus:border-amber-500 font-medium">
            {thermalShockDeltas.map(thm => (
              <option value={thm.id}>{thm.name} (ΔT: {thm.deltaTempC}°C)</option>
            ))}
          </select>
        </div>

        <!-- Drop Height Slider -->
        <div>
          <div class="flex justify-between items-center mb-1">
            <label for="dropHeightInput" class="text-xs font-bold text-ink uppercase tracking-wider">
              {d.dropHeightLabel}
            </label>
            <span id="dropHeightVal" class="text-xs font-mono font-bold text-amber-700 bg-amber-50 px-2 py-0.5 rounded-lg border border-amber-200">50 cm</span>
          </div>
          <p class="text-xs text-muted mb-2">{d.dropHeightHelp}</p>
          <input id="dropHeightInput" type="range" min="10" max="150" step="5" value="50" class="w-full accent-amber-600 cursor-pointer" />
        </div>

        <!-- Cookware Dragging Load Slider -->
        <div>
          <div class="flex justify-between items-center mb-1">
            <label for="panWeightInput" class="text-xs font-bold text-ink uppercase tracking-wider">
              {d.panWeightLabel}
            </label>
            <span id="panWeightVal" class="text-xs font-mono font-bold text-amber-700 bg-amber-50 px-2 py-0.5 rounded-lg border border-amber-200">3.5 kg</span>
          </div>
          <p class="text-xs text-muted mb-2">{d.panWeightHelp}</p>
          <input id="panWeightInput" type="range" min="1.0" max="10.0" step="0.5" value="3.5" class="w-full accent-amber-600 cursor-pointer" />
        </div>
      </div>
    </div>

    <!-- Live Diagnostic Scorecard -->
    <div class="bg-surface-soft border border-hairline rounded-3xl p-6 md:p-8 mb-10">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6 pb-4 border-b border-hairline">
        <div>
          <h3 class="text-lg md:text-xl font-bold text-ink flex items-center gap-2">
            <span>📊</span>
            {d.diagnosticTitle}
          </h3>
          <p class="text-xs text-muted">{d.diagnosticSub}</p>
        </div>
        <div id="structuralBadge" class="inline-flex items-center gap-2 px-3 py-1.5 rounded-2xl text-xs font-extrabold uppercase tracking-wider bg-emerald-100 text-emerald-900 border border-emerald-200">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span id="structuralBadgeText">STRUCTURAL INTEGRITY: SAFE</span>
        </div>
      </div>

      <!-- Core Physics Metrics Grid -->
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 mb-6">
        <!-- Fracture Probability -->
        <div class="bg-canvas border border-hairline rounded-2xl p-4">
          <div class="text-[11px] font-bold text-muted uppercase tracking-wider mb-1">{d.fractureProbLabel}</div>
          <div id="fractureProbVal" class="text-xl md:text-2xl font-black text-ink font-mono">12%</div>
          <div id="fractureProbDesc" class="text-[10px] text-emerald-700 font-semibold mt-1">Negligible Risk</div>
        </div>

        <!-- Kinetic Energy -->
        <div class="bg-canvas border border-hairline rounded-2xl p-4">
          <div class="text-[11px] font-bold text-muted uppercase tracking-wider mb-1">{d.kineticEnergyLabel}</div>
          <div id="kineticEnergyVal" class="text-xl md:text-2xl font-black text-ink font-mono">2.21 J</div>
          <div class="text-[10px] text-muted mt-1">E_k = m·g·h</div>
        </div>

        <!-- Hertzian Contact Pressure -->
        <div class="bg-canvas border border-hairline rounded-2xl p-4">
          <div class="text-[11px] font-bold text-muted uppercase tracking-wider mb-1">{d.contactPressureLabel}</div>
          <div id="contactPressureVal" class="text-xl md:text-2xl font-black text-ink font-mono">480 MPa</div>
          <div id="contactPressureDesc" class="text-[10px] text-muted mt-1">Elastic Hertz Zone</div>
        </div>

        <!-- Griffith Flaw Depth -->
        <div class="bg-canvas border border-hairline rounded-2xl p-4">
          <div class="text-[11px] font-bold text-muted uppercase tracking-wider mb-1">{d.flawDepthLabel}</div>
          <div id="flawDepthVal" class="text-xl md:text-2xl font-black text-ink font-mono">5.0 μm</div>
          <div id="flawDepthDesc" class="text-[10px] text-muted mt-1">Smooth Glass</div>
        </div>

        <!-- Sugar Spalling Tension -->
        <div class="bg-canvas border border-hairline rounded-2xl p-4">
          <div class="text-[11px] font-bold text-muted uppercase tracking-wider mb-1">{d.spallingTensionLabel}</div>
          <div id="spallingTensionVal" class="text-xl md:text-2xl font-black text-ink font-mono">0 MPa</div>
          <div id="spallingTensionDesc" class="text-[10px] text-muted mt-1">No Spalling</div>
        </div>

        <!-- Thermal Gradient Stress -->
        <div class="bg-canvas border border-hairline rounded-2xl p-4">
          <div class="text-[11px] font-bold text-muted uppercase tracking-wider mb-1">{d.thermalStressLabel}</div>
          <div id="thermalStressVal" class="text-xl md:text-2xl font-black text-ink font-mono">1.8 MPa</div>
          <div id="thermalStressDesc" class="text-[10px] text-muted mt-1">Well Below Limit</div>
        </div>
      </div>

      <!-- Electrical Safety & Emergency Action Callout -->
      <div id="electricalAlertBox" class="bg-emerald-50 border border-emerald-200 rounded-2xl p-4 md:p-6 mb-6">
        <div class="flex items-start gap-3">
          <span id="electricalIcon" class="text-2xl">⚡</span>
          <div>
            <h4 id="electricalTitle" class="text-sm md:text-base font-bold text-emerald-950 mb-1">
              240V Electrical Containment: Pristine &amp; Safe
            </h4>
            <p id="electricalText" class="text-xs md:text-sm text-emerald-900 leading-relaxed">
              Glass surface intact with no through-thickness fracture path. The high-voltage 240V terminal blocks and radiant/induction circuitry below are completely isolated from liquids and moisture.
            </p>
          </div>
        </div>
      </div>

      <!-- Copy Report Button -->
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-2">
        <button id="copyReportBtn" type="button" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-3 rounded-2xl text-xs md:text-sm font-bold bg-amber-600 hover:bg-amber-700 text-white shadow-sm transition-all cursor-pointer">
          <span>📋</span>
          {d.copyReportBtn}
        </button>
        <span id="copyFeedback" class="text-xs font-semibold text-emerald-700 hidden">
          ✓ {d.copiedFeedback}
        </span>
      </div>
    </div>

    <!-- Ceramic Physics & Fracture Mechanics Breakdown Cards -->
    <div class="mb-12">
      <div class="border-b border-hairline pb-3 mb-6">
        <h3 class="text-xl md:text-2xl font-extrabold text-ink">{d.mechanicsTitle}</h3>
        <p class="text-xs md:text-sm text-muted">{d.mechanicsSub}</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Card 1: Hertzian Cone Cracks -->
        <div class="bg-surface-soft border border-hairline rounded-2xl p-6">
          <div class="flex items-center gap-2 mb-3">
            <span class="text-xl">💥</span>
            <h4 class="text-base font-bold text-ink">1. Hertzian Cone Cracks &amp; Point-Impact Dynamics</h4>
          </div>
          <p class="text-xs md:text-sm text-muted leading-relaxed mb-3">
            Glass and glass-ceramics are brittle materials with extraordinarily high compressive strength (&gt;1,000 MPa) but limited tensile resistance. When an object with a small curvature radius (like a 16oz soup can rim or ceramic spice jar base) falls onto the cooktop, contact area is sub-millimeter:
          </p>
          <div class="bg-canvas border border-hairline rounded-xl p-3 font-mono text-xs text-ink text-center mb-3">
            &sigma;<sub>0</sub> &propto; ( E<sup>2</sup> &middot; F / R<sup>2</sup> )<sup>1/3</sup> &gt; 900 MPa
          </div>
          <p class="text-xs text-muted leading-relaxed">
            This localized concentration initiates a circular ring crack at the surface that flares outward at a 55°–65° cone angle downward through the 4 mm thickness, causing immediate through-fracture.
          </p>
        </div>

        <!-- Card 2: Griffith Flaw Growth -->
        <div class="bg-surface-soft border border-hairline rounded-2xl p-6">
          <div class="flex items-center gap-2 mb-3">
            <span class="text-xl">🔍</span>
            <h4 class="text-base font-bold text-ink">2. Griffith Flaw Theory &amp; Quartz / Cast-Iron Abrasion</h4>
          </div>
          <p class="text-xs md:text-sm text-muted leading-relaxed mb-3">
            Under Griffith's classical fracture criterion, breaking stress (&sigma;<sub>f</sub>) is inversely proportional to the square root of surface flaw depth:
          </p>
          <div class="bg-canvas border border-hairline rounded-xl p-3 font-mono text-xs text-ink text-center mb-3">
            &sigma;<sub>f</sub> = K<sub>Ic</sub> / ( Y &middot; &radic;(&pi; &middot; a) )
          </div>
          <p class="text-xs text-muted leading-relaxed">
            A pristine glass plate sustains impacts up to 5 Joules. However, dragging rough cast iron or trapped quartz dust (Mohs 7.0 vs glass 6.2) carves 50–100 &mu;m furrows that act as stress concentration notches, halving the energy required for catastrophic rupture.
          </p>
        </div>

        <!-- Card 3: Sugar Spalling -->
        <div class="bg-surface-soft border border-hairline rounded-2xl p-6">
          <div class="flex items-center gap-2 mb-3">
            <span class="text-xl">🍯</span>
            <h4 class="text-base font-bold text-ink">3. Sugar Pitting (Spalling) via Differential Contraction</h4>
          </div>
          <p class="text-xs md:text-sm text-muted leading-relaxed mb-3">
            Molten sucrose (160°C+) creates direct ionic/covalent coordination bonds with silicate ($Si-O-Si$) networks. As the burner cools:
          </p>
          <div class="bg-canvas border border-hairline rounded-xl p-3 font-mono text-xs text-ink text-center mb-3">
            &Delta;&alpha; = &alpha;<sub>caramel</sub> (35 &times; 10<sup>-6</sup>) &gt;&gt; &alpha;<sub>LAS</sub> (0.15 &times; 10<sup>-6</sup>)
          </div>
          <p class="text-xs text-muted leading-relaxed">
            Because caramel contracts over 100 times faster than zero-expansion glass, interfacial shear stress exceeds 80 MPa, ripping small crater-like glass chunks right out of the cooktop surface upon solidification.
          </p>
        </div>

        <!-- Card 4: Electrical Safety -->
        <div class="bg-surface-soft border border-hairline rounded-2xl p-6">
          <div class="flex items-center gap-2 mb-3">
            <span class="text-xl">⚡</span>
            <h4 class="text-base font-bold text-ink">4. 240V / 50A High-Voltage Liquid Seepage Hazard</h4>
          </div>
          <p class="text-xs md:text-sm text-muted leading-relaxed mb-3">
            Glass cooktop panels sit directly above energized 240V double-pole circuitry, induction inverters, and radiant coiled ribbon elements drawing up to 7,000–11,000 Watts.
          </p>
          <p class="text-xs text-muted leading-relaxed">
            Once a crack penetrates through the 4 mm glass thickness, boiling salt water, soups, or grease seep into live internal junction terminals. This triggers explosive arc flashes, ground-fault breaker trips, and energizes wet countertops with lethal 240V potential.
          </p>
        </div>
      </div>
    </div>

    <!-- Material Benchmarks Table -->
    <div class="mb-12">
      <div class="border-b border-hairline pb-3 mb-6">
        <h3 class="text-xl md:text-2xl font-extrabold text-ink">{d.tableTitle}</h3>
        <p class="text-xs md:text-sm text-muted">{d.tableSub}</p>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-xs md:text-sm">
          <thead>
            <tr class="border-b border-hairline bg-surface-soft text-ink font-bold">
              <th class="py-3 px-4">{d.colSubstrate}</th>
              <th class="py-3 px-4">{d.colHardness}</th>
              <th class="py-3 px-4">{d.colToughness}</th>
              <th class="py-3 px-4">{d.colThermalShock}</th>
              <th class="py-3 px-4">{d.colFailureMode}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-hairline">
            {substrates.map(sub => (
              <tr class="hover:bg-surface-soft/50 transition-colors">
                <td class="py-3 px-4 font-semibold text-ink">{sub.name}</td>
                <td class="py-3 px-4 font-mono">{sub.mohsHardness} Mohs</td>
                <td class="py-3 px-4 font-mono">{sub.fractureToughnessKIc} MPa·m½</td>
                <td class="py-3 px-4 font-mono text-emerald-700 font-bold">&Delta;T {sub.maxThermalShockDeltaC}°C</td>
                <td class="py-3 px-4 text-muted text-xs">{sub.description.slice(0, 85)}...</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Critical Protection Rules -->
    <div class="bg-surface-soft border border-hairline rounded-3xl p-6 md:p-8">
      <div class="border-b border-hairline pb-4 mb-6">
        <h3 class="text-lg md:text-2xl font-extrabold text-ink flex items-center gap-2">
          <span>🛡️</span>
          {d.rulesTitle}
        </h3>
        <p class="text-xs md:text-sm text-muted">{d.rulesSub}</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-canvas border border-hairline rounded-2xl p-5">
          <h4 class="text-sm font-bold text-amber-950 mb-2">{d.rule1Title}</h4>
          <p class="text-xs text-muted leading-relaxed">{d.rule1Text}</p>
        </div>

        <div class="bg-canvas border border-hairline rounded-2xl p-5">
          <h4 class="text-sm font-bold text-amber-950 mb-2">{d.rule2Title}</h4>
          <p class="text-xs text-muted leading-relaxed">{d.rule2Text}</p>
        </div>

        <div class="bg-canvas border border-hairline rounded-2xl p-5">
          <h4 class="text-sm font-bold text-amber-950 mb-2">{d.rule3Title}</h4>
          <p class="text-xs text-muted leading-relaxed">{d.rule3Text}</p>
        </div>

        <div class="bg-canvas border border-hairline rounded-2xl p-5">
          <h4 class="text-sm font-bold text-amber-950 mb-2">{d.rule4Title}</h4>
          <p class="text-xs text-muted leading-relaxed">{d.rule4Text}</p>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Reactive Script -->
<script is:inline define:vars={{ glassCooktopData }}>
  (function initGlassCooktopSimulator() {
    const container = document.querySelector('.glass-cooktop-simulator-container');
    if (!container) return;

    // Elements
    const substrateSelect = document.getElementById('substrateSelect');
    const impactSelect = document.getElementById('impactSelect');
    const abrasionSelect = document.getElementById('abrasionSelect');
    const chemicalSelect = document.getElementById('chemicalSelect');
    const thermalSelect = document.getElementById('thermalSelect');
    const dropHeightInput = document.getElementById('dropHeightInput');
    const dropHeightVal = document.getElementById('dropHeightVal');
    const panWeightInput = document.getElementById('panWeightInput');
    const panWeightVal = document.getElementById('panWeightVal');

    // Outputs
    const structuralBadge = document.getElementById('structuralBadge');
    const structuralBadgeText = document.getElementById('structuralBadgeText');
    const fractureProbVal = document.getElementById('fractureProbVal');
    const fractureProbDesc = document.getElementById('fractureProbDesc');
    const kineticEnergyVal = document.getElementById('kineticEnergyVal');
    const contactPressureVal = document.getElementById('contactPressureVal');
    const contactPressureDesc = document.getElementById('contactPressureDesc');
    const flawDepthVal = document.getElementById('flawDepthVal');
    const flawDepthDesc = document.getElementById('flawDepthDesc');
    const spallingTensionVal = document.getElementById('spallingTensionVal');
    const spallingTensionDesc = document.getElementById('spallingTensionDesc');
    const thermalStressVal = document.getElementById('thermalStressVal');
    const thermalStressDesc = document.getElementById('thermalStressDesc');
    const electricalAlertBox = document.getElementById('electricalAlertBox');
    const electricalIcon = document.getElementById('electricalIcon');
    const electricalTitle = document.getElementById('electricalTitle');
    const electricalText = document.getElementById('electricalText');
    const copyReportBtn = document.getElementById('copyReportBtn');
    const copyFeedback = document.getElementById('copyFeedback');
    const presetBtns = document.querySelectorAll('.preset-btn');

    const substratesMap = new Map(glassCooktopData.cooktopSubstrates.map(s => [s.id, s]));
    const impactsMap = new Map(glassCooktopData.impactHazards.map(i => [i.id, i]));
    const abrasionsMap = new Map(glassCooktopData.abrasionHazards.map(a => [a.id, a]));
    const chemicalsMap = new Map(glassCooktopData.chemicalHazards.map(c => [c.id, c]));
    const thermalsMap = new Map(glassCooktopData.thermalShockDeltas.map(t => [t.id, t]));
    const presetsMap = new Map(glassCooktopData.presets.map(p => [p.id, p]));

    function calculateDiagnostics() {
      const substrate = substratesMap.get(substrateSelect.value) || glassCooktopData.cooktopSubstrates[0];
      const impact = impactsMap.get(impactSelect.value) || glassCooktopData.impactHazards[0];
      const abrasion = abrasionsMap.get(abrasionSelect.value) || glassCooktopData.abrasionHazards[0];
      const chemical = chemicalsMap.get(chemicalSelect.value) || glassCooktopData.chemicalHazards[0];
      const thermal = thermalsMap.get(thermalSelect.value) || glassCooktopData.thermalShockDeltas[0];

      const dropHeightCm = parseFloat(dropHeightInput.value) || 50;
      const panWeightKg = parseFloat(panWeightInput.value) || 3.5;

      dropHeightVal.textContent = `${dropHeightCm} cm`;
      panWeightVal.textContent = `${panWeightKg.toFixed(1)} kg`;

      // 1. Kinetic energy calculation: E_k = m * g * h
      let kineticEnergy = 0;
      let contactPressure = 0;
      if (impact.massKg > 0) {
        const heightM = dropHeightCm / 100.0;
        kineticEnergy = impact.massKg * 9.81 * heightM;
        // Peak Hertz contact pressure approximation (MPa)
        const radiusM = (impact.impactRadiusMm || 1.0) / 1000.0;
        const peakForce = Math.sqrt(2 * kineticEnergy * (substrate.youngsModulusGPa * 1e9) * (radiusM * 1e-3));
        const contactArea = Math.PI * Math.pow(radiusM, 2);
        contactPressure = Math.min(1600, Math.round(peakForce / contactArea / 1e6));
      }

      // 2. Flaw depth and Griffith strength
      const baseFlaw = abrasion.flawDepthMicrons;
      const weightMultiplier = Math.max(0.5, panWeightKg / 3.0);
      const totalFlawMicrons = Math.round(baseFlaw * weightMultiplier * abrasion.flawMultiplicationFactor);

      // Griffith flaw capacity (MPa) = K_Ic / (1.12 * sqrt(pi * a))
      const flawM = totalFlawMicrons * 1e-6;
      const griffithStrengthMPa = Math.round(substrate.fractureToughnessKIc / (1.12 * Math.sqrt(Math.PI * flawM)));

      // 3. Sugar Spalling tension
      const spallTension = chemical.spallingTensionMPa;

      // 4. Thermal stress: sigma_th = (E * alpha * DeltaT) / (1 - nu)
      // alpha in 1e-6, E in GPa
      const alphaVal = substrate.thermalExpansionAlpha * 1e-6;
      const EVal = substrate.youngsModulusGPa * 1e9;
      const nuVal = substrate.poissonsRatio;
      const deltaT = thermal.deltaTempC;
      const thermalStressMPa = Math.round(((EVal * alphaVal * deltaT) / (1 - nuVal)) / 1e6);

      // 5. Combined fracture probability (%)
      // Energy resistance threshold is proportional to Griffith strength and material toughness
      const energyCapacityJoules = (substrate.fractureToughnessKIc * 1.8) * (griffithStrengthMPa / 140.0);
      let probFromImpact = 0;
      if (kineticEnergy > 0) {
        probFromImpact = Math.min(100, (kineticEnergy / energyCapacityJoules) * 65);
      }

      let probFromThermal = (thermalStressMPa / substrate.flexuralStrengthMPa) * 50;
      let probFromSpalling = (spallTension / substrate.flexuralStrengthMPa) * 40;

      let combinedFractureProb = Math.min(99, Math.round(probFromImpact + probFromThermal + probFromSpalling));
      if (kineticEnergy === 0 && thermalStressMPa < 10 && spallTension === 0) {
        combinedFractureProb = 2; // Baseline static safety
      }

      // Update UI elements
      kineticEnergyVal.textContent = `${kineticEnergy.toFixed(2)} J`;
      contactPressureVal.textContent = `${contactPressure} MPa`;
      if (contactPressure > 800) {
        contactPressureDesc.textContent = 'Severe Plastic/Crack Zone';
        contactPressureDesc.className = 'text-[10px] text-rose-700 font-bold mt-1';
      } else if (contactPressure > 350) {
        contactPressureDesc.textContent = 'Elevated Shear Zone';
        contactPressureDesc.className = 'text-[10px] text-amber-700 font-semibold mt-1';
      } else {
        contactPressureDesc.textContent = 'Elastic Contact Zone';
        contactPressureDesc.className = 'text-[10px] text-muted mt-1';
      }

      flawDepthVal.textContent = `${totalFlawMicrons} μm`;
      if (totalFlawMicrons > 50) {
        flawDepthDesc.textContent = 'Deep Notch Flaw';
        flawDepthDesc.className = 'text-[10px] text-rose-700 font-bold mt-1';
      } else if (totalFlawMicrons > 15) {
        flawDepthDesc.textContent = 'Moderate Surface Scratches';
        flawDepthDesc.className = 'text-[10px] text-amber-700 font-semibold mt-1';
      } else {
        flawDepthDesc.textContent = 'Pristine Surface';
        flawDepthDesc.className = 'text-[10px] text-emerald-700 font-medium mt-1';
      }

      spallingTensionVal.textContent = `${spallTension} MPa`;
      if (spallTension >= 70) {
        spallingTensionDesc.textContent = 'Severe Pitting Crater Risk';
        spallingTensionDesc.className = 'text-[10px] text-rose-700 font-bold mt-1';
      } else if (spallTension > 20) {
        spallingTensionDesc.textContent = 'Moderate Adhesion';
        spallingTensionDesc.className = 'text-[10px] text-amber-700 font-semibold mt-1';
      } else {
        spallingTensionDesc.textContent = 'No Spalling';
        spallingTensionDesc.className = 'text-[10px] text-muted mt-1';
      }

      thermalStressVal.textContent = `${thermalStressMPa} MPa`;
      if (thermalStressMPa > 50) {
        thermalStressDesc.textContent = 'Extreme Thermal Shock';
        thermalStressDesc.className = 'text-[10px] text-rose-700 font-bold mt-1';
      } else {
        thermalStressDesc.textContent = 'Within Tolerance';
        thermalStressDesc.className = 'text-[10px] text-muted mt-1';
      }

      fractureProbVal.textContent = `${combinedFractureProb}%`;
      if (combinedFractureProb >= 75) {
        fractureProbVal.className = 'text-xl md:text-2xl font-black text-rose-600 font-mono';
        fractureProbDesc.textContent = 'Catastrophic Through-Fracture Imminent';
        fractureProbDesc.className = 'text-[10px] text-rose-700 font-bold mt-1';

        structuralBadge.className = 'inline-flex items-center gap-2 px-3 py-1.5 rounded-2xl text-xs font-extrabold uppercase tracking-wider bg-rose-100 text-rose-900 border border-rose-200';
        structuralBadgeText.textContent = 'STRUCTURAL INTEGRITY: FRACTURED';

        electricalAlertBox.className = 'bg-rose-50 border border-rose-200 rounded-2xl p-4 md:p-6 mb-6';
        electricalIcon.textContent = '🚨';
        electricalTitle.textContent = 'CRITICAL 240V HAZARD: Immediate Power Isolation Required!';
        electricalTitle.className = 'text-sm md:text-base font-bold text-rose-950 mb-1';
        electricalText.textContent = 'Through-thickness fracture detected. Boiling liquids or grease will seep directly onto live 240V internal heating ribbons and terminal blocks, posing immediate arc-flash, fire, and fatal electrical shock hazards. Turn off the main circuit breaker immediately!';
        electricalText.className = 'text-xs md:text-sm text-rose-900 leading-relaxed';
      } else if (combinedFractureProb >= 35) {
        fractureProbVal.className = 'text-xl md:text-2xl font-black text-amber-600 font-mono';
        fractureProbDesc.textContent = 'High Microcrack & Chipping Risk';
        fractureProbDesc.className = 'text-[10px] text-amber-700 font-bold mt-1';

        structuralBadge.className = 'inline-flex items-center gap-2 px-3 py-1.5 rounded-2xl text-xs font-extrabold uppercase tracking-wider bg-amber-100 text-amber-900 border border-amber-200';
        structuralBadgeText.textContent = 'STRUCTURAL INTEGRITY: SURFACE COMPROMISED';

        electricalAlertBox.className = 'bg-amber-50 border border-amber-200 rounded-2xl p-4 md:p-6 mb-6';
        electricalIcon.textContent = '⚠️';
        electricalTitle.textContent = 'Surface Micro-Damage: Elevated Vulnerability';
        electricalTitle.className = 'text-sm md:text-base font-bold text-amber-950 mb-1';
        electricalText.textContent = 'Surface microcracks or pitting craters have developed. While full liquid penetration has not yet occurred, subsequent thermal shock or light impacts can propagate fractures through the remaining glass substrate.';
        electricalText.className = 'text-xs md:text-sm text-amber-900 leading-relaxed';
      } else {
        fractureProbVal.className = 'text-xl md:text-2xl font-black text-emerald-600 font-mono';
        fractureProbDesc.textContent = 'Pristine Structural Margin';
        fractureProbDesc.className = 'text-[10px] text-emerald-700 font-semibold mt-1';

        structuralBadge.className = 'inline-flex items-center gap-2 px-3 py-1.5 rounded-2xl text-xs font-extrabold uppercase tracking-wider bg-emerald-100 text-emerald-900 border border-emerald-200';
        structuralBadgeText.textContent = 'STRUCTURAL INTEGRITY: SAFE';

        electricalAlertBox.className = 'bg-emerald-50 border border-emerald-200 rounded-2xl p-4 md:p-6 mb-6';
        electricalIcon.textContent = '⚡';
        electricalTitle.textContent = '240V Electrical Containment: Pristine & Safe';
        electricalTitle.className = 'text-sm md:text-base font-bold text-emerald-950 mb-1';
        electricalText.textContent = 'Glass surface intact with no through-thickness fracture path. The high-voltage 240V terminal blocks and radiant/induction circuitry below are completely isolated from liquids and moisture.';
        electricalText.className = 'text-xs md:text-sm text-emerald-900 leading-relaxed';
      }
    }

    // Attach listeners
    [substrateSelect, impactSelect, abrasionSelect, chemicalSelect, thermalSelect, dropHeightInput, panWeightInput].forEach(el => {
      if (el) {
        el.addEventListener('change', calculateDiagnostics);
        el.addEventListener('input', calculateDiagnostics);
      }
    });

    // Preset buttons
    presetBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const presetKey = btn.getAttribute('data-preset');
        const p = presetsMap.get(presetKey);
        if (p) {
          substrateSelect.value = p.substrate;
          impactSelect.value = p.impact;
          abrasionSelect.value = p.abrasion;
          chemicalSelect.value = p.chemical;
          thermalSelect.value = p.thermal;
          if (p.impact === 'canned-soup-drop') dropHeightInput.value = '50';
          if (p.impact === 'none') dropHeightInput.value = '30';
          calculateDiagnostics();
        }
      });
    });

    // Copy report
    if (copyReportBtn) {
      copyReportBtn.addEventListener('click', () => {
        const substrate = substratesMap.get(substrateSelect.value);
        const impact = impactsMap.get(impactSelect.value);
        const abrasion = abrasionsMap.get(abrasionSelect.value);
        const chemical = chemicalsMap.get(chemicalSelect.value);
        const thermal = thermalsMap.get(thermalSelect.value);

        const report = `======================================================================
ISITKITCHENSAFE CERAMIC GLASS COOKTOP FRACTURE DIAGNOSTIC REPORT
Timestamp: ${new Date().toISOString()}
======================================================================
COOKTOP SUBSTRATE:
- Material: ${substrate ? substrate.name : 'N/A'}
- Toughness (K_Ic): ${substrate ? substrate.fractureToughnessKIc : 'N/A'} MPa·m½
- Flexural Strength: ${substrate ? substrate.flexuralStrengthMPa : 'N/A'} MPa

INCIDENT PARAMETERS:
- Impact Event: ${impact ? impact.name : 'None'}
- Drop Height: ${dropHeightInput.value} cm
- Kinetic Energy: ${kineticEnergyVal.textContent}
- Hertzian Contact Pressure: ${contactPressureVal.textContent}
- Abrasion / Surface Flaws: ${abrasion ? abrasion.name : 'None'}
- Calculated Griffith Flaw Depth: ${flawDepthVal.textContent}
- Chemical Boilover / Spalling: ${chemical ? chemical.name : 'None'}
- Sugar Spalling Tensile Stress: ${spallingTensionVal.textContent}
- Thermal Shock Delta: ${thermal ? thermal.name : 'Ambient'}
- Thermal Gradient Stress: ${thermalStressVal.textContent}

DIAGNOSTIC OUTCOME:
- Combined Through-Fracture Probability: ${fractureProbVal.textContent}
- Structural Integrity Status: ${structuralBadgeText.textContent}
- Electrical Safety: ${electricalTitle.textContent}

CORE SAFETY MANDATES:
1. Shave molten sugar spills off immediately at 30° with a razor; never let cool.
2. Lift heavy cast iron cookware vertically; never slide over trapped sand/salt.
3. Keep overhead shelving clear of heavy canned goods directly above cooktop.
4. If cooktop develops a through-crack, trip main 240V circuit breaker immediately.
======================================================================`;

        navigator.clipboard.writeText(report).then(() => {
          if (copyFeedback) {
            copyFeedback.classList.remove('hidden');
            setTimeout(() => copyFeedback.classList.add('hidden'), 3000);
          }
        }).catch(() => {
          alert('Report copied to clipboard!');
        });
      });
    }

    // Initial calculation
    calculateDiagnostics();
  })();
</script>
