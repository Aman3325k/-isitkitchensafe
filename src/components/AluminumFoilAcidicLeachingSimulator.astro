const d = dict[lang] || dict.en;
---

<div class="bg-surface rounded-3xl border border-hairline p-6 md:p-10 shadow-sm" id="aluminum-simulator-root">
  <!-- Interactive Header -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-8 border-b border-hairline">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-rose-100 text-rose-900 mb-3 border border-rose-200">
        <span>🧪</span>
        {d.badge}
      </div>
      <h2 class="text-2xl md:text-3xl font-extrabold text-ink tracking-tight">
        {d.title}
      </h2>
      <p class="text-sm md:text-base text-body mt-1 max-w-3xl">
        {d.subtitle}
      </p>
    </div>
    <div class="flex items-center gap-2">
      <button
        id="btn-copy-report"
        type="button"
        class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider bg-surface-soft hover:bg-surface-elevated text-ink border border-hairline transition shadow-sm"
      >
        <span>📋</span>
        <span id="btn-copy-text">{d.copyReportBtn}</span>
      </button>
    </div>
  </div>

  <!-- Presets Bar -->
  <div class="py-6 border-b border-hairline">
    <div class="text-xs font-bold uppercase tracking-wider text-body mb-3">
      {d.presetsTitle}
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
      <button
        type="button"
        class="preset-btn text-left p-3 rounded-2xl border border-hairline bg-surface-soft hover:border-emerald-500 hover:bg-emerald-50/50 transition group"
        data-cookware="parchment-lined-foil"
        data-food="lemon-citrus-marinade"
        data-thermal="standard-oven-bake"
        data-portion="350"
        data-galvanic="isolated-glass-ceramic"
        data-consumer="adult-70kg"
        data-frequency="4"
      >
        <div class="text-xs font-bold text-ink group-hover:text-emerald-700 leading-snug">
          {d.presetClean}
        </div>
      </button>

      <button
        type="button"
        class="preset-btn text-left p-3 rounded-2xl border border-hairline bg-surface-soft hover:border-amber-500 hover:bg-amber-50/50 transition group"
        data-cookware="standard-aluminum-foil"
        data-food="lemon-citrus-marinade"
        data-thermal="standard-oven-bake"
        data-portion="350"
        data-galvanic="isolated-glass-ceramic"
        data-consumer="adult-70kg"
        data-frequency="4"
      >
        <div class="text-xs font-bold text-ink group-hover:text-amber-700 leading-snug">
          {d.presetLemonSalmon}
        </div>
      </button>

      <button
        type="button"
        class="preset-btn text-left p-3 rounded-2xl border border-hairline bg-surface-soft hover:border-rose-500 hover:bg-rose-50/50 transition group"
        data-cookware="standard-aluminum-foil"
        data-food="tomato-marinara-sauce"
        data-thermal="standard-oven-bake"
        data-portion="450"
        data-galvanic="stainless-sheet-contact"
        data-consumer="adult-70kg"
        data-frequency="6"
      >
        <div class="text-xs font-bold text-ink group-hover:text-rose-700 leading-snug">
          {d.presetTomatoLasagna}
        </div>
      </button>

      <button
        type="button"
        class="preset-btn text-left p-3 rounded-2xl border border-hairline bg-surface-soft hover:border-purple-500 hover:bg-purple-50/50 transition group"
        data-cookware="heavy-duty-aluminum-foil"
        data-food="bbq-sauce-molasses"
        data-thermal="high-heat-broil-grill"
        data-portion="300"
        data-galvanic="cast-iron-grate-contact"
        data-consumer="pediatric-child-20kg"
        data-frequency="4"
      >
        <div class="text-xs font-bold text-ink group-hover:text-purple-700 leading-snug">
          {d.presetChildBbq}
        </div>
      </button>
    </div>
  </div>

  <!-- Main Grid: Controls (Left) vs Telemetry (Right) -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 pt-8">
    <!-- Controls Column -->
    <div class="lg:col-span-6 space-y-6">
      <div>
        <h3 class="text-lg font-bold text-ink">
          {d.controlsTitle}
        </h3>
        <p class="text-xs text-body mt-0.5">
          {d.controlsSub}
        </p>
      </div>

      <!-- 1. Cookware Format -->
      <div>
        <label for="select-cookware" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1">
          {d.cookwareLabel}
        </label>
        <select
          id="select-cookware"
          class="w-full bg-surface-soft border border-hairline rounded-xl px-3 py-2.5 text-sm text-ink font-medium focus:outline-none focus:ring-2 focus:ring-rose-500"
        >
          {foilData.cookwareFormats.map((c) => (
            <option value={c.id}>
              {c.name}
            </option>
          ))}
        </select>
        <p class="text-[11px] text-body mt-1">
          {d.cookwareHelp}
        </p>
      </div>

      <!-- 2. Acidic Food Matrix -->
      <div>
        <label for="select-food" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1">
          {d.foodLabel}
        </label>
        <select
          id="select-food"
          class="w-full bg-surface-soft border border-hairline rounded-xl px-3 py-2.5 text-sm text-ink font-medium focus:outline-none focus:ring-2 focus:ring-rose-500"
        >
          {foilData.acidicFoodMatrices.map((f) => (
            <option value={f.id}>
              {f.name}
            </option>
          ))}
        </select>
        <p class="text-[11px] text-body mt-1">
          {d.foodHelp}
        </p>
      </div>

      <!-- 3. Cooking Thermal Profile -->
      <div>
        <label for="select-thermal" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1">
          {d.thermalLabel}
        </label>
        <select
          id="select-thermal"
          class="w-full bg-surface-soft border border-hairline rounded-xl px-3 py-2.5 text-sm text-ink font-medium focus:outline-none focus:ring-2 focus:ring-rose-500"
        >
          {foilData.cookingThermalProfiles.map((tp) => (
            <option value={tp.id}>
              {tp.name}
            </option>
          ))}
        </select>
        <p class="text-[11px] text-body mt-1">
          {d.thermalHelp}
        </p>
      </div>

      <!-- 4. Portion Size Slider -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <label for="slider-portion" class="text-xs font-bold uppercase tracking-wider text-ink">
            {d.portionLabel}
          </label>
          <span id="label-portion-val" class="text-xs font-extrabold text-rose-600 bg-rose-50 px-2 py-0.5 rounded-md border border-rose-200">
            350 g
          </span>
        </div>
        <input
          type="range"
          id="slider-portion"
          min="100"
          max="800"
          step="25"
          value="350"
          class="w-full accent-rose-600 cursor-pointer"
        />
        <p class="text-[11px] text-body mt-1">
          {d.portionHelp}
        </p>
      </div>

      <!-- 5. Galvanic Contact -->
      <div>
        <label for="select-galvanic" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1">
          {d.galvanicLabel}
        </label>
        <select
          id="select-galvanic"
          class="w-full bg-surface-soft border border-hairline rounded-xl px-3 py-2.5 text-sm text-ink font-medium focus:outline-none focus:ring-2 focus:ring-rose-500"
        >
          {foilData.galvanicCoupling.map((g) => (
            <option value={g.id}>
              {g.name}
            </option>
          ))}
        </select>
        <p class="text-[11px] text-body mt-1">
          {d.galvanicHelp}
        </p>
      </div>

      <!-- 6. Consumer Profile -->
      <div>
        <label for="select-consumer" class="block text-xs font-bold uppercase tracking-wider text-ink mb-1">
          {d.consumerLabel}
        </label>
        <select
          id="select-consumer"
          class="w-full bg-surface-soft border border-hairline rounded-xl px-3 py-2.5 text-sm text-ink font-medium focus:outline-none focus:ring-2 focus:ring-rose-500"
        >
          {foilData.consumerProfiles.map((cp) => (
            <option value={cp.id}>
              {cp.name}
            </option>
          ))}
        </select>
        <p class="text-[11px] text-body mt-1">
          {d.consumerHelp}
        </p>
      </div>

      <!-- 7. Monthly Frequency -->
      <div>
        <div class="flex justify-between items-center mb-1">
          <label for="slider-frequency" class="text-xs font-bold uppercase tracking-wider text-ink">
            {d.frequencyLabel}
          </label>
          <span id="label-frequency-val" class="text-xs font-extrabold text-rose-600 bg-rose-50 px-2 py-0.5 rounded-md border border-rose-200">
            4 meals / month
          </span>
        </div>
        <input
          type="range"
          id="slider-frequency"
          min="1"
          max="20"
          step="1"
          value="4"
          class="w-full accent-rose-600 cursor-pointer"
        />
        <p class="text-[11px] text-body mt-1">
          {d.frequencyHelp}
        </p>
      </div>
    </div>

    <!-- Diagnostic Telemetry Column -->
    <div class="lg:col-span-6 space-y-6">
      <div>
        <h3 class="text-lg font-bold text-ink">
          {d.diagnosticTitle}
        </h3>
        <p class="text-xs text-body mt-0.5">
          {d.diagnosticSub}
        </p>
      </div>

      <!-- Safety Index Master Card -->
      <div class="p-6 rounded-3xl bg-surface-soft border border-hairline relative overflow-hidden" id="card-safety-index">
        <div class="flex items-center justify-between gap-4 mb-4">
          <div>
            <div class="text-xs font-bold uppercase tracking-wider text-body">
              {d.overallScoreLabel}
            </div>
            <div class="text-4xl md:text-5xl font-black text-ink mt-1" id="val-safety-index">
              --
            </div>
          </div>
          <div class="text-right">
            <span id="badge-safety-status" class="inline-flex items-center px-3 py-1.5 rounded-xl text-xs font-extrabold uppercase tracking-wider bg-rose-100 text-rose-900 border border-rose-300">
              HAZARD DETECTED
            </span>
          </div>
        </div>
        <!-- Progress Bar -->
        <div class="w-full bg-surface-elevated h-3 rounded-full overflow-hidden border border-hairline">
          <div id="bar-safety-index" class="h-full bg-rose-500 transition-all duration-500" style="width: 25%"></div>
        </div>
      </div>

      <!-- 4 Telemetry Metrics Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- 1. Single Meal Dose -->
        <div class="p-4 rounded-2xl bg-surface-soft border border-hairline">
          <div class="text-xs font-bold uppercase tracking-wider text-body">
            {d.singleMealDoseLabel}
          </div>
          <div class="text-2xl font-black text-ink mt-1" id="val-single-dose">
            -- mg
          </div>
          <p class="text-[11px] text-body mt-1" id="sub-single-dose">
            Total Al absorbed in meal
          </p>
        </div>

        <!-- 2. Food Metal Concentration -->
        <div class="p-4 rounded-2xl bg-surface-soft border border-hairline">
          <div class="text-xs font-bold uppercase tracking-wider text-body">
            {d.foodConcentrationLabel}
          </div>
          <div class="text-2xl font-black text-ink mt-1" id="val-food-conc">
            -- mg/kg
          </div>
          <p class="text-[11px] text-body mt-1" id="sub-food-conc">
            Concentration in cooked food
          </p>
        </div>

        <!-- 3. EFSA TWI Exceedance -->
        <div class="p-4 rounded-2xl bg-surface-soft border border-hairline">
          <div class="text-xs font-bold uppercase tracking-wider text-body">
            {d.efsaTwiLabel}
          </div>
          <div class="text-2xl font-black text-ink mt-1" id="val-efsa-twi">
            -- %
          </div>
          <p class="text-[11px] text-body mt-1" id="sub-efsa-twi">
            EFSA Weekly Limit Exceeded
          </p>
        </div>

        <!-- 4. Monthly Burden -->
        <div class="p-4 rounded-2xl bg-surface-soft border border-hairline">
          <div class="text-xs font-bold uppercase tracking-wider text-body">
            {d.monthlyBurdenLabel}
          </div>
          <div class="text-2xl font-black text-ink mt-1" id="val-monthly-burden">
            -- mg/mo
          </div>
          <p class="text-[11px] text-body mt-1" id="sub-monthly-burden">
            Cumulative systemic intake
          </p>
        </div>
      </div>

      <!-- Intestinal Bioavailability & Mechanism -->
      <div class="p-4 rounded-2xl bg-amber-50/60 border border-amber-200">
        <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-amber-900 mb-1">
          <span>🔬</span>
          {d.bioavailabilityLabel}
        </div>
        <div class="text-sm font-semibold text-amber-950" id="val-bioavailability">
          --
        </div>
        <p class="text-xs text-amber-800 mt-1 leading-relaxed" id="sub-bioavailability">
          --
        </p>
      </div>

      <!-- Clinical Assessment Box -->
      <div class="p-5 rounded-2xl bg-surface-soft border border-hairline" id="box-clinical-assessment">
        <div class="text-xs font-bold uppercase tracking-wider text-ink mb-2">
          {d.alertTitle}
        </div>
        <p class="text-xs text-body leading-relaxed" id="text-clinical-assessment">
          Calculating simulation telemetry...
        </p>
      </div>
    </div>
  </div>

  <!-- Comparative Technical Specifications Table -->
  <div class="mt-12 pt-8 border-t border-hairline">
    <div class="mb-6">
      <h3 class="text-xl font-bold text-ink">
        {d.tableTitle}
      </h3>
      <p class="text-xs text-body mt-1">
        {d.tableSub}
      </p>
    </div>

    <div class="overflow-x-auto rounded-2xl border border-hairline">
      <table class="w-full text-left border-collapse text-xs">
        <thead>
          <tr class="bg-surface-soft border-b border-hairline text-ink font-bold uppercase tracking-wider">
            <th class="p-3.5">{d.colCookware}</th>
            <th class="p-3.5">{d.colMaterial}</th>
            <th class="p-3.5">{d.colThickness}</th>
            <th class="p-3.5">{d.colPassivation}</th>
            <th class="p-3.5">{d.colLeachFactor}</th>
            <th class="p-3.5">{d.colPitting}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline text-body">
          {foilData.cookwareFormats.map((c) => (
            <tr class="hover:bg-surface-soft/50 transition">
              <td class="p-3.5 font-bold text-ink">{c.name}</td>
              <td class="p-3.5">{c.materialClass}</td>
              <td class="p-3.5">{c.thicknessMicrons} µm</td>
              <td class="p-3.5">{c.passivationThicknessNm > 1000 ? (c.passivationThicknessNm / 1000) + ' µm' : c.passivationThicknessNm + ' nm'}</td>
              <td class="p-3.5 font-mono font-bold">{c.baseLeachMultiplier}x</td>
              <td class="p-3.5">{c.pittingSensitivity}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Safe Alternatives Section -->
  <div class="mt-12 pt-8 border-t border-hairline">
    <div class="mb-6">
      <h3 class="text-xl font-bold text-ink">
        {d.alternativesTitle}
      </h3>
      <p class="text-xs text-body mt-1">
        {d.alternativesSub}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Alt 1: Parchment Barrier -->
      <div class="p-6 rounded-2xl bg-surface-soft border border-hairline flex flex-col justify-between">
        <div>
          <div class="text-2xl mb-2">📜</div>
          <h4 class="text-base font-bold text-ink mb-2">Dual-Layer Parchment Wrap</h4>
          <p class="text-xs text-body leading-relaxed">
            Line baking sheets or fold a parchment packet directly around fish, chicken, or lemon slices. Wrap outer aluminum foil over the parchment for thermal sealing and mechanical rigidity. Zero metal migration.
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-hairline flex items-center justify-between text-xs font-bold text-emerald-600">
          <span>0.0 mg Al Leached</span>
          <span>100% Non-Toxic</span>
        </div>
      </div>

      <!-- Alt 2: Enameled Cast Iron -->
      <div class="p-6 rounded-2xl bg-surface-soft border border-hairline flex flex-col justify-between">
        <div>
          <div class="text-2xl mb-2">🥘</div>
          <h4 class="text-base font-bold text-ink mb-2">Vitreous Enameled Cast Iron</h4>
          <p class="text-xs text-body leading-relaxed">
            The ultimate acid-resistant vessel for slow braises, tomato ragu, and vinegar glazes. The non-porous borosilicate glass enamel is completely immune to organic acid corrosion across all pH levels.
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-hairline flex items-center justify-between text-xs font-bold text-emerald-600">
          <span>pH 1.0–14.0 Stable</span>
          <span>Zero Reaction</span>
        </div>
      </div>

      <!-- Alt 3: 316 Surgical Stainless -->
      <div class="p-6 rounded-2xl bg-surface-soft border border-hairline flex flex-col justify-between">
        <div>
          <div class="text-2xl mb-2">🍳</div>
          <h4 class="text-base font-bold text-ink mb-2">304 / 316 Surgical Steel</h4>
          <p class="text-xs text-body leading-relaxed">
            Self-healing chromium oxide passive film withstands hot acidic tomato purees and citrus marinades without leaching aluminum, ensuring clean flavors and pristine safety.
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-hairline flex items-center justify-between text-xs font-bold text-emerald-600">
          <span>Cr2O3 Passivation</span>
          <span>Non-Reactive</span>
        </div>
      </div>
    </div>
  </div>

  <!-- The 5 Ironclad Laws -->
  <div class="mt-12 pt-8 border-t border-hairline">
    <div class="mb-6">
      <h3 class="text-xl font-bold text-ink">
        {d.rulesTitle}
      </h3>
      <p class="text-xs text-body mt-1">
        {d.rulesSub}
      </p>
    </div>

    <div class="space-y-4">
      <div class="p-4 rounded-2xl bg-surface-soft border border-hairline">
        <h4 class="text-sm font-bold text-ink mb-1">{d.rule1Title}</h4>
        <p class="text-xs text-body leading-relaxed">{d.rule1Text}</p>
      </div>
      <div class="p-4 rounded-2xl bg-surface-soft border border-hairline">
        <h4 class="text-sm font-bold text-ink mb-1">{d.rule2Title}</h4>
        <p class="text-xs text-body leading-relaxed">{d.rule2Text}</p>
      </div>
      <div class="p-4 rounded-2xl bg-surface-soft border border-hairline">
        <h4 class="text-sm font-bold text-ink mb-1">{d.rule3Title}</h4>
        <p class="text-xs text-body leading-relaxed">{d.rule3Text}</p>
      </div>
      <div class="p-4 rounded-2xl bg-surface-soft border border-hairline">
        <h4 class="text-sm font-bold text-ink mb-1">{d.rule4Title}</h4>
        <p class="text-xs text-body leading-relaxed">{d.rule4Text}</p>
      </div>
      <div class="p-4 rounded-2xl bg-surface-soft border border-hairline">
        <h4 class="text-sm font-bold text-ink mb-1">{d.rule5Title}</h4>
        <p class="text-xs text-body leading-relaxed">{d.rule5Text}</p>
      </div>
    </div>
  </div>

  <!-- Cross-Linking Hub -->
  <div class="mt-12 pt-8 border-t border-hairline">
    <h4 class="text-xs font-bold uppercase tracking-wider text-body mb-4">
      {d.crossLinkTitle}
    </h4>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <a
        href={lang === 'en' ? '/tools/food-contact-migration-predictor/' : `/${lang}/tools/food-contact-migration-predictor/`}
        class="p-4 rounded-2xl bg-surface-soft border border-hairline hover:border-ink transition group"
      >
        <div class="text-xs font-bold text-ink group-hover:text-rose-600 transition">
          {d.crossLinkMigration} &rarr;
        </div>
        <p class="text-[11px] text-body mt-1">
          Fick's second law planar diffusion model across 8 kitchen material classes.
        </p>
      </a>

      <a
        href={lang === 'en' ? '/tools/toxic-leaching-scorecard/' : `/${lang}/tools/toxic-leaching-scorecard/`}
        class="p-4 rounded-2xl bg-surface-soft border border-hairline hover:border-ink transition group"
      >
        <div class="text-xs font-bold text-ink group-hover:text-rose-600 transition">
          {d.crossLinkToxicLeaching} &rarr;
        </div>
        <p class="text-[11px] text-body mt-1">
          Benchmark cookware against Lead, Cadmium, and PFAS leaching hazards.
        </p>
      </a>

      <a
        href={lang === 'en' ? '/tools/thermal-shock-simulator/' : `/${lang}/tools/thermal-shock-simulator/`}
        class="p-4 rounded-2xl bg-surface-soft border border-hairline hover:border-ink transition group"
      >
        <div class="text-xs font-bold text-ink group-hover:text-rose-600 transition">
          {d.crossLinkThermalShock} &rarr;
        </div>
        <p class="text-[11px] text-body mt-1">
          Thermoelastic stress equations and shatter thresholds for Pyrex, ceramic and metal.
        </p>
      </a>
    </div>
  </div>
</div>

<script define:vars={{ foilData, d }}>
  (function () {
    const root = document.getElementById('aluminum-simulator-root');
    if (!root) return;

    // Elements
    const selectCookware = document.getElementById('select-cookware');
    const selectFood = document.getElementById('select-food');
    const selectThermal = document.getElementById('select-thermal');
    const sliderPortion = document.getElementById('slider-portion');
    const labelPortionVal = document.getElementById('label-portion-val');
    const selectGalvanic = document.getElementById('select-galvanic');
    const selectConsumer = document.getElementById('select-consumer');
    const sliderFrequency = document.getElementById('slider-frequency');
    const labelFrequencyVal = document.getElementById('label-frequency-val');

    // Telemetry Outputs
    const valSafetyIndex = document.getElementById('val-safety-index');
    const badgeSafetyStatus = document.getElementById('badge-safety-status');
    const barSafetyIndex = document.getElementById('bar-safety-index');
    const valSingleDose = document.getElementById('val-single-dose');
    const valFoodConc = document.getElementById('val-food-conc');
    const valEfsaTwi = document.getElementById('val-efsa-twi');
    const valMonthlyBurden = document.getElementById('val-monthly-burden');
    const valBioavailability = document.getElementById('val-bioavailability');
    const subBioavailability = document.getElementById('sub-bioavailability');
    const textClinicalAssessment = document.getElementById('text-clinical-assessment');

    const btnCopyReport = document.getElementById('btn-copy-report');
    const btnCopyText = document.getElementById('btn-copy-text');
    const presetButtons = document.querySelectorAll('.preset-btn');

    function calculate() {
      const cookwareId = selectCookware.value;
      const foodId = selectFood.value;
      const thermalId = selectThermal.value;
      const portionGrams = parseFloat(sliderPortion.value);
      const galvanicId = selectGalvanic.value;
      const consumerId = selectConsumer.value;
      const frequency = parseInt(sliderFrequency.value, 10);

      labelPortionVal.textContent = portionGrams + ' g';
      labelFrequencyVal.textContent = frequency + ' meals / month';

      const cookware = foilData.cookwareFormats.find(c => c.id === cookwareId) || foilData.cookwareFormats[0];
      const food = foilData.acidicFoodMatrices.find(f => f.id === foodId) || foilData.acidicFoodMatrices[0];
      const thermal = foilData.cookingThermalProfiles.find(t => t.id === thermalId) || foilData.cookingThermalProfiles[0];
      const galvanic = foilData.galvanicCoupling.find(g => g.id === galvanicId) || foilData.galvanicCoupling[0];
      const consumer = foilData.consumerProfiles.find(cp => cp.id === consumerId) || foilData.consumerProfiles[0];

      // Base migration rate calculation:
      // Reference baseline: Standard foil with neutral food at room temp ~0.15 mg/kg food
      // Acid dissolution factor: up to 4.85x
      // Thermal factor: up to 9.4x (220C Arrhenius)
      // Galvanic factor: up to 2.85x
      // Cookware multiplier: 1.0 (foil), 0.03 (hard-anodized), 0.00 (parchment/stainless/enamel)
      const baseRefMgPerKg = 5.2; // mg/kg baseline under active cooking
      let foodConcMgPerKg = 0;
      if (cookware.baseLeachMultiplier > 0) {
        foodConcMgPerKg = baseRefMgPerKg *
          cookware.baseLeachMultiplier *
          food.dissolutionFactor *
          thermal.thermalFactor *
          galvanic.galvanicMultiplier;
      }

      // Dose in this meal = (foodConcMgPerKg * portionGrams) / 1000
      const singleMealMg = (foodConcMgPerKg * portionGrams) / 1000;

      // EFSA TWI comparison:
      // EFSA TWI is weekly tolerable limit (e.g., 70 mg/week for 70kg adult)
      const weeklyLimitMg = consumer.efsaTwiWeeklyMg;
      const percentEfsaSingleMeal = (singleMealMg / weeklyLimitMg) * 100;

      // Monthly burden:
      const monthlyBurdenMg = singleMealMg * frequency;

      // Safety Index (0 to 100, where 100 is completely safe):
      let safetyIndex = 100;
      if (singleMealMg > 0) {
        if (percentEfsaSingleMeal >= 100) {
          safetyIndex = Math.max(5, Math.round(30 - (percentEfsaSingleMeal - 100) * 0.1));
        } else if (percentEfsaSingleMeal >= 50) {
          safetyIndex = Math.round(50 - (percentEfsaSingleMeal - 50) * 0.4);
        } else if (percentEfsaSingleMeal >= 15) {
          safetyIndex = Math.round(75 - (percentEfsaSingleMeal - 15) * 0.7);
        } else {
          safetyIndex = Math.round(95 - percentEfsaSingleMeal);
        }
      }

      // Render Outputs
      valSafetyIndex.textContent = safetyIndex + '/100';
      barSafetyIndex.style.width = safetyIndex + '%';

      if (safetyIndex >= 85) {
        badgeSafetyStatus.textContent = 'EXCELLENT / NON-REACTIVE';
        badgeSafetyStatus.className = 'inline-flex items-center px-3 py-1.5 rounded-xl text-xs font-extrabold uppercase tracking-wider bg-emerald-100 text-emerald-900 border border-emerald-300';
        barSafetyIndex.className = 'h-full bg-emerald-500 transition-all duration-500';
      } else if (safetyIndex >= 60) {
        badgeSafetyStatus.textContent = 'LOW LEACHING RISK';
        badgeSafetyStatus.className = 'inline-flex items-center px-3 py-1.5 rounded-xl text-xs font-extrabold uppercase tracking-wider bg-blue-100 text-blue-900 border border-blue-300';
        barSafetyIndex.className = 'h-full bg-blue-500 transition-all duration-500';
      } else if (safetyIndex >= 35) {
        badgeSafetyStatus.textContent = 'MODERATE EXCEEDANCE';
        badgeSafetyStatus.className = 'inline-flex items-center px-3 py-1.5 rounded-xl text-xs font-extrabold uppercase tracking-wider bg-amber-100 text-amber-900 border border-amber-300';
        barSafetyIndex.className = 'h-full bg-amber-500 transition-all duration-500';
      } else {
        badgeSafetyStatus.textContent = 'ACUTE TOXIC OVERLOAD';
        badgeSafetyStatus.className = 'inline-flex items-center px-3 py-1.5 rounded-xl text-xs font-extrabold uppercase tracking-wider bg-rose-100 text-rose-900 border border-rose-300';
        barSafetyIndex.className = 'h-full bg-rose-600 transition-all duration-500';
      }

      valSingleDose.textContent = singleMealMg.toFixed(2) + ' mg';
      valFoodConc.textContent = foodConcMgPerKg.toFixed(1) + ' mg/kg';
      valEfsaTwi.textContent = percentEfsaSingleMeal.toFixed(1) + '%';
      valMonthlyBurden.textContent = monthlyBurdenMg.toFixed(1) + ' mg/mo';

      valBioavailability.textContent = food.bioavailabilityEnhancement;
      subBioavailability.textContent = food.description;

      // Clinical Assessment Narrative
      let assessment = '';
      if (cookware.baseLeachMultiplier === 0) {
        assessment = `✅ OPTIMAL PROTOCOL: The selected cookware (${cookware.name}) forms an impenetrable, non-reactive barrier against ${food.name}. Leaching is 0.0 mg. Food purity is preserved with zero toxicological metal burden.`;
      } else if (percentEfsaSingleMeal > 100) {
        assessment = `🚨 SEVERE HEALTH HAZARD: A single meal delivers ${singleMealMg.toFixed(1)} mg of elemental aluminum—exceeding ${percentEfsaSingleMeal.toFixed(0)}% of the European Food Safety Authority's entire weekly tolerable intake (${weeklyLimitMg} mg/week for ${consumer.name}). Organic acids in ${food.name} form soluble chelated complexes that cross the intestinal brush border via transferrin and passive paracellular pathways. Immediate mitigation: adopt the dual-layer parchment protocol.`;
      } else if (percentEfsaSingleMeal > 40) {
        assessment = `⚠️ ELEVATED ACCUMULATION WARNING: This preparation method releases ${singleMealMg.toFixed(1)} mg of aluminum per serving, representing ${percentEfsaSingleMeal.toFixed(1)}% of your weekly EFSA safety limit. At ${frequency} meals per month, cumulative monthly systemic burden reaches ${monthlyBurdenMg.toFixed(1)} mg. Renal clearance requires 48–72 hours per exposure, with potential bioaccumulation in bone and brain tissue.`;
      } else {
        assessment = `ℹ️ LOW-RISK PROFILE: Chemical depassivation is minimal under these parameters (${singleMealMg.toFixed(2)} mg/meal, ${percentEfsaSingleMeal.toFixed(1)}% of weekly TWI). Intact renal function in a healthy adult easily clears this quantity via urine without systemic accumulation.`;
      }

      textClinicalAssessment.textContent = assessment;
    }

    // Event Listeners
    selectCookware.addEventListener('change', calculate);
    selectFood.addEventListener('change', calculate);
    selectThermal.addEventListener('change', calculate);
    sliderPortion.addEventListener('input', calculate);
    selectGalvanic.addEventListener('change', calculate);
    selectConsumer.addEventListener('change', calculate);
    sliderFrequency.addEventListener('input', calculate);

    presetButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        selectCookware.value = btn.dataset.cookware;
        selectFood.value = btn.dataset.food;
        selectThermal.value = btn.dataset.thermal;
        sliderPortion.value = btn.dataset.portion;
        selectGalvanic.value = btn.dataset.galvanic;
        selectConsumer.value = btn.dataset.consumer;
        sliderFrequency.value = btn.dataset.frequency;
        calculate();
      });
    });

    // Copy Report Button
    btnCopyReport.addEventListener('click', () => {
      const report = `=== IsItKitchenSafe: Aluminum Leaching & Toxicological Report ===
Safety Index: ${valSafetyIndex.textContent} (${badgeSafetyStatus.textContent})
Cookware: ${selectCookware.options[selectCookware.selectedIndex].text}
Food Matrix: ${selectFood.options[selectFood.selectedIndex].text}
Thermal Profile: ${selectThermal.options[selectThermal.selectedIndex].text}
Portion Size: ${sliderPortion.value} g
Consumer: ${selectConsumer.options[selectConsumer.selectedIndex].text}
Single Meal Ingestion: ${valSingleDose.textContent}
Food Concentration: ${valFoodConc.textContent}
EFSA Weekly Limit Exceeded: ${valEfsaTwi.textContent}
Monthly Burden: ${valMonthlyBurden.textContent}
Bioavailability Note: ${valBioavailability.textContent}
Clinical Evaluation: ${textClinicalAssessment.textContent}
=============================================================`;

      navigator.clipboard.writeText(report).then(() => {
        btnCopyText.textContent = d.reportCopied;
        setTimeout(() => {
          btnCopyText.textContent = d.copyReportBtn;
        }, 2500);
      });
    });

    // Initialize
    calculate();
  })();
</script>
