    foodLabel: "調理食材＆食品酸度 (pH)：",
    foodHelp: "有機酸水素イオン（H+）とエタノール溶媒がエステル加水分解を加速します。",
    patinaLabel: "シーズニング油膜の成熟度：",
    patinaHelp: "金属表面を保護する乾性油の重合架橋層の厚み（ミクロン）。",
    timeLabel: "加熱・デグラッセ接触時間：",
    timeHelp: "長時間の酸性煮沸は微小気孔の奥深くへ浸透し母材を腐食します。",
    tempLabel: "調理温度 (°C)：",
    tempHelp: "アレニウス熱動力学効果により化学溶解反応が指数関数的に加速します。",
    profileLabel: "摂取対象者の栄養プロファイル：",
    profileHelp: "溶出鉄分を個人の推奨量（RDA）および45 mg/日の許容上限（UL）と比較。",
    presetsTitle: "代表的クッキングプリセット：",
    presetTomatoBare: "🍅 生鋳鉄スキレットでトマトソース煮込み",
    presetWineSteel: "🍷 薄手炭素鋼パンで赤ワインデグラッセ",
    presetLemonSkillet: "🍋 育った鉄フライパンでレモンバターソテー",
    presetSteakSafe: "🥩 厚切りリブアイ強火焼き（油膜強化・安全）",
    presetEnamelControl: "🥘 ホーロー鍋でトマトソース煮込み（不活性対照）",
    presetBalsamicStripped: "🧅 油膜の剥げた鉄鍋でバルサミコ煮詰め",
    diagnosticTitle: "反応性冶金＆食品安全性診断カード",
    diagnosticSub: "油膜剥離率、鉄分溶出量、金属異臭指数、フライパン修復難易度をリアルタイム算出。",
    overallScoreLabel: "油膜剥離・鉄溶出ハザード指数",
    patinaLossLabel: "シーズニング油膜の剥離率",
    ironLeachLabel: "1食あたりの鉄分溶出量",
    rdaPercentageLabel: "1日あたり推奨摂取量 (RDA) 比率",
    ulPercentageLabel: "許容上限摂取量 (45 mg UL) 比率",
    ferrousRatioLabel: "吸収性の高い二価鉄 (Fe²⁺) 比率",
    metallicTasteLabel: "金属コイン臭・エグ味強度",
    discolorationLabel: "ソースの黒ずみ変色度 (タンニン酸鉄)",
    panConditionLabel: "金属表面のダメージ状態評価",
    alertTitle: "臨床医学＆冶金学的警告",
    tableTitle: "反応性調理器具合金＆耐酸性能比較マトリクス",
    tableSub: "鋳鉄、炭素鋼、ホーロー鋳鉄、316ステンレスの耐酸性比較。",
    colSubstrate: "基底合金材料",
    colRoughness: "表面粗さ (Ra)",
    colAdhesion: "油膜アンカー力",
    colAcidResistance: "耐酸性能 (pH < 4)",
    colBaseLeach: "基準溶出速度",
    colVerdict: "調理適合判定",
    rulesTitle: "鉄・炭素鋼フライパンで料理するための黄金の5箇条",
    rulesSub: "材料工学と食品化学に基づき、油膜を守り金属臭を防ぐ必須ルール。",
    rule1Title: "1. 鋳鉄スキレットの15分酸性調理ルール",
    rule1Text: "トマトやワインなどの酸性食材は、油膜が厚い鉄鍋であっても15分以内の短時間で仕上げてください。それ以上煮込むと酸が母材に達し大量の鉄が溶出します。",
    rule2Title: "2. 炭素鋼パンは強火炒め用・ワイン煮込みは厳禁",
    rule2Text: "冷延炭素鋼は表面が滑らかでアンカー効果が弱いため、酸性のワインでデグラッセすると短時間で油膜が剥離し黒いフレーク状に剥がれ落ちます。",
    rule3Title: "3. 長時間の酸性煮込みにはホーロー鋳鉄鍋を使用",
    rule3Text: "ボロネーゼやビーフシチューなど長時間の煮込みにはホーロー鍋（または316ステンレス）が最適です。ガラス釉薬が100%不活性で色や味を損ないません。",
    rule4Title: "4. 調理後の酸性料理を鉄鍋の中で冷まさない",
    rule4Text: "温度が下がる際、溶存酸素が鉄の腐食をさらに進行させます。調理後は速やかに陶器やガラスの保存容器に移し替えてください。",
    rule5Title: "5. 底が白く剥げた際のコンロ加熱応急処置",
    rule5Text: "酸で底が灰色に露出した場合、温水ですぐに洗い、コンロの中火で2分間完全に水分を飛ばし、熱いうちに油を薄く塗り広げて再不動態化させてください。",
    copyReportBtn: "📋 冶金診断レポートをコピー",
    copiedFeedback: "✓ レポートをクリップボードにコピーしました！"
  }
};

const d = DICTIONARY[lang] || DICTIONARY.en;
const data = seasoningData;
---

<div class="bg-surface-soft border border-hairline rounded-3xl p-6 md:p-10 mb-12 shadow-sm" id="seasoning-modeler-app">
  <!-- Top Banner -->
  <div class="flex flex-wrap items-center justify-between gap-4 mb-8 pb-6 border-b border-hairline">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-amber-100 text-amber-900 mb-2 border border-amber-200">
        <span>🍳</span>
        {d.badge}
      </div>
      <h2 class="text-2xl md:text-3xl font-extrabold text-ink tracking-tight">
        {d.title}
      </h2>
      <p class="text-sm md:text-base text-body mt-1 max-w-3xl">
        {d.subtitle}
      </p>
    </div>
  </div>

  <!-- Presets Bar -->
  <div class="mb-8 p-4 bg-canvas rounded-2xl border border-hairline">
    <div class="text-xs font-bold uppercase tracking-wider text-muted mb-3">
      {d.presetsTitle}
    </div>
    <div class="flex flex-wrap gap-2">
      <button type="button" class="preset-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-surface-soft hover:bg-surface-strong border border-hairline transition-colors text-ink" data-preset="tomato-bare">
        {d.presetTomatoBare}
      </button>
      <button type="button" class="preset-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-surface-soft hover:bg-surface-strong border border-hairline transition-colors text-ink" data-preset="wine-steel">
        {d.presetWineSteel}
      </button>
      <button type="button" class="preset-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-surface-soft hover:bg-surface-strong border border-hairline transition-colors text-ink" data-preset="lemon-skillet">
        {d.presetLemonSkillet}
      </button>
      <button type="button" class="preset-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-surface-soft hover:bg-surface-strong border border-hairline transition-colors text-ink" data-preset="steak-safe">
        {d.presetSteakSafe}
      </button>
      <button type="button" class="preset-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-surface-soft hover:bg-surface-strong border border-hairline transition-colors text-ink" data-preset="enamel-control">
        {d.presetEnamelControl}
      </button>
      <button type="button" class="preset-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-surface-soft hover:bg-surface-strong border border-hairline transition-colors text-ink" data-preset="balsamic-stripped">
        {d.presetBalsamicStripped}
      </button>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Controls Column (5 cols) -->
    <div class="lg:col-span-5 space-y-6 bg-canvas p-6 rounded-2xl border border-hairline">
      <div>
        <h3 class="text-base font-bold text-ink">{d.controlsTitle}</h3>
        <p class="text-xs text-muted mt-0.5">{d.controlsSub}</p>
      </div>

      <!-- Control 1: Pan Substrate -->
      <div>
        <label for="pan-select" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-1">
          {d.panLabel}
        </label>
        <select id="pan-select" class="w-full text-sm rounded-xl border border-hairline bg-surface-soft p-2.5 text-ink focus:outline-none focus:ring-2 focus:ring-amber-500">
          {data.panSubstrates.map((p) => (
            <option value={p.id} selected={p.id === 'rough-cast-iron'}>
              {p.name}
            </option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1">{d.panHelp}</p>
      </div>

      <!-- Control 2: Food Matrix -->
      <div>
        <label for="food-select" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-1">
          {d.foodLabel}
        </label>
        <select id="food-select" class="w-full text-sm rounded-xl border border-hairline bg-surface-soft p-2.5 text-ink focus:outline-none focus:ring-2 focus:ring-amber-500">
          {data.foodMatrices.map((f) => (
            <option value={f.id} selected={f.id === 'tomato-marinara-simmer'}>
              {f.name} (pH {f.pH})
            </option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1">{d.foodHelp}</p>
      </div>

      <!-- Control 3: Seasoning Patina Maturity -->
      <div>
        <label for="patina-select" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-1">
          {d.patinaLabel}
        </label>
        <select id="patina-select" class="w-full text-sm rounded-xl border border-hairline bg-surface-soft p-2.5 text-ink focus:outline-none focus:ring-2 focus:ring-amber-500">
          {data.patinaMaturityLevels.map((pt) => (
            <option value={pt.id} selected={pt.id === 'home-seasoned-mature'}>
              {pt.name}
            </option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1">{d.patinaHelp}</p>
      </div>

      <!-- Control 4: Cooking Dwell Time Slider -->
      <div>
        <div class="flex items-center justify-between text-xs font-semibold text-ink uppercase tracking-wider mb-1">
          <label for="time-slider">{d.timeLabel}</label>
          <span class="font-mono text-amber-600 font-bold" id="time-val">25 min</span>
        </div>
        <input 
          type="range" 
          id="time-slider" 
          min="1" 
          max="120" 
          step="1" 
          value="25"
          class="w-full accent-amber-600 cursor-pointer"
        />
        <div class="flex justify-between text-[10px] text-muted mt-0.5 font-mono">
          <span>1 min (flash deglaze)</span>
          <span>45 min</span>
          <span>120 min (slow braise)</span>
        </div>
        <p class="text-[11px] text-muted mt-1">{d.timeHelp}</p>
      </div>

      <!-- Control 5: Temperature Slider -->
      <div>
        <div class="flex items-center justify-between text-xs font-semibold text-ink uppercase tracking-wider mb-1">
          <label for="temp-slider">{d.tempLabel}</label>
          <span class="font-mono text-amber-600 font-bold" id="temp-val">90°C (194°F)</span>
        </div>
        <input 
          type="range" 
          id="temp-slider" 
          min="60" 
          max="240" 
          step="5" 
          value="90"
          class="w-full accent-amber-600 cursor-pointer"
        />
        <div class="flex justify-between text-[10px] text-muted mt-0.5 font-mono">
          <span>60°C (warm hold)</span>
          <span>100°C (boil)</span>
          <span>240°C (high sear)</span>
        </div>
        <p class="text-[11px] text-muted mt-1">{d.tempHelp}</p>
      </div>

      <!-- Control 6: Health / Nutritional Profile -->
      <div>
        <label for="profile-select" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-1">
          {d.profileLabel}
        </label>
        <select id="profile-select" class="w-full text-sm rounded-xl border border-hairline bg-surface-soft p-2.5 text-ink focus:outline-none focus:ring-2 focus:ring-amber-500">
          {data.healthProfiles.map((hp) => (
            <option value={hp.id} selected={hp.id === 'adult-male'}>
              {hp.name}
            </option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1">{d.profileHelp}</p>
      </div>
    </div>

    <!-- Results Diagnostic Column (7 cols) -->
    <div class="lg:col-span-7 space-y-6">
      <div class="bg-canvas p-6 rounded-2xl border border-hairline">
        <div class="flex items-center justify-between mb-4 pb-3 border-b border-hairline">
          <div>
            <h3 class="text-base font-bold text-ink">{d.diagnosticTitle}</h3>
            <p class="text-xs text-muted">{d.diagnosticSub}</p>
          </div>
          <span id="hazard-badge" class="px-3 py-1 rounded-full text-xs font-extrabold uppercase tracking-wider bg-amber-100 text-amber-900 border border-amber-300">
            Moderate Leaching
          </span>
        </div>

        <!-- Master Hazard Gauge -->
        <div class="mb-6">
          <div class="flex justify-between items-center text-xs font-bold text-ink mb-1">
            <span>{d.overallScoreLabel}</span>
            <span class="font-mono text-sm" id="hazard-score-val">42 / 100</span>
          </div>
          <div class="w-full h-3 bg-surface-soft rounded-full overflow-hidden border border-hairline">
            <div id="hazard-bar" class="h-full bg-amber-500 transition-all duration-300" style="width: 42%;"></div>
          </div>
          <p class="text-[11px] text-muted mt-1.5" id="hazard-summary-text">
            Acidic simmering is stripping the upper seasoning layer. Elemental iron migration is perceptible.
          </p>
        </div>

        <!-- 4 Grid Metric Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
          <!-- Metric 1: Patina Stripped -->
          <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
            <span class="text-[11px] font-bold uppercase tracking-wider text-muted block mb-1">
              {d.patinaLossLabel}
            </span>
            <div class="text-2xl font-black text-ink font-mono" id="patina-stripped-val">
              28.5%
            </div>
            <div class="w-full h-1.5 bg-canvas rounded-full mt-2 overflow-hidden border border-hairline">
              <div id="patina-bar" class="h-full bg-amber-500 transition-all" style="width: 28.5%;"></div>
            </div>
            <span class="text-[11px] text-muted mt-1 block" id="patina-status-text">
              Superficial etching of surface oil
            </span>
          </div>

          <!-- Metric 2: Elemental Iron Leached -->
          <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
            <span class="text-[11px] font-bold uppercase tracking-wider text-muted block mb-1">
              {d.ironLeachLabel}
            </span>
            <div class="text-2xl font-black text-amber-600 font-mono" id="iron-leached-val">
              6.8 mg
            </div>
            <div class="flex items-center justify-between text-[11px] text-muted mt-2 font-mono">
              <span id="rda-ratio-val">85% RDA</span>
              <span id="ul-ratio-val">15% UL</span>
            </div>
            <span class="text-[11px] text-muted mt-0.5 block" id="iron-safety-text">
              Safe for healthy adults; high for toddlers
            </span>
          </div>

          <!-- Metric 3: Metallic Taste Index -->
          <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
            <span class="text-[11px] font-bold uppercase tracking-wider text-muted block mb-1">
              {d.metallicTasteLabel}
            </span>
            <div class="text-lg font-bold text-ink" id="taste-index-val">
              Mild Astringent
            </div>
            <p class="text-[11px] text-muted mt-1" id="taste-desc-text">
              Subtle mineral tang on the back of the palate. Discernible in light pan sauces.
            </p>
          </div>

          <!-- Metric 4: Sauce Discoloration Risk -->
          <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
            <span class="text-[11px] font-bold uppercase tracking-wider text-muted block mb-1">
              {d.discolorationLabel}
            </span>
            <div class="text-lg font-bold text-ink" id="color-risk-val">
              Slight Muting
            </div>
            <p class="text-[11px] text-muted mt-1" id="color-desc-text">
              Iron reacts with sauce polyphenols, causing bright red to fade toward dull brick.
            </p>
          </div>
        </div>

        <!-- Ferrous vs Ferric Chemistry Breakdown -->
        <div class="p-4 rounded-xl bg-surface-soft border border-hairline mb-6">
          <div class="flex justify-between items-center text-xs font-bold text-ink mb-2">
            <span>{d.ferrousRatioLabel}</span>
            <span class="font-mono text-xs text-muted" id="fe-ratio-split">Fe²⁺ 68% vs Fe³⁺ 32%</span>
          </div>
          <div class="w-full h-2.5 bg-canvas rounded-full overflow-hidden flex border border-hairline">
            <div id="fe2-bar" class="h-full bg-emerald-500 transition-all" style="width: 68%;" title="Bioavailable Ferrous Fe2+"></div>
            <div id="fe3-bar" class="h-full bg-slate-400 transition-all" style="width: 32%;" title="Oxidized Ferric Fe3+"></div>
          </div>
          <div class="flex justify-between text-[10px] text-muted mt-1.5 font-mono">
            <span class="text-emerald-700 font-semibold">● Bioavailable Fe²⁺ (Readily Absorbed)</span>
            <span class="text-slate-600 font-semibold">● Oxidized Fe³⁺ (Tannate Precipitates)</span>
          </div>
        </div>

        <!-- Pan Condition & Emergency Recovery -->
        <div class="p-4 rounded-xl bg-amber-50 border border-amber-200 mb-6" id="alert-box">
          <div class="flex items-start gap-3">
            <span class="text-xl">⚠️</span>
            <div>
              <div class="text-xs font-bold uppercase tracking-wider text-amber-900 mb-1" id="alert-title-box">
                {d.alertTitle}
              </div>
              <p class="text-xs text-amber-900/90 leading-relaxed" id="alert-text-box">
                Acidic simmering will etch this seasoning layer. For tomato reductions exceeding 20 minutes, transfer to enameled cast iron or stainless steel.
              </p>
            </div>
          </div>
        </div>

        <!-- Copy Report Button -->
        <button 
          type="button" 
          id="copy-report-btn" 
          class="w-full py-3 px-4 rounded-xl bg-ink hover:bg-neutral-800 text-white font-medium text-xs md:text-sm transition-colors flex items-center justify-center gap-2 shadow-xs"
        >
          <span>{d.copyReportBtn}</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Comparative Metallurgy Table -->
  <div class="mt-12 bg-canvas p-6 md:p-8 rounded-2xl border border-hairline">
    <div class="mb-6">
      <h3 class="text-lg font-bold text-ink">{d.tableTitle}</h3>
      <p class="text-xs text-muted mt-0.5">{d.tableSub}</p>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-xs">
        <thead>
          <tr class="border-b border-hairline text-muted uppercase tracking-wider text-[10px] font-bold">
            <th class="py-3 px-3">{d.colSubstrate}</th>
            <th class="py-3 px-3">{d.colRoughness}</th>
            <th class="py-3 px-3">{d.colAdhesion}</th>
            <th class="py-3 px-3">{d.colAcidResistance}</th>
            <th class="py-3 px-3">{d.colBaseLeach}</th>
            <th class="py-3 px-3">{d.colVerdict}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline">
          {data.panSubstrates.map((p) => (
            <tr class="hover:bg-surface-soft/60 transition-colors">
              <td class="py-3.5 px-3 font-semibold text-ink">
                {p.name}
              </td>
              <td class="py-3.5 px-3 font-mono text-muted">
                Ra {p.microRoughnessRaUm} µm
              </td>
              <td class="py-3.5 px-3 text-body">
                {p.patinaAdhesionStrength}
              </td>
              <td class="py-3.5 px-3 text-body">
                {p.acidVulnerabilityRate}
              </td>
              <td class="py-3.5 px-3 font-mono text-ink">
                {p.baseLeachRateMgMin > 0 ? `${p.baseLeachRateMgMin} mg/min` : '0.0 mg/min'}
              </td>
              <td class="py-3.5 px-3">
                <span class={`inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider ${
                  p.id === 'enameled-cast-iron' || p.id === 'stainless-steel-316'
                    ? 'bg-emerald-100 text-emerald-800'
                    : p.id === 'rough-cast-iron'
                    ? 'bg-amber-100 text-amber-800'
                    : 'bg-rose-100 text-rose-800'
                }`}>
                  {p.id === 'enameled-cast-iron' || p.id === 'stainless-steel-316' ? 'Acid Proof' : p.id === 'rough-cast-iron' ? 'Short Acid Only' : 'Vulnerable'}
                </span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- 5 Rules for Reactive Cookware -->
  <div class="mt-8 bg-canvas p-6 md:p-8 rounded-2xl border border-hairline">
    <div class="mb-6">
      <h3 class="text-lg font-bold text-ink">{d.rulesTitle}</h3>
      <p class="text-xs text-muted mt-0.5">{d.rulesSub}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <h4 class="font-bold text-ink text-sm mb-1.5">{d.rule1Title}</h4>
        <p class="text-xs text-body leading-relaxed">{d.rule1Text}</p>
      </div>
      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <h4 class="font-bold text-ink text-sm mb-1.5">{d.rule2Title}</h4>
        <p class="text-xs text-body leading-relaxed">{d.rule2Text}</p>
      </div>
      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <h4 class="font-bold text-ink text-sm mb-1.5">{d.rule3Title}</h4>
        <p class="text-xs text-body leading-relaxed">{d.rule3Text}</p>
      </div>
      <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
        <h4 class="font-bold text-ink text-sm mb-1.5">{d.rule4Title}</h4>
        <p class="text-xs text-body leading-relaxed">{d.rule4Text}</p>
      </div>
      <div class="p-4 rounded-xl bg-surface-soft border border-hairline md:col-span-2">
        <h4 class="font-bold text-ink text-sm mb-1.5">{d.rule5Title}</h4>
        <p class="text-xs text-body leading-relaxed">{d.rule5Text}</p>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ data, d }}>
  (function initSeasoningModeler() {
    const panSelect = document.getElementById('pan-select');
    const foodSelect = document.getElementById('food-select');
    const patinaSelect = document.getElementById('patina-select');
    const timeSlider = document.getElementById('time-slider');
    const timeVal = document.getElementById('time-val');
    const tempSlider = document.getElementById('temp-slider');
    const tempVal = document.getElementById('temp-val');
    const profileSelect = document.getElementById('profile-select');

    // Outputs
    const hazardBadge = document.getElementById('hazard-badge');
    const hazardScoreVal = document.getElementById('hazard-score-val');
    const hazardBar = document.getElementById('hazard-bar');
    const hazardSummaryText = document.getElementById('hazard-summary-text');
    const patinaStrippedVal = document.getElementById('patina-stripped-val');
    const patinaBar = document.getElementById('patina-bar');
    const patinaStatusText = document.getElementById('patina-status-text');
    const ironLeachedVal = document.getElementById('iron-leached-val');
    const rdaRatioVal = document.getElementById('rda-ratio-val');
    const ulRatioVal = document.getElementById('ul-ratio-val');
    const ironSafetyText = document.getElementById('iron-safety-text');
    const tasteIndexVal = document.getElementById('taste-index-val');
    const tasteDescText = document.getElementById('taste-desc-text');
    const colorRiskVal = document.getElementById('color-risk-val');
    const colorDescText = document.getElementById('color-desc-text');
    const feRatioSplit = document.getElementById('fe-ratio-split');
    const fe2Bar = document.getElementById('fe2-bar');
    const fe3Bar = document.getElementById('fe3-bar');
    const alertBox = document.getElementById('alert-box');
    const alertTitleBox = document.getElementById('alert-title-box');
    const alertTextBox = document.getElementById('alert-text-box');
    const copyReportBtn = document.getElementById('copy-report-btn');

    const panMap = {};
    data.panSubstrates.forEach(p => { panMap[p.id] = p; });

    const foodMap = {};
    data.foodMatrices.forEach(f => { foodMap[f.id] = f; });

    const patinaMap = {};
    data.patinaMaturityLevels.forEach(pt => { patinaMap[pt.id] = pt; });

    const profileMap = {};
    data.healthProfiles.forEach(hp => { profileMap[hp.id] = hp; });

    function calculate() {
      const pan = panMap[panSelect.value] || data.panSubstrates[0];
      const food = foodMap[foodSelect.value] || data.foodMatrices[0];
      const patina = patinaMap[patinaSelect.value] || data.patinaMaturityLevels[2];
      const profile = profileMap[profileSelect.value] || data.healthProfiles[0];
      const dwellMins = parseFloat(timeSlider.value);
      const tempC = parseFloat(tempSlider.value);

      // Update slider texts
      timeVal.textContent = `${dwellMins} min`;
      const tempF = Math.round((tempC * 9 / 5) + 32);
      tempVal.textContent = `${tempC}°C (${tempF}°F)`;

      // Inert controls
      if (pan.id === 'enameled-cast-iron' || pan.id === 'stainless-steel-316') {
        hazardBadge.textContent = 'Inert & Safe';
        hazardBadge.className = 'px-3 py-1 rounded-full text-xs font-extrabold uppercase tracking-wider bg-emerald-100 text-emerald-900 border border-emerald-300';
        hazardScoreVal.textContent = '0 / 100';
        hazardBar.style.width = '0%';
        hazardBar.className = 'h-full bg-emerald-500 transition-all duration-300';
        hazardSummaryText.textContent = `${pan.name} is chemically non-reactive. Zero iron leaching and zero seasoning degradation regardless of acidity or simmer time.`;

        patinaStrippedVal.textContent = '0.0%';
        patinaBar.style.width = '0%';
        patinaStatusText.textContent = 'Inert non-reactive surface (No seasoning required)';

        ironLeachedVal.textContent = '0.0 mg';
        rdaRatioVal.textContent = '0% RDA';
        ulRatioVal.textContent = '0% UL';
        ironSafetyText.textContent = 'Zero elemental iron migration into food';

        tasteIndexVal.textContent = '100% Pure Taste';
        tasteDescText.textContent = 'Zero metallic off-flavors. Preserves genuine culinary flavors perfectly.';

        colorRiskVal.textContent = 'Vibrant & Intact';
        colorDescText.textContent = 'Zero iron-tannate complexes. Sauces retain natural bright color.';

        feRatioSplit.textContent = 'Fe²⁺ 0% vs Fe³⁺ 0%';
        fe2Bar.style.width = '0%';
        fe3Bar.style.width = '0%';

        alertBox.className = 'p-4 rounded-xl bg-emerald-50 border border-emerald-200 mb-6';
        alertTitleBox.textContent = 'Optimal Cookware for Acidic Food';
        alertTitleBox.className = 'text-xs font-bold uppercase tracking-wider text-emerald-900 mb-1';
        alertTextBox.textContent = 'This cookware alloy provides complete barrier protection against organic food acids. Recommended choice for tomato sauce, wine reductions, and citrus glazes.';
        return;
      }

      // Neutral cooking check (e.g. Steak Sear)
      if (food.id === 'neutral-oil-steak-sear') {
        hazardBadge.textContent = 'Patina Replenishing';
        hazardBadge.className = 'px-3 py-1 rounded-full text-xs font-extrabold uppercase tracking-wider bg-emerald-100 text-emerald-900 border border-emerald-300';
        hazardScoreVal.textContent = '4 / 100';
        hazardBar.style.width = '4%';
        hazardBar.className = 'h-full bg-emerald-500 transition-all duration-300';
        hazardSummaryText.textContent = 'High heat with neutral fats polymerizes fresh micro-layers of protective seasoning, strengthening the pan surface.';

        patinaStrippedVal.textContent = '+0.5% (Depositing)';
        patinaBar.style.width = '2%';
        patinaStatusText.textContent = 'Oil polymerization deposits fresh carbon-polymer matrix';

        ironLeachedVal.textContent = '<0.1 mg';
        rdaRatioVal.textContent = '<1% RDA';
        ulRatioVal.textContent = '<1% UL';
        ironSafetyText.textContent = 'Negligible leaching in neutral lipid environment';

        tasteIndexVal.textContent = 'Rich Savory Maillard';
        tasteDescText.textContent = 'Zero metallic off-flavor. Rich roasted umami crust notes.';

        colorRiskVal.textContent = 'Deep Mahogany Crust';
        colorDescText.textContent = 'Lipid browning without discoloration.';

        feRatioSplit.textContent = 'Fe²⁺ 90% vs Fe³⁺ 10%';
        fe2Bar.style.width = '90%';
        fe3Bar.style.width = '10%';

        alertBox.className = 'p-4 rounded-xl bg-emerald-50 border border-emerald-200 mb-6';
        alertTitleBox.textContent = 'Optimal Cast Iron Environment';
        alertTitleBox.className = 'text-xs font-bold uppercase tracking-wider text-emerald-900 mb-1';
        alertTextBox.textContent = 'Neutral fats (tallow, ghee, avocado oil) paired with high thermal energy actively reinforce cast iron and carbon steel seasoning.';
        return;
      }

      // Arrhenius temperature factor
      const refTempK = 363.15; // 90°C
      const currentTempK = tempC + 273.15;
      const Ea = 44500; // J/mol
      const R = 8.314;
      const arrheniusFactor = Math.exp((-Ea / R) * (1 / currentTempK - 1 / refTempK));

      // Acidity factor from pH
      const acidFactor = Math.pow(10, (4.5 - food.pH) * 0.58);

      // Substrate base leaching and adhesion modifier
      const baseLeach = pan.baseLeachRateMgMin;
      const barrierProt = patina.barrierProtectionMultiplier;

      // Rate of iron leaching (mg Fe / min)
      const leachRateMgMin = baseLeach * acidFactor * arrheniusFactor * barrierProt;
      const totalIronMg = Math.min(65.0, leachRateMgMin * dwellMins);

      // Patina degradation percentage
      const degradationRate = Math.min(100, (dwellMins / (20 * (1 / (barrierProt + 0.05)))) * (food.acidDissolutionFactor / 3.0) * arrheniusFactor * 100);

      // % RDA & % UL
      const rdaPercent = Math.round((totalIronMg / profile.rdaIronMg) * 100);
      const ulPercent = Math.round((totalIronMg / profile.tolerableUpperLimitMg) * 100);

      // Metallic Taste Index Score (0 to 100)
      const tasteScore = Math.min(100, Math.round((totalIronMg / 15.0) * 85));

      // Update UI elements
      patinaStrippedVal.textContent = `${degradationRate.toFixed(1)}%`;
      patinaBar.style.width = `${Math.min(100, degradationRate)}%`;

      ironLeachedVal.textContent = `${totalIronMg.toFixed(1)} mg`;
      rdaRatioVal.textContent = `${rdaPercent}% RDA`;
      ulRatioVal.textContent = `${ulPercent}% UL`;

      // Master Hazard Score
      const hazardScore = Math.min(100, Math.round((degradationRate * 0.5) + (tasteScore * 0.3) + (Math.min(100, ulPercent) * 0.2)));
      hazardScoreVal.textContent = `${hazardScore} / 100`;
      hazardBar.style.width = `${hazardScore}%`;

      // Statuses & Thresholds
      if (hazardScore < 25) {
        hazardBadge.textContent = 'Minimal Stripping';
        hazardBadge.className = 'px-3 py-1 rounded-full text-xs font-extrabold uppercase tracking-wider bg-emerald-100 text-emerald-900 border border-emerald-300';
        hazardBar.className = 'h-full bg-emerald-500 transition-all duration-300';
        patinaBar.className = 'h-full bg-emerald-500 transition-all';
        patinaStatusText.textContent = 'Patina barrier intact; minimal micro-etching';
        ironSafetyText.textContent = 'Well within dietary tolerance';
        tasteIndexVal.textContent = 'Clean / Imperceptible';
        tasteDescText.textContent = 'Iron is below sensory taste threshold (<2 mg). Food tastes as intended.';
        colorRiskVal.textContent = 'Minimal Color Shift';
        colorDescText.textContent = 'Sauce retains original vibrant culinary hue.';
      } else if (hazardScore < 60) {
        hazardBadge.textContent = 'Moderate Leaching';
        hazardBadge.className = 'px-3 py-1 rounded-full text-xs font-extrabold uppercase tracking-wider bg-amber-100 text-amber-900 border border-amber-300';
        hazardBar.className = 'h-full bg-amber-500 transition-all duration-300';
        patinaBar.className = 'h-full bg-amber-500 transition-all';
        patinaStatusText.textContent = 'Superficial etching; top micro-layers dissolving';
        ironSafetyText.textContent = profile.id === 'toddler-young-child' || profile.id === 'hemochromatosis-carrier' ? '⚠️ High risk for vulnerable health profile' : 'Elevated iron; safe for healthy adults';
        tasteIndexVal.textContent = 'Mild Astringent Tang';
        tasteDescText.textContent = 'Faint mineral tang detectable on palate. Noticeable in light butter sauces.';
        colorRiskVal.textContent = 'Slight Muting / Dulling';
        colorDescText.textContent = 'Sauce begins fading toward dull brownish-red as iron reacts with polyphenols.';
      } else {
        hazardBadge.textContent = 'Severe Patina Breakdown';
        hazardBadge.className = 'px-3 py-1 rounded-full text-xs font-extrabold uppercase tracking-wider bg-rose-100 text-rose-900 border border-rose-300';
        hazardBar.className = 'h-full bg-rose-600 transition-all duration-300';
        patinaBar.className = 'h-full bg-rose-600 transition-all';
        patinaStatusText.textContent = '🚨 Patina stripped; bare reactive iron directly exposed';
        ironSafetyText.textContent = ulPercent >= 100 ? '🚨 Exceeds 45 mg Tolerable Daily Limit!' : 'High iron dose; metallic gastrointestinal irritation likely';
        tasteIndexVal.textContent = 'Harsh Metallic Penny Taste';
        tasteDescText.textContent = 'Overwhelming metallic off-flavor. Food tastes sharply like copper pennies.';
        colorRiskVal.textContent = 'Inky Muddy Discoloration';
        colorDescText.textContent = 'Iron-tannate complex turns marinara or wine sauce dull black/grey.';
      }

      // Ferrous vs Ferric Ratio
      const fe2Ratio = Math.max(40, Math.min(85, Math.round(80 - (dwellMins * 0.35))));
      const fe3Ratio = 100 - fe2Ratio;
      feRatioSplit.textContent = `Fe²⁺ ${fe2Ratio}% vs Fe³⁺ ${fe3Ratio}%`;
      fe2Bar.style.width = `${fe2Ratio}%`;
      fe3Bar.style.width = `${fe3Ratio}%`;

      // Alert Box Logic
      if (profile.id === 'hemochromatosis-carrier') {
        alertBox.className = 'p-4 rounded-xl bg-rose-50 border border-rose-300 mb-6';
        alertTitleBox.textContent = '🚨 Critical Clinical Alert: Hereditary Hemochromatosis';
        alertTitleBox.className = 'text-xs font-bold uppercase tracking-wider text-rose-900 mb-1';
        alertTextBox.textContent = `This cooking session delivers ${totalIronMg.toFixed(1)} mg of highly bioavailable iron (${ulPercent}% of conservative hemochromatosis limit). Individuals with genetic iron overload should strictly avoid reactive metal pans for acidic foods.`;
      } else if (profile.id === 'toddler-young-child' && totalIronMg > 15.0) {
        alertBox.className = 'p-4 rounded-xl bg-rose-50 border border-rose-300 mb-6';
        alertTitleBox.textContent = '🚨 Pediatric Iron Ingestion Warning';
        alertTitleBox.className = 'text-xs font-bold uppercase tracking-wider text-rose-900 mb-1';
        alertTextBox.textContent = `Simmering yielded ${totalIronMg.toFixed(1)} mg iron (${ulPercent}% of child UL). Young children are vulnerable to acute gastrointestinal mucosal irritation. Do not prepare baby or toddler acidic foods in bare reactive iron.`;
      } else if (degradationRate > 50) {
        alertBox.className = 'p-4 rounded-xl bg-amber-50 border border-amber-200 mb-6';
        alertTitleBox.textContent = '⚠️ Cookware Maintenance Alert';
        alertTitleBox.className = 'text-xs font-bold uppercase tracking-wider text-amber-900 mb-1';
        alertTextBox.textContent = `Over ${degradationRate.toFixed(0)}% of the protective seasoning layer has been etched. Your pan will require immediate stovetop heat-drying and a fresh wipe of seasoning oil to prevent flash rust.`;
      } else {
        alertBox.className = 'p-4 rounded-xl bg-amber-50 border border-amber-200 mb-6';
        alertTitleBox.textContent = d.alertTitle;
        alertTitleBox.className = 'text-xs font-bold uppercase tracking-wider text-amber-900 mb-1';
        alertTextBox.textContent = `Simmering acidic foods in ${pan.name} causes progressive chemical dissolution. Keep acidic dwell times under 15 minutes to preserve seasoning integrity.`;
      }

      hazardSummaryText.textContent = `Simulating ${dwellMins} min of ${food.name} (pH ${food.pH}) in ${pan.name} at ${tempC}°C. Total iron leached: ${totalIronMg.toFixed(1)} mg.`;
    }

    // Attach Event Listeners
    [panSelect, foodSelect, patinaSelect, profileSelect].forEach(el => {
      el.addEventListener('change', calculate);
    });

    [timeSlider, tempSlider].forEach(el => {
      el.addEventListener('input', calculate);
    });

    // Preset buttons
    document.querySelectorAll('.preset-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const preset = e.currentTarget.getAttribute('data-preset');
        if (preset === 'tomato-bare') {
          panSelect.value = 'rough-cast-iron';
          foodSelect.value = 'tomato-marinara-simmer';
          patinaSelect.value = 'factory-single-layer';
          timeSlider.value = '35';
          tempSlider.value = '90';
          profileSelect.value = 'adult-male';
        } else if (preset === 'wine-steel') {
          panSelect.value = 'thin-carbon-steel';
          foodSelect.value = 'red-wine-pan-sauce';
          patinaSelect.value = 'home-seasoned-mature';
          timeSlider.value = '8';
          tempSlider.value = '105';
          profileSelect.value = 'adult-female-premenopausal';
        } else if (preset === 'lemon-skillet') {
          panSelect.value = 'machined-smooth-cast-iron';
          foodSelect.value = 'lemon-butter-piccata';
          patinaSelect.value = 'home-seasoned-mature';
          timeSlider.value = '5';
          tempSlider.value = '95';
          profileSelect.value = 'adult-male';
        } else if (preset === 'steak-safe') {
          panSelect.value = 'rough-cast-iron';
          foodSelect.value = 'neutral-oil-steak-sear';
          patinaSelect.value = 'home-seasoned-mature';
          timeSlider.value = '10';
          tempSlider.value = '220';
          profileSelect.value = 'adult-male';
        } else if (preset === 'enamel-control') {
          panSelect.value = 'enameled-cast-iron';
          foodSelect.value = 'tomato-marinara-simmer';
          patinaSelect.value = 'home-seasoned-mature';
          timeSlider.value = '60';
          tempSlider.value = '90';
          profileSelect.value = 'adult-male';
        } else if (preset === 'balsamic-stripped') {
          panSelect.value = 'thin-carbon-steel';
          foodSelect.value = 'balsamic-vinegar-reduction';
          patinaSelect.value = 'bare-stripped';
          timeSlider.value = '12';
          tempSlider.value = '105';
          profileSelect.value = 'adult-male';
        }
        calculate();
      });
    });

    // Copy Report
    if (copyReportBtn) {
      copyReportBtn.addEventListener('click', () => {
        const panName = panSelect.options[panSelect.selectedIndex].text;
        const foodName = foodSelect.options[foodSelect.selectedIndex].text;
        const dwell = timeSlider.value;
        const temp = tempSlider.value;
        const iron = ironLeachedVal.textContent;
        const patinaLoss = patinaStrippedVal.textContent;
        const taste = tasteIndexVal.textContent;
        const hazard = hazardScoreVal.textContent;

        const report = `=======================================================
ISITKITCHENSAFE METALLURGICAL DIAGNOSTIC REPORT
Tool: Cast Iron & Carbon Steel Seasoning Degradation Modeler
=======================================================
Cookware Substrate:    ${panName}
Food Matrix / Acidity: ${foodName}
Cooking Dwell Time:    ${dwell} minutes
Cooking Temperature:   ${temp}°C
-------------------------------------------------------
DIAGNOSTIC METRICS:
Patina Stripped:       ${patinaLoss}
Elemental Iron Leached:${iron}
Hazard Index Score:    ${hazard}
Metallic Taste Index:  ${taste}
Ferrous/Ferric Ratio:  ${feRatioSplit.textContent}
=======================================================
Generated via https://isitkitchensafe.com/tools/cast-iron-seasoning-degradation-modeler/`;

        navigator.clipboard.writeText(report).then(() => {
          const original = copyReportBtn.innerHTML;
          copyReportBtn.innerHTML = `<span>${d.copiedFeedback}</span>`;
          copyReportBtn.classList.add('bg-emerald-700');
          setTimeout(() => {
            copyReportBtn.innerHTML = original;
            copyReportBtn.classList.remove('bg-emerald-700');
          }, 2500);
        });
      });
    }

    // Initial calculation
    calculate();
  })();
</script>
