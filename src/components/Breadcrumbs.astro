---
export interface BreadcrumbItem {
  label: string;
  href?: string;
}

export interface Props {
  items: BreadcrumbItem[];
  isDarkBg?: boolean;
  className?: string;
}

const { items, isDarkBg = false, className = "mb-8" } = Astro.props;
---

<nav class={`flex flex-wrap items-center gap-1 text-[13px] ${isDarkBg ? 'text-white/80' : 'text-muted'} ${className}`} aria-label="Breadcrumb">
  <ol class="flex flex-wrap items-center gap-1 list-none p-0 m-0">
    {items.map((item, index) => {
      const isLast = index === items.length - 1;
      return (
        <li class="inline-flex items-center">
          {index > 0 && (
            <span class={`mx-1 select-none ${isDarkBg ? 'text-white/50' : 'text-muted/60'}`} aria-hidden="true">/</span>
          )}
          {item.href && !isLast ? (
            <a 
              href={item.href} 
              class={`min-h-[44px] inline-flex items-center py-2 px-1 transition-colors ${
                isDarkBg 
                  ? 'text-white/80 hover:text-white' 
                  : 'text-muted hover:text-ink'
              }`}
            >
              {item.label}
            </a>
          ) : (
            <span 
              class={`min-h-[44px] inline-flex items-center py-2 px-1 font-medium ${
                isDarkBg ? 'text-white' : 'text-ink'
              }`}
              aria-current={isLast ? "page" : undefined}
            >
              {item.label}
            </span>
          )}
        </li>
      );
    })}
  </ol>
</nav>
