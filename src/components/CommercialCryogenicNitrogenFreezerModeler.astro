const d = DICTIONARY[lang];
---

<div class="not-prose my-8 p-6 sm:p-8 rounded-3xl bg-surface-card border border-hairline shadow-sm" id="cryogenic-freezer-tool-root">
  <!-- Header Bar -->
  <div class="flex flex-wrap items-center justify-between gap-4 pb-6 border-b border-hairline">
    <div>
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-cyan-700 text-white mb-2">
        {d.badge}
      </span>
      <h2 class="text-xl sm:text-2xl font-extrabold text-ink tracking-tight">
        {d.title}
      </h2>
      <p class="text-xs sm:text-sm text-muted mt-1 max-w-3xl leading-relaxed">
        {d.subtitle}
      </p>
    </div>
    <div class="flex items-center gap-2">
      <span class="px-2.5 py-1 rounded-md text-xs font-mono font-bold bg-cyan-100 text-cyan-900 border border-cyan-200">
        CGA P-12 &bull; OSHA 1910.146 &bull; ASME B31.3
      </span>
    </div>
  </div>

  <!-- Operational Presets -->
  <div class="mt-6 pt-2">
    <label class="block text-xs font-bold text-ink uppercase tracking-wider mb-2">
      {d.presetsTitle}
    </label>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5">
      <button 
        type="button" 
        id="preset-btn-compliant" 
        class="py-2.5 px-3 text-xs font-semibold rounded-xl border border-hairline bg-surface-soft hover:bg-surface-hover text-ink text-left transition-colors"
      >
        <span class="text-emerald-600 font-bold block mb-0.5">✓ {d.presetCompliant}</span>
        <span class="text-muted text-[11px] block">40ft Tunnel, 316L, 4,800 CFM Exhaust, Dual Zirconia</span>
      </button>
      <button 
        type="button" 
        id="preset-btn-asphyxiation" 
        class="py-2.5 px-3 text-xs font-semibold rounded-xl border border-rose-300 bg-rose-50/50 hover:bg-rose-100/60 text-ink text-left transition-colors"
      >
        <span class="text-rose-600 font-bold block mb-0.5">⚠️ {d.presetAsphyxiation}</span>
        <span class="text-muted text-[11px] block">Unventilated Scullery, 450 CFM, Single Sensor, &lt;10% O2</span>
      </button>
      <button 
        type="button" 
        id="preset-btn-embrittlement" 
        class="py-2.5 px-3 text-xs font-semibold rounded-xl border border-amber-300 bg-amber-50/50 hover:bg-amber-100/60 text-ink text-left transition-colors"
      >
        <span class="text-amber-700 font-bold block mb-0.5">⚡ {d.presetEmbrittlement}</span>
        <span class="text-muted text-[11px] block">Ferritic 430 Stainless Mesh, DBTT @ -10°C, Shatters @ -196°C</span>
      </button>
      <button 
        type="button" 
        id="preset-btn-immersion" 
        class="py-2.5 px-3 text-xs font-semibold rounded-xl border border-hairline bg-surface-soft hover:bg-surface-hover text-ink text-left transition-colors"
      >
        <span class="text-cyan-700 font-bold block mb-0.5">❄️ {d.presetImmersion}</span>
        <span class="text-muted text-[11px] block">Direct Immersion Bath, 520 gal/hr LN2, Instant Crust Freeze</span>
      </button>
    </div>
  </div>

  <!-- Main Grid Controls & Diagnostics -->
  <div class="mt-8 grid grid-cols-1 lg:grid-cols-12 gap-8">
    <!-- Controls (7 cols) -->
    <div class="lg:col-span-7 space-y-6">
      <div class="border-b border-hairline pb-2">
        <h3 class="text-sm font-bold text-ink uppercase tracking-wider">
          {d.controlsTitle}
        </h3>
        <p class="text-xs text-muted mt-0.5">
          {d.controlsSub}
        </p>
      </div>

      <!-- Freezer Architecture Selection -->
      <div>
        <label for="freezer-arch-select" class="block text-xs font-bold text-ink mb-1">
          {d.freezerLabel}
        </label>
        <select 
          id="freezer-arch-select" 
          class="w-full text-xs font-medium bg-surface-soft border border-hairline rounded-xl p-3 text-ink focus:outline-none focus:ring-2 focus:ring-cyan-600"
        >
          {freezerData.freezerArchitectures.map(f => (
            <option value={f.id}>{f.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1 leading-normal">
          {d.freezerHelp}
        </p>
      </div>

      <!-- Metallurgy Selection -->
      <div>
        <label for="belt-metallurgy-select" class="block text-xs font-bold text-ink mb-1">
          {d.metallurgyLabel}
        </label>
        <select 
          id="belt-metallurgy-select" 
          class="w-full text-xs font-medium bg-surface-soft border border-hairline rounded-xl p-3 text-ink focus:outline-none focus:ring-2 focus:ring-cyan-600"
        >
          {freezerData.stainlessSteelMetallurgy.map(m => (
            <option value={m.id}>{m.name} [{m.crystalStructure}]</option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1 leading-normal">
          {d.metallurgyHelp}
        </p>
      </div>

      <!-- Operating Temperature Slider -->
      <div>
        <div class="flex items-center justify-between mb-1">
          <label for="chamber-temp-input" class="text-xs font-bold text-ink">
            {d.tempLabel}
          </label>
          <span id="chamber-temp-val" class="font-mono text-xs font-bold text-cyan-700 bg-cyan-50 px-2 py-0.5 rounded border border-cyan-200">
            -196 °C (-320.8 °F)
          </span>
        </div>
        <input 
          type="range" 
          id="chamber-temp-input" 
          min="-196" 
          max="-40" 
          step="2" 
          value="-196" 
          class="w-full accent-cyan-700 cursor-pointer"
        />
        <p class="text-[11px] text-muted mt-1 leading-normal">
          {d.tempHelp}
        </p>
      </div>

      <!-- LN2 Consumption Rate -->
      <div>
        <div class="flex items-center justify-between mb-1">
          <label for="ln2-flow-input" class="text-xs font-bold text-ink">
            {d.ln2FlowLabel}
          </label>
          <span id="ln2-flow-val" class="font-mono text-xs font-bold text-cyan-700 bg-cyan-50 px-2 py-0.5 rounded border border-cyan-200">
            680 gal/hr
          </span>
        </div>
        <input 
          type="range" 
          id="ln2-flow-input" 
          min="50" 
          max="1200" 
          step="25" 
          value="680" 
          class="w-full accent-cyan-700 cursor-pointer"
        />
        <p class="text-[11px] text-muted mt-1 leading-normal">
          {d.ln2FlowHelp}
        </p>
      </div>

      <!-- Scullery Room Volume -->
      <div>
        <div class="flex items-center justify-between mb-1">
          <label for="room-vol-input" class="text-xs font-bold text-ink">
            {d.roomVolLabel}
          </label>
          <span id="room-vol-val" class="font-mono text-xs font-bold text-cyan-700 bg-cyan-50 px-2 py-0.5 rounded border border-cyan-200">
            18,500 cu ft
          </span>
        </div>
        <input 
          type="range" 
          id="room-vol-input" 
          min="2000" 
          max="50000" 
          step="500" 
          value="18500" 
          class="w-full accent-cyan-700 cursor-pointer"
        />
        <p class="text-[11px] text-muted mt-1 leading-normal">
          {d.roomVolHelp}
        </p>
      </div>

      <!-- Mechanical Exhaust Ventilation Rate -->
      <div>
        <div class="flex items-center justify-between mb-1">
          <label for="exhaust-vent-input" class="text-xs font-bold text-ink">
            {d.ventilationLabel}
          </label>
          <span id="exhaust-vent-val" class="font-mono text-xs font-bold text-cyan-700 bg-cyan-50 px-2 py-0.5 rounded border border-cyan-200">
            4,800 CFM
          </span>
        </div>
        <input 
          type="range" 
          id="exhaust-vent-input" 
          min="200" 
          max="8000" 
          step="100" 
          value="4800" 
          class="w-full accent-cyan-700 cursor-pointer"
        />
        <p class="text-[11px] text-muted mt-1 leading-normal">
          {d.ventilationHelp}
        </p>
      </div>

      <!-- Atmospheric Sensor & Interlock State -->
      <div>
        <label for="sensor-interlock-select" class="block text-xs font-bold text-ink mb-1">
          {d.sensorLabel}
        </label>
        <select 
          id="sensor-interlock-select" 
          class="w-full text-xs font-medium bg-surface-soft border border-hairline rounded-xl p-3 text-ink focus:outline-none focus:ring-2 focus:ring-cyan-600"
        >
          <option value="dual_zirconia_interlock">Dual-Zone High/Low Zirconia O2 Sensors + Auto-Cutoff Solenoid (CGA P-12 Compliant)</option>
          <option value="single_ceiling_sensor">Single Ceiling-Mounted Sensor (Non-Compliant: Delayed Cold Gas Detection)</option>
          <option value="unmonitored_scullery">No Atmospheric O2 Sensors or Emergency Interlocks (Extreme Hazard)</option>
        </select>
        <p class="text-[11px] text-muted mt-1 leading-normal">
          {d.sensorHelp}
        </p>
      </div>
    </div>

    <!-- Live Telemetry & Diagnostics (5 cols) -->
    <div class="lg:col-span-5 space-y-6">
      <div class="border-b border-hairline pb-2">
        <h3 class="text-sm font-bold text-ink uppercase tracking-wider">
          {d.diagnosticTitle}
        </h3>
        <p class="text-xs text-muted mt-0.5">
          {d.diagnosticSub}
        </p>
      </div>

      <!-- Telemetry Cards -->
      <div class="space-y-3">
        <!-- 1. Room Oxygen Concentration -->
        <div class="p-4 rounded-2xl bg-surface-soft border border-hairline shadow-xs">
          <div class="flex items-center justify-between text-xs mb-1">
            <span class="font-semibold text-muted">{d.o2ConcLabel}</span>
            <span id="badge-o2" class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800">
              Safe &ge; 19.5%
            </span>
          </div>
          <div class="flex items-baseline gap-2">
            <span id="metric-o2" class="text-2xl font-black text-ink font-mono tracking-tight">
              20.9%
            </span>
            <span class="text-xs text-muted">ambient O2 in room air</span>
          </div>
          <div class="w-full bg-hairline rounded-full h-1.5 mt-2 overflow-hidden">
            <div id="bar-o2" class="bg-emerald-500 h-1.5 rounded-full transition-all duration-300" style="width: 100%;"></div>
          </div>
        </div>

        <!-- 2. Boil-Off Vapor Expansion Rate -->
        <div class="p-4 rounded-2xl bg-surface-soft border border-hairline shadow-xs">
          <div class="flex items-center justify-between text-xs mb-1">
            <span class="font-semibold text-muted">{d.n2VaporRateLabel}</span>
            <span id="badge-n2-expansion" class="px-2 py-0.5 rounded text-[10px] font-bold font-mono bg-cyan-100 text-cyan-800">
              1:694 Ratio
            </span>
          </div>
          <div class="flex items-baseline gap-2">
            <span id="metric-n2-expansion" class="text-2xl font-black text-ink font-mono tracking-tight">
              1,052 CFM
            </span>
            <span class="text-xs text-muted">expanded N2 gas volume</span>
          </div>
          <p class="text-[11px] text-muted mt-1">
            Liquid boil-off rate: <span id="metric-ln2-l-min" class="font-mono text-ink font-semibold">42.9 L/min</span> liquid expanding to cold gas.
          </p>
        </div>

        <!-- 3. Belt Charpy Impact Toughness -->
        <div class="p-4 rounded-2xl bg-surface-soft border border-hairline shadow-xs">
          <div class="flex items-center justify-between text-xs mb-1">
            <span class="font-semibold text-muted">{d.charpyLabel}</span>
            <span id="badge-charpy" class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800">
              Ductile FCC
            </span>
          </div>
          <div class="flex items-baseline gap-2">
            <span id="metric-charpy" class="text-2xl font-black text-ink font-mono tracking-tight">
              125 J
            </span>
            <span class="text-xs text-muted">at operating temperature</span>
          </div>
          <p class="text-[11px] text-muted mt-1">
            DBTT Margin: <span id="metric-dbtt-margin" class="font-mono text-ink font-semibold">&gt;70 °C above fracture</span>.
          </p>
        </div>

        <!-- 4. Linear Thermal Contraction -->
        <div class="p-4 rounded-2xl bg-surface-soft border border-hairline shadow-xs">
          <div class="flex items-center justify-between text-xs mb-1">
            <span class="font-semibold text-muted">{d.contractionLabel}</span>
            <span id="badge-contraction" class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-cyan-100 text-cyan-800">
              ΔL Strain OK
            </span>
          </div>
          <div class="flex items-baseline gap-2">
            <span id="metric-contraction" class="text-2xl font-black text-ink font-mono tracking-tight">
              36.2 mm
            </span>
            <span class="text-xs text-muted">(1.42 inches contraction)</span>
          </div>
          <p class="text-[11px] text-muted mt-1">
            Sprocket clearance: <span id="metric-sprocket-clearance" class="font-mono text-ink font-semibold">Take-up springs engaged</span>.
          </p>
        </div>

        <!-- 5. Pooling Index & Sensor Status -->
        <div class="p-4 rounded-2xl bg-surface-soft border border-hairline shadow-xs">
          <div class="flex items-center justify-between text-xs mb-1">
            <span class="font-semibold text-muted">{d.poolingIndexLabel}</span>
            <span id="badge-pooling" class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-blue-100 text-blue-800">
              3.8x Air Density
            </span>
          </div>
          <div class="flex items-baseline gap-2">
            <span id="metric-pooling" class="text-xl font-black text-ink font-mono tracking-tight">
              Heavy Floor Cloud
            </span>
            <span class="text-xs text-muted">cold N2 pools at 0-2 ft</span>
          </div>
          <div class="mt-2 pt-2 border-t border-hairline/60 flex items-center justify-between text-xs">
            <span class="text-muted">{d.cgaStatusLabel}:</span>
            <span id="metric-interlock-status" class="font-bold font-mono text-emerald-700">
              ARMED / OPERATIONAL
            </span>
          </div>
        </div>
      </div>

      <!-- Diagnostic Banner -->
      <div class="p-5 rounded-2xl border bg-surface-card shadow-xs transition-colors" id="banner-diagnostic-root">
        <div class="flex items-center justify-between gap-2 mb-3">
          <span class="text-xs font-extrabold uppercase tracking-wider text-muted">
            {d.complianceStatusLabel}
          </span>
          <span id="banner-compliance-badge" class="px-2.5 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-emerald-600 text-white">
            COMPLIANT &bull; CGA P-12 SAFE
          </span>
        </div>

        <div class="space-y-2 text-xs">
          <div>
            <span class="font-bold text-ink block">{d.primaryRiskLabel}</span>
            <p id="diag-primary-risk" class="text-muted leading-relaxed mt-0.5">
              Normal atmospheric oxygen and stable austenitic mesh belt ductility maintained.
            </p>
          </div>
          <div>
            <span class="font-bold text-ink block">{d.mechanismsLabel}</span>
            <p id="diag-mechanisms" class="text-muted leading-relaxed mt-0.5">
              High mechanical ventilation (4,800 CFM) effectively extracts nitrogen boil-off gas; stable FCC crystal matrix of 316L prevents cryogenic fracture.
            </p>
          </div>
          <div>
            <span class="font-bold text-ink block">{d.mitigationLabel}</span>
            <p id="diag-mitigation" class="text-muted leading-relaxed mt-0.5">
              Maintain quarterly calibration of zirconium oxide O2 sensor probes; inspect spring-loaded take-up bearings on mesh belt drive for cryogenic grease hardening.
            </p>
          </div>
        </div>

        <!-- Copy Telemetry Button -->
        <div class="mt-4 pt-3 border-t border-hairline/70">
          <button 
            type="button" 
            id="copy-telemetry-btn" 
            class="w-full py-2.5 px-3 rounded-xl bg-surface-soft hover:bg-surface-hover text-ink font-semibold text-xs border border-hairline flex items-center justify-center gap-2 transition-colors"
          >
            <svg class="w-3.5 h-3.5 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
            </svg>
            <span id="copy-btn-text">{d.copyReportBtn}</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Deep Scientific & Engineering Analysis -->
  <div class="mt-12 pt-8 border-t border-hairline">
    <div class="max-w-3xl">
      <h3 class="text-lg font-bold text-ink tracking-tight mb-1">
        {d.scienceTitle}
      </h3>
      <p class="text-xs sm:text-sm text-muted leading-relaxed mb-6">
        {d.scienceSub}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs text-muted leading-relaxed">
      <div class="p-5 rounded-2xl bg-surface-soft border border-hairline">
        <h4 class="font-bold text-ink mb-2 text-sm">
          1. 1:694 Liquid Nitrogen Phase Expansion &amp; Differential O2 Displacement
        </h4>
        <p class="mb-2">
          Liquid nitrogen (boiling point -195.79°C / -320.4°F) has an extraordinary volumetric expansion ratio of 1:694 at 20°C (68°F) and 1 atm. A single gallon of liquid expands to 694 gallons (92.8 cu ft / 2.63 m³) of pure gaseous nitrogen.
        </p>
        <p class="mb-2 font-mono text-[11px] bg-surface-card p-2 rounded border border-hairline text-ink">
          Q_gas = V_LN2 · (3.785 L/gal) · 694 / [ 60 · 28.317 ] CFM
        </p>
        <p>
          In an enclosed scullery, the ambient oxygen volume percentage over time follows the mass balance differential equation:
        </p>
        <p class="my-2 font-mono text-[11px] bg-surface-card p-2 rounded border border-hairline text-ink">
          d(V_O2)/dt = (Q_vent · 0.2095) - [ (Q_vent + Q_gas) · (V_O2 / V_room) ]
        </p>
        <p>
          Because cold nitrogen vapor at -196°C has a density of ~4.61 kg/m³ (approx 3.8 times denser than ambient room air at 1.20 kg/m³), the vapor fails to mix uniformly; it stratifies into a zero-oxygen cryogenic pool along the floor, suffocating workers who bend over or collapse.
        </p>
      </div>

      <div class="p-5 rounded-2xl bg-surface-soft border border-hairline">
        <h4 class="font-bold text-ink mb-2 text-sm">
          2. Austenitic (FCC) vs Ferritic (BCC) Cryogenic Fracture Mechanics
        </h4>
        <p class="mb-2">
          Metals with a Body-Centered Cubic (BCC) crystal lattice, such as ferritic stainless steel (AISI 430), exhibit a sharp Ductile-to-Brittle Transition Temperature (DBTT) between -20°C and 0°C. When exposed to liquid nitrogen at -196°C, their slip systems freeze, causing Charpy V-notch impact energy to collapse from 35 J to &lt;2 J, resulting in sudden shattering under minimal tensile loads.
        </p>
        <p class="mb-2">
          In contrast, Face-Centered Cubic (FCC) austenitic stainless steels (AISI 304 and 316L) possess 12 primary slip systems ({111}&lang;110&rang;) that remain active even near absolute zero. High-nickel 316L retains Charpy toughness exceeding 110 J at -196°C.
        </p>
        <p class="font-mono text-[11px] bg-surface-card p-2 rounded border border-hairline text-ink">
          ΔL = L_0 · α · (T_operating - T_ambient)
        </p>
        <p class="mt-2">
          With a thermal contraction coefficient α = 16.0 × 10<sup>-6</sup> /°C, a 40-foot tunnel belt contracts by 36 mm (1.42 inches), demanding spring-loaded take-up rollers to avoid drive gear shear.
        </p>
      </div>
    </div>

    <!-- Engineering Matrix Table -->
    <div class="mt-8">
      <h4 class="text-sm font-bold text-ink mb-1">
        {d.tableTitle}
      </h4>
      <p class="text-xs text-muted mb-3">
        {d.tableSub}
      </p>
      <div class="overflow-x-auto rounded-2xl border border-hairline">
        <table class="w-full text-left text-xs">
          <thead class="bg-surface-soft border-b border-hairline text-muted font-bold uppercase tracking-wider text-[11px]">
            <tr>
              <th class="p-3">{d.colModel}</th>
              <th class="p-3">{d.colClass}</th>
              <th class="p-3">{d.colVolume}</th>
              <th class="p-3">{d.colBelt}</th>
              <th class="p-3">{d.colLn2Rate}</th>
              <th class="p-3">{d.colExhaust}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-hairline">
            {freezerData.freezerArchitectures.map(f => (
              <tr class="hover:bg-surface-hover/50 transition-colors">
                <td class="p-3 font-semibold text-ink">{f.name}</td>
                <td class="p-3 text-muted">{f.classification}</td>
                <td class="p-3 font-mono text-ink">{f.roomVolumeCuFt.toLocaleString()} ft³</td>
                <td class="p-3 text-muted">{f.beltWidthInches}" &times; {f.beltLengthFt} ft</td>
                <td class="p-3 font-mono text-ink">{f.nominalLn2GalHr} gal/hr</td>
                <td class="p-3 font-mono text-ink">{f.designExhaustCfm.toLocaleString()} CFM</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Mandatory Directives Grid -->
    <div class="mt-8 pt-6 border-t border-hairline">
      <h4 class="text-sm font-bold text-ink mb-1">
        {d.rulesTitle}
      </h4>
      <p class="text-xs text-muted mb-4">
        {d.rulesSub}
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
          <h5 class="text-xs font-bold text-ink mb-1">{d.rule1Title}</h5>
          <p class="text-xs text-muted leading-relaxed">{d.rule1Text}</p>
        </div>
        <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
          <h5 class="text-xs font-bold text-ink mb-1">{d.rule2Title}</h5>
          <p class="text-xs text-muted leading-relaxed">{d.rule2Text}</p>
        </div>
        <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
          <h5 class="text-xs font-bold text-ink mb-1">{d.rule3Title}</h5>
          <p class="text-xs text-muted leading-relaxed">{d.rule3Text}</p>
        </div>
        <div class="p-4 rounded-xl bg-surface-soft border border-hairline">
          <h5 class="text-xs font-bold text-ink mb-1">{d.rule4Title}</h5>
          <p class="text-xs text-muted leading-relaxed">{d.rule4Text}</p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import freezerData from '../data/cryogenic-nitrogen-freezer-data.json';

  function initCryogenicModeler() {
    const root = document.getElementById('cryogenic-freezer-tool-root');
    if (!root) return;

    // Form inputs
    const freezerSelect = document.getElementById('freezer-arch-select') as HTMLSelectElement;
    const metallurgySelect = document.getElementById('belt-metallurgy-select') as HTMLSelectElement;
    const tempInput = document.getElementById('chamber-temp-input') as HTMLInputElement;
    const tempVal = document.getElementById('chamber-temp-val');
    const ln2FlowInput = document.getElementById('ln2-flow-input') as HTMLInputElement;
    const ln2FlowVal = document.getElementById('ln2-flow-val');
    const roomVolInput = document.getElementById('room-vol-input') as HTMLInputElement;
    const roomVolVal = document.getElementById('room-vol-val');
    const exhaustVentInput = document.getElementById('exhaust-vent-input') as HTMLInputElement;
    const exhaustVentVal = document.getElementById('exhaust-vent-val');
    const sensorSelect = document.getElementById('sensor-interlock-select') as HTMLSelectElement;

    // Presets
    const btnCompliant = document.getElementById('preset-btn-compliant');
    const btnAsphyxiation = document.getElementById('preset-btn-asphyxiation');
    const btnEmbrittlement = document.getElementById('preset-btn-embrittlement');
    const btnImmersion = document.getElementById('preset-btn-immersion');

    // Metrics
    const metricO2 = document.getElementById('metric-o2');
    const badgeO2 = document.getElementById('badge-o2');
    const barO2 = document.getElementById('bar-o2');
    const metricN2Expansion = document.getElementById('metric-n2-expansion');
    const metricLn2LMin = document.getElementById('metric-ln2-l-min');
    const metricCharpy = document.getElementById('metric-charpy');
    const badgeCharpy = document.getElementById('badge-charpy');
    const metricDbttMargin = document.getElementById('metric-dbtt-margin');
    const metricContraction = document.getElementById('metric-contraction');
    const badgeContraction = document.getElementById('badge-contraction');
    const metricSprocketClearance = document.getElementById('metric-sprocket-clearance');
    const metricPooling = document.getElementById('metric-pooling');
    const badgePooling = document.getElementById('badge-pooling');
    const metricInterlockStatus = document.getElementById('metric-interlock-status');

    // Diagnostic Banner
    const bannerRoot = document.getElementById('banner-diagnostic-root');
    const bannerBadge = document.getElementById('banner-compliance-badge');
    const diagPrimaryRisk = document.getElementById('diag-primary-risk');
    const diagMechanisms = document.getElementById('diag-mechanisms');
    const diagMitigation = document.getElementById('diag-mitigation');

    // Copy Button
    const copyBtn = document.getElementById('copy-telemetry-btn');
    const copyText = document.getElementById('copy-btn-text');

    function calculate() {
      const archId = freezerSelect.value;
      const metalId = metallurgySelect.value;
      const tempC = parseFloat(tempInput.value);
      const ln2GalHr = parseFloat(ln2FlowInput.value);
      const roomVolCuFt = parseFloat(roomVolInput.value);
      const exhaustCfm = parseFloat(exhaustVentInput.value);
      const sensorState = sensorSelect.value;

      const tempF = (tempC * 9 / 5) + 32;

      // Update Labels
      if (tempVal) tempVal.textContent = `${tempC.toFixed(0)} °C (${tempF.toFixed(1)} °F)`;
      if (ln2FlowVal) ln2FlowVal.textContent = `${ln2GalHr.toFixed(0)} gal/hr`;
      if (roomVolVal) roomVolVal.textContent = `${roomVolCuFt.toLocaleString()} cu ft`;
      if (exhaustVentVal) exhaustVentVal.textContent = `${exhaustCfm.toLocaleString()} CFM`;

      // Find datasets
      const arch = freezerData.freezerArchitectures.find(a => a.id === archId) || freezerData.freezerArchitectures[0];
      const metal = freezerData.stainlessSteelMetallurgy.find(m => m.id === metalId) || freezerData.stainlessSteelMetallurgy[0];

      // 1. Boil-Off Vapor Expansion Rate
      // 1 gal = 3.78541 Liters. 1 L liquid = 694 L gas @ 20C.
      // Q_gas (L/min) = (ln2GalHr * 3.78541 * 694) / 60
      // 1 L = 0.0353147 cu ft -> Q_gas (CFM) = Q_gas (L/min) * 0.0353147
      const liquidLitersMin = (ln2GalHr * 3.78541) / 60.0;
      const vaporGasCfm = (liquidLitersMin * 694.0) * 0.0353147;

      if (metricN2Expansion) metricN2Expansion.textContent = `${Math.round(vaporGasCfm).toLocaleString()} CFM`;
      if (metricLn2LMin) metricLn2LMin.textContent = `${liquidLitersMin.toFixed(1)} L/min`;

      // 2. Steady-State Room Oxygen Concentration
      // Ambient air contains 20.95% O2.
      // Fresh air intake = exhaustCfm. Total room air leaving = exhaustCfm + vaporGasCfm.
      // Effective O2 percentage = 20.95% * [ exhaustCfm / (exhaustCfm + vaporGasCfm) ]
      let effectiveO2 = 20.95 * (exhaustCfm / (exhaustCfm + vaporGasCfm));

      // Sensor interlock intervention
      let autoCutoffTriggered = false;
      if (sensorState === 'dual_zirconia_interlock') {
        if (effectiveO2 < 19.5) {
          autoCutoffTriggered = true;
          // Solenoid shuts off LN2 flow, recovering O2 toward 19.5%
          effectiveO2 = 19.5;
        }
      } else if (sensorState === 'single_ceiling_sensor') {
        // Ceiling sensor lags because cold N2 pools on floor! True breathing zone is worse
        effectiveO2 = Math.max(4.0, effectiveO2 - 1.8);
      }

      if (metricO2) metricO2.textContent = `${effectiveO2.toFixed(1)}%`;
      if (barO2) {
        const barPct = Math.min(100, Math.max(5, (effectiveO2 / 21.0) * 100));
        barO2.style.width = `${barPct}%`;
      }

      // 3. Belt Charpy Impact Toughness & DBTT
      let charpy = metal.roomTempCharpyJoules;
      let dbttMargin = tempC - metal.ductileToBrittleTransitionTempC;

      if (metal.crystalStructure.includes('FCC')) {
        // Austenitic 304 or 316L retains ductility
        const frac = (tempC - (-196)) / (20 - (-196));
        charpy = metal.cryoCharpyJoules + frac * (metal.roomTempCharpyJoules - metal.cryoCharpyJoules);
      } else {
        // BCC ferritic or martensitic: severe drop below DBTT
        if (tempC < metal.ductileToBrittleTransitionTempC) {
          charpy = metal.cryoCharpyJoules;
        } else {
          charpy = metal.roomTempCharpyJoules;
        }
      }

      if (metricCharpy) metricCharpy.textContent = `${Math.round(charpy)} J`;
      if (metricDbttMargin) {
        if (dbttMargin > 0) {
          metricDbttMargin.textContent = `${Math.round(dbttMargin)} °C above DBTT (Ductile)`;
        } else {
          metricDbttMargin.textContent = `${Math.abs(Math.round(dbttMargin))} °C BELOW DBTT (BRITTLE SHATTER)`;
        }
      }

      // 4. Linear Thermal Contraction
      // ΔL = L * α * ΔT. Belt length in meters. ΔT = 20C - tempC.
      const beltLengthM = arch.beltLengthFt * 0.3048;
      const deltaT = 20 - tempC; // Positive temp drop
      const contractionMm = beltLengthM * (metal.thermalExpansionCoeffPpm * 1e-6) * deltaT * 1000;
      const contractionInches = contractionMm / 25.4;

      if (metricContraction) metricContraction.textContent = `${contractionMm.toFixed(1)} mm`;

      // 5. Cold Gas Stratification / Pooling Index
      const coldGasDensity = 4.61 * (273.15 / (273.15 + tempC));
      const poolingRatio = coldGasDensity / 1.204;
      if (badgePooling) badgePooling.textContent = `${poolingRatio.toFixed(1)}x Air Density`;

      if (metricPooling) {
        if (poolingRatio > 3.0) {
          metricPooling.textContent = 'Heavy Floor Strata';
        } else if (poolingRatio > 2.0) {
          metricPooling.textContent = 'Moderate Pooling';
        } else {
          metricPooling.textContent = 'Diffused Vapor';
        }
      }

      // 6. Badges & Health Assessment
      // Oxygen status
      if (badgeO2 && barO2) {
        if (effectiveO2 >= 19.5) {
          badgeO2.className = 'px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800';
          badgeO2.textContent = 'Safe ≥ 19.5%';
          barO2.className = 'bg-emerald-500 h-1.5 rounded-full transition-all duration-300';
        } else if (effectiveO2 >= 15.0) {
          badgeO2.className = 'px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-amber-100 text-amber-800';
          badgeO2.textContent = 'Warning (Hypoxia)';
          barO2.className = 'bg-amber-500 h-1.5 rounded-full transition-all duration-300';
        } else if (effectiveO2 >= 10.0) {
          badgeO2.className = 'px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-rose-100 text-rose-800';
          badgeO2.textContent = 'Severe Hypoxia';
          barO2.className = 'bg-rose-500 h-1.5 rounded-full transition-all duration-300';
        } else {
          badgeO2.className = 'px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-red-900 text-white animate-pulse';
          badgeO2.textContent = 'Fatal Asphyxiation (<10%)';
          barO2.className = 'bg-red-700 h-1.5 rounded-full transition-all duration-300';
        }
      }

      // Charpy Badge
      if (badgeCharpy) {
        if (charpy >= 50) {
          badgeCharpy.className = 'px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800';
          badgeCharpy.textContent = 'Ductile FCC';
        } else if (charpy >= 20) {
          badgeCharpy.className = 'px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-amber-100 text-amber-800';
          badgeCharpy.textContent = 'Moderate Toughness';
        } else {
          badgeCharpy.className = 'px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-rose-100 text-rose-800 font-black';
          badgeCharpy.textContent = 'BRITTLE / SHATTER RISK';
        }
      }

      // Contraction Badge
      if (badgeContraction && metricSprocketClearance) {
        if (contractionMm > 50) {
          badgeContraction.className = 'px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-rose-100 text-rose-800';
          badgeContraction.textContent = 'High Jam Risk';
          metricSprocketClearance.textContent = 'Exceeds Take-up Margin (Drive Jam)';
        } else if (contractionMm > 30) {
          badgeContraction.className = 'px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-cyan-100 text-cyan-800';
          badgeContraction.textContent = 'Take-Up OK';
          metricSprocketClearance.textContent = 'Take-up springs engaged';
        } else {
          badgeContraction.className = 'px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800';
          badgeContraction.textContent = 'Minimal Strain';
          metricSprocketClearance.textContent = 'Standard clearance';
        }
      }

      // Interlock status
      if (metricInterlockStatus) {
        if (autoCutoffTriggered) {
          metricInterlockStatus.textContent = 'SOLENOID CUTOFF ACTIVATED (19.5% O2)';
          metricInterlockStatus.className = 'font-bold font-mono text-rose-600 animate-pulse';
        } else if (sensorState === 'dual_zirconia_interlock') {
          metricInterlockStatus.textContent = 'ARMED / NORMAL (CGA P-12)';
          metricInterlockStatus.className = 'font-bold font-mono text-emerald-700';
        } else if (sensorState === 'single_ceiling_sensor') {
          metricInterlockStatus.textContent = 'NON-COMPLIANT (DELAYED SENSING)';
          metricInterlockStatus.className = 'font-bold font-mono text-amber-700';
        } else {
          metricInterlockStatus.textContent = 'DISABLED / UNMONITORED HAZARD';
          metricInterlockStatus.className = 'font-bold font-mono text-red-700 font-black';
        }
      }

      // Comprehensive Compliance & Banner Directives
      let isCompliant = true;
      let primaryRisk = '';
      let mechanisms = '';
      let mitigation = '';

      if (effectiveO2 < 19.5 || sensorState === 'unmonitored_scullery' || (sensorState === 'single_ceiling_sensor' && effectiveO2 < 19.5)) {
        isCompliant = false;
        primaryRisk = 'CGA P-12 & OSHA 1910.146 Atmospheric Oxygen Depletion Hazard';
        mechanisms = `1:694 liquid-to-gas expansion generates ${Math.round(vaporGasCfm)} CFM of pure nitrogen vapor, exceeding scullery exhaust dilution capacity and depressing breathing zone oxygen to ${effectiveO2.toFixed(1)}%.`;
        mitigation = 'Immediately evacuate area; increase forced mechanical ventilation to ≥5,000 CFM; install interlocked CGA P-12 dual zirconium oxide sensors with automatic LN2 shutoff solenoids.';
      } else if (charpy < 15 || metal.crystalStructure.includes('BCC')) {
        isCompliant = false;
        primaryRisk = 'Catastrophic Cryogenic Wire Mesh Cold Embrittlement & Disintegration';
        mechanisms = `The ferritic BCC crystal lattice undergoes a steep ductile-to-brittle transition (DBTT) at -10°C. Operating at ${tempC}°C in liquid nitrogen collapses Charpy impact toughness to ${Math.round(charpy)} J, risking belt shatter under conveyor drive tension.`;
        mitigation = 'Decommission ferritic 430 wire mesh belting immediately; retrofit with NSF-listed high-nickel austenitic AISI 316L (UNS S31603) or 304 mesh belting.';
      } else if (contractionMm > 48) {
        isCompliant = false;
        primaryRisk = 'Extreme Conveyor Linear Thermal Contraction & Drive Sprocket Jamming';
        mechanisms = `Deep thermal shock (ΔT = ${deltaT}°C) causes ${contractionMm.toFixed(1)} mm (${contractionInches.toFixed(2)} in) of linear belt shrinkage, overcoming take-up roller spring travel and threatening drive motor gear stripping.`;
        mitigation = 'Install extended-travel counterweighted or pneumatic take-up rollers; inspect cryogenic NSF H1 fluorosilicone bearing lubricants for cold crystallization.';
      } else {
        primaryRisk = 'Normal Cryogenic IQF Operational Regime';
        mechanisms = `Adequate mechanical exhaust (${exhaustCfm.toLocaleString()} CFM) balances ${Math.round(vaporGasCfm)} CFM N2 boil-off; stable FCC austenitic 316L/304 retains high cryogenic Charpy toughness (${Math.round(charpy)} J).`;
        mitigation = 'Maintain quarterly CGA P-12 sensor calibration; verify ASME B31.3 thermal relief valves (PRV) on liquid nitrogen transfer piping; lubricate idler bearings with cryogenic low-temp grease.';
      }

      if (bannerBadge && bannerRoot) {
        if (isCompliant) {
          bannerBadge.className = 'px-2.5 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-emerald-600 text-white';
          bannerBadge.textContent = 'COMPLIANT • CGA P-12 SAFE';
          bannerRoot.className = 'p-5 rounded-2xl border border-emerald-200 bg-emerald-50/30 shadow-xs transition-colors';
        } else {
          bannerBadge.className = 'px-2.5 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-rose-600 text-white animate-pulse';
          bannerBadge.textContent = 'CRITICAL SAFETY DEFICIENCY';
          bannerRoot.className = 'p-5 rounded-2xl border border-rose-200 bg-rose-50/40 shadow-xs transition-colors';
        }
      }

      if (diagPrimaryRisk) diagPrimaryRisk.textContent = primaryRisk;
      if (diagMechanisms) diagMechanisms.textContent = mechanisms;
      if (diagMitigation) diagMitigation.textContent = mitigation;
    }

    // Presets
    if (btnCompliant) {
      btnCompliant.addEventListener('click', () => {
        freezerSelect.value = 'industrial_continuous_tunnel_freezer';
        metallurgySelect.value = 'aisi_316l_austenitic';
        tempInput.value = '-196';
        ln2FlowInput.value = '680';
        roomVolInput.value = '18500';
        exhaustVentInput.value = '4800';
        sensorSelect.value = 'dual_zirconia_interlock';
        calculate();
      });
    }

    if (btnAsphyxiation) {
      btnAsphyxiation.addEventListener('click', () => {
        freezerSelect.value = 'unventilated_batch_cabinet_freezer';
        metallurgySelect.value = 'aisi_304_austenitic';
        tempInput.value = '-196';
        ln2FlowInput.value = '350';
        roomVolInput.value = '3200';
        exhaustVentInput.value = '350';
        sensorSelect.value = 'unmonitored_scullery';
        calculate();
      });
    }

    if (btnEmbrittlement) {
      btnEmbrittlement.addEventListener('click', () => {
        freezerSelect.value = 'industrial_continuous_tunnel_freezer';
        metallurgySelect.value = 'aisi_430_ferritic';
        tempInput.value = '-196';
        ln2FlowInput.value = '500';
        roomVolInput.value = '15000';
        exhaustVentInput.value = '3800';
        sensorSelect.value = 'dual_zirconia_interlock';
        calculate();
      });
    }

    if (btnImmersion) {
      btnImmersion.addEventListener('click', () => {
        freezerSelect.value = 'direct_immersion_bath_crust_freezer';
        metallurgySelect.value = 'aisi_316l_austenitic';
        tempInput.value = '-196';
        ln2FlowInput.value = '520';
        roomVolInput.value = '8500';
        exhaustVentInput.value = '3600';
        sensorSelect.value = 'dual_zirconia_interlock';
        calculate();
      });
    }

    // Input listeners
    [freezerSelect, metallurgySelect, tempInput, ln2FlowInput, roomVolInput, exhaustVentInput, sensorSelect].forEach(el => {
      if (el) el.addEventListener('input', calculate);
    });

    // Copy Telemetry
    if (copyBtn && copyText) {
      copyBtn.addEventListener('click', () => {
        const report = `======================================================================
ISITKITCHENSAFE CRYOGENIC LIQUID NITROGEN FREEZER SAFETY TELEMETRY
Standard: CGA P-12 / OSHA 29 CFR 1910.146 / ASME B31.3 / NSF/ANSI 169
======================================================================
Architecture: ${freezerSelect.selectedOptions[0]?.text || freezerSelect.value}
Belt Metallurgy: ${metallurgySelect.selectedOptions[0]?.text || metallurgySelect.value}
Chamber Operating Temp: ${tempInput.value} °C (${((parseFloat(tempInput.value) * 9/5) + 32).toFixed(1)} °F)
Liquid Nitrogen (LN2) Flow: ${ln2FlowInput.value} gal/hr
Room Volume: ${roomVolInput.value} cu ft
Mechanical Exhaust Rate: ${exhaustVentInput.value} CFM
Sensor Interlock System: ${sensorSelect.selectedOptions[0]?.text || sensorSelect.value}
----------------------------------------------------------------------
TELEMETRY RESULTS:
Breathing Zone Oxygen: ${metricO2?.textContent || 'N/A'}
Boil-Off N2 Gas Expansion: ${metricN2Expansion?.textContent || 'N/A'} (1:694 expansion)
Belt Charpy Impact Toughness: ${metricCharpy?.textContent || 'N/A'}
Conveyor Thermal Contraction: ${metricContraction?.textContent || 'N/A'}
Cold N2 Floor Pooling: ${metricPooling?.textContent || 'N/A'}
CGA P-12 Interlock Status: ${metricInterlockStatus?.textContent || 'N/A'}
----------------------------------------------------------------------
DIAGNOSIS:
Primary Risk: ${diagPrimaryRisk?.textContent || 'N/A'}
Mechanisms: ${diagMechanisms?.textContent || 'N/A'}
Remediation: ${diagMitigation?.textContent || 'N/A'}
======================================================================`;

        navigator.clipboard.writeText(report).then(() => {
          const originalText = copyText.textContent;
          copyText.textContent = 'Telemetry Copied to Clipboard!';
          setTimeout(() => {
            copyText.textContent = originalText;
          }, 2500);
        });
      });
    }

    calculate();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCryogenicModeler);
  } else {
    initCryogenicModeler();
  }
</script>
