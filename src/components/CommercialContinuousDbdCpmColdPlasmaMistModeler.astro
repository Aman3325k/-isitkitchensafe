<!-- Reactive Client-Side Simulation Script -->
<script is:inline>
  (function initDbdCpmSimulation() {
    // DOM Elements
    const presetSelect = document.getElementById('dbd-preset-select');
    const archSelect = document.getElementById('dbd-arch-select');
    const commoditySelect = document.getElementById('dbd-commodity-select');
    const gasSelect = document.getElementById('dbd-gas-select');
    const scrubberToggle = document.getElementById('dbd-scrubber-toggle');

    const voltageSlider = document.getElementById('dbd-voltage-slider');
    const freqSlider = document.getElementById('dbd-freq-slider');
    const mistSlider = document.getElementById('dbd-mist-slider');
    const dropletSlider = document.getElementById('dbd-droplet-slider');
    const timeSlider = document.getElementById('dbd-time-slider');

    const voltageVal = document.getElementById('dbd-voltage-val');
    const freqVal = document.getElementById('dbd-freq-val');
    const mistVal = document.getElementById('dbd-mist-val');
    const dropletVal = document.getElementById('dbd-droplet-val');
    const timeVal = document.getElementById('dbd-time-val');

    const listeriaVal = document.getElementById('dbd-listeria-val');
    const salmonellaVal = document.getElementById('dbd-salmonella-val');
    const ecoliVal = document.getElementById('dbd-ecoli-val');
    const norovirusVal = document.getElementById('dbd-norovirus-val');
    const ronsVal = document.getElementById('dbd-rons-val');
    const qualityVal = document.getElementById('dbd-quality-val');
    const ppoVal = document.getElementById('dbd-ppo-val');
    const ozoneVal = document.getElementById('dbd-ozone-val');
    const ozoneSub = document.getElementById('dbd-ozone-sub');
    const energyVal = document.getElementById('dbd-energy-val');

    const statusPill = document.getElementById('dbd-status-pill');
    const statusText = document.getElementById('dbd-status-text');
    const advisoryMsg = document.getElementById('dbd-advisory-msg');
    const advisoryBox = document.getElementById('dbd-advisory-box');

    // Commodity baseline calibration factors
    const COMMODITY_FACTORS = {
      leafy_baby_spinach_microgreens: { listeriaBase: 5.3, salmBase: 5.5, ecoliBase: 5.4, noroBase: 4.8, ppoBase: 88, sens: 1.2 },
      whole_strawberries_raspberries: { listeriaBase: 4.9, salmBase: 5.1, ecoliBase: 5.0, noroBase: 4.6, ppoBase: 90, sens: 1.4 },
      whole_cantaloupe_melons: { listeriaBase: 5.6, salmBase: 5.8, ecoliBase: 5.7, noroBase: 5.0, ppoBase: 94, sens: 0.6 },
      ready_to_eat_sprouted_seeds: { listeriaBase: 5.4, salmBase: 5.6, ecoliBase: 5.5, noroBase: 4.7, ppoBase: 85, sens: 1.1 },
      fresh_cut_diced_apples: { listeriaBase: 5.1, salmBase: 5.3, ecoliBase: 5.2, noroBase: 4.5, ppoBase: 95, sens: 1.0 }
    };

    function recalculate() {
      const V = parseFloat(voltageSlider.value);
      const f = parseFloat(freqSlider.value);
      const Q = parseFloat(mistSlider.value);
      const D32 = parseFloat(dropletSlider.value);
      const t = parseFloat(timeSlider.value);
      const gas = gasSelect.value;
      const scrubber = scrubberToggle.checked;
      const commodityKey = commoditySelect.value;
      const cf = COMMODITY_FACTORS[commodityKey] || COMMODITY_FACTORS.leafy_baby_spinach_microgreens;

      // Update Slider Value Labels
      voltageVal.textContent = V.toFixed(1) + ' kV';
      freqVal.textContent = f.toFixed(1) + ' kHz';
      mistVal.textContent = Q.toFixed(1) + ' L/h';
      dropletVal.textContent = D32.toFixed(1) + ' µm';
      timeVal.textContent = t.toFixed(1) + ' s';

      // Carrier Gas Factor
      let gasMultiplier = 1.0;
      if (gas === 'oxygen_enriched') gasMultiplier = 1.25;
      else if (gas === 'nitrogen_argon') gasMultiplier = 0.90;

      // Inactivation Calculations
      // Base non-dimensional scaling
      const powerIntensity = Math.pow(V / 18.0, 1.35) * Math.pow(f / 25.0, 0.65);
      const timeFactor = Math.pow(t / 25.0, 0.55);
      const dropletFactor = Math.pow(15.0 / D32, 0.40);
      const mistAvailability = Math.min(1.2, Math.pow(Q / 4.5, 0.35));

      const logScaling = powerIntensity * timeFactor * dropletFactor * mistAvailability * gasMultiplier;

      const listeriaLog = Math.min(6.5, Math.max(0.5, cf.listeriaBase * logScaling * 0.95));
      const salmonellaLog = Math.min(6.8, Math.max(0.6, cf.salmBase * logScaling * 1.02));
      const ecoliLog = Math.min(6.6, Math.max(0.5, cf.ecoliBase * logScaling * 0.98));
      const norovirusLog = Math.min(5.8, Math.max(0.4, cf.noroBase * logScaling * 0.88));

      // RONS Aqueous Radical Flux (µM)
      const ronsFlux = Math.round(450.0 * Math.pow(V / 18.0, 1.8) * Math.pow(f / 25.0, 0.8) * Math.pow(Q / 4.5, 0.5) * gasMultiplier);

      // Quality & Firmness Retention (%)
      let wiltPenalty = 0;
      if (V > 24) wiltPenalty += (V - 24) * 1.5 * cf.sens;
      if (t > 45) wiltPenalty += (t - 45) * 0.18 * cf.sens;
      if (Q < 1.5 && V > 22) wiltPenalty += 4.5; // dry thermal scorch
      const qualityScore = Math.max(68.0, Math.min(99.6, 99.6 - wiltPenalty));

      // PPO Browning Inhibition (%)
      const ppoScore = Math.min(98.8, Math.max(35.0, cf.ppoBase * Math.pow(V / 18.0, 0.45) * Math.pow(t / 25.0, 0.30)));

      // Exhaust Ozone Level (ppm)
      let ambientO3 = 0.015 * (V / 18.0) * (f / 25.0) * (gas === 'oxygen_enriched' ? 2.1 : 1.0);
      if (!scrubber) {
        ambientO3 = 3.65 * (V / 18.0) * (f / 25.0) * (gas === 'oxygen_enriched' ? 2.4 : 1.0);
      }

      // Specific Energy Consumption (kJ/kg)
      const powerKw = 0.85 * Math.pow(V / 18.0, 2.0) * (f / 25.0);
      const capacityKgPerH = 1500.0;
      const energyConsumption = ((powerKw * 3600.0) / capacityKgPerH) * (t / 25.0);

      // Update Telemetry Display
      listeriaVal.textContent = listeriaLog.toFixed(2) + ' log';
      salmonellaVal.textContent = salmonellaLog.toFixed(2) + ' log';
      ecoliVal.textContent = ecoliLog.toFixed(2) + ' log';
      norovirusVal.textContent = norovirusLog.toFixed(2) + ' log';
      ronsVal.textContent = ronsFlux + ' µM';
      qualityVal.textContent = qualityScore.toFixed(1) + '%';
      ppoVal.textContent = ppoScore.toFixed(1) + '%';
      ozoneVal.textContent = ambientO3.toFixed(3) + ' ppm';
      energyVal.textContent = energyConsumption.toFixed(1) + ' kJ/kg';

      // Update Color coding & Badges
      if (ambientO3 > 0.10) {
        ozoneVal.className = 'text-xl sm:text-2xl font-extrabold font-mono text-red-500';
        ozoneSub.textContent = 'OSHA VIOLATION (> 0.10 ppm)';
        ozoneSub.className = 'text-[10px] text-red-500 font-bold block';
      } else {
        ozoneVal.className = 'text-xl sm:text-2xl font-extrabold font-mono text-emerald-500';
        ozoneSub.textContent = 'OSHA Compliant (< 0.05 ppm)';
        ozoneSub.className = 'text-[10px] text-muted block';
      }

      if (qualityScore < 90.0) {
        qualityVal.className = 'text-xl sm:text-2xl font-extrabold font-mono text-amber-500';
      } else {
        qualityVal.className = 'text-xl sm:text-2xl font-extrabold font-mono text-emerald-500';
      }

      // Status Assessment
      if (ambientO3 > 0.10) {
        statusPill.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wide bg-red-950 text-red-300 border border-red-800 shrink-0';
        statusText.textContent = 'OSHA Ozone Hazard';
        advisoryBox.className = 'p-4 rounded-xl bg-red-950/40 border border-red-800 text-xs text-red-200 leading-relaxed';
        advisoryMsg.textContent = 'HAZARD: Catalytic ozone scrubber is bypassed! Workplace ambient exhaust exceeds OSHA permissible exposure limits (PEL 0.10 ppm). Immediately engage catalytic destruct unit.';
      } else if (qualityScore < 90.0) {
        statusPill.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wide bg-amber-950 text-amber-300 border border-amber-800 shrink-0';
        statusText.textContent = 'Thermal Scorch / Wilt Warning';
        advisoryBox.className = 'p-4 rounded-xl bg-amber-950/40 border border-amber-800 text-xs text-amber-200 leading-relaxed';
        advisoryMsg.textContent = 'WARNING: High discharge voltage or extended transit time is causing cellular wilt and chlorosis. Reduce applied voltage or increase ultrasonic mist delivery rate.';
      } else if (listeriaLog >= 5.0 && salmonellaLog >= 5.0) {
        statusPill.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wide bg-emerald-950 text-emerald-300 border border-emerald-800 shrink-0';
        statusText.textContent = 'Gold Master / 3-A Validated';
        advisoryBox.className = 'p-4 rounded-xl bg-cyan-950/40 border border-cyan-800 text-xs text-cyan-200 leading-relaxed';
        advisoryMsg.textContent = 'Optimal operating conditions. Hydroxyl radical mass transfer achieves >5.2-log eradication of Listeria monocytogenes and Salmonella enterica without produce waterlogging or thermal chlorosis.';
      } else {
        statusPill.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wide bg-blue-950 text-blue-300 border border-blue-800 shrink-0';
        statusText.textContent = 'Sub-Lethal Sanitization';
        advisoryBox.className = 'p-4 rounded-xl bg-blue-950/40 border border-blue-800 text-xs text-blue-200 leading-relaxed';
        advisoryMsg.textContent = 'Sub-lethal microbial inactivation. Pathogen reduction is below the 5.0-log commercial FDA standard. Increase residence time or applied discharge voltage.';
      }
    }

    // Presets Handler
    presetSelect.addEventListener('change', function (e) {
      const mode = e.target.value;
      if (mode === 'spinach') {
        commoditySelect.value = 'leafy_baby_spinach_microgreens';
        voltageSlider.value = 18.0;
        freqSlider.value = 25.0;
        mistSlider.value = 4.5;
        dropletSlider.value = 12.0;
        timeSlider.value = 25.0;
        gasSelect.value = 'ambient_air';
        scrubberToggle.checked = true;
      } else if (mode === 'berry') {
        commoditySelect.value = 'whole_strawberries_raspberries';
        voltageSlider.value = 15.0;
        freqSlider.value = 20.0;
        mistSlider.value = 2.2;
        dropletSlider.value = 8.0;
        timeSlider.value = 18.0;
        gasSelect.value = 'oxygen_enriched';
        scrubberToggle.checked = true;
      } else if (mode === 'melon') {
        commoditySelect.value = 'whole_cantaloupe_melons';
        voltageSlider.value = 24.0;
        freqSlider.value = 32.0;
        mistSlider.value = 8.5;
        dropletSlider.value = 22.0;
        timeSlider.value = 45.0;
        gasSelect.value = 'ambient_air';
        scrubberToggle.checked = true;
      } else if (mode === 'sprout') {
        commoditySelect.value = 'ready_to_eat_sprouted_seeds';
        voltageSlider.value = 20.0;
        freqSlider.value = 28.0;
        mistSlider.value = 5.0;
        dropletSlider.value = 14.0;
        timeSlider.value = 30.0;
        gasSelect.value = 'ambient_air';
        scrubberToggle.checked = true;
      } else if (mode === 'hazard') {
        commoditySelect.value = 'leafy_baby_spinach_microgreens';
        voltageSlider.value = 28.0;
        freqSlider.value = 48.0;
        mistSlider.value = 0.5;
        dropletSlider.value = 32.0;
        timeSlider.value = 80.0;
        gasSelect.value = 'ambient_air';
        scrubberToggle.checked = false;
      }
      recalculate();
    });

    // Attach listeners
    [voltageSlider, freqSlider, mistSlider, dropletSlider, timeSlider].forEach(el => {
      el.addEventListener('input', recalculate);
    });
    [commoditySelect, archSelect, gasSelect, scrubberToggle].forEach(el => {
      el.addEventListener('change', recalculate);
    });

    // Initial run
    recalculate();
  })();
</script>
