  }
};

const d = DICT[lang] || DICT.en;
---

<div class="dbd-cpm-container max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-12">
  <!-- Header Banner -->
  <header class="text-center space-y-4 max-w-4xl mx-auto">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-cyan-950 text-cyan-200 border border-cyan-800 shadow-xs">
      <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
      {d.badge}
    </div>
    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-ink tracking-tight">
      {d.title}
    </h1>
    <p class="text-muted text-sm sm:text-base leading-relaxed">
      {d.subtitle}
    </p>
  </header>

  <!-- Main Simulator Layout: Two Columns on Large Screens -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Controls Panel (5 cols) -->
    <section class="lg:col-span-5 bg-surface-soft border border-hairline rounded-2xl p-6 sm:p-7 shadow-xs space-y-6">
      <div class="border-b border-hairline/60 pb-4">
        <h2 class="text-lg font-bold text-ink flex items-center gap-2">
          <svg class="w-5 h-5 text-cyan-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
          </svg>
          {d.controlsTitle}
        </h2>
        <p class="text-xs text-muted mt-1 leading-normal">
          {d.controlsSub}
        </p>
      </div>

      <!-- Presets Selector -->
      <div class="space-y-2">
        <label for="dbd-preset-select" class="block text-xs font-bold uppercase tracking-wider text-ink/80">
          {d.presetsTitle}
        </label>
        <select id="dbd-preset-select" class="w-full text-xs rounded-xl bg-surface border border-hairline p-2.5 text-ink focus:outline-none focus:ring-2 focus:ring-cyan-500">
          <option value="spinach" selected>{d.presetSpinach}</option>
          <option value="berry">{d.presetBerry}</option>
          <option value="melon">{d.presetMelon}</option>
          <option value="sprout">{d.presetSprout}</option>
          <option value="hazard">{d.presetHazard}</option>
        </select>
      </div>

      <!-- Architecture Selection -->
      <div class="space-y-1.5">
        <label for="dbd-arch-select" class="block text-xs font-semibold text-ink">
          {d.systemLabel}
        </label>
        <select id="dbd-arch-select" class="w-full text-xs rounded-xl bg-surface border border-hairline p-2.5 text-ink focus:outline-none focus:ring-2 focus:ring-cyan-500">
          {dbdData.systemArchitectures.map((arch) => (
            <option value={arch.id}>{arch.name} ({arch.nominalCapacityKgPerHour} kg/h)</option>
          ))}
        </select>
        <p class="text-[11px] text-muted">{d.systemHelp}</p>
      </div>

      <!-- Commodity Selection -->
      <div class="space-y-1.5">
        <label for="dbd-commodity-select" class="block text-xs font-semibold text-ink">
          {d.commodityLabel}
        </label>
        <select id="dbd-commodity-select" class="w-full text-xs rounded-xl bg-surface border border-hairline p-2.5 text-ink focus:outline-none focus:ring-2 focus:ring-cyan-500">
          {dbdData.produceCommodities.map((comm) => (
            <option value={comm.id}>{comm.name}</option>
          ))}
        </select>
        <p class="text-[11px] text-muted">{d.commodityHelp}</p>
      </div>

      <!-- Sliders Grid -->
      <div class="space-y-4 pt-2">
        <!-- Voltage -->
        <div class="space-y-1">
          <div class="flex justify-between text-xs">
            <span class="font-medium text-ink">{d.voltageLabel}</span>
            <span id="dbd-voltage-val" class="font-mono font-bold text-cyan-600 dark:text-cyan-400">18.0 kV</span>
          </div>
          <input id="dbd-voltage-slider" type="range" min="10" max="30" step="0.5" value="18.0" class="w-full accent-cyan-500 cursor-pointer" />
          <p class="text-[10px] text-muted">{d.voltageHelp}</p>
        </div>

        <!-- Frequency -->
        <div class="space-y-1">
          <div class="flex justify-between text-xs">
            <span class="font-medium text-ink">{d.frequencyLabel}</span>
            <span id="dbd-freq-val" class="font-mono font-bold text-cyan-600 dark:text-cyan-400">25.0 kHz</span>
          </div>
          <input id="dbd-freq-slider" type="range" min="10" max="50" step="1" value="25" class="w-full accent-cyan-500 cursor-pointer" />
          <p class="text-[10px] text-muted">{d.frequencyHelp}</p>
        </div>

        <!-- Mist Flow Rate -->
        <div class="space-y-1">
          <div class="flex justify-between text-xs">
            <span class="font-medium text-ink">{d.mistRateLabel}</span>
            <span id="dbd-mist-val" class="font-mono font-bold text-cyan-600 dark:text-cyan-400">4.5 L/h</span>
          </div>
          <input id="dbd-mist-slider" type="range" min="1.0" max="12.0" step="0.5" value="4.5" class="w-full accent-cyan-500 cursor-pointer" />
          <p class="text-[10px] text-muted">{d.mistRateHelp}</p>
        </div>

        <!-- Droplet Size -->
        <div class="space-y-1">
          <div class="flex justify-between text-xs">
            <span class="font-medium text-ink">{d.dropletSizeLabel}</span>
            <span id="dbd-droplet-val" class="font-mono font-bold text-cyan-600 dark:text-cyan-400">12.0 µm</span>
          </div>
          <input id="dbd-droplet-slider" type="range" min="5" max="35" step="1" value="12" class="w-full accent-cyan-500 cursor-pointer" />
          <p class="text-[10px] text-muted">{d.dropletSizeHelp}</p>
        </div>

        <!-- Residence Time -->
        <div class="space-y-1">
          <div class="flex justify-between text-xs">
            <span class="font-medium text-ink">{d.exposureTimeLabel}</span>
            <span id="dbd-time-val" class="font-mono font-bold text-cyan-600 dark:text-cyan-400">25.0 s</span>
          </div>
          <input id="dbd-time-slider" type="range" min="5" max="90" step="1" value="25" class="w-full accent-cyan-500 cursor-pointer" />
          <p class="text-[10px] text-muted">{d.exposureTimeHelp}</p>
        </div>

        <!-- Gas Mix -->
        <div class="space-y-1">
          <label for="dbd-gas-select" class="block text-xs font-semibold text-ink">
            {d.gasMixLabel}
          </label>
          <select id="dbd-gas-select" class="w-full text-xs rounded-xl bg-surface border border-hairline p-2 text-ink focus:outline-none focus:ring-2 focus:ring-cyan-500">
            <option value="ambient_air" selected>Ambient Air (78% N2 / 21% O2 / 1% Ar)</option>
            <option value="oxygen_enriched">Oxygen-Enriched Gas (90% O2 / 10% N2)</option>
            <option value="nitrogen_argon">Cold Nitrogen/Argon Stream (95% N2 / 5% Ar)</option>
          </select>
          <p class="text-[10px] text-muted">{d.gasMixHelp}</p>
        </div>

        <!-- Catalytic Scrubber Toggle -->
        <div class="flex items-center justify-between p-3 rounded-xl bg-surface border border-hairline">
          <div>
            <div class="text-xs font-bold text-ink">{d.scrubberLabel}</div>
            <div class="text-[10px] text-muted">{d.scrubberHelp}</div>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" id="dbd-scrubber-toggle" class="sr-only peer" checked />
            <div class="w-9 h-5 bg-gray-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-cyan-600"></div>
          </label>
        </div>
      </div>
    </section>

    <!-- Telemetry & Diagnostic Panel (7 cols) -->
    <section class="lg:col-span-7 space-y-6">
      <div class="bg-surface-soft border border-hairline rounded-2xl p-6 sm:p-7 shadow-xs space-y-6">
        <div class="border-b border-hairline/60 pb-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
          <div>
            <h2 class="text-lg font-bold text-ink flex items-center gap-2">
              <svg class="w-5 h-5 text-cyan-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              {d.diagnosticTitle}
            </h2>
            <p class="text-xs text-muted mt-1 leading-normal">
              {d.diagnosticSub}
            </p>
          </div>
          <div id="dbd-status-pill" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wide bg-emerald-950 text-emerald-300 border border-emerald-800 shrink-0">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            <span id="dbd-status-text">Gold Master / 3-A Validated</span>
          </div>
        </div>

        <!-- Telemetry Cards Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-2 gap-4">
          <!-- Listeria -->
          <div class="p-4 rounded-xl bg-surface border border-hairline space-y-1">
            <span class="text-xs text-muted block">{d.listeriaLogLabel}</span>
            <span id="dbd-listeria-val" class="text-xl sm:text-2xl font-extrabold font-mono text-cyan-600 dark:text-cyan-400">5.42 log</span>
            <span class="text-[10px] text-muted block">Peptidoglycan &amp; Teichoic lysis</span>
          </div>

          <!-- Salmonella -->
          <div class="p-4 rounded-xl bg-surface border border-hairline space-y-1">
            <span class="text-xs text-muted block">{d.salmonellaLogLabel}</span>
            <span id="dbd-salmonella-val" class="text-xl sm:text-2xl font-extrabold font-mono text-cyan-600 dark:text-cyan-400">5.65 log</span>
            <span class="text-[10px] text-muted block">LPS outer bilayer rupture</span>
          </div>

          <!-- E. coli -->
          <div class="p-4 rounded-xl bg-surface border border-hairline space-y-1">
            <span class="text-xs text-muted block">{d.ecoliLogLabel}</span>
            <span id="dbd-ecoli-val" class="text-xl sm:text-2xl font-extrabold font-mono text-cyan-600 dark:text-cyan-400">5.51 log</span>
            <span class="text-[10px] text-muted block">DNA fragmentation &amp; O-antigen</span>
          </div>

          <!-- Norovirus -->
          <div class="p-4 rounded-xl bg-surface border border-hairline space-y-1">
            <span class="text-xs text-muted block">{d.norovirusLogLabel}</span>
            <span id="dbd-norovirus-val" class="text-xl sm:text-2xl font-extrabold font-mono text-cyan-600 dark:text-cyan-400">4.88 log</span>
            <span class="text-[10px] text-muted block">VP1 protein capsid oxidation</span>
          </div>

          <!-- RONS Radical Flux -->
          <div class="p-4 rounded-xl bg-surface border border-hairline space-y-1">
            <span class="text-xs text-muted block">{d.ronsFluxLabel}</span>
            <span id="dbd-rons-val" class="text-xl sm:text-2xl font-extrabold font-mono text-cyan-600 dark:text-cyan-400">485 µM</span>
            <span class="text-[10px] text-muted block">•OH, O2•⁻, ONOO⁻, H2O2 flux</span>
          </div>

          <!-- Quality Retention -->
          <div class="p-4 rounded-xl bg-surface border border-hairline space-y-1">
            <span class="text-xs text-muted block">{d.qualityRetentionLabel}</span>
            <span id="dbd-quality-val" class="text-xl sm:text-2xl font-extrabold font-mono text-emerald-600 dark:text-emerald-400">98.7%</span>
            <span class="text-[10px] text-muted block">Zero wilting / chlorophyll intact</span>
          </div>

          <!-- PPO Inhibition -->
          <div class="p-4 rounded-xl bg-surface border border-hairline space-y-1">
            <span class="text-xs text-muted block">{d.ppoInhibitionLabel}</span>
            <span id="dbd-ppo-val" class="text-xl sm:text-2xl font-extrabold font-mono text-emerald-600 dark:text-emerald-400">92.4%</span>
            <span class="text-[10px] text-muted block">Enzymatic browning arrested</span>
          </div>

          <!-- Ozone Emission -->
          <div class="p-4 rounded-xl bg-surface border border-hairline space-y-1">
            <span class="text-xs text-muted block">{d.ozoneEmissionLabel}</span>
            <span id="dbd-ozone-val" class="text-xl sm:text-2xl font-extrabold font-mono text-emerald-600 dark:text-emerald-400">0.018 ppm</span>
            <span id="dbd-ozone-sub" class="text-[10px] text-muted block">OSHA Compliant (&lt;0.05 ppm)</span>
          </div>

          <!-- Specific Energy Consumption -->
          <div class="p-4 rounded-xl bg-surface border border-hairline space-y-1">
            <span class="text-xs text-muted block">{d.energyKjLabel}</span>
            <span id="dbd-energy-val" class="text-xl sm:text-2xl font-extrabold font-mono text-ink">31.2 kJ/kg</span>
            <span class="text-[10px] text-muted block">50% less energy than wash skid</span>
          </div>

          <!-- Chemical Residue -->
          <div class="p-4 rounded-xl bg-surface border border-hairline space-y-1">
            <span class="text-xs text-muted block">{d.chemicalResidueLabel}</span>
            <span class="text-xl sm:text-2xl font-extrabold font-mono text-emerald-600 dark:text-emerald-400">0.00 ppm</span>
            <span class="text-[10px] text-emerald-500 font-bold block">100% Organic / Chlorine-Free</span>
          </div>
        </div>

        <!-- Overall Advisory Banner -->
        <div id="dbd-advisory-box" class="p-4 rounded-xl bg-cyan-950/40 border border-cyan-800 text-xs text-cyan-200 leading-relaxed">
