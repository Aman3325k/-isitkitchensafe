        <span class="hidden lg:inline">{t.applianceLinksTitle}:</span>
        <a href={microwaveUrl} class="hover:text-ink underline decoration-hairline">
          {lang === 'en' ? 'Microwave Guide' : lang === 'es' ? 'Microondas' : lang === 'pt' ? 'Micro-ondas' : lang === 'zh-cn' ? '微波炉指南' : '電子レンジ'}
        </a>
        <span>&bull;</span>
        <a href={dishwasherUrl} class="hover:text-ink underline decoration-hairline">
          {lang === 'en' ? 'Dishwasher Guide' : lang === 'es' ? 'Lavavajillas' : lang === 'pt' ? 'Lava-louças' : lang === 'zh-cn' ? '洗碗机指南' : '食洗機'}
        </a>
        <span>&bull;</span>
        <a href={freezerUrl} class="hover:text-ink underline decoration-hairline">
          {lang === 'en' ? 'Freezer Guide' : lang === 'es' ? 'Congelador' : lang === 'pt' ? 'Freezer' : lang === 'zh-cn' ? '冷冻指南' : '冷凍庫'}
        </a>
      </div>
    </div>
  </div>

  <!-- Master Resin Comparison Reference Table -->
  <section class="bg-surface-soft border border-hairline rounded-3xl p-6 md:p-8 space-y-4 shadow-xs">
    <div class="border-b border-hairline pb-4">
      <span class="text-xs font-bold uppercase tracking-wider text-muted block mb-1">
        {lang === 'en' && 'Official Kitchen Reference Guide'}
        {lang === 'es' && 'Guía Oficial de Referencia para Cocina'}
        {lang === 'pt' && 'Guia Oficial de Referência Culinária'}
        {lang === 'zh-cn' && '官方厨房塑料安全速查总表'}
        {lang === 'ja' && '公式キッチンリファレンスガイド'}
      </span>
      <h3 class="text-xl font-bold text-ink tracking-tight">
        {t.tableTitle}
      </h3>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs border-collapse">
        <thead>
          <tr class="border-b border-hairline bg-surface text-ink font-semibold">
            <th class="py-3 px-3">{t.tableHeaders.code}</th>
            <th class="py-3 px-3">{t.tableHeaders.name}</th>
            <th class="py-3 px-3">{t.tableHeaders.safeTemp}</th>
            <th class="py-3 px-3">{t.tableHeaders.microwave}</th>
            <th class="py-3 px-3">{t.tableHeaders.dishwasher}</th>
            <th class="py-3 px-3">{t.tableHeaders.freezer}</th>
            <th class="py-3 px-3">{t.tableHeaders.healthRisk}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline text-body">
          {profiles.map((p) => {
            const mwSafe = p.verdicts.microwave === 'safe';
            const mwCaution = p.verdicts.microwave === 'caution';
            const dwSafe = p.verdicts.dishwasherTop === 'safe';
            const fzSafe = p.verdicts.freezer === 'safe';

            return (
              <tr class="hover:bg-surface/50 transition-colors">
                <td class="py-3 px-3 font-mono font-bold text-ink whitespace-nowrap">
                  {p.code}
                </td>
                <td class="py-3 px-3 font-medium text-ink">
                  <div>{p.shortName}</div>
                  <div class="text-[10px] text-muted">{p.chemicalName}</div>
                </td>
                <td class="py-3 px-3 whitespace-nowrap font-mono text-ink">
                  <span class="pcc-table-temp-f">{p.maxSafeTempF}°F</span>
                  <span class="pcc-table-temp-c hidden">{p.maxSafeTempC}°C</span>
                </td>
                <td class="py-3 px-3 whitespace-nowrap">
                  <span class={`inline-block px-2 py-0.5 rounded text-[10px] font-bold ${
                    mwSafe ? 'bg-emerald-100 text-emerald-900 dark:bg-emerald-950 dark:text-emerald-300' :
                    mwCaution ? 'bg-amber-100 text-amber-900 dark:bg-amber-950 dark:text-amber-300' :
                    'bg-rose-100 text-rose-900 dark:bg-rose-950 dark:text-rose-300'
                  }`}>
                    {mwSafe ? 'SAFE' : mwCaution ? 'CAUTION' : 'UNSAFE'}
                  </span>
                </td>
                <td class="py-3 px-3 whitespace-nowrap">
                  <span class={`inline-block px-2 py-0.5 rounded text-[10px] font-bold ${
                    dwSafe ? 'bg-emerald-100 text-emerald-900 dark:bg-emerald-950 dark:text-emerald-300' :
                    'bg-rose-100 text-rose-900 dark:bg-rose-950 dark:text-rose-300'
                  }`}>
                    {dwSafe ? 'TOP RACK' : 'UNSAFE'}
                  </span>
                </td>
                <td class="py-3 px-3 whitespace-nowrap">
                  <span class={`inline-block px-2 py-0.5 rounded text-[10px] font-bold ${
                    fzSafe ? 'bg-emerald-100 text-emerald-900 dark:bg-emerald-950 dark:text-emerald-300' :
                    'bg-amber-100 text-amber-900 dark:bg-amber-950 dark:text-amber-300'
                  }`}>
                    {fzSafe ? 'SAFE' : 'BRITTLE'}
                  </span>
                </td>
                <td class="py-3 px-3 text-[11px] text-muted max-w-xs">
                  {p.leachingCompounds.slice(0, 2).join(', ')}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>
</div>

<!-- Embedded JSON Data for Client Interaction -->
<script type="application/json" id="pcc-raw-data" set:html={JSON.stringify(profiles)}></script>

<script is:inline>
  (function () {
    const rawDataEl = document.getElementById('pcc-raw-data');
    if (!rawDataEl) return;

    let profiles = [];
    try {
      profiles = JSON.parse(rawDataEl.textContent || '[]');
    } catch (e) {
      console.error('Failed to parse plastic code data', e);
      return;
    }

    const app = document.querySelector('.plastic-code-checker-app');
    const lang = app?.getAttribute('data-lang') || 'en';

    let currentUnit = 'f'; // 'f' or 'c'
    let currentFilter = 'all';
    let searchQuery = '';
    let selectedId = 'pp-5'; // Default to #5 PP, kitchen gold standard

    // Elements
    const searchInput = document.getElementById('pcc-search-input');
    const clearBtn = document.getElementById('pcc-clear-btn');
    const matchCountEl = document.getElementById('pcc-match-count');
    const emptyState = document.getElementById('pcc-empty-state');
    const resetEmptyBtn = document.getElementById('pcc-reset-empty-btn');
    const resinCards = document.querySelectorAll('.pcc-resin-card');
    const filterBtns = document.querySelectorAll('.pcc-filter-btn');
    const presetChips = document.querySelectorAll('.pcc-preset-chip');
    const unitFBtn = document.getElementById('pcc-unit-f');
    const unitCBtn = document.getElementById('pcc-unit-c');

    // Detail Elements
    const detailNumber = document.getElementById('pcc-detail-number');
    const detailTierBadge = document.getElementById('pcc-detail-tier-badge');
    const detailBpaBadge = document.getElementById('pcc-detail-bpa-badge');
    const detailTitle = document.getElementById('pcc-detail-title');
    const detailChemical = document.getElementById('pcc-detail-chemical');
    const detailTemp = document.getElementById('pcc-detail-temp');
    const detailTempSub = document.getElementById('pcc-detail-temp-sub');
    const detailRiskBadge = document.getElementById('pcc-detail-risk-badge');
    const detailExplanation = document.getElementById('pcc-detail-explanation');
    const detailCompounds = document.getElementById('pcc-detail-compounds');
    const detailExamples = document.getElementById('pcc-detail-examples');
    const detailSwap = document.getElementById('pcc-detail-swap');
    const copyBtn = document.getElementById('pcc-copy-btn');
    const copyBtnText = document.getElementById('pcc-copy-btn-text');

    const scenarioKeys = ['microwave', 'dishwasherTop', 'dishwasherBottom', 'freezer', 'boilingLiquid', 'reuse'];

    function getSelectedProfile() {
      return profiles.find(p => p.id === selectedId) || profiles[4] || profiles[0];
    }

    function renderDetail(p) {
      if (!p) return;

      // Triangle Number & Title
      if (detailNumber) detailNumber.textContent = p.triangleNumber;
      if (detailTitle) detailTitle.textContent = p.code + ' ' + p.shortName;
      if (detailChemical) detailChemical.textContent = p.chemicalName;

      // Tier Badge
      if (detailTierBadge) {
        detailTierBadge.className = 'px-2.5 py-0.5 rounded-full text-xs font-bold border ';
        if (p.quickSafetyTier === 'safe') {
          detailTierBadge.className += 'bg-emerald-100 text-emerald-900 border-emerald-300 dark:bg-emerald-950/60 dark:text-emerald-300 dark:border-emerald-800';
          detailTierBadge.textContent = lang === 'en' ? 'Food Grade Safe' : lang === 'es' ? 'Seguro para Alimentos' : lang === 'pt' ? 'Seguro para Alimentos' : lang === 'zh-cn' ? '食品级安全' : '食品用安心素材';
        } else if (p.quickSafetyTier === 'caution') {
          detailTierBadge.className += 'bg-amber-100 text-amber-900 border-amber-300 dark:bg-amber-950/60 dark:text-amber-300 dark:border-amber-800';
          detailTierBadge.textContent = lang === 'en' ? 'Use With Caution' : lang === 'es' ? 'Usar con Precaución' : lang === 'pt' ? 'Cuidado ao Aquecer' : lang === 'zh-cn' ? '需谨慎使用' : '加熱時要注意';
        } else {
          detailTierBadge.className += 'bg-rose-100 text-rose-900 border-rose-300 dark:bg-rose-950/60 dark:text-rose-300 dark:border-rose-800';
          detailTierBadge.textContent = lang === 'en' ? 'High Chemical Risk' : lang === 'es' ? 'Alto Riesgo Químico' : lang === 'pt' ? 'Alto Risco Químico' : lang === 'zh-cn' ? '高化学毒性风险' : '高化学溶出リスク';
        }
      }

      // BPA Badge
      if (detailBpaBadge) {
        if (p.bpaFree) {
          detailBpaBadge.className = 'px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-900 border border-emerald-300 dark:bg-emerald-950/60 dark:text-emerald-300 dark:border-emerald-800';
          detailBpaBadge.textContent = lang === 'en' ? 'BPA-Free Certified' : lang === 'es' ? 'Libre de BPA' : lang === 'pt' ? 'Livre de BPA' : lang === 'zh-cn' ? '不含双酚A (BPA)' : 'BPA完全フリー';
        } else {
          detailBpaBadge.className = 'px-2.5 py-0.5 rounded-full text-xs font-semibold bg-rose-100 text-rose-900 border border-rose-300 dark:bg-rose-950/60 dark:text-rose-300 dark:border-rose-800';
          detailBpaBadge.textContent = lang === 'en' ? 'Contains BPA' : lang === 'es' ? 'Contiene BPA' : lang === 'pt' ? 'Contém BPA' : lang === 'zh-cn' ? '含双酚A (BPA)' : 'BPA含有';
        }
      }

      // Max Safe Temp
      if (detailTemp && detailTempSub) {
        if (currentUnit === 'f') {
          detailTemp.textContent = p.maxSafeTempF + '°F';
          detailTempSub.textContent = '(' + p.maxSafeTempC + '°C) Max Heat';
        } else {
          detailTemp.textContent = p.maxSafeTempC + '°C';
          detailTempSub.textContent = '(' + p.maxSafeTempF + '°F) Max Heat';
        }
      }

      // Scenarios
      scenarioKeys.forEach(k => {
        const badgeEl = document.getElementById('pcc-scenario-badge-' + k);
        const textEl = document.getElementById('pcc-scenario-text-' + k);
        const verdict = p.verdicts[k];

        if (badgeEl) {
          badgeEl.className = 'px-2 py-0.5 rounded-md text-[10px] font-black uppercase tracking-wider ';
          if (verdict === 'safe') {
            badgeEl.className += 'bg-emerald-100 text-emerald-900 border border-emerald-300 dark:bg-emerald-950/60 dark:text-emerald-300 dark:border-emerald-800';
            badgeEl.textContent = 'SAFE ✅';
          } else if (verdict === 'caution') {
            badgeEl.className += 'bg-amber-100 text-amber-900 border border-amber-300 dark:bg-amber-950/60 dark:text-amber-300 dark:border-amber-800';
            badgeEl.textContent = 'CAUTION ⚠️';
          } else {
            badgeEl.className += 'bg-rose-100 text-rose-900 border border-rose-300 dark:bg-rose-950/60 dark:text-rose-300 dark:border-rose-800';
            badgeEl.textContent = 'UNSAFE ❌';
          }
        }

        if (textEl && p.scenarioGuidance && p.scenarioGuidance[k]) {
          textEl.textContent = p.scenarioGuidance[k];
        }
      });

      // Leaching Risk Badge
      if (detailRiskBadge) {
        detailRiskBadge.className = 'px-2 py-0.5 rounded-md text-[10px] font-bold border ';
        if (p.leachingRiskLevel === 'low') {
          detailRiskBadge.className += 'bg-emerald-100 text-emerald-900 border-emerald-300 dark:bg-emerald-950/60 dark:text-emerald-300 dark:border-emerald-800';
          detailRiskBadge.textContent = lang === 'en' ? 'Low Migration Risk' : lang === 'es' ? 'Bajo Riesgo de Migración' : lang === 'pt' ? 'Baixo Risco de Migração' : lang === 'zh-cn' ? '极低化学迁移风险' : '溶出リスク極めて低';
        } else if (p.leachingRiskLevel === 'moderate') {
          detailRiskBadge.className += 'bg-amber-100 text-amber-900 border-amber-300 dark:bg-amber-950/60 dark:text-amber-300 dark:border-amber-800';
          detailRiskBadge.textContent = lang === 'en' ? 'Moderate Risk' : lang === 'es' ? 'Riesgo Moderado' : lang === 'pt' ? 'Risco Moderado' : lang === 'zh-cn' ? '中度析出风险' : '中度の溶出リスク';
        } else {
          detailRiskBadge.className += 'bg-rose-100 text-rose-900 border-rose-300 dark:bg-rose-950/60 dark:text-rose-300 dark:border-rose-800';
          detailRiskBadge.textContent = lang === 'en' ? 'High Toxic Leaching Risk' : lang === 'es' ? 'Alto Riesgo Químico' : lang === 'pt' ? 'Alto Risco Químico' : lang === 'zh-cn' ? '高毒性溶出风险' : '高化学溶出リスク';
        }
      }

      // Explanation
      if (detailExplanation) detailExplanation.textContent = p.explanation;

      // Compounds
      if (detailCompounds) {
        detailCompounds.innerHTML = '';
        (p.leachingCompounds || []).forEach(comp => {
          const span = document.createElement('span');
          span.className = 'px-2 py-1 rounded-md text-[11px] bg-surface text-ink border border-hairline/60 font-mono';
          span.textContent = comp;
          detailCompounds.appendChild(span);
        });
      }

      // Common Examples
      if (detailExamples) {
        detailExamples.innerHTML = '';
        (p.commonExamples || []).forEach(ex => {
          const li = document.createElement('li');
          li.className = 'flex items-center gap-2';
          li.innerHTML = '<span class="text-indigo-600 dark:text-indigo-400 font-bold">•</span><span>' + ex + '</span>';
          detailExamples.appendChild(li);
        });
      }

      // Safer Swap
      if (detailSwap) detailSwap.textContent = p.saferSwap;

      // Highlight active card
      resinCards.forEach(c => {
        if (c.getAttribute('data-id') === p.id) {
          c.classList.add('ring-2', 'ring-indigo-600', 'border-indigo-600', 'bg-surface-strong');
        } else {
          c.classList.remove('ring-2', 'ring-indigo-600', 'border-indigo-600', 'bg-surface-strong');
        }
      });
    }

    function applyFilters() {
      const q = searchQuery.toLowerCase().trim();
      let matchCount = 0;

      resinCards.forEach(card => {
        const code = card.getAttribute('data-code')?.toLowerCase() || '';
        const shortName = card.getAttribute('data-shortname') || '';
        const chemical = card.getAttribute('data-chemical') || '';
        const examples = card.getAttribute('data-examples') || '';
        const tier = card.getAttribute('data-tier') || '';
        const mw = card.getAttribute('data-microwave') || '';
        const dw = card.getAttribute('data-dishwasher') || '';
        const bpafree = card.getAttribute('data-bpafree') === 'true';

        // Check query match
        const matchesQuery = !q ||
          code.includes(q) ||
          shortName.includes(q) ||
          chemical.includes(q) ||
          examples.includes(q);

        // Check category filter
        let matchesFilter = true;
        if (currentFilter === 'microwave') matchesFilter = (mw === 'safe');
        else if (currentFilter === 'dishwasher') matchesFilter = (dw === 'safe');
        else if (currentFilter === 'bpafree') matchesFilter = bpafree;
        else if (currentFilter === 'avoid-heat') matchesFilter = (tier === 'danger' || mw === 'unsafe');

        if (matchesQuery && matchesFilter) {
          card.classList.remove('hidden');
          matchCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      // Update count & empty state
      if (matchCountEl) {
        const tmpl = lang === 'en' ? 'Showing {count} of 9 plastic resins'
          : lang === 'es' ? 'Mostrando {count} de 9 resinas plásticas'
          : lang === 'pt' ? 'Exibindo {count} de 9 resinas plásticas'
          : lang === 'zh-cn' ? '显示 {count} / 9 种塑料树脂'
          : '9樹脂中 {count} 件を表示中';
        matchCountEl.textContent = tmpl.replace('{count}', String(matchCount));
      }

      if (emptyState) {
        if (matchCount === 0) emptyState.classList.remove('hidden');
        else emptyState.classList.add('hidden');
      }

      // If active selection is hidden, select the first visible
      const activeCard = document.querySelector('.pcc-resin-card[data-id="' + selectedId + '"]:not(.hidden)');
      if (!activeCard && matchCount > 0) {
        const firstVisible = document.querySelector('.pcc-resin-card:not(.hidden)');
        if (firstVisible) {
          selectedId = firstVisible.getAttribute('data-id') || selectedId;
          renderDetail(getSelectedProfile());
        }
      }
    }

    function updateTempUnits() {
      if (currentUnit === 'f') {
        unitFBtn?.classList.add('bg-ink', 'text-white');
        unitFBtn?.classList.remove('text-muted');
        unitCBtn?.classList.remove('bg-ink', 'text-white');
        unitCBtn?.classList.add('text-muted');
        document.querySelectorAll('.pcc-table-temp-f').forEach(el => el.classList.remove('hidden'));
        document.querySelectorAll('.pcc-table-temp-c').forEach(el => el.classList.add('hidden'));
      } else {
        unitCBtn?.classList.add('bg-ink', 'text-white');
        unitCBtn?.classList.remove('text-muted');
        unitFBtn?.classList.remove('bg-ink', 'text-white');
        unitFBtn?.classList.add('text-muted');
        document.querySelectorAll('.pcc-table-temp-f').forEach(el => el.classList.add('hidden'));
        document.querySelectorAll('.pcc-table-temp-c').forEach(el => el.classList.remove('hidden'));
      }
      renderDetail(getSelectedProfile());
    }

    // Event Listeners
    resinCards.forEach(card => {
      card.addEventListener('click', () => {
        const id = card.getAttribute('data-id');
        if (id) {
          selectedId = id;
          renderDetail(getSelectedProfile());
          // Smooth scroll to detail on mobile if needed
          if (window.innerWidth < 768) {
            document.getElementById('pcc-detail-card')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }
      });
    });

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const f = btn.getAttribute('data-filter') || 'all';
        currentFilter = f;
        filterBtns.forEach(b => {
          if (b === btn) {
            b.classList.add('bg-ink', 'text-white', 'border-ink', 'shadow-xs');
            b.classList.remove('bg-canvas', 'text-ink', 'border-hairline');
          } else {
            b.classList.remove('bg-ink', 'text-white', 'border-ink', 'shadow-xs');
            b.classList.add('bg-canvas', 'text-ink', 'border-hairline');
          }
        });
        applyFilters();
      });
    });

    presetChips.forEach(chip => {
      chip.addEventListener('click', () => {
        const q = chip.getAttribute('data-query') || '';
        if (searchInput) {
          searchInput.value = q;
          searchQuery = q;
          clearBtn?.classList.remove('hidden');
          applyFilters();
        }
      });
    });

    searchInput?.addEventListener('input', (e) => {
      searchQuery = e.target.value;
      if (searchQuery.trim().length > 0) {
        clearBtn?.classList.remove('hidden');
      } else {
        clearBtn?.classList.add('hidden');
      }
      applyFilters();
    });

    clearBtn?.addEventListener('click', () => {
      if (searchInput) {
        searchInput.value = '';
        searchQuery = '';
        clearBtn.classList.add('hidden');
        searchInput.focus();
        applyFilters();
      }
    });

    resetEmptyBtn?.addEventListener('click', () => {
      searchQuery = '';
      currentFilter = 'all';
      if (searchInput) {
        searchInput.value = '';
        clearBtn?.classList.add('hidden');
      }
      filterBtns.forEach((b, i) => {
        if (i === 0) {
          b.classList.add('bg-ink', 'text-white', 'border-ink');
          b.classList.remove('bg-canvas', 'text-ink', 'border-hairline');
        } else {
          b.classList.remove('bg-ink', 'text-white', 'border-ink');
          b.classList.add('bg-canvas', 'text-ink', 'border-hairline');
        }
      });
      applyFilters();
    });

    unitFBtn?.addEventListener('click', () => {
      currentUnit = 'f';
      updateTempUnits();
    });

    unitCBtn?.addEventListener('click', () => {
      currentUnit = 'c';
      updateTempUnits();
    });

    // Copy to clipboard
    copyBtn?.addEventListener('click', () => {
      const p = getSelectedProfile();
      if (!p) return;

      const tempStr = currentUnit === 'f' ? p.maxSafeTempF + '°F' : p.maxSafeTempC + '°C';
      const textToCopy = [
        'IsItKitchenSafe Resin Check: ' + p.code + ' ' + p.shortName,
        'Chemical: ' + p.chemicalName,
        'Max Safe Temp: ' + tempStr,
        'BPA-Free: ' + (p.bpaFree ? 'Yes' : 'No'),
        'Microwave: ' + p.verdicts.microwave.toUpperCase(),
        'Dishwasher (Top Rack): ' + p.verdicts.dishwasherTop.toUpperCase(),
        'Freezer: ' + p.verdicts.freezer.toUpperCase(),
        'Key Risk: ' + (p.leachingCompounds || []).join(', '),
        'Recommendation: ' + p.saferSwap,
        'Source: https://isitkitchensafe.com/tools/plastic-code-checker/'
      ].join('\n');

      navigator.clipboard.writeText(textToCopy).then(() => {
        if (copyBtnText) {
          const original = copyBtnText.textContent;
          copyBtnText.textContent = lang === 'en' ? 'Copied to Clipboard! ✅'
            : lang === 'es' ? '¡Copiado! ✅'
            : lang === 'pt' ? 'Copiado! ✅'
            : lang === 'zh-cn' ? '已复制！✅'
            : 'コピー完了！✅';
          setTimeout(() => {
            copyBtnText.textContent = original;
          }, 2500);
        }
      }).catch(err => {
        console.error('Failed to copy', err);
      });
    });

    // Initial render
    renderDetail(getSelectedProfile());
  })();
</script>
