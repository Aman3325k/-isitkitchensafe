---
import rawData from '../data/plastic-code-checker-data.json';
import type { SupportedLanguage } from '../i18n/ui';
import { useTranslatedPath, getApplianceUrl } from '../i18n/utils';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;
const translatePath = useTranslatedPath(lang);

export interface LocalizedPlasticProfile {
  id: string;
  code: string;
  triangleNumber: string;
  subLabel: string;
  isCodeSevenSubtype: boolean;
  shortName: string;
  chemicalName: string;
  maxSafeTempF: number;
  maxSafeTempC: number;
  bpaFree: boolean;
  leachingRiskLevel: 'low' | 'moderate' | 'high' | 'very-high';
  quickSafetyTier: 'safe' | 'caution' | 'danger';
  leachingCompounds: string[];
  verdicts: {
    microwave: 'safe' | 'caution' | 'unsafe';
    dishwasherTop: 'safe' | 'caution' | 'unsafe';
    dishwasherBottom: 'safe' | 'caution' | 'unsafe';
    freezer: 'safe' | 'caution' | 'unsafe';
    boilingLiquid: 'safe' | 'caution' | 'unsafe';
    reuse: 'safe' | 'caution' | 'unsafe';
  };
  commonExamples: string[];
  saferSwap: string;
  explanation: string;
  scenarioGuidance: {
    microwave: string;
    dishwasherTop: string;
    dishwasherBottom: string;
    freezer: string;
    boilingLiquid: string;
    reuse: string;
  };
}

const profiles: LocalizedPlasticProfile[] = rawData.profiles.map((p) => {
  const tr = lang === 'en' ? null : ((p.translations as Record<string, any>)?.[lang] || null);
  return {
    id: p.id,
    code: p.code,
    triangleNumber: p.triangleNumber,
    subLabel: p.subLabel,
    isCodeSevenSubtype: p.isCodeSevenSubtype,
    shortName: tr?.shortName || p.shortName,
    chemicalName: tr?.chemicalName || p.chemicalName,
    maxSafeTempF: p.maxSafeTempF,
    maxSafeTempC: p.maxSafeTempC,
    bpaFree: p.bpaFree,
    leachingRiskLevel: p.leachingRiskLevel as any,
    quickSafetyTier: p.quickSafetyTier as any,
    leachingCompounds: tr?.leachingCompounds || p.leachingCompounds,
    verdicts: p.verdicts as any,
    commonExamples: tr?.commonExamples || p.commonExamples,
    saferSwap: tr?.saferSwap || p.saferSwap,
    explanation: tr?.explanation || p.explanation,
    scenarioGuidance: {
      microwave: tr?.scenarioGuidance?.microwave || p.scenarioGuidance.microwave,
      dishwasherTop: tr?.scenarioGuidance?.dishwasherTop || p.scenarioGuidance.dishwasherTop,
      dishwasherBottom: tr?.scenarioGuidance?.dishwasherBottom || p.scenarioGuidance.dishwasherBottom,
      freezer: tr?.scenarioGuidance?.freezer || p.scenarioGuidance.freezer,
      boilingLiquid: tr?.scenarioGuidance?.boilingLiquid || p.scenarioGuidance.boilingLiquid,
      reuse: tr?.scenarioGuidance?.reuse || p.scenarioGuidance.reuse
    }
  };
});

