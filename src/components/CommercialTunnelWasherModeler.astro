  <!-- Copy Report Action -->
  <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-4 border-t border-hairline">
    <div class="text-xs text-muted">
      Calculations grounded in ASTM G48 pitting tests, FKM/EPDM immersion databases, and OSHA Hazard Communication 29 CFR § 1910.1200.
    </div>
    <button 
      type="button" 
      id="btn-copy-report" 
      class="w-full sm:w-auto px-5 py-2.5 rounded-xl bg-teal-600 hover:bg-teal-700 text-white text-xs font-bold transition-all shadow-xs flex items-center justify-center gap-2 cursor-pointer"
    >
      <span>📋</span>
      <span id="txt-copy-report">{d.copyReportBtn}</span>
