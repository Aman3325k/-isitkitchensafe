    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="bg-surface border border-hairline rounded-xl p-4">
        <h4 class="text-xs font-bold text-teal-800 mb-1.5">{d.rule1Title}</h4>
        <p class="text-xs text-body leading-relaxed">{d.rule1Text}</p>
