const d = DICTIONARY[lang];
---

<div class="not-prose my-8 bg-surface border border-hairline rounded-3xl p-6 sm:p-8 shadow-sm">
  <!-- Header -->
  <div class="border-b border-hairline/80 pb-6 mb-6">
    <div class="flex flex-wrap items-center justify-between gap-3 mb-2">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-teal-600 text-white">
        {d.badge}
      </span>
      <span class="text-xs text-muted font-mono">
        FDA 21 CFR § 173.315 • OSHA 0.4 ppm STEL • NSF/ANSI 3
      </span>
    </div>
    <h2 class="text-title-xl sm:text-headline-sm font-bold text-ink tracking-tight mb-2">
      {d.title}
    </h2>
    <p class="text-body-md text-muted leading-relaxed max-w-4xl">
      {d.subtitle}
    </p>
  </div>

  <!-- Operational Presets -->
  <div class="mb-8">
    <h3 class="text-sm font-semibold uppercase tracking-wider text-muted mb-3">
      {d.presetsTitle}
    </h3>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5">
      <button 
        type="button" 
        id="btn-preset-optimal"
        class="text-left px-3.5 py-2.5 rounded-xl border border-teal-200 bg-teal-50/70 hover:bg-teal-100/70 text-teal-900 transition-colors text-xs font-medium cursor-pointer"
      >
        <div class="font-bold mb-0.5 text-teal-950">✅ Optimal Sanitary</div>
        <div class="text-[11px] text-teal-800 leading-tight">{d.presetOptimal}</div>
      </button>

      <button 
        type="button" 
        id="btn-preset-pitting"
        class="text-left px-3.5 py-2.5 rounded-xl border border-amber-200 bg-amber-50/70 hover:bg-amber-100/70 text-amber-900 transition-colors text-xs font-medium cursor-pointer"
      >
        <div class="font-bold mb-0.5 text-amber-950">⚠️ Rapid 304 Pitting</div>
        <div class="text-[11px] text-amber-800 leading-tight">{d.presetPitting}</div>
      </button>

      <button 
        type="button" 
        id="btn-preset-gasket"
        class="text-left px-3.5 py-2.5 rounded-xl border border-rose-200 bg-rose-50/70 hover:bg-rose-100/70 text-rose-900 transition-colors text-xs font-medium cursor-pointer"
      >
        <div class="font-bold mb-0.5 text-rose-950">🚨 Nitrile Blowout</div>
        <div class="text-[11px] text-rose-800 leading-tight">{d.presetGasketBlowout}</div>
      </button>

      <button 
        type="button" 
        id="btn-preset-vapor"
        class="text-left px-3.5 py-2.5 rounded-xl border border-purple-200 bg-purple-50/70 hover:bg-purple-100/70 text-purple-900 transition-colors text-xs font-medium cursor-pointer"
      >
        <div class="font-bold mb-0.5 text-purple-950">☣️ Toxic Vapor Hazard</div>
        <div class="text-[11px] text-purple-800 leading-tight">{d.presetVaporHazard}</div>
      </button>
    </div>
  </div>

  <!-- Main Controls Grid -->
  <div class="bg-surface-soft border border-hairline rounded-2xl p-5 sm:p-6 mb-8">
    <div class="border-b border-hairline pb-4 mb-5">
      <h3 class="text-base font-bold text-ink">
        {d.controlsTitle}
      </h3>
      <p class="text-xs text-muted mt-1">
        {d.controlsSub}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- 1. Washer Configuration -->
      <div class="lg:col-span-1">
        <label for="select-washer" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-2">
          {d.washerLabel}
        </label>
        <select 
          id="select-washer" 
          class="w-full bg-surface border border-hairline rounded-xl px-3 py-2 text-xs text-ink font-medium focus:ring-2 focus:ring-teal-500 focus:outline-none"
        >
          {washerData.washerConfigurations.map(cfg => (
            <option value={cfg.id} selected={cfg.id === 'multi_stage_batch_tunnel_316l'}>
              {cfg.name}
            </option>
          ))}
        </select>
        <p class="text-[11px] text-muted mt-1.5 leading-normal">
          {d.washerHelp}
        </p>
      </div>

      <!-- 2. Metallurgy Grade -->
      <div>
