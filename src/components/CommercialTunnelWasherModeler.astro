<script is:inline define:vars={{ washerData, lang }}>
  // Client-Side Calculation Engine
  const selectWasher = document.getElementById('select-washer');
  const selectMetallurgy = document.getElementById('select-metallurgy');
  const selectElastomer = document.getElementById('select-elastomer');

  const sliderPaa = document.getElementById('slider-paa');
  const sliderTemp = document.getElementById('slider-temp');
  const sliderPh = document.getElementById('slider-ph');
  const sliderChloride = document.getElementById('slider-chloride');
  const sliderAirflow = document.getElementById('slider-airflow');
  const sliderHours = document.getElementById('slider-hours');

  const valPaa = document.getElementById('val-paa');
  const valTemp = document.getElementById('val-temp');
  const valPh = document.getElementById('val-ph');
  const valChloride = document.getElementById('val-chloride');
  const valAirflow = document.getElementById('val-airflow');
  const valHours = document.getElementById('val-hours');

  const statCorrosionRate = document.getElementById('stat-corrosion-rate');
  const subCorrosionRate = document.getElementById('sub-corrosion-rate');
  const barCorrosionRate = document.getElementById('bar-corrosion-rate');

  const statPassivation = document.getElementById('stat-passivation');
  const subPassivation = document.getElementById('sub-passivation');
  const barPassivation = document.getElementById('bar-passivation');

  const statGasketSwell = document.getElementById('stat-gasket-swell');
  const subGasketSwell = document.getElementById('sub-gasket-swell');
  const barGasketSwell = document.getElementById('bar-gasket-swell');

  const statAirbornePaa = document.getElementById('stat-airborne-paa');
  const subAirbornePaa = document.getElementById('sub-airborne-paa');
  const barAirbornePaa = document.getElementById('bar-airborne-paa');

  const statPathogenKill = document.getElementById('stat-pathogen-kill');
  const subPathogenKill = document.getElementById('sub-pathogen-kill');
  const barPathogenKill = document.getElementById('bar-pathogen-kill');

  const statLifespan = document.getElementById('stat-lifespan');
  const subLifespan = document.getElementById('sub-lifespan');
  const barLifespan = document.getElementById('bar-lifespan');

  const statOsha = document.getElementById('stat-osha');
  const subOsha = document.getElementById('sub-osha');
  const barOsha = document.getElementById('bar-osha');

  const statRisk = document.getElementById('stat-risk');
  const subRisk = document.getElementById('sub-risk');
  const barRisk = document.getElementById('bar-risk');

  const analysisMechanisms = document.getElementById('analysis-mechanisms');
  const analysisMitigation = document.getElementById('analysis-mitigation');

  const btnCopyReport = document.getElementById('btn-copy-report');
  const txtCopyReport = document.getElementById('txt-copy-report');

  function calculate() {
    const washerId = selectWasher.value;
    const metallurgyId = selectMetallurgy.value;
    const elastomerId = selectElastomer.value;

    const paaPpm = parseFloat(sliderPaa.value);
    const tempC = parseFloat(sliderTemp.value);
    const tempF = (tempC * 9/5) + 32;
    const ph = parseFloat(sliderPh.value);
    const chloridePpm = parseFloat(sliderChloride.value);
    const airflowCfm = parseFloat(sliderAirflow.value);
    const hoursPerDay = parseFloat(sliderHours.value);

    // Update Slider Displays
    valPaa.textContent = `${paaPpm} ppm`;
    valTemp.textContent = `${tempC}°C (${tempF.toFixed(0)}°F)`;
    valPh.textContent = `pH ${ph.toFixed(2)}`;
    valChloride.textContent = `${chloridePpm} mg/L [Cl⁻]`;
    valAirflow.textContent = `${airflowCfm.toLocaleString()} CFM`;
    valHours.textContent = `${hoursPerDay} hrs/day`;

    // Lookups
    const metallurgy = washerData.metallurgyGrades.find(m => m.id === metallurgyId) || washerData.metallurgyGrades[0];
    const elastomer = washerData.elastomerTypes.find(e => e.id === elastomerId) || washerData.elastomerTypes[0];
    const washer = washerData.washerConfigurations.find(w => w.id === washerId) || washerData.washerConfigurations[0];

    // 1. Corrosion Rate & Passivation Stability Calculations
    const tempFactor = Math.exp(0.045 * (tempC - 25.0));
    const acidFactor = ph < 4.5 ? Math.pow(4.8 / ph, 1.8) : 1.0;
    const pren = metallurgy.prenScore;
    const chlorideSynergy = 1.0 + (Math.pow(chloridePpm / 50.0, 1.3) * Math.pow(25.0 / Math.max(14.0, pren), 2.0));
    const paaFactor = Math.pow(paaPpm / 150.0, 0.9);
    const dutyCycleFactor = hoursPerDay / 24.0;

    const baseCr = 0.012 * metallurgy.corrosionRateFactor;
    const annualCorrosionMm = baseCr * tempFactor * acidFactor * chlorideSynergy * paaFactor * dutyCycleFactor;
    
    // Lifespan estimation (assuming 3.0 mm standard piping/drum wall, critical failure at 1.5 mm loss)
    const yearsToPerforation = annualCorrosionMm > 0 ? (1.5 / annualCorrosionMm) : 99.0;

    // 2. Elastomer Degradation & Swell
    const elastomerTempFactor = 1.0 + (0.02 * (tempC - 25.0));
    const calculatedSwell = elastomer.swellingCoefficientPercent * elastomerTempFactor * Math.pow(paaPpm / 180.0, 0.85);
    const calculatedHardnessDelta = elastomer.hardnessDeltaShoreA * Math.pow(paaPpm / 180.0, 0.7) * (tempC / 45.0);

    // 3. Headspace Airborne PAA Vapor (ppm)
    // Equilibrium vapor pressure of PAA increases steeply above 45°C
    const vaporGenRate = (paaPpm / 200.0) * Math.exp(0.052 * (tempC - 25.0)) * (washer.waterFlowRateLpm / 200.0);
    const airbornePaaPpm = (vaporGenRate * 180.0) / Math.max(100.0, airflowCfm);

    // 4. Pathogen Log Reduction
    const contactTime = washer.sanitizingZoneContactTimeSec || 30.0;
    const listeriaKill = Math.min(7.0, (paaPpm / 35.0) * Math.pow(contactTime / 20.0, 0.75) * Math.pow(tempC / 45.0, 0.3));
    const sporeKill = Math.min(5.5, Math.pow(paaPpm / 140.0, 1.2) * (contactTime / 30.0) * Math.pow(tempC / 50.0, 0.7));

    // Update DOM: 1. Corrosion Rate
    statCorrosionRate.textContent = `${annualCorrosionMm.toFixed(3)} mm/yr`;
    if (annualCorrosionMm < 0.05) {
      statCorrosionRate.className = "text-xl sm:text-2xl font-bold font-mono text-teal-600";
      subCorrosionRate.textContent = "Minimal Pitting & High Resistance";
      barCorrosionRate.className = "bg-teal-500 h-full rounded-full transition-all duration-300";
      barCorrosionRate.style.width = "18%";
    } else if (annualCorrosionMm < 0.15) {
      statCorrosionRate.className = "text-xl sm:text-2xl font-bold font-mono text-amber-600";
      subCorrosionRate.textContent = "Moderate Micro-Pitting in Welds";
      barCorrosionRate.className = "bg-amber-500 h-full rounded-full transition-all duration-300";
      barCorrosionRate.style.width = "48%";
    } else {
      statCorrosionRate.className = "text-xl sm:text-2xl font-bold font-mono text-rose-600";
      subCorrosionRate.textContent = "Severe Crevice & Weld Perforation";
      barCorrosionRate.className = "bg-rose-500 h-full rounded-full transition-all duration-300";
      barCorrosionRate.style.width = "92%";
    }

    // Update DOM: 2. Passivation Stability
    if (pren >= 30.0) {
      statPassivation.textContent = "Exceptional Passive Film";
      statPassivation.className = "text-base sm:text-lg font-bold font-mono text-emerald-600";
      subPassivation.textContent = `PREN ${pren.toFixed(1)} • Immune to Pitting`;
      barPassivation.className = "bg-emerald-500 h-full rounded-full transition-all duration-300";
      barPassivation.style.width = "95%";
    } else if (pren >= 23.0 && chloridePpm <= 120 && tempC <= 58) {
      statPassivation.textContent = "Stable Cr₂O₃ Layer";
      statPassivation.className = "text-base sm:text-lg font-bold font-mono text-teal-600";
      subPassivation.textContent = `PREN ${pren.toFixed(1)} • Low-Carbon Protected`;
      barPassivation.className = "bg-teal-500 h-full rounded-full transition-all duration-300";
      barPassivation.style.width = "82%";
    } else if (pren < 20.0 && (chloridePpm > 80 || tempC > 52 || paaPpm > 250)) {
      statPassivation.textContent = "Passivation Breakdown";
      statPassivation.className = "text-base sm:text-lg font-bold font-mono text-rose-600";
      subPassivation.textContent = `PREN ${pren.toFixed(1)} • Severe Cl⁻ Attack`;
      barPassivation.className = "bg-rose-500 h-full rounded-full transition-all duration-300";
      barPassivation.style.width = "22%";
    } else {
      statPassivation.textContent = "Marginal Stability";
      statPassivation.className = "text-base sm:text-lg font-bold font-mono text-amber-600";
      subPassivation.textContent = `PREN ${pren.toFixed(1)} • Watch HAZ Welds`;
      barPassivation.className = "bg-amber-500 h-full rounded-full transition-all duration-300";
      barPassivation.style.width = "50%";
    }

    // Update DOM: 3. Elastomer Swell & Hardness
    statGasketSwell.textContent = `+${calculatedSwell.toFixed(1)}% Swell`;
    if (calculatedSwell <= 4.0 && Math.abs(calculatedHardnessDelta) <= 5) {
      statGasketSwell.className = "text-xl sm:text-2xl font-bold font-mono text-teal-600";
      subGasketSwell.textContent = `${calculatedHardnessDelta > 0 ? '+' : ''}${calculatedHardnessDelta.toFixed(0)} Shore A • Grade A Elastomer`;
      barGasketSwell.className = "bg-teal-500 h-full rounded-full transition-all duration-300";
      barGasketSwell.style.width = "15%";
    } else if (calculatedSwell <= 12.0 && Math.abs(calculatedHardnessDelta) <= 12) {
      statGasketSwell.className = "text-xl sm:text-2xl font-bold font-mono text-amber-600";
      subGasketSwell.textContent = `${calculatedHardnessDelta > 0 ? '+' : ''}${calculatedHardnessDelta.toFixed(0)} Shore A • Moderate Creep`;
      barGasketSwell.className = "bg-amber-500 h-full rounded-full transition-all duration-300";
      barGasketSwell.style.width = "55%";
    } else {
      statGasketSwell.className = "text-xl sm:text-2xl font-bold font-mono text-rose-600";
      subGasketSwell.textContent = `${calculatedHardnessDelta > 0 ? '+' : ''}${calculatedHardnessDelta.toFixed(0)} Shore A • Gasket Rupture Risk`;
      barGasketSwell.className = "bg-rose-500 h-full rounded-full transition-all duration-300";
      barGasketSwell.style.width = "92%";
    }

    // Update DOM: 4. Airborne PAA Vapor
    statAirbornePaa.textContent = `${airbornePaaPpm.toFixed(2)} ppm`;
    if (airbornePaaPpm <= 0.15) {
      statAirbornePaa.className = "text-xl sm:text-2xl font-bold font-mono text-emerald-600";
      subAirbornePaa.textContent = "OSHA STEL < 0.40 ppm [PASS]";
      barAirbornePaa.className = "bg-emerald-500 h-full rounded-full transition-all duration-300";
      barAirbornePaa.style.width = "22%";
    } else if (airbornePaaPpm <= 0.40) {
      statAirbornePaa.className = "text-xl sm:text-2xl font-bold font-mono text-teal-600";
      subAirbornePaa.textContent = "Within 0.40 ppm STEL Ceiling";
      barAirbornePaa.className = "bg-teal-500 h-full rounded-full transition-all duration-300";
      barAirbornePaa.style.width = "65%";
    } else if (airbornePaaPpm <= 0.90) {
      statAirbornePaa.className = "text-xl sm:text-2xl font-bold font-mono text-amber-600";
      subAirbornePaa.textContent = "EXCEEDS OSHA STEL 0.4 ppm [IRRITANT]";
      barAirbornePaa.className = "bg-amber-500 h-full rounded-full transition-all duration-300";
      barAirbornePaa.style.width = "88%";
    } else {
      statAirbornePaa.className = "text-xl sm:text-2xl font-bold font-mono text-rose-600";
      subAirbornePaa.textContent = "SEVERE CHEMICAL FUMING [EVACUATE]";
      barAirbornePaa.className = "bg-rose-500 h-full rounded-full transition-all duration-300";
      barAirbornePaa.style.width = "100%";
    }

    // Update DOM: 5. Pathogen Kill
    statPathogenKill.textContent = listeriaKill >= 6.0 ? ">6.0 Log Kill" : `${listeriaKill.toFixed(1)} Log Kill`;
    subPathogenKill.textContent = `Listeria ${listeriaKill >= 5.0 ? '99.999%+' : 'Partial'} • Spores ${sporeKill.toFixed(1)} Log`;
    barPathogenKill.style.width = `${Math.min(100, (listeriaKill / 6.0) * 100)}%`;

    // Update DOM: 6. Lifespan
    if (yearsToPerforation >= 15.0) {
      statLifespan.textContent = `${yearsToPerforation.toFixed(1)} Years`;
      statLifespan.className = "text-xl sm:text-2xl font-bold font-mono text-indigo-600";
      subLifespan.textContent = "Long-Term Industrial Reliability";
      barLifespan.className = "bg-indigo-500 h-full rounded-full transition-all duration-300";
      barLifespan.style.width = "90%";
    } else if (yearsToPerforation >= 5.0) {
      statLifespan.textContent = `${yearsToPerforation.toFixed(1)} Years`;
      statLifespan.className = "text-xl sm:text-2xl font-bold font-mono text-amber-600";
      subLifespan.textContent = "Accelerated Wear • Annual Inspection";
      barLifespan.className = "bg-amber-500 h-full rounded-full transition-all duration-300";
      barLifespan.style.width = "45%";
    } else {
      statLifespan.textContent = `${yearsToPerforation.toFixed(1)} Years`;
      statLifespan.className = "text-xl sm:text-2xl font-bold font-mono text-rose-600";
      subLifespan.textContent = "CRITICAL: Perforation Failure Imminent";
      barLifespan.className = "bg-rose-500 h-full rounded-full transition-all duration-300";
      barLifespan.style.width = "15%";
    }

    // Update DOM: 7. OSHA / FDA Compliance
    const fdaPass = paaPpm <= 200.0;
    const oshaPass = airbornePaaPpm <= 0.40;
    if (fdaPass && oshaPass) {
      statOsha.textContent = "100% Compliant";
      statOsha.className = "text-base sm:text-lg font-bold font-mono text-emerald-600";
      subOsha.textContent = "FDA 21 CFR § 173.315 & OSHA STEL [PASS]";
      barOsha.className = "bg-emerald-500 h-full rounded-full transition-all duration-300";
      barOsha.style.width = "100%";
    } else if (!fdaPass && oshaPass) {
      statOsha.textContent = "FDA Limit Exceeded";
      statOsha.className = "text-base sm:text-lg font-bold font-mono text-amber-600";
      subOsha.textContent = "Requires Potable Rinse (>200 ppm Food Contact)";
      barOsha.className = "bg-amber-500 h-full rounded-full transition-all duration-300";
      barOsha.style.width = "60%";
    } else {
      statOsha.textContent = "OSHA Hazard Alert";
      statOsha.className = "text-base sm:text-lg font-bold font-mono text-rose-600";
      subOsha.textContent = "Vapor Exceeds 0.40 ppm STEL Ceiling";
      barOsha.className = "bg-rose-500 h-full rounded-full transition-all duration-300";
      barOsha.style.width = "25%";
    }

    // Update DOM: 8. Primary Failure Risk
    if (elastomerId === 'nbr_nitrile_rubber') {
      statRisk.textContent = "Gasket Embrittlement";
      statRisk.className = "text-base sm:text-lg font-bold font-mono text-rose-600";
      subRisk.textContent = "Nitrile NBR Attacked • Flange Blowout";
      barRisk.className = "bg-rose-500 h-full rounded-full transition-all duration-300";
      barRisk.style.width = "20%";
    } else if (airbornePaaPpm > 0.40) {
      statRisk.textContent = "Toxic Vapor Leakage";
      statRisk.className = "text-base sm:text-lg font-bold font-mono text-rose-600";
      subRisk.textContent = "Scrubber Insufficient • Evacuate Area";
      barRisk.className = "bg-rose-500 h-full rounded-full transition-all duration-300";
      barRisk.style.width = "25%";
    } else if (metallurgyId === 'ss_304_standard' && (chloridePpm > 120 || tempC > 58)) {
      statRisk.textContent = "304 Weld Crevice Pitting";
      statRisk.className = "text-base sm:text-lg font-bold font-mono text-amber-600";
      subRisk.textContent = "HAZ Rust Bloom & Micro-Fissures";
      barRisk.className = "bg-amber-500 h-full rounded-full transition-all duration-300";
      barRisk.style.width = "50%";
    } else {
      statRisk.textContent = "Low Operational Risk";
      statRisk.className = "text-base sm:text-lg font-bold font-mono text-emerald-600";
      subRisk.textContent = "Passivated Metallurgy & Seals Stable";
      barRisk.className = "bg-emerald-500 h-full rounded-full transition-all duration-300";
      barRisk.style.width = "95%";
    }

    // Update Analysis Insights
    if (elastomerId === 'nbr_nitrile_rubber') {
      analysisMechanisms.textContent = "CRITICAL ELASTOMER WARNING: Nitrile (NBR) rubber is chemically incompatible with peracetic acid. Peroxy free radicals break unsaturated polymer double bonds, driving rapid Shore A hardening (+22 points) and catastrophic manifold flange blowout within 3 to 6 weeks.";
      analysisMitigation.textContent = "IMMEDIATE ACTION: Shut down sanitizing injection and replace all NBR manifold gaskets with FKM (Viton®) or expanded PTFE. Never allow nitrile seals in continuous PAA wash loops.";
    } else if (airbornePaaPpm > 0.40) {
      analysisMechanisms.textContent = `ACUTE CHEMICAL VAPOR WARNING: Headspace PAA vapor concentration (${airbornePaaPpm.toFixed(2)} ppm) exceeds the OSHA and ACGIH 0.40 ppm STEL threshold. High wash water temperature (${tempC}°C) and low ventilation airflow (${airflowCfm} CFM) create extreme chemical fuming.`;
      analysisMitigation.textContent = "OPERATIONAL INTERLOCK: Increase mechanical exhaust airflow to ≥1,800 CFM immediately or reduce wash temperature below 50°C. Implement real-time electrochemical PAA ambient monitors in the dishroom.";
    } else if (metallurgyId === 'ss_304_standard' && chloridePpm > 100) {
      analysisMechanisms.textContent = `CREVICE PITTING WARNING: Standard AISI 304 lacks molybdenum (PREN ~18.0). High chloride concentration (${chloridePpm} mg/L) combined with warm peracetic acid attacks the passive chromium oxide film, causing localized pitting in weld heat-affected zones.`;
      analysisMitigation.textContent = "METALLURGY SAFEGUARD: Upgrade replacement spool pieces to AISI 316L (PREN 24.5) or 2205 Duplex. Treat incoming municipal supply with reverse osmosis to reduce chloride concentrations below 60 mg/L.";
    } else {
      analysisMechanisms.textContent = `BALANCED OPERATION: Operating with ${metallurgy.name.split(' (')[0]} and ${elastomer.name.split(' (')[0]} maintains excellent corrosion resistance (${annualCorrosionMm.toFixed(3)} mm/yr) and seal elasticity under ${paaPpm} ppm PAA at ${tempC}°C.`;
      analysisMitigation.textContent = `RECOMMENDED PROTOCOL: Maintain chemical dosage between 150 and 200 ppm PAA for no-rinse FDA compliance. Conduct annual ultrasonic thickness testing on weld seams and inspect FKM gaskets every 24 months.`;
    }
  }

  // Presets Listeners
  document.getElementById('btn-preset-optimal')?.addEventListener('click', () => {
    selectWasher.value = 'multi_stage_batch_tunnel_316l';
    selectMetallurgy.value = 'ss_316l_low_carbon';
    selectElastomer.value = 'fkm_fluoroelastomer';
    sliderPaa.value = 180;
    sliderTemp.value = 50;
    sliderPh.value = 4.4;
    sliderChloride.value = 45;
    sliderAirflow.value = 1800;
    sliderHours.value = 16;
    calculate();
  });

  document.getElementById('btn-preset-pitting')?.addEventListener('click', () => {
    selectWasher.value = 'standard_crate_conveyor_tunnel_304';
    selectMetallurgy.value = 'ss_304_standard';
    selectElastomer.value = 'epdm_peroxide_cured';
    sliderPaa.value = 320;
    sliderTemp.value = 62;
    sliderPh.value = 3.9;
    sliderChloride.value = 220;
    sliderAirflow.value = 650;
    sliderHours.value = 18;
    calculate();
  });

  document.getElementById('btn-preset-gasket')?.addEventListener('click', () => {
    selectWasher.value = 'retrofitted_legacy_tunnel_corroded';
    selectMetallurgy.value = 'ss_304_standard';
    selectElastomer.value = 'nbr_nitrile_rubber';
    sliderPaa.value = 280;
    sliderTemp.value = 58;
    sliderPh.value = 3.7;
    sliderChloride.value = 150;
    sliderAirflow.value = 450;
    sliderHours.value = 20;
    calculate();
  });

  document.getElementById('btn-preset-vapor')?.addEventListener('click', () => {
    selectWasher.value = 'multi_stage_batch_tunnel_316l';
    selectMetallurgy.value = 'ss_316l_low_carbon';
    selectElastomer.value = 'fkm_fluoroelastomer';
    sliderPaa.value = 480;
    sliderTemp.value = 68;
    sliderPh.value = 3.4;
    sliderChloride.value = 80;
    sliderAirflow.value = 200;
    sliderHours.value = 24;
    calculate();
  });

  // Event Listeners
  [selectWasher, selectMetallurgy, selectElastomer, sliderPaa, sliderTemp, sliderPh, sliderChloride, sliderAirflow, sliderHours].forEach(el => {
    el?.addEventListener('input', calculate);
    el?.addEventListener('change', calculate);
  });

  // Copy Report
  btnCopyReport?.addEventListener('click', () => {
    const report = `======================================================================
ISITKITCHENSAFE SANITARY CHEMICAL & TRIBOLOGY AUDIT REPORT
Continuous Batch Tunnel Washer Peracetic Acid Corrosion & Gasket Model
======================================================================
Generated: ${new Date().toISOString()}
System Architecture: ${selectWasher.options[selectWasher.selectedIndex].text}
Metallurgy Grade:    ${selectMetallurgy.options[selectMetallurgy.selectedIndex].text}
Elastomer Gasket:    ${selectElastomer.options[selectElastomer.selectedIndex].text}

OPERATING PARAMETERS:
- Active Peracetic Acid (PAA): ${sliderPaa.value} ppm
- Wash Water Temperature:      ${sliderTemp.value}°C (${((parseFloat(sliderTemp.value)*9/5)+32).toFixed(0)}°F)
- Solution pH:                pH ${parseFloat(sliderPh.value).toFixed(2)}
- Chloride Concentration:     ${sliderChloride.value} mg/L [Cl⁻]
- Scrubber Exhaust Airflow:   ${parseInt(sliderAirflow.value, 10).toLocaleString()} CFM
- Continuous Duty Cycle:       ${sliderHours.value} hrs/day

DIAGNOSTIC METRICS:
- Metal Pitting Corrosion:    ${statCorrosionRate.textContent} (${subCorrosionRate.textContent})
- Passivation Oxide Status:   ${statPassivation.textContent} (${subPassivation.textContent})
- Elastomer Gasket Swell:     ${statGasketSwell.textContent} (${subGasketSwell.textContent})
- Headspace PAA Vapor:        ${statAirbornePaa.textContent} (${subAirbornePaa.textContent})
- Microbial Sanitization:     ${statPathogenKill.textContent} (${subPathogenKill.textContent})
- Estimated Drum Lifespan:    ${statLifespan.textContent} (${subLifespan.textContent})
- Regulatory Compliance:      ${statOsha.textContent} (${subOsha.textContent})
- Primary Operational Risk:   ${statRisk.textContent} (${subRisk.textContent})

ANALYSIS & SAFEGUARDS:
${analysisMechanisms.textContent}
${analysisMitigation.textContent}

Standards Evaluated: FDA 21 CFR § 173.315 • OSHA 29 CFR § 1910.1200 • NSF/ANSI 3
Verified via IsItKitchenSafe Continuous Wash Tunnel Modeler.
======================================================================`;

    navigator.clipboard.writeText(report).then(() => {
      const originalText = txtCopyReport.textContent;
      txtCopyReport.textContent = "Report Copied to Clipboard!";
      btnCopyReport.classList.remove('bg-teal-600', 'hover:bg-teal-700');
      btnCopyReport.classList.add('bg-emerald-600', 'hover:bg-emerald-700');
      setTimeout(() => {
        txtCopyReport.textContent = originalText;
        btnCopyReport.classList.remove('bg-emerald-600', 'hover:bg-emerald-700');
        btnCopyReport.classList.add('bg-teal-600', 'hover:bg-teal-700');
      }, 2500);
    });
  });

  // Initial Calculation Run
  calculate();
</script>
