    <!-- Qualitative Insights Box -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
      <div class="bg-surface-soft border border-hairline rounded-2xl p-5">
        <div class="flex items-center gap-2 mb-2">
