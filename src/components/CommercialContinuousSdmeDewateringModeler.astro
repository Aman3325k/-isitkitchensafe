    systemHelp: "商用連続式 sDME 抽出スキッド、湿潤微細藻類脂質ハーベスター、乳清副産物高付加価値化装置、クリーンルーム研究用パイロット機から選択。",
    matrixLabel: "高水分原料スラリー＆バイオマス:",
    matrixHelp: "湿潤微細藻類ペースト（クロレラ Chlorella vulgaris）、乳清酸性遠心汚泥、ビール酵母スラリー、生おから繊維ペースト、油脂酵母発酵液から選択。",
    solventLabel: "亜臨界溶媒媒体＆共溶媒配合:",
    solventHelp: "純液化 sDME（0.65 MPa、25°C）、4.0 wt% バイオエタノール配合 sDME、sDME/scCO2 ハイブリッドブレンド、加熱前乾燥必須の危険なヘキサン法から選択。",
    compressorLabel: "完全密閉溶媒蒸気再圧縮ステージ:",
    compressorHelp: "オイルフリー全密閉スクロール圧縮機、ATEX Zone 1 防爆インバータースクリュー圧縮機、高純度トリプルダイヤフラム圧縮機、大気放出危険モードから選択。",
    tempLabel: "抽出塔操作温度 (T_ext):",
    tempHelp: "向流抽出塔内の液温（15.0〜45.0 °C）。常温域で運転し、脂質の酸化酸敗やタンパク質熱変性を根絶します。",
    pressureLabel: "亜臨界液化維持圧力 (P_ext):",
    pressureHelp: "DME の飽和蒸気圧以上に加圧維持されたシステム圧力（0.40〜1.00 MPa / 4.0〜10.0 bar）。気泡沸騰を防ぎ液相を保ちます。",
    ratioLabel: "溶媒/原料質量比 (R_s/f):",
    ratioHelp: "液化 DME と湿潤バイオマス供給量の質量比（1.5〜8.0 kg DME / kg 原料）。脱水駆動力と抽出収率を決定します。",
    feedRateLabel: "連続原料供給流量 (Q_feed):",
    feedRateHelp: "連続抽出脱水系へ流入する高水分スラリーの体積流量（100〜10,000 L/h）。",
    presetsTitle: "工業用 sDME クイック運転プリセット:",
    presetAlgae: "湿潤クロレラ微細藻類脂質ハーベスター（水分86.5％、加熱乾燥ゼロ、脂質回収率98.5％）",
    presetDairy: "乳清遠心スラッジ MFGM 複合脂質・レシチン回収（常温脱水、タンパク質未変性）",
    presetYeast: "ビール酵母エキス・脱苦高タンパク質残渣ケークアップサイクル（残余水分<12％）",
    presetSco: "油脂蓄積酵母シングルセルオイル (SCO) 連続回収（水分88％ブロス、SEC 14.2 kWh/t）",
    presetHazard: "従来型熱風乾燥機併用ヘキサン抽出法（深刻な火災・神経毒性 VOC 危険状態）",
    diagnosticTitle: "リアルタイム sDME 脱水熱力学速度論＆安全性テレメトリー",
    diagnosticSub: "比消費電力量（SEC）、乾燥ボイラー対比の省エネ率、完全密閉溶媒回収率、製品残留 DME 濃度（ppm）、安全インターロックをリアルタイム解析。",
    secLabel: "単位処理あたり比消費電力量 (SEC):",
    energySavingLabel: "従来の相変態加熱乾燥に対する総合省エネ率:",
    recoveryLabel: "完全閉ループ DME 溶媒回収率:",
    residualDmeLabel: "製品中残留ジメチルエーテル濃度（FDA 基準 < 1.0 ppm）:",
    dewateringLabel: "ワンパス水分脱除効率:",
    lipidYieldLabel: "総脂質（中性脂肪＆極性リン脂質）抽出収率:",
    residualMoistureLabel: "脱脂固形ケーク残余含水率:",
    statusLabel: "ASME Sec VIII / NFPA 58 / ATEX Zone 1 防爆準拠状態:",
    diagramTitle: "連続式亜臨界ジメチルエーテル抽出＆密閉蒸気再圧縮プロセス系統図",
    diagramSub: "湿潤スラリーポンプ、耐圧向流抽出塔、固液分離遠心脱水機、フラッシュ脱溶缶、無油防爆蒸気圧縮機、水冷凝縮器、液化DME受液槽。",
    scienceTitle: "熱力学的相平衡理論＆グリーン亜臨界溶媒バイオフィジックス",
    scienceSub: "液化 DME の双極子モーメント（1.30 D）、水に対する特異な部分相溶性（7.8 wt％）、超低沸点（-24.8°C）、非加熱破壁速度論の物理化学的解説。",
    tableTitle: "技術比較マトリックス：sDME 対 従来型加熱乾燥ヘキサン抽出・超臨界 CO2 抽出"
  }
};

const d = DICT[lang] || DICT.en;
const systems = sdmeData.systemArchitectures;
const feeds = sdmeData.feedMatrices;
const solvents = sdmeData.solventConditions;
const compressors = sdmeData.compressorStages;
---

<div class="my-10 p-6 md:p-8 bg-surface border border-hairline rounded-3xl shadow-xs">
  <!-- Header Badge & Title -->
  <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
    <span class="inline-block px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-950 text-emerald-300 border border-emerald-800">
      {d.badge}
    </span>
    <span class="text-xs text-muted font-mono">
      sDME &bull; 0.50&ndash;0.85 MPa &bull; 20&ndash;35&deg;C &bull; ASME Sec VIII &bull; NFPA 58 &bull; ATEX Zone 1 &bull; 3-A 63-04
    </span>
  </div>

  <h2 class="text-title-lg md:text-headline-sm font-medium text-ink tracking-tight mb-3">
    {d.title}
  </h2>
  <p class="text-body text-sm leading-relaxed mb-8 max-w-4xl text-muted">
    {d.subtitle}
  </p>

  <!-- Quick Presets -->
  <div class="mb-8 p-5 bg-surface-soft border border-hairline rounded-2xl">
    <h3 class="text-xs font-bold uppercase tracking-wider text-muted mb-3">
      {d.presetsTitle}
    </h3>
    <div class="flex flex-wrap gap-2.5">
      <button type="button" id="sdme-preset-algae" class="px-3.5 py-2 rounded-xl text-xs font-medium bg-surface hover:bg-surface-elevated border border-hairline text-ink transition-colors">
        🌱 {d.presetAlgae}
      </button>
      <button type="button" id="sdme-preset-dairy" class="px-3.5 py-2 rounded-xl text-xs font-medium bg-surface hover:bg-surface-elevated border border-hairline text-ink transition-colors">
        🥛 {d.presetDairy}
      </button>
      <button type="button" id="sdme-preset-yeast" class="px-3.5 py-2 rounded-xl text-xs font-medium bg-surface hover:bg-surface-elevated border border-hairline text-ink transition-colors">
        🍺 {d.presetYeast}
      </button>
      <button type="button" id="sdme-preset-sco" class="px-3.5 py-2 rounded-xl text-xs font-medium bg-surface hover:bg-surface-elevated border border-hairline text-ink transition-colors">
        🧪 {d.presetSco}
      </button>
      <button type="button" id="sdme-preset-hazard" class="px-3.5 py-2 rounded-xl text-xs font-medium bg-rose-950/40 hover:bg-rose-950/60 border border-rose-800/80 text-rose-300 transition-colors">
        ⚠️ {d.presetHazard}
      </button>
    </div>
  </div>

  <!-- Interactive Controls Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-10">
    <!-- Left Column: Architecture & Materials -->
    <div class="space-y-6">
      <div class="p-6 bg-surface-soft border border-hairline rounded-2xl space-y-5">
        <h3 class="text-sm font-bold uppercase tracking-wider text-ink mb-1">
          {d.controlsTitle}
        </h3>
        <p class="text-xs text-muted mb-4">
          {d.controlsSub}
        </p>

        <!-- System Architecture Selection -->
        <div>
          <label for="sdme-system-select" class="block text-xs font-semibold text-ink mb-1">
            {d.systemLabel}
          </label>
          <select id="sdme-system-select" class="w-full bg-surface border border-hairline rounded-xl px-3.5 py-2.5 text-xs text-ink focus:outline-hidden focus:ring-1 focus:ring-emerald-500">
            {systems.map((s) => (
              <option value={s.id}>{s.name}</option>
            ))}
          </select>
          <p class="text-[11px] text-muted mt-1" id="sdme-system-desc">
            {systems[0].description}
          </p>
        </div>

        <!-- Feedstock Matrix Selection -->
        <div>
          <label for="sdme-feed-select" class="block text-xs font-semibold text-ink mb-1">
            {d.matrixLabel}
          </label>
          <select id="sdme-feed-select" class="w-full bg-surface border border-hairline rounded-xl px-3.5 py-2.5 text-xs text-ink focus:outline-hidden focus:ring-1 focus:ring-emerald-500">
            {feeds.map((f) => (
              <option value={f.id}>{f.name}</option>
            ))}
          </select>
          <p class="text-[11px] text-muted mt-1" id="sdme-feed-desc">
            {feeds[0].description}
          </p>
        </div>

        <!-- Solvent Media Selection -->
        <div>
          <label for="sdme-solvent-select" class="block text-xs font-semibold text-ink mb-1">
            {d.solventLabel}
          </label>
          <select id="sdme-solvent-select" class="w-full bg-surface border border-hairline rounded-xl px-3.5 py-2.5 text-xs text-ink focus:outline-hidden focus:ring-1 focus:ring-emerald-500">
            {solvents.map((sv) => (
              <option value={sv.id}>{sv.name}</option>
            ))}
          </select>
          <p class="text-[11px] text-muted mt-1" id="sdme-solvent-desc">
            {solvents[0].description}
          </p>
        </div>

        <!-- Vapor Compressor Selection -->
        <div>
          <label for="sdme-compressor-select" class="block text-xs font-semibold text-ink mb-1">
            {d.compressorLabel}
          </label>
          <select id="sdme-compressor-select" class="w-full bg-surface border border-hairline rounded-xl px-3.5 py-2.5 text-xs text-ink focus:outline-hidden focus:ring-1 focus:ring-emerald-500">
            {compressors.map((c) => (
              <option value={c.id}>{c.name}</option>
            ))}
          </select>
          <p class="text-[11px] text-muted mt-1" id="sdme-compressor-desc">
            {compressors[0].description}
          </p>
        </div>
      </div>
    </div>

    <!-- Right Column: Numeric Sliders -->
    <div class="space-y-6">
      <div class="p-6 bg-surface-soft border border-hairline rounded-2xl space-y-6">
        <h3 class="text-sm font-bold uppercase tracking-wider text-ink mb-1">
          Extraction &amp; Decompression Kinetics
        </h3>

        <!-- Column Temperature Slider -->
        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label for="sdme-temp-slider" class="text-xs font-semibold text-ink">
              {d.tempLabel}
            </label>
            <span class="font-mono text-xs font-bold text-emerald-400" id="sdme-temp-val">
              25.0 &deg;C
            </span>
          </div>
          <input type="range" id="sdme-temp-slider" min="15.0" max="45.0" step="0.5" value="25.0" class="w-full accent-emerald-500 cursor-pointer" />
          <p class="text-[11px] text-muted mt-1">{d.tempHelp}</p>
        </div>

        <!-- Extraction Pressure Slider -->
        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label for="sdme-pressure-slider" class="text-xs font-semibold text-ink">
              {d.pressureLabel}
            </label>
            <span class="font-mono text-xs font-bold text-emerald-400" id="sdme-pressure-val">
              0.65 MPa
            </span>
          </div>
          <input type="range" id="sdme-pressure-slider" min="0.40" max="1.00" step="0.02" value="0.65" class="w-full accent-emerald-500 cursor-pointer" />
          <p class="text-[11px] text-muted mt-1">{d.pressureHelp}</p>
        </div>

        <!-- Solvent-to-Feed Ratio Slider -->
        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label for="sdme-ratio-slider" class="text-xs font-semibold text-ink">
              {d.ratioLabel}
            </label>
            <span class="font-mono text-xs font-bold text-emerald-400" id="sdme-ratio-val">
              4.2 : 1
            </span>
          </div>
          <input type="range" id="sdme-ratio-slider" min="1.5" max="8.0" step="0.1" value="4.2" class="w-full accent-emerald-500 cursor-pointer" />
          <p class="text-[11px] text-muted mt-1">{d.ratioHelp}</p>
        </div>

        <!-- Feed Inflow Rate Slider -->
        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label for="sdme-feed-slider" class="text-xs font-semibold text-ink">
              {d.feedRateLabel}
            </label>
            <span class="font-mono text-xs font-bold text-emerald-400" id="sdme-feed-val">
              3,500 L/h
            </span>
          </div>
          <input type="range" id="sdme-feed-slider" min="100" max="10000" step="100" value="3500" class="w-full accent-emerald-500 cursor-pointer" />
          <p class="text-[11px] text-muted mt-1">{d.feedRateHelp}</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Real-Time Diagnostic Dashboard -->
  <div class="mb-10 p-6 md:p-8 bg-surface-elevated border border-hairline rounded-3xl shadow-sm">
    <div class="flex items-center justify-between mb-6 border-b border-hairline/80 pb-4">
      <div>
        <h3 class="text-base font-bold text-ink">
          {d.diagnosticTitle}
        </h3>
        <p class="text-xs text-muted mt-0.5">
          {d.diagnosticSub}
        </p>
      </div>
      <div id="sdme-safety-badge" class="px-3.5 py-1.5 rounded-full text-xs font-bold tracking-wide bg-emerald-950 text-emerald-300 border border-emerald-800">
        ASME &bull; NFPA 58 &bull; ATEX ZONE 1 OK
      </div>
    </div>

    <!-- Metrics Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
      <div class="p-4 bg-surface rounded-2xl border border-hairline">
        <span class="block text-[11px] font-semibold text-muted uppercase tracking-wider mb-1">
          {d.secLabel}
        </span>
        <span class="text-lg md:text-xl font-bold font-mono text-emerald-400" id="sdme-sec-metric">
          14.2 kWh/t
        </span>
        <span class="block text-[10px] text-muted mt-0.5">Electrical Compressor Load</span>
      </div>

      <div class="p-4 bg-surface rounded-2xl border border-hairline">
        <span class="block text-[11px] font-semibold text-muted uppercase tracking-wider mb-1">
          {d.energySavingLabel}
        </span>
        <span class="text-lg md:text-xl font-bold font-mono text-emerald-400" id="sdme-energy-saving-metric">
          97.8%
        </span>
        <span class="block text-[10px] text-muted mt-0.5">vs Thermal Steam Drying</span>
      </div>

      <div class="p-4 bg-surface rounded-2xl border border-hairline">
        <span class="block text-[11px] font-semibold text-muted uppercase tracking-wider mb-1">
          {d.recoveryLabel}
        </span>
        <span class="text-lg md:text-xl font-bold font-mono text-emerald-400" id="sdme-recovery-metric">
          99.6%
        </span>
        <span class="block text-[10px] text-muted mt-0.5">Closed-Loop DME Recycling</span>
      </div>

      <div class="p-4 bg-surface rounded-2xl border border-hairline">
        <span class="block text-[11px] font-semibold text-muted uppercase tracking-wider mb-1">
          {d.residualDmeLabel}
        </span>
        <span class="text-lg md:text-xl font-bold font-mono text-emerald-400" id="sdme-residual-metric">
          0.38 ppm
        </span>
        <span class="block text-[10px] text-muted mt-0.5">FDA/EFSA Spec: &lt; 1.0 ppm</span>
      </div>

      <div class="p-4 bg-surface rounded-2xl border border-hairline">
        <span class="block text-[11px] font-semibold text-muted uppercase tracking-wider mb-1">
          {d.dewateringLabel}
        </span>
        <span class="text-lg md:text-xl font-bold font-mono text-teal-400" id="sdme-dewatering-metric">
          88.5%
        </span>
        <span class="block text-[10px] text-muted mt-0.5">Moisture Stripped to DME</span>
      </div>

      <div class="p-4 bg-surface rounded-2xl border border-hairline">
        <span class="block text-[11px] font-semibold text-muted uppercase tracking-wider mb-1">
          {d.lipidYieldLabel}
        </span>
        <span class="text-lg md:text-xl font-bold font-mono text-teal-400" id="sdme-lipid-yield-metric">
          98.4%
        </span>
        <span class="block text-[10px] text-muted mt-0.5">Neutral TAGs + Polar Lipids</span>
      </div>

      <div class="p-4 bg-surface rounded-2xl border border-hairline">
        <span class="block text-[11px] font-semibold text-muted uppercase tracking-wider mb-1">
          {d.residualMoistureLabel}
        </span>
        <span class="text-lg md:text-xl font-bold font-mono text-teal-400" id="sdme-residual-moisture-metric">
          11.2%
        </span>
        <span class="block text-[10px] text-muted mt-0.5">Dewatered Dry Cake Basis</span>
      </div>

      <div class="p-4 bg-surface rounded-2xl border border-hairline">
        <span class="block text-[11px] font-semibold text-muted uppercase tracking-wider mb-1">
          {d.statusLabel}
        </span>
        <span class="text-sm font-bold font-mono text-emerald-400" id="sdme-compliance-metric">
          PASSED (Class 1 Div 1)
        </span>
        <span class="block text-[10px] text-muted mt-0.5">ASME Sec VIII &bull; 3-A 63-04</span>
      </div>
    </div>

    <!-- Alert / Warning Banner -->
    <div id="sdme-hazard-banner" class="hidden p-4 rounded-2xl bg-rose-950/60 border border-rose-800 text-rose-200 text-xs leading-relaxed">
      <strong>🚨 CRITICAL SAFETY INTERLOCK ENGAGED:</strong> Hazardous extraction conditions detected! High-temperature petrochemical solvent or unsealed atmospheric venting risks catastrophic flash-fire auto-ignition, neurotoxic VOC inhalation, and irreversible protein denaturation.
    </div>
  </div>

  <!-- Interactive SVG Process Flow Schematic -->
  <div class="mb-10 p-6 md:p-8 bg-surface-soft border border-hairline rounded-3xl">
    <div class="flex items-center justify-between mb-4">
      <div>
        <h3 class="text-base font-bold text-ink">
          {d.diagramTitle}
        </h3>
        <p class="text-xs text-muted mt-0.5">
          {d.diagramSub}
        </p>
      </div>
      <span class="text-xs font-mono text-muted">Hermetic Closed-Loop P&amp;ID</span>
    </div>

    <div class="overflow-x-auto">
      <svg viewBox="0 0 960 420" class="w-full min-w-[720px] max-w-full h-auto text-ink" style="background-color: #0b1117; border-radius: 1rem;">
        <defs>
          <linearGradient id="grad-column" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#064e3b" stop-opacity="0.8" />
            <stop offset="100%" stop-color="#022c22" stop-opacity="0.9" />
          </linearGradient>
          <linearGradient id="grad-calandria" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#1e3a5f" stop-opacity="0.8" />
            <stop offset="100%" stop-color="#0f172a" stop-opacity="0.9" />
          </linearGradient>
          <linearGradient id="grad-compressor" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#047857" stop-opacity="0.8" />
            <stop offset="100%" stop-color="#065f46" stop-opacity="0.9" />
          </linearGradient>
          <marker id="arrow" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M 0 1 L 8 5 L 0 9 z" fill="#10b981" />
          </marker>
          <marker id="arrow-vapor" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M 0 1 L 8 5 L 0 9 z" fill="#38bdf8" />
          </marker>
        </defs>

        <!-- Process Flow Lines -->
        <!-- Wet Slurry Line -->
        <path d="M 60 140 L 160 140" stroke="#34d399" stroke-width="3" fill="none" marker-end="url(#arrow)" />
        <text x="65" y="125" fill="#a7f3d0" font-size="11" font-family="monospace">Wet Biomass Slurry (85% H2O)</text>

        <!-- Liquefied sDME Input to Column Bottom -->
        <path d="M 780 340 L 260 340 L 260 260" stroke="#10b981" stroke-width="3" fill="none" stroke-dasharray="4,2" marker-end="url(#arrow)" />
        <text x="440" y="330" fill="#6ee7b7" font-size="11" font-family="monospace">Recycled Liquefied sDME (0.65 MPa, 25&deg;C)</text>

        <!-- Subcritical Column Vessel -->
        <rect x="160" y="80" width="120" height="200" rx="20" fill="url(#grad-column)" stroke="#059669" stroke-width="2" />
        <text x="175" y="110" fill="#ecfdf5" font-size="12" font-weight="bold">Counter-Current</text>
        <text x="180" y="128" fill="#ecfdf5" font-size="12" font-weight="bold">sDME Column</text>
        <text x="175" y="150" fill="#6ee7b7" font-size="10" font-family="monospace">0.65 MPa &bull; 25&deg;C</text>
        <text x="175" y="170" fill="#a7f3d0" font-size="9">Counter-Current Trays</text>
        <text x="175" y="185" fill="#a7f3d0" font-size="9">H2O + Lipids Dissolve</text>

        <!-- Dewatered Meal Exit (Bottom) -->
        <path d="M 220 280 L 220 370 L 100 370" stroke="#fbbf24" stroke-width="3" fill="none" marker-end="url(#arrow)" />
        <rect x="60" y="345" width="80" height="50" rx="8" fill="#78350f" stroke="#d97706" stroke-width="1.5" />
        <text x="68" y="365" fill="#fef3c7" font-size="10" font-weight="bold">Dewatered Cake</text>
        <text x="68" y="380" fill="#fde68a" font-size="9" font-family="monospace">&lt;12% Moisture</text>

        <!-- sDME Extract Stream (Top of Column to Flash Evaporator) -->
        <path d="M 280 120 L 390 120" stroke="#38bdf8" stroke-width="3" fill="none" marker-end="url(#arrow)" />
        <text x="290" y="110" fill="#7dd3fc" font-size="10" font-family="monospace">sDME + Lipids + H2O</text>

        <!-- Flash Desorption Calandria -->
        <rect x="390" y="70" width="130" height="210" rx="15" fill="url(#grad-calandria)" stroke="#0284c7" stroke-width="2" />
        <text x="405" y="100" fill="#f0f9ff" font-size="12" font-weight="bold">Flash Desorption</text>
        <text x="420" y="118" fill="#f0f9ff" font-size="12" font-weight="bold">Calandria</text>
        <text x="405" y="145" fill="#38bdf8" font-size="10" font-family="monospace">&Delta;P Flash (0.1 MPa)</text>
        <text x="405" y="165" fill="#bae6fd" font-size="9">DME Flash Evaporation</text>
        <text x="405" y="180" fill="#bae6fd" font-size="9">T_boil = -24.8&deg;C</text>

        <!-- Pure Extracted Lipids & Water Discharge -->
        <path d="M 455 280 L 455 370 L 350 370" stroke="#10b981" stroke-width="3" fill="none" marker-end="url(#arrow)" />
        <rect x="290" y="345" width="110" height="50" rx="8" fill="#064e3b" stroke="#059669" stroke-width="1.5" />
        <text x="298" y="365" fill="#ecfdf5" font-size="10" font-weight="bold">Purified Extract</text>
        <text x="298" y="380" fill="#6ee7b7" font-size="9" font-family="monospace">Lipids &amp; Water (No DME)</text>

        <!-- DME Vapor to Compressor -->
        <path d="M 520 120 L 610 120" stroke="#38bdf8" stroke-width="3" fill="none" marker-end="url(#arrow-vapor)" />
        <text x="525" y="110" fill="#7dd3fc" font-size="10" font-family="monospace">DME Vapor Stream</text>

        <!-- Vapor Recompressor (Scroll / Screw) -->
        <rect x="610" y="80" width="120" height="100" rx="16" fill="url(#grad-compressor)" stroke="#10b981" stroke-width="2" />
        <text x="625" y="110" fill="#ffffff" font-size="12" font-weight="bold">Hermetic Vapor</text>
        <text x="625" y="128" fill="#ffffff" font-size="12" font-weight="bold">Recompressor</text>
        <text x="625" y="150" fill="#a7f3d0" font-size="10" font-family="monospace">&eta;_is = 85% &bull; 0.65 MPa</text>

        <!-- Recompressed High-Pressure Vapor to Condenser -->
        <path d="M 730 130 L 810 130 L 810 180" stroke="#34d399" stroke-width="3" fill="none" marker-end="url(#arrow)" />

        <!-- Water-Cooled Condenser -->
        <rect x="750" y="180" width="120" height="80" rx="12" fill="#1e293b" stroke="#64748b" stroke-width="2" />
        <text x="765" y="210" fill="#f8fafc" font-size="11" font-weight="bold">Water-Cooled</text>
        <text x="770" y="226" fill="#f8fafc" font-size="11" font-weight="bold">Condenser</text>
        <text x="765" y="244" fill="#94a3b8" font-size="9" font-family="monospace">20&deg;C Cooling Water</text>

        <!-- Liquid DME Receiver Tank -->
        <path d="M 810 260 L 810 290" stroke="#10b981" stroke-width="3" fill="none" marker-end="url(#arrow)" />
        <rect x="750" y="290" width="120" height="70" rx="14" fill="#047857" stroke="#10b981" stroke-width="2" />
        <text x="760" y="315" fill="#ecfdf5" font-size="11" font-weight="bold">Liquid sDME</text>
        <text x="760" y="330" fill="#ecfdf5" font-size="11" font-weight="bold">Storage Buffer</text>
        <text x="760" y="346" fill="#a7f3d0" font-size="9" font-family="monospace">99.6% Closed Loop</text>
      </svg>
    </div>
  </div>

  <!-- Thermodynamic & Biophysical Equations Section -->
  <div class="mb-10 p-6 md:p-8 bg-surface border border-hairline rounded-3xl">
    <h3 class="text-base font-bold text-ink mb-1">
      {d.scienceTitle}
    </h3>
    <p class="text-xs text-muted mb-6">
      {d.scienceSub}
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs leading-relaxed text-body">
      <div class="p-5 bg-surface-soft border border-hairline rounded-2xl space-y-3">
        <h4 class="font-bold text-ink text-sm">
          1. Subcritical Liquid-Liquid Extraction &amp; Partial Miscibility
        </h4>
        <p>
          Unlike strictly non-polar solvents (e.g. n-hexane, supercritical CO<sub>2</sub>), liquefied dimethyl ether (sDME) possesses a dipole moment (&mu; = 1.30 D) and an ether oxygen atom with two lone electron pairs capable of acting as hydrogen-bond acceptors with water. Under subcritical conditions (0.50&ndash;0.85 MPa, 20&ndash;35&deg;C):
        </p>
        <div class="p-3 bg-surface rounded-xl font-mono text-[11px] text-emerald-400 border border-hairline">
          x_w = f(T, P) &approx; 7.8 wt% H2O in liquid sDME (at 25&deg;C)<br />
          x_DME = f'(T, P) &approx; 35.0 wt% sDME in aqueous phase
        </div>
        <p>
          This dual solubility allows liquefied DME to simultaneously dissolve water and hydrophobic triacylglycerols (TAGs) directly from wet biological matrices (&gt;85% moisture) without expensive pre-drying.
        </p>
      </div>

      <div class="p-5 bg-surface-soft border border-hairline rounded-2xl space-y-3">
        <h4 class="font-bold text-ink text-sm">
          2. Flash Desorption &amp; Isentropic Recompression Thermodynamics
        </h4>
        <p>
          Due to its low boiling point (T<sub>b</sub> = -24.8&deg;C at 1 atm), depressurizing the extract phase from 0.65 MPa to atmospheric pressure causes spontaneous, non-thermal flash evaporation of DME vapor (&Delta;H<sub>vap</sub> = 467 kJ/kg):
        </p>
        <div class="p-3 bg-surface rounded-xl font-mono text-[11px] text-emerald-400 border border-hairline">
          W_comp = ( &gamma; / (&gamma; - 1) ) &bull; ( P1 &bull; V1 / &eta;_is ) &bull; [ (P2 / P1)^((&gamma;-1)/&gamma;) - 1 ]<br />
          SEC_electrical = W_comp / m_feed &lt; 15.0 kWh/ton wet slurry
        </div>
        <p>
          The closed-loop compressor recompresses vapor to 0.65 MPa for condensation at 20&deg;C cooling water, capturing 99.6% of solvent with zero fossil-fueled thermal drying energy.
        </p>
      </div>
    </div>
  </div>

  <!-- Comparative Technical Matrix Table -->
  <div class="p-6 md:p-8 bg-surface-soft border border-hairline rounded-3xl">
    <h3 class="text-base font-bold text-ink mb-1">
      {d.tableTitle}
    </h3>
    <p class="text-xs text-muted mb-6">
      Comprehensive comparison of extraction thermodynamics, operational energy, and regulatory standards.
    </p>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs text-body border-collapse">
        <thead>
          <tr class="border-b border-hairline text-ink font-semibold">
            <th class="py-3 px-4">Extraction Technology</th>
            <th class="py-3 px-4">Pre-Drying Energy</th>
            <th class="py-3 px-4">Operating Temp &amp; Press</th>
            <th class="py-3 px-4">Solvent Toxicity / Residue</th>
            <th class="py-3 px-4">Specific Energy (SEC)</th>
            <th class="py-3 px-4">Regulatory Compliance</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline/60">
          <tr class="bg-emerald-950/20">
            <td class="py-3.5 px-4 font-bold text-emerald-400">Continuous Subcritical DME (sDME)</td>
            <td class="py-3.5 px-4 text-emerald-300 font-semibold">0.0 kWh (Direct Wet Feed)</td>
            <td class="py-3.5 px-4 font-mono">20&ndash;35&deg;C &bull; 0.5&ndash;0.8 MPa</td>
            <td class="py-3.5 px-4 text-emerald-300">Non-toxic, &lt; 0.5 ppm residual (FDA GRAS)</td>
            <td class="py-3.5 px-4 font-bold text-emerald-400 font-mono">14.2 kWh/t</td>
            <td class="py-3.5 px-4 text-emerald-300">ASME Sec VIII &bull; NFPA 58 &bull; 3-A 63-04</td>
          </tr>
          <tr>
            <td class="py-3 px-4 font-medium text-ink">Conventional n-Hexane Extraction</td>
            <td class="py-3 px-4 text-rose-400">650&ndash;750 kWh/t (Drum/Spray Drying)</td>
            <td class="py-3 px-4 font-mono">60&ndash;75&deg;C &bull; 0.1 MPa</td>
            <td class="py-3 px-4 text-rose-400">Neurotoxic (OSHA PEL 50 ppm, 10&ndash;50 ppm res)</td>
            <td class="py-3 px-4 font-mono">680 kWh/t total</td>
            <td class="py-3 px-4">OSHA 1910.106 &bull; EPA VOC Rules</td>
          </tr>
          <tr>
            <td class="py-3 px-4 font-medium text-ink">Supercritical Carbon Dioxide (scCO2)</td>
            <td class="py-3 px-4 text-amber-400">Requires Pre-Drying (&lt;10% H2O)</td>
            <td class="py-3 px-4 font-mono">40&ndash;65&deg;C &bull; 25&ndash;50 MPa</td>
            <td class="py-3 px-4 text-emerald-300">Zero residue (Inert CO2)</td>
            <td class="py-3 px-4 font-mono">110&ndash;180 kWh/t</td>
            <td class="py-3 px-4">ASME Sec VIII Div 2 &bull; CGA G-6</td>
          </tr>
          <tr>
            <td class="py-3 px-4 font-medium text-ink">Thermal Vacuum Evaporation + Centrifuge</td>
            <td class="py-3 px-4 text-rose-400">Full Thermal Boiling Load</td>
            <td class="py-3 px-4 font-mono">65&ndash;90&deg;C &bull; 0.2&ndash;0.9 bar</td>
            <td class="py-3 px-4 text-amber-400">Zero solvent, but thermal denaturation</td>
            <td class="py-3 px-4 font-mono">220&ndash;350 kWh/t</td>
            <td class="py-3 px-4">3-A 60-01 &bull; ASME BPVC</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  // Client-side Interactive Simulation Logic for sDME Modeler
  document.addEventListener('DOMContentLoaded', () => {
    const systemSelect = document.getElementById('sdme-system-select') as HTMLSelectElement | null;
    const feedSelect = document.getElementById('sdme-feed-select') as HTMLSelectElement | null;
    const solventSelect = document.getElementById('sdme-solvent-select') as HTMLSelectElement | null;
    const compressorSelect = document.getElementById('sdme-compressor-select') as HTMLSelectElement | null;

    const tempSlider = document.getElementById('sdme-temp-slider') as HTMLInputElement | null;
    const pressureSlider = document.getElementById('sdme-pressure-slider') as HTMLInputElement | null;
    const ratioSlider = document.getElementById('sdme-ratio-slider') as HTMLInputElement | null;
    const feedSlider = document.getElementById('sdme-feed-slider') as HTMLInputElement | null;

    const tempVal = document.getElementById('sdme-temp-val');
    const pressureVal = document.getElementById('sdme-pressure-val');
    const ratioVal = document.getElementById('sdme-ratio-val');
    const feedVal = document.getElementById('sdme-feed-val');

    const secMetric = document.getElementById('sdme-sec-metric');
    const energySavingMetric = document.getElementById('sdme-energy-saving-metric');
    const recoveryMetric = document.getElementById('sdme-recovery-metric');
    const residualMetric = document.getElementById('sdme-residual-metric');
    const dewateringMetric = document.getElementById('sdme-dewatering-metric');
    const lipidYieldMetric = document.getElementById('sdme-lipid-yield-metric');
    const residualMoistureMetric = document.getElementById('sdme-residual-moisture-metric');
    const complianceMetric = document.getElementById('sdme-compliance-metric');
    const safetyBadge = document.getElementById('sdme-safety-badge');
    const hazardBanner = document.getElementById('sdme-hazard-banner');

    function updateSimulation() {
      if (!tempSlider || !pressureSlider || !ratioSlider || !feedSlider) return;

      const temp = parseFloat(tempSlider.value);
      const press = parseFloat(pressureSlider.value);
      const ratio = parseFloat(ratioSlider.value);
      const feed = parseFloat(feedSlider.value);

      if (tempVal) tempVal.innerHTML = `${temp.toFixed(1)} &deg;C`;
      if (pressureVal) pressureVal.innerHTML = `${press.toFixed(2)} MPa`;
      if (ratioVal) ratioVal.innerHTML = `${ratio.toFixed(1)} : 1`;
      if (feedVal) feedVal.innerHTML = `${Math.round(feed).toLocaleString()} L/h`;

      const isHexaneHazard = solventSelect?.value === 'unpressurized_hexane_thermal_hazard';
      const isVentingHazard = compressorSelect?.value === 'uncondensed_atmospheric_venting_hazard';
      const isSevereHazard = isHexaneHazard || isVentingHazard;

      if (isSevereHazard) {
        if (hazardBanner) hazardBanner.classList.remove('hidden');
        if (safetyBadge) {
          safetyBadge.className = 'px-3.5 py-1.5 rounded-full text-xs font-bold tracking-wide bg-rose-950 text-rose-300 border border-rose-800 animate-pulse';
          safetyBadge.innerText = 'NON-COMPLIANT / SEVERE HAZARD';
        }
        if (complianceMetric) {
          complianceMetric.className = 'text-sm font-bold font-mono text-rose-400';
          complianceMetric.innerText = 'FAIL (EXPLOSION RISK)';
        }
        if (secMetric) secMetric.innerText = isHexaneHazard ? '680.0 kWh/t' : '45.0 kWh/t';
        if (energySavingMetric) energySavingMetric.innerText = '0.0%';
        if (recoveryMetric) recoveryMetric.innerText = isVentingHazard ? '0.0%' : '88.5%';
        if (residualMetric) residualMetric.innerText = isHexaneHazard ? '45.0 ppm' : '18.5 ppm';
        if (dewateringMetric) dewateringMetric.innerText = isHexaneHazard ? '12.0%' : '45.0%';
        if (lipidYieldMetric) lipidYieldMetric.innerText = '72.0%';
        if (residualMoistureMetric) residualMoistureMetric.innerText = '65.0%';
        return;
      }

      if (hazardBanner) hazardBanner.classList.add('hidden');
      if (safetyBadge) {
        safetyBadge.className = 'px-3.5 py-1.5 rounded-full text-xs font-bold tracking-wide bg-emerald-950 text-emerald-300 border border-emerald-800';
        safetyBadge.innerText = 'ASME &bull; NFPA 58 &bull; ATEX ZONE 1 OK';
      }
      if (complianceMetric) {
        complianceMetric.className = 'text-sm font-bold font-mono text-emerald-400';
        complianceMetric.innerText = 'PASSED (Class 1 Div 1)';
      }

      // Physics modeling:
      // Base SEC = ~13.8 kWh/t + pressure ratio effect + ratio effect
      const baseSec = 12.0 + (press * 2.2) + (ratio * 0.45);
      const energySavings = Math.min(98.5, Math.max(94.0, 99.0 - (baseSec / 15.0)));
      const recoveryRate = Math.min(99.9, Math.max(99.0, 99.7 - (press < 0.5 ? 0.4 : 0.0)));
      const residualDme = Math.max(0.05, 0.45 - (temp * 0.008) + (press > 0.8 ? 0.08 : 0.0));
      const dewateringEff = Math.min(95.0, Math.max(82.0, 75.0 + (ratio * 2.8) + ((temp - 20) * 0.3)));
      const lipidYield = Math.min(99.6, Math.max(92.0, 90.0 + (ratio * 1.5) + (press * 3.5)));
      const residualMoisture = Math.max(8.0, 85.0 * (1 - (dewateringEff / 100)));

      if (secMetric) secMetric.innerText = `${baseSec.toFixed(1)} kWh/t`;
      if (energySavingMetric) energySavingMetric.innerText = `${energySavings.toFixed(1)}%`;
      if (recoveryMetric) recoveryMetric.innerText = `${recoveryRate.toFixed(1)}%`;
      if (residualMetric) residualMetric.innerText = `${residualDme.toFixed(2)} ppm`;
      if (dewateringMetric) dewateringMetric.innerText = `${dewateringEff.toFixed(1)}%`;
      if (lipidYieldMetric) lipidYieldMetric.innerText = `${lipidYield.toFixed(1)}%`;
      if (residualMoistureMetric) residualMoistureMetric.innerText = `${residualMoisture.toFixed(1)}%`;
    }

    // Attach Event Listeners
    [tempSlider, pressureSlider, ratioSlider, feedSlider].forEach((slider) => {
      slider?.addEventListener('input', updateSimulation);
    });

    [systemSelect, feedSelect, solventSelect, compressorSelect].forEach((sel) => {
      sel?.addEventListener('change', updateSimulation);
    });

    // Preset Buttons
    document.getElementById('sdme-preset-algae')?.addEventListener('click', () => {
      if (feedSelect) feedSelect.value = 'wet_chlorella_vulgaris_paste';
      if (solventSelect) solventSelect.value = 'pure_liquefied_sdme';
      if (compressorSelect) compressorSelect.value = 'hermetic_oil_free_scroll_recompressor';
      if (tempSlider) tempSlider.value = '25.0';
      if (pressureSlider) pressureSlider.value = '0.65';
      if (ratioSlider) ratioSlider.value = '4.5';
      if (feedSlider) feedSlider.value = '4000';
      updateSimulation();
    });

    document.getElementById('sdme-preset-dairy')?.addEventListener('click', () => {
      if (feedSelect) feedSelect.value = 'wet_dairy_whey_lipid_sludge';
      if (solventSelect) solventSelect.value = 'sdme_bioethanol_entrainer';
      if (compressorSelect) compressorSelect.value = 'atex_variable_speed_screw_recompressor';
      if (tempSlider) tempSlider.value = '28.0';
      if (pressureSlider) pressureSlider.value = '0.70';
      if (ratioSlider) ratioSlider.value = '4.0';
      if (feedSlider) feedSlider.value = '3500';
      updateSimulation();
    });

    document.getElementById('sdme-preset-yeast')?.addEventListener('click', () => {
      if (feedSelect) feedSelect.value = 'brewers_spent_yeast_slurry';
      if (solventSelect) solventSelect.value = 'pure_liquefied_sdme';
      if (compressorSelect) compressorSelect.value = 'atex_variable_speed_screw_recompressor';
      if (tempSlider) tempSlider.value = '30.0';
      if (pressureSlider) pressureSlider.value = '0.62';
      if (ratioSlider) ratioSlider.value = '3.8';
      if (feedSlider) feedSlider.value = '3000';
      updateSimulation();
    });

    document.getElementById('sdme-preset-sco')?.addEventListener('click', () => {
      if (feedSelect) feedSelect.value = 'fermentation_single_cell_oil_broth';
      if (solventSelect) solventSelect.value = 'sdme_co2_hybrid_blend';
      if (compressorSelect) compressorSelect.value = 'hermetic_oil_free_scroll_recompressor';
      if (tempSlider) tempSlider.value = '24.0';
      if (pressureSlider) pressureSlider.value = '0.75';
      if (ratioSlider) ratioSlider.value = '5.0';
      if (feedSlider) feedSlider.value = '5000';
      updateSimulation();
    });

    document.getElementById('sdme-preset-hazard')?.addEventListener('click', () => {
      if (solventSelect) solventSelect.value = 'unpressurized_hexane_thermal_hazard';
      if (compressorSelect) compressorSelect.value = 'uncondensed_atmospheric_venting_hazard';
      if (tempSlider) tempSlider.value = '45.0';
      if (pressureSlider) pressureSlider.value = '0.40';
      updateSimulation();
    });

    updateSimulation();
  });
</script>
