<script>
  function initDrumRoasterModeler() {
    const roasterSelect = document.getElementById('roaster-select') as HTMLSelectElement | null;
    const grainSelect = document.getElementById('grain-select') as HTMLSelectElement | null;
    const burnerSelect = document.getElementById('burner-select') as HTMLSelectElement | null;

    const tempSlider = document.getElementById('roast-temp-slider') as HTMLInputElement | null;
    const lambdaSlider = document.getElementById('lambda-slider') as HTMLInputElement | null;
    const velocitySlider = document.getElementById('velocity-slider') as HTMLInputElement | null;
    const chaffBedSlider = document.getElementById('chaff-bed-slider') as HTMLInputElement | null;
    const ventilationSlider = document.getElementById('ventilation-slider') as HTMLInputElement | null;
    const coAlarmSlider = document.getElementById('co-alarm-slider') as HTMLInputElement | null;

    const tempVal = document.getElementById('roast-temp-val');
    const lambdaVal = document.getElementById('lambda-val');
    const velocityVal = document.getElementById('velocity-val');
    const chaffBedVal = document.getElementById('chaff-bed-val');
    const ventilationVal = document.getElementById('ventilation-val');
    const coAlarmVal = document.getElementById('co-alarm-val');

    const outFlueCo = document.getElementById('out-flue-co');
    const flueCoBar = document.getElementById('flue-co-bar');
    const flueCoStatus = document.getElementById('flue-co-status');

    const outKst = document.getElementById('out-kst');
    const kstBar = document.getElementById('kst-bar');

    const outVelocity = document.getElementById('out-velocity');
    const velocityBar = document.getElementById('velocity-bar');
    const saltationStatus = document.getElementById('saltation-status');

    const outRoomCo = document.getElementById('out-room-co');
    const roomCoBar = document.getElementById('room-co-bar');
    const roomCoStatus = document.getElementById('room-co-status');

    const outVentMargin = document.getElementById('out-vent-margin');
    const ventMarginBar = document.getElementById('vent-margin-bar');
    const ventStatus = document.getElementById('vent-status');

    const safetyBadge = document.getElementById('safety-status-badge');
    const complianceLabel = document.getElementById('out-compliance-label');
    const complianceDetail = document.getElementById('out-compliance-detail');
    const hazardDetail = document.getElementById('hazard-detail');
    const mechanismsDetail = document.getElementById('mechanisms-detail');
    const mitigationDetail = document.getElementById('mitigation-detail');

    const copyBtn = document.getElementById('copy-report-btn');
    const copyBtnText = document.getElementById('copy-btn-text');

    if (!roasterSelect || !grainSelect || !burnerSelect || !tempSlider || !lambdaSlider) return;

    function recalculate() {
      const roasterId = roasterSelect!.value;
      const grainId = grainSelect!.value;
      const burnerId = burnerSelect!.value;

      const tempC = parseFloat(tempSlider!.value);
      const tempF = Math.round((tempC * 9/5) + 32);
      const lambda = parseFloat(lambdaSlider!.value);
      const velocity = parseFloat(velocitySlider!.value);
      const chaffBedKg = parseFloat(chaffBedSlider!.value);
      const ach = parseFloat(ventilationSlider!.value);
      const coAlarmSetpoint = parseFloat(coAlarmSlider!.value);

      if (tempVal) tempVal.textContent = `${tempC}°C (${tempF}°F)`;
      if (lambdaVal) {
        let tag = 'Optimal';
        if (lambda < 1.0) tag = 'Oxygen Starvation (CO Spikes)';
        else if (lambda > 1.35) tag = 'High Excess Air (Thermal Loss)';
        lambdaVal.textContent = `λ = ${lambda.toFixed(2)} (${tag})`;
      }
      if (velocityVal) velocityVal.textContent = `${velocity.toFixed(1)} m/s`;
      if (chaffBedVal) chaffBedVal.textContent = `${chaffBedKg} kg`;
      if (ventilationVal) ventilationVal.textContent = `${ach.toFixed(1)} ACH`;
      if (coAlarmVal) coAlarmVal.textContent = `${coAlarmSetpoint} ppm`;

      // Base Grain Parameters
      let baseKst = 165;
      let dustClass = 'St 1';
      let saltationLimit = 15.2;
      let grainFactor = 1.0;

      if (grainId === 'arabica_robusta_coffee_beans') {
        baseKst = 165;
        dustClass = 'St 1';
        saltationLimit = 15.2;
        grainFactor = 1.1;
      } else if (grainId === 'fermented_cocoa_beans') {
        baseKst = 110;
        dustClass = 'St 1';
        saltationLimit = 13.8;
        grainFactor = 0.85;
      } else if (grainId === 'malted_barley_specialty_grains') {
        baseKst = 215;
        dustClass = 'St 2';
        saltationLimit = 16.8;
        grainFactor = 1.45;
      } else if (grainId === 'roasted_nuts_and_peanuts') {
        baseKst = 95;
        dustClass = 'St 1';
        saltationLimit = 12.5;
        grainFactor = 0.7;
      }

      // Burner Carbon Monoxide Generation
      let flueCo = 15;
      let afterburnerDestruction = 1.0; // 1.0 = no afterburner, 0.01 = 99% destruction
      let burnerMultiplier = 1.0;

      if (burnerId === 'automated_modulating_forced_draft') {
        burnerMultiplier = 0.8;
      } else if (burnerId === 'recirculating_convection_afterburner') {
        burnerMultiplier = 0.6;
        afterburnerDestruction = 0.02; // 98% destruction in oxidizer
      } else if (burnerId === 'atmospheric_inshot_manual_damper') {
        burnerMultiplier = 1.6;
      } else if (burnerId === 'corroded_uncleaned_draft_starved') {
        burnerMultiplier = 3.2;
      }

      // CO Kinetics: exponential rise as lambda drops below 1.05
      if (lambda >= 1.15) {
        flueCo = Math.round((12 + (tempC - 150) * 0.08) * burnerMultiplier);
      } else if (lambda >= 1.0) {
        flueCo = Math.round((35 + Math.pow((1.15 - lambda) * 10, 2) * 12) * burnerMultiplier);
      } else {
        // sub-stoichiometric
        flueCo = Math.round((150 + Math.pow((1.0 - lambda) * 20, 2.3) * 60) * burnerMultiplier);
      }

      flueCo = Math.round(flueCo * afterburnerDestruction);
      if (flueCo < 2) flueCo = 2;

      // Roastery Room Ambient CO Leakage Modeling
      // Assume a fugitive duct leak percentage (0.5% in modern, 4% in legacy)
      let fugitiveLeakFraction = (roasterId === 'aging_legacy_roaster_obstructed_flue') ? 0.045 : 0.008;
      let roasterCapacity = (roasterId === 'industrial_continuous_drum_roaster') ? 3000 : (roasterId === 'high_capacity_batch_drum_roaster' ? 480 : 180);
      let roomVolumeM3 = 650; // typical roastery bay
      let coLeakRateMgMin = flueCo * 1.15 * fugitiveLeakFraction * (roasterCapacity / 200);
      let steadyStateRoomCo = Math.round((coLeakRateMgMin / (roomVolumeM3 * (ach / 60))) * 0.85 * 10) / 10;
      if (steadyStateRoomCo < 0.5) steadyStateRoomCo = 0.5;

      // Chaff Kst Deflagration Index Scaling
      let effectiveKst = Math.round(baseKst * (1 + (tempC - 150) * 0.002) * (1 + (chaffBedKg / 50) * 0.25));

      // NFPA 68 Relief Vent Margin
      let ventMargin = 45;
      if (roasterId === 'industrial_continuous_drum_roaster') {
        ventMargin = Math.round(45 - (effectiveKst - 150) * 0.25);
      } else if (roasterId === 'high_capacity_batch_drum_roaster') {
        ventMargin = Math.round(20 - (effectiveKst - 150) * 0.3);
      } else if (roasterId === 'single_pass_direct_fired_roaster') {
        ventMargin = Math.round(-15 - (effectiveKst - 150) * 0.4);
      } else {
        ventMargin = Math.round(-65 - (effectiveKst - 150) * 0.5);
      }

      // Update UI Output Values
      if (outFlueCo) {
        outFlueCo.textContent = `${flueCo}`;
        outFlueCo.className = `text-2xl font-black font-mono ${flueCo > 100 ? 'text-red-700' : (flueCo > 40 ? 'text-amber-700' : 'text-emerald-700')}`;
      }
      if (flueCoBar) {
        const pct = Math.min(100, Math.round((flueCo / 250) * 100));
        flueCoBar.style.width = `${pct}%`;
        flueCoBar.className = `h-2 rounded-full transition-all ${flueCo > 100 ? 'bg-red-600' : (flueCo > 40 ? 'bg-amber-600' : 'bg-emerald-600')}`;
      }
      if (flueCoStatus) {
        flueCoStatus.textContent = flueCo > 100 ? 'Combustion Failure' : (flueCo > 40 ? 'Moderate Incomplete' : 'Clean Combustion');
      }

      if (outKst) {
        outKst.textContent = `${effectiveKst}`;
        outKst.className = `text-2xl font-black font-mono ${effectiveKst > 200 ? 'text-red-700' : (effectiveKst > 140 ? 'text-amber-700' : 'text-emerald-700')}`;
      }
      if (kstBar) {
        const kstPct = Math.min(100, Math.round((effectiveKst / 280) * 100));
        kstBar.style.width = `${kstPct}%`;
        kstBar.className = `h-2 rounded-full transition-all ${effectiveKst > 200 ? 'bg-red-600' : (effectiveKst > 140 ? 'bg-amber-600' : 'bg-emerald-600')}`;
      }

      if (outVelocity) {
        outVelocity.textContent = `${velocity.toFixed(1)}`;
        outVelocity.className = `text-2xl font-black font-mono ${velocity < saltationLimit ? 'text-red-700' : 'text-emerald-700'}`;
      }
      if (velocityBar) {
        const velPct = Math.min(100, Math.round((velocity / 28) * 100));
        velocityBar.style.width = `${velPct}%`;
        velocityBar.className = `h-2 rounded-full transition-all ${velocity < saltationLimit ? 'bg-red-600' : 'bg-emerald-600'}`;
      }
      if (saltationStatus) {
        saltationStatus.textContent = velocity < saltationLimit ? 'Sedimentation Fallout!' : 'Suspension Safe';
        saltationStatus.className = velocity < saltationLimit ? 'text-red-700 font-bold' : 'text-muted';
      }

      if (outRoomCo) {
        outRoomCo.textContent = `${steadyStateRoomCo.toFixed(1)}`;
        outRoomCo.className = `text-2xl font-black font-mono ${steadyStateRoomCo > 50 ? 'text-red-700' : (steadyStateRoomCo > 25 ? 'text-amber-700' : 'text-emerald-700')}`;
      }
      if (roomCoBar) {
        const roomPct = Math.min(100, Math.round((steadyStateRoomCo / 60) * 100));
        roomCoBar.style.width = `${roomPct}%`;
        roomCoBar.className = `h-2 rounded-full transition-all ${steadyStateRoomCo > 50 ? 'bg-red-600' : (steadyStateRoomCo > 25 ? 'bg-amber-600' : 'bg-emerald-600')}`;
      }
      if (roomCoStatus) {
        roomCoStatus.textContent = steadyStateRoomCo > 50 ? 'OSHA PEL Exceeded!' : (steadyStateRoomCo > 25 ? 'ACGIH TLV Warning' : 'Safe Ambient (<25 ppm)');
        roomCoStatus.className = steadyStateRoomCo > 50 ? 'text-red-700 font-bold' : 'text-muted';
      }

      if (outVentMargin) {
        outVentMargin.textContent = `${ventMargin > 0 ? '+' : ''}${ventMargin}%`;
        outVentMargin.className = `text-2xl font-black font-mono ${ventMargin < 0 ? 'text-red-700' : 'text-emerald-700'}`;
      }
      if (ventMarginBar) {
        const ventPct = Math.max(5, Math.min(100, Math.round(50 + ventMargin * 0.75)));
        ventMarginBar.style.width = `${ventPct}%`;
        ventMarginBar.className = `h-2 rounded-full transition-all ${ventMargin < 0 ? 'bg-red-600' : 'bg-emerald-600'}`;
      }
      if (ventStatus) {
        ventStatus.textContent = ventMargin < 0 ? 'Undersized Relief!' : 'NFPA 68 Sized OK';
        ventStatus.className = ventMargin < 0 ? 'text-red-700 font-bold' : 'text-muted';
      }

      // Global Safety Classification Status
      let isExplosionDanger = (velocity < saltationLimit && effectiveKst > 140) || ventMargin < -20;
      let isCoDanger = flueCo > 120 || steadyStateRoomCo > 35;

      if (isCoDanger && isExplosionDanger) {
        if (safetyBadge) {
          safetyBadge.textContent = 'CRITICAL_HAZARD_EXPLOSION_AND_CO';
          safetyBadge.className = 'px-3.5 py-1.5 rounded-full text-xs font-bold tracking-wide uppercase bg-red-100 text-red-900 border border-red-400';
        }
        if (complianceLabel) complianceLabel.textContent = 'NON-COMPLIANT: Severe Deflagration & Toxic Inversion Risk';
        if (complianceDetail) complianceDetail.textContent = 'Low duct transport velocity precipitates combustible chaff into horizontal fire beds, while sub-stoichiometric combustion pumps hazardous carbon monoxide into workplace breathing zones.';
        if (hazardDetail) hazardDetail.textContent = 'Acute carbon monoxide asphyxiation hazard coupled with high-severity St 1/St 2 organic dust deflagration in unvented collector cyclone.';
      } else if (isExplosionDanger) {
        if (safetyBadge) {
          safetyBadge.textContent = 'CHAFF_DUST_DEFLAGRATION_DANGER';
          safetyBadge.className = 'px-3.5 py-1.5 rounded-full text-xs font-bold tracking-wide uppercase bg-rose-100 text-rose-900 border border-rose-400';
        }
        if (complianceLabel) complianceLabel.textContent = 'VIOLATION: Sub-Saltation Velocity & Deficient NFPA 68 Venting';
        if (complianceDetail) complianceDetail.textContent = 'Exhaust duct air speed is insufficient to transport chaff flakes. In-flight burner sparks can trigger primary duct deflagrations and burst uncertified cyclone housings.';
        if (hazardDetail) hazardDetail.textContent = 'Primary and secondary organic dust explosions. Cyclone housing rupture and shrapnel propagation into production facility.';
      } else if (isCoDanger) {
        if (safetyBadge) {
          safetyBadge.textContent = 'CARBON_MONOXIDE_INVERSION_ALERT';
          safetyBadge.className = 'px-3.5 py-1.5 rounded-full text-xs font-bold tracking-wide uppercase bg-amber-100 text-amber-900 border border-amber-400';
        }
        if (complianceLabel) complianceLabel.textContent = 'WARNING: Flue CO Exceeds Safe Thresholds (Air Starvation)';
        if (complianceDetail) complianceDetail.textContent = 'Burner excess air ratio (λ) is depressed. Flue gas carbon monoxide levels exceed 50 ppm, requiring immediate burner trim compensation or ventilation shutdown interlock.';
        if (hazardDetail) hazardDetail.textContent = 'Chronic workplace carbon monoxide poisoning, operator cognitive impairment, and possible carboxyhemoglobin saturation.';
      } else {
        if (safetyBadge) {
          safetyBadge.textContent = 'COMPLIANT_SAFE_NFPA_61_86';
          safetyBadge.className = 'px-3.5 py-1.5 rounded-full text-xs font-bold tracking-wide uppercase bg-emerald-100 text-emerald-800 border border-emerald-300';
        }
        if (complianceLabel) complianceLabel.textContent = '100% Process Safety & Life Safety Compliance';
        if (complianceDetail) complianceDetail.textContent = 'Burner combustion operates cleanly at optimal excess air. Exhaust air speed maintains complete chaff pneumatic suspension with verified NFPA 68 relief panels.';
        if (hazardDetail) hazardDetail.textContent = 'Controlled thermal processing. Organic chaff deflagration mitigated by spark detection, deluge mist nozzles, and magnetic outdoor relief venting.';
      }

      if (mechanismsDetail) {
        mechanismsDetail.textContent = `Combustion air ratio λ = ${lambda.toFixed(2)} produces ${flueCo} ppm flue CO. Transport air velocity (${velocity.toFixed(1)} m/s vs ${saltationLimit.toFixed(1)} m/s limit) ${velocity >= saltationLimit ? 'prevents' : 'causes'} chaff settling. Cyclone vent margin is ${ventMargin > 0 ? '+' : ''}${ventMargin}%.`;
      }
    }

    // Presets Handlers
    document.getElementById('preset-coffee-btn')?.addEventListener('click', () => {
      roasterSelect.value = 'industrial_continuous_drum_roaster';
      grainSelect.value = 'arabica_robusta_coffee_beans';
      burnerSelect.value = 'automated_modulating_forced_draft';
      tempSlider.value = '220';
      lambdaSlider.value = '1.25';
      velocitySlider.value = '22.5';
      chaffBedSlider.value = '10';
      ventilationSlider.value = '15.0';
      coAlarmSlider.value = '35';
      recalculate();
    });

    document.getElementById('preset-malt-btn')?.addEventListener('click', () => {
      roasterSelect.value = 'single_pass_direct_fired_roaster';
      grainSelect.value = 'malted_barley_specialty_grains';
      burnerSelect.value = 'atmospheric_inshot_manual_damper';
      tempSlider.value = '225';
      lambdaSlider.value = '1.05';
      velocitySlider.value = '12.0';
      chaffBedSlider.value = '35';
      ventilationSlider.value = '4.0';
      coAlarmSlider.value = '100';
      recalculate();
    });

    document.getElementById('preset-co-btn')?.addEventListener('click', () => {
      roasterSelect.value = 'aging_legacy_roaster_obstructed_flue';
      grainSelect.value = 'arabica_robusta_coffee_beans';
      burnerSelect.value = 'corroded_uncleaned_draft_starved';
      tempSlider.value = '240';
      lambdaSlider.value = '0.90';
      velocitySlider.value = '8.5';
      chaffBedSlider.value = '45';
      ventilationSlider.value = '2.0';
      coAlarmSlider.value = '150';
      recalculate();
    });

    document.getElementById('preset-cocoa-btn')?.addEventListener('click', () => {
      roasterSelect.value = 'high_capacity_batch_drum_roaster';
      grainSelect.value = 'fermented_cocoa_beans';
      burnerSelect.value = 'recirculating_convection_afterburner';
      tempSlider.value = '155';
      lambdaSlider.value = '1.20';
      velocitySlider.value = '20.0';
      chaffBedSlider.value = '8';
      ventilationSlider.value = '14.0';
      coAlarmSlider.value = '35';
      recalculate();
    });

    // Copy Telemetry Report to Clipboard
    copyBtn?.addEventListener('click', () => {
      const report = `======================================================================
ISITKITCHENSAFE DRUM ROASTER CO & CHAFF DEFLAGRATION TELEMETRY REPORT
Standard: NFPA 61, NFPA 86 & OSHA 29 CFR 1910.1200
Generated: ${new Date().toISOString()}
======================================================================
[EQUIPMENT ARCHITECTURE]
- Roaster Model: ${roasterSelect.value}
- Grain Commodity: ${grainSelect.value}
- Burner System: ${burnerSelect.value}
- Core Drum Temperature: ${tempSlider.value}°C (${Math.round(parseFloat(tempSlider.value) * 9/5 + 32)}°F)
- Excess Air Ratio (λ): ${lambdaSlider.value}

[COMBUSTION & FLUE GAS DIAGNOSTICS]
- Flue Gas CO Concentration: ${outFlueCo?.textContent} ppm
- Chaff Dust Deflagration Index (Kst): ${outKst?.textContent} bar·m/s
- Duct Air Transport Velocity: ${velocitySlider.value} m/s
- Roastery Workplace CO Infiltration: ${outRoomCo?.textContent} ppm
- NFPA 68 Relief Vent Margin: ${outVentMargin?.textContent}
- Overall Life-Safety Status: ${safetyBadge?.textContent}
======================================================================`;

      navigator.clipboard.writeText(report).then(() => {
        if (copyBtnText) copyBtnText.textContent = "Copied to Clipboard!";
        setTimeout(() => {
          if (copyBtnText) copyBtnText.textContent = "Copy Telemetry Report to Clipboard";
        }, 2500);
      }).catch(() => {
        alert("Report ready in console.");
      });
    });

    // Attach Event Listeners
    [roasterSelect, grainSelect, burnerSelect].forEach(el => el?.addEventListener('change', recalculate));
    [tempSlider, lambdaSlider, velocitySlider, chaffBedSlider, ventilationSlider, coAlarmSlider].forEach(el => el?.addEventListener('input', recalculate));

    // Initial calculation
    recalculate();
  }

  // Execute on initial load and client-side page transitions
  initDrumRoasterModeler();
  document.addEventListener('astro:page-load', initDrumRoasterModeler);
</script>
