  <!-- Scientific Breakdown & Mathematical Principles -->
  <div class="mb-10 bg-canvas p-6 sm:p-8 rounded-2xl border border-hairline shadow-2xs">
    <div class="mb-6">
      <h3 class="text-lg font-bold text-ink mb-1">{d.scienceTitle}</h3>
