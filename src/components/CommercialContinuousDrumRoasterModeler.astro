const d = DICTIONARY[lang] || DICTIONARY.en;
const data = roasterData;
---

<div class="bg-surface-soft border border-hairline rounded-3xl p-6 sm:p-8 md:p-10 shadow-sm max-w-5xl mx-auto my-8 font-sans">
  <!-- Header Banner -->
  <div class="mb-8 border-b border-hairline/80 pb-6">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold tracking-wide uppercase bg-amber-700/10 text-amber-900 mb-3 border border-amber-700/20">
      <span class="w-2 h-2 rounded-full bg-amber-700 animate-pulse"></span>
      {d.badge}
    </div>
    <h2 class="text-2xl sm:text-3xl font-extrabold text-ink tracking-tight mb-3">
      {d.title}
    </h2>
    <p class="text-body text-sm sm:text-base leading-relaxed max-w-3xl">
      {d.subtitle}
    </p>
  </div>

  <!-- Operational Presets -->
  <div class="mb-8 bg-surface-strong/60 p-4 rounded-2xl border border-hairline">
    <h3 class="text-xs font-bold text-muted uppercase tracking-wider mb-3">
      {d.presetsTitle}
    </h3>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
      <button 
        type="button" 
        id="preset-coffee-btn" 
        class="text-left px-3.5 py-2.5 rounded-xl border border-hairline bg-canvas hover:bg-amber-700 hover:text-white transition-all font-medium text-ink shadow-2xs"
      >
        ☕ {d.presetCoffee}
      </button>
      <button 
        type="button" 
        id="preset-malt-btn" 
        class="text-left px-3.5 py-2.5 rounded-xl border border-hairline bg-canvas hover:bg-rose-700 hover:text-white transition-all font-medium text-ink shadow-2xs"
      >
        🌾 {d.presetMaltExplosion}
      </button>
      <button 
        type="button" 
        id="preset-co-btn" 
        class="text-left px-3.5 py-2.5 rounded-xl border border-hairline bg-canvas hover:bg-red-800 hover:text-white transition-all font-medium text-ink shadow-2xs"
      >
        ⚠️ {d.presetCoInversion}
      </button>
      <button 
        type="button" 
        id="preset-cocoa-btn" 
        class="text-left px-3.5 py-2.5 rounded-xl border border-hairline bg-canvas hover:bg-emerald-700 hover:text-white transition-all font-medium text-ink shadow-2xs"
      >
        🍫 {d.presetCocoaClean}
      </button>
    </div>
  </div>

  <!-- Interactive Controls Form -->
  <div class="mb-10 bg-canvas p-6 sm:p-8 rounded-2xl border border-hairline shadow-2xs">
    <div class="mb-6">
      <h3 class="text-lg font-bold text-ink mb-1">{d.controlsTitle}</h3>
      <p class="text-xs text-muted leading-relaxed">{d.controlsSub}</p>
    </div>

    <div class="space-y-6">
      <!-- Roaster Architecture Selector -->
      <div>
        <label for="roaster-select" class="block text-xs font-bold text-ink uppercase tracking-wider mb-1">
          {d.equipLabel}
        </label>
        <select 
          id="roaster-select" 
          class="w-full bg-surface-soft border border-hairline rounded-xl p-3 text-sm text-ink font-medium focus:ring-2 focus:ring-amber-700 focus:outline-hidden"
        >
          {data.roasterArchitectures.map((roaster) => (
            <option value={roaster.id}>
              {roaster.name}
            </option>
          ))}
        </select>
