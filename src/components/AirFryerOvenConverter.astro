---
import rawData from '../data/air-fryer-oven-converter-data.json';
import type { SupportedLanguage } from '../i18n/ui';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;

const defaultUnit = lang === 'en' ? 'F' : 'C';

const localizedGasMarks = rawData.gasMarks.map((g) => ({
  mark: g.mark,
  numericValue: g.numericValue,
  tempF: g.tempF,
  tempCConventional: g.tempCConventional,
  tempCFan: g.tempCFan,
  level: (g.level as Record<string, string>)[lang] || g.level.en
}));

const localizedPresets = rawData.presets.map((p) => {
  const tr = (p.i18n as Record<string, any>)[lang] || p.i18n.en;
  return {
    id: p.id,
    icon: p.icon,
    ovenTempF: p.ovenTempF,
    ovenTempC: p.ovenTempC,
    ovenTimeMin: p.ovenTimeMin,
    airFryerTempF: p.airFryerTempF,
    airFryerTempC: p.airFryerTempC,
    airFryerTimeMin: p.airFryerTimeMin,
    usdaSafeTempF: p.usdaSafeTempF,
    usdaSafeTempC: p.usdaSafeTempC,
    shakeFlipAtPct: p.shakeFlipAtPct,
    recommendedLiner: p.recommendedLiner,
    name: tr.name,
    usdaLabel: tr.usdaLabel,
    afAdjustment: tr.afAdjustment,
    shakeFlip: tr.shakeFlip,
    linerNote: tr.linerNote
  };
});

const localizedThresholds = rawData.cookwareThresholds.map((c) => {
  const tr = (c.i18n as Record<string, any>)[lang] || c.i18n.en;
  return {
    id: c.id,
    maxRangeF: c.maxRangeF,
    maxRangeC: c.maxRangeC,
    cautionF: c.cautionF,
    hazardF: c.hazardF,
    name: tr.name,
    risk: tr.risk
  };
});

const localizedLiners = rawData.linerOptions.map((l) => {
  const tr = (l.i18n as Record<string, any>)[lang] || l.i18n.en;
  return {
    id: l.id,
    cautionF: l.cautionF,
    hazardF: l.hazardF,
    maxLabelF: l.maxLabelF,
    name: tr.name,
    safeTitle: tr.safeTitle,
    safeBody: tr.safeBody,
    cautionTitle: tr.cautionTitle,
    cautionBody: tr.cautionBody,
    hazardTitle: tr.hazardTitle,
    hazardBody: tr.hazardBody
  };
});

