    <circle cx="32" cy="32" r="3.5" fill="currentColor"/>
  </svg>`
};

// Build localized symbols list
const localizedSymbols: LocalizedSymbol[] = decoderData.symbols.map((raw: any) => {
  const tr = lang !== 'en' && raw.translations && raw.translations[lang] ? raw.translations[lang] : null;
  const localizedLink = translatePath(raw.relatedLink);
  return {
    id: raw.id,
    category: raw.category,
    code: raw.code,
    name: tr?.name || raw.name,
    shortMeaning: tr?.shortMeaning || raw.shortMeaning,
    svgKey: raw.svgKey,
    maxTempF: raw.maxTempF,
    maxTempC: raw.maxTempC,
    tempMode: raw.tempMode || 'max',
    tempDepends: Boolean(raw.tempDepends),
    verdicts: raw.verdicts,
    safetyExplanation: tr?.safetyExplanation || raw.safetyExplanation,
    watchOutFor: tr?.watchOutFor || raw.watchOutFor,
    commonItems: tr?.commonItems || raw.commonItems,
    relatedLink: localizedLink,
    searchKeywords: Array.from(new Set([...(raw.searchKeywords || []), ...(tr?.searchKeywords || []), raw.code.toLowerCase()]))
  };
});

// Default initially selected symbol (#5 PP - most searched!)
const defaultSymbol = localizedSymbols.find(s => s.id === 'pp-5') || localizedSymbols[0];

const categoryCounts: Record<CategoryKey, number> = {
  all: localizedSymbols.length,
  'plastic-resin': localizedSymbols.filter(s => s.category === 'plastic-resin').length,
  appliance: localizedSymbols.filter(s => s.category === 'appliance').length,
  cooktop: localizedSymbols.filter(s => s.category === 'cooktop').length,
  care: localizedSymbols.filter(s => s.category === 'care').length
};

const coreApplianceLinks = [
  { key: 'dishwasher', label: ui.appliances.dishwasher, href: getApplianceUrl('dishwasher', lang) },
  { key: 'microwave', label: ui.appliances.microwave, href: getApplianceUrl('microwave', lang) },
  { key: 'oven', label: ui.appliances.oven, href: getApplianceUrl('oven', lang) },
  { key: 'freezer', label: ui.appliances.freezer, href: getApplianceUrl('freezer', lang) },
  { key: 'airfryer', label: ui.appliances.airfryer, href: getApplianceUrl('airfryer', lang) }
];

const clientPayload = {
  symbols: localizedSymbols,
  svgMap: SVG_MAP,
  ui: {
    showingPrefix: ui.showingPrefix,
    showingOf: ui.showingOf,
    symbolsUnit: ui.symbolsUnit,
    maxTempLabel: ui.maxTempLabel,
    minTempLabel: ui.minTempLabel,
    dependsTempLabel: ui.dependsTempLabel,
    verdictLabels: ui.verdictLabels,
    appliances: ui.appliances,
    categoryNames: ui.categoryNames,
    copyVerdictBtn: ui.copyVerdictBtn,
    copiedVerdictBtn: ui.copiedVerdictBtn
  }
};

function getBadgeClass(val: VerdictVal): string {
  if (val === 'yes') return 'bg-green-100 text-green-900 dark:bg-emerald-950/70 dark:text-emerald-300 border border-green-300 dark:border-emerald-700';
  if (val === 'depends') return 'bg-amber-100 text-amber-900 dark:bg-amber-950/70 dark:text-amber-300 border border-amber-300 dark:border-amber-700';
  return 'bg-red-100 text-red-900 dark:bg-red-950/70 dark:text-red-300 border border-red-300 dark:border-red-700';
}

function formatTempString(sym: LocalizedSymbol): string {
  if (sym.tempMode === 'min') {
    return `${sym.maxTempF}°F / ${sym.maxTempC}°C`;
  }
  if (sym.tempDepends) {
    return `~${sym.maxTempF}°F / ${sym.maxTempC}°C*`;
  }
  return `${sym.maxTempF}°F / ${sym.maxTempC}°C`;
}

function getTempLabel(sym: LocalizedSymbol): string {
  if (sym.tempMode === 'min') return ui.minTempLabel;
  if (sym.tempDepends) return ui.dependsTempLabel;
  return ui.maxTempLabel;
}
---

<section
  id="kitchen-symbol-decoder-app"
  class="bg-canvas border border-hairline rounded-2xl shadow-sm overflow-hidden"
  aria-label="Kitchen Bottom Symbol Decoder"
>
  <!-- Top Controls: Search + Quick Picks + Category Filter Tabs -->
  <div class="p-5 md:p-6 bg-surface-soft border-b border-hairline space-y-4">
    <!-- Search Input -->
    <div class="relative">
      <div class="pointer-events-none absolute inset-y-0 left-0 pl-3.5 flex items-center text-muted">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m1.85-5.15a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
      <input
        id="ksd-search-input"
        type="search"
        autocomplete="off"
        placeholder={ui.searchPlaceholder}
        aria-label={ui.searchAria}
        class="w-full h-12 pl-11 pr-20 rounded-xl bg-canvas border border-hairline text-ink placeholder:text-muted/80 text-[15px] focus:outline-none focus:ring-2 focus:ring-signature-coral/40 focus:border-signature-coral transition-all"
      />
      <button
        id="ksd-clear-search"
        type="button"
        class="hidden absolute right-2.5 top-1/2 -translate-y-1/2 px-2.5 py-1 rounded-lg text-xs font-semibold bg-surface-strong text-ink hover:opacity-85 transition-opacity cursor-pointer"
      >
        {ui.clearSearch}
      </button>
    </div>

    <!-- Popular Quick-Search Chips -->
    <div class="flex flex-wrap items-center gap-2 text-xs">
      <span class="text-muted font-semibold">{ui.quickPicksLabel}</span>
      {ui.quickPicks.map(chip => (
        <button
          type="button"
          data-ksd-quick={chip.query}
          class="px-2.5 py-1 rounded-full bg-canvas border border-hairline text-body hover:text-ink hover:border-signature-coral transition-colors cursor-pointer font-medium"
        >
          {chip.label}
        </button>
      ))}
    </div>

    <!-- Category Filter Tabs -->
    <div class="flex flex-wrap items-center gap-2 pt-1" role="tablist" aria-label="Symbol categories">
      {(['all', 'plastic-resin', 'appliance', 'cooktop', 'care'] as CategoryKey[]).map(cat => (
        <button
          type="button"
          role="tab"
          aria-selected={cat === 'all' ? 'true' : 'false'}
          data-ksd-cat={cat}
          class={`ksd-tab-btn inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg text-xs sm:text-[13px] font-semibold transition-all cursor-pointer border ${
            cat === 'all'
              ? 'bg-primary text-on-primary border-primary shadow-xs'
              : 'bg-canvas text-body border-hairline hover:text-ink hover:border-border-strong'
          }`}
        >
          <span>{ui.tabs[cat]}</span>
          <span class={`text-[11px] px-1.5 py-0.5 rounded-full ${cat === 'all' ? 'bg-white/20 text-on-primary' : 'bg-surface-soft text-muted'}`}>
            {categoryCounts[cat]}
          </span>
        </button>
      ))}
    </div>

    <!-- Live Count Bar -->
    <div class="flex items-center justify-between text-xs text-muted pt-0.5">
      <p id="ksd-count-status" aria-live="polite">
        {ui.showingPrefix} <strong class="text-ink">{localizedSymbols.length}</strong> {ui.showingOf} {localizedSymbols.length} {ui.symbolsUnit}
      </p>
    </div>
  </div>

  <!-- Main Workspace: Symbol Picker Grid + Sticky Instant Safety Verdict Panel -->
  <div class="p-5 md:p-6 grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
    <!-- Left Column: Visual Symbol Grid -->
    <div id="ksd-grid-anchor" class="lg:col-span-7">
      <div id="ksd-symbol-grid" class="grid grid-cols-2 sm:grid-cols-3 gap-3">
        {localizedSymbols.map(sym => {
          const isSelected = sym.id === defaultSymbol.id;
          return (
            <button
              type="button"
              data-ksd-id={sym.id}
              data-ksd-category={sym.category}
              aria-pressed={isSelected ? 'true' : 'false'}
              class={`ksd-symbol-card group text-left p-3.5 rounded-xl border transition-all cursor-pointer flex flex-col items-center text-center gap-2 focus:outline-none focus:ring-2 focus:ring-signature-coral ${
                isSelected
                  ? 'bg-surface-soft border-signature-coral ring-2 ring-signature-coral/30 shadow-sm'
                  : 'bg-canvas border-hairline hover:border-border-strong hover:bg-surface-soft/70'
              }`}
            >
              <div class="w-14 h-14 flex items-center justify-center text-ink group-hover:scale-105 transition-transform" set:html={SVG_MAP[sym.svgKey]} />
              <span class="inline-block px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-surface-strong/70 text-ink">
                {sym.code}
              </span>
              <span class="text-[12.5px] font-semibold text-ink leading-snug line-clamp-2">
                {sym.name}
              </span>
              <!-- Mini 3-dot glance for Microwave / Dishwasher / Oven -->
              <div class="flex items-center gap-1.5 mt-auto pt-1 text-[10px] text-muted" aria-hidden="true">
                <span class={`w-2 h-2 rounded-full ${sym.verdicts.dishwasher === 'yes' ? 'bg-green-600' : sym.verdicts.dishwasher === 'depends' ? 'bg-amber-500' : 'bg-red-600'}`} title={ui.appliances.dishwasher}></span>
                <span class={`w-2 h-2 rounded-full ${sym.verdicts.microwave === 'yes' ? 'bg-green-600' : sym.verdicts.microwave === 'depends' ? 'bg-amber-500' : 'bg-red-600'}`} title={ui.appliances.microwave}></span>
                <span class={`w-2 h-2 rounded-full ${sym.verdicts.oven === 'yes' ? 'bg-green-600' : sym.verdicts.oven === 'depends' ? 'bg-amber-500' : 'bg-red-600'}`} title={ui.appliances.oven}></span>
                <span class={`w-2 h-2 rounded-full ${sym.verdicts.freezer === 'yes' ? 'bg-green-600' : sym.verdicts.freezer === 'depends' ? 'bg-amber-500' : 'bg-red-600'}`} title={ui.appliances.freezer}></span>
              </div>
            </button>
          );
        })}
      </div>

      <!-- Empty Search State -->
      <div id="ksd-empty-state" class="hidden py-12 px-6 text-center bg-surface-soft border border-dashed border-hairline rounded-xl">
        <p class="text-base font-semibold text-ink mb-1.5">{ui.noResultsTitle}</p>
        <p class="text-xs sm:text-sm text-muted max-w-md mx-auto mb-4">{ui.noResultsBody}</p>
        <button
          id="ksd-reset-filters"
          type="button"
          class="px-4 py-2 rounded-lg text-xs font-semibold bg-primary text-on-primary hover:bg-primary-active transition-colors cursor-pointer"
        >
          {ui.resetFilters}
        </button>
      </div>
    </div>

    <!-- Right Column: Sticky Instant Safety Verdict Panel -->
    <aside
      id="ksd-verdict-panel"
      aria-live="polite"
      class="lg:col-span-5 lg:sticky lg:top-[84px] bg-surface-soft border border-hairline rounded-2xl p-5 md:p-6 space-y-5 shadow-xs"
    >
      <!-- Panel Top Bar -->
      <div class="flex items-center justify-between gap-2">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-signature-coral text-white">
          {ui.verdictPanelBadge}
        </span>
        <button
          id="ksd-scroll-grid"
          type="button"
          class="lg:hidden text-xs font-semibold text-link hover:underline cursor-pointer"
        >
          {ui.pickAnotherBtn}
        </button>
      </div>

      <!-- Enlarged Visual + Name + Max Temp -->
      <div class="flex items-start gap-4">
        <div
          id="ksd-v-svg"
          class="w-20 h-20 shrink-0 p-2.5 rounded-xl bg-canvas border border-hairline text-ink flex items-center justify-center shadow-2xs"
          set:html={SVG_MAP[defaultSymbol.svgKey]}
        />
        <div class="min-w-0 flex-1 space-y-1.5">
          <div class="flex flex-wrap items-center gap-1.5">
            <span id="ksd-v-code" class="px-2 py-0.5 rounded text-[11px] font-bold uppercase tracking-wider bg-primary text-on-primary">
              {defaultSymbol.code}
            </span>
            <span id="ksd-v-cat" class="px-2 py-0.5 rounded text-[11px] font-semibold bg-canvas border border-hairline text-muted">
              {ui.categoryNames[defaultSymbol.category]}
            </span>
          </div>
          <h2 id="ksd-v-name" class="text-[18px] font-semibold text-ink leading-snug">
            {defaultSymbol.name}
          </h2>
          <p id="ksd-v-short" class="text-[13px] text-body leading-relaxed">
            {defaultSymbol.shortMeaning}
          </p>
        </div>
      </div>

      <!-- Temperature Rating Strip -->
      <div class="flex items-center justify-between gap-3 px-3.5 py-2.5 rounded-xl bg-canvas border border-hairline text-xs">
        <span id="ksd-v-temp-label" class="font-semibold text-muted uppercase tracking-wider text-[11px]">
          {getTempLabel(defaultSymbol)}
        </span>
        <span id="ksd-v-temp-val" class="font-bold text-ink text-sm">
          {formatTempString(defaultSymbol)}
        </span>
      </div>

      <!-- 5-Appliance Compatibility Matrix -->
      <div class="space-y-2.5">
        <h3 class="text-xs font-bold uppercase tracking-wider text-muted">
          {ui.matrixTitle}
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-1 gap-2" id="ksd-v-matrix">
          {(['dishwasher', 'microwave', 'oven', 'freezer', 'airfryer'] as const).map(appKey => {
            const verdict = defaultSymbol.verdicts[appKey];
            return (
              <div class="flex items-center justify-between px-3 py-2 rounded-lg bg-canvas border border-hairline">
                <span class="text-[13px] font-medium text-ink">{ui.appliances[appKey]}</span>
                <span
                  data-ksd-verdict-app={appKey}
                  class={`px-2.5 py-0.5 rounded-full text-[11px] font-bold tracking-wide ${getBadgeClass(verdict)}`}
                >
                  {ui.verdictLabels[verdict]}
                </span>
              </div>
            );
          })}
        </div>
      </div>

      <!-- Plain-English Explanation -->
      <div class="space-y-1.5">
        <h3 class="text-xs font-bold uppercase tracking-wider text-ink">
          {ui.meaningHeading}
        </h3>
        <p id="ksd-v-explanation" class="text-[13.5px] text-body leading-relaxed">
          {defaultSymbol.safetyExplanation}
        </p>
      </div>

      <!-- Chemical / Heat Risk Warning Callout -->
      <div class="p-3.5 rounded-xl bg-warning-bg border border-warning-border/70 space-y-1">
        <h3 class="text-xs font-bold uppercase tracking-wider text-warning flex items-center gap-1.5">
          <span aria-hidden="true">⚠️</span>
          <span>{ui.warningHeading}</span>
        </h3>
        <p id="ksd-v-watchout" class="text-[13px] text-ink/90 leading-relaxed">
          {defaultSymbol.watchOutFor}
        </p>
      </div>

      <!-- Common Items Carrying This Mark -->
      <div class="space-y-2">
        <h3 class="text-xs font-bold uppercase tracking-wider text-muted">
          {ui.commonItemsHeading}
        </h3>
        <div id="ksd-v-items" class="flex flex-wrap gap-1.5">
          {defaultSymbol.commonItems.map(item => (
            <span class="px-2.5 py-1 rounded-md text-xs bg-canvas border border-hairline text-body font-medium">
              {item}
            </span>
          ))}
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center gap-2.5 pt-2 border-t border-hairline">
        <a
          id="ksd-v-link"
          href={defaultSymbol.relatedLink}
          class="flex-1 min-w-[180px] inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-xl text-xs font-semibold bg-primary hover:bg-primary-active text-on-primary transition-colors text-center"
        >
          <span>{ui.readGuideBtn}</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
        <button
          id="ksd-copy-verdict"
          type="button"
          class="inline-flex items-center justify-center gap-1.5 px-3.5 py-2.5 rounded-xl text-xs font-semibold bg-canvas border border-hairline text-ink hover:bg-surface-strong/50 transition-colors cursor-pointer"
        >
          <span>{ui.copyVerdictBtn}</span>
        </button>
      </div>

      <!-- Core Appliance Hub Links -->
      <div class="pt-2 border-t border-hairline/70 space-y-2">
        <p class="text-[11px] font-bold uppercase tracking-wider text-muted">
          {ui.coreHubsHeading}
        </p>
        <div class="flex flex-wrap gap-1.5">
          {coreApplianceLinks.map(hub => (
            <a
              href={hub.href}
              class="px-2.5 py-1 rounded-full text-[11.5px] font-medium bg-canvas border border-hairline text-link hover:border-link transition-colors"
            >
              {hub.label}
            </a>
          ))}
        </div>
      </div>
    </aside>
  </div>
</section>

<!-- Embedded JSON Payload for Client Interactivity -->
<script is:inline id="ksd-payload" type="application/json" set:html={JSON.stringify(clientPayload)} />

<script is:inline>
  (function () {
    const payloadEl = document.getElementById('ksd-payload');
    if (!payloadEl) return;

    let data;
    try {
      data = JSON.parse(payloadEl.textContent || '{}');
    } catch (_) {
      return;
    }

    const symbols = data.symbols || [];
    const svgMap = data.svgMap || {};
    const ui = data.ui || {};
    const byId = new Map(symbols.map((s) => [s.id, s]));

    const searchInput = document.getElementById('ksd-search-input');
    const clearBtn = document.getElementById('ksd-clear-search');
    const resetBtn = document.getElementById('ksd-reset-filters');
    const countStatus = document.getElementById('ksd-count-status');
    const emptyState = document.getElementById('ksd-empty-state');
    const gridEl = document.getElementById('ksd-symbol-grid');
    const gridAnchor = document.getElementById('ksd-grid-anchor');
    const verdictPanel = document.getElementById('ksd-verdict-panel');
    const scrollGridBtn = document.getElementById('ksd-scroll-grid');
    const copyBtn = document.getElementById('ksd-copy-verdict');

    const tabButtons = Array.from(document.querySelectorAll('.ksd-tab-btn'));
    const cardButtons = Array.from(document.querySelectorAll('.ksd-symbol-card'));
    const quickPickButtons = Array.from(document.querySelectorAll('[data-ksd-quick]'));

    const vSvg = document.getElementById('ksd-v-svg');
    const vCode = document.getElementById('ksd-v-code');
    const vCat = document.getElementById('ksd-v-cat');
    const vName = document.getElementById('ksd-v-name');
    const vShort = document.getElementById('ksd-v-short');
    const vTempLabel = document.getElementById('ksd-v-temp-label');
    const vTempVal = document.getElementById('ksd-v-temp-val');
    const vExplanation = document.getElementById('ksd-v-explanation');
    const vWatchout = document.getElementById('ksd-v-watchout');
    const vItems = document.getElementById('ksd-v-items');
    const vLink = document.getElementById('ksd-v-link');

    let activeCategory = 'all';
    let searchQuery = '';
    let selectedId = 'pp-5';

    function getBadgeClasses(val) {
      if (val === 'yes') {
        return 'px-2.5 py-0.5 rounded-full text-[11px] font-bold tracking-wide bg-green-100 text-green-900 dark:bg-emerald-950/70 dark:text-emerald-300 border border-green-300 dark:border-emerald-700';
      }
      if (val === 'depends') {
        return 'px-2.5 py-0.5 rounded-full text-[11px] font-bold tracking-wide bg-amber-100 text-amber-900 dark:bg-amber-950/70 dark:text-amber-300 border border-amber-300 dark:border-amber-700';
      }
      return 'px-2.5 py-0.5 rounded-full text-[11px] font-bold tracking-wide bg-red-100 text-red-900 dark:bg-red-950/70 dark:text-red-300 border border-red-300 dark:border-red-700';
    }

    function normalizeStr(str) {
      return (str || '')
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '');
    }

    function selectSymbol(id, shouldScrollMobile) {
      const sym = byId.get(id);
      if (!sym) return;
      selectedId = id;

      // Update active card styles
      cardButtons.forEach((btn) => {
        const isAct = btn.getAttribute('data-ksd-id') === id;
        btn.setAttribute('aria-pressed', isAct ? 'true' : 'false');
        if (isAct) {
          btn.classList.add('bg-surface-soft', 'border-signature-coral', 'ring-2', 'ring-signature-coral/30', 'shadow-sm');
          btn.classList.remove('bg-canvas', 'border-hairline');
        } else {
          btn.classList.remove('bg-surface-soft', 'border-signature-coral', 'ring-2', 'ring-signature-coral/30', 'shadow-sm');
          btn.classList.add('bg-canvas', 'border-hairline');
        }
      });

      // Populate verdict panel
      if (vSvg) vSvg.innerHTML = svgMap[sym.svgKey] || '';
      if (vCode) vCode.textContent = sym.code;
      if (vCat) vCat.textContent = (ui.categoryNames && ui.categoryNames[sym.category]) || sym.category;
      if (vName) vName.textContent = sym.name;
      if (vShort) vShort.textContent = sym.shortMeaning;

      if (vTempLabel) {
        if (sym.tempMode === 'min') vTempLabel.textContent = ui.minTempLabel;
        else if (sym.tempDepends) vTempLabel.textContent = ui.dependsTempLabel;
        else vTempLabel.textContent = ui.maxTempLabel;
      }
      if (vTempVal) {
        const prefix = sym.tempDepends ? '~' : '';
        const suffix = sym.tempDepends ? '*' : '';
        vTempVal.textContent = `${prefix}${sym.maxTempF}°F / ${sym.maxTempC}°C${suffix}`;
      }

      ['dishwasher', 'microwave', 'oven', 'freezer', 'airfryer'].forEach((appKey) => {
        const badgeEl = document.querySelector(`[data-ksd-verdict-app="${appKey}"]`);
        if (!badgeEl) return;
        const val = sym.verdicts[appKey];
        badgeEl.className = getBadgeClasses(val);
        badgeEl.textContent = (ui.verdictLabels && ui.verdictLabels[val]) || val;
      });

      if (vExplanation) vExplanation.textContent = sym.safetyExplanation;
      if (vWatchout) vWatchout.textContent = sym.watchOutFor;

      if (vItems) {
        vItems.innerHTML = '';
        (sym.commonItems || []).forEach((itemText) => {
          const span = document.createElement('span');
          span.className = 'px-2.5 py-1 rounded-md text-xs bg-canvas border border-hairline text-body font-medium';
          span.textContent = itemText;
          vItems.appendChild(span);
        });
      }

      if (vLink) vLink.setAttribute('href', sym.relatedLink || '/');

      // Update URL query param cleanly without scroll jump
      try {
        const url = new URL(window.location.href);
        url.searchParams.set('symbol', id);
        window.history.replaceState({}, '', url.toString());
      } catch (_) {}

      if (shouldScrollMobile && window.innerWidth < 1024 && verdictPanel) {
        verdictPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    function applyFilters() {
      const q = normalizeStr(searchQuery.trim());
      if (clearBtn) {
        clearBtn.classList.toggle('hidden', q.length === 0);
      }

      let visibleCount = 0;
      let firstVisibleId = null;
      let selectedIsVisible = false;

      cardButtons.forEach((btn) => {
        const id = btn.getAttribute('data-ksd-id');
        const cat = btn.getAttribute('data-ksd-category');
        const sym = byId.get(id);
        if (!sym) return;

        const matchesCat = activeCategory === 'all' || cat === activeCategory;
        let matchesQuery = true;
        if (q.length > 0) {
          const haystack = normalizeStr(
            [
              sym.code,
              sym.name,
              sym.shortMeaning,
              sym.safetyExplanation,
              ...(sym.commonItems || []),
              ...(sym.searchKeywords || [])
            ].join(' ')
          );
          matchesQuery = haystack.includes(q);
        }

        const isVisible = matchesCat && matchesQuery;
        btn.classList.toggle('hidden', !isVisible);
        if (isVisible) {
          visibleCount++;
          if (!firstVisibleId) firstVisibleId = id;
          if (id === selectedId) selectedIsVisible = true;
        }
      });

      if (countStatus) {
        countStatus.innerHTML = `${ui.showingPrefix} <strong class="text-ink">${visibleCount}</strong> ${ui.showingOf} ${symbols.length} ${ui.symbolsUnit}`;
      }
      if (emptyState && gridEl) {
        emptyState.classList.toggle('hidden', visibleCount > 0);
        gridEl.classList.toggle('hidden', visibleCount === 0);
      }

      if (visibleCount > 0 && !selectedIsVisible && firstVisibleId) {
        selectSymbol(firstVisibleId, false);
      }
    }

    function setCategory(cat) {
      activeCategory = cat;
      tabButtons.forEach((btn) => {
        const isAct = btn.getAttribute('data-ksd-cat') === cat;
        btn.setAttribute('aria-selected', isAct ? 'true' : 'false');
        const badge = btn.querySelector('span:last-child');
        if (isAct) {
          btn.classList.add('bg-primary', 'text-on-primary', 'border-primary', 'shadow-xs');
          btn.classList.remove('bg-canvas', 'text-body', 'border-hairline');
          if (badge) {
            badge.classList.add('bg-white/20', 'text-on-primary');
            badge.classList.remove('bg-surface-soft', 'text-muted');
          }
        } else {
          btn.classList.remove('bg-primary', 'text-on-primary', 'border-primary', 'shadow-xs');
          btn.classList.add('bg-canvas', 'text-body', 'border-hairline');
          if (badge) {
            badge.classList.remove('bg-white/20', 'text-on-primary');
            badge.classList.add('bg-surface-soft', 'text-muted');
          }
        }
      });
      applyFilters();
    }

    // Bind symbol clicks
    cardButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-ksd-id');
        if (id) selectSymbol(id, true);
      });
    });

    // Bind category tabs
    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = btn.getAttribute('data-ksd-cat') || 'all';
        setCategory(cat);
      });
    });

    // Bind search input
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = e.target.value || '';
        applyFilters();
      });
    }

    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        searchQuery = '';
        if (searchInput) {
          searchInput.value = '';
          searchInput.focus();
        }
        applyFilters();
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        searchQuery = '';
        if (searchInput) searchInput.value = '';
        setCategory('all');
      });
    }

    // Bind quick pick chips
    quickPickButtons.forEach((chip) => {
      chip.addEventListener('click', () => {
        const q = chip.getAttribute('data-ksd-quick') || '';
        searchQuery = q;
        if (searchInput) searchInput.value = q;
        setCategory('all');
      });
    });

    // Scroll back up to symbol grid on mobile
    if (scrollGridBtn && gridAnchor) {
      scrollGridBtn.addEventListener('click', () => {
        gridAnchor.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    }

    // Copy verdict shareable summary
    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        const sym = byId.get(selectedId);
        if (!sym) return;
        const text = `${sym.name} (${sym.code}) — ${sym.shortMeaning}\n` +
          `${ui.appliances.dishwasher}: ${ui.verdictLabels[sym.verdicts.dishwasher]} | ` +
          `${ui.appliances.microwave}: ${ui.verdictLabels[sym.verdicts.microwave]} | ` +
          `${ui.appliances.oven}: ${ui.verdictLabels[sym.verdicts.oven]} | ` +
          `${ui.appliances.freezer}: ${ui.verdictLabels[sym.verdicts.freezer]} | ` +
          `${ui.appliances.airfryer}: ${ui.verdictLabels[sym.verdicts.airfryer]}\n` +
          `${window.location.href}`;

        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(() => {
            const labelSpan = copyBtn.querySelector('span');
            if (labelSpan) {
              labelSpan.textContent = ui.copiedVerdictBtn;
              setTimeout(() => {
                labelSpan.textContent = ui.copyVerdictBtn;
              }, 2000);
            }
          }).catch(() => {});
        }
      });
    }

    // Check URL ?symbol=... on initial load
    try {
      const params = new URLSearchParams(window.location.search);
      const initialSym = params.get('symbol');
      if (initialSym && byId.has(initialSym)) {
        selectSymbol(initialSym, false);
      }
    } catch (_) {}
  })();
</script>
