} else if (/(boiling-tap-water-vs-water-filter)/.test(toolMatchSlug)) {
  recommendedToolKey = 'waterFilter';
} else if (/(self-cleaning-pyrolytic-oven|pyrolytic-oven-vs-steam-clean)/.test(toolMatchSlug)) {
  recommendedToolKey = 'ovenPyrolysis';
} else if (/(microwave-popcorn-bag-vs-borosilicate-glass-popper)/.test(toolMatchSlug)) {
  recommendedToolKey = 'microwavePopcornPfas';
} else if (/(stainless-steel-boiler-vs-aluminum-boiler-espresso)/.test(toolMatchSlug)) {
  recommendedToolKey = 'espressoHeavyMetal';
} else if (/(hot-food-in-fridge-vs-counter-cooling)/.test(toolMatchSlug)) {
  recommendedToolKey = 'fridgeZone';
} else if (/(chest-freezer|frost-free-upright-freezer)/.test(toolMatchSlug)) {
  recommendedToolKey = 'freezerBurn';
} else if (/(propane-gas-grill-vs-charcoal-grill)/.test(toolMatchSlug)) {
  recommendedToolKey = 'charcoalGasGrillPah';
} else if (/(dishwasher-sanitize|eco-mode)/.test(toolMatchSlug)) {
  recommendedToolKey = 'dishwasherSanitize';
} else if (/(pla-bioplastic|bioplastic)/.test(toolMatchSlug)) {
  recommendedToolKey = 'plasticLeaching';
} else if (/(tempered-glass-lid|glass-lid-vs-stainless)/.test(toolMatchSlug)) {
  recommendedToolKey = 'thermalShock';
} else if (/(single-serve-pod-coffee-maker|french-door-air-fryer-oven|glass-carafe-vs-stainless-steel-coffee-maker)/.test(toolMatchSlug)) {
  recommendedToolKey = 'recallsScanner';
} else if (/(titanium-vs-hardwood-cutting-board|rubber-vs-plastic-cutting-board|magnetic-knife-strip|wooden-knife-block)/.test(toolMatchSlug)) {
  recommendedToolKey = 'knifeCare';
} else if (/(nylon.*silicone|platinum-silicone.*cooking-utensils|flame-retardant|rice-cooker|brass-vs-stainless-steel-cookware)/.test(toolMatchSlug)) {
  recommendedToolKey = 'toxicScorecard';
} else if (/(gas-oven-vs-electric-convection-oven|ducted-range-hood|recirculating-charcoal-filter)/.test(toolMatchSlug)) {
  recommendedToolKey = 'gasStoveNo2';
} else if (/(plastic-tea-bags-vs-stainless-steel-tea-infuser)/.test(toolMatchSlug)) {
  recommendedToolKey = 'coffeeBrew';
} else if (/(reverse-osmosis|activated-carbon|water-filter(?!-pitcher))/.test(toolMatchSlug)) {
  recommendedToolKey = 'waterFilter';
} else if (/^slow-cooker|crock-pot/.test(toolMatchSlug)) {
  recommendedToolKey = 'slowCooker';
} else if (/(instant-pot|pressure-cooker|inner-pot)/.test(toolMatchSlug)) {
  recommendedToolKey = 'instantPot';
} else if (/(slow-cooker|crock-pot)/.test(toolMatchSlug)) {
  recommendedToolKey = 'slowCooker';
} else if (/(gasket-mold|bleach|ammonia|(?:hydrogen-)?peroxide(?!-cured)|baking-soda|bar-keepers-friend|sponge)/.test(toolMatchSlug)) {
  recommendedToolKey = 'cleaner';
} else if (/(descal(?:e|ing)|french-press|tea-infuser|coffee-maker|coffee|kettles?|espresso|moka|burr-grinder|travel-mug)/.test(toolMatchSlug)) {
  recommendedToolKey = 'descaling';
} else if (/\bvinegar\b/.test(toolMatchSlug)) {
  recommendedToolKey = 'cleaner';
} else if (/(moldy|\bmold\b)/.test(toolMatchSlug)) {
  recommendedToolKey = 'moldyFood';
} else if (/(dented-can|botulism|baking-powder|spices|flour|\bpantry\b|mortar-and-pestle|garlic-press|fermentation-crock|canned-food-packaging)/.test(toolMatchSlug)) {
  recommendedToolKey = 'pantry';
} else if (/(allergy|cross-contact|celiac|\btoaster\b(?!-oven))/.test(toolMatchSlug)) {
  recommendedToolKey = 'allergy';
} else if (/(cast-iron|carbon-steel|seasoning|\brust\b|grill-grates|grill-grates)/.test(toolMatchSlug)) {
  recommendedToolKey = 'castIron';
} else if (/(cloudy-dishwasher|dishwasher-pod|detergent|hard-water|etching|crystal)/.test(toolMatchSlug)) {
  recommendedToolKey = 'dishwasherDosage';
} else if (/(induction|magnet-test)/.test(toolMatchSlug)) {
  recommendedToolKey = 'induction';
} else if (/(baby-bottle|kids-plate|sippy|sterilizer)/.test(toolMatchSlug)) {
  recommendedToolKey = 'babyBottle';
} else if (/(colander|blender|sous-vide|plastic|microplastic|styrofoam|meal-prep|tupperware|ziploc|cutting-board|bamboo-vs-hardwood|tritan|polypropylene|paper-composite|citrus-juicer|salad-spinner|dish-drying-rack|meat-grinder|bento-box|potato-ricer|water-filter-pitcher|measuring-cups|ice-cube-tray|box-grater|mandoline-slicer|muffin-pan|pie-dish|fine-mesh-strainer|cooking-ladle|kitchen-funnel|measuring-spoons|melamine-dinnerware|popsicle-molds|oil-sprayer|can-opener|food-mill|tortilla-press|meat-press|pasta-maker|fermentation-weights|ice-cream-maker|sous-vide-container|pour-over-dripper|meat-tenderizer|blender-pitcher|portafilter|food-processor|lemon-squeezer)/.test(toolMatchSlug)) {
  recommendedToolKey = 'plastic';
} else if (/(oven-rack|25-degree|silicone|oven-mitt|whisk|parchment-paper-vs-aluminum-foil|aluminum-foil-vs-parchment-paper)/.test(toolMatchSlug)) {
  recommendedToolKey = 'ovenRack';
} else if (/(power-outage|blackout)/.test(toolMatchSlug)) {
  recommendedToolKey = 'powerOutage';
} else if (/(smoke-point|frying-oil|cooking-oil|oil-dispenser)/.test(toolMatchSlug)) {
  recommendedToolKey = 'oilSmokePoint';
} else if (/(corningware|pyrex-plastic-lid)/.test(toolMatchSlug)) {
  recommendedToolKey = 'ovenTemp';
} else if (/air-fryer/.test(toolMatchSlug)) {
  recommendedToolKey = 'airfryer';
} else if (/(microwave|wattage)/.test(toolMatchSlug)) {
  recommendedToolKey = 'microwave';
} else if (/(thaw|refreeze|freezer-burn|turkey|holiday|raw-vs-cooked-freezing|fridge-vs-freezer-chicken)/.test(toolMatchSlug)) {
  recommendedToolKey = 'thawing';
} else if (/(leftover|rice-pasta|fried-rice|store-leftovers)/.test(toolMatchSlug)) {
  recommendedToolKey = 'leftover';
} else if (/(fridge|refrigerator|refrigeration|produce|vegetables)/.test(toolMatchSlug)) {
  recommendedToolKey = 'fridgeZone';
} else if (/(freezer-mistakes|vacuum-seal-vs-regular-freezer|freezer-bag-vs-container)/.test(toolMatchSlug)) {
  recommendedToolKey = 'leftover';
} else if (/(internal-cooking|meat-poultry|baking-vs-broiling|grilling|steamer|steaming-vs-boiling|stovetop-vs-oven|thermometer)/.test(toolMatchSlug)) {
  recommendedToolKey = 'cookingTemp';
} else if (/(mixing-bowl|dutch-oven|pizza-stone|loaf-pan|stock-pot|baking-steel|pyrex|hexclad|caraway|le-creuset|lodge|nonstick|stainless|copper-core|copper|porcelain|stoneware|enameled-steel|oven-safe|cookware|bakeware|baking-sheet|parchment|wax-paper|ceramic-vs-metal|oven-vs-toaster-oven|roasting-pan)/.test(toolMatchSlug)) {
  recommendedToolKey = 'ovenTemp';
} else if (toolMatchCategory === 'cooking-method') {
  recommendedToolKey = 'cookingTemp';
}

const toolCatalog: Record<RecommendedToolKey, {
