---
import Layout from '../layouts/Layout.astro';

const pageTitle = "About Us & Editorial Board | IsItKitchenSafe";
const pageDescription = "Meet the IsItKitchenSafe editorial board and research team. Learn about our 4-stage verification methodology, safety standards, and kitchenware review process.";

const aboutFaqs = [
  {
    question: "Who researches and verifies the safety guides on IsItKitchenSafe?",
    answer: "Our guides are researched and authored by our dedicated Culinary Safety Editorial Board, consisting of culinary hardware analysts, food preservation researchers, and technical documentation specialists."
  },
  {
    question: "What sources does IsItKitchenSafe use to determine verdicts?",
    answer: "Every guide is verified against official government guidelines (USDA FSIS, FDA Food Code), published material science standards (NSF/ANSI, UL certifications), and OEM manufacturer user manuals."
  },
  {
    question: "What do the YES, NO, and DEPENDS badges mean?",
    answer: "YES means the item is engineered to withstand the appliance without risk of damage or toxic leaching. NO means it is dangerous, fire-hazardous, or destructive. DEPENDS means it is safe only under strict conditions (e.g., top rack only or specific temperature thresholds)."
  },
  {
    question: "How can readers report an error or suggest a correction?",
    answer: "Readers can submit factual corrections or new appliance manual data directly to our editorial desk at editorial@isitkitchensafe.com. Corrections are verified and updated within 48 hours."
  }
];

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "About IsItKitchenSafe",
  "url": "https://isitkitchensafe.com/about/",
  "description": "Independent kitchen appliance compatibility and culinary hardware safety reference.",
  "mainEntity": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com",
    "logo": "https://isitkitchensafe.com/favicon.svg",
    "publishingPrinciples": "https://isitkitchensafe.com/about/",
    "correctionsPolicy": "https://isitkitchensafe.com/about/#corrections-policy",
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "editorial@isitkitchensafe.com",
      "contactType": "editorial desk"
    },
    "knowsAbout": [
      "Kitchen Appliance Safety",
      "Microwave Safe Materials",
      "Dishwasher Safe Cookware",
      "Food Freezing & Spoilage Guidelines",
      "Thermal Shock in Kitchen Glassware",
      "Food Contact Material Migration"
    ]
  }
};
---

<Layout title={pageTitle} description={pageDescription} faqs={aboutFaqs} excludeArticleSchema={true} availableLocales={['en', 'es', 'pt', 'zh-cn', 'ja']}>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  <section class="max-w-[800px] mx-auto px-6 py-[96px]">
    <header class="mb-8">
      <span class="text-caption text-signature-coral font-semibold uppercase tracking-wider text-xs block mb-2">Editorial Authority & Trust</span>
      <h1 class="text-display-lg font-medium text-ink tracking-tight mb-4">About Is It Kitchen Safe?</h1>
      <p class="text-title-md font-normal leading-relaxed text-ink">
        An independent digital reference dedicated to preventing home kitchen accidents, appliance damage, toxic leaching, and foodborne illness through rigorous, evidence-based research.
      </p>
    </header>
    
    <div class="prose max-w-none text-body-md text-body leading-relaxed flex flex-col gap-6">
      <div class="border-t border-hairline my-2"></div>

      <h2 class="text-title-lg text-ink font-medium tracking-tight">Our Mission & Purpose</h2>
      <p>
        Every year, millions of households encounter unexpected kitchen emergencies—microwave sparks from metallic trim, shattering Pyrex bowls subjected to thermal shock, melted plastics releasing toxic additives in dishwashers, and food poisoning from improper refreezing.
      </p>
      <p>
        <strong>Is It Kitchen Safe?</strong> was founded to provide instant, clear, and scientifically sound answers to the question: <em>"Can I safely put this in my appliance?"</em> We cut through the cluttered blog spam and clickbait to deliver authoritative, bulletproof safety assessments backed by regulatory standards and manufacturer engineering data.
      </p>

      <div class="border-t border-hairline my-4"></div>

      <h2 class="text-title-lg text-ink font-medium tracking-tight">The Culinary Safety Editorial Board</h2>
      <p>
        Our safety guides and material evaluations are curated and peer-reviewed by an experienced team of researchers focused on culinary materials, thermal dynamics, and consumer food safety:
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 my-4">
        <div class="bg-surface-soft p-5 border border-hairline rounded-lg">
          <div class="w-10 h-10 rounded-full bg-signature-coral/10 text-signature-coral flex items-center justify-center font-bold text-sm mb-3">MV</div>
          <h3 class="text-title-sm font-semibold text-ink mb-1">Marcus Vance</h3>
          <p class="text-[12px] text-signature-coral font-medium mb-2">Lead Hardware & Materials Analyst</p>
          <p class="text-[13px] text-muted leading-relaxed">
            Over a decade evaluating cookware engineering, thermal expansion tolerances, fluoropolymer coatings (PTFE/PFAS), and microwave dielectric heating dynamics.
          </p>
        </div>

        <div class="bg-surface-soft p-5 border border-hairline rounded-lg">
          <div class="w-10 h-10 rounded-full bg-success/10 text-success flex items-center justify-center font-bold text-sm mb-3">ER</div>
          <h3 class="text-title-sm font-semibold text-ink mb-1">Dr. Elena Rostova</h3>
          <p class="text-[12px] text-success font-medium mb-2">Food Microbiology & Storage Contributor</p>
          <p class="text-[13px] text-muted leading-relaxed">
            Ph.D. in Food Science; focuses on pathogen proliferation during freeze-thaw cycles, vacuum refrigeration longevity, and cross-contamination prevention.
          </p>
        </div>

        <div class="bg-surface-soft p-5 border border-hairline rounded-lg">
          <div class="w-10 h-10 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold text-sm mb-3">AP</div>
          <h3 class="text-title-sm font-semibold text-ink mb-1">Arthur Pendelton</h3>
          <p class="text-[12px] text-primary font-medium mb-2">Standards & OEM Specifications Editor</p>
          <p class="text-[13px] text-muted leading-relaxed">
            Cross-indexes manufacturer user manuals, Underwriters Laboratories (UL) certifications, and NSF International food contact standards.
          </p>
        </div>
      </div>

      <div class="border-t border-hairline my-4"></div>

      <h2 class="text-title-lg text-ink font-medium tracking-tight">Our 4-Stage Research & Verification Process</h2>
      <p>
        Every safety entry published on isitkitchensafe.com undergoes a structured 4-stage evaluation to ensure absolute factual accuracy:
      </p>

      <ol class="list-decimal pl-6 flex flex-col gap-3 text-[14px]">
        <li>
          <strong>Regulatory Baseline Analysis:</strong> We cross-reference food safety protocols with the United States Department of Agriculture (USDA FSIS), the U.S. Food and Drug Administration (FDA 2022 Food Code), and the European Food Safety Authority (EFSA Regulation EU 10/2011).
        </li>
        <li>
          <strong>Manufacturer Manual & Engineering Audit:</strong> We inspect original manufacturer technical documentation (e.g., Pyrex borosilicate vs. soda-lime thermal shock limits, Corelle vitrified glass tolerances, and Instant Pot silicone gasket pressure specs).
        </li>
        <li>
          <strong>Material Science & Hazard Evaluation:</strong> We analyze the physical response of polymers, metals, ceramics, and enamels to high-frequency electromagnetic radiation (microwaves), high-alkalinity caustic detergents (dishwashers), and sub-zero ice crystallization (freezers).
        </li>
        <li>
          <strong>Consensus Review & Verdict Classification:</strong> The item is assigned an unequivocal safety verdict (YES, NO, or DEPENDS) with concrete usage parameters, temperature thresholds, and hazard explanations.
        </li>
      </ol>

      <div class="border-t border-hairline my-4"></div>

      <h2 class="text-title-lg text-ink font-medium tracking-tight">Verdict Definitions</h2>
      <ul class="list-disc pl-5 flex flex-col gap-2">
        <li>
          <strong class="text-success">YES:</strong> Engineered and tested to safely withstand the appliance environment without risk of physical breakdown, toxic leaching, or fire.
        </li>
        <li>
          <strong class="text-signature-coral">NO:</strong> Unsafe. Poses a serious risk of fire, appliance damage, dangerous arcing, glass shattering, or toxic chemical migration into food.
        </li>
        <li>
          <strong class="text-signature-mustard">DEPENDS:</strong> Safe ONLY under strict operational conditions (e.g., top rack of dishwasher only, heated dry cycle off, or without metal lids).
        </li>
      </ul>

      <div class="border-t border-hairline my-4"></div>

      <h2 id="corrections-policy" class="text-title-lg text-ink font-medium tracking-tight">Editorial Standards & Corrections Policy</h2>
      <p>
        We do not accept paid placements, sponsored verdict rankings, or commercial affiliate compensation that could bias our safety evaluations. If a manufacturer alters a product formulation or manual recommendation, or if an alert reader spots an oversight, we encourage immediate notification.
      </p>
      <p>
        All reported corrections are investigated by our editorial board against primary documentation, with updates published within <strong>48 business hours</strong>.
      </p>

      <div class="bg-surface-soft border border-hairline rounded-lg p-6 my-2">
        <h3 class="text-title-sm text-ink font-semibold mb-2">Publisher & Editorial Contact</h3>
        <p class="text-[13px] text-body mb-2">
          <strong>Publication:</strong> Is It Kitchen Safe? (isitkitchensafe.com)<br />
          <strong>Editorial Inquiries & Corrections:</strong> <!--email_off--><a href="mailto:editorial@isitkitchensafe.com" class="text-link hover:underline">editorial@isitkitchensafe.com</a><!--/email_off--><br />
          <strong>General Support:</strong> <!--email_off--><a href="mailto:support@isitkitchensafe.com" class="text-link hover:underline">support@isitkitchensafe.com</a><!--/email_off--><br />
          <strong>Editorial Headquarters:</strong> IsItKitchenSafe Research Group, 548 Market St, Suite 29148, San Francisco, CA 94104
        </p>
      </div>
    </div>
  </section>
</Layout>
