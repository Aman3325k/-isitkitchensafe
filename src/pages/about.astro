---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getDirectoryUrl, useTranslatedPath, useTranslations } from '../i18n/utils';

const lang = 'en' as const;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const pageTitle = 'About Us, Editorial Standards & Safety Platform | IsItKitchenSafe';
const pageDescription =
  'Meet the IsItKitchenSafe editorial board and independent kitchen safety platform: 10,900+ verified reference pages, 45+ free consumer calculators, 5 native languages, and 10 cited regulatory standards.';

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'About IsItKitchenSafe',
  url: 'https://isitkitchensafe.com/about/',
  inLanguage: 'en',
  description: pageDescription,
  isPartOf: {
    '@type': 'WebSite',
    name: 'IsItKitchenSafe',
    url: 'https://isitkitchensafe.com/'
  },
  mainEntity: {
    '@type': 'Organization',
    name: 'IsItKitchenSafe',
    alternateName: 'Is It Kitchen Safe?',
    url: 'https://isitkitchensafe.com/',
    logo: {
      '@type': 'ImageObject',
      url: 'https://isitkitchensafe.com/favicon.svg'
    },
    publishingPrinciples: 'https://isitkitchensafe.com/methodology/',
    correctionsPolicy: 'https://isitkitchensafe.com/about/#corrections-policy',
    contactPoint: {
      '@type': 'ContactPoint',
      email: 'editorial@isitkitchensafe.com',
      contactType: 'editorial desk',
      availableLanguage: ['English', 'Spanish', 'Portuguese', 'Chinese', 'Japanese']
    },
    knowsAbout: [
      'USDA FSIS FoodKeeper & Safe Minimum Internal Temperatures',
      'FDA 21 CFR Food Contact Materials & Polymer Migration Limits',
      'NSF/ANSI 51 & 184 Food Equipment & Dishwasher Sanitization',
      'CDC & AAP Infant Feeding & Safe Bottle Warming Guidelines',
      'FARE & FDA FASTER Act Top 9 Food Allergen Cross-Contact',
      'AOCS & Codex Alimentarius Cooking Oil Smoke Points',
      'ASTM C148 Thermal Shock in Borosilicate & Soda-Lime Glassware',
      'EU BfR & EFSA Bamboo-Melamine Composite Migration Advisories',
      'EPA & Poison Control Household Cleaner Chemical Reactivity',
      'NIST, UL & IEEE Induction Cooktop & Microwave Appliance Safety'
    ]
  }
};

const trustMetrics = [
  {
    value: '10,900+',
    label: 'Verified Safety Reference Pages',
    detail: 'Appliance compatibility, shelf life, refreezing, material tolerances, and hazard triage guides.'
  },
  {
    value: '5',
    label: 'Native Languages',
    detail: 'EN · ES · PT · 中文 · 日本語 — localized with regional units and native terminology.'
  },
  {
    value: '45+',
    label: 'Everyday Consumer Calculators',
    detail: '196 total interactive home & commercial lab safety tools available with zero login.'
  },
  {
    value: '10',
    label: 'Primary Regulatory Standards Cited',
    detail: 'USDA FSIS, FDA 21 CFR, NSF/ANSI, AAP/CDC, FARE, AOCS, ASTM, EU BfR, EPA, NIST/IEEE.'
  }
];

const commitmentCards = [
  {
    eyebrow: '100% Editorial Independence',
    title: 'Zero Brand Sponsorships or Paid Verdicts',
    body: 'Every YES, DEPENDS, and NO verdict is audited solely against published regulatory codes, thermal-material physics, and OEM engineering limits. No cookware maker, appliance brand, or retailer can sponsor, influence, or alter a safety rating.'
  },
  {
    eyebrow: 'Zero-Paywall Public Utility',
    title: 'Always Free, Instant & Frictionless',
    body: 'Home safety should never sit behind a subscription wall or cluttered recipe-blog filler. All 10,900+ safety reference guides, 45+ everyday consumer calculators, and printable fridge cheat sheets remain 100% free with no account required.'
  },
  {
    eyebrow: 'Evidence-First Verification',
    title: 'Primary Citations & 48-Hour Corrections',
    body: 'Claims are anchored to named federal food-safety codes and material standards—never internet folklore. When a manufacturer updates a material spec or a reader flags a discrepancy, our editorial desk reviews primary docs within 48 business hours.'
  }
];

const editorialBoard = [
  {
    initials: 'MV',
    badgeClass: 'bg-signature-coral/10 text-signature-coral border border-signature-coral/25',
    roleClass: 'text-signature-coral',
    name: 'Marcus Vance',
    role: 'Lead Hardware & Materials Analyst',
    bio: 'Over a decade evaluating cookware engineering, thermal expansion tolerances, fluoropolymer coatings (PTFE/PFAS), and microwave dielectric heating dynamics.'
  },
  {
    initials: 'ER',
    badgeClass: 'bg-success/10 text-success border border-success/25',
    roleClass: 'text-success',
    name: 'Dr. Elena Rostova',
    role: 'Food Microbiology & Storage Contributor',
    bio: 'Ph.D. in Food Science; focuses on pathogen proliferation during freeze-thaw cycles, power-outage spoilage thresholds, and allergen cross-contact prevention.'
  },
  {
    initials: 'AP',
    badgeClass: 'bg-info/10 text-info dark:text-info-border border border-info/25',
    roleClass: 'text-info dark:text-info-border',
    name: 'Arthur Pendelton',
    role: 'Standards & OEM Specifications Editor',
    bio: 'Cross-indexes manufacturer user manuals, Underwriters Laboratories (UL) listings, ASTM thermal standards, and NSF International food-contact certifications.'
  }
];

const popularUtilities = [
  {
    path: '/tools/kitchen-symbol-decoder/',
    tag: 'Visual Decoder',
    title: 'Kitchen Symbol Decoder',
    desc: 'Identify dishwasher, microwave, oven, freezer, and resin symbols stamped on cookware bottoms.'
  },
  {
    path: '/tools/power-outage-food-safety-checker/',
    tag: 'Emergency Triage',
    title: 'Power Outage Food Safety Checker',
    desc: 'Calculate keep-or-toss verdicts for fridge and freezer foods using USDA 4h / 24h / 48h rules.'
  },
  {
    path: '/tools/moldy-food-safety-checker/',
    tag: 'USDA Guidance',
    title: 'Moldy Food Safety Checker',
    desc: 'Know which hard foods can be safely trimmed by 1 inch and which soft foods must be discarded.'
  },
  {
    path: '/tools/cleaner-mixing-danger-checker/',
    tag: 'Chemical Safety',
    title: 'Cleaner Mixing Danger Checker',
    desc: 'Check bleach, vinegar, ammonia, and peroxide combinations before mixing to prevent toxic gas.'
  },
  {
    path: '/tools/fridge-organization-zone-planner/',
    tag: 'Storage Planner',
    title: 'Fridge Organization Zone Planner',
    desc: 'Map raw meat, dairy, produce, and leftovers to safe temperature zones to stop cross-contamination.'
  },
  {
    path: '/saved/',
    tag: 'Printable Utility',
    title: 'Custom Printable Fridge Cheat Sheet',
    desc: 'Save your household cookware verdicts and print a clean quick-reference sheet for your kitchen.'
  }
];

const methodologyUrl = getDirectoryUrl('methodology', lang);
const contactUrl = getDirectoryUrl('contact', lang);
const toolsUrl = getDirectoryUrl('tools', lang);
---

<Layout
  title={pageTitle}
  description={pageDescription}
  excludeArticleSchema={true}
  excludeFaqSchema={true}
  availableLocales={['en', 'es', 'pt', 'zh-cn', 'ja']}
  lang={lang}
>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(orgSchema)} />

  <article class="max-w-[920px] mx-auto px-6 py-12 md:py-16">
    <Breadcrumbs
      items={[
        { label: t('nav.home'), href: translatePath('/') },
        { label: t('nav.about') }
      ]}
      className="mb-6"
    />

    <!-- Hero Header -->
    <header class="mb-10">
      <span class="text-caption text-signature-coral font-semibold uppercase tracking-wider text-xs block mb-2">
        Editorial Authority &amp; Independent Safety Hub
      </span>
      <h1 class="text-display-lg font-medium text-ink tracking-tight mb-4">
        About Is It Kitchen Safe?
      </h1>
      <p class="text-title-md font-normal leading-relaxed text-body max-w-[780px]">
        An independent digital reference dedicated to preventing home kitchen accidents, appliance damage, toxic chemical leaching, and foodborne illness through transparent, standards-backed research.
      </p>
    </header>

    <!-- Verified Live Scale & Trust Metrics Strip -->
    <section aria-labelledby="platform-metrics-heading" class="mb-12">
      <h2 id="platform-metrics-heading" class="sr-only">Verified Platform Scale and Trust Metrics</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {trustMetrics.map((metric) => (
          <div class="bg-surface-soft border border-hairline rounded-lg p-5 flex flex-col gap-1.5">
            <span class="text-[28px] md:text-[32px] font-display font-semibold text-ink leading-none tracking-tight">
              {metric.value}
            </span>
            <h3 class="text-[14px] font-semibold text-ink leading-snug mt-1">
              {metric.label}
            </h3>
            <p class="text-[12.5px] text-muted leading-relaxed">
              {metric.detail}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Editorial Independence, Zero-Paywall & Evidence-First Commitment Cards -->
    <section aria-labelledby="commitments-heading" class="mb-12">
      <div class="mb-5">
        <span class="text-xs font-semibold uppercase tracking-wider text-signature-coral block mb-1">
          Our Reader Charter
        </span>
        <h2 id="commitments-heading" class="text-title-lg text-ink font-medium tracking-tight">
          Editorial Independence, Zero-Paywall &amp; Evidence-First Commitment
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {commitmentCards.map((card) => (
          <div class="bg-surface-soft border border-hairline rounded-lg p-5 flex flex-col gap-2">
            <span class="text-[11px] font-mono uppercase tracking-wider text-muted">
              {card.eyebrow}
            </span>
            <h3 class="text-title-sm font-semibold text-ink leading-snug">
              {card.title}
            </h3>
            <p class="text-[13.5px] text-body leading-relaxed">
              {card.body}
            </p>
          </div>
        ))}
      </div>

      <!-- Direct CTA Strip to Methodology & Contact -->
      <div class="mt-5 bg-surface-soft border border-hairline rounded-lg p-5 md:p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="max-w-[560px]">
          <h3 class="text-title-sm font-semibold text-ink mb-1">
            Inspect Our Verification Rubric or Submit a Source Update
          </h3>
          <p class="text-[13.5px] text-body leading-relaxed">
            Explore all 10 cited regulatory codes and thermal-threshold tables on our Methodology hub, or send OEM manual updates directly to our editorial desk.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-3 shrink-0">
          <a
            href={methodologyUrl}
            class="btn-primary !py-2.5 !px-4 !text-[14px]"
          >
            Read Methodology
          </a>
          <a
            href={contactUrl}
            class="btn-secondary !py-2.5 !px-4 !text-[14px]"
          >
            Contact Editorial Desk
          </a>
        </div>
      </div>
    </section>

    <!-- Mission & Purpose -->
    <section aria-labelledby="mission-heading" class="border-t border-hairline pt-10 mb-12 flex flex-col gap-4 text-body-md text-body leading-relaxed">
      <h2 id="mission-heading" class="text-title-lg text-ink font-medium tracking-tight">
        Our Mission &amp; Purpose
      </h2>
      <p>
        Every year, millions of households encounter preventable kitchen emergencies—microwave arcing from metallic glaze trim, shattering glassware subjected to thermal shock, warped plastics releasing additives in high-heat dishwashers, hazardous household cleaner fumes, and foodborne illness after power outages or improper refreezing.
      </p>
      <p>
        <strong class="text-ink">Is It Kitchen Safe?</strong> was built to deliver instant, unambiguous, and scientifically grounded answers to the question: <em>&ldquo;Can I safely put this in my appliance—or eat this food?&rdquo;</em> We strip away ad-bloated blog filler to give home cooks direct verdicts grounded in regulatory frameworks and manufacturer engineering specifications.
      </p>
    </section>

    <!-- The Culinary Safety Editorial Board -->
    <section aria-labelledby="editorial-board-heading" class="border-t border-hairline pt-10 mb-12">
      <h2 id="editorial-board-heading" class="text-title-lg text-ink font-medium tracking-tight mb-3">
        The Culinary Safety Editorial Board
      </h2>
      <p class="text-body-md text-body leading-relaxed mb-6">
        Our reference guides, material thresholds, and interactive calculators are curated and peer-reviewed by specialists across cookware engineering, food microbiology, and regulatory standards:
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {editorialBoard.map((member) => (
          <div class="bg-surface-soft p-5 border border-hairline rounded-lg flex flex-col">
            <div class={`w-10 h-10 rounded-full flex items-center justify-center font-bold text-sm mb-3 ${member.badgeClass}`}>
              {member.initials}
            </div>
            <h3 class="text-title-sm font-semibold text-ink mb-0.5">{member.name}</h3>
            <p class={`text-[12px] font-medium mb-2.5 ${member.roleClass}`}>{member.role}</p>
            <p class="text-[13px] text-muted leading-relaxed">{member.bio}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 4-Stage Research & Verification Process + Verdict Definitions -->
    <section aria-labelledby="verification-process-heading" class="border-t border-hairline pt-10 mb-12">
      <h2 id="verification-process-heading" class="text-title-lg text-ink font-medium tracking-tight mb-3">
        Our 4-Stage Research &amp; Verification Process
      </h2>
      <p class="text-body-md text-body leading-relaxed mb-5">
        Every safety entry published on isitkitchensafe.com undergoes a structured 4-stage audit before publication (see full thermal tables and source index in our{' '}
        <a href={methodologyUrl} class="text-link hover:underline font-medium">Safety Methodology</a>):
      </p>

      <ol class="list-decimal pl-6 flex flex-col gap-3 text-[14px] text-body leading-relaxed mb-8">
        <li>
          <strong class="text-ink">Regulatory Baseline Analysis:</strong> Cross-referencing food safety and chemical-contact rules against USDA FSIS FoodKeeper, FDA 21 CFR (Parts 174–178), FDA Food Code, CDC/AAP, FARE, EPA, and EU BfR / EFSA standards.
        </li>
        <li>
          <strong class="text-ink">Manufacturer Manual &amp; Engineering Audit:</strong> Inspecting original OEM technical manuals (e.g., borosilicate vs. soda-lime glass ΔT shock limits, vitrified glass tolerances, insulated stainless-steel vacuum weld warnings, and air-fryer liner clearances).
        </li>
        <li>
          <strong class="text-ink">Material Science &amp; Hazard Evaluation:</strong> Evaluating how polymers, metals, ceramics, coatings, and woods respond to microwave dielectric heating, caustic pH &gt;10 dishwasher detergents, thermal shock, and sub-zero freeze crystallization.
        </li>
        <li>
          <strong class="text-ink">Consensus Review &amp; Verdict Classification:</strong> Assigning a clear safety verdict (<strong class="text-ink">YES</strong>, <strong class="text-ink">DEPENDS</strong>, or <strong class="text-ink">NO</strong>) paired with explicit temperature limits, rack placement rules, and hazard mechanisms.
        </li>
      </ol>

      <h3 class="text-title-md text-ink font-medium tracking-tight mb-4">
        How We Define Safety Verdicts
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="bg-surface-soft border border-hairline rounded-lg p-5 flex flex-col gap-2.5">
          <div><span class="badge-yes">YES</span></div>
          <p class="text-[13.5px] text-body leading-relaxed">
            Engineered and documented to safely withstand the appliance environment without physical breakdown, toxic leaching, or fire hazard.
          </p>
        </div>
        <div class="bg-surface-soft border border-hairline rounded-lg p-5 flex flex-col gap-2.5">
          <div><span class="badge-depends">DEPENDS</span></div>
          <p class="text-[13.5px] text-body leading-relaxed">
            Safe <strong class="text-ink">only</strong> under strict operating conditions—such as top rack only, heated-dry cycle off, lidded vs. unlidded, or strict temperature caps.
          </p>
        </div>
        <div class="bg-surface-soft border border-hairline rounded-lg p-5 flex flex-col gap-2.5">
          <div><span class="badge-no">NO</span></div>
          <p class="text-[13.5px] text-body leading-relaxed">
            Unsafe. Carries a documented risk of fire, microwave arcing, shattering, toxic chemical migration, pathogen survival, or permanent appliance damage.
          </p>
        </div>
      </div>
    </section>

    <!-- Most Popular Everyday Kitchen Safety Utilities Strip -->
    <section aria-labelledby="popular-utilities-heading" class="border-t border-hairline pt-10 mb-12">
      <div class="flex flex-wrap items-end justify-between gap-3 mb-5">
        <div>
          <span class="text-xs font-semibold uppercase tracking-wider text-signature-coral block mb-1">
            Free Interactive Tools
          </span>
          <h2 id="popular-utilities-heading" class="text-title-lg text-ink font-medium tracking-tight">
            Most Popular Everyday Kitchen Safety Utilities
          </h2>
        </div>
        <a href={toolsUrl} class="text-[13.5px] font-medium text-link hover:underline">
          Browse all calculators &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {popularUtilities.map((tool) => (
          <a
            href={translatePath(tool.path)}
            class="group bg-surface-soft border border-hairline rounded-lg p-5 flex flex-col gap-2 hover:border-border-strong transition-colors"
          >
            <span class="text-[11px] font-mono uppercase tracking-wider text-muted">
              {tool.tag}
            </span>
            <h3 class="text-title-sm font-semibold text-ink group-hover:text-link transition-colors leading-snug">
              {tool.title}
            </h3>
            <p class="text-[13px] text-body leading-relaxed">
              {tool.desc}
            </p>
            <span class="mt-auto pt-2 text-[12.5px] font-medium text-link">
              Open tool &rarr;
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- Editorial Standards, Corrections Policy & Publisher Contact -->
    <section id="corrections-policy" aria-labelledby="corrections-heading" class="border-t border-hairline pt-10 scroll-mt-24">
      <h2 id="corrections-heading" class="text-title-lg text-ink font-medium tracking-tight mb-3">
        Editorial Standards &amp; Corrections Policy
      </h2>
      <p class="text-body-md text-body leading-relaxed mb-3">
        We do not accept paid placements, sponsored verdict rankings, or commercial compensation that could bias our safety evaluations. If a manufacturer alters a material formulation or care manual, or if you spot an outdated specification, please notify our desk immediately.
      </p>
      <p class="text-body-md text-body leading-relaxed mb-6">
        All reported corrections are verified against primary documentation and updated within <strong class="text-ink">48 business hours</strong>.
      </p>

      <div class="bg-surface-soft border border-hairline rounded-lg p-6">
        <h3 class="text-title-sm text-ink font-semibold mb-3">Publisher &amp; Editorial Contact</h3>
        <div class="text-[13.5px] text-body leading-relaxed space-y-1.5">
          <p><strong class="text-ink">Publication:</strong> Is It Kitchen Safe? (isitkitchensafe.com)</p>
          <p>
            <strong class="text-ink">Editorial Inquiries &amp; Corrections:</strong>{' '}
            <!--email_off--><a href="mailto:editorial@isitkitchensafe.com" class="text-link hover:underline">editorial@isitkitchensafe.com</a><!--/email_off-->
          </p>
          <p>
            <strong class="text-ink">General Support:</strong>{' '}
            <!--email_off--><a href="mailto:support@isitkitchensafe.com" class="text-link hover:underline">support@isitkitchensafe.com</a><!--/email_off-->
          </p>
          <p><strong class="text-ink">Editorial Headquarters:</strong> IsItKitchenSafe Research Group, 548 Market St, Suite 29148, San Francisco, CA 94104</p>
        </div>
        <div class="mt-4 pt-4 border-t border-hairline flex flex-wrap gap-4 text-[13.5px]">
          <a href={methodologyUrl} class="text-link hover:underline font-medium">
            View Full Verification Methodology &rarr;
          </a>
          <a href={contactUrl} class="text-link hover:underline font-medium">
            Submit a Correction or Suggestion &rarr;
          </a>
        </div>
      </div>
    </section>
  </article>
</Layout>
