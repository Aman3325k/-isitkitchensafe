---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import refreezeData from '../../data/refreeze.json';

const pageTitle = "Refreezing Thawed Food Safety Guides | IsItKitchenSafe";
const pageDescription = "Can you refreeze beef, poultry, pork, dairy, or cooked meals once thawed? Learn the official USDA temperature rules and guidelines to avoid food poisoning.";

const totalCount = refreezeData.length;
const yesCount = refreezeData.filter(item => item.safe === 'yes').length;
const dependsCount = refreezeData.filter(item => item.safe === 'depends').length;
const noCount = refreezeData.filter(item => item.safe === 'no').length;
---

<Layout title={pageTitle} description={pageDescription} excludeArticleSchema={true} availableLocales={['en', 'es', 'pt', 'ja', 'zh-cn']}>
  <!-- Hero Section -->
  <section class="bg-signature-cream text-ink py-[64px] md:py-[80px]">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs 
        items={[
          { label: 'Home', href: '/' },
          { label: 'Refreeze Safety' }
        ]}
        className="mb-6"
      />
      
      <h1 class="text-display-lg font-medium tracking-tight mb-4">
        Refreeze Safety Guidelines
      </h1>
      <p class="text-muted text-body-md max-w-2xl leading-relaxed">
        Determine whether it is safe to put previously thawed meats, seafood, and meals back in the freezer. Learn strict USDA safety rules.
      </p>
    </div>
  </section>

  <!-- Items Grid Section -->
  <section class="max-w-[1280px] mx-auto px-6 py-[72px] md:py-[96px]">
    <!-- Featured Calculator Spotlight Banner -->
    <div class="mb-10 rounded-lg border border-hairline bg-surface-soft/80 p-5 md:p-6 flex flex-col md:flex-row md:items-center justify-between gap-4 shadow-xs">
      <div class="flex items-start gap-4">
        <div class="w-10 h-10 rounded-md bg-signature-cream text-ink border border-hairline flex items-center justify-center shrink-0 mt-0.5" aria-hidden="true">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v18m0-18l-2.5 2.5M12 3l2.5 2.5M12 21l-2.5-2.5M12 21l2.5-2.5M3 12h18M3 12l2.5-2.5M3 12l2.5 2.5M21 12l-2.5-2.5M21 12l-2.5 2.5" />
          </svg>
        </div>
        <div>
          <span class="inline-block text-[11px] font-bold uppercase tracking-wider text-info mb-1">Interactive Calculator</span>
          <h2 class="text-title-sm font-semibold text-ink mb-1">Thawing frozen meat or poultry?</h2>
          <p class="text-body-md text-muted leading-relaxed">
            Calculate exact refrigerator and cold-water thawing times by weight and cut so your food stays out of the bacterial danger zone.
          </p>
        </div>
      </div>
      <a
        href="/tools/meat-thawing-calculator/"
        class="shrink-0 inline-flex items-center justify-center gap-2 px-5 py-2.5 min-h-[44px] bg-primary text-on-primary text-[14px] font-medium rounded-lg hover:bg-primary-active transition-colors whitespace-nowrap"
      >
        <span>Meat Thawing Calculator</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <!-- Header, Instant Search & Verdict Filter Pills -->
    <div class="border-b border-hairline pb-8 mb-10">
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
        <div>
          <h2 class="text-display-md text-ink tracking-tight mb-2">Tested Items ({totalCount})</h2>
          <p class="text-body-md text-muted">Complete USDA-aligned refreezing evaluations for raw and cooked items.</p>
        </div>
        
        <!-- Instant Search Input -->
        <div class="w-full lg:max-w-[420px]">
          <div class="relative">
            <svg class="w-4 h-4 text-muted absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m0 0A7.5 7.5 0 1010.5 18a7.5 7.5 0 006.15-3.35z" />
            </svg>
            <input 
              type="text" 
              id="refreeze-search"
              autocomplete="off"
              placeholder="Search foods (e.g. Ground Beef, Chicken, Shrimp)..."
              aria-label="Search refreeze safety guides"
              class="w-full h-11 pl-10 pr-10 py-2 bg-canvas text-ink text-[16px] md:text-[14px] border border-hairline rounded-md focus:outline-none focus:border-info-border shadow-xs"
            />
            <button
              type="button"
              id="refreeze-clear"
              aria-label="Clear search"
              class="hidden absolute right-2 top-1/2 -translate-y-1/2 w-7 h-7 rounded-md text-muted hover:text-ink hover:bg-surface-soft inline-flex items-center justify-center transition-colors cursor-pointer"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>
        </div>
      </div>

      <!-- Verdict Filter Pills + Live Match Counter -->
      <div class="mt-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div id="refreeze-verdict-filters" class="flex flex-wrap gap-2" role="group" aria-label="Filter by safety verdict">
          <button
            type="button"
            data-verdict="all"
            aria-pressed="true"
            class="verdict-pill min-h-[40px] px-4 py-2 rounded-full text-[13px] font-medium border bg-primary text-on-primary border-primary cursor-pointer transition-colors inline-flex items-center gap-2 select-none"
          >
            <span>All</span>
            <span class="text-[11px] opacity-80">({totalCount})</span>
          </button>
          <button
            type="button"
            data-verdict="yes"
            aria-pressed="false"
            class="verdict-pill min-h-[40px] px-4 py-2 rounded-full text-[13px] font-medium border bg-canvas text-body border-hairline hover:border-border-strong hover:text-ink cursor-pointer transition-colors inline-flex items-center gap-2 select-none"
          >
            <span class="w-2 h-2 rounded-full bg-success shrink-0" aria-hidden="true"></span>
            <span>Safe / Yes</span>
            <span class="text-[11px] opacity-75">({yesCount})</span>
          </button>
          <button
            type="button"
            data-verdict="depends"
            aria-pressed="false"
            class="verdict-pill min-h-[40px] px-4 py-2 rounded-full text-[13px] font-medium border bg-canvas text-body border-hairline hover:border-border-strong hover:text-ink cursor-pointer transition-colors inline-flex items-center gap-2 select-none"
          >
            <span class="w-2 h-2 rounded-full bg-warning shrink-0" aria-hidden="true"></span>
            <span>Depends / Caution</span>
            <span class="text-[11px] opacity-75">({dependsCount})</span>
          </button>
          <button
            type="button"
            data-verdict="no"
            aria-pressed="false"
            class="verdict-pill min-h-[40px] px-4 py-2 rounded-full text-[13px] font-medium border bg-canvas text-body border-hairline hover:border-border-strong hover:text-ink cursor-pointer transition-colors inline-flex items-center gap-2 select-none"
          >
            <span class="w-2 h-2 rounded-full bg-error shrink-0" aria-hidden="true"></span>
            <span>Unsafe / No</span>
            <span class="text-[11px] opacity-75">({noCount})</span>
          </button>
        </div>

        <p
          id="refreeze-count"
          aria-live="polite"
          data-template="Showing {count} of {total} guides"
          class="text-xs font-medium text-muted shrink-0"
        >
          Showing {totalCount} of {totalCount} guides
        </p>
      </div>
    </div>

    <!-- Items Grid -->
    <div id="items-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {refreezeData.map(item => (
        <div 
          class="item-card bg-canvas border border-hairline rounded-md p-6 flex flex-col justify-between shadow-xs transition-all hover:border-border-strong"
          data-name={item.item.toLowerCase()}
          data-verdict={item.safe}
          data-search={`${item.item} ${item.shortAnswer} ${item.safe}`.toLowerCase()}
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-caption text-muted uppercase tracking-wider text-xs">Refreeze Guide</span>
              {item.safe === 'yes' && <span class="badge-yes">YES</span>}
              {item.safe === 'no' && <span class="badge-no">NO</span>}
              {item.safe === 'depends' && <span class="badge-depends">DEPENDS</span>}
            </div>
            
            <h3 class="text-title-sm text-ink mb-3">
              Can You Refreeze Thawed {item.item}?
            </h3>
            
            <p class="text-body-md text-body leading-relaxed mb-6">
              {item.shortAnswer}
            </p>
          </div>
          
          <a 
            href={`/refreeze/${item.slug}/`} 
            class="text-link text-[14px] font-medium hover:text-link-active transition-colors flex items-center gap-1 group mt-4"
          >
            Read refreeze details <span class="group-hover:translate-x-0.5 transition-transform">&rarr;</span>
          </a>
        </div>
      ))}
    </div>

    <!-- No results message -->
    <div id="no-results" class="hidden text-center py-12">
      <p class="text-title-md text-muted mb-4">No items match your search or verdict filter.</p>
      <button
        type="button"
        id="refreeze-reset"
        class="px-4 py-2 min-h-[40px] bg-canvas text-ink text-[13px] font-medium border border-hairline hover:border-border-strong rounded-md transition-colors cursor-pointer"
      >
        Reset filters
      </button>
    </div>
  </section>

  <!-- Related Categories Section -->
  <section class="border-t border-hairline bg-surface-soft/40 py-16">
    <div class="max-w-[1280px] mx-auto px-6">
      <h2 class="text-title-lg text-ink font-medium tracking-tight mb-8">Related Appliance & Safety Categories</h2>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
        <a href="/dishwasher/" class="p-5 bg-canvas border border-hairline rounded-md hover:border-border-strong shadow-xs text-decoration-none transition-colors active:scale-[0.98] block">
          <span class="text-xs uppercase tracking-wider text-muted font-bold block mb-1">Appliance Guide</span>
          <h3 class="text-title-sm text-ink mb-1 font-medium">Dishwasher</h3>
          <span class="text-xs text-link">Explore Guides &rarr;</span>
        </a>
        <a href="/microwave/" class="p-5 bg-canvas border border-hairline rounded-md hover:border-border-strong shadow-xs text-decoration-none transition-colors active:scale-[0.98] block">
          <span class="text-xs uppercase tracking-wider text-muted font-bold block mb-1">Appliance Guide</span>
          <h3 class="text-title-sm text-ink mb-1 font-medium">Microwave</h3>
          <span class="text-xs text-link">Explore Guides &rarr;</span>
        </a>
        <a href="/freezer/" class="p-5 bg-canvas border border-hairline rounded-md hover:border-border-strong shadow-xs text-decoration-none transition-colors active:scale-[0.98] block">
          <span class="text-xs uppercase tracking-wider text-muted font-bold block mb-1">Appliance Guide</span>
          <h3 class="text-title-sm text-ink mb-1 font-medium">Freezer</h3>
          <span class="text-xs text-link">Explore Guides &rarr;</span>
        </a>
        <a href="/oven/" class="p-5 bg-canvas border border-hairline rounded-md hover:border-border-strong shadow-xs text-decoration-none transition-colors active:scale-[0.98] block">
          <span class="text-xs uppercase tracking-wider text-muted font-bold block mb-1">Appliance Guide</span>
          <h3 class="text-title-sm text-ink mb-1 font-medium">Oven</h3>
          <span class="text-xs text-link">Explore Guides &rarr;</span>
        </a>
        <a href="/dryer/" class="p-5 bg-canvas border border-hairline rounded-md hover:border-border-strong shadow-xs text-decoration-none transition-colors active:scale-[0.98] block">
          <span class="text-xs uppercase tracking-wider text-muted font-bold block mb-1">Appliance Guide</span>
          <h3 class="text-title-sm text-ink mb-1 font-medium">Dryer</h3>
          <span class="text-xs text-link">Explore Guides &rarr;</span>
        </a>
        <a href="/airfryer/" class="p-5 bg-canvas border border-hairline rounded-md hover:border-border-strong shadow-xs text-decoration-none transition-colors active:scale-[0.98] block">
          <span class="text-xs uppercase tracking-wider text-muted font-bold block mb-1">Appliance Guide</span>
          <h3 class="text-title-sm text-ink mb-1 font-medium">Air Fryer</h3>
          <span class="text-xs text-link">Explore Guides &rarr;</span>
        </a>
        <a href="/refrigerator/" class="p-5 bg-canvas border border-hairline rounded-md hover:border-border-strong shadow-xs text-decoration-none transition-colors active:scale-[0.98] block">
          <span class="text-xs uppercase tracking-wider text-muted font-bold block mb-1">Appliance Guide</span>
          <h3 class="text-title-sm text-ink mb-1 font-medium">Refrigerator</h3>
          <span class="text-xs text-link">Explore Guides &rarr;</span>
        </a>
        
        <a href="/how-long/" class="p-5 bg-canvas border border-hairline rounded-md hover:border-border-strong shadow-xs text-decoration-none transition-colors active:scale-[0.98] block">
          <span class="text-xs uppercase tracking-wider text-muted font-bold block mb-1">Shelf Life Guide</span>
          <h3 class="text-title-sm text-ink mb-1 font-medium">Shelf Life & Storage</h3>
          <span class="text-xs text-link">Explore Guides &rarr;</span>
        </a>
        <a href="/washing-machine/" class="p-5 bg-canvas border border-hairline rounded-md hover:border-border-strong shadow-xs text-decoration-none transition-colors active:scale-[0.98] block">
          <span class="text-xs uppercase tracking-wider text-muted font-bold block mb-1">Fabric & Clothes</span>
          <h3 class="text-title-sm text-ink mb-1 font-medium">Washing Machine Guides</h3>
          <span class="text-xs text-link">Explore Guides &rarr;</span>
        </a>
        <a href="/what-happens/" class="p-5 bg-canvas border border-hairline rounded-md hover:border-border-strong shadow-xs text-decoration-none transition-colors active:scale-[0.98] block">
          <span class="text-xs uppercase tracking-wider text-muted font-bold block mb-1">Emergency Checklist</span>
          <h3 class="text-title-sm text-ink mb-1 font-medium">What Happens If...</h3>
          <span class="text-xs text-link">Explore Guides &rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Client-side filtering script -->
  <script is:inline>
    (() => {
      const searchInput = document.getElementById('refreeze-search');
      const clearBtn = document.getElementById('refreeze-clear');
      const resetBtn = document.getElementById('refreeze-reset');
      const countEl = document.getElementById('refreeze-count');
      const itemsGrid = document.getElementById('items-grid');
      const noResults = document.getElementById('no-results');
      const verdictButtons = Array.from(document.querySelectorAll('#refreeze-verdict-filters .verdict-pill'));

      if (!searchInput || !itemsGrid) return;

      const cards = Array.from(itemsGrid.getElementsByClassName('item-card'));
      const total = cards.length;
      const template = (countEl && countEl.getAttribute('data-template')) || 'Showing {count} of {total} guides';
      let activeVerdict = 'all';

      const setActiveButton = (verdict) => {
        verdictButtons.forEach((btn) => {
          const isSelected = btn.getAttribute('data-verdict') === verdict;
          btn.setAttribute('aria-pressed', isSelected ? 'true' : 'false');
          btn.classList.toggle('bg-primary', isSelected);
          btn.classList.toggle('text-on-primary', isSelected);
          btn.classList.toggle('border-primary', isSelected);
          btn.classList.toggle('bg-canvas', !isSelected);
          btn.classList.toggle('text-body', !isSelected);
          btn.classList.toggle('border-hairline', !isSelected);
          btn.classList.toggle('hover:border-border-strong', !isSelected);
          btn.classList.toggle('hover:text-ink', !isSelected);
        });
      };

      const applyFilter = () => {
        const query = searchInput.value.trim().toLowerCase();
        let matches = 0;

        for (let i = 0; i < total; i++) {
          const card = cards[i];
          const haystack = card.getAttribute('data-search') || card.getAttribute('data-name') || '';
          const verdict = card.getAttribute('data-verdict') || '';
          const matchesQuery = !query || haystack.includes(query);
          const matchesVerdict = activeVerdict === 'all' || verdict === activeVerdict;

          if (matchesQuery && matchesVerdict) {
            card.classList.remove('hidden');
            matches++;
          } else {
            card.classList.add('hidden');
          }
        }

        if (clearBtn) {
          clearBtn.classList.toggle('hidden', query.length === 0);
        }

        if (countEl) {
          countEl.textContent = template
            .replace('{count}', String(matches))
            .replace('{total}', String(total));
        }

        if (noResults) {
          noResults.classList.toggle('hidden', matches > 0);
        }
      };

      searchInput.addEventListener('input', applyFilter);

      verdictButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          activeVerdict = btn.getAttribute('data-verdict') || 'all';
          setActiveButton(activeVerdict);
          applyFilter();
        });
      });

      if (clearBtn) {
        clearBtn.addEventListener('click', () => {
          searchInput.value = '';
          applyFilter();
          searchInput.focus();
        });
      }

      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          searchInput.value = '';
          activeVerdict = 'all';
          setActiveButton('all');
          applyFilter();
          searchInput.focus();
        });
      }
    })();
  </script>
</Layout>
