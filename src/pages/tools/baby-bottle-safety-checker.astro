---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BabyBottleSafetyChecker from '../../components/BabyBottleSafetyChecker.astro';
import rawData from '../../data/baby-bottle-safety-data.json';

const pageTitle = "Baby Bottle, Sippy Cup & Kids Kitchenware Safety Checker (AAP/FDA/CDC) | IsItKitchenSafe";
const pageDescription = "Check microwave, dishwasher, steam sterilizer, UV-C, and freezer safety for 14 baby bottles, sippy cups, silicone plates, melamine bowls, pacifiers, and milk bags. Includes AAP/CDC breast milk & formula warming alerts.";

const faqs = rawData.faqs.en;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools/' },
  { label: 'Baby Bottle & Kids Kitchenware Safety Checker' }
];

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Baby Bottle, Sippy Cup & Kids Kitchenware Safety Checker",
  "url": "https://isitkitchensafe.com/tools/baby-bottle-safety-checker/",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript.",
  "description": pageDescription,
  "inLanguage": "en",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  faqs={faqs}
  excludeFaqSchema={true}
  availableLocales={['en', 'es', 'pt', 'zh-cn', 'ja']}
  lang="en"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1 print:hidden">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1140px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-signature-coral text-white mb-3">
        AAP · FDA · CDC Parent Safety Matrix
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        Baby Bottle, Sippy Cup &amp; Kids Kitchenware Safety Checker
      </h1>
      <p class="text-body text-[15px] md:text-[16px] leading-relaxed">
        Instantly check <strong>microwave, dishwasher, steam/boil sterilizer, UV-C, and freezer safety</strong> across 14 everyday nursery materials—from <strong>#5 PP, glass, silicone, and PPSU bottles</strong> to <strong>melamine/bamboo plates, insulated straw cups, pacifiers, and milk bags</strong>—with built-in AAP &amp; CDC milk-warming alerts.
      </p>
    </header>

    <!-- Main Interactive Checker, Related Links & 5 Visible FAQs -->
    <BabyBottleSafetyChecker lang="en" />
  </div>
</Layout>
