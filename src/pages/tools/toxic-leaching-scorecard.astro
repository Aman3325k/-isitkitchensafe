---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import KitchenwareToxicityScorecard from '../../components/KitchenwareToxicityScorecard.astro';

const pageTitle = "Kitchenware Toxic Leaching & PFAS Risk Scorecard | Heavy Metals & Microplastics Calculator | IsItKitchenSafe";
const pageDescription = "Calculate chemical leaching risks for non-stick Teflon, aluminum, ceramic, silicone, and cast iron. Science-backed risk scores for lead, cadmium, PFAS, and nanoplastics based on scratch wear, temperature, and food acidity.";

const faqs = [
  {
    question: "How does cooking temperature affect chemical leaching from pans?",
    answer: "Chemical reaction kinetics double for every 10°C rise in temperature (Arrhenius equation). For PTFE non-stick pans, thermal breakdown begins at 260°C (500°F) and evolves into hazardous fluoropolymer fumes at 348°C (660°F). For plastics and silicone, elevated heat accelerates polymer chain scission, leaching cyclic siloxanes and bisphenols into fatty foods."
  },
  {
    question: "Why should you never cook tomato sauce or lemon juice in raw aluminum or unlined copper?",
    answer: "Organic acids like citric, acetic, and malic acid aggressively corrode bare non-ferrous metals. Simmering acidic tomato sauce (pH ~4.0) in raw aluminum leaches up to 20–50 mg of aluminum ions per serving—surpassing EFSA weekly tolerable limits. In unlined copper, acid forms toxic copper salts (verdigris), inducing acute nausea and heavy metal poisoning."
  },
  {
    question: "Do scratched non-stick pans really release millions of microplastics?",
    answer: "Yes. Peer-reviewed research from Flinders University and the University of Newcastle (2022) using Raman spectroscopy confirmed that a single 5 cm surface scratch in a PTFE non-stick pan can release approximately 9,100 microplastic particles and up to 2.3 million sub-micron nanoplastic fragments directly into cooked food during ordinary stir-frying."
  },
  {
    question: "Is ceramic cookware truly 100% non-toxic and PFAS-free?",
    answer: "Genuine sol-gel mineral ceramic cookware (such as GreenPan and Caraway) is manufactured from silicon dioxide (SiO₂) sand and is completely free of PTFE, PFOA, PFOS, and synthetic fluoropolymers. However, low-fired decorative artisan ceramics may still leach heavy metals (lead and cadmium) if the glaze is improperly formulated or cracked."
  },
  {
    question: "Are stainless steel and cast iron completely free from chemical migration?",
    answer: "304/316 stainless steel is highly passivated with chromium oxide and is virtually inert, though prolonged simmering of acidic liquids can leach trace nickel (relevant only to individuals with severe systemic nickel allergies). Seasoned cast iron leaches bioavailable elemental iron (Fe²⁺/Fe³⁺), which is non-toxic and beneficial for most people, but contraindicated for individuals with hemochromatosis."
  }
];

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools/' },
  { label: 'Toxic Leaching & PFAS Risk Scorecard' }
];

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Kitchenware Toxic Leaching & PFAS Risk Scorecard",
  "url": "https://isitkitchensafe.com/tools/toxic-leaching-scorecard/",
  "applicationCategory": "HealthApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "description": pageDescription,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};
---

<Layout title={pageTitle} description={pageDescription} faqs={faqs} availableLocales={['en', 'es', 'pt', 'zh-cn', 'ja']}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1200px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-rose-600 text-white mb-3">
        Peer-Reviewed Toxicology &bull; Heavy Metals &bull; PFAS Degradation
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        Kitchenware Toxic Leaching &amp; PFAS Risk Scorecard
      </h1>
      <p class="text-body text-[15px] md:text-body-md leading-relaxed">
        Calculate chemical leaching risk and microplastic particle shedding for your cookware. Select your material, surface wear, cooking temperature, and food acidity to generate an instant laboratory risk index.
      </p>
    </header>

    <!-- Main Scorecard Calculator Component -->
    <div class="mb-14">
      <KitchenwareToxicityScorecard lang="en" />
    </div>

    <!-- Science Deep-Dive: Material Migration Mechanisms -->
    <section class="mb-14 border-t border-hairline pt-12 space-y-8">
      <div class="max-w-3xl">
        <span class="text-xs font-bold uppercase tracking-wider text-muted block mb-1">
          Material Science &bull; Chemical Kinetics &bull; Health Thresholds
        </span>
        <h2 class="text-title-lg md:text-display-sm font-medium text-ink tracking-tight mb-3">
          How Kitchenware Chemicals Migrate into Food
        </h2>
        <p class="text-body text-[15px] leading-relaxed">
          Chemical migration is governed by three primary physical drivers: thermal energy, chemical acidity (pH), and mechanical surface abrasion. Understanding these mechanisms helps eliminate chronic heavy metal and synthetic polymer exposure in daily cooking:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl bg-surface-soft border border-hairline space-y-3">
          <div class="w-9 h-9 rounded-xl bg-rose-600 text-white font-bold flex items-center justify-center text-sm">
            01
          </div>
          <h3 class="font-semibold text-ink text-base">Thermal Degradation &amp; Pyrolysis</h3>
          <p class="text-xs text-body leading-relaxed">
            Fluoropolymer coatings (PTFE) begin releasing microscopic particulate matter at 260°C (500°F). When preheating an empty dry pan on high heat, surface temperatures can exceed 370°C (700°F) within 3 minutes, emitting perfluorooctanoic acid byproducts and toxic pyrolysis gases that trigger polymer fume fever.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-surface-soft border border-hairline space-y-3">
          <div class="w-9 h-9 rounded-xl bg-amber-600 text-white font-bold flex items-center justify-center text-sm">
            02
          </div>
          <h3 class="font-semibold text-ink text-base">Acidic Chelation &amp; Ion Exchange</h3>
          <p class="text-xs text-body leading-relaxed">
            Acidic foods (pH &lt; 4.5) contain excess hydrogen ions (H⁺) that attack weak metallic and silicate bonds. In low-fired glazed ceramics and terracotta, acidic hot beverages (coffee, citrus) leach lead (Pb²⁺) and cadmium (Cd²⁺) through cation exchange, transferring toxic heavy metals directly into consumed liquid.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-surface-soft border border-hairline space-y-3">
          <div class="w-9 h-9 rounded-xl bg-blue-600 text-white font-bold flex items-center justify-center text-sm">
            03
          </div>
          <h3 class="font-semibold text-ink text-base">Mechanical Abrasion &amp; Shedding</h3>
          <p class="text-xs text-body leading-relaxed">
            Metal spatulas, forks, and abrasive scour pads fracture non-stick fluoropolymer and soft plastic matrices. As microscopic fractures propagate, shear forces from food stirring peel off sub-micron nanoplastic fragments that absorb dietary lipids and pass through the gastrointestinal mucosal barrier.
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="border-t border-hairline pt-12">
      <h2 class="text-title-lg md:text-display-sm font-medium text-ink tracking-tight mb-8">
        Frequently Asked Questions
      </h2>
      <div class="space-y-6 max-w-3xl">
        {faqs.map(faq => (
          <div class="border-b border-hairline pb-6">
            <h3 class="text-base font-semibold text-ink mb-2">
              {faq.question}
            </h3>
            <p class="text-body text-sm leading-relaxed">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>
