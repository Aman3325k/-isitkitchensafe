---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FoodAllergyCrossContactChecker from '../../components/FoodAllergyCrossContactChecker.astro';
import rawData from '../../data/food-allergy-cross-contact-data.json';

const pageTitle = "Kitchen Food Allergy & Cross-Contact Cleaning/Cookware Safety Checker | IsItKitchenSafe";
const pageDescription = "Check which shared kitchen appliances, cookware, and surfaces can be safely decontaminated for Top 9 FDA food allergens & Celiac disease. Step-by-step FDA/FARE cleaning protocols for toasters, air fryers, fryer oil, cast iron, wooden boards, sponges, and counters.";

const faqs = rawData.faqs.en;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools/' },
  { label: 'Food Allergy Cross-Contact Checker' }
];

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Kitchen Food Allergy & Cross-Contact Cleaning/Cookware Safety Checker",
  "url": "https://isitkitchensafe.com/tools/food-allergy-cross-contact-checker/",
  "applicationCategory": "HealthApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript.",
  "description": pageDescription,
  "inLanguage": "en",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  faqs={faqs}
  excludeFaqSchema={true}
  availableLocales={['en', 'es', 'pt', 'zh-cn', 'ja']}
  lang="en"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1 print:hidden">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1140px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-signature-coral text-white mb-3">
        FDA Top 9 Allergens &amp; Celiac · 10 Shared Surfaces · FARE Decontamination Guide
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        Kitchen Food Allergy &amp; Cross-Contact Safety Checker
      </h1>
      <p class="text-body text-[15px] md:text-[16px] leading-relaxed">
        Instantly verify whether shared <strong>toasters, air fryers, deep fryer oil, wooden cutting boards, cast iron skillets, stainless cookware, sponges, and countertops</strong> can be safely decontaminated for <strong>Top 9 FDA food allergens &amp; Celiac disease</strong>—with step-by-step soap-and-friction cleaning protocols and printable guest allergy prep checklists.
      </p>
    </header>

    <!-- Main Interactive Checker Component -->
    <FoodAllergyCrossContactChecker lang="en" />
  </div>
</Layout>
