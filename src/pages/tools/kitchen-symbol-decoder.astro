---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import KitchenSymbolDecoder from '../../components/KitchenSymbolDecoder.astro';

const pageTitle = "Kitchen Bottom Symbol Decoder | Plastic Codes #1–#7 & Appliance Icons | IsItKitchenSafe";
const pageDescription = "Instantly decode the stamped symbols on the bottom of bowls, Tupperware, cups, and pans. Check plastic recycling numbers #1–#7, microwave waves, wine glass & fork, and induction coil icons.";

const faqs = [
  {
    question: "What does the wine glass and fork symbol on the bottom of a container mean?",
    answer: "The wine glass and fork icon is the international Food Contact Safe certification (originating from EU Regulation EC 1935/2004). It certifies that the plastic, glass, ceramic, or silicone is food-grade and non-toxic for food contact under intended use—it does NOT automatically mean the item is dishwasher-safe or microwave-safe."
  },
  {
    question: "Which plastic recycling numbers (#1–#7) are safest for the microwave and dishwasher?",
    answer: "#5 PP (Polypropylene) is the most heat-resistant common consumer plastic (up to ~248°F / 120°C) and is widely used for reusable microwave- and dishwasher-safe food containers. #2 HDPE and #4 LDPE are safe for cold storage and freezing, while #1 PET, #3 PVC, #6 PS (Styrofoam), and unverified #7 plastics should never be microwaved or heated."
  },
  {
    question: "What do three wavy lines on the bottom of a bowl or mug mean?",
    answer: "Two or three stacked wavy horizontal lines (sometimes inside a square or above a dish) are the standard Microwave Safe symbol. They certify that the material will not melt, warp, or spark during normal microwave reheating. If the wavy lines have a diagonal slash or X through them, the item is strictly NOT microwave safe."
  },
  {
    question: "What does the looping coil or spring symbol on the bottom of a pan mean?",
    answer: "A horizontal row of four looping spirals is the universal Induction Compatible symbol. It confirms the cookware has a ferromagnetic iron or magnetic stainless-steel base that heats on electromagnetic induction cooktops (and works on gas and electric stoves as well)."
  },
  {
    question: "Does a 'BPA-Free' stamp mean I can safely microwave a plastic container?",
    answer: "No. 'BPA-Free' only means the plastic was manufactured without Bisphenol-A. It does not guarantee high-temperature stability, some BPA-free plastics contain chemical analogs such as BPS or BPF, and peer-reviewed studies show microwaving any plastic can still shed millions of micro- and nanoplastics into hot or oily food. Always check for an explicit Microwave Safe mark—or transfer hot food to glass or ceramic."
  }
];

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools/' },
  { label: 'Kitchen Symbol Decoder' }
];

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Kitchen Bottom Symbol Decoder",
  "url": "https://isitkitchensafe.com/tools/kitchen-symbol-decoder/",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript.",
  "description": pageDescription,
  "inLanguage": "en",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};

const plasticCheatSheet = [
  { code: "#1 PET / PETE", temp: "140°F / 60°C", microwave: "UNSAFE ❌", dishwasher: "UNSAFE ❌", notes: "Single-use water & soda bottles. Warps and leaches antimony when heated." },
  { code: "#2 HDPE", temp: "230°F / 110°C", microwave: "CAUTION ⚠️", dishwasher: "CAUTION ⚠️", notes: "Sturdy, BPA-free milk jugs & cutting boards. Safe cold; avoid high microwave heat." },
  { code: "#3 PVC", temp: "140°F / 60°C", microwave: "UNSAFE ❌", dishwasher: "UNSAFE ❌", notes: "Commercial cling wraps & vinyl. Leaches phthalates into hot or fatty foods." },
  { code: "#4 LDPE", temp: "176°F / 80°C", microwave: "UNSAFE ❌", dishwasher: "UNSAFE ❌", notes: "Flexible freezer zip bags & squeeze bottles. Great for freezer, low melt point." },
  { code: "#5 PP", temp: "248°F / 120°C", microwave: "CAUTION ⚠️", dishwasher: "SAFE ✅", notes: "Best reusable food plastic (Tupperware, yogurt tubs). Top-rack wash; prefer glass for hot oil." },
  { code: "#6 PS", temp: "165°F / 74°C", microwave: "UNSAFE ❌", dishwasher: "UNSAFE ❌", notes: "Styrofoam takeout boxes & foam cups. Releases styrene monomer when heated." },
  { code: "#7 Other", temp: "Varies (~212°F)", microwave: "UNSAFE ❌", dishwasher: "CAUTION ⚠️", notes: "Catch-all (Polycarbonate with BPA, BPA-free Tritan, or melt-prone PLA bioplastic)." }
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  excludeFaqSchema={true}
  availableLocales={['en', 'es', 'pt', 'zh-cn', 'ja']}
  lang="en"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1140px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-signature-coral text-white mb-3">
        Interactive Visual Reference
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        Kitchen Bottom Symbol Decoder
      </h1>
      <p class="text-body text-[15px] md:text-[16px] leading-relaxed">
        Flip over your bowl, cup, Tupperware, or pan and tap the exact mark stamped on the bottom. Instantly decode plastic resin codes (#1–#7), appliance pictograms, cooktop icons, and care warnings with a 5-appliance safety matrix.
      </p>
    </header>

    <!-- Main Interactive Tool -->
    <div class="mb-14">
      <KitchenSymbolDecoder lang="en" />
    </div>

    <!-- Plastic Resin Codes Cheat Sheet -->
    <section class="mb-14 space-y-5">
      <div>
        <h2 class="text-title-lg font-medium text-ink tracking-tight mb-2">
          Plastic Recycling Codes #1–#7 Kitchen Safety Cheat Sheet
        </h2>
        <p class="text-body text-[14.5px] leading-relaxed">
          Quick reference for the numbered chasing-arrows triangle stamped underneath food containers, bottles, and takeout packaging.
        </p>
      </div>

      <div class="border border-hairline rounded-xl overflow-hidden bg-canvas">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="bg-surface-strong border-b border-hairline text-ink font-semibold">
              <tr>
                <th class="p-3.5">Resin Code</th>
                <th class="p-3.5">Max Safe Temp</th>
                <th class="p-3.5">Microwave</th>
                <th class="p-3.5">Dishwasher</th>
                <th class="p-3.5">Key Kitchen Guidance</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-hairline">
              {plasticCheatSheet.map((row, idx) => (
                <tr class={idx % 2 === 0 ? 'bg-canvas' : 'bg-surface-soft'}>
                  <td class="p-3.5 font-semibold text-ink whitespace-nowrap">{row.code}</td>
                  <td class="p-3.5 text-body whitespace-nowrap">{row.temp}</td>
                  <td class="p-3.5 text-xs font-bold whitespace-nowrap text-ink">{row.microwave}</td>
                  <td class="p-3.5 text-xs font-bold whitespace-nowrap text-ink">{row.dishwasher}</td>
                  <td class="p-3.5 text-body text-[13px]">{row.notes}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Related Interactive Tools & Appliance Guides -->
    <section class="mb-14 grid grid-cols-1 md:grid-cols-2 gap-5">
      <a
        href="/tools/plasticizer-microplastic-burden-estimator/"
        class="p-6 rounded-2xl bg-surface-soft border border-hairline hover:border-signature-coral transition-all group block"
      >
        <span class="text-[11px] font-bold uppercase tracking-wider text-signature-coral block mb-1.5">
          Related Interactive Tool
        </span>
        <h3 class="text-title-sm font-semibold text-ink group-hover:text-signature-coral transition-colors mb-1.5">
          Plasticizer &amp; Microplastic Burden Estimator &rarr;
        </h3>
        <p class="text-[13.5px] text-body leading-relaxed">
          Estimate your household's daily microplastic and phthalate exposure from microwaving plastics, bottles, and cutting boards.
        </p>
      </a>

      <a
        href="/tools/pan-scratch-inspector/"
        class="p-6 rounded-2xl bg-surface-soft border border-hairline hover:border-signature-coral transition-all group block"
      >
        <span class="text-[11px] font-bold uppercase tracking-wider text-signature-coral block mb-1.5">
          Related Interactive Tool
        </span>
        <h3 class="text-title-sm font-semibold text-ink group-hover:text-signature-coral transition-colors mb-1.5">
          AI Pan Scratch &amp; Coating Inspector &rarr;
        </h3>
        <p class="text-[13.5px] text-body leading-relaxed">
          Check whether your scratched non-stick frying pan is still safe to cook on or shedding fluoropolymer particles.
        </p>
      </a>
    </section>

    <!-- Core Appliance Hub Strip -->
    <section class="mb-14 p-6 rounded-2xl bg-surface-soft border border-hairline">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <h2 class="text-title-sm font-semibold text-ink mb-1">
            Browse Complete Appliance Safety Directories
          </h2>
          <p class="text-[13px] text-muted">
            Check over 2,000+ specific cookware items, materials, and containers by appliance.
          </p>
        </div>
        <div class="flex flex-wrap gap-2">
          <a href="/dishwasher/" class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral transition-colors">Dishwasher</a>
          <a href="/microwave/" class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral transition-colors">Microwave</a>
          <a href="/oven/" class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral transition-colors">Oven</a>
          <a href="/freezer/" class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral transition-colors">Freezer</a>
          <a href="/airfryer/" class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral transition-colors">Air Fryer</a>
          <a href="/tools/" class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-primary text-on-primary hover:bg-primary-active transition-colors">All Tools &rarr;</a>
        </div>
      </div>
    </section>

    <!-- FAQ Section (5 Consumer-Friendly FAQs) -->
    <section class="mb-8">
      <h2 class="text-title-lg font-medium text-ink tracking-tight mb-6">
        Frequently Asked Questions About Kitchen Symbols
      </h2>
      <div class="space-y-4">
        {faqs.map(faq => (
          <details class="group p-5 bg-surface-soft border border-hairline rounded-xl" open>
            <summary class="text-title-sm font-semibold text-ink cursor-pointer list-none flex items-center justify-between gap-3">
              <span>{faq.question}</span>
              <span class="text-muted text-sm transition-transform group-open:rotate-180 shrink-0" aria-hidden="true">&#9662;</span>
            </summary>
            <p class="text-[14px] text-body leading-relaxed mt-3 pt-3 border-t border-hairline/70">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </div>
</Layout>
