---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CastIronSeasoningTroubleshooter from '../../components/CastIronSeasoningTroubleshooter.astro';
import rawData from '../../data/cast-iron-seasoning-troubleshooter-data.json';

const pageTitle = "Cast Iron & Carbon Steel Seasoning & Rust Troubleshooter | IsItKitchenSafe";
const pageDescription = "Diagnose sticky cast iron, orange dishwasher rust, flaking flaxseed seasoning, black wipe-off residue, tomato acid patches, sticking eggs, or cracks. Includes exact oven polymerization temps for 6 oils plus enameled cast iron warnings.";

const faqs = rawData.faqs.en;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools/' },
  { label: 'Cast Iron & Carbon Steel Seasoning Troubleshooter' }
];

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Cast Iron & Carbon Steel Seasoning & Rust Troubleshooter",
  "url": "https://isitkitchensafe.com/tools/cast-iron-seasoning-troubleshooter/",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript.",
  "description": pageDescription,
  "inLanguage": "en",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  faqs={faqs}
  excludeFaqSchema={true}
  availableLocales={['en', 'es', 'pt', 'zh-cn', 'ja']}
  lang="en"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1 print:hidden">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1140px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-signature-coral text-white mb-3">
        Bare Cast Iron · Carbon Steel · Enameled Safety
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        Cast Iron &amp; Carbon Steel Seasoning &amp; Rust Troubleshooter
      </h1>
      <p class="text-body text-[15px] md:text-[16px] leading-relaxed">
        Fix <strong>sticky surfaces, orange dishwasher rust, flaking flaxseed coats, black towel residue, acid patches, sticking eggs, or warped bottoms</strong> in minutes—complete with exact <strong>°F / °C oven polymerization temperatures</strong> for 6 seasoning oils and built-in <strong>Le Creuset / Staub enameled cast iron warnings</strong>.
      </p>
    </header>

    <!-- Main Interactive Troubleshooter, Oil Calculator, Related Links & 5 Visible FAQs -->
    <CastIronSeasoningTroubleshooter lang="en" />
  </div>
</Layout>
