---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CleanerMixingDangerChecker from '../../components/CleanerMixingDangerChecker.astro';

const pageTitle = "Kitchen Cleaner Mixing Danger Checker & Chemical Reaction Guide | IsItKitchenSafe";
const pageDescription = "Check toxic gas reactions and emergency triage protocols before mixing bleach, vinegar, ammonia, rubbing alcohol, hydrogen peroxide, and drain openers.";

const faqs = [
  {
    question: "Why is mixing bleach with vinegar so dangerous in a kitchen?",
    answer: "Household bleach contains sodium hypochlorite (NaClO), an alkaline oxidizer, while vinegar contains acetic acid (CH₃COOH). Combining an acid with bleach immediately drops the pH below 7, causing a rapid chemical reaction that releases toxic chlorine gas (Cl₂). When inhaled, chlorine gas reacts with the moisture on your respiratory membranes to synthesize hydrochloric and hypochlorous acids, which physically burn lung tissue, cause severe coughing, bronchial spasms, fluid in the lungs (pulmonary edema), and can be fatal in enclosed kitchens."
  },
  {
    question: "What deadly gas is produced when you mix bleach and ammonia?",
    answer: "Mixing chlorine bleach with household ammonia produces toxic chloramine vapors (predominantly monochloramine, NH₂Cl, and dichloramine, NHCl₂). Under certain ratios, it can even synthesize nitrogen trichloride (NCl₃), an unstable, explosive compound. Inhaling chloramine vapors causes intense chest pain, coughing, shortness of breath, chemical burns to the throat and eyes, and severe damage to the delicate alveoli in your lungs."
  },
  {
    question: "Does mixing baking soda with vinegar actually clean better?",
    answer: "No. While the immediate vigorous fizzing and bubbling looks impressive on social media, it is chemically counterproductive. Baking soda is an alkaline base (pH ~8.3) and vinegar is an acid (pH ~2.5). When combined, they rapidly neutralize each other, releasing harmless carbon dioxide gas (the bubbles). Once the bubbling subsides, you are left with water and sodium acetate salt, which has virtually no degreasing, mineral-dissolving, or antimicrobial power. It is far more effective to use baking soda as an abrasive scouring paste with dish soap, or vinegar alone to dissolve hard-water scale."
  },
  {
    question: "What should you do immediately if you accidentally mix bleach and an acid or ammonia?",
    answer: "1) EVACUATE IMMEDIATELY. Leave the room at once and do not stop to wipe up the spill. 2) Close the door behind you to prevent gas from traveling to the rest of the home. 3) Move outdoors into fresh air and breathe deeply. 4) NEVER attempt to 'neutralize' the mixture by dumping in a third product (like baking soda or soap). 5) If anyone is wheezing, vomiting, coughing violently, or faint, call emergency services (911 in US/Canada, 112 in EU, 999 in UK, 119 in Japan, 120 in China) or Poison Control (1-800-222-1222 in the US)."
  },
  {
    question: "Why should you never mix drain opener with vinegar, bleach, or other chemical cleaners?",
    answer: "Caustic drain cleaners contain concentrated sodium hydroxide (lye) or sulfuric acid, which produce intense heat upon contact with organic blockages and water. If you introduce an acid (like vinegar) or chlorine bleach into a clogged pipe treated with lye, an explosive acid-base neutralization or flash boiling reaction occurs. The trapped mixture can erupt violently upward out of the sink drain like a geyser, splashing boiling caustic chemicals onto your face, skin, and eyes, causing instant third-degree chemical burns and permanent blindness."
  }
];

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools/' },
  { label: 'Cleaner Mixing Danger Checker' }
];

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Kitchen Cleaner Mixing Danger Checker & Chemical Reaction Guide",
  "url": "https://isitkitchensafe.com/tools/cleaner-mixing-danger-checker/",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript.",
  "description": pageDescription,
  "inLanguage": "en",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
  excludeFaqSchema={true}
  availableLocales={['en', 'es', 'pt', 'zh-cn', 'ja']}
>
  <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={breadcrumbs} className="mb-0" />
    </div>
  </div>

  <main class="max-w-[1280px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="max-w-[880px] mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-rose-700 text-white mb-3">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <span>Household Chemical Toxicology & Emergency Triage Standards</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-heading tracking-tight mb-4">
        Kitchen Cleaner Mixing Danger Checker & Chemical Reaction Guide
      </h1>
      <p class="text-base sm:text-lg text-body-secondary leading-relaxed">
        Prevent accidental toxic gas emissions, explosive eruptions, and chemical burns in your home. Select any two household cleaning agents to instantly verify chemical reactivity, hazardous byproducts (chlorine, chloramine, chloroform, peracetic acid), exposure symptoms, and emergency evacuation protocols.
      </p>
    </header>

    <!-- Interactive Component -->
    <section class="mb-14">
      <CleanerMixingDangerChecker lang="en" />
    </section>

    <!-- Critical Chemical Safety Rules & E-E-A-T Guide -->
    <section class="mt-14 border-t border-hairline pt-12">
      <div class="max-w-[960px] mx-auto">
        <h2 class="text-2xl sm:text-3xl font-bold text-heading tracking-tight mb-4">
          Chemical Reaction Mechanisms & Kitchen Safety Science
        </h2>
        <p class="text-base text-body-secondary mb-8">
          Many everyday kitchen cleaning products contain powerful oxidizers, acids, and caustic bases that react violently when combined. Understanding the basic chemistry behind these interactions can save lives.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
          <div class="p-6 rounded-2xl bg-danger-soft border border-danger-hairline">
            <div class="flex items-start gap-3">
              <span class="text-2xl" aria-hidden="true">☠️</span>
              <div>
                <h3 class="font-bold text-red-900 dark:text-red-300 text-lg mb-1">
                  Bleach + Acid = Chlorine Gas (Cl₂)
                </h3>
                <p class="text-sm text-red-800 dark:text-red-200 leading-relaxed">
                  Combining bleach with vinegar, lemon juice, or toilet cleaner acid immediately releases toxic green-yellow chlorine gas. Chlorine gas reacts with moisture in lung tissue to form hydrochloric acid, destroying lung alveoli and causing acute respiratory distress.
                </p>
              </div>
            </div>
          </div>

          <div class="p-6 rounded-2xl bg-danger-soft border border-danger-hairline">
            <div class="flex items-start gap-3">
              <span class="text-2xl" aria-hidden="true">⚠️</span>
              <div>
                <h3 class="font-bold text-red-900 dark:text-red-300 text-lg mb-1">
                  Bleach + Ammonia = Chloramine Vapors
                </h3>
                <p class="text-sm text-red-800 dark:text-red-200 leading-relaxed">
                  Ammonia found in glass cleaners, degreasers, and urine reacts with sodium hypochlorite to create chloramine gases (NH₂Cl and NHCl₂). Symptoms can begin immediately or emerge hours after exposure as chemical pneumonia.
                </p>
              </div>
            </div>
          </div>

          <div class="p-6 rounded-2xl bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-900/40">
            <div class="flex items-start gap-3">
              <span class="text-2xl" aria-hidden="true">🧪</span>
              <div>
                <h3 class="font-bold text-amber-900 dark:text-amber-300 text-lg mb-1">
                  Hydrogen Peroxide + Vinegar = Peracetic Acid
                </h3>
                <p class="text-sm text-amber-800 dark:text-amber-200 leading-relaxed">
                  Mixing 3% hydrogen peroxide and vinegar in the same bottle generates peracetic acid. In higher concentrations, it is severely corrosive to eyes, skin, and mucosal tissues, and can explode sealed spray bottles from gas buildup.
                </p>
              </div>
            </div>
          </div>

          <div class="p-6 rounded-2xl bg-surface-soft border border-hairline">
            <div class="flex items-start gap-3">
              <span class="text-2xl" aria-hidden="true">💡</span>
              <div>
                <h3 class="font-bold text-heading text-lg mb-1">
                  The Safe Consecutive Cleaning Rule
                </h3>
                <p class="text-sm text-body-secondary leading-relaxed">
                  You can safely use different cleaners on the same kitchen surface if you follow the consecutive rule: clean thoroughly with the first product, rinse the surface with plain water, wipe dry, and only then apply the second product.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- FAQ Section -->
        <div class="mt-12">
          <h2 class="text-2xl sm:text-3xl font-bold text-heading tracking-tight mb-6">
            Frequently Asked Questions: Cleaner Safety & First Aid
          </h2>
          <div class="space-y-4">
            {faqs.map((faq) => (
              <details class="group p-5 rounded-xl border border-hairline bg-surface-soft open:bg-surface-elevated transition-colors">
                <summary class="font-bold text-heading cursor-pointer list-none flex items-center justify-between gap-4">
                  <span>{faq.question}</span>
                  <span class="text-signature-teal group-open:rotate-180 transition-transform text-lg leading-none" aria-hidden="true">▾</span>
                </summary>
                <p class="mt-3 text-sm text-body-secondary leading-relaxed border-t border-hairline pt-3">
                  {faq.answer}
                </p>
              </details>
            ))}
          </div>
        </div>

        <!-- Related Consumer Tools -->
        <div class="mt-12 pt-8 border-t border-hairline">
          <h3 class="text-lg font-bold text-heading mb-4">Related Consumer Kitchen Safety Tools</h3>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <a href="/tools/appliance-descaling-calculator/" class="p-4 rounded-xl border border-hairline bg-surface-soft hover:border-signature-teal transition-all group">
              <span class="text-xs font-semibold text-signature-teal block mb-1">Appliance Maintenance</span>
              <span class="font-bold text-heading text-sm group-hover:text-signature-teal block">Coffee & Kettle Descaling Calculator →</span>
              <p class="text-xs text-body-secondary mt-1">Calculate safe citric acid vs vinegar ratios and boil schedules without damaging seals.</p>
            </a>
            <a href="/tools/kitchen-symbol-decoder/" class="p-4 rounded-xl border border-hairline bg-surface-soft hover:border-signature-teal transition-all group">
              <span class="text-xs font-semibold text-signature-teal block mb-1">Kitchen Bottom Symbols</span>
              <span class="font-bold text-heading text-sm group-hover:text-signature-teal block">Kitchen Symbol Decoder →</span>
              <p class="text-xs text-body-secondary mt-1">Decode dishwasher-safe, food-contact, and plastic recycling marks #1 through #7.</p>
            </a>
            <a href="/tools/internal-cooking-temp-chart/" class="p-4 rounded-xl border border-hairline bg-surface-soft hover:border-signature-teal transition-all group">
              <span class="text-xs font-semibold text-signature-teal block mb-1">USDA Food Safety</span>
              <span class="font-bold text-heading text-sm group-hover:text-signature-teal block">Internal Cooking Temp Chart →</span>
              <p class="text-xs text-body-secondary mt-1">USDA safe minimum internal temperatures and resting times for poultry, beef, and pork.</p>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
