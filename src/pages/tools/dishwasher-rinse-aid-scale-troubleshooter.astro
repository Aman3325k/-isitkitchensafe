---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import DishwasherRinseAidScaleTroubleshooter from '../../components/DishwasherRinseAidScaleTroubleshooter.astro';
import rawData from '../../data/dishwasher-rinse-aid-scale-data.json';

const pageTitle = "Dishwasher Rinse Aid, Surfactant & Hard Water Scale Troubleshooter | IsItKitchenSafe";
const pageDescription = "Diagnose cloudy glassware with the 5-minute vinegar test (mineral scale vs. permanent etching), verify rinse aid gut safety and residential dilution, calibrate dispenser dials per water hardness, and follow safe citric acid descaling.";

const faqs = rawData.faqs.en;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools/' },
  { label: 'Dishwasher Rinse Aid & Scale Troubleshooter' }
];

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Dishwasher Rinse Aid, Surfactant & Hard Water Scale Troubleshooter",
  "url": "https://isitkitchensafe.com/tools/dishwasher-rinse-aid-scale-troubleshooter/",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript.",
  "description": pageDescription,
  "inLanguage": "en",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  faqs={faqs}
  excludeFaqSchema={true}
  availableLocales={['en', 'es', 'pt', 'zh-cn', 'ja']}
  lang="en"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1 print:hidden">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1140px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-signature-coral text-white mb-3">
        AHAM DW-1 · JACI Gut Barrier Study · USGS Water Hardness · Citric Acid Protocol
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        Dishwasher Rinse Aid, Surfactant &amp; Hard Water Scale Troubleshooter
      </h1>
      <p class="text-body text-[15px] md:text-[16px] leading-relaxed">
        Stop guessing why your glasses are cloudy: run the <strong>5-minute vinegar soak test</strong> to separate removable calcium scale from permanent glass etching, calibrate your <strong>rinse aid dispenser dial</strong> by water hardness (GPG/PPM), understand <strong>gut barrier surfactant facts</strong>, and follow <strong>safe citric acid appliance descaling</strong>.
      </p>
    </header>

    <!-- Main Interactive Checker Component -->
    <DishwasherRinseAidScaleTroubleshooter lang="en" />
  </div>
</Layout>
