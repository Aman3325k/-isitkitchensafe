---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PlasticCodeChecker from '../../components/PlasticCodeChecker.astro';

const pageTitle = "Plastic Recycling Code (#1–#7) Kitchen Safety Checker | IsItKitchenSafe";
const pageDescription = "Interactive kitchen safety lookup for plastic recycling codes #1 through #7 (PET, HDPE, PVC, LDPE, PP, PS, Polycarbonate, Tritan & PLA). Check microwave, dishwasher, freezer, and hot liquid thermal safety limits.";

const faqs = [
  {
    question: "Which plastic recycling codes are safe to microwave?",
    answer: "Code #5 Polypropylene (PP) is the gold standard and the only widely approved general plastic for microwave food reheating. It safely withstands temperatures up to 265°F (130°C) with a melting point of 330°F (165°C), and contains no BPA or phthalate plasticizers. Never microwave Code #1 PET (melts and leaches antimony at 140°F), Code #3 PVC (releases endocrine-disrupting phthalates), Code #6 Polystyrene / Styrofoam (leaches toxic styrene monomer into fatty foods), or legacy Code #7 Polycarbonate (accelerates Bisphenol-A hydrolysis)."
  },
  {
    question: "Can plastic food storage containers go in the dishwasher safely?",
    answer: "Resins #2 HDPE, #5 PP, and modern #7 Tritan are top-rack dishwasher safe and resist aggressive alkaline dishwasher detergents. However, thin single-use plastics—specifically #1 PET berry containers, #6 PS clear cutlery, and #7 PLA bioplastics—warp, shrink, or cloud instantly when exposed to the hot wash cycle (130°F–155°F) or heated drying coils. For maximum lifespan and zero microplastic shedding, place all reusable plastic lids and containers strictly on the top rack away from exposed bottom heating elements."
  },
  {
    question: "What do the recycling numbers 1 through 7 on the bottom of containers mean?",
    answer: "The numbers inside the chasing-arrows recycling triangle are ASTM D7611 Resin Identification Codes (RIC). They tell recyclers and consumers the exact chemical base polymer of the container: #1 is PET (water and soda bottles), #2 is HDPE (milk jugs and cutting boards), #3 is PVC (cling wrap and industrial piping), #4 is LDPE (bread bags and squeeze bottles), #5 is PP (yogurt tubs, takeout containers, and Tupperware), #6 is PS (Styrofoam and rigid disposable cutlery), and #7 is OTHER (a diverse category spanning older BPA-bearing Polycarbonate, safe modern Tritan copolyester, and compostable plant-based PLA)."
  },
  {
    question: "Which plastic numbers contain BPA, phthalates, or dangerous chemical additives?",
    answer: "Code #3 PVC contains heavy loadings (up to 30%–40% by weight) of phthalate plasticizers (such as DEHP and DINP) to make the resin flexible. Code #7 Polycarbonate is synthesized with Bisphenol-A (BPA), which leaches exponentially faster when heated or washed with harsh detergents. Conversely, Code #1 PET, #2 HDPE, #4 LDPE, and #5 PP do not require plasticizers and are inherently free of BPA. Modern #7 Tritan is independently certified free of BPA, BPS, and all estrogenic activity (EA)."
  },
  {
    question: "Is it safe to pour boiling water or piping hot soup into plastic containers?",
    answer: "Only #5 Polypropylene (PP) and #7 Tritan can safely tolerate boiling liquids (212°F / 100°C) without chemical breakdown or catastrophic warping. Never pour boiling soup, hot coffee, or tea into #1 PET (softens at 140°F / 60°C and leaches antimony), #6 Styrofoam (breaks down releasing styrene), or #7 PLA bioplastic (melts and collapses above 115°F / 46°C). When transferring boiling hot stews or bone broths, use heat-resistant borosilicate glass or 304 food-grade stainless steel containers."
  }
];

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools/' },
  { label: 'Plastic Code Checker' }
];

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Plastic Recycling Code (#1–#7) Kitchen Safety Checker",
  "url": "https://isitkitchensafe.com/tools/plastic-code-checker/",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript.",
  "description": pageDescription,
  "inLanguage": "en",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  excludeFaqSchema={true}
  availableLocales={['en', 'es', 'pt', 'zh-cn', 'ja']}
  lang="en"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1140px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-indigo-700 text-white mb-3">
        Food Contact Toxicology &amp; Polymer Safety
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        Plastic Recycling Code (#1–#7) Kitchen Safety Checker
      </h1>
      <p class="text-body text-[15px] md:text-[16px] leading-relaxed">
        Check any plastic resin number (1 through 7) on the bottom of takeout boxes, Tupperware, water bottles, and food packaging. Instantly verify thermal limits (-60°F to 500°F), microwave heating verdicts, dishwasher durability, freezer resistance, and chemical leaching risks (BPA, phthalates, antimony &amp; microplastics) grounded in FDA 21 CFR 177 and ASTM D7611 standards.
      </p>
    </header>

    <!-- Main Interactive Tool Component -->
    <div class="mb-14">
      <PlasticCodeChecker lang="en" />
    </div>

    <!-- Related Kitchen Tools & Verification Guides -->
    <section class="mb-14 grid grid-cols-1 md:grid-cols-2 gap-5">
      <a
        href="/tools/kitchen-symbol-decoder/"
        class="p-6 rounded-2xl bg-surface-soft border border-hairline hover:border-indigo-600 transition-all group block"
      >
        <span class="text-[11px] font-bold uppercase tracking-wider text-indigo-700 dark:text-indigo-400 block mb-1.5">
          Companion Interactive Tool
        </span>
        <h3 class="text-title-sm font-semibold text-ink group-hover:text-indigo-600 transition-colors mb-1.5">
          Kitchen Bottom Symbol Decoder &rarr;
        </h3>
        <p class="text-[13.5px] text-body leading-relaxed">
          Decipher wavy lines, dishwasher racks, wine glasses, snowflakes, and induction coil icons embossed on the underside of cookware, mugs, and plates.
        </p>
      </a>

      <a
        href="/tools/pan-scratch-inspector/"
        class="p-6 rounded-2xl bg-surface-soft border border-hairline hover:border-indigo-600 transition-all group block"
      >
        <span class="text-[11px] font-bold uppercase tracking-wider text-indigo-700 dark:text-indigo-400 block mb-1.5">
          Cookware Safety Analyzer
        </span>
        <h3 class="text-title-sm font-semibold text-ink group-hover:text-indigo-600 transition-colors mb-1.5">
          AI Pan Scratch Inspector &rarr;
        </h3>
        <p class="text-[13.5px] text-body leading-relaxed">
          Evaluate scratched Teflon, ceramic, cast iron, and stainless steel cookware for fluoropolymer PTFE off-gassing and heavy metal migration.
        </p>
      </a>
    </section>

    <!-- Core Appliance Directory Strip -->
    <section class="mb-14 p-6 rounded-2xl bg-surface-soft border border-hairline">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <h2 class="text-title-sm font-semibold text-ink mb-1">
            Explore Verified Appliance Safety &amp; Material Hubs
          </h2>
          <p class="text-[13px] text-muted">
            Evidence-based temperature ratings, thermal shock limits, and chemical safety across every kitchen appliance.
          </p>
        </div>
        <div class="flex flex-wrap gap-2">
          <a href="/microwave/" class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-indigo-600 transition-colors">Microwave Guide</a>
          <a href="/dishwasher/" class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-indigo-600 transition-colors">Dishwasher Guide</a>
          <a href="/freezer/" class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-indigo-600 transition-colors">Freezer Guide</a>
          <a href="/refrigerator/" class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-indigo-600 transition-colors">Refrigerator Guide</a>
          <a href="/methodology/" class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-indigo-600 transition-colors">Methodology</a>
          <a href="/tools/" class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-primary text-on-primary hover:bg-primary-active transition-colors">All Tools &rarr;</a>
        </div>
      </div>
    </section>

    <!-- FAQ Accordion Section (Visible E-E-A-T Content) -->
    <section class="mb-8">
      <div class="border-b border-hairline pb-4 mb-6">
        <span class="text-xs font-bold uppercase tracking-wider text-indigo-700 dark:text-indigo-400 block mb-1">
          Evidence-Based Polymer Science &amp; Food Safety Q&amp;A
        </span>
        <h2 class="text-title-lg font-medium text-ink tracking-tight">
          Frequently Asked Questions on Plastic Recycling Codes &amp; Food Safety
        </h2>
        <p class="text-xs text-muted mt-1">
          Grounded in FDA 21 CFR 177 regulations, ASTM D7611 standards, and EFSA food contact material safety assessments.
        </p>
      </div>

      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="group p-5 bg-surface-soft border border-hairline rounded-xl" open>
            <summary class="text-title-sm font-semibold text-ink cursor-pointer list-none flex items-center justify-between gap-3">
              <span>{faq.question}</span>
              <span class="text-muted text-sm transition-transform group-open:rotate-180 shrink-0" aria-hidden="true">&#9662;</span>
            </summary>
            <p class="text-[14px] text-body leading-relaxed mt-3 pt-3 border-t border-hairline/70">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </div>
</Layout>
