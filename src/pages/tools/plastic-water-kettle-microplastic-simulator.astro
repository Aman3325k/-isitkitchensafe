---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PlasticWaterKettleMicroplasticSimulator from '../../components/PlasticWaterKettleMicroplasticSimulator.astro';
import rawData from '../../data/plastic-water-kettle-microplastic-data.json';

const pageTitle = "Plastic Water Kettle Micro-Crack & Leaching Simulator | IsItKitchenSafe";
const pageDescription = "Calculate microplastic particle shedding (particles/L) and nickel leaching from polypropylene electric kettles, micro-crack degradation, boiling cycles, and acidic descaling. Nature Food (2020) & WHO standards.";

const faqs = rawData.faqs.en;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools/' },
  { label: 'Plastic Water Kettle Microplastic Simulator' }
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://isitkitchensafe.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Tools",
      "item": "https://isitkitchensafe.com/tools/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Plastic Water Kettle Microplastic Simulator",
      "item": "https://isitkitchensafe.com/tools/plastic-water-kettle-microplastic-simulator/"
    }
  ]
};

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Plastic Water Kettle Micro-Crack Heating Element Leaching Simulator",
  "url": "https://isitkitchensafe.com/tools/plastic-water-kettle-microplastic-simulator/",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "description": pageDescription,
  "inLanguage": "en",
  "isAccessibleForFree": true,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com",
    "logo": {
      "@type": "ImageObject",
      "url": "https://isitkitchensafe.com/favicon.svg"
    }
  },
  "author": {
    "@type": "Person",
    "name": "Marcus Vance",
    "jobTitle": "Lead Hardware & Materials Analyst",
    "url": "https://isitkitchensafe.com/about/#editorial-board",
    "sameAs": "https://isitkitchensafe.com/about/",
    "affiliation": {
      "@type": "Organization",
      "name": "IsItKitchenSafe",
      "url": "https://isitkitchensafe.com"
    }
  },
  "reviewedBy": {
    "@type": "Person",
    "name": "Dr. Elena Rostova",
    "jobTitle": "Food Toxicology & Storage Contributor",
    "honorificPrefix": "Dr.",
    "url": "https://isitkitchensafe.com/about/#editorial-board",
    "sameAs": "https://isitkitchensafe.com/about/",
    "affiliation": {
      "@type": "Organization",
      "name": "IsItKitchenSafe",
      "url": "https://isitkitchensafe.com"
    }
  },
  "citation": [
    {
      "@type": "ScholarlyArticle",
      "name": "Microplastic release from the degradation of polypropylene feeding bottles and water kettles during infant formula preparation and water boiling",
      "headline": "Microplastic release from polypropylene feeding bottles and water kettles",
      "author": {
        "@type": "Organization",
        "name": "Nature Food (2020)"
      },
      "url": "https://www.nature.com/articles/s43016-020-00171-y",
      "datePublished": "2020-10-19"
    },
    {
      "@type": "ScholarlyArticle",
      "name": "Guidelines for Drinking-water Quality: Fourth Edition Incorporating the First and Second Addenda - Nickel Guidance Level",
      "headline": "World Health Organization Nickel in Drinking-water Evaluation",
      "author": {
        "@type": "Organization",
        "name": "World Health Organization (WHO)"
      },
      "url": "https://www.who.int/publications/i/item/9789240045064"
    },
    {
      "@type": "Legislation",
      "name": "Commission Regulation (EU) No 10/2011 on plastic materials and articles intended to come into contact with food",
      "legislationIdentifier": "Regulation (EU) No 10/2011",
      "legislationPassedBy": {
        "@type": "Organization",
        "name": "European Commission"
      },
      "url": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX%3A32011R0010"
    }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  faqs={faqs}
  excludeFaqSchema={true}
  excludeBreadcrumbSchema={true}
  availableLocales={['en', 'es', 'pt', 'zh-cn', 'ja']}
  lang="en"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1 print:hidden">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6">
      <Breadcrumbs items={breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1140px] mx-auto px-4 sm:px-6 py-8 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-signature-coral text-white mb-3">
        Nature Food (2020) Study · WHO Drinking Water Guideline · EU Regulation 10/2011
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        Plastic Water Kettle Micro-Crack &amp; Leaching Simulator
      </h1>
      <p class="text-body text-[15px] md:text-[16px] leading-relaxed">
        Stop boiling in the dark: calculate <strong>microplastic particle shedding (1.3M–16.2M part./L)</strong> and <strong>heavy metal nickel leaching (µg/L)</strong> caused by polypropylene thermal fatigue, interior surface micro-crazing, exposed heating coils, and acidic descaling treatments.
      </p>

      <!-- E-E-A-T Author, Scientific Review & Regulatory Citations Byline -->
      <div class="mt-5 flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-xs text-muted border-t border-hairline/60 pt-4 max-w-2xl mx-auto">
        <span class="inline-flex items-center gap-1.5">
          <span class="font-semibold text-ink">Author:</span> Marcus Vance (Materials Analyst)
        </span>
        <span class="text-hairline" aria-hidden="true">&bull;</span>
        <span class="inline-flex items-center gap-1.5">
          <span class="font-semibold text-ink">Scientific Review:</span> Dr. Elena Rostova, Ph.D.
        </span>
        <span class="text-hairline" aria-hidden="true">&bull;</span>
        <a href="/methodology/" class="text-link underline hover:text-link-active transition-colors">
          Methodology &amp; Standards
        </a>
      </div>
    </header>

    <!-- Main Interactive Simulator Component -->
    <PlasticWaterKettleMicroplasticSimulator lang="en" />
  </div>
</Layout>
