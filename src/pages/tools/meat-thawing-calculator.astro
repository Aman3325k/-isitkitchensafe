---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import MeatThawingCalculator from '../../components/MeatThawingCalculator.astro';

const pageTitle = "USDA Meat & Turkey Safe Thawing Time Calculator | IsItKitchenSafe";
const pageDescription = "Calculate exact USDA FSIS safe defrosting times and Start Thawing By dates for whole turkey, chicken, beef roast, ground meat, ham, and fish. Compare refrigerator, cold water, microwave, and cook-from-frozen timelines.";

const faqs = [
  {
    question: "How long does it take to thaw a frozen turkey in the refrigerator?",
    answer: "Under USDA FSIS guidelines, plan for 24 hours of refrigerator thawing (at 40°F / 4°C or below) for every 4 to 5 pounds of whole turkey. For example, a 16-pound Thanksgiving turkey needs 3 to 4 full days in the fridge, and a 20-pound turkey needs 4 to 5 days. Once fully thawed in the refrigerator, a raw turkey stays safe for an additional 1 to 2 days before roasting."
  },
  {
    question: "Why is it unsafe to thaw frozen meat or poultry on the kitchen counter?",
    answer: "Even when the center of a roast or turkey is still rock-solid ice, the outer layer warms above 40°F (4°C) into the USDA Temperature Danger Zone (40°F–140°F / 4°C–60°C) within about 2 hours. Foodborne pathogens like Salmonella, E. coli, and Staphylococcus aureus can double every 20 minutes on the warm exterior and even produce heat-resistant toxins that normal cooking may not destroy."
  },
  {
    question: "How does the USDA Cold Water Thawing method work?",
    answer: "Place frozen meat inside a leak-proof zip-top bag and submerge it completely in cold tap water (never warm or hot water). Plan for roughly 30 minutes per pound (for example, 8 hours for a 16 lb turkey or 1–1.5 hours for 2 lbs of ground beef) and drain and replace the cold water every 30 minutes so the bath stays cold. Meat thawed in cold water must be cooked immediately after defrosting."
  },
  {
    question: "Why must vacuum-sealed fish be removed from its plastic pouch before thawing?",
    answer: "Vacuum-sealed or Reduced Oxygen Packaging (ROP) removes oxygen from around fish fillets. If vacuum-sealed fish thaws inside its sealed pouch—even inside a cold refrigerator—anaerobic Clostridium botulinum spores can germinate and produce lethal botulinum toxin without any off-odor or visible spoilage. Always slit or remove the vacuum pouch before thawing fish."
  },
  {
    question: "Can I refreeze thawed meat, or cook frozen meat without thawing it first?",
    answer: "Yes to both, with important USDA rules. Raw meat or poultry thawed strictly in the refrigerator (≤40°F / 4°C) can be safely refrozen without cooking, though moisture loss may slightly affect texture. Meat thawed in cold water or a microwave must be cooked before refreezing. You can also safely cook meat directly from frozen in an oven, skillet, air fryer, or pressure cooker—simply allow at least 50% longer cooking time, and never put solid frozen raw meat into a slow cooker."
  }
];

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools/' },
  { label: 'Meat & Turkey Thawing Calculator' }
];

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "USDA Meat & Turkey Safe Thawing Time Calculator",
  "url": "https://isitkitchensafe.com/tools/meat-thawing-calculator/",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript.",
  "description": pageDescription,
  "inLanguage": "en",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};

const quickChart = [
  { cut: "Whole Turkey (16 lb)", fridge: "3–4 days (24h / 4–5 lb)", coldWater: "~8 hrs (30 min/lb)", postThaw: "1–2 days", temp: "165°F (74°C)" },
  { cut: "Whole Chicken (5 lb)", fridge: "24–30 hrs", coldWater: "~2.5 hrs", postThaw: "1–2 days", temp: "165°F (74°C)" },
  { cut: "Boneless Chicken (2 lb)", fridge: "24 hrs", coldWater: "~1–1.5 hrs", postThaw: "1–2 days", temp: "165°F (74°C)" },
  { cut: "Beef / Pork Roast (4 lb)", fridge: "24–26 hrs", coldWater: "~2 hrs", postThaw: "3–5 days", temp: "145°F (63°C) + 3m rest" },
  { cut: "Ground Beef / Turkey (2 lb)", fridge: "24 hrs", coldWater: "~1–1.5 hrs", postThaw: "1–2 days", temp: "160°F beef · 165°F poultry" },
  { cut: "Whole Raw Ham (10 lb)", fridge: "2–2.5 days (4–6h / lb)", coldWater: "~5 hrs", postThaw: "3–5 days", temp: "145°F (63°C) + 3m rest" },
  { cut: "Fish Fillets & Shrimp (1.5 lb)", fridge: "12–18 hrs (unseal pouch!)", coldWater: "~45 min", postThaw: "1–2 days", temp: "145°F (63°C)" }
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  excludeFaqSchema={true}
  availableLocales={['en', 'es', 'pt', 'zh-cn', 'ja']}
  lang="en"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1140px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-signature-coral text-white mb-3">
        USDA FSIS Safe Defrosting Tool
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        Meat &amp; Turkey Safe Thawing Time Calculator
      </h1>
      <p class="text-body text-[15px] md:text-[16px] leading-relaxed">
        Planning a Thanksgiving turkey, Sunday pot roast, or weeknight chicken dinner? Pick your cut, weight (lbs or kg), and target cook time to get an exact <strong>Start Thawing By</strong> schedule across all four USDA-approved defrosting methods—plus safe internal temperatures and safety checklists.
      </p>
    </header>

    <!-- Main Interactive Calculator -->
    <div class="mb-14">
      <MeatThawingCalculator lang="en" />
    </div>

    <!-- USDA Safe Thawing Quick Reference Chart -->
    <section class="mb-14 space-y-5">
      <div>
        <h2 class="text-title-lg font-medium text-ink tracking-tight mb-2">
          USDA Safe Meat Defrosting Quick Reference Chart
        </h2>
        <p class="text-body text-[14.5px] leading-relaxed">
          Reference times assume a properly calibrated refrigerator at <strong>40°F (4°C) or colder</strong> and cold water refreshed every <strong>30 minutes</strong>. Review how we cite federal food safety guidelines in our <a href="/methodology/" class="text-link underline hover:text-link-active">Methodology</a>.
        </p>
      </div>

      <div class="border border-hairline rounded-xl overflow-hidden bg-canvas">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="bg-surface-strong border-b border-hairline text-ink font-semibold">
              <tr>
                <th class="p-3.5">Cut &amp; Sample Weight</th>
                <th class="p-3.5">Fridge (≤40°F)</th>
                <th class="p-3.5">Cold Water Bath</th>
                <th class="p-3.5">Post-Thaw Fridge</th>
                <th class="p-3.5">Safe Internal Temp</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-hairline">
              {quickChart.map((row, idx) => (
                <tr class={idx % 2 === 0 ? 'bg-canvas' : 'bg-surface-soft'}>
                  <td class="p-3.5 font-semibold text-ink whitespace-nowrap">{row.cut}</td>
                  <td class="p-3.5 text-body whitespace-nowrap font-medium">{row.fridge}</td>
                  <td class="p-3.5 text-body whitespace-nowrap">{row.coldWater}</td>
                  <td class="p-3.5 text-body whitespace-nowrap">{row.postThaw}</td>
                  <td class="p-3.5 text-body text-[13px] whitespace-nowrap">{row.temp}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Related Tools & Storage Guides -->
    <section class="mb-14 grid grid-cols-1 md:grid-cols-2 gap-5">
      <a
        href="/tools/leftover-shelf-life-calculator/"
        class="p-6 rounded-2xl bg-surface-soft border border-hairline hover:border-signature-coral transition-all group block"
      >
        <span class="text-[11px] font-bold uppercase tracking-wider text-signature-coral block mb-1.5">
          Related Interactive Tool
        </span>
        <h3 class="text-title-sm font-semibold text-ink group-hover:text-signature-coral transition-colors mb-1.5">
          USDA Leftover &amp; Fridge Shelf-Life Calculator &rarr;
        </h3>
        <p class="text-[13.5px] text-body leading-relaxed">
          Already cooked your turkey, chicken, or roast? Track your exact 3–4 day leftover countdown, 2-hour Danger Zone status, and reheating targets.
        </p>
      </a>

      <a
        href="/refreeze/"
        class="p-6 rounded-2xl bg-surface-soft border border-hairline hover:border-signature-coral transition-all group block"
      >
        <span class="text-[11px] font-bold uppercase tracking-wider text-signature-coral block mb-1.5">
          Food Safety Directory
        </span>
        <h3 class="text-title-sm font-semibold text-ink group-hover:text-signature-coral transition-colors mb-1.5">
          Can You Refreeze Thawed Meat &amp; Poultry? &rarr;
        </h3>
        <p class="text-[13.5px] text-body leading-relaxed">
          Check item-by-item USDA refreezing rules for thawed chicken, turkey, ground beef, fish, steaks, and cooked leftovers.
        </p>
      </a>
    </section>

    <!-- Core Storage Hub Strip -->
    <section class="mb-14 p-6 rounded-2xl bg-surface-soft border border-hairline">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <h2 class="text-title-sm font-semibold text-ink mb-1">
            Explore Verified Freezing, Thawing &amp; Storage Hubs
          </h2>
          <p class="text-[13px] text-muted">
            Verify freezer-safe containers, cold storage timelines, and refreezing safety rules.
          </p>
        </div>
        <div class="flex flex-wrap gap-2">
          <a href="/freezer/" class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral transition-colors">Freezer Guide</a>
          <a href="/refrigerator/" class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral transition-colors">Refrigerator Guide</a>
          <a href="/refreeze/" class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral transition-colors">Can You Refreeze?</a>
          <a href="/how-long/" class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral transition-colors">How Long Lasts</a>
          <a href="/methodology/" class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral transition-colors">Methodology</a>
          <a href="/tools/" class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-primary text-on-primary hover:bg-primary-active transition-colors">All Tools &rarr;</a>
        </div>
      </div>
    </section>

    <!-- FAQ Section (5 Consumer-Friendly FAQs) -->
    <section class="mb-8">
      <h2 class="text-title-lg font-medium text-ink tracking-tight mb-6">
        Frequently Asked Questions About Safe Meat Thawing
      </h2>
      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="group p-5 bg-surface-soft border border-hairline rounded-xl" open>
            <summary class="text-title-sm font-semibold text-ink cursor-pointer list-none flex items-center justify-between gap-3">
              <span>{faq.question}</span>
              <span class="text-muted text-sm transition-transform group-open:rotate-180 shrink-0" aria-hidden="true">&#9662;</span>
            </summary>
            <p class="text-[14px] text-body leading-relaxed mt-3 pt-3 border-t border-hairline/70">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </div>
</Layout>
