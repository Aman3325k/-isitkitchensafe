---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FoodContactMigrationPredictor from '../../components/FoodContactMigrationPredictor.astro';

const pageTitle = "Food Contact Chemical Migration & Leaching Time-Series Predictor | IsItKitchenSafe";
const pageDescription = "Simulate time-dependent chemical leaching from cookware, plastic food packaging, and tableware into meals. Real-time Fickian diffusion curves, Arrhenius thermal kinetics, and regulatory SML threshold breach predictions.";

const faqs = [
  {
    question: "What is food contact chemical migration, and what governs its speed?",
    answer: "Food contact chemical migration is the mass transfer of low-molecular-weight chemical substances (monomers, plasticizers, heavy metals, thermal stabilizers, and oligomers) from a contact material into food or food simulants. The rate and extent of migration are governed by Fick's Second Law of Diffusion, the initial concentration of the migrant, the partition coefficient between the container and food matrix, contact duration, and temperature."
  },
  {
    question: "How does the Arrhenius equation explain why hot foods leach chemicals exponentially faster?",
    answer: "Diffusion coefficients (D) inside polymers and metallic crystal boundaries follow Arrhenius temperature kinetics: D(T) = D0 · exp(-Ea / (R · T)). Because diffusion activation energies (Ea) typically range between 50 and 95 kJ/mol, an increase in contact temperature from refrigerator cold (4°C) to boiling or microwave hot-spots (100°C–120°C) accelerates migration kinetics by 40-fold to over 250-fold, rapidly turning a legally compliant container into a hazardous source of chemical exposure within minutes."
  },
  {
    question: "Why are acidic foods like tomato sauce and vinegar especially hazardous in metallic and glazed ceramic cookware?",
    answer: "Acidic foods (pH < 4.5) contain abundant hydrogen (H+) hydronium ions that aggressively chelate and displace metal cations. In traditional lead-glazed ceramics, acid rapidly leaches toxic lead (Pb²⁺) and cadmium (Cd²⁺) fluxes into stews. In uncoated aluminum cookware, acids strip the protective aluminum oxide passivation layer, causing massive galvanic release of trivalent aluminum ions (Al³⁺) directly into sauces."
  },
  {
    question: "What is a Specific Migration Limit (SML) under EU Regulation No 10/2011?",
    answer: "A Specific Migration Limit (SML) is the maximum legally permitted amount of a given chemical substance that may migrate from a food contact material into 1 kilogram of food or food simulant (expressed in mg/kg). SMLs are derived from rigorous toxicological risk assessments by the European Food Safety Authority (EFSA), establishing benchmark exposure thresholds to protect against chronic organ toxicity, carcinogenicity, and endocrine disruption."
  },
  {
    question: "Why do fatty and oily foods extract higher amounts of phthalates (DEHP) and PFAS?",
    answer: "Ortho-phthalate plasticizers (like DEHP and DINP) and many per- and polyfluoroalkyl substances (PFAS) are non-polar lipophilic molecules. Because they are not chemically bonded to polymer backbones, dietary triglycerides, melted butter, olive oil, and animal fats act as active lipophilic solvents. Under EU and FDA migration protocols using Simulant D2 (vegetable oil), fatty matrices extract lipophilic plasticizers at rates up to 20 times higher than aqueous solutions."
  },
  {
    question: "Does washing plastic containers in high-heat dishwashers increase future chemical leaching?",
    answer: "Yes. High-heat dishwashing cycles (exceeding 65°C / 150°F) combined with alkaline caustic detergents degrade polymer surface integrity, creating microscopic stress fractures and accelerating ester bond hydrolysis in plastics like polycarbonate and melamine. This increases subsequent monomer and oligomer leaching by up to 300% during subsequent food storage."
  }
];

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools/' },
  { label: 'Food Contact Migration Predictor' }
];

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Food Contact Chemical Migration & Leaching Time-Series Predictor",
  "url": "https://isitkitchensafe.com/tools/food-contact-migration-predictor/",
  "applicationCategory": "ScienceApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "description": pageDescription,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};
---

<Layout title={pageTitle} description={pageDescription} faqs={faqs} availableLocales={['en', 'es', 'pt', 'zh-cn', 'ja']}>
  <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />

  <main class="container mx-auto px-4 py-8 max-w-5xl space-y-8">
    <Breadcrumbs items={breadcrumbs} />

    <FoodContactMigrationPredictor lang="en" />

    <!-- FAQ Accordion Section -->
    <section class="mt-16 bg-surface-soft border border-hairline rounded-3xl p-6 md:p-10 space-y-6">
      <div class="border-b border-hairline pb-4">
        <span class="text-xs font-bold uppercase tracking-wider text-amber-800 block mb-1">
          Peer-Reviewed Transport Phenomena Q&amp;A
        </span>
        <h2 class="text-title-lg font-medium text-ink tracking-tight">
          Frequently Asked Questions on Chemical Leaching &amp; Migration Kinetics
        </h2>
        <p class="text-xs text-muted">Evidence-based answers grounded in chemical engineering, food toxicology, and international food contact regulations.</p>
      </div>

      <div class="space-y-4">
        {faqs.map(faq => (
          <details class="group p-4 rounded-xl bg-canvas border border-hairline transition-colors open:bg-surface">
            <summary class="font-medium text-ink cursor-pointer list-none flex items-center justify-between text-sm md:text-base">
              <span>{faq.question}</span>
              <span class="text-muted transition-transform group-open:rotate-180 ml-2">&darr;</span>
            </summary>
            <p class="text-xs md:text-sm text-body mt-3 pt-3 border-t border-hairline/60 leading-relaxed">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </main>
</Layout>
