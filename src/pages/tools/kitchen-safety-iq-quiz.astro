---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import KitchenSafetyQuiz from '../../components/KitchenSafetyQuiz.astro';
import rawData from '../../data/kitchen-safety-iq-quiz-data.json';

const pageTitle = "Interactive Kitchen Safety IQ Quiz | IsItKitchenSafe";
const pageDescription = "Test your food safety instincts against empirical USDA, FDA, and CDC science. Discover whether common kitchen habits (washing chicken, the sniff test, toaster jams) are dangerous myths or safe practices.";

const faqs = rawData.faqs.en;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools/' },
  { label: 'Kitchen Safety IQ Quiz' }
];

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Interactive Kitchen Safety IQ Quiz",
  "url": "https://isitkitchensafe.com/tools/kitchen-safety-iq-quiz/",
  "applicationCategory": "EducationalApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript.",
  "description": pageDescription,
  "inLanguage": "en",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  faqs={faqs}
  excludeFaqSchema={true}
  availableLocales={['en', 'es', 'pt', 'zh-cn', 'ja']}
  lang="en"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1 print:hidden">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1140px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-signature-coral text-white mb-3">
        USDA · FDA · CDC Scientific Challenge
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        Interactive Kitchen Safety IQ Quiz
      </h1>
      <p class="text-body text-[15px] md:text-[16px] leading-relaxed">
        Can you spot <strong>everyday food poisoning traps and dangerous appliance myths</strong>? Answer 12 real-world questions across poultry washing, leftover refrigeration, toaster shocks, and microwave physics to earn your official <strong>Kitchen Safety Officer score card</strong>.
      </p>
    </header>

    <!-- Main Interactive Quiz Component -->
    <KitchenSafetyQuiz lang="en" />
  </div>
</Layout>