---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import KitchenPlasticLeachingChecker from '../../components/KitchenPlasticLeachingChecker.astro';
import rawData from '../../data/kitchen-plastic-leaching-data.json';

const pageTitle = "Kitchen Plastic Leaching & Hot Food Safe Container Checker | IsItKitchenSafe";
const pageDescription = "Calculate BPA, BPS, phthalates, and microplastic leaching risks when storing or microwaving hot, acidic, or fatty foods in plastic containers (#1 to #7). Verified with ACS Nano 2023 & FDA 21 CFR § 177 standards.";

const faqs = rawData.faqs.en;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools/' },
  { label: 'Kitchen Plastic Leaching & Hot Food Safe Container Checker' }
];

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Kitchen Plastic Leaching & Hot Food Safe Container Checker",
  "url": "https://isitkitchensafe.com/tools/kitchen-plastic-leaching-checker/",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript.",
  "description": pageDescription,
  "inLanguage": "en",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  faqs={faqs}
  excludeFaqSchema={true}
  availableLocales={['en', 'es', 'pt', 'zh-cn', 'ja']}
  lang="en"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1 print:hidden">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1140px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-signature-coral text-white mb-3">
        ACS Nano 2023 · FDA 21 CFR § 177 · EFSA BPA Re-evaluation · ASTM D7611 Codes #1–#7
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        Kitchen Plastic Leaching &amp; Hot Food Safe Container Checker
      </h1>
      <p class="text-body text-[15px] md:text-[16px] leading-relaxed">
        Stop guessing if your plastic containers are safe for leftovers and hot food: calculate <strong>BPA, BPS, and phthalate migration rates</strong> across recycling codes #1 to #7, simulate <strong>microwave fat superheating pits</strong> and <strong>billions of nanoplastics per cm²</strong>, and get definitive guidelines on when to switch to glass or stainless steel.
      </p>
    </header>

    <!-- Main Interactive Checker Component -->
    <KitchenPlasticLeachingChecker lang="en" />
  </div>
</Layout>
