---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CookingOilSmokePointFinder from '../../components/CookingOilSmokePointFinder.astro';
import rawData from '../../data/cooking-oil-smoke-point-data.json';

const pageTitle = "Cooking Oil Smoke Point & Safe Frying Temperature Finder (28 Oils) | IsItKitchenSafe";
const pageDescription = "Instantly check USDA & AOCS smoke points, oxidative stability, and safe frying, air fryer, baking, or cast iron searing temperatures across 28 everyday cooking oils & fats—from refined avocado oil and EVOO to ghee, tallow, butter, and flaxseed oil.";

const faqs = rawData.faqs.en;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools/' },
  { label: 'Cooking Oil Smoke Point Finder' }
];

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Cooking Oil Smoke Point & Safe Frying Temperature Finder",
  "url": "https://isitkitchensafe.com/tools/cooking-oil-smoke-point-finder/",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript.",
  "description": pageDescription,
  "inLanguage": "en",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  faqs={faqs}
  excludeFaqSchema={true}
  availableLocales={['en', 'es', 'pt', 'zh-cn', 'ja']}
  lang="en"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1 print:hidden">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1140px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-signature-coral text-white mb-3">
        USDA · AOCS Smoke Point &amp; Stability Finder
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        Cooking Oil Smoke Point &amp; Safe Frying Temperature Finder
      </h1>
      <p class="text-body text-[15px] md:text-[16px] leading-relaxed">
        Slide to your target cooking temperature—from <strong>cold dressings (70°F)</strong> and <strong>air frying (375–400°F)</strong> to <strong>500°F cast iron steak searing</strong>—and instantly see which of <strong>28 cooking oils &amp; fats</strong> stay safe, resist toxic aldehydes, or smoke and burn.
      </p>
    </header>

    <!-- Main Interactive Finder, Related Links & 5 Visible FAQs -->
    <CookingOilSmokePointFinder lang="en" />
  </div>
</Layout>
