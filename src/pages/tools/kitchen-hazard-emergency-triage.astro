---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import KitchenEmergencyTriage from '../../components/KitchenEmergencyTriage.astro';

const pageTitle = "Kitchen Hazard Emergency Triage & Containment Tool | Microwave, Oven Fire, Glass & Fumes | IsItKitchenSafe";
const pageDescription = "Instant step-by-step emergency instructions for kitchen hazards: microwave sparking, oven grease fires, thermal shock exploding pyrex, toxic Teflon fumes, and dishwasher suds floods.";

const faqs = [
  {
    question: "Why should you never throw water on an oil or grease fire?",
    answer: "Water is denser than oil and has a boiling point of 212°F (100°C), while burning oil is between 750°F and 800°F. When water strikes burning oil, it sinks and instantaneously boils into steam, expanding over 1,700 times in volume. This violent vapor expansion throws aerosolized flaming oil droplets into the air, creating an instantaneous 10-foot fireball explosion."
  },
  {
    question: "Why does aluminum foil spark in the microwave?",
    answer: "Aluminum foil reflects high-frequency microwave energy rather than absorbing it. Electric charges accumulate along thin crumpled edges and sharp folds. When the electric potential exceeds the dielectric breakdown threshold of air (approx. 30 kilovolts per centimeter), an electrical arc flashes through the air, creating a luminous plasma discharge capable of puncturing the cavity wall or igniting grease."
  },
  {
    question: "Can an overheated Teflon pan really kill pet birds?",
    answer: "Yes, rapidly and lethally. Non-stick cookware coated with PTFE degrades above 500°F (260°C) and undergoes thermal pyrolysis above 660°F (350°C), releasing submicron particles and toxic gases including perfluoroisobutylene and carbonyl fluoride. Birds possess an ultra-efficient respiratory system with non-collapsible air sacs that rapidly absorb airborne toxins, causing acute hemorrhagic pulmonary edema and death within minutes."
  },
  {
    question: "What should you do if your glass bakeware explodes in the oven?",
    answer: "Step back immediately and keep pets and barefoot family members away. Turn off the oven and let all glass shards cool undisturbed for 45 minutes. Put on heavy leather puncture-proof gloves and eye protection. Discard all food within an 8-foot blast radius due to invisible needle-sharp glass shards. Sweep large pieces into a rigid cardboard box and vacuum the oven floor with a shop vac."
  },
  {
    question: "How do you stop a dishwasher filled with regular liquid dish soap bubbles?",
    answer: "Cancel or drain the cycle immediately to stop pump agitation. Lay towels around the kickplate. Scoop out excess foam with a bowl, then pour 1/2 cup of standard cooking oil (vegetable or canola) or table salt directly onto the tub floor. Cooking oil breaks the surface tension of the surfactants, collapsing the suds instantly. Run a drain cycle, followed by a rinse with 2 cups of white vinegar."
  }
];

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools/' },
  { label: 'Kitchen Hazard Emergency Triage' }
];

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Kitchen Hazard Emergency Triage & Containment Tool",
  "url": "https://isitkitchensafe.com/tools/kitchen-hazard-emergency-triage/",
  "applicationCategory": "HealthApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "description": pageDescription,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to Safely Contain Common Kitchen Emergencies",
  "description": "Standard operating protocols for safely containing oven grease fires, microwave electrical arcing, shattered thermal shock bakeware, and toxic polymer fumes.",
  "step": [
    {
      "@type": "HowToStep",
      "name": "Contain Stovetop Pan Fire",
      "text": "Slide a flat metal lid smoothly across the pan to cut off oxygen. Turn off the heat. Never pour water or move the pan."
    },
    {
      "@type": "HowToStep",
      "name": "Stop Microwave Arcing",
      "text": "Press stop immediately and unplug the power cord from the wall. Keep door closed if flames are active to starve fire of air."
    },
    {
      "@type": "HowToStep",
      "name": "Ventilate Burnt Cookware Fumes",
      "text": "Evacuate pet birds immediately to fresh outdoor air. Turn kitchen exhaust hood on maximum and open all exterior doors and windows."
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} faqs={faqs} availableLocales={['en', 'es', 'pt', 'zh-cn', 'ja']}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(howToSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1200px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-red-600 text-white mb-3">
        Rapid Emergency Response &bull; Life Safety
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        Kitchen Hazard Emergency Triage &amp; Containment Tool
      </h1>
      <p class="text-body text-[15px] md:text-body-md leading-relaxed">
        When an appliance sparks, catches fire, or shatters, seconds count. Use our rapid triage matrix below to find immediate containment steps, what never to do, and post-incident equipment safety verification.
      </p>
    </header>

    <!-- Main Triage Component -->
    <div class="mb-14">
      <KitchenEmergencyTriage lang="en" />
    </div>

    <!-- Official Kitchen Fire Extinguisher Guide -->
    <section class="mb-14 border-t border-hairline pt-12 space-y-6">
      <div class="max-w-3xl">
        <span class="text-xs font-bold uppercase tracking-wider text-muted block mb-1">
          NFPA Standards &bull; Home Fire Defense
        </span>
        <h2 class="text-title-lg md:text-display-sm font-medium text-ink tracking-tight mb-3">
          Kitchen Fire Extinguisher Classes Explained
        </h2>
        <p class="text-body text-[15px] leading-relaxed mb-4">
          Using the wrong fire extinguisher in a kitchen can spread burning oil or cause electrocution. Familiarize yourself with the 4 critical ratings before an emergency:
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="p-5 rounded-xl bg-surface-soft border border-hairline space-y-2">
          <div class="w-8 h-8 rounded-lg bg-emerald-700 text-white font-bold flex items-center justify-center text-sm">A</div>
          <h3 class="font-semibold text-ink text-sm">Class A: Ordinary Combustibles</h3>
          <p class="text-xs text-body leading-relaxed">Paper towels, cardboard boxes, wooden utensils, and cloth aprons. Smothers burning embers with water or dry monoammonium phosphate.</p>
        </div>

        <div class="p-5 rounded-xl bg-surface-soft border border-hairline space-y-2">
          <div class="w-8 h-8 rounded-lg bg-red-600 text-white font-bold flex items-center justify-center text-sm">B</div>
          <h3 class="font-semibold text-ink text-sm">Class B: Flammable Liquids</h3>
          <p class="text-xs text-body leading-relaxed">Cooking grease, alcohol, aerosol cooking oils, and flammable cleaning solvents. Uses dry chemical foam to choke oxygen without splashing liquids.</p>
        </div>

        <div class="p-5 rounded-xl bg-surface-soft border border-hairline space-y-2">
          <div class="w-8 h-8 rounded-lg bg-blue-600 text-white font-bold flex items-center justify-center text-sm">C</div>
          <h3 class="font-semibold text-ink text-sm">Class C: Energized Electrical</h3>
          <p class="text-xs text-body leading-relaxed">Microwaves, toaster ovens, refrigerators, and dishwashers. Non-conductive dry chemical agents that extinguish wiring without electrocuting the user.</p>
        </div>

        <div class="p-5 rounded-xl bg-surface-soft border border-hairline space-y-2">
          <div class="w-8 h-8 rounded-lg bg-amber-600 text-white font-bold flex items-center justify-center text-sm">K</div>
          <h3 class="font-semibold text-ink text-sm">Class K: Commercial Kitchen Oils</h3>
          <p class="text-xs text-body leading-relaxed">Vegetable oils, animal fats, and deep-fat fryers. Employs potassium acetate wet chemical agents that undergo saponification, creating a thick foam blanket.</p>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="border-t border-hairline pt-12">
      <h2 class="text-title-lg md:text-display-sm font-medium text-ink tracking-tight mb-8">
        Frequently Asked Questions
      </h2>
      <div class="space-y-6 max-w-3xl">
        {faqs.map(faq => (
          <div class="border-b border-hairline pb-6">
            <h3 class="text-base font-semibold text-ink mb-2">
              {faq.question}
            </h3>
            <p class="text-body text-sm leading-relaxed">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>
