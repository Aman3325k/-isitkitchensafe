---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import MoldyFoodSafetyChecker from '../../components/MoldyFoodSafetyChecker.astro';
import rawData from '../../data/moldy-food-safety-data.json';

const pageTitle = "USDA Moldy Food Cut-Around vs. Throw-Out Safety Checker | IsItKitchenSafe";
const pageDescription = "Check the official USDA FSIS chart for 24 moldy foods: when you can safely cut 1 inch (2.5 cm) around hard cheese, salami, or firm veggies vs. when invisible mold roots & mycotoxins mean discarding bread, berries, jam, cream cheese, peanut butter, and leftovers.";

const faqs = rawData.faqs.en;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools/' },
  { label: 'Moldy Food Safety Checker' }
];

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "USDA Moldy Food Cut-Around vs. Throw-Out Safety Checker",
  "url": "https://isitkitchensafe.com/tools/moldy-food-safety-checker/",
  "applicationCategory": "HealthApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript.",
  "description": pageDescription,
  "inLanguage": "en",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  faqs={faqs}
  excludeFaqSchema={true}
  availableLocales={['en', 'es', 'pt', 'zh-cn', 'ja']}
  lang="en"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1 print:hidden">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1140px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-signature-coral text-white mb-3">
        Official USDA FSIS Chart · 24 Everyday Foods · Mycotoxin &amp; Hygiene Guide
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        USDA Moldy Food Cut-Around vs. Throw-Out Safety Checker
      </h1>
      <p class="text-body text-[15px] md:text-[16px] leading-relaxed">
        Instantly verify whether moldy <strong>cheddar cheese, bread, berries, jam, peanut butter, cream cheese, apples, salami, maple syrup, or leftovers</strong> can be salvaged with the <strong>1-inch (2.5 cm) USDA cut-around rule</strong> or must be discarded immediately due to invisible mycelium roots and heat-stable mycotoxins.
      </p>
    </header>

    <!-- Main Interactive Checker Component -->
    <MoldyFoodSafetyChecker lang="en" />
  </div>
</Layout>
