---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ElectricKettleDescalingSimulator from '../../components/ElectricKettleDescalingSimulator.astro';
import rawData from '../../data/electric-kettle-descaling-leaching-data.json';

const pageTitle = "Electric Kettle Nickel, Microplastics & Descaling Leaching Simulator | IsItKitchenSafe";
const pageDescription = "Simulate heavy metal nickel ion leaching (>70 µg/L), boiling polypropylene microplastic shedding, and safe citric acid vs. vinegar limescale descaling in electric kettles. WHO and BfR standards.";

const faqs = rawData.faqs.en;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools/' },
  { label: 'Electric Kettle Descaling & Leaching Simulator' }
];

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Electric Kettle Nickel, Microplastics & Descaling Leaching Simulator",
  "url": "https://isitkitchensafe.com/tools/electric-kettle-descaling-leaching-simulator/",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript.",
  "description": pageDescription,
  "inLanguage": "en",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  faqs={faqs}
  excludeFaqSchema={true}
  availableLocales={['en', 'es', 'pt', 'zh-cn', 'ja']}
  lang="en"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1 print:hidden">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1140px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-signature-coral text-white mb-3">
        WHO Drinking Water Guidelines · German BfR Risk Assessment · Nature Food Microplastics Benchmark
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        Electric Kettle Nickel, Microplastics &amp; Descaling Leaching Simulator
      </h1>
      <p class="text-body text-[15px] md:text-[16px] leading-relaxed">
        Stop guessing about kettle safety: calculate <strong>heavy metal nickel ion leaching (µg/L)</strong> from corroded heating plates, estimate <strong>polypropylene microplastic shedding (particles/L)</strong> under repeated 100°C boiling, and discover why <strong>food-grade citric acid passivates stainless steel</strong> while boiling vinegar degrades protective chromium oxide.
      </p>
    </header>

    <!-- Main Interactive Simulator Component -->
    <ElectricKettleDescalingSimulator lang="en" />
  </div>
</Layout>
