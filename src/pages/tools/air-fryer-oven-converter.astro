---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AirFryerOvenConverter from '../../components/AirFryerOvenConverter.astro';

const pageTitle = "Air Fryer, Convection Oven & Gas Mark Conversion Calculator | IsItKitchenSafe";
const pageDescription = "Convert oven recipes to air fryer temperature and time instantly (-25°F & -20% time), switch between °F, °C, and UK Gas Mark 1/4–9, and run real-time thermal safety checks for parchment paper, silicone liners, PTFE nonstick, and glass bakeware.";

const faqs = [
  {
    question: "How do I convert a conventional oven recipe to an air fryer?",
    answer: "Use the classic 25/20 air fryer conversion rule: lower the conventional oven temperature by 25°F (about 14–15°C) and reduce the total cooking time by 20% (multiply oven minutes by 0.80). Because an air fryer concentrates high-velocity convection heat inside a compact basket, food browns much faster—always shake or flip halfway through and check for doneness 2 to 3 minutes before the timer ends."
  },
  {
    question: "What is Gas Mark 4, 5, and 6 in Fahrenheit and Celsius?",
    answer: "Gas Mark 4 equals 350°F (180°C conventional / 160°C fan), Gas Mark 5 equals 375°F (190°C conventional / 170°C fan), and Gas Mark 6 equals 400°F (200°C conventional / 180°C fan). Each full Gas Mark step above Gas Mark 1 adds roughly 25°F (about 10–15°C) to the oven cavity temperature."
  },
  {
    question: "Can parchment paper catch fire in an air fryer?",
    answer: "Yes, if used incorrectly. Standard parchment paper is rated for 420°F to 450°F (215°C–232°C), so exceeding 420°F risks scorching edges. More importantly, never preheat an empty air fryer with parchment paper inside or use lightweight foods (like broccoli florets) that cannot weigh the sheet down—high-speed upward airflow can pull loose paper directly into the top heating coil and ignite it."
  },
  {
    question: "What is the maximum safe temperature for nonstick pans, silicone liners, and glass dishes?",
    answer: "PTFE (Teflon) nonstick coatings should stay below 500°F (260°C) because overheating causes polymer breakdown and fumes toxic to pet birds. Food-grade silicone liners typically peak at 425°F–450°F (218°C–232°C). Tempered soda-lime glass (modern US PYREX/Anchor) maxes out at 425°F (218°C) and can shatter from thermal shock, whereas borosilicate glass handles up to 500°F (260°C) and cast iron safely exceeds 550°F (288°C)."
  },
  {
    question: "Why should I still check internal temperature with a food thermometer after converting?",
    answer: "Air fryer wattage, basket depth, and food thickness vary widely across brands, meaning the exterior can look golden-brown before the interior is fully cooked. Always verify USDA safe minimum internal temperatures at the thickest part: 165°F (74°C) for poultry and reheated leftovers, 145°F (63°C) for fish, and 145°F (63°C) plus a 3-minute rest for whole cuts of pork and beef steak."
  }
];

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools/' },
  { label: 'Air Fryer & Oven Converter' }
];

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Air Fryer, Convection Oven & Gas Mark Conversion Calculator",
  "url": "https://isitkitchensafe.com/tools/air-fryer-oven-converter/",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript.",
  "description": pageDescription,
  "inLanguage": "en",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  excludeFaqSchema={true}
  availableLocales={['en', 'es', 'pt', 'zh-cn', 'ja']}
  lang="en"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1140px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-signature-coral text-white mb-3">
        Kitchen Conversion &amp; Thermal Safety Calculator
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        Air Fryer, Convection Oven &amp; Gas Mark Converter
      </h1>
      <p class="text-body text-[15px] md:text-[16px] leading-relaxed">
        Convert any oven recipe to an air fryer (or vice versa), switch smoothly between <strong>°F, °C, Fan/Convection, and UK Gas Mark 1/4–9</strong>, get exact halfway shake checkpoints, and check real-time thermal safety alerts for parchment paper, silicone liners, nonstick pans, and glass dishes.
      </p>
    </header>

    <!-- Main Interactive Converter -->
    <div class="mb-14">
      <AirFryerOvenConverter lang="en" />
    </div>

    <!-- Related Companion Tools -->
    <section class="mb-14 grid grid-cols-1 md:grid-cols-2 gap-5">
      <a
        href="/tools/air-fryer-acrylamide-calculator/"
        class="p-6 rounded-2xl bg-surface-soft border border-hairline hover:border-signature-coral transition-all group block"
      >
        <span class="text-[11px] font-bold uppercase tracking-wider text-signature-coral block mb-1.5">
          Related Air Fryer Safety Tool
        </span>
        <h2 class="text-title-sm font-semibold text-ink group-hover:text-signature-coral transition-colors mb-1.5">
          Air Fryer Acrylamide &amp; Browning Calculator &rarr;
        </h2>
        <p class="text-[13.5px] text-body leading-relaxed">
          Cooking fries, potatoes, or breaded snacks above 375°F? Check EU 2017/2158 acrylamide thresholds and cold-soak starch reduction tips.
        </p>
      </a>

      <a
        href="/tools/thermal-shock-simulator/"
        class="p-6 rounded-2xl bg-surface-soft border border-hairline hover:border-signature-coral transition-all group block"
      >
        <span class="text-[11px] font-bold uppercase tracking-wider text-signature-coral block mb-1.5">
          Related Cookware Safety Tool
        </span>
        <h2 class="text-title-sm font-semibold text-ink group-hover:text-signature-coral transition-colors mb-1.5">
          Glass &amp; Ceramic Thermal Shock Simulator &rarr;
        </h2>
        <p class="text-[13.5px] text-body leading-relaxed">
          Compare tempered soda-lime glass vs. borosilicate Pyrex shatter risk when moving dishes between refrigerator, oven, and countertop.
        </p>
      </a>
    </section>

    <!-- Verified Appliance Hubs Strip -->
    <section class="mb-14 p-6 rounded-2xl bg-surface-soft border border-hairline">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <h2 class="text-title-sm font-semibold text-ink mb-1">
            Check What Is Safe Inside Your Air Fryer &amp; Oven
          </h2>
          <p class="text-[13px] text-muted">
            Browse material-by-material safety verdicts and review our citation standards in our <a href="/methodology/" class="text-link underline hover:text-link-active">Methodology</a>.
          </p>
        </div>
        <div class="flex flex-wrap gap-2">
          <a href="/airfryer/" class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral transition-colors">Air Fryer Safety Guide</a>
          <a href="/oven/" class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral transition-colors">Oven Safety Guide</a>
          <a href="/methodology/" class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral transition-colors">Methodology</a>
          <a href="/tools/" class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-primary text-on-primary hover:bg-primary-active transition-colors">All Tools &rarr;</a>
        </div>
      </div>
    </section>

    <!-- FAQ Section (5 Consumer FAQs) -->
    <section class="mb-8">
      <h2 class="text-title-lg font-medium text-ink tracking-tight mb-6">
        Frequently Asked Questions About Air Fryer, Oven &amp; Gas Mark Conversions
      </h2>
      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="group p-5 bg-surface-soft border border-hairline rounded-xl" open>
            <summary class="text-title-sm font-semibold text-ink cursor-pointer list-none flex items-center justify-between gap-3">
              <span>{faq.question}</span>
              <span class="text-muted text-sm transition-transform group-open:rotate-180 shrink-0" aria-hidden="true">&#9662;</span>
            </summary>
            <p class="text-[14px] text-body leading-relaxed mt-3 pt-3 border-t border-hairline/70">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </div>
</Layout>
