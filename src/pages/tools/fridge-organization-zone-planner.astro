---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FridgeOrganizationZonePlanner from '../../components/FridgeOrganizationZonePlanner.astro';
import rawData from '../../data/fridge-organization-zone-planner-data.json';

const pageTitle = "Interactive Fridge Organization & Safe Shelf-Zone Planner (USDA & FDA) | IsItKitchenSafe";
const pageDescription = "Organize your refrigerator by USDA temperature zones, FDA drip hierarchy, and ethylene gas produce science. Interactive 6-zone fridge map, instant 28-grocery lookup, crisper humidity guide, and printable fridge door cheat sheet.";

const faqs = rawData.faqs.en;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools/' },
  { label: 'Fridge Organization & Shelf-Zone Planner' }
];

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Interactive Fridge Organization & Safe Shelf-Zone Planner",
  "url": "https://isitkitchensafe.com/tools/fridge-organization-zone-planner/",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript.",
  "description": pageDescription,
  "inLanguage": "en",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  faqs={faqs}
  excludeFaqSchema={true}
  availableLocales={['en', 'es', 'pt', 'zh-cn', 'ja']}
  lang="en"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1 print:hidden">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1140px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-signature-coral text-white mb-3">
        USDA FSIS, FDA Food Code &amp; Ethylene Science
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        Interactive Fridge Organization &amp; Safe Shelf-Zone Planner
      </h1>
      <p class="text-body text-[15px] md:text-[16px] leading-relaxed">
        See exactly where <strong>28 everyday groceries</strong> belong across the <strong>6 refrigerator temperature &amp; humidity zones</strong> (plus what stays on the <strong>counter or pantry</strong>). Stop cross-contamination drips, avoid storing milk and eggs in the warm door, and separate ethylene-producing fruits from delicate greens.
      </p>
    </header>

    <!-- Main Interactive Planner, Related Links & 5 Visible FAQs -->
    <FridgeOrganizationZonePlanner lang="en" />
  </div>
</Layout>
