---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import MaterialSwapCalculator from '../../components/MaterialSwapCalculator.astro';

const pageTitle = "Safe Kitchenware Material Swap Calculator & Vetted Recommendations | IsItKitchenSafe";
const pageDescription = "Find certified non-toxic replacements for scratched Teflon, raw aluminum, and plastic storage. Compare stainless steel, cast iron, carbon steel, and glass with third-party tested brand recommendations and 10-year savings.";

const faqs = [
  {
    question: "Can you really cook eggs in stainless steel without sticking?",
    answer: "Yes, 100%. The secret is the physics of the Leidenfrost effect. Heat your stainless steel skillet on medium heat for about 2 minutes. Sprinkle a few droplets of water onto the surface—if they evaporate immediately, the pan is too cold. When the pan reaches ~160°C (320°F), the water droplets glide across the surface like frictionless marbles. At this exact point, add a teaspoon of butter or high-smoke-point oil, swirl, reduce heat to low, and drop in your eggs. They will slide effortlessly without sticking."
  },
  {
    question: "Why should you avoid buying cheap non-stick pans every 1-2 years?",
    answer: "Beyond throwing away $30 to $50 every 18 months, degraded non-stick coatings release microscopic fluoropolymer fragments into food as soon as microscopic scratches occur. Studies from Flinders University revealed that a single surface scratch can liberate over 2 million sub-micron nanoplastic particles during high-heat cooking. In contrast, a $20-$40 pre-seasoned cast iron or $40 tri-ply stainless pan lasts 50+ years and never sheds synthetic polymers."
  },
  {
    question: "Is carbon steel better than cast iron?",
    answer: "Carbon steel and cast iron share the exact same non-toxic chemistry: 99% iron seasoned with natural polymerized cooking oil. However, carbon steel is pressed from sheet metal rather than poured into sand molds, making it approximately 40% lighter with much steeper, sloped sidewalls. It heats up and cools down much faster, making it the preferred pan for wok cooking, delicate fish, and fast stir-frying, whereas cast iron excels at massive heat retention for thick steaks and Dutch babies."
  },
  {
    question: "Are ceramic non-stick pans truly permanent?",
    answer: "No. While authentic sol-gel ceramic pans (like Caraway and GreenPan) are 100% free of PTFE, PFOA, and fluoropolymers, the silica-based gel layer is microscopic and porous. With daily use, microscopic thermal shock and oil carbonization degrade the slick surface, typically reducing its release efficacy after 2 to 3 years. For a permanent lifetime pan, uncoated 18/10 stainless steel or seasoned iron is superior."
  },
  {
    question: "Why is borosilicate glass safer than soda-lime glass or plastic for food storage?",
    answer: "Plastic containers leach microplastics and endocrine-disrupting additives (phthalates, bisphenols) when exposed to microwave heat and fatty foods. Ordinary tempered soda-lime glass has high thermal expansion and can shatter when exposed to rapid temperature changes (>55°C / 100°F ΔT). Borosilicate glass incorporates boron trioxide, allowing it to withstand extreme temperature swings (ΔT of 150°C / 270°F), making it safe to transfer directly from freezer to preheated microwave or oven."
  }
];

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools/' },
  { label: 'Material Swap Calculator' }
];

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Safe Kitchenware Material Swap Calculator & Affiliate Recommendation Engine",
  "url": "https://isitkitchensafe.com/tools/material-swap-calculator/",
  "applicationCategory": "HealthApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "description": pageDescription,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};
---

<Layout title={pageTitle} description={pageDescription} faqs={faqs} availableLocales={['en', 'es', 'pt', 'zh-cn', 'ja']}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1200px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-700 text-white mb-3">
        Zero PFAS &bull; Certified Lab Tested &bull; Lifetime Value
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        Safe Kitchenware Material Swap Calculator
      </h1>
      <p class="text-body text-[15px] md:text-body-md leading-relaxed">
        Upgrade from peeling Teflon, raw reactive aluminum, and microplastic-shedding plastics. Find the exact non-toxic material that fits your cooking habits, budget, and cleaning preferences—backed by third-party laboratory audits and 10-year cost calculations.
      </p>
    </header>

    <!-- Main Interactive Calculator Component -->
    <div class="mb-14">
      <MaterialSwapCalculator lang="en" />
    </div>

    <!-- Science Deep-Dive: The Physics of Non-Toxic Cooking -->
    <section class="mb-14 border-t border-hairline pt-12 space-y-8">
      <div class="max-w-3xl">
        <span class="text-xs font-bold uppercase tracking-wider text-muted block mb-1">
          Material Science &bull; Culinary Thermodynamics &bull; Non-Toxic Living
        </span>
        <h2 class="text-title-lg md:text-display-sm font-medium text-ink tracking-tight mb-3">
          The Science of Switching to Heirloom Non-Toxic Cookware
        </h2>
        <p class="text-body text-[15px] leading-relaxed">
          Transitioning away from synthetic fluoropolymer coatings is both a health upgrade and a culinary milestone. Understanding how heat interacts with uncoated metal surfaces unlocks effortless cooking without toxic degradation:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl bg-surface-soft border border-hairline space-y-3">
          <div class="w-9 h-9 rounded-xl bg-emerald-700 text-white font-bold flex items-center justify-center text-sm">
            01
          </div>
          <h3 class="font-semibold text-ink text-base">The Leidenfrost Vapor Barrier</h3>
          <p class="text-xs text-body leading-relaxed">
            Uncoated 18/10 stainless steel is not naturally non-stick, but it becomes non-stick through physics. When heated to 160°C–180°C, moisture in food vaporizes upon contact, creating an insulating microscopic vapor cushion that suspends delicate proteins above the metal lattice.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-surface-soft border border-hairline space-y-3">
          <div class="w-9 h-9 rounded-xl bg-amber-700 text-white font-bold flex items-center justify-center text-sm">
            02
          </div>
          <h3 class="font-semibold text-ink text-base">Cross-Linked Oil Polymerization</h3>
          <p class="text-xs text-body leading-relaxed">
            Cast iron and carbon steel develop slick black patinas through thermal polymerization. Unsaturated fatty acids undergo free-radical cross-linking under heat, forming an impermeable, glass-like bio-plastic bonded to iron. It contains zero synthetic fluorocarbons and self-heals with every cook.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-surface-soft border border-hairline space-y-3">
          <div class="w-9 h-9 rounded-xl bg-blue-700 text-white font-bold flex items-center justify-center text-sm">
            03
          </div>
          <h3 class="font-semibold text-ink text-base">Impermeable Vitreous Enamel</h3>
          <p class="text-xs text-body leading-relaxed">
            Enameled cast iron and borosilicate glass are manufactured from fused silica and boron trioxide crystals. Unlike metals that can exchange trace ions in acidic tomato reductions, vitreous glass surfaces are 100% chemically inert, stain-resistant, and impervious to organic acids.
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="border-t border-hairline pt-12">
      <h2 class="text-title-lg md:text-display-sm font-medium text-ink tracking-tight mb-8">
        Frequently Asked Questions
      </h2>
      <div class="space-y-6 max-w-3xl">
        {faqs.map(faq => (
          <div class="border-b border-hairline pb-6">
            <h3 class="text-base font-semibold text-ink mb-2">
              {faq.question}
            </h3>
            <p class="text-body text-sm leading-relaxed">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>
