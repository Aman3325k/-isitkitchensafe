---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductRecallsScanner from '../../components/ProductRecallsScanner.astro';

const pageTitle = "Barcode & Product Packaging Recalls Scanner | FDA & CPSC Kitchenware Alerts | IsItKitchenSafe";
const pageDescription = "Scan kitchenware barcodes or search model numbers against official FDA, CPSC, and Health Canada recall registries: exploding air fryers, lead-glazed ceramics, defective blender blades, and pressure cookers.";

const faqs = [
  {
    question: "How do I find the UPC barcode or model number on my kitchenware?",
    answer: "On electric kitchen appliances (air fryers, blenders, pressure cookers), invert the unit to locate the permanent silver or white electrical rating plate. The model number is explicitly marked after 'Model:' or 'Item:'. The 12-digit UPC barcode can be found on original product retail boxes, hangtags, or barcode stickers attached to the bottom base."
  },
  {
    question: "What should I do if my kitchen product is under an active recall?",
    answer: "Immediately stop using the product and unplug it from the wall. Do not attempt to repair a recalled appliance yourself. Do not return recalled items to general retail stores unless instructed. Follow the official manufacturer remedy instructions (e.g. cutting the cord, submitting a photograph of the serial number, or receiving a free upgraded replacement lid or base)."
  },
  {
    question: "Why are so many ceramic mugs and dishes recalled for lead and cadmium?",
    answer: "Traditional, low-fired artisan earthenware ceramics (especially imported lines from non-regulated artisan kilns) use lead-based fluxing glazes to achieve vibrant colors at lower temperatures. When exposed to hot, acidic beverages (coffee, tea, lemon water, tomato soup), the chemical glaze matrix dissolves, releasing neurotoxic lead and cadmium directly into consumed food."
  },
  {
    question: "Can an air fryer really catch fire while in use?",
    answer: "Yes. Major recalls from brands like Cosori and Insignia involved over 3 million air fryers due to internal crimped wire connectors that overheated under high electrical amperage (1,500 to 1,800 Watts). Overheating crimps melt surrounding plastic enclosures and can ignite nearby countertop cabinets."
  },
  {
    question: "Are pressure cooker lid explosions covered under consumer warranty?",
    answer: "Yes, and they are subject to mandatory federal CPSC defect recalls. Defective pressure cooker lids (such as those on Crock-Pot Express and Sensio Bella/Crux models) failed to lock properly under internal steam pressure, allowing users to inadvertently open pressurized pots, ejecting scalding liquid and causing severe second- and third-degree burns."
  }
];

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools/' },
  { label: 'Product Recalls Scanner' }
];

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Barcode & Product Packaging Recalls Scanner",
  "url": "https://isitkitchensafe.com/tools/product-recalls-scanner/",
  "applicationCategory": "HealthApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "description": pageDescription,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};
---

<Layout title={pageTitle} description={pageDescription} faqs={faqs} availableLocales={['en', 'es', 'pt', 'zh-cn', 'ja']}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1200px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-rose-600 text-white mb-3">
        Regulatory Safety Diagnostic &bull; CPSC &amp; FDA Registry
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        Barcode &amp; Product Packaging Recalls Scanner
      </h1>
      <p class="text-body text-[15px] md:text-body-md leading-relaxed">
        Verify your cookware, blenders, pressure cookers, and tableware against official CPSC, FDA, and international consumer safety recall dockets. Scan barcodes via your camera or search by model number.
      </p>
    </header>

    <!-- Main Scanner Tool Component -->
    <div class="mb-14">
      <ProductRecallsScanner lang="en" />
    </div>

    <!-- Regulatory Recall Standards & Authority Section -->
    <section class="mb-14 border-t border-hairline pt-12 space-y-6">
      <div class="max-w-3xl">
        <span class="text-xs font-bold uppercase tracking-wider text-muted block mb-1">
          Consumer Product Safety Act (CPSA) &bull; Federal Standards
        </span>
        <h2 class="text-title-lg md:text-display-sm font-medium text-ink tracking-tight mb-3">
          How Kitchenware Product Recalls Are Mandated
        </h2>
        <p class="text-body text-[15px] leading-relaxed mb-4">
          Under Section 15 of the Consumer Product Safety Act, manufacturers, importers, and distributors must immediately notify the CPSC when a product contains a defect that could create a substantial product hazard:
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="p-5 rounded-xl bg-surface-soft border border-hairline space-y-2">
          <div class="w-8 h-8 rounded-lg bg-rose-600 text-white font-bold flex items-center justify-center text-xs">CPSC</div>
          <h3 class="font-semibold text-ink text-sm">Consumer Product Safety</h3>
          <p class="text-xs text-body leading-relaxed">Jurisdiction over household small electrical appliances, air fryers, blenders, cookware, knives, and children's tableware.</p>
        </div>

        <div class="p-5 rounded-xl bg-surface-soft border border-hairline space-y-2">
          <div class="w-8 h-8 rounded-lg bg-blue-600 text-white font-bold flex items-center justify-center text-xs">FDA</div>
          <h3 class="font-semibold text-ink text-sm">Food &amp; Drug Administration</h3>
          <p class="text-xs text-body leading-relaxed">Enforces food contact substance safety (21 CFR), heavy metal leaching thresholds (lead and cadmium), and food packaging integrity.</p>
        </div>

        <div class="p-5 rounded-xl bg-surface-soft border border-hairline space-y-2">
          <div class="w-8 h-8 rounded-lg bg-emerald-700 text-white font-bold flex items-center justify-center text-xs">HC</div>
          <h3 class="font-semibold text-ink text-sm">Health Canada (CCPSA)</h3>
          <p class="text-xs text-body leading-relaxed">Coordinates joint bilateral safety recalls across North American supply chains to prevent cross-border grey market distribution.</p>
        </div>

        <div class="p-5 rounded-xl bg-surface-soft border border-hairline space-y-2">
          <div class="w-8 h-8 rounded-lg bg-amber-600 text-white font-bold flex items-center justify-center text-xs">EU</div>
          <h3 class="font-semibold text-ink text-sm">EU RAPEX Safety Gate</h3>
          <p class="text-xs text-body leading-relaxed">European rapid alert network monitoring toxic chemical migration in ceramics, silicone kitchenware, and imported cookware.</p>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="border-t border-hairline pt-12">
      <h2 class="text-title-lg md:text-display-sm font-medium text-ink tracking-tight mb-8">
        Frequently Asked Questions
      </h2>
      <div class="space-y-6 max-w-3xl">
        {faqs.map(faq => (
          <div class="border-b border-hairline pb-6">
            <h3 class="text-base font-semibold text-ink mb-2">
              {faq.question}
            </h3>
            <p class="text-body text-sm leading-relaxed">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>
