---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import DishwasherDetergentDosageCalculator from '../../components/DishwasherDetergentDosageCalculator.astro';
import rawData from '../../data/dishwasher-detergent-dosage-data.json';

const pageTitle = "Dishwasher Detergent, Rinse Aid & Hard Water Dosage Calculator | IsItKitchenSafe";
const pageDescription = "Calculate exact main-wash and pre-wash dishwasher detergent doses (tbsp/mL), rinse aid dial settings (1–6), and water hardness limits. Includes soft-water glass etching alerts, silicone soap-taste fixes, vinegar cloudy-glass test, and Dawn dish soap foam rescue.";

const faqs = rawData.faqs.en;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools/' },
  { label: 'Dishwasher Detergent & Rinse Aid Calculator' }
];

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Dishwasher Detergent, Rinse Aid & Hard Water Safety Calculator",
  "url": "https://isitkitchensafe.com/tools/dishwasher-detergent-dosage-calculator/",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript.",
  "description": pageDescription,
  "inLanguage": "en",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  faqs={faqs}
  excludeFaqSchema={true}
  availableLocales={['en', 'es', 'pt', 'zh-cn', 'ja']}
  lang="en"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1 print:hidden">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1140px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-signature-coral text-white mb-3">
        Hard Water Chemistry · Pre-Wash Dosing · Glass &amp; Silicone Safety
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        Dishwasher Detergent, Rinse Aid &amp; Hard Water Safety Calculator
      </h1>
      <p class="text-body text-[15px] md:text-[16px] leading-relaxed">
        Dial in exact <strong>main-wash and pre-wash detergent doses</strong>, optimal <strong>1–6 rinse aid settings</strong>, and material safety alerts for <strong>soft-water glass etching, soapy silicone baby plates, bare aluminum oxidation, and pods</strong>—plus a <strong>5-minute cloudy glass vinegar test</strong> and emergency <strong>Dawn dish soap foam rescue</strong>.
      </p>
    </header>

    <!-- Main Interactive Calculator, Vinegar Test, Emergency Foam Rescue, Related Links & 5 Visible FAQs -->
    <DishwasherDetergentDosageCalculator lang="en" />
  </div>
</Layout>
