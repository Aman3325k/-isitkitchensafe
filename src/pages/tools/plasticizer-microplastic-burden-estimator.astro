---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PlasticizerBurdenEstimator from '../../components/PlasticizerBurdenEstimator.astro';

const pageTitle = "Household Food Contact Plasticizer & Microplastic Blood Burden Estimator | IsItKitchenSafe";
const pageDescription = "Calculate your daily ingestion of microplastics, nanoplastics, and endocrine-disrupting phthalates from kitchen food contact materials, microwave heating, and cookware wear.";

const faqs = [
  {
    question: "How do microplastics and nanoplastics enter human blood from the kitchen?",
    answer: "Microplastics (>1 µm) and nanoplastics (<1 µm) enter human blood primarily through ingestion of food and water exposed to high heat, mechanical friction, or chemical degradation in the kitchen. When plastic food containers are microwaved, or when hot water sits in plastic electric kettles, the polymer bonds undergo hydrolytic scission, shedding billions of sub-micron particles directly into food. Once swallowed, particles smaller than 1.5 micrometers can translocate across the intestinal epithelial barrier via M-cells and paracellular pathways, entering the portal circulation and systemic blood flow."
  },
  {
    question: "What did the landmark 2024 New England Journal of Medicine (NEJM) study discover about microplastics in blood vessels?",
    answer: "A prospective multicenter study published in NEJM (Marfella et al., March 2024) analyzed carotid artery plaque removed from 257 asymptomatic patients. Researchers detected microplastics and nanoplastics (predominantly polyethylene and polyvinyl chloride) in 58.4% of patients. Over a 34-month follow-up, patients with detected plastics had a 4.53-fold higher hazard ratio for myocardial infarction, stroke, or all-cause mortality compared to patients without detectable plaque plastics, alongside significantly elevated inflammatory biomarkers (IL-18, IL-1β, TNF-α)."
  },
  {
    question: "Why does microwaving food in plastic containers release so many nanoplastics?",
    answer: "Microwaves heat polar water molecules at 2.45 GHz, causing rapid localized thermal spikes exceeding 120°C (248°F) at the interface between oily foods and the container wall. A 2023 University of Nebraska-Lincoln study published in Environmental Science & Technology revealed that just 3 minutes of microwave heating of polypropylene (PP) baby food containers released up to 4.22 million microplastic particles and 2.11 billion nanoplastic particles per square centimeter of container surface."
  },
  {
    question: "Are plastic cutting boards really a significant source of microplastics in home cooking?",
    answer: "Yes. An empirical study published in ACS Environmental Science & Technology (2023) demonstrated that knife chopping on standard polyethylene (PE) and polypropylene (PP) cutting boards generates between 1,114 and 7,900 microplastic particles per chopping session. Over a year of daily home cooking, an individual who chops meat and vegetables on plastic surfaces ingests an estimated 14.5 to 71.9 grams of microscopic plastic polymer shavings, which adhere electrostatically to wet foods."
  },
  {
    question: "What is the difference between 'BPA-free' plastics and truly non-toxic food contact materials?",
    answer: "'BPA-free' is largely a deceptive marketing term. To remove Bisphenol A (BPA), chemical manufacturers typically substitute chemically analogous bisphenols such as Bisphenol S (BPS), Bisphenol F (BPF), or Bisphenol AF (BPAF). Peer-reviewed toxicological studies show that BPS and BPF exhibit equal or greater endocrine-disrupting potency, anti-androgenic activity, and genotoxicity as BPA. Truly non-toxic food contact materials are non-polymeric: borosilicate glass, 18/10 stainless steel, glazed ceramic (lead/cadmium-free), and seasoned cast iron."
  },
  {
    question: "How can I immediately reduce my family's microplastic and phthalate blood burden?",
    answer: "You can eliminate up to 85% of household food-contact microplastic ingestion immediately through four simple interventions: (1) Never microwave in plastic—transfer all food to glass or ceramic plates before heating; (2) Swap plastic cutting boards for end-grain hardwood or bamboo boards; (3) Drink filtered tap water from stainless steel or glass bottles instead of single-use PET bottles; and (4) Replace scratched Teflon/PTFE non-stick cookware with cast iron or stainless steel."
  }
];

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools/' },
  { label: 'Plasticizer & Microplastic Burden Estimator' }
];

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Household Food Contact Plasticizer & Microplastic Blood Burden Estimator",
  "url": "https://isitkitchensafe.com/tools/plasticizer-microplastic-burden-estimator/",
  "applicationCategory": "HealthApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "description": pageDescription,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};
---

<Layout title={pageTitle} description={pageDescription} faqs={faqs} availableLocales={['en', 'es', 'pt', 'zh-cn', 'ja']}>
  <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />

  <main class="container mx-auto px-4 py-8 max-w-5xl space-y-8">
    <Breadcrumbs items={breadcrumbs} />

    <PlasticizerBurdenEstimator lang="en" />

    <!-- FAQ Accordion / Grid Section -->
    <section class="mt-16 bg-surface-soft border border-hairline rounded-3xl p-6 md:p-10 space-y-6">
      <div class="border-b border-hairline pb-4">
        <span class="text-xs font-bold uppercase tracking-wider text-purple-700 block mb-1">
          Peer-Reviewed Diagnostic Q&amp;A
        </span>
        <h2 class="text-title-lg font-medium text-ink tracking-tight">
          Frequently Asked Questions on Kitchen Microplastics &amp; Blood Absorption
        </h2>
        <p class="text-xs text-muted">Evidence-based answers grounded in clinical toxicology and gastroenterology studies.</p>
      </div>

      <div class="space-y-4">
        {faqs.map(faq => (
          <details class="group p-4 rounded-xl bg-canvas border border-hairline transition-colors open:bg-surface">
            <summary class="font-medium text-ink cursor-pointer list-none flex items-center justify-between text-sm md:text-base">
              <span>{faq.question}</span>
              <span class="text-muted transition-transform group-open:rotate-180 ml-2">&darr;</span>
            </summary>
            <p class="text-xs md:text-sm text-body mt-3 pt-3 border-t border-hairline/60 leading-relaxed">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </main>
</Layout>
