---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import MicrowaveSteamSplashSimulator from '../../components/MicrowaveSteamSplashSimulator.astro';
import rawData from '../../data/microwave-steam-splash-data.json';

const pageTitle = "Microwave Steam Splash, Venting & Warped Container Leaching Simulator | IsItKitchenSafe";
const pageDescription = "Calculate scald explosion, steam pressurization, vacuum warping, and condensation droplet chemical reflux risks when microwaving food in plastic containers. Verified via ACS Nano 2023 & FDA standards.";

const faqs = rawData.faqs.en;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools/' },
  { label: 'Microwave Steam Splash & Warped Container Leaching Simulator' }
];

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Microwave Steam Splash, Venting & Warped Container Leaching Simulator",
  "url": "https://isitkitchensafe.com/tools/microwave-steam-splash-simulator/",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript.",
  "description": pageDescription,
  "inLanguage": "en",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  faqs={faqs}
  excludeFaqSchema={true}
  availableLocales={['en', 'es', 'pt', 'zh-cn', 'ja']}
  lang="en"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1 print:hidden">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1140px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-signature-coral text-white mb-3">
        ACS Nano 2023 · FDA 21 CFR § 177 · Steam Reflux Physics · ASTM D7611 Codes #1–#7
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        Microwave Steam Splash, Venting &amp; Warped Container Leaching Simulator
      </h1>
      <p class="text-body text-[15px] md:text-[16px] leading-relaxed">
        Stop guessing if sealed plastic lids and warped containers are safe: calculate <strong>steam pressurization explosion risks</strong>, simulate <strong>condensation droplet chemical reflux</strong> where hot lid droplets rain plasticizers back onto your food, inspect <strong>pitted fat melt spots</strong>, and master certified non-toxic venting protocols.
      </p>
    </header>

    <!-- Main Interactive Simulator Component -->
    <MicrowaveSteamSplashSimulator lang="en" />
  </div>
</Layout>
