---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CommercialContinuousSfcModeler from '../../components/CommercialContinuousSfcModeler.astro';

const pageTitle = "Commercial Continuous Supercritical Fluid Chromatography (SFC) Industrial Cannabinoid & Bioactive Purification Modeler | IsItKitchenSafe";
const pageDescription = "Simulate commercial continuous multi-column supercritical fluid chromatography (SFC) utilizing dense CO2 and ethanol co-solvent mobile phases at up to 350 bar. Model Peng-Robinson fluid density, Van Deemter plate height kinetics, peak resolution (Rs), industrial cannabinoid THC remediation (<0.01%), marine astaxanthin isomer isolation, and ASME BPVC Section VIII sanitary overpressure relief sizing.";

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools/' },
  { label: 'Commercial Continuous SFC Purification Modeler' }
];

const faqs = [
  {
    question: "How does continuous Supercritical Fluid Chromatography (SFC) achieve bioactive purification and cannabinoid remediation without toxic solvents?",
    answer: "Continuous SFC utilizes carbon dioxide in its supercritical state (above its critical temperature of 31.1°C and critical pressure of 73.8 bar) as the primary mobile phase, blended with food-grade anhydrous ethanol as an organic modifier (5% to 25% v/v). In this supercritical domain, CO2 exhibits liquid-like density (0.65 to 0.92 g/mL) providing strong solvating power for lipophilic botanical molecules, combined with gas-like diffusivity (ten-fold higher than liquid solvents) and ultra-low viscosity. Target bioactives (such as cannabidiol, astaxanthin, or omega-3 fatty acid ethyl esters) interact with stationary phase polar ligands (e.g., 2-ethylpyridine or diol-bonded silica) and elute with sharp peak resolution. Following elution, the stream is depressurized across a backpressure regulator where CO2 instantly flashes into vapor and is recompressed with >98% efficiency, yielding concentrated, solvent-free bioactive fractions with zero toxic hydrocarbon residue."
  },
  {
    question: "How does the Van Deemter equation explain the high speed and throughput of preparative SFC compared to HPLC?",
    answer: "The Van Deemter equation governs column efficiency through plate height: H = A + B/u + C·u, where A represents eddy diffusion, B/u is longitudinal molecular diffusion, and C·u represents resistance to mass transfer in the stationary and mobile phases. Because the binary diffusion coefficient (D12) in supercritical CO2 is an order of magnitude higher than in conventional HPLC liquid mobile phases (~10⁻⁴ cm²/s vs. ~10⁻⁵ cm²/s), the C-term mass transfer resistance is dramatically reduced. Consequently, preparative SFC columns can operate at linear interstitial velocities 3 to 5 times higher than HPLC without significant peak broadening, delivering vastly superior mass throughput and productivity."
  },
  {
    question: "Why is modifier co-solvent percentage (% v/v) critical for resolving psychotropic THC from therapeutic CBD in hemp extracts?",
    answer: "Pure supercritical CO2 has zero dipole moment and is non-polar, which is insufficient to selectively desorb moderately polar poly-hydroxylated cannabinoids from bonded stationary phases. Adding controlled percentages of USP food-grade ethanol (typically 8% to 15% v/v) introduces hydrogen-bonding and dipole-dipole interactions that selectively compete for silanol and pyridine active sites. Under precise modifier ratios and column temperatures (40°C to 45°C), the selectivity factor (α) between CBD and Δ9-THC reaches 1.45 to 1.55, enabling baseline separation (Rs ≥ 1.5). This allows continuous isolation of purified broad-spectrum CBD while completely removing THC to non-detectable levels (<0.01% w/w), fully compliant with the 2018 US Farm Bill and international pharmacopeial limits."
  },
  {
    question: "How do ASME BPVC Section VIII guidelines govern overpressure relief sizing on high-pressure SFC columns?",
    answer: "Preparative SFC systems operate at extreme pressures (150 to 350 bar / 2,175 to 5,075 psi). Under ASME Boiler and Pressure Vessel Code (BPVC) Section VIII, Division 1 and API 520, column housings, tubing, and backpressure regulators must feature certified overpressure protection sized for full supercritical fluid relieving capacity. Systems integrate forward-acting Inconel 625 rupture discs with inter-space electronic pressure transducers to detect pinholes, backed by sanitary proportional safety relief valves set at the vessel Maximum Allowable Working Pressure (MAWP). Discharge lines are hermetically piped to low-pressure expansion spheres to contain flashing gas safely without venting high-pressure gas into the operating cleanroom."
  },
  {
    question: "What cGMP and FDA 21 CFR § 111 / § 117 sanitation requirements apply to food-grade and nutraceutical SFC installations?",
    answer: "SFC facilities producing dietary supplements, food ingredients, or active pharmaceutical ingredients (APIs) must comply with FDA 21 CFR § 111 (cGMP for Dietary Supplements) and 21 CFR § 117 (Preventive Controls for Human Food). Compliance mandates: (1) 316L sanitary stainless steel product-contact fluid paths with electropolished surfaces (Ra ≤ 0.4 µm / 16 µin); (2) virgin PTFE or PEEK seals resistant to high-pressure explosive decompression during CO2 depressurization; (3) validated Clean-In-Place (CIP) rinse protocols using food-grade anhydrous ethanol to eliminate cross-batch contamination; and (4) continuous online monitoring of CO2 recycling systems to prevent cumulative buildup of heavy volatile terpenes or degradation byproducts."
  }
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": "https://isitkitchensafe.com/tools/commercial-continuous-supercritical-fluid-chromatography-modeler/#webapp",
      "url": "https://isitkitchensafe.com/tools/commercial-continuous-supercritical-fluid-chromatography-modeler/",
      "name": "Commercial Continuous Supercritical Fluid Chromatography (SFC) Industrial Cannabinoid & Bioactive Purification Modeler",
      "applicationCategory": "EngineeringApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5 Canvas/CSS3.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": pageDescription
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://isitkitchensafe.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Tools",
          "item": "https://isitkitchensafe.com/tools/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Commercial Continuous SFC Purification Modeler",
          "item": "https://isitkitchensafe.com/tools/commercial-continuous-supercritical-fluid-chromatography-modeler/"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  structuredData={structuredData}
>
  <main class="min-h-screen bg-surface-subtle py-8 sm:py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={breadcrumbs} />
      
      <!-- Interactive Modeler Component -->
      <CommercialContinuousSfcModeler lang="en" />

      <!-- Frequently Asked Questions (FAQ) Section -->
      <section class="mt-12 bg-surface rounded-2xl border border-hairline p-6 sm:p-8 shadow-xs">
        <div class="mb-6">
          <h2 class="text-xl sm:text-2xl font-bold text-ink tracking-tight mb-2">
            Frequently Asked Questions: Supercritical Fluid Chromatography &amp; Bioactive Purification
          </h2>
          <p class="text-body text-sm text-muted">
            Technical guidance on supercritical CO2 mobile phase thermodynamics, stationary phase selectivity, Van Deemter mass transfer kinetics, and ASME BPVC Section VIII sanitary overpressure safety.
          </p>
        </div>

        <div class="space-y-4">
          {faqs.map((faq, idx) => (
            <details class="group rounded-xl border border-hairline bg-surface-soft p-4 transition-all open:bg-surface open:shadow-xs">
              <summary class="flex cursor-pointer items-center justify-between font-medium text-ink text-sm sm:text-base list-none">
                <span class="font-bold flex items-center gap-2">
                  <span class="text-emerald-700 font-mono text-xs">Q{idx + 1}.</span>
                  {faq.question}
                </span>
                <span class="ml-4 transition-transform group-open:rotate-180 text-muted text-xs">
                  ▼
                </span>
              </summary>
              <div class="mt-3 text-xs sm:text-sm text-body leading-relaxed border-t border-hairline/60 pt-3 text-muted">
                {faq.answer}
              </div>
            </details>
          ))}
        </div>
      </section>
    </div>
  </main>
</Layout>
