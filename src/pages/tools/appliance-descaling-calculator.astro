---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ApplianceDescalingCalculator from '../../components/ApplianceDescalingCalculator.astro';

const pageTitle = "Coffee Maker, Electric Kettle & Espresso Descaling Ratio Calculator | IsItKitchenSafe";
const pageDescription = "Calculate exact citric acid, white vinegar, and commercial descaler dilution ratios, flush volumes, and soak times for Keurigs, Nespresso, espresso thermoblocks, and kettles.";

const faqs = [
  {
    question: "Why do manufacturers like Nespresso and Breville warn against using white vinegar?",
    answer: "White vinegar contains 4% to 8% acetic acid, which has two major liabilities in precision brewers. First, acetic acid is chemically aggressive toward silicone O-rings, rubber seals, and bare aluminum thermoblocks, causing premature embrittlement, pitting, and leaks. Second, acetic acid is volatile and absorbs into internal plastic tubing, creating a pungent, sour smell that can take 10 or more water flushes to eliminate. Food-grade citric acid and lactic acid solutions do not degrade silicone seals, are non-volatile, and rinse clean in just two cycles."
  },
  {
    question: "How do I turn off or reset the Keurig 'Descale' light after cleaning?",
    answer: "On modern Keurig models (such as K-Supreme and K-Slim), the descale light does not turn off based on water purity; it turns off when the machine detects that a continuous, uninterrupted descaling and water-rinse protocol has run to empty. If the light remains illuminated after descaling: 1) Ensure the water reservoir was run completely empty until the 'Add Water' notification appeared; 2) Fill the reservoir to the MAX fill line with fresh tap water and run continuous brew cycles without inserting a K-Cup until the reservoir empties a second time; 3) On stubborn K-Supreme units, power down the unit, unplug for 10 minutes, or hold down the 8 oz and 10 oz (or 8 oz and 12 oz) buttons simultaneously for 3 to 5 seconds to clear the logic board memory."
  },
  {
    question: "Why should you NEVER mix baking soda with vinegar or citric acid to descale?",
    answer: "Combining sodium bicarbonate (baking soda, an alkaline base with pH ~8.5) with vinegar (acetic acid, pH ~2.5) or citric acid causes an immediate exothermic neutralization reaction. The acid and base neutralize each other, yielding water, carbon dioxide gas (the dramatic fizzing bubbles), and sodium acetate or sodium citrate salt. This reaction destroys the free hydrogen ions required to chemically dissolve calcium carbonate (limescale). Furthermore, undissolved sodium bicarbonate crystals can lodge inside needle nozzles, narrow boiler passages, and solenoid check valves, creating severe internal blockages."
  },
  {
    question: "Why is food-grade citric acid powder considered the gold standard for descaling?",
    answer: "Food-grade citric acid powder is a triprotic organic acid (pH ~2.2 in standard 2% dilution) that binds aggressively to calcium and magnesium ions through chelation. Unlike vinegar, it is 100% odorless and leaves zero volatile aftertaste in your morning coffee. It dissolves stubborn limescale twice as quickly as 5% acetic acid, is completely safe on food-contact stainless steel and copper boilers, and costs a fraction of single-use branded commercial liquid descaler bottles."
  },
  {
    question: "How does local tap water hardness dictate your appliance descaling schedule?",
    answer: "Limescale is formed when dissolved calcium (Ca²⁺) and magnesium (Mg²⁺) bicarbonate precipitate out of solution upon heating above 140°F (60°C). In soft water regions (<60 ppm or <3.5 GPG), descaling once every 4 to 6 months is sufficient. In moderate water (60–120 ppm), descale every 2 to 3 months. In hard to very hard water regions (>120–180 ppm or >10 GPG), mineral crust accumulates exponentially on heating elements, restricting flow rates, dropping brew temperatures, and causing thermoblock burnouts; appliances in these areas should be descaled every 3 to 4 weeks (or every 30 to 45 brew cycles)."
  }
];

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools/' },
  { label: 'Appliance Descaling Calculator' }
];

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Coffee Maker, Electric Kettle & Espresso Descaling Ratio Calculator",
  "url": "https://isitkitchensafe.com/tools/appliance-descaling-calculator/",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript.",
  "description": pageDescription,
  "inLanguage": "en",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
  excludeFaqSchema={true}
  availableLocales={['en', 'es', 'pt', 'zh-cn', 'ja']}
>
  <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={breadcrumbs} className="mb-0" />
    </div>
  </div>

  <main class="max-w-[1280px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="max-w-[880px] mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-signature-teal text-white mb-3">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23.693l-1.57-.393m15.6 0l1.24 3.72A2.25 2.25 0 0118.705 22H5.295a2.25 2.25 0 01-2.135-2.987l1.24-3.72" />
        </svg>
        <span>Appliance Metallurgy & Food-Grade Descaling Science</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-heading tracking-tight mb-4">
        Coffee Maker, Electric Kettle & Espresso Descaling Ratio Calculator
      </h1>
      <p class="text-base sm:text-lg text-body-secondary leading-relaxed">
        Eliminate stubborn calcium scale, eliminate rancid coffee aftertaste, and prevent costly thermoblock burnouts. Select your appliance type, tank capacity, and local water hardness to calculate scientific acid dilution ratios, soak intervals, and rinse protocols.
      </p>
    </header>

    <!-- Interactive Component -->
    <section class="mb-14">
      <ApplianceDescalingCalculator lang="en" />
    </section>

    <!-- Critical Kitchen Safety Alerts & E-E-A-T Guide -->
    <section class="mt-14 border-t border-hairline pt-12">
      <div class="max-w-[960px] mx-auto">
        <h2 class="text-2xl sm:text-3xl font-bold text-heading tracking-tight mb-4">
          Critical Descaling Rules & Appliance Safety Science
        </h2>
        <p class="text-base text-body-secondary mb-8">
          Not all kitchen heating elements are built the same. Using the wrong descaler or incorrect water ratios can permanently pit aluminum boilers, corrode silicone gaskets, or trigger toxic gas emissions.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
          <div class="p-6 rounded-2xl bg-danger-soft border border-danger-hairline">
            <div class="flex items-start gap-3">
              <span class="text-2xl" aria-hidden="true">🚫</span>
              <div>
                <h3 class="font-bold text-red-900 dark:text-red-300 text-lg mb-1">
                  Never Mix Descaling Acids With Bleach
                </h3>
                <p class="text-sm text-red-800 dark:text-red-200 leading-relaxed">
                  Mixing citric acid, vinegar, or commercial sulfamic descalers with chlorine bleach immediately produces lethal <strong>chlorine gas (Cl₂)</strong>. Always thoroughly flush an appliance with fresh water before introducing any sanitizing agent.
                </p>
              </div>
            </div>
          </div>

          <div class="p-6 rounded-2xl bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-900/40">
            <div class="flex items-start gap-3">
              <span class="text-2xl" aria-hidden="true">⚠️</span>
              <div>
                <h3 class="font-bold text-amber-900 dark:text-amber-300 text-lg mb-1">
                  The Baking Soda Neutralization Fallacy
                </h3>
                <p class="text-sm text-amber-800 dark:text-amber-200 leading-relaxed">
                  Adding baking soda to vinegar produces entertaining bubbles, but the acid and base chemically neutralize each other into harmless salt water. Zero mineral-dissolving acidity remains, and micro-granules can clog narrow solenoid valves.
                </p>
              </div>
            </div>
          </div>

          <div class="p-6 rounded-2xl bg-surface-soft border border-hairline">
            <div class="flex items-start gap-3">
              <span class="text-2xl" aria-hidden="true">☕</span>
              <div>
                <h3 class="font-bold text-heading text-lg mb-1">
                  Why Nespresso & Breville Ban Vinegar
                </h3>
                <p class="text-sm text-body-secondary leading-relaxed">
                  Acetic acid attacks aluminum thermoblocks and causes premature brittleness in silicone seals. Furthermore, vinegar fumes bond with internal plastics, spoiling coffee flavor for weeks. Stick to citric or lactic acid.
                </p>
              </div>
            </div>
          </div>

          <div class="p-6 rounded-2xl bg-surface-soft border border-hairline">
            <div class="flex items-start gap-3">
              <span class="text-2xl" aria-hidden="true">💡</span>
              <div>
                <h3 class="font-bold text-heading text-lg mb-1">
                  The Keurig Optic Descale Light Fix
                </h3>
                <p class="text-sm text-body-secondary leading-relaxed">
                  The Keurig descale light will not turn off until the machine completes an uninterrupted flush cycle. Run the reservoir completely empty until "Add Water" illuminates, then run a full tank of clean water without stopping.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- FAQ Section -->
        <div class="mt-12">
          <h2 class="text-2xl sm:text-3xl font-bold text-heading tracking-tight mb-6">
            Frequently Asked Questions: Descaling & Appliance Care
          </h2>
          <div class="space-y-4">
            {faqs.map((faq) => (
              <details class="group p-5 rounded-xl border border-hairline bg-surface-soft open:bg-surface-elevated transition-colors">
                <summary class="font-bold text-heading cursor-pointer list-none flex items-center justify-between gap-4">
                  <span>{faq.question}</span>
                  <span class="text-signature-teal group-open:rotate-180 transition-transform text-lg leading-none" aria-hidden="true">▾</span>
                </summary>
                <p class="mt-3 text-sm text-body-secondary leading-relaxed border-t border-hairline pt-3">
                  {faq.answer}
                </p>
              </details>
            ))}
          </div>
        </div>

        <!-- Related Consumer Tools -->
        <div class="mt-12 pt-8 border-t border-hairline">
          <h3 class="text-lg font-bold text-heading mb-4">Related Consumer Kitchen Safety Tools</h3>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <a href="/tools/cookware-oven-temp-lookup/" class="p-4 rounded-xl border border-hairline bg-surface-soft hover:border-signature-teal transition-all group">
              <span class="text-xs font-semibold text-signature-teal block mb-1">Cookware Reference</span>
              <span class="font-bold text-heading text-sm group-hover:text-signature-teal block">Cookware Oven Temp Lookup →</span>
              <p class="text-xs text-body-secondary mt-1">Check safe maximum oven and broiler temperatures by pan material and brand.</p>
            </a>
            <a href="/tools/air-fryer-oven-converter/" class="p-4 rounded-xl border border-hairline bg-surface-soft hover:border-signature-teal transition-all group">
              <span class="text-xs font-semibold text-signature-teal block mb-1">Appliance Calculator</span>
              <span class="font-bold text-heading text-sm group-hover:text-signature-teal block">Air Fryer to Oven Converter →</span>
              <p class="text-xs text-body-secondary mt-1">Convert oven baking recipes to air fryer temperature and cooking time.</p>
            </a>
            <a href="/tools/internal-cooking-temp-chart/" class="p-4 rounded-xl border border-hairline bg-surface-soft hover:border-signature-teal transition-all group">
              <span class="text-xs font-semibold text-signature-teal block mb-1">USDA Food Safety</span>
              <span class="font-bold text-heading text-sm group-hover:text-signature-teal block">Internal Cooking Temp Chart →</span>
              <p class="text-xs text-body-secondary mt-1">USDA safe minimum internal temperatures and resting times for meat and poultry.</p>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
