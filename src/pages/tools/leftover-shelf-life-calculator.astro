---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import LeftoverShelfLifeCalculator from '../../components/LeftoverShelfLifeCalculator.astro';

const pageTitle = "USDA Leftover & Fridge Shelf-Life Countdown Calculator | IsItKitchenSafe";
const pageDescription = "Check how long cooked chicken, rice, pizza, soup, eggs, and dairy stay safe in your fridge or freezer. Instant USDA FSIS FoodKeeper countdown, 2-hour Danger Zone check, and reheating targets.";

const faqs = [
  {
    question: "How long do cooked leftovers stay safe in the refrigerator according to the USDA?",
    answer: "Under USDA FSIS FoodKeeper guidelines, most cooked leftovers—including roasted chicken, cooked beef, pasta, rice, pizza, soups, and cooked vegetables—stay safe in a 35–40°F (2–4°C) refrigerator for 3 to 4 days. High-moisture meat/poultry gravy is stricter (1–2 days), while raw ground meat and raw poultry should be cooked or frozen within 1–2 days. Always freeze leftovers by Day 4 if you won't finish them."
  },
  {
    question: "What is the USDA 2-Hour Rule (and 1-Hour Rule) for food left on the counter?",
    answer: "Perishable foods must never sit in the Temperature Danger Zone between 40°F and 140°F (4°C–60°C) for more than 2 cumulative hours. When outdoor or kitchen temperatures exceed 90°F (32°C)—such as summer picnics or uncooled kitchens—the safe limit drops to just 1 hour. Beyond that window, bacteria like Staphylococcus aureus and Bacillus cereus can double every 20 minutes and produce heat-resistant toxins."
  },
  {
    question: "Does reheating spoiled rice or leftovers to 165°F (74°C) make them safe to eat?",
    answer: "No. Reheating leftovers to an internal temperature of 165°F (74°C) kills live vegetative bacteria, but it does NOT destroy heat-stable toxins already produced by pathogens like Bacillus cereus (common in cooked rice and pasta left at room temperature) or Staphylococcus aureus. If food sat out past the 2-hour Danger Zone or exceeded its refrigerator limit, discard it immediately."
  },
  {
    question: "If a leftover smells and looks fine after 5 or 6 days in the fridge, is it still safe?",
    answer: "Not necessarily. Spoilage bacteria cause sour odors, slime, and mold, whereas dangerous foodborne pathogens such as Listeria monocytogenes, Salmonella, and E. coli are odorless, tasteless, and invisible. Listeria can even continue multiplying slowly at normal refrigerator temperatures (40°F / 4°C). Follow strict USDA time limits rather than relying on the sniff test alone."
  },
  {
    question: "Can I freeze leftovers on Day 3 or 4, and how long will they last in the freezer?",
    answer: "Yes—freezing leftovers before their 3–4 day refrigerator window expires pauses bacterial growth completely. At a constant 0°F (-18°C), frozen food stays microbiologically safe indefinitely, while peak flavor and texture last 2–4 months for most cooked dishes (soups, poultry, casseroles, pizza) and up to 6 months for cooked rice or beans. Once thawed in the fridge, eat within 3–4 days."
  }
];

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools/' },
  { label: 'Leftover Shelf-Life Calculator' }
];

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "USDA Leftover & Fridge Shelf-Life Countdown Calculator",
  "url": "https://isitkitchensafe.com/tools/leftover-shelf-life-calculator/",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript.",
  "description": pageDescription,
  "inLanguage": "en",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};

const usdaCheatSheet = [
  { food: "Cooked Chicken / Turkey", fridge: "3–4 days", freezer: "2–6 months", reheat: "165°F / 74°C", risk: "Salmonella, C. perfringens" },
  { food: "Cooked Rice & Pasta", fridge: "3–4 days", freezer: "2–6 months", reheat: "165°F / 74°C", risk: "Bacillus cereus (heat-stable toxin)" },
  { food: "Leftover Pizza", fridge: "3–4 days", freezer: "1–2 months", reheat: "165°F / 74°C", risk: "Staph aureus, B. cereus" },
  { food: "Soup, Stew & Chili", fridge: "3–4 days", freezer: "2–3 months", reheat: "165°F / Rolling Boil", risk: "Clostridium perfringens" },
  { food: "Turkey / Meat Gravy", fridge: "1–2 days", freezer: "2–3 months", reheat: "165°F / Rolling Boil", risk: "C. perfringens, Salmonella" },
  { food: "Raw Poultry & Ground Meat", fridge: "1–2 days", freezer: "4–9 months", reheat: "160–165°F (71–74°C)", risk: "Salmonella, E. coli O157:H7" },
  { food: "Opened Deli / Lunch Meat", fridge: "3–5 days", freezer: "1–2 months", reheat: "165°F if high-risk", risk: "Listeria monocytogenes" },
  { food: "Hard-Boiled Eggs (In Shell)", fridge: "7 days (3–5 peeled)", freezer: "Do not freeze", reheat: "Serve cold", risk: "Salmonella, Listeria" }
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  excludeFaqSchema={true}
  availableLocales={['en', 'es', 'pt', 'zh-cn', 'ja']}
  lang="en"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1140px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-signature-coral text-white mb-3">
        USDA FSIS FoodKeeper Tool
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        Leftover &amp; Fridge Shelf-Life Countdown Calculator
      </h1>
      <p class="text-body text-[15px] md:text-[16px] leading-relaxed">
        Not sure if that leftover chicken, cooked rice, pizza, or holiday gravy is still safe to eat? Enter when it was cooked or opened and how long it sat at room temperature to get an instant USDA verdict, live safe-until countdown, pathogen alerts, and reheating target.
      </p>
    </header>

    <!-- Main Interactive Calculator -->
    <div class="mb-14">
      <LeftoverShelfLifeCalculator lang="en" />
    </div>

    <!-- USDA Quick Reference Cheat Sheet -->
    <section class="mb-14 space-y-5">
      <div>
        <h2 class="text-title-lg font-medium text-ink tracking-tight mb-2">
          USDA Cold Food Storage &amp; Reheating Quick Chart
        </h2>
        <p class="text-body text-[14.5px] leading-relaxed">
          Reference limits for a properly calibrated refrigerator at <strong>40°F (4°C) or below</strong> and freezer at <strong>0°F (-18°C)</strong>. Learn how we verify food safety citations in our <a href="/methodology/" class="text-link underline hover:text-link-active">Methodology</a>.
        </p>
      </div>

      <div class="border border-hairline rounded-xl overflow-hidden bg-canvas">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="bg-surface-strong border-b border-hairline text-ink font-semibold">
              <tr>
                <th class="p-3.5">Food / Leftover</th>
                <th class="p-3.5">Fridge (≤40°F)</th>
                <th class="p-3.5">Freezer (0°F)</th>
                <th class="p-3.5">Safe Reheat / Cook</th>
                <th class="p-3.5">Key Pathogen Risk</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-hairline">
              {usdaCheatSheet.map((row, idx) => (
                <tr class={idx % 2 === 0 ? 'bg-canvas' : 'bg-surface-soft'}>
                  <td class="p-3.5 font-semibold text-ink whitespace-nowrap">{row.food}</td>
                  <td class="p-3.5 text-body whitespace-nowrap font-medium">{row.fridge}</td>
                  <td class="p-3.5 text-body whitespace-nowrap">{row.freezer}</td>
                  <td class="p-3.5 text-body whitespace-nowrap">{row.reheat}</td>
                  <td class="p-3.5 text-body text-[13px]">{row.risk}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Related Storage Hubs & Tools -->
    <section class="mb-14 grid grid-cols-1 md:grid-cols-2 gap-5">
      <a
        href="/how-long/"
        class="p-6 rounded-2xl bg-surface-soft border border-hairline hover:border-signature-coral transition-all group block"
      >
        <span class="text-[11px] font-bold uppercase tracking-wider text-signature-coral block mb-1.5">
          Food Shelf-Life Directory
        </span>
        <h3 class="text-title-sm font-semibold text-ink group-hover:text-signature-coral transition-colors mb-1.5">
          How Long Does Food Last in the Fridge? &rarr;
        </h3>
        <p class="text-[13.5px] text-body leading-relaxed">
          Browse item-by-item USDA shelf-life guides for meats, leftovers, condiments, dairy, and produce.
        </p>
      </a>

      <a
        href="/tools/kitchen-symbol-decoder/"
        class="p-6 rounded-2xl bg-surface-soft border border-hairline hover:border-signature-coral transition-all group block"
      >
        <span class="text-[11px] font-bold uppercase tracking-wider text-signature-coral block mb-1.5">
          Related Interactive Tool
        </span>
        <h3 class="text-title-sm font-semibold text-ink group-hover:text-signature-coral transition-colors mb-1.5">
          Kitchen Container &amp; Plastic Symbol Decoder &rarr;
        </h3>
        <p class="text-[13.5px] text-body leading-relaxed">
          Check whether your leftover Tupperware or takeout container is actually freezer-safe and microwave-safe before reheating.
        </p>
      </a>
    </section>

    <!-- Core Storage Hub Strip -->
    <section class="mb-14 p-6 rounded-2xl bg-surface-soft border border-hairline">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <h2 class="text-title-sm font-semibold text-ink mb-1">
            Explore Verified Food Storage &amp; Refreezing Hubs
          </h2>
          <p class="text-[13px] text-muted">
            Double-check safe refreezing rules, refrigerator zones, and freezer-safe containers.
          </p>
        </div>
        <div class="flex flex-wrap gap-2">
          <a href="/how-long/" class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral transition-colors">How Long Lasts</a>
          <a href="/refreeze/" class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral transition-colors">Can You Refreeze?</a>
          <a href="/refrigerator/" class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral transition-colors">Refrigerator Guide</a>
          <a href="/freezer/" class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral transition-colors">Freezer Guide</a>
          <a href="/methodology/" class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral transition-colors">Methodology</a>
          <a href="/tools/" class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-primary text-on-primary hover:bg-primary-active transition-colors">All Tools &rarr;</a>
        </div>
      </div>
    </section>

    <!-- FAQ Section (5 Consumer-Friendly FAQs) -->
    <section class="mb-8">
      <h2 class="text-title-lg font-medium text-ink tracking-tight mb-6">
        Frequently Asked Questions About Leftover Safety
      </h2>
      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="group p-5 bg-surface-soft border border-hairline rounded-xl" open>
            <summary class="text-title-sm font-semibold text-ink cursor-pointer list-none flex items-center justify-between gap-3">
              <span>{faq.question}</span>
              <span class="text-muted text-sm transition-transform group-open:rotate-180 shrink-0" aria-hidden="true">&#9662;</span>
            </summary>
            <p class="text-[14px] text-body leading-relaxed mt-3 pt-3 border-t border-hairline/70">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </div>
</Layout>
