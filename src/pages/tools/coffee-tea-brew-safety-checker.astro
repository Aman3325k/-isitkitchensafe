---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CoffeeTeaBrewSafetyChecker from '../../components/CoffeeTeaBrewSafetyChecker.astro';
import rawData from '../../data/coffee-tea-brew-safety-data.json';

const pageTitle = "Coffee, Espresso, Cold Brew & Tea Safe Brewing, Storage & Kettle Material Checker | IsItKitchenSafe";
const pageDescription = "Interactive CDC, FDA & SCA coffee, cold brew, kombucha & tea safety checker: inspect 10 drink storage limits (sun tea warnings, botulism cold-brew risks, 2-hour milk coffee rule), compare 7 kettle & brewer materials for microplastics/leaching, and toggle °F/°C brew temperatures.";

const faqs = rawData.faqs.en;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools/' },
  { label: 'Coffee, Cold Brew & Tea Safety Checker' }
];

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Coffee, Espresso, Cold Brew & Tea Safe Brewing, Storage & Kettle Material Checker",
  "url": "https://isitkitchensafe.com/tools/coffee-tea-brew-safety-checker/",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript.",
  "description": pageDescription,
  "inLanguage": "en",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  faqs={faqs}
  excludeFaqSchema={true}
  availableLocales={['en', 'es', 'pt', 'zh-cn', 'ja']}
  lang="en"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1 print:hidden">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1140px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-signature-coral text-white mb-3">
        CDC Sun Tea · FDA Cold Brew · SCA Water Temps · 10 Drinks · 7 Kettle Materials
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        Coffee, Espresso, Cold Brew &amp; Tea Safe Brewing, Storage &amp; Kettle Checker
      </h1>
      <p class="text-body text-[15px] md:text-[16px] leading-relaxed">
        Avoid CDC-flagged <strong>outdoor sun tea</strong>, room-temp <strong>cold-brew botulism</strong>, and <strong>microplastic-shedding plastic kettles</strong> — inspect <strong>10 coffee &amp; tea storage scenarios</strong>, compare <strong>7 kettle &amp; Moka pot materials</strong>, and check exact <strong>°F / °C brewing temperatures</strong>.
      </p>
    </header>

    <!-- Main Interactive Checker Component -->
    <CoffeeTeaBrewSafetyChecker lang="en" />
  </div>
</Layout>
