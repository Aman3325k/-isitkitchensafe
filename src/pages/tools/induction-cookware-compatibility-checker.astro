---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import InductionCookwareCompatibilityChecker from '../../components/InductionCookwareCompatibilityChecker.astro';
import rawData from '../../data/induction-cookware-compatibility-data.json';

const pageTitle = "Induction Cookware Compatibility & 3-Second Magnet Test Checker | IsItKitchenSafe";
const pageDescription = "Check whether 24 popular cookware materials and brands (Le Creuset, Lodge, All-Clad, Caraway, HexClad, Our Place, GreenPan, Bialetti, T-fal, Pyrex) work on induction stoves. Includes a 3-second magnet test simulator, glass scratch-risk warnings, and pacemaker clearance tips.";

const faqs = rawData.faqs.en;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools/' },
  { label: 'Induction Cookware Compatibility Checker' }
];

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Induction Cookware Compatibility & 3-Second Magnet Test Checker",
  "url": "https://isitkitchensafe.com/tools/induction-cookware-compatibility-checker/",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript.",
  "description": pageDescription,
  "inLanguage": "en",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  faqs={faqs}
  excludeFaqSchema={true}
  availableLocales={['en', 'es', 'pt', 'zh-cn', 'ja']}
  lang="en"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1 print:hidden">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1140px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-signature-coral text-white mb-3">
        3-Second Magnet Test · 24 Brands &amp; Materials · Glass &amp; Pacemaker Safety
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        Induction Cookware Compatibility &amp; Magnet Test Checker
      </h1>
      <p class="text-body text-[15px] md:text-[16px] leading-relaxed">
        Test any pot or skillet in seconds with our <strong>3-second fridge magnet simulator</strong>, search <strong>24 popular cookware materials &amp; brands</strong> (Lodge, Le Creuset, All-Clad, HexClad, Caraway, Our Place, GreenPan, Bialetti, T-fal, Pyrex), and check <strong>glass scratch risk, Boost warping limits, and pacemaker EMF clearance</strong>.
      </p>
    </header>

    <!-- Main Interactive Checker, 24-Brand Database, Safety Card, Related Links & 5 Visible FAQs -->
    <InductionCookwareCompatibilityChecker lang="en" />
  </div>
</Layout>
