---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import KitchenEnergyCarbonCalculator from '../../components/KitchenEnergyCarbonCalculator.astro';

const pageTitle = "Smart Kitchen Energy & Appliance Carbon Footprint Calculator | IsItKitchenSafe";
const pageDescription = "Calculate real-world kilowatt-hour (kWh) electricity use, cooking times, utility bills, and greenhouse gas carbon footprints across induction, air fryer, microwave, oven, and gas appliances.";

const faqs = [
  {
    question: "Is an air fryer actually more energy-efficient than a standard electric oven?",
    answer: "Yes, by an enormous margin. A standard electric oven features a large 120–150 liter cavity that draws 2,500 to 3,500 watts and requires 12 to 18 minutes of preheating before cooking even starts. In contrast, an air fryer has a compact 4 to 6-quart (4–6 liter) cooking chamber powered by a 1,500 to 1,750 watt element with rapid high-velocity convective airflow. It reaches 200°C (400°F) in under 2 minutes. For small to medium family portions (such as roasting 1.5 lb of chicken or baking 2 potatoes), an air fryer uses 60% to 75% less electricity and cooks up to 40% faster."
  },
  {
    question: "How much energy does an induction cooktop save compared to a gas range?",
    answer: "Induction cooktops have a thermal transfer efficiency of 85% to 90%, compared to only 38% to 40% for natural gas burners and ~74% for electric radiant glass cooktops. Because induction uses alternating magnetic fields to directly excite ferrous molecules inside the pan base, virtually zero heat escapes into the surrounding room. With a gas flame, over 60% of the combustion heat curls up around the cookware, warming the ambient kitchen air and requiring heavy exhaust ventilation or air conditioning."
  },
  {
    question: "Does handwashing dishes really use more energy than running a modern dishwasher?",
    answer: "Yes, by more than 300%. A modern ENERGY STAR certified dishwasher uses internal flow-through heating elements to clean 12 to 14 complete place settings using only 3.2 gallons (12 liters) of water and approximately 1.15 kWh of total electricity. In contrast, washing that same volume of dishes by hand under a running hot water tap (48°C / 120°F) for 15 to 20 minutes consumes 15 to 24 gallons of hot water. Generating that much hot water in a domestic water heater requires between 2.8 and 4.2 kWh of energy. Handwashing under running water wastes 3.1x more energy and over 5x more water than an ENERGY STAR dishwasher."
  },
  {
    question: "Why is the microwave the most energy-efficient way to reheat food?",
    answer: "Microwaves utilize dielectric heating at a frequency of 2.45 GHz, directly rotating polar water and lipid molecules inside the food itself. There is zero thermal mass to preheat, no metal cooking cavity to warm up, and negligible ambient heat loss. Reheating a 400g plate of leftovers in a 1,000W microwave takes 2.5 minutes and draws just 0.06 kWh, whereas reheating the same plate in an oven requires 12 minutes of preheating plus 13 minutes of baking, consuming 1.15 kWh — a nineteen-fold (19x) increase in energy consumption."
  },
  {
    question: "Are gas stoves really a major source of indoor air pollution and childhood asthma?",
    answer: "Yes. Natural gas is primarily methane, and when combusted on an open burner, it generates nitrogen dioxide (NO2), carbon monoxide (CO), ultrafine particulate matter (PM2.5), and carcinogenic benzene. Independent studies published in the International Journal of Environmental Research and Public Health and by the Rocky Mountain Institute (RMI) found that 12.7% of current childhood asthma cases in the United States are attributable to gas stove use. Within 15 minutes of cooking on gas without high-flow outdoor ventilation, indoor NO2 concentrations frequently exceed World Health Organization (WHO) acute safety thresholds."
  },
  {
    question: "How does pressure cooking in an Instant Pot save electricity?",
    answer: "Electric pressure cookers operate as hermetically sealed thermodynamic vessels. By trapping steam, internal chamber pressure rises to 15 PSI (103 kPa), elevating the boiling point of water from 100°C to 121°C (250°F). This accelerated thermal penetration cuts long braising and stewing cooking times by 65% to 70%. Furthermore, because the vessel is fully sealed and insulated, zero latent heat of vaporization escapes as steam, using only 0.28 kWh to cook a pot of stew that would require 0.88 kWh on a stovetop."
  }
];

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools/' },
  { label: 'Kitchen Energy & Carbon Calculator' }
];

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Smart Kitchen Energy & Appliance Carbon Footprint Calculator",
  "url": "https://isitkitchensafe.com/tools/kitchen-energy-carbon-calculator/",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "description": pageDescription,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};
---

<Layout title={pageTitle} description={pageDescription} faqs={faqs} availableLocales={['en', 'es', 'pt', 'zh-cn', 'ja']}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1200px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-600 text-white mb-3">
        Thermodynamic Heat Transfer &bull; Grid Emissions &bull; DOE 10 CFR 430
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        Smart Kitchen Energy &amp; Appliance Carbon Footprint Calculator
      </h1>
      <p class="text-body text-[15px] md:text-body-md leading-relaxed">
        Discover exact kilowatt-hour (kWh) power draws, cooking cycle times, and carbon footprints across induction, air fryer, microwave, and standard gas or electric appliances. Calculate your annual electricity savings and climate impact.
      </p>
    </header>

    <!-- Main Interactive Calculator Component -->
    <div class="mb-14">
      <KitchenEnergyCarbonCalculator lang="en" />
    </div>

    <!-- Science Deep-Dive: Thermodynamic Principles of Cooking Energy -->
    <section class="mb-14 border-t border-hairline pt-12 space-y-8">
      <div class="max-w-3xl">
        <span class="text-xs font-bold uppercase tracking-wider text-muted block mb-1">
          Heat Transfer Physics &bull; Thermal Mass &bull; Cavity Volume Dynamics
        </span>
        <h2 class="text-title-lg md:text-display-sm font-medium text-ink tracking-tight mb-3">
          The Physics of Kitchen Energy: Why 60% of Heat is Wasted
        </h2>
        <p class="text-body text-[15px] leading-relaxed">
          The difference between an energy-efficient meal and an energy-wasting meal comes down to three fundamental thermodynamic laws governing culinary heat transfer:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl bg-surface-soft border border-hairline space-y-3">
          <div class="w-9 h-9 rounded-xl bg-emerald-600 text-white font-bold flex items-center justify-center text-sm">
            01
          </div>
          <h3 class="font-semibold text-ink text-base">Cavity Volume &amp; Preheating Mass</h3>
          <p class="text-xs text-body leading-relaxed">
            Heating a 140-liter oven requires warming 45 kg of structural steel, porcelain enamel, and air volume before any heat reaches your food. A 5-liter air fryer has 96% less air volume and miniature thermal mass, cutting preheat time from 15 minutes to 120 seconds.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-surface-soft border border-hairline space-y-3">
          <div class="w-9 h-9 rounded-xl bg-blue-600 text-white font-bold flex items-center justify-center text-sm">
            02
          </div>
          <h3 class="font-semibold text-ink text-base">Electromagnetic Flux vs. Convective Plumes</h3>
          <p class="text-xs text-body leading-relaxed">
            Gas burners transfer heat via buoyant hot gas plumes that rapidly curl outward around the pan perimeter, transferring only 38% of energy into the cookware. Induction uses magnetic fields to induce electrical resistance heating inside the iron base itself, capturing 88% of electrical input.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-surface-soft border border-hairline space-y-3">
          <div class="w-9 h-9 rounded-xl bg-indigo-600 text-white font-bold flex items-center justify-center text-sm">
            03
          </div>
          <h3 class="font-semibold text-ink text-base">Dielectric Polar Rotation</h3>
          <p class="text-xs text-body leading-relaxed">
            Conventional ovens transfer heat slowly from food exterior to interior via thermal conduction (k &approx; 0.5 W/m&middot;K). Microwaves bypass conduction entirely by penetrating 2–3 cm deep and rotating polar water molecules 2.45 billion times per second, heating food instantaneously.
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="border-t border-hairline pt-12">
      <h2 class="text-title-lg md:text-display-sm font-medium text-ink tracking-tight mb-8">
        Frequently Asked Questions
      </h2>
      <div class="space-y-6 max-w-3xl">
        {faqs.map(faq => (
          <div class="border-b border-hairline pb-6">
            <h3 class="text-base font-semibold text-ink mb-2">
              {faq.question}
            </h3>
            <p class="text-body text-sm leading-relaxed">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>
