---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PowerOutageFoodSafetyChecker from '../../components/PowerOutageFoodSafetyChecker.astro';
import rawData from '../../data/power-outage-food-safety-data.json';

const pageTitle = "Fridge & Freezer Power Outage Food Safety Checker (USDA & CDC) | IsItKitchenSafe";
const pageDescription = "Check which refrigerator and freezer foods to keep, cook, refreeze, or discard after a power outage. Instant USDA FSIS & CDC 4-hour fridge, 24h/48h freezer, and 40°F thermometer triage across 22 food categories.";

const faqs = rawData.faqs.en;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools/' },
  { label: 'Power Outage Food Safety Checker' }
];

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Fridge & Freezer Power Outage Food Safety Checker",
  "url": "https://isitkitchensafe.com/tools/power-outage-food-safety-checker/",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript.",
  "description": pageDescription,
  "inLanguage": "en",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  faqs={faqs}
  excludeFaqSchema={true}
  availableLocales={['en', 'es', 'pt', 'zh-cn', 'ja']}
  lang="en"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1 print:hidden">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1140px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-signature-coral text-white mb-3">
        USDA FSIS &amp; CDC Emergency Food Triage
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        Fridge &amp; Freezer Power Outage Food Safety Checker
      </h1>
      <p class="text-body text-[15px] md:text-[16px] leading-relaxed">
        Instantly determine which foods to <strong>keep, cook immediately, refreeze (ice crystals check), or discard</strong> after a blackout. Modeled on official USDA FSIS &amp; CDC guidelines: <strong>4 hours</strong> closed fridge, <strong>24h / 48h</strong> closed freezer, and the <strong>40°F (4°C)</strong> Danger Zone rule across 22 everyday food categories.
      </p>
    </header>

    <!-- Main Interactive Checker, Related Links & 5 Visible FAQs -->
    <PowerOutageFoodSafetyChecker lang="en" />
  </div>
</Layout>
