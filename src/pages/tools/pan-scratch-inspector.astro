---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PanScratchInspector from '../../components/PanScratchInspector.astro';

const pageTitle = "AI Pan Scratch & Damage Inspector | Free Teflon Safety Checker | IsItKitchenSafe";
const pageDescription = "Upload a photo of your scratched non-stick skillet or frying pan to instantly detect coating wear, calculate microplastic shedding risk, and get an authoritative safety verdict.";

const faqs = [
  {
    question: "How does the Pan Scratch Inspector assess cookware damage?",
    answer: "The inspector analyzes optical surface contrast, edge delamination, and specular metallic reflectance to distinguish between harmless superficial hairline scuffs (Grade 1) and severe structural gouges that expose the raw aluminum core (Grade 3) or blister into food (Grade 4)."
  },
  {
    question: "Is it safe to eat food cooked in a scratched non-stick pan?",
    answer: "If the scratches are superficial hairline marks without exposed metal (Grade 1), the pan is safe at low-to-medium heat. However, if scratches reveal silver aluminum or the coating is actively flaking, a single cooking cycle can shed thousands of fluoropolymer microplastics into your food, and the pan must be retired."
  },
  {
    question: "How many microplastics are shed from a single scratch in Teflon?",
    answer: "According to a peer-reviewed 2022 study by researchers at Newcastle University and Flinders University using Raman spectroscopy, a single surface crack or scratch in a non-stick coating can release between 9,100 microplastic particles and 2.3 million nanoplastics into food."
  },
  {
    question: "Can I buff out scratches or spray a new non-stick coating at home?",
    answer: "No. Commercial fluoropolymer non-stick coatings require high-temperature industrial curing (>800°F/425°C) and hazardous chemical primers. DIY spray repair kits sold online are not FDA-approved for food contact and create dangerous toxic degradation compounds."
  }
];

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools/' },
  { label: 'Pan Scratch Inspector' }
];

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "AI Pan Scratch & Damage Inspector",
  "url": "https://isitkitchensafe.com/tools/pan-scratch-inspector/",
  "applicationCategory": "HealthApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5 Canvas.",
  "description": pageDescription,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};
---

<Layout title={pageTitle} description={pageDescription} faqs={faqs} availableLocales={['en', 'es', 'pt', 'zh-cn', 'ja']}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1020px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-2xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-signature-coral text-white mb-3">
        Interactive Safety Diagnostics
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        AI Pan Scratch &amp; Damage Inspector
      </h1>
      <p class="text-body text-[15px] md:text-body-md leading-relaxed">
        Don't guess whether your non-stick skillet is poisoning your dinner with microplastics. Upload or photograph your pan below for an instant, peer-reviewed damage classification.
      </p>
    </header>

    <!-- Main Tool Container -->
    <div class="mb-14">
      <PanScratchInspector lang="en" />
    </div>

    <!-- Scientific Context & 4-Stage Matrix -->
    <section class="mb-14 space-y-6">
      <h2 class="text-title-lg font-medium text-ink tracking-tight">
        The Scientific Standard: How Cookware Triage Works
      </h2>
      <p class="text-body text-[15px] leading-relaxed">
        Our diagnostic algorithm matches your cookware's surface against peer-reviewed material science benchmarks, specifically the landmark 2022 Australian study by Newcastle and Flinders University published in <em>Science of the Total Environment</em>. 
      </p>

      <div class="border border-hairline rounded-lg overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="bg-surface-strong border-b border-hairline text-ink font-semibold">
              <tr>
                <th class="p-4">Damage Grade</th>
                <th class="p-4">Physical Condition</th>
                <th class="p-4">Status</th>
                <th class="p-4">Microplastics Released</th>
                <th class="p-4">Required Action</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-hairline">
              <tr class="bg-white">
                <td class="p-4 font-semibold text-ink">Grade 1: Hairline Swirls</td>
                <td class="p-4 text-body text-[13px]">Superficial marks visible at an angle. Coating remains dark and continuous.</td>
                <td class="p-4"><span class="inline-block px-2.5 py-0.5 rounded text-xs font-bold bg-green-100 text-green-800">SAFE</span></td>
                <td class="p-4 text-body text-[13px]">&lt; 100 particles/cycle</td>
                <td class="p-4 text-body text-[13px]">Safe to continue using. Strictly use silicone or wooden utensils.</td>
              </tr>
              <tr class="bg-surface-soft">
                <td class="p-4 font-semibold text-ink">Grade 2: Visible Scratches</td>
                <td class="p-4 text-body text-[13px]">Clear scratch marks across the cooking basin. Base aluminum not yet exposed.</td>
                <td class="p-4"><span class="inline-block px-2.5 py-0.5 rounded text-xs font-bold bg-amber-100 text-amber-800">USE CAUTION</span></td>
                <td class="p-4 text-body text-[13px]">~9,100 particles/scratch</td>
                <td class="p-4 text-body text-[13px]">Cook at low heat only (&lt;350°F). Avoid acidic ingredients. Replace within 6 months.</td>
              </tr>
              <tr class="bg-white">
                <td class="p-4 font-semibold text-ink">Grade 3: Deep Gouge / Core Exposed</td>
                <td class="p-4 text-body text-[13px]">Scratch penetrates completely through PTFE layer, exposing shiny silver aluminum metal.</td>
                <td class="p-4"><span class="inline-block px-2.5 py-0.5 rounded text-xs font-bold bg-red-100 text-red-800">UNSAFE</span></td>
                <td class="p-4 text-body text-[13px]">Up to 2.3M nanoplastics</td>
                <td class="p-4 text-body text-[13px]">Retire from cooking immediately. Active chemical shedding and aluminum leaching.</td>
              </tr>
              <tr class="bg-surface-soft">
                <td class="p-4 font-semibold text-ink">Grade 4: Flaking &amp; Blistering</td>
                <td class="p-4 text-body text-[13px]">Coating is bubbling, peeling away in sheets, or leaving black flecks in scrambled eggs.</td>
                <td class="p-4"><span class="inline-block px-2.5 py-0.5 rounded text-xs font-bold bg-red-100 text-red-800">HAZARDOUS</span></td>
                <td class="p-4 text-body text-[13px]">Massive Macro-Flakes</td>
                <td class="p-4 text-body text-[13px]">Discard immediately. High risk of direct fluoropolymer ingestion.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Cross Link Pillar Banner -->
    <div class="mb-14 bg-surface-soft border border-hairline rounded-xl p-6 md:p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <div class="max-w-xl">
        <span class="text-xs font-bold uppercase tracking-wider text-signature-coral block mb-1">In-Depth Editorial Investigation</span>
        <h3 class="text-title-md font-semibold text-ink mb-2">Read the Complete Non-Stick Cookware Safety Report</h3>
        <p class="text-[13px] text-body leading-relaxed">
          Learn about PTFE thermal decomposition, polymer fume fever, bird toxicity, and FDA 21 CFR 175.300 standards in our full comprehensive guide.
        </p>
      </div>
      <a 
        href="/material/scratched-nonstick-cookware/"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-xs font-semibold uppercase tracking-wider bg-primary hover:bg-primary-active text-on-primary transition-all whitespace-nowrap cursor-pointer shadow-xs"
      >
        Read Full Investigation &rarr;
      </a>
    </div>

    <!-- FAQ Section -->
    <section class="mb-14">
      <h2 class="text-title-lg font-medium text-ink tracking-tight mb-6">
        Frequently Asked Questions
      </h2>
      <div class="space-y-4">
        {faqs.map(faq => (
          <div class="p-5 bg-surface-soft border border-hairline rounded-lg">
            <h3 class="text-title-sm font-semibold text-ink mb-2">
              {faq.question}
            </h3>
            <p class="text-[14px] text-body leading-relaxed">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>
