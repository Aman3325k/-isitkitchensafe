---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import DishwasherMelamineLeachingSimulator from '../../components/DishwasherMelamineLeachingSimulator.astro';
import rawData from '../../data/dishwasher-melamine-leaching-data.json';

const pageTitle = "Dishwasher Melamine Formaldehyde & Cyanuric Acid Leaching Simulator | IsItKitchenSafe";
const pageDescription = "Calculate formaldehyde (HCHO) and melamine monomer migration from dishwasher heat cycles (>70°C / 158°F), caustic alkaline detergents, and microwave damage. EU Regulation 10/2011 & German BfR standards.";

const faqs = rawData.faqs.en;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools/' },
  { label: 'Dishwasher Melamine Leaching Simulator' }
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://isitkitchensafe.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Tools",
      "item": "https://isitkitchensafe.com/tools/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Dishwasher Melamine Leaching Simulator",
      "item": "https://isitkitchensafe.com/tools/dishwasher-melamine-leaching-simulator/"
    }
  ]
};

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Dishwasher Melamine Formaldehyde & Cyanuric Acid Leaching Simulator",
  "url": "https://isitkitchensafe.com/tools/dishwasher-melamine-leaching-simulator/",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "description": pageDescription,
  "inLanguage": "en",
  "isAccessibleForFree": true,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com",
    "logo": {
      "@type": "ImageObject",
      "url": "https://isitkitchensafe.com/favicon.svg"
    }
  },
  "author": {
    "@type": "Person",
    "name": "Marcus Vance",
    "jobTitle": "Lead Hardware & Materials Analyst",
    "url": "https://isitkitchensafe.com/about/#editorial-board",
    "sameAs": "https://isitkitchensafe.com/about/",
    "affiliation": {
      "@type": "Organization",
      "name": "IsItKitchenSafe",
      "url": "https://isitkitchensafe.com"
    }
  },
  "reviewedBy": {
    "@type": "Person",
    "name": "Dr. Elena Rostova",
    "jobTitle": "Food Toxicology & Storage Contributor",
    "honorificPrefix": "Dr.",
    "url": "https://isitkitchensafe.com/about/#editorial-board",
    "sameAs": "https://isitkitchensafe.com/about/",
    "affiliation": {
      "@type": "Organization",
      "name": "IsItKitchenSafe",
      "url": "https://isitkitchensafe.com"
    }
  },
  "citation": [
    {
      "@type": "ScholarlyArticle",
      "name": "Release of melamine and formaldehyde from tableware made of melamine resin (BfR Opinion No. 046/2019)",
      "headline": "Release of melamine and formaldehyde from tableware made of melamine resin",
      "author": {
        "@type": "Organization",
        "name": "German Federal Institute for Risk Assessment (BfR)"
      },
      "url": "https://www.bfr.bund.de/cm/349/release-of-melamine-and-formaldehyde-from-tableware-made-of-melamine-resin.pdf",
      "datePublished": "2019-11-25"
    },
    {
      "@type": "Legislation",
      "name": "Commission Regulation (EU) No 10/2011 on plastic materials and articles intended to come into contact with food",
      "legislationIdentifier": "Regulation (EU) No 10/2011",
      "legislationPassedBy": {
        "@type": "Organization",
        "name": "European Commission"
      },
      "url": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX%3A32011R0010"
    },
    {
      "@type": "ScholarlyArticle",
      "name": "FDA Food Contact Notification: Melamine-Formaldehyde Resin in Tableware",
      "headline": "Melamine Tableware Safety Guidance",
      "author": {
        "@type": "Organization",
        "name": "US Food and Drug Administration (FDA)"
      },
      "url": "https://www.fda.gov/food/packaging-food-contact-substances-fcs/melamine-tableware"
    }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  faqs={faqs}
  excludeFaqSchema={true}
  excludeBreadcrumbSchema={true}
  availableLocales={['en', 'es', 'pt', 'zh-cn', 'ja']}
  lang="en"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1 print:hidden">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6">
      <Breadcrumbs items={breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1140px] mx-auto px-4 sm:px-6 py-8 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-signature-coral text-white mb-3">
        German BfR Opinion No. 046/2019 · EU Regulation No 10/2011 · FDA Food Contact Notice
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        Dishwasher Melamine Formaldehyde &amp; Cyanuric Acid Leaching Simulator
      </h1>
      <p class="text-body text-[15px] md:text-[16px] leading-relaxed">
        Stop guessing about plastic dinnerware safety: calculate <strong>formaldehyde (HCHO)</strong> and <strong>melamine monomer migration (mg/kg)</strong> triggered by dishwasher sanitize cycles (&gt;70°C / 158°F), caustic alkaline detergents (pH &gt; 10.5), cutlery micro-scratches, and microwave dielectric superheating.
      </p>

      <!-- E-E-A-T Author, Scientific Review & Regulatory Citations Byline -->
      <div class="mt-5 flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-xs text-muted border-t border-hairline/60 pt-4 max-w-2xl mx-auto">
        <span class="inline-flex items-center gap-1.5">
          <span class="font-semibold text-ink">Author:</span> Marcus Vance (Materials Analyst)
        </span>
        <span class="text-hairline" aria-hidden="true">&bull;</span>
        <span class="inline-flex items-center gap-1.5">
          <span class="font-semibold text-ink">Scientific Review:</span> Dr. Elena Rostova, Ph.D.
        </span>
        <span class="text-hairline" aria-hidden="true">&bull;</span>
        <a href="/methodology/" class="text-link underline hover:text-link-active transition-colors">
          Methodology &amp; Standards
        </a>
      </div>
    </header>

    <!-- Main Interactive Simulator Component -->
    <DishwasherMelamineLeachingSimulator lang="en" />
  </div>
</Layout>
