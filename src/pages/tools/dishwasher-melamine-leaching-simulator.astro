---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import DishwasherMelamineLeachingSimulator from '../../components/DishwasherMelamineLeachingSimulator.astro';
import rawData from '../../data/dishwasher-melamine-leaching-data.json';

const pageTitle = "Dishwasher Melamine Formaldehyde & Cyanuric Acid Leaching Simulator | IsItKitchenSafe";
const pageDescription = "Calculate formaldehyde (HCHO) and melamine monomer migration from dishwasher heat cycles (>70°C / 158°F), caustic alkaline detergents, and microwave damage. EU Regulation 10/2011 & German BfR standards.";

const faqs = rawData.faqs.en;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools/' },
  { label: 'Dishwasher Melamine Leaching Simulator' }
];

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Dishwasher Melamine Formaldehyde & Cyanuric Acid Leaching Simulator",
  "url": "https://isitkitchensafe.com/tools/dishwasher-melamine-leaching-simulator/",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript.",
  "description": pageDescription,
  "inLanguage": "en",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  faqs={faqs}
  excludeFaqSchema={true}
  availableLocales={['en', 'es', 'pt', 'zh-cn', 'ja']}
  lang="en"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1 print:hidden">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1140px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-signature-coral text-white mb-3">
        German BfR Opinion No. 046/2019 · EU Regulation No 10/2011 · FDA Food Contact Notice
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        Dishwasher Melamine Formaldehyde &amp; Cyanuric Acid Leaching Simulator
      </h1>
      <p class="text-body text-[15px] md:text-[16px] leading-relaxed">
        Stop guessing about plastic dinnerware safety: calculate <strong>formaldehyde (HCHO)</strong> and <strong>melamine monomer migration (mg/kg)</strong> triggered by dishwasher sanitize cycles (&gt;70°C / 158°F), caustic alkaline detergents (pH &gt; 10.5), cutlery micro-scratches, and microwave dielectric superheating.
      </p>
    </header>

    <!-- Main Interactive Simulator Component -->
    <DishwasherMelamineLeachingSimulator lang="en" />
  </div>
</Layout>