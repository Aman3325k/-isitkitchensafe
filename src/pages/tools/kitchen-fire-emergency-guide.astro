---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import KitchenFireEmergencyGuide from '../../components/KitchenFireEmergencyGuide.astro';
import rawData from '../../data/kitchen-fire-emergency-guide-data.json';

const pageTitle = "Kitchen Grease Fire, Electrical & Burn Emergency First-Response Guide | IsItKitchenSafe";
const pageDescription = "Instant NFPA, USFA/FEMA & American Red Cross kitchen emergency guide: interactive DO vs. NEVER DO first-response triage for grease pan fires, oven/microwave fires, electrical fires, gas leaks & cooking oil burns — plus a 6-tool fire extinguisher matcher and printable fridge safety poster.";

const faqs = rawData.faqs.en;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools/' },
  { label: 'Kitchen Fire & Burn Emergency Guide' }
];

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Kitchen Grease Fire, Electrical & Burn Emergency First-Response Guide",
  "url": "https://isitkitchensafe.com/tools/kitchen-fire-emergency-guide/",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript.",
  "description": pageDescription,
  "inLanguage": "en",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  faqs={faqs}
  excludeFaqSchema={true}
  availableLocales={['en', 'es', 'pt', 'zh-cn', 'ja']}
  lang="en"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1 print:hidden">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1140px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-signature-coral text-white mb-3">
        NFPA &amp; USFA Fire Protocols · Red Cross Burn First Aid · 6-Tool Extinguisher Matcher
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        Kitchen Grease Fire, Electrical &amp; Burn Emergency Guide
      </h1>
      <p class="text-body text-[15px] md:text-[16px] leading-relaxed">
        Know the exact <strong>DO vs. NEVER DO</strong> response before a kitchen emergency strikes — covering <strong>stovetop grease pan fires</strong>, <strong>oven &amp; microwave fires</strong>, <strong>electrical appliances</strong>, <strong>gas leaks</strong>, <strong>hot oil burn first aid</strong>, and which <strong>fire extinguisher (ABC, Class K, B/C, Fire Blanket)</strong> is safe or deadly.
      </p>
    </header>

    <!-- Main Interactive Emergency Guide Component -->
    <KitchenFireEmergencyGuide lang="en" />
  </div>
</Layout>
