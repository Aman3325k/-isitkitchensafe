---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ChildSafetyToxicIngestionEvaluator from '../../components/ChildSafetyToxicIngestionEvaluator.astro';

const pageTitle = "Childhood Kitchen Safety & Accidental Toxic Ingestion Risk Evaluator | IsItKitchenSafe";
const pageDescription = "Evidence-based pediatric emergency triage for accidental kitchen ingestions: dishwasher pods, button lithium batteries, rare-earth magnets, and caustic cleaners. Includes first-aid instructions, the Honey Protocol, Poison Control direct links, and a CPSC childproofing audit.";

const faqs = [
  {
    question: "What is the Honey Protocol for accidental button lithium battery ingestion?",
    answer: "The Honey Protocol is an evidence-based pre-hospital mitigation directive endorsed by the National Capital Poison Center and the American Academy of Pediatrics. If a child over 12 months old swallows a button/coin lithium battery and can swallow, parents should immediately administer 2 teaspoons (10 mL) of commercial honey every 10 minutes (up to 6 doses) while en route to a Pediatric Emergency Department. Honey acts as a viscous physical barrier that coats the battery and significantly buffers localized alkaline hydroxide ion generation, reducing liquefactive necrosis of esophageal tissue. Crucial warning: Never delay emergency transport to get honey, and NEVER give honey to infants under 12 months due to the risk of infant botulism."
  },
  {
    question: "Why must you NEVER induce vomiting if a child bites or swallows a dishwasher detergent pod?",
    answer: "Inducing vomiting is strictly contraindicated in detergent pod exposures for two life-threatening reasons: First, single-dose pods contain ultra-concentrated alkaline surfactants (pH 10.5–11.5) that inflict chemical mucosal burns. Regurgitating them re-exposes the esophagus, pharynx, and mouth to concentrated chemicals. Second, and most dangerous, vomiting causes concentrated surfactants to froth aggressively into thick foam. Toddlers involuntarily gasp and inhale this caustic foam into their lungs, causing severe chemical aspiration pneumonitis, vocal cord laryngospasm, pulmonary edema, and acute respiratory failure."
  },
  {
    question: "Why are high-powered rare-earth neodymium magnets so dangerous if swallowed?",
    answer: "Neodymium-iron-boron (NdFeB) rare-earth magnets have extraordinary magnetic pull forces exceeding 1.2 Tesla. When two or more magnets (or one magnet and a ferromagnetic utensil or key) are ingested, they do not pass together; rather, they separate in different loops of the small or large intestine. Because of their immense attraction, they clamp tightly together across intervening bowel walls. This crushes the blood supply, causing pressure necrosis, full-thickness bowel perforation, internal fistulas, volvulus, peritonitis, and life-threatening sepsis. Children are often asymptomatic for the first few hours, making prompt serial bi-plane abdominal X-rays critical."
  },
  {
    question: "Why should you never neutralize caustic oven cleaners with vinegar or lemon juice?",
    answer: "Caustic oven cleaners and heavy-duty degreasers contain concentrated sodium hydroxide (NaOH) or potassium hydroxide (KOH), with pH levels of 13 to 14. An enduring and dangerous home remedy myth is to drink acidic vinegar or lemon juice to 'neutralize' the alkali. In reality, acid-base neutralization reactions are intensely exothermic—they release massive amounts of thermal energy (>60°C / 140°F). Drinking vinegar on top of an alkali burn creates an instantaneous secondary thermal boil inside the esophagus, worsening transmural liquefactive necrosis and drastically increasing the likelihood of fatal esophageal perforation."
  },
  {
    question: "Why does pure vanilla extract pose an acute alcohol poisoning and hypoglycemia risk for toddlers?",
    answer: "Under FDA standard of identity 21 CFR § 169.175, pure vanilla extract must contain a minimum of 35% alcohol by volume (70 proof)—the same alcohol concentration as rum, gin, or vodka. Young children and toddlers possess immature hepatic alcohol dehydrogenase enzymes and minute glycogen reserves. Ingesting as little as 1 to 2 ounces of vanilla extract can rapidly suppress pediatric hepatic gluconeogenesis, causing severe rebound hypoglycemia (blood sugar crashing below 40 mg/dL), hypothermia, metabolic acidosis, seizures, and respiratory arrest."
  },
  {
    question: "What childproofing cabinet locks are most effective against determined toddlers?",
    answer: "Magnetic hidden lock systems (which require a separate handheld magnetic key to open) and dual-action pinch latches tested to ASTM F977 / CPSC child-resistance standards are the gold standard. Standard plastic spring-push tabs frequently fail because toddlers quickly learn to pull the cabinet door open a crack and depress the plastic catch with their fingers, or pry it open with body weight. Highly hazardous substances (dishwasher pods, drain cleaners, lye oven sprays) should ideally be relocated entirely to upper wall cabinets at least 5 feet (1.5 meters) above floor level."
  }
];

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools/' },
  { label: 'Child Kitchen Safety & Ingestion Evaluator' }
];

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Childhood Kitchen Safety & Accidental Toxic Ingestion Risk Evaluator",
  "url": "https://isitkitchensafe.com/tools/child-safety-toxic-ingestion-evaluator/",
  "applicationCategory": "HealthApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "description": pageDescription,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};
---

<Layout title={pageTitle} description={pageDescription} faqs={faqs} availableLocales={['en', 'es', 'pt', 'zh-cn', 'ja']}>
  <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />

  <main class="container mx-auto px-4 py-8 max-w-5xl space-y-8">
    <Breadcrumbs items={breadcrumbs} />

    <ChildSafetyToxicIngestionEvaluator lang="en" />

    <!-- FAQ Accordion Section -->
    <section class="mt-16 bg-surface-soft border border-hairline rounded-3xl p-6 md:p-10 space-y-6">
      <div class="border-b border-hairline pb-4">
        <span class="text-xs font-bold uppercase tracking-wider text-rose-800 block mb-1">
          Pediatric Toxicology &amp; Emergency Clinical Q&amp;A
        </span>
        <h2 class="text-title-lg font-medium text-ink tracking-tight">
          Frequently Asked Questions on Child Kitchen Ingestions &amp; Triage
        </h2>
        <p class="text-xs text-muted">Evidence-based clinical guidelines grounded in America's Poison Centers (AAPCC), CPSC child safety standards, and the American Academy of Pediatrics.</p>
      </div>

      <div class="space-y-4">
        {faqs.map(faq => (
          <details class="group p-4 rounded-xl bg-canvas border border-hairline transition-colors open:bg-surface">
            <summary class="font-medium text-ink cursor-pointer list-none flex items-center justify-between text-sm md:text-base">
              <span>{faq.question}</span>
              <span class="text-muted transition-transform group-open:rotate-180 ml-2">&darr;</span>
            </summary>
            <p class="text-xs md:text-sm text-body mt-3 pt-3 border-t border-hairline/60 leading-relaxed">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </main>
</Layout>
