---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import InstantPotPressureReleaseChecker from '../../components/InstantPotPressureReleaseChecker.astro';
import rawData from '../../data/instant-pot-pressure-release-data.json';

const pageTitle = "Instant Pot & Pressure Cooker Fill-Line, Natural vs. Quick Release & Foaming Safety Checker | IsItKitchenSafe";
const pageDescription = "Interactive Instant Pot & stovetop pressure cooker safety checker grounded in UL 1026 & USDA standards: check 1/2 MAX vs. 2/3 MAX fill lines, Natural vs. Quick Release timing, foaming valve-clog risk, minimum liquid by pot size (3-qt, 6-qt, 8-qt, stovetop), and BURN notice prevention across 22 foods.";

const faqs = rawData.faqs.en;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools/' },
  { label: 'Instant Pot & Pressure Release Checker' }
];

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Instant Pot & Pressure Cooker Fill-Line, Natural vs. Quick Release & Foaming Safety Checker",
  "url": "https://isitkitchensafe.com/tools/instant-pot-pressure-release-checker/",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript.",
  "description": pageDescription,
  "inLanguage": "en",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  faqs={faqs}
  excludeFaqSchema={true}
  availableLocales={['en', 'es', 'pt', 'zh-cn', 'ja']}
  lang="en"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1 print:hidden">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1140px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-signature-coral text-white mb-3">
        UL 1026 Pressure Manuals · USDA Poultry Safety · 22 Foods &amp; 4 Pot Sizes
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        Instant Pot &amp; Pressure Cooker Fill-Line &amp; Release Checker
      </h1>
      <p class="text-body text-[15px] md:text-[16px] leading-relaxed">
        Prevent steam scalds, clogged valves, rubbery meat, and <strong>"BURN"</strong> errors — look up the exact <strong>1/2 MAX vs. 2/3 MAX</strong> fill limit, <strong>Natural Release (NPR) vs. Quick Release (QR)</strong> protocol, and <strong>minimum thin liquid</strong> for 3-qt, 6-qt, 8-qt, and stovetop pressure cookers.
      </p>
    </header>

    <!-- Main Interactive Checker Component -->
    <InstantPotPressureReleaseChecker lang="en" />
  </div>
</Layout>
