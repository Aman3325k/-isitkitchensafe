---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SlowCookerFoodSafetyChecker from '../../components/SlowCookerFoodSafetyChecker.astro';
import rawData from '../../data/slow-cooker-food-safety-data.json';

const pageTitle = "Slow Cooker & Crock-Pot Food Safety Checker (USDA Rules, Kidney Bean Toxin & Frozen Meat Ban) | IsItKitchenSafe";
const pageDescription = "Interactive slow cooker & Crock-Pot food safety checker grounded in USDA FSIS & FDA standards: check cooking times, safe fill levels (1/2 to 2/3), the strict frozen meat ban, red kidney bean PHA toxin alert, Low vs. High vs. Warm settings, and ceramic thermal shock prevention across 22 foods.";

const faqs = rawData.faqs.en;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools/' },
  { label: 'Slow Cooker & Crock-Pot Safety Checker' }
];

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Slow Cooker & Crock-Pot Food Safety Checker",
  "url": "https://isitkitchensafe.com/tools/slow-cooker-food-safety-checker/",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript.",
  "description": pageDescription,
  "inLanguage": "en",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  faqs={faqs}
  excludeFaqSchema={true}
  availableLocales={['en', 'es', 'pt', 'zh-cn', 'ja']}
  lang="en"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1 print:hidden">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1140px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-700 text-white mb-3">
        USDA FSIS Slow Cooker Guidelines · FDA Bad Bug Book · 22 Foods &amp; 3 Cooker Sizes
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        Slow Cooker &amp; Crock-Pot Food Safety Checker
      </h1>
      <p class="text-body text-[15px] md:text-[16px] leading-relaxed">
        Prevent bacterial danger zone incubation, kidney bean lectin toxicity, and cracked ceramic crocks — check exact <strong>LOW vs. HIGH cooking times</strong>, <strong>1/2 to 2/3 safe fill limits</strong>, the <strong>strict USDA frozen meat ban</strong>, and minimum thin liquid across 22 everyday slow cooker meals.
      </p>
    </header>

    <!-- Main Interactive Checker Component -->
    <SlowCookerFoodSafetyChecker lang="en" />
  </div>
</Layout>
