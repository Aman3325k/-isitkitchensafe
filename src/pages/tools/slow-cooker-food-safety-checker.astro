---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SlowCookerFoodSafetyChecker from '../../components/SlowCookerFoodSafetyChecker.astro';
import rawData from '../../data/slow-cooker-food-safety-data.json';

const pageTitle = "Slow Cooker & Crock-Pot Food Safety Checker: Frozen Meat, Kidney Beans & Power Outage Guide | IsItKitchenSafe";
const pageDescription = "Interactive USDA FSIS & FDA slow cooker food safety checker: test fill level (1/2 to 2/3), HIGH/LOW/Keep-Warm, and power outage discard rules live, plus look up 16 everyday foods, red kidney bean lectin safety, leftovers, plastic liners, and ceramic stoneware thermal-shock rules.";

const faqs = rawData.faqs.en;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools/' },
  { label: 'Slow Cooker & Crock-Pot Food Safety Checker' }
];

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Slow Cooker & Crock-Pot Food Safety Checker",
  "url": "https://isitkitchensafe.com/tools/slow-cooker-food-safety-checker/",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript.",
  "description": pageDescription,
  "inLanguage": "en",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  faqs={faqs}
  excludeFaqSchema={true}
  availableLocales={['en', 'es', 'pt', 'zh-cn', 'ja']}
  lang="en"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1 print:hidden">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1140px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-signature-coral text-white mb-3">
        USDA FSIS Slow Cooker Rules · FDA Kidney Bean Alert · 16 Items &amp; Live Simulator
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        Slow Cooker &amp; Crock-Pot Food Safety Checker
      </h1>
      <p class="text-body text-[15px] md:text-[16px] leading-relaxed">
        Avoid Danger Zone food poisoning, <strong>5× toxic raw red kidney beans</strong>, power-outage guesswork, and shattered ceramic crocks — test your <strong>fill level, heat setting &amp; outage scenario</strong> live and inspect <strong>16 everyday slow cooker rules</strong> grounded in USDA FSIS &amp; FDA guidance.
      </p>
    </header>

    <!-- Main Interactive Checker Component -->
    <SlowCookerFoodSafetyChecker lang="en" />
  </div>
</Layout>
