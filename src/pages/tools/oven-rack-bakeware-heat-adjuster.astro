---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import OvenRackBakewareHeatAdjuster from '../../components/OvenRackBakewareHeatAdjuster.astro';
import rawData from '../../data/oven-rack-bakeware-heat-data.json';

const pageTitle = "Oven Rack Position, Convection & Bakeware Material Heat Adjuster | IsItKitchenSafe";
const pageDescription = "Calculate exact oven temperature and time adjustments for glass Pyrex, dark nonstick, ceramic stoneware, silicone, cast iron, and bright aluminum pans — plus interactive 5-rack oven placement, smart convection fan conversion, and broiler thermal-shock safety alerts.";

const faqs = rawData.faqs.en;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools/' },
  { label: 'Oven Rack & Bakeware Heat Adjuster' }
];

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Oven Rack Position, Convection & Bakeware Material Heat Adjuster",
  "url": "https://isitkitchensafe.com/tools/oven-rack-bakeware-heat-adjuster/",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript.",
  "description": pageDescription,
  "inLanguage": "en",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  faqs={faqs}
  excludeFaqSchema={true}
  availableLocales={['en', 'es', 'pt', 'zh-cn', 'ja']}
  lang="en"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1 print:hidden">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1140px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-signature-coral text-white mb-3">
        5-Rack Oven Schematic · 6 Bakeware Materials · Convection &amp; Broiler Safety
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        Oven Rack Position, Convection &amp; Bakeware Heat Adjuster
      </h1>
      <p class="text-body text-[15px] md:text-[16px] leading-relaxed">
        Instantly calculate the exact <strong>-25°F glass &amp; dark nonstick pan adjustment</strong>, smart <strong>Convection Fan temperature cap</strong>, ideal <strong>oven rack slot</strong> for 10 popular dishes, and live <strong>Pyrex thermal-shock &amp; broiler shatter alerts</strong> before you preheat.
      </p>
    </header>

    <!-- Main Interactive Adjuster Component -->
    <OvenRackBakewareHeatAdjuster lang="en" />
  </div>
</Layout>
