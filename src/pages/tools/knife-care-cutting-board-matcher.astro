---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import KnifeCareCuttingBoardMatcher from '../../components/KnifeCareCuttingBoardMatcher.astro';
import rawData from '../../data/knife-care-cutting-board-data.json';

const pageTitle = "Kitchen Knife Care, Honing vs. Sharpening & Safe Cutting Board Matcher | IsItKitchenSafe";
const pageDescription = "Interactive Rockwell HRC knife care & USDA FSIS cutting board matcher: test 5 knife steel profiles (15° Japanese vs. 20° Western, serrated, ceramic) against 8 board materials (end-grain wood, Hinoki, Hasegawa rubber, HDPE plastic, bamboo, glass/titanium) for honing rods, whetstones, dishwasher safety & raw-meat sanitation.";

const faqs = rawData.faqs.en;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools/' },
  { label: 'Kitchen Knife Care & Cutting Board Matcher' }
];

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Kitchen Knife Care, Honing vs. Sharpening & Safe Cutting Board Matcher",
  "url": "https://isitkitchensafe.com/tools/knife-care-cutting-board-matcher/",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript.",
  "description": pageDescription,
  "inLanguage": "en",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  faqs={faqs}
  excludeFaqSchema={true}
  availableLocales={['en', 'es', 'pt', 'zh-cn', 'ja']}
  lang="en"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1 print:hidden">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1140px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-signature-coral text-white mb-3">
        Rockwell HRC Metallurgy · USDA FSIS Board Sanitation · 5 Knives × 8 Boards
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        Kitchen Knife Care, Honing vs. Sharpening &amp; Cutting Board Matcher
      </h1>
      <p class="text-body text-[15px] md:text-[16px] leading-relaxed">
        Stop dulling blades in the dishwasher or on glass, stone &amp; titanium boards — match your <strong>knife steel hardness (52–64 HRC &amp; ceramic)</strong> against <strong>8 cutting board materials</strong> for exact <strong>15° vs. 20° honing &amp; whetstone rules</strong>, microplastic limits, and USDA raw-meat sanitization.
      </p>
    </header>

    <!-- Main Interactive Matcher Component -->
    <KnifeCareCuttingBoardMatcher lang="en" />
  </div>
</Layout>
