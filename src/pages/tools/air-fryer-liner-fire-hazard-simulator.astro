---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AirFryerLinerFireHazardSimulator from '../../components/AirFryerLinerFireHazardSimulator.astro';
import rawData from '../../data/air-fryer-liner-fire-hazard-data.json';

const pageTitle = "Air Fryer Parchment vs. Silicone Liner Airflow & Fire Hazard Simulator | IsItKitchenSafe";
const pageDescription = "Simulate aerodynamic suction lift into glowing heating coils (400°C–600°C), convective airflow restriction, scorch limits, and PFAS-free parchment safety in air fryers. Verified via CPSC and FDA standards.";

const faqs = rawData.faqs.en;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools/' },
  { label: 'Air Fryer Liner Fire Hazard Simulator' }
];

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Air Fryer Parchment vs. Silicone Liner Airflow Obstruction & Fire Hazard Simulator",
  "url": "https://isitkitchensafe.com/tools/air-fryer-liner-fire-hazard-simulator/",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript.",
  "description": pageDescription,
  "inLanguage": "en",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  faqs={faqs}
  excludeFaqSchema={true}
  availableLocales={['en', 'es', 'pt', 'zh-cn', 'ja']}
  lang="en"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1 print:hidden">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1140px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-signature-coral text-white mb-3">
        CPSC Alert · Bernoulli Vortex Aerodynamics · FDA 21 CFR § 176.170 · BfR XV Platinum Silicone
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        Air Fryer Parchment vs. Silicone Liner Airflow &amp; Fire Hazard Simulator
      </h1>
      <p class="text-body text-[15px] md:text-[16px] leading-relaxed">
        Stop guessing if air fryer liners are safe: calculate <strong>aerodynamic suction lift into top heating coils</strong>, simulate <strong>convective bottom airflow loss and soggy bottom penalties</strong>, verify <strong>PFAS-free vegetable parchment certifications</strong>, and master the laboratory-backed 200g food ballast rule.
      </p>
    </header>

    <!-- Main Interactive Simulator Component -->
    <AirFryerLinerFireHazardSimulator lang="en" />
  </div>
</Layout>
