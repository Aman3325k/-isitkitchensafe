---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CommercialMembraneDistillationModeler from '../../components/CommercialMembraneDistillationModeler.astro';

const pageTitle = "Commercial Continuous Membrane Distillation (MD) Vapor Permeation & Thermal Polarization Modeler | IsItKitchenSafe";
const pageDescription = "Simulate commercial continuous membrane distillation (DCMD, VMD, AGMD) non-thermal concentration of liquid foods. Model trans-membrane water vapor flux, Cantor-Laplace capillary pore wetting breakthrough (LEPw), temperature and concentration boundary layer polarization (TPC/CPC), aroma volatile retention, and FDA 21 CFR § 177 / 3-A Sanitary 45-03 compliance.";

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools/' },
  { label: 'Commercial Continuous Membrane Distillation Modeler' }
];

const faqs = [
  {
    question: "What is Membrane Distillation (MD) and how does it concentrate thermosensitive juices and liquids without thermal degradation?",
    answer: "Membrane Distillation (MD) is a non-isothermal, thermally driven separation technology where a warm liquid food stream (typically 40°C to 65°C) flows over one side of a microporous hydrophobic membrane, and a colder stream or vacuum is maintained on the other side. Because the membrane material (such as ePTFE or PVDF) is strongly hydrophobic, liquid water cannot penetrate the micropores (0.1 to 0.45 µm). Instead, water evaporates exclusively at the liquid-vapor meniscus at the pore entrance, and pure water vapor diffuses across the dry pore volume under the vapor pressure difference (ΔP) described by the Antoine equation. Because boiling is completely avoided and operation temperatures remain far below conventional multi-effect vacuum evaporators (70°C to 100°C), delicate natural polyphenols, anthocyanins, vitamin C, and fresh top-note aroma esters (like ethyl butyrate in citrus juice) remain 92% to 98% intact."
  },
  {
    question: "How does the Cantor-Laplace equation govern pore wetting (LEPw) and catastrophic feed penetration?",
    answer: "Pore wetting is the primary catastrophic failure mode in membrane distillation, occurring when the trans-membrane hydraulic pressure (ΔP_hydraulic) exceeds the Liquid Entry Pressure of water (LEP_w). Governed by the Cantor-Laplace equation, LEP_w = (-2 · B · γ_L · cos θ) / r_max, where γ_L is liquid surface tension, θ is the water contact angle (> 110° to 145°), r_max is the maximum pore radius, and B is a pore geometry factor. If surface-active compounds—such as natural saponins, essential oils, or citrus terpenes—lower the liquid surface tension below ~40 mN/m, or if cross-flow pumping creates localized pressure surges exceeding the LEP threshold, liquid food breaks through the hydrophobic capillary barrier. Raw concentrate floods directly into the pure permeate stream, causing immediate loss of separation selectivity, product contamination, and regulatory failure."
  },
  {
    question: "What are the structural differences between Direct Contact (DCMD), Vacuum (VMD), and Air Gap (AGMD) systems?",
    answer: "In Direct Contact Membrane Distillation (DCMD), both the warm feed and chilled pure distillate streams directly touch opposite sides of the hydrophobic membrane; it offers high simplicity but experiences significant conductive sensible heat loss across the polymer. Vacuum Membrane Distillation (VMD) applies a moderate vacuum (5 to 20 kPa abs) to the permeate side, eliminating air resistance inside the pores and minimizing conductive heat loss, delivering 30% to 50% higher vapor flux for viscous juices, although external chilled traps are required to condense vapor. Air Gap Membrane Distillation (AGMD) introduces a narrow stationary air gap between the membrane and an internal chilled metal condensation foil; this design dramatically reduces conductive heat loss and recovers latent heat internally, making it ideal for energy-efficient multi-stage concentration cascades."
  },
  {
    question: "How do Temperature Polarization (TPC) and Concentration Polarization (CPC) attenuate vapor flux at high Brix?",
    answer: "During active vapor transfer, the latent heat of vaporization cools the feed liquid directly adjacent to the membrane surface, creating a temperature boundary layer where T_feed,membrane < T_feed,bulk. This is quantified by the Temperature Polarization Coefficient (TPC = (T_f,m - T_p,m)/(T_f,b - T_p,b)), which typically ranges from 0.45 to 0.85, diminishing the effective vapor pressure driving force. Concurrently, as water evaporates, dissolved sugars and pectin accumulate at the membrane wall (Concentration Polarization, CPC > 1.0). At concentrations approaching 60° to 70° Brix, dynamic viscosity spikes exponentially, depressing local water activity (a_w) and forming a gelatinous boundary layer that can foul pore entrances unless high cross-flow velocity (v_f > 0.6 m/s) and hydrodynamic Reynolds turbulence are maintained."
  },
  {
    question: "What regulatory standards govern hydrophobic food-contact membranes under FDA and 3-A Sanitary Standards?",
    answer: "Commercial membrane distillation modules processing edible foods or dairy liquids must comply with FDA 21 CFR § 177.1550 (Perfluorocarbon resins for food contact) and FDA 21 CFR § 177.2510 (PVDF polymer compliance), ensuring zero toxic fluoropolymer oligomer or leaching additive migration into acidic food matrices. Furthermore, under 3-A Sanitary Standard 45-03 (Cross-Flow Membrane Modules), all skid components, housings, end-caps, and potted elastomer seals must feature crevice-free hygienic geometries compatible with Clean-In-Place (CIP) regimes using enzymatic cleansers and mild caustic washes (pH 2 to 11) without degrading membrane hydrophobicity."
  }
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": "https://isitkitchensafe.com/tools/commercial-membrane-distillation-modeler/#webapp",
      "url": "https://isitkitchensafe.com/tools/commercial-membrane-distillation-modeler/",
      "name": "Commercial Continuous Membrane Distillation (MD) Vapor Permeation & Thermal Polarization Modeler",
      "applicationCategory": "EngineeringApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5 Canvas/CSS3.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": pageDescription
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://isitkitchensafe.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Tools",
          "item": "https://isitkitchensafe.com/tools/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Commercial Continuous Membrane Distillation Modeler",
          "item": "https://isitkitchensafe.com/tools/commercial-membrane-distillation-modeler/"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  structuredData={structuredData}
>
  <div class="max-w-6xl mx-auto px-4 py-8">
    <Breadcrumbs items={breadcrumbs} />
    <div class="mt-6">
      <CommercialMembraneDistillationModeler lang="en" />
    </div>

    <!-- Structured FAQ Accordion Section -->
    <div class="mt-12 bg-surface-soft border border-hairline rounded-2xl p-6 sm:p-8 shadow-xs">
      <h2 class="text-title font-semibold text-ink tracking-tight mb-6">
        Frequently Asked Questions: Membrane Distillation Physics, Pore Wetting &amp; Sanitary Design
      </h2>
      <div class="space-y-4">
        {faqs.map((faq, index) => (
          <details class="group border border-hairline rounded-xl p-4 bg-surface transition-colors open:bg-surface-soft">
            <summary class="font-medium text-ink cursor-pointer list-none flex justify-between items-center text-sm">
              <span>{index + 1}. {faq.question}</span>
              <span class="text-muted group-open:rotate-180 transition-transform ml-2">▼</span>
            </summary>
            <p class="mt-3 text-xs leading-relaxed text-body border-t border-hairline/60 pt-3">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </div>
  </div>
</Layout>
