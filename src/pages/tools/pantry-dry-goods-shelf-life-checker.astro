---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PantryDryGoodsShelfLifeChecker from '../../components/PantryDryGoodsShelfLifeChecker.astro';
import rawData from '../../data/pantry-dry-goods-shelf-life-data.json';

const pageTitle = "Pantry, Spices, Baking Powder & Dry Goods Shelf-Life & Safety Lookup | IsItKitchenSafe";
const pageDescription = "Check USDA shelf life for 30 pantry staples—rice, flour, spices, baking powder, yeast, honey, oils, and canned goods. Includes a dented can botulism triage inspector and 30-second leavener & oil freshness tests.";

const faqs = rawData.faqs.en;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools/' },
  { label: 'Pantry & Dry Goods Shelf-Life Lookup' }
];

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Pantry, Spices, Baking Powder & Dry Goods Shelf-Life & Safety Lookup",
  "url": "https://isitkitchensafe.com/tools/pantry-dry-goods-shelf-life-checker/",
  "applicationCategory": "HealthApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript.",
  "description": pageDescription,
  "inLanguage": "en",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  faqs={faqs}
  excludeFaqSchema={true}
  availableLocales={['en', 'es', 'pt', 'zh-cn', 'ja']}
  lang="en"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1 print:hidden">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1140px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-signature-coral text-white mb-3">
        30 USDA Pantry Staples · Dented Can Botulism Triage · 30s Freshness Tests
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        Pantry, Spices &amp; Dry Goods Shelf-Life &amp; Safety Lookup
      </h1>
      <p class="text-body text-[15px] md:text-[16px] leading-relaxed">
        Instantly look up unopened and opened <strong>USDA FoodKeeper shelf life</strong> for 30 staples—including <strong>rice, flour, baking powder, yeast, spices, honey, cooking oils, and canned foods</strong>—plus inspect dented cans for botulism risk and run 30-second fizz freshness tests.
      </p>
    </header>

    <!-- Main Interactive Checker Component -->
    <PantryDryGoodsShelfLifeChecker lang="en" />
  </div>
</Layout>
