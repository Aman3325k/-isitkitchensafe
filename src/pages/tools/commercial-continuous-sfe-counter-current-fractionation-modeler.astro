---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CommercialContinuousSfeCounterCurrentFractionationModeler from '../../components/CommercialContinuousSfeCounterCurrentFractionationModeler.astro';

const pageTitle = "Commercial Continuous Supercritical Fluid Extraction Counter-Current Packed Column Fractionation (SFE-CC) Essential Oil Modeler | IsItKitchenSafe";
const pageDescription = "Simulate commercial continuous counter-current dense CO2 extraction (80–220 bar, 35–65°C) in high-efficiency structured packing columns. Model Chrastil solubility density tuning, non-thermal monoterpene stripping, high-purity citrus oil folding (5-fold to 20-fold), phototoxic bergapten precipitation (<0.5 ppm), and ASME Section VIII pressure containment.";

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools/' },
  { label: 'Commercial Continuous SFE Counter-Current Fractionation Modeler' }
];

const faqs = [
  {
    question: "How does continuous counter-current supercritical fluid extraction (SFE-CC) achieve citrus oil folding and deterpenation without thermal heat?",
    answer: "Conventional citrus oil folding relies on vacuum fractional distillation at temperatures exceeding 110°C to 145°C. At these temperatures, heat-sensitive aliphatic aldehydes (such as octanal, decanal, and citral) undergo thermal degradation, oxidation, and cyclization into bitter, turpentine-like p-cymene. Continuous counter-current SFE (SFE-CC) replaces boiling with solvent-free dense carbon dioxide (SC-CO2) at gentle, non-thermal temperatures (35°C–48°C) under high pressure (85–110 bar). By tuning CO2 density to 320–420 kg/m³, monoterpene hydrocarbons (D-limonene, α-pinene) selectively dissolve into the ascending supercritical phase with partition coefficients exceeding 3.5, while high-value oxygenated aroma esters and aldehydes remain in the descending liquid film, achieving 5-fold to 20-fold concentration with strictly zero thermal degradation."
  },
  {
    question: "Why does Sulzer CY woven wire gauze packing dramatically outperform random dumping or tray columns in supercritical fractionation?",
    answer: "Supercritical CO2 extraction columns operate under extreme high pressures where liquid oil feed flow rates are typically small compared to the vast cross-sectional area. Traditional random dumping rings or sieve trays suffer from severe liquid channeling and dry spots. In contrast, Sulzer CY woven stainless steel wire gauze packing (specific surface area ~900 m²/m³) leverages capillary action along intersecting metallic wires to spontaneously spread raw oil into an unbroken, micron-thin descending liquid film. This guarantees 100% surface wetting and achieves an extraordinarily low Height Equivalent to a Theoretical Plate (HETP of 10–15 cm). An 8.5-meter packed column thus provides over 55 theoretical equilibrium stages, enabling sharp separation between closely boiling terpene isomers and aroma esters."
  },
  {
    question: "How does SFE-CC eliminate phototoxic furocoumarins (5-MOP / bergapten) to comply with IFRA and European Pharmacopoeia limits?",
    answer: "Cold-pressed citrus peel oils—especially Calabrian bergamot, Persian lime, and grapefruit—contain natural furocoumarins, predominantly 5-methoxypsoralen (5-MOP / bergapten, 1,500–3,500 ppm). When applied to skin exposed to sunlight (UVA 320–400 nm), bergapten triggers severe phototoxic blistering and hyperpigmentation (phytophotodermatitis). Under International Fragrance Association (IFRA) standards and European Pharmacopoeia 10.0 monographs, cosmetic and beverage ingredients must contain less than 1.0 ppm bergapten. In SFE-CC, dense CO2 at 90–105 bar lacks the solvation power to dissolve heavy, planar furocoumarin molecules. Consequently, 100% of bergapten precipitates out with heavy cuticular waxes into the primary separator stage, leaving the refined essential oil with less than 0.5 ppm residual bergapten without requiring chemical alkaline washes."
  },
  {
    question: "What role does the top reflux divider play in preventing the loss of valuable oxygenated flavor volatiles overhead?",
    answer: "As supercritical CO2 rises through the packed bed stripping monoterpenes, its solvation power can co-extract minor quantities of volatile oxygenated flavor compounds (such as octanal and linalool). To prevent these precious aroma notes from escaping into the overhead terpene byproduct stream, a fraction of the condensed terpene distillate is pumped back into the top of the column as reflux (Reflux Ratio R = 0.5–2.5). This descending cold terpene stream acts as a liquid wash, rectifying the ascending vapor phase and re-absorbing oxygenated volatiles back down into the stripping bed. This boosts oxygenated aroma recovery from ~82% in simple single-pass systems to greater than 96.5% in closed-loop reflux columns."
  },
  {
    question: "How do ASME Section VIII pressure codes and pilot-operated relief systems ensure plant safety at 250 bar?",
    answer: "Continuous SFE columns operate at industrial pressures up to 250 bar (3,625 psi), classifying them as Class IV pressure vessels under European PED 2014/68/EU and Section VIII Division 1 & 2 of the ASME Boiler and Pressure Vessel Code. Columns are forged from certified AISI 316L or 316Ti stainless steel with self-energizing Bridgman or Grayloc metal-to-metal seal closures. Plant safety protocols mandate dual redundant spring-loaded Safety Relief Valves (SRV) backed by reverse-buckling rupture discs with burst-detection sensors. Ambient optical CO2 gas monitoring sensors calibrated to OSHA permissible exposure limits (5,000 ppm TWA / 30,000 ppm STEL) trigger automated pneumatic Emergency Shutdown (ESD) valves to vent CO2 safely to remote absorption or reclamation scrubbers in the event of any line rupture."
  }
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": "https://isitkitchensafe.com/tools/commercial-continuous-sfe-counter-current-fractionation-modeler/#webapp",
      "url": "https://isitkitchensafe.com/tools/commercial-continuous-sfe-counter-current-fractionation-modeler/",
      "name": "Commercial Continuous Supercritical Fluid Extraction Counter-Current Packed Column Fractionation (SFE-CC) Essential Oil Modeler",
      "applicationCategory": "EngineeringApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5 Canvas/CSS3.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": pageDescription
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://isitkitchensafe.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Tools",
          "item": "https://isitkitchensafe.com/tools/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Commercial Continuous SFE Counter-Current Fractionation Modeler",
          "item": "https://isitkitchensafe.com/tools/commercial-continuous-sfe-counter-current-fractionation-modeler/"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-8">
    <Breadcrumbs items={breadcrumbs} />

    <CommercialContinuousSfeCounterCurrentFractionationModeler lang="en" />
  </main>
</Layout>
