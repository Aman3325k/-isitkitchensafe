---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CulinaryOilSmokePointSimulator from '../../components/CulinaryOilSmokePointSimulator.astro';

const pageTitle = "Culinary Oil Smoke Point & Carcinogenic Aldehyde Simulator | IsItKitchenSafe";
const pageDescription = "Evidence-based cooking oil thermal degradation simulator: compare smoke points vs true oxidative stability across 20 culinary oils. Calculate 4-HNE, MDA, and acrolein formation under frying and searing temperatures.";

const faqs = [
  {
    question: "Why does Extra Virgin Olive Oil outperform high-smoke-point seed oils under heat?",
    answer: "A widespread culinary misconception is that an oil's smoke point is the primary indicator of its safety and heat stability. In reality, chemical degradation during cooking is driven by lipid oxidation, not visible smoke. Extra Virgin Olive Oil (EVOO) contains approximately 75% monounsaturated oleic acid (which has only a single double bond resistant to thermal cleavage) and between 200 to 500 ppm of potent natural phenolic antioxidants (oleocanthal, hydroxytyrosol, squalene). These polyphenols actively sacrifice themselves to scavenge lipid peroxy radicals. Peer-reviewed research (De Alzaa et al., 2018; Prof. Martin Grootveld) demonstrates that EVOO produces significantly fewer polar compounds, trans-fatty acids, and cytotoxic aldehydes (such as 4-HNE) than refined corn, soybean, or sunflower oils, despite those seed oils possessing higher nominal smoke points."
  },
  {
    question: "What is 4-HNE (4-Hydroxy-2-nonenal) and why is it hazardous in cooked food?",
    answer: "4-Hydroxy-2-nonenal (4-HNE) is a cytotoxic, highly reactive alpha,beta-unsaturated alkenal generated when omega-6 polyunsaturated fatty acids (primarily linoleic acid, abundant in corn, soybean, sunflower, and grapeseed oils) undergo thermal peroxidative cleavage. 4-HNE rapidly forms covalent Michael adducts with nucleophilic histidine, lysine, and cysteine residues in bodily proteins and enzymes. Chronic dietary intake of 4-HNE from overheated seed oils inhibits mitochondrial respiration, promotes arterial endothelial inflammation, and has been directly implicated in atherosclerosis, metabolic dysfunction-associated steatohepatitis (MASH), and colorectal carcinogenesis."
  },
  {
    question: "Why is acrolein in cooking oil smoke classified as a serious respiratory hazard?",
    answer: "Acrolein (2-propenal) is an intensely irritating, volatile unsaturated aldehyde formed when the glycerol backbone of triglycerides decomposes under intense thermal stress, particularly when cooking fats reach or exceed their smoke points. Classified by the International Agency for Research on Cancer (IARC) as a Group 2A probable human carcinogen, acrolein vapors cause rapid respiratory cilia paralysis, epithelial cell necrosis, and acute pulmonary inflammation. Epidemiological investigations attribute elevated lung adenocarcinoma rates in non-smoking domestic and commercial cooks directly to prolonged inhalation of acrolein-laden wok and deep-fryer oil smoke."
  },
  {
    question: "What is the European regulatory limit for Total Polar Materials (TPM) in frying oil?",
    answer: "Under European commercial food safety regulations (such as German, French, and Spanish sanitary codes, harmonized under EU guidelines), the legal threshold for discarded frying oil is 24% to 27% Total Polar Materials (TPM). TPM measures the cumulative fraction of triglycerides that have cracked into polar degradation products, including free fatty acids, mono/diglycerides, polymeric oxidized triglycerides, and secondary aldehydes. Frying oil exceeding 24% TPM is legally declared adulterated and unfit for human consumption due to demonstrated gastrointestinal toxicity and vascular oxidative stress."
  },
  {
    question: "Why does reusing deep-frying oil exponentially increase toxic chemical formation?",
    answer: "Each time cooking oil is heated and cooled, moisture from food and atmospheric oxygen generate primary lipid hydroperoxides and free fatty acids. During subsequent heating cycles, these pre-existing breakdown compounds act as autocatalytic pro-oxidants, accelerating lipid peroxidation at substantially lower temperatures. Reheating also depresses the oil's effective smoke point by 30°F to 50°F per reuse. By the third or fourth reuse cycle, polyunsaturated seed oils generate over 300% more toxic volatile aldehydes and total polar compounds than fresh oil under identical temperature and time parameters."
  },
  {
    question: "Which culinary oils are safest for high-heat searing, stir-frying, and deep-frying?",
    answer: "For temperatures above 400°F (204°C), the safest culinary fats are those with low polyunsaturated fatty acid (PUFA) concentrations and high saturated or monounsaturated fatty acid stability: 1) Refined Avocado Oil (smoke point 520°F, 74% MUFA), 2) Traditional Ghee / Clarified Butter (smoke point 485°F, 65% SFA, milk proteins removed), 3) Grass-Fed Beef Tallow (smoke point 415°F, 50% SFA / 45% MUFA), and 4) High-Oleic Sunflower Oil (smoke point 450°F, 82% MUFA). For medium-heat sautéing and shallow frying (up to 380°F), high-quality Extra Virgin Olive Oil remains the healthiest choice due to its antioxidant protection."
  }
];

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools/' },
  { label: 'Culinary Oil Smoke Point Simulator' }
];

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Culinary Oil Smoke Point & Carcinogenic Aldehyde Simulator",
  "url": "https://isitkitchensafe.com/tools/culinary-oil-smoke-point-simulator/",
  "applicationCategory": "HealthApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "description": pageDescription,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};
---

<Layout title={pageTitle} description={pageDescription} faqs={faqs} availableLocales={['en', 'es', 'pt', 'zh-cn', 'ja']}>
  <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />

  <main class="container mx-auto px-4 py-8 max-w-5xl space-y-8">
    <Breadcrumbs items={breadcrumbs} />

    <CulinaryOilSmokePointSimulator lang="en" />

    <!-- Scientific In-Depth Analysis Section -->
    <section class="bg-surface-soft border border-hairline rounded-3xl p-6 md:p-10 space-y-8">
      <div class="border-b border-hairline pb-4">
        <span class="text-xs font-bold uppercase tracking-wider text-amber-800 dark:text-amber-400 block mb-1">
          Lipid Chemistry &amp; Food Safety Reference Guide
        </span>
        <h2 class="text-title-lg font-bold text-ink tracking-tight">
          Thermal Degradation of Culinary Fats: The Complete Biochemical Overview
        </h2>
        <p class="text-xs md:text-sm text-body leading-relaxed mt-2">
          How cooking temperature, fatty acid unsaturation, and antioxidant polyphenols govern the transformation of healthy fats into cytotoxic compounds.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-xs md:text-sm text-body leading-relaxed">
        <div class="space-y-4">
          <h3 class="text-sm md:text-base font-bold text-ink flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-amber-500"></span>
            The Mechanics of Lipid Peroxidation
          </h3>
          <p>
            When vegetable oils and animal fats are heated in a skillet or fryer, atmospheric oxygen attacks the hydrocarbon chains of fatty acids. Polyunsaturated fatty acids (PUFAs)—such as linoleic acid (18:2) and alpha-linolenic acid (18:3)—contain methylene carbons situated between two double bonds (bis-allylic positions). The carbon-hydrogen bonds at these positions have exceptionally low bond dissociation energy (approx. 322 kJ/mol), making them 100 times more susceptible to hydrogen abstraction than monounsaturated oleic acid (approx. 364 kJ/mol).
          </p>
          <p>
            Once a free radical abstracts a hydrogen atom, an unstable lipid alkyl radical is formed, which reacts instantly with molecular oxygen to generate a lipid peroxy radical (LOO•). This initiates an autocatalytic free radical chain reaction, creating primary lipid hydroperoxides (LOOH) that subsequently decompose under heat into toxic secondary oxidation products: aldehydes, epoxides, hydroxy fatty acids, and volatile hydrocarbons.
          </p>
        </div>

        <div class="space-y-4">
          <h3 class="text-sm md:text-base font-bold text-ink flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-rose-500"></span>
            Toxic Secondary Aldehydes: 4-HNE, MDA &amp; Acrolein
          </h3>
          <p>
            The decomposition of lipid hydroperoxides generates dozens of homologous aldehydes. Three of these represent urgent human health concerns:
          </p>
          <ul class="list-disc pl-5 space-y-2">
            <li>
              <strong>4-Hydroxy-2-nonenal (4-HNE):</strong> Formed from omega-6 PUFAs. As a soft electrophile, 4-HNE covalently binds to cellular nucleophiles, causing DNA damage, mitochondrial uncoupling, and oxidative stress associated with cardiometabolic diseases.
            </li>
            <li>
              <strong>Malondialdehyde (MDA):</strong> Formed via bicyclic endoperoxide cleavage. Reacts with DNA guanine bases to produce mutagenic M1G adducts, serving as a primary marker of genotoxic dietary stress.
            </li>
            <li>
              <strong>Acrolein (2-propenal):</strong> Formed by dehydration of glycerol at temperatures near the smoke point. Highly volatile lacrimator and IARC Group 2A probable carcinogen that damages lung bronchial mucosa when inhaled as kitchen cooking fumes.
            </li>
          </ul>
        </div>
      </div>

      <div class="border-t border-hairline pt-6">
        <h3 class="text-sm md:text-base font-bold text-ink mb-4">
          Culinary Fats Ranked by Heat Stability and Aldehyde Resistance
        </h3>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs border border-hairline rounded-xl overflow-hidden">
            <thead class="bg-canvas border-b border-hairline font-bold text-ink">
              <tr>
                <th class="p-3">Cooking Fat</th>
                <th class="p-3">Smoke Point</th>
                <th class="p-3">Fatty Acid Composition</th>
                <th class="p-3">Oxidative Stability</th>
                <th class="p-3">Aldehyde Risk</th>
                <th class="p-3">Best Culinary Use</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-hairline">
              <tr class="bg-surface-soft/50">
                <td class="p-3 font-semibold text-ink">Refined Avocado Oil</td>
                <td class="p-3 font-mono">520°F (271°C)</td>
                <td class="p-3">12% SFA / 74% MUFA / 14% PUFA</td>
                <td class="p-3 text-emerald-600 font-bold">22.0 hrs (Very High)</td>
                <td class="p-3 text-emerald-600">Minimal</td>
                <td class="p-3">Extreme Sear, Stir-Fry, Broiling</td>
              </tr>
              <tr>
                <td class="p-3 font-semibold text-ink">Traditional Ghee</td>
                <td class="p-3 font-mono">485°F (252°C)</td>
                <td class="p-3">65% SFA / 30% MUFA / 5% PUFA</td>
                <td class="p-3 text-emerald-600 font-bold">26.0 hrs (Very High)</td>
                <td class="p-3 text-emerald-600">Negligible</td>
                <td class="p-3">High-Heat Pan Searing, Baking</td>
              </tr>
              <tr class="bg-surface-soft/50">
                <td class="p-3 font-semibold text-ink">Extra Virgin Olive Oil</td>
                <td class="p-3 font-mono">390°F (199°C)</td>
                <td class="p-3">14% SFA / 75% MUFA / 11% PUFA</td>
                <td class="p-3 text-emerald-600 font-bold">24.5 hrs (Polyphenol Shield)</td>
                <td class="p-3 text-emerald-600">Very Low</td>
                <td class="p-3">Dressings, Low/Med Sauté, Baking</td>
              </tr>
              <tr>
                <td class="p-3 font-semibold text-ink">High-Oleic Sunflower</td>
                <td class="p-3 font-mono">450°F (232°C)</td>
                <td class="p-3">9% SFA / 82% MUFA / 9% PUFA</td>
                <td class="p-3 text-emerald-600 font-bold">18.5 hrs (High)</td>
                <td class="p-3 text-emerald-600">Low</td>
                <td class="p-3">Deep-Frying, Roasting</td>
              </tr>
              <tr class="bg-surface-soft/50">
                <td class="p-3 font-semibold text-ink">Refined Corn Oil</td>
                <td class="p-3 font-mono">450°F (232°C)</td>
                <td class="p-3">13% SFA / 28% MUFA / 59% PUFA</td>
                <td class="p-3 text-rose-600 font-bold">7.0 hrs (Poor)</td>
                <td class="p-3 text-rose-600 font-bold">Very High (4-HNE)</td>
                <td class="p-3">Cold Dressings, Avoid Frying</td>
              </tr>
              <tr>
                <td class="p-3 font-semibold text-ink">Standard Sunflower Oil</td>
                <td class="p-3 font-mono">440°F (227°C)</td>
                <td class="p-3">11% SFA / 20% MUFA / 69% PUFA</td>
                <td class="p-3 text-rose-600 font-bold">5.0 hrs (Very Poor)</td>
                <td class="p-3 text-rose-700 font-bold">Extreme</td>
                <td class="p-3">Cold Salads Only, Do Not Heat</td>
              </tr>
              <tr class="bg-surface-soft/50">
                <td class="p-3 font-semibold text-ink">Grapeseed Oil</td>
                <td class="p-3 font-mono">420°F (216°C)</td>
                <td class="p-3">10% SFA / 16% MUFA / 74% PUFA</td>
                <td class="p-3 text-rose-600 font-bold">4.2 hrs (Dangerous)</td>
                <td class="p-3 text-rose-700 font-bold">Extreme</td>
                <td class="p-3">Cold Mayonnaise, Do Not Heat</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- FAQ Accordion Section -->
    <section class="mt-16 bg-surface-soft border border-hairline rounded-3xl p-6 md:p-10 space-y-6">
      <div class="border-b border-hairline pb-4">
        <span class="text-xs font-bold uppercase tracking-wider text-amber-800 dark:text-amber-400 block mb-1">
          Lipid Toxicology &amp; Culinary Science Q&amp;A
        </span>
        <h2 class="text-title-lg font-medium text-ink tracking-tight">
          Frequently Asked Questions on Cooking Oil Smoke Points &amp; Aldehydes
        </h2>
        <p class="text-xs text-muted">Evidence-based guidelines grounded in Codex Alimentarius, IOC quality rules, and IARC lipid oxidation research.</p>
      </div>

      <div class="space-y-4">
        {faqs.map(faq => (
          <details class="group p-4 rounded-xl bg-canvas border border-hairline transition-colors open:bg-surface">
            <summary class="font-medium text-ink cursor-pointer list-none flex items-center justify-between text-sm md:text-base">
              <span>{faq.question}</span>
              <span class="text-muted transition-transform group-open:rotate-180 ml-2">&darr;</span>
            </summary>
            <p class="text-xs md:text-sm text-body mt-3 pt-3 border-t border-hairline/60 leading-relaxed">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </main>
</Layout>
