---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import OutdoorGrillBbqSafetyChecker from '../../components/OutdoorGrillBbqSafetyChecker.astro';
import rawData from '../../data/outdoor-grill-bbq-safety-data.json';

const pageTitle = "Outdoor Grill, BBQ, Smoker & Griddle Safety & Charcoal/Propane Checker | IsItKitchenSafe";
const pageDescription = "Interactive CDC, NFPA & USDA outdoor grilling safety checker: perform the 50/50 soapy water propane leak test, prevent wire grill brush bristle ingestion emergencies, check indoor carbon monoxide clearance, and verify safe internal meat cooking temperatures.";

const faqs = rawData.faqs.en;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools/' },
  { label: 'Outdoor Grill & BBQ Safety Checker' }
];

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Outdoor Grill, BBQ, Smoker & Griddle Safety & Charcoal/Propane Checker",
  "url": "https://isitkitchensafe.com/tools/outdoor-grill-bbq-safety-checker/",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript.",
  "description": pageDescription,
  "inLanguage": "en",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  faqs={faqs}
  excludeFaqSchema={true}
  availableLocales={['en', 'es', 'pt', 'zh-cn', 'ja']}
  lang="en"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1 print:hidden">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1140px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-signature-coral text-white mb-3">
        CDC Wire Brush Alert · NFPA Fire Protocol · USDA Meat Temps · Propane Leak Test
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        Outdoor Grill, BBQ, Smoker &amp; Griddle Safety Checker
      </h1>
      <p class="text-body text-[15px] md:text-[16px] leading-relaxed">
        Prevent catastrophic <strong>gas grill explosions</strong>, avoid emergency <strong>wire brush bristle ingestion</strong>, eliminate deadly <strong>carbon monoxide buildup</strong>, and check exact <strong>USDA internal meat temperatures</strong> before lighting your fire.
      </p>
    </header>

    <!-- Main Interactive Checker Component -->
    <OutdoorGrillBbqSafetyChecker lang="en" />
  </div>
</Layout>
