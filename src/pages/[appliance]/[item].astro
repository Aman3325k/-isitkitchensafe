---
import ItemPageTemplate from '../../components/ItemPageTemplate.astro';
import itemsData from '../../data/items.json';
import type { SupportedLanguage } from '../../i18n/ui';

export function getStaticPaths() {
  return itemsData.map((item) => {
    // For test proof of concept: hydroflask under dishwasher is available in en, es, pt
    const isTestItem = item.slug === 'hydroflask' && item.appliance === 'dishwasher';
    const availableLocales: SupportedLanguage[] = isTestItem ? ['en', 'es', 'pt'] : ['en'];

    return {
      params: {
        appliance: item.appliance,
        item: item.slug
      },
      props: {
        data: item,
        availableLocales
      }
    };
  });
}

interface Props {
  data: typeof itemsData[number];
  availableLocales: SupportedLanguage[];
}

const { data, availableLocales } = Astro.props;
---

<ItemPageTemplate data={data} lang="en" availableLocales={availableLocales} />
