---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ApplianceSafetyDiagram from '../../components/ApplianceSafetyDiagram.astro';
import itemsData from '../../data/items.json';
import itemsEs from '../../data/items.es.json';
import itemsPt from '../../data/items.pt.json';
import itemsZh from '../../data/items.zh-cn.json';
import itemsJa from '../../data/items.ja.json';
import { getDirectoryUrl } from '../../i18n/utils';

import type { SupportedLanguage } from '../../i18n/ui';

export function getStaticPaths() {
  const uniqueAppliances = [...new Set(itemsData.map(i => i.appliance))];
  const esAppliances = new Set(itemsEs.map(i => i.appliance));
  const ptAppliances = new Set(itemsPt.map(i => i.appliance));
  const zhAppliances = new Set(itemsZh.map(i => i.appliance));
  const jaAppliances = new Set(itemsJa.map(i => i.appliance));

  return uniqueAppliances.map(app => {
    const availableLocales: SupportedLanguage[] = ['en'];
    if (esAppliances.has(app)) availableLocales.push('es');
    if (ptAppliances.has(app)) availableLocales.push('pt');
    if (zhAppliances.has(app)) availableLocales.push('zh-cn');
    if (jaAppliances.has(app)) availableLocales.push('ja');
    return {
      params: { appliance: app },
      props: { availableLocales }
    };
  });
}

const { appliance } = Astro.params;
const { availableLocales } = Astro.props;

// Helper to format appliance names
function formatAppliance(app: string) {
  if (app === 'airfryer') return 'Air Fryer';
  return app.charAt(0).toUpperCase() + app.slice(1);
}

const formattedAppliance = formatAppliance(appliance);
const applianceItems = itemsData.filter(item => item.appliance === appliance);

// Color definitions for each appliance section hero banner
const bannerStyles: Record<string, { bg: string; text: string; subText: string }> = {
  dishwasher: {
    bg: 'bg-signature-forest',
    text: 'text-white',
    subText: 'text-white/80'
  },
  microwave: {
    bg: 'bg-signature-coral',
    text: 'text-white',
    subText: 'text-white/80'
  },
  freezer: {
    bg: 'bg-signature-cream',
    text: 'text-ink',
    subText: 'text-muted'
  },
  oven: {
    bg: 'bg-signature-peach',
    text: 'text-ink',
    subText: 'text-muted'
  },
  dryer: {
    bg: 'bg-signature-mint',
    text: 'text-ink',
    subText: 'text-muted'
  },
  airfryer: {
    bg: 'bg-signature-yellow',
    text: 'text-ink',
    subText: 'text-muted'
  },
  refrigerator: {
    bg: 'bg-signature-mustard',
    text: 'text-ink',
    subText: 'text-muted'
  }
};

const styles = bannerStyles[appliance] || { bg: 'bg-surface-soft', text: 'text-ink', subText: 'text-muted' };

const applianceFaqs: Record<string, Array<{ question: string; answer: string }>> = {
  dishwasher: [
    {
      question: `What items should never go in the dishwasher?`,
      answer: `Items like cast iron cookware, professional kitchen knives, wood cutting boards and utensils, copper cookware, and delicate crystal should never go in the dishwasher.`
    },
    {
      question: `Why does heat and moisture damage dishwasher-unsafe items?`,
      answer: `High water temperature and drying cycle heat warp plastics and wood, while harsh chemicals strip non-stick layers and oxidize metals.`
    }
  ],
  microwave: [
    {
      question: `Can you put metal in the microwave?`,
      answer: `No, sheet metals and foil reflect microwave radiation, building up charge until sparks fly, potentially causing fire or magnetron damage.`
    },
    {
      question: `Why do some foods explode in the microwave?`,
      answer: `Foods with tight skins or shells, like raw eggs or potatoes, trap water vapor as it converts to steam. The high pressure causes them to explode.`
    }
  ],
  freezer: [
    {
      question: `Does freezing change the texture of foods?`,
      answer: `Yes, high water-content foods like lettuce, cucumbers, or soft cheeses form ice crystals that break cell membranes, leaving them soggy when thawed.`
    },
    {
      question: `Is it safe to freeze items in glass jars?`,
      answer: `Only if the glass is tempered and you leave plenty of empty headspace for liquid expansion; otherwise, the glass will crack.`
    }
  ],
  oven: [
    {
      question: `What is the difference between parchment and wax paper in the oven?`,
      answer: `Parchment paper is coated with heat-resistant silicone and is safe to bake with. Wax paper is coated with wax that melts and can ignite in the oven.`
    },
    {
      question: `Can you put plastics in the oven?`,
      answer: `No, standard food-storage plastics will melt instantly, releasing toxic fumes and ruining the oven cavity.`
    }
  ],
  dryer: [
    {
      question: `Why do wool garments shrink in the dryer?`,
      answer: `Dryer heat and mechanical tumbling cause the scales on wool fibers to lock together and contract permanently, shrinking the garment.`
    },
    {
      question: `Is it safe to put shoes in the dryer?`,
      answer: `Only canvas shoes on low heat. Leather, running shoes, and resin shoes (like Crocs) warp, shrink, and peel because the heat degrades glues and foams.`
    }
  ],
  airfryer: [
    {
      question: `Can you put aluminum foil in an air fryer?`,
      answer: `Yes, as long as it is weighted down by food so it doesn't fly into the heating element, and doesn't block all the airflow slots.`
    },
    {
      question: `Why is cooking spray bad for air fryers?`,
      answer: `Aerosol cooking sprays contain propellants like lecithin that degrade the non-stick coating of the basket over time, causing it to peel.`
    }
  ],
  refrigerator: [
    {
      question: `Why shouldn't you store bread in the refrigerator?`,
      answer: `The cold, dry air speeds up starch retrogradation, recrystallizing the starch molecules and making the bread go stale much faster than at room temp.`
    },
    {
      question: `Which vegetables spoil faster when refrigerated?`,
      answer: `Potatoes, onions, and tomatoes lose flavor and texture in the fridge. Potatoes convert starch to sugar, while onions and tomatoes get soft and moldy.`
    }
  ]
};

const categoryDescriptions: Record<string, string> = {
  dishwasher: "Browse all safety guides for the Dishwasher. Find out which kitchenware, containers, and ingredients can be safely put in the Dishwasher according to USDA.",
  microwave: "Browse all safety guides for the Microwave. Find out which kitchenware, containers, and ingredients can be safely put in the Microwave according to USDA.",
  freezer: "Browse all safety guides for the Freezer. Find out which kitchenware, containers, and ingredients can be safely put in the Freezer according to USDA rules.",
  oven: "Browse all safety guides for the Oven. Find out which kitchenware, containers, and ingredients can be safely put in the Oven according to official USDA rules.",
  dryer: "Browse all safety guides for the Dryer. Find out which kitchenware, fabrics, containers, and garments can be safely put in the Dryer according to safety rules.",
  airfryer: "Browse all safety guides for the Air Fryer. Find out which kitchenware, containers, and ingredients can be safely put in the Air Fryer according to USDA.",
  refrigerator: "Browse all safety guides for the Refrigerator. Find out which kitchenware, food containers, and ingredients can be safely put in the Refrigerator today."
};

const pageTitle = `${formattedAppliance} Kitchen Safety Guides | IsItKitchenSafe`;
const pageDescription = categoryDescriptions[appliance] || `Browse all safety guides for the ${formattedAppliance}. Find out which items can be safely put in the ${formattedAppliance}.`;
const faqs = applianceFaqs[appliance] || [];

type FeaturedResourceKind = 'blog' | 'tool';

interface FeaturedResource {
  kind: FeaturedResourceKind;
  slug: string;
  title: string;
  summary: string;
}

const featuredResourcesByAppliance: Record<string, FeaturedResource[]> = {
  dishwasher: [
    {
      kind: 'blog',
      slug: 'stanley-yeti-hydro-flask-dishwasher-safe-guide',
      title: 'Stanley, YETI, Hydro Flask & Owala Dishwasher Guide',
      summary: 'Brand-by-brand vacuum seal, powder coat, and top-rack warranty rules.'
    },
    {
      kind: 'blog',
      slug: 'hexclad-caraway-lodge-le-creuset-care-guide',
      title: 'HexClad, Caraway, Lodge & Le Creuset Care Guide',
      summary: 'Official dishwasher and oven limits for enameled cast iron, ceramic, and hybrid pans.'
    },
    {
      kind: 'tool',
      slug: 'kitchen-symbol-decoder',
      title: 'Kitchen Bottom Symbol Decoder',
      summary: 'Identify stamped dishwasher, microwave, oven, and food-safe icons in seconds.'
    }
  ],
  airfryer: [
    {
      kind: 'blog',
      slug: 'air-fryer-parchment-paper-foil-silicone-liners-guide',
      title: 'Air Fryer Parchment, Foil & Silicone Liners Fire-Safe Rules',
      summary: 'How to weigh down liners safely without blocking airflow or igniting heating coils.'
    },
    {
      kind: 'tool',
      slug: 'air-fryer-oven-converter',
      title: 'Air Fryer & Oven Temp Conversion Calculator',
      summary: 'Convert conventional oven recipes to exact air fryer temperatures and cooking times.'
    },
    {
      kind: 'tool',
      slug: 'air-fryer-acrylamide-calculator',
      title: 'Air Fryer Acrylamide Calculator',
      summary: 'Estimate browning-zone acrylamide formation across starchy foods, heat, and time.'
    }
  ],
  oven: [
    {
      kind: 'blog',
      slug: 'pyrex-glass-thermal-shock-shatter-prevention-guide',
      title: 'Why Pyrex & Baking Glass Explodes — Borosilicate vs Soda-Lime',
      summary: 'Spot borosilicate vs. soda-lime glass and prevent sudden thermal-shock shattering.'
    },
    {
      kind: 'tool',
      slug: 'air-fryer-oven-converter',
      title: 'Oven, Convection & Gas Mark Converter',
      summary: 'Convert Fahrenheit, Celsius, convection fan, Gas Mark, and air fryer settings instantly.'
    },
    {
      kind: 'tool',
      slug: 'thermal-shock-simulator',
      title: 'Appliance Thermal Shock & Shatter Simulator',
      summary: 'Model glass, ceramic, and cast iron fracture risk across abrupt temperature swings.'
    }
  ],
  microwave: [
    {
      kind: 'blog',
      slug: 'plastic-numbers-1-to-7-microwave-dishwasher-guide',
      title: 'Plastic Numbers #1 to #7: Microwave & Dishwasher Guide',
      summary: 'See which resin codes tolerate microwave heat and which warp or leach chemicals.'
    },
    {
      kind: 'tool',
      slug: 'plastic-code-checker',
      title: 'Plastic Recycling Code #1–#7 Safety Checker',
      summary: 'Look up any stamped triangle code (#1–#7) for instant microwave and freezer verdicts.'
    },
    {
      kind: 'tool',
      slug: 'microwave-egg-explosion-simulator',
      title: 'Microwave Egg Explosion Simulator',
      summary: 'Simulate internal steam pressure buildup and learn safe egg reheating methods.'
    }
  ],
  freezer: [
    {
      kind: 'blog',
      slug: 'holiday-leftovers-turkey-thawing-safety-chart',
      title: 'Holiday Leftovers & Turkey Thawing Safety Chart',
      summary: 'USDA fridge, cold-water, and freezer storage charts to stay out of the danger zone.'
    },
    {
      kind: 'tool',
      slug: 'meat-thawing-calculator',
      title: 'USDA Meat & Turkey Safe Thawing Calculator',
      summary: 'Calculate exact refrigerator and cold-water defrost hours by weight and cut.'
    },
    {
      kind: 'tool',
      slug: 'leftover-shelf-life-calculator',
      title: 'USDA Leftover & Fridge Shelf-Life Calculator',
      summary: 'Get instant refrigerator and freezer expiration windows for cooked dishes and staples.'
    }
  ],
  refrigerator: [
    {
      kind: 'blog',
      slug: 'holiday-leftovers-turkey-thawing-safety-chart',
      title: 'Holiday Leftovers & Fridge Storage Safety Chart',
      summary: 'USDA 2-hour cooling rules, 40°F/4°C storage limits, and safe reheating thresholds.'
    },
    {
      kind: 'tool',
      slug: 'leftover-shelf-life-calculator',
      title: 'USDA Leftover & Fridge Shelf-Life Countdown Calculator',
      summary: 'Check exact fridge safe-window countdowns and when to freeze or discard leftovers.'
    },
    {
      kind: 'tool',
      slug: 'meat-thawing-calculator',
      title: 'USDA Meat & Turkey Safe Thawing Calculator',
      summary: 'Plan safe in-fridge thawing timelines for poultry, roasts, and ground meats.'
    }
  ],
  dryer: [
    {
      kind: 'tool',
      slug: 'kitchen-symbol-decoder',
      title: 'Kitchen & Care Symbol Decoder',
      summary: 'Decode stamped household, appliance, and heat-safety symbols with instant verdicts.'
    },
    {
      kind: 'tool',
      slug: 'material-swap-calculator',
      title: 'Safe Household Material Swap Calculator',
      summary: 'Compare heat-safe household material alternatives to reduce melting and chemical risk.'
    },
    {
      kind: 'blog',
      slug: 'kitchen-safety-myths-debunked',
      title: 'Household & Kitchen Safety Myths Debunked',
      summary: 'Evidence-based breakdowns of 10 viral home and appliance myths that cause real damage.'
    }
  ]
};

const featuredResources = featuredResourcesByAppliance[appliance] || [];
---

<Layout title={pageTitle} description={pageDescription} faqs={faqs} excludeArticleSchema={true} availableLocales={availableLocales}>
  <!-- Hero Section -->
  <section class={`${styles.bg} ${styles.text} py-[64px] md:py-[80px]`}>
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs 
        isDarkBg={styles.bg === 'bg-signature-forest' || styles.bg === 'bg-signature-coral'}
        items={[
          { label: 'Home', href: '/' },
          { label: formattedAppliance }
        ]}
        className="mb-6"
      />
      
      <h1 class="text-display-lg font-medium tracking-tight mb-4">
        {formattedAppliance} Safety Guides
      </h1>
      <p class={`${styles.subText} text-body-md max-w-2xl leading-relaxed`}>
        Explore the safety guidelines and rules for putting containers, food items, and cooking materials into the {formattedAppliance}. Check individual items below for comprehensive detailed reviews.
      </p>
    </div>
  </section>

  <!-- Visual Safety Diagram Section -->
  <section class="max-w-[1280px] mx-auto px-6 pt-12 md:pt-16">
    <ApplianceSafetyDiagram appliance={appliance} lang="en" />
  </section>

  <!-- Related Safety Guides & Interactive Calculators -->
  {featuredResources.length > 0 && (
    <section
      aria-labelledby="featured-resources-heading"
      class="max-w-[1280px] mx-auto px-6 pt-10"
    >
      <div class="bg-surface-soft/70 border border-hairline rounded-lg p-6 md:p-7">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 mb-5">
          <div>
            <span class="text-[11px] font-semibold uppercase tracking-wider text-info dark:text-info-border block mb-1">
              Related Safety Guides &amp; Interactive Calculators
            </span>
            <h2 id="featured-resources-heading" class="text-title-md md:text-title-lg font-medium text-ink tracking-tight">
              Featured Guides &amp; Interactive Tools for {formattedAppliance}
            </h2>
          </div>
          <div class="flex items-center gap-4 text-[13px] font-medium shrink-0">
            <a href="/blog/" class="text-link hover:text-link-active transition-colors">
              All Guides &rarr;
            </a>
            <a href="/tools/" class="text-link hover:text-link-active transition-colors">
              All Calculators &rarr;
            </a>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {featuredResources.map((res) => {
            const href = res.kind === 'blog' ? `/blog/${res.slug}/` : `/tools/${res.slug}/`;
            const isTool = res.kind === 'tool';
            return (
              <a
                href={href}
                class="group bg-canvas border border-hairline rounded-md p-5 flex flex-col justify-between shadow-xs transition-all hover:border-border-strong hover:shadow-sm"
              >
                <div>
                  <div class="flex items-center justify-between gap-2 mb-3">
                    <span
                      class={
                        isTool
                          ? 'inline-flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wider px-2.5 py-1 rounded-full bg-info/10 text-info dark:text-info-border border border-info/25'
                          : 'inline-flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wider px-2.5 py-1 rounded-full bg-success/10 text-success dark:text-success-border border border-success/25'
                      }
                    >
                      {isTool ? (
                        <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <rect x="4" y="2" width="16" height="20" rx="2" />
                          <line x1="8" y1="6" x2="16" y2="6" />
                          <line x1="8" y1="11" x2="8.01" y2="11" />
                          <line x1="12" y1="11" x2="12.01" y2="11" />
                          <line x1="16" y1="11" x2="16.01" y2="11" />
                          <line x1="8" y1="15" x2="8.01" y2="15" />
                          <line x1="12" y1="15" x2="12.01" y2="15" />
                          <line x1="16" y1="15" x2="16.01" y2="15" />
                        </svg>
                      ) : (
                        <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20" />
                        </svg>
                      )}
                      {isTool ? 'Interactive Tool' : 'Safety Guide'}
                    </span>
                  </div>
                  <h3 class="text-[16px] font-medium text-ink group-hover:text-link transition-colors leading-snug mb-2">
                    {res.title}
                  </h3>
                  <p class="text-[13px] text-muted leading-relaxed mb-4">
                    {res.summary}
                  </p>
                </div>
                <span class="text-[13px] font-medium text-link group-hover:text-link-active inline-flex items-center gap-1">
                  {isTool ? 'Open calculator' : 'Read safety guide'}
                  <span class="group-hover:translate-x-0.5 transition-transform" aria-hidden="true">&rarr;</span>
                </span>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- Items Grid Section -->
  <section class="max-w-[1280px] mx-auto px-6 pt-14 pb-[96px]">
    <div class="flex flex-col md:flex-row md:items-end justify-between border-b border-hairline pb-8 mb-12">
      <div>
        <h2 class="text-display-md text-ink tracking-tight mb-2">Tested Items ({applianceItems.length})</h2>
        <p class="text-body-md text-muted">A complete list of everyday kitchen items evaluated for {formattedAppliance} use.</p>
      </div>
      
      <!-- Static Quick Filter -->
      <div class="mt-6 md:mt-0 flex gap-3 max-w-[320px] w-full">
        <input 
          type="text" 
          id="filter-input"
          placeholder={`Search ${formattedAppliance} items...`}
          aria-label={`Search ${formattedAppliance} items`}
          class="w-full h-11 px-3 py-2 bg-canvas text-ink text-[16px] md:text-[14px] border border-hairline rounded-sm focus:outline-none focus:border-info-border"
        />
      </div>
    </div>

    <!-- Items Grid -->
    <div id="items-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {applianceItems.map(item => (
        <div 
          class="item-card bg-canvas border border-hairline rounded-md p-6 flex flex-col justify-between shadow-xs transition-all hover:border-border-strong"
          data-name={item.item.toLowerCase()}
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-caption text-muted uppercase tracking-wider text-xs">{formattedAppliance}</span>
              {item.safe === 'yes' && <span class="badge-yes">YES</span>}
              {item.safe === 'no' && <span class="badge-no">NO</span>}
              {item.safe === 'depends' && <span class="badge-depends">DEPENDS</span>}
            </div>
            
            <h3 class="text-title-sm text-ink mb-3">
              Can You Put {item.item} in the {formattedAppliance}?
            </h3>
            
            <p class="text-body-md text-body leading-relaxed mb-6">
              {item.shortAnswer}
            </p>
          </div>
          
          <a 
            href={`/${item.appliance}/${item.slug}/`} 
            class="text-link text-[14px] font-medium hover:text-link-active transition-colors min-h-[44px] inline-flex items-center gap-1 group mt-2 -ml-1 px-1"
          >
            Read safety details <span class="group-hover:translate-x-0.5 transition-transform">&rarr;</span>
          </a>
        </div>
      ))}
    </div>

    <!-- No results message -->
    <div id="no-results" class="hidden text-center py-12">
      <p class="text-title-md text-muted">No items match your search.</p>
    </div>
  </section>

  <!-- Related Categories Section -->
  <section class="border-t border-hairline bg-surface-soft/40 py-16">
    <div class="max-w-[1280px] mx-auto px-6">
      <h2 class="text-title-lg text-ink font-medium tracking-tight mb-8">Related Appliance & Safety Categories</h2>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
        {['dishwasher', 'microwave', 'freezer', 'oven', 'dryer', 'airfryer', 'refrigerator']
          .filter(app => app !== appliance)
          .map(app => (
            <a href={`/${app}/`} class="p-5 bg-canvas border border-hairline rounded-md hover:border-border-strong shadow-xs text-decoration-none transition-colors active:scale-[0.98] block">
              <span class="text-xs uppercase tracking-wider text-muted font-bold block mb-1">Appliance Guide</span>
              <h3 class="text-title-sm text-ink mb-1 font-medium">{formatAppliance(app)}</h3>
              <span class="text-xs text-link">Explore Guides &rarr;</span>
            </a>
          ))
        }
        
        <a href={getDirectoryUrl('how-long', 'en')} class="p-5 bg-canvas border border-hairline rounded-md hover:border-border-strong shadow-xs text-decoration-none transition-colors active:scale-[0.98] block">
          <span class="text-xs uppercase tracking-wider text-muted font-bold block mb-1">Shelf Life Guide</span>
          <h3 class="text-title-sm text-ink mb-1 font-medium">Shelf Life & Storage</h3>
          <span class="text-xs text-link">Explore Guides &rarr;</span>
        </a>
        <a href={getDirectoryUrl('refreeze', 'en')} class="p-5 bg-canvas border border-hairline rounded-md hover:border-border-strong shadow-xs text-decoration-none transition-colors active:scale-[0.98] block">
          <span class="text-xs uppercase tracking-wider text-muted font-bold block mb-1">Freezer Safety</span>
          <h3 class="text-title-sm text-ink mb-1 font-medium">Refreezing Guides</h3>
          <span class="text-xs text-link">Explore Guides &rarr;</span>
        </a>
        <a href={getDirectoryUrl('washing-machine', 'en')} class="p-5 bg-canvas border border-hairline rounded-md hover:border-border-strong shadow-xs text-decoration-none transition-colors active:scale-[0.98] block">
          <span class="text-xs uppercase tracking-wider text-muted font-bold block mb-1">Fabric & Clothes</span>
          <h3 class="text-title-sm text-ink mb-1 font-medium">Washing Machine Guides</h3>
          <span class="text-xs text-link">Explore Guides &rarr;</span>
        </a>
        <a href={getDirectoryUrl('what-happens', 'en')} class="p-5 bg-canvas border border-hairline rounded-md hover:border-border-strong shadow-xs text-decoration-none transition-colors active:scale-[0.98] block">
          <span class="text-xs uppercase tracking-wider text-muted font-bold block mb-1">Emergency Checklist</span>
          <h3 class="text-title-sm text-ink mb-1 font-medium">What Happens If...</h3>
          <span class="text-xs text-link">Explore Guides &rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Client-side filtering script -->
  <script is:inline>
    const filterInput = document.getElementById('filter-input');
    const itemsGrid = document.getElementById('items-grid');
    const noResults = document.getElementById('no-results');

    if (filterInput && itemsGrid) {
      const cards = itemsGrid.getElementsByClassName('item-card');
      
      filterInput.addEventListener('input', (e) => {
        const query = e.target.value.trim().toLowerCase();
        let matches = 0;
        
        for (let i = 0; i < cards.length; i++) {
          const card = cards[i];
          const name = card.getAttribute('data-name');
          
          if (name.includes(query)) {
            card.classList.remove('hidden');
            matches++;
          } else {
            card.classList.add('hidden');
          }
        }
        
        if (matches === 0) {
          noResults.classList.remove('hidden');
        } else {
          noResults.classList.add('hidden');
        }
      });
    }
  </script>
</Layout>
