          data-count-template="Showing {shown} of {total} standards"
          class="text-xs font-mono text-muted"
          aria-live="polite"
        >
          Showing 10 of 10 standards
        </p>
      </div>
      <p class="text-body-md text-body leading-relaxed mb-5">
        Search or filter the 10 primary regulatory codes, food-science benchmarks, and engineering standards that power every safety verdict and calculator on IsItKitchenSafe.
      </p>

      <!-- Search & Filter Controls -->
      <div class="bg-surface-soft border border-hairline rounded-lg p-4 mb-5 space-y-3.5">
        <div class="relative">
          <label for="standards-search-input" class="sr-only">
            Search regulatory standards, codes, temperatures, or hazards
          </label>
          <input
            id="standards-search-input"
