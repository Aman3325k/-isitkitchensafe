            <div class="min-w-0">
              <h4 class="text-sm font-semibold text-ink mb-1">{item.title}</h4>
              <p class="text-xs text-body leading-relaxed">{item.detail}</p>
            </div>
          </div>
        ))}
      </div>

      <!-- Recent Milestones -->
      <h3 class="text-title-sm text-ink font-semibold mb-3">
        Recent Review Milestones
      </h3>
      <ol class="space-y-3">
        {changelogEntries.map((entry) => (
          <li class="bg-canvas border border-hairline rounded-lg p-4 flex flex-col sm:flex-row sm:items-start gap-2.5 sm:gap-4">
            <div class="flex items-center gap-2 shrink-0">
              <span class="text-xs font-mono font-semibold text-ink bg-surface-soft border border-hairline px-2.5 py-0.5 rounded">
                {entry.date}
              </span>
              <span class="text-[11px] font-medium text-muted">
                {entry.badge}
              </span>
            </div>
            <p class="text-body-md text-body leading-relaxed">
              {entry.summary}
            </p>
          </li>
        ))}
      </ol>
    </section>

    <!-- Interactive Verification Tools Strip -->
    <section id="verification-tools" class="mb-14" aria-labelledby="verification-tools-heading">
      <div class="mb-5">
        <span class="text-xs font-semibold uppercase tracking-wider text-signature-coral block mb-1">
          Standards in Action
        </span>
        <h2 id="verification-tools-heading" class="text-title-lg text-ink font-medium tracking-tight mb-2">
          Interactive Verification Tools
        </h2>
        <p class="text-body-md text-body leading-relaxed">
          Apply these federal food-safety, material-science, and chemical-reactivity benchmarks directly to your own kitchen questions.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5">
        {verificationTools.map((tool) => (
          <a
            href={tool.href}
            class="group bg-surface-soft hover:bg-surface-strong/40 border border-hairline rounded-lg p-4 flex flex-col gap-2 transition-colors"
          >
            <span class="text-[11px] font-mono text-muted">
              {tool.tag}
            </span>
            <h3 class="text-sm font-semibold text-ink group-hover:text-link transition-colors">
