---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getDirectoryUrl, useTranslatedPath, useTranslations } from '../i18n/utils';

const lang = 'en' as const;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const pageTitle = 'Contact Us, Safety Corrections & Item Requests | IsItKitchenSafe';
const pageDescription =
  'Reach the IsItKitchenSafe editorial desk and reader support team. Report a safety correction with 48-hour review SLA, suggest a cookware brand or calculator, or access instant safety checkers.';

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact IsItKitchenSafe',
  url: 'https://isitkitchensafe.com/contact/',
  inLanguage: 'en',
  description: pageDescription,
  isPartOf: {
    '@type': 'WebSite',
    name: 'IsItKitchenSafe',
    url: 'https://isitkitchensafe.com/'
  },
  mainEntity: {
    '@type': 'Organization',
    name: 'IsItKitchenSafe',
    alternateName: 'Is It Kitchen Safe?',
    url: 'https://isitkitchensafe.com/',
    logo: {
      '@type': 'ImageObject',
      url: 'https://isitkitchensafe.com/favicon.svg'
    },
    publishingPrinciples: 'https://isitkitchensafe.com/methodology/',
    correctionsPolicy: 'https://isitkitchensafe.com/methodology/#review-protocol',
    contactPoint: [
      {
        '@type': 'ContactPoint',
        email: 'editorial@isitkitchensafe.com',
        contactType: 'editorial desk',
        availableLanguage: ['English', 'Spanish', 'Portuguese', 'Chinese', 'Japanese']
      },
      {
        '@type': 'ContactPoint',
        email: 'support@isitkitchensafe.com',
        contactType: 'customer support',
        availableLanguage: ['English', 'Spanish', 'Portuguese', 'Chinese', 'Japanese']
      }
    ]
  }
};

const methodologyUrl = getDirectoryUrl('methodology', lang);
const aboutUrl = getDirectoryUrl('about', lang);
const toolsUrl = getDirectoryUrl('tools', lang);
const disclaimerUrl = getDirectoryUrl('disclaimer', lang);

const fireGuideUrl = translatePath('/tools/kitchen-fire-emergency-guide/');
const cleanerMixUrl = translatePath('/tools/cleaner-mixing-danger-checker/');

const quickCalculators = [
  {
    href: translatePath('/tools/kitchen-symbol-decoder/'),
    tag: 'Visual Decoder',
    title: 'Kitchen Symbol Decoder',
    desc: 'Identify dishwasher, microwave, oven, freezer, and plastic resin symbols stamped on cookware.'
  },
  {
    href: translatePath('/tools/power-outage-food-safety-checker/'),
    tag: 'USDA 4h / 24h / 48h',
    title: 'Power Outage Food Safety Checker',
    desc: 'Instant keep-or-toss guidance for refrigerated and frozen foods after an outage.'
  },
  {
    href: translatePath('/tools/moldy-food-safety-checker/'),
    tag: 'USDA Guidance',
    title: 'Moldy Food Safety Checker',
    desc: 'Check which firm foods can be trimmed by 1 inch and which soft foods must be discarded.'
  },
  {
    href: fireGuideUrl,
    tag: 'Emergency Protocol',
    title: 'Kitchen Fire Emergency Guide',
    desc: 'Exact suppression steps for grease, oven, microwave, and electrical kitchen fires.'
  }
];

const popularBrands = ['Ninja', 'Stanley', 'Pyrex', 'Le Creuset', 'YETI', 'HexClad', 'Instant Pot', 'Lodge'];

const applianceOptions = [
  'Dishwasher',
  'Microwave',
  'Air Fryer',
  'Oven / Broiler',
  'Freezer',
  'Refrigerator',
  'Shelf Life / Food Safety',
  'New Interactive Calculator'
];

const standardOptions = [
  'USDA FSIS (FoodKeeper / Safe Temps)',
  'FDA 21 CFR (Food Contact Materials)',
  'NSF/ANSI 51 or 184 (Equipment / Dishwasher)',
  'CDC / AAP (Infant & Pediatric Feeding)',
  'Manufacturer Care Manual (OEM)',
  'EPA / ASTM / Other Primary Standard'
];

const triageConfig = {
  supportEmail: 'support@isitkitchensafe.com',
  editorialEmail: 'editorial@isitkitchensafe.com',
  copiedLabel: 'Copied!',
  copyFailedLabel: 'Copy manually from preview',
  loadedNotice: 'Template loaded into the contact form below. Add your name and email to send.',
  question: {
    subjectPrefix: '[Safety Question] ',
    defaultTopic: 'Kitchen Appliance Safety',
    bodyIntro: 'Hi IsItKitchenSafe Support Team,',
    labelCategory: 'Appliance / Topic: ',
    labelDetails: 'Question Details: ',
    defaultDetails: '(Describe the cookware material, brand/model, or food item and what you want to check)',
    bodyOutro: 'Thank you!'
  },
  correction: {
    subjectPrefix: '[Safety Correction - 48h SLA] ',
    defaultSubjectSuffix: 'Guide Verification Update',
    bodyIntro: 'Hi IsItKitchenSafe Editorial Desk,',
    labelUrl: 'Page URL: ',
    defaultUrl: 'https://isitkitchensafe.com/...',
    labelStandard: 'Cited Standard / Source: ',
    labelNotes: 'Suggested Correction & Citation Details: ',
    defaultNotes: '(Describe the specific verdict, temperature, or material specification that should be reviewed)',
    bodyOutro: 'Please review under the 48-hour editorial verification SLA.'
  },
  suggestion: {
    subjectPrefix: '[New Suggestion] ',
    defaultSubjectSuffix: 'Brand / Item / Calculator Request',
    bodyIntro: 'Hi IsItKitchenSafe Team,',
    labelCategory: 'Appliance / Category: ',
    labelBrand: 'Brand Name: ',
    defaultBrand: '(e.g., Ninja, Stanley, Pyrex, Le Creuset)',
    labelItem: 'Item, Model, or Calculator Idea: ',
    defaultItem: '(Describe the product model or calculator workflow you would like added)',
    bodyOutro: 'Thanks for considering this addition!'
  },
  media: {
    subject: '[Media / Educational Licensing] Inquiry for IsItKitchenSafe Editorial Desk',
    body: 'Hi IsItKitchenSafe Editorial Desk,\n\nOrganization / Publication / School:\nInquiry Type (Press Quote / Classroom Licensing / Citation Permission / General):\nDeadline or Preferred Timeline:\nDetails:\n\nThank you!'
  }
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  excludeArticleSchema={true}
  excludeFaqSchema={true}
  availableLocales={['en', 'es', 'pt', 'zh-cn', 'ja']}
  lang={lang}
>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(contactSchema)} />

  <article class="max-w-[920px] mx-auto px-6 py-12 md:py-16">
    <Breadcrumbs
      items={[
        { label: t('nav.home'), href: translatePath('/') },
        { label: 'Contact Us' }
      ]}
      className="mb-6"
    />

    <!-- Hero Header -->
    <header class="mb-8">
      <span class="text-xs font-semibold uppercase tracking-wider text-signature-coral block mb-2">
        Reader Support &amp; Editorial Desk
      </span>
      <h1 class="text-display-lg font-medium text-ink tracking-tight mb-3">
        Contact Us
      </h1>
      <p class="text-title-md text-body leading-relaxed max-w-[760px]">
        Select your inquiry type below for instant self-service safety tools, 48-hour editorial correction templates, brand or calculator requests, or direct press contact. You can also email us at
        <!--email_off--><a href="mailto:support@isitkitchensafe.com" class="text-link hover:underline font-medium">support@isitkitchensafe.com</a><!--/email_off-->
        or reach our editorial desk at
        <!--email_off--><a href="mailto:editorial@isitkitchensafe.com" class="text-link hover:underline font-medium">editorial@isitkitchensafe.com</a><!--/email_off-->.
      </p>
    </header>

    <!-- Emergency Medical / Poison Control / Fire Safety Disclaimer Callout -->
    <aside
      aria-labelledby="emergency-disclaimer-heading"
      class="bg-error-bg border border-error/30 dark:border-error-border/40 rounded-lg p-5 mb-10"
    >
      <div class="flex flex-col gap-3">
        <div class="flex flex-wrap items-center gap-2">
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wider bg-error/15 text-error dark:text-error-border border border-error/30">
            Not Monitored for Emergencies
          </span>
          <h2 id="emergency-disclaimer-heading" class="text-title-sm font-semibold text-ink">
            Active Kitchen Fire, Gas Leak, or Chemical Mixing Emergency?
          </h2>
        </div>
        <p class="text-[13.5px] text-body leading-relaxed">
          Email and contact form submissions are <strong class="text-ink font-semibold">not monitored in real time</strong>. If you are experiencing a kitchen fire, natural gas smell, severe burn, or toxic fumes from accidentally mixing household cleaners (such as bleach and vinegar or ammonia), leave the area immediately and call <strong class="text-ink font-semibold">911</strong> (US/Canada), <strong class="text-ink font-semibold">112</strong> (EU/International), or <strong class="text-ink font-semibold">Poison Control at 1-800-222-1222</strong> (US).
        </p>
        <div class="flex flex-wrap gap-2.5 pt-1">
          <a
            href={fireGuideUrl}
            class="min-h-[38px] px-3.5 py-2 bg-canvas hover:bg-surface-strong/40 text-ink border border-error/30 rounded-md text-xs font-semibold inline-flex items-center gap-1.5 transition-colors"
          >
            Kitchen Fire Emergency Guide &rarr;
          </a>
          <a
            href={cleanerMixUrl}
            class="min-h-[38px] px-3.5 py-2 bg-canvas hover:bg-surface-strong/40 text-ink border border-error/30 rounded-md text-xs font-semibold inline-flex items-center gap-1.5 transition-colors"
          >
            Cleaner Mixing Danger Checker &rarr;
          </a>
        </div>
      </div>
    </aside>

    <!-- Interactive 4-Topic Inquiry Triage Selector -->
    <section
      id="contact-triage"
      aria-labelledby="triage-heading"
      class="mb-12"
      data-config={JSON.stringify(triageConfig)}
    >
      <div class="mb-4">
        <span class="text-xs font-semibold uppercase tracking-wider text-signature-coral block mb-1">
          Step 1 &middot; Guided Triage
        </span>
        <h2 id="triage-heading" class="text-title-lg font-medium text-ink tracking-tight">
          How Can We Help You Today?
        </h2>
      </div>

      <!-- 4 Topic Selector Buttons -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 mb-6" role="group" aria-label="Inquiry topic selector">
        <button
          type="button"
          data-triage-tab="question"
          aria-pressed="true"
          class="text-left rounded-lg border p-4 transition-colors cursor-pointer bg-primary text-on-primary border-primary flex flex-col gap-1"
        >
          <span class="text-[11px] font-mono uppercase tracking-wider opacity-80">01 &middot; Self-Service</span>
          <span class="text-[14px] font-semibold leading-snug">Ask a Kitchen Safety Question</span>
          <span class="text-[12px] opacity-80 leading-snug">Instant calculators + question template</span>
        </button>

        <button
          type="button"
          data-triage-tab="correction"
          aria-pressed="false"
          class="text-left rounded-lg border p-4 transition-colors cursor-pointer bg-surface-soft text-ink border-hairline hover:bg-surface-strong/40 flex flex-col gap-1"
        >
          <span class="text-[11px] font-mono uppercase tracking-wider opacity-80">02 &middot; 48h SLA</span>
          <span class="text-[14px] font-semibold leading-snug">Report a Safety Correction</span>
          <span class="text-[12px] opacity-80 leading-snug">Standard updates &amp; OEM citations</span>
        </button>

        <button
          type="button"
          data-triage-tab="suggestion"
          aria-pressed="false"
          class="text-left rounded-lg border p-4 transition-colors cursor-pointer bg-surface-soft text-ink border-hairline hover:bg-surface-strong/40 flex flex-col gap-1"
        >
          <span class="text-[11px] font-mono uppercase tracking-wider opacity-80">03 &middot; New Coverage</span>
          <span class="text-[14px] font-semibold leading-snug">Suggest a Brand, Item, or Tool</span>
          <span class="text-[12px] opacity-80 leading-snug">Ninja, Stanley, Pyrex, Le Creuset &amp; more</span>
        </button>

        <button
          type="button"
          data-triage-tab="media"
          aria-pressed="false"
          class="text-left rounded-lg border p-4 transition-colors cursor-pointer bg-surface-soft text-ink border-hairline hover:bg-surface-strong/40 flex flex-col gap-1"
        >
          <span class="text-[11px] font-mono uppercase tracking-wider opacity-80">04 &middot; Editorial</span>
          <span class="text-[14px] font-semibold leading-snug">Media, Licensing &amp; General</span>
          <span class="text-[12px] opacity-80 leading-snug">Press, classroom use &amp; partnerships</span>
        </button>
      </div>

      <!-- PANEL 1: Ask a Kitchen Safety Question -->
      <div
        data-triage-panel="question"
        class="bg-surface-soft border border-hairline rounded-lg p-5 md:p-6 flex flex-col gap-6"
      >
        <div>
          <span class="text-[11px] font-semibold uppercase tracking-wider text-success dark:text-success-border block mb-1">
            Instant Self-Service Lookups
          </span>
          <h3 class="text-title-sm font-semibold text-ink mb-1.5">
            Get an Immediate Verified Answer Before Emailing
          </h3>
          <p class="text-[13.5px] text-body leading-relaxed">
            Most everyday kitchen questions are answered in seconds by our free USDA, FDA, and NSF-backed interactive calculators:
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {quickCalculators.map((calc) => (
            <a
              href={calc.href}
              class="group bg-canvas hover:bg-surface-strong/30 border border-hairline rounded-md p-4 flex flex-col gap-1.5 transition-colors"
            >
              <span class="text-[11px] font-mono text-muted">{calc.tag}</span>
              <span class="text-[14px] font-semibold text-ink group-hover:text-link transition-colors">
                {calc.title}
              </span>
              <span class="text-[12.5px] text-body leading-relaxed">{calc.desc}</span>
              <span class="text-xs font-medium text-link mt-1">Open Calculator &rarr;</span>
            </a>
          ))}
        </div>

        <div class="border-t border-hairline pt-5 flex flex-col gap-4">
          <h4 class="text-[14px] font-semibold text-ink">
            Still Have a Specific Question? Pre-Fill a Structured Inquiry
          </h4>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="flex flex-col gap-1.5">
              <label for="triage-q-category" class="text-[12px] font-semibold text-ink uppercase tracking-wider">
                Appliance or Topic
              </label>
              <select
                id="triage-q-category"
                class="w-full h-11 px-3.5 bg-canvas text-ink text-[14px] border border-hairline rounded-sm focus:outline-none focus:border-info-border"
              >
                {applianceOptions.map((opt) => (
                  <option value={opt}>{opt}</option>
                ))}
              </select>
            </div>
            <div class="flex flex-col gap-1.5">
              <label for="triage-q-details" class="text-[12px] font-semibold text-ink uppercase tracking-wider">
                Item / Material / Short Question
              </label>
              <input
                type="text"
                id="triage-q-details"
                placeholder="e.g., Can I put an insulated stainless steel lid in the air fryer?"
                class="w-full h-11 px-3.5 bg-canvas text-ink text-[14px] border border-hairline rounded-sm focus:outline-none focus:border-info-border"
              />
            </div>
          </div>

          <pre
            id="triage-q-preview"
            class="bg-canvas border border-hairline rounded-md p-3.5 text-[12.5px] text-body font-mono whitespace-pre-wrap break-words leading-relaxed"
          ></pre>

          <div class="flex flex-wrap items-center gap-2.5">
            <button
              type="button"
              data-fill-form="question"
              class="min-h-[42px] px-4 py-2 bg-primary hover:bg-primary-active text-on-primary rounded-md text-xs font-semibold cursor-pointer transition-colors"
            >
              Pre-Fill Contact Form Below
            </button>
            <a
              id="triage-q-mailto"
              href="mailto:support@isitkitchensafe.com"
              class="min-h-[42px] px-4 py-2 bg-canvas hover:bg-surface-strong/40 text-ink border border-hairline rounded-md text-xs font-semibold inline-flex items-center transition-colors"
            >
              Open in Email App &rarr;
            </a>
            <button
              type="button"
              data-copy-template="question"
              class="min-h-[42px] px-4 py-2 bg-canvas hover:bg-surface-strong/40 text-ink border border-hairline rounded-md text-xs font-semibold cursor-pointer transition-colors"
            >
              Copy Template
            </button>
            <span id="triage-q-copy-status" class="text-xs font-medium text-success dark:text-success-border" aria-live="polite"></span>
          </div>
        </div>
      </div>

      <!-- PANEL 2: Report a Safety Correction or Standard Update -->
      <div
        data-triage-panel="correction"
        class="hidden bg-surface-soft border border-hairline rounded-lg p-5 md:p-6 flex flex-col gap-5"
      >
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div class="max-w-[620px]">
            <div class="flex flex-wrap items-center gap-2 mb-1.5">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wider bg-info/10 text-info dark:text-info-border border border-info/30">
                48-Hour Editorial SLA
              </span>
              <span class="text-xs text-muted">Primary-Source Verification</span>
            </div>
            <h3 class="text-title-sm font-semibold text-ink mb-1">
              Report a Safety Correction or Standard Update
            </h3>
            <p class="text-[13.5px] text-body leading-relaxed">
              Every verdict is anchored to published regulatory codes and OEM specs. When you flag an updated manufacturer manual or USDA/FDA/NSF standard change, our editorial desk audits primary documentation within <strong class="text-ink font-semibold">48 business hours</strong>.
            </p>
          </div>
          <a
            href={methodologyUrl}
            class="min-h-[38px] px-3.5 py-2 bg-canvas hover:bg-surface-strong/40 text-link border border-hairline rounded-md text-xs font-semibold inline-flex items-center shrink-0 transition-colors"
          >
            Read Editorial Methodology &rarr;
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="flex flex-col gap-1.5">
            <label for="triage-c-url" class="text-[12px] font-semibold text-ink uppercase tracking-wider">
              Guide or Calculator URL
            </label>
            <input
              type="url"
              id="triage-c-url"
              placeholder="https://isitkitchensafe.com/dishwasher/..."
              class="w-full h-11 px-3.5 bg-canvas text-ink text-[14px] border border-hairline rounded-sm focus:outline-none focus:border-info-border"
            />
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="triage-c-standard" class="text-[12px] font-semibold text-ink uppercase tracking-wider">
              Standard or Source Citation
            </label>
            <select
              id="triage-c-standard"
              class="w-full h-11 px-3.5 bg-canvas text-ink text-[14px] border border-hairline rounded-sm focus:outline-none focus:border-info-border"
            >
              {standardOptions.map((opt) => (
                <option value={opt}>{opt}</option>
              ))}
            </select>
          </div>
        </div>

        <div class="flex flex-col gap-1.5">
          <label for="triage-c-notes" class="text-[12px] font-semibold text-ink uppercase tracking-wider">
            Correction Summary &amp; Evidence Link
          </label>
          <textarea
            id="triage-c-notes"
            rows="3"
            placeholder="Share the exact temperature limit, material change, or link to the updated USDA/FDA/OEM care guide..."
            class="w-full px-3.5 py-2.5 bg-canvas text-ink text-[14px] border border-hairline rounded-sm focus:outline-none focus:border-info-border resize-y"
          ></textarea>
        </div>

        <pre
          id="triage-c-preview"
          class="bg-canvas border border-hairline rounded-md p-3.5 text-[12.5px] text-body font-mono whitespace-pre-wrap break-words leading-relaxed"
        ></pre>

        <div class="flex flex-wrap items-center gap-2.5">
          <button
            type="button"
            data-fill-form="correction"
            class="min-h-[42px] px-4 py-2 bg-primary hover:bg-primary-active text-on-primary rounded-md text-xs font-semibold cursor-pointer transition-colors"
          >
            Load Correction into Form Below
          </button>
          <a
            id="triage-c-mailto"
            href="mailto:editorial@isitkitchensafe.com"
            class="min-h-[42px] px-4 py-2 bg-canvas hover:bg-surface-strong/40 text-ink border border-hairline rounded-md text-xs font-semibold inline-flex items-center transition-colors"
          >
            Email Editorial Desk (mailto) &rarr;
          </a>
          <button
            type="button"
            data-copy-template="correction"
            class="min-h-[42px] px-4 py-2 bg-canvas hover:bg-surface-strong/40 text-ink border border-hairline rounded-md text-xs font-semibold cursor-pointer transition-colors"
          >
            Copy Template
          </button>
          <span id="triage-c-copy-status" class="text-xs font-medium text-success dark:text-success-border" aria-live="polite"></span>
        </div>
      </div>

      <!-- PANEL 3: Suggest a New Brand, Item, or Calculator -->
      <div
        data-triage-panel="suggestion"
        class="hidden bg-surface-soft border border-hairline rounded-lg p-5 md:p-6 flex flex-col gap-5"
      >
        <div>
          <span class="text-[11px] font-semibold uppercase tracking-wider text-signature-coral block mb-1">
            Expand Our Reference Library
          </span>
          <h3 class="text-title-sm font-semibold text-ink mb-1">
            Suggest a New Brand, Kitchen Item, or Calculator
          </h3>
          <p class="text-[13.5px] text-body leading-relaxed">
            Missing a specific cookware line, insulated tumbler, or food-safety scenario? Pick a category and brand below to generate a structured request for our research queue.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="flex flex-col gap-1.5">
            <label for="triage-s-category" class="text-[12px] font-semibold text-ink uppercase tracking-wider">
              Appliance / Category
            </label>
            <select
              id="triage-s-category"
              class="w-full h-11 px-3.5 bg-canvas text-ink text-[14px] border border-hairline rounded-sm focus:outline-none focus:border-info-border"
            >
              {applianceOptions.map((opt) => (
                <option value={opt}>{opt}</option>
              ))}
            </select>
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="triage-s-brand" class="text-[12px] font-semibold text-ink uppercase tracking-wider">
              Brand Name
            </label>
            <input
              type="text"
              id="triage-s-brand"
              placeholder="e.g., Ninja, Stanley, Pyrex, Le Creuset"
              class="w-full h-11 px-3.5 bg-canvas text-ink text-[14px] border border-hairline rounded-sm focus:outline-none focus:border-info-border"
            />
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <span class="text-[12px] text-muted font-medium">Quick-pick brands:</span>
          {popularBrands.map((brand) => (
            <button
              type="button"
              data-brand-chip={brand}
              class="px-2.5 py-1 rounded-full text-xs font-medium bg-canvas hover:bg-surface-strong/40 text-ink border border-hairline cursor-pointer transition-colors"
            >
              {brand}
            </button>
          ))}
        </div>

        <div class="flex flex-col gap-1.5">
          <label for="triage-s-item" class="text-[12px] font-semibold text-ink uppercase tracking-wider">
            Specific Product Model or Calculator Idea
          </label>
          <input
            type="text"
            id="triage-s-item"
            placeholder="e.g., Stanley Quencher H2.0 lid &amp; straw, Ninja Crispi glass container, or sourdough starter shelf-life tool"
            class="w-full h-11 px-3.5 bg-canvas text-ink text-[14px] border border-hairline rounded-sm focus:outline-none focus:border-info-border"
          />
        </div>

        <pre
          id="triage-s-preview"
          class="bg-canvas border border-hairline rounded-md p-3.5 text-[12.5px] text-body font-mono whitespace-pre-wrap break-words leading-relaxed"
        ></pre>

        <div class="flex flex-wrap items-center gap-2.5">
          <button
            type="button"
            data-fill-form="suggestion"
            class="min-h-[42px] px-4 py-2 bg-primary hover:bg-primary-active text-on-primary rounded-md text-xs font-semibold cursor-pointer transition-colors"
          >
            Load Suggestion into Form Below
          </button>
          <a
            id="triage-s-mailto"
            href="mailto:support@isitkitchensafe.com"
            class="min-h-[42px] px-4 py-2 bg-canvas hover:bg-surface-strong/40 text-ink border border-hairline rounded-md text-xs font-semibold inline-flex items-center transition-colors"
          >
            Email Request (mailto) &rarr;
          </a>
          <button
            type="button"
            data-copy-template="suggestion"
            class="min-h-[42px] px-4 py-2 bg-canvas hover:bg-surface-strong/40 text-ink border border-hairline rounded-md text-xs font-semibold cursor-pointer transition-colors"
          >
            Copy Template
          </button>
          <span id="triage-s-copy-status" class="text-xs font-medium text-success dark:text-success-border" aria-live="polite"></span>
        </div>
      </div>

      <!-- PANEL 4: Media, Educational Licensing & General Inquiries -->
      <div
        data-triage-panel="media"
        class="hidden bg-surface-soft border border-hairline rounded-lg p-5 md:p-6 flex flex-col gap-5"
      >
        <div>
          <span class="text-[11px] font-semibold uppercase tracking-wider text-signature-coral block mb-1">
            Press, Educators &amp; Institutions
          </span>
          <h3 class="text-title-sm font-semibold text-ink mb-1">
            Media, Educational Licensing &amp; General Inquiries
          </h3>
          <p class="text-[13.5px] text-body leading-relaxed">
            Journalists, culinary instructors, dietitians, and public-health educators may cite our verified tables and printable kitchen safety cheat sheets with attribution. Note that IsItKitchenSafe maintains <strong class="text-ink font-semibold">100% editorial independence</strong> and does not accept paid verdicts or sponsored safety ratings.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="bg-canvas border border-hairline rounded-md p-4 flex flex-col gap-1.5">
            <span class="text-[11px] font-mono uppercase tracking-wider text-muted">Editorial, Press &amp; Corrections</span>
            <span class="text-[15px] font-semibold text-ink">Editorial Verification Desk</span>
            <!--email_off--><a href="mailto:editorial@isitkitchensafe.com" class="text-sm text-link hover:underline font-medium">editorial@isitkitchensafe.com</a><!--/email_off-->
            <p class="text-xs text-muted leading-relaxed mt-1">
              For media interviews, citation requests, culinary/school licensing, and standard corrections.
            </p>
          </div>

          <div class="bg-canvas border border-hairline rounded-md p-4 flex flex-col gap-1.5">
            <span class="text-[11px] font-mono uppercase tracking-wider text-muted">Reader Support &amp; General</span>
            <span class="text-[15px] font-semibold text-ink">General Support Desk</span>
            <!--email_off--><a href="mailto:support@isitkitchensafe.com" class="text-sm text-link hover:underline font-medium">support@isitkitchensafe.com</a><!--/email_off-->
            <p class="text-xs text-muted leading-relaxed mt-1">
              For accessibility feedback, technical bug reports, new item suggestions, and general questions.
            </p>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-2.5">
          <button
            type="button"
            data-fill-form="media"
            class="min-h-[42px] px-4 py-2 bg-primary hover:bg-primary-active text-on-primary rounded-md text-xs font-semibold cursor-pointer transition-colors"
          >
            Pre-Fill Press / Licensing Form Below
          </button>
          <a
            id="triage-m-mailto"
            href="mailto:editorial@isitkitchensafe.com"
            class="min-h-[42px] px-4 py-2 bg-canvas hover:bg-surface-strong/40 text-ink border border-hairline rounded-md text-xs font-semibold inline-flex items-center transition-colors"
          >
            Email Press Desk (mailto) &rarr;
          </a>
          <button
            type="button"
            data-copy-template="media"
            class="min-h-[42px] px-4 py-2 bg-canvas hover:bg-surface-strong/40 text-ink border border-hairline rounded-md text-xs font-semibold cursor-pointer transition-colors"
          >
            Copy Template
          </button>
          <span id="triage-m-copy-status" class="text-xs font-medium text-success dark:text-success-border" aria-live="polite"></span>
        </div>
      </div>
    </section>

    <!-- Step 2: Direct Contact Form + Editorial Standards Sidebar -->
    <section id="contact-form-section" aria-labelledby="direct-form-heading" class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <div class="lg:col-span-7 bg-surface-soft border border-hairline rounded-lg p-6 md:p-8">
        <div class="mb-6">
          <span class="text-xs font-semibold uppercase tracking-wider text-signature-coral block mb-1">
            Step 2 &middot; Direct Message
          </span>
          <h2 id="direct-form-heading" class="text-title-lg font-medium text-ink tracking-tight mb-1.5">
            Send Us a Message
          </h2>
          <p class="text-[13.5px] text-muted leading-relaxed">
            Prefer to write directly on this page? Fill out the form below (or use a triage template above to pre-populate the subject and message).
          </p>
        </div>

        <div
          id="form-prefill-notice"
          class="hidden bg-info/10 border border-info/30 text-info dark:text-info-border rounded-md px-4 py-3 text-xs font-medium mb-5"
          aria-live="polite"
        ></div>

        <!-- Client-side Interactive Form -->
        <form id="contact-form" class="flex flex-col gap-5">
          <div class="flex flex-col gap-2">
            <label for="name" class="text-[13px] font-semibold text-ink uppercase tracking-wider">Your Name</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              placeholder="Jane Doe"
              class="w-full h-11 px-4 py-3 bg-canvas text-ink text-[14px] border border-hairline rounded-sm focus:outline-none focus:border-info-border"
            />
          </div>

          <div class="flex flex-col gap-2">
            <label for="email" class="text-[13px] font-semibold text-ink uppercase tracking-wider">Email Address</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="jane@example.com"
              class="w-full h-11 px-4 py-3 bg-canvas text-ink text-[14px] border border-hairline rounded-sm focus:outline-none focus:border-info-border"
            />
          </div>

          <div class="flex flex-col gap-2">
            <label for="subject" class="text-[13px] font-semibold text-ink uppercase tracking-wider">Subject</label>
            <input
              type="text"
              id="subject"
              name="subject"
              required
              placeholder="New Item Suggestion / Guide Correction"
              class="w-full h-11 px-4 py-3 bg-canvas text-ink text-[14px] border border-hairline rounded-sm focus:outline-none focus:border-info-border"
            />
          </div>

          <div class="flex flex-col gap-2">
            <label for="message" class="text-[13px] font-semibold text-ink uppercase tracking-wider">Message</label>
            <textarea
              id="message"
              name="message"
              required
              rows="6"
              placeholder="Tell us about the kitchen item, appliance, or primary source citation..."
              class="w-full px-4 py-3 bg-canvas text-ink text-[14px] border border-hairline rounded-sm focus:outline-none focus:border-info-border resize-y min-h-[140px]"
            ></textarea>
          </div>

          <!-- Honeypot -->
          <input type="text" name="b_name" id="b_name" style="display:none" tabindex="-1" autocomplete="off" />

          <button
            id="submit-btn"
            type="submit"
            class="btn-primary mt-1"
            data-sending-text="Sending..."
            data-error-text="Something went wrong. Please try again later."
          >
            Send Message
          </button>
        </form>

        <!-- Success Message Container -->
        <div id="success-message" class="hidden bg-success/10 border border-success/30 rounded-md p-6 mt-6" aria-live="polite">
          <h3 class="text-title-sm text-success dark:text-success-border font-semibold mb-2 flex items-center gap-1.5">
            <span>&#10003;</span> Message Sent!
          </h3>
          <p class="text-[13.5px] text-body leading-relaxed">
            Thank you for reaching out. We have received your inquiry and will review it as soon as possible.
          </p>
        </div>

        <!-- Error Message Container -->
        <div id="error-message" class="hidden bg-error-bg border border-error/30 rounded-md p-6 mt-6" aria-live="polite">
          <h3 class="text-title-sm text-error dark:text-error-border font-semibold mb-2 flex items-center gap-1.5">
            <span>&#10007;</span> Failed to send message
          </h3>
          <p id="error-text" class="text-[13.5px] text-error dark:text-error-border leading-relaxed">
            Something went wrong. Please try again later.
          </p>
        </div>
      </div>

      <!-- Right Sidebar: SLA, Direct Desks & Trust Links -->
      <aside class="lg:col-span-5 flex flex-col gap-5">
        <div class="bg-surface-soft border border-hairline rounded-lg p-5 flex flex-col gap-4">
          <h2 class="text-title-sm font-semibold text-ink">Response Times &amp; Editorial SLA</h2>
          <ul class="flex flex-col gap-3 text-[13.5px] text-body leading-relaxed list-none p-0 m-0">
            <li class="flex flex-col gap-0.5 pb-3 border-b border-hairline">
              <span class="font-semibold text-ink">Safety Corrections &amp; Standard Updates</span>
              <span>Reviewed against USDA, FDA, NSF, and OEM manuals within <strong class="text-ink">48 business hours</strong>.</span>
            </li>
            <li class="flex flex-col gap-0.5 pb-3 border-b border-hairline">
              <span class="font-semibold text-ink">New Brand, Item &amp; Calculator Requests</span>
              <span>Triaged and added to our editorial backlog within <strong class="text-ink">2–3 business days</strong>.</span>
            </li>
            <li class="flex flex-col gap-0.5">
              <span class="font-semibold text-ink">Zero Sponsored Verdicts Policy</span>
              <span>We never accept payment to change a YES, DEPENDS, or NO safety verdict.</span>
            </li>
          </ul>
        </div>

        <div class="bg-surface-soft border border-hairline rounded-lg p-5 flex flex-col gap-3">
          <h2 class="text-title-sm font-semibold text-ink">Direct Email Desks</h2>
          <div class="text-[13.5px] text-body flex flex-col gap-2">
            <div>
              <span class="text-xs uppercase tracking-wider text-muted font-semibold block">Support &amp; Item Requests</span>
              <!--email_off--><a href="mailto:support@isitkitchensafe.com" class="text-link hover:underline font-medium">support@isitkitchensafe.com</a><!--/email_off-->
            </div>
            <div>
              <span class="text-xs uppercase tracking-wider text-muted font-semibold block">Corrections, Press &amp; Licensing</span>
              <!--email_off--><a href="mailto:editorial@isitkitchensafe.com" class="text-link hover:underline font-medium">editorial@isitkitchensafe.com</a><!--/email_off-->
            </div>
          </div>
        </div>

        <div class="bg-surface-soft border border-hairline rounded-lg p-5 flex flex-col gap-3">
          <h2 class="text-title-sm font-semibold text-ink">Transparency &amp; Safety Resources</h2>
          <div class="flex flex-col gap-2">
            <a href={methodologyUrl} class="text-[13.5px] text-link hover:underline font-medium">
              Safety Verification Methodology &rarr;
            </a>
            <a href={aboutUrl} class="text-[13.5px] text-link hover:underline font-medium">
              About Us &amp; Editorial Board &rarr;
            </a>
            <a href={toolsUrl} class="text-[13.5px] text-link hover:underline font-medium">
              Browse All Interactive Safety Calculators &rarr;
            </a>
            <a href={disclaimerUrl} class="text-[13.5px] text-link hover:underline font-medium">
              Medical &amp; Safety Disclaimer &rarr;
            </a>
          </div>
        </div>
      </aside>
    </section>
  </article>

  <script is:inline>
    (function () {
      var triageRoot = document.getElementById('contact-triage');
      var cfg = {};
      if (triageRoot) {
        try {
          cfg = JSON.parse(triageRoot.getAttribute('data-config') || '{}');
        } catch (err) {
          cfg = {};
        }
      }

      var tabs = triageRoot ? triageRoot.querySelectorAll('[data-triage-tab]') : [];
      var panels = triageRoot ? triageRoot.querySelectorAll('[data-triage-panel]') : [];

      var qCat = document.getElementById('triage-q-category');
      var qDetails = document.getElementById('triage-q-details');
      var qPreview = document.getElementById('triage-q-preview');
      var qMailto = document.getElementById('triage-q-mailto');

      var cUrl = document.getElementById('triage-c-url');
      var cStd = document.getElementById('triage-c-standard');
      var cNotes = document.getElementById('triage-c-notes');
      var cPreview = document.getElementById('triage-c-preview');
      var cMailto = document.getElementById('triage-c-mailto');

      var sCat = document.getElementById('triage-s-category');
      var sBrand = document.getElementById('triage-s-brand');
      var sItem = document.getElementById('triage-s-item');
      var sPreview = document.getElementById('triage-s-preview');
      var sMailto = document.getElementById('triage-s-mailto');
      var brandChips = triageRoot ? triageRoot.querySelectorAll('[data-brand-chip]') : [];

      var mMailto = document.getElementById('triage-m-mailto');

      var form = document.getElementById('contact-form');
      var subjectInput = document.getElementById('subject');
      var messageInput = document.getElementById('message');
      var prefillNotice = document.getElementById('form-prefill-notice');
      var successMsg = document.getElementById('success-message');
      var errorMsg = document.getElementById('error-message');
      var errorText = document.getElementById('error-text');
      var submitBtn = document.getElementById('submit-btn');

      function buildMailtoHref(email, subject, body) {
        return 'mailto:' + email + '?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);
      }

      function buildTemplate(topic) {
        var supportEmail = cfg.supportEmail || 'support@isitkitchensafe.com';
        var editorialEmail = cfg.editorialEmail || 'editorial@isitkitchensafe.com';

        if (topic === 'question') {
          var q = cfg.question || {};
          var catVal = qCat ? qCat.value : (q.defaultTopic || 'Kitchen Safety');
          var detVal = (qDetails && qDetails.value.trim()) ? qDetails.value.trim() : (q.defaultDetails || '');
          var qSubject = (q.subjectPrefix || '[Safety Question] ') + catVal;
          var qBody = (q.bodyIntro || '') + '\n\n' +
            (q.labelCategory || 'Topic: ') + catVal + '\n' +
            (q.labelDetails || 'Details: ') + detVal + '\n\n' +
            (q.bodyOutro || '');
          return { email: supportEmail, subject: qSubject, body: qBody };
        }

        if (topic === 'correction') {
          var c = cfg.correction || {};
          var urlVal = (cUrl && cUrl.value.trim()) ? cUrl.value.trim() : (c.defaultUrl || '');
          var stdVal = cStd ? cStd.value : '';
          var notesVal = (cNotes && cNotes.value.trim()) ? cNotes.value.trim() : (c.defaultNotes || '');
          var cSubject = (c.subjectPrefix || '[Correction] ') + (stdVal || c.defaultSubjectSuffix || '');
          var cBody = (c.bodyIntro || '') + '\n\n' +
            (c.labelUrl || 'Page URL: ') + urlVal + '\n' +
            (c.labelStandard || 'Standard: ') + stdVal + '\n' +
            (c.labelNotes || 'Notes: ') + notesVal + '\n\n' +
            (c.bodyOutro || '');
          return { email: editorialEmail, subject: cSubject, body: cBody };
        }

        if (topic === 'suggestion') {
          var s = cfg.suggestion || {};
          var sCatVal = sCat ? sCat.value : '';
          var brandVal = (sBrand && sBrand.value.trim()) ? sBrand.value.trim() : (s.defaultBrand || '');
          var itemVal = (sItem && sItem.value.trim()) ? sItem.value.trim() : (s.defaultItem || '');
          var suffix = (sBrand && sBrand.value.trim()) ? (sBrand.value.trim() + ' - ' + sCatVal) : (sCatVal || s.defaultSubjectSuffix || '');
          var sSubject = (s.subjectPrefix || '[Suggestion] ') + suffix;
          var sBody = (s.bodyIntro || '') + '\n\n' +
            (s.labelCategory || 'Category: ') + sCatVal + '\n' +
            (s.labelBrand || 'Brand: ') + brandVal + '\n' +
            (s.labelItem || 'Item: ') + itemVal + '\n\n' +
            (s.bodyOutro || '');
          return { email: supportEmail, subject: sSubject, body: sBody };
        }

        var m = cfg.media || {};
        return {
          email: editorialEmail,
          subject: m.subject || '[Media / Licensing Inquiry]',
          body: m.body || ''
        };
      }

      function refreshTemplates() {
        var qData = buildTemplate('question');
        if (qPreview) {
          qPreview.textContent = qData.subject + '\n\n' + qData.body;
        }
        if (qMailto) {
          qMailto.setAttribute('href', buildMailtoHref(qData.email, qData.subject, qData.body));
        }

        var cData = buildTemplate('correction');
        if (cPreview) {
          cPreview.textContent = cData.subject + '\n\n' + cData.body;
        }
        if (cMailto) {
          cMailto.setAttribute('href', buildMailtoHref(cData.email, cData.subject, cData.body));
        }

        var sData = buildTemplate('suggestion');
        if (sPreview) {
          sPreview.textContent = sData.subject + '\n\n' + sData.body;
        }
        if (sMailto) {
          sMailto.setAttribute('href', buildMailtoHref(sData.email, sData.subject, sData.body));
        }

        var mData = buildTemplate('media');
        if (mMailto) {
          mMailto.setAttribute('href', buildMailtoHref(mData.email, mData.subject, mData.body));
        }
      }

      function activateTopic(topic) {
        for (var i = 0; i < tabs.length; i++) {
          var tab = tabs[i];
          var isCurrent = tab.getAttribute('data-triage-tab') === topic;
          tab.setAttribute('aria-pressed', isCurrent ? 'true' : 'false');
          if (isCurrent) {
            tab.classList.add('bg-primary', 'text-on-primary', 'border-primary');
            tab.classList.remove('bg-surface-soft', 'text-ink', 'border-hairline', 'hover:bg-surface-strong/40');
          } else {
            tab.classList.remove('bg-primary', 'text-on-primary', 'border-primary');
            tab.classList.add('bg-surface-soft', 'text-ink', 'border-hairline', 'hover:bg-surface-strong/40');
          }
        }
        for (var j = 0; j < panels.length; j++) {
          var panel = panels[j];
          var show = panel.getAttribute('data-triage-panel') === topic;
          panel.classList.toggle('hidden', !show);
        }
      }

      function copyTextWithFallback(text, statusEl) {
        function showStatus(msg) {
          if (!statusEl) return;
          statusEl.textContent = msg;
          setTimeout(function () {
            if (statusEl.textContent === msg) {
              statusEl.textContent = '';
            }
          }, 2600);
        }

        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(function () {
            showStatus(cfg.copiedLabel || 'Copied!');
          }).catch(function () {
            showStatus(cfg.copyFailedLabel || 'Copy manually');
          });
          return;
        }

        try {
          var ta = document.createElement('textarea');
          ta.value = text;
          ta.setAttribute('readonly', '');
          ta.style.position = 'absolute';
          ta.style.left = '-9999px';
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          document.body.removeChild(ta);
          showStatus(cfg.copiedLabel || 'Copied!');
        } catch (err) {
          showStatus(cfg.copyFailedLabel || 'Copy manually');
        }
      }

      for (var tIdx = 0; tIdx < tabs.length; tIdx++) {
        tabs[tIdx].addEventListener('click', function (evt) {
          var topic = evt.currentTarget.getAttribute('data-triage-tab') || 'question';
          activateTopic(topic);
        });
      }

      var liveInputs = [qCat, qDetails, cUrl, cStd, cNotes, sCat, sBrand, sItem];
      for (var inpIdx = 0; inpIdx < liveInputs.length; inpIdx++) {
        if (liveInputs[inpIdx]) {
          liveInputs[inpIdx].addEventListener('input', refreshTemplates);
          liveInputs[inpIdx].addEventListener('change', refreshTemplates);
        }
      }

      for (var bIdx = 0; bIdx < brandChips.length; bIdx++) {
        brandChips[bIdx].addEventListener('click', function (evt) {
          var chosen = evt.currentTarget.getAttribute('data-brand-chip') || '';
          if (sBrand) {
            sBrand.value = chosen;
            sBrand.focus();
          }
          refreshTemplates();
        });
      }

      var copyButtons = triageRoot ? triageRoot.querySelectorAll('[data-copy-template]') : [];
      var statusMap = {
        question: document.getElementById('triage-q-copy-status'),
        correction: document.getElementById('triage-c-copy-status'),
        suggestion: document.getElementById('triage-s-copy-status'),
        media: document.getElementById('triage-m-copy-status')
      };

      for (var cpIdx = 0; cpIdx < copyButtons.length; cpIdx++) {
        copyButtons[cpIdx].addEventListener('click', function (evt) {
          var topic = evt.currentTarget.getAttribute('data-copy-template') || 'question';
          var data = buildTemplate(topic);
          var fullText = 'To: ' + data.email + '\nSubject: ' + data.subject + '\n\n' + data.body;
          copyTextWithFallback(fullText, statusMap[topic]);
        });
      }

      var fillButtons = triageRoot ? triageRoot.querySelectorAll('[data-fill-form]') : [];
      for (var flIdx = 0; flIdx < fillButtons.length; flIdx++) {
        fillButtons[flIdx].addEventListener('click', function (evt) {
          var topic = evt.currentTarget.getAttribute('data-fill-form') || 'question';
          var data = buildTemplate(topic);
          if (subjectInput) {
            subjectInput.value = data.subject;
          }
          if (messageInput) {
            messageInput.value = data.body;
          }
          if (prefillNotice) {
            prefillNotice.textContent = cfg.loadedNotice || 'Template loaded into the form below.';
            prefillNotice.classList.remove('hidden');
          }
          var formSection = document.getElementById('contact-form-section');
          if (formSection) {
            formSection.scrollIntoView({ behavior: 'smooth' });
          }
          var nameInput = document.getElementById('name');
          if (nameInput) {
            nameInput.focus();
          }
        });
      }

      // Support optional URL query or hash deep-linking (e.g. ?topic=correction&url=...)
      try {
        var params = new URLSearchParams(window.location.search);
        var urlTopic = params.get('topic') || (window.location.hash ? window.location.hash.replace('#', '') : '');
        var urlRef = params.get('url');
        if (urlRef && cUrl) {
          cUrl.value = urlRef;
        }
        if (urlTopic === 'question' || urlTopic === 'correction' || urlTopic === 'suggestion' || urlTopic === 'media') {
          activateTopic(urlTopic);
        }
      } catch (err) {
        // Ignore URL parsing issues
      }

      refreshTemplates();

      if (form && successMsg && errorMsg && submitBtn) {
        form.addEventListener('submit', function (e) {
          e.preventDefault();

          var formData = new FormData(form);
          var originalBtnText = submitBtn.textContent;
          submitBtn.textContent = submitBtn.getAttribute('data-sending-text') || 'Sending...';
          submitBtn.disabled = true;
          errorMsg.classList.add('hidden');

          fetch('/api/contact', {
            method: 'POST',
            body: formData
          }).then(function (response) {
            return response.json().catch(function () {
              return { success: false, message: submitBtn.getAttribute('data-error-text') || 'Invalid response from server.' };
            }).then(function (result) {
              if (response.ok && result.success) {
                form.classList.add('hidden');
                if (prefillNotice) {
                  prefillNotice.classList.add('hidden');
                }
                successMsg.classList.remove('hidden');
                successMsg.scrollIntoView({ behavior: 'smooth' });
              } else {
                throw new Error(result.message || submitBtn.getAttribute('data-error-text') || 'Unknown error occurred.');
              }
            });
          }).catch(function (err) {
            if (errorText) {
              errorText.textContent = (err && err.message) ? err.message : (submitBtn.getAttribute('data-error-text') || 'There was a network error. Please try again later.');
            }
            errorMsg.classList.remove('hidden');
            submitBtn.textContent = originalBtnText;
            submitBtn.disabled = false;
          });
        });
      }
    })();
  </script>
</Layout>
