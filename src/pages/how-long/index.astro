---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import howLongData from '../../data/how-long.json';

// Helper to format storage location
function formatLocation(loc: string) {
  if (loc === 'pantry') return 'Pantry';
  if (loc === 'fridge') return 'Refrigerator';
  if (loc === 'freezer') return 'Freezer';
  return loc.charAt(0).toUpperCase() + loc.slice(1);
}

const pageTitle = "Food Shelf Life & Storage Safety Guides | IsItKitchenSafe";
const pageDescription = "Find out how long everyday ingredients, cooked meals, and raw food items last in the pantry, refrigerator, or freezer according to official USDA rules.";
---

<Layout title={pageTitle} description={pageDescription} excludeArticleSchema={true} availableLocales={['en', 'es', 'pt', 'ja', 'zh-cn']}>
  <!-- Hero Section -->
  <section class="bg-signature-forest text-white py-[64px] md:py-[80px]">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs 
        isDarkBg={true}
        items={[
          { label: 'Home', href: '/' },
          { label: 'Shelf Life' }
        ]}
        className="mb-6"
      />
      
      <h1 class="text-display-lg font-medium tracking-tight mb-4">
        Food Shelf Life Safety Guides
      </h1>
      <p class="text-white/80 text-body-md max-w-2xl leading-relaxed">
        Check safe storage durations and spoilage signs for ingredients and meals. All durations strictly match USDA food safety guidelines.
      </p>
    </div>
  </section>

  <!-- Items Grid Section -->
  <section class="max-w-[1280px] mx-auto px-6 py-[72px] md:py-[96px]">
    <!-- Featured Calculator Spotlight Banner -->
    <div class="mb-10 rounded-lg border border-hairline bg-surface-soft/80 p-5 md:p-6 flex flex-col md:flex-row md:items-center justify-between gap-4 shadow-xs">
      <div class="flex items-start gap-4">
        <div class="w-10 h-10 rounded-md bg-signature-forest text-white flex items-center justify-center shrink-0 mt-0.5" aria-hidden="true">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </div>
        <div>
          <span class="inline-block text-[11px] font-bold uppercase tracking-wider text-info mb-1">Interactive Calculator</span>
          <h2 class="text-title-sm font-semibold text-ink mb-1">Need an exact discard date?</h2>
          <p class="text-body-md text-muted leading-relaxed">
            Enter when you cooked or opened a food item to calculate its exact USDA-backed throw-out date and countdown.
          </p>
        </div>
      </div>
      <a
        href="/tools/leftover-shelf-life-calculator/"
        class="shrink-0 inline-flex items-center justify-center gap-2 px-5 py-2.5 min-h-[44px] bg-primary text-on-primary text-[14px] font-medium rounded-lg hover:bg-primary-active transition-colors whitespace-nowrap"
      >
        <span>Leftover Shelf Life Calculator</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <!-- Header & Instant Search Bar -->
    <div class="border-b border-hairline pb-8 mb-10">
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
        <div>
          <h2 class="text-display-md text-ink tracking-tight mb-2">Tested Items ({howLongData.length})</h2>
          <p class="text-body-md text-muted">Real USDA-backed storage guidelines for everyday ingredients.</p>
        </div>
        
        <!-- Instant Food Search Bar -->
        <div class="w-full lg:max-w-[440px]">
          <div class="relative">
            <svg class="w-4 h-4 text-muted absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m0 0A7.5 7.5 0 1010.5 18a7.5 7.5 0 006.15-3.35z" />
            </svg>
            <input 
              type="text" 
              id="how-long-search"
              autocomplete="off"
              placeholder="Search foods or location (e.g. Chicken, Eggs, Freezer)..."
              aria-label="Search food shelf life guides"
              class="w-full h-11 pl-10 pr-10 py-2 bg-canvas text-ink text-[16px] md:text-[14px] border border-hairline rounded-md focus:outline-none focus:border-info-border shadow-xs"
            />
            <button
              type="button"
              id="how-long-clear"
              aria-label="Clear search"
              class="hidden absolute right-2 top-1/2 -translate-y-1/2 w-7 h-7 rounded-md text-muted hover:text-ink hover:bg-surface-soft inline-flex items-center justify-center transition-colors cursor-pointer"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>
          <p
            id="how-long-count"
            aria-live="polite"
            data-template="Showing {count} of {total} guides"
            class="mt-2 text-xs font-medium text-muted"
          >
            Showing {howLongData.length} of {howLongData.length} guides
          </p>
        </div>
      </div>
    </div>

    <!-- Items Grid -->
    <div id="items-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {howLongData.map(item => (
        <div 
          class="item-card bg-canvas border border-hairline rounded-md p-6 flex flex-col justify-between shadow-xs transition-all hover:border-border-strong"
          data-name={item.item.toLowerCase()}
          data-search={`${item.item} ${formatLocation(item.location)} ${item.location} ${item.duration} ${item.shortAnswer}`.toLowerCase()}
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-caption text-muted uppercase tracking-wider text-xs">{formatLocation(item.location)}</span>
              <span class="badge-time">LASTS {item.duration.toUpperCase()}</span>
            </div>
            
            <h3 class="text-title-sm text-ink mb-3">
              Can You Put {item.item} in the {formatLocation(item.location)}?
            </h3>
            
            <p class="text-body-md text-body leading-relaxed mb-6">
              {item.shortAnswer}
            </p>
          </div>
          
          <a 
            href={`/how-long/${item.slug}/`} 
            class="text-link text-[14px] font-medium hover:text-link-active transition-colors flex items-center gap-1 group mt-4"
          >
            Read storage details <span class="group-hover:translate-x-0.5 transition-transform">&rarr;</span>
          </a>
        </div>
      ))}
    </div>

    <!-- No results message -->
    <div id="no-results" class="hidden text-center py-12">
      <p class="text-title-md text-muted mb-4">No items match your search.</p>
      <button
        type="button"
        id="how-long-reset"
        class="px-4 py-2 min-h-[40px] bg-canvas text-ink text-[13px] font-medium border border-hairline hover:border-border-strong rounded-md transition-colors cursor-pointer"
      >
        Clear search
      </button>
    </div>
  </section>

  <!-- Related Categories Section -->
  <section class="border-t border-hairline bg-surface-soft/40 py-16">
    <div class="max-w-[1280px] mx-auto px-6">
      <h2 class="text-title-lg text-ink font-medium tracking-tight mb-8">Related Appliance & Safety Categories</h2>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
        <a href="/dishwasher/" class="p-5 bg-canvas border border-hairline rounded-md hover:border-border-strong shadow-xs text-decoration-none transition-colors active:scale-[0.98] block">
          <span class="text-xs uppercase tracking-wider text-muted font-bold block mb-1">Appliance Guide</span>
          <h3 class="text-title-sm text-ink mb-1 font-medium">Dishwasher</h3>
          <span class="text-xs text-link">Explore Guides &rarr;</span>
        </a>
        <a href="/microwave/" class="p-5 bg-canvas border border-hairline rounded-md hover:border-border-strong shadow-xs text-decoration-none transition-colors active:scale-[0.98] block">
          <span class="text-xs uppercase tracking-wider text-muted font-bold block mb-1">Appliance Guide</span>
          <h3 class="text-title-sm text-ink mb-1 font-medium">Microwave</h3>
          <span class="text-xs text-link">Explore Guides &rarr;</span>
        </a>
        <a href="/freezer/" class="p-5 bg-canvas border border-hairline rounded-md hover:border-border-strong shadow-xs text-decoration-none transition-colors active:scale-[0.98] block">
          <span class="text-xs uppercase tracking-wider text-muted font-bold block mb-1">Appliance Guide</span>
          <h3 class="text-title-sm text-ink mb-1 font-medium">Freezer</h3>
          <span class="text-xs text-link">Explore Guides &rarr;</span>
        </a>
        <a href="/oven/" class="p-5 bg-canvas border border-hairline rounded-md hover:border-border-strong shadow-xs text-decoration-none transition-colors active:scale-[0.98] block">
          <span class="text-xs uppercase tracking-wider text-muted font-bold block mb-1">Appliance Guide</span>
          <h3 class="text-title-sm text-ink mb-1 font-medium">Oven</h3>
          <span class="text-xs text-link">Explore Guides &rarr;</span>
        </a>
        <a href="/dryer/" class="p-5 bg-canvas border border-hairline rounded-md hover:border-border-strong shadow-xs text-decoration-none transition-colors active:scale-[0.98] block">
          <span class="text-xs uppercase tracking-wider text-muted font-bold block mb-1">Appliance Guide</span>
          <h3 class="text-title-sm text-ink mb-1 font-medium">Dryer</h3>
          <span class="text-xs text-link">Explore Guides &rarr;</span>
        </a>
        <a href="/airfryer/" class="p-5 bg-canvas border border-hairline rounded-md hover:border-border-strong shadow-xs text-decoration-none transition-colors active:scale-[0.98] block">
          <span class="text-xs uppercase tracking-wider text-muted font-bold block mb-1">Appliance Guide</span>
          <h3 class="text-title-sm text-ink mb-1 font-medium">Air Fryer</h3>
          <span class="text-xs text-link">Explore Guides &rarr;</span>
        </a>
        <a href="/refrigerator/" class="p-5 bg-canvas border border-hairline rounded-md hover:border-border-strong shadow-xs text-decoration-none transition-colors active:scale-[0.98] block">
          <span class="text-xs uppercase tracking-wider text-muted font-bold block mb-1">Appliance Guide</span>
          <h3 class="text-title-sm text-ink mb-1 font-medium">Refrigerator</h3>
          <span class="text-xs text-link">Explore Guides &rarr;</span>
        </a>
        
        <a href="/refreeze/" class="p-5 bg-canvas border border-hairline rounded-md hover:border-border-strong shadow-xs text-decoration-none transition-colors active:scale-[0.98] block">
          <span class="text-xs uppercase tracking-wider text-muted font-bold block mb-1">Freezer Safety</span>
          <h3 class="text-title-sm text-ink mb-1 font-medium">Refreezing Guides</h3>
          <span class="text-xs text-link">Explore Guides &rarr;</span>
        </a>
        <a href="/washing-machine/" class="p-5 bg-canvas border border-hairline rounded-md hover:border-border-strong shadow-xs text-decoration-none transition-colors active:scale-[0.98] block">
          <span class="text-xs uppercase tracking-wider text-muted font-bold block mb-1">Fabric & Clothes</span>
          <h3 class="text-title-sm text-ink mb-1 font-medium">Washing Machine Guides</h3>
          <span class="text-xs text-link">Explore Guides &rarr;</span>
        </a>
        <a href="/what-happens/" class="p-5 bg-canvas border border-hairline rounded-md hover:border-border-strong shadow-xs text-decoration-none transition-colors active:scale-[0.98] block">
          <span class="text-xs uppercase tracking-wider text-muted font-bold block mb-1">Emergency Checklist</span>
          <h3 class="text-title-sm text-ink mb-1 font-medium">What Happens If...</h3>
          <span class="text-xs text-link">Explore Guides &rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Client-side filtering script -->
  <script is:inline>
    (() => {
      const searchInput = document.getElementById('how-long-search');
      const clearBtn = document.getElementById('how-long-clear');
      const resetBtn = document.getElementById('how-long-reset');
      const countEl = document.getElementById('how-long-count');
      const itemsGrid = document.getElementById('items-grid');
      const noResults = document.getElementById('no-results');

      if (!searchInput || !itemsGrid) return;

      const cards = Array.from(itemsGrid.getElementsByClassName('item-card'));
      const total = cards.length;
      const template = (countEl && countEl.getAttribute('data-template')) || 'Showing {count} of {total} guides';

      const applyFilter = () => {
        const query = searchInput.value.trim().toLowerCase();
        let matches = 0;

        for (let i = 0; i < total; i++) {
          const card = cards[i];
          const haystack = card.getAttribute('data-search') || card.getAttribute('data-name') || '';

          if (!query || haystack.includes(query)) {
            card.classList.remove('hidden');
            matches++;
          } else {
            card.classList.add('hidden');
          }
        }

        if (clearBtn) {
          clearBtn.classList.toggle('hidden', query.length === 0);
        }

        if (countEl) {
          countEl.textContent = template
            .replace('{count}', String(matches))
            .replace('{total}', String(total));
        }

        if (noResults) {
          noResults.classList.toggle('hidden', matches > 0);
        }
      };

      searchInput.addEventListener('input', applyFilter);

      const clearSearch = () => {
        searchInput.value = '';
        applyFilter();
        searchInput.focus();
      };

      if (clearBtn) clearBtn.addEventListener('click', clearSearch);
      if (resetBtn) resetBtn.addEventListener('click', clearSearch);
    })();
  </script>
</Layout>
