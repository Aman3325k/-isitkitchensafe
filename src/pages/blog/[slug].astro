  recommendedToolKey = 'sousVidePouchDelamination';
} else if (/(thermos-zwilling|sekaer-macy|gourmia-kalorik|microwave-griller|cuisinart-grill|charbroil|ambiano|galanz-retro-fridge|frigidaire-range|kidisle-coffee-maker|balbali-kettle|2026-cpsc-recalls-guide|bodum-french-press|granitestone-pan|panasonic-toaster|2026-recalls-guide|recalled-air-fryer|cpsc-2026|door-latch|lid-ejection|recall)/.test(toolMatchSlug)) {
  recommendedToolKey = 'recallsScanner';
