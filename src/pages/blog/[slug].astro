---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import blogData from '../../data/blog.json';
import itemsData from '../../data/items.json';
import comparisonsData from '../../data/comparisons.json';
import { injectInlineLinks } from '../../utils/linkingHelper.js';
import { getDirectoryUrl, useTranslatedPath } from '../../i18n/utils';

export function getStaticPaths() {
  return blogData.map((article) => {
    return {
      params: {
        slug: article.slug
      },
      props: {
        article
      }
    };
  });
}

interface Props {
  article: typeof blogData[number];
}

const { article } = Astro.props;

// 1. Process inline linking (minimum 10 relevant item links)
const linksInjected = new Set<string>();
const linkCountRef = { count: 0 };

const itemsToMatch = itemsData.map(i => ({
  name: i.item,
  slug: i.slug,
  appliance: i.appliance,
  url: `/${i.appliance}/${i.slug}/`
})).sort((a, b) => b.name.length - a.name.length);

const linkedIntro = injectInlineLinks(article.intro, itemsToMatch, linksInjected, linkCountRef);
const linkedSections = article.sections.map(sec => {
  const linkedContent = injectInlineLinks(sec.content, itemsToMatch, linksInjected, linkCountRef);
  let linkedBoxText = sec.boxText;
  if (linkedBoxText) {
    linkedBoxText = injectInlineLinks(linkedBoxText, itemsToMatch, linksInjected, linkCountRef);
  }
  return {
    ...sec,
    content: linkedContent,
    boxText: linkedBoxText
  };
});
const linkedConclusion = injectInlineLinks(article.conclusion, itemsToMatch, linksInjected, linkCountRef);

// Fallback resources if inline matches are under 10
const fallbackGuides = [];
if (linkCountRef.count < 10) {
  const needed = 10 - linkCountRef.count;
  for (const item of itemsToMatch) {
    if (fallbackGuides.length >= needed) break;
    if (!linksInjected.has(item.url)) {
      fallbackGuides.push(item);
      linksInjected.add(item.url);
      linkCountRef.count++;
    }
  }
}

// 2. Select 3 related blog articles
const relatedArticles = blogData.filter(a => a.slug !== article.slug).slice(0, 3);

// 3. Select relevant comparisons
const relevantComparisons = comparisonsData.filter(c => 
  article.title.toLowerCase().includes(c.item1.toLowerCase()) || 
  article.title.toLowerCase().includes(c.item2.toLowerCase()) ||
  article.intro.toLowerCase().includes(c.item1.toLowerCase()) ||
  article.intro.toLowerCase().includes(c.item2.toLowerCase())
).slice(0, 3);

// SEO title and description
const pageTitle = `${article.title} | IsItKitchenSafe`;
const pageDescription = article.excerpt;

// Calculate realistic word count estimate
const fullText = [
  article.intro,
  ...article.sections.map(s => s.content + ' ' + (s.boxText || '')),
  article.conclusion
].join(' ');
const estimatedWordCount = fullText.split(/\s+/).filter(Boolean).length;

const canonicalUrl = `https://isitkitchensafe.com/blog/${article.slug}/`;

const blogPostingSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": article.title,
  "description": article.excerpt,
  "author": {
    "@type": "Organization",
    "name": "IsItKitchenSafe"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "logo": {
      "@type": "ImageObject",
      "url": "https://isitkitchensafe.com/og-image.png"
    }
  },
  "datePublished": article.date,
  "dateModified": "2026-09-12",
  "image": "https://isitkitchensafe.com/og-image.png",
  "wordCount": estimatedWordCount,
  "articleSection": "Kitchen Safety",
  "url": canonicalUrl
};

// Smart Contextual Interactive Calculator Recommendation
const translatePath = useTranslatedPath('en');
const methodologyUrl = getDirectoryUrl('methodology', 'en');
const contactUrl = getDirectoryUrl('contact', 'en');

const toolMatchContext = `${article.slug} ${article.title} ${(article as any).category || ''}`.toLowerCase();
type RecommendedToolKey =
  | 'descaling'
  | 'cleaner'
  | 'plastic'
  | 'airfryer'
  | 'microwave'
  | 'thawing'
  | 'cookingTemp'
  | 'leftover'
  | 'ovenTemp'
  | 'symbol';

let recommendedToolKey: RecommendedToolKey = 'symbol';
if (/\b(descal(?:e|ing)|coffee|kettles?|espresso)\b/i.test(toolMatchContext)) {
  recommendedToolKey = 'descaling';
} else if (/\b(bleach|vinegar|ammonia|peroxide|cleaners?)\b/i.test(toolMatchContext)) {
  recommendedToolKey = 'cleaner';
} else if (/\b(plastics?|microplastics?|resin|styrofoam|tupperware|ziploc)\b/i.test(toolMatchContext)) {
  recommendedToolKey = 'plastic';
} else if (/\b(air[- ]?fryer)\b/i.test(toolMatchContext)) {
  recommendedToolKey = 'airfryer';
} else if (/\b(microwave|watt(?:age|s)?)\b/i.test(toolMatchContext)) {
  recommendedToolKey = 'microwave';
} else if (/\b(turkey|thaw(?:ing)?|holiday|refreeze)\b/i.test(toolMatchContext)) {
  recommendedToolKey = 'thawing';
} else if (/\b(internal[- ]cooking|cooking[- ]temp(?:erature)?s?|meat|poultry)\b/i.test(toolMatchContext)) {
  recommendedToolKey = 'cookingTemp';
} else if (/\b(leftovers?|store|storage|fridge|refrigerat(?:e|ion|or)|freezer)\b/i.test(toolMatchContext)) {
  recommendedToolKey = 'leftover';
} else if (/\b(cookware|oven|hexclad|pyrex|nonstick|stainless|cast[- ]iron|carbon[- ]steel|caraway|lodge|le[- ]creuset|bakeware|skillet|pan)\b/i.test(toolMatchContext)) {
  recommendedToolKey = 'ovenTemp';
}

const toolCatalog: Record<RecommendedToolKey, {
  path: string;
  icon: string;
  title: string;
  description: string;
  cta: string;
}> = {
  cleaner: {
    path: '/tools/cleaner-mixing-danger-checker/',
    icon: '🧪',
    title: 'Kitchen Cleaner Mixing Danger Checker',
    description: 'Check two household cleaners before mixing to detect toxic chlorine gas, chloramine, or exothermic reaction hazards instantly.',
    cta: 'Check Cleaner Mix'
  },
  descaling: {
    path: '/tools/appliance-descaling-calculator/',
    icon: '☕',
    title: 'Coffee Maker & Kettle Descaling Ratio Calculator',
    description: 'Calculate exact citric acid or white vinegar descaling ratios and rinse cycles tailored to your coffee maker, espresso machine, or kettle.',
    cta: 'Calculate Descaling Ratio'
  },
  microwave: {
    path: '/tools/microwave-wattage-converter/',
    icon: '⏱️',
    title: 'Microwave Wattage & Cook Time Converter',
    description: 'Convert package heating times from 700W, 900W, 1000W, or 1100W to your exact microwave wattage to avoid cold spots and scorching.',
    cta: 'Convert Wattage'
  },
  plastic: {
    path: '/tools/plastic-code-checker/',
    icon: '♻️',
    title: 'Plastic Recycling Code #1–#7 Safety Checker',
    description: 'Look up any resin code #1–#7 (PET, HDPE, PVC, LDPE, PP, PS, Other) to verify microwave, dishwasher, freezer, and BPA/leaching safety.',
    cta: 'Check Plastic Code'
  },
  airfryer: {
    path: '/tools/air-fryer-oven-converter/',
    icon: '🔥',
    title: 'Air Fryer, Convection Oven & Gas Mark Converter',
    description: 'Convert any conventional oven recipe into safe air fryer temperature (°F/°C) and reduced cook time instantly to prevent burning.',
    cta: 'Convert Oven to Air Fryer'
  },
  thawing: {
    path: '/tools/meat-thawing-calculator/',
    icon: '❄️',
    title: 'USDA Meat & Turkey Safe Thawing Calculator',
    description: 'Calculate exact USDA refrigerator and cold-water thawing times by weight and cut so poultry, beef, pork, and seafood stay out of the danger zone.',
    cta: 'Calculate Thaw Time'
  },
  leftover: {
    path: '/tools/leftover-shelf-life-calculator/',
    icon: '🗓️',
    title: 'USDA Leftover & Fridge Shelf-Life Countdown Calculator',
    description: 'Enter when you cooked or opened an item to get its exact USDA refrigerator and freezer eat-by date for leftovers, dairy, meat, and produce.',
    cta: 'Check Shelf Life'
  },
  cookingTemp: {
    path: '/tools/internal-cooking-temp-chart/',
    icon: '🌡️',
    title: 'USDA Safe Internal Cooking Temp Chart',
    description: 'Check official USDA minimum internal temperatures (°F & °C) and required rest times for poultry, beef, pork, seafood, eggs, and casseroles.',
    cta: 'Check Safe Temps'
  },
  ovenTemp: {
    path: '/tools/cookware-oven-temp-lookup/',
    icon: '♨️',
    title: 'Cookware & Bakeware Safe Oven Temp Lookup',
    description: 'Check exact max safe oven and broiler temperature limits for Pyrex, glass, stoneware, cast iron, HexClad, Caraway, nonstick, stainless steel, and lids.',
    cta: 'Lookup Max Oven Temp'
  },
  symbol: {
    path: '/tools/kitchen-symbol-decoder/',
    icon: '🔍',
    title: 'Kitchen Bottom Symbol Decoder',
    description: 'Unsure about the icons stamped on the bottom of your container, tumbler, or cookware? Decode dishwasher, microwave, oven, and resin symbols instantly.',
    cta: 'Decode Bottom Symbols'
  }
};

const recommendedTool = toolCatalog[recommendedToolKey];
const recommendedToolUrl = translatePath(recommendedTool.path);
---

<Layout title={pageTitle} description={pageDescription} faqs={article.faqs} excludeArticleSchema={true} availableLocales={['en', 'es', 'pt', 'zh-cn', 'ja']} ogType="article">
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />
  <article class="max-w-[1280px] mx-auto px-6 py-12">
    <!-- Breadcrumbs -->
    <Breadcrumbs 
      items={[
        { label: 'Home', href: '/' },
        { label: 'Blog', href: '/blog/' },
        { label: article.title }
      ]}
    />

    <!-- Header Section -->
    <header class="max-w-[800px] mb-10">
      <span class="text-xs uppercase tracking-wider text-link font-bold block mb-2">Kitchen Safety Guide</span>
      <h1 class="text-3xl md:text-5xl font-bold text-ink tracking-tight mb-6 leading-tight">
        {article.title}
      </h1>
      
      <!-- Trust Signals and Metadata -->
      <div class="flex flex-wrap items-center gap-4 text-xs text-muted border-b border-hairline pb-5">
        <span>By <strong>{article.author}</strong></span>
        <span class="hidden sm:inline">•</span>
        <span>Published: <strong>{article.date}</strong></span>
        <span class="hidden sm:inline">•</span>
        <span>Read time: <strong>{article.readTime}</strong></span>
        <span class="hidden sm:inline">•</span>
        <a
          href={methodologyUrl}
          class="inline-flex items-center gap-1 text-success font-medium bg-success-bg border border-success-border/30 px-2.5 py-0.5 rounded-full hover:underline"
        >
          ✓ USDA FSIS / FDA / NSF Verified
        </a>
      </div>

      <!-- Quick-Share & Print Action Bar -->
      <div class="mt-4 flex flex-wrap items-center gap-2.5 no-print">
        <button
          id="copy-link-btn"
          type="button"
          aria-label="Copy link to this kitchen safety guide"
          data-default-text="Copy Link"
          data-copied-text="Link Copied"
          data-toast-text="Guide link copied to clipboard"
          class="min-h-[40px] px-3.5 py-2 bg-canvas hover:bg-surface-soft active:scale-[0.98] text-ink border border-hairline rounded-md text-xs font-medium inline-flex items-center gap-2 shadow-xs transition-all cursor-pointer"
        >
          <svg class="w-4 h-4 text-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
          </svg>
          <span id="copy-link-btn-text">Copy Link</span>
        </button>

        <button
          id="print-guide-btn"
          type="button"
          aria-label="Print this kitchen safety guide"
          class="min-h-[40px] px-3.5 py-2 bg-canvas hover:bg-surface-soft active:scale-[0.98] text-ink border border-hairline rounded-md text-xs font-medium inline-flex items-center gap-2 shadow-xs transition-all cursor-pointer"
        >
          <svg class="w-4 h-4 text-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4H7v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
          </svg>
          <span>Print Guide</span>
        </button>
      </div>
    </header>

    <!-- Main Grid Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-10">
      <!-- Left side: Main Article Content -->
      <div class="lg:col-span-3 flex flex-col gap-8 max-w-prose">
        <!-- Intro Paragraph -->
        <p class="text-[16px] md:text-[18px] text-body leading-relaxed font-normal" set:html={linkedIntro}></p>

        <!-- Sections -->
        {linkedSections.map((section) => (
          <section class="border-t border-hairline pt-8">
            <h2 class="text-2xl font-bold text-ink mb-4">{section.title}</h2>
            <p class="text-body-md text-body leading-relaxed mb-6" set:html={section.content}></p>

            <!-- Callout Box depending on type -->
            {section.boxText && (
              <div class={`p-5 rounded-md border text-[13.5px] leading-relaxed ${
                section.type === 'warning' ? 'bg-warning-bg border-warning-border/20 text-ink' :
                section.type === 'success' || section.type === 'fact' ? 'bg-success-bg border-success-border/20 text-ink' :
                'bg-surface-soft border-hairline text-ink'
              }`}>
                <div class="flex gap-2.5 items-start">
                  <span class="text-base leading-none">
                    {section.type === 'warning' ? '⚠️' :
                     section.type === 'success' || section.type === 'fact' ? '💡' : 'ℹ️'}
                  </span>
                  <div>
                    <strong class="block text-ink font-semibold mb-0.5">
                      {section.type === 'warning' ? 'Critical Warning' :
                       section.type === 'success' || section.type === 'fact' ? 'Science Fact' : 'Safety Tip'}
                    </strong>
                    <span set:html={section.boxText} />
                  </div>
                </div>
              </div>
            )}
          </section>
        ))}

        <!-- Fallback Guides Section (to guarantee 10-link minimum) -->
        {fallbackGuides.length > 0 && (
          <section class="border-t border-hairline pt-8">
            <div class="bg-surface-soft border border-hairline rounded-md p-6">
              <h3 class="text-title-sm text-ink font-medium mb-3">📖 Referenced Appliance Safety Guides</h3>
              <p class="text-body-md text-muted mb-4 text-[13.5px]">Learn more about kitchen and appliance safety rules for these related items:</p>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                {fallbackGuides.map(g => (
                  <a href={g.url} class="text-[13px] text-link hover:underline font-medium">
                    Can you put {g.name.toLowerCase()} in the {g.appliance === 'airfryer' ? 'air fryer' : g.appliance}? &rarr;
                  </a>
                ))}
              </div>
            </div>
          </section>
        )}

        <!-- Conclusion -->
        <section class="border-t border-hairline pt-8 bg-surface-soft/40 p-6 rounded-lg">
          <h2 class="text-2xl font-bold text-ink mb-4">Conclusion</h2>
          <p class="text-body-md text-body leading-relaxed" set:html={linkedConclusion}></p>
        </section>

        <!-- Smart Contextual Interactive Calculator CTA Card -->
        <section id="recommended-tool-card" class="bg-surface-soft border border-hairline rounded-lg p-5 sm:p-6 shadow-xs no-print">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-center gap-2 mb-1.5">
                <span class="text-base" aria-hidden="true">{recommendedTool.icon}</span>
                <span class="text-[11px] font-semibold uppercase tracking-wider text-signature-coral">Interactive Tool</span>
              </div>
              <h2 class="text-title-sm text-ink font-semibold mb-1.5 leading-snug">
                {recommendedTool.title}
              </h2>
              <p class="text-[13px] text-body leading-relaxed">
                {recommendedTool.description}
              </p>
            </div>
            <div class="shrink-0">
              <a
                href={recommendedToolUrl}
                class="min-h-[42px] px-4 py-2.5 bg-primary hover:bg-primary-active active:scale-[0.98] text-on-primary rounded-md text-xs font-medium inline-flex items-center gap-1.5 transition-all whitespace-nowrap"
              >
                <span>{recommendedTool.cta}</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </div>
        </section>

        <!-- E-E-A-T Verification & Citations Bar -->
        <section id="editorial-trust-bar" class="bg-surface-soft border border-hairline rounded-lg p-5 text-xs text-muted leading-relaxed">
          <div class="flex items-start gap-2.5 pb-3 border-b border-hairline">
            <svg class="w-4 h-4 text-success shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
            </svg>
            <div class="min-w-0 flex-1">
              <p class="text-ink font-medium text-[13px] leading-snug">
                Verified against USDA FSIS, FDA 21 CFR &amp; NSF kitchen safety standards
              </p>
              <div class="mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-[12px]">
                <a href={methodologyUrl} class="text-link hover:underline font-medium">
                  Read Safety Methodology &rarr;
                </a>
                <span class="text-hairline hidden sm:inline">•</span>
                <a href={contactUrl} class="text-muted hover:text-ink hover:underline">
                  Report a correction
                </a>
              </div>
            </div>
          </div>
          <p class="pt-3 text-[12px] text-muted">
            Recommendations cross-checked with USDA Food Safety and Inspection Service (FSIS), FDA food-contact regulations, NSF International guidelines, and OEM appliance manuals.
          </p>
        </section>

        <!-- FAQ Section -->
        <section class="border-t border-hairline pt-10">
          <h2 class="text-2xl md:text-3xl font-bold text-ink mb-6">Frequently Asked Questions</h2>
          <div class="flex flex-col">
            {article.faqs.map((faq) => (
              <details class="group border-b border-hairline py-4">
                <summary class="flex items-center justify-between text-title-sm text-ink font-medium cursor-pointer list-none [&::-webkit-details-marker]:hidden select-none">
                  <span>{faq.question}</span>
                  <span class="text-muted group-open:rotate-180 transition-transform duration-200">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                  </span>
                </summary>
                <div class="mt-3 text-body-md text-body leading-relaxed pl-1">
                  {faq.answer}
                </div>
              </details>
            ))}
          </div>
        </section>

        <!-- Back to Blog Navigation -->
        <div class="mt-8 pt-8 border-t border-hairline flex flex-wrap justify-between items-center gap-4">
          <a href="/blog/" class="text-link text-[14px] font-medium hover:text-link-active transition-colors min-h-[44px] inline-flex items-center gap-1.5 py-2 px-3 rounded-md hover:bg-surface-soft">
            &larr; Back to Safety Blog
          </a>
          <a href="/" class="text-link text-[14px] font-medium hover:text-link-active transition-colors min-h-[44px] inline-flex items-center gap-1.5 py-2 px-3 rounded-md hover:bg-surface-soft">
            Search Appliance Guides &rarr;
          </a>
        </div>
      </div>

      <!-- Right side: Sidebar -->
      <aside class="flex flex-col gap-8">
        <!-- Related Guides / Tools Link Box -->
        <div class="border border-hairline rounded-lg p-6 bg-canvas shadow-xs">
          <h3 class="text-title-sm text-ink font-bold mb-4">Related Safety Guides</h3>
          <ul class="flex flex-col gap-3">
            {article.relatedTools.map((tool) => (
              <li>
                <a 
                  href={tool.url.endsWith('/') ? tool.url : `${tool.url}/`} 
                  class="text-[13px] text-link hover:underline font-medium leading-normal block"
                >
                  {tool.name} &rarr;
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Relevant Comparisons Link Box -->
        {relevantComparisons.length > 0 && (
          <div class="border border-hairline rounded-lg p-6 bg-canvas shadow-xs">
            <h3 class="text-title-sm text-ink font-bold mb-4">Related Comparisons</h3>
            <ul class="flex flex-col gap-3">
              {relevantComparisons.map((c) => (
                <li>
                  <a 
                    href={`/compare/${c.slug}/`} 
                    class="text-[13px] text-link hover:underline font-medium leading-normal block"
                  >
                    {c.item1} vs {c.item2} Guide &rarr;
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Safety Policy Trust Signals -->
        <div class="border border-hairline rounded-lg p-6 bg-surface-soft">
          <h4 class="text-xs uppercase tracking-wider text-muted font-bold mb-2">Our Safety Policy</h4>
          <p class="text-xs text-muted leading-relaxed mb-3">
            Every guide is verified using standards from USDA FSIS, FDA 21 CFR, NSF International, and OEM manuals.
          </p>
          <a href={methodologyUrl} class="text-xs text-link hover:underline font-medium inline-flex items-center gap-1">
            <span>View Verification Methodology</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </aside>
    </div>

    <!-- Related Blog Articles Section -->
    <section class="border-t border-hairline pt-12 mt-12">
      <h2 class="text-2xl font-bold text-ink mb-8">Related Blog Articles</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {relatedArticles.map((art) => (
          <a 
            href={`/blog/${art.slug}/`} 
            class="group bg-canvas border border-hairline hover:border-border-strong rounded-lg p-6 flex flex-col justify-between shadow-xs transition-colors active:scale-[0.98]"
          >
            <div>
              <span class="text-caption text-muted text-xs block mb-2">{art.date}</span>
              <h3 class="text-title-sm text-ink font-bold mb-3 leading-snug group-hover:text-link transition-colors">
                {art.title}
              </h3>
              <p class="text-[13px] text-muted line-clamp-3 leading-relaxed">
                {art.excerpt}
              </p>
            </div>
            <span class="text-[12px] font-medium text-link mt-4 block">Read article &rarr;</span>
          </a>
        ))}
      </div>
    </section>
  </article>

  <!-- Accessible Copy-Link Toast -->
  <div
    id="copy-toast"
    role="status"
    aria-live="polite"
    class="fixed bottom-5 right-5 z-50 px-4 py-2.5 rounded-lg bg-surface-dark text-on-dark text-xs font-medium shadow-lg border border-hairline/20 opacity-0 translate-y-2 pointer-events-none transition-all duration-200 no-print"
  ></div>

  <script is:inline>
    (function() {
      var toastTimer = null;
      var btnTimer = null;

      function showToast(message) {
        var toast = document.getElementById('copy-toast');
        if (!toast) return;
        toast.textContent = message;
        toast.classList.remove('opacity-0', 'translate-y-2', 'pointer-events-none');
        toast.classList.add('opacity-100', 'translate-y-0');
        if (toastTimer) clearTimeout(toastTimer);
        toastTimer = setTimeout(function() {
          toast.classList.remove('opacity-100', 'translate-y-0');
          toast.classList.add('opacity-0', 'translate-y-2', 'pointer-events-none');
        }, 2500);
      }

      function fallbackCopy(text) {
        var ta = document.createElement('textarea');
        ta.value = text;
        ta.setAttribute('readonly', '');
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        var ok = false;
        try {
          ok = document.execCommand('copy');
        } catch (e) {}
        document.body.removeChild(ta);
        return ok;
      }

      function initArticleActions() {
        var copyBtn = document.getElementById('copy-link-btn');
        var copyBtnText = document.getElementById('copy-link-btn-text');
        if (copyBtn && copyBtnText) {
          copyBtn.onclick = async function() {
            var url = window.location.href;
            var defaultText = copyBtn.getAttribute('data-default-text') || 'Copy Link';
            var copiedText = copyBtn.getAttribute('data-copied-text') || 'Link Copied';
            var toastText = copyBtn.getAttribute('data-toast-text') || 'Link copied to clipboard';
            var copied = false;

            if (navigator.clipboard && navigator.clipboard.writeText) {
              try {
                await navigator.clipboard.writeText(url);
                copied = true;
              } catch (e) {
                copied = fallbackCopy(url);
              }
            } else {
              copied = fallbackCopy(url);
            }

            if (copied) {
              copyBtnText.textContent = '✓ ' + copiedText;
              copyBtn.classList.add('bg-success-bg', 'text-success', 'border-success-border/40');
              showToast(toastText);
              if (btnTimer) clearTimeout(btnTimer);
              btnTimer = setTimeout(function() {
                copyBtnText.textContent = defaultText;
                copyBtn.classList.remove('bg-success-bg', 'text-success', 'border-success-border/40');
              }, 2500);
            }
          };
        }

        var printBtn = document.getElementById('print-guide-btn');
        if (printBtn) {
          printBtn.onclick = function() {
            window.print();
          };
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initArticleActions);
      } else {
        initArticleActions();
      }
      document.addEventListener('astro:page-load', initArticleActions);
    })();
  </script>
</Layout>
