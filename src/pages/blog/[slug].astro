  | 'moldyFood'
  | 'pantry'
  | 'allergy'
  | 'dishwasherDosage'
  | 'induction'
  | 'ovenRack'
  | 'castIron'
  | 'powerOutage'
  | 'babyBottle'
  | 'oilSmokePoint'
  | 'fridgeZone'
  | 'cleaner'
  | 'descaling'
  | 'plastic'
  | 'airfryer'
  | 'microwave'
  | 'thawing'
  | 'cookingTemp'
  | 'leftover'
  | 'ovenTemp'
  | 'microwaveSteam'
  | 'airFryerLiner'
  | 'plasticLeaching'
  | 'panScratch'
  | 'aluminumFoilLeaching'
  | 'siliconeBakeware'
  | 'airFryerTeflon'
  | 'copperCookware'
  | 'melamineFormaldehyde'
  | 'microwavePopcornPfas'
