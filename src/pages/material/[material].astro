    description: 'Calculate safe air fryer and oven heat settings when baking with parchment paper, liners, or heat-sensitive materials.',
    cta: 'Convert Cooking Temp'
  },
  microwaveWattage: {
    path: '/tools/microwave-wattage-converter/',
    icon: '📡',
