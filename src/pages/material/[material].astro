    description: 'Adjust heating times to your microwave wattage (600W–1250W) to avoid overheating containers or uneven cold spots.',
    cta: 'Convert Wattage Time'
  },
  powerOutage: {
    path: '/tools/power-outage-food-safety-checker/',
