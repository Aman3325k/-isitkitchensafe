---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TechnicalSpecs from '../../components/TechnicalSpecs.astro';
import { CATEGORIES, getCategoryItemsAndStats } from '../../utils/materialCategories';
import { getDirectoryUrl, useTranslatedPath } from '../../i18n/utils';

export function getStaticPaths() {
  return CATEGORIES.map(cat => ({
    params: { material: cat.id },
    props: { categoryId: cat.id }
  }));
}

interface Props {
  categoryId: string;
}

const { categoryId } = Astro.props;

const stats = getCategoryItemsAndStats(categoryId);
if (!stats) {
  throw new Error(`Invalid material category: ${categoryId}`);
}

const { category, totalItemsTested, safePercentage, mostCommonRisk, items } = stats;

const pageTitle = `${category.displayName} Safety Guide | IsItKitchenSafe`;
const pageDescription = `Are ${category.displayName} items safe in the dishwasher, microwave, oven, or freezer? View safety stats, risks, and a full safety comparison table for ${totalItemsTested} items.`;


const isWashingBased = categoryId === 'fabric' || categoryId === 'footwear';
const columns = isWashingBased 
  ? [
      { id: 'washing-machine', label: 'Washing Machine' },
      { id: 'dryer', label: 'Dryer' }
    ]
  : [
      { id: 'dishwasher', label: 'Dishwasher' },
      { id: 'microwave', label: 'Microwave' },
      { id: 'oven', label: 'Oven' },
      { id: 'freezer', label: 'Freezer' }
    ];

// Generate dynamic cross-linking links
const relatedMaterials = category.relatedIds
  .map(id => CATEGORIES.find(c => c.id === id))
  .filter((c): c is typeof CATEGORIES[number] => c !== undefined);

// Upgraded Schema markup
const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": `Appliance Safety Comparison for ${category.displayName}`,
  "description": `Detailed safety guidelines and comparisons for ${category.displayName} items.`,
  "numberOfItems": items.length,
  "itemListElement": items.map((item, idx) => ({
    "@type": "ListItem",
    "position": idx + 1,
    "item": {
      "@type": "Thing",
      "name": item.name,
      "url": `https://isitkitchensafe.com${Object.values(item.appliances)[0]?.url || ''}`,
      "additionalProperty": Object.entries(item.appliances).map(([appName, appInfo]) => ({
        "@type": "PropertyValue",
        "name": `${appName}Safe`,
        "value": appInfo.safe.toUpperCase()
      }))
    }
  }))
};

const breadcrumbListSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://isitkitchensafe.com"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Materials",
      "item": "https://isitkitchensafe.com/material/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": category.displayName,
      "item": `https://isitkitchensafe.com/material/${category.id}/`
    }
  ]
};

// E-E-A-T links & Smart 25-Tool Contextual Consumer Calculator CTA
const translatePath = useTranslatedPath('en');
const methodologyUrl = getDirectoryUrl('methodology', 'en');
const contactUrl = getDirectoryUrl('contact', 'en');

type RecommendedToolKey =
  | 'kitchenFire'
  | 'instantPot'
  | 'slowCooker'
  | 'knifeCare'
  | 'foodAllergy'
  | 'dishwasherDosage'
  | 'induction'
  | 'castIron'
  | 'ovenRack'
  | 'moldyFood'
  | 'pantry'
  | 'fridgeZone'
  | 'oilSmokePoint'
  | 'babyBottle'
  | 'cleaner'
  | 'descaling'
  | 'plastic'
  | 'airfryer'
  | 'microwaveWattage'
  | 'powerOutage'
  | 'leftover'
  | 'thawing'
  | 'cookingTemp'
  | 'ovenTemp'
  | 'symbol';

function selectMaterialToolPair(materialIdRaw: string): { primary: RecommendedToolKey; secondary: RecommendedToolKey } {
  const k = String(materialIdRaw || '').toLowerCase();

  if (/(cast-iron|carbon-steel|enameled-cast)/.test(k)) {
    return { primary: 'castIron', secondary: 'induction' };
  }
  if (/(copper|induction|ferromagnetic)/.test(k)) {
    return { primary: 'induction', secondary: 'ovenTemp' };
  }
  if (/(baby|kids|infant|nursery)/.test(k)) {
    return { primary: 'babyBottle', secondary: 'plastic' };
  }
  if (/(instant-pot|pressure-cooker)/.test(k)) {
    return { primary: 'instantPot', secondary: 'dishwasherDosage' };
  }
  if (/(slow-cooker|crock-pot)/.test(k)) {
    return { primary: 'slowCooker', secondary: 'ovenTemp' };
  }
  if (/(knife|knives|cutting-board|wood-paper|wood|bamboo)/.test(k)) {
    return { primary: 'knifeCare', secondary: 'kitchenFire' };
  }
  if (/(glass-ceramic|glass|pyrex|ceramic|stoneware|porcelain|terracotta)/.test(k)) {
    return { primary: 'ovenRack', secondary: 'ovenTemp' };
  }
  if (/(silicone)/.test(k)) {
    return { primary: 'ovenRack', secondary: 'dishwasherDosage' };
  }
  if (/(plastic|melamine|styrofoam|acrylic|resin|polymer)/.test(k)) {
    return { primary: 'plastic', secondary: 'babyBottle' };
  }
  if (/(metal|stainless|aluminum|non-?stick|enamel)/.test(k)) {
    return { primary: 'ovenTemp', secondary: 'induction' };
  }
  if (/(appliance-components|appliance|coffee|kettle|espresso)/.test(k)) {
    return { primary: 'dishwasherDosage', secondary: 'descaling' };
  }
  if (/(paper|parchment|cardboard|foil|fire)/.test(k)) {
    return { primary: 'kitchenFire', secondary: 'airfryer' };
  }
  if (/(allergen|sponge|toaster)/.test(k)) {
    return { primary: 'foodAllergy', secondary: 'cleaner' };
  }
  if (/(oil|grease|fat|butter)/.test(k)) {
    return { primary: 'oilSmokePoint', secondary: 'kitchenFire' };
  }
  if (/(mold|mould)/.test(k)) {
    return { primary: 'moldyFood', secondary: 'leftover' };
  }
  if (/(pantry|canned|dry-goods|spice)/.test(k)) {
    return { primary: 'pantry', secondary: 'fridgeZone' };
  }
  if (/(fridge|refrigerator|produce)/.test(k)) {
    return { primary: 'fridgeZone', secondary: 'powerOutage' };
  }
  if (/(freezer|frozen|thaw)/.test(k)) {
    return { primary: 'thawing', secondary: 'powerOutage' };
  }
  if (/(meat|poultry|seafood|protein)/.test(k)) {
    return { primary: 'cookingTemp', secondary: 'thawing' };
  }
  if (/(leftover)/.test(k)) {
    return { primary: 'leftover', secondary: 'microwaveWattage' };
  }
  if (/(air-?fryer)/.test(k)) {
    return { primary: 'airfryer', secondary: 'ovenRack' };
  }
  if (/(microwave)/.test(k)) {
    return { primary: 'microwaveWattage', secondary: 'symbol' };
  }
  if (/(fabric|footwear|textile|laundry|cleaner)/.test(k)) {
    return { primary: 'symbol', secondary: 'cleaner' };
  }
  return { primary: 'symbol', secondary: 'ovenTemp' };
}

const toolCatalog: Record<RecommendedToolKey, {
