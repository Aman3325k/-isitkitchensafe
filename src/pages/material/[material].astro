    title: 'Cookware Maximum Oven Temperature Lookup',
    description: 'Verify safe oven, broiler, and glass lid temperature ceilings for metal, glass, ceramic, cast iron, and nonstick cookware.',
    cta: 'Check Oven Temp Limit'
  },
  symbol: {
    path: '/tools/kitchen-symbol-decoder/',
    icon: '🔍',
    title: 'Kitchen & Cookware Safety Symbol Decoder',
