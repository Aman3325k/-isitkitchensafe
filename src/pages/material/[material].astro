    cta: 'Adjust Oven Rack & Temp'
  },
  moldyFood: {
    path: '/tools/moldy-food-safety-checker/',
    icon: '🧀',
    title: 'USDA Moldy Food Cut-Around vs. Throw-Out Safety Checker',
    description: 'Follow official USDA FSIS rules for bread, cheese, berries, and deli meats to know when trimming is safe or disposal is mandatory.',
    cta: 'Check Mold Safety'
  },
  pantry: {
    path: '/tools/pantry-dry-goods-shelf-life-checker/',
    icon: '🫙',
    title: 'Pantry, Spices & Dry Goods Shelf-Life & Safety Lookup',
    description: 'Check USDA & FMI storage rules for dented cans, honey, rancid oils, spices, flour, and dry staples.',
    cta: 'Check Pantry Safety'
  },
  fridgeZone: {
    path: '/tools/fridge-organization-zone-planner/',
