---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { CATEGORIES, getCategoryItemsAndStats } from '../../utils/materialCategories';

const pageTitle = "Kitchen Appliance Safety by Material Type | IsItKitchenSafe";
const pageDescription = "Are your kitchen items dishwasher, microwave, oven, or freezer safe? Browse safety guides and statistics by material type: metal, plastic, silicone, glass, and more.";

// pre-compile stats for the 8 categories to show item counts
const categoriesWithStats = CATEGORIES.map(cat => {
  const stats = getCategoryItemsAndStats(cat.id);
  return {
    ...cat,
    itemCount: stats ? stats.totalItemsTested : 0
  };
});
---

<Layout title={pageTitle} description={pageDescription} availableLocales={['en', 'es', 'pt', 'zh-cn', 'ja']}>
  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs 
        items={[
          { label: 'Home', href: '/' },
          { label: 'Materials' }
        ]}
        className="mb-0"
      />
    </div>
  </div>

  <section class="max-w-[1280px] mx-auto px-6 py-[80px] md:py-[96px]">
    <!-- Header -->
    <header class="max-w-[800px] mb-12">
      <span class="text-caption text-muted uppercase tracking-wider text-xs block mb-2">Material Directories</span>
      <h1 class="text-display-lg md:text-display-xl font-medium text-ink tracking-tight mb-4">
        Kitchen Appliance Safety by Material Type
      </h1>
      <p class="text-body-md text-muted text-lg leading-relaxed">
        Select a material category below to access dynamic safety statistics, common appliance risks, and complete safety reference tables for all kitchen items.
      </p>
    </header>

    <!-- Special Investigation Banner -->
    <div class="mb-12 bg-surface-soft border border-hairline rounded-lg p-6 md:p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <div class="max-w-[750px]">
        <div class="flex flex-wrap items-center gap-2 mb-3">
          <span class="inline-block px-2.5 py-0.5 rounded text-[11px] font-bold uppercase tracking-wider bg-signature-coral text-white">Special Investigation</span>
          <span class="text-xs text-muted">Microplastics &amp; PTFE Safety Review</span>
        </div>
        <h2 class="text-title-md md:text-title-lg font-semibold text-ink tracking-tight mb-2">
          Can You Use Scratched Non-Stick Cookware?
        </h2>
        <p class="text-[14px] text-body leading-relaxed">
          Grounded in the landmark 2022 Flinders University Raman spectroscopy research (9,100+ microplastics shed per scratch) and FDA 21 CFR 175.300 standards. Check our 4-grade pan scratch triage scale.
        </p>
      </div>
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5">
        <a 
          href="/tools/pan-scratch-inspector/" 
          class="inline-flex items-center justify-center whitespace-nowrap px-4 py-2.5 rounded-full bg-signature-coral text-white font-medium text-xs hover:bg-black transition-colors shadow-xs"
        >
          📷 Scan Pan with AI
        </a>
        <a 
          href="/material/scratched-nonstick-cookware/" 
          class="inline-flex items-center justify-center whitespace-nowrap px-4 py-2.5 rounded-full bg-ink text-white font-medium text-xs hover:bg-black transition-colors"
        >
          Read Full Guide &rarr;
        </a>
      </div>
    </div>

    <!-- Categories Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      {categoriesWithStats.map(cat => {
        const isDark = cat.styling.includes('text-white');
        return (
          <a 
            href={`/material/${cat.id}/`} 
            class={`${cat.styling} border rounded-lg p-8 flex flex-col justify-between min-h-[220px] shadow-sm transition-transform active:scale-[0.98]`}
          >
            <div>
              <span class={`text-[11px] uppercase tracking-wider font-bold block mb-2 ${isDark ? 'text-white/75' : 'text-muted'}`}>
                {cat.itemCount} Items Checked
              </span>
              <h2 class={`text-title-lg font-medium tracking-tight mb-3 ${isDark ? 'text-white' : 'text-ink'}`}>
                {cat.displayName}
              </h2>
              <p class={`text-[13px] leading-relaxed mb-6 ${isDark ? 'text-white/85' : 'text-body'}`}>
                {cat.description}
              </p>
            </div>
            <span class={`text-[13px] font-medium underline underline-offset-4 flex items-center gap-1 ${isDark ? 'text-white' : 'text-link'}`}>
              Explore guides &rarr;
            </span>
          </a>
        );
      })}
    </div>
  </section>
</Layout>
