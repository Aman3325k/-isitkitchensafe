---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { CATEGORIES, getCategoryItemsAndStats } from '../../utils/materialCategories';

const pageTitle = "Kitchen Appliance Safety by Material Type | IsItKitchenSafe";
const pageDescription = "Are your kitchen items dishwasher, microwave, oven, or freezer safe? Browse safety guides and statistics by material type: metal, plastic, silicone, glass, and more.";

// pre-compile stats for the 8 categories to show item counts
const categoriesWithStats = CATEGORIES.map(cat => {
  const stats = getCategoryItemsAndStats(cat.id);
  return {
    ...cat,
    itemCount: stats ? stats.totalItemsTested : 0
  };
});
---

<Layout title={pageTitle} description={pageDescription} availableLocales={['en', 'es', 'pt', 'zh-cn', 'ja']}>
  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs 
        items={[
          { label: 'Home', href: '/' },
          { label: 'Materials' }
        ]}
        className="mb-0"
      />
    </div>
  </div>

  <section class="max-w-[1280px] mx-auto px-6 py-[80px] md:py-[96px]">
    <!-- Header -->
    <header class="max-w-[800px] mb-12">
      <span class="text-caption text-muted uppercase tracking-wider text-xs block mb-2">Material Directories</span>
      <h1 class="text-display-lg md:text-display-xl font-medium text-ink tracking-tight mb-4">
        Kitchen Appliance Safety by Material Type
      </h1>
      <p class="text-body-md text-muted text-lg leading-relaxed">
        Select a material category below to access dynamic safety statistics, common appliance risks, and complete safety reference tables for all kitchen items.
      </p>
    </header>

    <!-- Interactive Tools Spotlight Strip -->
    <div class="mb-8 rounded-lg border border-hairline bg-surface-soft/80 p-5 md:p-6 flex flex-col lg:flex-row lg:items-center justify-between gap-5 shadow-xs">
      <div class="flex items-start gap-4 max-w-[680px]">
        <div class="w-10 h-10 rounded-md bg-signature-teal text-white flex items-center justify-center shrink-0 mt-0.5" aria-hidden="true">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23-.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5" />
          </svg>
        </div>
        <div>
          <span class="inline-block text-[11px] font-bold uppercase tracking-wider text-info mb-1">Interactive Material Tools</span>
          <h2 class="text-title-sm font-semibold text-ink mb-1">Checking oven limits or plastic numbers?</h2>
          <p class="text-body-md text-muted leading-relaxed">
            Instantly look up max oven temperatures for cookware brands and coatings, or decode recycling resin numbers (#1–#7) for microwave and dishwasher safety.
          </p>
        </div>
      </div>
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5 shrink-0">
        <a
          href="/tools/cookware-oven-temp-lookup/"
          class="inline-flex items-center justify-center gap-1.5 px-4 py-2.5 min-h-[44px] bg-primary text-on-primary text-[13px] font-medium rounded-lg hover:bg-primary-active transition-colors whitespace-nowrap"
        >
          <span>Cookware Oven Temp Lookup</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
        <a
          href="/tools/plastic-code-checker/"
          class="inline-flex items-center justify-center gap-1.5 px-4 py-2.5 min-h-[44px] bg-canvas text-ink text-[13px] font-medium border border-hairline hover:border-border-strong rounded-lg transition-colors whitespace-nowrap"
        >
          <span>Plastic Code Checker (#1–#7)</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>

    <!-- Special Investigation Banner -->
    <div class="mb-10 bg-surface-soft border border-hairline rounded-lg p-6 md:p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <div class="max-w-[750px]">
        <div class="flex flex-wrap items-center gap-2 mb-3">
          <span class="inline-block px-2.5 py-0.5 rounded text-[11px] font-bold uppercase tracking-wider bg-signature-coral text-white">Special Investigation</span>
          <span class="text-xs text-muted">Microplastics &amp; PTFE Safety Review</span>
        </div>
        <h2 class="text-title-md md:text-title-lg font-semibold text-ink tracking-tight mb-2">
          Can You Use Scratched Non-Stick Cookware?
        </h2>
        <p class="text-[14px] text-body leading-relaxed">
          Grounded in the landmark 2022 Flinders University Raman spectroscopy research (9,100+ microplastics shed per scratch) and FDA 21 CFR 175.300 standards. Check our 4-grade pan scratch triage scale.
        </p>
      </div>
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5">
        <a 
          href="/tools/pan-scratch-inspector/" 
          class="inline-flex items-center justify-center whitespace-nowrap px-4 py-2.5 rounded-full bg-signature-coral text-white font-medium text-xs hover:bg-black transition-colors shadow-xs"
        >
          📷 Scan Pan with AI
        </a>
        <a 
          href="/material/scratched-nonstick-cookware/" 
          class="inline-flex items-center justify-center whitespace-nowrap px-4 py-2.5 rounded-full bg-ink text-white font-medium text-xs hover:bg-black transition-colors"
        >
          Read Full Guide &rarr;
        </a>
      </div>
    </div>

    <!-- Instant Material Search Bar -->
    <div class="border-b border-hairline pb-6 mb-8 flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <h2 class="text-title-lg font-medium text-ink tracking-tight mb-1">
          Browse Material Categories ({categoriesWithStats.length})
        </h2>
        <p class="text-body-md text-muted">
          Filter categories by material name, sub-material, or kitchen risk.
        </p>
      </div>
      <div class="w-full md:max-w-[420px]">
        <div class="relative">
          <svg class="w-4 h-4 text-muted absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m0 0A7.5 7.5 0 1010.5 18a7.5 7.5 0 006.15-3.35z" />
          </svg>
          <input
            type="text"
            id="material-search"
            autocomplete="off"
            placeholder="Search materials (e.g. silicone, cast iron, bamboo, glass)..."
            aria-label="Search material categories"
            class="w-full h-11 pl-10 pr-10 py-2 bg-canvas text-ink text-[16px] md:text-[14px] border border-hairline rounded-md focus:outline-none focus:border-info-border shadow-xs"
          />
          <button
            type="button"
            id="material-clear"
            aria-label="Clear search"
            class="hidden absolute right-2 top-1/2 -translate-y-1/2 w-7 h-7 rounded-md text-muted hover:text-ink hover:bg-surface-soft inline-flex items-center justify-center transition-colors cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        <p
          id="material-count"
          aria-live="polite"
          data-template="Showing {count} of {total} material categories"
          class="mt-2 text-xs font-medium text-muted"
        >
          Showing {categoriesWithStats.length} of {categoriesWithStats.length} material categories
        </p>
      </div>
    </div>

    <!-- Categories Grid -->
    <div id="material-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      {categoriesWithStats.map(cat => {
        const isDark = cat.styling.includes('text-white');
        const searchIndex = `${cat.displayName} ${cat.description} ${cat.id} ${(cat.rawMaterials || []).join(' ')}`.toLowerCase();
        return (
          <a 
            href={`/material/${cat.id}/`} 
            data-search={searchIndex}
            class={`material-card ${cat.styling} border rounded-lg p-8 flex flex-col justify-between min-h-[220px] shadow-sm transition-transform active:scale-[0.98]`}
          >
            <div>
              <span class={`text-[11px] uppercase tracking-wider font-bold block mb-2 ${isDark ? 'text-white/75' : 'text-muted'}`}>
                {cat.itemCount} Items Checked
              </span>
              <h2 class={`text-title-lg font-medium tracking-tight mb-3 ${isDark ? 'text-white' : 'text-ink'}`}>
                {cat.displayName}
              </h2>
              <p class={`text-[13px] leading-relaxed mb-6 ${isDark ? 'text-white/85' : 'text-body'}`}>
                {cat.description}
              </p>
            </div>
            <span class={`text-[13px] font-medium underline underline-offset-4 flex items-center gap-1 ${isDark ? 'text-white' : 'text-link'}`}>
              Explore guides &rarr;
            </span>
          </a>
        );
      })}
    </div>

    <!-- Empty State -->
    <div id="material-no-results" class="hidden text-center py-12">
      <p class="text-title-md text-muted mb-4">No material categories match your search.</p>
      <button
        type="button"
        id="material-reset"
        class="px-4 py-2 min-h-[40px] bg-canvas text-ink text-[13px] font-medium border border-hairline hover:border-border-strong rounded-md transition-colors cursor-pointer"
      >
        Reset search
      </button>
    </div>
  </section>

  <!-- Client-side Material Search Script -->
  <script is:inline>
    (() => {
      const searchInput = document.getElementById('material-search');
      const clearBtn = document.getElementById('material-clear');
      const resetBtn = document.getElementById('material-reset');
      const countEl = document.getElementById('material-count');
      const grid = document.getElementById('material-grid');
      const noResults = document.getElementById('material-no-results');

      if (!searchInput || !grid) return;

      const cards = Array.from(grid.getElementsByClassName('material-card'));
      const total = cards.length;
      const template = (countEl && countEl.getAttribute('data-template')) || 'Showing {count} of {total} material categories';

      const applyFilter = () => {
        const query = searchInput.value.trim().toLowerCase();
        let matches = 0;

        for (let i = 0; i < total; i++) {
          const card = cards[i];
          const haystack = card.getAttribute('data-search') || '';
          if (!query || haystack.includes(query)) {
            card.classList.remove('hidden');
            matches++;
          } else {
            card.classList.add('hidden');
          }
        }

        if (clearBtn) {
          clearBtn.classList.toggle('hidden', query.length === 0);
        }

        if (countEl) {
          countEl.textContent = template
            .replace('{count}', String(matches))
            .replace('{total}', String(total));
        }

        if (noResults) {
          noResults.classList.toggle('hidden', matches > 0);
        }
      };

      searchInput.addEventListener('input', applyFilter);

      const clearSearch = () => {
        searchInput.value = '';
        applyFilter();
        searchInput.focus();
      };

      if (clearBtn) clearBtn.addEventListener('click', clearSearch);
      if (resetBtn) resetBtn.addEventListener('click', clearSearch);
    })();
  </script>
</Layout>
