---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import type { SupportedLanguage } from '../i18n/ui';
import { useTranslatedPath } from '../i18n/utils';

const lang: SupportedLanguage = 'en';
const availableLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'zh-cn', 'ja'];
const translatePath = useTranslatedPath(lang);

const pageTitle = 'My Saved Kitchen Safety Cheat Sheet | IsItKitchenSafe';
const pageDescription =
  'Build, filter, download as a 1080×1440 PNG, copy, or print your personalized 1-page refrigerator kitchen safety cheat sheet with curated 1-click starter packs.';

interface StarterPackItem {
  slug: string;
  appliance: string;
  name: string;
  safe: 'yes' | 'depends' | 'no';
  url: string;
}

interface StarterPack {
  id: string;
  title: string;
  shortTitle: string;
  description: string;
  badgeText: string;
  items: StarterPackItem[];
}

interface QuickLinkItem {
  label: string;
  href: string;
  desc: string;
}

interface ConsumerToolLink {
  label: string;
  badge: string;
  href: string;
  desc: string;
}

const starterPacks: StarterPack[] = [
  {
    id: 'dishwasher-essentials',
    title: 'Everyday Dishwasher Essentials',
    shortTitle: 'Dishwasher Essentials',
    description: 'The 6 most-asked cookware & container dishwasher rules — safe glass, tricky baskets, and hand-wash-only staples.',
    badgeText: '6 Dishwasher Rules',
    items: [
      { slug: 'pyrex-dish', appliance: 'dishwasher', name: 'Pyrex Dish', safe: 'yes', url: translatePath('/dishwasher/pyrex-dish/') },
      { slug: 'silicone-spatula', appliance: 'dishwasher', name: 'Silicone Spatula', safe: 'yes', url: translatePath('/dishwasher/silicone-spatula/') },
      { slug: 'air-fryer-basket', appliance: 'dishwasher', name: 'Air Fryer Basket', safe: 'depends', url: translatePath('/dishwasher/air-fryer-basket/') },
      { slug: 'plastic-container', appliance: 'dishwasher', name: 'Plastic Container', safe: 'depends', url: translatePath('/dishwasher/plastic-container/') },
      { slug: 'cast-iron-skillet', appliance: 'dishwasher', name: 'Cast Iron Skillet', safe: 'no', url: translatePath('/dishwasher/cast-iron-skillet/') },
      { slug: 'wooden-cutting-board', appliance: 'dishwasher', name: 'Wooden Cutting Board', safe: 'no', url: translatePath('/dishwasher/wooden-cutting-board/') }
    ]
  },
  {
    id: 'airfryer-microwave-rules',
    title: 'Air Fryer & Microwave Rules',
    shortTitle: 'Air Fryer & Microwave',
    description: 'Liners, wraps, mugs, and foil hazards so nobody starts a spark or grease fire during weeknight reheating.',
    badgeText: '6 Heating Rules',
    items: [
      { slug: 'reusable-silicone-liner', appliance: 'airfryer', name: 'Reusable Silicone Liner', safe: 'yes', url: translatePath('/airfryer/reusable-silicone-liner/') },
      { slug: 'parchment-paper', appliance: 'airfryer', name: 'Parchment Paper', safe: 'depends', url: translatePath('/airfryer/parchment-paper/') },
      { slug: 'wax-paper', appliance: 'airfryer', name: 'Wax Paper', safe: 'no', url: translatePath('/airfryer/wax-paper/') },
      { slug: 'ceramic-mug', appliance: 'microwave', name: 'Ceramic Mug', safe: 'yes', url: translatePath('/microwave/ceramic-mug/') },
      { slug: 'plastic-wrap', appliance: 'microwave', name: 'Plastic Wrap', safe: 'depends', url: translatePath('/microwave/plastic-wrap/') },
      { slug: 'aluminum-foil', appliance: 'microwave', name: 'Aluminum Foil', safe: 'no', url: translatePath('/microwave/aluminum-foil/') }
    ]
  },
  {
    id: 'fridge-freezer-food-safety',
    title: 'Fridge & Freezer Food Safety',
    shortTitle: 'Fridge & Freezer',
    description: 'Essential cold-storage rules for raw poultry, produce that hates the cold, dairy freezing, and egg safety.',
    badgeText: '6 Cold-Storage Rules',
    items: [
      { slug: 'raw-chicken-breast', appliance: 'refrigerator', name: 'Raw Chicken Breast', safe: 'yes', url: translatePath('/refrigerator/raw-chicken-breast/') },
      { slug: 'tomatoes', appliance: 'refrigerator', name: 'Tomatoes', safe: 'depends', url: translatePath('/refrigerator/tomatoes/') },
      { slug: 'potatoes', appliance: 'refrigerator', name: 'Potatoes', safe: 'no', url: translatePath('/refrigerator/potatoes/') },
      { slug: 'milk', appliance: 'freezer', name: 'Milk', safe: 'yes', url: translatePath('/freezer/milk/') },
      { slug: 'cheese', appliance: 'freezer', name: 'Cheese', safe: 'depends', url: translatePath('/freezer/cheese/') },
      { slug: 'hard-boiled-eggs', appliance: 'freezer', name: 'Hard Boiled Eggs', safe: 'no', url: translatePath('/freezer/hard-boiled-eggs/') }
    ]
  }
];

const quickStartLinks: QuickLinkItem[] = [
  { label: 'Dishwasher Guides', href: '/dishwasher/', desc: 'Bottles, wood, cast iron, plastics & cookware' },
  { label: 'Microwave Guides', href: '/microwave/', desc: 'Containers, foil, ceramics & reheating rules' },
  { label: 'Air Fryer Guides', href: '/airfryer/', desc: 'Parchment paper, foil, silicone & bakeware' },
  { label: 'Freezer Guides', href: '/freezer/', desc: 'Glass jars, dairy, meat & food storage safety' },
  { label: 'Kitchen Symbol Decoder', href: translatePath('/tools/kitchen-symbol-decoder/'), desc: 'Decode bottom stamps on containers & cookware' },
  { label: 'Safety Methodology', href: '/methodology/', desc: 'How we verify YES, NO & DEPENDS verdicts' }
];

const consumerToolsStrip: ConsumerToolLink[] = [
  {
    label: 'Kitchen Symbol Decoder',
    badge: 'Symbols',
    href: translatePath('/tools/kitchen-symbol-decoder/'),
    desc: 'Decode bottom icons & plastic resin codes on containers and pans'
  },
  {
    label: 'Fridge Zone Planner',
    badge: 'Cold Storage',
    href: translatePath('/tools/fridge-organization-zone-planner/'),
    desc: 'Map USDA shelf zones, drip safety & crisper humidity'
  },
  {
    label: 'Power Outage Safety Checker',
    badge: 'Emergency',
    href: translatePath('/tools/power-outage-food-safety-checker/'),
    desc: 'Check what to keep or toss after a fridge or freezer outage'
  },
  {
    label: 'Internal Cooking Temp Chart',
    badge: 'USDA Temps',
    href: translatePath('/tools/internal-cooking-temp-chart/'),
    desc: 'Safe minimum °F / °C temperatures for meat, poultry & leftovers'
  }
];

const savedCanonicalDisplayUrl = 'https://isitkitchensafe.com/saved/';
---

<Layout
  title={pageTitle}
  description={pageDescription}
  noindex={true}
  excludeFaqSchema={true}
  excludeArticleSchema={true}
  availableLocales={availableLocales}
  lang={lang}
>
  <Fragment slot="head">
    <style is:inline>
      .print-only-header,
      .print-only-footer {
        display: none;
      }

      @media print {
        @page {
          size: letter portrait;
          margin: 0.45in;
        }

        header,
        nav,
        footer,
        #cookie-consent-banner,
        #back-to-top-container,
        .no-print {
          display: none !important;
        }

        body {
          background: #ffffff !important;
          color: #111827 !important;
          font-size: 9.5pt !important;
          line-height: 1.3 !important;
        }

        #saved-cheat-sheet-page {
          max-width: 100% !important;
          padding: 0 !important;
          margin: 0 !important;
        }

        .print-only-header {
          display: flex !important;
          align-items: center;
          justify-content: space-between;
          border-bottom: 2px solid #181d26;
          padding-bottom: 8px;
          margin-bottom: 12px;
        }

        .print-only-footer {
          display: flex !important;
          align-items: center;
          justify-content: space-between;
          border-top: 1px solid #d1d5db;
          padding-top: 6px;
          margin-top: 14px;
          font-size: 8pt;
          color: #4b5563;
        }

        #saved-groups-container {
          display: grid !important;
          grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
          gap: 10px !important;
          align-items: start !important;
        }

        .verdict-group-card {
          break-inside: avoid;
          border: 1.5px solid #181d26 !important;
          border-radius: 6px !important;
          padding: 8px !important;
          background: #ffffff !important;
          box-shadow: none !important;
        }

        .verdict-group-header {
          padding-bottom: 6px !important;
          margin-bottom: 6px !important;
          border-bottom: 1px solid #d1d5db !important;
        }

        .saved-item-row {
          padding: 5px 4px !important;
          border-bottom: 1px dotted #d1d5db !important;
          background: transparent !important;
          border-left: none !important;
          border-right: none !important;
          border-top: none !important;
          border-radius: 0 !important;
        }

        .saved-item-row:last-child {
          border-bottom: none !important;
        }

        .saved-item-link {
          color: #111827 !important;
          text-decoration: none !important;
          font-weight: 600 !important;
          font-size: 9pt !important;
        }

        .saved-item-appliance {
          font-size: 7.5pt !important;
          color: #374151 !important;
          border: 1px solid #9ca3af !important;
          padding: 1px 4px !important;
        }
      }
    </style>
  </Fragment>

  <section id="saved-cheat-sheet-page" class="max-w-[960px] mx-auto px-6 py-[48px] md:py-[64px]">
    <!-- Breadcrumbs (screen only) -->
    <div class="no-print">
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/' },
          { label: 'Saved Cheat Sheet' }
        ]}
      />
    </div>

    <!-- Print-Only Fridge Sheet Header -->
    <div class="print-only-header">
      <div>
        <div style="font-size: 14pt; font-weight: 700; color: #181d26;">
          ✓ My Kitchen Safety Fridge Cheat Sheet
        </div>
        <div style="font-size: 8.5pt; color: #4b5563;">
          Quick-reference appliance compatibility chart • Verified against USDA FSIS, FDA 21 CFR &amp; OEM care manuals
        </div>
      </div>
      <div style="text-align: right;">
        <div style="font-size: 10pt; font-weight: 700; color: #181d26;">isitkitchensafe.com</div>
        <div id="print-date-stamp" style="font-size: 8pt; color: #4b5563;"></div>
      </div>
    </div>

    <!-- Screen Header -->
    <header class="mb-8 pb-6 border-b border-hairline no-print">
      <div class="flex flex-col gap-5">
        <div>
          <span class="text-caption text-signature-coral font-semibold uppercase tracking-wider text-xs block mb-2">
            Custom Fridge Cheat Sheet Builder
          </span>
          <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-3 leading-tight">
            My Saved Kitchen Safety Cheat Sheet
          </h1>
          <p class="text-body-md text-body leading-relaxed max-w-2xl">
            Load a 1-click starter pack or pin any guide on IsItKitchenSafe. Everything stays privately in your browser — download a shareable 1080×1440 PNG fridge card, copy as plain text, or print a clean 1-page sheet.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-2.5">
          <button
            id="download-png-btn"
            type="button"
            disabled
            class="min-h-[44px] px-4 py-2.5 bg-primary hover:bg-primary-active active:scale-[0.98] text-on-primary rounded-lg text-sm font-medium inline-flex items-center gap-2 shadow-xs transition-all cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed"
          >
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            <span>Download Fridge PNG</span>
          </button>

          <button
            id="copy-text-btn"
            type="button"
            disabled
            class="min-h-[44px] px-4 py-2.5 bg-canvas hover:bg-surface-soft active:scale-[0.98] text-ink border border-hairline hover:border-border-strong rounded-lg text-sm font-medium inline-flex items-center gap-2 transition-all cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed"
          >
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
            <span>Copy Plain Text</span>
          </button>

          <button
            id="print-cheat-sheet-btn"
            type="button"
            disabled
            class="min-h-[44px] px-4 py-2.5 bg-canvas hover:bg-surface-soft active:scale-[0.98] text-ink border border-hairline hover:border-border-strong rounded-lg text-sm font-medium inline-flex items-center gap-2 transition-all cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed"
          >
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4H7v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
            </svg>
            <span>Print 1-Page Fridge Sheet</span>
          </button>
        </div>
      </div>
    </header>

    <!-- Summary Metrics, Appliance Filter & Compact Starter Pack Bar (shown when items exist) -->
    <div id="saved-controls-bar" class="hidden mb-8 no-print">
      <div class="bg-surface-soft border border-hairline rounded-lg p-4 md:p-5 flex flex-col gap-4">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div class="flex flex-wrap items-center gap-2 text-xs">
            <span class="font-semibold text-ink">Saved Items: <strong id="total-saved-count">0</strong></span>
            <span class="text-hairline">|</span>
            <span class="badge-yes px-2.5 py-0.5 text-[11px]">✓ YES: <span id="yes-saved-count" class="ml-1">0</span></span>
            <span class="badge-depends px-2.5 py-0.5 text-[11px]">⚠ DEPENDS: <span id="depends-saved-count" class="ml-1">0</span></span>
            <span class="badge-no px-2.5 py-0.5 text-[11px]">✗ NO: <span id="no-saved-count" class="ml-1">0</span></span>
          </div>

          <button
            id="clear-all-saved-btn"
            type="button"
            class="min-h-[36px] px-3 py-1.5 text-xs font-medium text-error hover:bg-error-bg border border-error/30 rounded-md transition-colors cursor-pointer"
          >
            Clear All Saved
          </button>
        </div>

        <div class="border-t border-hairline pt-3.5 flex flex-wrap items-center gap-2">
          <span class="text-xs font-medium text-muted mr-1">Filter by Appliance:</span>
          <div id="appliance-filter-pills" class="flex flex-wrap gap-2" role="group" aria-label="Filter saved items by appliance"></div>
        </div>

        <!-- Compact "+ Add Starter Pack" Bar -->
        <div class="border-t border-hairline pt-3.5 flex flex-wrap items-center gap-2">
          <span class="text-xs font-semibold text-ink mr-1">+ Add Starter Pack:</span>
          <div class="flex flex-wrap gap-2" role="group" aria-label="Add curated starter packs">
            {starterPacks.map((pack) => (
              <button
                type="button"
                data-starter-pack-btn={pack.id}
                data-compact-pack="true"
                class="min-h-[34px] px-3 py-1 rounded-full text-xs font-medium bg-canvas text-ink hover:border-border-strong hover:bg-surface-strong/30 border border-hairline inline-flex items-center gap-1.5 transition-colors cursor-pointer"
              >
                <span data-pack-icon aria-hidden="true">+</span>
                <span>{pack.shortTitle}</span>
                <span data-pack-status class="text-[11px] text-muted">({pack.items.length})</span>
              </button>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Saved Items Grouped by Verdict -->
    <div id="saved-groups-container" class="hidden grid grid-cols-1 lg:grid-cols-3 gap-6 mb-10" aria-live="polite">
      <!-- YES Group -->
      <section class="verdict-group-card bg-surface-soft border border-hairline rounded-lg p-5 flex flex-col" data-verdict-group="yes">
        <div class="verdict-group-header flex items-center justify-between pb-3 mb-3 border-b border-hairline">
          <div class="flex items-center gap-2">
            <span class="badge-yes px-3 py-1 text-xs">✓ YES — SAFE</span>
          </div>
          <span id="group-count-yes" class="text-xs font-mono text-muted">0</span>
        </div>
        <ul id="saved-list-yes" class="flex flex-col gap-2.5 list-none p-0 m-0"></ul>
      </section>

      <!-- DEPENDS Group -->
      <section class="verdict-group-card bg-surface-soft border border-hairline rounded-lg p-5 flex flex-col" data-verdict-group="depends">
        <div class="verdict-group-header flex items-center justify-between pb-3 mb-3 border-b border-hairline">
          <div class="flex items-center gap-2">
            <span class="badge-depends px-3 py-1 text-xs">⚠ DEPENDS — CAREFUL</span>
          </div>
          <span id="group-count-depends" class="text-xs font-mono text-muted">0</span>
        </div>
        <ul id="saved-list-depends" class="flex flex-col gap-2.5 list-none p-0 m-0"></ul>
      </section>

      <!-- NO Group -->
      <section class="verdict-group-card bg-surface-soft border border-hairline rounded-lg p-5 flex flex-col" data-verdict-group="no">
        <div class="verdict-group-header flex items-center justify-between pb-3 mb-3 border-b border-hairline">
          <div class="flex items-center gap-2">
            <span class="badge-no px-3 py-1 text-xs">✗ NO — AVOID</span>
          </div>
          <span id="group-count-no" class="text-xs font-mono text-muted">0</span>
        </div>
        <ul id="saved-list-no" class="flex flex-col gap-2.5 list-none p-0 m-0"></ul>
      </section>
    </div>

    <!-- Empty State with 3 Curated 1-Click Starter Packs -->
    <div id="saved-empty-state" class="bg-surface-soft border border-hairline rounded-lg p-6 md:p-10 no-print">
      <div class="text-center max-w-xl mx-auto mb-8">
        <div class="w-12 h-12 rounded-full bg-canvas border border-hairline flex items-center justify-center mx-auto mb-4 text-ink">
          <svg class="w-6 h-6 text-signature-coral" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
          </svg>
        </div>
        <h2 class="text-title-md text-ink font-semibold mb-2">Build Your Fridge Cheat Sheet in 1 Click</h2>
        <p class="text-body-md text-muted leading-relaxed">
          Start immediately by loading a curated household starter pack below, or click <strong class="text-ink font-medium">"Save Guide"</strong> on any item safety page to pin your own cookware and foods.
        </p>
      </div>

      <!-- 3 Curated 1-Click Starter Packs -->
      <div class="mb-8">
        <div class="flex items-center justify-between gap-2 mb-3">
          <h3 class="text-xs font-semibold uppercase tracking-wider text-signature-coral">
            1-Click Curated Starter Packs
          </h3>
          <span class="text-xs text-muted">Each pack includes Safe, Caution &amp; Avoid rules</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-left">
          {starterPacks.map((pack) => (
            <div class="bg-canvas border border-hairline rounded-lg p-5 flex flex-col justify-between gap-4 shadow-2xs">
              <div>
                <div class="flex items-center justify-between gap-2 mb-2">
                  <span class="text-[11px] font-semibold uppercase tracking-wider text-signature-coral">
                    {pack.badgeText}
                  </span>
                  <span class="text-[11px] text-muted font-mono">2 ✓ · 2 ⚠ · 2 ✗</span>
                </div>
                <h4 class="text-base font-semibold text-ink mb-1.5 leading-snug">{pack.title}</h4>
                <p class="text-xs text-muted leading-relaxed mb-3">{pack.description}</p>
                <div class="flex flex-wrap gap-1.5">
                  {pack.items.map((item) => (
                    <span class="inline-flex items-center gap-1 text-[11px] px-2 py-0.5 rounded bg-surface-soft border border-hairline text-body">
                      <span aria-hidden="true">{item.safe === 'yes' ? '✓' : item.safe === 'no' ? '✗' : '⚠'}</span>
                      <span>{item.name}</span>
                    </span>
                  ))}
                </div>
              </div>

              <button
                type="button"
                data-starter-pack-btn={pack.id}
                class="w-full min-h-[40px] px-4 py-2 bg-primary hover:bg-primary-active active:scale-[0.98] text-on-primary rounded-md text-xs font-semibold inline-flex items-center justify-center gap-1.5 transition-all cursor-pointer"
              >
                <span data-pack-icon aria-hidden="true">+</span>
                <span data-pack-label>Add 6-Item Starter Pack</span>
              </button>
            </div>
          ))}
        </div>
      </div>

      <!-- Browse Guides Fallback -->
      <div class="border-t border-hairline pt-6">
        <p class="text-xs font-semibold uppercase tracking-wider text-muted text-center mb-4">
          Or Browse Individual Safety Guides
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 text-left max-w-4xl mx-auto">
          {quickStartLinks.map((link) => (
            <a
              href={link.href}
              class="bg-canvas border border-hairline hover:border-border-strong rounded-md p-4 flex flex-col justify-between transition-colors shadow-2xs"
            >
              <div>
                <span class="text-ink font-semibold text-[14px] block mb-1">{link.label}</span>
                <span class="text-xs text-muted leading-relaxed block">{link.desc}</span>
              </div>
              <span class="text-xs font-medium text-link mt-3 inline-block">Explore &rarr;</span>
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Quick-Jump Consumer Tools Strip (screen only) -->
    <section class="mt-10 bg-surface-soft border border-hairline rounded-lg p-5 md:p-6 no-print" aria-labelledby="consumer-tools-strip-heading">
      <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
        <div>
          <span class="text-[11px] font-semibold uppercase tracking-wider text-signature-coral block mb-0.5">
            Free Interactive Tools
          </span>
          <h2 id="consumer-tools-strip-heading" class="text-base font-semibold text-ink">
            Pair Your Fridge Cheat Sheet with Quick Kitchen Checkers
          </h2>
        </div>
        <a href={translatePath('/tools/')} class="text-xs font-semibold text-link hover:underline">
          All Kitchen Tools &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        {consumerToolsStrip.map((tool) => (
          <a
            href={tool.href}
            class="bg-canvas border border-hairline hover:border-border-strong rounded-md p-4 flex flex-col justify-between transition-colors shadow-2xs"
          >
            <div>
              <span class="inline-block text-[10px] font-semibold uppercase tracking-wider px-2 py-0.5 rounded bg-surface-soft border border-hairline text-muted mb-2">
                {tool.badge}
              </span>
              <span class="text-ink font-semibold text-[14px] block mb-1 leading-snug">{tool.label}</span>
              <span class="text-xs text-muted leading-relaxed block">{tool.desc}</span>
            </div>
            <span class="text-xs font-medium text-link mt-3 inline-block">Open Tool &rarr;</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Tip Banner (screen only) -->
    <div class="mt-6 bg-surface-soft border border-hairline rounded-md p-4 text-xs text-muted flex flex-wrap items-center justify-between gap-3 no-print">
      <span>
        Saved guides stay locally on this device via browser storage (no account required). Want to know how each verdict is verified?
      </span>
      <a href="/methodology/" class="text-link hover:underline font-semibold shrink-0">
        Read our Verification Methodology &rarr;
      </a>
    </div>

    <!-- Accessible Status Toast (screen only) -->
    <div
      id="saved-toast"
      role="status"
      aria-live="polite"
      aria-atomic="true"
      class="no-print fixed bottom-5 right-5 z-50 max-w-sm bg-surface-dark text-on-dark border border-border-strong/40 rounded-lg px-4 py-3 text-sm font-medium shadow-lg pointer-events-none opacity-0 translate-y-2 transition-all duration-200"
    ></div>

    <!-- Print-Only Fridge Footer -->
    <div class="print-only-footer">
      <span>Generated at <strong>{savedCanonicalDisplayUrl}</strong> • Always verify manufacturer bottom symbols before heating.</span>
      <span>IsItKitchenSafe Editorial Standards</span>
    </div>
  </section>

  <script is:inline define:vars={{ lang, starterPacks, savedCanonicalDisplayUrl }}>
    (function () {
      var STORAGE_KEY = 'kitchen_saved_items';
      var MAX_PNG_ITEMS = 16;
      var activeApplianceFilter = 'all';
      var toastTimer = null;

      var APPLIANCE_LABELS = {
        dishwasher: 'Dishwasher',
        microwave: 'Microwave',
        freezer: 'Freezer',
        oven: 'Oven',
        airfryer: 'Air Fryer',
        refrigerator: 'Refrigerator',
        dryer: 'Dryer',
        'washing-machine': 'Washing Machine'
      };

      var VERDICT_ORDER = { yes: 0, depends: 1, no: 2 };

      function showToast(message) {
        var toast = document.getElementById('saved-toast');
        if (!toast || !message) return;
        toast.textContent = message;
        toast.classList.remove('opacity-0', 'translate-y-2');
        toast.classList.add('opacity-100', 'translate-y-0');
        if (toastTimer) clearTimeout(toastTimer);
        toastTimer = setTimeout(function () {
          toast.classList.remove('opacity-100', 'translate-y-0');
          toast.classList.add('opacity-0', 'translate-y-2');
        }, 3200);
      }

      function formatApplianceName(app) {
        if (!app) return 'Kitchen';
        var key = String(app).toLowerCase();
        if (APPLIANCE_LABELS[key]) return APPLIANCE_LABELS[key];
        return key
          .split('-')
          .map(function (w) {
            return w ? w.charAt(0).toUpperCase() + w.slice(1) : '';
          })
          .join(' ');
      }

      function formatSlugAsName(slug) {
        if (!slug) return 'Saved Item';
        return String(slug)
          .split('-')
          .map(function (w) {
            return w ? w.charAt(0).toUpperCase() + w.slice(1) : '';
          })
          .join(' ');
      }

      function ensureSafeRelativeUrl(url, fallbackPath) {
        var raw = String(url || '').trim();
        if (!raw || raw.indexOf(':') !== -1 || raw.indexOf('//') === 0) {
          raw = fallbackPath;
        }
        if (raw.charAt(0) !== '/') {
          raw = '/' + raw;
        }
        return raw.charAt(raw.length - 1) === '/' ? raw : raw + '/';
      }

      function normalizeItem(raw) {
        if (!raw || typeof raw !== 'object') return null;
        var slug = String(raw.slug || '').trim();
        var appliance = String(raw.appliance || '').trim().toLowerCase();
        var name = String(raw.name || raw.item || formatSlugAsName(slug)).trim();
        var safeRaw = String(raw.safe || 'depends').trim().toLowerCase();
        var safe = safeRaw === 'yes' || safeRaw === 'no' ? safeRaw : 'depends';
        var fallbackPath = '/' + (appliance || 'dishwasher') + '/' + (slug ? slug + '/' : '');
        var url = ensureSafeRelativeUrl(raw.url, fallbackPath);

        return {
          slug: slug,
          name: name,
          item: name,
          appliance: appliance,
          safe: safe,
          url: url,
          timestamp: raw.timestamp || 0
        };
      }

      function readSavedItems() {
        try {
          var parsed = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
          if (!Array.isArray(parsed)) return [];
          return parsed.map(normalizeItem).filter(Boolean);
        } catch (e) {
          return [];
        }
      }

      function writeSavedItems(items) {
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(items));
        } catch (e) {}
      }

      function getFilteredSortedItems(allItems) {
        var filtered =
          activeApplianceFilter === 'all'
            ? allItems.slice()
            : allItems.filter(function (entry) {
                return entry.appliance === activeApplianceFilter;
              });

        filtered.sort(function (a, b) {
          if (b.timestamp !== a.timestamp) return (b.timestamp || 0) - (a.timestamp || 0);
          return a.name.localeCompare(b.name);
        });
        return filtered;
      }

      function removeSavedItem(slug, appliance) {
        var items = readSavedItems().filter(function (entry) {
          return !(entry.slug === slug && entry.appliance === appliance);
        });
        writeSavedItems(items);
        renderSavedSheet();
      }

      function applyStarterPack(packId) {
        var pack = null;
        for (var i = 0; i < starterPacks.length; i++) {
          if (starterPacks[i].id === packId) {
            pack = starterPacks[i];
            break;
          }
        }
        if (!pack || !Array.isArray(pack.items)) return;

        var existing = readSavedItems();
        var seen = {};
        existing.forEach(function (entry) {
          seen[entry.appliance + '::' + entry.slug] = true;
        });

        var addedCount = 0;
        var baseTime = Date.now();
        pack.items.forEach(function (item, idx) {
          var key = item.appliance + '::' + item.slug;
          if (seen[key]) return;
          seen[key] = true;
          existing.push({
            slug: item.slug,
            name: item.name,
            item: item.name,
            appliance: item.appliance,
            safe: item.safe,
            url: ensureSafeRelativeUrl(item.url, '/' + item.appliance + '/' + item.slug + '/'),
            timestamp: baseTime - idx
          });
          addedCount++;
        });

        if (addedCount > 0) {
          writeSavedItems(existing);
          activeApplianceFilter = 'all';
          renderSavedSheet();
          if (addedCount === pack.items.length) {
            showToast('Added ' + addedCount + ' items from "' + pack.title + '"!');
          } else {
            showToast('Added ' + addedCount + ' new items from "' + pack.title + '" (duplicates skipped).');
          }
        } else {
          showToast('All ' + pack.items.length + ' items from "' + pack.title + '" are already saved.');
        }
      }

      function updateStarterPackButtons(allItems) {
        var seen = {};
        allItems.forEach(function (entry) {
          seen[entry.appliance + '::' + entry.slug] = true;
        });

        var buttons = document.querySelectorAll('[data-starter-pack-btn]');
        buttons.forEach(function (btn) {
          var packId = btn.getAttribute('data-starter-pack-btn');
          var pack = null;
          for (var i = 0; i < starterPacks.length; i++) {
            if (starterPacks[i].id === packId) {
              pack = starterPacks[i];
              break;
            }
          }
          if (!pack) return;

          var savedInPack = 0;
          pack.items.forEach(function (item) {
            if (seen[item.appliance + '::' + item.slug]) savedInPack++;
          });
          var isComplete = savedInPack === pack.items.length;
          var iconEl = btn.querySelector('[data-pack-icon]');
          var statusEl = btn.querySelector('[data-pack-status]');
          var labelEl = btn.querySelector('[data-pack-label]');

          if (btn.getAttribute('data-compact-pack') === 'true') {
            if (iconEl) iconEl.textContent = isComplete ? '✓' : '+';
            if (statusEl) {
              statusEl.textContent = isComplete
                ? '(Added)'
                : savedInPack > 0
                  ? '(+' + (pack.items.length - savedInPack) + ')'
                  : '(' + pack.items.length + ')';
            }
            btn.setAttribute('aria-pressed', isComplete ? 'true' : 'false');
          } else {
            if (iconEl) iconEl.textContent = isComplete ? '✓' : '+';
            if (labelEl) {
              labelEl.textContent = isComplete
                ? 'All ' + pack.items.length + ' Items Added'
                : 'Add ' + (pack.items.length - savedInPack) + '-Item Starter Pack';
            }
          }
        });
      }

      function createItemElement(entry) {
        var li = document.createElement('li');
        li.className =
          'saved-item-row bg-canvas border border-hairline rounded-md p-3 flex items-start justify-between gap-2.5 transition-colors hover:border-border-strong';

        var infoWrap = document.createElement('div');
        infoWrap.className = 'min-w-0 flex-1';

        var link = document.createElement('a');
        link.href = entry.url;
        link.className = 'saved-item-link text-[14px] font-medium text-ink hover:text-link hover:underline block break-words leading-snug';
        link.textContent = entry.name;

        var metaRow = document.createElement('div');
        metaRow.className = 'mt-1.5 flex flex-wrap items-center gap-1.5';

        var appBadge = document.createElement('span');
        appBadge.className =
          'saved-item-appliance inline-flex items-center text-[11px] font-medium text-muted bg-surface-soft border border-hairline px-2 py-0.5 rounded';
        appBadge.textContent = formatApplianceName(entry.appliance);

        metaRow.appendChild(appBadge);
        infoWrap.appendChild(link);
        infoWrap.appendChild(metaRow);

        var removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className =
          'no-print shrink-0 w-7 h-7 rounded flex items-center justify-center text-muted hover:text-error hover:bg-error-bg transition-colors cursor-pointer';
        removeBtn.setAttribute('aria-label', 'Remove ' + entry.name + ' (' + formatApplianceName(entry.appliance) + ')');
        removeBtn.title = 'Remove from cheat sheet';
        removeBtn.textContent = '✕';
        removeBtn.onclick = function () {
          removeSavedItem(entry.slug, entry.appliance);
        };

        li.appendChild(infoWrap);
        li.appendChild(removeBtn);
        return li;
      }

      function renderApplianceFilters(allItems) {
        var container = document.getElementById('appliance-filter-pills');
        if (!container) return;
        container.textContent = '';

        var counts = {};
        allItems.forEach(function (entry) {
          var app = entry.appliance || 'other';
          counts[app] = (counts[app] || 0) + 1;
        });

        var appliances = Object.keys(counts).sort();
        if (activeApplianceFilter !== 'all' && !counts[activeApplianceFilter]) {
          activeApplianceFilter = 'all';
        }

        function makePill(value, label, count) {
          var btn = document.createElement('button');
          btn.type = 'button';
          var isActive = activeApplianceFilter === value;
          btn.className = isActive
            ? 'min-h-[34px] px-3 py-1 rounded-full text-xs font-semibold bg-primary text-on-primary border border-primary cursor-pointer transition-colors'
            : 'min-h-[34px] px-3 py-1 rounded-full text-xs font-medium bg-canvas text-ink hover:bg-surface-strong/40 border border-hairline cursor-pointer transition-colors';
          btn.textContent = label + ' (' + count + ')';
          btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
          btn.onclick = function () {
            activeApplianceFilter = value;
            renderSavedSheet();
          };
          return btn;
        }

        container.appendChild(makePill('all', 'All Appliances', allItems.length));
        appliances.forEach(function (app) {
          container.appendChild(makePill(app, formatApplianceName(app), counts[app]));
        });
      }

      function renderSavedSheet() {
        var allItems = readSavedItems();
        var controlsBar = document.getElementById('saved-controls-bar');
        var groupsContainer = document.getElementById('saved-groups-container');
        var emptyState = document.getElementById('saved-empty-state');
        var printBtn = document.getElementById('print-cheat-sheet-btn');
        var downloadBtn = document.getElementById('download-png-btn');
        var copyBtn = document.getElementById('copy-text-btn');
        var dateStamp = document.getElementById('print-date-stamp');

        if (dateStamp) {
          try {
            dateStamp.textContent = 'Printed ' + new Date().toLocaleDateString();
          } catch (e) {}
        }

        updateStarterPackButtons(allItems);

        var hasItems = allItems.length > 0;
        if (printBtn) printBtn.disabled = !hasItems;
        if (downloadBtn) downloadBtn.disabled = !hasItems;
        if (copyBtn) copyBtn.disabled = !hasItems;

        if (!hasItems) {
          if (controlsBar) controlsBar.classList.add('hidden');
          if (groupsContainer) groupsContainer.classList.add('hidden');
          if (emptyState) emptyState.classList.remove('hidden');
          return;
        }

        if (controlsBar) controlsBar.classList.remove('hidden');
        if (groupsContainer) groupsContainer.classList.remove('hidden');
        if (emptyState) emptyState.classList.add('hidden');

        renderApplianceFilters(allItems);

        var filtered = getFilteredSortedItems(allItems);
        var grouped = { yes: [], depends: [], no: [] };
        filtered.forEach(function (entry) {
          grouped[entry.safe].push(entry);
        });

        var totalEl = document.getElementById('total-saved-count');
        var yesCountEl = document.getElementById('yes-saved-count');
        var dependsCountEl = document.getElementById('depends-saved-count');
        var noCountEl = document.getElementById('no-saved-count');

        if (totalEl) totalEl.textContent = String(filtered.length);
        if (yesCountEl) yesCountEl.textContent = String(grouped.yes.length);
        if (dependsCountEl) dependsCountEl.textContent = String(grouped.depends.length);
        if (noCountEl) noCountEl.textContent = String(grouped.no.length);

        ['yes', 'depends', 'no'].forEach(function (verdict) {
          var listEl = document.getElementById('saved-list-' + verdict);
          var countEl = document.getElementById('group-count-' + verdict);
          if (countEl) countEl.textContent = String(grouped[verdict].length);
          if (!listEl) return;
          listEl.textContent = '';

          if (grouped[verdict].length === 0) {
            var emptyLi = document.createElement('li');
            emptyLi.className = 'text-xs text-muted italic py-3 px-1';
            emptyLi.textContent = 'No items in this category.';
            listEl.appendChild(emptyLi);
            return;
          }

          grouped[verdict].forEach(function (entry) {
            listEl.appendChild(createItemElement(entry));
          });
        });
      }

      // --- Zero-Dependency 1080x1440 PNG Canvas Exporter ---
      function drawRoundRect(ctx, x, y, w, h, r) {
        var radius = Math.min(r, w / 2, h / 2);
        ctx.beginPath();
        ctx.moveTo(x + radius, y);
        ctx.lineTo(x + w - radius, y);
        ctx.quadraticCurveTo(x + w, y, x + w, y + radius);
        ctx.lineTo(x + w, y + h - radius);
        ctx.quadraticCurveTo(x + w, y + h, x + w - radius, y + h);
        ctx.lineTo(x + radius, y + h);
        ctx.quadraticCurveTo(x, y + h, x, y + h - radius);
        ctx.lineTo(x, y + radius);
        ctx.quadraticCurveTo(x, y, x + radius, y);
        ctx.closePath();
      }

      function isCjkChar(ch) {
        var code = ch.charCodeAt(0);
        return (
          (code >= 0x3000 && code <= 0x303f) ||
          (code >= 0x3040 && code <= 0x309f) ||
          (code >= 0x30a0 && code <= 0x30ff) ||
          (code >= 0x3400 && code <= 0x4dbf) ||
          (code >= 0x4e00 && code <= 0x9fff) ||
          (code >= 0xf900 && code <= 0xfaff) ||
          (code >= 0xff00 && code <= 0xffef)
        );
      }

      function tokenizeForWrap(text) {
        var cleaned = String(text || '').replace(/\s+/g, ' ').trim();
        var tokens = [];
        var buf = '';
        for (var i = 0; i < cleaned.length; i++) {
          var ch = cleaned.charAt(i);
          if (ch === ' ') {
            if (buf) {
              tokens.push(buf);
              buf = '';
            }
            tokens.push(' ');
          } else if (isCjkChar(ch)) {
            if (buf) {
              tokens.push(buf);
              buf = '';
            }
            tokens.push(ch);
          } else {
            buf += ch;
          }
        }
        if (buf) tokens.push(buf);
        return tokens;
      }

      function truncateToWidth(ctx, str, maxWidth, forceEllipsis) {
        var ellipsis = '…';
        var out = String(str || '').trim();
        if (!forceEllipsis && ctx.measureText(out).width <= maxWidth) return out;
        while (out.length > 0 && ctx.measureText(out + ellipsis).width > maxWidth) {
          out = out.slice(0, -1);
        }
        return out.trim() + ellipsis;
      }

      function wrapCanvasText(ctx, text, maxWidth, maxLines) {
        var tokens = tokenizeForWrap(text);
        if (!tokens.length) return [];
        var lines = [];
        var current = '';
        var overflowed = false;

        function pushLine(line) {
          lines.push(line.replace(/^\s+|\s+$/g, ''));
        }

        for (var i = 0; i < tokens.length; i++) {
          var tok = tokens[i];
          if (tok === ' ' && !current) continue;

          var candidate = current + tok;
          if (ctx.measureText(candidate).width <= maxWidth) {
            current = candidate;
          } else if (!current) {
            var piece = '';
            for (var c = 0; c < tok.length; c++) {
              var nextPiece = piece + tok.charAt(c);
              if (ctx.measureText(nextPiece).width <= maxWidth || !piece) {
                piece = nextPiece;
              } else {
                pushLine(piece);
                if (maxLines && lines.length >= maxLines) {
                  overflowed = true;
                  break;
                }
                piece = tok.charAt(c);
              }
            }
            if (overflowed) break;
            current = piece;
          } else {
            pushLine(current);
            if (maxLines && lines.length >= maxLines) {
              overflowed = true;
              break;
            }
            if (tok === ' ') {
              current = '';
            } else if (ctx.measureText(tok).width <= maxWidth) {
              current = tok;
            } else {
              current = '';
              i--;
            }
          }
        }

        if (!overflowed && current.trim()) {
          if (!maxLines || lines.length < maxLines) {
            pushLine(current);
          } else {
            overflowed = true;
          }
        }

        if (overflowed && lines.length > 0) {
          var lastIdx = lines.length - 1;
          lines[lastIdx] = truncateToWidth(ctx, lines[lastIdx], maxWidth, true);
        }

        return lines;
      }

      function getFontStack(langCode) {
        if (langCode === 'zh-cn') {
          return '"PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans SC", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif';
        }
        if (langCode === 'ja') {
          return '"Hiragino Kaku Gothic ProN", "Hiragino Sans", "Yu Gothic", "Meiryo", "Noto Sans JP", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif';
        }
        return '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif';
      }

      function getVerdictStyle(safe) {
        if (safe === 'yes') {
          return {
            label: '✓ SAFE',
            bar: '#10b981',
            pillBg: '#ecfdf5',
            pillBorder: '#6ee7b7',
            pillText: '#047857'
          };
        }
        if (safe === 'no') {
          return {
            label: '✗ UNSAFE',
            bar: '#f43f5e',
            pillBg: '#fff1f2',
            pillBorder: '#fda4af',
            pillText: '#be123c'
          };
        }
        return {
          label: '⚠ CAUTION',
          bar: '#f59e0b',
          pillBg: '#fffbeb',
          pillBorder: '#fcd34d',
          pillText: '#92400e'
        };
      }

      function exportCheatSheetPng() {
        var allItems = readSavedItems();
        var filtered = getFilteredSortedItems(allItems);
        if (filtered.length === 0) {
          showToast('Save or load a starter pack first to export PNG.');
          return;
        }

        // Order items cleanly by verdict (SAFE -> CAUTION -> UNSAFE) for fridge scanning
        var ordered = filtered.slice().sort(function (a, b) {
          var va = VERDICT_ORDER[a.safe] !== undefined ? VERDICT_ORDER[a.safe] : 1;
          var vb = VERDICT_ORDER[b.safe] !== undefined ? VERDICT_ORDER[b.safe] : 1;
          if (va !== vb) return va - vb;
          return a.name.localeCompare(b.name);
        });

        var shownItems = ordered.slice(0, MAX_PNG_ITEMS);
        var hiddenCount = Math.max(0, ordered.length - shownItems.length);

        var counts = { yes: 0, depends: 0, no: 0 };
        ordered.forEach(function (it) {
          counts[it.safe] = (counts[it.safe] || 0) + 1;
        });

        var W = 1080;
        var H = 1440;
        var canvas = document.createElement('canvas');
        canvas.width = W;
        canvas.height = H;
        var ctx = canvas.getContext('2d');
        if (!ctx) {
          showToast('Unable to initialize canvas export in this browser.');
          return;
        }

        var fontStack = getFontStack(lang);

        // Warm editorial background
        ctx.fillStyle = '#f6f3ee';
        ctx.fillRect(0, 0, W, H);

        // Dark editorial header band
        var headerH = 228;
        var headerGrad = ctx.createLinearGradient(0, 0, W, headerH);
        headerGrad.addColorStop(0, '#181d26');
        headerGrad.addColorStop(1, '#202736');
        ctx.fillStyle = headerGrad;
        ctx.fillRect(0, 0, W, headerH);

        // Subtle coral radial glow
        ctx.save();
        ctx.beginPath();
        ctx.rect(0, 0, W, headerH);
        ctx.clip();
        var glowGrad = ctx.createRadialGradient(980, 40, 10, 980, 40, 320);
        glowGrad.addColorStop(0, 'rgba(224, 90, 71, 0.24)');
        glowGrad.addColorStop(1, 'rgba(24, 29, 38, 0)');
        ctx.fillStyle = glowGrad;
        ctx.fillRect(620, 0, 460, headerH);
        ctx.restore();

        // Top coral accent stripe
        ctx.fillStyle = '#e05a47';
        ctx.fillRect(0, 0, W, 10);

        // Brand mark top-left
        drawRoundRect(ctx, 48, 34, 30, 30, 8);
        ctx.fillStyle = '#e05a47';
        ctx.fill();
        ctx.strokeStyle = '#ffffff';
        ctx.lineWidth = 3;
        ctx.lineCap = 'round';
        ctx.lineJoin = 'round';
        ctx.beginPath();
        ctx.moveTo(56, 49);
        ctx.lineTo(61, 54);
        ctx.lineTo(70, 43);
        ctx.stroke();

        ctx.font = '700 18px ' + fontStack;
        ctx.fillStyle = '#e2e8f0';
        ctx.textBaseline = 'middle';
        ctx.fillText('ISITKITCHENSAFE.COM', 90, 50);

        // Filter + Date pill top-right
        var filterLabel =
          activeApplianceFilter === 'all' ? 'All Appliances' : formatApplianceName(activeApplianceFilter);
        var dateText = '';
        try {
          dateText = new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
        } catch (e) {}
        var metaBadgeText = dateText ? filterLabel + '  •  ' + dateText : filterLabel;
        ctx.font = '600 16px ' + fontStack;
        var clampedMeta = truncateToWidth(ctx, metaBadgeText, 420);
        var metaW = ctx.measureText(clampedMeta).width + 32;
        var metaX = W - 48 - metaW;
        drawRoundRect(ctx, metaX, 32, metaW, 34, 17);
        ctx.fillStyle = 'rgba(255, 255, 255, 0.10)';
        ctx.fill();
        ctx.strokeStyle = 'rgba(255, 255, 255, 0.22)';
        ctx.lineWidth = 1.2;
        ctx.stroke();
        ctx.fillStyle = '#f8fafc';
        ctx.fillText(clampedMeta, metaX + 16, 50);

        // Main Card Title
        var cardTitle = 'My Kitchen Safety Cheat Sheet — IsItKitchenSafe.com';
        ctx.font = '700 32px ' + fontStack;
        var titleClamped = truncateToWidth(ctx, cardTitle, W - 96);
        ctx.fillStyle = '#ffffff';
        ctx.textBaseline = 'top';
        ctx.fillText(titleClamped, 48, 86);

        // Verdict summary pills row
        var summaryPills = [
          { text: '✓ SAFE: ' + counts.yes, bg: 'rgba(16, 185, 129, 0.22)', border: '#34d399', fg: '#d1fae5' },
          { text: '⚠ CAUTION: ' + counts.depends, bg: 'rgba(245, 158, 11, 0.22)', border: '#fbbf24', fg: '#fef3c7' },
          { text: '✗ UNSAFE: ' + counts.no, bg: 'rgba(244, 63, 94, 0.22)', border: '#fb7185', fg: '#ffe4e6' }
        ];
        var pillX = 48;
        var pillY = 152;
        ctx.font = '700 18px ' + fontStack;
        ctx.textBaseline = 'middle';
        for (var sp = 0; sp < summaryPills.length; sp++) {
          var p = summaryPills[sp];
          var pw = ctx.measureText(p.text).width + 30;
          drawRoundRect(ctx, pillX, pillY, pw, 38, 19);
          ctx.fillStyle = p.bg;
          ctx.fill();
          ctx.strokeStyle = p.border;
          ctx.lineWidth = 1.5;
          ctx.stroke();
          ctx.fillStyle = p.fg;
          ctx.fillText(p.text, pillX + 15, pillY + 20);
          pillX += pw + 14;
        }

        // Total count label on right of summary row
        var countLabel =
          hiddenCount > 0
            ? 'Showing ' + shownItems.length + ' of ' + ordered.length + ' items'
            : ordered.length + (ordered.length === 1 ? ' saved rule' : ' saved rules');
        ctx.font = '600 17px ' + fontStack;
        ctx.fillStyle = '#cbd5e1';
        var clW = ctx.measureText(countLabel).width;
        ctx.fillText(countLabel, W - 48 - clW, pillY + 20);

        // Body 2-column grid (up to 16 items = 8 rows x 2 cols)
        var padX = 48;
        var colGap = 24;
        var colW = (W - padX * 2 - colGap) / 2;
        var bodyTop = headerH + 28;
        var footerTop = 1336;
        var overflowBandH = hiddenCount > 0 ? 44 : 0;
        var availH = footerTop - bodyTop - overflowBandH - 18;
        var rows = Math.max(1, Math.ceil(shownItems.length / 2));
        var rowGap = 16;
        var cardH = Math.min(138, Math.floor((availH - (rows - 1) * rowGap) / rows));

        for (var idx = 0; idx < shownItems.length; idx++) {
          var item = shownItems[idx];
          var col = idx % 2;
          var row = Math.floor(idx / 2);
          var cx = padX + col * (colW + colGap);
          var cy = bodyTop + row * (cardH + rowGap);
          var vs = getVerdictStyle(item.safe);

          // Card surface
          drawRoundRect(ctx, cx, cy, colW, cardH, 14);
          ctx.fillStyle = '#ffffff';
          ctx.fill();
          ctx.strokeStyle = '#e2ddd5';
          ctx.lineWidth = 1.5;
          ctx.stroke();

          // Left verdict accent bar
          ctx.save();
          drawRoundRect(ctx, cx, cy, colW, cardH, 14);
          ctx.clip();
          ctx.fillStyle = vs.bar;
          ctx.fillRect(cx, cy, 7, cardH);
          ctx.restore();

          // Top metadata row inside card: verdict pill (left) + appliance pill (right)
          var innerX = cx + 22;
          var innerRight = cx + colW - 18;
          var topMetaY = cy + 16;

          ctx.font = '800 14px ' + fontStack;
          var vLabelW = ctx.measureText(vs.label).width + 20;
          drawRoundRect(ctx, innerX, topMetaY, vLabelW, 28, 14);
          ctx.fillStyle = vs.pillBg;
          ctx.fill();
          ctx.strokeStyle = vs.pillBorder;
          ctx.lineWidth = 1.2;
          ctx.stroke();
          ctx.fillStyle = vs.pillText;
          ctx.textBaseline = 'middle';
          ctx.fillText(vs.label, innerX + 10, topMetaY + 14.5);

          var appLabel = formatApplianceName(item.appliance);
          ctx.font = '600 14px ' + fontStack;
          var maxAppW = Math.max(80, innerRight - (innerX + vLabelW + 12) - 20);
          var clampedApp = truncateToWidth(ctx, appLabel, maxAppW);
          var appW = ctx.measureText(clampedApp).width + 20;
          var appX = innerRight - appW;
          drawRoundRect(ctx, appX, topMetaY, appW, 28, 14);
          ctx.fillStyle = '#f1f5f9';
          ctx.fill();
          ctx.strokeStyle = '#cbd5e1';
          ctx.lineWidth = 1;
          ctx.stroke();
          ctx.fillStyle = '#334155';
          ctx.fillText(clampedApp, appX + 10, topMetaY + 14.5);

          // Item Name (CJK-safe wrapped up to 2 lines)
          var textMaxW = colW - 40;
          var nameFontSize = 21;
          ctx.font = '700 ' + nameFontSize + 'px ' + fontStack;
          var nameLines = wrapCanvasText(ctx, item.name, textMaxW, 2);
          if (nameLines.length > 1 && cardH < 124) {
            nameFontSize = 19;
            ctx.font = '700 ' + nameFontSize + 'px ' + fontStack;
            nameLines = wrapCanvasText(ctx, item.name, textMaxW, 2);
          }
          var lineH = Math.round(nameFontSize * 1.26);
          var textTop = nameLines.length === 1 ? cy + 58 + Math.max(0, (cardH - 116) / 2) : cy + 52 + Math.max(0, (cardH - 120) / 3);
          ctx.fillStyle = '#111827';
          ctx.textBaseline = 'top';
          for (var li = 0; li < nameLines.length; li++) {
            ctx.fillText(nameLines[li], innerX, textTop + li * lineH);
          }
        }

        // Optional overflow banner
        if (hiddenCount > 0) {
          var ovY = footerTop - 48;
          ctx.font = '600 16px ' + fontStack;
          ctx.fillStyle = '#475569';
          ctx.textBaseline = 'middle';
          var ovText =
            '+ ' + hiddenCount + ' more saved ' + (hiddenCount === 1 ? 'item' : 'items') + ' — view your full cheat sheet at isitkitchensafe.com/saved/';
          ctx.fillText(truncateToWidth(ctx, ovText, W - 96), 48, ovY + 18);
        }

        // Footer band
        ctx.strokeStyle = '#dcd5ca';
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.moveTo(48, footerTop);
        ctx.lineTo(W - 48, footerTop);
        ctx.stroke();

        ctx.font = '700 20px ' + fontStack;
        ctx.fillStyle = '#181d26';
        ctx.textBaseline = 'top';
        ctx.fillText('IsItKitchenSafe.com', 48, footerTop + 20);

        ctx.font = '500 15px ' + fontStack;
        ctx.fillStyle = '#4b5563';
        ctx.fillText(
          truncateToWidth(ctx, 'Verified against USDA FSIS, FDA 21 CFR & OEM care manuals • Always check bottom symbols.', 660),
          48,
          footerTop + 50
        );

        var urlPillText = 'isitkitchensafe.com/saved/';
        ctx.font = '700 16px ' + fontStack;
        var urlPillW = ctx.measureText(urlPillText).width + 32;
        var urlPillX = W - 48 - urlPillW;
        drawRoundRect(ctx, urlPillX, footerTop + 26, urlPillW, 40, 20);
        ctx.fillStyle = '#181d26';
        ctx.fill();
        ctx.fillStyle = '#ffffff';
        ctx.textBaseline = 'middle';
        ctx.fillText(urlPillText, urlPillX + 16, footerTop + 47);

        function triggerDownload(url, revokeAfter) {
          var a = document.createElement('a');
          a.href = url;
          a.download = 'kitchen-safety-cheat-sheet.png';
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          if (revokeAfter) {
            setTimeout(function () {
              try {
                URL.revokeObjectURL(url);
              } catch (e) {}
            }, 2500);
          }
          showToast('Downloaded kitchen-safety-cheat-sheet.png (1080×1440)!');
        }

        if (canvas.toBlob) {
          canvas.toBlob(function (blob) {
            if (blob) {
              triggerDownload(URL.createObjectURL(blob), true);
            } else {
              triggerDownload(canvas.toDataURL('image/png'), false);
            }
          }, 'image/png');
        } else {
          triggerDownload(canvas.toDataURL('image/png'), false);
        }
      }

      // --- Plain Text Cheat Sheet Copy ---
      function buildPlainTextCheatSheet(filtered) {
        var grouped = { yes: [], depends: [], no: [] };
        filtered.forEach(function (entry) {
          grouped[entry.safe].push(entry);
        });

        var filterLabel =
          activeApplianceFilter === 'all' ? 'All Appliances' : formatApplianceName(activeApplianceFilter);
        var lines = [
          'My Kitchen Safety Cheat Sheet — IsItKitchenSafe.com',
          'Filter: ' + filterLabel + ' | ' + filtered.length + ' items',
          ''
        ];

        var sections = [
          { key: 'yes', heading: '[✓ SAFE]' },
          { key: 'depends', heading: '[⚠ CAUTION — DEPENDS]' },
          { key: 'no', heading: '[✗ UNSAFE — AVOID]' }
        ];

        sections.forEach(function (sec) {
          if (grouped[sec.key].length === 0) return;
          lines.push(sec.heading);
          grouped[sec.key].forEach(function (entry) {
            lines.push('• ' + entry.name + ' (' + formatApplianceName(entry.appliance) + ')');
          });
          lines.push('');
        });

        lines.push('Full interactive cheat sheet: ' + savedCanonicalDisplayUrl);
        return lines.join('\n');
      }

      function copyCheatSheetText() {
        var allItems = readSavedItems();
        var filtered = getFilteredSortedItems(allItems);
        if (filtered.length === 0) {
          showToast('Save or load a starter pack first to copy.');
          return;
        }
        var text = buildPlainTextCheatSheet(filtered);

        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard
            .writeText(text)
            .then(function () {
              showToast('Copied ' + filtered.length + '-item cheat sheet to clipboard!');
            })
            .catch(function () {
              fallbackCopyText(text, filtered.length);
            });
        } else {
          fallbackCopyText(text, filtered.length);
        }
      }

      function fallbackCopyText(text, count) {
        try {
          var ta = document.createElement('textarea');
          ta.value = text;
          ta.setAttribute('readonly', '');
          ta.style.position = 'fixed';
          ta.style.top = '-9999px';
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          document.body.removeChild(ta);
          showToast('Copied ' + count + '-item cheat sheet to clipboard!');
        } catch (e) {
          showToast('Could not copy automatically. Please print or download PNG.');
        }
      }

      function initSavedPage() {
        var printBtn = document.getElementById('print-cheat-sheet-btn');
        if (printBtn) {
          printBtn.onclick = function () {
            window.print();
          };
        }

        var downloadBtn = document.getElementById('download-png-btn');
        if (downloadBtn) {
          downloadBtn.onclick = function () {
            exportCheatSheetPng();
          };
        }

        var copyBtn = document.getElementById('copy-text-btn');
        if (copyBtn) {
          copyBtn.onclick = function () {
            copyCheatSheetText();
          };
        }

        var clearAllBtn = document.getElementById('clear-all-saved-btn');
        if (clearAllBtn) {
          clearAllBtn.onclick = function () {
            if (window.confirm('Remove all saved items from your Kitchen Safety Cheat Sheet?')) {
              writeSavedItems([]);
              activeApplianceFilter = 'all';
              renderSavedSheet();
              showToast('Cleared all saved items.');
            }
          };
        }

        var packButtons = document.querySelectorAll('[data-starter-pack-btn]');
        packButtons.forEach(function (btn) {
          btn.onclick = function () {
            var packId = btn.getAttribute('data-starter-pack-btn');
            if (packId) applyStarterPack(packId);
          };
        });

        renderSavedSheet();
      }

      window.addEventListener('storage', function (evt) {
        if (evt.key === STORAGE_KEY) {
          renderSavedSheet();
        }
      });

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initSavedPage);
      } else {
        initSavedPage();
      }
      document.addEventListener('astro:page-load', initSavedPage);
    })();
  </script>
</Layout>
