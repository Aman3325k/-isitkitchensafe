---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import itemsData from '../data/items.json';
import howLongData from '../data/how-long.json';
import washingMachineData from '../data/washing-machine.json';
import refreezeData from '../data/refreeze.json';
import whatHappensData from '../data/what-happens.json';
import blogData from '../data/blog.json';
import comparisonsData from '../data/comparisons.json';
import { getDirectoryUrl, getApplianceUrl, useTranslatedPath } from '../i18n/utils';
import { CATEGORIES } from '../utils/materialCategories';

const lang = 'en' as const;
const translatePath = useTranslatedPath(lang);

const pageTitle = "HTML Sitemap & Complete Kitchen Safety Directory | IsItKitchenSafe";
const pageDescription = "Browse and live-filter our complete kitchen safety directory: everyday consumer calculators, appliance safety guides, food shelf-life databases, refreeze indexes, side-by-side comparisons, and editorial policies.";

// Helper to format appliance names
function formatAppliance(app: string): string {
  if (app === 'airfryer') return 'Air Fryer';
  return app.charAt(0).toUpperCase() + app.slice(1);
}

// Group appliance items dynamically
const appliances = ['dishwasher', 'microwave', 'freezer', 'oven', 'dryer', 'airfryer', 'refrigerator'] as const;
const groupedApplianceItems = appliances.reduce((acc, app) => {
  acc[app] = itemsData.filter((item) => item.appliance === app);
  return acc;
}, {} as Record<string, typeof itemsData>);

interface ConsumerToolItem {
  slug: string;
  name: string;
  desc: string;
  category: string;
  keywords: string;
}

const consumerTools: ConsumerToolItem[] = [
  {
    slug: 'kitchen-symbol-decoder',
    name: 'Kitchen Bottom Symbol Decoder',
    desc: 'Identify dishwasher, microwave, oven, freezer, and food-safe icons stamped under containers.',
    category: 'Cookware & Labels',
    keywords: 'symbol icon bottom pyrex tupperware dishwasher microwave safe label'
  },
  {
    slug: 'leftover-shelf-life-calculator',
    name: 'Leftover Shelf-Life Calculator',
    desc: 'USDA fridge and freezer countdown calculator for cooked meats, rice, pasta, and takeout.',
    category: 'Food Safety',
    keywords: 'leftover fridge refrigerator shelf life usda expiry cooked food storage'
  },
  {
    slug: 'meat-thawing-calculator',
    name: 'Meat & Turkey Thawing Calculator',
    desc: 'Calculate safe refrigerator and cold-water defrost times by weight for poultry, beef, and pork.',
    category: 'Food Safety',
    keywords: 'meat turkey chicken beef thaw defrost fridge cold water usda'
  },
  {
    slug: 'plastic-code-checker',
    name: 'Plastic Code (#1–#7) Safety Checker',
    desc: 'Check resin codes PET, HDPE, PVC, LDPE, PP, PS, and Other for microwave and dishwasher safety.',
    category: 'Cookware & Labels',
    keywords: 'plastic recycling code resin bpa microwave dishwasher container tupperware'
  },
  {
    slug: 'air-fryer-oven-converter',
    name: 'Air Fryer & Oven Time/Temp Converter',
    desc: 'Convert conventional oven recipes to air fryer, convection, and Gas Mark settings instantly.',
    category: 'Conversions',
    keywords: 'air fryer oven convection temperature time gas mark converter'
  },
  {
    slug: 'cookware-oven-temp-lookup',
    name: 'Cookware Oven Temp Lookup',
    desc: 'Verify maximum safe oven temperatures for Pyrex, Le Creuset, Lodge, CorningWare, and 24 brands.',
    category: 'Cookware & Labels',
    keywords: 'pyrex le creuset lodge corningware stanley cookware bakeware oven max temp'
  },
  {
    slug: 'internal-cooking-temp-chart',
    name: 'Safe Internal Cooking Temp Chart',
    desc: 'USDA minimum internal temperatures and rest times for poultry, steaks, ground meat, and fish.',
    category: 'Food Safety',
    keywords: 'internal temperature thermometer meat chicken steak pork fish usda doneness'
  },
  {
    slug: 'appliance-descaling-calculator',
    name: 'Appliance Descaling Calculator',
    desc: 'Exact vinegar or citric acid ratios for Keurig, Nespresso, drip coffee makers, and electric kettles.',
    category: 'Cleaning & Care',
    keywords: 'descale vinegar citric acid coffee maker kettle espresso keurig limescale'
  },
  {
    slug: 'cleaner-mixing-danger-checker',
    name: 'Cleaner Mixing Danger Checker',
    desc: 'Check hazardous chemical reactions before combining bleach, vinegar, ammonia, or baking soda.',
    category: 'Cleaning & Care',
    keywords: 'bleach vinegar ammonia hydrogen peroxide cleaner mixing toxic chlorine gas'
  },
  {
    slug: 'microwave-wattage-converter',
    name: 'Microwave Wattage Time Converter',
    desc: 'Adjust cooking times accurately between 600W, 700W, 900W, 1000W, 1100W, and 1250W microwaves.',
    category: 'Conversions',
    keywords: 'microwave wattage time converter reheating power defrost'
  },
  {
    slug: 'power-outage-food-safety-checker',
    name: 'Power Outage Food Safety Checker',
    desc: 'Decide what to keep or discard in your fridge and freezer after a blackout using USDA/CDC rules.',
    category: 'Food Safety',
    keywords: 'power outage blackout fridge refrigerator freezer spoiled food safety usda cdc'
  },
  {
    slug: 'baby-bottle-safety-checker',
    name: 'Baby Bottle & Kids Kitchenware Checker',
    desc: 'AAP, FDA, and CDC guidance on sterilizing, microwaving, and dishwashing baby bottles and sippy cups.',
    category: 'Food Safety',
    keywords: 'baby bottle sippy cup breastmilk formula sterilize dishwasher plastic silicone'
  },
  {
    slug: 'cooking-oil-smoke-point-finder',
    name: 'Cooking Oil Smoke Point Finder',
    desc: 'Compare smoke points and safe frying temperatures across 28 everyday culinary oils and fats.',
    category: 'Conversions',
    keywords: 'cooking oil smoke point olive avocado canola butter frying high heat'
  },
  {
    slug: 'cast-iron-seasoning-troubleshooter',
    name: 'Cast Iron Seasoning Troubleshooter',
    desc: 'Diagnose rust, sticky residue, flaking seasoning, and soap myths on cast iron and carbon steel.',
    category: 'Cleaning & Care',
    keywords: 'cast iron skillet carbon steel rust seasoning soap lodge dishwasher care'
  },
  {
    slug: 'fridge-organization-zone-planner',
    name: 'Fridge Organization Zone Planner',
    desc: 'USDA shelf-by-shelf temperature map for raw meat, dairy, eggs, produce, and condiments.',
    category: 'Food Safety',
    keywords: 'fridge refrigerator shelf zone temperature raw meat dairy cross contamination'
  },
  {
    slug: 'kitchen-safety-iq-quiz',
    name: 'Kitchen Safety IQ Quiz',
    desc: 'Test your instincts on everyday cookware, appliance, and food-storage myths in 2 minutes.',
    category: 'Food Safety',
    keywords: 'quiz test kitchen safety myths cookware appliance food handling'
  },
  {
    slug: 'induction-cookware-compatibility-checker',
    name: 'Induction Cookware Compatibility Checker',
    desc: 'Check stainless, cast iron, copper, aluminum, and enamel pans with the 3-second magnet test.',
    category: 'Cookware & Labels',
    keywords: 'induction cooktop magnet test stainless cast iron copper aluminum pans'
  },
  {
    slug: 'dishwasher-detergent-dosage-calculator',
    name: 'Dishwasher Detergent Dosage Calculator',
    desc: 'Dial in powder, gel, pod, and rinse-aid dosage for soft or hard water to stop cloudy glass.',
    category: 'Cleaning & Care',
    keywords: 'dishwasher detergent pod gel rinse aid hard water etching cloudy glass'
  },
  {
    slug: 'food-allergy-cross-contact-checker',
    name: 'Food Allergy Cross-Contact Checker',
    desc: 'Verify safe cleaning methods and cookware surfaces to prevent peanut, gluten, and dairy transfer.',
    category: 'Food Safety',
    keywords: 'allergy allergen cross contact gluten peanut dairy cutting board cleaning'
  },
  {
    slug: 'pantry-dry-goods-shelf-life-checker',
    name: 'Pantry & Dry Goods Shelf-Life Checker',
    desc: 'Check freshness and safety timelines for spices, flour, baking powder, oils, rice, and canned food.',
    category: 'Food Safety',
    keywords: 'pantry dry goods spices flour baking powder canned food rice expiration'
  },
  {
    slug: 'moldy-food-safety-checker',
    name: 'Moldy Food Cut-Around vs. Toss Checker',
    desc: 'USDA rules on when you can safely trim mold from hard cheese or produce vs. discard immediately.',
    category: 'Food Safety',
    keywords: 'mold moldy food cheese bread fruit jam usda cut around throw out'
  },
  {
    slug: 'oven-rack-bakeware-heat-adjuster',
    name: 'Oven Rack & Bakeware Heat Adjuster',
    desc: 'Adjust oven temperature and rack position for Pyrex glass, dark nonstick, ceramic, and aluminum pans.',
    category: 'Conversions',
    keywords: 'oven rack bakeware pyrex glass dark nonstick pan temperature baking adjuster'
  }
];

const quickFilterChips = [
  { label: 'Pyrex', query: 'pyrex' },
  { label: 'Air Fryer', query: 'air fryer' },
  { label: 'Mold', query: 'mold' },
  { label: 'Cast Iron', query: 'cast iron' },
  { label: 'Bleach', query: 'bleach' },
  { label: 'Stanley', query: 'stanley' },
  { label: 'Fridge', query: 'fridge' }
];

const trustCoreLinks = [
  { label: 'Homepage', href: translatePath('/'), keywords: 'home main index kitchen safety' },
  { label: 'All Interactive Kitchen Safety Tools', href: getDirectoryUrl('tools', lang), keywords: 'tools calculators utilities interactive' },
  { label: 'Saved Kitchen Safety Guides', href: translatePath('/saved/'), keywords: 'saved bookmarks favorites personal list' },
  { label: 'RSS Feed (XML)', href: '/rss.xml', keywords: 'rss feed xml syndication updates' }
];

const trustEditorialLinks = [
  { label: 'Editorial Methodology & Testing Standards', href: translatePath('/methodology/'), keywords: 'methodology testing standards usda fda sources verification' },
  { label: 'About IsItKitchenSafe', href: translatePath('/about/'), keywords: 'about us team mission editors' },
  { label: 'Contact & Support', href: translatePath('/contact/'), keywords: 'contact support email feedback request item' }
];

const trustPolicyLinks = [
  { label: 'Safety & Medical Disclaimer', href: translatePath('/disclaimer/'), keywords: 'disclaimer safety legal notice' },
  { label: 'Privacy Policy', href: translatePath('/privacy/'), keywords: 'privacy policy cookies data protection' },
  { label: 'Terms & Conditions', href: translatePath('/terms/'), keywords: 'terms conditions usage agreement' }
];

// Live dynamic counts
const totalTools = consumerTools.length;
const totalAppliances = itemsData.length;
const totalMaterials = CATEGORIES.length + 1; // 8 material hubs + scratched-nonstick evergreen guide
const totalBlog = blogData.length;
const totalComparisons = comparisonsData.length;
const totalDirectories = howLongData.length + refreezeData.length + washingMachineData.length + whatHappensData.length;
const totalTrust = trustCoreLinks.length + trustEditorialLinks.length + trustPolicyLinks.length;
const totalIndexedLinks = totalTools + totalAppliances + totalMaterials + totalBlog + totalComparisons + totalDirectories + totalTrust;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  excludeArticleSchema={true}
  availableLocales={['en', 'es', 'pt', 'zh-cn', 'ja']}
  lang={lang}
>
  <section class="max-w-[1280px] mx-auto px-6 py-10 md:py-12">
    <!-- Breadcrumbs -->
    <Breadcrumbs
      items={[
        { label: 'Home', href: translatePath('/') },
        { label: 'HTML Sitemap' }
      ]}
    />

    <!-- Hero Header -->
    <header class="max-w-[900px] mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface-soft border border-hairline text-xs font-semibold uppercase tracking-wider text-muted mb-4">
        <span class="w-2 h-2 rounded-full bg-success" aria-hidden="true"></span>
        Complete Directory Index
      </div>
      <h1 class="text-4xl md:text-5xl font-bold text-ink tracking-tight mb-4">
        HTML Sitemap
      </h1>
      <p class="text-body text-base md:text-lg leading-relaxed mb-6">
        Search or browse every consumer calculator, appliance safety check, material hub, shelf-life chart, refreeze rule, and editorial guide on IsItKitchenSafe.
      </p>

      <!-- Live KPI Summary Strip -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <div class="p-3.5 rounded-xl bg-surface-soft border border-hairline">
          <div class="text-2xl font-bold text-ink tabular-nums">{totalIndexedLinks.toLocaleString('en-US')}</div>
          <div class="text-xs font-medium text-muted mt-0.5">Total Indexed Links</div>
        </div>
        <div class="p-3.5 rounded-xl bg-surface-soft border border-hairline">
          <div class="text-2xl font-bold text-ink tabular-nums">{totalTools}</div>
          <div class="text-xs font-medium text-muted mt-0.5">Consumer Calculators</div>
        </div>
        <div class="p-3.5 rounded-xl bg-surface-soft border border-hairline">
          <div class="text-2xl font-bold text-ink tabular-nums">{totalAppliances.toLocaleString('en-US')}</div>
          <div class="text-xs font-medium text-muted mt-0.5">Appliance Safety Guides</div>
        </div>
        <div class="p-3.5 rounded-xl bg-surface-soft border border-hairline">
          <div class="text-2xl font-bold text-ink tabular-nums">{(totalDirectories + totalComparisons + totalBlog + totalMaterials).toLocaleString('en-US')}</div>
          <div class="text-xs font-medium text-muted mt-0.5">Reference &amp; Food Guides</div>
        </div>
      </div>
    </header>

    <!-- Live Instant Sitemap Filter Bar -->
    <div
      id="sitemap-filter-bar"
      class="no-print mb-6 p-5 md:p-6 rounded-2xl bg-surface-soft border border-hairline shadow-xs"
      data-msg-all="Showing all {total} indexed directory links across {sections} sections."
      data-msg-match="Showing {matched} matching links (of {total}) across {sections} sections."
      data-msg-empty='No matching links found for "{query}". Try another item, material, or appliance.'
    >
      <div class="flex flex-col gap-3">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <label for="sitemap-filter-input" class="text-sm font-bold text-ink">
            Instant Sitemap Filter
          </label>
          <p id="sitemap-filter-status" aria-live="polite" class="text-xs font-medium text-muted">
            Showing all {totalIndexedLinks} indexed directory links across 6 sections.
          </p>
        </div>

        <div class="relative flex items-center">
          <svg
            class="w-5 h-5 text-muted absolute left-3.5 pointer-events-none"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
          <input
            id="sitemap-filter-input"
            type="search"
            autocomplete="off"
            spellcheck="false"
            placeholder="Filter directory by item, brand, or topic (e.g., pyrex, air fryer, mold, cast iron, bleach, stanley, fridge)..."
            class="w-full pl-11 pr-24 py-3 rounded-xl bg-canvas border border-hairline text-ink placeholder:text-muted text-sm md:text-base focus:outline-none focus:border-link transition-colors"
          />
          <button
            id="sitemap-filter-clear"
            type="button"
            class="hidden absolute right-2.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-surface-strong text-ink hover:opacity-85 transition-opacity cursor-pointer"
          >
            Clear
          </button>
        </div>

        <!-- Quick Filter Suggestion Chips -->
        <div class="flex flex-wrap items-center gap-2 pt-1">
          <span class="text-xs font-medium text-muted mr-1">Popular filters:</span>
          {quickFilterChips.map((chip) => (
            <button
              type="button"
              data-filter-chip={chip.query}
              aria-pressed="false"
              class="px-2.5 py-1 rounded-full text-xs font-medium bg-canvas border border-hairline text-ink hover:border-link hover:text-link aria-[pressed=true]:bg-primary aria-[pressed=true]:text-on-primary aria-[pressed=true]:border-primary transition-colors cursor-pointer"
            >
              {chip.label}
            </button>
          ))}
        </div>
      </div>
    </div>

    <!-- Quick-Jump Section Anchor Pills -->
    <nav aria-label="Sitemap sections" class="no-print mb-10 flex flex-wrap gap-2.5">
      <a href="#section-calculators" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-full text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-link hover:text-link transition-colors">
        <span>Consumer Calculators</span>
        <span class="px-1.5 py-0.5 rounded-full bg-surface-soft text-muted text-[11px] tabular-nums">{totalTools}</span>
      </a>
      <a href="#section-appliances" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-full text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-link hover:text-link transition-colors">
        <span>Core Appliances</span>
        <span class="px-1.5 py-0.5 rounded-full bg-surface-soft text-muted text-[11px] tabular-nums">{totalAppliances}</span>
      </a>
      <a href="#section-guides" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-full text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-link hover:text-link transition-colors">
        <span>Evergreen Guides</span>
        <span class="px-1.5 py-0.5 rounded-full bg-surface-soft text-muted text-[11px] tabular-nums">{totalBlog + totalMaterials}</span>
      </a>
      <a href="#section-comparisons" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-full text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-link hover:text-link transition-colors">
        <span>Side-by-Side Comparisons</span>
        <span class="px-1.5 py-0.5 rounded-full bg-surface-soft text-muted text-[11px] tabular-nums">{totalComparisons}</span>
      </a>
      <a href="#section-directories" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-full text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-link hover:text-link transition-colors">
        <span>Shelf-Life &amp; Refreezing</span>
        <span class="px-1.5 py-0.5 rounded-full bg-surface-soft text-muted text-[11px] tabular-nums">{totalDirectories}</span>
      </a>
      <a href="#section-trust" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-full text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-link hover:text-link transition-colors">
        <span>Trust &amp; Policies</span>
        <span class="px-1.5 py-0.5 rounded-full bg-surface-soft text-muted text-[11px] tabular-nums">{totalTrust}</span>
      </a>
    </nav>

    <!-- Empty Filter State -->
    <div id="sitemap-empty-state" class="hidden mb-10 p-8 rounded-2xl bg-surface-soft border border-hairline text-center">
      <p class="text-lg font-bold text-ink mb-2">No matching directory links found</p>
      <p class="text-sm text-muted mb-4">
        Try a shorter keyword like &ldquo;pyrex&rdquo;, &ldquo;air fryer&rdquo;, &ldquo;mold&rdquo;, &ldquo;cast iron&rdquo;, &ldquo;bleach&rdquo;, &ldquo;stanley&rdquo;, or &ldquo;fridge&rdquo;.
      </p>
      <button
        id="sitemap-empty-reset"
        type="button"
        class="px-4 py-2 rounded-lg text-sm font-semibold bg-primary text-on-primary hover:opacity-90 transition-opacity cursor-pointer"
      >
        Reset Sitemap Filter
      </button>
    </div>

    <!-- 1. Everyday Consumer Kitchen Safety Calculators & Utilities -->
    <section id="section-calculators" data-sitemap-section class="border-t border-hairline pt-8 mb-12 scroll-mt-24">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 mb-6">
        <div>
          <span class="inline-block text-xs font-bold uppercase tracking-wider text-link mb-1">Interactive Spotlight</span>
          <h2 class="text-2xl md:text-3xl font-bold text-ink">
            Everyday Consumer Kitchen Safety Calculators &amp; Utilities
          </h2>
          <p class="text-sm text-muted mt-1">
            Free, evidence-based home calculators built around USDA, FDA, CDC, and cookware manufacturer standards.
          </p>
        </div>
        <a href={getDirectoryUrl('tools', lang)} class="text-sm font-semibold text-link hover:underline shrink-0">
          Browse All Tools Hub &rarr;
        </a>
      </div>

      <div data-sitemap-card class="rounded-2xl bg-surface-soft/60 border border-hairline p-4 md:p-5">
        <div class="flex items-center justify-between mb-4 pb-2.5 border-b border-hairline">
          <span class="text-xs font-bold uppercase tracking-wider text-muted">Verified Everyday Calculators</span>
          <span data-card-count data-orig-count={String(totalTools)} class="text-xs font-semibold px-2 py-0.5 rounded-full bg-canvas border border-hairline text-ink tabular-nums">
            {totalTools}
          </span>
        </div>
        <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5">
          {consumerTools.map((tool) => (
            <li
              data-sitemap-item
              data-search={`${tool.name} ${tool.desc} ${tool.category} ${tool.slug.replace(/-/g, ' ')} ${tool.keywords}`.toLowerCase()}
              class="rounded-xl bg-canvas border border-hairline hover:border-link transition-colors"
            >
              <a href={translatePath(`/tools/${tool.slug}/`)} class="flex flex-col h-full p-4 group">
                <span class="text-[11px] font-semibold uppercase tracking-wider text-muted mb-1">
                  {tool.category}
                </span>
                <span class="text-sm font-bold text-ink group-hover:text-link transition-colors mb-1.5">
                  {tool.name}
                </span>
                <span class="text-xs text-muted leading-relaxed">
                  {tool.desc}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 2. Core Appliance Reference Guides -->
    <section id="section-appliances" data-sitemap-section class="border-t border-hairline pt-8 mb-12 scroll-mt-24">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 mb-6">
        <div>
          <h2 class="text-2xl md:text-3xl font-bold text-ink">Core Appliance Reference Guides</h2>
          <p class="text-sm text-muted mt-1">
            {totalAppliances.toLocaleString('en-US')} item-by-item safety verdicts across {appliances.length} household appliances.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        {appliances.map((app) => {
          const items = groupedApplianceItems[app] || [];
          const appLabel = formatAppliance(app);
          const extraAppTerms = app === 'refrigerator' ? 'fridge refrigerator' : app === 'airfryer' ? 'air fryer airfryer' : app;
          return (
            <div data-sitemap-card class="border border-hairline rounded-xl p-5 bg-canvas">
              <h3 class="text-title-sm font-bold text-ink mb-3 pb-2.5 border-b border-hairline flex justify-between items-center gap-2">
                <span>{appLabel} Guides</span>
                <a href={getApplianceUrl(app, lang)} class="text-xs font-semibold text-link hover:underline shrink-0">
                  View All (<span data-card-count data-orig-count={String(items.length)}>{items.length}</span>)
                </a>
              </h3>
              <ul class="flex flex-col gap-2 text-[13px] max-h-[280px] overflow-y-auto pr-1">
                {items.map((item) => (
                  <li
                    data-sitemap-item
                    data-search={`can you put ${item.item} in the ${appLabel} ${extraAppTerms} ${item.slug.replace(/-/g, ' ')}`.toLowerCase()}
                  >
                    <a href={translatePath(`/${app}/${item.slug}/`)} class="text-muted hover:text-link block truncate py-0.5">
                      Can You Put {item.item} in the {appLabel}?
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          );
        })}
      </div>
    </section>

    <!-- 3. Evergreen Guides & Material Safety Hubs -->
    <section id="section-guides" data-sitemap-section class="border-t border-hairline pt-8 mb-12 scroll-mt-24">
      <h2 class="text-2xl md:text-3xl font-bold text-ink mb-6">Evergreen Guides &amp; Material Safety Hubs</h2>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <!-- Material Safety Hubs -->
        <div data-sitemap-card class="lg:col-span-5 p-6 bg-surface-soft border border-hairline rounded-xl">
          <h3 class="text-title-sm text-ink font-bold mb-3 pb-2.5 border-b border-hairline flex justify-between items-center gap-2">
            <span>Material Safety Hubs</span>
            <a href={getDirectoryUrl('material', lang)} class="text-xs font-semibold text-link hover:underline shrink-0">
              All Materials (<span data-card-count data-orig-count={String(totalMaterials)}>{totalMaterials}</span>)
            </a>
          </h3>
