---
import Layout from '../../layouts/Layout.astro';
import type { SupportedLanguage } from '../../i18n/ui';

export function getStaticPaths() {
  const allLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'zh-cn', 'ja'];
  return [
    { params: { lang: 'es' }, props: { lang: 'es' as SupportedLanguage, availableLocales: allLocales } },
    { params: { lang: 'pt' }, props: { lang: 'pt' as SupportedLanguage, availableLocales: allLocales } },
    { params: { lang: 'zh-cn' }, props: { lang: 'zh-cn' as SupportedLanguage, availableLocales: allLocales } },
    { params: { lang: 'ja' }, props: { lang: 'ja' as SupportedLanguage, availableLocales: allLocales } },
  ];
}

interface Props {
  lang: SupportedLanguage;
  availableLocales: SupportedLanguage[];
}

const { lang, availableLocales } = Astro.props;

const contentByLang = {
  ja: {
    title: "お問い合わせ | キッチン安全チェッカー",
    description: "キッチン安全ガイドに関するご質問、掲載リクエスト、または内容の訂正・ご意見がございましたら、編集部までお気軽にご連絡ください。",
    faqs: [
      {
        question: "新しい調理器具やアイテムの掲載をリクエストするにはどうすればよいですか？",
        answer: "当ページのお問い合わせフォームまたはメール（support@isitkitchensafe.com）にてお送りいただけます。"
      },
      {
        question: "問い合わせの返信にはどのくらい時間がかかりますか？",
        answer: "編集部では通常、2〜3営業日以内にすべてのリクエストと訂正提案を確認・検討しています。"
      }
    ],
    h1: "お問い合わせ",
    intro: "まだ掲載されていない調理器具やアイテムのリクエスト、または安全ガイドへの訂正・改善のご提案がございましたら、以下のフォームまたはメール（",
    introEnd: "）にてお気軽にお問い合わせください。",
    labelName: "お名前",
    placeholderName: "山田 太郎",
    labelEmail: "メールアドレス",
    placeholderEmail: "yamada@example.com",
    labelSubject: "件名",
    placeholderSubject: "アイテム掲載リクエスト / ガイドの訂正提案",
    labelMessage: "メッセージ内容",
    placeholderMessage: "対象の調理器具・食品と家電名、詳細をご記入ください...",
    btnSubmit: "メッセージを送信",
    btnSending: "送信中...",
    successTitle: "送信完了！",
    successDesc: "お問い合わせありがとうございます。メッセージを受け付けました。順次確認させていただきます。",
    errorTitle: "送信に失敗しました",
    errorDesc: "エラーが発生しました。時間をおいて再度お試しください。"
  },
  'zh-cn': {
    title: "联系我们 | 厨房安全指南",
    description: "对我们的厨房安全指南有疑问、纠错建议或希望评估新物品？欢迎给我们留言，编辑团队将尽快与您取得联系。",
    faqs: [
      {
        question: "如何建议评估新的厨房用品或食品？",
        answer: "您可以通过填写本页面的联系表单，或直接发送邮件至 support@isitkitchensafe.com 提交建议。"
      },
      {
        question: "通常需要多长时间才能得到回复？",
        answer: "我们的编辑团队通常会在 2 至 3 个工作日内查阅所有用户建议和纠错申请。"
      }
    ],
    h1: "联系我们",
    intro: "想建议我们评估尚未收录的厨房用品？或是发现现有指南需要勘误纠正？请填写下方表格，或直接发送邮件至 ",
    introEnd: " 联系我们。",
    labelName: "您的姓名",
    placeholderName: "张三",
    labelEmail: "电子邮箱",
    placeholderEmail: "zhangsan@example.com",
    labelSubject: "主题",
    placeholderSubject: "新物品评估建议 / 指南勘误反馈",
    labelMessage: "留言内容",
    placeholderMessage: "请详细描述涉及的厨房物品、电器及您的疑问...",
    btnSubmit: "发送留言",
    btnSending: "正在发送...",
    successTitle: "发送成功！",
    successDesc: "感谢您的来信。我们已收到您的反馈，并将尽快进行审核处理。",
    errorTitle: "发送失败",
    errorDesc: "发生错误，请稍后重试。"
  },
  es: {
    title: "Contacto y Soporte | ¿Es Seguro en la Cocina?",
    description: "¿Tienes dudas sobre una guía de seguridad, deseas solicitar la evaluación de un artículo o reportar una corrección? Contacta al equipo editorial de IsItKitchenSafe.",
    faqs: [
      {
        question: "¿Cómo puedo solicitar que evalúen un nuevo artículo o electrodoméstico?",
        answer: "Puedes usar el formulario de contacto en esta página o enviarnos un correo electrónico a support@isitkitchensafe.com con el nombre del producto y el electrodoméstico."
      },
      {
        question: "¿Cuánto tardan en responder a las consultas?",
        answer: "Nuestro equipo editorial suele revisar las sugerencias de artículos y solicitudes de corrección en un plazo de 2 a 3 días hábiles."
      }
    ],
    h1: "Contacto y Soporte",
    intro: "¿Deseas solicitar que evaluemos un artículo de cocina o sugerir una corrección en una de nuestras guías? Completa el siguiente formulario o escríbenos directamente a ",
    introEnd: ".",
    labelName: "Tu Nombre",
    placeholderName: "Carlos García",
    labelEmail: "Correo Electrónico",
    placeholderEmail: "carlos@example.com",
    labelSubject: "Asunto",
    placeholderSubject: "Solicitud de artículo / Sugerencia de corrección",
    labelMessage: "Mensaje",
    placeholderMessage: "Describe el artículo de cocina, el electrodoméstico y los detalles de tu consulta...",
    btnSubmit: "Enviar Mensaje",
    btnSending: "Enviando...",
    successTitle: "¡Mensaje Enviado!",
    successDesc: "Gracias por contactarnos. Hemos recibido tu mensaje y lo revisaremos a la brevedad.",
    errorTitle: "Error al Enviar",
    errorDesc: "Ocurrió un error al procesar el envío. Por favor, intenta de nuevo más tarde."
  },
  pt: {
    title: "Contato e Suporte | É Seguro na Cozinha?",
    description: "Tem dúvidas sobre um guia de segurança, deseja sugerir a avaliação de um item ou relatar uma correção? Entre em contato com a equipe editorial do IsItKitchenSafe.",
    faqs: [
      {
        question: "Como posso solicitar a avaliação de um novo item ou eletrodoméstico?",
        answer: "Você pode usar o formulário de contato nesta página ou nos enviar um e-mail para support@isitkitchensafe.com com o nome do produto e o eletrodoméstico."
      },
      {
        question: "Quanto tempo leva para responder às mensagens?",
        answer: "Nossa equipe editorial costuma revisar sugestões de itens e pedidos de correção em um prazo de 2 a 3 dias úteis."
      }
    ],
    h1: "Contato e Suporte",
    intro: "Deseja solicitar a avaliação de um item de cozinha ou sugerir uma correção em um de nossos guias? Preencha o formulário abaixo ou escreva diretamente para ",
    introEnd: ".",
    labelName: "Seu Nome",
    placeholderName: "Carlos Silva",
    labelEmail: "E-mail",
    placeholderEmail: "carlos@example.com",
    labelSubject: "Assunto",
    placeholderSubject: "Sugestão de item / Proposta de correção",
    labelMessage: "Mensagem",
    placeholderMessage: "Descreva o item de cozinha, o eletrodoméstico e os detalhes da sua dúvida...",
    btnSubmit: "Enviar Mensagem",
    btnSending: "Enviando...",
    successTitle: "Mensagem Enviada!",
    successDesc: "Obrigado pelo contato. Recebemos sua mensagem e a revisaremos em breve.",
    errorTitle: "Erro ao Enviar",
    errorDesc: "Ocorreu um erro ao processar o envio. Por favor, tente novamente mais tarde."
  }
};

const content = contentByLang[lang as keyof typeof contentByLang] || contentByLang.es;
---

<Layout title={content.title} description={content.description} faqs={content.faqs} excludeArticleSchema={true} availableLocales={availableLocales} lang={lang}>
  <section class="max-w-[600px] mx-auto px-6 py-[96px]">
    <h1 class="text-display-lg font-medium text-ink tracking-tight mb-4">{content.h1}</h1>
    <p class="text-body-md text-muted mb-8 leading-relaxed">
      {content.intro}<!--email_off--><a href="mailto:support@isitkitchensafe.com" class="text-link hover:underline">support@isitkitchensafe.com</a><!--/email_off-->{content.introEnd}
    </p>

    <!-- Client-side Interactive Form -->
    <form id="contact-form" class="flex flex-col gap-6">
      <div class="flex flex-col gap-2">
        <label for="name" class="text-[13px] font-semibold text-ink uppercase tracking-wider">{content.labelName}</label>
        <input 
          type="text" 
          id="name" 
          name="name" 
          required 
          placeholder={content.placeholderName}
          class="w-full h-11 px-4 py-3 bg-canvas text-ink text-[14px] border border-hairline rounded-sm focus:outline-none focus:border-info-border"
        />
      </div>

      <div class="flex flex-col gap-2">
        <label for="email" class="text-[13px] font-semibold text-ink uppercase tracking-wider">{content.labelEmail}</label>
        <input 
          type="email" 
          id="email" 
          name="email" 
          required 
          placeholder={content.placeholderEmail}
          class="w-full h-11 px-4 py-3 bg-canvas text-ink text-[14px] border border-hairline rounded-sm focus:outline-none focus:border-info-border"
        />
      </div>

      <div class="flex flex-col gap-2">
        <label for="subject" class="text-[13px] font-semibold text-ink uppercase tracking-wider">{content.labelSubject}</label>
        <input 
          type="text" 
          id="subject" 
          name="subject" 
          required 
          placeholder={content.placeholderSubject}
          class="w-full h-11 px-4 py-3 bg-canvas text-ink text-[14px] border border-hairline rounded-sm focus:outline-none focus:border-info-border"
        />
      </div>

      <div class="flex flex-col gap-2">
        <label for="message" class="text-[13px] font-semibold text-ink uppercase tracking-wider">{content.labelMessage}</label>
        <textarea 
          id="message" 
          name="message" 
          required 
          rows="5"
          placeholder={content.placeholderMessage}
          class="w-full px-4 py-3 bg-canvas text-ink text-[14px] border border-hairline rounded-sm focus:outline-none focus:border-info-border resize-y min-h-[120px]"
        ></textarea>
      </div>

      <!-- Honeypot -->
      <input type="text" name="b_name" id="b_name" style="display:none" tabindex="-1" autocomplete="off" />

      <button 
        id="submit-btn"
        type="submit" 
        class="btn-primary mt-2"
        data-sending-text={content.btnSending}
        data-error-text={content.errorDesc}
      >
        {content.btnSubmit}
      </button>
    </form>

    <!-- Success Message Container -->
    <div id="success-message" class="hidden bg-success-bg border border-success-border/30 rounded-md p-6 mt-8" aria-live="polite">
      <h3 class="text-title-sm text-success font-medium mb-2 flex items-center gap-1.5">
        <span>✓</span> {content.successTitle}
      </h3>
      <p class="text-[13px] text-body leading-relaxed">
        {content.successDesc}
      </p>
    </div>

    <!-- Error Message Container -->
    <div id="error-message" class="hidden bg-error-bg border border-error/30 rounded-md p-6 mt-8" aria-live="polite">
      <h3 class="text-title-sm text-error font-medium mb-2 flex items-center gap-1.5">
        <span>✗</span> {content.errorTitle}
      </h3>
      <p id="error-text" class="text-[13px] text-error leading-relaxed">
        {content.errorDesc}
      </p>
    </div>
  </section>

  <script is:inline>
    const form = document.getElementById('contact-form');
    const successMsg = document.getElementById('success-message');
    const errorMsg = document.getElementById('error-message');
    const errorText = document.getElementById('error-text');
    const submitBtn = document.getElementById('submit-btn');

    if (form && successMsg && errorMsg) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const formData = new FormData(form);
        const originalBtnText = submitBtn.innerText;
        submitBtn.innerText = submitBtn.getAttribute('data-sending-text') || 'Sending...';
        submitBtn.disabled = true;
        errorMsg.classList.add('hidden');
        
        try {
          const response = await fetch('/api/contact', {
            method: 'POST',
            body: formData
          });

          const result = await response.json().catch(() => ({ success: false, message: 'Invalid response from server.' }));

          if (response.ok && result.success) {
            form.classList.add('hidden');
            successMsg.classList.remove('hidden');
            successMsg.scrollIntoView({ behavior: 'smooth' });
          } else {
            throw new Error(result.message || 'Unknown error occurred.');
          }
        } catch (err) {
          errorText.innerText = err.message || submitBtn.getAttribute('data-error-text') || 'There was a network error. Please try again later.';
          errorMsg.classList.remove('hidden');
          submitBtn.innerText = originalBtnText;
          submitBtn.disabled = false;
        }
      });
    }
  </script>
</Layout>
