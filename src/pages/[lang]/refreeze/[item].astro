---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import refreezeEs from '../../../data/refreeze.es.json';
import refreezePt from '../../../data/refreeze.pt.json';
import refreezeZh from '../../../data/refreeze.zh-cn.json';
import refreezeJa from '../../../data/refreeze.ja.json';
import type { SupportedLanguage } from '../../../i18n/ui';

export function getStaticPaths() {
  const allLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'ja', 'zh-cn'];
  const paths: Array<{
    params: { lang: string; item: string };
    props: { data: any; lang: SupportedLanguage; availableLocales: SupportedLanguage[] };
  }> = [];

  refreezeEs.forEach((item) => {
    paths.push({
      params: { lang: 'es', item: item.slug },
      props: { data: item, lang: 'es', availableLocales: allLocales }
    });
  });

  refreezePt.forEach((item) => {
    paths.push({
      params: { lang: 'pt', item: item.slug },
      props: { data: item, lang: 'pt', availableLocales: allLocales }
    });
  });

  refreezeZh.forEach((item) => {
    paths.push({
      params: { lang: 'zh-cn', item: item.slug },
      props: { data: item, lang: 'zh-cn', availableLocales: allLocales }
    });
  });

  refreezeJa.forEach((item) => {
    paths.push({
      params: { lang: 'ja', item: item.slug },
      props: { data: item, lang: 'ja', availableLocales: allLocales }
    });
  });

  return paths;
}

interface Props {
  data: any;
  lang: SupportedLanguage;
  availableLocales: SupportedLanguage[];
}

const { data, lang, availableLocales } = Astro.props;
const currentDataset = lang === 'es' ? refreezeEs : (lang === 'pt' ? refreezePt : (lang === 'ja' ? refreezeJa : refreezeZh));

// Find related items within localized dataset
let relatedItems = currentDataset.filter(item => data.relatedItems?.includes(item.slug) && item.slug !== data.slug);
if (relatedItems.length < 5) {
  const sameSafeItems = currentDataset.filter(item => item.safe === data.safe && item.slug !== data.slug && !data.relatedItems?.includes(item.slug));
  const existingSlugs = new Set(relatedItems.map(i => i.slug));
  for (const item of sameSafeItems) {
    if (relatedItems.length >= 5) break;
    if (!existingSlugs.has(item.slug)) {
      relatedItems.push(item);
      existingSlugs.add(item.slug);
    }
  }
}
if (relatedItems.length < 5) {
  const anyItems = currentDataset.filter(item => item.slug !== data.slug && !relatedItems.some(ri => ri.slug === item.slug));
  for (const item of anyItems) {
    if (relatedItems.length >= 5) break;
    relatedItems.push(item);
  }
}
relatedItems = relatedItems.slice(0, 5);

const ui = {
  es: {
    pageTitle: `¿Se puede recongelar ${data.item}? Reglas del USDA | ¿Es Seguro en la Cocina?`,
    pageDesc: `${data.shortAnswer} Conoce las reglas oficiales de descongelación, riesgos de bacterias y precauciones para recongelar ${data.item}.`,
    home: "Inicio",
    refreeze: "Recongelación",
    guideTag: "Guía de Recongelación",
    lastUpdated: "Última Actualización: Septiembre 2026",
    usdaBadge: "✓ Pautas del USDA/FDA",
    h1Title: `¿Se puede recongelar ${data.item}?`,
    badgeYes: "SÍ",
    badgeNo: "NO",
    badgeDepends: "DEPENDE",
    criticalTitle: "🚨 ADVERTENCIA CRÍTICA: NO RECONGELAR",
    criticalDesc: `Recongelar ${data.item} tras haberse descongelado a temperatura ambiente puede ser peligroso. Las bacterias se multiplican rápidamente por encima de 4°C. Recongelar no elimina las bacterias, solo pausa su crecimiento, aumentando el riesgo de intoxicación alimentaria.`,
    explanationTitle: `¿Es seguro recongelar ${data.item}?`,
    detailsHeading: "Análisis Detallado de Seguridad",
    didYouKnowTitle: "💡 ¿Sabías Que?",
    didYouKnowText: "Recongelar carne descongelada a temperatura ambiente o en agua caliente es muy inseguro. Descongela siempre en el refrigerador por debajo de 4°C para mantener el alimento fuera de la zona de peligro bacteriano.",
    stepsTitle: "📋 Pasos Recomendados",
    warningsTitle: "⚠ Advertencias de Seguridad",
    editorialReview: "Revisado por el equipo editorial de IsItKitchenSafe",
    lastReviewed: "Última actualización: Septiembre 2026",
    faqTitle: "Preguntas Frecuentes",
    relatedTitle: "Guías Relacionadas de Recongelación",
    readGuide: "Leer guía",
    backLink: "Volver a todas las Guías de Recongelación"
  },
  pt: {
    pageTitle: `Pode recongelar ${data.item}? Regras do USDA | É Seguro na Cozinha?`,
    pageDesc: `${data.shortAnswer} Confira regras oficiais de descongelamento, riscos de proliferação bacteriana e cuidados ao recongelar ${data.item}.`,
    home: "Início",
    refreeze: "Recongelamento",
    guideTag: "Guia de Recongelamento",
    lastUpdated: "Última Atualização: Setembro 2026",
    usdaBadge: "✓ Diretrizes do USDA/FDA",
    h1Title: `Pode recongelar ${data.item}?`,
    badgeYes: "SIM",
    badgeNo: "NÃO",
    badgeDepends: "DEPENDE",
    criticalTitle: "🚨 ALERTA CRÍTICO: NÃO RECONGELE",
    criticalDesc: `Recongelar ${data.item} após ter descongelado em temperatura ambiente pode ser muito perigoso. As bactérias proliferam rapidamente acima de 4°C. O recongelamento não elimina as bactérias já formadas, aumentando o risco de intoxicação alimentar.`,
    explanationTitle: `É seguro recongelar ${data.item}?`,
    detailsHeading: "Análise Detalhada de Segurança",
    didYouKnowTitle: "💡 Você Sabia?",
    didYouKnowText: "Recongelar carnes descongeladas na bancada ou em água morna é extremamente arriscado. Sempre descongele dentro da geladeira abaixo de 4°C para manter o alimento fora da zona de proliferação bacteriana.",
    stepsTitle: "📋 Passos Recomendados",
    warningsTitle: "⚠ Alertas de Segurança",
    editorialReview: "Revisado pela equipe editorial do IsItKitchenSafe",
    lastReviewed: "Última atualização: Setembro 2026",
    faqTitle: "Perguntas Frecuentes",
    relatedTitle: "Guias Relacionados de Recongelamento",
    readGuide: "Ver guia",
    backLink: "Voltar a todos os Guias de Recongelamento"
  },
  'zh-cn': {
    pageTitle: `${data.item}可以二次冷冻吗？USDA安全规范 | 厨房安全指南`,
    pageDesc: `${data.shortAnswer} 全面掌握解冻规则、细菌滋生隐患及${data.item}二次冷冻的安全注意事项。`,
    home: "首页",
    refreeze: "二次冷冻",
    guideTag: "二次冷冻安全指南",
    lastUpdated: "最近更新：2026年9月",
    usdaBadge: "✓ 遵循USDA/FDA规范",
    h1Title: `${data.item}可以二次冷冻吗？`,
    badgeYes: "可以",
    badgeNo: "严禁",
    badgeDepends: "视情况而定",
    criticalTitle: "🚨 严重警告：严禁二次冷冻",
    criticalDesc: `将室温解冻后的${data.item}再次冷冻极度危险。高于4°C的环境下细菌会呈指数级繁殖。冷冻无法杀灭细菌，只能暂时休眠，再次食用极易引发严重食物中毒。`,
    explanationTitle: `${data.item}二次冷冻是否安全？`,
    detailsHeading: "详细安全分析",
    didYouKnowTitle: "💡 您知道吗？",
    didYouKnowText: "在厨房台面常温或温水中解冻肉类后再次冷冻极其危险。请始终在4°C以下的冰箱冷藏室中安全解冻，确保食材远离细菌危险温度区。",
    stepsTitle: "📋 推荐冷冻步骤",
    warningsTitle: "⚠ 安全操作警示",
    editorialReview: "由 IsItKitchenSafe 专业编辑团队审核",
    lastReviewed: "最新审核：2026年9月",
    faqTitle: "常见问题解答",
    relatedTitle: "相关二次冷冻指南",
    readGuide: "阅读指南",
    backLink: "返回所有二次冷冻指南"
  },
  ja: {
    pageTitle: `${data.item}は再冷凍できる？USDA安全基準 | 安全なキッチン判断基準`,
    pageDesc: `${data.shortAnswer} USDA公式の解凍ルール、細菌繁殖リスク、${data.item}を安全に再冷凍するための注意点を徹底解説。`,
    home: "ホーム",
    refreeze: "再冷凍",
    guideTag: "再冷凍安全ガイド",
    lastUpdated: "最終更新: 2026年9月",
    usdaBadge: "✓ USDA/FDA基準準拠",
    h1Title: `${data.item}は再冷凍できる？`,
    badgeYes: "可能",
    badgeNo: "不可",
    badgeDepends: "条件付き",
    criticalTitle: "🚨 重要な警告: 再冷凍しないでください",
    criticalDesc: `常温で解凍された${data.item}の再冷凍は極めて危険です。4℃以上の環境では細菌が急激に繁殖します。冷凍しても細菌は死滅せず一時休止するだけであるため、その後の摂取による食中毒リスクが大幅に高まります。`,
    explanationTitle: `${data.item}の再冷凍は安全？`,
    detailsHeading: "詳細な安全性分析",
    didYouKnowTitle: "💡 知っておきたい豆知識",
    didYouKnowText: "室温や温水で解凍した肉類の再冷凍は非常に危険です。食材を細菌の危険温度帯から遠ざけるため、必ず4℃以下の冷蔵庫内で解凍してください。",
    stepsTitle: "📋 推奨される手順",
    warningsTitle: "⚠ 安全上の注意点",
    editorialReview: "IsItKitchenSafe 編集チーム監修",
    lastReviewed: "最終確認: 2026年9月",
    faqTitle: "よくある質問（FAQ）",
    relatedTitle: "関連する再冷凍ガイド",
    readGuide: "ガイドを読む",
    backLink: "すべての再冷凍ガイド一覧へ"
  }
};

const currentUi = ui[lang] || ui.es;

const getHowToName = () => {
  if (lang === 'ja') return `${data.item}を安全に再冷凍する方法`;
  if (lang === 'zh-cn') return `如何安全二次冷冻${data.item}`;
  if (lang === 'es') return `Cómo recongelar con seguridad ${data.item}`;
  return `Como recongelar com segurança ${data.item}`;
};

const howToSchema = (data.safe === 'yes' || data.safe === 'depends') ? {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": getHowToName(),
  "description": data.shortAnswer,
  "step": data.instructions?.map((inst: string, idx: number) => ({
    "@type": "HowToStep",
    "position": idx + 1,
    "text": inst
  })) || []
} : null;
---

<Layout 
  title={currentUi.pageTitle} 
  description={currentUi.pageDesc} 
  faqs={data.faqs}
  lang={lang}
  availableLocales={availableLocales}
>
  <Fragment slot="head">
    {howToSchema && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
    )}
  </Fragment>

  <article class="max-w-[800px] mx-auto px-6 py-[48px] md:py-[64px]">
    <!-- Breadcrumbs -->
    <Breadcrumbs 
      items={[
        { label: currentUi.home, href: `/${lang}/` },
        { label: currentUi.refreeze, href: `/${lang}/refreeze/` },
        { label: data.item }
      ]}
    />

    <!-- Header Section -->
    <header class="mb-10 text-center md:text-left">
      <div class="flex flex-wrap items-center justify-center md:justify-start gap-3 mb-3">
        <span class="text-caption text-muted uppercase tracking-wider text-xs">{currentUi.guideTag}</span>
        <span class="text-xs text-muted border-l border-hairline pl-3">{currentUi.lastUpdated}</span>
        <span class="text-xs text-success font-medium bg-success-bg px-2 py-0.5 rounded-sm">{currentUi.usdaBadge}</span>
      </div>
      
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-6 leading-tight">
        {currentUi.h1Title}
      </h1>

      <!-- Safety Verdict Badge -->
      <div class="inline-flex items-center gap-3">
        {data.safe === 'yes' && (
          <div class="badge-yes quick-answer px-6 py-2 text-sm">
            <span class="mr-1.5">✓</span> {currentUi.badgeYes}
          </div>
        )}
        {data.safe === 'no' && (
          <div class="badge-no quick-answer px-6 py-2 text-sm">
            <span class="mr-1.5">✗</span> {currentUi.badgeNo}
          </div>
        )}
        {data.safe === 'depends' && (
          <div class="badge-depends quick-answer px-6 py-2 text-sm">
            <span class="mr-1.5">⚠</span> {currentUi.badgeDepends}
          </div>
        )}
      </div>
    </header>

    <!-- Critical Warning Box if safe === 'no' -->
    {data.safe === 'no' && (
      <section class="mb-12">
        <div class="bg-error-bg border border-error/30 rounded-md p-6 text-error">
          <h2 class="text-title-sm font-semibold mb-2 flex items-center gap-2">
            {currentUi.criticalTitle}
          </h2>
          <p class="text-[14px] leading-relaxed">
            {currentUi.criticalDesc}
          </p>
        </div>
      </section>
    )}

    <!-- Detailed Explanation -->
    <section class="mb-12">
      <div class="p-8 rounded-lg bg-surface-soft border border-hairline">
        <h2 class="text-title-sm text-ink font-medium mb-3">{currentUi.explanationTitle}</h2>
        <p class="short-answer text-title-md font-bold leading-relaxed text-ink mb-4">
          {data.shortAnswer}
        </p>
        
        <div>
          <div class="border-t border-hairline my-4 opacity-50"></div>
          <h3 class="text-caption text-muted mb-2 font-semibold uppercase tracking-wider text-xs">{currentUi.detailsHeading}</h3>
          {data.reason?.split('\n\n').map((para: string) => (
            <p class="text-body-md text-body leading-relaxed mb-4">
              {para}
            </p>
          ))}
        </div>
      </div>
    </section>

    <!-- Did you know / Fun fact -->
    <section class="mb-12">
      <div class="bg-surface-soft border border-hairline rounded-md p-6">
        <h3 class="text-title-sm text-ink font-medium mb-2">{currentUi.didYouKnowTitle}</h3>
        <p class="text-body-md text-body leading-relaxed">
          {currentUi.didYouKnowText}
        </p>
      </div>
    </section>

    <!-- Instructions and Warnings -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
      <!-- Instructions -->
      <div class="bg-surface-soft rounded-md p-6 border border-hairline/50">
        <h2 class="text-title-sm text-ink font-medium mb-4 flex items-center gap-2">
          {currentUi.stepsTitle}
        </h2>
        <ul class="flex flex-col gap-3">
          {data.instructions?.map((inst: string) => (
            <li class="text-body-md text-body flex gap-2.5 items-start leading-relaxed">
              <span class="text-success font-bold mt-0.5">✓</span>
              <span>{inst}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Warnings -->
      <div class="bg-surface-soft rounded-md p-6 border border-hairline/50">
        <h2 class="text-title-sm text-ink font-medium mb-4 flex items-center gap-2">
          {currentUi.warningsTitle}
        </h2>
        <ul class="flex flex-col gap-3">
          {data.warnings?.map((warn: string) => (
            <li class="text-body-md text-body flex gap-2.5 items-start leading-relaxed">
              <span class="text-signature-coral font-bold mt-0.5">⚠</span>
              <span>{warn}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Editorial Byline Block -->
    <div class="bg-surface-soft border border-hairline rounded-md p-4 mb-12 flex flex-wrap items-center justify-between gap-4 text-xs text-muted">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center justify-center bg-success/10 text-success w-5 h-5 rounded-full font-bold text-[10px]">✓</span>
        <span>{currentUi.editorialReview}</span>
      </div>
      <div>
        <span>{currentUi.lastReviewed}</span>
      </div>
    </div>

    <!-- FAQ Section -->
    <section class="border-t border-hairline pt-12 mb-16">
      <h2 class="text-title-lg text-ink font-medium tracking-tight mb-8">{currentUi.faqTitle}</h2>
      <div class="flex flex-col">
        {data.faqs?.map((faq: any) => (
          <details class="group border-b border-hairline py-5">
            <summary class="flex items-center justify-between text-title-sm text-ink font-medium cursor-pointer list-none [&::-webkit-details-marker]:hidden select-none">
              <span>{faq.question}</span>
              <span class="text-muted group-open:rotate-180 transition-transform duration-200">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </summary>
            <div class="mt-4 text-body-md text-body leading-relaxed pl-1">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- Related Items -->
    {relatedItems.length > 0 && (
      <section class="border-t border-hairline pt-12 mb-16">
        <h2 class="text-title-lg text-ink font-medium tracking-tight mb-8">{currentUi.relatedTitle}</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {relatedItems.map((item: any) => (
            <a 
              href={`/${lang}/refreeze/${item.slug}/`} 
              class="bg-canvas border border-hairline hover:border-border-strong rounded-md p-5 flex flex-col justify-between shadow-xs transition-colors active:scale-[0.98]"
            >
              <div>
                <div class="flex items-center justify-between mb-3">
                  <span class="text-[11px] text-muted uppercase tracking-wider">{currentUi.guideTag}</span>
                  {item.safe === 'yes' && <span class="badge-yes text-[10px] px-2 py-0.5">{currentUi.badgeYes}</span>}
                  {item.safe === 'no' && <span class="badge-no text-[10px] px-2 py-0.5">{currentUi.badgeNo}</span>}
                  {item.safe === 'depends' && <span class="badge-depends text-[10px] px-2 py-0.5">{currentUi.badgeDepends}</span>}
                </div>
                <h3 class="text-title-sm text-ink mb-1">
                  {item.item}
                </h3>
                <p class="text-[13px] text-muted line-clamp-2 leading-relaxed">
                  {item.shortAnswer}
                </p>
              </div>
              <span class="text-[12px] font-medium text-link mt-4 block">{currentUi.readGuide} &rarr;</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Back Link -->
    <div class="mt-12 pt-8 border-t border-hairline text-center">
      <a 
        href={`/${lang}/refreeze/`} 
        class="text-link text-[14px] font-medium hover:text-link-active transition-colors min-h-[44px] inline-flex items-center gap-1.5 active:scale-[0.98] transition-transform py-2.5 px-4 rounded-md hover:bg-surface-soft"
      >
        &larr; {currentUi.backLink}
      </a>
    </div>
  </article>
</Layout>
