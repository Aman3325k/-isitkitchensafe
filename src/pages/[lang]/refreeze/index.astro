---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import refreezeEs from '../../../data/refreeze.es.json';
import refreezePt from '../../../data/refreeze.pt.json';
import refreezeZh from '../../../data/refreeze.zh-cn.json';
import refreezeJa from '../../../data/refreeze.ja.json';
import { getApplianceUrl, getDirectoryUrl } from '../../../i18n/utils';
import type { SupportedLanguage } from '../../../i18n/ui';

export function getStaticPaths() {
  const allLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'ja', 'zh-cn'];
  return [
    {
      params: { lang: 'es' },
      props: {
        lang: 'es' as SupportedLanguage,
        items: refreezeEs,
        availableLocales: allLocales
      }
    },
    {
      params: { lang: 'pt' },
      props: {
        lang: 'pt' as SupportedLanguage,
        items: refreezePt,
        availableLocales: allLocales
      }
    },
    {
      params: { lang: 'zh-cn' },
      props: {
        lang: 'zh-cn' as SupportedLanguage,
        items: refreezeZh,
        availableLocales: allLocales
      }
    },
    {
      params: { lang: 'ja' },
      props: {
        lang: 'ja' as SupportedLanguage,
        items: refreezeJa,
        availableLocales: allLocales
      }
    }
  ];
}

interface Props {
  lang: SupportedLanguage;
  items: typeof refreezeEs;
  availableLocales: SupportedLanguage[];
}

const { lang, items, availableLocales } = Astro.props;

const ui = {
  es: {
    pageTitle: "Guías de Seguridad para Recongelar Alimentos Descongelados | ¿Es Seguro en la Cocina?",
