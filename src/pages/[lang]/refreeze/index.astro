    categories: [
      { name: "洗碗机", slug: "dishwasher", tag: "电器指南" },
      { name: "微波炉", slug: "microwave", tag: "电器指南" },
      { name: "冷冻室", slug: "freezer", tag: "电器指南" },
      { name: "烤箱", slug: "oven", tag: "电器指南" },
      { name: "烘干机", slug: "dryer", tag: "电器指南" },
      { name: "空气炸锅", slug: "airfryer", tag: "电器指南" },
      { name: "冰箱冷藏室", slug: "refrigerator", tag: "电器指南" },
      { name: "食品保质期", slug: "how-long", tag: "食材保存" },
      { name: "洗衣机", slug: "washing-machine", tag: "衣物与织物" },
      { name: "会发生什么", slug: "what-happens", tag: "厨房事故与隐患" },
    ]
  },
  ja: {
    pageTitle: "解凍食品の再冷凍安全性ガイド | 安全なキッチン判断基準",
    pageDesc: "解凍した牛肉、鶏肉、豚肉、乳製品、調理済み料理の再冷凍は可能？食中毒を防ぐためのUSDA（米国農務省）公式温度ルールと安全基準を徹底解説。",
    home: "ホーム",
    refreezeSafety: "再冷凍の安全性",
    heroTitle: "食品の再冷凍安全性ガイド",
    heroDesc: "一度解凍した肉、魚介類、料理を再び冷凍庫に戻しても安全かどうかを判定。USDAの厳格な安全ルールを学びましょう。",
    testedItems: `評価済み食品（${items.length}件）`,
    testedSub: "生鮮食品から加熱調理済み食品まで、USDA基準に準拠した包括的な再冷凍判定。",
    searchPlaceholder: "食品を検索（例: 牛ひき肉、鶏肉）...",
    searchAria: "再冷凍食品の検索",
    clearSearchAria: "検索をクリア",
    countTemplate: "{total}件中 {count}件のガイドを表示",
    verdictAria: "安全性判定で絞り込み",
    pillAll: "すべて",
    pillYes: "安全 / 可能",
    pillDepends: "条件付き / 注意",
    pillNo: "不可 / 危険",
