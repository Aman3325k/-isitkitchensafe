    refreezeSafety: "Seguridad de Recongelación",
    heroTitle: "Guías de Seguridad para Recongelar",
    heroDesc: "Determina si es seguro volver a congelar carnes, mariscos y comidas cocinadas previamente descongeladas. Aprende las normas estrictas del USDA.",
    testedItems: `Alimentos Evaluados (${items.length})`,
    testedSub: "Evaluaciones completas alineadas al USDA para alimentos crudos y cocinados.",
    searchPlaceholder: "Buscar alimentos (ej. Carne picada, Pollo)...",
    searchAria: "Buscar alimentos para recongelación",
    guideTag: "Guía de Recongelación",
    badgeYes: "SÍ",
    badgeNo: "NO",
    badgeDepends: "DEPENDE",
    readDetails: "Leer detalles de recongelación",
    noResults: "No se encontraron alimentos que coincidan con tu búsqueda.",
    relatedHeading: "Categorías Relacionadas de Electrodomésticos y Seguridad",
    categories: [
      { name: "Lavavajillas", slug: "dishwasher", tag: "Guía de Electrodoméstico" },
      { name: "Microondas", slug: "microwave", tag: "Guía de Electrodoméstico" },
      { name: "Congelador", slug: "freezer", tag: "Guía de Electrodoméstico" },
      { name: "Horno", slug: "oven", tag: "Guía de Electrodoméstico" },
      { name: "Secadora", slug: "dryer", tag: "Guía de Electrodoméstico" },
      { name: "Freidora de Aire", slug: "airfryer", tag: "Guía de Electrodoméstico" },
      { name: "Refrigerador", slug: "refrigerator", tag: "Guía de Electrodoméstico" },
      { name: "Duración de Alimentos", slug: "how-long", tag: "Conservación" },
      { name: "Lavadora", slug: "washing-machine", tag: "Prendas y Ropa" },
      { name: "Qué Pasa Si...", slug: "what-happens", tag: "Accidentes en Cocina" },
    ]
  },
  pt: {
    pageTitle: "Guias de Segurança para Recongelar Alimentos Descongelados | É Seguro na Cozinha?",
    pageDesc: "Pode recongelar carne bovina, frango, porco, laticínios ou pratos prontos após descongelar? Conheça as regras oficiais de temperatura do USDA contra intoxicação.",
    home: "Início",
    refreezeSafety: "Segurança de Recongelamento",
    heroTitle: "Diretrizes de Segurança para Recongelar",
    heroDesc: "Descubra se é seguro recongelar carnes, peixes e refeições que já foram descongelados. Conheça as regras rígidas do USDA.",
    testedItems: `Alimentos Avaliados (${items.length})`,
