        hazard: 'フッ素樹脂分解ガスの発生（ポリマーヒューム熱）、塗膜の膨れ・剥がれ',
        standard: 'FDA 21 CFR 177.1550 / NIOSH ガイドライン'
      },
      {
        material: '食品用プラスチック（PP #5、HDPE #2、PET #1、PS #6）',
        threshold: 'PP #5 は約100℃（212°F）まで安定、PET #1・PS #6 は60〜71℃（140〜160°F）で変形',
        hazard: '食洗機・電子レンジの熱による変形、添加剤・オリゴマーの溶出、マイクロプラスチック放出',
        standard: 'FDA 21 CFR 177.1520 / 177.1630'
      },
      {
        material: '鋳鉄・炭素鋼・天然木（硬木）',
        threshold: 'pH 10超の強アルカリ洗剤および60〜71℃（140〜160°F）の蒸気サイクル',
        hazard: '油膜（シーズニング）の剥離、急速な鉄の酸化（錆）、木繊維の膨張・反り・割れ',
        standard: 'メーカー公式お手入れマニュアル・耐久試験基準'
      },
      {
        material: '真空断熱ステンレス鋼',
        threshold: '除菌高温コース（68〜74℃ / 155〜165°F）および熱膨張圧',
        hazard: '底面の真空封止部の劣化による保温力低下、外装パウダーコートの剥がれ',
        standard: 'メーカー公式ケア基準 / NSF/ANSI 184 家庭用食洗機規格'
      }
    ],
    changelogEyebrow: '監査性と品質保証',
    changelogHeading: '検証可能な編集レビュー体制と更新履歴',
    changelogBadgePages: '10,900+ ページ検証済み',
    changelogBadgeDate: '2026-11 更新',
    workflowHeading: '4ステップの編集検証ワークフロー',
    workflowSteps: [
      {
        step: '01',
        title: '一次規格・法令の照合',
        detail: 'すべての安全基準をUSDA FSIS、FDA 21 CFR、NSF/ANSI、CDC/AAP、ASTM、EFSA/BfR、EPAの一次条文に直接紐づけます。'
      },
      {
        step: '02',
        title: '熱的・化学的クロスチェック',
        detail: '最悪条件（空焚き過熱、強アルカリ洗浄、酸性溶出、アレルゲン残留）を前提にしきい値を二重検証します。'
      },
      {
        step: '03',
        title: '5言語ネイティブ技術ローカライズ',
        detail: '単位（℃/°F、cm/インチ）、プラ番号、規制名称をEN・ES・PT・ZH-CN・JAの各言語へ専門用語で最適化します。'
      },
      {
        step: '04',
        title: '自動リンク・全言語パリティ監査',
        detail: '10,900以上の全ページを対象にリンク切れゼロ、末尾スラッシュ統一、構造化データの整合性を自動検証しています。'
      }
    ],
    milestonesHeading: '最近のレビュー・改訂マイルストーン',
    changelogEntries: [
      {
        date: '2026-11',
        badge: '基準・ツール',
        summary:
          '全5言語でインタラクティブな10大規制基準ディレクトリを公開し、アレルゲン交差接触チェッカーおよびパントリー乾物保存チェッカーの技術監査を完了。'
      },
      {
        date: '2026-11',
        badge: '微生物・化学',
        summary:
          'USDA FSISの停電時食品ルール（4時間/24時間/48時間）、最低中心温度（63℃ / 71℃ / 74℃）、およびEPA洗剤混合危険マトリクスを再監査。'
      },
      {
        date: '2026-11',
        badge: '素材・乳幼児',
        summary:
          'ASTM C148ガラス熱衝撃しきい値、EU BfRバンブーメラミン勧告、CDC/AAP電子レンジ授乳禁止基準、および10,900+ページの多言語整合性を同期。'
      }
    ],
    toolsStripEyebrow: '基準をキッチンで実践',
    toolsStripHeading: 'インタラクティブ検証ツール',
    toolsStripIntro:
      '公的食品安全基準・材料科学・化学反応データを、毎日のキッチンチェックにそのままご活用ください。',
    toolsOpenLabel: 'ツールを開く',
    verificationTools: [
      {
        path: '/tools/kitchen-symbol-decoder/',
        tag: 'ISO • NSF/ANSI',
        title: 'キッチン記号デコーダー',
        desc: '底面マークから食洗機・電子レンジ・オーブン・冷凍・食品接触の適合性を即座に判別。'
      },
      {
        path: '/tools/internal-cooking-temp-chart/',
        tag: 'USDA FSIS',
        title: '安全な加熱中心温度チャート',
        desc: '鶏肉・精肉・残り物の最低安全中心温度（℃/°F）と休ませ時間を一覧で確認。'
      },
      {
        path: '/tools/power-outage-food-safety-checker/',
        tag: 'USDA 4h / 24h / 48h',
        title: '停電時の食品安全チェッカー',
        desc: '停電時間と室温から冷蔵庫・冷凍庫の食材を保存可／廃棄に迅速判定。'
      },
      {
        path: '/tools/cleaner-mixing-danger-checker/',
        tag: 'EPA • 中毒管理センター',
        title: '洗剤混合の危険度チェッカー',
        desc: '洗剤を組み合わせる前にクロラミン・塩素ガス・過酢酸の発生リスクを警告。'
      },
      {
        path: '/tools/food-allergy-cross-contact-checker/',
        tag: 'FASTER法 • FARE',
        title: '食物アレルギー交差接触チェッカー',
        desc: '調理器具や揚げ油の共用・洗浄方法による主要9アレルゲンの移行リスクを評価。'
      },
      {
        path: '/tools/pantry-dry-goods-shelf-life-checker/',
        tag: 'USDA FoodKeeper',
        title: 'パントリー・乾物保存期限チェッカー',
        desc: '未開封・開封後の保存目安、酸化・劣化サイン、適切な防湿保管条件を確認。'
      }
    ],
    relatedHeading: '編集方針と便利な安全ツールを見る',
    relatedDesc: '安全性リサーチを毎日のキッチンに活かしましょう。運営方針の確認、調理器具の底面マーク解読、冷蔵庫に貼れる1ページ早見表の印刷が可能です。',
    linkAbout: '運営者情報・編集方針',
    linkTools: 'インタラクティブ安全ツール',
    linkSaved: '印刷用・冷蔵庫安全早見表',
    linkDisclaimer: '安全免責事項',
    linkReport: '訂正を報告する'
  }
};

const content = CONTENT[lang as Exclude<SupportedLanguage, 'en'>] || CONTENT.es;
const canonicalPageUrl = `https://isitkitchensafe.com/${lang}/methodology/`;
const schemaLang = lang === 'zh-cn' ? 'zh-CN' : lang;

const methodologySchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: content.schemaName,
  url: canonicalPageUrl,
  inLanguage: schemaLang,
  description: content.pageDescription,
  isPartOf: {
    '@type': 'WebSite',
    name: content.siteName,
    url: `https://isitkitchensafe.com/${lang}/`
  },
  mainEntity: {
    '@type': 'Organization',
    name: 'IsItKitchenSafe',
    url: 'https://isitkitchensafe.com/',
    logo: 'https://isitkitchensafe.com/favicon.svg',
    publishingPrinciples: canonicalPageUrl,
    correctionsPolicy: `${canonicalPageUrl}#review-protocol`,
    contactPoint: {
      '@type': 'ContactPoint',
      email: 'editorial@isitkitchensafe.com',
      contactType: 'editorial desk'
    },
    knowsAbout: content.knowsAbout
  }
};
---

<Layout
  title={content.pageTitle}
  description={content.pageDescription}
  excludeFaqSchema={true}
  excludeArticleSchema={true}
  availableLocales={availableLocales}
  lang={lang}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(methodologySchema)} />
  </Fragment>

  <article class="max-w-[860px] mx-auto px-6 py-[48px] md:py-[64px]">
    <Breadcrumbs
      items={[
        { label: t('nav.home'), href: translatePath('/') },
        { label: content.breadcrumbLabel }
      ]}
    />

    <!-- Hero Header -->
    <header class="mb-10 pb-8 border-b border-hairline">
      <span class="text-caption text-signature-coral font-semibold uppercase tracking-wider text-xs block mb-2">
        {content.eyebrow}
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4 leading-tight">
        {content.h1}
      </h1>
      <p class="text-title-md text-body font-normal leading-relaxed max-w-3xl">
        {content.heroIntroPrefix}<strong class="text-ink font-semibold">{content.verdictYesWord}</strong>{content.heroIntroMiddle1}<strong class="text-ink font-semibold">{content.verdictNoWord}</strong>{content.heroIntroMiddle2}<strong class="text-ink font-semibold">{content.verdictDependsWord}</strong>{content.heroIntroSuffix}
      </p>

      <div class="mt-6 flex flex-wrap items-center gap-3 text-xs text-muted">
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-surface-soft border border-hairline text-ink font-medium">
          <span class="w-2 h-2 rounded-full bg-success"></span>
          {content.pillTier}
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-surface-soft border border-hairline">
          {content.pillStandards}
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-surface-soft border border-hairline">
          {content.pillIndependent}
        </span>
      </div>
    </header>

    <!-- Verdict Rubric Section -->
    <section class="mb-14" aria-labelledby="verdict-rubric-heading">
      <h2 id="verdict-rubric-heading" class="text-title-lg text-ink font-medium tracking-tight mb-3">
        {content.rubricHeading}
      </h2>
      <p class="text-body-md text-body leading-relaxed mb-6">
        {content.rubricIntro}
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="bg-surface-soft border border-hairline rounded-lg p-5 flex flex-col gap-3">
          <div class="flex items-center justify-between gap-2">
            <span class="badge-yes px-3.5 py-1 text-xs">{content.yesBadge}</span>
            <span class="text-[11px] uppercase tracking-wider text-muted font-semibold">{content.yesTag}</span>
          </div>
          <p class="text-body-md text-body leading-relaxed">
            {content.yesDesc}
          </p>
          <p class="text-xs text-muted border-t border-hairline pt-2.5 mt-auto">
            <strong class="text-ink">{content.yesExampleLabel}</strong> {content.yesExample}
          </p>
        </div>

        <div class="bg-surface-soft border border-hairline rounded-lg p-5 flex flex-col gap-3">
          <div class="flex items-center justify-between gap-2">
            <span class="badge-depends px-3.5 py-1 text-xs">{content.dependsBadge}</span>
            <span class="text-[11px] uppercase tracking-wider text-muted font-semibold">{content.dependsTag}</span>
          </div>
          <p class="text-body-md text-body leading-relaxed">
            {content.dependsDescPrefix}<em>{content.dependsDescEmphasis}</em>{content.dependsDescSuffix}
          </p>
          <p class="text-xs text-muted border-t border-hairline pt-2.5 mt-auto">
            <strong class="text-ink">{content.dependsExampleLabel}</strong> {content.dependsExample}
          </p>
        </div>

        <div class="bg-surface-soft border border-hairline rounded-lg p-5 flex flex-col gap-3">
          <div class="flex items-center justify-between gap-2">
            <span class="badge-no px-3.5 py-1 text-xs">{content.noBadge}</span>
            <span class="text-[11px] uppercase tracking-wider text-muted font-semibold">{content.noTag}</span>
          </div>
          <p class="text-body-md text-body leading-relaxed">
            {content.noDesc}
          </p>
          <p class="text-xs text-muted border-t border-hairline pt-2.5 mt-auto">
            <strong class="text-ink">{content.noExampleLabel}</strong> {content.noExample}
          </p>
        </div>
      </div>
    </section>

    <!-- 4-Tier Verification Framework -->
    <section class="mb-14" aria-labelledby="framework-heading">
      <h2 id="framework-heading" class="text-title-lg text-ink font-medium tracking-tight mb-3">
        {content.frameworkHeading}
      </h2>
      <p class="text-body-md text-body leading-relaxed mb-8">
        {content.frameworkIntro}
      </p>

      <div class="flex flex-col gap-5">
        <!-- Tier 1 -->
        <div class="bg-surface-soft border border-hairline rounded-lg p-6">
          <div class="flex items-start gap-4">
            <span class="w-9 h-9 rounded-lg bg-primary text-on-primary font-display font-semibold text-sm flex items-center justify-center shrink-0">
              01
            </span>
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-center gap-2 mb-1.5">
                <h3 class="text-title-sm text-ink font-semibold">{content.tier1Title}</h3>
                <span class="text-[11px] font-mono text-muted bg-canvas border border-hairline px-2 py-0.5 rounded">{content.tier1Tag}</span>
              </div>
              <p class="text-body-md text-body leading-relaxed mb-3">
                {content.tier1Intro}
              </p>
              <ul class="list-disc pl-5 text-body-md text-body leading-relaxed space-y-1.5">
                {content.tier1Bullets.map((item) => (
                  <li>
                    <strong class="text-ink">{item.lead}</strong>{item.body}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>

        <!-- Tier 2 -->
        <div class="bg-surface-soft border border-hairline rounded-lg p-6">
          <div class="flex items-start gap-4">
            <span class="w-9 h-9 rounded-lg bg-primary text-on-primary font-display font-semibold text-sm flex items-center justify-center shrink-0">
              02
            </span>
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-center gap-2 mb-1.5">
                <h3 class="text-title-sm text-ink font-semibold">{content.tier2Title}</h3>
                <span class="text-[11px] font-mono text-muted bg-canvas border border-hairline px-2 py-0.5 rounded">{content.tier2Tag}</span>
              </div>
              <p class="text-body-md text-body leading-relaxed mb-3">
                {content.tier2Intro}
              </p>
              <ul class="list-disc pl-5 text-body-md text-body leading-relaxed space-y-1.5">
                {content.tier2Bullets.map((item) => (
                  <li>
                    <strong class="text-ink">{item.lead}</strong>{item.body}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>

        <!-- Tier 3 -->
        <div class="bg-surface-soft border border-hairline rounded-lg p-6">
          <div class="flex items-start gap-4">
            <span class="w-9 h-9 rounded-lg bg-primary text-on-primary font-display font-semibold text-sm flex items-center justify-center shrink-0">
              03
            </span>
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-center gap-2 mb-1.5">
                <h3 class="text-title-sm text-ink font-semibold">{content.tier3Title}</h3>
                <span class="text-[11px] font-mono text-muted bg-canvas border border-hairline px-2 py-0.5 rounded">{content.tier3Tag}</span>
              </div>
              <p class="text-body-md text-body leading-relaxed mb-3">
                {content.tier3Intro}
              </p>
              <ul class="list-disc pl-5 text-body-md text-body leading-relaxed space-y-1.5">
                {content.tier3Bullets.map((item) => (
                  <li>
                    <strong class="text-ink">{item.lead}</strong>{item.body}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>

        <!-- Tier 4 -->
        <div id="review-protocol" class="bg-surface-soft border border-hairline rounded-lg p-6">
          <div class="flex items-start gap-4">
            <span class="w-9 h-9 rounded-lg bg-primary text-on-primary font-display font-semibold text-sm flex items-center justify-center shrink-0">
              04
            </span>
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-center gap-2 mb-1.5">
                <h3 class="text-title-sm text-ink font-semibold">{content.tier4Title}</h3>
                <span class="text-[11px] font-mono text-muted bg-canvas border border-hairline px-2 py-0.5 rounded">{content.tier4Tag}</span>
              </div>
              <p class="text-body-md text-body leading-relaxed mb-3">
                {content.tier4Intro}
              </p>
              <ul class="list-disc pl-5 text-body-md text-body leading-relaxed space-y-1.5">
                <li>
                  <strong class="text-ink">{content.tier4AuditLead}</strong>{content.tier4AuditBody}
                </li>
                <li>
                  <strong class="text-ink">{content.tier4CorrectionsLead}</strong>{content.tier4CorrectionsBeforeLink}<a href={getDirectoryUrl('contact', lang)} class="text-link hover:underline font-medium">{content.tier4CorrectionsLinkLabel}</a>{content.tier4CorrectionsBetween}<!--email_off--><a href="mailto:editorial@isitkitchensafe.com" class="text-link hover:underline font-medium">editorial@isitkitchensafe.com</a><!--/email_off-->{content.tier4CorrectionsAfterEmail}
                </li>
                <li>
                  <strong class="text-ink">{content.tier4IndependenceLead}</strong>{content.tier4IndependenceBody}
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Interactive Regulatory & Food-Science Standards Citation Directory -->
    <section id="standards-directory" class="mb-14 scroll-mt-24" aria-labelledby="standards-directory-heading">
      <div class="flex flex-wrap items-end justify-between gap-3 mb-3">
        <div>
          <span class="text-xs font-semibold uppercase tracking-wider text-signature-coral block mb-1">
            {content.standardsEyebrow}
          </span>
          <h2 id="standards-directory-heading" class="text-title-lg text-ink font-medium tracking-tight">
            {content.standardsHeading}
          </h2>
        </div>
        <p
          data-standards-count
          data-count-template={content.standardsCountTemplate}
          class="text-xs font-mono text-muted"
          aria-live="polite"
        >
          {content.standardsCountInitial}
        </p>
      </div>
      <p class="text-body-md text-body leading-relaxed mb-5">
        {content.standardsIntro}
      </p>

      <!-- Search & Filter Controls -->
      <div class="bg-surface-soft border border-hairline rounded-lg p-4 mb-5 space-y-3.5">
        <div class="relative">
          <label for="standards-search-input" class="sr-only">
            {content.standardsSearchLabel}
          </label>
          <input
            id="standards-search-input"
            type="search"
            data-standards-search
            placeholder={content.standardsSearchPlaceholder}
            class="w-full min-h-[42px] pl-3.5 pr-20 py-2 rounded-md bg-canvas border border-hairline text-ink placeholder:text-muted text-sm focus:border-link transition-colors"
          />
          <button
            type="button"
            data-standards-clear
            class="hidden absolute right-2 top-1/2 -translate-y-1/2 px-2.5 py-1 text-xs font-medium text-muted hover:text-ink bg-surface-soft border border-hairline rounded transition-colors cursor-pointer"
          >
            {content.standardsClearBtn}
          </button>
        </div>

        <div class="flex flex-wrap gap-2" role="group" aria-label={content.standardsFilterAria}>
          {content.standardCategories.map((cat, idx) => (
            <button
              type="button"
              data-category-pill={cat.id}
              aria-pressed={idx === 0 ? 'true' : 'false'}
              class={
                idx === 0
                  ? 'min-h-[36px] px-3.5 py-1.5 rounded-full text-xs font-medium border border-primary bg-primary text-on-primary transition-colors cursor-pointer'
                  : 'min-h-[36px] px-3.5 py-1.5 rounded-full text-xs font-medium border border-hairline bg-canvas text-ink hover:bg-surface-strong/40 transition-colors cursor-pointer'
              }
            >
              {cat.label}
            </button>
          ))}
        </div>
      </div>

      <!-- Standards Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {content.standardsDirectory.map((std) => (
          <article
            data-standard-card
            data-category={std.category}
            data-search-text={`${std.code} ${std.categoryLabel} ${std.title} ${std.metrics} ${std.summary} ${std.keywords}`}
            class="bg-surface-soft border border-hairline rounded-lg p-5 flex flex-col gap-3"
          >
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span class="text-[11px] font-mono font-semibold text-ink bg-canvas border border-hairline px-2.5 py-0.5 rounded">
                {std.code}
              </span>
              <span class="text-[11px] font-medium text-muted">
                {std.categoryLabel}
              </span>
            </div>

            <h3 class="text-title-sm text-ink font-semibold leading-snug">
              {std.title}
            </h3>

            <p class="text-[12px] font-mono text-ink bg-canvas border border-hairline rounded-md px-3 py-2 leading-relaxed">
              {std.metrics}
            </p>

            <p class="text-body-md text-body leading-relaxed">
              {std.summary}
            </p>

            <div class="pt-2.5 mt-auto border-t border-hairline flex items-center justify-between gap-2">
              <span class="text-[11px] uppercase tracking-wider text-muted font-semibold">{content.standardsAppliedLabel}</span>
              <a
                href={translatePath(std.toolPath)}
                class="text-xs font-medium text-link hover:underline inline-flex items-center gap-1"
              >
                {std.toolLabel} &rarr;
              </a>
            </div>
          </article>
        ))}
      </div>

      <!-- Empty Filter State -->
      <div
        data-standards-empty
        class="hidden bg-surface-soft border border-hairline rounded-lg p-6 text-center mt-4"
      >
        <p class="text-body-md text-ink font-medium mb-2">
          {content.standardsEmptyTitle}
        </p>
        <p class="text-xs text-muted mb-4">
          {content.standardsEmptyDesc}
        </p>
        <button
          type="button"
          data-standards-reset
          class="min-h-[38px] px-4 py-1.5 rounded-md bg-primary hover:bg-primary-active text-on-primary text-xs font-medium transition-colors cursor-pointer"
        >
          {content.standardsResetBtn}
        </button>
      </div>
    </section>

    <!-- Material Threshold Reference Table -->
    <section class="mb-14" aria-labelledby="thresholds-heading">
      <h2 id="thresholds-heading" class="text-title-lg text-ink font-medium tracking-tight mb-3">
        {content.thresholdsHeading}
      </h2>
      <p class="text-body-md text-body leading-relaxed mb-5">
        {content.thresholdsIntro}
      </p>

      <div class="overflow-x-auto border border-hairline rounded-lg bg-canvas">
        <table class="w-full text-left border-collapse text-[13px]">
          <thead>
            <tr class="bg-surface-soft border-b border-hairline text-ink">
              <th scope="col" class="py-3 px-4 font-semibold">{content.tableHeaders[0]}</th>
              <th scope="col" class="py-3 px-4 font-semibold">{content.tableHeaders[1]}</th>
              <th scope="col" class="py-3 px-4 font-semibold">{content.tableHeaders[2]}</th>
              <th scope="col" class="py-3 px-4 font-semibold">{content.tableHeaders[3]}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-hairline">
            {content.thresholdRows.map((row) => (
              <tr class="hover:bg-surface-soft/60 transition-colors">
                <td class="py-3.5 px-4 font-medium text-ink align-top">{row.material}</td>
                <td class="py-3.5 px-4 text-body align-top">{row.threshold}</td>
                <td class="py-3.5 px-4 text-body align-top">{row.hazard}</td>
                <td class="py-3.5 px-4 text-muted font-mono text-[12px] align-top">{row.standard}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Verifiable Editorial Review & Platform Changelog Card -->
    <section id="editorial-changelog" class="mb-14 bg-surface-soft border border-hairline rounded-lg p-6" aria-labelledby="changelog-heading">
      <div class="flex flex-wrap items-center justify-between gap-3 mb-4 pb-4 border-b border-hairline">
        <div>
          <span class="text-xs font-semibold uppercase tracking-wider text-signature-coral block mb-1">
            {content.changelogEyebrow}
          </span>
          <h2 id="changelog-heading" class="text-title-lg text-ink font-medium tracking-tight">
            {content.changelogHeading}
          </h2>
        </div>
        <div class="flex flex-wrap items-center gap-2 text-xs">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-canvas border border-hairline text-ink font-mono font-medium">
            <span class="w-2 h-2 rounded-full bg-success"></span>
            {content.changelogBadgePages}
          </span>
          <span class="inline-flex items-center px-3 py-1 rounded-full bg-canvas border border-hairline text-muted font-mono">
            {content.changelogBadgeDate}
          </span>
        </div>
      </div>

      <!-- 4-Step Verification Workflow -->
      <h3 class="text-title-sm text-ink font-semibold mb-3">
        {content.workflowHeading}
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 mb-6">
        {content.workflowSteps.map((item) => (
          <div class="bg-canvas border border-hairline rounded-lg p-4 flex items-start gap-3">
            <span class="w-7 h-7 rounded-md bg-primary text-on-primary font-mono font-semibold text-xs flex items-center justify-center shrink-0">
              {item.step}
            </span>
            <div class="min-w-0">
              <h4 class="text-sm font-semibold text-ink mb-1">{item.title}</h4>
              <p class="text-xs text-body leading-relaxed">{item.detail}</p>
            </div>
          </div>
        ))}
      </div>

      <!-- Recent Milestones -->
      <h3 class="text-title-sm text-ink font-semibold mb-3">
        {content.milestonesHeading}
      </h3>
      <ol class="space-y-3">
        {content.changelogEntries.map((entry) => (
          <li class="bg-canvas border border-hairline rounded-lg p-4 flex flex-col sm:flex-row sm:items-start gap-2.5 sm:gap-4">
            <div class="flex items-center gap-2 shrink-0">
              <span class="text-xs font-mono font-semibold text-ink bg-surface-soft border border-hairline px-2.5 py-0.5 rounded">
                {entry.date}
              </span>
              <span class="text-[11px] font-medium text-muted">
                {entry.badge}
              </span>
            </div>
            <p class="text-body-md text-body leading-relaxed">
              {entry.summary}
            </p>
          </li>
        ))}
      </ol>
    </section>

    <!-- Interactive Verification Tools Strip -->
    <section id="verification-tools" class="mb-14" aria-labelledby="verification-tools-heading">
      <div class="mb-5">
        <span class="text-xs font-semibold uppercase tracking-wider text-signature-coral block mb-1">
          {content.toolsStripEyebrow}
        </span>
        <h2 id="verification-tools-heading" class="text-title-lg text-ink font-medium tracking-tight mb-2">
          {content.toolsStripHeading}
        </h2>
        <p class="text-body-md text-body leading-relaxed">
          {content.toolsStripIntro}
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5">
        {content.verificationTools.map((tool) => (
          <a
            href={translatePath(tool.path)}
            class="group bg-surface-soft hover:bg-surface-strong/40 border border-hairline rounded-lg p-4 flex flex-col gap-2 transition-colors"
          >
            <span class="text-[11px] font-mono text-muted">
              {tool.tag}
            </span>
            <h3 class="text-sm font-semibold text-ink group-hover:text-link transition-colors">
              {tool.title}
            </h3>
            <p class="text-xs text-body leading-relaxed">
              {tool.desc}
            </p>
            <span class="text-xs font-medium text-link mt-auto pt-2 inline-flex items-center gap-1">
              {content.toolsOpenLabel} &rarr;
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- Related Trust & Utility Links -->
    <section class="bg-surface-soft border border-hairline rounded-lg p-6">
      <h2 class="text-title-sm text-ink font-semibold mb-2">{content.relatedHeading}</h2>
      <p class="text-body-md text-muted leading-relaxed mb-5">
        {content.relatedDesc}
      </p>
      <div class="flex flex-wrap gap-3">
        <a
          href={getDirectoryUrl('about', lang)}
          class="min-h-[40px] px-4 py-2 bg-canvas hover:bg-surface-strong/40 text-ink border border-hairline rounded-md text-xs font-medium inline-flex items-center gap-1.5 transition-colors"
        >
          {content.linkAbout} &rarr;
        </a>
        <a
          href={getDirectoryUrl('tools', lang)}
          class="min-h-[40px] px-4 py-2 bg-canvas hover:bg-surface-strong/40 text-ink border border-hairline rounded-md text-xs font-medium inline-flex items-center gap-1.5 transition-colors"
        >
          {content.linkTools} &rarr;
        </a>
        <a
          href={getDirectoryUrl('saved', lang)}
          class="min-h-[40px] px-4 py-2 bg-primary hover:bg-primary-active text-on-primary rounded-md text-xs font-medium inline-flex items-center gap-1.5 transition-colors"
        >
          {content.linkSaved} &rarr;
        </a>
        <a
          href={getDirectoryUrl('disclaimer', lang)}
          class="min-h-[40px] px-4 py-2 bg-canvas hover:bg-surface-strong/40 text-muted hover:text-ink border border-hairline rounded-md text-xs font-medium inline-flex items-center gap-1.5 transition-colors"
        >
          {content.linkDisclaimer}
        </a>
        <a
          href={getDirectoryUrl('contact', lang)}
          class="min-h-[40px] px-4 py-2 bg-canvas hover:bg-surface-strong/40 text-muted hover:text-ink border border-hairline rounded-md text-xs font-medium inline-flex items-center gap-1.5 transition-colors"
        >
          {content.linkReport}
        </a>
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      var root = document.getElementById('standards-directory');
      if (!root) return;

      var searchInput = root.querySelector('[data-standards-search]');
      var clearBtn = root.querySelector('[data-standards-clear]');
      var resetBtn = root.querySelector('[data-standards-reset]');
      var countEl = root.querySelector('[data-standards-count]');
      var emptyEl = root.querySelector('[data-standards-empty]');
      var pills = root.querySelectorAll('[data-category-pill]');
      var cards = root.querySelectorAll('[data-standard-card]');

      var activeCategory = 'all';
      var totalCount = cards.length;
      var countTemplate = countEl
        ? (countEl.getAttribute('data-count-template') || '{shown} / {total}')
        : '{shown} / {total}';

      function updatePillStyles() {
        for (var i = 0; i < pills.length; i++) {
          var pill = pills[i];
          var cat = pill.getAttribute('data-category-pill');
          var isActive = cat === activeCategory;
          pill.setAttribute('aria-pressed', isActive ? 'true' : 'false');
          if (isActive) {
            pill.classList.add('bg-primary', 'text-on-primary', 'border-primary');
            pill.classList.remove('bg-canvas', 'text-ink', 'border-hairline', 'hover:bg-surface-strong/40');
          } else {
            pill.classList.remove('bg-primary', 'text-on-primary', 'border-primary');
            pill.classList.add('bg-canvas', 'text-ink', 'border-hairline', 'hover:bg-surface-strong/40');
          }
        }
      }

      function applyFilter() {
        var query = searchInput ? searchInput.value.trim().toLowerCase() : '';
        var shown = 0;

        for (var i = 0; i < cards.length; i++) {
          var card = cards[i];
          var cardCat = card.getAttribute('data-category') || '';
          var haystack = (card.getAttribute('data-search-text') || '').toLowerCase();
          var matchesCat = activeCategory === 'all' || cardCat === activeCategory;
          var matchesQuery = !query || haystack.indexOf(query) !== -1;
          var visible = matchesCat && matchesQuery;

          card.classList.toggle('hidden', !visible);
          if (visible) shown++;
        }

        if (countEl) {
          countEl.textContent = countTemplate
            .replace('{shown}', String(shown))
            .replace('{total}', String(totalCount));
        }

        if (emptyEl) {
          emptyEl.classList.toggle('hidden', shown > 0);
        }

        if (clearBtn) {
          clearBtn.classList.toggle('hidden', query.length === 0);
        }
      }

      for (var i = 0; i < pills.length; i++) {
        pills[i].addEventListener('click', function (event) {
          var btn = event.currentTarget;
          activeCategory = btn.getAttribute('data-category-pill') || 'all';
          updatePillStyles();
          applyFilter();
        });
      }

      if (searchInput) {
        searchInput.addEventListener('input', applyFilter);
      }

      if (clearBtn) {
        clearBtn.addEventListener('click', function () {
          if (searchInput) {
            searchInput.value = '';
            searchInput.focus();
          }
          applyFilter();
        });
      }

      if (resetBtn) {
        resetBtn.addEventListener('click', function () {
          activeCategory = 'all';
          if (searchInput) {
            searchInput.value = '';
          }
          updatePillStyles();
          applyFilter();
        });
      }

      updatePillStyles();
      applyFilter();
    })();
  </script>
</Layout>
