import type { SupportedLanguage } from '../../../i18n/ui';

export function getStaticPaths() {
  const paths: Array<{
    params: { lang: string; appliance: string };
    props: { lang: SupportedLanguage; appliance: string; items: any[]; availableLocales: SupportedLanguage[] };
  }> = [];

  const esAppliances = [...new Set(itemsEs.map(i => i.appliance))];
  const ptAppliances = [...new Set(itemsPt.map(i => i.appliance))];
  const zhAppliances = [...new Set(itemsZh.map(i => i.appliance))];
  const jaAppliances = [...new Set(itemsJa.map(i => i.appliance))];

  const allLangs: Array<{ lang: SupportedLanguage; list: any[]; apps: string[] }> = [
    { lang: 'es', list: itemsEs, apps: esAppliances },
    { lang: 'pt', list: itemsPt, apps: ptAppliances },
    { lang: 'zh-cn', list: itemsZh, apps: zhAppliances },
    { lang: 'ja', list: itemsJa, apps: jaAppliances },
  ];

  allLangs.forEach(({ lang, list, apps }) => {
    apps.forEach(app => {
      const items = list.filter(i => i.appliance === app);
      const availableLocales: SupportedLanguage[] = ['en'];
      if (esAppliances.includes(app)) availableLocales.push('es');
      if (ptAppliances.includes(app)) availableLocales.push('pt');
      if (zhAppliances.includes(app)) availableLocales.push('zh-cn');
      if (jaAppliances.includes(app)) availableLocales.push('ja');

      paths.push({
        params: { lang, appliance: app },
        props: { lang, appliance: app, items, availableLocales }
      });
    });
  });

  return paths;
}

interface Props {
  lang: SupportedLanguage;
  appliance: string;
  items: any[];
  availableLocales: SupportedLanguage[];
}

const { lang, appliance, items: applianceItems, availableLocales } = Astro.props as Props;

const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

// Helper to format appliance names
function formatApplianceName(app: string) {
  const appKey = `appliance.${app}` as any;
  return t(appKey) || (app.charAt(0).toUpperCase() + app.slice(1));
}

const formattedAppliance = formatApplianceName(appliance);
