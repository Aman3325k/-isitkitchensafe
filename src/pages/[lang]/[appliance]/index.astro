    dishwasher: "食洗機の安全ガイド一覧。安全基準に基づき、食洗機で洗える食器、保存容器、調理器具をご確認いただけます。",
    microwave: "電子レンジの安全ガイド一覧。火災や破損の危険なく、安全に加熱できる容器、素材、食品をご確認いただけます。",
    freezer: "冷凍庫の安全ガイド一覧。容器の破損や品質劣化を防ぎ、安全に冷凍保存できるアイテムをご確認いただけます。",
    oven: "オーブンの安全ガイド一覧。高温のオーブン調理に耐えられる耐熱容器や安全な素材をご確認いただけます。",
    dryer: "乾燥機の安全ガイド一覧。縮みや熱損傷を防ぎ、安心して衣類乾燥機にかけられる衣類や素材をご確認いただけます。",
    airfryer: "ノンフライヤーの安全ガイド一覧。熱風調理に適した安全な調理器具、容器、食材をご確認いただけます。",
    refrigerator: "冷蔵庫の安全ガイド一覧。食材の鮮度を保ち、衛生的に冷蔵保存できる食品や保存容器をご確認いただけます。"
  },
  en: {} as any
};

const pageTitles: Record<SupportedLanguage, (app: string) => string> = {
  en: (app) => `${app} Kitchen Safety Guides | IsItKitchenSafe`,
  es: (app) => `Guías de Seguridad para ${app} | ¿Es Seguro en la Cocina?`,
  pt: (app) => `Guias de Segurança para ${app} | É Seguro na Cozinha?`,
  'zh-cn': (app) => `${app}安全使用指南 | 厨房安全指南`,
  ja: (app) => `${app}の安全性・使用ガイド | キッチン安全チェッカー`
};

const pageTitle = (pageTitles[lang] || pageTitles.en)(formattedAppliance);

const pageDescription = categoryDescriptions[lang]?.[appliance] || (
  lang === 'es'
    ? `Explora todas las guías de seguridad para ${formattedAppliance}. Descubre qué artículos se pueden meter de forma segura.`
    : lang === 'pt'
    ? `Explore todos os guias de segurança para ${formattedAppliance}. Descubra quais itens podem ser colocados com segurança.`
    : lang === 'zh-cn'
    ? `浏览${formattedAppliance}的所有安全指南。了解哪些日常物品可以安全使用。`
    : `${formattedAppliance}の安全ガイド一覧。安心して使用できるアイテムをご確認いただけます。`
);

const faqs = applianceFaqs[lang]?.[appliance] || [];
---

<Layout 
  title={pageTitle} 
  description={pageDescription} 
  faqs={faqs} 
  excludeArticleSchema={true}
  lang={lang}
  availableLocales={availableLocales}
>
  <!-- Hero Section -->
  <section class={`${styles.bg} ${styles.text} py-[64px] md:py-[80px]`}>
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs 
        isDarkBg={styles.bg === 'bg-signature-forest' || styles.bg === 'bg-signature-coral'}
        items={[
          { label: t('nav.home'), href: translatePath('/') },
          { label: formattedAppliance }
        ]}
        className="mb-6"
      />
      
      <h1 class="text-display-lg font-medium tracking-tight mb-4">
        {lang === 'es' ? `Guías de Seguridad: ${formattedAppliance}` : 
         lang === 'pt' ? `Guias de Segurança: ${formattedAppliance}` :
         lang === 'zh-cn' ? `${formattedAppliance}安全指南` :
         `${formattedAppliance} 安全ガイド`}
      </h1>
      <p class={`${styles.subText} text-body-md max-w-2xl leading-relaxed`}>
        {pageDescription}
      </p>
    </div>
  </section>

  <!-- Items Grid Section -->
  <section class="max-w-[1280px] mx-auto px-6 py-[96px]">
    <div class="flex flex-col md:flex-row md:items-end justify-between border-b border-hairline pb-8 mb-12">
      <div>
        <h2 class="text-display-md text-ink tracking-tight mb-2">
          {lang === 'es' ? `Artículos Evaluados (${applianceItems.length})` : 
           lang === 'pt' ? `Itens Avaliados (${applianceItems.length})` :
           lang === 'zh-cn' ? `已评估物品 (${applianceItems.length})` :
           `評価済みアイテム (${applianceItems.length})`}
        </h2>
        <p class="text-body-md text-muted">
          {lang === 'es' ? `Lista completa de artículos cotidianos analizados para ${formattedAppliance}.` : 
           lang === 'pt' ? `Lista completa de itens cotidianos analisados para ${formattedAppliance}.` :
           lang === 'zh-cn' ? `针对${formattedAppliance}评估的日常物品与材料完整清单。` :
           `${formattedAppliance}に対応しているか検証済みの日常アイテム・素材一覧。`}
        </p>
      </div>
      
      <!-- Static Quick Filter -->
      <div class="mt-6 md:mt-0 flex gap-3 max-w-[320px] w-full">
        <input 
          type="text" 
          id="filter-input"
          placeholder={lang === 'es' ? `Buscar artículos de ${formattedAppliance}...` : 
                       lang === 'pt' ? `Pesquisar itens de ${formattedAppliance}...` :
                       lang === 'zh-cn' ? `搜索${formattedAppliance}相关物品...` :
                       `${formattedAppliance}の対象アイテムを検索...`}
          aria-label={lang === 'es' ? `Buscar artículos de ${formattedAppliance}` : 
                      lang === 'pt' ? `Pesquisar itens de ${formattedAppliance}` :
                      lang === 'zh-cn' ? `搜索${formattedAppliance}相关物品` :
                      `${formattedAppliance}の対象アイテムを検索`}
          class="w-full h-11 px-3 py-2 bg-canvas text-ink text-[16px] md:text-[14px] border border-hairline rounded-sm focus:outline-none focus:border-info-border"
        />
      </div>
    </div>

    <!-- Items Grid -->
    <div id="items-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {applianceItems.map((item: any) => (
        <div 
          class="item-card bg-canvas border border-hairline rounded-md p-6 flex flex-col justify-between shadow-xs transition-all hover:border-border-strong"
          data-name={item.item.toLowerCase()}
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-caption text-muted uppercase tracking-wider text-xs">{formattedAppliance}</span>
              {item.safe === 'yes' && <span class="badge-yes">{t('verdict.yes')}</span>}
              {item.safe === 'no' && <span class="badge-no">{t('verdict.no')}</span>}
              {item.safe === 'depends' && <span class="badge-depends">{t('verdict.depends')}</span>}
            </div>
            
            <h3 class="text-title-sm text-ink mb-3">
              {lang === 'zh-cn' ? `${item.item}可以${applianceInPhrase}吗？` :
               lang === 'ja' ? `${item.item}は${applianceInPhrase}入れても大丈夫？` :
               `${t('page.canYouPut')} ${item.item} ${applianceInPhrase}?`}
            </h3>
            
            <p class="text-body-md text-body leading-relaxed mb-6">
              {item.shortAnswer}
            </p>
          </div>
          
          <a 
            href={`/${lang}/${item.appliance}/${item.slug}/`} 
            class="text-link text-[14px] font-medium hover:text-link-active transition-colors min-h-[44px] inline-flex items-center gap-1 group mt-2 -ml-1 px-1"
          >
            {t('page.readDetailedBreakdown')} <span class="group-hover:translate-x-0.5 transition-transform">&rarr;</span>
          </a>
        </div>
      ))}
    </div>

    <!-- No results message -->
    <div id="no-results" class="hidden text-center py-12">
      <p class="text-title-md text-muted">
        {lang === 'es' ? 'No se encontraron artículos que coincidan con tu búsqueda.' : 
         lang === 'pt' ? 'Nenhum item encontrado para sua pesquisa.' :
         lang === 'zh-cn' ? '未找到符合搜索条件的物品。' :
         '検索条件に一致するアイテムが見つかりませんでした。'}
      </p>
    </div>
  </section>

  <!-- Related Categories Section -->
  <section class="border-t border-hairline bg-surface-soft/40 py-16">
    <div class="max-w-[1280px] mx-auto px-6">
      <h2 class="text-title-lg text-ink font-medium tracking-tight mb-8">
        {lang === 'es' ? 'Categorías y Electrodomésticos Relacionados' : 
         lang === 'pt' ? 'Categorias e Eletrodomésticos Relacionados' :
         lang === 'zh-cn' ? '相关电器与专项安全分类' :
         '関連する家電・安全性カテゴリ'}
      </h2>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
        {['dishwasher', 'microwave', 'freezer', 'oven', 'dryer', 'airfryer', 'refrigerator']
          .filter(app => app !== appliance)
          .map(app => (
            <a href={getApplianceUrl(app, lang)} class="p-5 bg-canvas border border-hairline rounded-md hover:border-border-strong shadow-xs text-decoration-none transition-colors active:scale-[0.98] block">
              <span class="text-xs uppercase tracking-wider text-muted font-bold block mb-1">
                {lang === 'es' ? 'Guía de Electrodoméstico' : 
                 lang === 'pt' ? 'Guia de Eletrodoméstico' :
                 lang === 'zh-cn' ? '电器指南' :
                 '家電ガイド'}
              </span>
              <h3 class="text-title-sm text-ink mb-1 font-medium flex items-center justify-between">
                <span>{formatApplianceName(app)}</span>
                {lang !== 'en' && !isApplianceTranslatedInLocale(app, lang) && (
                  <span class="text-[9px] font-semibold text-muted bg-surface-soft border border-hairline px-1 py-0.5 rounded tracking-wider uppercase" title="Available in English only">EN</span>
                )}
              </h3>
              <span class="text-xs text-link">{t('home.viewAll')} &rarr;</span>
            </a>
          ))
        }
        
        <a href={getDirectoryUrl('how-long', lang)} class="p-5 bg-canvas border border-hairline rounded-md hover:border-border-strong shadow-xs text-decoration-none transition-colors active:scale-[0.98] block">
          <span class="text-xs uppercase tracking-wider text-muted font-bold block mb-1">{t('footer.shelfLife')}</span>
          <h3 class="text-title-sm text-ink mb-1 font-medium flex items-center justify-between">
            <span>{t('nav.howLong')}</span>
            {lang !== 'en' && !isDirectoryTranslatedInLocale('how-long', lang) && (
              <span class="text-[9px] font-semibold text-muted bg-surface-soft border border-hairline px-1 py-0.5 rounded tracking-wider uppercase" title="Available in English only">EN</span>
            )}
          </h3>
          <span class="text-xs text-link">{t('home.viewAll')} &rarr;</span>
        </a>
        <a href={getDirectoryUrl('refreeze', lang)} class="p-5 bg-canvas border border-hairline rounded-md hover:border-border-strong shadow-xs text-decoration-none transition-colors active:scale-[0.98] block">
          <span class="text-xs uppercase tracking-wider text-muted font-bold block mb-1">{t('footer.refreeze')}</span>
          <h3 class="text-title-sm text-ink mb-1 font-medium flex items-center justify-between">
            <span>{t('nav.refreeze')}</span>
            {lang !== 'en' && !isDirectoryTranslatedInLocale('refreeze', lang) && (
              <span class="text-[9px] font-semibold text-muted bg-surface-soft border border-hairline px-1 py-0.5 rounded tracking-wider uppercase" title="Available in English only">EN</span>
            )}
          </h3>
          <span class="text-xs text-link">{t('home.viewAll')} &rarr;</span>
        </a>
        <a href={getDirectoryUrl('washing-machine', lang)} class="p-5 bg-canvas border border-hairline rounded-md hover:border-border-strong shadow-xs text-decoration-none transition-colors active:scale-[0.98] block">
          <span class="text-xs uppercase tracking-wider text-muted font-bold block mb-1">{t('footer.washingMachine')}</span>
          <h3 class="text-title-sm text-ink mb-1 font-medium flex items-center justify-between">
            <span>{t('nav.washingMachine')}</span>
            {lang !== 'en' && !isDirectoryTranslatedInLocale('washing-machine', lang) && (
              <span class="text-[9px] font-semibold text-muted bg-surface-soft border border-hairline px-1 py-0.5 rounded tracking-wider uppercase" title="Available in English only">EN</span>
            )}
          </h3>
          <span class="text-xs text-link">{t('home.viewAll')} &rarr;</span>
        </a>
        <a href={getDirectoryUrl('what-happens', lang)} class="p-5 bg-canvas border border-hairline rounded-md hover:border-border-strong shadow-xs text-decoration-none transition-colors active:scale-[0.98] block">
          <span class="text-xs uppercase tracking-wider text-muted font-bold block mb-1">{t('footer.emergencyScenarios')}</span>
          <h3 class="text-title-sm text-ink mb-1 font-medium flex items-center justify-between">
            <span>{t('nav.whatHappens')}</span>
            {lang !== 'en' && !isDirectoryTranslatedInLocale('what-happens', lang) && (
              <span class="text-[9px] font-semibold text-muted bg-surface-soft border border-hairline px-1 py-0.5 rounded tracking-wider uppercase" title="Available in English only">EN</span>
            )}
          </h3>
          <span class="text-xs text-link">{t('home.viewAll')} &rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Client-side filtering script -->
  <script is:inline>
    const filterInput = document.getElementById('filter-input');
    const itemsGrid = document.getElementById('items-grid');
    const noResults = document.getElementById('no-results');

    if (filterInput && itemsGrid) {
      const cards = itemsGrid.getElementsByClassName('item-card');
      
      filterInput.addEventListener('input', (e) => {
        const query = e.target.value.trim().toLowerCase();
        let matches = 0;
        
        for (let i = 0; i < cards.length; i++) {
          const card = cards[i];
          const name = card.getAttribute('data-name');
          
          if (name && name.includes(query)) {
            card.classList.remove('hidden');
            matches++;
          } else {
            card.classList.add('hidden');
          }
        }
        
        if (matches === 0) {
          noResults.classList.remove('hidden');
        } else {
          noResults.classList.add('hidden');
        }
      });
    }
  </script>
</Layout>
