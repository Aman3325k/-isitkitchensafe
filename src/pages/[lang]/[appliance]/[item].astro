---
import ItemPageTemplate from '../../../components/ItemPageTemplate.astro';
import itemsEs from '../../../data/items.es.json';
import itemsPt from '../../../data/items.pt.json';
import itemsZh from '../../../data/items.zh-cn.json';
import itemsJa from '../../../data/items.ja.json';
import type { SupportedLanguage } from '../../../i18n/ui';

export function getStaticPaths() {
  const esSlugs = new Set(itemsEs.map(i => `${i.appliance}/${i.slug}`));
  const ptSlugs = new Set(itemsPt.map(i => `${i.appliance}/${i.slug}`));
  const zhSlugs = new Set(itemsZh.map(i => `${i.appliance}/${i.slug}`));
  const jaSlugs = new Set(itemsJa.map(i => `${i.appliance}/${i.slug}`));

  const paths: Array<{
    params: { lang: string; appliance: string; item: string };
    props: { data: any; lang: SupportedLanguage; availableLocales: SupportedLanguage[] };
  }> = [];

  function getAvailableLocales(key: string): SupportedLanguage[] {
    const available: SupportedLanguage[] = ['en'];
    if (esSlugs.has(key)) available.push('es');
    if (ptSlugs.has(key)) available.push('pt');
    if (zhSlugs.has(key)) available.push('zh-cn');
    if (jaSlugs.has(key)) available.push('ja');
    return available;
  }

  // Spanish items
  itemsEs.forEach((item) => {
    const key = `${item.appliance}/${item.slug}`;
    paths.push({
      params: {
        lang: 'es',
        appliance: item.appliance,
        item: item.slug
      },
      props: {
        data: item,
        lang: 'es',
        availableLocales: getAvailableLocales(key)
      }
    });
  });

  // Portuguese items
  itemsPt.forEach((item) => {
    const key = `${item.appliance}/${item.slug}`;
    paths.push({
      params: {
        lang: 'pt',
        appliance: item.appliance,
        item: item.slug
      },
      props: {
        data: item,
        lang: 'pt',
        availableLocales: getAvailableLocales(key)
      }
    });
  });

  // Simplified Chinese items
  itemsZh.forEach((item) => {
    const key = `${item.appliance}/${item.slug}`;
    paths.push({
      params: {
        lang: 'zh-cn',
        appliance: item.appliance,
        item: item.slug
      },
      props: {
        data: item,
        lang: 'zh-cn',
        availableLocales: getAvailableLocales(key)
      }
    });
  });

  // Japanese items
  itemsJa.forEach((item) => {
    const key = `${item.appliance}/${item.slug}`;
    paths.push({
      params: {
        lang: 'ja',
        appliance: item.appliance,
        item: item.slug
      },
      props: {
        data: item,
        lang: 'ja',
        availableLocales: getAvailableLocales(key)
      }
    });
  });

  return paths;
}

interface Props {
  data: any;
  lang: SupportedLanguage;
  availableLocales: SupportedLanguage[];
}

const { data, lang, availableLocales } = Astro.props;
---

<ItemPageTemplate data={data} lang={lang} availableLocales={availableLocales} />
