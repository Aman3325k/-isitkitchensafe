---
import ItemPageTemplate from '../../../components/ItemPageTemplate.astro';
import itemsEs from '../../../data/items.es.json';
import itemsPt from '../../../data/items.pt.json';
import type { SupportedLanguage } from '../../../i18n/ui';

export function getStaticPaths() {
  const paths: Array<{
    params: { lang: string; appliance: string; item: string };
    props: { data: any; lang: SupportedLanguage; availableLocales: SupportedLanguage[] };
  }> = [];

  // Spanish items
  itemsEs.forEach((item) => {
    paths.push({
      params: {
        lang: 'es',
        appliance: item.appliance,
        item: item.slug
      },
      props: {
        data: item,
        lang: 'es',
        availableLocales: ['en', 'es', 'pt']
      }
    });
  });

  // Portuguese items
  itemsPt.forEach((item) => {
    paths.push({
      params: {
        lang: 'pt',
        appliance: item.appliance,
        item: item.slug
      },
      props: {
        data: item,
        lang: 'pt',
        availableLocales: ['en', 'es', 'pt']
      }
    });
  });

  return paths;
}

interface Props {
  data: any;
  lang: SupportedLanguage;
  availableLocales: SupportedLanguage[];
}

const { data, lang, availableLocales } = Astro.props;
---

<ItemPageTemplate data={data} lang={lang} availableLocales={availableLocales} />
