---
import ItemPageTemplate from '../../../components/ItemPageTemplate.astro';
import itemsEs from '../../../data/items.es.json';
import itemsPt from '../../../data/items.pt.json';
import type { SupportedLanguage } from '../../../i18n/ui';

export function getStaticPaths() {
  const esSlugs = new Set(itemsEs.map(i => `${i.appliance}/${i.slug}`));
  const ptSlugs = new Set(itemsPt.map(i => `${i.appliance}/${i.slug}`));

  const paths: Array<{
    params: { lang: string; appliance: string; item: string };
    props: { data: any; lang: SupportedLanguage; availableLocales: SupportedLanguage[] };
  }> = [];

  // Spanish items
  itemsEs.forEach((item) => {
    const key = `${item.appliance}/${item.slug}`;
    const availableLocales: SupportedLanguage[] = ['en', 'es'];
    if (ptSlugs.has(key)) availableLocales.push('pt');

    paths.push({
      params: {
        lang: 'es',
        appliance: item.appliance,
        item: item.slug
      },
      props: {
        data: item,
        lang: 'es',
        availableLocales
      }
    });
  });

  // Portuguese items
  itemsPt.forEach((item) => {
    const key = `${item.appliance}/${item.slug}`;
    const availableLocales: SupportedLanguage[] = ['en', 'pt'];
    if (esSlugs.has(key)) availableLocales.push('es');

    paths.push({
      params: {
        lang: 'pt',
        appliance: item.appliance,
        item: item.slug
      },
      props: {
        data: item,
        lang: 'pt',
        availableLocales
      }
    });
  });

  return paths;
}

interface Props {
  data: any;
  lang: SupportedLanguage;
  availableLocales: SupportedLanguage[];
}

const { data, lang, availableLocales } = Astro.props;
---

<ItemPageTemplate data={data} lang={lang} availableLocales={availableLocales} />
