      { slug: 'leftover-shelf-life-calculator', name: '作り置き・残り物保存期間計算ツール', desc: 'USDA基準で調理済み肉・ご飯・パスタの冷蔵・冷凍保存日数をカウントダウン計算。', category: '食品衛生', keywords: '残り物 作り置き 冷蔵庫 保存期間 消費期限 leftover fridge shelf life' },
      { slug: 'meat-thawing-calculator', name: '肉・鶏肉の安全解凍時間計算ツール', desc: '重量から冷蔵解凍・冷水解凍の安全な所要時間を自動計算。', category: '食品衛生', keywords: '肉 鶏肉 牛肉 ターキー 解凍 冷蔵庫 meat thaw defrost' },
      { slug: 'plastic-code-checker', name: 'プラスチック識別番号 (#1–#7) 安全チェッカー', desc: 'PET・HDPE・PVC・LDPE・PP・PSの電子レンジおよび食洗機対応をチェック。', category: '調理器具・表示', keywords: 'プラスチック 番号 リサイクル bpa 電子レンジ 食洗機 plastic code' },
      { slug: 'air-fryer-oven-converter', name: 'ノンフライヤー・オーブン温度時間換算', desc: '通常オーブンのレシピをノンフライヤー・コンベクション設定へ自動変換。', category: '調理換算', keywords: 'ノンフライヤー エアフライヤー オーブン 温度 時間 換算 air fryer oven converter' },
      { slug: 'cookware-oven-temp-lookup', name: '調理器具・耐熱皿オーブン上限温度検索', desc: 'Pyrex・Le Creuset・Lodgeなど主要24ブランドのオーブン耐熱上限を確認。', category: '調理器具・表示', keywords: 'pyrex le creuset lodge corningware stanley オーブン 耐熱温度 上限 cookware oven' },
      { slug: 'internal-cooking-temp-chart', name: 'USDA 安全中心温度・加熱目安表', desc: '鶏肉・牛肉・ひき肉・豚肉・魚介類の安全な中心温度と休ませ時間を一覧検索。', category: '食品衛生', keywords: '中心温度 温度計 鶏肉 ステーキ 豚肉 魚 usda cooking temp' },
      { slug: 'appliance-descaling-calculator', name: 'コーヒーメーカー・ケトル水垢除去計算', desc: 'クエン酸や酢の最適な希釈比率をコーヒーメーカー・電気ケトル・エスプレッソ別に算出。', category: '洗浄・ケア', keywords: '水垢 カルキ クエン酸 酢 コーヒーメーカー ケトル keurig descaling' },
      { slug: 'cleaner-mixing-danger-checker', name: '洗剤「混ぜるな危険」反応チェッカー', desc: '塩素系漂白剤・酢・クエン酸・アンモニアなどの危険な化学反応を事前確認。', category: '洗浄・ケア', keywords: '漂白剤 塩素 クエン酸 酢 アンモニア 混ぜるな危険 有毒ガス bleach cleaner mixing' },
      { slug: 'microwave-wattage-converter', name: '電子レンジワット数加熱時間変換ツール', desc: '600W・700W・900W・1000W・1250W間の加熱時間を正確に換算。', category: '調理換算', keywords: '電子レンジ ワット数 時間 変換 温め microwave wattage' },
      { slug: 'power-outage-food-safety-checker', name: '停電時の冷蔵庫・冷凍庫食品判定ツール', desc: '停電後の経過時間から冷蔵・冷凍食品を食べてよいかUSDA/CDC基準で判定。', category: '食品衛生', keywords: '停電 冷蔵庫 冷凍庫 食材 廃棄 安全 power outage fridge' },
      { slug: 'baby-bottle-safety-checker', name: '哺乳瓶・ベビー食器安全チェッカー', desc: 'AAP/FDA/CDC基準に基づく哺乳瓶・マグの消毒・電子レンジ・食洗機ガイド。', category: '食品衛生', keywords: '哺乳瓶 ベビー 赤ちゃん 消毒 電子レンジ 食洗機 baby bottle' },
      { slug: 'cooking-oil-smoke-point-finder', name: '食用油の発煙点・揚げ物適温検索', desc: 'オリーブ油・アボカド油・バターなど28種の食用油の発煙点と加熱適性を比較。', category: '調理換算', keywords: '食用油 発煙点 オリーブオイル アボカド油 揚げ物 cooking oil smoke point' },
      { slug: 'cast-iron-seasoning-troubleshooter', name: '鋳鉄スキレット・鉄フライパン手入れ診断', desc: 'サビ・ベタつき・油膜剥がれ・洗剤使用の疑問を原因別に解決。', category: '洗浄・ケア', keywords: '鋳鉄 スキレット 鉄フライパン サビ シーズニング 洗剤 lodge cast iron seasoning' },
      { slug: 'fridge-organization-zone-planner', name: '冷蔵庫の安全な棚別収納ゾーニング', desc: '生肉・乳製品・卵・野菜の交差汚染を防ぐUSDA推奨の棚配置マップ。', category: '食品衛生', keywords: '冷蔵庫 収納 棚 温度 生肉 卵 交差汚染 fridge zone planner' },
      { slug: 'kitchen-safety-iq-quiz', name: 'キッチン安全常識クイズ', desc: '2分で日常の調理器具・食品保存の思い込みをチェックできる実践クイズ。', category: '食品衛生', keywords: 'クイズ 常識 テスト 誤解 キッチン安全 kitchen safety quiz' },
      { slug: 'induction-cookware-compatibility-checker', name: 'IH対応調理器具・3秒磁石チェック', desc: 'ステンレス・鋳鉄・銅・アルミ鍋のIHクッキングヒーター対応を素早く確認。', category: '調理器具・表示', keywords: 'ih 調理器具 磁石 ステンレス 鋳鉄 銅 アルミ induction cookware' },
      { slug: 'dishwasher-detergent-dosage-calculator', name: '食洗機洗剤・リンス剤適量計算ツール', desc: '水硬度に合わせた粉末・ジェル・タブレット洗剤量でグラスの白濁を防止。', category: '洗浄・ケア', keywords: '食洗機 洗剤 タブレット ジェル リンス 硬水 グラス白濁 dishwasher detergent' },
      { slug: 'food-allergy-cross-contact-checker', name: '食物アレルギー交差接触チェックツール', desc: 'ピーナッツ・グルテン・乳製品などのアレルゲン残留を防ぐ洗浄方法と器具選び。', category: '食品衛生', keywords: 'アレルギー アレルゲン 交差接触 グルテン ピーナッツ 乳製品 まな板 allergy cross contact' },
      { slug: 'pantry-dry-goods-shelf-life-checker', name: '乾物・スパイス・常温食品保存目安検索', desc: '香辛料・小麦粉・ベーキングパウダー・米・缶詰の品質と安全期限を確認。', category: '食品衛生', keywords: '乾物 スパイス 小麦粉 ベーキングパウダー 米 缶詰 常温保存 pantry dry goods' },
      { slug: 'moldy-food-safety-checker', name: 'カビが生えた食品の安全判定チェッカー', desc: '硬質チーズは切り取って可・パンやジャムは即廃棄などUSDA基準で即判定。', category: '食品衛生', keywords: 'カビ チーズ パン 果物 ジャム 切り取る 廃棄 mold moldy food' },
      { slug: 'oven-rack-bakeware-heat-adjuster', name: 'オーブン段位置・焼き型材質温度調整', desc: 'Pyrexガラス・黒色ノンスティック・陶器・アルミ型に応じた温度と段位置を補正。', category: '調理換算', keywords: 'オーブン 段 焼き型 pyrex ガラス 黒色 ノンスティック 陶器 oven rack bakeware' }
    ]
  }
};

const content = contentByLang[lang as 'es' | 'pt' | 'zh-cn' | 'ja'] || contentByLang.es;

const currentItems = lang === 'es' ? itemsEs : lang === 'pt' ? itemsPt : lang === 'ja' ? itemsJa : itemsZh;
const currentBlog = lang === 'es' ? blogEs : lang === 'pt' ? blogPt : lang === 'ja' ? blogJa : blogZh;
const currentComparisons = lang === 'es' ? comparisonsEs : lang === 'pt' ? comparisonsPt : lang === 'ja' ? comparisonsJa : comparisonsZh;
const currentHowLong = lang === 'es' ? howLongEs : lang === 'pt' ? howLongPt : lang === 'ja' ? howLongJa : howLongZh;
const currentRefreeze = lang === 'es' ? refreezeEs : lang === 'pt' ? refreezePt : lang === 'ja' ? refreezeJa : refreezeZh;
const currentWashingMachine = lang === 'es' ? washingMachineEs : lang === 'pt' ? washingMachinePt : lang === 'ja' ? washingMachineJa : washingMachineZh;
const currentWhatHappens = lang === 'es' ? whatHappensEs : lang === 'pt' ? whatHappensPt : lang === 'ja' ? whatHappensJa : whatHappensZh;

const appliances = ['dishwasher', 'microwave', 'freezer', 'oven', 'dryer', 'airfryer', 'refrigerator'] as const;
const groupedItems = appliances.reduce((acc, app) => {
  acc[app] = currentItems.filter((i) => i.appliance === app);
  return acc;
}, {} as Record<string, typeof currentItems>);

const trustCoreLinks = [
  { label: content.homeLink, href: translatePath('/'), keywords: 'home inicio index' },
  { label: content.toolsHubLink, href: getDirectoryUrl('tools', lang), keywords: 'tools calculators herramientas ferramentas' },
  { label: content.savedLink, href: translatePath('/saved/'), keywords: 'saved bookmarks guardados salvos' },
  { label: content.rssLink, href: '/rss.xml', keywords: 'rss feed xml' }
];

const trustEditorialLinks = [
  { label: content.methodologyLink, href: translatePath('/methodology/'), keywords: 'methodology metodologia usda fda' },
  { label: content.aboutLink, href: translatePath('/about/'), keywords: 'about nosotros nos' },
  { label: content.contactLink, href: translatePath('/contact/'), keywords: 'contact contacto contato support' }
];

const trustPolicyLinks = [
  { label: content.disclaimerLink, href: translatePath('/disclaimer/'), keywords: 'disclaimer legal safety' },
  { label: content.privacyLink, href: translatePath('/privacy/'), keywords: 'privacy privacidad privacidade' },
  { label: content.termsLink, href: translatePath('/terms/'), keywords: 'terms terminos termos' }
];

// Live dynamic counts
const totalTools = content.tools.length;
const totalAppliances = currentItems.length;
const totalMaterials = CATEGORIES.length + 1;
const totalBlog = currentBlog.length;
const totalComparisons = currentComparisons.length;
const totalDirectories = currentHowLong.length + currentRefreeze.length + currentWashingMachine.length + currentWhatHappens.length;
const totalTrust = trustCoreLinks.length + trustEditorialLinks.length + trustPolicyLinks.length;
const totalIndexedLinks = totalTools + totalAppliances + totalMaterials + totalBlog + totalComparisons + totalDirectories + totalTrust;
const initialStatusText = content.msgAll
  .replace('{total}', String(totalIndexedLinks))
  .replace('{sections}', '6');
---

<Layout
  title={content.title}
  description={content.description}
  excludeArticleSchema={true}
  availableLocales={availableLocales}
  lang={lang}
>
  <section class="max-w-[1280px] mx-auto px-6 py-10 md:py-12">
    <!-- Breadcrumbs -->
    <Breadcrumbs
      items={[
        { label: content.home, href: translatePath('/') },
        { label: content.sitemap }
      ]}
    />

    <!-- Hero Header -->
    <header class="max-w-[900px] mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface-soft border border-hairline text-xs font-semibold uppercase tracking-wider text-muted mb-4">
        <span class="w-2 h-2 rounded-full bg-success" aria-hidden="true"></span>
        {content.eyebrow}
      </div>
      <h1 class="text-4xl md:text-5xl font-bold text-ink tracking-tight mb-4">
        {content.h1}
      </h1>
      <p class="text-body text-base md:text-lg leading-relaxed mb-6">
        {content.intro}
      </p>

      <!-- Live KPI Summary Strip -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <div class="p-3.5 rounded-xl bg-surface-soft border border-hairline">
          <div class="text-2xl font-bold text-ink tabular-nums">{totalIndexedLinks.toLocaleString(content.numLocale)}</div>
          <div class="text-xs font-medium text-muted mt-0.5">{content.kpiTotal}</div>
        </div>
        <div class="p-3.5 rounded-xl bg-surface-soft border border-hairline">
          <div class="text-2xl font-bold text-ink tabular-nums">{totalTools}</div>
          <div class="text-xs font-medium text-muted mt-0.5">{content.kpiTools}</div>
        </div>
        <div class="p-3.5 rounded-xl bg-surface-soft border border-hairline">
          <div class="text-2xl font-bold text-ink tabular-nums">{totalAppliances.toLocaleString(content.numLocale)}</div>
          <div class="text-xs font-medium text-muted mt-0.5">{content.kpiAppliances}</div>
        </div>
        <div class="p-3.5 rounded-xl bg-surface-soft border border-hairline">
          <div class="text-2xl font-bold text-ink tabular-nums">{(totalDirectories + totalComparisons + totalBlog + totalMaterials).toLocaleString(content.numLocale)}</div>
          <div class="text-xs font-medium text-muted mt-0.5">{content.kpiReference}</div>
        </div>
      </div>
    </header>

    <!-- Live Instant Sitemap Filter Bar -->
    <div
      id="sitemap-filter-bar"
      class="no-print mb-6 p-5 md:p-6 rounded-2xl bg-surface-soft border border-hairline shadow-xs"
      data-msg-all={content.msgAll}
      data-msg-match={content.msgMatch}
      data-msg-empty={content.msgEmpty}
    >
      <div class="flex flex-col gap-3">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <label for="sitemap-filter-input" class="text-sm font-bold text-ink">
            {content.filterLabel}
          </label>
          <p id="sitemap-filter-status" aria-live="polite" class="text-xs font-medium text-muted">
            {initialStatusText}
          </p>
        </div>

        <div class="relative flex items-center">
          <svg
            class="w-5 h-5 text-muted absolute left-3.5 pointer-events-none"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
          <input
            id="sitemap-filter-input"
            type="search"
            autocomplete="off"
            spellcheck="false"
            placeholder={content.filterPlaceholder}
            class="w-full pl-11 pr-24 py-3 rounded-xl bg-canvas border border-hairline text-ink placeholder:text-muted text-sm md:text-base focus:outline-none focus:border-link transition-colors"
          />
          <button
            id="sitemap-filter-clear"
            type="button"
            class="hidden absolute right-2.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-surface-strong text-ink hover:opacity-85 transition-opacity cursor-pointer"
          >
            {content.filterClear}
          </button>
        </div>

        <!-- Quick Filter Suggestion Chips -->
        <div class="flex flex-wrap items-center gap-2 pt-1">
          <span class="text-xs font-medium text-muted mr-1">{content.filterPopular}</span>
          {content.chips.map((chip) => (
            <button
              type="button"
              data-filter-chip={chip.query}
              aria-pressed="false"
              class="px-2.5 py-1 rounded-full text-xs font-medium bg-canvas border border-hairline text-ink hover:border-link hover:text-link aria-[pressed=true]:bg-primary aria-[pressed=true]:text-on-primary aria-[pressed=true]:border-primary transition-colors cursor-pointer"
            >
              {chip.label}
            </button>
          ))}
        </div>
      </div>
    </div>

    <!-- Quick-Jump Section Anchor Pills -->
    <nav aria-label={content.navAriaLabel} class="no-print mb-10 flex flex-wrap gap-2.5">
      <a href="#section-calculators" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-full text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-link hover:text-link transition-colors">
        <span>{content.pillCalculators}</span>
        <span class="px-1.5 py-0.5 rounded-full bg-surface-soft text-muted text-[11px] tabular-nums">{totalTools}</span>
      </a>
      <a href="#section-appliances" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-full text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-link hover:text-link transition-colors">
        <span>{content.pillAppliances}</span>
        <span class="px-1.5 py-0.5 rounded-full bg-surface-soft text-muted text-[11px] tabular-nums">{totalAppliances}</span>
      </a>
      <a href="#section-guides" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-full text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-link hover:text-link transition-colors">
        <span>{content.pillGuides}</span>
        <span class="px-1.5 py-0.5 rounded-full bg-surface-soft text-muted text-[11px] tabular-nums">{totalBlog + totalMaterials}</span>
      </a>
      <a href="#section-comparisons" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-full text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-link hover:text-link transition-colors">
        <span>{content.pillComparisons}</span>
        <span class="px-1.5 py-0.5 rounded-full bg-surface-soft text-muted text-[11px] tabular-nums">{totalComparisons}</span>
      </a>
      <a href="#section-directories" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-full text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-link hover:text-link transition-colors">
        <span>{content.pillDirectories}</span>
        <span class="px-1.5 py-0.5 rounded-full bg-surface-soft text-muted text-[11px] tabular-nums">{totalDirectories}</span>
      </a>
      <a href="#section-trust" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-full text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-link hover:text-link transition-colors">
        <span>{content.pillTrust}</span>
        <span class="px-1.5 py-0.5 rounded-full bg-surface-soft text-muted text-[11px] tabular-nums">{totalTrust}</span>
      </a>
    </nav>

    <!-- Empty Filter State -->
    <div id="sitemap-empty-state" class="hidden mb-10 p-8 rounded-2xl bg-surface-soft border border-hairline text-center">
      <p class="text-lg font-bold text-ink mb-2">{content.emptyTitle}</p>
      <p class="text-sm text-muted mb-4">{content.emptyDesc}</p>
      <button
        id="sitemap-empty-reset"
        type="button"
        class="px-4 py-2 rounded-lg text-sm font-semibold bg-primary text-on-primary hover:opacity-90 transition-opacity cursor-pointer"
      >
        {content.emptyReset}
      </button>
    </div>

    <!-- 1. Everyday Consumer Kitchen Safety Calculators & Utilities -->
    <section id="section-calculators" data-sitemap-section class="border-t border-hairline pt-8 mb-12 scroll-mt-24">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 mb-6">
        <div>
          <span class="inline-block text-xs font-bold uppercase tracking-wider text-link mb-1">{content.calcEyebrow}</span>
          <h2 class="text-2xl md:text-3xl font-bold text-ink">
            {content.calcTitle}
          </h2>
          <p class="text-sm text-muted mt-1">{content.calcSub}</p>
        </div>
        <a href={getDirectoryUrl('tools', lang)} class="text-sm font-semibold text-link hover:underline shrink-0">
          {content.calcViewAll}
        </a>
      </div>

      <div data-sitemap-card class="rounded-2xl bg-surface-soft/60 border border-hairline p-4 md:p-5">
        <div class="flex items-center justify-between mb-4 pb-2.5 border-b border-hairline">
          <span class="text-xs font-bold uppercase tracking-wider text-muted">{content.calcCardLabel}</span>
          <span data-card-count data-orig-count={String(totalTools)} class="text-xs font-semibold px-2 py-0.5 rounded-full bg-canvas border border-hairline text-ink tabular-nums">
            {totalTools}
          </span>
        </div>
        <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5">
          {content.tools.map((tool) => (
            <li
              data-sitemap-item
              data-search={`${tool.name} ${tool.desc} ${tool.category} ${tool.slug.replace(/-/g, ' ')} ${tool.keywords}`.toLowerCase()}
