---
import Layout from '../../layouts/Layout.astro';
import itemsZh from '../../data/items.zh-cn.json';
import itemsJa from '../../data/items.ja.json';
import howLongData from '../../data/how-long.json';
import washingMachineData from '../../data/washing-machine.json';
import refreezeData from '../../data/refreeze.json';
import whatHappensData from '../../data/what-happens.json';
import blogData from '../../data/blog.json';
import comparisonsData from '../../data/comparisons.json';
import comparisonsZh from '../../data/comparisons.zh-cn.json';
import comparisonsJa from '../../data/comparisons.ja.json';
import { getDirectoryUrl, getApplianceUrl } from '../../i18n/utils';
import { CATEGORIES, CATEGORY_LOCALIZATIONS } from '../../utils/materialCategories';
import type { SupportedLanguage } from '../../i18n/ui';

export function getStaticPaths() {
  return [
    { params: { lang: 'zh-cn' }, props: { lang: 'zh-cn' as SupportedLanguage, availableLocales: ['en', 'zh-cn', 'ja'] as SupportedLanguage[] } },
    { params: { lang: 'ja' }, props: { lang: 'ja' as SupportedLanguage, availableLocales: ['en', 'zh-cn', 'ja'] as SupportedLanguage[] } },
  ];
}

interface Props {
  lang: SupportedLanguage;
  availableLocales: SupportedLanguage[];
}

const { lang, availableLocales } = Astro.props;
const isJa = lang === 'ja';

const content = isJa ? {
  title: "HTMLサイトマップ | キッチン安全チェッカー",
  description: "キッチン安全チェッカーの全ガイド、家電別使用基準、素材別ハブ、および安全リファレンスの完全なHTMLインデックスです。",
  home: "ホーム",
  sitemap: "サイトマップ",
  h1: "HTML サイトマップ",
  intro: "当サイトが提供するすべての家電別安全ガイド、素材別安全性ハブ、食品保存・冷凍期間ガイドライン、およびキッチンの安全に関する全記事を網羅しています。",
  secCore: "主要セクション",
  secCoreTitle: "基本ページ",
  homeLink: "トップページ",
  aboutLink: "運営者情報・理念",
  contactLink: "お問い合わせ",
  privacyLink: "プライバシーポリシー",
  termsLink: "利用規約",
  secMaterials: "素材別安全性ハブ",
  materialsIndex: "素材別ハブ一覧",
  secAppliances: "家電別安全ガイド一覧",
  viewAll: "すべて見る",
  secDirectories: "各種安全ディレクトリ",
  shelfLifeTitle: "賞味期限・保存期間ガイド",
  refreezeTitle: "再冷凍安全性ガイド",
  washingTitle: "洗濯機・ランドリー安全性",
  whatHappensTitle: "誤使用時のリスク・非常時シナリオ",
  blogTitle: "キッチン安全ブログ",
  blogIndex: "ブログ記事一覧",
  compareTitle: "キッチン用品の安全性比較",
  compareIndex: "比較一覧",
  appNames: {
    dishwasher: "食洗機",
    microwave: "電子レンジ",
    freezer: "冷凍庫",
    oven: "オーブン",
    dryer: "乾燥機",
    airfryer: "ノンフライヤー",
    refrigerator: "冷蔵庫"
  } as Record<string, string>
} : {
  title: "HTML 网站地图 | 厨房安全指南",
  description: "查阅厨房安全指南的完整内容索引，涵盖全品类家电兼容性指南、材质安全专区及厨房应急参考手册。",
  home: "首页",
  sitemap: "网站地图",
  h1: "HTML 网站地图",
  intro: "浏览我们收录的完整厨房家电安全指南、材质专区分类索引、保鲜与冷冻储存准则，以及实用的厨房安全科普文章。",
  secCore: "核心专区",
  secCoreTitle: "基础页面",
  homeLink: "网站首页",
  aboutLink: "关于我们",
  contactLink: "联系我们",
  privacyLink: "隐私政策",
  termsLink: "使用条款",
  secMaterials: "材质安全专区",
  materialsIndex: "材质专区总览",
  secAppliances: "家电安全指南导航",
  viewAll: "查看全部",
  secDirectories: "安全分类专区",
  shelfLifeTitle: "食材保存期限与保质期指南",
  refreezeTitle: "食材解冻后再冷冻安全性",
  washingTitle: "洗衣机洗涤与日常护理指南",
  whatHappensTitle: "误用后果与应急处理场景",
  blogTitle: "厨房安全科普博客",
  blogIndex: "博客文章总览",
  compareTitle: "厨房用品安全性对比",
  compareIndex: "对比文章总览",
  appNames: {
    dishwasher: "洗碗机",
    microwave: "微波炉",
    freezer: "冷冻室",
    oven: "烤箱",
    dryer: "烘干机",
    airfryer: "空气炸锅",
    refrigerator: "冰箱"
  } as Record<string, string>
};

const currentItems = isJa ? itemsJa : itemsZh;
const appliances = ['dishwasher', 'microwave', 'freezer', 'oven', 'dryer', 'airfryer', 'refrigerator'];
const groupedItems = appliances.reduce((acc, app) => {
  acc[app] = currentItems.filter(i => i.appliance === app);
  return acc;
}, {} as Record<string, typeof currentItems>);
---

<Layout title={content.title} description={content.description} excludeArticleSchema={true} availableLocales={availableLocales} lang={lang}>
  <section class="max-w-[1280px] mx-auto px-6 py-12">
    <!-- Breadcrumbs -->
    <nav class="flex gap-2 text-muted text-[13px] mb-8" aria-label="Breadcrumb">
      <a href={`/${lang}/`} class="hover:text-ink transition-colors">{content.home}</a>
      <span>/</span>
      <span class="text-ink font-medium">{content.sitemap}</span>
    </nav>

    <!-- Header -->
    <header class="max-w-[800px] mb-12">
      <h1 class="text-4xl md:text-5xl font-bold text-ink tracking-tight mb-4">
        {content.h1}
      </h1>
      <p class="text-body-md text-muted text-lg leading-relaxed">
        {content.intro}
      </p>
    </header>

    <!-- Core Pages & Material Hubs -->
    <section class="border-t border-hairline pt-8 mb-12">
      <h2 class="text-2xl font-bold text-ink mb-6">{content.secCore}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
        <div class="p-6 bg-surface-soft border border-hairline rounded-lg">
          <h3 class="text-title-sm text-ink font-bold mb-3">{content.secCoreTitle}</h3>
          <ul class="flex flex-col gap-2.5 text-[13px]">
            <li><a href={`/${lang}/`} class="text-link hover:underline font-medium">{content.homeLink}</a></li>
            <li><a href={`/${lang}/about/`} class="text-link hover:underline">{content.aboutLink}</a></li>
            <li><a href={`/${lang}/contact/`} class="text-link hover:underline">{content.contactLink}</a></li>
            <li><a href={`/${lang}/privacy/`} class="text-link hover:underline">{content.privacyLink}</a></li>
            <li><a href={`/${lang}/terms/`} class="text-link hover:underline">{content.termsLink}</a></li>
          </ul>
        </div>

        <div class="p-6 bg-surface-soft border border-hairline rounded-lg">
          <h3 class="text-title-sm text-ink font-bold mb-3">{content.secMaterials}</h3>
          <ul class="flex flex-col gap-2.5 text-[13px]">
            <li><a href={`/${lang}/material/`} class="text-link hover:underline font-medium">{content.materialsIndex}</a></li>
            {CATEGORIES.map(cat => {
              const loc = CATEGORY_LOCALIZATIONS[cat.id]?.[lang];
              const name = loc?.displayName || cat.displayName;
              return (
                <li>
                  <a href={`/${lang}/material/${cat.id}/`} class="text-link hover:underline">
                    {name}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>

        <div class="p-6 bg-surface-soft border border-hairline rounded-lg">
          <h3 class="text-title-sm text-ink font-bold mb-3">{content.blogTitle}</h3>
          <ul class="flex flex-col gap-2.5 text-[13px]">
            <li><a href="/blog/" class="text-link hover:underline font-medium">{content.blogIndex}</a></li>
            {blogData.map(post => (
              <li><a href={`/blog/${post.slug}/`} class="text-link hover:underline line-clamp-1">{post.title}</a></li>
            ))}
          </ul>
        </div>

        <div class="p-6 bg-surface-soft border border-hairline rounded-lg">
          <h3 class="text-title-sm text-ink font-bold mb-3">{content.compareTitle}</h3>
          <ul class="flex flex-col gap-2.5 text-[13px] max-h-[300px] overflow-y-auto pr-1">
            <li><a href={getDirectoryUrl('compare', lang)} class="text-link hover:underline font-medium">{content.compareIndex}</a></li>
            {(lang === 'zh-cn' ? comparisonsZh : lang === 'ja' ? comparisonsJa : comparisonsData).map(c => (
              <li><a href={`/${lang}/compare/${c.slug}/`} class="text-link hover:underline line-clamp-1">{c.item1} vs {c.item2}</a></li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Appliance Sections -->
    <section class="border-t border-hairline pt-8 mb-12">
      <h2 class="text-2xl font-bold text-ink mb-6">{content.secAppliances}</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
        {appliances.map(app => {
          const appName = content.appNames[app] || app;
          const items = groupedItems[app] || [];
          return (
            <div class="border border-hairline rounded-lg p-5">
              <h3 class="text-title-md font-bold text-ink mb-3 pb-2 border-b border-hairline flex justify-between items-center">
                <span>{appName}</span>
                <a href={getApplianceUrl(app, lang)} class="text-xs text-link hover:underline">{content.viewAll} ({items.length})</a>
              </h3>
              <ul class="flex flex-col gap-2 text-[13px] max-h-[250px] overflow-y-auto pr-1">
                {items.map(item => (
                  <li>
                    <a href={`/${lang}/${app}/${item.slug}/`} class="text-muted hover:text-link block truncate">
                      {item.item}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          );
        })}
      </div>
    </section>

    <!-- Other Safety Directories -->
    <section class="border-t border-hairline pt-8 mb-12">
      <h2 class="text-2xl font-bold text-ink mb-6">{content.secDirectories}</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <!-- Shelf Life -->
        <div class="border border-hairline rounded-lg p-5">
          <h3 class="text-title-md font-bold text-ink mb-3 pb-2 border-b border-hairline flex justify-between items-center">
            <span>{content.shelfLifeTitle}</span>
            <a href={getDirectoryUrl('how-long', lang)} class="text-xs text-link hover:underline">{content.viewAll} ({howLongData.length})</a>
          </h3>
          <ul class="flex flex-col gap-2 text-[13px] max-h-[250px] overflow-y-auto pr-1">
            {howLongData.map(item => (
              <li>
                <a href={`/how-long/${item.slug}/`} class="text-muted hover:text-link block truncate">
                  {item.item}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Refreeze -->
        <div class="border border-hairline rounded-lg p-5">
          <h3 class="text-title-md font-bold text-ink mb-3 pb-2 border-b border-hairline flex justify-between items-center">
            <span>{content.refreezeTitle}</span>
            <a href={getDirectoryUrl('refreeze', lang)} class="text-xs text-link hover:underline">{content.viewAll} ({refreezeData.length})</a>
          </h3>
          <ul class="flex flex-col gap-2 text-[13px] max-h-[250px] overflow-y-auto pr-1">
            {refreezeData.map(item => (
              <li>
                <a href={`/refreeze/${item.slug}/`} class="text-muted hover:text-link block truncate">
                  {item.item}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Washing Machine -->
        <div class="border border-hairline rounded-lg p-5">
          <h3 class="text-title-md font-bold text-ink mb-3 pb-2 border-b border-hairline flex justify-between items-center">
            <span>{content.washingTitle}</span>
            <a href={getDirectoryUrl('washing-machine', lang)} class="text-xs text-link hover:underline">{content.viewAll} ({washingMachineData.length})</a>
          </h3>
          <ul class="flex flex-col gap-2 text-[13px] max-h-[250px] overflow-y-auto pr-1">
            {washingMachineData.map(item => (
              <li>
                <a href={`/washing-machine/${item.slug}/`} class="text-muted hover:text-link block truncate">
                  {item.item}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- What Happens -->
        <div class="border border-hairline rounded-lg p-5">
          <h3 class="text-title-md font-bold text-ink mb-3 pb-2 border-b border-hairline flex justify-between items-center">
            <span>{content.whatHappensTitle}</span>
            <a href={getDirectoryUrl('what-happens', lang)} class="text-xs text-link hover:underline">{content.viewAll} ({whatHappensData.length})</a>
          </h3>
          <ul class="flex flex-col gap-2 text-[13px] max-h-[250px] overflow-y-auto pr-1">
            {whatHappensData.map(item => (
              <li>
                <a href={`/what-happens/${item.slug}/`} class="text-muted hover:text-link block truncate">
                  {item.scenario}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  </section>
</Layout>
