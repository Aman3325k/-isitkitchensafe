  <script is:inline>
    (function () {
      function initSitemapFilter() {
        var root = document.getElementById('sitemap-filter-bar');
        var input = document.getElementById('sitemap-filter-input');
        var clearBtn = document.getElementById('sitemap-filter-clear');
        var statusEl = document.getElementById('sitemap-filter-status');
        var emptyEl = document.getElementById('sitemap-empty-state');
        var emptyResetBtn = document.getElementById('sitemap-empty-reset');
        if (!root || !input || !statusEl) return;
        if (root.getAttribute('data-bound') === '1') return;
        root.setAttribute('data-bound', '1');

        var items = Array.prototype.slice.call(document.querySelectorAll('[data-sitemap-item]'));
        var cards = Array.prototype.slice.call(document.querySelectorAll('[data-sitemap-card]'));
        var sections = Array.prototype.slice.call(document.querySelectorAll('[data-sitemap-section]'));
        var chips = Array.prototype.slice.call(document.querySelectorAll('[data-filter-chip]'));
        var totalItems = items.length;

        var msgAll = root.getAttribute('data-msg-all') || 'Showing all {total} indexed links across {sections} sections.';
        var msgMatch = root.getAttribute('data-msg-match') || 'Showing {matched} matching links (of {total}) across {sections} sections.';
        var msgEmpty = root.getAttribute('data-msg-empty') || 'No matching links found for "{query}".';

        var itemData = items.map(function (el) {
          var hay = (el.getAttribute('data-search') || el.textContent || '').toLowerCase();
          return { el: el, hay: hay };
        });

        var cardData = cards.map(function (card) {
          var cardItems = Array.prototype.slice.call(card.querySelectorAll('[data-sitemap-item]'));
          var countEl = card.querySelector('[data-card-count]');
          var origCount = countEl ? (countEl.getAttribute('data-orig-count') || countEl.textContent || '') : '';
          return { el: card, items: cardItems, countEl: countEl, origCount: origCount };
        });

        var sectionData = sections.map(function (sec) {
          var secItems = Array.prototype.slice.call(sec.querySelectorAll('[data-sitemap-item]'));
          return { el: sec, items: secItems };
        });

        function formatMsg(tpl, matched, total, secCount, query) {
          return tpl
            .replace('{matched}', String(matched))
            .replace('{total}', String(total))
            .replace('{sections}', String(secCount))
            .replace('{query}', query);
        }

        function applyFilter() {
          var raw = (input.value || '').trim();
          var q = raw.toLowerCase();
          var tokens = q ? q.split(/\s+/).filter(Boolean) : [];
          var hasQuery = tokens.length > 0;

          if (clearBtn) {
            if (hasQuery) {
              clearBtn.classList.remove('hidden');
            } else {
              clearBtn.classList.add('hidden');
            }
          }

          for (var c = 0; c < chips.length; c++) {
            var chipVal = (chips[c].getAttribute('data-filter-chip') || '').toLowerCase();
            chips[c].setAttribute('aria-pressed', hasQuery && chipVal === q ? 'true' : 'false');
          }

          var matchedCount = 0;
          for (var i = 0; i < itemData.length; i++) {
            var entry = itemData[i];
            var ok = true;
            if (hasQuery) {
              for (var t = 0; t < tokens.length; t++) {
                if (entry.hay.indexOf(tokens[t]) === -1) {
                  ok = false;
                  break;
                }
              }
            }
            if (ok) {
              matchedCount++;
              entry.el.classList.remove('hidden');
            } else {
              entry.el.classList.add('hidden');
            }
          }

          for (var j = 0; j < cardData.length; j++) {
            var card = cardData[j];
            var visInCard = 0;
            for (var k = 0; k < card.items.length; k++) {
              if (!card.items[k].classList.contains('hidden')) {
                visInCard++;
              }
            }
            if (hasQuery && visInCard === 0) {
              card.el.classList.add('hidden');
            } else {
              card.el.classList.remove('hidden');
            }
            if (card.countEl) {
              card.countEl.textContent = hasQuery ? (String(visInCard) + ' / ' + card.origCount) : card.origCount;
            }
          }

          var visibleSections = 0;
          for (var s = 0; s < sectionData.length; s++) {
            var sec = sectionData[s];
            var visInSec = 0;
            for (var m = 0; m < sec.items.length; m++) {
              if (!sec.items[m].classList.contains('hidden')) {
                visInSec++;
              }
            }
            if (hasQuery && visInSec === 0) {
              sec.el.classList.add('hidden');
            } else {
              sec.el.classList.remove('hidden');
              visibleSections++;
            }
          }

          if (!hasQuery) {
            statusEl.textContent = formatMsg(msgAll, totalItems, totalItems, sections.length, '');
          } else if (matchedCount === 0) {
            statusEl.textContent = formatMsg(msgEmpty, 0, totalItems, 0, raw);
          } else {
            statusEl.textContent = formatMsg(msgMatch, matchedCount, totalItems, visibleSections, raw);
          }

          if (emptyEl) {
            if (hasQuery && matchedCount === 0) {
              emptyEl.classList.remove('hidden');
            } else {
              emptyEl.classList.add('hidden');
            }
          }
        }

        var debounceTimer = null;
        input.addEventListener('input', function () {
          if (debounceTimer) clearTimeout(debounceTimer);
          debounceTimer = setTimeout(applyFilter, 60);
        });

        input.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') {
            input.value = '';
            applyFilter();
          }
        });

        if (clearBtn) {
          clearBtn.addEventListener('click', function () {
            input.value = '';
            applyFilter();
            input.focus();
          });
        }

        if (emptyResetBtn) {
          emptyResetBtn.addEventListener('click', function () {
            input.value = '';
            applyFilter();
            input.focus();
          });
        }

        for (var b = 0; b < chips.length; b++) {
          (function (btn) {
            btn.addEventListener('click', function () {
              var val = btn.getAttribute('data-filter-chip') || '';
              if ((input.value || '').trim().toLowerCase() === val.toLowerCase()) {
                input.value = '';
              } else {
                input.value = val;
              }
              applyFilter();
              input.focus();
            });
          })(chips[b]);
        }

        applyFilter();
      }

      initSitemapFilter();
      document.addEventListener('astro:page-load', initSitemapFilter);
    })();
  </script>
</Layout>
