export function getStaticPaths() {
  const availableLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'zh-cn', 'ja'];
  return [
    { params: { lang: 'es' }, props: { lang: 'es' as SupportedLanguage, availableLocales } },
    { params: { lang: 'pt' }, props: { lang: 'pt' as SupportedLanguage, availableLocales } },
    { params: { lang: 'zh-cn' }, props: { lang: 'zh-cn' as SupportedLanguage, availableLocales } },
    { params: { lang: 'ja' }, props: { lang: 'ja' as SupportedLanguage, availableLocales } }
  ];
}

interface Props {
  lang: SupportedLanguage;
  availableLocales: SupportedLanguage[];
}

interface StarterPackItemRaw {
  slug: string;
  appliance: string;
  name: string;
  safe: 'yes' | 'depends' | 'no';
}

interface StarterPackRaw {
  id: string;
  title: string;
  shortTitle: string;
  description: string;
  badgeText: string;
  items: StarterPackItemRaw[];
}

interface StarterPackItem extends StarterPackItemRaw {
  url: string;
}

interface StarterPack {
  id: string;
  title: string;
  shortTitle: string;
  description: string;
  badgeText: string;
  items: StarterPackItem[];
}

interface QuickLinkItem {
  label: string;
  href: string;
  desc: string;
}

interface ConsumerToolLink {
  label: string;
  badge: string;
  href: string;
  desc: string;
}

