      pngShowingTemplate: '{total}件中 {shown}件を表示',
      pngSavedCountTemplate: '保存済み {total}件',
      pngOverflowTemplate: 'ほか {hidden}件 — 全リストは isitkitchensafe.com/ja/saved/ で確認',
      pngFooterSub: 'USDA FSIS・FDA 21 CFR・メーカー指針準拠 • 加熱や洗浄前に必ず底面表示を確認。',
      pngEmptyToast: 'PNGを保存するには、先にアイテムを保存するかスターターパックを追加してください。',
