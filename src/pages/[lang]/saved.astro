const savedCanonicalDisplayUrl = `https://isitkitchensafe.com/${lang}/saved/`;
---

<Layout
  title={content.pageTitle}
  description={content.pageDescription}
  noindex={true}
  excludeFaqSchema={true}
  excludeArticleSchema={true}
  availableLocales={availableLocales}
  lang={lang}
>
  <Fragment slot="head">
    <style is:inline>
      .print-only-header,
      .print-only-footer {
        display: none;
      }

      @media print {
        @page {
          size: letter portrait;
          margin: 0.45in;
        }

        header,
        nav,
        footer,
        #cookie-consent-banner,
        #back-to-top-container,
        .no-print {
          display: none !important;
        }

        body {
          background: #ffffff !important;
          color: #111827 !important;
          font-size: 9.5pt !important;
          line-height: 1.3 !important;
        }

        #saved-cheat-sheet-page {
          max-width: 100% !important;
          padding: 0 !important;
          margin: 0 !important;
        }

        .print-only-header {
          display: flex !important;
          align-items: center;
          justify-content: space-between;
          border-bottom: 2px solid #181d26;
          padding-bottom: 8px;
          margin-bottom: 12px;
        }

        .print-only-footer {
          display: flex !important;
          align-items: center;
          justify-content: space-between;
          border-top: 1px solid #d1d5db;
          padding-top: 6px;
          margin-top: 14px;
          font-size: 8pt;
          color: #4b5563;
        }

        #saved-groups-container {
          display: grid !important;
          grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
          gap: 10px !important;
          align-items: start !important;
        }

        .verdict-group-card {
          break-inside: avoid;
          border: 1.5px solid #181d26 !important;
          border-radius: 6px !important;
          padding: 8px !important;
          background: #ffffff !important;
          box-shadow: none !important;
        }

        .verdict-group-header {
          padding-bottom: 6px !important;
          margin-bottom: 6px !important;
          border-bottom: 1px solid #d1d5db !important;
        }

        .saved-item-row {
          padding: 5px 4px !important;
          border-bottom: 1px dotted #d1d5db !important;
          background: transparent !important;
          border-left: none !important;
          border-right: none !important;
          border-top: none !important;
          border-radius: 0 !important;
        }

        .saved-item-row:last-child {
          border-bottom: none !important;
        }

        .saved-item-link {
          color: #111827 !important;
          text-decoration: none !important;
          font-weight: 600 !important;
          font-size: 9pt !important;
        }

        .saved-item-appliance {
          font-size: 7.5pt !important;
          color: #374151 !important;
          border: 1px solid #9ca3af !important;
          padding: 1px 4px !important;
        }
      }
    </style>
  </Fragment>

  <section id="saved-cheat-sheet-page" class="max-w-[960px] mx-auto px-6 py-[48px] md:py-[64px]">
    <!-- Breadcrumbs (screen only) -->
    <div class="no-print">
      <Breadcrumbs
        items={[
          { label: t('nav.home'), href: translatePath('/') },
          { label: content.breadcrumbLabel }
        ]}
      />
    </div>

    <!-- Print-Only Fridge Sheet Header -->
    <div class="print-only-header">
      <div>
        <div style="font-size: 14pt; font-weight: 700; color: #181d26;">
          {content.printHeaderTitle}
        </div>
        <div style="font-size: 8.5pt; color: #4b5563;">
          {content.printHeaderSubtitle}
        </div>
      </div>
      <div style="text-align: right;">
        <div style="font-size: 10pt; font-weight: 700; color: #181d26;">isitkitchensafe.com</div>
        <div id="print-date-stamp" style="font-size: 8pt; color: #4b5563;"></div>
      </div>
    </div>

    <!-- Screen Header -->
    <header class="mb-8 pb-6 border-b border-hairline no-print">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-5">
        <div>
          <span class="text-caption text-signature-coral font-semibold uppercase tracking-wider text-xs block mb-2">
            {content.eyebrow}
          </span>
          <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-3 leading-tight">
            {content.h1}
          </h1>
          <p class="text-body-md text-body leading-relaxed max-w-2xl">
            {content.introDesc}
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-2.5 shrink-0">
          <button
            id="print-cheat-sheet-btn"
            type="button"
            class="min-h-[44px] px-5 py-2.5 bg-primary hover:bg-primary-active active:scale-[0.98] text-on-primary rounded-lg text-sm font-medium inline-flex items-center gap-2 shadow-xs transition-all cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed"
          >
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4H7v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
            </svg>
            <span>{content.printBtnLabel}</span>
          </button>
        </div>
      </div>
    </header>

    <!-- Summary Metrics & Appliance Filter Bar (shown when items exist) -->
    <div id="saved-controls-bar" class="hidden mb-8 no-print">
      <div class="bg-surface-soft border border-hairline rounded-lg p-4 md:p-5 flex flex-col gap-4">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div class="flex flex-wrap items-center gap-2 text-xs">
            <span class="font-semibold text-ink">{content.savedItemsLabel} <strong id="total-saved-count">0</strong></span>
            <span class="text-hairline">|</span>
            <span class="badge-yes px-2.5 py-0.5 text-[11px]">{content.yesCountLabel} <span id="yes-saved-count" class="ml-1">0</span></span>
            <span class="badge-depends px-2.5 py-0.5 text-[11px]">{content.dependsCountLabel} <span id="depends-saved-count" class="ml-1">0</span></span>
            <span class="badge-no px-2.5 py-0.5 text-[11px]">{content.noCountLabel} <span id="no-saved-count" class="ml-1">0</span></span>
          </div>

          <button
            id="clear-all-saved-btn"
            type="button"
            class="min-h-[36px] px-3 py-1.5 text-xs font-medium text-error hover:bg-error-bg border border-error/30 rounded-md transition-colors cursor-pointer"
          >
            {content.clearAllBtnLabel}
          </button>
        </div>

        <div class="border-t border-hairline pt-3.5 flex flex-wrap items-center gap-2">
          <span class="text-xs font-medium text-muted mr-1">{content.filterByApplianceLabel}</span>
          <div id="appliance-filter-pills" class="flex flex-wrap gap-2" role="group" aria-label={content.filterGroupAria}></div>
        </div>
      </div>
    </div>

    <!-- Saved Items Grouped by Verdict -->
    <div id="saved-groups-container" class="hidden grid grid-cols-1 lg:grid-cols-3 gap-6 mb-10" aria-live="polite">
      <!-- YES Group -->
      <section class="verdict-group-card bg-surface-soft border border-hairline rounded-lg p-5 flex flex-col" data-verdict-group="yes">
        <div class="verdict-group-header flex items-center justify-between pb-3 mb-3 border-b border-hairline">
          <div class="flex items-center gap-2">
            <span class="badge-yes px-3 py-1 text-xs">{content.groupYesHeader}</span>
          </div>
          <span id="group-count-yes" class="text-xs font-mono text-muted">0</span>
        </div>
        <ul id="saved-list-yes" class="flex flex-col gap-2.5 list-none p-0 m-0"></ul>
      </section>

      <!-- DEPENDS Group -->
      <section class="verdict-group-card bg-surface-soft border border-hairline rounded-lg p-5 flex flex-col" data-verdict-group="depends">
        <div class="verdict-group-header flex items-center justify-between pb-3 mb-3 border-b border-hairline">
          <div class="flex items-center gap-2">
            <span class="badge-depends px-3 py-1 text-xs">{content.groupDependsHeader}</span>
          </div>
          <span id="group-count-depends" class="text-xs font-mono text-muted">0</span>
        </div>
        <ul id="saved-list-depends" class="flex flex-col gap-2.5 list-none p-0 m-0"></ul>
      </section>

      <!-- NO Group -->
      <section class="verdict-group-card bg-surface-soft border border-hairline rounded-lg p-5 flex flex-col" data-verdict-group="no">
        <div class="verdict-group-header flex items-center justify-between pb-3 mb-3 border-b border-hairline">
          <div class="flex items-center gap-2">
            <span class="badge-no px-3 py-1 text-xs">{content.groupNoHeader}</span>
          </div>
          <span id="group-count-no" class="text-xs font-mono text-muted">0</span>
        </div>
        <ul id="saved-list-no" class="flex flex-col gap-2.5 list-none p-0 m-0"></ul>
      </section>
    </div>

    <!-- Empty State -->
    <div id="saved-empty-state" class="bg-surface-soft border border-hairline rounded-lg p-8 md:p-10 text-center no-print">
      <div class="w-12 h-12 rounded-full bg-canvas border border-hairline flex items-center justify-center mx-auto mb-4 text-ink">
        <svg class="w-6 h-6 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
        </svg>
      </div>
      <h2 class="text-title-md text-ink font-semibold mb-2">{content.emptyTitle}</h2>
      <p class="text-body-md text-muted leading-relaxed max-w-lg mx-auto mb-8">
        {content.emptyDescBefore}<strong class="text-ink font-medium">{content.emptyDescButtonName}</strong>{content.emptyDescAfter}
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 text-left max-w-3xl mx-auto">
        {quickStartLinks.map((link) => (
          <a
            href={link.href}
            class="bg-canvas border border-hairline hover:border-border-strong rounded-md p-4 flex flex-col justify-between transition-colors shadow-2xs"
          >
            <div>
              <span class="text-ink font-semibold text-[14px] block mb-1">{link.label}</span>
              <span class="text-xs text-muted leading-relaxed block">{link.desc}</span>
            </div>
            <span class="text-xs font-medium text-link mt-3 inline-block">{content.exploreLabel} &rarr;</span>
          </a>
        ))}
      </div>
    </div>

    <!-- Tip Banner (screen only) -->
    <div class="mt-8 bg-surface-soft border border-hairline rounded-md p-4 text-xs text-muted flex flex-wrap items-center justify-between gap-3 no-print">
      <span>
        {content.tipBannerText}
      </span>
      <a href={getDirectoryUrl('methodology', lang)} class="text-link hover:underline font-semibold shrink-0">
        {content.tipBannerLink} &rarr;
      </a>
    </div>

    <!-- Print-Only Fridge Footer -->
    <div class="print-only-footer">
      <span>{content.printFooterPrefix}<strong>{savedCanonicalDisplayUrl}</strong>{content.printFooterSuffix}</span>
      <span>{content.printFooterStandards}</span>
    </div>
  </section>

  <script is:inline define:vars={{ lang, scriptI18n }}>
    (function () {
      var STORAGE_KEY = 'kitchen_saved_items';
      var activeApplianceFilter = 'all';
      var APPLIANCE_LABELS = scriptI18n.applianceLabels || {};

      function formatApplianceName(app) {
        if (!app) return scriptI18n.defaultAppliance;
        var key = String(app).toLowerCase();
        if (APPLIANCE_LABELS[key]) return APPLIANCE_LABELS[key];
        return key
          .split('-')
          .map(function (w) {
            return w ? w.charAt(0).toUpperCase() + w.slice(1) : '';
          })
          .join(' ');
      }

      function formatSlugAsName(slug) {
        if (!slug) return scriptI18n.defaultItemName;
        return String(slug)
          .split('-')
          .map(function (w) {
            return w ? w.charAt(0).toUpperCase() + w.slice(1) : '';
          })
          .join(' ');
      }

      function ensureSafeRelativeUrl(url, fallbackPath) {
        var raw = String(url || '').trim();
        if (!raw || raw.indexOf(':') !== -1 || raw.indexOf('//') === 0) {
          raw = fallbackPath;
        }
        if (raw.charAt(0) !== '/') {
          raw = '/' + raw;
        }
        return raw.charAt(raw.length - 1) === '/' ? raw : raw + '/';
      }

      function normalizeItem(raw) {
        if (!raw || typeof raw !== 'object') return null;
        var slug = String(raw.slug || '').trim();
        var appliance = String(raw.appliance || '').trim().toLowerCase();
        var name = String(raw.name || raw.item || formatSlugAsName(slug)).trim();
        var safeRaw = String(raw.safe || 'depends').trim().toLowerCase();
        var safe = safeRaw === 'yes' || safeRaw === 'no' ? safeRaw : 'depends';
        var fallbackPath = '/' + lang + '/' + (appliance || 'dishwasher') + '/' + (slug ? slug + '/' : '');
        var url = ensureSafeRelativeUrl(raw.url, fallbackPath);

        return {
          slug: slug,
          name: name,
          item: name,
          appliance: appliance,
          safe: safe,
          url: url,
          timestamp: raw.timestamp || 0
        };
      }

      function readSavedItems() {
        try {
          var parsed = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
          if (!Array.isArray(parsed)) return [];
          return parsed.map(normalizeItem).filter(Boolean);
        } catch (e) {
          return [];
        }
      }

      function writeSavedItems(items) {
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(items));
        } catch (e) {}
      }

      function removeSavedItem(slug, appliance) {
        var items = readSavedItems().filter(function (entry) {
          return !(entry.slug === slug && entry.appliance === appliance);
        });
        writeSavedItems(items);
        renderSavedSheet();
      }

      function createItemElement(entry) {
        var li = document.createElement('li');
        li.className =
          'saved-item-row bg-canvas border border-hairline rounded-md p-3 flex items-start justify-between gap-2.5 transition-colors hover:border-border-strong';

        var infoWrap = document.createElement('div');
        infoWrap.className = 'min-w-0 flex-1';

        var link = document.createElement('a');
        link.href = entry.url;
        link.className =
          'saved-item-link text-[14px] font-medium text-ink hover:text-link hover:underline block break-words leading-snug';
        link.textContent = entry.name;

        var metaRow = document.createElement('div');
        metaRow.className = 'mt-1.5 flex flex-wrap items-center gap-1.5';

        var appBadge = document.createElement('span');
        appBadge.className =
          'saved-item-appliance inline-flex items-center text-[11px] font-medium text-muted bg-surface-soft border border-hairline px-2 py-0.5 rounded';
        appBadge.textContent = formatApplianceName(entry.appliance);

        metaRow.appendChild(appBadge);
        infoWrap.appendChild(link);
        infoWrap.appendChild(metaRow);

        var removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className =
          'no-print shrink-0 w-7 h-7 rounded flex items-center justify-center text-muted hover:text-error hover:bg-error-bg transition-colors cursor-pointer';
        removeBtn.setAttribute(
          'aria-label',
          scriptI18n.removeLabelPrefix + entry.name + ' (' + formatApplianceName(entry.appliance) + ')'
        );
        removeBtn.title = scriptI18n.removeTitle;
        removeBtn.textContent = '✕';
        removeBtn.onclick = function () {
          removeSavedItem(entry.slug, entry.appliance);
        };

        li.appendChild(infoWrap);
        li.appendChild(removeBtn);
        return li;
      }

      function renderApplianceFilters(allItems) {
        var container = document.getElementById('appliance-filter-pills');
        if (!container) return;
        container.textContent = '';

        var counts = {};
        allItems.forEach(function (entry) {
          var app = entry.appliance || 'other';
          counts[app] = (counts[app] || 0) + 1;
        });

        var appliances = Object.keys(counts).sort();
        if (activeApplianceFilter !== 'all' && !counts[activeApplianceFilter]) {
          activeApplianceFilter = 'all';
        }

        function makePill(value, label, count) {
          var btn = document.createElement('button');
          btn.type = 'button';
          var isActive = activeApplianceFilter === value;
          btn.className = isActive
            ? 'min-h-[34px] px-3 py-1 rounded-full text-xs font-semibold bg-primary text-on-primary border border-primary cursor-pointer transition-colors'
            : 'min-h-[34px] px-3 py-1 rounded-full text-xs font-medium bg-canvas text-ink hover:bg-surface-strong/40 border border-hairline cursor-pointer transition-colors';
          btn.textContent = label + ' (' + count + ')';
          btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
          btn.onclick = function () {
            activeApplianceFilter = value;
            renderSavedSheet();
          };
          return btn;
        }

        container.appendChild(makePill('all', scriptI18n.allAppliances, allItems.length));
        appliances.forEach(function (app) {
          container.appendChild(makePill(app, formatApplianceName(app), counts[app]));
        });
      }

      function renderSavedSheet() {
        var allItems = readSavedItems();
        var controlsBar = document.getElementById('saved-controls-bar');
        var groupsContainer = document.getElementById('saved-groups-container');
        var emptyState = document.getElementById('saved-empty-state');
        var printBtn = document.getElementById('print-cheat-sheet-btn');
        var dateStamp = document.getElementById('print-date-stamp');

        if (dateStamp) {
          try {
            dateStamp.textContent = scriptI18n.printedPrefix + new Date().toLocaleDateString(scriptI18n.dateLocale);
          } catch (e) {}
        }

        if (allItems.length === 0) {
          if (controlsBar) controlsBar.classList.add('hidden');
          if (groupsContainer) groupsContainer.classList.add('hidden');
          if (emptyState) emptyState.classList.remove('hidden');
          if (printBtn) printBtn.disabled = true;
          return;
        }

        if (controlsBar) controlsBar.classList.remove('hidden');
        if (groupsContainer) groupsContainer.classList.remove('hidden');
        if (emptyState) emptyState.classList.add('hidden');
        if (printBtn) printBtn.disabled = false;

        renderApplianceFilters(allItems);

        var filtered =
          activeApplianceFilter === 'all'
            ? allItems
            : allItems.filter(function (entry) {
                return entry.appliance === activeApplianceFilter;
              });

        filtered.sort(function (a, b) {
          if (b.timestamp !== a.timestamp) return (b.timestamp || 0) - (a.timestamp || 0);
          return a.name.localeCompare(b.name, scriptI18n.dateLocale);
        });

        var grouped = { yes: [], depends: [], no: [] };
        filtered.forEach(function (entry) {
          grouped[entry.safe].push(entry);
        });

        var totalEl = document.getElementById('total-saved-count');
        var yesCountEl = document.getElementById('yes-saved-count');
        var dependsCountEl = document.getElementById('depends-saved-count');
        var noCountEl = document.getElementById('no-saved-count');

        if (totalEl) totalEl.textContent = String(filtered.length);
        if (yesCountEl) yesCountEl.textContent = String(grouped.yes.length);
        if (dependsCountEl) dependsCountEl.textContent = String(grouped.depends.length);
        if (noCountEl) noCountEl.textContent = String(grouped.no.length);

        ['yes', 'depends', 'no'].forEach(function (verdict) {
          var listEl = document.getElementById('saved-list-' + verdict);
          var countEl = document.getElementById('group-count-' + verdict);
          if (countEl) countEl.textContent = String(grouped[verdict].length);
          if (!listEl) return;
          listEl.textContent = '';

          if (grouped[verdict].length === 0) {
            var emptyLi = document.createElement('li');
            emptyLi.className = 'text-xs text-muted italic py-3 px-1';
            emptyLi.textContent = scriptI18n.emptyCategory;
            listEl.appendChild(emptyLi);
            return;
          }

          grouped[verdict].forEach(function (entry) {
            listEl.appendChild(createItemElement(entry));
          });
        });
      }

      function initSavedPage() {
        var printBtn = document.getElementById('print-cheat-sheet-btn');
        if (printBtn) {
          printBtn.onclick = function () {
            window.print();
          };
        }

        var clearAllBtn = document.getElementById('clear-all-saved-btn');
        if (clearAllBtn) {
          clearAllBtn.onclick = function () {
            if (window.confirm(scriptI18n.clearAllConfirm)) {
              writeSavedItems([]);
              activeApplianceFilter = 'all';
              renderSavedSheet();
            }
          };
        }

        renderSavedSheet();
      }

      window.addEventListener('storage', function (evt) {
        if (evt.key === STORAGE_KEY) {
          renderSavedSheet();
        }
      });

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initSavedPage);
      } else {
        initSavedPage();
      }
      document.addEventListener('astro:page-load', initSavedPage);
    })();
  </script>
</Layout>
