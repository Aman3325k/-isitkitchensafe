---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import type { SupportedLanguage } from '../../i18n/ui';
import { getApplianceUrl, getDirectoryUrl, useTranslatedPath, useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  const availableLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'zh-cn', 'ja'];
  return [
    { params: { lang: 'es' }, props: { lang: 'es' as SupportedLanguage, availableLocales } },
    { params: { lang: 'pt' }, props: { lang: 'pt' as SupportedLanguage, availableLocales } },
    { params: { lang: 'zh-cn' }, props: { lang: 'zh-cn' as SupportedLanguage, availableLocales } },
    { params: { lang: 'ja' }, props: { lang: 'ja' as SupportedLanguage, availableLocales } }
  ];
}

interface Props {
  lang: SupportedLanguage;
  availableLocales: SupportedLanguage[];
}

interface QuickLinkItem {
  label: string;
  href: string;
  desc: string;
}

interface ScriptI18n {
  dateLocale: string;
  printedPrefix: string;
  defaultAppliance: string;
  defaultItemName: string;
  allAppliances: string;
  emptyCategory: string;
  removeLabelPrefix: string;
  removeTitle: string;
  clearAllConfirm: string;
  applianceLabels: Record<string, string>;
}

interface LocaleContent {
  pageTitle: string;
  pageDescription: string;
  breadcrumbLabel: string;
  printHeaderTitle: string;
  printHeaderSubtitle: string;
  eyebrow: string;
  h1: string;
  introDesc: string;
  printBtnLabel: string;
  savedItemsLabel: string;
  yesCountLabel: string;
  dependsCountLabel: string;
  noCountLabel: string;
  clearAllBtnLabel: string;
  filterByApplianceLabel: string;
  filterGroupAria: string;
  groupYesHeader: string;
  groupDependsHeader: string;
  groupNoHeader: string;
  emptyTitle: string;
  emptyDescBefore: string;
  emptyDescButtonName: string;
  emptyDescAfter: string;
  exploreLabel: string;
  tipBannerText: string;
  tipBannerLink: string;
  printFooterPrefix: string;
  printFooterSuffix: string;
  printFooterStandards: string;
  quickLinks: {
    dishwasher: { label: string; desc: string };
    microwave: { label: string; desc: string };
    airfryer: { label: string; desc: string };
    freezer: { label: string; desc: string };
    symbolDecoder: { label: string; desc: string };
    methodology: { label: string; desc: string };
  };
  scriptI18n: ScriptI18n;
}

const { lang, availableLocales } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

