      applianceLabels: {
        dishwasher: '食洗機',
        microwave: '電子レンジ',
        freezer: '冷凍庫',
        oven: 'オーブン',
        airfryer: 'ノンフライヤー',
        refrigerator: '冷蔵庫',
        dryer: '乾燥機',
        'washing-machine': '洗濯機'
