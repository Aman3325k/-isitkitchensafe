      packCompactAdded: '（追加済）',
      packFullAddedPrefix: '全',
      packFullAddedSuffix: '件追加済み',
      packFullAddPrefix: '',
      packFullAddSuffix: '項目パックを追加',
      pngCardTitle: 'マイ・キッチン安全早見表 — IsItKitchenSafe.com',
      pngBadgeYes: '✓ 安全',
