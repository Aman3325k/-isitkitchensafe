---
import Layout from '../../layouts/Layout.astro';
import type { SupportedLanguage } from '../../i18n/ui';

export function getStaticPaths() {
  const allLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'zh-cn', 'ja'];
  return [
    { params: { lang: 'es' }, props: { lang: 'es' as SupportedLanguage, availableLocales: allLocales } },
    { params: { lang: 'pt' }, props: { lang: 'pt' as SupportedLanguage, availableLocales: allLocales } },
    { params: { lang: 'zh-cn' }, props: { lang: 'zh-cn' as SupportedLanguage, availableLocales: allLocales } },
    { params: { lang: 'ja' }, props: { lang: 'ja' as SupportedLanguage, availableLocales: allLocales } },
  ];
}

interface Props {
  lang: SupportedLanguage;
  availableLocales: SupportedLanguage[];
}

const { lang, availableLocales } = Astro.props;

const contentByLang = {
  es: {
    title: "Descargo de Responsabilidad de Seguridad | ¿Es Seguro en la Cocina?",
    description: "Aviso legal y descargo de responsabilidad sobre seguridad alimentaria, prevención de incendios y compatibilidad de electrodomésticos en IsItKitchenSafe.",
    faqs: [
      {
        question: "¿Las guías de IsItKitchenSafe sustituyen los manuales del fabricante?",
        answer: "No. La información de IsItKitchenSafe es de referencia informativa general. Siempre debes consultar en primer lugar los sellos del producto y los manuales oficiales del fabricante."
      },
      {
        question: "¿IsItKitchenSafe asume responsabilidad por daños o incidentes en la cocina?",
        answer: "No. Los usuarios asumen total responsabilidad personal al operar sus electrodomésticos e inspeccionar sus utensilios. IsItKitchenSafe declina toda responsabilidad por daños directos o consecuentes."
      }
    ],
    h1: "Descargo de Responsabilidad de Seguridad en la Cocina",
    lastUpdated: "Última actualización: 23 de octubre de 2026",
    introLead: "La información publicada en Is It Kitchen Safe? (isitkitchensafe.com) tiene fines exclusivamente informativos, educativos y de consulta doméstica. Al utilizar este sitio, aceptas expresamente los términos establecidos a continuación.",
    h1Mfr: "1. Prioridad de los Manuales e Indicaciones del Fabricante",
    p1Mfr: "Los materiales, aleaciones, plásticos y vidrios varían según el fabricante y año de producción. Siempre debes priorizar los símbolos oficiales impresos en tus recipientes y las advertencias del manual oficial de tus electrodomésticos sobre cualquier fuente de terceros.",
    h2Fire: "2. Daños a Electrodomésticos y Riesgo de Incendio o Arco Eléctrico",
    p2Fire: "Ciertos materiales presentan riesgos inmediatos: metales en el microondas que provocan chispas e incendios; plásticos delgados que se derriten en el lavavajillas; sobrecalentamiento de aceites o antiadherentes en freidoras de aire; y rotura por choque térmico en fuentes de vidrio.",
    h3Food: "3. Seguridad Alimentaria y Riesgo de Intoxicación",
    p3Food: "Nuestras pautas de conservación y recongelación se basan en recomendaciones de la USDA FSIS y la FDA. No obstante, las condiciones de manipulación e higiene doméstica son responsabilidad exclusiva del usuario. En caso de duda sobre el estado de un alimento, deséchalo inmediatamente.",
    h4Liability: "4. Limitación de Responsabilidad",
    p4Liability: "En ningún caso IsItKitchenSafe ni sus colaboradores serán responsables por daños directos o indirectos, fallos de aparatos, incendios domésticos o problemas de salud derivados de las decisiones del usuario.",
    h5Contact: "5. Contacto y Correcciones",
    p5Contact: "Para dudas técnicas o correcciones editoriales, escríbenos a "
  },
  pt: {
    title: "Aviso de Responsabilidade e Segurança | É Seguro na Cozinha?",
    description: "Aviso legal de segurança na cozinha, prevenção contra incêndios e limites de responsabilidade de eletrodomésticos no IsItKitchenSafe.",
    faqs: [
      {
        question: "Os guias do IsItKitchenSafe substituem os manuais dos fabricantes?",
        answer: "Não. As informações fornecidas são apenas para consulta educativa e referência geral. Consulte sempre os manuais e selos oficiais do fabricante."
      },
      {
        question: "O IsItKitchenSafe se responsabiliza por danos a eletrodomésticos?",
        answer: "Não. Os usuários assumem total responsabilidade pelas operações e verificações em sua cozinha. O site se isenta de qualquer responsabilidade por perdas ou danos."
      }
    ],
    h1: "Aviso de Responsabilidade e Segurança na Cozinha",
    lastUpdated: "Última atualização: 23 de outubro de 2026",
    introLead: "As informações publicadas no Is It Kitchen Safe? (isitkitchensafe.com) têm finalidade exclusivamente informativa e educacional. Ao navegar no site, você concorda expressamente com os termos estabelecidos.",
    h1Mfr: "1. Prioridade dos Manuais e Selos do Fabricante",
    p1Mfr: "As especificações de utensílios e louças variam amplamente. Sempre priorize as instruções, marcações na base dos recipientes e o manual de instruções do seu eletrodoméstico antes de qualquer uso.",
    h2Fire: "2. Riscos de Incêndio, Faíscas e Danos ao Eletrodoméstico",
    p2Fire: "Materiais incompatíveis representam perigos graves: arcos elétricos no micro-ondas, deformação de plásticos no ciclo de secagem da lava-louças e quebra por choque térmico em vidros.",
    h3Food: "3. Segurança de Alimentos e Descongelamento",
    p3Food: "Nossos dados de validade e recongelamento são compilados a partir de órgãos como o USDA FSIS e a FDA. A conservação efetiva depende de variáveis caseiras. Na dúvida sobre a qualidade de um alimento perecível, descarte-o.",
    h4Liability: "4. Limitação de Responsabilidade",
    p4Liability: "Em nenhuma circunstância o IsItKitchenSafe será responsável por acidentes, incêndios, danos materiais ou intoxicações alimentares decorrentes do uso das orientações.",
    h5Contact: "5. Contato Editorial",
    p5Contact: "Dúvidas e correções podem ser enviadas diretamente para "
  },
  'zh-cn': {
    title: "厨房与食品安全免责声明 | 厨房安全指南",
    description: "查阅厨房安全指南（IsItKitchenSafe）官方关于家用电器使用、火灾防范、食品安全及责任限制的免责声明。",
    faqs: [
      {
        question: "本指南能否替代电器原厂说明书？",
        answer: "不能。本网站提供的内容仅供家庭烹饪与教育参考。请始终以器皿底部标识及电器原厂说明书为准。"
      },
      {
        question: "网站是否承担因使用建议造成的电器损坏责任？",
        answer: "不承担。用户须自行承担厨房操作与器皿检查的全部安全责任。本站不对任何直接或间接财产及健康损失负责。"
      }
    ],
    h1: "厨房与食品安全免责声明",
    lastUpdated: "最后更新日期：2026年10月23日",
    introLead: "厨房安全指南（isitkitchensafe.com）所发布的内容仅供日常参考与烹饪科普。使用本网站即代表您明确理解并同意本免责声明的全部条款。",
    h1Mfr: "1. 优先遵循原厂标识与操作规范",
    p1Mfr: "不同品牌与年份的锅具、餐具及塑料制品所用配方各不相同。使用前请务必优先核对器皿底部的微波炉适用、洗碗机适用等官方图示，以及电器原厂使用说明书。",
    h2Fire: "2. 防范电器损坏、金属电弧与火灾隐患",
    p2Fire: "错误放入材质极易引发严重意外：金属及金属镶边易在微波炉中产生电弧火花；薄塑料易在洗碗机底部发热管烘烤下融化释放有害物质；普通玻璃在冷热剧变下会发生热应力碎裂。",
    h3Food: "3. 食品保质期、再次冷冻与致病菌防范",
    p3Food: "关于冷冻与冷藏时限的指导参考了美国农业部（USDA FSIS）和美国食品药品监督管理局（FDA）的公开规范。家庭环境中的细菌繁殖受多重不可控因素影响，如有异味或变质迹象请立即丢弃。",
    h4Liability: "4. 责任免除与限制",
    p4Liability: "在任何情况下，本网站及其创作者均不对因参考本站信息而导致的电器故障、火灾损害、器皿损毁或健康事故承担法律责任。",
    h5Contact: "5. 反馈与数据勘误",
    p5Contact: "如发现技术参数有误或厂商说明书更新，请随时致信 "
  },
  ja: {
    title: "キッチン・食品安全免責事項 | キッチン安全チェッカー",
    description: "キッチン安全チェッカー（IsItKitchenSafe）の家電製品使用、火災予防、食品衛生および損害賠償責任の免責事項について掲載しています。",
    faqs: [
      {
        question: "当サイトの情報はメーカーの取扱説明書より優先されますか？",
        answer: "いいえ。当サイトの情報は一般的な参考情報です。必ず製品底面の安全表示および各家電メーカーの公式取扱説明書を最優先にご確認ください。"
      },
      {
        question: "家電製品の故障や破損について当サイトは責任を負いますか？",
        answer: "いいえ。利用者はキッチンの安全管理と家電操作について全責任を負うものとし、当サイトは一切の損害賠償責任を負いません。"
      }
    ],
    h1: "キッチン・食品安全に関する免責事項",
    lastUpdated: "最終更新日：2026年10月23日",
    introLead: "キッチン安全チェッカー（isitkitchensafe.com）に掲載されている情報は、家庭における一般的な情報提供および教育的参考のみを目的としています。当サイトのご利用にあたっては、以下の免責事項にご同意いただいたものとみなします。",
    h1Mfr: "1. メーカー取扱説明書および製品表示の優先",
    p1Mfr: "調理器具や食器の素材仕様・耐熱限界はメーカーや製造時期によって大きく異なります。家電に入れる前に、必ず製品底面にある表示マーク（電子レンジ対応、食洗機対応など）やメーカー公式マニュアルを最優先してください。",
    h2Fire: "2. 家電の故障・スパーク・火災リスクの予防",
    p2Fire: "不適合な素材を入れると重大な事故に繋がります。金属類によるマイクロ波のスパーク火災、薄型プラスチックの熱変形と有害ガス、ガラス製品の熱衝撃による破損などに十分ご注意ください。",
    h3Food: "3. 食品の保存基準と食中毒予防",
    p3Food: "賞味期限や再冷凍の目安は、米国農務省（USDA FSIS）および米国食品医薬品局（FDA）の公開基準を基に作成されていますが、実際の衛生管理はご家庭の環境に左右されます。少しでも不安がある場合は口にせず破棄してください。",
    h4Liability: "4. 責任の制限・免責",
    p4Liability: "当サイトの情報への信頼に基づき発生したいかなる直接的・間接的損害（家電の故障、火災被害、食中毒など）についても、運営者は一切の法的責任を負いかねます。",
    h5Contact: "5. お問い合わせおよび訂正依頼",
    p5Contact: "内容の訂正やメーカー仕様変更のご連絡は、メール（"
  }
};

const content = contentByLang[lang] || contentByLang.es;
---

<Layout title={content.title} description={content.description} faqs={content.faqs} excludeArticleSchema={true} availableLocales={availableLocales} lang={lang}>
  <section class="max-w-[800px] mx-auto px-6 py-[96px]">
    <header class="mb-8">
      <span class="text-caption text-signature-coral font-semibold uppercase tracking-wider text-xs block mb-2">Legal & Safety Notice</span>
      <h1 class="text-display-lg font-medium text-ink tracking-tight mb-4">{content.h1}</h1>
      <p class="text-muted text-[13px]">{content.lastUpdated}</p>
    </header>

    <div class="prose max-w-none text-body-md text-body leading-relaxed flex flex-col gap-6">
      <div class="bg-warning-bg border border-warning-border/30 rounded-lg p-6">
        <p class="text-[14px] text-body leading-relaxed">
          {content.introLead}
        </p>
      </div>

      <div class="border-t border-hairline my-2"></div>

      <h2 class="text-title-lg text-ink font-medium tracking-tight">{content.h1Mfr}</h2>
      <p>{content.p1Mfr}</p>

      <div class="border-t border-hairline my-2"></div>

      <h2 class="text-title-lg text-ink font-medium tracking-tight">{content.h2Fire}</h2>
      <p>{content.p2Fire}</p>

      <div class="border-t border-hairline my-2"></div>

      <h2 class="text-title-lg text-ink font-medium tracking-tight">{content.h3Food}</h2>
      <p>{content.p3Food}</p>

      <div class="border-t border-hairline my-2"></div>

      <h2 class="text-title-lg text-ink font-medium tracking-tight">{content.h4Liability}</h2>
      <p>{content.p4Liability}</p>

      <div class="border-t border-hairline my-2"></div>

      <h2 class="text-title-lg text-ink font-medium tracking-tight">{content.h5Contact}</h2>
      <p>
        {content.p5Contact}<!--email_off--><a href="mailto:editorial@isitkitchensafe.com" class="text-link hover:underline">editorial@isitkitchensafe.com</a><!--/email_off-->{lang === 'ja' ? '）までお寄せください。' : '.'}
      </p>
    </div>
  </section>
</Layout>
