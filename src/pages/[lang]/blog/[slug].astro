} else if (/(pyrex|hexclad|caraway|le-creuset|lodge|nonstick|stainless|oven-safe|cookware|bakeware|baking-sheet|parchment|wax-paper|ceramic-vs-metal|oven-vs-toaster-oven)/.test(toolMatchSlug)) {
