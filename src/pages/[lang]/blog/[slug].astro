  | 'instantPot'
  | 'slowCooker'
  | 'moldyFood'
  | 'pantry'
  | 'allergy'
  | 'dishwasherDosage'
  | 'induction'
  | 'ovenRack'
  | 'castIron'
  | 'powerOutage'
  | 'babyBottle'
  | 'oilSmokePoint'
  | 'fridgeZone'
  | 'cleaner'
  | 'descaling'
  | 'plastic'
  | 'airfryer'
  | 'microwave'
  | 'thawing'
  | 'cookingTemp'
  | 'leftover'
  | 'ovenTemp'
  | 'microwaveSteam'
  | 'airFryerLiner'
  | 'plasticLeaching'
  | 'panScratch'
  | 'aluminumFoilLeaching'
  | 'siliconeBakeware'
  | 'airFryerTeflon'
  | 'copperCookware'
  | 'melamineFormaldehyde'
  | 'microwavePopcornPfas'
  | 'cannedFoodBpa'
  | 'woodenUtensilBiofilm'
  | 'charcoalGasGrillPah'
  | 'plasticBlenderJar'
  | 'gasStoveNo2'
  | 'waterFilter'
  | 'toxicScorecard'
  | 'recallsScanner'
  | 'glassCooktop'
  | 'symbol';

let recommendedToolKey: RecommendedToolKey = 'symbol';
if (/(grease-fire|never-use-water|\bfire\b)/.test(toolMatchSlug)) {
  recommendedToolKey = 'kitchenFire';
} else if (/(bodum-french-press|granitestone-pan|panasonic-toaster|2026-recalls-guide|recalled-air-fryer|cpsc-2026|door-latch|lid-ejection|recall)/.test(toolMatchSlug)) {
  recommendedToolKey = 'recallsScanner';
} else if (/(glass-cooktop|glass-ceramic-cooktop|sugar-pitting|razor-scraping)/.test(toolMatchSlug)) {
  recommendedToolKey = 'glassCooktop';
} else if (/(pfhxa|silicone-coating|quilon|parchment-paper-pfas)/.test(toolMatchSlug)) {
  recommendedToolKey = 'siliconeBakeware';
} else if (/(bpa-free|bps-bpf|bisphenol-substitutes)/.test(toolMatchSlug)) {
  recommendedToolKey = 'plasticLeaching';
} else if (/(gas-stove|no2-benzene)/.test(toolMatchSlug)) {
  recommendedToolKey = 'gasStoveNo2';
} else if (/(reverse-osmosis|water-filter|pfas-lead)/.test(toolMatchSlug)) {
