} else if (/(charcoal-gas-grill|grill-pah|hca-carcinogen|bbq-carcinogen)/.test(toolMatchSlug)) {
  recommendedToolKey = 'charcoalGasGrillPah';
} else if (/(kitchen-sponge|sponge-bacterial|dish-cloth)/.test(toolMatchSlug)) {
