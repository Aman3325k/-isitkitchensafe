    description: isEs ? 'Consulta la tabla oficial del USDA FSIS para 24 alimentos y distingue cuándo puedes recortar 2,5 cm (quesos duros) y cuándo desechar todo (pan, bayas).' :
                 isPt ? 'Consulte a tabela oficial do USDA FSIS para 24 alimentos e saiba quando cortar 2,5 cm ao redor (queijos duros) ou descartar tudo (pão, frutas).' :
                 isZh ? '对照 USDA FSIS 官方 24 种食材图表，清晰分辨哪些硬质奶酪与蔬果可安全切去 2.5 厘米，哪些面包浆果必须整份丢弃。' :
                 'USDA FSIS公式の24食品チャートで、硬質チーズなど周囲2.5cm切除で食べられる食品と、パン・果物など丸ごと廃棄すべき食品を判定します。',
    cta: isEs ? 'Verificar Alimentos con Moho' : isPt ? 'Verificar Alimentos Mofados' : isZh ? '核查发霉食物安全' : 'カビ食品の安全性を確認'
  },
  pantry: {
    path: '/tools/pantry-dry-goods-shelf-life-checker/',
    icon: '🥫',
    title: isEs ? 'Buscador de Caducidad y Seguridad de Despensa, Especias y Secos' :
           isPt ? 'Guia de Validade e Segurança para Despensa, Especiarias e Grãos' :
           isZh ? '常备干货、香料调料与罐头保质期及食品安全速查器' :
           '乾物・スパイス・粉類・缶詰の賞味期限＆安全性判定チェッカー',
    description: isEs ? 'Consulta límites reales del USDA FoodKeeper para latas abolladas, riesgo de botulismo, polvo de hornear, especias, harinas y pruebas rápidas de frescura.' :
                 isPt ? 'Consulte limites reais do USDA FoodKeeper para latas amassadas, risco de botulismo, fermento, especiarias, farinhas e testes rápidos de frescor.' :
                 isZh ? '依据 USDA FoodKeeper 速查凹陷罐头肉毒杆菌风险、过期泡打粉、香料、面粉及常备干货的安全食用期限与新鲜度自测法。' :
                 'USDA FoodKeeper基準に基づき、凹んだ缶詰のボツリヌス菌リスク、ベーキングパウダー・スパイス・粉類の安全期限と鮮度テストを確認できます。',
    cta: isEs ? 'Consultar Seguridad de Despensa' : isPt ? 'Consultar Segurança de Despensa' : isZh ? '速查干货安全' : '乾物の安全性を確認'
  },
  allergy: {
    path: '/tools/food-allergy-cross-contact-checker/',
    icon: '🛡️',
    title: isEs ? 'Verificador de Alergias Alimentarias y Contacto Cruzado en la Cocina' :
           isPt ? 'Verificador de Alergias Alimentares e Contato Cruzado na Cozinha' :
           isZh ? '厨房食物过敏原与交叉接触清洁安全检查器' :
