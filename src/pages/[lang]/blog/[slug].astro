  recommendedToolKey = 'plasticLeaching';
} else if (/(peeling-basket|flaking-teflon|scratched-nonstick|ceramic-nonstick)/.test(toolMatchSlug)) {
  recommendedToolKey = 'panScratch';
} else if (/(plastic|microplastic|styrofoam|meal-prep|tupperware|ziploc)/.test(toolMatchSlug)) {
