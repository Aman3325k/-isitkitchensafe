} else if (/(microwave-steam|splatter-cover|warped-container|microwave-soup)/.test(toolMatchSlug)) {
  recommendedToolKey = 'microwaveSteam';
} else if (/(air-fryer-liner|parchment-paper|silicone-liner|air-fryer-fire|baking-paper)/.test(toolMatchSlug)) {
  recommendedToolKey = 'airFryerLiner';
}

const interactiveToolBadge = isEs
  ? 'Herramienta Interactiva'
  : isPt
  ? 'Ferramenta Interativa'
  : isZh
  ? '互动计算工具'
  : 'インタラクティブツール';

