---
import Layout from '../../../layouts/Layout.astro';
import blogEs from '../../../data/blog.es.json';
import blogPt from '../../../data/blog.pt.json';
import type { SupportedLanguage } from '../../../i18n/ui';

export function getStaticPaths() {
  return [
    {
      params: { lang: 'es' },
      props: {
        lang: 'es' as SupportedLanguage,
        blogData: blogEs,
        availableLocales: ['en', 'es', 'pt'] as SupportedLanguage[]
      }
    },
    {
      params: { lang: 'pt' },
      props: {
        lang: 'pt' as SupportedLanguage,
        blogData: blogPt,
        availableLocales: ['en', 'es', 'pt'] as SupportedLanguage[]
      }
    }
  ];
}

interface Props {
  lang: SupportedLanguage;
  blogData: typeof blogEs;
  availableLocales: SupportedLanguage[];
}

const { lang, blogData, availableLocales } = Astro.props;
const isEs = lang === 'es';

const pageTitle = isEs
  ? "Blog de Seguridad en la Cocina | ¿Es Seguro en la Cocina?"
  : "Blog de Segurança na Cozinha | É Seguro na Cozinha?";

const pageDescription = isEs
  ? "Explora guías de seguridad culinaria, consejos sobre electrodomésticos, pautas de conservación del USDA/FDA y mitos desmentidos por nuestro equipo editorial."
  : "Explore guias especializados de segurança na cozinha, dicas de eletrodomésticos, regras de conservação do USDA/FDA e mitos desmistificados por nossa equipe.";

const blogFaqs = isEs
  ? [
      {
        question: "¿Cuánto tiempo duran las sobras de comida en el refrigerador?",
        answer: "Según las pautas del USDA, la mayoría de las sobras cocinadas (aves, carnes y sopas) pueden almacenarse de 3 a 4 días en el refrigerador a menos de 4 °C. Recaliéntalas siempre a 74 °C antes de consumir."
      },
      {
        question: "¿Por qué es peligroso calentar huevos enteros con cáscara en el microondas?",
        answer: "El calor genera acumulación rápida de vapor presurizado dentro de la cáscara rígida. Al no tener escape, el huevo puede explotar violentamente provocando quemaduras térmicas severas."
      },
      {
        question: "¿Se pueden lavar tablas de cortar de madera en el lavavajillas?",
        answer: "No. El calor intenso, el agua a presión y los detergentes cáusticos deforman, agrietan y astillan la madera, creando grietas donde proliferan bacterias."
      },
      {
        question: "¿Es seguro recongelar carne cruda descongelada?",
        answer: "Solo si se descongeló lentamente dentro del refrigerador (a menos de 4 °C). Si se descongeló a temperatura ambiente o con agua tibia, la proliferación bacteriana impide recongelarla sin cocinarla antes."
      },
      {
        question: "¿Qué recipientes no deben meterse al horno?",
        answer: "Recipientes con mangos de plástico o madera, vidrio no templado común y sartenes antiadherentes calentadas a más de 260 °C no son seguros para el horno."
      }
    ]
  : [
      {
        question: "Quanto tempo as sobras cozidas duram na geladeira?",
        answer: "Segundo o USDA, a maioria das sobras cozidas (carnes, aves e sopas) resiste de 3 a 4 dias na geladeira a 4 °C. Reaqueça sempre até 74 °C no centro do prato."
      },
      {
        question: "Por que é perigoso aquecer ovos inteiros com casca no micro-ondas?",
        answer: "O micro-ondas gera vapor sobreaquecido sob pressão extrema dentro da casca. O ovo pode explodir violentamente dentro do gabinete ou nas mãos ao ser retirado."
      },
      {
        question: "Pode colocar tábua de madeira na lava-louças?",
        answer: "Não. A combinação de jatos quentes, água sob pressão e detergentes alcalinos causa rachaduras e empenamentos irreversíveis na madeira."
      },
      {
        question: "É seguro recongelar carne crua que já descongelou?",
        answer: "Apenas se tiver descongelado inteiramente dentro da geladeira abaixo de 4 °C. Se descongelou na bancada, cozinhe completamente antes de qualquer novo congelamento."
      },
      {
        question: "Quais utensílios não podem ir ao forno?",
        answer: "Panelas com cabos de plástico ou madeira, assadeiras de vidro comum não temperado e frigideiras com teflon acima de 200 °C não devem ir ao forno."
      }
    ];
---

<Layout title={pageTitle} description={pageDescription} faqs={blogFaqs} excludeArticleSchema={true} availableLocales={availableLocales} lang={lang}>

  <section class="max-w-[1280px] mx-auto px-6 py-12">
    <!-- Breadcrumbs -->
    <nav class="flex gap-2 text-muted text-[13px] mb-8" aria-label="Breadcrumb">
      <a href={`/${lang}/`} class="hover:text-ink transition-colors">{isEs ? "Inicio" : "Início"}</a>
      <span>/</span>
      <span class="text-ink font-medium">Blog</span>
    </nav>

    <!-- Header Section -->
    <header class="max-w-[800px] mb-12">
      <h1 class="text-4xl md:text-5xl font-bold text-ink tracking-tight mb-4">
        {isEs ? "Blog de Seguridad en la Cocina" : "Blog de Segurança na Cozinha"}
      </h1>
      <p class="text-body-md text-muted text-lg leading-relaxed">
        {isEs
          ? "Análisis de expertos, guías de electrodomésticos y consejos de conservación de alimentos basados en el USDA, FDA y fabricantes."
          : "Análises de especialistas, guias de eletrodomésticos e regras de conservação de alimentos com respaldo do USDA, FDA e fabricantes."}
      </p>
    </header>

    <!-- AdSense Placeholder -->
    <div class="ad-placeholder w-full h-[90px] bg-surface-soft border border-dashed border-hairline flex items-center justify-center text-xs text-muted mb-12" aria-hidden="true">
      <!-- Banner AdSense -->
    </div>

    <!-- Main Content Area with Sidebar Grid Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
      <!-- Article Cards Grid -->
      <div class="lg:col-span-3 grid grid-cols-1 md:grid-cols-2 gap-8">
        {blogData.map((article) => (
          <article class="bg-canvas border border-hairline rounded-lg shadow-sm hover:shadow-md transition-all duration-200 flex flex-col justify-between overflow-hidden">
            <div class="p-6">
              <span class="text-[11px] text-link uppercase tracking-wider font-bold block mb-2">
                {isEs ? "Guías de Seguridad" : "Guias de Segurança"}
              </span>
              <h2 class="text-title-sm text-ink font-semibold mb-3 hover:text-link transition-colors">
                <a href={`/${lang}/blog/${article.slug}/`}>{article.title}</a>
              </h2>
              <p class="text-[14px] text-muted leading-relaxed mb-4 line-clamp-3">
                {article.excerpt}
              </p>
            </div>
            <div class="px-6 pb-6 pt-4 border-t border-hairline bg-surface-soft flex items-center justify-between text-xs text-muted">
              <span>{article.date}</span>
              <span>{article.readTime}</span>
            </div>
          </article>
        ))}
      </div>

      <!-- Sidebar -->
      <aside class="flex flex-col gap-8">
        <!-- Sidebar AdSense Placeholder -->
        <div class="ad-placeholder w-full h-[250px] bg-surface-soft border border-dashed border-hairline flex items-center justify-center text-xs text-muted" aria-hidden="true">
          <!-- Rectangle AdSense -->
        </div>

        <!-- Trust Box -->
        <div class="bg-signature-cream/40 border border-signature-cream rounded-lg p-6">
          <h3 class="text-title-sm text-ink font-semibold mb-3">
            {isEs ? "Información Verificada" : "Informação Verificada"}
          </h3>
          <p class="text-[13px] text-muted leading-relaxed mb-4">
            {isEs
              ? "Nuestro equipo editorial investiga y publica guías respaldadas por directrices del USDA, la FDA y los principales fabricantes de electrodomésticos."
              : "Nossa equipe editorial pesquisa e publica artigos fundamentados em diretrizes do USDA, FDA e dos principais fabricantes de eletrodomésticos."}
          </p>
          <span class="text-xs text-success font-medium bg-success-bg px-2.5 py-1 rounded-full inline-block">
            {isEs ? "✓ Con Respaldo Científico" : "✓ Respaldo Científico"}
          </span>
        </div>
      </aside>
    </div>

    <!-- AdSense Placeholder bottom banner -->
    <div class="ad-placeholder w-full h-[90px] bg-surface-soft border border-dashed border-hairline flex items-center justify-center text-xs text-muted mt-16" aria-hidden="true">
      <!-- Bottom Banner AdSense -->
    </div>
  </section>
</Layout>
