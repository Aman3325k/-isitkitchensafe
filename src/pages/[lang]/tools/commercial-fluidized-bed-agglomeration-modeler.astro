        answer: "ホエイプロテイン、全脂粉乳、ココア等は St-1 / St-2 クラスの可燃性粉塵です。装置内部は爆発下限界 (MEC) を超える 100〜500 g/m³ の高濃度粉塵雲となります。MIE が極めて低いため (12〜18 mJ)、接地不良 (R > 10 Ω) による静電気蓄積放電火花 (>25 mJ) が容易に着火源となり、猛烈な爆燃を引き起こします。"
      },
      {
        question: "NFPA 68 放散パネルはどのように容器の破裂破壊を防ぐか？",
        answer: "内部爆燃時の圧力上昇速度は極めて速く、最大 9 bar に達し耐圧 1.2 bar 程度の標準容器を破壊します。校正済み放散パネル (Pstat ≈ 0.1 bar) が瞬時に開放されて圧力を外部へ逃がし、チャンバー内の低減圧力 (Pred) を耐圧限界未満に抑え込みます。"
      },
      {
        question: "閉ループ窒素置換は NFPA 69 に基づきどのように粉塵爆発を防ぐか？",
        answer: "燃焼連鎖反応には限界酸素濃度 (LOC ≈ 9.5〜11.0%) 以上の酸素が必要です。高純度窒素によるクローズドループ運転で酸素濃度を 7.5% 未満に維持することで、静電気火花等の着火源が存在しても物理的に爆燃が起こり得ない不活性環境を構築します。"
      },
      {
        question: "熱可塑性付着点とは何か？ なぜ給気温度の上限を決定づけるのか？",
        answer: "糖分や脂肪を含む粉末は水分付着によりガラス転移温度 (Tg) が急低下します。給気温度が粉末の軟化付着温度（全粉乳 48°C、ココア 42°C）を超えると、粒子がゴム状に軟化して槽壁やフィルターに激しく融着し、流動が完全に停止します。"
      }
    ],
    scienceTitle1: "流動化空気力学と Ergun 圧力損失方程式",
    scienceText1: "粉末層を通過する流体抵抗と空塔速度は Ergun 方程式に従います。流体力学的抗力と粉末の浮動重量が釣り合う最小流動化速度 (U_mf) を超えることで、均一な混合と良好な液架橋が達成されます。",
    box1Title: "Ergun 圧損方程式",
    box1Text: "ΔP / L = 150 · [ μ_g · (1 - ε)² / (ε³ · d_p²) ] · U_g + 1.75 · [ ρ_g · (1 - ε) / (ε³ · d_p) ] · U_g²",
    box2Title: "最小流動化速度 (U_mf)",
    box2Text: "U_mf ≈ [ d_p² · (ρ_p - ρ_g) · g ] / (150 · μ_g) · [ ε_0³ / (1 - ε_0) ]",
    scienceTitle2: "粉塵爆燃指数と NFPA 68 放散工学モデル",
    scienceText2: "爆発時の圧力上昇率は粉塵指数 Kst に支配されます。校正された放散面積 Av を設けることで、減圧後最大圧力 Pred を流動層容器の設計耐圧強度以下に抑制します。",
    box3Title: "立方根爆燃方程式",
    box3Text: "(dP / dt)_max · V^(1/3) = K_st ≈ 110 – 175 bar·m/s (St-1級粉塵)",
    box4Title: "NFPA 68 所要放散開口面積",
    box4Text: "A_v = C · A_s · [ (P_max / P_red) - 1 ]^(0.5) · (K_st / 100) · [ 1 + 1.75 · (P_stat - 0.1) ]"
  }
};

const c = CONTENT[lang as Exclude<SupportedLanguage, 'en'>] || CONTENT.es;

const breadcrumbs = [
  { label: t('nav.home' as any) || 'Home', href: tp('/') },
  { label: t('nav.tools' as any) || 'Tools', href: tp('/tools/') },
  { label: c.breadcrumbsLabel }
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": c.h1,
      "url": `https://isitkitchensafe.com/${lang}/tools/commercial-fluidized-bed-agglomeration-modeler/`,
      "applicationCategory": "EngineeringApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5 Canvas/CSS3.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": c.pageDescription
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": t('nav.home' as any) || 'Home',
          "item": `https://isitkitchensafe.com${tp('/')}`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": t('nav.tools' as any) || 'Tools',
          "item": `https://isitkitchensafe.com${tp('/tools/')}`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": c.breadcrumbsLabel,
          "item": `https://isitkitchensafe.com/${lang}/tools/commercial-fluidized-bed-agglomeration-modeler/`
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": c.faqs.map(f => ({
        "@type": "Question",
        "name": f.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": f.answer
        }
      }))
    }
  ]
};
---

<Layout
  title={c.pageTitle}
  description={c.pageDescription}
  structuredData={structuredData}
>
  <main class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
    <Breadcrumbs items={breadcrumbs} />

    <header class="mb-8 mt-4">
      <div class="flex items-center gap-2 mb-2">
        <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-800">
          {c.badge}
        </span>
        <span class="text-xs text-muted font-mono">NFPA 652 &bull; NFPA 68 &bull; NFPA 69 &bull; ATEX</span>
      </div>
      <h1 class="text-display-sm sm:text-display font-semibold text-ink tracking-tight mb-3">
        {c.h1}
      </h1>
      <p class="text-body-lg text-muted max-w-4xl leading-relaxed">
        {c.lead}
      </p>
    </header>

    <!-- Flagship Interactive Modeler Component -->
    <CommercialFluidizedBedAgglomerationModeler lang={lang} />

    <!-- Engineering & Surface Science Technical Reference -->
    <section class="my-16 space-y-12">
      <div class="border-t border-hairline pt-10">
        <h2 class="text-title-lg font-semibold text-ink tracking-tight mb-4">
          {c.scienceTitle1}
        </h2>
        <div class="prose max-w-none text-body text-sm sm:text-base leading-relaxed space-y-4">
          <p>{c.scienceText1}</p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 my-4">
            <div class="bg-surface-soft p-4 rounded-xl border border-hairline">
              <span class="font-bold text-xs text-ink block mb-1">{c.box1Title}</span>
              <div class="font-mono text-xs overflow-x-auto text-ink">{c.box1Text}</div>
            </div>
            <div class="bg-surface-soft p-4 rounded-xl border border-hairline">
              <span class="font-bold text-xs text-ink block mb-1">{c.box2Title}</span>
              <div class="font-mono text-xs overflow-x-auto text-ink">{c.box2Text}</div>
            </div>
          </div>
        </div>
      </div>

      <div class="border-t border-hairline pt-10">
        <h2 class="text-title-lg font-semibold text-ink tracking-tight mb-4">
          {c.scienceTitle2}
        </h2>
        <div class="prose max-w-none text-body text-sm sm:text-base leading-relaxed space-y-4">
          <p>{c.scienceText2}</p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 my-4">
            <div class="bg-surface-soft p-4 rounded-xl border border-hairline">
              <span class="font-bold text-xs text-ink block mb-1">{c.box3Title}</span>
              <div class="font-mono text-xs overflow-x-auto text-ink">{c.box3Text}</div>
            </div>
            <div class="bg-surface-soft p-4 rounded-xl border border-hairline">
              <span class="font-bold text-xs text-ink block mb-1">{c.box4Title}</span>
              <div class="font-mono text-xs overflow-x-auto text-ink">{c.box4Text}</div>
            </div>
          </div>
        </div>
      </div>

      <div class="border-t border-hairline pt-10">
        <h2 class="text-title-lg font-semibold text-ink tracking-tight mb-4">
          Frequently Asked Questions
        </h2>
        <div class="space-y-6">
          {c.faqs.map((faq) => (
            <div class="bg-surface-soft/60 border border-hairline rounded-2xl p-6">
              <h3 class="text-title-sm font-semibold text-ink mb-2">
                {faq.question}
              </h3>
              <p class="text-body text-sm leading-relaxed text-muted">
                {faq.answer}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>
