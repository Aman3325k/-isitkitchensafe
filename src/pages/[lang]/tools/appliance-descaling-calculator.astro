    homeLabel: "ホーム",
    toolsLabel: "ツール一覧",
    toolShortLabel: "家電除垢・クエン酸計算機"
  }
};

const c = CONTENT[lang as Exclude<SupportedLanguage, 'en'>];

const breadcrumbs = [
  { label: c.homeLabel, href: `/${lang}/` },
  { label: c.toolsLabel, href: `/${lang}/tools/` },
  { label: c.toolShortLabel }
];

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": c.h1,
  "url": `https://isitkitchensafe.com/${lang}/tools/appliance-descaling-calculator/`,
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript.",
  "description": c.pageDescription,
  "inLanguage": lang,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": c.faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={c.pageTitle}
  description={c.pageDescription}
  breadcrumbs={breadcrumbs}
  faqs={c.faqs}
  excludeFaqSchema={true}
  availableLocales={availableLocales}
>
  <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={breadcrumbs} className="mb-0" />
    </div>
  </div>

  <main class="max-w-[1280px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="max-w-[880px] mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-signature-teal text-white mb-3">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23.693l-1.57-.393m15.6 0l1.24 3.72A2.25 2.25 0 0118.705 22H5.295a2.25 2.25 0 01-2.135-2.987l1.24-3.72" />
        </svg>
        <span>{c.badge}</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-heading tracking-tight mb-4">
        {c.h1}
      </h1>
      <p class="text-base sm:text-lg text-body-secondary leading-relaxed">
        {c.heroSub}
      </p>
    </header>

    <!-- Interactive Component -->
    <section class="mb-14">
      <ApplianceDescalingCalculator lang={lang} />
    </section>

    <!-- Critical Kitchen Safety Alerts & E-E-A-T Guide -->
    <section class="mt-14 border-t border-hairline pt-12">
      <div class="max-w-[960px] mx-auto">
        <h2 class="text-2xl sm:text-3xl font-bold text-heading tracking-tight mb-4">
          {c.trapsTitle}
        </h2>
        <p class="text-base text-body-secondary mb-8">
          {c.trapsSub}
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
          {c.traps.map((trap, idx) => (
            <div class={`p-6 rounded-2xl ${idx === 0 ? 'bg-danger-soft border border-danger-hairline' : idx === 1 ? 'bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-900/40' : 'bg-surface-soft border border-hairline'}`}>
              <div class="flex items-start gap-3">
                <span class="text-2xl" aria-hidden="true">{trap.icon}</span>
                <div>
                  <h3 class={`font-bold text-lg mb-1 ${idx === 0 ? 'text-red-900 dark:text-red-300' : idx === 1 ? 'text-amber-900 dark:text-amber-300' : 'text-heading'}`}>
                    {trap.title}
                  </h3>
                  <p class={`text-sm leading-relaxed ${idx === 0 ? 'text-red-800 dark:text-red-200' : idx === 1 ? 'text-amber-800 dark:text-amber-200' : 'text-body-secondary'}`}>
                    {trap.desc}
                  </p>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- FAQ Section -->
        <div class="mt-12">
          <h2 class="text-2xl sm:text-3xl font-bold text-heading tracking-tight mb-6">
            {c.faqTitle}
          </h2>
          <div class="space-y-4">
            {c.faqs.map((faq) => (
              <details class="group p-5 rounded-xl border border-hairline bg-surface-soft open:bg-surface-elevated transition-colors">
                <summary class="font-bold text-heading cursor-pointer list-none flex items-center justify-between gap-4">
                  <span>{faq.question}</span>
                  <span class="text-signature-teal group-open:rotate-180 transition-transform text-lg leading-none" aria-hidden="true">▾</span>
                </summary>
                <p class="mt-3 text-sm text-body-secondary leading-relaxed border-t border-hairline pt-3">
                  {faq.answer}
                </p>
              </details>
            ))}
          </div>
        </div>

        <!-- Related Consumer Tools -->
        <div class="mt-12 pt-8 border-t border-hairline">
          <h3 class="text-lg font-bold text-heading mb-4">{c.relatedTitle}</h3>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <a href={`/${lang}/tools/cookware-oven-temp-lookup/`} class="p-4 rounded-xl border border-hairline bg-surface-soft hover:border-signature-teal transition-all group">
              <span class="text-xs font-semibold text-signature-teal block mb-1">{c.cookwareTag}</span>
              <span class="font-bold text-heading text-sm group-hover:text-signature-teal block">{c.cookwareTitle}</span>
              <p class="text-xs text-body-secondary mt-1">{c.cookwareDesc}</p>
            </a>
            <a href={`/${lang}/tools/air-fryer-oven-converter/`} class="p-4 rounded-xl border border-hairline bg-surface-soft hover:border-signature-teal transition-all group">
              <span class="text-xs font-semibold text-signature-teal block mb-1">{c.airFryerTag}</span>
              <span class="font-bold text-heading text-sm group-hover:text-signature-teal block">{c.airFryerTitle}</span>
              <p class="text-xs text-body-secondary mt-1">{c.airFryerDesc}</p>
            </a>
            <a href={`/${lang}/tools/internal-cooking-temp-chart/`} class="p-4 rounded-xl border border-hairline bg-surface-soft hover:border-signature-teal transition-all group">
              <span class="text-xs font-semibold text-signature-teal block mb-1">{c.internalTempTag}</span>
              <span class="font-bold text-heading text-sm group-hover:text-signature-teal block">{c.internalTempTitle}</span>
              <p class="text-xs text-body-secondary mt-1">{c.internalTempDesc}</p>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
