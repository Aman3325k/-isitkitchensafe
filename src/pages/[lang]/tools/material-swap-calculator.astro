---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import MaterialSwapCalculator from '../../../components/MaterialSwapCalculator.astro';
import type { SupportedLanguage } from '../../../i18n/ui';
import { useTranslations, useTranslatedPath } from '../../../i18n/utils';

export function getStaticPaths() {
  const availableLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'zh-cn', 'ja'];
  return [
    { params: { lang: 'es' }, props: { lang: 'es' as SupportedLanguage, availableLocales } },
    { params: { lang: 'pt' }, props: { lang: 'pt' as SupportedLanguage, availableLocales } },
    { params: { lang: 'zh-cn' }, props: { lang: 'zh-cn' as SupportedLanguage, availableLocales } },
    { params: { lang: 'ja' }, props: { lang: 'ja' as SupportedLanguage, availableLocales } }
  ];
}

interface Props {
  lang: SupportedLanguage;
  availableLocales: SupportedLanguage[];
}

const { lang, availableLocales } = Astro.props;
const t = useTranslations(lang);
const tp = useTranslatedPath(lang);

interface LocaleSwapContent {
  pageTitle: string;
  pageDescription: string;
  badge: string;
  h1: string;
  heroSub: string;
  scienceTitle: string;
  scienceIntro: string;
  sciencePillars: Array<{ num: string; title: string; desc: string }>;
  faqs: Array<{ question: string; answer: string }>;
  breadcrumbs: Array<{ label: string; href?: string }>;
}

const CONTENT: Record<SupportedLanguage, LocaleSwapContent> = {
  en: {} as any,
  es: {
    pageTitle: "Calculadora de Reemplazo de Utensilios Seguros y Recomendaciones Veredicadas | IsItKitchenSafe",
    pageDescription: "Encuentra alternativas no tóxicas para sartenes de teflón rayadas, aluminio crudo y fiambreras de plástico. Compara acero inoxidable, hierro fundido, acero al carbono y vidrio con ahorro a 10 años.",
    badge: "Cero PFAS • Testado en Laboratorio • Durabilidad de por Vida",
    h1: "Calculadora de Sustitución de Utensilios Seguros",
    heroSub: "Da el paso desde el teflón desprendido, el aluminio reactivo y los plásticos que liberan microplásticos. Encuentra el material no tóxico exacto para tu estilo culinario, presupuesto y preferencias de limpieza.",
    scienceTitle: "La Ciencia de Cocinar con Materiales Culinarios No Tóxicos",
    scienceIntro: "Abandonar los revestimientos sintéticos de fluoropolímeros mejora la salud y eleva la técnica culinaria al dominar la termodinámica del calor directo:",
    sciencePillars: [
      {
        num: "01",
        title: "La Barrera de Vapor Leidenfrost",
        desc: "El acero inoxidable 18/10 se vuelve antiadherente por pura física. Al calentarlo entre 160°C y 180°C, la humedad de los alimentos genera un cojín de vapor microscópico que suspende las proteínas sobre el metal sin pegarse."
      },
      {
        num: "02",
        title: "Polimerización Natural de Aceites",
        desc: "El hierro fundido y el acero al carbono crean su antiadherencia mediante calor. Los ácidos grasos insaturados se polimerizan formando una capa bioplástica dura como el vidrio, libre de sustancias químicas sintéticas."
      },
      {
        num: "03",
        title: "Esmalte Vítreo Impermeable",
        desc: "El hierro fundido esmaltado y el vidrio de borosilicato funden cristales de sílice a más de 700°C. Al ser superficies 100% no porosas, resultan totalmente inertes ante salsas de tomate muy ácidas o marinadas de vino."
      }
    ],
    faqs: [
      {
        question: "¿Se pueden freír huevos en acero inoxidable sin que se peguen?",
        answer: "Sí, con la técnica del efecto Leidenfrost: precalienta la sartén a fuego medio durante 2 minutos. Echa unas gotas de agua: si se evaporan al instante, aún está fría; si bailan como canicas sin evaporarse, añade un poco de grasa, baja el fuego y cocina tus huevos sin que se adhieran."
      },
      {
        question: "¿Por qué es un error comprar sartenes antiadherentes baratas cada año?",
        answer: "Además de gastar dinero innecesariamente, las sartenes de teflón degradadas liberan millones de nanoplásticos por cada arañazo superficial. Una buena sartén de hierro o de acero inoxidable dura más de 50 años y jamás contamina la comida."
      },
      {
        question: "¿Es mejor el acero al carbono que el hierro fundido?",
        answer: "Comparten la misma química natural (hierro curado con aceite vegetal), pero el acero al carbono es un 40% más ligero, responde mucho más rápido a los cambios de temperatura y es el favorito para salteados wok y tortillas."
      },
      {
        question: "¿Por qué el vidrio de borosilicato es más seguro que el plástico para almacenar comida?",
        answer: "El plástico libera microplásticos y disruptores endocrinos (bisfenoles y ftalatos) al calentarse en el microondas con alimentos grasos. El vidrio de borosilicato resiste cambios bruscos de temperatura (-40°C a +300°C) sin liberar ninguna sustancia química."
      }
    ],
    breadcrumbs: [
      { label: "Inicio", href: "/es/" },
      { label: "Herramientas", href: "/es/tools/" },
      { label: "Calculadora de Sustitución Segura" }
    ]
  },
  pt: {
    pageTitle: "Calculadora de Troca de Panelas Seguras e Recomendações Auditadas | IsItKitchenSafe",
    pageDescription: "Descubra alternativas não tóxicas para frigideiras de teflon riscadas, alumínio cru e recipientes plásticos. Compare inox 18/10, ferro fundido, aço carbono e vidro com cálculo de economia em 10 anos.",
    badge: "Zero PFAS • Testado em Laboratório • Durabilidade para a Vida Toda",
    h1: "Calculadora de Substituição de Panelas Seguras",
    heroSub: "Substitua de vez o teflon descascando, o alumínio reativo e os potes plásticos que soltam microplásticos. Encontre o material ideal para o seu dia a dia, orçamento e hábitos na cozinha.",
    scienceTitle: "A Ciência dos Materiais Culinários Não Tóxicos",
    scienceIntro: "Abandonar os revestimentos sintéticos melhora a saúde e aprimora suas receitas com a física do calor direto:",
    sciencePillars: [
      {
        num: "01",
        title: "O Efeito Leidenfrost e Barreira de Vapor",
        desc: "O aço inoxidável 18/10 se torna antiaderente através da física. Pré-aquecido entre 160°C e 180°C, a umidade dos alimentos cria uma almofada microscópica de vapor que desliza os alimentos sem grudar."
      },
      {
        num: "02",
        title: "Polimerização Natural de Óleos Vegetais",
        desc: "O ferro fundido e o aço carbono desenvolvem uma pátina preta antiaderente pela cura com óleos naturais. O calor une os ácidos graxos ao metal, criando uma barreira impermeável sem flúor nem PFAS."
      },
      {
        num: "03",
        title: "Esmalte Vítreo Impermeável",
        desc: "O ferro esmaltado e o vidro borossilicato possuem superfícies de sílica vitrificada a altas temperaturas, totalmente impermeáveis e inertes mesmo em cozimentos ácidos de várias horas."
      }
    ],
    faqs: [
      {
        question: "Dá para fritar ovos no inox sem grudar?",
        answer: "Sim, dominando o efeito Leidenfrost: pré-aqueça a frigideira em fogo médio por 2 minutos. Pingue gotas de água: quando elas rolarem como esferas sem evaporar na hora, adicione manteiga ou óleo, abaixe o fogo e frite perfeitamente."
      },
      {
        question: "Por que não vale a pena comprar frigideiras antiaderentes baratas todo ano?",
        answer: "Panelas de teflon baratas perdem o revestimento em 12 a 18 meses, soltando milhões de partículas de microplásticos na comida. Panelas de ferro fundido ou inox custam pouco e duram gerações sem soltar químicas."
      },
      {
        question: "O aço carbono é melhor que o ferro fundido?",
        answer: "Ambos usam o mesmo princípio de cura natural com óleo, mas o aço carbono é 40% mais leve e aquece/resfria com maior agilidade, sendo perfeito para peixes, ovos e woks orientais."
      },
      {
        question: "Por que o vidro borossilicato é melhor que potes plásticos?",
        answer: "Potes plásticos no micro-ondas soltam microplásticos e ftalatos nos alimentos gordurosos. O vidro borossilicato não mancha, não pega cheiro e vai do congelador direto ao forno quente sem estourar."
      }
    ],
    breadcrumbs: [
      { label: "Início", href: "/pt/" },
      { label: "Ferramentas", href: "/pt/tools/" },
      { label: "Calculadora de Substituição Segura" }
    ]
  },
  'zh-cn': {
    pageTitle: "无毒厨具材质替换计算器与权威推荐 | IsItKitchenSafe",
    pageDescription: "告别划痕特氟龙、裸铝锅与塑料保鲜盒。精准匹配304/316不锈钢、纯铁锅、碳钢锅与高硼硅玻璃，测算10年省钱账与微塑料减排数据。",
    badge: "零氟化物 PFAS • 权威检测 • 传家级寿命",
    h1: "无毒健康厨具材质替换计算器",
    heroSub: "彻底告别掉涂层的特氟龙锅、析出铝离子的铝锅以及高温释放微塑料的塑料餐盒。根据您的做饭习惯、洗碗机偏好与预算，量身定制权威认证的无毒厨房升级方案。",
    scienceTitle: "科学揭秘：无毒金属厨具的物理防粘机理",
    scienceIntro: "摆脱化学氟碳涂层并不意味着烹饪会粘锅。掌握热力学物理规律，无涂层健康锅具同样能带来行云流水的滑爽体验：",
    sciencePillars: [
      {
        num: "01",
        title: "莱顿弗罗斯特（Leidenfrost）蒸汽膜效应",
        desc: "不锈钢不粘完全基于物理原理。中小火预热至160°C-180°C，水分在触碰到锅面时瞬间蒸发并形成一层微米级蒸汽气垫，托起肉排与鸡蛋蛋白，实现顺滑不粘。"
      },
      {
        num: "02",
        title: "天然油脂受热聚合开锅油膜",
        desc: "生铁锅与熟铁碳钢锅的黑亮油膜是天然植物油在高温下分子交联形成的生物保护层。随着日常翻炒自愈再生，既补充微量铁元素，又绝无化学涂层剥落风险。"
      },
      {
        num: "03",
        title: "高温玻化无机陶瓷釉面",
        desc: "珐琅铸铁锅与高硼硅玻璃在超高温下将天然石英与硼砂熔融为玻璃态釉面。质地致密平整，即使炖煮数小时的高酸度番茄红酒浓汤也绝无任何金属腐蚀析出。"
      }
    ],
    faqs: [
      {
        question: "不锈钢锅煎蛋真的可以做到不粘吗？",
        answer: "完全可以。掌握“水珠测温法”：空锅中小火预热约2分钟，撒入少许水珠，若水珠不沸腾蒸发而是像水银球一样在锅底来回滚动，说明锅温已达到理想莱顿弗罗斯特点。此时加入底油并转小火，下入鸡蛋即可轻松翻面滑炒。"
      },
      {
        question: "为什么说每隔一两年换一把廉价不粘锅既费钱又不健康？",
        answer: "每18个月丢弃一把涂层锅累计开销高昂，更严重的是涂层划伤后每次高温翻炒会脱落数百万纳米级塑料碎屑进入体内。一把数十美元的优质铸铁锅或不锈钢锅可传承数十年，永无化学降解风险。"
      },
      {
        question: "碳钢熟铁锅相比生铁铸铁锅有何优势？",
        answer: "二者化学成分均为健康无毒的天然铁油膜，但碳钢锅重量比铸铁轻约40%，升温降温极其灵敏，翻炒掂锅更省力，是中式爆炒、煎鱼和摊鸡蛋饼的绝佳利器。"
      },
      {
        question: "为什么微波加热应坚决用高硼硅玻璃替代塑料保鲜盒？",
        answer: "塑料盒在微波高温与油脂共同作用下会大量溶出塑化剂邻苯二甲酸酯和低聚物。高硼硅玻璃耐急冷急热达150°C温差，耐受300°C高温，冷冻室取出可直接入微波炉，安全无异味。"
      }
    ],
    breadcrumbs: [
      { label: "首页", href: "/zh-cn/" },
      { label: "安全工具", href: "/zh-cn/tools/" },
      { label: "厨具材质替换计算器" }
    ]
  },
  ja: {
    pageTitle: "安全な調理器具素材乗り換え計算機＆厳選推奨ガイド | IsItKitchenSafe",
    pageDescription: "傷ついたテフロン、酸に弱いアルミ鍋、微小プラが溶け出る保存容器を卒業。ステンレス、鉄、炭素鋼、耐熱ガラスの10年節約額と安全性を徹底比較。",
    badge: "PFASフリー • 第三者検査済み • 一生物の耐久性",
    h1: "安全な調理器具素材乗り換え計算機",
    heroSub: "コーティングが剥がれたテフロンや酸で腐食するアルミ鍋、熱でマイクロプラスチックを放出するプラ容器から卒業しましょう。あなたの調理スタイルや予算に最適な一生使える無毒器具を提案します。",
    scienceTitle: "科学で解き明かす：無毒性調理器具の物理的仕組み",
    scienceIntro: "化学フッ素コーティングを手放しても、熱物理学の基本を理解すれば食材が焦げ付かず快適に調理できます：",
    sciencePillars: [
      {
        num: "01",
        title: "ライデンフロスト蒸気膜現象",
        desc: "ステンレスフライパンのこびりつき防止は物理学です。約160℃〜180℃に予熱すると、食材の水分が瞬時に蒸気クッションを作り出し、食材を金属面から浮かせます。"
      },
      {
        num: "02",
        title: "天然植物油の熱重合による油膜形成",
        desc: "鋳鉄や炭素鋼（鉄フライパン）の黒い艶は、油の不飽和脂肪酸が熱で結合してできた天然の皮膜です。化学物質を一切使わず、使い込むほど滑らかに育ちます。"
      },
      {
        num: "03",
        title: "不浸透性のガラス質エナメル・ホウケイ酸",
        desc: "ホーロー鍋やホウケイ酸耐熱ガラスは高温で焼き付けられたガラス質です。トマトソースなどの強い酸に対しても金属イオンの溶出が一切なく、完全に衛生的です。"
      }
    ],
    faqs: [
      {
        question: "ステンレスフライパンで卵料理をくっつかずに焼く方法は？",
        answer: "ライデンフロスト効果を使います。中火で約2分空焚きし、水を数滴垂らします。水滴が蒸発せず玉になってコロコロ転がったら適温です。油を引いて弱火にし、卵を入れると驚くほどスルッと剥がれます。"
      },
      {
        question: "安価なテフロン鍋を1〜2年ごとに買い換えるのがNGな理由は？",
        answer: "買い替え費用がかさむだけでなく、傷がついたフッ素樹脂は加熱時に数百万個のナノプラスチックを食品中に放出します。一生使える鉄やステンレスなら有害物質の心配が一生ありません。"
      },
      {
        question: "中華鍋・鉄フライパン（炭素鋼）は鋳鉄（ダッチオーブン）とどう違う？",
        answer: "どちらも安全な鉄と油の皮膜ですが、炭素鋼は板をプレスして作られるため約40%軽く、温度変化に機敏に反応します。魚のムニエルや炒め物、オムレツに最適です。"
      },
      {
        question: "プラスチック製タッパーをホウケイ酸ガラスに変えるべき理由は？",
        answer: "油分の多い食品をプラ容器ごとレンジ加熱すると、熱でマイクロプラスチックや内分泌攪乱物質が溶出します。耐熱ホウケイ酸ガラスなら油汚れも染み込まず、冷凍庫からレンジまで安全に使えます。"
      }
    ],
    breadcrumbs: [
      { label: "ホーム", href: `/${lang}/` },
      { label: "安全ツール", href: `/${lang}/tools/` },
      { label: "安全な素材乗り換え計算機" }
    ]
  }
};

const c = CONTENT[lang] || CONTENT.es;

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": c.h1,
  "url": `https://isitkitchensafe.com/${lang}/tools/material-swap-calculator/`,
  "applicationCategory": "HealthApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "description": c.pageDescription,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};
---

<Layout title={c.pageTitle} description={c.pageDescription} faqs={c.faqs} availableLocales={availableLocales}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={c.breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1200px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-700 text-white mb-3">
        {c.badge}
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        {c.h1}
      </h1>
      <p class="text-body text-[15px] md:text-body-md leading-relaxed">
        {c.heroSub}
      </p>
    </header>

    <!-- Main Interactive Calculator Component -->
    <div class="mb-14">
      <MaterialSwapCalculator lang={lang} />
    </div>

    <!-- Science Deep-Dive Section -->
    <section class="mb-14 border-t border-hairline pt-12 space-y-8">
      <div class="max-w-3xl">
        <span class="text-xs font-bold uppercase tracking-wider text-muted block mb-1">
          {lang === 'ja' ? '材料科学 • 調理熱物理学 • 健康生活' : lang === 'zh-cn' ? '材料物理 • 烹饪热力学 • 无毒生活' : lang === 'pt' ? 'Ciência dos Materiais • Termodinâmica Culinária' : 'Ciencia de Materiales • Termodinámica Culinaria'}
        </span>
        <h2 class="text-title-lg md:text-display-sm font-medium text-ink tracking-tight mb-3">
          {c.scienceTitle}
        </h2>
        <p class="text-body text-[15px] leading-relaxed">
          {c.scienceIntro}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {c.sciencePillars.map((pillar) => (
          <div class="p-6 rounded-2xl bg-surface-soft border border-hairline space-y-3">
            <div class="w-9 h-9 rounded-xl bg-emerald-700 text-white font-bold flex items-center justify-center text-sm">
              {pillar.num}
            </div>
            <h3 class="font-semibold text-ink text-base">{pillar.title}</h3>
            <p class="text-xs text-body leading-relaxed">{pillar.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="border-t border-hairline pt-12">
      <h2 class="text-title-lg md:text-display-sm font-medium text-ink tracking-tight mb-8">
        {lang === 'ja' ? 'よくある質問' : lang === 'zh-cn' ? '常见问题与解答' : lang === 'pt' ? 'Perguntas Frequentes' : 'Preguntas Frecuentes'}
      </h2>
      <div class="space-y-6 max-w-3xl">
        {c.faqs.map(faq => (
          <div class="border-b border-hairline pb-6">
            <h3 class="text-base font-semibold text-ink mb-2">
              {faq.question}
            </h3>
            <p class="text-body text-sm leading-relaxed">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>
