    shelfTag: "残り物の保存期間",
    shelfTitle: "USDA 残り物冷蔵保存期間カウントダウンツール",
    shelfDesc: "調理済み肉料理、スープ、おかずの冷蔵3〜4日の保存期限と冷凍保存ルールを確認できます。",
    ovenTag: "調理器具の耐熱限界",
    ovenTitle: "鍋・耐熱皿オーブン安全温度検索ツール",
    ovenDesc: "ル・クルーゼ、パイレックス、ヘックスクラッド、シリコン型、クッキングシートの最高耐熱温度を瞬時に確認できます。",
    faqKicker: "よくある質問",
    faqTitle: "食品温度と焼き加減に関するFAQ",
    faqSub: "食品微生物学と公的衛生基準に基づく、温度計の使い方と安全管理のポイントを解説します。",
    faqs: [
      {
        question: "なぜUSDAは豚肉の安全中心温度を160°Fから145°Fに引き下げたのですか？",
        answer: "2011年、USDAは豚肉一枚肉の基準を160°Fから「145°F＋3分間の休息」へ改定しました。近代的な衛生管理により旋毛虫病のリスクがほぼ根絶されたこと、そして145°Fでの余熱休息により160°Fと同等の殺菌効果が得られ、肉がパサつかずジューシーに仕上がることが実証されたためです。"
      },
      {
        question: "なぜひき肉は160°Fが必要で、ステーキ肉は145°F（レアやミディアムレア）で安全なのですか？",
        answer: "ブロックのステーキ肉では、O157などの病原菌は表面にしか存在せず、表面を強火で焼くことで完全に死滅します。一方、ひき肉は加工の段階で表面の菌が中心部まで練り込まれるため、芯まで160°F（71°C）に加熱する必要があります。"
      },
      {
        question: "鶏肉が165°Fに達していても、骨の近くがピンク色に見えるのはなぜですか？",
        answer: "若鶏の骨は多孔質で薄いため、加熱中に骨髄のヘモグロビンが周囲の肉に染み出してピンク色に見えることがあります。中心温度計で165°F（74°C）が確認できていれば、見た目が薄いピンク色であっても完全に安全です。"
      },
      {
        question: "丸鶏や大きなロースト肉のどこに温度計プローブを刺すべきですか？",
        answer: "丸鶏やターキーでは、もも肉の付け根（骨に当たらないよう注意）、胸肉の最も厚い部分、手羽の関節にプローブを刺します。ステーキやハンバーグは側面から水平に中心に向けて刺します。"
      }
    ],
    homeLabel: "ホーム",
    toolsLabel: "ツール一覧",
    toolShortLabel: "安全調理温度早見表"
  }
};

const c = CONTENT[lang as Exclude<SupportedLanguage, 'en'>];

const breadcrumbs = [
  { label: c.homeLabel, href: `/${lang}/` },
  { label: c.toolsLabel, href: `/${lang}/tools/` },
  { label: c.toolShortLabel }
];

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": c.h1,
  "url": `https://isitkitchensafe.com/${lang}/tools/internal-cooking-temp-chart/`,
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript.",
  "description": c.pageDescription,
  "inLanguage": lang,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": c.faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={c.pageTitle}
  description={c.pageDescription}
  lang={lang}
  availableLocales={availableLocales}
  breadcrumbs={breadcrumbs}
  faqs={c.faqs}
>
  <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={breadcrumbs} className="mb-0" />
    </div>
  </div>

  <main class="max-w-[1280px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="max-w-[880px] mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-signature-teal text-white mb-3">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
        </svg>
        <span>{c.badge}</span>
      </div>
      <h1 class="text-display-lg md:text-display-xl font-bold text-ink tracking-tight mb-4">
        {c.h1}
      </h1>
      <p class="text-body-lg text-muted leading-relaxed">
        {c.heroSub}
      </p>
    </header>

    <!-- Interactive Component -->
    <InternalCookingTempChart lang={lang} />

    <!-- Traps Section -->
    <section class="mt-14 pt-12 border-t border-hairline">
      <div class="max-w-[880px] mb-8">
        <span class="text-caption text-muted uppercase tracking-wider text-xs block mb-1">{c.trapsKicker}</span>
        <h2 class="text-display-sm md:text-display-md font-bold text-ink tracking-tight mb-3">
          {c.trapsTitle}
        </h2>
        <p class="text-body-md text-muted leading-relaxed">
          {c.trapsSub}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {c.traps.map((trap) => (
          <div class="p-5 rounded-lg border border-hairline bg-surface shadow-xs">
            <div class="flex items-center gap-2 mb-2 font-semibold text-error">
              <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
              </svg>
              <span>{trap.title}</span>
            </div>
            <p class="text-body-sm text-body leading-relaxed">
              {trap.desc}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Related Tools Section -->
    <section class="mt-14 pt-10 border-t border-hairline">
      <h2 class="text-title-md font-semibold text-ink mb-6">
        {c.relatedTitle}
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <a
          href={`/${lang}/tools/meat-thawing-calculator/`}
          class="p-5 rounded-lg border border-hairline bg-surface hover:border-border-strong hover:shadow-xs transition-all flex flex-col justify-between group"
        >
          <div>
            <span class="inline-block text-[11px] font-bold uppercase tracking-wider text-info mb-1.5">{c.thawingTag}</span>
            <h3 class="text-title-sm font-semibold text-ink group-hover:text-primary transition-colors mb-2">
              {c.thawingTitle}
            </h3>
            <p class="text-body-xs text-muted leading-relaxed">
              {c.thawingDesc}
            </p>
          </div>
          <span class="text-link text-xs font-semibold flex items-center gap-1 mt-4">
            <span>&rarr;</span>
          </span>
        </a>

        <a
          href={`/${lang}/tools/leftover-shelf-life-calculator/`}
          class="p-5 rounded-lg border border-hairline bg-surface hover:border-border-strong hover:shadow-xs transition-all flex flex-col justify-between group"
        >
          <div>
            <span class="inline-block text-[11px] font-bold uppercase tracking-wider text-signature-teal mb-1.5">{c.shelfTag}</span>
            <h3 class="text-title-sm font-semibold text-ink group-hover:text-primary transition-colors mb-2">
              {c.shelfTitle}
            </h3>
            <p class="text-body-xs text-muted leading-relaxed">
              {c.shelfDesc}
            </p>
          </div>
          <span class="text-link text-xs font-semibold flex items-center gap-1 mt-4">
            <span>&rarr;</span>
          </span>
        </a>

        <a
          href={`/${lang}/tools/cookware-oven-temp-lookup/`}
          class="p-5 rounded-lg border border-hairline bg-surface hover:border-border-strong hover:shadow-xs transition-all flex flex-col justify-between group"
        >
          <div>
            <span class="inline-block text-[11px] font-bold uppercase tracking-wider text-signature-coral mb-1.5">{c.ovenTag}</span>
            <h3 class="text-title-sm font-semibold text-ink group-hover:text-primary transition-colors mb-2">
              {c.ovenTitle}
            </h3>
            <p class="text-body-xs text-muted leading-relaxed">
              {c.ovenDesc}
            </p>
          </div>
          <span class="text-link text-xs font-semibold flex items-center gap-1 mt-4">
            <span>&rarr;</span>
          </span>
        </a>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="mt-14 pt-10 border-t border-hairline">
      <div class="max-w-[800px] mb-8">
        <span class="text-caption text-muted uppercase tracking-wider text-xs block mb-1">{c.faqKicker}</span>
        <h2 class="text-display-sm font-bold text-ink tracking-tight mb-2">
          {c.faqTitle}
        </h2>
        <p class="text-body-md text-muted leading-relaxed">
          {c.faqSub}
        </p>
      </div>

      <div class="space-y-4 max-w-[880px]">
        {c.faqs.map((faq) => (
          <details class="group bg-surface border border-hairline rounded-lg p-5 transition-colors open:bg-surface-soft/60">
            <summary class="font-semibold text-ink cursor-pointer list-none flex items-center justify-between gap-4 text-title-sm">
              <span>{faq.question}</span>
              <svg class="w-5 h-5 text-muted shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
              </svg>
            </summary>
            <p class="mt-3 text-body-sm text-body leading-relaxed pt-3 border-t border-hairline">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </main>
</Layout>
