      {
        question: "粒子径のサブミクロン化はNoyes-Whitney式に基づきどのように溶出率を120倍以上向上させるのか？",
        answer: "難水溶性ファイトケミカル（クルクミン、レスベラトロール等）は経口吸収性が極めて低く限定的です。Noyes-Whitney式（dM/dt = D · A · [C_s - C_b] / h）が示す通り、溶出速度は比表面積（A/V = 6 / d_50）に正比例します。SAS-EME によって粒子径を25〜50 µmから80〜250 nmへ微小化することで比表面積は120倍以上に拡大します。USP <711> 溶出試験において、粗結晶原末が15分間で1.5%未満しか溶出しないのに対し、SAS-EME 製剤は99.1%以上の高い溶出速度を示します。"
      },
      {
        question: "商用 SAS-EME 装置はどのような衛生工学基準および規制に適合しているか？",
        answer: "本装置は、FDA 21 CFR § 117 (FSMA cGMP)、USP <467> 残留溶媒規格、USP <711> 溶出規格、電解研磨316Lステンレス（Ra < 0.4 µm）を用いた3-A サニタリー規格 63-04 / 08-17、EHEDG Type EL Class I 自動CIP洗浄性、およびASME Section VIII Div 1 / B31.3 高圧プロセス配管規格（耐圧250 bar）に完全適合しています。"
      }
    ]
  }
};

const c = CONTENT[lang] || CONTENT.es;

const breadcrumbs = [
  { label: t('nav.home'), href: tp('/') },
  { label: t('nav.tools'), href: tp('/tools/') },
  { label: c.breadcrumbsLabel }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": c.faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};

const toolSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": c.h1,
  "applicationCategory": "EngineeringApplication",
  "operatingSystem": "All",
  "description": c.pageDescription,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
};
---

<Layout title={c.pageTitle} description={c.pageDescription} lang={lang}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(toolSchema)} />

  <div class="container mx-auto px-4 py-8 max-w-7xl">
    <Breadcrumbs items={breadcrumbs} />

    <header class="mb-10 text-center max-w-4xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-950 text-emerald-400 border border-emerald-800/80 mb-4 shadow-xs">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        {c.badge}
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-ink tracking-tight mb-4">
        {c.h1}
      </h1>
      <p class="text-base sm:text-lg text-body leading-relaxed max-w-3xl mx-auto">
        {c.lead}
      </p>
    </header>

    <!-- Interactive Tool Component -->
    <CommercialContinuousSasEmeModeler lang={lang} />

    <!-- In-Depth Technical Engineering Analysis -->
    <div class="mt-16 space-y-12 max-w-5xl mx-auto text-ink">
      <!-- FAQ Section -->
      <section class="bg-surface-soft border border-hairline rounded-3xl p-6 sm:p-8 lg:p-10 shadow-xs">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight mb-6">
          {lang === 'es' ? 'Preguntas Frecuentes: Precipitación Antisolvente y Microencapsulación SAS-EME' :
           lang === 'pt' ? 'Perguntas Frequentes: Precipitação Antissolvente e Microencapsulação SAS-EME' :
           lang === 'zh-cn' ? '常见问题解答：SAS-EME 超临界二氧化碳反溶剂沉淀与静电微囊化' :
           'よくある質問：SAS-EME 超臨界貧溶媒沈殿および静電マイクロカプセル化'}
        </h2>
        <div class="space-y-4">
          {c.faqs.map(faq => (
            <details class="group bg-surface border border-hairline rounded-2xl p-5 open:bg-surface-soft transition-colors cursor-pointer">
              <summary class="font-semibold text-ink text-sm sm:text-base flex items-center justify-between gap-4 list-none">
                <span>{faq.question}</span>
                <span class="text-emerald-400 group-open:rotate-180 transition-transform">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </span>
              </summary>
              <p class="mt-3 text-body text-xs sm:text-sm leading-relaxed border-t border-hairline/60 pt-3">
                {faq.answer}
              </p>
            </details>
          ))}
        </div>
      </section>

      <!-- Related Tools Navigation -->
      <section class="border-t border-hairline pt-10">
        <h2 class="text-xl font-bold text-ink mb-6">
          {lang === 'es' ? 'Herramientas Diagnósticas de Física de Fluidos Supercríticos Relacionadas' :
           lang === 'pt' ? 'Ferramentas Diagnósticas de Fluidos Supercríticos Relacionadas' :
           lang === 'zh-cn' ? '相关旗舰级超临界流体与微囊化工程诊断工具' :
           '関連する旗艦超臨界流体・マイクロカプセル化工学モデラー'}
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <a href={tp("/tools/commercial-continuous-scco2-mhb-modeler/")} class="p-4 rounded-xl bg-surface border border-hairline hover:border-emerald-500 transition-colors block">
            <span class="text-xs font-bold text-emerald-400 uppercase tracking-wider block mb-1">Micro-Fluidic Gelation</span>
            <strong class="text-sm text-ink block mb-1">scCO2-MHB Modeler</strong>
            <span class="text-xs text-muted block">Supercritical CO2 in-situ hydrogel bead internal calcium gelation.</span>
          </a>
          <a href={tp("/tools/commercial-continuous-scco2-esn-electrospinning-modeler/")} class="p-4 rounded-xl bg-surface border border-hairline hover:border-emerald-500 transition-colors block">
            <span class="text-xs font-bold text-cyan-400 uppercase tracking-wider block mb-1">Supercritical Fibers</span>
            <strong class="text-sm text-ink block mb-1">scCO2-ESN Nanofibers</strong>
            <span class="text-xs text-muted block">Supercritical CO2 assisted electrospinning of bioactive nanofiber matrices.</span>
          </a>
          <a href={tp("/tools/commercial-continuous-scco2-mle-liposome-modeler/")} class="p-4 rounded-xl bg-surface border border-hairline hover:border-emerald-500 transition-colors block">
            <span class="text-xs font-bold text-amber-400 uppercase tracking-wider block mb-1">Nano-Encapsulation</span>
            <strong class="text-sm text-ink block mb-1">scCO2-MLE Liposomes</strong>
            <span class="text-xs text-muted block">Supercritical CO2 micro-fluidic liposome extrusion and nano-carriers.</span>
          </a>
          <a href={tp("/tools/commercial-continuous-osw-dor-modeler/")} class="p-4 rounded-xl bg-surface border border-hairline hover:border-emerald-500 transition-colors block">
            <span class="text-xs font-bold text-purple-400 uppercase tracking-wider block mb-1">Acoustic Demulsification</span>
            <strong class="text-sm text-ink block mb-1">OSW-DOR Modeler</strong>
            <span class="text-xs text-muted block">Orthogonal megasonic standing wave demulsification and cold oil recovery.</span>
          </a>
        </div>
      </section>
    </div>
  </div>
</Layout>
