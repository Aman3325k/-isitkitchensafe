---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CommercialCookwareNsfInspector from '../../../components/CommercialCookwareNsfInspector.astro';
import type { SupportedLanguage } from '../../../i18n/ui';
import { useTranslations, useTranslatedPath } from '../../../i18n/utils';

export function getStaticPaths() {
  const availableLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'zh-cn', 'ja'];
  return [
    { params: { lang: 'es' }, props: { lang: 'es' as SupportedLanguage, availableLocales } },
    { params: { lang: 'pt' }, props: { lang: 'pt' as SupportedLanguage, availableLocales } },
    { params: { lang: 'zh-cn' }, props: { lang: 'zh-cn' as SupportedLanguage, availableLocales } },
    { params: { lang: 'ja' }, props: { lang: 'ja' as SupportedLanguage, availableLocales } }
  ];
}

interface Props {
  lang: SupportedLanguage;
  availableLocales: SupportedLanguage[];
}

const { lang, availableLocales } = Astro.props;
const t = useTranslations(lang);
const tp = useTranslatedPath(lang);

interface LocaleContent {
  pageTitle: string;
  pageDescription: string;
  breadcrumbs: Array<{ label: string; href?: string }>;
  faqs: Array<{ question: string; answer: string }>;
  faqHeading: string;
  faqSub: string;
}

const CONTENT: Record<SupportedLanguage, LocaleContent> = {
  en: {} as any,
  es: {
    pageTitle: "Inspector de Certificación NSF/ANSI y Ciclo de Vida en Cocinas Comerciales | IsItKitchenSafe",
    pageDescription: "Audita utensilios de hostelería, tablas de corte y plásticos gastronómicos según las normas NSF/ANSI 2, 51 y el Código Alimentario de la FDA § 4-101.11. Calcula el riesgo de biopelículas bacterianas, degradación por desinfectantes y ciclos de lavado restantes.",
    breadcrumbs: [
      { label: 'Inicio', href: '/es/' },
      { label: 'Herramientas', href: '/es/tools/' },
      { label: 'Inspector NSF Hostelería' }
    ],
    faqHeading: "Preguntas Frecuentes sobre Higiene Comercial y Normas NSF/ANSI",
    faqSub: "Respuestas científicas basadas en ingeniería higiénica, normativas de la FDA e inspecciones de salud ambiental.",
    faqs: [
      {
        question: "¿Qué es la norma NSF/ANSI 2 y qué exige en los utensilios de cocina profesional?",
        answer: "La norma NSF/ANSI 2 (Equipos para Alimentos) fija los requisitos higiénicos mínimos para la hostelería. Exige que todas las superficies en contacto con alimentos sean lisas, no absorbentes, resistentes a la corrosión y de fácil limpieza. Entre sus reglas técnicas clave destaca el redondeo de esquinas y soldaduras internas (radio mínimo de 6,35 mm o 1/4 pulgada) para evitar la acumulación de restos orgánicos y la proliferación de biopelículas bacterianas."
      },
      {
        question: "¿Qué evalúa la norma NSF/ANSI 51 en los materiales plásticos y elastómeros?",
        answer: "La norma NSF/ANSI 51 regula la pureza toxicológica de plásticos, resinas, recubrimientos y gomas en contacto con alimentos comerciales. Mediante ensayos de extracción con disolventes, verifica que los materiales no liberen metales pesados, plastificantes, monómeros tóxicos o sustancias volátiles bajo calor intenso y exposición continuada a desinfectantes químicos clorados y sales de amonio cuaternario."
      },
      {
        question: "¿Por qué el Código Alimentario de la FDA § 4-501.12 exige retirar las tablas de corte con surcos profundos?",
        answer: "Cuando los surcos de cuchillo en tablas de polietileno (HDPE) superan 1,0–1,5 mm de profundidad, la grasa y las proteínas se incrustan en las microgrietas. Los desinfectantes químicos de lavado no pueden penetrar esta carga biológica, permitiendo que patógenos peligrosos como Listeria monocytogenes y Salmonella sobrevivan a los ciclos de lavado y contaminen alimentos listos para el consumo."
      },
      {
        question: "¿Por qué los lavavajillas químicos de baja temperatura dañan el acero 304 y el aluminio?",
        answer: "Los lavavajillas de baja temperatura emplean hipoclorito de sodio (lejía, 50–100 ppm) como agente sanitizante. El cloro libre corroe la película pasiva de óxido de cromo del acero 304, provocando picaduras por cloruros. En bandejas y ollas de aluminio crudo, la alta alcalinidad de los detergentes comerciales elimina la capa protectora de alúmina, desprendiendo óxido negro y acelerando la corrosión por picaduras."
      },
      {
        question: "¿Qué consecuencias tiene una Infracción Prioritaria (Priority Violation) de la FDA en una inspección sanitaria?",
        answer: "Una Infracción Prioritaria indica un peligro inminente de intoxicación alimentaria. Si el inspector halla utensilios astillados, oxidados o con biopelículas (FDA § 4-101.11 / § 4-501.12), emite un acta roja que exige su retirada o destrucción en menos de 24 horas. La reincidencia acarrea pérdida de puntos, bajada de calificación en la cartilla pública y la suspensión de la licencia de apertura."
      }
    ]
  },
  pt: {
    pageTitle: "Inspetor de Certificação NSF/ANSI e Ciclo de Vida de Utensílios Comerciais | IsItKitchenSafe",
    pageDescription: "Audite utensílios profissionais, tábuas de corte e recipientes gastronômicos conforme os padrões NSF/ANSI 2, 51 e Código da FDA § 4-101.11. Calcule o acúmulo de biofilmes bacterianos, corrosão por sanitizantes e ciclos de vida restantes.",
    breadcrumbs: [
      { label: 'Início', href: '/pt/' },
      { label: 'Ferramentas', href: '/pt/tools/' },
      { label: 'Inspetor NSF Utensílios Comerciais' }
    ],
    faqHeading: "Perguntas Frequentes sobre Higiene Comercial e Normas NSF/ANSI",
    faqSub: "Orientações fundamentadas em engenharia sanitária e diretrizes da vigilância sanitária internacional.",
    faqs: [
      {
        question: "O que é a norma NSF/ANSI 2 e o que ela exige para cozinhas profissionais?",
        answer: "A norma NSF/ANSI 2 estabelece requisitos rigorosos de higienização para equipamentos culinários comerciais. Exige que todas as superfícies de contato sejam lisas, impermeáveis, resistentes à corrosão e livres de reentrâncias. Cantos internos e soldas devem possuir raio de curvatura mínimo de 6,35 mm (1/4 de polegada) para impedir o acúmulo de sujidades e biofilmes bacterianos."
      },
      {
        question: "Como a norma NSF/ANSI 51 avalia a segurança de plásticos e borrachas?",
        answer: "A NSF/ANSI 51 analisa a estabilidade toxicológica e resistência de polímeros, resinas e borrachas. O padrão exige ensaios de migração para comprovar que o material não libera substâncias perigosas sob altas temperaturas e exposição frequente a sanitizantes químicos como cloro ativo e quaternário de amônio."
      },
      {
        question: "Por que tábuas de polietileno muito riscadas são proibidas pelas autoridades de saúde?",
        answer: "Segundo o FDA Food Code § 4-501.12, superfícies de corte com ranhuras profundas (acima de 1,0–1,5 mm) tornam-se impossíveis de sanitizar adequadamente. A matéria orgânica acumulada nas ranhuras protege bactérias como Listeria monocytogenes e Salmonella da ação dos sanitizantes químicos, causando contaminação cruzada contínua."
      },
      {
        question: "Por que sanitizantes clorados atacam o inox 304 e o alumínio na lava-louças comercial?",
        answer: "Lava-louças de baixa temperatura utilizam hipoclorito de sódio (50–100 ppm). O cloro ataca quimicamente a camada de passivação do inox 304, gerando corrosão por pite. No alumínio cru, os detergentes cáusticos dissolvem o óxido protetor, gerando manchas pretas e desgaste estrutural precoce."
      },
      {
        question: "Quais são as penalidades de uma Notificação Crítica de Vigilância Sanitária?",
        answer: "Notificações prioritárias (Priority Violations) decorrentes de equipamentos deteriorados exigem descarte imediato ou retirada do ambiente em até 24 horas. Infrações reiteradas resultam em rebaixamento na classificação de risco sanitário, multas e interdição temporária do estabelecimento."
      }
    ]
  },
  'zh-cn': {
    pageTitle: "商用厨具与接触设备 NSF/ANSI 认证合规与消杀生命周期检测仪 | IsItKitchenSafe",
    pageDescription: "严格对照 NSF/ANSI Standard 2、Standard 51 及美国 FDA 食品法典 § 4-101.11，全景审计商用锅具、砧板、餐盒与密封胶圈。精准评估细菌生物膜滋生隐患、消杀化学腐蚀与剩余清洗使用寿命。",
    breadcrumbs: [
      { label: '首页', href: '/zh-cn/' },
      { label: '实用工具', href: '/zh-cn/tools/' },
      { label: '商用厨具 NSF 认证检测仪' }
    ],
    faqHeading: "商用后厨卫生消杀与 NSF/ANSI 规范常见专业问答",
    faqSub: "基于权威工程卫生学、美国 FDA 食品卫生法典与公共卫生监督量化标准。",
    faqs: [
      {
        question: "什么是 NSF/ANSI Standard 2？它对商用厨房厨具有哪些强制性卫生要求？",
        answer: "NSF/ANSI Standard 2（食品设备卫生标准）是全球商用餐饮设备的基础准入门槛。它强制要求所有直接接触食品的表面必须平滑无孔、无吸附性、耐化学腐蚀并极易清洁。其关键工程法则包括所有内部阴角及焊接接缝必须具备至少 1/4 英寸（6.35 毫米）的圆弧倒角半径，杜绝形成藏污纳垢并滋生李斯特菌和沙门氏菌生物膜的微观死角。"
      },
      {
        question: "NSF/ANSI Standard 51 是如何严格监管食品接触材料（塑料与橡胶）的？",
        answer: "NSF/ANSI Standard 51（食品设备材料标准）评估塑料树脂、密封弹性体与涂层的化学纯度与抗老化极限。材料必须通过苛刻的溶剂萃取试验，证实其在商用高温烹饪及高频次接触次氯酸钠（有效氯50–100 ppm）、季铵盐消杀剂环境下，绝不迁移重金属、邻苯二甲酸酯增塑剂或有害挥发性有机物。"
      },
      {
        question: "为什么美国 FDA 食品法典 § 4-501.12 严令禁止后厨继续使用布满深划痕的切菜板？",
        answer: "当高密度聚乙烯（HDPE）商用砧板的刀痕深度超过 1.0–1.5 毫米时，食材中的动植物油脂与蛋白质颗粒会深陷并被压实于微裂缝中。此时常规化学消杀浸泡无法穿透有机生物载荷，致使单增李斯特菌、大肠杆菌与沙门氏菌在划痕深处建立不可逆的耐药生物膜，在接触熟食时引发严重的交叉污染暴发。"
      },
      {
        question: "为什么商用低温化学消杀洗碗机会腐蚀 304 不锈钢与生铝锅具？",
        answer: "低温商用洗碗机依赖 50–100 PPM 的次氯酸钠溶液完成终末消杀。游离氯离子会无情穿透 304 不锈钢表面的钝化铬氧化膜，引发严重的点蚀（Pitting Corrosion）；而在裸铝或未阳极氧化的铝制烤盘上，商用洗涤剂的高碱度（pH > 11）会剧烈腐蚀两性氧化铝，洗出黑色氧化粉末残留并导致金属结构脆化。"
      },
      {
        question: "卫生监督稽查中被判定为 FDA 食品法典“重点违规（Priority Violation）”有何严重后果？",
        answer: "重点严重违规（Priority Violation）代表该隐患直接导致食源性疾病传播风险。一旦卫生稽查官员在后厨发现涂层剥落的不粘锅、重度划痕的菜板或点蚀生锈的器具（依据 FDA § 4-101.11 / § 4-501.12），将当场开出红牌处罚单，责令在现场立即销毁或在 24 小时内清出营业场所。多次再犯将直接导致评级降至 C 级、高额行政罚款甚至吊销餐饮经营许可证。"
      }
    ]
  },
  ja: {
    pageTitle: "業務用調理器具 NSF/ANSI 衛生認証＆洗浄ライフサイクル診断インスペクター | IsItKitchenSafe",
    pageDescription: "NSF/ANSI Standard 2、Standard 51、および米国FDA食品基準 § 4-101.11に基づき、業務用フライパン、まな板、保存容器を監査。バイオフィルム蓄積リスク、洗浄剤による劣化、および安全耐用サイクルを算出します。",
    breadcrumbs: [
      { label: 'ホーム', href: '/ja/' },
      { label: 'ツール一覧', href: '/ja/tools/' },
      { label: '業務用調理器具 NSF 認証インスペクター' }
    ],
    faqHeading: "業務用厨房衛生および NSF/ANSI 規格に関するよくある質問",
    faqSub: "衛生工学、米国FDA食品コード、および飲食衛生監査基準に基づく科学的解説。",
    faqs: [
      {
        question: "NSF/ANSI Standard 2 とは何ですか？業務用調理器具に何を義務付けていますか？",
        answer: "NSF/ANSI Standard 2（食品機器規格）は、業務用調理器具の公衆衛生および清掃性を担保する国際基準です。食品に接触するすべての表面が平滑で非多孔質、耐腐食性であり、容易に洗浄できる構造を義務付けています。特に器具内部の角や溶接部には最小1/4インチ（6.35mm）以上の滑らかな曲面（アール）加工が義務付けられ、細菌バイオフィルムの温床となる角や隙間を排除しています。"
      },
      {
        question: "NSF/ANSI Standard 51 はプラスチックやゴム素材をどのように審査しますか？",
        answer: "NSF/ANSI Standard 51（食品機器材料規格）は、樹脂、コーティング、パッキン用ゴムの毒性学的純度と耐薬品性を評価します。高温環境下での溶出試験に加え、次亜塩素酸ナトリウム（有効塩素50〜100ppm）や第4級アンモニウム塩などの強力な業務用殺菌剤に繰り返し曝露されても、有害化学物質の移行や素材劣化を起こさないことが認証要件となります。"
      },
      {
        question: "FDA食品基準 § 4-501.12 が深い傷の入った業務用まな板の再研磨または廃棄を命じる理由は？",
        answer: "高密度ポリエチレン（HDPE）製まな板の包丁傷が1.0〜1.5mmを超えると、油脂やタンパク質残渣が微細な溝の奥深くに固着します。この有機物バリアがあるため、業務用殺菌水でも内部まで到達できず、リステリア菌やサルモネラ菌の強固なバイオフィルムが定着して生食肉から加熱不要食品への二次汚染源となるためです。"
      },
      {
        question: "低温化学殺菌食洗機が304ステンレスやアルミ鍋を腐食させる原因は？",
        answer: "低温食洗機は殺菌に次亜塩素酸ナトリウム（50〜100ppm）を用います。遊離塩素は304ステンレスの不動態皮膜を破壊し、微細な孔食（ピッティング）を発生させます。また裸のアルミ天板や寸胴鍋では、業務用アルカリ洗剤によって酸化アルミニウムが侵食され、黒い酸化粉末の付着や表面劣化を引き起こします。"
      },
      {
        question: "保健所等の衛生監査で「重点項目違反（Priority Violation）」と判定された場合の措置は？",
        answer: "食中毒の直接要因とみなされる重大違反に分類されます。劣化した器具（剥離したテフロンパン、細菌膜の残るまな板など）が発見された場合、24時間以内の使用停止または現場廃棄が命じられます。改善されない場合は行政指導、衛生等級（グレーディング）の引き下げ、または営業停止処分の対象となります。"
      }
    ]
  }
};

const c = CONTENT[lang];
const pageTitle = c.pageTitle;
const pageDescription = c.pageDescription;

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": c.pageTitle,
  "url": `https://isitkitchensafe.com/${lang}/tools/commercial-cookware-nsf-inspector/`,
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "description": c.pageDescription,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};
---

<Layout title={pageTitle} description={pageDescription} faqs={c.faqs} availableLocales={availableLocales} lang={lang}>
  <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />

  <main class="container mx-auto px-4 py-8 max-w-5xl space-y-8">
    <Breadcrumbs items={c.breadcrumbs} />

    <CommercialCookwareNsfInspector lang={lang} />

    <!-- FAQ Accordion Section -->
    <section class="mt-16 bg-surface-soft border border-hairline rounded-3xl p-6 md:p-10 space-y-6">
      <div class="border-b border-hairline pb-4">
        <span class="text-xs font-bold uppercase tracking-wider text-blue-800 block mb-1">
          {c.faqHeading}
        </span>
        <p class="text-xs text-muted">{c.faqSub}</p>
      </div>

      <div class="space-y-4">
        {c.faqs.map(faq => (
          <details class="group p-4 rounded-xl bg-canvas border border-hairline transition-colors open:bg-surface">
            <summary class="font-medium text-ink cursor-pointer list-none flex items-center justify-between text-sm md:text-base">
              <span>{faq.question}</span>
              <span class="text-muted transition-transform group-open:rotate-180 ml-2">&darr;</span>
            </summary>
            <p class="text-xs md:text-sm text-body mt-3 pt-3 border-t border-hairline/60 leading-relaxed">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </main>
</Layout>
