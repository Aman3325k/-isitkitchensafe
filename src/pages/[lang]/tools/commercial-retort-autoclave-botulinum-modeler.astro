          "position": 1,
          "name": t('nav.home'),
          "item": `https://isitkitchensafe.com${tp('/')}`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": t('nav.tools'),
          "item": `https://isitkitchensafe.com${tp('/tools/')}`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": c.breadcrumbsLabel,
          "item": `https://isitkitchensafe.com/${lang}/tools/commercial-retort-autoclave-botulinum-modeler/`
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": c.faqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
};
---

<Layout title={c.pageTitle} description={c.pageDescription} structuredData={structuredData}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
    <Breadcrumbs items={breadcrumbs} />

    <header class="mb-8 mt-4">
      <div class="flex items-center gap-2 mb-3">
        <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-rose-700 text-white">
          {c.badge}
        </span>
        <span class="text-xs text-muted font-mono">FDA 21 CFR § 113 &bull; ASME BPVC Sec VIII &bull; 12D Fo</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-ink tracking-tight">
        {c.h1}
      </h1>
      <p class="text-body text-base sm:text-lg leading-relaxed mt-3 max-w-4xl">
        {c.lead}
      </p>
    </header>

    <!-- Interactive Diagnostic Modeler -->
    <CommercialRetortAutoclaveModeler lang={lang} />

    <!-- Scientific & Regulatory Architecture Guide -->
    <article class="prose prose-slate max-w-none mt-12 pt-8 border-t border-hairline text-body text-sm leading-relaxed space-y-6">
      <h2 class="text-xl sm:text-2xl font-bold text-ink tracking-tight">
        {c.scienceTitle1}
      </h2>
      <p>
        {c.scienceText1}
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 not-prose my-6">
        <div class="p-5 rounded-2xl bg-surface-soft border border-hairline">
          <h3 class="text-sm font-bold text-ink mb-1.5 text-rose-700">
            {c.box1Title}
          </h3>
          <p class="text-xs text-muted leading-relaxed">
            {c.box1Text}
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-surface-soft border border-hairline">
          <h3 class="text-sm font-bold text-ink mb-1.5 text-rose-700">
            {c.box2Title}
          </h3>
          <p class="text-xs text-muted leading-relaxed">
            {c.box2Text}
          </p>
        </div>
      </div>

      <h2 class="text-xl sm:text-2xl font-bold text-ink tracking-tight">
        {c.scienceTitle2}
      </h2>
      <p>
        {c.scienceText2}
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 not-prose my-6">
        <div class="p-5 rounded-2xl bg-surface-soft border border-hairline">
          <h3 class="text-sm font-bold text-ink mb-1.5 text-rose-700">
            {c.box3Title}
          </h3>
          <p class="text-xs text-muted leading-relaxed">
            {c.box3Text}
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-surface-soft border border-hairline">
          <h3 class="text-sm font-bold text-ink mb-1.5 text-rose-700">
            {c.box4Title}
          </h3>
          <p class="text-xs text-muted leading-relaxed">
            {c.box4Text}
          </p>
        </div>
      </div>

      <!-- FAQ Section -->
      <div class="not-prose mt-12 pt-8 border-t border-hairline">
        <h3 class="text-xl font-bold text-ink tracking-tight mb-6">
          {lang === 'es' ? 'Preguntas Frecuentes sobre Esterilización Térmica y Autoclaves' :
           lang === 'pt' ? 'Perguntas Frequentes sobre Esterilização Térmica e Autoclaves' :
           lang === 'zh-cn' ? '关于商用杀菌釜热力灭菌与压力安全的常见问题' :
           'レトルト殺菌熱工学および圧力容器安全性に関するよくある質問'}
        </h3>
        <div class="space-y-4">
          {c.faqs.map(faq => (
            <details class="group p-5 rounded-2xl bg-surface-soft border border-hairline transition-all">
              <summary class="font-bold text-ink text-sm sm:text-base cursor-pointer list-none flex items-center justify-between gap-4">
                <span>{faq.question}</span>
                <span class="text-muted group-open:rotate-180 transition-transform text-xs">▼</span>
              </summary>
              <p class="text-muted text-xs sm:text-sm leading-relaxed mt-3 pt-3 border-t border-hairline">
                {faq.answer}
              </p>
            </details>
          ))}
        </div>
      </div>
    </article>
  </div>
</Layout>
