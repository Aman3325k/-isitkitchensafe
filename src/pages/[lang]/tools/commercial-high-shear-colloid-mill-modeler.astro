const c = CONTENT[lang];

const breadcrumbs = [
  { label: 'Home', href: `/${lang}/` },
  { label: 'Tools', href: `/${lang}/tools/` },
  { label: c.breadcrumbsLabel }
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": `https://isitkitchensafe.com/${lang}/tools/commercial-high-shear-colloid-mill-modeler/#webapp`,
      "url": `https://isitkitchensafe.com/${lang}/tools/commercial-high-shear-colloid-mill-modeler/`,
      "name": c.pageTitle,
      "applicationCategory": "EngineeringApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5 Canvas/CSS3.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": c.pageDescription
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": `https://isitkitchensafe.com/${lang}/`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Tools",
          "item": `https://isitkitchensafe.com/${lang}/tools/`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": c.breadcrumbsLabel,
          "item": `https://isitkitchensafe.com/${lang}/tools/commercial-high-shear-colloid-mill-modeler/`
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": c.faqs.map(f => ({
        "@type": "Question",
        "name": f.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": f.answer
        }
      }))
    }
  ]
};
---

<Layout
  title={c.pageTitle}
  description={c.pageDescription}
  structuredData={structuredData}
>
  <main class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
    <Breadcrumbs items={breadcrumbs} />

    <header class="mb-8 mt-4">
      <div class="flex items-center gap-2 mb-2">
        <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-100 text-blue-900 border border-blue-200">
          {c.badge}
        </span>
        <span class="text-xs text-muted font-mono">3-A 36-01 &bull; EHEDG Doc 8 &bull; FDA 21 CFR 110 &bull; OSHA 1910.212</span>
      </div>
      <h1 class="text-display-sm sm:text-display font-semibold text-ink tracking-tight mb-3">
        {c.h1}
      </h1>
      <p class="text-body-lg text-muted max-w-4xl leading-relaxed">
        {c.lead}
      </p>
    </header>

    <!-- Flagship Interactive Modeler Component with Locale -->
    <CommercialHighShearColloidMillModeler lang={lang} />

    <!-- Engineering Science & Rheological Mechanics Section -->
    <section class="my-16 space-y-12">
      <div class="border-t border-hairline pt-10">
        <h2 class="text-title-lg font-semibold text-ink tracking-tight mb-4">
          {c.scienceTitle1}
        </h2>
        <p class="text-body text-sm sm:text-base leading-relaxed mb-6">
          {c.scienceText1}
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="p-5 rounded-2xl bg-surface-soft border border-hairline">
            <h3 class="text-title-sm font-semibold text-ink mb-1.5">{c.box1Title}</h3>
            <p class="text-body text-xs leading-relaxed text-muted">{c.box1Text}</p>
          </div>
          <div class="p-5 rounded-2xl bg-surface-soft border border-hairline">
            <h3 class="text-title-sm font-semibold text-ink mb-1.5">{c.box2Title}</h3>
            <p class="text-body text-xs leading-relaxed text-muted">{c.box2Text}</p>
          </div>
        </div>
      </div>

      <div class="border-t border-hairline pt-10">
        <h2 class="text-title-lg font-semibold text-ink tracking-tight mb-4">
          {c.scienceTitle2}
        </h2>
        <p class="text-body text-sm sm:text-base leading-relaxed mb-6">
          {c.scienceText2}
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="p-5 rounded-2xl bg-surface-soft border border-hairline">
            <h3 class="text-title-sm font-semibold text-ink mb-1.5">{c.box3Title}</h3>
            <p class="text-body text-xs leading-relaxed text-muted">{c.box3Text}</p>
          </div>
          <div class="p-5 rounded-2xl bg-surface-soft border border-hairline">
            <h3 class="text-title-sm font-semibold text-ink mb-1.5">{c.box4Title}</h3>
            <p class="text-body text-xs leading-relaxed text-muted">{c.box4Text}</p>
          </div>
        </div>
      </div>

      <div class="border-t border-hairline pt-10">
        <h2 class="text-title-lg font-semibold text-ink tracking-tight mb-4">
          {lang === 'es' ? 'Preguntas Frecuentes (Reología de Molinos Coloidales y Seguridad Sanitaria)' :
           lang === 'pt' ? 'Perguntas Frequentes (Reologia e Segurança de Moinhos Coloidais)' :
           lang === 'zh-cn' ? '常见问题解答（胶体磨剪切流变学与卫生级工程安全）' :
           'よくある質問（コロイドミル流動レオロジー・サニタリー安全工学）'}
        </h2>
        <div class="space-y-6">
          {c.faqs.map((faq) => (
            <div class="bg-surface-soft/60 border border-hairline rounded-2xl p-6">
              <h3 class="text-title-sm font-semibold text-ink mb-2">
                {faq.question}
              </h3>
              <p class="text-body text-sm leading-relaxed text-muted">
                {faq.answer}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>
