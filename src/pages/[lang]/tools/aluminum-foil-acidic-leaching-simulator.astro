    faqs: [
      {
        question: "なぜアルミホイルはレモンやトマトなどの酸性食品ですぐに溶けるのですか？",
        answer: "アルミホイル表面の保護酸化膜はわずか2〜4ナノメートルしかありません。pH4.5未満の有機酸はこの保護層を化学的に溶解し、金属イオンを煮汁へ大量に溶出させます。"
      },
      {
        question: "オーブンの加熱温度はアルミの溶出量にどのように影響しますか？",
        answer: "アレニウスの速度論に従い、加熱温度の上昇とともに反応速度は指数関数的に加速します。180°C〜220°Cでは室温接触時の50〜90倍ものスピードで金属が食品へ移行します。"
      },
      {
        question: "アルミホイルをステンレス天板の上に直接敷くとどうなりますか？",
        answer: "酸性塩分液が電解質となり、約1.5Vの電位差による激しいガルバニック腐食が発生します。ホイルに穴が開き、黒っぽい金属酸化物が食品に移る原因になります。"
      },
      {
        question: "欧州食品安全機関（EFSA）の基準値と比べてどれくらい危険ですか？",
        answer: "EFSAの安全上限は週あたり体重1kgにつき1.0mgです。ホイル焼き1食で30〜80mgのアルミが摂取されることがあり、小児や体重の軽い人では1食で週基準の数倍を超えます。"
      },
      {
        question: "硬質アルマイト加工（ハードアナダイズド）の鍋でトマトソースを作るのは安全ですか？",
        answer: "はい、極めて安全です。特殊な電解処理によって35〜50マイクロメートル（ホイルの1万倍以上）の厚いセラミック皮膜が形成されており、酸性食品に対しても強固な耐性を誇ります。"
      },
      {
        question: "クッキングシートを使った二層包みとはどのような方法ですか？",
        answer: "酸性食材に直接触れる内側に耐熱クッキングシートを巻き、その外側からアルミホイルを重ねて包む手法です。金属イオンの混入をゼロにしつつ、ホイルの保温・密封効果を両立できます。"
      }
    ]
  }
};

const c = CONTENT[lang] || CONTENT.es;
---

<Layout title={c.pageTitle} description={c.pageDescription} faqs={c.faqs} availableLocales={availableLocales}>
  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={c.breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1280px] mx-auto px-6 py-10 md:py-16">
    <!-- Header -->
    <header class="max-w-4xl mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-rose-100 text-rose-900 mb-3 border border-rose-200">
        <span>🧪</span>
        {c.monoBadge}
      </div>
      <h1 class="text-3xl md:text-5xl font-extrabold text-ink tracking-tight mb-4 leading-tight">
        {c.monoTitle}
      </h1>
      <p class="text-base md:text-xl text-body leading-relaxed">
        {c.monoSub}
      </p>
    </header>

    <!-- Interactive Simulator Component -->
    <AluminumFoilAcidicLeachingSimulator lang={lang} />

    <!-- Scientific Engineering & Food Contact Guide -->
    <article class="prose max-w-none border-t border-hairline pt-12 space-y-10 text-body">
      <div>
        <h2 class="text-2xl font-bold text-ink mb-4">
          {c.monoSection1Title}
        </h2>
        <p class="leading-relaxed">
          {c.monoSection1Body}
        </p>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-ink mb-4">
          {c.monoSection2Title}
        </h2>
        <p class="leading-relaxed">
          {c.monoSection2Body}
        </p>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-ink mb-4">
          {c.monoSection3Title}
        </h2>
        <p class="leading-relaxed">
          {c.monoSection3Body}
        </p>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-ink mb-4">
          {c.monoSection4Title}
        </h2>
        <p class="leading-relaxed">
          {c.monoSection4Body}
        </p>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-ink mb-4">
          {c.monoSection5Title}
        </h2>
        <p class="leading-relaxed">
          {c.monoSection5Body}
        </p>
      </div>
    </article>
  </div>
</Layout>
