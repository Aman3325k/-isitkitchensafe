    {
      "@type": "FAQPage",
      "mainEntity": c.faqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
};
---

<Layout
  title={c.pageTitle}
  description={c.pageDescription}
  structuredData={structuredData}
>
  <main class="min-h-screen bg-surface-subtle py-8 sm:py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={breadcrumbs} />
      
      <!-- Interactive Modeler Component -->
      <CommercialContinuousSfcModeler lang={lang} />

      <!-- Frequently Asked Questions (FAQ) Section -->
      <section class="mt-12 bg-surface rounded-2xl border border-hairline p-6 sm:p-8 shadow-xs">
        <div class="mb-6">
          <h2 class="text-xl sm:text-2xl font-bold text-ink tracking-tight mb-2">
            {lang === 'es' ? 'Preguntas Frecuentes: Cromatografía de Fluidos Supercríticos y Purificación Bioactiva' :
             lang === 'pt' ? 'Perguntas Frequentes: Cromatografia de Fluidos Supercríticos e Purificação Bioativa' :
             lang === 'zh-cn' ? '常见问题解答：超临界流体色谱技术与植物活性物分离工程' :
             'よくあるご質問：超臨界流体クロマトグラフィー技術と生理活性物質精製工学'}
          </h2>
          <p class="text-body text-sm text-muted">
            {lang === 'es' ? 'Guía técnica sobre termodinámica del CO2 supercrítico, selectividad de fases estacionarias, cinética de Van Deemter y seguridad ASME Sección VIII.' :
             lang === 'pt' ? 'Guia técnico sobre termodinâmica do CO2 supercrítico, seletividade de fases estacionárias, cinética de Van Deemter e segurança ASME Seção VIII.' :
             lang === 'zh-cn' ? '关于超临界CO2热力学密度控制、固定相选择性、Van Deemter传质动力学及ASME承压设备安全的技术指引。' :
             '超臨界CO2の熱力学的密度制御、固定相選択性、Van Deemter物質移動速度論、およびASME圧力安全に関する技術ガイド。'}
          </p>
        </div>

        <div class="space-y-4">
          {c.faqs.map((faq, idx) => (
            <details class="group rounded-xl border border-hairline bg-surface-soft p-4 transition-all open:bg-surface open:shadow-xs">
              <summary class="flex cursor-pointer items-center justify-between font-medium text-ink text-sm sm:text-base list-none">
                <span class="font-bold flex items-center gap-2">
                  <span class="text-emerald-700 font-mono text-xs">Q{idx + 1}.</span>
                  {faq.question}
                </span>
                <span class="ml-4 transition-transform group-open:rotate-180 text-muted text-xs">
                  ▼
                </span>
              </summary>
              <div class="mt-3 text-xs sm:text-sm text-body leading-relaxed border-t border-hairline/60 pt-3 text-muted">
                {faq.answer}
              </div>
            </details>
          ))}
        </div>
      </section>
    </div>
  </main>
</Layout>
