const c = CONTENT[lang];
const breadcrumbs = [
  { label: t('breadcrumbs.home'), href: tp('/') },
  { label: t('breadcrumbs.tools'), href: tp('/tools/') },
  { label: c.breadcrumbsLabel }
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": `https://isitkitchensafe.com/${lang}/tools/commercial-extrusion-cooker-shear-modeler/#webapp`,
      "url": `https://isitkitchensafe.com/${lang}/tools/commercial-extrusion-cooker-shear-modeler/`,
      "name": c.h1,
      "applicationCategory": "EngineeringApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5 Canvas/CSS3.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": c.pageDescription
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": t('breadcrumbs.home'),
          "item": `https://isitkitchensafe.com${tp('/')}`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": t('breadcrumbs.tools'),
          "item": `https://isitkitchensafe.com${tp('/tools/')}`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": c.breadcrumbsLabel,
          "item": `https://isitkitchensafe.com/${lang}/tools/commercial-extrusion-cooker-shear-modeler/`
        }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": `https://isitkitchensafe.com/${lang}/tools/commercial-extrusion-cooker-shear-modeler/#faq`,
      "mainEntity": c.faqs.map((f) => ({
        "@type": "Question",
        "name": f.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": f.answer
        }
      }))
    }
  ]
};
---

<Layout
  title={c.pageTitle}
  description={c.pageDescription}
  structuredData={structuredData}
>
  <main class="min-h-screen bg-canvas">
    <div class="max-w-7xl mx-auto px-4 pt-6">
      <Breadcrumbs items={breadcrumbs} />
    </div>

    <CommercialExtrusionCookerShearModeler lang={lang} />

    <!-- Scientific Context & Technical FAQ Section -->
    <section class="max-w-7xl mx-auto px-4 py-12 border-t border-hairline/60">
      <div class="mb-8">
        <h2 class="text-title-lg font-bold text-ink mb-2">
          {c.scienceTitle1}
        </h2>
        <p class="text-body text-sm text-muted max-w-3xl leading-relaxed">
          {c.lead}
        </p>
      </div>

      <div class="space-y-4 max-w-4xl">
        {c.faqs.map((faq) => (
          <details class="group bg-surface border border-hairline rounded-2xl p-5 open:bg-surface-soft transition-colors">
            <summary class="font-medium text-sm text-ink cursor-pointer flex justify-between items-center select-none">
              <span>{faq.question}</span>
              <span class="text-muted group-open:rotate-180 transition-transform ml-2">&#9662;</span>
            </summary>
            <p class="text-xs text-muted leading-relaxed mt-3 pt-3 border-t border-hairline/60">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </main>
</Layout>
