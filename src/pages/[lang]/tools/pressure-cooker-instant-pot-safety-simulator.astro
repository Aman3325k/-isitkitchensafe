---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import PressureCookerSafetySimulator from '../../../components/PressureCookerSafetySimulator.astro';
import type { SupportedLanguage } from '../../../i18n/ui';
import { useTranslations, useTranslatedPath } from '../../../i18n/utils';

export function getStaticPaths() {
  const availableLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'zh-cn', 'ja'];
  return [
    { params: { lang: 'es' }, props: { lang: 'es' as SupportedLanguage, availableLocales } },
    { params: { lang: 'pt' }, props: { lang: 'pt' as SupportedLanguage, availableLocales } },
    { params: { lang: 'zh-cn' }, props: { lang: 'zh-cn' as SupportedLanguage, availableLocales } },
    { params: { lang: 'ja' }, props: { lang: 'ja' as SupportedLanguage, availableLocales } }
  ];
}

interface Props {
  lang: SupportedLanguage;
  availableLocales: SupportedLanguage[];
}

const { lang, availableLocales } = Astro.props;
const t = useTranslations(lang);
const tp = useTranslatedPath(lang);

interface LocaleContent {
  pageTitle: string;
  pageDescription: string;
  breadcrumbs: Array<{ label: string; href?: string }>;
  faqs: Array<{ question: string; answer: string }>;
  monoBadge: string;
  monoTitle: string;
  monoSub: string;
  monoSection1Title: string;
  monoSection1Body: string;
  monoSection2Title: string;
  monoSection2Body: string;
  monoSection3Title: string;
  monoSection3Body: string;
}

const CONTENT: Record<SupportedLanguage, LocaleContent> = {
  en: {} as any,
  es: {
    pageTitle: "Simulador de Riesgo de Explosión, Juntas y Quemaduras en Ollas a Presión | IsItKitchenSafe",
    pageDescription: "Calcule la presión manométrica (10–15 PSI), energía cinética de vapor, obstrucción por espuma de almidón, fatiga de juntas de silicona y normas de botulismo del USDA en conservas.",
    breadcrumbs: [
      { label: 'Inicio', href: '/es/' },
      { label: 'Herramientas', href: '/es/tools/' },
      { label: 'Simulador de Seguridad en Ollas a Presión' }
    ],
    monoBadge: "Física de Alta Presión y Prevención de Quemaduras",
    monoTitle: "Simulador de Seguridad en Ollas a Presión e Instant Pot",
    monoSub: "Simule presión manométrica, descompresión explosiva, obstrucción por espuma en válvulas y límites de seguridad para conservas del USDA.",
    monoSection1Title: "1. Termodinámica del Vapor y Ebullición Explosiva",
    monoSection1Body: "A 11.6 PSI de presión manométrica (Instant Pot), el agua no hierve hasta alcanzar los 116.7°C (242°F). Al despresurizar bruscamente o forzar la tapa, el agua sobrecalentada se convierte instantáneamente en vapor con una relación de expansión volumétrica de 1600 a 1, expulsando líquidos hirviendo a gran velocidad.",
    monoSection2Title: "2. Formación de Espuma de Almidón y Bloqueo de la Válvula",
    monoSection2Body: "Los guisantes secos, lentejas y avena generan espuma proteica densa. Llenar la olla por encima de la mitad o usar liberación rápida (Quick Release) hace que la espuma ingrese en el tubo de escape y se seque formando un tapón rígido e impermeable.",
    monoSection3Title: "3. Prohibición del USDA para Conservas en Ollas Eléctricas",
    monoSection3Body: "El USDA y el NCHFP prohíben estrictamente el uso de ollas eléctricas multicocedoras para conservas de baja acidez (carnes y verduras). Las esporas de Clostridium botulinum sobreviven a menos que se mantengan 115°C a 121°C constantes y verificados con manómetro calibrado.",
    faqs: [
      {
        question: "¿Puede explotar una Instant Pot o una olla a presión moderna?",
        answer: "Sí. Aunque la rotura del metal es rara debido a las válvulas de alivio redundantes, los accidentes reales ocurren cuando se fuerza el giro de la tapa con presión residual interior (2 a 4 PSI) o cuando una válvula obstruida cede repentinamente. A 11.6 PSI, una tapa de 6 litros soporta más de 130 kg de empuje hacia arriba."
      },
      {
        question: "¿Se pueden hacer conservas de carnes o verduras en una Instant Pot?",
        answer: "No. El Centro Nacional para la Conservación Doméstica de Alimentos (NCHFP) del USDA prohíbe explícitamente el uso de multicocedoras eléctricas para conservas de baja acidez. Las esporas de Clostridium botulinum sobreviven si la temperatura oscila por debajo de 115°C."
      },
      {
        question: "¿Cada cuánto tiempo se debe cambiar la junta de silicona?",
        answer: "Se recomienda reemplazar la junta de silicona cada 12 a 18 meses, o después de unas 100 a 150 sesiones de cocción. El calor continuo endurece la silicona (aumentando su dureza Shore A) y provoca fugas laterales de vapor a 115°C."
      }
    ]
  },
  pt: {
    pageTitle: "Simulador de Risco de Explosão, Borrachas e Queimaduras em Panelas de Pressão | IsItKitchenSafe",
    pageDescription: "Calcule a pressão manométrica (10–15 PSI), energia cinética de vapor, obstrução por espuma de leguminosas, envelhecimento de borrachas de vedação e limites de botulismo do USDA.",
    breadcrumbs: [
      { label: 'Início', href: '/pt/' },
      { label: 'Ferramentas', href: '/pt/tools/' },
      { label: 'Simulador de Segurança em Panelas de Pressão' }
    ],
    monoBadge: "Física de Alta Pressão e Prevenção de Queimaduras",
    monoTitle: "Simulador de Segurança em Panelas de Pressão e Instant Pot",
    monoSub: "Simule pressão interna manométrica, descompressão explosiva, entupimento de válvulas por espuma e conformidade do USDA para conservas caseiras.",
    monoSection1Title: "1. Termodinâmica do Vapor Comprimido e Erupção Violenta",
    monoSection1Body: "A 11.6 PSI (Instant Pot), o ponto de ebulição da água sobe para 116.7°C. A abertura precipitada da tampa sob pressão provoca expansão flash com fator volumétrico de 1600 para 1, disparando caldos escaldantes em 360 graus.",
    monoSection2Title: "2. Espuma de Amido e Obstrução do Duto de Escape",
    monoSection2Body: "Grãos, lentilhas e ervilhas expandem-se rapidamente criando espuma densa. Ultrapassar a linha de 1/2 da capacidade provoca subida da espuma para a válvula, onde carameliza e trava o pino de alívio.",
    monoSection3Title: "3. Proibição do USDA de Conservas em Panelas Elétricas",
    monoSection3Body: "O USDA e o NCHFP proíbem panelas de pressão elétricas para conservas de baixa acidez (carnes, peixes e legumes). A inativação confiável de esporos de Clostridium botulinum exige autoclaves ou panelas de pressão de fogão com manômetro aferido a 15 PSI estáveis.",
    faqs: [
      {
        question: "Uma panela de pressão elétrica pode realmente explodir?",
        answer: "Sim. A explosão física ocorre pelo desprendimento intempestivo da tampa sob pressão residual de 2 a 4 PSI. Uma tampa de 6 litros suporta mais de 130 kg de empuxo vertical sob pressão de trabalho."
      },
      {
        question: "É seguro fazer conservas de carne ou legumes na Instant Pot?",
        answer: "Não. O USDA proíbe expressamente o uso de panelas elétricas multicooker para conservas caseiras de baixa acidez, devido à instabilidade térmica que permite a sobrevivência de esporos de botulismo."
      },
      {
        question: "Quando devo trocar o anel de silicone de vedação?",
        answer: "Recomenda-se trocar a vedação de silicone a cada 12 a 18 meses, ou assim que apresentar rigidez excessiva (aumento de dureza Shore A) ou microfissuras."
      }
    ]
  },
  ja: {
    pageTitle: "圧力鍋・インスタントポット爆発リスク・パッキン疲労・蒸気火傷シミュレーター | IsItKitchenSafe",
    pageDescription: "内部ゲージ圧力（10〜15 PSI）、蒸気膨張運動エネルギー、デンプン泡立ちによる安全弁閉塞、シリコンパッキン硬化、および低酸性缶詰のボツリヌス菌殺菌基準をリアルタイム計算。",
    breadcrumbs: [
      { label: 'ホーム', href: '/ja/' },
      { label: 'ツール一覧', href: '/ja/tools/' },
      { label: '圧力鍋安全シミュレーター' }
    ],
    monoBadge: "高圧物理学・蒸気熱傷防止シミュレーション",
    monoTitle: "圧力鍋・電気圧力鍋（インスタントポット）安全シミュレーター",
    monoSub: "内部圧力、爆発的減圧エネルギー、食材泡立ちによる安全弁閉塞、パッキン熱劣化、およびUSDA低酸性缶詰ボツリヌス菌リスクの解析。",
    monoSection1Title: "1. 高圧蒸気の熱力学と爆発的沸騰現象",
    monoSection1Body: "ゲージ圧11.6 PSI（電気圧力鍋）において、水の沸点は116.7℃に上昇します。加圧状態で不用意にフタを開けようとすると、過熱水が体積1600倍の蒸気へと瞬間気化し、116℃の熱湯と食材が四方に爆散します。",
    monoSection2Title: "2. デンプン泡立ちと安全弁ノズルの閉塞機構",
    monoSection2Body: "エンドウ豆、レンズ豆、オートミールは急速沸騰により高粘度の泡を発生させます。容量の半分を超えて充填したり急排気を行うと、泡が蒸気管に侵入して冷え固まり、圧力トラップを引き起こします。",
    monoSection3Title: "3. 米国農務省（USDA）による電気圧力鍋の缶詰保存禁止指針",
    monoSection3Body: "USDAおよびNCHFPは、電気圧力鍋を低酸性食品（肉類・魚介・野菜）の缶詰・瓶詰め保存に使用することを固く禁じています。ボツリヌス菌（Clostridium botulinum）の耐熱性胞子を死滅させるには、校正された圧力計による持続的121℃の維持が必須です。",
    faqs: [
      {
        question: "電気圧力鍋や現代の圧力鍋でも爆発事故は起きますか？",
        answer: "はい。金属容器自体の破裂は安全弁により防がれますが、残圧（2〜4 PSI程度）がある状態でフタを無理に回して爪が破断した瞬間に、沸騰液が爆発的に噴出する事故が米国CPSCに多数報告されています。"
      },
      {
        question: "インスタントポットで肉や野菜の長期保存瓶詰め（缶詰）を作れますか？",
        answer: "いいえ。USDA（米国農務省）は電気圧力鍋による低酸性食品の瓶詰め保存を固く禁止しています。ボツリヌス菌胞子は115〜121℃の精密制御がなければ死滅せず、致死的なボツリヌス毒素中毒の危険があります。"
      },
      {
        question: "圧力鍋のシリコンパッキンはどのくらいの頻度で交換すべきですか？",
        answer: "12〜18ヶ月ごと、または約100〜150回の使用での交換が推奨されます。熱サイクルによりショアA硬度が増加し弾性を失うと、側面から高温蒸気が漏れ出して熱傷の原因になります。"
      }
    ]
  },
  'zh-cn': {
    pageTitle: "高压锅与电压力锅爆炸风险、密封圈老化及蒸汽烫伤模拟器 | IsItKitchenSafe",
    pageDescription: "实时模拟高压锅锅内表压（10–15 PSI）、蒸汽爆炸动能、淀粉气泡堵塞防堵罩、硅胶密封圈硬化疲劳，以及低酸罐头肉毒杆菌致死灭菌安全标准。",
    breadcrumbs: [
      { label: '首页', href: '/zh-cn/' },
      { label: '工具库', href: '/zh-cn/tools/' },
      { label: '高压锅与电压力锅安全模拟器' }
    ],
    monoBadge: "高压物理学与蒸汽防烫工程模拟",
    monoTitle: "高压锅与电压力锅安全及爆炸风险模拟器",
    monoSub: "模拟锅体内压、爆炸性减压动能、食材淀粉起泡堵塞安全阀、硅胶密封圈硬化疲劳及USDA低酸罐头肉毒杆菌安全防线。",
    monoSection1Title: "1. 高压蒸汽热力学与过热液体闪蒸喷爆",
    monoSection1Body: "在11.6 PSI表压下（标准电压力锅），水沸点升高至116.7°C。若在带压状态下强行旋开锅盖，锅内过热液体将瞬间闪蒸为体积扩大1600倍的蒸汽，以巨大动能喷射沸腾汤汁。",
    monoSection2Title: "2. 淀粉发泡与防堵罩糊死闭塞机理",
    monoSection2Body: "干豆、豌豆和燕麦富含蛋白质与淀粉，沸腾时产生大量致密泡沫。若装料超过内胆1/2线或强行快速排气，泡沫涌入排气管迅速结痂胶结，导致安全浮子阀完全失效卡死。",
    monoSection3Title: "3. 美国农业部（USDA）严禁电压力锅用于低酸罐头制作",
    monoSection3Body: "USDA及家庭食品保藏中心（NCHFP）明确禁止使用普通电压力锅制作肉类、蔬菜等低酸罐头。肉毒杆菌芽孢具有极高耐热性，必须在115°C至121°C稳定受压90分钟，普通电压力锅的间歇脉冲加热无法达到灭菌安全红线。",
    faqs: [
      {
        question: "电压力锅和高压锅真的会发生爆炸吗？",
        answer: "是的。现代高压锅虽有多重泄压阀，但重大事故多发生在锅内仍有2至4 PSI残余压力时强行拧开锅盖，或排气孔完全被干硬淀粉堵死时。在11.6 PSI下，6夸脱锅盖承受逾130公斤向上推力，过早脱扣会引发极其剧烈的沸水喷爆。"
      },
      {
        question: "可以用电压力锅自制蔬菜或肉类罐头长期保存吗？",
        answer: "严禁如此操作。美国农业部（USDA）严格禁止使用电压力锅自制低酸罐头。电压力锅压力周期波动，无法确保持续达到灭活致命肉毒杆菌芽孢所需的121°C温度。"
      },
      {
        question: "高压锅硅胶密封圈应该多久更换一次？",
        answer: "建议每12至18个月或烹饪100至150次更换一次。长期高温高压会导致硅胶肖氏A硬度从50上升至68以上，弹性丧失后易导致边缘高压热蒸汽泄漏或意外爆脱。"
      }
    ]
  }
};

const c = CONTENT[lang] || CONTENT.es;
---

<Layout title={c.pageTitle} description={c.pageDescription} faqs={c.faqs} availableLocales={availableLocales}>
  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={c.breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1280px] mx-auto px-6 py-10 md:py-16">
    <!-- Header -->
    <header class="max-w-4xl mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-red-100 text-red-900 mb-3">
        <span>⚠️</span>
        {c.monoBadge}
      </div>
      <h1 class="text-3xl md:text-5xl font-extrabold text-ink tracking-tight mb-4 leading-tight">
        {c.monoTitle}
      </h1>
      <p class="text-base md:text-xl text-body leading-relaxed">
        {c.monoSub}
      </p>
    </header>

    <!-- Interactive Simulator Component -->
    <PressureCookerSafetySimulator lang={lang} />

    <!-- Scientific Engineering & Physics Guide -->
    <article class="prose max-w-none border-t border-hairline pt-12 space-y-10 text-body">
      <div>
        <h2 class="text-2xl font-bold text-ink mb-4">
          {c.monoSection1Title}
        </h2>
        <p class="leading-relaxed">
          {c.monoSection1Body}
        </p>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-ink mb-4">
          {c.monoSection2Title}
        </h2>
        <p class="leading-relaxed">
          {c.monoSection2Body}
        </p>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-ink mb-4">
          {c.monoSection3Title}
        </h2>
        <p class="leading-relaxed">
          {c.monoSection3Body}
        </p>
      </div>
    </article>
  </div>
</Layout>
