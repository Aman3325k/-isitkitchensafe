      <div>
        <h2 class="text-2xl font-bold text-ink mb-4">
          {c.monoSection2Title}
        </h2>
        <p class="leading-relaxed">
          {c.monoSection2Body}
        </p>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-ink mb-4">
          {c.monoSection3Title}
        </h2>
        <p class="leading-relaxed">
          {c.monoSection3Body}
        </p>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-ink mb-4">
          {c.monoSection4Title}
        </h2>
        <p class="leading-relaxed">
          {c.monoSection4Body}
        </p>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-ink mb-4">
          {c.monoSection5Title}
        </h2>
