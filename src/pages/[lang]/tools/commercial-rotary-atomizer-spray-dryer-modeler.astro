      {
        question: "NFPA 68放散ベントおよびNFPA 69能動的化学消火システムは乾燥塔をどう防護するのか？",
        answer: "食品粉末はSt 1クラスの可燃性粉塵雲（Kst 100〜200 bar·m/s、最大爆発圧力Pmax 8〜10 bar）を形成します。乾燥塔本体はこの内圧に耐えられません。NFPA 68規格に基づき、塔頂やコーン部に低慣性放散扉や破裂板を設置し、屋外へ低減圧力（Pred ≤ 0.2〜0.5 bar）で安全に爆燃ガスを放出します。またNFPA 69規格では、超高速赤外線火炎センサーが10ミリ秒以内に発火を検知し、25〜35ミリ秒以内に重曹消火剤キャノンを噴射して圧力上昇前に火炎球を完全に消火します。"
      },
      {
        question: "ISO 10816-3規格に基づくアトマイザースピンドルの連続振動監視が不可欠な理由は？",
        answer: "最大24,000 RPMで回転するディスクは極めて大きな運動エネルギーを持ちます。ディスク流路内部に粉末が不均一に付着したり異物が詰まると、激しい動的不釣合いが生じます。ISO 10816-3基準では、正常振動値は2.8 mm/s RMS未満が要求されます。4.5 mm/s RMSに達するとベアリングの熱損傷が急速に進み、7.1 mm/s RMSを超えると軸受の瞬時焼き付き、スピンドル破断、および超音速でのディスク粉砕飛散の危険が生じます。3軸加速度センサーとミリ秒停止インターロックが必須です。"
      }
    ]
  }
};

const c = CONTENT[lang as Exclude<SupportedLanguage, 'en'>];

const breadcrumbs = [
  { label: t('nav.home') || 'Home', href: tp('/') },
  { label: t('nav.tools') || 'Tools', href: tp('/tools/') },
  { label: c.breadcrumbsLabel }
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": `https://isitkitchensafe.com/${lang}/tools/commercial-rotary-atomizer-spray-dryer-modeler/#webapp`,
      "url": `https://isitkitchensafe.com/${lang}/tools/commercial-rotary-atomizer-spray-dryer-modeler/`,
      "name": c.pageTitle,
      "applicationCategory": "EngineeringApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5 Canvas/CSS3.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": c.pageDescription
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": t('nav.home') || 'Home',
          "item": `https://isitkitchensafe.com${tp('/')}`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": t('nav.tools') || 'Tools',
          "item": `https://isitkitchensafe.com${tp('/tools/')}`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": c.breadcrumbsLabel,
          "item": `https://isitkitchensafe.com${tp('/tools/commercial-rotary-atomizer-spray-dryer-modeler/')}`
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": c.faqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
};
---

<Layout 
  title={c.pageTitle}
  description={c.pageDescription}
  structuredData={structuredData}
>
  <main class="max-w-5xl mx-auto px-4 sm:px-6 py-8">
    <Breadcrumbs items={breadcrumbs} />

    <div class="mb-6">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-600 dark:text-amber-400 mb-2">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <path d="M12 6v6l4 2"></path>
        </svg>
        {c.badge}
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-ink tracking-tight mb-3">
        {c.h1}
      </h1>
      <p class="text-base sm:text-lg text-muted max-w-3xl leading-relaxed">
        {c.lead}
      </p>
    </div>

    <CommercialRotaryAtomizerSprayDryerModeler lang={lang} />

    <section class="mt-12 border-t border-hairline pt-8">
      <h2 class="text-2xl font-bold text-ink mb-6">Frequently Asked Engineering Questions</h2>
      <div class="space-y-6">
        {c.faqs.map(faq => (
          <div class="bg-surface-soft p-5 sm:p-6 rounded-xl border border-hairline">
            <h3 class="text-base sm:text-lg font-bold text-ink mb-2">{faq.question}</h3>
            <p class="text-sm text-muted leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </section>
  </main>
</Layout>
