---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import PlasticizerBurdenEstimator from '../../../components/PlasticizerBurdenEstimator.astro';
import type { SupportedLanguage } from '../../../i18n/ui';
import { useTranslations, useTranslatedPath } from '../../../i18n/utils';

export function getStaticPaths() {
  const availableLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'zh-cn', 'ja'];
  return [
    { params: { lang: 'es' }, props: { lang: 'es' as SupportedLanguage, availableLocales } },
    { params: { lang: 'pt' }, props: { lang: 'pt' as SupportedLanguage, availableLocales } },
    { params: { lang: 'zh-cn' }, props: { lang: 'zh-cn' as SupportedLanguage, availableLocales } },
    { params: { lang: 'ja' }, props: { lang: 'ja' as SupportedLanguage, availableLocales } }
  ];
}

interface Props {
  lang: SupportedLanguage;
  availableLocales: SupportedLanguage[];
}

const { lang, availableLocales } = Astro.props;
const t = useTranslations(lang);
const tp = useTranslatedPath(lang);

interface LocaleContent {
  pageTitle: string;
  pageDescription: string;
  breadcrumbs: Array<{ label: string; href?: string }>;
  faqs: Array<{ question: string; answer: string }>;
  faqHeading: string;
  faqSub: string;
}

const CONTENT: Record<SupportedLanguage, LocaleContent> = {
  en: {} as any,
  es: {
    pageTitle: "Estimador de Carga Sanguínea de Microplásticos y Ftalatos en la Cocina | IsItKitchenSafe",
    pageDescription: "Cuantifica tu exposición dietética a microplásticos, nanoplásticos, ftalatos y bisfenoles. Calcula partículas ingeridas semanalmente, equivalentes en tarjetas de crédito y tu plan de des-plastificación.",
    breadcrumbs: [
      { label: 'Inicio', href: '/es/' },
      { label: 'Herramientas', href: '/es/tools/' },
      { label: 'Carga de Microplásticos y Plastificantes' }
    ],
    faqHeading: "Preguntas Frecuentes sobre Microplásticos en la Cocina y Absorción en Sangre",
    faqSub: "Respuestas con base científica y estudios clínicos revisados por pares.",
    faqs: [
      {
        question: "¿Realmente entran en la sangre humana los microplásticos del contacto con alimentos?",
        answer: "Sí. En un estudio clínico histórico de 2022 publicado en Environment International por investigadores de la Universidad Libre de Ámsterdam, se detectaron polímeros plásticos microscópicos en el torrente sanguíneo del 77% de los donantes analizados. Los nanoplásticos submicrónicos atraviesan la barrera epitelial intestinal a través de las células M y transitan directamente a la circulación sanguínea capilar."
      },
      {
        question: "¿Por qué es tan peligroso calentar recipientes plásticos en el microondas aunque indiquen 'Apto para Microondas'?",
        answer: "La indicación 'apto para microondas' solo certifica que el recipiente no se derretirá ni causará chispas; NO significa que sea químicamente inerte. Investigaciones de la Universidad de Nebraska-Lincoln (2023) demostraron que calentar recipientes de polipropileno (PP #5) durante solo 3 minutos libera hasta 4,22 millones de microplásticos y más de 2.100 millones de nanoplásticos por centímetro cuadrado directamente a la comida."
      },
      {
        question: "¿Cuántas partículas de plástico desprenden las tablas de cortar de plástico al año?",
        answer: "Un estudio de 2023 publicado por la American Chemical Society (ACS) cuantificó que las tablas de polipropileno y polietileno desprenden entre 14,5 y 50,4 millones de partículas de microplásticos por persona cada año debido al corte repetido del cuchillo. Cambiar a madera de grano final (arce, acacia o nogal) elimina por completo esta fuente de contaminación."
      },
      {
        question: "¿Por qué los alimentos grasos absorben más ftalatos y plastificantes?",
        answer: "Los ortoftalatos (DEHP, DINP) son moléculas lipofílicas (solubles en grasa). Cuando aceites calientes, quesos o carnes grasas entran en contacto con plásticos flexibles o film transparente, los lípidos actúan como disolventes orgánicos activos, multiplicando la tasa de extracción de plastificantes hasta 100 veces en comparación con el agua pura."
      },
      {
        question: "¿Significa 'Libre de BPA' que un plástico es seguro?",
        answer: "No. La mayoría de los fabricantes reemplazaron el bisfenol A por análogos como el bisfenol S (BPS) y el bisfenol F (BPF), que han demostrado en estudios toxicológicos una actividad estrogénica y disrupción endocrina igual o superior. La única solución definitiva es sustituirlos por vidrio de borosilicato o acero inoxidable quirúrgico 316."
      }
    ]
  },
  pt: {
    pageTitle: "Estimador de Carga Sanguínea de Microplásticos e Plastificantes na Cozinha | IsItKitchenSafe",
    pageDescription: "Quantifique sua exposição alimentar a microplásticos, nanoplásticos, ftalatos e bisfenóis. Calcule partículas semanais, equivalência em cartões de plástico e receba seu plano de des-plastificação.",
    breadcrumbs: [
      { label: 'Início', href: '/pt/' },
      { label: 'Ferramentas', href: '/pt/tools/' },
      { label: 'Carga de Microplásticos e Plastificantes' }
    ],
    faqHeading: "Perguntas Frequentes sobre Microplásticos Culinários e Absorção no Sangue",
    faqSub: "Respostas fundamentadas em publicações médicas e toxicológicas internacionais.",
    faqs: [
      {
        question: "Os microplásticos da cozinha realmente entram na corrente sanguínea humana?",
        answer: "Sim. Um estudo de 2022 publicado na Environment International por pesquisadores da Vrije Universiteit Amsterdam detectou microplásticos poliméricos no sangue de 77% dos doadores saudáveis testados. Nanoplásticos com menos de 1 micrômetro atravessam a barreira epitelial do intestino através das células M nas placas de Peyer, alcançando a circulação sistêmica."
      },
      {
        question: "Por que aquecer recipientes de plástico no micro-ondas é perigoso, mesmo sendo 'próprio para micro-ondas'?",
        answer: "O rótulo 'próprio para micro-ondas' é apenas mecânico: indica que o pote não vai derreter. Não significa que seja inerte. Cientistas da Universidade de Nebraska-Lincoln (2023) comprovaram que 3 minutos no micro-ondas em potes de polipropileno liberam até 4,22 milhões de microplásticos e 2,11 bilhões de nanoplásticos por centímetro quadrado diretamente na comida."
      },
      {
        question: "Quantas partículas são liberadas por tábuas de corte de plástico por ano?",
        answer: "Uma pesquisa da American Chemical Society (ACS, 2023) revelou que o uso diário de tábuas de corte de polietileno ou polipropileno desprende de 14,5 a 50,4 milhões de partículas de microplásticos por ano diretamente nos alimentos picados. Tábuas de madeira natural eliminam esse risco."
      },
      {
        question: "Por que alimentos gordurosos atraem mais plastificantes tóxicos?",
        answer: "Ftalatos como DEHP e DINP são moléculas lipofílicas (lipossolúveis). Em contato com molhos quentes, carnes, azeites e queijos, os lipídios funcionam como solvente ativo, extraindo plastificantes da matriz plástica em taxas até 100 vezes mais rápidas do que a água."
      },
      {
        question: "'Livre de BPA' significa que o plástico é 100% seguro?",
        answer: "Não. A indústria substituiu o BPA por análogos químicos como o BPS e o BPF, que apresentam atividade estrogênica e efeitos de disrupção endócrina idênticos ou mais graves. A troca definitiva recomendada é por vidro borossilicato ou aço inoxidável cirúrgico 316."
      }
    ]
  },
  'zh-cn': {
    pageTitle: "家庭食品接触塑料增塑剂与微塑料血液负担评估计算器 | IsItKitchenSafe",
    pageDescription: "量化厨房饮食接触微塑料、纳米塑料、邻苯二甲酸酯及双酚类似物的健康风险。测算每周摄入颗粒数、年相当于吃掉的塑料卡片重量，生成科学去塑化升级方案。",
    breadcrumbs: [
      { label: '首页', href: '/zh-cn/' },
      { label: '实用工具', href: '/zh-cn/tools/' },
      { label: '微塑料与增塑剂血液负担测评' }
    ],
    faqHeading: "厨房微塑料饮食摄入与血液渗透常见科学解答",
    faqSub: "严谨奠基于全球权威医学期刊与毒理学实验实测数据。",
    faqs: [
      {
        question: "食品接触塑料中的微塑料真的会进入人体血液吗？",
        answer: "完全属实。阿姆斯特丹自由大学研究团队于2022年在权威期刊《国际环境》（Environment International）发表的临床研究证实，在77%的健康人类受试者血液样本中检测出了微塑料聚合物（PET、PE及聚苯乙烯）。亚微米级纳米塑料能够轻易通过肠道上皮微褶皱细胞（M细胞）穿透生物屏障进入毛细血管与全身循环。"
      },
      {
        question: "为什么标有“微波炉安全（Microwave Safe）”的塑料容器依然危险？",
        answer: "“微波安全”仅仅是一项工业物理标准，表明该容器在微波加热时不会发生变形、融化或起火，并不代表它具备化学惰性。内布拉斯加大学林肯分校2023年研究发现，使用聚丙烯（PP #5）容器仅微波加热3分钟，每平方厘米表面就会向食物释放高达422万个微塑料和21.1亿个纳米塑料颗粒。"
      },
      {
        question: "塑料砧板每年会剥落多少微塑料碎片？",
        answer: "美国化学学会（ACS）2023年发表的专门研究测定，日常在聚丙烯或聚乙烯塑料砧板上切菜，每年每人随餐摄入的微塑料微屑在1450万至5040万颗之间。刀具在塑料表面切割产生的微小划痕不仅释放大量微屑，还极易滋生细菌。换用天然硬木端面砧板可彻底根除塑料微屑。"
      },
      {
        question: "为什么高油多脂食物会从塑料中萃取更多增塑剂？",
        answer: "邻苯二甲酸酯类增塑剂（如DEHP、DINP）与塑料树脂之间并未形成共价化学键，且具有极高的脂溶性（亲脂性）。当热油、肉类、奶酪或油脂酱汁接触保鲜膜与塑料餐盒时，油脂充当了活性有机萃取溶剂，导致增塑剂向食物迁移的速度比纯水高出数十至上百倍。"
      },
      {
        question: "标识“BPA-Free（不含双酚A）”的塑料产品是否真的无毒安全？",
        answer: "并非如此。许多塑料制造商用双酚S（BPS）和双酚F（BPF）等结构类似物替代了BPA。同行评议毒理学测试证实，BPS和BPF展现出同等甚至更强的雌激素受体活性与内分泌干扰效应。唯一彻底安全的选择是替换为高硼硅玻璃或316医用不锈钢。"
      }
    ]
  },
  ja: {
    pageTitle: "食品接触プラスチック可塑剤・血中マイクロプラスチック蓄積リスク試算ツール | IsItKitchenSafe",
    pageDescription: "食品から体内へ侵入するマイクロプラスチック、フタル酸エステル、ビスフェノール暴露量を数値化。週間摂取粒子数、年間カード換算量、脱プラスチック改善計画を提供します。",
    breadcrumbs: [
      { label: 'ホーム', href: '/ja/' },
      { label: 'ツール一覧', href: '/ja/tools/' },
      { label: 'マイクロプラスチック血中蓄積試算' }
    ],
    faqHeading: "キッチンプラスチック粒子および体内移行に関するよくある質問",
    faqSub: "国際的な医学雑誌および環境毒性学の査読論文に基づき解説。",
    faqs: [
      {
        question: "食器や調理器具からのマイクロプラスチックは本当に血液中に入り込みますか？",
        answer: "はい。2022年にアムステルダム自由大学の研究チームが科学誌『Environment International』に発表した臨床調査では、健康なヒト血液ドナーの77%からPET、ポリエチレン、スチレンなどのプラスチックポリマー粒子が検出されました。1マイクロメートル未満の微小ナノプラスチックは腸管上皮のM細胞を通じて直接血流へ吸収され、全身へ循環します。"
      },
      {
        question: "「電子レンジ対応」と記載されたタッパーでも加熱すると危険なのはなぜですか？",
        answer: "「電子レンジ対応」という表示は、容器自体が変形したり発火したりしないという物理的耐熱テストを通過したことを示すだけであり、化学的に不活性であることを意味しません。ネブラスカ大学リンカーン校の2023年の実測研究では、ポリプロピレン（PP #5）容器をわずか3分間温めるだけで、1平方センチメートルあたり最大422万個のマイクロプラスチックと21億個以上のナノプラスチックが食品中に溶出することが判明しています。"
      },
      {
        question: "プラスチック製のまな板から1年間にどれくらいの微小破片が発生しますか？",
        answer: "米国化学会（ACS）の2023年の論文によると、ポリエチレンやポリプロピレンのまな板で日常的に調理を行うと、包丁の刃によって削り取られた微小破片が年間1人あたり1,450万〜5,040万個も食材に付着して体内に摂取されます。天然無垢材のまな板に切り替えることで、この摂取源を完全に遮断できます。"
      },
      {
        question: "油分の多い温かい料理ほど可塑剤（フタル酸エステル）が多く溶出するのはなぜですか？",
        answer: "プラスチックを柔らかく保つフタル酸エステル（DEHP、DINPなど）は親油性（油に溶けやすい性質）を持っています。熱い揚げ物、カレー、チーズ、肉料理などがラップやプラスチック容器に触れると、油脂が有機溶媒として作用し、水に比べて最大100倍の速度で可塑剤が食品へ移行します。"
      },
      {
        question: "「BPAフリー」と書かれたプラスチック容器なら安全ですか？",
        answer: "いいえ。多くのメーカーはBPAの代わりに構造が酷似したビスフェノールS（BPS）やビスフェノールF（BPF）を使用しています。毒性学の検証により、これら代替物質もBPAと同等以上の女性ホルモン攪乱作用（内分泌攪乱）を持つことが確認されています。完全な安全性にはホウケイ酸耐熱ガラスや316ステンレスへの素材転換が必要です。"
      }
    ]
  }
};

const c = CONTENT[lang];
const pageTitle = c.pageTitle;
const pageDescription = c.pageDescription;

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": c.pageTitle,
  "url": `https://isitkitchensafe.com/${lang}/tools/plasticizer-microplastic-burden-estimator/`,
  "applicationCategory": "HealthApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "description": c.pageDescription,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};
---

<Layout title={pageTitle} description={pageDescription} faqs={c.faqs} availableLocales={availableLocales}>
  <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />

  <main class="container mx-auto px-4 py-8 max-w-5xl space-y-8">
    <Breadcrumbs items={c.breadcrumbs} />

    <PlasticizerBurdenEstimator lang={lang} />

    <!-- FAQ Accordion / Grid Section -->
    <section class="mt-16 bg-surface-soft border border-hairline rounded-3xl p-6 md:p-10 space-y-6">
      <div class="border-b border-hairline pb-4">
        <span class="text-xs font-bold uppercase tracking-wider text-purple-700 block mb-1">
          {c.faqHeading}
        </span>
        <p class="text-xs text-muted">{c.faqSub}</p>
      </div>

      <div class="space-y-4">
        {c.faqs.map(faq => (
          <details class="group p-4 rounded-xl bg-canvas border border-hairline transition-colors open:bg-surface">
            <summary class="font-medium text-ink cursor-pointer list-none flex items-center justify-between text-sm md:text-base">
              <span>{faq.question}</span>
              <span class="text-muted transition-transform group-open:rotate-180 ml-2">&darr;</span>
            </summary>
            <p class="text-xs md:text-sm text-body mt-3 pt-3 border-t border-hairline/60 leading-relaxed">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </main>
</Layout>
