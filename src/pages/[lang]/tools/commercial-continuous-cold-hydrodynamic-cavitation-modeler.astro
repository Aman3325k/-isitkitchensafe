      },
      {
        question: "CHCはどのようにして乳製品や植物性ミルクのエマルション粒子径を200 nm未満のナノサイズまで均質化しますか？",
        answer: "従来の高圧ホモジナイザー（HPH）は1,000〜2,000 barの超高圧と膨大な動力を消費し、摩擦による品温上昇を引き起こします。一方CHCは15〜80 barの適度な供給圧でありながら、極めて高い乱流剪断ひずみ速度（γ̇ > 10⁵ s⁻¹）とキャビテーションマイクロジェットにより、乳脂肪球や不溶性食物繊維を体積平均径（D_4,3）120〜180 nmまで微細化します。これにより牛乳の脂肪分離を完全に防ぎ、オーツミルク等の植物性飲料に添加物なしで極めて安定したマイクロフォーム性を付与します。"
      },
      {
        question: "従来の加熱殺菌（パストリゼーション）と比較して、CHCがビタミンやタンパク質の95%以上を保持できるのはなぜですか？",
        answer: "一般的なHTST殺菌（72〜85°C、15〜30秒）は熱変性により免疫グロブリンやラクトフェリンを失活させ、柑橘果汁中のビタミンCを25〜40%熱分解させ、焦げ風味を生じさせます。一方CHCは流体全体の平均温度上昇がわずか2〜6°Cに留まる断熱プロセスです。極限的な衝撃エネルギーはピコ秒単位の気泡圧壊微小領域に局所集中するため、バルク流体は冷態に保たれ、柑橘の天然ペクチン混濁成分やフレッシュな香気テルペンが損なわれずにそのまま保たれます。"
      },
      {
        question: "商業CHCプラントに求められる3-AおよびEHEDGサニタリー設計規格とはどのようなものですか？",
        answer: "食品製造ライン向けのCHC装置は3-A Sanitary Standards 04-05およびEHEDG Doc 8 & 17に準拠する必要があります。(1) 接液部はすべてRa < 0.4 µmの電解研磨316Lステンレス鋼製であること、(2) CIP流速1.8 m/s以上を確保するデッドレグ（滞留部）ゼロ構造であること、(3) シール材はFDA 21 CFR § 177.2600適合EPDM等を使用すること、(4) キャビテーション衝撃部にタングステンカーバイド等の交換可能耐摩耗ライナーを配置し金属ピッティングを防ぐこと、(5) ASME B31.3に基づく水撃防止閉ループ背圧制御弁を装備することが義務付けられています。"
      }
    ]
  }
};

const content = CONTENT[lang as Exclude<SupportedLanguage, 'en'>];

const pageTitle = content.pageTitle;
const pageDescription = content.pageDescription;

const breadcrumbs = [
  { label: t('nav.home'), href: tp('/') },
  { label: t('nav.tools'), href: tp('/tools/') },
  { label: content.breadcrumbsLabel }
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": `https://isitkitchensafe.com/${lang}/tools/commercial-continuous-cold-hydrodynamic-cavitation-modeler/#webapp`,
      "url": `https://isitkitchensafe.com/${lang}/tools/commercial-continuous-cold-hydrodynamic-cavitation-modeler/`,
      "name": content.h1,
      "applicationCategory": "EngineeringApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5 Canvas/CSS3.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": pageDescription
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": t('nav.home'),
          "item": `https://isitkitchensafe.com${tp('/')}`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": t('nav.tools'),
          "item": `https://isitkitchensafe.com${tp('/tools/')}`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": content.breadcrumbsLabel,
          "item": `https://isitkitchensafe.com/${lang}/tools/commercial-continuous-cold-hydrodynamic-cavitation-modeler/`
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": content.faqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <Breadcrumbs items={breadcrumbs} />

    <div class="mt-6">
      <CommercialColdHydrodynamicCavitationModeler lang={lang} />
    </div>

    <!-- Supplementary Scientific FAQs Section -->
    <section class="mt-16 border-t border-hairline pt-12">
      <div class="max-w-3xl mb-8">
        <h2 class="text-2xl font-bold text-ink tracking-tight">
          {content.badge} — FAQs
        </h2>
        <p class="text-body text-sm mt-2">
          {content.lead}
        </p>
      </div>

      <div class="space-y-6">
        {content.faqs.map(faq => (
          <div class="bg-surface-soft border border-hairline rounded-2xl p-6">
            <h3 class="text-base font-bold text-ink mb-2">
              {faq.question}
            </h3>
            <p class="text-body text-sm leading-relaxed">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </section>
  </main>
</Layout>