    internalTempTag: "USDA 加熱基準",
    internalTempTitle: "安全中心加熱温度＆余熱静置チャート →",
    internalTempDesc: "鶏肉、牛肉、豚肉、魚介類の食中毒を防ぐ安全な中心温度と余熱時間を即座に確認。",
    faqTitle: "よくある質問：洗剤の化学的安全性と応急手当",
    faqs: [
      {
        question: "キッチンで漂白剤とお酢を混ぜるとなぜ命に関わるのですか？",
        answer: "塩素系漂白剤（次亜塩素酸ナトリウム）とお酢（酢酸）が混ざると、強烈な刺激臭を持つ有毒な塩素ガスが発生します。肺の水分と反応して塩酸を生成し、肺胞組織を急速に破壊して呼吸不全や急性肺水腫を引き起こします。"
      },
      {
        question: "漂白剤とアンモニアを混ぜるとどんな気体が発生しますか？",
        answer: "猛毒のクロラミンガス（モノクロラミン、ジクロラミン）が発生します。気道を激しく火傷させ、数時間後に重篤な化学肺炎を発症する危険があります。"
      },
      {
        question: "重曹とお酢を混ぜると汚れ落ちがパワーアップするというのは本当？",
        answer: "誤解です。派手な泡立ちは単なる炭酸ガス（CO2）の発生であり、アルカリの重曹と酸のお酢が互いに中和し合って洗浄力を打ち消し合っています。反応後は無力な酢酸ナトリウム水溶液になるため別々に使う方が圧倒的に効果的です。"
      },
      {
        question: "誤って洗剤を混ぜて異臭がした場合、まず何をすべきですか？",
        answer: "1) 直ちに息を止めてその場から逃げてください。2) ドアを閉めてガスを閉じ込めます。3) 外気のある屋外へ移動して新鮮な空気を深く吸います。4) 他の洗剤をかけて中和しようと絶対にしないでください。5) 咳や息苦しさが続く場合は速やかに119番通報して医師の診察を受けてください。"
      },
      {
        question: "パイプクリーナーに酸性洗剤やお湯を混ぜてはいけない理由は？",
        answer: "高濃度の苛性ソーダが激しい発熱を伴うためです。酸性洗剤やお湯を加えると瞬時に突沸（爆発的沸騰）が起き、高温の腐食性液体が排水口から噴水の如く吹き上がり、失明や重度の化学熱傷を負う重大事故になります。"
      }
    ],
    homeLabel: "ホーム",
    toolsLabel: "ツール一覧",
    toolShortLabel: "洗剤の混ぜるな危険チェッカー"
  }
};

const c = CONTENT[lang as Exclude<SupportedLanguage, 'en'>];

const breadcrumbs = [
  { label: c.homeLabel, href: `/${lang}/` },
  { label: c.toolsLabel, href: getDirectoryUrl('tools', lang) },
  { label: c.toolShortLabel }
];

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": c.h1,
  "url": `https://isitkitchensafe.com/${lang}/tools/cleaner-mixing-danger-checker/`,
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript.",
  "description": c.pageDescription,
  "inLanguage": lang,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": c.faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={c.pageTitle}
  description={c.pageDescription}
  breadcrumbs={breadcrumbs}
  faqs={c.faqs}
  excludeFaqSchema={true}
  availableLocales={availableLocales}
>
  <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={breadcrumbs} className="mb-0" />
    </div>
  </div>

  <main class="max-w-[1280px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="max-w-[880px] mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-rose-700 text-white mb-3">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <span>{c.badge}</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-heading tracking-tight mb-4">
        {c.h1}
      </h1>
      <p class="text-base sm:text-lg text-body-secondary leading-relaxed">
        {c.heroSub}
      </p>
    </header>

    <!-- Interactive Component -->
    <section class="mb-14">
      <CleanerMixingDangerChecker lang={lang} />
    </section>

    <!-- Critical Chemical Safety Rules & E-E-A-T Guide -->
    <section class="mt-14 border-t border-hairline pt-12">
      <div class="max-w-[960px] mx-auto">
        <h2 class="text-2xl sm:text-3xl font-bold text-heading tracking-tight mb-4">
          {c.alertsTitle}
        </h2>
        <p class="text-base text-body-secondary mb-8">
          {c.alertsSub}
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
          {c.alerts.map((alert) => (
            <div class="p-6 rounded-2xl bg-danger-soft border border-danger-hairline">
              <div class="flex items-start gap-3">
                <span class="text-2xl" aria-hidden="true">{alert.icon}</span>
                <div>
                  <h3 class="font-bold text-red-900 dark:text-red-300 text-lg mb-1">
                    {alert.title}
                  </h3>
                  <p class="text-sm text-red-800 dark:text-red-200 leading-relaxed">
                    {alert.desc}
                  </p>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- FAQ Section -->
        <div class="mt-12">
          <h2 class="text-2xl sm:text-3xl font-bold text-heading tracking-tight mb-6">
            {c.faqTitle}
          </h2>
          <div class="space-y-4">
            {c.faqs.map((faq) => (
              <details class="group p-5 rounded-xl border border-hairline bg-surface-soft open:bg-surface-elevated transition-colors">
                <summary class="font-bold text-heading cursor-pointer list-none flex items-center justify-between gap-4">
                  <span>{faq.question}</span>
                  <span class="text-signature-teal group-open:rotate-180 transition-transform text-lg leading-none" aria-hidden="true">▾</span>
                </summary>
                <p class="mt-3 text-sm text-body-secondary leading-relaxed border-t border-hairline pt-3">
                  {faq.answer}
                </p>
              </details>
            ))}
          </div>
        </div>

        <!-- Related Consumer Tools -->
        <div class="mt-12 pt-8 border-t border-hairline">
          <h3 class="text-lg font-bold text-heading mb-4">{c.relatedTitle}</h3>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <a href={`/${lang}/tools/appliance-descaling-calculator/`} class="p-4 rounded-xl border border-hairline bg-surface-soft hover:border-signature-teal transition-all group">
              <span class="text-xs font-semibold text-signature-teal block mb-1">{c.descalingTag}</span>
              <span class="font-bold text-heading text-sm group-hover:text-signature-teal block">{c.descalingTitle}</span>
              <p class="text-xs text-body-secondary mt-1">{c.descalingDesc}</p>
            </a>
            <a href={`/${lang}/tools/kitchen-symbol-decoder/`} class="p-4 rounded-xl border border-hairline bg-surface-soft hover:border-signature-teal transition-all group">
              <span class="text-xs font-semibold text-signature-teal block mb-1">{c.symbolsTag}</span>
              <span class="font-bold text-heading text-sm group-hover:text-signature-teal block">{c.symbolsTitle}</span>
              <p class="text-xs text-body-secondary mt-1">{c.symbolsDesc}</p>
            </a>
            <a href={`/${lang}/tools/internal-cooking-temp-chart/`} class="p-4 rounded-xl border border-hairline bg-surface-soft hover:border-signature-teal transition-all group">
              <span class="text-xs font-semibold text-signature-teal block mb-1">{c.internalTempTag}</span>
              <span class="font-bold text-heading text-sm group-hover:text-signature-teal block">{c.internalTempTitle}</span>
              <p class="text-xs text-body-secondary mt-1">{c.internalTempDesc}</p>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
