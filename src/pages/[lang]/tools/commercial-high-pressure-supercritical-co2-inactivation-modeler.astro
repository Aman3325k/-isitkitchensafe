      },
      {
        question: "超高圧 scCO2 設備において、疲労破壊や爆発的減圧 (RGD) を防ぐための安全基準は？",
        answer: "商業用連続 scCO2 装置は、ASME 圧力容器基準第 VIII 卷第 2 分冊 (高圧容器代替規則) に準拠して設計されます。配管および耐圧カラムには、500 bar の交変応力に耐え炭酸腐食を防ぐため自緊処理 (Autofrettage) を施した鍛造 2205 二相ステンレス鋼やハステロイ C-276 が採用されます。また、減圧時にエラストマー内部に溶解した CO2 が急膨張して破裂する急速ガス減圧破壊 (RGD: Rapid Gas Decompression) を防止するため、スプリング強化バージン PEEK、Kel-F、または特殊パーフロロエラストマー (Kalrez 6230) 製の高圧シールが必須となります。"
      },
      {
        question: "連続 scCO2 殺菌と従来の超高圧加工 (HPP) や UHT 超高温加熱殺菌との違いは？",
        answer: "従来の UHT 殺菌 (121°C) はビタミンの熱分解、液全卵の熱凝固、およびフルーツピューレの焦げ臭を伴います。一方、従来の冷水超高圧加工 (HPP: 600 MPa) は栄養体細菌に有効ですが、細菌芽胞は熱なしでは 800 MPa の高水圧でも生残します。対照的に連続 scCO2 は、溶媒作用と細胞内酸性化の相乗効果により、大幅に低い圧力 (150〜450 bar) かつ温和な温度 (40〜50°C) で芽胞を完全死滅させます。さらに連続流プロセスであるため、天然ビタミンや香気成分の 95% 以上が非加熱のまま保持されます。"
      }
    ]
  }
};

const c = CONTENT[lang];

const breadcrumbs = [
  { label: t('nav.home') || 'Home', href: `/${lang}/` },
  { label: t('nav.tools') || 'Tools', href: `/${lang}/tools/` },
  { label: c.breadcrumbsLabel }
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": `https://isitkitchensafe.com/${lang}/tools/commercial-high-pressure-supercritical-co2-inactivation-modeler/#webapp`,
      "url": `https://isitkitchensafe.com/${lang}/tools/commercial-high-pressure-supercritical-co2-inactivation-modeler/`,
      "name": c.h1,
      "applicationCategory": "EngineeringApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5 Canvas/CSS3.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": c.pageDescription
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": t('nav.home') || 'Home',
          "item": `https://isitkitchensafe.com/${lang}/`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": t('nav.tools') || 'Tools',
          "item": `https://isitkitchensafe.com/${lang}/tools/`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": c.breadcrumbsLabel,
          "item": `https://isitkitchensafe.com/${lang}/tools/commercial-high-pressure-supercritical-co2-inactivation-modeler/`
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": c.faqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
};
---

<Layout title={c.pageTitle} description={c.pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <Breadcrumbs items={breadcrumbs} />

    <div class="mt-6">
      <CommercialSupercriticalCo2InactivationModeler lang={lang} />
    </div>

    <!-- FAQ Section -->
    <section class="mt-16 border-t border-hairline pt-12">
      <div class="max-w-3xl">
        <h2 class="text-title-lg font-bold text-ink tracking-tight mb-2">
          {lang === 'es' ? 'Preguntas Frecuentes' : lang === 'pt' ? 'Perguntas Frequentes' : lang === 'zh-cn' ? '常见问题与专家技术解答' : 'よくある質問 (FAQ)'}
        </h2>
        <p class="text-body-sm text-muted mb-8">
          {c.lead}
        </p>

        <div class="space-y-6">
          {c.faqs.map(faq => (
            <div class="bg-surface-soft border border-hairline rounded-2xl p-6">
              <h3 class="text-body-base font-semibold text-ink mb-2">
                {faq.question}
              </h3>
              <p class="text-body-sm text-muted leading-relaxed">
                {faq.answer}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>
