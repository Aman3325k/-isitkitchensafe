    box4Text: "ボウル直上にある減速機や軸受には、FDA 21 CFR § 178.3570適合のNSF H1登録合成グリースを使用し、重金属混入を防止しなければなりません。"
  }
};

const c = CONTENT[lang];

const breadcrumbs = [
  { label: t('nav.home'), href: tp('/') },
  { label: t('nav.tools'), href: tp('/tools/') },
  { label: c.breadcrumbsLabel }
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": c.h1,
      "url": `https://isitkitchensafe.com/${lang}/tools/commercial-spiral-mixer-shear-overheat-modeler/`,
      "applicationCategory": "EngineeringApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5 Canvas/CSS3.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": c.pageDescription
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": t('nav.home'),
          "item": `https://isitkitchensafe.com${tp('/')}`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": t('nav.tools'),
          "item": `https://isitkitchensafe.com${tp('/tools/')}`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": c.breadcrumbsLabel,
          "item": `https://isitkitchensafe.com/${lang}/tools/commercial-spiral-mixer-shear-overheat-modeler/`
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": c.faqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
};
---

<Layout title={c.pageTitle} description={c.pageDescription} structuredData={structuredData} lang={lang} availableLocales={availableLocales}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
    <Breadcrumbs items={breadcrumbs} />

    <!-- Hero Header -->
    <header class="my-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-600 text-white mb-3">
        {c.badge}
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-ink tracking-tight mb-4">
        {c.h1}
      </h1>
      <p class="text-base sm:text-lg text-muted max-w-4xl leading-relaxed">
        {c.lead}
      </p>
    </header>

    <!-- Interactive Diagnostic Tool Component -->
    <CommercialSpiralMixerShearOverheatModeler lang={lang} />

    <!-- Scientific Engineering Deep-Dive Content -->
    <article class="prose prose-slate max-w-none mt-12 pt-10 border-t border-hairline">
      <h2 class="text-2xl font-bold text-ink tracking-tight mb-4">
        {c.scienceTitle1}
      </h2>
      <p class="text-sm leading-relaxed text-muted mb-6">
        {c.scienceText1}
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-8 not-prose">
        <div class="p-6 rounded-2xl bg-surface-soft border border-hairline">
          <h3 class="text-base font-bold text-ink mb-2">{c.box1Title}</h3>
          <p class="text-xs text-muted leading-relaxed">{c.box1Text}</p>
        </div>

        <div class="p-6 rounded-2xl bg-surface-soft border border-hairline">
          <h3 class="text-base font-bold text-ink mb-2">{c.box2Title}</h3>
          <p class="text-xs text-muted leading-relaxed">{c.box2Text}</p>
        </div>
      </div>

      <h2 class="text-2xl font-bold text-ink tracking-tight mb-4">
        {c.scienceTitle2}
      </h2>
      <p class="text-sm leading-relaxed text-muted mb-6">
        {c.scienceText2}
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-8 not-prose">
        <div class="p-6 rounded-2xl bg-surface-soft border border-hairline">
          <h3 class="text-base font-bold text-ink mb-2">{c.box3Title}</h3>
          <p class="text-xs text-muted leading-relaxed">{c.box3Text}</p>
        </div>

        <div class="p-6 rounded-2xl bg-surface-soft border border-hairline">
          <h3 class="text-base font-bold text-ink mb-2">{c.box4Title}</h3>
          <p class="text-xs text-muted leading-relaxed">{c.box4Text}</p>
        </div>
      </div>
    </article>

    <!-- Frequently Asked Questions Section -->
    <section class="mt-12 pt-10 border-t border-hairline">
      <h2 class="text-2xl font-bold text-ink tracking-tight mb-6">
        {lang === 'es' ? 'Preguntas Frecuentes: Ingeniería de Amasadoras y Seguridad' :
         lang === 'pt' ? 'Perguntas Frequentes: Engenharia de Amassadeiras e Segurança' :
         lang === 'zh-cn' ? '常见问题解答：和面机工程学与食品安全' :
         'よくある質問：スパイラルミキサー機械工学と食品安全'}
      </h2>
      <div class="space-y-4">
        {c.faqs.map(faq => (
          <details class="group p-5 rounded-2xl bg-surface-soft border border-hairline transition-all">
            <summary class="font-bold text-sm sm:text-base text-ink cursor-pointer list-none flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <svg class="w-5 h-5 shrink-0 text-muted transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <p class="text-xs sm:text-sm text-muted leading-relaxed mt-4 pt-3 border-t border-hairline/60">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>

    <!-- Related Diagnostic Tools Navigation -->
    <nav class="mt-12 pt-8 border-t border-hairline">
      <h3 class="text-sm font-bold uppercase tracking-wider text-muted mb-4">
        {lang === 'es' ? 'Herramientas Comerciales Relacionadas' :
         lang === 'pt' ? 'Ferramentas Comerciais Relacionadas' :
         lang === 'zh-cn' ? '相关商用食品安全与机械诊断工具' :
         '関連する業務用食品安全・機械診断ツール'}
