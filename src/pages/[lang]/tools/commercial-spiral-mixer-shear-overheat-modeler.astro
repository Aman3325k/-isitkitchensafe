      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <a href={`/${lang}/tools/commercial-tortilla-press-hydraulic-modeler/`} class="p-4 rounded-xl bg-surface border border-hairline hover:border-amber-500 transition-colors">
          <span class="text-xs font-bold text-ink block mb-1">
            {lang === 'es' ? 'Prensas de Tortillas Hidráulicas &rarr;' :
             lang === 'pt' ? 'Prensas de Tortilhas Hidráulicas &rarr;' :
             lang === 'zh-cn' ? '压饼机液压破裂模拟器 &rarr;' :
             'トルティーヤプレス油圧シミュレーター &rarr;'}
          </span>
          <span class="text-[11px] text-muted">
            {lang === 'es' ? 'Degradación térmica de sellos a 230°C y cono de fuego súbito.' :
             lang === 'pt' ? 'Degradação de retentores a 230°C e deflagração de aerossol.' :
             lang === 'zh-cn' ? '230°C热盘密封圈老化与2,500 PSI管路爆裂油雾闪燃。' :
             '230°C熱盤シリンダーシール劣化および油霧フラッシュ火災。'}
          </span>
        </a>
        <a href={`/${lang}/tools/commercial-conveyor-dishwasher-water-hammer-modeler/`} class="p-4 rounded-xl bg-surface border border-hairline hover:border-amber-500 transition-colors">
          <span class="text-xs font-bold text-ink block mb-1">
            {lang === 'es' ? 'Golpe de Ariete en Lavavajillas &rarr;' :
             lang === 'pt' ? 'Golpe de Aríete em Lavadoras &rarr;' :
             lang === 'zh-cn' ? '商用洗碗机水锤冲击波模拟器 &rarr;' :
             '食洗機水撃シミュレーター &rarr;'}
          </span>
          <span class="text-[11px] text-muted">
            {lang === 'es' ? 'Transitorios Joukowsky y amortiguadores ASME A112.26.1.' :
             lang === 'pt' ? 'Transientes Joukowsky e amortecedores ASME A112.26.1.' :
             lang === 'zh-cn' ? '茹科夫斯基水锤超压冲击与ASME水击防止器选型。' :
             'ジュコフスキー水撃衝撃波とASME水撃防止器選定。'}
          </span>
        </a>
        <a href={`/${lang}/tools/commercial-steam-table-spore-modeler/`} class="p-4 rounded-xl bg-surface border border-hairline hover:border-amber-500 transition-colors">
          <span class="text-xs font-bold text-ink block mb-1">
            {lang === 'es' ? 'Simulador de Esporas en Baño María &rarr;' :
             lang === 'pt' ? 'Simulador de Esporos em Banho-Maria &rarr;' :
             lang === 'zh-cn' ? '商用保温蒸汽台芽孢动力学模拟器 &rarr;' :
             '業務用蒸気保温台セレウス菌シミュレーター &rarr;'}
          </span>
          <span class="text-[11px] text-muted">
            {lang === 'es' ? 'Cinética de germinación de Bacillus cereus a 57°C.' :
             lang === 'pt' ? 'Cinética de germinação de Bacillus cereus a 57°C.' :
             lang === 'zh-cn' ? '57°C临界温区蜡样芽孢杆菌萌发动力学与毒素产生。' :
             '57°C臨界温度帯におけるセレウス菌芽胞発芽動態解析。'}
          </span>
        </a>
      </div>
    </nav>
  </div>
</Layout>
