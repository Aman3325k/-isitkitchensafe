const c = LOCALE_CONTENT[lang] || LOCALE_CONTENT.es;

const breadcrumbs = [
  { label: t('nav.home'), href: tp('/') },
  { label: t('nav.tools') || 'Tools', href: tp('/tools/') },
  { label: c.breadcrumbsLabel }
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": c.h1,
      "url": `https://isitkitchensafe.com/${lang}/tools/commercial-conveyor-broiler-catalytic-modeler/`,
      "applicationCategory": "EngineeringApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5 Canvas/CSS3.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": c.pageDescription
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": t('nav.home'),
          "item": `https://isitkitchensafe.com/${lang}/`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": t('nav.tools') || 'Tools',
          "item": `https://isitkitchensafe.com/${lang}/tools/`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": c.breadcrumbsLabel,
          "item": `https://isitkitchensafe.com/${lang}/tools/commercial-conveyor-broiler-catalytic-modeler/`
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": c.faqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
};
---

<Layout 
  title={c.pageTitle}
  description={c.pageDescription}
  schema={structuredData}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
    <!-- Breadcrumbs -->
    <Breadcrumbs items={breadcrumbs} />

    <!-- Page Header -->
    <header class="my-8">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-rose-900/10 text-rose-700 dark:text-rose-400 border border-rose-500/20 mb-3">
        {c.badge}
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-ink tracking-tight mb-4 leading-tight">
        {c.h1}
      </h1>
      <p class="text-base sm:text-lg text-muted max-w-3xl leading-relaxed">
        {c.lead}
      </p>
    </header>

    <!-- Flagship Interactive Modeler Component -->
    <CommercialConveyorBroilerCatalyticModeler lang={lang} />

    <!-- Scientific Deep-Dive Analysis -->
    <section class="prose max-w-none text-ink border-t border-hairline/60 pt-12 mt-12 space-y-12">
      <!-- Section 1 -->
      <article>
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-4">
          {c.scienceTitle1}
        </h2>
        <p class="text-sm md:text-base leading-relaxed text-muted mb-4">
          {c.scienceText1}
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 my-6">
          <div class="bg-surface-soft border border-hairline rounded-2xl p-5">
            <h3 class="text-base font-bold text-ink mb-2">{c.box1Title}</h3>
            <p class="text-xs md:text-sm text-muted leading-relaxed">{c.box1Text}</p>
          </div>
          <div class="bg-surface-soft border border-hairline rounded-2xl p-5">
            <h3 class="text-base font-bold text-ink mb-2">{c.box2Title}</h3>
            <p class="text-xs md:text-sm text-muted leading-relaxed">{c.box2Text}</p>
          </div>
        </div>
      </article>

      <!-- Section 2 -->
      <article>
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-4">
          {c.scienceTitle2}
        </h2>
        <p class="text-sm md:text-base leading-relaxed text-muted mb-4">
          {c.scienceText2}
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 my-6">
          <div class="bg-surface-soft border border-hairline rounded-2xl p-5">
            <h3 class="text-base font-bold text-ink mb-2">{c.box3Title}</h3>
            <p class="text-xs md:text-sm text-muted leading-relaxed">{c.box3Text}</p>
          </div>
          <div class="bg-surface-soft border border-hairline rounded-2xl p-5">
            <h3 class="text-base font-bold text-ink mb-2">{c.box4Title}</h3>
            <p class="text-xs md:text-sm text-muted leading-relaxed">{c.box4Text}</p>
          </div>
        </div>
      </article>

      <!-- Section 3 -->
      <article>
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-4">
          {c.scienceTitle3}
        </h2>
        <p class="text-sm md:text-base leading-relaxed text-muted mb-4">
          {c.scienceText3}
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 my-6">
          <div class="bg-surface-soft border border-hairline rounded-2xl p-5">
            <h3 class="text-base font-bold text-ink mb-2">{c.box5Title}</h3>
            <p class="text-xs md:text-sm text-muted leading-relaxed">{c.box5Text}</p>
          </div>
          <div class="bg-surface-soft border border-hairline rounded-2xl p-5">
            <h3 class="text-base font-bold text-ink mb-2">{c.box6Title}</h3>
            <p class="text-xs md:text-sm text-muted leading-relaxed">{c.box6Text}</p>
          </div>
        </div>
      </article>

      <!-- Section 4 -->
      <article>
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-4">
          {c.scienceTitle4}
        </h2>
        <p class="text-sm md:text-base leading-relaxed text-muted mb-4">
          {c.scienceText4}
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 my-6">
          <div class="bg-surface-soft border border-hairline rounded-2xl p-5">
            <h3 class="text-base font-bold text-ink mb-2">{c.box7Title}</h3>
            <p class="text-xs md:text-sm text-muted leading-relaxed">{c.box7Text}</p>
          </div>
          <div class="bg-surface-soft border border-hairline rounded-2xl p-5">
            <h3 class="text-base font-bold text-ink mb-2">{c.box8Title}</h3>
            <p class="text-xs md:text-sm text-muted leading-relaxed">{c.box8Text}</p>
          </div>
        </div>
      </article>
    </section>

    <!-- FAQ Accordion Section -->
    <section class="mt-16 border-t border-hairline/60 pt-12">
      <h2 class="text-2xl sm:text-3xl font-bold text-ink tracking-tight mb-6">
        FAQ
      </h2>
      <div class="space-y-4">
        {c.faqs.map(faq => (
          <details class="group bg-surface-soft border border-hairline rounded-2xl p-5 transition-all">
            <summary class="text-base font-bold text-ink cursor-pointer list-none flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="text-muted group-open:rotate-180 transition-transform">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="6 9 12 15 18 9" />
                </svg>
              </span>
            </summary>
            <p class="text-sm text-muted leading-relaxed mt-3 pt-3 border-t border-hairline/40">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </div>
</Layout>
