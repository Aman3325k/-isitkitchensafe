        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": c.pageDescription
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": t('nav.home'),
          "item": `https://isitkitchensafe.com${tp('/')}`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": t('nav.tools') || 'Tools',
          "item": `https://isitkitchensafe.com${tp('/tools/')}`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": c.breadcrumbsLabel,
          "item": `https://isitkitchensafe.com/${lang}/tools/commercial-hpcd-sterilization-modeler/`
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": c.faqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
};
---

<Layout
  title={c.pageTitle}
  description={c.pageDescription}
  structuredData={structuredData}
>
  <div class="max-w-6xl mx-auto px-4 py-8">
    <Breadcrumbs items={breadcrumbs} />

    <header class="mb-8">
      <div class="flex items-center gap-2 mb-3">
        <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-sky-600 text-white">
          {c.badge}
        </span>
        <span class="text-xs text-muted font-mono">FDA 21 CFR § 120 &bull; ASME Section VIII &bull; CGA G-6.1 &bull; 3-A 64-00</span>
      </div>
      <h1 class="text-display-sm md:text-display-md font-bold text-ink tracking-tight mb-4">
        {c.h1}
      </h1>
      <p class="text-body-lg text-muted max-w-4xl leading-relaxed">
        {c.lead}
      </p>
    </header>

    <!-- Interactive Simulator Component -->
    <CommercialHpcdSterilizationModeler lang={lang} />

    <!-- FAQ Section with Schema-Compliant Formatting -->
    <section class="my-16 border-t border-hairline pt-12">
      <h2 class="text-title-lg font-bold text-ink mb-6">
        {lang === 'es' && "Preguntas Frecuentes: Esterilización No Térmica Continua HPCD y Juice HACCP"}
        {lang === 'pt' && "Perguntas Frequentes: Esterilização Não Térmica Contínua HPCD e Juice HACCP"}
        {lang === 'zh-cn' && "常见问题解答：连续HPCD非热力灭菌工程与果汁HACCP法规"}
        {lang === 'ja' && "よくある質問：連続HPCD高密度相二酸化炭素非加熱殺菌とJuice HACCP"}
      </h2>
      <div class="space-y-6">
        {c.faqs.map(faq => (
          <div class="p-6 rounded-2xl bg-surface-soft border border-hairline">
            <h3 class="text-title-sm font-semibold text-ink mb-2">
              {faq.question}
            </h3>
            <p class="text-body text-sm text-muted leading-relaxed">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>
