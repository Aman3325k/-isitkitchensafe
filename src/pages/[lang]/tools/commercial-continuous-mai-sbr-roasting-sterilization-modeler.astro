const curContent = CONTENT[lang as Exclude<SupportedLanguage, 'en'>] || CONTENT.es;

const breadcrumbs = [
  { label: t('breadcrumbs.home') || 'Home', href: tp('/') },
  { label: t('breadcrumbs.tools') || 'Tools', href: tp('/tools/') },
  { label: curContent.breadcrumbsLabel }
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": `https://isitkitchensafe.com/${lang}/tools/commercial-continuous-mai-sbr-roasting-sterilization-modeler/#webapp`,
      "url": `https://isitkitchensafe.com/${lang}/tools/commercial-continuous-mai-sbr-roasting-sterilization-modeler/`,
      "name": curContent.pageTitle,
      "applicationCategory": "EngineeringApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5 Canvas/CSS3.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": curContent.pageDescription
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": t('breadcrumbs.home') || 'Home',
          "item": `https://isitkitchensafe.com/${lang}/`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": t('breadcrumbs.tools') || 'Tools',
          "item": `https://isitkitchensafe.com/${lang}/tools/`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": curContent.breadcrumbsLabel,
          "item": `https://isitkitchensafe.com/${lang}/tools/commercial-continuous-mai-sbr-roasting-sterilization-modeler/`
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": curContent.faqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
};
---

<Layout 
  title={curContent.pageTitle}
  description={curContent.pageDescription}
  structuredData={structuredData}
>
  <main class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
    <Breadcrumbs items={breadcrumbs} />

    <header class="mb-8">
      <div class="flex items-center gap-2 mb-3">
        <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-orange-950 text-orange-300 border border-orange-800">
          {curContent.badge}
        </span>
        <span class="text-xs text-muted font-mono">
          MAI-SBR &bull; 2.45 GHz &bull; 120&ndash;185&deg;C &bull; SEC 0.28 kWh/kg &bull; ASME Sec VIII &bull; FCC Part 18
        </span>
      </div>
      <h1 class="text-title-xl sm:text-headline-md font-medium text-ink tracking-tight mb-4">
        {curContent.h1}
      </h1>
      <p class="text-body text-base max-w-4xl text-muted leading-relaxed">
        {curContent.lead}
      </p>
    </header>

    <!-- Flagship Interactive Simulator Tool Component -->
    <CommercialContinuousMaiSbrModeler lang={lang} />

    <!-- Engineering FAQs Section for Comprehensive Technical Grounding -->
    <section class="mt-16 pt-12 border-t border-hairline" aria-labelledby="faqs-heading">
      <h2 id="faqs-heading" class="text-title-lg font-medium text-ink tracking-tight mb-8">
        {lang === 'zh-cn' ? '深度技术与生化工程常见问题解答' : lang === 'ja' ? '高度技術・生体工学 FAQ（よくある質問）' : lang === 'pt' ? 'Perguntas Técnicas e Biofísicas Frequentes' : 'Preguntas Frecuentes de Ingeniería y Biofísica'}
      </h2>
      <div class="space-y-6">
        {curContent.faqs.map(faq => (
          <article class="p-6 bg-surface-soft border border-hairline rounded-2xl">
            <h3 class="text-base font-bold text-ink mb-3">
              {faq.question}
            </h3>
            <p class="text-body text-sm leading-relaxed text-muted">
              {faq.answer}
            </p>
          </article>
        ))}
      </div>
    </section>
  </main>
</Layout>
