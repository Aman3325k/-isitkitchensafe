---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import SlowCookerFoodSafetyChecker from '../../../components/SlowCookerFoodSafetyChecker.astro';
import rawData from '../../../data/slow-cooker-food-safety-data.json';
import type { SupportedLanguage } from '../../../i18n/ui';

export function getStaticPaths() {
  const availableLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'zh-cn', 'ja'];
  return [
    { params: { lang: 'es' }, props: { lang: 'es' as SupportedLanguage, availableLocales } },
    { params: { lang: 'pt' }, props: { lang: 'pt' as SupportedLanguage, availableLocales } },
    { params: { lang: 'zh-cn' }, props: { lang: 'zh-cn' as SupportedLanguage, availableLocales } },
    { params: { lang: 'ja' }, props: { lang: 'ja' as SupportedLanguage, availableLocales } }
  ];
}

interface Props {
  lang: SupportedLanguage;
  availableLocales: SupportedLanguage[];
}

const { lang, availableLocales } = Astro.props;

interface LocalePageContent {
  pageTitle: string;
  pageDescription: string;
  badge: string;
  h1: string;
  heroSub: string;
  breadcrumbs: Array<{ label: string; href?: string }>;
}

const CONTENT: Record<Exclude<SupportedLanguage, 'en'>, LocalePageContent> = {
  es: {
    pageTitle: "Verificador de Seguridad en Olla de Cocción Lenta y Crock-Pot (Pautas USDA y FDA) | IsItKitchenSafe",
    pageDescription: "Verificador interactivo de seguridad para ollas de cocción lenta y Crock-Pot según USDA FSIS y FDA: consulta tiempos de cocción en BAJO y ALTO, límites seguros de llenado (1/2 a 2/3), prohibición estricta de carne congelada, alerta de toxina en frijoles rojos y prevención de choque térmico.",
    badge: "Pautas USDA FSIS · Manual Bad Bug de la FDA · 22 Alimentos y 3 Tamaños",
    h1: "Verificador de Seguridad en Olla Lenta y Crock-Pot",
    heroSub: "Evita la zona de peligro bacteriano, la toxicidad por fitohemaglutinina en frijoles y la rotura de vasijas cerámicas: consulta tiempos exactos en BAJO y ALTO, llenado seguro de 1/2 a 2/3 y la prohibición estricta de carnes crudas congeladas.",
    breadcrumbs: [
      { label: "Inicio", href: "/es/" },
      { label: "Herramientas", href: "/es/tools/" },
      { label: "Seguridad en Olla Lenta" }
    ]
  },
  pt: {
    pageTitle: "Verificador de Segurança na Panela de Cozimento Lento (Crock-Pot) | IsItKitchenSafe",
    pageDescription: "Verificador interativo de segurança para panelas elétricas lentas baseado em diretrizes USDA FSIS e FDA: confira tempos no BAIXO e ALTO, volume seguro (1/2 a 2/3), veto estrito a carne congelada, toxina lectina PHA em feijões e proteção contra choque térmico.",
    badge: "Normas USDA FSIS · Guia Bad Bug da FDA · 22 Alimentos e 3 Tamanhos",
    h1: "Verificador de Segurança na Panela Lenta (Crock-Pot)",
    heroSub: "Previna bactérias da zona de perigo, intoxicação por lectina em feijão cru e trincas na cuba cerâmica: consulte tempos no BAIXO e ALTO, volume de 1/2 a 2/3 e o veto do USDA a carnes congeladas.",
    breadcrumbs: [
      { label: "Início", href: "/pt/" },
      { label: "Ferramentas", href: "/pt/tools/" },
      { label: "Segurança Panela Lenta" }
    ]
  },
  'zh-cn': {
    pageTitle: "慢炖锅与电炖盅食品安全烹饪检查器 (USDA 规范 & FDA 毒素指南) | IsItKitchenSafe",
    pageDescription: "基于 USDA FSIS 慢炖规范与 FDA 毒素指南的交互式安全检查器：涵盖 22 种日常食材的 LOW/HIGH 烹饪时长、1/2 至 2/3 安全装料红线、USDA 生冻肉直接入锅严格禁令、生红芸豆植物凝集素预煮防毒要求及陶瓷内胆防热震开裂技巧。",
    badge: "USDA FSIS 慢炖指南 · FDA Bad Bug 毒素手册 · 22 种食材 × 3 种容量",
    h1: "慢炖锅与电炖盅安全烹饪检查器",
    heroSub: "远离细菌危险温区长时滋生、生芸豆植物凝集素急性中毒与陶瓷内胆热震炸裂——速查 22 种日常食材的 LOW / HIGH 慢炖时长、1/2 至 2/3 安全容积红线及 USDA 严禁直接慢炖生冻肉核心准则。",
    breadcrumbs: [
      { label: "首页", href: "/zh-cn/" },
      { label: "实用工具", href: "/zh-cn/tools/" },
      { label: "慢炖锅食品安全检查器" }
    ]
  },
  ja: {
    pageTitle: "スロークッカー＆クロックポット 食品安全調理チェッカー（米USDA＆FDA基準） | IsItKitchenSafe",
    pageDescription: "米農務省（USDA FSIS）および米FDA基準に基づくスロークッカー安全チェッカー。定番22食材の「LOW / HIGH」調理時間、安全な容量（1/2〜2/3）、USDA冷凍肉調理厳禁ルール、赤インゲン豆のレクチン毒素対策、陶器製内鍋のヒートショック割れ防止策を即確認。",
    badge: "USDA FSIS 基準 · 米FDA食中毒毒素指針 · 定番22食材 × 3サイズ",
    h1: "スロークッカー＆クロックポット 安全調理チェッカー",
    heroSub: "食中毒菌の危険温度帯滞留、赤インゲン豆レクチンによる急性食中毒、陶器内鍋の急冷熱割れを徹底予防。定番22食材のLOW・HIGH加熱時間、1/2〜2/3の安全容量、冷凍生肉の直接投入禁止ルールを素早く確認できます。",
    breadcrumbs: [
      { label: "ホーム", href: "/ja/" },
      { label: "ツール", href: "/ja/tools/" },
      { label: "スロークッカー安全チェッカー" }
    ]
  }
};

const c = CONTENT[lang as Exclude<SupportedLanguage, 'en'>] || CONTENT.es;
const faqs = (rawData.faqs as Record<string, Array<{ question: string; answer: string }>>)[lang] || rawData.faqs.en;
const localizedUrl = `https://isitkitchensafe.com/${lang}/tools/slow-cooker-food-safety-checker/`;

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": c.h1,
  "url": localizedUrl,
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript.",
  "description": c.pageDescription,
  "inLanguage": lang === 'zh-cn' ? 'zh-CN' : lang,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={c.pageTitle}
  description={c.pageDescription}
  faqs={faqs}
  excludeFaqSchema={true}
  availableLocales={availableLocales}
  lang={lang}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1 print:hidden">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={c.breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1140px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-700 text-white mb-3">
        {c.badge}
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        {c.h1}
      </h1>
      <p class="text-body text-[15px] md:text-[16px] leading-relaxed">
        {c.heroSub}
      </p>
    </header>

    <!-- Main Interactive Checker Component -->
    <SlowCookerFoodSafetyChecker lang={lang} />
  </div>
</Layout>
