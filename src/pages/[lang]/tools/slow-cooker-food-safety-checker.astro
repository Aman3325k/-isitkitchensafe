---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import SlowCookerFoodSafetyChecker from '../../../components/SlowCookerFoodSafetyChecker.astro';
import rawData from '../../../data/slow-cooker-food-safety-data.json';
import type { SupportedLanguage } from '../../../i18n/ui';

export function getStaticPaths() {
  const availableLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'zh-cn', 'ja'];
  return [
    { params: { lang: 'es' }, props: { lang: 'es' as SupportedLanguage, availableLocales } },
    { params: { lang: 'pt' }, props: { lang: 'pt' as SupportedLanguage, availableLocales } },
    { params: { lang: 'zh-cn' }, props: { lang: 'zh-cn' as SupportedLanguage, availableLocales } },
    { params: { lang: 'ja' }, props: { lang: 'ja' as SupportedLanguage, availableLocales } }
  ];
}

interface Props {
  lang: SupportedLanguage;
  availableLocales: SupportedLanguage[];
}

const { lang, availableLocales } = Astro.props;

interface LocalePageContent {
  pageTitle: string;
  pageDescription: string;
  badge: string;
  h1: string;
  heroSub: string;
  breadcrumbs: Array<{ label: string; href?: string }>;
}

const CONTENT: Record<Exclude<SupportedLanguage, 'en'>, LocalePageContent> = {
  es: {
    pageTitle: "Verificador de Seguridad para Slow Cooker y Crock-Pot: Carne Congelada, Frijoles Rojos y Apagones | IsItKitchenSafe",
    pageDescription: "Verificador interactivo de seguridad alimentaria para olla lenta (Slow Cooker / Crock-Pot) basado en USDA FSIS y FDA: simula llenado (1/2 a 2/3), HIGH/LOW/Keep-Warm y cortes de luz, y consulta 16 alimentos, lectina en frijoles rojos, sobras, bolsas FDA y choque térmico de cerámica.",
    badge: "Reglas USDA FSIS · Alerta FDA Frijoles Rojos · 16 Casos y Simulador",
    h1: "Verificador de Seguridad Alimentaria para Slow Cooker y Crock-Pot",
    heroSub: "Evita intoxicaciones en la Zona de Peligro, frijoles rojos crudos 5× más tóxicos, dudas tras un apagón y cerámica agrietada: simula en vivo tu llenado, potencia y electricidad y revisa 16 casos clave según USDA y FDA.",
    breadcrumbs: [
      { label: "Inicio", href: "/es/" },
      { label: "Herramientas", href: "/es/tools/" },
      { label: "Seguridad en Slow Cooker / Crock-Pot" }
    ]
  },
  pt: {
    pageTitle: "Verificador de Segurança para Slow Cooker e Crock-Pot: Carne Congelada, Feijão Vermelho e Apagões | IsItKitchenSafe",
    pageDescription: "Verificador interativo de segurança alimentar para Slow Cooker / Crock-Pot baseado em USDA FSIS e FDA: simule volume (1/2 a 2/3), HIGH/LOW/Keep-Warm e quedas de luz, e consulte 16 itens sobre carne congelada, lectina do feijão vermelho, sobras, forros FDA e choque térmico da cerâmica.",
    badge: "Normas USDA FSIS · Alerta FDA Feijão Vermelho · 16 Itens e Simulador",
    h1: "Verificador de Segurança Alimentar para Slow Cooker e Crock-Pot",
    heroSub: "Evite intoxicação na Zona de Perigo, feijão vermelho cru 5× mais tóxico, incerteza após quedas de energia e cuba trincada: simule ao vivo volume, potência e energia e confira 16 regras essenciais do USDA e da FDA.",
    breadcrumbs: [
      { label: "Início", href: "/pt/" },
      { label: "Ferramentas", href: "/pt/tools/" },
      { label: "Segurança em Slow Cooker / Crock-Pot" }
    ]
  },
  'zh-cn': {
    pageTitle: "慢炖锅 / Crock-Pot 食品安全检查器：冷冻肉、红腰豆毒素与停电处置指南 | IsItKitchenSafe",
    pageDescription: "基于 USDA FSIS 与 FDA 权威标准的交互式慢炖锅（Slow Cooker / Crock-Pot）食品安全检查器：实时模拟装量（1/2–2/3）、高/低/保温档及停电丢弃规则，涵盖 16 种常见食材、生红腰豆毒素、剩菜复热、FDA 尼龙内衬袋与陶瓷热冲击护理。",
    badge: "USDA FSIS 慢炖规范 · FDA 红腰豆毒素警示 · 16 项场景与模拟器",
    h1: "慢炖锅 / Crock-Pot 食品安全检查器",
    heroSub: "远离细菌危险温区中毒、生红腰豆毒性放大 5 倍、停电去留误判与陶瓷内胆炸裂——实时模拟您的装量、火候与供电状态，速查 16 项 USDA 与 FDA 慢炖锅权威规则。",
    breadcrumbs: [
      { label: "首页", href: "/zh-cn/" },
      { label: "实用工具", href: "/zh-cn/tools/" },
      { label: "慢炖锅食品安全检查器" }
    ]
  },
  ja: {
    pageTitle: "スロークッカー・Crock-Pot 食品安全チェッカー：冷凍肉・赤いんげん豆・停電対策 | IsItKitchenSafe",
    pageDescription: "USDA FSIS・FDA 基準に基づくスロークッカー（Crock-Pot）食品安全チェッカー。充填量（1/2〜2/3）・強/弱/保温・停電時の廃棄基準をリアルタイム診断し、冷凍肉・赤いんげん豆レクチン毒・残り物再加熱・ナイロンライナー・陶器熱衝撃など 16 項目を網羅。",
    badge: "USDA FSIS 基準 · FDA 赤いんげん豆警告 · 16項目＆シミュレーター",
    h1: "スロークッカー・Crock-Pot 食品安全チェッカー",
    heroSub: "細菌危険温度帯での食中毒、生赤いんげん豆の毒性 5 倍化、停電後の判断ミス、陶器内鍋の破損を徹底予防。容量・火力・停電状況をリアルタイム診断し、USDA・FDA 準拠の 16 ルールを即確認できます。",
    breadcrumbs: [
      { label: "ホーム", href: "/ja/" },
      { label: "ツール", href: "/ja/tools/" },
      { label: "スロークッカー食品安全チェッカー" }
    ]
  }
};

const c = CONTENT[lang as Exclude<SupportedLanguage, 'en'>] || CONTENT.es;
const faqs = (rawData.faqs as Record<string, Array<{ question: string; answer: string }>>)[lang] || rawData.faqs.en;
const localizedUrl = `https://isitkitchensafe.com/${lang}/tools/slow-cooker-food-safety-checker/`;

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": c.h1,
  "url": localizedUrl,
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript.",
  "description": c.pageDescription,
  "inLanguage": lang === 'zh-cn' ? 'zh-CN' : lang,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={c.pageTitle}
  description={c.pageDescription}
  faqs={faqs}
  excludeFaqSchema={true}
  availableLocales={availableLocales}
  lang={lang}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1 print:hidden">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={c.breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1140px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-signature-coral text-white mb-3">
        {c.badge}
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        {c.h1}
      </h1>
      <p class="text-body text-[15px] md:text-[16px] leading-relaxed">
        {c.heroSub}
      </p>
    </header>

    <!-- Main Interactive Checker Component -->
    <SlowCookerFoodSafetyChecker lang={lang} />
  </div>
</Layout>
