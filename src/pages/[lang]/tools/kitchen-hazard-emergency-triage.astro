---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import KitchenEmergencyTriage from '../../../components/KitchenEmergencyTriage.astro';
import type { SupportedLanguage } from '../../../i18n/ui';
import { useTranslations, useTranslatedPath } from '../../../i18n/utils';

export function getStaticPaths() {
  const availableLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'zh-cn', 'ja'];
  return [
    { params: { lang: 'es' }, props: { lang: 'es' as SupportedLanguage, availableLocales } },
    { params: { lang: 'pt' }, props: { lang: 'pt' as SupportedLanguage, availableLocales } },
    { params: { lang: 'zh-cn' }, props: { lang: 'zh-cn' as SupportedLanguage, availableLocales } },
    { params: { lang: 'ja' }, props: { lang: 'ja' as SupportedLanguage, availableLocales } }
  ];
}

interface Props {
  lang: SupportedLanguage;
  availableLocales: SupportedLanguage[];
}

const { lang, availableLocales } = Astro.props;
const t = useTranslations(lang);
const tp = useTranslatedPath(lang);

interface LocaleToolContent {
  pageTitle: string;
  pageDescription: string;
  badge: string;
  h1: string;
  heroSub: string;
  extinguisherTitle: string;
  extinguisherIntro: string;
  extinguisherClasses: Array<{ letter: string; name: string; desc: string }>;
  faqs: Array<{ question: string; answer: string }>;
  breadcrumbs: Array<{ label: string; href?: string }>;
}

const CONTENT: Record<SupportedLanguage, LocaleToolContent> = {
  en: {} as any,
  es: {
    pageTitle: "Herramienta de Triaje y Contención de Emergencias en la Cocina | Chispas, Incendios, Vidrio y Humos | IsItKitchenSafe",
    pageDescription: "Instrucciones de emergencia paso a paso para chispas en microondas, fuego de aceite en sartenes, pirex estallado por choque térmico y humos de teflón.",
    badge: "Respuesta Rápida a Emergencias • Seguridad Vital",
    h1: "Herramienta de Triaje y Contención de Emergencias en la Cocina",
    heroSub: "Cuando un electrodoméstico echa chispas, arde o estalla, cada segundo es crítico. Utiliza nuestra matriz interactiva para conocer la acción inmediata de contención y los errores que jamás debes cometer.",
    extinguisherTitle: "Tipos de Extintores para la Cocina (Norma NFPA)",
    extinguisherIntro: "Usar un extintor inadecuado en la cocina puede propagar el aceite ardiendo o causar una descarga eléctrica mortal. Conoce las 4 clases fundamentales:",
    extinguisherClasses: [
      { letter: "A", name: "Clase A: Sólidos Combustibles", desc: "Papel de cocina, cajas de cartón, delantales y madera. Apaga brasas con agua o fosfato monoamónico en polvo." },
      { letter: "B", name: "Clase B: Líquidos Inflamables", desc: "Aceite de cocina, alcohol y aerosoles. Emplea polvo químico seco para ahogar las llamas sin salpicar líquido." },
      { letter: "C", name: "Clase C: Equipos Eléctricos", desc: "Microondas, tostadoras, lavavajillas y motores. Agentes no conductores para cortar el fuego sin electrocución." },
      { letter: "K", name: "Clase K: Aceites y Grasas de Cocina", desc: "Freidoras y grasas a altas temperaturas. Descarga acetato potásico que crea una densa capa jabonosa refrigerante." }
    ],
    faqs: [
      {
        question: "¿Por qué jamás se debe echar agua sobre una sartén ardiendo?",
        answer: "El agua líquida hierve instantáneamente a 100°C al tocar aceite que está a más de 400°C, multiplicando su volumen por 1.700 en forma de vapor violento. Esta expansión proyecta miles de gotas de aceite hirviendo ardiendo en el aire, creando una bola de fuego de 3 metros que abrasa techos y personas."
      },
      {
        question: "¿Por qué el papel de aluminio echa chispas en el microondas?",
        answer: "El aluminio no absorbe las microondas, sino que las refleja. En los pliegues y bordes arrugados finos se concentra una tensión de más de 30.000 voltios por centímetro, ionizando el aire y generando un arco de plasma luminoso a más de 1.000°C capaz de perforar las paredes del aparato."
      },
      {
        question: "¿El humo de una sartén de teflón quemada puede matar pájaros?",
        answer: "Sí, de forma letal y fulminante. El teflón (PTFE) por encima de 260°C se descompone y libera humos de perfluoroisobutileno y fluoruro de carbonilo. El sistema respiratorio de las aves, al tener sacos aéreos de intercambio ultraeficiente, sufre edema pulmonar hemorrágico agudo y mueren en cuestión de minutos."
      },
      {
        question: "¿Qué hacer si una fuente de vidrio pirex explota dentro del horno?",
        answer: "Aléjate de inmediato y no dejes entrar a niños o mascotas descalzas. Apaga el horno y deja enfriar todos los cristales durante 45 minutos. Usa guantes gruesos de cuero anticorte. Desecha toda la comida en 2,5 metros a la redonda por las microagujas invisibles de vidrio, y aspira con una aspiradora de taller."
      }
    ],
    breadcrumbs: [
      { label: "Inicio", href: "/es/" },
      { label: "Herramientas", href: "/es/tools/" },
      { label: "Triaje de Emergencia" }
    ]
  },
  pt: {
    pageTitle: "Triagem de Emergência e Contenção de Perigos na Cozinha | IsItKitchenSafe",
    pageDescription: "Instruções imediatas passo a passo para micro-ondas com faíscas, panela pegando fogo, vidro estilhaçado por choque térmico e vapores tóxicos de teflon.",
    badge: "Resposta Rápida a Emergências • Salva-Vidas",
    h1: "Triagem de Emergência e Contenção de Perigos na Cozinha",
    heroSub: "Quando um eletrodoméstico solta faíscas, pega fogo ou explode, cada segundo é decisivo. Siga nossa matriz para saber exatamente o que fazer e quais erros fatais evitar.",
    extinguisherTitle: "Classes de Extintores de Incêndio na Cozinha",
    extinguisherIntro: "Usar o extintor errado em um fogo de cozinha pode espalhar óleo em chamas ou causar choque elétrico. Conheça as 4 classes essenciais:",
    extinguisherClasses: [
      { letter: "A", name: "Classe A: Materiais Sólidos", desc: "Papel toalha, papelão, panos de prato e madeira. Age por resfriamento das brasas com água ou pó químico." },
      { letter: "B", name: "Classe B: Líquidos Inflamáveis", desc: "Óleo vegetal, álcool e aerossóis. Utiliza pó químico seco para quebrar a reação em cadeia e abafar o oxigênio." },
      { letter: "C", name: "Classe C: Equipamentos Elétricos", desc: "Micro-ondas, lava-louças e fiação. Agente não condutor que extingue o fogo sem risco de choque elétrico." },
      { letter: "K", name: "Classe K: Óleos e Gorduras de Cocção", desc: "Gorduras e fritadeiras em alta temperatura. Libera solução aquosa de acetato de potássio formando espuma protetora." }
    ],
    faqs: [
      {
        question: "Por que nunca se deve jogar água em uma panela com óleo pegando fogo?",
        answer: "A água é mais densa que o óleo e ferve a 100°C, enquanto o óleo queima acima de 400°C. Ao atingir o fundo da panela, a água evapora instantaneamente em vapor expandindo 1.700 vezes seu volume, arremessando uma nuvem gigante de óleo incandescente que cria uma bola de fogo destruidora."
      },
      {
        question: "Por que o papel alumínio solta faíscas no micro-ondas?",
        answer: "O metal reflete as ondas de alta frequência em vez de absorvê-las. Nas pontas finas e amassadas, a carga elétrica atinge mais de 30 mil volts por centímetro, ionizando o ar e gerando um arco elétrico de plasma a altíssima temperatura que pode perfurar a carcaça."
      },
      {
        question: "A fumaça de uma panela antiaderente queimada realmente mata pássaros?",
        answer: "Sim, com extrema rapidez. O PTFE (teflon) acima de 260°C sofre pirólise térmica e emite gases perfluorados altamente tóxicos. Pássaros têm pulmões e sacos aéreos hipersensíveis e sofrem edema pulmonar fulminante, morrendo em poucos minutos se não forem evacuados."
      },
      {
        question: "O que fazer se uma travessa de vidro estourar dentro do forno?",
        answer: "Afaste-se imediatamente e proíba crianças e animais descalços na cozinha. Desligue o forno e aguarde 45 minutos até os cacos esfriarem totalmente. Use luvas de couro grossas e óculos de proteção. Jogue fora qualquer alimento em um raio de 2,5 metros e aspire com aspirador apropriado."
      }
    ],
    breadcrumbs: [
      { label: "Início", href: "/pt/" },
      { label: "Ferramentas", href: "/pt/tools/" },
      { label: "Triagem de Emergência" }
    ]
  },
  'zh-cn': {
    pageTitle: "厨房突发危险应急分级处置与自救指南 | 微波炉打火、油锅着火、玻璃炸裂 | IsItKitchenSafe",
    pageDescription: "针对微波炉打火起弧、油锅爆燃着火、高温耐热玻璃自爆、特氟龙过热剧毒烟雾等险情，提供专业消防级即刻处置与自救清单。",
    badge: "秒级应急处置 • 消防生命安全",
    h1: "厨房突发危险应急分级与处置工具",
    heroSub: "当厨房电器剧烈打火、冒烟起火或炸裂时，每一秒都关乎生命安全。使用我们的应急矩阵即刻查明处置第一指令、绝对禁忌事项与排险步骤。",
    extinguisherTitle: "厨房灭火器分级与正确选型（NFPA 标准）",
    extinguisherIntro: "在厨房中使用错误的灭火器可能导致热油四溅或高压触电。在险情发生前请牢记以下 4 种灭火级别：",
    extinguisherClasses: [
      { letter: "A", name: "A 类：固体可燃物火灾", desc: "厨房纸巾、纸箱、木铲、围裙。通过水系灭火剂或磷酸铵盐干粉冷却窒息阴燃余烬。" },
      { letter: "B", name: "B 类：易燃液体火灾", desc: "食用油脂、酒精、烹饪喷雾油。通过干粉或二氧化碳切断氧气，避免液体飞溅。" },
      { letter: "C", name: "C 类：带电设备火灾", desc: "微波炉、洗碗机、电烤箱、冰箱电线。采用不导电干粉灭火剂，杜绝救火触电事故。" },
      { letter: "K", name: "K 类：高温烹饪油火灾", desc: "高温油炸锅、动物植物油脂火灾。喷射醋酸钾湿化学灭火剂发生皂化反应，形成致密阻火泡沫。" }
    ],
    faqs: [
      {
        question: "为什么油锅起火绝对不能泼水？",
        answer: "水的密度大于油且沸点仅为 100°C，而燃烧中的热油温度通常高达 400°C 以上。水倒入油锅瞬间沉底并汽化膨胀 1700 倍，将带火的滚烫油滴剧烈炸飞到空气中，形成几米高的爆鸣火球，瞬间点燃天花板与全身衣物。"
      },
      {
        question: "为什么铝箔纸放进微波炉会打火放电？",
        answer: "金属不吸收微波反而将其剧烈反射。铝箔纸的褶皱毛刺处会聚集极高的电位差，当电场强度击穿空气绝缘极限（约 30kV/cm）时，便会激发出温度超千度的电弧等离子体，击穿微波炉内壁或引燃油垢。"
      },
      {
        question: "不粘锅干烧冒出的烟真的会致死宠物鸟吗？",
        answer: "会，而且几分钟内即可致命。特氟龙（PTFE）涂层在超过 260°C 时分解，超过 350°C 发生热解剧烈释放全氟异丁烯等含氟剧毒烟气。鸟类特有的气囊单向双重呼吸系统对空气毒物极为敏感，会迅速引发急性出血性肺水肿窒息死亡。"
      },
      {
        question: "烤箱里的玻璃烤盘发生自爆炸裂该如何安全处理？",
        answer: "立即后退并阻止宠物和赤脚家人靠近。关掉烤箱让碎玻璃在密闭状态下冷却 45 分钟（热玻璃会二次弹射碎屑）。佩戴厚皮革防刺手套和护目镜。因微米级玻璃碎屑极具穿透力，必须丢弃半径 2.5 米内的全部食物，并用吸尘器与湿纸巾单向擦拭清理。"
      }
    ],
    breadcrumbs: [
      { label: "首页", href: "/zh-cn/" },
      { label: "实用工具", href: "/zh-cn/tools/" },
      { label: "突发险情应急处置" }
    ]
  },
  ja: {
    pageTitle: "キッチン危険緊急トリアージ＆安全対処ツール | レンジ火花・油火災・ガラス破裂 | IsItKitchenSafe",
    pageDescription: "電子レンジの火花スパーク、揚げ油・オーブン火災、耐熱ガラスの熱衝撃破裂、テフロン過熱の有毒ガスに対する即座の初動対応と段階的封じ込め手順。",
    badge: "初動トリアージ • 消防生命安全",
    h1: "キッチン危険緊急トリアージ＆安全対処ツール",
    heroSub: "電化製品が激しく火花を散らしたり、炎が上がったり、ガラスが破裂した時は秒単位の判断が生死を分けます。直ちに行うべき行動と絶対厳禁の禁忌を本ツールで確認してください。",
    extinguisherTitle: "キッチン火災における消火器の分類規格",
    extinguisherIntro: "不適切な消火器を使用すると、燃える油を撒き散らしたり感電事故を引き起こします。4つの基本区分を理解しておきましょう：",
    extinguisherClasses: [
      { letter: "A", name: "普通火災（A火災）：紙・木材", desc: "キッチンペーパー、ダンボール、ふきん、エプロン。水や粉末薬剤で冷却・窒息消火します。" },
      { letter: "B", name: "油火災（B火災）：可燃性液体", desc: "食用油、アルコール、油スプレー。粉末薬剤で酸素を遮断し、液体の飛散を防ぎます。" },
      { letter: "C", name: "電気火災（C火災）：通電機器", desc: "電子レンジ、食洗機、冷蔵庫の配線。非伝導性の粉末薬剤で感電を防ぎながら消火します。" },
      { letter: "K", name: "厨房火災（K火災）：高温調理油", desc: "揚げ油やフライヤー。強化液（酢酸カリウム系）が油とケン化反応を起こし、窒息泡膜を形成します。" }
    ],
    faqs: [
      {
        question: "燃えている油鍋に絶対に水をかけてはいけない理由は何ですか？",
        answer: "水は油より重く沸点が100℃ですが、燃えている油は400℃以上あります。水が入った瞬間に底で爆発的に水蒸気化（1700倍に膨張）し、燃え盛る油を周囲に噴出させて巨大な火柱爆発を起こすためです。"
      },
      {
        question: "アルミホイルを電子レンジに入れるとなぜ火花が出るのですか？",
        answer: "金属はマイクロ波を吸収せず反射します。ホイルのしわや尖った角に電圧が集中し、空気の絶縁破壊を起こして高温のプラズマ放電（アーク）が発生し、壁面を焼き焦がしたり火災を引き起こします。"
      },
      {
        question: "テフロンフライパンの空焚き煙でペットの鳥が死ぬというのは本当ですか？",
        answer: "本当であり、数分で命を落とします。フッ素樹脂（PTFE）は260℃を超えると熱分解を始め、有毒ガスを放出します。鳥類は気のうを持つ高効率な呼吸器系を有するため、極微量の有毒ガスでも急性肺水腫を起こして即死します。"
      },
      {
        question: "耐熱ガラス皿がオーブン内で熱衝撃で爆発・破損した時の対処法は？",
        answer: "直ちに後退し、裸足の家族やペットを遠ざけてください。オーブンを止め、破片が冷えるまで45分間触らずに待ちます。厚手の革手袋と保護メガネを着用し、目に見えない微細なガラス粉が飛散しているため半径2.5m以内の食品は全て破棄してください。"
      }
    ],
    breadcrumbs: [
      { label: "ホーム", href: `/${lang}/` },
      { label: "ツール", href: `/${lang}/tools/` },
      { label: "緊急時トリアージ" }
    ]
  }
};

const c = CONTENT[lang];

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": c.h1,
  "url": `https://isitkitchensafe.com/${lang}/tools/kitchen-hazard-emergency-triage/`,
  "applicationCategory": "HealthApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "description": c.pageDescription,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};
---

<Layout title={c.pageTitle} description={c.pageDescription} faqs={c.faqs} availableLocales={availableLocales} lang={lang}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={c.breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1200px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-red-600 text-white mb-3">
        {c.badge}
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        {c.h1}
      </h1>
      <p class="text-body text-[15px] md:text-body-md leading-relaxed">
        {c.heroSub}
      </p>
    </header>

    <!-- Main Triage Component -->
    <div class="mb-14">
      <KitchenEmergencyTriage lang={lang} />
    </div>

    <!-- Official Kitchen Fire Extinguisher Guide -->
    <section class="mb-14 border-t border-hairline pt-12 space-y-6">
      <div class="max-w-3xl">
        <span class="text-xs font-bold uppercase tracking-wider text-muted block mb-1">
          {lang === 'ja' ? '消防安全基準' : lang === 'zh-cn' ? '消防与生命安全' : 'Normas de Seguridad'}
        </span>
        <h2 class="text-title-lg md:text-display-sm font-medium text-ink tracking-tight mb-3">
          {c.extinguisherTitle}
        </h2>
        <p class="text-body text-[15px] leading-relaxed mb-4">
          {c.extinguisherIntro}
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {c.extinguisherClasses.map((item) => (
          <div class="p-5 rounded-xl bg-surface-soft border border-hairline space-y-2">
            <div class={`w-8 h-8 rounded-lg text-white font-bold flex items-center justify-center text-sm ${
              item.letter === 'A' ? 'bg-emerald-700' :
              item.letter === 'B' ? 'bg-red-600' :
              item.letter === 'C' ? 'bg-blue-600' : 'bg-amber-600'
            }`}>
              {item.letter}
            </div>
            <h3 class="font-semibold text-ink text-sm">{item.name}</h3>
            <p class="text-xs text-body leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="border-t border-hairline pt-12">
      <h2 class="text-title-lg md:text-display-sm font-medium text-ink tracking-tight mb-8">
        {lang === 'ja' ? 'よくある質問' : lang === 'zh-cn' ? '常见问题与安全解答' : lang === 'pt' ? 'Perguntas Frequentes' : 'Preguntas Frecuentes'}
      </h2>
      <div class="space-y-6 max-w-3xl">
        {c.faqs.map(faq => (
          <div class="border-b border-hairline pb-6">
            <h3 class="text-base font-semibold text-ink mb-2">
              {faq.question}
            </h3>
            <p class="text-body text-sm leading-relaxed">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>
