      },
      {
        question: "为何常温EHD-CME包埋能保留98%以上的益生菌活性并彻底杜绝Omega-3脂肪酸氧化？",
        answer: "活性益生菌（如鼠李糖乳杆菌GG、双歧杆菌等）对热极其敏感，超过55℃会导致核糖体变性及细胞膜破裂，传统高温喷雾干燥会导致2至4个数量级的菌群死亡（致死率高达60%–80%）。同时，Omega-3中的DHA和EPA含有多个易氧化的双键，高温下剧烈产生过氧化物与鱼腥哈败味（PV > 4.5 meq/kg）。EHD-CME系统在封闭的氮气保护舱内（氧含量 < 0.5%）以室温等温状态运行，对菌体膜与脂质分子施加零热负荷，益生菌存活率超过98.5%，且封装后的Omega-3在常温储存240天内过氧化值稳定在0.85 meq/kg以下。"
      },
      {
        question: "同轴生物大分子外壳（海藻酸钠/乳清分离蛋白）如何实现耐胃酸保护（pH 2.0）与肠道靶向崩解释放？",
        answer: "未经保护的活性益生菌在胃酸环境（pH 1.5–2.5及胃蛋白酶）中的灭活率高达90%以上。EHD-CME将活性物同轴包裹于食品级钙交联海藻酸钠与乳清蛋白外壳内。在pH 2.0的胃酸介质中，羧基质子化为不溶性海藻酸分子网络，微胶囊外壳收缩形成致密的不透水水凝胶屏障，有效阻隔水合氢离子扩散，胃液通过存活率超过94%。当胶囊进入十二指肠与小肠（pH 6.8–7.4）时，羧基去质子化并受肠道磷酸盐置换钙离子，水凝胶迅速发生溶胀并在胰蛋白酶作用下精准崩解，将活菌直接释放至肠道完成定植。"
      },
      {
        question: "该系统如何消除有害化学交联剂、降低90%以上能耗并保障高压电气安全？",
        answer: "传统凝聚包埋常采用戊二醛等有毒醛类硬化剂，其残留物（>50 ppm）严重违反USP <467>与FDA食品接触安全标准。EHD-CME采用纯水相食品级CaCl2溶液进行物理离子交联，实现0.0 ppm化学溶剂残留。由于避免了水的气化潜热消耗（2,260 kJ/kg），单公斤物料能耗由喷雾干燥的3.4 kWh/kg大幅降低至0.18–0.28 kWh/kg，节能超过91%。系统还符合IEEE Std 510高压安全规范，配备亚微秒级光学电弧熄灭保护（<1.0 µs响应）、冗余接地闭环（<0.1 Ω）与法拉第电磁屏蔽舱，确保工业连续生产安全。"
      }
    ]
  }
};

const cur = CONTENT[lang as Exclude<SupportedLanguage, 'en'>];

const breadcrumbs = [
  { label: t('nav.home') || 'Home', href: tp('/') },
  { label: t('nav.tools') || 'Tools', href: tp('/tools/') },
  { label: cur.breadcrumbsLabel }
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": `https://isitkitchensafe.com/${lang}/tools/commercial-continuous-ehd-cme-micro-encapsulation-modeler/#webapp`,
      "url": `https://isitkitchensafe.com/${lang}/tools/commercial-continuous-ehd-cme-micro-encapsulation-modeler/`,
      "name": cur.pageTitle,
      "applicationCategory": "EngineeringApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5 Canvas/CSS3.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": cur.pageDescription
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": t('nav.home') || 'Home',
          "item": `https://isitkitchensafe.com${tp('/')}`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": t('nav.tools') || 'Tools',
          "item": `https://isitkitchensafe.com${tp('/tools/')}`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": cur.breadcrumbsLabel,
          "item": `https://isitkitchensafe.com/${lang}/tools/commercial-continuous-ehd-cme-micro-encapsulation-modeler/`
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": cur.faqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
};
---

<Layout title={cur.pageTitle} description={cur.pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <Breadcrumbs items={breadcrumbs} />

    <!-- Hero Header -->
    <div class="mb-10 text-center max-w-4xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-violet-950 text-violet-300 border border-violet-800 mb-4">
        <span>{cur.badge}</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-ink tracking-tight mb-4 leading-tight">
        {cur.h1}
      </h1>
      <p class="text-base sm:text-lg text-muted leading-relaxed">
        {cur.lead}
      </p>
    </div>

    <!-- Interactive Simulator Component with localized strings -->
    <CommercialContinuousEhdCmeModeler lang={lang} />

    <!-- In-Depth Technical & Regulatory FAQs -->
    <div class="mt-16 bg-surface p-6 sm:p-10 rounded-3xl border border-hairline">
      <h2 class="text-2xl font-bold text-ink mb-2">Technical &amp; Regulatory Engineering FAQs</h2>
      <p class="text-sm text-muted mb-8">Detailed scientific principles and regulatory compliance guidance for continuous electrohydrodynamic encapsulation.</p>
      
      <div class="space-y-6">
        {cur.faqs.map(faq => (
          <div class="border-b border-hairline/60 pb-6 last:border-b-0 last:pb-0">
            <h3 class="text-base sm:text-lg font-bold text-ink mb-2">{faq.question}</h3>
            <p class="text-sm text-muted leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</Layout>
