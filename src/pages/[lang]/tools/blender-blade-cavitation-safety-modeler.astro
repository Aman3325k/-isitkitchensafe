      {
        question: "刃の台座裏にある黒い油汚れは何ですか？",
        answer: "回転軸のオイルシールパッキンが摩耗・破損した証拠です。食洗機の熱や洗剤でゴムが劣化し、軸受内部の鉱物性工業用グリスや金属摩耗粉が食品内へ直接漏出し始めています。ただちに刃の部品を交換してください。"
      },
      {
        question: "据置型ミキサーで安全に熱いスープをポタージュ状にする手順は？",
        answer: "容量はボトルの半分以下に抑え、フタ中央の透明な丸い小キャップを必ず取り外して蒸気抜き穴を確保します。その穴の上に清潔な乾いた布巾をふんわり被せ、最初は必ず最低速度で回転を開始して蒸気を逃がしながら徐々に速度を上げてください。"
      }
    ]
  }
};

const content = CONTENT[lang] || CONTENT.es;
---

<Layout title={content.pageTitle} description={content.pageDescription} faqs={content.faqs} availableLocales={availableLocales}>
  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={content.breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1280px] mx-auto px-6 py-10 md:py-16">
    <!-- Header -->
    <header class="max-w-4xl mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-amber-100 text-amber-900 mb-3">
        <span>⚡</span>
        {content.monoBadge}
      </div>
      <h1 class="text-3xl md:text-5xl font-extrabold text-ink tracking-tight mb-4 leading-tight">
        {content.monoTitle}
      </h1>
      <p class="text-base md:text-xl text-body leading-relaxed">
        {content.monoSub}
      </p>
    </header>

    <!-- Interactive Simulator Component -->
    <BlenderCavitationSafetyModeler lang={lang} />

    <!-- Scientific Engineering & Physics Guide -->
    <article class="prose max-w-none border-t border-hairline pt-12 space-y-10 text-body">
      <div>
        <h2 class="text-2xl font-bold text-ink mb-4">
          {content.monoSection1Title}
        </h2>
        <p class="leading-relaxed">
          {content.monoSection1Body}
        </p>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-ink mb-4">
          {content.monoSection2Title}
        </h2>
        <p class="leading-relaxed">
          {content.monoSection2Body}
        </p>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-ink mb-4">
          {content.monoSection3Title}
        </h2>
        <p class="leading-relaxed">
          {content.monoSection3Body}
        </p>
      </div>
    </article>
  </div>
</Layout>
