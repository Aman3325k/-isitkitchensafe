---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ProductRecallsScanner from '../../../components/ProductRecallsScanner.astro';
import type { SupportedLanguage } from '../../../i18n/ui';
import { useTranslations, useTranslatedPath } from '../../../i18n/utils';

export function getStaticPaths() {
  const availableLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'zh-cn', 'ja'];
  return [
    { params: { lang: 'es' }, props: { lang: 'es' as SupportedLanguage, availableLocales } },
    { params: { lang: 'pt' }, props: { lang: 'pt' as SupportedLanguage, availableLocales } },
    { params: { lang: 'zh-cn' }, props: { lang: 'zh-cn' as SupportedLanguage, availableLocales } },
    { params: { lang: 'ja' }, props: { lang: 'ja' as SupportedLanguage, availableLocales } }
  ];
}

interface Props {
  lang: SupportedLanguage;
  availableLocales: SupportedLanguage[];
}

const { lang, availableLocales } = Astro.props;
const t = useTranslations(lang);
const tp = useTranslatedPath(lang);

interface LocaleRecallContent {
  pageTitle: string;
  pageDescription: string;
  badge: string;
  h1: string;
  heroSub: string;
  standardsTitle: string;
  standardsIntro: string;
  agencies: Array<{ label: string; name: string; desc: string }>;
  faqs: Array<{ question: string; answer: string }>;
  breadcrumbs: Array<{ label: string; href?: string }>;
}

const CONTENT: Record<SupportedLanguage, LocaleRecallContent> = {
  en: {} as any,
  es: {
    pageTitle: "Escáner de Código de Barras y Retiradas de Productos | Alertas FDA y CPSC | IsItKitchenSafe",
    pageDescription: "Consulta retiradas oficiales de seguridad para freidoras de aire, vasos con plomo, cuchillas rotas de batidoras y ollas a presión mediante código de barras o modelo.",
    badge: "Diagnóstico de Seguridad Oficial • Registro CPSC y FDA",
    h1: "Escáner de Código de Barras y Retiradas de Productos",
    heroSub: "Comprueba si tus freidoras de aire, batidoras, ollas y vajillas tienen una retirada activa de seguridad por riesgo de incendio, intoxicación por plomo o explosión de vapor.",
    standardsTitle: "Cómo Funcionan las Retiradas Oficiales de Seguridad",
    standardsIntro: "Bajo la legislación internacional de seguridad del consumidor, los fabricantes están obligados a retirar productos ante fallos de diseño graves:",
    agencies: [
      { label: "CPSC", name: "Comisión de Seguridad de Productos (EE. UU.)", desc: "Supervisa electrodomésticos, freidoras de aire, batidoras, cuchillos y vajilla infantil." },
      { label: "FDA", name: "Administración de Alimentos y Medicamentos", desc: "Regula materiales en contacto con alimentos y límites de migración de plomo y cadmio." },
      { label: "HC", name: "Health Canada (Canadá)", desc: "Coordina retiradas conjuntas para evitar la circulación transfronteriza de artículos defectuosos." },
      { label: "EU", name: "RAPEX Safety Gate (Europa)", desc: "Red europea de alerta rápida para contaminantes tóxicos y artículos de cocina peligrosos." }
    ],
    faqs: [
      {
        question: "¿Cómo localizo el código de barras o modelo de mi electrodoméstico?",
        answer: "En la base inferior de freidoras, batidoras y ollas encontrarás una placa adhesiva plateada con el modelo exacto. El código de barras UPC de 12 dígitos figura en la caja original o etiqueta comercial."
      },
      {
        question: "¿Qué debo hacer si mi producto tiene una retirada activa?",
        answer: "Deja de usarlo inmediatamente y desenchúfalo. No intentes repararlo ni lo lleves a tiendas normales. Sigue las instrucciones del fabricante para recibir un reemplazo o reembolso gratuito."
      },
      {
        question: "¿Por qué se retiran tazas de cerámica por plomo?",
        answer: "La cerámica artesanal cocida a baja temperatura suele usar esmaltes con plomo. Al poner café o alimentos ácidos calientes, el esmalte se descompone y libera plomo neurotóxico."
      },
      {
        question: "¿Las freidoras de aire pueden provocar incendios?",
        answer: "Sí. Retiradas masivas como las de Cosori e Insignia afectaron a millones de unidades debido a conectores eléctricos defectuosos que se sobrecalentaban hasta fundir el plástico."
      }
    ],
    breadcrumbs: [
      { label: "Inicio", href: "/es/" },
      { label: "Herramientas", href: "/es/tools/" },
      { label: "Escáner de Retiradas" }
    ]
  },
  pt: {
    pageTitle: "Scanner de Códigos de Barras e Recalls de Produtos | Alertas FDA e CPSC | IsItKitchenSafe",
    pageDescription: "Consulte recalls de segurança para air fryers, copos com chumbo, lâminas quebradas de liquidificadores e panelas de pressão via código de barras ou modelo.",
    badge: "Diagnóstico Oficial de Segurança • Registros CPSC e FDA",
    h1: "Scanner de Códigos de Barras e Recalls de Produtos",
    heroSub: "Verifique se suas fritadeiras elétricas, liquidificadores e panelas possuem recall oficial ativo por risco de incêndio, contaminação por chumbo ou explosão de vapor.",
    standardsTitle: "Como Funcionam os Recalls de Utensílios de Cozinha",
    standardsIntro: "Normas de proteção ao consumidor exigem a retirada imediata de produtos que apresentem riscos graves à vida e à saúde:",
    agencies: [
      { label: "CPSC", name: "Comissão de Segurança de Produtos (EUA)", desc: "Regulamenta eletroportáteis, air fryers, liquidificadores, facas e louças infantis." },
      { label: "FDA", name: "Administração de Alimentos e Medicamentos", desc: "Controla substâncias em contato com alimentos e limites de liberação de chumbo e cádmio." },
      { label: "HC", name: "Health Canada", desc: "Atua em conjunto na fiscalização para evitar a circulação de produtos defeituosos na América do Norte." },
      { label: "EU", name: "RAPEX Safety Gate (Europa)", desc: "Sistema de alerta rápido da União Europeia para substâncias químicas tóxicas e falhas mecânicas." }
    ],
    faqs: [
      {
        question: "Como encontrar o código de barras ou modelo do produto?",
        answer: "Na parte inferior de fritadeiras e panelas elétricas existe uma etiqueta prateada com o modelo e número de série. O código de barras UPC de 12 dígitos fica na caixa original."
      },
      {
        question: "O que fazer se o meu produto estiver sob recall?",
        answer: "Descontinue o uso imediatamente e tire o aparelho da tomada. Siga as orientações do fabricante para receber um reparo ou substituição totalmente gratuita."
      },
      {
        question: "Por que canecas de cerâmica soltam chumbo?",
        answer: "Cerâmicas decoradas artesanalmente e queimadas em baixa temperatura utilizam esmaltes à base de chumbo, que migram para o café quente ou alimentos ácidos."
      },
      {
        question: "Panelas de pressão podem explodir a tampa?",
        answer: "Sim. Falhas no mecanismo de trava permitiram a abertura inadvertida sob pressão em modelos populares, provocando queimaduras graves por líquidos ferventes."
      }
    ],
    breadcrumbs: [
      { label: "Início", href: "/pt/" },
      { label: "Ferramentas", href: "/pt/tools/" },
      { label: "Scanner de Recalls" }
    ]
  },
  'zh-cn': {
    pageTitle: "产品条形码与召回安全查询检测仪 | CPSC 与 FDA 权威公文库 | IsItKitchenSafe",
    pageDescription: "通过扫描条形码或输入产品型号，秒级核查美国 CPSC、FDA 与各大卫生机构缺陷召回名录：空气炸锅起火隐患、水杯铅超标、料理机刀片断裂及压力锅自爆排查。",
    badge: "权威官方召回排查 • 消防与卫生安全",
    h1: "产品条形码与官方召回查询检测仪",
    heroSub: "排查您的空气炸锅、破壁料理机、压力锅与餐具是否存在因严重设计缺陷、起火自燃、铅重金属溶出或压力爆炸导致的官方召回。",
    standardsTitle: "厨房用品缺陷召回法定监管标准",
    standardsIntro: "根据国际消费品安全法案，存在重大致伤隐患的厨具与家电必须实施强制召回与全额补偿：",
    agencies: [
      { label: "CPSC", name: "美国消费品安全委员会", desc: "监管空气炸锅、料理机、电饭煲、菜刀及儿童塑料餐具等家庭用品。" },
      { label: "FDA", name: "美国食品药品监督管理局", desc: "严密管控食品接触材料（21 CFR）与陶瓷釉料剧毒铅、镉重金属溶出限量。" },
      { label: "HC", name: "加拿大卫生部 (Health Canada)", desc: "跨国联合调查监管北美供应链，封堵缺陷厨房产品跨境流通。" },
      { label: "EU", name: "欧盟 RAPEX 快速预警系统", desc: "全欧洲互联快报网络，严查低温陶器与不粘涂层中有毒化学品迁移。" }
    ],
    faqs: [
      {
        question: "如何查找厨具电器的具体型号与 12 位条形码？",
        answer: "电器的机身底部均贴有银色或白色电气参数铭牌，标有明确的 Model（型号）；12 位 UPC 条形码通常印在产品外包装盒或合格证标签上。"
      },
      {
        question: "如果我的厨具属于召回批次，应该如何处置？",
        answer: "请立即停止使用并拔下电源插头。切勿自行尝试拆卸维修。联系品牌官方召回通道，按要求拍照或剪断电源线后申请官方免费换新或全额退款。"
      },
      {
        question: "为什么很多复古马克杯和彩绘陶瓷被查出铅中毒风险？",
        answer: "低温烧制的民间陶器常采用铅化合物作为低温助熔釉料。接触热咖啡、红茶或番茄浓汤时，酸热环境会溶解釉面，使剧毒重金属铅和镉析出到汤水中。"
      },
      {
        question: "空气炸锅真的会发生爆燃着火事故吗？",
        answer: "会。Cosori 与 Insignia 等品牌召回涉及数百万台机器，根本原因在于内部电线压接端子在高温大功率（1500W-1800W）下异常过热，烧熔外壳引发明火。"
      }
    ],
    breadcrumbs: [
      { label: "首页", href: "/zh-cn/" },
      { label: "实用工具", href: "/zh-cn/tools/" },
      { label: "产品召回检测仪" }
    ]
  },
  ja: {
    pageTitle: "バーコード＆製品パッケージ リコール診断スキャナー | 米FDA・CPSC 公式情報 | IsItKitchenSafe",
    pageDescription: "バーコードや型番から米CPSC・FDAの公式リコール情報を瞬時に照会。ノンフライヤーの火災、鉛含有タンブラー、ミキサー刃の破損、圧力鍋の蓋外れ事故を防止。",
    badge: "公式リコール照会診断 • 消防・生命安全",
    h1: "バーコード＆製品リコール診断スキャナー",
    heroSub: "ノンフライヤー、ブレンダー、圧力鍋、食器類が、火災の危険や鉛溶出、刃の破損などで公式リコール対象になっていないかバーコードから瞬時に検証できます。",
    standardsTitle: "調理器具における法的リコール基準",
    standardsIntro: "重大な安全上の欠陥や火災・中毒リスクが確認された製品は、法に基づき直ちに無償回収・交換が行われます：",
    agencies: [
      { label: "CPSC", name: "米国消費者製品安全委員会", desc: "ノンフライヤー、ミキサー、包丁、調理家電、子供用食器の安全基準を統括。" },
      { label: "FDA", name: "米国食品医薬品局", desc: "食品接触物質の安全性規格および陶磁器からの鉛・カドミウム溶出基準を管理。" },
      { label: "HC", name: "カナダ保健省 (Health Canada)", desc: "北米市場全体でリコール情報を連動させ、欠陥製品の流通を防止。" },
      { label: "EU", name: "EU RAPEX 安全警告ゲート", desc: "欧州全域で有害化学物質の移行や危険な調理器具を監視・公表。" }
    ],
    faqs: [
      {
        question: "製品の型番や12桁バーコードはどこで確認できますか？",
        answer: "調理家電の底面にある銀色定格プレートに「Model」として刻印されています。12桁のUPCバーコードは外箱や底面のシールに記載されています。"
      },
      {
        question: "リコール対象製品を持っていた場合はどうすればよいですか？",
        answer: "直ちに使用を中止し、電源プラグを抜いてください。メーカーの公式窓口へ連絡し、指示に従って無償交換品や返金の申請を行ってください。"
      },
      {
        question: "陶磁器のマグカップが鉛の危険で回収されるのはなぜですか？",
        answer: "低温焼成の伝統陶器では鉛を含む釉薬が使用されることがあり、熱いコーヒーや酸味のあるスープに触れると鉛が溶け出して体内に入り中毒を起こします。"
      },
      {
        question: "ノンフライヤーが本当に発火することはあるのですか？",
        answer: "はい。内部の電線圧着不良により高電力（1500W以上）で異常発熱し、プラスチック筐体が溶けて発火した事例が報告されています。"
      }
    ],
    breadcrumbs: [
      { label: "ホーム", href: `/${lang}/` },
      { label: "ツール", href: `/${lang}/tools/` },
      { label: "リコールスキャナー" }
    ]
  }
};

const c = CONTENT[lang];

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": c.h1,
  "url": `https://isitkitchensafe.com/${lang}/tools/product-recalls-scanner/`,
  "applicationCategory": "HealthApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "description": c.pageDescription,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};
---

<Layout title={c.pageTitle} description={c.pageDescription} faqs={c.faqs} availableLocales={availableLocales} lang={lang}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={c.breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1200px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-rose-600 text-white mb-3">
        {c.badge}
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        {c.h1}
      </h1>
      <p class="text-body text-[15px] md:text-body-md leading-relaxed">
        {c.heroSub}
      </p>
    </header>

    <!-- Main Scanner Tool Component -->
    <div class="mb-14">
      <ProductRecallsScanner lang={lang} />
    </div>

    <!-- Regulatory Recall Standards & Authority Section -->
    <section class="mb-14 border-t border-hairline pt-12 space-y-6">
      <div class="max-w-3xl">
        <span class="text-xs font-bold uppercase tracking-wider text-muted block mb-1">
          {lang === 'ja' ? '安全規格・法規制' : lang === 'zh-cn' ? '国际监管法规与消费安全' : 'Normas de Seguridad y Regulación'}
        </span>
        <h2 class="text-title-lg md:text-display-sm font-medium text-ink tracking-tight mb-3">
          {c.standardsTitle}
        </h2>
        <p class="text-body text-[15px] leading-relaxed mb-4">
          {c.standardsIntro}
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {c.agencies.map((item) => (
          <div class="p-5 rounded-xl bg-surface-soft border border-hairline space-y-2">
            <div class={`w-8 h-8 rounded-lg text-white font-bold flex items-center justify-center text-xs ${
              item.label === 'CPSC' ? 'bg-rose-600' :
              item.label === 'FDA' ? 'bg-blue-600' :
              item.label === 'HC' ? 'bg-emerald-700' : 'bg-amber-600'
            }`}>
              {item.label}
            </div>
            <h3 class="font-semibold text-ink text-sm">{item.name}</h3>
            <p class="text-xs text-body leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="border-t border-hairline pt-12">
      <h2 class="text-title-lg md:text-display-sm font-medium text-ink tracking-tight mb-8">
        {lang === 'ja' ? 'よくある質問' : lang === 'zh-cn' ? '常见问题与解答' : lang === 'pt' ? 'Perguntas Frequentes' : 'Preguntas Frecuentes'}
      </h2>
      <div class="space-y-6 max-w-3xl">
        {c.faqs.map(faq => (
          <div class="border-b border-hairline pb-6">
            <h3 class="text-base font-semibold text-ink mb-2">
              {faq.question}
            </h3>
            <p class="text-body text-sm leading-relaxed">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>
