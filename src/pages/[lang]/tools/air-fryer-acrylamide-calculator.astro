    monoSection1Body: "アクリルアミドは、食材中の遊離L-アスパラギンと還元糖が120℃以上で非酵素的に縮合・脱炭酸して生成されます。ノンフライヤーの高速表面脱水はこの反応を著しく加速します。",
    monoSection2Title: "生ジャガイモ冷蔵保存の生化学的リスク",
    monoSection2Body: "8℃以下の低温下ではジャガイモのインベルターゼ酵素がデンプンを加水分解し、還元糖プールを急増させます。これにより調理時のアクリルアミド生成量が2500 µg/kg以上に跳ね上がります。",
    monoSection3Title: "熱風対流と油中浸漬の熱力学的相違",
    monoSection3Body: "高速対流風は表面の蒸気層を吹き飛ばし水分活性を0.4未満へと急低下させます。温度を170℃（340°F）以下に抑えることでアレニウス反応速度定数を制御し、サクサク感を維持できます。",
    monoSection4Title: "水浸漬洗浄および酸性ブロックプロトコル",
    monoSection4Body: "冷水に30分浸漬することで表面の可溶性前駆物質を40%以上溶出できます。少量の食酢を加えるとアスパラギンのアミノ基がプロトン化され、初期の縮合反応を化学的に遮断します。"
  }
};

const c = CONTENT[lang];

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": c.pageTitle,
  "url": `https://isitkitchensafe.com/${lang}/tools/air-fryer-acrylamide-calculator/`,
  "applicationCategory": "HealthApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "description": c.pageDescription,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};
---

<Layout title={c.pageTitle} description={c.pageDescription} faqs={c.faqs} availableLocales={availableLocales}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />

  <main class="container mx-auto px-4 py-8 max-w-5xl space-y-8">
    <Breadcrumbs items={c.breadcrumbs} />

    <AirFryerAcrylamideCalculator lang={lang} />

    <!-- Scientific In-Depth Monograph Section -->
    <section class="bg-surface-soft border border-hairline rounded-3xl p-6 md:p-10 space-y-8">
      <div class="border-b border-hairline pb-4">
        <span class="text-xs font-bold uppercase tracking-wider text-amber-800 dark:text-amber-400 block mb-1">
          {c.monoBadge}
        </span>
        <h2 class="text-title-lg font-bold text-ink tracking-tight">
          {c.monoTitle}
        </h2>
        <p class="text-xs md:text-sm text-body leading-relaxed mt-2">
          {c.monoSub}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-xs md:text-sm text-body leading-relaxed">
        <div class="space-y-4">
          <h3 class="text-sm md:text-base font-bold text-ink flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-amber-500"></span>
            {c.monoSection1Title}
          </h3>
          <p>{c.monoSection1Body}</p>
        </div>

        <div class="space-y-4">
          <h3 class="text-sm md:text-base font-bold text-ink flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-rose-500"></span>
            {c.monoSection2Title}
          </h3>
          <p>{c.monoSection2Body}</p>
        </div>

        <div class="space-y-4">
          <h3 class="text-sm md:text-base font-bold text-ink flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-indigo-500"></span>
            {c.monoSection3Title}
          </h3>
          <p>{c.monoSection3Body}</p>
        </div>

        <div class="space-y-4">
          <h3 class="text-sm md:text-base font-bold text-ink flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            {c.monoSection4Title}
          </h3>
          <p>{c.monoSection4Body}</p>
        </div>
      </div>
    </section>
  </main>
</Layout>
