    methodologyLabel: "検証メソドロジー",
    chartHeaders: ["部位・重量の例", "冷蔵庫 (4°C以下)", "冷水解凍", "解凍後の冷蔵期限", "安全な中心温度"],
    chartRows: [
      { cut: "七面鳥 丸ごと (16 lb / 7.3 kg)", fridge: "3〜4日 (4–5lb毎24h)", coldWater: "約8時間 (30分/lb)", postThaw: "1〜2日", temp: "74°C (165°F)" },
      { cut: "丸鶏 (5 lb / 2.3 kg)", fridge: "24〜30時間", coldWater: "約2.5時間", postThaw: "1〜2日", temp: "74°C (165°F)" },
      { cut: "骨なし鶏むね/もも (2 lb / 0.9 kg)", fridge: "24時間", coldWater: "約1〜1.5時間", postThaw: "1〜2日", temp: "74°C (165°F)" },
      { cut: "牛・豚 塊肉 (4 lb / 1.8 kg)", fridge: "24〜26時間", coldWater: "約2時間", postThaw: "3〜5日", temp: "63°C＋3分休ませ" },
      { cut: "ひき肉 (2 lb / 0.9 kg)", fridge: "24時間", coldWater: "約1〜1.5時間", postThaw: "1〜2日", temp: "牛豚71°C・鶏74°C" },
      { cut: "骨付き生ハム塊 (10 lb / 4.5 kg)", fridge: "2〜2.5日 (4–6h/lb)", coldWater: "約5時間", postThaw: "3〜5日", temp: "63°C＋3分休ませ" },
      { cut: "魚切り身・エビ (1.5 lb / 0.7 kg)", fridge: "12〜18時間 (真空開封!)", coldWater: "約45分", postThaw: "1〜2日", temp: "63°C (145°F)" }
    ],
    relatedToolTag: "関連インタラクティブツール",
    relatedLeftoverTitle: "USDA 残り物・冷蔵庫日持ちカウントダウン計算機 →",
    relatedLeftoverDesc: "調理後のローストや鶏肉の保存期限（3〜4日）や2時間ルール、再加熱温度をチェックできます。",
    relatedDirTag: "食品衛生ディレクトリ",
    relatedRefreezeTitle: "解凍した肉・魚・料理は再冷凍できる？ →",
    relatedRefreezeDesc: "USDA基準に基づき、食材ごとの安全な再冷凍条件と注意点を一覧で確認できます。",
    hubsTitle: "冷凍・冷蔵・再冷凍の検証済みガイドを見る",
    hubsDesc: "冷凍庫の保存容器チェック、冷蔵庫の温度管理、日持ち一覧へ移動できます。",
    hubLabels: {
      freezer: "冷凍庫ガイド",
      refrigerator: "冷蔵庫ガイド",
      refreeze: "再冷凍できる？",
      howLong: "食品の日持ち一覧",
      methodology: "メソドロジー",
      allTools: "全ツール一覧 →"
    },
    faqTitle: "肉の安全な解凍に関するよくある質問",
    faqs: [
      {
        question: "冷凍の七面鳥を冷蔵庫で解凍するには何日かかりますか？",
        answer: "USDA FSIS の基準では、4°C（40°F）以下の冷蔵庫で4〜5ポンド（約1.8〜2.3kg）あたり24時間が目安です。たとえば16ポンド（約7.3kg）の七面鳥は3〜4日かかります。冷蔵庫で完全解凍した後は、さらに1〜2日間冷蔵保存してから調理できます。"
      },
      {
        question: "なぜ常温（キッチンの作業台）やぬるま湯で肉を解凍してはいけないのですか？",
        answer: "肉の中心がまだ凍っていても、外側の表面は2時間以内に4°Cを超え、細菌が急増殖する危険温度帯（4°C〜60°C）に入ります。サルモネラ菌や腸管出血性大腸菌、黄色ブドウ球菌が表面で急増し、加熱しても壊れない耐熱性毒素が生成される危険があります。"
      },
      {
        question: "USDA推奨の冷水解凍の正しい手順は？",
        answer: "水漏れしない密閉ジッパー袋に肉を入れ、冷たい水道水に完全に浸します（ぬるま湯やお湯は厳禁）。1ポンドあたり約30分を目安とし、水温が上がらないよう30分ごとに必ず新しい冷水に全量交換してください。冷水解凍した肉は直ちに加熱調理する必要があります。"
      },
      {
        question: "真空パックの魚はなぜ解凍前に必ず開封しなければならないのですか？",
        answer: "真空パック（脱酸素包装）は無酸素環境を作るため、袋を閉じたまま解凍すると冷蔵庫内の低温でも嫌気性のボツリヌス菌（Clostridium botulinum）が増殖し、無臭・無味のまま猛毒のボツリヌス毒素を生成するリスクがあります。解凍前に必ず袋を切るか中身を出してください。"
      },
      {
        question: "解凍した肉は再冷凍できますか？また凍ったまま調理しても安全ですか？",
        answer: "条件を守ればどちらも可能です。冷蔵庫（4°C以下）で解凍した生肉は、加熱前でも安全に再冷凍できます（品質・食感はやや低下）。冷水や電子レンジで解凍した場合は、一度加熱調理してから冷凍してください。また、オーブン・フライパン・圧力鍋なら凍ったまま調理可能（通常の+50%の加熱時間）ですが、スロークッカーでの冷凍生肉調理は厳禁です。"
      }
    ],
    breadcrumbs: [
      { label: "ホーム", href: "/ja/" },
      { label: "ツール", href: "/ja/tools/" },
      { label: "肉・七面鳥 解凍時間計算ツール" }
    ]
  }
};

const c = CONTENT[lang as Exclude<SupportedLanguage, 'en'>] || CONTENT.es;
const localizedUrl = `https://isitkitchensafe.com/${lang}/tools/meat-thawing-calculator/`;

const freezerUrl = getApplianceUrl('freezer', lang);
const refrigeratorUrl = getApplianceUrl('refrigerator', lang);
const refreezeUrl = getDirectoryUrl('refreeze', lang);
const howLongUrl = getDirectoryUrl('how-long', lang);
const toolsUrl = getDirectoryUrl('tools', lang);
const leftoverCalcUrl = `/${lang}/tools/leftover-shelf-life-calculator/`;

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": c.h1,
  "url": localizedUrl,
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript.",
  "description": c.pageDescription,
  "inLanguage": lang === 'zh-cn' ? 'zh-CN' : lang,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": c.faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={c.pageTitle}
  description={c.pageDescription}
  excludeFaqSchema={true}
  availableLocales={availableLocales}
  lang={lang}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={c.breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1140px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-signature-coral text-white mb-3">
        {c.badge}
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        {c.h1}
      </h1>
      <p class="text-body text-[15px] md:text-[16px] leading-relaxed">
        {c.heroSub}
      </p>
    </header>

    <!-- Main Interactive Calculator -->
    <div class="mb-14">
      <MeatThawingCalculator lang={lang} />
    </div>

    <!-- USDA Safe Thawing Quick Reference Chart -->
    <section class="mb-14 space-y-5">
      <div>
        <h2 class="text-title-lg font-medium text-ink tracking-tight mb-2">
          {c.chartTitle}
        </h2>
        <p class="text-body text-[14.5px] leading-relaxed">
          {c.chartIntro} <a href="/methodology/" class="text-link underline hover:text-link-active">{c.methodologyLabel}</a>.
        </p>
      </div>

      <div class="border border-hairline rounded-xl overflow-hidden bg-canvas">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="bg-surface-strong border-b border-hairline text-ink font-semibold">
              <tr>
                <th class="p-3.5">{c.chartHeaders[0]}</th>
                <th class="p-3.5">{c.chartHeaders[1]}</th>
                <th class="p-3.5">{c.chartHeaders[2]}</th>
                <th class="p-3.5">{c.chartHeaders[3]}</th>
                <th class="p-3.5">{c.chartHeaders[4]}</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-hairline">
              {c.chartRows.map((row, idx) => (
                <tr class={idx % 2 === 0 ? 'bg-canvas' : 'bg-surface-soft'}>
                  <td class="p-3.5 font-semibold text-ink whitespace-nowrap">{row.cut}</td>
                  <td class="p-3.5 text-body whitespace-nowrap font-medium">{row.fridge}</td>
                  <td class="p-3.5 text-body whitespace-nowrap">{row.coldWater}</td>
                  <td class="p-3.5 text-body whitespace-nowrap">{row.postThaw}</td>
                  <td class="p-3.5 text-body text-[13px] whitespace-nowrap">{row.temp}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Related Tools & Storage Guides -->
    <section class="mb-14 grid grid-cols-1 md:grid-cols-2 gap-5">
      <a
        href={leftoverCalcUrl}
        class="p-6 rounded-2xl bg-surface-soft border border-hairline hover:border-signature-coral transition-all group block"
      >
        <span class="text-[11px] font-bold uppercase tracking-wider text-signature-coral block mb-1.5">
          {c.relatedToolTag}
        </span>
        <h3 class="text-title-sm font-semibold text-ink group-hover:text-signature-coral transition-colors mb-1.5">
          {c.relatedLeftoverTitle}
        </h3>
        <p class="text-[13.5px] text-body leading-relaxed">
          {c.relatedLeftoverDesc}
        </p>
      </a>

      <a
        href={refreezeUrl}
        class="p-6 rounded-2xl bg-surface-soft border border-hairline hover:border-signature-coral transition-all group block"
      >
        <span class="text-[11px] font-bold uppercase tracking-wider text-signature-coral block mb-1.5">
          {c.relatedDirTag}
        </span>
        <h3 class="text-title-sm font-semibold text-ink group-hover:text-signature-coral transition-colors mb-1.5">
          {c.relatedRefreezeTitle}
        </h3>
        <p class="text-[13.5px] text-body leading-relaxed">
          {c.relatedRefreezeDesc}
        </p>
      </a>
    </section>

    <!-- Core Storage Hub Strip -->
    <section class="mb-14 p-6 rounded-2xl bg-surface-soft border border-hairline">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <h2 class="text-title-sm font-semibold text-ink mb-1">
            {c.hubsTitle}
          </h2>
          <p class="text-[13px] text-muted">
            {c.hubsDesc}
          </p>
        </div>
        <div class="flex flex-wrap gap-2">
          <a href={freezerUrl} class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral transition-colors">{c.hubLabels.freezer}</a>
          <a href={refrigeratorUrl} class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral transition-colors">{c.hubLabels.refrigerator}</a>
          <a href={refreezeUrl} class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral transition-colors">{c.hubLabels.refreeze}</a>
          <a href={howLongUrl} class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral transition-colors">{c.hubLabels.howLong}</a>
          <a href="/methodology/" class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral transition-colors">{c.hubLabels.methodology}</a>
          <a href={toolsUrl} class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-primary text-on-primary hover:bg-primary-active transition-colors">{c.hubLabels.allTools}</a>
        </div>
      </div>
    </section>

    <!-- FAQ Section (5 Consumer-Friendly FAQs) -->
    <section class="mb-8">
      <h2 class="text-title-lg font-medium text-ink tracking-tight mb-6">
        {c.faqTitle}
      </h2>
      <div class="space-y-4">
        {c.faqs.map((faq) => (
          <details class="group p-5 bg-surface-soft border border-hairline rounded-xl" open>
            <summary class="text-title-sm font-semibold text-ink cursor-pointer list-none flex items-center justify-between gap-3">
              <span>{faq.question}</span>
              <span class="text-muted text-sm transition-transform group-open:rotate-180 shrink-0" aria-hidden="true">&#9662;</span>
            </summary>
            <p class="text-[14px] text-body leading-relaxed mt-3 pt-3 border-t border-hairline/70">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </div>
</Layout>
