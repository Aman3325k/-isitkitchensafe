      {
        question: "对称双极性方波脉冲如何杜绝电极金属毒性溶出到饮料物料中？",
        answer: "高压电流通过金属电极（如钛或不锈钢）与电解质丰富的食品流时，阳极会发生法拉第电化学氧化（Ti → Ti⁴⁺ + 4e⁻），导致阳极电解溶损并将金属离子释放入食品中。若采用单极性脉冲，每次脉冲都会在电极界面累积净电荷。对称双极性方波在1至3微秒内极速反转极性且无直流偏置，反向脉冲能立即中和双电层电容，使法拉第电荷转移抑制98%以上，将金属迁移量牢牢控制在EFSA和FDA严格限制的15 µg/L以下。"
      },
      {
        question: "为何细菌芽孢（如蜡样芽孢杆菌芽孢）能够抵御单一脉冲电场的作用？",
        answer: "细菌芽孢专为极端耐受而演化。它们拥有致密的角蛋白多层外壳、坚硬的肽聚糖皮层、高度脱水的内核（水分活性 aw < 0.30）以及仅约0.5 µm的微小有效半径。施万公式表明感应跨膜电位与细胞半径成正比，因此芽孢承受的电应力远低于体积庞大的营养体细菌或酵母菌。此外，脱水内核缺乏自由移动离子，无法产生渗透压破裂。灭活细菌芽孢必须依靠栅栏技术（Hurdle Technology），将PEF与温和预热（55°C至65°C）相结合，促使芽孢萌发软化后再行电穿孔灭活。"
      }
    ]
  }
};

const c = CONTENT[lang as Exclude<SupportedLanguage, 'en'>];

const breadcrumbs = [
  { label: t('nav.home') || 'Home', href: tp('/') },
  { label: t('nav.tools') || 'Tools', href: tp('/tools/') },
  { label: c.breadcrumbsLabel }
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": `https://isitkitchensafe.com${Astro.url.pathname}#webapp`,
      "url": `https://isitkitchensafe.com${Astro.url.pathname}`,
      "name": c.h1,
      "applicationCategory": "EngineeringApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5 Canvas/CSS3.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": c.pageDescription
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://isitkitchensafe.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Tools",
          "item": `https://isitkitchensafe.com${tp('/tools/')}`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": c.breadcrumbsLabel,
          "item": `https://isitkitchensafe.com${Astro.url.pathname}`
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": c.faqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
};
---

<Layout
  title={c.pageTitle}
  description={c.pageDescription}
  structuredData={structuredData}
>
  <div class="max-w-6xl mx-auto px-4 py-8">
    <Breadcrumbs items={breadcrumbs} />

    <header class="mb-8">
      <div class="flex items-center gap-2 mb-3">
        <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-purple-700 text-white">
          {c.badge}
        </span>
        <span class="text-xs text-muted font-mono">FDA 21 CFR § 120 • 3-A 63-04 • EHEDG Doc 35</span>
      </div>
      <h1 class="text-display-sm md:text-display-md font-bold text-ink tracking-tight mb-4">
        {c.h1}
      </h1>
      <p class="text-body-lg text-muted max-w-4xl leading-relaxed">
        {c.lead}
      </p>
    </header>

    <!-- Interactive Simulator Component -->
    <CommercialPefElectroporationModeler lang={lang} />

    <!-- FAQ Section with Schema-Compliant Formatting -->
    <section class="my-16 border-t border-hairline pt-12">
      <h2 class="text-title-lg font-bold text-ink mb-6">
        {lang === 'es' ? 'Preguntas Frecuentes: Seguridad en Procesamiento PEF de Alto Voltaje' :
         lang === 'pt' ? 'Perguntas Frequentes: Segurança em Processamento PEF de Alta Tensão' :
         lang === 'ja' ? 'よくある質問：連続高圧PEF殺菌・エレクトロポレーションの安全性' :
         '常见问题：连续高压脉冲电场（PEF）灭菌与安全规范'}
      </h2>
      <div class="space-y-6">
        {c.faqs.map(faq => (
          <div class="p-6 rounded-2xl bg-surface-soft border border-hairline">
            <h3 class="text-title-sm font-semibold text-ink mb-2">
              {faq.question}
            </h3>
            <p class="text-body text-sm text-muted leading-relaxed">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>
