        question: "なぜASME規格はクイック開閉蓋に機械的ポジティブインターロックピンを義務付けているのですか？",
        answer: "工業用抽出釜はバスケットの迅速な装填のため油圧クランプ式や中断ネジ式（ブリーチロック）のクイック開閉機構を採用しています。仮に釜内にわずか1.0 bar（14.5 psi）の残圧があった場合でも、内径300 mmの蓋には7,000 N（約700 kgf以上）の巨大な油圧推力が作用しています。この状態で蓋を開放すると鋼製プラグが砲弾のように射出され人命に関わる惨事となります。ASME Section VIII付録24およびOSHA 1910.119に基づき、内圧が0.35 bar（5 psi）以下に低下するまで物理的に開閉機構をロックするインターロックピンの設置が義務付けられています。"
      },
      {
        question: "エタノール等の極性助溶媒（モディファイア）は冶金材質とシール寿命にどう影響しますか？",
        answer: "純粋な超臨界CO2は無極性溶媒です。ポリフェノールやクルクミノイドなどの極性成分を抽出するため、工業プラントでは3%〜10%の食品グレードエタノールを助溶媒として共注入します。エタノールは一般ゴムを可塑化させ、標準フッ素ゴムの膨張率を3倍に高めて劣化を早めます。さらに残留水分と高圧CO2の共存により弱酸性の炭酸（pH ≈ 3.0〜3.5）が生成され、溶接熱影響部での応力腐食割れ（SCC）のリスクを高めます。このため助溶媒対応容器では316L、2205複相鋼、またはハステロイ接液部とスプリング作動PTFEシールの採用が必須です。"
      }
    ]
  }
};

const c = CONTENT[lang as Exclude<SupportedLanguage, 'en'>];

const breadcrumbs = [
  { label: t('nav.home'), href: tp('/') },
  { label: t('nav.tools'), href: tp('/tools/') },
  { label: c.breadcrumbsLabel }
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": `https://isitkitchensafe.com/${lang}/tools/commercial-supercritical-co2-extractor-modeler/#webapp`,
      "url": `https://isitkitchensafe.com/${lang}/tools/commercial-supercritical-co2-extractor-modeler/`,
      "name": c.h1,
      "applicationCategory": "EngineeringApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5 Canvas/CSS3.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": c.pageDescription
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": t('nav.home'),
          "item": `https://isitkitchensafe.com${tp('/')}`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": t('nav.tools'),
          "item": `https://isitkitchensafe.com${tp('/tools/')}`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": c.breadcrumbsLabel,
          "item": `https://isitkitchensafe.com/${lang}/tools/commercial-supercritical-co2-extractor-modeler/`
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": c.faqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
};
---

<Layout 
  title={c.pageTitle}
  description={c.pageDescription}
  structuredData={structuredData}
>
  <main class="max-w-5xl mx-auto px-4 sm:px-6 py-8">
    <Breadcrumbs items={breadcrumbs} />

    <div class="mb-6">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-ink tracking-tight mb-3">
        {c.h1}
      </h1>
      <p class="text-base sm:text-lg text-muted max-w-3xl leading-relaxed">
        {c.lead}
      </p>
    </div>

    <CommercialSupercriticalCo2ExtractorModeler lang={lang} />

    <section class="mt-12 border-t border-hairline pt-8">
      <h2 class="text-2xl font-bold text-ink mb-6">Frequently Asked Engineering Questions</h2>
      <div class="space-y-6">
        {c.faqs.map(faq => (
          <div class="bg-surface-soft p-5 sm:p-6 rounded-xl border border-hairline">
            <h3 class="text-base sm:text-lg font-bold text-ink mb-2">{faq.question}</h3>
            <p class="text-sm text-muted leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </section>
  </main>
</Layout>
