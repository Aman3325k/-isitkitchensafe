      {
        question: "電子レンジで水やお茶を温める際の「突沸」とは？どう防げますか？",
        answer: "滑らかなガラスや陶器のマグカップで水を温めると、気泡の核がないため100°Cを超えても沸騰しない過熱状態（スーパーヒーティング）になることがあります。取り出した瞬間やティーバッグ・スプーンを入れた拍子に爆発的に噴き出し火傷する危険があるため、加熱前に電子レンジ対応の木製マドラーや竹串・割り箸を1本入れ、加熱後は30秒待ってから取り出してください。"
      },
      {
        question: "加熱時間が長くなるとき、絶対に電子レンジで使ってはいけない容器は？",
        answer: "発泡スチロール（#6 PS）容器は熱と油分で溶けスチレンが溶出するため厳禁です。また、アルミホイルや金縁の食器は火花（アーク放電）や発火を招き、完全に密閉した蓋付き容器は内部の蒸気圧で破裂する危険があります。耐熱ガラス（ホウケイ酸ガラス）、レンジ対応陶器、または蓋をずらした#5 PP（ポリプロピレン）容器を使用してください。"
      }
    ],
    breadcrumbs: [
      { label: "ホーム", href: "/ja/" },
      { label: "ツール", href: "/ja/tools/" },
      { label: "電子レンジワット数変換ツール" }
    ]
  }
};

const c = CONTENT[lang as Exclude<SupportedLanguage, 'en'>] || CONTENT.es;
const localizedUrl = `https://isitkitchensafe.com/${lang}/tools/microwave-wattage-converter/`;

const microwaveUrl = getApplianceUrl('microwave', lang);
const methodologyUrl = translatePath('/methodology/');
const toolsUrl = translatePath('/tools/');
const plasticUrl = translatePath('/tools/plastic-code-checker/');
const tempChartUrl = translatePath('/tools/internal-cooking-temp-chart/');
const eggSimUrl = translatePath('/tools/microwave-egg-explosion-simulator/');

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": c.h1,
  "url": localizedUrl,
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript.",
  "description": c.pageDescription,
  "inLanguage": lang === 'zh-cn' ? 'zh-CN' : lang,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": c.faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={c.pageTitle}
  description={c.pageDescription}
  excludeFaqSchema={true}
  availableLocales={availableLocales}
  lang={lang}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={c.breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1140px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-signature-coral text-white mb-3">
        {c.badge}
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        {c.h1}
      </h1>
      <p class="text-body text-[15px] md:text-[16px] leading-relaxed">
        {c.heroSub}
      </p>
    </header>

    <!-- Main Interactive Converter -->
    <div class="mb-14">
      <MicrowaveWattageConverter lang={lang} />
    </div>

    <!-- Related Verified Companion Tools -->
    <section class="mb-14 grid grid-cols-1 md:grid-cols-3 gap-5">
      <a
        href={plasticUrl}
        class="p-6 rounded-2xl bg-surface-soft border border-hairline hover:border-signature-coral transition-all group block"
      >
        <span class="text-[11px] font-bold uppercase tracking-wider text-signature-coral block mb-1.5">
          {c.relatedPlasticTag}
        </span>
        <h2 class="text-title-sm font-semibold text-ink group-hover:text-signature-coral transition-colors mb-1.5">
          {c.relatedPlasticTitle}
        </h2>
        <p class="text-[13.5px] text-body leading-relaxed">
          {c.relatedPlasticDesc}
        </p>
      </a>

      <a
        href={tempChartUrl}
        class="p-6 rounded-2xl bg-surface-soft border border-hairline hover:border-signature-coral transition-all group block"
      >
        <span class="text-[11px] font-bold uppercase tracking-wider text-signature-coral block mb-1.5">
          {c.relatedTempTag}
        </span>
        <h2 class="text-title-sm font-semibold text-ink group-hover:text-signature-coral transition-colors mb-1.5">
          {c.relatedTempTitle}
        </h2>
        <p class="text-[13.5px] text-body leading-relaxed">
          {c.relatedTempDesc}
        </p>
      </a>

      <a
        href={eggSimUrl}
        class="p-6 rounded-2xl bg-surface-soft border border-hairline hover:border-signature-coral transition-all group block"
      >
        <span class="text-[11px] font-bold uppercase tracking-wider text-signature-coral block mb-1.5">
          {c.relatedEggTag}
        </span>
        <h2 class="text-title-sm font-semibold text-ink group-hover:text-signature-coral transition-colors mb-1.5">
          {c.relatedEggTitle}
        </h2>
        <p class="text-[13.5px] text-body leading-relaxed">
          {c.relatedEggDesc}
        </p>
      </a>
    </section>

    <!-- Verified Appliance Hub & Methodology Strip -->
    <section class="mb-14 p-6 rounded-2xl bg-surface-soft border border-hairline">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <h2 class="text-title-sm font-semibold text-ink mb-1">
            {c.hubsTitle}
          </h2>
          <p class="text-[13px] text-muted">
            {c.hubsDescPrefix}{' '}
            <a href={methodologyUrl} class="text-link underline hover:text-link-active">{c.methodologyLabel}</a>.
          </p>
        </div>
        <div class="flex flex-wrap gap-2">
          <a href={microwaveUrl} class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral transition-colors">{c.hubLabels.microwave}</a>
          <a href={methodologyUrl} class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral transition-colors">{c.hubLabels.methodology}</a>
          <a href={toolsUrl} class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-primary text-on-primary hover:bg-primary-active transition-colors">{c.hubLabels.allTools}</a>
        </div>
      </div>
    </section>

    <!-- FAQ Section (5 Consumer FAQs) -->
    <section class="mb-8">
      <h2 class="text-title-lg font-medium text-ink tracking-tight mb-6">
        {c.faqTitle}
      </h2>
      <div class="space-y-4">
        {c.faqs.map((faq) => (
          <details class="group p-5 bg-surface-soft border border-hairline rounded-xl" open>
            <summary class="text-title-sm font-semibold text-ink cursor-pointer list-none flex items-center justify-between gap-3">
              <span>{faq.question}</span>
              <span class="text-muted text-sm transition-transform group-open:rotate-180 shrink-0" aria-hidden="true">&#9662;</span>
            </summary>
            <p class="text-[14px] text-body leading-relaxed mt-3 pt-3 border-t border-hairline/70">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </div>
</Layout>
