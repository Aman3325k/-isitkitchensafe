---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import OutdoorGrillBbqSafetyChecker from '../../../components/OutdoorGrillBbqSafetyChecker.astro';
import rawData from '../../../data/outdoor-grill-bbq-safety-data.json';
import type { SupportedLanguage } from '../../../i18n/ui';

export function getStaticPaths() {
  const availableLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'zh-cn', 'ja'];
  return [
    { params: { lang: 'es' }, props: { lang: 'es' as SupportedLanguage, availableLocales } },
    { params: { lang: 'pt' }, props: { lang: 'pt' as SupportedLanguage, availableLocales } },
    { params: { lang: 'zh-cn' }, props: { lang: 'zh-cn' as SupportedLanguage, availableLocales } },
    { params: { lang: 'ja' }, props: { lang: 'ja' as SupportedLanguage, availableLocales } }
  ];
}

interface Props {
  lang: SupportedLanguage;
  availableLocales: SupportedLanguage[];
}

const { lang, availableLocales } = Astro.props;

interface LocalePageContent {
  pageTitle: string;
  pageDescription: string;
  badge: string;
  h1: string;
  heroSub: string;
  breadcrumbs: Array<{ label: string; href?: string }>;
}

const CONTENT: Record<Exclude<SupportedLanguage, 'en'>, LocalePageContent> = {
  es: {
    pageTitle: "Verificador de Seguridad para Parrillas, Barbacoas, Ahumadores y Planchas | IsItKitchenSafe",
    pageDescription: "Verificador interactivo basado en CDC, NFPA y USDA: realiza la prueba de agua y jabón para fugas de propano, evita cerdas metálicas de cepillo, revisa distancias contra monóxido de carbono y consulta temperaturas seguras de carnes.",
    badge: "CDC Cerdas Metálicas · Protocolo NFPA · Temperaturas USDA · Prueba Fugas Gas",
    h1: "Verificador de Seguridad para Parrillas, Barbacoas y Ahumadores",
    heroSub: "Evita explosiones de gas propano, el peligro de perforación intestinal por cerdas metálicas de cepillos, intoxicaciones letales por monóxido de carbono y verifica temperaturas mínimas del USDA para carnes antes de encender el fuego.",
    breadcrumbs: [
      { label: "Inicio", href: "/es/" },
      { label: "Herramientas", href: "/es/tools/" },
      { label: "Seguridad de Barbacoas y Parrillas" }
    ]
  },
  pt: {
    pageTitle: "Verificador de Segurança para Churrasqueiras, Defumadores e Chapas a Gás | IsItKitchenSafe",
    pageDescription: "Verificador interativo baseado em CDC, NFPA e USDA: faça o teste de espuma de sabão no botijão de gás, evite perigo cirúrgico de cerdas de aço, garanta distância contra monóxido de carbono e confira temperaturas seguras de carnes.",
    badge: "Alerta Cerdas CDC · Protocolo NFPA · Temperaturas USDA · Teste Fugas Gás",
    h1: "Verificador de Segurança para Churrasqueiras e Grelhados",
    heroSub: "Evite explosões de gás propano, o risco cirúrgico de cerdas de arame soltas na carne, monóxido de carbono mortal em áreas fechadas e verifique temperaturas seguras do USDA para cada corte antes de acender o fogo.",
    breadcrumbs: [
      { label: "Início", href: "/pt/" },
      { label: "Ferramentas", href: "/pt/tools/" },
      { label: "Segurança de Churrasqueiras e Grelhas" }
    ]
  },
  'zh-cn': {
    pageTitle: "户外烧烤炉、烟熏箱与碳钢煎烤台安全核验器 | IsItKitchenSafe",
    pageDescription: "基于 CDC、NFPA 与 USDA 权威规范的户外烧烤安全核验工具：包含丙烷肥皂水发泡检漏、钢丝刷脱落误吞防范、一氧化碳室内禁令与 USDA 肉类核心杀菌温度核验。",
    badge: "CDC 钢丝刷警报 · NFPA 消防规范 · USDA 灭菌温度 · 丙烷肥皂水检漏",
    h1: "户外烧烤炉、烟熏设备与烤盘安全核验器",
    heroSub: "严防燃气爆燃事故、避免脱落钢丝误吞导致开腹手术急症、远离室内一氧化碳致命风险，开火前快速核对 USDA 肉类安全中心温度与 7 项点火前安全巡检。",
    breadcrumbs: [
      { label: "首页", href: "/zh-cn/" },
      { label: "安全工具", href: "/zh-cn/tools/" },
      { label: "户外烧烤与烟熏安全核验器" }
    ]
  },
  ja: {
    pageTitle: "屋外BBQグリル・燻製器・鉄板コンロ総合安全診断ツール | IsItKitchenSafe",
    pageDescription: "米国CDC、NFPA、USDA基準に基づく屋外BBQ安全チェッカー：プロパンガス石鹸水漏れ点検、金属ワイヤーブラシ毛抜け誤飲防止、一酸化碳中毒対策、USDA肉類加熱殺菌温度を網羅。",
    badge: "CDC ワイヤー誤飲警告 · NFPA 防火基準 · USDA 殺菌温度 · ガス漏れ石鹸水点検",
    h1: "屋外BBQグリル・燻製器・鉄板コンロ総合安全診断",
    heroSub: "ガス爆発事故の未然防止、金属ワイヤーブラシ抜け毛による消化管貫通誤飲の回避、密閉空間の一酸化炭素中毒防止、USDA安全中心温度を点火前にチェック。",
    breadcrumbs: [
      { label: "ホーム", href: "/ja/" },
      { label: "安全ツール", href: "/ja/tools/" },
      { label: "屋外BBQグリル安全診断" }
    ]
  }
};

const content = CONTENT[lang as Exclude<SupportedLanguage, 'en'>] || CONTENT.es;

const faqs = (rawData.faqs[lang as 'es' | 'pt' | 'zh-cn' | 'ja'] || rawData.faqs.en);

const canonicalUrl = `https://isitkitchensafe.com/${lang}/tools/outdoor-grill-bbq-safety-checker/`;

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": content.h1,
  "url": canonicalUrl,
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript.",
  "description": content.pageDescription,
  "inLanguage": lang,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq: any) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={content.pageTitle}
  description={content.pageDescription}
  faqs={faqs}
  excludeFaqSchema={true}
  availableLocales={availableLocales}
  lang={lang}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1 print:hidden">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={content.breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1140px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-signature-coral text-white mb-3">
        {content.badge}
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        {content.h1}
      </h1>
      <p class="text-body text-[15px] md:text-[16px] leading-relaxed">
        {content.heroSub}
      </p>
    </header>

    <!-- Main Interactive Checker Component -->
    <OutdoorGrillBbqSafetyChecker lang={lang} />
  </div>
</Layout>
