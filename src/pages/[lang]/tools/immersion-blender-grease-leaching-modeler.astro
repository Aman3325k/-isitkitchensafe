        </h2>
        <p class="text-sm md:text-base leading-relaxed text-muted mb-4">
          {c.section1Body}
        </p>
      </article>

      <!-- Section 2 -->
      <article>
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-4">
          {c.section2Title}
        </h2>
        <p class="text-sm md:text-base leading-relaxed text-muted mb-4">
          {c.section2Body}
        </p>
      </article>

      <!-- Section 3 -->
      <article>
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-4">
          {c.section3Title}
        </h2>
        <p class="text-sm md:text-base leading-relaxed text-muted mb-4">
          {c.section3Body}
        </p>
