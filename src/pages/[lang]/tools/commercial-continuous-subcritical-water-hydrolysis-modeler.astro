        answer: "当利用亚临界水水解富含碳水化合物的原料（如啤酒糟、苹果渣等）时，己糖在 200°C 以上容易发生脱水降解并生成 5-羟甲基糠醛（5-HMF），戊糖则易转化为糠醛，同时美拉德反应会加剧物料褐变。为确保最终产物中的 5-HMF 严格符合欧盟 EFSA 与美国 FDA 食品级安全阈值（< 25 mg/kg），系统采取三大工程核心措施：（1）严格限定含糖生物质反应区最高温度低于 205°C；（2）将塞流管内停留时间精细控制在 3 至 6 分钟；（3）反应器出口配备卫生级套管式骤冷换热器，在 15 秒内将物料由 > 180°C 急速降温至 60°C 以下，彻底冻结高温热降解动力学。"
      },
      {
        question: "ASME 规范第 VIII 卷安全泄放阀与陶瓷背压阀（BPR）的工程设计要点是什么？",
        answer: "由于亚临界水的工作温度远超常压沸点（200°C 时水的饱和蒸汽压 Psat = 15.5 bar，240°C 时为 33.4 bar），系统液压必须通过高压往复隔膜喂料泵与气动背压阀（BPR）维持在高于 Psat 至少 15 至 25 bar 的工况下。若工作压力意外跌落至 Psat 以下，管内物料将发生瞬时闪蒸，引发毁灭性的声学空化腐蚀与管路水锤。BPR 节流阀芯选用碳化钨或碳化硅陶瓷材质，并集成自动高压脉冲反冲洗机构以防颗粒堵塞。作为首要安全防线，系统装配有符合 ASME BPVC Section VIII Division 1 认证的全流量卫生级安全泄放阀（整定压力为设计压力的 110%），后端串联因科镍（Inconel）爆破片并连通至常压安全淬冷泄放罐。"
      }
    ]
  }
};

const c = CONTENT[lang as Exclude<SupportedLanguage, 'en'>] || CONTENT.es;

const breadcrumbs = [
  { label: t('nav.home') || 'Home', href: tp('/') },
  { label: t('nav.tools') || 'Tools', href: tp('/tools/') },
  { label: c.breadcrumbsLabel }
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": `https://isitkitchensafe.com${tp(`/tools/commercial-continuous-subcritical-water-hydrolysis-modeler/`)}#webapp`,
      "url": `https://isitkitchensafe.com${tp(`/tools/commercial-continuous-subcritical-water-hydrolysis-modeler/`)}`,
      "name": c.pageTitle.split('|')[0].trim(),
      "applicationCategory": "EngineeringApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5 Canvas/CSS3.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": c.pageDescription
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": t('nav.home') || "Home",
          "item": `https://isitkitchensafe.com${tp('/')}`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": t('nav.tools') || "Tools",
          "item": `https://isitkitchensafe.com${tp('/tools/')}`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": c.breadcrumbsLabel,
          "item": `https://isitkitchensafe.com${tp(`/tools/commercial-continuous-subcritical-water-hydrolysis-modeler/`)}`
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": c.faqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
};
---

<Layout title={c.pageTitle} description={c.pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <div class="max-w-6xl mx-auto px-4 py-4">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <CommercialContinuousSubcriticalWaterHydrolysisModeler lang={lang} />

  <!-- Detailed Engineering FAQs Section -->
  <section class="max-w-6xl mx-auto px-4 py-12 border-t border-hairline mt-8">
    <div class="mb-8">
      <h2 class="text-2xl font-bold tracking-tight text-ink mb-2">
        {lang === 'es' && "Preguntas Frecuentes: Ingeniería de Hidrólisis con Agua Subcrítica (SCWH)"}
        {lang === 'pt' && "Perguntas Frequentes: Engenharia de Hidrólise com Água Subcrítica (SCWH)"}
        {lang === 'ja' && "よくある質問：商業用連続式亜臨界水加水分解（SCWH）プロセス工学"}
        {lang === 'zh-cn' && "常见问题解答：工业连续式亚临界水水解（SCWH）工艺与设备工程"}
      </h2>
      <p class="text-sm text-muted">
        {c.lead}
      </p>
    </div>

    <div class="space-y-6">
      {c.faqs.map(faq => (
        <article class="bg-surface-soft border border-hairline rounded-xl p-6 shadow-xs">
          <h3 class="text-base font-bold text-ink mb-2">
