---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import KitchenwareToxicityScorecard from '../../../components/KitchenwareToxicityScorecard.astro';
import type { SupportedLanguage } from '../../../i18n/ui';
import { useTranslations, useTranslatedPath } from '../../../i18n/utils';

export function getStaticPaths() {
  const availableLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'zh-cn', 'ja'];
  return [
    { params: { lang: 'es' }, props: { lang: 'es' as SupportedLanguage, availableLocales } },
    { params: { lang: 'pt' }, props: { lang: 'pt' as SupportedLanguage, availableLocales } },
    { params: { lang: 'zh-cn' }, props: { lang: 'zh-cn' as SupportedLanguage, availableLocales } },
    { params: { lang: 'ja' }, props: { lang: 'ja' as SupportedLanguage, availableLocales } }
  ];
}

interface Props {
  lang: SupportedLanguage;
  availableLocales: SupportedLanguage[];
}

const { lang, availableLocales } = Astro.props;
const t = useTranslations(lang);
const tp = useTranslatedPath(lang);

interface LocaleToxicContent {
  pageTitle: string;
  pageDescription: string;
  badge: string;
  h1: string;
  heroSub: string;
  mechanismsTitle: string;
  mechanismsIntro: string;
  mechanisms: Array<{ num: string; title: string; desc: string }>;
  faqs: Array<{ question: string; answer: string }>;
  breadcrumbs: Array<{ label: string; href?: string }>;
}

const CONTENT: Record<SupportedLanguage, LocaleToxicContent> = {
  en: {} as any,
  es: {
    pageTitle: "Calculadora de Riesgo de Lixiviación Tóxica y PFAS en Utensilios | Metales Pesados y Microplásticos | IsItKitchenSafe",
    pageDescription: "Evalúa los riesgos de migración de plomo, cadmio, aluminio, PFAS y nanoplásticos en sartenes de teflón, cerámica, silicona y hierro según temperatura y acidez.",
    badge: "Diagnóstico Toxicológico Oficial • Metales Pesados y PFAS",
    h1: "Calculadora de Riesgo de Lixiviación Tóxica y PFAS en Utensilios",
    heroSub: "Calcula en tiempo real la liberación de sustancias químicas y nanoplásticos en tus sartenes y ollas. Selecciona el material, desgaste, temperatura de cocinado y acidez de la comida.",
    mechanismsTitle: "Mecanismos Físico-Químicos de Migración Tóxica",
    mechanismsIntro: "La transferencia de sustancias químicas de los utensilios a la comida responde a tres leyes fundamentales de la cinética química:",
    mechanisms: [
      {
        num: "01",
        title: "Degradación Térmica y Pirólisis",
        desc: "Las capas de PTFE (teflón) comienzan a degradarse a partir de 260°C. Al precalentar una sartén vacía a fuego vivo, alcanza 370°C en menos de 3 minutos, desprendiendo vapores tóxicos de fluoropolímeros causantes de la fiebre por humos de polímero."
      },
      {
        num: "02",
        title: "Ataque Ácido e Intercambio Iónico",
        desc: "Alimentos ácidos como el tomate o el limón (pH < 4.5) atacan los enlaces metálicos débiles. En cerámicas esmaltadas de baja temperatura, los ácidos lixivian rápidamente plomo y cadmio, transfiriéndolos directamente al caldo o bebida."
      },
      {
        num: "03",
        title: "Abrasión Mecánica y Microplásticos",
        desc: "Los tenedores y espátulas metálicas rasgan la capa antiadherente. Estas microfisuras provocan que las fuerzas de fricción al remover desprendan millones de fragmentos nanoplásticos que acaban siendo ingeridos con la comida."
      }
    ],
    faqs: [
      {
        question: "¿Cómo influye la temperatura en la liberación de químicos?",
        answer: "La velocidad de reacción química se duplica por cada 10°C de incremento térmico. En el teflón tradicional, la degradación comienza a 260°C; en plásticos y siliconas, el calor acelera la rotura de cadenas poliméricas liberando siloxanos y bisfenoles."
      },
      {
        question: "¿Por qué no se debe cocinar salsa de tomate en aluminio crudo?",
        answer: "Los ácidos orgánicos del tomate disuelven con rapidez el aluminio puro. Una cocción de dos horas de salsa de tomate en aluminio sin anodizar puede liberar hasta 50 mg de iones de aluminio por ración, rebasando los límites semanales tolerables de la EFSA."
      },
      {
        question: "¿Una sartén rayada desprende realmente microplásticos?",
        answer: "Sí. Estudios científicos de la Universidad Flinders y Newcastle (2022) mediante espectroscopia Raman demostraron que un solo arañazo de 5 cm libera unas 9.100 partículas de microplásticos y hasta 2,3 millones de nanoplásticos en una sola fritura."
      },
      {
        question: "¿Las sartenes de cerámica mineral son 100% libres de PFAS?",
        answer: "Sí. Las sartenes cerámicas sol-gel auténticas se fabrican con derivados minerales de sílice (arena) y carecen totalmente de PTFE, PFOA o flúor. No obstante, las cerámicas artesanales vidriadas de adorno pueden liberar plomo si el esmalte es defectuoso."
      }
    ],
    breadcrumbs: [
      { label: "Inicio", href: "/es/" },
      { label: "Herramientas", href: "/es/tools/" },
      { label: "Calculadora de Lixiviación Tóxica" }
    ]
  },
  pt: {
    pageTitle: "Calculadora de Risco de Liberação Tóxica e PFAS em Panelas | Metais Pesados e Microplásticos | IsItKitchenSafe",
    pageDescription: "Calcule os riscos de migração de chumbo, cádmio, alumínio, PFAS e microplásticos em panelas de teflon, cerâmica, silicone e ferro fundido segundo calor e acidez.",
    badge: "Diagnóstico Toxicológico Oficial • Metais Pesados e PFAS",
    h1: "Calculadora de Risco de Liberação Tóxica e PFAS em Panelas",
    heroSub: "Estime a liberação química e o desprendimento de microplásticos de seus utensílios culinários. Escolha o material, riscos, calor de preparo e acidez dos ingredientes.",
    mechanismsTitle: "Mecanismos Científicos da Migração Química",
    mechanismsIntro: "A contaminação de alimentos por utensílios culinários ocorre por meio de três processos físicos comprovados:",
    mechanisms: [
      {
        num: "01",
        title: "Degradação Térmica e Pirólise",
        desc: "Revestimentos antiaderentes tradicionais de PTFE entram em pirólise a partir de 260°C. Panelas vazias em fogo alto atingem 370°C em apenas 3 minutos, emitindo vapores de ácido perfluorooctanoico que causam febre por vapores de polímeros."
      },
      {
        num: "02",
        title: "Corrosão Ácida e Troca Iônica",
        desc: "Alimentos ácidos como molho de tomate ou limão atacam materiais não ferrosos desprotegidos. Em cerâmicas decoradas queimadas em baixa temperatura, a acidez dissolve o esmalte, liberando chumbo neurotóxico no alimento."
      },
      {
        num: "03",
        title: "Abrasão Mecânica e Partículas",
        desc: "O atrito de talheres metálicos e esponjas de aço rompe a matriz polimérica. A movimentação do cozimento faz com que milhões de nanoplásticos se soltem e se misturem à comida ingerida."
      }
    ],
    faqs: [
      {
        question: "Como o calor afeta a liberação de compostos químicos?",
        answer: "A taxa de reação química dobra a cada 10°C de aumento na temperatura. Em panelas de teflon, o aquecimento acima de 260°C decompõe o fluoropolímero; em plásticos, o calor promove a migração de plastificantes lipofílicos."
      },
      {
        question: "Por que não cozinhar molho de tomate em panela de alumínio puro?",
        answer: "O ácido cítrico e málico do tomate reage fortemente com o alumínio nu, dissolvendo grandes quantidades de íons metálicos na comida, o que sobrecarrega a filtração renal e o sistema nervoso."
      },
      {
        question: "Panelas riscadas liberam microplásticos nos alimentos?",
        answer: "Sim. Pesquisas revisadas por pares (Austrália, 2022) confirmaram que uma única ranhura na superfície de teflon pode liberar mais de 2 milhões de fragmentos nanoplásticos durante o cozimento normal."
      },
      {
        question: "O aço inoxidável é seguro para todos os alimentos?",
        answer: "Sim, os aços 304 e 316 possuem uma camada passiva de óxido de cromo altamente inerte. Apenas pessoas diagnosticadas com alergia severa sistêmica ao níquel devem optar por aço inox sem níquel (série 430)."
      }
    ],
    breadcrumbs: [
      { label: "Início", href: "/pt/" },
      { label: "Ferramentas", href: "/pt/tools/" },
      { label: "Calculadora de Liberação Tóxica" }
    ]
  },
  'zh-cn': {
    pageTitle: "厨具重金属与 PFAS 有毒溶出风险测评计算器 | 微塑料与热降解分析 | IsItKitchenSafe",
    pageDescription: "科学评估特氟龙不粘涂层、生铝锅、彩釉陶器、硅胶及不锈钢厨具在划痕破损、高温烹饪与酸性食材作用下的铅、镉、PFAS 永久化学品及纳米塑料溶出风险。",
    badge: "毒理学与材料安全深度评估 • 重金属与 PFAS 专项",
    h1: "厨具重金属与 PFAS 有毒溶出风险测评计算器",
    heroSub: "基于同行评审科研成果，量化分析厨具涂层破损、爆炒高温与食材酸度对铅、镉、铝离子及纳米微塑料析出速度的影响，即刻生成实验室风险评级报告。",
    mechanismsTitle: "厨房用品化学物质迁移析出的三大物理机制",
    mechanismsIntro: "餐具与锅具中的有害化学成分向食物迁移主要受控于热力学、酸碱络合及机械剪切三大驱动力：",
    mechanisms: [
      {
        num: "01",
        title: "高温热分解与有毒气溶胶释放",
        desc: "传统 PTFE（聚四氟乙烯）涂层在超过 260°C 时开始降解。空锅干烧 3 分钟内锅底温度即可突破 370°C，剧烈裂解释放全氟化合物前体及全氟异丁烯剧毒烟气，导致‘聚合物烟尘热’。"
      },
      {
        num: "02",
        title: "酸性络合侵蚀与重金属离子交换",
        desc: "番茄浓汤、食醋、柠檬汁等高酸食材（pH < 4.5）中的氢离子会迅速侵蚀生铝及民间彩绘低温釉面。釉料中的铅与镉被置换析出，随着热汤进入人体蓄积并损害中枢神经。"
      },
      {
        num: "03",
        title: "机械刮擦磨损与纳米塑料剥离",
        desc: "钢丝球与金属锅铲的硬性刮擦会破坏高分子涂层网络。微裂纹在食物翻炒搅拌的剪切力作用下不断扩展，每次翻炒可脱落数百万颗粒径小于 1 微米的纳米塑料碎片。"
      }
    ],
    faqs: [
      {
        question: "烹饪加热温度对化学物质的析出速度有多大影响？",
        answer: "根据阿伦尼乌斯化学反应动力学公式，温度每升高 10°C，化学反应速率通常成倍增加。特氟龙涂层在 260°C 以上快速发生热裂解，塑料与硅胶中的环状硅氧烷和双酚类物质也会成倍迁移至油脂中。"
      },
      {
        question: "为什么严禁用生铝锅慢炖番茄牛腩或醋溜菜肴？",
        answer: "未经阳极氧化处理的裸铝极为活跃，极易被有机酸腐蚀溶解。慢熬 2 小时番茄酱可溶出高达 20-50 mg/kg 的游离铝离子，严重超出欧洲食品安全局 (EFSA) 设定的每周耐受摄入量极限。"
      },
      {
        question: "涂层轻微划伤的不粘锅真的会脱落数百万塑料颗粒吗？",
        answer: "会。澳大利亚弗林德斯大学与纽卡斯尔大学在 2022 年发表于权威期刊的拉曼光谱研究证实，仅 5 厘米长的表面微小划痕，在单次常规烹饪中就可释放约 9,100 个微塑料颗粒和多达 230 万个纳米微塑料。"
      },
      {
        question: "304 与 316 食品级不锈钢是完全无毒无迁移的吗？",
        answer: "在绝大多数情况下极度安全。不锈钢表面自发形成致密的氧化铬钝化保护膜。仅在长时间超高温炖煮高酸汤汁时会有微量镍离子释放，这仅对患有极严重系统性镍过敏症的人群需要警惕。"
      }
    ],
    breadcrumbs: [
      { label: "首页", href: "/zh-cn/" },
      { label: "实用工具", href: "/zh-cn/tools/" },
      { label: "有害溶出风险测评" }
    ]
  },
  ja: {
    pageTitle: "調理器具の有害物質溶出＆PFASリスク評価カリキュレーター | 重金属・マイクロプラスチック | IsItKitchenSafe",
    pageDescription: "テフロン加工、アルミ鍋、陶磁器、シリコン調理器具の傷、加熱温度、食品の酸性度から、鉛・カドミウム・PFAS・ナノプラスチックの溶出リスクを科学的に算出。",
    badge: "毒性学・材料科学リスク診断 • 重金属＆PFAS",
    h1: "調理器具の有害物質溶出＆PFASリスク評価カリキュレーター",
    heroSub: "フライパンの傷や加熱温度、食材の酸性度から、有害重金属（鉛・アルミ）やPFAS、マイクロプラスチックの食品への溶出リスク指数をリアルタイムで算出します。",
    mechanismsTitle: "調理器具からの化学物質移行に関する3大メカニズム",
    mechanismsIntro: "調理器具から食品へ有害成分が溶出・移行する現象は、科学的に以下の3つの要因で発生します：",
    mechanisms: [
      {
        num: "01",
        title: "熱劣化と有害ガスの熱分解",
        desc: "従来のPTFEフッ素樹脂加工は260℃を超えると微小粒子の放出が始まり、空焚きにより3分で370℃に達すると有毒なフッ素ガスが発生し、ポリマーヒューム熱を引き起こします。"
      },
      {
        num: "02",
        title: "酸による腐食と重金属イオン交換",
        desc: "トマトソースやレモン果汁などの酸性食材（pH4.5未満）は、無垢アルミや伝統的な低温焼成陶器の釉薬を激しく腐食し、神経毒性を持つ鉛やカドミウム、アルミイオンを食品中へ溶出させます。"
      },
      {
        num: "03",
        title: "物理的摩耗と微小プラスチックの混入",
        desc: "金属ヘラや研磨たわしによる傷口から、調理中の撹拌摩擦によって無数の微小樹脂片が剥離。1回の炒め物で数百万個のナノプラスチックが食品に混入することが確認されています。"
      }
    ],
    faqs: [
      {
        question: "調理温度は化学物質の溶出にどのように影響しますか？",
        answer: "化学反応速度は温度が10℃上昇するごとに約2倍に加速します。フッ素加工は260℃以上で分解が始まり、プラスチック容器は熱と油の接触によって可塑剤が食品へ急激に移行します。"
      },
      {
        question: "なぜ無垢のアルミ鍋でトマト料理を作ってはいけないのですか？",
        answer: "トマトに含まれるクエン酸やリンゴ酸が裸のアルミニウムを直接溶かします。長時間の煮込み料理ではEFSA（欧州食品安全機関）の耐容週間摂取量を大幅に超えるアルミが溶け出します。"
      },
      {
        question: "傷ついたフライパンから本当に大量のプラスチックが出るのですか？",
        answer: "はい。オーストラリア・ニューカッスル大学らの2022年のラマン分光分析研究により、わずか5cmの傷から1回の調理で230万個以上のナノプラスチックが食品中に放出されることが判明しています。"
      },
      {
        question: "ステンレス鋼（304/316）は酸性の料理にも安全ですか？",
        answer: "極めて安全です。表面に強固な不動態皮膜（酸化クロム層）が形成されているため、通常のトマト煮込みでも有害な溶出はありません。重度のニッケルアレルギーの方のみ注意が必要です。"
      }
    ],
    breadcrumbs: [
      { label: "ホーム", href: `/${lang}/` },
      { label: "ツール", href: `/${lang}/tools/` },
      { label: "有害物質溶出カリキュレーター" }
    ]
  }
};

const c = CONTENT[lang];

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": c.h1,
  "url": `https://isitkitchensafe.com/${lang}/tools/toxic-leaching-scorecard/`,
  "applicationCategory": "HealthApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "description": c.pageDescription,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};
---

<Layout title={c.pageTitle} description={c.pageDescription} faqs={c.faqs} availableLocales={availableLocales} lang={lang}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={c.breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1200px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-rose-600 text-white mb-3">
        {c.badge}
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        {c.h1}
      </h1>
      <p class="text-body text-[15px] md:text-body-md leading-relaxed">
        {c.heroSub}
      </p>
    </header>

    <!-- Main Scorecard Calculator Component -->
    <div class="mb-14">
      <KitchenwareToxicityScorecard lang={lang} />
    </div>

    <!-- Science Deep-Dive: Material Migration Mechanisms -->
    <section class="mb-14 border-t border-hairline pt-12 space-y-8">
      <div class="max-w-3xl">
        <span class="text-xs font-bold uppercase tracking-wider text-muted block mb-1">
          {lang === 'ja' ? '材料科学・化学動力学' : lang === 'zh-cn' ? '材料物理学与食品接触动力学' : 'Ciencia de Materiales y Cinética Química'}
        </span>
        <h2 class="text-title-lg md:text-display-sm font-medium text-ink tracking-tight mb-3">
          {c.mechanismsTitle}
        </h2>
        <p class="text-body text-[15px] leading-relaxed">
          {c.mechanismsIntro}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {c.mechanisms.map((m) => (
          <div class="p-6 rounded-2xl bg-surface-soft border border-hairline space-y-3">
            <div class="w-9 h-9 rounded-xl bg-rose-600 text-white font-bold flex items-center justify-center text-sm">
              {m.num}
            </div>
            <h3 class="font-semibold text-ink text-base">{m.title}</h3>
            <p class="text-xs text-body leading-relaxed">{m.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="border-t border-hairline pt-12">
      <h2 class="text-title-lg md:text-display-sm font-medium text-ink tracking-tight mb-8">
        {lang === 'ja' ? 'よくある質問' : lang === 'zh-cn' ? '常见问题与解答' : lang === 'pt' ? 'Perguntas Frequentes' : 'Preguntas Frecuentes'}
      </h2>
      <div class="space-y-6 max-w-3xl">
        {c.faqs.map(faq => (
          <div class="border-b border-hairline pb-6">
            <h3 class="text-base font-semibold text-ink mb-2">
              {faq.question}
            </h3>
            <p class="text-body text-sm leading-relaxed">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>
