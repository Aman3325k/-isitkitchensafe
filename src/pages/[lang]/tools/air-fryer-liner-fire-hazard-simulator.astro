---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import AirFryerLinerFireHazardSimulator from '../../../components/AirFryerLinerFireHazardSimulator.astro';
import rawData from '../../../data/air-fryer-liner-fire-hazard-data.json';
import type { SupportedLanguage } from '../../../i18n/ui';

export function getStaticPaths() {
  const availableLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'zh-cn', 'ja'];
  return [
    { params: { lang: 'es' }, props: { lang: 'es' as SupportedLanguage, availableLocales } },
    { params: { lang: 'pt' }, props: { lang: 'pt' as SupportedLanguage, availableLocales } },
    { params: { lang: 'zh-cn' }, props: { lang: 'zh-cn' as SupportedLanguage, availableLocales } },
    { params: { lang: 'ja' }, props: { lang: 'ja' as SupportedLanguage, availableLocales } }
  ];
}

interface Props {
  lang: SupportedLanguage;
  availableLocales: SupportedLanguage[];
}

const { lang, availableLocales } = Astro.props;

interface LocalePageContent {
  pageTitle: string;
  pageDescription: string;
  badge: string;
  h1: string;
  heroSub: string;
  breadcrumbs: Array<{ label: string; href?: string }>;
}

const CONTENT: Record<Exclude<SupportedLanguage, 'en'>, LocalePageContent> = {
  es: {
    pageTitle: "Simulador de Flujo de Aire y Peligro de Incendio en Freidoras de Aire | IsItKitchenSafe",
    pageDescription: "Calcula el riesgo de succión aerodinámica de papel pergamino hacia las resistencias incandescentes (400°C–600°C), pérdida de flujo de convección y seguridad de moldes de silicona. Normas CPSC y FDA.",
    badge: "Alerta CPSC · Aerodinámica de Vórtice Bernoulli · FDA 21 CFR § 176.170 · Silicona Platino BfR XV",
    h1: "Simulador de Flujo de Aire y Peligro de Incendio en Freidoras de Aire",
    heroSub: "Evita incendios graves y comida blanda: calcula la fuerza de succión del ventilador sobre el papel pergamino, simula la pérdida de convección inferior en moldes de silicona macizos y aprende la regla científica de los 200 gramos de lastre.",
    breadcrumbs: [
      { label: "Inicio", href: "/es/" },
      { label: "Herramientas", href: "/es/tools/" },
      { label: "Simulador de Fuego en Freidora de Aire" }
    ]
  },
  pt: {
    pageTitle: "Simulador de Circulação de Ar e Risco de Fogo em Air Fryer | IsItKitchenSafe",
    pageDescription: "Simule a sucção aerodinâmica de papel manteiga para a resistência (400°C–600°C), perda de crocância inferior e segurança química de cestos de silicone na air fryer. Padrões CPSC e FDA.",
    badge: "Alerta CPSC · Vórtice Aerodinâmico de Bernoulli · FDA 21 CFR § 176.170 · Silicone Platina BfR XV",
    h1: "Simulador de Circulação de Ar e Risco de Fogo em Air Fryer",
    heroSub: "Proteja sua cozinha contra chamas e evite alimentos murchos: calcule o risco de sucção de papéis soltos contra a serpentina incandescente, simule a perda de convecção inferior com cestos de silicone e domine a regra dos 200g de lastro.",
    breadcrumbs: [
      { label: "Início", href: "/pt/" },
      { label: "Ferramentas", href: "/pt/tools/" },
      { label: "Simulador de Fogo em Air Fryer" }
    ]
  },
  'zh-cn': {
    pageTitle: "空气炸锅烘焙垫纸气流阻隔与发热管起火隐患模拟器 | IsItKitchenSafe",
    pageDescription: "测算空气炸锅高速涡流将烘焙纸吸附至 400°C–600°C 发热管的起火概率、硅胶锅底部对流风阻衰减及原木浆无氟安全标准。基于美国 CPSC 召回通报与 FDA 食品接触法规。",
    badge: "美国 CPSC 火灾通报 · 伯努利气动涡流模型 · FDA 21 CFR § 176.170 · 铂金硅胶标准",
    h1: "空气炸锅烘焙垫纸气流阻隔与发热管起火隐患模拟器",
    heroSub: "彻底终结垫纸着火与食物软烂：科学测算 3000 RPM 高速对流风机对未压重烘焙纸的瞬间吸附概率，模拟全封闭硅胶内胆对底部热风的衰减效应，掌握 200 克食物压重黄金避险法则。",
    breadcrumbs: [
      { label: "首页", href: "/zh-cn/" },
      { label: "安全工具", href: "/zh-cn/tools/" },
      { label: "空气炸锅垫纸起火与气流模拟器" }
    ]
  },
  ja: {
    pageTitle: "エアフライヤー用シート気流遮断＆電熱線発火シミュレーター | IsItKitchenSafe",
    pageDescription: "クッキングシートの空力吸引による400℃〜600℃ヒーター直接引火リスク、シリコンポットによる底部熱風対流遮断率、PFASフリー認証を科学的に計算。米CPSC火災警報・米FDA基準準拠。",
    badge: "米CPSC火災警告 · ベルヌーイ気流渦力学 · 米FDA 21 CFR § 176.170 · プラチナ加硫シリコーン",
    h1: "エアフライヤー用シート気流遮断＆電熱線発火シミュレーター",
    heroSub: "火災事故と底面の焼きムラ・ベチャつきを未然に防止：食材の重石がないシートがファン気流で巻き上げられてヒーターに接触する発火確率を測定し、シリコンポットの通気性損失を計算します。",
    breadcrumbs: [
      { label: "ホーム", href: "/ja/" },
      { label: "安全ツール", href: "/ja/tools/" },
      { label: "エアフライヤーシート発火シミュレーター" }
    ]
  }
};

const content = CONTENT[lang as Exclude<SupportedLanguage, 'en'>] || CONTENT.es;

const faqs = (rawData.faqs[lang as 'es' | 'pt' | 'zh-cn' | 'ja'] || rawData.faqs.en);

const canonicalUrl = `https://isitkitchensafe.com/${lang}/tools/air-fryer-liner-fire-hazard-simulator/`;

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": content.h1,
  "url": canonicalUrl,
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript.",
  "description": content.pageDescription,
  "inLanguage": lang,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq: any) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={content.pageTitle}
  description={content.pageDescription}
  faqs={faqs}
  excludeFaqSchema={true}
  availableLocales={availableLocales}
  lang={lang}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1 print:hidden">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={content.breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1140px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-signature-coral text-white mb-3">
        {content.badge}
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        {content.h1}
      </h1>
      <p class="text-body text-[15px] md:text-[16px] leading-relaxed">
        {content.heroSub}
      </p>
    </header>

    <!-- Main Interactive Simulator Component -->
    <AirFryerLinerFireHazardSimulator lang={lang} />
  </div>
</Layout>
