      {
        question: "与传统蒸汽热降膜蒸发器相比，FO-MD能带来多大的脱碳与比能耗（SEC）削减？",
        answer: "传统降膜蒸发器由于水的高汽化潜热（2,260 kJ/kg），每蒸发1升水分需消耗1.85至2.45 kWh的综合热电能源，带来巨量锅炉燃气消耗。FO-MD工艺将水分子抽离与热力分离解耦：正渗透初级脱水仅需低能耗循环泵电耗（0.06–0.08 kWh/L），膜蒸馏脱水再生则可直接利用工厂低品质废热（38–45°C）或太阳能集热器驱动，总折合电耗降至0.22–0.32 kWh/L，节能率高达84%至88%，大幅削减原汁浓缩碳足迹。"
      },
      {
        question: "果汁制造中的HACCP 5-log病原菌杀灭以及汲取质反向扩散有哪些法规控制指标？",
        answer: "商业机组严格符合FDA 21 CFR § 120（果汁HACCP）法规，确保对大肠杆菌O157和沙门氏菌达到经过验证的5-log致死灭活率，工艺常温段通过配备脉冲UV-C紫外杀菌系统或无菌微孔过滤阻隔实现。膜汲取质反向盐流通量依据FDA 21 CFR § 170.36（GRAS）严控在0.10 g/m²·h以内，成品微量汲取物残留低于0.1 ppm。所有流体接触部件均符合3-A Sanitary Standards 45-03卫生设计，采用Ra ≤ 0.38 µm电解抛光316L不锈钢与食品级全氟醚橡胶密封圈。"
      }
    ]
  }
};

const c = CONTENT[lang as Exclude<SupportedLanguage, 'en'>];

const breadcrumbs = [
  { label: t('nav.home') || 'Home', href: tp('/') },
  { label: t('nav.tools') || 'Tools', href: tp('/tools/') },
  { label: c.breadcrumbsLabel }
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": `https://isitkitchensafe.com${Astro.url.pathname}#webapp`,
      "url": `https://isitkitchensafe.com${Astro.url.pathname}`,
      "name": c.pageTitle,
      "applicationCategory": "EngineeringApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5 Canvas/CSS3.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": c.pageDescription
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": t('nav.home') || "Home",
          "item": `https://isitkitchensafe.com${tp('/')}`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": t('nav.tools') || "Tools",
          "item": `https://isitkitchensafe.com${tp('/tools/')}`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": c.breadcrumbsLabel,
          "item": `https://isitkitchensafe.com${Astro.url.pathname}`
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": c.faqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
};
---

<Layout title={c.pageTitle} description={c.pageDescription} lang={lang} availableLocales={availableLocales}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <Breadcrumbs items={breadcrumbs} />

    <!-- Hero Header -->
    <div class="mt-4 mb-8">
      <div class="flex items-center gap-2 mb-3">
        <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-sky-950 text-sky-300 border border-sky-800">
          {c.badge}
        </span>
        <span class="text-xs text-muted font-mono">FO-MD &bull; 18&ndash;45°C &bull; 68 °Brix &bull; 0.0 ppm Solvents &bull; FDA Juice HACCP</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-ink tracking-tight mb-4">
        {c.h1}
      </h1>
      <p class="text-base sm:text-lg text-muted max-w-4xl leading-relaxed">
        {c.lead}
      </p>
    </div>

    <!-- Mount Interactive Modeler Engine -->
    <CommercialContinuousFoMdModeler lang={lang} />

    <!-- Technical Narrative Deep Dive -->
    <div class="mt-12 space-y-10">
      <!-- FAQ Section -->
      <section class="bg-surface-soft border border-hairline rounded-3xl p-6 sm:p-10">
        <h2 class="text-xl sm:text-2xl font-bold text-ink mb-6">
          {lang === 'es' ? 'Preguntas Frecuentes: Concentración FO-MD y Estándares Sanitarios' :
           lang === 'pt' ? 'Perguntas Frequentes: Concentração FO-MD e Padrões Sanitários' :
           lang === 'ja' ? 'よくある質問：商業用FO-MD濃縮技術と衛生工学基準' :
           '常见问题解答：商业级FO-MD果汁浓缩技术与卫生合规标准'}
        </h2>
        <div class="space-y-6">
          {c.faqs.map(faq => (
            <div class="border-b border-hairline pb-5">
              <h3 class="text-base font-bold text-ink mb-2">{faq.question}</h3>
              <p class="text-sm text-muted leading-relaxed">{faq.answer}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Related Tools Navigation -->
      <section class="bg-surface-soft border border-hairline rounded-3xl p-6 sm:p-10">
        <h2 class="text-xl sm:text-2xl font-bold text-ink mb-4">
          {lang === 'es' ? 'Herramientas Relacionadas de Ingeniería de Procesos Alimentarios' :
           lang === 'pt' ? 'Ferramentas Relacionadas de Engenharia de Processos de Alimentos' :
           lang === 'ja' ? '関連する食品プロセス工学診断ツール' :
           '相关食品工艺工程诊断计算工具'}
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <a href={tp('/tools/commercial-continuous-fo-mvr-concentration-modeler/')} class="p-4 rounded-xl bg-surface border border-hairline hover:border-sky-500 transition-colors block">
            <span class="text-xs font-bold text-sky-400 uppercase tracking-wider block mb-1">
              {lang === 'es' || lang === 'pt' ? 'Engenharia de Membranas' : lang === 'ja' ? '膜分離工学' : '膜工程技术'}
            </span>
            <strong class="text-sm text-ink block mb-1">
              {lang === 'es' ? 'Simulador Continuo FO-MVR' :
               lang === 'pt' ? 'Simulador Contínuo FO-MVR' :
               lang === 'ja' ? '連続式FO-MVR濃縮モデラー' :
               '连续式FO-MVR浓缩模拟器'}
            </strong>
            <span class="text-xs text-muted block">
              {lang === 'es' ? 'Modela ósmosis directa integrada con recompresión mecánica de vapor.' :
               lang === 'pt' ? 'Modela osmose direta integrada com recompressão mecânica de vapor.' :
               lang === 'ja' ? '正浸透と多段メカニカル蒸気再圧縮（MVR）の連成モデル。' :
               '模拟正渗透耦合多效机械蒸汽再压缩连续浓缩工艺。'}
            </span>
          </a>
          <a href={tp('/tools/commercial-continuous-fo-fc-freeze-concentration-modeler/')} class="p-4 rounded-xl bg-surface border border-hairline hover:border-sky-500 transition-colors block">
            <span class="text-xs font-bold text-sky-400 uppercase tracking-wider block mb-1">
              {lang === 'es' || lang === 'pt' ? 'Crioconcentração' : lang === 'ja' ? '凍結濃縮工学' : '冷冻浓缩技术'}
            </span>
            <strong class="text-sm text-ink block mb-1">
              {lang === 'es' ? 'Simulador Híbrido FO-FC' :
               lang === 'pt' ? 'Simulador Híbrido FO-FC' :
               lang === 'ja' ? '連続式FO-FCハイブリッド濃縮モデラー' :
               '连续式FO-FC混合浓缩模拟器'}
            </strong>
            <span class="text-xs text-muted block">
              {lang === 'es' ? 'Modela ósmosis directa combinada con crioconcentración por congelación.' :
               lang === 'pt' ? 'Modela osmose direta combinada com crioconcentração progressiva.' :
               lang === 'ja' ? '正浸透と進行性凍結濃縮による超低温高純度濃縮モデル。' :
               '模拟正渗透与渐进式冷冻结晶浓缩的超低温保质工艺。'}
            </span>
          </a>
          <a href={tp('/tools/commercial-membrane-distillation-modeler/')} class="p-4 rounded-xl bg-surface border border-hairline hover:border-sky-500 transition-colors block">
            <span class="text-xs font-bold text-sky-400 uppercase tracking-wider block mb-1">
              {lang === 'es' || lang === 'pt' ? 'Física Térmica' : lang === 'ja' ? '膜蒸留物理' : '膜蒸馏物理'}
            </span>
            <strong class="text-sm text-ink block mb-1">
              {lang === 'es' ? 'Simulador de Destilación por Membrana' :
               lang === 'pt' ? 'Simulador de Destilação por Membrana' :
               lang === 'ja' ? '連続式膜蒸留（MD）モデラー' :
               '连续式膜蒸馏（MD）模拟器'}
            </strong>
            <span class="text-xs text-muted block">
              {lang === 'es' ? 'Modela permeación de vapor y polarización térmica en poros hidrófobos.' :
               lang === 'pt' ? 'Modela fluxo de vapor em poros hidrofóbicos e polarização térmica.' :
               lang === 'ja' ? '疎水性微孔膜の水蒸気透過と温度分極現象の数値解析。' :
               '模拟微孔超疏水膜水蒸气跨膜传递与温度极化动力学。'}
            </span>
          </a>
        </div>
      </section>
    </div>
  </div>
</Layout>
