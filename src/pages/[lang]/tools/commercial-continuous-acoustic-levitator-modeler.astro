        question: "商業施設では超音波騒音をどのように遮音し、OSHA 29 CFR § 1910.95 労働安全基準を遵守しますか？",
        answer: "20〜40 kHz の超音波自体は人間の可聴域（20 Hz〜20 kHz）を超えていますが、産業用ハイパワーホーンは非常に高い音響エネルギー（155〜168 dB）を放射するため、非線形相互作用による可聴サブハーモニック音や構造共鳴音が発生します。OSHA 1910.95 では8時間加重平均騒音を 85 dBA 未満に制限しています。商業用装置は高比重遮音シート、吸音ロックウール、複層ポリカーボネート観察窓を備えた粘弾性複合防音エンクロージャー内に完全密閉され、-32〜-38 dBA の挿入損失を発揮して作業環境騒音を 65〜72 dBA に安全に抑えます。"
      }
    ]
  }
};

const c = CONTENT[lang as keyof typeof CONTENT] || CONTENT.es;

const breadcrumbs = [
  { label: t('nav.home') || 'Home', href: tp('/') },
  { label: t('nav.tools') || 'Tools', href: tp('/tools/') },
  { label: c.breadcrumbsLabel }
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": `https://isitkitchensafe.com/${lang}/tools/commercial-continuous-acoustic-levitator-modeler/#webapp`,
      "url": `https://isitkitchensafe.com/${lang}/tools/commercial-continuous-acoustic-levitator-modeler/`,
      "name": c.pageTitle,
      "applicationCategory": "EngineeringApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5 Canvas/CSS3.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": c.pageDescription
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": t('nav.home') || 'Home',
          "item": `https://isitkitchensafe.com${tp('/')}`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": t('nav.tools') || 'Tools',
          "item": `https://isitkitchensafe.com${tp('/tools/')}`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": c.breadcrumbsLabel,
          "item": `https://isitkitchensafe.com/${lang}/tools/commercial-continuous-acoustic-levitator-modeler/`
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": c.faqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
};
---

<Layout title={c.pageTitle} description={c.pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <div class="max-w-6xl mx-auto px-4 py-4">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <CommercialContinuousAcousticLevitatorModeler lang={lang} />

  <!-- Detailed Engineering FAQs Section -->
  <section class="max-w-6xl mx-auto px-4 py-12 border-t border-hairline mt-8">
    <div class="mb-8">
      <h2 class="text-2xl font-bold tracking-tight text-ink mb-2">
        {lang === 'es' && "Preguntas Frecuentes: Ingeniería de Levitación Acústica de Microgotas"}
        {lang === 'pt' && "Perguntas Frequentes: Engenharia de Levitação Acústica de Microgotas"}
        {lang === 'zh-cn' && "常见技术问题：超声波微滴声悬浮与无容器蒸发工程"}
        {lang === 'ja' && "よくある技術質問：超音波液滴音響浮揚＆完全非接触蒸発工学"}
      </h2>
      <p class="text-sm text-muted">
        {lang === 'es' && "Especificaciones físicas, fluidodinámicas y termodinámicas de ondas estacionarias ultrasónicas, potencial de radiación de Gor'kov, transferencia de masa por streaming de Schlichting y retención biológica sin cizallamiento."}
        {lang === 'pt' && "Especificações termodinâmicas, fluidodinâmicas e acústicas de ondas estacionárias ultrassônicas, potencial de Gor'kov, fluxo acústico de Schlichting e preservação de compostos bioativos sob cisalhamento zero."}
        {lang === 'zh-cn' && "关于单轴超声波驻波流道、Gor'kov 声辐射势场、Schlichting 边界层声流强化传质及零剪切活性成分保全的物理学与工程学规格。"}
        {lang === 'ja' && "単軸定在波超音波浮揚、Gor'kov 放射圧ポテンシャル、Schlichting 音響流物質移動、および完全非接触酵素活性保持に関する詳細な工学的解説。"}
      </p>
    </div>

    <div class="space-y-6">
      {c.faqs.map(faq => (
        <article class="bg-surface-soft border border-hairline rounded-xl p-6 shadow-xs">
          <h3 class="text-base font-bold text-ink mb-2">
            {faq.question}
          </h3>
          <p class="text-sm text-muted leading-relaxed">
            {faq.answer}
          </p>
        </article>
      ))}
    </div>
  </section>
</Layout>
