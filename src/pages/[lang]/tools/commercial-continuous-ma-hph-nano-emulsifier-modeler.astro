const c = CONTENT[lang as Exclude<SupportedLanguage, 'en'>] || CONTENT.es;

const pageTitle = c.pageTitle;
const pageDescription = c.pageDescription;

const breadcrumbs = [
  { label: t('nav.home') || 'Home', href: tp('/') },
  { label: t('nav.tools') || 'Tools', href: tp('/tools/') },
  { label: c.breadcrumbsLabel }
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": `https://isitkitchensafe.com${tp('/tools/commercial-continuous-ma-hph-nano-emulsifier-modeler/')}#webapp`,
      "url": `https://isitkitchensafe.com${tp('/tools/commercial-continuous-ma-hph-nano-emulsifier-modeler/')}`,
      "name": c.h1,
      "applicationCategory": "EngineeringApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5 Canvas/CSS3.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": pageDescription
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": t('nav.home') || 'Home',
          "item": `https://isitkitchensafe.com${tp('/')}`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": t('nav.tools') || 'Tools',
          "item": `https://isitkitchensafe.com${tp('/tools/')}`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": c.breadcrumbsLabel,
          "item": `https://isitkitchensafe.com${tp('/tools/commercial-continuous-ma-hph-nano-emulsifier-modeler/')}`
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": c.faqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs items={breadcrumbs} />

    <CommercialContinuousMaHphModeler lang={lang} />

    <!-- FAQ Section -->
    <section class="mt-16 border-t border-hairline pt-12">
      <div class="max-w-3xl mb-8">
        <h2 class="text-2xl font-black text-ink tracking-tight mb-2">
          {lang === 'es' ? 'Preguntas Frecuentes sobre Ingeniería y Ciencia Sanitaria' :
           lang === 'pt' ? 'Perguntas Frequentes de Engenharia e Ciência Sanitária' :
           lang === 'zh-cn' ? '工程设计与卫生科学常见问题解答 (FAQ)' :
           'エンジニアリング＆サニタリーサイエンス FAQ'}
        </h2>
        <p class="text-sm text-body leading-relaxed">
          {c.lead}
        </p>
      </div>

      <div class="space-y-6">
        {c.faqs.map((faq) => (
          <article class="p-6 rounded-2xl bg-surface-soft border border-hairline/80 shadow-xs">
            <h3 class="text-base font-bold text-ink mb-3 leading-snug">
              {faq.question}
            </h3>
            <p class="text-sm text-body leading-relaxed">
              {faq.answer}
            </p>
          </article>
        ))}
      </div>
    </section>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</Layout>
