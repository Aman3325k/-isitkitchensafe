    lead: "大型缶詰連続静水圧殺菌塔（ハイドロスタティック・レトルト）の熱力学的挙動を解析：バロメトリック水柱による圧力封止（ΔP = ρgh）、蒸気ドーム連続エアパージによる冷点解消、缶蓋ピーキング座屈防止、および搬送チェーンピッチ摩耗管理を FDA 21 CFR § 113.40 および ASME BPVC 基準に基づきモデル化。",
    breadcrumbsLabel: "業務用静水圧レトルト殺菌機",
    faqs: [
      {
        question: "連続式静水圧レトルト殺菌機はどのように水柱を用いて高圧飽和蒸気を封止しているのですか？",
        answer: "静水圧レトルトは、高さ 15〜24 m の立型水柱レッグを用いて中央の蒸気ドーム圧力を物理的な開閉バルブなしで完全に封じ込めます。静水圧の基本式 ΔP = ρ_water · g · H に従い、121.1°C（103.4 kPa / 15.0 psig）の飽和蒸気圧と水柱の重さが釣り合います。予熱レッグ内の温水（85°C、密度 968 kg/m³）を考慮すると、理論上 10.89 m の水頭が必要です。実際には 12.2〜14.0 m の水頭を維持することで 1.2 m 以上の安全マージンを確保し、蒸気吹き抜けを恒久的に防ぎます。"
      },
      {
        question: "静水圧レトルトの水位低下による蒸気破封事故（ブロウスルー）はなぜ起こるのですか？",
        answer: "給水ポンプのキャビテーションや蒸気圧サージによって水柱高さが必要静水頭を下回った場合（H_actual < H_req）、下部水封の圧力差が逆転します。高圧蒸気が底部ループを破って上部大気開放口へと爆発的に噴出し、数トンの沸騰水と生蒸気が工場フロアへ吹き上がります。これは OSHA 1910.106 に抵触する重大熱傷災害であり、塔内失圧による数万缶の一斉殺菌不良をもたらします。"
      },
      {
        question: "米国 FDA 21 CFR § 113.40 が蒸気ドームの連続脱気ブリーダー弁を義務付けている理由は何ですか？",
        answer: "FDA 21 CFR § 113.40(e) に基づき、蒸気ドーム最上部には口径 1/4 インチ（6.35 mm）以上のブリーダー弁を設け、殺菌運転中は常時大気中へ連続排気しなければなりません。ボイラー蒸気に含まれる空気などの不凝縮ガスが上部に滞留すると、ドルトンの分圧法則（P_total = P_steam + P_air）により蒸気分圧が下がり、温度計の指示値より実際の凝縮温度が 2°C 以上低下します。さらに空気膜が缶表面の伝熱を 85% 遮断し、ボツリヌス菌が生残する重大なコールドスポットを形成します。"
      },
      {
        question: "冷却レッグへの移行時に缶体の蓋が永久変形する「ピーキング」現象はなぜ生じるのですか？",
        answer: "加熱殺菌中、缶内の食品とヘッドスペース気体が熱膨張し、内圧は 24〜28 psig に達します。缶が蒸気ドームを出て冷却水柱を上昇する際、外圧が低下します。内外正味差圧（ΔP_net = P_int - P_ext）が缶蓋二重巻締めの変形限界（ブリキ缶 34 psi、アルミ缶 19.5 psi）を超えると、蓋が永久的に外側へ膨張（ピーキング）し、密封コンパウンドが剥離して冷却水吸入による細菌二次汚染を引き起こします。"
      },
      {
        question: "ISO 1977 規格に基づく搬送ローラーチェーンのピッチ伸び摩耗限界値はどれくらいですか？",
        answer: "静水圧レトルトの搬送チェーンは 40°C から 125°C の温水・蒸気中を連続周回します。ピンとブシュの摺動摩耗によりピッチが伸びます。ISO 1977 規格では、累積ピッチ伸び率（ΔL/L0）の上限は 1.5% です。1.5% を超えると駆動スプロケットの歯とチェーンが噛み合わなくなって歯飛びを起こし、加圧ドーム内でキャリアが詰まる壊滅的な故障に直結します。"
      }
    ],
    scienceTitle1: "静水圧バロメトリック平衡方程式と蒸気破封噴出動力学",
    scienceText1: "物理的仕切り弁を用いない連続搬送は、飽和蒸気圧と立型水柱重量の静力学的平衡（ΔP = ρ·g·H）に依存します。水温上昇による密度低下を補うため、最低 1.2 m の安全水頭マージンを常時確保する必要があります。",
    box1Title: "理論静水頭計算式",
    box1Text: "H_req = (P_steam - P_atm) / (ρ_water · g)。121.1°C 蒸気および 85°C 水温において必要水頭は 10.89 m です。",
    box2Title: "安全水頭マージン規格",
    box2Text: "ASME BPVC § UG-125 に基づき、過渡的圧力サージを吸収するため ΔH = H_actual - H_req >= 1.2 m を義務化。",
    scienceTitle2: "蒸気ドーム脱気、ドルトン分圧法則および商業殺菌 Fo 致死値",
    scienceText2: "純粋な飽和水蒸気環境の維持が不可欠です。滞留した不凝縮ガス膜は熱伝達係数を急減させ、ボツリヌス芽胞生残のリスクを生じさせます。",
    box3Title: "ドルトンの分圧法則",
    box3Text: "P_全 = P_蒸気 + P_空気。わずか 3% の空気混入で実際の蒸気凝縮温度は 1.8°C 低下します。",
    box4Title: "12D ボツリヌス完全滅菌",
    box4Text: "Fo = ∫ 10^((T_eff - 121.11) / 10) dt >= 3.0 min が低酸性缶詰食品に法的に課される絶対的基準です。"
  }
};

const c = CONTENT[lang as Exclude<SupportedLanguage, 'en'>];

const breadcrumbs = [
  { label: t('nav.home'), href: tp('/') },
  { label: t('nav.tools'), href: tp('/tools/') },
  { label: c.breadcrumbsLabel }
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": `https://isitkitchensafe.com/${lang}/tools/commercial-hydrostatic-cooker-cooler-modeler/#webapp`,
      "url": `https://isitkitchensafe.com/${lang}/tools/commercial-hydrostatic-cooker-cooler-modeler/`,
      "name": c.h1,
      "applicationCategory": "EngineeringApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5 Canvas/CSS3.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": c.pageDescription
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": t('nav.home'),
          "item": `https://isitkitchensafe.com/${lang}/`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": t('nav.tools'),
          "item": `https://isitkitchensafe.com/${lang}/tools/`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": c.breadcrumbsLabel,
          "item": `https://isitkitchensafe.com/${lang}/tools/commercial-hydrostatic-cooker-cooler-modeler/`
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": c.faqs.map(f => ({
        "@type": "Question",
        "name": f.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": f.answer
        }
      }))
    }
  ]
};
---

<Layout
  title={c.pageTitle}
  description={c.pageDescription}
  structuredData={structuredData}
>
  <main class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
    <Breadcrumbs items={breadcrumbs} />

    <header class="mb-8 mt-4">
      <div class="flex items-center gap-2 mb-2">
        <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-100 text-blue-900 border border-blue-200">
          {c.badge}
        </span>
        <span class="text-xs text-muted font-mono">FDA 21 CFR § 113.40 &bull; ASME BPVC Sec VIII &bull; NFPA 86 &bull; OSHA 1910.106</span>
      </div>
      <h1 class="text-display-sm sm:text-display font-semibold text-ink tracking-tight mb-3">
        {c.h1}
      </h1>
      <p class="text-body-lg text-muted max-w-4xl leading-relaxed">
        {c.lead}
      </p>
    </header>

    <!-- Flagship Interactive Modeler Component -->
    <CommercialHydrostaticCookerCoolerModeler lang={lang} />

    <!-- Engineering & Thermodynamic Science Technical Reference -->
    <section class="my-16 space-y-12">
      <div class="border-t border-hairline pt-10">
        <h2 class="text-title-lg font-semibold text-ink tracking-tight mb-4">
          {c.scienceTitle1}
        </h2>
        <p class="text-body text-sm sm:text-base leading-relaxed mb-6">
          {c.scienceText1}
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="p-5 rounded-2xl bg-surface-soft border border-hairline">
            <h3 class="text-title-sm font-semibold text-ink mb-1.5">{c.box1Title}</h3>
            <p class="text-body text-xs leading-relaxed text-muted">{c.box1Text}</p>
          </div>
          <div class="p-5 rounded-2xl bg-surface-soft border border-hairline">
            <h3 class="text-title-sm font-semibold text-ink mb-1.5">{c.box2Title}</h3>
            <p class="text-body text-xs leading-relaxed text-muted">{c.box2Text}</p>
          </div>
        </div>
      </div>

      <div class="border-t border-hairline pt-10">
        <h2 class="text-title-lg font-semibold text-ink tracking-tight mb-4">
          {c.scienceTitle2}
        </h2>
        <p class="text-body text-sm sm:text-base leading-relaxed mb-6">
          {c.scienceText2}
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="p-5 rounded-2xl bg-surface-soft border border-hairline">
            <h3 class="text-title-sm font-semibold text-ink mb-1.5">{c.box3Title}</h3>
            <p class="text-body text-xs leading-relaxed text-muted">{c.box3Text}</p>
          </div>
          <div class="p-5 rounded-2xl bg-surface-soft border border-hairline">
            <h3 class="text-title-sm font-semibold text-ink mb-1.5">{c.box4Title}</h3>
            <p class="text-body text-xs leading-relaxed text-muted">{c.box4Text}</p>
          </div>
        </div>
      </div>

      <div class="border-t border-hairline pt-10">
        <h2 class="text-title-lg font-semibold text-ink tracking-tight mb-4">
          {lang === 'es' ? 'Preguntas Frecuentes (Termodinámica Hidrostática y Seguridad en Enlatados)' :
           lang === 'pt' ? 'Perguntas Frequentes (Termodinâmica e Segurança em Retortas Hidrostáticas)' :
           lang === 'zh-cn' ? '常见问题解答（连续式静水压杀菌热力学与罐装工业安全）' :
           'よくある質問（静水圧レトルト熱力学・缶詰殺菌安全工学）'}
        </h2>
        <div class="space-y-6">
          {c.faqs.map((faq) => (
            <div class="bg-surface-soft/60 border border-hairline rounded-2xl p-6">
              <h3 class="text-title-sm font-semibold text-ink mb-2">
                {faq.question}
              </h3>
              <p class="text-body text-sm leading-relaxed text-muted">
                {faq.answer}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>
