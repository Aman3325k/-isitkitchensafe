---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ThermalShockSimulator from '../../../components/ThermalShockSimulator.astro';
import type { SupportedLanguage } from '../../../i18n/ui';
import { useTranslations, useTranslatedPath } from '../../../i18n/utils';

export function getStaticPaths() {
  const availableLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'zh-cn', 'ja'];
  return [
    { params: { lang: 'es' }, props: { lang: 'es' as SupportedLanguage, availableLocales } },
    { params: { lang: 'pt' }, props: { lang: 'pt' as SupportedLanguage, availableLocales } },
    { params: { lang: 'zh-cn' }, props: { lang: 'zh-cn' as SupportedLanguage, availableLocales } },
    { params: { lang: 'ja' }, props: { lang: 'ja' as SupportedLanguage, availableLocales } }
  ];
}

interface Props {
  lang: SupportedLanguage;
  availableLocales: SupportedLanguage[];
}

const { lang, availableLocales } = Astro.props;
const t = useTranslations(lang);
const tp = useTranslatedPath(lang);

interface LocaleShockContent {
  pageTitle: string;
  pageDescription: string;
  badge: string;
  h1: string;
  heroSub: string;
  scienceTitle: string;
  scienceIntro: string;
  sciencePillars: Array<{ num: string; title: string; desc: string }>;
  faqs: Array<{ question: string; answer: string }>;
  breadcrumbs: Array<{ label: string; href?: string }>;
}

const CONTENT: Record<SupportedLanguage, LocaleShockContent> = {
  en: {} as any,
  es: {
    pageTitle: "Simulador de Choque Térmico y Umbral de Rotura de Utensilios | IsItKitchenSafe",
    pageDescription: "Calcula los límites de rotura por choque térmico, la tensión de tracción interna y el riesgo de estallido explosivo en vidrio templado, borosilicato, cerámica y hierro esmaltado ante cambios bruscos de temperatura.",
    badge: "Termodinámica Aplicada • Dinámica de Fracturas • Normas ASTM C149",
    h1: "Simulador de Choque Térmico y Umbral de Rotura de Utensilios",
    heroSub: "Evita explosiones catastróficas de fuentes de vidrio para horno, grietas en cerámica y deformaciones en sartenes. Calcula los diferenciales de temperatura (ΔT), la tensión interna y el riesgo de fragmentación antes de mover recipientes calientes.",
    scienceTitle: "La Física Oculta de las Explosiones por Choque Térmico",
    scienceIntro: "El choque térmico en la cocina no es cuestión de mala suerte; es un fallo mecánico gobernado por las leyes de la termodinámica del estado sólido:",
    sciencePillars: [
      {
        num: "01",
        title: "Coeficiente de Dilatación Térmica (CTE)",
