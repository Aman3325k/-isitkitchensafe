      },
      {
        question: "为什么玻璃烤盘炸裂时会发出像开枪一样的巨响并粉碎成无数碎片？",
        answer: "钢化玻璃表面存在深度淬火产生的极高表面压应力层。当热冲击拉应力破坏了这一保护包层时，内部被压缩积蓄的巨大弹性形变能会在微秒级时间内同时沿晶界爆发，产生高达115分贝的爆鸣声并向四周高速喷射锋利的颗粒状碎渣。"
      },
      {
        question: "为什么热烤盘绝对不能直接放在大理石或石英石台面上？",
        answer: "天然石材与石英石热容大且导热极快。接触瞬间会迅速将盘底热量吸走，底部微秒级收缩与上部200°C的膨胀状态形成巨大内剪切力，导致盘底直接炸脱或整体粉碎。"
      },
      {
        question: "冷冻室取出的烤碗可以直接放入烤箱烘烤吗？",
        answer: "绝对不行。从-18°C冷冻室直接放入200°C预热烤箱，温差高达218°C，无论钢化玻璃还是陶瓷炖盅都会因膨胀应力直接从中剖开断裂。"
      }
    ],
    breadcrumbs: [
      { label: "首页", href: "/zh-cn/" },
      { label: "工具箱", href: "/zh-cn/tools/" },
      { label: "热冲击与爆裂阈值模拟器" }
    ]
  },
  ja: {
    pageTitle: "調理器具の熱衝撃＆破裂閾値安全シミュレーター | IsItKitchenSafe",
    pageDescription: "強化ソーダ石灰ガラス、耐熱ホウケイ酸ガラス、陶磁器、ホーロー鍋の急激な温度変化における破壊限界、内部引張応力、爆発的飛散リスクを瞬時に計算。",
    badge: "固体材料熱力学 • 破壊力学 • ASTM C149 準拠",
    h1: "調理器具の熱衝撃＆破裂閾値安全シミュレーター",
    heroSub: "グラタン皿の粉砕爆発、陶磁器のひび割れ、高級フライパンの永久的な底反り事故を防止。熱い器具を動かしたり冷やす前に、安全な温度差（ΔT）と内部熱応力を確認しましょう。",
    scienceTitle: "調理器具が熱衝撃で爆発・破損する物理的メカニズム",
    scienceIntro: "台所でのガラス食器の破損は偶然の事故ではなく、固体材料の熱膨張と脆性破壊力学の法則に基づく必然的な物理現象です：",
    sciencePillars: [
      {
        num: "01",
        title: "熱膨張係数 (CTE) の決定的な違い",
        desc: "温度変化に対する体積の伸縮比率は熱膨張係数（α）で決まります。強化ソーダ石灰ガラスは9.0 × 10⁻⁶/°Cと大きく膨張しますが、ホウケイ酸ガラスはわずか3.3 × 10⁻⁶/°Cです。膨張率が大きいほど、急冷時に激しい内部応力差が発生します。"
      },
      {
        num: "02",
        title: "圧縮応力層と引張応力コアの崩壊",
        desc: "ガラスは圧縮には極めて強い（>1,000 MPa）反面、引張力には脆い（<100 MPa）特性があります。強化ガラスは表面を急冷して圧縮層を作っていますが、熱衝撃で表面が急収縮して限界を超えると、内部に蓄積された弾性エネルギーが一気に解放され爆発します。"
      },
      {
        num: "03",
        title: "人工大理石天板による急激な熱伝導とせん断応力",
        desc: "200°Cの熱い耐熱皿を18°Cの冷たい御影石や人造大理石の天板に直置きすると、底面のみが数秒で急冷却・収縮します。側面や料理は熱膨張したままのため、激しいせん断モーメントが発生して底抜け破裂を引き起こします。"
      }
    ],
    faqs: [
      {
        question: "昔のパイレックスに比べて現代のガラス皿が割れやすいのはなぜですか？",
        answer: "1998年以降、米国向け製品の多くが従来の耐熱ホウケイ酸ガラスから強化ソーダ石灰ガラスへ材質変更されたためです。ホウケイ酸ガラスは耐熱温度差が約170°Cありますが、一般的な強化ソーダ石灰ガラスは耐熱温度差が約50°C前後しかなく、熱衝撃に対して約3倍脆くなっています。"
      },
      {
        question: "ガラス皿が単にひび割れるだけでなく、銃声のような音を立てて粉砕するのはなぜですか？",
        answer: "強化ガラスは内部に約10,000 PSIの巨大な弾性歪みエネルギーを蓄えています。熱衝撃で表面の圧縮バランスが崩れた瞬間、その全エネルギーが一斉に解放されるため、115 dBの破裂音とともに無数の鋭利な破片が周囲へ高速飛散します。"
      },
      {
        question: "熱い耐熱皿を冷たい石のキッチントップに置いてはいけない理由は何ですか？",
        answer: "石材は熱伝導率が極めて高く、接触面から瞬時に熱を奪います。皿の底面だけが急速に冷えて縮み、熱い上部との間に強烈な引っ張りせん断応力が発生し、底が丸ごと抜け落ちたり粉々に割れたりします。"
      },
      {
        question: "冷凍庫（-18°C）から出したグラタン皿を予熱したオーブンに入れても大丈夫ですか？",
        answer: "ガラスや陶器の皿では絶対に避けてください。温差は200°Cを超え、耐熱限界を大幅に超過するため、加熱中に真っ二つに割れる可能性が極めて高くなります。"
      }
    ],
    breadcrumbs: [
      { label: "ホーム", href: "/ja/" },
      { label: "ツール", href: "/ja/tools/" },
      { label: "熱衝撃＆破裂閾値シミュレーター" }
    ]
  }
};

const c = CONTENT[lang] || CONTENT.es;

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": c.h1,
  "url": `https://isitkitchensafe.com/${lang}/tools/thermal-shock-simulator/`,
  "applicationCategory": "HealthApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "description": c.pageDescription,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};
---

<Layout title={c.pageTitle} description={c.pageDescription} faqs={c.faqs} availableLocales={availableLocales}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={c.breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1200px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-indigo-600 text-white mb-3">
        {c.badge}
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        {c.h1}
      </h1>
      <p class="text-body text-[15px] md:text-body-md leading-relaxed">
        {c.heroSub}
      </p>
    </header>

    <!-- Main Interactive Simulator -->
    <div class="mb-14">
      <ThermalShockSimulator lang={lang} />
    </div>

    <!-- Science Deep-Dive Section -->
    <section class="mb-14 border-t border-hairline pt-12 space-y-8">
      <div class="max-w-3xl">
        <span class="text-xs font-bold uppercase tracking-wider text-muted block mb-1">
          {c.badge}
        </span>
        <h2 class="text-title-lg md:text-display-sm font-medium text-ink tracking-tight mb-3">
          {c.scienceTitle}
        </h2>
        <p class="text-body text-[15px] leading-relaxed">
          {c.scienceIntro}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {c.sciencePillars.map(pillar => (
          <div class="p-6 rounded-2xl bg-surface-soft border border-hairline space-y-3">
            <div class="w-9 h-9 rounded-xl bg-indigo-600 text-white font-bold flex items-center justify-center text-sm">
              {pillar.num}
            </div>
            <h3 class="font-semibold text-ink text-base">{pillar.title}</h3>
            <p class="text-xs text-body leading-relaxed">
              {pillar.desc}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="border-t border-hairline pt-12">
      <h2 class="text-title-lg md:text-display-sm font-medium text-ink tracking-tight mb-8">
        {lang === 'zh-cn' ? '常见问题与科学解答' : lang === 'ja' ? 'よくあるご質問 (FAQ)' : lang === 'pt' ? 'Perguntas Frequentes' : 'Preguntas Frecuentes'}
      </h2>
      <div class="space-y-6 max-w-3xl">
        {c.faqs.map(faq => (
          <div class="border-b border-hairline pb-6">
            <h3 class="text-base font-semibold text-ink mb-2">
              {faq.question}
            </h3>
            <p class="text-body text-sm leading-relaxed">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>
