    cheatRows: [
      { code: "#1 PET / PETE", temp: "60℃ / 140°F", microwave: "不可 ❌", dishwasher: "不可 ❌", notes: "ペットボトル飲料や使い捨て容器。加熱で容易に変形・溶出するため加熱厳禁。" },
      { code: "#2 HDPE", temp: "110℃ / 230°F", microwave: "要注意 ⚠️", dishwasher: "要注意 ⚠️", notes: "丈夫なBPAフリー素材（まな板・ポリ容器）。冷蔵・冷凍に優秀だがレンジ強加熱は避ける。" },
      { code: "#3 PVC", temp: "60℃ / 140°F", microwave: "不可 ❌", dishwasher: "不可 ❌", notes: "業務用ラップ・塩ビ製品。高温や油分で可塑剤が食品へ移行しやすい。" },
      { code: "#4 LDPE", temp: "80℃ / 176°F", microwave: "不可 ❌", dishwasher: "不可 ❌", notes: "冷凍ジッパーバッグやチューブ容器。耐寒性に優れるが耐熱温度は低め。" },
      { code: "#5 PP", temp: "120℃ / 248°F", microwave: "要注意 ⚠️", dishwasher: "安全 ✅", notes: "最も耐熱性が高い食品用プラスチック（タッパー等）。食洗機は上段推奨、油分の多い高温加熱はガラス製が安心。" },
      { code: "#6 PS", temp: "74℃ / 165°F", microwave: "不可 ❌", dishwasher: "不可 ❌", notes: "発泡スチロール弁当箱やカップ麺容器。加熱で変形やスチレン溶出の恐れ。" },
      { code: "#7 その他", temp: "素材依存 (~100℃)", microwave: "不可 ❌", dishwasher: "要注意 ⚠️", notes: "BPAを含むポリカーボネート、BPAフリーのトライタン、熱に弱いPLAなどが混在。" }
    ],
    relatedTag: "関連インタラクティブツール",
    relatedPlasticTitle: "家庭内マイクロプラスチック・可塑剤リスク診断 →",
    relatedPlasticDesc: "プラスチック容器のレンジ加熱やまな板使用による1日の微細プラスチック摂取負荷を推定します。",
    relatedPanTitle: "AI フライパン傷・フッ素コーティング診断 →",
    relatedPanDesc: "傷のついたテフロン鍋がまだ安全に使えるか、買い替えが必要かを即座に判定します。",
    hubsTitle: "主要キッチン家電の安全ガイド一覧",
    hubsDesc: "2,000以上の調理器具・容器・食材について家電別の安全性を網羅しています。",
    hubLabels: {
      dishwasher: "食洗機ガイド",
      microwave: "電子レンジガイド",
      oven: "オーブンガイド",
      freezer: "冷凍庫ガイド",
      airfryer: "ノンフライヤーガイド",
      allTools: "ツール一覧を見る →"
    },
    faqTitle: "キッチン容器・調理器具の記号に関するよくある質問",
    faqs: [
      {
        question: "容器の底にある「ワイングラスとフォーク」のマークは何を意味しますか？",
        answer: "ワイングラスとフォークは、食品に接触しても安全な食品グレード素材であることを示す国際マーク（EU規則 1935/2004由来）です。食洗機対応や電子レンジ対応を意味するマークではないため、加熱や食洗機使用時は必ず他のマークも確認してください。"
      },
      {
        question: "プラスチック番号（#1〜#7）の中で電子レンジ・食洗機に最も安全なものはどれですか？",
        answer: "#5 PP（ポリプロピレン）が一般的なプラスチックの中で最も耐熱性が高く（約120℃）、繰り返し使えるレンジ・食洗機対応タッパーの標準素材です。#2 HDPEと#4 LDPEは冷凍・冷蔵に向いており、#1 PET、#3 PVC、#6 PS（発泡スチロール）、素材不明の#7はレンジ加熱厳禁です。"
      },
      {
        question: "お皿やマグカップの裏にある「3本の波線」マークの意味は？",
        answer: "2〜3本の水平な波線は「電子レンジ対応」を表す国際的なピクトグラムです。通常の温め調理で溶解や火花が起きないことを示します。波線に斜線やバツ印が入っている場合は「電子レンジ使用不可」です。"
      },
      {
        question: "フライパンや鍋の底にある「バネ・コイル状」のマークは何ですか？",
        answer: "横並びの螺旋コイル記号は「IHクッキングヒーター対応」を意味します。底面に磁性ステンレスや鉄が使われており、IH調理器（およびガス・電気コンロ）で安全に加熱できる証です。"
      },
      {
        question: "「BPAフリー」と書いてあればプラスチック容器を電子レンジで高温加熱しても安心ですか？",
        answer: "いいえ。「BPAフリー」はビスフェノールA不使用を示すのみで、高温耐熱や微細粒子ゼロを保証するものではありません。代替物質（BPS/BPF等）を含む製品もあり、油分の多い食品をプラスチックで加熱するとマイクロプラスチック溶出が増えます。高温加熱は耐熱ガラスや陶器への移し替えをおすすめします。"
      }
    ],
    breadcrumbs: [
      { label: "ホーム", href: "/ja/" },
      { label: "ツール", href: "/ja/tools/" },
      { label: "キッチン記号解読ツール" }
    ]
  }
};

const c = CONTENT[lang as Exclude<SupportedLanguage, 'en'>] || CONTENT.es;
const localizedUrl = `https://isitkitchensafe.com/${lang}/tools/kitchen-symbol-decoder/`;

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": c.h1,
  "url": localizedUrl,
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript.",
  "description": c.pageDescription,
  "inLanguage": lang === 'zh-cn' ? 'zh-CN' : lang,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": c.faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={c.pageTitle}
  description={c.pageDescription}
  excludeFaqSchema={true}
  availableLocales={availableLocales}
  lang={lang}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={c.breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1140px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-signature-coral text-white mb-3">
        {c.badge}
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        {c.h1}
      </h1>
      <p class="text-body text-[15px] md:text-[16px] leading-relaxed">
        {c.heroSub}
      </p>
    </header>

    <!-- Main Interactive Tool -->
    <div class="mb-14">
      <KitchenSymbolDecoder lang={lang} />
    </div>

    <!-- Plastic Resin Codes Cheat Sheet -->
    <section class="mb-14 space-y-5">
      <div>
        <h2 class="text-title-lg font-medium text-ink tracking-tight mb-2">
          {c.cheatTitle}
        </h2>
        <p class="text-body text-[14.5px] leading-relaxed">
          {c.cheatIntro}
        </p>
      </div>

      <div class="border border-hairline rounded-xl overflow-hidden bg-canvas">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="bg-surface-strong border-b border-hairline text-ink font-semibold">
              <tr>
                <th class="p-3.5">{c.cheatHeaders[0]}</th>
                <th class="p-3.5">{c.cheatHeaders[1]}</th>
                <th class="p-3.5">{c.cheatHeaders[2]}</th>
                <th class="p-3.5">{c.cheatHeaders[3]}</th>
                <th class="p-3.5">{c.cheatHeaders[4]}</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-hairline">
              {c.cheatRows.map((row, idx) => (
                <tr class={idx % 2 === 0 ? 'bg-canvas' : 'bg-surface-soft'}>
                  <td class="p-3.5 font-semibold text-ink whitespace-nowrap">{row.code}</td>
                  <td class="p-3.5 text-body whitespace-nowrap">{row.temp}</td>
                  <td class="p-3.5 text-xs font-bold whitespace-nowrap text-ink">{row.microwave}</td>
                  <td class="p-3.5 text-xs font-bold whitespace-nowrap text-ink">{row.dishwasher}</td>
                  <td class="p-3.5 text-body text-[13px]">{row.notes}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Related Interactive Tools -->
    <section class="mb-14 grid grid-cols-1 md:grid-cols-2 gap-5">
      <a
        href={`/${lang}/tools/plasticizer-microplastic-burden-estimator/`}
        class="p-6 rounded-2xl bg-surface-soft border border-hairline hover:border-signature-coral transition-all group block"
      >
        <span class="text-[11px] font-bold uppercase tracking-wider text-signature-coral block mb-1.5">
          {c.relatedTag}
        </span>
        <h3 class="text-title-sm font-semibold text-ink group-hover:text-signature-coral transition-colors mb-1.5">
          {c.relatedPlasticTitle}
        </h3>
        <p class="text-[13.5px] text-body leading-relaxed">
          {c.relatedPlasticDesc}
        </p>
      </a>

      <a
        href={`/${lang}/tools/pan-scratch-inspector/`}
        class="p-6 rounded-2xl bg-surface-soft border border-hairline hover:border-signature-coral transition-all group block"
      >
        <span class="text-[11px] font-bold uppercase tracking-wider text-signature-coral block mb-1.5">
          {c.relatedTag}
        </span>
        <h3 class="text-title-sm font-semibold text-ink group-hover:text-signature-coral transition-colors mb-1.5">
          {c.relatedPanTitle}
        </h3>
        <p class="text-[13.5px] text-body leading-relaxed">
          {c.relatedPanDesc}
        </p>
      </a>
    </section>

    <!-- Core Appliance Hub Strip -->
    <section class="mb-14 p-6 rounded-2xl bg-surface-soft border border-hairline">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <h2 class="text-title-sm font-semibold text-ink mb-1">
            {c.hubsTitle}
          </h2>
          <p class="text-[13px] text-muted">
            {c.hubsDesc}
          </p>
        </div>
        <div class="flex flex-wrap gap-2">
          <a href={`/${lang}/dishwasher/`} class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral transition-colors">{c.hubLabels.dishwasher}</a>
          <a href={`/${lang}/microwave/`} class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral transition-colors">{c.hubLabels.microwave}</a>
          <a href={`/${lang}/oven/`} class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral transition-colors">{c.hubLabels.oven}</a>
          <a href={`/${lang}/freezer/`} class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral transition-colors">{c.hubLabels.freezer}</a>
          <a href={`/${lang}/airfryer/`} class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral transition-colors">{c.hubLabels.airfryer}</a>
          <a href={`/${lang}/tools/`} class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-primary text-on-primary hover:bg-primary-active transition-colors">{c.hubLabels.allTools}</a>
        </div>
      </div>
    </section>

    <!-- FAQ Section (5 Consumer-Friendly FAQs) -->
    <section class="mb-8">
      <h2 class="text-title-lg font-medium text-ink tracking-tight mb-6">
        {c.faqTitle}
      </h2>
      <div class="space-y-4">
        {c.faqs.map(faq => (
          <details class="group p-5 bg-surface-soft border border-hairline rounded-xl" open>
            <summary class="text-title-sm font-semibold text-ink cursor-pointer list-none flex items-center justify-between gap-3">
              <span>{faq.question}</span>
              <span class="text-muted text-sm transition-transform group-open:rotate-180 shrink-0" aria-hidden="true">&#9662;</span>
            </summary>
            <p class="text-[14px] text-body leading-relaxed mt-3 pt-3 border-t border-hairline/70">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </div>
</Layout>
