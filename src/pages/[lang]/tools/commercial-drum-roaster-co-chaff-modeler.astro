        question: "なぜコーヒーや麦芽のチャフ（銀皮）は激しい粉塵爆発（St 1〜St 2・Kst）を引き起こすのか？",
        answer: "焙煎中（特に約200°Cのファーストクラック時）に豆から剥離するチャフは極めて乾燥した植物繊維です。空気輸送中の摩擦により粒子径60ミクロン以下の微粉末へと粉砕され、比表面積が急増します。サイクロン内の粉塵濃度が爆発下限濃度（MEC ≈ 40〜60 g/m³）を超えている状態で火花が混入すると、Kst = 150〜220 bar·m/s の高速爆燃波が発生し、未対策の集塵機を瞬時に破壊します。"
      },
      {
        question: "排気ダクトの搬送風速はどのように水平配管内のチャフ沈降と自己発火を防ぐのか？",
        answer: "チャフ粉塵を気流中に浮遊させ続けるためには、跳躍限界流速（約14〜16 m/s）以上を維持しなければなりません。ファンの劣化やダンパー絞りで風速が低下すると、チャフが水平配管底部に沈降・堆積します。この堆積層は断熱材として熱を蓄積し、熱分解タールを吸収して燻煙自己発火火災を引き起こします。"
      },
      {
        question: "NFPA 68 はサイクロン集塵機の爆発放散面積（Av）をどのように規定しているか？",
        answer: "NFPA 68 では、容器容積（V）、粉塵爆発指数（Kst）、容器耐圧（Pred）に基づいて放散口面積 Av を計算します（Av = 1.0·10⁻⁴ · (1 + 1.54·Pstat^0.5) · Kst · V^0.75 / √Pred）。St 1 のチャフを扱う容積 1.8 m³ のサイクロンでは、少なくとも 0.38 m² の放散パネルを屋外の安全区画に向けて設置し、建物内への爆風伝播を遮断しなければなりません。"
      },
      {
        question: "NFPA 61 § 8.4 に基づく赤外線火花検知器と超高速水噴霧連動の仕組みとは？",
        answer: "排気ダクト内に波長 1.0〜3.0 μm に感度を持つ赤外線火花センサーを設置し、火花を感知すると 50〜80 ミリ秒以内に高圧微細水噴霧ノズルから水を自動放射します。これにより、燃料密度の高いサイクロン内部へ火花が到達する前に空中で確実に消火されます。"
      },
      {
        question: "OSHA および NIOSH が定める一酸化炭素の職業暴露限界値とは？",
        answer: "一酸化炭素は酸素の約210倍の強さでヘモグロビンと結合し、酸素供給を遮断します。OSHAの許容濃度（PEL）は 50 ppm（8時間TWA）、NIOSHの推奨限度は 35 ppm です。1,200 ppm は即座に生命の危険をもたらす IDLH 限界値であり、数分間の吸入で意識喪失や呼吸停止を招きます。"
      }
    ],
    scienceTitle1: "バーナー燃焼化学量論と一酸化炭素発生メカニズム",
    scienceText1: "強制通風バーナーでは酸素濃度の精密制御が必須です。空気比（λ < 1.0）の低下は未燃ガス中のCO濃度を急激に上昇させ、重大な中毒事故を誘発します。",
    box1Title: "第1段階：急速熱分解",
    box1Text: "CH₄ + 1.5 O₂ → CO + 2 H₂O。高温火炎コアでの炭化水素分解。",
    box2Title: "第2段階：熱酸化による CO2 化",
    box2Text: "CO + OH* → CO₂ + H*。十分な過剰空気（λ ≥ 1.15）下で進行する完全燃焼反応。",
    scienceTitle2: "チャフ粉塵爆燃と NFPA 68 放散口面積設計",
    scienceText2: "有機粉塵の爆発圧力上昇速度は立方則に従います。NFPA 68 基準に適合した爆発放散パネルをサイクロンに配備することが安全確保の絶対条件です。",
    box3Title: "粉塵爆発立方則",
    box3Text: "K_st = (dP/dt)_max · V^(1/3)。集塵機破壊を防ぐための設計パラメータ。",
    box4Title: "跳躍限界流速 (Saltation)",
    box4Text: "V_salt ≥ 16 m/s。水平ダクト全域で浮遊を維持し、堆積チャフの自己発火を防止。"
  }
};

const c = CONTENT[lang as Exclude<SupportedLanguage, 'en'>];

const breadcrumbs = [
  { label: t('nav.home' as any) || 'Home', href: tp('/') },
  { label: t('nav.tools' as any) || 'Tools', href: tp('/tools/') },
  { label: c.breadcrumbsLabel }
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": c.pageTitle,
      "url": `https://isitkitchensafe.com/${lang}/tools/commercial-drum-roaster-co-chaff-modeler/`,
      "applicationCategory": "EngineeringApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5 Canvas/CSS3.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": c.pageDescription
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": `https://isitkitchensafe.com/${lang}/`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Tools",
          "item": `https://isitkitchensafe.com/${lang}/tools/`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": c.breadcrumbsLabel,
          "item": `https://isitkitchensafe.com/${lang}/tools/commercial-drum-roaster-co-chaff-modeler/`
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": c.faqs.map(f => ({
        "@type": "Question",
        "name": f.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": f.answer
        }
      }))
    }
  ]
};
---

<Layout
  title={c.pageTitle}
  description={c.pageDescription}
  structuredData={structuredData}
>
  <main class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
    <Breadcrumbs items={breadcrumbs} />

    <header class="mb-8 mt-4">
      <div class="flex items-center gap-2 mb-2">
        <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-800">
          {c.badge}
        </span>
        <span class="text-xs text-muted font-mono">NFPA 61 &bull; NFPA 86 &bull; NFPA 68 &bull; OSHA 29 CFR 1910.1200</span>
      </div>
      <h1 class="text-display-sm sm:text-display font-semibold text-ink tracking-tight mb-3">
        {c.h1}
      </h1>
      <p class="text-body-lg text-muted max-w-4xl leading-relaxed">
        {c.lead}
      </p>
    </header>

    <!-- Flagship Interactive Modeler Component with Locale -->
    <CommercialContinuousDrumRoasterModeler lang={lang} />

    <!-- Engineering Science & Combustion Physics Section -->
    <section class="my-16 space-y-12">
      <div class="border-t border-hairline pt-10">
        <h2 class="text-title-lg font-semibold text-ink tracking-tight mb-4">
          {c.scienceTitle1}
        </h2>
        <p class="text-body text-sm sm:text-base leading-relaxed mb-6">
          {c.scienceText1}
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="p-5 rounded-2xl bg-surface-soft border border-hairline">
            <h3 class="text-title-sm font-semibold text-ink mb-1.5">{c.box1Title}</h3>
            <p class="text-body text-xs leading-relaxed text-muted">{c.box1Text}</p>
          </div>
          <div class="p-5 rounded-2xl bg-surface-soft border border-hairline">
            <h3 class="text-title-sm font-semibold text-ink mb-1.5">{c.box2Title}</h3>
            <p class="text-body text-xs leading-relaxed text-muted">{c.box2Text}</p>
          </div>
        </div>
      </div>

      <div class="border-t border-hairline pt-10">
        <h2 class="text-title-lg font-semibold text-ink tracking-tight mb-4">
          {c.scienceTitle2}
        </h2>
        <p class="text-body text-sm sm:text-base leading-relaxed mb-6">
          {c.scienceText2}
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="p-5 rounded-2xl bg-surface-soft border border-hairline">
            <h3 class="text-title-sm font-semibold text-ink mb-1.5">{c.box3Title}</h3>
            <p class="text-body text-xs leading-relaxed text-muted">{c.box3Text}</p>
          </div>
          <div class="p-5 rounded-2xl bg-surface-soft border border-hairline">
            <h3 class="text-title-sm font-semibold text-ink mb-1.5">{c.box4Title}</h3>
            <p class="text-body text-xs leading-relaxed text-muted">{c.box4Text}</p>
          </div>
        </div>
      </div>

      <div class="border-t border-hairline pt-10">
        <h2 class="text-title-lg font-semibold text-ink tracking-tight mb-4">
          {lang === 'es' ? 'Preguntas Frecuentes (Cinética de Combustión y Cascarilla)' :
           lang === 'pt' ? 'Perguntas Frequentes (Combustão e Segurança de Palha)' :
           lang === 'zh-cn' ? '常见问题解答（滚筒烘焙燃烧动力学与银皮粉尘安全）' :
           'よくある質問（ドラム焙煎燃焼反応速度論・チャフ安全）'}
        </h2>
        <div class="space-y-6">
          {c.faqs.map((faq) => (
            <div class="bg-surface-soft/60 border border-hairline rounded-2xl p-6">
              <h3 class="text-title-sm font-semibold text-ink mb-2">
                {faq.question}
              </h3>
              <p class="text-body text-sm leading-relaxed text-muted">
                {faq.answer}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>
