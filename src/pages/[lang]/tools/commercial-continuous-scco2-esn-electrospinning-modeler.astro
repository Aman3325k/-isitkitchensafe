      },
      {
        question: "非热力学scCO2电纺如何实现益生菌存活率>98%并抵御胃酸侵蚀？",
        answer: "传统喷雾干燥进风温度高达140–180°C，剧烈热激引发核糖体变性与细胞膜破裂，导致55%至85%的菌体死亡。scCO2-ESN全程在32°C至36°C的温和生理温度下运行，无热蒸发破坏。同时，菌体处于高压密相CO2中的停留时间被精确限制在120秒以内（远低于高压杀菌阈值），确保活菌落数（CFU）保留率高达98.4%以上。成型的核壳蛋白多糖纳米结构具备曲折分子阻隔效应：在模拟胃液（pH 2.0，37°C）中，氢键使聚合物壳层收缩致密，阻止酸液渗透（存活率>96%）；到达弱碱性小肠液（pH 6.8–7.4）后，去质子化促使基质在30至60分钟内迅速溶胀降解，将益生菌精准递送至肠道。"
      },
      {
        question: "与喷雾冷冻干燥（SFD）相比，scCO2-ESN在比能耗（SEC）与脱碳方面有何突破？",
        answer: "喷雾冷冻干燥（SFD）虽能保护热敏活性，但需液氮超低温冷冻与数天深度高真空升华（<0.1 mbar），每公斤干燥产品耗电高达8.5至14.0 kWh。相比之下，scCO2-ESN在常压收集区运作，主要依赖静电力拉伸固化而非蒸发潜热。总单位质量电耗（SEC）仅为0.42至0.78 kWh/kg，较传统热力喷雾干燥节能84%至88%，较喷雾冷冻干燥节能94%以上，将功能食品原料的碳足迹降至0.45 kg CO2e/kg以下。"
      },
      {
        question: "系统在高压CO2安全、防电弧闪络及食品接触卫生方面符合哪些规范？",
        answer: "机组承压设计压力达250 bar，工作静电电压达60 kV DC。高压管路与反应釜符合ASME BPVC第VIII卷第1分册规范，配备快开爆破片与比例安全泄压阀。静电电气安全严格符合IEEE Std 510与NFPA 77标准，搭载高速光学火花传感器与响应时间<0.2 µs的固态电子消弧电路，一旦发生阻抗瞬变即刻切断高压。食品接触表面符合3-A卫生标准60-01与EHEDG Class I，采用Ra ≤ 0.15 µm的电解抛光316L不锈钢与食品级Kalrez全氟醚橡胶密封件，支持全自动原位清洗（CIP）。"
      }
    ]
  }
};

const c = CONTENT[lang as Exclude<SupportedLanguage, 'en'>];

const breadcrumbs = [
  { label: t('nav.home') || 'Home', href: tp('/') },
  { label: t('nav.tools') || 'Tools', href: tp('/tools/') },
  { label: c.breadcrumbsLabel }
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": `https://isitkitchensafe.com/${lang}/tools/commercial-continuous-scco2-esn-electrospinning-modeler/#webapp`,
      "url": `https://isitkitchensafe.com/${lang}/tools/commercial-continuous-scco2-esn-electrospinning-modeler/`,
      "name": c.h1,
      "applicationCategory": "EngineeringApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5 Canvas/CSS3.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": c.pageDescription
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": t('nav.home') || 'Home',
          "item": `https://isitkitchensafe.com${tp('/')}`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": t('nav.tools') || 'Tools',
          "item": `https://isitkitchensafe.com${tp('/tools/')}`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": c.breadcrumbsLabel,
          "item": `https://isitkitchensafe.com/${lang}/tools/commercial-continuous-scco2-esn-electrospinning-modeler/`
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": c.faqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
};
---

<Layout title={c.pageTitle} description={c.pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <Breadcrumbs items={breadcrumbs} />

    <!-- Hero Header -->
    <div class="mb-10 text-center max-w-4xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-950 text-emerald-300 border border-emerald-800 mb-4">
        <span>{c.badge}</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-ink tracking-tight mb-4 leading-tight">
        {c.h1}
      </h1>
      <p class="text-base sm:text-lg text-muted leading-relaxed">
        {c.lead}
      </p>
    </div>

    <!-- Interactive Simulator Component -->
    <CommercialContinuousScco2EsnModeler lang={lang} />

    <!-- In-Depth Technical & Regulatory FAQs -->
    <div class="mt-16 bg-surface p-6 sm:p-10 rounded-3xl border border-hairline">
      <h2 class="text-2xl font-bold text-ink mb-2">
        {lang === 'es' ? 'Preguntas Frecuentes Técnicas y Regulatorias de Ingeniería' :
         lang === 'pt' ? 'Perguntas Frequentes Técnicas e Regulatórias de Engenharia' :
         lang === 'ja' ? '技術・法規制エンジニアリングFAQ（よくある質問）' :
         '工程技术与法规符合性常见问题 (FAQ)'}
      </h2>
      <p class="text-sm text-muted mb-8">
        {lang === 'es' ? 'Explicaciones autorizadas sobre plastificación con CO2 supercrítico, electrohidrodinámica del cono de Taylor, cinética de supervivencia probiótica y normas IEEE de supresión de arco.' :
         lang === 'pt' ? 'Explicações técnicas aprofundadas sobre plastificação com CO2 supercrítico, eletro-hidrodinâmica do cone de Taylor, sobrevivência probiótica e normas IEEE de extinção de centelha.' :
         lang === 'ja' ? '超臨界CO2高分子可塑化、テイラーコーン動電学、プロバイオティクス生菌保護機構、IEEE高電圧消弧規格に関する専門技術解説。' :
         '关于超临界二氧化碳聚合物塑化机理、泰勒锥电水动力学、益生菌活菌动力学保护及IEEE高压消弧标准的专业权威解析。'}
      </p>
      
      <div class="space-y-6">
        {c.faqs.map(faq => (
          <div class="border-b border-hairline/60 pb-6 last:border-b-0 last:pb-0">
            <h3 class="text-base sm:text-lg font-bold text-ink mb-2">{faq.question}</h3>
            <p class="text-sm text-muted leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</Layout>