const c = CONTENT[lang];

const breadcrumbs = [
  { label: t('nav.home') || 'Home', href: tp('/') },
  { label: t('nav.tools') || 'Tools', href: tp('/tools/') },
  { label: c.breadcrumbsLabel }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": c.faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};

const toolSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": c.h1,
  "applicationCategory": "EngineeringApplication",
  "operatingSystem": "All",
  "description": c.pageDescription,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
};
---

<Layout title={c.pageTitle} description={c.pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(toolSchema)} />

  <div class="container mx-auto px-4 py-8 max-w-7xl">
    <Breadcrumbs items={breadcrumbs} />

    <header class="mb-10 text-center max-w-4xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-950 text-emerald-400 border border-emerald-800/80 mb-4 shadow-xs">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        {c.badge}
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-ink tracking-tight mb-4">
        {c.h1}
      </h1>
      <p class="text-base sm:text-lg text-body leading-relaxed max-w-3xl mx-auto">
        {c.lead}
      </p>
    </header>

    <!-- Localized Interactive Component -->
    <CommercialContinuousHfdVcsModeler lang={lang} />

    <!-- In-Depth Localized FAQ Accordion -->
    <div class="mt-16 space-y-12 max-w-5xl mx-auto text-ink">
      <section class="bg-surface-soft border border-hairline rounded-3xl p-6 sm:p-8 lg:p-10 shadow-xs">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight mb-6">
          {lang === 'es' && "Preguntas Frecuentes: Sinterizado Dieléctrico y Crio-Vitrificación HFD-VCS"}
          {lang === 'pt' && "Perguntas Frequentes: Sinterização Dielétrica e Crio-Vitrificação HFD-VCS"}
          {lang === 'zh-cn' && "常见技术问题解答：连续式 HFD-VCS 射频烧结与真空冷冻稳定工程"}
          {lang === 'ja' && "よくある技術質問：HFD-VCS 高周波誘電体焼結・超深真空凍結安定化工学"}
        </h2>
        <div class="space-y-4">
          {c.faqs.map(faq => (
            <details class="group bg-surface border border-hairline rounded-2xl p-5 open:bg-surface-soft transition-colors cursor-pointer">
              <summary class="font-semibold text-ink text-sm sm:text-base flex items-center justify-between gap-4 list-none">
                <span>{faq.question}</span>
                <span class="text-emerald-400 group-open:rotate-180 transition-transform">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </span>
              </summary>
              <p class="mt-3 text-body text-xs sm:text-sm leading-relaxed border-t border-hairline/60 pt-3">
                {faq.answer}
              </p>
            </details>
          ))}
        </div>
      </section>

      <!-- Related Flagship Diagnostic Tools Navigation -->
      <section class="border-t border-hairline pt-10">
        <h2 class="text-xl font-bold text-ink mb-6">
          {lang === 'es' && "Herramientas Diagnósticas Relacionadas en Física de Alimentos e Ingeniería Celular"}
          {lang === 'pt' && "Ferramentas Diagnósticas Relacionadas em Física de Alimentos e Engenharia Celular"}
          {lang === 'zh-cn' && "相关旗舰级食品物理学与细胞农业工程诊断模拟工具"}
          {lang === 'ja' && "関連する食品物理工学および細胞農業工学診断シミュレーター"}
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <a href={tp("/tools/commercial-continuous-dcm-lfad-modeler/")} class="p-4 rounded-xl bg-surface border border-hairline hover:border-emerald-500 transition-colors block">
            <span class="text-xs font-bold text-sky-400 uppercase tracking-wider block mb-1">DCM-LFAD</span>
            <strong class="text-sm text-ink block mb-1">
              {lang === 'es' && "Simulador Continuo DCM-LFAD"}
              {lang === 'pt' && "Modelador Contínuo DCM-LFAD"}
              {lang === 'zh-cn' && "连续式 DCM-LFAD 膜澄清模拟器"}
              {lang === 'ja' && "連続式 DCM-LFAD 膜清澄化モデラー"}
            </strong>
            <span class="text-xs text-muted block">
              {lang === 'es' && "Clarificación cerámica dinámica de jugos y caldos sin diatomeas."}
              {lang === 'pt' && "Clarificação cerâmica dinâmica de sucos e caldos sem diatomácea."}
              {lang === 'zh-cn' && "动态旋转陶瓷盘与声波脱附高浊度发酵液澄清模拟。"}
              {lang === 'ja' && "回転セラミックディスクと音響脱着による清澄化。"}
            </span>
          </a>
          <a href={tp("/tools/commercial-continuous-hse-hct-mycoprotein-texturizing-modeler/")} class="p-4 rounded-xl bg-surface border border-hairline hover:border-emerald-500 transition-colors block">
            <span class="text-xs font-bold text-emerald-400 uppercase tracking-wider block mb-1">HSE-HCT</span>
            <strong class="text-sm text-ink block mb-1">
              {lang === 'es' && "Texturizador de Micoproteína HSE-HCT"}
              {lang === 'pt' && "Texturizador de Micoproteína HSE-HCT"}
              {lang === 'zh-cn' && "HSE-HCT 菌丝蛋白组织化模拟器"}
              {lang === 'ja' && "HSE-HCT マイコプロテイン組織化"}
            </strong>
            <span class="text-xs text-muted block">
              {lang === 'es' && "Extrusión en boquilla plana y cavitación hidrodinámica."}
              {lang === 'pt' && "Extrusão de fenda e cavitação hidrodinâmica."}
              {lang === 'zh-cn' && "狭缝挤压与水动力空化植物肉纤维定向模拟。"}
              {lang === 'ja' && "スリットダイ押出とキャビテーション配向モデラー。"}
            </span>
          </a>
          <a href={tp("/tools/commercial-continuous-scco2-esn-electrospinning-modeler/")} class="p-4 rounded-xl bg-surface border border-hairline hover:border-emerald-500 transition-colors block">
            <span class="text-xs font-bold text-emerald-400 uppercase tracking-wider block mb-1">scCO2-ESN</span>
            <strong class="text-sm text-ink block mb-1">
              {lang === 'es' && "Electrohilado Asistido por scCO2"}
              {lang === 'pt' && "Eletrofiação Assistida por scCO2"}
              {lang === 'zh-cn' && "scCO2-ESN 超临界静电纺丝"}
              {lang === 'ja' && "scCO2-ESN 超臨界電界紡糸"}
            </strong>
            <span class="text-xs text-muted block">
              {lang === 'es' && "Nanofibras bioactivas con CO2 supercrítico."}
              {lang === 'pt' && "Nanofibras bioativas com CO2 supercrítico."}
              {lang === 'zh-cn' && "超临界流体辅助生物活性纳米纤维纺丝模拟。"}
              {lang === 'ja' && "超臨界アシスト生体活性ナノファイバー紡糸。"}
            </span>
          </a>
          <a href={tp("/tools/commercial-rf-post-bake-leveling-modeler/")} class="p-4 rounded-xl bg-surface border border-hairline hover:border-emerald-500 transition-colors block">
            <span class="text-xs font-bold text-amber-400 uppercase tracking-wider block mb-1">RF Leveling</span>
            <strong class="text-sm text-ink block mb-1">
              {lang === 'es' && "Nivelador Dieléctrico RF"}
              {lang === 'pt' && "Nivelador Dielétrico RF"}
              {lang === 'zh-cn' && "工业射频介电均湿模拟器"}
              {lang === 'ja' && "連続式高周波均湿モデラー"}
            </strong>
            <span class="text-xs text-muted block">
              {lang === 'es' && "Control volumétrico de humedad sin embalamiento térmico."}
              {lang === 'pt' && "Controle volumétrico de umidade por RF industrial."}
              {lang === 'zh-cn' && "工业射频均匀脱水与防热失控物理模拟。"}
              {lang === 'ja' && "高周波水分レベリングと熱暴走防止シミュレーション。"}
            </span>
          </a>
        </div>
      </section>
    </div>
  </div>
</Layout>
