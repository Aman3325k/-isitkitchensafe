---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import RangeHoodExtractionModeler from '../../../components/RangeHoodExtractionModeler.astro';
import type { SupportedLanguage } from '../../../i18n/ui';
import { useTranslations, useTranslatedPath } from '../../../i18n/utils';

export function getStaticPaths() {
  const availableLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'zh-cn', 'ja'];
  return [
    { params: { lang: 'es' }, props: { lang: 'es' as SupportedLanguage, availableLocales } },
    { params: { lang: 'pt' }, props: { lang: 'pt' as SupportedLanguage, availableLocales } },
    { params: { lang: 'zh-cn' }, props: { lang: 'zh-cn' as SupportedLanguage, availableLocales } },
    { params: { lang: 'ja' }, props: { lang: 'ja' as SupportedLanguage, availableLocales } }
  ];
}

interface Props {
  lang: SupportedLanguage;
  availableLocales: SupportedLanguage[];
}

const { lang, availableLocales } = Astro.props;
const t = useTranslations(lang);
const tp = useTranslatedPath(lang);

interface LocaleContent {
  pageTitle: string;
  pageDescription: string;
  breadcrumbs: Array<{ label: string; href?: string }>;
  faqs: Array<{ question: string; answer: string }>;
  monoBadge: string;
  monoTitle: string;
  monoSub: string;
  monoSection1Title: string;
  monoSection1Body: string;
  monoSection2Title: string;
  monoSection2Body: string;
  monoSection3Title: string;
  monoSection3Body: string;
}

const CONTENT: Record<SupportedLanguage, LocaleContent> = {
  en: {} as any,
  es: {
    pageTitle: "Modelador de Eficiencia de Campanas Extractoras (VOC, NO2 y PM2.5) | IsItKitchenSafe",
    pageDescription: "Simule penachos de dióxido de nitrógeno en estufas de gas, dispersión de aerosoles PM2.5 al cocinar, fricción aerodinámica de conductos y riesgo de asma pediátrica.",
    breadcrumbs: [
      { label: 'Inicio', href: '/es/' },
      { label: 'Herramientas', href: '/es/tools/' },
      { label: 'Modelador de Eficiencia de Campanas' }
    ],
    monoBadge: "Mecánica de Fluidos y Toxicología Ambiental",
    monoTitle: "Modelador de Eficiencia de Campanas Extractoras (VOC, NO2 y PM2.5)",
    monoSub: "Simule penachos de combustión de gas, dispersión de aerosoles PM2.5, atrito en conductos y riesgos respiratorios infantiles.",
    monoSection1Title: "1. Aerodinámica del Penacho Térmico de Cocina",
    monoSection1Body: "Al cocinar, el calor ascendente forma un penacho térmico que se ensancha en un ángulo de entre 10° y 15°. Si la campana extractora no tiene el fondo suficiente (por ejemplo, microondas extractores de 15 pulgadas sobre placas de 24 pulgadas), los humos y aerosoles escapan hacia el techo y la zona de respiración de los ocupantes.",
    monoSection2Title: "2. Química de Combustión del Gas: Dióxido de Nitrógeno y Benceno",
    monoSection2Body: "Las llamas de gas natural alcanzan más de 1.400°C, oxidando el nitrógeno del aire en dióxido de nitrógeno (NO2). Estudios de la Universidad de Stanford (Kashtan et al. 2023) revelaron además que los quemadores emiten benceno no quemado en concentraciones similares al humo de tabaco, aumentando el riesgo de leucemia.",
    monoSection3Title: "3. La Ilusión de las Campanas de Recirculación con Filtro de Carbón",
    monoSection3Body: "Las campanas sin salida al exterior usan filtros de carbón activo. El carbón retiene olores y grasas, pero absorbe exactamente un 0% de NO2 y monóxido de carbono (CO). Todo el gas tóxico se reintroduce directamente en la vivienda.",
    faqs: [
      {
        question: "¿Eliminan las campanas de recirculación sin salida el dióxido de nitrógeno (NO2)?",
        answer: "No, prácticamente un 0%. El carbón activado retiene partículas pesadas y olores, pero carece de afinidad química para capturar moléculas inorgánicas ligeras como NO2 y CO. El 100% de los gases de combustión del gas permanecen en el hogar."
      },
      {
        question: "¿Cuánto caudal (CFM) necesito realmente para una estufa de gas?",
        answer: "La norma HVI exige al menos 100 CFM reales por cada 10.000 BTU de potencia total de la placa. Para una placa estándar de 4 quemadores (40.000 BTU) se requieren al menos 400 CFM. En placas de inducción se recomienda una base de 10 a 12 CFM por pulgada de ancho."
      },
      {
        question: "¿Por qué se captura mucho mejor el humo en los fuegos traseros?",
        answer: "Por el 'efecto guía del salpicadero'. La pared vertical actúa como un deflector aerodinámico natural que dirige el penacho térmico directamente hacia el colector de la campana, mientras que en los quemadores delanteros el humo se dispersa fácilmente."
      },
      {
        question: "¿Provocan realmente las estufas de gas asma infantil?",
        answer: "Sí. Un metaestudio de referencia (Gruenwald et al. 2023) concluyó que el 12,7% de los casos de asma infantil en EE. UU. son atribuibles al uso de estufas de gas sin la ventilación adecuada, debido a picos de NO2 que superan ampliamente los límites recomendados por la OMS."
      },
      {
        question: "¿Por qué no se deben usar tubos flexibles corrugados de aluminio?",
        answer: "Los tubos corrugados de fuelle generan turbulencia interior extrema que reduce el caudal del extractor hasta un 50% y atrapan grasa inflamable en sus pliegues, constituyendo un serio peligro de incendio de chimenea."
      },
      {
        question: "¿Qué es el aire de compensación (Make-Up Air)?",
        answer: "Un extractor potente expulsa aire de la casa. En viviendas herméticas modernas, esto crea presión negativa que puede provocar revoco de monóxido de carbono desde calentadores o chimeneas. Abrir una ventana cercana al cocinar resuelve de inmediato la depresión."
      }
    ]
  },
  pt: {
    pageTitle: "Modelador de Eficiência de Coifas e Depuradores (VOC, NO2 e PM2.5) | IsItKitchenSafe",
    pageDescription: "Simule plumas de dióxido de nitrogênio em fogões a gás, dispersão de partículas PM2.5, atrito em dutos e riscos de asma pediátrica.",
    breadcrumbs: [
      { label: 'Início', href: '/pt/' },
      { label: 'Ferramentas', href: '/pt/tools/' },
      { label: 'Modelador de Coifas e Exaustão' }
    ],
    monoBadge: "Mecânica dos Fluidos e Toxicologia Ambiental",
    monoTitle: "Modelador de Eficiência de Coifas e Depuradores (VOC, NO2 e PM2.5)",
    monoSub: "Simule plumas térmicas de fogões a gás, dispersão de partículas finas PM2.5, perdas de carga em dutos e riscos respiratórios.",
    monoSection1Title: "1. Aerodinâmica da Pluma Térmica de Cocção",
    monoSection1Body: "O cozimento em fogão gera uma pluma térmica ascendente que se expande em cone com ângulo de 10° a 15°. Coifas com pouca profundidade deixam as panelas frontais descobertas, espalhando vapores e aerossóis pelo teto e pela sala.",
    monoSection2Title: "2. Química da Combustão do Gás: NO2 e Benzeno",
    monoSection2Body: "A chama de gás opera acima de 1.400°C, gerando dióxido de nitrogênio (NO2) nocivo aos brônquios. Pesquisas de Stanford (Kashtan et al. 2023) comprovaram ainda a liberação contínua de benzeno carcinogênico em níveis similares ao tabagismo passivo.",
    monoSection3Title: "3. O Engano dos Depuradores de Recirculação com Carvão Ativado",
    monoSection3Body: "Depuradores sem duto externo passam o ar por carvão ativado. Embora absorvam gordura e odores, retêm 0% de NO2 e monóxido de carbono, recirculando integralmente os gases perigosos para o ambiente fechado.",
    faqs: [
      {
        question: "Depuradores de ar sem duto removem dióxido de nitrogênio (NO2) do fogão a gás?",
        answer: "Não, praticamente 0%. O carvão ativado atua em moléculas orgânicas pesadas, mas não tem afinidade para gases inorgânicos leves como NO2 e CO. Todo o gás gerado pela queima permanece na residência."
      },
      {
        question: "Qual a vazão (CFM) necessária para um fogão a gás?",
        answer: "O padrão HVI recomenda 100 CFM para cada 10.000 BTU de potência do fogão. Um modelo de 4 bocas residencial (40.000 BTU) necessita de pelo menos 400 CFM reais. Fogões de indução demandam cerca de 10 a 12 CFM por polegada de largura."
      },
      {
        question: "Por que cozinhar nas bocas traseiras retém muito mais fumaça?",
        answer: "Pelo efeito de parede guia. A parede traseira atua como defletor aerodinâmico vertical que conduz a fumaça direto para o coletor da coifa, enquanto as bocas dianteiras sofrem turbulência e perdem vapor."
      },
      {
        question: "Fogão a gás pode causar asma em crianças?",
        answer: "Sim. Estudos epidemiológicos (Gruenwald et al. 2023) apontam que 12,7% dos casos de asma pediátrica nos EUA estão ligados à exposição ao fogão a gás sem exaustão externa adequada, com picos de NO2 acima dos limites da OMS."
      },
      {
        question: "Por que nunca utilizar tubo flexível sanfonado de alumínio?",
        answer: "Tubos sanfonados criam intensa turbulência interna que corta a vazão da coifa pela metade e acumulam gordura inflamável em seus vincos, criando grave risco de incêndio."
      },
      {
        question: "O que é ar de compensação (Make-Up Air)?",
        answer: "Uma coifa potente retira grande volume de ar. Em casas bem vedadas, isso gera vácuo que pode puxar monóxido de carbono de aquecedores e chaminés para dentro de casa. Abrir uma fresta de janela alivia a depressão."
      }
    ]
  },
  "zh-cn": {
    pageTitle: "抽油烟机 VOC、NO2 与 PM2.5 抽吸效率模拟器 | IsItKitchenSafe",
    pageDescription: "模拟燃气灶二氧化氮燃烧羽流、高温烹饪 PM2.5 油烟扩散、管道空气阻力、捕集速度及儿童哮喘吸入危害。",
    breadcrumbs: [
      { label: '首页', href: '/zh-cn/' },
      { label: '工具库', href: '/zh-cn/tools/' },
      { label: '油烟机排烟效率模拟器' }
    ],
    monoBadge: "流体力学与室内环境毒理学",
    monoTitle: "抽油烟机 VOC、二氧化氮 (NO2) 与 PM2.5 抽吸效率模拟器",
    monoSub: "模拟燃气灶燃烧废气、高温爆炒 PM2.5 油烟扩散、风道阻力损失及儿童哮喘发作风险。",
    monoSection1Title: "1. 烹饪热烟羽流的空气动力学特性",
    monoSection1Body: "烹饪加热时会产生对流上升的热烟羽流，以 10° 至 15° 的半锥角向外膨胀扩散。若抽油烟机进深不足（如进深仅 15 英寸的微波炉吸烟罩覆盖 24 英寸灶台），前锅爆炒油烟将大量逃逸至室内天花板与呼吸带。",
    monoSection2Title: "2. 燃气灶燃烧副产物：二氧化氮 (NO2) 与苯",
    monoSection2Body: "燃气高温火焰（>1400°C）会促使空气中的氮气与氧气结合生成高浓度二氧化氮 (NO2)。斯坦福大学研究（Kashtan 等，2023）更发现燃气灶会持续散发一类致癌物苯，浓度可达到二手烟水平。",
    monoSection3Title: "3. 内循环活性炭吸油烟机的局限性",
    monoSection3Body: "许多公寓采用无外排风道的内循环油烟机。活性炭网仅能吸附大分子油脂异味，但对二氧化氮 (NO2) 和一氧化碳 (CO) 等小分子无机气体的吸附率基本为 0%，导致有害燃气完全排回室内。",
    faqs: [
      {
        question: "内循环活性炭抽油烟机能够去除燃气灶的二氧化氮 (NO2) 吗？",
        answer: "完全不能（去除率为 0%）。活性炭依赖物理吸附大分子有机物，对二氧化氮和一氧化碳等小分子无机气体几乎没有任何吸附能力。燃气燃烧废气会百分之百排回室内反复蓄积。"
      },
      {
        question: "燃气灶究竟需要多大的抽油烟机风量 (CFM)？",
        answer: "美国家庭通风协会 (HVI) 推荐标准为：每 10,000 BTU 燃气热负荷配备至少 100 CFM 排风量。普通 4 头的家用燃气灶（约 40,000 BTU）至少需要 400 CFM 有效风量；电磁灶建议按灶台每英寸宽度配备 10 至 12 CFM。"
      },
      {
        question: "为什么用靠墙的后炉头炒菜吸烟效果远好于前炉头？",
        answer: "因为后挡水墙会产生显著的附壁气流导向效应，像导风板一样将热气流稳稳送入集烟腔。而前炉头四周悬空且易受室内走动气流扰动，大量烟气会直接脱离吸风范围。"
      },
      {
        question: "燃气灶真的会诱发儿童哮喘吗？",
        answer: "是的。权威流行病学荟萃分析（Gruenwald 等，2023）指出，美国 12.7% 的儿童现患哮喘直接归因于燃气灶暴露。在通风不良的厨房中，峰值二氧化氮常超标世界卫生组织上限数倍。"
      },
      {
        question: "为什么切忌使用易弯折的波纹铝箔伸缩软管？",
        answer: "波纹软管内壁凹凸不平，会产生强烈的气流涡流摩擦阻力，导致风机排风量腰斩，且凹褶处极易积存易燃油脂，埋下严重的排烟烟道火灾隐患。"
      },
      {
        question: "什么是补风系统 (Make-Up Air)？",
        answer: "大吸力抽油烟机会高速抽走室内空气。在气密性良好的现代建筑中，这会造成室内负压，导致燃气热水器或壁炉烟道发生一氧化碳倒灌。烹饪时微开邻近窗户可有效缓解负压。"
      }
    ]
  },
  ja: {
    pageTitle: "レンジフード VOC・二酸化窒素 (NO2)・PM2.5 排気効率モデラー | IsItKitchenSafe",
    pageDescription: "ガスコンロの二酸化窒素燃焼プルーム、高温調理時の PM2.5 油煙飛散、ダクト流体摩擦抵抗、捕集速度および小児喘息リスクをシミュレーション。",
    breadcrumbs: [
      { label: 'ホーム', href: '/ja/' },
      { label: 'ツール一覧', href: '/ja/tools/' },
      { label: 'レンジフード排気効率モデラー' }
    ],
    monoBadge: "流体力学および室内環境毒性学",
    monoTitle: "レンジフード VOC・二酸化窒素 (NO2)・PM2.5 排気効率モデラー",
    monoSub: "ガスコンロ燃焼プルーム、油煙 PM2.5 飛散、ダクト圧損、小児気管支リスクの動的シミュレーション。",
    monoSection1Title: "1. 調理時熱上昇プルームの空気力学的挙動",
    monoSection1Body: "加熱されたフライパンや鍋からは熱上昇気流（プルーム）が生じ、上方に進むにつれて 10°〜15° の角度で末広がり状に拡大します。奥行きの浅い浅型フードでは、前側コンロの油煙や有害ガスを捉えきれず室内に溢れ出します。",
    monoSection2Title: "2. ガス燃焼副産物：二酸化窒素 (NO2) と発がん性ベンゼン",
    monoSection2Body: "ガス火の高温燃焼（1400°C以上）により空気中の窒素が酸化され NO2 が発生します。スタンフォード大学の Kashtan らの研究（2023年）では、未燃焼のベンゼンも放出され、受動喫煙レベルに達することが確認されています。",
    monoSection3Title: "3. 室内循環式活性炭フィルターフードの盲点",
    monoSection3Body: "ダクトのない室内循環式フードは活性炭を使用します。油分や臭いは吸着できますが、二酸化窒素 (NO2) や一酸化炭素 (CO) の吸着率はほぼ 0% です。燃焼ガスはそのまま部屋の中へ再循環します。",
    faqs: [
      {
        question: "室内循環式の活性炭フィルター付き換気扇は二酸化窒素 (NO2) を除去できますか？",
        answer: "いいえ、除去率はほぼ 0% です。活性炭は有機揮発物質の吸着には有効ですが、二酸化窒素や一酸化炭素のような小さな無機ガス分子を捕集する能力はありません。ガス燃焼排ガスは 100% 室内に戻ります。"
      },
      {
        question: "ガスコンロには実際どのくらいの風量 (CFM) が必要ですか？",
        answer: "HVI基準では、ガス火力 10,000 BTU あたり最低 100 CFM の風量が必要です。一般的な4口ガスコンロ（約 40,000 BTU）なら最低 400 CFM が必要です。IHの場合は幅1インチあたり 10〜12 CFM が目安です。"
      },
      {
        question: "なぜ奥のバーナーを使うと煙の吸い込みが良くなるのですか？",
        answer: "背面の壁が整流板（エアガイド）として働くためです。気流が壁に沿ってスムーズにフード内へ上昇し、周囲の気流に邪魔されにくくなります。手前側バーナーは煙の最大50%が逃げやすくなります。"
      },
      {
        question: "ガスコンロは本当に子どもの喘息リスクを高めますか？",
        answer: "はい。Gruenwald らによる2023年の大規模メタ分析では、米国の小児喘息症例の約 12.7% がガスコンロの屋内使用に起因すると結論付けられています。換気が不十分な場合、室内の NO2 はWHO基準を容易に超過します。"
      },
      {
        question: "なぜ蛇腹のアルミフレキ管を換気ダクトに使用してはいけないのですか？",
        answer: "フレキ管の内部リブは激しい空気の渦と抵抗を生み、ファンの実効風量を最大半減させます。さらに溝に油分が溜まるため、万一の際に引火してダクト火災を起こす危険性があります。"
      },
      {
        question: "給気（Make-Up Air）とは何ですか？ なぜ重要なのですか？",
        answer: "強力な換気扇は大量の空気を外へ排出します。気密性の高い住宅では室内が負圧になり、給湯器の排気ガス（一酸化炭素）が逆流する恐れがあります。調理中に少し窓を開けることで負圧を解消できます。"
      }
    ]
  }
};

const c = CONTENT[lang] || CONTENT.es;
---

<Layout title={c.pageTitle} description={c.pageDescription} faqs={c.faqs} availableLocales={availableLocales}>
  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={c.breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1280px] mx-auto px-6 py-10 md:py-16">
    <!-- Header -->
    <header class="max-w-4xl mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-blue-100 text-blue-900 mb-3">
        <span>💨</span>
        {c.monoBadge}
      </div>
      <h1 class="text-3xl md:text-5xl font-extrabold text-ink tracking-tight mb-4 leading-tight">
        {c.monoTitle}
      </h1>
      <p class="text-base md:text-xl text-body leading-relaxed">
        {c.monoSub}
      </p>
    </header>

    <!-- Interactive Simulator Component -->
    <RangeHoodExtractionModeler lang={lang} />

    <!-- Localized Article Sections -->
    <article class="prose max-w-none border-t border-hairline pt-12 space-y-10 text-body">
      <div>
        <h2 class="text-2xl font-bold text-ink mb-4">
          {c.monoSection1Title}
        </h2>
        <p class="leading-relaxed">
          {c.monoSection1Body}
        </p>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-ink mb-4">
          {c.monoSection2Title}
        </h2>
        <p class="leading-relaxed">
          {c.monoSection2Body}
        </p>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-ink mb-4">
          {c.monoSection3Title}
        </h2>
        <p class="leading-relaxed">
          {c.monoSection3Body}
        </p>
      </div>
    </article>
  </div>
</Layout>
