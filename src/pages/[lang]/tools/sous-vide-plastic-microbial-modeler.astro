---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import SousVidePlasticMicrobialModeler from '../../../components/SousVidePlasticMicrobialModeler.astro';
import type { SupportedLanguage } from '../../../i18n/ui';
import { useTranslations, useTranslatedPath } from '../../../i18n/utils';

export function getStaticPaths() {
  const availableLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'zh-cn', 'ja'];
  return [
    { params: { lang: 'es' }, props: { lang: 'es' as SupportedLanguage, availableLocales } },
    { params: { lang: 'pt' }, props: { lang: 'pt' as SupportedLanguage, availableLocales } },
    { params: { lang: 'zh-cn' }, props: { lang: 'zh-cn' as SupportedLanguage, availableLocales } },
    { params: { lang: 'ja' }, props: { lang: 'ja' as SupportedLanguage, availableLocales } }
  ];
}

interface Props {
  lang: SupportedLanguage;
  availableLocales: SupportedLanguage[];
}

const { lang, availableLocales } = Astro.props;
const t = useTranslations(lang);
const tp = useTranslatedPath(lang);

interface LocaleContent {
  pageTitle: string;
  pageDescription: string;
  breadcrumbs: Array<{ label: string; href?: string }>;
  faqs: Array<{ question: string; answer: string }>;
  faqHeading: string;
  faqSub: string;
}

const CONTENT: Record<SupportedLanguage, LocaleContent> = {
  en: {} as any,
  es: {
    pageTitle: "Modelador de Seguridad Sous Vide: Migración Plástica y Botulismo | IsItKitchenSafe",
    pageDescription: "Calculadora científica de seguridad sous vide: simula el retraso térmico, los tiempos de pasteurización 6D (Listeria) y el riesgo de neurotoxina de Clostridium botulinum en bolsas de LDPE, vacío y silicona de platino.",
    breadcrumbs: [
      { label: 'Inicio', href: '/es/' },
      { label: 'Herramientas', href: '/es/tools/' },
      { label: 'Modelador Sous Vide: Plásticos y Botulismo' }
    ],
    faqHeading: "Preguntas Frecuentes sobre Seguridad Microbiológica y Bolsas en Sous Vide",
    faqSub: "Respuestas científicas basadas en el Código Alimentario de la FDA (ROP § 3-502.12), cinéticas de Baldwin y normas europeas de plásticos.",
    faqs: [
      {
        question: "¿Cuál es la temperatura crítica para evitar la toxina del botulismo en sous vide?",
        answer: "El umbral microbiológico fundamental es 54.4°C (130°F). En bolsas selladas al vacío sin oxígeno, las cepas no proteolíticas de Clostridium botulinum pueden germinar y generar neurotoxinas mortales a temperaturas tan bajas como 3.3°C y hasta 50°C. A partir de 54.4°C, las células vegetativas mueren progresivamente. Si cocinas por debajo de 54.4°C (por ejemplo, salmón mi-cuit a 48°C), el tiempo total desde que sale de la nevera hasta comerlo no debe superar jamás las 2 horas."
      },
      {
        question: "¿Por qué el grosor del alimento aumenta exponencialmente el tiempo de cocción?",
        answer: "La transferencia de calor en alimentos sólidos se rige por la ley de Fourier: el tiempo no escala linealmente, sino casi al cuadrado del grosor (t ∝ L²). Un filete de 2.5 cm tarda unos 45 minutos en que su centro alcance la temperatura del agua. Si el grosor sube a 5 cm, el centro tarda 140 minutos; y una pieza de 7.5 cm necesita más de 4.5 horas solo para igualar la temperatura del baño antes de empezar la pasteurización."
      },
      {
        question: "¿Son seguras las bolsas tipo Ziploc para cocinar al baño maría sous vide?",
        answer: "Las bolsas de congelación de marcas reconocidas están hechas de polietileno de baja densidad (LDPE #4) sin BPA ni ftalatos. Sin embargo, el LDPE se ablanda a 70°C (158°F). Por encima de 68°C, las soldaduras pueden abrirse con la presión del agua y se acelera el desprendimiento de aditivos deslizantes y microplásticos. Solo deben usarse por debajo de 68°C y mediante inmersión por desplazamiento de agua, nunca para vegetales a alta temperatura."
      },
      {
        question: "¿Cómo acelera la grasa del alimento la migración química de los plásticos?",
        answer: "Muchos aditivos poliméricos y plastificantes son lipofílicos (solubles en grasa). Cuando cocinas carnes con alto contenido graso (ribeye, pato, panceta), los lípidos calientes actúan como solventes orgánicos no polares, extrayendo aditivos químicos y microplásticos hasta 3 a 5 veces más rápido que carnes magras o verduras acuosas."
      },
      {
        question: "¿Qué exige la regla de enfriamiento rápido de la FDA para guardar bolsas sous vide?",
        answer: "Según la norma FDA ROP, si no vas a consumir el alimento de inmediato, debes bajar su temperatura interna de 54°C a menos de 5°C en menos de 2 horas sumergiéndolo por completo en un baño con 50% agua y 50% hielo. Luego debe mantenerse refrigerado por debajo de 3.3°C hasta por 7 días o congelarse."
      },
      {
        question: "¿Cuál es el material más seguro y 100% libre de tóxicos para cocinar sous vide?",
        answer: "La silicona de grado alimentario curada al platino (como las bolsas Stasher) es el estándar de oro. No contiene plástico, derivados del petróleo, ftalatos ni BPA. Soporta hasta 218°C (425°F), es totalmente impermeable a la grasa, reutilizable indefinidamente y apta para lavavajillas."
      }
    ]
  },
  pt: {
    pageTitle: "Modelador de Segurança Sous Vide: Migração de Plásticos e Botulismo | IsItKitchenSafe",
    pageDescription: "Calculadora de segurança para sous vide: calcule atraso de condução térmica, tempos de pasteurização 6D (Listeria) e riscos de neurotoxina de Clostridium botulinum em sacos plásticos e silicone.",
    breadcrumbs: [
      { label: 'Início', href: '/pt/' },
      { label: 'Ferramentas', href: '/pt/tools/' },
      { label: 'Modelador Sous Vide: Plásticos e Botulismo' }
    ],
    faqHeading: "Perguntas Frequentes sobre Segurança Microbiológica e Sacos no Sous Vide",
    faqSub: "Diretrizes com respaldo na microbiologia da FDA (ROP § 3-502.12), física térmica de Baldwin e regulamentos da União Europeia.",
    faqs: [
      {
        question: "Qual é a temperatura crítica para impedir o botulismo no sous vide?",
        answer: "O limite biológico crítico é 54.4°C (130°F). Em sacos a vácuo desprovidos de oxigênio, cepas não proteolíticas de Clostridium botulinum conseguem germinar e produzir neurotoxinas entre 3.3°C e 50°C. Acima de 54.4°C, a multiplicação cessa e as bactérias sofrem destruição térmica. Ao cozinhar abaixo de 54.4°C (como salmão a 48°C), o tempo total da geladeira ao prato não deve passar de 2 horas."
      },
      {
        question: "Por que a espessura da carne aumenta drasticamente o tempo de cozimento?",
        answer: "A condução térmica segue a lei de Fourier: o tempo necessário varia com o quadrado da espessura (t ∝ L²). Uma carne de 2.5 cm leva cerca de 45 minutos para o centro atingir a temperatura do banho. Já uma peça de 5 cm requer 140 minutos, e 7.5 cm demanda mais de 4.5 horas apenas para aquecer o centro antes de iniciar o tempo de pasteurização."
      },
      {
        question: "Sacos plásticos comuns com fecho zip são seguros para sous vide?",
        answer: "Sacos de freezer de marcas conceituadas são de polietileno de baixa densidade (LDPE #4) sem BPA. Contudo, o LDPE amolece a 70°C. Em temperaturas superiores a 68°C, as soldas podem estourar na água e o desprendimento de aditivos químicos e microplásticos aumenta significativamente. Use apenas para cozimentos abaixo de 68°C."
      },
      {
        question: "Como as gorduras aceleram a lixiviação de substâncias plásticas?",
        answer: "Plastificantes e aditivos de polímeros são substâncias lipofílicas. Na presença de carnes gordurosas (picanha, costela, pato), a gordura líquida aquecida age como solvente químico, extraindo aditivos plásticos e microplásticos até 4 vezes mais rápido do que alimentos magros."
      },
      {
        question: "Qual é a regra da FDA para resfriar sacos sous vide para consumo posterior?",
        answer: "A FDA determina que alimentos em embalagens de oxigênio reduzido devem ser resfriados de 54°C a menos de 5°C em até 2 horas em banho com água e 50% de gelo, mantendo-os depois a menos de 3.3°C por até 7 dias para evitar a síntese de toxina botulínica."
      },
      {
        question: "Qual é a opção mais segura e sem plástico para sous vide prolongado?",
        answer: "Sacos de silicone culinário curado a platina (como Stasher). Não contêm derivados de petróleo, ftalatos, BPA ou microplásticos, suportam até 218°C, resistem à gordura e duram milhares de usos na lava-louças."
      }
    ]
  },
  "zh-cn": {
    pageTitle: "低温慢煮（Sous Vide）塑料溶出与肉毒杆菌安全模型计算器 | IsItKitchenSafe",
    pageDescription: "权威科学低温慢煮计算器：计算食材中心热传导延迟、李斯特菌 6D 巴氏杀菌时长及厌氧肉毒杆菌神经毒素风险，评测密封袋微塑料与化学溶出度。",
    breadcrumbs: [
      { label: '首页', href: '/zh-cn/' },
      { label: '实用工具', href: '/zh-cn/tools/' },
      { label: '低温慢煮塑料与肉毒杆菌安全模型' }
    ],
    faqHeading: "低温慢煮微生物安全与塑料加热常见问题解答",
    faqSub: "基于美国 FDA 食品法典 § 3-502.12（ROP）、鲍德温热力学公式及欧盟 EU 10/2011 迁移标准。",
    faqs: [
      {
        question: "低温慢煮中防止肉毒杆菌毒素滋生的绝对温度红线是多少？",
        answer: "绝对安全临界温度为 54.4°C（130°F）。在真空少氧环境中，非蛋白分解型肉毒杆菌（C. botulinum Type B/E）在 3.3°C 至 50°C 之间均可萌发并合成致命神经毒素。当水温达到或超过 54.4°C 时，细菌繁殖被彻底终止并开始热致死衰减。若采用低于 54.4°C 烹饪（如 48°C 半熟三文鱼），从出冰箱到烹饪并食用的累计总时长绝不可超过 2 小时！"
      },
      {
        question: "为什么食材厚度增加一倍，所需烹饪时间会呈指数级暴增？",
        answer: "固态食品中的热传导遵循傅里叶导热定律，热量渗透到食材几何几何中心（冷点）的时间与厚度的平方成正比（t ∝ L²）。一块 2.5 厘米（1 英寸）厚的牛排约需 45 分钟中心达到水温；厚度增加到 5 厘米（2 英寸）则需要约 140 分钟；若厚度达到 7.5 厘米，仅使中心达到水温就需超过 4.5 小时，这还没算后续杀菌所需的保温时间。"
      },
      {
        question: "家用普通的密实袋（Ziploc 等）可以直接用于低温慢煮吗？",
        answer: "正规品牌加厚冷冻密实袋由低密度聚乙烯（LDPE #4）制成，不含 BPA 和邻苯二甲酸酯。但 LDPE 在 70°C 左右开始软化，高于 68°C 时袋子封边极易被水压胀破，且薄膜中的开口爽滑剂（芥酸酰胺）和纳米微塑料脱落量剧增。因此密实袋仅限用于 68°C 以下的低温肉类排气法慢煮，绝不能用于 80°C 以上的高温蔬菜慢煮。"
      },
      {
        question: "食材的油脂含量是如何加速塑料化学添加剂析出的？",
        answer: "聚合物薄膜中的增塑剂、稳定剂及抗氧添加剂大多具有极强的亲脂性（高辛醇-水分配系数 log Kow）。慢煮五花肉、带皮鸭胸或雪花牛排时，融化的高温动物油脂相当于非极性有机溶剂，对塑料添加剂和微塑料的抽提溶解速度比煮鸡胸肉或胡萝卜高出 3 到 5 倍。"
      },
      {
        question: "慢煮做好的食物如果不马上吃，FDA 要求的“冷休克”规则是什么？",
        answer: "根据 FDA 减氧包装（ROP）生物安全法典，煮熟后的真空袋如果需要冷藏储存，必须在 2 小时内将其浸没在 50% 冰水混合物中，将中心温度急速拉低至 5°C（41°F）以下，随后放入 3.3°C 以下冷藏室（最多存7天）或冷冻室，防止处于危险温区的肉毒杆菌残余芽孢二次萌发产毒。"
      },
      {
        question: "长期低温慢煮最健康、零微塑料溶出的袋子材质是什么？",
        answer: "铂金硫化食品级硅胶袋（如 Stasher）是行业黄金标准。它由高纯度二氧化硅与铂金催化剂制成，完全不含石油聚烯烃、邻苯增塑剂、BPA/BPS，且不产生微塑料。耐受温度高达 218°C，抗油脂侵蚀，支持洗碗机无限次反复清洗消毒。"
      }
    ]
  },
  ja: {
    pageTitle: "低温調理（真空調理）プラスチック溶出＆ボツリヌス菌リスク診断ツール | IsItKitchenSafe",
    pageDescription: "科学的エビデンスに基づく低温調理計算機：中心部への熱伝導遅延、リステリア菌6D殺菌時間、ボツリヌス神経毒素リスクを算出し、密閉袋のマイクロプラスチック・可塑剤溶出度を診断。",
    breadcrumbs: [
      { label: 'ホーム', href: '/ja/' },
      { label: 'ツール一覧', href: '/ja/tools/' },
      { label: '低温調理プラスチック＆ボツリヌス菌診断' }
    ],
    faqHeading: "低温調理の食中毒防止と密閉袋の安全性に関するよくある質問",
    faqSub: "米FDA食品規範（脱酸素包装 § 3-502.12）、ボールドウィン熱伝導計算式、欧州EUプラスチック規格準拠。",
    faqs: [
      {
        question: "低温調理でボツリヌス神経毒素の発生を防ぐ限界温度は何℃ですか？",
        answer: "絶対的な安全基準温度は54.4℃（130°F）です。酸素のない真空パック内では、非タンパク分解性ボツリヌス菌が3.3℃〜50℃という広範な温度域で発芽し、致死性の神経毒素を産生します。54.4℃以上を維持することで菌の増殖は阻止され、死滅プロセスに入ります。もし54.4℃未満（サーモンのミキュイ48℃など）で調理する場合は、冷蔵庫から取り出して食べるまでの時間を【2時間以内】に厳守する必要があります。"
      },
      {
        question: "食材の厚みが2倍になると、なぜ調理時間は4倍近く長くなるのですか？",
        answer: "肉内部の熱伝導はフーリエの法則に従い、熱が中心部に伝わる時間は厚みの2乗に比例して長くなります（t ∝ L²）。厚さ2.5cmのステーキは中心温度が水温に達するまで約45分ですが、厚さ5cmでは約140分かかり、7.5cmの大きな塊肉では中心部が温まるだけで4.5時間以上を要します。"
      },
      {
        question: "ジップロックなどの市販フリーザーバッグは低温調理に使えますか？",
        answer: "大手メーカーの冷凍用フリーザーバッグは低密度ポリエチレン（LDPE #4）製で、BPAやフタル酸エステルは不使用です。ただしLDPEは約70℃で軟化します。68℃を超える高温では水圧で袋の圧着部が裂けやすく、スリップ剤やマイクロプラスチックの溶出量が増大します。68℃以下の低水温でのみ使用し、80℃以上の高温野菜調理には絶対に使わないでください。"
      },
      {
        question: "食材の脂質はプラスチックからの化学物質溶出をどのように加速させますか？",
        answer: "プラスチック添加剤や可塑剤は親脂性（脂溶性）が高い特徴があります。牛サーロインや鴨肉など脂肪分の多い食材を加熱すると、溶け出した油脂が有機溶媒のように働き、赤身肉や野菜と比べて化学物質やマイクロプラスチックを3〜5倍速く溶出させてしまいます。"
      },
      {
        question: "調理後の真空パックを保存する際の米FDA『氷水急冷ルール』とは？",
        answer: "米FDA基準では、調理後すぐに食べない真空パックは、2時間以内に50%氷水に完全に沈めて中心温度を5℃以下まで急速冷却することが義務付けられています。その後、ボツリヌス菌の増殖を防ぐため3.3℃以下の冷蔵庫（7日以内）または冷凍庫で保存します。"
      },
      {
        question: "長期低温調理で最も安全でマイクロプラスチックが出ない袋は何ですか？",
        answer: "プラチナシリコーン100%の保存容器（スタッシャーなど）が最も安全です。石油系プラスチックではないためフタル酸エステルやBPA、マイクロプラスチックが一切溶出せず、耐熱温度は218℃に達し、食洗機で何度でも再利用可能です。"
      }
    ]
  }
};

const content = CONTENT[lang];
---

<Layout title={content.pageTitle} description={content.pageDescription} faqs={content.faqs} availableLocales={availableLocales}>
  <main class="container mx-auto px-4 py-8 max-w-5xl space-y-8">
    <Breadcrumbs items={content.breadcrumbs} />

    <SousVidePlasticMicrobialModeler lang={lang} />

    <!-- Scientific Section -->
    <section class="bg-surface-soft border border-hairline rounded-3xl p-6 md:p-10 space-y-8">
      <div class="border-b border-hairline pb-4">
        <span class="text-xs font-bold uppercase tracking-wider text-cyan-800 dark:text-cyan-400 block mb-1">
          {content.faqHeading}
        </span>
        <h2 class="text-title-lg font-bold text-ink tracking-tight">
          {content.faqSub}
        </h2>
      </div>

      <div class="space-y-4">
        {content.faqs.map(faq => (
          <div class="bg-canvas border border-hairline rounded-2xl p-5 space-y-2">
            <h3 class="text-sm md:text-base font-bold text-ink flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-cyan-500 shrink-0"></span>
              {faq.question}
            </h3>
            <p class="text-xs md:text-sm text-body leading-relaxed pl-4">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </section>
  </main>
</Layout>
