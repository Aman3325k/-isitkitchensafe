const c = CONTENT[lang];

const breadcrumbs = [
  { label: t('nav.home') || 'Home', href: tp('/') },
  { label: t('nav.tools') || 'Tools', href: tp('/tools/') },
  { label: c.breadcrumbsLabel }
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": `https://isitkitchensafe.com${tp('/tools/commercial-continuous-hc-hdj-liposome-modeler/')}#webapp`,
      "url": `https://isitkitchensafe.com${tp('/tools/commercial-continuous-hc-hdj-liposome-modeler/')}`,
      "name": c.h1,
      "applicationCategory": "EngineeringApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5 Canvas/CSS3.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": c.pageDescription
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": t('nav.home') || 'Home',
          "item": `https://isitkitchensafe.com${tp('/')}`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": t('nav.tools') || 'Tools',
          "item": `https://isitkitchensafe.com${tp('/tools/')}`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": c.breadcrumbsLabel,
          "item": `https://isitkitchensafe.com${tp('/tools/commercial-continuous-hc-hdj-liposome-modeler/')}`
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": c.faqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
};
---

<Layout title={c.pageTitle} description={c.pageDescription}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <Breadcrumbs items={breadcrumbs} />

    <CommercialContinuousHcHdjLiposomeModeler lang={lang} />

    <!-- FAQ Accordion / Section -->
    <section class="mt-16 border-t border-hairline pt-12 max-w-4xl mx-auto">
      <div class="text-center mb-10">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-ink tracking-tight">
          {c.faqs.length > 0 ? (lang === 'zh-cn' ? '常见问题解答：高压流体对撞纳米脂质体制备技术' : (lang === 'ja' ? 'よくある質問：超高圧水力対向ジェットリポソーム合成技術' : (lang === 'es' ? 'Preguntas Frecuentes: Síntesis de Liposomas por Colisión Hidrodinámica HC-HDJ' : 'Perguntas Frequentes: Síntese de Lipossomas por Colisão Hidrodinâmica HC-HDJ'))) : 'FAQ'}
        </h2>
        <p class="text-sm text-muted mt-2">
          {lang === 'zh-cn' ? '超高压流体力学、膜生物物理学及 3-A 卫生级制药食品工程核心问题解析。' : (lang === 'ja' ? '超高圧流体力学、生体膜物理学および3-Aサニタリーエンジニアリングの詳細解説。' : (lang === 'es' ? 'Directrices de ingeniería, mecánica de fluidos y normas sanitarias para la fabricación continua de liposomas.' : 'Diretrizes de engenharia, mecânica dos fluidos e conformidade sanitária para fabricação contínua de lipossomas.'))}
        </p>
      </div>

      <div class="space-y-6">
        {c.faqs.map((faq, index) => (
          <article class="bg-surface-soft border border-hairline rounded-2xl p-6 shadow-xs">
            <h3 class="text-base sm:text-lg font-bold text-ink mb-2">
              {index + 1}. {faq.question}
            </h3>
            <p class="text-sm text-body leading-relaxed">
              {faq.answer}
            </p>
          </article>
        ))}
      </div>
    </section>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</Layout>
