---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import KitchenPlasticLeachingChecker from '../../../components/KitchenPlasticLeachingChecker.astro';
import rawData from '../../../data/kitchen-plastic-leaching-data.json';
import type { SupportedLanguage } from '../../../i18n/ui';

export function getStaticPaths() {
  const availableLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'zh-cn', 'ja'];
  return [
    { params: { lang: 'es' }, props: { lang: 'es' as SupportedLanguage, availableLocales } },
    { params: { lang: 'pt' }, props: { lang: 'pt' as SupportedLanguage, availableLocales } },
    { params: { lang: 'zh-cn' }, props: { lang: 'zh-cn' as SupportedLanguage, availableLocales } },
    { params: { lang: 'ja' }, props: { lang: 'ja' as SupportedLanguage, availableLocales } }
  ];
}

interface Props {
  lang: SupportedLanguage;
  availableLocales: SupportedLanguage[];
}

const { lang, availableLocales } = Astro.props;

interface LocalePageContent {
  pageTitle: string;
  pageDescription: string;
  badge: string;
  h1: string;
  heroSub: string;
  breadcrumbs: Array<{ label: string; href?: string }>;
}

const CONTENT: Record<Exclude<SupportedLanguage, 'en'>, LocalePageContent> = {
  es: {
    pageTitle: "Verificador de Migración Química y Plásticos Seguros para Comida Caliente | IsItKitchenSafe",
    pageDescription: "Calcula los riesgos de migración de BPA, BPS, ftalatos y microplásticos al calentar o almacenar comida caliente, ácida o grasosa en plásticos (#1 al #7). Verificado con ACS Nano 2023 y FDA.",
    badge: "ACS Nano 2023 · FDA 21 CFR § 177 · EFSA BPA Re-evaluación · Códigos ASTM #1–#7",
    h1: "Verificador de Migración Química y Plásticos Seguros para Comida Caliente",
    heroSub: "Descubre si tus recipientes de plástico son seguros para sobras y calor: calcula tasas de migración de ftalatos y BPA en los códigos #1 al #7, evalúa puntos de sobrecalentamiento de aceites en microondas y desprendimiento de nanoplásticos, y conoce cuándo cambiar a vidrio o acero inoxidable.",
    breadcrumbs: [
      { label: "Inicio", href: "/es/" },
      { label: "Herramientas", href: "/es/tools/" },
      { label: "Migración Química en Plásticos" }
    ]
  },
  pt: {
    pageTitle: "Verificador de Migração Química e Potes Plásticos Seguros para Alimentos Quentes | IsItKitchenSafe",
    pageDescription: "Calcule os riscos de migração de BPA, BPS, ftalatos e microplásticos ao aquecer ou guardar comida quente, ácida ou gordurosa em recipientes plásticos (#1 a #7). Padrões ACS Nano 2023 e FDA.",
    badge: "ACS Nano 2023 · FDA 21 CFR § 177 · Reavaliação EFSA BPA · Códigos ASTM #1–#7",
    h1: "Verificador de Migração Química e Potes Plásticos Seguros para Alimentos Quentes",
    heroSub: "Elimine a dúvida sobre a segurança dos seus potes plásticos: calcule taxas de migração de plastificantes nos códigos #1 a #7, simule o superaquecimento de óleos no micro-ondas e desprendimento de nanoplásticos, e descubra quando migrar para vidro ou inox.",
    breadcrumbs: [
      { label: "Início", href: "/pt/" },
      { label: "Ferramentas", href: "/pt/tools/" },
      { label: "Migração Química em Plásticos" }
    ]
  },
  'zh-cn': {
    pageTitle: "厨房塑料容器化学物质迁移与热食安全评估器 | IsItKitchenSafe",
    pageDescription: "科学测算热食、酸性介质及油脂在 #1 至 #7 塑料保鲜盒中的 BPA、BPS、邻苯二甲酸酯增塑剂迁移与微塑料脱落风险。对标美国 ACS Nano 2023 权威研究与 FDA 21 CFR § 177 标准。",
    badge: "ACS Nano 2023 权威实测 · FDA 21 CFR § 177 · EFSA 双酚A重评 · ASTM D7611 材质标尺",
    h1: "厨房塑料容器化学物质迁移与热食安全评估器",
    heroSub: "告别塑料保鲜盒热食残留健康隐患：精准测算 #1 至 #7 各类塑料在酸性及高油微波加热下的塑化剂溶出速率、微观局部超温熔损与数十亿纳米微塑料脱落量，掌握玻璃与不锈钢安全平替方案与报废换新指引。",
    breadcrumbs: [
      { label: "首页", href: "/zh-cn/" },
      { label: "安全工具", href: "/zh-cn/tools/" },
      { label: "塑料化学迁移与热食安全评估器" }
    ]
  },
  ja: {
    pageTitle: "プラスチック食品容器の化学物質溶出・熱食安全チェッカー | IsItKitchenSafe",
    pageDescription: "温かい料理・酸性・油脂食品をプラスチック容器（#1〜#7）で加熱・保存する際のBPA、BPS、フタル酸エステル、マイクロプラスチック溶出リスクを計算。米国ACS Nano 2023論文および米FDA基準準拠。",
    badge: "ACS Nano 2023 論文準拠 · 米FDA 21 CFR § 177 · 欧州EFSA BPA基準 · ASTM #1〜#7",
    h1: "プラスチック食品容器の化学物質溶出・熱食安全チェッカー",
    heroSub: "プラスチック保存容器の電子レンジ加熱や熱い作り置きの安全性を科学的に検証：#1〜#7の樹脂識別コード別にフタル酸エステルやBPAの溶出速度、油分の局所過熱による表面溶損、ナノプラスチック放出量をシミュレーションし、安全な耐熱ガラスへの切り替え指針を提供します。",
    breadcrumbs: [
      { label: "ホーム", href: "/ja/" },
      { label: "安全ツール", href: "/ja/tools/" },
      { label: "プラスチック化学溶出診断" }
    ]
  }
};

const content = CONTENT[lang as Exclude<SupportedLanguage, 'en'>] || CONTENT.es;

const faqs = (rawData.faqs[lang as 'es' | 'pt' | 'zh-cn' | 'ja'] || rawData.faqs.en);

const canonicalUrl = `https://isitkitchensafe.com/${lang}/tools/kitchen-plastic-leaching-checker/`;

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": content.h1,
  "url": canonicalUrl,
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript.",
  "description": content.pageDescription,
  "inLanguage": lang,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq: any) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={content.pageTitle}
  description={content.pageDescription}
  faqs={faqs}
  excludeFaqSchema={true}
  availableLocales={availableLocales}
  lang={lang}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1 print:hidden">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={content.breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1140px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-signature-coral text-white mb-3">
        {content.badge}
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        {content.h1}
      </h1>
      <p class="text-body text-[15px] md:text-[16px] leading-relaxed">
        {content.heroSub}
      </p>
    </header>

    <!-- Main Interactive Checker Component -->
    <KitchenPlasticLeachingChecker lang={lang} />
  </div>
</Layout>
