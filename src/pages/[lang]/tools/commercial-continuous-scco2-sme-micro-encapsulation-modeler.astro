const c = CONTENT[lang as Exclude<SupportedLanguage, 'en'>];

const breadcrumbs = [
  { label: t('nav.home'), href: tp('/') },
  { label: t('nav.tools'), href: tp('/tools/') },
  { label: c.breadcrumbsLabel }
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": `https://isitkitchensafe.com${tp('/tools/commercial-continuous-scco2-sme-micro-encapsulation-modeler/')}#webapp`,
      "url": `https://isitkitchensafe.com${tp('/tools/commercial-continuous-scco2-sme-micro-encapsulation-modeler/')}`,
      "name": c.pageTitle,
      "applicationCategory": "EngineeringApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5 Canvas/CSS3.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": c.pageDescription
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": t('nav.home'),
          "item": `https://isitkitchensafe.com${tp('/')}`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": t('nav.tools'),
          "item": `https://isitkitchensafe.com${tp('/tools/')}`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": c.breadcrumbsLabel,
          "item": `https://isitkitchensafe.com${tp('/tools/commercial-continuous-scco2-sme-micro-encapsulation-modeler/')}`
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": c.faqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
};
---

<Layout 
  title={c.pageTitle}
  description={c.pageDescription}
  structuredData={structuredData}
>
  <main class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
    <Breadcrumbs items={breadcrumbs} />

    <CommercialContinuousScco2SmeModeler lang={lang} />

    <!-- Frequently Asked Questions -->
    <section class="mt-12 bg-surface-soft border border-hairline rounded-3xl p-6 md:p-8">
      <h2 class="text-title-lg font-medium text-ink tracking-tight mb-2">
        {c.badge} &mdash; FAQ
      </h2>
      <p class="text-body text-xs text-muted mb-6">
        {c.lead}
      </p>

      <div class="space-y-6">
        {c.faqs.map((faq) => (
          <div class="border-b border-hairline/60 pb-5 last:border-0 last:pb-0">
            <h3 class="text-sm font-bold text-ink mb-2">
              {faq.question}
            </h3>
            <p class="text-xs text-body leading-relaxed text-muted">
              {faq.answer}
            </p>
          </div>
        ))}
