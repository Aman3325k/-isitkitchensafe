---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import RefrigeratorDefrostSafetyModeler from '../../../components/RefrigeratorDefrostSafetyModeler.astro';
import type { SupportedLanguage } from '../../../i18n/ui';
import { useTranslations, useTranslatedPath } from '../../../i18n/utils';

export function getStaticPaths() {
  const availableLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'zh-cn', 'ja'];
  return [
    { params: { lang: 'es' }, props: { lang: 'es' as SupportedLanguage, availableLocales } },
    { params: { lang: 'pt' }, props: { lang: 'pt' as SupportedLanguage, availableLocales } },
    { params: { lang: 'zh-cn' }, props: { lang: 'zh-cn' as SupportedLanguage, availableLocales } },
    { params: { lang: 'ja' }, props: { lang: 'ja' as SupportedLanguage, availableLocales } }
  ];
}

interface Props {
  lang: SupportedLanguage;
  availableLocales: SupportedLanguage[];
}

const { lang, availableLocales } = Astro.props;
const t = useTranslations(lang);
const tp = useTranslatedPath(lang);

interface LocaleContent {
  pageTitle: string;
  pageDescription: string;
  breadcrumbs: Array<{ label: string; href?: string }>;
  faqs: Array<{ question: string; answer: string }>;
  monoBadge: string;
  monoTitle: string;
  monoSub: string;
  monoSection1Title: string;
  monoSection1Body: string;
  monoSection2Title: string;
  monoSection2Body: string;
  monoSection3Title: string;
  monoSection3Body: string;
}

const CONTENT: Record<SupportedLanguage, LocaleContent> = {
  en: {} as any,
  es: {
    pageTitle: "Simulador de Falla de Termostato de Descongelación y Cadena de Frío | IsItKitchenSafe",
    pageDescription: "Simule la congelación de serpentinas del evaporador, falla del bimetal, descontrol de la resistencia de descongelación y curvas de crecimiento de Listeria, Salmonella y enterotoxina de estafilococo.",
    breadcrumbs: [
      { label: 'Inicio', href: '/es/' },
      { label: 'Herramientas', href: '/es/tools/' },
      { label: 'Simulador de Descongelación de Nevera' }
    ],
    monoBadge: "Termodinámica y Seguridad de Patógenos Alimentarios",
    monoTitle: "Simulador de Falla de Termostato de Descongelación de Nevera",
    monoSub: "Simule acumulación de hielo en evaporador, falla del bimetal, sobrecalentamiento de resistencia y curvas de multiplicación bacteriana por encima de 4.4°C (40°F).",
    monoSection1Title: "1. Termodinámica del Ciclo No-Frost y Congelación Silenciosa",
    monoSection1Body: "En frigoríficos modernos no-frost, todo el aire frío proviene de un único evaporador en el congelador. Si el circuito de descongelación (bimetal, resistencia o temporizador) falla, la escarcha se transforma en un bloque de hielo sólido en 3 a 5 días. El congelador se mantiene engañosamente frío (alrededor de -5°C a -8°C) por proximidad, pero el ventilador no puede soplar aire al compartimento principal, que sube a 12°C–15°C (54°F–58°F) sin activar alarmas.",
    monoSection2Title: "2. Microbiología de la Ruptura de Cadena: Listeria y Enterotoxinas",
    monoSection2Body: "Listeria monocytogenes es una bacteria psicrotrófica que se duplica velozmente entre 7°C y 11°C, causando listeriosis con una tasa de mortalidad del 20% al 30% en embarazadas y ancianos. Además, si alimentos cocinados o carnes permanecen más de 4 horas por encima de 10°C (50°F), Staphylococcus aureus sintetiza enterotoxinas termoestables que NO se destruyen al hervir o volver a cocinar.",
    monoSection3Title: "3. Diagnóstico Eléctrico con Multímetro en 4 Pasos",
    monoSection3Body: "Desconecte la nevera y retire el panel trasero del congelador. Pruebe el termostato bimetálico en frío (< -6°C): debe marcar 0 Ohmios (continuidad cerrada). Si marca circuito abierto (O.L.) estando helado, está roto. La resistencia de descongelación debe medir entre 15 y 35 Ohmios; si marca O.L., el filamento calrod está quemado.",
    faqs: [
      {
        question: "¿Por qué mi nevera no enfría pero el congelador sí congela?",
        answer: "Es el síntoma clásico de falla en el sistema de descongelación automática. El evaporador del congelador se ha cubierto de un bloque de hielo que bloquea el conducto de aire hacia la nevera. El congelador sigue frío por convección estática, pero el habitáculo de alimentos se calienta a más de 10°C."
      },
      {
        question: "¿Cocinar carne que estuvo tibia en la nevera la hace segura?",
        answer: "¡No! Cocinar mata las bacterias vivas pero NO elimina las enterotoxinas termoestables producidas por Staphylococcus aureus o Bacillus cereus si el alimento estuvo a más de 10°C por más de 4 horas. Estas toxinas resisten 30 minutos de hervido y provocan vómitos violentos y diarrea."
      },
      {
        question: "¿Cuánto tiempo aguantan los alimentos a más de 4°C (40°F)?",
        answer: "Según USDA-FSIS y el Código Alimentario FDA, carnes crudas, pollo, leche, quesos frescos y sobras deben desecharse si han superado los 4°C durante más de 2 horas. Condimentos ácidos y quesos curados son seguros por 24 a 48 horas."
      }
    ]
  },
  pt: {
    pageTitle: "Simulador de Falha de Termostato de Degelo e Quebra de Cadeia de Frio | IsItKitchenSafe",
    pageDescription: "Simule congelamento de serpentinas, falha do bimetal, superaquecimento de resistência e curvas de Listeria, Salmonella e enterotoxinas estafilocócicas.",
    breadcrumbs: [
      { label: 'Início', href: '/pt/' },
      { label: 'Ferramentas', href: '/pt/tools/' },
      { label: 'Simulador de Falha de Degelo de Geladeira' }
    ],
    monoBadge: "Termodinâmica e Segurança Microbiológica Alimentar",
    monoTitle: "Simulador de Falha de Degelo e Cadeia de Frio",
    monoSub: "Simule bloqueio de gelo no evaporador, pane no bimetal, descontrole de resistência e multiplicação de patógenos acima de 4.4°C (40°F).",
    monoSection1Title: "1. Termodinâmica do Sistema Frost-Free e Falha Silenciosa",
    monoSection1Body: "Em geladeiras frost-free, todo o frio é gerado na serpentina do freezer e distribuído por um ventilador. Quando o bimetal ou a resistência de degelo falham, a umidade se acumula até formar uma muralha de gelo sólido. O freezer permanece superficialmente gelado, mas o compartimento da geladeira aquece para 12°C a 15°C sem que o usuário perceba.",
    monoSection2Title: "2. Riscos Microbiológicos: Listeria e Toxina Estafilocócica",
    monoSection2Body: "A Listeria monocytogenes se multiplica rapidamente a 8°C–10°C, com mortalidade de até 30% em gestantes e idosos. Se carnes cozidas ou laticínios passarem mais de 4 horas acima de 10°C, o Staphylococcus aureus produz enterotoxinas termoestáveis que sobrevivem à fervura e provocam intoxicação alimentar violenta.",
    monoSection3Title: "3. Teste Elétrico com Multímetro Digital",
    monoSection3Body: "Desligue a tomada e remova a tampa traseira do freezer. Teste a continuidade do bimetal congelado (< -6°C): deve apresentar 0 Ohms. Se indicar circuito aberto (O.L.), o bimetal está avariado. A resistência de degelo deve acusar entre 15 e 35 Ohms; leitura em O.L. indica filamento rompido.",
    faqs: [
      {
        question: "Por que o freezer gela normalmente mas a geladeira fica quente?",
        answer: "Este é o indício clássico de queima do sistema de degelo (bimetal, resistência ou placa/timer). O gelo bloqueou a passagem de ar para a parte inferior, isolando o frio apenas no evaporador."
      },
      {
        question: "Ferver ou assar a carne que ficou na geladeira quente elimina o perigo?",
        answer: "Não! O calor mata as bactérias mas não destrói as enterotoxinas termoestáveis pré-formadas pelo Staphylococcus aureus após 4 horas acima de 10°C. O risco de vômito súbito e diarreia aguda permanece intacto."
      },
      {
        question: "Qual o prazo limite para descartar alimentos acima de 4°C?",
        answer: "De acordo com o USDA e FDA, carnes, frango, leite e sobras cozidas mantidas acima de 4°C por mais de 2 horas devem ser descartadas imediatamente."
      }
    ]
  },
  'zh-cn': {
    pageTitle: "冰箱化霜温控器故障与冷链隐蔽失效变质模拟器 | IsItKitchenSafe",
    pageDescription: "模拟冰箱蒸发器盘管冻堵、双金属温控器开路/触点熔接、加热管失控，以及李斯特菌、沙门氏菌和金葡菌耐热肠毒素增殖曲线。",
    breadcrumbs: [
      { label: '首页', href: '/zh-cn/' },
      { label: '工具箱', href: '/zh-cn/tools/' },
      { label: '冰箱化霜与冷链失效模拟器' }
    ],
    monoBadge: "热力学与食源性致病菌繁殖安全模拟",
    monoTitle: "冰箱化霜温控器故障与冷链隐蔽失效模拟器",
    monoSub: "模拟蒸发器严重积冰、双金属化霜温控器断路、加热管异常持续加热及 4.4°C (40°F) 以上细菌毒素激增。",
    monoSection1Title: "1. 风冷无霜冰箱热力学与蒸发器隐蔽结冰",
    monoSection1Body: "风冷无霜冰箱的全部制冷量由冷冻室背板的蒸发器盘管提供，再由风机送风入冷藏室。一旦化霜回路（双金属温控器、加热管或定时器）发生故障，霜层将在3到5天内硬化成实心冰墙封死风道。冷冻室因紧贴冰块仍显低温，但冷藏室将悄无声息升温至 12°C–15°C (54°F–58°F)。",
    monoSection2Title: "2. 冷链断裂微生物学：李斯特菌与耐热肠毒素",
    monoSection2Body: "李斯特菌为嗜冷菌，在 7°C 至 11°C 世代时间骤减至4小时，孕妇及老人感染死亡率高达20%–30%。此外，若熟肉或奶制品在 10°C (50°F) 以上放置超过4小时，金黄色葡萄球菌将分泌高浓度耐热肠毒素，即使煮沸30分钟也无法灭活，彻底加热依然会中毒！",
    monoSection3Title: "3. 数字万用表四步电气排查诊断",
    monoSection3Body: "拔掉冰箱电源，拆下冷冻室后壁护板。在冰霜低温下（低于 -6°C）测量双金属化霜温控器通断，正常应为 0 欧姆（导通），若显示断路 (O.L.) 则说明内部触点损坏。随后测量化霜加热管电阻，正常阻值在 15 至 35 欧姆之间，若显示 O.L. 则说明发热丝已烧断。",
    faqs: [
      {
        question: "为什么冰箱冷冻室结冰正常，但冷藏室却完全不凉？",
        answer: "这是化霜系统损坏的经典表象。蒸发器盘管结成巨大冰块封死了送风通道，冷气无法吹入冷藏室，导致冷藏室温度持续飙升变质。"
      },
      {
        question: "在变温冰箱里放置过的肉类彻底煮熟后还能吃吗？",
        answer: "不能！高温只能杀死细菌活体，但无法分解金黄色葡萄球菌或蜡样芽孢杆菌分泌的耐热肠毒素。摄入后1至6小时内仍会引发剧烈喷射性呕吐和严重腹泻。"
      },
      {
        question: "易腐食品在 4°C 以上能安全存放多久？",
        answer: "依照 USDA 与 FDA 食品规范，生肉、禽肉、鲜奶、熟米饭面食在高于 4°C 环境下超过2小时（或高于 10°C 超过1小时）必须立即丢弃。"
      }
    ]
  },
  ja: {
    pageTitle: "冷蔵庫デフロストサーモスタット故障・冷鎖破壊＆腐敗シミュレーター | IsItKitchenSafe",
    pageDescription: "エバポレーターの氷結風道閉塞、バイメタル接点不良、除霜ヒーター暴走、およびリステリア菌・サルモネラ菌・黄色ブドウ球菌毒素の増殖リスクを計算。",
    breadcrumbs: [
      { label: 'ホーム', href: '/ja/' },
      { label: 'ツール一覧', href: '/ja/tools/' },
      { label: '冷蔵庫除霜・冷鎖破断シミュレーター' }
    ],
    monoBadge: "熱力学および食中毒病原体リスク解析",
    monoTitle: "冷蔵庫デフロストサーモスタット故障＆冷鎖破断シミュレーター",
    monoSub: "エバポレーターの霜結氷による風道遮断、バイメタルのオープン・溶着不良、および 4.4°C (40°F) 超過による細菌毒素増殖をシミュレート。",
    monoSection1Title: "1. 間冷式（ファン式）冷蔵庫の熱力学と隠蔽型凍結",
    monoSection1Body: "一般的なファン式冷蔵庫では、冷凍室背面のエバポレーターで冷気を作り出し、ファンで冷蔵室へ送風します。除霜回路（バイメタルサーモ、ヒーター、タイマー）が故障すると、数日でアルミフィンが分厚い氷の塊で覆われて風道が完全遮断されます。冷凍室は残冷で冷たく見えますが、冷蔵室は知らぬ間に 12°C〜15°C まで上昇します。",
    monoSection2Title: "2. コールドチェーン破壊の細菌リスク：リステリアと耐熱毒素",
    monoSection2Body: "リステリア菌は低温増殖能を持ち、7°C〜11°Cでは急速に倍加し致死率は20%〜30%に達します。また、加熱調理済み食品が 10°C (50°F) 以上で4時間放置されると黄色ブドウ球菌が耐熱性エンテロトキシンを産生します。この毒素は30分沸騰させても分解されず、再加熱しても無毒化できません。",
    monoSection3Title: "3. デジタルテスターによる4ステップ電気点検",
    monoSection3Body: "必ずコンセントを抜き、冷凍室背面のパネルを取り外します。凍った状態（-6°C以下）でバイメタルの導通を測定し、0 Ω であれば正常、導通なし（O.L.）なら故障です。カルロッドヒーターの抵抗値は 15〜35 Ω が正常で、O.L. なら断線しています。",
    faqs: [
      {
        question: "冷凍室は凍っているのに冷蔵室が冷えないのはなぜですか？",
        answer: "除霜（デフロスト）システムの故障による典型的な症状です。エバポレーターに氷がびっしり張り付き、冷蔵室への冷気循環ダクトを完全に塞いでしまっています。"
      },
      {
        question: "ぬるくなった冷蔵庫にあった肉は、よく火を通せば食べられますか？",
        answer: "いいえ！再加熱しても黄色ブドウ球菌が産生した耐熱性エンテロトキシンは破壊されません。加熱殺菌しても毒素による激しい嘔吐や下痢を防ぐことはできません。"
      },
      {
        question: "4°C以上になった生鮮食品は何時間で廃棄すべきですか？",
        answer: "USDA（米国農務省）およびFDAの基準では、生肉、牛乳、惣菜などは4°C以上で2時間を超えた場合（10°C以上では1時間）、安全のため廃棄が強く推奨されます。"
      }
    ]
  }
};

const content = CONTENT[lang] || CONTENT.es;
---

<Layout title={content.pageTitle} description={content.pageDescription} faqs={content.faqs} lang={lang} availableLocales={availableLocales}>
  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={content.breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1280px] mx-auto px-6 py-10 md:py-16">
    <!-- Header -->
    <header class="max-w-4xl mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-cyan-100 text-cyan-900 mb-3">
        <span>🧊</span>
        {content.monoBadge}
      </div>
      <h1 class="text-3xl md:text-5xl font-extrabold text-ink tracking-tight mb-4 leading-tight">
        {content.monoTitle}
      </h1>
      <p class="text-base md:text-xl text-body leading-relaxed">
        {content.monoSub}
      </p>
    </header>

    <!-- Interactive Simulator Component -->
    <RefrigeratorDefrostSafetyModeler lang={lang} />

    <!-- Scientific Engineering & Physics Guide -->
    <article class="prose max-w-none border-t border-hairline pt-12 space-y-10 text-body">
      <div>
        <h2 class="text-2xl font-bold text-ink mb-4">
          {content.monoSection1Title}
        </h2>
        <p class="leading-relaxed">
          {content.monoSection1Body}
        </p>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-ink mb-4">
          {content.monoSection2Title}
        </h2>
        <p class="leading-relaxed">
          {content.monoSection2Body}
        </p>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-ink mb-4">
          {content.monoSection3Title}
        </h2>
        <p class="leading-relaxed">
          {content.monoSection3Body}
        </p>
      </div>
    </article>
  </div>
</Layout>
