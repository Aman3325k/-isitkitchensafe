---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import WaterFilterEfficiencyAnalyzer from '../../../components/WaterFilterEfficiencyAnalyzer.astro';
import type { SupportedLanguage } from '../../../i18n/ui';
import { useTranslations, useTranslatedPath } from '../../../i18n/utils';

export function getStaticPaths() {
  const availableLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'zh-cn', 'ja'];
  return [
    { params: { lang: 'es' }, props: { lang: 'es' as SupportedLanguage, availableLocales } },
    { params: { lang: 'pt' }, props: { lang: 'pt' as SupportedLanguage, availableLocales } },
    { params: { lang: 'zh-cn' }, props: { lang: 'zh-cn' as SupportedLanguage, availableLocales } },
    { params: { lang: 'ja' }, props: { lang: 'ja' as SupportedLanguage, availableLocales } }
  ];
}

interface Props {
  lang: SupportedLanguage;
  availableLocales: SupportedLanguage[];
}

const { lang, availableLocales } = Astro.props;
const t = useTranslations(lang);
const tp = useTranslatedPath(lang);

interface LocaleContent {
  pageTitle: string;
  pageDescription: string;
  breadcrumbs: Array<{ label: string; href?: string }>;
  faqs: Array<{ question: string; answer: string }>;
  faqHeading: string;
  faqSub: string;
}

const CONTENT: Record<SupportedLanguage, LocaleContent> = {
  en: {} as any,
  es: {
    pageTitle: "Analizador de Eficiencia de Filtros: Fluoruro, Microplásticos y Metales Pesados | IsItKitchenSafe",
    pageDescription: "Calculadora científica de filtración de agua: evalúa cinéticas de rechazo de Ósmosis Inversa (RO), ultrafiltración y carbón en PFAS, plomo, fluoruro y remineralización.",
    breadcrumbs: [
      { label: 'Inicio', href: '/es/' },
      { label: 'Herramientas', href: '/es/tools/' },
      { label: 'Analizador de Eficiencia de Filtros de Agua' }
    ],
    faqHeading: "Preguntas Frecuentes sobre Filtración de Agua, Membranas y Mineralización",
    faqSub: "Respuestas científicas respaldadas por las normas EPA NPDWR 2024, NSF/ANSI 58/53 y pautas de la OMS.",
    faqs: [
      {
        question: "¿La ósmosis inversa elimina por completo el fluoruro del agua del grifo?",
        answer: "Sí, una membrana certificada de poliamida compuesta de película fina (TFC) elimina entre el 90% y el 95% del fluoruro municipal (F⁻). Debido a su diminuto radio iónico (0.352 nm), los filtros de carbón estándar no pueden adsorberlo. La ósmosis inversa lo logra mediante la repulsión electrostática de Donnan: la superficie con carga negativa de la membrana repele el anión fluoruro."
      },
      {
        question: "¿Por qué las jarras filtrantes comunes no eliminan los PFAS ni los metales pesados?",
        answer: "Las jarras básicas (certificadas solo bajo NSF 42 para sabor a cloro) contienen carbón granular suelto por donde el agua discurre por gravedad sin suficiente tiempo de contacto. Los compuestos químicos eternos PFAS y el plomo iónico disuelto (Pb²⁺) traspasan fácilmente el lecho a menos que se trate de bloques compactos certificados bajo NSF 53 o 58."
      },
      {
        question: "¿Es perjudicial para la salud beber agua de ósmosis pura sin remineralizar?",
        answer: "Según los informes de la Organización Mundial de la Salud (OMS), el agua totalmente desmineralizada (< 30 ppm TDS) no es tóxica de forma aguda, pero es subóptima para el consumo diario prolongado. Al carecer de calcio y magnesio, tiene un pH ácido (5.8 a 6.4). Instalar un post-filtro de calcita y corosex restablece un pH alcalino saludable (7.5 a 8.2) y aporta 25 a 45 ppm de minerales biodisponibles."
      },
      {
        question: "¿Cuál es el nuevo límite de la EPA 2024 para PFAS en agua potable?",
        answer: "En abril de 2024, la EPA estableció límites máximos legalmente vinculantes (MCL) de 4.0 partes por trillón (ppt) para PFOA y PFOS. La ósmosis inversa de alta presión y los bloques de carbón catalítico certificados son las tecnologías designadas capaces de cumplir con este estándar."
      },
      {
        question: "¿Puede una membrana de ultrafiltración (UF) retener microplásticos sin desperdiciar agua?",
        answer: "Sí. Las membranas de fibra hueca de ultrafiltración tienen poros de 0.01 a 0.02 micras, constituyendo una barrera física contra microplásticos y nanoplásticos. Funcionan con la presión de red habitual, tienen cero rechazo de agua y conservan los minerales disueltos, aunque no retienen fluoruro ni reducen el TDS."
      },
      {
        question: "¿Cómo desgasta la dureza del agua la membrana de ósmosis inversa?",
        answer: "Cuando el agua entrante tiene alta concentración de calcio y magnesio (> 180 ppm CaCO₃), las sales precipitan en la membrana formando incrustaciones que reducen el caudal y pueden perforar el entramado polimérico, permitiendo el paso de contaminantes si no se realiza un mantenimiento periódico."
      }
    ]
  },
  pt: {
    pageTitle: "Analisador de Eficiência de Filtros: Fluoreto, Microplásticos e Metais Pesados | IsItKitchenSafe",
    pageDescription: "Calculadora de filtragem de água: simule a eficiência de membranas de Osmose Reversa (RO), ultrafiltração e carvão ativado contra PFAS, chumbo, fluoreto e microplásticos.",
    breadcrumbs: [
      { label: 'Início', href: '/pt/' },
      { label: 'Ferramentas', href: '/pt/tools/' },
      { label: 'Analisador de Eficiência de Filtros de Água' }
    ],
    faqHeading: "Perguntas Frequentes sobre Purificação de Água, Membranas e Mineralização",
    faqSub: "Fundamentado nos regulamentos da EPA 2024, certificações NSF/ANSI 58/53 e diretrizes da OMS.",
    faqs: [
      {
        question: "A osmose reversa consegue eliminar o fluoreto da água encanada?",
        answer: "Sim, membranas de compósito de poliamida (TFC) removem de 90% a 95% do fluoreto (F⁻). Por ter um raio iônico muito reduzido (0.352 nm), os filtros de carvão comuns não retêm o fluoreto. A osmose reversa o elimina por repulsão eletrostática de Donnan."
      },
      {
        question: "Por que jarras filtrantes comuns não retêm PFAS e metais pesados?",
        answer: "Filtros de jarra comuns utilizam carvão ativado granular solto projetado apenas para sabor de cloro (NSF 42). O fluxo por gravidade é rápido demais e não retém compostos químicos persistentes (PFAS) nem chumbo dissolvido, exigindo blocos compactos certificados NSF 53 ou osmose reversa."
      },
      {
        question: "Beber água de osmose reversa pura sem remineralização faz mal?",
        answer: "A Organização Mundial da Saúde (OMS) destaca que a água totalmente desmineralizada (< 30 ppm TDS) possui pH ácido (5.8 a 6.4) e não fornece cálcio e magnésio. A adição de um cartucho pós-filtro com calcita e óxido de magnésio devolve o pH alcalino saudável (7.5 a 8.2) e minerais essenciais."
      },
      {
        question: "Qual é a nova norma da EPA para PFAS na água potável?",
        answer: "A norma da EPA de 2024 fixou o limite máximo legal em 4.0 partes por trilhão (ppt) para PFOA e PFOS. A osmose reversa e blocos de carvão catalítico são as tecnologias recomendadas para atingir essa exigência."
      },
      {
        question: "A membrana de ultrafiltração (UF) elimina microplásticos sem desperdiçar água?",
        answer: "Sim. A ultrafiltração possui poros de 0.01 a 0.02 micra, retendo 99.8% dos microplásticos e bactérias com 100% de aproveitamento da água e mantendo os minerais naturais, embora não remova fluoreto nem reduza o TDS."
      },
      {
        question: "De que forma a água dura prejudica as membranas de osmose reversa?",
        answer: "Água com dureza superior a 180 ppm CaCO₃ provoca o acúmulo de cristais de carbonato de cálcio sobre os poros da membrana, provocando perda de vazão e enfraquecimento da capacidade de filtração se a manutenção for negligenciada."
      }
    ]
  },
  "zh-cn": {
    pageTitle: "反渗透净水器效率与氟化物、微塑料及重金属过滤评估工具 | IsItKitchenSafe",
    pageDescription: "基于唐南电排斥理论与 EPA 2024 PFAS 标准的净水效率计算器：模拟反渗透（RO）、超滤与活性炭滤芯对氟化物、重金属铅、纳米微塑料与全氟化物的去除率及矿化健康评分。",
    breadcrumbs: [
      { label: '首页', href: '/zh-cn/' },
      { label: '实用工具', href: '/zh-cn/tools/' },
      { label: '反渗透与饮用水过滤效率评估工具' }
    ],
    faqHeading: "净水膜过滤技术、化学毒素阻隔与矿化健康常见问题解答",
    faqSub: "基于美国国家主要饮用水法规（EPA NPDWR 2024）、NSF/ANSI 58/53 认证标准及世界卫生组织准则。",
    faqs: [
      {
        question: "反渗透（RO）净水机能彻底滤除自来水中的氟化物吗？",
        answer: "可以。正规薄膜复合（TFC）聚酰胺反渗透膜对氟化物（F⁻）的拦截率达 90% 至 95%。由于水合氟离子半径仅为 0.352 纳米，普通活性炭滤芯对其完全无效。反渗透膜依靠聚酰胺表面的负电荷形成唐南（Donnan）静电排斥，将带负电的氟离子有效阻隔在外。"
      },
      {
        question: "为什么普通家用重力滤水壶无法滤除 PFAS“永久化学品”与重金属铅？",
        answer: "市面常见的基础滤水壶（仅符合 NSF 42 改善口感标准）采用散装颗粒活性炭（GAC）。水流在重力下流速快且接触时间极短，短链 PFAS 和可溶性二价铅离子（Pb²⁺）会直接穿透。必须使用经 NSF 53 或 NSF 58 认证的高密度烧结碳棒或反渗透膜才能安全去除。"
      },
      {
        question: "长期饮用没有矿化的高纯度反渗透纯净水对身体有害吗？",
        answer: "世界卫生组织（WHO）明确指出：长期饮用总溶解固体（TDS < 30 ppm）的完全去矿物质水属于亚健康状态。RO 水去除了 95% 以上的有益矿物质，且因吸收空气二氧化碳呈弱酸性（pH 5.8-6.4）。建议在反渗透末端加装食品级方解石与氧化镁矿化滤芯，将出水恢复为微弱碱性（pH 7.5-8.2）并补充 25-45 ppm 人体所需的钙、镁微量元素。"
      },
      {
        question: "美国 EPA 2024 年对饮用水中 PFAS 颁布的最新强制标准是什么？",
        answer: "2024 年 4 月，美国 EPA 最终敲定了具有法律强制力的国家饮用水法规，将 PFOA 和 PFOS 的最高污染物容许浓度（MCL）定为极其严苛的 4.0 ppt（纳克/升）。高压反渗透与专业级双级催化碳棒被指定为能够稳定达到这一标准的最佳可行技术（BAT）。"
      },
      {
        question: "超滤膜（UF）可以在零废水排出的前提下拦截微塑料吗？",
        answer: "可以。中空纤维超滤膜的孔径在 0.01 到 0.02 微米（10-20 纳米）之间，对于微塑料和纳米级塑料颗粒的物理截留率高达 99.8% 以上。超滤膜依靠市政常压工作、零废水产生，并且能完整保留水中的天然钙镁离子。但超滤膜无法去除氟离子和溶解性无机盐（TDS）。"
      },
      {
        question: "自来水的高硬度是如何加速反渗透膜结垢与损坏的？",
        answer: "当进水碳酸钙硬度超过 180 ppm 时，浓水侧的钙镁离子浓度超过了溶解度积，导致碳酸钙微晶在聚酰胺膜表面析出沉积（浓差极化结垢）。这不仅会导致产水量锐减，还可能物理撑破致密分离层导致脱盐率暴跌。在高硬度地区，定期冲洗或配备前置软水装置是确保膜寿命的关键。"
      }
    ]
  },
  ja: {
    pageTitle: "逆浸透膜（RO）浄水器効率＆フッ素・マイクロプラスチック・重金属除去診断ツール | IsItKitchenSafe",
    pageDescription: "科学的エビデンスに基づく飲用水ろ過計算機：逆浸透膜（RO）、限外ろ過（UF）、活性炭のPFAS、鉛、フッ素、微小プラスチック除去効率および再ミネラル化健康度を診断。",
    breadcrumbs: [
      { label: 'ホーム', href: '/ja/' },
      { label: 'ツール一覧', href: '/ja/tools/' },
      { label: '水質浄化膜フィルター効率診断' }
    ],
    faqHeading: "飲用水浄水膜、有害化学物質除去およびミネラル補給に関するよくある質問",
    faqSub: "米EPA 2024年水質基準、NSF/ANSI 58・53規格、世界保健機関（WHO）基準準拠。",
    faqs: [
      {
        question: "逆浸透膜（RO）は水道水のフッ素を完全に除去できますか？",
        answer: "はい。認定されたポリアミド系複合逆浸透膜（TFC）は水道水中のフッ化物（F⁻）を90%〜95%除去します。水和フッ素イオンは極めて小さいため（0.352nm）、通常の活性炭では吸着できませんが、RO膜表面の負電荷によるドナン静電反発効果によって高い阻止率を達成します。"
      },
      {
        question: "市販の簡易ポット型浄水器ではなぜPFASや鉛を防ぎきれないのですか？",
        answer: "簡易ポット型（NSF 42規格）は粒状活性炭（GAC）を使用しており、重力による素早い通水では有害物質の吸着時間が足りません。短鎖PFASや溶存態の鉛イオン（Pb²⁺）は素通りしてしまうため、NSF 53または58認証を取得した高密度炭素ブロックやRO膜が必要です。"
      },
      {
        question: "ミネラルを完全に除去した純粋なRO水を毎日飲むのは問題ありませんか？",
        answer: "WHO（世界保健機関）の報告によると、ミネラルが完全に除去された水（TDS < 30 ppm）は酸性度（pH 5.8〜6.4）を帯び、必須カルシウムやマグネシウムを補給できません。カルサイトや酸化マグネシウムを含む後段ミネラルカートリッジを取り付け、pHを弱アルカリ性（7.5〜8.2）に整えることが推奨されます。"
      },
      {
        question: "米国EPAが2024年に定めたPFASの最新基準とは？",
        answer: "2024年4月、米EPAはPFOAおよびPFOSに対して法的強制力を持つ最大許容濃度（MCL）を【4.0 ppt（1兆分の4）】という極めて厳しい値に設定しました。逆浸透膜（RO）システムはこの基準を達成できる最高水準の技術として認められています。"
      },
      {
        question: "限外ろ過（UF膜）は排水を出さずにマイクロプラスチックを除去できますか？",
        answer: "はい。中空糸UF膜の孔径は0.01〜0.02マイクロメートルで、マイクロプラスチックやナノプラスチックを99.8%以上物理的に遮断します。水道圧のみで動作し排水も出さず、天然ミネラルをそのまま残せますが、フッ素や溶解性塩類（TDS）の除去はできません。"
      },
      {
        question: "水道水の高硬度はどのようにRO膜を劣化させますか？",
        answer: "原水の硬度が180 ppm（CaCO₃換算）を超えると、濃縮水側で炭酸カルシウムが結晶化して膜表面にスケールが付着します。これにより透過水量が激減し、膜の微小破損を引き起こして脱塩率が低下するため、定期的なフラッシングや前処理が重要です。"
      }
    ]
  }
};

const content = CONTENT[lang];
---

<Layout title={content.pageTitle} description={content.pageDescription} faqs={content.faqs} availableLocales={availableLocales}>
  <main class="container mx-auto px-4 py-8 max-w-5xl space-y-8">
    <Breadcrumbs items={content.breadcrumbs} />

    <WaterFilterEfficiencyAnalyzer lang={lang} />

    <!-- Scientific Section -->
    <section class="bg-surface-soft border border-hairline rounded-3xl p-6 md:p-10 space-y-8">
      <div class="border-b border-hairline pb-4">
        <span class="text-xs font-bold uppercase tracking-wider text-cyan-800 dark:text-cyan-400 block mb-1">
          {content.faqHeading}
        </span>
        <h2 class="text-title-lg font-bold text-ink tracking-tight">
          {content.faqSub}
        </h2>
      </div>

      <div class="space-y-4">
        {content.faqs.map(faq => (
          <div class="bg-canvas border border-hairline rounded-2xl p-5 space-y-2">
            <h3 class="text-sm md:text-base font-bold text-ink flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-cyan-500 shrink-0"></span>
              {faq.question}
            </h3>
            <p class="text-xs md:text-sm text-body leading-relaxed pl-4">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </section>
  </main>
</Layout>
