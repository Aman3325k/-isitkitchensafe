      {
        question: "Spiegler-Kedem 輸送方程式とファントホッフの法則はどのように第1段 FO 透過流束を規定しますか？",
        answer: "正浸透は外部の高圧ポンプ圧力ではなく、膜を挟んだ化学ポテンシャル差によって駆動されます。Spiegler-Kedem 理論に基づき膜透過水流束は J_w = A · [σ · (π_draw - π_feed) - ΔP] で定義され、A は透水係数、σ は反射係数（≈ 1.0）、π は浸透圧です。食品グレードの高濃度 MgCl2（28 wt%、浸透圧 115 bar）や乳酸カリウム（92 bar）を用いることで、60〜90 bar の強力な正味浸透圧駆動力が生じます。印加油圧 ΔP がゼロに近いため、逆浸透（RO）のような膜ファウリングの油圧圧縮が起きず、低せん断 CIP 洗浄で簡単に再生可能です。"
      },
      {
        question: "Mullins-Sekerka 界面安定性基準はどのように氷晶の巻き込みを防止しますか？",
        answer: "第2段の進行性凍結晶析では、原料液が冷却ジャケット管内を乱流状態（Reynolds数 Re > 4,000）で高速循環します。Mullins-Sekerka の形態安定性理論によれば、液相温度勾配が溶質濃縮による組織的過冷却を上回る限り、氷と液の界面は平滑な平面を維持します。しかし氷晶前進速度が 2.5〜3.0 mm/h を超えるか粘度が 150 cP を上回ると、界面が崩壊して樹枝状デンドライトを形成し、濃縮シロップを氷の隙間に閉じ込めてしまいます。晶析速度を 2.2 mm/h 以下に厳密制御し管内せん断力を付加することで、氷晶への溶質混入ロスを 0.15% 未満に抑え込みます。"
      },
      {
        question: "FO-FC システムの比エネルギー消費量 (SEC) は機械的蒸気再圧縮 (MVR) と比較してどの程度優位ですか？",
        answer: "MVR 加熱蒸発器は水の蒸発潜熱（2,260 kJ/kg）を必要とし、多段熱回収を行っても工業的には水 1 kg あたり 2.1〜3.8 MJ の一次エネルギーを消費します。これに対し、凍結晶析が利用する水の凝固潜熱はわずか 334 kJ/kg であり、蒸発潜熱の 15% 未満です。常温駆動の正浸透前処理と組み合わせることで、FO-FC ハイブリッドスキッド全体の比エネルギー消費量は水 1 kg あたり 0.65〜1.15 MJ に抑えられ、従来の熱力学蒸発プロセスに比べて 70% 以上の電力・熱エネルギー削減を実現します。"
      }
    ]
  }
};

const curContent = CONTENT[lang as Exclude<SupportedLanguage, 'en'>] || CONTENT.es;
const pageTitle = curContent.pageTitle;
const pageDescription = curContent.pageDescription;

const breadcrumbs = [
  { label: t('nav.home'), href: tp('/') },
  { label: t('nav.tools'), href: tp('/tools/') },
  { label: curContent.breadcrumbsLabel }
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": `https://isitkitchensafe.com/${lang}/tools/commercial-continuous-fo-fc-freeze-concentration-modeler/#webapp`,
      "url": `https://isitkitchensafe.com/${lang}/tools/commercial-continuous-fo-fc-freeze-concentration-modeler/`,
      "name": curContent.h1,
      "applicationCategory": "EngineeringApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5 Canvas/CSS3.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": pageDescription
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": t('nav.home'),
          "item": `https://isitkitchensafe.com/${lang}/`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": t('nav.tools'),
          "item": `https://isitkitchensafe.com/${lang}/tools/`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": curContent.breadcrumbsLabel,
          "item": `https://isitkitchensafe.com/${lang}/tools/commercial-continuous-fo-fc-freeze-concentration-modeler/`
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": curContent.faqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <div class="max-w-6xl mx-auto px-4 py-4">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <CommercialContinuousFoFcModeler lang={lang} />

  <!-- Detailed Engineering FAQs Section -->
  <section class="max-w-6xl mx-auto px-4 py-12 border-t border-hairline mt-8">
    <div class="mb-8">
      <h2 class="text-2xl font-bold tracking-tight text-ink mb-2">
        {curContent.h1}
      </h2>
      <p class="text-sm text-muted">
        {curContent.lead}
      </p>
    </div>

    <div class="space-y-6">
      {curContent.faqs.map(faq => (
        <article class="bg-surface-soft border border-hairline rounded-xl p-6 shadow-xs">
          <h3 class="text-base font-bold text-ink mb-2">
            {faq.question}
          </h3>
          <p class="text-sm text-muted leading-relaxed">
            {faq.answer}
          </p>
        </article>
      ))}
    </div>
  </section>
</Layout>
