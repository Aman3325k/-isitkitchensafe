---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import InductionCookwareCompatibilityChecker from '../../../components/InductionCookwareCompatibilityChecker.astro';
import rawData from '../../../data/induction-cookware-compatibility-data.json';
import type { SupportedLanguage } from '../../../i18n/ui';

export function getStaticPaths() {
  const availableLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'zh-cn', 'ja'];
  return [
    { params: { lang: 'es' }, props: { lang: 'es' as SupportedLanguage, availableLocales } },
    { params: { lang: 'pt' }, props: { lang: 'pt' as SupportedLanguage, availableLocales } },
    { params: { lang: 'zh-cn' }, props: { lang: 'zh-cn' as SupportedLanguage, availableLocales } },
    { params: { lang: 'ja' }, props: { lang: 'ja' as SupportedLanguage, availableLocales } }
  ];
}

interface Props {
  lang: SupportedLanguage;
  availableLocales: SupportedLanguage[];
}

const { lang, availableLocales } = Astro.props;

interface LocalePageContent {
  pageTitle: string;
  pageDescription: string;
  badge: string;
  h1: string;
  heroSub: string;
  breadcrumbs: Array<{ label: string; href?: string }>;
}

const CONTENT: Record<Exclude<SupportedLanguage, 'en'>, LocalePageContent> = {
  es: {
    pageTitle: "Verificador de Compatibilidad de Sartenes con Placa de Inducción | IsItKitchenSafe",
    pageDescription: "Comprueba si 24 materiales y marcas populares de sartenes (Le Creuset, Lodge, All-Clad, Caraway, HexClad, Pyrex) funcionan en placas de inducción. Incluye simulador de prueba del imán, riesgo de rayaduras y advertencias de marcapasos.",
    badge: "Prueba del Imán de 3 Segundos · Marcas y Materiales",
    h1: "Verificador de Compatibilidad de Sartenes con Cocina de Inducción",
    heroSub: "Descubre al instante si tus sartenes y ollas funcionan en placas de inducción: prueba del imán de 3 segundos, comparación de acero 430 magnético frente a 304, alerta para hierro fundido en vidrio y distancia de seguridad EMF para marcapasos.",
    breadcrumbs: [
      { label: "Inicio", href: "/es/" },
      { label: "Herramientas", href: "/es/tools/" },
      { label: "Compatibilidad con Inducción" }
    ]
  },
  pt: {
    pageTitle: "Verificador de Panelas Compatíveis com Fogão de Indução | IsItKitchenSafe",
    pageDescription: "Descubra se 24 marcas e materiais de panelas (Le Creuset, Lodge, All-Clad, Caraway, HexClad, Pyrex) funcionam no fogão de indução. Inclui simulador do teste do ímã, alerta de riscos no vidro e segurança para marca-passos.",
    badge: "Teste do Ímã em 3 Segundos · Marcas e Materiais",
    h1: "Verificador de Compatibilidade de Panelas com Fogão de Indução",
    heroSub: "Saiba imediatamente se suas panelas funcionam na placa de indução: teste do ímã magnético de 3 segundos, fundo ferromagnético, prevenção de arranhões no vidro vitrocerâmico e distância segura de radiação eletromagnética para marca-passos.",
    breadcrumbs: [
      { label: "Início", href: "/pt/" },
      { label: "Ferramentas", href: "/pt/tools/" },
      { label: "Compatibilidade com Indução" }
    ]
  },
  'zh-cn': {
    pageTitle: "电磁炉锅具兼容性与磁铁测试诊断工具 | IsItKitchenSafe",
    pageDescription: "一键查询 24 种常见锅具品牌与材质（Le Creuset、Lodge、All-Clad、Caraway、HexClad、Pyrex）是否兼容电磁炉。内置 3 秒磁铁吸附模拟器、微晶玻璃防刮花指南及心脏起搏器 EMF 安全间距提醒。",
    badge: "3 秒磁铁测试 · 24 款主流锅具材质与品牌",
    h1: "电磁炉锅具兼容性与磁铁测试诊断工具",
    heroSub: "3 秒诊断你的炒锅、平底锅与汤锅是否能在电磁炉上发热：导磁不锈钢 430 与非导磁 304 辨别、粗糙铸铁底防刮花技巧、蜂窝锅导热效率及心脏起搏器电磁辐射安全距离。",
    breadcrumbs: [
      { label: "首页", href: "/zh-cn/" },
      { label: "实用工具", href: "/zh-cn/tools/" },
      { label: "电磁炉锅具兼容性工具" }
    ]
  },
  ja: {
    pageTitle: "IHクッキングヒーター対応鍋＆マグネット判定チェッカー | IsItKitchenSafe",
    pageDescription: "ル・クルーゼ、ロッジ、オールクラッド、カラウェイ、パイレックスなど24の主要ブランド・材質がIHで使えるか即判定。3秒マグネット吸着テスト、ガラストップ傷防止、ペースメーカー電磁波安全距離を網羅。",
    badge: "3秒磁石テスト · 主要24材質＆人気ブランド判定",
    h1: "IHクッキングヒーター対応鍋＆マグネット判定チェッカー",
    heroSub: "お持ちのフライパンや鍋がIHで使えるかを3秒で診断：磁性ステンレス（430系）と非磁性（304系）の違い、ザラザラした鋳鉄底による天板ガラス傷防止法、ペースメーカー装着者の安全離隔距離まで徹底解説。",
    breadcrumbs: [
      { label: "ホーム", href: "/ja/" },
      { label: "ツール", href: "/ja/tools/" },
      { label: "IH対応鍋チェッカー" }
    ]
  }
};

const c = CONTENT[lang as Exclude<SupportedLanguage, 'en'>] || CONTENT.es;
const faqs = (rawData.faqs as Record<string, Array<{ question: string; answer: string }>>)[lang] || rawData.faqs.en;
const localizedUrl = `https://isitkitchensafe.com/${lang}/tools/induction-cookware-compatibility-checker/`;

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": c.h1,
  "url": localizedUrl,
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript.",
  "description": c.pageDescription,
  "inLanguage": lang === 'zh-cn' ? 'zh-CN' : lang,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={c.pageTitle}
  description={c.pageDescription}
  faqs={faqs}
  excludeFaqSchema={true}
  availableLocales={availableLocales}
  lang={lang}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1 print:hidden">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={c.breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1140px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-purple-700 text-white mb-3">
        {c.badge}
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        {c.h1}
      </h1>
      <p class="text-body text-[15px] md:text-[16px] leading-relaxed">
        {c.heroSub}
      </p>
    </header>

    <!-- Main Interactive Checker Component -->
    <InductionCookwareCompatibilityChecker lang={lang} />
  </div>
</Layout>