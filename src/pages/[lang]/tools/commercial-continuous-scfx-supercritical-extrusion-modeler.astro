const pageDescription = c.pageDescription;

const breadcrumbs = [
  { label: t('nav.home') || 'Home', href: tp('/') },
  { label: t('nav.tools') || 'Tools', href: tp('/tools/') },
  { label: c.breadcrumbsLabel }
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": `https://isitkitchensafe.com/${lang}/tools/commercial-continuous-scfx-supercritical-extrusion-modeler/#webapp`,
      "url": `https://isitkitchensafe.com/${lang}/tools/commercial-continuous-scfx-supercritical-extrusion-modeler/`,
      "name": c.h1,
      "applicationCategory": "EngineeringApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5 Canvas/CSS3.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": pageDescription
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": t('nav.home') || 'Home',
          "item": `https://isitkitchensafe.com${tp('/')}`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": t('nav.tools') || 'Tools',
          "item": `https://isitkitchensafe.com${tp('/tools/')}`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": c.breadcrumbsLabel,
          "item": `https://isitkitchensafe.com/${lang}/tools/commercial-continuous-scfx-supercritical-extrusion-modeler/`
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": c.faqs.map(f => ({
        "@type": "Question",
        "name": f.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": f.answer
        }
      }))
    }
  ]
};
---

<Layout 
  title={pageTitle} 
  description={pageDescription}
  structuredData={structuredData}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <CommercialContinuousScfxSupercriticalExtrusionModeler lang={lang} />

  <!-- FAQ Section with Schema.org Compliance -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 border-t border-hairline/60 my-12">
    <div class="space-y-4 text-center sm:text-left mb-8">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-ink tracking-tight">
        {c.h1}: FAQs
      </h2>
      <p class="text-muted text-sm sm:text-base">
        {c.lead}
      </p>
    </div>

    <div class="space-y-6">
      {c.faqs.map((faq, index) => (
        <article class="p-6 rounded-2xl bg-surface-soft border border-hairline space-y-3">
          <h3 class="text-base sm:text-lg font-bold text-ink flex items-start gap-3">
            <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-emerald-950 text-emerald-300 text-xs font-bold shrink-0 border border-emerald-800 mt-0.5">
              {index + 1}
            </span>
            <span>{faq.question}</span>
          </h3>
          <p class="text-xs sm:text-sm text-ink/80 leading-relaxed pl-9">
            {faq.answer}
          </p>
        </article>
      ))}
    </div>
  </section>
</Layout>
