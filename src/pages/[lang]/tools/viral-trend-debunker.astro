---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ViralTrendDebunker from '../../../components/ViralTrendDebunker.astro';
import type { SupportedLanguage } from '../../../i18n/ui';
import { useTranslations, useTranslatedPath } from '../../../i18n/utils';

export function getStaticPaths() {
  const availableLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'zh-cn', 'ja'];
  return [
    { params: { lang: 'es' }, props: { lang: 'es' as SupportedLanguage, availableLocales } },
    { params: { lang: 'pt' }, props: { lang: 'pt' as SupportedLanguage, availableLocales } },
    { params: { lang: 'zh-cn' }, props: { lang: 'zh-cn' as SupportedLanguage, availableLocales } },
    { params: { lang: 'ja' }, props: { lang: 'ja' as SupportedLanguage, availableLocales } }
  ];
}

interface Props {
  lang: SupportedLanguage;
  availableLocales: SupportedLanguage[];
}

const { lang, availableLocales } = Astro.props;
const t = useTranslations(lang);
const tp = useTranslatedPath(lang);

interface LocaleDebunkerContent {
  pageTitle: string;
  pageDescription: string;
  badge: string;
  h1: string;
  heroSub: string;
  scienceTitle: string;
  scienceIntro: string;
  sciencePillars: Array<{ num: string; title: string; desc: string }>;
  faqs: Array<{ question: string; answer: string }>;
  breadcrumbs: Array<{ label: string; href?: string }>;
}

const CONTENT: Record<SupportedLanguage, LocaleDebunkerContent> = {
  en: {} as any,
  es: {
    pageTitle: "Detector de Mitos Virales de Cocina y Hacks de TikTok | IsItKitchenSafe",
    pageDescription: "Investigaciones científicas rigurosas sobre trucos virales de TikTok y YouTube. Termodinámica real, límites de choque térmico y peligros de incendio en huevos al microondas, salmón en lavavajillas y tostadoras volcadas.",
    badge: "Física de Laboratorio • Seguridad contra Incendios • Evaluado por Expertos",
    h1: "Detector y Desmitificador de Tendencias Culinarias Virales",
    heroSub: "No permitas que los trucos de 15 segundos en redes sociales destruyan tus electrodomésticos o provoquen quemaduras graves. Analizamos la termodinámica, dinámica de fluidos y microbiología real detrás de los vídeos más virales.",
    scienceTitle: "La Física Oculta de los Peligros Culinarios Virales",
    scienceIntro: "Los electrodomésticos de cocina funcionan bajo estrictos márgenes térmicos y mecánicos. Cuando los trucos de redes sociales rompen estos límites, la física reacciona de forma inevitable:",
    sciencePillars: [
      {
        num: "01",
        title: "Agua Sobrecalentada y Recipientes a Presión",
        desc: "En alimentos con membranas selladas (como la yema de huevo o salchichas), las microondas calientan el agua por encima de los 100°C sin hervir debido a la presión hidrostática interna. El menor pinchazo causa una detonación instantánea de vapor a más de 1.600 veces su volumen original."
      },
      {
        num: "02",
        title: "Arrastre Aerodinámico Ciclónico",
        desc: "Las freidoras de aire son túneles de viento que mueven aire a más de 20 m/s. Los alimentos ligeros (palomitas de maíz, hierbas secas o papel de aluminio suelto) se elevan por sustentación aerodinámica directo a la resistencia al rojo vivo a 500°C, provocando fuego inmediato."
      },
      {
        num: "03",
        title: "Choque Térmico por Dilatación Diferencial",
        desc: "El vidrio de cal sodada común sólo tolera diferencias térmicas de 50°C a 55°C. Pasar una fuente de horno a 200°C a agua fría o hielo crea tensiones de más de 15.000 PSI en décimas de segundo, destrozando el vidrio en miles de proyectiles afilados."
      }
    ],
    faqs: [
      {
        question: "¿Por qué explotan con tanta violencia los huevos enteros en el microondas?",
        answer: "La cáscara y la membrana vitelina forman un recipiente sellado hermético. El agua interior se sobrecalienta por encima de los 100°C. Al romper la membrana con un tenedor o con los dientes, la presión se libera de golpe y el agua líquida se convierte en vapor explosivo en milisegundos, provocando quemaduras de segundo grado y lesiones oculares graves."
      },
      {
        question: "¿Es realmente peligroso comer salmón cocinado en el lavavajillas?",
        answer: "Sí, por partida doble: patógenos bacterianos y productos químicos tóxicos. El agua del lavavajillas fluctúa entre 45°C y 60°C, sin alcanzar los 63°C continuos necesarios según las agencias de seguridad alimentaria para destruir Salmonella y Listeria. Además, el papel de aluminio no es hermético y los tensioactivos y abrillantadores penetran en el pescado."
      },
      {
        question: "¿Por qué poner la tostadora de lado para hacer sándwiches de queso es un riesgo de incendio?",
        answer: "Las tostadoras dependen de la salida de aire caliente hacia arriba. Si se giran, el calor queda atrapado y las resistencias de 1.200W al rojo vivo (600°C–800°C) entran en contacto directo con las migas y la grasa derretida del queso y la mantequilla, provocando un fuego de grasa incontrolable que sale disparado al saltar el resorte."
      },
      {
        question: "¿Por qué no se debe hacer palomitas de maíz en la freidora de aire?",
        answer: "El ventilador de alta velocidad absorbe las palomitas conforme van explotando y las lanza hacia arriba contra la resistencia eléctrica descubierta, donde el almidón seco arde inmediatamente y bloquea el motor."
      }
    ],
    breadcrumbs: [
      { label: "Inicio", href: "/es/" },
      { label: "Herramientas", href: "/es/tools/" },
      { label: "Desmitificador de Mitos Virales" }
    ]
  },
  pt: {
    pageTitle: "Desmistificador de Mitos Culinários e Hacks do TikTok | IsItKitchenSafe",
    pageDescription: "Investigações científicas de laboratório desmistificando truques virais perigosos do TikTok e YouTube. Entenda a termodinâmica real, choques térmicos e risco de incêndio com ovos no micro-ondas e salmão na lava-louças.",
    badge: "Física de Laboratório • Prevenção de Incêndios • Avaliação Científica",
    h1: "Desmistificador de Truques e Mitos Culinários das Redes",
    heroSub: "Não deixe vídeos curtos de 15 segundos colocarem fogo na sua casa ou causarem queimaduras graves. Testamos os truques mais virais usando física real, dinâmica dos fluidos e microbiologia alimentar.",
    scienceTitle: "A Física Real por Trás dos Perigos em Truques das Redes Sociais",
    scienceIntro: "Aparelhos domésticos operam sob limites estritos de segurança. Ao quebrar essas regras de engenharia, os acidentes se tornam inevitáveis:",
    sciencePillars: [
      {
        num: "01",
        title: "Água Superaquecida e Vasos de Pressão Naturais",
        desc: "Em alimentos com membranas impermeáveis (ovos com casca, uvas inteiras), as micro-ondas aquecem a água a mais de 100°C sem ferver devido à pressão hidrostática. Um simples toque com garfo ou dente causa detonação instantânea de vapor escaldante."
      },
      {
        num: "02",
        title: "Arrasto Aerodinâmico em Fritadeiras sem Óleo",
        desc: "As air fryers movem ar ciclônico a mais de 70 km/h. Itens leves (milho estourado, papel alumínio solto) são sugados para cima direto na resistência exposta a 500°C, causando chamas imediatas e curto-circuito."
      },
      {
        num: "03",
        title: "Choque Térmico em Refratários de Vidro",
        desc: "O vidro comum resiste a variações térmicas de no máximo 55°C. Colocar uma travessa a 200°C na água gelada provoca contração superficial violenta, estilhaçando o vidro em milhares de cacos afiados como lâminas."
      }
    ],
    faqs: [
      {
        question: "Por que ovos inteiros explodem com tanta força no micro-ondas?",
        answer: "A casca e a membrana formam uma câmara de pressão selada. A água da gema ultrapassa 100°C em estado superaquecido. Ao furar o ovo com garfo ou mastigar, a pressão cai bruscamente e a água vira vapor expandindo 1.600 vezes, causando queimaduras graves no rosto e lesões na córnea."
      },
      {
        question: "Cozinhar salmão na lava-louças é realmente perigoso?",
        answer: "Sim, por risco de bactérias e contaminação química. A água da máquina raramente atinge os 63°C contínuos necessários para esterilizar Salmonella e Listeria. Além disso, o papel alumínio não veda completamente e os secantes e detergentes penetram no peixe."
      },
      {
        question: "Por que deitar a torradeira de lado é um risco grave de incêndio?",
        answer: "A torradeira foi feita para uso estritamente vertical. Deitada, o calor fica preso e o queijo derretido escorre diretamente sobre os fios de nicromo a mais de 700°C, incendiando a gordura e arremessando o pão em chamas pela cozinha ao disparar a mola."
      },
      {
        question: "Por que não se deve estourar pipoca na air fryer?",
        answer: "A corrente de ar ciclônica puxa as pipocas estouradas para cima, jogando-as na resistência elétrica exposta, onde o amido queima na hora e trava o motor do ventilador."
      }
    ],
    breadcrumbs: [
      { label: "Início", href: "/pt/" },
      { label: "Ferramentas", href: "/pt/tools/" },
      { label: "Desmistificador de Mitos Virais" }
    ]
  },
  'zh-cn': {
    pageTitle: "网络爆款厨房恶作剧与TikTok伪科普辟谣中心 | IsItKitchenSafe",
    pageDescription: "基于严谨热力学与食品微生物学，全面拆解短视频中高风险厨房恶作剧。深入剖析微波炉热整蛋炸裂、洗碗机煮三文鱼致病菌残留、横置烤面包机起火等危险隐患。",
    badge: "实验室严谨实证 • 消防火灾预警 • 权威标准背书",
    h1: "网络爆款厨房妙招科学辟谣与事实核查中心",
    heroSub: "不要让短视频算法推荐的15秒高赞恶作剧损坏您的厨房电器甚至造成急诊人身伤害。我们从热力学相变、流体力学与病原微生物学角度，深度复现并科学辟谣各类高危恶作剧。",
    scienceTitle: "高危厨房网络妙招背后的物理与化学隐患",
    scienceIntro: "家用厨房电器的设计均有严格的热力学与电气安全边界。强行破坏这些安全底线，物理定律必将引发严重灾难：",
    sciencePillars: [
      {
        num: "01",
        title: "过热水态相变与天然密闭压力容器",
        desc: "在具有完整生物膜的食物（如带壳鸡蛋、葡萄）中，微波迅速激发水分至100°C以上，但在静水压抑制下无法沸腾形成过热水。一旦叉子戳刺或牙齿咬合，瞬间发生剧烈相变闪蒸，体积瞬间膨胀1600倍引发爆燃。"
      },
      {
        num: "02",
        title: "旋风气流动力卷吸与明火隐患",
        desc: "空气炸锅本质是超高速热风风洞（风速达20m/s）。低质量物体（爆米花、散乱锡纸、干香料）极易被气流卷吸至顶部500°C裸露加热管，瞬间起火并损坏风机马达。"
      },
      {
        num: "03",
        title: "膨胀系数失配引发的热冲击碎裂",
        desc: "普通钠钙钢化玻璃最大温差耐受度仅约50°C至55°C。将200°C的高温烤盘直接置于冷水或冰块中，表层瞬间剧烈收缩产生超过15,000 PSI拉伸应力，导致玻璃如手榴弹般爆碎成无数锋利碎片。"
      }
    ],
    faqs: [
      {
        question: "为什么完整鸡蛋在微波炉中会发生毁灭性爆炸？",
        answer: "蛋壳和卵黄膜构成了高强度密闭容器。微波直接穿透至蛋黄，水分子被加热到105°C–118°C过热状态。用叉子戳破或咬入口中时，局部压力骤降促使过热水瞬间发生剧烈闪蒸沸腾，形成强力冲击波，常导致面部重度烫伤、耳膜受损及角膜撕裂。"
      },
      {
        question: "洗碗机锡纸煮三文鱼真的会有食品安全危害吗？",
        answer: "存在双重严重风险：致病菌感染与洗涤化学毒素渗透。洗碗机水温仅45°C–60°C，无法达到美国农业部规定的63°C杀菌核心温度，极易滋生沙门氏菌与李斯特菌。同时锡纸并非气密密封，洗碗块中的表面活性剂与漂洗光亮剂会直接渗入鱼肉。"
      },
      {
        question: "为什么把烤面包机横放烤奶酪吐司会引发火灾？",
        answer: "弹出式多士炉仅为垂直对流散热设计。横置会导致热量聚积在机身内侧，温控保护失效。融化的油脂、面包屑与奶酪直接滴落在红热的1200瓦电热丝上引发爆燃，弹簧弹起时会将燃烧的面包如同火球般抛出。"
      },
      {
        question: "为什么不能在空气炸锅中直接爆干玉米粒？",
        answer: "爆米花受热炸开后密度骤降，旋风对流风机会立即将其吸附在上方500°C的高温电热管上，干燥的淀粉瞬间着火碳化并导致电机烧毁。"
      }
    ],
    breadcrumbs: [
      { label: "首页", href: "/zh-cn/" },
      { label: "实用工具", href: "/zh-cn/tools/" },
      { label: "网络爆款妙招科学辟谣" }
    ]
  },
  ja: {
    pageTitle: "SNSバイラル調理ハック検証＆TikTokデマ科学解明ハブ | IsItKitchenSafe",
    pageDescription: "TikTokやYouTubeで拡散される危険な調理裏ワザを科学実験と熱力学から徹底検証。電子レンジの生卵爆発、食洗機サーモン調理、トースター横倒しによる火災リスクを解説。",
    badge: "実験室エビデンス • 消防基準準拠 • 査読済み物理検証",
    h1: "SNSバイラル調理ハック検証＆デマ科学解明ハブ",
    heroSub: "15秒のショート動画を鵜呑みにして家電を破壊したり、大火傷で救急搬送される事故が後を絶ちません。熱力学、流体力学、食品微生物学に基づき、話題の裏ワザを科学的に解明します。",
    scienceTitle: "危険なSNS調理ハックに潜む物理・熱力学的真実",
    scienceIntro: "キッチン家電は厳密な安全基準のもとで設計されています。自己流の裏ワザで安全限界を超えた場合、避けられない重大事故につながります：",
    sciencePillars: [
      {
        num: "01",
        title: "過加熱水と天然の密閉圧力容器",
        desc: "殻や膜で密閉された食材（生卵、ブドウなど）は、静水圧により100°Cを超えても沸騰せず「過加熱水」状態を維持します。フォークで刺したり噛みついた瞬間に突沸し、体積が1600倍に膨張して大爆発します。"
      },
      {
        num: "02",
        title: "サイクロン対流による浮力吸引火災",
        desc: "ノンフライヤーは秒速20m以上の強烈な気流を起こします。ポップコーンやアルミホイルなどの軽い物体は風に乗って舞い上がり、上部の500°Cのヒーターに接触して直ちに発火します。"
      },
      {
        num: "03",
        title: "熱膨張差による熱衝撃爆破",
        desc: "一般的な耐熱ソーダガラスの許容温度差（ΔT）はわずか50°C〜55°Cです。200°Cに熱した耐熱皿を氷水につけると急激な収縮応力（15,000 PSI超）が発生し、粉々に破裂します。"
      }
    ],
    faqs: [
      {
        question: "なぜ電子レンジで丸ごとの卵を加熱すると大爆発するのですか？",
        answer: "殻と卵黄膜が密閉容器となるためです。内部の水分が沸騰できないまま105°C〜118°Cまで過加熱され、フォークを刺した瞬間に減圧されて一気に蒸気爆発を起こします。顔面の大火傷や角膜損傷の重大事故が世界中で報告されています。"
      },
      {
        question: "食洗機にアルミホイルで包んだサーモンを入れて調理するのは危険ですか？",
        answer: "食中毒と化学物質汚染の二重のリスクがあります。食洗機の湯温は45°C〜60°Cで変動し、サルモネラ菌等を死滅させる63°Cに達しません。またアルミホイルの隙間から界面活性剤やリンス剤の蒸気が魚肉に浸透します。"
      },
      {
        question: "ポップアップトースターを横倒しにしてチーズトーストを作るのはなぜ火災になるのですか？",
        answer: "トースターは垂直方向の熱対流を前提に作られています。横倒しにすると熱がこもって保護装置が無効化し、溶けたチーズやバターが700°Cの電熱線に直接垂れて激しい油脂火災を引き起こします。"
      },
      {
        question: "ノンフライヤーで乾燥ポップコーンを炒ってはいけない理由は何ですか？",
        answer: "弾けたポップコーンが高速気流によって天井の剥き出しの電熱線へ吸い上げられ、高温のヒーターに触れて発火し、モーターが焼き付いて故障するためです。"
      }
    ],
    breadcrumbs: [
      { label: "ホーム", href: "/ja/" },
      { label: "ツール", href: "/ja/tools/" },
      { label: "バイラル裏ワザ科学検証" }
    ]
  }
};

const curContent = CONTENT[lang] || CONTENT.es;
const pageTitle = curContent.pageTitle;
const pageDescription = curContent.pageDescription;

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": curContent.h1,
  "url": `https://isitkitchensafe.com/${lang}/tools/viral-trend-debunker/`,
  "applicationCategory": "HealthApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "description": pageDescription,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};
---

<Layout title={pageTitle} description={pageDescription} faqs={curContent.faqs} availableLocales={availableLocales}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={curContent.breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1200px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-signature-coral text-white mb-3">
        {curContent.badge}
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        {curContent.h1}
      </h1>
      <p class="text-body text-[15px] md:text-body-md leading-relaxed">
        {curContent.heroSub}
      </p>
    </header>

    <!-- Main Interactive Debunker Tool -->
    <div class="mb-14">
      <ViralTrendDebunker lang={lang} />
    </div>

    <!-- Science Deep-Dive Section -->
    <section class="mb-14 border-t border-hairline pt-12 space-y-8">
      <div class="max-w-3xl">
        <span class="text-xs font-bold uppercase tracking-wider text-muted block mb-1">
          Fluid Dynamics &bull; Thermal Shock &bull; Material Limits
        </span>
        <h2 class="text-title-lg md:text-display-sm font-medium text-ink tracking-tight mb-3">
          {curContent.scienceTitle}
        </h2>
        <p class="text-body text-[15px] leading-relaxed">
          {curContent.scienceIntro}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {curContent.sciencePillars.map((pillar) => (
          <div class="p-6 rounded-2xl bg-surface-soft border border-hairline space-y-3">
            <div class="w-9 h-9 rounded-xl bg-red-600 text-white font-bold flex items-center justify-center text-sm">
              {pillar.num}
            </div>
            <h3 class="font-semibold text-ink text-base">{pillar.title}</h3>
            <p class="text-xs text-body leading-relaxed">
              {pillar.desc}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="border-t border-hairline pt-12">
      <h2 class="text-title-lg md:text-display-sm font-medium text-ink tracking-tight mb-8">
        Frequently Asked Questions
      </h2>
      <div class="space-y-6 max-w-3xl">
        {curContent.faqs.map(faq => (
          <div class="border-b border-hairline pb-6">
            <h3 class="text-base font-semibold text-ink mb-2">
              {faq.question}
            </h3>
            <p class="text-body text-sm leading-relaxed">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>
