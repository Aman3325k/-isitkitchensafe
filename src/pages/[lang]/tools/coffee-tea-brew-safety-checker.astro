---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CoffeeTeaBrewSafetyChecker from '../../../components/CoffeeTeaBrewSafetyChecker.astro';
import rawData from '../../../data/coffee-tea-brew-safety-data.json';
import type { SupportedLanguage } from '../../../i18n/ui';

export function getStaticPaths() {
  const availableLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'zh-cn', 'ja'];
  return [
    { params: { lang: 'es' }, props: { lang: 'es' as SupportedLanguage, availableLocales } },
    { params: { lang: 'pt' }, props: { lang: 'pt' as SupportedLanguage, availableLocales } },
    { params: { lang: 'zh-cn' }, props: { lang: 'zh-cn' as SupportedLanguage, availableLocales } },
    { params: { lang: 'ja' }, props: { lang: 'ja' as SupportedLanguage, availableLocales } }
  ];
}

interface Props {
  lang: SupportedLanguage;
  availableLocales: SupportedLanguage[];
}

const { lang, availableLocales } = Astro.props;

interface LocalePageContent {
  pageTitle: string;
  pageDescription: string;
  badge: string;
  h1: string;
  heroSub: string;
  breadcrumbs: Array<{ label: string; href?: string }>;
}

const CONTENT: Record<Exclude<SupportedLanguage, 'en'>, LocalePageContent> = {
  es: {
    pageTitle: "Verificador de Seguridad de Café, Espresso, Cold Brew, Té y Materiales de Hervidor | IsItKitchenSafe",
    pageDescription: "Verificador interactivo basado en CDC, FDA y SCA: consulta 10 escenarios de almacenamiento de café, cold brew, kombucha y té (té al sol, riesgo de botulismo, regla de 2 horas con leche), compara 7 materiales de hervidores y cafeteras Moka y cambia entre °C y °F.",
    badge: "CDC Té al Sol · FDA Cold Brew · Temperaturas SCA · 10 Bebidas · 7 Materiales",
    h1: "Verificador de Seguridad de Café, Cold Brew, Té y Materiales de Hervidor",
    heroSub: "Evita el té al sol advertido por el CDC, el botulismo en cold brew sellado sin frío y los hervidores plásticos que liberan microplásticos: inspecciona 10 bebidas, compara 7 materiales de hervidores y cafeteras Moka y consulta temperaturas exactas en °C / °F.",
    breadcrumbs: [
      { label: "Inicio", href: "/es/" },
      { label: "Herramientas", href: "/es/tools/" },
      { label: "Seguridad de Café, Cold Brew, Té y Hervidores" }
    ]
  },
  pt: {
    pageTitle: "Verificador de Segurança de Café, Espresso, Cold Brew, Chá e Materiais de Chaleira | IsItKitchenSafe",
    pageDescription: "Verificador interativo baseado em CDC, FDA e SCA: analise 10 cenários de armazenamento de café, cold brew, kombucha e chá (chá ao sol, risco de botulismo, regra das 2h com leite), compare 7 materiais de chaleiras e cafeteiras Moka e alterne °C / °F.",
    badge: "CDC Sun Tea · FDA Cold Brew · Temperaturas SCA · 10 Bebidas · 7 Materiais",
    h1: "Verificador de Segurança de Café, Cold Brew, Chá e Materiais de Chaleira",
    heroSub: "Evite chá ao sol desaconselhado pelo CDC, risco de botulismo em cold brew lacrado fora da geladeira e chaleiras plásticas que soltam microplásticos: consulte 10 bebidas, compare 7 materiais de chaleiras/Moka e veja temperaturas exatas em °C / °F.",
    breadcrumbs: [
      { label: "Início", href: "/pt/" },
      { label: "Ferramentas", href: "/pt/tools/" },
      { label: "Segurança de Café, Cold Brew, Chá e Chaleiras" }
    ]
  },
  'zh-cn': {
    pageTitle: "咖啡、浓缩、冷萃与茶饮安全冲泡、储存及烧水壶材质检查器 | IsItKitchenSafe",
    pageDescription: "基于美国 CDC、FDA 与 SCA 标准的交互式咖啡茶饮安全工具：检查 10 种咖啡、冷萃、康普茶与茶饮的室温及冷藏安全时限（太阳茶警告、常温冷萃肉毒杆菌风险、加奶 2 小时铁律），对比 7 种水壶与铝制摩卡壶材质并支持 °C/°F 冲泡水温切换。",
    badge: "CDC 太阳茶警告 · FDA 冷萃规范 · SCA 水温 · 10 饮品 · 7 器具材质",
    h1: "咖啡、冷萃与茶饮安全冲泡、储存及烧水壶材质检查器",
    heroSub: "远离 CDC 警告的户外太阳茶、常温密封冷萃肉毒杆菌隐患与沸水释放微塑料的塑料水壶——一站核查 10 种咖啡茶饮保质红线、对比 7 类水壶与摩卡壶材质，并切换查阅 8 项 °C / °F 精准冲泡水温。",
    breadcrumbs: [
      { label: "首页", href: "/zh-cn/" },
      { label: "实用工具", href: "/zh-cn/tools/" },
      { label: "咖啡、冷萃、茶饮与水壶安全检查器" }
    ]
  },
  ja: {
    pageTitle: "コーヒー・エスプレッソ・水出し＆お茶の安全抽出・保存・ケトル素材チェッカー | IsItKitchenSafe",
    pageDescription: "CDC・FDA・SCA基準のインタラクティブ安全チェッカー。サンティー警告、常温水出しコーヒーのボツリヌス菌リスク、ミルク入り2時間ルールなど10飲料の保存限界、7種のケトル・アルミ製マキネッタ素材の溶出リスク、8種の°C/°F抽出温度を一括確認。",
    badge: "CDC サンティー警告 · FDA 水出し基準 · SCA 温度 · 10飲料 · 7素材",
    h1: "コーヒー・水出し・お茶の安全抽出・保存＆ケトル素材チェッカー",
    heroSub: "CDC警告の日向サンティー、常温密閉コールドブリューのボツリヌス菌リスク、マイクロプラスチックを放出する樹脂製ケトルを徹底回避。10種の飲料保存基準、7種のケトル・マキネッタ素材、8種の°C / °F抽出温度を即確認できます。",
    breadcrumbs: [
      { label: "ホーム", href: "/ja/" },
      { label: "ツール", href: "/ja/tools/" },
      { label: "コーヒー・水出し・お茶＆ケトル安全チェッカー" }
    ]
  }
};

const c = CONTENT[lang as Exclude<SupportedLanguage, 'en'>] || CONTENT.es;
const faqs = (rawData.faqs as Record<string, Array<{ question: string; answer: string }>>)[lang] || rawData.faqs.en;
const localizedUrl = `https://isitkitchensafe.com/${lang}/tools/coffee-tea-brew-safety-checker/`;

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": c.h1,
  "url": localizedUrl,
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript.",
  "description": c.pageDescription,
  "inLanguage": lang === 'zh-cn' ? 'zh-CN' : lang,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={c.pageTitle}
  description={c.pageDescription}
  faqs={faqs}
  excludeFaqSchema={true}
  availableLocales={availableLocales}
  lang={lang}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1 print:hidden">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={c.breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1140px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-signature-coral text-white mb-3">
        {c.badge}
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        {c.h1}
      </h1>
      <p class="text-body text-[15px] md:text-[16px] leading-relaxed">
        {c.heroSub}
      </p>
    </header>

    <!-- Main Interactive Checker Component -->
    <CoffeeTeaBrewSafetyChecker lang={lang} />
  </div>
</Layout>
