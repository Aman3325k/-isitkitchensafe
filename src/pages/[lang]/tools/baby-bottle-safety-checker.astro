---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import BabyBottleSafetyChecker from '../../../components/BabyBottleSafetyChecker.astro';
import rawData from '../../../data/baby-bottle-safety-data.json';
import type { SupportedLanguage } from '../../../i18n/ui';

export function getStaticPaths() {
  const availableLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'zh-cn', 'ja'];
  return [
    { params: { lang: 'es' }, props: { lang: 'es' as SupportedLanguage, availableLocales } },
    { params: { lang: 'pt' }, props: { lang: 'pt' as SupportedLanguage, availableLocales } },
    { params: { lang: 'zh-cn' }, props: { lang: 'zh-cn' as SupportedLanguage, availableLocales } },
    { params: { lang: 'ja' }, props: { lang: 'ja' as SupportedLanguage, availableLocales } }
  ];
}

interface Props {
  lang: SupportedLanguage;
  availableLocales: SupportedLanguage[];
}

const { lang, availableLocales } = Astro.props;

interface LocalePageContent {
  pageTitle: string;
  pageDescription: string;
  badge: string;
  h1: string;
  heroSub: string;
  breadcrumbs: Array<{ label: string; href?: string }>;
}

const CONTENT: Record<Exclude<SupportedLanguage, 'en'>, LocalePageContent> = {
  es: {
    pageTitle: "Verificador de Seguridad de Biberones, Vasos y Vajilla Infantil (AAP/FDA/CDC) | IsItKitchenSafe",
    pageDescription: "Comprueba si biberones PP, vidrio, PPSU, silicona, melamina, bambú, chupetes y bolsas de leche materna son aptos para microondas, lavavajillas, vapor, UV-C y congelador según normas AAP, FDA y CDC.",
    badge: "Matriz Pediátrica de Seguridad AAP · FDA · CDC",
    h1: "Verificador de Seguridad de Biberones, Vasos y Vajilla Infantil",
    heroSub: "Verifica al instante si 14 materiales infantiles cotidianos —biberones #5 PP, vidrio, silicona y PPSU, platos de melamina o fibra de bambú, vasos térmicos, chupetes de látex y bolsas de leche— son seguros en microondas, lavavajillas, esterilizador a vapor/hervido, UV-C y congelador, con alertas oficiales AAP y CDC para calentar leche materna y fórmula.",
    breadcrumbs: [
      { label: "Inicio", href: "/es/" },
      { label: "Herramientas", href: "/es/tools/" },
      { label: "Seguridad de Biberones y Vajilla Infantil" }
    ]
  },
  pt: {
    pageTitle: "Verificador de Segurança de Mamadeiras, Copos e Louça Infantil (AAP/FDA/CDC) | IsItKitchenSafe",
    pageDescription: "Confira segurança no micro-ondas, lava-louças, vapor, UV-C e freezer para 14 itens infantis: mamadeiras PP, vidro, silicone, PPSU, melamina, bambu, chupetas e sacos de leite materno segundo AAP, FDA e CDC.",
    badge: "Matriz Pediátrica de Segurança AAP · FDA · CDC",
    h1: "Verificador de Segurança de Mamadeiras, Copos e Louça Infantil",
    heroSub: "Consulte na hora a compatibilidade de 14 materiais infantis — mamadeiras #5 PP, vidro, silicone e PPSU, pratos de melamina ou fibra de bambu, copos térmicos, chupetas de látex e sacos de leite — com micro-ondas, lava-louças, esterilizador a vapor/fervura, UV-C e freezer, incluindo alertas AAP e CDC de aquecimento de leite materno e fórmula.",
    breadcrumbs: [
      { label: "Início", href: "/pt/" },
      { label: "Ferramentas", href: "/pt/tools/" },
      { label: "Segurança de Mamadeiras e Louça Infantil" }
    ]
  },
  'zh-cn': {
    pageTitle: "奶瓶、学饮杯与儿童餐具安全查询器 (AAP/FDA/CDC 标准) | IsItKitchenSafe",
    pageDescription: "一键核查 14 类常见母婴奶瓶、辅食餐盘、保温吸管杯、安抚奶嘴与储奶袋（PP/玻璃/PPSU/硅胶/密胺/竹纤维/乳胶）在微波炉、洗碗机、蒸汽水煮、紫外线消毒柜与冷冻室的安全性及 AAP/CDC 暖奶警示。",
    badge: "AAP · FDA · CDC 儿科级育儿安全矩阵",
    h1: "奶瓶、学饮杯与儿童餐具安全查询器",
    heroSub: "一键核对 14 种日常母婴喂养与儿童餐具材质（#5 PP、高硼硅玻璃、硅胶、PPSU 奶瓶，密胺/竹纤维餐盘，不锈钢与双层吸管杯，乳胶/硅胶奶嘴及母乳储奶袋）在微波炉、洗碗机、蒸汽水煮、UV-C 消毒柜与冷冻室的安全等级，并内置 AAP 与 CDC 母乳/配方奶防烫预警。",
    breadcrumbs: [
      { label: "首页", href: "/zh-cn/" },
      { label: "实用工具", href: "/zh-cn/tools/" },
      { label: "奶瓶与儿童餐具安全查询器" }
    ]
  },
  ja: {
    pageTitle: "哺乳瓶・マグ・子ども用食器 安全チェッカー（AAP・FDA・CDC基準） | IsItKitchenSafe",
    pageDescription: "PP・ガラス・PPSU・シリコン哺乳瓶、メラミン・竹繊維プレート、ストローマグ、天然ゴムおしゃぶり、母乳パックの14素材について電子レンジ・食洗機・煮沸/スチーム・UV-C・冷凍の可否をAAP・FDA・CDC基準で即判定。",
    badge: "AAP・FDA・CDC 乳幼児キッチン安全マトリクス",
    h1: "哺乳瓶・マグ・子ども用食器 安全チェッカー",
    heroSub: "日常使いのベビー＆キッズ用品14素材（#5 PP・耐熱ガラス・シリコン・PPSU哺乳瓶、メラミン・バンブーファイバー食器、ステンレス＆二重構造ストローマグ、天然ゴム・シリコンおしゃぶり、母乳フリーザーパック）の電子レンジ・食洗機・スチーム/煮沸・UV-C除菌・冷凍の可否を瞬時に判定。AAP・CDCの母乳・粉ミルク加温警告も搭載しています。",
    breadcrumbs: [
      { label: "ホーム", href: "/ja/" },
      { label: "ツール", href: "/ja/tools/" },
      { label: "哺乳瓶・子ども用食器 安全チェッカー" }
    ]
  }
};

const c = CONTENT[lang as Exclude<SupportedLanguage, 'en'>] || CONTENT.es;
const faqs = (rawData.faqs as Record<string, Array<{ question: string; answer: string }>>)[lang] || rawData.faqs.en;
const localizedUrl = `https://isitkitchensafe.com/${lang}/tools/baby-bottle-safety-checker/`;

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": c.h1,
  "url": localizedUrl,
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript.",
  "description": c.pageDescription,
  "inLanguage": lang === 'zh-cn' ? 'zh-CN' : lang,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={c.pageTitle}
  description={c.pageDescription}
  faqs={faqs}
  excludeFaqSchema={true}
  availableLocales={availableLocales}
  lang={lang}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1 print:hidden">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={c.breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1140px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-signature-coral text-white mb-3">
        {c.badge}
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        {c.h1}
      </h1>
      <p class="text-body text-[15px] md:text-[16px] leading-relaxed">
        {c.heroSub}
      </p>
    </header>

    <!-- Main Interactive Checker, Related Links & 5 Visible FAQs -->
    <BabyBottleSafetyChecker lang={lang} />
  </div>
</Layout>
