---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import KitchenFireEmergencyGuide from '../../../components/KitchenFireEmergencyGuide.astro';
import rawData from '../../../data/kitchen-fire-emergency-guide-data.json';
import type { SupportedLanguage } from '../../../i18n/ui';

export function getStaticPaths() {
  const availableLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'zh-cn', 'ja'];
  return [
    { params: { lang: 'es' }, props: { lang: 'es' as SupportedLanguage, availableLocales } },
    { params: { lang: 'pt' }, props: { lang: 'pt' as SupportedLanguage, availableLocales } },
    { params: { lang: 'zh-cn' }, props: { lang: 'zh-cn' as SupportedLanguage, availableLocales } },
    { params: { lang: 'ja' }, props: { lang: 'ja' as SupportedLanguage, availableLocales } }
  ];
}

interface Props {
  lang: SupportedLanguage;
  availableLocales: SupportedLanguage[];
}

const { lang, availableLocales } = Astro.props;

interface LocalePageContent {
  pageTitle: string;
  pageDescription: string;
  badge: string;
  h1: string;
  heroSub: string;
  breadcrumbs: Array<{ label: string; href?: string }>;
}

const CONTENT: Record<Exclude<SupportedLanguage, 'en'>, LocalePageContent> = {
  es: {
    pageTitle: "Guía de Emergencia: Fuego de Aceite, Eléctrico, Gas y Quemaduras | IsItKitchenSafe",
    pageDescription: "Guía interactiva NFPA, USFA/FEMA y Cruz Roja Americana de primera respuesta en cocina: qué hacer y qué NUNCA hacer ante fuego de aceite en sartén, horno, microondas, incendio eléctrico, fuga de gas y quemaduras — más comparador de extintores ABC, Clase K y manta ignífuga.",
    badge: "Protocolos NFPA y USFA · Primeros Auxilios Cruz Roja · Comparador de 6 Extintores",
    h1: "Guía de Emergencia: Fuego de Aceite, Eléctrico y Quemaduras en Cocina",
    heroSub: "Domina la respuesta exacta QUÉ HACER vs. NUNCA HACER antes de una emergencia: fuego de grasa en sartén, incendios en horno o microondas, fuego eléctrico, fuga de gas, primeros auxilios en quemaduras por aceite y qué extintor es seguro o mortal.",
    breadcrumbs: [
      { label: "Inicio", href: "/es/" },
      { label: "Herramientas", href: "/es/tools/" },
      { label: "Emergencia de Fuego y Quemaduras" }
    ]
  },
  pt: {
    pageTitle: "Guia de Emergência: Fogo de Óleo, Elétrico, Gás e Queimaduras | IsItKitchenSafe",
    pageDescription: "Guia interativo NFPA, USFA/FEMA e Cruz Vermelha Americana para emergências na cozinha: O QUE FAZER vs. NUNCA FAZER em fogo de óleo na frigideira, forno, micro-ondas, incêndio elétrico, vazamento de gás e queimaduras — com comparador de extintores ABC, Classe K e manta antichamas.",
    badge: "Protocolos NFPA e USFA · Primeiros Socorros Cruz Vermelha · Comparador de 6 Ferramentas",
    h1: "Guia de Emergência: Fogo de Óleo, Elétrico e Queimaduras na Cozinha",
    heroSub: "Saiba exatamente O QUE FAZER vs. NUNCA FAZER antes que aconteça uma emergência: incêndio de óleo na panela, forno e micro-ondas, fogo elétrico, vazamento de gás, primeiros socorros em queimaduras e qual extintor é seguro ou mortal.",
    breadcrumbs: [
      { label: "Início", href: "/pt/" },
      { label: "Ferramentas", href: "/pt/tools/" },
      { label: "Emergência de Fogo e Queimaduras" }
    ]
  },
  'zh-cn': {
    pageTitle: "厨房油锅起火、电气火灾、燃气泄漏与烫伤急救指南 | IsItKitchenSafe",
    pageDescription: "严格依据 NFPA、USFA/FEMA 与美国红十字会标准的交互式厨房应急指南：6 大突发险情（油锅起火、烤箱/微波炉着火、电器火灾、燃气泄漏、热油烫伤）立即处置与致命禁区，内置 6 种家用灭火器匹配器与可打印冰箱安全海报。",
    badge: "NFPA & USFA 防火标准 · 美国红十字会急救 · 6 种家用灭火工具匹配器",
    h1: "厨房油锅起火、电气火灾与烫伤急救应急指南",
    heroSub: "在险情发生前掌握准确的“立即这么做 vs 绝对不能做”行动规范——全面涵盖灶台油锅火、烤箱与微波炉火、电器火灾、燃气泄漏、热油烫伤急救，以及 ABC、K 类、B/C 灭火器与灭火毯的安全禁用评级。",
    breadcrumbs: [
      { label: "首页", href: "/zh-cn/" },
      { label: "实用工具", href: "/zh-cn/tools/" },
      { label: "厨房起火与烫伤急救指南" }
    ]
  },
  ja: {
    pageTitle: "キッチン油火災・電気火災・ガス漏れ・やけど緊急応急ガイド | IsItKitchenSafe",
    pageDescription: "NFPA・USFA/FEMA・米国赤十字基準に基づくキッチン緊急応急ガイド：天ぷら油火災、オーブン・電子レンジ発火、電気火災、ガス漏れ、やけど応急処置の「今すぐすべきこと vs 絶対NG」と、ABC・クラスK・消火布など6種の消火具適合マッチャー＆印刷用冷蔵庫ポスター。",
    badge: "NFPA・USFA防火基準 · 米国赤十字やけど応急手当 · 消火具6種マッチャー",
    h1: "キッチン油火災・電気火災・やけど緊急応急ガイド",
    heroSub: "いざという時の前に「今すぐすべきこと vs 絶対NG」を正確に確認。フライパン油火災、オーブン・電子レンジ発火、家電電気火災、ガス漏れ、熱油やけど応急処置、そして各消火器・消火布の安全／致命的NG判定を1ページで網羅します。",
    breadcrumbs: [
      { label: "ホーム", href: "/ja/" },
      { label: "ツール", href: "/ja/tools/" },
      { label: "キッチン火災・やけど緊急ガイド" }
    ]
  }
};

const c = CONTENT[lang as Exclude<SupportedLanguage, 'en'>] || CONTENT.es;
const faqs = (rawData.faqs as Record<string, Array<{ question: string; answer: string }>>)[lang] || rawData.faqs.en;
const localizedUrl = `https://isitkitchensafe.com/${lang}/tools/kitchen-fire-emergency-guide/`;

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": c.h1,
  "url": localizedUrl,
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript.",
  "description": c.pageDescription,
  "inLanguage": lang === 'zh-cn' ? 'zh-CN' : lang,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={c.pageTitle}
  description={c.pageDescription}
  faqs={faqs}
  excludeFaqSchema={true}
  availableLocales={availableLocales}
  lang={lang}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1 print:hidden">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={c.breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1140px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-signature-coral text-white mb-3">
        {c.badge}
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        {c.h1}
      </h1>
      <p class="text-body text-[15px] md:text-[16px] leading-relaxed">
        {c.heroSub}
      </p>
    </header>

    <!-- Main Interactive Emergency Guide Component -->
    <KitchenFireEmergencyGuide lang={lang} />
  </div>
</Layout>
