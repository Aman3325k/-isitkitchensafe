---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CastIronSeasoningTroubleshooter from '../../../components/CastIronSeasoningTroubleshooter.astro';
import rawData from '../../../data/cast-iron-seasoning-troubleshooter-data.json';
import type { SupportedLanguage } from '../../../i18n/ui';

export function getStaticPaths() {
  const availableLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'zh-cn', 'ja'];
  return [
    { params: { lang: 'es' }, props: { lang: 'es' as SupportedLanguage, availableLocales } },
    { params: { lang: 'pt' }, props: { lang: 'pt' as SupportedLanguage, availableLocales } },
    { params: { lang: 'zh-cn' }, props: { lang: 'zh-cn' as SupportedLanguage, availableLocales } },
    { params: { lang: 'ja' }, props: { lang: 'ja' as SupportedLanguage, availableLocales } }
  ];
}

interface Props {
  lang: SupportedLanguage;
  availableLocales: SupportedLanguage[];
}

const { lang, availableLocales } = Astro.props;

interface LocalePageContent {
  pageTitle: string;
  pageDescription: string;
  badge: string;
  h1: string;
  heroSub: string;
  breadcrumbs: Array<{ label: string; href?: string }>;
}

const CONTENT: Record<Exclude<SupportedLanguage, 'en'>, LocalePageContent> = {
  es: {
    pageTitle: "Solucionador de Curado y Óxido de Hierro Fundido y Acero al Carbono | IsItKitchenSafe",
    pageDescription: "Diagnostica sartenes pegajosas, óxido por lavavajillas, curado descascarado, residuo negro, manchas por tomate, huevos pegados o grietas. Incluye temperaturas exactas de horno para 6 aceites y alerta para hierro esmaltado.",
    badge: "Hierro Fundido · Acero al Carbono · Alerta Esmaltado",
    h1: "Solucionador de Curado y Óxido para Hierro Fundido y Acero al Carbono",
    heroSub: "Resuelve al instante superficies pegajosas, óxido naranja del lavavajillas, escamas de aceite de linaza, residuo negro al limpiar, zonas grises por tomate o grietas peligrosas — con calculadora exacta de temperatura de horno (°C/°F) para 6 aceites y guía especial para hierro esmaltado (Le Creuset, Staub).",
    breadcrumbs: [
      { label: "Inicio", href: "/es/" },
      { label: "Herramientas", href: "/es/tools/" },
      { label: "Solucionador de Hierro Fundido y Acero al Carbono" }
    ]
  },
  pt: {
    pageTitle: "Solucionador de Cura e Ferrugem de Ferro Fundido e Aço Carbono | IsItKitchenSafe",
    pageDescription: "Diagnostique panela grudenta, ferrugem de lava-louças, cura descamando, resíduo preto, manchas ácidas, comida grudando ou trincas. Inclui temperaturas exatas de forno para 6 óleos e alerta para ferro esmaltado.",
    badge: "Ferro Fundido · Aço Carbono · Alerta Esmaltado",
    h1: "Solucionador de Cura e Ferrugem para Ferro Fundido e Aço Carbono",
    heroSub: "Recupere rapidamente superfícies pegajosas, ferrugem alaranjada da lava-louças, lascas de óleo de linhaça, resíduo preto no papel, manchas cinzas de molho de tomate ou fundos empenados — com calculadora exata de temperatura de forno (°C/°F) para 6 óleos e alerta integrado para ferro esmaltado (Le Creuset, Staub).",
    breadcrumbs: [
      { label: "Início", href: "/pt/" },
      { label: "Ferramentas", href: "/pt/tools/" },
      { label: "Solucionador de Ferro Fundido e Aço Carbono" }
    ]
  },
  'zh-cn': {
    pageTitle: "铸铁锅与碳钢锅开锅养护及除锈诊断工具 | IsItKitchenSafe",
    pageDescription: "一键诊断铸铁锅/熟铁锅发黏、误进洗碗机生锈、亚麻籽油掉黑皮、擦出黑灰、煮番茄露铁、煎蛋粘锅与锅底开裂。内置 6 种食用油烤箱精准聚合温度计算器及 Le Creuset/Staub 珐琅锅防误操作警示。",
    badge: "无涂层铸铁 · 碳钢熟铁 · 珐琅锅避雷警示",
    h1: "铸铁锅与碳钢锅开锅养护及除锈诊断工具",
    heroSub: "几分钟搞定锅面发黏、洗碗机橘色浮锈、掉黑皮起壳、纸巾擦出黑灰、煮番茄发灰露铁、煎蛋粘锅及锅底鼓包裂纹——内置 6 种开锅油精准烤箱聚合温度（°C / °F 自由切换）与 Le Creuset、Staub 珐琅铸铁锅专项清洁警告。",
    breadcrumbs: [
      { label: "首页", href: "/zh-cn/" },
      { label: "实用工具", href: "/zh-cn/tools/" },
      { label: "铸铁锅与碳钢锅诊断工具" }
    ]
  },
  ja: {
    pageTitle: "キャストアイアン＆鉄フライパン シーズニング・サビ診断ツール | IsItKitchenSafe",
    pageDescription: "鋳鉄スキレットや鉄フライパンのベタつき、食洗機後の赤サビ、亜麻仁油の剥がれ、黒い汚れ、トマト調理後の変色、くっつき、ひび割れを即診断。6種オイルの最適オーブン温度計算機とホーロー鍋警告付き。",
    badge: "無塗装鋳鉄・カーボンスチール・ホーロー警告",
    h1: "キャストアイアン＆カーボンスチール シーズニング・サビ診断ツール",
    heroSub: "ベタつく表面・食洗機の赤サビ・被膜の剥がれ・拭くと付く黒い汚れ・酸性食材による灰色変色・卵のくっつき・底の反りや亀裂を即座に診断。6種類の食用油の正確なオーブン重合温度（°C / °F切替）とル・クルーゼ／ストウブ等のホーロー鍋専用警告を搭載しています。",
    breadcrumbs: [
      { label: "ホーム", href: "/ja/" },
      { label: "ツール", href: "/ja/tools/" },
      { label: "キャストアイアン＆鉄鍋 診断ツール" }
    ]
  }
};

const c = CONTENT[lang as Exclude<SupportedLanguage, 'en'>] || CONTENT.es;
const faqs = (rawData.faqs as Record<string, Array<{ question: string; answer: string }>>)[lang] || rawData.faqs.en;
const localizedUrl = `https://isitkitchensafe.com/${lang}/tools/cast-iron-seasoning-troubleshooter/`;

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": c.h1,
  "url": localizedUrl,
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript.",
  "description": c.pageDescription,
  "inLanguage": lang === 'zh-cn' ? 'zh-CN' : lang,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={c.pageTitle}
  description={c.pageDescription}
  faqs={faqs}
  excludeFaqSchema={true}
  availableLocales={availableLocales}
  lang={lang}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1 print:hidden">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={c.breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1140px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-signature-coral text-white mb-3">
        {c.badge}
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        {c.h1}
      </h1>
      <p class="text-body text-[15px] md:text-[16px] leading-relaxed">
        {c.heroSub}
      </p>
    </header>

    <!-- Main Interactive Troubleshooter, Oil Calculator, Related Links & 5 Visible FAQs -->
    <CastIronSeasoningTroubleshooter lang={lang} />
  </div>
</Layout>
