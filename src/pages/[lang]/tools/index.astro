const hubUi = SPOTLIGHT_HUB_UI[lang as keyof typeof SPOTLIGHT_HUB_UI] || SPOTLIGHT_HUB_UI.es;
---

<Layout title={c.pageTitle} description={c.pageDescription} faqs={c.faqs} availableLocales={availableLocales} lang={lang}>
  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={c.breadcrumbs} className="mb-0" />
    </div>
  </div>

  <section class="max-w-[1280px] mx-auto px-6 py-10 md:py-16">
    <!-- Header -->
    <header class="max-w-3xl mb-10">
      <span class="text-caption text-muted uppercase tracking-wider text-xs block mb-2">
        {c.badge}
      </span>
      <h1 class="text-display-lg md:text-display-xl font-medium text-ink tracking-tight mb-4">
        {c.h1}
      </h1>
      <p class="text-body-md text-muted text-base md:text-lg leading-relaxed">
        {c.heroSub}
      </p>
    </header>

    <!-- Featured Consumer Spotlight Section -->
    <div
      aria-labelledby="featured-consumer-tools-heading"
      class="mb-14 rounded-3xl bg-gradient-to-br from-surface-soft via-canvas to-surface-soft border border-hairline p-6 md:p-8 shadow-xs"
    >
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-6">
        <div>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-signature-coral text-white mb-3">
            {hubUi.eyebrow}
          </span>
          <h2 id="featured-consumer-tools-heading" class="text-title-lg md:text-2xl font-semibold text-ink tracking-tight mb-1.5">
            {hubUi.heading}
          </h2>
          <p class="text-sm text-muted max-w-2xl leading-relaxed">
            {hubUi.subtitle}
          </p>
        </div>
        <a
          href="#tools-directory-section"
          class="text-xs font-semibold text-ink hover:text-signature-coral transition-colors whitespace-nowrap underline underline-offset-4"
        >
          {hubUi.browseAllLink} &darr;
        </a>
      </div>

      <!-- Top 26 New Launch Hero Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-5">
        {hubUi.heroTools.map((tool) => (
          <div class="bg-canvas border-2 border-hairline hover:border-ink/40 rounded-2xl p-6 flex flex-col justify-between shadow-xs hover:shadow-md transition-all">
            <div>
              <div class="flex flex-wrap items-center gap-2 mb-3">
                <span class="inline-block px-2.5 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wider bg-amber-400 text-ink">
                  {hubUi.newBadge}
                </span>
                <span class={`inline-block px-2.5 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wider ${tool.badgeClass}`}>
                  {tool.badge}
                </span>
              </div>
              <h3 class="text-lg font-semibold text-ink tracking-tight mb-2 leading-snug">
                {tool.title}
              </h3>
              <p class="text-sm text-body leading-relaxed mb-5">
                {tool.desc}
              </p>
            </div>
            <a
              href={tp(`/tools/${tool.slug}/`)}
              class={`w-full py-2.5 px-4 rounded-xl text-center font-medium text-sm transition-colors shadow-xs ${tool.ctaClass}`}
            >
              {tool.cta} &rarr;
            </a>
          </div>
        ))}
      </div>

      <!-- 8 Essential Consumer Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {hubUi.essentialTools.map((tool) => (
          <div class="bg-canvas border border-hairline hover:border-ink/35 rounded-2xl p-5 flex flex-col justify-between shadow-xs hover:shadow-md transition-all">
            <div>
              <span class={`inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider mb-3 ${tool.badgeClass}`}>
                {tool.badge}
              </span>
              <h3 class="text-[15px] font-semibold text-ink tracking-tight mb-1.5 leading-snug">
                {tool.title}
              </h3>
              <p class="text-xs text-body leading-relaxed mb-4">
                {tool.desc}
              </p>
            </div>
            <a
              href={tp(`/tools/${tool.slug}/`)}
              class={`w-full py-2 px-3 rounded-lg text-center font-medium text-xs transition-colors ${tool.ctaClass}`}
            >
              {tool.cta} &rarr;
            </a>
          </div>
        ))}
      </div>
    </div>

    <!-- Search & Audience Filter Bar -->
    <div id="tools-directory-section" class="scroll-mt-8 mb-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 mb-4">
        <div>
          <span class="text-xs font-semibold uppercase tracking-wider text-muted block mb-1">
            {hubUi.directoryEyebrow}
          </span>
          <h2 class="text-title-lg font-semibold text-ink tracking-tight">
            {hubUi.directoryHeading}
          </h2>
        </div>
      </div>

      <div
        id="tools-filter-bar"
        data-count-template={hubUi.countTemplate}
        class="bg-surface-soft border border-hairline rounded-2xl p-4 md:p-5 shadow-xs"
      >
        <div class="flex flex-col lg:flex-row lg:items-center gap-3">
          <div class="relative flex-1">
            <svg
              aria-hidden="true"
              class="w-4 h-4 text-muted absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m0 0A7.5 7.5 0 104.5 4.5a7.5 7.5 0 0012.15 12.15z" />
            </svg>
            <input
              id="tools-hub-search"
              type="search"
              autocomplete="off"
              placeholder={hubUi.searchPlaceholder}
              aria-label={hubUi.searchAriaLabel}
              class="w-full pl-10 pr-10 py-2.5 rounded-xl bg-canvas border border-hairline text-sm text-ink placeholder:text-muted focus:outline-none focus:ring-2 focus:ring-ink/20 focus:border-ink transition-colors"
            />
            <button
              id="tools-hub-clear"
