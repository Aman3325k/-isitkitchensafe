  <script is:inline>
    (function () {
      function initToolsHubFilter() {
        var grid = document.getElementById('tools-directory-grid');
        var searchInput = document.getElementById('tools-hub-search');
        var filterBar = document.getElementById('tools-filter-bar');
        var matchCountEl = document.getElementById('tools-match-count');
        var clearBtn = document.getElementById('tools-hub-clear');
        var resetInlineBtn = document.getElementById('tools-hub-reset-inline');
        var emptyState = document.getElementById('tools-empty-state');
        var emptyResetBtn = document.getElementById('tools-empty-reset');
        if (!grid || !searchInput || !filterBar || grid.dataset.filterInitialized === 'true') return;
        grid.dataset.filterInitialized = 'true';

        var countTemplate = filterBar.getAttribute('data-count-template') || 'Showing {visible} of {total} tools';
        var commercialPattern = /^(commercial|comercial|商用|業務用|modelador continuo|modelador contínuo|simulador continuo|simulador contínuo|industrial)/i;

        var cards = Array.prototype.slice.call(grid.querySelectorAll(':scope > article'));
        var records = cards.map(function (card) {
          var h2 = (card.querySelector('h2') && card.querySelector('h2').textContent || '').trim();
          var spans = Array.prototype.slice.call(card.querySelectorAll('span')).map(function (s) { return (s.textContent || '').trim(); });
          var firstBadge = spans[0] || '';
          var desc = (card.querySelector('p') && card.querySelector('p').textContent || '').trim();
          var link = card.querySelector('a[href]');
          var href = link ? (link.getAttribute('href') || '').toLowerCase() : '';
          var isCommercial =
            href.indexOf('/commercial-') !== -1 ||
            commercialPattern.test(h2) ||
            commercialPattern.test(firstBadge);

          return {
            el: card,
            isCommercial: isCommercial,
            searchText: (h2 + ' ' + spans.join(' ') + ' ' + desc + ' ' + href).toLowerCase()
          };
        });

        var totalCount = records.length;
        var commercialCount = records.filter(function (r) { return r.isCommercial; }).length;
        var homeCount = totalCount - commercialCount;

        var countMap = { all: totalCount, home: homeCount, commercial: commercialCount };
        Object.keys(countMap).forEach(function (key) {
          var el = filterBar.querySelector('[data-filter-count="' + key + '"]');
          if (el) el.textContent = String(countMap[key]);
        });

        var activeAudience = 'all';
        var filterButtons = Array.prototype.slice.call(filterBar.querySelectorAll('.tools-filter-btn'));

        function updateButtonStyles() {
          filterButtons.forEach(function (btn) {
            var isActive = btn.getAttribute('data-audience-filter') === activeAudience;
            btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
            if (isActive) {
              btn.classList.add('bg-ink', 'text-white', 'border-ink', 'shadow-xs');
              btn.classList.remove('bg-canvas', 'text-ink', 'border-hairline', 'hover:bg-surface-strong/60');
            } else {
              btn.classList.remove('bg-ink', 'text-white', 'border-ink', 'shadow-xs');
              btn.classList.add('bg-canvas', 'text-ink', 'border-hairline', 'hover:bg-surface-strong/60');
            }
          });
        }

        function applyFilters() {
          var rawQuery = (searchInput.value || '').trim().toLowerCase();
          var tokens = rawQuery ? rawQuery.split(/\s+/).filter(Boolean) : [];
          var visibleCount = 0;

          for (var i = 0; i < records.length; i++) {
            var rec = records[i];
            var audienceMatch =
              activeAudience === 'all' ||
              (activeAudience === 'home' && !rec.isCommercial) ||
              (activeAudience === 'commercial' && rec.isCommercial);

            var queryMatch = true;
            if (tokens.length > 0) {
              for (var j = 0; j < tokens.length; j++) {
                if (rec.searchText.indexOf(tokens[j]) === -1) {
                  queryMatch = false;
                  break;
                }
              }
            }

            var show = audienceMatch && queryMatch;
            rec.el.classList.toggle('hidden', !show);
            if (show) visibleCount++;
          }

          if (matchCountEl) {
            matchCountEl.textContent = countTemplate
              .replace('{visible}', String(visibleCount))
              .replace('{total}', String(totalCount));
          }
          if (clearBtn) {
            clearBtn.classList.toggle('hidden', rawQuery.length === 0);
          }
          if (resetInlineBtn) {
            resetInlineBtn.classList.toggle('hidden', rawQuery.length === 0 && activeAudience === 'all');
          }
          if (emptyState) {
            emptyState.classList.toggle('hidden', visibleCount > 0);
          }
        }

        function resetAll() {
          searchInput.value = '';
          activeAudience = 'all';
          updateButtonStyles();
          applyFilters();
          searchInput.focus();
        }

        filterButtons.forEach(function (btn) {
          btn.addEventListener('click', function () {
            activeAudience = btn.getAttribute('data-audience-filter') || 'all';
            updateButtonStyles();
            applyFilters();
          });
        });

        searchInput.addEventListener('input', applyFilters);
        if (clearBtn) {
          clearBtn.addEventListener('click', function () {
            searchInput.value = '';
            applyFilters();
            searchInput.focus();
          });
        }
        if (resetInlineBtn) resetInlineBtn.addEventListener('click', resetAll);
        if (emptyResetBtn) emptyResetBtn.addEventListener('click', resetAll);

        updateButtonStyles();
        applyFilters();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initToolsHubFilter);
      } else {
        initToolsHubFilter();
      }
      document.addEventListener('astro:page-load', initToolsHubFilter);
    })();
  </script>
