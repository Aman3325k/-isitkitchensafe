---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import type { SupportedLanguage } from '../../../i18n/ui';
import { useTranslations, useTranslatedPath } from '../../../i18n/utils';

export function getStaticPaths() {
  const availableLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'zh-cn', 'ja'];
  return [
    { params: { lang: 'es' }, props: { lang: 'es' as SupportedLanguage, availableLocales } },
    { params: { lang: 'pt' }, props: { lang: 'pt' as SupportedLanguage, availableLocales } },
    { params: { lang: 'zh-cn' }, props: { lang: 'zh-cn' as SupportedLanguage, availableLocales } },
    { params: { lang: 'ja' }, props: { lang: 'ja' as SupportedLanguage, availableLocales } }
  ];
}

interface Props {
  lang: SupportedLanguage;
  availableLocales: SupportedLanguage[];
}

const { lang, availableLocales } = Astro.props;
const t = useTranslations(lang);
const tp = useTranslatedPath(lang);

interface ToolsHubContent {
  pageTitle: string;
  pageDescription: string;
  badge: string;
  h1: string;
  heroSub: string;
  tool1Badge: string;
  tool1Sub: string;
  tool1Title: string;
  tool1Desc: string;
  tool1TechLabel: string;
  tool1TechVal: string;
  tool1SciLabel: string;
  tool1SciVal: string;
  tool1Btn: string;
  tool2Badge: string;
  tool2Sub: string;
  tool2Title: string;
  tool2Desc: string;
  tool2ScopeLabel: string;
  tool2ScopeVal: string;
  tool2AlertLabel: string;
  tool2AlertVal: string;
  tool2Btn: string;
  guidesTitle: string;
  guide1Title: string;
  guide1Desc: string;
  guide2Title: string;
