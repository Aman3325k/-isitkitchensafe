const c = CONTENT[lang];
---

<Layout title={c.pageTitle} description={c.pageDescription} faqs={c.faqs} availableLocales={availableLocales} lang={lang}>
  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={c.breadcrumbs} className="mb-0" />
    </div>
  </div>

  <section class="max-w-[1280px] mx-auto px-6 py-10 md:py-16">
    <!-- Header -->
    <header class="max-w-3xl mb-12">
      <span class="text-caption text-muted uppercase tracking-wider text-xs block mb-2">
        {c.badge}
      </span>
      <h1 class="text-display-lg md:text-display-xl font-medium text-ink tracking-tight mb-4">
        {c.h1}
      </h1>
      <p class="text-body-md text-muted text-base md:text-lg leading-relaxed">
        {c.heroSub}
      </p>
    </header>

    <!-- Tools Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
      <!-- Tool 1: Pan Scratch Inspector -->
      <article class="bg-surface-soft border border-hairline rounded-2xl p-8 flex flex-col justify-between shadow-xs hover:shadow-md transition-all">
        <div>
          <div class="flex items-center justify-between gap-2 mb-4">
            <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-signature-coral text-white">
              {c.tool1Badge}
            </span>
            <span class="text-xs text-muted font-mono">{c.tool1Sub}</span>
          </div>
          <h2 class="text-title-lg md:text-title-xl font-medium text-ink tracking-tight mb-3">
            {c.tool1Title}
          </h2>
          <p class="text-body text-sm leading-relaxed mb-6">
            {c.tool1Desc}
          </p>

          <div class="space-y-2 text-xs mb-6 border-y border-hairline/60 py-3">
            <div class="flex items-center justify-between">
              <span class="text-muted">{c.tool1TechLabel}</span>
              <span class="font-medium text-ink">{c.tool1TechVal}</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-muted">{c.tool1SciLabel}</span>
              <span class="font-medium text-ink">{c.tool1SciVal}</span>
            </div>
          </div>
        </div>

        <a 
          href={`/${lang}/tools/pan-scratch-inspector/`}
          class="w-full py-3 px-4 rounded-xl bg-ink hover:bg-black text-white text-center font-medium text-sm transition-colors shadow-xs"
        >
          <Fragment set:html={c.tool1Btn} />
        </a>
      </article>

      <!-- Tool 2: Cookware Brand Transparency Index -->
      <article class="bg-surface-soft border border-hairline rounded-2xl p-8 flex flex-col justify-between shadow-xs hover:shadow-md transition-all">
        <div>
          <div class="flex items-center justify-between gap-2 mb-4">
            <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-700 text-white">
              {c.tool2Badge}
            </span>
            <span class="text-xs text-muted font-mono">{c.tool2Sub}</span>
          </div>
          <h2 class="text-title-lg md:text-title-xl font-medium text-ink tracking-tight mb-3">
            {c.tool2Title}
          </h2>
          <p class="text-body text-sm leading-relaxed mb-6">
            {c.tool2Desc}
          </p>

          <div class="space-y-2 text-xs mb-6 border-y border-hairline/60 py-3">
            <div class="flex items-center justify-between">
              <span class="text-muted">{c.tool2ScopeLabel}</span>
              <span class="font-medium text-ink">{c.tool2ScopeVal}</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-muted">{c.tool2AlertLabel}</span>
              <span class="font-medium text-ink">{c.tool2AlertVal}</span>
            </div>
          </div>
        </div>

        <a 
          href={`/${lang}/tools/cookware-brand-transparency-index/`}
          class="w-full py-3 px-4 rounded-xl bg-emerald-700 hover:bg-emerald-800 text-white text-center font-medium text-sm transition-colors shadow-xs"
        >
          <Fragment set:html={c.tool2Btn} />
        </a>
      </article>
    </div>

    <!-- Companion Reference Guides Section -->
    <div class="bg-canvas border border-hairline rounded-2xl p-8">
      <h3 class="text-title-md font-medium text-ink mb-4">
        {c.guidesTitle}
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        <a href={`/${lang}/material/scratched-nonstick-cookware/`} class="p-4 rounded-xl bg-surface-soft hover:bg-surface-strong border border-hairline transition-colors">
          <span class="text-[11px] font-bold uppercase tracking-wider text-signature-coral block mb-1">Deep-Dive</span>
          <h4 class="font-semibold text-ink text-sm mb-1">{c.guide1Title}</h4>
          <p class="text-xs text-body">{c.guide1Desc}</p>
        </a>
        <a href={`/${lang}/material/metal/`} class="p-4 rounded-xl bg-surface-soft hover:bg-surface-strong border border-hairline transition-colors">
          <span class="text-[11px] font-bold uppercase tracking-wider text-muted block mb-1">Material</span>
          <h4 class="font-semibold text-ink text-sm mb-1">{c.guide2Title}</h4>
          <p class="text-xs text-body">{c.guide2Desc}</p>
        </a>
        <a href={`/${lang}/compare/ceramic-vs-glass-bakeware/`} class="p-4 rounded-xl bg-surface-soft hover:bg-surface-strong border border-hairline transition-colors">
          <span class="text-[11px] font-bold uppercase tracking-wider text-muted block mb-1">Comparison</span>
          <h4 class="font-semibold text-ink text-sm mb-1">{c.guide3Title}</h4>
          <p class="text-xs text-body">{c.guide3Desc}</p>
        </a>
      </div>
    </div>
  </section>
</Layout>
