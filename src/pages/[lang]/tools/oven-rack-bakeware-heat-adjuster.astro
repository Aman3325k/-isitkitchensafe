---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import OvenRackBakewareHeatAdjuster from '../../../components/OvenRackBakewareHeatAdjuster.astro';
import rawData from '../../../data/oven-rack-bakeware-heat-data.json';
import type { SupportedLanguage } from '../../../i18n/ui';

export function getStaticPaths() {
  const availableLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'zh-cn', 'ja'];
  return [
    { params: { lang: 'es' }, props: { lang: 'es' as SupportedLanguage, availableLocales } },
    { params: { lang: 'pt' }, props: { lang: 'pt' as SupportedLanguage, availableLocales } },
    { params: { lang: 'zh-cn' }, props: { lang: 'zh-cn' as SupportedLanguage, availableLocales } },
    { params: { lang: 'ja' }, props: { lang: 'ja' as SupportedLanguage, availableLocales } }
  ];
}

interface Props {
  lang: SupportedLanguage;
  availableLocales: SupportedLanguage[];
}

const { lang, availableLocales } = Astro.props;

interface LocalePageContent {
  pageTitle: string;
  pageDescription: string;
  badge: string;
  h1: string;
  heroSub: string;
  breadcrumbs: Array<{ label: string; href?: string }>;
}

const CONTENT: Record<Exclude<SupportedLanguage, 'en'>, LocalePageContent> = {
  es: {
    pageTitle: "Ajustador de Rejilla del Horno, Convección y Material del Molde | IsItKitchenSafe",
    pageDescription: "Calcula ajustes exactos de temperatura y tiempo del horno para moldes de vidrio Pyrex, antiadherente oscuro, cerámica, silicona, hierro fundido y aluminio brillante, con esquema interactivo de 5 rejillas, convección inteligente y alertas de choque térmico y broiler.",
    badge: "Esquema de 5 Rejillas · 6 Materiales de Molde · Seguridad Convección y Grill",
    h1: "Ajustador de Rejilla del Horno, Convección y Material del Molde",
    heroSub: "Calcula al instante la reducción de -15 °C (-25 °F) para vidrio y moldes oscuros, el límite inteligente del modo Convección, la rejilla ideal para 10 platos populares y alertas en vivo de choque térmico y grill/broiler antes de precalentar.",
    breadcrumbs: [
      { label: "Inicio", href: "/es/" },
      { label: "Herramientas", href: "/es/tools/" },
      { label: "Rejilla de Horno y Moldes" }
    ]
  },
  pt: {
    pageTitle: "Ajustador de Grade do Forno, Convecção e Material da Assadeira | IsItKitchenSafe",
    pageDescription: "Calcule ajustes exatos de temperatura e tempo de forno para assadeiras de vidro Pyrex, antiaderente escuro, cerâmica, silicone, ferro fundido e alumínio brilhante — com esquema interativo de 5 grades, modo convecção inteligente e alertas de choque térmico e broiler.",
    badge: "Esquema de 5 Grades · 6 Materiais de Assadeira · Segurança Convecção e Grill",
    h1: "Ajustador de Grade do Forno, Convecção e Material da Assadeira",
    heroSub: "Calcule na hora o ajuste de -15 °C (-25 °F) para vidro e formas escuras, o limite inteligente da Convecção, a grade ideal para 10 receitas clássicas e alertas ao vivo contra choque térmico e risco no grill/broiler.",
    breadcrumbs: [
      { label: "Início", href: "/pt/" },
      { label: "Ferramentas", href: "/pt/tools/" },
      { label: "Grade do Forno e Assadeiras" }
    ]
  },
  'zh-cn': {
    pageTitle: "烤箱层位、热风对流与烤盘材质温度调节器 | IsItKitchenSafe",
    pageDescription: "一键计算 Pyrex 耐热玻璃、深色不粘烤盘、陶瓷炻瓷、硅胶模具、铸铁与光亮铝烤盘的精准调温与时间方案，内置 5 层烤箱内腔示意图、热风防过度降温算法与炙烤/热冲击安全警报。",
    badge: "5 层烤箱内腔示意图 · 6 种烤盘材质 · 热风对流与炙烤安全警报",
    h1: "烤箱层位、热风对流与烤盘材质温度调节器",
    heroSub: "预热前即刻算清玻璃与深色不粘烤盘的 -15°C（-25°F）降温法则、热风对流智能防叠加封顶、10 道热门料理的理想烤架层位，以及 Pyrex 玻璃热冲击与炙烤爆裂实时预警。",
    breadcrumbs: [
      { label: "首页", href: "/zh-cn/" },
      { label: "实用工具", href: "/zh-cn/tools/" },
      { label: "烤箱层位与烤盘调温器" }
    ]
  },
  ja: {
    pageTitle: "オーブン段位置・コンベクション・焼き型材質 温度アジャスター | IsItKitchenSafe",
    pageDescription: "耐熱ガラス（Pyrex）・濃色ノンスティック・陶器ストーンウェア・シリコン・鋳鉄・光沢アルミ型ごとの正確なオーブン温度＆焼き時間調整を即計算。5段庫内模式図、コンベクション自動補正、グリル破裂・熱衝撃アラート搭載。",
    badge: "5段オーブン模式図 · 6種の焼き型材質 · コンベクション＆グリル安全判定",
    h1: "オーブン段位置・コンベクション・焼き型材質 温度アジャスター",
    heroSub: "ガラスや濃色型の-15℃（-25°F）調整、コンベクション併用時の過度な温度低下防止、定番料理10種の最適なオーブン段位置、Pyrex熱衝撃＆グリル破裂警告を予熱前に瞬時チェックできます。",
    breadcrumbs: [
      { label: "ホーム", href: "/ja/" },
      { label: "ツール", href: "/ja/tools/" },
      { label: "オーブン段位置・焼き型調整" }
    ]
  }
};

const c = CONTENT[lang as Exclude<SupportedLanguage, 'en'>] || CONTENT.es;
const faqs = (rawData.faqs as Record<string, Array<{ question: string; answer: string }>>)[lang] || rawData.faqs.en;
const localizedUrl = `https://isitkitchensafe.com/${lang}/tools/oven-rack-bakeware-heat-adjuster/`;

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": c.h1,
  "url": localizedUrl,
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript.",
  "description": c.pageDescription,
  "inLanguage": lang === 'zh-cn' ? 'zh-CN' : lang,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={c.pageTitle}
  description={c.pageDescription}
  faqs={faqs}
  excludeFaqSchema={true}
  availableLocales={availableLocales}
  lang={lang}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1 print:hidden">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={c.breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1140px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-signature-coral text-white mb-3">
        {c.badge}
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        {c.h1}
      </h1>
      <p class="text-body text-[15px] md:text-[16px] leading-relaxed">
        {c.heroSub}
      </p>
    </header>

    <!-- Main Interactive Adjuster Component -->
    <OvenRackBakewareHeatAdjuster lang={lang} />
  </div>
</Layout>
