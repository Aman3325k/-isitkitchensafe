---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CommercialContinuousOswDorModeler from '../../../components/CommercialContinuousOswDorModeler.astro';
import type { SupportedLanguage } from '../../../i18n/ui';
import { useTranslations, useTranslatedPath } from '../../../i18n/utils';

export function getStaticPaths() {
  const availableLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'zh-cn', 'ja'];
  return [
    { params: { lang: 'es' }, props: { lang: 'es' as SupportedLanguage, availableLocales } },
    { params: { lang: 'pt' }, props: { lang: 'pt' as SupportedLanguage, availableLocales } },
    { params: { lang: 'zh-cn' }, props: { lang: 'zh-cn' as SupportedLanguage, availableLocales } },
    { params: { lang: 'ja' }, props: { lang: 'ja' as SupportedLanguage, availableLocales } }
  ];
}

interface Props {
  lang: SupportedLanguage;
  availableLocales: SupportedLanguage[];
}

const { lang, availableLocales } = Astro.props;
const t = useTranslations(lang);
const tp = useTranslatedPath(lang);

interface LocaleToolContent {
  pageTitle: string;
  pageDescription: string;
  badge: string;
  h1: string;
  lead: string;
  breadcrumbsLabel: string;
  faqs: Array<{ question: string; answer: string }>;
}

const CONTENT: Record<Exclude<SupportedLanguage, 'en'>, LocaleToolContent> = {
  es: {
    pageTitle: "Simulador Continuo de Desemulsificación por Ondas Estacionarias Acústicas Ortogonales (OSW-DOR) | IsItKitchenSafe",
    pageDescription: "Simule la desemulsificación continua por ondas acústicas estacionarias ortogonales de doble frecuencia (1,2 y 2,4 MHz) y la coalescencia de gotas de aceite prensado en frío sin surfactantes químicos ni oxidación térmica bajo normas FDA 21 CFR § 117 y USDA Orgánico.",
    badge: "Hito 166 • Herramienta Diagnóstica Insignia",
    h1: "Simulador Continuo de Desemulsificación por Ondas Estacionarias Acústicas Ortogonales y Recuperación de Aceite (OSW-DOR)",
    lead: "Simule la desemulsificación continua por ondas estacionarias megasónicas ortogonales (1,2 y 2,4 MHz • P_a = 15–85 W/cm²) integrada con decantación laminar de Stokes. Coaleszca microgotas dispersas de aceites vírgenes prensados en frío (oliva, aguacate, coco, microalgas) hasta d_final > 40 µm con >99,2% de rendimiento, >99,4% de retención de polifenoles y cero aditivos químicos bajo FDA 21 CFR § 117 y USDA Orgánico.",
    breadcrumbsLabel: "Simulador Continuo OSW-DOR",
    faqs: [
      {
        question: "¿Cómo rompe el sistema acústico ortogonal OSW-DOR emulsiones rebeldes sin desemulsionantes químicos?",
        answer: "La separación industrial convencional recurre a calentadores de malaxado térmico (>45°C), centrífugas de discos de alta aceleración o desemulsionantes sintéticos (polialquilen glicoles y coagulantes ácidos). Estos métodos oxidan los polifenoles termolábiles, alteran el aroma o dejan residuos químicos prohibidos en aceites orgánicos. El sistema OSW-DOR emplea física acustoforética pura: cuando la emulsión fluye a través de una cámara resonante, las ondas estacionarias ejercen fuerzas de radiación acústica primaria de Gor'kov sobre las gotas de aceite. Como los lípidos vegetales poseen menor densidad (ρ ≈ 915 kg/m³) y mayor compresibilidad acústica que el agua de vegetación, su factor de contraste acústico Φ es fuertemente positivo (+0,26 a +0,29). Esto empuja las microgotas hacia los nodos de velocidad de presión acústica, donde la atracción secundaria de Bjerknes rompe las capas protectoras de pectinas y proteínas, induciendo una coalescencia espontánea de d0 < 2,5 µm a d > 40 µm en menos de 20 segundos."
      },
      {
        question: "¿Por qué las frecuencias duales ortogonales (1,2 y 2,4 MHz) superan al ultrasonido de frecuencia única?",
        answer: "En un resonador unidimensional de frecuencia única, las gotas migran a planos nodales estacionarios y quedan atrapadas en láminas bidimensionales estáticas sin fuerzas transversales que estimulen el choque interparticular. El sistema OSW-DOR utiliza dos arreglos de transductores PZT-8 orientados a 90 grados operando a 1,2 MHz y 2,4 MHz. La interferencia de las ondas ortogonales crea una cuadrícula tridimensional dinámica que elimina el estancamiento planar, induce oscilaciones multidireccionales e incrementa las colisiones de Bjerknes en más de un 300% sin generar cavitación violenta perjudicial."
      },
      {
        question: "¿Cómo acelera la coalescencia acústica la velocidad de decantación por flotación de Stokes?",
        answer: "En emulsiones no tratadas, las gotas tienen diámetros microscópicos (1,5–3,0 µm), con una velocidad de flotación por gravedad despreciable (~0,004 mm/s). Según la ley de Stokes, la velocidad de separación asciende proporcionalmente al cuadrado del radio: v_sep = [2 r² (ρ_agua - ρ_aceite) g] / (9 η). Al agrandar acústicamente las gotas de 2,4 µm a 42,5 µm en la cámara OSW-DOR, la velocidad de flotación se multiplica por más de 313 veces (alcanzando 1,65 mm/s), permitiendo que el aceite flote espontáneamente a la superficie en el canal de decantación laminar en segundos."
      },
      {
        question: "¿Cómo preserva la separación acústica no térmica los polifenoles y evita la formación de peróxidos?",
        answer: "Las centrífugas de discos convencionales generan calor por fricción (aumentando la temperatura 6–12°C) e inyectan aire atmosférico por vórtice, oxidando los fenoles bioactivos (oleocantal, hidroxitirosol, luteína). En cambio, el skid continuo OSW-DOR opera a temperatura ambiente fría (18–24°C) sin rotores mecánicos de alta velocidad, preservando más del 99,4% de los polifenoles nativos y manteniendo el índice de peróxidos por debajo de 0,5 meq O2/kg."
      },
      {
        question: "¿Qué normas sanitarias y regulatorias certifican el sistema comercial OSW-DOR?",
