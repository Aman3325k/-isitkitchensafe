    box2Text: "温度差を42°C以下に保つことで、表面微小クラックの進展を抑え粉砕事故を完全に防ぎます。",
    scienceTitle2: "耐食性金属工学と負圧防滴衛生設計 (FDA / OSHA)",
    scienceText2: "高温多湿環境下でのHCl酸性ミストと過酢酸残留物に対し、316Lステンレスと負圧換気が義務付けられます。",
    box3Title: "耐孔食指数 PREN (316L vs 304)",
    box3Text: "PREN = %Cr + 3.3%Mo + 16%N により、モリブデン添加が塩酸凝縮水による金属貫通を防ぐことが立証されます。",
    box4Title: "負圧ドラフトと防滴ヒーター (FDA 21 CFR § 117)",
    box4Text: "蒸気発生量比135%の排気量と15度勾配の加熱天板が、工場天井のカビ発生とキャップへの汚染水滴下を防ぎます。",
  }
};

const c = CONTENT[lang as Exclude<SupportedLanguage, 'en'>];

const breadcrumbs = [
  { label: t('nav.home'), href: tp('/') },
  { label: t('nav.tools') || 'Tools', href: tp('/tools/') },
  { label: c.breadcrumbsLabel }
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": c.pageTitle,
      "url": `https://isitkitchensafe.com${tp('/tools/commercial-steam-tunnel-condensate-modeler/')}`,
      "applicationCategory": "EngineeringApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5 Canvas/CSS3.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": c.pageDescription
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": t('nav.home'),
          "item": `https://isitkitchensafe.com${tp('/')}`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": t('nav.tools') || 'Tools',
          "item": `https://isitkitchensafe.com${tp('/tools/')}`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": c.breadcrumbsLabel,
          "item": `https://isitkitchensafe.com${tp('/tools/commercial-steam-tunnel-condensate-modeler/')}`
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": c.faqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
};
---

<Layout title={c.pageTitle} description={c.pageDescription} structuredData={structuredData}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
    <Breadcrumbs items={breadcrumbs} />

    <header class="mb-8 mt-4">
      <div class="flex items-center gap-2 mb-3">
        <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-sky-700 text-white">
          {c.badge}
        </span>
        <span class="text-xs text-muted font-mono">ASTM C149 &bull; ANSI/PMMI B155.1 &bull; FDA 21 CFR § 117 &bull; OSHA 1910.94</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-ink tracking-tight">
        {c.h1}
      </h1>
      <p class="text-body text-base sm:text-lg leading-relaxed mt-3 max-w-4xl">
        {c.lead}
      </p>
    </header>

    <!-- Interactive Diagnostic Modeler Component -->
    <CommercialSteamTunnelModeler lang={lang} />

    <!-- Scientific & Engineering Guide -->
    <article class="prose prose-slate max-w-none mt-12 pt-8 border-t border-hairline text-body text-sm leading-relaxed space-y-6">
      <h2 class="text-xl sm:text-2xl font-bold text-ink tracking-tight">
        {c.scienceTitle1}
      </h2>
      <p>
        {c.scienceText1}
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 not-prose my-6">
        <div class="p-4 rounded-xl bg-surface-card border border-hairline">
          <span class="inline-block px-2.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-sky-100 text-sky-800 mb-2">
            ASTM C149
          </span>
          <h4 class="text-xs font-bold text-ink mb-1">{c.box1Title}</h4>
          <p class="text-xs text-muted leading-relaxed">
            {c.box1Text}
          </p>
        </div>

        <div class="p-4 rounded-xl bg-surface-card border border-hairline">
          <span class="inline-block px-2.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800 mb-2">
            ΔT ≤ 42°C
          </span>
          <h4 class="text-xs font-bold text-ink mb-1">{c.box2Title}</h4>
          <p class="text-xs text-muted leading-relaxed">
            {c.box2Text}
          </p>
        </div>
      </div>

      <h2 class="text-xl sm:text-2xl font-bold text-ink tracking-tight">
        {c.scienceTitle2}
      </h2>
      <p>
        {c.scienceText2}
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 not-prose my-6">
        <div class="p-4 rounded-xl bg-surface-card border border-hairline">
          <span class="inline-block px-2.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-purple-100 text-purple-800 mb-2">
            PREN ≥ 24.5
          </span>
          <h4 class="text-xs font-bold text-ink mb-1">{c.box3Title}</h4>
          <p class="text-xs text-muted leading-relaxed">
            {c.box3Text}
          </p>
        </div>

        <div class="p-4 rounded-xl bg-surface-card border border-hairline">
          <span class="inline-block px-2.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-amber-100 text-amber-800 mb-2">
            PMMI / OSHA
          </span>
          <h4 class="text-xs font-bold text-ink mb-1">{c.box4Title}</h4>
          <p class="text-xs text-muted leading-relaxed">
            {c.box4Text}
          </p>
        </div>
      </div>

      <!-- FAQ Section -->
      <div class="not-prose mt-12 pt-8 border-t border-hairline">
        <h3 class="text-xl font-bold text-ink tracking-tight mb-6">
          {lang === 'es' ? 'Preguntas Frecuentes: Túneles de Vapor y Calidad de Envasado' :
           lang === 'pt' ? 'Perguntas Frequentes: Engenharia de Túneis de Vapor e Embalagem' :
           lang === 'zh-cn' ? '常见问题解答：蒸汽收缩套标隧道与包装安全工程' :
           'よくある質問：スチームトンネル熱流体力学と包装品質管理'}
        </h3>
        <div class="space-y-4">
          {c.faqs.map(faq => (
            <details class="group p-5 rounded-2xl bg-surface-soft border border-hairline transition-all">
              <summary class="font-bold text-ink text-sm sm:text-base cursor-pointer list-none flex items-center justify-between gap-4">
                <span>{faq.question}</span>
                <span class="text-muted group-open:rotate-180 transition-transform text-xs">▼</span>
              </summary>
              <p class="text-muted text-xs sm:text-sm leading-relaxed mt-3 pt-3 border-t border-hairline">
                {faq.answer}
              </p>
            </details>
          ))}
        </div>
      </div>
    </article>
  </div>
</Layout>
