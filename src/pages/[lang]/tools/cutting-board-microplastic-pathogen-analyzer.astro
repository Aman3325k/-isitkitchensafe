---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CuttingBoardSafetyModeler from '../../../components/CuttingBoardSafetyModeler.astro';
import type { SupportedLanguage } from '../../../i18n/ui';
import { useTranslations, useTranslatedPath } from '../../../i18n/utils';

export function getStaticPaths() {
  const availableLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'zh-cn', 'ja'];
  return [
    { params: { lang: 'es' }, props: { lang: 'es' as SupportedLanguage, availableLocales } },
    { params: { lang: 'pt' }, props: { lang: 'pt' as SupportedLanguage, availableLocales } },
    { params: { lang: 'zh-cn' }, props: { lang: 'zh-cn' as SupportedLanguage, availableLocales } },
    { params: { lang: 'ja' }, props: { lang: 'ja' as SupportedLanguage, availableLocales } }
  ];
}

interface Props {
  lang: SupportedLanguage;
  availableLocales: SupportedLanguage[];
}

const { lang, availableLocales } = Astro.props;
const t = useTranslations(lang);
const tp = useTranslatedPath(lang);

interface LocaleContent {
  pageTitle: string;
  pageDescription: string;
  breadcrumbs: Array<{ label: string; href?: string }>;
  faqs: Array<{ question: string; answer: string }>;
  monoBadge: string;
  monoTitle: string;
  monoSub: string;
  monoSection1Title: string;
  monoSection1Body: string;
  monoSection2Title: string;
  monoSection2Body: string;
  monoSection3Title: string;
  monoSection3Body: string;
}

const CONTENT: Record<SupportedLanguage, LocaleContent> = {
  en: {} as any,
  es: {
    pageTitle: "Analizador de Microplásticos y Biopelículas en Tablas de Cortar | IsItKitchenSafe",
    pageDescription: "Modele el desgaste de polímeros por cuchillos, ingesta anual de microplásticos (ACS 2023) y riesgos de contaminación cruzada por Salmonella y Campylobacter.",
    breadcrumbs: [
      { label: 'Inicio', href: '/es/' },
      { label: 'Herramientas', href: '/es/tools/' },
      { label: 'Analizador de Tablas de Cortar y Microplásticos' }
    ],
    monoBadge: "Microbiología y Tribología de Polímeros",
    monoTitle: "Analizador de Microplásticos y Biopelículas en Tablas de Cortar",
    monoSub: "Simule la liberación de microplásticos por abrasión de cuchillo, refugio bacteriano en microhendiduras y prevención de intoxicaciones alimentarias.",
    monoSection1Title: "1. Tribología del Corte: Cómo los Cuchillos Desprenden Millones de Microplásticos",
    monoSection1Body: "Un estudio histórico de la American Chemical Society (ACS ES&T 2023) reveló que cortar sobre tablas de polipropileno (PP) o polietileno (PEAD) libera entre 14 y 71 millones de partículas de microplásticos por persona al año, lo que equivale a ingerir entre 1,5 y 10 tarjetas de crédito plásticas anuales.",
    monoSection2Title: "2. La Trampa de las Microhendiduras y el Fracaso del Estropajo",
    monoSection2Body: "Las cerdas de un estropajo miden unos 250 µm de grosor, mientras que los cortes de cuchillo en la tabla miden de 20 a 80 µm de ancho y hasta 850 µm de profundidad. Las bacterias patógenas (Salmonella, Campylobacter, E. coli) se refugian en el fondo bajo una matriz de biopelícula que el lavado manual no puede remover.",
    monoSection3Title: "3. La Paradoja de la Madera: Desecación Capilar vs Refugio Sintético",
    monoSection3Body: "Investigaciones de la Universidad de California Davis demostraron que las tablas de madera maciza (como el arce) son más higiénicas que las de plástico gastadas. Los vasos capilares de la madera absorben la humedad hacia el interior, desecando y destruyendo el 99,9% de las bacterias en 3 a 10 minutos sin necesidad de químicos.",
    faqs: [
      {
        question: "¿Cuántos microplásticos desprenden las tablas de plástico al año?",
        answer: "Según el estudio publicado en ACS ES&T (Yadav et al. 2023), una persona ingiere entre 14 y 71 millones de partículas de microplásticos al año procedentes de tablas de cortar de polipropileno y polietileno, lo que equivale a una masa de 7,4 a 50,7 gramos anuales (entre 1,5 y 10 tarjetas de crédito completas)."
      },
      {
        question: "¿Por qué lavar la tabla de plástico con estropajo no elimina las bacterias?",
        answer: "Las cerdas del estropajo son demasiado anchas (~250 µm) para penetrar en las finas grietas creadas por los cuchillos (20–80 µm). Las bacterias forman biopelículas en el fondo de las ranuras que quedan intactas tras el lavado manual y contaminan el estropajo."
      },
      {
        question: "¿Son realmente las tablas de madera más higiénicas que las de plástico?",
        answer: "Sí. Estudios microbiológicos de la Universidad de California Davis (Dr. Cliver) demostraron que la madera dura absorbe rápidamente la humedad superficial por capilaridad, privando a las bacterias de agua y destruyendo el 99,9% de Salmonella y E. coli en minutos."
      },
      {
        question: "¿Por qué los cuchillos de sierra son tan perjudiciales en tablas de plástico?",
        answer: "Los dientes de sierra actúan como sierras mecánicas, desgarrando las fibras del polímero y multiplicando el desprendimiento de microplásticos entre un 300% y un 340% respecto a un filo liso de chef."
      },
      {
        question: "¿Cuál es el código de colores profesional (HACCP) para tablas de cortar?",
        answer: "Rojo para carne roja cruda, Amarillo para pollo y aves crudas, Azul para pescados y mariscos, Verde para frutas, ensaladas y verduras crudas, Marrón para carnes cocinadas, y Blanco para panadería y lácteos."
      },
      {
        question: "¿Cuándo se debe tirar definitivamente una tabla de cortar de plástico?",
        answer: "Debe desecharse cuando las ranuras sean lo bastante profundas como para enganchar una uña (>300 µm), cuando presenten manchas grises o negras persistentes tras el lavado, o cuando la tabla se curve y cojee sobre la encimera."
      }
    ]
  },
  pt: {
    pageTitle: "Analisador de Microplásticos e Biofilmes em Tábuas de Corte | IsItKitchenSafe",
