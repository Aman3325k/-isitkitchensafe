const c = CONTENT[lang as Exclude<SupportedLanguage, 'en'>];

const breadcrumbs = [
  { label: t('nav.home') || 'Home', href: tp('/') },
  { label: t('nav.tools') || 'Tools', href: tp('/tools/') },
  { label: c.breadcrumbsLabel }
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": `https://isitkitchensafe.com${tp('/tools/commercial-continuous-snd-bp-puffing-modeler/')}#webapp`,
      "url": `https://isitkitchensafe.com${tp('/tools/commercial-continuous-snd-bp-puffing-modeler/')}`,
      "name": c.pageTitle.split('|')[0].trim(),
      "applicationCategory": "EngineeringApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5 Canvas/CSS3.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": c.pageDescription
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": t('nav.home') || "Home",
          "item": `https://isitkitchensafe.com${tp('/')}`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": t('nav.tools') || "Tools",
          "item": `https://isitkitchensafe.com${tp('/tools/')}`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": c.breadcrumbsLabel,
          "item": `https://isitkitchensafe.com${tp('/tools/commercial-continuous-snd-bp-puffing-modeler/')}`
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": c.faqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
};
---

<Layout title={c.pageTitle} description={c.pageDescription} availableLocales={availableLocales}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <Breadcrumbs items={breadcrumbs} />

    <CommercialContinuousSndBpModeler lang={lang} />

    <!-- FAQ Section -->
    <section class="mt-12 bg-surface-soft border border-hairline rounded-3xl p-6 sm:p-8 lg:p-10 shadow-xs mb-10">
      <div class="border-b border-hairline pb-4 mb-6">
        <h2 class="text-xl sm:text-2xl font-bold text-ink mb-1">
          {c.h1} - FAQ
        </h2>
        <p class="text-xs text-muted leading-relaxed">
          {c.lead}
        </p>
      </div>

      <div class="space-y-6">
        {c.faqs.map((faq, index) => (
          <div class="border-b border-hairline/60 pb-6 last:border-b-0 last:pb-0">
            <h3 class="text-base sm:text-lg font-bold text-ink mb-2">
              {index + 1}. {faq.question}
            </h3>
            <p class="text-body text-sm sm:text-base leading-relaxed">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Cross-Linking / Back Navigation -->
    <div class="flex flex-wrap items-center justify-between gap-4 py-6 border-t border-hairline text-sm">
      <a 
        href={tp('/tools/')} 
        class="inline-flex items-center gap-2 text-cyan-400 hover:text-cyan-300 font-medium transition-colors"
      >
        &larr; {t('nav.tools') || 'Tools'}
      </a>
      <span class="text-xs text-muted font-mono">
        IsItKitchenSafe Engineering Suite &bull; 146 Tools
      </span>
    </div>
  </div>
</Layout>

<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
