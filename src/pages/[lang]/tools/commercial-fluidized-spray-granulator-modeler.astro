];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": `https://isitkitchensafe.com/${lang}/tools/commercial-fluidized-spray-granulator-modeler/#webapp`,
      "url": `https://isitkitchensafe.com/${lang}/tools/commercial-fluidized-spray-granulator-modeler/`,
      "name": content.pageTitle,
      "applicationCategory": "EngineeringApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5 Canvas/CSS3.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": content.pageDescription
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": t('nav.home'),
          "item": `https://isitkitchensafe.com${tp('/')}`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": t('nav.tools'),
          "item": `https://isitkitchensafe.com${tp('/tools/')}`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": content.breadcrumbsLabel,
          "item": `https://isitkitchensafe.com${tp('/tools/commercial-fluidized-spray-granulator-modeler/')}`
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": content.faqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
};
---

<Layout 
  title={content.pageTitle}
  description={content.pageDescription}
  structuredData={structuredData}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
    <Breadcrumbs items={breadcrumbs} />

    <div class="mt-6">
      <CommercialFluidizedSprayGranulatorModeler lang={lang} />
    </div>

    <!-- Structured FAQ Accordion Section -->
    <section class="mt-12 p-6 md:p-8 rounded-2xl bg-surface border border-hairline shadow-sm space-y-6">
      <div class="border-b border-hairline pb-4">
        <h2 class="text-xl font-bold text-ink tracking-tight">
          {content.h1} - FAQ
        </h2>
        <p class="text-xs text-body mt-1">
          {content.lead}
        </p>
      </div>

      <div class="space-y-4">
        {content.faqs.map((faq, idx) => (
          <details class="group p-4 rounded-xl bg-surface-soft border border-hairline transition-colors open:bg-surface">
            <summary class="font-semibold text-xs md:text-sm text-ink cursor-pointer list-none flex justify-between items-center gap-2">
              <span>{idx + 1}. {faq.question}</span>
              <span class="text-body group-open:rotate-180 transition-transform text-xs">▼</span>
            </summary>
            <div class="text-xs text-body leading-relaxed mt-3 pt-3 border-t border-hairline/60">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
    </section>
  </div>
</Layout>
