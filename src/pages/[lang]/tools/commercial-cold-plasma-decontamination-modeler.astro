      {
        question: "食品の脂質含有率は低温プラズマ処理時の酸敗（TBARS）や異臭発生にどのように影響しますか？",
        answer: "鶏肉の皮、加熱加工肉、木の実など多価不飽和脂肪酸 (PUFA) を多く含む食品では、活性酸素種が二重アリル位炭素から水素を引き抜き、ラジカル連鎖型の脂質自動酸化を開始させます。これにより生成されたヒドロペルオキシドが分解して二次揮発性アルデヒド（主にマロンジアルデヒド MDA やヘキサナール）が生じ、TBARS 値が上昇します。生肉で 1.0 mg MDA/kg、調理済み肉で 1.5 mg MDA/kg を超えると明らかな酸敗臭や油戻り臭が発生します。商業現場では、包装ガスを高窒素組成（85%〜95% N2）に置換することで、殺菌機構を活性窒素種 (RNS) 主体に切り替え、脂質酸化を大幅に抑制します。"
      },
      {
        question: "包装フィルムの絶縁破壊ピンホール穿孔の原因と、高電圧 DBD におけるバリア性維持法は何ですか？",
        answer: "包装内プラズマ処理では、軟包装フィルム自体が誘電体バリアとして機能します。フィルムにかかる局所電界がポリマーの絶縁破壊耐力（例：薄手単層 LDPE の 65 kV/mm に対し二軸延伸 PET は 180 kV/mm）を超えると、微小アーク放電がフィルムを貫通し、10〜50 µm のピンホール穴をあけます。これにより包装の気密性が破壊され、高濃度オゾンが作業環境へ漏洩し（OSHA 0.1 ppm 上限超過）、環境カビによる再汚染を招きます。商業設備では高絶縁破壊強度の多層ラミネートフィルム（PET/LDPE ≥ 75 µm または OPP/EVOH ≥ 100 µm）を採用し、印加電圧を破壊閾値の 85% 以下に制御します。"
      },
      {
        question: "米国 FDA および USDA-FSIS における低温プラズマ食品包装殺菌の規制基準は何ですか？",
        answer: "米国において商業用低温プラズマ設備は、FDA 21 CFR § 170.39（食品接触物質規制閾値）に基づき、プラズマ照射によるポリマー劣化や添加剤の食品移行が許容限界内であることを証明する必要があります。また現場生成オゾンは FDA 21 CFR § 173.368 により GRAS（一般に安全と認められる）食品殺菌剤として承認されています。即食食肉加工品（RTE）に対しては、USDA-FSIS 9 CFR § 430 の殺菌要件に準拠し、リステリア菌に対する検証済み殺菌力（通常 1〜5 log 減少）と確実な密封性検査が義務付けられています。"
      }
    ]
  }
};

const c = CONTENT[lang as Exclude<SupportedLanguage, 'en'>] || CONTENT.es;

const pageTitle = c.pageTitle;
const pageDescription = c.pageDescription;

const breadcrumbs = [
  { label: t('nav.home') || 'Home', href: tp('/') },
  { label: t('nav.tools') || 'Tools', href: tp('/tools/') },
  { label: c.breadcrumbsLabel }
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": `https://isitkitchensafe.com/${lang}/tools/commercial-cold-plasma-decontamination-modeler/#webapp`,
      "url": `https://isitkitchensafe.com/${lang}/tools/commercial-cold-plasma-decontamination-modeler/`,
      "name": c.h1,
      "applicationCategory": "EngineeringApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5 Canvas/CSS3.",
      "inLanguage": lang,
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": pageDescription
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": t('nav.home') || 'Home',
          "item": `https://isitkitchensafe.com${tp('/')}`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": t('nav.tools') || 'Tools',
          "item": `https://isitkitchensafe.com${tp('/tools/')}`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": c.breadcrumbsLabel,
          "item": `https://isitkitchensafe.com${tp('/tools/commercial-cold-plasma-decontamination-modeler/')}`
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": c.faqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  lang={lang}
  availableLocales={availableLocales}
  structuredData={structuredData}
>
  <div class="max-w-6xl mx-auto px-4 py-8">
    <Breadcrumbs items={breadcrumbs} />
    <div class="mt-6">
      <CommercialColdPlasmaModeler lang={lang} />
    </div>

    <!-- Structured FAQ Accordion Section -->
    <div class="mt-12 bg-surface-soft border border-hairline rounded-2xl p-6 sm:p-8 shadow-xs">
      <h2 class="text-title font-semibold text-ink tracking-tight mb-6">
        {lang === 'es' ? 'Preguntas Frecuentes: Seguridad e Ingeniería de Plasma Frío en Envasado' :
         lang === 'pt' ? 'Perguntas Frequentes: Segurança e Engenharia de Plasma Frio em Embalagens' :
         lang === 'zh-cn' ? '常见问题解答: 包装内大气压低温等离子体工程与安全技术' :
         'よくある質問: 包装内大気圧低温プラズマ工学と安全性評価'}
      </h2>
      <div class="space-y-4">
        {c.faqs.map((faq, index) => (
          <details class="group border border-hairline rounded-xl p-4 bg-surface transition-colors open:bg-surface-soft">
            <summary class="font-medium text-ink cursor-pointer list-none flex justify-between items-center text-sm">
              <span>{index + 1}. {faq.question}</span>
              <span class="text-muted group-open:rotate-180 transition-transform ml-2">▼</span>
            </summary>
            <p class="mt-3 text-xs leading-relaxed text-body border-t border-hairline/60 pt-3">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </div>
  </div>
</Layout>
