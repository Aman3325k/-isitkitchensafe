const c = CONTENT[lang as Exclude<SupportedLanguage, 'en'>] || CONTENT.es;

const pageTitle = `${c.pageTitle}`;
const pageDescription = c.pageDescription;

const breadcrumbs = [
  { label: t('nav.home'), href: tp('/') },
  { label: t('nav.tools'), href: tp('/tools/') },
  { label: c.breadcrumbsLabel }
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": `https://isitkitchensafe.com/${lang}/tools/commercial-continuous-hpcd-ee-extrusion-modeler/#webapp`,
      "url": `https://isitkitchensafe.com/${lang}/tools/commercial-continuous-hpcd-ee-extrusion-modeler/`,
      "name": c.pageTitle,
      "applicationCategory": "EngineeringApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5 Canvas/CSS3.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": c.pageDescription
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": t('nav.home'),
          "item": `https://isitkitchensafe.com/${lang === 'en' ? '' : lang + '/'}`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": t('nav.tools'),
          "item": `https://isitkitchensafe.com/${lang}/tools/`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": c.breadcrumbsLabel,
          "item": `https://isitkitchensafe.com/${lang}/tools/commercial-continuous-hpcd-ee-extrusion-modeler/`
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": c.faqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <Breadcrumbs items={breadcrumbs} />

    <CommercialContinuousHpcdEeModeler lang={lang} />

    <!-- FAQ Section -->
    <section class="mt-12 bg-surface-soft border border-hairline rounded-3xl p-6 sm:p-8 lg:p-10 shadow-xs mb-10">
      <div class="border-b border-hairline pb-4 mb-6">
        <h2 class="text-xl sm:text-2xl font-bold text-ink mb-1">
          {c.faqs.length > 0 && (lang === 'es' ? 'Preguntas Frecuentes: Extrusión por Explosión de CO2 a Alta Presión (HPCD-EE)' : lang === 'pt' ? 'Perguntas Frequentes: Extrusão por Explosão de CO2 em Alta Pressão (HPCD-EE)' : lang === 'zh-cn' ? '常见技术问题解答：高压二氧化碳爆破挤压 (HPCD-EE) 组织化工程' : 'よくある質問：高圧超臨界二酸化炭素爆砕押出 (HPCD-EE) 組織化プロセス')}
        </h2>
        <p class="text-xs text-muted leading-relaxed">
          {lang === 'es' ? 'Respuestas técnicas autorizadas para ingenieros de procesos, tecnólogos de alimentos y plantas de extrusión de proteínas alternativas.' : lang === 'pt' ? 'Respostas técnicas confiáveis para engenheiros de alimentos, formuladores de proteínas alternativas e gestores industriais.' : lang === 'zh-cn' ? '针对人造肉研发工程师、食品挤压工艺师及工业安全负责人的权威技术与法规解答。' : 'プラントベース代替肉エンジニア、食品押出加工技術者、高圧安全管理者向けの技術・熱力学解説。'}
        </p>
      </div>

      <div class="space-y-6">
        {c.faqs.map((faq, index) => (
          <div class="border-b border-hairline/60 pb-6 last:border-b-0 last:pb-0">
            <h3 class="text-base sm:text-lg font-bold text-ink mb-2">
              {index + 1}. {faq.question}
            </h3>
            <p class="text-body text-sm sm:text-base leading-relaxed">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Cross-Linking / Back Navigation -->
    <div class="flex flex-wrap items-center justify-between gap-4 py-6 border-t border-hairline text-sm">
      <a 
        href={tp('/tools/')} 
        class="inline-flex items-center gap-2 text-emerald-400 hover:text-emerald-300 font-medium transition-colors"
      >
        &larr; {lang === 'es' ? 'Volver al Directorio de Herramientas' : lang === 'pt' ? 'Voltar ao Diretório de Ferramentas' : lang === 'zh-cn' ? '返回旗舰诊断工具目录' : 'フラッグシップツール一覧に戻る'}
      </a>
      <span class="text-xs text-muted font-mono">
        IsItKitchenSafe Supercritical Food Extrusion Suite &bull; 147 Flagship Tools
      </span>
    </div>
  </div>
</Layout>

<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
