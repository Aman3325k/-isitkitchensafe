---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import DishwasherRinseAidScaleTroubleshooter from '../../../components/DishwasherRinseAidScaleTroubleshooter.astro';
import rawData from '../../../data/dishwasher-rinse-aid-scale-data.json';
import type { SupportedLanguage } from '../../../i18n/ui';

export function getStaticPaths() {
  const availableLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'zh-cn', 'ja'];
  return [
    { params: { lang: 'es' }, props: { lang: 'es' as SupportedLanguage, availableLocales } },
    { params: { lang: 'pt' }, props: { lang: 'pt' as SupportedLanguage, availableLocales } },
    { params: { lang: 'zh-cn' }, props: { lang: 'zh-cn' as SupportedLanguage, availableLocales } },
    { params: { lang: 'ja' }, props: { lang: 'ja' as SupportedLanguage, availableLocales } }
  ];
}

interface Props {
  lang: SupportedLanguage;
  availableLocales: SupportedLanguage[];
}

const { lang, availableLocales } = Astro.props;

interface LocalePageContent {
  pageTitle: string;
  pageDescription: string;
  badge: string;
  h1: string;
  heroSub: string;
  breadcrumbs: Array<{ label: string; href?: string }>;
}

const CONTENT: Record<Exclude<SupportedLanguage, 'en'>, LocalePageContent> = {
  es: {
    pageTitle: "Solucionador de Cal, Abrillantador y Cristalería Opaca en Lavavajillas | IsItKitchenSafe",
    pageDescription: "Diagnostica vasos opacos con la prueba del vinagre de 5 minutos (cal removible vs. corrosión permanente), calibra el dial de abrillantador según la dureza del agua y descalcifica con ácido cítrico seguro.",
    badge: "Norma AHAM DW-1 · Estudio JACI Barrera Intestinal · Dureza USGS · Protocolo Ácido Cítrico",
    h1: "Solucionador de Cal, Abrillantador y Cristalería Opaca en Lavavajillas",
    heroSub: "Descubre por qué tus vasos quedan blanquecinos: realiza la prueba del vinagre de 5 minutos para diferenciar la cal removible de la corrosión permanente (etching), calibra el dial del abrillantador según los grados de dureza y descalcifica con ácido cítrico sin dañar las gomas.",
    breadcrumbs: [
      { label: "Inicio", href: "/es/" },
      { label: "Herramientas", href: "/es/tools/" },
      { label: "Cal y Abrillantador de Lavavajillas" }
    ]
  },
  pt: {
    pageTitle: "Solucionador de Calcário, Secante e Copos Esbranquiçados na Lava-Louças | IsItKitchenSafe",
    pageDescription: "Diagnostique copos opacos com o teste do vinagre de 5 minutos (calcário removível vs. corrosão permanente), calibre o dosador de secante pela dureza da água e descalcifique com ácido cítrico seguro.",
    badge: "Padrão AHAM DW-1 · Estudo JACI Barreira Intestinal · Dureza USGS · Ácido Cítrico",
    h1: "Solucionador de Calcário, Secante e Copos Esbranquiçados na Lava-Louças",
    heroSub: "Elimine a dúvida sobre vidros leitosos: faça o teste do vinagre de 5 minutos para distinguir calcário de água dura da corrosão física irreversível do vidro, ajuste o dial de secante e descalcifique a máquina com segurança.",
    breadcrumbs: [
      { label: "Início", href: "/pt/" },
      { label: "Ferramentas", href: "/pt/tools/" },
      { label: "Calcário e Secante na Lava-Louças" }
    ]
  },
  'zh-cn': {
    pageTitle: "洗碗机漂洗剂、水垢与玻璃发白发雾排查诊断器 | IsItKitchenSafe",
    pageDescription: "通过 5 分钟白醋测试精准区分可逆矿物水垢与永久玻璃腐蚀（Etching），根据进水硬度（GPG/PPM）校准漂洗剂旋钮档位，科学掌握商用与家用表面活性剂肠道安全真相与柠檬酸安全除垢方案。",
    badge: "AHAM DW-1 国际标准 · JACI 肠道屏障研究 · USGS 水质硬度 · 柠檬酸除垢指南",
    h1: "洗碗机漂洗剂、水质水垢与玻璃白雾排查诊断器",
    heroSub: "告别玻璃器皿发白发雾困惑：执行 5 分钟白醋浸泡测试，快速区分可酸洗去除的碳酸钙水垢与由软水过量洗涤块导致的永久性玻璃腐蚀，精准校准漂洗剂档位与柠檬酸安全清洁流程。",
    breadcrumbs: [
      { label: "首页", href: "/zh-cn/" },
      { label: "安全工具", href: "/zh-cn/tools/" },
      { label: "洗碗机水垢与漂洗剂排查器" }
    ]
  },
  ja: {
    pageTitle: "食洗機リンス剤・水垢・グラス白濁エッチング総合診断ツール | IsItKitchenSafe",
    pageDescription: "5分間ビネガーテストでクエン酸で落ちるミネラル水垢と不可逆なガラス浸食（エッチング）を判別。水硬度に応じたリンス剤目盛り調整、界面活性剤の腸管バリア安全性、安全なクエン酸庫内洗浄手順を網羅。",
    badge: "AHAM DW-1 規格 · JACI 腸管バリア論文 · USGS 水硬度 · 安全クエン酸洗浄",
    h1: "食洗機リンス剤・水垢・グラス白濁エッチング総合診断",
    heroSub: "グラスの白い曇りの原因を特定：5分間酢テストで除去可能なカルシウム水垢と軟水・洗剤過多による不可逆なガラス浸食（エッチング）を科学的に診断し、水硬度別のリンス剤・洗剤の適正量を即座に計算。",
    breadcrumbs: [
      { label: "ホーム", href: "/ja/" },
      { label: "安全ツール", href: "/ja/tools/" },
      { label: "食洗機リンス・水垢診断" }
    ]
  }
};

const content = CONTENT[lang as Exclude<SupportedLanguage, 'en'>] || CONTENT.es;

const faqs = (rawData.faqs[lang as 'es' | 'pt' | 'zh-cn' | 'ja'] || rawData.faqs.en);

const canonicalUrl = `https://isitkitchensafe.com/${lang}/tools/dishwasher-rinse-aid-scale-troubleshooter/`;

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": content.h1,
  "url": canonicalUrl,
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript.",
  "description": content.pageDescription,
  "inLanguage": lang,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq: any) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={content.pageTitle}
  description={content.pageDescription}
  faqs={faqs}
  excludeFaqSchema={true}
  availableLocales={availableLocales}
  lang={lang}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1 print:hidden">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={content.breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1140px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-signature-coral text-white mb-3">
        {content.badge}
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        {content.h1}
      </h1>
      <p class="text-body text-[15px] md:text-[16px] leading-relaxed">
        {content.heroSub}
      </p>
    </header>

    <!-- Main Interactive Checker Component -->
    <DishwasherRinseAidScaleTroubleshooter lang={lang} />
  </div>
</Layout>
