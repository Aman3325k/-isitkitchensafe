---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CharcoalGasGrillPahHcaModeler from '../../../components/CharcoalGasGrillPahHcaModeler.astro';
import type { SupportedLanguage } from '../../../i18n/ui';
import { useTranslations, useTranslatedPath } from '../../../i18n/utils';

export function getStaticPaths() {
  const availableLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'zh-cn', 'ja'];
  return [
    { params: { lang: 'es' }, props: { lang: 'es' as SupportedLanguage, availableLocales } },
    { params: { lang: 'pt' }, props: { lang: 'pt' as SupportedLanguage, availableLocales } },
    { params: { lang: 'zh-cn' }, props: { lang: 'zh-cn' as SupportedLanguage, availableLocales } },
    { params: { lang: 'ja' }, props: { lang: 'ja' as SupportedLanguage, availableLocales } }
  ];
}

interface Props {
  lang: SupportedLanguage;
  availableLocales: SupportedLanguage[];
}

const { lang, availableLocales } = Astro.props;
const t = useTranslations(lang);
const tp = useTranslatedPath(lang);

interface LocaleContent {
  pageTitle: string;
  pageDescription: string;
  breadcrumbs: Array<{ label: string; href?: string }>;
  faqs: Array<{ question: string; answer: string }>;
  monoBadge: string;
  monoTitle: string;
  monoSub: string;
  monoSection1Title: string;
  monoSection1Body: string;
  monoSection2Title: string;
  monoSection2Body: string;
  monoSection3Title: string;
  monoSection3Body: string;
  monoSection4Title: string;
  monoSection4Body: string;
  monoSection5Title: string;
  monoSection5Body: string;
}

const CONTENT: Record<SupportedLanguage, LocaleContent> = {
  en: {} as any,
  es: {
    pageTitle: "Modelador de Carcinógenos PAH y HCA: Parrilla de Carbón vs Gas | IsItKitchenSafe",
    pageDescription: "Simule la pirólisis de grasa en brasas a 750°C, condensación de benzo[a]pireno, síntesis de aminas heterocíclicas (PhIP/MeIQx) y límites de la UE 835/2011.",
    breadcrumbs: [
      { label: 'Inicio', href: '/es/' },
      { label: 'Herramientas', href: '/es/tools/' },
      { label: 'Modelador de Carcinógenos en Parrilla (PAH y HCA)' }
    ],
    monoBadge: "Toxicología de Combustión y Cinética de Mutágenos Térmicos",
    monoTitle: "Modelador de Carcinógenos PAH y HCA: Parrilla de Carbón vs Gas",
    monoSub: "Simule la pirólisis de lípidos en brasas a 750°C, condensación de humos con benzo[a]pireno, condensación de creatina y aminas de Maillard (PhIP/MeIQx) y normativas de la UE.",
    monoSection1Title: "1. Física de la Pirosíntesis Lipídica: Grasa Goteando sobre Brasas a 750°C",
    monoSection1Body: "En parrillas de carbón, las brasas superan habitualmente los 750°C a 850°C. Al fundirse la grasa animal y gotear sobre el carbón, los triglicéridos sufren choque térmico y rotura homolítica instantánea, recombinándose en hidrocarburos aromáticos policíclicos (PAH) como el Benzo[a]pireno (BaP), cancerígeno humano del Grupo 1 de la IARC.",
    monoSection2Title: "2. Cinética de Aminas Heterocíclicas (HCA): Vía de Ciclación Maillard",
    monoSection2Body: "A diferencia de los PAH generados por el humo exterior, las HCA (como PhIP y MeIQx) se sintetizan en la propia costra de la carne cuando aminoácidos libres (fenilalanina), creatina y azúcares sufren calor directo superior a 150°C, disparándose de forma exponencial por encima de 200°C en carnes muy tostadas.",
    monoSection3Title: "3. Comparativa de Combustibles: Carbón vs Gas vs Pellets vs Eléctrico",
    monoSection3Body: "El gas propano y natural arden de forma más limpia, reduciendo el hollín y los PAH en un 60% al generarse humo solo en los deflectores. Los ahumadores de pellets mantienen temperaturas bajas con grasa desviada, y las parrillas eléctricas sin llama abierta reducen los carcinógenos más del 95%.",
    monoSection4Title: "4. Límites Legales de la UE: Reglamento (UE) nº 835/2011",
    monoSection4Body: "La Unión Europea fijó un límite máximo estricto de 2,0 µg/kg para Benzo[a]pireno y 12,0 µg/kg para la suma de 4 PAH en carnes a la brasa. Una hamburguesa muy hecha a la brasa de carbón directo puede alcanzar de 3,5 a 7,0 µg/kg, superando ampliamente el límite legal.",
    monoSection5Title: "5. Protocolos Culinaros: Método Indirecto de 2 Zonas y Marinada de Romero",
    monoSection5Body: "Cocinar en 2 zonas con una bandeja de agua bajo la carne desvía la grasa y elimina el 92% del humo tóxico. Además, una marinada de 30 minutos con cerveza negra o romero fresco aporta antioxidantes que neutralizan radicales libres y frenan las HCA hasta en un 88%.",
    faqs: [
      {
        question: "¿Cómo se forman los hidrocarburos aromáticos policíclicos (PAH) al asar carne?",
        answer: "Se forman por la pirólisis térmica de la grasa animal al gotear sobre brasas a más de 700°C. Los lípidos se fragmentan y recombinan en compuestos como benzo[a]pireno, que ascienden en columnas de humo denso y se condensan en la carne."
      },
      {
        question: "¿Cuál es la diferencia entre los PAH y las aminas heterocíclicas (HCA)?",
        answer: "Los PAH provienen del humo exterior que impregna la carne, mientras que las HCA se sintetizan directamente dentro de la costra de la carne por la reacción entre creatina y aminoácidos a más de 150°C."
      },
      {
        question: "¿Es más segura la barbacoa de gas que la de carbón?",
        answer: "Sí, el gas produce entre un 50% y un 70% menos de PAH porque el propano arde sin generar hollín propio y la grasa solo toca los protectores metálicos."
      },
      {
        question: "¿Por qué el romero y la cerveza reducen los carcinógenos?",
        answer: "Contienen polifenoles y melanoidinas que actúan como potentes antioxidantes, neutralizando los radicales libres e impidiendo la síntesis de aminas mutagénicas en hasta un 88%."
      }
    ]
  },
  pt: {
    pageTitle: "Modelador de Carcinogéneos PAH e HCA: Churrasqueira a Carvão vs Gás | IsItKitchenSafe",
    pageDescription: "Simule a pirólise de gordura em brasas a 750°C, condensação de benzo[a]pireno, síntese de aminas heterocíclicas (PhIP/MeIQx) e limites da UE 835/2011.",
    breadcrumbs: [
      { label: 'Início', href: '/pt/' },
      { label: 'Ferramentas', href: '/pt/tools/' },
      { label: 'Modelador de Carcinogéneos no Churrasco (PAH e HCA)' }
    ],
    monoBadge: "Toxicologia de Combustão e Cinética de Mutagénicos Térmicos",
    monoTitle: "Modelador de Carcinogéneos PAH e HCA: Churrasqueira a Carvão vs Gás",
    monoSub: "Simule a pirólise de lípidos em brasas a 750°C, condensação de fumos com benzo[a]pireno, síntese de creatina e aminas de Maillard (PhIP/MeIQx) e regulamentos da UE.",
    monoSection1Title: "1. Física da Pirossíntese Lipídica: Gordura a Pingar em Brasas a 750°C",
    monoSection1Body: "Em churrasqueiras a carvão, as brasas excedem frequentemente 750°C a 850°C. Quando a gordura animal derrete e pinga no carvão incandescente, os triglicerídeos sofrem quebra térmica imediata, recombinando-se em hidrocarbonetos aromáticos policíclicos (PAH) como o Benzo[a]pireno (BaP), classificado como carcinogénico do Grupo 1 pela IARC.",
    monoSection2Title: "2. Cinética das Aminas Heterocíclicas (HCA): Vias de Ciclização de Maillard",
    monoSection2Body: "Ao contrário dos PAHs que vêm do fumo exterior, as HCAs (como PhIP e MeIQx) formam-se diretamente na crosta superficial da carne. Aminoácidos livres (fenilalanina), creatina muscular e açúcares reagem sob calor superior a 150°C, multiplicando-se drasticamente acima de 200°C.",
    monoSection3Title: "3. Comparação de Combustíveis: Carvão vs Gás vs Pellets vs Elétrico",
    monoSection3Body: "Gás propano e natural queimam com muito mais pureza, reduzindo a fuligem e cortando os PAHs em 60%. Defumadores a pellets operam em convecção indireta, e grelhadores elétricos sem chamas abertas eliminam mais de 95% dos compostos perigosos.",
    monoSection4Title: "4. Limites Legais da UE: Regulamento (UE) nº 835/2011",
    monoSection4Body: "A União Europeia estabeleceu o teto rigoroso de 2,0 µg/kg para Benzo[a]pireno e 12,0 µg/kg para a soma de 4 PAHs em carnes grelhadas. Hambúrgueres bem passados em carvão direto podem facilmente atingir 3,5 a 7,0 µg/kg.",
    monoSection5Title: "5. Métodos Culinários Preventivos: Zona Indireta e Marinada com Cerveja Preta",
    monoSection5Body: "Grelhar com método indireto de 2 zonas usando um tabuleiro com água sob a carne impede que a gordura atinja o calor direto, eliminando 92% do fumo tóxico. Marinadas de 30 minutos com alecrim ou cerveja preta cortam as aminas mutagénicas em até 88%.",
    faqs: [
      {
        question: "Como se formam os hidrocarbonetos aromáticos policíclicos (PAH) no churrasco?",
        answer: "Formam-se pela decomposição pirolítica de gordura animal a pingar em brasas a mais de 700°C, gerando fumo denso carregado de benzo[a]pireno que se deposita na carne."
      },
      {
        question: "Qual a diferença entre PAHs e aminas heterocíclicas (HCAs)?",
        answer: "Os PAHs vêm do fumo exterior que se condensa na superfície, enquanto as HCAs são sintetizadas diretamente na carne pela reação entre aminoácidos e creatina em altas temperaturas."
      },
      {
        question: "Grelhar a gás é mais saudável que a carvão?",
        answer: "Sim, produz 50% a 70% menos PAHs porque a queima de gás é livre de fuligem e os pingos tocam apenas defletores metálicos."
      },
      {
        question: "Por que alecrim e cerveja preta reduzem mutagénicos?",
        answer: "São ricos em polifenóis e antioxidantes que desarmam os radicais livres intermediários durante o preparo, inibindo as HCAs em até 88%."
      }
    ]
  },
  'zh-cn': {
    pageTitle: "木炭与燃气烤炉 PAH 及 HCA 致癌物生成模拟器 | IsItKitchenSafe",
    pageDescription: "模拟油脂滴落750°C炭火热解、苯并[a]芘烟尘冷凝、肌酸-氨基酸美拉德缩合反应（PhIP/MeIQx）及欧盟 835/2011 致癌物限量标准。",
    breadcrumbs: [
      { label: '首页', href: '/zh-cn/' },
      { label: '实用工具', href: '/zh-cn/tools/' },
      { label: '烧烤致癌物模型（PAH 与 HCA）' }
    ],
    monoBadge: "燃烧毒理学与热突变动力学",
    monoTitle: "木炭与燃气烤炉 PAH 及 HCA 致癌物生成模拟器",
    monoSub: "模拟油脂滴落750°C炭火热裂解、苯并[a]芘气溶胶冷凝、肌酸-氨基酸美拉德反应（PhIP/MeIQx）及欧盟限量标准评估。",
    monoSection1Title: "1. 脂质热裂解物理学：油脂滴入 750°C 炽热炭火",
    monoSection1Body: "户外木炭烧烤时，炽热炭火表面温度通常高达 750°C 至 850°C。肉类熔化甘油三酯滴落至火源，瞬间发生自由基热裂解，重新组合为以苯并[a]芘（BaP，国际癌症研究机构 IARC 一类致癌物）为代表的多环芳烃（PAH），随对流浓烟重新冷凝附着在肉块表面。",
    monoSection2Title: "2. 杂环胺动力学：氨基酸-肌酸美拉德热缩合途径",
    monoSection2Body: "与源自外部烟尘的多环芳烃不同，杂环胺（如 PhIP 和 MeIQx）是在肉块焦皮组织内部直接合成的。游离氨基酸（苯丙氨酸）、肌酸与还原糖在 150°C 以上发生环化反应，当全熟或烧焦使表面温度突破 200°C 时，杂环胺生成量呈指数级暴增。",
    monoSection3Title: "3. 燃料基质对比：木炭 vs 燃气 vs 颗粒熏烤 vs 电烤炉",
    monoSection3Body: "丙烷和天然气燃烧极为清洁，多环芳烃释放量比木炭低 60%；颗粒熏烤炉采用间接对流温控排油；无明火电烤炉通过水接油盘使致癌物削减 95% 以上。",
    monoSection4Title: "4. 欧盟法定安全限值：欧盟第 835/2011 号法规",
    monoSection4Body: "欧盟对烧烤熏制肉类设定了严苛标准：苯并[a]芘上限为 2.0 µg/kg，4项多环芳烃总和上限为 12.0 µg/kg。直火全熟木炭汉堡的苯并[a]芘含量常达 3.5 至 7.0 µg/kg，超标逾 300%。",
    monoSection5Title: "5. 循证烹饪防范：双温区间接烧烤与迷迭香黑啤腌料",
    monoSection5Body: "采用双温区烧烤并在肉块下方设置装水接油盘，杜绝油脂滴火，能消除 92% 挥发性苯并[a]芘；用黑啤酒或新鲜迷迭香腌制 30 分钟，其丰富多酚可阻断自由基，使杂环胺降低达 88%。",
    faqs: [
      {
        question: "烧烤中的多环芳烃（PAH）是如何形成的？",
        answer: "肉类油脂滴落到 700°C 以上的炭火或热挡火板上发生高温热解，裂解产物重新聚合生成以苯并[a]芘为首的稠环芳烃，随浓烟沉积在肉表面。"
      },
      {
        question: "多环芳烃（PAH）与杂环胺（HCA）有何区别？",
        answer: "多环芳烃来自外部烟雾沉积，而杂环胺是肉块表皮内部在 150°C 以上由肌酸和氨基酸直接发生美拉德缩合反应生成的。"
      },
      {
        question: "燃气烧烤比木炭烧烤更健康吗？",
        answer: "是的，燃气燃烧无炭黑积存，油脂仅接触金属导热板，生成的多环芳烃比木炭低 50% 至 70%。"
      },
      {
        question: "为什么迷迭香和黑啤酒腌料能抑制致癌物？",
        answer: "迷迭香中的鼠尾草酸与黑啤酒中的类黑精是强效抗氧化剂，能中和肌酸中间体自由基，阻断高达 88% 的杂环胺形成。"
      }
    ]
  },
  ja: {
    pageTitle: "木炭・ガスグリル PAH＆HCA 発がん性物質モデラー | IsItKitchenSafe",
    pageDescription: "750°C炭火への油脂滴下熱分解、揮発性ベンゾ[a]ピレン煙凝縮、クレアチン・アミノ酸メイラード縮合（PhIP/MeIQx）、およびEU 835/2011基準を解析。",
    breadcrumbs: [
      { label: 'ホーム', href: '/ja/' },
      { label: 'ツール', href: '/ja/tools/' },
      { label: 'グリル発がん性物質モデラー（PAH＆HCA）' }
    ],
    monoBadge: "燃焼毒性学＆熱変異原動力学",
    monoTitle: "木炭・ガスグリル PAH＆HCA 発がん性物質モデラー",
    monoSub: "750°C炭火への油脂滴下熱分解、揮発性ベンゾ[a]ピレン煙凝縮、クレアチン・アミノ酸メイラード縮合（PhIP/MeIQx）、およびEU 835/2011基準を解析。",
    monoSection1Title: "1. 脂質熱分解物理学：750°Cの灼熱炭火に滴る肉汁油脂",
    monoSection1Body: "木炭グリルでは炭火表面が容易に750°C〜850°Cに達します。動物性脂質が火元に滴下すると熱分解を起こし、IARCグループ1発がん物質であるベンゾ[a]ピレン（BaP）を含む多環芳香族炭化水素（PAH）へ瞬時に再結合して煙と共に肉表面に凝縮します。",
    monoSection2Title: "2. ヘテロサイクリックアミン（HCA）動態：アミノ酸・クレアチン縮合",
    monoSection2Body: "煙の付着によるPAHとは異なり、HCA（PhIPやMeIQx）は肉の焦げ目内部で直接合成されます。遊離アミノ酸（フェニルアラニン）と筋肉中クレアチンが150°C以上で反応し、ウェルダンで200°Cを超えると劇的に生成量が増加します。",
    monoSection3Title: "3. 燃料比較：木炭 vs ガス vs ペレット vs 無煙電気グリル",
    monoSection3Body: "プロパンガスや都市ガスは煤が出ずPAHを約60%低減。ペレットグリルは間接対流で脂を別容器に逃し、無煙電気グリルは直火を排して発がん物質を95%以上カットします。",
    monoSection4Title: "4. EU法定基準：欧州委員会規則 (EU) No 835/2011",
    monoSection4Body: "EU規則では焼き肉中のベンゾ[a]ピレン上限を2.0 µg/kg、4種PAH合計を12.0 µg/kgに厳しく制限しています。直火炭火で焼いたウェルダン肉は3.5〜7.0 µg/kgに達し、容易に基準値をオーバーします。",
    monoSection5Title: "5. 科学的予防策：2ゾーン間接焼きとローズマリー・黒ビールマリネ",
    monoSection5Body: "炭火を片側に寄せ、肉の下に水受け皿を置く2ゾーン間接焼きにより、火への脂滴下を防いでPAH煙を92%遮断できます。またローズマリーや黒ビールで30分マリネすると抗酸化物質がHCA生成を最大88%抑制します。",
    faqs: [
      {
        question: "バーベキューで多環芳香族炭化水素（PAH）はどのように発生しますか？",
        answer: "肉の脂が700°C以上の炭火に落ちて高温熱分解を起こし、ベンゾ[a]ピレン等の発がん物質に変化して煙に乗って肉に付着します。"
      },
      {
        question: "PAHとヘテロサイクリックアミン（HCA）の違いは何ですか？",
        answer: "PAHは外部の煙から肉表面に付着するのに対し、HCAは肉自体のクレアチンとアミノ酸が高温加熱によって結合し表面クラスト内部で生成されます。"
      },
      {
        question: "ガスグリルは木炭よりも安全ですか？",
        answer: "はい。ガスは不完全燃焼の煤が出ず、脂が熱い金属板に触れた時だけ煙が出るため、木炭よりPAHが50〜70%少なくなります。"
      },
      {
        question: "ローズマリーや黒ビールが発がん物質を減らすのはなぜですか？",
        answer: "カルノシン酸やメラノイジンなどの強力な抗酸化成分がフリーラジカルを捕捉し、HCAの合成反応を最大88%阻止するためです。"
      }
    ]
  }
};

const c = CONTENT[lang];
---

<Layout title={c.pageTitle} description={c.pageDescription} faqs={c.faqs} availableLocales={availableLocales} lang={lang}>
  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={c.breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1280px] mx-auto px-6 py-10 md:py-16">
    <!-- Header -->
    <header class="max-w-4xl mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-rose-100 text-rose-900 mb-3 border border-rose-200">
        <span>🔥</span>
        {c.monoBadge}
      </div>
      <h1 class="text-3xl md:text-5xl font-extrabold text-ink tracking-tight mb-4 leading-tight">
        {c.monoTitle}
      </h1>
      <p class="text-base md:text-xl text-body leading-relaxed">
        {c.monoSub}
      </p>
    </header>

    <!-- Interactive Simulator Component -->
    <CharcoalGasGrillPahHcaModeler lang={lang} />

    <!-- Scientific Engineering & Food Contact Guide -->
    <article class="prose max-w-none border-t border-hairline pt-12 space-y-10 text-body">
      <div>
        <h2 class="text-2xl font-bold text-ink mb-4">
          {c.monoSection1Title}
        </h2>
        <p class="leading-relaxed">
          {c.monoSection1Body}
        </p>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-ink mb-4">
          {c.monoSection2Title}
        </h2>
        <p class="leading-relaxed">
          {c.monoSection2Body}
        </p>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-ink mb-4">
          {c.monoSection3Title}
        </h2>
        <p class="leading-relaxed">
          {c.monoSection3Body}
        </p>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-ink mb-4">
          {c.monoSection4Title}
        </h2>
        <p class="leading-relaxed">
          {c.monoSection4Body}
        </p>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-ink mb-4">
          {c.monoSection5Title}
        </h2>
        <p class="leading-relaxed">
          {c.monoSection5Body}
        </p>
      </div>
    </article>
  </div>
</Layout>
