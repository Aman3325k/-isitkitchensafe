          "position": 3,
          "name": c.breadcrumbsLabel,
          "item": `https://isitkitchensafe.com${tp('/tools/commercial-mats-sterilization-modeler/')}`
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": c.faqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
};
---

<Layout 
  title={c.pageTitle}
  description={c.pageDescription}
  structuredData={structuredData}
>
  <main class="max-w-5xl mx-auto px-4 sm:px-6 py-8">
    <Breadcrumbs items={breadcrumbs} />

    <div class="mb-6">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 mb-2">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 2v4m0 12v4M4.93 4.93l2.83 2.83m8.48 8.48l2.83 2.83M2 12h4m12 0h4M4.93 19.07l2.83-2.83m8.48-8.48l2.83-2.83"></path>
          <circle cx="12" cy="12" r="4"></circle>
        </svg>
        {c.badge}
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-ink tracking-tight mb-3">
        {c.h1}
      </h1>
      <p class="text-base sm:text-lg text-muted max-w-3xl leading-relaxed">
        {c.lead}
      </p>
    </div>

    <CommercialMatsSterilizationModeler lang={lang} />

    <section class="mt-12 border-t border-hairline pt-8">
      <h2 class="text-2xl font-bold text-ink mb-6">Frequently Asked Engineering Questions</h2>
      <div class="space-y-6">
        {c.faqs.map(faq => (
          <div class="bg-surface-soft p-5 sm:p-6 rounded-xl border border-hairline">
            <h3 class="text-base sm:text-lg font-bold text-ink mb-2">{faq.question}</h3>
            <p class="text-sm text-muted leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </section>
  </main>
</Layout>
