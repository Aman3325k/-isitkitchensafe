        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
};
---

<Layout
  title={c.pageTitle}
  description={c.pageDescription}
  structuredData={structuredData}
>
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <Breadcrumbs items={breadcrumbs} />
    
    <div class="mt-6">
      <CommercialColdGaseousOzoneModeler lang={lang} />
    </div>

    <!-- Technical FAQs Section -->
    <div class="mt-12 border-t border-hairline pt-10">
      <h2 class="text-xl sm:text-2xl font-bold text-ink tracking-tight mb-6">
        {lang === 'es' && "Preguntas Técnicas Frecuentes"}
        {lang === 'pt' && "Perguntas Técnicas Frequentes"}
        {lang === 'zh-cn' && "工程技术常见问题解答 (FAQ)"}
        {lang === 'ja' && "技術的なよくある質問 (FAQ)"}
      </h2>
      <div class="space-y-6">
        {c.faqs.map(faq => (
          <div class="bg-surface-soft border border-hairline rounded-2xl p-6">
            <h3 class="text-base font-bold text-ink mb-2">
              {faq.question}
            </h3>
            <p class="text-sm text-body leading-relaxed">
              {faq.answer}
