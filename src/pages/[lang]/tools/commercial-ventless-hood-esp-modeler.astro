};

const c = CONTENT[lang as Exclude<SupportedLanguage, 'en'>];

const pageTitle = c.pageTitle;
const pageDescription = c.pageDescription;

const breadcrumbs = [
  { label: t('nav.home'), href: tp('/') },
  { label: t('nav.tools') || 'Tools', href: tp('/tools/') },
  { label: c.breadcrumbsLabel }
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": c.h1,
      "url": `https://isitkitchensafe.com/${lang}/tools/commercial-ventless-hood-esp-modeler/`,
      "applicationCategory": "EngineeringApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5 Canvas/CSS3.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": c.pageDescription
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": t('nav.home'),
          "item": `https://isitkitchensafe.com/${lang}/`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": t('nav.tools') || 'Tools',
          "item": `https://isitkitchensafe.com/${lang}/tools/`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": c.breadcrumbsLabel,
          "item": `https://isitkitchensafe.com/${lang}/tools/commercial-ventless-hood-esp-modeler/`
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": c.faqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} structuredData={structuredData}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
    <Breadcrumbs items={breadcrumbs} />

    <!-- Hero Header -->
    <header class="my-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-indigo-600 text-white mb-3">
        {c.badge}
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-ink tracking-tight mb-4">
        {c.h1}
      </h1>
      <p class="text-base sm:text-lg text-muted max-w-4xl leading-relaxed">
        {c.lead}
      </p>
    </header>

    <!-- Interactive Diagnostic Tool Component -->
    <CommercialVentlessHoodEspModeler lang={lang} />

    <!-- Scientific Engineering Deep-Dive Content -->
    <article class="prose prose-slate max-w-none mt-12 pt-10 border-t border-hairline">
      <h2 class="text-2xl font-bold text-ink tracking-tight mb-4">
        {c.scienceTitle1}
      </h2>
      <p class="text-sm leading-relaxed text-muted mb-6">
        {c.scienceText1}
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-8 not-prose">
        <div class="p-6 rounded-2xl bg-surface-soft border border-hairline">
          <h3 class="text-base font-bold text-ink mb-2">{c.box1Title}</h3>
          <div class="p-3 rounded-xl bg-surface font-mono text-xs text-ink border border-hairline/60 mb-3">
            &eta; = 1 - exp(- (w &middot; A) / Q)
          </div>
          <p class="text-xs text-muted leading-relaxed">
            {c.box1Text}
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-surface-soft border border-hairline">
          <h3 class="text-base font-bold text-ink mb-2">{c.box2Title}</h3>
          <div class="p-3 rounded-xl bg-surface font-mono text-xs text-ink border border-hairline/60 mb-3">
            E<sub>c</sub> = m<sub>0</sub> &middot; g<sub>0</sub> &middot; &delta; &middot; [1 + 0.301 / &radic;(&delta; &middot; r<sub>0</sub>)]
          </div>
          <p class="text-xs text-muted leading-relaxed">
            {c.box2Text}
          </p>
        </div>
      </div>

      <h2 class="text-2xl font-bold text-ink tracking-tight mb-4">
        {c.scienceTitle2}
      </h2>
      <p class="text-sm leading-relaxed text-muted mb-6">
        {c.scienceText2}
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-8 not-prose">
        <div class="p-6 rounded-2xl bg-surface-soft border border-hairline">
          <h3 class="text-base font-bold text-ink mb-2">{c.box3Title}</h3>
          <p class="text-xs text-muted leading-relaxed">
            {c.box3Text}
          </p>
        </div>
        <div class="p-6 rounded-2xl bg-surface-soft border border-hairline">
          <h3 class="text-base font-bold text-ink mb-2">{c.box4Title}</h3>
          <p class="text-xs text-muted leading-relaxed">
            {c.box4Text}
          </p>
        </div>
      </div>

      <!-- FAQ Accordion / Listing -->
      <h2 class="text-2xl font-bold text-ink tracking-tight mb-6">
        {lang === 'es' ? 'Preguntas Frecuentes' : lang === 'pt' ? 'Perguntas Frequentes' : lang === 'zh-cn' ? '常见问题与专业技术解答' : 'よくある質問'}
      </h2>
      <div class="space-y-4 not-prose">
        {c.faqs.map(faq => (
          <details class="group bg-surface-soft border border-hairline rounded-2xl p-5 open:bg-surface-card transition-colors">
            <summary class="font-bold text-sm sm:text-base text-ink cursor-pointer list-none flex justify-between items-center gap-4">
              <span>{faq.question}</span>
              <span class="text-muted group-open:rotate-180 transition-transform">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </summary>
            <p class="text-xs sm:text-sm text-muted leading-relaxed mt-4 pt-4 border-t border-hairline">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </article>
  </div>
</Layout>
