      },
      {
        question: "どのプラスチック番号にBPAや有害な可塑剤が含まれていますか？",
        answer: "3番 PVCには柔軟性を出すため30〜40％のフタル酸エステル系可塑剤（DEHP等）が添加されており、熱や油で溶出しやすい性質があります。また古い7番 ポリカーボネート（PC）はビスフェノールA（BPA）を原料としており、加熱や経年劣化でBPAが溶出します。1番、2番、4番、5番は本来BPAやフタル酸を必要としません。最新の7番 TritanはBPA・BPSおよび女性ホルモン様作用（EA）フリーが公的機関により証明されています。"
      },
      {
        question: "プラスチック容器に熱湯や出来立ての熱いスープを注いでも大丈夫ですか？",
        answer: "日常的なプラスチックの中で、100℃の沸騰した熱湯やスープを安全に注げるのは5番 PP（ポリプロピレン）および7番 Tritanのみです。1番 PETボトルに熱湯を注ぐと瞬時に白濁・縮小して火傷の危険があり、6番 発泡スチロールは熱と油脂でスチレンが溶出、7番 PLAは46℃を超えると軟化して崩壊します。出来立ての熱いシチューやスープの保存には、耐熱ガラス製容器や304ステンレス容器への移し替えを推奨します。"
      }
    ],
    relatedToolTag: "関連インタラクティブツール",
    relatedDecoderTitle: "食器・容器底面シンボルデコーダー →",
    relatedDecoderDesc: "食器底面に刻印された電子レンジ波線、食洗機ラック、グラスとフォーク、雪の結晶、IHコイルなどの国際マークの意味を一発解読。",
    relatedPanTag: "フライパン安全性判定",
    relatedPanTitle: "AIフライパン傷み・剥がれ判定ツール →",
    relatedPanDesc: "テフロン加工の傷やフッ素樹脂PTFEの劣化、鉄フライパンの錆や重金属溶出リスクを専門的にチェック。",
    hubsTitle: "検証済みキッチン家電＆素材ガイド一覧",
    hubsDesc: "あらゆるキッチン家電の耐熱限界、熱衝撃リスク、化学安全データを網羅。",
    faqEyebrow: "科学的エビデンスに基づくQ&A",
    faqHeading: "プラスチック番号と食品安全性に関するよくある質問",
    faqStandard: "米FDA 21 CFR 177規則、ASTM D7611規格、および欧州EFSA食品接触材料安全性評価に基づいています。",
    btnAllTools: "全ツール一覧を見る →"
  }
};

const c = CONTENT[lang as keyof typeof CONTENT] || CONTENT.es;
const microwaveUrl = getApplianceUrl('microwave', lang);
const dishwasherUrl = getApplianceUrl('dishwasher', lang);
const freezerUrl = getApplianceUrl('freezer', lang);
const refrigeratorUrl = getApplianceUrl('refrigerator', lang);
const methodologyUrl = translatePath('/methodology/');
const toolsUrl = translatePath('/tools/');
const decoderUrl = translatePath('/tools/kitchen-symbol-decoder/');
const panInspectorUrl = translatePath('/tools/pan-scratch-inspector/');

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": c.pageTitle,
  "url": `https://isitkitchensafe.com/${lang}/tools/plastic-code-checker/`,
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript.",
  "description": c.pageDescription,
  "inLanguage": lang,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": c.faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={c.pageTitle}
  description={c.pageDescription}
  excludeFaqSchema={true}
  availableLocales={availableLocales}
  lang={lang}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={c.breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1140px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-indigo-700 text-white mb-3">
        {c.badge}
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        {c.h1}
      </h1>
      <p class="text-body text-[15px] md:text-[16px] leading-relaxed">
        {c.heroSub}
      </p>
    </header>

    <!-- Main Interactive Tool Component -->
    <div class="mb-14">
      <PlasticCodeChecker lang={lang} />
    </div>

    <!-- Related Kitchen Tools & Verification Guides -->
    <section class="mb-14 grid grid-cols-1 md:grid-cols-2 gap-5">
      <a
        href={decoderUrl}
        class="p-6 rounded-2xl bg-surface-soft border border-hairline hover:border-indigo-600 transition-all group block"
      >
        <span class="text-[11px] font-bold uppercase tracking-wider text-indigo-700 dark:text-indigo-400 block mb-1.5">
          {c.relatedToolTag}
        </span>
        <h3 class="text-title-sm font-semibold text-ink group-hover:text-indigo-600 transition-colors mb-1.5">
          {c.relatedDecoderTitle}
        </h3>
        <p class="text-[13.5px] text-body leading-relaxed">
          {c.relatedDecoderDesc}
        </p>
      </a>

      <a
        href={panInspectorUrl}
        class="p-6 rounded-2xl bg-surface-soft border border-hairline hover:border-indigo-600 transition-all group block"
      >
        <span class="text-[11px] font-bold uppercase tracking-wider text-indigo-700 dark:text-indigo-400 block mb-1.5">
          {c.relatedPanTag}
        </span>
        <h3 class="text-title-sm font-semibold text-ink group-hover:text-indigo-600 transition-colors mb-1.5">
          {c.relatedPanTitle}
        </h3>
        <p class="text-[13.5px] text-body leading-relaxed">
          {c.relatedPanDesc}
        </p>
      </a>
    </section>

    <!-- Core Appliance Directory Strip -->
    <section class="mb-14 p-6 rounded-2xl bg-surface-soft border border-hairline">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <h2 class="text-title-sm font-semibold text-ink mb-1">
            {c.hubsTitle}
          </h2>
          <p class="text-[13px] text-muted">
            {c.hubsDesc}
          </p>
        </div>
        <div class="flex flex-wrap gap-2">
          <a href={microwaveUrl} class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-indigo-600 transition-colors">
            {lang === 'es' ? 'Guía Microondas' : lang === 'pt' ? 'Guia Micro-ondas' : lang === 'zh-cn' ? '微波炉指南' : '電子レンジ'}
          </a>
          <a href={dishwasherUrl} class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-indigo-600 transition-colors">
            {lang === 'es' ? 'Guía Lavavajillas' : lang === 'pt' ? 'Guia Lava-louças' : lang === 'zh-cn' ? '洗碗机指南' : '食洗機'}
          </a>
          <a href={freezerUrl} class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-indigo-600 transition-colors">
            {lang === 'es' ? 'Guía Congelador' : lang === 'pt' ? 'Guia Freezer' : lang === 'zh-cn' ? '冷冻室指南' : '冷凍庫'}
          </a>
          <a href={refrigeratorUrl} class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-indigo-600 transition-colors">
            {lang === 'es' ? 'Guía Nevera' : lang === 'pt' ? 'Guia Geladeira' : lang === 'zh-cn' ? '冰箱保鲜指南' : '冷蔵庫'}
          </a>
          <a href={methodologyUrl} class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-indigo-600 transition-colors">
            {lang === 'es' ? 'Metodología' : lang === 'pt' ? 'Metodologia' : lang === 'zh-cn' ? '研究方法' : '評価基準・方法'}
          </a>
          <a href={toolsUrl} class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-primary text-on-primary hover:bg-primary-active transition-colors">
            {c.btnAllTools}
          </a>
        </div>
      </div>
    </section>

    <!-- FAQ Accordion Section (Visible E-E-A-T Content) -->
    <section class="mb-8">
      <div class="border-b border-hairline pb-4 mb-6">
        <span class="text-xs font-bold uppercase tracking-wider text-indigo-700 dark:text-indigo-400 block mb-1">
          {c.faqEyebrow}
        </span>
        <h2 class="text-title-lg font-medium text-ink tracking-tight">
          {c.faqHeading}
        </h2>
        <p class="text-xs text-muted mt-1">
          {c.faqStandard}
        </p>
      </div>

      <div class="space-y-4">
        {c.faqs.map((faq) => (
          <details class="group p-5 bg-surface-soft border border-hairline rounded-xl" open>
            <summary class="text-title-sm font-semibold text-ink cursor-pointer list-none flex items-center justify-between gap-3">
              <span>{faq.question}</span>
              <span class="text-muted text-sm transition-transform group-open:rotate-180 shrink-0" aria-hidden="true">&#9662;</span>
            </summary>
            <p class="text-[14px] text-body leading-relaxed mt-3 pt-3 border-t border-hairline/70">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </div>
</Layout>
