---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CookwareBrandIndex from '../../../components/CookwareBrandIndex.astro';
import type { SupportedLanguage } from '../../../i18n/ui';
import { useTranslations, useTranslatedPath } from '../../../i18n/utils';

export function getStaticPaths() {
  const availableLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'zh-cn', 'ja'];
  return [
    { params: { lang: 'es' }, props: { lang: 'es' as SupportedLanguage, availableLocales } },
    { params: { lang: 'pt' }, props: { lang: 'pt' as SupportedLanguage, availableLocales } },
    { params: { lang: 'zh-cn' }, props: { lang: 'zh-cn' as SupportedLanguage, availableLocales } },
    { params: { lang: 'ja' }, props: { lang: 'ja' as SupportedLanguage, availableLocales } }
  ];
}

interface Props {
  lang: SupportedLanguage;
  availableLocales: SupportedLanguage[];
}

const { lang, availableLocales } = Astro.props;
const t = useTranslations(lang);
const tp = useTranslatedPath(lang);

interface LocaleToolContent {
  pageTitle: string;
  pageDescription: string;
  badge: string;
  h1: string;
  heroSub: string;
  methodologyTitle: string;
  methodologyIntro: string;
  methodologyPoints: Array<{ title: string; desc: string }>;
  faqs: Array<{ question: string; answer: string }>;
  breadcrumbs: Array<{ label: string; href?: string }>;
}

const CONTENT: Record<SupportedLanguage, LocaleToolContent> = {
  en: {} as any,
  es: {
    pageTitle: "Índice de Transparencia de Marcas de Sartenes (2026) | Verificador de Teflón y PFAS | IsItKitchenSafe",
    pageDescription: "Consulta 25 marcas líderes mundiales de menaje de cocina para descubrir teflón y PTFE ocultos, auditorías de laboratorio y reclamos comerciales engañosos.",
    badge: "Protección al Consumidor • Transparencia Química",
    h1: "Índice de Transparencia de Marcas de Sartenes y Greenwashing",
    heroSub: "No permitas que el marketing engañoso introduzca fluoropolímeros en la comida de tu familia. Consulta a continuación 25 marcas líderes de sartenes para verificar su química real, certificaciones y límites térmicos seguros.",
    methodologyTitle: "Nuestro Protocolo Científico de Auditoría en 5 Puntos",
    methodologyIntro: "Cada marca evaluada en el Índice de Transparencia de IsItKitchenSafe se califica según cinco criterios objetivos verificados mediante auditorías de laboratorios independientes (SGS, TÜV Rheinland, Intertek) y normativas oficiales de seguridad alimentaria:",
    methodologyPoints: [
      { title: "Declaración de Química de Polímeros", desc: "Verificación de la resina base. Las marcas que revelan con total transparencia si usan fluoropolímeros o sol-gel obtienen la máxima puntuación; ocultar PTFE bajo nombres comerciales conlleva penalización severa." },
      { title: "Auditorías de Lixiviación Independientes", desc: "Análisis de metales pesados extraíbles (plomo, cadmio, cobalto) bajo simulación ácida al 4% según normas ISO 4531 y FDA 21 CFR 175.300." },
      { title: "Límites Térmicos de Degradación", desc: "Evaluación del punto de descomposición. Cualquier sartén que libere perfluoroisobutileno o partículas tóxicas por encima de 260°C (500°F) recibe advertencia explícita." },
      { title: "Penalización por Publicidad Engañosa", desc: "Sanción estricta a reclamos comerciales engañosos como 'Granito', 'Piedra' o 'Diamante' aplicados a PTFE ordinario, o sellos 'Libre de PFOA' que ocultan teflón." },
      { title: "Durabilidad y Riesgo de Microplásticos", desc: "Evaluación de la resistencia de la matriz ante utensilios y del desprendimiento de microplásticos y nanoplásticos en los alimentos cocinados." }
    ],
    faqs: [
      {
        question: "¿Qué es el 'greenwashing' o publicidad engañosa en sartenes?",
        answer: "Ocurre cuando los fabricantes utilizan términos ecológicos como 'Libre de PFOA', 'Revestimiento de Granito Natural' o 'Cerámica de Titanio', pero la capa que está en contacto con la comida sigue siendo PTFE (teflón convencional) o compuestos fluorados sintéticos."
      },
      {
        question: "¿'Libre de PFOA' significa que la sartén no tiene teflón ni PTFE?",
        answer: "No. El PFOA fue prohibido a nivel mundial en 2015. Más del 90% de las sartenes que hoy se anuncian como 'Sin PFOA' están hechas con PTFE, que sigue degradándose y liberando microplásticos y humos tóxicos al calentarse a más de 260°C."
      },
      {
        question: "¿Cuáles son los únicos materiales 100% libres de tóxicos y microplásticos?",
        answer: "Solo los materiales minerales sin revestir: hierro fundido curado con aceite vegetal (Lodge, Field), acero al carbono (de Buyer), acero inoxidable 18/10 de grado quirúrgico (All-Clad, Made In) y hierro fundido esmaltado en porcelana pura (Le Creuset, Staub)."
      },
      {
        question: "¿Son realmente seguras las sartenes de cerámica como Caraway o GreenPan?",
        answer: "Sí. Las marcas de cerámica de calidad certificada utilizan revestimientos minerales derivados de la arena (sílice sol-gel) 100% libres de PTFE, PFOA, PFAS, plomo y cadmio. No emiten humos tóxicos, aunque su efecto antiadherente dura entre 2 y 3 años."
      },
      {
        question: "¿Las sartenes HexClad tienen teflón o PTFE?",
        answer: "Sí. Aunque HexClad incorpora una rejilla hexagonal de acero inoxidable para proteger la sartén de rayaduras, los valles entre las líneas de acero están recubiertos de PTFE convencional. No debe calentarse vacía ni superar los 260°C."
      }
    ],
    breadcrumbs: [
      { label: "Inicio", href: "/es/" },
      { label: "Herramientas", href: "/es/tools/" },
      { label: "Índice de Marcas" }
    ]
  },
  pt: {
    pageTitle: "Índice de Transparência de Marcas de Panelas (2026) | Verificador de Teflon e PFAS | IsItKitchenSafe",
    pageDescription: "Consulte as 25 maiores marcas de panelas do mundo para identificar PTFE oculto, relatórios de laboratório e desvendar rótulos enganosos de 'Livre de PFOA'.",
    badge: "Proteção ao Consumidor • Segurança Química",
    h1: "Índice de Transparência de Marcas de Panelas e Greenwashing",
    heroSub: "Não deixe o marketing enganoso colocar fluoropolímeros na refeição da sua família. Consulte 25 marcas de panelas para verificar a composição química real, testes de laboratório e limites de temperatura segura.",
    methodologyTitle: "Nosso Protocolo Científico de Auditoria em 5 Pontos",
    methodologyIntro: "Cada marca avaliada no Índice de Transparência do IsItKitchenSafe é analisada sob cinco critérios objetivos verificados por laboratórios independentes (SGS, TÜV Rheinland, Intertek) e normas oficiais internacionais:",
    methodologyPoints: [
      { title: "Declaração Química do Polímero", desc: "Identificação da resina real. Marcas que revelam com transparência se usam fluoropolímeros ou sol-gel recebem nota máxima; disfarçar PTFE sob nomes fantasia gera penalização rigorosa." },
      { title: "Auditorias de Lixiviação Laboratorial", desc: "Medição de metais pesados extraíveis (chumbo, cádmio, níquel) sob ensaio de ácido acético a 4% de acordo com as normas ISO 4531 e FDA 21 CFR." },
      { title: "Limites Térmicos de Degradação", desc: "Avaliação do ponto de quebra da camada. Panelas que emitem compostos fluorados ou fumaça tóxica acima de 260°C (500°F) são marcadas com alerta." },
      { title: "Penalidade por Propaganda Enganosa", desc: "Dedução severa para rótulos como 'Granito', 'Pedra Suíça' ou 'Titânio' aplicados a PTFE comum, ou selos 'Livre de PFOA' que omitem teflón." },
      { title: "Durabilidade e Microplásticos", desc: "Análise da resistência mecânica da superfície e taxa de liberação de nanoplásticos na comida ao contato com espátulas." }
    ],
    faqs: [
      {
        question: "O que é 'greenwashing' ou propaganda enganosa em panelas?",
        answer: "Ocorre quando empresas promovem frigideiras com termos supostamente ecológicos como 'Livre de PFOA', 'Revestimento de Granito Natural' ou 'Cerâmica de Titânio', enquanto a camada de contato com o alimento continua sendo PTFE (teflon convencional)."
      },
      {
        question: "'Livre de PFOA' significa que a panela não contém teflon ou PTFE?",
        answer: "Não. O PFOA foi proibido em 2015. Mais de 90% das panelas com selo 'PFOA-Free' hoje são fabricadas com PTFE convencional, que se decompõe e solta vapores tóxicos acima de 260°C."
      },
      {
        question: "Quais são as únicas panelas 100% livres de tóxicos e microplásticos?",
        answer: "Apenas panelas sem revestimento químico sintético: ferro fundido curado com óleo (Lodge, Field), aço carbono (de Buyer), aço inoxidável cirúrgico 18/10 (All-Clad, Made In, Tramontina) e ferro esmaltado com vidro vítreo (Le Creuset, Staub)."
      },
      {
        question: "Panelas de cerâmica como Caraway ou GreenPan são realmente seguras?",
        answer: "Sim. Panelas de cerâmica com certificação independente usam sílica mineral sol-gel derivada da areia, 100% livre de PTFE, PFOA, chumbo e cádmio. Não emitem gases tóxicos mesmo se sobreaquecidas acidentalmente."
      },
      {
        question: "As panelas HexClad contêm PTFE ou teflon?",
        answer: "Sim. Embora a HexClad possua uma grade hexagonal em aço inox 304 para evitar arranhões, as ranhuras entre os pontos de aço contêm PTFE convencional. Não devem ser aquecidas vazias nem ultrapassar 260°C."
      }
    ],
    breadcrumbs: [
      { label: "Início", href: "/pt/" },
      { label: "Ferramentas", href: "/pt/tools/" },
      { label: "Índice de Marcas" }
    ]
  },
  'zh-cn': {
    pageTitle: "全球主流锅具品牌安全透明度与虚假宣传排查榜 (2026) | 特氟龙与PFAS检测 | IsItKitchenSafe",
    pageDescription: "深度收录全球25大知名锅具品牌，起底隐秘PTFE特氟龙氟聚合物成分，查阅第三方实验室溶出检测报告，破除“无PFOA”及“天然麦饭石/花岗岩”营销骗局。",
    badge: "消费者权益保护 • 化学物质透明度",
    h1: "全球主流锅具品牌透明度与虚假宣传排查榜",
    heroSub: "别让商家的文字游戏误导家人摄入氟化物微塑料。立即查询全球25大热门锅具品牌的真实涂层成分、第三方实验室重金属溶出认证与极限耐温标准。",
    methodologyTitle: "五维客观材料科学独立审核体系",
    methodologyIntro: "IsItKitchenSafe 安全透明度排行榜收录的每个品牌均经过独立第三方实验室检测报告（SGS、TÜV莱茵、Intertek）及官方食品接触安全标准严谨核查：",
    methodologyPoints: [
      { title: "聚合物化学配方真实披露", desc: "核实烹饪接触面基底化学成分。公开透明披露氟聚合物或硅溶胶陶瓷成分的品牌获满分；使用商业外号隐瞒PTFE特氟龙的品牌予以重扣。" },
      { title: "独立第三方重金属溶出审计", desc: "审查4%乙酸浸泡模拟测试下的铅、镉、钴等重金属溶出量，严格对照 ISO 4531 和美国 FDA 21 CFR 标准。" },
      { title: "热分解与有毒烟尘阈值", desc: "评估涂层热分解极限。任何在260℃（500°F）以下分解释放全氟异丁烯或微塑料气溶胶的锅具均亮起高危警示。" },
      { title: "虚假宣传扣分惩戒机制", desc: "严惩借由“天然麦饭石/花岗岩/钻石”包装传统PTFE，或以“不含PFOA”偷换概念掩盖特氟龙的误导性营销宣传。" },
      { title: "物理耐久度与微塑料脱落风险", desc: "评估涂层在铲刮和洗涤磨损下的抗刮擦寿命，精准测算破损后微塑料随食物摄入的潜在健康风险。" }
    ],
    faqs: [
      {
        question: "什么是锅具行业的“漂绿”（Greenwashing / 虚假环保宣传）？",
        answer: "指锅具厂商使用“无PFOA”、“天然麦饭石/花岗岩”、“钛陶纳米涂层”等看似绿色健康的宣传词，而锅具与食材接触的核心层实际依然是传统PTFE特氟龙或合成氟聚合物树脂。"
      },
      {
        question: "标有“不含PFOA (PFOA-Free)”是否意味着不含特氟龙/PTFE？",
        answer: "绝不等于。PFOA早在2015年就被国际公约全面淘汰。目前市场上超过90%标称“PFOA-Free”的不粘锅，其核心有效防粘成分全部是PTFE（特氟龙），加热超过260℃依然会产生热分解危害。"
      },
      {
        question: "哪些锅具材质才是真正100%无化学涂层、零微塑料的？",
        answer: "唯有纯天然无合成涂层材质：纯植物油开锅的天然铸铁锅（如Lodge、Field）、熟铁碳钢锅（如de Buyer）、18/10医用级多层不锈钢锅（如All-Clad、Made In）以及高温熔融纯玻璃珐琅铸铁锅（如Le Creuset、Staub）。"
      },
      {
        question: "Caraway和GreenPan等陶瓷不粘锅真的比特氟龙安全吗？",
        answer: "是的。正规认证的天然陶瓷锅采用源自天然砂石的二氧化硅溶胶（Sol-Gel），完全不含PTFE、PFOA、PFAS氟聚合物及铅镉重金属。即使干烧也不会产生氟化物毒烟，但其物理防粘寿命一般为2-3年。"
      },
      {
        question: "HexClad 蜂窝多层锅是否含有特氟龙/PTFE？",
        answer: "含有。HexClad虽然在表面设计了激光微雕刻304不锈钢蜂窝网凸起以抵抗铲划，但网纹凹槽内部全部充填了传统的PTFE防粘涂层，依然不可干烧或超出260℃高温使用。"
      }
    ],
    breadcrumbs: [
      { label: "首页", href: "/zh-cn/" },
      { label: "实用工具", href: "/zh-cn/tools/" },
      { label: "品牌透明度榜单" }
    ]
  },
  ja: {
    pageTitle: "フライパン主要ブランド 透明度・グリーンウォッシング調査名鑑 (2026) | PFAS・テフロン判定 | IsItKitchenSafe",
    pageDescription: "世界25大調理器具ブランドを網羅。隠れたフッ素樹脂（PTFE）の有無、第三者機関による重金属溶出試験、そして『PFOAフリー』『ストーン加工』の誇大広告の実態を公開。",
    badge: "消費者保護・化学物質情報公開",
    h1: "フライパン主要ブランド 透明度・グリーンウォッシング調査名鑑",
    heroSub: "誇大広告に惑わされて有害なフッ素化合物を食卓に持ち込まないために。世界25大調理器具ブランドのコーティング組成、公的検査機関の認証、安全限界温度を客観的に検証します。",
    methodologyTitle: "材料科学に基づく5項目客観審査プロトコル",
    methodologyIntro: "IsItKitchenSafeが公開するブランド評価は、独立第三者検査機関（SGS、TÜVラインランド等）の試験結果および国際食品衛生基準に基づき厳格に判定されています：",
    methodologyPoints: [
      { title: "コーティング化学組成の完全開示", desc: "食材に触れる層のベース樹脂を検証。フッ素樹脂やシリカセラミックの成分を偽りなく開示しているブランドを満点とし、商品名でPTFEを隠蔽している場合は厳重に減点。" },
      { title: "外部検査機関による重金属溶出試験", desc: "ISO 4531および米国FDA基準に基づく4%酢酸溶出試験における鉛・カドミウム・コバルト等の溶出レベルを精査。" },
      { title: "熱分解・有害ガス発生限界温度", desc: "耐熱限界を検証。260℃（500°F）以下で微粒子や有毒フルオロカーボンガスを放出するリスクのある製品には明瞭な警告を付与。" },
      { title: "誤認誇大表示（グリーンウォッシング）への減点", desc: "通常のPTFEに『花崗岩・ストーン・ダイヤモンド』等の名称を付けたり、『PFOAフリー』を理由にテフロン不使用と誤認させる宣伝を厳しくペナルティ化。" },
      { title: "物理的耐摩耗性とマイクロプラスチック溶出リスク", desc: "日常調理でのコーティング剥離リスクと、剥がれたナノプラスチックが食品へ混入する可能性を総合評価。" }
    ],
    faqs: [
      {
        question: "フライパン業界における『グリーンウォッシング（偽エコ宣伝）』とは何ですか？",
        answer: "『PFOAフリー』『天然ストーン加工』『チタンセラミック』といったエコで安全そうな言葉を使いながら、食材に接する調理面には従来のPTFE（フッ素樹脂・テフロン）を使用している誤認商法を指します。"
      },
      {
        question: "『PFOAフリー』と表示されていれば、テフロンやフッ素樹脂は入っていませんか？",
        answer: "いいえ。PFOAは2015年に国際的に全廃されました。現在『PFOAフリー』と表示されているフライパンの90%以上はPTFE（フッ素樹脂）が主成分であり、260℃を超えると有害なポリマーガスが発生します。"
      },
      {
        question: "一生涯マイクロプラスチックや有害物質が出ない安全な調理器具は何ですか？",
        answer: "化学コーティングを施していない無機素材のみです。油ならしした鉄スキレット（Lodge、Field）、鉄中華鍋（de Buyer）、18/10多層ステンレス（All-Clad、Made In）、無機ガラスのホーロー鍋（Le Creuset、Staub）が該当します。"
      },
      {
        question: "CarawayやGreenPanなどのセラミックフライパンは本当にテフロンより安全ですか？",
        answer: "はい。公的認証を受けた良質なセラミックフライパンは砂由来のシリカ（Sol-Gel無機ガラス）を使用しており、PTFE、PFOA、PFAS、鉛、カドミウムを一切含みません。空焚きしても有害ガスが出ない安全設計です。"
      },
      {
        question: "HexClad（ヘックスクラッド）などのハイブリッド鍋にはPTFEが含まれていますか？",
        answer: "含まれています。六角形のステンレス突起で金属ヘラの摩耗を防ぐ構造ですが、溝の底面には通常のPTFEフッ素樹脂が敷き詰められています。260℃以上の強火空焚きは厳禁です。"
      }
    ],
    breadcrumbs: [
      { label: "ホーム", href: `/${lang}/` },
      { label: "ツール", href: `/${lang}/tools/` },
      { label: "ブランド透明度名鑑" }
    ]
  }
};

const c = CONTENT[lang];

const localizedUrl = `https://isitkitchensafe.com/${lang}/tools/cookware-brand-transparency-index/`;

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": c.h1,
  "url": localizedUrl,
  "applicationCategory": "HealthApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "description": c.pageDescription,
  "inLanguage": lang,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const datasetSchema = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  "name": c.h1,
  "description": c.pageDescription,
  "url": localizedUrl,
  "inLanguage": lang,
  "license": "https://creativecommons.org/licenses/by-nc/4.0/",
  "creator": {
    "@type": "Organization",
    "name": "IsItKitchenSafe Material Science Division"
  }
};
---

<Layout title={c.pageTitle} description={c.pageDescription} faqs={c.faqs} availableLocales={availableLocales} lang={lang}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(datasetSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={c.breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1200px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-signature-coral text-white mb-3">
        {c.badge}
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        {c.h1}
      </h1>
      <p class="text-body text-[15px] md:text-body-md leading-relaxed">
        {c.heroSub}
      </p>
    </header>

    <!-- Main Tool Component -->
    <div class="mb-14">
      <CookwareBrandIndex lang={lang} />
    </div>

    <!-- Methodology Section -->
    <section class="mb-14 border-t border-hairline pt-12 space-y-6">
      <div class="max-w-3xl">
        <span class="text-xs font-bold uppercase tracking-wider text-muted block mb-1">
          ISO 17025 &bull; FDA 21 CFR
        </span>
        <h2 class="text-title-lg md:text-display-sm font-medium text-ink tracking-tight mb-3">
          {c.methodologyTitle}
        </h2>
        <p class="text-body text-[15px] leading-relaxed mb-4">
          {c.methodologyIntro}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {c.methodologyPoints.map((pt, idx) => (
          <div class="p-5 rounded-xl bg-surface-soft border border-hairline">
            <div class="w-8 h-8 rounded-lg bg-emerald-600 text-white font-bold flex items-center justify-center text-sm mb-3">
              {idx + 1}
            </div>
            <h3 class="font-semibold text-ink text-sm mb-1.5">{pt.title}</h3>
            <p class="text-xs text-body leading-relaxed">{pt.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="border-t border-hairline pt-12">
      <h2 class="text-title-lg md:text-display-sm font-medium text-ink tracking-tight mb-8">
        {t('page.faqTitle')}
      </h2>
      <div class="space-y-6 max-w-3xl">
        {c.faqs.map(faq => (
          <div class="border-b border-hairline pb-6">
            <h3 class="text-base font-semibold text-ink mb-2">
              {faq.question}
            </h3>
            <p class="text-body text-sm leading-relaxed">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>
