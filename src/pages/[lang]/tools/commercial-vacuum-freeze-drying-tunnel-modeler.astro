        answer: "連続トンネルは20〜50 mにわたり数十枚の加熱・冷却棚板が連続配置されています。一般的な直接往還配管では、入口に近い棚板ほど配管抵抗が小さく、遠い棚板ほど流量が低下して4°C〜8°Cの著しい熱媒温度偏差が生じます。高温部のトレイは崩壊融解し、低温部のトレイは昇華が停止します。チッヘルマン同程逆流配管方式は、どの棚板を経由しても全体の総流路長と水力摩擦損失が完全に等しくなるよう配管設計されており、全長にわたる全棚板の温度均一性を±0.8°C以内に極めて高精度に維持します。"
      },
      {
        question: "デュアル交互切り替えコールドトラップはどのようにして着氷断熱による運転停止を防ぐのですか？",
        answer: "極低温コールドトラップは-55°C〜-85°Cで水蒸気を固相氷へと凝華（デサブライム）捕集します。運転継続に伴いコイル表面に着氷層が形成されます。氷の熱伝導率は低いため（k ≈ 2.2 W/m·K）、着氷が25 mmを超えると強力な断熱層となり、氷表面温度が上昇して捕水能力が急低下します。連続トンネルでは高真空バタフライ弁で隔離された2基の独立トラップを採用します。A室が高真空下で連続排気している間に、B室を遮断してホットガスバイパスで急速融氷・排水を行う交互サイクルにより、真空を維持したまま24時間完全連続運転を実現します。"
      }
    ]
  }
};

const currentContent = CONTENT[lang as Exclude<SupportedLanguage, 'en'>] || CONTENT.es;

const breadcrumbs = [
  { label: t('nav.home') || 'Home', href: tp('/') },
  { label: t('nav.tools') || 'Tools', href: tp('/tools/') },
  { label: currentContent.breadcrumbsLabel }
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": `https://isitkitchensafe.com${tp('/tools/commercial-vacuum-freeze-drying-tunnel-modeler/')}/#webapp`,
      "url": `https://isitkitchensafe.com${tp('/tools/commercial-vacuum-freeze-drying-tunnel-modeler/')}`,
      "name": currentContent.pageTitle,
      "applicationCategory": "EngineeringApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5 Canvas/CSS3.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": currentContent.pageDescription
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": t('nav.home') || 'Home',
          "item": `https://isitkitchensafe.com${tp('/')}`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": t('nav.tools') || 'Tools',
          "item": `https://isitkitchensafe.com${tp('/tools/')}`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": currentContent.breadcrumbsLabel,
          "item": `https://isitkitchensafe.com${tp('/tools/commercial-vacuum-freeze-drying-tunnel-modeler/')}`
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": currentContent.faqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
};
---

<Layout 
  title={currentContent.pageTitle}
  description={currentContent.pageDescription}
  structuredData={structuredData}
>
  <main class="max-w-5xl mx-auto px-4 sm:px-6 py-8">
    <Breadcrumbs items={breadcrumbs} />

    <header class="mb-8">
      <div class="flex items-center gap-2 mb-3">
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-cyan-700 text-white">
          {currentContent.badge}
        </span>
        <span class="text-xs text-muted font-mono">ASME VIII Div 1 &bull; FDA 21 CFR § 111 / § 117 &bull; ISO 13408-3 &bull; 3-A Sanitary</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold text-ink tracking-tight mb-3">
        {currentContent.h1}
      </h1>
      <p class="text-base sm:text-lg text-muted leading-relaxed max-w-4xl">
        {currentContent.lead}
      </p>
    </header>

    <!-- Interactive Flagship Modeler Component -->
    <CommercialVacuumFreezeDryingTunnelModeler lang={lang} />

    <!-- Frequently Asked Questions -->
    <section class="mt-12 p-6 sm:p-8 bg-surface rounded-2xl border border-hairline">
      <h2 class="text-xl sm:text-2xl font-bold text-ink tracking-tight mb-6">
        {lang === 'es' && "Preguntas Frecuentes: Liofilización al Vacío y Física Criogénica"}
        {lang === 'pt' && "Perguntas Frequentes: Liofilização a Vácuo e Física Criogênica"}
        {lang === 'zh-cn' && "常见问题解答：连续真空冷冻干燥与深冷物理工程"}
        {lang === 'ja' && "よくある質問：連続真空凍結乾燥＆極低温物理工学"}
      </h2>

      <div class="space-y-6">
        {currentContent.faqs.map(faq => (
          <div class="border-b border-hairline/60 pb-5 last:border-0 last:pb-0">
            <h3 class="text-base sm:text-lg font-bold text-ink mb-2">
              {faq.question}
            </h3>
            <p class="text-xs sm:text-sm text-muted leading-relaxed">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </section>
  </main>
</Layout>
