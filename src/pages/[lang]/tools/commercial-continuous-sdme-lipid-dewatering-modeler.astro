const c = CONTENT[lang as Exclude<SupportedLanguage, 'en'>] || CONTENT.es;

const breadcrumbs = [
  { label: t('nav.home') || 'Home', href: tp('/') },
  { label: t('nav.tools') || 'Tools', href: tp('/tools/') },
  { label: c.breadcrumbsLabel }
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": `https://isitkitchensafe.com${tp('/tools/commercial-continuous-sdme-lipid-dewatering-modeler/')}#webapp`,
      "url": `https://isitkitchensafe.com${tp('/tools/commercial-continuous-sdme-lipid-dewatering-modeler/')}`,
      "name": c.pageTitle,
      "applicationCategory": "EngineeringApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5 Canvas/CSS3.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": c.pageDescription
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": t('nav.home') || 'Home',
          "item": `https://isitkitchensafe.com${tp('/')}`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": t('nav.tools') || 'Tools',
          "item": `https://isitkitchensafe.com${tp('/tools/')}`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": c.breadcrumbsLabel,
          "item": `https://isitkitchensafe.com${tp('/tools/commercial-continuous-sdme-lipid-dewatering-modeler/')}`
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": c.faqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
};
---

<Layout 
  title={c.pageTitle}
  description={c.pageDescription}
  structuredData={structuredData}
>
  <main class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
    <Breadcrumbs items={breadcrumbs} />

    <header class="mb-8">
      <div class="flex items-center gap-2 mb-3">
        <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-950 text-emerald-300 border border-emerald-800">
          {c.badge}
        </span>
        <span class="text-xs text-muted font-mono">
          sDME &bull; 0.50&ndash;0.85 MPa &bull; 20&ndash;35&deg;C &bull; SEC &lt; 15 kWh/t &bull; ASME Sec VIII &bull; NFPA 58
        </span>
      </div>
      <h1 class="text-title-xl sm:text-headline-md font-medium text-ink tracking-tight mb-4">
        {c.h1}
      </h1>
      <p class="text-body text-base max-w-4xl text-muted leading-relaxed">
        {c.lead}
      </p>
    </header>

    <!-- Flagship Interactive Simulator Tool Component -->
    <CommercialContinuousSdmeDewateringModeler lang={lang} />

    <!-- Engineering FAQs Section for Comprehensive Technical Grounding -->
    <section class="mt-16 pt-12 border-t border-hairline" aria-labelledby="faqs-heading">
      <h2 id="faqs-heading" class="text-title-lg font-medium text-ink tracking-tight mb-8">
        {lang === 'es' ? 'Preguntas Frecuentes Técnicas y Biofísicas' :
         lang === 'pt' ? 'Perguntas Frequentes Técnicas e Biofísicas' :
         lang === 'zh-cn' ? '常见工程技术与热力学问题解答' :
         '技術および生物物理学に関するよくある質問'}
      </h2>
      <div class="space-y-6">
        {c.faqs.map(faq => (
          <article class="p-6 bg-surface-soft border border-hairline rounded-2xl">
            <h3 class="text-base font-bold text-ink mb-3">
              {faq.question}
            </h3>
            <p class="text-body text-sm leading-relaxed text-muted">
              {faq.answer}
            </p>
          </article>
        ))}
      </div>
    </section>
  </main>
</Layout>
