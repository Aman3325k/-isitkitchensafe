        desc: "通常オーブン230〜288°C対応のガラス皿やセラミック鍋でも、上部ヒーターからの強い輻射熱は強化ガラス破裂・クッキングシート発火・PTFE熱分解を引き起こします。"
      },
      {
        tag: "03 · サーモスタットの温度上振れ",
        title: "家庭用オーブンは設定温度より+15〜22°C上振れする",
        desc: "218°C（425°F）設定でもヒーター制御により一時的に232〜240°Cに達します。本ツールでは上限まで残り14°C（25°F）以内の器具を「要注意 ⚠️」として警告表示します。"
      }
    ],
    relatedConvTag: "温度＆時間変換",
    relatedConvTitle: "ノンフライヤー・オーブン変換ツール →",
    relatedConvDesc: "オーブンレシピをノンフライヤーへ変換（-14°C・時間20%短縮）。°F・°C・英国ガスマーク対応。",
    relatedShockTag: "ガラス破裂シミュレーション",
    relatedShockTitle: "熱衝撃＆破裂閾値シミュレーター →",
    relatedShockDesc: "大文字ホウケイ酸PYREX・小文字強化ソーダ石灰pyrex・陶器・ホーロー鍋の急冷破裂リスクを比較。",
    relatedScratchTag: "フッ素加工チェック",
    relatedScratchTitle: "フライパン傷＆劣化診断ツール →",
    relatedScratchDesc: "過熱や傷がついたテフロン加工フライパンの危険度と買い替え目安を診断できます。",
    hubsTitle: "家電別の安全ガイドを詳しく見る",
    hubsDescPrefix: "素材別の詳細ガイドとメーカー・ASTM規格に基づく検証基準はこちら：",
    methodologyLabel: "検証メソドロジー",
    hubLabels: {
      oven: "オーブン安全ガイド",
      airfryer: "ノンフライヤー安全ガイド",
      methodology: "メソドロジー",
      allTools: "全ツール一覧 →"
    },
    faqTitle: "調理器具のオーブン耐熱温度に関するよくある質問",
    faqs: [
      {
        question: "大文字「PYREX」と小文字「pyrex」でオーブン耐熱性能はどう違いますか？",
        answer: "大文字PYREX（欧州現行品・米国ヴィンテージ品）はホウケイ酸ガラス製で、260°C（500°F）かつ約165°Cの温度差に耐えます。一方、小文字pyrex（米国現行品など）は強化ソーダ石灰ガラスで上限218°C（425°F）、耐熱温度差も約50°Cと低いため急冷破損に注意が必要です。どちらもブロイラー不可です。"
      },
      {
        question: "ル・クルーゼの黒いツマミだけ耐熱温度が低いのはなぜですか？",
        answer: "ホーロー鋳鉄本体は260°C（500°F）対応ですが、旧クラシックモデルの黒フェノール樹脂ツマミは199°C（390°F）上限のため、230°Cのパン焼きなどでひび割れや異臭が生じます。シグニチャー樹脂ツマミは250°C、純正ステンレス製金属ツマミに付け替えればフタ付きのまま260°C（500°F）まで安全に使えます。"
      },
      {
        question: "HexCladや一般的なテフロン（PTFE）フライパンはブロイラーで使えますか？",
        answer: "いいえ、使用できません。ブロイラーの直火輻射熱は260〜288°C超に達し、PTFEコーティングの熱分解（小鳥に致命的な有毒ガス発生）やHexCladのノンスティック層損傷を引き起こします。なおHexCladの強化ガラスフタの上限は204°C（400°F）です。"
      },
      {
        question: "クッキングシートの代わりにワックスペーパーをオーブンで使っても大丈夫ですか？",
        answer: "絶対に使えません！ワックスペーパーは55°C前後で溶けるパラフィン蝋が塗られており、食品に溶け出すだけでなくオーブン庫内で激しく発煙・発火します。加熱調理にはシリコーン加工されたクッキングシート（215〜232°C上限・ブロイラー不可）を使用してください。"
      },
      {
        question: "素焼きのテラコッタ・クレイベーカーはなぜ冷たいオーブンから加熱するのですか？",
        answer: "多孔質の素焼き陶器は水に浸した水分を内部に含んでいます。220〜232°Cに予熱済みの庫内へいきなり入れると水分が急気化し内外の膨張差で割れてしまいます。15〜20分浸水させた後、必ず予熱なしの冷たいオーブンから徐々に232°C（450°F）まで上げてください。"
      }
    ],
    breadcrumbs: [
      { label: "ホーム", href: "/ja/" },
      { label: "ツール", href: "/ja/tools/" },
      { label: "オーブン耐熱温度チェッカー" }
    ]
  }
};

const c = CONTENT[lang as Exclude<SupportedLanguage, 'en'>] || CONTENT.es;
const localizedUrl = `https://isitkitchensafe.com/${lang}/tools/cookware-oven-temp-lookup/`;

const ovenUrl = getApplianceUrl('oven', lang);
const airfryerUrl = getApplianceUrl('airfryer', lang);
const toolsUrl = getDirectoryUrl('tools', lang);
const converterUrl = `/${lang}/tools/air-fryer-oven-converter/`;
const thermalShockUrl = `/${lang}/tools/thermal-shock-simulator/`;
const scratchUrl = `/${lang}/tools/pan-scratch-inspector/`;

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": c.h1,
  "url": localizedUrl,
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript.",
  "description": c.pageDescription,
  "inLanguage": lang === 'zh-cn' ? 'zh-CN' : lang,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": c.faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={c.pageTitle}
  description={c.pageDescription}
  excludeFaqSchema={true}
  availableLocales={availableLocales}
  lang={lang}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={c.breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1160px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-signature-coral text-white mb-3">
        {c.badge}
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        {c.h1}
      </h1>
      <p class="text-body text-[15px] md:text-[16px] leading-relaxed">
        {c.heroSub}
      </p>
    </header>

    <!-- Main Interactive Lookup Utility -->
    <div class="mb-14">
      <CookwareOvenTempLookup lang={lang} />
    </div>

    <!-- 3 High-Risk Oven Traps Strip -->
    <section class="mb-14 border-t border-hairline pt-12 space-y-6">
      <div class="max-w-3xl">
        <span class="text-xs font-bold uppercase tracking-wider text-signature-coral block mb-1">
          {c.trapsKicker}
        </span>
        <h2 class="text-title-lg font-medium text-ink tracking-tight">
          {c.trapsTitle}
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {c.traps.map((trap, i) => (
          <div class="p-5 rounded-2xl bg-surface-soft border border-hairline space-y-2">
            <div
              class:list={[
                'text-xs font-bold uppercase tracking-wider',
                i === 0
                  ? 'text-error dark:text-error-border'
                  : i === 1
                    ? 'text-warning dark:text-amber-300'
                    : 'text-info dark:text-info-border'
              ]}
            >
              {trap.tag}
            </div>
            <h3 class="text-title-sm font-semibold text-ink">{trap.title}</h3>
            <p class="text-[13px] text-body leading-relaxed">{trap.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Related Companion Tools -->
    <section class="mb-14 grid grid-cols-1 md:grid-cols-3 gap-5">
      <a
        href={converterUrl}
        class="p-5 rounded-2xl bg-surface-soft border border-hairline hover:border-signature-coral transition-all group block"
      >
        <span class="text-[11px] font-bold uppercase tracking-wider text-signature-coral block mb-1.5">
          {c.relatedConvTag}
        </span>
        <h2 class="text-title-sm font-semibold text-ink group-hover:text-signature-coral transition-colors mb-1.5">
          {c.relatedConvTitle}
        </h2>
        <p class="text-[13px] text-body leading-relaxed">
          {c.relatedConvDesc}
        </p>
      </a>

      <a
        href={thermalShockUrl}
        class="p-5 rounded-2xl bg-surface-soft border border-hairline hover:border-signature-coral transition-all group block"
      >
        <span class="text-[11px] font-bold uppercase tracking-wider text-signature-coral block mb-1.5">
          {c.relatedShockTag}
        </span>
        <h2 class="text-title-sm font-semibold text-ink group-hover:text-signature-coral transition-colors mb-1.5">
          {c.relatedShockTitle}
        </h2>
        <p class="text-[13px] text-body leading-relaxed">
          {c.relatedShockDesc}
        </p>
      </a>

      <a
        href={scratchUrl}
        class="p-5 rounded-2xl bg-surface-soft border border-hairline hover:border-signature-coral transition-all group block"
      >
        <span class="text-[11px] font-bold uppercase tracking-wider text-signature-coral block mb-1.5">
          {c.relatedScratchTag}
        </span>
        <h2 class="text-title-sm font-semibold text-ink group-hover:text-signature-coral transition-colors mb-1.5">
          {c.relatedScratchTitle}
        </h2>
        <p class="text-[13px] text-body leading-relaxed">
          {c.relatedScratchDesc}
        </p>
      </a>
    </section>

    <!-- Verified Appliance Hubs Strip -->
    <section class="mb-14 p-6 rounded-2xl bg-surface-soft border border-hairline">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <h2 class="text-title-sm font-semibold text-ink mb-1">
            {c.hubsTitle}
          </h2>
          <p class="text-[13px] text-muted">
            {c.hubsDescPrefix}{' '}
            <a href="/methodology/" class="text-link underline hover:text-link-active">{c.methodologyLabel}</a>.
          </p>
        </div>
        <div class="flex flex-wrap gap-2">
          <a href={ovenUrl} class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral transition-colors">{c.hubLabels.oven}</a>
          <a href={airfryerUrl} class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral transition-colors">{c.hubLabels.airfryer}</a>
          <a href="/methodology/" class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-canvas border border-hairline text-ink hover:border-signature-coral transition-colors">{c.hubLabels.methodology}</a>
          <a href={toolsUrl} class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-primary text-on-primary hover:bg-primary-active transition-colors">{c.hubLabels.allTools}</a>
        </div>
      </div>
    </section>

    <!-- FAQ Section (5 Consumer FAQs) -->
    <section class="mb-8">
      <h2 class="text-title-lg font-medium text-ink tracking-tight mb-6">
        {c.faqTitle}
      </h2>
      <div class="space-y-4">
        {c.faqs.map((faq) => (
          <details class="group p-5 bg-surface-soft border border-hairline rounded-xl" open>
            <summary class="text-title-sm font-semibold text-ink cursor-pointer list-none flex items-center justify-between gap-3">
              <span>{faq.question}</span>
              <span class="text-muted text-sm transition-transform group-open:rotate-180 shrink-0" aria-hidden="true">&#9662;</span>
            </summary>
            <p class="text-[14px] text-body leading-relaxed mt-3 pt-3 border-t border-hairline/70">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </div>
</Layout>
