---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import KitchenEnergyCarbonCalculator from '../../../components/KitchenEnergyCarbonCalculator.astro';
import type { SupportedLanguage } from '../../../i18n/ui';
import { useTranslations, useTranslatedPath } from '../../../i18n/utils';

export function getStaticPaths() {
  const availableLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'zh-cn', 'ja'];
  return [
    { params: { lang: 'es' }, props: { lang: 'es' as SupportedLanguage, availableLocales } },
    { params: { lang: 'pt' }, props: { lang: 'pt' as SupportedLanguage, availableLocales } },
    { params: { lang: 'zh-cn' }, props: { lang: 'zh-cn' as SupportedLanguage, availableLocales } },
    { params: { lang: 'ja' }, props: { lang: 'ja' as SupportedLanguage, availableLocales } }
  ];
}

interface Props {
  lang: SupportedLanguage;
  availableLocales: SupportedLanguage[];
}

const { lang, availableLocales } = Astro.props;
const t = useTranslations(lang);
const tp = useTranslatedPath(lang);

interface LocaleEnergyContent {
  pageTitle: string;
  pageDescription: string;
  badge: string;
  h1: string;
  heroSub: string;
  scienceTitle: string;
  scienceIntro: string;
  sciencePillars: Array<{ num: string; title: string; desc: string }>;
  faqs: Array<{ question: string; answer: string }>;
  breadcrumbs: Array<{ label: string; href?: string }>;
}

const CONTENT: Record<SupportedLanguage, LocaleEnergyContent> = {
  en: {} as any,
  es: {
    pageTitle: "Calculadora de Energía y Huella de Carbono en la Cocina | IsItKitchenSafe",
    pageDescription: "Calcula el consumo en kilovatios-hora (kWh), costos de electricidad, tiempos de cocción y huella de carbono entre inducción, freidora de aire, microondas, horno y gas.",
    badge: "Transferencia Térmica • Emisiones de Red • Normas DOE 10 CFR 430",
    h1: "Calculadora de Energía y Huella de Carbono en la Cocina",
    heroSub: "Descubre el consumo exacto en kilovatios-hora (kWh), tiempos de cocción y emisiones de gases de efecto invernadero entre placas de inducción, freidoras de aire, microondas y hornos convencionales. Calcula tu ahorro económico anual y reducción de huella climática.",
    scienceTitle: "La Física de la Energía Culinaria: Por qué se Desperdicia el 60% del Calor",
    scienceIntro: "La diferencia de eficiencia entre cocinar con inducción o con gas radica en tres principios termodinámicos fundamentales:",
    sciencePillars: [
      {
        num: "01",
        title: "Volumen de Cavidad y Masa Térmica",
        desc: "Calentar un horno estándar de 140 litros requiere calentar 45 kg de acero y esmalte antes de que el calor toque los alimentos. Una freidora de aire de 5 litros tiene un 96% menos de volumen y masa térmica mínima, reduciendo el precalentamiento a solo 2 minutos."
      },
      {
        num: "02",
        title: "Flujo Magnético frente a Llamas de Gas",
        desc: "Los quemadores de gas transfieren calor mediante corrientes de aire caliente que escapan alrededor de la sartén, aprovechando solo el 38% de la energía. La inducción genera calor por resistencia magnética dentro del propio fondo de la sartén, capturando el 88% de la energía."
      },
      {
        num: "03",
        title: "Rotación Molecular Dieléctrica",
        desc: "Los hornos convencionales calientan lentamente por conducción superficial. El microondas penetra 2-3 cm y hace oscilar las moléculas de agua 2.450 millones de veces por segundo, calentando el plato de forma casi instantánea y sin precalentamiento."
      }
    ],
    faqs: [
      {
        question: "¿Es una freidora de aire realmente más eficiente que un horno eléctrico tradicional?",
        answer: "Sí, con una enorme diferencia. Un horno convencional de 140 litros consume entre 2.500 y 3.500 W y requiere 15 minutos de precalentamiento. En cambio, una freidora de aire (1.600 W) calienta una cámara compacta de 5 litros en solo 2 minutos. Para raciones medianas o individuales, reduce el consumo de electricidad entre un 60% y un 75%."
      },
      {
        question: "¿Cuánta energía ahorra una placa de inducción frente a una cocina de gas?",
        answer: "La inducción tiene una eficiencia del 85% al 90%, frente al 38%-40% del gas. Más del 60% del calor del gas se disipa en el aire de la cocina. Además, la combustión de gas genera dióxido de nitrógeno (NO2) y partículas que contaminan el aire interior."
      },
      {
        question: "¿Lavar los platos a mano consume más energía que un lavavajillas moderno?",
        answer: "Sí, más del triple. Un lavavajillas ENERGY STAR lava una carga completa con 12 litros de agua y 1,15 kWh. Lavar esa misma cantidad a mano bajo el grifo caliente continuo consume entre 60 y 90 litros de agua caliente y hasta 3,6 kWh de energía del termo o calentador."
      },
      {
        question: "¿Por qué el microondas es el método más eficiente para recalentar comida?",
        answer: "Porque utiliza calentamiento dieléctrico directo sobre el agua y grasas de los alimentos. No hay cámara de aire ni bandejas pesadas que precalentar. Recalentar un plato toma 2,5 minutos (0,06 kWh) frente a los 25 minutos y 1,15 kWh que exigiría un horno convencional."
      }
    ],
    breadcrumbs: [
      { label: "Inicio", href: "/es/" },
      { label: "Herramientas", href: "/es/tools/" },
      { label: "Calculadora de Energía y Carbono" }
    ]
  },
  pt: {
    pageTitle: "Calculadora de Consumo Energético e Carbono em Eletrodomésticos | IsItKitchenSafe",
    pageDescription: "Calcule consumo em kWh, custos de energia, tempo de preparo e emissões de carbono entre indução, air fryer, micro-ondas, forno e fogão a gás.",
    badge: "Transferência Térmica • Emissões de Rede • Normas DOE 10 CFR 430",
    h1: "Calculadora de Consumo Energético e Carbono em Eletrodomésticos",
    heroSub: "Descubra o consumo exato em quilowatt-hora (kWh), tempos de cozimento e pegada de carbono entre cooktops por indução, air fryers, micro-ondas e fornos convencionais. Calcule sua economia na conta de luz e sua contribuição climática.",
    scienceTitle: "A Física da Energia na Cozinha: Por que 60% do Calor é Desperdiçado",
    scienceIntro: "A diferença no gasto energético entre diferentes aparelhos obedece a leis claras da termodinâmica:",
    sciencePillars: [
      {
        num: "01",
        title: "Volume da Cavidade e Massa Térmica",
        desc: "Aquecer um forno de 140 litros exige esquentar dezenas de quilos de metal e ar antes do alimento. Uma air fryer de 5 litros possui 96% menos ar para aquecer e atinge 200°C em apenas 2 minutos."
      },
      {
        num: "02",
        title: "Fluxo Magnético vs. Chama de Gás",
        desc: "O fogão a gás dissipa mais de 60% do calor pelas laterais da panela, atingindo apenas 39% de eficiência útil. A indução transfere 88% da energia diretamente para a base metálica da panela."
      },
      {
        num: "03",
        title: "Rotação Molecular Dielétrica",
        desc: "O micro-ondas vibra as moléculas polares de água dos alimentos 2,45 bilhões de vezes por segundo. Não há energia perdida aquecendo o ar da cavidade."
      }
    ],
    faqs: [
      {
        question: "A air fryer é realmente mais econômica que o forno elétrico tradicional?",
        answer: "Sim, expressivamente. Um forno tradicional puxa de 2.500 a 3.500 W e exige 15 minutos de pré-aquecimento. A air fryer (1.600 W) aquece em 2 minutos e economiza entre 60% e 75% de energia em porções pequenas e médias."
      },
      {
        question: "A indução é mais eficiente que o fogão a gás?",
        answer: "Sim. A indução atinge cerca de 88% de rendimento térmico, enquanto o fogão a gás aproveita apenas 39% do calor, além de emitir poluentes como dióxido de nitrogênio (NO2) no ambiente interno."
      },
      {
        question: "Lavar louça à mão gasta mais energia que a lava-louças?",
        answer: "Sim. Lavar louça sob torneira aberta com água aquecida consome de 60 a 90 litros de água e até 3,6 kWh. A lava-louças moderna gasta apenas 12 litros e 1,15 kWh para lavar até 14 jogos de pratos."
      }
    ],
    breadcrumbs: [
      { label: "Início", href: "/pt/" },
      { label: "Ferramentas", href: "/pt/tools/" },
      { label: "Calculadora de Energia e Carbono" }
    ]
  },
  'zh-cn': {
    pageTitle: "智能厨房电器能耗与碳足迹计算器 | IsItKitchenSafe",
    pageDescription: "精确对比电磁炉、空气炸锅、微波炉、电烤箱及燃气灶在烹饪过程中的耗电量（kWh）、烹饪耗时、折算电费及碳足迹。测算年度节能减排效益。",
    badge: "热力学传热 • 电网碳排放 • 美国 DOE 10 CFR 430 标准",
    h1: "智能厨房电器能耗与碳足迹计算器",
    heroSub: "掌握电磁炉、空气炸锅、微波炉、传统烤箱与燃气灶的真实千瓦时（kWh）耗能与碳排放量。即时测算您每年可节省的电费开支与减少的温室气体排放。",
    scienceTitle: "厨房能耗热力学原理解析：为何 60% 的热量被白白浪费",
    scienceIntro: "选择高效电炊具与高耗能电器的根本差异，取决于三大核心热力学规律：",
    sciencePillars: [
      {
        num: "01",
        title: "腔体容积与预热热容质量",
        desc: "大型 140 升家用烤箱在烹饪食物前，必须先加热数十公斤的钢体和空气，预热需 15 分钟。而 5 升空气炸锅容积缩小 96%，仅需 2 分钟即可升至 200°C。"
      },
      {
        num: "02",
        title: "电磁感应涡流 vs. 明火热对流外溢",
        desc: "燃气明火大部分热量沿锅底边缘散逸到空气中，热效率仅 39%。电磁炉直接在铁磁性锅底诱发涡流发热，热效率高达 88%，且完全无明火废气。"
      },
      {
        num: "03",
        title: "介电极性分子振动",
        desc: "微波炉利用 2.45 GHz 频率直接驱动食物中水分子高速旋转发热，无需加热腔体空气，热剩菜能耗仅为烤箱的十九分之一。"
      }
    ],
    faqs: [
      {
        question: "空气炸锅真的比普通电烤箱更省电吗？",
        answer: "是的，差距极其显著。普通大烤箱功率高达 3000W 且预热耗时 15 分钟；空气炸锅功率仅 1600W，腔体仅 5 升，加热单人或家庭中份菜肴可节省 60% 至 75% 的电量。"
      },
      {
        question: "电磁炉相比燃气灶能节省多少能源？",
        answer: "电磁炉的热效率高达 85%–90%，而燃气灶仅为 38%–40%。此外，燃气燃烧会在室内释放二氧化氮（NO2）和可吸入颗粒物，增加呼吸道疾病风险。"
      },
      {
        question: "用手洗碗是否比洗碗机消耗更多能源？",
        answer: "是的。在热水龙头下持续冲洗洗碗 15 分钟会消耗 60–80 升热水，折合热水器电耗达 3.6 kWh；而一级能效洗碗机仅需 12 升水和约 1.15 kWh 电量即可洗净全套碗碟。"
      }
    ],
    breadcrumbs: [
      { label: "首页", href: "/zh-cn/" },
      { label: "实用工具", href: "/zh-cn/tools/" },
      { label: "能耗与碳足迹计算器" }
    ]
  },
  ja: {
    pageTitle: "スマート調理家電エネルギー消費量＆カーボンフットプリント計算機 | IsItKitchenSafe",
    pageDescription: "IHクッキングヒーター、ノンフライヤー、電子レンジ、オーブン、ガスコンロの消費電力量（kWh）、調理時間、電気代、温室効果ガス排出量を精密比較。",
    badge: "熱力学エネルギー効率 • グリッド排出係数 • 米国DOE 10 CFR 430規格",
    h1: "スマート調理家電エネルギー消費量＆カーボンフットプリント計算機",
    heroSub: "IH、ノンフライヤー、電子レンジ、ガスコンロのキロワット時（kWh）消費量とCO2排出量をシミュレーション。最も省エネな調理器具を選択することで、年間の電気代削減額と脱炭素貢献度を即座に算出します。",
    scienceTitle: "調理熱力学の真実：なぜ熱エネルギーの60％が無駄になるのか",
    scienceIntro: "調理家電のエネルギー効率の違いは、熱伝達に関する3つの物理法則によって決まります：",
    sciencePillars: [
      {
        num: "01",
        title: "庫内容積と予熱による熱容量ロス",
        desc: "大型オーブン（140L）は食材を温める前に40kg以上の鋼鉄と空気を15分間予熱する必要があります。5Lのノンフライヤーなら容積が96％小さく、わずか2分で200℃に到達します。"
      },
      {
        num: "02",
        title: "磁界による直接発熱 vs ガス炎の熱拡散",
        desc: "ガス火は炎の周囲の空気を加熱して拡散するため、熱効率は約39％に留まります。IHは鍋底に直接渦電流を発生させ、88％の高効率で熱を伝達します。"
      },
      {
        num: "03",
        title: "マイクロ波誘電加熱",
        desc: "電子レンジは2.45GHzの電磁波で食材の水分子を直接振動させます。庫内の空気を温める必要がないため、おかずの温め直しならオーブンの19分の1の電力で完了します。"
      }
    ],
    faqs: [
      {
        question: "ノンフライヤーは通常のオーブンより本当に省エネですか？",
        answer: "はい、大幅に省エネです。通常のオーブンは3000Wの電力を消費し、予熱に15分かかります。ノンフライヤーは1600Wで庫内がコンパクトなため、少人数分の調理なら60〜75％の電力を削減できます。"
      },
      {
        question: "IHクッキングヒーターはガスコンロと比べてどれくらい効率的ですか？",
        answer: "IHの熱効率は85〜90％ですが、ガスコンロはわずか38〜40％です。さらにガス火は室内に二酸化窒素（NO2）を排出し、換気設備がないと室内空気を汚染します。"
      },
      {
        question: "食洗機を使う方が手洗いよりも省エネですか？",
        answer: "はい。給湯器の温水を流しながら手洗いすると60〜80Lのお湯と約3.6kWhのエネルギーを消費します。最新の省エネ食洗機なら約12Lの水と1.15kWhの電力でまとめて洗浄できます。"
      }
    ],
    breadcrumbs: [
      { label: "ホーム", href: "/ja/" },
      { label: "ツール一覧", href: "/ja/tools/" },
      { label: "エネルギー・CO2計算機" }
    ]
  }
};

const c = CONTENT[lang] || CONTENT.es;

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": c.h1,
  "url": `https://isitkitchensafe.com/${lang}/tools/kitchen-energy-carbon-calculator/`,
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "description": c.pageDescription,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};
---

<Layout title={c.pageTitle} description={c.pageDescription} faqs={c.faqs} availableLocales={availableLocales}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={c.breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1200px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-600 text-white mb-3">
        {c.badge}
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        {c.h1}
      </h1>
      <p class="text-body text-[15px] md:text-body-md leading-relaxed">
        {c.heroSub}
      </p>
    </header>

    <!-- Main Interactive Calculator Component -->
    <div class="mb-14">
      <KitchenEnergyCarbonCalculator lang={lang} />
    </div>

    <!-- Science Deep-Dive -->
    <section class="mb-14 border-t border-hairline pt-12 space-y-8">
      <div class="max-w-3xl">
        <span class="text-xs font-bold uppercase tracking-wider text-muted block mb-1">
          {c.scienceTitle}
        </span>
        <h2 class="text-title-lg md:text-display-sm font-medium text-ink tracking-tight mb-3">
          {c.scienceTitle}
        </h2>
        <p class="text-body text-[15px] leading-relaxed">
          {c.scienceIntro}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {c.sciencePillars.map(pillar => (
          <div class="p-6 rounded-2xl bg-surface-soft border border-hairline space-y-3">
            <div class="w-9 h-9 rounded-xl bg-emerald-600 text-white font-bold flex items-center justify-center text-sm">
              {pillar.num}
            </div>
            <h3 class="font-semibold text-ink text-base">{pillar.title}</h3>
            <p class="text-xs text-body leading-relaxed">
              {pillar.desc}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="border-t border-hairline pt-12">
      <h2 class="text-title-lg md:text-display-sm font-medium text-ink tracking-tight mb-8">
        FAQ
      </h2>
      <div class="space-y-6 max-w-3xl">
        {c.faqs.map(faq => (
          <div class="border-b border-hairline pb-6">
            <h3 class="text-base font-semibold text-ink mb-2">
              {faq.question}
            </h3>
            <p class="text-body text-sm leading-relaxed">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>
