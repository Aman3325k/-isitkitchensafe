---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import PlasticWaterKettleMicroplasticSimulator from '../../../components/PlasticWaterKettleMicroplasticSimulator.astro';
import rawData from '../../../data/plastic-water-kettle-microplastic-data.json';
import type { SupportedLanguage } from '../../../i18n/ui';

export function getStaticPaths() {
  const availableLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'zh-cn', 'ja'];
  return [
    { params: { lang: 'es' }, props: { lang: 'es' as SupportedLanguage, availableLocales } },
    { params: { lang: 'pt' }, props: { lang: 'pt' as SupportedLanguage, availableLocales } },
    { params: { lang: 'zh-cn' }, props: { lang: 'zh-cn' as SupportedLanguage, availableLocales } },
    { params: { lang: 'ja' }, props: { lang: 'ja' as SupportedLanguage, availableLocales } }
  ];
}

interface Props {
  lang: SupportedLanguage;
  availableLocales: SupportedLanguage[];
}

const { lang, availableLocales } = Astro.props;

interface LocalePageContent {
  pageTitle: string;
  pageDescription: string;
  badge: string;
  h1: string;
  heroSub: string;
  breadcrumbs: Array<{ label: string; href?: string }>;
  authorLabel: string;
  authorName: string;
  reviewerLabel: string;
  reviewerName: string;
  methodologyLabel: string;
  methodologyUrl: string;
}

const CONTENT: Record<Exclude<SupportedLanguage, 'en'>, LocalePageContent> = {
  es: {
    pageTitle: "Simulador de Microplásticos y Lixiviación en Hervidores de Plástico | IsItKitchenSafe",
    pageDescription: "Calcula el desprendimiento de microplásticos (part./L) y níquel en hervidores eléctricos de polipropileno por fatiga térmica, microfisuras y descalcificación con ácido. Datos Nature Food y OMS.",
    badge: "Estudio Nature Food (2020) · Guía de Níquel OMS · Reglamento UE 10/2011",
    h1: "Simulador de Microplásticos y Lixiviación en Hervidores Eléctricos",
    heroSub: "Protege la salud de tu familia al hervir agua: calcula la liberación masiva de microplásticos (de 1,3 a más de 16 millones de partículas por litro) y la lixiviación de metales pesados provocada por microfisuras en el plástico y descalcificación agresiva.",
    breadcrumbs: [
      { label: "Inicio", href: "/es/" },
      { label: "Herramientas", href: "/es/tools/" },
      { label: "Simulador de Microplásticos en Hervidores" }
    ],
    authorLabel: "Autor:",
    authorName: "Marcus Vance (Analista de Materiales)",
    reviewerLabel: "Revisión Científica:",
    reviewerName: "Dra. Elena Rostova, Ph.D.",
    methodologyLabel: "Metodología y Normativa",
    methodologyUrl: "/es/methodology/"
  },
  pt: {
    pageTitle: "Simulador de Microplásticos e Lixiviação em Chaleiras Plásticas | IsItKitchenSafe",
    pageDescription: "Calcule a liberação de partículas de microplásticos (part./L) e níquel em chaleiras elétricas de polipropileno por desgaste térmico, microfissuras e descalcificação ácida. Base Nature Food e OMS.",
    badge: "Estudo Nature Food (2020) · Diretrizes de Níquel OMS · Regulamento UE 10/2011",
    h1: "Simulador de Microplásticos e Lixiviação em Chaleiras Elétricas",
    heroSub: "Água pura e segura para o dia a dia: calcule a liberação de milhões de microplásticos e lixiviação de metais pesados decorrentes de fadiga térmica em chaleiras de polipropileno, microfissuras internas e limpeza ácida.",
    breadcrumbs: [
      { label: "Início", href: "/pt/" },
      { label: "Ferramentas", href: "/pt/tools/" },
      { label: "Simulador de Microplásticos em Chaleiras" }
    ],
    authorLabel: "Autor:",
    authorName: "Marcus Vance (Analista de Materiais)",
    reviewerLabel: "Revisão Científica:",
    reviewerName: "Dra. Elena Rostova, Ph.D.",
    methodologyLabel: "Metodologia e Normas",
    methodologyUrl: "/pt/methodology/"
  },
  'zh-cn': {
    pageTitle: "塑料电热水壶微塑料脱落与发热底重金属溶出模拟器 | IsItKitchenSafe",
    pageDescription: "科学测算聚丙烯电水壶在100°C反复沸腾热应力下的微塑料颗粒脱落量（数百万粒/升）及酸洗除垢导致的重金属镍溶出峰值。基于《自然·食品》(Nature Food 2020) 与世卫组织标准。",
    badge: "《自然·食品》(Nature Food 2020) · 世卫组织 WHO 饮用水准则 · 欧盟 10/2011 法规",
    h1: "塑料电热水壶微塑料脱落与发热盘重金属溶出模拟器",
    heroSub: "透视水壶隐形健康隐患：精准测算聚丙烯 (PP 5号) 水壶因长期冷热交替产生的内壁微裂纹 (craze-cracking)、剧烈沸腾热剪切脱落以及酸洗除水垢对发热盘钝化膜的腐蚀影响，掌握健康饮水准则。",
    breadcrumbs: [
      { label: "首页", href: "/zh-cn/" },
      { label: "安全工具", href: "/zh-cn/tools/" },
      { label: "塑料电水壶微塑料溶出模拟器" }
    ],
    authorLabel: "作者：",
    authorName: "Marcus Vance（材料工程分析师）",
    reviewerLabel: "科学审校：",
    reviewerName: "Elena Rostova 博士",
    methodologyLabel: "评估方法与法规",
    methodologyUrl: "/zh-cn/methodology/"
  },
  ja: {
    pageTitle: "電気ケトルのマイクロプラスチック放出・ニッケル溶出シミュレーター | IsItKitchenSafe",
    pageDescription: "ポリプロピレン製ケトルの熱疲労クラック、沸騰によるマイクロプラスチック放出（100万〜1600万個/L）およびクエン酸洗浄直後のニッケル溶出量を科学的モデルで算出。Nature Food＆WHO基準準拠。",
    badge: "Nature Food（2020）論文 · WHO飲料水ニッケル指針 · EU食品接触規則 10/2011",
    h1: "電気ケトルのマイクロプラスチック放出・重金属溶出シミュレーター",
    heroSub: "毎日の湯沸かしの安全性を検証：ポリプロピレン樹脂（PP #5）の熱サイクルによる微小クラック、100°C沸騰によるサブミクロン樹脂破片の脱落、および酸洗浄後の金属溶出リスクを科学的に算出します。",
    breadcrumbs: [
      { label: "ホーム", href: "/ja/" },
      { label: "ツール一覧", href: "/ja/tools/" },
      { label: "ケトル微小プラスチック溶出シミュレーター" }
    ],
    authorLabel: "著者：",
    authorName: "マーカス・ヴァンス（材料分析アナリスト）",
    reviewerLabel: "科学監修：",
    reviewerName: "エレナ・ロストヴァ博士",
    methodologyLabel: "検証基準と根拠",
    methodologyUrl: "/ja/methodology/"
  }
};

const current = CONTENT[lang as Exclude<SupportedLanguage, 'en'>] || CONTENT.es;
const faqs = (rawData.faqs as any)[lang] || rawData.faqs.en;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": current.breadcrumbs[0].label,
      "item": new URL(current.breadcrumbs[0].href || `/${lang}/`, 'https://isitkitchensafe.com').href
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": current.breadcrumbs[1].label,
      "item": new URL(current.breadcrumbs[1].href || `/${lang}/tools/`, 'https://isitkitchensafe.com').href
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": current.breadcrumbs[2].label,
      "item": `https://isitkitchensafe.com/${lang}/tools/plastic-water-kettle-microplastic-simulator/`
    }
  ]
};

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": current.h1,
  "url": `https://isitkitchensafe.com/${lang}/tools/plastic-water-kettle-microplastic-simulator/`,
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "description": current.pageDescription,
  "inLanguage": lang,
  "isAccessibleForFree": true,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com",
    "logo": {
      "@type": "ImageObject",
      "url": "https://isitkitchensafe.com/favicon.svg"
    }
  },
  "author": {
    "@type": "Person",
    "name": "Marcus Vance",
    "jobTitle": "Lead Hardware & Materials Analyst",
    "url": "https://isitkitchensafe.com/about/#editorial-board",
    "sameAs": "https://isitkitchensafe.com/about/",
    "affiliation": {
      "@type": "Organization",
      "name": "IsItKitchenSafe",
      "url": "https://isitkitchensafe.com"
    }
  },
  "reviewedBy": {
    "@type": "Person",
    "name": "Dr. Elena Rostova",
    "jobTitle": "Food Toxicology & Storage Contributor",
    "honorificPrefix": "Dr.",
    "url": "https://isitkitchensafe.com/about/#editorial-board",
    "sameAs": "https://isitkitchensafe.com/about/",
    "affiliation": {
      "@type": "Organization",
      "name": "IsItKitchenSafe",
      "url": "https://isitkitchensafe.com"
    }
  },
  "citation": [
    {
      "@type": "ScholarlyArticle",
      "name": "Microplastic release from the degradation of polypropylene feeding bottles and water kettles during infant formula preparation and water boiling",
      "headline": "Microplastic release from polypropylene feeding bottles and water kettles",
      "author": {
        "@type": "Organization",
        "name": "Nature Food (2020)"
      },
      "url": "https://www.nature.com/articles/s43016-020-00171-y",
      "datePublished": "2020-10-19"
    },
    {
      "@type": "ScholarlyArticle",
      "name": "Guidelines for Drinking-water Quality - Nickel Guidance Level",
      "headline": "World Health Organization Nickel in Drinking-water Evaluation",
      "author": {
        "@type": "Organization",
        "name": "World Health Organization (WHO)"
      },
      "url": "https://www.who.int/publications/i/item/9789240045064"
    },
    {
      "@type": "Legislation",
      "name": "Commission Regulation (EU) No 10/2011 on plastic materials and articles intended to come into contact with food",
      "legislationIdentifier": "Regulation (EU) No 10/2011",
      "legislationPassedBy": {
        "@type": "Organization",
        "name": "European Commission"
      },
      "url": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX%3A32011R0010"
    }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq: any) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={current.pageTitle}
  description={current.pageDescription}
  faqs={faqs}
  excludeFaqSchema={true}
  excludeBreadcrumbSchema={true}
  availableLocales={availableLocales}
  lang={lang}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1 print:hidden">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6">
      <Breadcrumbs items={current.breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1140px] mx-auto px-4 sm:px-6 py-8 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-signature-coral text-white mb-3">
        {current.badge}
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        {current.h1}
      </h1>
      <p class="text-body text-[15px] md:text-[16px] leading-relaxed">
        {current.heroSub}
      </p>

      <!-- E-E-A-T Author, Scientific Review & Regulatory Citations Byline -->
      <div class="mt-5 flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-xs text-muted border-t border-hairline/60 pt-4 max-w-2xl mx-auto">
        <span class="inline-flex items-center gap-1.5">
          <span class="font-semibold text-ink">{current.authorLabel}</span> {current.authorName}
        </span>
        <span class="text-hairline" aria-hidden="true">&bull;</span>
        <span class="inline-flex items-center gap-1.5">
          <span class="font-semibold text-ink">{current.reviewerLabel}</span> {current.reviewerName}
        </span>
        <span class="text-hairline" aria-hidden="true">&bull;</span>
        <a href={current.methodologyUrl} class="text-link underline hover:text-link-active transition-colors">
          {current.methodologyLabel}
        </a>
      </div>
    </header>

    <!-- Main Interactive Simulator Component -->
    <PlasticWaterKettleMicroplasticSimulator lang={lang} />
  </div>
</Layout>
