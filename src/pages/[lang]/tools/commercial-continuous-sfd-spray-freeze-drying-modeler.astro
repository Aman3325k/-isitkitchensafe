---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CommercialContinuousSfdSprayFreezeDryingModeler from '../../../components/CommercialContinuousSfdSprayFreezeDryingModeler.astro';
import type { SupportedLanguage } from '../../../i18n/ui';
import { useTranslations, useTranslatedPath } from '../../../i18n/utils';

export function getStaticPaths() {
  const availableLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'zh-cn', 'ja'];
  return [
    { params: { lang: 'es' }, props: { lang: 'es' as SupportedLanguage, availableLocales } },
    { params: { lang: 'pt' }, props: { lang: 'pt' as SupportedLanguage, availableLocales } },
    { params: { lang: 'zh-cn' }, props: { lang: 'zh-cn' as SupportedLanguage, availableLocales } },
    { params: { lang: 'ja' }, props: { lang: 'ja' as SupportedLanguage, availableLocales } }
  ];
}

interface Props {
  lang: SupportedLanguage;
  availableLocales: SupportedLanguage[];
}

const { lang, availableLocales } = Astro.props;
const t = useTranslations(lang);
const tp = useTranslatedPath(lang);

interface LocaleToolContent {
  pageTitle: string;
  pageDescription: string;
  badge: string;
  h1: string;
  lead: string;
  breadcrumbsLabel: string;
  faqs: Array<{ question: string; answer: string }>;
}

const CONTENT: Record<Exclude<SupportedLanguage, 'en'>, LocaleToolContent> = {
  es: {
    pageTitle: "Simulador Continuo de Liofilización por Aspersión Asistida por CO2 Supercrítico (SFD) | IsItKitchenSafe",
    pageDescription: "Simule la liofilización continua por aspersión asistida por CO2 supercrítico (scCO2-SFD) para la producción sin desnaturalización de probióticos vivos, enzimas y nutrientes bioactivos, prevención del colapso vítreo y cumplimiento de las normas 3-A 45-03 y 74-07.",
    badge: "Criogenia Supercrítica y Liofilización por Aspersión Aséptica",
    h1: "Simulador Continuo de Liofilización por Aspersión Asistida por CO2 Supercrítico (SFD)",
    lead: "Herramienta de simulación de ingeniería para microatomización efervescente por scCO2, vitrificación criogénica ultrarrápida y sublimación al vacío continua sin daño celular ni colapso de torta.",
    breadcrumbsLabel: "Simulador Continuo scCO2-SFD de Liofilización",
    faqs: [
      {
        question: "¿Cómo evita la liofilización por aspersión con CO2 supercrítico (SFD) la desnaturalización térmica de proteínas y probióticos?",
        answer: "El secado por aspersión convencional con aire caliente expone las formulaciones a temperaturas de 160–200°C a la entrada y 75–90°C a la salida, lo que rompe los enlaces de hidrógeno y destruye las membranas bacterianas (>70% de mortandad). En cambio, el proceso scCO2-SFD opera enteramente a baja temperatura: el CO2 supercrítico se disuelve a solo 32–36°C y 100–180 bar. Al expandirse en un penacho criogénico (-120°C a -196°C), la efervescencia pulveriza el líquido en microgotas finas (10–25 µm) que se vitrifican a más de 10.000 K/s. La sublimación posterior al vacío (0,05–0,15 mbar) a temperaturas de estante bajo cero elimina el agua directamente del hielo a vapor, preservando más del 98% de viabilidad biológica sin daño térmico alguno."
      },
      {
        question: "¿Cuál es el mecanismo termodinámico de la microatomización efervescente con CO2 supercrítico?",
        answer: "La atomización efervescente (SAA / SAS-SFD) aprovecha la alta solubilidad del CO2 en disoluciones acuosas a presiones supercríticas. Al cruzar una microtobera hacia una cámara a baja presión, la brusca caída de presión desencadena una nucleación explosiva de millones de microburbujas de CO2. Con una relación de expansión volumétrica superior a 300:1, el chorro líquido se fractura desde su interior en microgotas monodispersas de diámetro medio Sauter de 10 a 25 µm sin los intensos esfuerzos de cizalla que romperían bicapas lipídicas o desdoblarían enzimas."
      },
      {
        question: "¿Por qué es crucial la vitrificación criogénica ultrarrápida para evitar cristales de hielo lesivos?",
        answer: "En la liofilización convencional estática en bandejas, el enfriamiento lento (0,1 a 1,0 K/min) permite el crecimiento de cristales de hielo hexagonales grandes y afilados que perforan las membranas celulares y provocan crioconcentración desnaturalizante. En el sistema scCO2-SFD, al introducir microgotas en nitrógeno líquido, la velocidad de enfriamiento supera los 10.000 a 20.000 K/s, vitrificando el agua en hielo amorfo sin cristales destructivos. Al sublimar, deja una matriz mesoporosa en panal con área superficial de 80–115 m²/g que se disuelve instantáneamente en agua fría en menos de 4 segundos."
      },
      {
        question: "¿Cómo previene el control de la temperatura de transición vítrea (Tg') el colapso de la torta liofilizada?",
        answer: "Cada formulación posee una temperatura de transición vítrea de la fase amorfa concentrada (Tg'), habitualmente entre -34°C y -24°C. Si la temperatura del frente de sublimación supera Tg' debido a un vacío insuficiente o calor excesivo, la viscosidad cae abruptamente de 10^12 Pa·s a 10^7 Pa·s, provocando el colapso de los poros y la fusión del producto. El simulador evalúa en tiempo real el margen de seguridad ΔT_margin = Tg' - Tp, exigiendo un margen superior a +2,0°C para certificar la integridad estructural."
      },
      {
        question: "¿Cómo cumple el equipo continuo scCO2-SFD con las normas 3-A 45-03, 74-07 y EHEDG Clase I?",
        answer: "Todas las superficies en contacto con el producto se fabrican en acero inoxidable AISI 316L electropulido (Ra ≤ 0,38 µm) o Hastelloy C-276, completamente lavables por CIP y esterilizables por SIP (121°C, 30 min). Los sellos criogénicos son de PEEK y FFKM virgen certificados por FDA 21 CFR § 177. El túnel de vacío emplea accionamiento magnético hermético sin lubricantes mecánicos y el circuito de recuperación de CO2 integra filtros esterilizantes de PTFE de 0,2 µm y discos de ruptura ASME Sección VIII."
      }
    ]
  },
  pt: {
    pageTitle: "Simulador Contínuo de Liofilização por Aspersão Assistida por CO2 Supercrítico (SFD) | IsItKitchenSafe",
    pageDescription: "Simule a liofilização contínua por aspersão assistida por CO2 supercrítico (scCO2-SFD) para produção sem desnaturação de probióticos vivos, enzimas e nutrientes bioativos, prevenção do colapso vítreo e conformidade com as normas 3-A 45-03 e 74-07.",
    badge: "Criogenia Supercrítica e Liofilização por Aspersão Asséptica",
    h1: "Simulador Contínuo de Liofilização por Aspersão Assistida por CO2 Supercrítico (SFD)",
    lead: "Ferramenta de engenharia para microatomização efervescente por scCO2, vitrificação criogênica ultrarrápida e sublimação contínua a vácuo com retenção de atividade biológica superior a 98%.",
    breadcrumbsLabel: "Simulador Contínuo scCO2-SFD de Liofilização",
    faqs: [
      {
        question: "Como a liofilização por aspersão com CO2 supercrítico (SFD) previne a desnaturação de proteínas e probióticos?",
        answer: "A secagem por atomização tradicional expõe os produtos a ar quente (160–200°C), quebrando pontes de hidrogênio e matando mais de 70% das bactérias probióticas. O processo scCO2-SFD dissolve CO2 supercrítico a apenas 32–36°C e 100–180 bar. Ao expandir em câmara criogênica (-120°C a -196°C), a efervescência quebra o líquido em microgotas (10–25 µm) que se vitrificam a mais de 10.000 K/s. A subsequente sublimação a alto vácuo (0,05–0,15 mbar) elimina o gelo diretamente para vapor sob temperaturas negativas, preservando mais de 98% da bioatividade."
      },
      {
        question: "Qual é o mecanismo termodinâmico da microatomização efervescente com CO2 supercrítico?",
        answer: "A atomização efervescente utiliza o CO2 supercrítico dissolvido na fase aquosa. Ao passar por um micro-orifício de descompressão, a queda súbita de pressão causa nucleação de microbolhas de CO2 com taxa de expansão superior a 300:1, desintegrando o jato líquido de dentro para fora em microgotas monodispersas sem cisalhamento prejudicial."
      },
      {
        question: "Por que a vitrificação criogênica ultrarrápida é essencial para a estrutura mesoporosa do pó?",
        answer: "Na liofilização convencional lenta, formam-se grandes cristais de gelo que perfuram membranas celulares. No scCO2-SFD, a taxa de resfriamento atinge 10.000 a 20.000 K/s, transformando a água em gelo amorfo vítreo. Ao sublimar no túnel a vácuo, resta uma matriz em colmeia mesoporosa com área de 80–115 m²/g, proporcionando reconstituição instantânea em água fria em menos de 4 segundos."
      },
      {
        question: "Como o controle da temperatura de transição vítrea (Tg') impede o colapso estrutural da torta?",
        answer: "A torta de liofilização possui uma temperatura de transição vítrea (Tg') típica entre -34°C e -24°C. Se a temperatura do produto ultrapassar a Tg', a matriz perde rigidez e colapsa, retendo umidade e inativando enzimas. O modelo calcula a margem ΔT_margin = Tg' - Tp, exigindo pelo menos +2,0°C de folga segura."
      },
      {
        question: "Como o skid contínuo cumpre as exigências 3-A 45-03, 74-07 e EHEDG Classe I?",
        answer: "As partes molhadas utilizam aço AISI 316L eletropolido (Ra ≤ 0,38 µm) e Hastelloy C-276, com sanitização CIP/SIP automática. A esteira de vácuo opera com acoplamento magnético estéril sem óleo lubrificante e o circuito de CO2 reutiliza mais de 96% do gás através de filtros esterilizantes de PTFE de 0,2 µm."
      }
    ]
  },
  'zh-cn': {
    pageTitle: "工业连续超临界二氧化碳辅助喷雾冷冻干燥（SFD）模拟器 | IsItKitchenSafe",
    pageDescription: "精确模拟基于超临界CO2起泡微雾化、深冷瞬态玻璃化与连续真空低温升华干燥的工业化无菌工艺，杜绝活菌与活性蛋白质热变性，防止玻璃化塌陷，全面符合 3-A 45-03/74-07 与 EHEDG Class I 标准。",
    badge: "超临界低温微粉化与无菌喷雾冷冻干燥工程",
    h1: "工业连续超临界二氧化碳辅助喷雾冷冻干燥（SFD）模拟器",
    lead: "面向益生菌活菌制剂、初乳免疫球蛋白、热敏蛋白酶与脂质体纳米微球无损干燥的高精度热力学与低温升华仿真平台。",
    breadcrumbsLabel: "连续 scCO2-SFD 喷雾冷冻干燥模拟器",
    faqs: [
      {
        question: "超临界CO2辅助喷雾冷冻干燥（SFD）如何彻底杜绝热变性并保护益生菌存活率？",
        answer: "传统热风喷雾干燥的进风温度高达 160–200°C，排风温度达 75–90°C，高温破坏蛋白质氢键与三维构象，导致益生菌细胞膜破裂，死亡率超过 70%。scCO2-SFD 技术则完全在常温及深冷真空下运行：超临界CO2在 32–36°C 和 100–180 bar 下溶解于料液中；经同轴微孔喷出进入 -120°C 至 -196°C 液氮深冷区时，CO2瞬间汽化起泡将液滴粉碎至 10–25 µm，降温速率突破 10,000 K/s，水分子瞬间玻璃化锁定。后续在 0.05–0.15 mbar 的高真空隧道中，冰晶直接升华为水蒸气，全程物料温度严格处于零下，热变性焓变 ΔH_denat = 0，益生菌存活率保持在 98% 以上。"
      },
      {
        question: "超临界CO2起泡微雾化（Effervescent Atomization）的热力学原理是什么？",
        answer: "在超临界状态（临界点 31.1°C，73.8 bar）下，超临界CO2对水相原料具有良好的溶解渗透性。当高压气液混合物通过微米级孔径（100–250 µm）喷嘴泄压喷出时，压力骤降引发微秒级爆发式相变成核，CO2产生超过 300:1 的体积膨胀，从液体内部将射流爆破为索特平均粒径（D32）仅 10–25 µm 的超细单分散微滴。这一过程完全规避了传统高压两流体喷嘴的高速气流剪切应力，保护了脆弱的脂质体双分子层与酶催化中心。"
      },
      {
        question: "为什么超高速深冷玻璃化能够避免冰晶刺破细胞膜并赋予微粉速溶特性？",
        answer: "传统托盘冷冻干燥降温极其缓慢（0.1–1.0 K/min），水分子有充足时间结晶为大尺寸六角形树枝状冰晶（Ih），尖锐晶面刺破菌体质膜并引发冷冻浓缩盐析失活。scCO2-SFD 将微滴直接喷入液氮环境，对流传热系数突破 1,500 W/m²·K，降温速率达 10,000 至 20,000 K/s，直接越过成核生长区形成无定形玻璃态冰。微晶升华后留下高孔隙度连续贯通的蜂窝状介孔骨架，比表面积高达 80–115 m²/g，冷水复溶可在 4 秒内迅速完成。"
      },
      {
        question: "升华干燥阶段如何通过控制玻璃化转变温度（Tg'）防止产品结构塌陷？",
        answer: "脱水物料具有特定的最大冻结浓缩相玻璃化转变温度（Tg'），通常在 -34°C 至 -24°C。若升华真空过差或加热板温度过高导致升华前沿温度（Tp）超过 Tg'，物料粘度会由 10^12 Pa·s 骤降至 10^7 Pa·s，孔壁软化塌陷（Meltback），封闭残余水分并使酶分子失活。模拟器实时监控安全裕度 ΔT_margin = Tg' - Tp，保持裕度大于 +2.0°C 以确保微孔结构稳定。"
      },
      {
        question: "工业级连续 scCO2-SFD 系统如何符合 3-A 45-03、74-07 与 EHEDG Class I 无菌卫生标准？",
        answer: "物料接触部位全部采用电解抛光 AISI 316L 不锈钢（表面粗糙度 Ra ≤ 0.38 µm）或哈氏合金 C-276，具备全自动 CIP/SIP（121°C 纯蒸汽灭菌）功能；超低温动密封采用符合 FDA 21 CFR § 177 的原生 PEEK 与全氟醚橡胶（FFKM）；真空传送带采用磁力耦合无油传动，闭环 CO2 回收管路配备 0.2 µm 级双级除菌疏水滤芯与 ASME 爆破保护装置，杜绝交叉污染风险。"
      }
    ]
  },
  ja: {
    pageTitle: "商業用連続式超臨界CO2アシストスプレーフリーズドライ（SFD）シミュレーター | IsItKitchenSafe",
    pageDescription: "超臨界CO2発泡微粒化、極低温急速ガラス化、および連続真空昇華凍結乾燥を統合解析。熱失活性プロバイオティクス・酵素・生理活性ペプチドの非加熱製造、凍結ケーキ崩壊防止、および 3-A 45-03/74-07 衛生規格適合性をシミュレート。",
    badge: "超臨界極低温微粒化＆無菌スプレーフリーズドライ工学",
    h1: "商業用連続式超臨界CO2アシストスプレーフリーズドライ（SFD）シミュレーター",
    lead: "プロバイオティクス活菌・初乳抗体・食品酵素の完全非加熱乾燥、微小液滴急速ガラス化動力学、真空昇華熱制御、および無菌サニタリー設計を行う産業シミュレーションプラットフォーム。",
    breadcrumbsLabel: "連続 scCO2-SFD 凍結乾燥シミュレーター",
    faqs: [
      {
        question: "超臨界CO2スプレーフリーズドライ（SFD）はどのようにしてタンパク質の熱変性を完全に防ぎますか？",
        answer: "従来の熱風噴霧乾燥は 160〜200°C の高温熱風を使用するため、水素結合が破壊され、生菌の 70% 以上が死滅します。scCO2-SFD は完全な低温プロセスです。超臨界CO2をわずか 32〜36°C、100〜180 bar で原料液に溶解させ、-120°C〜-196°C の極低温ゾーンに噴射。発泡膨張により 10〜25 µm の均一微小液滴となり、毎秒 10,000 K を超える超急冷によりガラス化します。続く 0.05〜0.15 mbar の真空トンネル内で氷が直接水蒸気に昇華するため、熱変性はゼロ（ΔH_denat = 0）となり、98% 以上の菌生存率を達成します。"
      },
      {
        question: "超臨界CO2発泡微粒化（Effervescent Atomization）の熱力学的原理は何ですか？",
        answer: "超臨界CO2は水性溶液への高い溶解度を有します。同軸微細ノズル（100〜250 µm）を通過して減圧される際、CO2が爆発的に気化核生成を起こし、300倍以上の体積膨張力によって液流を内部から均一微小液滴へと破砕します。剪断応力が極めて小さいため、繊細な酵素活性部位やリポソーム膜構造を傷つけません。"
      },
      {
        question: "なぜ極低温超急冷ガラス化が氷晶による細胞破壊を防ぎ、速溶性を生み出すのですか？",
        answer: "通常の棚段凍結乾燥は冷却が遅いため（0.1〜1.0 K/min）、巨大な針状氷結晶が成長して細胞膜を突き破ります。scCO2-SFD は液滴を直接極低温冷媒に噴霧するため、冷却速度は 10,000〜20,000 K/s に達し、氷結晶が成長する前にアモルファスガラス状に凍結します。真空昇華後は比表面積 80〜115 m²/g のメソ多孔質ハニカム構造が形成され、冷水への再溶解は 4 秒以内に完了します。"
      },
      {
        question: "一次昇華工程におけるガラス転移崩壊温度（Tg'）の制御機構はどのようなものですか？",
        answer: "凍結濃縮相には固有のガラス転移温度（Tg'、通常 -34°C〜-24°C）が存在します。昇華前線温度が Tg' を超えると粘度が 10^12 Pa·s から 10^7 Pa·s へ急減し、細孔構造が崩壊（ケーキコラプス）して水分が閉じ込められます。シミュレーターは ΔT_margin = Tg' - Tp を常時監視し、+2.0°C 以上の安全マージンを維持します。"
      },
      {
        question: "本装置は 3-A 45-03、74-07 および EHEDG Class I 無菌サニタリー基準にどのように適合していますか？",
        answer: "全接液部は電解研磨 AISI 316L（Ra ≤ 0.38 µm）または Hastelloy C-276 製で、自動 CIP/SIP（121°C 純粋蒸気滅菌）に対応。極低温シールには FDA 21 CFR § 177 適合の PEEK および FFKM を採用し、真空ベルトコンベアは無給油磁気カップリング駆動、CO2循環系には 0.2 µm PTFE 除菌フィルターを備えて無菌性を担保しています。"
      }
