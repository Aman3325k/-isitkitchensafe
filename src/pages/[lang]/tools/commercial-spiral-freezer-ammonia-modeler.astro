        question: "二段階アンモニアガス検知 (25 ppm レベル1 vs 150 ppm レベル2) の自動遮断シーケンスは？",
        answer: "25 ppm (レベル1監視警報) 到達時は警報を発して排風機を低速運転します。150 ppm (レベル2緊急遮断警報) に達すると、PLCが主液電磁弁をミリ秒単位で緊急遮断し、排風機を100%全開駆動にしてドラムモーターを停止させます。"
      },
      {
        question: "フィン間の着霜架橋閉塞が空気側静圧損失を急上昇させファンを失速させる原因は？",
        answer: "着霜厚さがフィンピッチの 50% (>4.5 mm) を超えると、空気の流路面積が激減します。静圧損失は 140 Pa から 720 Pa 以上へと跳ね上がり、軸流ファンは限界圧力を超えて気流剥離失速に陥り、ファンモーターの焼損や冷却不良を引き起こします。"
      }
    ],
    scienceTitle1: "着霜フーリエ熱伝導動力学と総括伝熱係数 U の暴落",
    scienceText1: "急速凍結は -38°Cの高速冷気と食品との熱交換により成立します。着霜による熱抵抗層の成長は、蒸発器全体の冷却能力を致命的に損ないます。",
    box1Title: "蒸発器総熱抵抗方程式",
    box1Text: "R_total = (1 / h_int) + (x_管 / k_金属) + (x_霜 / k_霜) + (1 / h_ext)",
    box2Title: "総括伝熱係数 U 低下モデル",
    box2Text: "U = 1 / R_total ≈ 1 / [ (1 / U_清浄) + (x_霜 / k_霜) ]",
    scienceTitle2: "除霜水撃衝撃波と IIAR 2 非常換気動力学",
    scienceText2: "高温ガスの急激注入による凝縮崩壊水撃圧は配管の疲労強度を容易に突破します。法令基準を満たす非常換気が作業員の生命を守る防波堤となります。",
    box3Title: "Joukowsky水撃衝撃圧と熱膨張応力",
    box3Text: "ΔP_shock = ρ_液 · c_音 · Δv_液塞  |  σ_熱 = E · α · ΔT",
    box4Title: "IIAR 2 法定非常排気風量計算式",
    box4Text: "Q = 20 · √G  [CFM]  (G は充填アンモニアのポンド数)"
  }
};

const content = CONTENT[lang as Exclude<SupportedLanguage, 'en'>];

const breadcrumbs = [
  { label: t('nav.home') || 'Home', href: tp('/') },
  { label: t('nav.tools') || 'Tools', href: tp('/tools/') },
  { label: content.breadcrumbsLabel }
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": content.h1,
      "url": `https://isitkitchensafe.com/${lang}/tools/commercial-spiral-freezer-ammonia-modeler/`,
      "applicationCategory": "EngineeringApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5 Canvas/CSS3.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": content.pageDescription
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": t('nav.home') || 'Home',
          "item": `https://isitkitchensafe.com${tp('/')}`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": t('nav.tools') || 'Tools',
          "item": `https://isitkitchensafe.com${tp('/tools/')}`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": content.breadcrumbsLabel,
          "item": `https://isitkitchensafe.com/${lang}/tools/commercial-spiral-freezer-ammonia-modeler/`
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": content.faqs.map(f => ({
        "@type": "Question",
        "name": f.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": f.answer
        }
      }))
    }
  ]
};
---

<Layout
  title={content.pageTitle}
  description={content.pageDescription}
  structuredData={structuredData}
>
  <main class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
    <Breadcrumbs items={breadcrumbs} />

    <header class="mb-8 mt-4">
      <div class="flex items-center gap-2 mb-2">
        <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-cyan-100 text-cyan-800">
          {content.badge}
        </span>
        <span class="text-xs text-muted font-mono">ANSI/IIAR 2-2021 &bull; OSHA 29 CFR 1910.119 &bull; ASME B31.5 &bull; EPA RMP</span>
      </div>
      <h1 class="text-display-sm sm:text-display font-semibold text-ink tracking-tight mb-3">
        {content.h1}
      </h1>
      <p class="text-body-lg text-muted max-w-4xl leading-relaxed">
        {content.lead}
      </p>
    </header>

    <!-- Flagship Interactive Modeler Component -->
    <CommercialSpiralFreezerAmmoniaModeler lang={lang} />

    <!-- Engineering & Surface Science Technical Reference -->
    <section class="my-16 space-y-12">
      <div class="border-t border-hairline pt-10">
        <h2 class="text-title-lg font-semibold text-ink tracking-tight mb-4">
          {content.scienceTitle1}
        </h2>
        <div class="prose max-w-none text-body text-sm sm:text-base leading-relaxed space-y-4">
          <p>{content.scienceText1}</p>
          <div class="bg-surface-soft p-4 rounded-xl border border-hairline font-mono text-xs overflow-x-auto my-4 text-ink">
            {content.box1Text}
          </div>
          <div class="bg-surface-soft p-4 rounded-xl border border-hairline font-mono text-xs overflow-x-auto my-4 text-ink">
            {content.box2Text}
          </div>
        </div>
      </div>

      <div class="border-t border-hairline pt-10">
        <h2 class="text-title-lg font-semibold text-ink tracking-tight mb-4">
          {content.scienceTitle2}
        </h2>
        <div class="prose max-w-none text-body text-sm sm:text-base leading-relaxed space-y-4">
          <p>{content.scienceText2}</p>
          <div class="bg-surface-soft p-4 rounded-xl border border-hairline font-mono text-xs overflow-x-auto my-4 text-ink">
            {content.box3Text}
          </div>
          <div class="bg-surface-soft p-4 rounded-xl border border-hairline font-mono text-xs overflow-x-auto my-4 text-ink">
            {content.box4Text}
          </div>
        </div>
      </div>

      <div class="border-t border-hairline pt-10">
        <h2 class="text-title-lg font-semibold text-ink tracking-tight mb-4">
          Frequently Asked Questions
        </h2>
        <div class="space-y-6">
          {content.faqs.map((faq) => (
            <div class="bg-surface-soft/60 border border-hairline rounded-2xl p-6">
              <h3 class="text-title-sm font-semibold text-ink mb-2">
                {faq.question}
              </h3>
              <p class="text-body text-sm leading-relaxed text-muted">
                {faq.answer}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>
