    section2Body: "木口（エンドグレイン）まな板は、植物の繊維が垂直に立っています。刃先が当たっても繊維の間を押し広げるだけで切断しないため、包丁傷が自然に閉じ、刃こぼれも防ぎます。",
    section3Title: "食品安全ミネラルオイルによる保湿と二段噴霧消毒法",
    section3Body: "月に1回、薬局方のミネラルオイルを塗り込むことで、肉汁が1mm以上深くに染み込むのを防ぎます。除菌には過酸化水素と食酢を連続噴霧する安全かつ強力な手法が推奨されます。"
  }
};

const c = CONTENT[lang] || CONTENT.es;
---

<Layout title={c.pageTitle} description={c.pageDescription} faqs={c.faqs} availableLocales={availableLocales}>
  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={c.breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1280px] mx-auto px-6 py-10 md:py-16">
    <!-- Header -->
    <header class="max-w-4xl mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-emerald-500/10 text-emerald-950 mb-3 border border-emerald-500/20">
        <span>🪵</span>
        {c.monoBadge}
      </div>
      <h1 class="text-3xl md:text-5xl font-extrabold text-ink tracking-tight mb-4 leading-tight">
        {c.monoTitle}
      </h1>
      <p class="text-base md:text-lg text-muted leading-relaxed">
        {c.monoSub}
      </p>
    </header>

    <!-- Interactive Modeler Component -->
    <WoodenCuttingBoardPathogenModeler lang={lang} />

    <!-- Scientific Deep-Dive Analysis -->
    <section class="prose max-w-none text-ink border-t border-hairline pt-12 mt-12 space-y-12">
      <article>
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-4">
          {c.section1Title}
        </h2>
        <p class="text-sm md:text-base leading-relaxed text-muted">
          {c.section1Body}
        </p>
      </article>

      <article>
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-4">
          {c.section2Title}
        </h2>
        <p class="text-sm md:text-base leading-relaxed text-muted">
          {c.section2Body}
        </p>
      </article>

      <article>
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-4">
          {c.section3Title}
        </h2>
        <p class="text-sm md:text-base leading-relaxed text-muted">
          {c.section3Body}
        </p>
      </article>
    </section>

    <!-- FAQs Section -->
    <section class="border-t border-hairline pt-12 mt-12">
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-6 text-ink">
        {lang === 'zh-cn' ? '常见科学与食品安全解答' : (lang === 'ja' ? 'よくある質問と科学的解説' : (lang === 'pt' ? 'Perguntas Frequentes e Evidências' : 'Preguntas Frecuentes y Evidencia Científica'))}
      </h2>
      <div class="space-y-6">
        {c.faqs.map(faq => (
          <div class="bg-surface-soft border border-hairline rounded-2xl p-6">
            <h3 class="text-base font-bold text-ink mb-2">
              {faq.question}
            </h3>
            <p class="text-xs md:text-sm text-muted leading-relaxed">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>
