---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import FoodContactMigrationPredictor from '../../../components/FoodContactMigrationPredictor.astro';
import type { SupportedLanguage } from '../../../i18n/ui';
import { useTranslations, useTranslatedPath } from '../../../i18n/utils';

export function getStaticPaths() {
  const availableLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'zh-cn', 'ja'];
  return [
    { params: { lang: 'es' }, props: { lang: 'es' as SupportedLanguage, availableLocales } },
    { params: { lang: 'pt' }, props: { lang: 'pt' as SupportedLanguage, availableLocales } },
    { params: { lang: 'zh-cn' }, props: { lang: 'zh-cn' as SupportedLanguage, availableLocales } },
    { params: { lang: 'ja' }, props: { lang: 'ja' as SupportedLanguage, availableLocales } }
  ];
}

interface Props {
  lang: SupportedLanguage;
  availableLocales: SupportedLanguage[];
}

const { lang, availableLocales } = Astro.props;
const t = useTranslations(lang);
const tp = useTranslatedPath(lang);

interface LocaleContent {
  pageTitle: string;
  pageDescription: string;
  breadcrumbs: Array<{ label: string; href?: string }>;
  faqs: Array<{ question: string; answer: string }>;
  faqHeading: string;
  faqSub: string;
}

const CONTENT: Record<SupportedLanguage, LocaleContent> = {
  en: {} as any,
  es: {
    pageTitle: "Predictor Cinético de Migración Química y Lixiviación en Contacto con Alimentos | IsItKitchenSafe",
    pageDescription: "Simula la lixiviación química dependiente del tiempo desde utensilios, plásticos y vajillas hacia los alimentos. Modela curvas de difusión de Fick, aceleración térmica de Arrhenius y puntos de cruce de límites reglamentarios LMS.",
    breadcrumbs: [
      { label: 'Inicio', href: '/es/' },
      { label: 'Herramientas', href: '/es/tools/' },
      { label: 'Predictor de Migración Química' }
    ],
    faqHeading: "Preguntas Frecuentes sobre Cinética de Migración y Lixiviación en Alimentos",
    faqSub: "Respuestas científicas basadas en ingeniería química, toxicología y normas internacionales UE/FDA.",
    faqs: [
      {
        question: "¿Qué es la migración química en contacto con alimentos y qué determina su velocidad?",
        answer: "La migración es la transferencia de masa de moléculas químicas (monómeros, plastificantes, metales pesados y oligómeros) desde el material contenedor hacia el alimento. Su cinética se rige por la Segunda Ley de Difusión de Fick, la concentración inicial del migrante, el coeficiente de partición entre el recipiente y el alimento, el tiempo de contacto y la temperatura."
      },
      {
        question: "¿Por qué la ecuación de Arrhenius demuestra que la comida caliente extrae tóxicos exponencialmente más rápido?",
        answer: "El coeficiente de difusión (D) dentro de los polímeros y metales sigue la cinética de Arrhenius: D(T) = D0 · exp(-Ea / (R · T)). Debido a que la energía de activación (Ea) oscila entre 50 y 95 kJ/mol, elevar la temperatura de 4°C (frigorífico) a 100°C–120°C (hervor o microondas) acelera la tasa de migración de 40 a más de 250 veces, haciendo que un recipiente seguro en frío supere los límites legales en cuestión de minutos."
      },
      {
        question: "¿Por qué los alimentos ácidos como el tomate o vinagre son tan corrosivos en metales y cerámicas esmaltadas?",
        answer: "Los alimentos ácidos (pH < 4,5) aportan iones de hidrógeno (H+) que quelan y disuelven activamente los cationes metálicos. En cerámicas tradicionales con esmaltes al plomo, el ácido lixivia rápidamente plomo (Pb²⁺) y cadmio (Cd²⁺). En ollas de aluminio crudo, corroe la capa superficial de óxido protectora, liberando iones de aluminio (Al³⁺) en cantidades muy superiores a los límites recomendados por el Consejo de Europa."
      },
      {
        question: "¿Qué es un Límite de Migración Específica (LMS) según el Reglamento (UE) 10/2011?",
        answer: "El LMS es la cantidad máxima legalmente permitida de una sustancia química que puede transferirse desde un material en contacto con alimentos a 1 kg de alimento (mg/kg). Lo establece la Autoridad Europea de Seguridad Alimentaria (EFSA) tras ensayos toxicológicos exhaustivos para evitar la toxicidad orgánica crónica y la disrupción endocrina."
      },
      {
        question: "¿Por qué los alimentos grasos y aceitosos absorben más ftalatos (DEHP) y PFAS?",
        answer: "Los plastificantes como el DEHP y los PFAS son compuestos lipofílicos no polares. Al no estar unidos covalentemente a la matriz plástica, los lípidos dietéticos, mantequilla o carnes grasas actúan como disolventes orgánicos activos, extrayendo hasta 20 veces más sustancias que el agua pura."
      }
    ]
  },
  pt: {
    pageTitle: "Preditor Cinético de Migração Química e Liberação em Contato com Alimentos | IsItKitchenSafe",
    pageDescription: "Simule a liberação química dependente do tempo a partir de panelas, potes plásticos e louças para os alimentos. Calcula curvas de difusão de Fick, fatores de aceleração térmica de Arrhenius e cruzamento de limites regulatórios LME.",
    breadcrumbs: [
      { label: 'Início', href: '/pt/' },
      { label: 'Ferramentas', href: '/pt/tools/' },
      { label: 'Preditor de Migração Química' }
    ],
    faqHeading: "Perguntas Frequentes sobre Cinética de Migração e Liberação em Alimentos",
    faqSub: "Respostas com rigor científico fundamentadas em engenharia química e diretivas UE/FDA.",
    faqs: [
      {
        question: "O que é migração química no contato com alimentos e o que governa sua velocidade?",
        answer: "A migração química é a transferência de massa de substâncias de baixo peso molecular (monômeros, plastificantes, metais pesados e oligômeros) do recipiente para o alimento. A taxa é controlada pela Segunda Lei de Difusão de Fick, concentração inicial do migrante, coeficiente de partição entre o material e o alimento, tempo de exposição e temperatura."
      },
      {
        question: "Por que a equação de Arrhenius explica a aceleração exponencial de contaminantes no calor?",
        answer: "O coeficiente de difusão (D) segue a equação de Arrhenius: D(T) = D0 · exp(-Ea / (R · T)). Como as energias de ativação (Ea) variam entre 50 e 95 kJ/mol, o aumento da temperatura de 4°C (geladeira) para 100°C–120°C (ebulição ou micro-ondas) multiplica a velocidade de migração em até 250 vezes, superando limites de segurança rapidamente."
      },
      {
        question: "Por que alimentos ácidos são perigosos em panelas de alumínio e cerâmicas vidradas?",
        answer: "Alimentos ácidos (pH < 4,5) contêm íons de hidrogênio livres que atacam e dissolvem cátions metálicos. Em cerâmicas artesanais com esmalte de chumbo, o ácido extrai íons Pb²⁺ e Cd²⁺. Em panelas de alumínio cru, remove a camada passivadora de óxido, gerando liberação galvânica de íons Al³⁺ diretamente nos molhos."
      },
      {
        question: "O que é um Limite de Migração Específica (LME) segundo a União Europeia?",
        answer: "O LME é a quantidade máxima permitida por lei de uma substância química que pode migrar para 1 kg de alimento (mg/kg). O índice é determinado pela EFSA para garantir que a exposição diária não cause efeitos tóxicos cumulativos, imunológicos ou carcinogênicos."
      },
      {
        question: "Por que alimentos gordurosos extraem mais ftalatos (DEHP) e PFAS?",
        answer: "Ortoftalatos e PFAS são moléculas lipofílicas que se dissolvem preferencialmente em óleos. Quando molhos quentes com manteiga, azeite ou queijo entram em contato com plásticos flexíveis, as gorduras funcionam como solvente ativo, extraindo plastificantes em taxas muito superiores à da água."
      }
    ]
  },
  'zh-cn': {
    pageTitle: "食品接触化学物质迁移与溶出时序动力学预测模型 | IsItKitchenSafe",
    pageDescription: "精确模拟厨具、塑料包装及餐具中化学添加剂向食物迁移的时间浓度动力学曲线。基于菲克第二扩散定律与阿伦尼乌斯热加速方程，实时计算特定迁移限量（SML）合规超标临界点。",
    breadcrumbs: [
      { label: '首页', href: '/zh-cn/' },
      { label: '实用工具', href: '/zh-cn/tools/' },
      { label: '化学迁移时序动力学模型' }
    ],
    faqHeading: "食品接触材料化学溶出与扩散动力学常见科学解答",
    faqSub: "严谨奠基于化学工程传递现象、食品毒理学及欧盟EU 10/2011、美国FDA法规标准。",
    faqs: [
      {
        question: "什么是食品接触化学迁移？它的迁移速率由哪些物理参数决定？",
        answer: "食品接触化学迁移是指容器或厨具材质中的低分子量化学物质（小分子单体、增塑剂、重金属离子、热稳定剂及低聚物）在浓度梯度驱动下向食品或模拟物扩散的传质过程。该过程遵循菲克第二扩散定律（Fick's Second Law），主要受扩散系数、活化能、基体分配系数、接触时间和温度控制。"
      },
      {
        question: "阿伦尼乌斯方程（Arrhenius Equation）如何解释高温会导致化学溶出呈指数级激增？",
        answer: "聚合物与金属晶界内的扩散系数随热力学温度呈指数依赖关系：D(T) = D0 · exp(-Ea / (R · T))。食品接触材料的扩散活化能Ea一般在50至95 kJ/mol之间。从冰箱冷藏（4°C）升温至沸水或微波局部热点（100°C–120°C），分子的扩散传质速率会暴增40倍至250倍以上，导致原本合规的容器在短短数十分钟内突破法定安全限量。"
      },
      {
        question: "为什么番茄酱、果汁等酸性食物在裸铝锅和彩釉陶瓷中极具溶出危险？",
        answer: "酸性食物（pH < 4.5）中富含高活性水合氢离子（H+），具备强烈的螯合与质子置换能力。在传统低温烧制的含铅釉彩陶瓷中，酸液会迅速溶解氧化铅助熔剂，浸出高毒性铅（Pb²⁺）与镉（Cd²⁺）；在未阳极氧化的裸铝锅中，酸液会腐蚀剥离氧化铝钝化膜，导致大量铝离子（Al³⁺）超标溶入食品。"
      },
      {
        question: "什么是欧盟EU 10/2011法规中的“特定迁移限量（SML）”？",
        answer: "特定迁移限量（Specific Migration Limit, SML）是法律允许某种化学物质从接触材料迁移到每千克食品中的最大毫克量（mg/kg）。SML值由欧洲食品安全局（EFSA）依据慢性毒理试验、每日耐受摄入量（TDI）及致突变风险评估科学制定，属于强制性法律红线。"
      },
      {
        question: "为什么多油脂食物比清水更容易萃取出邻苯二甲酸酯（DEHP）和PFAS？",
        answer: "邻苯二甲酸酯类增塑剂与全氟烷基物质（PFAS）多为高度亲脂性（非极性）分子，且未以共价键固定在塑料树脂链上。当黄油、热油、奶酪或多脂肉类接触保鲜膜或塑料餐盒时，油脂充当了高效有机萃取溶剂，使其迁移速率达到水性模拟物的10至20倍。"
      }
    ]
  },
  ja: {
    pageTitle: "食品接触化学物質移行・溶出タイムシリーズ動力学予測シミュレーター | IsItKitchenSafe",
    pageDescription: "調理器具、プラスチック容器、食器から食品へ溶出する化学物質の経時変化をシミュレーション。フィックの拡散方程式とアレニウスモデルに基づき、法定特定移行限界（SML）超過時間を予測します。",
    breadcrumbs: [
      { label: 'ホーム', href: '/ja/' },
      { label: 'ツール一覧', href: '/ja/tools/' },
      { label: '化学物質溶出シミュレーター' }
    ],
    faqHeading: "食品接触化学物質の移行動力学に関するよくある質問",
    faqSub: "化学工学の物質移動論、環境毒性学、およびEU/FDA国際公的基準に基づき解説。",
    faqs: [
      {
        question: "食品接触化学物質の「移行（マイグレーション）」とは何ですか？",
        answer: "移行とは、容器や調理器具の素材に含まれる低分子物質（可塑剤、未反応モノマー、重金属、添加剤、オリゴマーなど）が食品中へ拡散・浸出する物理化学的物質移動現象です。この現象はフィックの第二拡散法則に支配され、素材と食品間の分配係数、接触時間、接触温度によって決まります。"
      },
      {
        question: "アレニウスの式から見て、温かい料理ほど有害物質が急激に溶出するのはなぜですか？",
        answer: "ポリマー内の拡散係数（D）は熱力学的温度に対してアレニウスの式 D(T) = D0 · exp(-Ea / (R · T)) に従い指数関数的に増大します。拡散活性化エネルギー（Ea）が50〜95 kJ/molの範囲にあるため、冷蔵庫（4°C）から加熱調理（100°C〜120°C）に温度が上がると、溶出速度は40倍から250倍以上に加速され、短時間で安全基準値を超過します。"
      },
      {
        question: "トマトソースや酢などの酸性食品が無塗装アルミ鍋や絵付け陶器で危険な理由は？",
        answer: "pH 4.5未満の酸性食品には水素イオン（H+）が豊富に含まれ、金属イオンを強力にキレート・溶出させます。昔ながらの鉛釉薬を使った陶器では、酸によって鉛（Pb²⁺）やカドミウム（Cd²⁺）が溶出します。また無垢のアルミ鍋では酸化皮膜が破壊され、アルミニウムイオン（Al³⁺）が食品中に大量に溶け出します。"
      },
      {
        question: "EU規則 10/2011の「特定移行限界（SML）」とは何ですか？",
        answer: "特定移行限界（Specific Migration Limit, SML）とは、食品接触材料から食品1キログラムあたりへ移行することが法的に許容される特定化学物質の最大量（mg/kg）です。欧州食品安全機関（EFSA）の厳格な毒性評価に基づき、健康被害を防ぐ目的で法定されています。"
      },
      {
        question: "油分の多い食品ほどフタル酸エステル（DEHP）やPFASを多く吸い出すのはなぜですか？",
        answer: "フタル酸エステルやPFASは親油性（脂溶性）の高い非極性分子であり、プラスチックのポリマー鎖と化学結合していません。油脂、バター、熱いチーズなどが触れると、脂質が有機溶媒として働き、水と比べて最大20倍もの速さで有害物質を抽出してしまいます。"
      }
    ]
  }
};

const c = CONTENT[lang];
const pageTitle = c.pageTitle;
const pageDescription = c.pageDescription;

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": c.pageTitle,
  "url": `https://isitkitchensafe.com/${lang}/tools/food-contact-migration-predictor/`,
  "applicationCategory": "ScienceApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "description": c.pageDescription,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};
---

<Layout title={pageTitle} description={pageDescription} faqs={c.faqs} availableLocales={availableLocales}>
  <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />

  <main class="container mx-auto px-4 py-8 max-w-5xl space-y-8">
    <Breadcrumbs items={c.breadcrumbs} />

    <FoodContactMigrationPredictor lang={lang} />

    <!-- FAQ Accordion Section -->
    <section class="mt-16 bg-surface-soft border border-hairline rounded-3xl p-6 md:p-10 space-y-6">
      <div class="border-b border-hairline pb-4">
        <span class="text-xs font-bold uppercase tracking-wider text-amber-800 block mb-1">
          {c.faqHeading}
        </span>
        <p class="text-xs text-muted">{c.faqSub}</p>
      </div>

      <div class="space-y-4">
        {c.faqs.map(faq => (
          <details class="group p-4 rounded-xl bg-canvas border border-hairline transition-colors open:bg-surface">
            <summary class="font-medium text-ink cursor-pointer list-none flex items-center justify-between text-sm md:text-base">
              <span>{faq.question}</span>
              <span class="text-muted transition-transform group-open:rotate-180 ml-2">&darr;</span>
            </summary>
            <p class="text-xs md:text-sm text-body mt-3 pt-3 border-t border-hairline/60 leading-relaxed">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </main>
</Layout>
