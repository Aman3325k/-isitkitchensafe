---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import InstantPotPressureReleaseChecker from '../../../components/InstantPotPressureReleaseChecker.astro';
import rawData from '../../../data/instant-pot-pressure-release-data.json';
import type { SupportedLanguage } from '../../../i18n/ui';

export function getStaticPaths() {
  const availableLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'zh-cn', 'ja'];
  return [
    { params: { lang: 'es' }, props: { lang: 'es' as SupportedLanguage, availableLocales } },
    { params: { lang: 'pt' }, props: { lang: 'pt' as SupportedLanguage, availableLocales } },
    { params: { lang: 'zh-cn' }, props: { lang: 'zh-cn' as SupportedLanguage, availableLocales } },
    { params: { lang: 'ja' }, props: { lang: 'ja' as SupportedLanguage, availableLocales } }
  ];
}

interface Props {
  lang: SupportedLanguage;
  availableLocales: SupportedLanguage[];
}

const { lang, availableLocales } = Astro.props;

interface LocalePageContent {
  pageTitle: string;
  pageDescription: string;
  badge: string;
  h1: string;
  heroSub: string;
  breadcrumbs: Array<{ label: string; href?: string }>;
}

const CONTENT: Record<Exclude<SupportedLanguage, 'en'>, LocalePageContent> = {
  es: {
    pageTitle: "Verificador de Llenado, Liberación Natural vs. Rápida y Espuma en Instant Pot | IsItKitchenSafe",
    pageDescription: "Verificador interactivo de seguridad para Instant Pot y olla a presión según UL 1026 y USDA: comprueba el límite 1/2 MAX vs. 2/3 MAX, liberación natural o rápida, riesgo de espuma, líquido mínimo (3 qt, 6 qt, 8 qt y estufa) y cómo evitar el aviso BURN en 22 alimentos.",
    badge: "Manuales UL 1026 · Seguridad USDA · 22 Alimentos y 4 Tamaños de Olla",
    h1: "Verificador de Llenado y Liberación de Presión para Instant Pot",
    heroSub: "Evita quemaduras por vapor, válvulas tapadas por espuma, carne seca y el aviso BURN: consulta al instante la línea 1/2 MAX vs. 2/3 MAX, Liberación Natural (NPR) vs. Rápida (QR) y líquido mínimo según tu olla.",
    breadcrumbs: [
      { label: "Inicio", href: "/es/" },
      { label: "Herramientas", href: "/es/tools/" },
      { label: "Llenado y Presión Instant Pot" }
    ]
  },
  pt: {
    pageTitle: "Verificador de Limite de Volume, Liberação de Pressão e Espuma na Instant Pot | IsItKitchenSafe",
    pageDescription: "Verificador interativo de segurança para Instant Pot e panela de pressão baseado em UL 1026 e USDA: confira 1/2 MAX vs. 2/3 MAX, Liberação Natural vs. Rápida, risco de entupimento, líquido mínimo (3 qt, 6 qt, 8 qt e fogão) e prevenção do erro BURN em 22 alimentos.",
    badge: "Normas UL 1026 · Segurança USDA · 22 Alimentos e 4 Tamanhos de Panela",
    h1: "Verificador de Limite e Liberação de Pressão para Instant Pot",
    heroSub: "Evite queimaduras de vapor, válvulas entupidas por espuma, frango ressecado e o erro BURN: consulte o limite exato 1/2 MAX vs. 2/3 MAX, Liberação Natural (NPR) vs. Rápida (QR) e líquido mínimo da sua panela.",
    breadcrumbs: [
      { label: "Início", href: "/pt/" },
      { label: "Ferramentas", href: "/pt/tools/" },
      { label: "Limite e Pressão Instant Pot" }
    ]
  },
  'zh-cn': {
    pageTitle: "电压力锅 / Instant Pot 水位红线、自然泄压与起泡防堵安全检查器 | IsItKitchenSafe",
    pageDescription: "基于 UL 1026 与 USDA 标准的交互式电压力锅与明火高压锅安全检查器：涵盖 22 种常见食材的 1/2 MAX 与 2/3 MAX 水位上限、自然泄压 vs 手动快排、堵阀起泡风险、3/6/8 夸脱最低液体量及防“BURN”糊底技巧。",
    badge: "UL 1026 高压锅规范 · USDA 禽肉测温 · 22 种食材 × 4 种锅型",
    h1: "电压力锅 / Instant Pot 水位红线与泄压安全检查器",
    heroSub: "远离蒸汽烫伤、豆皮泡沫堵阀、鸡肉干柴与“BURN”糊底报错——速查 22 种日常食材的 1/2 MAX vs 2/3 MAX 水位线、自然泄压（NPR）与快速泄压（QR）规范及各容量最低清液用量。",
    breadcrumbs: [
      { label: "首页", href: "/zh-cn/" },
      { label: "实用工具", href: "/zh-cn/tools/" },
      { label: "电压力锅水位与泄压检查器" }
    ]
  },
  ja: {
    pageTitle: "電気圧力鍋・Instant Pot 上限線・自然減圧vsクイックリリース安全チェッカー | IsItKitchenSafe",
    pageDescription: "UL 1026・USDA 基準に基づく電気圧力鍋＆直火式圧力鍋の安全チェッカー。定番 22 食材の「1/2 MAX vs 2/3 MAX」上限線、自然減圧 vs クイックリリース、泡詰まりリスク、サイズ別最低水分量（3qt・6qt・8qt・直火式）、BURN 防止策を即確認。",
    badge: "UL 1026 圧力鍋基準 · USDA 鶏肉温度 · 定番22食材 × 4サイズ",
    h1: "電気圧力鍋・Instant Pot 上限線＆減圧チェッカー",
    heroSub: "蒸気やけど・泡によるノズル詰まり・パサつき・BURN（焦げ付き）エラーを徹底予防。3qt・6qt・8qt・直火式の最低水分量と、22食材の 1/2 MAX vs 2/3 MAX 上限線・自然減圧 vs クイックリリースを一瞬で確認できます。",
    breadcrumbs: [
      { label: "ホーム", href: "/ja/" },
      { label: "ツール", href: "/ja/tools/" },
      { label: "電気圧力鍋 上限線・減圧チェッカー" }
    ]
  }
};

const c = CONTENT[lang as Exclude<SupportedLanguage, 'en'>] || CONTENT.es;
const faqs = (rawData.faqs as Record<string, Array<{ question: string; answer: string }>>)[lang] || rawData.faqs.en;
const localizedUrl = `https://isitkitchensafe.com/${lang}/tools/instant-pot-pressure-release-checker/`;

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": c.h1,
  "url": localizedUrl,
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript.",
  "description": c.pageDescription,
  "inLanguage": lang === 'zh-cn' ? 'zh-CN' : lang,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={c.pageTitle}
  description={c.pageDescription}
  faqs={faqs}
  excludeFaqSchema={true}
  availableLocales={availableLocales}
  lang={lang}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1 print:hidden">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={c.breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1140px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-signature-coral text-white mb-3">
        {c.badge}
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        {c.h1}
      </h1>
      <p class="text-body text-[15px] md:text-[16px] leading-relaxed">
        {c.heroSub}
      </p>
    </header>

    <!-- Main Interactive Checker Component -->
    <InstantPotPressureReleaseChecker lang={lang} />
  </div>
</Layout>
