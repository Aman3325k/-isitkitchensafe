---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import FridgeOrganizationZonePlanner from '../../../components/FridgeOrganizationZonePlanner.astro';
import rawData from '../../../data/fridge-organization-zone-planner-data.json';
import type { SupportedLanguage } from '../../../i18n/ui';

export function getStaticPaths() {
  const availableLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'zh-cn', 'ja'];
  return [
    { params: { lang: 'es' }, props: { lang: 'es' as SupportedLanguage, availableLocales } },
    { params: { lang: 'pt' }, props: { lang: 'pt' as SupportedLanguage, availableLocales } },
    { params: { lang: 'zh-cn' }, props: { lang: 'zh-cn' as SupportedLanguage, availableLocales } },
    { params: { lang: 'ja' }, props: { lang: 'ja' as SupportedLanguage, availableLocales } }
  ];
}

interface Props {
  lang: SupportedLanguage;
  availableLocales: SupportedLanguage[];
}

const { lang, availableLocales } = Astro.props;

interface LocalePageContent {
  pageTitle: string;
  pageDescription: string;
  badge: string;
  h1: string;
  heroSub: string;
  breadcrumbs: Array<{ label: string; href?: string }>;
}

const CONTENT: Record<Exclude<SupportedLanguage, 'en'>, LocalePageContent> = {
  es: {
    pageTitle: "Planificador Interactivo de Organización de Nevera y Zonas Seguras (USDA y FDA) | IsItKitchenSafe",
    pageDescription: "Organiza tu refrigerador según zonas de temperatura USDA, jerarquía antigoteo FDA y ciencia del gas etileno. Mapa interactivo de 6 zonas, buscador de 28 alimentos y guía imprimible.",
    badge: "USDA FSIS, Código FDA y Ciencia del Etileno",
    h1: "Planificador Interactivo de Organización de Nevera y Zonas Seguras",
    heroSub: "Descubre dónde va cada uno de los 28 alimentos cotidianos en las 6 zonas de temperatura y humedad de la nevera (y cuáles deben quedarse en la encimera o despensa). Evita goteos de carne cruda, saca leche y huevos de la puerta cálida y separa frutas productoras de etileno de las verduras.",
    breadcrumbs: [
      { label: "Inicio", href: "/es/" },
      { label: "Herramientas", href: "/es/tools/" },
      { label: "Organización Segura de la Nevera" }
    ]
  },
  pt: {
    pageTitle: "Planejador Interativo de Organização da Geladeira e Zonas Seguras (USDA e FDA) | IsItKitchenSafe",
    pageDescription: "Organize sua geladeira por zonas de temperatura USDA, hierarquia antigotejamento FDA e ciência do etileno. Mapa interativo de 6 zonas, busca de 28 alimentos e guia imprimível.",
    badge: "USDA FSIS, Código FDA e Ciência do Etileno",
    h1: "Planejador Interativo de Organização da Geladeira e Zonas Seguras",
    heroSub: "Descubra o lugar exato de 28 alimentos do dia a dia nas 6 zonas de temperatura e umidade da geladeira (e o que deve ficar fora, na bancada ou despensa). Evite contaminação por gotejamento, tire leite e ovos da porta quente e separe frutas produtoras de etileno das folhas verdes.",
    breadcrumbs: [
      { label: "Início", href: "/pt/" },
      { label: "Ferramentas", href: "/pt/tools/" },
      { label: "Organização Segura da Geladeira" }
    ]
  },
  'zh-cn': {
    pageTitle: "互动冰箱分区收纳与安全温区规划器 (USDA & FDA 标准) | IsItKitchenSafe",
    pageDescription: "按美国农业部 USDA 温区、FDA 防滴漏层级与果蔬乙烯科学整理冰箱。内置 6 大冰箱温区互动图、28 类日常食材秒查、避坑提示与可打印贴门速查表。",
    badge: "USDA FSIS、FDA 食品法典与乙烯科学",
    h1: "互动冰箱分区收纳与安全温区规划器",
    heroSub: "一目了然查看 28 类日常食材在冰箱 6 大温湿度分区的最佳摆放位置（以及哪些食物切勿放进冰箱）。严格遵循防滴漏生熟分层，告别把牛奶鸡蛋放门架的误区，科学隔离产乙烯水果与敏感绿叶菜。",
    breadcrumbs: [
      { label: "首页", href: "/zh-cn/" },
      { label: "实用工具", href: "/zh-cn/tools/" },
      { label: "冰箱分区收纳与安全温区规划器" }
    ]
  },
  ja: {
    pageTitle: "冷蔵庫ゾーン別収納＆食品安全プランナー（USDA・FDA基準） | IsItKitchenSafe",
    pageDescription: "USDAの冷蔵温度ゾーン、FDAのドリップ交差汚染防止ルール、エチレンガス科学に基づくインタラクティブ冷蔵庫整理マップ。28品目の最適ゾーン検索と印刷用早見表付き。",
    badge: "USDA FSIS・FDA食品コード・エチレン科学準拠",
    h1: "冷蔵庫ゾーン別収納＆食品安全プランナー",
    heroSub: "日常の28食品カテゴリーが冷蔵庫の6つの温度・湿度ゾーン（および常温・冷暗所）のどこに最適かを瞬時に確認。生肉ドリップの交差汚染やドアポケットへの牛乳・卵収納を防ぎ、エチレン果物と葉物野菜を正しく分けて鮮度を長持ちさせます。",
    breadcrumbs: [
      { label: "ホーム", href: "/ja/" },
      { label: "ツール", href: "/ja/tools/" },
      { label: "冷蔵庫ゾーン別収納プランナー" }
    ]
  }
};

const c = CONTENT[lang as Exclude<SupportedLanguage, 'en'>] || CONTENT.es;
const faqs = (rawData.faqs as Record<string, Array<{ question: string; answer: string }>>)[lang] || rawData.faqs.en;
const localizedUrl = `https://isitkitchensafe.com/${lang}/tools/fridge-organization-zone-planner/`;

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": c.h1,
  "url": localizedUrl,
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript.",
  "description": c.pageDescription,
  "inLanguage": lang === 'zh-cn' ? 'zh-CN' : lang,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={c.pageTitle}
  description={c.pageDescription}
  faqs={faqs}
  excludeFaqSchema={true}
  availableLocales={availableLocales}
  lang={lang}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1 print:hidden">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={c.breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1140px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-signature-coral text-white mb-3">
        {c.badge}
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        {c.h1}
      </h1>
      <p class="text-body text-[15px] md:text-[16px] leading-relaxed">
        {c.heroSub}
      </p>
    </header>

    <!-- Main Interactive Planner, Related Links & 5 Visible FAQs -->
    <FridgeOrganizationZonePlanner lang={lang} />
  </div>
</Layout>
