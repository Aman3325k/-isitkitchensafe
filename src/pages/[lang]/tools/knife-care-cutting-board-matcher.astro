---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import KnifeCareCuttingBoardMatcher from '../../../components/KnifeCareCuttingBoardMatcher.astro';
import rawData from '../../../data/knife-care-cutting-board-data.json';
import type { SupportedLanguage } from '../../../i18n/ui';

export function getStaticPaths() {
  const availableLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'zh-cn', 'ja'];
  return [
    { params: { lang: 'es' }, props: { lang: 'es' as SupportedLanguage, availableLocales } },
    { params: { lang: 'pt' }, props: { lang: 'pt' as SupportedLanguage, availableLocales } },
    { params: { lang: 'zh-cn' }, props: { lang: 'zh-cn' as SupportedLanguage, availableLocales } },
    { params: { lang: 'ja' }, props: { lang: 'ja' as SupportedLanguage, availableLocales } }
  ];
}

interface Props {
  lang: SupportedLanguage;
  availableLocales: SupportedLanguage[];
}

const { lang, availableLocales } = Astro.props;

interface LocalePageContent {
  pageTitle: string;
  pageDescription: string;
  badge: string;
  h1: string;
  heroSub: string;
  breadcrumbs: Array<{ label: string; href?: string }>;
}

const CONTENT: Record<Exclude<SupportedLanguage, 'en'>, LocalePageContent> = {
  es: {
    pageTitle: "Cuidado de Cuchillos, Chaira vs. Afilado y Selector de Tablas de Cortar | IsItKitchenSafe",
    pageDescription: "Selector interactivo de cuidado de cuchillos (Rockwell HRC) y tablas de cortar (USDA FSIS): combina 5 perfiles de acero (japonés 15°, occidental 20°, sierra, cerámica) con 8 materiales de tablas (madera de testa, Hinoki, caucho Hasegawa, HDPE, bambú, vidrio/titanio) para ver chaira, piedra al agua, lavavajillas y desinfección.",
    badge: "Metalurgia Rockwell HRC · Desinfección USDA FSIS · 5 Cuchillos × 8 Tablas",
    h1: "Cuidado de Cuchillos, Chaira vs. Afilado y Tablas de Cortar",
    heroSub: "Deja de arruinar filos en el lavavajillas o sobre vidrio, mármol y titanio: combina tus cuchillos (52–64 HRC y cerámica) con 8 materiales de tablas para conocer ángulos de 15° vs. 20°, chaira y piedra al agua, microplásticos y desinfección USDA.",
    breadcrumbs: [
      { label: "Inicio", href: "/es/" },
      { label: "Herramientas", href: "/es/tools/" },
      { label: "Cuidado de Cuchillos y Tablas de Cortar" }
    ]
  },
  pt: {
    pageTitle: "Cuidados com Facas, Chaira vs. Afiação e Combinador de Tábuas de Corte | IsItKitchenSafe",
    pageDescription: "Combinador interativo de cuidados com facas (Rockwell HRC) e tábuas de corte (USDA FSIS): teste 5 perfis de lâmina (japonês 15°, ocidental 20°, serrilhada, cerâmica) em 8 materiais de tábuas (madeira de topo, Hinoki, borracha Hasegawa, HDPE, bambu, vidro/titânio) para regras de chaira, pedra, lava-louças e higienização.",
    badge: "Metalurgia Rockwell HRC · Higienização USDA FSIS · 5 Facas × 8 Tábuas",
    h1: "Cuidados com Facas, Chaira vs. Afiação e Combinador de Tábuas",
    heroSub: "Pare de cegar facas na lava-louças ou em tábuas de vidro, pedra e titânio: combine seu perfil de aço (52–64 HRC e cerâmica) com 8 materiais de tábuas para ver ângulos de 15° vs. 20°, chaira e pedra, microplásticos e sanitização USDA.",
    breadcrumbs: [
      { label: "Início", href: "/pt/" },
      { label: "Ferramentas", href: "/pt/tools/" },
      { label: "Cuidados com Facas e Tábuas de Corte" }
    ]
  },
  'zh-cn': {
    pageTitle: "厨刀养护、磨刀棒拨刃 vs 开刃与安全砧板匹配器 | IsItKitchenSafe",
    pageDescription: "基于洛氏硬度 HRC 与 USDA FSIS 标准的交互式厨刀与砧板匹配器：测试 5 类刀型钢材（15° 日系高碳钢、20° 德系、锯齿刀、陶瓷刀）与 8 种砧板材质（端面硬木、日本桧木、长谷川橡胶、HDPE 塑料、竹板、玻璃/钛板）的兼容性、磨刀棒与磨刀石规范、洗碗机红线及生肉消毒指南。",
    badge: "洛氏硬度 HRC 冶金 · USDA FSIS 消毒标准 · 5 刀型 × 8 砧板",
    h1: "厨刀养护、拨刃 vs 开刃与安全砧板匹配器",
    heroSub: "告别洗碗机伤刀与玻璃、大理石、钛板毁刃——将您的厨刀钢材（52–64 HRC 与陶瓷刀）与 8 种主流砧板实时匹配，即刻获取 15° vs 20° 磨刀规范、微塑料风险及 USDA 生肉消毒与白矿油养护方案。",
    breadcrumbs: [
      { label: "首页", href: "/zh-cn/" },
      { label: "实用工具", href: "/zh-cn/tools/" },
      { label: "厨刀养护与安全砧板匹配器" }
    ]
  },
  ja: {
    pageTitle: "包丁ケア・ホーニング vs 研ぎ＆安全まな板マッチャー | IsItKitchenSafe",
    pageDescription: "ロックウェル硬度 HRC と USDA FSIS 基準に基づく包丁＆まな板マッチャー。和包丁（15°）・洋包丁（20°）・波刃・セラミックなど包丁5タイプと、木口広葉樹・ひのき・合成ゴム・HDPE・竹・ガラス/チタンなど8素材の相性、ホーニング棒と砥石番手、食洗機可否、生肉除菌を一目で診断。",
    badge: "ロックウェル硬度 HRC · USDA FSIS 衛生基準 · 包丁5種 × まな板8種",
    h1: "包丁ケア・ホーニング vs 研ぎ＆安全まな板マッチャー",
    heroSub: "食洗機やガラス・大理石・チタン板による刃こぼれを徹底防止。包丁の鋼材（52–64 HRC・セラミック）とまな板8素材を照合し、15°対20°の研ぎ角度・安全な棒研ぎ＆砥石・マイクロプラスチック対策・USDA生肉除菌基準を即確認できます。",
    breadcrumbs: [
      { label: "ホーム", href: "/ja/" },
      { label: "ツール", href: "/ja/tools/" },
      { label: "包丁ケア＆安全まな板マッチャー" }
    ]
  }
};

const c = CONTENT[lang as Exclude<SupportedLanguage, 'en'>] || CONTENT.es;
const faqs = (rawData.faqs as Record<string, Array<{ question: string; answer: string }>>)[lang] || rawData.faqs.en;
const localizedUrl = `https://isitkitchensafe.com/${lang}/tools/knife-care-cutting-board-matcher/`;

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": c.h1,
  "url": localizedUrl,
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript.",
  "description": c.pageDescription,
  "inLanguage": lang === 'zh-cn' ? 'zh-CN' : lang,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={c.pageTitle}
  description={c.pageDescription}
  faqs={faqs}
  excludeFaqSchema={true}
  availableLocales={availableLocales}
  lang={lang}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1 print:hidden">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs items={c.breadcrumbs} className="mb-0" />
    </div>
  </div>

  <div class="max-w-[1140px] mx-auto px-6 py-10 md:py-14">
    <!-- Hero Header -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-signature-coral text-white mb-3">
        {c.badge}
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        {c.h1}
      </h1>
      <p class="text-body text-[15px] md:text-[16px] leading-relaxed">
        {c.heroSub}
      </p>
    </header>

    <!-- Main Interactive Matcher Component -->
    <KnifeCareCuttingBoardMatcher lang={lang} />
  </div>
</Layout>
