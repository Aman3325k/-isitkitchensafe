---
import Layout from '../../layouts/Layout.astro';
import type { SupportedLanguage } from '../../i18n/ui';

export function getStaticPaths() {
  return [
    { params: { lang: 'zh-cn' }, props: { lang: 'zh-cn' as SupportedLanguage, availableLocales: ['en', 'zh-cn', 'ja'] as SupportedLanguage[] } },
    { params: { lang: 'ja' }, props: { lang: 'ja' as SupportedLanguage, availableLocales: ['en', 'zh-cn', 'ja'] as SupportedLanguage[] } },
  ];
}

interface Props {
  lang: SupportedLanguage;
  availableLocales: SupportedLanguage[];
}

const { lang, availableLocales } = Astro.props;
const isJa = lang === 'ja';

const content = isJa ? {
  title: "利用規約 | キッチン安全チェッカー",
  description: "キッチン安全チェッカー（IsItKitchenSafe）の利用規約です。当サイトのご利用条件、免責事項、知的財産権の保護、および禁止事項について規定しています。",
  faqs: [
    {
      question: "当サイトのキッチン安全ガイドは絶対的な安全を保証するものですか？",
      answer: "いいえ。掲載情報は一般的な参考情報として提供されています。ご使用の際は、必ずお手元の調理器具の底面表示や家電の公式取扱説明書を最優先にご確認ください。"
    },
    {
      question: "当サイトの安全ガイドやデータを無断で転載・複製できますか？",
      answer: "いいえ。当サイトのデータベース、編集されたテキスト、レイアウトおよびデザインは知的財産権によって保護されており、無断での複製、スクレイピング、二次配布は固く禁じられています。"
    }
  ],
  h1: "利用規約",
  lastUpdated: "最終更新日：2026年6月19日",
  pWelcome: "キッチン安全チェッカー（isitkitchensafe.com）へようこそ。当ウェブサイトにアクセスまたは利用することにより、利用者は以下の利用規約を遵守し、これに拘束されることに同意したものとみなされます。本規約に同意いただけない場合は、当サイトのご利用をお控えください。",
  h1Use: "1. ウェブサイトの利用",
  p1Use: "isitkitchensafe.comに掲載されているコンテンツは、一般的な情報提供および参考のみを目的としています。利用者は適法な目的にのみサイトを利用し、他者の権利を侵害したり、他者によるサイトの円滑な利用を妨害したりしないことに同意するものとします。",
  h2Warranty: "2. 保証の否認",
  p2Warranty1: "当サイト上のすべての情報は、「現状有姿」かつ「利用可能な限度」において、明示的または黙示的を問わず、いかなる種類の保証も伴わずに提供されます。当サイトは正確で最新の安全データの提供に努めていますが、情報が100%完全、正確、または無謬であることを保証するものではありません。",
  p2Warranty2: "【重要】家電製品の仕様や許容範囲はメーカーやモデルによって異なります。調理器具や食品を家電に入れる前に、必ずメーカーの公式マニュアルや製品ラベルをご確認ください。",
  h3Liability: "3. 責任の制限",
  p3Liability: "当サイトに掲載された安全ガイドラインへの信頼に基づいて生じた、直接的、間接的、付随的、特別、または結果的な損害（財産の損害、家電製品の故障、火災、人身事故、食品やデータの損失を含みますがこれらに限定されません）について、isitkitchensafe.com、その運営者、および寄稿者はいかなる責任も負いません。利用者はキッチンの安全に関する決定について一切の自己責任を負うものとします。",
  h4Ip: "4. 知的財産権",
  p4Ip: "当サイトのデータベース、検証済み安全ガイド、記事、テキスト、レイアウト、グラフィック、およびデザインは、キッチン安全チェッカー（Is It Kitchen Safe?）の知的財産です。許可のない無断複製、スクレイピング、コピー、または再配布は固く禁止されています。",
  h5ThirdParty: "5. 第三者リンクおよび広告",
  p5ThirdParty: "当サイトではGoogle AdSenseによる広告が表示され、外部のウェブサイトへのリンクが含まれる場合があります。当サイトは、いかなる第三者のウェブサイトやサービスの内容、プライバシーポリシー、または取り扱いについて管理しておらず、責任を負いません。",
  h6Changes: "6. 規約の変更",
  p6Changes: "当社は本利用規約をいつでも変更または更新する権利を留保します。変更は本ページに「最終更新日」を更新して掲載されます。変更後に当サイトを継続して利用することにより、更新された規約に同意したものとみなされます。",
  h7Contact: "7. お問い合わせ",
  p7Contact: "本利用規約に関するご質問やお問い合わせは、メール（"
} : {
  title: "使用条款 | 厨房安全指南",
  description: "查阅厨房安全指南（IsItKitchenSafe）的使用条款。了解网站使用规范、责任限制声明、知识产权保护及用户准则。",
  faqs: [
    {
      question: "本网站提供的厨房安全指南是否具有绝对的法律约束力或绝对安全保证？",
      answer: "不是。本站提供的安全信息仅供一般性参考。在实际使用时，请务必优先遵循您所购电器的原厂说明书以及器皿底部的官方使用标识。"
    },
    {
      question: "是否可以复制或抓取本站整理的安全指南数据？",
      answer: "不可以。本网站的数据库架构、整理的数据条目、文本内容及版式设计均受知识产权法保护，未经授权严禁擅自抓取、复制或二次分发。"
    }
  ],
  h1: "使用条款",
  lastUpdated: "最后更新日期：2026年6月19日",
  pWelcome: "欢迎访问厨房安全指南（isitkitchensafe.com）。访问或使用本网站，即表示您同意遵守以下使用条款并受其约束。如果您不同意这些条款，请勿使用本网站。",
  h1Use: "1. 网站的使用规范",
  p1Use: "isitkitchensafe.com 上的内容仅供一般信息参考和速查之用。您同意仅出于合法目的使用本网站，且不得侵犯任何他人的合法权益，亦不得限制或阻碍他人对本网站的正常使用与浏览。",
  h2Warranty: "2. 保证免责声明",
  p2Warranty1: "本网站的所有信息均按“现状”及“现有可用”基础提供，不附带任何明示或默示的保证。尽管我们全力呈现准确、及时的厨房用具与电器安全数据，但“厨房安全指南”无法保证信息 100% 完整、精准或全无瑕疵。",
  p2Warranty2: "【重要提示】厨房电器规格因制造商和具体型号而异。在将任何炊具、器皿或食材放入电器之前，请务必仔细阅读官方说明书或器皿底部的耐热标签。",
  h3Liability: "3. 责任限制",
  p3Liability: "在任何情况下，isitkitchensafe.com、其所有者或内容贡献者均不对因依赖本网站安全指南而导致的任何直接、间接、附带、特殊或后果性损害（包括但不限于财产损失、电器故障、火灾、人身伤害或食品/数据损失）承担任何法律责任。您对自身在厨房中的操作及安全决策承担全部责任。",
  h4Ip: "4. 知识产权声明",
  p4Ip: "本网站的数据库架构、经系统校验的安全指南、文章、文本、排版设计、图表及整体视觉呈现均为“厨房安全指南（Is It Kitchen Safe?）”的专有知识产权。未经书面授权，严禁任何形式的爬取、转录、复制或分发。",
  h5ThirdParty: "5. 第三方链接与广告展示",
  p5ThirdParty: "我们的网站通过 Google AdSense 展示广告，并包含指向外部网络资源的链接。我们无法控制、亦不认可任何第三方网站或服务的内容、隐私政策或运营行为，对此不承担任何责任。",
  h6Changes: "6. 条款的变更与更新",
  p6Changes: "我们保留随时修改或替换本使用条款的权利。所有变更均会发布于本页面并注明最新的“最后更新日期”。变更发布后继续使用本网站，即视为您接受修改后的条款约束。",
  h7Contact: "7. 联系我们",
  p7Contact: "如果您对本使用条款有任何疑问，请通过电子邮件（"
};
---

<Layout title={content.title} description={content.description} faqs={content.faqs} excludeArticleSchema={true} availableLocales={availableLocales} lang={lang}>
  <section class="max-w-[800px] mx-auto px-6 py-[96px]">
    <h1 class="text-display-lg font-medium text-ink tracking-tight mb-8">{content.h1}</h1>
    
    <div class="prose max-w-none text-body-md text-body leading-relaxed flex flex-col gap-6">
      <p class="text-muted text-[13px]">{content.lastUpdated}</p>

      <p>{content.pWelcome}</p>

      <div class="border-t border-hairline my-4"></div>

      <h2 class="text-title-lg text-ink font-medium tracking-tight">{content.h1Use}</h2>
      <p>{content.p1Use}</p>

      <h2 class="text-title-lg text-ink font-medium tracking-tight">{content.h2Warranty}</h2>
      <p>{content.p2Warranty1}</p>
      <p class="italic font-medium">{content.p2Warranty2}</p>

      <h2 class="text-title-lg text-ink font-medium tracking-tight">{content.h3Liability}</h2>
      <p>{content.p3Liability}</p>

      <h2 class="text-title-lg text-ink font-medium tracking-tight">{content.h4Ip}</h2>
      <p>{content.p4Ip}</p>

      <h2 class="text-title-lg text-ink font-medium tracking-tight">{content.h5ThirdParty}</h2>
      <p>{content.p5ThirdParty}</p>

      <h2 class="text-title-lg text-ink font-medium tracking-tight">{content.h6Changes}</h2>
      <p>{content.p6Changes}</p>

      <h2 class="text-title-lg text-ink font-medium tracking-tight">{content.h7Contact}</h2>
      <p>
        {content.p7Contact}<!--email_off--><a href="mailto:support@isitkitchensafe.com" class="text-link hover:underline">support@isitkitchensafe.com</a><!--/email_off-->）联系我们。
      </p>
    </div>
  </section>
</Layout>
