---
import Layout from '../../../layouts/Layout.astro';
import comparisonsEs from '../../../data/comparisons.es.json';
import comparisonsPt from '../../../data/comparisons.pt.json';
import comparisonsZh from '../../../data/comparisons.zh-cn.json';
import comparisonsJa from '../../../data/comparisons.ja.json';
import type { SupportedLanguage } from '../../../i18n/ui';

export function getStaticPaths() {
  const locales: { lang: SupportedLanguage; data: typeof comparisonsEs }[] = [
    { lang: 'es', data: comparisonsEs },
    { lang: 'pt', data: comparisonsPt },
    { lang: 'zh-cn', data: comparisonsZh },
    { lang: 'ja', data: comparisonsJa }
  ];
  return locales.map(({ lang, data }) => ({
    params: { lang },
    props: {
      lang,
      comparisonsData: data,
      availableLocales: ['en', 'es', 'pt', 'zh-cn', 'ja'] as SupportedLanguage[]
    }
  }));
}

interface Props {
  lang: SupportedLanguage;
  comparisonsData: typeof comparisonsEs;
  availableLocales: SupportedLanguage[];
}

const { lang, comparisonsData, availableLocales } = Astro.props;
const isEs = lang === 'es';
const isPt = lang === 'pt';
const isZh = lang === 'zh-cn';
const isJa = lang === 'ja';

const pageTitle = isEs
  ? "Comparaciones de Seguridad en la Cocina | ¿Es Seguro en la Cocina?"
  : isPt
  ? "Comparações de Segurança na Cozinha | É Seguro na Cozinha?"
  : isZh
  ? "厨房用品与烹饪方式安全对比 | 厨房安全指南"
  : "キッチン用品・調理家電の安全性比較ガイド | キッチン安全チェッカー";

const pageDescription = isEs
  ? "Compara reglas de seguridad, electrodomésticos, métodos de cocción y recipientes frente a frente. Evaluaciones directas alineadas con el USDA y la FDA."
  : isPt
  ? "Compare regras de segurança, eletrodomésticos, métodos de cozimento e recipientes lado a lado. Avaliações completas e respaldadas pelo USDA e FDA."
  : isZh
  ? "直观对比厨房电器、器皿材质、食材保鲜与烹饪技巧的安全性。基于USDA和FDA官方标准的专业安全测评。"
  : "調理家電、容器素材、保存ルール、加熱方法の安全性を徹底比較。USDAおよびFDAの基準に基づいた信頼性の高い解説。";

const categoryNames: Record<string, string> = isEs
  ? {
      "cooking-method": "Métodos de Cocción",
      "container-material": "Recipientes y Materiales",
      "food-storage": "Almacenamiento de Alimentos",
      "appliance-safety": "Seguridad de Electrodomésticos"
    }
  : isPt
  ? {
      "cooking-method": "Métodos de Cozimento",
      "container-material": "Recipientes e Materiais",
      "food-storage": "Armazenamento de Alimentos",
      "appliance-safety": "Segurança de Eletrodomésticos"
    }
  : isZh
  ? {
      "cooking-method": "烹饪方式对比",
      "container-material": "器皿材质对比",
      "food-storage": "食材储存保鲜",
      "appliance-safety": "厨房电器安全"
    }
  : {
      "cooking-method": "調理方法・加熱器具",
      "container-material": "容器・素材の安全性",
      "food-storage": "食品保存・鮮度保持",
      "appliance-safety": "調理家電の安全性"
    };

const categories = ["cooking-method", "container-material", "food-storage", "appliance-safety"];
const groupedComparisons = categories.reduce((acc, cat) => {
  acc[cat] = comparisonsData.filter(c => c.category === cat);
  return acc;
}, {} as Record<string, typeof comparisonsData>);

const compareFaqs = isEs
  ? [
      {
        question: "¿Por qué comparar pautas de seguridad en la cocina?",
        answer: "Comparar electrodomésticos, métodos de cocción y materiales de recipientes lado a lado previene daños accidentales, migración química e intoxicaciones alimentarias."
      },
      {
        question: "¿Cuál es la fuente de estas recomendaciones de seguridad?",
        answer: "Todas las recomendaciones provienen de pautas oficiales del USDA, estándares de materiales de la FDA y manuales de fabricantes de electrodomésticos."
      },
      {
        question: "¿Cómo saber si un recipiente es seguro para microondas o lavavajillas?",
        answer: "Verifica los símbolos estampados en la base del recipiente o consulta nuestras tablas de comparación de materiales para obtener orientación precisa."
      }
    ]
  : isPt
  ? [
      {
        question: "Por que comparar diretrizes de segurança na cozinha?",
        answer: "Comparar eletrodomésticos, métodos de cozimento e materiais lado a lado evita acidentes domésticos, liberação química e intoxicações alimentares."
      },
      {
        question: "Qual é a fonte dessas recomendações de segurança?",
        answer: "Todas as diretrizes são baseadas em dados do USDA, padrões de contato da FDA e manuais de engenharia dos fabricantes."
      },
      {
        question: "Como saber se um pote pode ir ao micro-ondas ou lava-louças?",
        answer: "Confira as marcações estampadas no fundo da peça ou consulte nossos guias de materiais para verificar os limites térmicos exatos."
      }
    ]
  : isZh
  ? [
      {
        question: "为什么要对厨房安全和烹饪规范进行对比？",
        answer: "直观对比不同电器、烹饪方式及容器材质的耐热极限和物理特性，能有效预防火灾、有害物质析出及食品变质。"
      },
      {
        question: "这些安全对比的权威依据是什么？",
        answer: "所有评估依据均源于美国农业部（USDA）、美国食品药品监督管理局（FDA）食品接触安全规范，以及主流厨房电器制造商的技术手册。"
      },
      {
        question: "如何确认容器是否适用于特定电器？",
        answer: "请认准容器底部的官方材质三角标识及微波/洗碗机/烤箱适用图符，或参考我们详尽的材质耐温对比表。"
      }
    ]
  : [
      {
        question: "なぜ調理器具や保存方法の安全性を比較する必要があるのですか？",
        answer: "家電、調理法、容器素材ごとの耐熱限界や物理特性を比較することで、有害物質の溶出、機器の破損、食中毒などのトラブルを未然に防ぐことができます。"
      },
      {
        question: "この安全性比較のデータ根拠は何ですか？",
        answer: "すべての比較内容は、米国農務省（USDA）、米国食品医薬品局（FDA）の安全基準、および各家電メーカーの公式取扱説明書に基づいて検証されています。"
      },
      {
        question: "容器が電子レンジや食洗機に対応しているかどうやって確認しますか？",
        answer: "容器底面に刻印された「電子レンジ対応」「食洗機対応」のピクトグラムや耐熱温度表示を確認するか、当サイトの素材別詳細比較表をご参照ください。"
      }
    ];

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": isEs
    ? "Comparaciones de Seguridad en la Cocina"
    : isPt
    ? "Comparações de Segurança na Cozinha"
    : isZh
    ? "厨房用品与烹饪方式安全对比"
    : "キッチン用品・調理家電の安全性比較",
  "itemListElement": comparisonsData.map((item, idx) => ({
    "@type": "ListItem",
    "position": idx + 1,
    "url": `https://isitkitchensafe.com/${lang}/compare/${item.slug}/`
  }))
};
---

<Layout title={pageTitle} description={pageDescription} faqs={compareFaqs} excludeArticleSchema={true} availableLocales={availableLocales} lang={lang}>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(itemListSchema)} />
  <div class="bg-canvas min-h-screen">
    <!-- Hero Header Section -->
    <section class="border-b border-hairline py-[64px] md:py-[80px]">
      <div class="max-w-[1280px] mx-auto px-6 text-center md:text-left">
        <nav class="flex justify-center md:justify-start gap-2 text-muted text-[13px] mb-6 animate-fade-in" aria-label="Breadcrumb">
          <a href={`/${lang}/`} class="hover:text-ink transition-colors">{isEs ? "Inicio" : isPt ? "Início" : isZh ? "首页" : "ホーム"}</a>
          <span>/</span>
          <span class="text-ink font-medium">{isEs ? "Comparar" : isPt ? "Comparar" : isZh ? "物品对比" : "比較ガイド"}</span>
        </nav>

        <h1 class="text-display-lg md:text-display-xl font-medium tracking-tight text-ink mb-4">
          {isEs
            ? "Comparaciones de Seguridad en la Cocina"
            : isPt
            ? "Comparações de Segurança na Cozinha"
            : isZh
            ? "厨房用品与烹饪方式安全对比"
            : "キッチン用品・調理家電の安全性比較"}
        </h1>
        <p class="text-body-md text-muted max-w-[680px] leading-relaxed">
          {isEs
            ? "Compara electrodomésticos, recipientes, reglas de conservación y métodos de cocción lado a lado con información respaldada por el USDA y la FDA."
            : isPt
            ? "Compare eletrodomésticos, recipientes térmicos, prazos de conservação e técnicas culinárias lado a lado com respaldo científico do USDA e FDA."
            : isZh
            ? "直观对比厨房电器、器皿材质、食材保鲜与烹饪技巧的安全性，助您做出科学可靠的厨房决策。"
            : "調理家電、保存容器、食品衛生基準、調理器具の安全性を横断比較。安心・安全なキッチンのための実践的ガイド。"}
        </p>
      </div>
    </section>

    <!-- Search & Filter Controls -->
    <section class="border-b border-hairline py-8 bg-surface-soft/40">
      <div class="max-w-[1280px] mx-auto px-6 flex flex-col md:flex-row gap-6 justify-between items-center">
        <!-- Search Input -->
        <div class="relative w-full md:max-w-[400px]">
          <input 
            type="text" 
            id="compare-search"
            placeholder={isEs
              ? "Buscar comparaciones (ej. aluminio, freidora)..."
              : isPt
              ? "Pesquisar comparações (ex: alumínio, air fryer)..."
              : isZh
              ? "搜索对比文章（例如：铝箔、空气炸锅）..."
              : "比較記事を検索（例：アルミホイル、ノンフライヤー）..."} 
            aria-label={isEs
              ? "Buscar comparaciones"
              : isPt
              ? "Pesquisar comparações"
              : isZh
              ? "搜索对比文章"
              : "比較記事を検索"}
            class="w-full h-11 pl-4 pr-32 py-3 bg-canvas text-ink text-[14px] border border-hairline rounded-sm focus:outline-none focus:border-info-border"
          />
          <span class="absolute right-3 top-3 text-muted text-[13px] pointer-events-none" id="search-count" data-match-suffix={isEs ? "coincidencias" : isPt ? "resultados" : isZh ? "条对比" : "件の比較"}>
            {comparisonsData.length} {isEs ? "coincidencias" : isPt ? "resultados" : isZh ? "条对比" : "件の比較"}
          </span>
        </div>

        <!-- Category Filters -->
        <div class="flex flex-wrap gap-2 justify-center md:justify-end w-full md:w-auto" id="filter-buttons">
          <button 
            data-filter="all"
            class="min-h-[44px] px-4 py-2.5 bg-primary text-on-primary text-[13px] font-medium rounded-lg border-none cursor-pointer transition-colors select-none active:scale-95 inline-flex items-center justify-center"
          >
            {isEs ? "Todas las Categorías" : isPt ? "Todas as Categorias" : isZh ? "全部类别" : "すべてのカテゴリー"}
          </button>
          {categories.map(cat => (
            <button 
              data-filter={cat}
              class="min-h-[44px] px-4 py-2.5 bg-canvas text-body hover:text-ink text-[13px] font-medium border border-hairline rounded-lg cursor-pointer transition-colors select-none active:scale-95 inline-flex items-center justify-center"
            >
              {categoryNames[cat]}
            </button>
          ))}
        </div>
      </div>
    </section>

    <!-- Comparisons Grid -->
    <section class="max-w-[1280px] mx-auto px-6 py-12">
      <div id="no-results-msg" class="hidden text-center py-12">
        <p class="text-lg font-medium text-ink mb-2">
          {isEs
            ? "No se encontraron comparaciones"
            : isPt
            ? "Nenhuma comparação encontrada"
            : isZh
            ? "未找到相关对比"
            : "該当する比較記事が見つかりませんでした"}
        </p>
        <p class="text-sm text-muted">
          {isEs
            ? "Prueba ajustando tus términos de búsqueda o restableciendo los filtros."
            : isPt
            ? "Tente ajustar seus termos de pesquisa ou redefinir os filtros."
            : isZh
            ? "请尝试调整搜索关键词或重置分类筛选条件。"
            : "検索キーワードを変更するか、フィルターをリセットしてお試しください。"}
        </p>
      </div>

      <div id="comparisons-container" class="flex flex-col gap-12">
        {categories.map(cat => (
          <div data-category-section={cat} class="category-section">
            <h2 class="text-title-lg font-bold text-ink mb-6 pb-2 border-b border-hairline">
              {categoryNames[cat]}
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {groupedComparisons[cat].map(item => {
                let winnerText = isEs || isPt ? "Depende" : isZh ? "视情况而定" : "用途による";
                let winnerClass = "bg-surface-strong text-muted";
                if (item.winner === "item1") {
                  winnerText = isEs ? `${item.item1} Gana` : isPt ? `${item.item1} Vence` : isZh ? `${item.item1} 胜出` : `${item.item1} 推奨`;
                  winnerClass = "bg-success-bg text-success font-medium";
                } else if (item.winner === "item2") {
                  winnerText = isEs ? `${item.item2} Gana` : isPt ? `${item.item2} Vence` : isZh ? `${item.item2} 胜出` : `${item.item2} 推奨`;
                  winnerClass = "bg-success-bg text-success font-medium";
                }
                
                return (
                  <a 
                    href={`/${lang}/compare/${item.slug}/`} 
                    class="compare-card block border border-hairline rounded-lg p-6 bg-canvas hover:border-border-strong hover:shadow-sm transition-all text-decoration-none"
                    data-search-term={`${item.item1.toLowerCase()} ${item.item2.toLowerCase()} ${item.slug.replace(/-/g, ' ')}`}
                  >
                    <div class="flex items-center justify-between text-xs text-muted font-bold uppercase tracking-wider mb-4">
                      <span>{categoryNames[cat]}</span>
                      <span class={`px-2.5 py-1 rounded-pill text-[11px] ${winnerClass}`}>
                        {winnerText}
                      </span>
                    </div>

                    <!-- Mini comparison layout with VS divider -->
                    <div class="flex items-center justify-between border border-hairline rounded-lg overflow-hidden bg-surface-soft/40 mb-4 min-h-[64px] h-auto py-2">
                      <div class="flex-1 px-3 py-1 text-center flex items-center justify-center h-full">
                        <span class="font-medium text-ink text-[13px] line-clamp-2 leading-snug">{item.item1}</span>
                      </div>
                      <div class="px-2.5 py-1 bg-primary text-on-primary text-[10px] font-bold font-display uppercase tracking-wider shrink-0 select-none">
                        VS
                      </div>
                      <div class="flex-1 px-3 py-1 text-center flex items-center justify-center h-full">
                        <span class="font-medium text-ink text-[13px] line-clamp-2 leading-snug">{item.item2}</span>
                      </div>
                    </div>

                    <p class="text-body-md text-muted line-clamp-2 leading-relaxed text-[13px]">
                      {item.verdict}
                    </p>
                    
                    <div class="mt-4 flex items-center gap-1 text-[13px] text-link font-medium">
                      <span>{isEs ? "Leer comparación detallada" : isPt ? "Ler comparação detalhada" : isZh ? "查看详细对比" : "詳細な比較を見る"}</span>
                      <span class="text-[11px]">→</span>
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('compare-search') as HTMLInputElement | null;
    const filterButtons = document.querySelectorAll('#filter-buttons button');
    const sections = document.querySelectorAll('.category-section');
    const searchCountSpan = document.getElementById('search-count');
    const noResultsMsg = document.getElementById('no-results-msg');
    const suffix = searchCountSpan?.getAttribute('data-match-suffix') || 'matches';
    
    let currentFilter = 'all';
    let searchQuery = '';

    const filterComparisons = () => {
      let visibleCount = 0;

      sections.forEach(section => {
        const sectionCat = section.getAttribute('data-category-section');
        const sectionCards = section.querySelectorAll('.compare-card');
        let sectionVisibleCards = 0;

        sectionCards.forEach(card => {
          const searchTerm = card.getAttribute('data-search-term') || '';
          const matchesSearch = searchTerm.includes(searchQuery);
          const matchesCategory = currentFilter === 'all' || sectionCat === currentFilter;

          if (matchesSearch && matchesCategory) {
            card.classList.remove('hidden');
            sectionVisibleCards++;
            visibleCount++;
          } else {
            card.classList.add('hidden');
          }
        });

        if (sectionVisibleCards > 0) {
          section.classList.remove('hidden');
        } else {
          section.classList.add('hidden');
        }
      });

      if (searchCountSpan) {
        searchCountSpan.textContent = `${visibleCount} ${suffix}`;
      }

      if (visibleCount === 0) {
        noResultsMsg?.classList.remove('hidden');
      } else {
        noResultsMsg?.classList.add('hidden');
      }
    };

    if (searchInput) {
      searchInput.addEventListener('input', () => {
        searchQuery = searchInput.value.trim().toLowerCase();
        filterComparisons();
      });
    }

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        filterButtons.forEach(b => {
          b.classList.remove('bg-primary', 'text-on-primary');
          b.classList.add('bg-canvas', 'text-body', 'border', 'border-hairline');
        });

        btn.classList.remove('bg-canvas', 'text-body', 'border', 'border-hairline');
        btn.classList.add('bg-primary', 'text-on-primary');

        currentFilter = btn.getAttribute('data-filter') || 'all';
        filterComparisons();
      });
    });
  });
</script>
