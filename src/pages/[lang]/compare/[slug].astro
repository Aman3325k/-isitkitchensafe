---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import comparisonsEs from '../../../data/comparisons.es.json';
import comparisonsPt from '../../../data/comparisons.pt.json';
import comparisonsZh from '../../../data/comparisons.zh-cn.json';
import comparisonsJa from '../../../data/comparisons.ja.json';
import itemsEs from '../../../data/items.es.json';
import itemsPt from '../../../data/items.pt.json';
import itemsZh from '../../../data/items.zh-cn.json';
import itemsJa from '../../../data/items.ja.json';
import howLongEs from '../../../data/how-long.es.json';
import howLongPt from '../../../data/how-long.pt.json';
import howLongZh from '../../../data/how-long.zh-cn.json';
import howLongJa from '../../../data/how-long.ja.json';
import refreezeEs from '../../../data/refreeze.es.json';
import refreezePt from '../../../data/refreeze.pt.json';
import refreezeZh from '../../../data/refreeze.zh-cn.json';
import refreezeJa from '../../../data/refreeze.ja.json';
import washingEs from '../../../data/washing-machine.es.json';
import washingPt from '../../../data/washing-machine.pt.json';
import washingZh from '../../../data/washing-machine.zh-cn.json';
import washingJa from '../../../data/washing-machine.ja.json';
import { getDirectoryUrl, useTranslatedPath } from '../../../i18n/utils';
import type { SupportedLanguage } from '../../../i18n/ui';

export async function getStaticPaths() {
  const allLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'zh-cn', 'ja'];
  const locales: { lang: SupportedLanguage; data: typeof comparisonsEs }[] = [
    { lang: 'es', data: comparisonsEs },
    { lang: 'pt', data: comparisonsPt },
    { lang: 'zh-cn', data: comparisonsZh },
    { lang: 'ja', data: comparisonsJa }
  ];

  return locales.flatMap(({ lang, data }) =>
    data.map(item => ({
      params: { lang, slug: item.slug },
      props: {
        lang,
        comparison: item,
        availableLocales: allLocales
      }
    }))
  );
}

interface Props {
  lang: SupportedLanguage;
  comparison: typeof comparisonsEs[number];
  availableLocales: SupportedLanguage[];
}

const { lang, comparison, availableLocales } = Astro.props as Props;
const isEs = lang === 'es';
const isPt = lang === 'pt';
const isZh = lang === 'zh-cn';

const {
  slug,
  category,
  item1,
  item2,
  winner,
  verdict,
  table,
  item1Pros,
  item2Pros,
  useCases,
  safetyNotes,
  faqs,
  relatedComparisons,
  relatedItems
} = comparison;

// Human-readable category names
const categoryNames: Record<string, string> = ({
  es: {
    "cooking-method": "Métodos de Cocción",
    "container-material": "Recipientes y Materiales",
    "food-storage": "Almacenamiento de Alimentos",
    "appliance-safety": "Seguridad de Electrodomésticos"
  },
  pt: {
    "cooking-method": "Métodos de Cozimento",
    "container-material": "Recipientes e Materiais",
    "food-storage": "Armazenamento de Alimentos",
    "appliance-safety": "Segurança de Eletrodomésticos"
  },
  'zh-cn': {
    "cooking-method": "烹饪方式对比",
    "container-material": "器皿材质对比",
    "food-storage": "食材储存保鲜",
    "appliance-safety": "厨房电器安全"
  },
  ja: {
    "cooking-method": "調理方法・加熱器具",
    "container-material": "容器・素材の安全性",
    "food-storage": "食品保存・鮮度保持",
    "appliance-safety": "調理家電の安全性"
  }
} as Record<string, Record<string, string>>)[lang] || {
  "cooking-method": "Cooking Methods",
  "container-material": "Containers & Materials",
  "food-storage": "Food Storage",
  "appliance-safety": "Appliance Safety"
};

function getMetaDescription(i1: string, i2: string, win: string, verd: string) {
  let prefix = "";
  if (isEs) {
    if (win === "item1") {
      prefix = `¿Es mejor ${i1} o ${i2}? Nuestra guía de seguridad señala a ${i1} como ganador. `;
    } else if (win === "item2") {
      prefix = `¿Es mejor ${i1} o ${i2}? Nuestra guía de seguridad señala a ${i2} como ganador. `;
    } else {
      prefix = `¿Es mejor ${i1} o ${i2}? Nuestra comparativa detalla cuándo utilizar cada uno. `;
    }
  } else if (isPt) {
    if (win === "item1") {
      prefix = `É melhor ${i1} ou ${i2}? Nosso guia de segurança aponta ${i1} como vencedor. `;
    } else if (win === "item2") {
      prefix = `É melhor ${i1} ou ${i2}? Nosso guia de segurança aponta ${i2} como vencedor. `;
    } else {
      prefix = `É melhor ${i1} ou ${i2}? Nosso comparativo detalha quando usar cada opção. `;
    }
  } else if (isZh) {
    if (win === "item1") {
      prefix = `${i1}与${i2}哪个更好？安全指南评定${i1}更胜一筹。`;
    } else if (win === "item2") {
      prefix = `${i1}与${i2}哪个更好？安全指南评定${i2}更胜一筹。`;
    } else {
      prefix = `${i1}与${i2}该怎么选？安全指南详细对比了两者的适用场景。`;
    }
  } else {
    if (win === "item1") {
      prefix = `${i1}と${i2}はどちらがおすすめ？安全ガイドでは${i1}を推奨しています。`;
    } else if (win === "item2") {
      prefix = `${i1}と${i2}はどちらがおすすめ？安全ガイドでは${i2}を推奨しています。`;
    } else {
      prefix = `${i1}と${i2}の使い分けは？それぞれの特徴と安全性を徹底比較。`;
    }
  }
  
  let desc = `${prefix}${verd}`;
  
  if (isEs || isPt) {
    if (desc.length < 150) {
      const suffix = isEs
        ? " Consulta nuestra tabla comparativa detallada, ventajas y pautas de seguridad."
        : " Confira nossa tabela comparativa completa, vantagens e dicas de segurança.";
      desc = (desc + suffix).substring(0, 160);
    }
    if (desc.length > 160) {
      desc = desc.substring(0, 157) + "...";
    }
    if (desc.length < 150) {
      desc = desc.padEnd(150, '.');
    }
  } else {
    if (desc.length < 110) {
      const suffix = isZh
        ? " 查看详尽的耐热对比表、优缺点分析及厨房安全操作守则。"
        : " 耐熱温度・メリット比較表や注意すべき安全ポイントを詳しく解説。";
      desc = (desc + suffix).substring(0, 160);
    }
    if (desc.length > 160) {
      desc = desc.substring(0, 157) + "...";
    }
  }
  
  return desc;
}

const pageTitle = isEs
  ? `${item1} vs ${item2}: ¿Cuál es Mejor? | ¿Es Seguro en la Cocina?`
  : isPt
  ? `${item1} vs ${item2}: Qual É Melhor? | É Seguro na Cozinha?`
  : isZh
  ? `${item1}与${item2}对比：哪个更好？怎么选？ | 厨房安全指南`
  : `${item1} vs ${item2} 徹底比較：おすすめはどっち？ | キッチン安全チェッカー`;

const pageDescription = getMetaDescription(item1, item2, winner, verdict);

const comparisonsData = isEs ? comparisonsEs : isPt ? comparisonsPt : isZh ? comparisonsZh : comparisonsJa;
let relatedComparisonObjects = comparisonsData.filter(c => 
  relatedComparisons.includes(c.slug) && c.slug !== slug
);
if (relatedComparisonObjects.length < 4) {
  const extraComps = comparisonsData.filter(c => 
    c.slug !== slug && !relatedComparisons.includes(c.slug)
  );
  for (const c of extraComps) {
    if (relatedComparisonObjects.length >= 4) break;
    relatedComparisonObjects.push(c);
  }
}
relatedComparisonObjects = relatedComparisonObjects.slice(0, 4);

const applianceNamesMap: Record<string, Record<string, string>> = {
  dishwasher: { es: 'Lavavajillas', pt: 'Lava-Louças', 'zh-cn': '洗碗机', ja: '食洗機' },
  microwave: { es: 'Microondas', pt: 'Micro-ondas', 'zh-cn': '微波炉', ja: '電子レンジ' },
  oven: { es: 'Horno', pt: 'Forno', 'zh-cn': '烤箱', ja: 'オーブン' },
  freezer: { es: 'Congelador', pt: 'Freezer', 'zh-cn': '冷冻室', ja: '冷凍庫' },
  airfryer: { es: 'Freidora de Aire', pt: 'Fritadeira sem Óleo', 'zh-cn': '空气炸锅', ja: 'ノンフライヤー' },
  refrigerator: { es: 'Refrigerador', pt: 'Geladeira', 'zh-cn': '冰箱冷藏室', ja: '冷蔵庫' },
  dryer: { es: 'Secadora', pt: 'Secadora', 'zh-cn': '烘干机', ja: '乾燥機' },
  'washing-machine': { es: 'Lavadora', pt: 'Máquina de Lavar', 'zh-cn': '洗衣机', ja: '洗濯機' }
};

function formatItemLinkText(url: string) {
  const parts = url.split('/').filter(Boolean);
  const cleanParts = parts.filter(p => p !== 'es' && p !== 'pt' && p !== 'zh-cn' && p !== 'ja');
  if (cleanParts.length < 2) {
    return isEs ? "Guía de Seguridad en Cocina" : isPt ? "Guia de Segurança na Cozinha" : isZh ? "厨房安全指南" : "キッチン安全ガイド";
  }
  const app = cleanParts[0];
  const localizedApp = (applianceNamesMap[app] as any)?.[lang] || (app.charAt(0).toUpperCase() + app.slice(1));
  const itm = cleanParts[1].split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
  if (isEs) return `Guía de ${itm} en ${localizedApp}`;
  if (isPt) return `Guia de ${itm} em ${localizedApp}`;
  if (isZh) return `${localizedApp}${itm}安全指南`;
  return `${localizedApp}での${itm}安全ガイド`;
}

const activeItems = isEs ? itemsEs : isPt ? itemsPt : isZh ? itemsZh : itemsJa;
const activeHowLong = isEs ? howLongEs : isPt ? howLongPt : isZh ? howLongZh : howLongJa;
const activeRefreeze = isEs ? refreezeEs : isPt ? refreezePt : isZh ? refreezeZh : refreezeJa;
const activeWashing = isEs ? washingEs : isPt ? washingPt : isZh ? washingZh : washingJa;

function normalizeName(name: string) {
  return name.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim();
}

function resolveItemPageUrl(itemName: string) {
  const norm = normalizeName(itemName);
  const match = activeItems.find(i => normalizeName(i.item) === norm);
  if (match) return `/${lang}/${match.appliance}/${match.slug}/`;
  
  const hlMatch = activeHowLong.find(h => normalizeName(h.item) === norm);
  if (hlMatch) return `/${lang}/how-long/${hlMatch.slug}/`;
  
  const rfMatch = activeRefreeze.find(r => normalizeName(r.item) === norm);
  if (rfMatch) return `/${lang}/refreeze/${rfMatch.slug}/`;
  
  const wMatch = activeWashing.find(w => normalizeName(w.item) === norm);
  if (wMatch) return `/${lang}/washing-machine/${wMatch.slug}/`;
  
  return null;
}

const item1Url = resolveItemPageUrl(item1);
const item2Url = resolveItemPageUrl(item2);
const individualGuides: { name: string; url: string }[] = [];
if (item1Url) individualGuides.push({ name: item1, url: item1Url });
if (item2Url) individualGuides.push({ name: item2, url: item2Url });

if (relatedItems) {
  relatedItems.forEach(url => {
    let cleanUrl = url.endsWith('/') ? url : `${url}/`;
    if (!cleanUrl.startsWith(`/${lang}/`)) {
      cleanUrl = `/${lang}${cleanUrl.startsWith('/') ? '' : '/'}${cleanUrl}`;
    }
    if (!individualGuides.some(g => g.url === cleanUrl)) {
      individualGuides.push({ name: formatItemLinkText(cleanUrl), url: cleanUrl });
    }
  });
}

const preservationGuides: { name: string; url: string; label: string }[] = [];
const addPreservationGuide = (name: string, url: string, label: string) => {
  const cleanUrl = url.endsWith('/') ? url : `${url}/`;
  if (!preservationGuides.some(g => g.url === cleanUrl)) {
    preservationGuides.push({ name, url: cleanUrl, label });
  }
};

const hlLabel = isEs ? 'Vida Útil' : isPt ? 'Validade' : isZh ? '保质期' : '保存期間';
const rfLabel = isEs ? 'Recongelación' : isPt ? 'Recongelamento' : isZh ? '二次冷冻' : '再冷凍';

const item1Norm = normalizeName(item1);
const item1Hl = activeHowLong.find(h => normalizeName(h.item) === item1Norm);
if (item1Hl) {
  const hlQuestion = isEs ? `¿Cuánto Dura ${item1Hl.item}?` : isPt ? `Quanto Tempo Dura ${item1Hl.item}?` : isZh ? `${item1Hl.item}能保存多久？` : `${item1Hl.item}の保存期間は？`;
  addPreservationGuide(hlQuestion, `/${lang}/how-long/${item1Hl.slug}/`, hlLabel);
}
const item1Rf = activeRefreeze.find(r => normalizeName(r.item) === item1Norm);
if (item1Rf) {
  const rfQuestion = isEs ? `¿Se Puede Recongelar ${item1Rf.item}?` : isPt ? `Pode Recongelar ${item1Rf.item}?` : isZh ? `${item1Rf.item}可以二次冷冻吗？` : `${item1Rf.item}は再冷凍できる？`;
  addPreservationGuide(rfQuestion, `/${lang}/refreeze/${item1Rf.slug}/`, rfLabel);
}

const item2Norm = normalizeName(item2);
const item2Hl = activeHowLong.find(h => normalizeName(h.item) === item2Norm);
if (item2Hl) {
  const hlQuestion = isEs ? `¿Cuánto Dura ${item2Hl.item}?` : isPt ? `Quanto Tempo Dura ${item2Hl.item}?` : isZh ? `${item2Hl.item}能保存多久？` : `${item2Hl.item}の保存期間は？`;
  addPreservationGuide(hlQuestion, `/${lang}/how-long/${item2Hl.slug}/`, hlLabel);
}
const item2Rf = activeRefreeze.find(r => normalizeName(r.item) === item2Norm);
if (item2Rf) {
  const rfQuestion = isEs ? `¿Se Puede Recongelar ${item2Rf.item}?` : isPt ? `Pode Recongelar ${item2Rf.item}?` : isZh ? `${item2Rf.item}可以二次冷冻吗？` : `${item2Rf.item}は再冷凍できる？`;
  addPreservationGuide(rfQuestion, `/${lang}/refreeze/${item2Rf.slug}/`, rfLabel);
}

const pageCanonical = `https://isitkitchensafe.com/${lang}/compare/${slug}/`;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": isEs ? "Inicio" : isPt ? "Início" : isZh ? "首页" : "ホーム",
      "item": `https://isitkitchensafe.com/${lang}/`
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": isEs || isPt ? "Comparar" : isZh ? "安全对比" : "比較ガイド",
      "item": `https://isitkitchensafe.com/${lang}/compare/`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": `${item1} vs ${item2}`,
      "item": pageCanonical
    }
  ]
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": isEs
    ? `${item1} vs ${item2}: ¿Cuál es Mejor?`
    : isPt
    ? `${item1} vs ${item2}: Qual É Melhor?`
    : isZh
    ? `${item1}与${item2}对比：哪个更好？怎么选？`
    : `${item1} vs ${item2} 徹底比較：おすすめはどっち？`,
  "description": pageDescription,
  "image": "https://isitkitchensafe.com/favicon.svg",
  "author": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "logo": {
      "@type": "ImageObject",
      "url": "https://isitkitchensafe.com/favicon.svg"
    }
  },
  "datePublished": "2026-06-13T12:00:00Z",
  "dateModified": "2026-06-13T12:00:00Z",
  "mainEntityOfPage": pageCanonical
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};

// Smart Contextual Consumer Calculator Recommendation (Localized)
const translatePath = useTranslatedPath(lang);
const methodologyUrl = getDirectoryUrl('methodology', lang);
const contactUrl = getDirectoryUrl('contact', lang);

const toolMatchSlug = slug.toLowerCase();
const toolMatchCategory = String(category || '').toLowerCase();
type RecommendedToolKey =
  | 'kitchenFire'
  | 'instantPot'
  | 'slowCooker'
  | 'moldyFood'
  | 'pantry'
  | 'allergy'
  | 'dishwasherDosage'
  | 'induction'
  | 'ovenRack'
  | 'castIron'
  | 'powerOutage'
  | 'babyBottle'
  | 'oilSmokePoint'
  | 'fridgeZone'
  | 'cleaner'
  | 'descaling'
  | 'plastic'
  | 'airfryer'
  | 'microwave'
  | 'thawing'
  | 'cookingTemp'
  | 'leftover'
  | 'ovenTemp'
  | 'symbol';

let recommendedToolKey: RecommendedToolKey = 'symbol';
if (/(grease-fire|never-use-water|\bfire\b)/.test(toolMatchSlug)) {
  recommendedToolKey = 'kitchenFire';
} else if (/^slow-cooker|crock-pot/.test(toolMatchSlug)) {
  recommendedToolKey = 'slowCooker';
} else if (/(instant-pot|pressure-cooker)/.test(toolMatchSlug)) {
  recommendedToolKey = 'instantPot';
} else if (/(slow-cooker|crock-pot)/.test(toolMatchSlug)) {
  recommendedToolKey = 'slowCooker';
} else if (/(gasket-mold|bleach|ammonia|(?:hydrogen-)?peroxide(?!-cured)|baking-soda|bar-keepers-friend|sponge)/.test(toolMatchSlug)) {
  recommendedToolKey = 'cleaner';
} else if (/(descal(?:e|ing)|french-press|tea-infuser|coffee-maker|coffee|kettles?|espresso|moka)/.test(toolMatchSlug)) {
  recommendedToolKey = 'descaling';
} else if (/\bvinegar\b/.test(toolMatchSlug)) {
  recommendedToolKey = 'cleaner';
} else if (/(moldy|\bmold\b)/.test(toolMatchSlug)) {
  recommendedToolKey = 'moldyFood';
} else if (/(dented-can|botulism|baking-powder|spices|flour|\bpantry\b|mortar-and-pestle)/.test(toolMatchSlug)) {
  recommendedToolKey = 'pantry';
} else if (/(allergy|cross-contact|celiac|\btoaster\b(?!-oven))/.test(toolMatchSlug)) {
  recommendedToolKey = 'allergy';
} else if (/(cast-iron|carbon-steel|seasoning|\brust\b)/.test(toolMatchSlug)) {
  recommendedToolKey = 'castIron';
} else if (/(cloudy-dishwasher|dishwasher-pod|detergent|hard-water|etching|crystal)/.test(toolMatchSlug)) {
  recommendedToolKey = 'dishwasherDosage';
} else if (/(induction|magnet-test)/.test(toolMatchSlug)) {
  recommendedToolKey = 'induction';
} else if (/(colander|blender|sous-vide|plastic|microplastic|styrofoam|meal-prep|tupperware|ziploc|cutting-board|bamboo-vs-hardwood|tritan|polypropylene|paper-composite|citrus-juicer)/.test(toolMatchSlug)) {
  recommendedToolKey = 'plastic';
} else if (/(oven-rack|25-degree|silicone|oven-mitt|whisk|parchment-paper-vs-aluminum-foil|aluminum-foil-vs-parchment-paper)/.test(toolMatchSlug)) {
  recommendedToolKey = 'ovenRack';
} else if (/(power-outage|blackout)/.test(toolMatchSlug)) {
  recommendedToolKey = 'powerOutage';
} else if (/(baby-bottle|kids-plate|sippy|sterilizer)/.test(toolMatchSlug)) {
  recommendedToolKey = 'babyBottle';
} else if (/(smoke-point|frying-oil|cooking-oil|oil-dispenser)/.test(toolMatchSlug)) {
  recommendedToolKey = 'oilSmokePoint';
} else if (/(corningware|pyrex-plastic-lid)/.test(toolMatchSlug)) {
  recommendedToolKey = 'ovenTemp';
} else if (/air-fryer/.test(toolMatchSlug)) {
  recommendedToolKey = 'airfryer';
} else if (/(microwave|wattage)/.test(toolMatchSlug)) {
  recommendedToolKey = 'microwave';
} else if (/(thaw|refreeze|freezer-burn|turkey|holiday|raw-vs-cooked-freezing|fridge-vs-freezer-chicken)/.test(toolMatchSlug)) {
  recommendedToolKey = 'thawing';
} else if (/(leftover|rice-pasta|fried-rice|store-leftovers)/.test(toolMatchSlug)) {
  recommendedToolKey = 'leftover';
} else if (/(fridge|refrigerator|refrigeration|produce|vegetables)/.test(toolMatchSlug)) {
  recommendedToolKey = 'fridgeZone';
} else if (/(freezer-mistakes|vacuum-seal-vs-regular-freezer|freezer-bag-vs-container)/.test(toolMatchSlug)) {
  recommendedToolKey = 'leftover';
} else if (/(internal-cooking|meat-poultry|baking-vs-broiling|grilling|steamer|steaming-vs-boiling|stovetop-vs-oven|thermometer)/.test(toolMatchSlug)) {
  recommendedToolKey = 'cookingTemp';
} else if (/(mixing-bowl|dutch-oven|pizza-stone|baking-steel|pyrex|hexclad|caraway|le-creuset|lodge|nonstick|stainless|copper-core|copper|porcelain|stoneware|enameled-steel|oven-safe|cookware|bakeware|baking-sheet|parchment|wax-paper|ceramic-vs-metal|oven-vs-toaster-oven)/.test(toolMatchSlug)) {
  recommendedToolKey = 'ovenTemp';
} else if (toolMatchCategory === 'cooking-method') {
  recommendedToolKey = 'cookingTemp';
}

const interactiveToolBadge = isEs
  ? 'Herramienta Interactiva'
  : isPt
  ? 'Ferramenta Interativa'
  : isZh
  ? '互动计算工具'
  : 'インタラクティブツール';

const toolCatalog: Record<RecommendedToolKey, {
  path: string;
  icon: string;
  title: string;
  description: string;
  cta: string;
}> = {
  kitchenFire: {
    path: '/tools/kitchen-fire-emergency-guide/',
    icon: '🚒',
    title: isEs ? 'Guía de Emergencia: Fuego de Aceite, Eléctrico y Quemaduras en Cocina' :
           isPt ? 'Guia de Emergência: Fogo de Óleo, Elétrico e Queimaduras na Cozinha' :
           isZh ? '厨房油锅起火、电气火灾与烫伤急救应急指南' :
