---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import comparisonsEs from '../../../data/comparisons.es.json';
import comparisonsPt from '../../../data/comparisons.pt.json';
import comparisonsZh from '../../../data/comparisons.zh-cn.json';
import comparisonsJa from '../../../data/comparisons.ja.json';
import itemsEs from '../../../data/items.es.json';
import itemsPt from '../../../data/items.pt.json';
import itemsZh from '../../../data/items.zh-cn.json';
import itemsJa from '../../../data/items.ja.json';
import howLongEs from '../../../data/how-long.es.json';
import howLongPt from '../../../data/how-long.pt.json';
import howLongZh from '../../../data/how-long.zh-cn.json';
import howLongJa from '../../../data/how-long.ja.json';
import refreezeEs from '../../../data/refreeze.es.json';
import refreezePt from '../../../data/refreeze.pt.json';
import refreezeZh from '../../../data/refreeze.zh-cn.json';
import refreezeJa from '../../../data/refreeze.ja.json';
import washingEs from '../../../data/washing-machine.es.json';
import washingPt from '../../../data/washing-machine.pt.json';
import washingZh from '../../../data/washing-machine.zh-cn.json';
import washingJa from '../../../data/washing-machine.ja.json';
import { getDirectoryUrl, useTranslatedPath } from '../../../i18n/utils';
import type { SupportedLanguage } from '../../../i18n/ui';

export async function getStaticPaths() {
  const allLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'zh-cn', 'ja'];
  const locales: { lang: SupportedLanguage; data: typeof comparisonsEs }[] = [
    { lang: 'es', data: comparisonsEs },
    { lang: 'pt', data: comparisonsPt },
    { lang: 'zh-cn', data: comparisonsZh },
    { lang: 'ja', data: comparisonsJa }
  ];

  return locales.flatMap(({ lang, data }) =>
    data.map(item => ({
      params: { lang, slug: item.slug },
      props: {
        lang,
        comparison: item,
        availableLocales: allLocales
      }
    }))
  );
}

interface Props {
  lang: SupportedLanguage;
  comparison: typeof comparisonsEs[number];
  availableLocales: SupportedLanguage[];
}

const { lang, comparison, availableLocales } = Astro.props as Props;
const isEs = lang === 'es';
const isPt = lang === 'pt';
const isZh = lang === 'zh-cn';

const {
  slug,
  category,
  item1,
  item2,
  winner,
  verdict,
  table,
  item1Pros,
  item2Pros,
  useCases,
  safetyNotes,
  faqs,
  relatedComparisons,
  relatedItems
} = comparison;

// Human-readable category names
const categoryNames: Record<string, string> = ({
  es: {
    "cooking-method": "Métodos de Cocción",
    "container-material": "Recipientes y Materiales",
    "food-storage": "Almacenamiento de Alimentos",
    "appliance-safety": "Seguridad de Electrodomésticos"
  },
  pt: {
    "cooking-method": "Métodos de Cozimento",
    "container-material": "Recipientes e Materiais",
    "food-storage": "Armazenamento de Alimentos",
    "appliance-safety": "Segurança de Eletrodomésticos"
  },
  'zh-cn': {
    "cooking-method": "烹饪方式对比",
    "container-material": "器皿材质对比",
    "food-storage": "食材储存保鲜",
    "appliance-safety": "厨房电器安全"
  },
  ja: {
    "cooking-method": "調理方法・加熱器具",
    "container-material": "容器・素材の安全性",
    "food-storage": "食品保存・鮮度保持",
    "appliance-safety": "調理家電の安全性"
  }
} as Record<string, Record<string, string>>)[lang] || {
  "cooking-method": "Cooking Methods",
  "container-material": "Containers & Materials",
  "food-storage": "Food Storage",
  "appliance-safety": "Appliance Safety"
};

function getMetaDescription(i1: string, i2: string, win: string, verd: string) {
  let prefix = "";
  if (isEs) {
    if (win === "item1") {
      prefix = `¿Es mejor ${i1} o ${i2}? Nuestra guía de seguridad señala a ${i1} como ganador. `;
    } else if (win === "item2") {
      prefix = `¿Es mejor ${i1} o ${i2}? Nuestra guía de seguridad señala a ${i2} como ganador. `;
    } else {
      prefix = `¿Es mejor ${i1} o ${i2}? Nuestra comparativa detalla cuándo utilizar cada uno. `;
    }
  } else if (isPt) {
    if (win === "item1") {
      prefix = `É melhor ${i1} ou ${i2}? Nosso guia de segurança aponta ${i1} como vencedor. `;
    } else if (win === "item2") {
      prefix = `É melhor ${i1} ou ${i2}? Nosso guia de segurança aponta ${i2} como vencedor. `;
    } else {
      prefix = `É melhor ${i1} ou ${i2}? Nosso comparativo detalha quando usar cada opção. `;
    }
  } else if (isZh) {
    if (win === "item1") {
      prefix = `${i1}与${i2}哪个更好？安全指南评定${i1}更胜一筹。`;
    } else if (win === "item2") {
      prefix = `${i1}与${i2}哪个更好？安全指南评定${i2}更胜一筹。`;
    } else {
      prefix = `${i1}与${i2}该怎么选？安全指南详细对比了两者的适用场景。`;
    }
  } else {
    if (win === "item1") {
      prefix = `${i1}と${i2}はどちらがおすすめ？安全ガイドでは${i1}を推奨しています。`;
    } else if (win === "item2") {
      prefix = `${i1}と${i2}はどちらがおすすめ？安全ガイドでは${i2}を推奨しています。`;
    } else {
      prefix = `${i1}と${i2}の使い分けは？それぞれの特徴と安全性を徹底比較。`;
    }
  }
  
  let desc = `${prefix}${verd}`;
  
  if (isEs || isPt) {
    if (desc.length < 150) {
      const suffix = isEs
        ? " Consulta nuestra tabla comparativa detallada, ventajas y pautas de seguridad."
        : " Confira nossa tabela comparativa completa, vantagens e dicas de segurança.";
      desc = (desc + suffix).substring(0, 160);
    }
    if (desc.length > 160) {
      desc = desc.substring(0, 157) + "...";
    }
    if (desc.length < 150) {
      desc = desc.padEnd(150, '.');
    }
  } else {
    if (desc.length < 110) {
      const suffix = isZh
        ? " 查看详尽的耐热对比表、优缺点分析及厨房安全操作守则。"
        : " 耐熱温度・メリット比較表や注意すべき安全ポイントを詳しく解説。";
      desc = (desc + suffix).substring(0, 160);
    }
    if (desc.length > 160) {
      desc = desc.substring(0, 157) + "...";
    }
  }
  
  return desc;
}

const pageTitle = isEs
  ? `${item1} vs ${item2}: ¿Cuál es Mejor? | ¿Es Seguro en la Cocina?`
  : isPt
  ? `${item1} vs ${item2}: Qual É Melhor? | É Seguro na Cozinha?`
  : isZh
  ? `${item1}与${item2}对比：哪个更好？怎么选？ | 厨房安全指南`
  : `${item1} vs ${item2} 徹底比較：おすすめはどっち？ | キッチン安全チェッカー`;

const pageDescription = getMetaDescription(item1, item2, winner, verdict);

const comparisonsData = isEs ? comparisonsEs : isPt ? comparisonsPt : isZh ? comparisonsZh : comparisonsJa;
let relatedComparisonObjects = comparisonsData.filter(c => 
  relatedComparisons.includes(c.slug) && c.slug !== slug
);
if (relatedComparisonObjects.length < 4) {
  const extraComps = comparisonsData.filter(c => 
    c.slug !== slug && !relatedComparisons.includes(c.slug)
  );
  for (const c of extraComps) {
    if (relatedComparisonObjects.length >= 4) break;
    relatedComparisonObjects.push(c);
  }
}
relatedComparisonObjects = relatedComparisonObjects.slice(0, 4);

const applianceNamesMap: Record<string, Record<string, string>> = {
  dishwasher: { es: 'Lavavajillas', pt: 'Lava-Louças', 'zh-cn': '洗碗机', ja: '食洗機' },
  microwave: { es: 'Microondas', pt: 'Micro-ondas', 'zh-cn': '微波炉', ja: '電子レンジ' },
  oven: { es: 'Horno', pt: 'Forno', 'zh-cn': '烤箱', ja: 'オーブン' },
  freezer: { es: 'Congelador', pt: 'Freezer', 'zh-cn': '冷冻室', ja: '冷凍庫' },
  airfryer: { es: 'Freidora de Aire', pt: 'Fritadeira sem Óleo', 'zh-cn': '空气炸锅', ja: 'ノンフライヤー' },
  refrigerator: { es: 'Refrigerador', pt: 'Geladeira', 'zh-cn': '冰箱冷藏室', ja: '冷蔵庫' },
  dryer: { es: 'Secadora', pt: 'Secadora', 'zh-cn': '烘干机', ja: '乾燥機' },
  'washing-machine': { es: 'Lavadora', pt: 'Máquina de Lavar', 'zh-cn': '洗衣机', ja: '洗濯機' }
};

function formatItemLinkText(url: string) {
  const parts = url.split('/').filter(Boolean);
  const cleanParts = parts.filter(p => p !== 'es' && p !== 'pt' && p !== 'zh-cn' && p !== 'ja');
  if (cleanParts.length < 2) {
    return isEs ? "Guía de Seguridad en Cocina" : isPt ? "Guia de Segurança na Cozinha" : isZh ? "厨房安全指南" : "キッチン安全ガイド";
  }
  const app = cleanParts[0];
  const localizedApp = (applianceNamesMap[app] as any)?.[lang] || (app.charAt(0).toUpperCase() + app.slice(1));
  const itm = cleanParts[1].split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
  if (isEs) return `Guía de ${itm} en ${localizedApp}`;
  if (isPt) return `Guia de ${itm} em ${localizedApp}`;
  if (isZh) return `${localizedApp}${itm}安全指南`;
  return `${localizedApp}での${itm}安全ガイド`;
}

const activeItems = isEs ? itemsEs : isPt ? itemsPt : isZh ? itemsZh : itemsJa;
const activeHowLong = isEs ? howLongEs : isPt ? howLongPt : isZh ? howLongZh : howLongJa;
const activeRefreeze = isEs ? refreezeEs : isPt ? refreezePt : isZh ? refreezeZh : refreezeJa;
const activeWashing = isEs ? washingEs : isPt ? washingPt : isZh ? washingZh : washingJa;

function normalizeName(name: string) {
  return name.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim();
}

function resolveItemPageUrl(itemName: string) {
  const norm = normalizeName(itemName);
  const match = activeItems.find(i => normalizeName(i.item) === norm);
  if (match) return `/${lang}/${match.appliance}/${match.slug}/`;
  
  const hlMatch = activeHowLong.find(h => normalizeName(h.item) === norm);
  if (hlMatch) return `/${lang}/how-long/${hlMatch.slug}/`;
  
  const rfMatch = activeRefreeze.find(r => normalizeName(r.item) === norm);
  if (rfMatch) return `/${lang}/refreeze/${rfMatch.slug}/`;
  
  const wMatch = activeWashing.find(w => normalizeName(w.item) === norm);
  if (wMatch) return `/${lang}/washing-machine/${wMatch.slug}/`;
  
  return null;
}

const item1Url = resolveItemPageUrl(item1);
const item2Url = resolveItemPageUrl(item2);
const individualGuides: { name: string; url: string }[] = [];
if (item1Url) individualGuides.push({ name: item1, url: item1Url });
if (item2Url) individualGuides.push({ name: item2, url: item2Url });

if (relatedItems) {
  relatedItems.forEach(url => {
    let cleanUrl = url.endsWith('/') ? url : `${url}/`;
    if (!cleanUrl.startsWith(`/${lang}/`)) {
      cleanUrl = `/${lang}${cleanUrl.startsWith('/') ? '' : '/'}${cleanUrl}`;
    }
    if (!individualGuides.some(g => g.url === cleanUrl)) {
      individualGuides.push({ name: formatItemLinkText(cleanUrl), url: cleanUrl });
    }
  });
}

const preservationGuides: { name: string; url: string; label: string }[] = [];
const addPreservationGuide = (name: string, url: string, label: string) => {
  const cleanUrl = url.endsWith('/') ? url : `${url}/`;
  if (!preservationGuides.some(g => g.url === cleanUrl)) {
    preservationGuides.push({ name, url: cleanUrl, label });
  }
};

const hlLabel = isEs ? 'Vida Útil' : isPt ? 'Validade' : isZh ? '保质期' : '保存期間';
const rfLabel = isEs ? 'Recongelación' : isPt ? 'Recongelamento' : isZh ? '二次冷冻' : '再冷凍';

const item1Norm = normalizeName(item1);
const item1Hl = activeHowLong.find(h => normalizeName(h.item) === item1Norm);
if (item1Hl) {
  const hlQuestion = isEs ? `¿Cuánto Dura ${item1Hl.item}?` : isPt ? `Quanto Tempo Dura ${item1Hl.item}?` : isZh ? `${item1Hl.item}能保存多久？` : `${item1Hl.item}の保存期間は？`;
  addPreservationGuide(hlQuestion, `/${lang}/how-long/${item1Hl.slug}/`, hlLabel);
}
const item1Rf = activeRefreeze.find(r => normalizeName(r.item) === item1Norm);
if (item1Rf) {
  const rfQuestion = isEs ? `¿Se Puede Recongelar ${item1Rf.item}?` : isPt ? `Pode Recongelar ${item1Rf.item}?` : isZh ? `${item1Rf.item}可以二次冷冻吗？` : `${item1Rf.item}は再冷凍できる？`;
  addPreservationGuide(rfQuestion, `/${lang}/refreeze/${item1Rf.slug}/`, rfLabel);
}

const item2Norm = normalizeName(item2);
const item2Hl = activeHowLong.find(h => normalizeName(h.item) === item2Norm);
if (item2Hl) {
  const hlQuestion = isEs ? `¿Cuánto Dura ${item2Hl.item}?` : isPt ? `Quanto Tempo Dura ${item2Hl.item}?` : isZh ? `${item2Hl.item}能保存多久？` : `${item2Hl.item}の保存期間は？`;
  addPreservationGuide(hlQuestion, `/${lang}/how-long/${item2Hl.slug}/`, hlLabel);
}
const item2Rf = activeRefreeze.find(r => normalizeName(r.item) === item2Norm);
if (item2Rf) {
  const rfQuestion = isEs ? `¿Se Puede Recongelar ${item2Rf.item}?` : isPt ? `Pode Recongelar ${item2Rf.item}?` : isZh ? `${item2Rf.item}可以二次冷冻吗？` : `${item2Rf.item}は再冷凍できる？`;
  addPreservationGuide(rfQuestion, `/${lang}/refreeze/${item2Rf.slug}/`, rfLabel);
}

const pageCanonical = `https://isitkitchensafe.com/${lang}/compare/${slug}/`;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": isEs ? "Inicio" : isPt ? "Início" : isZh ? "首页" : "ホーム",
      "item": `https://isitkitchensafe.com/${lang}/`
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": isEs || isPt ? "Comparar" : isZh ? "安全对比" : "比較ガイド",
      "item": `https://isitkitchensafe.com/${lang}/compare/`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": `${item1} vs ${item2}`,
      "item": pageCanonical
    }
  ]
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": isEs
    ? `${item1} vs ${item2}: ¿Cuál es Mejor?`
    : isPt
    ? `${item1} vs ${item2}: Qual É Melhor?`
    : isZh
    ? `${item1}与${item2}对比：哪个更好？怎么选？`
    : `${item1} vs ${item2} 徹底比較：おすすめはどっち？`,
  "description": pageDescription,
  "image": "https://isitkitchensafe.com/favicon.svg",
  "author": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "logo": {
      "@type": "ImageObject",
      "url": "https://isitkitchensafe.com/favicon.svg"
    }
  },
  "datePublished": "2026-06-13T12:00:00Z",
  "dateModified": "2026-06-13T12:00:00Z",
  "mainEntityOfPage": pageCanonical
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};

// Smart Contextual Consumer Calculator Recommendation (Localized)
const translatePath = useTranslatedPath(lang);
const methodologyUrl = getDirectoryUrl('methodology', lang);
const contactUrl = getDirectoryUrl('contact', lang);

const toolMatchContext = `${slug} ${category} ${item1} ${item2}`.toLowerCase();
type RecommendedToolKey =
  | 'descaling'
  | 'cleaner'
  | 'plastic'
  | 'airfryer'
  | 'microwave'
  | 'thawing'
  | 'leftover'
  | 'ovenTemp'
  | 'cookingTemp'
  | 'symbol';

let recommendedToolKey: RecommendedToolKey = 'symbol';
if (/\b(descal(?:e|ing)|coffee|kettles?|espresso)\b/i.test(toolMatchContext)) {
  recommendedToolKey = 'descaling';
} else if (/\b(bleach|vinegar|ammonia|peroxide|cleaners?)\b/i.test(toolMatchContext)) {
  recommendedToolKey = 'cleaner';
} else if (/\b(plastics?|styrofoam|tupperware|ziploc|resin)\b/i.test(toolMatchContext)) {
  recommendedToolKey = 'plastic';
} else if (/\b(air[- ]?fryer)\b/i.test(toolMatchContext)) {
  recommendedToolKey = 'airfryer';
} else if (/\b(microwave|watt(?:age|s)?)\b/i.test(toolMatchContext)) {
  recommendedToolKey = 'microwave';
} else if (/\b(turkey|thaw(?:ing)?|holiday|raw-vs-cooked-freezing|fridge-vs-freezer-chicken)\b/i.test(toolMatchContext)) {
  recommendedToolKey = 'thawing';
} else if (/\b(leftovers?|food-storage|fridge|freezer|pantry|counter|vegetables?)\b/i.test(toolMatchContext)) {
  recommendedToolKey = 'leftover';
} else if (/\b(cookware|bakeware|hexclad|pyrex|borosilicate|soda-lime|nonstick|teflon|caraway|stainless|cast-iron|parchment|wax-paper|aluminum-foil|silicone|ceramic|oven-vs-toaster-oven)\b/i.test(toolMatchContext)) {
  recommendedToolKey = 'ovenTemp';
} else if (/\b(slow-cooker|instant-pot|pressure-cooker|steaming|boiling|baking|broiling|grilling|induction|stovetop|meat|chicken|cooking-method)\b/i.test(toolMatchContext)) {
  recommendedToolKey = 'cookingTemp';
}

const interactiveToolBadge = isEs
  ? 'Herramienta Interactiva'
  : isPt
  ? 'Ferramenta Interativa'
  : isZh
  ? '互动计算工具'
  : 'インタラクティブツール';

const toolCatalog: Record<RecommendedToolKey, {
  path: string;
  icon: string;
  title: string;
  description: string;
  cta: string;
}> = {
  cleaner: {
    path: '/tools/cleaner-mixing-danger-checker/',
    icon: '🧪',
    title: isEs ? 'Verificador de Peligro al Mezclar Limpiadores de Cocina' :
           isPt ? 'Verificador de Perigo ao Misturar Produtos de Limpeza' :
           isZh ? '厨房清洁剂混用危险检测器' :
           'キッチン洗剤の危険な混合チェッカー',
    description: isEs ? 'Comprueba dos limpiadores domésticos antes de mezclarlos para detectar al instante gas cloro tóxico, cloramina o reacciones peligrosas.' :
                 isPt ? 'Verifique dois produtos de limpeza antes de misturá-los para detectar instantaneamente gás cloro tóxico, cloramina ou reações perigosas.' :
                 isZh ? '混合清洁剂前一键排查两种化学成分，即时识别氯气、氯胺中毒与剧烈放热反应风险。' :
                 '2種類の家庭用洗剤を混ぜる前にチェックし、有毒な塩素ガスやクロラミン発生、発熱反応の危険を瞬時に判定します。',
    cta: isEs ? 'Verificar Mezcla' : isPt ? 'Verificar Mistura' : isZh ? '检测混用风险' : '混合の危険を確認'
  },
  descaling: {
    path: '/tools/appliance-descaling-calculator/',
    icon: '☕',
    title: isEs ? 'Calculadora de Descalcificación para Cafeteras y Hervidores' :
           isPt ? 'Calculadora de Descalcificação para Cafeteiras e Chaleiras' :
           isZh ? '咖啡机与水壶除垢比例计算器' :
           'コーヒーメーカー・ケトル水垢除去比率計算ツール',
    description: isEs ? 'Calcula la proporción exacta de ácido cítrico o vinagre blanco y los ciclos de enjuague para tu cafetera, máquina de espresso o hervidor.' :
                 isPt ? 'Calcule a proporção exata de ácido cítrico ou vinagre branco e ciclos de enxágue para sua cafeteira, máquina de espresso ou chaleira.' :
                 isZh ? '根据咖啡机、意式机或电水壶容量，精准计算柠檬酸或白醋除垢配比与安全冲洗次数。' :
                 'コーヒーメーカー・エスプレッソマシン・電気ケトルの容量に合わせて、クエン酸や酢の安全な配合比とすすぎ回数を計算します。',
    cta: isEs ? 'Calcular Proporción' : isPt ? 'Calcular Proporção' : isZh ? '计算除垢比例' : '除垢比率を計算'
  },
  microwave: {
    path: '/tools/microwave-wattage-converter/',
    icon: '⏱️',
    title: isEs ? 'Conversor de Potencia (Vatios) y Tiempo de Microondas' :
           isPt ? 'Conversor de Potência (Watts) e Tempo de Micro-ondas' :
           isZh ? '微波炉功率（瓦数）与加热时间换算器' :
           '電子レンジ ワット数・加熱時間変換ツール',
    description: isEs ? 'Adapta los tiempos de cocción de 700W, 900W, 1000W o 1100W a la potencia exacta de tu microondas para calentar sin zonas frías ni sobrecalentamiento.' :
                 isPt ? 'Converta tempos de preparo de 700W, 900W, 1000W ou 1100W para a potência exata do seu micro-ondas, evitando pontos frios e superaquecimento.' :
                 isZh ? '将 700W、900W、1000W 或 1100W 食谱与包装加热时间精准换算为您家中微波炉的实际瓦数，避免加热不均或过热焦糊。' :
                 '500W・600W・700W・1000Wなどパッケージ記載の加熱時間を、ご自宅の電子レンジの出力に合わせて正確に換算し、加熱ムラや過熱を防ぎます。',
    cta: isEs ? 'Convertir Potencia' : isPt ? 'Converter Potência' : isZh ? '换算微波炉时间' : 'ワット数を換算'
  },
  plastic: {
    path: '/tools/plastic-code-checker/',
    icon: '♻️',
    title: isEs ? 'Verificador de Seguridad de Códigos de Plástico #1–#7' :
           isPt ? 'Verificador de Segurança de Códigos de Plástico #1–#7' :
           isZh ? '塑料回收编号 #1–#7 安全查询器' :
           'プラスチック識別番号 #1〜#7 安全性チェッカー',
    description: isEs ? 'Consulta cualquier código de resina #1–#7 (PET, HDPE, PVC, PP, PS) para comprobar si es apto para microondas, lavavajillas, congelador y libre de BPA.' :
                 isPt ? 'Consulte qualquer código de resina #1–#7 (PET, HDPE, PVC, PP, PS) para verificar segurança em micro-ondas, lava-louças, freezer e risco de BPA.' :
                 isZh ? '一键查询 #1–#7 塑料树脂代码（PET、HDPE、PVC、PP、PS 等），快速核对微波炉、洗碗机、冷冻耐受度与化学析出风险。' :
                 '#1〜#7のプラスチック材質番号（PET・HDPE・PVC・PP・PS等）から電子レンジ・食洗機・冷凍適性と溶出リスクを瞬時に確認できます。',
    cta: isEs ? 'Verificar Código #1–#7' : isPt ? 'Verificar Código #1–#7' : isZh ? '查询塑料编号' : 'プラ番号を確認'
  },
  airfryer: {
    path: '/tools/air-fryer-oven-converter/',
    icon: '🔥',
    title: isEs ? 'Conversor de Freidora de Aire, Horno de Convección y Gas Mark' :
           isPt ? 'Conversor de Air Fryer, Forno de Convecção e Gas Mark' :
           isZh ? '空气炸锅、对流烤箱与燃气档位换算器' :
           'ノンフライヤー・コンベクション・ガスマーク変換ツール',
    description: isEs ? 'Convierte al instante cualquier receta de horno convencional a temperatura (°F/°C) y tiempo reducido para freidora de aire sin quemar la comida.' :
                 isPt ? 'Converta na hora qualquer receita de forno convencional para temperatura (°F/°C) e tempo reduzido na air fryer evitando queimar os alimentos.' :
                 isZh ? '将传统烤箱食谱一键换算为空气炸锅安全温度（°F/°C）与缩短后的烹饪时长，避免焦糊与过热。' :
                 '通常のオーブンレシピをノンフライヤー用の安全な温度（°F/°C）と短縮時間に瞬時に変換し、焦げ付きを防ぎます。',
    cta: isEs ? 'Convertir Temperatura' : isPt ? 'Converter Temperatura' : isZh ? '换算炸锅温时' : '温度・時間を変換'
  },
  thawing: {
    path: '/tools/meat-thawing-calculator/',
    icon: '❄️',
    title: isEs ? 'Calculadora USDA de Descongelación Segura de Carne y Pavo' :
           isPt ? 'Calculadora USDA de Descongelamento Seguro de Carne e Peru' :
           isZh ? 'USDA 肉类与火鸡安全解冻时间计算器' :
           'USDA 肉・七面鳥の安全な解凍時間計算ツール',
    description: isEs ? 'Calcula los tiempos exactos del USDA para descongelar en refrigerador o agua fría según peso y corte, evitando la zona de peligro bacteriano.' :
                 isPt ? 'Calcule os tempos exatos do USDA para descongelar na geladeira ou em água fria por peso e corte, mantendo carnes fora da zona de perigo.' :
                 isZh ? '按重量与肉类部位精准计算 USDA 冷藏与冷水安全解冻时长，让禽肉、牛猪肉与海鲜远离细菌危险温区。' :
                 '重量と部位からUSDA基準の冷蔵解凍・冷水解凍時間を正確に計算し、食中毒の危険温度帯を避けて安全に解凍できます。',
    cta: isEs ? 'Calcular Descongelación' : isPt ? 'Calcular Descongelamento' : isZh ? '计算解冻时间' : '解凍時間を計算'
  },
  leftover: {
    path: '/tools/leftover-shelf-life-calculator/',
    icon: '🗓️',
    title: isEs ? 'Calculadora USDA de Vida Útil de Sobras y Refrigerador' :
           isPt ? 'Calculadora USDA de Validade de Sobras na Geladeira' :
           isZh ? 'USDA 剩菜与冰箱保质期倒计时计算器' :
           'USDA 残り物・冷蔵保存期限カウントダウン計算ツール',
    description: isEs ? 'Ingresa cuándo cocinaste o abriste un alimento para obtener su fecha límite exacta del USDA en refrigerador y congelador.' :
                 isPt ? 'Informe quando cozinhou ou abriu um alimento para obter a data limite exata do USDA na geladeira e no congelador.' :
                 isZh ? '输入烹饪或开封日期，即时生成剩菜、乳制品、肉类与果蔬的 USDA 冰箱冷藏与冷冻安全食用截止日。' :
                 '調理日や開封日を入力するだけで、残り物・乳製品・肉・野菜のUSDA基準による冷蔵・冷凍の安全消費期限を算出します。',
    cta: isEs ? 'Calcular Caducidad' : isPt ? 'Calcular Validade' : isZh ? '计算保质期' : '保存期限を確認'
  },
  cookingTemp: {
    path: '/tools/internal-cooking-temp-chart/',
    icon: '🌡️',
    title: isEs ? 'Tabla USDA de Temperaturas Internas Seguras de Cocción' :
           isPt ? 'Tabela USDA de Temperaturas Internas Seguras de Cozimento' :
           isZh ? 'USDA 安全烹饪中心温度速查表' :
           'USDA 安全な調理中心温度チャート',
    description: isEs ? 'Consulta las temperaturas internas mínimas oficiales del USDA (°F y °C) y tiempos de reposo para aves, res, cerdo, mariscos, huevos y cazuelas.' :
                 isPt ? 'Confira as temperaturas internas mínimas oficiais do USDA (°F e °C) e tempos de descanso para aves, boi, porco, frutos do mar, ovos e assados.' :
                 isZh ? '查阅 USDA 官方最低安全中心温度（°F 与 °C）及静置时间，覆盖禽肉、牛羊猪肉、海鲜、蛋类与烘焙砂锅菜。' :
                 '鶏肉・牛肉・豚肉・魚介・卵・キャセロールのUSDA公式最低中心温度（°F・°C）と休ませ時間を一覧で確認できます。',
    cta: isEs ? 'Ver Temperaturas' : isPt ? 'Ver Temperaturas' : isZh ? '查看安全温度' : '中心温度を確認'
  },
  ovenTemp: {
    path: '/tools/cookware-oven-temp-lookup/',
    icon: '♨️',
    title: isEs ? 'Buscador de Temperatura Segura de Horno para Ollas y Moldes' :
           isPt ? 'Consulta de Temperatura Segura no Forno para Panelas e Formas' :
           isZh ? '厨具与烤盘烤箱耐热上限查询器' :
           '調理器具・耐熱皿のオーブン耐熱温度検索ツール',
    description: isEs ? 'Comprueba los límites exactos de temperatura en horno y grill para Pyrex, vidrio, hierro fundido, HexClad, Caraway, antiadherente, acero inoxidable y tapas.' :
                 isPt ? 'Verifique os limites exatos de temperatura no forno e grill para Pyrex, vidro, ferro fundido, HexClad, Caraway, antiaderente, aço inox e tampas.' :
                 isZh ? '速查 Pyrex 玻璃、铸铁锅、HexClad、Caraway、不粘锅、不锈钢与锅盖的烤箱及炙烤最高安全耐热温度。' :
                 'Pyrex・ガラス・鋳鉄・HexClad・Caraway・フッ素樹脂・ステンレス・蓋のオーブンおよびグリル耐熱上限を検索できます。',
    cta: isEs ? 'Buscar Límite de Horno' : isPt ? 'Consultar Limite no Forno' : isZh ? '查询耐热上限' : '耐熱上限を調べる'
  },
  symbol: {
    path: '/tools/kitchen-symbol-decoder/',
    icon: '🔍',
    title: isEs ? 'Decodificador de Símbolos de Cocina' :
           isPt ? 'Decodificador de Símbolos de Cozinha' :
           isZh ? '厨具底部安全标志识别器' :
           'キッチン用品マーク解読ツール',
    description: isEs ? '¿No estás seguro de los íconos en la base de tu recipiente o termo? Identifica al instante los símbolos de lavavajillas, microondas y plásticos.' :
                 isPt ? 'Não tem certeza sobre os ícones no fundo do recipiente ou copo térmico? Identifique na hora símbolos de lava-louças, micro-ondas e plásticos.' :
                 isZh ? '不确定容器、保温杯或锅具底部的符号含义？即时识别洗碗机、微波炉、耐热与塑料回收标志。' :
                 '容器・タンブラー・調理器具の底にあるマークの意味がわからない時は、食洗機・電子レンジ・耐熱マークを瞬時に判定できます。',
    cta: isEs ? 'Abrir Decodificador' : isPt ? 'Abrir Decodificador' : isZh ? '打开标志识别器' : 'マークを調べる'
  }
};

const recommendedTool = toolCatalog[recommendedToolKey];
const recommendedToolUrl = translatePath(recommendedTool.path);

const uxCopy = {
  copyLink: isEs ? 'Copiar Enlace' : isPt ? 'Copiar Link' : isZh ? '复制对比链接' : '比較リンクをコピー',
  copyAria: isEs ? 'Copiar enlace de esta comparación de seguridad' : isPt ? 'Copiar link desta comparação de segurança' : isZh ? '复制本安全对比链接' : 'この安全比較ページのリンクをコピー',
  copied: isEs ? 'Enlace Copiado' : isPt ? 'Link Copiado' : isZh ? '链接已复制' : 'コピーしました',
  toastCopied: isEs ? 'Enlace de la comparación copiado al portapapeles' : isPt ? 'Link da comparação copiado para a área de transferência' : isZh ? '对比链接已复制到剪贴板' : '比較ページのリンクをクリップボードにコピーしました',
  printBtn: isEs ? 'Imprimir Comparación' : isPt ? 'Imprimir Comparação' : isZh ? '打印对比' : '比較を印刷',
  printAria: isEs ? 'Imprimir esta comparación de seguridad' : isPt ? 'Imprimir esta comparação de segurança' : isZh ? '打印本安全对比' : 'この安全比較ページを印刷',
  headerVerified: isEs ? 'Verificado según normas USDA FSIS, FDA y NSF' :
                  isPt ? 'Verificado conforme padrões USDA FSIS, FDA e NSF' :
                  isZh ? '依据 USDA FSIS、FDA 与 NSF 标准核验' :
                  'USDA FSIS・FDA・NSF 基準に基づき検証済み',
  trustHeading: isEs ? 'Verificado según los estándares USDA FSIS, FDA 21 CFR y NSF de seguridad en cocina' :
                isPt ? 'Verificado conforme os padrões USDA FSIS, FDA 21 CFR e NSF de segurança na cozinha' :
                isZh ? '严格依据 USDA FSIS、FDA 21 CFR 及 NSF 食品接触安全标准交叉核验' :
                'USDA FSIS・FDA 21 CFR・NSF キッチン安全基準に基づき検証済み',
  methodologyCta: isEs ? 'Leer Metodología de Verificación' : isPt ? 'Ler Metodologia de Verificação' : isZh ? '查看安全核验方法论' : '安全検証メソドロジーを見る',
  reportCorrection: isEs ? 'Reportar una corrección' : isPt ? 'Relatar uma correção' : isZh ? '反馈纠错或更新' : '修正・更新を報告',
  trustFoot: isEs ? 'Comparaciones cotejadas con el Servicio de Inspección e Inocuidad Alimentaria (USDA FSIS), normativas FDA de contacto con alimentos, estándares NSF International y manuales OEM.' :
             isPt ? 'Comparações conferidas com o Serviço de Inspeção e Segurança Alimentar (USDA FSIS), normas FDA de contato com alimentos, padrões NSF International e manuais OEM.' :
             isZh ? '所有对比数据均对照美国农业部食品安全检验局（USDA FSIS）、FDA 食品接触法规、NSF International 标准与家电原厂手册核验。' :
             'すべての比較データはUSDA食品安全検査局（FSIS）、FDA食品接触規制、NSF International基準および各家電メーカー公式マニュアルと照合しています。'
};
---

<Layout title={pageTitle} description={pageDescription} excludeBreadcrumbSchema={true} excludeArticleSchema={true} excludeFaqSchema={true} availableLocales={availableLocales} lang={lang} ogType="article">
  <!-- Inject Schemas into Head Slot -->
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <div class="bg-canvas py-8">
    <div class="max-w-[800px] mx-auto px-6">
      
      <!-- Breadcrumbs -->
      <Breadcrumbs 
        items={[
          { label: isEs ? "Inicio" : isPt ? "Início" : isZh ? "首页" : "ホーム", href: `/${lang}/` },
          { label: isEs || isPt ? "Comparar" : isZh ? "安全对比" : "比較ガイド", href: `/${lang}/compare/` },
          { label: `${item1} vs ${item2}` }
        ]}
        className="mb-6"
      />

      <!-- H1 Page Header -->
      <header class="mb-8 border-b border-hairline pb-8">
        <span class="text-xs font-bold uppercase tracking-wider text-muted mb-2 block">
          {isEs
            ? `Comparación de ${categoryNames[category]}`
            : isPt
            ? `Comparação de ${categoryNames[category]}`
            : isZh
            ? `${categoryNames[category]}`
            : `${categoryNames[category]}の比較`}
        </span>
        <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-6 leading-tight">
          {isEs
            ? `${item1} vs ${item2}: ¿Cuál Deberías Usar?`
            : isPt
            ? `${item1} vs ${item2}: Qual Você Deve Usar?`
            : isZh
            ? `${item1} 对比 ${item2}：该选哪一个？`
            : `${item1} vs ${item2}：どちらを使うべき？`}
        </h1>

        <!-- Winner Badge above the fold -->
        <div class="flex items-center mb-6">
          {winner === "item1" && (
            <div class="inline-flex items-center gap-2 px-6 py-3 bg-success-bg border border-success/30 rounded-full text-success text-lg md:text-xl font-bold font-display">
              <span class="text-2xl leading-none">✓</span>
              <span>{item1.toUpperCase()} {isEs ? "GANA" : isPt ? "VENCE" : isZh ? "胜出" : "推奨"}</span>
            </div>
          )}
          {winner === "item2" && (
            <div class="inline-flex items-center gap-2 px-6 py-3 bg-success-bg border border-success/30 rounded-full text-success text-lg md:text-xl font-bold font-display">
              <span class="text-2xl leading-none">✓</span>
              <span>{item2.toUpperCase()} {isEs ? "GANA" : isPt ? "VENCE" : isZh ? "胜出" : "推奨"}</span>
            </div>
          )}
          {winner === "depends" && (
            <div class="inline-flex items-center gap-2 px-6 py-3 bg-surface-soft border border-hairline rounded-full text-body text-lg md:text-xl font-bold font-display">
              <span class="text-xl leading-none">⚠</span>
              <span>{isEs || isPt ? "DEPENDE" : isZh ? "视情况而定" : "用途による"}</span>
            </div>
          )}
        </div>

        <!-- Quick Verdict -->
        <div class="p-5 bg-surface-soft border-l-4 border-primary rounded-r-md max-w-prose">
          <p class="text-body-md text-ink text-[15px] leading-relaxed">
            <strong>{verdict}</strong>
          </p>
        </div>

        <!-- Compact E-E-A-T Verification Attribution -->
        <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1.5 text-[12px] text-muted">
          <span class="inline-flex items-center gap-1.5 font-medium text-ink">
            <svg class="w-3.5 h-3.5 text-success shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
            </svg>
            <span>{uxCopy.headerVerified}</span>
          </span>
          <span class="text-hairline hidden sm:inline">•</span>
          <a href={methodologyUrl} class="text-link hover:underline font-medium">
            {uxCopy.methodologyCta} &rarr;
          </a>
        </div>

        <!-- Copy Comparison Link & Print Comparison Bar -->
        <div class="mt-4 flex flex-wrap items-center gap-2.5 no-print">
          <button
            id="copy-link-btn"
            type="button"
            aria-label={uxCopy.copyAria}
            data-default-text={uxCopy.copyLink}
            data-copied-text={uxCopy.copied}
            data-toast-text={uxCopy.toastCopied}
            class="min-h-[40px] px-3.5 py-2 bg-canvas hover:bg-surface-soft active:scale-[0.98] text-ink border border-hairline rounded-md text-xs font-medium inline-flex items-center gap-2 shadow-xs transition-all cursor-pointer"
          >
            <svg class="w-4 h-4 text-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
            </svg>
            <span id="copy-link-btn-text">{uxCopy.copyLink}</span>
          </button>

          <button
            id="print-comparison-btn"
            type="button"
            aria-label={uxCopy.printAria}
            class="min-h-[40px] px-3.5 py-2 bg-canvas hover:bg-surface-soft active:scale-[0.98] text-ink border border-hairline rounded-md text-xs font-medium inline-flex items-center gap-2 shadow-xs transition-all cursor-pointer"
          >
            <svg class="w-4 h-4 text-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4H7v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
            </svg>
            <span>{uxCopy.printBtn}</span>
          </button>
        </div>
      </header>

      <!-- Side-by-Side Comparison Table -->
      <section class="mb-12">
        <h2 class="text-title-lg font-bold text-ink mb-6">
          {isEs ? "Comparación Detallada" : isPt ? "Comparação Detalhada" : isZh ? "详细参数及特性对比" : "詳細スペック・特性比較"}
        </h2>
        
        <!-- Desktop Table -->
        <div class="hidden md:block overflow-hidden border border-hairline rounded-lg">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-surface-soft border-b border-hairline">
                <th class="w-[20%] p-4 font-display font-medium text-ink text-[14px]">
                  {isEs || isPt ? "Aspecto" : isZh ? "对比维度" : "比較項目"}
                </th>
                <th class={`w-[40%] p-4 font-display font-medium text-[14px] text-center ${winner === 'item1' ? 'bg-success-bg/50 border-l-2 border-success-border' : 'bg-surface-soft/50'}`}>
                  {item1}
                </th>
                <th class={`w-[40%] p-4 font-display font-medium text-[14px] text-center ${winner === 'item2' ? 'bg-success-bg/50 border-l-2 border-success-border' : 'bg-surface-soft/50'}`}>
                  {item2}
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-hairline">
              {table.map((row, idx) => (
                <tr class={idx % 2 === 0 ? 'bg-canvas' : 'bg-surface-soft/30'}>
                  <td class="p-4 font-medium text-ink text-[13px]">{row.aspect}</td>
                  
                  <td class={`p-4 text-[13px] text-center ${winner === 'item1' ? 'bg-success-bg border-l-2 border-success-border font-medium text-success' : 'bg-surface-soft text-muted'}`}>
                    {row.item1Value}
                  </td>
                  
                  <td class={`p-4 text-[13px] text-center ${winner === 'item2' ? 'bg-success-bg border-l-2 border-success-border font-medium text-success' : 'bg-surface-soft text-muted'}`}>
                    {row.item2Value}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <!-- Mobile Table Stacking -->
        <div class="block md:hidden flex flex-col gap-4">
          {table.map((row) => (
            <div class="border border-hairline rounded-lg overflow-hidden">
              <div class="bg-surface-soft px-4 py-2 text-ink font-bold text-[13px] border-b border-hairline">
                {row.aspect}
              </div>
              <div class="p-4 flex flex-col gap-3">
                <div class={`p-3 rounded-md ${winner === 'item1' ? 'bg-success-bg border-l-4 border-success-border' : 'bg-surface-soft'}`}>
                  <span class="block text-[11px] font-bold text-muted uppercase mb-1">{item1}</span>
                  <span class={`text-[13px] ${winner === 'item1' ? 'text-success font-medium' : 'text-body'}`}>{row.item1Value}</span>
                </div>
                <div class={`p-3 rounded-md ${winner === 'item2' ? 'bg-success-bg border-l-4 border-success-border' : 'bg-surface-soft'}`}>
                  <span class="block text-[11px] font-bold text-muted uppercase mb-1">{item2}</span>
                  <span class={`text-[13px] ${winner === 'item2' ? 'text-success font-medium' : 'text-body'}`}>{row.item2Value}</span>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Detailed Pros Section -->
      <section class="mb-12 border-t border-hairline pt-8">
        <h2 class="text-title-lg font-bold text-ink mb-6">
          {isEs ? "Ventajas y Pros" : isPt ? "Vantagens e Prós" : isZh ? "核心优势分析" : "主なメリット・利点"}
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="p-6 bg-surface-soft/30 border border-hairline rounded-lg">
            <h3 class="text-title-sm font-bold text-ink mb-4 pb-2 border-b border-hairline flex items-center gap-2">
              <span class="text-success text-lg">✓</span>
              <span>{item1} ({isEs ? "Ventajas" : isPt ? "Vantagens" : isZh ? "优势" : "メリット"})</span>
            </h3>
            <ul class="flex flex-col gap-3 text-[13.5px] text-body leading-relaxed">
              {item1Pros.map(pro => (
                <li class="flex items-start gap-2.5">
                  <span class="text-success mt-0.5 shrink-0">•</span>
                  <span>{pro}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="p-6 bg-surface-soft/30 border border-hairline rounded-lg">
            <h3 class="text-title-sm font-bold text-ink mb-4 pb-2 border-b border-hairline flex items-center gap-2">
              <span class="text-success text-lg">✓</span>
              <span>{item2} ({isEs ? "Ventajas" : isPt ? "Vantagens" : isZh ? "优势" : "メリット"})</span>
            </h3>
            <ul class="flex flex-col gap-3 text-[13.5px] text-body leading-relaxed">
              {item2Pros.map(pro => (
                <li class="flex items-start gap-2.5">
                  <span class="text-success mt-0.5 shrink-0">•</span>
                  <span>{pro}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <!-- Best Use Cases Section -->
      <section class="mb-12 border-t border-hairline pt-8">
        <h2 class="text-title-lg font-bold text-ink mb-6">
          {isEs ? "Mejores Casos de Uso" : isPt ? "Melhores Casos de Uso" : isZh ? "最佳推荐使用场景" : "最適な使用シーン・活用例"}
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {useCases.map(uc => (
            <div class="p-5 border border-hairline rounded-lg bg-canvas shadow-xs">
              <h3 class="text-title-sm font-bold text-ink mb-2 line-clamp-1">{uc.situation}</h3>
              <p class="text-body-md text-muted text-[13px] leading-relaxed">{uc.recommendation}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Safety Considerations Section -->
      <section class="mb-12 border-t border-hairline pt-8">
        <h2 class="text-title-lg font-bold text-ink mb-6">
          {isEs ? "Consideraciones de Seguridad" : isPt ? "Considerações de Segurança" : isZh ? "关键安全防范事项" : "使用上の安全注意点"}
        </h2>
        <div class="p-6 bg-error-bg/30 border border-error-border/30 rounded-lg">
          <ul class="flex flex-col gap-4 text-[13.5px] text-body leading-relaxed">
            {safetyNotes.map(note => (
              <li class="flex items-start gap-3">
                <span class="text-signature-coral mt-0.5 shrink-0 font-bold">⚠️</span>
                <span>{note}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- Smart Contextual Consumer Calculator CTA Card -->
      <section id="recommended-tool-card" class="mb-8 bg-surface-soft border border-hairline rounded-lg p-5 sm:p-6 shadow-xs no-print">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-2 mb-1.5">
              <span class="text-base" aria-hidden="true">{recommendedTool.icon}</span>
              <span class="text-[11px] font-semibold uppercase tracking-wider text-signature-coral">{interactiveToolBadge}</span>
            </div>
            <h2 class="text-title-sm text-ink font-semibold mb-1.5 leading-snug">
              {recommendedTool.title}
            </h2>
            <p class="text-[13px] text-body leading-relaxed">
              {recommendedTool.description}
            </p>
          </div>
          <div class="shrink-0">
            <a
              href={recommendedToolUrl}
              class="min-h-[42px] px-4 py-2.5 bg-primary hover:bg-primary-active active:scale-[0.98] text-on-primary rounded-md text-xs font-medium inline-flex items-center gap-1.5 transition-all whitespace-nowrap"
            >
              <span>{recommendedTool.cta}</span>
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>
      </section>

      <!-- E-E-A-T Verification & Methodology Trust Bar -->
      <section id="editorial-trust-bar" class="mb-12 bg-surface-soft border border-hairline rounded-lg p-5 text-xs text-muted leading-relaxed">
        <div class="flex items-start gap-2.5 pb-3 border-b border-hairline">
          <svg class="w-4 h-4 text-success shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
          </svg>
          <div class="min-w-0 flex-1">
            <p class="text-ink font-medium text-[13px] leading-snug">
              {uxCopy.trustHeading}
            </p>
            <div class="mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-[12px]">
              <a href={methodologyUrl} class="text-link hover:underline font-medium">
                {uxCopy.methodologyCta} &rarr;
              </a>
              <span class="text-hairline hidden sm:inline">•</span>
              <a href={contactUrl} class="text-muted hover:text-ink hover:underline">
                {uxCopy.reportCorrection}
              </a>
            </div>
          </div>
        </div>
        <p class="pt-3 text-[12px] text-muted">
          {uxCopy.trustFoot}
        </p>
      </section>

      <!-- FAQ Section -->
      <section class="mb-12 border-t border-hairline pt-8">
        <h2 class="text-title-lg font-bold text-ink mb-6">
          {isEs ? "Preguntas Frecuentes" : isPt ? "Perguntas Frequentes" : isZh ? "常见问题解答（FAQ）" : "よくある質問（FAQ）"}
        </h2>
        <div class="flex flex-col gap-4">
          {faqs.map(faq => (
            <details class="group border border-hairline rounded-lg bg-canvas [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex justify-between items-center p-4 font-medium text-ink cursor-pointer select-none text-[14px]">
                <span>{faq.question}</span>
                <span class="text-muted group-open:rotate-180 transition-transform text-xs">▼</span>
              </summary>
              <div class="px-4 pb-4 text-body-md text-muted leading-relaxed border-t border-hairline pt-3 text-[13.5px]">
                {faq.answer}
              </div>
            </details>
          ))}
        </div>
      </section>

      <!-- Compared Individual Item Guides Grid -->
      {individualGuides.length > 0 && (
        <section class="mb-12 border-t border-hairline pt-8">
          <h2 class="text-title-lg font-bold text-ink mb-6">
            {isEs ? "Guías Individuales de Seguridad Relacionadas" : isPt ? "Guias Individuais de Segurança Relacionados" : isZh ? "相关单品电器安全指南" : "関連アイテムの安全性ガイド"}
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {individualGuides.map(g => (
              <a 
                href={g.url}
                class="flex items-center justify-between p-4 border border-hairline rounded-lg hover:border-border-strong hover:bg-surface-soft/40 transition-all text-decoration-none text-ink font-medium text-[13.5px] shadow-xs"
              >
                <span>{g.name}</span>
                <span class="text-link text-xs">{isEs ? "Leer Guía →" : isPt ? "Ler Guia →" : isZh ? "查看指南 →" : "ガイドを読む →"}</span>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- Relevant Preservation & Food Storage Guides -->
      {preservationGuides.length > 0 && (
        <section class="mb-12 border-t border-hairline pt-8">
          <h2 class="text-title-lg font-bold text-ink mb-6">
            {isEs ? "Guías de Conservación y Vida Útil" : isPt ? "Guias de Conservação e Validade" : isZh ? "食材保质期与保存指南" : "食品の保存期間・再冷凍ガイド"}
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {preservationGuides.map(g => (
              <a 
                href={g.url}
                class="flex items-center justify-between p-4 border border-hairline rounded-lg hover:border-border-strong hover:bg-surface-soft/40 transition-all text-decoration-none text-ink font-medium text-[13.5px] shadow-xs"
              >
                <span>{g.name}</span>
                <span class="text-xs text-muted font-normal bg-success-bg px-2 py-0.5 rounded-sm">{g.label}</span>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- Related Comparisons Grid -->
      {relatedComparisonObjects.length > 0 && (
        <section class="mb-12 border-t border-hairline pt-8">
          <h2 class="text-title-lg font-bold text-ink mb-6">
            {isEs ? "Comparaciones de Seguridad Relacionadas" : isPt ? "Comparações de Segurança Relacionadas" : isZh ? "更多相关安全对比" : "関連する安全性比較"}
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            {relatedComparisonObjects.map(rc => (
              <a 
                href={`/${lang}/compare/${rc.slug}/`}
                class="block border border-hairline rounded-lg p-5 hover:border-border-strong hover:bg-surface-soft/40 transition-all text-decoration-none"
              >
                <span class="text-xs uppercase tracking-wider text-muted font-bold block mb-1">
                  {categoryNames[rc.category]}
                </span>
                <span class="text-ink font-display font-medium text-[14px] block mb-2">
                  {rc.item1} vs {rc.item2}
                </span>
                <p class="text-[12.5px] text-muted line-clamp-2 leading-relaxed">
                  {rc.verdict}
                </p>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- Back Link -->
      <footer class="border-t border-hairline pt-8 text-center">
        <a 
          href={`/${lang}/compare/`} 
          class="inline-flex items-center gap-1.5 text-link hover:underline font-medium text-[14px]"
        >
          <span>←</span>
          <span>{isEs ? "Volver al índice de comparaciones" : isPt ? "Voltar ao índice de comparações" : isZh ? "返回对比文章总览" : "比較ガイド一覧に戻る"}</span>
        </a>
      </footer>

    </div>
  </div>

  <!-- Accessible Copy-Link Toast -->
  <div
    id="copy-toast"
    role="status"
    aria-live="polite"
    class="fixed bottom-5 right-5 z-50 px-4 py-2.5 rounded-lg bg-surface-dark text-on-dark text-xs font-medium shadow-lg border border-hairline/20 opacity-0 translate-y-2 pointer-events-none transition-all duration-200 no-print"
  ></div>

  <script is:inline>
    (function() {
      var toastTimer = null;
      var btnTimer = null;

      function showToast(message) {
        var toast = document.getElementById('copy-toast');
        if (!toast) return;
        toast.textContent = message;
        toast.classList.remove('opacity-0', 'translate-y-2', 'pointer-events-none');
        toast.classList.add('opacity-100', 'translate-y-0');
        if (toastTimer) clearTimeout(toastTimer);
        toastTimer = setTimeout(function() {
          toast.classList.remove('opacity-100', 'translate-y-0');
          toast.classList.add('opacity-0', 'translate-y-2', 'pointer-events-none');
        }, 2500);
      }

      function fallbackCopy(text) {
        var ta = document.createElement('textarea');
        ta.value = text;
        ta.setAttribute('readonly', '');
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        var ok = false;
        try {
          ok = document.execCommand('copy');
        } catch (e) {}
        document.body.removeChild(ta);
        return ok;
      }

      function initComparisonActions() {
        var copyBtn = document.getElementById('copy-link-btn');
        var copyBtnText = document.getElementById('copy-link-btn-text');
        if (copyBtn && copyBtnText) {
          copyBtn.onclick = async function() {
            var url = window.location.href;
            var defaultText = copyBtn.getAttribute('data-default-text') || 'Copy Link';
            var copiedText = copyBtn.getAttribute('data-copied-text') || 'Copied';
            var toastText = copyBtn.getAttribute('data-toast-text') || 'Link copied';
            var copied = false;

            if (navigator.clipboard && navigator.clipboard.writeText) {
              try {
                await navigator.clipboard.writeText(url);
                copied = true;
              } catch (e) {
                copied = fallbackCopy(url);
              }
            } else {
              copied = fallbackCopy(url);
            }

            if (copied) {
              copyBtnText.textContent = '✓ ' + copiedText;
              copyBtn.classList.add('bg-success-bg', 'text-success', 'border-success-border/40');
              showToast(toastText);
              if (btnTimer) clearTimeout(btnTimer);
              btnTimer = setTimeout(function() {
                copyBtnText.textContent = defaultText;
                copyBtn.classList.remove('bg-success-bg', 'text-success', 'border-success-border/40');
              }, 2500);
            }
          };
        }

        var printBtn = document.getElementById('print-comparison-btn');
        if (printBtn) {
          printBtn.onclick = function() {
            window.print();
          };
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initComparisonActions);
      } else {
        initComparisonActions();
      }
      document.addEventListener('astro:page-load', initComparisonActions);
    })();
  </script>
</Layout>
