---
import Layout from '../../../layouts/Layout.astro';
import comparisonsEs from '../../../data/comparisons.es.json';
import comparisonsPt from '../../../data/comparisons.pt.json';
import itemsEs from '../../../data/items.es.json';
import itemsPt from '../../../data/items.pt.json';
import howLongEs from '../../../data/how-long.es.json';
import howLongPt from '../../../data/how-long.pt.json';
import refreezeEs from '../../../data/refreeze.es.json';
import refreezePt from '../../../data/refreeze.pt.json';
import washingEs from '../../../data/washing-machine.es.json';
import washingPt from '../../../data/washing-machine.pt.json';
import type { SupportedLanguage } from '../../../i18n/ui';

export async function getStaticPaths() {
  const esPaths = comparisonsEs.map(item => ({
    params: { lang: 'es', slug: item.slug },
    props: {
      lang: 'es' as SupportedLanguage,
      comparison: item,
      availableLocales: ['en', 'es', 'pt'] as SupportedLanguage[]
    }
  }));

  const ptPaths = comparisonsPt.map(item => ({
    params: { lang: 'pt', slug: item.slug },
    props: {
      lang: 'pt' as SupportedLanguage,
      comparison: item,
      availableLocales: ['en', 'es', 'pt'] as SupportedLanguage[]
    }
  }));

  return [...esPaths, ...ptPaths];
}

interface Props {
  lang: SupportedLanguage;
  comparison: typeof comparisonsEs[number];
  availableLocales: SupportedLanguage[];
}

const { lang, comparison, availableLocales } = Astro.props;
const isEs = lang === 'es';

const {
  slug,
  category,
  item1,
  item2,
  winner,
  verdict,
  table,
  item1Pros,
  item2Pros,
  useCases,
  safetyNotes,
  faqs,
  relatedComparisons,
  relatedItems
} = comparison;

// Human-readable category names
const categoryNames: Record<string, string> = isEs
  ? {
      "cooking-method": "Métodos de Cocción",
      "container-material": "Recipientes y Materiales",
      "food-storage": "Almacenamiento de Alimentos",
      "appliance-safety": "Seguridad de Electrodomésticos"
    }
  : {
      "cooking-method": "Métodos de Cozimento",
      "container-material": "Recipientes e Materiais",
      "food-storage": "Armazenamento de Alimentos",
      "appliance-safety": "Segurança de Eletrodomésticos"
    };

function getMetaDescription(i1: string, i2: string, win: string, verd: string) {
  let prefix = "";
  if (isEs) {
    if (win === "item1") {
      prefix = `¿Es mejor ${i1} o ${i2}? Nuestra guía de seguridad señala a ${i1} como ganador. `;
    } else if (win === "item2") {
      prefix = `¿Es mejor ${i1} o ${i2}? Nuestra guía de seguridad señala a ${i2} como ganador. `;
    } else {
      prefix = `¿Es mejor ${i1} o ${i2}? Nuestra comparativa detalla cuándo utilizar cada uno. `;
    }
  } else {
    if (win === "item1") {
      prefix = `É melhor ${i1} ou ${i2}? Nosso guia de segurança aponta ${i1} como vencedor. `;
    } else if (win === "item2") {
      prefix = `É melhor ${i1} ou ${i2}? Nosso guia de segurança aponta ${i2} como vencedor. `;
    } else {
      prefix = `É melhor ${i1} ou ${i2}? Nosso comparativo detalha quando usar cada opção. `;
    }
  }
  
  let desc = `${prefix}${verd}`;
  
  if (desc.length < 150) {
    const suffix = isEs
      ? " Consulta nuestra tabla comparativa detallada, ventajas y pautas de seguridad."
      : " Confira nossa tabela comparativa completa, vantagens e dicas de segurança.";
    desc = (desc + suffix).substring(0, 160);
  }
  
  if (desc.length > 160) {
    desc = desc.substring(0, 157) + "...";
  }
  
  if (desc.length < 150) {
    desc = desc.padEnd(150, '.');
  }
  
  return desc;
}

const pageTitle = isEs
  ? `${item1} vs ${item2}: ¿Cuál es Mejor? | ¿Es Seguro en la Cocina?`
  : `${item1} vs ${item2}: Qual É Melhor? | É Seguro na Cozinha?`;

const pageDescription = getMetaDescription(item1, item2, winner, verdict);

const comparisonsData = isEs ? comparisonsEs : comparisonsPt;
let relatedComparisonObjects = comparisonsData.filter(c => 
  relatedComparisons.includes(c.slug) && c.slug !== slug
);
if (relatedComparisonObjects.length < 4) {
  const extraComps = comparisonsData.filter(c => 
    c.slug !== slug && !relatedComparisons.includes(c.slug)
  );
  for (const c of extraComps) {
    if (relatedComparisonObjects.length >= 4) break;
    relatedComparisonObjects.push(c);
  }
}
relatedComparisonObjects = relatedComparisonObjects.slice(0, 4);

function formatItemLinkText(url: string) {
  const parts = url.split('/').filter(Boolean);
  const cleanParts = parts.filter(p => p !== 'es' && p !== 'pt');
  if (cleanParts.length < 2) return isEs ? "Guía de Seguridad en Cocina" : "Guia de Segurança na Cozinha";
  const app = cleanParts[0];
  const itm = cleanParts[1].split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
  return isEs ? `Guía de ${itm} en ${app}` : `Guia de ${itm} em ${app}`;
}

const activeItems = isEs ? itemsEs : itemsPt;
const activeHowLong = isEs ? howLongEs : howLongPt;
const activeRefreeze = isEs ? refreezeEs : refreezePt;
const activeWashing = isEs ? washingEs : washingPt;

function normalizeName(name: string) {
  return name.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim();
}

function resolveItemPageUrl(itemName: string) {
  const norm = normalizeName(itemName);
  const match = activeItems.find(i => normalizeName(i.item) === norm);
  if (match) return `/${lang}/${match.appliance}/${match.slug}/`;
  
  const hlMatch = activeHowLong.find(h => normalizeName(h.item) === norm);
  if (hlMatch) return `/${lang}/how-long/${hlMatch.slug}/`;
  
  const rfMatch = activeRefreeze.find(r => normalizeName(r.item) === norm);
  if (rfMatch) return `/${lang}/refreeze/${rfMatch.slug}/`;
  
  const wMatch = activeWashing.find(w => normalizeName(w.item) === norm);
  if (wMatch) return `/${lang}/washing-machine/${wMatch.slug}/`;
  
  return null;
}

const item1Url = resolveItemPageUrl(item1);
const item2Url = resolveItemPageUrl(item2);
const individualGuides: { name: string; url: string }[] = [];
if (item1Url) individualGuides.push({ name: item1, url: item1Url });
if (item2Url) individualGuides.push({ name: item2, url: item2Url });

if (relatedItems) {
  relatedItems.forEach(url => {
    let cleanUrl = url.endsWith('/') ? url : `${url}/`;
    if (!cleanUrl.startsWith(`/${lang}/`)) {
      cleanUrl = `/${lang}${cleanUrl.startsWith('/') ? '' : '/'}${cleanUrl}`;
    }
    if (!individualGuides.some(g => g.url === cleanUrl)) {
      individualGuides.push({ name: formatItemLinkText(cleanUrl), url: cleanUrl });
    }
  });
}

const preservationGuides: { name: string; url: string; label: string }[] = [];
const addPreservationGuide = (name: string, url: string, label: string) => {
  const cleanUrl = url.endsWith('/') ? url : `${url}/`;
  if (!preservationGuides.some(g => g.url === cleanUrl)) {
    preservationGuides.push({ name, url: cleanUrl, label });
  }
};

const item1Norm = normalizeName(item1);
const item1Hl = activeHowLong.find(h => normalizeName(h.item) === item1Norm);
if (item1Hl) addPreservationGuide(isEs ? `¿Cuánto Dura ${item1Hl.item}?` : `Quanto Tempo Dura ${item1Hl.item}?`, `/${lang}/how-long/${item1Hl.slug}/`, isEs ? 'Vida Útil' : 'Validade');
const item1Rf = activeRefreeze.find(r => normalizeName(r.item) === item1Norm);
if (item1Rf) addPreservationGuide(isEs ? `¿Se Puede Recongelar ${item1Rf.item}?` : `Pode Recongelar ${item1Rf.item}?`, `/${lang}/refreeze/${item1Rf.slug}/`, isEs ? 'Recongelación' : 'Recongelamento');

const item2Norm = normalizeName(item2);
const item2Hl = activeHowLong.find(h => normalizeName(h.item) === item2Norm);
if (item2Hl) addPreservationGuide(isEs ? `¿Cuánto Dura ${item2Hl.item}?` : `Quanto Tempo Dura ${item2Hl.item}?`, `/${lang}/how-long/${item2Hl.slug}/`, isEs ? 'Vida Útil' : 'Validade');
const item2Rf = activeRefreeze.find(r => normalizeName(r.item) === item2Norm);
if (item2Rf) addPreservationGuide(isEs ? `¿Se Puede Recongelar ${item2Rf.item}?` : `Pode Recongelar ${item2Rf.item}?`, `/${lang}/refreeze/${item2Rf.slug}/`, isEs ? 'Recongelación' : 'Recongelamento');

// Schemas
const pageCanonical = `https://isitkitchensafe.com/${lang}/compare/${slug}/`;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": isEs ? "Inicio" : "Início",
      "item": `https://isitkitchensafe.com/${lang}/`
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": isEs ? "Comparar" : "Comparar",
      "item": `https://isitkitchensafe.com/${lang}/compare/`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": `${item1} vs ${item2}`,
      "item": pageCanonical
    }
  ]
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": isEs ? `${item1} vs ${item2}: ¿Cuál es Mejor?` : `${item1} vs ${item2}: Qual É Melhor?`,
  "description": pageDescription,
  "image": "https://isitkitchensafe.com/favicon.svg",
  "author": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "url": "https://isitkitchensafe.com"
  },
  "publisher": {
    "@type": "Organization",
    "name": "IsItKitchenSafe",
    "logo": {
      "@type": "ImageObject",
      "url": "https://isitkitchensafe.com/favicon.svg"
    }
  },
  "datePublished": "2026-06-13T12:00:00Z",
  "dateModified": "2026-06-13T12:00:00Z",
  "mainEntityOfPage": pageCanonical
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout title={pageTitle} description={pageDescription} excludeBreadcrumbSchema={true} excludeArticleSchema={true} excludeFaqSchema={true} availableLocales={availableLocales} lang={lang} ogType="article">
  <!-- Inject Schemas into Head Slot -->
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <div class="bg-canvas py-8">
    <div class="max-w-[800px] mx-auto px-6">
      
      <!-- Breadcrumbs -->
      <nav class="flex gap-2 text-muted text-[13px] mb-6" aria-label="Breadcrumb">
        <a href={`/${lang}/`} class="hover:text-ink transition-colors">{isEs ? "Inicio" : "Início"}</a>
        <span>/</span>
        <a href={`/${lang}/compare/`} class="hover:text-ink transition-colors">{isEs ? "Comparar" : "Comparar"}</a>
        <span>/</span>
        <span class="text-ink font-medium">{item1} vs {item2}</span>
      </nav>

      <!-- H1 Page Header -->
      <header class="mb-8 border-b border-hairline pb-8">
        <span class="text-xs font-bold uppercase tracking-wider text-muted mb-2 block">
          {isEs ? `Comparación de ${categoryNames[category]}` : `Comparação de ${categoryNames[category]}`}
        </span>
        <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-6 leading-tight">
          {isEs ? `${item1} vs ${item2}: ¿Cuál Deberías Usar?` : `${item1} vs ${item2}: Qual Você Deve Usar?`}
        </h1>

        <!-- Winner Badge above the fold -->
        <div class="flex items-center mb-6">
          {winner === "item1" && (
            <div class="inline-flex items-center gap-2 px-6 py-3 bg-success-bg border border-success/30 rounded-full text-success text-lg md:text-xl font-bold font-display">
              <span class="text-2xl leading-none">✓</span>
              <span>{item1.toUpperCase()} {isEs ? "GANA" : "VENCE"}</span>
            </div>
          )}
          {winner === "item2" && (
            <div class="inline-flex items-center gap-2 px-6 py-3 bg-success-bg border border-success/30 rounded-full text-success text-lg md:text-xl font-bold font-display">
              <span class="text-2xl leading-none">✓</span>
              <span>{item2.toUpperCase()} {isEs ? "GANA" : "VENCE"}</span>
            </div>
          )}
          {winner === "depends" && (
            <div class="inline-flex items-center gap-2 px-6 py-3 bg-surface-soft border border-hairline rounded-full text-body text-lg md:text-xl font-bold font-display">
              <span class="text-xl leading-none">⚠</span>
              <span>{isEs ? "DEPENDE" : "DEPENDE"}</span>
            </div>
          )}
        </div>

        <!-- Quick Verdict -->
        <div class="p-5 bg-surface-soft border-l-4 border-primary rounded-r-md">
          <p class="text-body-md text-ink text-[15px] leading-relaxed">
            <strong>{verdict}</strong>
          </p>
        </div>
      </header>

      <!-- Side-by-Side Comparison Table -->
      <section class="mb-12">
        <h2 class="text-title-lg font-bold text-ink mb-6">
          {isEs ? "Comparación Detallada" : "Comparação Detalhada"}
        </h2>
        
        <!-- Desktop Table -->
        <div class="hidden md:block overflow-hidden border border-hairline rounded-lg">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-surface-soft border-b border-hairline">
                <th class="w-[20%] p-4 font-display font-medium text-ink text-[14px]">
                  {isEs ? "Aspecto" : "Aspecto"}
                </th>
                <th class={`w-[40%] p-4 font-display font-medium text-[14px] text-center ${winner === 'item1' ? 'bg-success-bg/50 border-l-2 border-success-border' : 'bg-surface-soft/50'}`}>
                  {item1}
                </th>
                <th class={`w-[40%] p-4 font-display font-medium text-[14px] text-center ${winner === 'item2' ? 'bg-success-bg/50 border-l-2 border-success-border' : 'bg-surface-soft/50'}`}>
                  {item2}
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-hairline">
              {table.map((row, idx) => (
                <tr class={idx % 2 === 0 ? 'bg-canvas' : 'bg-surface-soft/30'}>
                  <td class="p-4 font-medium text-ink text-[13px]">{row.aspect}</td>
                  
                  <td class={`p-4 text-[13px] text-center ${winner === 'item1' ? 'bg-success-bg border-l-2 border-success-border font-medium text-success' : 'bg-surface-soft text-muted'}`}>
                    {row.item1Value}
                  </td>
                  
                  <td class={`p-4 text-[13px] text-center ${winner === 'item2' ? 'bg-success-bg border-l-2 border-success-border font-medium text-success' : 'bg-surface-soft text-muted'}`}>
                    {row.item2Value}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <!-- Mobile Table Stacking -->
        <div class="block md:hidden flex flex-col gap-4">
          {table.map((row) => (
            <div class="border border-hairline rounded-lg overflow-hidden">
              <div class="bg-surface-soft px-4 py-2 text-ink font-bold text-[13px] border-b border-hairline">
                {row.aspect}
              </div>
              <div class="p-4 flex flex-col gap-3">
                <div class={`p-3 rounded-md ${winner === 'item1' ? 'bg-success-bg border-l-4 border-success-border' : 'bg-surface-soft'}`}>
                  <span class="block text-[11px] font-bold text-muted uppercase mb-1">{item1}</span>
                  <span class={`text-[13px] ${winner === 'item1' ? 'text-success font-medium' : 'text-body'}`}>{row.item1Value}</span>
                </div>
                <div class={`p-3 rounded-md ${winner === 'item2' ? 'bg-success-bg border-l-4 border-success-border' : 'bg-surface-soft'}`}>
                  <span class="block text-[11px] font-bold text-muted uppercase mb-1">{item2}</span>
                  <span class={`text-[13px] ${winner === 'item2' ? 'text-success font-medium' : 'text-body'}`}>{row.item2Value}</span>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Detailed Pros Section -->
      <section class="mb-12 border-t border-hairline pt-8">
        <h2 class="text-title-lg font-bold text-ink mb-6">
          {isEs ? "Ventajas y Pros" : "Vantagens e Prós"}
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="p-6 bg-surface-soft/30 border border-hairline rounded-lg">
            <h3 class="text-title-sm font-bold text-ink mb-4 pb-2 border-b border-hairline flex items-center gap-2">
              <span class="text-success text-lg">✓</span>
              <span>{item1} ({isEs ? "Ventajas" : "Vantagens"})</span>
            </h3>
            <ul class="flex flex-col gap-3 text-[13.5px] text-body leading-relaxed">
              {item1Pros.map(pro => (
                <li class="flex items-start gap-2.5">
                  <span class="text-success mt-0.5 shrink-0">•</span>
                  <span>{pro}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="p-6 bg-surface-soft/30 border border-hairline rounded-lg">
            <h3 class="text-title-sm font-bold text-ink mb-4 pb-2 border-b border-hairline flex items-center gap-2">
              <span class="text-success text-lg">✓</span>
              <span>{item2} ({isEs ? "Ventajas" : "Vantagens"})</span>
            </h3>
            <ul class="flex flex-col gap-3 text-[13.5px] text-body leading-relaxed">
              {item2Pros.map(pro => (
                <li class="flex items-start gap-2.5">
                  <span class="text-success mt-0.5 shrink-0">•</span>
                  <span>{pro}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <!-- Best Use Cases Section -->
      <section class="mb-12 border-t border-hairline pt-8">
        <h2 class="text-title-lg font-bold text-ink mb-6">
          {isEs ? "Mejores Casos de Uso" : "Melhores Casos de Uso"}
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {useCases.map(uc => (
            <div class="p-5 border border-hairline rounded-lg bg-canvas shadow-xs">
              <h3 class="text-title-sm font-bold text-ink mb-2 line-clamp-1">{uc.situation}</h3>
              <p class="text-body-md text-muted text-[13px] leading-relaxed">{uc.recommendation}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Safety Considerations Section -->
      <section class="mb-12 border-t border-hairline pt-8">
        <h2 class="text-title-lg font-bold text-ink mb-6">
          {isEs ? "Consideraciones de Seguridad" : "Considerações de Segurança"}
        </h2>
        <div class="p-6 bg-[#fce8e6]/30 border border-error-bg rounded-lg">
          <ul class="flex flex-col gap-4 text-[13.5px] text-body leading-relaxed">
            {safetyNotes.map(note => (
              <li class="flex items-start gap-3">
                <span class="text-signature-coral mt-0.5 shrink-0 font-bold">⚠️</span>
                <span>{note}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- FAQ Section -->
      <section class="mb-12 border-t border-hairline pt-8">
        <h2 class="text-title-lg font-bold text-ink mb-6">
          {isEs ? "Preguntas Frecuentes" : "Perguntas Frequentes"}
        </h2>
        <div class="flex flex-col gap-4">
          {faqs.map(faq => (
            <details class="group border border-hairline rounded-lg bg-canvas [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex justify-between items-center p-4 font-medium text-ink cursor-pointer select-none text-[14px]">
                <span>{faq.question}</span>
                <span class="text-muted group-open:rotate-180 transition-transform text-xs">▼</span>
              </summary>
              <div class="px-4 pb-4 text-body-md text-muted leading-relaxed border-t border-hairline pt-3 text-[13.5px]">
                {faq.answer}
              </div>
            </details>
          ))}
        </div>
      </section>

      <!-- Compared Individual Item Guides Grid -->
      {individualGuides.length > 0 && (
        <section class="mb-12 border-t border-hairline pt-8">
          <h2 class="text-title-lg font-bold text-ink mb-6">
            {isEs ? "Guías Individuales de Seguridad Relacionadas" : "Guias Individuais de Segurança Relacionados"}
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {individualGuides.map(g => (
              <a 
                href={g.url}
                class="flex items-center justify-between p-4 border border-hairline rounded-lg hover:border-border-strong hover:bg-surface-soft/40 transition-all text-decoration-none text-ink font-medium text-[13.5px] shadow-xs"
              >
                <span>{g.name}</span>
                <span class="text-link text-xs">{isEs ? "Leer Guía →" : "Ler Guia →"}</span>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- Relevant Preservation & Food Storage Guides -->
      {preservationGuides.length > 0 && (
        <section class="mb-12 border-t border-hairline pt-8">
          <h2 class="text-title-lg font-bold text-ink mb-6">
            {isEs ? "Guías de Conservación y Vida Útil" : "Guias de Conservação e Validade"}
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {preservationGuides.map(g => (
              <a 
                href={g.url}
                class="flex items-center justify-between p-4 border border-hairline rounded-lg hover:border-border-strong hover:bg-surface-soft/40 transition-all text-decoration-none text-ink font-medium text-[13.5px] shadow-xs"
              >
                <span>{g.name}</span>
                <span class="text-xs text-muted font-normal bg-success-bg px-2 py-0.5 rounded-sm">{g.label}</span>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- Related Comparisons Grid -->
      {relatedComparisonObjects.length > 0 && (
        <section class="mb-12 border-t border-hairline pt-8">
          <h2 class="text-title-lg font-bold text-ink mb-6">
            {isEs ? "Comparaciones de Seguridad Relacionadas" : "Comparações de Segurança Relacionadas"}
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            {relatedComparisonObjects.map(rc => (
              <a 
                href={`/${lang}/compare/${rc.slug}/`}
                class="block border border-hairline rounded-lg p-5 hover:border-border-strong hover:bg-surface-soft/40 transition-all text-decoration-none"
              >
                <span class="text-xs uppercase tracking-wider text-muted font-bold block mb-1">
                  {categoryNames[rc.category]}
                </span>
                <span class="text-ink font-display font-medium text-[14px] block mb-2">
                  {rc.item1} vs {rc.item2}
                </span>
                <p class="text-[12.5px] text-muted line-clamp-2 leading-relaxed">
                  {rc.verdict}
                </p>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- Back Link -->
      <footer class="border-t border-hairline pt-8 text-center">
        <a 
          href={`/${lang}/compare/`} 
          class="inline-flex items-center gap-1.5 text-link hover:underline font-medium text-[14px]"
        >
          <span>←</span>
          <span>{isEs ? "Volver al índice de comparaciones" : "Voltar ao índice de comparações"}</span>
        </a>
      </footer>

    </div>
  </div>
</Layout>
