const content = contentByLang[lang as keyof typeof contentByLang] || contentByLang.es;
---

<Layout title={content.title} description={content.description} faqs={content.faqs} excludeArticleSchema={true} availableLocales={availableLocales} lang={lang}>
  <section class="max-w-[800px] mx-auto px-6 py-[96px]">
    <h1 class="text-display-lg font-medium text-ink tracking-tight mb-8">{content.h1}</h1>
    
    <div class="prose max-w-none text-body-md text-body leading-relaxed flex flex-col gap-6">
      <p class="text-muted text-[13px]">{content.lastUpdated}</p>
      <p>{content.pIntro}</p>

      <div class="border-t border-hairline my-4"></div>

      <h2 class="text-title-lg text-ink font-medium tracking-tight">{content.hLog}</h2>
      <p>{content.pLog}</p>

      <h2 class="text-title-lg text-ink font-medium tracking-tight">{content.hCookie}</h2>
      <p>{content.pCookie}</p>

      <h2 class="text-title-lg text-ink font-medium tracking-tight">{content.hDart}</h2>
      <p>{content.pDart}</p>

      <h2 class="text-title-lg text-ink font-medium tracking-tight">{content.hAds}</h2>
      <p>{content.pAds}</p>
      <ul class="list-disc pl-5 flex flex-col gap-1">
        {content.adsList.map(item => (
          <li><strong>{item}</strong></li>
        ))}
      </ul>
      <p>{content.pAdsMore}</p>

      <h2 class="text-title-lg text-ink font-medium tracking-tight">{content.hGdpr}</h2>
      <p>{content.pGdpr1}</p>
      <p>{content.pGdprLegal}</p>
      <ul class="list-disc pl-5 flex flex-col gap-1">
        {content.gdprLegalList.map(item => (
          <li>{item}</li>
        ))}
      </ul>
      <p>{content.pGdprRights}</p>
      <ul class="list-disc pl-5 flex flex-col gap-2">
        {content.gdprRightsList.map(item => {
          const sep = item.includes('：') ? '：' : ':';
          const parts = item.split(sep);
          const title = parts[0];
          const desc = parts.slice(1).join(sep).trim();
          return (
            <li><strong>{title}{sep}</strong> {desc}</li>
          );
        })}
      </ul>

      <h2 class="text-title-lg text-ink font-medium tracking-tight">{content.hRetention}</h2>
      <p>{content.pRetention}</p>

      <h2 class="text-title-lg text-ink font-medium tracking-tight">{content.hContact}</h2>
      <p>
        {content.pContact}<!--email_off--><a href="mailto:support@isitkitchensafe.com" class="text-link hover:underline">support@isitkitchensafe.com</a><!--/email_off-->{content.pContactEnd}
      </p>
    </div>
  </section>
</Layout>
