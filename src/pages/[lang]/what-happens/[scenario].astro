const currentUi = ui[lang as keyof typeof ui] || ui.es;
const dangerBadgeText = data.dangerLevel === 'dangerous' ? currentUi.badgeDangerous : data.dangerLevel === 'caution' ? currentUi.badgeCaution : currentUi.badgeSafe;

const howToName = lang === 'es' ? `Cómo prevenir accidentes con ${data.item}`
  : lang === 'pt' ? `Como prevenir acidentes com ${data.item}`
  : lang === 'ja' ? `${data.item}の事故防止と安全対策`
  : `如何预防${data.item}的安全事故`;

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": howToName,
  "description": data.shortAnswer,
  "step": data.prevention?.map((prev: string, idx: number) => ({
    "@type": "HowToStep",
    "position": idx + 1,
    "text": prev
  })) || []
};

// Localized E-E-A-T links & Smart 25-Tool Contextual Consumer Calculator CTA
const isEs = lang === 'es';
const isPt = lang === 'pt';
const isZh = lang === 'zh-cn';
const translatePath = useTranslatedPath(lang);
const methodologyUrl = getDirectoryUrl('methodology', lang);
const contactUrl = getDirectoryUrl('contact', lang);

type RecommendedToolKey =
  | 'kitchenFire'
  | 'instantPot'
  | 'slowCooker'
  | 'knifeCare'
  | 'foodAllergy'
  | 'dishwasherDosage'
  | 'induction'
  | 'castIron'
  | 'ovenRack'
  | 'moldyFood'
  | 'pantry'
  | 'fridgeZone'
  | 'oilSmokePoint'
  | 'babyBottle'
  | 'cleaner'
  | 'descaling'
  | 'plastic'
  | 'airfryer'
  | 'microwaveWattage'
  | 'powerOutage'
  | 'leftover'
  | 'thawing'
  | 'cookingTemp'
  | 'ovenTemp'
  | 'symbol';

function selectScenarioToolKey(slugRaw: string): RecommendedToolKey {
  const s = String(slugRaw || '').toLowerCase();

  if (/(baby-bottle|breast-milk|sippy-cup|pacifier|formula|melamine-kids|bamboo-kids|kids-plate)/.test(s)) {
    return 'babyBottle';
  }
  if (/(mix-bleach|bleach|ammonia|peroxide|drain-cleaner|cleaner-mix)/.test(s)) {
    return 'cleaner';
  }
  if (/(grease-fire|kitchen-fire|aerosol|aluminum-foil|tin-foil|wax-paper|paper-bag|cardboard|leave-oven-on|leave-gas-stove|leave-electric-stove|boil-dry|microwave-cd|microwave-metal|microwave-travel-mug|microwave-nothing)/.test(s)) {
    return 'kitchenFire';
  }
  if (/(instant-pot|pressure-cooker)/.test(s)) {
    return 'instantPot';
  }
  if (/(slow-cooker|crock-pot)/.test(s)) {
    return 'slowCooker';
  }
  if (/(coffee|kettle|descale|espresso)/.test(s)) {
    return 'descaling';
  }
  if (/(cast-iron|carbon-steel|seasoning|dutch-oven|enameled-cast)/.test(s)) {
    return 'castIron';
  }
  if (/(knife|knives|cutting-board)/.test(s)) {
    return 'knifeCare';
  }
  if (/(cross-contaminate|cross-contact|allergen|wooden-spoon|sponge|toaster)/.test(s)) {
    return 'foodAllergy';
  }
  if (/(dishwasher|detergent)/.test(s)) {
    return 'dishwasherDosage';
  }
  if (/(induction|copper|moka-pot|tri-ply|ferromagnetic)/.test(s)) {
    return 'induction';
  }
  if (/(smoking-oil|cooking-oil|frying-oil|olive-oil|avocado-oil|canola-oil|smoke-point|burn-butter)/.test(s)) {
    return 'oilSmokePoint';
  }
  if (/(moldy|\bmold\b|mould)/.test(s)) {
    return 'moldyFood';
  }
  if (/(damaged-can|dented-can|canned-food|expired-soda|sprouted-potatoes|honey|rancid|pantry|spices|flour)/.test(s)) {
    return 'pantry';
  }
  if (/(plastic|styrofoam|tupperware|melamine|pvc|polystyrene)/.test(s)) {
    return 'plastic';
  }
  if (/(thaw|refreeze-thawed|frozen-meat)/.test(s)) {
    return 'thawing';
  }
  if (/(pink-chicken|undercooked|raw-cookie-dough|raw-chicken|raw-pork|raw-egg|internal-temp)/.test(s)) {
    return 'cookingTemp';
  }
  if (/(power-outage|blackout|door-open|keep-freezer-too)/.test(s)) {
    return 'powerOutage';
  }
  if (/(expired-eggs|expired-milk|eggs-in-shell|bananas|avocado|carbonated-drinks|wine-bottle|fridge-zone|produce)/.test(s)) {
    return 'fridgeZone';
  }
  if (/(leftover|left-out-overnight|rice-out-overnight|food-in-oven-overnight|cooked-rice|freezer-burned|freeze-hot-food|freeze-bread|freeze-mayonnaise|freeze-food|freeze-wet|spoil|expired)/.test(s)) {
    return 'leftover';
  }
  if (/(air-?fryer)/.test(s)) {
    return 'airfryer';
  }
  if (/(preheat-oven|open-oven|cold-dish-in-hot-oven|empty-pan-in-oven|oven-rack|parchment|silicone|broiler)/.test(s)) {
    return 'ovenRack';
  }
  if (/(glass|pyrex|ceramic|stoneware|hot-pan|hot-stove|cold-counter|non-?stick|oven)/.test(s)) {
    return 'ovenTemp';
  }
  if (/(microwave)/.test(s)) {
    return 'microwaveWattage';
  }
  return 'symbol';
}

