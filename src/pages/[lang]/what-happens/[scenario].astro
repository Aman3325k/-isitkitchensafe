const recommendedTool = toolCatalog[selectScenarioToolKey(data.slug)];
const recommendedToolUrl = translatePath(recommendedTool.path);

// Dynamic per-page OG social preview card (/api/og.svg)
function truncateOgText(text: string, maxLen: number): string {
  const clean = String(text || '').replace(/\s+/g, ' ').trim();
  if (clean.length <= maxLen) return clean;
  const sliced = clean.slice(0, maxLen - 1);
  const lastSpace = sliced.lastIndexOf(' ');
  const cut = lastSpace > Math.floor(maxLen * 0.6) ? sliced.slice(0, lastSpace) : sliced;
  return `${cut.replace(/[\s,;:\-—–/]+$/, '')}…`;
}

const ogApplianceMap: Record<string, Record<string, string>> = {
  es: { Microwave: 'Microondas', Dishwasher: 'Lavavajillas', Freezer: 'Congelador', Oven: 'Horno', Kitchen: 'Seguridad en Cocina' },
  pt: { Microwave: 'Micro-ondas', Dishwasher: 'Lava-Louças', Freezer: 'Freezer', Oven: 'Forno', Kitchen: 'Segurança na Cozinha' },
  'zh-cn': { Microwave: '微波炉', Dishwasher: '洗碗机', Freezer: '冷冻室', Oven: '烤箱', Kitchen: '厨房安全' },
  ja: { Microwave: '電子レンジ', Dishwasher: '食洗機', Freezer: '冷凍庫', Oven: 'オーブン', Kitchen: 'キッチン安全' }
};

const isCjkLocale = lang === 'zh-cn' || lang === 'ja';
const localizedOgAppliance = (ogApplianceMap[lang] || ogApplianceMap.es)[isKitchenFallback ? 'Kitchen' : appliance] || currentUi.guideTag;
const ogTitle = truncateOgText(pageH1, isCjkLocale ? 44 : 70);
const ogVerdict = data.dangerLevel === 'safe' ? 'YES' : data.dangerLevel === 'caution' ? 'DEPENDS' : 'NO';
const ogAppliance = truncateOgText(localizedOgAppliance, isCjkLocale ? 18 : 32);
const ogSummary = truncateOgText(data.shortAnswer || '', isCjkLocale ? 64 : 115);
const ogParams = new URLSearchParams({
  title: ogTitle,
  verdict: ogVerdict,
  appliance: ogAppliance,
  summary: ogSummary,
});
const ogImage = `/api/og.svg?${ogParams.toString()}`;

const uxCopy = {
