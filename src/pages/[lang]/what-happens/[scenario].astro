---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import whatHappensEs from '../../../data/what-happens.es.json';
import whatHappensPt from '../../../data/what-happens.pt.json';
import whatHappensJa from '../../../data/what-happens.ja.json';
import whatHappensZh from '../../../data/what-happens.zh-cn.json';
import whatHappensEn from '../../../data/what-happens.json';
import whatHappensNoindex from '../../../data/whatHappensNoindex.json';
import { getDirectoryUrl, useTranslatedPath } from '../../../i18n/utils';
import type { SupportedLanguage } from '../../../i18n/ui';

export function getStaticPaths() {
  const paths: Array<{
    params: { lang: string; scenario: string };
    props: { data: any; lang: SupportedLanguage; availableLocales: SupportedLanguage[] };
  }> = [];

  const allLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'ja', 'zh-cn'];

  whatHappensEs.forEach((item) => {
    paths.push({
      params: { lang: 'es', scenario: item.slug },
      props: { data: item, lang: 'es', availableLocales: allLocales }
    });
  });

  whatHappensPt.forEach((item) => {
    paths.push({
      params: { lang: 'pt', scenario: item.slug },
      props: { data: item, lang: 'pt', availableLocales: allLocales }
    });
  });

  whatHappensJa.forEach((item) => {
    paths.push({
      params: { lang: 'ja', scenario: item.slug },
      props: { data: item, lang: 'ja', availableLocales: allLocales }
    });
  });

  whatHappensZh.forEach((item) => {
    paths.push({
      params: { lang: 'zh-cn', scenario: item.slug },
      props: { data: item, lang: 'zh-cn', availableLocales: allLocales }
    });
  });

  return paths;
}

interface Props {
  data: any;
  lang: SupportedLanguage;
  availableLocales: SupportedLanguage[];
}

const { data, lang, availableLocales } = Astro.props as Props;
const currentDataset = lang === 'es' ? whatHappensEs : lang === 'pt' ? whatHappensPt : lang === 'ja' ? whatHappensJa : whatHappensZh;

// Find related items within localized dataset
let relatedItems = currentDataset.filter(i => data.relatedItems?.includes(i.slug) && i.slug !== data.slug);
if (relatedItems.length < 5) {
  const sameDangerItems = currentDataset.filter(i => i.dangerLevel === data.dangerLevel && i.slug !== data.slug && !data.relatedItems?.includes(i.slug));
  const existingSlugs = new Set(relatedItems.map(i => i.slug));
  for (const item of sameDangerItems) {
    if (relatedItems.length >= 5) break;
    if (!existingSlugs.has(item.slug)) {
      relatedItems.push(item);
      existingSlugs.add(item.slug);
    }
  }
}
if (relatedItems.length < 5) {
  const anyItems = currentDataset.filter(i => i.slug !== data.slug && !relatedItems.some(ri => ri.slug === i.slug));
  for (const item of anyItems) {
    if (relatedItems.length >= 5) break;
    relatedItems.push(item);
  }
}
relatedItems = relatedItems.slice(0, 5);

// Helper to parse scenario for kitchen fallback consistency
function parseScenario(slug: string) {
  let item = "";
  let appliance = "";
  let isAction = false;
  
  if (slug === 'microwave-cd') {
    appliance = 'Microwave';
    item = 'a CD';
  } else if (slug === 'microwave-egg-in-shell') {
    appliance = 'Microwave';
    item = 'an Egg in Its Shell';
  } else if (slug === 'microwave-tupperware-unmarked') {
    appliance = 'Microwave';
    item = 'Unmarked Tupperware';
  } else if (slug === 'microwave-paper-bag') {
    appliance = 'Microwave';
    item = 'a Paper Bag';
  } else if (slug === 'put-paper-bag-in-oven') {
    appliance = 'Oven';
    item = 'a Paper Bag';
  } else if (slug === 'microwave-sealed-container') {
    appliance = 'Microwave';
    item = 'a Sealed Container';
  } else if (slug === 'microwave-travel-mug') {
    appliance = 'Microwave';
    item = 'a Travel Mug';
  } else if (slug.startsWith("microwave-")) {
    if (slug === "microwave-nothing" || slug === "microwave-water-too-long" || slug === "microwave-frozen-meat-wrong") {
      isAction = true;
      appliance = "Kitchen";
    } else {
      appliance = "Microwave";
      item = slug.replace("microwave-", "").replace(/-/g, " ");
    }
  } else if (slug.startsWith("put-") && slug.includes("-in-dishwasher")) {
    if (slug === "put-too-much-detergent") {
      isAction = true;
      appliance = "Kitchen";
    } else {
      appliance = "Dishwasher";
      item = slug.replace("put-", "").replace("-in-dishwasher", "").replace(/-/g, " ");
    }
  } else if (slug.endsWith("-in-dishwasher")) {
    if (slug === "use-dish-soap-in-dishwasher" || slug.startsWith("run-dishwasher-")) {
      isAction = true;
      appliance = "Kitchen";
    } else {
      appliance = "Dishwasher";
      item = slug.replace("-in-dishwasher", "").replace(/-/g, " ");
    }
  } else if (slug.startsWith("run-dishwasher-")) {
    isAction = true;
    appliance = "Kitchen";
  } else if (slug.startsWith("refreeze-")) {
    isAction = true;
    appliance = "Kitchen";
  } else if (slug.startsWith("freeze-")) {
    if (slug === "freeze-hot-food" || slug === "freeze-cooked-rice-wrong" || slug === "freeze-bread-wrong") {
      isAction = true;
      appliance = "Kitchen";
    } else {
      appliance = "Freezer";
      item = slug.replace("freeze-", "").replace(/-/g, " ");
    }
  } else if (slug.startsWith("leave-freezer-")) {
    isAction = true;
    appliance = "Kitchen";
  } else if (slug.startsWith("put-") && slug.includes("-in-oven")) {
    if (slug === "put-cold-dish-in-hot-oven") {
      isAction = true;
      appliance = "Kitchen";
    } else {
      appliance = "Oven";
      item = slug.replace("put-", "").replace("-in-oven", "").replace(/-/g, " ");
    }
  } else if (slug.endsWith("-in-oven")) {
    appliance = "Oven";
    item = slug.replace("-in-oven", "").replace(/-/g, " ");
  } else if (slug.startsWith("leave-oven-")) {
    isAction = true;
    appliance = "Kitchen";
  } else if (slug.startsWith("use-") && slug.includes("-on-oven-bottom")) {
    isAction = true;
    appliance = "Kitchen";
  } else if (slug.startsWith("leave-gas-stove-") || slug.startsWith("leave-electric-stove-")) {
    isAction = true;
    appliance = "Kitchen";
  } else if (slug.startsWith("boil-dry-")) {
    isAction = true;
    appliance = "Kitchen";
  } else if (slug.includes("-on-hot-stove") || slug.includes("-on-cold-counter") || slug.includes("-in-cold-water")) {
    isAction = true;
    appliance = "Kitchen";
  } else if (slug.startsWith("mix-")) {
    isAction = true;
    appliance = "Kitchen";
  } else if (slug.startsWith("eat-") || slug.startsWith("drink-")) {
    isAction = true;
    appliance = "Kitchen";
  } else if (slug.startsWith("leave-fridge-")) {
    isAction = true;
    appliance = "Kitchen";
  } else if (slug.startsWith("keep-freezer-") || slug.startsWith("open-oven-") || slug.startsWith("preheat-oven-") || slug.startsWith("cross-contaminate-") || slug.startsWith("leave-rice-")) {
    isAction = true;
    appliance = "Kitchen";
  } else {
    isAction = true;
    appliance = "Kitchen";
    item = slug.replace(/-/g, " ");
  }
  const specialItems = ['a CD', 'an Egg in Its Shell', 'Unmarked Tupperware', 'a Paper Bag', 'a Sealed Container', 'a Travel Mug'];
  if (item && !item.includes(' ')) {
    item = item.charAt(0).toUpperCase() + item.slice(1);
  } else if (item && !specialItems.includes(item)) {
    item = item.split(' ').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');
  }
  return { item, appliance, isAction };
}

const { appliance, isAction } = parseScenario(data.slug);
const isKitchenFallback = appliance === "Kitchen" || isAction;
const slugAction = data.slug.split('-').map((word: string) => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');

// For slugs hitting appliance="Kitchen" fallback, if data.item is not set, build from slug
const pageH1 = data.item || (isKitchenFallback ? `What Happens If You ${slugAction}?` : data.item);

// Danger details variables
const dangerValue = data.dangerLevel === 'dangerous' ? 9 : data.dangerLevel === 'caution' ? 5 : 1;
const dangerBarColor = data.dangerLevel === 'dangerous' ? 'bg-error-border' : data.dangerLevel === 'caution' ? 'bg-warning-border' : 'bg-success-border';
const dangerWidthClass = data.dangerLevel === 'dangerous' ? 'w-[90%]' : data.dangerLevel === 'caution' ? 'w-[50%]' : 'w-[20%]';
const dangerTextColor = data.dangerLevel === 'dangerous' ? 'text-error' : data.dangerLevel === 'caution' ? 'text-warning' : 'text-success';

// Check generic dry paper FAQ
const dryPaperSlug = whatHappensEn.find(d => (d.faqs || []).some(f => f.answer?.includes('dry paper in the oven')))?.slug;
const genericEnAnswer = whatHappensEn.find(d => d.slug === dryPaperSlug)?.faqs?.[0]?.answer;
const genericLocaleAnswer = (currentDataset as any[]).find(d => d.slug === dryPaperSlug)?.faqs?.[0]?.answer;

const hasGenericFaq = Boolean(
  (genericEnAnswer && data.faqs?.some((f: any) => f.answer === genericEnAnswer)) ||
  (genericLocaleAnswer && (lang === 'es' || lang === 'pt') && data.faqs?.some((f: any) => f.answer === genericLocaleAnswer))
);

const isLangExempt = lang === 'ja' || lang === 'zh-cn';
const isNoindex = !isLangExempt && whatHappensNoindex.includes(data.slug);

