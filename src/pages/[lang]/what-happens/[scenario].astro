---

<Layout 
  title={currentUi.pageTitle} 
  description={currentUi.pageDesc} 
  faqs={data.faqs}
  excludeFaqSchema={hasGenericFaq}
  noindex={isNoindex}
  lang={lang}
  availableLocales={availableLocales}
  ogImage={ogImage}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
  </Fragment>

  <article class="max-w-[800px] mx-auto px-6 py-[48px] md:py-[64px]">
    <!-- Breadcrumbs -->
    <Breadcrumbs 
      items={[
        { label: currentUi.home, href: `/${lang}/` },
        { label: currentUi.whatHappens, href: `/${lang}/what-happens/` },
        { label: data.item }
      ]}
    />

    <!-- Header Section -->
    <header class="mb-10 text-center md:text-left">
      <div class="flex flex-wrap items-center justify-center md:justify-start gap-2.5 mb-3">
        <span class="text-caption text-muted uppercase tracking-wider text-xs">{currentUi.guideTag}</span>
        <span class="text-hairline hidden sm:inline">•</span>
        <a
          href={methodologyUrl}
          class="inline-flex items-center gap-1 text-success font-medium bg-success-bg border border-success-border/30 px-2.5 py-0.5 rounded-full text-xs hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link focus-visible:ring-offset-2"
        >
          {uxCopy.badgeVerified}
        </a>
      </div>
      
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-6 leading-tight">
        {pageH1}
      </h1>

      <!-- Safety Verdict Badge -->
      <div class="flex flex-wrap items-center justify-center md:justify-start gap-3">
        {data.dangerLevel === 'safe' && (
          <div class="badge-yes quick-answer px-6 py-2 text-sm">
            <span class="mr-1.5">✓</span> {dangerBadgeText}
          </div>
        )}
        {data.dangerLevel === 'dangerous' && (
          <div class="badge-no quick-answer px-6 py-2 text-sm">
            <span class="mr-1.5">✗</span> {dangerBadgeText}
          </div>
        )}
        {data.dangerLevel === 'caution' && (
          <div class="badge-depends quick-answer px-6 py-2 text-sm">
            <span class="mr-1.5">⚠</span> {dangerBadgeText}
          </div>
        )}
      </div>

      <!-- Quick-Share & Print Action Bar -->
      <div class="mt-5 flex flex-wrap items-center justify-center md:justify-start gap-2.5 no-print">
        <button
          id="copy-link-btn"
          type="button"
          aria-label={uxCopy.copyAria}
          data-default-text={uxCopy.copyLink}
          data-copied-text={uxCopy.copied}
          data-toast-text={uxCopy.toastCopied}
          class="min-h-[40px] px-3.5 py-2 bg-canvas hover:bg-surface-soft active:scale-[0.98] text-ink border border-hairline rounded-md text-xs font-medium inline-flex items-center gap-2 shadow-xs transition-all cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link focus-visible:ring-offset-2"
        >
          <svg class="w-4 h-4 text-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
          </svg>
          <span id="copy-link-btn-text">{uxCopy.copyLink}</span>
        </button>

        <button
          id="print-guide-btn"
          type="button"
          aria-label={uxCopy.printAria}
          class="min-h-[40px] px-3.5 py-2 bg-canvas hover:bg-surface-soft active:scale-[0.98] text-ink border border-hairline rounded-md text-xs font-medium inline-flex items-center gap-2 shadow-xs transition-all cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link focus-visible:ring-offset-2"
        >
          <svg class="w-4 h-4 text-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4H7v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
          </svg>
          <span>{uxCopy.printGuide}</span>
        </button>
      </div>
    </header>

    <!-- Danger Level Meter Box -->
    <section class="mb-12">
      <div class="bg-surface-soft border border-hairline rounded-md p-6">
        <div class="flex justify-between items-center mb-3">
          <h2 class="text-title-sm text-ink font-medium">{currentUi.dangerIndicator}</h2>
          <span class={`font-bold text-[14px] uppercase ${dangerTextColor}`}>
            {dangerBadgeText}
          </span>
        </div>
        
        <!-- Meter Bar -->
        <div class="w-full bg-surface-strong h-4 rounded-full overflow-hidden mb-3">
          <div class={`h-full ${dangerBarColor} ${dangerWidthClass}`}></div>
        </div>
        <div class="flex justify-between text-xs text-muted">
          <span>{currentUi.levelSafe}</span>
          <span>{currentUi.levelOf}</span>
          <span>{currentUi.levelCritical}</span>
        </div>
      </div>
    </section>

    <!-- Detailed Explanation -->
    <section class="mb-12">
      <div class="p-8 rounded-lg bg-surface-soft border border-hairline">
        <h2 class="text-title-sm text-ink font-medium mb-3">{currentUi.explanationTitle}</h2>
        <p class="short-answer text-title-md font-bold leading-relaxed text-ink mb-4">
          {data.shortAnswer}
        </p>
        
        <div>
          <div class="border-t border-hairline my-4 opacity-50"></div>
          <h3 class="text-caption text-muted mb-2 font-semibold uppercase tracking-wider text-xs">{currentUi.detailsHeading}</h3>
          {data.reason?.split('\n\n').map((para: string) => (
            <p class="text-body-md text-body leading-relaxed mb-4">
              {para}
            </p>
          ))}
        </div>
      </div>
    </section>

    <!-- Health Impact Box -->
    <section class="mb-12">
      <div class="bg-error-bg border border-error-bg rounded-md p-6 text-signature-coral">
        <h3 class="text-title-sm font-semibold mb-2">{currentUi.healthTitle}</h3>
        <p class="text-body-md leading-relaxed text-signature-coral">
          {data.healthImpact}
        </p>
      </div>
    </section>

    <!-- Actions and Prevention -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
      <!-- Immediate Actions -->
      <div class="bg-surface-soft rounded-md p-6 border border-hairline/50">
        <h2 class="text-title-sm text-ink font-medium mb-4 flex items-center gap-2">
          {currentUi.actionsTitle}
        </h2>
        <ul class="flex flex-col gap-3">
          {data.actions?.map((act: string) => (
            <li class="text-body-md text-body flex gap-2.5 items-start leading-relaxed">
              <span class="text-signature-coral font-bold mt-0.5">⚠</span>
              <span>{act}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Prevention Tips -->
      <div class="bg-surface-soft rounded-md p-6 border border-hairline/50">
        <h2 class="text-title-sm text-ink font-medium mb-4 flex items-center gap-2">
          {currentUi.preventionTitle}
        </h2>
        <ul class="flex flex-col gap-3">
          {data.prevention?.map((prev: string) => (
            <li class="text-body-md text-body flex gap-2.5 items-start leading-relaxed">
              <span class="text-success font-bold mt-0.5">✓</span>
              <span>{prev}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Smart Contextual Consumer Calculator CTA Card -->
    <section id="recommended-tool-card" class="bg-surface-soft border border-hairline rounded-lg p-5 sm:p-6 shadow-xs mb-8 no-print">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="min-w-0 flex-1">
          <div class="flex flex-wrap items-center gap-2 mb-1.5">
            <span class="text-base" aria-hidden="true">{recommendedTool.icon}</span>
            <span class="text-[11px] font-semibold uppercase tracking-wider text-signature-coral">{uxCopy.interactiveBadge}</span>
          </div>
          <h2 class="text-title-sm text-ink font-semibold mb-1.5 leading-snug">
            {recommendedTool.title}
          </h2>
          <p class="text-[13px] text-body leading-relaxed">
            {recommendedTool.description}
          </p>
        </div>
        <div class="shrink-0">
          <a
            href={recommendedToolUrl}
            class="min-h-[42px] px-4 py-2.5 bg-primary hover:bg-primary-active active:scale-[0.98] text-on-primary rounded-md text-xs font-medium inline-flex items-center gap-1.5 transition-all whitespace-nowrap focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link focus-visible:ring-offset-2"
          >
            <span>{recommendedTool.cta}</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </section>

    <!-- E-E-A-T Verification & Standards Trust Bar -->
    <section id="editorial-trust-bar" class="bg-surface-soft border border-hairline rounded-lg p-5 mb-12 text-xs text-muted leading-relaxed">
      <div class="flex items-start gap-2.5 pb-3 border-b border-hairline">
        <svg class="w-4 h-4 text-success shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
        </svg>
        <div class="min-w-0 flex-1">
          <p class="text-ink font-medium text-[13px] leading-snug">
            {uxCopy.trustHeading}
          </p>
          <div class="mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-[12px]">
            <a href={methodologyUrl} class="text-link hover:underline font-medium">
              {uxCopy.methodologyCta} &rarr;
            </a>
            <span class="text-hairline hidden sm:inline">•</span>
            <a href={contactUrl} class="text-muted hover:text-ink hover:underline">
              {uxCopy.reportCorrection}
            </a>
          </div>
        </div>
      </div>
      <p class="pt-3 text-[12px] text-muted">
        {uxCopy.trustFoot}
      </p>
    </section>

    <!-- FAQ Section -->
    {!hasGenericFaq && data.faqs && data.faqs.length > 0 && (
      <section class="border-t border-hairline pt-12 mb-16">
        <h2 class="text-title-lg text-ink font-medium tracking-tight mb-8">{currentUi.faqTitle}</h2>
        <div class="flex flex-col">
          {data.faqs?.map((faq: any) => (
            <details class="group border-b border-hairline py-5">
              <summary class="flex items-center justify-between text-title-sm text-ink font-medium cursor-pointer list-none [&::-webkit-details-marker]:hidden select-none">
                <span>{faq.question}</span>
                <span class="text-muted group-open:rotate-180 transition-transform duration-200">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </span>
              </summary>
              <div class="mt-4 text-body-md text-body leading-relaxed pl-1">
                {faq.answer}
              </div>
            </details>
          ))}
        </div>
      </section>
    )}

    <!-- Related Items -->
    {relatedItems.length > 0 && (
      <section class="border-t border-hairline pt-12 mb-16">
        <h2 class="text-title-lg text-ink font-medium tracking-tight mb-8">{currentUi.relatedTitle}</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {relatedItems.map((item: any) => (
            <a 
              href={`/${lang}/what-happens/${item.slug}/`} 
              class="bg-canvas border border-hairline hover:border-border-strong rounded-md p-5 flex flex-col justify-between shadow-xs transition-colors active:scale-[0.98]"
            >
              <div>
                <div class="flex items-center justify-between mb-3">
                  <span class="text-[11px] text-muted uppercase tracking-wider">{item.type}</span>
                  <span class="badge-no text-[10px] px-2 py-0.5">{item.dangerLevel}</span>
                </div>
                <h3 class="text-title-sm text-ink mb-1">
                  {item.item}
                </h3>
                <p class="text-[13px] text-muted line-clamp-2 leading-relaxed">
                  {item.shortAnswer}
                </p>
              </div>
              <span class="text-[12px] font-medium text-link mt-4 block">{currentUi.readGuide} &rarr;</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Back Link -->
    <div class="mt-12 pt-8 border-t border-hairline text-center">
      <a 
        href={`/${lang}/what-happens/`} 
        class="text-link text-[14px] font-medium hover:text-link-active transition-colors min-h-[44px] inline-flex items-center gap-1.5 active:scale-[0.98] transition-transform py-2.5 px-4 rounded-md hover:bg-surface-soft"
      >
        &larr; {currentUi.backLink}
      </a>
    </div>
  </article>

  <!-- Accessible Copy-Link Toast -->
  <div
    id="copy-toast"
    role="status"
    aria-live="polite"
    class="fixed bottom-5 right-5 z-50 px-4 py-2.5 rounded-lg bg-surface-dark text-on-dark text-xs font-medium shadow-lg border border-hairline/20 opacity-0 translate-y-2 pointer-events-none transition-all duration-200 no-print"
  ></div>

  <script is:inline>
    (function() {
      var toastTimer = null;
      var btnTimer = null;

      function showToast(message) {
        var toast = document.getElementById('copy-toast');
        if (!toast) return;
        toast.textContent = message;
        toast.classList.remove('opacity-0', 'translate-y-2', 'pointer-events-none');
        toast.classList.add('opacity-100', 'translate-y-0');
        if (toastTimer) clearTimeout(toastTimer);
        toastTimer = setTimeout(function() {
          toast.classList.remove('opacity-100', 'translate-y-0');
          toast.classList.add('opacity-0', 'translate-y-2', 'pointer-events-none');
        }, 2500);
      }

      function fallbackCopy(text) {
        var ta = document.createElement('textarea');
        ta.value = text;
        ta.setAttribute('readonly', '');
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        var ok = false;
        try {
          ok = document.execCommand('copy');
        } catch (e) {}
        document.body.removeChild(ta);
        return ok;
      }

      function initGuideActions() {
        var copyBtn = document.getElementById('copy-link-btn');
        var copyBtnText = document.getElementById('copy-link-btn-text');
        if (copyBtn && copyBtnText) {
          copyBtn.onclick = async function() {
            var url = window.location.href;
            var defaultText = copyBtn.getAttribute('data-default-text') || 'Copy Link';
            var copiedText = copyBtn.getAttribute('data-copied-text') || 'Copied';
            var toastText = copyBtn.getAttribute('data-toast-text') || 'Link copied';
            var copied = false;

            if (navigator.clipboard && navigator.clipboard.writeText) {
              try {
                await navigator.clipboard.writeText(url);
                copied = true;
              } catch (e) {
                copied = fallbackCopy(url);
              }
            } else {
              copied = fallbackCopy(url);
            }

            if (copied) {
              copyBtnText.textContent = '✓ ' + copiedText;
              copyBtn.classList.add('bg-success-bg', 'text-success', 'border-success-border/40');
              showToast(toastText);
              if (btnTimer) clearTimeout(btnTimer);
              btnTimer = setTimeout(function() {
                copyBtnText.textContent = defaultText;
                copyBtn.classList.remove('bg-success-bg', 'text-success', 'border-success-border/40');
              }, 2500);
            }
          };
        }

        var printBtn = document.getElementById('print-guide-btn');
        if (printBtn) {
          printBtn.onclick = function() {
            window.print();
          };
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initGuideActions);
      } else {
        initGuideActions();
      }
      document.addEventListener('astro:page-load', initGuideActions);
    })();
  </script>
</Layout>
