    readGuide: "ガイドを読む",
    backLink: "すべての安全シナリオ一覧に戻る"
  },
  'zh-cn': {
    pageTitle: `${data.item} | IsItKitchenSafe`,
    pageDesc: `${data.shortAnswer} 查看即刻后果、紧急应对措施与预防规则，保障厨房安全。`,
    home: "首页",
    whatHappens: "会发生什么",
    guideTag: "厨房事故预防指南",
    badgeDangerous: "危险",
    badgeCaution: "注意",
    badgeSafe: "安全",
    dangerIndicator: "⚠️ 危险等级评估",
    levelSafe: "1级（安全）",
    levelOf: `危险指数 ${dangerValue} / 10`,
    levelCritical: "10级（极度危险）",
    explanationTitle: "这一操作会导致什么后果？",
    detailsHeading: "场景深度安全解析",
    healthTitle: "🩺 健康影响与安全风险",
    actionsTitle: "🚨 紧急自救与应对步骤",
    preventionTitle: "✅ 预防措施与安全规则",
    sourceNotice: "基于美国食品药品监督管理局 (FDA) 与美国农业部 (USDA) 的公开食品安全指引及制造商说明。",
    spottedError: "发现错误？",
    contactUs: "联系我们。",
    faqTitle: "常见问题解答 (FAQ)",
    relatedTitle: "相关厨房事故预防指南",
    readGuide: "阅读指南",
    backLink: "返回所有安全场景列表"
  }
};

const currentUi = ui[lang as keyof typeof ui] || ui.es;
const dangerBadgeText = data.dangerLevel === 'dangerous' ? currentUi.badgeDangerous : data.dangerLevel === 'caution' ? currentUi.badgeCaution : currentUi.badgeSafe;

const howToName = lang === 'es' ? `Cómo prevenir accidentes con ${data.item}`
  : lang === 'pt' ? `Como prevenir acidentes com ${data.item}`
  : lang === 'ja' ? `${data.item}の事故防止と安全対策`
  : `如何预防${data.item}的安全事故`;

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": howToName,
  "description": data.shortAnswer,
  "step": data.prevention?.map((prev: string, idx: number) => ({
    "@type": "HowToStep",
    "position": idx + 1,
    "text": prev
  })) || []
};

// Localized E-E-A-T links & Smart Contextual Consumer Calculator CTA
const isEs = lang === 'es';
const isPt = lang === 'pt';
const isZh = lang === 'zh-cn';
const translatePath = useTranslatedPath(lang);
const methodologyUrl = getDirectoryUrl('methodology', lang);
const contactUrl = getDirectoryUrl('contact', lang);

const scenarioMatchText = `${data.slug} ${appliance} ${data.item || ''}`.toLowerCase();

function getRecommendedScenarioTool(text: string) {
  if (/(bleach|vinegar|ammonia|cleaner|soap)/i.test(text)) {
    return {
      path: '/tools/cleaner-mixing-danger-checker/',
      icon: '🧪',
      title: isEs ? 'Verificador de Peligros al Mezclar Productos de Limpieza' :
             isPt ? 'Verificador de Perigo ao Misturar Produtos de Limpeza' :
             isZh ? '家用清洁剂混用危险排查器' :
             '家庭用洗剤・混ぜるな危険チェッカー',
      description: isEs ? 'Comprueba cualquier par de limpiadores antes de mezclarlos para detectar gases tóxicos de cloro, cloramina o reacciones corrosivas.' :
                   isPt ? 'Verifique dois produtos de limpeza antes de misturar para detectar risco imediato de gás cloro, cloramina ou vapores tóxicos.' :
                   isZh ? '混合清洁剂前先查一查，立即识别氯气、氯胺等剧毒气体与腐蚀性化学反应风险。' :
                   '洗剤を混ぜる前に2つの成分をチェックし、塩素ガス・クロラミンなどの有毒ガス発生リスクを即座に判定します。',
      cta: isEs ? 'Verificar Mezcla' : isPt ? 'Verificar Mistura' : isZh ? '排查清洁剂混用' : '洗剤の危険性を確認'
    };
  }
  if (/(coffee|kettle|descale|espresso)/i.test(text)) {
    return {
      path: '/tools/appliance-descaling-calculator/',
      icon: '☕',
      title: isEs ? 'Calculadora de Descalcificación para Cafeteras y Hervidores' :
             isPt ? 'Calculadora de Descalcificação para Cafeteiras e Chaleiras' :
             isZh ? '咖啡机与电热水壶除垢配比计算器' :
             'コーヒーメーカー・電気ケトル クエン酸除垢計算ツール',
      description: isEs ? 'Calcula proporciones seguras de ácido cítrico o vinagre con agua y los ciclos de enjuague recomendados para tu electrodoméstico.' :
                   isPt ? 'Calcule proporções seguras de ácido cítrico ou vinagre com água e os ciclos de enxágue ideais para seu aparelho.' :
                   isZh ? '根据您的机型计算安全的柠檬酸或白醋除垢稀释比例及标准漂洗次数。' :
                   '機器に合わせた安全なクエン酸・酢の希釈比率と適切なすすぎ回数を簡単に算出できます。',
      cta: isEs ? 'Calcular Proporción' : isPt ? 'Calcular Proporção' : isZh ? '计算除垢比例' : '除垢比率を計算'
    };
  }
  if (/(plastic|styrofoam|tupperware|melamine|pvc)/i.test(text)) {
    return {
      path: '/tools/plastic-code-checker/',
      icon: '♻️',
      title: isEs ? 'Verificador de Códigos de Plástico (#1–#7) y Seguridad Térmica' :
             isPt ? 'Verificador de Códigos de Plástico (#1–#7) e Segurança Térmica' :
             isZh ? '塑料回收编号（#1–#7）耐热与食品安全查询器' :
             'プラスチック識別番号（#1〜#7）耐熱・安全性チェッカー',
      description: isEs ? 'Descifra el número de resina grabado en tus recipientes para verificar si resisten microondas, lavavajillas y congelador.' :
                   isPt ? 'Decifre o número de resina gravado nos potes para saber se são seguros no micro-ondas, lava-louças e freezer.' :
                   isZh ? '快速解读容器底部的塑料树脂编号，确认能否安全用于微波炉、洗碗机与冷冻室。' :
                   '容器底面の樹脂番号から電子レンジ・食洗機・冷凍庫での安全な使用可否を即座に確認できます。',
      cta: isEs ? 'Verificar Código Plástico' : isPt ? 'Verificar Código Plástico' : isZh ? '查询塑料编号' : '樹脂番号を確認'
    };
  }
  if (/(air-?fryer)/i.test(text)) {
    return {
      path: '/tools/air-fryer-oven-converter/',
      icon: '🔥',
      title: isEs ? 'Conversor de Tiempo y Temperatura de Horno a Freidora de Aire' :
             isPt ? 'Conversor de Tempo e Temperatura de Forno para Air Fryer' :
             isZh ? '空气炸锅与烤箱温度时间换算器' :
             'ノンフライヤー・オーブン温度＆時間変換ツール',
      description: isEs ? 'Convierte recetas de horno convencional a freidora de aire con precisión para evitar quemaduras o cocción desigual.' :
                   isPt ? 'Converta receitas de forno convencional para air fryer com segurança, evitando queimar ou cozinhar de forma desigual.' :
                   isZh ? '将传统烤箱食谱精准换算为空气炸锅温度与时长，避免烤焦或内部夹生。' :
                   'オーブンレシピをノンフライヤー用の安全な温度と加熱時間に正確に変換できます。',
      cta: isEs ? 'Convertir Temperatura' : isPt ? 'Converter Temperatura' : isZh ? '换算炸锅温度' : '温度・時間を変換'
    };
  }
  if (/(microwave)/i.test(text)) {
    return {
      path: '/tools/microwave-wattage-converter/',
      icon: '📡',
      title: isEs ? 'Conversor de Potencia (Vatios) y Tiempo de Microondas' :
             isPt ? 'Conversor de Potência (Watts) e Tempo de Micro-ondas' :
             isZh ? '微波炉功率（瓦数）与加热时间换算器' :
             '電子レンジ ワット数・加熱時間変換ツール',
      description: isEs ? 'Ajusta los tiempos de recalentamiento a la potencia real de tu microondas para evitar sobrecalentamiento y salpicaduras por vapor.' :
                   isPt ? 'Ajuste os tempos de aquecimento à potência real do seu micro-ondas para evitar superaquecimento e explosões de vapor.' :
                   isZh ? '按自家微波炉实际瓦数精准换算加热时间，避免食物过热喷溅或容器受损。' :
                   'ご家庭の電子レンジのワット数に合わせて加熱時間を正確に調整し、過加熱や突沸を防ぎます。',
      cta: isEs ? 'Convertir Tiempo' : isPt ? 'Converter Tempo' : isZh ? '换算加热时间' : '加熱時間を変換'
    };
  }
  if (/(power-outage|freezer|freeze|thaw|frozen)/i.test(text)) {
    return {
      path: '/tools/power-outage-food-safety-checker/',
      icon: '⚡',
      title: isEs ? 'Verificador de Seguridad Alimentaria por Corte de Luz y Congelador' :
             isPt ? 'Verificador de Segurança Alimentar para Freezer e Falta de Energia' :
             isZh ? '停电与冷冻室食品安全排查器' :
             '停電・冷凍庫トラブル 食品安全判定チェッカー',
      description: isEs ? 'Consulta las reglas del USDA y CDC para saber si los alimentos refrigerados o congelados pueden conservarse, recongelarse o desecharse.' :
                   isPt ? 'Confira as regras do USDA e CDC para decidir se alimentos refrigerados ou congelados podem ser mantidos, recongelados ou descartados.' :
                   isZh ? '依据 USDA 与 CDC 标准判断冷藏或冷冻食材还能安全保留、复冻烹饪还是必须丢弃。' :
                   'USDA・CDC基準に基づき、冷蔵・冷凍食品を保持・再冷凍・加熱・廃棄すべきか即座に判定できます。',
      cta: isEs ? 'Verificar Seguridad' : isPt ? 'Verificar Segurança' : isZh ? '排查冷冻安全' : '安全性を判定'
    };
  }
  if (/(leftover|fridge|refrigerator|spoil|expired|moldy|left-out-overnight|rice-out-overnight|food-in-oven-overnight|sprouted-potatoes|damaged-can)/i.test(text)) {
    return {
      path: '/tools/leftover-shelf-life-calculator/',
      icon: '🗓️',
      title: isEs ? 'Calculadora USDA de Vida Útil de Sobras y Refrigerador' :
             isPt ? 'Calculadora USDA de Validade de Sobras na Geladeira' :
             isZh ? 'USDA 剩菜与冰箱保质期倒计时计算器' :
             'USDA 残り物・冷蔵保存期限カウントダウン計算ツール',
      description: isEs ? 'Calcula fechas límite exactas del USDA en refrigerador y congelador para mantener tus alimentos fuera de la zona de peligro bacteriano.' :
                   isPt ? 'Calcule as datas limite exatas do USDA na geladeira e no freezer para manter os alimentos fora da zona de perigo.' :
                   isZh ? '快速计算食材在冷藏室与冷冻室的 USDA 官方安全食用截止日，远离细菌危险温区。' :
                   'USDA基準による冷蔵・冷凍の安全な消費期限を算出し、食中毒の危険温度帯を防ぎます。',
      cta: isEs ? 'Calcular Fecha Límite' : isPt ? 'Calcular Validade' : isZh ? '计算安全食用日' : '保存期限を計算'
    };
  }
  if (/(oven|cast-iron|pyrex|non-?stick|pan|glass)/i.test(text)) {
    return {
      path: '/tools/cookware-oven-temp-lookup/',
      icon: '🍳',
      title: isEs ? 'Buscador de Temperatura Máxima de Horno para Utensilios' :
             isPt ? 'Consulta de Temperatura Máxima de Forno para Panelas e Formas' :
             isZh ? '锅具与烤盘烤箱最高耐温查询表' :
             '調理器具・鍋のオーブン耐熱温度検索ツール',
      description: isEs ? 'Verifica límites seguros de horno, grill y tapas para hierro fundido, vidrio Pyrex, antiadherentes y menaje metálico.' :
                   isPt ? 'Consulte os limites seguros de forno, grill e tampas para ferro fundido, vidro Pyrex, antiaderentes e panelas de metal.' :
                   isZh ? '查询铸铁锅、Pyrex 耐热玻璃、不粘锅与金属锅具及锅盖的烤箱与炙烤最高耐受温度。' :
                   '鋳鉄・耐熱ガラス（Pyrex）・フッ素樹脂加工・金属製調理器具のオーブン耐熱上限温度を確認できます。',
      cta: isEs ? 'Consultar Límite Térmico' : isPt ? 'Consultar Limite Térmico' : isZh ? '查询最高耐温' : '耐熱上限を確認'
    };
  }
  return {
    path: '/tools/kitchen-symbol-decoder/',
    icon: '🔍',
    title: isEs ? 'Decodificador de Símbolos de Seguridad en Utensilios de Cocina' :
           isPt ? 'Decodificador de Símbolos de Segurança em Utensílios de Cozinha' :
           isZh ? '厨具与容器安全图标解码器' :
           'キッチン用品・食器の安全マーク解読ツール',
    description: isEs ? 'Identifica los iconos de apto para lavavajillas, microondas, congelador y horno grabados en vajillas y recipientes.' :
                 isPt ? 'Identifique os ícones de lava-louças, micro-ondas, freezer e forno gravados em louças e potes de cozinha.' :
                 isZh ? '快速识别餐具与保鲜盒底部的洗碗机、微波炉、冷冻室及烤箱安全适用标识。' :
                 '食器や保存容器の底に刻印された食洗機・電子レンジ・冷凍・オーブン対応マークの意味を即座に判別できます。',
    cta: isEs ? 'Decodificar Símbolos' : isPt ? 'Decodificar Símbolos' : isZh ? '解码安全图标' : '安全マークを調べる'
  };
}

const recommendedTool = getRecommendedScenarioTool(scenarioMatchText);
const recommendedToolUrl = translatePath(recommendedTool.path);

const uxCopy = {
  badgeVerified: isEs ? '✓ Verificado USDA FSIS / FDA 21 CFR y NSF' :
                 isPt ? '✓ Verificado USDA FSIS / FDA 21 CFR e NSF' :
                 isZh ? '✓ 依据 USDA FSIS / FDA 21 CFR 与 NSF 标准核验' :
                 '✓ USDA FSIS・FDA 21 CFR・NSF 基準検証済み',
  interactiveBadge: isEs ? 'Calculadora de Seguridad Interactiva' :
                    isPt ? 'Calculadora de Segurança Interativa' :
                    isZh ? '互动安全计算工具' :
                    'インタラクティブ安全ツール',
  copyLink: isEs ? 'Copiar Enlace' : isPt ? 'Copiar Link' : isZh ? '复制链接' : 'リンクをコピー',
  copyAria: isEs ? 'Copiar enlace de esta guía de escenario de seguridad' :
            isPt ? 'Copiar link deste guia de cenário de segurança' :
            isZh ? '复制本厨房安全场景指南链接' :
            'このキッチン安全シナリオガイドのリンクをコピー',
  copied: isEs ? 'Enlace Copiado' : isPt ? 'Link Copiado' : isZh ? '链接已复制' : 'コピーしました',
  toastCopied: isEs ? 'Enlace de la guía de seguridad copiado al portapapeles' :
               isPt ? 'Link do guia de segurança copiado para a área de transferência' :
               isZh ? '安全场景指南链接已复制到剪贴板' :
               '安全ガイドのリンクをクリップボードにコピーしました',
  printGuide: isEs ? 'Imprimir Guía' : isPt ? 'Imprimir Guia' : isZh ? '打印指南' : 'ガイドを印刷',
  printAria: isEs ? 'Imprimir esta guía de escenario de seguridad' :
             isPt ? 'Imprimir este guia de cenário de segurança' :
             isZh ? '打印本厨房安全场景指南' :
             'このキッチン安全シナリオガイドを印刷',
  trustHeading: isEs ? 'Verificado según estándares USDA FSIS, FDA 21 CFR y NSF de seguridad en cocina' :
                isPt ? 'Verificado conforme padrões USDA FSIS, FDA 21 CFR e NSF de segurança na cozinha' :
                isZh ? '严格依据 USDA FSIS、FDA 21 CFR 与 NSF 厨房安全规范交叉核验' :
                'USDA FSIS・FDA 21 CFR・NSF キッチン安全基準に基づき検証済み',
  methodologyCta: isEs ? 'Leer Metodología de Verificación' :
                  isPt ? 'Ler Metodologia de Verificação' :
                  isZh ? '查看安全核验方法论' :
                  '安全検証メソドロジーを見る',
  reportCorrection: isEs ? 'Reportar una corrección' :
                    isPt ? 'Relatar uma correção' :
                    isZh ? '反馈纠错或更新' :
                    '修正・更新を報告',
  trustFoot: isEs ? 'Las evaluaciones de peligro, acciones inmediatas y reglas de prevención se cotejan con las directrices USDA FSIS, normativas FDA 21 CFR de contacto con alimentos, estándares NSF y manuales de fabricantes.' :
             isPt ? 'As avaliações de perigo, ações de emergência e regras de prevenção são conferidas com diretrizes USDA FSIS, regulamentos FDA 21 CFR de contato com alimentos, normas NSF e manuais de fabricantes.' :
             isZh ? '本页危险评估、应急处置步骤与预防规则均对照美国农业部 USDA FSIS 指南、FDA 21 CFR 食品接触材料法规、NSF 卫生标准及原厂电器说明书核验。' :
             '危険度評価・緊急対処手順・予防ルールは、米国農務省（USDA FSIS）ガイドライン、FDA 21 CFR 食品接触規制、NSF 衛生基準およびメーカー公式取扱説明書と照合しています。'
};
---

<Layout 
  title={currentUi.pageTitle} 
  description={currentUi.pageDesc} 
  faqs={data.faqs}
  excludeFaqSchema={hasGenericFaq}
  noindex={isNoindex}
  lang={lang}
  availableLocales={availableLocales}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
  </Fragment>

  <article class="max-w-[800px] mx-auto px-6 py-[48px] md:py-[64px]">
    <!-- Breadcrumbs -->
    <Breadcrumbs 
      items={[
        { label: currentUi.home, href: `/${lang}/` },
        { label: currentUi.whatHappens, href: `/${lang}/what-happens/` },
        { label: data.item }
      ]}
    />

    <!-- Header Section -->
    <header class="mb-10 text-center md:text-left">
      <div class="flex flex-wrap items-center justify-center md:justify-start gap-2.5 mb-3">
        <span class="text-caption text-muted uppercase tracking-wider text-xs">{currentUi.guideTag}</span>
        <span class="text-hairline hidden sm:inline">•</span>
        <a
          href={methodologyUrl}
          class="inline-flex items-center gap-1 text-success font-medium bg-success-bg border border-success-border/30 px-2.5 py-0.5 rounded-full text-xs hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link focus-visible:ring-offset-2"
        >
          {uxCopy.badgeVerified}
        </a>
      </div>
      
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-6 leading-tight">
        {pageH1}
      </h1>

      <!-- Safety Verdict Badge -->
      <div class="flex flex-wrap items-center justify-center md:justify-start gap-3">
        {data.dangerLevel === 'safe' && (
          <div class="badge-yes quick-answer px-6 py-2 text-sm">
            <span class="mr-1.5">✓</span> {dangerBadgeText}
          </div>
        )}
        {data.dangerLevel === 'dangerous' && (
          <div class="badge-no quick-answer px-6 py-2 text-sm">
            <span class="mr-1.5">✗</span> {dangerBadgeText}
          </div>
        )}
        {data.dangerLevel === 'caution' && (
          <div class="badge-depends quick-answer px-6 py-2 text-sm">
            <span class="mr-1.5">⚠</span> {dangerBadgeText}
          </div>
        )}
      </div>

      <!-- Quick-Share & Print Action Bar -->
      <div class="mt-5 flex flex-wrap items-center justify-center md:justify-start gap-2.5 no-print">
        <button
          id="copy-link-btn"
          type="button"
          aria-label={uxCopy.copyAria}
          data-default-text={uxCopy.copyLink}
          data-copied-text={uxCopy.copied}
          data-toast-text={uxCopy.toastCopied}
          class="min-h-[40px] px-3.5 py-2 bg-canvas hover:bg-surface-soft active:scale-[0.98] text-ink border border-hairline rounded-md text-xs font-medium inline-flex items-center gap-2 shadow-xs transition-all cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link focus-visible:ring-offset-2"
        >
          <svg class="w-4 h-4 text-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
          </svg>
          <span id="copy-link-btn-text">{uxCopy.copyLink}</span>
        </button>

        <button
          id="print-guide-btn"
          type="button"
          aria-label={uxCopy.printAria}
          class="min-h-[40px] px-3.5 py-2 bg-canvas hover:bg-surface-soft active:scale-[0.98] text-ink border border-hairline rounded-md text-xs font-medium inline-flex items-center gap-2 shadow-xs transition-all cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link focus-visible:ring-offset-2"
        >
          <svg class="w-4 h-4 text-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4H7v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
          </svg>
          <span>{uxCopy.printGuide}</span>
        </button>
      </div>
    </header>

    <!-- Danger Level Meter Box -->
    <section class="mb-12">
      <div class="bg-surface-soft border border-hairline rounded-md p-6">
        <div class="flex justify-between items-center mb-3">
          <h2 class="text-title-sm text-ink font-medium">{currentUi.dangerIndicator}</h2>
          <span class={`font-bold text-[14px] uppercase ${dangerTextColor}`}>
            {dangerBadgeText}
          </span>
        </div>
        
        <!-- Meter Bar -->
        <div class="w-full bg-surface-strong h-4 rounded-full overflow-hidden mb-3">
          <div class={`h-full ${dangerBarColor} ${dangerWidthClass}`}></div>
        </div>
        <div class="flex justify-between text-xs text-muted">
          <span>{currentUi.levelSafe}</span>
          <span>{currentUi.levelOf}</span>
          <span>{currentUi.levelCritical}</span>
        </div>
      </div>
    </section>

    <!-- Detailed Explanation -->
    <section class="mb-12">
      <div class="p-8 rounded-lg bg-surface-soft border border-hairline">
        <h2 class="text-title-sm text-ink font-medium mb-3">{currentUi.explanationTitle}</h2>
        <p class="short-answer text-title-md font-bold leading-relaxed text-ink mb-4">
          {data.shortAnswer}
        </p>
        
        <div>
          <div class="border-t border-hairline my-4 opacity-50"></div>
          <h3 class="text-caption text-muted mb-2 font-semibold uppercase tracking-wider text-xs">{currentUi.detailsHeading}</h3>
          {data.reason?.split('\n\n').map((para: string) => (
            <p class="text-body-md text-body leading-relaxed mb-4">
              {para}
            </p>
          ))}
        </div>
      </div>
    </section>

    <!-- Health Impact Box -->
    <section class="mb-12">
      <div class="bg-error-bg border border-error-bg rounded-md p-6 text-signature-coral">
        <h3 class="text-title-sm font-semibold mb-2">{currentUi.healthTitle}</h3>
        <p class="text-body-md leading-relaxed text-signature-coral">
          {data.healthImpact}
        </p>
      </div>
    </section>

    <!-- Actions and Prevention -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
      <!-- Immediate Actions -->
      <div class="bg-surface-soft rounded-md p-6 border border-hairline/50">
        <h2 class="text-title-sm text-ink font-medium mb-4 flex items-center gap-2">
          {currentUi.actionsTitle}
        </h2>
        <ul class="flex flex-col gap-3">
          {data.actions?.map((act: string) => (
            <li class="text-body-md text-body flex gap-2.5 items-start leading-relaxed">
              <span class="text-signature-coral font-bold mt-0.5">⚠</span>
              <span>{act}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Prevention Tips -->
      <div class="bg-surface-soft rounded-md p-6 border border-hairline/50">
        <h2 class="text-title-sm text-ink font-medium mb-4 flex items-center gap-2">
          {currentUi.preventionTitle}
        </h2>
        <ul class="flex flex-col gap-3">
          {data.prevention?.map((prev: string) => (
            <li class="text-body-md text-body flex gap-2.5 items-start leading-relaxed">
              <span class="text-success font-bold mt-0.5">✓</span>
              <span>{prev}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Smart Contextual Consumer Calculator CTA Card -->
    <section id="recommended-tool-card" class="bg-surface-soft border border-hairline rounded-lg p-5 sm:p-6 shadow-xs mb-8 no-print">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="min-w-0 flex-1">
          <div class="flex flex-wrap items-center gap-2 mb-1.5">
            <span class="text-base" aria-hidden="true">{recommendedTool.icon}</span>
            <span class="text-[11px] font-semibold uppercase tracking-wider text-signature-coral">{uxCopy.interactiveBadge}</span>
          </div>
          <h2 class="text-title-sm text-ink font-semibold mb-1.5 leading-snug">
            {recommendedTool.title}
          </h2>
          <p class="text-[13px] text-body leading-relaxed">
            {recommendedTool.description}
          </p>
        </div>
        <div class="shrink-0">
          <a
            href={recommendedToolUrl}
            class="min-h-[42px] px-4 py-2.5 bg-primary hover:bg-primary-active active:scale-[0.98] text-on-primary rounded-md text-xs font-medium inline-flex items-center gap-1.5 transition-all whitespace-nowrap focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link focus-visible:ring-offset-2"
          >
            <span>{recommendedTool.cta}</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </section>

    <!-- E-E-A-T Verification & Standards Trust Bar -->
    <section id="editorial-trust-bar" class="bg-surface-soft border border-hairline rounded-lg p-5 mb-12 text-xs text-muted leading-relaxed">
      <div class="flex items-start gap-2.5 pb-3 border-b border-hairline">
        <svg class="w-4 h-4 text-success shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
        </svg>
        <div class="min-w-0 flex-1">
          <p class="text-ink font-medium text-[13px] leading-snug">
            {uxCopy.trustHeading}
          </p>
          <div class="mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-[12px]">
            <a href={methodologyUrl} class="text-link hover:underline font-medium">
              {uxCopy.methodologyCta} &rarr;
            </a>
            <span class="text-hairline hidden sm:inline">•</span>
            <a href={contactUrl} class="text-muted hover:text-ink hover:underline">
              {uxCopy.reportCorrection}
            </a>
          </div>
        </div>
      </div>
      <p class="pt-3 text-[12px] text-muted">
        {uxCopy.trustFoot}
      </p>
    </section>

    <!-- FAQ Section -->
    {!hasGenericFaq && data.faqs && data.faqs.length > 0 && (
      <section class="border-t border-hairline pt-12 mb-16">
        <h2 class="text-title-lg text-ink font-medium tracking-tight mb-8">{currentUi.faqTitle}</h2>
        <div class="flex flex-col">
          {data.faqs?.map((faq: any) => (
            <details class="group border-b border-hairline py-5">
              <summary class="flex items-center justify-between text-title-sm text-ink font-medium cursor-pointer list-none [&::-webkit-details-marker]:hidden select-none">
                <span>{faq.question}</span>
                <span class="text-muted group-open:rotate-180 transition-transform duration-200">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </span>
              </summary>
              <div class="mt-4 text-body-md text-body leading-relaxed pl-1">
                {faq.answer}
              </div>
            </details>
          ))}
        </div>
      </section>
    )}

    <!-- Related Items -->
    {relatedItems.length > 0 && (
      <section class="border-t border-hairline pt-12 mb-16">
        <h2 class="text-title-lg text-ink font-medium tracking-tight mb-8">{currentUi.relatedTitle}</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {relatedItems.map((item: any) => (
            <a 
              href={`/${lang}/what-happens/${item.slug}/`} 
              class="bg-canvas border border-hairline hover:border-border-strong rounded-md p-5 flex flex-col justify-between shadow-xs transition-colors active:scale-[0.98]"
            >
              <div>
                <div class="flex items-center justify-between mb-3">
                  <span class="text-[11px] text-muted uppercase tracking-wider">{item.type}</span>
                  <span class="badge-no text-[10px] px-2 py-0.5">{item.dangerLevel}</span>
                </div>
                <h3 class="text-title-sm text-ink mb-1">
                  {item.item}
                </h3>
                <p class="text-[13px] text-muted line-clamp-2 leading-relaxed">
                  {item.shortAnswer}
                </p>
              </div>
              <span class="text-[12px] font-medium text-link mt-4 block">{currentUi.readGuide} &rarr;</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Back Link -->
    <div class="mt-12 pt-8 border-t border-hairline text-center">
      <a 
        href={`/${lang}/what-happens/`} 
        class="text-link text-[14px] font-medium hover:text-link-active transition-colors min-h-[44px] inline-flex items-center gap-1.5 active:scale-[0.98] transition-transform py-2.5 px-4 rounded-md hover:bg-surface-soft"
      >
        &larr; {currentUi.backLink}
      </a>
    </div>
  </article>

  <!-- Accessible Copy-Link Toast -->
  <div
    id="copy-toast"
    role="status"
    aria-live="polite"
    class="fixed bottom-5 right-5 z-50 px-4 py-2.5 rounded-lg bg-surface-dark text-on-dark text-xs font-medium shadow-lg border border-hairline/20 opacity-0 translate-y-2 pointer-events-none transition-all duration-200 no-print"
  ></div>

  <script is:inline>
    (function() {
      var toastTimer = null;
      var btnTimer = null;

      function showToast(message) {
        var toast = document.getElementById('copy-toast');
        if (!toast) return;
        toast.textContent = message;
        toast.classList.remove('opacity-0', 'translate-y-2', 'pointer-events-none');
        toast.classList.add('opacity-100', 'translate-y-0');
        if (toastTimer) clearTimeout(toastTimer);
        toastTimer = setTimeout(function() {
          toast.classList.remove('opacity-100', 'translate-y-0');
          toast.classList.add('opacity-0', 'translate-y-2', 'pointer-events-none');
        }, 2500);
      }

      function fallbackCopy(text) {
        var ta = document.createElement('textarea');
        ta.value = text;
        ta.setAttribute('readonly', '');
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        var ok = false;
        try {
          ok = document.execCommand('copy');
        } catch (e) {}
        document.body.removeChild(ta);
        return ok;
      }

      function initGuideActions() {
        var copyBtn = document.getElementById('copy-link-btn');
        var copyBtnText = document.getElementById('copy-link-btn-text');
        if (copyBtn && copyBtnText) {
          copyBtn.onclick = async function() {
            var url = window.location.href;
            var defaultText = copyBtn.getAttribute('data-default-text') || 'Copy Link';
            var copiedText = copyBtn.getAttribute('data-copied-text') || 'Copied';
            var toastText = copyBtn.getAttribute('data-toast-text') || 'Link copied';
            var copied = false;

            if (navigator.clipboard && navigator.clipboard.writeText) {
              try {
                await navigator.clipboard.writeText(url);
                copied = true;
              } catch (e) {
                copied = fallbackCopy(url);
              }
            } else {
              copied = fallbackCopy(url);
            }

            if (copied) {
              copyBtnText.textContent = '✓ ' + copiedText;
              copyBtn.classList.add('bg-success-bg', 'text-success', 'border-success-border/40');
              showToast(toastText);
              if (btnTimer) clearTimeout(btnTimer);
              btnTimer = setTimeout(function() {
                copyBtnText.textContent = defaultText;
                copyBtn.classList.remove('bg-success-bg', 'text-success', 'border-success-border/40');
              }, 2500);
            }
          };
        }

        var printBtn = document.getElementById('print-guide-btn');
        if (printBtn) {
          printBtn.onclick = function() {
            window.print();
          };
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initGuideActions);
      } else {
        initGuideActions();
      }
      document.addEventListener('astro:page-load', initGuideActions);
    })();
  </script>
</Layout>
