---
import Layout from '../../../layouts/Layout.astro';
import whatHappensEs from '../../../data/what-happens.es.json';
import whatHappensPt from '../../../data/what-happens.pt.json';
import whatHappensJa from '../../../data/what-happens.ja.json';
import whatHappensZh from '../../../data/what-happens.zh-cn.json';
import type { SupportedLanguage } from '../../../i18n/ui';
import { getApplianceUrl, getDirectoryUrl } from '../../../i18n/utils';

export function getStaticPaths() {
  const allLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'ja', 'zh-cn'];
  return [
    {
      params: { lang: 'es' },
      props: {
        lang: 'es' as SupportedLanguage,
        items: whatHappensEs,
        availableLocales: allLocales
      }
    },
    {
      params: { lang: 'pt' },
      props: {
        lang: 'pt' as SupportedLanguage,
        items: whatHappensPt,
        availableLocales: allLocales
      }
    },
    {
      params: { lang: 'ja' },
      props: {
        lang: 'ja' as SupportedLanguage,
        items: whatHappensJa,
        availableLocales: allLocales
      }
    },
    {
      params: { lang: 'zh-cn' },
      props: {
        lang: 'zh-cn' as SupportedLanguage,
        items: whatHappensZh,
        availableLocales: allLocales
      }
    }
  ];
}

interface Props {
  lang: SupportedLanguage;
  items: typeof whatHappensEs;
  availableLocales: SupportedLanguage[];
}

const { lang, items, availableLocales } = Astro.props;

const ui = {
  es: {
    pageTitle: "Qué Pasa Si... Guías de Seguridad y Accidentes en Cocina | ¿Es Seguro en la Cocina?",
