---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import whatHappensEs from '../../../data/what-happens.es.json';
import whatHappensPt from '../../../data/what-happens.pt.json';
import whatHappensJa from '../../../data/what-happens.ja.json';
import whatHappensZh from '../../../data/what-happens.zh-cn.json';
import type { SupportedLanguage } from '../../../i18n/ui';
import { getApplianceUrl, getDirectoryUrl, useTranslatedPath } from '../../../i18n/utils';

export function getStaticPaths() {
  const allLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'ja', 'zh-cn'];
  return [
    {
      params: { lang: 'es' },
      props: {
        lang: 'es' as SupportedLanguage,
        items: whatHappensEs,
        availableLocales: allLocales
      }
    },
    {
      params: { lang: 'pt' },
      props: {
        lang: 'pt' as SupportedLanguage,
        items: whatHappensPt,
        availableLocales: allLocales
      }
    },
    {
      params: { lang: 'ja' },
      props: {
        lang: 'ja' as SupportedLanguage,
        items: whatHappensJa,
        availableLocales: allLocales
      }
    },
    {
      params: { lang: 'zh-cn' },
      props: {
        lang: 'zh-cn' as SupportedLanguage,
        items: whatHappensZh,
        availableLocales: allLocales
      }
    }
  ];
}

interface Props {
  lang: SupportedLanguage;
  items: typeof whatHappensEs;
  availableLocales: SupportedLanguage[];
}

const { lang, items, availableLocales } = Astro.props;

type ApplianceKey = 'microwave' | 'dishwasher' | 'oven' | 'freezer-fridge' | 'stove-cookware' | 'food-chemicals';

function classifyAppliance(slug: string): ApplianceKey {
  if (slug.includes('microwave')) return 'microwave';
  if (slug.includes('dishwasher') || slug.includes('detergent')) return 'dishwasher';
  if (slug.includes('oven')) return 'oven';
  if (slug.includes('freeze') || slug.includes('fridge')) return 'freezer-fridge';
  if (slug.includes('stove') || slug.includes('boil-dry-pot') || slug.includes('hot-pan') || slug.includes('hot-glass')) {
    return 'stove-cookware';
  }
  return 'food-chemicals';
}

