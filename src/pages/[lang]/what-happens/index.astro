    home: "首页",
    whatHappens: "会发生什么",
    heroTitle: "厨房安全指南：会发生什么？",
    heroDesc: "深入了解日常厨房操作失误带来的化学分解、机械爆炸与火灾隐患，保护全家远离意外事故。",
    testedScenarios: `评估场景 (${items.length})`,
    testedSub: "针对潜在厨房危险操作与事故场景的详尽安全分析。",
    searchPlaceholder: "搜索场景（例如：微波炉 铝箔纸）...",
    searchAria: "搜索安全场景",
    badgeDangerous: "危险",
    badgeCaution: "注意",
    badgeSafe: "安全",
    readDetails: "查看场景详情",
    noResults: "没有找到符合您搜索条件的场景。",
    relatedHeading: "相关电器与安全分类指南",
    categories: [
      { name: "洗碗机", slug: "dishwasher", tag: "电器安全指南" },
      { name: "微波炉", slug: "microwave", tag: "电器安全指南" },
      { name: "冷冻室", slug: "freezer", tag: "电器安全指南" },
      { name: "烤箱", slug: "oven", tag: "电器安全指南" },
      { name: "烘干机", slug: "dryer", tag: "电器安全指南" },
      { name: "空气炸锅", slug: "airfryer", tag: "电器安全指南" },
      { name: "冰箱冷藏室", slug: "refrigerator", tag: "电器安全指南" },
      { name: "食品保质期", slug: "how-long", tag: "食物保鲜" },
      { name: "二次冷冻指南", slug: "refreeze", tag: "冷冻安全" },
