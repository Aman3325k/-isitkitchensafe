    heroTitle: "Guías de Seguridad: ¿Qué Pasa Si...?",
    heroDesc: "Comprende las consecuencias químicas, mecánicas y de seguridad de los descuidos y hábitos en la cocina. Protege tu hogar de peligros diarios.",
    testedScenarios: `Escenarios Evaluados (${items.length})`,
    testedSub: "Análisis exhaustivo de seguridad para hábitos y accidentes potenciales en la cocina.",
    searchPlaceholder: "Buscar escenarios (ej. aluminio en microondas)...",
    searchAria: "Buscar escenarios de seguridad",
    badgeDangerous: "PELIGROSO",
