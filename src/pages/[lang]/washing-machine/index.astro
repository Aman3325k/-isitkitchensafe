---
import Layout from '../../../layouts/Layout.astro';
import washingMachineEs from '../../../data/washing-machine.es.json';
import washingMachinePt from '../../../data/washing-machine.pt.json';
import type { SupportedLanguage } from '../../../i18n/ui';

export function getStaticPaths() {
  return [
    {
      params: { lang: 'es' },
      props: {
        lang: 'es' as SupportedLanguage,
        items: washingMachineEs,
        availableLocales: ['en', 'es', 'pt'] as SupportedLanguage[]
      }
    },
    {
      params: { lang: 'pt' },
      props: {
        lang: 'pt' as SupportedLanguage,
        items: washingMachinePt,
        availableLocales: ['en', 'es', 'pt'] as SupportedLanguage[]
      }
    }
  ];
}

interface Props {
  lang: SupportedLanguage;
  items: any[];
  availableLocales: SupportedLanguage[];
}

const { lang, items, availableLocales } = Astro.props;

const isEs = lang === 'es';

const ui = {
  es: {
    pageTitle: "Guías de Seguridad para la Lavadora | ¿Es Seguro en la Cocina?",
    pageDesc: "Explora pautas y compatibilidad para lavar ropa, calzado, textiles del hogar y accesorios en la lavadora sin causar daños.",
    home: "Inicio",
    appliance: "Lavadora",
    heroTitle: "Guías de Seguridad para la Lavadora",
    heroDesc: "Consulta instrucciones de seguridad y ajustes recomendados para prendas diarias, calzado y textiles del hogar. Mantén tu lavadora y tejidos en perfecto estado.",
    testedItems: `Artículos Evaluados (${items.length})`,
    testedSub: "Listado completo de artículos evaluados para lavado a máquina.",
    searchPlaceholder: "Buscar artículos (ej. Zapatillas, Almohada)...",
    searchAria: "Buscar artículos de lavadora",
    badgeYes: "SÍ",
    badgeNo: "NO",
    badgeDepends: "DEPENDE",
    readDetails: "Leer detalles de lavado",
    noResults: "No se encontraron artículos que coincidan con tu búsqueda.",
    relatedHeading: "Categorías Relacionadas de Electrodomésticos",
    guideTag: "Guía de Electrodoméstico",
    exploreGuides: "Explorar Guías",
    appliances: [
      { name: "Lavavajillas", slug: "dishwasher" },
      { name: "Microondas", slug: "microwave" },
      { name: "Congelador", slug: "freezer" },
      { name: "Horno", slug: "oven" },
      { name: "Secadora", slug: "dryer" },
      { name: "Freidora de Aire", slug: "airfryer" },
      { name: "Refrigerador", slug: "refrigerator" },
    ]
  },
  pt: {
    pageTitle: "Guias de Segurança da Máquina de Lavar | É Seguro na Cozinha?",
    pageDesc: "Explore diretrizes e compatibilidade para lavar roupas, calçados, tecidos domésticos e acessórios na máquina sem estragar.",
    home: "Início",
    appliance: "Máquina de Lavar",
    heroTitle: "Guias de Segurança da Máquina de Lavar",
    heroDesc: "Confira instruções de segurança e configurações recomendadas para roupas diárias, calçados e têxteis do lar. Conserve sua máquina e tecidos em perfeito estado.",
    testedItems: `Itens Avaliados (${items.length})`,
    testedSub: "Lista completa de itens avaliados para lavagem na máquina de lavar.",
    searchPlaceholder: "Pesquisar itens (ex. Tênis, Almofada)...",
    searchAria: "Pesquisar itens de máquina de lavar",
    badgeYes: "SIM",
    badgeNo: "NÃO",
    badgeDepends: "DEPENDE",
    readDetails: "Ler detalhes de lavagem",
    noResults: "Nenhum item corresponde à sua pesquisa.",
    relatedHeading: "Categorias Relacionadas de Eletrodomésticos",
    guideTag: "Guia de Eletrodoméstico",
    exploreGuides: "Explorar Guias",
    appliances: [
      { name: "Lava-Louças", slug: "dishwasher" },
      { name: "Micro-ondas", slug: "microwave" },
      { name: "Freezer", slug: "freezer" },
      { name: "Forno", slug: "oven" },
      { name: "Secadora", slug: "dryer" },
      { name: "Fritadeira sem Óleo", slug: "airfryer" },
      { name: "Geladeira", slug: "refrigerator" },
    ]
  }
};

const currentUi = isEs ? ui.es : ui.pt;
---

<Layout 
  title={currentUi.pageTitle} 
  description={currentUi.pageDesc} 
  excludeArticleSchema={true}
  lang={lang}
  availableLocales={availableLocales}
>
  <!-- Hero Section -->
  <section class="bg-signature-coral text-on-primary py-[64px] md:py-[80px]">
    <div class="max-w-[1280px] mx-auto px-6">
      <nav class="flex gap-2 text-[13px] opacity-75 mb-6" aria-label="Breadcrumb">
        <a href={`/${lang}/`} class="hover:underline">{currentUi.home}</a>
        <span>/</span>
        <span class="font-medium">{currentUi.appliance}</span>
      </nav>
      
      <h1 class="text-display-lg font-medium tracking-tight mb-4">
        {currentUi.heroTitle}
      </h1>
      <p class="text-white/80 text-body-md max-w-2xl leading-relaxed">
        {currentUi.heroDesc}
      </p>
    </div>
  </section>

  <!-- Items Grid Section -->
  <section class="max-w-[1280px] mx-auto px-6 py-[96px]">
    <div class="flex flex-col md:flex-row md:items-end justify-between border-b border-hairline pb-8 mb-12">
      <div>
        <h2 class="text-display-md text-ink tracking-tight mb-2">{currentUi.testedItems}</h2>
        <p class="text-body-md text-muted">{currentUi.testedSub}</p>
      </div>
      
      <!-- Filter Input -->
      <div class="mt-6 md:mt-0 flex gap-3 max-w-[320px] w-full">
        <input 
          type="text" 
          id="filter-input"
          placeholder={currentUi.searchPlaceholder}
          aria-label={currentUi.searchAria}
          class="w-full h-11 px-3 py-2 bg-canvas text-ink text-[16px] md:text-[14px] border border-hairline rounded-sm focus:outline-none focus:border-info-border"
        />
      </div>
    </div>

    <!-- Items Grid -->
    <div id="items-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {items.map(item => (
        <div 
          class="item-card bg-canvas border border-hairline rounded-md p-6 flex flex-col justify-between shadow-xs transition-all hover:border-border-strong"
          data-name={item.item.toLowerCase()}
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-caption text-muted uppercase tracking-wider text-xs">{currentUi.appliance}</span>
              {item.safe === 'yes' && <span class="badge-yes">{currentUi.badgeYes}</span>}
              {item.safe === 'no' && <span class="badge-no">{currentUi.badgeNo}</span>}
              {item.safe === 'depends' && <span class="badge-depends">{currentUi.badgeDepends}</span>}
            </div>
            
            <h3 class="text-title-sm text-ink mb-3">
              {isEs ? `¿Se puede meter ${item.item} en la Lavadora?` : `Pode colocar ${item.item} na Máquina de Lavar?`}
            </h3>
            
            <p class="text-body-md text-body leading-relaxed mb-6">
              {item.shortAnswer}
            </p>
          </div>
          
          <a 
            href={`/${lang}/washing-machine/${item.slug}/`} 
            class="text-link text-[14px] font-medium hover:text-link-active transition-colors flex items-center gap-1 group mt-4"
          >
            {currentUi.readDetails} <span class="group-hover:translate-x-0.5 transition-transform">&rarr;</span>
          </a>
        </div>
      ))}
    </div>

    <!-- No results message -->
    <div id="no-results" class="hidden text-center py-12">
      <p class="text-title-md text-muted">{currentUi.noResults}</p>
    </div>
  </section>

  <!-- Related Categories Section -->
  <section class="border-t border-hairline bg-surface-soft/40 py-16">
    <div class="max-w-[1280px] mx-auto px-6">
      <h2 class="text-title-lg text-ink font-medium tracking-tight mb-8">{currentUi.relatedHeading}</h2>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
        {currentUi.appliances.map(app => (
          <a 
            href={`/${lang}/${app.slug}/`} 
            class="p-5 bg-canvas border border-hairline rounded-md hover:border-border-strong shadow-xs text-decoration-none transition-colors active:scale-[0.98] block"
          >
            <span class="text-xs uppercase tracking-wider text-muted font-bold block mb-1">{currentUi.guideTag}</span>
            <h3 class="text-title-sm text-ink mb-1 font-medium">{app.name}</h3>
            <span class="text-xs text-link">{currentUi.exploreGuides} &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Client-side filtering script -->
  <script is:inline>
    const filterInput = document.getElementById('filter-input');
    const itemsGrid = document.getElementById('items-grid');
    const noResults = document.getElementById('no-results');

    if (filterInput && itemsGrid) {
      const cards = itemsGrid.getElementsByClassName('item-card');
      
      filterInput.addEventListener('input', (e) => {
        const query = e.target.value.trim().toLowerCase();
        let matches = 0;
        
        for (let i = 0; i < cards.length; i++) {
          const card = cards[i];
          const name = card.getAttribute('data-name');
          
          if (name && name.includes(query)) {
            card.classList.remove('hidden');
            matches++;
          } else {
            card.classList.add('hidden');
          }
        }
        
        if (matches === 0) {
          noResults.classList.remove('hidden');
        } else {
          noResults.classList.add('hidden');
        }
      });
    }
  </script>
</Layout>
