---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import washingMachineEs from '../../../data/washing-machine.es.json';
import washingMachinePt from '../../../data/washing-machine.pt.json';
import washingMachineZh from '../../../data/washing-machine.zh-cn.json';
import washingMachineJa from '../../../data/washing-machine.ja.json';
import type { SupportedLanguage } from '../../../i18n/ui';

export function getStaticPaths() {
  const availableLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'ja', 'zh-cn'];
  const paths: Array<{
    params: { lang: string; item: string };
    props: { data: any; lang: SupportedLanguage; availableLocales: SupportedLanguage[] };
  }> = [];

  // Spanish washing machine items
  washingMachineEs.forEach((item) => {
    paths.push({
      params: {
        lang: 'es',
        item: item.slug
      },
      props: {
        data: item,
        lang: 'es',
        availableLocales
      }
    });
  });

  // Portuguese washing machine items
  washingMachinePt.forEach((item) => {
    paths.push({
      params: {
        lang: 'pt',
        item: item.slug
      },
      props: {
        data: item,
        lang: 'pt',
        availableLocales
      }
    });
  });

  // Simplified Chinese washing machine items
  washingMachineZh.forEach((item) => {
    paths.push({
      params: {
        lang: 'zh-cn',
        item: item.slug
      },
      props: {
        data: item,
        lang: 'zh-cn',
        availableLocales
      }
    });
  });

  // Japanese washing machine items
  washingMachineJa.forEach((item) => {
    paths.push({
      params: {
        lang: 'ja',
        item: item.slug
      },
      props: {
        data: item,
        lang: 'ja',
        availableLocales
      }
    });
  });

  return paths;
}

interface Props {
  data: any;
  lang: SupportedLanguage;
  availableLocales: SupportedLanguage[];
}

const { data, lang, availableLocales } = Astro.props;

const isEs = lang === 'es';

// Localized UI strings
const uiStrings = {
  es: {
    applianceName: 'Lavadora',
    guideSuffix: 'Guía de la Lavadora',
