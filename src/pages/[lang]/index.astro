---
import HomePageTemplate from '../../components/HomePageTemplate.astro';
import type { SupportedLanguage } from '../../i18n/ui';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'pt' } },
    { params: { lang: 'zh-cn' } },
    { params: { lang: 'ja' } }
  ];
}

const { lang } = Astro.params as { lang: SupportedLanguage };
---

<HomePageTemplate lang={lang} />
