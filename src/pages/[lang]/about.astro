---
import Layout from '../../layouts/Layout.astro';
import type { SupportedLanguage } from '../../i18n/ui';

export function getStaticPaths() {
  const allLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'zh-cn', 'ja'];
  return [
    { params: { lang: 'es' }, props: { lang: 'es' as SupportedLanguage, availableLocales: allLocales } },
    { params: { lang: 'pt' }, props: { lang: 'pt' as SupportedLanguage, availableLocales: allLocales } },
    { params: { lang: 'zh-cn' }, props: { lang: 'zh-cn' as SupportedLanguage, availableLocales: allLocales } },
    { params: { lang: 'ja' }, props: { lang: 'ja' as SupportedLanguage, availableLocales: allLocales } },
  ];
}

interface Props {
  lang: SupportedLanguage;
  availableLocales: SupportedLanguage[];
}

const { lang, availableLocales } = Astro.props;

const contentByLang = {
  ja: {
    title: "運営者情報・情報収集方法 | キッチン安全チェッカー",
    description: "キッチン安全チェッカー（IsItKitchenSafe）の運営理念と、公的機関およびメーカー取扱説明書に基づく情報収集方法についてご紹介します。キッチンの安全を守る独立したリファレンスガイドです。",
    faqs: [
      {
        question: "なぜキッチン安全チェッカーが作られたのですか？",
        answer: "どの調理器具や食品が家電に対応しているかを正確に把握していないことで生じる、偶発的な火災、家電の故障、食器の破損を防ぐためです。公的基準に基づく素早く明確な回答を提供します。"
      },
      {
        question: "「安全」「危険」「条件付き」の各判定は何を意味していますか？",
        answer: "「安全（YES）」はその家電の環境に耐えられる設計であること、「危険（NO）」は危険が生じるか器具や家電が破損すること、「条件付き（DEPENDS）」は上段のみ、食品の重みが必要など特定の条件でのみ安全であることを示します。"
      }
    ],
    h1: "キッチン安全チェッカーについて",
    introLead: "キッチンの安全確認を、シンプルに、素早く、そして確実に。不要な前置きやクリックベイト（釣り記事）は一切排除し、「これを入れても大丈夫？」という疑問に、公的ガイドラインに基づいた明確な答えを即座にお届けします。",
    missionTitle: "私たちのミッション",
    missionP1: "毎年、数多くの家庭で「電子レンジ、食洗機、オーブン、冷凍庫に入れても安全かどうか分からない」という些細な疑問から、偶発的な火災、家電の故障、大切な食器の破損が発生しています。",
    missionP2: "「キッチン安全チェッカー（Is It Kitchen Safe?）」は、忙しい現代の家庭料理人のためのクイックリファレンスとして設立されました。即座に確認できる明確な判定を提供し、家電を守り、食器を長持ちさせ、安心できる住まいをサポートします。",
    methodologyTitle: "情報源とデータ収集方針",
    methodologyP1: "当サイトは個人によって運営される独立したデジタルリファレンスです。独自の実験室テストや科学的主張は行っておらず、すべての内容は公的機関の規制基準、材料科学の基礎文献、およびメーカー公式の取扱説明書から直接収集・整理されています。",
    sourcesTitle: "主な公開情報源",
    source1: "公的規制機関：食品の保存方法、賞味期限、冷凍基準については、米国農務省食品安全検査局（USDA FSIS）および米国食品医薬品局（FDA）の公開ガイドラインと照合しています。",
    source2: "メーカー公式マニュアル：各調理器具・容器の耐熱限界や構造（Pyrex、Corelle、Yeti、Hydro Flaskなど）の公式マニュアルに記載された注意事項を収集・整理しています。",
    criteriaTitle: "材料特性データ",
    criteria1: "材料科学：熱衝撃、マイクロ波照射、食洗機の高圧水流に対する各素材の既知の特性を要約しています。",
    criteria2: "食品接触安全性：高温下でのプラスチックからのBPA溶出規制や強アルカリ洗剤による金属腐食に関するFDA等の公開知見を整理しています。",
    verdictsLead: "当サイトでは、すべてのアイテムを以下の3つの判定基準に分類しています：",
    verdictYesTitle: "安全（YES）",
    verdictYesDesc: "メーカー仕様および既知の素材特性に基づき、物理的損傷や既知のリスクなしに耐えられると判断される場合。",
    verdictNoTitle: "危険（NO）",
    verdictNoDesc: "危険が生じるか、火災、破損、有害物質の放出、または器具や家電の故障を引き起こす可能性がある場合。",
    verdictDependsTitle: "条件付き（DEPENDS）",
    verdictDependsDesc: "特定の条件（食洗機の上段ラック限定、乾燥加熱サイクルの不使用、食品の重みが必要など）でのみ安全とされる場合。",
    disclaimerTitle: "重要な免責事項",
    disclaimerText: "公的な情報源およびメーカーの取扱説明書を基に細心の注意を払って整理しておりますが、製品の素材や仕様はブランドや製造年によって異なる場合があります。当サイトは一般的な参考情報を提供するものであり、疑問がある場合は必ず調理器具の底面にある表示やメーカーの公式マニュアルをご確認ください。"
  },
  'zh-cn': {
    title: "关于我们与信息来源 | 厨房安全指南",
    description: "了解厨房安全指南（IsItKitchenSafe）的初衷与公开指南整理方法，为您提供基于官方规程与原厂手册的厨房电器兼容性速查参考。",
    faqs: [
      {
        question: "创立“厨房安全指南”的初衷是什么？",
        answer: "我们致力于防止因不确定物品是否适用于微波炉、洗碗机、烤箱或冷冻室而导致的意外火灾、餐具损坏和电器故障。通过即时、直接且有据可查的解答，让家庭厨房更安全。"
      },
      {
        question: "“安全”、“危险”和“视情况而定”分别代表什么？",
        answer: "“安全（YES）”表示该物品专为承受相应电器环境而设计；“危险（NO）”表示会产生安全隐患或造成永久损坏；“视情况而定（DEPENDS）”表示仅在特定规则下安全（如仅限顶层架或需配合食物重量）。"
      }
    ],
    h1: "关于厨房安全指南",
    introLead: "让厨房安全验证变得简单、迅速且可靠。没有任何冗长赘述或点击诱饵——只针对您关心的“这件物品可以放进去吗？”提供立竿见影、基于公开权威指南的明确解答。",
    missionTitle: "我们的使命",
    missionP1: "每年，成千上万的家庭因不确定某件器皿或食材是否适用于微波炉、洗碗机、烤箱或冷冻室，从而引发意外起火、电器报废以及高价餐具毁损。",
    missionP2: "“厨房安全指南（Is It Kitchen Safe?）”旨在为家庭烹饪者打造实用的速查手册。我们提供明确的是/否裁定，帮助您保护家用电器、爱护精致餐具，守护居家生活的每一份安全。",
    methodologyTitle: "公开数据来源与整理方法",
    methodologyP1: "本指南由独立发布者维护，旨在为日常烹饪提供速查参考。我们不进行实验室测试，也不提出未经证实的专有学术结论；所有条目均直接汇总自公开的监管指南、材料科学文献与制造商原厂使用说明书。",
    sourcesTitle: "公开信息渠道",
    source1: "官方监管机构：食品保鲜期、保质期及冷冻储存指南均参考美国农业部食品安全检验局（USDA FSIS）与美国食品药品监督管理局（FDA）的公开指南。",
    source2: "制造商原厂手册：整理各大主流品牌官方说明书（例如 Pyrex、Corelle、Yeti、Hydro Flask 等）中注明的耐温极限与注意事项。",
    criteriaTitle: "材料特性说明",
    criteria1: "材料科学机理：总结材料在热应力、微波电磁辐射及洗碗机高压水流环境下的已知耐受表现。",
    criteria2: "食品接触安全性：汇总关于高温环境下塑料 BPA 迁移防护及强碱洗涤剂导致金属腐蚀的公开规范与提示。",
    verdictsLead: "我们对每一种物品与电器的组合划分为以下三种明确状态：",
    verdictYesTitle: "安全（YES）",
    verdictYesDesc: "基于制造商技术规格与材料固有特性，该物品在正常使用下无物理破损或已知安全隐患。",
    verdictNoTitle: "危险（NO）",
    verdictNoDesc: "放入该电器具有破坏性或安全隐患，可能引发火灾、健康损害或造成器皿与电器的永久性损坏。",
    verdictDependsTitle: "视情况而定（DEPENDS）",
    verdictDependsDesc: "仅在满足特定条件时方可安全使用（例如仅限放置于洗碗机顶层架、禁用电热烘干循环，或内部需盛装食物）。",
    disclaimerTitle: "重要免责声明",
    disclaimerText: "尽管我们尽最大努力核对公开官方规范与厂家说明，不同批次和具体型号的厨具材质仍可能存在差异。本站内容仅供一般信息参考；如有任何疑问，请务必优先遵循器皿底部的官方标示或电器原厂说明书。"
  },
  es: {
    title: "Sobre Nosotros y Fuentes | ¿Es Seguro en la Cocina?",
    description: "Conoce la misión y el método de recopilación de pautas públicas de IsItKitchenSafe, tu guía de referencia independiente sobre compatibilidad con electrodomésticos.",
    faqs: [
      {
        question: "¿Por qué se creó ¿Es Seguro en la Cocina? (IsItKitchenSafe)?",
        answer: "Fue creado para prevenir incendios accidentales, electrodomésticos dañados y vajilla rota al proporcionar respuestas rápidas, directas y fundamentadas sobre la seguridad en la cocina."
      },
      {
        question: "¿Qué significan los veredictos SÍ, NO y DEPENDE?",
        answer: "SÍ significa que el artículo está diseñado para resistir el electrodoméstico. NO significa que es peligroso o arruinará el artículo o aparato. DEPENDE significa que es seguro solo bajo reglas específicas (como bandeja superior o con peso de comida)."
      }
    ],
    h1: "Acerca de ¿Es Seguro en la Cocina?",
    introLead: "Hacemos que la seguridad en la cocina sea simple, rápida y confiable. Sin rodeos ni contenido engañoso: solo respuestas inmediatas y basadas en directrices públicas a tus preguntas de '¿Puedo meter esto ahí?'.",
    missionTitle: "Nuestra Misión",
    missionP1: "Cada año, miles de hogares sufren incendios accidentales, electrodomésticos arruinados y vajillas rotas simplemente porque alguien no estaba seguro de si un artículo era seguro para el microondas, lavavajillas, horno o congelador.",
    missionP2: "IsItKitchenSafe se fundó como la guía de referencia rápida para cocineros del hogar. Brindamos veredictos claros de sí/no para proteger tus electrodomésticos, preservar tus utensilios y mantener tu hogar seguro.",
    methodologyTitle: "Fuentes y Metodología de Recopilación",
    methodologyP1: "IsItKitchenSafe es un recurso de referencia digital independiente creado para cocineros del hogar. No realizamos ensayos de laboratorio ni emitimos afirmaciones científicas propias; cada entrada se compila directamente a partir de normativas regulatorias públicas, literatura de ciencia de materiales y manuales oficiales del fabricante.",
    sourcesTitle: "Canales de Información Pública",
    source1: "Pautas Regulatorias: Consultamos directrices públicas del Servicio de Inocuidad e Inspección de los Alimentos del USDA (USDA FSIS) y de la FDA para almacenamiento, temperaturas y conservación de alimentos.",
    source2: "Manuales del Fabricante: Catalogamos tolerancias térmicas e instrucciones publicadas por marcas líderes (Pyrex, Corelle, Yeti, Hydro Flask, etc.).",
    criteriaTitle: "Datos Técnicos de Materiales",
    criteria1: "Ciencia de Materiales: Resumimos las respuestas establecidas de los materiales al choque térmico, la radiación de microondas y el lavado mecánico.",
    criteria2: "Seguridad de Contacto Alimentario: Recopilamos normativas públicas de la FDA sobre límites de temperatura, BPA en plásticos y exposición a detergentes cáusticos.",
    verdictsLead: "Clasificamos cada combinación de artículo y electrodoméstico en tres estados claros:",
    verdictYesTitle: "Seguro (SÍ)",
    verdictYesDesc: "Basado en especificaciones del fabricante y propiedades del material para soportar el ciclo sin daño físico ni riesgos conocidos.",
    verdictNoTitle: "Inseguro (NO)",
    verdictNoDesc: "Peligroso o destructivo. Puede provocar incendios, roturas, liberación de químicos nocivos o arruinar el electrodoméstico.",
    verdictDependsTitle: "Condicional (DEPENDE)",
    verdictDependsDesc: "Seguro únicamente bajo reglas específicas (solo rejilla superior, sin ciclo de calor seco, o con requisitos de peso mínimo de alimentos).",
    disclaimerTitle: "Aviso Importante",
    disclaimerText: "Aunque recopilamos y cotejamos cada guía con fuentes públicas oficiales, los materiales pueden variar según la marca, modelo y año. Este sitio tiene fines informativos; en caso de duda, priorice siempre los símbolos oficiales grabados en el utensilio o su manual del fabricante."
  },
  pt: {
    title: "Sobre Nós e Metodologia | É Seguro na Cozinha?",
    description: "Conheça a missão e a metodologia de compilação de orientações públicas do IsItKitchenSafe, seu guia de referência independente de compatibilidade com eletrodomésticos.",
    faqs: [
      {
        question: "Por que o É Seguro na Cozinha (IsItKitchenSafe) foi criado?",
        answer: "Foi criado para prevenir incêndios acidentais, eletrodomésticos danificados e louças quebradas, oferecendo respostas rápidas, diretas e fundamentadas sobre segurança na cozinha."
      },
      {
        question: "O que significam os veredictos SIM, NÃO e DEPENDE?",
        answer: "SIM significa que o item foi projetado para resistir ao eletrodoméstico. NÃO significa que é perigoso ou danificará o item ou aparelho. DEPENDE significa que é seguro apenas sob regras específicas (como prateleira superior ou com peso de alimentos)."
      }
    ],
    h1: "Sobre o É Seguro na Cozinha",
    introLead: "Tornamos a segurança na cozinha simples, rápida e confiável. Sem enrolação ou clickbait: apenas respostas imediatas e baseadas em diretrizes públicas para suas dúvidas de 'Posso colocar isso aí?'.",
    missionTitle: "Nossa Missão",
    missionP1: "Todos os anos, milhares de lares sofrem incêndios acidentais, eletrodomésticos arruinados e louças quebradas simplesmente porque alguém não tinha certeza se um item era seguro para micro-ondas, lava-louças, forno ou freezer.",
    missionP2: "O IsItKitchenSafe foi fundado como o guia de referência rápida para quem cozinha em casa. Fornecemos veredictos claros de sim/não para proteger seus eletrodomésticos, preservar seus utensílios e manter seu lar seguro.",
    methodologyTitle: "Fontes e Metodologia de Compilação",
    methodologyP1: "O IsItKitchenSafe é uma referência digital independente desenvolvida para quem cozinha em casa. Não realizamos testes de laboratório nem emitimos pareceres científicos proprietários; todas as informações são compiladas diretamente de normas regulatórias públicas, referências de ciência dos materiais e manuais oficiais dos fabricantes.",
    sourcesTitle: "Canais de Informação Pública",
    source1: "Diretrizes Regulatórias: Consultamos orientações públicas do Serviço de Segurança e Inspeção de Alimentos do USDA (USDA FSIS) e da FDA para armazenamento, temperaturas e congelamento de alimentos.",
    source2: "Manuais do Fabricante: Indexamos limites térmicos e recomendações publicadas pelas principais marcas (Pyrex, Corelle, Yeti, Hydro Flask, etc.).",
    criteriaTitle: "Dados Técnicos de Materiais",
    criteria1: "Ciência dos Materiais: Resumimos as respostas comprovadas dos materiais ao choque térmico, à radiação de micro-ondas e à pressão da água em lava-louças.",
    criteria2: "Segurança no Contato com Alimentos: Analisamos diretrizes públicas da FDA sobre liberação de BPA sob aquecimento e resistência a detergentes cáusticos.",
    verdictsLead: "Classificamos cada combinação de item e eletrodoméstico em três status claros:",
    verdictYesTitle: "Seguro (SIM)",
    verdictYesDesc: "Com base nas especificações do fabricante e características do material, o item resiste ao ciclo sem danos físicos nem riscos conhecidos.",
    verdictNoTitle: "Inseguro (NÃO)",
    verdictNoDesc: "Perigoso ou destrutivo. Pode provocar incêndios, quebra, liberação de químicos nocivos ou arruinar o eletrodoméstico.",
    verdictDependsTitle: "Condicional (DEPENDE)",
    verdictDependsDesc: "Seguro apenas sob regras específicas (somente prateleira superior, sem ciclo de secagem com calor, ou com requisitos de peso mínimo de alimento).",
    disclaimerTitle: "Aviso Importante",
    disclaimerText: "Embora nossas análises sejam compiladas a partir de fontes públicas oficiais, materiais e modelos podem mudar ao longo do tempo. Este site tem finalidade exclusivamente informativa; em caso de dúvida, priorize sempre os símbolos gravados na peça ou seu manual oficial."
  }
};

const content = contentByLang[lang as keyof typeof contentByLang] || contentByLang.es;

const siteName = lang === 'ja' ? "キッチン安全チェッカー" : lang === 'zh-cn' ? "厨房安全指南" : lang === 'pt' ? "É Seguro na Cozinha?" : "¿Es Seguro en la Cocina?";

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": siteName,
  "url": `https://isitkitchensafe.com/${lang}/about/`,
  "logo": "https://isitkitchensafe.com/og-image.png",
  "description": content.description,
  "sameAs": []
};
---

<Layout title={content.title} description={content.description} faqs={content.faqs} excludeArticleSchema={true} availableLocales={availableLocales} lang={lang}>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  <section class="max-w-[800px] mx-auto px-6 py-[96px]">
    <h1 class="text-display-lg font-medium text-ink tracking-tight mb-8">{content.h1}</h1>
    
    <div class="prose max-w-none text-body-md text-body leading-relaxed flex flex-col gap-6">
      <p class="text-title-md font-normal leading-relaxed text-ink">
        {content.introLead}
      </p>

      <div class="border-t border-hairline my-6"></div>

      <h2 class="text-title-lg text-ink font-medium tracking-tight">{content.missionTitle}</h2>
      <p>{content.missionP1}</p>
      <p>{content.missionP2}</p>

      <h2 class="text-title-lg text-ink font-medium tracking-tight mt-4">{content.methodologyTitle}</h2>
      <p>{content.methodologyP1}</p>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-4 bg-surface-soft p-6 border border-hairline rounded-md">
        <div>
          <h3 class="text-title-sm font-semibold text-ink mb-2">{content.sourcesTitle}</h3>
          <ul class="list-disc pl-5 flex flex-col gap-1.5 text-[13px] text-body">
            <li>{content.source1}</li>
            <li>{content.source2}</li>
          </ul>
        </div>
        <div>
          <h3 class="text-title-sm font-semibold text-ink mb-2">{content.criteriaTitle}</h3>
          <ul class="list-disc pl-5 flex flex-col gap-1.5 text-[13px] text-body">
            <li>{content.criteria1}</li>
            <li>{content.criteria2}</li>
          </ul>
        </div>
      </div>

      <p>{content.verdictsLead}</p>
      <ul class="list-disc pl-5 flex flex-col gap-2">
        <li>
          <strong class="text-success">{content.verdictYesTitle}:</strong> {content.verdictYesDesc}
        </li>
        <li>
          <strong class="text-signature-coral">{content.verdictNoTitle}:</strong> {content.verdictNoDesc}
        </li>
        <li>
          <strong class="text-signature-mustard">{content.verdictDependsTitle}:</strong> {content.verdictDependsDesc}
        </li>
      </ul>

      <div class="bg-signature-cream/40 border border-signature-cream rounded-md p-6 mt-6">
        <h3 class="text-title-sm text-ink font-medium mb-2">{content.disclaimerTitle}</h3>
        <p class="text-[13px] text-muted leading-relaxed">
          {content.disclaimerText}
        </p>
      </div>
    </div>
  </section>
</Layout>
