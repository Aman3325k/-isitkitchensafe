---
import Layout from '../../layouts/Layout.astro';
import type { SupportedLanguage } from '../../i18n/ui';

export function getStaticPaths() {
  const allLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'zh-cn', 'ja'];
  return [
    { params: { lang: 'es' }, props: { lang: 'es' as SupportedLanguage, availableLocales: allLocales } },
    { params: { lang: 'pt' }, props: { lang: 'pt' as SupportedLanguage, availableLocales: allLocales } },
    { params: { lang: 'zh-cn' }, props: { lang: 'zh-cn' as SupportedLanguage, availableLocales: allLocales } },
    { params: { lang: 'ja' }, props: { lang: 'ja' as SupportedLanguage, availableLocales: allLocales } },
  ];
}

interface Props {
  lang: SupportedLanguage;
  availableLocales: SupportedLanguage[];
}

const { lang, availableLocales } = Astro.props;

const contentByLang = {
  ja: {
    title: "運営者情報・理念 | キッチン安全チェッカー",
    description: "キッチン安全チェッカー（IsItKitchenSafe）の運営理念、検証チーム、科学的検証基準についてご紹介します。キッチンの安全を守る信頼のリファレンスガイドです。",
    faqs: [
      {
        question: "なぜキッチン安全チェッカーが作られたのですか？",
        answer: "どの調理器具や食品が家電に対応しているかを正確に把握していないことで生じる、偶発的な火災、家電の故障、食器の破損を防ぐためです。科学的根拠に基づいた素早く明確な回答を提供します。"
      },
      {
        question: "「安全」「危険」「条件付き」の各判定は何を意味していますか？",
        answer: "「安全（YES）」はその家電の環境に耐えられる設計であること、「危険（NO）」は危険が生じるか器具や家電が破損すること、「条件付き（DEPENDS）」は上段のみ、食品の重みが必要など特定の条件でのみ安全であることを示します。"
      }
    ],
    h1: "キッチン安全チェッカーについて",
    introLead: "キッチンの安全確認を、シンプルに、素早く、そして確実に。不要な前置きやクリックベイト（釣り記事）は一切排除し、「これを入れても大丈夫？」という疑問に、科学的根拠に基づいた明確な答えを即座にお届けします。",
    missionTitle: "私たちのミッション",
    missionP1: "毎年、数多くの家庭で「電子レンジ、食洗機、オーブン、冷凍庫に入れても安全かどうか分からない」という些細な疑問から、偶発的な火災、家電の故障、大切な食器の破損が発生しています。",
    missionP2: "「キッチン安全チェッカー（Is It Kitchen Safe?）」は、忙しい現代の家庭料理人のための究極のクイックリファレンス・マニュアルとして設立されました。即座に確認できる明確な判定を提供し、家電を守り、食器を長持ちさせ、安心できる住まいをサポートします。",
    methodologyTitle: "情報源と編集基準（エディトリアル・ポリシー）",
    methodologyP1: "最も正確で安全なガイドラインを提供するため、当サイトの編集チームは厳格な調査・検証プロトコルを遵守しています。憶測による判断は行わず、すべての推奨事項は公式の規制基準、材料科学の知見、およびメーカーの取扱説明書を総合して作成されています。",
    sourcesTitle: "主要な情報源",
    source1: "公的規制機関：食品の保存方法、賞味期限、冷凍基準については、米国農務省食品安全検査局（USDA FSIS）および米国食品医薬品局（FDA）の公式ガイドラインと照合しています。",
    source2: "メーカー公式マニュアル：各調理器具・容器の耐熱限界や構造（Pyrexの熱衝撃限界、Corelleの強化ガラス構造、YetiやHydro Flaskの真空断熱構造など）を公式説明書から確認しています。",
    criteriaTitle: "科学的検証基準",
    criteria1: "材料科学：各素材が熱ストレス、マイクロ波電磁波、真空密閉、高圧温水ジェットにどのように反応するかを分析します。",
    criteria2: "化学物質の溶出リスク：高温下でのプラスチックからのBPA溶出や、特定洗剤による金属腐食のリスクを評価します。",
    verdictsLead: "当サイトでは、すべてのアイテムを以下の3つの判定基準に分類しています：",
    verdictYesTitle: "安全（YES）",
    verdictYesDesc: "その家電の環境に耐えうる設計となっており、物理的破損、有害物質の発生、安全上のリスクがありません。",
    verdictNoTitle: "危険（NO）",
    verdictNoDesc: "その家電に入れると危険であり、火災や健康被害を引き起こすか、アイテムや家電を永久に破損させます。",
    verdictDependsTitle: "条件付き（DEPENDS）",
    verdictDependsDesc: "特定の条件下（食洗機の上段ラック限定、食品の重みが必要、特定のメーカー耐熱表示がある場合など）でのみ安全です。",
    disclaimerTitle: "重要な免責事項",
    disclaimerText: "当サイトでは細心の注意を払って調査・検証を行っておりますが、製品の素材や仕様はブランドや製造年によって異なる場合があります。ご判断に迷う場合は、必ず調理器具の底面にある表示や家電製品の取扱説明書をご確認ください。"
  },
  'zh-cn': {
    title: "关于我们 | 厨房安全指南",
    description: "了解厨房安全指南（IsItKitchenSafe）的创立宗旨、专业团队以及科学验证方法，为您提供值得信赖的厨房电器兼容性与食品安全指导。",
    faqs: [
      {
        question: "创立“厨房安全指南”的初衷是什么？",
        answer: "我们致力于防止因不确定物品是否适用于微波炉、洗碗机、烤箱或冷冻室而导致的意外火灾、餐具损坏和电器故障。通过即时、严谨且有科学依据的解答，让家庭厨房更安全。"
      },
      {
        question: "“安全”、“危险”和“视情况而定”分别代表什么？",
        answer: "“安全（YES）”表示该物品专为承受相应电器环境而设计；“危险（NO）”表示会产生安全隐患或造成永久损坏；“视情况而定（DEPENDS）”表示仅在特定规则下安全（如仅限顶层架或需配合食物重量）。"
      }
    ],
    h1: "关于厨房安全指南",
    introLead: "让厨房安全验证变得简单、迅速且可靠。没有任何冗长赘述或点击诱饵——只针对您关心的“这件物品可以放进去吗？”提供立竿见影、基于科学研究的权威解答。",
    missionTitle: "我们的使命",
    missionP1: "每年，成千上万的家庭因不确定某件器皿或食材是否适用于微波炉、洗碗机、烤箱或冷冻室，从而引发意外起火、电器报废以及高价餐具毁损。",
    missionP2: "“厨房安全指南（Is It Kitchen Safe?）”旨在为现代家庭烹饪者打造终极速查静态手册。我们提供明确严谨的是/否裁定，帮助您保护家用电器、爱护精致餐具，守护居家生活的每一份安全。",
    methodologyTitle: "权威数据来源与编辑准则",
    methodologyP1: "为确保每一条指南的精准与安全，IsItKitchenSafe 编辑团队恪守严苛的调研与复核流程。我们绝不主观猜测，每一项结论均建立在官方权威标准、材料科学机理以及制造商官方规范的基础之上。",
    sourcesTitle: "核心数据渠道",
    source1: "官方监管机构：所有食品保鲜期、保质期及冷冻储存指南均严格参考美国农业部食品安全检验局（USDA FSIS）与美国食品药品监督管理局（FDA）的权威准则。",
    source2: "制造商原厂手册：直接采集并核验各大品牌官方说明书（例如 Pyrex 硼硅玻璃温差界限、Corelle 夹层玻璃成分、Yeti 与 Hydro Flask 双层真空绝热杯体结构等）。",
    criteriaTitle: "科学测试维度",
    criteria1: "材料科学机理：深度评估材料在热应力、微波电磁辐射、负压密封及洗碗机高压喷淋环境下的耐受表现。",
    criteria2: "化学析出风险：严格排查高温环境下的毒性释放隐患（如塑料微波加热时的 BPA 迁移）及强碱洗涤剂导致的金属氧化腐蚀风险。",
    verdictsLead: "我们对每一种物品与电器的组合划分为以下三种明确状态：",
    verdictYesTitle: "安全（YES）",
    verdictYesDesc: "该物品材质与结构能够安全承受相应电器的工作环境，无物理破损、有害物质释放或安全隐患。",
    verdictNoTitle: "危险（NO）",
    verdictNoDesc: "放入该电器具有高度危险性，极易引发火灾、健康损害，或造成器皿与电器的永久性损坏。",
    verdictDependsTitle: "视情况而定（DEPENDS）",
    verdictDependsDesc: "仅在满足特定条件时方可安全使用（例如仅限放置于洗碗机上层架、内部必须盛装食物以吸收微波，或必须具备官方耐热标示）。",
    disclaimerTitle: "重要免责声明",
    disclaimerText: "尽管我们竭尽全力进行严谨调研，但不同品牌和生产批次的厨具材质可能存在差异。如有疑虑，请务必优先遵循器皿底部的官方标示或电器原厂说明书。"
  },
  es: {
    title: "Sobre Nosotros y Metodología | ¿Es Seguro en la Cocina?",
    description: "Conoce la misión, el equipo editorial y los estándares científicos de IsItKitchenSafe, tu guía confiable de compatibilidad con electrodomésticos y seguridad alimentaria.",
    faqs: [
      {
        question: "¿Por qué se creó ¿Es Seguro en la Cocina? (IsItKitchenSafe)?",
        answer: "Fue creado para prevenir incendios accidentales, electrodomésticos dañados y vajilla rota al proporcionar respuestas rápidas, directas y respaldadas por investigaciones sobre la seguridad en la cocina."
      },
      {
        question: "¿Qué significan los veredictos SÍ, NO y DEPENDE?",
        answer: "SÍ significa que el artículo está diseñado para resistir el electrodoméstico. NO significa que es peligroso o arruinará el artículo o aparato. DEPENDE significa que es seguro solo bajo reglas específicas (como bandeja superior o con peso de comida)."
      }
    ],
    h1: "Acerca de ¿Es Seguro en la Cocina?",
    introLead: "Hacemos que la seguridad en la cocina sea simple, rápida y confiable. Sin rodeos ni contenido engañoso: solo respuestas inmediatas y basadas en la ciencia a tus preguntas de '¿Puedo meter esto ahí?'.",
    missionTitle: "Nuestra Misión",
    missionP1: "Cada año, miles de hogares sufren incendios accidentales, electrodomésticos arruinados y vajillas rotas simplemente porque alguien no estaba seguro de si un artículo era seguro para el microondas, lavavajillas, horno o congelador.",
    missionP2: "IsItKitchenSafe se fundó como la guía de referencia rápida definitiva para cocineros del hogar. Brindamos veredictos claros de sí/no para proteger tus electrodomésticos, preservar tus utensilios y mantener tu hogar seguro.",
    methodologyTitle: "Fuentes y Política Editorial",
    methodologyP1: "Para garantizar directrices precisas y confiables, nuestro equipo editorial sigue rigurosos protocolos de investigación. No hacemos suposiciones; cada recomendación se basa en normas oficiales, principios de ciencia de materiales e instrucciones del fabricante.",
    sourcesTitle: "Principales Fuentes",
    source1: "Organismos Reguladores: Consultamos pautas oficiales del Servicio de Inocuidad e Inspección de los Alimentos del USDA (USDA FSIS) y la FDA para almacenamiento, temperaturas y manipulación de alimentos.",
    source2: "Manuales del Fabricante: Verificamos tolerancias térmicas y límites de diseño en manuales de marcas líderes (Pyrex, Corelle, Yeti, Hydro Flask, etc.).",
    criteriaTitle: "Criterios Científicos de Evaluación",
    criteria1: "Ciencia de Materiales: Analizamos cómo reacciona cada material al choque térmico, la radiación de microondas, el sellado al vacío y chorros de agua a alta presión.",
    criteria2: "Migración Química y Corrosión: Evaluamos riesgos de lixiviación de BPA en plásticos calientes y corrosión galvánica o decoloración en metales expuestos a detergentes cáusticos.",
    verdictsLead: "Clasificamos cada combinación de artículo y electrodoméstico en tres estados claros:",
    verdictYesTitle: "Seguro (SÍ)",
    verdictYesDesc: "Diseñado y probado para soportar el entorno del electrodoméstico sin daños físicos, emisión de toxinas ni riesgo de incendio.",
    verdictNoTitle: "Inseguro (NO)",
    verdictNoDesc: "Peligroso o destructivo. Puede provocar incendios, roturas, liberación de químicos nocivos o arruinar el electrodoméstico.",
    verdictDependsTitle: "Condicional (DEPENDE)",
    verdictDependsDesc: "Seguro únicamente bajo reglas específicas (solo rejilla superior, sin ciclo de calor seco, o con requisitos de peso mínimo de alimentos).",
    disclaimerTitle: "Aviso Importante",
    disclaimerText: "A pesar de nuestras rigurosas investigaciones, las fórmulas de fabricación y especificaciones de marcas pueden cambiar con el tiempo. En caso de duda, prioriza siempre el sello del fabricante en la base del utensilio o su manual oficial."
  },
  pt: {
    title: "Sobre Nós e Metodologia | É Seguro na Cozinha?",
    description: "Conheça a missão, a equipe editorial e os padrões científicos do IsItKitchenSafe, seu guia confiável de compatibilidade com eletrodomésticos e segurança alimentar.",
    faqs: [
      {
        question: "Por que o É Seguro na Cozinha (IsItKitchenSafe) foi criado?",
        answer: "Foi criado para prevenir incêndios acidentais, eletrodomésticos danificados e louças quebradas, oferecendo respostas rápidas, diretas e baseadas em pesquisas sobre segurança na cozinha."
      },
      {
        question: "O que significam os veredictos SIM, NÃO e DEPENDE?",
        answer: "SIM significa que o item foi projetado para resistir ao eletrodoméstico. NÃO significa que é perigoso ou danificará o item ou aparelho. DEPENDE significa que é seguro apenas sob regras específicas (como prateleira superior ou com peso de alimentos)."
      }
    ],
    h1: "Sobre o É Seguro na Cozinha",
    introLead: "Tornamos a segurança na cozinha simples, rápida e confiável. Sem enrolação ou clickbait: apenas respostas imediatas e baseadas na ciência para suas dúvidas de 'Posso colocar isso aí?'.",
    missionTitle: "Nossa Missão",
    missionP1: "Todos os anos, milhares de lares sofrem incêndios acidentais, eletrodomésticos arruinados e louças quebradas simplesmente porque alguém não tinha certeza se um item era seguro para micro-ondas, lava-louças, forno ou freezer.",
    missionP2: "O IsItKitchenSafe foi fundado como o guia de referência rápida definitivo para quem cozinha em casa. Fornecemos veredictos claros de sim/não para proteger seus eletrodomésticos, preservar seus utensílios e manter seu lar seguro.",
    methodologyTitle: "Fontes e Política Editorial",
    methodologyP1: "Para garantir diretrizes precisas e confiáveis, nossa equipe editorial segue rigorosos protocolos de pesquisa. Não fazemos suposições; cada recomendação é baseada em normas oficiais, princípios da ciência dos materiais e manuais do fabricante.",
    sourcesTitle: "Principais Fontes",
    source1: "Órgãos Reguladores: Consultamos diretrizes oficiais do Serviço de Segurança e Inspeção de Alimentos do USDA (USDA FSIS) e da FDA para armazenamento, temperaturas e manuseio de alimentos.",
    source2: "Manuais do Fabricante: Verificamos tolerâncias térmicas e limites de design nos manuais das principais marcas (Pyrex, Corelle, Yeti, Hydro Flask, etc.).",
    criteriaTitle: "Critérios Científicos de Avaliação",
    criteria1: "Ciência dos Materiais: Analisamos como cada material reage ao choque térmico, à radiação de micro-ondas, à vedação a vácuo e a jatos de água em alta pressão.",
    criteria2: "Migração Química e Corrosão: Avaliamos riscos de lixiviação de BPA em plásticos aquecidos e corrosão galvânica ou descoloração em metais expostos a detergentes cáusticos.",
    verdictsLead: "Classificamos cada combinação de item e eletrodoméstico em três status claros:",
    verdictYesTitle: "Seguro (SIM)",
    verdictYesDesc: "Projetado e testado para suportar o ambiente do eletrodoméstico sem danos físicos, emissão de toxinas ou risco de incêndio.",
    verdictNoTitle: "Inseguro (NÃO)",
    verdictNoDesc: "Perigoso ou destrutivo. Pode provocar incêndios, quebra, liberação de químicos nocivos ou arruinar o eletrodoméstico.",
    verdictDependsTitle: "Condicional (DEPENDE)",
    verdictDependsDesc: "Seguro apenas sob regras específicas (somente prateleira superior, sem ciclo de secagem com calor, ou com requisitos de peso mínimo de alimento).",
    disclaimerTitle: "Aviso Importante",
    disclaimerText: "Apesar de nossas rigorosas pesquisas, fórmulas de fabricação e especificações de marcas podem mudar ao longo do tempo. Em caso de dúvida, priorize sempre a marcação do fabricante na base do utensílio ou seu manual oficial."
  }
};

const content = contentByLang[lang as keyof typeof contentByLang] || contentByLang.es;

const siteName = lang === 'ja' ? "キッチン安全チェッカー" : lang === 'zh-cn' ? "厨房安全指南" : lang === 'pt' ? "É Seguro na Cozinha?" : "¿Es Seguro en la Cocina?";

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": siteName,
  "url": `https://isitkitchensafe.com/${lang}/about/`,
  "logo": "https://isitkitchensafe.com/og-image.png",
  "description": content.description,
  "sameAs": []
};
---

<Layout title={content.title} description={content.description} faqs={content.faqs} excludeArticleSchema={true} availableLocales={availableLocales} lang={lang}>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  <section class="max-w-[800px] mx-auto px-6 py-[96px]">
    <h1 class="text-display-lg font-medium text-ink tracking-tight mb-8">{content.h1}</h1>
    
    <div class="prose max-w-none text-body-md text-body leading-relaxed flex flex-col gap-6">
      <p class="text-title-md font-normal leading-relaxed text-ink">
        {content.introLead}
      </p>

      <div class="border-t border-hairline my-6"></div>

      <h2 class="text-title-lg text-ink font-medium tracking-tight">{content.missionTitle}</h2>
      <p>{content.missionP1}</p>
      <p>{content.missionP2}</p>

      <h2 class="text-title-lg text-ink font-medium tracking-tight mt-4">{content.methodologyTitle}</h2>
      <p>{content.methodologyP1}</p>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-4 bg-surface-soft p-6 border border-hairline rounded-md">
        <div>
          <h3 class="text-title-sm font-semibold text-ink mb-2">{content.sourcesTitle}</h3>
          <ul class="list-disc pl-5 flex flex-col gap-1.5 text-[13px] text-body">
            <li>{content.source1}</li>
            <li>{content.source2}</li>
          </ul>
        </div>
        <div>
          <h3 class="text-title-sm font-semibold text-ink mb-2">{content.criteriaTitle}</h3>
          <ul class="list-disc pl-5 flex flex-col gap-1.5 text-[13px] text-body">
            <li>{content.criteria1}</li>
            <li>{content.criteria2}</li>
          </ul>
        </div>
      </div>

      <p>{content.verdictsLead}</p>
      <ul class="list-disc pl-5 flex flex-col gap-2">
        <li>
          <strong class="text-success">{content.verdictYesTitle}:</strong> {content.verdictYesDesc}
        </li>
        <li>
          <strong class="text-signature-coral">{content.verdictNoTitle}:</strong> {content.verdictNoDesc}
        </li>
        <li>
          <strong class="text-signature-mustard">{content.verdictDependsTitle}:</strong> {content.verdictDependsDesc}
        </li>
      </ul>

      <div class="bg-signature-cream/40 border border-signature-cream rounded-md p-6 mt-6">
        <h3 class="text-title-sm text-ink font-medium mb-2">{content.disclaimerTitle}</h3>
        <p class="text-[13px] text-muted leading-relaxed">
          {content.disclaimerText}
        </p>
      </div>
    </div>
  </section>
</Layout>
