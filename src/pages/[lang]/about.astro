    verdictYesBadge: '安全（YES）',
    verdictYesDesc:
      'メーカー仕様および素材特性に基づき、破損・有害溶出・発火などのリスクなく家電環境で使用できると確認された状態。',
    verdictDependsBadge: '条件付き（DEPENDS）',
    verdictDependsDesc:
      '特定の厳格な条件（食洗機の上段ラック限定、加熱乾燥オフ、金属フタを外す、温度上限の遵守など）でのみ安全な状態。',
    verdictNoBadge: '危険（NO）',
    verdictNoDesc:
      '使用不可。火災、火花、熱衝撃による破裂、有害物質の溶出、食中毒、または家電の故障を引き起こす明確なリスクがある状態。',
    utilitiesEyebrow: '無料インタラクティブツール',
    utilitiesHeading: '人気の日常キッチン安全ユーティリティ',
    utilitiesBrowseAll: 'すべての安全ツールを見る →',
    utilitiesOpenLabel: 'ツールを開く →',
    utilities: [
      {
        path: '/tools/kitchen-symbol-decoder/',
        tag: '記号デコーダー',
        title: 'キッチン食器・耐熱記号デコーダー',
        desc: '食器や容器の底面にある食洗機・電子レンジ・オーブン・冷凍・樹脂識別マークの意味を即座に判別。'
      },
      {
        path: '/tools/power-outage-food-safety-checker/',
        tag: '停電時トリアージ',
        title: '停電時の食品安全チェッカー',
        desc: 'USDAの冷蔵4時間・半量冷凍庫24時間・満杯冷凍庫48時間ルールから保存か廃棄かを判定。'
      },
      {
        path: '/tools/moldy-food-safety-checker/',
        tag: 'USDA指針',
        title: 'カビが生えた食品の安全チェッカー',
        desc: '周囲2.5cmを切り落として食べられる硬質食品と、丸ごと廃棄すべき軟質食品を明確に分類。'
      },
      {
        path: '/tools/cleaner-mixing-danger-checker/',
        tag: '化学安全チェック',
        title: '洗剤「混ぜるな危険」チェッカー',
        desc: '塩素系漂白剤・酢・アンモニア・過酸化水素の組み合わせを事前確認し有毒ガス事故を防止。'
      },
      {
        path: '/tools/fridge-organization-zone-planner/',
        tag: '温度帯プランナー',
        title: '冷蔵庫の温度ゾーン収納プランナー',
        desc: '生肉・乳製品・野菜・作り置きの最適な配置を可視化し、交差汚染と鮮度低下を防止。'
      },
      {
        path: '/saved/',
        tag: '印刷用シート',
        title: 'カスタム印刷用・冷蔵庫チートシート',
        desc: 'ご家庭でよく確認する調理器具や食材の判定を保存し、キッチンに貼れる一覧表として印刷。'
      }
    ],
    correctionsTitle: '編集基準と訂正ポリシー',
    correctionsP1:
      '当サイトでは、判定結果に影響する有料掲載、スポンサー付きランキング、商業的対価は一切受け入れておりません。メーカーによる素材変更や取扱説明書の改訂、誤記などにお気づきの際はぜひお知らせください。',
    correctionsP2:
      'ご報告いただいた訂正依頼は、編集部が一次資料と照合したうえで48営業時間以内に更新いたします。',
    contactBoxTitle: '運営・編集部お問い合わせ先',
    pubLabel: '運営媒体：',
    pubValue: 'キッチン安全チェッカー（isitkitchensafe.com）',
    editorialLabel: '編集・訂正のご連絡：',
    supportLabel: '一般お問い合わせ：',
    hqLabel: '編集拠点：',
    hqValue: 'IsItKitchenSafe Research Group, 548 Market St, Suite 29148, San Francisco, CA 94104',
    footerLinkMethodology: '検証方法論の全文を確認する →',
    footerLinkContact: '訂正・新アイテム追加を提案する →',
    disclaimerTitle: '重要な免責事項',
    disclaimerText:
      '公的機関のガイドラインおよびメーカー公式マニュアルを基に細心の注意を払って整理していますが、製品の素材や仕様はブランド・製造時期・型番により異なる場合があります。迷った場合は必ず容器底面の表示やメーカー公式の取扱説明書を優先してください。',
    knowsAbout: [
      'USDA FSIS FoodKeeper 食品保存・安全中心温度ガイドライン',
      'FDA 21 CFR 食品接触材料およびポリマー溶出規制',
      'NSF/ANSI 51・184 食品機器および家庭用食洗機衛生規格',
      'CDC・AAP 乳児栄養と哺乳瓶の安全な加温ガイドライン',
      'FARE・FDA FASTER法 食物アレルゲン交差接触防止',
      'AOCS 食用油の発煙点と熱酸化安定性',
      'ASTM C148 調理用ガラスの熱衝撃基準',
      'EU BfR・EFSA 竹繊維メラミン複合材の溶出注意喚起',
      'EPA 家庭用洗剤の化学反応安全マトリクス',
      'NIST・UL・IEEE IH調理器および電子レンジ安全基準'
    ]
  }
};

const content = contentByLang[lang as keyof typeof contentByLang] || contentByLang.es;
const inLanguageCode = lang === 'zh-cn' ? 'zh-CN' : lang;
const methodologyUrl = getDirectoryUrl('methodology', lang);
const contactUrl = getDirectoryUrl('contact', lang);
const toolsUrl = getDirectoryUrl('tools', lang);

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: content.h1,
  url: `https://isitkitchensafe.com/${lang}/about/`,
  inLanguage: inLanguageCode,
  description: content.description,
  isPartOf: {
    '@type': 'WebSite',
    name: 'IsItKitchenSafe',
    url: 'https://isitkitchensafe.com/'
  },
  mainEntity: {
    '@type': 'Organization',
    name: 'IsItKitchenSafe',
    alternateName: content.siteName,
    url: 'https://isitkitchensafe.com/',
    logo: {
      '@type': 'ImageObject',
      url: 'https://isitkitchensafe.com/favicon.svg'
    },
    publishingPrinciples: `https://isitkitchensafe.com${methodologyUrl}`,
    correctionsPolicy: `https://isitkitchensafe.com/${lang}/about/#corrections-policy`,
    contactPoint: {
      '@type': 'ContactPoint',
      email: 'editorial@isitkitchensafe.com',
      contactType: 'editorial desk',
      availableLanguage: ['English', 'Spanish', 'Portuguese', 'Chinese', 'Japanese']
    },
    knowsAbout: content.knowsAbout
  }
};
---

<Layout
  title={content.title}
  description={content.description}
  excludeArticleSchema={true}
  excludeFaqSchema={true}
  availableLocales={availableLocales}
  lang={lang}
>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(orgSchema)} />

  <article class="max-w-[920px] mx-auto px-6 py-12 md:py-16">
    <Breadcrumbs
      items={[
        { label: t('nav.home'), href: translatePath('/') },
        { label: t('nav.about') }
      ]}
      className="mb-6"
    />

    <!-- Hero Header -->
    <header class="mb-10">
      <span class="text-caption text-signature-coral font-semibold uppercase tracking-wider text-xs block mb-2">
        {content.eyebrow}
      </span>
      <h1 class="text-display-lg font-medium text-ink tracking-tight mb-4">
        {content.h1}
      </h1>
      <p class="text-title-md font-normal leading-relaxed text-body max-w-[780px]">
        {content.introLead}
      </p>
    </header>

    <!-- Verified Live Scale & Trust Metrics Strip -->
    <section aria-labelledby="platform-metrics-heading" class="mb-12">
      <h2 id="platform-metrics-heading" class="sr-only">{content.metricsHeadingSr}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {content.metrics.map((metric) => (
          <div class="bg-surface-soft border border-hairline rounded-lg p-5 flex flex-col gap-1.5">
            <span class="text-[28px] md:text-[32px] font-display font-semibold text-ink leading-none tracking-tight">
              {metric.value}
            </span>
            <h3 class="text-[14px] font-semibold text-ink leading-snug mt-1">
              {metric.label}
            </h3>
            <p class="text-[12.5px] text-muted leading-relaxed">
              {metric.detail}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Editorial Independence, Zero-Paywall & Evidence-First Commitment Cards -->
    <section aria-labelledby="commitments-heading" class="mb-12">
      <div class="mb-5">
        <span class="text-xs font-semibold uppercase tracking-wider text-signature-coral block mb-1">
          {content.commitmentsEyebrow}
        </span>
        <h2 id="commitments-heading" class="text-title-lg text-ink font-medium tracking-tight">
          {content.commitmentsHeading}
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {content.commitments.map((card) => (
          <div class="bg-surface-soft border border-hairline rounded-lg p-5 flex flex-col gap-2">
            <span class="text-[11px] font-mono uppercase tracking-wider text-muted">
              {card.eyebrow}
            </span>
            <h3 class="text-title-sm font-semibold text-ink leading-snug">
              {card.title}
            </h3>
            <p class="text-[13.5px] text-body leading-relaxed">
              {card.body}
            </p>
          </div>
        ))}
      </div>

      <!-- Direct CTA Strip to Methodology & Contact -->
      <div class="mt-5 bg-surface-soft border border-hairline rounded-lg p-5 md:p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="max-w-[560px]">
          <h3 class="text-title-sm font-semibold text-ink mb-1">
            {content.ctaTitle}
          </h3>
          <p class="text-[13.5px] text-body leading-relaxed">
            {content.ctaBody}
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-3 shrink-0">
          <a
            href={methodologyUrl}
            class="btn-primary !py-2.5 !px-4 !text-[14px]"
          >
            {content.ctaMethodology}
          </a>
          <a
            href={contactUrl}
            class="btn-secondary !py-2.5 !px-4 !text-[14px]"
          >
            {content.ctaContact}
          </a>
        </div>
      </div>
    </section>

    <!-- Mission & Purpose -->
    <section aria-labelledby="mission-heading" class="border-t border-hairline pt-10 mb-12 flex flex-col gap-4 text-body-md text-body leading-relaxed">
      <h2 id="mission-heading" class="text-title-lg text-ink font-medium tracking-tight">
        {content.missionTitle}
      </h2>
      <p>{content.missionP1}</p>
      <p>{content.missionP2}</p>
    </section>

    <!-- 4-Stage Research & Verification Process + Verdict Definitions -->
    <section aria-labelledby="verification-process-heading" class="border-t border-hairline pt-10 mb-12">
      <h2 id="verification-process-heading" class="text-title-lg text-ink font-medium tracking-tight mb-3">
        {content.methodologyTitle}
      </h2>
      <p class="text-body-md text-body leading-relaxed mb-5">
        {content.methodologyLeadBeforeLink}
        <a href={methodologyUrl} class="text-link hover:underline font-medium">
          {content.methodologyLinkLabel}
        </a>
        {content.methodologyLeadAfterLink}
      </p>

      <ol class="list-decimal pl-6 flex flex-col gap-3 text-[14px] text-body leading-relaxed mb-6">
        {content.processSteps.map((step) => (
          <li>
            <strong class="text-ink">{step.lead}</strong> {step.body}
          </li>
        ))}
      </ol>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 my-6 bg-surface-soft p-6 border border-hairline rounded-lg">
        <div>
          <h3 class="text-title-sm font-semibold text-ink mb-2">{content.sourcesTitle}</h3>
          <ul class="list-disc pl-5 flex flex-col gap-2 text-[13.5px] text-body leading-relaxed">
            <li>{content.source1}</li>
            <li>{content.source2}</li>
          </ul>
        </div>
        <div>
          <h3 class="text-title-sm font-semibold text-ink mb-2">{content.criteriaTitle}</h3>
          <ul class="list-disc pl-5 flex flex-col gap-2 text-[13.5px] text-body leading-relaxed">
            <li>{content.criteria1}</li>
            <li>{content.criteria2}</li>
          </ul>
        </div>
      </div>

      <h3 class="text-title-md text-ink font-medium tracking-tight mb-4 mt-8">
        {content.verdictsHeading}
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="bg-surface-soft border border-hairline rounded-lg p-5 flex flex-col gap-2.5">
          <div><span class="badge-yes">{content.verdictYesBadge}</span></div>
          <p class="text-[13.5px] text-body leading-relaxed">
            {content.verdictYesDesc}
          </p>
        </div>
        <div class="bg-surface-soft border border-hairline rounded-lg p-5 flex flex-col gap-2.5">
          <div><span class="badge-depends">{content.verdictDependsBadge}</span></div>
          <p class="text-[13.5px] text-body leading-relaxed">
            {content.verdictDependsDesc}
          </p>
        </div>
        <div class="bg-surface-soft border border-hairline rounded-lg p-5 flex flex-col gap-2.5">
          <div><span class="badge-no">{content.verdictNoBadge}</span></div>
          <p class="text-[13.5px] text-body leading-relaxed">
            {content.verdictNoDesc}
          </p>
        </div>
      </div>
    </section>

    <!-- Most Popular Everyday Kitchen Safety Utilities Strip -->
    <section aria-labelledby="popular-utilities-heading" class="border-t border-hairline pt-10 mb-12">
      <div class="flex flex-wrap items-end justify-between gap-3 mb-5">
        <div>
          <span class="text-xs font-semibold uppercase tracking-wider text-signature-coral block mb-1">
            {content.utilitiesEyebrow}
          </span>
          <h2 id="popular-utilities-heading" class="text-title-lg text-ink font-medium tracking-tight">
            {content.utilitiesHeading}
          </h2>
        </div>
        <a href={toolsUrl} class="text-[13.5px] font-medium text-link hover:underline">
          {content.utilitiesBrowseAll}
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {content.utilities.map((tool) => (
          <a
            href={translatePath(tool.path)}
            class="group bg-surface-soft border border-hairline rounded-lg p-5 flex flex-col gap-2 hover:border-border-strong transition-colors"
          >
            <span class="text-[11px] font-mono uppercase tracking-wider text-muted">
              {tool.tag}
            </span>
            <h3 class="text-title-sm font-semibold text-ink group-hover:text-link transition-colors leading-snug">
              {tool.title}
            </h3>
            <p class="text-[13px] text-body leading-relaxed">
              {tool.desc}
            </p>
            <span class="mt-auto pt-2 text-[12.5px] font-medium text-link">
              {content.utilitiesOpenLabel}
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- Editorial Standards, Corrections Policy, Contact & Disclaimer -->
    <section id="corrections-policy" aria-labelledby="corrections-heading" class="border-t border-hairline pt-10 scroll-mt-24">
      <h2 id="corrections-heading" class="text-title-lg text-ink font-medium tracking-tight mb-3">
        {content.correctionsTitle}
      </h2>
      <p class="text-body-md text-body leading-relaxed mb-3">
        {content.correctionsP1}
      </p>
      <p class="text-body-md text-body leading-relaxed mb-6">
        {content.correctionsP2}
      </p>

      <div class="bg-surface-soft border border-hairline rounded-lg p-6 mb-6">
        <h3 class="text-title-sm text-ink font-semibold mb-3">{content.contactBoxTitle}</h3>
        <div class="text-[13.5px] text-body leading-relaxed space-y-1.5">
          <p><strong class="text-ink">{content.pubLabel}</strong> {content.pubValue}</p>
          <p>
            <strong class="text-ink">{content.editorialLabel}</strong>{' '}
            <!--email_off--><a href="mailto:editorial@isitkitchensafe.com" class="text-link hover:underline">editorial@isitkitchensafe.com</a><!--/email_off-->
          </p>
          <p>
            <strong class="text-ink">{content.supportLabel}</strong>{' '}
            <!--email_off--><a href="mailto:support@isitkitchensafe.com" class="text-link hover:underline">support@isitkitchensafe.com</a><!--/email_off-->
          </p>
          <p><strong class="text-ink">{content.hqLabel}</strong> {content.hqValue}</p>
        </div>
        <div class="mt-4 pt-4 border-t border-hairline flex flex-wrap gap-4 text-[13.5px]">
          <a href={methodologyUrl} class="text-link hover:underline font-medium">
            {content.footerLinkMethodology}
          </a>
          <a href={contactUrl} class="text-link hover:underline font-medium">
            {content.footerLinkContact}
          </a>
        </div>
      </div>

      <div class="bg-surface-soft border border-hairline rounded-lg p-5">
        <h3 class="text-title-sm text-ink font-medium mb-2">{content.disclaimerTitle}</h3>
        <p class="text-[13px] text-muted leading-relaxed">
          {content.disclaimerText}
        </p>
      </div>
    </section>
  </article>
</Layout>
