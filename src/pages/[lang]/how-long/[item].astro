---
import Layout from '../../../layouts/Layout.astro';
import howLongEs from '../../../data/how-long.es.json';
import howLongPt from '../../../data/how-long.pt.json';
import howLongZh from '../../../data/how-long.zh-cn.json';
import howLongJa from '../../../data/how-long.ja.json';
import type { SupportedLanguage } from '../../../i18n/ui';

export function getStaticPaths() {
  const paths: Array<{
    params: { lang: string; item: string };
    props: { data: any; lang: SupportedLanguage; availableLocales: SupportedLanguage[] };
  }> = [];

  const allLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'ja', 'zh-cn'];

  howLongEs.forEach((item) => {
    paths.push({
      params: { lang: 'es', item: item.slug },
      props: { data: item, lang: 'es', availableLocales: allLocales }
    });
  });

  howLongPt.forEach((item) => {
    paths.push({
      params: { lang: 'pt', item: item.slug },
      props: { data: item, lang: 'pt', availableLocales: allLocales }
    });
  });

  howLongZh.forEach((item) => {
    paths.push({
      params: { lang: 'zh-cn', item: item.slug },
      props: { data: item, lang: 'zh-cn', availableLocales: allLocales }
    });
  });

  howLongJa.forEach((item) => {
    paths.push({
      params: { lang: 'ja', item: item.slug },
      props: { data: item, lang: 'ja', availableLocales: allLocales }
    });
  });

  return paths;
}

interface Props {
  data: any;
  lang: SupportedLanguage;
  availableLocales: SupportedLanguage[];
}

const { data, lang, availableLocales } = Astro.props;
const isEs = lang === 'es';

function formatLocation(loc: string, currentLang: string) {
  if (currentLang === 'es') {
    if (loc === 'pantry') return 'Despensa';
    if (loc === 'fridge') return 'Refrigerador';
    if (loc === 'freezer') return 'Congelador';
    if (loc === 'counter') return 'Encimera';
    return loc;
  }
  if (currentLang === 'pt') {
    if (loc === 'pantry') return 'Despensa';
    if (loc === 'fridge') return 'Geladeira';
    if (loc === 'freezer') return 'Freezer';
    if (loc === 'counter') return 'Bancada';
    return loc;
  }
  if (currentLang === 'zh-cn') {
    if (loc === 'pantry') return '储物柜';
    if (loc === 'fridge') return '冰箱冷藏室';
    if (loc === 'freezer') return '冰箱冷冻室';
    if (loc === 'counter') return '厨房台面';
    return loc;
  }
  if (currentLang === 'ja') {
    if (loc === 'pantry') return 'パントリー（常温）';
    if (loc === 'fridge') return '冷蔵庫';
    if (loc === 'freezer') return '冷凍庫';
    if (loc === 'counter') return '常温（台所）';
    return loc;
  }
  return loc;
}

const formattedLocation = formatLocation(data.location, lang);
const currentDataset = lang === 'es' ? howLongEs : (lang === 'pt' ? howLongPt : (lang === 'ja' ? howLongJa : howLongZh));

// Find related items within localized dataset
let relatedItems = currentDataset.filter(item => data.relatedItems?.includes(item.slug) && item.slug !== data.slug);
if (relatedItems.length < 5) {
  const sameLocItems = currentDataset.filter(item => item.location === data.location && item.slug !== data.slug && !data.relatedItems?.includes(item.slug));
  const existingSlugs = new Set(relatedItems.map(i => i.slug));
  for (const item of sameLocItems) {
    if (relatedItems.length >= 5) break;
    if (!existingSlugs.has(item.slug)) {
      relatedItems.push(item);
      existingSlugs.add(item.slug);
    }
  }
}
if (relatedItems.length < 5) {
  const anyItems = currentDataset.filter(item => item.slug !== data.slug && !relatedItems.some(ri => ri.slug === item.slug));
  for (const item of anyItems) {
    if (relatedItems.length >= 5) break;
    relatedItems.push(item);
  }
}
relatedItems = relatedItems.slice(0, 5);

const ui: Record<string, any> = {
  es: {
    pageTitle: `¿Cuánto dura ${data.item} en el/la ${formattedLocation}? | ¿Es Seguro en la Cocina?`,
    pageDesc: `${data.shortAnswer} Consulta tiempos de conservación del USDA, signos de descomposición y consejos para ${data.item}.`,
    home: "Inicio",
    shelfLife: "Conservación",
    guideTag: `Guía de ${formattedLocation}`,
    lastUpdated: "Última Actualización: Septiembre 2026",
    usdaBadge: "✓ Basado en pautas del USDA/FDA",
    h1Title: `¿Cuánto dura ${data.item} en ${formattedLocation}?`,
    badgeYes: "SÍ",
    badgeNo: "NO",
    badgeDepends: "DEPENDE",
    lastsBadge: `DURA: ${data.duration}`,
    summaryTitle: "📋 Resumen Rápido de Almacenamiento",
    itemLabel: "Alimento a Almacenar:",
    locationLabel: "Ubicación Recomendada:",
    shelfLifeLabel: "Tiempo Seguro:",
    mainRuleLabel: "Regla Principal:",
    mainRuleValue: "Recipiente Hermético",
    explanationTitle: `¿Se puede guardar ${data.item} en ${formattedLocation}?`,
    detailsHeading: "Detalles y Fundamentos Científicos",
    didYouKnowTitle: "💡 ¿Sabías Que?",
    didYouKnowText: `Las bacterias patógenas se multiplican rápidamente en la "Zona de Peligro" entre 4°C y 60°C (40°F y 140°F). Almacenar ${data.item} adecuadamente en ${formattedLocation} retrasa este proceso drásticamente, ¡manteniendo tu comida segura por más tiempo!`,
    tipsTitle: "✅ Consejos de Almacenamiento",
    spoilageTitle: "🔍 Signos de Descomposición",
    editorialReview: "Revisado por el equipo editorial de IsItKitchenSafe",
    lastReviewed: "Última actualización: Septiembre 2026",
    faqTitle: "Preguntas Frecuentes",
    relatedTitle: "Guías Relacionadas de Conservación",
    readGuide: "Leer guía",
    backLink: "Volver a todas las Guías de Conservación"
  },
  pt: {
    pageTitle: `Quanto tempo dura ${data.item} em ${formattedLocation}? | É Seguro na Cozinha?`,
    pageDesc: `${data.shortAnswer} Confira prazos de validade do USDA, sinais de deterioração e dicas para ${data.item}.`,
    home: "Início",
    shelfLife: "Conservação",
    guideTag: `Guia de ${formattedLocation}`,
    lastUpdated: "Última Atualização: Setembro 2026",
    usdaBadge: "✓ Alinhado às diretrizes do USDA/FDA",
    h1Title: `Quanto tempo dura ${data.item} em ${formattedLocation}?`,
    badgeYes: "SIM",
    badgeNo: "NÃO",
    badgeDepends: "DEPENDE",
    lastsBadge: `DURA: ${data.duration}`,
    summaryTitle: "📋 Resumo Rápido de Conservação",
    itemLabel: "Alimento a Conservar:",
    locationLabel: "Local Recomendado:",
    shelfLifeLabel: "Validade Segura:",
    mainRuleLabel: "Regra Principal:",
    mainRuleValue: "Pote Hermético",
    explanationTitle: `Pode guardar ${data.item} em ${formattedLocation}?`,
    detailsHeading: "Detalhes e Ciência dos Alimentos",
    didYouKnowTitle: "💡 Você Sabia?",
    didYouKnowText: `As bactérias patogênicas multiplicam-se rapidamente na "Zona de Perigo" entre 4°C e 60°C (40°F e 140°F). Armazenar ${data.item} corretamente em ${formattedLocation} desacelera essa proliferação, mantendo seu alimento seguro por muito mais tempo!`,
    tipsTitle: "✅ Melhores Dicas de Armazenamento",
    spoilageTitle: "🔍 Sinais de Deterioração",
    editorialReview: "Revisado pela equipe editorial do IsItKitchenSafe",
    lastReviewed: "Última atualização: Setembro 2026",
    faqTitle: "Perguntas Frecuentes",
    relatedTitle: "Guias Relacionados de Conservação",
    readGuide: "Ver guia",
    backLink: "Voltar a todos os Guias de Conservação"
  },
  'zh-cn': {
    pageTitle: `${data.item}在${formattedLocation}能放多久？ | IsItKitchenSafe 厨房安全`,
    pageDesc: `${data.shortAnswer} 查看权威USDA食品保质期、变质辨别特征与安全储存技巧。`,
    home: "首页",
    shelfLife: "保质期",
    guideTag: `${formattedLocation}储存指南`,
    lastUpdated: "最近更新：2026年9月",
    usdaBadge: "✓ 依据 USDA / FDA 官方食品安全标准",
    h1Title: `${data.item}在${formattedLocation}能放多久？`,
    badgeYes: "可以",
    badgeNo: "不可",
    badgeDepends: "视情况而定",
    lastsBadge: `保质期：${data.duration}`,
    summaryTitle: "📋 储存要点速览",
    itemLabel: "储存食材：",
    locationLabel: "推荐位置：",
    shelfLifeLabel: "安全储存期：",
    mainRuleLabel: "核心原则：",
    mainRuleValue: "密封保鲜容器",
    explanationTitle: `${data.item}可以存放在${formattedLocation}吗？`,
    detailsHeading: "科学原理解析与安全细节",
    didYouKnowTitle: "💡 您知道吗？",
    didYouKnowText: `在4°C至60°C（40°F至140°F）的“危险温度带”内，致病微生物会迅速滋生。将${data.item}妥善储存在${formattedLocation}能大幅延缓细菌繁殖，让食材保持新鲜安全！`,
    tipsTitle: "✅ 最佳储存建议",
    spoilageTitle: "🔍 变质识别要点",
    editorialReview: "由 IsItKitchenSafe 专业编辑团队审核",
    lastReviewed: "最新审核：2026年9月",
    faqTitle: "常见问题解答",
    relatedTitle: "相关食材保质期指南",
    readGuide: "阅读指南",
    backLink: "返回所有保质期指南"
  },
  ja: {
    pageTitle: `${data.item}は${formattedLocation}でどれくらい日持ちする？ | IsItKitchenSafe`,
    pageDesc: `${data.shortAnswer} USDA公式の保存期間、傷みのサイン、安全な保存テクニックを解説。`,
    home: "ホーム",
    shelfLife: "保存期間",
    guideTag: `${formattedLocation}保存ガイド`,
    lastUpdated: "最終更新：2026年9月",
    usdaBadge: "✓ USDA / FDA 公式食品安全基準準拠",
    h1Title: `${data.item}は${formattedLocation}でどれくらい日持ちする？`,
    badgeYes: "可能",
    badgeNo: "不可",
    badgeDepends: "条件付き",
    lastsBadge: `目安：${data.duration}`,
    summaryTitle: "📋 保存ポイントまとめ",
    itemLabel: "対象の食品：",
    locationLabel: "おすすめの保存場所：",
    shelfLifeLabel: "安全な保存期間：",
    mainRuleLabel: "基本ルール：",
    mainRuleValue: "密閉容器で保存",
    explanationTitle: `${data.item}は${formattedLocation}で保存できる？`,
    detailsHeading: "科学的根拠と詳しい解説",
    didYouKnowTitle: "💡 知っていましたか？",
    didYouKnowText: `4°C〜60°C（40°F〜140°F）の「危険温度帯」では食中毒原因菌が急激に増殖します。${data.item}を適切に${formattedLocation}で保管することで菌の繁殖を大幅に抑え、食品を安全に長持ちさせることができます！`,
    tipsTitle: "✅ 正しい保存のコツ",
    spoilageTitle: "🔍 傷んでいるサイン",
    editorialReview: "IsItKitchenSafe 編集チームによる監修",
    lastReviewed: "最終更新：2026年9月",
    faqTitle: "よくある質問",
    relatedTitle: "関連する保存期間ガイド",
    readGuide: "ガイドを見る",
    backLink: "すべての保存期間ガイドに戻る"
  }
};

const currentUi = ui[lang] || ui.es;

const howToName = lang === 'es'
  ? `Cómo almacenar de forma segura ${data.item} en ${formattedLocation}`
  : (lang === 'pt'
    ? `Como conservar com segurança ${data.item} em ${formattedLocation}`
    : (lang === 'ja'
      ? `${data.item}を${formattedLocation}で安全に保存する方法`
      : `如何在${formattedLocation}安全储存${data.item}`));

const howToSchema = (data.safe === 'yes' || data.safe === 'depends') ? {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": howToName,
  "description": data.shortAnswer,
  "step": data.storageTips?.map((tip: string, idx: number) => ({
    "@type": "HowToStep",
    "position": idx + 1,
    "text": tip
  })) || []
} : null;
---

<Layout 
  title={currentUi.pageTitle} 
  description={currentUi.pageDesc} 
  faqs={data.faqs}
  lang={lang}
  availableLocales={availableLocales}
>
  <Fragment slot="head">
    {howToSchema && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
    )}
  </Fragment>

  <article class="max-w-[800px] mx-auto px-6 py-[48px] md:py-[64px]">
    <!-- Breadcrumbs -->
    <nav class="flex gap-2 text-muted text-[13px] mb-8" aria-label="Breadcrumb">
      <a href={`/${lang}/`} class="hover:text-ink transition-colors">{currentUi.home}</a>
      <span>/</span>
      <a href={`/${lang}/how-long/`} class="hover:text-ink transition-colors">{currentUi.shelfLife}</a>
      <span>/</span>
      <span class="text-ink font-medium">{data.item}</span>
    </nav>

    <!-- Header Section -->
    <header class="mb-10 text-center md:text-left">
      <div class="flex flex-wrap items-center justify-center md:justify-start gap-3 mb-3">
        <span class="text-caption text-muted uppercase tracking-wider text-xs">{currentUi.guideTag}</span>
        <span class="text-xs text-muted border-l border-hairline pl-3">{currentUi.lastUpdated}</span>
        <span class="text-xs text-success font-medium bg-success-bg px-2 py-0.5 rounded-sm">{currentUi.usdaBadge}</span>
      </div>
      
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-6 leading-tight">
        {currentUi.h1Title}
      </h1>

      <!-- Safety Verdict Badge & Duration Badge -->
      <div class="flex flex-wrap items-center justify-center md:justify-start gap-3">
        {data.safe === 'yes' && (
          <div class="badge-yes quick-answer px-6 py-2 text-sm">
            <span class="mr-1.5">✓</span> {currentUi.badgeYes}
          </div>
        )}
        {data.safe === 'no' && (
          <div class="badge-no quick-answer px-6 py-2 text-sm">
            <span class="mr-1.5">✗</span> {currentUi.badgeNo}
          </div>
        )}
        {data.safe === 'depends' && (
          <div class="badge-depends quick-answer px-6 py-2 text-sm">
            <span class="mr-1.5">⚠</span> {currentUi.badgeDepends}
          </div>
        )}
        
        <div class="badge-time px-6 py-2 text-sm">
          <span class="mr-1.5">⏱</span> {currentUi.lastsBadge}
        </div>
      </div>
    </header>

    <!-- Quick Summary (Shareable Box) -->
    <section class="mb-12">
      <div class="bg-signature-cream/40 border border-signature-cream rounded-md p-6">
        <h2 class="text-title-sm text-ink font-medium mb-4 flex items-center gap-2">
          {currentUi.summaryTitle}
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 text-[14px]">
          <div>
            <span class="text-muted block mb-1">{currentUi.itemLabel}</span>
            <strong class="text-ink text-[16px]">{data.item}</strong>
          </div>
          <div>
            <span class="text-muted block mb-1">{currentUi.locationLabel}</span>
            <strong class="text-ink text-[16px]">{formattedLocation}</strong>
          </div>
          <div>
            <span class="text-muted block mb-1">{currentUi.shelfLifeLabel}</span>
            <strong class="text-link text-[16px]">{data.duration}</strong>
          </div>
          <div>
            <span class="text-muted block mb-1">{currentUi.mainRuleLabel}</span>
            <strong class="text-success text-[16px]">{currentUi.mainRuleValue}</strong>
          </div>
        </div>
      </div>
    </section>

    <!-- Detailed Explanation -->
    <section class="mb-12">
      <div class="p-8 rounded-lg bg-surface-soft border border-hairline">
        <h2 class="text-title-sm text-ink font-medium mb-3">{currentUi.explanationTitle}</h2>
        <p class="short-answer text-title-md font-bold leading-relaxed text-ink mb-4">
          {data.shortAnswer}
        </p>
        
        <div>
          <div class="border-t border-hairline my-4 opacity-50"></div>
          <h3 class="text-caption text-muted mb-2 font-semibold uppercase tracking-wider text-xs">{currentUi.detailsHeading}</h3>
          {data.reason?.split('\n\n').map((para: string) => (
            <p class="text-body-md text-body leading-relaxed mb-4">
              {para}
            </p>
          ))}
        </div>
      </div>
    </section>

    <!-- Did you know / Fun fact -->
    <section class="mb-12">
      <div class="bg-surface-soft border border-hairline rounded-md p-6">
        <h3 class="text-title-sm text-ink font-medium mb-2">{currentUi.didYouKnowTitle}</h3>
        <p class="text-body-md text-body leading-relaxed">
          {currentUi.didYouKnowText}
        </p>
      </div>
    </section>

    <!-- Storage Tips and Spoilage Signs -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
      <!-- Tips -->
      <div class="bg-surface-soft rounded-md p-6 border border-hairline/50">
        <h2 class="text-title-sm text-ink font-medium mb-4 flex items-center gap-2">
          {currentUi.tipsTitle}
        </h2>
        <ul class="flex flex-col gap-3">
          {data.storageTips?.map((tip: string) => (
            <li class="text-body-md text-body flex gap-2.5 items-start leading-relaxed">
              <span class="text-success font-bold mt-0.5">✓</span>
              <span>{tip}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Spoilage -->
      <div class="bg-surface-soft rounded-md p-6 border border-hairline/50">
        <h2 class="text-title-sm text-ink font-medium mb-4 flex items-center gap-2">
          {currentUi.spoilageTitle}
        </h2>
        <ul class="flex flex-col gap-3">
          {data.spoilageSigns?.map((sign: string) => (
            <li class="text-body-md text-body flex gap-2.5 items-start leading-relaxed">
              <span class="text-signature-coral font-bold mt-0.5">⚠</span>
              <span>{sign}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Editorial Byline Block -->
    <div class="bg-surface-soft border border-hairline rounded-md p-4 mb-12 flex flex-wrap items-center justify-between gap-4 text-xs text-muted">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center justify-center bg-success/10 text-success w-5 h-5 rounded-full font-bold text-[10px]">✓</span>
        <span>{currentUi.editorialReview}</span>
      </div>
      <div>
        <span>{currentUi.lastReviewed}</span>
      </div>
    </div>

    <!-- FAQ Section -->
    <section class="border-t border-hairline pt-12 mb-16">
      <h2 class="text-title-lg text-ink font-medium tracking-tight mb-8">{currentUi.faqTitle}</h2>
      <div class="flex flex-col">
        {data.faqs?.map((faq: any) => (
          <details class="group border-b border-hairline py-5">
            <summary class="flex items-center justify-between text-title-sm text-ink font-medium cursor-pointer list-none [&::-webkit-details-marker]:hidden select-none">
              <span>{faq.question}</span>
              <span class="text-muted group-open:rotate-180 transition-transform duration-200">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </summary>
            <div class="mt-4 text-body-md text-body leading-relaxed pl-1">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- Related Items -->
    {relatedItems.length > 0 && (
      <section class="border-t border-hairline pt-12 mb-16">
        <h2 class="text-title-lg text-ink font-medium tracking-tight mb-8">{currentUi.relatedTitle}</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {relatedItems.map((item: any) => (
            <a 
              href={`/${lang}/how-long/${item.slug}/`} 
              class="bg-canvas border border-hairline hover:border-border-strong rounded-md p-5 flex flex-col justify-between shadow-xs transition-colors active:scale-[0.98]"
            >
              <div>
                <div class="flex items-center justify-between mb-3">
                  <span class="text-[11px] text-muted uppercase tracking-wider">{formatLocation(item.location, lang)}</span>
                  <span class="badge-time text-[10px] px-2 py-0.5">{item.duration}</span>
                </div>
                <h3 class="text-title-sm text-ink mb-1">
                  {item.item}
                </h3>
                <p class="text-[13px] text-muted line-clamp-2 leading-relaxed">
                  {item.shortAnswer}
                </p>
              </div>
              <span class="text-[12px] font-medium text-link mt-4 block">{currentUi.readGuide} &rarr;</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Back Link -->
    <div class="mt-12 pt-8 border-t border-hairline text-center">
      <a 
        href={`/${lang}/how-long/`} 
        class="text-link text-[14px] font-medium hover:text-link-active transition-colors inline-flex items-center gap-1.5 active:scale-[0.98] transition-transform"
      >
        &larr; {currentUi.backLink}
      </a>
    </div>
  </article>
</Layout>
