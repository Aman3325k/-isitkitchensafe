---
import Layout from '../../../layouts/Layout.astro';
import howLongEs from '../../../data/how-long.es.json';
import howLongPt from '../../../data/how-long.pt.json';
import howLongZh from '../../../data/how-long.zh-cn.json';
import howLongJa from '../../../data/how-long.ja.json';
import type { SupportedLanguage } from '../../../i18n/ui';

export function getStaticPaths() {
  const allLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'ja', 'zh-cn'];
  return [
    {
      params: { lang: 'es' },
      props: {
        lang: 'es' as SupportedLanguage,
        items: howLongEs,
        availableLocales: allLocales
      }
    },
    {
      params: { lang: 'pt' },
      props: {
        lang: 'pt' as SupportedLanguage,
        items: howLongPt,
        availableLocales: allLocales
      }
    },
    {
      params: { lang: 'zh-cn' },
      props: {
        lang: 'zh-cn' as SupportedLanguage,
        items: howLongZh,
        availableLocales: allLocales
      }
    },
    {
      params: { lang: 'ja' },
      props: {
        lang: 'ja' as SupportedLanguage,
        items: howLongJa,
        availableLocales: allLocales
      }
    }
  ];
}

interface Props {
  lang: SupportedLanguage;
  items: typeof howLongEs;
  availableLocales: SupportedLanguage[];
}

const { lang, items, availableLocales } = Astro.props;
const isEs = lang === 'es';

function formatLocation(loc: string, currentLang: string) {
  if (currentLang === 'es') {
    if (loc === 'pantry') return 'Despensa';
    if (loc === 'fridge') return 'Refrigerador';
    if (loc === 'freezer') return 'Congelador';
    if (loc === 'counter') return 'Encimera';
    return loc;
  }
  if (currentLang === 'pt') {
    if (loc === 'pantry') return 'Despensa';
    if (loc === 'fridge') return 'Geladeira';
    if (loc === 'freezer') return 'Freezer';
    if (loc === 'counter') return 'Bancada';
    return loc;
  }
  if (currentLang === 'zh-cn') {
    if (loc === 'pantry') return '储物柜';
    if (loc === 'fridge') return '冰箱冷藏室';
    if (loc === 'freezer') return '冰箱冷冻室';
    if (loc === 'counter') return '厨房台面';
    return loc;
  }
  if (currentLang === 'ja') {
    if (loc === 'pantry') return 'パントリー（常温）';
    if (loc === 'fridge') return '冷蔵庫';
    if (loc === 'freezer') return '冷凍庫';
    if (loc === 'counter') return '常温（台所）';
    return loc;
  }
  return loc;
}

