---
import Layout from '../../../layouts/Layout.astro';
import howLongEs from '../../../data/how-long.es.json';
import howLongPt from '../../../data/how-long.pt.json';
import type { SupportedLanguage } from '../../../i18n/ui';

export function getStaticPaths() {
  return [
    {
      params: { lang: 'es' },
      props: {
        lang: 'es' as SupportedLanguage,
        items: howLongEs,
        availableLocales: ['en', 'es', 'pt'] as SupportedLanguage[]
      }
    },
    {
      params: { lang: 'pt' },
      props: {
        lang: 'pt' as SupportedLanguage,
        items: howLongPt,
        availableLocales: ['en', 'es', 'pt'] as SupportedLanguage[]
      }
    }
  ];
}

interface Props {
  lang: SupportedLanguage;
  items: typeof howLongEs;
  availableLocales: SupportedLanguage[];
}

const { lang, items, availableLocales } = Astro.props;
const isEs = lang === 'es';

function formatLocation(loc: string, currentLang: string) {
  if (currentLang === 'es') {
    if (loc === 'pantry') return 'Despensa';
    if (loc === 'fridge') return 'Refrigerador';
    if (loc === 'freezer') return 'Congelador';
    if (loc === 'counter') return 'Encimera';
    return loc;
  }
  if (loc === 'pantry') return 'Despensa';
  if (loc === 'fridge') return 'Geladeira';
  if (loc === 'freezer') return 'Freezer';
  if (loc === 'counter') return 'Bancada';
  return loc;
}

const ui = {
  es: {
    pageTitle: "Guías de Duración y Conservación de Alimentos | ¿Es Seguro en la Cocina?",
    pageDesc: "Descubre cuánto duran los ingredientes, comidas cocinadas y alimentos frescos en la despensa, refrigerador o congelador según las pautas de seguridad alimentaria del USDA.",
    home: "Inicio",
    shelfLife: "Conservación",
    heroTitle: "Guías de Duración de Alimentos",
    heroDesc: "Consulta tiempos seguros de almacenamiento y signos de descomposición para ingredientes y comidas. Tiempos respaldados por pautas del USDA.",
    testedItems: `Alimentos Evaluados (${items.length})`,
    testedSub: "Pautas reales respaldadas por el USDA para almacenamiento diario.",
    searchPlaceholder: "Buscar alimentos (ej. Pollo, Huevos)...",
    searchAria: "Buscar alimentos por tiempo de conservación",
    lastsBadge: "DURA",
    readDetails: "Leer detalles de almacenamiento",
    noResults: "No se encontraron alimentos que coincidan con tu búsqueda.",
    relatedHeading: "Categorías Relacionadas de Electrodomésticos y Seguridad",
    categories: [
      { name: "Lavavajillas", slug: "dishwasher", tag: "Guía de Electrodoméstico" },
      { name: "Microondas", slug: "microwave", tag: "Guía de Electrodoméstico" },
      { name: "Congelador", slug: "freezer", tag: "Guía de Electrodoméstico" },
      { name: "Horno", slug: "oven", tag: "Guía de Electrodoméstico" },
      { name: "Secadora", slug: "dryer", tag: "Guía de Electrodoméstico" },
      { name: "Freidora de Aire", slug: "airfryer", tag: "Guía de Electrodoméstico" },
      { name: "Refrigerador", slug: "refrigerator", tag: "Guía de Electrodoméstico" },
      { name: "Recongelación", slug: "refreeze", tag: "Seguridad del Congelador" },
      { name: "Lavadora", slug: "washing-machine", tag: "Prendas y Ropa" },
      { name: "Qué Pasa Si...", slug: "what-happens", tag: "Accidentes en Cocina" },
    ]
  },
  pt: {
    pageTitle: "Guias de Validade e Conservação de Alimentos | É Seguro na Cozinha?",
    pageDesc: "Descubra quanto tempo ingredientes, refeições cozidas e alimentos frescos duram na despensa, geladeira ou freezer de acordo com as normas de segurança alimentar do USDA.",
    home: "Início",
    shelfLife: "Conservação",
    heroTitle: "Guias de Conservação de Alimentos",
    heroDesc: "Consulte prazos seguros de armazenamento e sinais de deterioração para ingredientes e refeições. Prazos estritamente alinhados ao USDA.",
    testedItems: `Alimentos Avaliados (${items.length})`,
    testedSub: "Diretrizes reais alinhadas ao USDA para conservação no dia a dia.",
    searchPlaceholder: "Pesquisar alimentos (ex. Frango, Ovos)...",
    searchAria: "Pesquisar alimentos por tempo de conservação",
    lastsBadge: "DURA",
    readDetails: "Ver detalhes de conservação",
    noResults: "Nenhum alimento corresponde à sua pesquisa.",
    relatedHeading: "Categorias Relacionadas de Eletrodomésticos e Segurança",
    categories: [
      { name: "Lava-Louças", slug: "dishwasher", tag: "Guia de Eletrodoméstico" },
      { name: "Micro-ondas", slug: "microwave", tag: "Guia de Eletrodoméstico" },
      { name: "Freezer", slug: "freezer", tag: "Guia de Eletrodoméstico" },
      { name: "Forno", slug: "oven", tag: "Guia de Eletrodoméstico" },
      { name: "Secadora", slug: "dryer", tag: "Guia de Eletrodoméstico" },
      { name: "Fritadeira sem Óleo", slug: "airfryer", tag: "Guia de Eletrodoméstico" },
      { name: "Geladeira", slug: "refrigerator", tag: "Guia de Eletrodoméstico" },
      { name: "Recongelamento", slug: "refreeze", tag: "Segurança do Freezer" },
      { name: "Máquina de Lavar", slug: "washing-machine", tag: "Roupas e Tecidos" },
      { name: "O Que Acontece Se...", slug: "what-happens", tag: "Acidentes na Cozinha" },
    ]
  }
};

const currentUi = isEs ? ui.es : ui.pt;
---

<Layout 
  title={currentUi.pageTitle} 
  description={currentUi.pageDesc} 
  excludeArticleSchema={true}
  lang={lang}
  availableLocales={availableLocales}
>
  <!-- Hero Section -->
  <section class="bg-signature-forest text-on-primary py-[64px] md:py-[80px]">
    <div class="max-w-[1280px] mx-auto px-6">
      <nav class="flex gap-2 text-[13px] opacity-75 mb-6" aria-label="Breadcrumb">
        <a href={`/${lang}/`} class="hover:underline">{currentUi.home}</a>
        <span>/</span>
        <span class="font-medium">{currentUi.shelfLife}</span>
      </nav>
      
      <h1 class="text-display-lg font-medium tracking-tight mb-4">
        {currentUi.heroTitle}
      </h1>
      <p class="text-white/80 text-body-md max-w-2xl leading-relaxed">
        {currentUi.heroDesc}
      </p>
    </div>
  </section>

  <!-- Items Grid Section -->
  <section class="max-w-[1280px] mx-auto px-6 py-[96px]">
    <div class="flex flex-col md:flex-row md:items-end justify-between border-b border-hairline pb-8 mb-12">
      <div>
        <h2 class="text-display-md text-ink tracking-tight mb-2">{currentUi.testedItems}</h2>
        <p class="text-body-md text-muted">{currentUi.testedSub}</p>
      </div>
      
      <!-- Filter Input -->
      <div class="mt-6 md:mt-0 flex gap-3 max-w-[320px] w-full">
        <input 
          type="text" 
          id="filter-input"
          placeholder={currentUi.searchPlaceholder}
          aria-label={currentUi.searchAria}
          class="w-full h-11 px-3 py-2 bg-canvas text-ink text-[16px] md:text-[14px] border border-hairline rounded-sm focus:outline-none focus:border-info-border"
        />
      </div>
    </div>

    <!-- Items Grid -->
    <div id="items-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {items.map(item => (
        <div 
          class="item-card bg-canvas border border-hairline rounded-md p-6 flex flex-col justify-between shadow-xs transition-all hover:border-border-strong"
          data-name={item.item.toLowerCase()}
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-caption text-muted uppercase tracking-wider text-xs">{formatLocation(item.location, lang)}</span>
              <span class="badge-time">{currentUi.lastsBadge} {item.duration.toUpperCase()}</span>
            </div>
            
            <h3 class="text-title-sm text-ink mb-3">
              {isEs 
                ? `¿Cuánto dura ${item.item} en ${formatLocation(item.location, 'es')}?` 
                : `Quanto tempo dura ${item.item} em ${formatLocation(item.location, 'pt')}?`}
            </h3>
            
            <p class="text-body-md text-body leading-relaxed mb-6">
              {item.shortAnswer}
            </p>
          </div>
          
          <a 
            href={`/${lang}/how-long/${item.slug}/`} 
            class="text-link text-[14px] font-medium hover:text-link-active transition-colors flex items-center gap-1 group mt-4"
          >
            {currentUi.readDetails} <span class="group-hover:translate-x-0.5 transition-transform">&rarr;</span>
          </a>
        </div>
      ))}
    </div>

    <!-- No results message -->
    <div id="no-results" class="hidden text-center py-12">
      <p class="text-title-md text-muted">{currentUi.noResults}</p>
    </div>
  </section>

  <!-- Related Categories Section -->
  <section class="border-t border-hairline bg-surface-soft/40 py-16">
    <div class="max-w-[1280px] mx-auto px-6">
      <h2 class="text-title-lg text-ink font-medium tracking-tight mb-8">{currentUi.relatedHeading}</h2>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-5 gap-6">
        {currentUi.categories.map(cat => (
          <a 
            href={`/${lang}/${cat.slug}/`} 
            class="p-5 bg-canvas border border-hairline rounded-md hover:border-border-strong shadow-xs text-decoration-none transition-colors active:scale-[0.98] block"
          >
            <span class="text-xs uppercase tracking-wider text-muted font-bold block mb-1">{cat.tag}</span>
            <h3 class="text-title-sm text-ink mb-1 font-medium">{cat.name}</h3>
            <span class="text-xs text-link">&rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Client-side filtering script -->
  <script is:inline>
    const filterInput = document.getElementById('filter-input');
    const itemsGrid = document.getElementById('items-grid');
    const noResults = document.getElementById('no-results');

    if (filterInput && itemsGrid) {
      const cards = itemsGrid.getElementsByClassName('item-card');
      
      filterInput.addEventListener('input', (e) => {
        const query = e.target.value.trim().toLowerCase();
        let matches = 0;
        
        for (let i = 0; i < cards.length; i++) {
          const card = cards[i];
          const name = card.getAttribute('data-name');
          
          if (name && name.includes(query)) {
            card.classList.remove('hidden');
            matches++;
          } else {
            card.classList.add('hidden');
          }
        }
        
        if (matches === 0) {
          noResults.classList.remove('hidden');
        } else {
          noResults.classList.add('hidden');
        }
      });
    }
  </script>
</Layout>
