---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { getCategories, getCategoryItemsAndStats } from '../../../utils/materialCategories';
import type { SupportedLanguage } from '../../../i18n/ui';
import { useTranslatedPath } from '../../../i18n/utils';

export function getStaticPaths() {
  const availableLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'zh-cn', 'ja'];
  return [
    {
      params: { lang: 'es' },
      props: {
        lang: 'es' as SupportedLanguage,
        availableLocales
      }
    },
    {
      params: { lang: 'pt' },
      props: {
        lang: 'pt' as SupportedLanguage,
        availableLocales
      }
    },
    {
      params: { lang: 'zh-cn' },
      props: {
        lang: 'zh-cn' as SupportedLanguage,
        availableLocales
      }
    },
    {
      params: { lang: 'ja' },
      props: {
        lang: 'ja' as SupportedLanguage,
        availableLocales
      }
    }
  ];
}

interface Props {
  lang: SupportedLanguage;
  availableLocales: SupportedLanguage[];
}

const { lang, availableLocales } = Astro.props;

const titles: Record<SupportedLanguage, string> = {
  en: "Kitchen Appliance Safety by Material Type | IsItKitchenSafe",
  es: "Seguridad de Electrodomésticos por Tipo de Material | ¿Es Seguro en la Cocina?",
  pt: "Segurança de Eletrodomésticos por Tipo de Material | É Seguro na Cozinha?",
  'zh-cn': "各类材质厨房电器安全性指南 | 厨房安全指南",
  ja: "素材別の厨房・家電安全性ガイド | キッチン安全チェッカー"
};

const descriptions: Record<SupportedLanguage, string> = {
  en: "Are your kitchen items dishwasher, microwave, oven, or freezer safe? Browse safety guides and statistics by material type: metal, plastic, silicone, glass, and more.",
  es: "¿Son tus artículos de cocina aptos para lavavajillas, microondas, horno o congelador? Consulta guías de seguridad y estadísticas por material: metal, plástico, silicona, vidrio y más.",
  pt: "Seus utensílios de cozinha podem ir à lava-louças, micro-ondas, forno ou freezer? Consulte guias de segurança e estatísticas por material: metal, plástico, silicone, vidro e mais.",
  'zh-cn': "您的厨房用品能否放进洗碗机、微波炉、烤箱或冷冻室？查看金属、塑料、硅胶、玻璃等各类材质的安全指南与测试统计。",
  ja: "お使いのキッチン用品は食洗機、電子レンジ、オーブン、冷凍庫に対応していますか？金属、プラスチック、シリコン、ガラスなど素材別の安全性ガイドをご確認いただけます。"
};

const homeLabels: Record<SupportedLanguage, string> = {
  en: "Home",
  es: "Inicio",
  pt: "Início",
  'zh-cn': "首页",
  ja: "ホーム"
};

const materialLabels: Record<SupportedLanguage, string> = {
  en: "Materials",
  es: "Materiales",
  pt: "Materiais",
  'zh-cn': "材质索引",
  ja: "素材別ガイド"
};

const dirLabels: Record<SupportedLanguage, string> = {
  en: "Material Directories",
  es: "Directorios de Materiales",
  pt: "Diretórios de Materiais",
  'zh-cn': "材质安全索引",
  ja: "素材別ディレクトリ"
};

const h1Titles: Record<SupportedLanguage, string> = {
  en: "Kitchen Appliance Safety by Material Type",
  es: "Seguridad de Electrodomésticos por Tipo de Material",
  pt: "Segurança de Eletrodomésticos por Tipo de Material",
  'zh-cn': "按材质分类的厨房电器安全指南",
  ja: "素材タイプ別の厨房・家電安全性一覧"
};

const heroSubtitles: Record<SupportedLanguage, string> = {
  en: "Select a material category below to access dynamic safety statistics, common appliance risks, and complete safety reference tables for all kitchen items.",
  es: "Selecciona una categoría de material a continuación para ver estadísticas dinámicas de seguridad, riesgos comunes en electrodomésticos y tablas completas de referencia para utensilios de cocina.",
  pt: "Selecione uma categoria de material abaixo para ver estatísticas dinâmicas de segurança, riscos comuns em aparelhos e tabelas completas de referência para utensilios de cozinha.",
  'zh-cn': "请在下方选择材质类别，查看动态安全统计、常见电器使用隐患以及针对各类厨房用品的完整安全参考表。",
  ja: "以下の素材カテゴリを選択すると、安全性の統計データ、家電ごとの主なリスク、および検証済みキッチン用品の一覧表をご確認いただけます。"
};

const itemsCheckedLabels: Record<SupportedLanguage, (count: number) => string> = {
  en: (count) => `${count} Items Checked`,
  es: (count) => `${count} Artículos Verificados`,
  pt: (count) => `${count} Itens Verificados`,
  'zh-cn': (count) => `已验证 ${count} 件物品`,
  ja: (count) => `検証済み ${count} 点`
};

const exploreLabels: Record<SupportedLanguage, string> = {
  en: "Explore guides →",
  es: "Explorar guías →",
  pt: "Explorar guias →",
  'zh-cn': "查看材质指南 →",
  ja: "ガイドを見る →"
};

const investigationBanners: Record<SupportedLanguage, { tag: string; subtitle: string; title: string; desc: string; button: string; toolButton: string }> = {
  en: {
    tag: "Special Investigation",
    subtitle: "Microplastics & PTFE Safety Review",
    title: "Can You Use Scratched Non-Stick Cookware?",
    desc: "Grounded in the landmark 2022 Flinders University Raman spectroscopy research (9,100+ microplastics shed per scratch) and FDA 21 CFR 175.300 standards. Check our 4-grade pan scratch triage scale.",
    button: "Read Full Guide →",
    toolButton: "📷 Scan Pan with AI"
  },
  es: {
    tag: "Investigación Especial",
    subtitle: "Microplásticos y Seguridad del PTFE",
    title: "¿Se Puede Cocinar con Sartenes Antiadherentes Rayadas?",
    desc: "Basado en el estudio de espectroscopía Raman de la Universidad de Flinders 2022 (+9.100 microplásticos por raya) y normas FDA 21 CFR 175.300. Consulta la escala de evaluación en 4 niveles.",
    button: "Leer Guía Completa →",
    toolButton: "📷 Analizar Sartén con IA"
  },
  pt: {
    tag: "Investigação Especial",
    subtitle: "Microplásticos e Segurança do PTFE",
    title: "Pode Usar Panela Antiaderente Arranhada?",
    desc: "Baseado no estudo de espectroscopia Raman da Universidade de Flinders 2022 (+9.100 microplásticos por risco) e normas FDA. Consulte nossa escala de 4 graus de danos.",
    button: "Ler Guia Completo →",
    toolButton: "📷 Testar Panela com IA"
  },
  'zh-cn': {
    tag: "专项深度调查",
    subtitle: "特氟龙微塑料释放与PTFE毒性分析",
    title: "涂层刮花的不粘锅还能继续用吗？",
    desc: "基于2022年澳大利亚弗林德斯大学拉曼光谱实验（单道划痕释放9,100+微塑料）与美国FDA 21 CFR 175.300标准，提供4级损伤自查判定指南。",
    button: "阅读完整深度报告 →",
    toolButton: "📷 AI 锅具损伤检测"
  },
  ja: {
    tag: "特別調査レポート",
    subtitle: "マイクロプラスチック・PTFE安全性検証",
    title: "傷のついたフッ素樹脂加工フライパンは使っても大丈夫？",
    desc: "2022年豪フリンダース大学のラマン分光分析（傷1本から9,100個以上の微粒子溶出）と米国FDA基準に基づく、4段階の劣化診断・買い替え判断ガイド。",
    button: "詳細レポートを読む →",
    toolButton: "📷 AI フライパン診断"
  }
};

const toolsSpotlights: Record<SupportedLanguage, {
  tag: string;
  title: string;
  desc: string;
  ovenToolLabel: string;
  plasticToolLabel: string;
  browseTitle: (count: number) => string;
  browseSub: string;
  searchPlaceholder: string;
  searchAria: string;
  clearAria: string;
  countTemplate: string;
  noResults: string;
  resetLabel: string;
}> = {
  en: {
    tag: "Interactive Material Tools",
    title: "Checking oven limits or plastic numbers?",
    desc: "Instantly look up max oven temperatures for cookware brands and coatings, or decode recycling resin numbers (#1–#7) for microwave and dishwasher safety.",
    ovenToolLabel: "Cookware Oven Temp Lookup",
    plasticToolLabel: "Plastic Code Checker (#1–#7)",
    browseTitle: (count) => `Browse Material Categories (${count})`,
    browseSub: "Filter categories by material name, sub-material, or kitchen risk.",
    searchPlaceholder: "Search materials (e.g. silicone, cast iron, bamboo, glass)...",
    searchAria: "Search material categories",
    clearAria: "Clear search",
    countTemplate: "Showing {count} of {total} material categories",
    noResults: "No material categories match your search.",
    resetLabel: "Reset search"
  },
  es: {
    tag: "Herramientas Interactivas de Materiales",
    title: "¿Buscas límites de horno o códigos de plástico?",
    desc: "Consulta al instante las temperaturas máximas de horno para marcas y recubrimientos de menaje, o descifra los códigos de reciclaje (#1–#7) para microondas y lavavajillas.",
    ovenToolLabel: "Buscador de Temp. de Horno",
    plasticToolLabel: "Verificador de Plásticos (#1–#7)",
    browseTitle: (count) => `Explorar Categorías de Materiales (${count})`,
    browseSub: "Filtra categorías por material, submaterial o riesgo en electrodomésticos.",
    searchPlaceholder: "Buscar materiales (ej. silicona, hierro fundido, bambú, vidrio)...",
    searchAria: "Buscar categorías de materiales",
    clearAria: "Borrar búsqueda",
    countTemplate: "Mostrando {count} de {total} categorías de materiales",
    noResults: "Ninguna categoría de material coincide con tu búsqueda.",
    resetLabel: "Restablecer búsqueda"
  },
  pt: {
    tag: "Ferramentas Interativas de Materiais",
    title: "Verificando limites de forno ou números de plástico?",
    desc: "Consulte na hora as temperaturas máximas de forno para marcas e revestimentos de panelas, ou decodifique códigos de resina plástica (#1–#7) para micro-ondas e lava-louças.",
    ovenToolLabel: "Consulta de Temp. de Forno",
    plasticToolLabel: "Verificador de Plástico (#1–#7)",
    browseTitle: (count) => `Explorar Categorias de Materiais (${count})`,
    browseSub: "Filtre categorias por nome do material, submaterial ou risco na cozinha.",
    searchPlaceholder: "Pesquisar materiais (ex. silicone, ferro fundido, bambu, vidro)...",
    searchAria: "Pesquisar categorias de materiais",
    clearAria: "Limpar pesquisa",
    countTemplate: "Mostrando {count} de {total} categorias de materiais",
    noResults: "Nenhuma categoria de material corresponde à sua pesquisa.",
    resetLabel: "Redefinir pesquisa"
  },
  'zh-cn': {
    tag: "交互式材质检测工具",
    title: "正在查询烤箱耐温上限或塑料编号？",
    desc: "一键查询各类锅具品牌与涂层的烤箱最高安全温度，或解读 #1–#7 塑料回收编号在微波炉与洗碗机中的安全性。",
    ovenToolLabel: "锅具烤箱耐温查询",
    plasticToolLabel: "塑料编号安全查询 (#1–#7)",
    browseTitle: (count) => `浏览材质分类 (${count})`,
    browseSub: "按材质名称、细分材料或厨房电器隐患实时筛选。",
    searchPlaceholder: "搜索材质（例如：硅胶、铸铁、竹木、高硼硅玻璃）...",
    searchAria: "搜索材质分类",
    clearAria: "清除搜索",
    countTemplate: "显示 {count} / {total} 个材质分类",
    noResults: "没有找到符合您搜索条件的材质分类。",
    resetLabel: "重置搜索"
  },
  ja: {
    tag: "インタラクティブ素材ツール",
    title: "オーブン耐熱温度やプラスチック番号をお探しですか？",
    desc: "調理器具ブランド・コーティングごとのオーブン上限温度を即座に検索したり、プラスチック識別番号（#1〜#7）のレンジ・食洗機適性を判定できます。",
    ovenToolLabel: "調理器具オーブン耐熱検索",
    plasticToolLabel: "プラスチック番号チェッカー (#1–#7)",
    browseTitle: (count) => `素材カテゴリ一覧 (${count})`,
    browseSub: "素材名・材質・家電リスクでカテゴリをリアルタイム絞り込み。",
    searchPlaceholder: "素材を検索（例：シリコン、鋳鉄、竹、ガラス）...",
    searchAria: "素材カテゴリを検索",
    clearAria: "検索をクリア",
    countTemplate: "{total} 件中 {count} 件の素材カテゴリを表示中",
    noResults: "検索条件に一致する素材カテゴリは見つかりませんでした。",
    resetLabel: "検索をリセット"
  }
};

const tp = useTranslatedPath(lang);
const banner = investigationBanners[lang] || investigationBanners.en;
const toolsUi = toolsSpotlights[lang] || toolsSpotlights.en;

const pageTitle = titles[lang] || titles.en;
const pageDescription = descriptions[lang] || descriptions.en;

const categories = getCategories(lang);

const categoriesWithStats = categories.map(cat => {
  const stats = getCategoryItemsAndStats(cat.id, lang);
  return {
    ...cat,
    itemCount: stats ? stats.totalItemsTested : 0
  };
});
---

<Layout title={pageTitle} description={pageDescription} availableLocales={availableLocales} lang={lang}>
  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs 
        items={[
          { label: homeLabels[lang] || homeLabels.en, href: `/${lang}/` },
          { label: materialLabels[lang] || materialLabels.en }
        ]}
        className="mb-0"
      />
    </div>
  </div>

  <section class="max-w-[1280px] mx-auto px-6 py-[80px] md:py-[96px]">
    <!-- Header -->
    <header class="max-w-[800px] mb-12">
      <span class="text-caption text-muted uppercase tracking-wider text-xs block mb-2">
        {dirLabels[lang] || dirLabels.en}
      </span>
      <h1 class="text-display-lg md:text-display-xl font-medium text-ink tracking-tight mb-4">
        {h1Titles[lang] || h1Titles.en}
      </h1>
      <p class="text-body-md text-muted text-lg leading-relaxed">
        {heroSubtitles[lang] || heroSubtitles.en}
      </p>
    </header>

    <!-- Interactive Tools Spotlight Strip -->
    <div class="mb-8 rounded-lg border border-hairline bg-surface-soft/80 p-5 md:p-6 flex flex-col lg:flex-row lg:items-center justify-between gap-5 shadow-xs">
      <div class="flex items-start gap-4 max-w-[680px]">
        <div class="w-10 h-10 rounded-md bg-signature-teal text-white flex items-center justify-center shrink-0 mt-0.5" aria-hidden="true">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23-.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5" />
          </svg>
        </div>
        <div>
          <span class="inline-block text-[11px] font-bold uppercase tracking-wider text-info mb-1">{toolsUi.tag}</span>
          <h2 class="text-title-sm font-semibold text-ink mb-1">{toolsUi.title}</h2>
          <p class="text-body-md text-muted leading-relaxed">
            {toolsUi.desc}
          </p>
        </div>
      </div>
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5 shrink-0">
        <a
          href={tp('/tools/cookware-oven-temp-lookup/')}
          class="inline-flex items-center justify-center gap-1.5 px-4 py-2.5 min-h-[44px] bg-primary text-on-primary text-[13px] font-medium rounded-lg hover:bg-primary-active transition-colors whitespace-nowrap"
        >
          <span>{toolsUi.ovenToolLabel}</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
        <a
          href={tp('/tools/plastic-code-checker/')}
          class="inline-flex items-center justify-center gap-1.5 px-4 py-2.5 min-h-[44px] bg-canvas text-ink text-[13px] font-medium border border-hairline hover:border-border-strong rounded-lg transition-colors whitespace-nowrap"
        >
          <span>{toolsUi.plasticToolLabel}</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>

    <!-- Special Investigation Banner -->
    <div class="mb-10 bg-surface-soft border border-hairline rounded-lg p-6 md:p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <div class="max-w-[750px]">
        <div class="flex flex-wrap items-center gap-2 mb-3">
          <span class="inline-block px-2.5 py-0.5 rounded text-[11px] font-bold uppercase tracking-wider bg-signature-coral text-white">{banner.tag}</span>
          <span class="text-xs text-muted">{banner.subtitle}</span>
        </div>
        <h2 class="text-title-md md:text-title-lg font-semibold text-ink tracking-tight mb-2">
          {banner.title}
        </h2>
        <p class="text-[14px] text-body leading-relaxed">
          {banner.desc}
        </p>
      </div>
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5">
        <a 
          href={tp('/tools/pan-scratch-inspector/')} 
          class="inline-flex items-center justify-center whitespace-nowrap px-4 py-2.5 rounded-full bg-signature-coral text-white font-medium text-xs hover:bg-black transition-colors shadow-xs"
        >
          {banner.toolButton}
        </a>
        <a 
          href={tp('/material/scratched-nonstick-cookware/')} 
          class="inline-flex items-center justify-center whitespace-nowrap px-4 py-2.5 rounded-full bg-ink text-white font-medium text-xs hover:bg-black transition-colors"
        >
          {banner.button}
        </a>
      </div>
    </div>

    <!-- Instant Material Search Bar -->
    <div class="border-b border-hairline pb-6 mb-8 flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <h2 class="text-title-lg font-medium text-ink tracking-tight mb-1">
          {toolsUi.browseTitle(categoriesWithStats.length)}
        </h2>
        <p class="text-body-md text-muted">
          {toolsUi.browseSub}
        </p>
      </div>
      <div class="w-full md:max-w-[420px]">
        <div class="relative">
          <svg class="w-4 h-4 text-muted absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m0 0A7.5 7.5 0 1010.5 18a7.5 7.5 0 006.15-3.35z" />
          </svg>
          <input
            type="text"
            id="material-search"
            autocomplete="off"
            placeholder={toolsUi.searchPlaceholder}
            aria-label={toolsUi.searchAria}
            class="w-full h-11 pl-10 pr-10 py-2 bg-canvas text-ink text-[16px] md:text-[14px] border border-hairline rounded-md focus:outline-none focus:border-info-border shadow-xs"
          />
          <button
            type="button"
            id="material-clear"
            aria-label={toolsUi.clearAria}
            class="hidden absolute right-2 top-1/2 -translate-y-1/2 w-7 h-7 rounded-md text-muted hover:text-ink hover:bg-surface-soft inline-flex items-center justify-center transition-colors cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        <p
          id="material-count"
          aria-live="polite"
          data-template={toolsUi.countTemplate}
          class="mt-2 text-xs font-medium text-muted"
        >
          {toolsUi.countTemplate
            .replace('{count}', String(categoriesWithStats.length))
            .replace('{total}', String(categoriesWithStats.length))}
        </p>
      </div>
    </div>

    <!-- Categories Grid -->
    <div id="material-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      {categoriesWithStats.map(cat => {
        const isDark = cat.styling.includes('text-white');
        const searchIndex = `${cat.displayName} ${cat.description} ${cat.id} ${(cat.rawMaterials || []).join(' ')}`.toLowerCase();
        return (
          <a 
            href={`/${lang}/material/${cat.id}/`} 
            data-search={searchIndex}
            class={`material-card ${cat.styling} border rounded-lg p-8 flex flex-col justify-between min-h-[220px] shadow-sm transition-transform active:scale-[0.98]`}
          >
            <div>
              <span class={`text-[11px] uppercase tracking-wider font-bold block mb-2 ${isDark ? 'text-white/75' : 'text-muted'}`}>
                {(itemsCheckedLabels[lang] || itemsCheckedLabels.en)(cat.itemCount)}
              </span>
              <h2 class={`text-title-lg font-medium tracking-tight mb-3 ${isDark ? 'text-white' : 'text-ink'}`}>
                {cat.displayName}
              </h2>
              <p class={`text-[13px] leading-relaxed mb-6 ${isDark ? 'text-white/85' : 'text-body'}`}>
                {cat.description}
              </p>
            </div>
            <span class={`text-[13px] font-medium underline underline-offset-4 flex items-center gap-1 ${isDark ? 'text-white' : 'text-link'}`}>
              {exploreLabels[lang] || exploreLabels.en}
            </span>
          </a>
        );
      })}
    </div>

    <!-- Empty State -->
    <div id="material-no-results" class="hidden text-center py-12">
      <p class="text-title-md text-muted mb-4">{toolsUi.noResults}</p>
      <button
        type="button"
        id="material-reset"
        class="px-4 py-2 min-h-[40px] bg-canvas text-ink text-[13px] font-medium border border-hairline hover:border-border-strong rounded-md transition-colors cursor-pointer"
      >
        {toolsUi.resetLabel}
      </button>
    </div>
  </section>

  <!-- Client-side Material Search Script -->
  <script is:inline>
    (() => {
      const searchInput = document.getElementById('material-search');
      const clearBtn = document.getElementById('material-clear');
      const resetBtn = document.getElementById('material-reset');
      const countEl = document.getElementById('material-count');
      const grid = document.getElementById('material-grid');
      const noResults = document.getElementById('material-no-results');

      if (!searchInput || !grid) return;

      const cards = Array.from(grid.getElementsByClassName('material-card'));
      const total = cards.length;
      const template = (countEl && countEl.getAttribute('data-template')) || '{count} / {total}';

      const applyFilter = () => {
        const query = searchInput.value.trim().toLowerCase();
        let matches = 0;

        for (let i = 0; i < total; i++) {
          const card = cards[i];
          const haystack = card.getAttribute('data-search') || '';
          if (!query || haystack.includes(query)) {
            card.classList.remove('hidden');
            matches++;
          } else {
            card.classList.add('hidden');
          }
        }

        if (clearBtn) {
          clearBtn.classList.toggle('hidden', query.length === 0);
        }

        if (countEl) {
          countEl.textContent = template
            .replace('{count}', String(matches))
            .replace('{total}', String(total));
        }

        if (noResults) {
          noResults.classList.toggle('hidden', matches > 0);
        }
      };

      searchInput.addEventListener('input', applyFilter);

      const clearSearch = () => {
        searchInput.value = '';
        applyFilter();
        searchInput.focus();
      };

      if (clearBtn) clearBtn.addEventListener('click', clearSearch);
      if (resetBtn) resetBtn.addEventListener('click', clearSearch);
    })();
  </script>
</Layout>
