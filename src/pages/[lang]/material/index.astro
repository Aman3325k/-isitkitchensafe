---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { getCategories, getCategoryItemsAndStats } from '../../../utils/materialCategories';
import type { SupportedLanguage } from '../../../i18n/ui';

export function getStaticPaths() {
  const availableLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'zh-cn', 'ja'];
  return [
    {
      params: { lang: 'es' },
      props: {
        lang: 'es' as SupportedLanguage,
        availableLocales
      }
    },
    {
      params: { lang: 'pt' },
      props: {
        lang: 'pt' as SupportedLanguage,
        availableLocales
      }
    },
    {
      params: { lang: 'zh-cn' },
      props: {
        lang: 'zh-cn' as SupportedLanguage,
        availableLocales
      }
    },
    {
      params: { lang: 'ja' },
      props: {
        lang: 'ja' as SupportedLanguage,
        availableLocales
      }
    }
  ];
}

interface Props {
  lang: SupportedLanguage;
  availableLocales: SupportedLanguage[];
}

const { lang, availableLocales } = Astro.props;

const titles: Record<SupportedLanguage, string> = {
  en: "Kitchen Appliance Safety by Material Type | IsItKitchenSafe",
  es: "Seguridad de Electrodomésticos por Tipo de Material | ¿Es Seguro en la Cocina?",
  pt: "Segurança de Eletrodomésticos por Tipo de Material | É Seguro na Cozinha?",
  'zh-cn': "各类材质厨房电器安全性指南 | 厨房安全指南",
  ja: "素材別の厨房・家電安全性ガイド | キッチン安全チェッカー"
};

const descriptions: Record<SupportedLanguage, string> = {
  en: "Are your kitchen items dishwasher, microwave, oven, or freezer safe? Browse safety guides and statistics by material type: metal, plastic, silicone, glass, and more.",
  es: "¿Son tus artículos de cocina aptos para lavavajillas, microondas, horno o congelador? Consulta guías de seguridad y estadísticas por material: metal, plástico, silicona, vidrio y más.",
  pt: "Seus utensílios de cozinha podem ir à lava-louças, micro-ondas, forno ou freezer? Consulte guias de segurança e estatísticas por material: metal, plástico, silicone, vidro e mais.",
  'zh-cn': "您的厨房用品能否放进洗碗机、微波炉、烤箱或冷冻室？查看金属、塑料、硅胶、玻璃等各类材质的安全指南与测试统计。",
  ja: "お使いのキッチン用品は食洗機、電子レンジ、オーブン、冷凍庫に対応していますか？金属、プラスチック、シリコン、ガラスなど素材別の安全性ガイドをご確認いただけます。"
};

const homeLabels: Record<SupportedLanguage, string> = {
  en: "Home",
  es: "Inicio",
  pt: "Início",
  'zh-cn': "首页",
  ja: "ホーム"
};

const materialLabels: Record<SupportedLanguage, string> = {
  en: "Materials",
  es: "Materiales",
  pt: "Materiais",
  'zh-cn': "材质索引",
  ja: "素材別ガイド"
};

const dirLabels: Record<SupportedLanguage, string> = {
  en: "Material Directories",
  es: "Directorios de Materiales",
  pt: "Diretórios de Materiais",
  'zh-cn': "材质安全索引",
  ja: "素材別ディレクトリ"
};

const h1Titles: Record<SupportedLanguage, string> = {
  en: "Kitchen Appliance Safety by Material Type",
  es: "Seguridad de Electrodomésticos por Tipo de Material",
  pt: "Segurança de Eletrodomésticos por Tipo de Material",
  'zh-cn': "按材质分类的厨房电器安全指南",
  ja: "素材タイプ別の厨房・家電安全性一覧"
};

const heroSubtitles: Record<SupportedLanguage, string> = {
  en: "Select a material category below to access dynamic safety statistics, common appliance risks, and complete safety reference tables for all kitchen items.",
  es: "Selecciona una categoría de material a continuación para ver estadísticas dinámicas de seguridad, riesgos comunes en electrodomésticos y tablas completas de referencia para utensilios de cocina.",
  pt: "Selecione uma categoria de material abaixo para ver estatísticas dinâmicas de segurança, riscos comuns em aparelhos e tabelas completas de referência para utensílios de cozinha.",
  'zh-cn': "请在下方选择材质类别，查看动态安全统计、常见电器使用隐患以及针对各类厨房用品的完整安全参考表。",
  ja: "以下の素材カテゴリを選択すると、安全性の統計データ、家電ごとの主なリスク、および検証済みキッチン用品の一覧表をご確認いただけます。"
};

const itemsCheckedLabels: Record<SupportedLanguage, (count: number) => string> = {
  en: (count) => `${count} Items Checked`,
  es: (count) => `${count} Artículos Verificados`,
  pt: (count) => `${count} Itens Verificados`,
  'zh-cn': (count) => `已验证 ${count} 件物品`,
  ja: (count) => `検証済み ${count} 点`
};

const exploreLabels: Record<SupportedLanguage, string> = {
  en: "Explore guides →",
  es: "Explorar guías →",
  pt: "Explorar guias →",
  'zh-cn': "查看材质指南 →",
  ja: "ガイドを見る →"
};

const pageTitle = titles[lang] || titles.en;
const pageDescription = descriptions[lang] || descriptions.en;

const categories = getCategories(lang);

const categoriesWithStats = categories.map(cat => {
  const stats = getCategoryItemsAndStats(cat.id, lang);
  return {
    ...cat,
    itemCount: stats ? stats.totalItemsTested : 0
  };
});
---

<Layout title={pageTitle} description={pageDescription} availableLocales={availableLocales} lang={lang}>
  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs 
        items={[
          { label: homeLabels[lang] || homeLabels.en, href: `/${lang}/` },
          { label: materialLabels[lang] || materialLabels.en }
        ]}
        className="mb-0"
      />
    </div>
  </div>

  <section class="max-w-[1280px] mx-auto px-6 py-[80px] md:py-[96px]">
    <!-- Header -->
    <header class="max-w-[800px] mb-12">
      <span class="text-caption text-muted uppercase tracking-wider text-xs block mb-2">
        {dirLabels[lang] || dirLabels.en}
      </span>
      <h1 class="text-display-lg md:text-display-xl font-medium text-ink tracking-tight mb-4">
        {h1Titles[lang] || h1Titles.en}
      </h1>
      <p class="text-body-md text-muted text-lg leading-relaxed">
        {heroSubtitles[lang] || heroSubtitles.en}
      </p>
    </header>

    <!-- Categories Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      {categoriesWithStats.map(cat => {
        const isDark = cat.styling.includes('text-white');
        return (
          <a 
            href={`/${lang}/material/${cat.id}/`} 
            class={`${cat.styling} border rounded-lg p-8 flex flex-col justify-between min-h-[220px] shadow-sm transition-transform active:scale-[0.98]`}
          >
            <div>
              <span class={`text-[11px] uppercase tracking-wider font-bold block mb-2 ${isDark ? 'text-white/75' : 'text-muted'}`}>
                {(itemsCheckedLabels[lang] || itemsCheckedLabels.en)(cat.itemCount)}
              </span>
              <h2 class={`text-title-lg font-medium tracking-tight mb-3 ${isDark ? 'text-white' : 'text-ink'}`}>
                {cat.displayName}
              </h2>
              <p class={`text-[13px] leading-relaxed mb-6 ${isDark ? 'text-white/85' : 'text-body'}`}>
                {cat.description}
              </p>
            </div>
            <span class={`text-[13px] font-medium underline underline-offset-4 flex items-center gap-1 ${isDark ? 'text-white' : 'text-link'}`}>
              {exploreLabels[lang] || exploreLabels.en}
            </span>
          </a>
        );
      })}
    </div>
  </section>
</Layout>
