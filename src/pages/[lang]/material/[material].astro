---
import Layout from '../../../layouts/Layout.astro';
import { CATEGORIES, getCategoryItemsAndStats, getLatestDataModifiedTime, getCategories } from '../../../utils/materialCategories';
import type { SupportedLanguage } from '../../../i18n/ui';

export function getStaticPaths() {
  const esPaths = CATEGORIES.map(cat => ({
    params: { lang: 'es', material: cat.id },
    props: {
      lang: 'es' as SupportedLanguage,
      categoryId: cat.id,
      availableLocales: ['en', 'es', 'pt'] as SupportedLanguage[]
    }
  }));

  const ptPaths = CATEGORIES.map(cat => ({
    params: { lang: 'pt', material: cat.id },
    props: {
      lang: 'pt' as SupportedLanguage,
      categoryId: cat.id,
      availableLocales: ['en', 'es', 'pt'] as SupportedLanguage[]
    }
  }));

  return [...esPaths, ...ptPaths];
}

interface Props {
  lang: SupportedLanguage;
  categoryId: string;
  availableLocales: SupportedLanguage[];
}

const { lang, categoryId, availableLocales } = Astro.props;
const isEs = lang === 'es';

const stats = getCategoryItemsAndStats(categoryId, lang);
if (!stats) {
  throw new Error(`Invalid material category: ${categoryId}`);
}

const { category, totalItemsTested, safePercentage, mostCommonRisk, items } = stats;

const pageTitle = isEs
  ? `Guía de Seguridad para ${category.displayName} | ¿Es Seguro en la Cocina?`
  : `Guia de Segurança para ${category.displayName} | É Seguro na Cozinha?`;

const pageDescription = isEs
  ? `¿Son seguros los artículos de ${category.displayName} en el lavavajillas, microondas, horno o congelador? Consulta estadísticas de seguridad, riesgos y tabla comparativa para ${totalItemsTested} artículos.`
  : `Os itens de ${category.displayName} são seguros na lava-louças, micro-ondas, forno ou freezer? Veja estatísticas de segurança, riscos e tabela comparativa para ${totalItemsTested} itens.`;

const lastModifiedTime = getLatestDataModifiedTime();
const formattedLastVerified = lastModifiedTime.toLocaleDateString(isEs ? 'es-ES' : 'pt-BR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

const isWashingBased = categoryId === 'fabric' || categoryId === 'footwear';
const columns = isWashingBased 
  ? (isEs 
      ? [
          { id: 'washing-machine', label: 'Lavadora' },
          { id: 'dryer', label: 'Secadora' }
        ]
      : [
          { id: 'washing-machine', label: 'Máquina de Lavar' },
          { id: 'dryer', label: 'Secadora' }
        ])
  : (isEs
      ? [
          { id: 'dishwasher', label: 'Lavavajillas' },
          { id: 'microwave', label: 'Microondas' },
          { id: 'oven', label: 'Horno' },
          { id: 'freezer', label: 'Congelador' }
        ]
      : [
          { id: 'dishwasher', label: 'Lava-Louças' },
          { id: 'microwave', label: 'Micro-ondas' },
          { id: 'oven', label: 'Forno' },
          { id: 'freezer', label: 'Freezer' }
        ]);

// Generate dynamic cross-linking links with localized category names
const allCategories = getCategories(lang);
const relatedMaterials = category.relatedIds
  .map(id => allCategories.find(c => c.id === id))
  .filter((c): c is typeof allCategories[number] => c !== undefined);

// Upgraded Schema markup
const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": isEs 
    ? `Comparativa de Seguridad para ${category.displayName}` 
    : `Comparação de Segurança para ${category.displayName}`,
  "description": isEs 
    ? `Pautas detalladas de seguridad y comparaciones para artículos de ${category.displayName}.`
    : `Diretrizes detalhadas de segurança e comparações para itens de ${category.displayName}.`,
  "numberOfItems": items.length,
  "itemListElement": items.map((item, idx) => ({
    "@type": "ListItem",
    "position": idx + 1,
    "item": {
      "@type": "Thing",
      "name": item.name,
      "url": `https://isitkitchensafe.com${Object.values(item.appliances)[0]?.url || ''}`,
      "additionalProperty": Object.entries(item.appliances).map(([appName, appInfo]) => ({
        "@type": "PropertyValue",
        "name": `${appName}Safe`,
        "value": appInfo.safe.toUpperCase()
      }))
    }
  }))
};

const breadcrumbListSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": isEs ? "Inicio" : "Início",
      "item": `https://isitkitchensafe.com/${lang}`
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": isEs ? "Materiales" : "Materiais",
      "item": `https://isitkitchensafe.com/${lang}/material`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": category.displayName,
      "item": `https://isitkitchensafe.com/${lang}/material/${category.id}`
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} excludeBreadcrumbSchema={true} availableLocales={availableLocales} lang={lang}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(itemListSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbListSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-4">
    <div class="max-w-[1280px] mx-auto px-6">
      <nav class="flex gap-2 text-muted text-[13px]" aria-label="Breadcrumb">
        <a href={`/${lang}/`} class="hover:text-ink transition-colors">{isEs ? "Inicio" : "Início"}</a>
        <span>/</span>
        <a href={`/${lang}/material`} class="hover:text-ink transition-colors">{isEs ? "Materiales" : "Materiais"}</a>
        <span>/</span>
        <span class="text-ink font-medium">{category.displayName}</span>
      </nav>
    </div>
  </div>

  <article class="max-w-[1280px] mx-auto px-6 py-[48px] md:py-[64px]">
    <!-- Header -->
    <header class="mb-10 text-center md:text-left">
      <span class="text-caption text-muted uppercase tracking-wider text-xs block mb-2">
        {isEs ? "Guía de Seguridad del Material" : "Guia de Segurança do Material"}
      </span>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        {isEs ? `Seguridad de Electrodomésticos para ${category.displayName}` : `Segurança de Eletrodomésticos para ${category.displayName}`}
      </h1>
      <p class="text-body-md text-muted text-lg leading-relaxed max-w-[800px]">
        {category.description} {isEs 
          ? "Lee a continuación los riesgos de seguridad agregados y la tabla comparativa completa."
          : "Veja abaixo os riscos de segurança agregados e a tabela comparativa completa."}
      </p>
    </header>

    <!-- Quick Stats Block -->
    <section class="mb-12">
      <div class="bg-surface-soft border border-hairline rounded-lg p-6 md:p-8">
        <h2 class="text-title-sm text-ink font-medium mb-6">
          {isEs ? "Estadísticas de Verificación del Material" : "Estatísticas de Verificação do Material"}
        </h2>
        <dl class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 text-[14px]">
          <div class="bg-canvas border border-hairline/60 rounded-md p-5 shadow-xs">
            <dt class="text-caption text-muted uppercase tracking-wider text-[11px] block mb-1">
              {isEs ? "Artículos Totales Verificados" : "Total de Itens Testados"}
            </dt>
            <dd class="text-ink text-[18px] font-semibold">{totalItemsTested} {isEs ? "artículos" : "itens"}</dd>
          </div>
          <div class="bg-canvas border border-hairline/60 rounded-md p-5 shadow-xs">
            <dt class="text-caption text-muted uppercase tracking-wider text-[11px] block mb-1">
              {isWashingBased 
                ? (isEs ? "Tasa Apto para Lavado" : "Taxa Apto para Lavar")
                : (isEs ? "Tasa Apto para Lavavajillas" : "Taxa Apto para Lava-Louças")}
            </dt>
            <dd class="text-ink text-[18px] font-semibold">{safePercentage}% {isEs ? "seguro" : "seguro"}</dd>
          </div>
          <div class="bg-canvas border border-hairline/60 rounded-md p-5 shadow-xs lg:col-span-2">
            <dt class="text-caption text-muted uppercase tracking-wider text-[11px] block mb-1">
              {isEs ? "Riesgo Principal de Seguridad" : "Risco Principal de Segurança"}
            </dt>
            <dd class="text-signature-coral text-[15px] font-semibold leading-snug">{mostCommonRisk}</dd>
          </div>
        </dl>
        <div class="mt-6 border-t border-hairline/60 pt-4 flex items-center justify-between text-xs text-muted">
          <span>
            {isEs ? "Verificado por el Equipo Editorial de ¿Es Seguro en la Cocina?" : "Verificado pela Equipe Editorial do É Seguro na Cozinha?"}
          </span>
          <span>
            {isEs ? "Datos verificados el: " : "Dados verificados em: "}
            <strong class="text-ink font-medium">{formattedLastVerified}</strong>
          </span>
        </div>
      </div>
    </section>

    <!-- Comparison Table Section -->
    <section class="mb-16">
      <h2 class="text-title-lg text-ink font-medium tracking-tight mb-6">
        {isEs ? `Tabla Comparativa de Seguridad para ${category.displayName}` : `Tabela Comparativa de Segurança para ${category.displayName}`}
      </h2>
      <div class="border border-hairline rounded-lg overflow-hidden shadow-xs bg-canvas">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <caption class="sr-only">
              {isEs 
                ? `Clasificaciones de seguridad en electrodomésticos para artículos de ${category.displayName}`
                : `Classificações de segurança em eletrodomésticos para itens de ${category.displayName}`}
            </caption>
            <thead>
              <tr class="bg-surface-soft border-b border-hairline text-ink text-[13px] font-semibold">
                <th scope="col" class="py-4 px-6 font-medium">{isEs ? "Nombre del Artículo" : "Nome do Item"}</th>
                {columns.map(col => (
                  <th scope="col" class="py-4 px-6 font-medium text-center">{col.label}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {items.map(item => (
                <tr class="border-b border-hairline last:border-0 hover:bg-surface-soft/40 transition-colors text-[14px]">
                  <th scope="row" class="py-4 px-6 font-medium text-ink">
                    {(() => {
                      const firstApp = Object.values(item.appliances)[0];
                      return firstApp ? (
                        <a href={firstApp.url} class="text-link hover:underline">
                          {item.name}
                        </a>
                      ) : (
                        item.name
                      );
                    })()}
                  </th>
                  {columns.map(col => {
                    const status = item.appliances[col.id];
                    return (
                      <td class="py-4 px-6 text-center">
                        {status ? (
                          <a 
                            href={status.url} 
                            class={`inline-flex items-center justify-center font-bold px-3 py-1 rounded-full text-[11px] tracking-wide uppercase select-none transition-colors border ${
                              status.safe === 'yes' ? 'bg-success/10 text-success border-success/20 hover:bg-success/20' : 
                              status.safe === 'no' ? 'bg-error/10 text-error border-error/20 hover:bg-error/20' : 
                              'bg-warning/10 text-warning border-warning/20 hover:bg-warning/20'
                            }`}
                          >
                            {status.safe === 'yes' ? (isEs ? '✓ SÍ' : '✓ SIM') : status.safe === 'no' ? (isEs ? '✗ NO' : '✗ NÃO') : (isEs ? '⚠ DEPENDE' : '⚠ DEPENDE')}
                          </a>
                        ) : (
                          <span class="text-muted/50">—</span>
                        )}
                      </td>
                    );
                  })}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Related Materials Cross-Linking -->
    <section class="border-t border-hairline pt-12">
      <h2 class="text-title-md text-ink font-medium tracking-tight mb-6">
        {isEs ? "También te puede interesar consultar:" : "Você também pode querer conferir:"}
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
        {relatedMaterials.map(rel => {
          const isDark = rel.styling.includes('text-white');
          return (
            <a 
              href={`/${lang}/material/${rel.id}`} 
              class={`${rel.styling} border rounded-lg p-6 flex flex-col justify-between min-h-[140px] shadow-sm transition-transform active:scale-[0.98]`}
            >
              <div>
                <h3 class={`text-title-sm font-medium tracking-tight mb-2 ${isDark ? 'text-white' : 'text-ink'}`}>
                  {rel.displayName}
                </h3>
                <p class={`text-[12px] leading-relaxed mb-4 ${isDark ? 'text-white/80' : 'text-muted'}`}>
                  {rel.description.split('.')[0]}.
                </p>
              </div>
              <span class={`text-[12px] font-medium underline underline-offset-4 flex items-center gap-1 ${isDark ? 'text-white' : 'text-link'}`}>
                {isEs ? "Comparar seguridad →" : "Comparar segurança →"}
              </span>
            </a>
          );
        })}
      </div>
    </section>
  </article>
</Layout>
