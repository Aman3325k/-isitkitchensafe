---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { CATEGORIES, getCategoryItemsAndStats, getCategories } from '../../../utils/materialCategories';
import { getDirectoryUrl, useTranslatedPath } from '../../../i18n/utils';
import type { SupportedLanguage } from '../../../i18n/ui';

export function getStaticPaths() {
  const allLangs: SupportedLanguage[] = ['es', 'pt', 'zh-cn', 'ja'];
  const availableLocales: SupportedLanguage[] = ['en', 'es', 'pt', 'zh-cn', 'ja'];

  return allLangs.flatMap(l => 
    CATEGORIES.map(cat => ({
      params: { lang: l, material: cat.id },
      props: {
        lang: l,
        categoryId: cat.id,
        availableLocales
      }
    }))
  );
}

interface Props {
  lang: SupportedLanguage;
  categoryId: string;
  availableLocales: SupportedLanguage[];
}

const { lang, categoryId, availableLocales } = Astro.props;

const stats = getCategoryItemsAndStats(categoryId, lang);
if (!stats) {
  throw new Error(`Invalid material category: ${categoryId}`);
}

const { category, totalItemsTested, safePercentage, mostCommonRisk, items } = stats;

const titles: Record<SupportedLanguage, (cat: string) => string> = {
  en: (cat) => `${cat} Appliance Safety Guide | IsItKitchenSafe`,
  es: (cat) => `Guía de Seguridad para ${cat} | ¿Es Seguro en la Cocina?`,
  pt: (cat) => `Guia de Segurança para ${cat} | É Seguro na Cozinha?`,
  'zh-cn': (cat) => `${cat}厨房电器安全使用指南 | 厨房安全指南`,
  ja: (cat) => `${cat}の厨房・家電安全性ガイド | キッチン安全チェッカー`
};

const descriptions: Record<SupportedLanguage, (cat: string, count: number) => string> = {
  en: (cat, count) => `Are ${cat} items safe in the dishwasher, microwave, oven, or freezer? View safety stats, risks, and a full safety comparison table for ${count} items.`,
  es: (cat, count) => `¿Son seguros los artículos de ${cat} en el lavavajillas, microondas, horno o congelador? Consulta estadísticas de seguridad, riesgos y tabla comparativa para ${count} artículos.`,
  pt: (cat, count) => `Os itens de ${cat} são seguros na lava-louças, micro-ondas, forno ou freezer? Veja estatísticas de segurança, riscos e tabela comparativa para ${count} itens.`,
  'zh-cn': (cat, count) => `${cat}物品能否放进洗碗机、微波炉、烤箱或冷冻室？查看针对${count}件物品的安全统计、潜在风险与完整对照表。`,
  ja: (cat, count) => `${cat}のアイテムは食洗機、電子レンジ、オーブン、冷凍庫に入れても大丈夫？検証済み${count}アイテムの安全性データとリスク解説。`
};

const pageTitle = (titles[lang] || titles.en)(category.displayName);
const pageDescription = (descriptions[lang] || descriptions.en)(category.displayName, totalItemsTested);



const isWashingBased = categoryId === 'fabric' || categoryId === 'footwear';

const columnConfigs: Record<SupportedLanguage, { washing: Array<{ id: string; label: string }>; kitchen: Array<{ id: string; label: string }> }> = {
  en: {
    washing: [{ id: 'washing-machine', label: 'Washing Machine' }, { id: 'dryer', label: 'Dryer' }],
    kitchen: [{ id: 'dishwasher', label: 'Dishwasher' }, { id: 'microwave', label: 'Microwave' }, { id: 'oven', label: 'Oven' }, { id: 'freezer', label: 'Freezer' }]
  },
  es: {
    washing: [{ id: 'washing-machine', label: 'Lavadora' }, { id: 'dryer', label: 'Secadora' }],
    kitchen: [{ id: 'dishwasher', label: 'Lavavajillas' }, { id: 'microwave', label: 'Microondas' }, { id: 'oven', label: 'Horno' }, { id: 'freezer', label: 'Congelador' }]
  },
  pt: {
    washing: [{ id: 'washing-machine', label: 'Máquina de Lavar' }, { id: 'dryer', label: 'Secadora' }],
    kitchen: [{ id: 'dishwasher', label: 'Lava-Louças' }, { id: 'microwave', label: 'Micro-ondas' }, { id: 'oven', label: 'Forno' }, { id: 'freezer', label: 'Freezer' }]
  },
  'zh-cn': {
    washing: [{ id: 'washing-machine', label: '洗衣机' }, { id: 'dryer', label: '烘干机' }],
    kitchen: [{ id: 'dishwasher', label: '洗碗机' }, { id: 'microwave', label: '微波炉' }, { id: 'oven', label: '烤箱' }, { id: 'freezer', label: '冷冻室' }]
  },
  ja: {
    washing: [{ id: 'washing-machine', label: '洗濯機' }, { id: 'dryer', label: '乾燥機' }],
    kitchen: [{ id: 'dishwasher', label: '食洗機' }, { id: 'microwave', label: '電子レンジ' }, { id: 'oven', label: 'オーブン' }, { id: 'freezer', label: '冷凍庫' }]
  }
};

const curConfig = columnConfigs[lang] || columnConfigs.en;
const columns = isWashingBased ? curConfig.washing : curConfig.kitchen;

// Generate dynamic cross-linking links with localized category names
const allCategories = getCategories(lang);
const relatedMaterials = category.relatedIds
  .map(id => allCategories.find(c => c.id === id))
  .filter((c): c is typeof allCategories[number] => c !== undefined);

const homeLabels: Record<SupportedLanguage, string> = {
  en: "Home",
  es: "Inicio",
  pt: "Início",
  'zh-cn': "首页",
  ja: "ホーム"
};

const materialLabels: Record<SupportedLanguage, string> = {
  en: "Materials",
  es: "Materiales",
  pt: "Materiais",
  'zh-cn': "材质索引",
  ja: "素材別ガイド"
};

const guideBadgeLabels: Record<SupportedLanguage, string> = {
  en: "Material Safety Guide",
  es: "Guía de Seguridad del Material",
  pt: "Guia de Segurança do Material",
  'zh-cn': "材质安全指南",
  ja: "素材別安全性ガイド"
};

const h1Titles: Record<SupportedLanguage, (cat: string) => string> = {
  en: (cat) => `Appliance Safety for ${cat}`,
  es: (cat) => `Seguridad de Electrodomésticos para ${cat}`,
  pt: (cat) => `Segurança de Eletrodomésticos para ${cat}`,
  'zh-cn': (cat) => `${cat}电器安全使用指南`,
  ja: (cat) => `${cat}の厨房・家電安全性`
};

const subTexts: Record<SupportedLanguage, string> = {
  en: "Read below for aggregated safety risks and the complete appliance comparison table.",
  es: "Lee a continuación los riesgos de seguridad agregados y la tabla comparativa completa.",
  pt: "Veja abaixo os riscos de segurança agregados e a tabela comparativa completa.",
  'zh-cn': "请阅读下方汇总的安全风险提示及完整的电器适用性对照表。",
  ja: "以下に集約された主な安全リスクと、家電ごとの完全な比較対照表をご確認いただけます。"
};

const statsHeadings: Record<SupportedLanguage, string> = {
  en: "Material Verification Statistics",
  es: "Estadísticas de Verificación del Material",
  pt: "Estatísticas de Verificação do Material",
  'zh-cn': "材质检测与验证统计",
  ja: "素材の検証統計データ"
};

const totalTestedLabels: Record<SupportedLanguage, (count: number) => string> = {
  en: (count) => `${count} items`,
  es: (count) => `${count} artículos`,
  pt: (count) => `${count} itens`,
  'zh-cn': (count) => `${count} 件物品`,
  ja: (count) => `${count} 点`
};

const totalTestedTitles: Record<SupportedLanguage, string> = {
  en: "Total Items Tested",
  es: "Artículos Totales Verificados",
  pt: "Total de Itens Testados",
  'zh-cn': "已验证物品总数",
  ja: "検証済みアイテム総数"
};

const safeRateTitles: Record<SupportedLanguage, (washing: boolean) => string> = {
  en: (w) => w ? "Wash Safe Rate" : "Dishwasher Safe Rate",
  es: (w) => w ? "Tasa Apto para Lavado" : "Tasa Apto para Lavavajillas",
  pt: (w) => w ? "Taxa Apto para Lavar" : "Taxa Apto para Lava-Louças",
  'zh-cn': (w) => w ? "水洗适用率" : "洗碗机机洗适用率",
  ja: (w) => w ? "洗濯機対応率" : "食洗機対応率"
};

const commonRiskTitles: Record<SupportedLanguage, string> = {
  en: "Primary Safety Risk",
  es: "Riesgo Principal de Seguridad",
  pt: "Risco Principal de Segurança",
  'zh-cn': "核心安全风险",
  ja: "主な安全リスク"
};

const sourceNoticeLabels: Record<SupportedLanguage, string> = {
  en: "Based on public FDA and USDA food-safety guidance and manufacturer instructions.",
  es: "Basado en directrices públicas de seguridad alimentaria de la FDA y el USDA e instrucciones del fabricante.",
  pt: "Com base nas orientações públicas de segurança alimentar da FDA e do USDA e instruções do fabricante.",
  'zh-cn': "基于美国食品药品监督管理局 (FDA) 与美国农业部 (USDA) 的公开食品安全指引及制造商说明。",
  ja: "米国FDAおよびUSDAの公式食品安全ガイドラインならびに各製品の取扱説明書に基づいています。"
};

const spottedErrorLabels: Record<SupportedLanguage, string> = {
  en: "Spotted an error?",
  es: "¿Detectó un error?",
  pt: "Encontrou um erro?",
  'zh-cn': "发现错误？",
  ja: "誤りを見つけましたか？"
};

const contactUsLabels: Record<SupportedLanguage, string> = {
  en: "Contact us.",
  es: "Contáctenos.",
  pt: "Entre em contato.",
  'zh-cn': "联系我们。",
  ja: "お問い合わせください。"
};

const tableHeadings: Record<SupportedLanguage, (cat: string) => string> = {
  en: (cat) => `Safety Comparison Table for ${cat}`,
  es: (cat) => `Tabla Comparativa de Seguridad para ${cat}`,
  pt: (cat) => `Tabela Comparativa de Segurança para ${cat}`,
  'zh-cn': (cat) => `${cat}安全性对照表`,
  ja: (cat) => `${cat} 安全性比較一覧表`
};

const itemNameHeaders: Record<SupportedLanguage, string> = {
  en: "Item Name",
  es: "Nombre del Artículo",
  pt: "Nome do Item",
  'zh-cn': "物品名称",
  ja: "アイテム名"
};

const verdictLabels: Record<SupportedLanguage, { yes: string; no: string; depends: string }> = {
  en: { yes: '✓ YES', no: '✗ NO', depends: '⚠ DEPENDS' },
  es: { yes: '✓ SÍ', no: '✗ NO', depends: '⚠ DEPENDE' },
  pt: { yes: '✓ SIM', no: '✗ NÃO', depends: '⚠ DEPENDE' },
  'zh-cn': { yes: '✓ 安全', no: '✗ 危险', depends: '⚠ 视情况' },
  ja: { yes: '✓ 安全', no: '✗ 不可', depends: '⚠ 条件付' }
};

const curVerdicts = verdictLabels[lang] || verdictLabels.en;

const alsoLikeTitles: Record<SupportedLanguage, string> = {
  en: "You might also want to check:",
  es: "También te puede interesar consultar:",
  pt: "Você também pode querer conferir:",
  'zh-cn': "您可能还对以下材质感兴趣：",
  ja: "こちらの関連素材もご確認ください："
};

const compareCtas: Record<SupportedLanguage, string> = {
  en: "Compare safety →",
  es: "Comparar seguridad →",
  pt: "Comparar segurança →",
  'zh-cn': "对比材质安全性 →",
  ja: "安全性を比較する →"
};

// Upgraded Schema markup
const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": (tableHeadings[lang] || tableHeadings.en)(category.displayName),
  "description": pageDescription,
  "numberOfItems": items.length,
  "itemListElement": items.map((item, idx) => ({
    "@type": "ListItem",
    "position": idx + 1,
    "item": {
      "@type": "Thing",
      "name": item.name,
      "url": `https://isitkitchensafe.com${Object.values(item.appliances)[0]?.url || ''}`,
      "additionalProperty": Object.entries(item.appliances).map(([appName, appInfo]) => ({
        "@type": "PropertyValue",
        "name": `${appName}Safe`,
        "value": appInfo.safe.toUpperCase()
      }))
    }
  }))
};

const breadcrumbListSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": homeLabels[lang] || homeLabels.en,
      "item": `https://isitkitchensafe.com/${lang}/`
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": materialLabels[lang] || materialLabels.en,
      "item": `https://isitkitchensafe.com/${lang}/material/`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": category.displayName,
      "item": `https://isitkitchensafe.com/${lang}/material/${category.id}/`
    }
  ]
};

// Localized E-E-A-T links & Smart Contextual Consumer Calculator CTA
const isEs = lang === 'es';
const isPt = lang === 'pt';
const isZh = lang === 'zh-cn';
const translatePath = useTranslatedPath(lang);
const methodologyUrl = getDirectoryUrl('methodology', lang);
const contactUrl = getDirectoryUrl('contact', lang);

const materialMatchKey = category.id.toLowerCase();

function getPrimaryMaterialTool(key: string) {
  if (/(plastic|silicone|melamine|styrofoam|acrylic|resin)/i.test(key)) {
    return {
      path: '/tools/plastic-code-checker/',
      icon: '♻️',
      title: isEs ? 'Verificador de Códigos de Plástico y Resina (#1–#7)' :
             isPt ? 'Verificador de Códigos de Plástico e Resina (#1–#7)' :
             isZh ? '塑料与树脂编号（#1–#7）耐热安全查询器' :
             'プラスチック・樹脂番号（#1〜#7）耐熱安全性チェッカー',
      description: isEs ? 'Descifra los códigos de polímeros para comprobar el riesgo de lixiviación y los límites de calor en microondas, lavavajillas y congelador.' :
                   isPt ? 'Decifre os códigos de polímeros para verificar risco de lixiviação e limites de calor no micro-ondas, lava-louças e freezer.' :
                   isZh ? '解读容器底部的高分子树脂编号，快速查询析出风险及微波炉、洗碗机、冷冻室安全温度上限。' :
                   '容器底面の樹脂コードから溶出リスクや電子レンジ・食洗機・冷凍庫での耐熱上限を確認できます。',
      cta: isEs ? 'Verificar Código' : isPt ? 'Verificar Código' : isZh ? '查询树脂编号' : '樹脂番号を確認'
    };
  }
  if (/(baby|kids)/i.test(key)) {
    return {
      path: '/tools/baby-bottle-safety-checker/',
      icon: '🍼',
      title: isEs ? 'Verificador de Seguridad de Biberones y Vajilla Infantil' :
             isPt ? 'Verificador de Segurança de Mamadeiras e Louça Infantil' :
             isZh ? '奶瓶与儿童餐具安全检查器' :
             '哺乳瓶・ベビー食器 安全性チェッカー',
      description: isEs ? 'Evalúa materiales de biberones, límites térmicos de esterilización y prácticas para reducir microplásticos en utensilios infantiles.' :
                   isPt ? 'Avalie materiais de mamadeiras, limites térmicos de esterilização e cuidados para reduzir microplásticos em utensílios infantis.' :
                   isZh ? '评估奶瓶材质、高温消毒安全上限以及减少微塑料释放的科学冲泡与清洗方法。' :
                   '哺乳瓶の素材別リスク、煮沸・レンジ消毒の耐熱上限、マイクロプラスチック低減策を確認できます。',
      cta: isEs ? 'Verificar Seguridad Infantil' : isPt ? 'Verificar Segurança Infantil' : isZh ? '检查婴儿用品安全' : '安全性を確認'
    };
  }
  if (/(metal|stainless|cast-iron|aluminum|copper|glass|ceramic|stoneware|pyrex|non-?stick|enamel|terracotta)/i.test(key)) {
    return {
      path: '/tools/cookware-oven-temp-lookup/',
      icon: '🍳',
      title: isEs ? 'Buscador de Temperatura Máxima de Horno para Menaje' :
             isPt ? 'Consulta de Temperatura Máxima de Forno para Panelas' :
             isZh ? '锅具与器皿烤箱最高耐温查询表' :
             '調理器具・鍋のオーブン耐熱上限検索ツール',
      description: isEs ? 'Verifica temperaturas máximas seguras de horno, grill y tapas de vidrio para metal, vidrio, cerámica, hierro fundido y antiadherentes.' :
                   isPt ? 'Confira os limites seguros de forno, grill e tampas de vidro para metal, vidro, cerâmica, ferro fundido e antiaderentes.' :
                   isZh ? '速查金属、耐热玻璃、陶瓷、铸铁及不粘锅具与玻璃锅盖的烤箱及炙烤最高耐受温度。' :
                   '金属・ガラス・陶磁器・鋳鉄・フッ素樹脂加工およびガラス蓋の安全なオーブン耐熱温度を一覧で確認できます。',
      cta: isEs ? 'Consultar Límite de Horno' : isPt ? 'Consultar Limite de Forno' : isZh ? '查询烤箱耐温' : '耐熱上限を確認'
    };
  }
  if (/(wood|bamboo|paper|parchment|foil)/i.test(key)) {
    return {
      path: '/tools/air-fryer-oven-converter/',
      icon: '🔥',
      title: isEs ? 'Conversor de Tiempo y Temperatura de Horno a Freidora de Aire' :
             isPt ? 'Conversor de Tempo e Temperatura de Forno para Air Fryer' :
             isZh ? '空气炸锅与烤箱安全温时换算器' :
             'ノンフライヤー・オーブン温度＆時間変換ツール',
      description: isEs ? 'Calcula ajustes seguros de temperatura y tiempo al hornear con papel pergamino, moldes o materiales sensibles al calor.' :
                   isPt ? 'Calcule ajustes seguros de temperatura e tempo ao assar com papel manteiga, forros ou materiais sensíveis ao calor.' :
                   isZh ? '使用烘焙油纸、纸托或耐热敏感材质时，精准换算安全的空气炸锅与烤箱温度与时长。' :
                   'クッキングシートや紙製ライナー等の熱に弱い素材を使う際の安全な温度と加熱時間を正確に換算します。',
      cta: isEs ? 'Convertir Temperatura' : isPt ? 'Converter Temperatura' : isZh ? '换算烹饪温度' : '温度・時間を変換'
    };
  }
  return {
    path: '/tools/kitchen-symbol-decoder/',
    icon: '🔍',
    title: isEs ? 'Decodificador de Símbolos de Seguridad en Utensilios de Cocina' :
           isPt ? 'Decodificador de Símbolos de Segurança em Utensílios de Cozinha' :
           isZh ? '厨具与日用品安全图标解码器' :
           'キッチン用品・食器の安全マーク解読ツール',
    description: isEs ? 'Descifra iconos grabados de lavavajillas, microondas, horno, congelador y lavado para cuidar cada material sin dañarlo.' :
                 isPt ? 'Decifre ícones gravados de lava-louças, micro-ondas, forno, freezer e lavagem para cuidar de cada material com segurança.' :
                 isZh ? '快速识别物品底部标注的洗碗机、微波炉、烤箱、冷冻室及洗涤安全标识，防止误操作损坏。' :
                 '食洗機・電子レンジ・オーブン・冷凍庫・洗濯表示マークの意味を判別し、素材を傷めず安全に使えます。',
    cta: isEs ? 'Decodificar Símbolos' : isPt ? 'Decodificar Símbolos' : isZh ? '解码安全图标' : '安全マークを調べる'
  };
}

const primaryTool = getPrimaryMaterialTool(materialMatchKey);
const secondaryTool = primaryTool.path === '/tools/kitchen-symbol-decoder/'
  ? {
      path: '/tools/cookware-oven-temp-lookup/',
      icon: '🍳',
      title: isEs ? 'Buscador de Temperatura Máxima de Horno para Utensilios' :
             isPt ? 'Consulta de Temperatura Máxima de Forno para Panelas' :
             isZh ? '锅具与器皿烤箱最高耐温查询表' :
             '調理器具・鍋のオーブン耐熱上限検索ツール',
      description: isEs ? 'Comprueba los límites verificados de horno y grill para ollas, fuentes y componentes de electrodomésticos.' :
                   isPt ? 'Confira os limites verificados de forno e grill para panelas, assadeiras e componentes de eletrodomésticos.' :
                   isZh ? '速查各类锅具、烤盘与厨房电器配件的烤箱及炙烤最高安全耐温。' :
                   '鍋・耐熱皿・家電パーツのオーブンおよびグリル耐熱上限温度を確認できます。',
      cta: isEs ? 'Ver Temperaturas' : isPt ? 'Ver Temperaturas' : isZh ? '查看烤箱耐温' : '耐熱上限を確認'
    }
  : {
      path: '/tools/kitchen-symbol-decoder/',
      icon: '🔍',
      title: isEs ? 'Decodificador de Símbolos de Seguridad en Utensilios' :
             isPt ? 'Decodificador de Símbolos de Segurança em Utensílios' :
             isZh ? '厨具与容器安全图标解码器' :
             'キッチン用品・食器の安全マーク解読ツール',
      description: isEs ? 'Identifica los símbolos de lavavajillas, microondas, congelador y horno grabados en tus utensilios para verificar su cuidado.' :
                   isPt ? 'Identifique símbolos de lava-louças, micro-ondas, freezer e forno gravados nos utensílios para conferir as regras de uso.' :
                   isZh ? '对照器皿底部的洗碗机、微波炉、冷冻室和烤箱图标，快速确认安全使用规则。' :
                   '食器や容器に刻印された食洗機・電子レンジ・冷凍・オーブン対応マークをすぐ照合できます。',
      cta: isEs ? 'Decodificar Símbolos' : isPt ? 'Decodificar Símbolos' : isZh ? '解码安全图标' : 'マークを調べる'
    };

const primaryToolUrl = translatePath(primaryTool.path);
const secondaryToolUrl = translatePath(secondaryTool.path);

const uxCopy = {
  badgeVerified: isEs ? '✓ Verificado FDA 21 CFR y NSF/ANSI' :
                 isPt ? '✓ Verificado FDA 21 CFR e NSF/ANSI' :
                 isZh ? '✓ 依据 FDA 21 CFR 与 NSF/ANSI 标准核验' :
                 '✓ FDA 21 CFR・NSF/ANSI 基準検証済み',
  interactiveBadge: isEs ? 'Herramienta Interactiva de Materiales' :
                    isPt ? 'Ferramenta Interativa de Materiais' :
                    isZh ? '互动材质安全工具' :
                    'インタラクティブ素材安全ツール',
  copyLink: isEs ? 'Copiar Enlace' : isPt ? 'Copiar Link' : isZh ? '复制链接' : 'リンクをコピー',
  copyAria: isEs ? 'Copiar enlace de esta guía de seguridad del material' :
            isPt ? 'Copiar link deste guia de segurança do material' :
            isZh ? '复制本材质安全指南链接' :
            'この素材安全性ガイドのリンクをコピー',
  copied: isEs ? 'Enlace Copiado' : isPt ? 'Link Copiado' : isZh ? '链接已复制' : 'コピーしました',
  toastCopied: isEs ? 'Enlace de la guía del material copiado al portapapeles' :
               isPt ? 'Link do guia do material copiado para a área de transferência' :
               isZh ? '材质安全指南链接已复制到剪贴板' :
               '素材ガイドのリンクをクリップボードにコピーしました',
  printGuide: isEs ? 'Imprimir Guía' : isPt ? 'Imprimir Guia' : isZh ? '打印指南' : 'ガイドを印刷',
  printAria: isEs ? 'Imprimir esta guía de seguridad del material' :
             isPt ? 'Imprimir este guia de segurança do material' :
             isZh ? '打印本材质安全指南' :
             'この素材安全性ガイドを印刷',
  trustHeading: isEs ? 'Verificado según FDA 21 CFR, estándares NSF/ANSI y datos de pruebas térmicas de materiales' :
                isPt ? 'Verificado conforme FDA 21 CFR, normas NSF/ANSI e dados de ensaios térmicos de materiais' :
                isZh ? '严格依据 FDA 21 CFR、NSF/ANSI 标准与材料热稳定性测试数据核验' :
                'FDA 21 CFR・NSF/ANSI 規格および素材の耐熱試験データに基づき検証済み',
  methodologyCta: isEs ? 'Leer Metodología de Verificación' :
                  isPt ? 'Ler Metodologia de Verificação' :
                  isZh ? '查看安全核验方法论' :
                  '安全検証メソドロジーを見る',
  reportCorrection: isEs ? 'Reportar una corrección' :
                    isPt ? 'Relatar uma correção' :
                    isZh ? '反馈纠错或更新' :
                    '修正・更新を報告',
  trustFoot: isEs ? 'Las clasificaciones de materiales, umbrales de choque térmico y compatibilidad con electrodomésticos se cotejan con las regulaciones FDA 21 CFR de contacto alimentario, estándares NSF/ANSI y datos de pruebas térmicas.' :
             isPt ? 'As classificações de materiais, limites de choque térmico e compatibilidade com eletrodomésticos são conferidos com regulamentos FDA 21 CFR de contato alimentar, normas NSF/ANSI e dados de testes térmicos.' :
             isZh ? '本页材质安全评级、热冲击阈值与电器适用性结论均对照美国 FDA 21 CFR 食品接触材料法规、NSF/ANSI 食品设备标准及公开材料热性能测试数据交叉核验。' :
             '素材別の安全評価・熱衝撃しきい値・家電適合判定は、FDA 21 CFR 食品接触物質規制、NSF/ANSI 食品機器規格および公表されている耐熱試験データと照合しています。'
};
---

<Layout title={pageTitle} description={pageDescription} excludeBreadcrumbSchema={true} availableLocales={availableLocales} lang={lang}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(itemListSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbListSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-surface-soft border-b border-hairline py-1">
    <div class="max-w-[1280px] mx-auto px-6">
      <Breadcrumbs 
        items={[
          { label: homeLabels[lang] || homeLabels.en, href: `/${lang}/` },
          { label: materialLabels[lang] || materialLabels.en, href: `/${lang}/material/` },
          { label: category.displayName }
        ]}
        className="mb-0"
      />
    </div>
  </div>

  <article class="max-w-[1280px] mx-auto px-6 py-[48px] md:py-[64px]">
    <!-- Header -->
    <header class="mb-10 text-center md:text-left">
      <div class="flex flex-wrap items-center justify-center md:justify-start gap-2.5 mb-3">
        <span class="text-caption text-muted uppercase tracking-wider text-xs">
          {guideBadgeLabels[lang] || guideBadgeLabels.en}
        </span>
        <span class="text-hairline hidden sm:inline">•</span>
        <a
          href={methodologyUrl}
          class="inline-flex items-center gap-1 text-success font-medium bg-success-bg border border-success-border/30 px-2.5 py-0.5 rounded-full text-xs hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link focus-visible:ring-offset-2"
        >
          {uxCopy.badgeVerified}
        </a>
      </div>
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-4">
        {(h1Titles[lang] || h1Titles.en)(category.displayName)}
      </h1>
      <p class="text-body-md text-muted text-lg leading-relaxed max-w-[800px]">
        {category.description} {subTexts[lang] || subTexts.en}
      </p>

      <!-- Quick-Share & Print Action Bar -->
      <div class="mt-5 flex flex-wrap items-center justify-center md:justify-start gap-2.5 no-print">
        <button
          id="copy-link-btn"
          type="button"
          aria-label={uxCopy.copyAria}
          data-default-text={uxCopy.copyLink}
          data-copied-text={uxCopy.copied}
          data-toast-text={uxCopy.toastCopied}
          class="min-h-[40px] px-3.5 py-2 bg-canvas hover:bg-surface-soft active:scale-[0.98] text-ink border border-hairline rounded-md text-xs font-medium inline-flex items-center gap-2 shadow-xs transition-all cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link focus-visible:ring-offset-2"
        >
          <svg class="w-4 h-4 text-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
          </svg>
          <span id="copy-link-btn-text">{uxCopy.copyLink}</span>
        </button>

        <button
          id="print-guide-btn"
          type="button"
          aria-label={uxCopy.printAria}
          class="min-h-[40px] px-3.5 py-2 bg-canvas hover:bg-surface-soft active:scale-[0.98] text-ink border border-hairline rounded-md text-xs font-medium inline-flex items-center gap-2 shadow-xs transition-all cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link focus-visible:ring-offset-2"
        >
          <svg class="w-4 h-4 text-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4H7v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
          </svg>
          <span>{uxCopy.printGuide}</span>
        </button>
      </div>
    </header>

    <!-- Quick Stats Block -->
    <section class="mb-12">
      <div class="bg-surface-soft border border-hairline rounded-lg p-6 md:p-8">
        <h2 class="text-title-sm text-ink font-medium mb-6">
          {statsHeadings[lang] || statsHeadings.en}
        </h2>
        <dl class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 text-[14px]">
          <div class="bg-canvas border border-hairline/60 rounded-md p-5 shadow-xs">
            <dt class="text-caption text-muted uppercase tracking-wider text-[11px] block mb-1">
              {totalTestedTitles[lang] || totalTestedTitles.en}
            </dt>
            <dd class="text-ink text-[18px] font-semibold">{(totalTestedLabels[lang] || totalTestedLabels.en)(totalItemsTested)}</dd>
          </div>
          <div class="bg-canvas border border-hairline/60 rounded-md p-5 shadow-xs">
            <dt class="text-caption text-muted uppercase tracking-wider text-[11px] block mb-1">
              {(safeRateTitles[lang] || safeRateTitles.en)(isWashingBased)}
            </dt>
            <dd class="text-ink text-[18px] font-semibold">{safePercentage}%</dd>
          </div>
          <div class="bg-canvas border border-hairline/60 rounded-md p-5 shadow-xs lg:col-span-2">
            <dt class="text-caption text-muted uppercase tracking-wider text-[11px] block mb-1">
              {commonRiskTitles[lang] || commonRiskTitles.en}
            </dt>
            <dd class="text-signature-coral text-[15px] font-semibold leading-snug">{mostCommonRisk}</dd>
          </div>
        </dl>
      </div>
    </section>

    <!-- Comparison Table Section -->
    <section class="mb-16">
      <h2 class="text-title-lg text-ink font-medium tracking-tight mb-6">
        {(tableHeadings[lang] || tableHeadings.en)(category.displayName)}
      </h2>
      <div class="border border-hairline rounded-lg overflow-hidden shadow-xs bg-canvas">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <caption class="sr-only">
              {(tableHeadings[lang] || tableHeadings.en)(category.displayName)}
            </caption>
            <thead>
              <tr class="bg-surface-soft border-b border-hairline text-ink text-[13px] font-semibold">
                <th scope="col" class="py-4 px-6 font-medium">{itemNameHeaders[lang] || itemNameHeaders.en}</th>
                {columns.map(col => (
                  <th scope="col" class="py-4 px-6 font-medium text-center">{col.label}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {items.map(item => (
                <tr class="border-b border-hairline last:border-0 hover:bg-surface-soft/40 transition-colors text-[14px]">
                  <th scope="row" class="py-4 px-6 font-medium text-ink">
                    {(() => {
                      const firstApp = Object.values(item.appliances)[0];
                      return firstApp ? (
                        <a href={firstApp.url} class="text-link hover:underline">
                          {item.name}
                        </a>
                      ) : (
                        item.name
                      );
                    })()}
                  </th>
                  {columns.map(col => {
                    const status = item.appliances[col.id];
                    return (
                      <td class="py-4 px-6 text-center">
                        {status ? (
                          <a 
                            href={status.url} 
                            class={`inline-flex items-center justify-center font-bold px-3.5 py-2 min-h-[40px] rounded-full text-[11px] tracking-wide uppercase select-none transition-colors border ${
                              status.safe === 'yes' ? 'bg-success/10 text-success border-success/20 hover:bg-success/20' : 
                              status.safe === 'no' ? 'bg-error/10 text-error border-error/20 hover:bg-error/20' : 
                              'bg-warning/10 text-warning border-warning/20 hover:bg-warning/20'
                            }`}
                          >
                            {status.safe === 'yes' ? curVerdicts.yes : status.safe === 'no' ? curVerdicts.no : curVerdicts.depends}
                          </a>
                        ) : (
                          <span class="text-muted/50">—</span>
                        )}
                      </td>
                    );
                  })}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Smart Contextual Consumer Calculator CTA Card -->
    <section id="recommended-tool-card" class="bg-surface-soft border border-hairline rounded-lg p-5 sm:p-6 shadow-xs mb-8 no-print">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="min-w-0 flex-1">
          <div class="flex flex-wrap items-center gap-2 mb-1.5">
            <span class="text-base" aria-hidden="true">{primaryTool.icon}</span>
            <span class="text-[11px] font-semibold uppercase tracking-wider text-signature-coral">{uxCopy.interactiveBadge}</span>
          </div>
          <h2 class="text-title-sm text-ink font-semibold mb-1.5 leading-snug">
            {primaryTool.title}
          </h2>
          <p class="text-[13px] text-body leading-relaxed">
            {primaryTool.description}
          </p>
        </div>
        <div class="shrink-0">
          <a
            href={primaryToolUrl}
            class="min-h-[42px] px-4 py-2.5 bg-primary hover:bg-primary-active active:scale-[0.98] text-on-primary rounded-md text-xs font-medium inline-flex items-center gap-1.5 transition-all whitespace-nowrap focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link focus-visible:ring-offset-2"
          >
            <span>{primaryTool.cta}</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>

      <div class="mt-4 pt-4 border-t border-hairline flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="min-w-0 flex-1 flex items-start gap-2.5">
          <span class="text-base leading-none mt-0.5 shrink-0" aria-hidden="true">{secondaryTool.icon}</span>
          <div class="min-w-0">
            <p class="text-[13px] font-semibold text-ink leading-snug">{secondaryTool.title}</p>
            <p class="text-[12px] text-muted leading-relaxed mt-0.5">{secondaryTool.description}</p>
          </div>
        </div>
        <a
          href={secondaryToolUrl}
          class="min-h-[38px] px-3.5 py-2 bg-canvas hover:bg-surface-soft border border-hairline rounded-md text-xs font-medium text-link hover:underline inline-flex items-center gap-1.5 shrink-0 self-start sm:self-center whitespace-nowrap transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link focus-visible:ring-offset-2"
        >
          <span>{secondaryTool.cta}</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </section>

    <!-- E-E-A-T Verification & Material Testing Trust Bar -->
    <section id="editorial-trust-bar" class="bg-surface-soft border border-hairline rounded-lg p-5 mb-12 text-xs text-muted leading-relaxed">
      <div class="flex items-start gap-2.5 pb-3 border-b border-hairline">
        <svg class="w-4 h-4 text-success shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
        </svg>
        <div class="min-w-0 flex-1">
          <p class="text-ink font-medium text-[13px] leading-snug">
            {uxCopy.trustHeading}
          </p>
          <div class="mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-[12px]">
            <a href={methodologyUrl} class="text-link hover:underline font-medium">
              {uxCopy.methodologyCta} &rarr;
            </a>
            <span class="text-hairline hidden sm:inline">•</span>
            <a href={contactUrl} class="text-muted hover:text-ink hover:underline">
              {uxCopy.reportCorrection}
            </a>
          </div>
        </div>
      </div>
      <p class="pt-3 text-[12px] text-muted">
        {uxCopy.trustFoot}
      </p>
    </section>

    <!-- Related Materials Cross-Linking -->
    <section class="border-t border-hairline pt-12">
      <h2 class="text-title-md text-ink font-medium tracking-tight mb-6">
        {alsoLikeTitles[lang] || alsoLikeTitles.en}
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
        {relatedMaterials.map(rel => {
          const isDark = rel.styling.includes('text-white');
          return (
            <a 
              href={`/${lang}/material/${rel.id}/`} 
              class={`${rel.styling} border rounded-lg p-6 flex flex-col justify-between min-h-[140px] shadow-sm transition-transform active:scale-[0.98]`}
            >
              <div>
                <h3 class={`text-title-sm font-medium tracking-tight mb-2 ${isDark ? 'text-white' : 'text-ink'}`}>
                  {rel.displayName}
                </h3>
                <p class={`text-[12px] leading-relaxed mb-4 ${isDark ? 'text-white/80' : 'text-muted'}`}>
                  {rel.description.split('.')[0]}.
                </p>
              </div>
              <span class={`text-[12px] font-medium underline underline-offset-4 flex items-center gap-1 ${isDark ? 'text-white' : 'text-link'}`}>
                {compareCtas[lang] || compareCtas.en}
              </span>
            </a>
          );
        })}
      </div>
    </section>
  </article>

  <!-- Accessible Copy-Link Toast -->
  <div
    id="copy-toast"
    role="status"
    aria-live="polite"
    class="fixed bottom-5 right-5 z-50 px-4 py-2.5 rounded-lg bg-surface-dark text-on-dark text-xs font-medium shadow-lg border border-hairline/20 opacity-0 translate-y-2 pointer-events-none transition-all duration-200 no-print"
  ></div>

  <script is:inline>
    (function() {
      var toastTimer = null;
      var btnTimer = null;

      function showToast(message) {
        var toast = document.getElementById('copy-toast');
        if (!toast) return;
        toast.textContent = message;
        toast.classList.remove('opacity-0', 'translate-y-2', 'pointer-events-none');
        toast.classList.add('opacity-100', 'translate-y-0');
        if (toastTimer) clearTimeout(toastTimer);
        toastTimer = setTimeout(function() {
          toast.classList.remove('opacity-100', 'translate-y-0');
          toast.classList.add('opacity-0', 'translate-y-2', 'pointer-events-none');
        }, 2500);
      }

      function fallbackCopy(text) {
        var ta = document.createElement('textarea');
        ta.value = text;
        ta.setAttribute('readonly', '');
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        var ok = false;
        try {
          ok = document.execCommand('copy');
        } catch (e) {}
        document.body.removeChild(ta);
        return ok;
      }

      function initGuideActions() {
        var copyBtn = document.getElementById('copy-link-btn');
        var copyBtnText = document.getElementById('copy-link-btn-text');
        if (copyBtn && copyBtnText) {
          copyBtn.onclick = async function() {
            var url = window.location.href;
            var defaultText = copyBtn.getAttribute('data-default-text') || 'Copy Link';
            var copiedText = copyBtn.getAttribute('data-copied-text') || 'Copied';
            var toastText = copyBtn.getAttribute('data-toast-text') || 'Link copied';
            var copied = false;

            if (navigator.clipboard && navigator.clipboard.writeText) {
              try {
                await navigator.clipboard.writeText(url);
                copied = true;
              } catch (e) {
                copied = fallbackCopy(url);
              }
            } else {
              copied = fallbackCopy(url);
            }

            if (copied) {
              copyBtnText.textContent = '✓ ' + copiedText;
              copyBtn.classList.add('bg-success-bg', 'text-success', 'border-success-border/40');
              showToast(toastText);
              if (btnTimer) clearTimeout(btnTimer);
              btnTimer = setTimeout(function() {
                copyBtnText.textContent = defaultText;
                copyBtn.classList.remove('bg-success-bg', 'text-success', 'border-success-border/40');
              }, 2500);
            }
          };
        }

        var printBtn = document.getElementById('print-guide-btn');
        if (printBtn) {
          printBtn.onclick = function() {
            window.print();
          };
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initGuideActions);
      } else {
        initGuideActions();
      }
      document.addEventListener('astro:page-load', initGuideActions);
    })();
  </script>
</Layout>
