type RecommendedToolKey =
  | 'kitchenFire'
  | 'instantPot'
  | 'slowCooker'
  | 'knifeCare'
  | 'foodAllergy'
  | 'dishwasherDosage'
  | 'induction'
  | 'castIron'
  | 'ovenRack'
  | 'moldyFood'
  | 'pantry'
  | 'fridgeZone'
  | 'oilSmokePoint'
  | 'babyBottle'
  | 'cleaner'
  | 'descaling'
  | 'plastic'
  | 'airfryer'
  | 'microwaveWattage'
  | 'powerOutage'
  | 'leftover'
  | 'thawing'
  | 'cookingTemp'
  | 'ovenTemp'
  | 'symbol';

function selectMaterialToolPair(materialIdRaw: string): { primary: RecommendedToolKey; secondary: RecommendedToolKey } {
  const k = String(materialIdRaw || '').toLowerCase();

  if (/(cast-iron|carbon-steel|enameled-cast)/.test(k)) {
    return { primary: 'castIron', secondary: 'induction' };
  }
  if (/(copper|induction|ferromagnetic)/.test(k)) {
    return { primary: 'induction', secondary: 'ovenTemp' };
  }
  if (/(baby|kids|infant|nursery)/.test(k)) {
    return { primary: 'babyBottle', secondary: 'plastic' };
  }
  if (/(instant-pot|pressure-cooker)/.test(k)) {
    return { primary: 'instantPot', secondary: 'dishwasherDosage' };
  }
  if (/(slow-cooker|crock-pot)/.test(k)) {
    return { primary: 'slowCooker', secondary: 'ovenTemp' };
  }
  if (/(knife|knives|cutting-board|wood-paper|wood|bamboo)/.test(k)) {
    return { primary: 'knifeCare', secondary: 'kitchenFire' };
  }
  if (/(glass-ceramic|glass|pyrex|ceramic|stoneware|porcelain|terracotta)/.test(k)) {
    return { primary: 'ovenRack', secondary: 'ovenTemp' };
  }
  if (/(silicone)/.test(k)) {
    return { primary: 'ovenRack', secondary: 'dishwasherDosage' };
  }
  if (/(plastic|melamine|styrofoam|acrylic|resin|polymer)/.test(k)) {
    return { primary: 'plastic', secondary: 'babyBottle' };
  }
  if (/(metal|stainless|aluminum|non-?stick|enamel)/.test(k)) {
    return { primary: 'ovenTemp', secondary: 'induction' };
  }
  if (/(appliance-components|appliance|coffee|kettle|espresso)/.test(k)) {
    return { primary: 'dishwasherDosage', secondary: 'descaling' };
  }
  if (/(paper|parchment|cardboard|foil|fire)/.test(k)) {
    return { primary: 'kitchenFire', secondary: 'airfryer' };
  }
  if (/(allergen|sponge|toaster)/.test(k)) {
    return { primary: 'foodAllergy', secondary: 'cleaner' };
  }
  if (/(oil|grease|fat|butter)/.test(k)) {
    return { primary: 'oilSmokePoint', secondary: 'kitchenFire' };
  }
  if (/(mold|mould)/.test(k)) {
    return { primary: 'moldyFood', secondary: 'leftover' };
  }
  if (/(pantry|canned|dry-goods|spice)/.test(k)) {
    return { primary: 'pantry', secondary: 'fridgeZone' };
  }
  if (/(fridge|refrigerator|produce)/.test(k)) {
    return { primary: 'fridgeZone', secondary: 'powerOutage' };
  }
  if (/(freezer|frozen|thaw)/.test(k)) {
    return { primary: 'thawing', secondary: 'powerOutage' };
  }
  if (/(meat|poultry|seafood|protein)/.test(k)) {
    return { primary: 'cookingTemp', secondary: 'thawing' };
  }
  if (/(leftover)/.test(k)) {
    return { primary: 'leftover', secondary: 'microwaveWattage' };
  }
  if (/(air-?fryer)/.test(k)) {
    return { primary: 'airfryer', secondary: 'ovenRack' };
  }
  if (/(microwave)/.test(k)) {
    return { primary: 'microwaveWattage', secondary: 'symbol' };
  }
  if (/(fabric|footwear|textile|laundry|cleaner)/.test(k)) {
    return { primary: 'symbol', secondary: 'cleaner' };
  }
  return { primary: 'symbol', secondary: 'ovenTemp' };
}

