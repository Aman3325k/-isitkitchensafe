---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TechnicalSpecs from '../../components/TechnicalSpecs.astro';
import whatHappensData from '../../data/what-happens.json';
import { generateWhatHappensMetaDescription } from '../../utils/seoHelper.js';
import { resolveAllGuidesForItem, getPeopleAlsoAsk, getRelatedCategoriesForItem } from '../../utils/linkingHelper.js';
import { getCategoryForMaterial } from '../../utils/materialCategories';
import whatHappensNoindex from '../../data/whatHappensNoindex.json';
import { getDirectoryUrl, useTranslatedPath } from '../../i18n/utils';

export function getStaticPaths() {
  return whatHappensData
    .map((item) => {
      return {
        params: {
          scenario: item.slug
        },
        props: {
          data: item
        }
      };
    });
}

interface Props {
  data: typeof whatHappensData[number];
}

const { data } = Astro.props;

function formatSlugAction(slug: string) {
  if (slug === 'boil-dry-pot') return 'Boil a Pot Dry';
  
  const actionOverrides: Record<string, string> = {
    'leave-fridge-door-open': 'Leave the Fridge Door Open',
    'leave-freezer-door-open': 'Leave the Freezer Door Open',
    'leave-oven-on-overnight': 'Leave the Oven on Overnight',
    'leave-gas-stove-on': 'Leave the Gas Stove On',
    'leave-electric-stove-on': 'Leave the Electric Stove On',
    'leave-food-in-oven-overnight': 'Leave Food in the Oven Overnight',
    'leave-rice-out-overnight': 'Leave Rice out Overnight',
    'run-dishwasher-empty': 'Run the Dishwasher Empty',
    'run-dishwasher-without-detergent': 'Run the Dishwasher Without Detergent',
    'use-dish-soap-in-dishwasher': 'Use Dish Soap in the Dishwasher',
    'use-aluminum-foil-on-oven-bottom': 'Use Aluminum Foil on the Oven Bottom',
    'put-cold-glass-on-hot-stove': 'Put Cold Glass on a Hot Stove',
    'put-hot-glass-dish-on-cold-counter': 'Put a Hot Glass Dish on a Cold Counter',
    'put-hot-pan-in-cold-water': 'Put a Hot Pan in Cold Water',
    'put-cold-dish-in-hot-oven': 'Put a Cold Dish in a Hot Oven',
    'microwave-water-too-long': 'Microwave Water Too Long',
    'microwave-nothing': 'Microwave Nothing',
    'microwave-frozen-meat-wrong': 'Microwave Frozen Meat Wrong',
    'freeze-cooked-rice-wrong': 'Freeze Cooked Rice Wrong',
    'freeze-bread-wrong': 'Freeze Bread Wrong',
    'freeze-hot-food': 'Freeze Hot Food',
    'refreeze-thawed-chicken': 'Refreeze Thawed Chicken',
    'preheat-oven-too-long': 'Preheat the Oven Too Long',
    'open-oven-too-often': 'Open the Oven Too Often',
    'keep-freezer-too-full': 'Keep the Freezer Too Full',
    'keep-freezer-too-empty': 'Keep the Freezer Too Empty',
    'put-too-much-detergent': 'Put Too Much Detergent in the Dishwasher',
    'mix-bleach-and-vinegar': 'Mix Bleach and Vinegar',
    'mix-bleach-and-ammonia': 'Mix Bleach and Ammonia',
    'eat-food-after-power-outage': 'Eat Food After a Power Outage',
    'eat-food-left-out-overnight': 'Eat Food Left Out Overnight',
    'drink-from-damaged-can': 'Drink from a Damaged Can'
  };

  if (actionOverrides[slug]) return actionOverrides[slug];
  return slug.split('-').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');
}

// Helper to parse slug into item and appliance to strictly satisfy H1 rules
function parseScenario(slug: string) {
  let item = "";
  let appliance = "";
  let isAction = false;
  
  if (slug === 'microwave-cd') {
    appliance = 'Microwave';
    item = 'a CD';
  } else if (slug === 'microwave-egg-in-shell') {
    appliance = 'Microwave';
    item = 'an Egg in Its Shell';
  } else if (slug === 'microwave-tupperware-unmarked') {
    appliance = 'Microwave';
    item = 'Unmarked Tupperware';
  } else if (slug === 'microwave-paper-bag') {
    appliance = 'Microwave';
    item = 'a Paper Bag';
  } else if (slug === 'put-paper-bag-in-oven') {
    appliance = 'Oven';
    item = 'a Paper Bag';
  } else if (slug === 'microwave-sealed-container') {
    appliance = 'Microwave';
    item = 'a Sealed Container';
  } else if (slug === 'microwave-travel-mug') {
    appliance = 'Microwave';
    item = 'a Travel Mug';
  } else if (slug.startsWith("microwave-")) {
    if (slug === "microwave-nothing" || slug === "microwave-water-too-long" || slug === "microwave-frozen-meat-wrong") {
      isAction = true;
      appliance = "Kitchen";
    } else {
      appliance = "Microwave";
      item = slug.replace("microwave-", "").replace(/-/g, " ");
    }
  } else if (slug.startsWith("put-") && slug.includes("-in-dishwasher")) {
    if (slug === "put-too-much-detergent") {
      isAction = true;
      appliance = "Kitchen";
    } else {
      appliance = "Dishwasher";
      item = slug.replace("put-", "").replace("-in-dishwasher", "").replace(/-/g, " ");
    }
  } else if (slug.endsWith("-in-dishwasher")) {
    if (slug === "use-dish-soap-in-dishwasher" || slug.startsWith("run-dishwasher-")) {
      isAction = true;
      appliance = "Kitchen";
    } else {
      appliance = "Dishwasher";
      item = slug.replace("-in-dishwasher", "").replace(/-/g, " ");
    }
  } else if (slug.startsWith("run-dishwasher-")) {
    isAction = true;
    appliance = "Kitchen";
  } else if (slug.startsWith("refreeze-")) {
    isAction = true;
    appliance = "Kitchen";
  } else if (slug.startsWith("freeze-")) {
    if (slug === "freeze-hot-food" || slug === "freeze-cooked-rice-wrong" || slug === "freeze-bread-wrong") {
      isAction = true;
      appliance = "Kitchen";
    } else {
      appliance = "Freezer";
      item = slug.replace("freeze-", "").replace(/-/g, " ");
    }
  } else if (slug.startsWith("leave-freezer-")) {
    isAction = true;
    appliance = "Kitchen";
  } else if (slug.startsWith("put-") && slug.includes("-in-oven")) {
    if (slug === "put-cold-dish-in-hot-oven") {
      isAction = true;
      appliance = "Kitchen";
    } else {
      appliance = "Oven";
      item = slug.replace("put-", "").replace("-in-oven", "").replace(/-/g, " ");
    }
  } else if (slug.endsWith("-in-oven")) {
    appliance = "Oven";
    item = slug.replace("-in-oven", "").replace(/-/g, " ");
  } else if (slug.startsWith("leave-oven-")) {
    isAction = true;
    appliance = "Kitchen";
  } else if (slug.startsWith("use-") && slug.includes("-on-oven-bottom")) {
    isAction = true;
    appliance = "Kitchen";
  } else if (slug.startsWith("leave-gas-stove-") || slug.startsWith("leave-electric-stove-")) {
    isAction = true;
    appliance = "Kitchen";
  } else if (slug.startsWith("boil-dry-")) {
    isAction = true;
    appliance = "Kitchen";
  } else if (slug.includes("-on-hot-stove") || slug.includes("-on-cold-counter") || slug.includes("-in-cold-water")) {
    isAction = true;
    appliance = "Kitchen";
  } else if (slug.startsWith("mix-")) {
    isAction = true;
    appliance = "Kitchen";
  } else if (slug.startsWith("eat-") || slug.startsWith("drink-")) {
    isAction = true;
    appliance = "Kitchen";
  } else if (slug.startsWith("leave-fridge-")) {
    isAction = true;
    appliance = "Kitchen";
  } else if (slug.startsWith("keep-freezer-") || slug.startsWith("open-oven-") || slug.startsWith("preheat-oven-") || slug.startsWith("cross-contaminate-") || slug.startsWith("leave-rice-")) {
    isAction = true;
    appliance = "Kitchen";
  } else {
    isAction = true;
    appliance = "Kitchen";
    item = slug.replace(/-/g, " ");
  }

  if (item && !item.includes(' ')) {
    item = item.charAt(0).toUpperCase() + item.slice(1);
  } else if (item && !['a CD', 'an Egg in Its Shell', 'Unmarked Tupperware', 'a Paper Bag', 'a Sealed Container', 'a Travel Mug'].includes(item)) {
    item = item.split(' ').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');
  }
  return { item, appliance, isAction };
}

const { item, appliance, isAction } = parseScenario(data.slug);
const isKitchenFallback = appliance === "Kitchen" || isAction;
const slugAction = formatSlugAction(data.slug);

// Map danger levels to YES/NO/DEPENDS badge rules for H1 compatibility
// e.g. safe = YES, caution = DEPENDS, dangerous = NO
const mappedSafe = data.dangerLevel === 'safe' ? 'yes' : data.dangerLevel === 'caution' ? 'depends' : 'no';

const pageTitle = isKitchenFallback
  ? `What Happens If You ${slugAction}? | IsItKitchenSafe`
  : `What Happens If You Put ${item} in the ${appliance}? | IsItKitchenSafe`;

const pageH1 = isKitchenFallback
  ? `What Happens If You ${slugAction}?`
  : `Can You Put ${item} in the ${appliance}?`;

const pageDescription = isKitchenFallback
  ? `What happens if you ${slugAction.toLowerCase()}? Learn the danger levels. ${data.shortAnswer}`
  : generateWhatHappensMetaDescription(item, appliance, data.shortAnswer);

// Get related items
let relatedItems = whatHappensData.filter(i => data.relatedItems.includes(i.slug) && i.slug !== data.slug);
if (relatedItems.length < 5) {
  const sameDangerItems = whatHappensData.filter(i => i.dangerLevel === data.dangerLevel && i.slug !== data.slug && !data.relatedItems.includes(i.slug));
  const existingSlugs = new Set(relatedItems.map(i => i.slug));
  for (const item of sameDangerItems) {
    if (relatedItems.length >= 5) break;
    if (!existingSlugs.has(item.slug)) {
      relatedItems.push(item);
      existingSlugs.add(item.slug);
    }
  }
}
if (relatedItems.length < 5) {
  const anyItems = whatHappensData.filter(i => i.slug !== data.slug && !relatedItems.some(ri => ri.slug === i.slug));
  for (const item of anyItems) {
    if (relatedItems.length >= 5) break;
    relatedItems.push(item);
  }
}
relatedItems = relatedItems.slice(0, 5);

const allGuides = resolveAllGuidesForItem(item, data.slug);
const currentPath = `/what-happens/${data.slug}/`;
const paaList = getPeopleAlsoAsk(item, data.slug, allGuides, data.relatedItems);
const relatedCategories = getRelatedCategoriesForItem(item, data.slug, currentPath, allGuides);

// Danger details variables
const dangerValue = data.dangerLevel === 'dangerous' ? 9 : data.dangerLevel === 'caution' ? 5 : 1;
const dangerBarColor = data.dangerLevel === 'dangerous' ? 'bg-error-border' : data.dangerLevel === 'caution' ? 'bg-warning-border' : 'bg-success-border';
const dangerWidthClass = data.dangerLevel === 'dangerous' ? 'w-[90%]' : data.dangerLevel === 'caution' ? 'w-[50%]' : 'w-[20%]';
const dangerTextColor = data.dangerLevel === 'dangerous' ? 'text-error' : data.dangerLevel === 'caution' ? 'text-warning' : 'text-success';

// Generic FAQ detection (read dynamically from data, not hardcoded)
const genericDryPaperAnswer = whatHappensData
  .flatMap(d => d.faqs || [])
  .find(f => f.answer && f.answer.includes("dry paper in the oven"))
  ?.answer;

const hasGenericFaq = Boolean(
  genericDryPaperAnswer && data.faqs?.some(f => f.answer === genericDryPaperAnswer)
);

const isNoindex = whatHappensNoindex.includes(data.slug);


const speakableSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": [".quick-answer", ".short-answer", "h1"]
  }
};

const howToSchema = (mappedSafe === 'yes' || mappedSafe === 'depends') ? {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": `How to safely use ${item} in the ${appliance}`,
  "description": data.shortAnswer,
  "step": data.prevention.map((tip, idx) => ({
    "@type": "HowToStep",
    "position": idx + 1,
    "text": tip
  }))
} : null;

// E-E-A-T links & Smart Contextual Consumer Calculator CTA
const translatePath = useTranslatedPath('en');
const methodologyUrl = getDirectoryUrl('methodology', 'en');
const contactUrl = getDirectoryUrl('contact', 'en');

const scenarioMatchText = `${data.slug} ${appliance} ${data.item || ''}`.toLowerCase();

function getRecommendedScenarioTool(text: string) {
  if (/(bleach|vinegar|ammonia|cleaner|soap)/i.test(text)) {
    return {
      path: '/tools/cleaner-mixing-danger-checker/',
      icon: '🧪',
      title: 'Household Cleaner Mixing Danger Checker',
      description: 'Check any two kitchen cleaning agents before mixing to spot toxic chlorine, chloramine, or corrosive gas hazards instantly.',
      cta: 'Check Cleaner Safety'
    };
  }
  if (/(coffee|kettle|descale|espresso)/i.test(text)) {
    return {
      path: '/tools/appliance-descaling-calculator/',
      icon: '☕',
      title: 'Coffee Maker & Kettle Descaling Ratio Calculator',
      description: 'Calculate safe citric acid or vinegar-to-water descaling ratios and rinse cycles tailored to your appliance.',
      cta: 'Calculate Descaling Ratio'
    };
  }
  if (/(plastic|styrofoam|tupperware|melamine|pvc)/i.test(text)) {
    return {
      path: '/tools/plastic-code-checker/',
      icon: '♻️',
      title: 'Plastic Recycling Code (#1–#7) Heat & Food Safety Checker',
      description: 'Decode the resin number stamped on containers to verify microwave, dishwasher, and freezer heat safety.',
      cta: 'Check Plastic Code'
    };
  }
  if (/(air-?fryer)/i.test(text)) {
    return {
      path: '/tools/air-fryer-oven-converter/',
      icon: '🔥',
      title: 'Air Fryer to Oven Time & Temperature Converter',
      description: 'Convert conventional oven temperatures and cooking times for air fryers safely without scorching or undercooking.',
      cta: 'Convert Air Fryer Temp'
    };
  }
  if (/(microwave)/i.test(text)) {
    return {
      path: '/tools/microwave-wattage-converter/',
      icon: '📡',
      title: 'Microwave Wattage & Reheating Time Converter',
      description: 'Adjust package heating times to your microwave wattage so food heats evenly without overheating containers or causing steam explosions.',
      cta: 'Convert Wattage Time'
    };
  }
  if (/(power-outage|freezer|freeze|thaw|frozen)/i.test(text)) {
    return {
      path: '/tools/power-outage-food-safety-checker/',
      icon: '⚡',
      title: 'Fridge & Freezer Power Outage Food Safety Checker',
      description: 'Check USDA and CDC guidance on whether chilled or frozen foods are safe to keep, refreeze, cook, or discard.',
      cta: 'Check Freezer Safety'
    };
  }
  if (/(leftover|fridge|refrigerator|spoil|expired|moldy|left-out-overnight|rice-out-overnight|food-in-oven-overnight|sprouted-potatoes|damaged-can)/i.test(text)) {
    return {
      path: '/tools/leftover-shelf-life-calculator/',
      icon: '🗓️',
      title: 'USDA Leftover & Fridge Shelf-Life Countdown Calculator',
      description: 'Calculate exact USDA refrigerator and freezer eat-by dates to keep leftovers out of the bacterial Danger Zone.',
      cta: 'Calculate Eat-By Date'
    };
  }
  if (/(oven|cast-iron|pyrex|non-?stick|pan|glass)/i.test(text)) {
    return {
      path: '/tools/cookware-oven-temp-lookup/',
      icon: '🍳',
      title: 'Cookware Maximum Oven Temperature Lookup',
      description: 'Look up verified oven, broiler, and lid temperature limits for cast iron, Pyrex glass, nonstick, and metal cookware.',
      cta: 'Check Oven Temp Limit'
    };
  }
  return {
    path: '/tools/kitchen-symbol-decoder/',
    icon: '🔍',
    title: 'Kitchen & Cookware Safety Symbol Decoder',
    description: 'Identify dishwasher-safe, microwave-safe, freezer-safe, and oven-safe icons stamped on kitchenware and food containers.',
    cta: 'Decode Safety Symbols'
  };
}

const recommendedTool = getRecommendedScenarioTool(scenarioMatchText);
const recommendedToolUrl = translatePath(recommendedTool.path);
---

<Layout 
  title={pageTitle} 
  description={pageDescription} 
  faqs={data.faqs} 
  excludeFaqSchema={hasGenericFaq}
  noindex={isNoindex}
  availableLocales={['en', 'es', 'pt', 'ja', 'zh-cn']}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(speakableSchema)} />
    {howToSchema && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
    )}
  </Fragment>
  <article class="max-w-[800px] mx-auto px-6 py-[48px] md:py-[64px]">
    <!-- Breadcrumbs -->
    <Breadcrumbs 
      items={[
        { label: 'Home', href: '/' },
        { label: 'What Happens If', href: '/what-happens/' },
        { label: data.item }
      ]}
    />

    <!-- Header Section -->
    <header class="mb-10 text-center md:text-left">
      <div class="flex flex-wrap items-center justify-center md:justify-start gap-2.5 mb-3">
        <span class="text-caption text-muted uppercase tracking-wider text-xs">Accident Prevention Guide</span>
        <span class="text-hairline hidden sm:inline">•</span>
        <a
          href={methodologyUrl}
          class="inline-flex items-center gap-1 text-success font-medium bg-success-bg border border-success-border/30 px-2.5 py-0.5 rounded-full text-xs hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link focus-visible:ring-offset-2"
        >
          ✓ USDA FSIS / FDA 21 CFR &amp; NSF Verified
        </a>
      </div>
      
      <h1 class="text-display-md md:text-display-lg font-medium text-ink tracking-tight mb-6 leading-tight">
        {pageH1}
      </h1>

      <!-- Safety Verdict Badge -->
      <div class="flex flex-wrap items-center justify-center md:justify-start gap-3">
        {mappedSafe === 'yes' && (
          <div class="badge-yes quick-answer px-6 py-2 text-sm">
            <span class="mr-1.5">✓</span> YES (SAFE)
          </div>
        )}
        {mappedSafe === 'no' && (
          <div class="badge-no quick-answer px-6 py-2 text-sm">
            <span class="mr-1.5">✗</span> NO (DANGEROUS)
          </div>
        )}
        {mappedSafe === 'depends' && (
          <div class="badge-depends quick-answer px-6 py-2 text-sm">
            <span class="mr-1.5">⚠</span> DEPENDS (CAUTION)
          </div>
        )}
      </div>

      <!-- Quick-Share & Print Action Bar -->
      <div class="mt-5 flex flex-wrap items-center justify-center md:justify-start gap-2.5 no-print">
        <button
          id="copy-link-btn"
          type="button"
          aria-label="Copy link to this kitchen safety scenario guide"
          data-default-text="Copy Link"
          data-copied-text="Link Copied"
          data-toast-text="Safety scenario guide link copied to clipboard"
          class="min-h-[40px] px-3.5 py-2 bg-canvas hover:bg-surface-soft active:scale-[0.98] text-ink border border-hairline rounded-md text-xs font-medium inline-flex items-center gap-2 shadow-xs transition-all cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link focus-visible:ring-offset-2"
        >
          <svg class="w-4 h-4 text-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
          </svg>
          <span id="copy-link-btn-text">Copy Link</span>
        </button>

        <button
          id="print-guide-btn"
          type="button"
          aria-label="Print this kitchen safety scenario guide"
          class="min-h-[40px] px-3.5 py-2 bg-canvas hover:bg-surface-soft active:scale-[0.98] text-ink border border-hairline rounded-md text-xs font-medium inline-flex items-center gap-2 shadow-xs transition-all cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link focus-visible:ring-offset-2"
        >
          <svg class="w-4 h-4 text-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4H7v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
          </svg>
          <span>Print Guide</span>
        </button>
      </div>
    </header>

    <!-- Danger Level Meter Box -->
    <section class="mb-12">
      <div class="bg-surface-soft border border-hairline rounded-md p-6">
        <div class="flex justify-between items-center mb-3">
          <h2 class="text-title-sm text-ink font-medium">⚠️ Danger Level Indicator</h2>
          <span class={`font-bold text-[14px] uppercase ${dangerTextColor}`}>
            {data.dangerLevel === 'dangerous' ? 'DANGEROUS' : data.dangerLevel === 'caution' ? 'CAUTION' : 'SAFE'}
          </span>
        </div>
        
        <!-- Meter Bar -->
        <div class="w-full bg-surface-strong h-4 rounded-full overflow-hidden mb-3">
          <div class={`h-full ${dangerBarColor} ${dangerWidthClass}`}></div>
        </div>
        <div class="flex justify-between text-xs text-muted">
          <span>Level 1 (Safe)</span>
          <span>Level {dangerValue} of 10</span>
          <span>Level 10 (Critical)</span>
        </div>
      </div>
    </section>

    <!-- Detailed Explanation -->
    <section class="mb-12">
      <div class="p-8 rounded-lg bg-surface-soft border border-hairline">
        <h2 class="text-title-sm text-ink font-medium mb-3">
          {isKitchenFallback ? `What Happens If You ${slugAction}?` : `What Happens If You Put ${item} in the ${appliance}?`}
        </h2>
        <p class="short-answer text-title-md font-bold leading-relaxed text-ink mb-4">
          {data.shortAnswer}
        </p>
        {data.material ? (
          <div>
            <div class="border-t border-hairline my-4 opacity-50"></div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 my-6">
              <div class="bg-canvas border border-hairline rounded-md p-4 shadow-xs">
                <span class="text-caption text-muted uppercase tracking-wider text-[11px] block mb-1">Material Composition</span>
                {(() => {
                  const catSlug = getCategoryForMaterial(data.material);
                  return catSlug ? (
                    <a href={`/material/${catSlug}/`} class="text-link hover:underline font-semibold text-[15px]">
                      {data.material}
                    </a>
                  ) : (
                    <strong class="text-ink text-[15px] font-semibold">{data.material}</strong>
                  );
                })()}
              </div>
              <div class="bg-canvas border border-hairline rounded-md p-4 shadow-xs">
                <span class="text-caption text-muted uppercase tracking-wider text-[11px] block mb-1">Primary Safety Risk</span>
                <strong class="text-signature-coral text-[15px] font-semibold">{data.keyRisk || ((data as any).warnings && (data as any).warnings[0]) || (data as any).specific_warning}</strong>
              </div>
              <div class="bg-canvas border border-hairline rounded-md p-4 shadow-xs">
                <span class="text-caption text-muted uppercase tracking-wider text-[11px] block mb-1">Safety Instruction</span>
                <strong class="text-success text-[15px] font-semibold">{data.tip || ((data as any).tips && (data as any).tips[0]) || ((data as any).instructions && (data as any).instructions[0])}</strong>
              </div>
            </div>
            <div class="border-t border-hairline my-4 opacity-50"></div>
            <details class="group py-2">
              <summary class="flex items-center justify-between text-body-md text-ink font-medium cursor-pointer list-none [&::-webkit-details-marker]:hidden select-none">
                <span>Read Detailed Safety Breakdown</span>
                <span class="text-muted group-open:rotate-180 transition-transform duration-200">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </span>
              </summary>
              <div class="mt-4 text-body-md text-body leading-relaxed pl-1">
                <p class="mb-4 font-medium">{data.learnMore}</p>
                {data.reason.split('\n\n').map(para => (
                  <p class="mb-4 last:mb-0">
                    {para}
                  </p>
                ))}
              </div>
            </details>
          </div>
        ) : (
          <div>
            <div class="border-t border-hairline my-4 opacity-50"></div>
            <h3 class="text-caption text-muted mb-2 font-semibold uppercase tracking-wider text-xs">Full Scenario Breakdown</h3>
            {data.reason.split('\n\n').map(para => (
              <p class="text-body-md text-body leading-relaxed mb-4 last:mb-0">
                {para}
              </p>
            ))}
          </div>
        )}
      </div>
    </section>

    <!-- Technical & Safety Specifications -->
    <TechnicalSpecs specs={(data as any).technicalSpecs} />

    <!-- Health Impact Box -->
    <section class="mb-12">
      <div class="bg-error-bg border border-error-bg rounded-md p-6 text-signature-coral">
        <h3 class="text-title-sm font-semibold mb-2">🩺 Health & Hazard Impacts</h3>
        <p class="text-body-md leading-relaxed text-signature-coral">
          {data.healthImpact}
        </p>
      </div>
    </section>

    <!-- Actions and Prevention -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
      <!-- Immediate Actions -->
      <div class="bg-surface-soft rounded-md p-6 border border-hairline/50">
        <h2 class="text-title-sm text-ink font-medium mb-4 flex items-center gap-2">
          🚨 Immediate Action Steps
        </h2>
        <ul class="flex flex-col gap-3">
          {data.actions.map(act => (
            <li class="text-body-md text-body flex gap-2.5 items-start leading-relaxed">
              <span class="text-signature-coral font-bold mt-0.5">⚠</span>
              <span>{act}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Prevention Tips -->
      <div class="bg-surface-soft rounded-md p-6 border border-hairline/50">
        <h2 class="text-title-sm text-ink font-medium mb-4 flex items-center gap-2">
          ✅ Prevention & Safety Rules
        </h2>
        <ul class="flex flex-col gap-3">
          {data.prevention.map(prev => (
            <li class="text-body-md text-body flex gap-2.5 items-start leading-relaxed">
              <span class="text-success font-bold mt-0.5">✓</span>
              <span>{prev}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Smart Contextual Consumer Calculator CTA Card -->
    <section id="recommended-tool-card" class="bg-surface-soft border border-hairline rounded-lg p-5 sm:p-6 shadow-xs mb-8 no-print">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="min-w-0 flex-1">
          <div class="flex flex-wrap items-center gap-2 mb-1.5">
            <span class="text-base" aria-hidden="true">{recommendedTool.icon}</span>
            <span class="text-[11px] font-semibold uppercase tracking-wider text-signature-coral">Interactive Safety Calculator</span>
          </div>
          <h2 class="text-title-sm text-ink font-semibold mb-1.5 leading-snug">
            {recommendedTool.title}
          </h2>
          <p class="text-[13px] text-body leading-relaxed">
            {recommendedTool.description}
          </p>
        </div>
        <div class="shrink-0">
          <a
            href={recommendedToolUrl}
            class="min-h-[42px] px-4 py-2.5 bg-primary hover:bg-primary-active active:scale-[0.98] text-on-primary rounded-md text-xs font-medium inline-flex items-center gap-1.5 transition-all whitespace-nowrap focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link focus-visible:ring-offset-2"
          >
            <span>{recommendedTool.cta}</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </section>

    <!-- E-E-A-T Verification & Standards Trust Bar -->
    <section id="editorial-trust-bar" class="bg-surface-soft border border-hairline rounded-lg p-5 mb-12 text-xs text-muted leading-relaxed">
      <div class="flex items-start gap-2.5 pb-3 border-b border-hairline">
        <svg class="w-4 h-4 text-success shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
        </svg>
        <div class="min-w-0 flex-1">
          <p class="text-ink font-medium text-[13px] leading-snug">
            Verified against USDA FSIS, FDA 21 CFR &amp; NSF kitchen safety standards
          </p>
          <div class="mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-[12px]">
            <a href={methodologyUrl} class="text-link hover:underline font-medium">
              Read Safety Methodology &rarr;
            </a>
            <span class="text-hairline hidden sm:inline">•</span>
            <a href={contactUrl} class="text-muted hover:text-ink hover:underline">
              Report a correction
            </a>
          </div>
        </div>
      </div>
      <p class="pt-3 text-[12px] text-muted">
        Hazard assessments, emergency steps, and prevention rules are cross-checked against USDA FSIS food-safety guidelines, FDA 21 CFR food-contact regulations, NSF sanitation standards, and appliance manufacturer manuals.
      </p>
    </section>

    <!-- FAQ Section -->
    {!hasGenericFaq && data.faqs && data.faqs.length > 0 && (
      <section class="border-t border-hairline pt-12 mb-16">
        <h2 class="text-title-lg text-ink font-medium tracking-tight mb-8">Frequently Asked Questions</h2>
        <div class="flex flex-col">
          {data.faqs.map(faq => (
            <details class="group border-b border-hairline py-5">
              <summary class="flex items-center justify-between text-title-sm text-ink font-medium cursor-pointer list-none [&::-webkit-details-marker]:hidden select-none">
                <span>{faq.question}</span>
                <span class="text-muted group-open:rotate-180 transition-transform duration-200">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </span>
              </summary>
              <div class="mt-4 text-body-md text-body leading-relaxed pl-1">
                {faq.answer}
              </div>
            </details>
          ))}
        </div>
      </section>
    )}

    <!-- Direct Cross-linking Guides Box -->
    {(allGuides.applianceGuides.length > 0 || allGuides.howLongGuides.length > 0 || allGuides.refreezeGuides.length > 0 || allGuides.comparisonGuides.length > 0) && (
      <section class="mb-12 border-t border-hairline pt-12">
        <h2 class="text-title-lg text-ink font-medium tracking-tight mb-6">Cross-Reference Safety Guides for {item}</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {allGuides.applianceGuides.map(g => (
            <a href={g.url} class="p-4 bg-canvas border border-hairline rounded-md hover:border-border-strong text-body-md text-link flex justify-between items-center gap-3 transition-colors shadow-xs">
              <span class="font-medium min-w-0 flex-1 break-words">🔌 Appliance: {g.appliance.toUpperCase()}</span>
              <span class="text-xs text-muted shrink-0 whitespace-nowrap">Read guide &rarr;</span>
            </a>
          ))}
          {allGuides.howLongGuides.map(g => (
            <a href={g.url} class="p-4 bg-canvas border border-hairline rounded-md hover:border-border-strong text-body-md text-link flex justify-between items-center gap-3 transition-colors shadow-xs">
              <span class="font-medium min-w-0 flex-1 break-words">⏱ Shelf Life: {g.duration}</span>
              <span class="text-xs text-muted shrink-0 whitespace-nowrap">Read guide &rarr;</span>
            </a>
          ))}
          {allGuides.refreezeGuides.map(g => (
            <a href={g.url} class="p-4 bg-canvas border border-hairline rounded-md hover:border-border-strong text-body-md text-link flex justify-between items-center gap-3 transition-colors shadow-xs">
              <span class="font-medium min-w-0 flex-1 break-words">❄️ Refreezing Safety Rules</span>
              <span class="text-xs text-muted shrink-0 whitespace-nowrap">Read guide &rarr;</span>
            </a>
          ))}
          {allGuides.comparisonGuides.map(g => (
            <a href={g.url} class="p-4 bg-canvas border border-hairline rounded-md hover:border-border-strong text-body-md text-link flex justify-between items-center gap-3 transition-colors shadow-xs">
              <span class="font-medium min-w-0 flex-1 break-words">⚔️ Comparison: {g.item1} vs {g.item2}</span>
              <span class="text-xs text-muted shrink-0 whitespace-nowrap">Compare &rarr;</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- People Also Ask Section -->
    <section class="border-t border-hairline pt-12 mb-16">
      <h2 class="text-title-lg text-ink font-medium tracking-tight mb-8">People Also Ask</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {paaList.map(paa => (
          <a 
            href={paa.url} 
            class="bg-canvas border border-hairline hover:border-border-strong rounded-md p-5 flex flex-col justify-between shadow-xs transition-colors active:scale-[0.98]"
          >
            <div>
              <span class="text-[11px] text-muted uppercase tracking-wider block mb-2">Related Question</span>
              <h3 class="text-title-sm text-ink mb-2 leading-snug">
                {paa.question}
              </h3>
            </div>
            <span class="text-[12px] font-medium text-link mt-4 block">View Answer &rarr;</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Related Items -->
    <section class="border-t border-hairline pt-12 mb-16">
      <h2 class="text-title-lg text-ink font-medium tracking-tight mb-8">Related Accident Prevention Guides</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {relatedItems.map(item => {
          const parsed = parseScenario(item.slug);
          return (
            <a 
              href={`/what-happens/${item.slug}/`} 
              class="bg-canvas border border-hairline hover:border-border-strong rounded-md p-5 flex flex-col justify-between shadow-xs transition-colors active:scale-[0.98]"
            >
              <div>
                <div class="flex items-center justify-between mb-3">
                  <span class="text-[11px] text-muted uppercase tracking-wider">{parsed.appliance}</span>
                  <span class="badge-no text-[10px] px-2 py-0.5">{item.dangerLevel}</span>
                </div>
                <h3 class="text-title-sm text-ink mb-1">
                  {item.item}
                </h3>
                <p class="text-[13px] text-muted line-clamp-2 leading-relaxed">
                  {item.shortAnswer}
                </p>
              </div>
              <span class="text-[12px] font-medium text-link mt-4 block">Read guide &rarr;</span>
            </a>
          );
        })}
      </div>
    </section>

    <!-- Related Categories Section -->
    {relatedCategories.length > 0 && (
      <section class="border-t border-hairline pt-12 mb-12">
        <h2 class="text-title-lg text-ink font-medium tracking-tight mb-6 font-display">Explore Related Safety Categories</h2>
        <div class="flex flex-wrap gap-3">
          {relatedCategories.map(cat => (
            <a 
              href={cat.url}
              class="px-4 py-2 bg-surface-soft border border-hairline rounded-full text-[13px] font-medium text-ink hover:border-border-strong transition-colors"
            >
              {cat.name} &rarr;
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Back Link -->
    <div class="mt-12 pt-8 border-t border-hairline text-center">
      <a 
        href="/what-happens/" 
        class="text-link text-[14px] font-medium hover:text-link-active transition-colors min-h-[44px] inline-flex items-center gap-1.5 active:scale-[0.98] transition-transform py-2.5 px-4 rounded-md hover:bg-surface-soft"
      >
        &larr; Back to all Safety Scenarios
      </a>
    </div>
  </article>

  <!-- Accessible Copy-Link Toast -->
  <div
    id="copy-toast"
    role="status"
    aria-live="polite"
    class="fixed bottom-5 right-5 z-50 px-4 py-2.5 rounded-lg bg-surface-dark text-on-dark text-xs font-medium shadow-lg border border-hairline/20 opacity-0 translate-y-2 pointer-events-none transition-all duration-200 no-print"
  ></div>

  <script is:inline>
    (function() {
      var toastTimer = null;
      var btnTimer = null;

      function showToast(message) {
        var toast = document.getElementById('copy-toast');
        if (!toast) return;
        toast.textContent = message;
        toast.classList.remove('opacity-0', 'translate-y-2', 'pointer-events-none');
        toast.classList.add('opacity-100', 'translate-y-0');
        if (toastTimer) clearTimeout(toastTimer);
        toastTimer = setTimeout(function() {
          toast.classList.remove('opacity-100', 'translate-y-0');
          toast.classList.add('opacity-0', 'translate-y-2', 'pointer-events-none');
        }, 2500);
      }

      function fallbackCopy(text) {
        var ta = document.createElement('textarea');
        ta.value = text;
        ta.setAttribute('readonly', '');
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        var ok = false;
        try {
          ok = document.execCommand('copy');
        } catch (e) {}
        document.body.removeChild(ta);
        return ok;
      }

      function initGuideActions() {
        var copyBtn = document.getElementById('copy-link-btn');
        var copyBtnText = document.getElementById('copy-link-btn-text');
        if (copyBtn && copyBtnText) {
          copyBtn.onclick = async function() {
            var url = window.location.href;
            var defaultText = copyBtn.getAttribute('data-default-text') || 'Copy Link';
            var copiedText = copyBtn.getAttribute('data-copied-text') || 'Link Copied';
            var toastText = copyBtn.getAttribute('data-toast-text') || 'Link copied to clipboard';
            var copied = false;

            if (navigator.clipboard && navigator.clipboard.writeText) {
              try {
                await navigator.clipboard.writeText(url);
                copied = true;
              } catch (e) {
                copied = fallbackCopy(url);
              }
            } else {
              copied = fallbackCopy(url);
            }

            if (copied) {
              copyBtnText.textContent = '✓ ' + copiedText;
              copyBtn.classList.add('bg-success-bg', 'text-success', 'border-success-border/40');
              showToast(toastText);
              if (btnTimer) clearTimeout(btnTimer);
              btnTimer = setTimeout(function() {
                copyBtnText.textContent = defaultText;
                copyBtn.classList.remove('bg-success-bg', 'text-success', 'border-success-border/40');
              }, 2500);
            }
          };
        }

        var printBtn = document.getElementById('print-guide-btn');
        if (printBtn) {
          printBtn.onclick = function() {
            window.print();
          };
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initGuideActions);
      } else {
        initGuideActions();
      }
      document.addEventListener('astro:page-load', initGuideActions);
    })();
  </script>
</Layout>
